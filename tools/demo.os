// Демо-стенд OpenHub: поднимает пустой хаб, наполняет его через HTTP тем же API и теми же
// формами, что доступны человеку, и оставляет заполненный экземпляр работать.

Перем КорневойКаталог;
Перем КаталогСтенда;
Перем НомерПорта;
Перем Пересоздавать;
Перем ОставлятьХабПоднятым;
Перем ТаймаутГотовностиСек;
Перем ЖурналНаполнения;
Перем ХабНаполнения;

#Область РазборАргументов

Функция ТекстСправки()

	Строки = Новый Массив();
	Строки.Добавить("Демо-стенд OpenHub: пустой хаб наполняется через HTTP и остаётся работать.");
	Строки.Добавить("");
	Строки.Добавить("  oscript tools/demo.os                # пересоздать стенд и поднять хаб на 3380");
	Строки.Добавить("  oscript tools/demo.os --port 8080    # другой порт");
	Строки.Добавить("  oscript tools/demo.os --keep         # не пересоздавать данные, просто поднять хаб");
	Строки.Добавить("  oscript tools/demo.os --no-run       # подготовить стенд и выйти");
	Строки.Добавить("");
	Строки.Добавить("Каталог ./demo (данные, собранные .ospx, памятка ДЕМО.md) под .gitignore:");
	Строки.Добавить("его можно удалять и пересоздавать сколько угодно. Рабочий ./data стенд не трогает.");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Процедура РазобратьАргументы()

	Позиция = 0;

	Пока Позиция < АргументыКоманднойСтроки.Количество() Цикл

		Аргумент = АргументыКоманднойСтроки[Позиция];
		Позиция = Позиция + 1;

		Если Аргумент = "--port" Тогда
			Если Позиция >= АргументыКоманднойСтроки.Количество() Тогда
				Оборвать("--port требует номер порта");
			КонецЕсли;
			НомерПорта = Число(АргументыКоманднойСтроки[Позиция]);
			Позиция = Позиция + 1;
		ИначеЕсли Аргумент = "--keep" Тогда
			Пересоздавать = Ложь;
		ИначеЕсли Аргумент = "--no-run" Тогда
			ОставлятьХабПоднятым = Ложь;
		ИначеЕсли Аргумент = "-h" ИЛИ Аргумент = "--help" Тогда
			Печать(ТекстСправки());
			ЗавершитьРаботу(0);
		Иначе
			Оборвать(СтрШаблон("Неизвестный аргумент: %1 (см. --help)", Аргумент), 2);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Окружение

// Ставит переменную окружения стенда: её унаследуют и хаб, и наполнитель.
Процедура Настройка(Знач Имя, Знач Значение)
	УстановитьПеременнуюСреды(Имя, Значение);
КонецПроцедуры

// Ставит переменную только тогда, когда её не задали снаружи.
Процедура НастройкаПоУмолчанию(Знач Имя, Знач Значение)

	Если НЕ ЗначениеЗаполнено(ПолучитьПеременнуюСреды(Имя)) Тогда
		Настройка(Имя, Значение);
	КонецЕсли;

КонецПроцедуры

// Снимает переменную, доставшуюся от вызывающего: стенд не должен наследовать её значение.
Процедура Сбросить(Знач Имя)
	УстановитьПеременнуюСреды(Имя, "");
КонецПроцедуры

Функция ИзОкружения(Знач Имя, Знач Умолчание)

	Значение = ПолучитьПеременнуюСреды(Имя);

	Возврат ?(ЗначениеЗаполнено(Значение), Значение, Умолчание);

КонецФункции

Процедура ЗадатьОкружениеСтенда()

	Настройка("OSHUB_DEMO_ROOT", КаталогСтенда);
	Настройка("OSHUB_STORAGE_ROOT", ОбъединитьПути(КаталогСтенда, "data"));
	// укреплённый файловый коннектор — тот же дефолт, что у продукта
	Настройка("OSHUB_DB_CONNECTOR", "КоннекторJSON");
	Настройка("OSHUB_DB_CONNECTION", ОбъединитьПути(КаталогСтенда, "data", "entities"));
	Настройка("OSHUB_PORT", Формат(НомерПорта, "ЧГ=0; ЧН=0"));

	// Пул legacy-путей opm (/download, /dev-channel, /push). На стенде это читающее зеркало
	// hub.oscript.io: короткий адрес отдаёт публичные пакеты экосистемы, а собственные пакеты
	// организации лежат в соседнем пуле `corp`. Имя дублирует СценарийСтенда.ДефолтныйПул(),
	// расхождение ловит tests/ДемоСтенд_Тесты.os.
	Настройка("OSHUB_DEFAULT_POOL", "public");

	// Инсталляция без почты обязана выбрать одну из двух развилок, иначе регистрация закрыта
	// (ИСТ-ПОЧТ-007). У стенда SMTP нет, поэтому подтверждение адреса выключено: наполнение
	// заводит учётки обычной регистрацией, как это делает человек.
	Настройка("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");

	// Счётчик скачиваний по умолчанию копится в памяти и уходит в базу пачкой, а хук
	// остановки приложения взять негде — всё несброшенное наполнявший хаб уносит с собой.
	// Стенд включает сквозную запись (порог 1): агрегат уходит в базу внутри самого
	// запроса на выдачу, поэтому счётчики переживают перезапуск хаба между наполнением
	// и показом. Интервалы оставлены на случай, если порог переопределят снаружи.
	НастройкаПоУмолчанию("OSHUB_STATS_FLUSH__THRESHOLD", "1");
	НастройкаПоУмолчанию("OSHUB_STATS_FLUSH__INTERVAL__SEC", "5");
	НастройкаПоУмолчанию("OSHUB_JOBS_STATS__FLUSH__INTERVAL__SEC", "5");

	// Онбординг стенда проходит мастером /setup, поэтому безголового админа быть не должно.
	Сбросить("OSHUB_ADMIN_LOGIN");
	Сбросить("OSHUB_ADMIN_PASSWORD");
	Сбросить("OSHUB_ADMIN_PASSWORD_FILE");

КонецПроцедуры

Процедура ПроверитьПредпосылки()

	Если НЕ Новый Файл(ОбъединитьПути(КорневойКаталог, "oscript_modules")).Существует() Тогда
		Оборвать("Нет каталога oscript_modules — сначала поставьте зависимости: opm install -l --dev");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ЖизненныйЦиклХаба

Процедура ЗапуститьХабНаполнения()

	СоздатьКаталог(КаталогСтенда);

	ХабНаполнения = СоздатьПроцесс(СтрШаблон("oscript ""%1""",
		ОбъединитьПути(КорневойКаталог, "src", "main.os")), КорневойКаталог, Истина);
	ХабНаполнения.Запустить();

КонецПроцедуры

// Ждём /ready, а не /health: тот отвечает 200 и на недособранном хабе, и наполнение
// ушло бы в хаб без части служб. В теле 503 — список незакрытых стартовых гейтов.
Процедура ДождатьсяГотовностиХаба()

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутГотовностиСек * 1000;
	ПоследнийОтвет = "нет ответа";

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл

		ПодобратьЖурналХаба();

		Если ХабНаполнения.Завершен Тогда
			ПечатьОшибки("Хаб демо-стенда завершился, не дойдя до готовности. Журнал:");
			ПечатьОшибки(ХвостЖурнала(60));
			ЗавершитьРаботу(1);
		КонецЕсли;

		Ответ = ОтветГотовности();
		Если Ответ.Готов Тогда
			Возврат;
		КонецЕсли;
		ПоследнийОтвет = Ответ.Описание;

		Приостановить(1000);

	КонецЦикла;

	ПечатьОшибки(СтрШаблон("Хаб демо-стенда не стал готов за %1 с (GET /ready → %2).",
		Формат(ТаймаутГотовностиСек, "ЧГ=0; ЧН=0"), ПоследнийОтвет));
	ПечатьОшибки("Журнал хаба:");
	ПечатьОшибки(ХвостЖурнала(60));
	ЗавершитьРаботу(1);

КонецПроцедуры

// Ответ пробы готовности: готов ли хаб и что именно ответил — для диагностики.
Функция ОтветГотовности()

	Итог = Новый Структура("Готов, Описание", Ложь, "нет ответа");

	Попытка
		Соединение = Новый HTTPСоединение("localhost", НомерПорта, , , , 10);
		Ответ = Соединение.Получить(Новый HTTPЗапрос("/ready"));
		Тело = Ответ.ПолучитьТелоКакСтроку();
		Итог.Описание = СтрШаблон("%1 %2", Формат(Ответ.КодСостояния, "ЧГ=0; ЧН=0"), Тело);
		Итог.Готов = Ответ.КодСостояния = 200
			И СтрНайти(Тело, """ready""") > 0
			И СтрНайти(НРег(СтрЗаменить(Тело, " ", "")), """ready"":false") = 0;
	Исключение
		Итог.Описание = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Итог;

КонецФункции

Процедура ОстановитьХабНаполнения()

	Если ХабНаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если НЕ ХабНаполнения.Завершен Тогда
			ХабНаполнения.Завершить();
			Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10 * 1000;
			Пока НЕ ХабНаполнения.Завершен И ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
				Приостановить(50);
			КонецЦикла;
		КонецЕсли;
		ПодобратьЖурналХаба();
	Исключение
		// процесс мог умереть между проверкой и вызовом — это нормально
	КонецПопытки;

	ХабНаполнения = Неопределено;

КонецПроцедуры

// Буфер канала конечен: не вычитывая вывод, хаб однажды заблокируется на записи
// в stdout и перестанет отвечать. Поэтому подбираем его на каждом витке ожидания.
Процедура ПодобратьЖурналХаба()

	Если ХабНаполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Куски = Новый Массив();
	Потоки = Новый Массив();
	Потоки.Добавить(ХабНаполнения.ПотокВывода);
	Потоки.Добавить(ХабНаполнения.ПотокОшибок);

	Для Каждого Поток Из Потоки Цикл
		Кусок = Поток.Прочитать();
		Если Кусок <> Неопределено И ЗначениеЗаполнено(Строка(Кусок)) Тогда
			Куски.Добавить(Строка(Кусок));
		КонецЕсли;
	КонецЦикла;

	Если Куски.Количество() > 0 Тогда
		ДописатьВЖурнал(СтрСоединить(Куски, ""));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Шаги

Процедура ПересоздатьСтенд()

	Если Новый Файл(КаталогСтенда).Существует() Тогда
		Печать("Удаляю прежний демо-стенд: " + КаталогСтенда);
		УдалитьФайлы(КаталогСтенда);
	КонецЕсли;
	СоздатьКаталог(КаталогСтенда);

	Печать("Собираю .ospx демо-пакетов…");
	ВыполнитьСценарий(ОбъединитьПути(КорневойКаталог, "tools", "демо", "СобратьПакеты.os"));

	Печать(СтрШаблон("Поднимаю пустой хаб на порту %1 (журнал — %2)…",
		Формат(НомерПорта, "ЧГ=0; ЧН=0"), ЖурналНаполнения));
	ЗапуститьХабНаполнения();
	ДождатьсяГотовностиХаба();

	Печать("Наполняю хаб через HTTP…");
	ВыполнитьСценарий(ОбъединитьПути(КорневойКаталог, "tools", "демо", "ЗаполнитьЧерезAPI.os"));

	Печать("Останавливаю наполнявший хаб.");
	ОстановитьХабНаполнения();

КонецПроцедуры

// Запускает сценарий OneScript, печатает его вывод и ждёт завершения, попутно подбирая
// журнал наполнявшего хаба. Ненулевой код возврата обрывает стенд.
Процедура ВыполнитьСценарий(Знач ПутьСценария)

	Процесс = СоздатьПроцесс(СтрШаблон("oscript ""%1""", ПутьСценария), КорневойКаталог, Истина);
	Процесс.Запустить();

	Пока НЕ Процесс.Завершен Цикл
		ПереложитьВыводСценария(Процесс);
		ПодобратьЖурналХаба();
		Приостановить(100);
	КонецЦикла;

	ПереложитьВыводСценария(Процесс);
	Процесс.ОжидатьЗавершения();

	Если Процесс.КодВозврата <> 0 Тогда
		ОстановитьХабНаполнения();
		Оборвать(СтрШаблон("%1 завершился с кодом %2",
			Новый Файл(ПутьСценария).Имя, Формат(Процесс.КодВозврата, "ЧГ=0; ЧН=0")));
	КонецЕсли;

КонецПроцедуры

Процедура ПереложитьВыводСценария(Знач Процесс)

	Потоки = Новый Массив();
	Потоки.Добавить(Процесс.ПотокВывода);
	Потоки.Добавить(Процесс.ПотокОшибок);

	Для Каждого Поток Из Потоки Цикл
		Кусок = Поток.Прочитать();
		Если Кусок <> Неопределено И ЗначениеЗаполнено(Строка(Кусок)) Тогда
			Печать(СокрП(Строка(Кусок)));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Отдаёт консоль поднятому хабу: он пишет прямо в неё, а Ctrl+C гасит стенд.
Процедура ОставитьХабРаботать()

	Печать("");
	Печать(СтрШаблон("Демо-хаб: http://localhost:%1  (памятка и учётки — %2)",
		Формат(НомерПорта, "ЧГ=0; ЧН=0"), ОбъединитьПути(КаталогСтенда, "ДЕМО.md")));
	Печать("Вход: root / RootPassw0rd, alice|bob|carol|dave / DemoPassw0rd. Остановить — Ctrl+C.");
	Печать("");

	Хаб = СоздатьПроцесс(СтрШаблон("oscript ""%1""",
		ОбъединитьПути(КорневойКаталог, "src", "main.os")), КорневойКаталог);
	Хаб.Запустить();
	Хаб.ОжидатьЗавершения();

	ЗавершитьРаботу(Хаб.КодВозврата);

КонецПроцедуры

#КонецОбласти

#Область Служебное

Процедура Печать(Знач Текст)
	Сообщить(Текст);
КонецПроцедуры

Процедура ПечатьОшибки(Знач Текст)
	Сообщить(Текст, СтатусСообщения.Внимание);
КонецПроцедуры

Процедура Оборвать(Знач Текст, Знач КодВозврата = 1)

	ПечатьОшибки(Текст);
	ЗавершитьРаботу(КодВозврата);

КонецПроцедуры

Процедура ДописатьВЖурнал(Знач Текст)

	Запись = Новый ЗаписьТекста(ЖурналНаполнения, КодировкаТекста.UTF8, , Истина);
	Запись.ЗаписатьСтроку(СокрП(Текст));
	Запись.Закрыть();

КонецПроцедуры

Функция ХвостЖурнала(Знач КоличествоСтрок)

	Если НЕ Новый Файл(ЖурналНаполнения).Существует() Тогда
		Возврат "(журнала нет)";
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(ЖурналНаполнения, КодировкаТекста.UTF8);
	Строки = СтрРазделить(Чтение.Прочитать(), Символы.ПС);
	Чтение.Закрыть();

	Хвост = Новый Массив();
	Начало = Макс(0, Строки.Количество() - КоличествоСтрок);
	Для Индекс = Начало По Строки.Количество() - 1 Цикл
		Хвост.Добавить(Строки[Индекс]);
	КонецЦикла;

	Возврат СтрСоединить(Хвост, Символы.ПС);

КонецФункции

#КонецОбласти

КорневойКаталог = Новый Файл(ОбъединитьПути(
	Новый Файл(ТекущийСценарий().Источник).Путь, "..")).ПолноеИмя;

// каталог стенда переопределяется окружением — смоук разворачивает его в песочнице
КаталогСтенда = ИзОкружения("OSHUB_DEMO_ROOT", ОбъединитьПути(КорневойКаталог, "demo"));
НомерПорта = Число(ИзОкружения("OSHUB_PORT", "3380"));
ТаймаутГотовностиСек = Число(ИзОкружения("OSHUB_DEMO_READY_TIMEOUT", "120"));
Пересоздавать = Истина;
ОставлятьХабПоднятым = Истина;

РазобратьАргументы();

ЖурналНаполнения = ОбъединитьПути(КаталогСтенда, "хаб-наполнение.log");
ПроверитьПредпосылки();
ЗадатьОкружениеСтенда();

Если НЕ Пересоздавать И НЕ Новый Файл(ОбъединитьПути(КаталогСтенда, "data")).Существует() Тогда
	Печать(СтрШаблон("Стенда ещё нет (%1 не найден) — готовлю его, несмотря на --keep",
		ОбъединитьПути(КаталогСтенда, "data")));
	Пересоздавать = Истина;
КонецЕсли;

Если Пересоздавать Тогда
	ПересоздатьСтенд();
КонецЕсли;

Если ОставлятьХабПоднятым Тогда
	ОставитьХабРаботать();
Иначе
	Печать(СтрШаблон("Демо-стенд готов: %1 (памятка — %2)",
		КаталогСтенда, ОбъединитьПути(КаталогСтенда, "ДЕМО.md")));
КонецЕсли;
