// Зависимости в пакете openhub: рантайм-закрытие packagedef из oscript_modules без частей библиотек,
// которых рантайм хаба не грузит. Сценарий подключает хук ПриСборке в packagedef.

Перем КаталогиСопровождения;
Перем КаталогСборокДляOneScript1;
Перем НеподключаемыеКомпонентыOint;

// Файлы зависимостей, которые едут в пакет: загрузчик библиотек каталога и библиотеки
// рантайм-закрытия без тестов, документации, примеров и неподключаемых компонент.
//
// Параметры:
//   КаталогМодулей - Строка - каталог oscript_modules; относительный — от текущего каталога
//   Корни - Массив из Строка - имена рантайм-зависимостей из packagedef
//
// Возвращаемое значение:
//   Массив из Строка - полные пути файлов
//
Функция Файлы(Знач КаталогМодулей, Знач Корни) Экспорт

	КаталогМодулей = Новый Файл(КаталогМодулей).ПолноеИмя;
	Результат = Новый Массив();

	Загрузчик = Новый Файл(ОбъединитьПути(КаталогМодулей, "package-loader.os"));
	Если Загрузчик.Существует() Тогда
		Результат.Добавить(Загрузчик.ПолноеИмя);
	КонецЕсли;

	Для Каждого Библиотека Из Библиотеки(КаталогМодулей, Корни) Цикл
		КаталогБиблиотеки = ОбъединитьПути(КаталогМодулей, Библиотека);
		Для Каждого Файл Из НайтиФайлы(КаталогБиблиотеки, ПолучитьМаскуВсеФайлы(), Истина) Цикл
			Если Файл.ЭтоФайл() И НуженРантайму(Библиотека, ПутьВнутри(КаталогБиблиотеки, Файл.ПолноеИмя)) Тогда
				Результат.Добавить(Файл.ПолноеИмя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Библиотеки рантайм-закрытия: корни и всё, от чего они зависят по opm-metadata.xml,
// без dev-зависимостей. Библиотеки закрытия, которой нет в каталоге, — исключение.
//
// Параметры:
//   КаталогМодулей - Строка - каталог oscript_modules
//   Корни - Массив из Строка - имена рантайм-зависимостей из packagedef
//
// Возвращаемое значение:
//   Массив из Строка - имена библиотек
//
Функция Библиотеки(Знач КаталогМодулей, Знач Корни) Экспорт

	Результат = Новый Массив();
	Ненайденные = Новый Массив();

	Очередь = Новый Массив();
	Для Каждого Корень Из Корни Цикл
		Очередь.Добавить(Корень);
	КонецЦикла;

	Пока Очередь.Количество() > 0 Цикл

		Имя = Очередь[0];
		Очередь.Удалить(0);
		Если Результат.Найти(Имя) <> Неопределено ИЛИ Ненайденные.Найти(Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Метаданные = Новый Файл(ОбъединитьПути(КаталогМодулей, Имя, "opm-metadata.xml"));
		Если НЕ Метаданные.Существует() Тогда
			Ненайденные.Добавить(Имя);
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Имя);
		Для Каждого Зависимость Из РантаймЗависимости(Метаданные.ПолноеИмя) Цикл
			Очередь.Добавить(Зависимость);
		КонецЦикла;

	КонецЦикла;

	Если Ненайденные.Количество() > 0 Тогда
		ВызватьИсключение СтрШаблон("В %1 нет зависимостей пакета: %2 — поставьте их командой opm install -l",
			КаталогМодулей, СтрСоединить(Ненайденные, ", "));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Истина, если файл библиотеки (путь внутри неё через «/») рантайм хаба может загрузить.
//
// Параметры:
//   Библиотека - Строка - имя библиотеки
//   Путь - Строка - путь файла внутри каталога библиотеки
//
// Возвращаемое значение:
//   Булево
//
Функция НуженРантайму(Знач Библиотека, Знач Путь) Экспорт

	Возврат НЕ ЭтоСопровождение(Путь)
		И НЕ ЭтоСборкаДляOneScript1(Путь)
		И НЕ ЭтоНеподключаемаяКомпонента(Библиотека, Путь);

КонецФункции

Функция ЭтоСопровождение(Знач Путь)
	Возврат КаталогиСопровождения.Найти(СтрРазделить(Путь, "/")[0]) <> Неопределено;
КонецФункции

Функция ЭтоСборкаДляOneScript1(Знач Путь)
	Возврат СтрНачинаетсяС(Путь, КаталогСборокДляOneScript1);
КонецФункции

Функция ЭтоНеподключаемаяКомпонента(Знач Библиотека, Знач Путь)

	Если Библиотека <> "oint" ИЛИ НЕ СтрНачинаетсяС(Путь, "addins/") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НеподключаемыеКомпонентыOint.Найти(Сред(Путь, СтрДлина("addins/") + 1)) <> Неопределено;

КонецФункции

Функция ПутьВнутри(Знач Каталог, Знач ПолныйПуть)
	Возврат СтрЗаменить(Сред(ПолныйПуть, СтрДлина(Каталог) + 2), "\", "/");
КонецФункции

// Объявления depends-on без dev="true"; у старых пакетов атрибута dev нет вовсе.
Функция РантаймЗависимости(Знач ФайлМетаданных)

	Результат = Новый Массив();

	Чтение = Новый ЧтениеXML();
	Чтение.ОткрытьФайл(ФайлМетаданных);
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.ЛокальноеИмя = "depends-on"
			И Чтение.ЗначениеАтрибута("dev") <> "true" Тогда
			Результат.Добавить(Чтение.ЗначениеАтрибута("name"));
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();

	Возврат Результат;

КонецФункции

// Ни lib.config, ни код библиотек не читают этих каталогов.
КаталогиСопровождения = СтрРазделить("tests,docs,examples,features,.github", ",");

// Загрузчики библиотек берут сборки .NET Framework отсюда только на OneScript 1.x.
КаталогСборокДляOneScript1 = "Components/net4/";

// Хаб зовёт из oint OPI_S3, OPI_ЗапросыHTTP и OPI_РасширенныйВызов, opentelemetry — OPI_GRPC:
// эти пути подключают только компоненты GRPC и Cryptography.
НеподключаемыеКомпонентыOint = СтрРазделить("OPI_7z.zip,OPI_FTP.zip,OPI_HTTPServer.zip,OPI_LDAP.zip,"
	+ "OPI_Lua54.zip,OPI_LuaJIT.zip,OPI_MSSQL.zip,OPI_MongoDB.zip,OPI_MySQL.zip,OPI_PostgreSQL.zip,"
	+ "OPI_RAR.zip,OPI_RCON.zip,OPI_SQLite.zip,OPI_SSH.zip,OPI_TCPClient.zip,OPI_TCPServer.zip,"
	+ "OPI_Tar.zip,OPI_WSClient.zip,OPI_WSServer.zip,OPI_ZeroMQ.zip", ",");
