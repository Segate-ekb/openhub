// Наполняет поднятый демо-хаб только пользовательскими механиками: HTTP-вызовы того же
// API и тех же форм, что доступны человеку. Классов хаба не подключает и в базу не пишет.

Перем Клиент;
Перем Сценарий;
Перем КореньДемо;
Перем КаталогСборки;
Перем Ключи;             // Соответствие: логин -> PAT
Перем Куки;              // Соответствие: логин -> кука сессии
Перем Предупреждения;    // Массив из Строка - некритичные отказы стенда
Перем ВсегоВерсий;
Перем ВсегоСкачиваний;
Перем ЗеркалоЧужихИмён;  // Число - имён апстрима в списке дефолтного пула
Перем ЗеркалоКод;        // Число - код ответа пробного скачивания через зеркало
Перем ЗеркалоБайт;       // Число - размер тела пробного скачивания
Перем ОбойдённыеЭкраны;  // ТаблицаЗначений - экраны карты, которые обошёл наполнитель
Перем ЗаведённыеАпстримы; // Массив из Строка - адреса апстримов, которые хаб принял

#Область Служебное

Функция ИзОкружения(Знач Имя, Знач ПоУмолчанию)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ПоУмолчанию);
КонецФункции

Функция ЧислоИзОкружения(Знач Имя, Знач ПоУмолчанию)
	Попытка
		Возврат Число(ИзОкружения(Имя, Формат(ПоУмолчанию, "ЧГ=0; ЧН=0")));
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
КонецФункции

Процедура ЗаписатьТекстВФайл(Знач Путь, Знач Текст)
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

Функция ТелоJSON(Знач Поля)
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Поля);
	Возврат Запись.Закрыть();
КонецФункции

Функция ЗаголовкиJSON(Знач Токен = "", Знач Кука = "")
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Accept", "application/json");
	Если ЗначениеЗаполнено(Токен) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
	КонецЕсли;
	Если ЗначениеЗаполнено(Кука) Тогда
		Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	КонецЕсли;
	Возврат Заголовки;
КонецФункции

// Ответ с ожидаемым кодом; иначе исключение с методом, адресом, кодом и телом.
Функция Требовать(Знач Ответ, Знач Ожидаемый, Знач Пояснение)

	Если Ответ.Код = Ожидаемый Тогда
		Возврат Ответ;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("%1: %2 %3 → %4 (ожидался %5). Тело: %6",
		Пояснение, Ответ.Метод, Ответ.Путь,
		Формат(Ответ.Код, "ЧГ=0; ЧН=0"), Формат(Ожидаемый, "ЧГ=0; ЧН=0"),
		Лев(СтрЗаменить(Ответ.Тело, Символы.ПС, " "), 400));

КонецФункции

Процедура Предупредить(Знач Текст)
	Предупреждения.Добавить(Текст);
	Сообщить("демо: ВНИМАНИЕ — " + Текст);
КонецПроцедуры

Функция Ключ(Знач Логин)
	Возврат Ключи[Логин];
КонецФункции

Функция Кука(Знач Логин)
	Возврат Куки[Логин];
КонецФункции

Функция URLЧасть(Знач Значение)
	Возврат КодироватьСтроку(Строка(Значение), СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти

#Область Готовность

// /ready, а не /health: последний отвечает 200 и на недособранном хабе.
Процедура ПроверитьГотовность()

	Ответ = Клиент.Запрос("GET", "/ready");
	Данные = Клиент.Данные(Ответ);

	Если Ответ.Код <> 200 ИЛИ Данные = Неопределено ИЛИ Данные.Получить("ready") <> Истина Тогда
		ВызватьИсключение СтрШаблон(
			"Хаб на %1 не готов принимать наполнение: GET /ready → %2, тело %3."
			+ " Наполнение рассчитано на поднятый и собранный хаб (его поднимает tools/demo.os).",
			Клиент.Адрес(), Формат(Ответ.Код, "ЧГ=0; ЧН=0"), Лев(Ответ.Тело, 200));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Учётки

// Мастер первого запуска: работает, только пока в хабе нет ни одного пользователя,
// поэтому администратор обязан появиться раньше всех остальных.
Процедура СоздатьАдмина()

	Логин = Сценарий.ЛогинАдмина();
	Пароль = ИзОкружения("OSHUB_DEMO_ROOT_PASSWORD", "RootPassw0rd");

	Поля = Новый Структура();
	Поля.Вставить("логин", Логин);
	Поля.Вставить("пароль", Пароль);

	Ответ = Требовать(Клиент.Запрос("POST", "/setup", ТелоJSON(Поля), ЗаголовкиJSON()),
		201, "мастер первого запуска");

	Куки.Вставить(Логин, Клиент.КукаСессии(Ответ));
	Если НЕ ЗначениеЗаполнено(Кука(Логин)) Тогда
		ВызватьИсключение "Мастер /setup не выдал куку сессии администратора";
	КонецЕсли;

КонецПроцедуры

Процедура СоздатьЛюдей()

	Для Каждого Человек Из Сценарий.Люди() Цикл

		Если Человек.Вход <> "пароль" Тогда
			Продолжить;
		КонецЕсли;

		Поля = Новый Структура();
		Поля.Вставить("логин", Человек.Логин);
		Поля.Вставить("email", Человек.Email);
		Поля.Вставить("пароль", Сценарий.Пароль());

		Требовать(Клиент.Запрос("POST", "/api/v1/users", ТелоJSON(Поля), ЗаголовкиJSON()),
			201, "регистрация " + Человек.Логин);

	КонецЦикла;

КонецПроцедуры

Процедура Войти(Знач Логин, Знач Пароль)

	Поля = Новый Структура();
	Поля.Вставить("логин", Логин);
	Поля.Вставить("пароль", Пароль);

	Ответ = Требовать(Клиент.Запрос("POST", "/api/v1/login", ТелоJSON(Поля), ЗаголовкиJSON()),
		200, "вход " + Логин);

	Куки.Вставить(Логин, Клиент.КукаСессии(Ответ));
	Если НЕ ЗначениеЗаполнено(Кука(Логин)) Тогда
		ВызватьИсключение "Вход " + Логин + " не выдал куку сессии";
	КонецЕсли;

КонецПроцедуры

// Ключ выпускается сессией: PAT ключей не выпускает (403 token_cannot_manage_tokens).
// Ключ непривязанный — привязанный к пулу не смог бы создавать пулы и группы.
Процедура ВыпуститьКлюч(Знач Логин)

	// срок заведомо ниже любого разумного потолка хаба: стенду ключ нужен на один прогон
	Ключи.Вставить(Логин, НовыйКлюч(Логин, "наполнение стенда", "read,write", 7, Новый Массив()));

КонецПроцедуры

// Выпускает ключ сессией человека и возвращает его значение — оно показывается один раз.
Функция НовыйКлюч(Знач Логин, Знач Имя, Знач Права, Знач СрокДней, Знач ИменаПулов)

	Поля = Новый Структура();
	Поля.Вставить("имя", Имя);
	Поля.Вставить("права", Права);
	Поля.Вставить("срок_дней", СрокДней);
	Если ИменаПулов.Количество() = 0 Тогда
		Поля.Вставить("пул", 0);
	Иначе
		Пулы = Новый Массив();
		Для Каждого ИмяПула Из ИменаПулов Цикл
			Пулы.Добавить(ИдентификаторПула(ИмяПула));
		КонецЦикла;
		Поля.Вставить("пулы", Пулы);
	КонецЕсли;

	Ответ = Требовать(
		Клиент.Запрос("POST", "/api/v1/tokens", ТелоJSON(Поля), ЗаголовкиJSON("", Кука(Логин))),
		201, СтрШаблон("выпуск ключа «%1» учётке %2", Имя, Логин));

	Возврат Клиент.Данные(Ответ).Получить("token_info").Получить("token");

КонецФункции

Функция ИдентификаторПула(Знач ИмяПула)

	Ответ = Требовать(Клиент.Запрос("GET", "/api/v1/pools/" + URLЧасть(ИмяПула), "",
		ЗаголовкиJSON(Ключ(Сценарий.ЛогинАдмина()))), 200, "пул " + ИмяПула);
	Возврат Клиент.Данные(Ответ).Получить("pool").Получить("id");

КонецФункции

Процедура СоздатьГруппы()

	Для Каждого Группа Из Сценарий.Группы() Цикл

		Поля = Новый Структура();
		Поля.Вставить("имя", Группа.Имя);
		Поля.Вставить("описание", Группа.Описание);

		Требовать(Клиент.Запрос("POST", "/api/v1/groups", ТелоJSON(Поля),
			ЗаголовкиJSON(Ключ(Сценарий.ЛогинАдмина()))), 201, "создание группы " + Группа.Имя);

		Для Каждого Участник Из Группа.Участники Цикл
			Состав = Новый Структура();
			Состав.Вставить("логин", Участник);
			Требовать(Клиент.Запрос("POST",
				СтрШаблон("/api/v1/groups/%1/members", URLЧасть(Группа.Имя)),
				ТелоJSON(Состав), ЗаголовкиJSON(Ключ(Сценарий.ЛогинАдмина()))),
				201, СтрШаблон("участник %1 в группе %2", Участник, Группа.Имя));
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Адрес инсталляции: из него хаб выводит адрес возврата провайдеров входа и адреса для opm.
Процедура НастроитьАдресХаба()

	Поля = Новый Структура("value", Клиент.Адрес());
	Требовать(Клиент.Запрос("PATCH", "/api/v1/hub/settings/oshub.instance.url", ТелоJSON(Поля),
		ЗаголовкиJSON(Ключ(Сценарий.ЛогинАдмина()))), 200, "адрес инсталляции");

КонецПроцедуры

// Bot API Telegram хаб зовёт по зашитому адресу, а адрес прокси до него — настройка хаба:
// стенд ставит прокси в несуществующий узел зоны .local, и доставка в фиктивные чаты
// отказывает на своей машине, не выходя в сеть.
Процедура НаправитьДоставкуTelegramВТупик()

	Поля = Новый Структура("value", Сценарий.ПроксиTelegram());
	Требовать(Клиент.Запрос("PATCH", "/api/v1/hub/settings/oshub.webhooks.telegram.proxy.host",
		ТелоJSON(Поля), ЗаголовкиJSON(Ключ(Сценарий.ЛогинАдмина()))), 200, "прокси Telegram");

КонецПроцедуры

// Картинки оформления — слотами раздела «Брендирование», каждая своим адресом: логотип загружается
// и возвращается к стандартному подтверждённой формой, иконка сайта остаётся своей — как на макете.
// Файл — фирменная иконка из статики хаба.
Процедура ЗагрузитьКартинкиБренда()

	Админ = Сценарий.ЛогинАдмина();
	Раздел = "/hub/settings/branding";
	Иконка = Новый ТекстовыйДокумент();
	Корень = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..", "..");
	Иконка.Прочитать(ОбъединитьПути(Корень, "src", "статика", "бренд/favicon.svg"), КодировкаТекста.UTF8);

	ЗагрузитьКартинку(Админ, Раздел, "logo", "logo.svg", Иконка.ПолучитьТекст());

	Подтверждение = Новый Массив();
	Подтверждение.Добавить(ПолеФормы("confirmed", "1"));
	ОтправитьФорму(Админ, Раздел, Раздел + "/logo/reset", Подтверждение, "возврат стандартного логотипа");

	ЗагрузитьКартинку(Админ, Раздел, "favicon", "favicon.svg", Иконка.ПолучитьТекст());

КонецПроцедуры

// Слот картинки уходит составной формой: токен страницы и файл под именем картинки.
Процедура ЗагрузитьКартинку(Знач Логин, Знач Раздел, Знач Слот, Знач ИмяФайла, Знач Содержимое)

	Страница = Требовать(Клиент.Запрос("GET", Раздел, "", ЗаголовкиСтраницы(Кука(Логин))), 200,
		"страница брендирования");
	Граница = "----oshub-demo-" + Слот;
	ПС = Символы.ВК + Символы.ПС;
	Тело = "--" + Граница + ПС + "Content-Disposition: form-data; name=""_csrf""" + ПС + ПС
		+ ИзвлечьCSRF(Страница.Тело) + ПС
		+ "--" + Граница + ПС + СтрШаблон("Content-Disposition: form-data; name=""%1""; filename=""%2""",
			Слот, ИмяФайла) + ПС + "Content-Type: image/svg+xml" + ПС + ПС + Содержимое + ПС
		+ "--" + Граница + "--" + ПС;

	Заголовки = ЗаголовкиСтраницы(Кука(Логин));
	Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Граница);
	Ответ = Клиент.Запрос("POST", Раздел + "/" + Слот, Тело, Заголовки);
	Если Ответ.Код <> 303 И Ответ.Код <> 200 Тогда
		Требовать(Ответ, 303, "загрузка картинки " + Слот);
	КонецЕсли;

КонецПроцедуры

// Приглашение — форма «Добавить пользователя» на экране «Люди»: учётка появляется без пароля,
// а одноразовую ссылку установки пароля хаб показывает администратору один раз.
Процедура ПригласитьЛюдей()

	Админ = Сценарий.ЛогинАдмина();

	Для Каждого Человек Из Сценарий.Люди() Цикл

		Если Человек.Вход <> "приглашение" Тогда
			Продолжить;
		КонецЕсли;

		Поля = Новый Массив();
		Поля.Добавить(ПолеФормы("логин", Человек.Логин));
		Поля.Добавить(ПолеФормы("email", Человек.Email));
		Поля.Добавить(ПолеФормы("роль", Человек.РольХаба));

		ОтправитьФорму(Админ, ОкноЛюдей("новый"), АдресЛюдей(), Поля, "приглашение " + Человек.Логин);

	КонецЦикла;

КонецПроцедуры

// Роль хаба меняет окно подтверждения строки на экране «Пользователи»: форма несёт запрошенную
// роль и признак подтверждённой отправки.
Процедура НазначитьАдминов()

	Админ = Сценарий.ЛогинАдмина();

	Для Каждого Человек Из Сценарий.Люди() Цикл

		Если Человек.РольХаба <> "admin" ИЛИ Человек.Вход <> "пароль" Тогда
			Продолжить;
		КонецЕсли;

		Поля = Новый Массив();
		Поля.Добавить(ПолеФормы("роль", "admin"));
		Поля.Добавить(ПолеФормы("confirmed", "1"));

		ОтправитьФорму(Админ, ОкноЛюдей("роль-" + Человек.Логин), АдресУчётки(Человек.Логин, "role"), Поля,
			"роль admin учётке " + Человек.Логин);

	КонецЦикла;

КонецПроцедуры

// Блокировка — последней из правок учёток: заблокированный уже ничего не сделает сам.
// Приглашённого блокировать незачем — без способа входа хаб и так держит его неактивным.
Процедура ЗаблокироватьУчётки()

	Админ = Сценарий.ЛогинАдмина();

	Для Каждого Человек Из Сценарий.Люди() Цикл

		Если НЕ Человек.Заблокирован ИЛИ Человек.Вход <> "пароль" Тогда
			Продолжить;
		КонецЕсли;

		Поля = Новый Массив();
		Поля.Добавить(ПолеФормы("активна", "0"));

		ОтправитьФорму(Админ, АдресЛюдей() + "?q=" + URLЧасть(Человек.Логин), АдресУчётки(Человек.Логин, "toggle"),
			Поля, "блокировка " + Человек.Логин);

	КонецЦикла;

КонецПроцедуры

Функция АдресЛюдей()
	Возврат "/hub/settings/users";
КонецФункции

// Страница «Пользователи» с открытым окном: в его форме — токен, которым уходит правка.
Функция ОкноЛюдей(Знач Окно)
	Возврат АдресЛюдей() + "?" + КодироватьСтроку("окно", СпособКодированияСтроки.КодировкаURL) + "="
		+ КодироватьСтроку(Окно, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция АдресУчётки(Знач Логин, Знач Действие)
	Возврат АдресЛюдей() + "/" + URLЧасть(Логин) + "/" + Действие;
КонецФункции

// Ключи администратора с разными правами и сроками — то, что видно в «Токенах доступа».
Процедура ВыпуститьКлючиАдмина()

	Для Каждого Описание Из Сценарий.КлючиАдмина() Цикл
		НовыйКлюч(Сценарий.ЛогинАдмина(), Описание.Имя, Описание.Права, Описание.СрокДней, Описание.Пулы);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Пулы

Процедура СоздатьПулы()

	АдминКлюч = Ключ(Сценарий.ЛогинАдмина());

	Для Каждого Пул Из Сценарий.Пулы() Цикл

		Поля = Новый Структура();
		Поля.Вставить("имя", Пул.Имя);
		Поля.Вставить("тип", Пул.Тип);
		Поля.Вставить("видимость", Пул.Видимость);
		Поля.Вставить("квота_мб", Пул.КвотаМб);

		Требовать(Клиент.Запрос("POST", "/api/v1/pools", ТелоJSON(Поля), ЗаголовкиJSON(АдминКлюч)),
			201, "создание пула " + Пул.Имя);

		Если НЕ Пул.ПубликацияРазрешена Тогда
			Настройки = Новый Структура();
			Настройки.Вставить("публикация", "false");
			Требовать(Клиент.Запрос("PATCH",
				СтрШаблон("/api/v1/pools/%1/settings", URLЧасть(Пул.Имя)),
				ТелоJSON(Настройки), ЗаголовкиJSON(АдминКлюч)),
				200, "запрет публикации в пуле " + Пул.Имя);
		КонецЕсли;

		Если ЗначениеЗаполнено(Пул.Апстрим) Тогда
			ЗавестиАпстрим(Пул, АдминКлюч);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Адрес апстрима судит SSRF-валидатор, а он резолвит DNS: без сети шаг отказывает.
// Стенд от этого не разваливается — пул остаётся кэширующим, но без источника.
Процедура ЗавестиАпстрим(Знач Пул, Знач АдминКлюч)

	Поля = Новый Структура();
	Поля.Вставить("url", Пул.Апстрим);
	Поля.Вставить("ttl", 900);

	Ответ = Клиент.Запрос("POST", СтрШаблон("/api/v1/pools/%1/upstreams", URLЧасть(Пул.Имя)),
		ТелоJSON(Поля), ЗаголовкиJSON(АдминКлюч));

	Если Ответ.Код = 201 Тогда
		ЗаведённыеАпстримы.Добавить(Пул.Апстрим);
	Иначе
		Предупредить(СтрШаблон(
			"апстрим %1 для пула %2 не заведён (код %3): SSRF-валидатор резолвит DNS,"
			+ " на машине без сети это ожидаемо. Пул останется без источника.",
			Пул.Апстрим, Пул.Имя, Формат(Ответ.Код, "ЧГ=0; ЧН=0")));
	КонецЕсли;

КонецПроцедуры

Процедура ВыдатьГрантыПулов()

	АдминКлюч = Ключ(Сценарий.ЛогинАдмина());

	Для Каждого Грант Из Сценарий.ГрантыПулов() Цикл

		Поля = Новый Структура();
		Поля.Вставить("тип_субъекта", Грант.ТипСубъекта);
		Поля.Вставить("субъект", Грант.Субъект);
		Поля.Вставить("роль", Грант.Роль);

		Требовать(Клиент.Запрос("POST", СтрШаблон("/api/v1/pools/%1/grants", URLЧасть(Грант.Пул)),
			ТелоJSON(Поля), ЗаголовкиJSON(АдминКлюч)),
			201, СтрШаблон("роль %1 субъекту %2 на пуле %3", Грант.Роль, Грант.Субъект, Грант.Пул));

	КонецЦикла;

КонецПроцедуры

Процедура ВыдатьГрантыПакетов()

	Для Каждого Грант Из Сценарий.ГрантыПакетов() Цикл

		Поля = Новый Структура();
		Поля.Вставить("пакет", Грант.Пакет);
		Поля.Вставить("тип_субъекта", Грант.ТипСубъекта);
		Поля.Вставить("субъект", Грант.Субъект);
		Поля.Вставить("роль", Грант.Роль);

		Требовать(Клиент.Запрос("POST", СтрШаблон("/api/v1/pools/%1/grants", URLЧасть(Грант.Пул)),
			ТелоJSON(Поля), ЗаголовкиJSON(Ключ(Грант.Выдаёт))),
			201, СтрШаблон("грант %1 на пакет %2/%3", Грант.Субъект, Грант.Пул, Грант.Пакет));

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПровайдерыВхода

// Провайдеров входа заводит форма раздела «Провайдеры входа»: пресет подставляет точки,
// подпись и области сам, поэтому форма несёт только имя, клиента и флажки.
Процедура ЗавестиПровайдеров()

	Админ = Сценарий.ЛогинАдмина();
	Раздел = "/hub/settings/providers";

	Для Каждого Провайдер Из Сценарий.ПровайдерыВхода() Цикл

		Поля = Новый Массив();
		Поля.Добавить(ПолеФормы("пресет", Провайдер.Пресет));
		Поля.Добавить(ПолеФормы("имя", Провайдер.Имя));
		Поля.Добавить(ПолеФормы("клиент", Провайдер.Клиент));
		Поля.Добавить(ПолеФормы("секрет", Провайдер.Секрет));
		Если Провайдер.Автосоздание Тогда
			Поля.Добавить(ПолеФормы("автосоздание", "1"));
		КонецЕсли;
		Если Провайдер.Включён Тогда
			Поля.Добавить(ПолеФормы("включить", "1"));
		КонецЕсли;
		ОтправитьФорму(Админ, Раздел, Раздел, Поля, "провайдер входа " + Провайдер.Имя);

		Если ЗначениеЗаполнено(Провайдер.ЗакрытВСтранах) Тогда
			Страны = Новый Массив();
			Страны.Добавить(ПолеФормы("страны", Провайдер.ЗакрытВСтранах));
			ОтправитьФорму(Админ, Раздел,
				СтрШаблон("%1/%2/countries", Раздел, URLЧасть(Провайдер.Имя)), Страны,
				"страны провайдера " + Провайдер.Имя);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Источники

// Второй апстрим — выдача собственного пула этого хаба по ключу его владельца.
Процедура ЗавестиВторойАпстрим()

	Апстрим = Сценарий.ВторойАпстрим();

	Поля = Новый Структура();
	Поля.Вставить("url", АдресВыдачиПула(Апстрим.ПулИсточник));
	Поля.Вставить("ttl", Апстрим.СрокКэша);
	Поля.Вставить("token", Ключ(Апстрим.Ключ));
	Поля.Вставить("allowlist", ТелоJSON(Апстрим.Разрешено));

	Требовать(Клиент.Запрос("POST", СтрШаблон("/api/v1/pools/%1/upstreams", URLЧасть(Апстрим.Пул)),
		ТелоJSON(Поля), ЗаголовкиJSON(Ключ(Сценарий.ЛогинАдмина()))),
		201, "второй апстрим пула " + Апстрим.Пул);

КонецПроцедуры

// Зеркала пула по умолчанию смотрят в пулы этого же хаба; первое прогоняется сразу,
// чтобы на экране был итог прогона, второе остаётся выключенным.
Процедура ЗавестиЗеркала()

	АдминКлюч = Ключ(Сценарий.ЛогинАдмина());

	Для Каждого Зеркало Из Сценарий.Зеркала() Цикл

		Поля = Новый Структура();
		Поля.Вставить("url", АдресВыдачиПула(Зеркало.ПулИсточник));
		Поля.Вставить("interval", Зеркало.Интервал);
		Поля.Вставить("filter", ТелоJSON(Зеркало.Фильтр));
		Поля.Вставить("migrate", Зеркало.Перенос);

		АдресЗеркал = СтрШаблон("/api/v1/pools/%1/mirrors", URLЧасть(Зеркало.Пул));
		Ответ = Требовать(Клиент.Запрос("POST", АдресЗеркал, ТелоJSON(Поля), ЗаголовкиJSON(АдминКлюч)),
			201, "зеркало пула " + Зеркало.Пул + " из пула " + Зеркало.ПулИсточник);
		АдресЗеркала = АдресЗеркал + "/" + Формат(
			Клиент.Данные(Ответ).Получить("mirror").Получить("id"), "ЧГ=0; ЧН=0");

		Если НЕ Зеркало.Включено Тогда
			Правка = Новый Структура("enabled", Ложь);
			Требовать(Клиент.Запрос("PATCH", АдресЗеркала, ТелоJSON(Правка), ЗаголовкиJSON(АдминКлюч)),
				200, "выключение зеркала из пула " + Зеркало.ПулИсточник);
		КонецЕсли;

		Если Зеркало.Синхронизировать Тогда
			Ответ = Клиент.Запрос("POST", АдресЗеркала + "/sync", "", ЗаголовкиJSON(АдминКлюч));
			Если Ответ.Код <> 200 И Ответ.Код <> 202 Тогда
				Требовать(Ответ, 202, "прогон зеркала из пула " + Зеркало.ПулИсточник);
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция АдресВыдачиПула(Знач ИмяПула)
	Возврат СтрШаблон("%1/api/v1/pools/%2/download/", Клиент.Адрес(), URLЧасть(ИмяПула));
КонецФункции

#КонецОбласти

#Область Публикация

// Публикация — сырые байты .ospx телом, метаданные в FILE-NAME и CHANNEL:
// ровно то, что делает `opm push`.
Процедура ОпубликоватьПакеты()

	Для Каждого Пакет Из Сценарий.Пакеты() Цикл
		Для Каждого Версия Из Пакет.Версии Цикл
			ОпубликоватьВерсию(Пакет, Версия);
			ВсегоВерсий = ВсегоВерсий + 1;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ОпубликоватьВерсию(Знач Пакет, Знач Версия)

	ИмяФайла = Сценарий.ИмяФайла(Пакет.Имя, Версия.Версия);
	Путь = ОбъединитьПути(КаталогСборки, ИмяФайла);

	Если НЕ Новый Файл(Путь).Существует() Тогда
		ВызватьИсключение СтрШаблон(
			"Нет собранного артефакта %1: сначала соберите пакеты (tools/демо/СобратьПакеты.os)", Путь);
	КонецЕсли;

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", ИмяФайла);
	Заголовки.Вставить("Authorization", "Bearer " + Ключ(Пакет.Публикатор));
	Если ЗначениеЗаполнено(Версия.Метка) Тогда
		Заголовки.Вставить("CHANNEL", Версия.Метка);
	КонецЕсли;

	Требовать(Клиент.ЗапросБайтами("POST",
		СтрШаблон("/api/v1/pools/%1/push", URLЧасть(Пакет.Пул)),
		Новый ДвоичныеДанные(Путь), Заголовки),
		201, СтрШаблон("публикация %1/%2 %3", Пакет.Пул, Пакет.Имя, Версия.Версия));

КонецПроцедуры

// Короткий легаси-адрес /push ведёт в дефолтный пул, а он на стенде только читает.
// Отказ проверяется тем же способом, каким публикует opm: сюжет обещает 409, и обещание
// не должно расходиться с хабом молча.
Процедура ПроверитьЗапретКороткойПубликации()

	Пакет = Сценарий.Пакеты()[0];
	Версия = Пакет.Версии[0];
	ИмяФайла = Сценарий.ИмяФайла(Пакет.Имя, Версия.Версия);

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", ИмяФайла);
	Заголовки.Вставить("Authorization", "Bearer " + Ключ(Пакет.Публикатор));

	Требовать(Клиент.ЗапросБайтами("POST", "/push",
		Новый ДвоичныеДанные(ОбъединитьПути(КаталогСборки, ИмяФайла)), Заголовки),
		409, "публикация коротким адресом /push в дефолтный пул");

КонецПроцедуры

Процедура ОтозватьВерсии()

	Для Каждого Отзыв Из Сценарий.ОтозванныеВерсии() Цикл

		Поля = Новый Структура();
		Поля.Вставить("yanked", "true");

		Требовать(Клиент.Запрос("PATCH",
			СтрШаблон("/api/v1/pools/%1/packages/%2/versions/%3",
				URLЧасть(Отзыв.Пул), URLЧасть(Отзыв.Пакет), URLЧасть(Отзыв.Версия)),
			ТелоJSON(Поля), ЗаголовкиJSON(Ключ(Отзыв.Кем))),
			200, СтрШаблон("отзыв версии %1 пакета %2", Отзыв.Версия, Отзыв.Пакет));

	КонецЦикла;

КонецПроцедуры

// Демо-теги поверх каналов по умолчанию: своё правило stable и ручной lts.
Процедура ПоставитьТеги()

	Для Каждого Тег Из Сценарий.Теги() Цикл

		Поля = Новый Структура();
		Поля.Вставить("mode", Тег.Режим);
		Если Тег.Режим = "правило" Тогда
			Поля.Вставить("ruleType", Тег.ТипПравила);
			Поля.Вставить("rule", Тег.Правило);
		Иначе
			Поля.Вставить("version", Тег.Версия);
		КонецЕсли;

		Требовать(Клиент.Запрос("PUT",
			СтрШаблон("/api/v1/pools/%1/packages/%2/tags/%3",
				URLЧасть(Тег.Пул), URLЧасть(Тег.Пакет), URLЧасть(Тег.Тег)),
			ТелоJSON(Поля), ЗаголовкиJSON(Ключ(Тег.Кем))),
			200, СтрШаблон("тег %1 пакета %2", Тег.Тег, Тег.Пакет));

	КонецЦикла;

КонецПроцедуры

// Каналы stable/prerelease/develop заводит визард раздела «Теги»: сам хаб их не выдумывает,
// и стенд получает их тем же путём, что живой мейнтейнер. Форма сессионная и требует
// CSRF-токен, который берётся из отрисованной страницы.
Процедура ЗавестиКаналыПоУмолчанию()

	Для Каждого Пакет Из Сценарий.Пакеты() Цикл

		Логин = Пакет.Публикатор;
		Адрес = СтрШаблон("/pools/%1/packages/%2/settings/tags", URLЧасть(Пакет.Пул), URLЧасть(Пакет.Имя));

		Раздел = Требовать(Клиент.Запрос("GET", Адрес, "", ЗаголовкиФормы(Кука(Логин))),
			200, "раздел каналов " + Пакет.Имя);

		Токен = ИзвлечьCSRF(Раздел.Тело);
		Если НЕ ЗначениеЗаполнено(Токен) Тогда
			ВызватьИсключение "В разделе каналов " + Пакет.Имя + " нет поля _csrf";
		КонецЕсли;

		Поля = Новый Массив();
		Поля.Добавить(ПолеФормы("_csrf", Токен));
		Поля.Добавить(ПолеФормы("операция", "каналы_по_умолчанию"));

		Ответ = Клиент.Запрос("POST", Адрес, СтрСоединить(Поля, "&"), ЗаголовкиФормы(Кука(Логин)));
		// заведено — перенаправление по образцу POST/Redirect/GET (клиент идёт за ним — 200);
		// «всё уже есть» — 409
		Если Ответ.Код <> 302 И Ответ.Код <> 303 И Ответ.Код <> 200 И Ответ.Код <> 409 Тогда
			Требовать(Ответ, 302, "каналы по умолчанию пакета " + Пакет.Имя);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область КарточкиПакетов

// Лицензии и ключевых слов в формате .ospx нет — их заполняет форма карточки пакета.
// Форма сессионная и требует CSRF-токен, который берётся из отрисованной страницы.
Процедура ЗаполнитьКарточки()

	Для Каждого Пакет Из Сценарий.Пакеты() Цикл

		Логин = Пакет.Публикатор;
		Адрес = СтрШаблон("/pools/%1/packages/%2/settings/card", URLЧасть(Пакет.Пул), URLЧасть(Пакет.Имя));

		Форма = Требовать(Клиент.Запрос("GET", Адрес, "", ЗаголовкиФормы(Кука(Логин))),
			200, "форма карточки " + Пакет.Имя);

		Токен = ИзвлечьCSRF(Форма.Тело);
		Если НЕ ЗначениеЗаполнено(Токен) Тогда
			ВызватьИсключение "В форме карточки " + Пакет.Имя + " нет поля _csrf";
		КонецЕсли;

		Поля = Новый Массив();
		Поля.Добавить(ПолеФормы("_csrf", Токен));
		Поля.Добавить(ПолеФормы("описание", Пакет.Описание));
		Поля.Добавить(ПолеФормы("ключевые_слова", Пакет.КлючевыеСлова));
		Поля.Добавить(ПолеФормы("лицензия", Пакет.Лицензия));
		Поля.Добавить(ПолеФормы("репозиторий", Пакет.Репозиторий));

		Ответ = Клиент.Запрос("POST", Адрес, СтрСоединить(Поля, "&"), ЗаголовкиФормы(Кука(Логин)));
		// форма отвечает редиректом по образцу POST/Redirect/GET
		Если Ответ.Код <> 302 И Ответ.Код <> 303 И Ответ.Код <> 200 Тогда
			Требовать(Ответ, 302, "сохранение карточки " + Пакет.Имя);
		КонецЕсли;

		// пометка «устарел» — тумблер секции «В каталоге», своя форма на своём адресе
		Если Пакет.Устарел Тогда
			Пометка = Новый Массив();
			Пометка.Добавить(ПолеФормы("устарел", "1"));
			ОтправитьФорму(Логин, Адрес, Адрес + "/deprecated", Пометка, "пометка «устарел» " + Пакет.Имя);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Форма экрана глазами человека: страница с формой даёт CSRF-токен, POST несёт поля.
// Принятая форма отвечает перенаправлением либо страницей итога; 4xx — отказ формы.
Функция ОтправитьФорму(Знач Логин, Знач АдресСтраницы, Знач АдресФормы, Знач Поля, Знач Пояснение)

	Страница = Требовать(Клиент.Запрос("GET", АдресСтраницы, "", ЗаголовкиСтраницы(Кука(Логин))),
		200, "страница формы: " + Пояснение);

	Токен = ИзвлечьCSRF(Страница.Тело);
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		ВызватьИсключение СтрШаблон("На странице %1 нет поля _csrf (%2)", АдресСтраницы, Пояснение);
	КонецЕсли;

	Тело = Новый Массив();
	Тело.Добавить(ПолеФормы("_csrf", Токен));
	Для Каждого Поле Из Поля Цикл
		Тело.Добавить(Поле);
	КонецЦикла;

	Ответ = Клиент.Запрос("POST", АдресФормы, СтрСоединить(Тело, "&"), ЗаголовкиФормы(Кука(Логин)));
	Если Ответ.Код <> 302 И Ответ.Код <> 303 И Ответ.Код <> 200 Тогда
		Требовать(Ответ, 302, Пояснение);
	КонецЕсли;

	Возврат Ответ;

КонецФункции

Функция ЗаголовкиСтраницы(Знач КукаСессии)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept", "text/html");
	Заголовки.Вставить("Cookie", "oshub_session=" + КукаСессии);
	Возврат Заголовки;
КонецФункции

Функция ЗаголовкиФормы(Знач КукаСессии)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Accept", "text/html");
	Заголовки.Вставить("Cookie", "oshub_session=" + КукаСессии);
	Возврат Заголовки;
КонецФункции

Функция ПолеФормы(Знач Имя, Знач Значение)
	Возврат URLЧасть(Имя) + "=" + URLЧасть(Значение);
КонецФункции

Функция ИзвлечьCSRF(Знач ТекстСтраницы)

	Маркер = "name=""_csrf"" value=""";
	Поз = СтрНайти(ТекстСтраницы, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(ТекстСтраницы, Поз + СтрДлина(Маркер));
	Конец = СтрНайти(Остаток, """");
	Возврат ?(Конец = 0, "", Лев(Остаток, Конец - 1));

КонецФункции

#КонецОбласти

#Область Скачивания

// Статистика набирается настоящими скачиваниями: строк агрегатов стенд не пишет.
// Заголовков валидации кэша не шлём — на 304 и HEAD скачивание не засчитывается.
Процедура НабратьСкачивания()

	Для Каждого Пакет Из Сценарий.Пакеты() Цикл

		// приватный пул анониму невидим — его артефакты качаем ключом мейнтейнера
		Заголовки = Новый Соответствие();
		Если Пакет.Пул = "team" Тогда
			Заголовки.Вставить("Authorization", "Bearer " + Ключ(Пакет.Публикатор));
		КонецЕсли;

		Для Каждого Версия Из Пакет.Версии Цикл

			Путь = СтрШаблон("/api/v1/pools/%1/download/%2/%3",
				URLЧасть(Пакет.Пул), URLЧасть(Пакет.Имя),
				URLЧасть(Сценарий.ИмяФайла(Пакет.Имя, Версия.Версия)));

			Для Номер = 1 По Версия.Скачиваний Цикл
				Итог = Клиент.Скачать(Путь, Заголовки);
				Если Итог.Код <> 200 ИЛИ Итог.Размер = 0 Тогда
					ВызватьИсключение СтрШаблон(
						"Скачивание %1 вернуло %2 и %3 байт: без реальной отдачи тела"
						+ " хаб скачивание не засчитывает",
						Путь, Формат(Итог.Код, "ЧГ=0; ЧН=0"), Формат(Итог.Размер, "ЧГ=0; ЧН=0"));
				КонецЕсли;
				ВсегоСкачиваний = ВсегоСкачиваний + 1;
			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Счётчик копится в памяти и уходит в базу порогом либо фоновой задачей. Стенд
// перезапускают сразу после наполнения, поэтому сброса надо дождаться, иначе
// вся статистика умрёт вместе с процессом.
Процедура ДождатьсяСбросаСтатистики()

	Ожидание = ЧислоИзОкружения("OSHUB_DEMO_STATS_WAIT_SEC",
		ЧислоИзОкружения("OSHUB_JOBS_STATS__FLUSH__INTERVAL__SEC", 60) + 5);

	Сообщить(СтрШаблон("демо: жду сброса статистики скачиваний в базу — %1 с",
		Формат(Ожидание, "ЧГ=0; ЧН=0")));
	Приостановить(Ожидание * 1000);

КонецПроцедуры

#КонецОбласти

#Область Зеркало

// Зеркало дефолтного пула глазами пользователя: короткий адрес отдаёт то, чего в этот
// хаб никто не публиковал. Шаг некритичный — без сети либо при неработающем походе
// в апстрим стенд собирается целиком, а несделанное уходит в предупреждения и памятку.
Процедура ПроверитьЗеркало()

	ОтветСписка = Клиент.Запрос("GET", "/download/list.txt");
	ЗеркалоЧужихИмён = ?(ОтветСписка.Код = 200, ЧужихИмён(ОтветСписка.Тело), 0);

	Если ЗеркалоЧужихИмён = 0 Тогда
		Предупредить(СтрШаблон(
			"короткий адрес /download/list.txt не показал ни одного имени из апстрима %1"
			+ " (код %2): либо у машины нет сети, либо пул с апстримом наружу не ходит.",
			Сценарий.АдресАпстрима(), Формат(ОтветСписка.Код, "ЧГ=0; ЧН=0")));
	КонецЕсли;

	Пробник = Сценарий.ПробникЗеркала();
	Путь = СтрШаблон("/download/%1/%2", URLЧасть(Пробник.Имя),
		URLЧасть(Сценарий.ИмяФайла(Пробник.Имя, Пробник.Версия)));

	Итог = Клиент.Скачать(Путь);
	ЗеркалоКод = Итог.Код;
	ЗеркалоБайт = Итог.Размер;

	Если ЗеркалоКод <> 200 ИЛИ ЗеркалоБайт = 0 Тогда
		Предупредить(СтрШаблон(
			"зеркало не отдало %1 через короткий адрес %2 (код %3, %4 байт):"
			+ " кэш дефолтного пула останется пустым.",
			Сценарий.ИмяФайла(Пробник.Имя, Пробник.Версия), Путь,
			Формат(ЗеркалоКод, "ЧГ=0; ЧН=0"), Формат(ЗеркалоБайт, "ЧГ=0; ЧН=0")));
	КонецЕсли;

КонецПроцедуры

// Сколько имён в списке пула пришло не из собственных публикаций стенда.
Функция ЧужихИмён(Знач ТелоСписка)

	Свои = Новый Соответствие();
	Для Каждого Пакет Из Сценарий.Пакеты() Цикл
		Свои.Вставить(НРег(Пакет.Имя), Истина);
	КонецЦикла;

	Результат = 0;
	Для Каждого Строчка Из СтрРазделить(СтрЗаменить(ТелоСписка, Символы.ВК, ""), Символы.ПС, Ложь) Цикл
		Имя = НРег(СокрЛП(Строчка));
		Если ЗначениеЗаполнено(Имя) И Свои.Получить(Имя) = Неопределено Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ВходящиеИРезервы

// Заявитель без права публикации пушит в публичный пул — хаб кладёт пакет во «входящие»
// и отвечает 202. Отказанную заявку мейнтейнер отклоняет, заявитель получает уведомление.
Процедура ПодатьЗаявки()

	Для Каждого Заявка Из Сценарий.Заявки() Цикл

		Если Ключ(Заявка.Публикатор) = Неопределено Тогда
			Войти(Заявка.Публикатор, Сценарий.Пароль());
			ВыпуститьКлюч(Заявка.Публикатор);
		КонецЕсли;

		Версия = Заявка.Версии[0];
		ИмяФайла = Сценарий.ИмяФайла(Заявка.Имя, Версия.Версия);
		Заголовки = Новый Соответствие();
		Заголовки.Вставить("FILE-NAME", ИмяФайла);
		Заголовки.Вставить("Authorization", "Bearer " + Ключ(Заявка.Публикатор));

		Требовать(Клиент.ЗапросБайтами("POST",
			СтрШаблон("/api/v1/pools/%1/push", URLЧасть(Заявка.Пул)),
			Новый ДвоичныеДанные(ОбъединитьПути(КаталогСборки, ИмяФайла)), Заголовки),
			202, СтрШаблон("заявка %1 на пакет %2/%3", Заявка.Публикатор, Заявка.Пул, Заявка.Имя));

	КонецЦикла;

	Для Каждого Заявка Из Сценарий.Заявки() Цикл
		Если Заявка.Отказать Тогда
			ОтклонитьЗаявку(Заявка);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОтклонитьЗаявку(Знач Заявка)

	КлючМейнтейнера = Ключ(Заявка.Рассматривает);
	Входящие = СтрШаблон("/api/v1/pools/%1/inbox", URLЧасть(Заявка.Пул));
	Ответ = Требовать(Клиент.Запрос("GET", Входящие, "", ЗаголовкиJSON(КлючМейнтейнера)),
		200, "входящие пула " + Заявка.Пул);

	Для Каждого Строчка Из Клиент.Данные(Ответ).Получить("items") Цикл
		Если Строчка.Получить("package") <> Заявка.Имя Тогда
			Продолжить;
		КонецЕсли;
		Причина = Новый Структура("reason", Заявка.ПричинаОтказа);
		Требовать(Клиент.Запрос("POST", СтрШаблон("%1/%2/reject", Входящие,
			Формат(Строчка.Получить("id"), "ЧГ=0; ЧН=0")), ТелоJSON(Причина),
			ЗаголовкиJSON(КлючМейнтейнера)), 200, "отказ по заявке на " + Заявка.Имя);
		Возврат;
	КонецЦикла;

	ВызватьИсключение СтрШаблон("Заявки на %1 нет во входящих пула %2", Заявка.Имя, Заявка.Пул);

КонецПроцедуры

// Резерв имени — кнопка «Добавить пакет» на странице пула: пакет без единой версии.
Процедура ЗарезервироватьИмена()

	Для Каждого Резерв Из Сценарий.Резервы() Цикл

		Поля = Новый Массив();
		Поля.Добавить(ПолеФормы("операция", "добавить"));
		Поля.Добавить(ПолеФормы("имя", Резерв.Имя));

		// окно «Добавить пакет» страница печатает по адресу ?окно=добавить — токен формы в нём
		ОтправитьФорму(Резерв.Кем, "/pools/" + URLЧасть(Резерв.Пул) + "?"
			+ КодироватьСтроку("окно", СпособКодированияСтроки.КодировкаURL) + "=добавить",
			СтрШаблон("/pools/%1/packages", URLЧасть(Резерв.Пул)), Поля,
			СтрШаблон("резерв имени %1/%2", Резерв.Пул, Резерв.Имя));

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Подписки

// Подписки заводятся последними: события наполнения к этому моменту отгремели, и доставка
// в фиктивные чаты и на адреса .local во время наполнения не начинается.
Процедура ЗавестиПодписки()

	Для Каждого Подписка Из Сценарий.Подписки() Цикл

		Поля = Новый Структура();
		Поля.Вставить("kind", Подписка.Вид);
		Поля.Вставить("name", Подписка.Название);
		Поля.Вставить("events", Подписка.События);
		Поля.Вставить("narrowing_allowed", Подписка.СужениеРазрешено);
		Поля.Вставить("enabled", Подписка.Включена);
		Если Подписка.Вид = "telegram" Тогда
			Поля.Вставить("чатид", Подписка.ЧатИд);
			Поля.Вставить("токен", Подписка.ТокенБота);
			Поля.Вставить("шаблон", Подписка.Шаблон);
		Иначе
			Поля.Вставить("url", Подписка.Адрес);
		КонецЕсли;
		Если Подписка.ПорогЗаполнения > 0 Тогда
			Параметры = Новый Соответствие();
			Параметры.Вставить("пул.заполнен", Подписка.ПорогЗаполнения);
			Поля.Вставить("params", Параметры);
		КонецЕсли;

		АдресПодписок = АдресПодписок(Подписка);
		Ответ = Требовать(Клиент.Запрос("POST", АдресПодписок, ТелоJSON(Поля),
			ЗаголовкиJSON(Ключ(Подписка.Кем))), 201, "подписка «" + Подписка.Название + "»");

		// заведение включённость не принимает: выключенную подписку выключает правка, как тумблер
		Если НЕ Подписка.Включена Тогда
			Требовать(Клиент.Запрос("PATCH", СтрШаблон("%1/%2", АдресПодписок,
				Формат(НомерПодписки(Ответ), "ЧГ=0; ЧН=0")), ТелоJSON(Новый Структура("enabled", Ложь)),
				ЗаголовкиJSON(Ключ(Подписка.Кем))), 200, "выключение подписки «" + Подписка.Название + "»");
		КонецЕсли;

		Если Подписка.Исключить.Количество() > 0 Тогда
			Исключения = Новый Структура("excluded_packages", Подписка.Исключить);
			Требовать(Клиент.Запрос("PUT", СтрШаблон("%1/%2/recipients", АдресПодписок,
				Формат(НомерПодписки(Ответ), "ЧГ=0; ЧН=0")), ТелоJSON(Исключения),
				ЗаголовкиJSON(Ключ(Подписка.Кем))), 200, "получатели подписки «" + Подписка.Название + "»");
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция АдресПодписок(Знач Подписка)

	Если Подписка.Уровень = "хаб" Тогда
		Возврат "/api/v1/webhooks";
	ИначеЕсли Подписка.Уровень = "пул" Тогда
		Возврат СтрШаблон("/api/v1/pools/%1/webhooks", URLЧасть(Подписка.Пул));
	КонецЕсли;
	Возврат СтрШаблон("/api/v1/pools/%1/packages/%2/webhooks",
		URLЧасть(Подписка.Пул), URLЧасть(Подписка.Пакет));

КонецФункции

Функция НомерПодписки(Знач Ответ)
	Возврат Клиент.Данные(Ответ).Получить("subscription").Получить("id");
КонецФункции

#КонецОбласти

#Область ОбходЭкранов

// Семнадцать экранов карты редизайна глазами администратора: каждый отвечает 200, а экран,
// на котором есть данные, показывает данные стенда — то, чего на пустом хабе нет (учётки,
// пакеты, адреса, названия подписок). Маркер пустой — экран своих данных не печатает,
// и проверяется только ответ: у страниц пула 404 на пустом хабе, у вида и бренда — ничего.
Процедура ОбойтиЭкраныКарты()

	Админ = Сценарий.ЛогинАдмина();
	Свой = "/pools/" + Сценарий.ПулОрганизации();
	Дефолтный = "/pools/" + Сценарий.ДефолтныйПул();
	Ядро = Свой + "/packages/veles-core";
	Пакеты = Сценарий.Пакеты();
	Последний = Пакеты[Пакеты.ВГраница()].Имя;
	Чат = НайтиПодписку("релизы в чат");

	Экраны = Новый ТаблицаЗначений();
	Экраны.Колонки.Добавить("Номер");
	Экраны.Колонки.Добавить("Экран");
	Экраны.Колонки.Добавить("Адрес");
	Экраны.Колонки.Добавить("Видно");

	Экран(Экраны, 1, "шапка и единое меню", "/", Последний);
	Экран(Экраны, 2, "дом хаба", "/hub/settings", Клиент.Адрес());
	Экран(Экраны, 2, "дом пула", Свой + "/settings", "");
	Экран(Экраны, 2, "дом пакета", Ядро + "/settings", "Ядро фреймворка Велес");
	Экран(Экраны, 2, "дом аккаунта", "/me/settings/tokens", Сценарий.КлючиАдмина()[1].Имя);
	Экран(Экраны, 2, "дом группы", "/groups/platform/settings", "alice|bob");
	Экран(Экраны, 3, "хаб: основное", "/hub/settings/identity", Клиент.Адрес());
	Экран(Экраны, 4, "брендирование", "/hub/settings/branding", "favicon.svg");
	Экран(Экраны, 4, "брендирование: вернуть иконку", "/hub/settings/branding?"
		+ КодироватьСтроку("окно", СпособКодированияСтроки.КодировкаURL) + "="
		+ КодироватьСтроку("вернуть-favicon", СпособКодированияСтроки.КодировкаURL), "<dialog");
	Экран(Экраны, 5, "провайдеры входа", "/hub/settings/providers",
		"gitlab|" + Сценарий.ПровайдерИзКонфигурации());
	Экран(Экраны, 5, "страны провайдера", "/hub/settings/providers?"
		+ КодироватьСтроку("окно", СпособКодированияСтроки.КодировкаURL) + "="
		+ КодироватьСтроку("страны-github", СпособКодированияСтроки.КодировкаURL), "Страны и доступ: github|BY, RU");
	Экран(Экраны, 6, "пакеты пула", Свой, Сценарий.Резервы()[0].Имя + "|cron-tasks");
	// по 20 на страницу: приглашённые заведены позже и стоят дальше — их показывает отбор по статусу
	Экран(Экраны, 7, "пользователи", "/hub/settings/users", "erik|carol");
	Экран(Экраны, 7, "пользователи: нечем войти", "/hub/settings/users?status=nologin", "dave");
	Экран(Экраны, 8, "группы", "/hub/settings/groups", "release");
	Экран(Экраны, 9, "пулы хаба", "/hub/settings/pools", "contrib|team");
	Экран(Экраны, 10, "пул: общие", Свой + "/settings/general", "opm install");
	// публичный апстрим без сети не заводится (это предупреждение, а не отказ стенда)
	ЗаведённыеАпстримы.Добавить(АдресВыдачиПула(Сценарий.ВторойАпстрим().ПулИсточник));
	Экран(Экраны, 11, "апстримы", Дефолтный + "/settings/upstreams",
		СтрСоединить(ЗаведённыеАпстримы, "|"));
	Экран(Экраны, 12, "зеркала", Дефолтный + "/settings/mirrors",
		АдресВыдачиПула(Сценарий.ПулОрганизации()));
	ОкноНового = КодироватьСтроку("окно", СпособКодированияСтроки.КодировкаURL) + "="
		+ КодироватьСтроку("новый", СпособКодированияСтроки.КодировкаURL);
	Экран(Экраны, 11, "окно апстрима", Дефолтный + "/settings/upstreams?" + ОкноНового, "Новый апстрим");
	Экран(Экраны, 12, "окно зеркала", Дефолтный + "/settings/mirrors?" + ОкноНового, "Новое зеркало");
	Экран(Экраны, 13, "пакет: карточка", Свой + "/packages/cron-tasks/settings/card", "планировщик");
	Экран(Экраны, 14, "аккаунт: вид и язык", "/me/settings/appearance", "");
	Экран(Экраны, 15, "токены доступа", "/me/settings/tokens", "ноутбук|релиз-бот");
	Экран(Экраны, 15, "окно выпуска токена", "/me/settings/tokens?"
		+ КодироватьСтроку("окно", СпособКодированияСтроки.КодировкаURL) + "="
		+ КодироватьСтроку("новый", СпособКодированияСтроки.КодировкаURL), "Новый токен|" + Сценарий.ПулОрганизации());
	Экран(Экраны, 16, "подписки хаба", "/hub/settings/webhooks", "все релизы в #ops");
	Экран(Экраны, 16, "подписки пула", Свой + "/settings/webhooks", "релизы в чат|ci-hook");
	Экран(Экраны, 16, "подписки пакета", Ядро + "/settings/webhooks", "сборка документации");
	Экран(Экраны, 17, "окно получателей подписки", Свой + "/settings/webhooks?"
		+ КодироватьСтроку("окно", СпособКодированияСтроки.КодировкаURL) + "="
		+ КодироватьСтроку("получатели-" + Формат(НомерПодпискиПоИмени(Чат.Название), "ЧГ=0; ЧН=0"),
			СпособКодированияСтроки.КодировкаURL),
		"Выбранные|выбранные: ");
	Экран(Экраны, 0, "входящие пула", Свой + "/settings/inbox", "corp-metrics|corp-auth");

	ОбойдённыеЭкраны = Экраны;

	Для Каждого Строчка Из Экраны Цикл

		Ответ = Клиент.Запрос("GET", Строчка.Адрес, "", ЗаголовкиСтраницы(Кука(Админ)));
		Нет = Новый Массив();
		Для Каждого Маркер Из СтрРазделить(Строчка.Видно, "|", Ложь) Цикл
			Если СтрНайти(Ответ.Тело, Маркер) = 0 Тогда
				Нет.Добавить(Маркер);
			КонецЕсли;
		КонецЦикла;

		Сообщить(СтрШаблон("демо: экран %1 %2 — %3 → %4%5", Формат(Строчка.Номер, "ЧГ=0; ЧН=0"),
			Строчка.Экран, Строчка.Адрес, Формат(Ответ.Код, "ЧГ=0; ЧН=0"),
			?(Нет.Количество() > 0, ", не видно: " + СтрСоединить(Нет, ", "),
				?(ЗначениеЗаполнено(Строчка.Видно), ", видно: " + СтрЗаменить(Строчка.Видно, "|", ", "),
					", своих данных экран не печатает — проверен ответ"))));

		Если Ответ.Код <> 200 ИЛИ Нет.Количество() > 0 Тогда
			ВызватьИсключение СтрШаблон("Экран «%1» (%2) не показывает данные стенда", Строчка.Экран,
				Строчка.Адрес);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура Экран(Экраны, Знач Номер, Знач Экран, Знач Адрес, Знач Видно)
	Строчка = Экраны.Добавить();
	Строчка.Номер = Номер;
	Строчка.Экран = Экран;
	Строчка.Адрес = Адрес;
	Строчка.Видно = Видно;
КонецПроцедуры

Функция НайтиПодписку(Знач Название)
	Для Каждого Подписка Из Сценарий.Подписки() Цикл
		Если Подписка.Название = Название Тогда
			Возврат Подписка;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "В сценарии нет подписки «" + Название + "»";
КонецФункции

Функция НомерПодпискиПоИмени(Знач Название)

	Для Каждого Подписка Из Сценарий.Подписки() Цикл
		Если Подписка.Название <> Название Тогда
			Продолжить;
		КонецЕсли;
		Ответ = Требовать(Клиент.Запрос("GET", АдресПодписок(Подписка), "",
			ЗаголовкиJSON(Ключ(Подписка.Кем))), 200, "подписки " + Подписка.Уровень);
		Для Каждого Строчка Из Клиент.Данные(Ответ).Получить("items") Цикл
			Если Строчка.Получить("name") = Название Тогда
				Возврат Строчка.Получить("id");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	ВызватьИсключение "Подписки «" + Название + "» на стенде нет";

КонецФункции

#КонецОбласти

#Область Памятка

Процедура ЗаписатьПамятку()

	Адрес = Клиент.Адрес();
	ТокенAlice = Ключ("alice");

	Текст = Новый Массив();
	Текст.Добавить("# Демо-стенд OpenHub");
	Текст.Добавить("");
	Текст.Добавить("Каталог создан скриптом `tools/demo.os` (данные — `data/`, собранные пакеты — `build/`).");
	Текст.Добавить("Каталог целиком под gitignore: его можно удалять и пересоздавать в любой момент.");
	Текст.Добавить("");
	Текст.Добавить("Стенд наполнен **только пользовательскими механиками**: хаб поднимается пустым,");
	Текст.Добавить("а дальше `tools/демо/ЗаполнитьЧерезAPI.os` ходит по тому же HTTP API и тем же формам,");
	Текст.Добавить("что доступны человеку. В базу напрямую не пишет никто.");
	Текст.Добавить("");
	Текст.Добавить("Адрес хаба: " + Адрес);
	Текст.Добавить("");
	Текст.Добавить("Сюжет стенда — **корпоративный хаб**. Короткие легаси-адреса (`/download`,");
	Текст.Добавить("`/dev-channel`, `/push`) ведут в дефолтный пул `" + Сценарий.ДефолтныйПул() + "`,");
	Текст.Добавить("а он — читающее зеркало публичного `" + Сценарий.АдресАпстрима() + "`:");
	Текст.Добавить("отдаёт пакеты экосистемы и не принимает публикации. Собственные пакеты");
	Текст.Добавить("организации живут в соседнем пуле `" + Сценарий.ПулОрганизации() + "`.");
	Текст.Добавить("");
	ДобавитьУчётки(Текст);
	Текст.Добавить("## Права");
	Текст.Добавить("");
	Текст.Добавить("Роли раздаются грантами — тем же экраном прав доступа, что и в жизни:");
	Текст.Добавить("");
	Для Каждого Грант Из Сценарий.ГрантыПулов() Цикл
		Текст.Добавить(СтрШаблон("- пул `%1`: %2 `%3` — роль `%4`;",
			Грант.Пул, Грант.ТипСубъекта, Грант.Субъект, Грант.Роль));
	КонецЦикла;
	Для Каждого Грант Из Сценарий.ГрантыПакетов() Цикл
		Текст.Добавить(СтрШаблон("- пакет `%1/%2`: %3 `%4` — роль `%5` (права без участия в пуле);",
			Грант.Пул, Грант.Пакет, Грант.ТипСубъекта, Грант.Субъект, Грант.Роль));
	КонецЦикла;
	Текст.Добавить("");
	ДобавитьНастройкиХаба(Текст);
	Текст.Добавить("## Токен доступа (PAT) пользователя alice");
	Текст.Добавить("");
	Текст.Добавить("```");
	Текст.Добавить(ТокенAlice);
	Текст.Добавить("```");
	Текст.Добавить("");
	Текст.Добавить("```bash");
	Текст.Добавить("curl -H ""Authorization: Bearer " + ТокенAlice + """ " + Адрес + "/api/v1/pools");
	Текст.Добавить("```");
	Текст.Добавить("");
	Текст.Добавить("## Что посмотреть");
	Текст.Добавить("");
	Зеркало = Адрес + "/pools/" + Сценарий.ДефолтныйПул();
	Свой = Адрес + "/pools/" + Сценарий.ПулОрганизации();

	Текст.Добавить("- `" + Адрес + "/` — лендинг со сводкой хаба;");
	Текст.Добавить("- `" + Адрес + "/packages` — каталог с поиском и пагинацией;");
	Текст.Добавить("- `" + Свой + "/packages/veles-core` — карточка пакета: README, версии, зависимости, теги;");
	Текст.Добавить("- `" + Свой + "` — пакеты организации: публичный пул, публикация разрешена;");
	Текст.Добавить("- `" + Зеркало + "` — дефолтный пул: зеркало апстрима, публикация выключена;");
	Текст.Добавить("- `" + Адрес + "/pools/contrib` — пул сообщества;");
	Текст.Добавить("- `" + Адрес + "/pools/team` — приватный пул с квотой: аноним его не видит, bob и carol видят;");
	Текст.Добавить("");
	Текст.Добавить("Пять домов настроек:");
	Текст.Добавить("");
	Текст.Добавить("- `" + Адрес + "/me/settings` — личные настройки (аккаунт, токены, ключи);");
	Текст.Добавить("- `" + Адрес + "/groups/platform/settings` — дом группы;");
	Текст.Добавить("- `" + Зеркало + "/settings` — дом пула: там же список апстримов зеркала;");
	Текст.Добавить("- `" + Свой + "/packages/veles-core/settings` — дом пакета;");
	Текст.Добавить("- `" + Адрес + "/hub/settings` — дом хаба (только root).");
	Текст.Добавить("");
	ДобавитьЭкраныКарты(Текст);
	Текст.Добавить("## Чего на стенде нет и почему");
	Текст.Добавить("");
	Текст.Добавить("- **всё датировано днём запуска.** Задать прошедшую дату публикации или скачивания");
	Текст.Добавить("  через API нельзя, а подделывать даты записью в базу стенд не станет: версии");
	Текст.Добавить("  опубликованы сегодня, суточные агрегаты скачиваний — все за одни сутки,");
	Текст.Добавить("  сегодняшние, так что истории «по дням» на стенде не увидеть;");
	Текст.Добавить("- **статистика скачиваний настоящая**: столько запросов");
	Текст.Добавить("  `GET /api/v1/pools/{пул}/download/…` стенд и сделал — "
		+ Формат(ВсегоСкачиваний, "ЧГ=0; ЧН=0") + ".");
	Текст.Добавить("  Счётчик копится в памяти и уходит в базу фоновой задачей, поэтому стенд ждёт");
	Текст.Добавить("  сброса перед перезапуском хаба. Витрина показывает одно суммарное число");
	Текст.Добавить("  на пакет: разбивки по версиям и по дням в интерфейсе нет;");
	ДобавитьСостояниеЗеркала(Текст);
	ДобавитьНедоступное(Текст);
	Текст.Добавить("");
	ДобавитьУстановкуИПубликацию(Текст);

	Если Предупреждения.Количество() > 0 Тогда
		Текст.Добавить("");
		Текст.Добавить("## Предупреждения этого прогона");
		Текст.Добавить("");
		Для Каждого Строчка Из Предупреждения Цикл
			Текст.Добавить("- " + Строчка + ";");
		КонецЦикла;
	КонецЕсли;

	ЗаписатьТекстВФайл(ОбъединитьПути(КореньДемо, "ДЕМО.md"), СтрСоединить(Текст, Символы.ПС));

КонецПроцедуры

Процедура ДобавитьУчётки(Текст)

	Текст.Добавить("## Учётные записи");
	Текст.Добавить("");
	Текст.Добавить(СтрШаблон("Пароль администратора — `%1`, у всех остальных, кто входит паролем, — `%2`.",
		ИзОкружения("OSHUB_DEMO_ROOT_PASSWORD", "RootPassw0rd"), Сценарий.Пароль()));
	Текст.Добавить("");
	Текст.Добавить("| Логин | Роль хаба | Вход | Кто это |");
	Текст.Добавить("| --- | --- | --- | --- |");
	Текст.Добавить("| root | admin | пароль | первый администратор: дом настроек хаба, все объекты |");

	Массовка = Новый Массив();
	Для Каждого Человек Из Сценарий.Люди() Цикл
		Если Человек.Массовка Тогда
			Массовка.Добавить(Человек.Логин + ?(Человек.Заблокирован, " (заблокирован)",
				?(Человек.Вход = "приглашение", " (приглашён, войти нечем)", "")));
			Продолжить;
		КонецЕсли;
		Текст.Добавить(СтрШаблон("| %1 | %2 | %3 | %4 |", Человек.Логин, Человек.РольХаба,
			ВходСловами(Человек), Человек.ВСюжете));
	КонецЦикла;

	Текст.Добавить("");
	Текст.Добавить(СтрШаблон("Массовка — %1 учёток, на которых экран «Люди» листается страницами"
		+ " и отбирается по роли и статусу: %2.", Формат(Массовка.Количество(), "ЧГ=0; ЧН=0"),
		СтрСоединить(Массовка, ", ")));
	Текст.Добавить("");

КонецПроцедуры

Функция ВходСловами(Знач Человек)
	Если Человек.Вход = "приглашение" Тогда
		Возврат "нечем: приглашён, пароля не задал";
	ИначеЕсли Человек.Заблокирован Тогда
		Возврат "заблокирован";
	КонецЕсли;
	Возврат "пароль";
КонецФункции

Процедура ДобавитьНастройкиХаба(Текст)

	Адрес = Клиент.Адрес();

	Текст.Добавить("## Что заведено в настройках");
	Текст.Добавить("");
	Текст.Добавить("- **адрес инсталляции** — `" + Адрес + "`: из него хаб выводит адрес возврата"
		+ " провайдеров входа;");
	Текст.Добавить("- **провайдеры входа**:");
	Для Каждого Провайдер Из Сценарий.ПровайдерыВхода() Цикл
		Текст.Добавить(СтрШаблон("  - `%1` — пресет %2, %3%4;", Провайдер.Имя, Провайдер.Пресет,
			?(Провайдер.Включён, "включён", "выключен"),
			?(ЗначениеЗаполнено(Провайдер.ЗакрытВСтранах),
				", закрыт в странах " + Провайдер.ЗакрытВСтранах, "")));
	КонецЦикла;
	Текст.Добавить(СтрШаблон("  - `%1` — объявлен конфигурацией стенда (переменные `OSHUB_OIDC_*`"
		+ " в `tools/demo.os`), правке из интерфейса не поддаётся;", Сценарий.ПровайдерИзКонфигурации()));
	Текст.Добавить("  клиенты и секреты фиктивные: кнопки GitHub и GitLab на странице входа уведут браузер"
		+ " на github.com и gitlab.com, и те откажут незнакомому client_id; издатель `corp-sso` —"
		+ " в зоне `.local`, его хаб ищет только в своей сети;");

	Группы = Новый Массив();
	Для Каждого Группа Из Сценарий.Группы() Цикл
		Группы.Добавить(СтрШаблон("`%1` (%2)", Группа.Имя, СтрСоединить(Группа.Участники, ", ")));
	КонецЦикла;
	Текст.Добавить("- **группы** — " + СтрСоединить(Группы, "; ") + ";");

	Текст.Добавить("- **пул по умолчанию `" + Сценарий.ДефолтныйПул() + "`**: апстримы — `"
		+ Сценарий.АдресАпстрима() + "` и выдача пула `" + Сценарий.ВторойАпстрим().ПулИсточник
		+ "` этого же хаба по ключу (маски `" + СтрСоединить(Сценарий.ВторойАпстрим().Разрешено, ", ")
		+ "`); зеркала — из пулов этого же хаба:");
	Для Каждого Зеркало Из Сценарий.Зеркала() Цикл
		Текст.Добавить(СтрШаблон("  - из `%1`, маски `%2`, раз в %3 с, %4;", Зеркало.ПулИсточник,
			СтрСоединить(Зеркало.Фильтр, ", "), Формат(Зеркало.Интервал, "ЧГ=0; ЧН=0"),
			?(Зеркало.Включено, "включено и прогнано при наполнении", "выключено")));
	КонецЦикла;
	Текст.Добавить("  маски не совпадают ни с одним пакетом стенда — зеркала показывают прогон,"
		+ " но ничего не переносят;");

	Текст.Добавить("- **подписки на события** (чаты Telegram и токены ботов фиктивные, адреса"
		+ " вебхуков — в зоне `.local`; доставка включена, прокси Telegram — несуществующий узел `"
		+ Сценарий.ПроксиTelegram() + "`):");
	Для Каждого Подписка Из Сценарий.Подписки() Цикл
		Текст.Добавить(СтрШаблон("  - %1 «%2» — %3%4%5;", ОбъектПодписки(Подписка), Подписка.Название,
			Подписка.Вид, ?(Подписка.Включена, "", ", выключена"),
			?(Подписка.Исключить.Количество() > 0,
				", выбраны пакеты пула, кроме " + СтрСоединить(Подписка.Исключить, ", "), "")));
	КонецЦикла;
	Текст.Добавить("  заведены последними, после всех событий наполнения: доставка во время"
		+ " наполнения не начиналась. Опубликуете версию на стенде — хаб попробует доставить,"
		+ " и попытка откажет на этой же машине: Bot API он зовёт через прокси-тупик, а адреса"
		+ " `.local` ищет только в своей сети. В сеть стенд не выходит;");

	КлючиАдмина = Новый Массив();
	Для Каждого Описание Из Сценарий.КлючиАдмина() Цикл
		КлючиАдмина.Добавить(СтрШаблон("«%1» (%2, %3 дн.)", Описание.Имя, Описание.Права,
			Формат(Описание.СрокДней, "ЧГ=0; ЧН=0")));
	КонецЦикла;
	Текст.Добавить("- **токены доступа root** — " + СтрСоединить(КлючиАдмина, ", ")
		+ " и «наполнение стенда» (7 дн.), которым наполнитель ходил в API;");

	Заявки = Новый Массив();
	Для Каждого Заявка Из Сценарий.Заявки() Цикл
		Заявки.Добавить(СтрШаблон("`%1` от %2%3", Заявка.Имя, Заявка.Публикатор,
			?(Заявка.Отказать, " (отклонена — у заявителя уведомление)", "")));
	КонецЦикла;
	Текст.Добавить("- **входящие пула `" + Сценарий.ПулОрганизации() + "`** — "
		+ СтрСоединить(Заявки, ", ") + ";");

	Резервы = Новый Массив();
	Для Каждого Резерв Из Сценарий.Резервы() Цикл
		Резервы.Добавить(СтрШаблон("`%1/%2`", Резерв.Пул, Резерв.Имя));
	КонецЦикла;
	Текст.Добавить("- **резерв имени** — " + СтрСоединить(Резервы, ", ") + ": пакет без версий.");
	Текст.Добавить("");

КонецПроцедуры

Функция ОбъектПодписки(Знач Подписка)
	Если Подписка.Уровень = "хаб" Тогда
		Возврат "хаб";
	ИначеЕсли Подписка.Уровень = "пул" Тогда
		Возврат "пул `" + Подписка.Пул + "`";
	КонецЕсли;
	Возврат СтрШаблон("пакет `%1/%2`", Подписка.Пул, Подписка.Пакет);
КонецФункции

// Экраны карты редизайна — те же адреса, что обошёл наполнитель под root.
Процедура ДобавитьЭкраныКарты(Текст)

	Текст.Добавить("Экраны карты редизайна (наполнитель обошёл их под root: все ответили 200, экраны"
		+ " с данными показали данные стенда; у отмеченных «—» своих данных нет, проверен ответ):");
	Текст.Добавить("");
	Для Каждого Строчка Из ОбойдённыеЭкраны Цикл
		Текст.Добавить(СтрШаблон("- %1 %2 — `%3%4`%5;", ?(Строчка.Номер = 0, "·",
			Формат(Строчка.Номер, "ЧГ=0; ЧН=0") + "."), Строчка.Экран, Клиент.Адрес(), Строчка.Адрес,
			?(ЗначениеЗаполнено(Строчка.Видно), "", " —")));
	КонецЦикла;
	Текст.Добавить("");

КонецПроцедуры

Процедура ДобавитьНедоступное(Текст)

	Текст.Добавить("- **уведомлений у root нет**: личная лента пишется только заявителю об исходе"
		+ " его заявки, а администратор заявок не подаёт — уведомление видно под `heidi`;");
	Текст.Добавить("- **истёкшего токена нет**: срок ключа задаётся от дня выпуска, выпустить ключ"
		+ " «в прошлом» API не даёт — ближе всех к концу срока «релиз-бот»;");
	Текст.Добавить("- **привязок OIDC нет**: привязку делает живой вход через провайдера, а настоящего"
		+ " IdP у стенда нет;");
	Текст.Добавить("- **доставок подписок нет**: «последняя доставка» появится после первого события"
		+ " и будет отказом — прокси Telegram и адреса вебхуков никуда не ведут;");
	Текст.Добавить("- **адреса стенда знают порт наполнения**: адрес инсталляции, второй апстрим и"
		+ " зеркала записаны с портом " + Формат(Клиент.Порт(), "ЧГ=0; ЧН=0") + ". `--keep` на другом"
		+ " порту не поднимает такой стенд, а наполняет его заново;");
	Текст.Добавить("- **логотип и иконка сайта — стандартные**: стенд картинок не загружает.");

КонецПроцедуры

// Кэш зеркала описывается тем, что вышло у пробника: пустой кэш и наполненный —
// разные обещания, и памятка не должна выдавать одно за другое.
Процедура ДобавитьСостояниеЗеркала(Текст)

	Пробник = Сценарий.ПробникЗеркала();
	ИмяАртефакта = Сценарий.ИмяФайла(Пробник.Имя, Пробник.Версия);

	Если ЗеркалоКод = 200 И ЗеркалоБайт > 0 Тогда
		Текст.Добавить(СтрШаблон("- **кэш дефолтного пула `%1` наполняется по запросу**: стенд"
			+ " попросил", Сценарий.ДефолтныйПул()));
		Текст.Добавить(СтрШаблон("  `%1` коротким адресом, зеркало сходило в апстрим и положило"
			+ " версию в кэш", ИмяАртефакта));
		Текст.Добавить(СтрШаблон("  (%1 байт). Имён апстрима в `/download/list.txt` видно %2 —"
			+ " каждое приедет в пул",
			Формат(ЗеркалоБайт, "ЧГ=0; ЧН=0"), Формат(ЗеркалоЧужихИмён, "ЧГ=0; ЧН=0")));
		Текст.Добавить("  по первому же запросу;");
		Текст.Добавить(СтрШаблон("- **у проксированных пакетов пустая карточка**: у `%1` в пуле"
			+ " `%2` нет ни описания,", Пробник.Имя, Сценарий.ДефолтныйПул()));
		Текст.Добавить("  ни ключевых слов, а вкладка зависимостей пишет «ни от чего не зависит»."
			+ " Это не поломка:");
		Текст.Добавить("  манифест апстрима в карточку нашего пула не переносится — иначе апстрим"
			+ " писал бы");
		Текст.Добавить("  текст в наш пул. Карточку заполняет только публикация в этот хаб;");
	Иначе
		Текст.Добавить(СтрШаблон("- **кэш дефолтного пула `%1` пуст**: зеркало не отдало `%2`"
			+ " (код %3).", Сценарий.ДефолтныйПул(), ИмяАртефакта,
			Формат(ЗеркалоКод, "ЧГ=0; ЧН=0")));
		Текст.Добавить("  Индексировать чужую версию «как проксированную» через API нельзя,"
			+ " а публиковать в пул");
		Текст.Добавить("  с выключенной публикацией запрещено — пул стоит с настроенным источником"
			+ " и пустым кэшем;");
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьУстановкуИПубликацию(Текст)

	Зеркало = Сценарий.ДефолтныйПул();
	Свой = Сценарий.ПулОрганизации();
	ИмяСервераЗеркала = "openhub-" + Зеркало;
	ИмяСервераСвоего = "openhub-" + Свой;

	Текст.Добавить("## Установка и публикация");
	Текст.Добавить("");
	Текст.Добавить(СтрШаблон("Адресов два. Короткий (`ПутьНаСервере: /download/`) ведёт в"
		+ " дефолтный пул `%1` —", Зеркало));
	Текст.Добавить(СтрШаблон("зеркало `%1`:", Сценарий.АдресАпстрима()));
	Текст.Добавить("им ставятся публичные пакеты экосистемы. Публикацию он не принимает,");
	Текст.Добавить("`POST /push` отвечает **409** — стенд проверяет это сам при каждой сборке.");
	Текст.Добавить(СтрШаблон("Пакеты организации и ставятся, и публикуются адресом пула `%1`.", Свой));
	Текст.Добавить("");
	Текст.Добавить("`opm.cfg` с обоими серверами (порт продублирован в `Сервер`: `opm push`");
	Текст.Добавить("поле `Порт` не читает и без порта в адресе стучится на 80):");
	Текст.Добавить("");
	Текст.Добавить("```json");
	Текст.Добавить("{");
	Текст.Добавить("    ""СервераПакетов"": [");
	Текст.Добавить(СтрокаOpmCfg(ИмяСервераЗеркала, "/download/", "/push", "", 0) + ",");
	Текст.Добавить(СтрокаOpmCfg(ИмяСервераСвоего,
		СтрШаблон("/api/v1/pools/%1/download/", Свой),
		СтрШаблон("/api/v1/pools/%1/push", Свой), "Bearer " + Ключ("alice"), 1));
	Текст.Добавить("    ]");
	Текст.Добавить("}");
	Текст.Добавить("```");
	Текст.Добавить("");
	Текст.Добавить("```bash");
	Текст.Добавить("# публичный пакет из зеркала");
	Текст.Добавить(СтрШаблон("opm install -l -m %1 %2", ИмяСервераЗеркала,
		Сценарий.ПробникЗеркала().Имя));
	Текст.Добавить("# свой пакет из пула организации");
	Текст.Добавить(СтрШаблон("opm install -l -m %1 veles-core", ИмяСервераСвоего));
	Текст.Добавить("# публикация: короткий /push отвечал бы 409");
	Текст.Добавить(СтрШаблон("opm push -m %1 -f veles-core-1.2.0.ospx", ИмяСервераСвоего));
	Текст.Добавить("```");

КонецПроцедуры

// Один сервер пакетов в opm.cfg — блок с отступом внутрь массива СервераПакетов.
// Порт стоит и в «Сервер», и в «Порт»: opm push поле «Порт» не читает и без порта
// в адресе стучится на 80.
Функция СтрокаOpmCfg(Знач Имя, Знач ПутьНаСервере, Знач РесурсПубликации, Знач Авторизация,
	Знач Приоритет)

	Строчки = Новый Массив();
	Строчки.Добавить("        {");
	Строчки.Добавить(СтрШаблон("            ""Имя"": ""%1"",", Имя));
	Строчки.Добавить(СтрШаблон("            ""Сервер"": ""%1"",", Клиент.Адрес()));
	Строчки.Добавить(СтрШаблон("            ""Порт"": %1,", Формат(Клиент.Порт(), "ЧГ=0; ЧН=0")));
	Строчки.Добавить(СтрШаблон("            ""ПутьНаСервере"": ""%1"",", ПутьНаСервере));
	Строчки.Добавить(СтрШаблон("            ""РесурсПубликацииПакетов"": ""%1"",", РесурсПубликации));
	Если ЗначениеЗаполнено(Авторизация) Тогда
		Строчки.Добавить(СтрШаблон("            ""Авторизация"": ""%1"",", Авторизация));
	КонецЕсли;
	Строчки.Добавить(СтрШаблон("            ""Приоритет"": %1", Формат(Приоритет, "ЧГ=0; ЧН=0")));
	Строчки.Добавить("        }");

	Возврат СтрСоединить(Строчки, Символы.ПС);

КонецФункции

#КонецОбласти

Процедура Заполнить()

	КаталогСценария = Новый Файл(ТекущийСценарий().Источник).Путь;
	ПодключитьСценарий(ОбъединитьПути(КаталогСценария, "СценарийСтенда.os"), "СценарийСтенда");
	ПодключитьСценарий(ОбъединитьПути(КаталогСценария, "КлиентХаба.os"), "КлиентХаба");

	Ключи = Новый Соответствие();
	Куки = Новый Соответствие();
	Предупреждения = Новый Массив();
	ВсегоВерсий = 0;
	ВсегоСкачиваний = 0;
	ЗеркалоЧужихИмён = 0;
	ЗеркалоКод = 0;
	ЗеркалоБайт = 0;
	ЗаведённыеАпстримы = Новый Массив();

	Сценарий = Новый СценарийСтенда(ИзОкружения("OSHUB_DEMO_PASSWORD", "DemoPassw0rd"));
	Клиент = Новый КлиентХаба(ИзОкружения("OSHUB_DEMO_HOST", "localhost"),
		ЧислоИзОкружения("OSHUB_PORT", 3380));

	КореньДемо = Новый Файл(ИзОкружения("OSHUB_DEMO_ROOT",
		ОбъединитьПути(КаталогСценария, "..", "..", "demo"))).ПолноеИмя;
	КаталогСборки = ОбъединитьПути(КореньДемо, "build");

	ПроверитьГотовность();

	СоздатьАдмина();
	ВыпуститьКлюч(Сценарий.ЛогинАдмина());
	НастроитьАдресХаба();
	НаправитьДоставкуTelegramВТупик();
	ЗагрузитьКартинкиБренда();

	СоздатьЛюдей();
	Для Каждого Логин Из СтрРазделить("alice,bob", ",") Цикл
		Войти(Логин, Сценарий.Пароль());
		ВыпуститьКлюч(Логин);
	КонецЦикла;
	ПригласитьЛюдей();
	НазначитьАдминов();

	СоздатьГруппы();

	СоздатьПулы();
	ВыдатьГрантыПулов();

	ОпубликоватьПакеты();
	ПроверитьЗапретКороткойПубликации();
	ОтозватьВерсии();
	ЗавестиКаналыПоУмолчанию();
	ПоставитьТеги();
	ВыдатьГрантыПакетов();
	ЗаполнитьКарточки();

	НабратьСкачивания();
	ПроверитьЗеркало();

	ЗавестиПровайдеров();
	ВыпуститьКлючиАдмина();
	ПодатьЗаявки();
	ЗарезервироватьИмена();
	ЗавестиВторойАпстрим();
	ЗавестиЗеркала();
	ЗаблокироватьУчётки();
	ЗавестиПодписки();

	ДождатьсяСбросаСтатистики();
	ОбойтиЭкраныКарты();

	ЗаписатьПамятку();

	Сообщить("демо: адрес " + Клиент.Адрес());
	Сообщить(СтрШаблон("демо: пользователей %1, групп %2, пулов %3, пакетов %4, версий %5, скачиваний %6",
		Формат(Сценарий.Люди().Количество() + 1, "ЧГ=0; ЧН=0"),
		Формат(Сценарий.Группы().Количество(), "ЧГ=0; ЧН=0"),
		Формат(Сценарий.Пулы().Количество(), "ЧГ=0; ЧН=0"),
		Формат(Сценарий.Пакеты().Количество(), "ЧГ=0; ЧН=0"),
		Формат(ВсегоВерсий, "ЧГ=0; ЧН=0"),
		Формат(ВсегоСкачиваний, "ЧГ=0; ЧН=0")));
	Сообщить(СтрШаблон("демо: зеркало %1 в пуле %2 — /download/list.txt отдал %3 чужих имён,"
		+ " пробное скачивание %4 (%5 байт)",
		Сценарий.АдресАпстрима(), Сценарий.ДефолтныйПул(),
		Формат(ЗеркалоЧужихИмён, "ЧГ=0; ЧН=0"),
		Формат(ЗеркалоКод, "ЧГ=0; ЧН=0"), Формат(ЗеркалоБайт, "ЧГ=0; ЧН=0")));
	Сообщить("демо: PAT alice — " + Ключ("alice"));
	Сообщить("демо: памятка — " + ОбъединитьПути(КореньДемо, "ДЕМО.md"));
	Сообщить("DEMO-OK");

КонецПроцедуры

Заполнить();
