// Наполняет поднятый демо-хаб только пользовательскими механиками: HTTP-вызовы того же
// API и тех же форм, что доступны человеку. Классов хаба не подключает и в базу не пишет.

Перем Клиент;
Перем Сценарий;
Перем КореньДемо;
Перем КаталогСборки;
Перем Ключи;             // Соответствие: логин -> PAT
Перем Куки;              // Соответствие: логин -> кука сессии
Перем Предупреждения;    // Массив из Строка - некритичные отказы стенда
Перем ВсегоВерсий;
Перем ВсегоСкачиваний;
Перем ЗеркалоЧужихИмён;  // Число - имён апстрима в списке дефолтного пула
Перем ЗеркалоКод;        // Число - код ответа пробного скачивания через зеркало
Перем ЗеркалоБайт;       // Число - размер тела пробного скачивания

#Область Служебное

Функция ИзОкружения(Знач Имя, Знач ПоУмолчанию)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ПоУмолчанию);
КонецФункции

Функция ЧислоИзОкружения(Знач Имя, Знач ПоУмолчанию)
	Попытка
		Возврат Число(ИзОкружения(Имя, Формат(ПоУмолчанию, "ЧГ=0; ЧН=0")));
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
КонецФункции

Процедура ЗаписатьТекстВФайл(Знач Путь, Знач Текст)
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

Функция ТелоJSON(Знач Поля)
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Поля);
	Возврат Запись.Закрыть();
КонецФункции

Функция ЗаголовкиJSON(Знач Токен = "", Знач Кука = "")
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Accept", "application/json");
	Если ЗначениеЗаполнено(Токен) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
	КонецЕсли;
	Если ЗначениеЗаполнено(Кука) Тогда
		Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	КонецЕсли;
	Возврат Заголовки;
КонецФункции

// Ответ с ожидаемым кодом; иначе исключение с методом, адресом, кодом и телом.
Функция Требовать(Знач Ответ, Знач Ожидаемый, Знач Пояснение)

	Если Ответ.Код = Ожидаемый Тогда
		Возврат Ответ;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("%1: %2 %3 → %4 (ожидался %5). Тело: %6",
		Пояснение, Ответ.Метод, Ответ.Путь,
		Формат(Ответ.Код, "ЧГ=0; ЧН=0"), Формат(Ожидаемый, "ЧГ=0; ЧН=0"),
		Лев(СтрЗаменить(Ответ.Тело, Символы.ПС, " "), 400));

КонецФункции

Процедура Предупредить(Знач Текст)
	Предупреждения.Добавить(Текст);
	Сообщить("демо: ВНИМАНИЕ — " + Текст);
КонецПроцедуры

Функция Ключ(Знач Логин)
	Возврат Ключи[Логин];
КонецФункции

Функция Кука(Знач Логин)
	Возврат Куки[Логин];
КонецФункции

Функция URLЧасть(Знач Значение)
	Возврат КодироватьСтроку(Строка(Значение), СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти

#Область Готовность

// /ready, а не /health: последний отвечает 200 и на недособранном хабе.
Процедура ПроверитьГотовность()

	Ответ = Клиент.Запрос("GET", "/ready");
	Данные = Клиент.Данные(Ответ);

	Если Ответ.Код <> 200 ИЛИ Данные = Неопределено ИЛИ Данные.Получить("ready") <> Истина Тогда
		ВызватьИсключение СтрШаблон(
			"Хаб на %1 не готов принимать наполнение: GET /ready → %2, тело %3."
			+ " Наполнение рассчитано на поднятый и собранный хаб (его поднимает tools/demo.os).",
			Клиент.Адрес(), Формат(Ответ.Код, "ЧГ=0; ЧН=0"), Лев(Ответ.Тело, 200));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Учётки

// Мастер первого запуска: работает, только пока в хабе нет ни одного пользователя,
// поэтому администратор обязан появиться раньше всех остальных.
Процедура СоздатьАдмина()

	Логин = Сценарий.ЛогинАдмина();
	Пароль = ИзОкружения("OSHUB_DEMO_ROOT_PASSWORD", "RootPassw0rd");

	Поля = Новый Структура();
	Поля.Вставить("логин", Логин);
	Поля.Вставить("пароль", Пароль);

	Ответ = Требовать(Клиент.Запрос("POST", "/setup", ТелоJSON(Поля), ЗаголовкиJSON()),
		201, "мастер первого запуска");

	Куки.Вставить(Логин, Клиент.КукаСессии(Ответ));
	Если НЕ ЗначениеЗаполнено(Кука(Логин)) Тогда
		ВызватьИсключение "Мастер /setup не выдал куку сессии администратора";
	КонецЕсли;

КонецПроцедуры

Процедура СоздатьЛюдей()

	Для Каждого Человек Из Сценарий.Люди() Цикл

		Поля = Новый Структура();
		Поля.Вставить("логин", Человек.Логин);
		Поля.Вставить("email", Человек.Email);
		Поля.Вставить("пароль", Сценарий.Пароль());

		Требовать(Клиент.Запрос("POST", "/api/v1/users", ТелоJSON(Поля), ЗаголовкиJSON()),
			201, "регистрация " + Человек.Логин);

	КонецЦикла;

КонецПроцедуры

Процедура Войти(Знач Логин, Знач Пароль)

	Поля = Новый Структура();
	Поля.Вставить("логин", Логин);
	Поля.Вставить("пароль", Пароль);

	Ответ = Требовать(Клиент.Запрос("POST", "/api/v1/login", ТелоJSON(Поля), ЗаголовкиJSON()),
		200, "вход " + Логин);

	Куки.Вставить(Логин, Клиент.КукаСессии(Ответ));
	Если НЕ ЗначениеЗаполнено(Кука(Логин)) Тогда
		ВызватьИсключение "Вход " + Логин + " не выдал куку сессии";
	КонецЕсли;

КонецПроцедуры

// Ключ выпускается сессией: PAT ключей не выпускает (403 token_cannot_manage_tokens).
// Ключ непривязанный — привязанный к пулу не смог бы создавать пулы и группы.
Процедура ВыпуститьКлюч(Знач Логин)

	// срок заведомо ниже любого разумного потолка хаба: стенду ключ нужен на один прогон
	Поля = Новый Структура();
	Поля.Вставить("права", "read,write");
	Поля.Вставить("срок_дней", 7);
	Поля.Вставить("пул", 0);

	Ответ = Требовать(
		Клиент.Запрос("POST", "/api/v1/tokens", ТелоJSON(Поля), ЗаголовкиJSON("", Кука(Логин))),
		201, "выпуск PAT " + Логин);

	Значение = Клиент.Данные(Ответ).Получить("token_info").Получить("token");
	Ключи.Вставить(Логин, Значение);

КонецПроцедуры

Процедура СоздатьГруппы()

	Для Каждого Группа Из Сценарий.Группы() Цикл

		Поля = Новый Структура();
		Поля.Вставить("имя", Группа.Имя);
		Поля.Вставить("описание", Группа.Описание);

		Требовать(Клиент.Запрос("POST", "/api/v1/groups", ТелоJSON(Поля),
			ЗаголовкиJSON(Ключ(Сценарий.ЛогинАдмина()))), 201, "создание группы " + Группа.Имя);

		Для Каждого Участник Из Группа.Участники Цикл
			Состав = Новый Структура();
			Состав.Вставить("логин", Участник);
			Требовать(Клиент.Запрос("POST",
				СтрШаблон("/api/v1/groups/%1/members", URLЧасть(Группа.Имя)),
				ТелоJSON(Состав), ЗаголовкиJSON(Ключ(Сценарий.ЛогинАдмина()))),
				201, СтрШаблон("участник %1 в группе %2", Участник, Группа.Имя));
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Пулы

Процедура СоздатьПулы()

	АдминКлюч = Ключ(Сценарий.ЛогинАдмина());

	Для Каждого Пул Из Сценарий.Пулы() Цикл

		Поля = Новый Структура();
		Поля.Вставить("имя", Пул.Имя);
		Поля.Вставить("тип", Пул.Тип);
		Поля.Вставить("видимость", Пул.Видимость);
		Поля.Вставить("квота_мб", Пул.КвотаМб);

		Требовать(Клиент.Запрос("POST", "/api/v1/pools", ТелоJSON(Поля), ЗаголовкиJSON(АдминКлюч)),
			201, "создание пула " + Пул.Имя);

		Если НЕ Пул.ПубликацияРазрешена Тогда
			Настройки = Новый Структура();
			Настройки.Вставить("публикация", "false");
			Требовать(Клиент.Запрос("PATCH",
				СтрШаблон("/api/v1/pools/%1/settings", URLЧасть(Пул.Имя)),
				ТелоJSON(Настройки), ЗаголовкиJSON(АдминКлюч)),
				200, "запрет публикации в пуле " + Пул.Имя);
		КонецЕсли;

		Если ЗначениеЗаполнено(Пул.Апстрим) Тогда
			ЗавестиАпстрим(Пул, АдминКлюч);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Адрес апстрима судит SSRF-валидатор, а он резолвит DNS: без сети шаг отказывает.
// Стенд от этого не разваливается — пул остаётся кэширующим, но без источника.
Процедура ЗавестиАпстрим(Знач Пул, Знач АдминКлюч)

	Поля = Новый Структура();
	Поля.Вставить("url", Пул.Апстрим);
	Поля.Вставить("ttl", 900);

	Ответ = Клиент.Запрос("POST", СтрШаблон("/api/v1/pools/%1/upstreams", URLЧасть(Пул.Имя)),
		ТелоJSON(Поля), ЗаголовкиJSON(АдминКлюч));

	Если Ответ.Код <> 201 Тогда
		Предупредить(СтрШаблон(
			"апстрим %1 для пула %2 не заведён (код %3): SSRF-валидатор резолвит DNS,"
			+ " на машине без сети это ожидаемо. Пул останется без источника.",
			Пул.Апстрим, Пул.Имя, Формат(Ответ.Код, "ЧГ=0; ЧН=0")));
	КонецЕсли;

КонецПроцедуры

Процедура ВыдатьГрантыПулов()

	АдминКлюч = Ключ(Сценарий.ЛогинАдмина());

	Для Каждого Грант Из Сценарий.ГрантыПулов() Цикл

		Поля = Новый Структура();
		Поля.Вставить("тип_субъекта", Грант.ТипСубъекта);
		Поля.Вставить("субъект", Грант.Субъект);
		Поля.Вставить("роль", Грант.Роль);

		Требовать(Клиент.Запрос("POST", СтрШаблон("/api/v1/pools/%1/grants", URLЧасть(Грант.Пул)),
			ТелоJSON(Поля), ЗаголовкиJSON(АдминКлюч)),
			201, СтрШаблон("роль %1 субъекту %2 на пуле %3", Грант.Роль, Грант.Субъект, Грант.Пул));

	КонецЦикла;

КонецПроцедуры

Процедура ВыдатьГрантыПакетов()

	Для Каждого Грант Из Сценарий.ГрантыПакетов() Цикл

		Поля = Новый Структура();
		Поля.Вставить("пакет", Грант.Пакет);
		Поля.Вставить("тип_субъекта", Грант.ТипСубъекта);
		Поля.Вставить("субъект", Грант.Субъект);
		Поля.Вставить("роль", Грант.Роль);

		Требовать(Клиент.Запрос("POST", СтрШаблон("/api/v1/pools/%1/grants", URLЧасть(Грант.Пул)),
			ТелоJSON(Поля), ЗаголовкиJSON(Ключ(Грант.Выдаёт))),
			201, СтрШаблон("грант %1 на пакет %2/%3", Грант.Субъект, Грант.Пул, Грант.Пакет));

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Публикация

// Публикация — сырые байты .ospx телом, метаданные в FILE-NAME и CHANNEL:
// ровно то, что делает `opm push`.
Процедура ОпубликоватьПакеты()

	Для Каждого Пакет Из Сценарий.Пакеты() Цикл
		Для Каждого Версия Из Пакет.Версии Цикл
			ОпубликоватьВерсию(Пакет, Версия);
			ВсегоВерсий = ВсегоВерсий + 1;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ОпубликоватьВерсию(Знач Пакет, Знач Версия)

	ИмяФайла = Сценарий.ИмяФайла(Пакет.Имя, Версия.Версия);
	Путь = ОбъединитьПути(КаталогСборки, ИмяФайла);

	Если НЕ Новый Файл(Путь).Существует() Тогда
		ВызватьИсключение СтрШаблон(
			"Нет собранного артефакта %1: сначала соберите пакеты (tools/демо/СобратьПакеты.os)", Путь);
	КонецЕсли;

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", ИмяФайла);
	Заголовки.Вставить("Authorization", "Bearer " + Ключ(Пакет.Публикатор));
	Если ЗначениеЗаполнено(Версия.Метка) Тогда
		Заголовки.Вставить("CHANNEL", Версия.Метка);
	КонецЕсли;

	Требовать(Клиент.ЗапросБайтами("POST",
		СтрШаблон("/api/v1/pools/%1/push", URLЧасть(Пакет.Пул)),
		Новый ДвоичныеДанные(Путь), Заголовки),
		201, СтрШаблон("публикация %1/%2 %3", Пакет.Пул, Пакет.Имя, Версия.Версия));

КонецПроцедуры

// Короткий легаси-адрес /push ведёт в дефолтный пул, а он на стенде только читает.
// Отказ проверяется тем же способом, каким публикует opm: сюжет обещает 409, и обещание
// не должно расходиться с хабом молча.
Процедура ПроверитьЗапретКороткойПубликации()

	Пакет = Сценарий.Пакеты()[0];
	Версия = Пакет.Версии[0];
	ИмяФайла = Сценарий.ИмяФайла(Пакет.Имя, Версия.Версия);

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", ИмяФайла);
	Заголовки.Вставить("Authorization", "Bearer " + Ключ(Пакет.Публикатор));

	Требовать(Клиент.ЗапросБайтами("POST", "/push",
		Новый ДвоичныеДанные(ОбъединитьПути(КаталогСборки, ИмяФайла)), Заголовки),
		409, "публикация коротким адресом /push в дефолтный пул");

КонецПроцедуры

Процедура ОтозватьВерсии()

	Для Каждого Отзыв Из Сценарий.ОтозванныеВерсии() Цикл

		Поля = Новый Структура();
		Поля.Вставить("yanked", "true");

		Требовать(Клиент.Запрос("PATCH",
			СтрШаблон("/api/v1/pools/%1/packages/%2/versions/%3",
				URLЧасть(Отзыв.Пул), URLЧасть(Отзыв.Пакет), URLЧасть(Отзыв.Версия)),
			ТелоJSON(Поля), ЗаголовкиJSON(Ключ(Отзыв.Кем))),
			200, СтрШаблон("отзыв версии %1 пакета %2", Отзыв.Версия, Отзыв.Пакет));

	КонецЦикла;

КонецПроцедуры

// Демо-теги поверх каналов по умолчанию: своё правило stable и ручной lts.
Процедура ПоставитьТеги()

	Для Каждого Тег Из Сценарий.Теги() Цикл

		Поля = Новый Структура();
		Поля.Вставить("mode", Тег.Режим);
		Если Тег.Режим = "правило" Тогда
			Поля.Вставить("ruleType", Тег.ТипПравила);
			Поля.Вставить("rule", Тег.Правило);
		Иначе
			Поля.Вставить("version", Тег.Версия);
		КонецЕсли;

		Требовать(Клиент.Запрос("PUT",
			СтрШаблон("/api/v1/pools/%1/packages/%2/tags/%3",
				URLЧасть(Тег.Пул), URLЧасть(Тег.Пакет), URLЧасть(Тег.Тег)),
			ТелоJSON(Поля), ЗаголовкиJSON(Ключ(Тег.Кем))),
			200, СтрШаблон("тег %1 пакета %2", Тег.Тег, Тег.Пакет));

	КонецЦикла;

КонецПроцедуры

// Каналы stable/prerelease/develop заводит визард раздела «Теги»: сам хаб их не выдумывает,
// и стенд получает их тем же путём, что живой мейнтейнер. Форма сессионная и требует
// CSRF-токен, который берётся из отрисованной страницы.
Процедура ЗавестиКаналыПоУмолчанию()

	Для Каждого Пакет Из Сценарий.Пакеты() Цикл

		Логин = Пакет.Публикатор;
		Адрес = СтрШаблон("/%1/%2/settings/tags", URLЧасть(Пакет.Пул), URLЧасть(Пакет.Имя));

		Раздел = Требовать(Клиент.Запрос("GET", Адрес, "", ЗаголовкиФормы(Кука(Логин))),
			200, "раздел каналов " + Пакет.Имя);

		Токен = ИзвлечьCSRF(Раздел.Тело);
		Если НЕ ЗначениеЗаполнено(Токен) Тогда
			ВызватьИсключение "В разделе каналов " + Пакет.Имя + " нет поля _csrf";
		КонецЕсли;

		Поля = Новый Массив();
		Поля.Добавить(ПолеФормы("_csrf", Токен));
		Поля.Добавить(ПолеФормы("операция", "каналы_по_умолчанию"));

		Ответ = Клиент.Запрос("POST", Адрес, СтрСоединить(Поля, "&"), ЗаголовкиФормы(Кука(Логин)));
		// заведено — перенаправление по образцу POST/Redirect/GET; «всё уже есть» — 200
		Если Ответ.Код <> 302 И Ответ.Код <> 303 И Ответ.Код <> 200 Тогда
			Требовать(Ответ, 302, "каналы по умолчанию пакета " + Пакет.Имя);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область КарточкиПакетов

// Лицензии и ключевых слов в формате .ospx нет — их заполняет форма карточки пакета.
// Форма сессионная и требует CSRF-токен, который берётся из отрисованной страницы.
Процедура ЗаполнитьКарточки()

	Для Каждого Пакет Из Сценарий.Пакеты() Цикл

		Логин = Пакет.Публикатор;
		Адрес = СтрШаблон("/%1/%2/settings/card", URLЧасть(Пакет.Пул), URLЧасть(Пакет.Имя));

		Форма = Требовать(Клиент.Запрос("GET", Адрес, "", ЗаголовкиФормы(Кука(Логин))),
			200, "форма карточки " + Пакет.Имя);

		Токен = ИзвлечьCSRF(Форма.Тело);
		Если НЕ ЗначениеЗаполнено(Токен) Тогда
			ВызватьИсключение "В форме карточки " + Пакет.Имя + " нет поля _csrf";
		КонецЕсли;

		Поля = Новый Массив();
		Поля.Добавить(ПолеФормы("_csrf", Токен));
		Поля.Добавить(ПолеФормы("описание", Пакет.Описание));
		Поля.Добавить(ПолеФормы("ключевые_слова", Пакет.КлючевыеСлова));
		Поля.Добавить(ПолеФормы("лицензия", Пакет.Лицензия));
		Поля.Добавить(ПолеФормы("репозиторий", Пакет.Репозиторий));
		Если Пакет.Устарел Тогда
			Поля.Добавить(ПолеФормы("устарел", "1"));
		КонецЕсли;

		Ответ = Клиент.Запрос("POST", Адрес, СтрСоединить(Поля, "&"), ЗаголовкиФормы(Кука(Логин)));
		// форма отвечает редиректом по образцу POST/Redirect/GET
		Если Ответ.Код <> 302 И Ответ.Код <> 303 И Ответ.Код <> 200 Тогда
			Требовать(Ответ, 302, "сохранение карточки " + Пакет.Имя);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ЗаголовкиФормы(Знач КукаСессии)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Accept", "text/html");
	Заголовки.Вставить("Cookie", "oshub_session=" + КукаСессии);
	Возврат Заголовки;
КонецФункции

Функция ПолеФормы(Знач Имя, Знач Значение)
	Возврат URLЧасть(Имя) + "=" + URLЧасть(Значение);
КонецФункции

Функция ИзвлечьCSRF(Знач ТекстСтраницы)

	Маркер = "name=""_csrf"" value=""";
	Поз = СтрНайти(ТекстСтраницы, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(ТекстСтраницы, Поз + СтрДлина(Маркер));
	Конец = СтрНайти(Остаток, """");
	Возврат ?(Конец = 0, "", Лев(Остаток, Конец - 1));

КонецФункции

#КонецОбласти

#Область Скачивания

// Статистика набирается настоящими скачиваниями: строк агрегатов стенд не пишет.
// Заголовков валидации кэша не шлём — на 304 и HEAD скачивание не засчитывается.
Процедура НабратьСкачивания()

	Для Каждого Пакет Из Сценарий.Пакеты() Цикл

		// приватный пул анониму невидим — его артефакты качаем ключом мейнтейнера
		Заголовки = Новый Соответствие();
		Если Пакет.Пул = "team" Тогда
			Заголовки.Вставить("Authorization", "Bearer " + Ключ(Пакет.Публикатор));
		КонецЕсли;

		Для Каждого Версия Из Пакет.Версии Цикл

			Путь = СтрШаблон("/api/v1/pools/%1/download/%2/%3",
				URLЧасть(Пакет.Пул), URLЧасть(Пакет.Имя),
				URLЧасть(Сценарий.ИмяФайла(Пакет.Имя, Версия.Версия)));

			Для Номер = 1 По Версия.Скачиваний Цикл
				Итог = Клиент.Скачать(Путь, Заголовки);
				Если Итог.Код <> 200 ИЛИ Итог.Размер = 0 Тогда
					ВызватьИсключение СтрШаблон(
						"Скачивание %1 вернуло %2 и %3 байт: без реальной отдачи тела"
						+ " хаб скачивание не засчитывает",
						Путь, Формат(Итог.Код, "ЧГ=0; ЧН=0"), Формат(Итог.Размер, "ЧГ=0; ЧН=0"));
				КонецЕсли;
				ВсегоСкачиваний = ВсегоСкачиваний + 1;
			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Счётчик копится в памяти и уходит в базу порогом либо фоновой задачей. Стенд
// перезапускают сразу после наполнения, поэтому сброса надо дождаться, иначе
// вся статистика умрёт вместе с процессом.
Процедура ДождатьсяСбросаСтатистики()

	Ожидание = ЧислоИзОкружения("OSHUB_DEMO_STATS_WAIT_SEC",
		ЧислоИзОкружения("OSHUB_JOBS_STATS__FLUSH__INTERVAL__SEC", 60) + 5);

	Сообщить(СтрШаблон("демо: жду сброса статистики скачиваний в базу — %1 с",
		Формат(Ожидание, "ЧГ=0; ЧН=0")));
	Приостановить(Ожидание * 1000);

КонецПроцедуры

#КонецОбласти

#Область Зеркало

// Зеркало дефолтного пула глазами пользователя: короткий адрес отдаёт то, чего в этот
// хаб никто не публиковал. Шаг некритичный — без сети либо при неработающем походе
// в апстрим стенд собирается целиком, а несделанное уходит в предупреждения и памятку.
Процедура ПроверитьЗеркало()

	ОтветСписка = Клиент.Запрос("GET", "/download/list.txt");
	ЗеркалоЧужихИмён = ?(ОтветСписка.Код = 200, ЧужихИмён(ОтветСписка.Тело), 0);

	Если ЗеркалоЧужихИмён = 0 Тогда
		Предупредить(СтрШаблон(
			"короткий адрес /download/list.txt не показал ни одного имени из апстрима %1"
			+ " (код %2): либо у машины нет сети, либо пул с апстримом наружу не ходит.",
			Сценарий.АдресАпстрима(), Формат(ОтветСписка.Код, "ЧГ=0; ЧН=0")));
	КонецЕсли;

	Пробник = Сценарий.ПробникЗеркала();
	Путь = СтрШаблон("/download/%1/%2", URLЧасть(Пробник.Имя),
		URLЧасть(Сценарий.ИмяФайла(Пробник.Имя, Пробник.Версия)));

	Итог = Клиент.Скачать(Путь);
	ЗеркалоКод = Итог.Код;
	ЗеркалоБайт = Итог.Размер;

	Если ЗеркалоКод <> 200 ИЛИ ЗеркалоБайт = 0 Тогда
		Предупредить(СтрШаблон(
			"зеркало не отдало %1 через короткий адрес %2 (код %3, %4 байт):"
			+ " кэш дефолтного пула останется пустым.",
			Сценарий.ИмяФайла(Пробник.Имя, Пробник.Версия), Путь,
			Формат(ЗеркалоКод, "ЧГ=0; ЧН=0"), Формат(ЗеркалоБайт, "ЧГ=0; ЧН=0")));
	КонецЕсли;

КонецПроцедуры

// Сколько имён в списке пула пришло не из собственных публикаций стенда.
Функция ЧужихИмён(Знач ТелоСписка)

	Свои = Новый Соответствие();
	Для Каждого Пакет Из Сценарий.Пакеты() Цикл
		Свои.Вставить(НРег(Пакет.Имя), Истина);
	КонецЦикла;

	Результат = 0;
	Для Каждого Строчка Из СтрРазделить(СтрЗаменить(ТелоСписка, Символы.ВК, ""), Символы.ПС, Ложь) Цикл
		Имя = НРег(СокрЛП(Строчка));
		Если ЗначениеЗаполнено(Имя) И Свои.Получить(Имя) = Неопределено Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Памятка

Процедура ЗаписатьПамятку()

	Адрес = Клиент.Адрес();
	ТокенAlice = Ключ("alice");

	Текст = Новый Массив();
	Текст.Добавить("# Демо-стенд OpenHub");
	Текст.Добавить("");
	Текст.Добавить("Каталог создан скриптом `tools/demo.os` (данные — `data/`, собранные пакеты — `build/`).");
	Текст.Добавить("Каталог целиком под gitignore: его можно удалять и пересоздавать в любой момент.");
	Текст.Добавить("");
	Текст.Добавить("Стенд наполнен **только пользовательскими механиками**: хаб поднимается пустым,");
	Текст.Добавить("а дальше `tools/демо/ЗаполнитьЧерезAPI.os` ходит по тому же HTTP API и тем же формам,");
	Текст.Добавить("что доступны человеку. В базу напрямую не пишет никто.");
	Текст.Добавить("");
	Текст.Добавить("Адрес хаба: " + Адрес);
	Текст.Добавить("");
	Текст.Добавить("Сюжет стенда — **корпоративный хаб**. Короткие легаси-адреса (`/download`,");
	Текст.Добавить("`/dev-channel`, `/push`) ведут в дефолтный пул `" + Сценарий.ДефолтныйПул() + "`,");
	Текст.Добавить("а он — читающее зеркало публичного `" + Сценарий.АдресАпстрима() + "`:");
	Текст.Добавить("отдаёт пакеты экосистемы и не принимает публикации. Собственные пакеты");
	Текст.Добавить("организации живут в соседнем пуле `" + Сценарий.ПулОрганизации() + "`.");
	Текст.Добавить("");
	Текст.Добавить("## Учётные записи");
	Текст.Добавить("");
	Текст.Добавить("| Логин | Пароль | Роль | Что показывает |");
	Текст.Добавить("| --- | --- | --- | --- |");
	Текст.Добавить("| root | " + ИзОкружения("OSHUB_DEMO_ROOT_PASSWORD", "RootPassw0rd")
		+ " | администратор хаба | дом настроек хаба, все объекты |");
	Для Каждого Человек Из Сценарий.Люди() Цикл
		Текст.Добавить(СтрШаблон("| %1 | %2 | %3 | %4 |", Человек.Логин, Сценарий.Пароль(),
			"пользователь", Человек.Роль));
	КонецЦикла;
	Текст.Добавить("");
	Текст.Добавить("## Права");
	Текст.Добавить("");
	Текст.Добавить("Роли раздаются грантами — тем же экраном прав доступа, что и в жизни:");
	Текст.Добавить("");
	Для Каждого Грант Из Сценарий.ГрантыПулов() Цикл
		Текст.Добавить(СтрШаблон("- пул `%1`: %2 `%3` — роль `%4`;",
			Грант.Пул, Грант.ТипСубъекта, Грант.Субъект, Грант.Роль));
	КонецЦикла;
	Для Каждого Грант Из Сценарий.ГрантыПакетов() Цикл
		Текст.Добавить(СтрШаблон("- пакет `%1/%2`: %3 `%4` — роль `%5` (права без участия в пуле);",
			Грант.Пул, Грант.Пакет, Грант.ТипСубъекта, Грант.Субъект, Грант.Роль));
	КонецЦикла;
	Текст.Добавить("## Токен доступа (PAT) пользователя alice");
	Текст.Добавить("");
	Текст.Добавить("```");
	Текст.Добавить(ТокенAlice);
	Текст.Добавить("```");
	Текст.Добавить("");
	Текст.Добавить("```bash");
	Текст.Добавить("curl -H ""Authorization: Bearer " + ТокенAlice + """ " + Адрес + "/api/v1/pools");
	Текст.Добавить("```");
	Текст.Добавить("");
	Текст.Добавить("## Что посмотреть");
	Текст.Добавить("");
	Зеркало = Адрес + "/" + Сценарий.ДефолтныйПул();
	Свой = Адрес + "/" + Сценарий.ПулОрганизации();

	Текст.Добавить("- `" + Адрес + "/` — лендинг со сводкой хаба;");
	Текст.Добавить("- `" + Адрес + "/packages` — каталог с поиском и пагинацией;");
	Текст.Добавить("- `" + Свой + "/veles-core` — карточка пакета: README, версии, зависимости, теги;");
	Текст.Добавить("- `" + Свой + "` — пакеты организации: публичный пул, публикация разрешена;");
	Текст.Добавить("- `" + Зеркало + "` — дефолтный пул: зеркало апстрима, публикация выключена;");
	Текст.Добавить("- `" + Адрес + "/contrib` — пул сообщества;");
	Текст.Добавить("- `" + Адрес + "/team` — приватный пул с квотой: аноним его не видит, bob и carol видят;");
	Текст.Добавить("");
	Текст.Добавить("Пять домов настроек:");
	Текст.Добавить("");
	Текст.Добавить("- `" + Адрес + "/me/settings` — личные настройки (аккаунт, токены, ключи);");
	Текст.Добавить("- `" + Адрес + "/groups/platform/settings` — дом группы;");
	Текст.Добавить("- `" + Зеркало + "/settings` — дом пула: там же список апстримов зеркала;");
	Текст.Добавить("- `" + Свой + "/veles-core/settings` — дом пакета;");
	Текст.Добавить("- `" + Адрес + "/hub/settings` — дом хаба (только root).");
	Текст.Добавить("");
	Текст.Добавить("## Чего на стенде нет и почему");
	Текст.Добавить("");
	Текст.Добавить("- **всё датировано днём запуска.** Задать прошедшую дату публикации или скачивания");
	Текст.Добавить("  через API нельзя, а подделывать даты записью в базу стенд не станет: версии");
	Текст.Добавить("  опубликованы сегодня, суточные агрегаты скачиваний — все за одни сутки,");
	Текст.Добавить("  сегодняшние, так что истории «по дням» на стенде не увидеть;");
	Текст.Добавить("- **статистика скачиваний настоящая**: столько запросов");
	Текст.Добавить("  `GET /api/v1/pools/{пул}/download/…` стенд и сделал — "
		+ Формат(ВсегоСкачиваний, "ЧГ=0; ЧН=0") + ".");
	Текст.Добавить("  Счётчик копится в памяти и уходит в базу фоновой задачей, поэтому стенд ждёт");
	Текст.Добавить("  сброса перед перезапуском хаба. Витрина показывает одно суммарное число");
	Текст.Добавить("  на пакет: разбивки по версиям и по дням в интерфейсе нет;");
	ДобавитьСостояниеЗеркала(Текст);
	Текст.Добавить("- **у `dave` нет требования сменить пароль**: HTTP-входа для этого признака нет.");
	Текст.Добавить("");
	ДобавитьУстановкуИПубликацию(Текст);

	Если Предупреждения.Количество() > 0 Тогда
		Текст.Добавить("");
		Текст.Добавить("## Предупреждения этого прогона");
		Текст.Добавить("");
		Для Каждого Строчка Из Предупреждения Цикл
			Текст.Добавить("- " + Строчка + ";");
		КонецЦикла;
	КонецЕсли;

	ЗаписатьТекстВФайл(ОбъединитьПути(КореньДемо, "ДЕМО.md"), СтрСоединить(Текст, Символы.ПС));

КонецПроцедуры

// Кэш зеркала описывается тем, что вышло у пробника: пустой кэш и наполненный —
// разные обещания, и памятка не должна выдавать одно за другое.
Процедура ДобавитьСостояниеЗеркала(Текст)

	Пробник = Сценарий.ПробникЗеркала();
	ИмяАртефакта = Сценарий.ИмяФайла(Пробник.Имя, Пробник.Версия);

	Если ЗеркалоКод = 200 И ЗеркалоБайт > 0 Тогда
		Текст.Добавить(СтрШаблон("- **кэш дефолтного пула `%1` наполняется по запросу**: стенд"
			+ " попросил", Сценарий.ДефолтныйПул()));
		Текст.Добавить(СтрШаблон("  `%1` коротким адресом, зеркало сходило в апстрим и положило"
			+ " версию в кэш", ИмяАртефакта));
		Текст.Добавить(СтрШаблон("  (%1 байт). Имён апстрима в `/download/list.txt` видно %2 —"
			+ " каждое приедет в пул",
			Формат(ЗеркалоБайт, "ЧГ=0; ЧН=0"), Формат(ЗеркалоЧужихИмён, "ЧГ=0; ЧН=0")));
		Текст.Добавить("  по первому же запросу;");
		Текст.Добавить(СтрШаблон("- **у проксированных пакетов пустая карточка**: у `%1` в пуле"
			+ " `%2` нет ни описания,", Пробник.Имя, Сценарий.ДефолтныйПул()));
		Текст.Добавить("  ни ключевых слов, а вкладка зависимостей пишет «ни от чего не зависит»."
			+ " Это не поломка:");
		Текст.Добавить("  манифест апстрима в карточку нашего пула не переносится — иначе апстрим"
			+ " писал бы");
		Текст.Добавить("  текст в наш пул. Карточку заполняет только публикация в этот хаб;");
	Иначе
		Текст.Добавить(СтрШаблон("- **кэш дефолтного пула `%1` пуст**: зеркало не отдало `%2`"
			+ " (код %3).", Сценарий.ДефолтныйПул(), ИмяАртефакта,
			Формат(ЗеркалоКод, "ЧГ=0; ЧН=0")));
		Текст.Добавить("  Индексировать чужую версию «как проксированную» через API нельзя,"
			+ " а публиковать в пул");
		Текст.Добавить("  с выключенной публикацией запрещено — пул стоит с настроенным источником"
			+ " и пустым кэшем;");
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьУстановкуИПубликацию(Текст)

	Зеркало = Сценарий.ДефолтныйПул();
	Свой = Сценарий.ПулОрганизации();
	ИмяСервераЗеркала = "openhub-" + Зеркало;
	ИмяСервераСвоего = "openhub-" + Свой;

	Текст.Добавить("## Установка и публикация");
	Текст.Добавить("");
	Текст.Добавить(СтрШаблон("Адресов два. Короткий (`ПутьНаСервере: /download/`) ведёт в"
		+ " дефолтный пул `%1` —", Зеркало));
	Текст.Добавить(СтрШаблон("зеркало `%1`:", Сценарий.АдресАпстрима()));
	Текст.Добавить("им ставятся публичные пакеты экосистемы. Публикацию он не принимает,");
	Текст.Добавить("`POST /push` отвечает **409** — стенд проверяет это сам при каждой сборке.");
	Текст.Добавить(СтрШаблон("Пакеты организации и ставятся, и публикуются адресом пула `%1`.", Свой));
	Текст.Добавить("");
	Текст.Добавить("`opm.cfg` с обоими серверами (порт продублирован в `Сервер`: `opm push`");
	Текст.Добавить("поле `Порт` не читает и без порта в адресе стучится на 80):");
	Текст.Добавить("");
	Текст.Добавить("```json");
	Текст.Добавить("{");
	Текст.Добавить("    ""СервераПакетов"": [");
	Текст.Добавить(СтрокаOpmCfg(ИмяСервераЗеркала, "/download/", "/push", "", 0) + ",");
	Текст.Добавить(СтрокаOpmCfg(ИмяСервераСвоего,
		СтрШаблон("/api/v1/pools/%1/download/", Свой),
		СтрШаблон("/api/v1/pools/%1/push", Свой), "Bearer " + Ключ("alice"), 1));
	Текст.Добавить("    ]");
	Текст.Добавить("}");
	Текст.Добавить("```");
	Текст.Добавить("");
	Текст.Добавить("```bash");
	Текст.Добавить("# публичный пакет из зеркала");
	Текст.Добавить(СтрШаблон("opm install -l -m %1 %2", ИмяСервераЗеркала,
		Сценарий.ПробникЗеркала().Имя));
	Текст.Добавить("# свой пакет из пула организации");
	Текст.Добавить(СтрШаблон("opm install -l -m %1 veles-core", ИмяСервераСвоего));
	Текст.Добавить("# публикация: короткий /push отвечал бы 409");
	Текст.Добавить(СтрШаблон("opm push -m %1 -f veles-core-1.2.0.ospx", ИмяСервераСвоего));
	Текст.Добавить("```");

КонецПроцедуры

// Один сервер пакетов в opm.cfg — блок с отступом внутрь массива СервераПакетов.
// Порт стоит и в «Сервер», и в «Порт»: opm push поле «Порт» не читает и без порта
// в адресе стучится на 80.
Функция СтрокаOpmCfg(Знач Имя, Знач ПутьНаСервере, Знач РесурсПубликации, Знач Авторизация,
	Знач Приоритет)

	Строчки = Новый Массив();
	Строчки.Добавить("        {");
	Строчки.Добавить(СтрШаблон("            ""Имя"": ""%1"",", Имя));
	Строчки.Добавить(СтрШаблон("            ""Сервер"": ""%1"",", Клиент.Адрес()));
	Строчки.Добавить(СтрШаблон("            ""Порт"": %1,", Формат(Клиент.Порт(), "ЧГ=0; ЧН=0")));
	Строчки.Добавить(СтрШаблон("            ""ПутьНаСервере"": ""%1"",", ПутьНаСервере));
	Строчки.Добавить(СтрШаблон("            ""РесурсПубликацииПакетов"": ""%1"",", РесурсПубликации));
	Если ЗначениеЗаполнено(Авторизация) Тогда
		Строчки.Добавить(СтрШаблон("            ""Авторизация"": ""%1"",", Авторизация));
	КонецЕсли;
	Строчки.Добавить(СтрШаблон("            ""Приоритет"": %1", Формат(Приоритет, "ЧГ=0; ЧН=0")));
	Строчки.Добавить("        }");

	Возврат СтрСоединить(Строчки, Символы.ПС);

КонецФункции

#КонецОбласти

Процедура Заполнить()

	КаталогСценария = Новый Файл(ТекущийСценарий().Источник).Путь;
	ПодключитьСценарий(ОбъединитьПути(КаталогСценария, "СценарийСтенда.os"), "СценарийСтенда");
	ПодключитьСценарий(ОбъединитьПути(КаталогСценария, "КлиентХаба.os"), "КлиентХаба");

	Ключи = Новый Соответствие();
	Куки = Новый Соответствие();
	Предупреждения = Новый Массив();
	ВсегоВерсий = 0;
	ВсегоСкачиваний = 0;
	ЗеркалоЧужихИмён = 0;
	ЗеркалоКод = 0;
	ЗеркалоБайт = 0;

	Сценарий = Новый СценарийСтенда(ИзОкружения("OSHUB_DEMO_PASSWORD", "DemoPassw0rd"));
	Клиент = Новый КлиентХаба(ИзОкружения("OSHUB_DEMO_HOST", "localhost"),
		ЧислоИзОкружения("OSHUB_PORT", 3380));

	КореньДемо = Новый Файл(ИзОкружения("OSHUB_DEMO_ROOT",
		ОбъединитьПути(КаталогСценария, "..", "..", "demo"))).ПолноеИмя;
	КаталогСборки = ОбъединитьПути(КореньДемо, "build");

	ПроверитьГотовность();

	СоздатьАдмина();
	ВыпуститьКлюч(Сценарий.ЛогинАдмина());

	СоздатьЛюдей();
	Для Каждого Логин Из СтрРазделить("alice,bob", ",") Цикл
		Войти(Логин, Сценарий.Пароль());
		ВыпуститьКлюч(Логин);
	КонецЦикла;

	СоздатьГруппы();

	СоздатьПулы();
	ВыдатьГрантыПулов();

	ОпубликоватьПакеты();
	ПроверитьЗапретКороткойПубликации();
	ОтозватьВерсии();
	ЗавестиКаналыПоУмолчанию();
	ПоставитьТеги();
	ВыдатьГрантыПакетов();
	ЗаполнитьКарточки();

	НабратьСкачивания();
	ПроверитьЗеркало();
	ДождатьсяСбросаСтатистики();

	ЗаписатьПамятку();

	Сообщить("демо: адрес " + Клиент.Адрес());
	Сообщить(СтрШаблон("демо: пользователей %1, групп %2, пулов %3, пакетов %4, версий %5, скачиваний %6",
		Формат(Сценарий.Люди().Количество() + 1, "ЧГ=0; ЧН=0"),
		Формат(Сценарий.Группы().Количество(), "ЧГ=0; ЧН=0"),
		Формат(Сценарий.Пулы().Количество(), "ЧГ=0; ЧН=0"),
		Формат(Сценарий.Пакеты().Количество(), "ЧГ=0; ЧН=0"),
		Формат(ВсегоВерсий, "ЧГ=0; ЧН=0"),
		Формат(ВсегоСкачиваний, "ЧГ=0; ЧН=0")));
	Сообщить(СтрШаблон("демо: зеркало %1 в пуле %2 — /download/list.txt отдал %3 чужих имён,"
		+ " пробное скачивание %4 (%5 байт)",
		Сценарий.АдресАпстрима(), Сценарий.ДефолтныйПул(),
		Формат(ЗеркалоЧужихИмён, "ЧГ=0; ЧН=0"),
		Формат(ЗеркалоКод, "ЧГ=0; ЧН=0"), Формат(ЗеркалоБайт, "ЧГ=0; ЧН=0")));
	Сообщить("демо: PAT alice — " + Ключ("alice"));
	Сообщить("демо: памятка — " + ОбъединитьПути(КореньДемо, "ДЕМО.md"));
	Сообщить("DEMO-OK");

КонецПроцедуры

Заполнить();
