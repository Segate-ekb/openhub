// Сюжет демо-стенда данными: люди, группы, пулы, гранты, пакеты с версиями и планом
// скачиваний. Общий источник для сборщика .ospx и наполнителя по HTTP.

Перем ПарольДемо;

#Область ПубличныйИнтерфейс

// Пароль обычных учётных записей стенда.
//
// Возвращаемое значение:
//  Строка - пароль.
//
Функция Пароль() Экспорт
	Возврат ПарольДемо;
КонецФункции

// Логин администратора стенда.
//
// Возвращаемое значение:
//  Строка - логин.
//
Функция ЛогинАдмина() Экспорт
	Возврат "root";
КонецФункции

// Обычные пользователи стенда (администратор создаётся мастером /setup отдельно): главные
// герои сюжета и массовка, на которой экран «Люди» листается страницами и отбирается.
//
// Возвращаемое значение:
//  Массив из Структура - Логин, Email, ВСюжете (кто это), РольХаба ("user" | "admin"),
//                        Вход ("пароль" — регистрировался сам; "приглашение" — заведён
//                        администратором и пароля ещё не задал), Заблокирован (Булево),
//                        Массовка (Булево — не герой сюжета).
//
Функция Люди() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Человек("alice", "Разработчик ядра: владеет пулом " + ПулОрганизации()));
	Результат.Добавить(Человек("bob",
		СтрШаблон("Публикатор: пишет в %1, ведёт приватный team", ПулОрганизации())));
	Результат.Добавить(Человек("carol",
		"Тестировщик: читает team, правит один пакет по гранту; учётка заблокирована",
		"user", "пароль", Истина));
	Результат.Добавить(Человек("dave",
		"Приглашён администратором и пароля ещё не задал — войти нечем", "user", "приглашение"));
	Результат.Добавить(Человек("erik", "Второй администратор хаба", "admin"));

	Заявители = Новый Соответствие();
	Для Каждого Заявка Из Заявки() Цикл
		Заявители.Вставить(Заявка.Публикатор, Заявка.Пул);
	КонецЦикла;

	Заблокированные = МассовкаЗаблокированных();
	Приглашённые = МассовкаПриглашённых();

	Для Каждого Логин Из Массовка() Цикл
		ПулЗаявки = Заявители.Получить(Логин);
		Учётка = Человек(Логин,
			?(ПулЗаявки = Неопределено, "", "Просит место для своего пакета в пуле " + ПулЗаявки),
			"user", ?(Приглашённые.Найти(Логин) = Неопределено, "пароль", "приглашение"),
			Заблокированные.Найти(Логин) <> Неопределено);
		Учётка.Массовка = (ПулЗаявки = Неопределено);
		Результат.Добавить(Учётка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Группы стенда с составом.
//
// Возвращаемое значение:
//  Массив из Структура - Имя, Описание, Участники (Массив из Строка).
//
Функция Группы() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Группа("platform", "Платформенная команда", Список("alice", "bob")));
	Результат.Добавить(Группа("qa", "Тестирование и релизы", Список("carol")));
	Результат.Добавить(Группа("release", "Выпуск и сопровождение",
		Список("alice", "bob", "erik", "grace")));
	Возврат Результат;

КонецФункции

// Имя пула по умолчанию: короткие легаси-адреса /download, /dev-channel и /push ведут
// в него. На стенде это читающее зеркало публичного хаба.
//
// Возвращаемое значение:
//  Строка - имя пула.
//
Функция ДефолтныйПул() Экспорт
	Возврат "public";
КонецФункции

// Имя пула, в котором лежат собственные пакеты организации.
//
// Возвращаемое значение:
//  Строка - имя пула.
//
Функция ПулОрганизации() Экспорт
	Возврат "corp";
КонецФункции

// Адрес апстрима, которым зеркалится пул по умолчанию. Базовый URL апстрима — каталог
// выдачи, а не главная страница хаба: клиент дописывает к нему «{пакет}/{файл}».
//
// Возвращаемое значение:
//  Строка - базовый URL каталога выдачи публичного хаба.
//
Функция АдресАпстрима() Экспорт
	Возврат "https://hub.oscript.io/download/";
КонецФункции

// Пакет апстрима, которым стенд проверяет работу зеркала.
//
// Возвращаемое значение:
//  Структура - Имя, Версия.
//
Функция ПробникЗеркала() Экспорт
	Возврат Новый Структура("Имя, Версия", "asserts", "1.6.2");
КонецФункции

// Пулы стенда в порядке создания; первый — пул по умолчанию.
//
// Возвращаемое значение:
//  Массив из Структура - Имя, Тип, Видимость, КвотаМб, ПубликацияРазрешена, Апстрим.
//
Функция Пулы() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Пул(ДефолтныйПул(), "public", 0, Ложь, АдресАпстрима()));
	Результат.Добавить(Пул(ПулОрганизации(), "public", 1024, Истина, ""));
	Результат.Добавить(Пул("contrib", "public", 0, Истина, ""));
	Результат.Добавить(Пул("team", "private", 512, Истина, ""));
	Возврат Результат;

КонецФункции

// Роли субъектов на пулах: то же, что выдаёт экран прав доступа пула.
//
// Возвращаемое значение:
//  Массив из Структура - Пул, ТипСубъекта, Субъект, Роль.
//
Функция ГрантыПулов() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Грант(ДефолтныйПул(), "группа", "platform", "мейнтейнер"));
	Результат.Добавить(Грант(ПулОрганизации(), "пользователь", "alice", "мейнтейнер"));
	Результат.Добавить(Грант(ПулОрганизации(), "пользователь", "bob", "райтер"));
	Результат.Добавить(Грант(ПулОрганизации(), "группа", "platform", "райтер"));
	Результат.Добавить(Грант("contrib", "группа", "platform", "мейнтейнер"));
	Результат.Добавить(Грант("team", "пользователь", "bob", "мейнтейнер"));
	Результат.Добавить(Грант("team", "пользователь", "carol", "читатель"));
	Результат.Добавить(Грант("team", "группа", "qa", "читатель"));
	Возврат Результат;

КонецФункции

// Гранулярные роли на отдельных пакетах: право без участия в пуле.
//
// Возвращаемое значение:
//  Массив из Структура - Пул, Пакет, ТипСубъекта, Субъект, Роль, Выдаёт (логин).
//
Функция ГрантыПакетов() Экспорт

	Результат = Новый Массив();

	Запись = Новый Структура();
	Запись.Вставить("Пул", ПулОрганизации());
	Запись.Вставить("Пакет", "veles-core");
	Запись.Вставить("ТипСубъекта", "пользователь");
	Запись.Вставить("Субъект", "carol");
	Запись.Вставить("Роль", "райтер");
	Запись.Вставить("Выдаёт", "alice");
	Результат.Добавить(Запись);

	Возврат Результат;

КонецФункции

// Пакеты стенда со всеми версиями в порядке публикации.
//
// Возвращаемое значение:
//  Массив из Структура - описание пакета (см. ОписаниеПакета).
//
Функция Пакеты() Экспорт

	Результат = Новый Массив();

	Ядро = ОписаниеПакета(ПулОрганизации(), "veles-core", "alice",
		"Ядро фреймворка Велес: контейнер зависимостей, конфигурация и логирование",
		"di, контейнер, конфигурация, логирование", "Команда Велес", "ВелесЯдро", "Собрать",
		Список(
			"внедрение зависимостей без кодогенерации",
			"иерархическая конфигурация с переопределением из окружения",
			"структурное логирование с контекстом запроса"));
	ЗависимостиЯдра = Список(
		Зависимость("json", "1.1.2"),
		Зависимость("tokenizer", "1.4.0"),
		Зависимость("asserts", "1.6.2", "", Истина));
	ДобавитьВерсию(Ядро, "0.9.0", ЗависимостиЯдра, 3);
	ДобавитьВерсию(Ядро, "1.0.0", ЗависимостиЯдра, 6);
	ДобавитьВерсию(Ядро, "1.1.0", ЗависимостиЯдра, 11);
	ДобавитьВерсию(Ядро, "1.2.0", ЗависимостиЯдра, 24);
	ДобавитьВерсию(Ядро, "1.3.0-rc.1", ЗависимостиЯдра, 2, "dev");
	Результат.Добавить(Ядро);

	Веб = ОписаниеПакета(ПулОрганизации(), "veles-http", "alice",
		"HTTP-слой Велеса: маршрутизация, middleware и сериализация ответов",
		"http, роутинг, middleware, rest", "Команда Велес", "ВелесМаршрутизатор", "Обработать",
		Список(
			"маршруты с параметрами пути и типизированной привязкой",
			"конвейер middleware: аутентификация, CORS, трассировка",
			"согласование форматов ответа JSON/HTML"));
	ЗависимостиВеб = Список(Зависимость("veles-core", "1.1.0"), Зависимость("json", "1.1.2"));
	ДобавитьВерсию(Веб, "1.0.0", ЗависимостиВеб, 4);
	ДобавитьВерсию(Веб, "1.1.0", ЗависимостиВеб, 6);
	ДобавитьВерсию(Веб, "1.2.0", ЗависимостиВеб, 9);
	Результат.Добавить(Веб);

	Утилита = ОписаниеПакета(ПулОрганизации(), "veles-cli", "bob",
		"Консольные команды Велеса: генерация каркаса приложения и релизных заметок",
		"cli, консоль, генератор", "Команда Велес", "ВелесКоманда", "Выполнить",
		Список(
			"генерация каркаса приложения одной командой",
			"сборка релизных заметок по журналу коммитов",
			"автодополнение для bash и zsh"));
	ЗависимостиУтилиты = Список(
		Зависимость("veles-core", "1.2.0"),
		Зависимость("veles-http", "1.1.0"),
		Зависимость("asserts", "1.6.2", "", Истина));
	ДобавитьВерсию(Утилита, "0.5.0", ЗависимостиУтилиты, 2);
	ДобавитьВерсию(Утилита, "0.6.0", ЗависимостиУтилиты, 5);
	Результат.Добавить(Утилита);

	Разметка = ОписаниеПакета(ПулОрганизации(), "md-view", "bob",
		"Просмотрщик Markdown: рендер в HTML с подсветкой кода",
		"markdown, html, рендер, документация", "Борис Публикаторов",
		"ПросмотрщикРазметки", "Отрисовать",
		Список(
			"CommonMark с таблицами и списками задач",
			"подсветка кода без внешних зависимостей",
			"санитизация пользовательского HTML"));
	ЗависимостиРазметки = Список(Зависимость("veles-core", "1.0.0"));
	ДобавитьВерсию(Разметка, "1.0.0", ЗависимостиРазметки, 2);
	ДобавитьВерсию(Разметка, "1.0.1", ЗависимостиРазметки, 4);
	Результат.Добавить(Разметка);

	Задачи = ОписаниеПакета(ПулОрганизации(), "cron-tasks", "alice",
		"Планировщик фоновых задач с расписанием в формате cron",
		"cron, планировщик, фоновые задачи", "Команда Велес", "ПланировщикЗадач", "Запустить",
		Список(
			"расписания в формате cron с точностью до минуты",
			"повторные попытки с экспоненциальной задержкой",
			"журнал выполнения задач"));
	ЗависимостиЗадач = Список(Зависимость("veles-core", "1.1.0"));
	ДобавитьВерсию(Задачи, "0.1.0", ЗависимостиЗадач, 1);
	ДобавитьВерсию(Задачи, "0.2.0", ЗависимостиЗадач, 1);
	ДобавитьВерсию(Задачи, "0.3.0", ЗависимостиЗадач, 3);
	Результат.Добавить(Задачи);

	Таблицы = ОписаниеПакета("contrib", "csv-tools", "bob",
		"Чтение и запись CSV с автоопределением разделителя",
		"csv, таблицы, импорт, экспорт", "Сообщество OpenHub", "ЧитательCSV", "Прочитать",
		Список(
			"автоопределение разделителя и кодировки",
			"потоковое чтение больших файлов",
			"экспорт из таблицы значений"));
	Таблицы.Устарел = Истина;
	ДобавитьВерсию(Таблицы, "1.0.0", Новый Массив(), 1);
	ДобавитьВерсию(Таблицы, "1.1.0", Новый Массив(), 2);
	Результат.Добавить(Таблицы);

	Формы = ОписаниеПакета("contrib", "legacy-forms", "bob",
		"Формы обратной связи для старых конфигураций (нумерация версий legacy)",
		"формы, legacy, совместимость", "Сообщество OpenHub", "КонструкторФорм", "Построить",
		Список(
			"совместимость с нумерацией версий старого хаба",
			"валидация полей формы",
			"экспорт результатов в CSV"));
	ЗависимостиФорм = Список(Зависимость("csv-tools", "1.0.0"));
	ДобавитьВерсию(Формы, "1.1.0.7", ЗависимостиФорм, 1);
	ДобавитьВерсию(Формы, "1.2.0.3", ЗависимостиФорм, 2);
	Результат.Добавить(Формы);

	Выкладка = ОписаниеПакета("team", "team-deploy", "bob",
		"Внутренние сценарии выкладки: сборка, прогон тестов, публикация релиза",
		"deploy, ci, внутренний", "Внутренняя команда", "СценарийВыкладки", "Выполнить",
		Список(
			"выкладка в несколько окружений одной командой",
			"откат к предыдущему релизу",
			"уведомления о результате в чат"));
	ЗависимостиВыкладки = Список(Зависимость("veles-core", "1.2.0"));
	ДобавитьВерсию(Выкладка, "2.0.0", ЗависимостиВыкладки, 1);
	ДобавитьВерсию(Выкладка, "2.1.0", ЗависимостиВыкладки, 2);
	Результат.Добавить(Выкладка);

	Секреты = ОписаниеПакета("team", "team-secrets", "bob",
		"Доступ к хранилищу секретов команды",
		"секреты, безопасность, внутренний", "Внутренняя команда", "ХранилищеСекретов", "Получить",
		Список(
			"чтение секретов из внешнего хранилища",
			"кэширование с ограниченным временем жизни",
			"аудит обращений"));
	ДобавитьВерсию(Секреты, "0.4.0", Новый Массив(), 1);
	Результат.Добавить(Секреты);

	Возврат Результат;

КонецФункции

// Пакеты, которые просят место в пуле люди без права публикации: их push ложится во
// «входящие» пула и ждёт решения мейнтейнера. Одной заявке мейнтейнер отказывает —
// заявитель получает уведомление об исходе.
//
// Возвращаемое значение:
//  Массив из Структура - описание пакета (см. ОписаниеПакета) с одной версией, Отказать
//                        (Булево), ПричинаОтказа (Строка), Рассматривает (логин
//                        мейнтейнера, решающего заявку).
//
Функция Заявки() Экспорт

	Результат = Новый Массив();
	Свой = ПулОрганизации();

	Метрики = ОписаниеПакета(Свой, "corp-metrics", "frank",
		"Метрики приложения в формате Prometheus", "метрики, prometheus, мониторинг",
		"Фрэнк Заявителев", "МетрикиПриложения", "Собрать",
		Список("счётчики, гистограммы и датчики", "выдача по адресу /metrics"));
	ДобавитьВерсию(Метрики, "0.1.0", Новый Массив(), 0);
	Результат.Добавить(Заявка(Метрики, "alice"));

	Вход = ОписаниеПакета(Свой, "corp-auth", "grace",
		"Проверка JWT и ролей для сервисов Велеса", "jwt, авторизация, роли",
		"Грейс Заявителева", "ПроверкаДоступа", "Проверить",
		Список("проверка подписи JWT", "роли из клейма"));
	ДобавитьВерсию(Вход, "0.2.0", Новый Массив(), 0);
	Результат.Добавить(Заявка(Вход, "alice"));

	Наследие = ОписаниеПакета(Свой, "corp-legacy", "heidi",
		"Обёртки старого API, которые команда сочла лишними", "legacy, совместимость",
		"Хайди Заявителева", "СтароеAPI", "Вызвать",
		Список("вызовы старого API"));
	ДобавитьВерсию(Наследие, "1.0.0", Новый Массив(), 0);
	Результат.Добавить(Заявка(Наследие, "alice",
		"Обёртки старого API команда больше не поддерживает"));

	Возврат Результат;

КонецФункции

// Имена, занятые в пуле без единой версии: резерв ставят кнопкой «Добавить пакет».
//
// Возвращаемое значение:
//  Массив из Структура - Пул, Имя, Кем (логин мейнтейнера пула).
//
Функция Резервы() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Пул, Имя, Кем", ПулОрганизации(), "new-lib", "alice"));
	Возврат Результат;

КонецФункции

// Провайдеры входа, которых администратор заводит из интерфейса. Клиенты и секреты фиктивные:
// кнопка «GitHub» уведёт браузер на github.com, и тот откажет незнакомому client_id.
//
// Возвращаемое значение:
//  Массив из Структура - Имя, Пресет, Клиент, Секрет, Включён, Автосоздание,
//                        ЗакрытВСтранах (коды ISO через запятую либо пустая строка).
//
Функция ПровайдерыВхода() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Провайдер("github", "github", "Iv1.4f2a91c0", Истина, Истина, "RU, BY"));
	Результат.Добавить(Провайдер("gitlab", "gitlab", "gl-7c1e0b2d", Ложь, Ложь, ""));
	Возврат Результат;

КонецФункции

// Провайдер входа, объявленный конфигурацией стенда (переменными окружения в tools/demo.os):
// в списке он помечен «из конфигурации» и правке из интерфейса не поддаётся.
//
// Возвращаемое значение:
//  Строка - имя провайдера.
//
Функция ПровайдерИзКонфигурации() Экспорт
	Возврат "corp-sso";
КонецФункции

// Второй апстрим пула по умолчанию — выдача пула этого же хаба, читаемая по ключу: реестр
// апстримов не пуст, а стенд не ходит за ним наружу. Разрешённые имена не совпадают ни
// с одним пакетом источника, поэтому собственные пакеты стенда в пул по умолчанию не попадут.
//
// Возвращаемое значение:
//  Структура - Пул (куда), ПулИсточник (чей адрес выдачи), Ключ (логин, чьим PAT ходит),
//              СрокКэша (секунды), Разрешено (Массив из Строка — маски имён).
//
Функция ВторойАпстрим() Экспорт
	Возврат Новый Структура("Пул, ПулИсточник, Ключ, СрокКэша, Разрешено",
		ДефолтныйПул(), "contrib", "alice", 300, Список("corp-*"));
КонецФункции

// Зеркала пула по умолчанию. Источник — пулы этого же хаба: наружу зеркала не ходят,
// а фильтр имён не пускает собственные пакеты стенда в пул по умолчанию.
//
// Возвращаемое значение:
//  Массив из Структура - Пул, ПулИсточник, Фильтр (Массив из Строка — маски имён),
//                        Интервал (с), Перенос (Булево), Включено (Булево),
//                        Синхронизировать (Булево — прогнать сразу после заведения).
//
Функция Зеркала() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Зеркало(ДефолтныйПул(), ПулОрганизации(), Список("corp-*", "mylib"),
		3600, Истина, Истина, Истина));
	Результат.Добавить(Зеркало(ДефолтныйПул(), "contrib", Список("archive-*"),
		86400, Ложь, Ложь, Ложь));
	Возврат Результат;

КонецФункции

// Прокси до Bot API Telegram — узел, которого нет: доставка в фиктивные чаты отказывает
// на своей машине, и стенд не выходит в сеть.
//
// Возвращаемое значение:
//  Строка - имя узла прокси.
//
Функция ПроксиTelegram() Экспорт
	Возврат "telegram-proxy.openhub-demo.local";
КонецФункции

// Ключи доступа (токены) администратора, которые видны в разделе «Токены доступа»: разные права,
// области и сроки, один из них — с близким концом срока.
//
// Возвращаемое значение:
//  Массив из Структура - Имя, Права ("read,write" и т.п.), СрокДней, Пулы (Массив из Строка;
//                        пустой — весь хаб).
//
Функция КлючиАдмина() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Токен("ноутбук", "read,write", 26, Новый Массив()));
	Результат.Добавить(Токен("ci · сборка релизов", "write", 98, Список(ПулОрганизации(), "team")));
	Результат.Добавить(Токен("релиз-бот", "read", 2, Список(ПулОрганизации())));
	Возврат Результат;

КонецФункции

// Подписки на события хаба, пула и пакета. Чаты Telegram и токены ботов фиктивные, а Bot API
// стенд зовёт через прокси-тупик (см. ПроксиTelegram); адреса вебхуков — в зоне .local.
// Заводятся последними, когда события наполнения уже отгремели: доставка во время
// наполнения не начинается, а после — отказывает на своей машине.
//
// Возвращаемое значение:
//  Массив из Структура - Уровень ("хаб" | "пул" | "пакет"), Пул, Пакет, Название, Вид
//                        ("telegram" | "вебхук"), Адрес, ЧатИд, ТокенБота, Шаблон,
//                        События (Массив из Строка), ПорогЗаполнения (Число, 0 — без него),
//                        СужениеРазрешено, Включена, Исключить (Массив из Строка — пакеты),
//                        Кем (логин).
//
Функция Подписки() Экспорт

	Все = Список("версия.опубликована", "версия.отозвана", "версия.восстановлена", "пул.заполнен");
	Свой = ПулОрганизации();

	Результат = Новый Массив();

	Хаба = Подписка("хаб", "", "", "все релизы в #ops", "telegram", ЛогинАдмина());
	Хаба.ЧатИд = "-1009876543210";
	Хаба.ТокенБота = "123456789:AAH-openhub-demo-ops-bot-not-real";
	Хаба.Шаблон = "{событие}: {пул}/{пакет} {версия} — {кто}";
	Хаба.События = Все;
	Хаба.ПорогЗаполнения = 80;
	Хаба.СужениеРазрешено = Истина;
	Результат.Добавить(Хаба);

	Чат = Подписка("пул", Свой, "", "релизы в чат", "telegram", "alice");
	Чат.ЧатИд = "-1001234567890";
	Чат.ТокенБота = "987654321:AAH-corp-release-bot-not-real";
	Чат.Шаблон = "{событие}: {пакет} {версия} · {ссылка}";
	Чат.События = Все;
	Чат.ПорогЗаполнения = 80;
	Чат.СужениеРазрешено = Истина;
	Чат.Исключить = Список("md-view", "cron-tasks");
	Результат.Добавить(Чат);

	Сборка = Подписка("пул", Свой, "", "ci-hook", "вебхук", "alice");
	Сборка.Адрес = "https://ci.corp.local/hooks/openhub";
	Сборка.События = Список("версия.опубликована");
	Сборка.Включена = Ложь;
	Результат.Добавить(Сборка);

	Документация = Подписка("пакет", Свой, "veles-core", "сборка документации", "вебхук", "alice");
	Документация.Адрес = "https://ci.corp.local/hooks/veles-docs";
	Документация.События = Список("версия.опубликована", "версия.отозвана");
	Результат.Добавить(Документация);

	Возврат Результат;

КонецФункции

// Отозванные версии стенда.
//
// Возвращаемое значение:
//  Массив из Структура - Пул, Пакет, Версия, Кем (логин публикатора).
//
Функция ОтозванныеВерсии() Экспорт

	Результат = Новый Массив();

	Запись = Новый Структура();
	Запись.Вставить("Пул", ПулОрганизации());
	Запись.Вставить("Пакет", "cron-tasks");
	Запись.Вставить("Версия", "0.2.0");
	Запись.Вставить("Кем", "alice");
	Результат.Добавить(Запись);

	Возврат Результат;

КонецФункции

// Демо-специфичные теги: ставятся поверх базовых latest/stable/prerelease, которые
// заводятся автоматически первой же публикацией.
//
// Возвращаемое значение:
//  Массив из Структура - Пул, Пакет, Тег, Режим, ТипПравила, Правило, Версия, Кем.
//
Функция Теги() Экспорт

	Результат = Новый Массив();
	Свой = ПулОрганизации();
	Результат.Добавить(ТегПравила(Свой, "veles-core", "stable", "semver", "^1.0.0", "alice"));
	Результат.Добавить(ТегРучной(Свой, "veles-core", "lts", "1.0.0", "alice"));
	Результат.Добавить(ТегПравила(Свой, "cron-tasks", "stable", "semver", ">=0.3.0", "alice"));
	Возврат Результат;

КонецФункции

// Имя файла артефакта версии — оно же значение заголовка FILE-NAME при публикации.
//
// Параметры:
//  ИмяПакета - Строка - имя пакета.
//  Версия - Строка - строка версии.
//
// Возвращаемое значение:
//  Строка - имя файла .ospx.
//
Функция ИмяФайла(Знач ИмяПакета, Знач Версия) Экспорт
	Возврат СтрШаблон("%1-%2.ospx", ИмяПакета, Версия);
КонецФункции

// Текст README версии: набор разметки, на котором видна работа рендера и санитайзера.
//
// Параметры:
//  Пакет - Структура - описание пакета.
//  Версия - Строка - строка версии.
//
// Возвращаемое значение:
//  Строка - текст файла README.md.
//
Функция ТекстREADME(Знач Пакет, Знач Версия) Экспорт

	Текст = Новый Массив();
	Текст.Добавить("# " + Пакет.Имя);
	Текст.Добавить("");
	Текст.Добавить(Пакет.Описание + ".");
	Текст.Добавить("");
	Текст.Добавить("> Демонстрационный пакет стенда OpenHub. Документация версии " + Версия + ".");
	Текст.Добавить("");
	Текст.Добавить("## Установка");
	Текст.Добавить("");
	Текст.Добавить("```bash");
	Текст.Добавить("opm install " + Пакет.Имя);
	Текст.Добавить("opm install " + Пакет.Имя + "@" + Версия);
	Текст.Добавить("```");
	Текст.Добавить("");
	Текст.Добавить("## Быстрый старт");
	Текст.Добавить("");
	Текст.Добавить("```bsl");
	Текст.Добавить("#Использовать " + Пакет.Имя);
	Текст.Добавить("");
	Текст.Добавить("Компонент = Новый " + Пакет.Класс + ";");
	Текст.Добавить("Компонент." + Пакет.Метод + "();");
	Текст.Добавить("```");
	Текст.Добавить("");
	Текст.Добавить("## Возможности");
	Текст.Добавить("");
	Для Каждого Возможность Из Пакет.Возможности Цикл
		Текст.Добавить("- " + Возможность);
	КонецЦикла;
	Текст.Добавить("");
	Текст.Добавить("## Совместимость");
	Текст.Добавить("");
	// без Markdown-таблиц: oscript-md собран без расширения таблиц — вышел бы сырой текст
	Текст.Добавить("- OneScript **2.0** и новее;");
	Текст.Добавить("- `" + Пакет.Имя + "` версии `" + Версия + "`;");
	Текст.Добавить("- opm 1.4 и новее.");
	Текст.Добавить("");
	Текст.Добавить("## Лицензия");
	Текст.Добавить("");
	Текст.Добавить("[" + Пакет.Лицензия + "](" + Пакет.Репозиторий + ") — " + Пакет.Автор + ".");

	Возврат СтрСоединить(Текст, Символы.ПС);

КонецФункции

// Текст packagedef версии — то, из чего обычный автор собирает пакет командой opm build.
//
// Параметры:
//  Пакет - Структура - описание пакета.
//  Версия - Структура - описание версии.
//
// Возвращаемое значение:
//  Строка - текст файла packagedef.
//
Функция ТекстPackagedef(Знач Пакет, Знач Версия) Экспорт

	Строчки = Новый Массив();
	Строчки.Добавить("Описание.Имя(""" + Пакет.Имя + """)");
	Строчки.Добавить(Символы.Таб + ".Версия(""" + Версия.Версия + """)");
	Строчки.Добавить(Символы.Таб + ".Автор(""" + Пакет.Автор + """)");
	Строчки.Добавить(Символы.Таб + ".Описание(""" + Пакет.Описание + """)");
	Строчки.Добавить(Символы.Таб + ".ВерсияСреды(""2.0"")");

	Для Каждого Зав Из Версия.Зависимости Цикл
		Если ЗначениеЗаполнено(Зав.Мин) Тогда
			Строчки.Добавить(СтрШаблон("%1.ЗависитОт(""%2"", ""%3"")", Символы.Таб, Зав.Имя, Зав.Мин));
		Иначе
			Строчки.Добавить(СтрШаблон("%1.ЗависитОт(""%2"")", Символы.Таб, Зав.Имя));
		КонецЕсли;
	КонецЦикла;

	Строчки.Добавить(Символы.Таб + ".ВключитьФайл(""src"")");
	Строчки.Добавить(Символы.Таб + ".ВключитьФайл(""README.md"")");
	Строчки.Добавить(";");

	Возврат СтрСоединить(Строчки, Символы.ПС);

КонецФункции

// Текст исходного модуля демо-пакета.
//
// Параметры:
//  Пакет - Структура - описание пакета.
//
// Возвращаемое значение:
//  Строка - текст файла src/<Класс>.os.
//
Функция ТекстМодуля(Знач Пакет) Экспорт

	Текст = Новый Массив();
	Текст.Добавить("// " + Пакет.Описание + ".");
	Текст.Добавить("// Демонстрационный исходник пакета " + Пакет.Имя + " (стенд OpenHub).");
	Текст.Добавить("");
	Текст.Добавить("Функция " + Пакет.Метод + "() Экспорт");
	Текст.Добавить(Символы.Таб + "Возврат """ + Пакет.Имя + """;");
	Текст.Добавить("КонецФункции");

	Возврат СтрСоединить(Текст, Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Человек(Знач Логин, Знач ВСюжете, Знач РольХаба = "user", Знач Вход = "пароль",
	Знач Заблокирован = Ложь)

	Результат = Новый Структура();
	Результат.Вставить("Логин", Логин);
	Результат.Вставить("Email", Логин + "@openhub.demo");
	Результат.Вставить("ВСюжете", ВСюжете);
	Результат.Вставить("РольХаба", РольХаба);
	Результат.Вставить("Вход", Вход);
	Результат.Вставить("Заблокирован", Заблокирован);
	Результат.Вставить("Массовка", Ложь);
	Возврат Результат;

КонецФункции

// Остальные учётки: экран «Люди» листается страницами, отбор по роли и статусу находит своё.
Функция Массовка()
	Возврат СтрРазделить("frank,grace,heidi,ivan,judy,karl,lena,mike,nina,oleg,petr,quinn,rita,"
		+ "sergey,tanya,uliana,victor,wendy,xenia,yuri,zoe,anna,boris,clara,denis,elena,fedor,"
		+ "galina,igor,kira,lev", ",");
КонецФункции

Функция МассовкаЗаблокированных()
	Возврат СтрРазделить("oleg,wendy", ",");
КонецФункции

Функция МассовкаПриглашённых()
	Возврат СтрРазделить("kira,lev", ",");
КонецФункции

Функция Заявка(Знач Пакет, Знач Рассматривает, Знач ПричинаОтказа = "")
	Пакет.Вставить("Отказать", ЗначениеЗаполнено(ПричинаОтказа));
	Пакет.Вставить("ПричинаОтказа", ПричинаОтказа);
	Пакет.Вставить("Рассматривает", Рассматривает);
	Возврат Пакет;
КонецФункции

Функция Провайдер(Знач Имя, Знач Пресет, Знач Клиент, Знач Включён, Знач Автосоздание,
	Знач ЗакрытВСтранах)

	Результат = Новый Структура();
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Пресет", Пресет);
	Результат.Вставить("Клиент", Клиент);
	Результат.Вставить("Секрет", "demo-" + Имя + "-client-secret");
	Результат.Вставить("Включён", Включён);
	Результат.Вставить("Автосоздание", Автосоздание);
	Результат.Вставить("ЗакрытВСтранах", ЗакрытВСтранах);
	Возврат Результат;

КонецФункции

Функция Зеркало(Знач ИмяПула, Знач ПулИсточник, Знач Фильтр, Знач Интервал, Знач Перенос,
	Знач Включено, Знач Синхронизировать)

	Результат = Новый Структура();
	Результат.Вставить("Пул", ИмяПула);
	Результат.Вставить("ПулИсточник", ПулИсточник);
	Результат.Вставить("Фильтр", Фильтр);
	Результат.Вставить("Интервал", Интервал);
	Результат.Вставить("Перенос", Перенос);
	Результат.Вставить("Включено", Включено);
	Результат.Вставить("Синхронизировать", Синхронизировать);
	Возврат Результат;

КонецФункции

Функция Токен(Знач Имя, Знач Права, Знач СрокДней, Знач Пулы)
	Возврат Новый Структура("Имя, Права, СрокДней, Пулы", Имя, Права, СрокДней, Пулы);
КонецФункции

Функция Подписка(Знач Уровень, Знач ИмяПула, Знач ИмяПакета, Знач Название, Знач Вид, Знач Кем)

	Результат = Новый Структура();
	Результат.Вставить("Уровень", Уровень);
	Результат.Вставить("Пул", ИмяПула);
	Результат.Вставить("Пакет", ИмяПакета);
	Результат.Вставить("Название", Название);
	Результат.Вставить("Вид", Вид);
	Результат.Вставить("Адрес", "");
	Результат.Вставить("ЧатИд", "");
	Результат.Вставить("ТокенБота", "");
	Результат.Вставить("Шаблон", "");
	Результат.Вставить("События", Новый Массив());
	Результат.Вставить("ПорогЗаполнения", 0);
	Результат.Вставить("СужениеРазрешено", Ложь);
	Результат.Вставить("Включена", Истина);
	Результат.Вставить("Исключить", Новый Массив());
	Результат.Вставить("Кем", Кем);
	Возврат Результат;

КонецФункции

Функция Группа(Знач Имя, Знач Описание, Знач Участники)
	Результат = Новый Структура();
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Описание", Описание);
	Результат.Вставить("Участники", Участники);
	Возврат Результат;
КонецФункции

Функция Пул(Знач Имя, Знач Видимость, Знач КвотаМб, Знач ПубликацияРазрешена, Знач Апстрим)
	Результат = Новый Структура();
