// Сюжет демо-стенда данными: люди, группы, пулы, гранты, пакеты с версиями и планом
// скачиваний. Общий источник для сборщика .ospx и наполнителя по HTTP.

Перем ПарольДемо;

#Область ПубличныйИнтерфейс

// Пароль обычных учётных записей стенда.
//
// Возвращаемое значение:
//  Строка - пароль.
//
Функция Пароль() Экспорт
	Возврат ПарольДемо;
КонецФункции

// Логин администратора стенда.
//
// Возвращаемое значение:
//  Строка - логин.
//
Функция ЛогинАдмина() Экспорт
	Возврат "root";
КонецФункции

// Обычные пользователи стенда (администратор создаётся мастером /setup отдельно).
//
// Возвращаемое значение:
//  Массив из Структура - Логин, Email, Роль.
//
Функция Люди() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Человек("alice", "Разработчик ядра: владеет пулом " + ПулОрганизации()));
	Результат.Добавить(Человек("bob",
		СтрШаблон("Публикатор: пишет в %1, ведёт приватный team", ПулОрганизации())));
	Результат.Добавить(Человек("carol", "Тестировщик: читает team, правит один пакет по гранту"));
	Результат.Добавить(Человек("dave", "Обычный пользователь без ролей"));
	Возврат Результат;

КонецФункции

// Группы стенда с составом.
//
// Возвращаемое значение:
//  Массив из Структура - Имя, Описание, Участники (Массив из Строка).
//
Функция Группы() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Группа("platform", "Платформенная команда", Список("alice", "bob")));
	Результат.Добавить(Группа("qa", "Тестирование и релизы", Список("carol")));
	Возврат Результат;

КонецФункции

// Имя пула по умолчанию: короткие легаси-адреса /download, /dev-channel и /push ведут
// в него. На стенде это читающее зеркало публичного хаба.
//
// Возвращаемое значение:
//  Строка - имя пула.
//
Функция ДефолтныйПул() Экспорт
	Возврат "public";
КонецФункции

// Имя пула, в котором лежат собственные пакеты организации.
//
// Возвращаемое значение:
//  Строка - имя пула.
//
Функция ПулОрганизации() Экспорт
	Возврат "corp";
КонецФункции

// Адрес апстрима, которым зеркалится пул по умолчанию. Базовый URL апстрима — каталог
// выдачи, а не главная страница хаба: клиент дописывает к нему «{пакет}/{файл}».
//
// Возвращаемое значение:
//  Строка - базовый URL каталога выдачи публичного хаба.
//
Функция АдресАпстрима() Экспорт
	Возврат "https://hub.oscript.io/download/";
КонецФункции

// Пакет апстрима, которым стенд проверяет работу зеркала.
//
// Возвращаемое значение:
//  Структура - Имя, Версия.
//
Функция ПробникЗеркала() Экспорт
	Возврат Новый Структура("Имя, Версия", "asserts", "1.6.2");
КонецФункции

// Пулы стенда в порядке создания; первый — пул по умолчанию.
//
// Возвращаемое значение:
//  Массив из Структура - Имя, Тип, Видимость, КвотаМб, ПубликацияРазрешена, Апстрим.
//
Функция Пулы() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Пул(ДефолтныйПул(), "public", 0, Ложь, АдресАпстрима()));
	Результат.Добавить(Пул(ПулОрганизации(), "public", 0, Истина, ""));
	Результат.Добавить(Пул("contrib", "public", 0, Истина, ""));
	Результат.Добавить(Пул("team", "private", 512, Истина, ""));
	Возврат Результат;

КонецФункции

// Роли субъектов на пулах: то же, что выдаёт экран прав доступа пула.
//
// Возвращаемое значение:
//  Массив из Структура - Пул, ТипСубъекта, Субъект, Роль.
//
Функция ГрантыПулов() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Грант(ДефолтныйПул(), "группа", "platform", "мейнтейнер"));
	Результат.Добавить(Грант(ПулОрганизации(), "пользователь", "alice", "мейнтейнер"));
	Результат.Добавить(Грант(ПулОрганизации(), "пользователь", "bob", "райтер"));
	Результат.Добавить(Грант(ПулОрганизации(), "группа", "platform", "райтер"));
	Результат.Добавить(Грант("contrib", "группа", "platform", "мейнтейнер"));
	Результат.Добавить(Грант("team", "пользователь", "bob", "мейнтейнер"));
	Результат.Добавить(Грант("team", "пользователь", "carol", "читатель"));
	Результат.Добавить(Грант("team", "группа", "qa", "читатель"));
	Возврат Результат;

КонецФункции

// Гранулярные роли на отдельных пакетах: право без участия в пуле.
//
// Возвращаемое значение:
//  Массив из Структура - Пул, Пакет, ТипСубъекта, Субъект, Роль, Выдаёт (логин).
//
Функция ГрантыПакетов() Экспорт

	Результат = Новый Массив();

	Запись = Новый Структура();
	Запись.Вставить("Пул", ПулОрганизации());
	Запись.Вставить("Пакет", "veles-core");
	Запись.Вставить("ТипСубъекта", "пользователь");
	Запись.Вставить("Субъект", "carol");
	Запись.Вставить("Роль", "райтер");
	Запись.Вставить("Выдаёт", "alice");
	Результат.Добавить(Запись);

	Возврат Результат;

КонецФункции

// Пакеты стенда со всеми версиями в порядке публикации.
//
// Возвращаемое значение:
//  Массив из Структура - описание пакета (см. ОписаниеПакета).
//
Функция Пакеты() Экспорт

	Результат = Новый Массив();

	Ядро = ОписаниеПакета(ПулОрганизации(), "veles-core", "alice",
		"Ядро фреймворка Велес: контейнер зависимостей, конфигурация и логирование",
		"di, контейнер, конфигурация, логирование", "Команда Велес", "ВелесЯдро", "Собрать",
		Список(
			"внедрение зависимостей без кодогенерации",
			"иерархическая конфигурация с переопределением из окружения",
			"структурное логирование с контекстом запроса"));
	ЗависимостиЯдра = Список(
		Зависимость("json", "1.1.2"),
		Зависимость("tokenizer", "1.4.0"),
		Зависимость("asserts", "1.6.2", "", Истина));
	ДобавитьВерсию(Ядро, "0.9.0", ЗависимостиЯдра, 3);
	ДобавитьВерсию(Ядро, "1.0.0", ЗависимостиЯдра, 6);
	ДобавитьВерсию(Ядро, "1.1.0", ЗависимостиЯдра, 11);
	ДобавитьВерсию(Ядро, "1.2.0", ЗависимостиЯдра, 24);
	ДобавитьВерсию(Ядро, "1.3.0-rc.1", ЗависимостиЯдра, 2, "dev");
	Результат.Добавить(Ядро);

	Веб = ОписаниеПакета(ПулОрганизации(), "veles-http", "alice",
		"HTTP-слой Велеса: маршрутизация, middleware и сериализация ответов",
		"http, роутинг, middleware, rest", "Команда Велес", "ВелесМаршрутизатор", "Обработать",
		Список(
			"маршруты с параметрами пути и типизированной привязкой",
			"конвейер middleware: аутентификация, CORS, трассировка",
			"согласование форматов ответа JSON/HTML"));
	ЗависимостиВеб = Список(Зависимость("veles-core", "1.1.0"), Зависимость("json", "1.1.2"));
	ДобавитьВерсию(Веб, "1.0.0", ЗависимостиВеб, 4);
	ДобавитьВерсию(Веб, "1.1.0", ЗависимостиВеб, 6);
	ДобавитьВерсию(Веб, "1.2.0", ЗависимостиВеб, 9);
	Результат.Добавить(Веб);

	Утилита = ОписаниеПакета(ПулОрганизации(), "veles-cli", "bob",
		"Консольные команды Велеса: генерация каркаса приложения и релизных заметок",
		"cli, консоль, генератор", "Команда Велес", "ВелесКоманда", "Выполнить",
		Список(
			"генерация каркаса приложения одной командой",
			"сборка релизных заметок по журналу коммитов",
			"автодополнение для bash и zsh"));
	ЗависимостиУтилиты = Список(
		Зависимость("veles-core", "1.2.0"),
		Зависимость("veles-http", "1.1.0"),
		Зависимость("asserts", "1.6.2", "", Истина));
	ДобавитьВерсию(Утилита, "0.5.0", ЗависимостиУтилиты, 2);
	ДобавитьВерсию(Утилита, "0.6.0", ЗависимостиУтилиты, 5);
	Результат.Добавить(Утилита);

	Разметка = ОписаниеПакета(ПулОрганизации(), "md-view", "bob",
		"Просмотрщик Markdown: рендер в HTML с подсветкой кода",
		"markdown, html, рендер, документация", "Борис Публикаторов",
		"ПросмотрщикРазметки", "Отрисовать",
		Список(
			"CommonMark с таблицами и списками задач",
			"подсветка кода без внешних зависимостей",
			"санитизация пользовательского HTML"));
	ЗависимостиРазметки = Список(Зависимость("veles-core", "1.0.0"));
	ДобавитьВерсию(Разметка, "1.0.0", ЗависимостиРазметки, 2);
	ДобавитьВерсию(Разметка, "1.0.1", ЗависимостиРазметки, 4);
	Результат.Добавить(Разметка);

	Задачи = ОписаниеПакета(ПулОрганизации(), "cron-tasks", "alice",
		"Планировщик фоновых задач с расписанием в формате cron",
		"cron, планировщик, фоновые задачи", "Команда Велес", "ПланировщикЗадач", "Запустить",
		Список(
			"расписания в формате cron с точностью до минуты",
			"повторные попытки с экспоненциальной задержкой",
			"журнал выполнения задач"));
	ЗависимостиЗадач = Список(Зависимость("veles-core", "1.1.0"));
	ДобавитьВерсию(Задачи, "0.1.0", ЗависимостиЗадач, 1);
	ДобавитьВерсию(Задачи, "0.2.0", ЗависимостиЗадач, 1);
	ДобавитьВерсию(Задачи, "0.3.0", ЗависимостиЗадач, 3);
	Результат.Добавить(Задачи);

	Таблицы = ОписаниеПакета("contrib", "csv-tools", "bob",
		"Чтение и запись CSV с автоопределением разделителя",
		"csv, таблицы, импорт, экспорт", "Сообщество OpenHub", "ЧитательCSV", "Прочитать",
		Список(
			"автоопределение разделителя и кодировки",
			"потоковое чтение больших файлов",
			"экспорт из таблицы значений"));
	Таблицы.Устарел = Истина;
	ДобавитьВерсию(Таблицы, "1.0.0", Новый Массив(), 1);
	ДобавитьВерсию(Таблицы, "1.1.0", Новый Массив(), 2);
	Результат.Добавить(Таблицы);

	Формы = ОписаниеПакета("contrib", "legacy-forms", "bob",
		"Формы обратной связи для старых конфигураций (нумерация версий legacy)",
		"формы, legacy, совместимость", "Сообщество OpenHub", "КонструкторФорм", "Построить",
		Список(
			"совместимость с нумерацией версий старого хаба",
			"валидация полей формы",
			"экспорт результатов в CSV"));
	ЗависимостиФорм = Список(Зависимость("csv-tools", "1.0.0"));
	ДобавитьВерсию(Формы, "1.1.0.7", ЗависимостиФорм, 1);
	ДобавитьВерсию(Формы, "1.2.0.3", ЗависимостиФорм, 2);
	Результат.Добавить(Формы);

	Выкладка = ОписаниеПакета("team", "team-deploy", "bob",
		"Внутренние сценарии выкладки: сборка, прогон тестов, публикация релиза",
		"deploy, ci, внутренний", "Внутренняя команда", "СценарийВыкладки", "Выполнить",
		Список(
			"выкладка в несколько окружений одной командой",
			"откат к предыдущему релизу",
			"уведомления о результате в чат"));
	ЗависимостиВыкладки = Список(Зависимость("veles-core", "1.2.0"));
	ДобавитьВерсию(Выкладка, "2.0.0", ЗависимостиВыкладки, 1);
	ДобавитьВерсию(Выкладка, "2.1.0", ЗависимостиВыкладки, 2);
	Результат.Добавить(Выкладка);

	Секреты = ОписаниеПакета("team", "team-secrets", "bob",
		"Доступ к хранилищу секретов команды",
		"секреты, безопасность, внутренний", "Внутренняя команда", "ХранилищеСекретов", "Получить",
		Список(
			"чтение секретов из внешнего хранилища",
			"кэширование с ограниченным временем жизни",
			"аудит обращений"));
	ДобавитьВерсию(Секреты, "0.4.0", Новый Массив(), 1);
	Результат.Добавить(Секреты);

	Возврат Результат;

КонецФункции

// Отозванные версии стенда.
//
// Возвращаемое значение:
//  Массив из Структура - Пул, Пакет, Версия, Кем (логин публикатора).
//
Функция ОтозванныеВерсии() Экспорт

	Результат = Новый Массив();

	Запись = Новый Структура();
	Запись.Вставить("Пул", ПулОрганизации());
	Запись.Вставить("Пакет", "cron-tasks");
	Запись.Вставить("Версия", "0.2.0");
	Запись.Вставить("Кем", "alice");
	Результат.Добавить(Запись);

	Возврат Результат;

КонецФункции

// Демо-специфичные теги: ставятся поверх базовых latest/stable/prerelease, которые
// заводятся автоматически первой же публикацией.
//
// Возвращаемое значение:
//  Массив из Структура - Пул, Пакет, Тег, Режим, ТипПравила, Правило, Версия, Кем.
//
Функция Теги() Экспорт

	Результат = Новый Массив();
	Свой = ПулОрганизации();
	Результат.Добавить(ТегПравила(Свой, "veles-core", "stable", "semver", "^1.0.0", "alice"));
	Результат.Добавить(ТегРучной(Свой, "veles-core", "lts", "1.0.0", "alice"));
	Результат.Добавить(ТегПравила(Свой, "cron-tasks", "stable", "semver", ">=0.3.0", "alice"));
	Возврат Результат;

КонецФункции

// Имя файла артефакта версии — оно же значение заголовка FILE-NAME при публикации.
//
// Параметры:
//  ИмяПакета - Строка - имя пакета.
//  Версия - Строка - строка версии.
//
// Возвращаемое значение:
//  Строка - имя файла .ospx.
//
Функция ИмяФайла(Знач ИмяПакета, Знач Версия) Экспорт
	Возврат СтрШаблон("%1-%2.ospx", ИмяПакета, Версия);
КонецФункции

// Текст README версии: набор разметки, на котором видна работа рендера и санитайзера.
//
// Параметры:
//  Пакет - Структура - описание пакета.
//  Версия - Строка - строка версии.
//
// Возвращаемое значение:
//  Строка - текст файла README.md.
//
Функция ТекстREADME(Знач Пакет, Знач Версия) Экспорт

	Текст = Новый Массив();
	Текст.Добавить("# " + Пакет.Имя);
	Текст.Добавить("");
	Текст.Добавить(Пакет.Описание + ".");
	Текст.Добавить("");
	Текст.Добавить("> Демонстрационный пакет стенда OpenHub. Документация версии " + Версия + ".");
	Текст.Добавить("");
	Текст.Добавить("## Установка");
	Текст.Добавить("");
	Текст.Добавить("```bash");
	Текст.Добавить("opm install " + Пакет.Имя);
	Текст.Добавить("opm install " + Пакет.Имя + "@" + Версия);
	Текст.Добавить("```");
	Текст.Добавить("");
	Текст.Добавить("## Быстрый старт");
	Текст.Добавить("");
	Текст.Добавить("```bsl");
	Текст.Добавить("#Использовать " + Пакет.Имя);
	Текст.Добавить("");
	Текст.Добавить("Компонент = Новый " + Пакет.Класс + ";");
	Текст.Добавить("Компонент." + Пакет.Метод + "();");
	Текст.Добавить("```");
	Текст.Добавить("");
	Текст.Добавить("## Возможности");
	Текст.Добавить("");
	Для Каждого Возможность Из Пакет.Возможности Цикл
		Текст.Добавить("- " + Возможность);
	КонецЦикла;
	Текст.Добавить("");
	Текст.Добавить("## Совместимость");
	Текст.Добавить("");
	// без Markdown-таблиц: oscript-md собран без расширения таблиц — вышел бы сырой текст
	Текст.Добавить("- OneScript **2.0** и новее;");
	Текст.Добавить("- `" + Пакет.Имя + "` версии `" + Версия + "`;");
	Текст.Добавить("- opm 1.4 и новее.");
	Текст.Добавить("");
	Текст.Добавить("## Лицензия");
	Текст.Добавить("");
	Текст.Добавить("[" + Пакет.Лицензия + "](" + Пакет.Репозиторий + ") — " + Пакет.Автор + ".");

	Возврат СтрСоединить(Текст, Символы.ПС);

КонецФункции

// Текст packagedef версии — то, из чего обычный автор собирает пакет командой opm build.
//
// Параметры:
//  Пакет - Структура - описание пакета.
//  Версия - Структура - описание версии.
//
// Возвращаемое значение:
//  Строка - текст файла packagedef.
//
Функция ТекстPackagedef(Знач Пакет, Знач Версия) Экспорт

	Строчки = Новый Массив();
	Строчки.Добавить("Описание.Имя(""" + Пакет.Имя + """)");
	Строчки.Добавить(Символы.Таб + ".Версия(""" + Версия.Версия + """)");
	Строчки.Добавить(Символы.Таб + ".Автор(""" + Пакет.Автор + """)");
	Строчки.Добавить(Символы.Таб + ".Описание(""" + Пакет.Описание + """)");
	Строчки.Добавить(Символы.Таб + ".ВерсияСреды(""2.0"")");

	Для Каждого Зав Из Версия.Зависимости Цикл
		Если ЗначениеЗаполнено(Зав.Мин) Тогда
			Строчки.Добавить(СтрШаблон("%1.ЗависитОт(""%2"", ""%3"")", Символы.Таб, Зав.Имя, Зав.Мин));
		Иначе
			Строчки.Добавить(СтрШаблон("%1.ЗависитОт(""%2"")", Символы.Таб, Зав.Имя));
		КонецЕсли;
	КонецЦикла;

	Строчки.Добавить(Символы.Таб + ".ВключитьФайл(""src"")");
	Строчки.Добавить(Символы.Таб + ".ВключитьФайл(""README.md"")");
	Строчки.Добавить(";");

	Возврат СтрСоединить(Строчки, Символы.ПС);

КонецФункции

// Текст исходного модуля демо-пакета.
//
// Параметры:
//  Пакет - Структура - описание пакета.
//
// Возвращаемое значение:
//  Строка - текст файла src/<Класс>.os.
//
Функция ТекстМодуля(Знач Пакет) Экспорт

	Текст = Новый Массив();
	Текст.Добавить("// " + Пакет.Описание + ".");
	Текст.Добавить("// Демонстрационный исходник пакета " + Пакет.Имя + " (стенд OpenHub).");
	Текст.Добавить("");
	Текст.Добавить("Функция " + Пакет.Метод + "() Экспорт");
	Текст.Добавить(Символы.Таб + "Возврат """ + Пакет.Имя + """;");
	Текст.Добавить("КонецФункции");

	Возврат СтрСоединить(Текст, Символы.ПС);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Человек(Знач Логин, Знач Роль)
	Результат = Новый Структура();
	Результат.Вставить("Логин", Логин);
	Результат.Вставить("Email", Логин + "@openhub.demo");
	Результат.Вставить("Роль", Роль);
	Возврат Результат;
КонецФункции

Функция Группа(Знач Имя, Знач Описание, Знач Участники)
	Результат = Новый Структура();
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Описание", Описание);
	Результат.Вставить("Участники", Участники);
	Возврат Результат;
КонецФункции

Функция Пул(Знач Имя, Знач Видимость, Знач КвотаМб, Знач ПубликацияРазрешена, Знач Апстрим)
	Результат = Новый Структура();
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Тип", "custom");
	Результат.Вставить("Видимость", Видимость);
	Результат.Вставить("КвотаМб", КвотаМб);
	Результат.Вставить("ПубликацияРазрешена", ПубликацияРазрешена);
	Результат.Вставить("Апстрим", Апстрим);
	Возврат Результат;
КонецФункции

Функция Грант(Знач ИмяПула, Знач ТипСубъекта, Знач Субъект, Знач Роль)
	Результат = Новый Структура();
	Результат.Вставить("Пул", ИмяПула);
	Результат.Вставить("ТипСубъекта", ТипСубъекта);
	Результат.Вставить("Субъект", Субъект);
	Результат.Вставить("Роль", Роль);
	Возврат Результат;
КонецФункции

Функция ТегПравила(Знач ИмяПула, Знач ИмяПакета, Знач Тег, Знач ТипПравила, Знач Правило, Знач Кем)
	Результат = Новый Структура();
	Результат.Вставить("Пул", ИмяПула);
	Результат.Вставить("Пакет", ИмяПакета);
	Результат.Вставить("Тег", Тег);
	Результат.Вставить("Режим", "правило");
	Результат.Вставить("ТипПравила", ТипПравила);
	Результат.Вставить("Правило", Правило);
	Результат.Вставить("Версия", "");
	Результат.Вставить("Кем", Кем);
	Возврат Результат;
КонецФункции

Функция ТегРучной(Знач ИмяПула, Знач ИмяПакета, Знач Тег, Знач Версия, Знач Кем)
	Результат = Новый Структура();
	Результат.Вставить("Пул", ИмяПула);
	Результат.Вставить("Пакет", ИмяПакета);
	Результат.Вставить("Тег", Тег);
	Результат.Вставить("Режим", "ручной");
	Результат.Вставить("ТипПравила", "");
	Результат.Вставить("Правило", "");
	Результат.Вставить("Версия", Версия);
	Результат.Вставить("Кем", Кем);
	Возврат Результат;
КонецФункции

Функция ОписаниеПакета(Знач ИмяПула, Знач Имя, Знач Публикатор, Знач Описание,
	Знач КлючевыеСлова, Знач Автор, Знач Класс, Знач Метод, Знач Возможности)

	Результат = Новый Структура();
	Результат.Вставить("Пул", ИмяПула);
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Публикатор", Публикатор);
	Результат.Вставить("Описание", Описание);
	Результат.Вставить("КлючевыеСлова", КлючевыеСлова);
	Результат.Вставить("Лицензия", "MIT");
	Результат.Вставить("Репозиторий", "https://github.com/openhub-demo/" + Имя);
	Результат.Вставить("Автор", Автор);
	Результат.Вставить("Класс", Класс);
	Результат.Вставить("Метод", Метод);
	Результат.Вставить("Возможности", Возможности);
	Результат.Вставить("Устарел", Ложь);
	Результат.Вставить("Версии", Новый Массив());
	Возврат Результат;

КонецФункции

Процедура ДобавитьВерсию(Пакет, Знач Строка_, Знач Зависимости, Знач Скачиваний, Знач Метка = "")
	Запись = Новый Структура();
	Запись.Вставить("Версия", Строка_);
	Запись.Вставить("Зависимости", Зависимости);
	Запись.Вставить("Скачиваний", Скачиваний);
	Запись.Вставить("Метка", Метка);
	Пакет.Версии.Добавить(Запись);
КонецПроцедуры

Функция Зависимость(Знач Имя, Знач Мин = "", Знач Макс = "", Знач ДляРазработки = Ложь)
	Результат = Новый Структура();
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Мин", Мин);
	Результат.Вставить("Макс", Макс);
	Результат.Вставить("ДляРазработки", ДляРазработки);
	Возврат Результат;
КонецФункции

// Массив из перечисленных значений: в OneScript нет литерала массива.
Функция Список(Знач З1 = Неопределено, Знач З2 = Неопределено, Знач З3 = Неопределено,
	Знач З4 = Неопределено, Знач З5 = Неопределено)

	Результат = Новый Массив();
	Значения = Новый Массив();
	Значения.Добавить(З1);
	Значения.Добавить(З2);
	Значения.Добавить(З3);
	Значения.Добавить(З4);
	Значения.Добавить(З5);

	Для Каждого Значение Из Значения Цикл
		Если Значение <> Неопределено Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач Пароль_ = "DemoPassw0rd") Экспорт
	ПарольДемо = ?(ЗначениеЗаполнено(Пароль_), Пароль_, "DemoPassw0rd");
КонецПроцедуры
