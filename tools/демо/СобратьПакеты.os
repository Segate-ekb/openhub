// Собирает .ospx демо-пакетов в каталог сборки стенда — работа автора пакета,
// та же, что делает opm build. Хаба не касается: только ospx-tools и файлы.

#Использовать ospx-tools

Перем Сценарий;
Перем КаталогСборки;

Функция ИзОкружения(Знач Имя, Знач ПоУмолчанию)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ПоУмолчанию);
КонецФункции

Процедура ОбеспечитьКаталог(Знач Путь)
	Если НЕ Новый Файл(Путь).Существует() Тогда
		СоздатьКаталог(Путь);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьТекстВФайл(Знач Путь, Знач Текст)
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

// Собирает один .ospx: opm-metadata.xml + content.zip (src, README.md, packagedef).
Функция СобратьOspx(Знач Пакет, Знач Версия)

	ВремКаталог = ОбъединитьПути(КаталогВременныхФайлов(),
		"openhub-demo-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(ВремКаталог);
	Содержимое = ОбъединитьПути(ВремКаталог, "content");
	СоздатьКаталог(Содержимое);
	СоздатьКаталог(ОбъединитьПути(Содержимое, "src"));

	ЗаписатьТекстВФайл(ОбъединитьПути(Содержимое, "README.md"),
		Сценарий.ТекстREADME(Пакет, Версия.Версия));
	ЗаписатьТекстВФайл(ОбъединитьПути(Содержимое, "packagedef"),
		Сценарий.ТекстPackagedef(Пакет, Версия));
	ЗаписатьТекстВФайл(ОбъединитьПути(Содержимое, "src", Пакет.Класс + ".os"),
		Сценарий.ТекстМодуля(Пакет));

	ПутьСодержимого = ОбъединитьПути(ВремКаталог, "content.zip");
	ЗаписьСодержимого = Новый ЗаписьZipФайла(ПутьСодержимого);
	ЗаписьСодержимого.Добавить(ОбъединитьПути(Содержимое, "*"),
		РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
		РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
	ЗаписьСодержимого.Записать();

	Манифест = ПакетыOspx.НовыйМанифест(Пакет.Имя, Версия.Версия);
	Манифест.УстановитьАвтора(Пакет.Автор);
	Манифест.УстановитьОписание(Пакет.Описание);
	Манифест.УстановитьАдресРепозитория(Пакет.Репозиторий);
	Манифест.УстановитьВерсиюДвижка("2.0");
	Для Каждого Зав Из Версия.Зависимости Цикл
		Манифест.ДобавитьЗависимость(Зав.Имя, Зав.Мин, Зав.Макс, Зав.ДляРазработки);
	КонецЦикла;

	ПутьМанифеста = ОбъединитьПути(ВремКаталог, "opm-metadata.xml");
	ПакетыOspx.ЗаписатьМанифестВФайл(Манифест, ПутьМанифеста);

	ПутьOspx = ОбъединитьПути(КаталогСборки, Сценарий.ИмяФайла(Пакет.Имя, Версия.Версия));
	ЗаписьПакета = Новый ЗаписьZipФайла(ПутьOspx);
	ЗаписьПакета.Добавить(ПутьМанифеста, РежимСохраненияПутейZIP.НеСохранятьПути);
	ЗаписьПакета.Добавить(ПутьСодержимого, РежимСохраненияПутейZIP.НеСохранятьПути);
	ЗаписьПакета.Записать();

	УдалитьФайлы(ВремКаталог);

	Возврат ПутьOspx;

КонецФункции

Процедура Собрать()

	КаталогСценария = Новый Файл(ТекущийСценарий().Источник).Путь;
	ПодключитьСценарий(ОбъединитьПути(КаталогСценария, "СценарийСтенда.os"), "СценарийСтенда");
	Сценарий = Новый СценарийСтенда(ИзОкружения("OSHUB_DEMO_PASSWORD", "DemoPassw0rd"));

	КореньДемо = Новый Файл(ИзОкружения("OSHUB_DEMO_ROOT",
		ОбъединитьПути(КаталогСценария, "..", "..", "demo"))).ПолноеИмя;
	ОбеспечитьКаталог(КореньДемо);

	КаталогСборки = ОбъединитьПути(КореньДемо, "build");
	ОбеспечитьКаталог(КаталогСборки);

	Собрано = 0;
	Для Каждого Пакет Из Сценарий.Пакеты() Цикл
		Для Каждого Версия Из Пакет.Версии Цикл
			СобратьOspx(Пакет, Версия);
			Собрано = Собрано + 1;
		КонецЦикла;
	КонецЦикла;

	Сообщить(СтрШаблон("демо: собрано пакетов .ospx — %1 (каталог %2)",
		Формат(Собрано, "ЧГ=0; ЧН=0"), КаталогСборки));
	Сообщить("DEMO-BUILD-OK");

КонецПроцедуры

Собрать();
