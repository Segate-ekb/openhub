// Тонкий HTTP-клиент демо-стенда поверх HTTPСоединение: запрос, ответ, разбор JSON
// и кука сессии. Ничего о внутренностях хаба не знает.

Перем Хост;
Перем НомерПорта;
Перем ТаймаутСек;

#Область ПубличныйИнтерфейс

// Базовый адрес хаба.
//
// Возвращаемое значение:
//  Строка - адрес вида http://localhost:3380.
//
Функция Адрес() Экспорт
	Возврат СтрШаблон("http://%1:%2", Хост, Формат(НомерПорта, "ЧГ=0; ЧН=0"));
КонецФункции

// Порт хаба.
//
// Возвращаемое значение:
//  Число - номер порта.
//
Функция Порт() Экспорт
	Возврат НомерПорта;
КонецФункции

// Выполняет запрос с текстовым телом.
//
// Параметры:
//  Метод - Строка - HTTP-метод.
//  Путь - Строка - путь запроса, начиная со слэша.
//  Тело - Строка - тело запроса (необязательный, по умолчанию пустое).
//  Заголовки - Соответствие - заголовки запроса (необязательный, по умолчанию без них).
//
// Возвращаемое значение:
//  Структура - Код (Число), Тело (Строка), Заголовки (Соответствие), Метод, Путь.
//
Функция Запрос(Знач Метод, Знач Путь, Знач Тело = "", Знач Заголовки = Неопределено) Экспорт

	ЗапросHTTP = Новый HTTPЗапрос(Путь, ?(Заголовки = Неопределено, Новый Соответствие(), Заголовки));
	Если ЗначениеЗаполнено(Тело) Тогда
		ЗапросHTTP.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	КонецЕсли;

	Возврат Выполнить_(Метод, Путь, ЗапросHTTP);

КонецФункции

// Выполняет запрос с сырым бинарным телом — форма публикации .ospx.
//
// Параметры:
//  Метод - Строка - HTTP-метод.
//  Путь - Строка - путь запроса, начиная со слэша.
//  Данные - ДвоичныеДанные - тело запроса.
//  Заголовки - Соответствие - заголовки запроса.
//
// Возвращаемое значение:
//  Структура - Код (Число), Тело (Строка), Заголовки (Соответствие), Метод, Путь.
//
Функция ЗапросБайтами(Знач Метод, Знач Путь, Знач Данные, Знач Заголовки) Экспорт

	ЗапросHTTP = Новый HTTPЗапрос(Путь, ?(Заголовки = Неопределено, Новый Соответствие(), Заголовки));
	ЗапросHTTP.УстановитьТелоИзДвоичныхДанных(Данные);

	Возврат Выполнить_(Метод, Путь, ЗапросHTTP);

КонецФункции

// Скачивает файл: возвращает код ответа и размер полученного тела.
// Заголовков валидации кэша не шлёт — иначе хаб ответил бы 304 и скачивание не зачлось бы.
//
// Параметры:
//  Путь - Строка - путь запроса, начиная со слэша.
//  Заголовки - Соответствие - заголовки запроса (необязательный, по умолчанию без них).
//
// Возвращаемое значение:
//  Структура - Код (Число), Размер (Число).
//
Функция Скачать(Знач Путь, Знач Заголовки = Неопределено) Экспорт

	ЗапросHTTP = Новый HTTPЗапрос(Путь, ?(Заголовки = Неопределено, Новый Соответствие(), Заголовки));
	Ответ = Соединение().Получить(ЗапросHTTP);

	Результат = Новый Структура();
	Результат.Вставить("Код", Ответ.КодСостояния);
	Результат.Вставить("Размер", Ответ.ПолучитьТелоКакДвоичныеДанные().Размер());
	Возврат Результат;

КонецФункции

// Разбирает тело ответа как JSON.
//
// Параметры:
//  Ответ - Структура - результат Запрос либо ЗапросБайтами.
//
// Возвращаемое значение:
//  Соответствие, Массив, Неопределено - разобранное тело; Неопределено на нечитаемом теле.
//
Функция Данные(Знач Ответ) Экспорт

	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(Ответ.Тело);
		Результат = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Значение куки сессии из заголовков ответа.
//
// Параметры:
//  Ответ - Структура - результат Запрос.
//  ИмяКуки - Строка - имя куки (необязательный, по умолчанию oshub_session).
//
// Возвращаемое значение:
//  Строка - значение куки либо пустая строка.
//
Функция КукаСессии(Знач Ответ, Знач ИмяКуки = "oshub_session") Экспорт

	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) <> "SET-COOKIE" Тогда
			Продолжить;
		КонецЕсли;
		Значение = ЗначениеКуки(Строка(КиЗ.Значение), ИмяКуки);
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Соединение()
	Возврат Новый HTTPСоединение(Хост, НомерПорта, , , , ТаймаутСек);
КонецФункции

// winow не различает метод роутером, но HTTPСоединение зовёт его по-разному:
// POST — ОтправитьДляОбработки, PUT — Записать, остальное — ВызватьHTTPМетод.
Функция Выполнить_(Знач Метод, Знач Путь, Знач ЗапросHTTP)

	Соед = Соединение();
	Норм = ВРег(СокрЛП(Строка(Метод)));

	Если Норм = "GET" Тогда
		Ответ = Соед.Получить(ЗапросHTTP);
	ИначеЕсли Норм = "POST" Тогда
		Ответ = Соед.ОтправитьДляОбработки(ЗапросHTTP);
	ИначеЕсли Норм = "PUT" Тогда
		Ответ = Соед.Записать(ЗапросHTTP);
	Иначе
		Ответ = Соед.ВызватьHTTPМетод(Норм, ЗапросHTTP);
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("Код", Ответ.КодСостояния);
	Результат.Вставить("Тело", Ответ.ПолучитьТелоКакСтроку());
	Результат.Вставить("Заголовки", Ответ.Заголовки);
	Результат.Вставить("Метод", Норм);
	Результат.Вставить("Путь", Путь);
	Возврат Результат;

КонецФункции

Функция ЗначениеКуки(Знач СтрокаКук, Знач ИмяКуки)

	Маркер = ИмяКуки + "=";
	Поз = СтрНайти(СтрокаКук, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(СтрокаКук, Поз + СтрДлина(Маркер));
	Конец = СтрДлина(Остаток) + 1;
	ТочкаЗпт = СтрНайти(Остаток, ";");
	Если ТочкаЗпт > 0 И ТочкаЗпт < Конец Тогда
		Конец = ТочкаЗпт;
	КонецЕсли;

	Возврат СокрЛП(Лев(Остаток, Конец - 1));

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач Хост_, Знач Порт_, Знач Таймаут_ = 60) Экспорт
	Хост = Хост_;
	НомерПорта = Порт_;
	ТаймаутСек = Таймаут_;
КонецПроцедуры
