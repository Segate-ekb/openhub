            "renameByName": {
              "span_name": "Маршрут",
              "http_response_status_code": "Код ответа",
              "Value": "Запросов"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
