      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (code_namespace, code_function_name, result) (rate({__name__=~\".+_counted_total\", service_name=\"$service\"}[5m]))",
          "legendFormat": "{{code_namespace}}.{{code_function_name}} — {{result}}",
          "range": true
        }
      ]
