// Распаковка openhub-<версия>.ospx в каталог: содержимое content.zip кладётся как есть.
// Нужна сборке образа — opm внутри базового образа для этого не поднимается.

Функция ПутьИзАргументов(Знач Номер, Знач Назначение)

	Аргументы = АргументыКоманднойСтроки;
	Если Аргументы.Количество() <= Номер Тогда
		ВызватьИсключение СтрШаблон(
			"Не задан %1. Использование: oscript scripts/РаспаковатьПакет.os <пакет.ospx> <каталог>",
			Назначение);
	КонецЕсли;

	Возврат Аргументы[Номер];

КонецФункции

Процедура ИзвлечьАрхив(Знач ПутьАрхива, Знач Каталог)

	Архив = Новый ЧтениеZipФайла(ПутьАрхива);
	Архив.ИзвлечьВсе(Каталог, РежимВосстановленияПутейФайловZIP.Восстанавливать);
	Архив.Закрыть();

КонецПроцедуры

Попытка

	ФайлПакета = Новый Файл(ПутьИзАргументов(0, "путь к пакету"));
	КаталогНазначения = Новый Файл(ПутьИзАргументов(1, "каталог назначения"));

	Если НЕ ФайлПакета.Существует() Тогда
		ВызватьИсключение СтрШаблон("Пакет не найден: %1", ФайлПакета.ПолноеИмя);
	КонецЕсли;

	ВременныйКаталог = ОбъединитьПути(КаталогВременныхФайлов(),
		"openhub-пакет-" + Строка(Новый УникальныйИдентификатор()));
	СоздатьКаталог(ВременныйКаталог);

	ИзвлечьАрхив(ФайлПакета.ПолноеИмя, ВременныйКаталог);

	ФайлСодержимого = Новый Файл(ОбъединитьПути(ВременныйКаталог, "content.zip"));
	Если НЕ ФайлСодержимого.Существует() Тогда
		ВызватьИсключение СтрШаблон("В пакете нет content.zip: %1", ФайлПакета.ПолноеИмя);
	КонецЕсли;

	СоздатьКаталог(КаталогНазначения.ПолноеИмя);
	ИзвлечьАрхив(ФайлСодержимого.ПолноеИмя, КаталогНазначения.ПолноеИмя);

	УдалитьФайлы(ВременныйКаталог);

	Сообщить(СтрШаблон("Пакет %1 распакован в %2", ФайлПакета.Имя, КаталогНазначения.ПолноеИмя));

Исключение

	Сообщить(ОписаниеОшибки());
	ЗавершитьРаботу(1);

КонецПопытки;
