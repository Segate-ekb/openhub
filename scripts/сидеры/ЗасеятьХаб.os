// Сидер хаба для HTTP-интеграционных тестов web-ui: запускается отдельным процессом
// до старта хаба и наполняет ту же БД и хранилище. Конфигурация — переменными OSHUB_*.

#Использовать autumn
#Использовать autumn-logos
#Использовать autumn-data
#Использовать entity
#Использовать ospx-tools

Функция ИзОкружения(Знач Имя, Знач ПоУмолчанию)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ПоУмолчанию);
КонецФункции

Процедура ЗаписатьЛог(Знач Текст)
	Путь = ПолучитьПеременнуюСреды("OSHUB_SEED_LOG");
	Если ЗначениеЗаполнено(Путь) Тогда
		Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
		Запись.Записать(Текст);
		Запись.Закрыть();
	КонецЕсли;
КонецПроцедуры

Процедура ПодключитьКлассыКаталога(Знач Каталог)
	Для Каждого Ф Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
		Если НЕ ТипЗарегистрирован(Ф.ИмяБезРасширения) Тогда
			ПодключитьСценарий(Ф.ПолноеИмя, Ф.ИмяБезРасширения);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Процедура Засеять()

КаталогСценария = Новый Файл(ТекущийСценарий().Источник).Путь;
КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогСценария, "..", "..")).ПолноеИмя;
КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

// Классы берутся ВСЕМ каталогом приложений, как их берёт winow на старте хаба: сидер
// не знает раскладки, и переезд модуля его не задевает.
ПодключитьКлассыКаталога(КаталогМодулей);
ПодключитьСценарий(ОбъединитьПути(КаталогПроекта, "tests", "фикстуры", "ФикстураПакета.os"), "ФикстураПакета");

КореньХранилища = Новый Файл(ИзОкружения("OSHUB_STORAGE_ROOT", "./data")).ПолноеИмя;

Детальки = Новый Соответствие();
Детальки.Вставить("oshub.storage.root", КореньХранилища);

ИсточникДанных = Новый Соответствие();
ИсточникДанных.Вставить("ТипКоннектора", ИзОкружения("OSHUB_DB_CONNECTOR", "КоннекторJSON"));
ИсточникДанных.Вставить("СтрокаСоединения", ИзОкружения("OSHUB_DB_CONNECTION", ОбъединитьПути(КореньХранилища, "db")));
// Ключ гранулярный, не карта "data": иначе корневой autumn-properties.json перебьёт его.
Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

Совет = Новый СоветДругогоМастера();
Совет.ЗначенияДеталек(Детальки);
Поделка = Новый Поделка(Совет);
Поделка.ЗапуститьПриложение();

СервисПулов = Поделка.НайтиЖелудь("СервисПулов");
СервисПакетов = Поделка.НайтиЖелудь("СервисПакетов");
СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");
ХранилищеАртефактов = Поделка.НайтиЖелудь("ХранилищеАртефактов");
ХранилищеЗависимостей = Поделка.НайтиЖелудь("ХранилищеЗависимостей");
Фикстура = Новый ФикстураПакета();

// Владелец хаба: без единого пользователя ГвардОнбординга увёл бы страницы на /setup.
// ИСКЛЮЧЕНИЕ из «единственной точки смены активности»: учётка заводится БЕЗ пароля и без
// внешней личности — доменная точка такую активной не сделает и будет права. Стенду она
// нужна лишь как отметка «хаб инициализирован», войти ею нельзя и не нужно; признак
// не меняется, а ставится при рождении записи.
ХранилищеПользователей = Поделка.НайтиЖелудь("ХранилищеПользователей");
Владелец = ХранилищеПользователей.СоздатьЭлемент();
Владелец.Логин = "seed-owner";
Владелец.Email = "";
Владелец.EmailПодтверждён = Ложь;
Владелец.ХешПароля = "";
Владелец.Активен = Истина;
Владелец.РольХаба = "admin";
Владелец.ТребуетсяСменаПароля = Ложь;
Владелец.Создан = ТекущаяУниверсальнаяДата();
Владелец.Сохранить();

// Пользователь с настоящим паролем: интеграционные тесты входят им в кабинет.
СервисПользователей = Поделка.НайтиЖелудь("СервисПользователей");
СервисПользователей.СоздатьПользователя("seed-user", "seed-user@ex.com", "SeedPassw0rd", "user");
// Участник приватного пула и админ хаба — обе стороны отбора обратного графа зависимостей.
Инсайдер = СервисПользователей.СоздатьПользователя("seed-insider", "seed-insider@ex.com",
	"SeedPassw0rd", "user");
СервисПользователей.СоздатьПользователя("seed-admin", "seed-admin@ex.com", "SeedPassw0rd", "admin");


Пул = СервисПулов.СоздатьПул("main", "custom");

Winow = СервисПакетов.ЗарегистрироватьПакет(Пул.Идентификатор, "winow",
	Новый Структура("Описание, Лицензия, АдресРепозитория",
		"Веб-фреймворк для OneScript", "MIT", "https://github.com/autumn-library/winow"));

Autumn = СервисПакетов.ЗарегистрироватьПакет(Пул.Идентификатор, "autumn",
	Новый Структура("Описание", "DI-контейнер ОСень"));

// версии winow: 1.0.0 и последняя 1.1.0
СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Winow.Идентификатор, "1.0.0"));

ЗаявкаПоследней = Новый ЗаявкаНаПубликацию(Winow.Идентификатор, "1.1.0");
ЗаявкаПоследней.АвторМанифеста = "autumn-library";
ЗаявкаПоследней.Размер = 4096;
ЗаявкаПоследней.Sha256 = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
// приехала доверенной публикацией: витрина показывает на ней значок, соседние версии — без
ЗаявкаПоследней.ДовереннаяПубликация = Истина;
ВерсияПоследняя = СервисВерсий.Опубликовать(ЗаявкаПоследней);

СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Autumn.Идентификатор, "4.3.13"));

// зависимость: winow 1.1.0 зависит от autumn, и в манифесте имя написано С ЗАГЛАВНОЙ —
// так же, как это делают живые packagedef. В адресе регистр не значим, значит и обратный
// граф autumn обязан показать winow: засев ловит канонизацию имени зависимости.
ХранилищеЗависимостей.Записать(ВерсияПоследняя.Идентификатор, "Autumn", "4.0.0");

// Приватный контур: пакет закрытого пула зависит от публичного autumn. На публичной
// странице autumn обратный граф не имеет права называть ни пакет, ни его пул.
ПулЗакрытый = СервисПулов.СоздатьПул("vault9", "custom", "private");

ХранилищеУчастниковПула = Поделка.НайтиЖелудь("ХранилищеУчастниковПула");
УчастникЗакрытого = ХранилищеУчастниковПула.СоздатьЭлемент();
УчастникЗакрытого.ПулИдентификатор = ПулЗакрытый.Идентификатор;
УчастникЗакрытого.ТипСубъекта = "пользователь";
УчастникЗакрытого.СубъектИдентификатор = Инсайдер.Идентификатор;
УчастникЗакрытого.Роль = "читатель";
УчастникЗакрытого.Сохранить();

Скрытый = СервисПакетов.ЗарегистрироватьПакет(ПулЗакрытый.Идентификатор, "hushlib",
	Новый Структура("Описание", "Пакет приватного пула, зависящий от публичного autumn"));
ВерсияСкрытого = СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Скрытый.Идентификатор, "1.0.0"));

ХранилищеЗависимостей.Записать(ВерсияСкрытого.Идентификатор, "autumn", "4.0.0");

// victim: вредоносный АдресРепозитория пишем мимо санитизации СервисПакетов —
// проверяется защита на слое вывода (ЭкранированиеHTML.Ссылка фильтрует схему URL).
ХранилищеПакетов = Поделка.НайтиЖелудь("ХранилищеПакетов");
Victim = ХранилищеПакетов.СоздатьЭлемент();
Victim.ПулИдентификатор = Пул.Идентификатор;
Victim.Имя = "victim";
Victim.ИмяНижнийРегистр = "victim";
Victim.Описание = "пакет со вредоносным URL репозитория";
Victim.КлючевыеСлова = "";
Victim.АдресРепозитория = "javascript:alert('REPO')";
Victim.Лицензия = "";
Victim.Устарел = Ложь;
Victim.Скрыт = Ложь;
Victim.Создан = ТекущаяУниверсальнаяДата();
Victim.Сохранить();
СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Victim.Идентификатор, "1.0.0"));

// Базовые теги заводим явно: сид пишет версии мимо СервисаПубликации, поэтому
// подписчик публикации не срабатывает. VICTIM намеренно остаётся БЕЗ тегов —
// страница пакета без каналов обязана показать плоский список версий.
СервисТегов = Поделка.НайтиЖелудь("СервисТегов");
ПакетыСида = Новый Массив();
ПакетыСида.Добавить(Winow);
ПакетыСида.Добавить(Autumn);
Для Каждого ПакетСида Из ПакетыСида Цикл
	СервисТегов.ОбеспечитьБазовыеТеги(ПакетСида.Идентификатор);
КонецЦикла;

// артефакт winow 1.1.0 с README, содержащим XSS

КаталогСборки = ОбъединитьПути(КаталогВременныхФайлов(), "seed-ospx-" + Лев(Строка(Новый УникальныйИдентификатор()), 8));
СоздатьКаталог(КаталогСборки);
ПутьOspx = Фикстура.ПостроитьOspx(КаталогСборки, "winow", "1.1.0", Фикстура.ВредоносныйREADME());
ХранилищеАртефактов.Сохранить(Новый КоординатыАртефакта("main", "winow", "1.1.0"), ПутьOspx);

КонецПроцедуры

Попытка
	Засеять();
	Сообщить("SEED-OK");
Исключение
	ЗаписатьЛог(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	ВызватьИсключение;
КонецПопытки;
