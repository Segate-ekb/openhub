// Сидер хаба для HTTP-тестов раздела «Пулы» дома «Хаб»: админ, обычные учётки,
// отключённая учётка и личное пространство с пакетом, версией и файлом артефакта.
// Запускается отдельным процессом до старта хаба и наполняет ту же БД.

#Использовать autumn
#Использовать autumn-logos
#Использовать autumn-data
#Использовать entity
#Использовать pwhash

Функция ИзОкружения(Знач Имя, Знач ПоУмолчанию)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ПоУмолчанию);
КонецФункции

Процедура ЗаписатьЛог(Знач Текст)
	Путь = ПолучитьПеременнуюСреды("OSHUB_SEED_LOG");
	Если ЗначениеЗаполнено(Путь) Тогда
		Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
		Запись.Записать(Текст);
		Запись.Закрыть();
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Подключает классы каталога, пропуская контроллеры (им нужен winow).
Процедура ПодключитьСервисы(Знач Каталог)
	Для Каждого Ф Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
		Если СтрНачинаетсяС(Ф.ИмяБезРасширения, "Контроллер") Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ТипЗарегистрирован(Ф.ИмяБезРасширения) Тогда
			ПодключитьСценарий(Ф.ПолноеИмя, Ф.ИмяБезРасширения);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура Засеять()

	КаталогСценария = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогСценария, "..", "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	// Классы берутся ВСЕМ каталогом приложений, как их берёт winow на старте хаба: сидер
	// не знает раскладки, и переезд модуля его не задевает.
	ПодключитьСервисы(Модули);

	КореньХранилища = Новый Файл(ИзОкружения("OSHUB_STORAGE_ROOT", "./data")).ПолноеИмя;

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", ИзОкружения("OSHUB_DB_CONNECTOR", "КоннекторJSON"));
	ИсточникДанных.Вставить("СтрокаСоединения", ИзОкружения("OSHUB_DB_CONNECTION", ОбъединитьПути(КореньХранилища, "db")));
	// Ключ гранулярный, не карта "data": иначе корневой autumn-properties.json перебьёт его.
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	СервисПользователей = Поделка.НайтиЖелудь("СервисПользователей");
	СервисПулов = Поделка.НайтиЖелудь("СервисПулов");
	СервисПакетов = Поделка.НайтиЖелудь("СервисПакетов");
	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");
	Хранилище = Поделка.НайтиЖелудь("ХранилищеАртефактов");

	Рут = СервисПользователей.СоздатьПользователя("root", "root@ex.com", "RootPassw0rd", "admin");
	Anna = СервисПользователей.СоздатьПользователя("anna", "anna@ex.com", "AnnaPassw0rd", "user");
	СервисПользователей.СоздатьПользователя("boris", "boris@ex.com", "BorisPassw0rd", "user");

	// отключённая учётка: включение настройки обязано её пропустить. Заводится активной
	// (личное пространство ей нужно), а закрывается доменной точкой — той же, что и
	// кнопка «Заблокировать» в кабинете, а не записью признака в обход неё
	Сон = СервисПользователей.СоздатьПользователя("sleeper", "sleeper@ex.com", "SleepPassw0rd", "user");
	Поделка.НайтиЖелудь("СервисАктивностиУчёток").УстановитьАктивность(Рут, Сон, Ложь);

	// обычный пул с пакетом — контроль «каскад личных пространств его не трогает»
	Общий = СервисПулов.СоздатьПул("shared", "custom", "public");
	ОбщийПакет = СервисПакетов.ЗарегистрироватьПакет(Общий.Идентификатор, "shared-lib",
		Новый Структура("Описание, Лицензия", "Пакет общего пула", "MIT"));
	Опубликовать(СервисВерсий, Хранилище, КореньХранилища, ОбщийПакет.Идентификатор,
		"shared", "shared-lib", "1.0.0", 0);

	// личное пространство anna с пакетом и файлом артефакта
	Личный = СервисПулов.НайтиПул("anna");
	АннинПакет = СервисПакетов.ЗарегистрироватьПакет(Личный.Идентификатор, "anna-lib",
		Новый Структура("Описание, Лицензия", "Пакет личного пространства", "MIT"));
	Опубликовать(СервисВерсий, Хранилище, КореньХранилища, АннинПакет.Идентификатор,
		"anna", "anna-lib", "1.0.0", Anna.Идентификатор);
	Опубликовать(СервисВерсий, Хранилище, КореньХранилища, АннинПакет.Идентификатор,
		"anna", "anna-lib", "1.1.0", Anna.Идентификатор);

КонецПроцедуры

Процедура Опубликовать(Знач СервисВерсий, Знач Хранилище, Знач Корень, Знач ПакетИд,
	Знач ИмяПула, Знач ИмяПакета, Знач Версия, Знач АвторИд)

	Источник = ОбъединитьПути(Корень, "сид-" + ИмяПакета + "-" + Версия + ".ospx");
	Запись = Новый ЗаписьТекста(Источник, КодировкаТекста.UTF8);
	Запись.Записать("артефакт " + ИмяПакета + " " + Версия);
	Запись.Закрыть();

	Итог = Хранилище.Сохранить(Новый КоординатыАртефакта(ИмяПула, ИмяПакета, Версия), Источник);
	УдалитьФайлы(Источник);

	Заявка = Новый ЗаявкаНаПубликацию(ПакетИд, Версия);
	Заявка.Размер = Итог.Размер;
	Заявка.Sha256 = Итог.Sha256;
	Заявка.АвторМанифеста = ИмяПула;
	Заявка.ОпубликовалИдентификатор = АвторИд;
	Заявка.ПутьВХранилище = СтрШаблон("pools/%1/%2/%2-%3.ospx", ИмяПула, ИмяПакета, Версия);
	СервисВерсий.Опубликовать(Заявка);

КонецПроцедуры

Попытка
	Засеять();
	Сообщить("SEED-OK");
Исключение
	ЗаписатьЛог(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	ВызватьИсключение;
КонецПопытки;
