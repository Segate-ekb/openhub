// Сидер сводки кабинета «/me» после ЗасеятьКабинет.os: учётки, пулы, ключи и зеркала сводки.
// Из засева ЗасеятьКабинет трогает одно: у root появляется во владении чужой пул usurped.

#Использовать autumn
#Использовать autumn-logos
#Использовать autumn-data
#Использовать entity
#Использовать pwhash

Перем Поделка;
Перем СервисПользователей;
Перем СервисПулов;
Перем СервисПакетов;
Перем СервисВерсий;

Процедура ЗаписатьЛог(Знач Текст)
	Путь = ПолучитьПеременнуюСреды("OSHUB_SEED_LOG");
	Если ЗначениеЗаполнено(Путь) Тогда
		Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
		Запись.Записать(Текст);
		Запись.Закрыть();
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Подключает классы каталога, пропуская контроллеры (им нужен winow).
Процедура ПодключитьСервисы(Знач Каталог)
	Для Каждого Ф Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
		Если СтрНачинаетсяС(Ф.ИмяБезРасширения, "Контроллер") Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ТипЗарегистрирован(Ф.ИмяБезРасширения) Тогда
			ПодключитьСценарий(Ф.ПолноеИмя, Ф.ИмяБезРасширения);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура СобратьПоделку()

	КаталогСценария = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогСценария, "..", "..")).ПолноеИмя;
	ПодключитьСервисы(ОбъединитьПути(КаталогПроекта, "src", "модули"));

	// та же дверь, что у хаба: сидер видит ту же базу и то же хранилище
	Загрузка = Новый ЗагрузкаНастроек();
	Совет = Загрузка.Совет();
	Загрузка.НапечататьЗамечанияИСведения();
	Загрузка.СоздатьКаталогиДанных();
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	СервисПользователей = Поделка.НайтиЖелудь("СервисПользователей");
	СервисПулов = Поделка.НайтиЖелудь("СервисПулов");
	СервисПакетов = Поделка.НайтиЖелудь("СервисПакетов");
	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");

КонецПроцедуры

Процедура Засеять()

	СобратьПоделку();

	Корень = СервисПользователей.НайтиПоЛогину("root");
	Если Корень = Неопределено Тогда
		ВызватьИсключение "Учётки root нет: ЗасеятьСводкуКабинета.os запускается после ЗасеятьКабинет.os.";
	КонецЕсли;

	Автор = Учётка("author", "author@ex.com", "AuthorPassw0rd");
	Учётка("newbie", "newbie@ex.com", "NewbiePassw0rd");
	Ключник = Учётка("keyman", "keyman@ex.com", "KeymanPassw0rd");
	Зеркальщик = Учётка("mirrorman", "mirror@ex.com", "MirrorPassw0rd");
	Райтер = Учётка("penman", "penman@ex.com", "PenmanPassw0rd");
	Одиночка = Учётка("solo", "solo@ex.com", "SoloPassw0rd");
	Писарь = Учётка("scribe", "scribe@ex.com", "ScribePassw0rd");

	ЗасеятьПакетыАвтора(Автор);
	ЗасеятьКлючи(Ключник);
	ЗасеятьЗеркала(Зеркальщик, Райтер);
	ЗасеятьРайтераЧужогоПула(Писарь);
	ЗасеятьОдиночку(Одиночка);
	ИспортитьЛичныеПространства(Корень);

КонецПроцедуры

// Восемь пакетов одного автора с РАЗНЫМИ датами публикации: сводка показывает шесть свежих
// и хвост «и ещё 2». Дата проставляется записью — служба публикации ставит «сейчас».
Процедура ЗасеятьПакетыАвтора(Знач Автор)

	Пул = СервисПулов.СоздатьПул("team", "custom", "public");
	НазначитьРольНаПуле(Пул, Автор, "мейнтейнер");

	ХранилищеВерсий = Поделка.НайтиЖелудь("ХранилищеВерсийПакета");
	Сейчас = ТекущаяУниверсальнаяДата();

	Для Номер = 1 По 8 Цикл

		Имя = СтрШаблон("sum-pkg-%1", Формат(Номер, "ЧГ=0"));
		Пакет = Пакет(Пул, Имя, СтрШаблон("Пакет номер %1", Номер));
		Опубликовать(Пакет, СтрШаблон("1.%1.0", Номер), Автор);

		// чем больше номер, тем свежее публикация: sum-pkg-8 обязан встать первым
		Опубликована = Сейчас - (9 - Номер) * 24 * 60 * 60;

		Для Каждого Версия Из ХранилищеВерсий.ПолучитьПоПакетИдентификаторРавно(Пакет.Идентификатор) Цикл
			Версия.Опубликована = Опубликована;
			Версия.Сохранить();
		КонецЦикла;

		// свежесть сводка берёт у пакета, а служба публикации ставит ему «сейчас» — одно на все восемь
		Свежесть = СервисПакетов.НайтиПакет(Пул.Идентификатор, Имя);
		Свежесть.ПоследняяПубликация = Опубликована;
		Свежесть.Сохранить();

	КонецЦикла;

КонецПроцедуры

// Ключи одного владельца по обе стороны порога 14 суток, включая обе его границы: к моменту
// запроса «сейчас» уже сдвинулось, поэтому 14 гарантированно внутри окна, а 15 — снаружи.
Процедура ЗасеятьКлючи(Знач Владелец)

	Сейчас = ТекущаяУниверсальнаяДата();
	Сутки = 24 * 60 * 60;

	ЗаписатьКлюч(Владелец, "ключ-истёкший", Сейчас - 2 * Сутки);
	// «истекает ровно сейчас»: к запросу момент уже позади, и ключ обязан числиться истёкшим
	ЗаписатьКлюч(Владелец, "ключ-ровно-сейчас", Сейчас);
	ЗаписатьКлюч(Владелец, "ключ-на-исходе", Сейчас + 3 * Сутки);
	ЗаписатьКлюч(Владелец, "ключ-граница-14", Сейчас + 14 * Сутки);
	ЗаписатьКлюч(Владелец, "ключ-граница-15", Сейчас + 15 * Сутки);
	ЗаписатьКлюч(Владелец, "ключ-бессрочный", Неопределено);
	// ключ без имени: строка обязана назваться заглушкой, а не пустой ячейкой
	ЗаписатьКлюч(Владелец, "", Сейчас + Сутки);

КонецПроцедуры

Процедура ЗаписатьКлюч(Знач Владелец, Знач Имя, Знач Истекает)

	Ключ = Поделка.НайтиЖелудь("ХранилищеТокенов").СоздатьЭлемент();
	Ключ.ПользовательИдентификатор = Владелец.Идентификатор;
	Ключ.Права = "read";
	Ключ.Имя = Имя;
	Ключ.ПулИдентификатор = 0;
	Ключ.Создан = ТекущаяУниверсальнаяДата();
	Если Истекает <> Неопределено Тогда
		Ключ.Истекает = Истекает;
	КонецЕсли;
	Ключ.Сохранить();

	Ключ.Префикс = СтрШаблон("oshub_%1", Ключ.Идентификатор);
	Ключ.Хеш = Sha256Hex(Имя + Строка(Ключ.Идентификатор));
	Ключ.Сохранить();

КонецПроцедуры

// Два зеркала одного пула: упавшее и ни разу не синхронизированное; живой апстрим не нужен —
// нужна запись прогона. Райтеру того же пула зеркала не принадлежат.
Процедура ЗасеятьЗеркала(Знач Владелец, Знач Райтер)

	Пул = СервисПулов.СоздатьПул("replica", "custom", "public");
	НазначитьРольНаПуле(Пул, Владелец, "мейнтейнер");
	НазначитьРольНаПуле(Пул, Райтер, "райтер");

	Упавшее = ЗаготовкаЗеркала(Пул, "https://upstream.example/download/");
	Упавшее.ПоследнийСинк = ТекущаяУниверсальнаяДата() - 3600;
	Упавшее.СостояниеПрогона = "ошибка";
	Упавшее.Статус = "апстрим не отвечает";
	Упавшее.Сохранить();

	// без единого синка: ПоследнийСинк не заполняется — в этом весь смысл записи
	ЗаготовкаЗеркала(Пул, "https://untouched.example/download/").Сохранить();

	// пакет делает наблюдаемым то, что пул райтеру принадлежит: иначе «райтер не видит
	// зеркал» проходило бы и у того, у кого прав на пул нет вовсе
	Опубликовать(Пакет(Пул, "replica-pkg", "Пакет пула репликации"), "1.0.0", Владелец);

КонецПроцедуры

Функция ЗаготовкаЗеркала(Знач Пул, Знач Апстрим)

	Зеркало = Поделка.НайтиЖелудь("ХранилищеЗеркалХабов").СоздатьЭлемент();
	Зеркало.ПулНазначенияИдентификатор = Пул.Идентификатор;
	Зеркало.АпстримURL = Апстрим;
	Зеркало.Режим = "opm";
	Зеркало.ИнтервалСинкаСек = 3600;
	Зеркало.Включено = Истина;
	Зеркало.Создан = ТекущаяУниверсальнаяДата();
	Возврат Зеркало;

КонецФункции

// Одиночка: опубликованный пакет и пакет без единой публикации в личном пространстве
// без ограничения по месту.
Процедура ЗасеятьОдиночку(Знач Владелец)

	Пространство = СервисПулов.НайтиПул(Владелец.Логин);
	СервисПулов.УстановитьКвоту(Пространство.Идентификатор, 0);

	Опубликовать(Пакет(Пространство, "solo-issued", "Пакет с версией"), "2.0.0", Владелец);

	// имя зарезервировано, версий нет ни одной: карточке нечего сказать о выпуске
	Пакет(Пространство, "solo-unreleased", "Пакет без версий");

КонецПроцедуры

// Райтер, которому публиковать некуда, кроме чужого пула replica: личное пространство закрыто.
Процедура ЗасеятьРайтераЧужогоПула(Знач Райтер)

	НазначитьРольНаПуле(СервисПулов.НайтиПул("replica"), Райтер, "райтер");
	СервисПулов.УстановитьПубликациюРазрешена(СервисПулов.НайтиПул(Райтер.Логин).Идентификатор, Ложь);

КонецПроцедуры

// Три способа остаться без личного пространства: имя логина носит чужой по типу пул, пул
// чужого владельца, и пространства нет вовсе.
Процедура ИспортитьЛичныеПространства(Знач Корень)

	// двери смены типа у хаба нет: разжалование — прямой записью пула
	Разжалованное = СервисПулов.НайтиПул(Учётка("demoted", "demoted@ex.com", "DemotedPassw0rd").Логин);
	Разжалованное.Тип = "custom";
	Разжалованное.Сохранить();

	Захваченный = СервисПулов.НайтиПул(Учётка("usurped", "usurped@ex.com", "UsurpedPassw0rd").Логин);
	Захваченный.ВладелецИдентификатор = Корень.Идентификатор;
	Захваченный.Сохранить();

	Бездомный = Учётка("homeless", "homeless@ex.com", "HomelessPassw0rd");
	СервисПулов.УдалитьПул(СервисПулов.НайтиПул(Бездомный.Логин).Идентификатор);

КонецПроцедуры

Функция Учётка(Знач Логин, Знач Почта, Знач Пароль)
	Возврат СервисПользователей.СоздатьПользователя(Логин, Почта, Пароль, "user");
КонецФункции

Функция Пакет(Знач Пул, Знач Имя, Знач Описание)
	Возврат СервисПакетов.ЗарегистрироватьПакет(Пул.Идентификатор, Имя,
		Новый Структура("Описание, Лицензия", Описание, "MIT"));
КонецФункции

Процедура Опубликовать(Знач Пакет, Знач Версия, Знач Автор)

	Заявка = Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, Версия);
	Заявка.Размер = 4096;
	Заявка.Sha256 = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
	Заявка.ОпубликовалИдентификатор = Автор.Идентификатор;
	СервисВерсий.Опубликовать(Заявка);

КонецПроцедуры

// Пресет роли на пуле — запись, которой у продукта нет писателя (см. ЗасеятьКабинет.os).
Процедура НазначитьРольНаПуле(Знач Пул, Знач Субъект, Знач Роль)

	Участник = Поделка.НайтиЖелудь("ХранилищеУчастниковПула").СоздатьЭлемент();
	Участник.ПулИдентификатор = Пул.Идентификатор;
	Участник.ТипСубъекта = "пользователь";
	Участник.СубъектИдентификатор = Субъект.Идентификатор;
	Участник.Роль = Роль;
	Участник.Сохранить();

КонецПроцедуры

Функция Sha256Hex(Знач Значение)
	Хеши = Новый Хеш();
	Возврат Хеши.ОтСтроки(Значение);
КонецФункции

Попытка
	Засеять();
	Сообщить("SEED-OK");
Исключение
	ЗаписатьЛог(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	ВызватьИсключение;
КонецПопытки;
