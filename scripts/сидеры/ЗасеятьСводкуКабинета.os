// Сидер хаба для HTTP-тестов сводки кабинета «/me»: автор с восемью пакетами разной
// свежести, новичок без единого, одиночка с двумя, владелец ключей у границы срока,
// владелец пула с зеркалами и три учётки с испорченным личным пространством.
// Запускается отдельным процессом до старта хаба.

#Использовать autumn
#Использовать autumn-logos
#Использовать autumn-data
#Использовать entity
#Использовать pwhash

Функция ИзОкружения(Знач Имя, Знач ПоУмолчанию)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ПоУмолчанию);
КонецФункции

Процедура ЗаписатьЛог(Знач Текст)
	Путь = ПолучитьПеременнуюСреды("OSHUB_SEED_LOG");
	Если ЗначениеЗаполнено(Путь) Тогда
		Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
		Запись.Записать(Текст);
		Запись.Закрыть();
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Процедура ПодключитьСервисы(Знач Каталог)
	Для Каждого Ф Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
		Если СтрНачинаетсяС(Ф.ИмяБезРасширения, "Контроллер") Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ТипЗарегистрирован(Ф.ИмяБезРасширения) Тогда
			ПодключитьСценарий(Ф.ПолноеИмя, Ф.ИмяБезРасширения);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция СобратьПоделку()

	КаталогСценария = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогСценария, "..", "..")).ПолноеИмя;
	ПодключитьСервисы(ОбъединитьПути(КаталогПроекта, "src", "модули"));

	КореньХранилища = Новый Файл(ИзОкружения("OSHUB_STORAGE_ROOT", "./data")).ПолноеИмя;

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", ИзОкружения("OSHUB_DB_CONNECTOR", "КоннекторJSON"));
	ИсточникДанных.Вставить("СтрокаСоединения",
		ИзОкружения("OSHUB_DB_CONNECTION", ОбъединитьПути(КореньХранилища, "db")));
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();
	Возврат Поделка;

КонецФункции

Процедура Засеять()

	Поделка = СобратьПоделку();

	СервисПользователей = Поделка.НайтиЖелудь("СервисПользователей");
	СервисПулов = Поделка.НайтиЖелудь("СервисПулов");

	Корень = СервисПользователей.СоздатьПользователя("root", "root@ex.com", "RootPassw0rd", "admin");
	Автор = СервисПользователей.СоздатьПользователя("author", "author@ex.com", "AuthorPassw0rd", "user");
	СервисПользователей.СоздатьПользователя("newbie", "newbie@ex.com", "NewbiePassw0rd", "user");
	Ключник = СервисПользователей.СоздатьПользователя("keyman", "keyman@ex.com", "KeymanPassw0rd", "user");
	Зеркальщик = СервисПользователей.СоздатьПользователя("mirrorman", "mirror@ex.com",
		"MirrorPassw0rd", "user");
	Райтер = СервисПользователей.СоздатьПользователя("penman", "penman@ex.com",
		"PenmanPassw0rd", "user");
	Одиночка = СервисПользователей.СоздатьПользователя("solo", "solo@ex.com", "SoloPassw0rd", "user");

	ЗасеятьПакетыАвтора(Поделка, СервисПулов, Автор);
	ЗасеятьКлючи(Поделка, Ключник);
	ЗасеятьЗеркала(Поделка, СервисПулов, Зеркальщик, Райтер);
	ЗасеятьОдиночку(Поделка, СервисПулов, Одиночка);
	ИспортитьЛичныеПространства(СервисПользователей, СервисПулов, Корень);

КонецПроцедуры

// Восемь пакетов одного автора с РАЗНЫМИ датами публикации: сводка показывает первые
// шесть свежих и хвост «и ещё 2». Дата проставляется записью — служба публикации ставит
// «сейчас», и все восемь оказались бы одного возраста.
Процедура ЗасеятьПакетыАвтора(Знач Поделка, Знач СервисПулов, Знач Автор)

	Пул = СервисПулов.СоздатьПул("team", "custom", "public");
	НазначитьРольНаПуле(Поделка, Пул, Автор, "мейнтейнер");

	СервисПакетов = Поделка.НайтиЖелудь("СервисПакетов");
	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");
	ХранилищеВерсий = Поделка.НайтиЖелудь("ХранилищеВерсийПакета");

	Сейчас = ТекущаяУниверсальнаяДата();

	Для Номер = 1 По 8 Цикл

		Имя = СтрШаблон("sum-pkg-%1", Формат(Номер, "ЧГ=0"));
		Пакет = СервисПакетов.ЗарегистрироватьПакет(Пул.Идентификатор, Имя,
			Новый Структура("Описание, Лицензия", СтрШаблон("Пакет номер %1", Номер), "MIT"));

		Заявка = Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, СтрШаблон("1.%1.0", Номер));
		Заявка.Размер = 4096;
		Заявка.Sha256 = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
		Заявка.ОпубликовалИдентификатор = Автор.Идентификатор;
		СервисВерсий.Опубликовать(Заявка);

		// чем больше номер, тем свежее публикация: sum-pkg-8 обязан встать первым
		Для Каждого Версия Из ХранилищеВерсий.ПолучитьПоПакетИдентификаторРавно(Пакет.Идентификатор) Цикл
			Версия.Опубликована = Сейчас - (9 - Номер) * 24 * 60 * 60;
			Версия.Сохранить();
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Ключи одного владельца по обе стороны порога, включая обе его границы. Порог — 14 суток,
// и засев ставит ключи ровно на 14 и на 15: к моменту запроса «сейчас» уже сдвинулось,
// поэтому 14 гарантированно внутри окна, а 15 — гарантированно снаружи.
Процедура ЗасеятьКлючи(Знач Поделка, Знач Владелец)

	Сейчас = ТекущаяУниверсальнаяДата();
	Сутки = 24 * 60 * 60;

	ЗаписатьКлюч(Поделка, Владелец, "ключ-истёкший", Сейчас - 2 * Сутки);
	// «истекает ровно сейчас»: к запросу момент уже позади, и ключ обязан числиться истёкшим
	ЗаписатьКлюч(Поделка, Владелец, "ключ-ровно-сейчас", Сейчас);
	ЗаписатьКлюч(Поделка, Владелец, "ключ-на-исходе", Сейчас + 3 * Сутки);
	ЗаписатьКлюч(Поделка, Владелец, "ключ-граница-14", Сейчас + 14 * Сутки);
	ЗаписатьКлюч(Поделка, Владелец, "ключ-граница-15", Сейчас + 15 * Сутки);
	ЗаписатьКлюч(Поделка, Владелец, "ключ-бессрочный", Неопределено);
	// ключ без имени: строка обязана назваться заглушкой, а не пустой ячейкой
	ЗаписатьКлюч(Поделка, Владелец, "", Сейчас + Сутки);

КонецПроцедуры

Процедура ЗаписатьКлюч(Знач Поделка, Знач Владелец, Знач Имя, Знач Истекает)

	Ключ = Поделка.НайтиЖелудь("ХранилищеТокенов").СоздатьЭлемент();
	Ключ.ПользовательИдентификатор = Владелец.Идентификатор;
	Ключ.Права = "read";
	Ключ.Имя = Имя;
	Ключ.ПулИдентификатор = 0;
	Ключ.Создан = ТекущаяУниверсальнаяДата();
	Если Истекает <> Неопределено Тогда
		Ключ.Истекает = Истекает;
	КонецЕсли;
	Ключ.Сохранить();

	Ключ.Префикс = СтрШаблон("oshub_%1", Ключ.Идентификатор);
	Ключ.Хеш = Sha256Hex(Имя + Строка(Ключ.Идентификатор));
	Ключ.Сохранить();

КонецПроцедуры

// Два зеркала одного пула: упавшее (кабинет обязан назвать состояние и причину словами)
// и ни разу не синхронизированное (момент подменяется заглушкой). Живой апстрим для этого
// не нужен — нужна запись прогона. Райтеру того же пула зеркала не принадлежат: он в пул
// публикует, но не решает, откуда пул наполняется.
Процедура ЗасеятьЗеркала(Знач Поделка, Знач СервисПулов, Знач Владелец, Знач Райтер)

	Пул = СервисПулов.СоздатьПул("replica", "custom", "public");
	НазначитьРольНаПуле(Поделка, Пул, Владелец, "мейнтейнер");
	НазначитьРольНаПуле(Поделка, Пул, Райтер, "райтер");

	Упавшее = ЗаготовкаЗеркала(Поделка, Пул, "https://upstream.example/download/");
	Упавшее.ПоследнийСинк = ТекущаяУниверсальнаяДата() - 3600;
	Упавшее.СостояниеПрогона = "ошибка";
	Упавшее.Статус = "апстрим не отвечает";
	Упавшее.Сохранить();

	// без единого синка: ПоследнийСинк не заполняется — в этом весь смысл записи
	ЗаготовкаЗеркала(Поделка, Пул, "https://untouched.example/download/").Сохранить();

	ЗасеятьПакетРепликации(Поделка, Пул, Владелец);

КонецПроцедуры

// Пакет в пуле репликации: он делает наблюдаемым то, что пул РАЙТЕРУ принадлежит.
// Без него «райтер не видит зеркал» проходило бы и у того, у кого на пул нет никаких
// прав, — то есть не проверяло бы порог вовсе.
Процедура ЗасеятьПакетРепликации(Знач Поделка, Знач Пул, Знач Издатель)

	Пакет = Поделка.НайтиЖелудь("СервисПакетов").ЗарегистрироватьПакет(
		Пул.Идентификатор, "replica-pkg",
		Новый Структура("Описание, Лицензия", "Пакет пула репликации", "MIT"));

	Заявка = Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.0.0");
	Заявка.Размер = 4096;
	Заявка.Sha256 = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
	Заявка.ОпубликовалИдентификатор = Издатель.Идентификатор;
	Поделка.НайтиЖелудь("СервисВерсий").Опубликовать(Заявка);

КонецПроцедуры

Функция ЗаготовкаЗеркала(Знач Поделка, Знач Пул, Знач Апстрим)

	Зеркало = Поделка.НайтиЖелудь("ХранилищеЗеркалХабов").СоздатьЭлемент();
	Зеркало.ПулНазначенияИдентификатор = Пул.Идентификатор;
	Зеркало.АпстримURL = Апстрим;
	Зеркало.Режим = "opm";
	Зеркало.ИнтервалСинкаСек = 3600;
	Зеркало.Включено = Истина;
	Зеркало.Создан = ТекущаяУниверсальнаяДата();
	Возврат Зеркало;

КонецФункции

// Одиночка: один опубликованный пакет и один без единой публикации — в своём личном
// пространстве без ограничения по месту. На его кабинете видно и хвост, которого нет,
// и карточку пакета без версии и даты, и подпись «ограничения нет» вместо полосы.
Процедура ЗасеятьОдиночку(Знач Поделка, Знач СервисПулов, Знач Владелец)

	Пространство = СервисПулов.НайтиПул(Владелец.Логин);
	СервисПулов.УстановитьКвоту(Пространство.Идентификатор, 0);

	СервисПакетов = Поделка.НайтиЖелудь("СервисПакетов");
	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");

	Изданный = СервисПакетов.ЗарегистрироватьПакет(Пространство.Идентификатор, "solo-issued",
		Новый Структура("Описание, Лицензия", "Пакет с версией", "MIT"));

	Заявка = Новый ЗаявкаНаПубликацию(Изданный.Идентификатор, "2.0.0");
	Заявка.Размер = 4096;
	Заявка.Sha256 = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
	Заявка.ОпубликовалИдентификатор = Владелец.Идентификатор;
	СервисВерсий.Опубликовать(Заявка);

	// имя зарезервировано, версий нет ни одной: карточке нечего сказать о выпуске
	СервисПакетов.ЗарегистрироватьПакет(Пространство.Идентификатор, "solo-unreleased",
		Новый Структура("Описание, Лицензия", "Пакет без версий", "MIT"));

КонецПроцедуры

// Три способа остаться без личного пространства: имя логина носит чужой по типу пул,
// имя логина носит пул чужого владельца и пространства нет вовсе. Во всех трёх случаях
// кабинет обязан промолчать, а не рассказывать о чужом пуле.
Процедура ИспортитьЛичныеПространства(Знач СервисПользователей, Знач СервисПулов, Знач Корень)

	Разжалованный = СервисПользователей.СоздатьПользователя("demoted", "demoted@ex.com",
		"DemotedPassw0rd", "user");
	СервисПулов.УстановитьТип(СервисПулов.НайтиПул(Разжалованный.Логин).Идентификатор, "custom");

	Обобранный = СервисПользователей.СоздатьПользователя("usurped", "usurped@ex.com",
		"UsurpedPassw0rd", "user");
	Захваченный = СервисПулов.НайтиПул(Обобранный.Логин);
	Захваченный.ВладелецИдентификатор = Корень.Идентификатор;
	Захваченный.Сохранить();

	Бездомный = СервисПользователей.СоздатьПользователя("homeless", "homeless@ex.com",
		"HomelessPassw0rd", "user");
	СервисПулов.УдалитьПул(СервисПулов.НайтиПул(Бездомный.Логин).Идентификатор);

КонецПроцедуры

// Пресет роли на пуле — запись, которой у продукта нет писателя (см. ЗасеятьКабинет.os).
Процедура НазначитьРольНаПуле(Знач Поделка, Знач Пул, Знач Субъект, Знач Роль)

	Участник = Поделка.НайтиЖелудь("ХранилищеУчастниковПула").СоздатьЭлемент();
	Участник.ПулИдентификатор = Пул.Идентификатор;
	Участник.ТипСубъекта = "пользователь";
	Участник.СубъектИдентификатор = Субъект.Идентификатор;
	Участник.Роль = Роль;
	Участник.Сохранить();

КонецПроцедуры

Функция Sha256Hex(Знач Значение)
	Хеши = Новый Хеш();
	Возврат Хеши.ОтСтроки(Значение);
КонецФункции

Попытка
	Засеять();
	Сообщить("SEED-OK");
Исключение
	ЗаписатьЛог(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	ВызватьИсключение;
КонецПопытки;
