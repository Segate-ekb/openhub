// Засев тестового пакета в ту же БД и хранилище, что использует поднятый хаб.
// Настраивается переменными окружения OSHUB_* (см. ниже); печатает сводку в stdout.

#Использовать autumn
#Использовать autumn-logos
#Использовать autumn-data
#Использовать entity
#Использовать pwhash

Функция ИзОкружения(Знач Имя, Знач ПоУмолчанию)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ПоУмолчанию);
КонецФункции

Процедура ПодключитьКлассыКаталога(Знач КаталогКлассов)
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		Если НЕ ТипЗарегистрирован(ФайлКласса.ИмяБезРасширения) Тогда
			ПодключитьСценарий(ФайлКласса.ПолноеИмя, ФайлКласса.ИмяБезРасширения);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Файл ищется по имени в каталоге и его подкаталогах: путь из имени не строится
// (docs/процесс/РАСКЛАДКА.md).
Процедура ПодключитьОдинКласс(Знач КаталогКлассов, Знач ИмяКласса)
	Если ТипЗарегистрирован(ИмяКласса) Тогда
		Возврат;
	КонецЕсли;
	Найденные = НайтиФайлы(КаталогКлассов, ИмяКласса + ".os", Истина);
	Если Найденные.Количество() <> 1 Тогда
		ВызватьИсключение СтрШаблон("Класс %1 в %2 найден %3 раз(а), ожидался ровно один",
			ИмяКласса, КаталогКлассов, Найденные.Количество());
	КонецЕсли;
	ПодключитьСценарий(Найденные[0].ПолноеИмя, ИмяКласса);
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ФлагВключён(Знач Значение)
	Норм = НРег(СокрЛП(Строка(?(Значение = Неопределено, "", Значение))));
	Возврат Норм = "1" ИЛИ Норм = "true" ИЛИ Норм = "истина" ИЛИ Норм = "да";
КонецФункции

Функция ЧислоИзОкружения(Знач Имя, Знач ПоУмолчанию)
	Попытка
		Возврат Число(ИзОкружения(Имя, Формат(ПоУмолчанию, "ЧГ=0; ЧН=0")));
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
КонецФункции

Функция МножествоИзСписка(Знач Список)
	Множество = Новый Соответствие();
	Для Каждого Элемент Из СтрРазделить(Строка(Список), ",", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Элемент)) Тогда
			Множество.Вставить(СокрЛП(Элемент), Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Множество;
КонецФункции

// Тег, названный номером существующей версии, СервисТегов больше не заводит: имя занято
// версией. Такие каналы остались легаси-данными, и стендам они нужны живыми — на них видно,
// кто выигрывает у одноимённого тега. Строку тега сид пишет сам, тем же обходом, каким
// пишет версии мимо СервисаПубликации.
Процедура ПодложитьТегСтолкновения(Знач Приложение, Знач ПакетИдентификатор, Знач ИмяТега,
	Знач ТипПравила, Знач ЗначениеПравила)

	Ручной = ТипПравила = "pin";
	Режимы = Приложение.НайтиЖелудь("РежимТега");

	Тег = Приложение.НайтиЖелудь("ХранилищеТегов").СоздатьЭлемент();
	Тег.ПакетИдентификатор = ПакетИдентификатор;
	Тег.Имя = НРег(СокрЛП(ИмяТега));
	Тег.Режим = ?(Ручной, Режимы.Ручной(), Режимы.Правило());
	Тег.ТипПравила = ?(Ручной, "", ТипПравила);
	Тег.Правило = ?(Ручной, "", ЗначениеПравила);
	Тег.Стиль = Приложение.НайтиЖелудь("СтильТега").Обычный();
	Тег.Значок = Приложение.НайтиЖелудь("ЗначокТега").Нет();
	Тег.ПоУмолчанию = Ложь;
	Тег.КемИдентификатор = 0;
	Тег.Обновлён = ТекущаяУниверсальнаяДата();
	Тег.Сохранить(); // до метки: идентификатор появляется у сохранённой строки

	Если НЕ Ручной Тогда
		Возврат; // состав тега-правила считается правилом, метить нечего
	КонецЕсли;

	Версия = Приложение.НайтиЖелудь("СервисВерсий").НайтиВерсию(ПакетИдентификатор, ЗначениеПравила);
	Если Версия = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Версия ""%1"" не найдена — тег ставить не на что", ЗначениеПравила);
	КонецЕсли;
	Приложение.НайтиЖелудь("СоставКаналов").ПометитьОдну(Тег, Версия);

КонецПроцедуры


КаталогПроектаЗасева = Новый Файл(ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..", "..")).ПолноеИмя;
КаталогИсходников = ОбъединитьПути(КаталогПроектаЗасева, "src", "модули");

// ⛔ Список модулей здесь — ЧАСТЬ ФИКСТУРЫ, а не забытая раскладка. Остальные три сидера
// берут каталог приложений целиком, и это им ничего не стоит; здесь полный набор классов
// включает подписчиков доменных событий, и засеянная фактура становится другой: краснеют
// ПубликацияPush (карточка, ведённая руками, затирается; отзыв не уводит выдачу на 1.0.0)
// и ПроксиМаршрутВыдачи. Меняешь список — гоняй эти два набора.
ПодключитьКлассыКаталога(ОбъединитьПути(КаталогИсходников, "данные", "Классы"));
// settings: бэкенд хранилища спрашивает потолок объёма у резолвера настроек
ПодключитьКлассыКаталога(ОбъединитьПути(КаталогИсходников, "настройки", "Классы"));
ПодключитьКлассыКаталога(ОбъединитьПути(КаталогИсходников, "хранилище", "Классы"));
// вид объекта в журнале: летописи тегов и версий собирают его желудём
ПодключитьСценарий(ОбъединитьПути(ОбъединитьПути(КаталогИсходников, "аудит", "Классы"),
	"ИмяОбъектаАудита.os"), "ИмяОбъектаАудита");
ПодключитьКлассыКаталога(ОбъединитьПути(КаталогИсходников, "реестр", "Классы"));

// events: core-registry содержит подписчика доменных событий, издатель обязателен
ПодключитьКлассыКаталога(ОбъединитьПути(КаталогИсходников, "события", "Классы"));

// common: без ПриведенияЧисел не поднимается резолвер имён, и DNS-ветка SSRF-гейта
// получает Неопределено вместо разрешителя — падение на первом же адресе апстрима.
ПодключитьКлассыКаталога(ОбъединитьПути(КаталогИсходников, "основа", "Классы"));

// SSRF-гейт апстримов: СервисПулов требует валидатор адреса обязательно (fail-closed).
ПодключитьОдинКласс(ОбъединитьПути(КаталогИсходников, "подписки", "Классы"), "ВалидаторАдресаВебхука");
ПодключитьОдинКласс(ОбъединитьПути(КаталогИсходников, "зеркала", "Классы"), "ВалидаторАдресаАпстрима");
// правило токена доступа к источнику: СервисПулов спрашивает его на каждом апстриме
ПодключитьОдинКласс(ОбъединитьПути(КаталогИсходников, "прокси", "Классы"), "СекретИсточника");

КореньДанных = Новый Файл(ИзОкружения("OSHUB_STORAGE_ROOT", "./data")).ПолноеИмя;
// Дефолт — КоннекторJSON, как в autumn-properties.json.
ТипКоннектора = ИзОкружения("OSHUB_DB_CONNECTOR", "КоннекторJSON");
СтрокаСоединения = ПолучитьПеременнуюСреды("OSHUB_DB_CONNECTION");
Если НЕ ЗначениеЗаполнено(СтрокаСоединения) Тогда
	Если СтрНачинаетсяС(ВРег(ТипКоннектора), ВРег("КоннекторJSON")) Тогда
		СтрокаСоединения = ОбъединитьПути(КореньДанных, "entities");
	Иначе
		СтрокаСоединения = "Data Source=" + ОбъединитьПути(КореньДанных, "db", "openhub.db");
	КонецЕсли;
КонецЕсли;

// SQLite не создаёт каталог файла БД — обеспечиваем его до открытия соединения
КаталогБД = ОбъединитьПути(КореньДанных, "db");
Если НЕ Новый Файл(КаталогБД).Существует() Тогда
	СоздатьКаталог(КаталогБД);
КонецЕсли;

// Файловые коннекторы пишут по файлу на таблицу — каталог должен существовать заранее
Если СтрНачинаетсяС(ВРег(ТипКоннектора), ВРег("КоннекторJSON")) И ЗначениеЗаполнено(СтрокаСоединения)
	И НЕ Новый Файл(СтрокаСоединения).Существует() Тогда
	СоздатьКаталог(СтрокаСоединения);
КонецЕсли;

Детальки = Новый Соответствие();
Детальки.Вставить("oshub.storage.root", КореньДанных);

ИсточникДанных = Новый Соответствие();
ИсточникДанных.Вставить("ТипКоннектора", ТипКоннектора);
ИсточникДанных.Вставить("СтрокаСоединения", СтрокаСоединения);
// Ключ гранулярный, не карта "data": иначе корневой autumn-properties.json перебьёт его.
Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

Совет = Новый СоветДругогоМастера();
Совет.ЗначенияДеталек(Детальки);

Поделка = Новый Поделка(Совет);
Поделка.ЗапуститьПриложение();


СервисПулов = Поделка.НайтиЖелудь("СервисПулов");
СервисПакетов = Поделка.НайтиЖелудь("СервисПакетов");
СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");
Хранилище = Поделка.НайтиЖелудь("ХранилищеАртефактов");

ИмяПула = ИзОкружения("OSHUB_SEED_POOL", "public");
ИмяПакета = ИзОкружения("OSHUB_SEED_PACKAGE", "spike0c-testpkg");
СписокВерсийЗасева = ИзОкружения("OSHUB_SEED_VERSIONS", "1.0.0,1.1.0,1.1.0.7,2.0.0-rc.1");
ОтозванныеМнож = МножествоИзСписка(ПолучитьПеременнуюСреды("OSHUB_SEED_YANKED"));

ПутьФикстуры = ПолучитьПеременнуюСреды("OSHUB_SEED_FIXTURE");
Если НЕ ЗначениеЗаполнено(ПутьФикстуры) ИЛИ НЕ Новый Файл(ПутьФикстуры).Существует() Тогда
	ВызватьИсключение "OSHUB_SEED_FIXTURE не задан или файл не найден: " + Строка(ПутьФикстуры);
КонецЕсли;
БайтыФикстуры = Новый ДвоичныеДанные(ПутьФикстуры);

Пул = СервисПулов.НайтиПул(ИмяПула);
Если Пул = Неопределено Тогда
	Пул = СервисПулов.СоздатьПул(ИмяПула, "custom", ИзОкружения("OSHUB_SEED_VISIBILITY", "public"));
КонецЕсли;

// Апстрим пула засева (OSHUB_SEED_UPSTREAM_URL) — топология «пул с апстримом» для
// стендов и интеграционных наборов. Приватный адрес проходит SSRF-гейт только
// при OSHUB_SEED_UPSTREAM_ALLOW_PRIVATE.
URLАпстрима = СокрЛП(ИзОкружения("OSHUB_SEED_UPSTREAM_URL", ""));
Если ЗначениеЗаполнено(URLАпстрима) Тогда
	СервисПулов.ДобавитьАпстрим(Пул.Идентификатор, URLАпстрима,
		ЧислоИзОкружения("OSHUB_SEED_UPSTREAM_TTL_SEC", 900), "",
		ФлагВключён(ПолучитьПеременнуюСреды("OSHUB_SEED_UPSTREAM_ALLOW_PRIVATE")));
	Сообщить(СтрШаблон("seeded-upstream %1 → %2", Пул.Имя, URLАпстрима));
КонецЕсли;

Пакет = СервисПакетов.НайтиИлиЗарегистрировать(Пул.Идентификатор, ИмяПакета);

Для Каждого СтрокаВерсии Из СтрРазделить(СписокВерсийЗасева, ",", Ложь) Цикл

	СтрокаВерсии = СокрЛП(СтрокаВерсии);
	Если ПустаяСтрока(СтрокаВерсии) Тогда
		Продолжить;
	КонецЕсли;

	// артефакт в хранилище: координаты pools/{пул}/{пакет}/{пакет}-{версия}.ospx
	Координаты = Новый КоординатыАртефакта(Пул.Имя, Пакет.Имя, СтрокаВерсии);
	РезультатСохранения = Хранилище.Сохранить(Координаты, БайтыФикстуры);

	Заявка = Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, СтрокаВерсии);
	Заявка.Размер = РезультатСохранения.Размер;
	Заявка.Sha256 = РезультатСохранения.Sha256;
	Заявка.ПутьВХранилище = СтрШаблон("pools/%1/%2/%3-%4.ospx", Пул.Имя, Пакет.Имя, Пакет.Имя, СтрокаВерсии);

	СозданнаяВерсия = СервисВерсий.Опубликовать(Заявка);

	Если ОтозванныеМнож.Получить(СтрокаВерсии) = Истина Тогда
		СозданнаяВерсия.Отозвана = Истина;
		СозданнаяВерсия.Сохранить();
	КонецЕсли;

	Сообщить(СтрШаблон("seeded %1/%2-%3 sha256=%4 size=%5 yanked=%6",
		Пул.Имя, Пакет.Имя, СтрокаВерсии, РезультатСохранения.Sha256,
		Формат(РезультатСохранения.Размер, "ЧГ=0; ЧН=0"),
		?(ОтозванныеМнож.Получить(СтрокаВерсии) = Истина, "да", "нет")));

КонецЦикла;

// Каналы по умолчанию заводим явно — тем же ядром, каким их заводит визард: сид пишет
// версии мимо СервисаПубликации, и сам хаб каналов не выдумывает.
Поделка.НайтиЖелудь("КаналыПоУмолчанию").Создать(Пакет.Идентификатор);

// Теги пакета из OSHUB_SEED_CHANNELS = "имя|тип|значение;...":
// semver/regex → тег-правило, pin → ручной тег ровно на одной версии; label не поддерживается.
ОпределенияТегов = ПолучитьПеременнуюСреды("OSHUB_SEED_CHANNELS");
Если ЗначениеЗаполнено(ОпределенияТегов) Тогда
	СервисТегов = Поделка.НайтиЖелудь("СервисТегов");
	Для Каждого Запись Из СтрРазделить(ОпределенияТегов, ";", Ложь) Цикл
		Части = СтрРазделить(Запись, "|", Ложь);
		Если Части.Количество() >= 3 Тогда
			ИмяТега = СокрЛП(Части[0]);
			ТипПравила = НРег(СокрЛП(Части[1]));
			ЗначениеПравила = СокрЛП(Части[2]);
			Если СервисТегов.ИмяДляНовогоТегаЗанято(Пакет.Идентификатор, ИмяТега) Тогда
				ПодложитьТегСтолкновения(Поделка, Пакет.Идентификатор, ИмяТега, ТипПравила, ЗначениеПравила);
				Сообщить(СтрШаблон("seeded-collision-tag %1 (%2=%3)", ИмяТега, ТипПравила, ЗначениеПравила));
				Продолжить;
			КонецЕсли;
			Если ТипПравила = "pin" Тогда
				СервисТегов.ПереместитьТег(Пакет.Идентификатор, ИмяТега, ЗначениеПравила);
			Иначе
				СервисТегов.ОпределитьТегПравила(Пакет.Идентификатор, ИмяТега, ТипПравила, ЗначениеПравила);
			КонецЕсли;
			Сообщить(СтрШаблон("seeded-tag %1 (%2=%3)", ИмяТега, ТипПравила, ЗначениеПравила));
		КонецЕсли;
	КонецЦикла;
КонецЕсли;

// НЕ-admin publisher (OSHUB_SEED_PUBLISHER=1): нужен принципал без admin-суперправа.
// Раз в БД появляются пользователи, онбординг пропускается — admin создаём здесь же.
// ИСКЛЮЧЕНИЕ из «единственной точки смены активности»: модуль auth сюда не подключён
// вовсе (сид знает про db, storage, core-registry, events и common), СервисаПользователей
// и доменной точки активности в контейнере нет. Учётка не МЕНЯЕТ признак, а рождается
// с ним — запись собирается целиком, как её собрал бы СервисПользователей.
Если ЗначениеЗаполнено(ПолучитьПеременнуюСреды("OSHUB_SEED_PUBLISHER")) Тогда
	ХранилищеПользователей = Поделка.НайтиЖелудь("ХранилищеПользователей");

	// admin из OSHUB_ADMIN_* (онбординг хаба будет пропущен — юзеры уже есть)
	АдминЛогин = НРег(СокрЛП(ИзОкружения("OSHUB_ADMIN_LOGIN", "root")));
	АдминПароль = ИзОкружения("OSHUB_ADMIN_PASSWORD", "RootPassw0rd");
	Если ЗначениеЗаполнено(АдминЛогин) И ХранилищеПользователей.НайтиПоЛогину(АдминЛогин) = Неопределено Тогда
		Админ = ХранилищеПользователей.СоздатьЭлемент();
		Админ.Логин = АдминЛогин;
		Админ.Email = АдминЛогин + "@ex.com";
		Админ.EmailПодтверждён = Ложь;
		Админ.ХешПароля = ХешированиеПаролей.Захешировать(АдминПароль);
		Админ.Активен = Истина;
		Админ.РольХаба = "admin";
		Админ.ТребуетсяСменаПароля = Ложь;
		Админ.Создан = ТекущаяУниверсальнаяДата();
		Админ.Сохранить();
		Сообщить("seeded-admin " + АдминЛогин);
	КонецЕсли;

	Если ХранилищеПользователей.НайтиПоЛогину("publisher") = Неопределено Тогда
		Публикатор = ХранилищеПользователей.СоздатьЭлемент();
		Публикатор.Логин = "publisher";
		Публикатор.Email = "publisher@ex.com";
		Публикатор.EmailПодтверждён = Ложь;
		Публикатор.ХешПароля = ХешированиеПаролей.Захешировать("PubPassw0rd");
		Публикатор.Активен = Истина;
		Публикатор.РольХаба = "user";
		Публикатор.ТребуетсяСменаПароля = Ложь;
		Публикатор.Создан = ТекущаяУниверсальнаяДата();
		Публикатор.Сохранить();

		ХранилищеУчастниковПула = Поделка.НайтиЖелудь("ХранилищеУчастниковПула");
		Уч = ХранилищеУчастниковПула.СоздатьЭлемент();
		Уч.ПулИдентификатор = Пул.Идентификатор;
		Уч.ТипСубъекта = "пользователь";
		Уч.СубъектИдентификатор = Публикатор.Идентификатор;
		Уч.Роль = "publisher";
		Уч.Сохранить();
		Сообщить("seeded-publisher publisher (publisher-роль на пуле " + Пул.Имя + ")");
	КонецЕсли;
КонецЕсли;

Сообщить(СтрШаблон("seed-done pool=%1 package=%2", Пул.Имя, Пакет.Имя));
