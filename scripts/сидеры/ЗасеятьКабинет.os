// Сидер хаба для HTTP-интеграционных тестов приватной части: запускается отдельным
// процессом до старта хаба и наполняет ту же БД. Конфигурация — переменными OSHUB_*.

#Использовать autumn
#Использовать autumn-logos
#Использовать autumn-data
#Использовать entity
#Использовать pwhash

Функция ИзОкружения(Знач Имя, Знач ПоУмолчанию)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ПоУмолчанию);
КонецФункции

Процедура ЗаписатьЛог(Знач Текст)
	Путь = ПолучитьПеременнуюСреды("OSHUB_SEED_LOG");
	Если ЗначениеЗаполнено(Путь) Тогда
		Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
		Запись.Записать(Текст);
		Запись.Закрыть();
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Подключает классы каталога, пропуская контроллеры (им нужен winow).
Процедура ПодключитьСервисы(Знач Каталог)
	Для Каждого Ф Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
		Если СтрНачинаетсяС(Ф.ИмяБезРасширения, "Контроллер") Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ТипЗарегистрирован(Ф.ИмяБезРасширения) Тогда
			ПодключитьСценарий(Ф.ПолноеИмя, Ф.ИмяБезРасширения);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура Засеять()

	КаталогСценария = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогСценария, "..", "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	// Классы берутся ВСЕМ каталогом приложений, как их берёт winow на старте хаба: сидер
	// не знает раскладки, и переезд модуля его не задевает.
	ПодключитьСервисы(Модули);

	КореньХранилища = Новый Файл(ИзОкружения("OSHUB_STORAGE_ROOT", "./data")).ПолноеИмя;

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", ИзОкружения("OSHUB_DB_CONNECTOR", "КоннекторJSON"));
	ИсточникДанных.Вставить("СтрокаСоединения", ИзОкружения("OSHUB_DB_CONNECTION", ОбъединитьПути(КореньХранилища, "db")));
	// Ключ гранулярный, не карта "data": иначе корневой autumn-properties.json перебьёт его.
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	СервисПользователей = Поделка.НайтиЖелудь("СервисПользователей");
	СервисПулов = Поделка.НайтиЖелудь("СервисПулов");
	СервисПакетов = Поделка.НайтиЖелудь("СервисПакетов");
	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");

	СервисПользователей.СоздатьПользователя("root", "root@ex.com", "RootPassw0rd", "admin");
	Alice = СервисПользователей.СоздатьПользователя("alice", "alice@ex.com", "AlicePassw0rd", "user");
	СервисПользователей.СоздатьПользователя("bob", "bob@ex.com", "BobPassw0rd", "user");
	СервисПользователей.СоздатьПользователя("mustchange", "mc@ex.com", "OldPassw0rd", "user", Истина);
	// publisher-НЕ-owner на пуле public: пишет пакеты, но не администрирует каналы пула
	Pub = СервисПользователей.СоздатьПользователя("pub", "pub@ex.com", "PubPassw0rd", "user");
	// owner1 — владелец своего пула owned (не admin): для теста кросс-пулового IDOR
	Owner1 = СервисПользователей.СоздатьПользователя("owner1", "owner1@ex.com", "Owner1Passw0rd", "user");

	// пул и пакет alice-pkg (автор — alice)
	Пул = СервисПулов.СоздатьПул("public", "custom", "public");

	// pub — райтер на public под легаси-именем publisher; владельцем НЕ делаем, проверяется гейт
	НазначитьРольНаПуле(Поделка, Пул, Pub, "publisher");

	// пул owned с owner1 во владельцах (чужой относительно public)
	ПулOwned = СервисПулов.СоздатьПул("owned", "custom", "private");
	НазначитьРольНаПуле(Поделка, ПулOwned, Owner1, "owner");

	// группа пользователей platform с alice в составе — для тестов дома настроек «Группа»
	СервисГрупп = Поделка.НайтиЖелудь("СервисГрупп");
	Группа = СервисГрупп.СоздатьГруппу("platform", "Платформенная команда");
	СервисГрупп.ДобавитьУчастника(Группа.Идентификатор, Alice.Идентификатор, "local");

	AlicePkg = СервисПакетов.ЗарегистрироватьПакет(Пул.Идентификатор, "alice-pkg",
		Новый Структура("Описание, Лицензия", "Пакет Алисы", "MIT"));

	Опубликовать(СервисВерсий, AlicePkg.Идентификатор, "1.0.0", Alice.Идентификатор);
	Опубликовать(СервисВерсий, AlicePkg.Идентификатор, "1.1.0", Alice.Идентификатор);

	// Выделенный приватный пул secret: owned нельзя — его видимость меняет другой тест.
	ПулSecret = СервисПулов.СоздатьПул("secret", "custom", "private");
	НазначитьРольНаПуле(Поделка, ПулSecret, Owner1, "owner");

	SecretPkg = СервисПакетов.ЗарегистрироватьПакет(ПулSecret.Идентификатор, "secret-pkg",
		Новый Структура("Описание, Лицензия", "Пакет приватного пула", "MIT"));
	Опубликовать(СервисВерсий, SecretPkg.Идентификатор, "1.0.0", Owner1.Идентификатор);

	ЗасеятьЛегасиКлюч(Поделка, СервисПользователей);

КонецПроцедуры

// Пресет роли на пуле — запись, которой у продукта НЕТ ПИСАТЕЛЯ: ХранилищеУчастниковПула
// в src/ никто не наполняет, читает пресеты СервисПрав, чистят УборкаПула и СлужбаГрупп.
// Наружу такая роль выдаётся грантом, а грант — это другая таблица и потолок «мейнтейнер»
// (api/КонтроллерГрантовAPI). Пока писателя нет, фактуру с владельцем пула заводит только
// засев, и заводит он её прямой записью.
Процедура НазначитьРольНаПуле(Знач Поделка, Знач Пул, Знач Субъект, Знач Роль)

	Участник = Поделка.НайтиЖелудь("ХранилищеУчастниковПула").СоздатьЭлемент();
	Участник.ПулИдентификатор = Пул.Идентификатор;
	Участник.ТипСубъекта = "пользователь";
	Участник.СубъектИдентификатор = Субъект.Идентификатор;
	Участник.Роль = Роль;
	Участник.Сохранить();

КонецПроцедуры

// Ключ без срока: такие выпускались до запрета бессрочных и живут до отзыва владельцем.
// Через продукт его больше не завести, а поведение хаба с ним проверяют тесты кабинета.
Процедура ЗасеятьЛегасиКлюч(Знач Поделка, Знач СервисПользователей)

	Владелец = СервисПользователей.СоздатьПользователя("legacy", "legacy@ex.com",
		"LegacyPassw0rd", "user");

	Токен = Поделка.НайтиЖелудь("ХранилищеТокенов").СоздатьЭлемент();
	Токен.ПользовательИдентификатор = Владелец.Идентификатор;
	Токен.Права = "read,write";
	Токен.Имя = "легаси-вечный";
	Токен.ПулИдентификатор = 0;
	Токен.Создан = ТекущаяУниверсальнаяДата();
	Токен.Сохранить(); // Истекает не заполняем — в этом весь смысл легаси-ключа

	Токен.Префикс = СтрШаблон("oshub_%1", Токен.Идентификатор);
	Токен.Хеш = Sha256Hex(СекретЛегасиКлюча());
	Токен.Сохранить();

КонецПроцедуры

// Секрет известен тестам: собрать значение ключа можно только зная его.
Функция СекретЛегасиКлюча()
	Возврат "legacyeternalsecret00000000000000000000000000000000";
КонецФункции

Функция Sha256Hex(Знач Значение)
	Хеши = Новый Хеш();
	Возврат Хеши.ОтСтроки(Значение);
КонецФункции

Процедура Опубликовать(Знач СервисВерсий, Знач ПакетИд, Знач Версия, Знач АвторИд)
	Заявка = Новый ЗаявкаНаПубликацию(ПакетИд, Версия);
	Заявка.Размер = 4096;
	Заявка.Sha256 = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
	Заявка.АвторМанифеста = "alice";
	Заявка.ОпубликовалИдентификатор = АвторИд;
	СервисВерсий.Опубликовать(Заявка);
КонецПроцедуры

Попытка
	Засеять();
	Сообщить("SEED-OK");
Исключение
	ЗаписатьЛог(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	ВызватьИсключение;
КонецПопытки;
