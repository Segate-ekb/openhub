// admin-cli — утилита администратора хаба: создание админа и сброс пароля.
//   oscript scripts/admin-cli.os create-admin --login <логин> --password <пароль> [--force]
// Конфигурация БД — те же переменные окружения, что и у main.os.

#Использовать autumn
#Использовать autumn-logos
#Использовать autumn-data
#Использовать entity
#Использовать pwhash

Функция ИзОкружения(Знач Имя, Знач ПоУмолчанию)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ПоУмолчанию);
КонецФункции

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Подключает классы каталога, кроме контроллеров (им нужен winow, здесь не нужен).
// Файл ищется по имени в каталоге и его подкаталогах: путь из имени не строится, иначе
// уехавший в подкаталог класс молча теряется (docs/процесс/РАСКЛАДКА.md).
Процедура ПодключитьОдинКласс(Знач КаталогКлассов, Знач ИмяКласса)
	Если ТипЗарегистрирован(ИмяКласса) Тогда
		Возврат;
	КонецЕсли;
	Найденные = НайтиФайлы(КаталогКлассов, ИмяКласса + ".os", Истина);
	Если Найденные.Количество() <> 1 Тогда
		ВызватьИсключение СтрШаблон("Класс %1 в %2 найден %3 раз(а), ожидался ровно один",
			ИмяКласса, КаталогКлассов, Найденные.Количество());
	КонецЕсли;
	ПодключитьСценарий(Найденные[0].ПолноеИмя, ИмяКласса);
КонецПроцедуры

Процедура ПодключитьСервисы(Знач КаталогКлассов)
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		Если СтрНачинаетсяС(ФайлКласса.ИмяБезРасширения, "Контроллер") Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ТипЗарегистрирован(ФайлКласса.ИмяБезРасширения) Тогда
			ПодключитьСценарий(ФайлКласса.ПолноеИмя, ФайлКласса.ИмяБезРасширения);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ИсточникДанных()

	// Дефолт — КоннекторJSON (как в autumn-properties.json).
	ТипКоннектора = ИзОкружения("OSHUB_DB_CONNECTOR", "КоннекторJSON");
	СтрокаСоединения = ПолучитьПеременнуюСреды("OSHUB_DB_CONNECTION");

	Если НЕ ЗначениеЗаполнено(СтрокаСоединения) Тогда
		Если СтрНачинаетсяС(ВРег(ТипКоннектора), ВРег("КоннекторJSON")) Тогда
			КаталогДанных = Новый Файл(ИзОкружения("OSHUB_STORAGE_ROOT", "./data")).ПолноеИмя;
			СтрокаСоединения = ОбъединитьПути(КаталогДанных, "entities");
			Если НЕ Новый Файл(СтрокаСоединения).Существует() Тогда
				СоздатьКаталог(СтрокаСоединения);
			КонецЕсли;
		ИначеЕсли ВРег(ТипКоннектора) = ВРег("КоннекторSQLite") Тогда
			КаталогДанных = Новый Файл(ИзОкружения("OSHUB_STORAGE_ROOT", "./data")).ПолноеИмя;
			СтрокаСоединения = "Data Source=" + ОбъединитьПути(КаталогДанных, "db", "openhub.db");
		ИначеЕсли ВРег(ТипКоннектора) = ВРег("КоннекторInMemory") Тогда
			СтрокаСоединения = "";
		Иначе
			ВызватьИсключение "Для выбранного OSHUB_DB_CONNECTOR обязательна OSHUB_DB_CONNECTION";
		КонецЕсли;
	КонецЕсли;

	ИД = Новый Соответствие();
	ИД.Вставить("ТипКоннектора", ТипКоннектора);
	ИД.Вставить("СтрокаСоединения", СтрокаСоединения);
	Возврат ИД;

КонецФункции

Функция ПостроитьПоделку()

	КаталогСкрипта = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогСкрипта, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("данные", "Классы")));
	// вид объекта в журнале: сервисы auth собирают его желудём
	ПодключитьОдинКласс(ОбъединитьПути(Модули, ОбъединитьПути("аудит", "Классы")), "ИмяОбъектаАудита");
	// канон записи адреса: его спрашивают ИмяОбъектаАудита и ВалидаторНастроек
	ПодключитьОдинКласс(ОбъединитьПути(Модули, ОбъединитьПути("основа", "Классы")), "КанонIP");
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("вход", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("права", "Классы")));
	// settings: доменная точка активности спрашивает ПолитикуПарольногоВхода, а та —
	// СервисНастроек с его реестром. Слой представления сюда не подключается: последнее
	// средство восстановления доступа не должно зависеть от сборки витрин и пультов.
	КаталогНастроек = ОбъединитьПути(Модули, ОбъединитьПути("настройки", "Классы"));
	ПодключитьОдинКласс(КаталогНастроек, "ВидыПроверок");
	ПодключитьОдинКласс(КаталогНастроек, "НастройкиПодсистем");
	ПодключитьОдинКласс(КаталогНастроек, "РеестрНастроек");
	ПодключитьОдинКласс(КаталогНастроек, "СервисНастроек");
	ПодключитьОдинКласс(КаталогНастроек, "ВалидаторНастроек");
	// core-registry нужен из-за ПравилаИменования: без него контейнер не собирается.
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("реестр", "Классы")));
	// storage: занятое пулом меряется по хранилищу (УчётОбъёмаПула), и без бэкенда
	// артефактов половина желудей реестра осталась бы несобранной
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("хранилище", "Классы")));

	// Чужие модули, без которых желуди core-registry не разрешаются В РАНТАЙМЕ.
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("события", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("сеть", "Классы")));
	ПодключитьОдинКласс(ОбъединитьПути(Модули, ОбъединитьПути("наблюдаемость", "Классы/телеметрия")), "СпанХаба");
	ПодключитьОдинКласс(ОбъединитьПути(Модули, ОбъединитьПути("наблюдаемость", "Классы/телеметрия")), "Телеметрия");
	ПодключитьОдинКласс(ОбъединитьПути(Модули, ОбъединитьПути("подписки", "Классы")), "ВалидаторАдресаВебхука");
	ПодключитьОдинКласс(ОбъединитьПути(Модули, ОбъединитьПути("зеркала", "Классы")), "ВалидаторАдресаАпстрима");

	Детальки = Новый Соответствие();
	// Ключ гранулярный, не карта "data": иначе корневой autumn-properties.json перебьёт его.
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных());

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();
	Возврат Поделка;

КонецФункции

// Разбор флагов --ключ [значение]. Флаг без значения не проглатывает соседний --флаг.
Функция РазобратьФлаги(Знач Аргументы)

	Флаги = Новый Соответствие();
	Индекс = 1; // 0 — команда

	Пока Индекс < Аргументы.Количество() Цикл

		Арг = Аргументы[Индекс];
		Если НЕ СтрНачинаетсяС(Арг, "--") Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		ЕстьЗначение = Индекс + 1 < Аргументы.Количество()
			И НЕ СтрНачинаетсяС(Аргументы[Индекс + 1], "--");

		Флаги.Вставить(Сред(Арг, 3), ?(ЕстьЗначение, Аргументы[Индекс + 1], ""));
		Индекс = Индекс + ?(ЕстьЗначение, 2, 1);

	КонецЦикла;

	Возврат Флаги;

КонецФункции

// create-admin: на пустом хабе — онбординг первого админа; на инициализированном —
// восстановление доступа (сброс пароля + повышение до admin), только по явному --force.
Процедура СоздатьАдмина(Знач Флаги)

	Логин = Флаги.Получить("login");
	Пароль = Флаги.Получить("password");
	Если НЕ ЗначениеЗаполнено(Логин) Или НЕ ЗначениеЗаполнено(Пароль) Тогда
		ВызватьИсключение "Требуются --login и --password";
	КонецЕсли;

	Поделка = ПостроитьПоделку();
	СервисПользователей = Поделка.НайтиЖелудь("СервисПользователей");
	Активность = Поделка.НайтиЖелудь("СервисАктивностиУчёток");
	Онбординг = Поделка.НайтиЖелудь("ОнбордингПервогоЗапуска");
	ПарольныйВход = Поделка.НайтиЖелудь("ПолитикаПарольногоВхода");

	Существующий = СервисПользователей.НайтиПоЛогину(Логин);

	Если Существующий = Неопределено И Онбординг.НуженОнбординг() Тогда
		// пустой хаб — тот же путь и тот же гейт, что у мастера /setup
		Админ = Онбординг.СоздатьПервогоАдмина(Логин, Пароль, Ложь);
		Сообщить(СтрШаблон("Создан первый администратор ""%1"" (id=%2)", Админ.Логин, Админ.Идентификатор));
		Возврат;
	КонецЕсли;

	Если НЕ ЭтоФорс(Флаги) Тогда
		ВызватьИсключение
			"Хаб уже инициализирован: create-admin здесь ВОССТАНАВЛИВАЕТ доступ —"
			+ " создаёт нового администратора либо повышает существующего пользователя до"
			+ " admin со сбросом пароля. Это выдача суперправа, поэтому требуется явный"
			+ " флаг --force (опечатка в --login иначе молча сделала бы админом чужую учётку).";
	КонецЕсли;

	// пароль — единственный способ входа, который выдаёт эта утилита; на хабе с выключенным
	// парольным входом он мёртв, и доменная точка активности такую учётку не откроет.
	// Спрашиваем ДО записи: иначе пароль и роль остались бы записанными при отказе.
	Если ПарольныйВход.Выключен() Тогда
		ВызватьИсключение СтрШаблон(
			"Вход по логину и паролю на хабе выключен (настройка %1): заданный пароль"
			+ " никого не пустит, и восстанавливать доступ здесь нечем. Включите парольный"
			+ " вход либо заводите администратора через провайдера входа.",
			ПарольныйВход.КлючНастройки());
	КонецЕсли;

	Если Существующий <> Неопределено Тогда
		СервисПользователей.УстановитьПароль(Существующий, Пароль);
		Существующий.РольХаба = "admin";
		Существующий.Сохранить();
		Цель = Существующий;
		Итог = "повышен до admin, пароль сброшен";
	Иначе
		// учётка рождается закрытой и открывается той же доменной точкой, что и соседняя
		// ветка: активная учётка, войти в которую нечем, — состояние, объявленное доменом
		// невозможным, и утилита восстановления не имеет права его создавать
		Цель = СервисПользователей.СоздатьПользователя(Логин, "", Пароль, "admin", Ложь, Ложь);
		Итог = "заведён дополнительным администратором";
	КонецЕсли;

	Активность.Активировать(Цель);
	Сообщить(СтрШаблон("[--force] Пользователь ""%1"" %2 (id=%3)",
		Цель.Логин, Итог, Цель.Идентификатор));

КонецПроцедуры

// Принимаем и голый --force, и --force true.
Функция ЭтоФорс(Знач Флаги)
	Значение = Флаги.Получить("force");
	Возврат Значение <> Неопределено И НРег(СокрЛП(Строка(Значение))) <> "false";
КонецФункции


Аргументы = АргументыКоманднойСтроки;
Если Аргументы.Количество() = 0 Тогда
	Сообщить("Команды: create-admin --login <логин> --password <пароль> [--force]"
		+ Символы.ПС + "  --force обязателен на уже инициализированном хабе (восстановление доступа).");
	ЗавершитьРаботу(1);
КонецЕсли;

Команда = Аргументы[0];
Попытка
	Если Команда = "create-admin" Тогда
		СоздатьАдмина(РазобратьФлаги(Аргументы));
	Иначе
		ВызватьИсключение СтрШаблон("Неизвестная команда ""%1""", Команда);
	КонецЕсли;
Исключение
	Сообщить("Ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	ЗавершитьРаботу(1);
КонецПопытки;
