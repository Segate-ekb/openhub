 КонецПроцедуры
 
+// Аппендеры, которые logos навешивает на лог: из его настройки (или ближайшей по иерархии)
+// и, если в ней нет additivity: false, из настройки rootLogger
+Функция ИменаАппендеровЛога(НастройкаЛога)
+
+	Результат = ПолучитьАппендерыИзНастройки(НастройкаЛога.Получить("appenders"));
+
+	Аддитивность = НастройкаЛога.Получить("additivity");
+	НастройкаКорня = НастройкиЛогов.Получить("rootLogger");
+	Если НастройкаКорня = Неопределено
+		ИЛИ ТипЗнч(НастройкаКорня) = Тип("Строка")
+		ИЛИ НастройкаКорня = НастройкаЛога
+		ИЛИ Аддитивность = Ложь
+		ИЛИ Аддитивность = "false" Тогда
+		Возврат Результат;
+	КонецЕсли;
+
+	Для Каждого ИмяАппендера Из ПолучитьАппендерыИзНастройки(НастройкаКорня.Получить("appenders")) Цикл
+		Если Результат.Найти(ИмяАппендера) = Неопределено Тогда
+			Результат.Добавить(ИмяАппендера);
+		КонецЕсли;
+	КонецЦикла;
+
+	Возврат Результат;
+
+КонецФункции
+
 Функция ПолучитьУровень(Уровень)
 	
