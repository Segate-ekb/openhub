+	КонецЕсли;
+
+	// DEFAULT: своего уровня у аппендера нет, он следует уровню лога
+	Если Уровень = "DEFAULT" Тогда
+		Возврат Неопределено;
+	КонецЕсли;
+
 	ПроинициализироватьКартуУровней();
 
 	Возврат КартаУровней[Уровень];
