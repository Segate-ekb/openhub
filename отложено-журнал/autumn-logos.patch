+// additivity: false — лог не получает аппендеры rootLogger
+Процедура ДобавитьНастройкуАддитивности(МассивРезультата, ТекущийЛог)
+
+	Аддитивность = ТекущийЛог.Значение.Получить("additivity");
+	Если Аддитивность = Неопределено Тогда
+		Возврат;
+	КонецЕсли;
+
+	Если ТипЗнч(Аддитивность) = Тип("Булево") Тогда
+		Аддитивность = ?(Аддитивность, "true", "false");
+	КонецЕсли;
+
+	МассивРезультата.Добавить("additivity." + ТекущийЛог.Ключ + "=" + Аддитивность);
+
+КонецПроцедуры
+
