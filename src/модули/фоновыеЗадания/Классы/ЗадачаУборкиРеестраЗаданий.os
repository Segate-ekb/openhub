// Задача планировщика «уборка-реестра-заданий»: реестр заданий платформы очищается целиком,
// а его размер перед уборкой называется в отладке.

Перем Реестр;    // РеестрЗаданийПлатформы
Перем Интервал;  // интервал уборки из настройки, секунды
&Лог
Перем Лог;

// Регистрация в планировщике: уборка раз в интервал из настройки.
//
// Параметры:
//  Регистрации - РегистрацииЗадачи - куда записывается регистрация.
//
Процедура Зарегистрировать(Регистрации) Экспорт
	Регистрации.КаждыеСекунд("уборка-реестра-заданий", Интервал);
КонецПроцедуры

// Снимает записи заданий, назвав размер реестра до уборки.
// Сбой перебрасывается планировщику.
//
&Наблюдаемый("job.registry_gc")
Процедура Исполнить() Экспорт

	Лог.Отладка("Уборка реестра заданий: записей до уборки %1", Реестр.Размер());
	Реестр.Очистить();

КонецПроцедуры

&Прозвище("ЗадачаПланировщика")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РеестрЗаданийПлатформы") _Реестр,
	&Лог _Лог = Неопределено,
	&Деталька(Значение = "oshub.jobs.registry_gc_interval_sec", ЗначениеПоУмолчанию = 60) _Интервал = Неопределено)

	Реестр = _Реестр;
	Интервал = Новый ПриведениеЧисел().ЧислоИлиДефолт(_Интервал, 60);
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
