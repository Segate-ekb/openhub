// Обработчик os-scheduler: реестр заданий платформы очищается целиком, а его размер
// перед уборкой называется в отладке.

Перем Реестр;   // РеестрЗаданийПлатформы (фоновыеЗадания)
&Лог
Перем Лог;

// Снимает записи заданий, назвав размер реестра до уборки.
// Сбой перебрасывается планировщику.
//
&Наблюдаемый("job.registry_gc")
Процедура Исполнить() Экспорт

	Лог.Отладка("Уборка реестра заданий: записей до уборки %1", Реестр.Размер());
	Реестр.Очистить();

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РеестрЗаданийПлатформы") _Реестр,
	&Лог _Лог = Неопределено)

	Реестр = _Реестр;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
