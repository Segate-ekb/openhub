// Обёртка обработчика фоновой задачи: замеряет прогон и отдаёт журналу старт и исход.
// Исключение обработчика доводится до планировщика без изменений.

Перем Имя;
Перем Обработчик;
Перем Журнал;

// Выполняет обёрнутый обработчик, сообщая журналу старт, длительность и исход.
// Исключение перебрасывается: статус задачи и повторы ведёт планировщик.
//
Процедура Исполнить() Экспорт

	Журнал.Старт(Имя);
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Обработчик.Исполнить();
	Исключение
		Журнал.Сбой(Имя, ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;

	Журнал.Успех(Имя, ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);

КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач ИмяЗадачи, Знач ОбработчикЗадачи, Знач ЖурналЗадач)

	Имя = ИмяЗадачи;
	Обработчик = ОбработчикЗадачи;
	Журнал = ЖурналЗадач;

КонецПроцедуры
