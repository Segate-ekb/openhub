// Обёртка обработчика фоновой задачи: заводит серверный спан на прогон и помечает его
// ошибкой при сбое. Без телеметрии обработчик исполняется как есть.

Перем ИмяСпана;
Перем Обработчик;
Перем Телеметрия;

// Выполняет обёрнутый обработчик внутри спана; сбой помечает спан и перебрасывается.
//
Процедура Исполнить() Экспорт

	Спан = Неопределено;
	Если Телеметрия <> Неопределено Тогда
		Спан = Телеметрия.НачатьСпан(ИмяСпана, "internal");
	КонецЕсли;

	Попытка
		Обработчик.Исполнить();
	Исключение
		Если Спан <> Неопределено Тогда
			Спан.Ошибка("сбой задачи");
			Спан.Завершить();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Если Спан <> Неопределено Тогда
		Спан.Завершить();
	КонецЕсли;

КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач ИмяСпанаЗадачи, Знач ОбработчикЗадачи, Знач ФасадТелеметрии)

	ИмяСпана = ИмяСпанаЗадачи;
	Обработчик = ОбработчикЗадачи;
	Телеметрия = ФасадТелеметрии;

КонецПроцедуры
