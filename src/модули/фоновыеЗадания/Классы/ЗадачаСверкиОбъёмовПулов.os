// Обработчик os-scheduler: сверка счётчика занятого объёма пулов с действующей квотой.

Перем Сверка;      // СверкаОбъёмовПулов (реестр)
Перем Телеметрия;  // фасад OTel (наблюдаемость), опционален

// Выполняет один проход сверки занятого объёма.
// Сбой сверки перебрасывается планировщику, пометив спан ошибкой.
//
Процедура Исполнить() Экспорт
	Спан = Неопределено;
	Если Телеметрия <> Неопределено Тогда
		Спан = Телеметрия.НачатьСпан("job.pool_volume_audit", "internal");
	КонецЕсли;
	Попытка
		Сверка.Сверить();
	Исключение
		Если Спан <> Неопределено Тогда
			Спан.Ошибка("сбой задачи");
			Спан.Завершить();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Если Спан <> Неопределено Тогда
		Спан.Завершить();
	КонецЕсли;
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СверкаОбъёмовПулов") _Сверка,
	&Пластилин(Значение = "Телеметрия") _Телеметрия = Неопределено)

	Сверка = _Сверка;
	Телеметрия = _Телеметрия;

КонецПроцедуры
