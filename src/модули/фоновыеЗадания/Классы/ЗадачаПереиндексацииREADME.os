// Обработчик os-scheduler: ночной полный прогрев кэша README всех пакетов.

Перем Прогревщик;  // ПрогревщикREADME (описания)
Перем Телеметрия;  // фасад OTel (наблюдаемость), опционален

// Выполняет полный прогрев кэша README всех пакетов.
// Сбой прогрева перебрасывается планировщику, пометив спан ошибкой.
//
Процедура Исполнить() Экспорт
	Спан = Неопределено;
	Если Телеметрия <> Неопределено Тогда
		Спан = Телеметрия.НачатьСпан("job.readme_reindex", "internal");
	КонецЕсли;
	Попытка
		Прогревщик.ПрогретьВсе();
	Исключение
		Если Спан <> Неопределено Тогда
			Спан.Ошибка("сбой задачи");
			Спан.Завершить();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Если Спан <> Неопределено Тогда
		Спан.Завершить();
	КонецЕсли;
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПрогревщикREADME") _Прогревщик,
	&Пластилин(Значение = "Телеметрия") _Телеметрия = Неопределено)

	Прогревщик = _Прогревщик;
	Телеметрия = _Телеметрия;

КонецПроцедуры
