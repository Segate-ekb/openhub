// Обработчик os-scheduler: регулярная проверка живости источников пулов и зеркал.

Перем Обход;       // ОбходЗдоровьяИсточников (прокси)
Перем Телеметрия;  // фасад OTel (наблюдаемость), опционален

// Выполняет один обход источников.
// Сбой обхода перебрасывается планировщику, пометив спан ошибкой.
//
Процедура Исполнить() Экспорт
	Спан = Неопределено;
	Если Телеметрия <> Неопределено Тогда
		Спан = Телеметрия.НачатьСпан("job.upstream_health", "internal");
	КонецЕсли;
	Попытка
		Обход.Обойти();
	Исключение
		Если Спан <> Неопределено Тогда
			Спан.Ошибка("сбой задачи");
			Спан.Завершить();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Если Спан <> Неопределено Тогда
		Спан.Завершить();
	КонецЕсли;
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОбходЗдоровьяИсточников") _Обход,
	&Пластилин(Значение = "Телеметрия") _Телеметрия = Неопределено)

	Обход = _Обход;
	Телеметрия = _Телеметрия;

КонецПроцедуры
