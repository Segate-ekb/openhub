// Обработчик os-scheduler: слив накопленных в памяти счётчиков скачиваний в БД.
// Остаточная гонка полей службы вне блокировки для витринной статистики допустима.

Перем СлужбаСтатистики;  // СлужбаСтатистикиСкачиваний (статистика)
Перем Телеметрия;        // фасад OTel (наблюдаемость), опционален

// Выполняет один сброс накопленных агрегатов скачиваний в БД.
// Сбой сброса перебрасывается планировщику, пометив спан ошибкой.
//
Процедура Исполнить() Экспорт
	Спан = Неопределено;
	Если Телеметрия <> Неопределено Тогда
		Спан = Телеметрия.НачатьСпан("job.stats_flush", "internal");
	КонецЕсли;
	Попытка
		СлужбаСтатистики.Сбросить();
	Исключение
		Если Спан <> Неопределено Тогда
			Спан.Ошибка("сбой задачи");
			Спан.Завершить();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Если Спан <> Неопределено Тогда
		Спан.Завершить();
	КонецЕсли;
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СлужбаСтатистикиСкачиваний") _СлужбаСтатистики,
	&Пластилин(Значение = "Телеметрия") _Телеметрия = Неопределено)

	СлужбаСтатистики = _СлужбаСтатистики;
	Телеметрия = _Телеметрия;

КонецПроцедуры
