// Обработчик os-scheduler: удаление заявок входа CLI с истёкшим сроком.

Перем СервисВхода;  // СервисВходаCLI (auth)
Перем Телеметрия;   // фасад OTel (наблюдаемость), опционален

// Удаляет просроченные заявки входа CLI за один проход.
// Сбой перебрасывается планировщику, пометив спан ошибкой.
//
Процедура Исполнить() Экспорт
	Спан = Неопределено;
	Если Телеметрия <> Неопределено Тогда
		Спан = Телеметрия.НачатьСпан("job.cli_device_gc", "internal");
	КонецЕсли;
	Попытка
		СервисВхода.УдалитьПросроченные();
	Исключение
		Если Спан <> Неопределено Тогда
			Спан.Ошибка("сбой задачи");
			Спан.Завершить();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Если Спан <> Неопределено Тогда
		Спан.Завершить();
	КонецЕсли;
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисВходаCLI") _СервисВхода,
	&Пластилин(Значение = "Телеметрия") _Телеметрия = Неопределено)

	СервисВхода = _СервисВхода;
	Телеметрия = _Телеметрия;

КонецПроцедуры
