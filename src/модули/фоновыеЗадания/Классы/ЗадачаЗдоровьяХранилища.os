// Обработчик os-scheduler: регулярная проба доступности хранилища артефактов.
// Исход пробы запоминает СтражХранилища — экран спрашивает его, а не хранилище.

Перем Хранилище;   // ХранилищеАртефактов (хранилище)
Перем Настройки;   // СервисНастроек (настройки) — срок одной пробы

// Выполняет одну пробу хранилища.
// Сбой пробы перебрасывается планировщику.
//
Процедура Исполнить() Экспорт
	Хранилище.Доступность(СрокПробыСек());
КонецПроцедуры

// Срок спрашивается на каждый заход: поднятый конфигурацией он действует со следующей пробы.
Функция СрокПробыСек()
	Возврат Настройки.Целое("oshub.storage.health.timeout.sec", 10, 1);
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеАртефактов") _Хранилище,
	&Пластилин(Значение = "СервисНастроек") _Настройки)

	Хранилище = _Хранилище;
	Настройки = _Настройки;

КонецПроцедуры
