// Обработчик os-scheduler: заход обновления встроенной базы стран.

Перем Обновление;  // ОбновлениеБазыСтран (гео)

// Выполняет один заход обновления базы.
// Сбой перебрасывается планировщику.
//
Процедура Исполнить() Экспорт
	Обновление.Обойти();
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОбновлениеБазыСтран") _Обновление)

	Обновление = _Обновление;

КонецПроцедуры
