// Как фоновые задачи хаба выглядят оператору в журнале: состав при старте, старт и исход
// каждого прогона. Сбой пишется ОШИБКОЙ всегда, прогоны — ОТЛАДКОЙ всегда.

&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Оборачивает обработчик задачи отчётом о прогоне: старт, длительность, исход.
// Исключение обработчика обёртка не глотает — статус и повторы ведёт планировщик.
//
// Параметры:
//  Имя - Строка - имя задачи в планировщике.
//  Обработчик - Произвольный - объект с методом Исполнить().
//
// Возвращаемое значение:
//  ЗадачаПодЖурналом - обёртка, пригодная для регистрации в планировщике.
//
Функция Обернуть(Знач Имя, Знач Обработчик) Экспорт
	Возврат Новый ЗадачаПодЖурналом(Имя, Обработчик, ЭтотОбъект);
КонецФункции

// Печатает состав зарегистрированных задач: сводку и по строке на задачу.
//
// Параметры:
//  Состав - Массив - структуры с полями Имя (Строка) и Описание (Строка) —
//           человекочитаемая периодичность задачи.
//  ИнтервалТикаМс - Число - период опроса планировщика в миллисекундах.
//
Процедура ОбъявитьСостав(Знач Состав, Знач ИнтервалТикаМс) Экспорт

	Лог.Информация("Планировщик фоновых задач запущен: задач %1, опрос каждые %2 мс",
		Состав.Количество(), ИнтервалТикаМс);

	Для Каждого Задача Из Состав Цикл
		Лог.Информация("Фоновая задача ""%1"" — %2", Задача.Имя, Задача.Описание);
	КонецЦикла;

КонецПроцедуры

// Отмечает начало прогона задачи.
//
// Параметры:
//  Имя - Строка - имя задачи в планировщике.
//
Процедура Старт(Знач Имя) Экспорт
	ЗаписатьПрогон(СтрШаблон("Фоновая задача ""%1"" стартовала", Имя));
КонецПроцедуры

// Отмечает успешно завершённый прогон задачи.
//
// Параметры:
//  Имя - Строка - имя задачи в планировщике.
//  ДлительностьМс - Число - сколько занял прогон.
//
Процедура Успех(Знач Имя, Знач ДлительностьМс) Экспорт
	ЗаписатьПрогон(СтрШаблон("Фоновая задача ""%1"" отработала за %2 мс", Имя, ДлительностьМс));
КонецПроцедуры

// Отмечает упавший прогон задачи. Пишется ОШИБКОЙ всегда: молчащий сбой неотличим
// от неработающего планировщика.
//
// Параметры:
//  Имя - Строка - имя задачи в планировщике.
//  ДлительностьМс - Число - сколько прошло до падения.
//  Текст - Строка - описание ошибки обработчика.
//
Процедура Сбой(Знач Имя, Знач ДлительностьМс, Знач Текст) Экспорт
	Лог.Ошибка("Фоновая задача ""%1"" упала через %2 мс: %3", Имя, ДлительностьМс, Текст);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Уровень ОТЛАДКА: прогоны задач с коротким интервалом — самый шумный поток журнала.
Процедура ЗаписатьПрогон(Знач Сообщение)
	Лог.Отладка(Сообщение);
КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Лог _Лог = Неопределено)

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
