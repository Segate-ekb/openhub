// Каркас вечного фонового цикла: гейт готовности до входа, шаг под перехватом владельца, пауза.
// Что делает шаг и сколько спать, говорит владелец: ПередЦиклом, ШагЦикла, ПаузаМс, ПослеЦикла.

Перем Готовность;             // ГотовностьХаба (наблюдаемость)
Перем СпатьТолькоБезРаботы;   // Булево - с бэклогом заявки разбираются подряд
Перем ОстановкаЗапрошена;

#Область ПубличныйИнтерфейс

// Крутит цикл владельца до запроса остановки. Наружу не бросает, а возвращает причину
// смерти: фоновую рогатку с ОжидатьЗавершения = Ложь ОСень не дожидается и её исход
// не смотрит, поэтому назвать смерть в журнале обязан владелец — своими словами и своим
// журналом. Каркас в журнал не пишет вовсе и текста не сочиняет: сбой уходит наверх
// как есть, а во что его превратить — краткую причину или полный разбор — решает владелец.
//
// Параметры:
//  Владелец - Произвольный - объект цикла: ПередЦиклом() (Булево, входить ли в цикл),
//             ШагЦикла() (Булево, была ли работа), ПаузаМс() (Число), ПослеЦикла().
//  ИмяЗадачи - Строка - задача готовности хаба, закрываемая перед входом в цикл.
//
// Возвращаемое значение:
//  ИнформацияОбОшибке, Неопределено - Неопределено, если цикл вышел по запросу
//                                     остановки; иначе сбой, убивший цикл.
//
Функция Крутить(Знач Владелец, Знач ИмяЗадачи) Экспорт

	Попытка

		Входить = Владелец.ПередЦиклом();

		// гейт закрывается до входа и при выключенной подсистеме: цикл вечен по построению
		Готовность.ОтметитьЗадачуВыполненной(ИмяЗадачи);

		Если Входить Тогда
			Вертеть(Владелец);
			Владелец.ПослеЦикла();
		КонецЕсли;

	Исключение
		// ИнформацияОбОшибке достоверна только в кадре обработчика.
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

// Просит цикл завершиться после текущего шага.
//
Процедура Остановить() Экспорт
	ОстановкаЗапрошена = Истина;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Вертеть(Знач Владелец)

	Пока НЕ ОстановкаЗапрошена Цикл
		БылаРабота = Владелец.ШагЦикла();
		Если НЕ (СпатьТолькоБезРаботы И БылаРабота = Истина) Тогда
			Приостановить(Владелец.ПаузаМс());
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач _Готовность, Знач _СпатьТолькоБезРаботы = Ложь)

	Готовность = _Готовность;
	СпатьТолькоБезРаботы = _СпатьТолькоБезРаботы;
	ОстановкаЗапрошена = Ложь;

КонецПроцедуры
