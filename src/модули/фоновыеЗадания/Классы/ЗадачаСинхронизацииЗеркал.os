// Обработчик os-scheduler: ставит все включённые зеркала в очередь синхронизации.
// Саму репликацию ведёт фоновый рабочий — цикл планировщика её не ждёт.

Перем Очередь;       // ОчередьСинхронизацииЗеркал (зеркала)
Перем СервисЗеркал;  // СервисЗеркал (зеркала)

// Ставит заявку на каждое включённое зеркало; уже идущие и уже поставленные пропускаются.
// Сбой прохода перебрасывается планировщику.
//
Процедура Исполнить() Экспорт
	ПоставитьВсе();
КонецПроцедуры

// Сколько зеркал поставлено в очередь этим проходом.
//
// Возвращаемое значение:
//  Число - принятых заявок.
//
Функция ПоставитьВсе() Экспорт
	Поставлено = 0;
	Для Каждого Зеркало Из СервисЗеркал.ВключённыеЗеркала() Цикл
		// пустой инициатор = запуск по расписанию, а не человеком
		Если Очередь.Поставить(Зеркало.Идентификатор, "") Тогда
			Поставлено = Поставлено + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Поставлено;
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОчередьСинхронизацииЗеркал") _Очередь,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал)

	Очередь = _Очередь;
	СервисЗеркал = _СервисЗеркал;

КонецПроцедуры
