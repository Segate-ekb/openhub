// Обработчик os-scheduler: LRU-эвикция кэша proxy-пулов до квоты.

Перем Сборщик;  // СборщикКэшаПрокси (прокси)
Перем Телеметрия;  // фасад OTel (наблюдаемость), опционален

// Выполняет один проход сборки кэша прокси до квоты.
// Сбой сборки перебрасывается планировщику, пометив спан ошибкой.
//
Процедура Исполнить() Экспорт
	Спан = Неопределено;
	Если Телеметрия <> Неопределено Тогда
		Спан = Телеметрия.НачатьСпан("job.proxy_gc", "internal");
	КонецЕсли;
	Попытка
		Сборщик.Собрать();
	Исключение
		Если Спан <> Неопределено Тогда
			Спан.Ошибка("сбой задачи");
			Спан.Завершить();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Если Спан <> Неопределено Тогда
		Спан.Завершить();
	КонецЕсли;
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СборщикКэшаПрокси") _Сборщик,
	&Пластилин(Значение = "Телеметрия") _Телеметрия = Неопределено)

	Сборщик = _Сборщик;
	Телеметрия = _Телеметрия;

КонецПроцедуры
