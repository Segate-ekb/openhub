// Единая точка регулярных фоновых процессов хаба на базе os-scheduler: регистрирует задачи
// и крутит фоновый цикл опроса Тик() — сам планировщик потоков не создаёт.

#Использовать os-scheduler

Перем ЗадачаСтатистики;   // ЗадачаСбросаСтатистики (фоновыеЗадания)
Перем Готовность;   // ГотовностьХаба (наблюдаемость)
Перем ЗадачаGC;           // ЗадачаСбораКэшаПрокси (фоновыеЗадания)
Перем ЗадачаREADME;       // ЗадачаПереиндексацииREADME (фоновыеЗадания)
Перем ЗадачаЗеркал;       // ЗадачаСинхронизацииЗеркал (фоновыеЗадания)
Перем ЗадачаЗаявокCLI;    // ЗадачаЧисткиЗаявокCLI (фоновыеЗадания)
Перем ЗадачаПриглашений;  // ЗадачаЧисткиПриглашений (фоновыеЗадания)
Перем ЗадачаОбъёмов;      // ЗадачаСверкиОбъёмовПулов (фоновыеЗадания)
Перем ЗадачаЗдоровья;     // ЗадачаЗдоровьяИсточников (фоновыеЗадания)
Перем ИнтервалСверкиОбъёмовСек;
Перем ИнтервалЗдоровьяСек;

Перем ИнтервалСтатистикиСек;
Перем ИнтервалGCСек;
Перем ЧасПереиндексацииREADME;
Перем ОтброшенныйЧасREADME;  // записанное оператором значение, часом суток не являющееся
Перем ИнтервалЗеркалСек;
Перем ИнтервалЗаявокCLIСек;
Перем ИнтервалПриглашенийСек;
Перем ИнтервалТикаМс;
Перем Включено;

Перем Часы;         // источник времени os-scheduler; Неопределено — умолчание библиотеки
Перем Исполнитель;  // исполнитель os-scheduler; Неопределено — умолчание библиотеки
Перем Журнал;       // ЖурналФоновыхЗадач (фоновыеЗадания)
Перем Телеметрия;   // фасад OTel (наблюдаемость), опционален — спан на прогон задачи
Перем Числа;        // ПриведениеЧисел (основа)
Перем Флаги;        // ПриведениеФлагов (основа)
Перем Ошибки;       // ТекстОшибки (основа)
Перем Планировщик;  // Планировщик (os-scheduler) — создаётся в Настроить()
Перем Настроен;
Перем ОстановкаЗапрошена;
&Лог
Перем Лог;

#Область ТестовыеШвы

// Подставляет источник времени планировщика. Вызывать до Настроить().
//
// Параметры:
//  ИсточникВремени - Объект - часы os-scheduler (например, ЧасыРучные в тестах).
//
Процедура УстановитьЧасы(Знач ИсточникВремени) Экспорт
	Часы = ИсточникВремени;
КонецПроцедуры

// Подставляет исполнитель задач планировщика. Вызывать до Настроить().
//
// Параметры:
//  НовыйИсполнитель - Объект - исполнитель os-scheduler.
//
Процедура УстановитьИсполнитель(Знач НовыйИсполнитель) Экспорт
	Исполнитель = НовыйИсполнитель;
КонецПроцедуры

#КонецОбласти

#Область ПубличныйИнтерфейс

// Создаёт планировщик, регистрирует фоновые задачи и разрешает диспетчеризацию.
// Идемпотентна: повторный вызов не пересоздаёт и не дублирует задачи.
//
Процедура Настроить() Экспорт

	Если Настроен Тогда
		Лог.Отладка("Планировщик: уже настроен — задачи не перерегистрируются");
		Возврат;
	КонецЕсли;

	// Незаданное библиотека берёт по умолчанию: хранилище в памяти, синхронный
	// исполнитель, системные часы. Свои — только из тестовых швов выше.
	Настройки = Новый Структура();
	Если Часы <> Неопределено Тогда
		Настройки.Вставить("Часы", Часы);
	КонецЕсли;
	Если Исполнитель <> Неопределено Тогда
		Настройки.Вставить("Исполнитель", Исполнитель);
	КонецЕсли;

	Планировщик = Новый Планировщик(Настройки);

	ПредупредитьОбОтброшенномЧасе();

	Состав = Новый Массив();
	ЗарегистрироватьЗадачу(Состав, "сброс-статистики", "job.stats_flush",
		Расписания.Интервал(ИнтервалСтатистикиСек), ЗадачаСтатистики, КаждыеСекунд(ИнтервалСтатистикиСек));
	ЗарегистрироватьЗадачу(Состав, "gc-кэша-прокси", "job.proxy_gc",
		Расписания.Интервал(ИнтервалGCСек), ЗадачаGC, КаждыеСекунд(ИнтервалGCСек));
	ЗарегистрироватьЗадачу(Состав, "переиндексация-readme", "job.readme_reindex",
		Расписания.ЕжедневноВ(ЧасПереиндексацииREADME, 0), ЗадачаREADME,
		СтрШаблон("ежедневно в %1:00", ЧасПереиндексацииREADME));
	ЗарегистрироватьЗадачу(Состав, "синхронизация-зеркал", "job.mirror_sync",
		Расписания.Интервал(ИнтервалЗеркалСек), ЗадачаЗеркал, КаждыеСекунд(ИнтервалЗеркалСек));
	ЗарегистрироватьЗадачу(Состав, "чистка-заявок-cli", "job.cli_device_gc",
		Расписания.Интервал(ИнтервалЗаявокCLIСек), ЗадачаЗаявокCLI, КаждыеСекунд(ИнтервалЗаявокCLIСек));
	ЗарегистрироватьЗадачу(Состав, "чистка-приглашений", "job.invite_gc",
		Расписания.Интервал(ИнтервалПриглашенийСек), ЗадачаПриглашений, КаждыеСекунд(ИнтервалПриглашенийСек));
	ЗарегистрироватьЗадачу(Состав, "сверка-объёмов-пулов", "job.pool_volume_audit",
		Расписания.Интервал(ИнтервалСверкиОбъёмовСек), ЗадачаОбъёмов, КаждыеСекунд(ИнтервалСверкиОбъёмовСек));
	ЗарегистрироватьЗадачу(Состав, "здоровье-источников", "job.upstream_health",
		Расписания.Интервал(ИнтервалЗдоровьяСек), ЗадачаЗдоровья, КаждыеСекунд(ИнтервалЗдоровьяСек));

	Планировщик.Запустить();
	Настроен = Истина;

	Журнал.ОбъявитьСостав(Состав, ИнтервалТикаМс);

КонецПроцедуры

// Экземпляр планировщика os-scheduler для инспекции и детерминированного Тик().
//
// Возвращаемое значение:
//  Планировщик, Неопределено - планировщик; Неопределено до вызова Настроить().
//
Функция ЭкземплярПланировщика() Экспорт
	Возврат Планировщик;
КонецФункции

// Прекращает запуск новых задач и просит фоновый цикл завершиться.
//
// Параметры:
//  Отменять - Булево - Истина => жёсткая остановка: идущие выполнения помечаются
//             остановленными (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Число - активных выполнений на момент вызова.
//
Функция Остановить(Знач Отменять = Ложь) Экспорт

	ОстановкаЗапрошена = Истина;
	Если Планировщик = Неопределено Тогда
		Лог.Отладка("Планировщик: остановка запрошена до настройки — останавливать нечего");
		Возврат 0;
	КонецЕсли;

	Активных = Планировщик.Остановить(Отменять);
	Лог.Отладка("Планировщик: остановка запрошена (идущие отменяем: %1), активных выполнений %2",
		Отменять, Активных);
	Возврат Активных;

КонецФункции

// Настраивает планировщик и крутит фоновый цикл опроса задач до запроса остановки.
// При выключенной настройке oshub.jobs.enabled цикл не запускается.
//
Процедура ПриЗапускеПриложения() Экспорт

	// Перехват на всю рогатку: иначе смерть цикла не оставит в журнале ни строки —
	// ОСень фоновую рогатку с ОжидатьЗавершения = Ложь не дожидается.
	Попытка

		Если НЕ Включено Тогда
			Лог.Информация("Планировщик фоновых задач отключён (oshub.jobs.enabled=false)");
			// Выключен настройкой — осознанный выбор оператора, а не сбой: гейт закрываем.
			Готовность.ОтметитьЗадачуВыполненной("jobs.планировщик");
			Возврат;
		КонецЕсли;

		Настроить();

		// Отладка — ДО закрытия гейта: после него в теле не должно быть ничего, кроме
		// самого цикла, иначе падение оставит хаб объявленным готовым.
		Лог.Отладка("Планировщик: цикл опроса пошёл, шаг %1 мс", ИнтервалТикаМс);

		// Гейт закрывается до входа в цикл: цикл вечен по построению.
		Готовность.ОтметитьЗадачуВыполненной("jobs.планировщик");

		Пока НЕ ОстановкаЗапрошена Цикл
			ШагЦикла();
			Приостановить(ИнтервалТикаМс);
		КонецЦикла;

		Лог.Отладка("Планировщик: цикл вышел по запросу остановки, идущих выполнений %1",
			Планировщик.Активных());

		// Хвост грациозной остановки: дорабатываем уже идущие выполнения.
		Пока Планировщик.Активных() > 0 Цикл
			ШагЦикла();
			Приостановить(ИнтервалТикаМс);
		КонецЦикла;

		Лог.Информация("Фоновый цикл планировщика завершён");

	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог.Ошибка("Фоновый цикл планировщика прерван, фоновые задачи больше не выполняются: %1",
			Ошибки.Причина(Инфо));
		// отчёт стои́т разбора цепочки: собираем его только тогда, когда отладку включили
		Если Лог.Уровень() <= УровниЛога.Отладка Тогда
			Лог.Отладка("Фоновый цикл планировщика прерван, разбор целиком:%1%2",
				Символы.ПС, Ошибки.ПодробныйОтчёт(Инфо));
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Журнал снаружи — он отчитывается о задаче целиком, — спан внутри.
Процедура ЗарегистрироватьЗадачу(Состав, Знач Имя, Знач ИмяСпана, Знач Расписание,
	Знач Обработчик, Знач Описание)

	ПодСпаном = Новый ЗадачаПодСпаном(ИмяСпана, Обработчик, Телеметрия);
	Планировщик.Зарегистрировать(Имя, Расписание, Журнал.Обернуть(Имя, ПодСпаном));
	Состав.Добавить(Новый Структура("Имя, Описание", Имя, Описание));

КонецПроцедуры

Функция КаждыеСекунд(Знач Секунд)
	Возврат СтрШаблон("каждые %1 с", Секунд);
КонецФункции

// Один защищённый шаг цикла: сбой Тик() не должен ронять фоновое задание.
Процедура ШагЦикла()
	Попытка
		Планировщик.Тик();
	Исключение
		Лог.Ошибка("Сбой шага планировщика (изолирован, цикл продолжается): %1",
			Ошибки.Причина(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

// Ноль здесь осмыслен — это полночь, поэтому «не задано» отличается от нуля явно.
Функция РазобратьЧас(Знач Значение, Знач Дефолт)

	Если Значение = Неопределено Тогда
		Возврат Разобранный(Дефолт, "");
	КонецЕсли;

	Записанное = СокрЛП(Строка(Значение));
	Если НЕ ЗначениеЗаполнено(Записанное) Тогда
		Возврат Разобранный(Дефолт, "");
	КонецЕсли;

	Попытка
		Час = Цел(Число(Записанное));
	Исключение
		Возврат Разобранный(Дефолт, Записанное);
	КонецПопытки;

	Если Час < 0 ИЛИ Час > 23 Тогда
		Возврат Разобранный(Дефолт, Записанное);
	КонецЕсли;

	Возврат Разобранный(Час, "");

КонецФункции

Функция Разобранный(Знач Час, Знач Отброшено)
	Возврат Новый Структура("Час, Отброшено", Час, Отброшено);
КонецФункции

// Печатается здесь, а не в конструкторе: журнал приезжает инъекцией в поле после сборки объекта.
Процедура ПредупредитьОбОтброшенномЧасе()

	Если НЕ ЗначениеЗаполнено(ОтброшенныйЧасREADME) Тогда
		Возврат;
	КонецЕсли;

	Лог.Предупреждение(
		"Час переиндексации README ""%1"" вне суток — берём умолчание %2."
		+ " Допустимы целые 0–23 (настройка oshub.jobs.readme_reindex_hour)",
		ОтброшенныйЧасREADME, ЧасПереиндексацииREADME);

КонецПроцедуры

#КонецОбласти

&Рогатка(ЗапускатьВФоне = Истина, ОжидатьЗавершения = Ложь)
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗадачаСбросаСтатистики") _ЗадачаСтатистики,
	&Пластилин(Значение = "ЗадачаСбораКэшаПрокси") _ЗадачаGC,
	&Пластилин(Значение = "ЗадачаПереиндексацииREADME") _ЗадачаREADME,
	&Пластилин(Значение = "ЗадачаСинхронизацииЗеркал") _ЗадачаЗеркал,
	&Пластилин(Значение = "ЗадачаЧисткиЗаявокCLI") _ЗадачаЗаявокCLI,
	&Пластилин(Значение = "ЗадачаЧисткиПриглашений") _ЗадачаПриглашений,
	&Пластилин(Значение = "ЗадачаСверкиОбъёмовПулов") _ЗадачаОбъёмов,
	&Пластилин(Значение = "ЗадачаЗдоровьяИсточников") _ЗадачаЗдоровья,
	&Деталька(Значение = "oshub.jobs.stats_flush_interval_sec", ЗначениеПоУмолчанию = 60) _ИнтервалСтатистики = Неопределено,
	&Деталька(Значение = "oshub.jobs.proxy_gc_interval_sec", ЗначениеПоУмолчанию = 3600) _ИнтервалGC = Неопределено,
	&Деталька(Значение = "oshub.jobs.readme_reindex_hour", ЗначениеПоУмолчанию = 3) _ЧасREADME = Неопределено,
	&Деталька(Значение = "oshub.jobs.mirror_sync_interval_sec", ЗначениеПоУмолчанию = 3600) _ИнтервалЗеркал = Неопределено,
	&Деталька(Значение = "oshub.jobs.cli_device_gc_interval_sec", ЗначениеПоУмолчанию = 300) _ИнтервалЗаявокCLI = Неопределено,
	&Деталька(Значение = "oshub.jobs.invite_gc_interval_sec", ЗначениеПоУмолчанию = 3600) _ИнтервалПриглашений = Неопределено,
	&Деталька(Значение = "oshub.jobs.pool_volume_audit_interval_sec", ЗначениеПоУмолчанию = 3600) _ИнтервалСверкиОбъёмов = Неопределено,
	&Деталька(Значение = "oshub.jobs.upstream_health_interval_sec", ЗначениеПоУмолчанию = 60) _ИнтервалЗдоровья = Неопределено,
	&Деталька(Значение = "oshub.jobs.tick_interval_ms", ЗначениеПоУмолчанию = 1000) _ИнтервалТика = Неопределено,
	&Деталька(Значение = "oshub.jobs.enabled", ЗначениеПоУмолчанию = Истина) _Включено = Неопределено,
	&Пластилин(Значение = "ГотовностьХаба") _Готовность,
	&Пластилин(Значение = "ЖурналФоновыхЗадач") _Журнал,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "Телеметрия") _Телеметрия = Неопределено,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа = Неопределено,
	&Пластилин(Значение = "ПриведениеФлагов") _Флаги = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Готовность = _Готовность;
	Журнал = _Журнал;
	Телеметрия = _Телеметрия;
	Числа = ?(_Числа = Неопределено, Новый ПриведениеЧисел(), _Числа);
	Флаги = ?(_Флаги = Неопределено, Новый ПриведениеФлагов(), _Флаги);
	// Заявка в конструкторе: список гейтов должен быть полон до первого запуска рогаток.
	Готовность.ЗаявитьЗадачу("jobs.планировщик");

	ЗадачаСтатистики = _ЗадачаСтатистики;
	ЗадачаGC = _ЗадачаGC;
	ЗадачаREADME = _ЗадачаREADME;
	ЗадачаЗеркал = _ЗадачаЗеркал;
	ЗадачаЗаявокCLI = _ЗадачаЗаявокCLI;
	ЗадачаПриглашений = _ЗадачаПриглашений;
	ЗадачаОбъёмов = _ЗадачаОбъёмов;
	ЗадачаЗдоровья = _ЗадачаЗдоровья;

	ИнтервалСтатистикиСек = Числа.ЧислоИлиДефолт(_ИнтервалСтатистики, 60);
	ИнтервалGCСек = Числа.ЧислоИлиДефолт(_ИнтервалGC, 3600);
	РазобранныйЧас = РазобратьЧас(_ЧасREADME, 3);
	ЧасПереиндексацииREADME = РазобранныйЧас.Час;
	ОтброшенныйЧасREADME = РазобранныйЧас.Отброшено;
	ИнтервалСверкиОбъёмовСек = Числа.ЧислоИлиДефолт(_ИнтервалСверкиОбъёмов, 3600);
	ИнтервалЗдоровьяСек = Числа.ЧислоИлиДефолт(_ИнтервалЗдоровья, 60);
	ИнтервалЗеркалСек = Числа.ЧислоИлиДефолт(_ИнтервалЗеркал, 3600);
	ИнтервалЗаявокCLIСек = Числа.ЧислоИлиДефолт(_ИнтервалЗаявокCLI, 300);
	ИнтервалПриглашенийСек = Числа.ЧислоИлиДефолт(_ИнтервалПриглашений, 3600);
	ИнтервалТикаМс = Числа.ЧислоИлиДефолт(_ИнтервалТика, 1000);
	Включено = Флаги.ФлагИстина(_Включено, Истина);

	Часы = Неопределено;
	Исполнитель = Неопределено;
	Планировщик = Неопределено;
