// Обработчик os-scheduler: удаление заявок на установку пароля с истёкшим сроком.

Перем Приглашения;  // СервисПриглашений (auth)
Перем Телеметрия;   // фасад OTel (наблюдаемость), опционален

// Удаляет просроченные ссылки установки пароля за один проход.
// Сбой перебрасывается планировщику, пометив спан ошибкой.
//
Процедура Исполнить() Экспорт
	Спан = Неопределено;
	Если Телеметрия <> Неопределено Тогда
		Спан = Телеметрия.НачатьСпан("job.invite_gc", "internal");
	КонецЕсли;
	Попытка
		Приглашения.УдалитьПросроченные();
	Исключение
		Если Спан <> Неопределено Тогда
			Спан.Ошибка("сбой задачи");
			Спан.Завершить();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Если Спан <> Неопределено Тогда
		Спан.Завершить();
	КонецЕсли;
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПриглашений") _Приглашения,
	&Пластилин(Значение = "Телеметрия") _Телеметрия = Неопределено)

	Приглашения = _Приглашения;
	Телеметрия = _Телеметрия;

КонецПроцедуры
