// Регистрации фоновой задачи: имя и срок, переведённые в расписание os-scheduler и в строку
// для журнала старта. Задачу заполняет она сама, планировщик читает состав.

#Использовать os-scheduler

Перем Состав_;

// Интервальная регистрация. Первый запуск — через интервал после регистрации.
//
// Параметры:
//  Имя - Строка - имя задачи в планировщике.
//  Секунд - Число - интервал.
//
Процедура КаждыеСекунд(Знач Имя, Знач Секунд) Экспорт
	Добавить(Имя, Расписания.Интервал(Секунд), СтрШаблон("каждые %1 с", Секунд));
КонецПроцедуры

// Ежедневная регистрация в начале часа.
//
// Параметры:
//  Имя - Строка - имя задачи в планировщике.
//  Час - Число - час суток, 0–23.
//
Процедура ЕжедневноВ(Знач Имя, Знач Час) Экспорт
	Добавить(Имя, Расписания.ЕжедневноВ(Час, 0), СтрШаблон("ежедневно в %1:00", Час));
КонецПроцедуры

// Однократная регистрация с задержкой от старта: своего «первого запуска сразу»
// у интервала нет.
//
// Параметры:
//  Имя - Строка - имя задачи в планировщике.
//  Секунд - Число - задержка от регистрации.
//
Процедура ОднократноЧерез(Знач Имя, Знач Секунд) Экспорт
	Добавить(Имя, Расписания.Однократно(Секунд),
		СтрШаблон("однократно, через %1 с после старта", Секунд));
КонецПроцедуры

// Собранные регистрации.
//
// Возвращаемое значение:
//  Массив из Структура - Имя (Строка — имя задачи в планировщике и в журнале), Расписание
//                        (расписание os-scheduler), Описание (Строка — периодичность словами).
//
Функция Состав() Экспорт
	Возврат Состав_;
КонецФункции

Процедура Добавить(Знач Имя, Знач Расписание, Знач Описание)
	Состав_.Добавить(Новый Структура("Имя, Расписание, Описание", Имя, Расписание, Описание));
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Состав_ = Новый Массив();
КонецПроцедуры
