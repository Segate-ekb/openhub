// Кэши статистики: скачивания версий.

#Область ПубличныйИнтерфейс

// Имена кэшей предмета — контракт ИменаКэшей.
//
// Возвращаемое значение:
//  Массив из Строка - имена кэшей autumn-cache.
//
Функция Имена() Экспорт

	Имена = Новый Массив();
	Имена.Добавить("скачиванияВерсий");
	Возврат Имена;

КонецФункции

#КонецОбласти

&Прозвище("ИменаКэшей")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
