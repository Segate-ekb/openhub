// Ключи настроек статистики скачиваний: как часто и после скольких скачиваний счётчики
// сбрасываются в базу.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей статистики в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи статистики.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(150)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "oshub.stats.flush_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалСчётчиков = "",
	&Деталька(Значение = "oshub.stats.flush_threshold", ЗначениеПоУмолчанию = "") _ПорогСчётчиков = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	Ключи.Объявить("oshub.stats.flush_interval_sec", "целое", 60, _Правила.Минимум(1), "прикладная",
		_ИнтервалСчётчиков);
	Ключи.Объявить("oshub.stats.flush_threshold", "целое", 50, _Правила.Минимум(1), "прикладная",
		_ПорогСчётчиков);

КонецПроцедуры
