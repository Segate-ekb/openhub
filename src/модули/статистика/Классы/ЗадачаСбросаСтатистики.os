// Задача планировщика «сброс-статистики»: слив накопленных в памяти счётчиков скачиваний в БД.
// Сбросы службы идут по одному: идущий фоновый сброс по порогу задача дожидается.

Перем СлужбаСтатистики;  // СлужбаСтатистикиСкачиваний
Перем Интервал;          // интервал сброса из настройки, секунды

// Регистрация в планировщике: сброс раз в интервал из настройки.
//
// Параметры:
//  Регистрации - РегистрацииЗадачи - куда записывается регистрация.
//
Процедура Зарегистрировать(Регистрации) Экспорт
	Регистрации.КаждыеСекунд("сброс-статистики", Интервал);
КонецПроцедуры

// Выполняет один сброс накопленных агрегатов скачиваний в БД.
// Сбой сброса перебрасывается планировщику.
//
&Наблюдаемый("job.stats_flush")
Процедура Исполнить() Экспорт
	СлужбаСтатистики.Сбросить();
КонецПроцедуры

&Прозвище("ЗадачаПланировщика")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СлужбаСтатистикиСкачиваний") _СлужбаСтатистики,
	&Деталька(Значение = "oshub.jobs.stats_flush_interval_sec", ЗначениеПоУмолчанию = 60) _Интервал = Неопределено)

	СлужбаСтатистики = _СлужбаСтатистики;
	Интервал = Новый ПриведениеЧисел().ЧислоИлиДефолт(_Интервал, 60);

КонецПроцедуры
