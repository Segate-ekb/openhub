// Отметка «фоновый сброс скачиваний уже назначен»: одно задание за раз, сколько бы
// скачиваний ни набрало порог, пока оно работает.

Перем Назначен;   // Булево
Перем Замок;      // БлокировкаРесурса

// Ставит отметку, если её ещё нет.
//
// Возвращаемое значение:
//  Булево - Истина, если отметку поставил этот вызов; Ложь, если сброс уже назначен.
//
Функция Поставить() Экспорт

	Замок.Заблокировать();
	Поставлена = НЕ Назначен;
	Назначен = Истина;
	Замок.Разблокировать();

	Возврат Поставлена;

КонецФункции

// Снимает отметку: следующее скачивание, набравшее порог, назначит сброс заново.
//
Процедура Снять() Экспорт
	Замок.Заблокировать();
	Назначен = Ложь;
	Замок.Разблокировать();
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Назначен = Ложь;
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
КонецПроцедуры
