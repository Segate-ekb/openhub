// Подписчик события «скачивание.зафиксировано»: копит счёт в памяти, а в БД его укладывает
// пачкой фоновое задание — по порогу либо интервалу — и задача планировщика. Поток
// скачивания агрегатов в базу не пишет; порог он берёт из настроек, то есть из их кэша.
// Витрины спрашивают у службы скачивания тремя дверьми — пакет, горстка пакетов, весь
// хаб — и все три отвечают из одного разреза, сложенного в памяти этого процесса, чтобы
// одно число не расходилось между экранами.

Перем Счётчик;             // СчётчикСкачиванийВПамяти (статистика)
Перем Готовность;   // ГотовностьХаба (наблюдаемость)
Перем ХранилищеАгрегатов;  // ХранилищеСкачиванийАгрегатов (данные)
Перем ИздательСобытий;     // ИздательСобытий (события)
Перем Настройки;           // СервисНастроек (настройки) — срок и порог сброса счётчиков
Перем Фон;                 // ЗапускВФоне (фоновыеЗадания) — сброс по порогу идёт фоновым заданием
Перем ЗамокСброса;         // БлокировкаРесурса — в БД пишет один сброс за раз
Перем Назначение;          // НазначениеСброса (статистика) — фоновый сброс поставлен и не отработал
Перем ПоследнийСброс;      // Дата (UTC), Неопределено
Перем ПаузаДо;             // Дата (UTC), Неопределено - после сорвавшегося сброса порог молчит до неё
Перем Разрез;              // ФиксированнаяСтруктура - снимок прочитанной части из БД, см. НовыйРазрез
Перем Ошибки;              // ТекстОшибки (основа)
&Лог
Перем Лог;

#Область КонтрактПодписчикаСобытий

// Реагирует на доменное событие — контракт подписчика ИздателяСобытий.
// Обрабатывается только «скачивание.зафиксировано», прочие типы игнорируются.
//
// Параметры:
//  Событие - Структура - Тип (Строка), Данные (Структура с ПакетИдентификатор и ВерсияИдентификатор),
//            Когда (Дата, UTC, момент агрегации).
//
Процедура ОбработатьСобытие(Знач Событие) Экспорт

	Если Событие.Тип <> ИздательСобытий.ТипСкачиваниеЗафиксировано() Тогда
		Возврат;
	КонецЕсли;

	Данные = Событие.Данные;
	ЗафиксироватьСкачивание(Данные.ПакетИдентификатор, Данные.ВерсияИдентификатор, Событие.Когда);

КонецПроцедуры

#КонецОбласти

#Область ПубличныйИнтерфейс

// Фиксирует одно скачивание версии пакета в памяти. Набралось на порог либо истёк
// интервал — назначает сброс в БД фоновым заданием; агрегатов в базу сама не пишет.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  ВерсияИдентификатор - Число - идентификатор версии.
//  Момент - Дата - момент скачивания в UTC (необязательный, по умолчанию Неопределено — текущий).
//
Процедура ЗафиксироватьСкачивание(Знач ПакетИдентификатор, Знач ВерсияИдентификатор, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Накоплено = Счётчик.Зафиксировать(ПакетИдентификатор, ВерсияИдентификатор);

	Если ПоследнийСброс = Неопределено Тогда
		ПоследнийСброс = Сейчас;
	КонецЕсли;

	Если СледуетСбросить(Накоплено, Сейчас) Тогда
		НазначитьФоновыйСброс();
	КонецЕсли;

КонецПроцедуры

// Укладывает накопленные счётчики в БД. Сбросы идут по одному: следующий ждёт конца
// предыдущего, иначе два дописывания в одну строку агрегата затирают друг друга.
// Сорвавшаяся запись возвращает неуложенное в память и перебрасывает исключение.
// Идемпотентна: слив опустошает счётчик, повторный вызов ничего не добавит.
//
// Параметры:
//  Момент - Дата - момент в UTC, сутки которого служат ключом агрегации
//           (необязательный, по умолчанию Неопределено — текущий).
//
Процедура Сбросить(Знач Момент = Неопределено) Экспорт

	ЗамокСброса.Заблокировать();
	Попытка
		УложитьНакопленное(?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент));
	Исключение
		ЗамокСброса.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	ЗамокСброса.Разблокировать();

КонецПроцедуры

// Тело фонового сброса: укладывает накопленное, пока его набирается на порог. Сбой записи
// наружу не выпускает — исход фонового задания не смотрит никто, а неуложенное остаётся
// в памяти до следующего сброса. Отметку назначения снимает на любом выходе.
//
Процедура ОтработатьНазначенныйСброс() Экспорт

	Пока Истина Цикл

		Попытка
			Удалось = СброситьБезИсключения();
		Исключение
			Назначение.Снять();
			ВызватьИсключение;
		КонецПопытки;
		Назначение.Снять();

		// скачивания, пришедшие во время записи, назначить сброс не смогли — их берём здесь
		Если НЕ Удалось ИЛИ НЕ ПорогНабран() Тогда
			Прервать;
		КонецЕсли;
		Если НЕ Назначение.Поставить() Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Всего скачиваний пакета: агрегаты из БД плюс ещё не слитые счётчики из памяти,
// чтобы витрина не ждала ближайшего сброса.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Число - суммарное количество скачиваний.
//
Функция СкачиванийПакета(Знач ПакетИдентификатор) Экспорт

	Ключ = Цел(ПакетИдентификатор);
	Снимок = РазрезПакетов(ОдинИдентификатор(Ключ));
	Возврат СуммаИзРазреза(Снимок, Ключ) + Счётчик.ОжидающихПоПакету(Ключ);

КонецФункции

// Скачивания сразу по всем пакетам — витрине «популярное» нужен весь разрез, а запрос
// на каждый пакет превратил бы её в N+1.
//
// Возвращаемое значение:
//  Соответствие - идентификатор пакета -> суммарное количество скачиваний.
//
Функция СкачиванияПоПакетам() Экспорт

	Результат = Новый Соответствие();
	Для Каждого КиЗ Из ВесьРазрез().Суммы Цикл
		Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;

	Для Каждого КиЗ Из Счётчик.ОжидающиеПоПакетам() Цикл
		Накоплено = Результат.Получить(КиЗ.Ключ);
		Результат.Вставить(КиЗ.Ключ, ?(Накоплено = Неопределено, 0, Накоплено) + КиЗ.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Скачивания перечисленных пакетов — разрезом по списку, а не по всей таблице агрегатов:
// экрану, которому нужна горстка карточек, весь хаб читать незачем.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Соответствие - идентификатор пакета -> суммарное количество скачиваний
//                 (только по пакетам, у которых оно ненулевое).
//
Функция СкачиванияПакетов(Знач ПакетИдентификаторы) Экспорт

	Снимок = РазрезПакетов(ПакетИдентификаторы);

	Результат = Новый Соответствие();
	Для Каждого ПакетИдентификатор Из ПакетИдентификаторы Цикл
		Ключ = Цел(ПакетИдентификатор);
		Всего = СуммаИзРазреза(Снимок, Ключ) + Счётчик.ОжидающихПоПакету(Ключ);
		Если Всего <> 0 Тогда
			Результат.Вставить(Ключ, Всего);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Всего скачиваний хаба: сумма агрегатов в БД плюс ещё не слитое из памяти. Считается
// одним агрегатом, а не разрезом по пакетам: спрашивающему — эксплуатационному адресу
// и приборам телеметрии — нужно одно число, и читать ради него всю таблицу незачем.
//
// Возвращаемое значение:
//  Число - суммарное количество скачиваний.
//
Функция СкачиванийВсего() Экспорт
	Возврат ХранилищеАгрегатов.СуммаПоХабу() + Счётчик.ОжидающихВсего();
КонецФункции

// Всего скачиваний версии: агрегаты из БД плюс ещё не слитые счётчики из памяти,
// чтобы карточка версии не показывала ноль сразу после скачивания.
//
// Параметры:
//  ВерсияИдентификатор - Число - идентификатор версии.
//
// Возвращаемое значение:
//  Число - количество скачиваний версии.
//
Функция СкачиванийВерсии(Знач ВерсияИдентификатор) Экспорт
	Возврат ХранилищеАгрегатов.СуммаПоВерсии(ВерсияИдентификатор)
		+ Счётчик.ОжидающихПоВерсии(ВерсияИдентификатор);
КонецФункции

// Точка входа рогатки: подписывает службу на событие скачивания и закрывает гейт готовности.
// Подписка в стартовом хуке, а не в конструкторе: желуди ОСень инстанцирует лениво.
//
Процедура ПриЗапускеПриложения() Экспорт
	ИздательСобытий.Подписать(ИздательСобытий.ТипСкачиваниеЗафиксировано(), ЭтотОбъект);
	// Гейт закрывается последней строкой и без Попытка: сбой выше оставит /ready в 503
	Готовность.ОтметитьЗадачуВыполненной("stats.скачивания");
КонецПроцедуры

#КонецОбласти

#Область РазрезИзБазы

// Часть из БД у всех трёх дверей одна и та же и живёт по одному правилу свежести:
// разрез забывается, когда сменилось поколение таблицы агрегатов. Две двери с разными
// правилами показывали один пакет разными числами: лендинг брал сложенное однажды,
// кабинет — только что прочитанное.
//
// Поколение считает хранилище агрегатов ЭТОГО процесса, поэтому гарантия у правила
// ровно одна: разрез замечает записи, прошедшие через этот экземпляр хранилища — свой
// сброс буфера и любую запись мимо витрины в том же процессе. Записи соседней реплики,
// правка базы руками и удаление строк уборкой пакета поколения не двигают: до своей
// следующей записи витрина будет показывать сложенное раньше.
//
// Разрез спрашивают потоки запросов разом, поэтому он живёт снимком: снимок не меняется
// никогда, дочитанное публикуется НОВЫМ снимком одним присваиванием, и каждый читатель
// отвечает из того снимка, который получил. Два читателя, дочитавших разное одновременно,
// теряют чужое дочитанное — это лишнее чтение базы потом, а не испорченная карта.

Функция РазрезПакетов(Знач ПакетИдентификаторы)

	Снимок = СвежийРазрез();
	Если Снимок.Полный Тогда
		Возврат Снимок;
	КонецЕсли;

	Недостающие = Недостающие(Снимок, ПакетИдентификаторы);
	Если Недостающие.Количество() = 0 Тогда
		Возврат Снимок;
	КонецЕсли;

	// снимок с дочитанным публикуется ПОСЛЕ удавшегося чтения: сбой базы посреди разреза
	// пометил бы пакет прочитанным с пустой суммой, и карточка показывала бы ноль
	// до ближайшей записи в агрегаты
	Прочитанное = ХранилищеАгрегатов.СуммыПакетов(Недостающие);

	Суммы = Копия(Снимок.Суммы);
	Для Каждого КиЗ Из Прочитанное Цикл
		Суммы.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Прочитанные = Копия(Снимок.Прочитанные);
	Для Каждого Ключ Из Недостающие Цикл
		Прочитанные.Вставить(Ключ, Истина);
	КонецЦикла;

	Возврат Опубликовать(НовыйРазрез(Снимок.Поколение, Суммы, Прочитанные, Ложь));

КонецФункции

// Весь разрез собирается заново: суммы абсолютны, а сбой посреди чтения не должен
// оставить витрину с половиной таблицы.
Функция ВесьРазрез()

	Снимок = СвежийРазрез();
	Если Снимок.Полный Тогда
		Возврат Снимок;
	КонецЕсли;

	Возврат Опубликовать(НовыйРазрез(Снимок.Поколение, ХранилищеАгрегатов.СуммыПоПакетам(),
		Новый Соответствие(), Истина));

КонецФункции

// Пакеты, части из БД у которых ещё нет; повторы в списке спрашиваются один раз.
Функция Недостающие(Знач Снимок, Знач ПакетИдентификаторы)

	Результат = Новый Массив();
	Названные = Новый Соответствие();

	Для Каждого ПакетИдентификатор Из ПакетИдентификаторы Цикл
		Ключ = Цел(ПакетИдентификатор);
		Если Снимок.Прочитанные.Получить(Ключ) = Неопределено
			И Названные.Получить(Ключ) = Неопределено Тогда
			Названные.Вставить(Ключ, Истина);
			Результат.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СвежийРазрез()

	Снимок = Разрез;
	Поколение = ХранилищеАгрегатов.Поколение();
	Если Снимок.Поколение = Поколение Тогда
		Возврат Снимок;
	КонецЕсли;

	Возврат Опубликовать(НовыйРазрез(Поколение, Новый Соответствие(), Новый Соответствие(), Ложь));

КонецФункции

// Поколение - Число - поколение таблицы, на котором собран снимок;
// Суммы - ПакетИд -> Число; Прочитанные - ПакетИд -> Истина, у кого часть из БД спрошена;
// Полный - Булево, в Суммах лежит вся таблица агрегатов.
Функция НовыйРазрез(Знач Поколение, Знач Суммы, Знач Прочитанные, Знач Полный)
	Возврат Новый ФиксированнаяСтруктура("Поколение, Суммы, Прочитанные, Полный",
		Поколение, Новый ФиксированноеСоответствие(Суммы),
		Новый ФиксированноеСоответствие(Прочитанные), Полный);
КонецФункции

Функция Опубликовать(Знач Снимок)
	Разрез = Снимок;
	Возврат Снимок;
КонецФункции

Функция Копия(Знач Карта)
	Результат = Новый Соответствие();
	Для Каждого КиЗ Из Карта Цикл
		Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СуммаИзРазреза(Знач Снимок, Знач Ключ)
	Накоплено = Снимок.Суммы.Получить(Ключ);
	Возврат ?(Накоплено = Неопределено, 0, Накоплено);
КонецФункции

Функция ОдинИдентификатор(Знач Ключ)
	Список = Новый Массив();
	Список.Добавить(Ключ);
	Возврат Список;
КонецФункции

#КонецОбласти

#Область СбросВБазу

Процедура УложитьНакопленное(Знач Сейчас)

	ДатаДень = НачалоСуток(Сейчас);
	// интервал спрашивается до записи: при лежащей базе настройка может отказать сама
	// и подменить в обработчике исходную ошибку записи
	ПаузаПриСрыве = Сейчас + Интервал();
	Записи = Счётчик.Слить();
	УложеноСтрок = 0;

	Попытка
		Для Каждого Запись Из Записи Цикл
			ХранилищеАгрегатов.Накопить(Запись.Пакет, Запись.Версия, ДатаДень, Запись.Количество);
			УложеноСтрок = УложеноСтрок + 1;
		КонецЦикла;
	Исключение
		ВернутьНеуложенное(Записи, УложеноСтрок);
		// база отказала — скачивания не зовут её снова каждое, ждём следующего интервала
		ПаузаДо = ПаузаПриСрыве;
		ВызватьИсключение;
	КонецПопытки;

	ПоследнийСброс = Сейчас;
	ПаузаДо = Неопределено;

	Если Записи.Количество() > 0 Тогда
		Лог.Отладка("Статистика: в базу уложено скачиваний %1, строк агрегатов %2",
			Формат(СуммаЗаписей(Записи), "ЧГ=0; ЧН=0"), Формат(Записи.Количество(), "ЧГ=0; ЧН=0"));
	КонецЕсли;

КонецПроцедуры

// Уложенные строки уже в базе — назад в память едет только хвост, начиная с сорвавшейся.
Процедура ВернутьНеуложенное(Знач Записи, Знач УложеноСтрок)

	Для Индекс = УложеноСтрок По Записи.ВГраница() Цикл
		Запись = Записи[Индекс];
		Счётчик.Зафиксировать(Запись.Пакет, Запись.Версия, Запись.Количество);
	КонецЦикла;

КонецПроцедуры

Функция СброситьБезИсключения()

	Попытка
		Сбросить();
	Исключение
		Лог.Ошибка("Статистика: скачивания не уложены в базу — %1. Накопленное осталось"
			+ " в памяти и уйдёт следующим сбросом", Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Одно фоновое задание сброса за раз: пока оно не отработало, скачивания его не множат.
Процедура НазначитьФоновыйСброс()

	Если НЕ Назначение.Поставить() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Фон.Запустить(Новый СбросСкачиванийЗаданием(ЭтотОбъект));
	Исключение
		Назначение.Снять();
		Лог.Ошибка("Статистика: фоновый сброс скачиваний не запущен — %1. Накопленное"
			+ " уложит задача планировщика", Ошибки.Причина(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СледуетСбросить(Знач Накоплено, Знач Сейчас)

	// поле читается один раз: удачный сброс соседнего потока может обнулить его между чтениями
	Пауза = ПаузаДо;
	Если Пауза <> Неопределено И Сейчас < Пауза Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Накоплено >= Порог() Тогда
		Возврат Истина;
	КонецЕсли;

	Если ПоследнийСброс <> Неопределено И (Сейчас - ПоследнийСброс) >= Интервал() Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ПорогНабран()
	Возврат Счётчик.ОжидающихВсего() >= Порог();
КонецФункции

Функция Порог()
	Возврат Настройки.Значение("oshub.stats.flush_threshold");
КонецФункции

Функция Интервал()
	Возврат Настройки.Значение("oshub.stats.flush_interval_sec");
КонецФункции

Функция СуммаЗаписей(Знач Записи)
	Итог = 0;
	Для Каждого Запись Из Записи Цикл
		Итог = Итог + Запись.Количество;
	КонецЦикла;
	Возврат Итог;
КонецФункции

Функция НачалоСуток(Знач Момент)
	Возврат Дата(Год(Момент), Месяц(Момент), День(Момент), 0, 0, 0);
КонецФункции

#КонецОбласти

&Рогатка
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СчётчикСкачиванийВПамяти") _Счётчик,
	&Пластилин(Значение = "ХранилищеСкачиванийАгрегатов") _ХранилищеАгрегатов,
	&Пластилин(Значение = "ИздательСобытий") _ИздательСобытий,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ГотовностьХаба") _Готовность,
	&Пластилин(Значение = "ЗапускВФоне") _Фон,
	&Лог _Лог = Неопределено)

	Счётчик = _Счётчик;
	ХранилищеАгрегатов = _ХранилищеАгрегатов;
	ИздательСобытий = _ИздательСобытий;
	Готовность = _Готовность;
	// Заявка в конструкторе: список гейтов должен быть полон до первого запуска рогаток
	Готовность.ЗаявитьЗадачу("stats.скачивания");

	Настройки = _Настройки;
	Фон = _Фон;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Ошибки = Новый ТекстОшибки();
	ЗамокСброса = Новый БлокировкаРесурса(ЭтотОбъект);
	Назначение = Новый НазначениеСброса();
	ПоследнийСброс = Неопределено;
	ПаузаДо = Неопределено;
	Разрез = НовыйРазрез(ХранилищеАгрегатов.Поколение(), Новый Соответствие(), Новый Соответствие(), Ложь);

КонецПроцедуры
