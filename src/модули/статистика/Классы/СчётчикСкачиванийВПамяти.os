// Скачивания в разрезе (пакет, версия) в памяти, под БлокировкойРесурса. Слитое сбросом
// остаётся в счёте, пока сброс не отметит его уложенным в базу.

Перем Счётчики;   // Соответствие: Ключ (Строка) -> Структура(Пакет, Версия, Количество)
Перем Всего;      // Число - сумма всех счётчиков
Перем ВПути;      // Массив из Структура(Пакет, Версия, Количество) - слиты сбросом, в базу ещё не легли
Перем Блокировка; // БлокировкаРесурса

#Область ПубличныйИнтерфейс

// Инкрементит счётчик скачиваний версии пакета в памяти.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  ВерсияИдентификатор - Число - идентификатор версии.
//  Количество - Число - на сколько увеличить (необязательный, по умолчанию 1).
//
// Возвращаемое значение:
//  Число - сколько скачиваний накоплено всего, вместе с этим.
//
Функция Зафиксировать(Знач ПакетИдентификатор, Знач ВерсияИдентификатор, Знач Количество = 1) Экспорт

	Блокировка.Заблокировать();
	Попытка
		Прибавить(ПакетИдентификатор, ВерсияИдентификатор, Количество);
		Накоплено = Всего;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Возврат Накоплено;

КонецФункции

// Атомарно забирает накопленное и очищает счётчики. Забранное до отметки
// ОтметитьУложенной или Вернуть числится в пути и входит в число ожидающих.
//
// Возвращаемое значение:
//  Массив из Структура - Пакет, Версия, Количество (Число).
//
Функция Слить() Экспорт

	Блокировка.Заблокировать();
	Попытка
		Результат = Новый Массив();
		Для Каждого КиЗ Из Счётчики Цикл
			Результат.Добавить(КиЗ.Значение);
			ВПути.Добавить(КиЗ.Значение);
		КонецЦикла;
		Счётчики = Новый Соответствие();
		Всего = 0;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Снимает слитую запись с пути: она уложена в базу и считается уже там.
//
// Параметры:
//  Запись - Структура - элемент массива, который вернул Слить.
//
Процедура ОтметитьУложенной(Знач Запись) Экспорт

	Блокировка.Заблокировать();
	Попытка
		СнятьСПути(Запись);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

КонецПроцедуры

// Возвращает слитую запись, не дошедшую до базы, в накопленное.
//
// Параметры:
//  Запись - Структура - элемент массива, который вернул Слить.
//
Процедура Вернуть(Знач Запись) Экспорт

	Блокировка.Заблокировать();
	Попытка
		СнятьСПути(Запись);
		Прибавить(Запись.Пакет, Запись.Версия, Запись.Количество);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

КонецПроцедуры

// Число скачиваний, накопленных к следующему сбросу, — без слитых в путь.
//
// Возвращаемое значение:
//  Число.
//
Функция НакопленоКСбросу() Экспорт

	Блокировка.Заблокировать();
	Накоплено = Всего;
	Блокировка.Разблокировать();

	Возврат Накоплено;

КонецФункции

// Число ещё не уложенных в БД скачиваний по всему хабу, вместе со слитыми в путь.
//
// Возвращаемое значение:
//  Число.
//
Функция ОжидающихВсего() Экспорт

	Блокировка.Заблокировать();
	Попытка
		Итог = Всего;
		Для Каждого Запись Из ВПути Цикл
			Итог = Итог + Запись.Количество;
		КонецЦикла;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Возврат Итог;

КонецФункции

// Ещё не уложенные в БД скачивания сразу по всем пакетам, вместе со слитыми в путь, —
// витрине, которой нужен весь разрез, незачем спрашивать по разу на пакет.
//
// Возвращаемое значение:
//  Соответствие - идентификатор пакета -> число ожидающих скачиваний.
//
Функция ОжидающиеПоПакетам() Экспорт

	Блокировка.Заблокировать();
	Попытка
		Результат = Новый Соответствие();
		Для Каждого КиЗ Из Счётчики Цикл
			ДобавитьКПакету(Результат, КиЗ.Значение);
		КонецЦикла;
		Для Каждого Запись Из ВПути Цикл
			ДобавитьКПакету(Результат, Запись);
		КонецЦикла;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Ещё не уложенные в БД скачивания версий названных пакетов, вместе со слитыми в путь, —
// списку версий одним проходом.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Соответствие - идентификатор версии -> число ожидающих скачиваний.
//
Функция ОжидающиеПоВерсиям(Знач ПакетИдентификаторы) Экспорт

	Названные = Новый Соответствие();
	Для Каждого Идентификатор Из ПакетИдентификаторы Цикл
		Названные.Вставить(Цел(Идентификатор), Истина);
	КонецЦикла;

	Блокировка.Заблокировать();
	Попытка
		Результат = Новый Соответствие();
		Для Каждого КиЗ Из Счётчики Цикл
			Если Названные.Получить(Цел(КиЗ.Значение.Пакет)) <> Неопределено Тогда
				ДобавитьКВерсии(Результат, КиЗ.Значение);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Запись Из ВПути Цикл
			Если Названные.Получить(Цел(Запись.Пакет)) <> Неопределено Тогда
				ДобавитьКВерсии(Результат, Запись);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Число ещё не уложенных в БД скачиваний версии, вместе со слитыми в путь, — для свежести
// карточки версии.
//
// Параметры:
//  ВерсияИдентификатор - Число - идентификатор версии.
//
// Возвращаемое значение:
//  Число - ожидающий счётчик версии.
//
Функция ОжидающихПоВерсии(Знач ВерсияИдентификатор) Экспорт

	Блокировка.Заблокировать();
	Попытка
		Итог = 0;
		Для Каждого КиЗ Из Счётчики Цикл
			Итог = Итог + КоличествоВерсии(КиЗ.Значение, ВерсияИдентификатор);
		КонецЦикла;
		Для Каждого Запись Из ВПути Цикл
			Итог = Итог + КоличествоВерсии(Запись, ВерсияИдентификатор);
		КонецЦикла;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Прибавить(Знач ПакетИдентификатор, Знач ВерсияИдентификатор, Знач Количество)

	Ключ = СформироватьКлюч(ПакетИдентификатор, ВерсияИдентификатор);
	Текущий = Счётчики.Получить(Ключ);
	Если Текущий = Неопределено Тогда
		Счётчики.Вставить(Ключ, Новый Структура("Пакет, Версия, Количество",
			ПакетИдентификатор, ВерсияИдентификатор, Количество));
	Иначе
		Текущий.Количество = Текущий.Количество + Количество;
	КонецЕсли;
	Всего = Всего + Количество;

КонецПроцедуры

Процедура СнятьСПути(Знач Запись)
	Индекс = ВПути.Найти(Запись);
	Если Индекс <> Неопределено Тогда
		ВПути.Удалить(Индекс);
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьКПакету(Суммы, Знач Запись)
	Ключ = Цел(Запись.Пакет);
	Накоплено = Суммы.Получить(Ключ);
	Суммы.Вставить(Ключ, ?(Накоплено = Неопределено, 0, Накоплено) + Запись.Количество);
КонецПроцедуры

Процедура ДобавитьКВерсии(Суммы, Знач Запись)
	Ключ = Цел(Запись.Версия);
	Накоплено = Суммы.Получить(Ключ);
	Суммы.Вставить(Ключ, ?(Накоплено = Неопределено, 0, Накоплено) + Запись.Количество);
КонецПроцедуры

Функция КоличествоВерсии(Знач Запись, Знач ВерсияИдентификатор)
	Возврат ?(Запись.Версия = ВерсияИдентификатор, Запись.Количество, 0);
КонецФункции

Функция СформироватьКлюч(Знач ПакетИдентификатор, Знач ВерсияИдентификатор)
	Возврат Формат(ПакетИдентификатор, "ЧГ=0; ЧН=0") + "|" + Формат(ВерсияИдентификатор, "ЧГ=0; ЧН=0");
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
	Счётчики = Новый Соответствие();
	Всего = 0;
	ВПути = Новый Массив();
	Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
КонецПроцедуры
