// Накопление скачиваний в разрезе (пакет, версия) в памяти, без обращения к БД на каждый GET.
// Доступ сериализован БлокировкойРесурса.

Перем Счётчики;   // Соответствие: Ключ (Строка) -> Структура(Пакет, Версия, Количество)
Перем Блокировка; // БлокировкаРесурса

#Область ПубличныйИнтерфейс

// Инкрементит счётчик скачиваний версии пакета в памяти.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  ВерсияИдентификатор - Число - идентификатор версии.
//  Количество - Число - на сколько увеличить (необязательный, по умолчанию 1).
//
Процедура Зафиксировать(Знач ПакетИдентификатор, Знач ВерсияИдентификатор, Знач Количество = 1) Экспорт

	Блокировка.Заблокировать();
	Попытка
		Ключ = СформироватьКлюч(ПакетИдентификатор, ВерсияИдентификатор);
		Текущий = Счётчики.Получить(Ключ);
		Если Текущий = Неопределено Тогда
			Счётчики.Вставить(Ключ, Новый Структура("Пакет, Версия, Количество",
				ПакетИдентификатор, ВерсияИдентификатор, Количество));
		Иначе
			Текущий.Количество = Текущий.Количество + Количество;
		КонецЕсли;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

КонецПроцедуры

// Атомарно забирает накопленное и очищает счётчики.
//
// Возвращаемое значение:
//  Массив из Структура - Пакет, Версия, Количество (Число).
//
Функция Слить() Экспорт

	Блокировка.Заблокировать();
	Попытка
		Результат = Новый Массив();
		Для Каждого КиЗ Из Счётчики Цикл
			Результат.Добавить(КиЗ.Значение);
		КонецЦикла;
		Счётчики = Новый Соответствие();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Число ещё не слитых в БД скачиваний пакета — для свежести витрины.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Число - сумма ожидающих счётчиков по всем версиям пакета.
//
Функция ОжидающихПоПакету(Знач ПакетИдентификатор) Экспорт

	Блокировка.Заблокировать();
	Попытка
		Итог = 0;
		Для Каждого КиЗ Из Счётчики Цикл
			Если КиЗ.Значение.Пакет = ПакетИдентификатор Тогда
				Итог = Итог + КиЗ.Значение.Количество;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Возврат Итог;

КонецФункции

// Ещё не слитые в БД скачивания сразу по всем пакетам — витрине, которой нужен весь
// разрез, незачем спрашивать по разу на пакет.
//
// Возвращаемое значение:
//  Соответствие - идентификатор пакета -> число ожидающих скачиваний.
//
Функция ОжидающиеПоПакетам() Экспорт

	Блокировка.Заблокировать();
	Попытка
		Результат = Новый Соответствие();
		Для Каждого КиЗ Из Счётчики Цикл
			Ключ = Цел(КиЗ.Значение.Пакет);
			Накоплено = Результат.Получить(Ключ);
			Результат.Вставить(Ключ, ?(Накоплено = Неопределено, 0, Накоплено) + КиЗ.Значение.Количество);
		КонецЦикла;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Число ещё не слитых в БД скачиваний версии — для свежести карточки версии.
//
// Параметры:
//  ВерсияИдентификатор - Число - идентификатор версии.
//
// Возвращаемое значение:
//  Число - ожидающий счётчик версии.
//
Функция ОжидающихПоВерсии(Знач ВерсияИдентификатор) Экспорт

	Блокировка.Заблокировать();
	Попытка
		Итог = 0;
		Для Каждого КиЗ Из Счётчики Цикл
			Если КиЗ.Значение.Версия = ВерсияИдентификатор Тогда
				Итог = Итог + КиЗ.Значение.Количество;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьКлюч(Знач ПакетИдентификатор, Знач ВерсияИдентификатор)
	Возврат Формат(ПакетИдентификатор, "ЧГ=0; ЧН=0") + "|" + Формат(ВерсияИдентификатор, "ЧГ=0; ЧН=0");
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
	Счётчики = Новый Соответствие();
	Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
КонецПроцедуры
