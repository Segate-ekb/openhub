// Работа фонового задания: уложить накопленные скачивания в БД вне потока, который их
// зафиксировал, — скачивание базу не ждёт.

Перем Служба;  // СлужбаСтатистикиСкачиваний (статистика)

// Укладывает накопленное. Своего перехвата здесь нет: служба наружу не бросает и сама
// пишет о сбое в журнал.
//
Процедура Исполнить() Экспорт
	Служба.ОтработатьНазначенныйСброс();
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач _Служба)
	Служба = _Служба;
КонецПроцедуры
