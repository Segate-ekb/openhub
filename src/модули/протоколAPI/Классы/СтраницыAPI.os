// Страница списка API: номер и размер из query-параметров, потолок выдачи, срез и единый
// конверт. Разметки различаются тем, кто выбрал размер: клиент, хаб либо доменный сервис.

Перем Настройки;  // СервисНастроек (настройки) — размер листания и потолок выдачи
Перем Числа;      // ПриведениеЧисел (основа) — строгое чтение числа из query-параметра

#Область Разметка

// Разметка страницы ручки, которую листают: пулы, пакеты пула, поиск, группы. Клиент,
// не назвавший размер, получает размер листания хаба (oshub.api.page_size).
//
// Параметры:
//  page - Строка - сырое значение параметра номера страницы.
//  pageSize - Строка - сырое значение параметра размера страницы.
//
// Возвращаемое значение:
//  Структура - Номер (Число), Размер (Число).
//
Функция РазметкаЛистания(Знач page, Знач pageSize) Экспорт
	Возврат Разметка(page, pageSize, РазмерЛистания());
КонецФункции

// Разметка страницы ручки, отдающей свой список целиком. Клиент, не назвавший размер,
// получает страницу во весь потолок выдачи (oshub.api.page_max).
//
// Параметры:
//  page - Строка - сырое значение параметра номера страницы.
//  pageSize - Строка - сырое значение параметра размера страницы.
//
// Возвращаемое значение:
//  Структура - Номер (Число), Размер (Число).
//
Функция РазметкаЦеликом(Знач page, Знач pageSize) Экспорт
	Возврат Разметка(page, pageSize, Потолок());
КонецФункции

// Разметка страницы, которую разрезал сам доменный сервис: номер и размер он уже выбрал,
// и конверт обязан назвать выбранные им, а не запрошенные клиентом.
//
// Параметры:
//  Номер - Число - номер страницы, который вернул сервис.
//  Размер - Число - размер страницы, который вернул сервис.
//
// Возвращаемое значение:
//  Структура - Номер (Число), Размер (Число).
//
Функция РазметкаОтСервиса(Знач Номер, Знач Размер) Экспорт
	Возврат Новый Структура("Номер, Размер", Макс(1, Цел(Номер)), Макс(1, Цел(Размер)));
КонецФункции

#КонецОбласти

#Область Выдача

// Страница ручки, отдававшей список целиком, одной дверью: разметка, срез и конверт
// для готового массива элементов.
//
// Параметры:
//  Список - Массив - все элементы, которые ручка нашла.
//  page - Строка - сырое значение параметра номера страницы.
//  pageSize - Строка - сырое значение параметра размера страницы.
//  ИмяСписка - Строка - имя поля с элементами (необязательный, по умолчанию "items";
//              своё имя у versions, tags и tokens).
//
// Возвращаемое значение:
//  Структура - конверт страницы.
//
Функция Перечень(Знач Список, Знач page, Знач pageSize, Знач ИмяСписка = "items") Экспорт
	Разметка = РазметкаЦеликом(page, pageSize);
	Возврат Конверт(Срез(Список, Разметка), Список.Количество(), Разметка, ИмяСписка);
КонецФункции

// Срез массива по разметке — когда доменный сервис сам не пагинирует.
//
// Параметры:
//  Список - Массив - все элементы, которые ручка нашла.
//  Разметка - Структура - результат любой из трёх разметок.
//
// Возвращаемое значение:
//  Массив - элементы страницы; пустой при выходе за границы.
//
Функция Срез(Знач Список, Знач Разметка) Экспорт

	Результат = Новый Массив();
	Начало = (Разметка.Номер - 1) * Разметка.Размер;
	Для Индекс = Начало По Начало + Разметка.Размер - 1 Цикл
		Если Индекс >= 0 И Индекс < Список.Количество() Тогда
			Результат.Добавить(Список[Индекс]);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Единая форма страницы в выдаче API.
//
// Параметры:
//  Элементы - Массив - элементы текущей страницы.
//  Всего - Число - общее число элементов до среза.
//  Разметка - Структура - результат любой из трёх разметок.
//  ИмяСписка - Строка - имя поля с элементами (необязательный, по умолчанию "items").
//
// Возвращаемое значение:
//  Структура - items, page, pageSize, total, has_more.
//
Функция Конверт(Знач Элементы, Знач Всего, Знач Разметка, Знач ИмяСписка = "items") Экспорт

	Страница = Новый Структура();
	Страница.Вставить(ИмяСписка, Элементы);
	Страница.Вставить("page", Разметка.Номер);
	Страница.Вставить("pageSize", Разметка.Размер);
	Страница.Вставить("total", Всего);
	// усечение не молчит: за потолком выдачи осталось ещё
	Страница.Вставить("has_more", Разметка.Номер * Разметка.Размер < Всего);
	Возврат Страница;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Размер порции в заданных границах: мусор и пустота дают умолчание, любое значение —
// не больше максимума. Им меряет порцию и срез изменений (limit).
//
// Параметры:
//  Значение - Строка - сырое значение параметра.
//  ПоУмолчанию - Число - размер при пустом или непригодном значении.
//  Максимум - Число - верхняя граница размера.
//
// Возвращаемое значение:
//  Число - размер в границах от 1 до Максимум.
//
Функция Размер(Знач Значение, Знач ПоУмолчанию, Знач Максимум) Экспорт

	Граница = Макс(1, Цел(Максимум));
	Запрошенный = Числа.ЦелоеИлиНеопределено(Значение, Неопределено);
	Если Запрошенный = Неопределено ИЛИ Запрошенный < 1 Тогда
		// умолчание тоже под границей
		Возврат Мин(Макс(1, Цел(ПоУмолчанию)), Граница);
	КонецЕсли;
	Возврат Мин(Запрошенный, Граница);

КонецФункции

Функция Разметка(Знач page, Знач pageSize, Знач РазмерПоУмолчанию)
	Возврат Новый Структура("Номер, Размер",
		Номер(page), Размер(pageSize, РазмерПоУмолчанию, Потолок()));
КонецФункции

// Мусор и пустота дают первую страницу, а не отказ.
Функция Номер(Знач Значение)
	Прочитанный = Числа.ЦелоеИлиНеопределено(Значение, Неопределено);
	Возврат ?(Прочитанный = Неопределено, 1, Макс(1, Прочитанный));
КонецФункции

// Сколько элементов ручка API отдаёт в одном ответе максимум.
Функция Потолок()
	Возврат Целое("oshub.api.page_max", 200);
КонецФункции

// Размер страницы ручки, которую листают, когда клиент его не назвал.
Функция РазмерЛистания()
	Возврат Целое("oshub.api.page_size", 20);
КонецФункции

// Без модуля настроек — умолчания кода.
Функция Целое(Знач Ключ, Знач Дефолт)
	Возврат ?(Настройки = Неопределено, Дефолт, Настройки.Целое(Ключ, Дефолт, 1));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек", Тип = "Массив") _Настройки = Неопределено,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа = Неопределено)

	Желуди = Новый ВнедрённыеЖелуди();
	Настройки = Желуди.ПервыйИз(_Настройки);
	Числа = ?(_Числа = Неопределено, Новый ПриведениеЧисел(), _Числа);

КонецПроцедуры
