// Ключи настроек API: размер страницы списковых ручек по умолчанию и потолок выдачи.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей API в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи API.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(140)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "oshub.api.page_size", ЗначениеПоУмолчанию = "") _СтраницаAPI = "",
	&Деталька(Значение = "oshub.api.page_max", ЗначениеПоУмолчанию = "") _ПотолокСтраницыAPI = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	// предел инсталляции, а не оформление: правится файлом настроек
	Ключи.Объявить("oshub.api.page_size", "целое", 20, _Правила.Минимум(1), "bootstrap", _СтраницаAPI);
	Ключи.Объявить("oshub.api.page_max", "целое", 200, _Правила.Минимум(1), "bootstrap", _ПотолокСтраницыAPI);

КонецПроцедуры
