// Контроллер очереди заявок на публикацию API: список «входящих» пула, сводка по всем
// пулам принципала, одобрение и отклонение. Доменные операции — РассмотрениеВходящих.

Перем Помощник;      // ПомощникAPI (api)
Перем Рассмотрение;  // РассмотрениеВходящих (публикация) — видимость, одобрение, отклонение

#Область ТочкиМаршрута

// GET /api/v1/inbox — заявки из всех пулов, где принципал мейнтейнер и выше.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("inbox")
Процедура СводкаЗаявок(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Помощник.НачатьЧтение(Ответ, ПараметрыЗапросаПорядковые, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Если Помощник.ТребоватьПользователя(Ответ, ЗаголовкиЗапроса, КукиЗапроса) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// порога на самой сводке нет: она и есть отбор «где я вправе решать», пулы без права
	// в неё не попадают
	ОтдатьСписок(Ответ, Рассмотрение.ОжидающиеПринципала(
		Помощник.Принципал(ЗаголовкиЗапроса, КукиЗапроса)));

КонецПроцедуры

// GET /api/v1/pools/{Пул}/inbox — заявки, ждущие решения в пуле. Невидимый пул неотличим
// от несуществующего (404), видимый без права мейнтейнера — 403.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/inbox")
Процедура ЗаявкиПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Помощник.НачатьЧтение(Ответ, ПараметрыЗапросаПорядковые, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Принц = Помощник.ТребоватьПринципала(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Принц = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПулОбъект = Помощник.АдминистрируемыйПул(Ответ, Пул, Принц);
	Если ПулОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОтдатьСписок(Ответ, Рассмотрение.СтрокиПула(Принц, ПулОбъект));

КонецПроцедуры

// POST /api/v1/pools/{Пул}/inbox/{Заявка}/approve — одобрить заявку: версия публикуется
// от имени заявителя, он становится мейнтейнером пакета.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Заявка - Строка - номер заявки из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только POST.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/inbox/{Заявка}/approve")
Процедура ОдобритьЗаявку(Ответ, Пул, Заявка, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса,
	МетодЗапроса, ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Решить(Ответ, Пул, Заявка, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
		ПараметрыЗапросаПорядковые, "одобрить");

КонецПроцедуры

// POST /api/v1/pools/{Пул}/inbox/{Заявка}/reject — отклонить заявку: артефакт стирается,
// права не выдаются; причина (поля причина | reason) видна заявителю.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Заявка - Строка - номер заявки из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только POST.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/inbox/{Заявка}/reject")
Процедура ОтклонитьЗаявку(Ответ, Пул, Заявка, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса,
	МетодЗапроса, ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Решить(Ответ, Пул, Заявка, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
		ПараметрыЗапросаПорядковые, "отклонить");

КонецПроцедуры

#КонецОбласти

#Область Действия

// Порядок проверок один на оба решения: метод, гейт, видимость пула, право, заявка, домен.
Процедура Решить(Ответ, Знач ИмяПула, Знач НомерИзАдреса, Знач ЗаголовкиЗапроса,
	Знач КукиЗапроса, Знач ТелоЗапроса, Знач МетодЗапроса, Знач Порядковые, Знач Операция)

	Если НЕ Помощник.НачатьДействие(Ответ, Порядковые, МетодЗапроса, "POST") Тогда
		Возврат;
	КонецЕсли;

	Мутация = Помощник.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, ИмяПула);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Пул = Помощник.АдминистрируемыйПулМутации(Ответ, ИмяПула, Мутация.Принц);
	Если Пул = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Номер = ЦелоеИзАдреса(НомерИзАдреса);
	Если Номер = 0 Тогда
		Помощник.Ошибка(Ответ, 404, "request_not_found", "Заявка не найдена");
		Возврат;
	КонецЕсли;

	// заявка ищется в пуле из адреса: подставить номер соседнего пула нельзя, даже
	// когда права на тот пул есть
	Контекст = Рассмотрение.ЗаявкаКРассмотрению(Мутация.Принц, Номер);
	Если НЕ Контекст.Успех Тогда
		Помощник.Ошибка(Ответ, Контекст.Код, КодОшибки(Контекст.Код), Контекст.Сообщение);
		Возврат;
	КонецЕсли;
	Если Цел(Контекст.Пул.Идентификатор) <> Цел(Пул.Идентификатор) Тогда
		Помощник.Ошибка(Ответ, 404, "request_not_found", "Заявка не найдена в этом пуле");
		Возврат;
	КонецЕсли;

	Если Операция = "одобрить" Тогда
		Итог = Рассмотрение.Одобрить(Мутация.Принц, Номер);
	Иначе
		Итог = Рассмотрение.Отклонить(Мутация.Принц, Номер,
			Помощник.Поле(Мутация.Тело, "причина", Помощник.Поле(Мутация.Тело, "reason")));
	КонецЕсли;

	Если НЕ Итог.Успех Тогда
		Помощник.Ошибка(Ответ, Итог.Код, КодОшибки(Итог.Код), Итог.Сообщение);
		Возврат;
	КонецЕсли;

	Помощник.JSON(Ответ, 200, Новый Структура("status, message",
		?(Операция = "одобрить", "approved", "rejected"), Итог.Сообщение));

КонецПроцедуры

Процедура ОтдатьСписок(Ответ, Знач Строки)

	Элементы = Новый Массив();
	Для Каждого Строка_ Из Строки Цикл
		Элементы.Добавить(ЗаявкаJSON(Строка_));
	КонецЦикла;
	Помощник.JSON(Ответ, 200, Новый Структура("items, total", Элементы, Элементы.Количество()));

КонецПроцедуры

Функция ЗаявкаJSON(Знач Строка_)

	Заявка = Строка_.Заявка;

	Результат = Новый Структура();
	Результат.Вставить("id", Цел(Заявка.Идентификатор));
	Результат.Вставить("pool", Строка(Строка_.Пул.Имя));
	Результат.Вставить("package", Строка(Заявка.ИмяПакета));
	Результат.Вставить("version", Строка(Заявка.Версия));
	Результат.Вставить("applicant", ?(Строка_.Заявитель = Неопределено, "",
		Строка(Строка_.Заявитель.Логин)));
	Результат.Вставить("manifest_author", Строка(Заявка.АвторМанифеста));
	Результат.Вставить("channel", Строка(Заявка.Канал));
	Результат.Вставить("file_name", Строка(Заявка.ИмяФайла));
	Результат.Вставить("size", Цел(Заявка.Размер));
	Результат.Вставить("sha256", Строка(Заявка.Sha256));
	Результат.Вставить("state", Строка(Заявка.Состояние));
	Результат.Вставить("created", Формат(Заявка.Создана, "ДФ=""yyyy-MM-ddTHH:mm:ss"""));
	Возврат Результат;

КонецФункции

// Номер из адреса: только цифры. Мусор даёт 0 и превращается в 404, а не в исключение.
Функция ЦелоеИзАдреса(Знач Значение)

	Текст = СокрЛП(Строка(Значение));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Для Поз = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Поз, 1)) = 0 Тогда
			Возврат 0;
		КонецЕсли;
	КонецЦикла;
	Возврат Число(Текст);

КонецФункции

Функция КодОшибки(Знач Код)

	Если Код = 404 Тогда
		Возврат "request_not_found";
	ИначеЕсли Код = 403 Тогда
		Возврат "forbidden";
	ИначеЕсли Код = 401 Тогда
		Возврат "unauthorized";
	ИначеЕсли Код = 409 Тогда
		Возврат "request_conflict";
	ИначеЕсли Код = 410 Тогда
		Возврат "artifact_gone";
	КонецЕсли;
	Возврат "request_failed";

КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПомощникAPI") _Помощник,
	&Пластилин(Значение = "РассмотрениеВходящих") _Рассмотрение)

	Помощник = _Помощник;
	Рассмотрение = _Рассмотрение;

КонецПроцедуры
