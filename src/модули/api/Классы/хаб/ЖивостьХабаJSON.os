// Живость хаба: версия, время работы и состояние базы.

&Сериализуемое("status")
&Заполнено
&Тип("Строка")
&ОдинИз("ok")
Перем Состояние;

&Сериализуемое("version")
&Заполнено
&Тип("Строка")
Перем Версия;

&Сериализуемое("uptime_seconds")
&Заполнено
&Тип("Число")
Перем СекундРаботы;

&Сериализуемое("database")
&Заполнено
&Тип("СостояниеБазыJSON")
Перем База;
