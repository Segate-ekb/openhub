// Эксплуатационные числа хаба; непосчитанное число равно -1.

&Сериализуемое("status")
&Заполнено
&Тип("Строка")
&ОдинИз("ok")
Перем Состояние;

&Сериализуемое("version")
&Заполнено
&Тип("Строка")
Перем Версия;

&Сериализуемое("uptime_seconds")
&Заполнено
&Тип("Число")
Перем СекундРаботы;

&Сериализуемое("pools_total")
&Заполнено
&Тип("Число")
Перем Пулов;

&Сериализуемое("packages_total")
&Заполнено
&Тип("Число")
Перем Пакетов;

&Сериализуемое("downloads_total")
&Заполнено
&Тип("Число")
Перем Скачиваний;

&Сериализуемое("storage_used_bytes")
&Заполнено
&Тип("Число")
Перем ЗанятоБайт;
