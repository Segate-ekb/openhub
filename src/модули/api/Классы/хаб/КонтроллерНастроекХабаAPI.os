// Настройки хаба в API: карточки реестра на чтение, значение на правку и сброс. Судит
// и записывает СервисНастроек, своих проверок здесь нет.

Перем Ответы;       // ОтветыAPI (основа)
Перем Запрос;       // ЗапросAPI (протоколAPI)
Перем Маршрут;      // МаршрутAPI (протоколAPI)
Перем Допуск;       // ДопускAPI (api)
Перем ГейтМутации;  // ГейтМутацииAPI (api)
Перем ПорогиПрав;   // ПорогиПравAPI (api)
Перем Страницы;     // СтраницыAPI (протоколAPI)
Перем Настройки;    // СервисНастроек (настройки) — карточки, правка и сброс
Перем Разделы;      // РазделыНастроекХаба (настройки) — раздел ключа
Перем HTTP;         // МетодыHTTP (основа)
Перем Ошибки;       // ТекстОшибки (основа) — доменный отказ одной строкой
&Лог
Перем Лог;

#Область ТочкиМаршрута

// Настройки хаба.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  section - Строка - раздел дома «Хаб» («mail», «branding», …); пусто — все разделы
//            (необязательный, по умолчанию пустая строка).
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию — весь список
//             до потолка выдачи).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("hub/settings", Метод = "get")
&Операция(Сводка = "Настройки хаба",
	Описание = "Карточки настроек; `section` сужает выдачу до раздела. Только администратор хаба.")
&Возвращает(Код = 200, Описание = "Карточки настроек")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden` — нет права")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 404, Описание = "`unknown_section` — раздела нет")
Процедура НастройкиХаба(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, section = "",
	page = "", pageSize = "", ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.НачатьЧтение(Ответ, ПараметрыЗапросаПорядковые, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Список(Ответ, section, ЗаголовкиЗапроса, КукиЗапроса, page, pageSize);

КонецПроцедуры

// Настройка хаба: карточка, правка и сброс.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Ключ - Строка - ключ настройки из адреса («oshub.mail.smtp.host»).
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для PATCH и DELETE.
//  МетодЗапроса - Строка - метод запроса; допустимы GET, PATCH и DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("hub/settings/{Ключ}", Метод = "get, patch, delete")
&Операция(Сводка = "Настройка хаба (GET); задание значения (PATCH); сброс значения (DELETE)",
	Описание = "GET — настройка, PATCH — задаёт ей значение `value`, DELETE — сбрасывает значение
	|к конфигурации или умолчанию. Только администратор хаба.")
&Возвращает(Код = 200, Описание = "Карточка настройки")
&Возвращает(Код = 400, Описание = "`no_value` — нет поля `value`")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 404, Описание = "`unknown_setting` — настройки нет")
&Возвращает(Код = 409, Описание = "`forced_by_config`, `mechanism_only`, `not_editable`")
&Возвращает(Код = 422, Описание = "`invalid_value` — значение не принято")
Процедура НастройкаХаба(Ответ, Ключ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Показать(Ответ, Ключ, ЗаголовкиЗапроса, КукиЗапроса);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "PATCH") Тогда
		Задать(Ответ, Ключ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		Убрать(Ответ, Ключ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Иначе
		Маршрут.МетодНеРазрешён(Ответ, "GET, PATCH, DELETE");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура Список(Ответ, Знач ИмяРаздела, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач page, Знач pageSize)

	Если НЕ ДопущенКНастройкам(Ответ, ЗаголовкиЗапроса, КукиЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Отбор = НРег(СокрЛП(Строка(ИмяРаздела)));
	Карточки = Настройки.Карточки();
	Известные = ИменаРазделов(Карточки);

	Если ЗначениеЗаполнено(Отбор) И Известные.Найти(Отбор) = Неопределено Тогда
		Ответы.Ошибка(Ответ, 404, "unknown_section", СтрШаблон(
			"Раздела ""%1"" в настройках хаба нет; есть: %2",
			ИмяРаздела, СтрСоединить(Известные, ", ")));
		Возврат;
	КонецЕсли;

	Элементы = Новый Массив();
	Для Каждого Карточка Из Карточки Цикл
		Если НЕ ЗначениеЗаполнено(Отбор) ИЛИ Разделы.РазделКлюча(Карточка.Ключ) = Отбор Тогда
			Элементы.Добавить(НастройкаВJSON(Карточка));
		КонецЕсли;
	КонецЦикла;

	Лог.Отладка("Настройки хаба API: раздел ""%1"" — отдаём %2 карточек из %3",
		Отбор, Элементы.Количество(), Карточки.Количество());

	Ответы.JSON(Ответ, 200, Страницы.Перечень(Элементы, page, pageSize));

КонецПроцедуры

Процедура Показать(Ответ, Знач Ключ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Если НЕ ДопущенКНастройкам(Ответ, ЗаголовкиЗапроса, КукиЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Карточка = ИзвестнаяНастройка(Ответ, Ключ);
	Если Карточка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Лог.Отладка("Настройки хаба API: карточка ""%1"" — источник %2, правится: %3",
		Карточка.Ключ, Карточка.Источник, Карточка.Редактируемая);

	ОтдатьНастройку(Ответ, Карточка);

КонецПроцедуры

Процедура Задать(Ответ, Знач Ключ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Правка = НачатьПравку(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Правка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Карточка = ИзвестнаяНастройка(Ответ, Ключ);
	Если Карточка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// пустая строка значима — ею стирают значение
	Введённое = Запрос.Присланное(Правка.Тело, "значение,value");
	Если Введённое = Неопределено Тогда
		Ответы.Ошибка(Ответ, 400, "no_value",
			"Требуется поле значение (value) с новым значением настройки");
		Возврат;
	КонецЕсли;

	Автор = Автор(Правка);
	Попытка
		Настройки.Установить(Карточка.Ключ, Введённое, Автор);
	Исключение
		ОтказатьВПравке(Ответ, Карточка, ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Стало = Настройки.Карточка(Карточка.Ключ);
	Лог.Отладка("Настройки хаба API: ""%1"" задана автором %2, источник теперь %3",
		Стало.Ключ, Автор, Стало.Источник);

	ОтдатьНастройку(Ответ, Стало);

КонецПроцедуры

Процедура Убрать(Ответ, Знач Ключ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Правка = НачатьПравку(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Правка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Карточка = ИзвестнаяНастройка(Ответ, Ключ);
	Если Карточка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Автор = Автор(Правка);
	Попытка
		Настройки.Сбросить(Карточка.Ключ, Автор);
	Исключение
		ОтказатьВПравке(Ответ, Карточка, ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Стало = Настройки.Карточка(Карточка.Ключ);
	Лог.Отладка("Настройки хаба API: ""%1"" сброшена автором %2, источник теперь %3",
		Стало.Ключ, Автор, Стало.Источник);

	ОтдатьНастройку(Ответ, Стало);

КонецПроцедуры

#КонецОбласти

#Область ДопускИОтказы

// Право читать настройки хаба то же, что и править их: чужих ручек здесь не показывают.
Функция ДопущенКНастройкам(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Пользователь = Допуск.ТребоватьПользователя(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Пользователь = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ПорогиПрав.ТребоватьАдминаХаба(Ответ, Пользователь);

КонецФункции

// Пролог правки: аутентификация, гейт мутации и право администратора хаба.
Функция НачатьПравку(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Мутация = ГейтМутации.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ ПорогиПрав.ТребоватьАдминаХаба(Ответ, Мутация.Пользователь) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Мутация;

КонецФункции

// Карточка настройки по ключу из адреса; Неопределено — 404 уже записан.
Функция ИзвестнаяНастройка(Ответ, Знач Ключ)

	Если НЕ Настройки.Известна(Ключ) Тогда
		Ответы.Ошибка(Ответ, 404, "unknown_setting",
			СтрШаблон("Настройки ""%1"" в реестре хаба нет", Ключ));
		Возврат Неопределено;
	КонецЕсли;

	Возврат Настройки.Карточка(Ключ);

КонецФункции

// Код читается по состоянию карточки: «занято конфигурацией» — конфликт, а не негодный ввод.
Процедура ОтказатьВПравке(Ответ, Знач Карточка, Знач Инфо)

	Причина = Ошибки.ДляЧеловека(Инфо);
	Лог.Отладка("Настройки хаба API: правка ""%1"" отклонена — форсирована: %2, правится: %3,"
		+ " механизм: ""%4""",
		Карточка.Ключ, Карточка.Форсирована, Карточка.Редактируемая, Карточка.Механизм);

	Если Карточка.Форсирована Тогда
		Ответы.Сбой(Ответ, 409, "forced_by_config", Причина, Инфо);
	ИначеЕсли ЗначениеЗаполнено(Карточка.Механизм) Тогда
		Ответы.Сбой(Ответ, 409, "mechanism_only", Причина, Инфо);
	ИначеЕсли НЕ Карточка.Редактируемая Тогда
		Ответы.Сбой(Ответ, 409, "not_editable", Причина, Инфо);
	ИначеЕсли Карточка.Секрет Тогда
		// причина домена называет непринятое значение, а у секрета оно наружу не выходит
		Ответы.Сбой(Ответ, 422, "invalid_value",
			"Значение настройки не принято её проверкой", Инфо);
	Иначе
		Ответы.Сбой(Ответ, 422, "invalid_value", Причина, Инфо);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОтдатьНастройку(Ответ, Знач Карточка)
	Ответы.JSON(Ответ, 200, Новый Структура("setting", НастройкаВJSON(Карточка)));
КонецПроцедуры

// Секретная настройка отдаёт маску и признак «задано»: введённого значения не видит никто.
Функция НастройкаВJSON(Знач Карточка)

	Запись = Новый Структура();
	Запись.Вставить("key", Строка(Карточка.Ключ));
	Запись.Вставить("section", Разделы.РазделКлюча(Карточка.Ключ));
	Запись.Вставить("type", Строка(Карточка.Тип));
	Запись.Вставить("kind", Строка(Карточка.Класс));
	Запись.Вставить("value", Карточка.Значение);
	Запись.Вставить("source", Строка(Карточка.Источник));
	Запись.Вставить("editable", Карточка.Редактируемая = Истина
		И НЕ ЗначениеЗаполнено(Карточка.Механизм));
	Запись.Вставить("mechanism", Строка(Карточка.Механизм));
	Запись.Вставить("forced_by_config", Карточка.Форсирована = Истина);
	Запись.Вставить("secret", Карточка.Секрет = Истина);
	Если Карточка.Секрет Тогда
		Запись.Вставить("is_set", ЗначениеЗаполнено(Карточка.Значение));
	КонецЕсли;
	Запись.Вставить("env", Строка(Карточка.Переменная));
	Возврат Запись;

КонецФункции

// Отдельного списка разделов у настроек нет — он и есть их раскладка.
Функция ИменаРазделов(Знач Карточки)

	Результат = Новый Массив();
	Для Каждого Карточка Из Карточки Цикл
		Раздел = Разделы.РазделКлюча(Карточка.Ключ);
		Если Результат.Найти(Раздел) = Неопределено Тогда
			Результат.Добавить(Раздел);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Автор(Знач Правка)
	Возврат СокрЛП(Строка(Правка.Пользователь.Логин));
КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
&Группа("Настройки хаба", Описание = "Реестр настроек хаба с теми же ключами и проверками, что у страницы
	|настроек хаба.")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ЗапросAPI") _Запрос,
	&Пластилин(Значение = "МаршрутAPI") _Маршрут,
	&Пластилин(Значение = "ДопускAPI") _Допуск,
	&Пластилин(Значение = "ГейтМутацииAPI") _ГейтМутации,
	&Пластилин(Значение = "ПорогиПравAPI") _ПорогиПрав,
	&Пластилин(Значение = "СтраницыAPI") _Страницы,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "РазделыНастроекХаба") _Разделы,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки)

	Ответы = _Ответы;
	Запрос = _Запрос;
	Маршрут = _Маршрут;
	Допуск = _Допуск;
	ГейтМутации = _ГейтМутации;
	ПорогиПрав = _ПорогиПрав;
	Страницы = _Страницы;
	Настройки = _Настройки;
	Разделы = _Разделы;
	HTTP = _HTTP;
	Ошибки = _Ошибки;

КонецПроцедуры
