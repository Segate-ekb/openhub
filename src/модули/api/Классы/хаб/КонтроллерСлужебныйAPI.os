// Живость и числа хаба по адресу API: /api/v1/health — то же тело, что у /health,
// /api/v1/metrics — эксплуатационные числа.

Перем Живость;   // ЖивостьХаба (состояние)
Перем Числа;     // ЧислаХаба (состояние) — один снимок на все числа
Перем Ответы;    // ОтветыAPI (основа)
Перем Маршрут;   // МаршрутAPI (протоколAPI)

#Область ТочкиМаршрута

// Живость хаба — алиас корневой пробы.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//
&ТочкаМаршрута("health", Метод = "get")
&Операция(Сводка = "Живость хаба по адресу API",
	Описание = "Тело то же, что у `/health`, но чужой глагол отвергается 405.")
&Возвращает(Код = 200, Тип = "ЖивостьХабаJSON", Описание = "Процесс жив")
&Возвращает(Код = 405, Тип = "ОтказJSON", Описание = "`method_not_allowed` — чужой глагол")
Процедура Здоровье(Ответ, МетодЗапроса) Экспорт

	Если НЕ Маршрут.НачатьЧтение(Ответ, Неопределено, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Ответы.JSON(Ответ, 200, Живость.Сводка());

КонецПроцедуры

// Эксплуатационные числа хаба.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//
&ТочкаМаршрута("metrics", Метод = "get")
&Операция(Сводка = "Эксплуатационные числа хаба",
	Описание = "Число публичных пулов и пакетов, их объём и скачивания по всему хабу; непосчитанное число равно -1.")
&Возвращает(Код = 200, Тип = "ЧислаХабаJSON", Описание = "Эксплуатационные числа хаба")
&Возвращает(Код = 405, Тип = "ОтказJSON", Описание = "`method_not_allowed` — чужой глагол")
Процедура Метрики(Ответ, МетодЗапроса) Экспорт

	Если НЕ Маршрут.НачатьЧтение(Ответ, Неопределено, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;

	// пулы, пакеты и место — по публичным пулам, скачивания — по всему хабу
	Снимок = Числа.Снимок();
	Данные = Живость.Шапка();
	Данные.Вставить("pools_total", Снимок.Пулы);
	Данные.Вставить("packages_total", Снимок.Пакеты);
	Данные.Вставить("downloads_total", Снимок.Скачивания);
	Данные.Вставить("storage_used_bytes", Снимок.МестоПублично);

	Ответы.JSON(Ответ, 200, Данные);

КонецПроцедуры

#КонецОбласти

&Контроллер("/api/v1")
&Группа("Состояние хаба", Описание = "Живость хаба и его эксплуатационные числа.")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЖивостьХаба") _Живость,
	&Пластилин(Значение = "ЧислаХаба") _Числа,
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "МаршрутAPI") _Маршрут)

	Живость = _Живость;
	Числа = _Числа;
	Ответы = _Ответы;
	Маршрут = _Маршрут;

КонецПроцедуры
