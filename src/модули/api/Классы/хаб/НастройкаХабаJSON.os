// Карточка настройки хаба: значение, откуда оно и можно ли его править.

&Сериализуемое("key")
&Заполнено
&Тип("Строка")
Перем Ключ;

&Сериализуемое("section")
&Заполнено
&Тип("Строка")
&ОдинИз("identity", "maintenance", "branding", "mail", "mirrors", "legacy", "trusted", "pools", "login", "password", "delivery", "proxy", "storage")
Перем Раздел;

&Сериализуемое("type")
&Заполнено
&Тип("Строка")
&ОдинИз("строка", "целое", "булево")
Перем Тип;

&Сериализуемое("kind")
&Заполнено
&Тип("Строка")
&ОдинИз("bootstrap", "прикладная")
Перем Вид;

&Сериализуемое("value")
&Заполнено
Перем Значение;

&Сериализуемое("source")
&Заполнено
&Тип("Строка")
&ОдинИз("конфиг", "база", "дефолт")
Перем Источник;

&Сериализуемое("editable")
&Заполнено
&Тип("Булево")
Перем Редактируемая;

&Сериализуемое("mechanism")
&Заполнено
&Тип("Строка")
Перем Механизм;

&Сериализуемое("forced_by_config")
&Заполнено
&Тип("Булево")
Перем ЗаданаКонфигом;

&Сериализуемое("secret")
&Заполнено
&Тип("Булево")
Перем Секрет;

&Сериализуемое("is_set")
&Тип("Булево")
Перем Задана;

&Сериализуемое("env")
&Заполнено
&Тип("Строка")
Перем ПеременнаяСреды;
