// JSON-представление записи права доступа для API: субъект и объект отдаются и
// идентификатором, и человеческим именем — по имени клиент и выдавал грант.

Перем Субъекты;         // СубъектыПрав (auth) — логин/имя группы по идентификатору
Перем ПраваДоступа;     // СервисПравДоступа (auth) — роль по набору действий
Перем СервисПулов;      // СервисПулов (реестр)
Перем СервисПакетов;    // СервисПакетов (реестр)
Перем Моменты;          // МоментISO (основа) — одно написание времени в ответе

// Запись права доступа в JSON.
//
// Параметры:
//  Грант - ПравоДоступа - запись права.
//
// Возвращаемое значение:
//  Структура - поля субъекта, объекта, роли, набора действий и выдачи.
//
Функция ГрантJSON(Знач Грант) Экспорт

	ОдинГрант = Новый Массив();
	ОдинГрант.Добавить(Грант);
	Возврат Запись(Грант, СнимокВыдачи(ОдинГрант));

КонецФункции

// Массив записей прав в JSON.
//
// Параметры:
//  Гранты - Массив из ПравоДоступа - записи прав.
//
// Возвращаемое значение:
//  Массив из Структура.
//
Функция СписокJSON(Знач Гранты) Экспорт

	Снимок = СнимокВыдачи(Гранты);

	Результат = Новый Массив();
	Для Каждого Грант Из Гранты Цикл
		Результат.Добавить(Запись(Грант, Снимок));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Запись(Знач Грант, Знач Снимок)

	Структура = Новый Структура();
	Структура.Вставить("subject_type", Строка(Грант.ТипСубъекта));
	Структура.Вставить("subject_id", Цел(Грант.СубъектИдентификатор));
	Структура.Вставить("subject",
		Субъекты.Имя(Грант.ТипСубъекта, Грант.СубъектИдентификатор, Снимок.Имена));
	Структура.Вставить("object_type", Строка(Грант.ТипОбъекта));
	Структура.Вставить("object_id", Цел(Грант.ОбъектИдентификатор));
	Структура.Вставить("object", ИмяОбъекта(Грант.ТипОбъекта, Грант.ОбъектИдентификатор, Снимок));
	Структура.Вставить("role", ПраваДоступа.РольЗаписи(Грант));
	Структура.Вставить("actions", Действия(Грант));
	Структура.Вставить("granted_by", Цел(Грант.КемВыдано));
	Структура.Вставить("granted", Моменты.Строкой(Грант.Выдано));
	Возврат Структура;

КонецФункции

// Имена всей выдачи разом: субъекты — разрезом на тип, пулы и пакеты — по разрезу
// на вид объекта. Вопрос на запись стоил бы двух чтений на строку.
Функция СнимокВыдачи(Знач Гранты)

	Возврат Новый Структура("Имена, Пулы, Пакеты",
		Субъекты.Имена(Гранты), ПулыГрантов(Гранты), ПакетыГрантов(Гранты));

КонецФункции

Функция ПулыГрантов(Знач Гранты)

	Номера = НомераОбъектов(Гранты, "пул");
	Если Номера.Количество() = 0 Тогда
		Возврат Новый Соответствие();
	КонецЕсли;
	Возврат СервисПулов.ПулыПоИдентификаторам(Номера);

КонецФункции

Функция ПакетыГрантов(Знач Гранты)

	Результат = Новый Соответствие();
	Номера = НомераОбъектов(Гранты, "пакет");
	Если Номера.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Пакет Из СервисПакетов.ПакетыПоИдентификаторам(Номера) Цикл
		Результат.Вставить(Цел(Пакет.Идентификатор), Пакет);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НомераОбъектов(Знач Гранты, Знач Вид)

	Номера = Новый Массив();
	Для Каждого Грант Из Гранты Цикл
		Если НРег(СокрЛП(Строка(Грант.ТипОбъекта))) <> Вид Тогда
			Продолжить;
		КонецЕсли;
		Номер = Цел(Грант.ОбъектИдентификатор);
		Если Номера.Найти(Номер) = Неопределено Тогда
			Номера.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;
	Возврат Номера;

КонецФункции

Функция Действия(Знач Грант)
	Набор = Новый Структура();
	Набор.Вставить("create", Грант.Создание = Истина);
	Набор.Вставить("update", Грант.Изменение = Истина);
	Набор.Вставить("delete", Грант.Удаление = Истина);
	Набор.Вставить("read", Грант.Чтение = Истина);
	Возврат Набор;
КонецФункции

// Имя объекта права; удалённый объект оставляет пустое имя, а не роняет витрину.
Функция ИмяОбъекта(Знач ТипОбъекта, Знач Идентификатор, Знач Снимок)

	Тип = НРег(СокрЛП(Строка(ТипОбъекта)));
	Если Тип = "хаб" Тогда
		Возврат "хаб";
	ИначеЕсли Тип = "пул" Тогда
		Пул = Снимок.Пулы.Получить(Цел(Идентификатор));
		Возврат ?(Пул = Неопределено, "", Строка(Пул.Имя));
	ИначеЕсли Тип = "пакет" Тогда
		Пакет = Снимок.Пакеты.Получить(Цел(Идентификатор));
		Возврат ?(Пакет = Неопределено, "", Строка(Пакет.Имя));
	КонецЕсли;
	Возврат "";

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СубъектыПрав") _Субъекты,
	&Пластилин(Значение = "СервисПравДоступа") _ПраваДоступа,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "МоментISO") _Моменты = Неопределено)

	Субъекты = _Субъекты;
	ПраваДоступа = _ПраваДоступа;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	Моменты = ?(_Моменты = Неопределено, Новый МоментISO(), _Моменты);

КонецПроцедуры
