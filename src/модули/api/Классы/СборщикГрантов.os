// JSON-представление записи права доступа для API: субъект и объект отдаются и
// идентификатором, и человеческим именем — по имени клиент и выдавал грант.

Перем Субъекты;         // СубъектыПрав (auth) — логин/имя группы по идентификатору
Перем ПраваДоступа;     // СервисПравДоступа (auth) — роль по набору действий
Перем СервисПулов;      // СервисПулов (реестр)
Перем СервисПакетов;    // СервисПакетов (реестр)
Перем Моменты;          // МоментISO (основа) — одно написание времени в ответе

// Запись права доступа в JSON.
//
// Параметры:
//  Грант - ПравоДоступа - запись права.
//
// Возвращаемое значение:
//  Структура - поля субъекта, объекта, роли, набора действий и выдачи.
//
Функция ГрантJSON(Знач Грант) Экспорт

	Структура = Новый Структура();
	Структура.Вставить("subject_type", Строка(Грант.ТипСубъекта));
	Структура.Вставить("subject_id", Цел(Грант.СубъектИдентификатор));
	Структура.Вставить("subject", Субъекты.Имя(Грант.ТипСубъекта, Грант.СубъектИдентификатор));
	Структура.Вставить("object_type", Строка(Грант.ТипОбъекта));
	Структура.Вставить("object_id", Цел(Грант.ОбъектИдентификатор));
	Структура.Вставить("object", ИмяОбъекта(Грант.ТипОбъекта, Грант.ОбъектИдентификатор));
	Структура.Вставить("role", ПраваДоступа.РольЗаписи(Грант));
	Структура.Вставить("actions", Действия(Грант));
	Структура.Вставить("granted_by", Цел(Грант.КемВыдано));
	Структура.Вставить("granted", Моменты.Строкой(Грант.Выдано));
	Возврат Структура;

КонецФункции

// Массив записей прав в JSON.
//
// Параметры:
//  Гранты - Массив из ПравоДоступа - записи прав.
//
// Возвращаемое значение:
//  Массив из Структура.
//
Функция СписокJSON(Знач Гранты) Экспорт
	Результат = Новый Массив();
	Для Каждого Грант Из Гранты Цикл
		Результат.Добавить(ГрантJSON(Грант));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Действия(Знач Грант)
	Набор = Новый Структура();
	Набор.Вставить("create", Грант.Создание = Истина);
	Набор.Вставить("update", Грант.Изменение = Истина);
	Набор.Вставить("delete", Грант.Удаление = Истина);
	Набор.Вставить("read", Грант.Чтение = Истина);
	Возврат Набор;
КонецФункции

// Имя объекта права; удалённый объект оставляет пустое имя, а не роняет витрину.
Функция ИмяОбъекта(Знач ТипОбъекта, Знач Идентификатор)

	Тип = НРег(СокрЛП(Строка(ТипОбъекта)));
	Если Тип = "хаб" Тогда
		Возврат "хаб";
	ИначеЕсли Тип = "пул" Тогда
		Пул = СервисПулов.ПулПоИдентификатору(Цел(Идентификатор));
		Возврат ?(Пул = Неопределено, "", Строка(Пул.Имя));
	ИначеЕсли Тип = "пакет" Тогда
		Пакет = СервисПакетов.ПакетПоИдентификатору(Цел(Идентификатор));
		Возврат ?(Пакет = Неопределено, "", Строка(Пакет.Имя));
	КонецЕсли;
	Возврат "";

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СубъектыПрав") _Субъекты,
	&Пластилин(Значение = "СервисПравДоступа") _ПраваДоступа,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "МоментISO") _Моменты = Неопределено)

	Субъекты = _Субъекты;
	ПраваДоступа = _ПраваДоступа;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	Моменты = ?(_Моменты = Неопределено, Новый МоментISO(), _Моменты);

КонецПроцедуры
