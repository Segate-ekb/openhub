// GET /api/v1/search — глобальный ранжированный поиск пакетов. Принципал пробрасывается
// в СлужбуПоиска целиком, и та ограничивает выдачу читаемыми ему пулами.

Перем Ответы;        // ОтветыAPI (основа)
Перем Маршрут;       // МаршрутAPI (api)
Перем Допуск;        // ДопускAPI (api)
Перем Страницы;      // СтраницыAPI (api)
Перем СлужбаПоиска;  // СлужбаПоиска (поиск)
Перем СервисПулов;   // СервисПулов (реестр)

#Область ТочкиМаршрута

// GET /api/v1/search — страница результатов поиска пакетов.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  q - Строка - поисковый запрос (необязательный, по умолчанию пустая строка).
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию из СтраницыAPI).
//
&ТочкаМаршрута("search")
Процедура Поиск(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, q = "", page = "", pageSize = "") Экспорт

	Если НЕ Маршрут.НачатьЧтение(Ответ, Неопределено, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	НомерСтр = Страницы.Номер(page);
	РазмерСтр = Страницы.Размер(pageSize);

	Результат = СлужбаПоиска.НайтиПакеты(Строка(q), НомерСтр, РазмерСтр, Принципал);
	ПулыСтраницы = СервисПулов.ПулыПакетов(Результат.Элементы);

	Элементы = Новый Массив();
	Для Каждого Пакет Из Результат.Элементы Цикл
		Элементы.Добавить(ПакетJSON(Пакет, ПулыСтраницы));
	КонецЦикла;

	Ответы.JSON(Ответ, 200, Страницы.Конверт(Элементы, Результат.Всего, Результат.Страница, Результат.РазмерСтраницы));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПакетJSON(Знач Пакет, Знач ПулыСтраницы)
	Пул = ПулыСтраницы.Получить(Цел(Пакет.ПулИдентификатор));
	Структура = Новый Структура();
	Структура.Вставить("name", Пакет.Имя);
	Структура.Вставить("pool", ?(Пул = Неопределено, "", Пул.Имя));
	Структура.Вставить("description", ?(ЗначениеЗаполнено(Пакет.Описание), Строка(Пакет.Описание), ""));
	Структура.Вставить("deprecated", Пакет.Устарел = Истина);
	Возврат Структура;
КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "МаршрутAPI") _Маршрут,
	&Пластилин(Значение = "ДопускAPI") _Допуск,
	&Пластилин(Значение = "СтраницыAPI") _Страницы,
	&Пластилин(Значение = "СлужбаПоиска") _СлужбаПоиска,
	&Пластилин(Значение = "СервисПулов") _СервисПулов)

	Ответы = _Ответы;
	Маршрут = _Маршрут;
	Допуск = _Допуск;
	Страницы = _Страницы;
	СлужбаПоиска = _СлужбаПоиска;
	СервисПулов = _СервисПулов;

КонецПроцедуры
