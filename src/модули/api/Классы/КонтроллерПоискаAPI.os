// GET /api/v1/search — глобальный ранжированный поиск пакетов. Субъект пробрасывается
// в СлужбуПоиска, и та ограничивает выдачу видимыми ему пулами: приватные пулы
// анониму не утекают.

Перем Помощник;      // ПомощникAPI (api)
Перем СлужбаПоиска;  // СлужбаПоиска (поиск)
Перем СервисПулов;   // СервисПулов (реестр)
Перем HTTP;        // МетодыHTTP (основа)

#Область ТочкиМаршрута

// GET /api/v1/search — страница результатов поиска пакетов.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  q - Строка - поисковый запрос (необязательный, по умолчанию пустая строка).
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию из помощника).
//
&ТочкаМаршрута("search")
Процедура Поиск(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, q = "", page = "", pageSize = "") Экспорт

	Помощник.СнятьКуку(Ответ);
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответ.Заголовки["Allow"] = "GET";
		Помощник.Ошибка(Ответ, 405, "method_not_allowed", "Разрешён только метод GET");
		Возврат;
	КонецЕсли;

	Принц = Помощник.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	НомерСтр = Помощник.НомерСтраницы(page);
	РазмерСтр = Помощник.РазмерСтраницы(pageSize);

	Результат = СлужбаПоиска.НайтиПакеты(Строка(q), НомерСтр, РазмерСтр, Принц.Пользователь);

	Элементы = Новый Массив();
	Для Каждого Пакет Из Результат.Элементы Цикл
		Элементы.Добавить(ПакетJSON(Пакет));
	КонецЦикла;

	Помощник.JSON(Ответ, 200, Помощник.Страница(Элементы, Результат.Всего, Результат.Страница, Результат.РазмерСтраницы));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПакетJSON(Знач Пакет)
	Пул = СервисПулов.ПулПоИдентификатору(Пакет.ПулИдентификатор);
	Структура = Новый Структура();
	Структура.Вставить("name", Пакет.Имя);
	Структура.Вставить("pool", ?(Пул = Неопределено, "", Пул.Имя));
	Структура.Вставить("description", ?(ЗначениеЗаполнено(Пакет.Описание), Строка(Пакет.Описание), ""));
	Структура.Вставить("deprecated", Пакет.Устарел = Истина);
	Возврат Структура;
КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПомощникAPI") _Помощник,
	&Пластилин(Значение = "СлужбаПоиска") _СлужбаПоиска,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "МетодыHTTP") _HTTP)

	HTTP = _HTTP;

	Помощник = _Помощник;
	СлужбаПоиска = _СлужбаПоиска;
	СервисПулов = _СервисПулов;

КонецПроцедуры
