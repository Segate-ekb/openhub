// Контроллер пулов API. Аутентификация, CSRF, видимость и пагинация — в ПомощникAPI,
// заведение пула, назначение основного и удаление — СлужбаДоступа, та же, что у раздела
// «Пулы» дома «Хаб» и у опасной зоны дома «Пул»; чтение и запрет удаления — СервисПулов.
// winow не различает метод роутером, поэтому контроллер разбирает его сам.

Перем Помощник;       // ПомощникAPI (api)
Перем Служба;         // СлужбаДоступа (кабинет) — мутации пула
Перем СервисПулов;    // СервисПулов (реестр) — квоты хаба, запрет удаления
Перем ЧтениеПула;     // ГвардЧтенияПула (права) — какие пулы можно называть запросу
Перем Отбор;          // ПоискПоКоллекции (поиск)
Перем HTTP;        // МетодыHTTP (основа)
Перем Ошибки;      // ТекстОшибки (основа) — краткая причина без служебной обёртки

#Область ТочкиМаршрута

// GET /api/v1/pools — страница видимых субъекту пулов;
// POST /api/v1/pools — создание пула (имя, тип, видимость, необязательная квота),
// требует права создания на хабе.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для POST.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и POST.
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию из помощника).
//  query - Строка - подстрока имени пула (необязательный, по умолчанию — без отбора).
//
&ТочкаМаршрута("pools")
Процедура Пулы(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса, page = "", pageSize = "", query = "") Экспорт

	Помощник.СнятьКуку(Ответ);

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		СписокПулов(Ответ, ЗаголовкиЗапроса, КукиЗапроса, page, pageSize, query);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		СоздатьПул(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Иначе
		Помощник.МетодНеРазрешён(Ответ, "GET, POST");
	КонецЕсли;

КонецПроцедуры

// GET /api/v1/pools/{Пул} — карточка пула, если он видим субъекту;
// DELETE /api/v1/pools/{Пул} — удаление пула вместе со всем его содержимым,
// требует права удаления на хабе.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для DELETE.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и DELETE.
//
&ТочкаМаршрута("pools/{Пул}")
Процедура КарточкаПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса) Экспорт

	Помощник.СнятьКуку(Ответ);

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Карточка(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		УдалитьПул(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Иначе
		Помощник.МетодНеРазрешён(Ответ, "GET, DELETE");
	КонецЕсли;

КонецПроцедуры

// POST /api/v1/pools/{Пул}/default — назначает пул основным пулом хаба: короткие адреса
// /download, /dev-channel и /push начинают вести в него. Требует права изменения на хабе.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только POST.
//
&ТочкаМаршрута("pools/{Пул}/default")
Процедура ОсновнойПул(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса) Экспорт

	Если НЕ Помощник.НачатьДействие(Ответ, Неопределено, МетодЗапроса, "POST") Тогда
		Возврат;
	КонецЕсли;

	Принц = Помощник.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	Если Принц.Пользователь = Неопределено Тогда
		Помощник.Ошибка(Ответ, 401, "unauthorized", "Требуется аутентификация");
		Возврат;
	КонецЕсли;

	Тело = Помощник.РазобратьТело(ТелоЗапроса, ЗаголовкиЗапроса);
	Если НЕ Помощник.ПроверитьМутацию(Ответ, Принц, Тело, ЗаголовкиЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Помощник.СервисПрав().МожетНазначатьОсновнойПул(Принц.Пользователь) Тогда
		Помощник.Ошибка(Ответ, 403, "forbidden",
			"Недостаточно прав, чтобы назначить основной пул хаба");
		Возврат;
	КонецЕсли;

	// видимость спрашивается до мутации: невидимый пул отвечает так же, как несуществующий
	ОбъектПула = Помощник.ПулМутации(Ответ, Пул, Принц);
	Если ОбъектПула = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Назначенный = Служба.НазначитьОсновнойПул(Принц.Пользователь, ОбъектПула.Идентификатор);
	Исключение
		Помощник.Ошибка(Ответ, 422, "invalid_default_pool", Ошибки.Кратко(ОписаниеОшибки()));
		Возврат;
	КонецПопытки;

	Помощник.JSON(Ответ, 200, Новый Структура("pool", ПулВJSON(Назначенный)));

КонецПроцедуры

// Каналы уровня пула упразднены. Адрес отвечает 410 Gone с указанием на теги пакета:
// молчаливый 404 выглядел бы как «пул не найден» и увёл бы оператора искать проблему
// в правах и видимости пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Канал - Строка - имя канала из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  МетодЗапроса - Строка - метод запроса; ответ одинаков для любого.
//
&ТочкаМаршрута("pools/{Пул}/channels/{Канал}")
Процедура КаналПула(Ответ, Пул, Канал, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса) Экспорт

	Помощник.СнятьКуку(Ответ);
	Помощник.Ошибка(Ответ, 410, "channels_removed",
		СтрШаблон(
			"Каналы упразднены, уровня «канал по умолчанию пула» больше нет:"
			+ " задайте тег на пакете — PUT /api/v1/pools/%1/packages/{имя}/tags/%2",
			Строка(Пул), Строка(Канал)));

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура Карточка(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Принц = Помощник.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	ОбъектПула = Помощник.ВидимыйПул(Ответ, ИмяПула, Принц);
	Если ОбъектПула = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Помощник.JSON(Ответ, 200, Новый Структура("pool", ПулВJSON(ОбъектПула)));

КонецПроцедуры

// Удаление уносит пул со всем содержимым; та же дверь, что у опасной зоны дома пула.
// Мутация объявлена уровнем ХАБА (пустой пул в прологе): удаление — жизненный цикл пула,
// и ключ, привязанный к пулу, им не распоряжается — как и созданием пула, и назначением
// основного.
Процедура УдалитьПул(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Мутация = Помощник.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Помощник.СервисПрав().МожетУдалятьПул(Мутация.Пользователь) Тогда
		Помощник.Ошибка(Ответ, 403, "forbidden",
			"Недостаточно прав для удаления пула: требуется право удаления на уровне хаба");
		Возврат;
	КонецЕсли;

	// видимость спрашивается до мутации: невидимый пул отвечает так же, как несуществующий
	ОбъектПула = Помощник.ПулМутации(Ответ, ИмяПула, Мутация.Принц);
	Если ОбъектПула = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// 422 отдаётся по предикату домена, а не по любому исключению двери: неожиданный сбой
	// уборки — это 500, и прятать его под «пул не удаляется» значило бы врать оператору
	Причина = СервисПулов.ПричинаЗапретаУдаления(ОбъектПула);
	Если ЗначениеЗаполнено(Причина) Тогда
		Помощник.Ошибка(Ответ, 422, "pool_not_deletable", Причина);
		Возврат;
	КонецЕсли;

	Итог = Служба.УдалитьПул(Мутация.Пользователь, ОбъектПула.Идентификатор);

	Помощник.JSON(Ответ, 200, Новый Структура("deleted, pool, removed",
		Истина, Итог.Имя, УборкаВJSON(Итог)));

КонецПроцедуры

Процедура СписокПулов(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач page, Знач pageSize, Знач query)

	Принц = Помощник.Принципал(ЗаголовкиЗапроса, КукиЗапроса);

	// что запросу можно называть, решает гвард чтения пулов — тем же ответом, что и каталогу
	Видимые = ЧтениеПула.ЧитаемыеПулы(Принц);

	// отбор идёт по уже видимым пулам: поиск сужает выдачу, а не расширяет
	Видимые = Отбор.Отобрать(Видимые, Строка(query), "Имя");

	НомерСтр = Помощник.НомерСтраницы(page);
	РазмерСтр = Помощник.РазмерСтраницы(pageSize);
	Страница = Помощник.Срез(Видимые, НомерСтр, РазмерСтр);

	Элементы = Новый Массив();
	Для Каждого Пул Из Страница Цикл
		Элементы.Добавить(ПулВJSON(Пул));
	КонецЦикла;

	Помощник.JSON(Ответ, 200, Помощник.Страница(Элементы, Видимые.Количество(), НомерСтр, РазмерСтр));

КонецПроцедуры

Процедура СоздатьПул(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Принц = Помощник.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	Если Принц.Пользователь = Неопределено Тогда
		Помощник.Ошибка(Ответ, 401, "unauthorized", "Требуется аутентификация");
		Возврат;
	КонецЕсли;

	Тело = Помощник.РазобратьТело(ТелоЗапроса, ЗаголовкиЗапроса);
	Если НЕ Помощник.ПроверитьМутацию(Ответ, Принц, Тело, ЗаголовкиЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Помощник.СервисПрав().МожетСоздаватьПул(Принц.Пользователь) Тогда
		Помощник.Ошибка(Ответ, 403, "forbidden", "Недостаточно прав для создания пула");
		Возврат;
	КонецЕсли;

	Имя = Помощник.Поле(Тело, "имя", Помощник.Поле(Тело, "name"));
	Тип = Помощник.Поле(Тело, "тип", Помощник.Поле(Тело, "type", "custom"));
	Видимость = Помощник.Поле(Тело, "видимость", Помощник.Поле(Тело, "visibility", "public"));

	// Неопределено означает «квота не названа»: служба возьмёт квоту хаба и права на
	// квоту не спросит. Названная квота — второй вход к пределу, и он закрыт своим гвардом.
	Квота = Неопределено;
	СыраяКвота = Помощник.СыраяКвота(Тело);
	Если СыраяКвота <> Неопределено Тогда
		Если НЕ Помощник.ТребоватьПравоНаКвоту(Ответ, Принц.Пользователь) Тогда
			Возврат;
		КонецЕсли;
		Квота = Помощник.ПринятьКвоту(Ответ, СыраяКвота);
		Если Квота = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// Дубликат имени — 409 без деталей: сообщение не должно раскрывать приватный пул.
	Если СервисПулов.НайтиПул(Имя) <> Неопределено Тогда
		Помощник.Ошибка(Ответ, 409, "pool_exists", "Пул с таким именем уже существует");
		Возврат;
	КонецЕсли;

	Попытка
		НовыйПул = Служба.СоздатьПул(Принц.Пользователь, Имя, Тип, Видимость, Квота);
	Исключение
		Помощник.Ошибка(Ответ, 400, "invalid_pool", "Некорректные параметры пула (имя/тип/видимость)");
		Возврат;
	КонецПопытки;

	Помощник.JSON(Ответ, 201, Новый Структура("pool", ПулВJSON(НовыйПул)));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Числа уборки: чего именно не стало вместе с пулом.
Функция УборкаВJSON(Знач Итог)
	Структура = Новый Структура();
	Структура.Вставить("packages", Итог.Пакетов);
	Структура.Вставить("artifacts", Итог.Артефактов);
	Структура.Вставить("grants", Итог.Доступов);
	Структура.Вставить("roles", Итог.Ролей);
	Структура.Вставить("webhooks", Итог.Подписок);
	Структура.Вставить("mirrors", Итог.Зеркал);
	Структура.Вставить("upstreams", Итог.Апстримов);
	Структура.Вставить("inbox", Итог.Заявок);
	Структура.Вставить("rows", Итог.Строк);
	Возврат Структура;
КонецФункции

Функция ПулВJSON(Знач Пул)
	Структура = Новый Структура();
	Структура.Вставить("id", Пул.Идентификатор);
	Структура.Вставить("name", Пул.Имя);
	Структура.Вставить("type", Пул.Тип);
	Структура.Вставить("visibility", Пул.Видимость);
	Структура.Вставить("default", Пул.ЭтоДефолтный());
	Структура.Вставить("owner_id", Пул.ВладелецИдентификатор);
	Структура.Вставить("created", ?(ЗначениеЗаполнено(Пул.Создан), XMLСтрока(Пул.Создан), ""));
	Возврат Структура;
КонецФункции


#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПомощникAPI") _Помощник,
	&Пластилин(Значение = "СлужбаДоступа") _Служба,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ГвардЧтенияПула") _ЧтениеПула,
	&Пластилин(Значение = "ПоискПоКоллекции") _Отбор,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки)

	HTTP = _HTTP;
	Ошибки = _Ошибки;

	Помощник = _Помощник;
	Служба = _Служба;
	СервисПулов = _СервисПулов;
	ЧтениеПула = _ЧтениеПула;
	Отбор = _Отбор;

КонецПроцедуры
