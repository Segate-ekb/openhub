// Контроллер апстримов и настроек пула API — то же, что дом настроек пула: список,
// заведение и снятие апстрима, квота, видимость и признак «пул принимает публикации».
// Доменные операции — СервисПулов, права — владелец либо администратор пула.

Перем Помощник;    // ПомощникAPI (api)
Перем СервисПулов; // СервисПулов (реестр)
Перем Числа;       // ПриведениеЧисел (основа)
Перем HTTP;        // МетодыHTTP (основа)
Перем Секрет;      // СекретИсточника (прокси) — задан ли токен у источника

#Область ТочкиМаршрута

// GET /api/v1/pools/{Пул}/upstreams — апстримы пула в порядке опроса;
// POST — завести апстрим либо обновить заведённый с тем же URL;
// DELETE — снять апстрим (URL приходит телом).
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для POST и DELETE.
//  МетодЗапроса - Строка - метод запроса; допустимы GET, POST и DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/upstreams")
Процедура Апстримы(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Помощник.НачатьМаршрут(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Список(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Завести(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		Снять(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Иначе
		Помощник.МетодНеРазрешён(Ответ, "GET, POST, DELETE");
	КонецЕсли;

КонецПроцедуры

// GET /api/v1/pools/{Пул}/settings — настройки пула глазами его администратора;
// PATCH — квота (квота_мб), видимость (видимость) и признак «пул принимает публикации»
// (публикация); указываются в любом сочетании, непринятый ввод не меняет ничего.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для PATCH.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и PATCH.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/settings")
Процедура Настройки(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Помощник.НачатьМаршрут(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ПоказатьНастройки(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "PATCH") Тогда
		ИзменитьНастройки(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Иначе
		Помощник.МетодНеРазрешён(Ответ, "GET, PATCH");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура Список(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Принц = Помощник.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	Пул = Помощник.АдминистрируемыйПул(Ответ, ИмяПула, Принц);
	Если Пул = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Элементы = Новый Массив();
	Для Каждого Апстрим Из СервисПулов.АпстримыПула(Пул.Идентификатор) Цикл
		Элементы.Добавить(АпстримВJSON(Апстрим));
	КонецЦикла;

	Помощник.JSON(Ответ, 200, Новый Структура("items, total", Элементы, Элементы.Количество()));

КонецПроцедуры

Процедура Завести(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Контекст = НачатьАдминистрирование(Ответ, ИмяПула, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Тело = Контекст.Тело;
	Url = СокрЛП(Помощник.Поле(Тело, "url"));
	Если НЕ ЗначениеЗаполнено(Url) Тогда
		Помощник.Ошибка(Ответ, 400, "invalid_upstream", "Требуется непустое поле url");
		Возврат;
	КонецЕсли;

	// ноль здесь значим («без кэша»), поэтому мусор нельзя молча приводить к нулю
	TTL = Числа.ЦелоеИлиНеопределено(Помощник.Поле(Тело, "ttl", ""), 900);
	Если TTL = Неопределено Тогда
		Помощник.Ошибка(Ответ, 400, "invalid_upstream", "Поле ttl — целое число секунд");
		Возврат;
	КонецЕсли;

	// снятие уезжает в тот же доменный вызов: неудачная проба не оставляет источник
	// с наполовину снятым токеном
	Попытка
		Апстрим = СервисПулов.ДобавитьАпстрим(Контекст.Пул.Идентификатор, Url, TTL,
			Помощник.Поле(Тело, "allowlist", Помощник.Поле(Тело, "список_разрешений")),
			Помощник.ВБулево(Тело.Получить("разрешить_приватные")),
			Помощник.Поле(Тело, "token", Помощник.Поле(Тело, "токен")),
			Помощник.СнятиеТокенаИсточника(Тело));
	Исключение
		// SSRF-вердикт и запрет по типу пула — ввод, а не поломка: 422 с фиксированным текстом
		Помощник.Ошибка(Ответ, 422, "invalid_upstream",
			"Апстрим не принят: проверьте адрес, allowlist, ttl, токен доступа и тип пула");
		Возврат;
	КонецПопытки;

	Помощник.JSON(Ответ, 201, Новый Структура("upstream", АпстримВJSON(Апстрим)));

КонецПроцедуры

Процедура Снять(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Контекст = НачатьАдминистрирование(Ответ, ИмяПула, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Url = СокрЛП(Помощник.Поле(Контекст.Тело, "url"));
	Если НЕ ЗначениеЗаполнено(Url) Тогда
		Помощник.Ошибка(Ответ, 400, "invalid_upstream", "Требуется непустое поле url");
		Возврат;
	КонецЕсли;

	Снято = СервисПулов.УдалитьАпстрим(Контекст.Пул.Идентификатор, Url);
	Помощник.JSON(Ответ, 200, Новый Структура("removed", Снято));

КонецПроцедуры

Процедура ПоказатьНастройки(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Принц = Помощник.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	Пул = Помощник.АдминистрируемыйПул(Ответ, ИмяПула, Принц);
	Если Пул = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Помощник.JSON(Ответ, 200, Новый Структура("settings", НастройкиВJSON(Пул)));

КонецПроцедуры

Процедура ИзменитьНастройки(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Контекст = НачатьАдминистрирование(Ответ, ИмяПула, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Публикация = ЗначениеПубликации(Контекст.Тело);
	СыраяКвота = Помощник.СыраяКвота(Контекст.Тело);
	Видимость = ЗначениеВидимости(Контекст.Тело);

	Если Публикация = Неопределено И СыраяКвота = Неопределено И НЕ ЗначениеЗаполнено(Видимость) Тогда
		Помощник.Ошибка(Ответ, 400, "no_changes",
			"Не указано ни одно поле: публикация (publish_allowed), квота (quota_mb), видимость (visibility)");
		Возврат;
	КонецЕсли;

	// сначала весь ввод судится, потом мутации: полупринятых настроек пула не бывает
	Квота = Неопределено;
	Если СыраяКвота <> Неопределено Тогда
		// квота — право хаба, а не администратора пула: гейт стоит до разбора значения
		Если НЕ Помощник.ТребоватьПравоНаКвоту(Ответ, Контекст.Пользователь) Тогда
			Возврат;
		КонецЕсли;
		Квота = Помощник.ПринятьКвоту(Ответ, СыраяКвота);
		Если Квота = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Видимость) И НЕ ВидимостьПрименима(Ответ, Контекст.Пул, Видимость) Тогда
		Возврат;
	КонецЕсли;

	Обновлённый = Контекст.Пул;
	Если ЗначениеЗаполнено(Видимость) Тогда
		Обновлённый = СервисПулов.УстановитьВидимость(Обновлённый.Идентификатор, Видимость);
	КонецЕсли;
	Если Квота <> Неопределено Тогда
		Обновлённый = СервисПулов.УстановитьКвоту(Обновлённый.Идентификатор, Квота);
	КонецЕсли;
	Если Публикация <> Неопределено Тогда
		Обновлённый = СервисПулов.УстановитьПубликациюРазрешена(Обновлённый.Идентификатор, Публикация);
	КонецЕсли;

	Помощник.JSON(Ответ, 200, Новый Структура("settings", НастройкиВJSON(Обновлённый)));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пролог мутации раздела: аутентификация, гейт мутации и права администратора пула.
// Неопределено — ответ уже записан.
Функция НачатьАдминистрирование(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Мутация = Помощник.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, ИмяПула);
	Если Мутация = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пул = Помощник.АдминистрируемыйПулМутации(Ответ, ИмяПула, Мутация.Принц);
	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Мутация.Вставить("Пул", Пул);
	Возврат Мутация;

КонецФункции

// Признак публикации из тела; Неопределено — поля в теле нет.
Функция ЗначениеПубликации(Знач Тело)
	Для Каждого Имя Из СтрРазделить("публикация,publish_allowed,публикация_разрешена", ",") Цикл
		Если Тело.Получить(Имя) <> Неопределено Тогда
			Возврат Помощник.ВБулево(Тело.Получить(Имя));
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Видимость из тела, нормализованная; пустая строка — поля в теле нет.
Функция ЗначениеВидимости(Знач Тело)
	Для Каждого Имя Из СтрРазделить("видимость,visibility", ",") Цикл
		Если Тело.Получить(Имя) <> Неопределено Тогда
			Возврат НРег(СокрЛП(Строка(Тело.Получить(Имя))));
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Судит видимость до мутации: недопустимое значение — 400, запрет по типу пула — 422.
// Ложь означает, что ответ уже записан и вызывающий обязан выйти.
Функция ВидимостьПрименима(Ответ, Знач Пул, Знач Видимость)

	Если Видимость <> "public" И Видимость <> "private" Тогда
		Помощник.Ошибка(Ответ, 400, "invalid_visibility",
			"Видимость пула — public либо private");
		Возврат Ложь;
	КонецЕсли;

	Если Видимость = "private" И (Пул.ЭтоДефолтный() ИЛИ Пул.ЭтоЛичный()) Тогда
		Помощник.Ошибка(Ответ, 422, "invalid_visibility",
			"Этот пул приватным быть не может: основной пул хаба и личное пространство"
			+ " пользователя всегда публичны");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Значение токена наружу не печатается никогда: машинному читателю довольно факта.
Функция АпстримВJSON(Знач Апстрим)
	Структура = Новый Структура();
	Структура.Вставить("id", Апстрим.Идентификатор);
	Структура.Вставить("url", Строка(Апстрим.Url));
	Структура.Вставить("order", Цел(Апстрим.Порядок));
	Структура.Вставить("ttl", Цел(Апстрим.ВремяЖизниСек));
	Структура.Вставить("allowlist", ?(ЗначениеЗаполнено(Апстрим.СписокРазрешенийJSON),
		Строка(Апстрим.СписокРазрешенийJSON), ""));
	Структура.Вставить("allow_private", Апстрим.РазрешитьПриватные = Истина);
	Структура.Вставить("token_set", Секрет.Задан(Секрет.ИзИсточника(Апстрим)));
	Возврат Структура;
КонецФункции

Функция НастройкиВJSON(Знач Пул)
	Структура = Новый Структура();
	Структура.Вставить("pool", Строка(Пул.Имя));
	Структура.Вставить("type", Строка(Пул.Тип));
	Структура.Вставить("visibility", Строка(Пул.Видимость));
	Структура.Вставить("quota_mb", Цел(Пул.КвотаМб));
	Структура.Вставить("publish_allowed", Пул.ПубликацияРазрешена = Истина);
	Структура.Вставить("upstreams_allowed", Пул.АпстримыДопустимы());
	Возврат Структура;
КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПомощникAPI") _Помощник,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "СекретИсточника") _Секрет)

	Помощник = _Помощник;
	СервисПулов = _СервисПулов;
	Числа = _Числа;
	HTTP = _HTTP;
	Секрет = _Секрет;

КонецПроцедуры
