// Постраничность API: номер и размер страницы из query-параметров, срез массива
// и единый конверт выдачи.

// Номер страницы из query-параметра.
//
// Параметры:
//  Значение - Строка - сырое значение параметра.
//
// Возвращаемое значение:
//  Число - номер страницы не меньше 1; мусор и пустота дают 1.
//
Функция Номер(Знач Значение) Экспорт
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 1;
	КонецЕсли;
	Попытка
		Возврат Макс(1, Цел(Число(Значение)));
	Исключение
		Возврат 1;
	КонецПопытки;
КонецФункции

// Размер страницы из query-параметра.
//
// Параметры:
//  Значение - Строка - сырое значение параметра.
//  ПоУмолчанию - Число - размер при пустом или некорректном значении (необязательный,
//                по умолчанию 20).
//  Максимум - Число - верхняя граница размера (необязательный, по умолчанию 100).
//
// Возвращаемое значение:
//  Число - размер страницы в границах от 1 до Максимум.
//
Функция Размер(Знач Значение, Знач ПоУмолчанию = 20, Знач Максимум = 100) Экспорт
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Попытка
		Н = Цел(Число(Значение));
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
	Если Н < 1 Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Мин(Н, Максимум);
КонецФункции

// Срез массива для страницы — когда доменный сервис сам не пагинирует.
//
// Параметры:
//  Массив - Массив - полный набор элементов.
//  Страница - Число - номер страницы, не меньше 1.
//  РазмерСтр - Число - размер страницы, не меньше 1.
//
// Возвращаемое значение:
//  Массив - элементы страницы; пустой при выходе за границы.
//
Функция Срез(Знач Массив, Знач Страница, Знач РазмерСтр) Экспорт
	Результат = Новый Массив();
	Начало = (Страница - 1) * РазмерСтр;
	Для Индекс = Начало По Начало + РазмерСтр - 1 Цикл
		Если Индекс >= 0 И Индекс < Массив.Количество() Тогда
			Результат.Добавить(Массив[Индекс]);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Единая форма страницы в выдаче API.
//
// Параметры:
//  Элементы - Массив - элементы текущей страницы.
//  Всего - Число - общее число элементов.
//  НомерСтр - Число - номер страницы.
//  РазмерСтр - Число - размер страницы.
//
// Возвращаемое значение:
//  Структура - items, page, pageSize, total.
//
Функция Конверт(Знач Элементы, Знач Всего, Знач НомерСтр, Знач РазмерСтр) Экспорт
	Страница = Новый Структура();
	Страница.Вставить("items", Элементы);
	Страница.Вставить("page", НомерСтр);
	Страница.Вставить("pageSize", РазмерСтр);
	Страница.Вставить("total", Всего);
	Возврат Страница;
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
