// Контроллер доверенных конвейеров пакета API — то же, что раздел «Доверенная публикация»
// дома настроек пакета: список, заведение и отзыв доверия.

Перем Ответы;        // ОтветыAPI (основа)
Перем Запрос;        // ЗапросAPI (api)
Перем Маршрут;       // МаршрутAPI (api)
Перем Допуск;        // ДопускAPI (api)
Перем Двери;         // ДвериAPI (api)
Перем СервисДоверия; // СервисДоверияCI (публикация) — конвейеры, порог права, рамки ключа
Перем СервисПакетов; // СервисПакетов (реестр)
Перем Числа;         // ПриведениеЧисел (основа)
Перем HTTP;          // МетодыHTTP (основа)
Перем Моменты;       // МоментISO (основа) — одно написание времени в ответе

#Область ТочкиМаршрута

// GET /api/v1/pools/{Пул}/packages/{Имя}/trusted-workflows — доверенные конвейеры пакета;
// POST — доверить конвейеру.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для POST.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и POST.
//
// Гварда лишнего хвоста здесь нет намеренно: любой хвост подхватывает более длинный
// литеральный маршрут элемента, и проверка была бы недостижимым кодом.
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/trusted-workflows")
Процедура Конвейеры(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса) Экспорт

	Маршрут.СнятьКуку(Ответ);

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Список(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Доверить(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Иначе
		Маршрут.МетодНеРазрешён(Ответ, "GET, POST");
	КонецЕсли;

КонецПроцедуры

// DELETE /api/v1/pools/{Пул}/packages/{Имя}/trusted-workflows/{Ид} — отозвать доверие.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  Ид - Строка - идентификатор записи доверия из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/trusted-workflows/{Ид}")
Процедура Конвейер(Ответ, Пул, Имя, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.НачатьДействие(Ответ, ПараметрыЗапросаПорядковые, МетодЗапроса, "DELETE") Тогда
		Возврат;
	КонецЕсли;

	Отозвать(Ответ, Пул, Имя, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);

КонецПроцедуры

// POST /api/v1/pools/{Пул}/packages/{Имя}/trusted-workflows/{Ид}/delete — отзыв доверия
// для клиентов, которым DELETE недоступен (формы, урезанные прокси).
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  Ид - Строка - идентификатор записи доверия из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только POST.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/trusted-workflows/{Ид}/delete")
Процедура ОтзывДействием(Ответ, Пул, Имя, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса,
	МетодЗапроса, ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.НачатьДействие(Ответ, ПараметрыЗапросаПорядковые, МетодЗапроса, "POST") Тогда
		Возврат;
	КонецЕсли;

	Отозвать(Ответ, Пул, Имя, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура Список(Ответ, Знач ИмяПула, Знач ИмяПакета, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	// аноним получает 401, а не 403: «не представился» и «представился, но не вправе» —
	// разные ответы, и клиенту по ним ясно, что делать
	Принципал = Допуск.ТребоватьПринципала(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Принципал = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Пакет = НастраиваемыйПакет(Ответ, Двери.ВидимыйПул(Ответ, ИмяПула, Принципал),
		ИмяПакета, Принципал);
	Если Пакет = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Элементы = Новый Массив();
	Для Каждого СтрокаДоверия Из СервисДоверия.СтрокиПакета(Пакет) Цикл
		Элементы.Добавить(КонвейерВJSON(СтрокаДоверия));
	КонецЦикла;

	Ответы.JSON(Ответ, 200, Новый Структура("items, total", Элементы, Элементы.Количество()));

КонецПроцедуры

Процедура Доверить(Ответ, Знач ИмяПула, Знач ИмяПакета, Знач ЗаголовкиЗапроса,
	Знач КукиЗапроса, Знач ТелоЗапроса)

	Контекст = НачатьМутацию(Ответ, ИмяПула, ИмяПакета, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Тело = Контекст.Тело;
	Итог = СервисДоверия.Доверить(Контекст.Принципал, Контекст.Пакет,
		Запрос.Поле(Тело, "провайдер", Запрос.Поле(Тело, "provider")),
		Запрос.Поле(Тело, "издатель", Запрос.Поле(Тело, "issuer")),
		Запрос.Поле(Тело, "репозиторий", Запрос.Поле(Тело, "repository")),
		Запрос.Поле(Тело, "конвейер", Запрос.Поле(Тело, "workflow")),
		Запрос.Поле(Тело, "реф", Запрос.Поле(Тело, "ref")),
		Запрос.Поле(Тело, "вид_рефа", Запрос.Поле(Тело, "ref_kind")));

	Если НЕ Итог.Успех Тогда
		Ответы.Ошибка(Ответ, Итог.Код, КодОшибки(Итог.Код), Итог.Сообщение);
		Возврат;
	КонецЕсли;

	Ответы.JSON(Ответ, Итог.Код, Новый Структура("trusted_workflow",
		КонвейерВJSON(Новый Структура("Доверие, Автор", Итог.Доверие, Контекст.Пользователь))));

КонецПроцедуры

Процедура Отозвать(Ответ, Знач ИмяПула, Знач ИмяПакета, Знач Ид, Знач ЗаголовкиЗапроса,
	Знач КукиЗапроса, Знач ТелоЗапроса)

	Контекст = НачатьМутацию(Ответ, ИмяПула, ИмяПакета, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// принадлежность записи пакету из адреса сверяет домен — по сущности, а не по адресу
	Итог = СервисДоверия.ОтозватьДоверие(Контекст.Принципал, Контекст.Пакет, Числа.ЧислоИлиНоль(Ид));
	Если НЕ Итог.Успех Тогда
		Ответы.Ошибка(Ответ, Итог.Код, КодОшибки(Итог.Код), Итог.Сообщение);
		Возврат;
	КонецЕсли;

	Ответы.JSON(Ответ, 200, Новый Структура("deleted", Истина));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пролог мутации: аутентификация и гейт способа, видимость пула и пакета, порог мейнтейнера.
Функция НачатьМутацию(Ответ, Знач ИмяПула, Знач ИмяПакета, Знач ЗаголовкиЗапроса,
	Знач КукиЗапроса, Знач ТелоЗапроса)

	Мутация = Допуск.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, ИмяПула);
	Если Мутация = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пакет = НастраиваемыйПакет(Ответ, Двери.ПулМутации(Ответ, ИмяПула, Мутация.Принципал),
		ИмяПакета, Мутация.Принципал);
	Если Пакет = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Мутация.Вставить("Пакет", Пакет);
	Возврат Мутация;

КонецФункции

// Скрытость пакета здесь не значима: скрыт он только для каталога.
Функция НастраиваемыйПакет(Ответ, Знач Пул, Знач ИмяПакета, Знач Принципал)

	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пакет = СервисПакетов.НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Если Пакет = Неопределено Тогда
		Ответы.Ошибка(Ответ, 404, "package_not_found",
			СтрШаблон("Пакет ""%1"" не найден", ИмяПакета));
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ СервисДоверия.МожетНастраивать(Принципал.Пользователь, Пакет) Тогда
		Ответы.Ошибка(Ответ, 403, "forbidden",
			"Доверенные конвейеры пакета настраивают его мейнтейнеры и выше");
		Возврат Неопределено;
	КонецЕсли;

	Возврат Пакет;

КонецФункции

Функция КонвейерВJSON(Знач СтрокаДоверия)

	Запись = СтрокаДоверия.Доверие;

	Результат = Новый Структура();
	Результат.Вставить("id", Цел(Запись.Идентификатор));
	Результат.Вставить("provider", Строка(Запись.Провайдер));
	Результат.Вставить("issuer", Строка(Запись.Издатель));
	Результат.Вставить("repository", Строка(Запись.Репозиторий));
	Результат.Вставить("workflow", Строка(Запись.Конвейер));
	Результат.Вставить("ref", Строка(Запись.Реф));
	Результат.Вставить("created_by", ?(СтрокаДоверия.Автор = Неопределено, "",
		Строка(СтрокаДоверия.Автор.Логин)));
	Результат.Вставить("created", Моменты.Строкой(Запись.Создано));
	Возврат Результат;

КонецФункции

Функция КодОшибки(Знач Код)

	Если Код = 404 Тогда
		Возврат "trusted_workflow_not_found";
	ИначеЕсли Код = 403 Тогда
		Возврат "forbidden";
	ИначеЕсли Код = 401 Тогда
		Возврат "unauthorized";
	ИначеЕсли Код = 400 Тогда
		Возврат "invalid_trusted_workflow";
	КонецЕсли;
	Возврат "trusted_workflow_failed";

КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ЗапросAPI") _Запрос,
	&Пластилин(Значение = "МаршрутAPI") _Маршрут,
	&Пластилин(Значение = "ДопускAPI") _Допуск,
	&Пластилин(Значение = "ДвериAPI") _Двери,
	&Пластилин(Значение = "СервисДоверияCI") _СервисДоверия,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "МоментISO") _Моменты = Неопределено)

	Ответы = _Ответы;
	Запрос = _Запрос;
	Маршрут = _Маршрут;
	Допуск = _Допуск;
	Двери = _Двери;
	СервисДоверия = _СервисДоверия;
	СервисПакетов = _СервисПакетов;
	Числа = _Числа;
	HTTP = _HTTP;
	Моменты = ?(_Моменты = Неопределено, Новый МоментISO(), _Моменты);

КонецПроцедуры
