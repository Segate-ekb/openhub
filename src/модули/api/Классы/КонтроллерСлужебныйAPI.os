// Служебные эндпоинты API: GET /api/v1/health — алиас корневого /health,
// GET /api/v1/metrics — эксплуатационные счётчики.

Перем СостояниеХаба;        // СостояниеХаба (наблюдаемость)
Перем ОписаниеПриложения;   // ОписаниеПриложения (запуск)
Перем Числа;                // ЧислаХаба (наблюдаемость) — один снимок на все числа
Перем База;                 // ПробаБазы (данные) — отвечает ли база и снимок её пула
Перем Ответы;               // ОтветыAPI (основа)
Перем ПустыеКуки;           // Куки (winow)
Перем HTTP;                 // МетодыHTTP (основа)
Перем Маршрут;              // МаршрутAPI (api)

#Область ТочкиМаршрута

// Живость хаба — алиас корневой пробы.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//
&ТочкаМаршрута("health", Метод = "get")
&Операция(Сводка = "Живость хаба по адресу API",
	Описание = "Тело то же, что у `/health`. В отличие от корневой пробы, чужой глагол отвергается
	|405.")
&Возвращает(Код = 200, Описание = "`{status: ok, version, uptime_seconds, database}`")
&Возвращает(Код = 405, Описание = "`method_not_allowed`")
Процедура Здоровье(Ответ, МетодЗапроса) Экспорт

	Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтветМетодНеРазрешён(Ответ, "GET");
		Возврат;
	КонецЕсли;

	Данные = Новый Структура();
	Данные.Вставить("status", "ok");
	Данные.Вставить("version", ОписаниеПриложения.Версия());
	Данные.Вставить("uptime_seconds", СостояниеХаба.АптаймСекунд());
	Данные.Вставить("database", База.Состояние());
	Ответы.JSON(Ответ, 200, Данные);

КонецПроцедуры

// Эксплуатационные числа хаба.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//
&ТочкаМаршрута("metrics", Метод = "get")
&Операция(Сводка = "Эксплуатационные числа хаба",
	Описание = "Ответ `{status, version, uptime_seconds, pools_total, packages_total, downloads_total,
	|storage_used_bytes}`. `pools_total`, `packages_total` и `storage_used_bytes` считаются только
	|по публичным пулам; `downloads_total` — все скачивания хаба, включая приватные пулы. Число,
	|которое не удалось посчитать, равно -1, а `status` остаётся `ok`.")
&Возвращает(Код = 200, Описание = "`{status, version, uptime_seconds, pools_total, packages_total, downloads_total,
	|storage_used_bytes}`")
&Возвращает(Код = 405, Описание = "`method_not_allowed`")
Процедура Метрики(Ответ, МетодЗапроса) Экспорт

	Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтветМетодНеРазрешён(Ответ, "GET");
		Возврат;
	КонецЕсли;

	Данные = Новый Структура();
	Данные.Вставить("status", "ok");
	Данные.Вставить("version", ОписаниеПриложения.Версия());
	Данные.Вставить("uptime_seconds", СостояниеХаба.АптаймСекунд());

	// Один снимок на все числа: адрес и приборы OTel рассказывают об одном мгновении.
	// Пулы, пакеты и занятое место считаются по публичным пулам,
	// скачивания — по всему хабу.
	Снимок = Числа.Снимок();
	Данные.Вставить("pools_total", Снимок.Пулы);
	Данные.Вставить("packages_total", Снимок.Пакеты);
	Данные.Вставить("downloads_total", Снимок.Скачивания);
	Данные.Вставить("storage_used_bytes", Снимок.МестоПублично);

	Ответы.JSON(Ответ, 200, Данные);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОтветМетодНеРазрешён(Ответ, Знач Разрешённый)
	Маршрут.МетодНеРазрешён(Ответ, Разрешённый);
КонецПроцедуры

#КонецОбласти

&Контроллер("/api/v1")
&Группа("Живость и готовность")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СостояниеХаба") _СостояниеХаба,
	&Пластилин(Значение = "ОписаниеПриложения") _ОписаниеПриложения,
	&Пластилин(Значение = "ЧислаХаба") _Числа,
	&Пластилин(Значение = "ПробаБазы") _База,
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "Куки") _ПустыеКуки,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "МаршрутAPI") _Маршрут)

	HTTP = _HTTP;
	Маршрут = _Маршрут;

	СостояниеХаба = _СостояниеХаба;
	ОписаниеПриложения = _ОписаниеПриложения;
	Числа = _Числа;
	База = _База;
	Ответы = _Ответы;
	ПустыеКуки = _ПустыеКуки;

КонецПроцедуры
