// Служебные эндпоинты API: GET /api/v1/health — алиас корневого /health,
// GET /api/v1/metrics — эксплуатационные счётчики. winow не различает метод роутером,
// поэтому контроллер разбирает его сам.

Перем СостояниеХаба;        // СостояниеХаба (наблюдаемость)
Перем ОписаниеПриложения;   // ОписаниеПриложения (запуск)
Перем СервисПулов;          // СервисПулов (реестр)
Перем СервисПакетов;        // СервисПакетов (реестр)
Перем Ответы;               // ОтветыAPI (auth)
Перем ПустыеКуки;           // Куки (winow)
Перем HTTP;        // МетодыHTTP (основа)

#Область ТочкиМаршрута

// GET /api/v1/health — статус, версия и аптайм хаба.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//
&ТочкаМаршрута("health")
Процедура Здоровье(Ответ, МетодЗапроса) Экспорт

	Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтветМетодНеРазрешён(Ответ, "GET");
		Возврат;
	КонецЕсли;

	Данные = Новый Структура();
	Данные.Вставить("status", "ok");
	Данные.Вставить("version", ОписаниеПриложения.Версия());
	Данные.Вставить("uptime_seconds", СостояниеХаба.АптаймСекунд());
	Ответы.JSON(Ответ, 200, Данные);

КонецПроцедуры

// GET /api/v1/metrics — статус, версия, аптайм и размеры публичной части реестра.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//
&ТочкаМаршрута("metrics")
Процедура Метрики(Ответ, МетодЗапроса) Экспорт

	Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтветМетодНеРазрешён(Ответ, "GET");
		Возврат;
	КонецЕсли;

	Данные = Новый Структура();
	Данные.Вставить("status", "ok");
	Данные.Вставить("version", ОписаниеПриложения.Версия());
	Данные.Вставить("uptime_seconds", СостояниеХаба.АптаймСекунд());
	Данные.Вставить("pools_total", БезопасныйСчёт("пулы"));
	Данные.Вставить("packages_total", БезопасныйСчёт("пакеты"));
	Ответы.JSON(Ответ, 200, Данные);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// /metrics анонимен, поэтому считаем только публичное: приватные пулы и скрытые пакеты
// не должны раскрываться агрегатным числом. Сбой подсчёта не роняет эндпоинт — вернём -1.
Функция БезопасныйСчёт(Знач Что)
	Попытка
		ПуловПублично = 0;
		ПакетовПублично = 0;
		Для Каждого Пул Из СервисПулов.ВсеПулы() Цикл
			Если НЕ ПулПубличный(Пул) Тогда
				Продолжить;
			КонецЕсли;
			ПуловПублично = ПуловПублично + 1;
			Для Каждого Пакет Из СервисПакетов.ПакетыПула(Пул.Идентификатор) Цикл
				Если Пакет.Скрыт <> Истина Тогда
					ПакетовПублично = ПакетовПублично + 1;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Возврат ?(Что = "пулы", ПуловПублично, ПакетовПублично);
	Исключение
		Возврат -1;
	КонецПопытки;
КонецФункции

// Публичен, только если видимость явно "public".
Функция ПулПубличный(Знач Пул)
	Возврат НРег(СокрЛП(Строка(Пул.Видимость))) = "public";
КонецФункции

Процедура ОтветМетодНеРазрешён(Ответ, Знач Разрешённый)
	Ответ.Заголовки["Allow"] = Разрешённый;
	Ответы.Ошибка(Ответ, 405, "method_not_allowed", СтрШаблон("Разрешён только метод %1", Разрешённый));
КонецПроцедуры

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СостояниеХаба") _СостояниеХаба,
	&Пластилин(Значение = "ОписаниеПриложения") _ОписаниеПриложения,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "Куки") _ПустыеКуки,
	&Пластилин(Значение = "МетодыHTTP") _HTTP)

	HTTP = _HTTP;

	СостояниеХаба = _СостояниеХаба;
	ОписаниеПриложения = _ОписаниеПриложения;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	Ответы = _Ответы;
	ПустыеКуки = _ПустыеКуки;

КонецПроцедуры
