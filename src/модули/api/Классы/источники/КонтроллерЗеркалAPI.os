// Зеркала пула в API — то же, что раздел «Зеркала» дома настроек пула: список, заведение,
// включение и выключение, токен, удаление и синхронизация по требованию.

Перем Ответы;        // ОтветыAPI (основа)
Перем Запрос;        // ЗапросAPI (протоколAPI)
Перем Маршрут;       // МаршрутAPI (протоколAPI)
Перем Допуск;        // ДопускAPI (api)
Перем Двери;         // ДвериAPI (api)
Перем ПрологПравки;  // ПрологПравкиAPI (api)
Перем Страницы;      // СтраницыAPI (протоколAPI)
Перем СервисЗеркал;  // СервисЗеркал (зеркала)
Перем Очередь;       // ОчередьСинхронизацииЗеркал (зеркала)
Перем Числа;         // ПриведениеЧисел (основа)
Перем HTTP;          // МетодыHTTP (основа)
Перем Секрет;        // СекретИсточника (прокси) — задан ли токен у зеркала
Перем Моменты;       // МоментISO (основа) — одно написание времени в ответе
Перем Причины;       // ПричиныЗеркала (зеркала) — почему обход не привёз версии
Перем Ошибки;        // ТекстОшибки (основа)
&Лог
Перем Лог;

#Область ТочкиМаршрута

// Зеркала пула: список и заведение.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для POST.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и POST.
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию — весь список
//             до потолка выдачи).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//  ТелоЗапросаОбъект - Произвольный - тело, разобранное winow по схеме описания; точка его не читает.
//
&ТочкаМаршрута("pools/{Пул}/mirrors", Метод = "get, post")
&Операция(Сводка = "Зеркала пула (GET); заведение зеркала (POST)",
	Описание = "GET — зеркала пула, POST — заводит зеркало источника `url`. Нужна роль мейнтейнера
	|пула или выше.")
&Возвращает(Код = 200, Тип = "СтраницаЗеркалJSON", Описание = "GET: зеркала пула")
&Возвращает(Код = 201, Тип = "КарточкаЗеркалаJSON", Описание = "POST: зеркало заведено")
&Возвращает(Код = 400, Тип = "ОтказJSON", Описание = "`invalid_mirror`, `mode_not_accepted`")
&Возвращает(Код = 401, Тип = "ОтказJSON", Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Тип = "ОтказJSON", Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 405, Тип = "ОтказJSON", Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 404, Тип = "ОтказJSON", Описание = "`pool_not_found` — пула нет")
&Возвращает(Код = 422, Тип = "ОтказJSON", Описание = "`invalid_mirror` — источник не принят")
Процедура Зеркала(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	page = "", pageSize = "", ПараметрыЗапросаПорядковые = Неопределено,
	&Тип("ЗапросЗеркалаJSON") ТелоЗапросаОбъект = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Список(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, page, pageSize);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Создать(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Иначе
		Маршрут.МетодНеРазрешён(Ответ, "GET, POST");
	КонецЕсли;

КонецПроцедуры

// Зеркало пула: карточка, правка и удаление.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Ид - Строка - идентификатор зеркала из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для PATCH и DELETE.
//  МетодЗапроса - Строка - метод запроса; допустимы GET, PATCH и DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//  ТелоЗапросаОбъект - Произвольный - тело, разобранное winow по схеме описания; точка его не читает.
//
&ТочкаМаршрута("pools/{Пул}/mirrors/{Ид}", Метод = "get, patch, delete")
&Операция(Сводка = "Карточка зеркала (GET); правка зеркала (PATCH); удаление зеркала (DELETE)",
	Описание = "GET — зеркало и причины, по которым обход не привёз версии. PATCH — включает,
	|выключает или меняет токен; DELETE — удаляет. Нужна роль мейнтейнера пула или выше.")
&Возвращает(Код = 200, Тип = "ЗеркалоИлиСносJSON", Описание = "Зеркало; DELETE: зеркало удалено")
&Возвращает(Код = 400, Тип = "ОтказJSON", Описание = "`migrate_immutable`, `no_changes`")
&Возвращает(Код = 401, Тип = "ОтказJSON", Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Тип = "ОтказJSON", Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 405, Тип = "ОтказJSON", Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 404, Тип = "ОтказJSON", Описание = "`mirror_not_found`, `pool_not_found`")
&Возвращает(Код = 422, Тип = "ОтказJSON", Описание = "`invalid_mirror` — токен не принят")
&Возвращает(Код = 500, Тип = "ОтказJSON",
	Описание = "`mirror_update_failed`, `mirror_delete_failed` — сбой хаба")
Процедура Зеркало(Ответ, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено,
	&Тип("ЗапросПравкиЗеркалаJSON") ТелоЗапросаОбъект = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Карточка(Ответ, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "PATCH") Тогда
		Изменить(Ответ, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		Удалить(Ответ, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Иначе
		Маршрут.МетодНеРазрешён(Ответ, "GET, PATCH, DELETE");
	КонецЕсли;

КонецПроцедуры

// Постановка зеркала в очередь синхронизации.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Ид - Строка - идентификатор зеркала из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только POST.
//  ТелоЗапросаОбъект - Произвольный - тело, разобранное winow по схеме описания; точка его не читает.
//
&ТочкаМаршрута("pools/{Пул}/mirrors/{Ид}/sync", Метод = "post")
&Операция(Сводка = "Постановка зеркала в очередь синхронизации",
	Описание = "Ставит зеркало в очередь и отвечает сразу, не дожидаясь синхронизации. Нужна роль
	|мейнтейнера пула или выше.")
&Возвращает(Код = 202, Тип = "ПостановкаСинхронизацииJSON",
	Описание = "Зеркало в очереди, итога синхронизации нет")
&Возвращает(Код = 401, Тип = "ОтказJSON", Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Тип = "ОтказJSON", Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 405, Тип = "ОтказJSON", Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 404, Тип = "ОтказJSON", Описание = "`mirror_not_found`, `pool_not_found`")
&Возвращает(Код = 503, Тип = "ОтказJSON", Описание = "`sync_disabled` — синхронизация зеркал выключена")
Процедура Синхронизация(Ответ, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	&Тип("ЗапросБезПолейJSON") ТелоЗапросаОбъект = Неопределено) Экспорт

	Если НЕ Маршрут.НачатьДействие(Ответ, Неопределено, МетодЗапроса, "POST") Тогда
		Возврат;
	КонецЕсли;

	Заявка = НачатьМутациюЗеркала(Ответ, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Заявка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Зеркало = Заявка.Зеркало;
	Принято = Очередь.Поставить(Зеркало.Идентификатор, ЛогинПользователя(Заявка.Пользователь));

	// выключенную синхронизацию никто не разберёт — 202 было бы неправдой
	Если Очередь.Состояние(Зеркало.Идентификатор) = "выключено" Тогда
		Ответы.Ошибка(Ответ, 503, "sync_disabled",
			"Фоновая синхронизация зеркал выключена на этом хабе (oshub.mirror.sync_enabled)");
		Возврат;
	КонецЕсли;

	Сводка = Новый Структура();
	Сводка.Вставить("accepted", Принято);
	Сводка.Вставить("state", Очередь.Состояние(Зеркало.Идентификатор));
	Сводка.Вставить("queued", Очередь.Размер());

	ОтдатьПеречитанное(Ответ, 202, Заявка.Пул, Зеркало, Сводка);

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура Список(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач page, Знач pageSize)

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	Пул = Двери.АдминистрируемыйПул(Ответ, ИмяПула, Принципал);
	Если Пул = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Элементы = Новый Массив();
	Для Каждого Запись Из СервисЗеркал.СписокПула(Пул.Идентификатор) Цикл
		Элементы.Добавить(ЗеркалоВJSON(Запись));
	КонецЦикла;

	Ответы.JSON(Ответ, 200, Страницы.Перечень(Элементы, page, pageSize));

КонецПроцедуры

Процедура Карточка(Ответ, Знач ИмяПула, Знач Ид, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	Пул = Двери.АдминистрируемыйПул(Ответ, ИмяПула, Принципал);
	Если Пул = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запись = НайтиЗеркало(Ответ, Пул, Ид);
	Если Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ответы.JSON(Ответ, 200, Новый Структура("mirror", ЗеркалоКарточкой(Запись)));

КонецПроцедуры

Процедура Создать(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Мутация = ПрологПравки.АдминистрированиеПула(Ответ, ИмяПула, ЗаголовкиЗапроса, КукиЗапроса,
		ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Тело = Мутация.Тело;
	Url = СокрЛП(Запрос.Поле(Тело, "url"));
	Если НЕ ЗначениеЗаполнено(Url) Тогда
		Ответы.Ошибка(Ответ, 400, "invalid_mirror", "Требуется непустое поле url");
		Возврат;
	КонецЕсли;

	Интервал = Числа.ЦелоеИлиНеопределено(Запрос.Поле(Тело, "интервал",
		Запрос.Поле(Тело, "interval", "")), 0);
	Если Интервал = Неопределено Тогда
		Ответы.Ошибка(Ответ, 400, "invalid_mirror", "Поле интервал — целое число секунд");
		Возврат;
	КонецЕсли;

	// названный человеком протокол — отказ, а не молчаливо проигнорированное пожелание
	Если Запрос.Присланное(Тело, "режим,mode") <> Неопределено Тогда
		Ответы.Ошибка(Ответ, 400, "mode_not_accepted",
			"Протокол определяется хабом: поле режим (mode) не задаётся. Хаб пробует срез"
			+ " изменений источника, не ответил — читает источник как легаси-хаб");
		Возврат;
	КонецЕсли;

	Попытка
		Запись = СервисЗеркал.Создать(Мутация.Пользователь, Мутация.Пул, Url,
			СокрЛП(Запрос.Поле(Тело, "фильтр", Запрос.Поле(Тело, "filter"))),
			Интервал,
			Запрос.Поле(Тело, "token", Запрос.Поле(Тело, "токен")),
			ПризнакПереноса(Тело) = Истина);
	Исключение
		// текст домена несёт пользовательский ввод — наружу уходит фиксированный
		Ответы.Сбой(Ответ, 422, "invalid_mirror",
			"Зеркало не заведено: проверьте адрес апстрима, фильтр, токен доступа,"
			+ " лимит зеркал на пул и что пул вообще тянет внешние источники"
			+ " (личное пространство пользователя — нет)", ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Ответы.JSON(Ответ, 201, Новый Структура("mirror", ЗеркалоВJSON(Запись)));

КонецПроцедуры

Процедура Изменить(Ответ, Знач ИмяПула, Знач Ид, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Правка = НачатьМутациюЗеркала(Ответ, ИмяПула, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Правка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// перенос судится первым: иначе запрос только с ним отвечал бы «нечего менять»
	Если ПризнакПереноса(Правка.Тело) <> Неопределено Тогда
		Ответы.Ошибка(Ответ, 400, "migrate_immutable",
			"Режим переноса (migrate) задаётся при заведении зеркала и задним числом"
			+ " не меняется: приехавшее прежде осталось бы привезённым. Нужен перенос —"
			+ " заведите зеркало переноса заново");
		Возврат;
	КонецЕсли;

	Включено = Запрос.ПрисланныйФлаг(Правка.Тело, "включено,включить,enabled");
	Токен = СокрЛП(Запрос.Поле(Правка.Тело, "token", Запрос.Поле(Правка.Тело, "токен")));
	СнятиеТокена = Запрос.СнятиеТокенаИсточника(Правка.Тело);

	Если Включено = Неопределено И НЕ ЗначениеЗаполнено(Токен) И НЕ СнятиеТокена Тогда
		Ответы.Ошибка(Ответ, 400, "no_changes",
			"Не указано ни одно поле: включено (enabled), токен доступа (token),"
			+ " снятие токена (token_remove)");
		Возврат;
	КонецЕсли;

	// токен применяется первым: непригодное значение отменяет запрос целиком
	Применено = Новый Массив();
	Попытка
		ТокенПринят = ПрименитьТокен(Ответ, Правка, Токен, СнятиеТокена);
	Исключение
		ОтказатьСбоемПравки(Ответ, Применено, ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	Если НЕ ТокенПринят Тогда
		Возврат;
	КонецЕсли;
	Если СнятиеТокена ИЛИ ЗначениеЗаполнено(Токен) Тогда
		Применено.Добавить("token");
	КонецЕсли;

	Если Включено <> Неопределено Тогда
		Попытка
			СервисЗеркал.Переключить(Правка.Пользователь, Правка.Пул, Правка.Зеркало.Идентификатор, Включено);
		Исключение
			ОтказатьСбоемПравки(Ответ, Применено, ИнформацияОбОшибке());
			Возврат;
		КонецПопытки;
	КонецЕсли;

	ОтдатьПеречитанное(Ответ, 200, Правка.Пул, Правка.Зеркало);

КонецПроцедуры

// Ложь означает, что ответ уже записан и вызывающий обязан выйти.
Функция ПрименитьТокен(Ответ, Знач Правка, Знач Токен, Знач Снятие)

	Если Снятие Тогда
		СервисЗеркал.СнятьТокен(Правка.Пользователь, Правка.Пул, Правка.Зеркало.Идентификатор);
		Возврат Истина;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		Возврат Истина; // пустое поле означает «оставить прежний»
	КонецЕсли;

	Попытка
		СервисЗеркал.ЗадатьТокен(Правка.Пользователь, Правка.Пул,
			Правка.Зеркало.Идентификатор, Токен);
	Исключение
		// текст домена несёт пользовательский ввод, наружу уходит фиксированный
		Ответы.Сбой(Ответ, 422, "invalid_mirror",
			"Токен доступа не принят: он состоит из печатных символов латиницы без пробелов",
			ИнформацияОбОшибке());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

Процедура Удалить(Ответ, Знач ИмяПула, Знач Ид, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Правка = НачатьМутациюЗеркала(Ответ, ИмяПула, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Правка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Удалено = СервисЗеркал.Удалить(Правка.Пользователь, Правка.Пул, Правка.Зеркало.Идентификатор);
	Исключение
		Ответы.Сбой(Ответ, 500, "mirror_delete_failed",
			"Зеркало не удалено: сбой хаба, запрос можно повторить", ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Ответы.JSON(Ответ, 200, Новый Структура("deleted", Удалено));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пролог мутации зеркала: администрирование пула и само зеркало этого пула.
Функция НачатьМутациюЗеркала(Ответ, Знач ИмяПула, Знач Ид, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Мутация = ПрологПравки.АдминистрированиеПула(Ответ, ИмяПула, ЗаголовкиЗапроса, КукиЗапроса,
		ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запись = НайтиЗеркало(Ответ, Мутация.Пул, Ид);
	Если Запись = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Мутация.Вставить("Зеркало", Запись);
	Возврат Мутация;

КонецФункции

// Зеркало этого пула; чужое и несуществующее одинаково дают 404.
Функция НайтиЗеркало(Ответ, Знач Пул, Знач Ид)

	Запись = СервисЗеркал.ЗеркалоПула(Пул, Числа.ЧислоИлиНоль(Ид));
	Если Запись = Неопределено Тогда
		ЗеркалоНеНайдено(Ответ);
	КонецЕсли;
	Возврат Запись;

КонецФункции

// Признак «перенос» из тела; Неопределено — поля в теле нет.
Функция ПризнакПереноса(Знач Тело)
	Возврат Запрос.ПрисланныйФлаг(Тело, "migrate,перенос");
КонецФункции

// Перечитанное зеркало: ответ на мутацию показывает запись после неё, а не копию в руках.
// Зеркало, снятое параллельно, — 404.
Процедура ОтдатьПеречитанное(Ответ, Знач Код, Знач Пул, Знач Зеркало, Знач Сводка = Неопределено)

	Запись = СервисЗеркал.ЗеркалоПула(Пул, Зеркало.Идентификатор);
	Если Запись = Неопределено Тогда
		ЗеркалоНеНайдено(Ответ);
		Возврат;
	КонецЕсли;

	Данные = Новый Структура();
	Если Сводка <> Неопределено Тогда
		Данные.Вставить("sync", Сводка);
	КонецЕсли;
	Данные.Вставить("mirror", ЗеркалоВJSON(Запись));
	Ответы.JSON(Ответ, Код, Данные);

КонецПроцедуры

// Сбой правки называет, что из неё уже применено: повтор по тексту ответа не должен врать.
Процедура ОтказатьСбоемПравки(Ответ, Знач Применено, Знач Инфо)

	Если Применено.Количество() = 0 Тогда
		Ответы.Сбой(Ответ, 500, "mirror_update_failed",
			"Зеркало не изменено: сбой хаба, запрос можно повторить", Инфо);
		Возврат;
	КонецЕсли;

	Ответы.Сбой(Ответ, 500, "mirror_update_failed",
		"Токен доступа зеркала изменён, включение — нет: сбой хаба, повторите запрос с полем enabled",
		Инфо, Новый Структура("applied", Применено));

КонецПроцедуры

Процедура ЗеркалоНеНайдено(Ответ)
	Ответы.Ошибка(Ответ, 404, "mirror_not_found", "Зеркало не найдено в этом пуле");
КонецПроцедуры

// Инициатор заявки называется логином, а не числом.
Функция ЛогинПользователя(Знач Пользователь)
	Возврат ?(Пользователь = Неопределено, "", СокрЛП(Строка(Пользователь.Логин)));
КонецФункции

// По записи, которая уже в руках: иначе список пула стал бы N+1 запросом.
Функция ПрогонВJSON(Знач Запись)
	Прогон = СервисЗеркал.СостояниеПрогонаПоЗаписи(Запись);
	Если Прогон = Неопределено Тогда
		Возврат Новый Структура();
	КонецЕсли;
	Структура = Новый Структура();
	Структура.Вставить("state", Прогон.Состояние);
	Структура.Вставить("started", Моменты.Строкой(Прогон.Начат));
	Структура.Вставить("updated", Моменты.Строкой(Прогон.Обновлён));
	Структура.Вставить("total", Прогон.Всего);
	Структура.Вставить("downloaded", Прогон.Скачано);
	Структура.Вставить("skipped", Прогон.Пропущено);
	Структура.Вставить("errors", Прогон.Ошибок);
	Структура.Вставить("unavailable", Прогон.Недоступно);
	// шкала обхода — в именах апстрима: она монотонна
	Структура.Вставить("names_total", Прогон.ИмёнВсего);
	Структура.Вставить("names_done", Прогон.ИмёнПройдено);
	Структура.Вставить("cursor", Прогон.Курсор);
	Структура.Вставить("started_by", Прогон.Запустил);
	// способ обхода и момент, с которого инкрементный проход спрашивает изменения
	Структура.Вставить("crawl", Прогон.Способ);
	Структура.Вставить("crawl_since", Моменты.Строкой(Прогон.СрезС));
	Структура.Вставить("read_up_to", Моменты.Строкой(Прогон.ВычитаноДо));
	// брошенный прогон не выдаётся за живой
	Структура.Вставить("stale", СервисЗеркал.ПрогонБрошен(Запись));
	Возврат Структура;
КонецФункции

// Причины текущего обхода несёт только карточка одного зеркала: в списке они стоили бы
// обращения к базе на каждое зеркало.
Функция ЗеркалоКарточкой(Знач Запись)

	Перем Прочитанное; // местная: желудь один на все запросы


	Прочитанное = ПричиныОбхода(Запись);
	Структура = ЗеркалоВJSON(Запись);
	Структура.Вставить("incidents", Прочитанное.Список);
	// признак разводит «причин нет» и «причины не прочитаны»
	Структура.Вставить("incidents_readable", Прочитанное.Прочитано);
	Возврат Структура;

КонецФункции

// Недоступные причины карточку не роняют: они отдаются признаком «не прочитаны».
Функция ПричиныОбхода(Знач Запись)

	Перем Список; // местные: желудь один на все запросы
	Перем Снимки;

	Список = Новый Массив();
	Попытка
		Снимки = Причины.Обхода(Запись);
	Исключение
		Лог.Предупреждение("Карточка зеркала #%1: причины обхода не прочитаны: %2",
			Запись.Идентификатор, Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат Новый Структура("Прочитано, Список", Ложь, Список);
	КонецПопытки;

	Для Каждого Снимок Из Снимки Цикл
		Список.Добавить(ПричинаВJSON(Снимок));
	КонецЦикла;
	Возврат Новый Структура("Прочитано, Список", Истина, Список);

КонецФункции

Функция ПричинаВJSON(Знач Снимок)
	Структура = Новый Структура();
	// предмет пуст, когда не взят весь обход
	Структура.Вставить("subject", Строка(Снимок.Предмет));
	Структура.Вставить("code", Строка(Снимок.Код));
	Структура.Вставить("reason", Строка(Снимок.Причина));
	Структура.Вставить("count", Цел(Снимок.Количество));
	Структура.Вставить("first_seen", Моменты.Строкой(Снимок.Впервые));
	Структура.Вставить("last_seen", Моменты.Строкой(Снимок.Последний));
	// true — пройдёт следующим заходом, false — пропущено насовсем, null — исход неизвестен
	Структура.Вставить("recoverable", Признак(Снимок));
	Возврат Структура;
КонецФункции

Функция Признак(Знач Снимок)
	Возврат ?(Снимок.ИсходНеясен = Истина, Неопределено, Снимок.Устранимо = Истина);
КонецФункции

// Токен наружу не печатается — только признак.
Функция ЗеркалоВJSON(Знач Запись)
	Структура = Новый Структура();
	Структура.Вставить("id", Запись.Идентификатор);
	Структура.Вставить("pool_id", Цел(Запись.ПулНазначенияИдентификатор));
	Структура.Вставить("upstream_url", Строка(Запись.АпстримURL));
	Структура.Вставить("token_set", Секрет.Задан(Секрет.ИзИсточника(Запись)));
	// протокол — наблюдение хаба: пустой, пока удачной пробы не было
	Структура.Вставить("protocol", СервисЗеркал.Протокол(Запись));
	Структура.Вставить("migrate", Запись.Перенос = Истина);
	Структура.Вставить("filter", ?(ЗначениеЗаполнено(Запись.ФильтрJSON), Строка(Запись.ФильтрJSON), ""));
	Структура.Вставить("interval", Цел(Запись.ИнтервалСинкаСек));
	Структура.Вставить("enabled", Запись.Включено = Истина);
	Структура.Вставить("status", Строка(Запись.Статус));
	Структура.Вставить("last_sync", Моменты.Строкой(Запись.ПоследнийСинк));
	Структура.Вставить("queue_state", Очередь.СостояниеПоЗаписи(Запись));
	Структура.Вставить("run", ПрогонВJSON(Запись));
	Возврат Структура;
КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
&Группа("Зеркала", Описание = "Зеркала пула: фоновое копирование пакетов из другого хаба.")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ЗапросAPI") _Запрос,
	&Пластилин(Значение = "МаршрутAPI") _Маршрут,
	&Пластилин(Значение = "ДопускAPI") _Допуск,
	&Пластилин(Значение = "ДвериAPI") _Двери,
	&Пластилин(Значение = "ПрологПравкиAPI") _ПрологПравки,
	&Пластилин(Значение = "СтраницыAPI") _Страницы,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Пластилин(Значение = "ОчередьСинхронизацииЗеркал") _Очередь,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "СекретИсточника") _Секрет,
	&Пластилин(Значение = "ПричиныЗеркала") _Причины,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "МоментISO") _Моменты = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Ответы = _Ответы;
	Запрос = _Запрос;
	Маршрут = _Маршрут;
	Допуск = _Допуск;
	Двери = _Двери;
	ПрологПравки = _ПрологПравки;
	Страницы = _Страницы;
	СервисЗеркал = _СервисЗеркал;
	Очередь = _Очередь;
	Числа = _Числа;
	HTTP = _HTTP;
	Секрет = _Секрет;
	Причины = _Причины;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Моменты = ?(_Моменты = Неопределено, Новый МоментISO(), _Моменты);
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);

КонецПроцедуры
