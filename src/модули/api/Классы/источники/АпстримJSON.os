// Апстрим пула: адрес, порядок опроса, кэш и состояние.

&Сериализуемое("id")
&Заполнено
&Тип("Число")
Перем Ид;

&Сериализуемое("url")
&Заполнено
&Тип("Строка")
Перем Адрес;

&Сериализуемое("order")
&Заполнено
&Тип("Число")
Перем Порядок;

&Сериализуемое("ttl")
&Заполнено
&Тип("Число")
Перем СрокКэша;

&Сериализуемое("allowlist")
&Заполнено
&Тип("Строка")
Перем СписокРазрешений;

&Сериализуемое("token_set")
&Заполнено
&Тип("Булево")
Перем ТокенЗадан;

&Сериализуемое("state")
&Заполнено
&Тип("Строка")
&ОдинИз("alive", "down", "denied", "unknown", "disabled")
Перем Состояние;

&Сериализуемое("reason")
&Заполнено
&Тип("Строка")
Перем Причина;

&Сериализуемое("checked_at")
&Заполнено
&Тип("Строка")
Перем Проверен;

&Сериализуемое("last_failure")
&Тип("НеудачаИсточникаJSON")
Перем ПрошлаяНеудача;
