// Тело заведения зеркала.

&Сериализуемое("url")
&Заполнено
&Тип("Строка")
Перем Адрес;

&Сериализуемое("interval")
&Тип("Число")
Перем Интервал;

&Сериализуемое("filter")
&Тип("Строка")
Перем Фильтр;

&Сериализуемое("token")
&Тип("Строка")
Перем Токен;

&Сериализуемое("migrate")
&Тип("Булево")
Перем Перенос;
