// Прогон синхронизации зеркала: состояние, счётчики и срез обхода.

&Сериализуемое("state")
&Заполнено
&Тип("Строка")
&ОдинИз("простаивает", "поставлено", "идёт", "завершён", "ошибка")
Перем Состояние;

&Сериализуемое("started")
&Заполнено
&Тип("Строка")
Перем Начат;

&Сериализуемое("updated")
&Заполнено
&Тип("Строка")
Перем Обновлён;

&Сериализуемое("total")
&Заполнено
&Тип("Число")
Перем Всего;

&Сериализуемое("downloaded")
&Заполнено
&Тип("Число")
Перем Скачано;

&Сериализуемое("skipped")
&Заполнено
&Тип("Число")
Перем Пропущено;

&Сериализуемое("errors")
&Заполнено
&Тип("Число")
Перем Ошибок;

&Сериализуемое("unavailable")
&Заполнено
&Тип("Число")
Перем Недоступно;

&Сериализуемое("names_total")
&Заполнено
&Тип("Число")
Перем ИмёнВсего;

&Сериализуемое("names_done")
&Заполнено
&Тип("Число")
Перем ИмёнПройдено;

&Сериализуемое("cursor")
&Заполнено
&Тип("Строка")
Перем Курсор;

&Сериализуемое("started_by")
&Заполнено
&Тип("Строка")
Перем Запустил;

&Сериализуемое("crawl")
&Заполнено
&Тип("Строка")
&ОдинИз("полный", "инкремент")
Перем Обход;

&Сериализуемое("crawl_since")
&Заполнено
&Тип("Строка")
Перем ОбходС;

&Сериализуемое("read_up_to")
&Заполнено
&Тип("Строка")
Перем ПрочитаноДо;

&Сериализуемое("stale")
&Заполнено
&Тип("Булево")
Перем Брошен;
