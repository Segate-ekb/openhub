// Происшествие синхронизации зеркала; null в recoverable — исход неизвестен.

&Сериализуемое("subject")
&Заполнено
&Тип("Строка")
Перем Предмет;

&Сериализуемое("code")
&Заполнено
&Тип("Строка")
Перем Код;

&Сериализуемое("reason")
&Заполнено
&Тип("Строка")
Перем Причина;

&Сериализуемое("count")
&Заполнено
&Тип("Число")
Перем Раз;

&Сериализуемое("first_seen")
&Заполнено
&Тип("Строка")
Перем ВпервыеЗамечено;

&Сериализуемое("last_seen")
&Заполнено
&Тип("Строка")
Перем ПоследнийРаз;

&Сериализуемое("recoverable", Обязательное = Истина)
&Тип("Булево")
Перем Поправимо;
