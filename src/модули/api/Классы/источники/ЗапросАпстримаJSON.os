// Тело заведения апстрима и его снятия по адресу.

// BSLLS:MissingVariablesDescription-off
&Сериализуемое("url")
&Заполнено
Перем Адрес;

&Сериализуемое("ttl")
Перем СрокКэша;

&Сериализуемое("allowlist")
Перем СписокРазрешений;

&Сериализуемое("token")
Перем Токен;

&Сериализуемое("token_remove")
Перем СнятьТокен;
// BSLLS:MissingVariablesDescription-on
