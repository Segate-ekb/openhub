// Тело заведения апстрима и его снятия по адресу.

&Сериализуемое("url")
&Заполнено
&Тип("Строка")
Перем Адрес;

&Сериализуемое("ttl")
&Тип("Число")
Перем СрокКэша;

&Сериализуемое("allowlist")
&Тип("Строка")
Перем СписокРазрешений;

&Сериализуемое("token")
&Тип("Строка")
Перем Токен;

&Сериализуемое("token_remove")
&Тип("Булево")
Перем СнятьТокен;
