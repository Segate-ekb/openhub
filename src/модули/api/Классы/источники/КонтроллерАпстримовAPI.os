// Апстримы пула в API — то же, что раздел «Источники» дома настроек пула: список в порядке
// опроса, заведение и правка, снятие.

Перем Ответы;        // ОтветыAPI (основа)
Перем Запрос;        // ЗапросAPI (протоколAPI)
Перем Маршрут;       // МаршрутAPI (протоколAPI)
Перем Допуск;        // ДопускAPI (api)
Перем Двери;         // ДвериAPI (api)
Перем ПрологПравки;  // ПрологПравкиAPI (api)
Перем Страницы;      // СтраницыAPI (протоколAPI)
Перем Апстримы;      // СервисАпстримовПула (реестр) — состав и порядок источников пула
Перем Числа;         // ПриведениеЧисел (основа)
Перем HTTP;          // МетодыHTTP (основа)
Перем Секрет;        // СекретИсточника (прокси) — задан ли токен у источника
Перем Вердикты;      // СостояниеИсточников (прокси) — жив источник, лежит или молчал до перезапуска
Перем Моменты;       // МоментISO (основа) — одно написание времени в ответе

#Область ТочкиМаршрута

// Апстримы пула: список, заведение и снятие.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для POST и DELETE.
//  МетодЗапроса - Строка - метод запроса; допустимы GET, POST и DELETE.
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию — весь список
//             до потолка выдачи).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/upstreams", Метод = "get, post, delete")
&Группа("Апстримы", Описание = "Источники, которые пул опрашивает на лету.")
&Операция(Сводка = "Апстримы пула (GET); заведение и правка (POST); снятие апстрима (DELETE)",
	Описание = "GET — апстримы в порядке опроса. POST — заводит апстрим `url` или обновляет
	|заведённый, DELETE — снимает апстрим `url`. Нужна роль мейнтейнера пула или выше.")
&Возвращает(Код = 200, Описание = "GET: апстримы пула; DELETE: снят ли апстрим")
&Возвращает(Код = 201, Описание = "POST: апстрим заведён или обновлён")
&Возвращает(Код = 400, Описание = "`invalid_upstream` — пустой `url` либо негодный `ttl`")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 404, Описание = "`pool_not_found` — пула нет")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`invalid_upstream` — источник не принят")
Процедура Апстримы(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	page = "", pageSize = "", ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Список(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, page, pageSize);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Завести(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		Снять(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Иначе
		Маршрут.МетодНеРазрешён(Ответ, "GET, POST, DELETE");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура Список(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач page, Знач pageSize)

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	Пул = Двери.АдминистрируемыйПул(Ответ, ИмяПула, Принципал);
	Если Пул = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Элементы = Новый Массив();
	Для Каждого Показание Из Вердикты.ПоИсточникам(Апстримы.Все(Пул.Идентификатор)) Цикл
		Элементы.Добавить(АпстримВJSON(Показание.Источник, Показание.Состояние));
	КонецЦикла;

	Ответы.JSON(Ответ, 200, Страницы.Перечень(Элементы, page, pageSize));

КонецПроцедуры

Процедура Завести(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Правка = ПрологПравки.АдминистрированиеПула(Ответ, ИмяПула, ЗаголовкиЗапроса, КукиЗапроса,
		ТелоЗапроса);
	Если Правка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Тело = Правка.Тело;
	Url = СокрЛП(Запрос.Поле(Тело, "url"));
	Если НЕ ЗначениеЗаполнено(Url) Тогда
		Ответы.Ошибка(Ответ, 400, "invalid_upstream", "Требуется непустое поле url");
		Возврат;
	КонецЕсли;

	// ноль здесь значим («без кэша»), поэтому мусор нельзя молча приводить к нулю
	TTL = Числа.ЦелоеИлиНеопределено(Запрос.Поле(Тело, "ttl", ""), 900);
	Если TTL = Неопределено Тогда
		Ответы.Ошибка(Ответ, 400, "invalid_upstream", "Поле ttl — целое число секунд");
		Возврат;
	КонецЕсли;

	// снятие токена — тем же вызовом: неудачная проба не оставит его наполовину снятым
	Попытка
		Апстрим = Апстримы.Записать(Правка.Пул, Url, TTL,
			Запрос.Поле(Тело, "allowlist", Запрос.Поле(Тело, "список_разрешений")),
			Запрос.Поле(Тело, "token", Запрос.Поле(Тело, "токен")),
			Запрос.СнятиеТокенаИсточника(Тело));
	Исключение
		// SSRF-вердикт и запрет по типу пула — ввод, а не поломка: 422 с фиксированным текстом
		Ответы.Сбой(Ответ, 422, "invalid_upstream",
			"Апстрим не принят: проверьте адрес, allowlist, ttl, токен доступа и тип пула",
			ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Ответы.JSON(Ответ, 201, Новый Структура("upstream", АпстримВJSON(Апстрим, СостояниеОдного(Апстрим))));

КонецПроцедуры

Процедура Снять(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Правка = ПрологПравки.АдминистрированиеПула(Ответ, ИмяПула, ЗаголовкиЗапроса, КукиЗапроса,
		ТелоЗапроса);
	Если Правка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Url = СокрЛП(Запрос.Поле(Правка.Тело, "url"));
	Если НЕ ЗначениеЗаполнено(Url) Тогда
		Ответы.Ошибка(Ответ, 400, "invalid_upstream", "Требуется непустое поле url");
		Возврат;
	КонецЕсли;

	Снято = Апстримы.Удалить(Правка.Пул.Идентификатор, Url);
	Ответы.JSON(Ответ, 200, Новый Структура("removed", Снято));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Токен наружу не печатается — только признак; адрес — как заведён администратором пула.
Функция АпстримВJSON(Знач Апстрим, Знач Состояние)

	Структура = Новый Структура();
	Структура.Вставить("id", Апстрим.Идентификатор);
	Структура.Вставить("url", Строка(Апстрим.Url));
	Структура.Вставить("order", Цел(Апстрим.Порядок));
	Структура.Вставить("ttl", Цел(Апстрим.ВремяЖизниСек));
	Структура.Вставить("allowlist", ?(ЗначениеЗаполнено(Апстрим.СписокРазрешенийJSON),
		Строка(Апстрим.СписокРазрешенийJSON), ""));
	Структура.Вставить("token_set", Секрет.Задан(Секрет.ИзИсточника(Апстрим)));

	Для Каждого Поле Из СостояниеВJSON(Апстрим, Состояние) Цикл
		Структура.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;

	Возврат Структура;

КонецФункции

// Тумблер записи складывается с живостью адреса правилом экрана; без прошлой неудачи поля
// last_failure нет вовсе.
Функция СостояниеВJSON(Знач Апстрим, Знач Состояние)

	Показанное = Вердикты.СУчётомТумблера(Состояние, Апстрим.Включён);

	Результат = Новый Структура();
	Результат.Вставить("state", Показанное.Код);
	Результат.Вставить("reason", Показанное.Причина);
	Результат.Вставить("checked_at", Моменты.Строкой(Показанное.Проверено));

	Прошлая = Показанное.ПрошлаяНеудача;
	Если Прошлая.Есть Тогда
		Результат.Вставить("last_failure", Новый Структура("reason, at",
			Прошлая.Причина, Моменты.Строкой(Прошлая.Когда)));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Состояние только что заведённого источника — тем же путём, что и для списка.
Функция СостояниеОдного(Знач Апстрим)

	Один = Новый Массив();
	Один.Добавить(Апстрим);
	Возврат Вердикты.ПоИсточникам(Один)[0].Состояние;

КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ЗапросAPI") _Запрос,
	&Пластилин(Значение = "МаршрутAPI") _Маршрут,
	&Пластилин(Значение = "ДопускAPI") _Допуск,
	&Пластилин(Значение = "ДвериAPI") _Двери,
	&Пластилин(Значение = "ПрологПравкиAPI") _ПрологПравки,
	&Пластилин(Значение = "СтраницыAPI") _Страницы,
	&Пластилин(Значение = "СервисАпстримовПула") _Апстримы,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "СекретИсточника") _Секрет,
	&Пластилин(Значение = "СостояниеИсточников") _Вердикты,
	&Пластилин(Значение = "МоментISO") _Моменты = Неопределено)

	Ответы = _Ответы;
	Запрос = _Запрос;
	Маршрут = _Маршрут;
	Допуск = _Допуск;
	Двери = _Двери;
	ПрологПравки = _ПрологПравки;
	Страницы = _Страницы;
	Апстримы = _Апстримы;
	Числа = _Числа;
	HTTP = _HTTP;
	Секрет = _Секрет;
	Вердикты = _Вердикты;
	Моменты = ?(_Моменты = Неопределено, Новый МоментISO(), _Моменты);

КонецПроцедуры
