// Зеркало пула; в карточке зеркала — ещё и его происшествия.

&Сериализуемое("id")
&Заполнено
&Тип("Число")
Перем Ид;

&Сериализуемое("pool_id")
&Заполнено
&Тип("Число")
Перем ИдПула;

&Сериализуемое("upstream_url")
&Заполнено
&Тип("Строка")
Перем АдресИсточника;

&Сериализуемое("token_set")
&Заполнено
&Тип("Булево")
Перем ТокенЗадан;

&Сериализуемое("protocol")
&Заполнено
&Тип("Строка")
&ОдинИз("openhub", "legacy", "")
Перем Протокол;

&Сериализуемое("migrate")
&Заполнено
&Тип("Булево")
Перем Перенос;

&Сериализуемое("filter")
&Заполнено
&Тип("Строка")
Перем Фильтр;

&Сериализуемое("interval")
&Заполнено
&Тип("Число")
Перем Интервал;

&Сериализуемое("enabled")
&Заполнено
&Тип("Булево")
Перем Включено;

&Сериализуемое("status")
&Заполнено
&Тип("Строка")
Перем Статус;

&Сериализуемое("last_sync")
&Заполнено
&Тип("Строка")
Перем ПоследняяСинхронизация;

&Сериализуемое("queue_state")
&Заполнено
&Тип("Строка")
&ОдинИз("выключено", "идёт", "поставлено", "простаивает")
Перем СостояниеОчереди;

&Сериализуемое("run")
&Заполнено
&Тип("ПрогонЗеркалаJSON")
Перем Прогон;

&Сериализуемое("incidents")
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("ПроисшествиеЗеркалаJSON")
Перем Происшествия;

&Сериализуемое("incidents_readable")
&Тип("Булево")
Перем ПроисшествияПрочитаны;
