// Ответ 200 адреса апстримов: страница на чтение, итог снятия на удаление — одна схема на оба глагола.

&Сериализуемое("items")
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("АпстримJSON")
Перем Элементы;

&Сериализуемое("page")
&Тип("Число")
Перем Номер;

&Сериализуемое("pageSize")
&Тип("Число")
Перем Размер;

&Сериализуемое("total")
&Тип("Число")
Перем Всего;

&Сериализуемое("has_more")
&Тип("Булево")
Перем ЕстьЕщё;

&Сериализуемое("removed")
&Тип("Булево")
Перем Снят;
