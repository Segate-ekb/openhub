// README версии пакета в HTML и откуда он; README нет — source равен null.

&Сериализуемое("version")
&Заполнено
&Тип("Строка")
Перем Версия;

&Сериализуемое("has_readme")
&Заполнено
&Тип("Булево")
Перем ЕстьREADME;

&Сериализуемое("html")
&Заполнено
&Тип("Строка")
Перем HTML;

&Сериализуемое("source", Обязательное = Истина)
&Тип("ИсточникREADMEJSON")
Перем Источник;
