// Теги пакета в API: список, заведение и правка, состав ручного тега, предпросмотр правила
// и упразднённые адреса каналов и закрепления.

Перем Ответы;         // ОтветыAPI (основа)
Перем Запрос;         // ЗапросAPI (протоколAPI)
Перем Маршрут;        // МаршрутAPI (протоколAPI)
Перем Допуск;         // ДопускAPI (api)
Перем ГейтМутации;    // ГейтМутацииAPI (api)
Перем Двери;          // ДвериAPI (api)
Перем ПорогиПрав;     // ПорогиПравAPI (api)
Перем ПрологПравки;  // ПрологПравкиAPI (api)
Перем Страницы;       // СтраницыAPI (протоколAPI)
Перем Сборщик;        // СборщикКарточкиПакета (api) — форма тега
Перем СервисВерсий;   // СервисВерсий (реестр)
Перем СервисТегов;    // СервисТегов (реестр) — теги и предпросмотр правил
Перем Режимы;         // РежимТега (реестр)
Перем Типы;           // ТипПравилаТега (реестр)
Перем Стили;          // СтильТега (реестр) — стили плашки
Перем Значки;         // ЗначокТега (реестр) — значки плашки
Перем HTTP;           // МетодыHTTP (основа)

#Область ТочкиМаршрута

// Теги пакета.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию — весь список
//             до потолка выдачи).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/tags", Метод = "get")
&Группа("Теги", Описание = "Теги пакета: ручные и по правилу, их состав и оформление.")
&Операция(Сводка = "Теги пакета",
	Описание = "Теги пакета и версия, которую отдаёт каждый.")
&Возвращает(Код = 200, Описание = "Теги пакета")
&Возвращает(Код = 404, Описание = "`pool_not_found`, `package_not_found`")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
Процедура ТегиПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	page = "", pageSize = "", ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.НачатьЧтение(Ответ, ПараметрыЗапросаПорядковые, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	ПулИПакет = Двери.ВидимыйПакет(Ответ, Пул, Имя, Принципал);
	Если ПулИПакет = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// поле со списком у этой ручки — tags, а не items
	Ответы.JSON(Ответ, 200, Страницы.Перечень(Сборщик.ТегиJSON(ПулИПакет.Пакет),
		page, pageSize, "tags"));

КонецПроцедуры

// Заведение, правка и удаление тега.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  Тег - Строка - имя тега из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело с полями режима, правила и версии.
//  МетодЗапроса - Строка - метод запроса; допустимы PUT и DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/tags/{Тег}", Метод = "put, delete")
&Группа("Теги")
&Операция(Сводка = "Заведение и правка тега (PUT); удаление тега (DELETE)",
	Описание = "PUT — заводит или правит тег: ручной на версии `version` либо по правилу `rule`.
	|DELETE — удаляет тег. Нужно право изменения пакета.")
&Возвращает(Код = 200, Описание = "PUT: тег; DELETE: тег удалён")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 404, Описание = "`tag_not_found`, `pool_not_found`, `package_not_found`")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`invalid_*` — тег не принят; `tag_name_is_version` — имя совпало с версией")
Процедура ТегВерсии(Ответ, Пул, Имя, Тег, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "PUT") И НЕ HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		Маршрут.МетодНеРазрешён(Ответ, "PUT, DELETE");
		Возврат;
	КонецЕсли;

	Правка = ПрологПравки.ПравкаПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Правка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		// без Попытки: сбой хранилища — 500, а не отказ клиенту
		Удалён = СервисТегов.УдалитьТег(Правка.Пакет.Идентификатор, Тег, ЛогинАвтора(Правка));
		Если НЕ Удалён Тогда
			Ответы.Ошибка(Ответ, 404, "tag_not_found", СтрШаблон("Тег ""%1"" не найден", Тег));
			Возврат;
		КонецЕсли;
		Ответы.JSON(Ответ, 200, Новый Структура("deleted", Истина));
		Возврат;
	КонецЕсли;

	СохранитьТег(Ответ, Правка, Тег);

КонецПроцедуры

// Упразднённое закрепление тега: отвечает 410.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  Тег - Строка - имя тега из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  МетодЗапроса - Строка - метод запроса; ответ одинаков для любого.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/tags/{Тег}/pin", Метод = "delete")
&Группа("Теги")
&Операция(Сводка = "Закрепление тега",
	Описание = "Упразднено: отвечает 410 и тег не трогает.")
&Устарело("Замена — ручной тег: PUT /api/v1/pools/{Пул}/packages/{Имя}/tags/{Тег}")
&Возвращает(Код = 404, Описание = "`unknown_path` — лишние сегменты адреса")
&Возвращает(Код = 410, Описание = "`pin_removed` — пинов больше нет")
Процедура ЗакреплениеТега(Ответ, Пул, Имя, Тег, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Ответы.Ошибка(Ответ, 410, "pin_removed", СтрШаблон(
		"Режим «пин» упразднён, снимать нечего: ручной тег, стоящий на одной версии, и есть"
		+ " прежний пин — PUT /api/v1/pools/%1/packages/%2/tags/%3 с {""mode"":""ручной""}",
		Строка(Пул), Строка(Имя), Строка(Тег)));

КонецПроцедуры

// Состав ручного тега: добавление и снятие версии.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  Тег - Строка - имя тега из адреса.
//  Версия - Строка - строка версии из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  МетодЗапроса - Строка - метод запроса; допустимы PUT и DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/tags/{Тег}/versions/{Версия}", Метод = "put, delete")
&Группа("Теги")
&Операция(Сводка = "Добавление версии в ручной тег (PUT); снятие версии с тега (DELETE)",
	Описание = "PUT добавляет версию в ручной тег и заводит тег, если его нет; DELETE снимает
	|версию с тега. Нужно право изменения пакета.")
&Возвращает(Код = 200, Описание = "Тег после правки")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 404, Описание = "`version_not_found`, `tag_not_found`, `pool_not_found`, `package_not_found`")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`invalid_tag`, `tag_is_rule`, `tag_name_is_version`")
Процедура СоставТега(Ответ, Пул, Имя, Тег, Версия, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "PUT") И НЕ HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		Маршрут.МетодНеРазрешён(Ответ, "PUT, DELETE");
		Возврат;
	КонецЕсли;

	Правка = ПрологПравки.ПравкаПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Правка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПакетИдентификатор = Правка.Пакет.Идентификатор;

	// ожидаемые отказы — до мутации, каждый своим кодом; нераспознанное доходит до 500
	Если НЕ СервисТегов.ИмяДопустимо(Тег) Тогда
		Ответы.Ошибка(Ответ, 422, "invalid_tag", СтрШаблон(
			"Недопустимое имя тега ""%1"": латиница, цифры, дефис, подчёркивание и точка,"
			+ " не длиннее 64 символов", Тег));
		Возврат;
	КонецЕсли;

	Существующий = СервисТегов.НайтиТег(ПакетИдентификатор, Тег);

	Если Существующий <> Неопределено И Режимы.ЭтоПравило(Существующий.Режим) Тогда
		Ответы.Ошибка(Ответ, 422, "tag_is_rule", СтрШаблон(
			"Тег ""%1"" в режиме правила: его состав считается правилом, и ручная метка"
			+ " ни на что не влияет. Заведите отдельный тег либо переведите этот в ручной режим", Тег));
		Возврат;
	КонецЕсли;

	Если СервисВерсий.НайтиВерсию(ПакетИдентификатор, Версия) = Неопределено Тогда
		Ответы.Ошибка(Ответ, 404, "version_not_found", СтрШаблон(
			"Версия ""%1"" не найдена в пакете", Версия));
		Возврат;
	КонецЕсли;

	Если Существующий = Неопределено И НЕ HTTP.ЭтоМетод(МетодЗапроса, "PUT") Тогда
		Ответы.Ошибка(Ответ, 404, "tag_not_found", СтрШаблон(
			"Тег ""%1"" не найден — снимать метку не с чего", Тег));
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "PUT") Тогда
		// PUT заводит тег, которого ещё нет: имя не должно совпасть с номером версии
		Если ИмяДляНовогоТегаЗанято(Ответ, ПакетИдентификатор, Тег) Тогда
			Возврат;
		КонецЕсли;
		Запись = СервисТегов.ПометитьВерсию(ПакетИдентификатор, Тег, Версия, ЛогинАвтора(Правка));
	Иначе
		Запись = СервисТегов.СнятьМетку(ПакетИдентификатор, Тег, Версия, ЛогинАвтора(Правка));
	КонецЕсли;

	Ответы.JSON(Ответ, 200, Сборщик.ТегJSON(Запись));

КонецПроцедуры

// Предпросмотр правила тега без записи.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело с полями pool, package, rule и type.
//  МетодЗапроса - Строка - метод запроса; допустим только POST.
//
&ТочкаМаршрута("tags/preview", Метод = "post")
&Группа("Теги")
&Операция(Сводка = "Предпросмотр правила тега",
	Описание = "Показывает, какие версии пакета `package` из пула `pool` выберет правило `rule`,
	|ничего не записывая. Нужно право изменения пакета.")
&Возвращает(Код = 200, Описание = "Версия-кандидат и все совпадения")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 404, Описание = "`pool_not_found`, `package_not_found`")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`invalid_rule` — правило не принято")
Процедура ПредпросмотрПравилаТега(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса) Экспорт

	Если НЕ Маршрут.НачатьДействие(Ответ, Неопределено, МетодЗапроса, "POST") Тогда
		Возврат;
	КонецЕсли;

	// пул и пакет названы телом, а не адресом: гейт мутации спрашивается по ним
	Тело = Запрос.РазобратьТело(ТелоЗапроса, ЗаголовкиЗапроса);
	ИмяПула = Запрос.Поле(Тело, "pool", Запрос.Поле(Тело, "пул"));
	ИмяПакета = Запрос.Поле(Тело, "package", Запрос.Поле(Тело, "пакет"));
	Правило = Запрос.Поле(Тело, "rule", Запрос.Поле(Тело, "правило"));
	ТипПравила = Запрос.Поле(Тело, "type", Запрос.Поле(Тело, "тип", "semver"));

	Принципал = Допуск.ТребоватьПринципала(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Принципал = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ГейтМутации.ПроверитьМутацию(Ответ, Принципал, Тело, ЗаголовкиЗапроса, ИмяПула) Тогда
		Возврат;
	КонецЕсли;

	ПулИПакет = Двери.ПакетМутации(Ответ, ИмяПула, ИмяПакета, Принципал);
	Если ПулИПакет = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ПорогиПрав.ТребоватьИзменениеПакета(Ответ, Принципал.Пользователь, ПулИПакет.Пул, ПулИПакет.Пакет) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Предпросмотр = СервисТегов.ПредпросмотрПравила(ПулИПакет.Пакет.Идентификатор, ТипПравила, Правило);
	Исключение
		Ответы.Сбой(Ответ, 422, "invalid_rule", "Некорректное правило тега (тип/выражение)",
			ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Данные = Новый Структура();
	Данные.Вставить("version", Предпросмотр.Версия);
	Данные.Вставить("type", Предпросмотр.Тип);
	Данные.Вставить("rule", Предпросмотр.Выражение);
	Данные.Вставить("matches", Предпросмотр.Совпадения);
	// отозванные правило пометит, а резолв не отдаст — клиент видит разницу
	Данные.Вставить("yanked", Предпросмотр.Отозванные);
	Данные.Вставить("warning", Предпросмотр.Предупреждение);
	Ответы.JSON(Ответ, 200, Данные);

КонецПроцедуры

// Устаревший канал пакета: заводит тег того же имени.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  Канал - Строка - имя канала из адреса; станет именем тега.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело с видом паттерна и его значением.
//  МетодЗапроса - Строка - метод запроса; допустим только PUT.
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/channels/{Канал}", Метод = "put")
&Группа("Теги")
&Операция(Сводка = "Канал пакета",
	Описание = "Устарело: заводит тег того же имени и отвечает в прежней форме `{channel}`.")
&Устарело("Замена — PUT /api/v1/pools/{Пул}/packages/{Имя}/tags/{Тег}")
&Возвращает(Код = 200, Описание = "Канал в прежней форме")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 404, Описание = "`pool_not_found`, `package_not_found`")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`invalid_channel`, `tag_name_is_version`")
Процедура КаналПакета(Ответ, Пул, Имя, Канал, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса) Экспорт

	Если НЕ Маршрут.НачатьДействие(Ответ, Неопределено, МетодЗапроса, "PUT") Тогда
		Возврат;
	КонецЕсли;

	Правка = ПрологПравки.ПравкаПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Правка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Тело = Правка.Тело;
	ТипПаттерна = НРег(СокрЛП(Строка(Запрос.Поле(Тело, "тип", Запрос.Поле(Тело, "type", "semver")))));
	Паттерн = Запрос.Поле(Тело, "паттерн", Запрос.Поле(Тело, "pattern"));
	ВерсияПин = Запрос.Поле(Тело, "версия", Запрос.Поле(Тело, "version"));

	// «label упразднён» и «мусорный паттерн» — разные починки: первое распознаётся до мутации
	Если ТипПаттерна = "label" Тогда
		Ответы.Ошибка(Ответ, 422, "invalid_channel",
			"Тип паттерна «label» упразднён: правило тега отбирает версии по строке версии"
			+ " (semver или regex); метка версии осталась атрибутом версии");
		Возврат;
	КонецЕсли;

	Если ИмяДляНовогоТегаЗанято(Ответ, Правка.Пакет.Идентификатор, Канал) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если ТипПаттерна = "pin" Тогда
			Запись = СервисТегов.ПереместитьТег(
				Правка.Пакет.Идентификатор, Канал, ВерсияПин, ЛогинАвтора(Правка));
		Иначе
			Запись = СервисТегов.ОпределитьТегПравила(
				Правка.Пакет.Идентификатор, Канал, ТипПаттерна, Паттерн, ЛогинАвтора(Правка));
		КонецЕсли;
	Исключение
		// текст исключения несёт сам паттерн — наружу уходит фиксированный
		Ответы.Сбой(Ответ, 422, "invalid_channel",
			"Некорректное определение канала (тип/паттерн/версия)", ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	// прежняя форма ответа для старого клиента; type — присланный им вид
	Данные = Новый Структура();
	Данные.Вставить("name", Запись.Имя);
	Данные.Вставить("type", ТипПаттерна);
	Данные.Вставить("level", "package");
	Данные.Вставить("deprecated", "каналы упразднены: используйте PUT .../tags/{tag}");
	Ответы.JSON(Ответ, 200, Новый Структура("channel", Данные));

КонецПроцедуры

#КонецОбласти

#Область Действия

// Режим нормализует словарь: опечатка получает 422, а не молчаливое умолчание.
Процедура СохранитьТег(Ответ, Знач Правка, Знач Тег)

	Тело = Правка.Тело;
	ПакетИдентификатор = Правка.Пакет.Идентификатор;
	Правило = Запрос.Поле(Тело, "rule", Запрос.Поле(Тело, "правило"));
	СтрокаВерсии = Запрос.Поле(Тело, "version", Запрос.Поле(Тело, "версия"));
	СыройРежим = СокрЛП(Строка(Запрос.Поле(Тело, "mode", Запрос.Поле(Тело, "режим"))));

	Если НЕ ЗначениеЗаполнено(СыройРежим) Тогда
		СыройРежим = ?(ЗначениеЗаполнено(Правило), Режимы.Правило(), Режимы.Ручной());
	КонецЕсли;

	// причина называется поимённо, но без эха ввода
	Если УпразднённыйПин(СыройРежим) Тогда
		Ответы.Ошибка(Ответ, 422, "invalid_mode",
			"Режим тега «пин» упразднён: ручной тег, стоящий на одной версии, и есть прежний"
			+ " пин — используйте mode=ручной");
		Возврат;
	КонецЕсли;

	Попытка
		Режим = Режимы.Нормализовать(СыройРежим);
	Исключение
		Ответы.Сбой(Ответ, 422, "invalid_mode", СтрШаблон(
			"Неизвестный режим тега: допустимы %1", СтрСоединить(Режимы.Все(), ", ")),
			ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	ТипПравила = Запрос.Поле(Тело, "ruleType", Запрос.Поле(Тело, "тип_правила", Типы.Semver()));
	Если Режим = Режимы.Правило() И НРег(СокрЛП(Строка(ТипПравила))) = "label" Тогда
		Ответы.Ошибка(Ответ, 422, "invalid_tag",
			"Тип правила тега «label» упразднён: правило отбирает версии по строке версии"
			+ " (semver или regex); метка версии осталась атрибутом версии");
		Возврат;
	КонецЕсли;

	// незнакомый стиль или значок называется до мутации, а не «не применяется» молча
	Оформление = ОформлениеИзТела(Тело);
	Если Оформление <> Неопределено И НЕ Стили.Допустим(Оформление.Стиль) Тогда
		Ответы.Ошибка(Ответ, 422, "invalid_style", СтрШаблон(
			"Неизвестный стиль тега: допустимы %1", СтрСоединить(Стили.Все(), ", ")));
		Возврат;
	КонецЕсли;
	Если Оформление <> Неопределено И НЕ Значки.Допустим(Оформление.Значок) Тогда
		Ответы.Ошибка(Ответ, 422, "invalid_icon", СтрШаблон(
			"Неизвестный значок тега: допустимы %1 либо пусто", СтрСоединить(Значки.Все(), ", ")));
		Возврат;
	КонецЕсли;

	Если ИмяДляНовогоТегаЗанято(Ответ, ПакетИдентификатор, Тег) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если Режим = Режимы.Правило() Тогда
			Запись = СервисТегов.ОпределитьТегПравила(
				ПакетИдентификатор, Тег, ТипПравила, Правило, ЛогинАвтора(Правка), Оформление);
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаВерсии) Тогда
			// ручной тег без версии — пустой канал: версии в него набирают у самих версий
			Запись = СервисТегов.ОпределитьРучнойТег(
				ПакетИдентификатор, Тег, ЛогинАвтора(Правка), Оформление);
		Иначе
			Запись = СервисТегов.ПереместитьТег(
				ПакетИдентификатор, Тег, СтрокаВерсии, ЛогинАвтора(Правка), Оформление);
		КонецЕсли;
	Исключение
		// текст домена несёт пользовательский ввод — наружу уходит фиксированный
		Ответы.Сбой(Ответ, 422, "invalid_tag", "Некорректный тег (имя, режим, правило или версия)",
			ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Запрос.Поле(Тело, "default", Запрос.Поле(Тело, "по_умолчанию"))) Тогда
		СервисТегов.НазначитьПоУмолчанию(ПакетИдентификатор, Запись.Имя);
	КонецЕсли;

	ПрименитьРазрешениеПерезаписи(Правка, Запись);

	Ответы.JSON(Ответ, 200, Сборщик.ТегJSON(Запись));

КонецПроцедуры

// Поле называет РАЗРЕШЕНИЕ, домен — ЗАПРЕТ; не присланное поле запрет не трогает, невнятное
// значение читается как «разрешения нет».
Процедура ПрименитьРазрешениеПерезаписи(Знач Правка, Знач Запись)

	Присланное = ПрисланноеСтрокой(Правка.Тело, "overwrite_allowed,перезапись_разрешена");
	Если Присланное = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СервисТегов.УстановитьЗапретПерезаписи(Правка.Пакет.Идентификатор, Запись.Имя,
		НЕ Запрос.ВБулево(Присланное), ЛогинАвтора(Правка));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отказ распознаётся до мутации: иначе клиент не узнает, чем именно имя занято.
Функция ИмяДляНовогоТегаЗанято(Ответ, Знач ПакетИдентификатор, Знач Тег)

	Если НЕ СервисТегов.ИмяДляНовогоТегаЗанято(ПакетИдентификатор, Тег) Тогда
		Возврат Ложь;
	КонецЕсли;

	Ответы.Ошибка(Ответ, 422, "tag_name_is_version", СтрШаблон(
		"Имя тега ""%1"" занято версией пакета: спецификацию ""пакет@%1"" резолв читает"
		+ " сначала точной версией, и тег с таким именем остался бы недостижим."
		+ " Назовите тег иначе", Тег));
	Возврат Истина;

КонецФункции

// Ни одного поля в теле — Неопределено: тег, у которого меняют правило, оформления не теряет.
Функция ОформлениеИзТела(Знач Тело)

	Стиль = ПрисланноеСтрокой(Тело, "style,стиль");
	Значок = ПрисланноеСтрокой(Тело, "icon,значок");

	Если Стиль = Неопределено И Значок = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Стиль, Значок",
		?(Стиль = Неопределено, "", Стиль), ?(Значок = Неопределено, "", Значок));

КонецФункции

Функция ПрисланноеСтрокой(Знач Тело, Знач Имена)
	Значение = Запрос.Присланное(Тело, Имена);
	Возврат ?(Значение = Неопределено, Неопределено, Строка(Значение));
КонецФункции

Функция УпразднённыйПин(Знач СыройРежим)
	Норм = НРег(СокрЛП(Строка(СыройРежим)));
	Возврат Норм = "пин" ИЛИ Норм = "pin";
КонецФункции

// Кто правит тег — для летописи тегов.
Функция ЛогинАвтора(Знач Правка)
	Возврат ?(Правка.Пользователь = Неопределено, "", Строка(Правка.Пользователь.Логин));
КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ЗапросAPI") _Запрос,
	&Пластилин(Значение = "МаршрутAPI") _Маршрут,
	&Пластилин(Значение = "ДопускAPI") _Допуск,
	&Пластилин(Значение = "ГейтМутацииAPI") _ГейтМутации,
	&Пластилин(Значение = "ДвериAPI") _Двери,
	&Пластилин(Значение = "ПорогиПравAPI") _ПорогиПрав,
	&Пластилин(Значение = "ПрологПравкиAPI") _ПрологПравки,
	&Пластилин(Значение = "СтраницыAPI") _Страницы,
	&Пластилин(Значение = "СборщикКарточкиПакета") _Сборщик,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "РежимТега") _Режимы,
	&Пластилин(Значение = "ТипПравилаТега") _Типы,
	&Пластилин(Значение = "СтильТега") _Стили,
	&Пластилин(Значение = "ЗначокТега") _Значки,
	&Пластилин(Значение = "МетодыHTTP") _HTTP)

	Ответы = _Ответы;
	Запрос = _Запрос;
	Маршрут = _Маршрут;
	Допуск = _Допуск;
	ГейтМутации = _ГейтМутации;
	Двери = _Двери;
	ПорогиПрав = _ПорогиПрав;
	ПрологПравки = _ПрологПравки;
	Страницы = _Страницы;
	Сборщик = _Сборщик;
	СервисВерсий = _СервисВерсий;
	СервисТегов = _СервисТегов;
	Режимы = _Режимы;
	Типы = _Типы;
	Стили = _Стили;
	Значки = _Значки;
	HTTP = _HTTP;

КонецПроцедуры
