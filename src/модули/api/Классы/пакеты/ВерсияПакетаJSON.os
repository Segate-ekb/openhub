// Версия пакета: файл, разбор номера, метки и скачивания.

&Сериализуемое("version")
&Заполнено
&Тип("Строка")
Перем Версия;

&Сериализуемое("sha256")
&Заполнено
&Тип("Строка")
Перем SHA256;

&Сериализуемое("size")
&Заполнено
&Тип("Число")
Перем Размер;

&Сериализуемое("yanked")
&Заполнено
&Тип("Булево")
Перем Отозвана;

&Сериализуемое("published")
&Заполнено
&Тип("Строка")
Перем Опубликована;

&Сериализуемое("semver")
&Заполнено
&Тип("НомерВерсииJSON")
Перем Номер;

&Сериализуемое("manifest_version")
&Заполнено
&Тип("Строка")
Перем ВерсияМанифеста;

&Сериализуемое("labels")
&Заполнено
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("Строка")
Перем Метки;

&Сериализуемое("trusted_workflow")
&Заполнено
&Тип("Булево")
Перем ДоверенныйКонвейер;

&Сериализуемое("downloads")
&Заполнено
&Тип("Число")
Перем Скачивания;
