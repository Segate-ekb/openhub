// Ответ 200 адреса версий: страница версий на чтение, итог перезаписи на публикацию — одна схема на оба глагола.

&Сериализуемое("versions")
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("ВерсияПакетаJSON")
Перем Версии;

&Сериализуемое("page")
&Тип("Число")
Перем Номер;

&Сериализуемое("pageSize")
&Тип("Число")
Перем Размер;

&Сериализуемое("total")
&Тип("Число")
Перем Всего;

&Сериализуемое("has_more")
&Тип("Булево")
Перем ЕстьЕщё;

&Сериализуемое("status")
&Тип("Строка")
&ОдинИз("published")
Перем Состояние;

&Сериализуемое("message")
&Тип("Строка")
Перем Сообщение;
