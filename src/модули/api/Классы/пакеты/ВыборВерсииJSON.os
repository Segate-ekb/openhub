// Версия, выбранная по спецификации, и адрес её файла.

&Сериализуемое("version")
&Заполнено
&Тип("Строка")
Перем Версия;

&Сериализуемое("url")
&Заполнено
&Тип("Строка")
Перем Адрес;

&Сериализуемое("sha256")
&Заполнено
&Тип("Строка")
Перем SHA256;

&Сериализуемое("yanked")
&Заполнено
&Тип("Булево")
Перем Отозвана;

// Минимальная версия OneScript из манифеста выбранной версии; пустая — манифест её не назвал.
&Сериализуемое("engine_version")
&Заполнено
&Тип("Строка")
Перем ВерсияДвижка;

&Сериализуемое("all_sources_polled")
&Заполнено
&Тип("Булево")
Перем ВсеИсточникиОпрошены;
