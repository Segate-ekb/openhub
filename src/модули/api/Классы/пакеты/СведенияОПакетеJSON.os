// Карточка пакета: сведения, теги и мейнтейнеры.

&Сериализуемое("id")
&Заполнено
&Тип("Число")
Перем Ид;

&Сериализуемое("name")
&Заполнено
&Тип("Строка")
Перем Имя;

&Сериализуемое("pool")
&Заполнено
&Тип("Строка")
Перем Пул;

&Сериализуемое("description")
&Заполнено
&Тип("Строка")
Перем Описание;

&Сериализуемое("keywords")
&Заполнено
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("Строка")
Перем КлючевыеСлова;

&Сериализуемое("license")
&Заполнено
&Тип("Строка")
Перем Лицензия;

&Сериализуемое("repository")
&Заполнено
&Тип("Строка")
Перем Репозиторий;

&Сериализуемое("deprecated")
&Заполнено
&Тип("Булево")
Перем Устарел;

&Сериализуемое("downloads")
&Заполнено
&Тип("Число")
Перем Скачивания;

&Сериализуемое("versions_total")
&Заполнено
&Тип("Число")
Перем ВсегоВерсий;

&Сериализуемое("latest_version")
&Заполнено
&Тип("Строка")
Перем ПоследняяВерсия;

&Сериализуемое("tags")
&Заполнено
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("ТегПакетаJSON")
Перем Теги;

&Сериализуемое("maintainers")
&Заполнено
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("МейнтейнерПакетаJSON")
Перем Мейнтейнеры;
