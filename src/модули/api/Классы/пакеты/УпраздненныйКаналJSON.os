// Тег, заведённый упразднённым адресом канала.

// BSLLS:MissingVariablesDescription-off
&Сериализуемое("name")
&Заполнено
&Тип("Строка")
Перем Имя;

&Сериализуемое("type")
&Заполнено
&Тип("Строка")
Перем Тип;

&Сериализуемое("level")
&Заполнено
&Тип("Строка")
&ОдинИз("package")
Перем Уровень;

&Сериализуемое("deprecated")
&Заполнено
&Тип("Строка")
Перем Упразднено;
// BSLLS:MissingVariablesDescription-on
