// Тег пакета: свой либо унаследованный от пула, с версией, которую он отдаёт.

&Сериализуемое("name")
&Заполнено
&Тип("Строка")
Перем Имя;

&Сериализуемое("mode")
&Заполнено
&Тип("Строка")
&ОдинИз("ручной", "правило")
Перем Режим;

&Сериализуемое("origin")
&Заполнено
&Тип("Строка")
&ОдинИз("свой", "перекрывает", "пул", "выключен", "")
Перем Происхождение;

&Сериализуемое("rule")
&Заполнено
&Тип("Строка")
Перем Правило;

&Сериализуемое("rule_type")
&Заполнено
&Тип("Строка")
&ОдинИз("semver", "regex", "")
Перем ТипПравила;

&Сериализуемое("version")
&Заполнено
&Тип("Строка")
Перем Версия;

&Сериализуемое("versions")
&Заполнено
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("Строка")
Перем Версии;

&Сериализуемое("default")
&Заполнено
&Тип("Булево")
Перем ПоУмолчанию;

&Сериализуемое("overwrite_allowed")
&Заполнено
&Тип("Булево")
Перем ПерезаписьРазрешена;

&Сериализуемое("warning")
&Заполнено
&Тип("Строка")
Перем Предупреждение;

&Сериализуемое("style")
&Заполнено
&Тип("Строка")
&ОдинИз("plain", "stable", "prerelease", "deprecated", "special", "")
Перем Стиль;

&Сериализуемое("icon")
&Заполнено
&Тип("Строка")
&ОдинИз("", "check", "verified", "warning", "stop", "lock", "history", "cube", "key")
Перем Значок;
