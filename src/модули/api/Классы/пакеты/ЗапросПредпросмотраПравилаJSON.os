// Тело предпросмотра правила тега на версиях пакета.

&Сериализуемое("pool")
&Заполнено
&Тип("Строка")
Перем Пул;

&Сериализуемое("package")
&Заполнено
&Тип("Строка")
Перем Пакет;

&Сериализуемое("rule")
&Заполнено
&Тип("Строка")
Перем Правило;

&Сериализуемое("type")
&Тип("Строка")
&ОдинИз("semver", "regex")
Перем Тип;
