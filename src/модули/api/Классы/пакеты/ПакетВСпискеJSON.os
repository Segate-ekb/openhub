// Пакет в списке пула и в выдаче поиска.

&Сериализуемое("name")
&Заполнено
&Тип("Строка")
Перем Имя;

&Сериализуемое("pool")
&Заполнено
&Тип("Строка")
Перем Пул;

&Сериализуемое("description")
&Заполнено
&Тип("Строка")
Перем Описание;

&Сериализуемое("deprecated")
&Заполнено
&Тип("Булево")
Перем Устарел;
