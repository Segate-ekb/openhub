// Версии пакета в API: список, публикация, отзыв и метка версии. Публикация целиком
// делегирована СервисПубликации.

#Использовать errors

Перем Ответы;           // ОтветыAPI (основа)
Перем Запрос;           // ЗапросAPI (протоколAPI)
Перем Маршрут;          // МаршрутAPI (протоколAPI)
Перем Допуск;           // ДопускAPI (api)
Перем ГейтМутации;      // ГейтМутацииAPI (api)
Перем Двери;            // ДвериAPI (api)
Перем ПрологПравки;    // ПрологПравкиAPI (api)
Перем Страницы;         // СтраницыAPI (протоколAPI)
Перем Сборщик;          // СборщикКарточкиПакета (api) — форма версий
Перем СервисПубликации; // СервисПубликации (публикация)
Перем СервисВерсий;     // СервисВерсий (реестр)
Перем СервисМеток;      // СервисМетокВерсий (реестр) — метки версий
Перем HTTP;             // МетодыHTTP (основа)
Перем Числа;            // ПриведениеЧисел (основа) — длина тела из Content-Length
&Лог
Перем Лог;

#Область ТочкиМаршрута

// Список версий пакета и публикация версии.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и POST.
//  ТелоЗапросаПоток - Поток - тело .ospx при публикации; в память целиком не читается.
//  force - Строка - параметр адреса «?force=1»: заменить уже опубликованный номер
//          целиком (необязательный, по умолчанию "" — обычная публикация).
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию — весь список
//             до потолка выдачи).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/versions", Метод = "get, post")
&Группа("Версии", Описание = "Версии пакета: список, отзыв и метка.")
&Группа("Публикация")
&Операция(Сводка = "Версии пакета (GET); публикация версии (POST)",
	Описание = "GET — версии пакета. POST — публикует `.ospx` из тела, `FILE-NAME` — `<имя>-<версия>.ospx`
	|по манифесту; ответ в конверте API. Вход — ключ доступа или id-token конвейера.")
&Возвращает(Код = 200, Тип = "ВерсииИлиПубликацияJSON",
	Описание = "GET: версии пакета; POST: номер переиздан")
&Возвращает(Код = 201, Тип = "ИтогПубликацииJSON", Описание = "POST: версия опубликована")
&Возвращает(Код = 202, Тип = "ИтогПубликацииJSON", Описание = "POST: заявка во «входящих», версии ещё нет")
&Возвращает(Код = 400, Тип = "ОтказJSON", Описание = "`bad_request` — файл, его имя или манифест не приняты")
&Возвращает(Код = 401, Тип = "ОтказJSON", Описание = "`unauthorized` — нет ключа и id-token")
&Возвращает(Код = 403, Тип = "ОтказJSON", Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 404, Тип = "ОтказJSON", Описание = "`pool_not_found`, `package_not_found`")
&Возвращает(Код = 405, Тип = "ОтказJSON", Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 409, Тип = "ОтказJSON",
	Описание = "`conflict` — номер занят, имя заявлено либо пул закрыт для публикаций")
&Возвращает(Код = 413, Тип = "ОтказJSON", Описание = "`payload_too_large` — артефакт больше предела")
&Возвращает(Код = 429, Тип = "ОтказJSON", Описание = "`rate_limited` — предел незакрытых заявок")
&Возвращает(Код = 500, Тип = "ОтказJSON", Описание = "`publish_failed`, `publish_error` — сбой публикации")
&Возвращает(Код = 507, Тип = "ОтказJSON", Описание = "`quota_exceeded` — квота пула исчерпана")
Процедура Версии(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	ТелоЗапросаПоток, force = "", page = "", pageSize = "") Экспорт

	Маршрут.СнятьКуку(Ответ);

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		СписокВерсий(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, page, pageSize);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Опубликовать(Ответ, Пул, ЗаголовкиЗапроса, ТелоЗапросаПоток,
			СервисПубликации.ЭтоФорс(force));
	Иначе
		Маршрут.МетодНеРазрешён(Ответ, "GET, POST");
	КонецЕсли;

КонецПроцедуры

// Отзыв, возврат и метка версии.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  Версия - Строка - строка версии из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело с полями yanked/отозвана и label/метка.
//  МетодЗапроса - Строка - метод запроса; допустим только PATCH.
//  ТелоЗапросаОбъект - Произвольный - тело, разобранное winow по схеме описания; точка его не читает.
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/versions/{Версия}", Метод = "patch")
&Группа("Версии")
&Операция(Сводка = "Правка версии: отзыв и метка",
	Описание = "`yanked` отзывает или возвращает версию, `label` присваивает ей метку. Нужно право
	|изменения пакета.")
&Возвращает(Код = 200, Тип = "КарточкаВерсииJSON", Описание = "Версия после правки")
&Возвращает(Код = 400, Тип = "ОтказJSON", Описание = "`no_changes` — нет ни `yanked`, ни `label`")
&Возвращает(Код = 401, Тип = "ОтказJSON", Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Тип = "ОтказJSON", Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 404, Тип = "ОтказJSON",
	Описание = "`version_not_found`, `pool_not_found`, `package_not_found`")
&Возвращает(Код = 405, Тип = "ОтказJSON", Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Тип = "ОтказJSON", Описание = "`invalid_label` — метка не принята")
Процедура ВерсияПатч(Ответ, Пул, Имя, Версия, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	&Тип("ЗапросПравкиВерсииJSON") ТелоЗапросаОбъект = Неопределено) Экспорт

	Если НЕ Маршрут.НачатьДействие(Ответ, Неопределено, МетодЗапроса, "PATCH") Тогда
		Возврат;
	КонецЕсли;

	Правка = ПрологПравки.ПравкаПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Правка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПакетИдентификатор = Правка.Пакет.Идентификатор;

	ЗаписьВерсии = СервисВерсий.НайтиВерсию(ПакетИдентификатор, Версия);
	Если ЗаписьВерсии = Неопределено Тогда
		Ответы.Ошибка(Ответ, 404, "version_not_found", СтрШаблон("Версия ""%1"" не найдена", Версия));
		Возврат;
	КонецЕсли;

	Тело = Правка.Тело;
	ЧтоТоСделано = Ложь;

	ЗначОтзыв = Запрос.Поле(Тело, "yanked", Запрос.Поле(Тело, "отозвана"));
	Если ЗначениеЗаполнено(ЗначОтзыв) Тогда
		// событие отзыва и возврата публикует сам сервис
		СервисВерсий.ОтозватьВерсию(ПакетИдентификатор, Версия, Запрос.ВБулево(ЗначОтзыв),
			?(Правка.Пользователь = Неопределено, "", Строка(Правка.Пользователь.Логин)));
		ЧтоТоСделано = Истина;
	КонецЕсли;

	Метка = Запрос.Поле(Тело, "label", Запрос.Поле(Тело, "метка"));
	Если ЗначениеЗаполнено(Метка) Тогда
		Попытка
			СервисМеток.ПрисвоитьМетку(ЗаписьВерсии.Идентификатор, Метка);
			ЧтоТоСделано = Истина;
		Исключение
			Ответы.Сбой(Ответ, 422, "invalid_label", "Некорректная метка версии",
				ИнформацияОбОшибке());
			Возврат;
		КонецПопытки;
	КонецЕсли;

	Если НЕ ЧтоТоСделано Тогда
		Ответы.Ошибка(Ответ, 400, "no_changes", "Не указано ни yanked, ни label");
		Возврат;
	КонецЕсли;

	// перечитанная версия несёт статус после правки
	Обновлённая = СервисВерсий.НайтиВерсию(ПакетИдентификатор, Версия);
	Ответы.JSON(Ответ, 200, Новый Структура("version", Сборщик.ВерсияJSON(Обновлённая)));

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура СписокВерсий(Ответ, Знач Пул, Знач Имя, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач page, Знач pageSize)

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	ПулИПакет = Двери.ВидимыйПакет(Ответ, Пул, Имя, Принципал);
	Если ПулИПакет = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// поле со списком у этой ручки — versions, а не items
	Ответы.JSON(Ответ, 200, Страницы.Перечень(Сборщик.ВерсииJSON(ПулИПакет.Пакет),
		page, pageSize, "versions"));

КонецПроцедуры

// Гейт мутации зовётся для любого способа входа, не только для сессии; тело бинарное,
// поэтому CSRF-токен ждут только в заголовке.
Процедура Опубликовать(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач Тело, Знач Форсировать)

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, Неопределено);

	ТелоФормы = Запрос.РазобратьТело("", ЗаголовкиЗапроса);
	Если НЕ ГейтМутации.ПроверитьМутацию(Ответ, Принципал, ТелоФормы, ЗаголовкиЗапроса, ИмяПула) Тогда
		Возврат;
	КонецЕсли;

	ИмяФайла = Запрос.Заголовок(ЗаголовкиЗапроса, "FILE-NAME");
	Канал = Запрос.Заголовок(ЗаголовкиЗапроса, "CHANNEL");
	ЗаявленныйРазмер = Числа.ЦелоеИлиНеопределено(Запрос.Заголовок(ЗаголовкиЗапроса, "Content-Length"));
	Токен = Допуск.ТокенЗапроса(ЗаголовкиЗапроса);

	Попытка
		Результат = СервисПубликации.Опубликовать(
			ИмяПула, Тело, ?(ИмяФайла = Неопределено, "", Строка(ИмяФайла)),
			?(Канал = Неопределено, "", Строка(Канал)), Принципал.Пользователь, Токен, Принципал,
			Форсировать, ЗаявленныйРазмер);
	Исключение
		// наружу — только машинный код чужой ошибки: ни цепочки причин, ни стека
		Ответы.Сбой(Ответ, 500, "publish_failed", "Внутренняя ошибка публикации",
			ИнформацияОбОшибке(), КодЧужойОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	// веха здесь — только отказ: принятое называет служба публикации, заявку во «входящие» — сами входящие
	Если НЕ Результат.Успех Тогда
		Лог.Информация("Публикация в пул ""%1"" отклонена: файл ""%2"", код %3 — %4",
			ИмяПула, ?(ИмяФайла = Неопределено, "", ИмяФайла), Результат.Код, Результат.Сообщение);
	КонецЕсли;
	ОтдатьРезультатПубликации(Ответ, Результат);

КонецПроцедуры

// Статус называет то, что произошло: 202 — заявка во «входящие», версии ещё нет.
Процедура ОтдатьРезультатПубликации(Ответ, Знач Результат)

	Если Результат.Код >= 200 И Результат.Код < 300 Тогда
		Данные = Новый Структура();
		Данные.Вставить("status", ?(Результат.Код = 202, "queued", "published"));
		Данные.Вставить("message", Результат.Сообщение);
		Ответы.JSON(Ответ, Результат.Код, Данные);
		Возврат;
	КонецЕсли;

	Ответы.Ошибка(Ответ, Результат.Код, КодОшибкиПубликации(Результат.Код), Результат.Сообщение,
		ПодробностиВердикта(Результат));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Машинный код структурированной ошибки библиотеки полем `error.details.error_code`;
// у обычного исключения кода нет, и поля details в ответе не будет.
Функция КодЧужойОшибки(Знач ИнфОбОшибке)

	Код = ДиагностикаОшибок.КодОшибки(ИнфОбОшибке);
	Если Код = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("error_code", Строка(Код));

КонецФункции

// Поля `error.details` кладёт в вердикт тот, кто отказал; без подробностей поля нет вовсе.
Функция ПодробностиВердикта(Знач Результат)
	Подробности = Неопределено;
	Результат.Свойство("Подробности", Подробности);
	Возврат Подробности;
КонецФункции

Функция КодОшибкиПубликации(Знач Код)
	Если Код = 401 Тогда Возврат "unauthorized"; КонецЕсли;
	Если Код = 403 Тогда Возврат "forbidden"; КонецЕсли;
	Если Код = 404 Тогда Возврат "pool_not_found"; КонецЕсли;
	Если Код = 409 Тогда Возврат "conflict"; КонецЕсли;      // иммутабельность release
	Если Код = 413 Тогда Возврат "payload_too_large"; КонецЕсли;
	Если Код = 422 Тогда Возврат "unprocessable"; КонецЕсли; // артефакт понят, но отвергнут политикой (подпись)
	Если Код = 429 Тогда Возврат "rate_limited"; КонецЕсли;  // предел незакрытых заявок пула или автора
	Если Код = 507 Тогда Возврат "quota_exceeded"; КонецЕсли; // квота пула исчерпана
	Если Код = 400 Тогда Возврат "bad_request"; КонецЕсли;
	Возврат "publish_error";
КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ЗапросAPI") _Запрос,
	&Пластилин(Значение = "МаршрутAPI") _Маршрут,
	&Пластилин(Значение = "ДопускAPI") _Допуск,
	&Пластилин(Значение = "ГейтМутацииAPI") _ГейтМутации,
	&Пластилин(Значение = "ДвериAPI") _Двери,
	&Пластилин(Значение = "ПрологПравкиAPI") _ПрологПравки,
	&Пластилин(Значение = "СтраницыAPI") _Страницы,
	&Пластилин(Значение = "СборщикКарточкиПакета") _Сборщик,
	&Пластилин(Значение = "СервисПубликации") _СервисПубликации,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисМетокВерсий") _СервисМеток,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа)

	Ответы = _Ответы;
	Запрос = _Запрос;
	Маршрут = _Маршрут;
	Допуск = _Допуск;
	ГейтМутации = _ГейтМутации;
	Двери = _Двери;
	ПрологПравки = _ПрологПравки;
	Страницы = _Страницы;
	Сборщик = _Сборщик;
	СервисПубликации = _СервисПубликации;
	Числа = _Числа;
	СервисВерсий = _СервисВерсий;
	СервисМеток = _СервисМеток;
	HTTP = _HTTP;

КонецПроцедуры
