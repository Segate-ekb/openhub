// Пакет, его версии и теги в JSON — одна форма на карточку, /versions, /tags и срез
// изменений.

Перем СервисВерсий;          // СервисВерсий (реестр)
Перем РезолверСпецификации;  // РезолверСпецификации (реестр)
Перем СервисМеток;           // СервисМетокВерсий (реестр)
Перем СервисТегов;           // СервисТегов (реестр)
Перем Статистика;            // СлужбаСтатистикиСкачиваний (статистика)
Перем ПраваДоступа;          // СервисПравДоступа (права)
Перем Права;                 // СервисПрав (права)
Перем Пользователи;          // СервисПользователей (вход)
Перем Провенанс;             // СервисПроисхождения (реестр)
Перем Моменты;               // МоментISO (основа) — одно написание времени в ответе
Перем НомерСборки;           // НомерСборкиВерсии (реестр) — что манифест добавляет к координате

#Область ПубличныйИнтерфейс

// Полная карточка пакета. README в неё не входит — он отдаётся отдельным эндпоинтом.
//
// Параметры:
//  Пул - Пул - пул пакета.
//  Пакет - Пакет - сущность пакета.
//
// Возвращаемое значение:
//  Структура - карточка пакета для JSON-ответа.
//
Функция Карточка(Знач Пул, Знач Пакет) Экспорт

	Рез = Новый Структура();
	Рез.Вставить("id", Пакет.Идентификатор);
	Рез.Вставить("name", Пакет.Имя);
	Рез.Вставить("pool", Пул.Имя);
	Рез.Вставить("description", ?(ЗначениеЗаполнено(Пакет.Описание), Строка(Пакет.Описание), ""));
	Рез.Вставить("keywords", РазобратьКлючевыеСлова(Пакет.КлючевыеСлова));
	Рез.Вставить("license", ?(ЗначениеЗаполнено(Пакет.Лицензия), Строка(Пакет.Лицензия), ""));
	Рез.Вставить("repository", ?(ЗначениеЗаполнено(Пакет.АдресРепозитория), Строка(Пакет.АдресРепозитория), ""));
	Рез.Вставить("deprecated", Пакет.Устарел = Истина);

	Рез.Вставить("downloads", СкачиванийПакета(Пакет.Идентификатор));

	ВсеВерсии = СервисВерсий.ВерсииПакетаДляЧтения(Пакет.Идентификатор);
	Рез.Вставить("versions_total", ВсеВерсии.Количество());

	// latest_version — версия, которую ставит установка без тега и версии
	ПоУмолчанию = РезолверСпецификации.ВерсияПоУмолчанию(Пакет);
	Рез.Вставить("latest_version", ?(ПоУмолчанию = Неопределено, "", Строка(ПоУмолчанию.Версия)));

	Рез.Вставить("tags", ТегиJSON(Пакет));
	Рез.Вставить("maintainers", MaintainersJSON(Пакет));

	Возврат Рез;

КонецФункции

// Все версии пакета, включая отозванные: статус виден в самой версии, скачивания — тоже.
//
// Параметры:
//  Пакет - Пакет - сущность пакета.
//
// Возвращаемое значение:
//  Массив - структуры версий для JSON-ответа.
//
Функция ВерсииJSON(Знач Пакет) Экспорт

	// не «Версии»: это глобальное имя библиотеки semver
	СписокВерсий = СервисВерсий.ВерсииПакетаДляЧтения(Пакет.Идентификатор);

	// метки, провенанс и скачивания — тремя разрезами на весь список, а не вопросом на версию
	Метки = СервисМеток.МеткиСписка(НомераВерсий(СписокВерсий));
	Доверенные = Провенанс.ДоверенныеВерсииПакета(Пакет.Идентификатор);
	Скачивания = СкачиванияВерсийПакета(Пакет.Идентификатор);

	Массив = Новый Массив();
	Для Каждого Версия Из СписокВерсий Цикл
		Массив.Добавить(ВерсияJSON(Версия, Метки.Получить(Цел(Версия.Идентификатор)),
			Доверенные.Получить(Версия.Идентификатор) = Истина, Скачивания));
	КонецЦикла;
	Возврат Массив;

КонецФункции

// Одна версия: semver-метаданные, sha256, размер, статус отзыва, метки и скачивания.
//
// Параметры:
//  Версия - ВерсияПакета - сущность версии.
//  Метки - Массив из Строка, Неопределено - метки версии, если вызывающий уже прочитал их
//          на весь список (необязательный, по умолчанию Неопределено — прочитать здесь).
//  ДоверенныйКонвейер - Булево, Неопределено - признак доверенной публикации, если
//                       вызывающий уже прочитал его на весь список (необязательный,
//                       по умолчанию Неопределено — прочитать здесь).
//  СкачиванияВерсий - Соответствие, Неопределено - скачивания версий, если вызывающий уже
//                     прочитал их на весь список: идентификатор версии -> количество
//                     (необязательный, по умолчанию Неопределено — прочитать здесь).
//
// Возвращаемое значение:
//  Структура - версия для JSON-ответа.
//
Функция ВерсияJSON(Знач Версия, Знач Метки = Неопределено,
	Знач ДоверенныйКонвейер = Неопределено, Знач СкачиванияВерсий = Неопределено) Экспорт

	Семвер = Новый Структура();
	Семвер.Вставить("major", Версия.SemverМажор);
	Семвер.Вставить("minor", Версия.SemverМинор);
	Семвер.Вставить("patch", Версия.SemverПатч);
	Семвер.Вставить("prerelease", ?(ЗначениеЗаполнено(Версия.SemverПререлиз), Строка(Версия.SemverПререлиз), ""));
	Семвер.Вставить("build", ?(ЗначениеЗаполнено(Версия.SemverСборка), Строка(Версия.SemverСборка), ""));

	Структура = Новый Структура();
	Структура.Вставить("version", Версия.Версия);
	Структура.Вставить("sha256", ?(ЗначениеЗаполнено(Версия.Sha256), Строка(Версия.Sha256), ""));
	Структура.Вставить("size", ?(ЗначениеЗаполнено(Версия.Размер), Версия.Размер, 0));
	Структура.Вставить("yanked", Версия.Отозвана = Истина);
	Структура.Вставить("published", Моменты.Строкой(Версия.Опубликована));
	Структура.Вставить("semver", Семвер);
	// номер из манифеста — когда он говорит что-то сверх координаты (слот SNAPSHOT)
	Структура.Вставить("manifest_version", НомерСборки.ИзМанифеста(Версия));
	Структура.Вставить("labels", ?(Метки = Неопределено,
		СервисМеток.МеткиВерсии(Версия.Идентификатор), Метки));
	Структура.Вставить("trusted_workflow", ?(ДоверенныйКонвейер = Неопределено,
		Провенанс.ЭтоДоверенныйКонвейер(Версия), ДоверенныйКонвейер = Истина));
	Структура.Вставить("downloads", ?(СкачиванияВерсий = Неопределено,
		СкачиванийВерсии(Версия.Идентификатор),
		Статистика.СкачиванийВерсииИзРазреза(СкачиванияВерсий, Версия.Идентификатор)));
	Возврат Структура;

КонецФункции

// Скачивания версий названных пакетов одним разрезом — для формы версии, которую строят
// порцией сразу по нескольким пакетам. Сбой статистики ответа не роняет: скачивания нулевые.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Соответствие - идентификатор версии -> количество скачиваний; версий без скачиваний
//                 в нём нет.
//
Функция СкачиванияВерсийПакетов(Знач ПакетИдентификаторы) Экспорт
	Попытка
		Возврат Статистика.СкачиванияВерсийПакетов(ПакетИдентификаторы);
	Исключение
		Возврат Новый Соответствие();
	КонецПопытки;
КонецФункции

// Теги пакета вместе с унаследованными от пула одним доменным вызовом, без вопроса на каждый тег.
//
// Параметры:
//  Пакет - Пакет - сущность пакета.
//
// Возвращаемое значение:
//  Массив - структуры тегов для JSON-ответа.
//
Функция ТегиJSON(Знач Пакет) Экспорт
	Возврат КаналыJSON(Пакет).Теги;
КонецФункции

// Теги пакета вместе с унаследованными от пула и имена выключенных у пакета тегов пула —
// одним доменным вызовом.
//
// Параметры:
//  Пакет - Пакет - сущность пакета.
//
// Возвращаемое значение:
//  Структура - Теги (Массив — структуры тегов для JSON-ответа), Выключенные (Массив из Строка).
//
Функция КаналыJSON(Знач Пакет) Экспорт

	Каналы = СервисТегов.КаналыПакета(Пакет.Идентификатор);

	Теги = Новый Массив();
	Для Каждого Канал Из Каналы.Каналы Цикл
		Теги.Добавить(КаналJSON(Канал.Тег, Канал.Отдаваемая, Канал.Состав,
			Каналы.Происхождение.Получить(Строка(Канал.Тег.Имя))));
	КонецЦикла;

	Выключенные = Новый Массив();
	Для Каждого Тег Из Каналы.Выключенные Цикл
		Выключенные.Добавить(Строка(Тег.Имя));
	КонецЦикла;

	Возврат Новый Структура("Теги, Выключенные", Теги, Выключенные);

КонецФункции

// Один тег — для ответов на мутацию тега, где сериализуется ровно он.
//
// Параметры:
//  Тег - Тег - сущность тега.
//
// Возвращаемое значение:
//  Структура - тег для JSON-ответа.
//
Функция ТегJSON(Знач Тег) Экспорт
	Возврат КаналJSON(Тег, СервисТегов.ВерсияТега(Тег), СервисТегов.ВерсииТега(Тег),
		СервисТегов.ПроисхождениеТега(Тег.ПакетИдентификатор, Тег.Имя));
КонецФункции

// Общая форма тега для карточки и ответа на мутацию, чтобы они не разъехались; происхождение —
// ключ ПроисхождениеТега, как режим — ключ РежимТега.
Функция КаналJSON(Знач Тег, Знач Отдаваемая, Знач СоставКанала, Знач Происхождение)

	Правило = СервисТегов.ПравилоИзТега(Тег);

	Состав = Новый Массив();
	Для Каждого ВерсияКанала Из СоставКанала Цикл
		Состав.Добавить(Строка(ВерсияКанала.Версия));
	КонецЦикла;

	Структура = Новый Структура();
	Структура.Вставить("name", Тег.Имя);
	Структура.Вставить("mode", Строка(Тег.Режим));
	Структура.Вставить("origin", Строка(?(Происхождение = Неопределено, "", Происхождение)));
	Структура.Вставить("rule", ?(Правило = Неопределено, "", Правило.Выражение));
	Структура.Вставить("rule_type", ?(Правило = Неопределено, "", Правило.Тип));
	Структура.Вставить("version", ?(Отдаваемая = Неопределено, "", Строка(Отдаваемая.Версия)));
	Структура.Вставить("versions", Состав);
	Структура.Вставить("default", Тег.ПоУмолчанию = Истина);
	// Ложь — номер под этим тегом повторно не опубликовать
	Структура.Вставить("overwrite_allowed", СервисТегов.ЗапретСнят(Тег));
	Структура.Вставить("warning", ?(Правило = Неопределено, "", Правило.Предупреждение()));
	// оформление — ключами: цвет живёт в теме клиента
	Структура.Вставить("style", Строка(?(Тег.Стиль = Неопределено, "", Тег.Стиль)));
	Структура.Вставить("icon", Строка(?(Тег.Значок = Неопределено, "", Тег.Значок)));
	Возврат Структура;

КонецФункции

#КонецОбласти

#Область СборкаЧастей

// Мейнтейнеры — права уровня пакета; в логины резолвятся только субъекты-пользователи.
Функция MaintainersJSON(Знач Пакет)

	Массив = Новый Массив();
	Объект = Права.ОбъектПакет(Пакет);
	Для Каждого Грант Из ПраваДоступа.ГрантыНаОбъект(Объект) Цикл
		Если НРег(СокрЛП(Строка(Грант.ТипСубъекта))) <> "пользователь" Тогда
			Продолжить;
		КонецЕсли;
		Пользователь = Пользователи.ПоИдентификатору(Грант.СубъектИдентификатор);
		Если Пользователь = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Запись = Новый Структура();
		Запись.Вставить("login", Пользователь.Логин);
		Запись.Вставить("actions", ДействияГранта(Грант));
		Массив.Добавить(Запись);
	КонецЦикла;
	Возврат Массив;

КонецФункции

Функция ДействияГранта(Знач Грант)
	Действия = Новый Массив();
	Если Грант.Создание = Истина Тогда Действия.Добавить("создание"); КонецЕсли;
	Если Грант.Изменение = Истина Тогда Действия.Добавить("изменение"); КонецЕсли;
	Если Грант.Удаление = Истина Тогда Действия.Добавить("удаление"); КонецЕсли;
	Если Грант.Чтение = Истина Тогда Действия.Добавить("чтение"); КонецЕсли;
	Возврат Действия;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазобратьКлючевыеСлова(Знач Текст)
	Результат = Новый Массив();
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Часть Из СтрРазделить(Строка(Текст), ",", Ложь) Цикл
		Обрезано = СокрЛП(Часть);
		Если ЗначениеЗаполнено(Обрезано) Тогда
			Результат.Добавить(Обрезано);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НомераВерсий(Знач Версии)

	Результат = Новый Массив();
	Для Каждого Версия Из Версии Цикл
		Результат.Добавить(Цел(Версия.Идентификатор));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

// Сбой статистики ответа не роняет: скачивания в нём нулевые.
#Область СкачиванияБезСбоя

Функция СкачиванийПакета(Знач ПакетИдентификатор)
	Попытка
		Возврат Статистика.СкачиванийПакета(ПакетИдентификатор);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция СкачиванияВерсийПакета(Знач ПакетИдентификатор)
	Попытка
		Возврат Статистика.СкачиванияВерсийПакета(ПакетИдентификатор);
	Исключение
		Возврат Новый Соответствие();
	КонецПопытки;
КонецФункции

Функция СкачиванийВерсии(Знач ВерсияИдентификатор)
	Попытка
		Возврат Статистика.СкачиванийВерсии(ВерсияИдентификатор);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "РезолверСпецификации") _РезолверСпецификации,
	&Пластилин(Значение = "СервисМетокВерсий") _СервисМеток,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "СлужбаСтатистикиСкачиваний") _Статистика,
	&Пластилин(Значение = "СервисПравДоступа") _ПраваДоступа,
	&Пластилин(Значение = "СервисПрав") _Права,
	&Пластилин(Значение = "СервисПользователей") _Пользователи,
	&Пластилин(Значение = "СервисПроисхождения") _Провенанс,
	&Пластилин(Значение = "МоментISO") _Моменты = Неопределено,
	&Пластилин(Значение = "НомерСборкиВерсии") _НомерСборки = Неопределено)

	СервисВерсий = _СервисВерсий;
	РезолверСпецификации = _РезолверСпецификации;
	СервисМеток = _СервисМеток;
	СервисТегов = _СервисТегов;
	Статистика = _Статистика;
	ПраваДоступа = _ПраваДоступа;
	Права = _Права;
	Пользователи = _Пользователи;
	Провенанс = _Провенанс;
	Моменты = ?(_Моменты = Неопределено, Новый МоментISO(), _Моменты);
	НомерСборки = ?(_НомерСборки = Неопределено, Новый НомерСборкиВерсии(), _НомерСборки);

КонецПроцедуры
