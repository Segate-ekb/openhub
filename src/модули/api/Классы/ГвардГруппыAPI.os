// Доступ к маршрутам группы в JSON API: те же правила, что у ГвардГруппы дома настроек —
// читают админ хаба и участники, правит только администратор хаба.

Перем Ответы;       // ОтветыAPI (основа)
Перем СервисГрупп;  // СервисГрупп (auth)
Перем Права;        // СервисПрав (auth)

// Группа маршрута с проверкой доступа субъекта. При отказе сам записывает ответ —
// вызывающий обязан выйти.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ИмяГруппы - Строка - имя группы из адреса.
//  Пользователь - Пользователь - субъект запроса; аноним сюда не доходит.
//  ТребуетсяПравка - Булево - Истина для мутаций: чтения мало (необязательный,
//                    по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура, Неопределено - Группа и МожетПравить либо Неопределено.
//
Функция Разрешить(Ответ, Знач ИмяГруппы, Знач Пользователь, Знач ТребуетсяПравка = Ложь) Экспорт

	Группа = СервисГрупп.НайтиГруппу(ИмяГруппы);
	Если Группа = Неопределено Тогда
		Ответы.Ошибка(Ответ, 404, "group_not_found", СтрШаблон("Группа ""%1"" не найдена", ИмяГруппы));
		Возврат Неопределено;
	КонецЕсли;

	МожетПравить = Права.ПользовательАдмин(Пользователь);
	Если НЕ МожетПравить И НЕ Участник(Группа, Пользователь) Тогда
		Ответы.Ошибка(Ответ, 403, "forbidden", "Группа видна её участникам и администратору хаба");
		Возврат Неопределено;
	КонецЕсли;

	Если ТребуетсяПравка И НЕ МожетПравить Тогда
		Ответы.Ошибка(Ответ, 403, "forbidden", "Состав и сопоставления группы правит администратор хаба");
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Группа, МожетПравить", Группа, МожетПравить);

КонецФункции

Функция Участник(Знач Группа, Знач Пользователь)

	Если Пользователь = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Членство Из СервисГрупп.ГруппыПользователя(Пользователь.Идентификатор) Цикл
		Если Членство.Идентификатор = Группа.Идентификатор Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп,
	&Пластилин(Значение = "СервисПрав") _Права)

	Ответы = _Ответы;
	СервисГрупп = _СервисГрупп;
	Права = _Права;

КонецПроцедуры
