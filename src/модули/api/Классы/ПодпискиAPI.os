// Действия над подписками объекта для API: список, карточка, создание, правка, удаление
// и справочник. Секрет подписи отдаётся ровно один раз, при создании.

Перем Помощник;      // ПомощникAPI (api)
Перем Сервис;        // СервисПодписок (подписки)
Перем Реестр;        // РеестрДействийПодписок (подписки)
Перем Представление; // ПредставлениеПодпискиAPI (api)
Перем Ошибки;        // ТекстОшибки (основа) — причина отказа без служебного хвоста
Перем Числа;         // ПриведениеЧисел (основа)

#Область ПубличныйИнтерфейс

// Список подписок объекта. 403, если пользователь не вправе ими распоряжаться.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//  Объект - Структура - описание объекта подписки.
//
Процедура Список(Ответ, Знач Пользователь, Знач Объект) Экспорт

	Если НЕ ТребоватьУправление(Ответ, Пользователь, Объект) Тогда
		Возврат;
	КонецЕсли;

	Элементы = Новый Массив();
	Для Каждого Запись Из Сервис.Список(Объект) Цикл
		Элементы.Добавить(Представление.Карточка(Запись));
	КонецЦикла;
	Помощник.JSON(Ответ, 200, Новый Структура("items, total", Элементы, Элементы.Количество()));

КонецПроцедуры

// Карточка одной подписки объекта. Чужая и несуществующая одинаково дают 404.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//  Объект - Структура - описание объекта подписки.
//  Ид - Строка, Число - идентификатор подписки из адреса.
//
Процедура Карточка(Ответ, Знач Пользователь, Знач Объект, Знач Ид) Экспорт

	Если НЕ ТребоватьУправление(Ответ, Пользователь, Объект) Тогда
		Возврат;
	КонецЕсли;
	Запись = НайтиПодписку(Ответ, Объект, Ид);
	Если Запись <> Неопределено Тогда
		Помощник.JSON(Ответ, 200, Новый Структура("subscription", Представление.Карточка(Запись)));
	КонецЕсли;

КонецПроцедуры

// Заводит подписку на объекте. Секрет подписи вебхука отдаётся здесь и больше нигде.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь - субъект запроса.
//  Объект - Структура - описание объекта подписки.
//  Тело - Соответствие - разобранное тело запроса.
//
Процедура Создать(Ответ, Знач Пользователь, Знач Объект, Знач Тело) Экспорт

	Тип = ТипИзТела(Тело);
	Хранение = Реестр.Хранение(Тип);
	Если Хранение = Неопределено Тогда
		Помощник.Ошибка(Ответ, 422, "invalid_subscription",
			СтрШаблон("Неизвестный тип действия подписки «%1»", Тип));
		Возврат;
	КонецЕсли;

	Попытка
		Запись = Сервис.СоздатьПодписку(Пользователь, Объект, Тип, ВводТипа(Тип, Тело),
			СобытияИзТела(Тело, ""), ПараметрыСобытий(Тело));
	Исключение
		ОтдатьОтказ(Ответ, Пользователь, Объект, ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Данные = Новый Структура("subscription, secret", Представление.Карточка(Запись), Строка(Запись.Секрет));
	Помощник.JSON(Ответ, 201, Данные);

КонецПроцедуры

// Правит подписку: поля её типа, набор событий и включённость. Поле, которого в теле нет,
// остаётся прежним; секрет подписи правкой не выдаётся и не меняется.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь - субъект запроса.
//  Объект - Структура - описание объекта подписки.
//  Ид - Строка, Число - идентификатор подписки из адреса.
//  Тело - Соответствие - разобранное тело запроса.
//
Процедура Правка(Ответ, Знач Пользователь, Знач Объект, Знач Ид, Знач Тело) Экспорт

	Если НЕ ТребоватьУправление(Ответ, Пользователь, Объект) Тогда
		Возврат;
	КонецЕсли;
	Запись = НайтиПодписку(Ответ, Объект, Ид);
	Если Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Тип = Сервис.ТипДействияПодписки(Запись);
	Если НЕ Сервис.МожноПравить(Запись) Тогда
		Помощник.Ошибка(Ответ, 422, "invalid_subscription",
			СтрШаблон("Подписки типа «%1» правкой не меняются", Тип));
		Возврат;
	КонецЕсли;

	Попытка
		Итог = Сервис.ОбновитьПодписку(Пользователь, Объект, Числа.ЧислоИлиНоль(Ид), Тип,
			ВводПравки(Тип, Тело, Запись), СобытияИзТела(Тело, Строка(Запись.ТипыСобытий)),
			Включено(Тело, Запись.Активен = Истина), ПараметрыСобытий(Тело));
	Исключение
		ОтдатьОтказ(Ответ, Пользователь, Объект, ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Если Итог = Неопределено Тогда
		НеНайдено(Ответ);
		Возврат;
	КонецЕсли;
	Помощник.JSON(Ответ, 200, Новый Структура("subscription", Представление.Карточка(Итог.Подписка)));

КонецПроцедуры

// Удаляет подписку объекта.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь - субъект запроса.
//  Объект - Структура - описание объекта подписки.
//  Ид - Строка, Число - идентификатор подписки из адреса.
//
Процедура Удаление(Ответ, Знач Пользователь, Знач Объект, Знач Ид) Экспорт

	Если НЕ ТребоватьУправление(Ответ, Пользователь, Объект) Тогда
		Возврат;
	КонецЕсли;
	Если НайтиПодписку(Ответ, Объект, Ид) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Удалено = Сервис.Удалить(Пользователь, Объект, Числа.ЧислоИлиНоль(Ид));
	Исключение
		ОтдатьОтказ(Ответ, Пользователь, Объект, ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Помощник.JSON(Ответ, 200, Новый Структура("deleted", Удалено));

КонецПроцедуры

// Справочник для конвейера: типы событий, доступные для подписки, и типы действий
// с именами полей их настроек. Секретные поля помечены, значений в справочнике нет.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//
Процедура Справочник(Ответ) Экспорт
	Помощник.JSON(Ответ, 200, Представление.Справочник());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Право распоряжаться подписками объекта — тот же предикат, что спрашивает кабинет.
Функция ТребоватьУправление(Ответ, Знач Пользователь, Знач Объект)

	Если Сервис.МожетУправлять(Пользователь, Объект) Тогда
		Возврат Истина;
	КонецЕсли;
	Помощник.Ошибка(Ответ, 403, "forbidden", "Недостаточно прав для управления подписками объекта");
	Возврат Ложь;

КонецФункции

Функция НайтиПодписку(Ответ, Знач Объект, Знач Ид)

	Искомый = Числа.ЧислоИлиНоль(Ид);
	Для Каждого Запись Из Сервис.Список(Объект) Цикл
		Если Цел(Запись.Идентификатор) = Искомый Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	НеНайдено(Ответ);
	Возврат Неопределено;

КонецФункции

Процедура НеНайдено(Ответ)
	Помощник.Ошибка(Ответ, 404, "subscription_not_found", "Подписка не найдена у этого объекта");
КонецПроцедуры

// Отказ домена: 403, если дело в правах, иначе 422 с причиной, как её называет экран.
Процедура ОтдатьОтказ(Ответ, Знач Пользователь, Знач Объект, Знач Причина)

	Если НЕ Сервис.МожетУправлять(Пользователь, Объект) Тогда
		Помощник.Ошибка(Ответ, 403, "forbidden", "Недостаточно прав для управления подписками объекта");
		Возврат;
	КонецЕсли;
	// та же выжимка причины, что показывает экран: пути модулей и номера строк наружу
	// не выходят, остаётся текст, написанный человеку
	Текст = Ошибки.Кратко(Причина);
	Помощник.Ошибка(Ответ, 422, "invalid_subscription",
		?(ЗначениеЗаполнено(Текст), Текст, "Подписка не принята: проверьте тип, адрес и события"));

КонецПроцедуры

Функция ТипИзТела(Знач Тело)
	Значение = Помощник.Поле(Тело, "тип", Помощник.Поле(Тело, "kind", "вебхук"));
	Возврат НРег(СокрЛП(Строка(Значение)));
КонецФункции

// Типы событий: строка через запятую либо массив. Поля в теле нет — остаётся прежний набор.
Функция СобытияИзТела(Знач Тело, Знач Прежние)

	Значение = Тело.Получить("события");
	Если Значение = Неопределено Тогда
		Значение = Тело.Получить("events");
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Возврат Прежние;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Элементы = Новый Массив();
		Для Каждого Элемент Из Значение Цикл
			Элементы.Добавить(СокрЛП(Строка(Элемент)));
		КонецЦикла;
		Возврат СтрСоединить(Элементы, ",");
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

// То же Соответствие с сырыми значениями, что собирает форма кабинета из полей рядом с флажками.
Функция ПараметрыСобытий(Знач Тело)

	Значение = Тело.Получить("параметры");
	Если Значение = Неопределено Тогда
		Значение = Тело.Получить("params");
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Соответствие();
	Для Каждого КлючЗначение Из Значение Цикл
		Результат.Вставить(НРег(СокрЛП(Строка(КлючЗначение.Ключ))), Строка(КлючЗначение.Значение));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Включено(Знач Тело, Знач Прежнее)
	Для Каждого Имя Из СтрРазделить("включено,включить,enabled", ",") Цикл
		Если Тело.Получить(Имя) <> Неопределено Тогда
			Возврат Помощник.ВБулево(Тело.Получить(Имя));
		КонецЕсли;
	КонецЦикла;
	Возврат Прежнее;
КонецФункции

// Ввод создания: значения полей типа по именам, которые публикует справочник.
Функция ВводТипа(Знач Тип, Знач Тело)

	Ввод = Новый Структура();
	Для Каждого Поле Из Представление.Поля(Тип) Цикл
		Присланное = Присланное(Тело, Поле.Имя);
		Ввод.Вставить(Поле.Имя, ?(Присланное = Неопределено, "", СокрЛП(Строка(Присланное))));
	КонецЦикла;
	Возврат Ввод;

КонецФункции

// Поля, которых в теле нет, берутся из записи; пустое секретное поле — «оставить как есть».
Функция ВводПравки(Знач Тип, Знач Тело, Знач Запись)

	Прежние = Сервис.ЗначенияПравки(Запись);
	Ввод = Новый Структура();
	Для Каждого Поле Из Представление.Поля(Тип) Цикл
		Присланное = Присланное(Тело, Поле.Имя);
		Если Присланное <> Неопределено Тогда
			Ввод.Вставить(Поле.Имя, СокрЛП(Строка(Присланное)));
		ИначеЕсли Представление.Секретное(Поле) Тогда
			Ввод.Вставить(Поле.Имя, "");
		Иначе
			Ввод.Вставить(Поле.Имя, Прежнее(Прежние, Поле.Имя));
		КонецЕсли;
		Если Представление.Секретное(Поле) Тогда
			Ввод.Вставить(Поле.Имя + "Свой", Истина); // правка секрет не выпускает и не стирает
		КонецЕсли;
	КонецЦикла;
	Возврат Ввод;

КонецФункции

// Имена полей типа читаются без учёта регистра: JSON пишет человек.
Функция Присланное(Знач Тело, Знач Имя)

	Значение = Тело.Получить(Имя);
	Если Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Искомое = НРег(СокрЛП(Строка(Имя)));
	Для Каждого КлючЗначение Из Тело Цикл
		Если НРег(СокрЛП(Строка(КлючЗначение.Ключ))) = Искомое Тогда
			Возврат КлючЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция Прежнее(Знач Значения, Знач Имя)
	Найденное = Неопределено;
	Если Значения.Свойство(Имя, Найденное) И Найденное <> Неопределено Тогда
		Возврат Строка(Найденное);
	КонецЕсли;
	Возврат "";
КонецФункции

#КонецОбласти

&Прозвище("ПодпискиAPI")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПомощникAPI") _Помощник,
	&Пластилин(Значение = "СервисПодписок") _Сервис,
	&Пластилин(Значение = "РеестрДействийПодписок") _Реестр,
	&Пластилин(Значение = "ПредставлениеПодпискиAPI") _Представление,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа)

	Помощник = _Помощник;
	Сервис = _Сервис;
	Реестр = _Реестр;
	Представление = _Представление;
	Ошибки = _Ошибки;
	Числа = _Числа;

КонецПроцедуры
