// Выбор версии пакета в пуле лесенкой пулового resolve и по всем пулам, в которые запрос
// пускает дверь чтения: побеждает старшая, при равных — основной пул, затем первый по имени.

Перем ДоступКПулу;          // ГвардДоступаКПулу (права) — круг пулов за дверью чтения
Перем СервисПакетов;        // СервисПакетов (реестр)
Перем СервисПулов;          // СервисПулов (реестр) — основной пул для спора равных
Перем РезолверСпецификации; // РезолверСпецификации (реестр)
Перем Набор;                // ОбъединённыйНаборВерсий (прокси) — свои версии и версии источников
Перем Апстримы;             // СервисАпстримовПула (реестр) — состав и порядок источников пула
Перем Сравнитель;           // СравнительВерсий (реестр)

#Область ПубличныйИнтерфейс

// Выбирает версию пакета пула по спецификации: лесенка реестра среди версий пула и версии его
// источников, которые лишь опрашиваются, но не привозятся.
//
// Параметры:
//  Пул - Пул - пул.
//  Пакет - Пакет - пакет этого пула.
//  Спецификация - Строка - точная версия, имя тега либо выражение версии; пустая — версия
//                 основного тега пакета.
//  ВерсияДвижка - Строка - версия OneScript установки; пустая — не названа (необязательный).
//
// Возвращаемое значение:
//  Структура - Найдена (Булево), Пул, Пакет, СтрокаВерсии (Строка),
//              Версия (ВерсияПакета, Неопределено — версия источника или ничего),
//              Апстрим (АпстримПула, Неопределено — победила версия пула),
//              ВсеИсточникиОпрошены (Булево), Разрешение (Структура — итог лесенки реестра,
//              по нему называют отказ: ТегНеизвестен, ВыражениеБитое, ОтсеяноДвижком).
//
Функция ВыбратьВПуле(Знач Пул, Знач Пакет, Знач Спецификация, Знач ВерсияДвижка = "") Экспорт

	Разрешение = РезолверСпецификации.Разрешить(Пакет, Спецификация,
		РезолверСпецификации.КругВыбораХаба(Пакет), ВерсияДвижка);
	Выбор = Набор.ВыбратьПоСпецификации(Пул, Апстримы.ДляОпроса(Пул), Пакет, Пакет.Имя,
		Спецификация, Разрешение.Версия, ВерсияДвижка);

	Итог = Новый Структура();
	Итог.Вставить("Найдена", Ложь);
	Итог.Вставить("Пул", Пул);
	Итог.Вставить("Пакет", Пакет);
	Итог.Вставить("СтрокаВерсии", "");
	Итог.Вставить("Версия", Неопределено);
	Итог.Вставить("Апстрим", Неопределено);
	Итог.Вставить("ВсеИсточникиОпрошены", Выбор.ВсеИсточникиОпрошены);
	Итог.Вставить("Разрешение", Разрешение);

	Если Выбор.Найдена И Выбор.Апстрим <> Неопределено Тогда
		Итог.Найдена = Истина;
		Итог.СтрокаВерсии = Выбор.СтрокаВерсии;
		Итог.Апстрим = Выбор.Апстрим;
	ИначеЕсли Разрешение.Найдена Тогда
		Итог.Найдена = Истина;
		Итог.Версия = Разрешение.Версия;
		Итог.СтрокаВерсии = Строка(Разрешение.Версия.Версия);
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Выбирает версию пакета по всем пулам, которые запросу позволено читать: та же дверь, что у
// названного пула, — ключ, привязанный к пулам, открывает только их.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса; Неопределено — аноним.
//  ИмяПакета - Строка - имя пакета.
//  Спецификация - Строка - как у ВыбратьВПуле.
//  ВерсияДвижка - Строка - как у ВыбратьВПуле (необязательный).
//
// Возвращаемое значение:
//  Структура - Найдена (Булево), Победитель (Структура ВыбратьВПуле, Неопределено),
//              Отказ (Структура ВыбратьВПуле, Неопределено — пакета нет ни в одном пуле круга;
//              иначе отказ пула, дальше всех продвинувшегося по лесенке),
//              ОпрошенныеПулы (Массив из Строка — имена пулов круга по порядку имён),
//              ВсеИсточникиОпрошены (Булево — по всем пулам, где пакет есть).
//
Функция Выбрать(Знач Принципал, Знач ИмяПакета, Знач Спецификация, Знач ВерсияДвижка = "") Экспорт

	Основной = НРег(СервисПулов.ИмяПулаПоУмолчанию());

	Итог = Новый Структура();
	Итог.Вставить("Найдена", Ложь);
	Итог.Вставить("Победитель", Неопределено);
	Итог.Вставить("Отказ", Неопределено);
	Итог.Вставить("ОпрошенныеПулы", Новый Массив());
	Итог.Вставить("ВсеИсточникиОпрошены", Истина);

	Для Каждого Пул Из Круг(Принципал) Цикл

		Итог.ОпрошенныеПулы.Добавить(Строка(Пул.Имя));

		Пакет = СервисПакетов.ПакетДляЧтения(Пул.Идентификатор, ИмяПакета);
		Если Пакет = Неопределено ИЛИ Пакет.Скрыт = Истина Тогда
			Продолжить;
		КонецЕсли;

		ВПуле = ВыбратьВПуле(Пул, Пакет, Спецификация, ВерсияДвижка);
		Итог.ВсеИсточникиОпрошены = Итог.ВсеИсточникиОпрошены И ВПуле.ВсеИсточникиОпрошены;

		Если НЕ ВПуле.Найдена Тогда
			Если Итог.Отказ = Неопределено
				ИЛИ ГлубинаОтказа(ВПуле.Разрешение) > ГлубинаОтказа(Итог.Отказ.Разрешение) Тогда
				Итог.Отказ = ВПуле;
			КонецЕсли;
		ИначеЕсли Итог.Победитель = Неопределено ИЛИ Лучше(ВПуле, Итог.Победитель, Основной) Тогда
			Итог.Победитель = ВПуле;
		КонецЕсли;

	КонецЦикла;

	Итог.Найдена = Итог.Победитель <> Неопределено;
	Возврат Итог;

КонецФункции

// Круг — пулы, открытые запросу одиночной дверью чтения, в порядке обхода: первый по имени — первым.
// Ключ чужой привязки не пускает и в публичный.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса; Неопределено — аноним.
//
// Возвращаемое значение:
//  Массив из Пул - пулы по возрастанию имени.
//
Функция Круг(Знач Принципал) Экспорт

	Пользователь = ?(Принципал = Неопределено, Неопределено, Принципал.Пользователь);
	Список = Новый СписокЗначений();
	Для Каждого Элемент Из ДоступКПулу.ЧитаемыеИзНабора(Пользователь, СервисПулов.ПулыДляЧтения(), Принципал) Цикл
		Список.Добавить(Элемент.Значение, НРег(Строка(Элемент.Значение.Имя)));
	КонецЦикла;
	Список.СортироватьПоПредставлению();

	Упорядоченные = Новый Массив();
	Для Каждого Элемент Из Список Цикл
		Упорядоченные.Добавить(Элемент.Значение);
	КонецЦикла;
	Возврат Упорядоченные;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строго старшая побеждает; равная — только если она из основного пула.
Функция Лучше(Знач Кандидат, Знач Текущий, Знач Основной)

	Порядок = ПорядокВерсий(Кандидат.СтрокаВерсии, Текущий.СтрокаВерсии);
	Если Порядок <> 0 Тогда
		Возврат Порядок > 0;
	КонецЕсли;
	Возврат ЗначениеЗаполнено(Основной) И НРег(Строка(Кандидат.Пул.Имя)) = Основной;

КонецФункции

// Неразбираемая строка младше любой разбираемой.
Функция ПорядокВерсий(Знач Первая, Знач Вторая)

	Разбор1 = Сравнитель.ПопытатьсяРазобрать(Первая);
	Разбор2 = Сравнитель.ПопытатьсяРазобрать(Вторая);
	Если Разбор1 = Неопределено И Разбор2 = Неопределено Тогда
		Возврат 0;
	ИначеЕсли Разбор1 = Неопределено Тогда
		Возврат -1;
	ИначеЕсли Разбор2 = Неопределено Тогда
		Возврат 1;
	КонецЕсли;
	Возврат Разбор1.Сравнить(Разбор2);

КонецФункции

// Чем дальше пул прошёл по лесенке, тем точнее его отказ объясняет пустой итог.
Функция ГлубинаОтказа(Знач Разрешение)

	Если Разрешение.ВыражениеБитое Тогда
		Возврат 4;
	ИначеЕсли Разрешение.ОтсеяноДвижком Тогда
		Возврат 3;
	ИначеЕсли НЕ Разрешение.ТегНеизвестен Тогда
		Возврат 2;
	КонецЕсли;
	Возврат 1;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардДоступаКПулу") _ДоступКПулу,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "РезолверСпецификации") _РезолверСпецификации,
	&Пластилин(Значение = "ОбъединённыйНаборВерсий") _Набор,
	&Пластилин(Значение = "СервисАпстримовПула") _Апстримы,
	&Пластилин(Значение = "СравнительВерсий") _Сравнитель)

	ДоступКПулу = _ДоступКПулу;
	СервисПакетов = _СервисПакетов;
	СервисПулов = _СервисПулов;
	РезолверСпецификации = _РезолверСпецификации;
	Набор = _Набор;
	Апстримы = _Апстримы;
	Сравнитель = _Сравнитель;

КонецПроцедуры
