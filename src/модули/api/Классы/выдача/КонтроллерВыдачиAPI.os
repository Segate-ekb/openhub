	spec = "") Экспорт
	ВыдатьФайл(Ответ, Пул, Канал, ИмяПакета, ИмяФайла, spec, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
КонецПроцедуры

#КонецОбласти

#Область ОбщаяЛогикаОтдачи

// Имена пакетов пула, по одному на строку. Для proxy и group имена собирает резолвер.
Процедура ВыдатьСписок(Ответ, Знач ИмяПула, Знач МетодЗапроса, Знач ЗаголовкиЗапроса,
	Знач КукиЗапроса = Неопределено)

	БезСессионнойКуки(Ответ);

	Если НЕ ПулЧитаем(ЗаголовкиЗапроса, КукиЗапроса, ИмяПула) Тогда
		ОтдатьНеНайдено(Ответ, СтрШаблон("пул ""%1"" не найден", ИмяПула));
		Возврат;
	КонецЕсли;

	СписокПула = РезолверВыдачи.ИменаПула(ИмяПула);
	Если СписокПула = Неопределено Тогда
		ОтдатьНеНайдено(Ответ, СтрШаблон("пул ""%1"" не найден", ИмяПула));
		Возврат;
	КонецЕсли;

	// устойчивый порядок — устойчивый ETag
	СписокИмен = Новый СписокЗначений();
	Для Каждого Имя Из СписокПула.Имена Цикл
		СписокИмен.Добавить(Имя);
	КонецЦикла;
	СписокИмен.СортироватьПоЗначению();

	ПоследнееИзменение = СписокПула.ПоследнееИзменение;

	Имена = Новый Массив();
	Для Каждого ЭлементСписка Из СписокИмен Цикл
		Имена.Добавить(ЭлементСписка.Значение);
	КонецЦикла;

	Тело = СтрСоединить(Имена, Символы.ПС);
	ETag = КавычкамиETag(Sha256Строки(Тело));

	Если Кэш.СовпадаетETag(ЗаголовкиЗапроса, ETag) Тогда
		ОтдатьНеИзменено(Ответ, ETag);
		Возврат;
	КонецЕсли;

	// пустой пул или пакеты без даты — момент ответа
	Если ПоследнееИзменение = Неопределено Тогда
		ПоследнееИзменение = ТекущаяУниверсальнаяДата();
	КонецЕсли;

	Ответ.УстановитьСостояниеОК();
	Ответ.Заголовки["Content-Type"] = "text/plain; charset=utf-8";
	Ответ.Заголовки["ETag"] = ETag;
	Ответ.Заголовки["Last-Modified"] = HTTPДата(ПоследнееИзменение);
	Ответ.Заголовки["Content-Length"] = Формат(РазмерТелаВБайтах(Тело), "ЧГ=0; ЧН=0");

	Если ЭтоHEAD(МетодЗапроса) Тогда
		Ответ.ТелоТекст = "";
	Иначе
		Ответ.ТелоТекст = Тело;
	КонецЕсли;

КонецПроцедуры

Процедура ВыдатьФайл(Ответ, Знач ИмяПула, Знач ИмяКанала, Знач ИмяПакета, Знач ИмяФайла,
	Знач Спецификация, Знач МетодЗапроса, Знач ЗаголовкиЗапроса, Знач КукиЗапроса = Неопределено)

	// гейт до резолва: закрытый пул отвечает так же, как несуществующий
	БезСессионнойКуки(Ответ);
	Лог.Отладка("Выдача HTTP: %1 пул ""%2"", пакет ""%3"", файл ""%4"", канал ""%5"", спецификация ""%6""",
		МетодЗапроса, ИмяПула, ИмяПакета, ИмяФайла, ИмяКанала, Спецификация);

	Если НЕ ПулЧитаем(ЗаголовкиЗапроса, КукиЗапроса, ИмяПула) Тогда
		Лог.Отладка("Выдача HTTP: пул ""%1"" запросившему не читаем — отвечаем как на несуществующий",
			ИмяПула);
		ОтдатьНеНайдено(Ответ, СтрШаблон("пул ""%1"" не найден", ИмяПула));
		Возврат;
	КонецЕсли;

	// канал — имя тега, его судит резолвер; на файл с версией канал не влияет
	Запрос = РезолверФайла.РазобратьЗапросФайла(ИмяПакета, ИмяФайла, Спецификация);
	Если Запрос = Неопределено Тогда
		Лог.Отладка("Выдача HTTP: имя файла ""%1"" не разбирается по пакету ""%2"" — 404 до резолва",
			ИмяФайла, ИмяПакета);
		ОтдатьНеНайдено(Ответ, СтрШаблон("имя файла ""%1"" не соответствует пакету ""%2""", ИмяФайла, ИмяПакета));
		Возврат;
	КонецЕсли;

	// до резолва в ответ ничего не записано: сбой становится кодом отказа, а не 500
	Попытка
		Разрешение = РезолверВыдачи.РазрешитьФайл(ИмяПула, ИмяКанала, ИмяПакета, Запрос);
	Исключение
		ОтветитьНаСбойВыдачи(Ответ, ИнформацияОбОшибке(), ИмяПула, ИмяПакета, ИмяФайла);
		Возврат;
	КонецПопытки;

	Если НЕ Разрешение.Найдено Тогда
		ОтдатьНеНайдено(Ответ, ПояснениеОтказа(ИмяПула, ИмяКанала, ИмяПакета, ИмяФайла, Запрос));
		Возврат;
	КонецЕсли;

	ВыдатьРазрешённыйФайл(Ответ, ИмяПула, ИмяПакета, ИмяФайла, Разрешение, МетодЗапроса, ЗаголовкиЗапроса);

КонецПроцедуры

// Поток открывается до заголовков: сбой чтения ещё успевает стать кодом отказа.
Процедура ВыдатьРазрешённыйФайл(Ответ, Знач ИмяПула, Знач ИмяПакета, Знач ИмяФайла, Знач Разрешение,
	Знач МетодЗапроса, Знач ЗаголовкиЗапроса)

	Версия = Разрешение.Версия;

	Если МеткаСовпала(Версия, ЗаголовкиЗапроса) Тогда
		ETag = КавычкамиETag(Версия.Sha256);
		Лог.Отладка("Выдача HTTP: ETag клиента совпал с %1 — 304, тело не отдаём", ETag);
		ПоставитьЗаголовкиВерсии(Ответ, ИмяПула, Разрешение);
		ОтдатьНеИзменено(Ответ, ETag);
		Возврат;
	КонецЕсли;

	Если ЭтоHEAD(МетодЗапроса) Тогда
		ПоставитьЗаголовкиАртефакта(Ответ, ИмяПула, Разрешение, Версия.Размер);
		// native-сервер пишет тело всегда — у HEAD оно пустое
		Ответ.ТелоТекст = "";
		Возврат;
	КонецЕсли;

	Попытка
		Тело = РезолверВыдачи.ПотокСодержимого(Разрешение);
	Исключение
		ОтветитьНаСбойЧтения(Ответ, ИнформацияОбОшибке(), ИмяПула, ИмяПакета, ИмяФайла);
		Возврат;
	КонецПопытки;

	ПоставитьЗаголовкиАртефакта(Ответ, ИмяПула, Разрешение, Тело.Размер());
	// скачивание считает только отданное тело; имя пула — из разрешения, а не в написании клиента
	ЗафиксироватьСкачивание(Версия, Разрешение.ИмяПула);
	Ответ.ТелоПоток = Тело;

КонецПроцедуры

// Отпечаток sha256 и директиву кэша несут все виды ответа: 200, HEAD и 304.
Процедура ПоставитьЗаголовкиВерсии(Ответ, Знач ИмяПула, Знач Разрешение)

	Если ЗначениеЗаполнено(Разрешение.Версия.Sha256) Тогда
		Ответ.Заголовки["X-Checksum-Sha256"] = НРег(Строка(Разрешение.Версия.Sha256));
	КонецЕсли;

	Ответ.Заголовки["Cache-Control"] = ДирективаКэшаАртефакта(ИмяПула, Разрешение.ВерсиюВыбралХаб);

КонецПроцедуры

// Размер называет вызывающий: у тела — его собственный, у HEAD — из записи версии.
Процедура ПоставитьЗаголовкиАртефакта(Ответ, Знач ИмяПула, Знач Разрешение, Знач РазмерБайт)

	Версия = Разрешение.Версия;
	ПоставитьЗаголовкиВерсии(Ответ, ИмяПула, Разрешение);

	Лог.Отладка("Выдача HTTP: отдаём ""%1"" из пула ""%2"", %3 байт, версию выбрал хаб: %4",
		Разрешение.ИмяАртефакта, ИмяПула, РазмерБайт, Разрешение.ВерсиюВыбралХаб);

	Ответ.УстановитьСостояниеОК();
	Ответ.Заголовки["Content-Type"] = "application/octet-stream";
	Ответ.Заголовки["Content-Length"] = Формат(РазмерБайт, "ЧГ=0; ЧН=0");
	Ответ.Заголовки["Content-Disposition"] = СтрШаблон("attachment; filename=""%1""", Разрешение.ИмяАртефакта);
	Если ЗначениеЗаполнено(Версия.Опубликована) Тогда
		Ответ.Заголовки["Last-Modified"] = HTTPДата(Версия.Опубликована);
	КонецЕсли;
	Если ЗначениеЗаполнено(Версия.Sha256) Тогда
		Ответ.Заголовки["ETag"] = КавычкамиETag(Версия.Sha256);
	КонецЕсли;

КонецПроцедуры

// Сбой счёта выдачу не роняет.
Процедура ЗафиксироватьСкачивание(Знач Версия, Знач ИмяПула)
	Попытка
		Данные = Новый Структура("ПакетИдентификатор, ВерсияИдентификатор, ИмяПула",
			Версия.ПакетИдентификатор, Версия.Идентификатор, ИмяПула);
		Издатель.Опубликовать(Издатель.ТипСкачиваниеЗафиксировано(), Данные);
	Исключение
		// счёт не критичен для выдачи
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сессионную куку winow уже положил — её место занимает пустая коллекция.
Процедура БезСессионнойКуки(Ответ)
	Ответ.Куки = ПустыеКуки;
КонецПроцедуры

// Безверсионный путь канала не называет — версию выбирает основной тег пакета.
Функция БезКанала()
	Возврат "";
КонецФункции

// Директива есть всегда: молчание отдало бы решение о свежести разделяемому кэшу.
Функция ДирективаКэшаАртефакта(Знач ИмяПула, Знач ВерсиюВыбралХаб)

	Если НЕ ПулПубличен(ИмяПула) Тогда
		Возврат Кэш.ПриватныйКэш();
	КонецЕсли;

	Возврат ?(ВерсиюВыбралХаб, Кэш.КэшИзменяемогоАдреса(), Кэш.НеизменяемыйКэш());

КонецФункции

// Пул уже прошёл гвард чтения: вопрос только о видимости.
Функция ПулПубличен(Знач ИмяПула)
	Возврат Права.ПулПубличный(СервисПулов.ПулДляЧтения(ИмяПула));
КонецФункции

// HTTP-date по RFC 7231 из времени UTC.
Функция HTTPДата(Знач ДатаUTC)
	Возврат Формат(ДатаUTC, "Л=en; ДФ='ддд, дд МММ гггг ЧЧ:мм:сс ''GMT'''");
КонецФункции

// По машинному коду отказа: «артефакта нет» — 404, «хранилище не отвечает» — 503, прочее — 502.
Процедура ОтветитьНаСбойВыдачи(Ответ, Знач Сбой, Знач ИмяПула, Знач ИмяПакета, Знач ИмяФайла)

	Лог.Ошибка("Сбой выдачи %1/%2 (файл %3): %4", ИмяПула, ИмяПакета, ИмяФайла,
		Ошибки.Причина(Сбой));
	// отчёт с цепочкой причин — только при включённой отладке
	Если Лог.Уровень() <= УровниЛога.Отладка Тогда
		Лог.Отладка("Сбой выдачи %1/%2 (файл %3) целиком:%4%5",
			ИмяПула, ИмяПакета, ИмяФайла, Символы.ПС, Ошибки.ПодробныйОтчёт(Сбой));
	КонецЕсли;

	Если ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.РесурсНеНайден()) Тогда
		ОтдатьАртефактОтсутствует(Ответ, ИмяПула, ИмяФайла);
		Возврат;
	КонецЕсли;

	Если ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.ЗависимостьНедоступна()) Тогда
		ОтдатьХранилищеНедоступно(Ответ, СтрШаблон("хранилище пула ""%1"" не отдало ресурс ""%2""",
			ИмяПула, ИмяФайла));
		Возврат;
	КонецЕсли;

	ОтдатьСбойИсточника(Ответ, СтрШаблон("ресурс ""%1"" в пуле ""%2"" временно недоступен",
		ИмяФайла, ИмяПула));

КонецПроцедуры

// Версия в реестре есть, а файла нет — 404, как при отказе резолва, и отладка в журнал.
Процедура ОтветитьНаСбойЧтения(Ответ, Знач Сбой, Знач ИмяПула, Знач ИмяПакета, Знач ИмяФайла)

	Если НЕ ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.РесурсНеНайден()) Тогда
		ОтветитьНаСбойВыдачи(Ответ, Сбой, ИмяПула, ИмяПакета, ИмяФайла);
		Возврат;
	КонецЕсли;

	Лог.Отладка("Выдача: %1 в реестре пула ""%2"" есть, а артефакта в хранилище нет", ИмяФайла, ИмяПула);
	ОтдатьАртефактОтсутствует(Ответ, ИмяПула, ИмяФайла);

КонецПроцедуры

Процедура ОтдатьАртефактОтсутствует(Ответ, Знач ИмяПула, Знач ИмяФайла)
	ОтдатьНеНайдено(Ответ, СтрШаблон("артефакт ""%1"" пула ""%2"" в хранилище отсутствует",
		ИмяФайла, ИмяПула));
КонецПроцедуры

// 502 — отказал источник по ту сторону хаба.
Процедура ОтдатьСбойИсточника(Ответ, Знач Пояснение)
	Ответ.УстановитьСостояние(502);
	Ответ.Заголовки["Content-Type"] = "text/plain; charset=utf-8";
	Ответ.ТелоТекст = "bad gateway: " + Пояснение;
КонецПроцедуры

// 503 — отказало своё хранилище; Retry-After называет, когда повторить.
Процедура ОтдатьХранилищеНедоступно(Ответ, Знач Пояснение)
	Ответ.УстановитьСостояние(503);
	Ответ.Заголовки["Content-Type"] = "text/plain; charset=utf-8";
	Ответ.Заголовки["Retry-After"] = Формат(ПаузаПередПовтором(), "ЧГ=0");
	Ответ.ТелоТекст = "service unavailable: " + Пояснение;
КонецПроцедуры

// Секунды до осмысленного повтора — порядка перезапуска бэкенда хранилища.
Функция ПаузаПередПовтором()
	Возврат 30;
КонецФункции

// Без гварда пул не читаем никому.
Функция ПулЧитаем(Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ИмяПула)

	Если ЧтениеПула = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЧтениеПула.Проверить(ЗаголовкиЗапроса, КукиЗапроса, ИмяПула).Разрешено;

КонецФункции

// Пустая строка означает «основной пул не назначен»: отказ уже записан в ответ.
Функция ИмяОсновногоПула(Ответ)

	ИмяПула = СервисПулов.ИмяПулаПоУмолчанию();
	Если ЗначениеЗаполнено(ИмяПула) Тогда
		Возврат ИмяПула;
	КонецЕсли;

	БезСессионнойКуки(Ответ);
	ОтдатьНеНайдено(Ответ,
		СервисПулов.ПричинаБезОсновногоПула("короткие адреса /download и /dev-channel"));
	Возврат "";

КонецФункции

// Сбой объяснения оставляет 404 с общим текстом.
Функция ПояснениеОтказа(Знач ИмяПула, Знач ИмяКанала, Знач ИмяПакета, Знач ИмяФайла, Знач Запрос)

	Попытка
		ПроКанал = РезолверВыдачи.ОбъяснитьОтказ(ИмяПула, ИмяКанала, ИмяПакета, Запрос);
	Исключение
		ПроКанал = "";
	КонецПопытки;

	Возврат ?(ЗначениеЗаполнено(ПроКанал), ПроКанал,
		СтрШаблон("ресурс ""%1"" в пуле ""%2"" не найден", ИмяФайла, ИмяПула));

КонецФункции

Процедура ОтдатьНеНайдено(Ответ, Знач Пояснение)
	Ответ.УстановитьСостояниеНеНайдено();
	Ответ.Заголовки["Content-Type"] = "text/plain; charset=utf-8";
	Ответ.ТелоТекст = "not found: " + Пояснение;
КонецПроцедуры

Процедура ОтдатьНеИзменено(Ответ, Знач ETag)
	Ответ.УстановитьСостояние(304);
	Ответ.Заголовки["ETag"] = ETag;
	Ответ.ТелоТекст = ""; // 304 не несёт тела
КонецПроцедуры

Функция ЭтоHEAD(Знач МетодЗапроса)
	Возврат ВРег(Строка(МетодЗапроса)) = "HEAD";
КонецФункции

Функция МеткаСовпала(Знач Версия, Знач ЗаголовкиЗапроса)
	Возврат ЗначениеЗаполнено(Версия.Sha256)
		И Кэш.СовпадаетETag(ЗаголовкиЗапроса, КавычкамиETag(Версия.Sha256));
КонецФункции

Функция КавычкамиETag(Знач Sha256)
	Возврат Кэш.Метка(НРег(Строка(Sha256)));
КонецФункции

Функция Sha256Строки(Знач Строка)
	Возврат Хеши.ОтСтроки(Строка);
КонецФункции

Функция РазмерТелаВБайтах(Знач Строка)
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Строка).Размер();
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РезолверВыдачи") _РезолверВыдачи,
	&Пластилин(Значение = "РезолверФайлаПакета") _РезолверФайла,
	&Пластилин(Значение = "Куки") _ПустыеКуки,
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "ГвардДоступаКПулу") _ЧтениеПула,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ЗаголовкиКэша") _Кэш,
	&Пластилин(Значение = "СервисПрав") _Права,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Пластилин(Значение = "Хеш") _Хеши = Неопределено)

	Кэш = _Кэш;
	Права = _Права;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Хеши = ?(_Хеши = Неопределено, Новый Хеш(), _Хеши);

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

	РезолверВыдачи = _РезолверВыдачи;
	РезолверФайла = _РезолверФайла;
	Издатель = _Издатель;
	ЧтениеПула = _ЧтениеПула;

	ПустыеКуки = _ПустыеКуки;

	СервисПулов = _СервисПулов;

КонецПроцедуры
