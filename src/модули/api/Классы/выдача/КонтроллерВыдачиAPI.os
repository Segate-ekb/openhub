// Выдача пакетов для opm: list.txt и .ospx по каноническим адресам и вечным коротким.
// Где взять артефакт, решает РезолверВыдачи; ответы без сессионной куки.

#Использовать errors

Перем РезолверВыдачи;   // РезолверВыдачи (прокси)
Перем РезолверФайла;    // РезолверФайлаПакета (api)
Перем СервисПулов;      // СервисПулов (реестр) — основной пул для коротких адресов
Перем ПустыеКуки;       // Куки (winow) — пустая коллекция вместо Set-Cookie
Перем Издатель;         // ИздательСобытий (события) — счёт скачиваний событием
Перем ЧтениеПула;       // ГвардДоступаКПулу (права)
Перем Кэш;              // ЗаголовкиКэша (основа) — что кэшу позволено с телом артефакта
Перем Права;            // СервисПрав (права) — признак публичности пула
Перем Ошибки;           // ТекстОшибки (основа) — сбой строкой журнала и фразой для человека
Перем Хеши;             // Хеш (основа) — метка ответа по его телу
&Лог
Перем Лог;

#Область ТочкиМаршрута

// Список пакетов пула для opm.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  МетодЗапроса - Строка - метод запроса; HEAD отдаёт заголовки без тела, прочие — как GET.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//
&ТочкаМаршрута("api/v1/pools/{Пул}/download/list.txt", Метод = "get, head")
&Группа("Выдача для opm", Описание = "Список пакетов и файлы `.ospx` для opm, ответы не JSON; версию задаёт
	|`?spec=` или имя файла `{ИмяПакета}-{spec}.ospx`.")
&Операция(Сводка = "Список пакетов пула",
	Описание = "Имена пакетов пула для opm, по одному на строку.")
&Возвращает(Код = 200, Тип = "Строка", ТипСодержимого = "text/plain",
	Описание = "Имена пакетов, по одному на строку")
&Возвращает(Код = 304, Описание = "Совпал `If-None-Match`")
&Возвращает(Код = 404, Тип = "Строка", ТипСодержимого = "text/plain",
	Описание = "`not found: …` — пула нет либо он закрыт для запроса")
Процедура СписокПула(Ответ, Пул, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса) Экспорт
	ВыдатьСписок(Ответ, Пул, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
КонецПроцедуры

// Артефакт пакета пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ИмяПакета - Строка - имя пакета из адреса.
//  ИмяФайла - Строка - имя файла .ospx.
//  МетодЗапроса - Строка - метод запроса; HEAD отдаёт заголовки без тела, прочие — как GET.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  spec - Строка - спецификация версии: точная версия, имя тега либо выражение версии
//         (необязательный, по умолчанию пустая строка).
//
&ТочкаМаршрута("api/v1/pools/{Пул}/download/{ИмяПакета}/{ИмяФайла}", Метод = "get, head")
&Группа("Выдача для opm")
&Операция(Сводка = "Артефакт пакета",
	Описание = "Без версии в имени файла отдаёт версию по умолчанию.")
&Возвращает(Код = 200, Тип = "ДвоичныеДанные", ТипСодержимого = "application/octet-stream",
	Описание = "Артефакт `.ospx`")
&Возвращает(Код = 304, Описание = "Совпал `If-None-Match`")
&Возвращает(Код = 502, Тип = "Строка", ТипСодержимого = "text/plain",
	Описание = "`bad gateway: …` — источник пула не отдал артефакт")
&Возвращает(Код = 503, Тип = "Строка", ТипСодержимого = "text/plain",
	Описание = "`service unavailable: …` — хранилище не отвечает")
&Возвращает(Код = 404, Тип = "Строка", ТипСодержимого = "text/plain",
	Описание = "`not found: …` — нет пула, пакета, версии или файла")
Процедура ФайлПула(Ответ, Пул, ИмяПакета, ИмяФайла, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса,
	spec = "") Экспорт
	ВыдатьФайл(Ответ, Пул, БезКанала(), ИмяПакета, ИмяФайла, spec, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
КонецПроцедуры

// Список пакетов пула по адресу тега.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Канал - Строка - имя канала из адреса; на список не влияет.
//  МетодЗапроса - Строка - метод запроса; HEAD отдаёт заголовки без тела, прочие — как GET.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//
&ТочкаМаршрута("api/v1/pools/{Пул}/channels/{Канал}/download/list.txt", Метод = "get, head")
&Группа("Выдача для opm")
&Операция(Сводка = "Список пакетов пула по адресу тега",
	Описание = "Список тот же, что у пула: тег на него не влияет.")
&Возвращает(Код = 200, Тип = "Строка", ТипСодержимого = "text/plain",
	Описание = "Имена пакетов, по одному на строку")
&Возвращает(Код = 304, Описание = "Совпал `If-None-Match`")
&Возвращает(Код = 404, Тип = "Строка", ТипСодержимого = "text/plain",
	Описание = "`not found: …` — пула нет либо он закрыт для запроса")
Процедура СписокКанала(Ответ, Пул, Канал, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса) Экспорт
	ВыдатьСписок(Ответ, Пул, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
КонецПроцедуры

// Артефакт пакета по адресу тега.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Канал - Строка - имя канала из адреса; влияет только на выбор последней версии.
//  ИмяПакета - Строка - имя пакета из адреса.
//  ИмяФайла - Строка - имя файла .ospx.
//  МетодЗапроса - Строка - метод запроса; HEAD отдаёт заголовки без тела, прочие — как GET.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  spec - Строка - спецификация версии: точная версия, имя тега либо выражение версии
//         (необязательный, по умолчанию пустая строка).
//
&ТочкаМаршрута("api/v1/pools/{Пул}/channels/{Канал}/download/{ИмяПакета}/{ИмяФайла}", Метод = "get, head")
&Группа("Выдача для opm")
&Операция(Сводка = "Артефакт пакета по адресу тега",
	Описание = "Без версии в имени файла отдаёт версию тега `{Канал}`, а нет такого тега — 404.")
&Возвращает(Код = 200, Тип = "ДвоичныеДанные", ТипСодержимого = "application/octet-stream",
	Описание = "Артефакт `.ospx`")
&Возвращает(Код = 304, Описание = "Совпал `If-None-Match`")
&Возвращает(Код = 502, Тип = "Строка", ТипСодержимого = "text/plain",
	Описание = "`bad gateway: …` — источник пула не отдал артефакт")
&Возвращает(Код = 503, Тип = "Строка", ТипСодержимого = "text/plain",
	Описание = "`service unavailable: …` — хранилище не отвечает")
&Возвращает(Код = 404, Тип = "Строка", ТипСодержимого = "text/plain",
	Описание = "`not found: …` — нет пула, пакета, версии или файла")
Процедура ФайлКанала(Ответ, Пул, Канал, ИмяПакета, ИмяФайла, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса,
	spec = "") Экспорт
	ВыдатьФайл(Ответ, Пул, Канал, ИмяПакета, ИмяФайла, spec, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
КонецПроцедуры

#КонецОбласти

#Область ВечныеАлиасы

// Адреса прописаны у пользователей в opm.cfg и не снимаются: та же выдача, что выше.

// Вечный алиас: список пакетов основного пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  МетодЗапроса - Строка - метод запроса; HEAD отдаёт заголовки без тела, прочие — как GET.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//
&ТочкаМаршрута("/download/list.txt")
Процедура АлиасСписокПоУмолчанию(Ответ, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса) Экспорт
	ИмяПула = ИмяОсновногоПула(Ответ);
	Если ЗначениеЗаполнено(ИмяПула) Тогда
		ВыдатьСписок(Ответ, ИмяПула, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
	КонецЕсли;
КонецПроцедуры

// Вечный алиас: артефакт пакета основного пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ИмяПакета - Строка - имя пакета из адреса.
//  ИмяФайла - Строка - имя файла .ospx.
//  МетодЗапроса - Строка - метод запроса; HEAD отдаёт заголовки без тела, прочие — как GET.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  spec - Строка - спецификация версии: точная версия, имя тега либо выражение версии
//         (необязательный, по умолчанию пустая строка).
//
&ТочкаМаршрута("download/{ИмяПакета}/{ИмяФайла}")
Процедура АлиасФайлПоУмолчанию(Ответ, ИмяПакета, ИмяФайла, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса,
	spec = "") Экспорт
	ИмяПула = ИмяОсновногоПула(Ответ);
	Если ЗначениеЗаполнено(ИмяПула) Тогда
		ВыдатьФайл(Ответ, ИмяПула, БезКанала(), ИмяПакета, ИмяФайла, spec, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
	КонецЕсли;
КонецПроцедуры

