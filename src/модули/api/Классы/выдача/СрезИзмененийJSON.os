// Срез изменений пула для зеркала: порция имён и их версии.

&Сериализуемое("pool")
&Заполнено
&Тип("Строка")
Перем Пул;

&Сериализуемое("since")
&Заполнено
&Тип("Строка")
Перем С;

&Сериализуемое("as_of")
&Заполнено
&Тип("Строка")
Перем НаМомент;

&Сериализуемое("names_total")
&Заполнено
&Тип("Число")
Перем ИмёнВсего;

&Сериализуемое("names_before")
&Заполнено
&Тип("Число")
Перем ИмёнДоКурсора;

&Сериализуемое("has_more")
&Заполнено
&Тип("Булево")
Перем ЕстьЕщё;

&Сериализуемое("next_cursor")
&Заполнено
&Тип("Строка")
Перем СледующийКурсор;

&Сериализуемое("changes")
&Заполнено
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("ИзменениеПакетаJSON")
Перем Изменения;
