// Разбор запроса артефакта: имя .ospx относительно имени пакета и спецификация версии
// из параметра запроса.

// Разбирает запрошенное имя файла артефакта относительно имени пакета.
//
// Параметры:
//  ИмяПакета - Строка - имя пакета в любом регистре.
//  ИмяФайла - Строка - запрошенное имя файла, последний сегмент URL.
//  Спецификация - Строка - спецификация версии из параметра запроса; пустая означает,
//                 что клиент её не назвал (необязательный, по умолчанию пустая строка).
//  ВерсияДвижка - Строка - версия OneScript установки клиента; пустая означает, что клиент
//                 её не назвал (необязательный, по умолчанию пустая строка).
//
// Возвращаемое значение:
//  Структура, Неопределено - БезСпецификации (Булево, спецификации нет вовсе),
//  Спецификация (Строка, пустая при БезСпецификации) и ВерсияДвижка (Строка);
//  Неопределено, если имя файла не относится к этому пакету.
//
Функция РазобратьЗапросФайла(Знач ИмяПакета, Знач ИмяФайла, Знач Спецификация = "",
	Знач ВерсияДвижка = "") Экспорт

	Если НЕ ЗначениеЗаполнено(ИмяПакета) ИЛИ НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Расширение = ".ospx";
	Если НЕ СтрЗаканчиваетсяНа(НРег(ИмяФайла), Расширение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	База = Лев(ИмяФайла, СтрДлина(ИмяФайла) - СтрДлина(Расширение));
	Названная = СокрЛП(Строка(Спецификация));
	Движок = СокрЛП(Строка(ВерсияДвижка));

	Если НРег(База) = НРег(ИмяПакета) Тогда
		// версионного слота нет: спецификацию мог назвать только параметр
		Возврат Запрос(ПустаяСтрока(Названная), Названная, Движок);
	КонецЕсли;

	Префикс = ИмяПакета + "-";
	Если СтрДлина(База) > СтрДлина(Префикс)
		И НРег(Лев(База, СтрДлина(Префикс))) = НРег(Префикс) Тогда

		ИзИмениФайла = Сред(База, СтрДлина(Префикс) + 1);
		Если ПустаяСтрока(ИзИмениФайла) Тогда
			Возврат Неопределено;
		КонецЕсли;

		// параметр главнее версионного слота имени
		Возврат Запрос(Ложь, ?(ПустаяСтрока(Названная), ИзИмениФайла, Названная), Движок);

	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция Запрос(Знач БезСпецификации, Знач Спецификация, Знач ВерсияДвижка)
	Возврат Новый Структура("БезСпецификации, Спецификация, ВерсияДвижка",
		БезСпецификации, Спецификация, ВерсияДвижка);
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
