// Срез изменений пула: что появилось или изменилось после названного момента. Отсюда
// зеркало чужого хаба берёт инкремент вместо перечисления всего каталога заново. Срез живёт
// рядом с каждой формой адреса выдачи: под /api/v1, рядом с pools/{пул}/download и в корне.

Перем Ответы;    // ОтветыAPI (основа)
Перем Маршрут;   // МаршрутAPI (api)
Перем Допуск;    // ДопускAPI (api)
Перем Двери;     // ДвериAPI (api)
Перем Страницы;  // СтраницыAPI (api)
Перем Сборщик;   // СборщикСрезаИзменений (api)
Перем СервисПулов; // СервисПулов (реестр) — основной пул хаба для короткого адреса
Перем Моменты;   // МоментISO (основа) — одно написание времени в ответе

#Область ТочкиМаршрута

// GET /api/v1/pools/{Пул}/changes — версии пула, изменившиеся не раньше момента since,
// порцией имён от курсора. Видимость пула — та же, что у чтений пакетов: недоступный пул
// неотличим от несуществующего.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  since - Строка - момент отсчёта в формате XML-даты; пустой отдаёт весь состав пула
//          (необязательный, по умолчанию пустая строка).
//  cursor - Строка - имя пакета, с которого продолжается порция (необязательный,
//           по умолчанию пустая строка).
//  limit - Строка - сколько имён пакетов отдать порцией (необязательный, по умолчанию 100).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("api/v1/pools/{Пул}/changes")
Процедура ИзмененияПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	since = "", cursor = "", limit = "", ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	ВыдатьСрез(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
		since, cursor, limit, ПараметрыЗапросаПорядковые);

КонецПроцедуры

#КонецОбласти

#Область СоседиВыдачи

// Срез спрашивает зеркало, и спрашивает его РЯДОМ С АДРЕСОМ ВЫДАЧИ, который ему назвали:
// адреса ниже — те же двери к тому же срезу, что и канонический адрес выше.

// GET /pools/{Пул}/changes — срез рядом с pools/{Пул}/download/list.txt.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  since - Строка - момент отсчёта в формате XML-даты; пустой отдаёт весь состав пула
//          (необязательный, по умолчанию пустая строка).
//  cursor - Строка - имя пакета, с которого продолжается порция (необязательный,
//           по умолчанию пустая строка).
//  limit - Строка - сколько имён пакетов отдать порцией (необязательный, по умолчанию 100).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/changes")
Процедура АлиасИзмененийПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	since = "", cursor = "", limit = "", ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	ВыдатьСрез(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
		since, cursor, limit, ПараметрыЗапросаПорядковые);

КонецПроцедуры

// GET /changes — срез основного пула хаба, рядом с /download/list.txt.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  since - Строка - момент отсчёта в формате XML-даты; пустой отдаёт весь состав пула
//          (необязательный, по умолчанию пустая строка).
//  cursor - Строка - имя пакета, с которого продолжается порция (необязательный,
//           по умолчанию пустая строка).
//  limit - Строка - сколько имён пакетов отдать порцией (необязательный, по умолчанию 100).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("/changes")
Процедура АлиасИзмененийПоУмолчанию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	since = "", cursor = "", limit = "", ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	ИмяПула = СервисПулов.ИмяПулаПоУмолчанию();
	Если НЕ ЗначениеЗаполнено(ИмяПула) Тогда
		Ответы.Ошибка(Ответ, 404, "default_pool_not_set",
			СервисПулов.ПричинаБезОсновногоПула("короткий адрес /changes"));
		Возврат;
	КонецЕсли;

	ВыдатьСрез(Ответ, ИмяПула, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
		since, cursor, limit, ПараметрыЗапросаПорядковые);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Один срез на все двери: разбор параметров и форма ответа живут здесь, у адресов — только
// способ назвать пул.
Процедура ВыдатьСрез(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач МетодЗапроса, Знач since, Знач cursor, Знач limit, Знач ПараметрыЗапросаПорядковые)

	Если НЕ Маршрут.НачатьЧтение(Ответ, ПараметрыЗапросаПорядковые, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	ПулЗаписи = Двери.ВидимыйПул(Ответ, ИмяПула, Принципал);
	Если ПулЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// непонятный момент — отказ, а не молчаливый полный срез: спросивший «что нового
	// с четверга» получил бы весь каталог и решил, что изменилось всё
	Момент = РазобратьМомент(since);
	Если Момент = Неопределено Тогда
		Ответы.Ошибка(Ответ, 400, "invalid_since",
			"Параметр since — момент в формате XML-даты, например 2026-08-13T10:00:00Z");
		Возврат;
	КонецЕсли;

	Срез = Сборщик.Срез(ПулЗаписи, Момент, Строка(cursor),
		Страницы.Размер(limit, 100, 500));

	Ответы.JSON(Ответ, 200, СрезВJSON(ПулЗаписи, Строка(since), Срез));

КонецПроцедуры

Функция СрезВJSON(Знач Пул, Знач ЗапрошенныйМомент, Знач Срез)

	Данные = Новый Структура();
	Данные.Вставить("pool", Строка(Пул.Имя));
	Данные.Вставить("since", СокрЛП(ЗапрошенныйМомент));
	// момент снятия: спросив срез с него, читатель получит всё, что изменилось дальше
	Данные.Вставить("as_of", Моменты.Строкой(Срез.Снят));
	Данные.Вставить("names_total", Срез.ИменВсего);
	Данные.Вставить("names_before", Срез.ИменДо);
	Данные.Вставить("has_more", Срез.ЕстьЕщё);
	Данные.Вставить("next_cursor", Срез.Курсор);
	Данные.Вставить("changes", ИзмененияВJSON(Срез.Изменения));
	Возврат Данные;

КонецФункции

Функция ИзмененияВJSON(Знач Изменения)

	Массив = Новый Массив();
	Для Каждого Изменение Из Изменения Цикл
		Запись = Новый Структура();
		Запись.Вставить("package", Изменение.ИмяПакета);
		Запись.Вставить("version", Изменение.Версия);
		Массив.Добавить(Запись);
	КонецЦикла;
	Возврат Массив;

КонецФункции

// Неопределено — прислана строка, которая моментом не является; пустая — полный срез.
Функция РазобратьМомент(Знач Значение)

	Текст = СокрЛП(Строка(Значение));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат '00010101000000';
	КонецЕсли;

	Попытка
		Возврат XMLЗначение(Тип("Дата"), Текст);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "МаршрутAPI") _Маршрут,
	&Пластилин(Значение = "ДопускAPI") _Допуск,
	&Пластилин(Значение = "ДвериAPI") _Двери,
	&Пластилин(Значение = "СтраницыAPI") _Страницы,
	&Пластилин(Значение = "СборщикСрезаИзменений") _Сборщик,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "МоментISO") _Моменты = Неопределено)

	Ответы = _Ответы;
	Маршрут = _Маршрут;
	Допуск = _Допуск;
	Двери = _Двери;
	Страницы = _Страницы;
	Сборщик = _Сборщик;
	СервисПулов = _СервисПулов;
	Моменты = ?(_Моменты = Неопределено, Новый МоментISO(), _Моменты);

КонецПроцедуры
