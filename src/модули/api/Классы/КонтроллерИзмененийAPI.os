// Срез изменений пула: что появилось или изменилось после названного момента. Отсюда
// зеркало чужого хаба берёт инкремент вместо перечисления всего каталога заново.
// Собственный маршрут, а не хвост пакетов: winow работает по first-match, и один
// маршрут не делится между контроллерами.

Перем Помощник;  // ПомощникAPI (api)
Перем Сборщик;   // СборщикСрезаИзменений (api)

#Область ТочкиМаршрута

// GET /api/v1/pools/{Пул}/changes — версии пула, изменившиеся не раньше момента since,
// порцией имён от курсора. Видимость пула — та же, что у чтений пакетов: недоступный пул
// неотличим от несуществующего.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  since - Строка - момент отсчёта в формате XML-даты; пустой отдаёт весь состав пула
//          (необязательный, по умолчанию пустая строка).
//  cursor - Строка - имя пакета, с которого продолжается порция (необязательный,
//           по умолчанию пустая строка).
//  limit - Строка - сколько имён пакетов отдать порцией (необязательный, по умолчанию 100).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/changes")
Процедура ИзмененияПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	since = "", cursor = "", limit = "", ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Помощник.НачатьЧтение(Ответ, ПараметрыЗапросаПорядковые, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Принц = Помощник.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	ПулЗаписи = Помощник.ВидимыйПул(Ответ, Пул, Принц);
	Если ПулЗаписи = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// непонятный момент — отказ, а не молчаливый полный срез: спросивший «что нового
	// с четверга» получил бы весь каталог и решил, что изменилось всё
	Момент = РазобратьМомент(since);
	Если Момент = Неопределено Тогда
		Помощник.Ошибка(Ответ, 400, "invalid_since",
			"Параметр since — момент в формате XML-даты, например 2026-08-13T10:00:00Z");
		Возврат;
	КонецЕсли;

	Срез = Сборщик.Срез(ПулЗаписи, Момент, Строка(cursor),
		Помощник.РазмерСтраницы(limit, 100, 500));

	Помощник.JSON(Ответ, 200, СрезВJSON(ПулЗаписи, Строка(since), Срез));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СрезВJSON(Знач Пул, Знач ЗапрошенныйМомент, Знач Срез)

	Данные = Новый Структура();
	Данные.Вставить("pool", Строка(Пул.Имя));
	Данные.Вставить("since", СокрЛП(ЗапрошенныйМомент));
	// момент снятия: спросив срез с него, читатель получит всё, что изменилось дальше
	Данные.Вставить("as_of", XMLСтрока(Срез.Снят));
	Данные.Вставить("names_total", Срез.ИменВсего);
	Данные.Вставить("names_before", Срез.ИменДо);
	Данные.Вставить("has_more", Срез.ЕстьЕщё);
	Данные.Вставить("next_cursor", Срез.Курсор);
	Данные.Вставить("changes", ИзмененияВJSON(Срез.Изменения));
	Возврат Данные;

КонецФункции

Функция ИзмененияВJSON(Знач Изменения)

	Массив = Новый Массив();
	Для Каждого Изменение Из Изменения Цикл
		Запись = Новый Структура();
		Запись.Вставить("package", Изменение.ИмяПакета);
		Запись.Вставить("version", Изменение.Версия);
		Массив.Добавить(Запись);
	КонецЦикла;
	Возврат Массив;

КонецФункции

// Неопределено означает «прислана строка, которая моментом не является»; пустая строка —
// законный полный срез.
Функция РазобратьМомент(Знач Значение)

	Текст = СокрЛП(Строка(Значение));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат '00010101000000';
	КонецЕсли;

	Попытка
		Возврат XMLЗначение(Тип("Дата"), Текст);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПомощникAPI") _Помощник,
	&Пластилин(Значение = "СборщикСрезаИзменений") _Сборщик)

	Помощник = _Помощник;
	Сборщик = _Сборщик;

КонецПроцедуры
