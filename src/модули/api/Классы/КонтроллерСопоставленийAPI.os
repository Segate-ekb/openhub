// Контроллер сопоставлений групп OIDC API: правила {issuer, клейм, значение} → группа хаба.
// Доступ к группе — ГвардГруппыAPI, доменные операции — СервисСопоставленийГрупп.

Перем Ответы;              // ОтветыAPI (auth)
Перем Запрос;              // ЗапросAPI (api)
Перем Маршрут;             // МаршрутAPI (api)
Перем Допуск;              // ДопускAPI (api)
Перем Двери;               // ДвериAPI (api)
Перем ГвардГруппы;         // ГвардГруппыAPI (api)
Перем СервисСопоставлений; // СервисСопоставленийГрупп (auth)
Перем СервисГрупп;         // СервисГрупп (auth)
Перем HTTP;                // МетодыHTTP (основа)

#Область ТочкиМаршрута

// GET /api/v1/oidc-mappings — все правила маппинга хаба; обзор администратора хаба.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  issuer - Строка - отбор по issuer провайдера (необязательный, по умолчанию — все).
//
&ТочкаМаршрута("oidc-mappings")
Процедура ВсеСопоставления(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, issuer = "") Экспорт

	Если НЕ Маршрут.НачатьЧтение(Ответ, Неопределено, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Пользователь = Допуск.ТребоватьПользователя(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Пользователь = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Двери.ТребоватьАдминаХаба(Ответ, Пользователь) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(СокрЛП(Строка(issuer))) Тогда
		Набор = СервисСопоставлений.СопоставленияПровайдера(issuer);
	Иначе
		Набор = СервисСопоставлений.ВсеСопоставления();
	КонецЕсли;

	Элементы = Новый Массив();
	Для Каждого Правило Из Набор Цикл
		Элементы.Добавить(СопоставлениеВJSON(Правило));
	КонецЦикла;

	Ответы.JSON(Ответ, 200, Новый Структура("items, total", Элементы, Элементы.Количество()));

КонецПроцедуры

// GET /api/v1/groups/{Группа}/oidc-mappings — правила группы и политика выпавших;
// POST — завести правило (администратор хаба);
// DELETE — снять правило (администратор хаба); ключ правила приходит телом.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Группа - Строка - имя группы из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для POST и DELETE.
//  МетодЗапроса - Строка - метод запроса; допустимы GET, POST и DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("groups/{Группа}/oidc-mappings")
Процедура СопоставленияГруппы(Ответ, Группа, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Список(Ответ, Группа, ЗаголовкиЗапроса, КукиЗапроса);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Изменить(Ответ, Группа, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, "добавить");
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		Изменить(Ответ, Группа, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, "удалить");
	Иначе
		Маршрут.МетодНеРазрешён(Ответ, "GET, POST, DELETE");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура Список(Ответ, Знач ИмяГруппы, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Пользователь = Допуск.ТребоватьПользователя(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Пользователь = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Доступ = ГвардГруппы.Разрешить(Ответ, ИмяГруппы, Пользователь);
	Если Доступ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Элементы = Новый Массив();
	Для Каждого Правило Из СервисСопоставлений.ВсеСопоставления() Цикл
		Если Цел(Правило.ГруппаИдентификатор) = Доступ.Группа.Идентификатор Тогда
			Элементы.Добавить(СопоставлениеВJSON(Правило));
		КонецЕсли;
	КонецЦикла;

	Данные = Новый Структура();
	Данные.Вставить("items", Элементы);
	Данные.Вставить("total", Элементы.Количество());
	Данные.Вставить("policy", СервисСопоставлений.ПолитикаВыпавших(Доступ.Группа.Идентификатор));
	Ответы.JSON(Ответ, 200, Данные);

КонецПроцедуры

Процедура Изменить(Ответ, Знач ИмяГруппы, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач ТелоЗапроса, Знач Операция)

	Мутация = Допуск.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Доступ = ГвардГруппы.Разрешить(Ответ, ИмяГруппы, Мутация.Пользователь, Истина);
	Если Доступ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Тело = Мутация.Тело;
	Издатель = СокрЛП(Запрос.Поле(Тело, "издатель", Запрос.Поле(Тело, "issuer")));
	Значение = СокрЛП(Запрос.Поле(Тело, "значение", Запрос.Поле(Тело, "value")));
	Клейм = СокрЛП(Запрос.Поле(Тело, "клейм", Запрос.Поле(Тело, "claim", "groups")));

	Если НЕ ЗначениеЗаполнено(Издатель) ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		Ответы.Ошибка(Ответ, 400, "invalid_mapping",
			"Требуются непустые поля издатель (issuer) и значение (value)");
		Возврат;
	КонецЕсли;

	Если Операция = "удалить" Тогда
		Снято = СервисСопоставлений.УдалитьСопоставление(
			Доступ.Группа.Идентификатор, Издатель, Значение, Клейм);
		Ответы.JSON(Ответ, 200, Новый Структура("removed", Снято));
		Возврат;
	КонецЕсли;

	Попытка
		Правило = СервисСопоставлений.ДобавитьСопоставление(
			Доступ.Группа.Идентификатор, Издатель, Значение, Клейм);
	Исключение
		Ответы.Ошибка(Ответ, 400, "invalid_mapping",
			"Некорректное правило маппинга (issuer, клейм или значение)");
		Возврат;
	КонецПопытки;

	Ответы.JSON(Ответ, 201, Новый Структура("mapping", СопоставлениеВJSON(Правило)));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СопоставлениеВJSON(Знач Правило)

	Группа = СервисГрупп.ПоИдентификатору(Правило.ГруппаИдентификатор);

	Структура = Новый Структура();
	Структура.Вставить("id", Правило.Идентификатор);
	Структура.Вставить("group_id", Цел(Правило.ГруппаИдентификатор));
	Структура.Вставить("group", ?(Группа = Неопределено, "", Строка(Группа.Имя)));
	Структура.Вставить("issuer", Строка(Правило.Издатель));
	Структура.Вставить("claim", Строка(Правило.ИмяКлейма));
	Структура.Вставить("value", Строка(Правило.Значение));
	Возврат Структура;

КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ЗапросAPI") _Запрос,
	&Пластилин(Значение = "МаршрутAPI") _Маршрут,
	&Пластилин(Значение = "ДопускAPI") _Допуск,
	&Пластилин(Значение = "ДвериAPI") _Двери,
	&Пластилин(Значение = "ГвардГруппыAPI") _ГвардГруппы,
	&Пластилин(Значение = "СервисСопоставленийГрупп") _СервисСопоставлений,
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп,
	&Пластилин(Значение = "МетодыHTTP") _HTTP)

	Ответы = _Ответы;
	Запрос = _Запрос;
	Маршрут = _Маршрут;
	Допуск = _Допуск;
	Двери = _Двери;
	ГвардГруппы = _ГвардГруппы;
	СервисСопоставлений = _СервисСопоставлений;
	СервисГрупп = _СервисГрупп;
	HTTP = _HTTP;

КонецПроцедуры
