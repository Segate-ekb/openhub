// Контроллер грантов прав доступа API: витрина по объекту (пул, пакет) и по субъекту
// (пользователь, группа), выдача роли и отзыв. Доменные операции — СлужбаДоступа, та же,
// что у раздела «Права доступа» дома пула.

Перем Помощник;      // ПомощникAPI (api)
Перем ГвардГруппы;   // ГвардГруппыAPI (api)
Перем Сборщик;       // СборщикГрантов (api)
Перем Служба;        // СлужбаДоступа (кабинет)
Перем Субъекты;      // СубъектыПрав (auth) — идентификатор по логину/имени группы
Перем Видимость;     // ВидимостьОбъектовПрав (auth) — что смотрящему вообще видно
Перем СервисПакетов; // СервисПакетов (реестр)
Перем СервисПользователей; // СервисПользователей (auth)
Перем HTTP;          // МетодыHTTP (основа)

#Область ТочкиМаршрута

// GET /api/v1/pools/{Пул}/grants — права на пул либо на его пакет (параметр package);
// POST — выдать роль субъекту; DELETE — отозвать право.
// Объект «пул» требует прав владельца либо администратора пула, объект «пакет» —
// права управления этим пакетом.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для POST и DELETE.
//  МетодЗапроса - Строка - метод запроса; допустимы GET, POST и DELETE.
//  package - Строка - имя пакета пула, если грант на пакет (необязательный,
//            по умолчанию — объектом выступает пул).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/grants")
Процедура ГрантыПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	package = "", ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Помощник.НачатьМаршрут(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		СписокПоОбъекту(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, package);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		ИзменитьГрант(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, "выдать");
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		ИзменитьГрант(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, "отозвать");
	Иначе
		Помощник.МетодНеРазрешён(Ответ, "GET, POST, DELETE");
	КонецЕсли;

КонецПроцедуры

// GET /api/v1/groups/{Группа}/grants — на что есть права у группы; видно её участникам
// и администратору хаба.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Группа - Строка - имя группы из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("groups/{Группа}/grants")
Процедура ГрантыГруппы(Ответ, Группа, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Помощник.НачатьЧтение(Ответ, ПараметрыЗапросаПорядковые, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Пользователь = Помощник.ТребоватьПользователя(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Пользователь = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Доступ = ГвардГруппы.Разрешить(Ответ, Группа, Пользователь);
	Если Доступ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// та же рамка, что у витрины группы в кабинете: участник не узнаёт из списка прав
	// своей группы имена пулов и пакетов, которых ему не видно
	ОтдатьГранты(Ответ, Видимые(Служба.ГрантыСубъекта("группа", Доступ.Группа.Идентификатор),
		Пользователь, Помощник.Принципал(ЗаголовкиЗапроса, КукиЗапроса)));

КонецПроцедуры

// GET /api/v1/users/{Логин}/grants — на что есть права у пользователя; видно ему самому
// и администратору хаба.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Логин - Строка - логин пользователя из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("users/{Логин}/grants")
Процедура ГрантыПользователя(Ответ, Логин, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Помощник.НачатьЧтение(Ответ, ПараметрыЗапросаПорядковые, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Пользователь = Помощник.ТребоватьПользователя(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Пользователь = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// сначала право, потом поиск: иначе чужой логин проверялся бы на существование
	Свой = НРег(СокрЛП(Строка(Логин))) = НРег(СокрЛП(Строка(Пользователь.Логин)));
	Если НЕ Свой И НЕ Помощник.СервисПрав().ПользовательАдмин(Пользователь) Тогда
		Помощник.Ошибка(Ответ, 403, "forbidden", "Права чужого аккаунта видит только администратор хаба");
		Возврат;
	КонецЕсли;

	Субъект = СервисПользователей.НайтиПоЛогину(Логин);
	Если Субъект = Неопределено Тогда
		Помощник.Ошибка(Ответ, 404, "user_not_found", СтрШаблон("Пользователь ""%1"" не найден", Логин));
		Возврат;
	КонецЕсли;

	ОтдатьГранты(Ответ, Служба.ГрантыСубъекта("пользователь", Субъект.Идентификатор));

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура СписокПоОбъекту(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ИмяПакета)

	Принц = Помощник.Принципал(ЗаголовкиЗапроса, КукиЗапроса);

	Объект = ОбъектСДоступом(Ответ, Помощник.ВидимыйПул(Ответ, ИмяПула, Принц), Принц, ИмяПакета);
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОтдатьГранты(Ответ, Служба.ГрантыНаОбъект(Объект.Тип, Объект.Идентификатор));

КонецПроцедуры

Процедура ИзменитьГрант(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач ТелоЗапроса, Знач Операция)

	Мутация = Помощник.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, ИмяПула);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Тело = Мутация.Тело;
	Объект = ОбъектСДоступом(Ответ, Помощник.ПулМутации(Ответ, ИмяПула, Мутация.Принц),
		Мутация.Принц, Помощник.Поле(Тело, "пакет", Помощник.Поле(Тело, "package")));
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// защита в глубину: порог управления правами на самом объекте, а не только на пуле
	Если НЕ Служба.МожетВыдаватьГрант(Мутация.Пользователь, Объект.Тип, Объект.Идентификатор) Тогда
		Помощник.Ошибка(Ответ, 403, "forbidden",
			"Недостаточно прав для управления правами доступа к объекту");
		Возврат;
	КонецЕсли;

	ТипСубъекта = НРег(СокрЛП(Помощник.Поле(Тело, "тип_субъекта",
		Помощник.Поле(Тело, "subject_type", "пользователь"))));
	Если ТипСубъекта <> "пользователь" И ТипСубъекта <> "группа" Тогда
		Помощник.Ошибка(Ответ, 400, "invalid_subject",
			"Тип субъекта: пользователь либо группа");
		Возврат;
	КонецЕсли;

	Имя = СокрЛП(Помощник.Поле(Тело, "субъект", Помощник.Поле(Тело, "subject")));
	СубъектИд = Субъекты.Идентификатор(ТипСубъекта, Имя);
	Если СубъектИд = 0 Тогда
		Помощник.Ошибка(Ответ, 400, "unknown_subject",
			СтрШаблон("Субъект ""%1"" не найден", Имя));
		Возврат;
	КонецЕсли;

	Попытка
		Если Операция = "отозвать" Тогда
			Отозвано = Служба.ОтозватьГрант(Мутация.Пользователь, ТипСубъекта, СубъектИд,
				Объект.Тип, Объект.Идентификатор);
			Помощник.JSON(Ответ, 200, Новый Структура("revoked", Отозвано));
			Возврат;
		КонецЕсли;
		Грант = Служба.ВыдатьРоль(Мутация.Пользователь, ТипСубъекта, СубъектИд,
			Объект.Тип, Объект.Идентификатор,
			Помощник.Поле(Тело, "роль", Помощник.Поле(Тело, "role", "читатель")));
	Исключение
		// текст исключения домена несёт пользовательский ввод — наружу уходит фиксированный
		Помощник.Ошибка(Ответ, 422, "invalid_grant",
			"Некорректный грант: роль допустима из набора читатель, райтер, мейнтейнер");
		Возврат;
	КонецПопытки;

	Помощник.JSON(Ответ, 201, Новый Структура("grant", Сборщик.ГрантJSON(Грант)));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Объект гранта вместе с правом на него: сам пул либо его пакет по имени. Дверь пула
// вызывающий открывает своей — читающую и мутационную рамки ключа различает он, — и
// закрытая дверь приходит сюда как Неопределено с уже записанным 404. Дальше по порядку:
// сам объект, затем право на объекте — администрирование пула для объекта «пул» и
// управление пакетом для объекта «пакет». Мейнтейнер пакета правит права на свой пакет,
// не будучи администратором пула. Пакет ищется ТОЛЬКО в пуле из адреса, поэтому
// кросс-пуловая подстановка невозможна. Неопределено — ответ уже записан.
Функция ОбъектСДоступом(Ответ, Знач Пул, Знач Принц, Знач ИмяПакета)

	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пользователь = Принц.Пользователь;

	Если НЕ ЗначениеЗаполнено(СокрЛП(Строка(ИмяПакета))) Тогда
		Если НЕ Помощник.ТребоватьАдмин(Ответ, Пользователь, Пул) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Новый Структура("Тип, Идентификатор", "пул", Пул.Идентификатор);
	КонецЕсли;

	Пакет = СервисПакетов.НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Если Пакет = Неопределено Тогда
		Помощник.Ошибка(Ответ, 404, "package_not_found", СтрШаблон("Пакет ""%1"" не найден", ИмяПакета));
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ Помощник.ТребоватьИзменениеПакета(Ответ, Пользователь, Пул, Пакет) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Тип, Идентификатор", "пакет", Пакет.Идентификатор);

КонецФункции

// Записи прав, объекты которых смотрящему видны.
Функция Видимые(Знач Гранты, Знач Пользователь, Знач Принц)

	Результат = Новый Массив();
	Для Каждого Право Из Гранты Цикл
		Если Видимость.Виден(Пользователь, Право.ТипОбъекта, Право.ОбъектИдентификатор, Принц) Тогда
			Результат.Добавить(Право);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ОтдатьГранты(Ответ, Знач Гранты)
	Элементы = Сборщик.СписокJSON(Гранты);
	Помощник.JSON(Ответ, 200, Новый Структура("items, total", Элементы, Элементы.Количество()));
КонецПроцедуры

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПомощникAPI") _Помощник,
	&Пластилин(Значение = "ГвардГруппыAPI") _ГвардГруппы,
	&Пластилин(Значение = "СборщикГрантов") _Сборщик,
	&Пластилин(Значение = "СлужбаДоступа") _Служба,
	&Пластилин(Значение = "СубъектыПрав") _Субъекты,
	&Пластилин(Значение = "ВидимостьОбъектовПрав") _Видимость,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "МетодыHTTP") _HTTP)

	Помощник = _Помощник;
	ГвардГруппы = _ГвардГруппы;
	Сборщик = _Сборщик;
	Служба = _Служба;
	Субъекты = _Субъекты;
	Видимость = _Видимость;
	СервисПакетов = _СервисПакетов;
	СервисПользователей = _СервисПользователей;
	HTTP = _HTTP;

КонецПроцедуры
