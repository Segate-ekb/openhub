// Поправка нижестоящего объекта к подписке сверху; в перечне сужений — ещё и чья она.

&Сериализуемое("mute")
&Заполнено
&Тип("Булево")
Перем НеПрисылать;

&Сериализуемое("events")
&Заполнено
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("Строка")
Перем События;

&Сериализуемое("tags")
&Заполнено
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("Строка")
Перем Теги;

&Сериализуемое("excluded_package_count")
&Тип("Число")
Перем ИсключеноПакетов;

&Сериализуемое("updated")
&Заполнено
&Тип("Строка")
Перем Изменена;

&Сериализуемое("object_type")
&Тип("Строка")
&ОдинИз("pool", "package")
Перем ТипОбъекта;

&Сериализуемое("pool")
&Тип("Строка")
Перем Пул;

&Сериализуемое("package")
&Тип("Строка")
Перем Пакет;
