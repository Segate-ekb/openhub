// Дерево получателей подписки хаба и пула в API: чтение дерева и замена исключений из него.
// Права — те же, что на саму подписку; подписка пакета и чужая подписка отвечают 404.

Перем Ответы;      // ОтветыAPI (основа)
Перем Запрос;      // ЗапросAPI (протоколAPI)
Перем Сервис;      // СервисПодписок (подписки) — право распоряжаться подписками объекта
Перем Исключения;  // СервисИсключенийПодписок (подписки)
Перем СервисПулов;   // СервисПулов (реестр) — пул по имени из тела
Перем СервисПакетов; // СервисПакетов (реестр) — пакет по имени из тела
Перем СервисПрав;    // СервисПрав (права) — видит ли хозяин подписки названный пул
Перем Ошибки;      // ТекстОшибки (основа) — причина отказа без служебного хвоста
Перем Числа;       // ПриведениеЧисел (основа)

#Область ПубличныйИнтерфейс

// Дерево получателей подписки: у подписки хаба — пулы с пакетами, у подписки пула — пакеты пула;
// у каждого узла — исключён ли он. 403 без права на подписки объекта, 404 без подписки с деревом.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//  Объект - Структура - описание объекта подписок.
//  Ид - Строка, Число - идентификатор подписки из адреса.
//
Процедура Дерево(Ответ, Знач Пользователь, Знач Объект, Знач Ид) Экспорт

	Если НЕ ТребоватьУправление(Ответ, Пользователь, Объект) Тогда
		Возврат;
	КонецЕсли;
	ОтдатьДерево(Ответ, Пользователь, Объект, Ид);

КонецПроцедуры

// Заменяет исключения подписки присланными: узел, которого в теле нет, возвращается в дерево.
// Тело: `excluded_pools` — имена пулов (только у подписки хаба), `excluded_packages` — пакеты:
// у подписки хаба «пул/пакет», у подписки пула — имя пакета; массивом или строкой через запятую.
// Пул, которого хозяин подписки не видит, отвечает так же, как несуществующий.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь - субъект запроса.
//  Объект - Структура - описание объекта подписок.
//  Ид - Строка, Число - идентификатор подписки из адреса.
//  Тело - Соответствие - разобранное тело.
//
Процедура Заменить(Ответ, Знач Пользователь, Знач Объект, Знач Ид, Знач Тело) Экспорт

	Если НЕ ТребоватьУправление(Ответ, Пользователь, Объект) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Найдена = Исключения.Заменить(Пользователь, Объект, Числа.ЧислоИлиНоль(Ид),
			УзлыИзТела(Пользователь, Объект, Тело));
	Исключение
		Текст = Ошибки.ДляЧеловека(ИнформацияОбОшибке());
		Ответы.Сбой(Ответ, 422, "invalid_recipients",
			?(ЗначениеЗаполнено(Текст), Текст, "Исключения не приняты: проверьте имена пулов и пакетов"),
			ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Если НЕ Найдена Тогда
		НеНайдено(Ответ);
		Возврат;
	КонецЕсли;
	ОтдатьДерево(Ответ, Пользователь, Объект, Ид);

КонецПроцедуры

#КонецОбласти

#Область Представление

Процедура ОтдатьДерево(Ответ, Знач Пользователь, Знач Объект, Знач Ид)

	Дерево = Исключения.ДеревоПолучателей(Пользователь, Объект, Числа.ЧислоИлиНоль(Ид));
	Если Дерево = Неопределено Тогда
		НеНайдено(Ответ);
		Возврат;
	КонецЕсли;
	Ответы.JSON(Ответ, 200, ?(Дерево.ПодпискаХаба, ДеревоХаба(Дерево), ДеревоПула(Дерево)));

КонецПроцедуры

Функция ДеревоХаба(Знач Дерево)

	Пулы = Новый Массив();
	ИсключённыеПулы = Новый Массив();
	ИсключённыеПакеты = Новый Массив();
	Для Каждого Пул Из Дерево.Пулы Цикл
		Пулы.Добавить(Новый Структура("name, private, excluded, packages",
			Пул.Имя, Пул.Приватный, Пул.Исключён, Пакеты(Пул)));
		Если Пул.Исключён Тогда
			ИсключённыеПулы.Добавить(Пул.Имя);
		КонецЕсли;
		Для Каждого Пакет Из Пул.Пакеты Цикл
			Если Пакет.Исключён Тогда
				ИсключённыеПакеты.Добавить(Пул.Имя + "/" + Пакет.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Новый Структура("pools, excluded_pools, excluded_packages", Пулы, ИсключённыеПулы, ИсключённыеПакеты);

КонецФункции

Функция ДеревоПула(Знач Дерево)

	Пакеты = Новый Массив();
	ИсключённыеПакеты = Новый Массив();
	Для Каждого Пул Из Дерево.Пулы Цикл
		Для Каждого Пакет Из Пакеты(Пул) Цикл
			Пакеты.Добавить(Пакет);
		КонецЦикла;
		Для Каждого Пакет Из Пул.Пакеты Цикл
			Если Пакет.Исключён Тогда
				ИсключённыеПакеты.Добавить(Пакет.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Новый Структура("packages, excluded_packages", Пакеты, ИсключённыеПакеты);

КонецФункции

Функция Пакеты(Знач Пул)
	Результат = Новый Массив();
	Для Каждого Пакет Из Пул.Пакеты Цикл
		Результат.Добавить(Новый Структура("name, excluded", Пакет.Имя, Пакет.Исключён));
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область РазборТела

// Имена из тела — в узлы дерева; имя, которого в хабе нет, — отказ с названным именем. Пулы
// исключает только подписка хаба: у подписки пула поле отклоняется до всякого поиска, и ответ
// не говорит, есть ли такой пул.
Функция УзлыИзТела(Знач Пользователь, Знач Объект, Знач Тело)

	Пулы = Перечень(Тело, "excluded_pools,исключённые_пулы");
	ПодпискаХаба = НРег(СокрЛП(Строка(Объект.ТипОбъекта))) = "хаб";
	Если Пулы.Количество() > 0 И НЕ ПодпискаХаба Тогда
		ВызватьИсключение "Подписка пула исключает только свои пакеты: excluded_pools у неё не принимается";
	КонецЕсли;

	Узлы = Новый Массив();
	Для Каждого Имя Из Пулы Цикл
		Узлы.Добавить(Исключения.Узел("пул", ВидимыйПул(Пользователь, Имя).Идентификатор));
	КонецЦикла;
	Для Каждого Имя Из Перечень(Тело, "excluded_packages,исключённые_пакеты") Цикл
		Узлы.Добавить(Исключения.Узел("пакет", ПакетПоИмени(Пользователь, Объект, Имя).Идентификатор));
	КонецЦикла;
	Возврат Узлы;

КонецФункции

// Пул, которого хозяин подписки не видит, для него не существует.
Функция ВидимыйПул(Знач Пользователь, Знач Имя)

	Пул = СервисПулов.НайтиПул(Имя);
	Если Пул = Неопределено ИЛИ НЕ СервисПрав.МожетЧитать(Пользователь, Пул) Тогда
		ВызватьИсключение СтрШаблон("Пула «%1» нет", Имя);
	КонецЕсли;
	Возврат Пул;

КонецФункции

// У подписки хаба пакет назван с пулом «пул/пакет», у подписки пула — своим именем.
Функция ПакетПоИмени(Знач Пользователь, Знач Объект, Знач Имя)

	ПулИдентификатор = Объект.Идентификатор;
	ИмяПакета = Имя;
	Если НРег(СокрЛП(Строка(Объект.ТипОбъекта))) = "хаб" Тогда
		Позиция = СтрНайти(Имя, "/");
		Если Позиция = 0 Тогда
			ВызватьИсключение СтрШаблон("Пакет «%1» назовите с его пулом: «пул/пакет»", Имя);
		КонецЕсли;
		ПулИдентификатор = ВидимыйПул(Пользователь, Лев(Имя, Позиция - 1)).Идентификатор;
		ИмяПакета = Сред(Имя, Позиция + 1);
	КонецЕсли;

	Пакет = СервисПакетов.НайтиПакет(ПулИдентификатор, ИмяПакета);
	Если Пакет = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Пакета «%1» нет", Имя);
	КонецЕсли;
	Возврат Пакет;

КонецФункции

// Массив имён либо строка через запятую; поля нет — пустой перечень.
Функция Перечень(Знач Тело, Знач Имена)

	Значение = Запрос.Присланное(Тело, Имена);
	Части = ?(ТипЗнч(Значение) = Тип("Массив"), Значение,
		СтрРазделить(?(Значение = Неопределено, "", Строка(Значение)), ",", Ложь));

	Результат = Новый Массив();
	Для Каждого Часть Из Части Цикл
		Имя = СокрЛП(Строка(Часть));
		Если ЗначениеЗаполнено(Имя) Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТребоватьУправление(Ответ, Знач Пользователь, Знач Объект)

	Если Сервис.МожетУправлять(Пользователь, Объект) Тогда
		Возврат Истина;
	КонецЕсли;
	Ответы.Ошибка(Ответ, 403, "forbidden", "Недостаточно прав для управления подписками объекта");
	Возврат Ложь;

КонецФункции

Процедура НеНайдено(Ответ)
	Ответы.Ошибка(Ответ, 404, "subscription_not_found", "Подписки с деревом получателей у объекта нет");
КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ЗапросAPI") _Запрос,
	&Пластилин(Значение = "СервисПодписок") _Сервис,
	&Пластилин(Значение = "СервисИсключенийПодписок") _Исключения,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа)

	Ответы = _Ответы;
	Запрос = _Запрос;
	Сервис = _Сервис;
	Исключения = _Исключения;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	СервисПрав = _СервисПрав;
	Ошибки = _Ошибки;
	Числа = _Числа;

КонецПроцедуры
