// Тело заведения и правки подписки; поля вида доставки называет справочник подписок.

&Сериализуемое("kind")
&Тип("Строка")
&ОдинИз("вебхук", "telegram")
Перем Вид;

&Сериализуемое("url")
&Тип("Строка")
Перем Адрес;

&Сериализуемое("секрет")
&Тип("Строка")
Перем Секрет;

&Сериализуемое("чатид")
&Тип("Строка")
Перем ЧатИд;

&Сериализуемое("токен")
&Тип("Строка")
Перем Токен;

&Сериализуемое("шаблон")
&Тип("Строка")
Перем Шаблон;

&Сериализуемое("events")
Перем События;

&Сериализуемое("params")
Перем Параметры;

&Сериализуемое("name")
&Тип("Строка")
Перем Название;

&Сериализуемое("tags")
Перем Теги;

&Сериализуемое("narrowing_allowed")
&Тип("Булево")
Перем СужениеРазрешено;

&Сериализуемое("enabled")
&Тип("Булево")
Перем Включена;
