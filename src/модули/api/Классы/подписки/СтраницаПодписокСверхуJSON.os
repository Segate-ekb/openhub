// Страница подписок сверху.

&Сериализуемое("items")
&Заполнено
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("ПодпискаСверхуJSON")
Перем Элементы;

&Сериализуемое("page")
&Заполнено
&Тип("Число")
Перем Номер;

&Сериализуемое("pageSize")
&Заполнено
&Тип("Число")
Перем Размер;

&Сериализуемое("total")
&Заполнено
&Тип("Число")
Перем Всего;

&Сериализуемое("has_more")
&Заполнено
&Тип("Булево")
Перем ЕстьЕщё;
