// Подписка и типы действий в JSON: карточка записи, подписка сверху для нижестоящего объекта
// и справочник для конвейера. Значений секретов здесь нет — только признаки «задан».

Перем Сервис;            // СервисПодписок (подписки)
Перем Реестр;            // РеестрДействийПодписок (подписки)
Перем ПараметрыПодписки; // ПараметрыПодписки (подписки) — пороги, название, отбор, разрешение сужать
Перем Поправки;          // СервисПоправокПодписок (подписки) — кто сузил подписку
Перем ОтборТегов;        // ОтборПоТегам (подписки) — действующий отбор по тегам
Перем СервисПулов;       // СервисПулов (реестр) — имена объектов поправок
Перем СервисПакетов;     // СервисПакетов (реестр) — имена объектов поправок
Перем ЧерезЗапятую;      // СписокЧерезЗапятую (основа)
Перем Моменты;           // МоментISO (основа) — одно написание времени в ответе

#Область ПубличныйИнтерфейс

// Карточка подписки для ответа API её хозяину: у подписки хаба и пула — ещё и поправки,
// которые к ней поставили нижестоящие объекты.
//
// Параметры:
//  Запись - Вебхук - запись подписки.
//
// Возвращаемое значение:
//  Структура - сериализуемое представление без значений секретов.
//
Функция Карточка(Знач Запись) Экспорт

	Структура = Новый Структура();
	Структура.Вставить("id", Цел(Запись.Идентификатор));
	Структура.Вставить("object_type", Строка(Запись.ТипОбъекта));
	Структура.Вставить("object_id", Цел(Запись.ОбъектИдентификатор));
	Структура.Вставить("kind", Сервис.ТипДействияПодписки(Запись));
	Структура.Вставить("address", Строка(Запись.URL));
	Структура.Вставить("events", ЧерезЗапятую.Разобрать(Запись.ТипыСобытий, Ложь));
	Структура.Вставить("enabled", Запись.Активен = Истина);
	Структура.Вставить("has_secret", ЗначениеЗаполнено(Запись.Секрет));
	Структура.Вставить("own_token", ЗначениеЗаполнено(Запись.ТокенДействия));
	Структура.Вставить("own_template", ЗначениеЗаполнено(Запись.ШаблонТекста));
	ДобавитьСвойства(Структура, Запись);
	Если НРег(Запись.ТипОбъекта) <> "пакет" Тогда
		Структура.Вставить("narrowed_by", ПоставленныеПоправки(Запись));
	КонецЕсли;
	Структура.Вставить("created", Моменты.Строкой(Запись.Создан));
	Структура.Вставить("updated", Моменты.Строкой(Запись.Обновлён));
	Возврат Структура;

КонецФункции

// Подписка сверху для нижестоящего объекта: название, хозяин, способ доставки, события, отбор
// и поправка объекта. Адреса, чата, признаков своих секретов и чужих поправок здесь нет.
//
// Параметры:
//  Запись - Вебхук - подписка хаба или пула.
//  Поправка - ПоправкаПодписки, Неопределено - поправка объекта; Неопределено — не сужал.
//  ИмяПула - Строка - пул подписки пула; у подписки хаба не выводится.
//
// Возвращаемое значение:
//  Структура - сериализуемое представление.
//
Функция Сверху(Знач Запись, Знач Поправка, Знач ИмяПула) Экспорт

	Структура = Новый Структура();
	Структура.Вставить("id", Цел(Запись.Идентификатор));
	Структура.Вставить("level", ?(НРег(Запись.ТипОбъекта) = "хаб", "hub", "pool"));
	Если НРег(Запись.ТипОбъекта) <> "хаб" Тогда
		Структура.Вставить("pool", Строка(ИмяПула));
	КонецЕсли;
	Структура.Вставить("kind", Сервис.ТипДействияПодписки(Запись));
	Структура.Вставить("events", ЧерезЗапятую.Разобрать(Запись.ТипыСобытий, Ложь));
	Структура.Вставить("enabled", Запись.Активен = Истина);
	Общие = ПараметрыПодписки.Свойства(Запись);
	Структура.Вставить("name", Общие.Название);
	ДобавитьОтбор(Структура, Запись, Общие.ОтборТегов);
	Структура.Вставить("amendment", ?(Поправка = Неопределено, Неопределено, Сужение(Запись, Поправка)));
	Возврат Структура;

КонецФункции

// Справочник: типы событий, доступные для подписки, и типы действий с именами полей
// настроек. Секретные поля помечены признаком, значений в справочнике нет.
//
// Возвращаемое значение:
//  Структура - events (Массив из Строка) и kinds (Массив из Структура).
//
Функция Справочник() Экспорт

	События = Новый Массив();
	Для Каждого Тип Из Сервис.ИзвестныеТипы() Цикл
		События.Добавить(Тип);
	КонецЦикла;

	Виды = Новый Массив();
	Для Каждого Тип Из Реестр.Типы() Цикл
		Вид = Новый Структура();
		Вид.Вставить("kind", Тип);
		Вид.Вставить("editable", Реестр.ПравкаПоддержана(Тип));
		Вид.Вставить("testable", Реестр.ПробаПоддержана(Тип));
		Вид.Вставить("fields", ПоляТипа(Тип));
		Виды.Добавить(Вид);
	КонецЦикла;

	Возврат Новый Структура("events, kinds", События, Виды);

КонецФункции

// Поля настроек типа: имя во вводе, обязательность и признак секретности.
//
// Параметры:
//  Тип - Строка - тип действия подписки.
//
// Возвращаемое значение:
//  Массив из Структура - описания полей, объявленные рендером настроек типа;
//  пустой, если тип полей не заявил.
//
Функция ПоляТипа(Знач Тип) Экспорт

	Результат = Новый Массив();
	Для Каждого Поле Из Поля(Тип) Цикл
		Описание = Новый Структура();
		Описание.Вставить("name", Строка(Поле.Имя));
		Описание.Вставить("required", Поле.Обязательное = Истина);
		Описание.Вставить("secret", Секретное(Поле));
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Декларация полей типа как её объявил рендер настроек.
//
// Параметры:
//  Тип - Строка - тип действия подписки.
//
// Возвращаемое значение:
//  Массив из Структура - описания полей; пустой, если рендера у типа нет.
//
Функция Поля(Знач Тип) Экспорт

	Рендер = Реестр.РендерНастроек(Тип);
	Возврат ?(Рендер = Неопределено, Новый Массив(), Рендер.ОписаниеПолей());

КонецФункции

// Секретно ли поле: значение такого поля наружу не отдаётся и правкой не стирается.
//
// Параметры:
//  Поле - Структура - описание поля из декларации рендера.
//
// Возвращаемое значение:
//  Булево.
//
Функция Секретное(Знач Поле) Экспорт
	Значение = Неопределено;
	Возврат Поле.Свойство("Секретное", Значение) И Значение = Истина;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьСвойства(Структура, Знач Запись)

	Общие = ПараметрыПодписки.Свойства(Запись);
	Структура.Вставить("name", Общие.Название);
	ДобавитьОтбор(Структура, Запись, Общие.ОтборТегов);
	Структура.Вставить("narrowing_allowed", Общие.СужениеРазрешено);

	Пороги = Новый Соответствие();
	Для Каждого Тип Из ЧерезЗапятую.Разобрать(Запись.ТипыСобытий) Цикл
		Значение = ПараметрыПодписки.Значение(Запись, Тип);
		Если Значение <> Неопределено Тогда
			Пороги.Вставить(Тип, Значение);
		КонецЕсли;
	КонецЦикла;
	Структура.Вставить("params", Пороги);

КонецПроцедуры

// У подписки хаба отбора по тегам нет — и поля нет; у прочих — теги, которые у объекта есть сейчас.
Процедура ДобавитьОтбор(Структура, Знач Запись, Знач Сохранённый)
	Если НРег(Запись.ТипОбъекта) <> "хаб" Тогда
		Структура.Вставить("tags", ОтборТегов.Действующий(Запись, Сохранённый));
	КонецЕсли;
КонецПроцедуры

Функция ПоставленныеПоправки(Знач Запись)

	Результат = Новый Массив();
	Для Каждого Поправка Из Поправки.ПоправкиПодписки(Запись) Цикл
		Элемент = Сужение(Запись, Поправка);
		Элемент.Вставить("object_type", ?(НРег(Поправка.ТипОбъекта) = "пул", "pool", "package"));
		Элемент.Вставить("pool", ИмяПула(Поправка.ПулИдентификатор));
		Если НРег(Поправка.ТипОбъекта) <> "пул" Тогда
			Элемент.Вставить("package", ИмяПакета(Поправка.ОбъектИдентификатор));
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Что поправка оставила объекту: «не присылать», события, свой отбор и у пула — сколько своих
// пакетов он исключил.
Функция Сужение(Знач Запись, Знач Поправка)

	Результат = Новый Структура();
	Результат.Вставить("mute", Поправка.НеПрисылать = Истина);
	Результат.Вставить("events", Поправки.ОставленныеСобытия(Запись, Поправка));
	Результат.Вставить("tags", ОтборТегов.Действующий(Поправка, Поправка.ОтборТегов));
	Если НРег(СокрЛП(Строка(Поправка.ТипОбъекта))) = "пул" Тогда
		Результат.Вставить("excluded_package_count", Поправки.ИсключённыеПакеты(Поправка).Количество());
	КонецЕсли;
	Результат.Вставить("updated", Моменты.Строкой(Поправка.Обновлена));
	Возврат Результат;

КонецФункции

Функция ИмяПула(Знач Идентификатор)
	Пул = СервисПулов.ПулПоИдентификатору(Идентификатор);
	Возврат ?(Пул = Неопределено, "", Строка(Пул.Имя));
КонецФункции

Функция ИмяПакета(Знач Идентификатор)
	Пакет = СервисПакетов.ПакетПоИдентификатору(Идентификатор);
	Возврат ?(Пакет = Неопределено, "", Строка(Пакет.Имя));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПодписок") _Сервис,
	&Пластилин(Значение = "РеестрДействийПодписок") _Реестр,
	&Пластилин(Значение = "ПараметрыПодписки") _ПараметрыПодписки,
	&Пластилин(Значение = "СервисПоправокПодписок") _Поправки,
	&Пластилин(Значение = "ОтборПоТегам") _ОтборТегов,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СписокЧерезЗапятую") _ЧерезЗапятую = Неопределено,
	&Пластилин(Значение = "МоментISO") _Моменты = Неопределено)

	ЧерезЗапятую = ?(_ЧерезЗапятую = Неопределено, Новый СписокЧерезЗапятую(), _ЧерезЗапятую);
	Моменты = ?(_Моменты = Неопределено, Новый МоментISO(), _Моменты);

	Сервис = _Сервис;
	Реестр = _Реестр;
	ПараметрыПодписки = _ПараметрыПодписки;
	Поправки = _Поправки;
	ОтборТегов = _ОтборТегов;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;

КонецПроцедуры
