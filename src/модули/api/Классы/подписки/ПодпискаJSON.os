// Подписка объекта: куда и о чём слать, отбор и поправки нижестоящих.

&Сериализуемое("id")
&Заполнено
&Тип("Число")
Перем Ид;

&Сериализуемое("object_type")
&Заполнено
&Тип("Строка")
&ОдинИз("хаб", "пул", "пакет")
Перем ТипОбъекта;

&Сериализуемое("object_id")
&Заполнено
&Тип("Число")
Перем ИдОбъекта;

&Сериализуемое("kind")
&Заполнено
&Тип("Строка")
&ОдинИз("вебхук", "telegram")
Перем Вид;

&Сериализуемое("address")
&Заполнено
&Тип("Строка")
Перем Адрес;

&Сериализуемое("events")
&Заполнено
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("Строка")
Перем События;

&Сериализуемое("enabled")
&Заполнено
&Тип("Булево")
Перем Включена;

&Сериализуемое("has_secret")
&Заполнено
&Тип("Булево")
Перем ЕстьСекрет;

&Сериализуемое("own_token")
&Заполнено
&Тип("Булево")
Перем СвойТокен;

&Сериализуемое("own_template")
&Заполнено
&Тип("Булево")
Перем СвойШаблон;

&Сериализуемое("name")
&Заполнено
&Тип("Строка")
Перем Название;

&Сериализуемое("tags")
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("Строка")
Перем Теги;

&Сериализуемое("narrowing_allowed")
&Заполнено
&Тип("Булево")
Перем СужениеРазрешено;

&Сериализуемое("params")
&Заполнено
&Тип("Соответствие")
&ДляКаждого("Значение")
&Тип("Число")
Перем Параметры;

&Сериализуемое("narrowed_by")
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("ПоправкаПодпискиJSON")
Перем Сужена;

&Сериализуемое("created")
&Заполнено
&Тип("Строка")
Перем Создана;

&Сериализуемое("updated")
&Заполнено
&Тип("Строка")
Перем Изменена;
