// Подписка хаба или пула, которую видит нижестоящий объект, и его поправка.

&Сериализуемое("id")
&Заполнено
&Тип("Число")
Перем Ид;

&Сериализуемое("level")
&Заполнено
&Тип("Строка")
&ОдинИз("hub", "pool")
Перем Уровень;

&Сериализуемое("pool")
&Тип("Строка")
Перем Пул;

&Сериализуемое("kind")
&Заполнено
&Тип("Строка")
&ОдинИз("вебхук", "telegram")
Перем Вид;

&Сериализуемое("events")
&Заполнено
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("Строка")
Перем События;

&Сериализуемое("enabled")
&Заполнено
&Тип("Булево")
Перем Включена;

&Сериализуемое("name")
&Заполнено
&Тип("Строка")
Перем Название;

&Сериализуемое("tags")
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("Строка")
Перем Теги;

&Сериализуемое("amendment", Обязательное = Истина)
&Тип("ПоправкаПодпискиJSON")
Перем Поправка;
