	КонецЕсли;
	Объект = ОбъектПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Объект <> Неопределено Тогда
		ДеревоПоправки(Ответ, Объект, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса);
	КонецЕсли;

