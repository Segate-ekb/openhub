&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/inherited-webhooks/{Ид}", Метод = "get, put, delete")
&Операция(Сводка = "Подписка сверху для пакета (GET); поправка (PUT); снятие поправки (DELETE)",
	Описание = "PUT ставит поправку целиком: `mute`, `events` — оставленные события, `tags` — имена
	|из тегов пакета. Саму подписку поправка не меняет. Нужно право изменения пакета.")
&Возвращает(Код = 200, Описание = "Подписка сверху с поправкой пакета")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`")
&Возвращает(Код = 404, Описание = "`subscription_not_found`, `pool_not_found`, `package_not_found`")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`invalid_amendment` — поправка не принята")
Процедура ПодпискаСверхуПакета(Ответ, Пул, Имя, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса,
	МетодЗапроса, ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Объект = ОбъектПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Объект <> Неопределено Тогда
		ОднаСверху(Ответ, Объект, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Набор(Ответ, Знач Объект, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач ТелоЗапроса, Знач МетодЗапроса, Знач page, Знач pageSize)

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Пользователь = Допуск.ТребоватьПользователя(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
		Если Пользователь <> Неопределено Тогда
			Подписки.Список(Ответ, Пользователь, Объект, page, pageSize);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Маршрут.МетодНеРазрешён(Ответ, "GET, POST");
		Возврат;
	КонецЕсли;

	Мутация = ГейтМутации.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, ИмяПула);
	Если Мутация <> Неопределено Тогда
		Подписки.Создать(Ответ, Мутация.Пользователь, Объект, Мутация.Тело);
	КонецЕсли;

КонецПроцедуры

Процедура Одна(Ответ, Знач Объект, Знач ИмяПула, Знач Ид, Знач ЗаголовкиЗапроса,
	Знач КукиЗапроса, Знач ТелоЗапроса, Знач МетодЗапроса)

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Пользователь = Допуск.ТребоватьПользователя(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
		Если Пользователь <> Неопределено Тогда
			Подписки.Карточка(Ответ, Пользователь, Объект, Ид);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Правка = HTTP.ЭтоМетод(МетодЗапроса, "PATCH");
	Если НЕ Правка И НЕ HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		Маршрут.МетодНеРазрешён(Ответ, "GET, PATCH, DELETE");
		Возврат;
	КонецЕсли;

	Мутация = ГейтМутации.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, ИмяПула);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Правка Тогда
		Подписки.Правка(Ответ, Мутация.Пользователь, Объект, Ид, Мутация.Тело);
	Иначе
		Подписки.Удаление(Ответ, Мутация.Пользователь, Объект, Ид);
	КонецЕсли;

КонецПроцедуры

Процедура ДеревоПолучателей(Ответ, Знач Объект, Знач ИмяПула, Знач Ид, Знач ЗаголовкиЗапроса,
	Знач КукиЗапроса, Знач ТелоЗапроса, Знач МетодЗапроса)

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Пользователь = Допуск.ТребоватьПользователя(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
		Если Пользователь <> Неопределено Тогда
			Получатели.Дерево(Ответ, Пользователь, Объект, Ид);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "PUT") Тогда
		Маршрут.МетодНеРазрешён(Ответ, "GET, PUT");
		Возврат;
	КонецЕсли;

	Мутация = ГейтМутации.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, ИмяПула);
	Если Мутация <> Неопределено Тогда
		Получатели.Заменить(Ответ, Мутация.Пользователь, Объект, Ид, Мутация.Тело);
	КонецЕсли;

КонецПроцедуры

Процедура ДеревоПоправки(Ответ, Знач Объект, Знач ИмяПула, Знач Ид, Знач ЗаголовкиЗапроса,
	Знач КукиЗапроса, Знач ТелоЗапроса, Знач МетодЗапроса)

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Пользователь = Допуск.ТребоватьПользователя(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
		Если Пользователь <> Неопределено Тогда
			Получатели.ДеревоПоправки(Ответ, Пользователь, Объект, Ид);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "PUT") Тогда
		Маршрут.МетодНеРазрешён(Ответ, "GET, PUT");
		Возврат;
	КонецЕсли;

	Мутация = ГейтМутации.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, ИмяПула);
	Если Мутация <> Неопределено Тогда
		Получатели.ЗаменитьВПоправке(Ответ, Мутация.Пользователь, Объект, Ид, Мутация.Тело);
	КонецЕсли;

КонецПроцедуры

Процедура СписокСверху(Ответ, Знач Объект, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач page, Знач pageSize)

	Пользователь = Допуск.ТребоватьПользователя(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Пользователь <> Неопределено Тогда
		Поправки.Список(Ответ, Пользователь, Объект, ИмяПула, page, pageSize);
	КонецЕсли;

КонецПроцедуры

Процедура ОднаСверху(Ответ, Знач Объект, Знач ИмяПула, Знач Ид, Знач ЗаголовкиЗапроса,
	Знач КукиЗапроса, Знач ТелоЗапроса, Знач МетодЗапроса)

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Пользователь = Допуск.ТребоватьПользователя(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
		Если Пользователь <> Неопределено Тогда
			Поправки.Карточка(Ответ, Пользователь, Объект, ИмяПула, Ид);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Постановка = HTTP.ЭтоМетод(МетодЗапроса, "PUT");
	Если НЕ Постановка И НЕ HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		Маршрут.МетодНеРазрешён(Ответ, "GET, PUT, DELETE");
		Возврат;
	КонецЕсли;

	Мутация = ГейтМутации.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, ИмяПула);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Постановка Тогда
		Поправки.Поставить(Ответ, Мутация.Пользователь, Объект, ИмяПула, Ид, Мутация.Тело);
	Иначе
		Поправки.Снять(Ответ, Мутация.Пользователь, Объект, ИмяПула, Ид);
	КонецЕсли;

КонецПроцедуры

// Закрытый пул и несуществующий одинаково дают 404; право спрашивает сервис подписок.
Функция ОбъектПула(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса)

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	Пул = ?(ЭтоЧтение(МетодЗапроса),
		Двери.ВидимыйПул(Ответ, ИмяПула, Принципал),
		Двери.ПулМутации(Ответ, ИмяПула, Принципал));
	Возврат ?(Пул = Неопределено, Неопределено, Сервис.ОбъектПула(Пул));

КонецФункции

Функция ОбъектПакета(Ответ, Знач ИмяПула, Знач ИмяПакета, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач МетодЗапроса)

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	Найденное = ?(ЭтоЧтение(МетодЗапроса),
		Двери.ВидимыйПакет(Ответ, ИмяПула, ИмяПакета, Принципал),
		Двери.ПакетМутации(Ответ, ИмяПула, ИмяПакета, Принципал));
	Возврат ?(Найденное = Неопределено, Неопределено, Сервис.ОбъектПакета(Найденное.Пакет));

КонецФункции

// Маршрут обслуживает чтение и мутацию одним обработчиком и открывает пул раньше метода.
Функция ЭтоЧтение(Знач МетодЗапроса)
	Возврат HTTP.ЭтоМетод(МетодЗапроса, "GET");
КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
&Группа("Подписки", Описание = "Уведомления о событиях хаба, пула или пакета вебхуком или в Telegram;
	|поля типов доставки — в `/api/v1/webhook-meta`.")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "МаршрутAPI") _Маршрут,
	&Пластилин(Значение = "ДопускAPI") _Допуск,
	&Пластилин(Значение = "ГейтМутацииAPI") _ГейтМутации,
	&Пластилин(Значение = "ДвериAPI") _Двери,
	&Пластилин(Значение = "ПодпискиAPI") _Подписки,
	&Пластилин(Значение = "ПоправкиПодписокAPI") _Поправки,
	&Пластилин(Значение = "ПолучателиПодписокAPI") _Получатели,
	&Пластилин(Значение = "СервисПодписок") _Сервис,
	&Пластилин(Значение = "МетодыHTTP") _HTTP)

	Маршрут = _Маршрут;
	Допуск = _Допуск;
	ГейтМутации = _ГейтМутации;
	Двери = _Двери;
	Подписки = _Подписки;
	Поправки = _Поправки;
	Получатели = _Получатели;
	Сервис = _Сервис;
	HTTP = _HTTP;

КонецПроцедуры
