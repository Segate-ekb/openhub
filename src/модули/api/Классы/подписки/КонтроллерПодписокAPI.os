//  pageSize - Строка - размер страницы (необязательный, по умолчанию — весь список
//             до потолка выдачи).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/inherited-webhooks", Метод = "get")
&Операция(Сводка = "Подписки сверху пула",
	Описание = "Подписки хаба, которые их хозяин разрешил сужать, и поправка пула к каждой; адресов
	|и секретов нет. Нужно право удаления на пуле.")
&Возвращает(Код = 200, Описание = "Подписки сверху")
