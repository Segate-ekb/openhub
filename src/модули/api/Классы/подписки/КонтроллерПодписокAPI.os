// Подписки хаба, пула и пакета в API — то же, что раздел «Подписки» домов настроек: подписки,
// их дерево получателей и подписки сверху с поправками нижестоящего объекта. Действия —
// ПодпискиAPI, ПолучателиПодписокAPI и ПоправкиПодписокAPI.

Перем Маршрут;      // МаршрутAPI (протоколAPI)
Перем Допуск;       // ДопускAPI (api)
Перем ГейтМутации;  // ГейтМутацииAPI (api)
Перем Двери;        // ДвериAPI (api)
Перем Подписки;     // ПодпискиAPI (api)
Перем Поправки;     // ПоправкиПодписокAPI (api)
Перем Получатели;   // ПолучателиПодписокAPI (api)
Перем Сервис;       // СервисПодписок (подписки)
Перем HTTP;         // МетодыHTTP (основа)

#Область ТочкиМаршрута

// Справочник подписок.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("webhook-meta", Метод = "get")
&Операция(Сводка = "Справочник подписок",
	Описание = "Типы событий и типы доставки с их полями; значений секретов в справочнике нет.")
&Возвращает(Код = 200, Описание = "Справочник событий и типов доставки")
&Возвращает(Код = 404, Описание = "`unknown_path` — лишние сегменты адреса")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
Процедура Справочник(Ответ, МетодЗапроса, ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.НачатьЧтение(Ответ, ПараметрыЗапросаПорядковые, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;
	Подписки.Справочник(Ответ);

КонецПроцедуры

// Подписки хаба: список и заведение.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для POST.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и POST.
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию — весь список
//             до потолка выдачи).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("webhooks", Метод = "get, post")
&Операция(Сводка = "Подписки хаба (GET); заведение подписки (POST)",
	Описание = "GET — подписки хаба, POST — заводит подписку; секрет подписи показывается только
	|в ответе POST. Отбора по тегам (`tags`) у подписки хаба нет. Только администратор хаба.")
&Возвращает(Код = 200, Описание = "GET: подписки хаба")
&Возвращает(Код = 201, Описание = "POST: подписка и её секрет")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 404, Описание = "`unknown_path` — лишние сегменты адреса")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`invalid_subscription` — подписка не принята")
Процедура ПодпискиХаба(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	page = "", pageSize = "", ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Набор(Ответ, Сервис.ОбъектХаба(), "", ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
		page, pageSize);

КонецПроцедуры

// Подписка хаба: карточка, правка и удаление.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Ид - Строка - идентификатор подписки из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для PATCH и DELETE.
//  МетодЗапроса - Строка - метод запроса; допустимы GET, PATCH и DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("webhooks/{Ид}", Метод = "get, patch, delete")
&Операция(Сводка = "Подписка хаба (GET); правка подписки (PATCH); удаление подписки (DELETE)",
	Описание = "GET — подписка, PATCH — правит присланное (прочее, включая пороги,
	|остаётся), DELETE — удаляет. Только администратор хаба.")
&Возвращает(Код = 200, Описание = "Подписка; DELETE: подписка удалена")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 404, Описание = "`subscription_not_found` — подписки нет")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`invalid_subscription` — правка или удаление не прошли")
Процедура ПодпискаХаба(Ответ, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Одна(Ответ, Сервис.ОбъектХаба(), "", Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса);

КонецПроцедуры

// Дерево получателей подписки хаба: чтение и замена исключений.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Ид - Строка - идентификатор подписки из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для PUT.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и PUT.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("webhooks/{Ид}/recipients", Метод = "get, put")
&Операция(Сводка = "Получатели подписки хаба (GET); замена исключений (PUT)",
	Описание = "Пулы хаба, включая приватные, и их пакеты с отметкой исключения. PUT заменяет исключения:
	|`excluded_pools` — пулы, `excluded_packages` — «пул/пакет». Только администратор хаба.")
&Возвращает(Код = 200, Описание = "Дерево получателей")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`")
&Возвращает(Код = 404, Описание = "`subscription_not_found` — подписки нет")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`invalid_recipients` — пула или пакета нет")
Процедура ПолучателиПодпискиХаба(Ответ, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	ДеревоПолучателей(Ответ, Сервис.ОбъектХаба(), "", Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса,
		МетодЗапроса);

КонецПроцедуры

// Подписки пула: список и заведение.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для POST.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и POST.
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию — весь список
//             до потолка выдачи).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/webhooks", Метод = "get, post")
&Операция(Сводка = "Подписки пула (GET); заведение подписки (POST)",
	Описание = "GET — подписки пула, POST — заводит подписку; секрет подписи показывается только
	|в ответе POST. `tags` — имена из тегов пула. Нужно право удаления на пуле.")
&Возвращает(Код = 200, Описание = "GET: подписки пула")
&Возвращает(Код = 201, Описание = "POST: подписка и её секрет")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`")
&Возвращает(Код = 404, Описание = "`pool_not_found` — пула нет")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`invalid_subscription` — подписка не принята")
Процедура ПодпискиПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	page = "", pageSize = "", ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Объект = ОбъектПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Объект <> Неопределено Тогда
		Набор(Ответ, Объект, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
			page, pageSize);
	КонецЕсли;

КонецПроцедуры

// Подписка пула: карточка, правка и удаление.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Ид - Строка - идентификатор подписки из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для PATCH и DELETE.
//  МетодЗапроса - Строка - метод запроса; допустимы GET, PATCH и DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/webhooks/{Ид}", Метод = "get, patch, delete")
&Операция(Сводка = "Подписка пула (GET); правка подписки (PATCH); удаление подписки (DELETE)",
	Описание = "GET — подписка, PATCH — правит присланное (прочее, включая пороги,
	|остаётся), DELETE — удаляет. Нужно право удаления на пуле.")
&Возвращает(Код = 200, Описание = "Подписка; DELETE: подписка удалена")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`")
&Возвращает(Код = 404, Описание = "`subscription_not_found`, `pool_not_found`")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`invalid_subscription` — правка или удаление не прошли")
Процедура ПодпискаПула(Ответ, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Объект = ОбъектПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Объект <> Неопределено Тогда
		Одна(Ответ, Объект, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса);
	КонецЕсли;

КонецПроцедуры

// Дерево получателей подписки пула: чтение и замена исключений.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Ид - Строка - идентификатор подписки из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для PUT.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и PUT.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/webhooks/{Ид}/recipients", Метод = "get, put")
&Операция(Сводка = "Получатели подписки пула (GET); замена исключений (PUT)",
	Описание = "Пакеты пула с отметкой исключения. PUT заменяет исключения: `excluded_packages` — имена
	|пакетов. Нужно право удаления на пуле.")
&Возвращает(Код = 200, Описание = "Дерево получателей")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`")
&Возвращает(Код = 404, Описание = "`subscription_not_found`, `pool_not_found`")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`invalid_recipients` — пакета нет")
Процедура ПолучателиПодпискиПула(Ответ, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Объект = ОбъектПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Объект <> Неопределено Тогда
		ДеревоПолучателей(Ответ, Объект, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса);
	КонецЕсли;

КонецПроцедуры

// Подписки пакета: список и заведение.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для POST.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и POST.
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию — весь список
//             до потолка выдачи).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/webhooks", Метод = "get, post")
&Операция(Сводка = "Подписки пакета (GET); заведение подписки (POST)",
	Описание = "GET — подписки пакета, POST — заводит подписку; секрет подписи показывается только
	|в ответе POST. `tags` — имена из тегов пакета. Нужно право изменения пакета.")
&Возвращает(Код = 200, Описание = "GET: подписки пакета")
&Возвращает(Код = 201, Описание = "POST: подписка и её секрет")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`")
&Возвращает(Код = 404, Описание = "`pool_not_found`, `package_not_found`")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`invalid_subscription` — подписка не принята")
Процедура ПодпискиПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	page = "", pageSize = "", ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Объект = ОбъектПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Объект <> Неопределено Тогда
		Набор(Ответ, Объект, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
			page, pageSize);
	КонецЕсли;

КонецПроцедуры

// Подписка пакета: карточка, правка и удаление.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  Ид - Строка - идентификатор подписки из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для PATCH и DELETE.
//  МетодЗапроса - Строка - метод запроса; допустимы GET, PATCH и DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/webhooks/{Ид}", Метод = "get, patch, delete")
&Операция(Сводка = "Подписка пакета (GET); правка подписки (PATCH); удаление подписки (DELETE)",
	Описание = "GET — подписка, PATCH — правит присланное (прочее, включая пороги,
	|остаётся), DELETE — удаляет. Нужно право изменения пакета.")
&Возвращает(Код = 200, Описание = "Подписка; DELETE: подписка удалена")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`")
&Возвращает(Код = 404, Описание = "`subscription_not_found`, `pool_not_found`, `package_not_found`")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`invalid_subscription` — правка или удаление не прошли")
Процедура ПодпискаПакета(Ответ, Пул, Имя, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса,
	МетодЗапроса, ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Объект = ОбъектПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Объект <> Неопределено Тогда
		Одна(Ответ, Объект, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса);
	КонецЕсли;

КонецПроцедуры

