// Подписки сверху нижестоящего объекта в API: список, карточка, поправка и её снятие. Права —
// те же, что на подписки самого объекта; подписка без разрешения сужать отвечает 404.

Перем Ответы;        // ОтветыAPI (основа)
Перем Запрос;        // ЗапросAPI (протоколAPI)
Перем Сервис;        // СервисПодписок (подписки) — право распоряжаться подписками объекта
Перем Поправки;      // СервисПоправокПодписок (подписки)
Перем Представление; // ПредставлениеПодпискиAPI (api)
Перем Страницы;      // СтраницыAPI (протоколAPI)
Перем Ошибки;        // ТекстОшибки (основа) — причина отказа без служебного хвоста
Перем Числа;         // ПриведениеЧисел (основа)

#Область ПубличныйИнтерфейс

// Подписки сверху объекта с его поправками. 403, если пользователь не вправе распоряжаться
// подписками объекта.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//  Объект - Структура - описание нижестоящего объекта.
//  ИмяПула - Строка - пул объекта.
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию — весь список
//             до потолка выдачи).
//
Процедура Список(Ответ, Знач Пользователь, Знач Объект, Знач ИмяПула, Знач page = "",
	Знач pageSize = "") Экспорт

	Если НЕ ТребоватьУправление(Ответ, Пользователь, Объект) Тогда
		Возврат;
	КонецЕсли;

	Элементы = Новый Массив();
	Для Каждого Подписка Из Поправки.ПодпискиСверху(Объект) Цикл
		Элементы.Добавить(Представление.Сверху(Подписка, Поправки.ПоправкаОбъекта(Объект, Подписка), ИмяПула));
	КонецЦикла;
	Ответы.JSON(Ответ, 200, Страницы.Перечень(Элементы, page, pageSize));

КонецПроцедуры

// Подписка сверху с поправкой объекта. Невидимая объекту подписка — 404.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//  Объект - Структура - описание нижестоящего объекта.
//  ИмяПула - Строка - пул объекта.
//  Ид - Строка, Число - идентификатор подписки из адреса.
//
Процедура Карточка(Ответ, Знач Пользователь, Знач Объект, Знач ИмяПула, Знач Ид) Экспорт

	Если НЕ ТребоватьУправление(Ответ, Пользователь, Объект) Тогда
		Возврат;
	КонецЕсли;
	Подписка = ПодпискаСверху(Ответ, Объект, Ид);
	Если Подписка <> Неопределено Тогда
		ОтдатьПодписку(Ответ, Подписка, Поправки.ПоправкаОбъекта(Объект, Подписка), ИмяПула);
	КонецЕсли;

КонецПроцедуры

// Ставит поправку объекта к подписке сверху целиком: поле, которого в теле нет, берёт
// умолчание — присылать, все события подписки, без своего отбора.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь - субъект запроса.
//  Объект - Структура - описание нижестоящего объекта.
//  ИмяПула - Строка - пул объекта.
//  Ид - Строка, Число - идентификатор подписки из адреса.
//  Тело - Соответствие - разобранное тело: mute, events (строка через запятую либо массив), tags
//         (массив имён из тегов объекта).
//
Процедура Поставить(Ответ, Знач Пользователь, Знач Объект, Знач ИмяПула, Знач Ид, Знач Тело) Экспорт

	Если НЕ ТребоватьУправление(Ответ, Пользователь, Объект) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Итог = Поправки.Поставить(Пользователь, Объект, Числа.ЧислоИлиНоль(Ид), СужениеИзТела(Тело));
	Исключение
		Текст = Ошибки.ДляЧеловека(ИнформацияОбОшибке());
		Ответы.Сбой(Ответ, 422, "invalid_amendment",
			?(ЗначениеЗаполнено(Текст), Текст, "Поправка не принята: проверьте события и теги"),
			ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Если Итог = Неопределено Тогда
		НеНайдено(Ответ);
		Возврат;
	КонецЕсли;
	ОтдатьПодписку(Ответ, Итог.Подписка, Итог.Поправка, ИмяПула);

КонецПроцедуры

// Снимает поправку объекта к подписке сверху.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь - субъект запроса.
//  Объект - Структура - описание нижестоящего объекта.
//  ИмяПула - Строка - пул объекта.
//  Ид - Строка, Число - идентификатор подписки из адреса.
//
Процедура Снять(Ответ, Знач Пользователь, Знач Объект, Знач ИмяПула, Знач Ид) Экспорт

	Если НЕ ТребоватьУправление(Ответ, Пользователь, Объект) Тогда
		Возврат;
	КонецЕсли;
	Подписка = ПодпискаСверху(Ответ, Объект, Ид);
	Если Подписка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Поправки.Снять(Пользователь, Объект, Подписка.Идентификатор);
	ОтдатьПодписку(Ответ, Подписка, Неопределено, ИмяПула);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТребоватьУправление(Ответ, Знач Пользователь, Знач Объект)

	Если Сервис.МожетУправлять(Пользователь, Объект) Тогда
		Возврат Истина;
	КонецЕсли;
	Ответы.Ошибка(Ответ, 403, "forbidden", "Недостаточно прав для управления подписками объекта");
	Возврат Ложь;

КонецФункции

Функция ПодпискаСверху(Ответ, Знач Объект, Знач Ид)

	Подписка = Поправки.ПодпискаСверху(Объект, Числа.ЧислоИлиНоль(Ид));
	Если Подписка = Неопределено Тогда
		НеНайдено(Ответ);
	КонецЕсли;
	Возврат Подписка;

КонецФункции

Процедура ОтдатьПодписку(Ответ, Знач Подписка, Знач Поправка, Знач ИмяПула)
	Ответы.JSON(Ответ, 200, Новый Структура("subscription", Представление.Сверху(Подписка, Поправка, ИмяПула)));
КонецПроцедуры

Процедура НеНайдено(Ответ)
	Ответы.Ошибка(Ответ, 404, "subscription_not_found", "Подписки сверху с таким идентификатором у объекта нет");
КонецПроцедуры

// Поле, которого в теле нет, сервис читает умолчанием: поправка ставится целиком.
Функция СужениеИзТела(Знач Тело)

	Сужение = Новый Структура();
	НеПрисылать = Запрос.ПрисланныйФлаг(Тело, "не_присылать,mute");
	Если НеПрисылать <> Неопределено Тогда
		Сужение.Вставить("НеПрисылать", НеПрисылать);
	КонецЕсли;
	События = Запрос.Присланное(Тело, "события,events");
	Если События <> Неопределено Тогда
		Сужение.Вставить("ОставленныеСобытия", ?(ТипЗнч(События) = Тип("Массив"), СтрСоединить(События, ","),
			Строка(События)));
	КонецЕсли;
	Теги = Запрос.Присланное(Тело, "теги,tags");
	Если Теги <> Неопределено Тогда
		Сужение.Вставить("ОтборТегов", Теги);
	КонецЕсли;
	Возврат Сужение;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ЗапросAPI") _Запрос,
	&Пластилин(Значение = "СервисПодписок") _Сервис,
	&Пластилин(Значение = "СервисПоправокПодписок") _Поправки,
	&Пластилин(Значение = "ПредставлениеПодпискиAPI") _Представление,
	&Пластилин(Значение = "СтраницыAPI") _Страницы,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа)

	Ответы = _Ответы;
	Запрос = _Запрос;
	Сервис = _Сервис;
	Поправки = _Поправки;
	Представление = _Представление;
	Страницы = _Страницы;
	Ошибки = _Ошибки;
	Числа = _Числа;

КонецПроцедуры
