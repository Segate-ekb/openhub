// Право субъекта на объект: роль и действия.

&Сериализуемое("subject_type")
&Заполнено
&Тип("Строка")
&ОдинИз("пользователь", "группа")
Перем ТипСубъекта;

&Сериализуемое("subject_id")
&Заполнено
&Тип("Число")
Перем ИдСубъекта;

&Сериализуемое("subject")
&Заполнено
&Тип("Строка")
Перем Субъект;

&Сериализуемое("object_type")
&Заполнено
&Тип("Строка")
&ОдинИз("хаб", "пул", "пакет")
Перем ТипОбъекта;

&Сериализуемое("object_id")
&Заполнено
&Тип("Число")
Перем ИдОбъекта;

&Сериализуемое("object")
&Заполнено
&Тип("Строка")
Перем Объект;

&Сериализуемое("role")
&Заполнено
&Тип("Строка")
&ОдинИз("мейнтейнер", "райтер", "читатель", "")
Перем Роль;

&Сериализуемое("actions")
&Заполнено
&Тип("ДействияПраваJSON")
Перем Действия;

&Сериализуемое("granted_by")
&Заполнено
&Тип("Число")
Перем ВыдалИд;

&Сериализуемое("granted")
&Заполнено
&Тип("Строка")
Перем Выдано;
