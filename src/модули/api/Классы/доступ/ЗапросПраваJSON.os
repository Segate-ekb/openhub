// Тело выдачи и отзыва права на пул или его пакет.

&Сериализуемое("package")
&Тип("Строка")
Перем Пакет;

&Сериализуемое("subject_type")
&Тип("Строка")
&ОдинИз("пользователь", "группа")
Перем ТипСубъекта;

&Сериализуемое("subject")
&Заполнено
&Тип("Строка")
Перем Субъект;

&Сериализуемое("role")
&Тип("Строка")
Перем Роль;
