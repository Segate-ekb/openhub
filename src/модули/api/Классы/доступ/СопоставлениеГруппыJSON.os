// Сопоставление клейма OIDC с группой.

&Сериализуемое("id")
&Заполнено
&Тип("Число")
Перем Ид;

&Сериализуемое("group_id")
&Заполнено
&Тип("Число")
Перем ИдГруппы;

&Сериализуемое("group")
&Заполнено
&Тип("Строка")
Перем Группа;

&Сериализуемое("issuer")
&Заполнено
&Тип("Строка")
Перем Издатель;

&Сериализуемое("claim")
&Заполнено
&Тип("Строка")
Перем Клейм;

&Сериализуемое("value")
&Заполнено
&Тип("Строка")
Перем Значение;
