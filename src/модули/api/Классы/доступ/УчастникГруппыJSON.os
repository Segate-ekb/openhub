// BSLLS:MissingVariablesDescription-off
&Сериализуемое("user_id")
&Заполнено
&Тип("Число")
Перем ИдПользователя;

&Сериализуемое("login")
&Заполнено
&Тип("Строка")
Перем Логин;

&Сериализуемое("source")
&Заполнено
&Тип("Строка")
&ОдинИз("local", "oidc")
Перем Источник;
// BSLLS:MissingVariablesDescription-on
