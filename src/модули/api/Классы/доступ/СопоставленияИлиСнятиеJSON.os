// Ответ 200 адреса сопоставлений группы: страница с политикой на чтение, итог снятия на удаление.

&Сериализуемое("items")
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("СопоставлениеГруппыJSON")
Перем Элементы;

&Сериализуемое("page")
&Тип("Число")
Перем Номер;

&Сериализуемое("pageSize")
&Тип("Число")
Перем Размер;

&Сериализуемое("total")
&Тип("Число")
Перем Всего;

&Сериализуемое("has_more")
&Тип("Булево")
Перем ЕстьЕщё;

&Сериализуемое("policy")
&Тип("Строка")
&ОдинИз("исключать", "оставлять")
Перем Политика;

&Сериализуемое("removed")
&Тип("Булево")
Перем Снято;
