// Как пул выглядит наружу в JSON: карточка пула и его настройки. Природа пула — тип
// и видимость — общая у обеих форм, поэтому обе собирает один класс: разойдись они,
// один и тот же пул отвечал бы на двух ручках по-разному.

Перем Моменты;   // МоментISO (основа) — одно написание времени в ответе

#Область ПубличныйИнтерфейс

// Карточка пула для ручек /pools.
//
// Параметры:
//  Пул - Пул - запись пула.
//
// Возвращаемое значение:
//  Структура - тело карточки.
//
Функция Карточка(Знач Пул) Экспорт

	Структура = Новый Структура();
	Структура.Вставить("id", Пул.Идентификатор);
	Структура.Вставить("name", Пул.Имя);
	ДобавитьПрироду(Структура, Пул);
	Структура.Вставить("default", Пул.ЭтоДефолтный());
	Структура.Вставить("owner_id", Пул.ВладелецИдентификатор);
	Структура.Вставить("created", Моменты.Строкой(Пул.Создан));
	Возврат Структура;

КонецФункции

// Настройки пула для ручек /pools/{имя}/settings: то, чем распоряжается администратор.
//
// Параметры:
//  Пул - Пул - запись пула.
//
// Возвращаемое значение:
//  Структура - тело настроек.
//
Функция Настройки(Знач Пул) Экспорт

	Структура = Новый Структура();
	Структура.Вставить("pool", Строка(Пул.Имя));
	ДобавитьПрироду(Структура, Пул);
	Структура.Вставить("quota_mb", Цел(Пул.КвотаМб));
	Структура.Вставить("publish_allowed", Пул.ПубликацияРазрешена = Истина);
	Структура.Вставить("upstreams_allowed", Пул.АпстримыДопустимы());
	Возврат Структура;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Природа пула читается одинаково обеими ручками: тип и видимость.
Процедура ДобавитьПрироду(Структура, Знач Пул)
	Структура.Вставить("type", Строка(Пул.Тип));
	Структура.Вставить("visibility", Строка(Пул.Видимость));
КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "МоментISO") _Моменты = Неопределено)
	Моменты = ?(_Моменты = Неопределено, Новый МоментISO(), _Моменты);
КонецПроцедуры
