// Чистый разбор запроса артефакта: имя .ospx-файла относительно имени пакета плюс
// спецификация версии, если клиент прислал её параметром. Без БД и HTTP.
// Контракт opm: "{name}.ospx" — версия основного тега, "{name}-{спец}.ospx" — спецификация
// в версионном слоте имени. Имя пакета сравнивается регистронезависимо, спецификация
// берётся из исходного имени файла: "1.2.3-RC.1" и "1.2.3-rc.1" — разные версии.

// Разбирает запрошенное имя файла артефакта относительно имени пакета.
//
// Параметры:
//  ИмяПакета - Строка - имя пакета в любом регистре.
//  ИмяФайла - Строка - запрошенное имя файла, последний сегмент URL.
//  Спецификация - Строка - спецификация версии из параметра запроса; пустая означает,
//                 что клиент её не назвал (необязательный, по умолчанию пустая строка).
//
// Возвращаемое значение:
//  Структура, Неопределено - БезСпецификации (Булево, спецификации нет вовсе) и
//  Спецификация (Строка, пустая при БезСпецификации); Неопределено, если имя файла
//  не относится к этому пакету.
//
Функция РазобратьЗапросФайла(Знач ИмяПакета, Знач ИмяФайла, Знач Спецификация = "") Экспорт

	Если НЕ ЗначениеЗаполнено(ИмяПакета) ИЛИ НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Расширение = ".ospx";
	Если НЕ СтрЗаканчиваетсяНа(НРег(ИмяФайла), Расширение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	База = Лев(ИмяФайла, СтрДлина(ИмяФайла) - СтрДлина(Расширение));
	Названная = СокрЛП(Строка(Спецификация));

	Если НРег(База) = НРег(ИмяПакета) Тогда
		// версионного слота нет: спецификацию мог назвать только параметр
		Возврат Запрос(ПустаяСтрока(Названная), Названная);
	КонецЕсли;

	Префикс = ИмяПакета + "-";
	Если СтрДлина(База) > СтрДлина(Префикс)
		И НРег(Лев(База, СтрДлина(Префикс))) = НРег(Префикс) Тогда

		ИзИмениФайла = Сред(База, СтрДлина(Префикс) + 1);
		Если ПустаяСтрока(ИзИмениФайла) Тогда
			Возврат Неопределено;
		КонецЕсли;

		// параметр главнее: версионный слот имени — легаси-подсказка того же запроса,
		// и старый клиент вклеивает в него ровно то, что новый шлёт параметром
		Возврат Запрос(Ложь, ?(ПустаяСтрока(Названная), ИзИмениФайла, Названная));

	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция Запрос(Знач БезСпецификации, Знач Спецификация)
	Возврат Новый Структура("БезСпецификации, Спецификация", БезСпецификации, Спецификация);
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
