// Канонический адрес выдачи артефакта — тот же, что читает opm. Формы различаются тем,
// когда хаб выбирает версию: названа она в адресе или выбирается в момент запроса.

#Область ПубличныйИнтерфейс

// Адрес точной версии: по нему всегда лежит один и тот же файл.
//
// Параметры:
//  ИмяПула   - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//  Версия    - Строка - строка версии.
//
// Возвращаемое значение:
//  Строка - путь артефакта от корня хаба.
//
Функция ТочнаяВерсия(Знач ИмяПула, Знач ИмяПакета, Знач Версия) Экспорт
	Возврат АдресАртефакта(ИмяПула, ИмяПакета, Версия);
КонецФункции

// Адрес версии по тегу: версию хаб выбирает в момент запроса, поэтому переведённый
// на другую версию канал отдаёт по тому же адресу другой файл.
//
// Параметры:
//  ИмяПула   - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//  ИмяТега   - Строка - имя тега-канала.
//
// Возвращаемое значение:
//  Строка - путь артефакта от корня хаба.
//
Функция ПоТегу(Знач ИмяПула, Знач ИмяПакета, Знач ИмяТега) Экспорт
	Возврат АдресАртефакта(ИмяПула, ИмяПакета, ИмяТега);
КонецФункции

// Адрес без координаты: отдаёт то же, что ставит `opm install <имя>` — версию основного
// тега пакета на момент запроса.
//
// Параметры:
//  ИмяПула   - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Строка - путь артефакта от корня хаба.
//
Функция ОсновнойТег(Знач ИмяПула, Знач ИмяПакета) Экспорт
	Возврат АдресАртефакта(ИмяПула, ИмяПакета, "");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АдресАртефакта(Знач ИмяПула, Знач ИмяПакета, Знач Координата)

	ПутьПакета = Сегмент(ИмяПакета);

	Возврат СтрШаблон("/api/v1/pools/%1/download/%2/%2%3.ospx",
		Сегмент(ИмяПула), ПутьПакета, ВерсионныйСлот(Координата));

КонецФункции

// Слот имени файла, из которого opm называет координату: без неё имя файла — одно имя пакета.
Функция ВерсионныйСлот(Знач Координата)
	Возврат ?(ЗначениеЗаполнено(Координата), "-" + Сегмент(Координата), "");
КонецФункции

// Имя пакета и координата приходят от человека: в путь они попадают кодированными.
Функция Сегмент(Знач Значение)
	Возврат КодироватьСтроку(Строка(Значение), СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
