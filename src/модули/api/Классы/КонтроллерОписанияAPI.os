// GET /api/v1/openapi.json — машиночитаемое описание API хаба. Документ собирается
// из Соответствий, а не Структур: ключи-пути и коды ответов не являются идентификаторами BSL.

Перем Ответы;              // ОтветыAPI (auth)
Перем ОписаниеПриложения;  // ОписаниеПриложения (запуск)
Перем Таблица;             // ПутиОписанияAPI (api) — перечень адресов
Перем ПустыеКуки;          // Куки (winow)

#Область ТочкиМаршрута

// GET /api/v1/openapi.json — описание API хаба в формате OpenAPI 3.0.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//
&ТочкаМаршрута("openapi.json")
Процедура ОткрытоеОписание(Ответ, МетодЗапроса) Экспорт

	Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
	Если ВРег(Строка(МетодЗапроса)) <> "GET" Тогда
		Ответ.Заголовки["Allow"] = "GET";
		Ответы.Ошибка(Ответ, 405, "method_not_allowed", "Разрешён только метод GET");
		Возврат;
	КонецЕсли;

	Ответы.JSON(Ответ, 200, Документ());

КонецПроцедуры

#КонецОбласти

#Область СборкаДокумента

Функция Документ()

	Док = Новый Соответствие();
	Док.Вставить("openapi", "3.0.3");

	Инфо = Новый Соответствие();
	Инфо.Вставить("title", "OpenHub API v1");
	Инфо.Вставить("version", ОписаниеПриложения.Версия());
	Инфо.Вставить("description", "API хаба пакетов OneScript: пулы, пакеты, версии, теги, поиск,"
		+ " публикация, администрирование (апстримы, зеркала, группы, гранты, маппинг OIDC),"
		+ " а также выдача list.txt и .ospx для клиента opm."
		+ " Старые беспрефиксные адреса (/download, /dev-channel, /pools/{pool}/download,"
		+ " /push, /pools/{pool}/push) остаются вечными алиасами.");
	Док.Вставить("info", Инфо);

	Серверы = Новый Массив();
	СервЭлемент = Новый Соответствие();
	СервЭлемент.Вставить("url", "/api/v1");
	Серверы.Добавить(СервЭлемент);
	Док.Вставить("servers", Серверы);

	Док.Вставить("components", Компоненты());
	Док.Вставить("paths", Таблица.Пути());

	Возврат Док;

КонецФункции

Функция Компоненты()

	Компоненты = Новый Соответствие();

	Схемы = Новый Соответствие();
	Схемы.Вставить("Error", СхемаОшибки());
	Схемы.Вставить("Page", СхемаСтраницы());
	Схемы.Вставить("Pool", ОбъектСоСвойствами("id,name,type,visibility,owner_id,created"));
	Схемы.Вставить("Package", ОбъектСоСвойствами("id,name,pool,description,keywords,license,repository,deprecated,downloads,versions_total,latest_version,channels,maintainers"));
	Схемы.Вставить("Version", ОбъектСоСвойствами("version,sha256,size,yanked,published,semver,labels"));
	Компоненты.Вставить("schemas", Схемы);

	Безопасность = Новый Соответствие();
	БиррерСхема = Новый Соответствие();
	БиррерСхема.Вставить("type", "http");
	БиррерСхема.Вставить("scheme", "bearer");
	БиррерСхема.Вставить("description", "Personal Access Token (PAT). Для мутаций CSRF не требуется.");
	Безопасность.Вставить("bearerAuth", БиррерСхема);

	КукаСхема = Новый Соответствие();
	КукаСхема.Вставить("type", "apiKey");
	КукаСхема.Вставить("in", "cookie");
	КукаСхема.Вставить("name", "oshub_session");
	КукаСхема.Вставить("description", "Сессия. Для мутаций обязателен заголовок X-CSRF-Token либо поле _csrf.");
	Безопасность.Вставить("sessionCookie", КукаСхема);
	Компоненты.Вставить("securitySchemes", Безопасность);

	Возврат Компоненты;

КонецФункции

Функция СхемаОшибки()
	ПолеError = Новый Соответствие();
	ПолеError.Вставить("type", "object");
	СвойстваВнутр = Новый Соответствие();
	СвойстваВнутр.Вставить("code", ТипСтрока());
	СвойстваВнутр.Вставить("message", ТипСтрока());
	ПолеError.Вставить("properties", СвойстваВнутр);

	Свойства = Новый Соответствие();
	Свойства.Вставить("error", ПолеError);

	Схема = Новый Соответствие();
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Возврат Схема;
КонецФункции

Функция СхемаСтраницы()
	Свойства = Новый Соответствие();
	ЭлементыМассив = Новый Соответствие();
	ЭлементыМассив.Вставить("type", "array");
	ЭлементыМассив.Вставить("items", Новый Соответствие());
	Свойства.Вставить("items", ЭлементыМассив);
	Свойства.Вставить("page", ТипЦелое());
	Свойства.Вставить("pageSize", ТипЦелое());
	Свойства.Вставить("total", ТипЦелое());

	Схема = Новый Соответствие();
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Возврат Схема;
КонецФункции


#КонецОбласти

#Область КонструкторыФрагментов


Функция ОбъектСоСвойствами(Знач СписокПолей)
	Свойства = Новый Соответствие();
	Для Каждого Поле Из СтрРазделить(СписокПолей, ",") Цикл
		Свойства.Вставить(СокрЛП(Поле), Новый Соответствие()); // тип не детализируем
	КонецЦикла;
	Схема = Новый Соответствие();
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Возврат Схема;
КонецФункции

Функция ТипСтрока()
	Т = Новый Соответствие();
	Т.Вставить("type", "string");
	Возврат Т;
КонецФункции

Функция ТипЦелое()
	Т = Новый Соответствие();
	Т.Вставить("type", "integer");
	Возврат Т;
КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ОписаниеПриложения") _ОписаниеПриложения,
	&Пластилин(Значение = "ПутиОписанияAPI") _Таблица,
	&Пластилин(Значение = "Куки") _ПустыеКуки)

	Ответы = _Ответы;
	ОписаниеПриложения = _ОписаниеПриложения;
	Таблица = _Таблица;
	ПустыеКуки = _ПустыеКуки;

КонецПроцедуры
