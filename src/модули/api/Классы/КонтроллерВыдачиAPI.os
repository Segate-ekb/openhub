// Выдача пакетов в формате, который понимает opm: list.txt и .ospx, канонические адреса
// и вечные алиасы. Резолв «где взять артефакт» делегирован РезолверВыдачи, ответы stateless.

#Использовать errors

Перем РезолверВыдачи;      // РезолверВыдачи (прокси)
Перем РезолверФайла;       // РезолверФайлаПакета (api)
Перем СервисПулов;         // СервисПулов (реестр) - основной пул для вечных алиасов
Перем ПустыеКуки;          // Куки (winow) - пустая коллекция для снятия Set-Cookie
Перем Издатель;            // ИздательСобытий (события) - счёт скачиваний через событие
Перем ЧтениеПула;          // ГвардДоступаКПулу (права)
Перем Кэш;                 // ЗаголовкиКэша (основа) - что кэшу позволено с телом артефакта
&Лог
Перем Лог;
Перем Права;       // СервисПрав (права) — признак публичности пула
Перем Ошибки;      // ТекстОшибки (основа) — сбой строкой журнала и фразой для человека
Перем Хеши;        // Хеш (основа) — метка ответа по его телу

#Область ТочкиМаршрута

// GET|HEAD /api/v1/pools/{Пул}/download/list.txt — список пакетов пула.
// Это значение ПутьНаСервере в opm.cfg.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и HEAD.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//
&ТочкаМаршрута("api/v1/pools/{Пул}/download/list.txt")
Процедура СписокПула(Ответ, Пул, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса) Экспорт
	ВыдатьСписок(Ответ, Пул, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
КонецПроцедуры

// GET|HEAD /api/v1/pools/{Пул}/download/{пакет}/{файл} — артефакт пула по основному тегу.
// Имя файла без версионного слота отдаёт версию основного тега, со слотом — то, что
// названо спецификацией.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ИмяПакета - Строка - имя пакета из адреса.
//  ИмяФайла - Строка - имя файла .ospx либо sibling-подписи.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и HEAD.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  spec - Строка - спецификация версии: точная версия, имя тега либо выражение версии
//         (необязательный, по умолчанию пустая строка).
//
&ТочкаМаршрута("api/v1/pools/{Пул}/download/{ИмяПакета}/{ИмяФайла}")
Процедура ФайлПула(Ответ, Пул, ИмяПакета, ИмяФайла, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса,
	spec = "") Экспорт
	ВыдатьФайл(Ответ, Пул, БезКанала(), ИмяПакета, ИмяФайла, spec, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
КонецПроцедуры

// GET|HEAD /api/v1/pools/{Пул}/channels/{Канал}/download/list.txt — список пакетов пула;
// от канала он не зависит.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Канал - Строка - имя канала из адреса; на список не влияет.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и HEAD.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//
&ТочкаМаршрута("api/v1/pools/{Пул}/channels/{Канал}/download/list.txt")
Процедура СписокКанала(Ответ, Пул, Канал, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса) Экспорт
	ВыдатьСписок(Ответ, Пул, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
КонецПроцедуры

// GET|HEAD /api/v1/pools/{Пул}/channels/{Канал}/download/{пакет}/{файл} — артефакт пула
// в разрезе канала; имя канала резолвится как имя тега.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Канал - Строка - имя канала из адреса; влияет только на выбор последней версии.
//  ИмяПакета - Строка - имя пакета из адреса.
//  ИмяФайла - Строка - имя файла .ospx либо sibling-подписи.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и HEAD.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  spec - Строка - спецификация версии: точная версия, имя тега либо выражение версии
//         (необязательный, по умолчанию пустая строка).
//
&ТочкаМаршрута("api/v1/pools/{Пул}/channels/{Канал}/download/{ИмяПакета}/{ИмяФайла}")
Процедура ФайлКанала(Ответ, Пул, Канал, ИмяПакета, ИмяФайла, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса,
	spec = "") Экспорт
	ВыдатьФайл(Ответ, Пул, Канал, ИмяПакета, ИмяФайла, spec, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
КонецПроцедуры

#КонецОбласти

#Область ВечныеАлиасы

// Адреса ниже прописаны у пользователей в opm.cfg и не снимаются никогда. Каждый —
// тонкая обёртка над той же выдачей, что и канонический адрес выше.

// GET|HEAD /download/list.txt — алиас списка пула по умолчанию.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и HEAD.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//
&ТочкаМаршрута("/download/list.txt")
Процедура АлиасСписокПоУмолчанию(Ответ, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса) Экспорт
	ИмяПула = ИмяОсновногоПула(Ответ);
	Если ЗначениеЗаполнено(ИмяПула) Тогда
		ВыдатьСписок(Ответ, ИмяПула, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
	КонецЕсли;
КонецПроцедуры

// GET|HEAD /download/{пакет}/{файл} — алиас артефакта пула по умолчанию, основной тег.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ИмяПакета - Строка - имя пакета из адреса.
//  ИмяФайла - Строка - имя файла .ospx либо sibling-подписи.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и HEAD.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  spec - Строка - спецификация версии: точная версия, имя тега либо выражение версии
//         (необязательный, по умолчанию пустая строка).
//
&ТочкаМаршрута("download/{ИмяПакета}/{ИмяФайла}")
Процедура АлиасФайлПоУмолчанию(Ответ, ИмяПакета, ИмяФайла, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса,
	spec = "") Экспорт
	ИмяПула = ИмяОсновногоПула(Ответ);
	Если ЗначениеЗаполнено(ИмяПула) Тогда
		ВыдатьФайл(Ответ, ИмяПула, БезКанала(), ИмяПакета, ИмяФайла, spec, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
	КонецЕсли;
КонецПроцедуры

// GET|HEAD /dev-channel/list.txt — алиас списка пула по умолчанию.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и HEAD.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//
&ТочкаМаршрута("/dev-channel/list.txt")
Процедура АлиасСписокДевКанала(Ответ, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса) Экспорт
	ИмяПула = ИмяОсновногоПула(Ответ);
	Если ЗначениеЗаполнено(ИмяПула) Тогда
		ВыдатьСписок(Ответ, ИмяПула, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
	КонецЕсли;
КонецПроцедуры

// GET|HEAD /dev-channel/{пакет}/{файл} — алиас артефакта пула по умолчанию, канал dev.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ИмяПакета - Строка - имя пакета из адреса.
//  ИмяФайла - Строка - имя файла .ospx либо sibling-подписи.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и HEAD.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  spec - Строка - спецификация версии: точная версия, имя тега либо выражение версии
//         (необязательный, по умолчанию пустая строка).
//
&ТочкаМаршрута("dev-channel/{ИмяПакета}/{ИмяФайла}")
Процедура АлиасФайлДевКанала(Ответ, ИмяПакета, ИмяФайла, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса,
	spec = "") Экспорт
	ИмяПула = ИмяОсновногоПула(Ответ);
	Если ЗначениеЗаполнено(ИмяПула) Тогда
		ВыдатьФайл(Ответ, ИмяПула, "dev", ИмяПакета, ИмяФайла, spec, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
	КонецЕсли;
КонецПроцедуры

// GET|HEAD /pools/{Пул}/download/list.txt — алиас списка пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и HEAD.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//
&ТочкаМаршрута("pools/{Пул}/download/list.txt")
Процедура АлиасСписокПула(Ответ, Пул, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса) Экспорт
	ВыдатьСписок(Ответ, Пул, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
КонецПроцедуры

// GET|HEAD /pools/{Пул}/download/{пакет}/{файл} — алиас артефакта пула, основной тег.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ИмяПакета - Строка - имя пакета из адреса.
//  ИмяФайла - Строка - имя файла .ospx либо sibling-подписи.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и HEAD.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  spec - Строка - спецификация версии: точная версия, имя тега либо выражение версии
//         (необязательный, по умолчанию пустая строка).
//
&ТочкаМаршрута("pools/{Пул}/download/{ИмяПакета}/{ИмяФайла}")
Процедура АлиасФайлПула(Ответ, Пул, ИмяПакета, ИмяФайла, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса,
	spec = "") Экспорт
	ВыдатьФайл(Ответ, Пул, БезКанала(), ИмяПакета, ИмяФайла, spec, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
КонецПроцедуры

// GET|HEAD /pools/{Пул}/channels/{Канал}/download/list.txt — алиас списка пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Канал - Строка - имя канала из адреса; на список не влияет.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и HEAD.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//
&ТочкаМаршрута("pools/{Пул}/channels/{Канал}/download/list.txt")
Процедура АлиасСписокКанала(Ответ, Пул, Канал, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса) Экспорт
	ВыдатьСписок(Ответ, Пул, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
КонецПроцедуры

// GET|HEAD /pools/{Пул}/channels/{Канал}/download/{пакет}/{файл} — алиас артефакта пула
// в разрезе канала.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Канал - Строка - имя канала из адреса; влияет только на выбор последней версии.
//  ИмяПакета - Строка - имя пакета из адреса.
//  ИмяФайла - Строка - имя файла .ospx либо sibling-подписи.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и HEAD.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  spec - Строка - спецификация версии: точная версия, имя тега либо выражение версии
//         (необязательный, по умолчанию пустая строка).
//
&ТочкаМаршрута("pools/{Пул}/channels/{Канал}/download/{ИмяПакета}/{ИмяФайла}")
Процедура АлиасФайлКанала(Ответ, Пул, Канал, ИмяПакета, ИмяФайла, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса,
	spec = "") Экспорт
	ВыдатьФайл(Ответ, Пул, Канал, ИмяПакета, ИмяФайла, spec, МетодЗапроса, ЗаголовкиЗапроса, КукиЗапроса);
КонецПроцедуры

#КонецОбласти

#Область ОбщаяЛогикаОтдачи

// Имена пакетов пула, по одному на строку. Для proxy и group имена собирает резолвер.
Процедура ВыдатьСписок(Ответ, Знач ИмяПула, Знач МетодЗапроса, Знач ЗаголовкиЗапроса,
	Знач КукиЗапроса = Неопределено)

	БезСессионнойКуки(Ответ);

	Если НЕ ПулЧитаем(ЗаголовкиЗапроса, КукиЗапроса, ИмяПула) Тогда
		ОтдатьНеНайдено(Ответ, СтрШаблон("пул ""%1"" не найден", ИмяПула));
		Возврат;
	КонецЕсли;

	СписокПула = РезолверВыдачи.ИменаПула(ИмяПула);
	Если СписокПула = Неопределено Тогда
		ОтдатьНеНайдено(Ответ, СтрШаблон("пул ""%1"" не найден", ИмяПула));
		Возврат;
	КонецЕсли;

	// Детерминированный порядок даёт стабильный ETag; у Массива сортировки нет.
	СписокИмен = Новый СписокЗначений();
	Для Каждого Имя Из СписокПула.Имена Цикл
		СписокИмен.Добавить(Имя);
	КонецЦикла;
	СписокИмен.СортироватьПоЗначению();

	ПоследнееИзменение = СписокПула.ПоследнееИзменение;

	Имена = Новый Массив();
	Для Каждого ЭлементСписка Из СписокИмен Цикл
		Имена.Добавить(ЭлементСписка.Значение);
	КонецЦикла;

	Тело = СтрСоединить(Имена, Символы.ПС);
	ETag = КавычкамиETag(Sha256Строки(Тело));

	Если Кэш.СовпадаетETag(ЗаголовкиЗапроса, ETag) Тогда
		ОтдатьНеИзменено(Ответ, ETag);
		Возврат;
	КонецЕсли;

	// Пустой пул или пакеты без даты — за точку отсчёта берём текущее время.
	Если ПоследнееИзменение = Неопределено Тогда
		ПоследнееИзменение = ТекущаяУниверсальнаяДата();
	КонецЕсли;

	Ответ.УстановитьСостояниеОК();
	Ответ.Заголовки["Content-Type"] = "text/plain; charset=utf-8";
	Ответ.Заголовки["ETag"] = ETag;
	Ответ.Заголовки["Last-Modified"] = HTTPДата(ПоследнееИзменение);
	Ответ.Заголовки["Content-Length"] = Формат(РазмерТелаВБайтах(Тело), "ЧГ=0; ЧН=0");

	Если ЭтоHEAD(МетодЗапроса) Тогда
		Ответ.ТелоТекст = "";
	Иначе
		Ответ.ТелоТекст = Тело;
	КонецЕсли;

КонецПроцедуры

Процедура ВыдатьФайл(Ответ, Знач ИмяПула, Знач ИмяКанала, Знач ИмяПакета, Знач ИмяФайла,
	Знач Спецификация, Знач МетодЗапроса, Знач ЗаголовкиЗапроса, Знач КукиЗапроса = Неопределено)

	// Приватный пул — приватны все его артефакты. Гейт стоит до резолва,
	// а ответ тот же, что и для несуществующего пула.
	БезСессионнойКуки(Ответ);
	Лог.Отладка("Выдача HTTP: %1 пул ""%2"", пакет ""%3"", файл ""%4"", канал ""%5"", спецификация ""%6""",
		МетодЗапроса, ИмяПула, ИмяПакета, ИмяФайла, ИмяКанала, Спецификация);

	Если НЕ ПулЧитаем(ЗаголовкиЗапроса, КукиЗапроса, ИмяПула) Тогда
		Лог.Отладка("Выдача HTTP: пул ""%1"" запросившему не читаем — отвечаем как на несуществующий",
			ИмяПула);
		ОтдатьНеНайдено(Ответ, СтрШаблон("пул ""%1"" не найден", ИмяПула));
		Возврат;
	КонецЕсли;

	// Имя канала здесь не валидируется: это имя тега, его резолвит РезолверВыдачи.
	// Версионированный файл доступен по любому канальному пути — канал влияет только
	// на безверсионный запрос.
	Запрос = РезолверФайла.РазобратьЗапросФайла(ИмяПакета, ИмяФайла, Спецификация);
	Если Запрос = Неопределено Тогда
		Лог.Отладка("Выдача HTTP: имя файла ""%1"" не разбирается по пакету ""%2"" — 404 до резолва",
			ИмяФайла, ИмяПакета);
		ОтдатьНеНайдено(Ответ, СтрШаблон("имя файла ""%1"" не соответствует пакету ""%2""", ИмяФайла, ИмяПакета));
		Возврат;
	КонецЕсли;

	// Резолв ходит наружу и в БД. До него в Ответ ничего не записано, поэтому сбой безопасно
	// превращается в код отказа, а не в 500.
	Попытка
		Разрешение = РезолверВыдачи.РазрешитьФайл(ИмяПула, ИмяКанала, ИмяПакета, Запрос);
	Исключение
		ОтветитьНаСбойВыдачи(Ответ, ИнформацияОбОшибке(), ИмяПула, ИмяПакета, ИмяФайла);
		Возврат;
	КонецПопытки;

	Если НЕ Разрешение.Найдено Тогда
		ОтдатьНеНайдено(Ответ, ПояснениеОтказа(ИмяПула, ИмяКанала, ИмяПакета, ИмяФайла, Запрос));
		Возврат;
	КонецЕсли;

	ВыдатьРазрешённыйФайл(Ответ, ИмяПула, ИмяПакета, ИмяФайла, Разрешение, МетодЗапроса, ЗаголовкиЗапроса);

КонецПроцедуры

// Вид ответа решается здесь и только здесь: совпавшая метка — 304, HEAD — заголовки по записи
// версии, иначе — тело. Тело читается раньше заголовков, чтобы сбой чтения успел стать кодом отказа.
Процедура ВыдатьРазрешённыйФайл(Ответ, Знач ИмяПула, Знач ИмяПакета, Знач ИмяФайла, Знач Разрешение,
	Знач МетодЗапроса, Знач ЗаголовкиЗапроса)

	Версия = Разрешение.Версия;

	// Версионированные .ospx неизменяемы, поэтому совпадение ETag даёт 304.
	Если МеткаСовпала(Версия, ЗаголовкиЗапроса) Тогда
		ETag = КавычкамиETag(Версия.Sha256);
		Лог.Отладка("Выдача HTTP: ETag клиента совпал с %1 — 304, тело не отдаём", ETag);
		ПоставитьЗаголовкиВерсии(Ответ, ИмяПула, Разрешение);
		ОтдатьНеИзменено(Ответ, ETag);
		Возврат;
	КонецЕсли;

	Если ЭтоHEAD(МетодЗапроса) Тогда
		ПоставитьЗаголовкиАртефакта(Ответ, ИмяПула, Разрешение, Версия.Размер);
		// Native-сервер всегда пишет тело — для HEAD оставляем его пустым.
		Ответ.ТелоТекст = "";
		Возврат;
	КонецЕсли;

	Попытка
		Тело = РезолверВыдачи.Содержимое(Разрешение);
	Исключение
		ОтветитьНаСбойЧтения(Ответ, ИнформацияОбОшибке(), ИмяПула, ИмяПакета, ИмяФайла);
		Возврат;
	КонецПопытки;

	ПоставитьЗаголовкиАртефакта(Ответ, ИмяПула, Разрешение, Тело.Размер());
	Ответ.ТелоДвоичныеДанные = Тело;
	// Счёт скачивания — только на реальной отдаче тела, не на HEAD и не на 304.
	// Имя пула берётся у РАЗРЕШЕНИЯ, а не из адреса: в адресе оно в написании клиента,
	// и «PUBLIC» рассыпало бы разрез по пулу на ряд написаний одного пула.
	ЗафиксироватьСкачивание(Версия, Разрешение.ИмяПула);

КонецПроцедуры

// Отпечаток тела — sha256 из БД, им клиент сверяет скачанное. Его и директиву кэша несут
// все виды ответа: 200, HEAD и 304.
Процедура ПоставитьЗаголовкиВерсии(Ответ, Знач ИмяПула, Знач Разрешение)

	Если ЗначениеЗаполнено(Разрешение.Версия.Sha256) Тогда
		Ответ.Заголовки["X-Checksum-Sha256"] = НРег(Строка(Разрешение.Версия.Sha256));
	КонецЕсли;

	Ответ.Заголовки["Cache-Control"] = ДирективаКэшаАртефакта(ИмяПула, Разрешение.ВерсиюВыбралХаб);

КонецПроцедуры

// Размер называет вызывающий: у тела — его собственный, у HEAD — из записи версии.
Процедура ПоставитьЗаголовкиАртефакта(Ответ, Знач ИмяПула, Знач Разрешение, Знач РазмерБайт)

	Версия = Разрешение.Версия;
	ПоставитьЗаголовкиВерсии(Ответ, ИмяПула, Разрешение);

	Лог.Отладка("Выдача HTTP: отдаём ""%1"" из пула ""%2"", %3 байт, версию выбрал хаб: %4",
		Разрешение.ИмяАртефакта, ИмяПула, РазмерБайт, Разрешение.ВерсиюВыбралХаб);

	Ответ.УстановитьСостояниеОК();
	Ответ.Заголовки["Content-Type"] = "application/octet-stream";
	Ответ.Заголовки["Content-Length"] = Формат(РазмерБайт, "ЧГ=0; ЧН=0");
	Ответ.Заголовки["Content-Disposition"] = СтрШаблон("attachment; filename=""%1""", Разрешение.ИмяАртефакта);
	Если ЗначениеЗаполнено(Версия.Опубликована) Тогда
		Ответ.Заголовки["Last-Modified"] = HTTPДата(Версия.Опубликована);
	КонецЕсли;
	Если ЗначениеЗаполнено(Версия.Sha256) Тогда
		Ответ.Заголовки["ETag"] = КавычкамиETag(Версия.Sha256);
	КонецЕсли;

КонецПроцедуры

// Ошибки счёта проглатываются: целостность выдачи важнее точности статистики.
// Имя пула событию нужно затем, что скачивания считаются по пулам: разрезать их потом,
// по идентификатору версии, значило бы читать реестр на каждое скачивание.
Процедура ЗафиксироватьСкачивание(Знач Версия, Знач ИмяПула)
	Попытка
		Данные = Новый Структура("ПакетИдентификатор, ВерсияИдентификатор, ИмяПула",
			Версия.ПакетИдентификатор, Версия.Идентификатор, ИмяПула);
		Издатель.Опубликовать(Издатель.ТипСкачиваниеЗафиксировано(), Данные);
	Исключение
		// Счёт не критичен для выдачи — молча игнорируем.
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подменяет Ответ.Куки, куда middleware winow уже добавил SessionID, пустой коллекцией.
Процедура БезСессионнойКуки(Ответ)
	Ответ.Куки = ПустыеКуки;
КонецПроцедуры

// Безверсионный путь канала не называет — версию выбирает основной тег пакета.
Функция БезКанала()
	Возврат "";
КонецФункции

// Пропуск заголовка не годится: молчание отдаёт решение о свежести разделяемому кэшу.
Функция ДирективаКэшаАртефакта(Знач ИмяПула, Знач ВерсиюВыбралХаб)

	Если НЕ ПулПубличен(ИмяПула) Тогда
		Возврат Кэш.ПриватныйКэш();
	КонецЕсли;

	Возврат ?(ВерсиюВыбралХаб, Кэш.КэшИзменяемогоАдреса(), Кэш.НеизменяемыйКэш());

КонецФункции

// Пул уже прошёл гвард чтения, поэтому вопрос только о видимости, а не о правах.
Функция ПулПубличен(Знач ИмяПула)
	Возврат Права.ПулПубличный(СервисПулов.ПулДляЧтения(ИмяПула));
КонецФункции

// HTTP-date по RFC 7231: "Fri, 24 Jul 2026 18:24:33 GMT". На вход — время в UTC.
Функция HTTPДата(Знач ДатаUTC)
	Возврат Формат(ДатаUTC, "Л=en; ДФ='ддд, дд МММ гггг ЧЧ:мм:сс ''GMT'''");
КонецФункции

// Приговор сбою выдачи выносится по МАШИННОМУ КОДУ отказа, а не по словам в его тексте:
// «артефакта нет» — это 404 с названным артефактом, «хранилище не отвечает» — 503,
// всё прочее — 502. Причина при этом целиком уходит в журнал.
Процедура ОтветитьНаСбойВыдачи(Ответ, Знач Сбой, Знач ИмяПула, Знач ИмяПакета, Знач ИмяФайла)

	Лог.Ошибка("Сбой выдачи %1/%2 (файл %3): %4", ИмяПула, ИмяПакета, ИмяФайла,
		Ошибки.Причина(Сбой));
	// отчёт стои́т разбора цепочки: собираем его только тогда, когда отладку включили
	Если Лог.Уровень() <= УровниЛога.Отладка Тогда
		Лог.Отладка("Сбой выдачи %1/%2 (файл %3) целиком:%4%5",
			ИмяПула, ИмяПакета, ИмяФайла, Символы.ПС, Ошибки.ПодробныйОтчёт(Сбой));
	КонецЕсли;

	Если ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.РесурсНеНайден()) Тогда
		ОтдатьАртефактОтсутствует(Ответ, ИмяПула, ИмяФайла);
		Возврат;
	КонецЕсли;

	Если ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.ЗависимостьНедоступна()) Тогда
		ОтдатьХранилищеНедоступно(Ответ, СтрШаблон("хранилище пула ""%1"" не отдало ресурс ""%2""",
			ИмяПула, ИмяФайла));
		Возврат;
	КонецЕсли;

	ОтдатьСбойИсточника(Ответ, СтрШаблон("ресурс ""%1"" в пуле ""%2"" временно недоступен",
		ИмяФайла, ИмяПула));

КонецПроцедуры

// «Артефакта нет» у найденной версии — не сбой: версия в реестре есть, а файла в хранилище
// нет. Журнал слышит это отладкой, клиент — тем же 404, что и при отказе резолва.
Процедура ОтветитьНаСбойЧтения(Ответ, Знач Сбой, Знач ИмяПула, Знач ИмяПакета, Знач ИмяФайла)

	Если НЕ ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.РесурсНеНайден()) Тогда
		ОтветитьНаСбойВыдачи(Ответ, Сбой, ИмяПула, ИмяПакета, ИмяФайла);
		Возврат;
	КонецЕсли;

	Лог.Отладка("Выдача: %1 в реестре пула ""%2"" есть, а артефакта в хранилище нет", ИмяФайла, ИмяПула);
	ОтдатьАртефактОтсутствует(Ответ, ИмяПула, ИмяФайла);

КонецПроцедуры

Процедура ОтдатьАртефактОтсутствует(Ответ, Знач ИмяПула, Знач ИмяФайла)
	ОтдатьНеНайдено(Ответ, СтрШаблон("артефакт ""%1"" пула ""%2"" в хранилище отсутствует",
		ИмяФайла, ИмяПула));
КонецПроцедуры

// 502 отличается от 404 «нет такого ресурса» и от 500 «ошибка приложения».
Процедура ОтдатьСбойИсточника(Ответ, Знач Пояснение)
	Ответ.УстановитьСостояние(502);
	Ответ.Заголовки["Content-Type"] = "text/plain; charset=utf-8";
	Ответ.ТелоТекст = "bad gateway: " + Пояснение;
КонецПроцедуры

// 503 отличается от 502: отказал не источник по ту сторону хаба, а собственное хранилище,
// и клиенту имеет смысл повторить запрос позже — Retry-After называет, через сколько.
Процедура ОтдатьХранилищеНедоступно(Ответ, Знач Пояснение)
	Ответ.УстановитьСостояние(503);
	Ответ.Заголовки["Content-Type"] = "text/plain; charset=utf-8";
	Ответ.Заголовки["Retry-After"] = Формат(ПаузаПередПовтором(), "ЧГ=0");
	Ответ.ТелоТекст = "service unavailable: " + Пояснение;
КонецПроцедуры

// Секунды до осмысленного повтора: меньше — клиенты добьют лежащее хранилище, больше —
// opm будет ждать дольше, чем длится типичный перезапуск бэкенда.
Функция ПаузаПередПовтором()
	Возврат 30;
КонецФункции

// Отсутствие гварда — fail-closed: Неопределено означает, что желудь не построился.
Функция ПулЧитаем(Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ИмяПула)

	Если ЧтениеПула = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЧтениеПула.Проверить(ЗаголовкиЗапроса, КукиЗапроса, ИмяПула).Разрешено;

КонецФункции

// Пустая строка означает «основной пул не назначен»: отказ уже записан в ответ.
Функция ИмяОсновногоПула(Ответ)

	ИмяПула = СервисПулов.ИмяПулаПоУмолчанию();
	Если ЗначениеЗаполнено(ИмяПула) Тогда
		Возврат ИмяПула;
	КонецЕсли;

	БезСессионнойКуки(Ответ);
	ОтдатьНеНайдено(Ответ,
		СервисПулов.ПричинаБезОсновногоПула("короткие адреса /download и /dev-channel"));
	Возврат "";

КонецФункции

// Сбой самого объяснения оставляет 404 общим текстом: 404 не должен превращаться в 500.
Функция ПояснениеОтказа(Знач ИмяПула, Знач ИмяКанала, Знач ИмяПакета, Знач ИмяФайла, Знач Запрос)

	Попытка
		ПроКанал = РезолверВыдачи.ОбъяснитьОтказ(ИмяПула, ИмяКанала, ИмяПакета, Запрос);
	Исключение
		ПроКанал = "";
	КонецПопытки;

	Возврат ?(ЗначениеЗаполнено(ПроКанал), ПроКанал,
		СтрШаблон("ресурс ""%1"" в пуле ""%2"" не найден", ИмяФайла, ИмяПула));

КонецФункции

Процедура ОтдатьНеНайдено(Ответ, Знач Пояснение)
	Ответ.УстановитьСостояниеНеНайдено();
	Ответ.Заголовки["Content-Type"] = "text/plain; charset=utf-8";
	Ответ.ТелоТекст = "not found: " + Пояснение;
КонецПроцедуры

Процедура ОтдатьНеИзменено(Ответ, Знач ETag)
	Ответ.УстановитьСостояние(304);
	Ответ.Заголовки["ETag"] = ETag;
	Ответ.ТелоТекст = ""; // 304 не несёт тела
КонецПроцедуры

Функция ЭтоHEAD(Знач МетодЗапроса)
	Возврат ВРег(Строка(МетодЗапроса)) = "HEAD";
КонецФункции

Функция МеткаСовпала(Знач Версия, Знач ЗаголовкиЗапроса)
	Возврат ЗначениеЗаполнено(Версия.Sha256)
		И Кэш.СовпадаетETag(ЗаголовкиЗапроса, КавычкамиETag(Версия.Sha256));
КонецФункции

Функция КавычкамиETag(Знач Sha256)
	Возврат Кэш.Метка(НРег(Строка(Sha256)));
КонецФункции

Функция Sha256Строки(Знач Строка)
	Возврат Хеши.ОтСтроки(Строка);
КонецФункции

Функция РазмерТелаВБайтах(Знач Строка)
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Строка).Размер();
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РезолверВыдачи") _РезолверВыдачи,
	&Пластилин(Значение = "РезолверФайлаПакета") _РезолверФайла,
	&Пластилин(Значение = "Куки") _ПустыеКуки,
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "ГвардДоступаКПулу") _ЧтениеПула,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ЗаголовкиКэша") _Кэш,
	&Пластилин(Значение = "СервисПрав") _Права,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Пластилин(Значение = "Хеш") _Хеши = Неопределено)

	Кэш = _Кэш;
	Права = _Права;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Хеши = ?(_Хеши = Неопределено, Новый Хеш(), _Хеши);

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

	РезолверВыдачи = _РезолверВыдачи;
	РезолверФайла = _РезолверФайла;
	Издатель = _Издатель;
	ЧтениеПула = _ЧтениеПула;

	// Пустая коллекция кук: подменяет Ответ.Куки и никогда не мутируется.
	ПустыеКуки = _ПустыеКуки;

	СервисПулов = _СервисПулов;

КонецПроцедуры
