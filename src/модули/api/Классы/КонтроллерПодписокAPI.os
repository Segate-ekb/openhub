// Контроллер подписок API — то же, что раздел «Подписки» домов настроек хаба, пула
// и пакета. Действия и сериализацию выполняет ПодпискиAPI, права — СервисПодписок.

Перем Маршрут;    // МаршрутAPI (api)
Перем Допуск;     // ДопускAPI (api)
Перем Двери;      // ДвериAPI (api)
Перем Подписки;   // ПодпискиAPI (api)
Перем Сервис;     // СервисПодписок (подписки)
Перем HTTP;       // МетодыHTTP (основа)

#Область ТочкиМаршрута

// GET /api/v1/webhook-meta — типы событий и типы действий с именами полей настроек.
// Отдельный адрес, а не «/webhooks/meta»: маршрутизация winow first-match отдала бы
// «meta» обработчику карточки как идентификатор.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("webhook-meta")
Процедура Справочник(Ответ, МетодЗапроса, ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.НачатьЧтение(Ответ, ПараметрыЗапросаПорядковые, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;
	Подписки.Справочник(Ответ);

КонецПроцедуры

// GET /api/v1/webhooks — подписки ХАБА; POST — завести подписку хаба.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для POST.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и POST.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("webhooks")
Процедура ПодпискиХаба(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Набор(Ответ, Сервис.ОбъектХаба(), "", ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса);

КонецПроцедуры

// GET /api/v1/webhooks/{Ид} — карточка подписки хаба; PATCH — правка; DELETE — удаление.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Ид - Строка - идентификатор подписки из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для PATCH и DELETE.
//  МетодЗапроса - Строка - метод запроса; допустимы GET, PATCH и DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("webhooks/{Ид}")
Процедура ПодпискаХаба(Ответ, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Одна(Ответ, Сервис.ОбъектХаба(), "", Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса);

КонецПроцедуры

// GET /api/v1/pools/{Пул}/webhooks — подписки пула; POST — завести подписку пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для POST.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и POST.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/webhooks")
Процедура ПодпискиПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Объект = ОбъектПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Объект <> Неопределено Тогда
		Набор(Ответ, Объект, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса);
	КонецЕсли;

КонецПроцедуры

// GET /api/v1/pools/{Пул}/webhooks/{Ид} — карточка; PATCH — правка; DELETE — удаление.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Ид - Строка - идентификатор подписки из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для PATCH и DELETE.
//  МетодЗапроса - Строка - метод запроса; допустимы GET, PATCH и DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/webhooks/{Ид}")
Процедура ПодпискаПула(Ответ, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Объект = ОбъектПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Объект <> Неопределено Тогда
		Одна(Ответ, Объект, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса);
	КонецЕсли;

КонецПроцедуры

// GET /api/v1/pools/{Пул}/packages/{Имя}/webhooks — подписки пакета; POST — завести.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для POST.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и POST.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/webhooks")
Процедура ПодпискиПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Объект = ОбъектПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Объект <> Неопределено Тогда
		Набор(Ответ, Объект, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса);
	КонецЕсли;

КонецПроцедуры

// GET /api/v1/pools/{Пул}/packages/{Имя}/webhooks/{Ид} — карточка; PATCH; DELETE.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  Ид - Строка - идентификатор подписки из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для PATCH и DELETE.
//  МетодЗапроса - Строка - метод запроса; допустимы GET, PATCH и DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/webhooks/{Ид}")
Процедура ПодпискаПакета(Ответ, Пул, Имя, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса,
	МетодЗапроса, ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Объект = ОбъектПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Объект <> Неопределено Тогда
		Одна(Ответ, Объект, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Набор(Ответ, Знач Объект, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач ТелоЗапроса, Знач МетодЗапроса)

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Пользователь = Допуск.ТребоватьПользователя(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
		Если Пользователь <> Неопределено Тогда
			Подписки.Список(Ответ, Пользователь, Объект);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Маршрут.МетодНеРазрешён(Ответ, "GET, POST");
		Возврат;
	КонецЕсли;

	Мутация = Допуск.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, ИмяПула);
	Если Мутация <> Неопределено Тогда
		Подписки.Создать(Ответ, Мутация.Пользователь, Объект, Мутация.Тело);
	КонецЕсли;

КонецПроцедуры

Процедура Одна(Ответ, Знач Объект, Знач ИмяПула, Знач Ид, Знач ЗаголовкиЗапроса,
	Знач КукиЗапроса, Знач ТелоЗапроса, Знач МетодЗапроса)

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Пользователь = Допуск.ТребоватьПользователя(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
		Если Пользователь <> Неопределено Тогда
			Подписки.Карточка(Ответ, Пользователь, Объект, Ид);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Правка = HTTP.ЭтоМетод(МетодЗапроса, "PATCH");
	Если НЕ Правка И НЕ HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		Маршрут.МетодНеРазрешён(Ответ, "GET, PATCH, DELETE");
		Возврат;
	КонецЕсли;

	Мутация = Допуск.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, ИмяПула);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Правка Тогда
		Подписки.Правка(Ответ, Мутация.Пользователь, Объект, Ид, Мутация.Тело);
	Иначе
		Подписки.Удаление(Ответ, Мутация.Пользователь, Объект, Ид);
	КонецЕсли;

КонецПроцедуры

// Закрытый пул и несуществующий одинаково дают 404; право спрашивает сервис подписок.
Функция ОбъектПула(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса)

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	Пул = ?(ЭтоЧтение(МетодЗапроса),
		Двери.ВидимыйПул(Ответ, ИмяПула, Принципал),
		Двери.ПулМутации(Ответ, ИмяПула, Принципал));
	Возврат ?(Пул = Неопределено, Неопределено, Сервис.ОбъектПула(Пул));

КонецФункции

Функция ОбъектПакета(Ответ, Знач ИмяПула, Знач ИмяПакета, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач МетодЗапроса)

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	Найденное = ?(ЭтоЧтение(МетодЗапроса),
		Двери.ВидимыйПакет(Ответ, ИмяПула, ИмяПакета, Принципал),
		Двери.ПакетМутации(Ответ, ИмяПула, ИмяПакета, Принципал));
	Возврат ?(Найденное = Неопределено, Неопределено, Сервис.ОбъектПакета(Найденное.Пакет));

КонецФункции

// Маршрут обслуживает чтение и мутацию одним обработчиком, а пул открывает раньше метода.
Функция ЭтоЧтение(Знач МетодЗапроса)
	Возврат HTTP.ЭтоМетод(МетодЗапроса, "GET");
КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "МаршрутAPI") _Маршрут,
	&Пластилин(Значение = "ДопускAPI") _Допуск,
	&Пластилин(Значение = "ДвериAPI") _Двери,
	&Пластилин(Значение = "ПодпискиAPI") _Подписки,
	&Пластилин(Значение = "СервисПодписок") _Сервис,
	&Пластилин(Значение = "МетодыHTTP") _HTTP)

	Маршрут = _Маршрут;
	Допуск = _Допуск;
	Двери = _Двери;
	Подписки = _Подписки;
	Сервис = _Сервис;
	HTTP = _HTTP;

КонецПроцедуры
