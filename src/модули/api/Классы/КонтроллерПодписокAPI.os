// Контроллер подписок API — то же, что раздел «Подписки» домов настроек хаба, пула
// и пакета. Действия и сериализацию выполняет ПодпискиAPI, права — СервисПодписок.

Перем Маршрут;    // МаршрутAPI (api)
Перем Допуск;     // ДопускAPI (api)
Перем Двери;      // ДвериAPI (api)
Перем Подписки;   // ПодпискиAPI (api)
Перем Сервис;     // СервисПодписок (подписки)
Перем HTTP;       // МетодыHTTP (основа)

#Область ТочкиМаршрута

// Справочник подписок.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("webhook-meta", Метод = "get")
&Операция(Сводка = "Справочник подписок",
	Описание = "Ответ `{events, kinds}`: типы событий и типы доставки `{kind, editable, testable, fields}`, где
	|поле — `{name, required, secret}`. Значений секретов в справочнике нет.")
&Возвращает(Код = 200, Описание = "`{events, kinds}`")
&Возвращает(Код = 404, Описание = "`unknown_path` — лишние сегменты адреса")
&Возвращает(Код = 405, Описание = "`method_not_allowed`")
Процедура Справочник(Ответ, МетодЗапроса, ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.НачатьЧтение(Ответ, ПараметрыЗапросаПорядковые, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;
	Подписки.Справочник(Ответ);

КонецПроцедуры

// Подписки хаба: список и заведение.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для POST.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и POST.
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию — весь список
//             до потолка выдачи).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("webhooks", Метод = "get, post")
&Операция(Сводка = "Подписки хаба (GET); заведение подписки (POST)",
	Описание = "Подписки хаба — только администратор хаба.
	|**GET** — список, ручка целиком. **POST** — заведение, см. группу «Подписки».")
&Возвращает(Код = 200, Описание = "GET: страница подписок, целиком")
&Возвращает(Код = 201, Описание = "POST: `{subscription, secret}`")
&Возвращает(Код = 401, Описание = "`unauthorized`")
&Возвращает(Код = 403, Описание = "`forbidden` — нет права управлять подписками объекта; POST:
	|`csrf_failed`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 404, Описание = "`unknown_path` — лишние сегменты адреса")
&Возвращает(Код = 405, Описание = "`method_not_allowed`")
&Возвращает(Код = 422, Описание = "POST: `invalid_subscription` — тип, адрес, поля или события не
	|приняты либо подписка не записалась")
Процедура ПодпискиХаба(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	page = "", pageSize = "", ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Набор(Ответ, Сервис.ОбъектХаба(), "", ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
		page, pageSize);

КонецПроцедуры

// Подписка хаба: карточка, правка и удаление.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Ид - Строка - идентификатор подписки из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для PATCH и DELETE.
//  МетодЗапроса - Строка - метод запроса; допустимы GET, PATCH и DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("webhooks/{Ид}", Метод = "get, patch, delete")
&Операция(Сводка = "Подписка хаба (GET); правка подписки (PATCH); удаление подписки (DELETE)",
	Описание = "Подписки хаба — только администратор хаба.
	|**GET** — `{subscription}`. **PATCH** и **DELETE** — см. группу «Подписки».")
&Возвращает(Код = 200, Описание = "GET, PATCH: `{subscription}`; DELETE: `{deleted}`")
&Возвращает(Код = 401, Описание = "`unauthorized`")
&Возвращает(Код = 403, Описание = "`forbidden` — нет права управлять подписками объекта; PATCH, DELETE:
	|`csrf_failed`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 404, Описание = "`subscription_not_found`; `unknown_path`")
&Возвращает(Код = 405, Описание = "`method_not_allowed`")
&Возвращает(Код = 422, Описание = "PATCH: `invalid_subscription` — тип, адрес, поля или события не
	|приняты либо правка не записалась; DELETE: `invalid_subscription` — подписка не удалена, в том
	|числе при сбое хранилища")
Процедура ПодпискаХаба(Ответ, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Одна(Ответ, Сервис.ОбъектХаба(), "", Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса);

КонецПроцедуры

// Подписки пула: список и заведение.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для POST.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и POST.
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию — весь список
//             до потолка выдачи).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/webhooks", Метод = "get, post")
&Операция(Сводка = "Подписки пула (GET); заведение подписки (POST)",
	Описание = "Подписки пула — право удаления на пуле. Дверь пула спрашивается раньше
	|глагола и ключа.
	|**GET** — список, ручка целиком. **POST** — заведение, см. группу «Подписки».")
&Возвращает(Код = 200, Описание = "GET: страница подписок, целиком")
&Возвращает(Код = 201, Описание = "POST: `{subscription, secret}`")
&Возвращает(Код = 401, Описание = "`unauthorized`")
&Возвращает(Код = 403, Описание = "`forbidden` — нет права управлять подписками объекта; POST:
	|`csrf_failed`, `token_scope`")
&Возвращает(Код = 404, Описание = "`pool_not_found` — в том числе для ключа с чужой привязкой;
	|`unknown_path`")
&Возвращает(Код = 405, Описание = "`method_not_allowed`")
&Возвращает(Код = 422, Описание = "POST: `invalid_subscription` — тип, адрес, поля или события не
	|приняты либо подписка не записалась")
Процедура ПодпискиПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	page = "", pageSize = "", ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Объект = ОбъектПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Объект <> Неопределено Тогда
		Набор(Ответ, Объект, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
			page, pageSize);
	КонецЕсли;

КонецПроцедуры

// Подписка пула: карточка, правка и удаление.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Ид - Строка - идентификатор подписки из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для PATCH и DELETE.
//  МетодЗапроса - Строка - метод запроса; допустимы GET, PATCH и DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/webhooks/{Ид}", Метод = "get, patch, delete")
&Операция(Сводка = "Подписка пула (GET); правка подписки (PATCH); удаление подписки (DELETE)",
	Описание = "Подписки пула — право удаления на пуле. Дверь пула спрашивается раньше
	|глагола и ключа.
	|**GET** — `{subscription}`. **PATCH** и **DELETE** — см. группу «Подписки».")
&Возвращает(Код = 200, Описание = "GET, PATCH: `{subscription}`; DELETE: `{deleted}`")
&Возвращает(Код = 401, Описание = "`unauthorized`")
&Возвращает(Код = 403, Описание = "`forbidden` — нет права управлять подписками объекта; PATCH, DELETE:
	|`csrf_failed`, `token_scope`")
&Возвращает(Код = 404, Описание = "`subscription_not_found`; `pool_not_found`; `unknown_path`")
&Возвращает(Код = 405, Описание = "`method_not_allowed`")
&Возвращает(Код = 422, Описание = "PATCH: `invalid_subscription` — тип, адрес, поля или события не
	|приняты либо правка не записалась; DELETE: `invalid_subscription` — подписка не удалена, в том
	|числе при сбое хранилища")
Процедура ПодпискаПула(Ответ, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Объект = ОбъектПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Объект <> Неопределено Тогда
		Одна(Ответ, Объект, Пул, Ид, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса);
	КонецЕсли;

КонецПроцедуры

// Подписки пакета: список и заведение.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для POST.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и POST.
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию — весь список
//             до потолка выдачи).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/webhooks", Метод = "get, post")
&Операция(Сводка = "Подписки пакета (GET); заведение подписки (POST)",
	Описание = "Подписки пакета — право изменения пакета. Дверь пула и пакета спрашивается
	|раньше глагола и ключа.
	|**GET** — список, ручка целиком. **POST** — заведение, см. группу «Подписки».")
&Возвращает(Код = 200, Описание = "GET: страница подписок, целиком")
&Возвращает(Код = 201, Описание = "POST: `{subscription, secret}`")
&Возвращает(Код = 401, Описание = "`unauthorized`")
&Возвращает(Код = 403, Описание = "`forbidden` — нет права управлять подписками объекта; POST:
	|`csrf_failed`, `token_scope`")
&Возвращает(Код = 404, Описание = "`pool_not_found`, `package_not_found`; `unknown_path`")
&Возвращает(Код = 405, Описание = "`method_not_allowed`")
&Возвращает(Код = 422, Описание = "POST: `invalid_subscription` — тип, адрес, поля или события не
	|приняты либо подписка не записалась")
Процедура ПодпискиПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	page = "", pageSize = "", ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Объект = ОбъектПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Объект <> Неопределено Тогда
		Набор(Ответ, Объект, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
			page, pageSize);
	КонецЕсли;

КонецПроцедуры

