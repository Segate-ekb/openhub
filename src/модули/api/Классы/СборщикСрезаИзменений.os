// Срез изменений пула: версии, появившиеся или изменившиеся после названного момента,
// порцией имён от курсора. Форму версии строит СборщикКарточкиПакета — она одна на всю выдачу.

Перем СервисПакетов;  // СервисПакетов (реестр)
Перем СервисВерсий;   // СервисВерсий (реестр)
Перем СервисМеток;    // СервисМетокВерсий (реестр)
Перем Провенанс;      // СервисПроисхождения (реестр)
Перем Сборщик;        // СборщикКарточкиПакета (api) — форма версии
Перем Строки;         // КанонСтроки (основа)

#Область ПубличныйИнтерфейс

// Срез изменений пула.
//
// Параметры:
//  Пул - Пул - пул, чьи изменения перечисляются.
//  Момент - Дата, Неопределено - нижняя граница изменения включительно; незаполненная
//           отдаёт весь состав пула (полный срез).
//  Курсор - Строка - имя пакета, с которого продолжается порция (включительно);
//           пусто — с начала среза.
//  Предел - Число - сколько ИМЁН пакетов отдать порцией; версии отобранного имени
//           идут целиком.
//
// Возвращаемое значение:
//  Структура - Снят (Дата, момент снятия среза: изменения после него в него не вошли),
//              Изменения (Массив из Структура: ИмяПакета, Версия — форма версии для JSON),
//              ИменВсего (Число, имён в срезе после отбора — знаменатель обхода),
//              ИменДо (Число, имён среза, оставшихся до курсора),
//              ЕстьЕщё (Булево, за порцией остались имена),
//              Курсор (Строка, имя для следующей порции; пусто — срез пройден).
//
Функция Срез(Знач Пул, Знач Момент, Знач Курсор = "", Знач Предел = 100) Экспорт

	// без Перем присваивание уйдёт в ПОЛЕ объекта, общее на процесс
	Перем Снят;
	Перем Результат;
	Перем Пакеты;
	Перем Изменившиеся;
	Перем КурсорКлюч;
	Перем Отобрано;
	Перем ВерсииИмени;
	Перем Порция;

	// момент снимается ДО чтения: версия, изменившаяся во время сборки, в этот срез могла
	// не попасть, и зеркало обязано спросить её следующим обходом
	Снят = ЦелаяСекунда(ТекущаяУниверсальнаяДата());

	Результат = Новый Структура("Снят, Изменения, ИменВсего, ИменДо, ЕстьЕщё, Курсор",
		Снят, Новый Массив(), 0, 0, Ложь, "");

	Пакеты = ВидимыеПакеты(Пул);
	Изменившиеся = ПоПакетам(СервисВерсий.ИзменённыеВерсии(Идентификаторы(Пакеты), Момент));

	КурсорКлюч = Ключ(Курсор);
	Отобрано = 0;
	Порция = Новый Массив();
	Для Каждого Пакет Из ПоВозрастанию(Пакеты) Цикл

		ВерсииИмени = Изменившиеся.Получить(Цел(Пакет.Идентификатор));
		Если ВерсииИмени = Неопределено Тогда
			Продолжить; // имя, у которого после момента ничего не менялось
		КонецЕсли;

		Результат.ИменВсего = Результат.ИменВсего + 1;
		Если Ключ(Пакет.Имя) < КурсорКлюч Тогда
			Результат.ИменДо = Результат.ИменДо + 1;
			Продолжить;
		КонецЕсли;

		Если Отобрано >= Предел Тогда
			Если НЕ Результат.ЕстьЕщё Тогда
				Результат.ЕстьЕщё = Истина;
				Результат.Курсор = Строка(Пакет.Имя);
			КонецЕсли;
			Продолжить; // знаменатель считается по всему срезу, а не по порции
		КонецЕсли;

		Отобрано = Отобрано + 1;
		Порция.Добавить(Новый Структура("Пакет, Версии", Пакет, ВерсииИмени));

	КонецЦикла;

	НаполнитьИзменения(Результат.Изменения, Порция);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Метки и провенанс всей порции — двумя разрезами: вопрос на версию делал бы обход
// зеркала дороже ровно во столько раз, сколько версий в порции.
Процедура НаполнитьИзменения(Изменения, Знач Порция)

	Метки = СервисМеток.МеткиСписка(НомераВерсий(Порция));
	Доверенные = Провенанс.ДоверенныеВерсииПакетов(НомераПакетов(Порция));

	Для Каждого Имя Из Порция Цикл
		Для Каждого Версия Из Имя.Версии Цикл
			Изменения.Добавить(Новый Структура("ИмяПакета, Версия",
				Строка(Имя.Пакет.Имя),
				Сборщик.ВерсияJSON(Версия, Метки.Получить(Цел(Версия.Идентификатор)),
					Доверенные.Получить(Версия.Идентификатор) = Истина)));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция НомераВерсий(Знач Порция)

	Результат = Новый Массив();
	Для Каждого Имя Из Порция Цикл
		Для Каждого Версия Из Имя.Версии Цикл
			Результат.Добавить(Цел(Версия.Идентификатор));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НомераПакетов(Знач Порция)

	Результат = Новый Массив();
	Для Каждого Имя Из Порция Цикл
		Результат.Добавить(Цел(Имя.Пакет.Идентификатор));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ключ порядка и сравнения с курсором один на обе стороны: разойдись они — порция уедет.
Функция Ключ(Знач Имя)
	Возврат Строки.Канон(Имя);
КонецФункции

// Скрытый пакет из среза выпадает целиком: зеркало видит ровно то же, что и читатель пула.
Функция ВидимыеПакеты(Знач Пул)

	Результат = Новый Массив();
	Для Каждого Пакет Из СервисПакетов.ПакетыПула(Пул.Идентификатор) Цикл
		Если Пакет.Скрыт <> Истина Тогда
			Результат.Добавить(Пакет);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Порядок среза задаёт хаб: курсор — это позиция в устойчивом порядке, а не в чтении из базы.
Функция ПоВозрастанию(Знач Пакеты)

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Ключ");
	Таблица.Колонки.Добавить("Пакет");
	Для Каждого Пакет Из Пакеты Цикл
		Запись = Таблица.Добавить();
		Запись.Ключ = Ключ(Пакет.Имя);
		Запись.Пакет = Пакет;
	КонецЦикла;
	Таблица.Сортировать("Ключ Возр");

	Результат = Новый Массив();
	Для Каждого Запись Из Таблица Цикл
		Результат.Добавить(Запись.Пакет);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПоПакетам(Знач Версии)

	Результат = Новый Соответствие();
	Для Каждого Версия Из Версии Цикл
		Ключ = Цел(Версия.ПакетИдентификатор);
		Список = Результат.Получить(Ключ);
		Если Список = Неопределено Тогда
			Список = Новый Массив();
			Результат.Вставить(Ключ, Список);
		КонецЕсли;
		Список.Добавить(Версия);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Округление вниз безопасно: граница момента включительна, попавшее на неё приедет ещё раз.
Функция ЦелаяСекунда(Знач Момент)
	Возврат '00010101000000' + Цел(Момент - '00010101000000');
КонецФункции

Функция Идентификаторы(Знач Пакеты)

	Результат = Новый Массив();
	Для Каждого Пакет Из Пакеты Цикл
		Результат.Добавить(Цел(Пакет.Идентификатор));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисМетокВерсий") _СервисМеток,
	&Пластилин(Значение = "СервисПроисхождения") _Провенанс,
	&Пластилин(Значение = "СборщикКарточкиПакета") _Сборщик,
	&Пластилин(Значение = "КанонСтроки") _Строки = Неопределено)

	Строки = ?(_Строки = Неопределено, Новый КанонСтроки(), _Строки);
	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;
	СервисМеток = _СервисМеток;
	Провенанс = _Провенанс;
	Сборщик = _Сборщик;

КонецПроцедуры
