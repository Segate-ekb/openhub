// Ответ 200 адреса конвейеров: страница на чтение, уже заведённый конвейер на запись — одна схема на оба глагола.

&Сериализуемое("items")
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("ДоверенныйКонвейерJSON")
Перем Элементы;

&Сериализуемое("page")
&Тип("Число")
Перем Номер;

&Сериализуемое("pageSize")
&Тип("Число")
Перем Размер;

&Сериализуемое("total")
&Тип("Число")
Перем Всего;

&Сериализуемое("has_more")
&Тип("Булево")
Перем ЕстьЕщё;

&Сериализуемое("trusted_workflow")
&Тип("ДоверенныйКонвейерJSON")
Перем Конвейер;
