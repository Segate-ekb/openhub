// Тело заведения доверенного конвейера CI.

&Сериализуемое("provider")
&Заполнено
&Тип("Строка")
&ОдинИз("github", "gitlab")
Перем Провайдер;

&Сериализуемое("issuer")
&Тип("Строка")
Перем Издатель;

&Сериализуемое("repository")
&Заполнено
&Тип("Строка")
Перем Репозиторий;

&Сериализуемое("workflow")
&Тип("Строка")
Перем Конвейер;

&Сериализуемое("ref")
&Заполнено
&Тип("Строка")
Перем Реф;

&Сериализуемое("ref_kind")
&Тип("Строка")
Перем ВидРефа;
