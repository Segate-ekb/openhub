// Заявки на публикацию в API: «входящие» пула, сводка по всем пулам принципала, одобрение
// и отклонение. Доменные операции — РассмотрениеВходящих.

Перем Ответы;        // ОтветыAPI (основа)
Перем Запрос;        // ЗапросAPI (протоколAPI)
Перем Маршрут;       // МаршрутAPI (протоколAPI)
Перем Допуск;        // ДопускAPI (api)
Перем Двери;         // ДвериAPI (api)
Перем ПрологПравки;  // ПрологПравкиAPI (api)
Перем Страницы;      // СтраницыAPI (протоколAPI)
Перем Рассмотрение;  // РассмотрениеВходящих (публикация) — видимость, одобрение, отклонение
Перем Моменты;       // МоментISO (основа) — одно написание времени в ответе

#Область ТочкиМаршрута

// Заявки из всех пулов, где пользователь мейнтейнер и выше.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию — весь список
//             до потолка выдачи).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("inbox", Метод = "get")
&Операция(Сводка = "Заявки из всех пулов пользователя",
	Описание = "Заявки из всех пулов, где пользователь мейнтейнер или выше. `manifest` — что пакет
	|сказал о себе в packagedef.")
&Возвращает(Код = 200, Тип = "СтраницаЗаявокJSON", Описание = "Заявки")
&Возвращает(Код = 401, Тип = "ОтказJSON", Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 404, Тип = "ОтказJSON", Описание = "`unknown_path` — лишние сегменты адреса")
&Возвращает(Код = 405, Тип = "ОтказJSON", Описание = "`method_not_allowed` — чужой глагол")
Процедура СводкаЗаявок(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	page = "", pageSize = "", ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.НачатьЧтение(Ответ, ПараметрыЗапросаПорядковые, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Если Допуск.ТребоватьПользователя(Ответ, ЗаголовкиЗапроса, КукиЗапроса) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// сводка сама отбирает пулы, где принципал вправе решать
	ОтдатьСписок(Ответ, Рассмотрение.ОжидающиеПринципала(
		Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса)), page, pageSize);

КонецПроцедуры

// Заявки, ждущие решения в пуле.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию — весь список
//             до потолка выдачи).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/inbox", Метод = "get")
&Операция(Сводка = "Заявки пула",
	Описание = "Нужна роль мейнтейнера пула или выше. `manifest` — что пакет сказал о себе
	|в packagedef.")
&Возвращает(Код = 200, Тип = "СтраницаЗаявокJSON", Описание = "Заявки пула")
&Возвращает(Код = 401, Тип = "ОтказJSON", Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Тип = "ОтказJSON", Описание = "`forbidden` — нет права")
&Возвращает(Код = 404, Тип = "ОтказJSON", Описание = "`pool_not_found` — пула нет")
&Возвращает(Код = 405, Тип = "ОтказJSON", Описание = "`method_not_allowed` — чужой глагол")
Процедура ЗаявкиПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	page = "", pageSize = "", ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.НачатьЧтение(Ответ, ПараметрыЗапросаПорядковые, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Принципал = Допуск.ТребоватьПринципала(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Принципал = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПулОбъект = Двери.АдминистрируемыйПул(Ответ, Пул, Принципал);
	Если ПулОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОтдатьСписок(Ответ, Рассмотрение.СтрокиПула(Принципал, ПулОбъект), page, pageSize);

КонецПроцедуры

// Одобрение заявки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Заявка - Строка - номер заявки из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только POST.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//  ТелоЗапросаОбъект - Произвольный - тело, разобранное winow по схеме описания; точка его не читает.
//
&ТочкаМаршрута("pools/{Пул}/inbox/{Заявка}/approve", Метод = "post")
&Операция(Сводка = "Одобрение заявки",
	Описание = "Публикует версию от имени заявителя, он становится мейнтейнером пакета. Нужна роль
	|мейнтейнера пула или выше.")
&Возвращает(Код = 200, Тип = "РешениеПоЗаявкеJSON", Описание = "Заявка одобрена")
&Возвращает(Код = 400, Тип = "ОтказJSON", Описание = "`request_failed` — файл не прошёл проверку")
&Возвращает(Код = 401, Тип = "ОтказJSON", Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Тип = "ОтказJSON", Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 404, Тип = "ОтказJSON", Описание = "`request_not_found`, `pool_not_found`")
&Возвращает(Код = 405, Тип = "ОтказJSON", Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 409, Тип = "ОтказJSON", Описание = "`request_conflict` — заявку уже не одобрить")
&Возвращает(Код = 410, Тип = "ОтказJSON",
	Описание = "`artifact_gone` — артефакта заявки нет, остаётся отклонить")
&Возвращает(Код = 413, Тип = "ОтказJSON", Описание = "`request_failed` — артефакт больше предела")
&Возвращает(Код = 500, Тип = "ОтказJSON", Описание = "`request_failed` — публикация сорвалась")
&Возвращает(Код = 507, Тип = "ОтказJSON", Описание = "`request_failed` — квота пула исчерпана")
Процедура ОдобритьЗаявку(Ответ, Пул, Заявка, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса,
	МетодЗапроса, ПараметрыЗапросаПорядковые = Неопределено,
	&Тип("ЗапросБезПолейJSON") ТелоЗапросаОбъект = Неопределено) Экспорт

	Решить(Ответ, Пул, Заявка, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
		ПараметрыЗапросаПорядковые, "одобрить");

КонецПроцедуры

// Отклонение заявки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Заявка - Строка - номер заявки из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только POST.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//  ТелоЗапросаОбъект - Произвольный - тело, разобранное winow по схеме описания; точка его не читает.
//
&ТочкаМаршрута("pools/{Пул}/inbox/{Заявка}/reject", Метод = "post")
&Операция(Сводка = "Отклонение заявки",
	Описание = "Отклоняет заявку и стирает её артефакт; причину `reason` увидит заявитель. Нужна
	|роль мейнтейнера пула или выше.")
&Возвращает(Код = 200, Тип = "РешениеПоЗаявкеJSON", Описание = "Заявка отклонена")
&Возвращает(Код = 401, Тип = "ОтказJSON", Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Тип = "ОтказJSON", Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 404, Тип = "ОтказJSON", Описание = "`request_not_found`, `pool_not_found`")
&Возвращает(Код = 405, Тип = "ОтказJSON", Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 409, Тип = "ОтказJSON", Описание = "`request_conflict` — заявка уже рассмотрена")
Процедура ОтклонитьЗаявку(Ответ, Пул, Заявка, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса,
	МетодЗапроса, ПараметрыЗапросаПорядковые = Неопределено,
	&Тип("ЗапросОтклоненияЗаявкиJSON") ТелоЗапросаОбъект = Неопределено) Экспорт

	Решить(Ответ, Пул, Заявка, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
		ПараметрыЗапросаПорядковые, "отклонить");

КонецПроцедуры

#КонецОбласти

#Область Действия

// Порядок проверок один на оба решения: метод, гейт, видимость пула, право, заявка, домен.
Процедура Решить(Ответ, Знач ИмяПула, Знач НомерИзАдреса, Знач ЗаголовкиЗапроса,
	Знач КукиЗапроса, Знач ТелоЗапроса, Знач МетодЗапроса, Знач Порядковые, Знач Операция)

	Если НЕ Маршрут.НачатьДействие(Ответ, Порядковые, МетодЗапроса, "POST") Тогда
		Возврат;
	КонецЕсли;

	Мутация = ПрологПравки.АдминистрированиеПула(Ответ, ИмяПула, ЗаголовкиЗапроса, КукиЗапроса,
		ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Пул = Мутация.Пул;

	Номер = ЦелоеИзАдреса(НомерИзАдреса);
	Если Номер = 0 Тогда
		Ответы.Ошибка(Ответ, 404, "request_not_found", "Заявка не найдена");
		Возврат;
	КонецЕсли;

	// номер заявки соседнего пула не подставить, даже с правами на тот пул
	Контекст = Рассмотрение.ЗаявкаКРассмотрению(Мутация.Принципал, Номер);
	Если НЕ Контекст.Успех Тогда
		Ответы.Ошибка(Ответ, Контекст.Код, КодОшибки(Контекст.Код), Контекст.Сообщение);
		Возврат;
	КонецЕсли;
	Если Цел(Контекст.Пул.Идентификатор) <> Цел(Пул.Идентификатор) Тогда
		Ответы.Ошибка(Ответ, 404, "request_not_found", "Заявка не найдена в этом пуле");
		Возврат;
	КонецЕсли;

	Если Операция = "одобрить" Тогда
		Итог = Рассмотрение.Одобрить(Мутация.Принципал, Номер);
	Иначе
		Итог = Рассмотрение.Отклонить(Мутация.Принципал, Номер,
			Запрос.Поле(Мутация.Тело, "причина", Запрос.Поле(Мутация.Тело, "reason")));
	КонецЕсли;

	Если НЕ Итог.Успех Тогда
		Ответы.Ошибка(Ответ, Итог.Код, КодОшибки(Итог.Код), Итог.Сообщение);
		Возврат;
	КонецЕсли;

	Ответы.JSON(Ответ, 200, Новый Структура("status, message",
		?(Операция = "одобрить", "approved", "rejected"), Итог.Сообщение));

КонецПроцедуры

Процедура ОтдатьСписок(Ответ, Знач Строки, Знач page, Знач pageSize)

	Элементы = Новый Массив();
	Для Каждого СтрокаВходящих Из Строки Цикл
		Элементы.Добавить(ЗаявкаJSON(СтрокаВходящих));
	КонецЦикла;
	Ответы.JSON(Ответ, 200, Страницы.Перечень(Элементы, page, pageSize));

КонецПроцедуры

Функция ЗаявкаJSON(Знач СтрокаВходящих)

	Заявка = СтрокаВходящих.Заявка;

	Результат = Новый Структура();
	Результат.Вставить("id", Цел(Заявка.Идентификатор));
	Результат.Вставить("pool", Строка(СтрокаВходящих.Пул.Имя));
	Результат.Вставить("package", Строка(Заявка.ИмяПакета));
	Результат.Вставить("version", Строка(Заявка.Версия));
	Результат.Вставить("applicant", ?(СтрокаВходящих.Заявитель = Неопределено, "",
		Строка(СтрокаВходящих.Заявитель.Логин)));
	Результат.Вставить("manifest_author", Строка(Заявка.АвторМанифеста));
	Результат.Вставить("channel", Строка(Заявка.Канал));
	Результат.Вставить("file_name", Строка(Заявка.ИмяФайла));
	Результат.Вставить("size", Цел(Заявка.Размер));
	Результат.Вставить("sha256", Строка(Заявка.Sha256));
	Результат.Вставить("state", Строка(Заявка.Состояние));
	Результат.Вставить("created", Моменты.Строкой(Заявка.Создана));

	// без снимка манифеста поля нет вовсе: пустые строки выдали бы незнание за пустоту
	Манифест = Неопределено;
	Если СтрокаВходящих.Свойство("Манифест", Манифест) И Манифест <> Неопределено Тогда
		Результат.Вставить("manifest", МанифестJSON(Манифест));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция МанифестJSON(Знач Манифест)

	Состав = Новый Массив();
	Для Каждого Зависимость Из Манифест.Зависимости Цикл
		Элемент = Новый Структура();
		Элемент.Вставить("name", Зависимость.Имя);
		Элемент.Вставить("version", Зависимость.ВерсияМин);
		Элемент.Вставить("version_max", Зависимость.ВерсияМакс);
		Элемент.Вставить("dev", Зависимость.ДляРазработки);
		Состав.Добавить(Элемент);
	КонецЦикла;

	Результат = Новый Структура();
	Результат.Вставить("description", Манифест.Описание);
	Результат.Вставить("author_email", Манифест.АдресАвтора);
	Результат.Вставить("repository", Манифест.АдресРепозитория);
	Результат.Вставить("engine_version", Манифест.ВерсияДвижка);
	Результат.Вставить("dependencies", Состав);
	Возврат Результат;

КонецФункции

// Номер из адреса: только цифры. Мусор даёт 0 и превращается в 404, а не в исключение.
Функция ЦелоеИзАдреса(Знач Значение)

	Текст = СокрЛП(Строка(Значение));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Для Поз = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Поз, 1)) = 0 Тогда
			Возврат 0;
		КонецЕсли;
	КонецЦикла;
	Возврат Число(Текст);

КонецФункции

Функция КодОшибки(Знач Код)

	Если Код = 404 Тогда
		Возврат "request_not_found";
	ИначеЕсли Код = 403 Тогда
		Возврат "forbidden";
	ИначеЕсли Код = 401 Тогда
		Возврат "unauthorized";
	ИначеЕсли Код = 409 Тогда
		Возврат "request_conflict";
	ИначеЕсли Код = 410 Тогда
		Возврат "artifact_gone";
	КонецЕсли;
	Возврат "request_failed";

КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
&Группа("Заявки", Описание = "Входящие: публикации без прав на имя ждут решения мейнтейнеров пула.")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ЗапросAPI") _Запрос,
	&Пластилин(Значение = "МаршрутAPI") _Маршрут,
	&Пластилин(Значение = "ДопускAPI") _Допуск,
	&Пластилин(Значение = "ДвериAPI") _Двери,
	&Пластилин(Значение = "ПрологПравкиAPI") _ПрологПравки,
	&Пластилин(Значение = "СтраницыAPI") _Страницы,
	&Пластилин(Значение = "РассмотрениеВходящих") _Рассмотрение,
	&Пластилин(Значение = "МоментISO") _Моменты = Неопределено)

	Ответы = _Ответы;
	Запрос = _Запрос;
	Маршрут = _Маршрут;
	Допуск = _Допуск;
	Двери = _Двери;
	ПрологПравки = _ПрологПравки;
	Страницы = _Страницы;
	Рассмотрение = _Рассмотрение;
	Моменты = ?(_Моменты = Неопределено, Новый МоментISO(), _Моменты);

КонецПроцедуры
