// Зависимость пакета из заявки.

// BSLLS:MissingVariablesDescription-off
&Сериализуемое("name")
&Заполнено
&Тип("Строка")
Перем Имя;

&Сериализуемое("version")
&Заполнено
&Тип("Строка")
Перем Версия;

&Сериализуемое("version_max")
&Заполнено
&Тип("Строка")
Перем ВерсияДо;

&Сериализуемое("dev")
&Заполнено
&Тип("Булево")
Перем ДляРазработки;
// BSLLS:MissingVariablesDescription-on
