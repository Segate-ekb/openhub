// Доверенный конвейер CI, которому пакет разрешает публикацию.

&Сериализуемое("id")
&Заполнено
&Тип("Число")
Перем Ид;

&Сериализуемое("provider")
&Заполнено
&Тип("Строка")
&ОдинИз("github", "gitlab")
Перем Провайдер;

&Сериализуемое("issuer")
&Заполнено
&Тип("Строка")
Перем Издатель;

&Сериализуемое("repository")
&Заполнено
&Тип("Строка")
Перем Репозиторий;

&Сериализуемое("workflow")
&Заполнено
&Тип("Строка")
Перем Конвейер;

&Сериализуемое("ref")
&Заполнено
&Тип("Строка")
Перем Реф;

&Сериализуемое("created_by")
&Заполнено
&Тип("Строка")
Перем Завёл;

&Сериализуемое("created")
&Заполнено
&Тип("Строка")
Перем Заведён;
