// Сквозная логика тонких контроллеров API: принципал запроса, гейт мутаций (CSRF для
// сессии, рамки ключа для PAT), видимость приватных пулов, пагинация и единый формат
// ответов. Контроллеры инжектят только этот помощник и свои доменные сервисы.
// Сообщения об ошибках не раскрывают внутренности.

Перем Перехватчик;   // ПерехватчикАутентификации (auth)
Перем Права;         // СервисПрав (auth)
Перем ГейтКлюча;     // ГейтТокена (auth)
Перем CSRF;          // ЗащитаCSRF (auth)
Перем СервисПулов;   // СервисПулов (реестр)
Перем СервисПакетов; // СервисПакетов (реестр)
Перем Кабинет;       // СлужбаКабинета (кабинет)
Перем Ответы;        // ОтветыAPI (auth)
Перем ПустыеКуки;    // Куки (winow)
Перем ГвардКвоты;    // ГвардКвотыПула (auth)

#Область ЕдиныйФормат

// Записывает успешный JSON-ответ.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Код - Число - код состояния HTTP.
//  Данные - Структура, Соответствие, Массив - сериализуемые данные ответа.
//
Процедура JSON(Ответ, Знач Код, Знач Данные) Экспорт
	Ответы.JSON(Ответ, Код, Данные);
КонецПроцедуры

// Записывает ошибку в едином формате {error:{code,message}}.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Код - Число - код состояния HTTP.
//  КодОшибки - Строка - машинный код ошибки.
//  Сообщение - Строка - короткое безопасное сообщение без внутренностей.
//
Процедура Ошибка(Ответ, Знач Код, Знач КодОшибки, Знач Сообщение) Экспорт
	Ответы.Ошибка(Ответ, Код, КодОшибки, Сообщение);
КонецПроцедуры

// Разбирает тело запроса в поля.
//
// Параметры:
//  ТелоЗапроса - Строка - тело запроса (application/json либо form-urlencoded).
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//
// Возвращаемое значение:
//  Соответствие - поля тела.
//
Функция РазобратьТело(Знач ТелоЗапроса, Знач ЗаголовкиЗапроса) Экспорт
	Возврат Ответы.РазобратьТело(ТелоЗапроса, ЗаголовкиЗапроса);
КонецФункции

// Строковое значение поля тела.
//
// Параметры:
//  Тело - Соответствие - разобранное тело запроса.
//  Имя - Строка - имя поля.
//  ПоУмолчанию - Строка - что вернуть, если поля нет (необязательный,
//                по умолчанию пустая строка).
//
// Возвращаемое значение:
//  Строка - значение поля либо значение по умолчанию.
//
Функция Поле(Знач Тело, Знач Имя, Знач ПоУмолчанию = "") Экспорт
	Возврат Ответы.Поле(Тело, Имя, ПоУмолчанию);
КонецФункции

// Булево из значения поля тела: JSON отдаёт настоящий Булево, form-urlencoded — строку.
//
// Параметры:
//  Значение - Произвольный - сырое значение поля.
//
// Возвращаемое значение:
//  Булево.
//
Функция ВБулево(Знач Значение) Экспорт
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Стр = НРег(СокрЛП(Строка(Значение)));
	Возврат Стр = "true" ИЛИ Стр = "1" ИЛИ Стр = "да" ИЛИ Стр = "истина";
КонецФункции

// Записывает 405 с заголовком Allow.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Разрешённые - Строка - список методов через запятую.
//
Процедура МетодНеРазрешён(Ответ, Знач Разрешённые) Экспорт
	Ответ.Заголовки["Allow"] = Разрешённые;
	Ошибка(Ответ, 405, "method_not_allowed", СтрШаблон("Разрешены методы: %1", Разрешённые));
КонецПроцедуры

// winow отдаёт обработчику ближайшего совпавшего уровня остаток пути, поэтому короткий
// адрес исполняется вместо длинного, если гвард не поставлен. Истина означает, что
// 404 уже записан и вызывающий обязан выйти.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Порядковые - Массив, Неопределено - лишние сегменты пути.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЛишнийХвостПути(Ответ, Знач Порядковые) Экспорт

	Если Порядковые = Неопределено ИЛИ Порядковые.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Ошибка(Ответ, 404, "unknown_path", СтрШаблон(
		"Такого адреса нет: лишние сегменты пути ""%1""", СтрСоединить(Порядковые, "/")));
	Возврат Истина;

КонецФункции

// Снимает сессионную куку с ответа: ответы API stateless.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//
Процедура СнятьКуку(Ответ) Экспорт
	Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
КонецПроцедуры

#КонецОбласти

#Область Аутентификация

// Принципал запроса; никогда не Неопределено.
//
// Параметры:
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//
// Возвращаемое значение:
//  Структура - Пользователь (Неопределено у анонима), Способ ("token", "session"
//  либо пустая строка), Сессия, Права, ПулИдентификатор.
//
Функция Принципал(Знач ЗаголовкиЗапроса, Знач КукиЗапроса) Экспорт
	Возврат Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);
КонецФункции

// Требует аутентификации. При отказе сам записывает 401 — вызывающий обязан выйти.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//
// Возвращаемое значение:
//  Пользователь, Неопределено - пользователь запроса либо Неопределено у анонима.
//
Функция ТребоватьПользователя(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса) Экспорт
	Принц = Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	Если Принц.Пользователь = Неопределено Тогда
		Ошибка(Ответ, 401, "unauthorized", "Требуется аутентификация");
		Возврат Неопределено;
	КонецЕсли;
	Возврат Принц.Пользователь;
КонецФункции

// Пролог мутации: аутентификация, разбор тела и гейт способа аутентификации.
// При отказе сам записывает ответ — вызывающий обязан выйти.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  ИмяПула - Строка - пул, которого касается мутация; пустая строка означает уровень
//            хаба (необязательный, по умолчанию пустая).
//
// Возвращаемое значение:
//  Структура, Неопределено - Пользователь, Принц, Тело либо Неопределено при отказе.
//
Функция НачатьМутацию(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса,
	Знач ИмяПула = "") Экспорт

	Принц = Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	Если Принц.Пользователь = Неопределено Тогда
		Ошибка(Ответ, 401, "unauthorized", "Требуется аутентификация");
		Возврат Неопределено;
	КонецЕсли;

	Тело = РазобратьТело(ТелоЗапроса, ЗаголовкиЗапроса);
	Если НЕ ПроверитьМутацию(Ответ, Принц, Тело, ЗаголовкиЗапроса, ИмяПула) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Пользователь, Принц, Тело", Принц.Пользователь, Принц, Тело);

КонецФункции

// Гейт мутации по способу аутентификации. Для PAT применяются рамки ключа (скоуп
// и привязка к пулу), CSRF — нет: у токена нет ambient-authority cookie. Сессия обязана
// предъявить валидный CSRF-токен. При отказе сам записывает 403.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Принц - Структура - принципал запроса.
//  Тело - Соответствие - разобранное тело запроса, источник поля _csrf.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса, источник X-CSRF-Token.
//  ИмяПула - Строка - пул, которого касается мутация; пустая строка означает уровень
//            хаба, недоступный привязанному ключу (необязательный, по умолчанию пустая).
//
// Возвращаемое значение:
//  Булево - Истина, если мутацию можно выполнять.
//
Функция ПроверитьМутацию(Ответ, Знач Принц, Знач Тело, Знач ЗаголовкиЗапроса, Знач ИмяПула = "") Экспорт

	Если Принц.Способ = "token" Тогда
		Возврат КлючВправеМутировать(Ответ, Принц, ИмяПула);
	КонецЕсли;

	// Аноним проходит насквозь: подделывать нечего, а отказ ему выдаст аутентификация
	// ниже другим кодом. Условие default-closed — именно аноним, а не «всё, что не
	// сессия»: любой будущий способ аутентификации обязан отбиться, а не проскочить.
	Если ПустаяСтрока(Строка(Принц.Способ)) И Принц.Пользователь = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если Принц.Способ <> "session" Тогда
		Ошибка(Ответ, 403, "unknown_auth_method",
			"Неизвестный способ аутентификации для мутации");
		Возврат Ложь;
	КонецЕсли;

	ТокенCSRF = Строка(ЗаголовокЗапроса(ЗаголовкиЗапроса, "X-CSRF-Token"));
	Если НЕ ЗначениеЗаполнено(ТокенCSRF) Тогда
		ТокенCSRF = Поле(Тело, CSRF.ИмяПоля());
	КонецЕсли;

	Если НЕ CSRF.Проверить(Принц.Сессия, ТокенCSRF) Тогда
		Ошибка(Ответ, 403, "csrf_failed", "Отсутствует или неверен CSRF-токен");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Скоуп ключа и привязка к пулу. Пул резолвится по имени из маршрута, а не из тела:
// подставить чужой пул формой нельзя. Гейт не собран — отказ (fail-closed).
Функция КлючВправеМутировать(Ответ, Знач Принц, Знач ИмяПула)

	Если ГейтКлюча = Неопределено Тогда
		Ошибка(Ответ, 403, "token_gate_missing", "Мутация по токену недоступна: гейт ключа доступа не собран");
		Возврат Ложь;
	КонецЕсли;

	ПулИдентификатор = 0;
	Если ЗначениеЗаполнено(ИмяПула) Тогда
		Пул = СервисПулов.НайтиПул(ИмяПула);
		ПулИдентификатор = ?(Пул = Неопределено, 0, Пул.Идентификатор);
	КонецЕсли;

	Вердикт = ГейтКлюча.Проверить(Принц, "изменение", ПулИдентификатор);
	Если Вердикт.Разрешено Тогда
		Возврат Истина;
	КонецЕсли;

	Если Вердикт.Причина = ГейтКлюча.ПричинаПривязка() Тогда
		Ошибка(Ответ, 403, "token_pool_mismatch", "Токен привязан к другому пулу");
	Иначе
		Ошибка(Ответ, 403, "token_scope", "Токену не хватает скоупа write для этой операции");
	КонецЕсли;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область ВидимостьИПрава

// Находит пул по имени с учётом видимости для субъекта. Отсутствующий и
// приватный-недоступный пул неотличимы: оба дают 404 без раскрытия существования.
// При отказе сам записывает ответ — вызывающий обязан выйти.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ИмяПула - Строка - имя пула.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//
// Возвращаемое значение:
//  Пул, Неопределено - найденный видимый пул либо Неопределено.
//
Функция ВидимыйПул(Ответ, Знач ИмяПула, Знач Пользователь) Экспорт

	Пул = СервисПулов.НайтиПул(ИмяПула);
	Если Пул = Неопределено ИЛИ НЕ Права.МожетЧитать(Пользователь, Пул) Тогда
		Ошибка(Ответ, 404, "pool_not_found", СтрШаблон("Пул ""%1"" не найден", ИмяПула));
		Возврат Неопределено;
	КонецЕсли;
	Возврат Пул;

КонецФункции

// Единый пролог доступа для маршрутов уровня пакета: видимость пула, затем пакет.
// При отказе сам записывает 404 — вызывающий обязан выйти.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля Пул и Пакет либо Неопределено.
//
Функция ВидимыйПакет(Ответ, Знач ИмяПула, Знач ИмяПакета, Знач Пользователь) Экспорт

	Пул = ВидимыйПул(Ответ, ИмяПула, Пользователь);
	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пакет = СервисПакетов.НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Если Пакет = Неопределено ИЛИ Пакет.Скрыт = Истина Тогда
		Ошибка(Ответ, 404, "package_not_found", СтрШаблон("Пакет ""%1"" не найден", ИмяПакета));
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("Пул", Пул);
	Результат.Вставить("Пакет", Пакет);
	Возврат Результат;

КонецФункции

// Требует права записи на пул. При отказе сам записывает 403.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//  Пул - Пул - пул мутации.
//
// Возвращаемое значение:
//  Булево - Истина, если право есть.
//
Функция ТребоватьЗапись(Ответ, Знач Пользователь, Знач Пул) Экспорт
	Если НЕ Права.МожетПисать(Пользователь, Пул) Тогда
		Ошибка(Ответ, 403, "forbidden", "Недостаточно прав для изменения пула");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Требует права управления пакетом: yank, метки, теги. Делегирует каноническому гейту
// кабинета — тому же, что и /office. При отказе сам записывает 403.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//  Пул - Пул - пул пакета.
//  Пакет - Пакет - управляемый пакет.
//
// Возвращаемое значение:
//  Булево - Истина, если право есть.
//
Функция ТребоватьИзменениеПакета(Ответ, Знач Пользователь, Знач Пул, Знач Пакет) Экспорт
	Если НЕ Кабинет.МожетУправлять(Пользователь, Пул, Пакет) Тогда
		Ошибка(Ответ, 403, "forbidden", "Недостаточно прав для изменения пакета");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Требует прав владельца либо администратора пула. При отказе сам записывает 403.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//  Пул - Пул - администрируемый пул.
//
// Возвращаемое значение:
//  Булево - Истина, если право есть.
//
Функция ТребоватьАдмин(Ответ, Знач Пользователь, Знач Пул) Экспорт
	Если НЕ Права.МожетАдминистрировать(Пользователь, Пул) Тогда
		Ошибка(Ответ, 403, "forbidden", "Требуются права владельца/администратора пула");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Пул административной операции: невидимый неотличим от отсутствующего (404), видимый
// без прав владельца/администратора — 403. Тот же порядок проверок, что у ГвардПула
// в /office. При отказе сам записывает ответ — вызывающий обязан выйти.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ИмяПула - Строка - имя пула.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//
// Возвращаемое значение:
//  Пул, Неопределено - администрируемый пул либо Неопределено.
//
Функция АдминистрируемыйПул(Ответ, Знач ИмяПула, Знач Пользователь) Экспорт

	Пул = ВидимыйПул(Ответ, ИмяПула, Пользователь);
	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ ТребоватьАдмин(Ответ, Пользователь, Пул) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Пул;

КонецФункции

// Требует прав администратора хаба. При отказе сам записывает 403.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//
// Возвращаемое значение:
//  Булево - Истина, если право есть.
//
Функция ТребоватьАдминаХаба(Ответ, Знач Пользователь) Экспорт
	Если НЕ Права.ПользовательАдмин(Пользователь) Тогда
		Ошибка(Ответ, 403, "forbidden", "Требуются права администратора хаба");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Сервис прав для точечных проверок, которым мало готовых гейтов помощника.
//
// Возвращаемое значение:
//  СервисПрав - сервис модели прав.
//
Функция СервисПрав() Экспорт
	Возврат Права;
КонецФункции

#КонецОбласти

#Область Квота

// Сырое значение поля квоты из тела запроса.
//
// Параметры:
//  Тело - Соответствие - разобранное тело запроса.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - значение поля либо Неопределено, если поля квоты нет.
//
Функция СыраяКвота(Знач Тело) Экспорт

	Для Каждого Имя Из СтрРазделить("квота_мб,quota_mb", ",") Цикл
		Если Тело.Получить(Имя) <> Неопределено Тогда
			Возврат Тело.Получить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Требует права назначать квоту пула. При отказе сам записывает 403 — вызывающий
// обязан выйти.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//
// Возвращаемое значение:
//  Булево - Истина, если право есть.
//
Функция ТребоватьПравоНаКвоту(Ответ, Знач Пользователь) Экспорт

	Если ГвардКвоты.МожетМенятьКвоту(Пользователь) Тогда
		Возврат Истина;
	КонецЕсли;
	Ошибка(Ответ, 403, ГвардКвоты.КодОтказа(), ГвардКвоты.ПричинаОтказа());
	Возврат Ложь;

КонецФункции

// Разбирает квоту и судит её сервисом пулов — тем же вердиктом, что и форма дома
// настроек. При отказе сам записывает 400 — вызывающий обязан выйти.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Сырое - Произвольный - значение поля квоты из тела запроса.
//
// Возвращаемое значение:
//  Число, Неопределено - принятая квота в МБ либо Неопределено при отказе.
//
Функция ПринятьКвоту(Ответ, Знач Сырое) Экспорт

	// ноль значим («без ограничения»), а -1 значит «как в хабе»: и мусор, и знак разбирает
	// сам сервис — единым чтением с формой раздела «Пулы» и домом настроек пула
	Вердикт = СервисПулов.РассудитьКвоту(Сырое);
	Если Вердикт.Ок Тогда
		Возврат Вердикт.Квота;
	КонецЕсли;

	Если Вердикт.Причина = СервисПулов.ПричинаКвотаПотолок() Тогда
		Ошибка(Ответ, 400, "invalid_quota", СтрШаблон("Квота слишком велика: максимум %1 МБ",
			Формат(СервисПулов.ПредельнаяКвотаМб(), "ЧН=0; ЧГ=0")));
	Иначе
		Ошибка(Ответ, 400, "invalid_quota",
			"Квота — целое число мегабайт, 0 означает «без ограничения»");
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область Пагинация

// Номер страницы из query-параметра.
//
// Параметры:
//  Значение - Строка - сырое значение параметра.
//
// Возвращаемое значение:
//  Число - номер страницы не меньше 1; мусор и пустота дают 1.
//
Функция НомерСтраницы(Знач Значение) Экспорт
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 1;
	КонецЕсли;
	Попытка
		Возврат Макс(1, Цел(Число(Значение)));
	Исключение
		Возврат 1;
	КонецПопытки;
КонецФункции

// Размер страницы из query-параметра.
//
// Параметры:
//  Значение - Строка - сырое значение параметра.
//  ПоУмолчанию - Число - размер при пустом или некорректном значении (необязательный,
//                по умолчанию 20).
//  Максимум - Число - верхняя граница размера (необязательный, по умолчанию 100).
//
// Возвращаемое значение:
//  Число - размер страницы в границах от 1 до Максимум.
//
Функция РазмерСтраницы(Знач Значение, Знач ПоУмолчанию = 20, Знач Максимум = 100) Экспорт
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Попытка
		Н = Цел(Число(Значение));
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
	Если Н < 1 Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Мин(Н, Максимум);
КонецФункции

// Срез массива для страницы — когда доменный сервис сам не пагинирует.
//
// Параметры:
//  Массив - Массив - полный набор элементов.
//  Страница - Число - номер страницы, не меньше 1.
//  РазмерСтр - Число - размер страницы, не меньше 1.
//
// Возвращаемое значение:
//  Массив - элементы страницы; пустой при выходе за границы.
//
Функция Срез(Знач Массив, Знач Страница, Знач РазмерСтр) Экспорт
	Результат = Новый Массив();
	Начало = (Страница - 1) * РазмерСтр;
	Для Индекс = Начало По Начало + РазмерСтр - 1 Цикл
		Если Индекс >= 0 И Индекс < Массив.Количество() Тогда
			Результат.Добавить(Массив[Индекс]);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Единая форма пагинации API.
//
// Параметры:
//  Элементы - Массив - элементы текущей страницы.
//  Всего - Число - общее число элементов.
//  НомерСтр - Число - номер страницы.
//  РазмерСтр - Число - размер страницы.
//
// Возвращаемое значение:
//  Структура - items, page, pageSize, total.
//
Функция Страница(Знач Элементы, Знач Всего, Знач НомерСтр, Знач РазмерСтр) Экспорт
	Конверт = Новый Структура();
	Конверт.Вставить("items", Элементы);
	Конверт.Вставить("page", НомерСтр);
	Конверт.Вставить("pageSize", РазмерСтр);
	Конверт.Вставить("total", Всего);
	Возврат Конверт;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗаголовокЗапроса(Знач ЗаголовкиЗапроса, Знач Имя)
	Если ЗаголовкиЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИскомыйКлюч = ВРег(Имя);
	Для Каждого КиЗ Из ЗаголовкиЗапроса Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = ИскомыйКлюч Тогда
			Возврат КиЗ.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "СервисПрав") _Права,
	&Пластилин(Значение = "ГейтТокена") _ГейтКлюча,
	&Пластилин(Значение = "ЗащитаCSRF") _CSRF,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СлужбаКабинета") _Кабинет,
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "Куки") _ПустыеКуки,
	&Пластилин(Значение = "ГвардКвотыПула") _ГвардКвоты)

	Перехватчик = _Перехватчик;
	ГейтКлюча = _ГейтКлюча;
	Права = _Права;
	CSRF = _CSRF;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	Кабинет = _Кабинет;
	Ответы = _Ответы;
	ПустыеКуки = _ПустыеКуки;
	ГвардКвоты = _ГвардКвоты;

КонецПроцедуры
