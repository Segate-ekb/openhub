// POST /api/v1/users — самостоятельная регистрация пользователя с учётом онбординг-
// политики хаба. Эндпоинт неаутентифицированный, CSRF к нему не применяется.

Перем Помощник;          // ПомощникAPI (api)
Перем СервисРегистрации; // СервисРегистрации (auth)
Перем Адреса;            // АдресУчётки (auth) — код и текст отказа «адрес занят»
Перем HTTP;        // МетодыHTTP (основа)

#Область ТочкиМаршрута

// POST /api/v1/users — регистрирует пользователя и отдаёт его карточку с кодом 201.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ТелоЗапроса - Строка - JSON либо форма с полями логин, email, пароль.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только POST.
//
&ТочкаМаршрута("users")
Процедура Пользователи(Ответ, ТелоЗапроса, ЗаголовкиЗапроса, МетодЗапроса) Экспорт

	Помощник.СнятьКуку(Ответ);
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответ.Заголовки["Allow"] = "POST";
		Помощник.Ошибка(Ответ, 405, "method_not_allowed", "Разрешён только метод POST");
		Возврат;
	КонецЕсли;

	Тело = Помощник.РазобратьТело(ТелоЗапроса, ЗаголовкиЗапроса);
	Логин = Помощник.Поле(Тело, "логин", Помощник.Поле(Тело, "login"));
	Email = Помощник.Поле(Тело, "email");
	Пароль = Помощник.Поле(Тело, "пароль", Помощник.Поле(Тело, "password"));

	Попытка
		Пользователь = СервисРегистрации.Зарегистрировать(Логин, Email, Пароль);
	Исключение
		ОтдатьОшибкуРегистрации(Ответ, ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Помощник.JSON(Ответ, 201, Новый Структура("user", ПользовательВJSON(Пользователь)));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Доменные исключения регистрации в HTTP-коды; сообщения без внутренностей.
Процедура ОтдатьОшибкуРегистрации(Ответ, Знач ИнфОбОшибке)

	Сообщение = КраткоеПредставлениеОшибки(ИнфОбОшибке);
	Нижн = НРег(Сообщение);

	Если СтрНайти(Нижн, "registration_locked_onboarding") > 0 Тогда
		Помощник.Ошибка(Ответ, 403, "registration_locked_onboarding",
			"Регистрация закрыта до создания первого администратора (мастер /setup)");
	ИначеЕсли СтрНайти(Нижн, "registration_disabled") > 0 Тогда
		Помощник.Ошибка(Ответ, 403, "registration_disabled", "Регистрация на хабе отключена");
	ИначеЕсли СтрНайти(Нижн, "registration_invite_only") > 0 Тогда
		Помощник.Ошибка(Ответ, 403, "registration_invite_only", "Регистрация доступна только по приглашению");
	ИначеЕсли СтрНайти(Нижн, "registration_password_login_disabled") > 0 Тогда
		Помощник.Ошибка(Ответ, 403, "registration_password_login_disabled",
			"Вход по логину и паролю выключен: регистрация с паролем закрыта");
	ИначеЕсли СтрНайти(Нижн, "registration_mail_not_configured") > 0 Тогда
		Помощник.Ошибка(Ответ, 503, "registration_mail_not_configured",
			"Регистрация закрыта: включено подтверждение адреса письмом, а отправка почты"
			+ " на хабе не настроена. Администратору — настроить почту либо выключить"
			+ " подтверждение адреса в настройках хаба");
	ИначеЕсли СтрНайти(Нижн, Адреса.ПричинаЗанят()) > 0 Тогда
		// раньше логина: занятый адрес не должен рассказывать про занятый логин
		Помощник.Ошибка(Ответ, 409, Адреса.ПричинаЗанят(),
			"Адрес электронной почты уже принадлежит другой учётной записи");
	ИначеЕсли СтрНайти(Нижн, "уже") > 0 ИЛИ СтрНайти(Нижн, "занят") > 0 ИЛИ СтрНайти(Нижн, "exist") > 0 Тогда
		Помощник.Ошибка(Ответ, 409, "user_exists", "Пользователь с таким логином уже существует");
	Иначе
		Помощник.Ошибка(Ответ, 400, "registration_failed", БезопасноеСообщение(Сообщение));
	КонецЕсли;

КонецПроцедуры

Функция ПользовательВJSON(Знач Пользователь)
	Структура = Новый Структура();
	Структура.Вставить("id", Пользователь.Идентификатор);
	Структура.Вставить("login", Пользователь.Логин);
	Структура.Вставить("email", Пользователь.Email);
	Структура.Вставить("role", Пользователь.РольХаба);
	Возврат Структура;
КонецФункции

Функция БезопасноеСообщение(Знач Текст)
	Возврат СокрЛП(СтрЗаменить(СтрЗаменить(Строка(Текст), Символы.ПС, " "), Символы.ВК, " "));
КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПомощникAPI") _Помощник,
	&Пластилин(Значение = "СервисРегистрации") _СервисРегистрации,
	&Пластилин(Значение = "АдресУчётки") _Адреса,
	&Пластилин(Значение = "МетодыHTTP") _HTTP)

	HTTP = _HTTP;

	Помощник = _Помощник;
	СервисРегистрации = _СервисРегистрации;
	Адреса = _Адреса;

КонецПроцедуры
