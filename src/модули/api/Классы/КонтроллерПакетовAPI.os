// Чтения пакетов: список пула, карточка, резолв версии и README. Все чтения
// уважают видимость приватных пулов — недоступный пул неотличим от несуществующего.
// Маршрут .../versions целиком принадлежит КонтроллерВерсийAPI: winow работает по
// first-match, и один маршрут не может обслуживаться двумя контроллерами.

Перем Помощник;      // ПомощникAPI (api)
Перем СервисПулов;   // СервисПулов (реестр)
Перем СервисПакетов; // СервисПакетов (реестр)
Перем СервисВерсий;  // СервисВерсий (реестр)
Перем РезолверСпецификации; // РезолверСпецификации (реестр)
Перем Сборщик;       // СборщикКарточкиПакета (api)
Перем СлужбаREADME;  // СлужбаREADME (описания)
Перем Отбор;         // ПоискПоКоллекции (поиск)
Перем HTTP;        // МетодыHTTP (основа)
Перем Кэш;           // ЗаголовкиКэша (основа)

#Область ТочкиМаршрута

// GET /api/v1/pools/{Пул}/packages — страница пакетов пула с фильтром по подстроке.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  query - Строка - подстрока имени, описания или ключевых слов (необязательный).
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию из помощника).
//
&ТочкаМаршрута("pools/{Пул}/packages")
Процедура СписокПакетов(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, query = "", page = "", pageSize = "") Экспорт

	Контекст = НачатьЧтение(Ответ, Пул, Неопределено, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Видимые = Новый Массив();
	Для Каждого Пакет Из СервисПакетов.ПакетыПула(Контекст.Пул.Идентификатор) Цикл
		Если Пакет.Скрыт = Истина Тогда
			Продолжить;
		КонецЕсли;
		Видимые.Добавить(Пакет);
	КонецЦикла;

	Отобранные = Отбор.Отобрать(Видимые, Строка(query), "Имя,КлючевыеСлова,Описание");

	НомерСтр = Помощник.НомерСтраницы(page);
	РазмерСтр = Помощник.РазмерСтраницы(pageSize);
	Страница = Помощник.Срез(Отобранные, НомерСтр, РазмерСтр);

	Элементы = Новый Массив();
	Для Каждого Пакет Из Страница Цикл
		Элементы.Добавить(КраткийПакетJSON(Контекст.Пул, Пакет));
	КонецЦикла;

	Помощник.JSON(Ответ, 200, Помощник.Страница(Элементы, Отобранные.Количество(), НомерСтр, РазмерСтр));

КонецПроцедуры

// GET /api/v1/pools/{Пул}/packages/{Имя} — карточка пакета.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}")
Процедура КарточкаПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт
	Контекст = НачатьЧтение(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Помощник.JSON(Ответ, 200, Новый Структура("package", Сборщик.Карточка(Контекст.Пул, Контекст.Пакет)));
КонецПроцедуры

// GET /api/v1/pools/{Пул}/packages/{Имя}/resolve — точная версия, адрес загрузки и sha256.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  spec - Строка - спецификация версии: точная версия, имя тега либо выражение версии;
//         пустая резолвится основным тегом пакета (необязательный, по умолчанию пустая
//         строка).
//  channel - Строка - устаревший синоним spec (необязательный, по умолчанию пустая строка).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/resolve")
Процедура РезолвВерсии(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, spec = "", channel = "") Экспорт

	Контекст = НачатьЧтение(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// channel обрабатывается тем же кодом, а не игнорируется молча: иначе старый клиент
	// получил бы не ошибку, а ДРУГУЮ версию — худший исход для воспроизводимости сборки.
	Если НЕ ЗначениеЗаполнено(spec) И ЗначениеЗаполнено(channel) Тогда
		spec = channel;
	КонецЕсли;

	// та же лесенка, что и у выдачи файла: иначе «назови версию» и «дай файл» разошлись бы
	Разрешение = РезолверСпецификации.Разрешить(Контекст.Пакет, spec);
	Если НЕ Разрешение.Найдена Тогда
		ОтказатьВРезолве(Ответ, Разрешение, spec);
		Возврат;
	КонецЕсли;

	Пакет = Контекст.Пакет;
	Версия = Разрешение.Версия;

	Данные = Новый Структура();
	Данные.Вставить("version", Версия.Версия);
	Данные.Вставить("url", АдресЗагрузки(Контекст.Пул.Имя, Пакет.Имя, Версия.Версия));
	Данные.Вставить("sha256", ?(ЗначениеЗаполнено(Версия.Sha256), Строка(Версия.Sha256), ""));
	// сам хаб отозванную не выбирает, но названную точно — называет; без пометки такой
	// ответ неотличим от ответа про действующую версию, и отзыв узнают из чужого поста
	Данные.Вставить("yanked", Версия.Отозвана = Истина);
	Помощник.JSON(Ответ, 200, Данные);

КонецПроцедуры

// GET /api/v1/pools/{Пул}/packages/{Имя}/readme — README версии санитизированным HTML.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  version - Строка - версия README; пустая берёт последнюю (необязательный).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/readme")
Процедура ReadmeПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, version = "") Экспорт

	Контекст = НачатьЧтение(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(version) Тогда
		Верс = СервисВерсий.НайтиВерсию(Контекст.Пакет.Идентификатор, version);
	Иначе
		Верс = СервисВерсий.ПоследняяВерсия(Контекст.Пакет.Идентификатор);
	КонецЕсли;

	Представление = СлужбаREADME.ПредставлениеREADME(Контекст.Пул, Контекст.Пакет, Верс);

	Данные = Новый Структура();
	Данные.Вставить("version", ?(Верс = Неопределено, "", Строка(Верс.Версия)));
	Данные.Вставить("has_readme", Представление.ЕстьREADME);
	Данные.Вставить("html", Представление.HTML);

	// README названной версии неизменяем — его ответ переиспользуется по метке ресурса;
	// ответ безверсионного адреса меняется с публикациями и живёт коротким сроком
	Ответ.Заголовки["Cache-Control"] = ?(НЕ Публичный(Контекст.Пул), Кэш.КэшСтраницы(Ложь),
		?(ЗначениеЗаполнено(version), Кэш.НеизменяемыйКэш(), Кэш.КэшСтраницы(Истина)));
	Ответ.Заголовки["ETag"] = Кэш.МеткаСодержимого(Представление.HTML);

	Помощник.JSON(Ответ, 200, Данные);

КонецПроцедуры

#КонецОбласти

// Приватный пул виден не всем, и его ответ не кладётся в общий кэш ни на секунду.
Функция Публичный(Знач Пул)
	Возврат Пул <> Неопределено И НРег(СокрЛП(Строка(Пул.Видимость))) = "public";
КонецФункции

#Область ОбщаяЛогикаЧтения

// Общий пролог чтения: кука, метод, принципал, видимость пула и пакета. Ответ при
// отказе уже записан — вызывающий обязан выйти.
Функция НачатьЧтение(Ответ, Знач ИмяПула, Знач ИмяПакета, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса)

	Помощник.СнятьКуку(Ответ);

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответ.Заголовки["Allow"] = "GET";
		Помощник.Ошибка(Ответ, 405, "method_not_allowed", "Разрешён только метод GET");
		Возврат Неопределено;
	КонецЕсли;

	Принц = Помощник.Принципал(ЗаголовкиЗапроса, КукиЗапроса);

	Если ИмяПакета = Неопределено Тогда
		Пул = Помощник.ВидимыйПул(Ответ, ИмяПула, Принц.Пользователь);
		Если Пул = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Контекст = Новый Структура();
		Контекст.Вставить("Пул", Пул);
		Контекст.Вставить("Пакет", Неопределено);
		Возврат Контекст;
	КонецЕсли;

	Возврат Помощник.ВидимыйПакет(Ответ, ИмяПула, ИмяПакета, Принц.Пользователь);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Три отказа резолва требуют от клиента разных действий: опечатка в имени тега — 404,
// битое выражение версии — 422, «условию не удовлетворяет ни одна версия» — снова 404.
Процедура ОтказатьВРезолве(Ответ, Знач Разрешение, Знач Spec)

	Если Разрешение.ТегНеизвестен Тогда
		Помощник.Ошибка(Ответ, 404, "tag_not_found", СтрШаблон("Тег ""%1"" не определён", Spec));
	ИначеЕсли Разрешение.ВыражениеБитое Тогда
		Помощник.Ошибка(Ответ, 422, "invalid_spec", "Некорректное выражение версии");
	Иначе
		Помощник.Ошибка(Ответ, 404, "version_not_found", "Нет версии, удовлетворяющей условию");
	КонецЕсли;

КонецПроцедуры

Функция КраткийПакетJSON(Знач Пул, Знач Пакет)
	Структура = Новый Структура();
	Структура.Вставить("name", Пакет.Имя);
	Структура.Вставить("pool", Пул.Имя);
	Структура.Вставить("description", ?(ЗначениеЗаполнено(Пакет.Описание), Строка(Пакет.Описание), ""));
	Структура.Вставить("deprecated", Пакет.Устарел = Истина);
	Возврат Структура;
КонецФункции

// Канонический путь выдачи пула — тот же, что читает opm.
Функция АдресЗагрузки(Знач ИмяПула, Знач ИмяПакета, Знач Версия)
	Возврат СтрШаблон("/api/v1/pools/%1/download/%2/%2-%3.ospx",
		КодироватьСтроку(ИмяПула, СпособКодированияСтроки.КодировкаURL),
		КодироватьСтроку(ИмяПакета, СпособКодированияСтроки.КодировкаURL),
		КодироватьСтроку(Версия, СпособКодированияСтроки.КодировкаURL));
КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПомощникAPI") _Помощник,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "РезолверСпецификации") _РезолверСпецификации,
	&Пластилин(Значение = "СборщикКарточкиПакета") _Сборщик,
	&Пластилин(Значение = "СлужбаREADME") _СлужбаREADME,
	&Пластилин(Значение = "ПоискПоКоллекции") _Отбор,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "ЗаголовкиКэша") _Кэш)

	HTTP = _HTTP;
	Кэш = _Кэш;
	Отбор = _Отбор;

	Помощник = _Помощник;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;
	РезолверСпецификации = _РезолверСпецификации;
	Сборщик = _Сборщик;
	СлужбаREADME = _СлужбаREADME;

КонецПроцедуры
