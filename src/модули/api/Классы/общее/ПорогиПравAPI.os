// Пороги права в API: управлять пакетом, администрировать пул, права уровня хаба. Все пороги
// отказывают одним хвостом — 403 своими словами, записанный на месте.

Перем Права;     // СервисПрав (права)
Перем Кабинет;   // СлужбаКабинета (кабинет) — право управлять пакетом
Перем Ответы;    // ОтветыAPI (основа)

#Область ПравоНаПулИПакет

// Требует права управления пакетом — того же, что спрашивает кабинет. При отказе сам
// записывает 403.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//  Пул - Пул - пул пакета.
//  Пакет - Пакет - управляемый пакет.
//
// Возвращаемое значение:
//  Булево - Истина, если право есть.
//
Функция ТребоватьИзменениеПакета(Ответ, Знач Пользователь, Знач Пул, Знач Пакет) Экспорт
	Возврат ПорогПрава(Ответ, Кабинет.МожетУправлять(Пользователь, Пул, Пакет),
		"Недостаточно прав для изменения пакета");
КонецФункции

// Требует прав владельца либо администратора пула. При отказе сам записывает 403.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//  Пул - Пул - администрируемый пул.
//
// Возвращаемое значение:
//  Булево - Истина, если право есть.
//
Функция ТребоватьАдмин(Ответ, Знач Пользователь, Знач Пул) Экспорт
	Возврат ПорогПрава(Ответ, Права.МожетАдминистрировать(Пользователь, Пул),
		"Требуются права владельца/администратора пула");
КонецФункции

#КонецОбласти

#Область ПраваХаба

// Требует прав администратора хаба. При отказе сам записывает 403.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//
// Возвращаемое значение:
//  Булево - Истина, если право есть.
//
Функция ТребоватьАдминаХаба(Ответ, Знач Пользователь) Экспорт
	Возврат ПорогПрава(Ответ, Права.ПользовательАдмин(Пользователь),
		"Требуются права администратора хаба");
КонецФункции

// Требует права создания пула на хабе. При отказе сам записывает 403.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//
// Возвращаемое значение:
//  Булево - Истина, если право есть.
//
Функция ТребоватьСозданиеПула(Ответ, Знач Пользователь) Экспорт
	Возврат ПорогПрава(Ответ, Права.МожетСоздаватьПул(Пользователь),
		"Недостаточно прав для создания пула");
КонецФункции

// Требует права удаления пула на хабе. При отказе сам записывает 403.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//
// Возвращаемое значение:
//  Булево - Истина, если право есть.
//
Функция ТребоватьУдалениеПула(Ответ, Знач Пользователь) Экспорт
	Возврат ПорогПрава(Ответ, Права.МожетУдалятьПул(Пользователь),
		"Недостаточно прав для удаления пула: требуется право удаления на уровне хаба");
КонецФункции

// Требует права назначить основной пул хаба. При отказе сам записывает 403.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//
// Возвращаемое значение:
//  Булево - Истина, если право есть.
//
Функция ТребоватьНазначениеОсновногоПула(Ответ, Знач Пользователь) Экспорт
	Возврат ПорогПрава(Ответ, Права.МожетНазначатьОсновнойПул(Пользователь),
		"Недостаточно прав, чтобы назначить основной пул хаба");
КонецФункции

// Администратор ли хаба — развилка выдачи, а не порог: админ видит всё, остальные своё.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//
// Возвращаемое значение:
//  Булево - признак администратора хаба.
//
Функция ЭтоАдминХаба(Знач Пользователь) Экспорт
	Возврат Права.ПользовательАдмин(Пользователь);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПорогПрава(Ответ, Знач Разрешено, Знач Сообщение)
	Если Разрешено = Истина Тогда
		Возврат Истина;
	КонецЕсли;
	Ответы.Ошибка(Ответ, 403, "forbidden", Сообщение);
	Возврат Ложь;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПрав") _Права,
	&Пластилин(Значение = "СлужбаКабинета") _Кабинет,
	&Пластилин(Значение = "ОтветыAPI") _Ответы)

	Права = _Права;
	Кабинет = _Кабинет;
	Ответы = _Ответы;

КонецПроцедуры
