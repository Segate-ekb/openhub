// Двери API в названный пул и пакет: войти читать, войти менять, администрировать. Закрытая
// дверь неотличима от отсутствующей — обе дают 404.

Перем ДоступКПулу;   // ГвардДоступаКПулу (права) — обе двери в названный пул: чтение и изменение
Перем СервисПакетов; // СервисПакетов (реестр)
Перем ПорогиПрав;    // ПорогиПравAPI (api) — право администрировать пул
Перем Ответы;        // ОтветыAPI (основа)

#Область ДвериВПулИПакет

// Пул по имени, если он читаем ЭТИМ запросом: право человека и рамки ключа спрашивает гвард
// чтения пула. Ключ чужой привязки не входит и в публичный пул. Отсутствующий, закрытый
// правами и закрытый привязкой ключа неотличимы — все три дают 404, записанный на месте.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ИмяПула - Строка - имя пула.
//  Принципал - Структура, Неопределено - принципал запроса; Неопределено — аноним.
//
// Возвращаемое значение:
//  Пул, Неопределено - снимок названного пула только для чтения, если пул читаем этим
//                      запросом, либо Неопределено. Сохранить снимок нельзя.
//
Функция ВидимыйПул(Ответ, Знач ИмяПула, Знач Принципал) Экспорт
	Возврат ПулЗаДверью(Ответ, ИмяПула, ЧитаемыйПул(ИмяПула, Принципал));
КонецФункции

// Тот же пул для запроса, пришедшего его МЕНЯТЬ. Дверь шире двери чтения ровно на ключ,
// которому в этом пуле позволено только писать; хватает ли скоупа на само действие, судит
// гейт мутаций (403), а не эта дверь.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ИмяПула - Строка - имя пула.
//  Принципал - Структура, Неопределено - принципал запроса; Неопределено — аноним.
//
// Возвращаемое значение:
//  Пул, Неопределено - названный пул, если дверь изменения открыта, либо Неопределено.
//
Функция ПулМутации(Ответ, Знач ИмяПула, Знач Принципал) Экспорт
	Возврат ПулЗаДверью(Ответ, ИмяПула, ПулДляИзменения(ИмяПула, Принципал));
КонецФункции

// Пакет в видимом пуле. При отказе сам записывает 404 — вызывающий обязан выйти.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//  Принципал - Структура, Неопределено - принципал запроса; Неопределено — аноним.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля Пул и Пакет — снимки только для чтения, сохранить их
//                            нельзя, — либо Неопределено.
//
Функция ВидимыйПакет(Ответ, Знач ИмяПула, Знач ИмяПакета, Знач Принципал) Экспорт

	Пул = ВидимыйПул(Ответ, ИмяПула, Принципал);
	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПакетЗаДверью(Ответ, Пул, ИмяПакета,
		СервисПакетов.ПакетДляЧтения(Пул.Идентификатор, ИмяПакета));

КонецФункции

// Тот же пакет для запроса, пришедшего его МЕНЯТЬ: дверь мутаций вместо двери чтения.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//  Принципал - Структура, Неопределено - принципал запроса; Неопределено — аноним.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля Пул и Пакет либо Неопределено.
//
Функция ПакетМутации(Ответ, Знач ИмяПула, Знач ИмяПакета, Знач Принципал) Экспорт

	Пул = ПулМутации(Ответ, ИмяПула, Принципал);
	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПакетЗаДверью(Ответ, Пул, ИмяПакета, СервисПакетов.НайтиПакет(Пул.Идентификатор, ИмяПакета));

КонецФункции

// Пул административной операции: невидимый неотличим от отсутствующего (404), видимый
// без прав владельца или администратора — 403. При отказе сам записывает ответ.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ИмяПула - Строка - имя пула.
//  Принципал - Структура, Неопределено - принципал запроса; Неопределено — аноним.
//
// Возвращаемое значение:
//  Пул, Неопределено - администрируемый пул либо Неопределено.
//
Функция АдминистрируемыйПул(Ответ, Знач ИмяПула, Знач Принципал) Экспорт
	Возврат ПулСПравомАдмина(Ответ, ВидимыйПул(Ответ, ИмяПула, Принципал), Принципал);
КонецФункции

// Тот же администрируемый пул для запроса, пришедшего его МЕНЯТЬ: дверь мутаций, затем
// тот же порог владельца или администратора.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ИмяПула - Строка - имя пула.
//  Принципал - Структура, Неопределено - принципал запроса; Неопределено — аноним.
//
// Возвращаемое значение:
//  Пул, Неопределено - администрируемый пул либо Неопределено.
//
Функция АдминистрируемыйПулМутации(Ответ, Знач ИмяПула, Знач Принципал) Экспорт
	Возврат ПулСПравомАдмина(Ответ, ПулМутации(Ответ, ИмяПула, Принципал), Принципал);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Без гварда читаемых пулов у запроса нет ни одного.
Функция ЧитаемыйПул(Знач ИмяПула, Знач Принципал)
	Если ДоступКПулу = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ДоступКПулу.ЧитаемыйПул(ПользовательЗапроса(Принципал), ИмяПула, Принципал);
КонецФункции

Функция ПулДляИзменения(Знач ИмяПула, Знач Принципал)
	Если ДоступКПулу = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ДоступКПулу.ПулДляИзменения(ПользовательЗапроса(Принципал), ИмяПула, Принципал);
КонецФункции

Функция ПулЗаДверью(Ответ, Знач ИмяПула, Знач Пул)
	Если Пул = Неопределено Тогда
		Ответы.Ошибка(Ответ, 404, "pool_not_found",
			СтрШаблон("Пул ""%1"" не найден", ИмяПула));
	КонецЕсли;
	Возврат Пул;
КонецФункции

// Пакет ищется только в пуле за дверью: чтение приносит снимок из кэша, мутация — строку
// из базы; отсутствующий и скрытый дают один 404.
Функция ПакетЗаДверью(Ответ, Знач Пул, Знач ИмяПакета, Знач Пакет)

	Если Пакет = Неопределено ИЛИ Пакет.Скрыт = Истина Тогда
		Ответы.Ошибка(Ответ, 404, "package_not_found",
			СтрШаблон("Пакет ""%1"" не найден", ИмяПакета));
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Пул, Пакет", Пул, Пакет);

КонецФункции

Функция ПулСПравомАдмина(Ответ, Знач Пул, Знач Принципал)
	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ ПорогиПрав.ТребоватьАдмин(Ответ, ПользовательЗапроса(Принципал), Пул) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Пул;
КонецФункции

Функция ПользовательЗапроса(Знач Принципал)
	Возврат ?(Принципал = Неопределено, Неопределено, Принципал.Пользователь);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардДоступаКПулу") _ДоступКПулу,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "ПорогиПравAPI") _ПорогиПрав,
	&Пластилин(Значение = "ОтветыAPI") _Ответы)

	ДоступКПулу = _ДоступКПулу;
	СервисПакетов = _СервисПакетов;
	ПорогиПрав = _ПорогиПрав;
	Ответы = _Ответы;

КонецПроцедуры
