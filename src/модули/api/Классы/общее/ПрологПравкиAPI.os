// Пролог правки пула и пакета: гейт мутации, дверь мутаций и порог права одним вызовом.
// Отказ пишется на месте — вызывающему остаётся выйти.

Перем ГейтМутации;   // ГейтМутацииAPI (api)
Перем Двери;         // ДвериAPI (api)
Перем ПорогиПрав;    // ПорогиПравAPI (api)

#Область ПубличныйИнтерфейс

// Правка пакета: гейт мутации, пакет за дверью мутаций и право управлять пакетом.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ИмяПула - Строка - имя пула из адреса.
//  ИмяПакета - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//
// Возвращаемое значение:
//  Структура, Неопределено - Пул, Пакет, Тело, Пользователь, Принципал либо Неопределено
//                            при отказе.
//
Функция ПравкаПакета(Ответ, Знач ИмяПула, Знач ИмяПакета, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач ТелоЗапроса) Экспорт

	Мутация = ГейтМутации.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, ИмяПула);
	Если Мутация = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Правка = Двери.ПакетМутации(Ответ, ИмяПула, ИмяПакета, Мутация.Принципал);
	Если Правка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ ПорогиПрав.ТребоватьИзменениеПакета(Ответ, Мутация.Пользователь, Правка.Пул, Правка.Пакет) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Правка.Вставить("Тело", Мутация.Тело);
	Правка.Вставить("Пользователь", Мутация.Пользователь);
	Правка.Вставить("Принципал", Мутация.Принципал);
	Возврат Правка;

КонецФункции

// Администрирование пула: гейт мутации, пул за дверью мутаций и право владельца либо
// администратора пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ИмяПула - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//
// Возвращаемое значение:
//  Структура, Неопределено - Пул, Тело, Пользователь, Принципал либо Неопределено при отказе.
//
Функция АдминистрированиеПула(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач ТелоЗапроса) Экспорт

	Мутация = ГейтМутации.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, ИмяПула);
	Если Мутация = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пул = Двери.АдминистрируемыйПулМутации(Ответ, ИмяПула, Мутация.Принципал);
	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Мутация.Вставить("Пул", Пул);
	Возврат Мутация;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГейтМутацииAPI") _ГейтМутации,
	&Пластилин(Значение = "ДвериAPI") _Двери,
	&Пластилин(Значение = "ПорогиПравAPI") _ПорогиПрав)

	ГейтМутации = _ГейтМутации;
	Двери = _Двери;
	ПорогиПрав = _ПорогиПрав;

КонецПроцедуры
