// Вправе ли запрос менять: сессия предъявляет CSRF-токен, ключ доступа — скоуп записи
// и привязку к пулу. Отказ пишется на месте — вызывающему остаётся выйти.

Перем Допуск;        // ДопускAPI (api) — принципал запроса
Перем ГейтКлюча;     // ГейтТокена (вход)
Перем CSRF;          // ЗащитаCSRF (вход)
Перем СервисПулов;   // СервисПулов (реестр) — пул привязки ключа по имени из адреса
Перем Заголовки;     // ЗаголовкиHTTP (основа)
Перем Ответы;        // ОтветыAPI (основа)
Перем Запрос;        // ЗапросAPI (протоколAPI)
Перем Принципалы;    // УчёткаПринципала (права) — чем предъявлен принципал

#Область ПубличныйИнтерфейс

// Пролог мутации: аутентификация, разбор тела и гейт способа аутентификации.
// При отказе сам записывает ответ — вызывающий обязан выйти.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  ИмяПула - Строка - пул, которого касается мутация; пустая строка означает уровень
//            хаба (необязательный, по умолчанию пустая).
//
// Возвращаемое значение:
//  Структура, Неопределено - Пользователь, Принципал, Тело либо Неопределено при отказе.
//
Функция НачатьМутацию(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса,
	Знач ИмяПула = "") Экспорт

	ПринципалЗапроса = Допуск.ТребоватьПринципала(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если ПринципалЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Тело = Запрос.РазобратьТело(ТелоЗапроса, ЗаголовкиЗапроса);
	Если НЕ ПроверитьМутацию(Ответ, ПринципалЗапроса, Тело, ЗаголовкиЗапроса, ИмяПула) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Пользователь, Принципал, Тело",
		ПринципалЗапроса.Пользователь, ПринципалЗапроса, Тело);

КонецФункции

// Гейт мутации по способу аутентификации. Ключ доступа проходит рамками ключа — скоупом
// и привязкой к пулу, CSRF у него не спрашивают: куки при нём нет. Сессия обязана
// предъявить валидный CSRF-токен. При отказе сам записывает 403.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Принципал - Структура - принципал запроса.
//  Тело - Соответствие - разобранное тело запроса, источник поля _csrf.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса, источник X-CSRF-Token.
//  ИмяПула - Строка - пул, которого касается мутация; пустая строка означает уровень
//            хаба, недоступный привязанному ключу (необязательный, по умолчанию пустая).
//
// Возвращаемое значение:
//  Булево - Истина, если мутацию можно выполнять.
//
Функция ПроверитьМутацию(Ответ, Знач Принципал, Знач Тело, Знач ЗаголовкиЗапроса, Знач ИмяПула = "") Экспорт

	Если Принципалы.ЭтоКлюч(Принципал) Тогда
		Возврат КлючВправеМутировать(Ответ, Принципал, ИмяПула);
	КонецЕсли;

	// насквозь проходит только аноним — его отобьёт аутентификация; любой другой способ,
	// кроме сессии, отказ
	Если ПустаяСтрока(Строка(Принципал.Способ)) И Принципал.Пользователь = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если Принципал.Способ <> "session" Тогда
		Ответы.Ошибка(Ответ, 403, "unknown_auth_method",
			"Неизвестный способ аутентификации для мутации");
		Возврат Ложь;
	КонецЕсли;

	ТокенCSRF = Заголовки.Текст(ЗаголовкиЗапроса, "X-CSRF-Token");
	Если НЕ ЗначениеЗаполнено(ТокенCSRF) Тогда
		ТокенCSRF = Запрос.Поле(Тело, CSRF.ИмяПоля());
	КонецЕсли;

	Если НЕ CSRF.Проверить(Принципал.Сессия, ТокенCSRF) Тогда
		Ответы.Ошибка(Ответ, 403, "csrf_failed", "Отсутствует или неверен CSRF-токен");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пул привязки берётся по имени из адреса, а не из тела; без гейта ключа — отказ.
Функция КлючВправеМутировать(Ответ, Знач Принципал, Знач ИмяПула)

	Если ГейтКлюча = Неопределено Тогда
		Ответы.Ошибка(Ответ, 403, "token_gate_missing",
			"Мутация по токену недоступна: гейт ключа доступа не собран");
		Возврат Ложь;
	КонецЕсли;

	ПулИдентификатор = 0;
	Если ЗначениеЗаполнено(ИмяПула) Тогда
		Пул = СервисПулов.НайтиПул(ИмяПула);
		ПулИдентификатор = ?(Пул = Неопределено, 0, Пул.Идентификатор);
	КонецЕсли;

	Вердикт = ГейтКлюча.Проверить(Принципал, "изменение", ПулИдентификатор);
	Если Вердикт.Разрешено Тогда
		Возврат Истина;
	КонецЕсли;

	Если Вердикт.Причина = ГейтКлюча.ПричинаПривязка() Тогда
		Ответы.Ошибка(Ответ, 403, "token_pool_mismatch", "Токен привязан к другому пулу");
	Иначе
		Ответы.Ошибка(Ответ, 403, "token_scope",
			"Токену не хватает скоупа write для этой операции");
	КонецЕсли;
	Возврат Ложь;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ДопускAPI") _Допуск,
	&Пластилин(Значение = "ГейтТокена") _ГейтКлюча,
	&Пластилин(Значение = "ЗащитаCSRF") _CSRF,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ЗаголовкиHTTP") _Заголовки,
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ЗапросAPI") _Запрос,
	&Пластилин(Значение = "УчёткаПринципала") _Принципалы = Неопределено)

	Допуск = _Допуск;
	ГейтКлюча = _ГейтКлюча;
	CSRF = _CSRF;
	СервисПулов = _СервисПулов;
	Заголовки = _Заголовки;
	Ответы = _Ответы;
	Запрос = _Запрос;
	Принципалы = ?(_Принципалы = Неопределено, Новый УчёткаПринципала(), _Принципалы);

КонецПроцедуры
