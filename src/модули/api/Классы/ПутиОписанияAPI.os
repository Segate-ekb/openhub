// Таблица адресов API для машиночитаемого описания: путь, глаголы и сводка каждой
// операции. Отдельно от сборки документа — это данные, а не логика: список растёт
// с каждым новым адресом, и держать его вместе со схемами компонентов значило бы
// смешивать перечень с форматом.
// Соответствия, а не Структуры: ключи-пути и коды ответов не являются идентификаторами BSL.

#Область ПубличныйИнтерфейс

// Все описанные адреса API.
//
// Возвращаемое значение:
//  Соответствие - путь (Строка) -> объект операций OpenAPI.
//
Функция Пути() Экспорт

	Пути = Новый Соответствие();

	Пути.Вставить("/pools", ПутьМетоды(
		Операция("Список видимых пулов (пагинация, отбор по имени параметром query)", "GET"),
		Операция("Создать пул: имя, тип, видимость и необязательная квота (квота_мб | quota_mb:"
			+ " -1 — как в хабе, 0 — без ограничения; задаёт только администратор хаба);"
			+ " право создания на хабе", "POST"), , ));
	Пути.Вставить("/pools/{pool}", ПутьМетоды(Операция("Карточка пула", "GET"), , , ));
	Пути["/pools/{pool}"].Вставить("delete", Операция(
		"Удалить пул вместе со всем содержимым: пакетами и версиями, файлами артефактов,"
		+ " правами и ролями, ключами, подписками, зеркалами, апстримами и заявками."
		+ " Право удаления на уровне хаба. Имя после удаления свободно. Основной пул хаба"
		+ " не удаляется — 422 pool_not_deletable: сначала назначьте основным другой пул",
		"DELETE"));
	Пути.Вставить("/pools/{pool}/packages", ПутьМетоды(Операция("Список/поиск пакетов пула", "GET"), , , ));
	Пути.Вставить("/pools/{pool}/packages/{name}", ПутьМетоды(Операция("Карточка пакета", "GET"), , , ));
	Пути.Вставить("/pools/{pool}/changes", ПутьМетоды(Операция(
		"Срез изменений пула: версии, появившиеся или изменившиеся не раньше момента since"
		+ " (XML-дата; пустой — весь состав пула). Порция задаётся limit в ИМЕНАХ пакетов"
		+ " и продолжается cursor. Ответ несёт as_of — момент снятия среза, с которого"
		+ " спрашивается следующий: по нему зеркало идёт инкрементом, а не перечисляет"
		+ " каталог заново. Непонятный since — 400 invalid_since", "GET"), , , ));
	Пути.Вставить("/pools/{pool}/packages/{name}/versions", ПутьМетоды(
		Операция("Версии пакета (semver + sha256)", "GET"),
		Операция("Публикация версии (raw .ospx); без прав на имя заявка уходит во «входящие» — 202",
			"POST", "202,413,429,507"), , ));
	Пути.Вставить("/pools/{pool}/packages/{name}/versions/{version}",
		ПутьМетоды( , , , Операция("yank/unyank и метки версии", "PATCH")));
	Пути.Вставить("/pools/{pool}/packages/{name}/resolve",
		ПутьМетоды(Операция(
			"Резолв версии: spec — точная версия, имя тега либо semver-выражение; пробуются"
			+ " строго в этом порядке. Пустой spec — версия основного тега пакета."
			+ " Версия ищется во всём, что видит пул: и в его индексе, и в перечнях версий"
			+ " его источников — побеждает самая поздняя. У имени, в которое публиковали"
			+ " здесь, своя версия непобедима на своей координате и уступает только более"
			+ " поздней версии источника."
			+ " Ответ {version, url, sha256, yanked, all_sources_polled}: отозванную версию"
			+ " хаб сам не выбирает, но названную точно называет и помечает yanked;"
			+ " all_sources_polled = false означает, что не все источники опросились и отдали"
			+ " перечень версий, поэтому «версии новее нет» проверенным фактом не является."
			+ " У версии, которую назвал источник, sha256 пуст: её узнает тот, кто пойдёт"
			+ " по адресу загрузки. Признак есть и в отказах."
			+ " Отказы различимы: 404"
			+ " tag_not_found | 404 version_not_found | 422 invalid_spec", "GET"), , , ));
	Пути.Вставить("/pools/{pool}/packages/{name}/readme",
		ПутьМетоды(Операция("README версии (санитизированный HTML)", "GET"), , , ));
	Пути.Вставить("/pools/{pool}/packages/{name}/tags",
		ПутьМетоды(Операция(
			"Каналы пакета: имя, режим, правило, отдаваемая версия, весь состав канала"
			+ " и оформление плашки (style, icon)", "GET"), , , ));
	Пути.Вставить("/pools/{pool}/packages/{name}/tags/{tag}",
		ПутьМетоды( , , Операция("Создать/изменить тег: режим ручной|правило (гейт: изменение пакета)."
			+ " С режимом «ручной» и полем version канал становится РОВНО этой версией, без version —"
			+ " пустым. Оформление: style | стиль (обычный|стабильный|предварительный|устаревший|особый)"
			+ " и icon | значок (ключ из закрытого списка либо пусто); цвет даёт тема клиента,"
			+ " в хабе хранится только ключ. Незнакомый ключ — 422 invalid_style / invalid_icon", "PUT"), ));
	// Упразднённые адреса остаются в описании: иначе клиент со старым кодом не узнает,
	// почему его вызов перестал работать.
	Пути.Вставить("/pools/{pool}/packages/{name}/tags/{tag}/pin",
		ОдинМетод("delete", Операция(
			"УПРАЗДНЕНО (410): режима «пин» нет — ручной тег на одной версии и есть прежний пин",
			"DELETE")));
	Пути.Вставить("/pools/{pool}/packages/{name}/tags/{tag}/versions/{version}",
		ПутьМетоды( , , Операция(
			"Добавить версию в РУЧНОЙ канал, не трогая остальные (гейт: изменение пакета)", "PUT"),
			)); // DELETE добавляется ниже: ПутьМетоды не знает этого глагола
	Пути["/pools/{pool}/packages/{name}/tags/{tag}/versions/{version}"].Вставить("delete",
		Операция("Снять версию с ручного канала (гейт: изменение пакета)", "DELETE"));
	Пути.Вставить("/tags/preview",
		ПутьМетоды( , Операция("Предпросмотр правила тега без записи: версия-кандидат и совпадения", "POST"), , ));
	Пути.Вставить("/pools/{pool}/packages/{name}/channels/{channel}",
		ПутьМетоды( , , Операция("УСТАРЕЛО: канал пакета создаётся как тег того же имени", "PUT"), ));
	Пути.Вставить("/pools/{pool}/channels/{channel}",
		ПутьМетоды( , , Операция("УПРАЗДНЕНО (410): уровня «канал по умолчанию пула» нет — задайте тег на пакете", "PUT"), ));
	// Администрирование: то же, что делают формы кабинета и дома настроек.
	Пути.Вставить("/pools/{pool}/upstreams", ПутьМетоды(
		Операция("Апстримы пула в порядке опроса (владелец/админ пула)", "GET"),
		Операция("Завести апстрим: url, ttl, allowlist, разрешить_приватные, token"
			+ " (токен приватного источника; пустое поле оставляет прежний, снимает"
			+ " token_remove). Значение токена не возвращается: в карточке только"
			+ " token_set", "POST"), , ));
	Пути["/pools/{pool}/upstreams"].Вставить("delete",
		Операция("Снять апстрим пула; url приходит телом", "DELETE"));
	Пути.Вставить("/pools/{pool}/settings", ПутьМетоды(
		Операция("Настройки пула: тип, видимость, квота, приём публикаций", "GET"), , ,
		Операция("Изменить настройки пула: квота (квота_мб | quota_mb: -1 — как в хабе,"
			+ " 0 — без ограничения; меняет только администратор хаба),"
			+ " видимость (видимость | visibility: public|private) и приём публикаций"
			+ " (публикация | publish_allowed); поля указываются в любом сочетании", "PATCH")));
	Пути.Вставить("/pools/{pool}/mirrors", ПутьМетоды(
		Операция("Зеркала пула, включённые и выключенные", "GET"),
		Операция("Завести зеркало: url, режим, фильтр, интервал, token (токен приватного"
			+ " апстрима). Значение токена не возвращается: в карточке только token_set", "POST"), , ));
	Пути.Вставить("/pools/{pool}/mirrors/{id}", ПутьМетоды(
		Операция("Карточка зеркала пула", "GET"), , ,
		Операция("Изменить зеркало: включено, token (пустое поле оставляет прежний токен),"
			+ " token_remove (вернуть анонимное чтение); поля указываются в любом сочетании",
			"PATCH")));
	Пути["/pools/{pool}/mirrors/{id}"].Вставить("delete", Операция("Удалить зеркало пула", "DELETE"));
	Пути.Вставить("/pools/{pool}/mirrors/{id}/sync",
		ПутьМетоды( , Операция("Поставить зеркало в очередь синхронизации: 202 сразу, репликацию ведёт фоновый рабочий; тело — sync (accepted, state, queued) и карточка зеркала; 503 sync_disabled — синхронизация выключена настройкой хаба", "POST", "503", "202"), , ));
	Пути.Вставить("/pools/{pool}/grants", ПутьМетоды(
		Операция("Гранты на пул либо на его пакет (параметр package)", "GET"),
		Операция("Выдать роль субъекту: тип_субъекта, субъект, роль, пакет", "POST"), , ));
	Пути["/pools/{pool}/grants"].Вставить("delete",
		Операция("Отозвать грант субъекта на объект", "DELETE"));
	Пути.Вставить("/groups", ПутьМетоды(
		Операция("Группы: администратору хаба все, остальным свои", "GET"),
		Операция("Создать группу (администратор хаба)", "POST"), , ));
	Пути.Вставить("/groups/{group}", ПутьМетоды(Операция("Карточка группы", "GET"), , , ));
	Пути.Вставить("/groups/{group}/members", ПутьМетоды(
		Операция("Состав группы с источником членства (local | oidc)", "GET"),
		Операция("Добавить участника по логину (администратор хаба)", "POST"), , ));
	Пути.Вставить("/groups/{group}/members/{login}",
		ОдинМетод("delete", Операция("Снять участника группы (администратор хаба)", "DELETE")));
	Пути.Вставить("/groups/{group}/grants",
		ПутьМетоды(Операция("На что есть права у группы", "GET"), , , ));
	Пути.Вставить("/users/{login}/grants",
		ПутьМетоды(Операция("На что есть права у пользователя (свои либо админ хаба)", "GET"), , , ));
	Пути.Вставить("/groups/{group}/oidc-mappings", ПутьМетоды(
		Операция("Правила маппинга клеймов IdP на группу и политика выпавших", "GET"),
		Операция("Завести правило: издатель, клейм, значение (администратор хаба)", "POST"), , ));
	Пути["/groups/{group}/oidc-mappings"].Вставить("delete",
		Операция("Снять правило маппинга (администратор хаба)", "DELETE"));
	Пути.Вставить("/oidc-mappings",
		ПутьМетоды(Операция("Все правила маппинга хаба, отбор параметром issuer", "GET"), , , ));

	// Настройки хаба — та же дверь, что и дом «Хаб»: те же ключи, те же проверки.
	Пути.Вставить("/hub/settings", ПутьМетоды(
		Операция("Настройки хаба (администратор хаба): ключ, раздел дома, тип, значение,"
			+ " источник (конфиг | база | дефолт), признак «правится ли» и имя переменной"
			+ " окружения. Параметр section сужает выдачу до раздела («mail», «branding», …),"
			+ " незнакомый раздел — 404 unknown_section. Секретная настройка отдаётся маской"
			+ " и признаком is_set: введённое значение не читается", "GET"), , , ));
	Пути.Вставить("/hub/settings/{key}", ПутьМетоды(
		Операция("Карточка одной настройки хаба", "GET"), , ,
		Операция("Задать значение (значение | value); тип и допустимые значения судит тот же"
			+ " реестр настроек, что и форма дома «Хаб», а правка ложится в журнал аудита"
			+ " с автором запроса. Заданное конфигурацией не правится — 409 forced_by_config,"
			+ " настройка развёртывания — 409 not_editable, настройка с переходом (поле"
			+ " mechanism: выключение парольного входа, личные пространства) —"
			+ " 409 mechanism_only, непринятое значение — 422 invalid_value", "PATCH")));
	Пути["/hub/settings/{key}"].Вставить("delete",
		Операция("Убрать заданное значение настройки: действующим снова становится"
			+ " конфигурация либо умолчание", "DELETE"));

	Пути.Вставить("/pools/{pool}/packages/{name}/trusted-workflows", ПутьМетоды(
		Операция("Доверенные конвейеры пакета: провайдер, издатель, репозиторий, конвейер,"
			+ " реф, кем и когда заведено (мейнтейнер пакета и выше)", "GET"),
		Операция("Доверить конвейеру: провайдер | provider (github | gitlab), репозиторий |"
			+ " repository и реф | ref ОБЯЗАТЕЛЬНЫ; издатель | issuer выводится из провайдера,"
			+ " если не задан. Конвейер | workflow необязателен (пусто — любой конвейер"
			+ " репозитория). Короткие значения хаб достраивает до клеймов: имя файла"
			+ " («e2e.yml»), имя ветки («develop»), тег — при ref_kind | вид_рефа = «тег» либо"
			+ " «tag» («ветка», «branch» и пусто — ветка; иное значение отвергается 400)."
			+ " Реф принимает глоб-маску: «*» — любые символы, кроме «/», «**» — включая «/»"
			+ " («v*» → refs/tags/v1.2.3, «**» → любой реф). Пустой реф отвергается: он означал"
			+ " бы публикацию с любой ветки репозитория. Повтор той же записи идемпотентен"
			+ " (200 вместо 201)", "POST", "200"), , ));
	Пути.Вставить("/pools/{pool}/packages/{name}/trusted-workflows/{id}",
		ОдинМетод("delete", Операция("Отозвать доверие конвейеру; запись ищется в пакете из"
			+ " адреса, чужая — 404", "DELETE")));
	Пути.Вставить("/pools/{pool}/packages/{name}/trusted-workflows/{id}/delete", ПутьМетоды( ,
		Операция("Отзыв доверия для клиентов без DELETE — то же, что DELETE записи", "POST", , "200"), , ));

	Пути.Вставить("/inbox", ПутьМетоды(
		Операция("Заявки на публикацию из всех пулов, где вы мейнтейнер и выше", "GET"), , , ));
	Пути.Вставить("/pools/{pool}/inbox", ПутьМетоды(
		Операция("Заявки на публикацию, ждущие решения в пуле (мейнтейнер пула и выше)", "GET"), , , ));
	Пути.Вставить("/pools/{pool}/inbox/{id}/approve", ПутьМетоды( ,
		Операция("Одобрить заявку: версия публикуется от имени заявителя, он становится"
			+ " мейнтейнером пакета", "POST"), , ));
	Пути.Вставить("/pools/{pool}/inbox/{id}/reject", ПутьМетоды( ,
		Операция("Отклонить заявку: артефакт стирается, права не выдаются; причина"
			+ " (причина | reason) видна заявителю", "POST"), , ));

	Пути.Вставить("/search", ПутьМетоды(Операция("Глобальный поиск (проброс субъекта)", "GET"), , , ));
	Пути.Вставить("/users", ПутьМетоды( , Операция("Регистрация пользователя (онбординг-политика)", "POST"), , ));
	Пути.Вставить("/tokens", ПутьМетоды(
		Операция("Список PAT текущего пользователя", "GET"),
		Операция("Выпустить PAT (значение — один раз): срок_дней (expires_in_days) от 1 до"
			+ " потолка хаба, пропуск и ноль дают срок по умолчанию — бессрочных не бывает;"
			+ " пулы (pools) — набор идентификаторов, за пределами которого ключ не работает,"
			+ " пустой набор означает весь хаб, незнакомый идентификатор в наборе — 400"
			+ " pool_not_found. Одиночное пул (pool) прежних клиентов принимается по старым,"
			+ " более мягким правилам: с видимостью не сверяется. Оба поля разом — 400"
			+ " pool_fields_conflict",
			"POST"), , ));
	Пути.Вставить("/tokens/{id}", ОдинМетод("delete", Операция("Отозвать PAT", "DELETE")));
	// Вход CLI через браузер (RFC 8628): обе точки анонимны, разрешение даёт человек.
	Пути.Вставить("/cli/auth/device", ПутьМетоды( , Операция(
		"Завести заявку входа CLI: client_name, scopes (read | write). Ответ 201:"
		+ " device_code, user_code, verification_uri, verification_uri_complete,"
		+ " expires_in, interval. Ошибки потока — в форме RFC 8628 (error,"
		+ " error_description): invalid_scope | invalid_request", "POST"), , ));
	Пути.Вставить("/cli/auth/device/token", ПутьМетоды( , Операция(
		"Опрос по device_code. 200: access_token, token_type, scope, token_id."
		+ " 400 с полем error: authorization_pending | slow_down | access_denied"
		+ " | expired_token", "POST"), , ));
	// Выдача для opm: те же адреса, что читает немодифицированный клиент.
	Пути.Вставить("/pools/{pool}/download/list.txt",
		ПутьМетоды(Операция("Имена пакетов пула, text/plain (ПутьНаСервере в opm.cfg)", "GET"), , , ));
	Пути.Вставить("/pools/{pool}/download/{name}/{file}",
		ПутьМетоды(Операция(ОписаниеАртефакта(), "GET"), , , ));
	Пути.Вставить("/pools/{pool}/channels/{channel}/download/list.txt",
		ПутьМетоды(Операция("Имена пакетов пула в разрезе тега {channel}", "GET"), , , ));
	Пути.Вставить("/pools/{pool}/channels/{channel}/download/{name}/{file}",
		ПутьМетоды(Операция("Артефакт .ospx в разрезе тега {channel}: безверсионное имя файла"
			+ " отдаёт версию этого тега, в остальном — то же, что и на пуловом адресе."
			+ " " + ОписаниеАртефакта(), "GET"), , , ));
	Пути.Вставить("/pools/{pool}/push", ПутьМетоды( ,
		Операция("Публикация: сырой .ospx, заголовки FILE-NAME, CHANNEL, OAUTH-TOKEN|Authorization"
			+ " (РесурсПубликацииПакетов в opm.cfg; принимается и PUT)", "POST", "202,413,429,507"), , ));

	// Подписки объекта — тот же набор действий, что и в кабинете. Секрет подписи вебхука
	// отдаётся ровно один раз, в ответе на создание; токен бота не отдаётся никогда.
	Пути.Вставить("/webhook-meta", ПутьМетоды(Операция(
		"Справочник подписок: типы событий (события) и типы доставки с именами полей"
		+ " настроек (kinds); секретные поля помечены, значений в справочнике нет", "GET"), , , ));
	Пути.Вставить("/webhooks", ПутьМетоды(
		Операция("Подписки ХАБА (администратор хаба)", "GET"),
		Операция("Завести подписку хаба: тип | kind, поля типа по справочнику, события | events;"
			+ " секрет подписи в ответе один раз", "POST"), , ));
	Пути.Вставить("/webhooks/{id}", ПутьМетоды(Операция("Карточка подписки хаба", "GET"), , ,
		Операция("Поправить подписку хаба: поля типа, события, включено — присланное меняется,"
			+ " остальное остаётся прежним", "PATCH")));
	Пути["/webhooks/{id}"].Вставить("delete", Операция("Удалить подписку хаба", "DELETE"));
	Пути.Вставить("/pools/{pool}/webhooks", ПутьМетоды(
		Операция("Подписки пула (владелец либо администратор пула)", "GET"),
		Операция("Завести подписку пула", "POST"), , ));
	Пути.Вставить("/pools/{pool}/webhooks/{id}", ПутьМетоды(Операция("Карточка подписки пула", "GET"),
		, , Операция("Поправить подписку пула", "PATCH")));
	Пути["/pools/{pool}/webhooks/{id}"].Вставить("delete", Операция("Удалить подписку пула", "DELETE"));
	Пути.Вставить("/pools/{pool}/packages/{name}/webhooks", ПутьМетоды(
		Операция("Подписки пакета (право изменения пакета)", "GET"),
		Операция("Завести подписку пакета", "POST"), , ));
	Пути.Вставить("/pools/{pool}/packages/{name}/webhooks/{id}",
		ПутьМетоды(Операция("Карточка подписки пакета", "GET"), , ,
			Операция("Поправить подписку пакета", "PATCH")));
	Пути["/pools/{pool}/packages/{name}/webhooks/{id}"].Вставить("delete",
		Операция("Удалить подписку пакета", "DELETE"));

	Пути.Вставить("/health", ПутьМетоды(Операция("Живость хаба", "GET"), , , ));
	Пути.Вставить("/ready", ПутьМетоды(Операция("Готовность хаба (readiness)", "GET"), , , ));
	Пути.Вставить("/metrics", ПутьМетоды(Операция("Эксплуатационные метрики", "GET"), , , ));

	Возврат Пути;

КонецФункции

#КонецОбласти

#Область КонструкторыФрагментов

// Любая из операций может быть Неопределено. DELETE не поддерживается — его дописывают
// в готовый объект пути.
Функция ПутьМетоды(Знач ГЕТ = Неопределено, Знач ПОСТ = Неопределено, Знач ПУТ = Неопределено, Знач ПАТЧ = Неопределено)
	Объект = Новый Соответствие();
	Если ГЕТ <> Неопределено Тогда Объект.Вставить("get", ГЕТ); КонецЕсли;
	Если ПОСТ <> Неопределено Тогда Объект.Вставить("post", ПОСТ); КонецЕсли;
	Если ПУТ <> Неопределено Тогда Объект.Вставить("put", ПУТ); КонецЕсли;
	Если ПАТЧ <> Неопределено Тогда Объект.Вставить("patch", ПАТЧ); КонецЕсли;
	Возврат Объект;
КонецФункции

Функция ОдинМетод(Знач Метод, Знач Операция)
	Объект = Новый Соответствие();
	Объект.Вставить(Метод, Операция);
	Возврат Объект;
КонецФункции

// Язык адреса артефакта один на все его формы, поэтому описание у них общее: разъехавшись,
// пуловый и канальный адреса научили бы интегратора разному про один и тот же контракт.
Функция ОписаниеАртефакта()

	Возврат "Артефакт .ospx. Имя файла: {name}.ospx — версия основного тега пакета,"
		+ " {name}-{spec}.ospx — версия по спецификации. Спецификация — точная версия,"
		+ " имя тега либо semver-выражение; пробуются строго в этом порядке."
		+ " Необязательный параметр ?spec= говорит то же самое явно и старше версионного"
		+ " слота имени файла: он для клиента, который умеет, а имя файла — для того,"
		+ " который нет. Ничего не подошло — 404, а не «последняя вообще»."
		+ " Cache-Control: immutable на названной клиентом версии публичного пула,"
		+ " no-cache на выбранной хабом, private, no-store на приватном пуле";

КонецФункции

// Типовые ответы: 200 либо 201 на успех и единый Error на 4xx. Операция, у которой есть
// свои коды (публикация отвечает 202, 413 и 429), перечисляет их третьим аргументом:
// адреса, чьи коды не описаны, клиент разбирает наугад. Четвёртый аргумент задаёт код
// успеха там, где умолчание по глаголу врёт (POST-действие, ничего не создающее).
Функция Операция(Знач Сводка, Знач ВербHTTP, Знач ОсобыеКоды = "", Знач КодУспеха = "")

	Опер = Новый Соответствие();
	Опер.Вставить("summary", Сводка);

	Ответы_ = Новый Соответствие();
	УспехКод = ?(ЗначениеЗаполнено(КодУспеха), КодУспеха, ?(ВербHTTP = "POST", "201", "200"));
	УспехОтвет = Новый Соответствие();
	УспехОтвет.Вставить("description", "Успех");
	Ответы_.Вставить(УспехКод, УспехОтвет);

	Для Каждого Код Из СтрРазделить("400,401,403,404,409,422", ",") Цикл
		Ответы_.Вставить(Код, ОтветОшибки());
	КонецЦикла;

	Если ЗначениеЗаполнено(ОсобыеКоды) Тогда
		Для Каждого Код Из СтрРазделить(ОсобыеКоды, ",") Цикл
			Ответы_.Вставить(Код, ОписаниеКода(Код));
		КонецЦикла;
	КонецЕсли;

	Опер.Вставить("responses", Ответы_);
	Возврат Опер;

КонецФункции

// 2xx описывает себя словами, 4xx едет единой схемой Error.
Функция ОписаниеКода(Знач Код)

	Если Код = "200" Тогда
		Ответ = Новый Соответствие();
		Ответ.Вставить("description",
			"Успех без создания: запрошенное состояние уже действует (идемпотентный повтор)");
		Возврат Ответ;
	КонецЕсли;

	Если Код = "201" Тогда
		Ответ = Новый Соответствие();
		Ответ.Вставить("description", "Создано");
		Возврат Ответ;
	КонецЕсли;

	Если Код = "202" Тогда
		Ответ = Новый Соответствие();
		Ответ.Вставить("description",
			"Принято во «входящие»: заявка ждёт рассмотрения, версии ещё нет"
			+ " (тело {status:""queued"",message})");
		Возврат Ответ;
	КонецЕсли;

	Если Код = "507" Тогда
		Ответ = Новый Соответствие();
		Ответ.Вставить("description",
			"Квота пула исчерпана: артефакт в неё не помещается (код ошибки quota_exceeded)");
		Возврат Ответ;
	КонецЕсли;

	Возврат ОтветОшибки();

КонецФункции

Функция ОтветОшибки()
	Содержимое = Новый Соответствие();
	JSONМедиа = Новый Соответствие();
	Ссылка = Новый Соответствие();
	Ссылка.Вставить("$ref", "#/components/schemas/Error");
	JSONМедиа.Вставить("schema", Ссылка);
	Содержимое.Вставить("application/json", JSONМедиа);

	Ответ = Новый Соответствие();
	Ответ.Вставить("description", "Ошибка в едином формате {error:{code,message}}");
	Ответ.Вставить("content", Содержимое);
	Возврат Ответ;
КонецФункции

#КонецОбласти

&Прозвище("ПутиОписанияAPI")
&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
