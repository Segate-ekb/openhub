// Пролог маршрута API: ответ stateless, адрес точный, метод разрешённый.
// Отказ пишется на месте — вызывающему остаётся выйти.

Перем Ответы;        // ОтветыAPI (auth)
Перем ПустыеКуки;    // Куки (winow)
Перем HTTP;          // МетодыHTTP (основа)

// Пролог всякого маршрута API: ответ stateless (кука снята) и адрес точный (лишнего
// хвоста нет). Ложь означает, что ответ уже записан и вызывающий обязан выйти.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Порядковые - Массив, Неопределено - лишние сегменты пути.
//
// Возвращаемое значение:
//  Булево - Истина, если маршрут можно исполнять.
//
Функция Начать(Ответ, Знач Порядковые) Экспорт
	СнятьКуку(Ответ);
	Возврат НЕ ЛишнийХвостПути(Ответ, Порядковые);
КонецФункции

// Тот же пролог для маршрута, который только читает: чужой метод отбивается 405.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Порядковые - Массив, Неопределено - лишние сегменты пути.
//  МетодЗапроса - Строка - метод запроса.
//
// Возвращаемое значение:
//  Булево - Истина, если маршрут можно исполнять.
//
Функция НачатьЧтение(Ответ, Знач Порядковые, Знач МетодЗапроса) Экспорт
	Возврат НачатьДействие(Ответ, Порядковые, МетодЗапроса, "GET");
КонецФункции

// Тот же пролог для маршрута с единственным действием: назван его метод, прочие — 405.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Порядковые - Массив, Неопределено - лишние сегменты пути.
//  МетодЗапроса - Строка - метод запроса.
//  Разрешённый - Строка - единственный метод, который маршрут обслуживает.
//
// Возвращаемое значение:
//  Булево - Истина, если маршрут можно исполнять.
//
Функция НачатьДействие(Ответ, Знач Порядковые, Знач МетодЗапроса, Знач Разрешённый) Экспорт

	Если НЕ Начать(Ответ, Порядковые) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, Разрешённый) Тогда
		МетодНеРазрешён(Ответ, Разрешённый);
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// winow отдаёт обработчику ближайшего совпавшего уровня остаток пути, поэтому короткий
// адрес исполняется вместо длинного, если гвард не поставлен. Истина означает, что
// 404 уже записан и вызывающий обязан выйти.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Порядковые - Массив, Неопределено - лишние сегменты пути.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЛишнийХвостПути(Ответ, Знач Порядковые) Экспорт

	Если Порядковые = Неопределено ИЛИ Порядковые.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Ответы.Ошибка(Ответ, 404, "unknown_path", СтрШаблон(
		"Такого адреса нет: лишние сегменты пути ""%1""", СтрСоединить(Порядковые, "/")));
	Возврат Истина;

КонецФункции

// Записывает 405 с заголовком Allow.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Разрешённые - Строка - список методов через запятую.
//
Процедура МетодНеРазрешён(Ответ, Знач Разрешённые) Экспорт
	Ответ.Заголовки["Allow"] = Разрешённые;
	Ответы.Ошибка(Ответ, 405, "method_not_allowed",
		СтрШаблон("Разрешены методы: %1", Разрешённые));
КонецПроцедуры

// Снимает сессионную куку с ответа: ответы API stateless.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//
Процедура СнятьКуку(Ответ) Экспорт
	Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "Куки") _ПустыеКуки,
	&Пластилин(Значение = "МетодыHTTP") _HTTP)

	Ответы = _Ответы;
	ПустыеКуки = _ПустыеКуки;
	HTTP = _HTTP;

КонецПроцедуры
