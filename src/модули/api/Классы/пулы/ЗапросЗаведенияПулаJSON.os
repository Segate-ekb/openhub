// Тело заведения пула.

&Сериализуемое("name")
&Заполнено
&Тип("Строка")
Перем Имя;

&Сериализуемое("type")
&Тип("Строка")
&ОдинИз("custom", "user")
Перем Тип;

&Сериализуемое("visibility")
&Тип("Строка")
&ОдинИз("public", "private")
Перем Видимость;

&Сериализуемое("quota_mb")
&Тип("Число")
Перем КвотаМб;
