// Ответ адреса тега пула: тег после записи либо итог удаления — у адреса одна схема на оба глагола.

&Сериализуемое("name")
&Тип("Строка")
Перем Имя;

&Сериализуемое("rule")
&Тип("Строка")
Перем Правило;

&Сериализуемое("rule_type")
&Тип("Строка")
&ОдинИз("semver", "regex", "")
Перем ТипПравила;

&Сериализуемое("default")
&Тип("Булево")
Перем ПоУмолчанию;

&Сериализуемое("overwrite_allowed")
&Тип("Булево")
Перем ПерезаписьРазрешена;

&Сериализуемое("warning")
&Тип("Строка")
Перем Предупреждение;

&Сериализуемое("style")
&Тип("Строка")
&ОдинИз("plain", "stable", "prerelease", "deprecated", "special", "")
Перем Стиль;

&Сериализуемое("icon")
&Тип("Строка")
&ОдинИз("", "check", "verified", "warning", "stop", "lock", "history", "cube", "key")
Перем Значок;

&Сериализуемое("deleted")
&Тип("Булево")
Перем Удалён;
