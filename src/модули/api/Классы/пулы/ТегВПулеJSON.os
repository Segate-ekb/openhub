// Тег пула: правило, по которому тег достаётся пакетам пула.

&Сериализуемое("name")
&Заполнено
&Тип("Строка")
Перем Имя;

&Сериализуемое("rule")
&Заполнено
&Тип("Строка")
Перем Правило;

&Сериализуемое("rule_type")
&Заполнено
&Тип("Строка")
&ОдинИз("semver", "regex", "")
Перем ТипПравила;

&Сериализуемое("default")
&Заполнено
&Тип("Булево")
Перем ПоУмолчанию;

&Сериализуемое("overwrite_allowed")
&Заполнено
&Тип("Булево")
Перем ПерезаписьРазрешена;

&Сериализуемое("warning")
&Заполнено
&Тип("Строка")
Перем Предупреждение;

&Сериализуемое("style")
&Заполнено
&Тип("Строка")
&ОдинИз("plain", "stable", "prerelease", "deprecated", "special", "")
Перем Стиль;

&Сериализуемое("icon")
&Заполнено
&Тип("Строка")
&ОдинИз("", "check", "verified", "warning", "stop", "lock", "history", "cube", "key")
Перем Значок;
