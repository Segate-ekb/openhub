// Тело записи тега пула.

&Сериализуемое("rule")
Перем Правило;

&Сериализуемое("ruleType")
&ОдинИз("semver", "regex")
Перем ТипПравила;

&Сериализуемое("mode")
Перем Режим;

&Сериализуемое("default")
Перем ПоУмолчанию;

&Сериализуемое("overwrite_allowed")
Перем ПерезаписьРазрешена;

&Сериализуемое("style")
Перем Стиль;

&Сериализуемое("icon")
Перем Значок;
