// Настройки пула: то, чем распоряжается его администратор.

&Сериализуемое("pool")
&Заполнено
&Тип("Строка")
Перем Пул;

&Сериализуемое("type")
&Заполнено
&Тип("Строка")
&ОдинИз("user", "custom")
Перем Тип;

&Сериализуемое("visibility")
&Заполнено
&Тип("Строка")
&ОдинИз("public", "private")
Перем Видимость;

&Сериализуемое("quota_mb")
&Заполнено
&Тип("Число")
Перем КвотаМб;

&Сериализуемое("publish_allowed")
&Заполнено
&Тип("Булево")
Перем ПубликацияРазрешена;

&Сериализуемое("upstreams_allowed")
&Заполнено
&Тип("Булево")
Перем АпстримыДопустимы;

&Сериализуемое("pool_tags")
&Заполнено
&Тип("Булево")
Перем ТегиПула;
