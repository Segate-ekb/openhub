// Карточка пула в ответах API.

&Сериализуемое("id")
&Заполнено
&Тип("Число")
Перем Ид;

&Сериализуемое("name")
&Заполнено
&Тип("Строка")
Перем Имя;

&Сериализуемое("type")
&Заполнено
&Тип("Строка")
&ОдинИз("user", "custom")
Перем Тип;

&Сериализуемое("visibility")
&Заполнено
&Тип("Строка")
&ОдинИз("public", "private")
Перем Видимость;

&Сериализуемое("default")
&Заполнено
&Тип("Булево")
Перем Основной;

&Сериализуемое("owner_id")
&Заполнено
&Тип("Число")
Перем ИдВладельца;

&Сериализуемое("created")
&Заполнено
&Тип("Строка")
Перем Создан;
