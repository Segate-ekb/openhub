// Теги пула в API: набор тегов-правил, который наследуют пакеты пула, пока у пула включена
// галка «теги пула для пакетов» (`pool_tags` в настройках пула).

Перем Ответы;         // ОтветыAPI (основа)
Перем Запрос;         // ЗапросAPI (протоколAPI)
Перем Маршрут;        // МаршрутAPI (протоколAPI)
Перем Допуск;         // ДопускAPI (api)
Перем Двери;          // ДвериAPI (api)
Перем ПрологПравки;  // ПрологПравкиAPI (api)
Перем Страницы;       // СтраницыAPI (протоколAPI)
Перем ТегиПула;       // СервисТеговПула (реестр)
Перем СервисТегов;    // СервисТегов (реестр) — алфавит имени тега
Перем Режимы;         // РежимТега (реестр)
Перем Типы;           // ТипПравилаТега (реестр)
Перем Стили;          // СтильТега (реестр)
Перем Значки;         // ЗначокТега (реестр)
Перем HTTP;           // МетодыHTTP (основа)

#Область ТочкиМаршрута

// Теги пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию — весь список).
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/tags", Метод = "get")
&Группа("Теги")
&Операция(Сводка = "Теги пула",
	Описание = "Теги-правила, которые наследуют пакеты пула, и галка `enabled`: выключена — пакеты
	|их не наследуют, набор хранится.")
&Возвращает(Код = 200, Описание = "Теги пула")
&Возвращает(Код = 404, Описание = "`pool_not_found`")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
Процедура ТегиПулаСписком(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	page = "", pageSize = "", ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.НачатьЧтение(Ответ, ПараметрыЗапросаПорядковые, МетодЗапроса) Тогда
		Возврат;
	КонецЕсли;

	Видимый = Двери.ВидимыйПул(Ответ, Пул, Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса));
	Если Видимый = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Теги = Новый Массив();
	Для Каждого ТегПула Из ТегиПула.ТегиПула(Видимый.Идентификатор) Цикл
		Теги.Добавить(ТегПулаJSON(ТегПула));
	КонецЦикла;

	Тело = Страницы.Перечень(Теги, page, pageSize, "tags");
	Тело.Вставить("enabled", ТегиПула.НаследованиеВключено(Видимый));
	Ответы.JSON(Ответ, 200, Тело);

КонецПроцедуры

// Заведение, правка и удаление тега пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Тег - Строка - имя тега из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело с правилом и оформлением.
//  МетодЗапроса - Строка - метод запроса; допустимы PUT и DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/tags/{Тег}", Метод = "put, delete")
&Группа("Теги")
&Операция(Сводка = "Заведение и правка тега пула (PUT); удаление тега пула (DELETE)",
	Описание = "PUT — заводит или правит тег-правило пула `rule` (`ruleType`: semver или regex).
	|DELETE — удаляет тег пула; копии у пакетов остаются их тегами. Нужно право администрировать пул.")
&Возвращает(Код = 200, Описание = "PUT: тег пула; DELETE: тег удалён")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 404, Описание = "`tag_not_found`, `pool_not_found`")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`invalid_*`, `tag_name_is_version` — тег пула не принят")
Процедура ТегПула(Ответ, Пул, Тег, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "PUT") И НЕ HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		Маршрут.МетодНеРазрешён(Ответ, "PUT, DELETE");
		Возврат;
	КонецЕсли;

	Правка = ПрологПравки.АдминистрированиеПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Правка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		Если НЕ ТегиПула.УдалитьТегПула(Правка.Пул.Идентификатор, Тег, ЛогинАвтора(Правка)) Тогда
			Ответы.Ошибка(Ответ, 404, "tag_not_found", СтрШаблон("Тег пула ""%1"" не найден", Тег));
			Возврат;
		КонецЕсли;
		Ответы.JSON(Ответ, 200, Новый Структура("deleted", Истина));
		Возврат;
	КонецЕсли;

	СохранитьТегПула(Ответ, Правка, Тег);

КонецПроцедуры

#КонецОбласти

#Область Действия

// Ожидаемые отказы — до мутации, каждый своим кодом; нераспознанное доходит до 500.
Процедура СохранитьТегПула(Ответ, Знач Правка, Знач Тег)

	Тело = Правка.Тело;
	ПулИдентификатор = Правка.Пул.Идентификатор;
	Правило = Запрос.Поле(Тело, "rule", Запрос.Поле(Тело, "правило"));
	ТипПравила = Запрос.Поле(Тело, "ruleType", Запрос.Поле(Тело, "тип_правила", Типы.Semver()));
	Режим = НРег(СокрЛП(Строка(Запрос.Поле(Тело, "mode", Запрос.Поле(Тело, "режим", Режимы.Правило())))));

	Если НЕ СервисТегов.ИмяДопустимо(Тег) Тогда
		Ответы.Ошибка(Ответ, 422, "invalid_tag", СтрШаблон(
			"Недопустимое имя тега ""%1"": латиница, цифры, дефис, подчёркивание и точка,"
			+ " не длиннее 64 символов", Тег));
		Возврат;
	КонецЕсли;

	Если Режим <> Режимы.Правило() И Режим <> "rule" Тогда
		Ответы.Ошибка(Ответ, 422, "invalid_mode",
			"У пула только теги-правила: ручной состав ведут у пакета");
		Возврат;
	КонецЕсли;

	Оформление = ОформлениеИзТела(Тело);
	Если Оформление <> Неопределено И НЕ Стили.Допустим(Оформление.Стиль) Тогда
		Ответы.Ошибка(Ответ, 422, "invalid_style", СтрШаблон(
			"Неизвестный стиль тега: допустимы %1", СтрСоединить(Стили.Все(), ", ")));
		Возврат;
	КонецЕсли;
	Если Оформление <> Неопределено И НЕ Значки.Допустим(Оформление.Значок) Тогда
		Ответы.Ошибка(Ответ, 422, "invalid_icon", СтрШаблон(
			"Неизвестный значок тега: допустимы %1 либо пусто", СтрСоединить(Значки.Все(), ", ")));
		Возврат;
	КонецЕсли;

	Если ТегиПула.ИмяДляТегаПулаЗанято(ПулИдентификатор, Тег) Тогда
		Ответы.Ошибка(Ответ, 422, "tag_name_is_version", СтрШаблон(
			"Имя тега ""%1"" занято версией пакета этого пула: спецификацию ""пакет@%1"" резолв"
			+ " читает сначала точной версией, и тег у этого пакета остался бы недостижим."
			+ " Назовите тег иначе", Тег));
		Возврат;
	КонецЕсли;

	Попытка
		Запись = ТегиПула.ОпределитьТегПула(ПулИдентификатор, Тег, ТипПравила, Правило,
			ЛогинАвтора(Правка), Оформление);
	Исключение
		// текст домена несёт пользовательский ввод — наружу уходит фиксированный
		Ответы.Сбой(Ответ, 422, "invalid_tag", "Некорректный тег пула (имя, тип правила или правило)",
			ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Запрос.Поле(Тело, "default", Запрос.Поле(Тело, "по_умолчанию"))) Тогда
		ТегиПула.НазначитьОсновным(ПулИдентификатор, Запись.Имя);
	КонецЕсли;

	Присланное = Запрос.Присланное(Тело, "overwrite_allowed,перезапись_разрешена");
	Если Присланное <> Неопределено Тогда
		ТегиПула.УстановитьЗапретПерезаписи(ПулИдентификатор, Запись.Имя,
			НЕ Запрос.ВБулево(Строка(Присланное)), ЛогинАвтора(Правка));
	КонецЕсли;

	Ответы.JSON(Ответ, 200, ТегПулаJSON(ТегиПула.НайтиТегПула(ПулИдентификатор, Запись.Имя)));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТегПулаJSON(Знач ТегПула)

	Правило = ТегиПула.ПравилоТегаПула(ТегПула);

	Структура = Новый Структура();
	Структура.Вставить("name", Строка(ТегПула.Имя));
	Структура.Вставить("rule", ?(Правило = Неопределено, "", Правило.Выражение));
	Структура.Вставить("rule_type", ?(Правило = Неопределено, "", Правило.Тип));
	Структура.Вставить("default", ТегПула.ПоУмолчанию = Истина);
	Структура.Вставить("overwrite_allowed", ТегиПула.ЗапретСнят(ТегПула));
	Структура.Вставить("warning", ?(Правило = Неопределено, "", Правило.Предупреждение()));
	Структура.Вставить("style", Строка(?(ТегПула.Стиль = Неопределено, "", ТегПула.Стиль)));
	Структура.Вставить("icon", Строка(?(ТегПула.Значок = Неопределено, "", ТегПула.Значок)));
	Возврат Структура;

КонецФункции

// Ни одного поля в теле — Неопределено: тег, у которого меняют правило, оформления не теряет.
Функция ОформлениеИзТела(Знач Тело)

	Стиль = Запрос.Присланное(Тело, "style,стиль");
	Значок = Запрос.Присланное(Тело, "icon,значок");

	Если Стиль = Неопределено И Значок = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Стиль, Значок",
		?(Стиль = Неопределено, "", Строка(Стиль)), ?(Значок = Неопределено, "", Строка(Значок)));

КонецФункции

Функция ЛогинАвтора(Знач Правка)
	Возврат ?(Правка.Пользователь = Неопределено, "", Строка(Правка.Пользователь.Логин));
КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ЗапросAPI") _Запрос,
	&Пластилин(Значение = "МаршрутAPI") _Маршрут,
	&Пластилин(Значение = "ДопускAPI") _Допуск,
	&Пластилин(Значение = "ДвериAPI") _Двери,
	&Пластилин(Значение = "ПрологПравкиAPI") _ПрологПравки,
	&Пластилин(Значение = "СтраницыAPI") _Страницы,
	&Пластилин(Значение = "СервисТеговПула") _ТегиПула,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "РежимТега") _Режимы,
	&Пластилин(Значение = "ТипПравилаТега") _Типы,
	&Пластилин(Значение = "СтильТега") _Стили,
	&Пластилин(Значение = "ЗначокТега") _Значки,
	&Пластилин(Значение = "МетодыHTTP") _HTTP)

	Ответы = _Ответы;
	Запрос = _Запрос;
	Маршрут = _Маршрут;
	Допуск = _Допуск;
	Двери = _Двери;
	ПрологПравки = _ПрологПравки;
	Страницы = _Страницы;
	ТегиПула = _ТегиПула;
	СервисТегов = _СервисТегов;
	Режимы = _Режимы;
	Типы = _Типы;
	Стили = _Стили;
	Значки = _Значки;
	HTTP = _HTTP;

КонецПроцедуры
