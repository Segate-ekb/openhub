// Теги пула и галка их наследования пакетами.

&Сериализуемое("tags")
&Заполнено
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("ТегВПулеJSON")
Перем Теги;

&Сериализуемое("page")
&Заполнено
&Тип("Число")
Перем Номер;

&Сериализуемое("pageSize")
&Заполнено
&Тип("Число")
Перем Размер;

&Сериализуемое("total")
&Заполнено
&Тип("Число")
Перем Всего;

&Сериализуемое("has_more")
&Заполнено
&Тип("Булево")
Перем ЕстьЕщё;

&Сериализуемое("enabled")
&Заполнено
&Тип("Булево")
Перем НаследованиеВключено;
