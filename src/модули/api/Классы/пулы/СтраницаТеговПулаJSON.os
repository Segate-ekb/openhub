// Теги пула и галка их наследования пакетами.

// BSLLS:MissingVariablesDescription-off
&Сериализуемое("tags")
&Заполнено
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("ТегВПулеJSON")
Перем Теги;

&Сериализуемое("page")
&Заполнено
&Тип("Число")
Перем Номер;

&Сериализуемое("pageSize")
&Заполнено
&Тип("Число")
Перем Размер;

&Сериализуемое("total")
&Заполнено
&Тип("Число")
Перем Всего;

&Сериализуемое("has_more")
&Заполнено
&Тип("Булево")
Перем ЕстьЕще;

&Сериализуемое("enabled")
&Заполнено
&Тип("Булево")
Перем НаследованиеВключено;
// BSLLS:MissingVariablesDescription-on
