// Пулы в API: список, карточка, заведение, удаление и назначение основного пула. Мутации
// ведёт СлужбаДоступа, чтение и запрет удаления — СервисПулов.

Перем Ответы;         // ОтветыAPI (основа)
Перем Запрос;         // ЗапросAPI (протоколAPI)
Перем Маршрут;        // МаршрутAPI (протоколAPI)
Перем Допуск;         // ДопускAPI (api)
Перем ГейтМутации;    // ГейтМутацииAPI (api)
Перем Двери;          // ДвериAPI (api)
Перем ПорогиПрав;     // ПорогиПравAPI (api)
Перем Квоты;          // КвотыAPI (api)
Перем Страницы;       // СтраницыAPI (протоколAPI)
Перем Служба;         // СлужбаДоступа (кабинет) — мутации пула
Перем СервисПулов;    // СервисПулов (реестр) — квоты хаба, запрет удаления
Перем ЧтениеПула;     // ГвардДоступаКПулу (права) — какие пулы можно называть запросу
Перем Отбор;          // ПоискПоКоллекции (основа)
Перем HTTP;           // МетодыHTTP (основа)
Перем Ошибки;         // ТекстОшибки (основа) — краткая причина без служебной обёртки
Перем Представление;  // ПредставлениеПулаAPI (api) — карточка и настройки пула в JSON
Перем Правила;        // ПравилаИменования (реестр) — правило имени в тексте отказа

#Область ТочкиМаршрута

// Список видимых пулов и заведение пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для POST.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и POST.
//  page - Строка - номер страницы (необязательный, по умолчанию первая).
//  pageSize - Строка - размер страницы (необязательный, по умолчанию — размер
//             страницы хаба).
//  query - Строка - подстрока имени пула (необязательный, по умолчанию — без отбора).
//
&ТочкаМаршрута("pools", Метод = "get, post")
&Операция(Сводка = "Список пулов (GET); заведение пула (POST)",
	Описание = "GET — пулы, которые видит запрос; `query` отбирает по имени. POST — заводит пул
	|с именем `name`, нужно право создания пулов на хабе.")
&Возвращает(Код = 200, Описание = "GET: страница пулов")
&Возвращает(Код = 201, Описание = "POST: пул заведён")
&Возвращает(Код = 400, Описание = "`invalid_pool`, `invalid_quota`")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `quota_forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 409, Описание = "`pool_exists` — имя занято")
Процедура Пулы(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса, page = "", pageSize = "", query = "") Экспорт

	Маршрут.СнятьКуку(Ответ);

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		СписокПулов(Ответ, ЗаголовкиЗапроса, КукиЗапроса, page, pageSize, query);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		СоздатьПул(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Иначе
		Маршрут.МетодНеРазрешён(Ответ, "GET, POST");
	КонецЕсли;

КонецПроцедуры

// Карточка пула и его удаление.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для DELETE.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и DELETE.
//
&ТочкаМаршрута("pools/{Пул}", Метод = "get, delete")
&Операция(Сводка = "Карточка пула (GET); удаление пула (DELETE)",
	Описание = "GET — карточка пула. DELETE — удаляет пул со всем содержимым, нужно право удаления
	|пулов на хабе.")
&Возвращает(Код = 200, Описание = "GET: карточка пула; DELETE: что удалено")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 404, Описание = "`pool_not_found` — пула нет")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`pool_not_deletable` — основной пул либо синхронизация зеркала")
Процедура КарточкаПула(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса) Экспорт

	Маршрут.СнятьКуку(Ответ);

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Карточка(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		УдалитьПул(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Иначе
		Маршрут.МетодНеРазрешён(Ответ, "GET, DELETE");
	КонецЕсли;

КонецПроцедуры

// Назначение пула основным пулом хаба.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только POST.
//
&ТочкаМаршрута("pools/{Пул}/default", Метод = "post")
&Операция(Сводка = "Назначение основного пула",
	Описание = "Короткие адреса выдачи, среза и публикации начинают вести в этот пул. Нужно право
	|изменения на уровне хаба.")
&Возвращает(Код = 200, Описание = "Пул назначен основным")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 404, Описание = "`pool_not_found` — пула нет")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`invalid_default_pool` — пул не назначен")
Процедура ОсновнойПул(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса) Экспорт

	Если НЕ Маршрут.НачатьДействие(Ответ, Неопределено, МетодЗапроса, "POST") Тогда
		Возврат;
	КонецЕсли;

	Мутация = ГейтМутации.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ПорогиПрав.ТребоватьНазначениеОсновногоПула(Ответ, Мутация.Пользователь) Тогда
		Возврат;
	КонецЕсли;

	// невидимый пул отвечает так же, как несуществующий
	ОбъектПула = Двери.ПулМутации(Ответ, Пул, Мутация.Принципал);
	Если ОбъектПула = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Назначенный = Служба.НазначитьОсновнойПул(Мутация.Пользователь, ОбъектПула.Идентификатор);
	Исключение
		Ответы.Сбой(Ответ, 422, "invalid_default_pool",
			Ошибки.ДляЧеловека(ИнформацияОбОшибке()), ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Ответы.JSON(Ответ, 200, Новый Структура("pool", Представление.Карточка(Назначенный)));

КонецПроцедуры

// Упразднённый канал по умолчанию пула: отвечает 410.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Канал - Строка - имя канала из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  МетодЗапроса - Строка - метод запроса; ответ одинаков для любого.
//
&ТочкаМаршрута("pools/{Пул}/channels/{Канал}", Метод = "put")
&Операция(Сводка = "Канал по умолчанию пула",
	Описание = "Упразднено: отвечает 410 и ничего не меняет.")
&Устарело("Замена — тег пакета: PUT /api/v1/pools/{Пул}/packages/{Имя}/tags/{Тег}")
&Возвращает(Код = 410, Описание = "`channels_removed` — каналов больше нет")
Процедура КаналПула(Ответ, Пул, Канал, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса) Экспорт

	Маршрут.СнятьКуку(Ответ);
	Ответы.Ошибка(Ответ, 410, "channels_removed",
		СтрШаблон(
			"Каналы упразднены, уровня «канал по умолчанию пула» больше нет:"
			+ " задайте тег на пакете — PUT /api/v1/pools/%1/packages/{имя}/tags/%2",
			Строка(Пул), Строка(Канал)));

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура Карточка(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	ОбъектПула = Двери.ВидимыйПул(Ответ, ИмяПула, Принципал);
	Если ОбъектПула = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ответы.JSON(Ответ, 200, Новый Структура("pool", Представление.Карточка(ОбъектПула)));

КонецПроцедуры

// Мутация уровня ХАБА: ключ, привязанный к пулу, жизненным циклом пула не распоряжается.
Процедура УдалитьПул(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Мутация = ГейтМутации.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ПорогиПрав.ТребоватьУдалениеПула(Ответ, Мутация.Пользователь) Тогда
		Возврат;
	КонецЕсли;

	// невидимый пул отвечает так же, как несуществующий
	ОбъектПула = Двери.ПулМутации(Ответ, ИмяПула, Мутация.Принципал);
	Если ОбъектПула = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// 422 — по предикату домена: неожиданный сбой уборки остаётся 500
	Причина = СервисПулов.ПричинаЗапретаУдаления(ОбъектПула);
	Если ЗначениеЗаполнено(Причина) Тогда
		Ответы.Ошибка(Ответ, 422, "pool_not_deletable", Причина);
		Возврат;
	КонецЕсли;

	Итог = Служба.УдалитьПул(Мутация.Пользователь, ОбъектПула.Идентификатор);

	Ответы.JSON(Ответ, 200, Новый Структура("deleted, pool, removed",
		Истина, Итог.Имя, УборкаВJSON(Итог)));

КонецПроцедуры

Процедура СписокПулов(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач page, Знач pageSize, Знач query)

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);

	// поиск сужает выдачу видимых пулов, а не расширяет её
	Видимые = ЧтениеПула.ЧитаемыеПулы(Принципал);
	Видимые = Отбор.Отобрать(Видимые, Строка(query), "Имя");

	Разметка = Страницы.РазметкаЛистания(page, pageSize);
	Страница = Страницы.Срез(Видимые, Разметка);

	Элементы = Новый Массив();
	Для Каждого Пул Из Страница Цикл
		Элементы.Добавить(Представление.Карточка(Пул));
	КонецЦикла;

	Ответы.JSON(Ответ, 200, Страницы.Конверт(Элементы, Видимые.Количество(), Разметка));

КонецПроцедуры

Процедура СоздатьПул(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Мутация = ГейтМутации.НачатьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ПорогиПрав.ТребоватьСозданиеПула(Ответ, Мутация.Пользователь) Тогда
		Возврат;
	КонецЕсли;

	Тело = Мутация.Тело;
	Имя = Запрос.Поле(Тело, "имя", Запрос.Поле(Тело, "name"));
	Тип = Запрос.Поле(Тело, "тип", Запрос.Поле(Тело, "type", "custom"));
	Видимость = Запрос.Поле(Тело, "видимость", Запрос.Поле(Тело, "visibility", "public"));

	// отказ имени печатает правило целиком, тем же текстом, что и экран
	Если НЕ Правила.ИмяКорректно(СокрЛП(Строка(Имя))) Тогда
		Ответы.Ошибка(Ответ, 400, "invalid_pool", Правила.ОтказИмени(СокрЛП(Строка(Имя))));
		Возврат;
	КонецЕсли;

	// не названная квота — квота хаба без вопроса о праве; названная закрыта своим гвардом
	Квота = Неопределено;
	СыраяКвота = Квоты.Сырая(Тело);
	Если СыраяКвота <> Неопределено Тогда
		Если НЕ Квоты.ТребоватьПраво(Ответ, Мутация.Пользователь) Тогда
			Возврат;
		КонецЕсли;
		Квота = Квоты.Принять(Ответ, СыраяКвота);
		Если Квота = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// 409 без деталей: сообщение не раскрывает приватный пул
	Если СервисПулов.НайтиПул(Имя) <> Неопределено Тогда
		Ответы.Ошибка(Ответ, 409, "pool_exists", "Пул с таким именем уже существует");
		Возврат;
	КонецЕсли;

	Попытка
		НовыйПул = Служба.СоздатьПул(Мутация.Пользователь, Имя, Тип, Видимость, Квота);
	Исключение
		Ответы.Сбой(Ответ, 400, "invalid_pool", "Некорректные параметры пула (имя/тип/видимость)",
			ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Ответы.JSON(Ответ, 201, Новый Структура("pool", Представление.Карточка(НовыйПул)));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Числа уборки: чего именно не стало вместе с пулом.
Функция УборкаВJSON(Знач Итог)
	Структура = Новый Структура();
	Структура.Вставить("packages", Итог.Пакетов);
	Структура.Вставить("artifacts", Итог.Артефактов);
	Структура.Вставить("grants", Итог.Доступов);
	Структура.Вставить("roles", Итог.Ролей);
	Структура.Вставить("webhooks", Итог.Подписок);
	Структура.Вставить("mirrors", Итог.Зеркал);
	Структура.Вставить("upstreams", Итог.Апстримов);
	Структура.Вставить("inbox", Итог.Заявок);
	Структура.Вставить("rows", Итог.Строк);
	Возврат Структура;
КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
&Группа("Пулы", Описание = "Пулы хаба: список, карточка, заведение, удаление, основной пул и настройки.")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ЗапросAPI") _Запрос,
	&Пластилин(Значение = "МаршрутAPI") _Маршрут,
	&Пластилин(Значение = "ДопускAPI") _Допуск,
	&Пластилин(Значение = "ГейтМутацииAPI") _ГейтМутации,
	&Пластилин(Значение = "ДвериAPI") _Двери,
	&Пластилин(Значение = "ПорогиПравAPI") _ПорогиПрав,
	&Пластилин(Значение = "КвотыAPI") _Квоты,
	&Пластилин(Значение = "СтраницыAPI") _Страницы,
	&Пластилин(Значение = "СлужбаДоступа") _Служба,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ГвардДоступаКПулу") _ЧтениеПула,
	&Пластилин(Значение = "ПоискПоКоллекции") _Отбор,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Пластилин(Значение = "ПредставлениеПулаAPI") _Представление,
	&Пластилин(Значение = "ПравилаИменования") _Правила)

	Ответы = _Ответы;
	Запрос = _Запрос;
	Маршрут = _Маршрут;
	Допуск = _Допуск;
	ГейтМутации = _ГейтМутации;
	Двери = _Двери;
	ПорогиПрав = _ПорогиПрав;
	Квоты = _Квоты;
	Страницы = _Страницы;
	Служба = _Служба;
	СервисПулов = _СервисПулов;
	ЧтениеПула = _ЧтениеПула;
	Отбор = _Отбор;
	HTTP = _HTTP;
	Ошибки = _Ошибки;
	Представление = _Представление;
	Правила = _Правила;

КонецПроцедуры
