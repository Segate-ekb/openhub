// Настройки пула в API — то же, что дом настроек пула: квота, видимость и признак «пул
// принимает публикации».

Перем Ответы;         // ОтветыAPI (основа)
Перем Запрос;         // ЗапросAPI (протоколAPI)
Перем Маршрут;        // МаршрутAPI (протоколAPI)
Перем Допуск;         // ДопускAPI (api)
Перем Двери;          // ДвериAPI (api)
Перем ПрологПравки;  // ПрологПравкиAPI (api)
Перем Квоты;          // КвотыAPI (api)
Перем Представление;  // ПредставлениеПулаAPI (api) — настройки пула в JSON
Перем СервисПулов;    // СервисПулов (реестр)
Перем HTTP;           // МетодыHTTP (основа)

#Область ТочкиМаршрута

// Настройки пула: чтение и правка.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса для PATCH.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и PATCH.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/settings", Метод = "get, patch")
&Группа("Пулы")
&Операция(Сводка = "Настройки пула (GET); правка настроек пула (PATCH)",
	Описание = "GET — настройки пула. PATCH — меняет квоту, видимость и приём публикаций; квоту
	|меняет только администратор хаба. Нужна роль мейнтейнера пула или выше.")
&Возвращает(Код = 200, Описание = "Настройки пула")
&Возвращает(Код = 400, Описание = "`no_changes`, `invalid_quota`, `invalid_visibility`")
&Возвращает(Код = 401, Описание = "`unauthorized` — нет входа")
&Возвращает(Код = 403, Описание = "`forbidden`, `quota_forbidden`, `token_scope`, `token_pool_mismatch`")
&Возвращает(Код = 404, Описание = "`pool_not_found` — пула нет")
&Возвращает(Код = 405, Описание = "`method_not_allowed` — чужой глагол")
&Возвращает(Код = 422, Описание = "`invalid_visibility` — этот пул приватным не бывает")
Процедура Настройки(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Если НЕ Маршрут.Начать(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Показать(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "PATCH") Тогда
		Изменить(Ответ, Пул, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Иначе
		Маршрут.МетодНеРазрешён(Ответ, "GET, PATCH");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура Показать(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	Пул = Двери.АдминистрируемыйПул(Ответ, ИмяПула, Принципал);
	Если Пул = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ответы.JSON(Ответ, 200, Новый Структура("settings", Представление.Настройки(Пул)));

КонецПроцедуры

// Сначала судится весь ввод, потом мутации: полупринятых настроек пула не бывает.
Процедура Изменить(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Правка = ПрологПравки.АдминистрированиеПула(Ответ, ИмяПула, ЗаголовкиЗапроса, КукиЗапроса,
		ТелоЗапроса);
	Если Правка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Публикация = Запрос.ПрисланныйФлаг(Правка.Тело, "публикация,publish_allowed,публикация_разрешена");
	СыраяКвота = Квоты.Сырая(Правка.Тело);
	Видимость = ПрисланнаяВидимость(Правка.Тело);

	Если Публикация = Неопределено И СыраяКвота = Неопределено И НЕ ЗначениеЗаполнено(Видимость) Тогда
		Ответы.Ошибка(Ответ, 400, "no_changes",
			"Не указано ни одно поле: публикация (publish_allowed), квота (quota_mb), видимость (visibility)");
		Возврат;
	КонецЕсли;

	Квота = Неопределено;
	Если СыраяКвота <> Неопределено Тогда
		// квота — право хаба, а не администратора пула: гейт стоит до разбора значения
		Если НЕ Квоты.ТребоватьПраво(Ответ, Правка.Пользователь) Тогда
			Возврат;
		КонецЕсли;
		Квота = Квоты.Принять(Ответ, СыраяКвота);
		Если Квота = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Видимость) И НЕ ВидимостьПрименима(Ответ, Правка.Пул, Видимость) Тогда
		Возврат;
	КонецЕсли;

	Обновлённый = Правка.Пул;
	Если ЗначениеЗаполнено(Видимость) Тогда
		Обновлённый = СервисПулов.УстановитьВидимость(Обновлённый.Идентификатор, Видимость);
	КонецЕсли;
	Если Квота <> Неопределено Тогда
		Обновлённый = СервисПулов.УстановитьКвоту(Обновлённый.Идентификатор, Квота);
	КонецЕсли;
	Если Публикация <> Неопределено Тогда
		Обновлённый = СервисПулов.УстановитьПубликациюРазрешена(Обновлённый.Идентификатор, Публикация);
	КонецЕсли;

	Ответы.JSON(Ответ, 200, Новый Структура("settings", Представление.Настройки(Обновлённый)));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Видимость из тела, нормализованная; пустая строка — поля в теле нет.
Функция ПрисланнаяВидимость(Знач Тело)
	Значение = Запрос.Присланное(Тело, "видимость,visibility");
	Возврат ?(Значение = Неопределено, "", НРег(СокрЛП(Строка(Значение))));
КонецФункции

// Недопустимое значение — 400, запрет по природе пула — 422.
Функция ВидимостьПрименима(Ответ, Знач Пул, Знач Видимость)

	Если Видимость <> "public" И Видимость <> "private" Тогда
		Ответы.Ошибка(Ответ, 400, "invalid_visibility",
			"Видимость пула — public либо private");
		Возврат Ложь;
	КонецЕсли;

	Если Видимость = "private" И (Пул.ЭтоДефолтный() ИЛИ Пул.ЭтоЛичный()) Тогда
		Ответы.Ошибка(Ответ, 422, "invalid_visibility",
			"Этот пул приватным быть не может: основной пул хаба и личное пространство"
			+ " пользователя всегда публичны");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ЗапросAPI") _Запрос,
	&Пластилин(Значение = "МаршрутAPI") _Маршрут,
	&Пластилин(Значение = "ДопускAPI") _Допуск,
	&Пластилин(Значение = "ДвериAPI") _Двери,
	&Пластилин(Значение = "ПрологПравкиAPI") _ПрологПравки,
	&Пластилин(Значение = "КвотыAPI") _Квоты,
	&Пластилин(Значение = "ПредставлениеПулаAPI") _Представление,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "МетодыHTTP") _HTTP)

	Ответы = _Ответы;
	Запрос = _Запрос;
	Маршрут = _Маршрут;
	Допуск = _Допуск;
	Двери = _Двери;
	ПрологПравки = _ПрологПравки;
	Квоты = _Квоты;
	Представление = _Представление;
	СервисПулов = _СервисПулов;
	HTTP = _HTTP;

КонецПроцедуры
