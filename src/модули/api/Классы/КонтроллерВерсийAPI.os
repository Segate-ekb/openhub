// Версии и мутации пакета в API: список и публикация версий, yank и метки, теги пакета
// и предпросмотр правила. Публикация целиком делегирована СервисПубликации.

#Использовать errors

Перем Ответы;           // ОтветыAPI (основа)
Перем Запрос;           // ЗапросAPI (api)
Перем Маршрут;          // МаршрутAPI (api)
Перем Допуск;           // ДопускAPI (api)
Перем Двери;            // ДвериAPI (api)
Перем Сборщик;          // СборщикКарточкиПакета (api) — форма версий
Перем СервисПубликации; // СервисПубликации (публикация)
Перем СервисВерсий;     // СервисВерсий (реестр)
Перем СервисМеток;      // СервисМетокВерсий (реестр) — метки версий (О-11)
Перем СервисТегов;      // СервисТегов (реестр) — теги и предпросмотр правил
Перем Режимы;           // РежимТега (реестр) — единственный словарь режимов
Перем Типы;             // ТипПравилаТега (реестр) — единственный словарь типов правил
Перем Стили;            // СтильТега (реестр) — единственный словарь стилей плашки
Перем Значки;           // ЗначокТега (реестр) — единственный словарь значков плашки
Перем HTTP;             // МетодыHTTP (основа) — сравнение метода запроса (6.C п.8)

#Область ТочкиМаршрута

// GET .../versions — список версий пакета; POST .../versions — публикация версии
// сырым телом .ospx.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустимы GET и POST.
//  ТелоЗапросаДвоичныеДанные - ДвоичныеДанные - тело .ospx при публикации.
//  force - Строка - параметр адреса «?force=1»: заменить уже опубликованный номер
//          целиком (необязательный, по умолчанию "" — обычная публикация).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/versions")
Процедура Версии(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	ТелоЗапросаДвоичныеДанные, force = "") Экспорт

	Маршрут.СнятьКуку(Ответ);

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		СписокВерсий(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Опубликовать(Ответ, Пул, ЗаголовкиЗапроса, ТелоЗапросаДвоичныеДанные,
			СервисПубликации.ЭтоФорс(force));
	Иначе
		Маршрут.МетодНеРазрешён(Ответ, "GET, POST");
	КонецЕсли;

КонецПроцедуры

// PATCH .../versions/{Версия} — yank, unyank и присвоение метки версии.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  Версия - Строка - строка версии из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело с полями yanked/отозвана и label/метка.
//  МетодЗапроса - Строка - метод запроса; допустим только PATCH.
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/versions/{Версия}")
Процедура ВерсияПатч(Ответ, Пул, Имя, Версия, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса) Экспорт

	Если НЕ Маршрут.НачатьДействие(Ответ, Неопределено, МетодЗапроса, "PATCH") Тогда
		Возврат;
	КонецЕсли;

	МутацияПакета = НачатьМутациюПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если МутацияПакета = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаписьВерсии = СервисВерсий.НайтиВерсию(МутацияПакета.Пакет.Идентификатор, Версия);
	Если ЗаписьВерсии = Неопределено Тогда
		Ответы.Ошибка(Ответ, 404, "version_not_found", СтрШаблон("Версия ""%1"" не найдена", Версия));
		Возврат;
	КонецЕсли;

	Тело = МутацияПакета.Тело;
	ЧтоТоСделано = Ложь;

	ЗначОтзыв = ЗначениеПоля(Тело, "yanked", ЗначениеПоля(Тело, "отозвана", ""));
	Если ЗначениеЗаполнено(ЗначОтзыв) Тогда
		// Событие отзыва и восстановления публикует сам сервис, а не контроллер:
		// иначе отзыв через API молчал бы.
		СервисВерсий.ОтозватьВерсию(МутацияПакета.Пакет.Идентификатор, Версия, ВБулево(ЗначОтзыв),
			?(МутацияПакета.Пользователь = Неопределено, "", Строка(МутацияПакета.Пользователь.Логин)));
		ЧтоТоСделано = Истина;
	КонецЕсли;

	Метка = ЗначениеПоля(Тело, "label", ЗначениеПоля(Тело, "метка", ""));
	Если ЗначениеЗаполнено(Метка) Тогда
		Попытка
			СервисМеток.ПрисвоитьМетку(ЗаписьВерсии.Идентификатор, Метка);
			ЧтоТоСделано = Истина;
		Исключение
			Ответы.Сбой(Ответ, 422, "invalid_label", "Некорректная метка версии",
				ИнформацияОбОшибке());
			Возврат;
		КонецПопытки;
	КонецЕсли;

	Если НЕ ЧтоТоСделано Тогда
		Ответы.Ошибка(Ответ, 400, "no_changes", "Не указано ни yanked, ни label");
		Возврат;
	КонецЕсли;

	// Перечитываем версию, чтобы вернуть актуальный статус.
	Обновлённая = СервисВерсий.НайтиВерсию(МутацияПакета.Пакет.Идентификатор, Версия);
	Ответы.JSON(Ответ, 200, Новый Структура("version", Сборщик.ВерсияJSON(Обновлённая)));

КонецПроцедуры

// GET .../tags — теги пакета: имя, режим, правило, отдаваемая версия и состав канала.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод запроса; допустим только GET.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/tags")
Процедура ТегиПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Маршрут.СнятьКуку(Ответ);
	Если Маршрут.ЛишнийХвостПути(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Маршрут.МетодНеРазрешён(Ответ, "GET");
		Возврат;
	КонецЕсли;

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	ПулИПакет = Двери.ВидимыйПакет(Ответ, Пул, Имя, Принципал);
	Если ПулИПакет = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ответы.JSON(Ответ, 200, Новый Структура("tags", Сборщик.ТегиJSON(ПулИПакет.Пакет)));

КонецПроцедуры

// PUT .../tags/{Тег} — создать или изменить тег; DELETE .../tags/{Тег} — удалить тег.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  Тег - Строка - имя тега из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело с полями режима, правила и версии.
//  МетодЗапроса - Строка - метод запроса; допустимы PUT и DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/tags/{Тег}")
Процедура ТегВерсии(Ответ, Пул, Имя, Тег, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Маршрут.СнятьКуку(Ответ);
	Если Маршрут.ЛишнийХвостПути(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "PUT") И НЕ HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		Маршрут.МетодНеРазрешён(Ответ, "PUT, DELETE");
		Возврат;
	КонецЕсли;

	МутацияПакета = НачатьМутациюПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если МутацияПакета = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		// Без обёртки Попыткой: сбой хранилища обязан доходить до 500, а не притворяться
		// отказом клиенту.
		Удалён = СервисТегов.УдалитьТег(МутацияПакета.Пакет.Идентификатор, Тег, ЛогинПринципала(МутацияПакета));
		Если НЕ Удалён Тогда
			Ответы.Ошибка(Ответ, 404, "tag_not_found", СтрШаблон("Тег ""%1"" не найден", Тег));
			Возврат;
		КонецЕсли;
		Ответы.JSON(Ответ, 200, Новый Структура("deleted", Истина));
		Возврат;
	КонецЕсли;

	СохранитьТег(Ответ, МутацияПакета, Тег);

КонецПроцедуры

// DELETE .../tags/{Тег}/pin — упразднённый адрес открепления, отвечает 410 Gone.
// С маршрутизации не снят сознательно: winow работает по first-match, и без своего
// маршрута этот запрос попал бы в DELETE .../tags/{Тег} и молча удалил бы тег.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  Тег - Строка - имя тега из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  МетодЗапроса - Строка - метод запроса; ответ одинаков для любого.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/tags/{Тег}/pin")
Процедура ЗакреплениеТега(Ответ, Пул, Имя, Тег, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Маршрут.СнятьКуку(Ответ);
	Если Маршрут.ЛишнийХвостПути(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Ответы.Ошибка(Ответ, 410, "pin_removed", СтрШаблон(
		"Режим «пин» упразднён, снимать нечего: ручной тег, стоящий на одной версии, и есть"
		+ " прежний пин — PUT /api/v1/pools/%1/packages/%2/tags/%3 с {""mode"":""ручной""}",
		Строка(Пул), Строка(Имя), Строка(Тег)));

КонецПроцедуры

// PUT .../tags/{Тег}/versions/{Версия} — добавить версию в ручной канал, DELETE — снять.
// Отдельный адрес, а не поле в PUT тега: тот означает «канал стоит ровно на этой версии»
// и используется для отката, менять его смысл нельзя.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  Тег - Строка - имя тега из адреса.
//  Версия - Строка - строка версии из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  МетодЗапроса - Строка - метод запроса; допустимы PUT и DELETE.
//  ПараметрыЗапросаПорядковые - Массив - лишние сегменты пути; непустой даёт 404
//                               (необязательный, по умолчанию Неопределено).
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/tags/{Тег}/versions/{Версия}")
Процедура СоставТега(Ответ, Пул, Имя, Тег, Версия, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса,
	ПараметрыЗапросаПорядковые = Неопределено) Экспорт

	Маршрут.СнятьКуку(Ответ);
	Если Маршрут.ЛишнийХвостПути(Ответ, ПараметрыЗапросаПорядковые) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "PUT") И НЕ HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		Маршрут.МетодНеРазрешён(Ответ, "PUT, DELETE");
		Возврат;
	КонецЕсли;

	МутацияПакета = НачатьМутациюПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если МутацияПакета = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Ожидаемые отказы распознаются до мутации, каждый со своим кодом; нераспознанное —
	// не отказ, а поломка, и она обязана дойти до 500.
	Если НЕ СервисТегов.ИмяДопустимо(Тег) Тогда
		Ответы.Ошибка(Ответ, 422, "invalid_tag", СтрШаблон(
			"Недопустимое имя тега ""%1"": латиница, цифры, дефис, подчёркивание и точка,"
			+ " не длиннее 64 символов", Тег));
		Возврат;
	КонецЕсли;

	Существующий = СервисТегов.НайтиТег(МутацияПакета.Пакет.Идентификатор, Тег);

	Если Существующий <> Неопределено И Режимы.ЭтоПравило(Существующий.Режим) Тогда
		Ответы.Ошибка(Ответ, 422, "tag_is_rule", СтрШаблон(
			"Тег ""%1"" в режиме правила: его состав считается правилом, и ручная метка"
			+ " ни на что не влияет. Заведите отдельный тег либо переведите этот в ручной режим", Тег));
		Возврат;
	КонецЕсли;

	Если СервисВерсий.НайтиВерсию(МутацияПакета.Пакет.Идентификатор, Версия) = Неопределено Тогда
		Ответы.Ошибка(Ответ, 404, "version_not_found", СтрШаблон(
			"Версия ""%1"" не найдена в пакете", Версия));
		Возврат;
	КонецЕсли;

	Если Существующий = Неопределено И НЕ HTTP.ЭтоМетод(МетодЗапроса, "PUT") Тогда
		Ответы.Ошибка(Ответ, 404, "tag_not_found", СтрШаблон(
			"Тег ""%1"" не найден — снимать метку не с чего", Тег));
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "PUT") Тогда
		// PUT заводит тег, которого ещё нет: непересечение имени с номером версии — здесь
		Если ИмяДляНовогоТегаЗанято(Ответ, МутацияПакета.Пакет.Идентификатор, Тег) Тогда
			Возврат;
		КонецЕсли;
		Запись = СервисТегов.ПометитьВерсию(МутацияПакета.Пакет.Идентификатор, Тег, Версия, ЛогинПринципала(МутацияПакета));
	Иначе
		Запись = СервисТегов.СнятьМетку(МутацияПакета.Пакет.Идентификатор, Тег, Версия, ЛогинПринципала(МутацияПакета));
	КонецЕсли;

	Ответы.JSON(Ответ, 200, Сборщик.ТегJSON(Запись));

КонецПроцедуры

// POST /api/v1/tags/preview — предпросмотр правила тега без записи: версия-кандидат,
// все совпадения и предупреждение о незаякоренном regex.
//
// Гейт здесь как у мутации, а не как у чтения: эндпоинт исполняет пользовательское
// выражение по всем версиям пакета, и дорогое регулярное выражение занимает поток хаба
// на минуты. Заказывать эту работу вправе тот, кто вправе завести тег.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело с полями pool, package, rule и type.
//  МетодЗапроса - Строка - метод запроса; допустим только POST.
//
&ТочкаМаршрута("tags/preview")
Процедура ПредпросмотрПравилаТега(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса) Экспорт

	Если НЕ Маршрут.НачатьДействие(Ответ, Неопределено, МетодЗапроса, "POST") Тогда
		Возврат;
	КонецЕсли;

	Тело = Запрос.РазобратьТело(ТелоЗапроса, ЗаголовкиЗапроса);
	ИмяПула = ЗначениеПоля(Тело, "pool", ЗначениеПоля(Тело, "пул", ""));
	ИмяПакета = ЗначениеПоля(Тело, "package", ЗначениеПоля(Тело, "пакет", ""));
	Правило = ЗначениеПоля(Тело, "rule", ЗначениеПоля(Тело, "правило", ""));
	ТипПравила = ЗначениеПоля(Тело, "type", ЗначениеПоля(Тело, "тип", "semver"));

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	Если Принципал.Пользователь = Неопределено Тогда
		Ответы.Ошибка(Ответ, 401, "unauthorized", "Требуется аутентификация");
		Возврат;
	КонецЕсли;

	Если НЕ Допуск.ПроверитьМутацию(Ответ, Принципал, Тело, ЗаголовкиЗапроса, ИмяПула) Тогда
		Возврат;
	КонецЕсли;

	ПулИПакет = Двери.ПакетМутации(Ответ, ИмяПула, ИмяПакета, Принципал);
	Если ПулИПакет = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Двери.ТребоватьИзменениеПакета(Ответ, Принципал.Пользователь, ПулИПакет.Пул, ПулИПакет.Пакет) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Предпросмотр = СервисТегов.ПредпросмотрПравила(ПулИПакет.Пакет.Идентификатор, ТипПравила, Правило);
	Исключение
		Ответы.Сбой(Ответ, 422, "invalid_rule", "Некорректное правило тега (тип/выражение)",
			ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Данные = Новый Структура();
	Данные.Вставить("version", Предпросмотр.Версия);
	Данные.Вставить("type", Предпросмотр.Тип);
	Данные.Вставить("rule", Предпросмотр.Выражение);
	Данные.Вставить("matches", Предпросмотр.Совпадения);
	// Правило пометит отозванные, а резолв их не отдаст — клиент обязан видеть разницу.
	Данные.Вставить("yanked", Предпросмотр.Отозванные);
	Данные.Вставить("warning", Предпросмотр.Предупреждение);
	Ответы.JSON(Ответ, 200, Данные);

КонецПроцедуры

// PUT .../channels/{Канал} — устаревший адрес, переходник на теги: старый клиент
// продолжает работать, результатом становится тег того же имени. Виды паттерна:
// semver и regex дают правило, pin — ручной тег ровно на одной версии, label — 422,
// потому что отбирать версии по метке правило тега не умеет и подменять такой канал
// «похожим» значило бы отдать клиенту не те версии.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Строка - имя пула из адреса.
//  Имя - Строка - имя пакета из адреса.
//  Канал - Строка - имя канала из адреса; станет именем тега.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ТелоЗапроса - Строка - тело с видом паттерна и его значением.
//  МетодЗапроса - Строка - метод запроса; допустим только PUT.
//
&ТочкаМаршрута("pools/{Пул}/packages/{Имя}/channels/{Канал}")
Процедура КаналПакета(Ответ, Пул, Имя, Канал, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса, МетодЗапроса) Экспорт

	Если НЕ Маршрут.НачатьДействие(Ответ, Неопределено, МетодЗапроса, "PUT") Тогда
		Возврат;
	КонецЕсли;

	МутацияПакета = НачатьМутациюПакета(Ответ, Пул, Имя, ЗаголовкиЗапроса, КукиЗапроса, ТелоЗапроса);
	Если МутацияПакета = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТипПаттерна = НРег(СокрЛП(Строка(
		ЗначениеПоля(МутацияПакета.Тело, "тип", ЗначениеПоля(МутацияПакета.Тело, "type", "semver")))));
	Паттерн = ЗначениеПоля(МутацияПакета.Тело, "паттерн", ЗначениеПоля(МутацияПакета.Тело, "pattern", ""));
	ВерсияПин = ЗначениеПоля(МутацияПакета.Тело, "версия", ЗначениеПоля(МутацияПакета.Тело, "version", ""));

	// «label упразднён» и «мусорный паттерн» — разные починки; распознаём до мутации,
	// формулировка константная, без эха ввода.
	Если НРег(СокрЛП(Строка(ТипПаттерна))) = "label" Тогда
		Ответы.Ошибка(Ответ, 422, "invalid_channel",
			"Тип паттерна «label» упразднён: правило тега отбирает версии по строке версии"
			+ " (semver или regex); метка версии осталась атрибутом версии");
		Возврат;
	КонецЕсли;

	Если ИмяДляНовогоТегаЗанято(Ответ, МутацияПакета.Пакет.Идентификатор, Канал) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если ТипПаттерна = "pin" Тогда
			Запись = СервисТегов.ПереместитьТег(
				МутацияПакета.Пакет.Идентификатор, Канал, ВерсияПин, ЛогинПринципала(МутацияПакета));
		Иначе
			Запись = СервисТегов.ОпределитьТегПравила(
				МутацияПакета.Пакет.Идентификатор, Канал, ТипПаттерна, Паттерн, ЛогинПринципала(МутацияПакета));
		КонецЕсли;
	Исключение
		// Фиксированное сообщение: в тексте исключения бывает сам паттерн.
		Ответы.Сбой(Ответ, 422, "invalid_channel",
			"Некорректное определение канала (тип/паттерн/версия)", ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	// Форма ответа сохранена, чтобы старый клиент её разобрал; "type" — присланный им вид.
	Данные = Новый Структура();
	Данные.Вставить("name", Запись.Имя);
	Данные.Вставить("type", ТипПаттерна);
	Данные.Вставить("level", "package");
	Данные.Вставить("deprecated", "каналы упразднены: используйте PUT .../tags/{tag}");
	Ответы.JSON(Ответ, 200, Новый Структура("channel", Данные));

КонецПроцедуры

#КонецОбласти

#Область Действия

// Значение режима нормализует словарь (fail-closed): опечатка обязана получить 422.
Процедура СохранитьТег(Ответ, Знач МутацияПакета, Знач Тег)

	Тело = МутацияПакета.Тело;
	Правило = ЗначениеПоля(Тело, "rule", ЗначениеПоля(Тело, "правило", ""));
	СтрокаВерсии = ЗначениеПоля(Тело, "version", ЗначениеПоля(Тело, "версия", ""));
	СыройРежим = СокрЛП(Строка(ЗначениеПоля(Тело, "mode", ЗначениеПоля(Тело, "режим", ""))));

	Если НЕ ЗначениеЗаполнено(СыройРежим) Тогда
		СыройРежим = ?(ЗначениеЗаполнено(Правило), Режимы.Правило(), Режимы.Ручной());
	КонецЕсли;

	// Причина называется поимённо, но без эха ввода: текст исключения домена в ответ
	// не уходит, в нём бывает пользовательский ввод.
	Если УпразднённыйПин(СыройРежим) Тогда
		Ответы.Ошибка(Ответ, 422, "invalid_mode",
			"Режим тега «пин» упразднён: ручной тег, стоящий на одной версии, и есть прежний"
			+ " пин — используйте mode=ручной");
		Возврат;
	КонецЕсли;

	Попытка
		Режим = Режимы.Нормализовать(СыройРежим);
	Исключение
		Ответы.Сбой(Ответ, 422, "invalid_mode", СтрШаблон(
			"Неизвестный режим тега: допустимы %1", СтрСоединить(Режимы.Все(), ", ")),
			ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	ТипПравила = ЗначениеПоля(Тело, "ruleType", ЗначениеПоля(Тело, "тип_правила", Типы.Semver()));
	Если Режим = Режимы.Правило() И НРег(СокрЛП(Строка(ТипПравила))) = "label" Тогда
		Ответы.Ошибка(Ответ, 422, "invalid_tag",
			"Тип правила тега «label» упразднён: правило отбирает версии по строке версии"
			+ " (semver или regex); метка версии осталась атрибутом версии");
		Возврат;
	КонецЕсли;

	// Стиль и значок — ключи из закрытых списков: незнакомый ключ называется отдельно
	// и до мутации, чтобы клиент не гадал, почему оформление «не применилось».
	Оформление = ОформлениеИзТела(Тело);
	Если Оформление <> Неопределено И НЕ Стили.Допустим(Оформление.Стиль) Тогда
		Ответы.Ошибка(Ответ, 422, "invalid_style", СтрШаблон(
			"Неизвестный стиль тега: допустимы %1", СтрСоединить(Стили.Все(), ", ")));
		Возврат;
	КонецЕсли;
	Если Оформление <> Неопределено И НЕ Значки.Допустим(Оформление.Значок) Тогда
		Ответы.Ошибка(Ответ, 422, "invalid_icon", СтрШаблон(
			"Неизвестный значок тега: допустимы %1 либо пусто", СтрСоединить(Значки.Все(), ", ")));
		Возврат;
	КонецЕсли;

	Если ИмяДляНовогоТегаЗанято(Ответ, МутацияПакета.Пакет.Идентификатор, Тег) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если Режим = Режимы.Правило() Тогда
			Запись = СервисТегов.ОпределитьТегПравила(
				МутацияПакета.Пакет.Идентификатор, Тег, ТипПравила, Правило, ЛогинПринципала(МутацияПакета), Оформление);
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаВерсии) Тогда
			// ручной тег без версии — пустой канал: версии в него набирают у самих версий
			Запись = СервисТегов.ОпределитьРучнойТег(
				МутацияПакета.Пакет.Идентификатор, Тег, ЛогинПринципала(МутацияПакета), Оформление);
		Иначе
			Запись = СервисТегов.ПереместитьТег(
				МутацияПакета.Пакет.Идентификатор, Тег, СтрокаВерсии, ЛогинПринципала(МутацияПакета), Оформление);
		КонецЕсли;
	Исключение
		// Фиксированное сообщение: текст домена несёт пользовательский ввод.
		Ответы.Сбой(Ответ, 422, "invalid_tag", "Некорректный тег (имя, режим, правило или версия)",
			ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(ЗначениеПоля(Тело, "default", ЗначениеПоля(Тело, "по_умолчанию", ""))) Тогда
		СервисТегов.НазначитьПоУмолчанию(МутацияПакета.Пакет.Идентификатор, Запись.Имя);
	КонецЕсли;

	ПрименитьРазрешениеПерезаписи(МутацияПакета, Тело, Запись);

	Ответы.JSON(Ответ, 200, Сборщик.ТегJSON(Запись));

КонецПроцедуры

// Меняется, только если поле прислано: «пусто» и «Ложь» здесь разные ответы.
Процедура ПрименитьРазрешениеПерезаписи(Знач МутацияПакета, Знач Тело, Знач Запись)

	Присланное = ПервоеПрисланное(Тело, "overwrite_allowed", "перезапись_разрешена");
	Если Присланное = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// поле называет РАЗРЕШЕНИЕ, домен — ЗАПРЕТ: полярность переворачивается ровно здесь,
	// на границе. Невнятное значение читается как «разрешения нет» — сторона безопасная
	СервисТегов.УстановитьЗапретПерезаписи(МутацияПакета.Пакет.Идентификатор, Запись.Имя,
		НЕ Запрос.ВБулево(Присланное), ЛогинПринципала(МутацияПакета));

КонецПроцедуры

// Отказ распознаётся до мутации: иначе клиент не узнает, чем именно имя занято.
Функция ИмяДляНовогоТегаЗанято(Ответ, Знач ПакетИдентификатор, Знач Тег)

	Если НЕ СервисТегов.ИмяДляНовогоТегаЗанято(ПакетИдентификатор, Тег) Тогда
		Возврат Ложь;
	КонецЕсли;

	Ответы.Ошибка(Ответ, 422, "tag_name_is_version", СтрШаблон(
		"Имя тега ""%1"" занято версией пакета: спецификацию ""пакет@%1"" резолв читает"
		+ " сначала точной версией, и тег с таким именем остался бы недостижим."
		+ " Назовите тег иначе", Тег));
	Возврат Истина;

КонецФункции

// Ни одного поля в теле — Неопределено: тег, у которого меняют правило, оформления не теряет.
Функция ОформлениеИзТела(Знач Тело)

	Стиль = ПервоеПрисланное(Тело, "style", "стиль");
	Значок = ПервоеПрисланное(Тело, "icon", "значок");

	Если Стиль = Неопределено И Значок = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Стиль, Значок",
		?(Стиль = Неопределено, "", Стиль), ?(Значок = Неопределено, "", Значок));

КонецФункции

Функция ПервоеПрисланное(Знач Тело, Знач ИмяLatin, Знач ИмяРусское)

	Если Тело = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = Тело.Получить(ИмяLatin);
	Если Значение = Неопределено Тогда
		Значение = Тело.Получить(ИмяРусское);
	КонецЕсли;

	Возврат ?(Значение = Неопределено, Неопределено, Строка(Значение));

КонецФункции

// Отдельная функция держит формулировку отказа единой для всех входов.
Функция УпразднённыйПин(Знач СыройРежим)
	Норм = НРег(СокрЛП(Строка(СыройРежим)));
	Возврат Норм = "пин" ИЛИ Норм = "pin";
КонецФункции

// Логин принципала мутации для аудита переезда тега; пустая строка — не определён.
Функция ЛогинПринципала(Знач МутацияПакета)
	Пользователь = Неопределено;
	Если МутацияПакета.Свойство("Пользователь", Пользователь) И Пользователь <> Неопределено Тогда
		Возврат Строка(Пользователь.Логин);
	КонецЕсли;
	Возврат "";
КонецФункции

Процедура СписокВерсий(Ответ, Знач Пул, Знач Имя, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)
	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	ПулИПакет = Двери.ВидимыйПакет(Ответ, Пул, Имя, Принципал);
	Если ПулИПакет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ответы.JSON(Ответ, 200, Новый Структура("versions", Сборщик.ВерсииJSON(ПулИПакет.Пакет)));
КонецПроцедуры

// Гейт мутации зовётся ВСЕГДА, а не только для сессии: иначе ветка токена идёт мимо проверок.
Процедура Опубликовать(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач Тело, Знач Форсировать)

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, Неопределено);

	// Тело бинарное, поэтому CSRF-токен ждём только в заголовке.
	ТелоФормы = Запрос.РазобратьТело("", ЗаголовкиЗапроса);
	Если НЕ Допуск.ПроверитьМутацию(Ответ, Принципал, ТелоФормы, ЗаголовкиЗапроса, ИмяПула) Тогда
		Возврат;
	КонецЕсли;

	ИмяФайла = Запрос.Заголовок(ЗаголовкиЗапроса, "FILE-NAME");
	Канал = Запрос.Заголовок(ЗаголовкиЗапроса, "CHANNEL");
	Токен = Допуск.ТокенЗапроса(ЗаголовкиЗапроса);

	Попытка
		Результат = СервисПубликации.Опубликовать(
			ИмяПула, Тело, ?(ИмяФайла = Неопределено, "", Строка(ИмяФайла)),
			?(Канал = Неопределено, "", Строка(Канал)), Принципал.Пользователь, Токен, Принципал,
			Форсировать);
	Исключение
		// наружу — только машинный код чужой ошибки: ни цепочки причин, ни стека
		Ответы.Сбой(Ответ, 500, "publish_failed", "Внутренняя ошибка публикации",
			ИнформацияОбОшибке(), КодЧужойОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ОтдатьРезультатПубликации(Ответ, Результат);

КонецПроцедуры

// Статус называет то, что произошло: 202 — заявка во «входящие», версии ещё нет.
Процедура ОтдатьРезультатПубликации(Ответ, Знач Результат)

	Если Результат.Код >= 200 И Результат.Код < 300 Тогда
		Данные = Новый Структура();
		Данные.Вставить("status", ?(Результат.Код = 202, "queued", "published"));
		Данные.Вставить("message", Результат.Сообщение);
		Ответы.JSON(Ответ, Результат.Код, Данные);
		Возврат;
	КонецЕсли;

	Ответы.Ошибка(Ответ, Результат.Код, КодОшибкиПубликации(Результат.Код), Результат.Сообщение,
		ПодробностиВердикта(Результат));

КонецПроцедуры

#КонецОбласти

#Область ОбщаяЛогикаМутаций

// Пролог мутации пакета: аутентификация, гейт мутации, видимый пакет и право его изменения.
Функция НачатьМутациюПакета(Ответ, Знач ИмяПула, Знач ИмяПакета, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ТелоЗапроса)

	Принципал = Допуск.Принципал(ЗаголовкиЗапроса, КукиЗапроса);
	Если Принципал.Пользователь = Неопределено Тогда
		Ответы.Ошибка(Ответ, 401, "unauthorized", "Требуется аутентификация");
		Возврат Неопределено;
	КонецЕсли;

	Тело = Запрос.РазобратьТело(ТелоЗапроса, ЗаголовкиЗапроса);
	Если НЕ Допуск.ПроверитьМутацию(Ответ, Принципал, Тело, ЗаголовкиЗапроса, ИмяПула) Тогда
		Возврат Неопределено;
	КонецЕсли;

	МутацияПакета = Двери.ПакетМутации(Ответ, ИмяПула, ИмяПакета, Принципал);
	Если МутацияПакета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ Двери.ТребоватьИзменениеПакета(Ответ, Принципал.Пользователь, МутацияПакета.Пул, МутацияПакета.Пакет) Тогда
		Возврат Неопределено;
	КонецЕсли;

	МутацияПакета.Вставить("Тело", Тело);
	// Принципал нужен аудиту переезда тега: летопись пишет «кто».
	МутацияПакета.Вставить("Пользователь", Принципал.Пользователь);
	Возврат МутацияПакета;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Машинный код структурированной ошибки библиотеки полем `error.details.error_code`;
// у обычного исключения кода нет, и поля details в ответе не будет.
Функция КодЧужойОшибки(Знач ИнфОбОшибке)

	Код = ДиагностикаОшибок.КодОшибки(ИнфОбОшибке);
	Если Код = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("error_code", Строка(Код));

КонецФункции

// Поля `error.details` по коду отказа публикации; их кладёт в вердикт тот, кто отказал:
//   payload_too_large — limit (ключ настройки), limit_bytes, actual_bytes;
//   quota_exceeded    — pool, limit, limit_bytes, used_bytes, actual_bytes;
//   pool_not_found    — pool;
//   conflict, bad_request по правилам приёма — package, version.
// Вердикта без подробностей это не запрещает: тогда поля details в ответе нет вовсе.
Функция ПодробностиВердикта(Знач Результат)
	Подробности = Неопределено;
	Результат.Свойство("Подробности", Подробности);
	Возврат Подробности;
КонецФункции

Функция КодОшибкиПубликации(Знач Код)
	Если Код = 401 Тогда Возврат "unauthorized"; КонецЕсли;
	Если Код = 403 Тогда Возврат "forbidden"; КонецЕсли;
	Если Код = 404 Тогда Возврат "pool_not_found"; КонецЕсли;
	Если Код = 409 Тогда Возврат "conflict"; КонецЕсли;      // иммутабельность release
	Если Код = 413 Тогда Возврат "payload_too_large"; КонецЕсли;
	Если Код = 422 Тогда Возврат "unprocessable"; КонецЕсли; // артефакт понят, но отвергнут политикой (подпись)
	Если Код = 429 Тогда Возврат "rate_limited"; КонецЕсли;  // предел незакрытых заявок пула или автора
	Если Код = 507 Тогда Возврат "quota_exceeded"; КонецЕсли; // квота пула исчерпана
	Если Код = 400 Тогда Возврат "bad_request"; КонецЕсли;
	Возврат "publish_error";
КонецФункции

Функция ЗначениеПоля(Знач Тело, Знач Имя, Знач ПоУмолчанию = "")
	Возврат Запрос.Поле(Тело, Имя, ПоУмолчанию);
КонецФункции

Функция ВБулево(Знач Значение)
	Возврат Запрос.ВБулево(Значение);
КонецФункции

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ЗапросAPI") _Запрос,
	&Пластилин(Значение = "МаршрутAPI") _Маршрут,
	&Пластилин(Значение = "ДопускAPI") _Допуск,
	&Пластилин(Значение = "ДвериAPI") _Двери,
	&Пластилин(Значение = "СборщикКарточкиПакета") _Сборщик,
	&Пластилин(Значение = "СервисПубликации") _СервисПубликации,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисМетокВерсий") _СервисМеток,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "РежимТега") _Режимы,
	&Пластилин(Значение = "ТипПравилаТега") _Типы,
	&Пластилин(Значение = "СтильТега") _Стили,
	&Пластилин(Значение = "ЗначокТега") _Значки,
	&Пластилин(Значение = "МетодыHTTP") _HTTP)

	HTTP = _HTTP;

	Ответы = _Ответы;
	Запрос = _Запрос;
	Маршрут = _Маршрут;
	Допуск = _Допуск;
	Двери = _Двери;
	Сборщик = _Сборщик;
	СервисПубликации = _СервисПубликации;
	СервисВерсий = _СервисВерсий;
	СервисМеток = _СервисМеток;
	СервисТегов = _СервисТегов;
	Режимы = _Режимы;
	Типы = _Типы;
	Стили = _Стили;
	Значки = _Значки;

КонецПроцедуры
