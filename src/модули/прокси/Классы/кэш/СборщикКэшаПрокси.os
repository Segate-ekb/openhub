// Фоновая уборка кэша: удерживает объём пула в пределах квоты, вытесняя по LRU только версии
// с провенансом «апстрим» — собственная публикация невосстановима и не трогается никогда.

Перем СервисПулов;         // СервисПулов (реестр)
Перем СервисПакетов;       // СервисПакетов (реестр)
Перем СервисВерсий;        // СервисВерсий (реестр)
Перем СервисПроисхождения; // СервисПроисхождения (реестр)
Перем Объёмы;              // УчётОбъёмаПула (реестр) — занятое пулом место
Перем Хранилище;           // ХранилищеАртефактов (хранилище)
Перем Ошибки;              // ТекстОшибки (основа)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Выполняет уборку кэша всех пулов с апстримами и квотой. Наружу не бросает:
// сбой отдельного пула логируется.
//
// Возвращаемое значение:
//  Структура - ПуловОбработано (Число, пулов с апстримами и активной квотой),
//              УдаленоФайлов (Число, вытеснено апстримных артефактов),
//              ОсвобожденоБайт (Число).
//
Функция Собрать() Экспорт

	Сводка = Новый Структура("ПуловОбработано, УдаленоФайлов, ОсвобожденоБайт", 0, 0, 0);

	Для Каждого Пул Из СервисПулов.ПулыСАпстримами() Цикл

		КвотаБайт = КвотаПулаБайт(Пул);
		Если КвотаБайт <= 0 Тогда
			Лог.Отладка("GC прокси-кэша: у пула ""%1"" действующей квоты нет — не убираем", Пул.Имя);
			Продолжить; // без квоты — не убираем
		КонецЕсли;

		Попытка
			Результат = СобратьПул(Пул, КвотаБайт);
			Сводка.ПуловОбработано = Сводка.ПуловОбработано + 1;
			Сводка.УдаленоФайлов = Сводка.УдаленоФайлов + Результат.УдаленоФайлов;
			Сводка.ОсвобожденоБайт = Сводка.ОсвобожденоБайт + Результат.ОсвобожденоБайт;
		Исключение
			// проблема одного пула не срывает уборку остальных
			Лог.Ошибка("GC кэша прокси-пула ""%1"" прерван ошибкой: %2",
				Пул.Имя, Ошибки.Причина(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Если Сводка.УдаленоФайлов > 0 Тогда
		Лог.Информация("GC прокси-кэша: вытеснено %1 артефактов, освобождено %2 байт (пулов: %3)",
			Сводка.УдаленоФайлов, Сводка.ОсвобожденоБайт, Сводка.ПуловОбработано);
	КонецЕсли;

	Возврат Сводка;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СобратьПул(Знач Пул, Знач КвотаБайт)

	Опись = Хранилище.Опись(Пул.Имя);

	Занято = 0;
	Для Каждого Элемент Из Опись Цикл
		Занято = Занято + Элемент.Размер;
	КонецЦикла;

	Результат = Новый Структура("УдаленоФайлов, ОсвобожденоБайт", 0, 0);

	// действующая квота печатается рядом с занятым: без неё «почему не вытесняется»
	// разбиралось чтением настроек пула и хаба
	Лог.Отладка("GC прокси-кэша: пул ""%1"" — занято %2 байт при квоте %3, файлов в описи %4",
		Пул.Имя, Занято, КвотаБайт, Опись.Количество());

	Если Занято <= КвотаБайт Тогда
		Возврат Результат;
	КонецЕсли;

	Отсортированные = ПоВозрастаниюДавности(Опись);
	РеестрПула = СодержимоеПула(Пул);

	Для Каждого Элемент Из Отсортированные Цикл

		Если Занято <= КвотаБайт Тогда
			Прервать;
		КонецЕсли;

		Если НЕ ЭтоАпстримныйАртефакт(РеестрПула, Элемент) Тогда
			Лог.Отладка("GC прокси-кэша: ""%1"" не вытесняется — это не привезённая апстримом"
				+ " версия либо её нет в реестре", Элемент.ИмяФайла);
			Продолжить; // своя публикация (или неопознанный файл) — не вытесняем
		КонецЕсли;

		Лог.Отладка("GC прокси-кэша: вытесняем ""%1"" (%2 байт, записан %3)",
			Элемент.ИмяФайла, Элемент.Размер, Элемент.Изменён);
		Хранилище.УдалитьФайл(Элемент.Пул, Элемент.Пакет, Элемент.ИмяФайла);
		Занято = Занято - Элемент.Размер;
		Результат.УдаленоФайлов = Результат.УдаленоФайлов + 1;
		Результат.ОсвобожденоБайт = Результат.ОсвобожденоБайт + Элемент.Размер;

	КонецЦикла;

	// вытесненные байты возвращаются пулу: счётчик ведёт тот, кто удаляет файлы
	Если Результат.ОсвобожденоБайт > 0 Тогда
		Объёмы.Учесть(Пул, -Результат.ОсвобожденоБайт);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Fail-closed: не нашли пакет либо версию в реестре — вытеснять нельзя.
Функция ЭтоАпстримныйАртефакт(Знач РеестрПула, Знач Элемент)

	Пакет = РеестрПула.Пакеты.Получить(НРег(СокрЛП(Строка(Элемент.Пакет))));
	Если Пакет = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	СтрокаВерсии = СтрокаВерсииИзИмениФайла(Элемент.Пакет, Элемент.ИмяФайла);
	Если НЕ ЗначениеЗаполнено(СтрокаВерсии) Тогда
		Возврат Ложь;
	КонецЕсли;

	Версия = РеестрПула.Версии.Получить(КлючВерсии(Пакет.Идентификатор, СтрокаВерсии));
	Если Версия = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СервисПроисхождения.ИсточникВерсии(Версия) = СервисПроисхождения.ИсточникАпстрим();

КонецФункции

// Пакеты пула и их версии — по одному разрезу на пул: вопрос на файл делал бы цену
// уборки числом файлов в описи.
Функция СодержимоеПула(Знач Пул)

	Пакеты = Новый Соответствие();
	Номера = Новый Массив();
	Для Каждого Пакет Из СервисПакетов.ПакетыПула(Пул.Идентификатор) Цикл
		Пакеты.Вставить(Строка(Пакет.ИмяНижнийРегистр), Пакет);
		Номера.Добавить(Пакет.Идентификатор);
	КонецЦикла;

	ВерсииПоКлючу = Новый Соответствие();
	Для Каждого Версия Из СервисВерсий.ВерсииПакетов(Номера) Цикл
		ВерсииПоКлючу.Вставить(КлючВерсии(Версия.ПакетИдентификатор, Версия.Версия), Версия);
	КонецЦикла;

	Возврат Новый Структура("Пакеты, Версии", Пакеты, ВерсииПоКлючу);

КонецФункции

// Ключ версии — та же пара, по которой её ищет реестр: номер пакета и строка версии
// как есть, без приведения регистра.
Функция КлючВерсии(Знач ПакетИдентификатор, Знач СтрокаВерсии)
	Возврат Строка(ПакетИдентификатор) + "|" + СокрЛП(Строка(СтрокаВерсии));
КонецФункции

// Разбор канонического "{пакет}-{версия}.ospx"; имя иного вида даёт пустую строку.
Функция СтрокаВерсииИзИмениФайла(Знач ИмяПакета, Знач ИмяФайла)

	Префикс = ИмяПакета + "-";
	Имя = Строка(ИмяФайла);
	Если НЕ СтрНачинаетсяС(НРег(Имя), НРег(Префикс)) ИЛИ НЕ СтрЗаканчиваетсяНа(НРег(Имя), ".ospx") Тогда
		Возврат "";
	КонецЕсли;

	Длина = СтрДлина(Имя) - СтрДлина(Префикс) - 5;
	Возврат ?(Длина <= 0, "", Сред(Имя, СтрДлина(Префикс) + 1, Длина));

КонецФункции

// Старые -> новые по времени записи.
Функция ПоВозрастаниюДавности(Знач Опись)

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Изменён");
	Таблица.Колонки.Добавить("Элемент");

	Для Каждого Элемент Из Опись Цикл
		Строка = Таблица.Добавить();
		Строка.Изменён = Элемент.Изменён;
		Строка.Элемент = Элемент;
	КонецЦикла;

	Таблица.Сортировать("Изменён Возр");

	Результат = Новый Массив();
	Для Каждого Строка Из Таблица Цикл
		Результат.Добавить(Строка.Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Квота спрашивается у СервисаПулов: «сколько пулу можно» решается в одном месте на весь хаб.
Функция КвотаПулаБайт(Знач Пул)
	Возврат СервисПулов.ЭффективнаяКвотаБайт(Пул);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисПроисхождения") _СервисПроисхождения,
	&Пластилин(Значение = "УчётОбъёмаПула") _Объёмы,
	&Пластилин(Значение = "ХранилищеАртефактов") _Хранилище,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;
	СервисПроисхождения = _СервисПроисхождения;
	Объёмы = _Объёмы;
	Хранилище = _Хранилище;

КонецПроцедуры
