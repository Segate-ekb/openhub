// Задача планировщика «gc-кэша-прокси»: вытеснение привезённых с источников версий до квоты пула.

Перем Сборщик;   // СборщикКэшаПрокси
Перем Интервал;  // интервал сборки из настройки, секунды

// Регистрация в планировщике: сборка раз в интервал из настройки.
//
// Параметры:
//  Регистрации - РегистрацииЗадачи - куда записывается регистрация.
//
Процедура Зарегистрировать(Регистрации) Экспорт
	Регистрации.КаждыеСекунд("gc-кэша-прокси", Интервал);
КонецПроцедуры

// Выполняет один проход сборки кэша прокси до квоты.
// Сбой сборки перебрасывается планировщику.
//
&Наблюдаемый("job.proxy_gc")
Процедура Исполнить() Экспорт
	Сборщик.Собрать();
КонецПроцедуры

&Прозвище("ЗадачаПланировщика")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СборщикКэшаПрокси") _Сборщик,
	&Деталька(Значение = "oshub.jobs.proxy_gc_interval_sec", ЗначениеПоУмолчанию = 3600) _Интервал = Неопределено)

	Сборщик = _Сборщик;
	Интервал = Новый ПриведениеЧисел().ЧислоИлиДефолт(_Интервал, 3600);

КонецПроцедуры
