// Разбор страницы пакета источника: версии берутся из ссылок на артефакты ЭТОГО пакета.
// Протокол источника, а не зеркала: им живут и перечисление зеркала, и выдача.

Перем Сравнитель; // СравнительВерсий (реестр) — валидность и порядок версий

#Область ПубличныйИнтерфейс

// Извлекает версии пакета из разметки его страницы на апстриме. Учитываются только
// ссылки на артефакт вида "{имя}/{имя}-{версия}.ospx"; строка, не разбирающаяся как
// версия, отбрасывается.
//
// Параметры:
//  Разметка - Строка - разметка страницы пакета.
//  ИмяПакета - Строка - имя пакета в апстриме.
//
// Возвращаемое значение:
//  Массив из Строка - версии без дублей, по убыванию.
//
Функция Версии(Знач Разметка, Знач ИмяПакета) Экспорт

	Найденные = Новый Массив();
	Если НЕ ЗначениеЗаполнено(Разметка) ИЛИ НЕ ЗначениеЗаполнено(ИмяПакета) Тогда
		Возврат Найденные;
	КонецЕсли;

	Имя = СокрЛП(Строка(ИмяПакета));
	Учтённые = Новый Соответствие();
	Для Каждого Ссылка Из Ссылки(Строка(Разметка)) Цикл
		Значение = ВерсияИзСсылки(Ссылка, Имя);
		Если Значение = Неопределено ИЛИ Учтённые.Получить(Значение) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Разобранная = Сравнитель.ПопытатьсяРазобрать(Значение);
		Если Разобранная = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Учтённые.Вставить(Значение, Истина);
		Найденные.Добавить(Новый Структура("Значение, Разобранная", Значение, Разобранная));
	КонецЦикла;

	Возврат ПоУбыванию(Найденные);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Значения href — и в двойных кавычках, и в одинарных.
Функция Ссылки(Знач Разметка)

	Результат = Новый Массив();
	Длина = СтрДлина(Разметка);
	// ищем по нижнему регистру, режем по исходной строке — длины обязаны совпадать
	Нижний = НРег(Разметка);
	Если СтрДлина(Нижний) <> Длина Тогда
		Нижний = Разметка;
	КонецЕсли;

	Курсор = 1;
	Пока Курсор <= Длина Цикл
		Начало = СтрНайти(Нижний, "href", НаправлениеПоиска.СНачала, Курсор);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Курсор = Начало + СтрДлина("href");
		Значение = ?(ИмяАтрибутаЦеликом(Нижний, Начало),
			ЗначениеАтрибута(Разметка, Нижний, Длина, Курсор), Неопределено);
		Если Значение <> Неопределено Тогда
			Результат.Добавить(Значение.Текст);
			Курсор = Значение.Конец;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Имя атрибута отделено пробельным символом — иначе это хвост чужого имени ("data-xhref").
Функция ИмяАтрибутаЦеликом(Знач Текст, Знач Начало)
	Возврат Начало = 1 ИЛИ ПустаяСтрока(Сред(Текст, Начало - 1, 1));
КонецФункции

// Неопределено, если за "href" не следует значение в кавычках.
Функция ЗначениеАтрибута(Знач Разметка, Знач Нижний, Знач Длина, Знач Позиция)

	Курсор = БезПробелов(Нижний, Длина, Позиция);
	Если Сред(Нижний, Курсор, 1) <> "=" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Курсор = БезПробелов(Нижний, Длина, Курсор + 1);
	Кавычка = Сред(Разметка, Курсор, 1);
	Если (Кавычка <> """" И Кавычка <> "'") ИЛИ Курсор >= Длина Тогда
		Возврат Неопределено;
	КонецЕсли;

	Конец = СтрНайти(Разметка, Кавычка, НаправлениеПоиска.СНачала, Курсор + 1);
	Если Конец = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Текст, Конец",
		Сред(Разметка, Курсор + 1, Конец - Курсор - 1), Конец);

КонецФункции

Функция БезПробелов(Знач Текст, Знач Длина, Знач Позиция)

	Курсор = Позиция;
	Пока Курсор <= Длина И ПустаяСтрока(Сред(Текст, Курсор, 1)) Цикл
		Курсор = Курсор + 1;
	КонецЦикла;
	Возврат Курсор;

КонецФункции

// Неопределено, если ссылка не ведёт на версионный артефакт этого пакета.
Функция ВерсияИзСсылки(Знач Ссылка, Знач ИмяПакета)

	Сегменты = СтрРазделить(БезЗапросаИЯкоря(Ссылка), "/", Ложь);
	Если Сегменты.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// каталог артефакта — имя пакета целиком: "alfa-extra" не пакет "alfa"
	Если НРег(Сегменты[Сегменты.Количество() - 2]) <> НРег(ИмяПакета) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Файл = Сегменты[Сегменты.Количество() - 1];
	Если НЕ СтрЗаканчиваетсяНа(НРег(Файл), ".ospx") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Основа = Лев(Файл, СтрДлина(Файл) - СтрДлина(".ospx"));

	// имя файла начинается с имени пакета: без дефиса это latest, с чужим именем — чужой артефакт
	Префикс = ИмяПакета + "-";
	Если НЕ СтрНачинаетсяС(НРег(Основа), НРег(Префикс)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Сред(Основа, СтрДлина(Префикс) + 1);

КонецФункции

Функция БезЗапросаИЯкоря(Знач Ссылка)
	Возврат ДоСимвола(ДоСимвола(СокрЛП(Строка(Ссылка)), "?"), "#");
КонецФункции

Функция ДоСимвола(Знач Текст, Знач Символ)
	Позиция = СтрНайти(Текст, Символ);
	Возврат ?(Позиция > 0, Лев(Текст, Позиция - 1), Текст);
КонецФункции

// Вставками: версий на странице десятки, а перебор сравнивает уже разобранные версии.
Функция ПоУбыванию(Знач Найденные)

	Упорядоченные = Новый Массив();
	Для Каждого Элемент Из Найденные Цикл
		Место = Упорядоченные.Количество();
		Для Индекс = 0 По Упорядоченные.Количество() - 1 Цикл
			Если Старше(Элемент, Упорядоченные[Индекс]) Тогда
				Место = Индекс;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Упорядоченные.Вставить(Место, Элемент);
	КонецЦикла;

	Результат = Новый Массив();
	Для Каждого Элемент Из Упорядоченные Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Равные по порядку («1.0.0» и «v1.0.0») разводит сравнение строк — порядок ссылок не решает.
Функция Старше(Знач Элемент, Знач Другой)

	Порядок = Элемент.Разобранная.Сравнить(Другой.Разобранная);
	Если Порядок = 0 Тогда
		Возврат Элемент.Значение > Другой.Значение;
	КонецЕсли;
	Возврат Порядок > 0;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СравнительВерсий") _Сравнитель)
	Сравнитель = _Сравнитель;
КонецПроцедуры
