// Состояние источника одним словом для экрана и API: вердикт памяти СтражаАпстримов,
// сложенный с письменной памятью о прошлой неудаче. Прошлое наблюдение за нынешний
// вердикт не выдаётся: после перезапуска источник числится непроверенным, а причина,
// по которой он молчал, названа отдельно.

Перем Страж;      // СтражАпстримов (прокси) — вердикт в памяти процесса
Перем Читатель;   // ЧитательПомех (помехи) — письменная память; БРОСАЕТ при лежащей базе
Перем Коды;       // КодыПомех (помехи)
Перем Объекты;    // ОбъектыПомех (помехи)
Перем Адреса;     // АдресаИсточников (прокси) — где у записи её адрес
Перем Ошибки;     // ТекстОшибки (основа) — причина сбоя строкой журнала
&Лог
Перем Лог;

#Область СловарьСостояний

// Источник отвечает и пускает.
//
// Возвращаемое значение:
//  Строка.
//
Функция Жив() Экспорт
	Возврат "alive";
КонецФункции

// Источник не отвечает.
//
// Возвращаемое значение:
//  Строка.
//
Функция Лежит() Экспорт
	Возврат "down";
КонецФункции

// Источник ответил, но этот доступ не пустил.
//
// Возвращаемое значение:
//  Строка.
//
Функция НеПустил() Экспорт
	Возврат "denied";
КонецФункции

// Источник ещё не проверяли — в том числе после перезапуска хаба.
//
// Возвращаемое значение:
//  Строка.
//
Функция НеПроверялся() Экспорт
	Возврат "unknown";
КонецФункции

// Источник выключен рукой и не опрашивается вовсе. Живость — свойство адреса, тумблер —
// свойство записи, поэтому слово подставляет СУчётомТумблера, а не проба живости.
//
// Возвращаемое значение:
//  Строка.
//
Функция Выключен() Экспорт
	Возврат "disabled";
КонецФункции

// Состояние с учётом тумблера записи: выключенный рукой источник назван выключенным,
// а о живости его адреса хаб ничего не утверждает. Прошлая неудача при этом остаётся —
// она свойство АДРЕСА, а не тумблера, и экран с карточкой API обязаны говорить о ней
// одно и то же.
//
// Параметры:
//  Состояние - Структура - снимок из ПоИсточникам.
//  Включён - Булево - опрашивается ли источник.
//
// Возвращаемое значение:
//  Структура - снимок того же вида.
//
Функция СУчётомТумблера(Знач Состояние, Знач Включён) Экспорт

	Если Включён = Истина Тогда
		Возврат Состояние;
	КонецЕсли;

	Возврат Слепок(Выключен(), "", '00010101000000', Состояние.ПрошлаяНеудача);

КонецФункции

#КонецОбласти

#Область ПубличныйИнтерфейс

// Состояние каждого источника в порядке, в котором источники даны. Письменная память
// читается ОДНИМ обращением на весь список: цена экрана не растёт с числом источников.
// Недоступная письменная память не отменяет вердикта — снимок приходит без прошлой
// неудачи, а жалоба уходит в журнал.
//
// Параметры:
//  Источники - Массив - записи источников (АпстримПула, ЗеркалоХаба либо их заглушки).
//
// Возвращаемое значение:
//  Массив из Структура - Источник (запись как дали) и Состояние:
//                        * Код - Строка - жив · лежит · не пустил · не проверялся;
//                          тумблер записи здесь не спрашивается;
//                        * Причина - Строка - почему источник не в работе; пусто у живого;
//                        * Проверено - Дата - момент вердикта; пустая, если не проверялся;
//                        * ПрошлаяНеудача - Структура(Есть, Код, Причина, Когда) —
//                          письменная память, пережившая перезапуск.
//
Функция ПоИсточникам(Знач Источники) Экспорт

	Написанное = ПисьменнаяПамять(Источники);

	Результат = Новый Массив();
	Для Каждого Источник Из Источники Цикл
		Результат.Добавить(Новый Структура("Источник, Состояние",
			Источник, Состояние(Источник, Написанное)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СкладываниеПамяти

Функция Состояние(Знач Источник, Знач Написанное)

	Прошлая = ПрошлаяНеудача(Написанное.Получить(ОбъектПомех(Источник)));

	Отметка = Страж.Состояние(Источник);
	Если НЕ Отметка.Известно Тогда
		Возврат Слепок(НеПроверялся(), "", '00010101000000', Прошлая);
	КонецЕсли;

	Если НЕ Отметка.Живой Тогда
		Возврат Слепок(Лежит(), Отметка.Причина, Отметка.Проверено, Прошлая);
	КонецЕсли;

	Если Отметка.ОтказДоступа Тогда
		Возврат Слепок(НеПустил(), Отметка.Причина, Отметка.Проверено, Прошлая);
	КонецЕсли;

	Возврат Слепок(Жив(), "", Отметка.Проверено, Прошлая);

КонецФункции

Функция Слепок(Знач Код, Знач Причина, Знач Проверено, Знач Прошлая)

	Возврат Новый Структура("Код, Причина, Проверено, ПрошлаяНеудача",
		Код, Строка(Причина), Проверено, Прошлая);

КонецФункции

// Последняя записанная неудача источника: записи приходят от читателя новыми сверху,
// поэтому годится первая, причина которой — про сам источник.
Функция ПрошлаяНеудача(Знач Записанное)

	Если Записанное = Неопределено Тогда
		Возврат НеудачиНет();
	КонецЕсли;

	Для Каждого Запись Из Записанное Цикл
		Если Запись.Код = Коды.ИсточникЛежит() Тогда
			Возврат Неудача(Лежит(), Запись);
		КонецЕсли;
		Если Запись.Код = Коды.ИсточникНеПустил() Тогда
			Возврат Неудача(НеПустил(), Запись);
		КонецЕсли;
	КонецЦикла;

	Возврат НеудачиНет();

КонецФункции

Функция Неудача(Знач Код, Знач Запись)

	Возврат Новый Структура("Есть, Код, Причина, Когда",
		Истина, Код, Строка(Запись.Причина), Запись.Последний);

КонецФункции

Функция НеудачиНет()
	Возврат Новый Структура("Есть, Код, Причина, Когда", Ложь, "", "", '00010101000000');
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Письменная память обо всех источниках списка — одним обращением к таблице помех.
// Лежащая база отнимает у экрана прошлые неудачи, но не вердикт: именно на лежащей базе
// экран источников нужен больше всего.
Функция ПисьменнаяПамять(Знач Источники)

	Объекты_ = Новый Массив();
	Для Каждого Источник Из Источники Цикл
		Объекты_.Добавить(ОбъектПомех(Источник));
	КонецЦикла;

	Попытка
		Возврат Читатель.ПомехиОбъектов(Коды.ПодсистемаИсточник(), Объекты_);
	Исключение
		// информация достоверна только в кадре обработчика — дальше она едет параметром
		ПожаловатьсяНаПамять(ИнформацияОбОшибке());
		Возврат Новый Соответствие();
	КонецПопытки;

КонецФункции

Процедура ПожаловатьсяНаПамять(Знач Инфо)

	Лог.Предупреждение("Состояние источников: письменная память недоступна,"
		+ " показан только вердикт памяти процесса: %1", Ошибки.Причина(Инфо));

КонецПроцедуры

Функция ОбъектПомех(Знач Источник)
	Возврат Объекты.Источник(Адреса.Источника(Источник));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СтражАпстримов") _Страж,
	&Пластилин(Значение = "ЧитательПомех") _Читатель,
	&Пластилин(Значение = "КодыПомех") _Коды,
	&Пластилин(Значение = "ОбъектыПомех") _Объекты,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "АдресаИсточников") _Адреса = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Страж = _Страж;
	Читатель = _Читатель;
	Коды = _Коды;
	Объекты = _Объекты;
	Адреса = ?(_Адреса = Неопределено, Новый АдресаИсточников(), _Адреса);
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
