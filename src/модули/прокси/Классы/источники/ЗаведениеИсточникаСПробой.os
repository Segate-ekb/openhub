// Заведение источника пробным подключением — реализация контракта ЗаведениеИсточника для апстрима
// пула и зеркала: введённый токен становится тем, с чем источник опрашивается, и доказывается пробой до записи.

Перем Секрет;   // СекретИсточника (прокси) — правило токена источника
Перем Пробник;  // ПробникИсточника (прокси) — пробное подключение; может быть Неопределено

#Область ПубличныйИнтерфейс

// Токен, с которым источник будет опрашиваться, доказанный пробным подключением.
//
// Параметры:
//  Адрес - Строка - базовый URL выдачи источника.
//  Введённое - Строка - то, что пришло формой либо телом запроса; пустое значение
//              и маска оставляют прежний токен.
//  Источник - АпстримПула, ЗеркалоХаба, Неопределено - запись источника, у которой берётся
//             прежний токен; Неопределено — источник заводится впервые.
//  СнятьТокен - Булево - завести источник без токена: он проверяется и опрашивается
//               анонимно. Старше введённого значения (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Строка - токен, который следует записать.
//
// Выбрасывает исключение при непригодном токене и при неудачной пробе подключения.
//
Функция ПринятьДоступ(Знач Адрес, Знач Введённое, Знач Источник, Знач СнятьТокен = Ложь) Экспорт

	Токен = ?(СнятьТокен = Истина, "", ПринятьТокен(Введённое, Источник));
	ПроверитьПодключение(Адрес, Токен);
	Возврат Токен;

КонецФункции

// Токен без пробы подключения: правка доступа у уже заведённого источника адрес заново
// не проверяет.
//
// Параметры:
//  Введённое - Строка - то, что пришло формой либо телом запроса.
//  Источник - АпстримПула, ЗеркалоХаба, Неопределено - запись источника.
//
// Возвращаемое значение:
//  Строка - токен, который следует записать.
//
// Выбрасывает исключение при непригодном токене.
//
Функция ПринятьТокен(Знач Введённое, Знач Источник) Экспорт
	Возврат Секрет.ПринятьВвод(Введённое, Секрет.ИзИсточника(Источник));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Не подключился — не сохраняем; контейнер без пробника заведение не блокирует: ходить нечем.
Процедура ПроверитьПодключение(Знач Адрес, Знач Токен)

	Если Пробник = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Пробник.ТребоватьПодключение(Адрес, Токен);

КонецПроцедуры

#КонецОбласти

&Прозвище("ЗаведениеИсточника")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СекретИсточника") _Секрет = Неопределено,
	&Пластилин(Значение = "ПробникИсточника", Тип = "Массив") _Пробник = Неопределено)

	Секрет = ?(_Секрет = Неопределено, Новый СекретИсточника(), _Секрет);
	Пробник = Новый ВнедрённыеЖелуди().ПервыйИз(_Пробник);

КонецПроцедуры
