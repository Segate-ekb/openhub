// Машинные коды происшествий источников пула (проксируемых апстримов): обе причины про
// чужую сторону, обе проходят сами.

Перем Коды;  // ОбъявленияКодовПроисшествий (происшествия)

#Область ПубличныйИнтерфейс

// Имя подсистемы источников пула.
//
// Возвращаемое значение:
//  Строка.
//
Функция Подсистема() Экспорт
	Возврат Коды.Подсистема();
КонецФункции

// Объявления кодов подсистемы в порядке объявления.
//
// Возвращаемое значение:
//  ОбъявленияКодовПроисшествий - имя подсистемы и её коды.
//
Функция Объявления() Экспорт
	Возврат Коды;
КонецФункции

// Источник пула лежит.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсточникЛежит() Экспорт
	Возврат Коды.Объявленный("upstream_down");
КонецФункции

// Источник пула не пустил: токен, права, политика доступа.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсточникНеПустил() Экспорт
	Возврат Коды.Объявленный("upstream_denied");
КонецФункции

#КонецОбласти

&Прозвище("КодыПроисшествийПодсистемы")
&Порядок(40)
&Желудь
Процедура ПриСозданииОбъекта() Экспорт

	Коды = Новый ОбъявленияКодовПроисшествий("источник");

	Коды.Объявить("upstream_down", Истина);
	Коды.Объявить("upstream_denied", Истина);

КонецПроцедуры
