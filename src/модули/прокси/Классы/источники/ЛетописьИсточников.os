// Письменный двойник памяти СтражаАпстримов: почему источник молчит, переживает перезапуск хаба.
// В базу пишет на смене состояния и не чаще раза в срок перепроверки: страж зовётся на каждом запросе.

Перем Летопись;    // ЛетописьПроисшествий (происшествия)
Перем Коды;        // КодыПроисшествийИсточника (прокси)
Перем Объекты;     // ОбъектыПроисшествий (происшествия)
Перем Настройки;   // СервисНастроек (настройки) — срок перепроверки источника
Перем Адреса;      // АдресаИсточников (прокси) — ключ адреса, один на весь модуль
Перем Написанное;  // Соответствие: адрес → Структура(Код, Когда) — что уже в базе
Перем Правка;      // ПравкаКартыКопией (прокси) — карту «что написано» пишут несколько потоков
Перем Часы;        // Объект с методом Сейчас() -> Дата, либо Неопределено (системные часы)

#Область ТестовыеШвы

// Подставляет источник времени — тестовый шов; в рабочем контейнере не вызывается.
//
// Параметры:
//  ИсточникВремени - Произвольный - объект с методом Сейчас(), возвращающим Дату.
//
Процедура УстановитьЧасы(Знач ИсточникВремени) Экспорт
	Часы = ИсточникВремени;
КонецПроцедуры

#КонецОбласти

#Область ПубличныйИнтерфейс

// Записывает, что источник не отвечает.
//
// Параметры:
//  Адрес - Строка - адрес источника.
//  Причина - Строка - что именно не получилось.
//  Токен - Строка - токен доступа, которым ходили; его в причине быть не должно
//          (необязательный, по умолчанию "").
//
Процедура Лежит(Знач Адрес, Знач Причина, Знач Токен = "") Экспорт
	Записать(Адрес, Коды.ИсточникЛежит(), Причина, Токен);
КонецПроцедуры

// Записывает, что источник ответил, но этот доступ не пустил.
//
// Параметры:
//  Адрес - Строка - адрес источника.
//  Причина - Строка - чем именно источник ответил.
//  Токен - Строка - токен доступа, которому отказали (необязательный, по умолчанию "").
//
Процедура НеПустил(Знач Адрес, Знач Причина, Знач Токен = "") Экспорт
	Записать(Адрес, Коды.ИсточникНеПустил(), Причина, Токен);
КонецПроцедуры

// Снимает письменные причины источника: он снова отвечает. В базу идёт только тогда,
// когда за адресом что-то числится — иначе каждый удачный запрос выдачи стоил бы
// обращения к таблице происшествий.
//
// Параметры:
//  Адрес - Строка - адрес источника.
//
Процедура Ответил(Знач Адрес) Экспорт

	Ключ = Адреса.Ключом(Адрес);
	Если НЕ ЗначениеЗаполнено(Ключ) ИЛИ Чисто(Написанное.Получить(Ключ)) Тогда
		Возврат;
	КонецЕсли;

	Летопись.Снять(Коды.Подсистема(), Объекты.Источник(Адрес));
	Запомнить(Ключ, "", Сейчас());

КонецПроцедуры

// Забывает, что уже написано в базу: следующая отметка пойдёт туда заново.
//
Процедура Забыть() Экспорт
	Написанное = Новый Соответствие();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Записать(Знач Адрес, Знач Код, Знач Причина, Знач Токен)

	Ключ = Адреса.Ключом(Адрес);
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;

	Момент = Сейчас();
	Если НЕ ПораПисать(Написанное.Получить(Ключ), Код, Момент) Тогда
		Возврат;
	КонецЕсли;

	Летопись.Записать(Коды.Подсистема(), Объекты.Источник(Адрес), "",
		Код, Причина, "", Токен);
	Запомнить(Ключ, Код, Момент);

КонецПроцедуры

// Сразу пишется смена кода состояния; смена текста причины и повтор того же кода — раз в срок,
// иначе флапающий источник диктовал бы запись на каждый неудачный запрос.
Функция ПораПисать(Знач Отметка, Знач Код, Знач Момент)

	Если Отметка = Неопределено ИЛИ Отметка.Код <> Код Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат (Момент - Отметка.Когда) >= СрокМеждуЗаписями();

КонецФункции

// Пустой код отметки означает «за адресом в базе ничего не числится».
Функция Чисто(Знач Отметка)
	Возврат Отметка <> Неопределено И НЕ ЗначениеЗаполнено(Отметка.Код);
КонецФункции

// Срок памяти стража, но не чаще раза в минуту: перепроверку живости разрешено выключить
// нулём, а хождение в базу на каждый неудачный запрос выдачи — нет.
Функция СрокМеждуЗаписями()
	Возврат Макс(Настройки.Целое("oshub.proxy.upstream.recheck.ttl.sec", 0), 60);
КонецФункции

// Пишут и фоновый обход здоровья, и потоки запросов выдачи.
Процедура Запомнить(Знач Ключ, Знач Код, Знач Момент)
	Написанное = Правка.СКлючом(Написанное, Ключ, Новый Структура("Код, Когда", Код, Момент));
КонецПроцедуры

Функция Сейчас()
	Возврат ?(Часы = Неопределено, ТекущаяУниверсальнаяДата(), Часы.Сейчас());
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЛетописьПроисшествий") _Летопись,
	&Пластилин(Значение = "КодыПроисшествийИсточника") _Коды,
	&Пластилин(Значение = "ОбъектыПроисшествий") _Объекты,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "АдресаИсточников") _Адреса = Неопределено)

	Летопись = _Летопись;
	Коды = _Коды;
	Объекты = _Объекты;
	Настройки = _Настройки;
	Адреса = ?(_Адреса = Неопределено, Новый АдресаИсточников(), _Адреса);
	Написанное = Новый Соответствие();
	Правка = Новый ПравкаКартыКопией();
	Часы = Неопределено;

КонецПроцедуры
