// Правка карты, которую читают без замка: новый ключ даёт новую карту целиком, и гонящийся поток
// видит либо прежнее состояние, либо новое, но не полусобранное. Своего состояния у класса нет.

#Область ПубличныйИнтерфейс

// Карта с записью по ключу. Значение существующего ключа перезаписывается на месте — это
// безопасно; новый ключ даёт новую карту.
//
// Параметры:
//  Карта - Соответствие - текущая карта.
//  Ключ - Строка - ключ записи.
//  Значение - Произвольный - запись.
//
// Возвращаемое значение:
//  Соответствие - карта, которая присваивается на место прежней.
//
Функция СКлючом(Знач Карта, Знач Ключ, Знач Значение) Экспорт

	Если Карта.Получить(Ключ) <> Неопределено Тогда
		Карта.Вставить(Ключ, Значение);
		Возврат Карта;
	КонецЕсли;

	Новая = Новый Соответствие();
	Для Каждого КиЗ Из Карта Цикл
		Новая.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Новая.Вставить(Ключ, Значение);
	Возврат Новая;

КонецФункции

// Карта без записи по ключу; отсутствующий ключ возвращает ту же карту.
//
// Параметры:
//  Карта - Соответствие - текущая карта.
//  Ключ - Строка - ключ снимаемой записи.
//
// Возвращаемое значение:
//  Соответствие - карта, которая присваивается на место прежней.
//
Функция БезКлюча(Знач Карта, Знач Ключ) Экспорт

	Если Карта.Получить(Ключ) = Неопределено Тогда
		Возврат Карта;
	КонецЕсли;

	Новая = Новый Соответствие();
	Для Каждого КиЗ Из Карта Цикл
		Если КиЗ.Ключ <> Ключ Тогда
			Новая.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Новая;

КонецФункции

#КонецОбласти
