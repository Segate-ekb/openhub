// Сквозное HTTP-скачивание выдачи внешнего хаба по контракту opm (list.txt и .ospx).
// Перенаправления отслеживаются с потолком oshub.proxy.max_redirects; недоступность — Код = 0.

Перем Настройки;   // СервисНастроек (настройки) — таймаут похода в апстрим
Перем Транспорт;   // ТранспортHTTP - единый исходящий HTTP-клиент
Перем Секрет;      // СекретИсточника (прокси) — заголовок авторизации источника
Перем Обезличивание; // ОбезличиваниеЖурнала (наблюдаемость)
Перем ЧтениеЗаголовков;   // ЗаголовкиHTTP (основа) — чтение заголовков ответа апстрима
Перем Ошибки;      // ТекстОшибки (основа)
&Лог
Перем Лог;

// Скачивает текстовый ресурс апстрима.
//
// Параметры:
//  БазовыйURL - Строка - базовый URL выдачи апстрима (контракт opm).
//  ОтносительныйПуть - Строка - путь ресурса относительно базового, например "list.txt".
//  УсловныйETag - Строка - ETag для If-None-Match; пустой даёт безусловный запрос
//                 (необязательный, по умолчанию "").
//  Токен - Строка - токен доступа к приватной выдаче источника; пустой даёт анонимный
//          запрос (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Код (Число; 0 — апстрим недоступен), Тело (Строка, заполнено при Код = 200),
//              ETag (Строка), Пояснение (Строка, причина недоступности либо "").
//
Функция ПолучитьТекст(Знач БазовыйURL, Знач ОтносительныйПуть, Знач УсловныйETag = "",
	Знач Токен = "") Экспорт

	Результат = Новый Структура("Код, Тело, ETag, Пояснение", 0, "", "", "");

	Попытка
		Ответ = ВыполнитьЗапрос(БазовыйURL, ОтносительныйПуть, УсловныйETag, Токен);
		Результат.Код = Ответ.Код;
		Результат.ETag = ЗаголовокОтвета(Ответ.Заголовки, "ETag");
		Если Ответ.Код = 200 Тогда
			Результат.Тело = ПолучитьСтрокуИзДвоичныхДанных(Ответ.Данные, "UTF-8");
		КонецЕсли;
	Исключение
		Результат.Код = 0; // сетевой сбой — offline, наверх не бросаем
		Результат.Пояснение = Ошибки.Однострочно(ОписаниеОшибки());
		ОтметитьНедоступность(БазовыйURL, ОтносительныйПуть, Результат.Пояснение);
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Скачивает двоичный ресурс апстрима. Тело читается двоично, без разжатия,
// поэтому байты .ospx приходят как есть.
//
// Параметры:
//  БазовыйURL - Строка - базовый URL выдачи апстрима (контракт opm).
//  ОтносительныйПуть - Строка - путь ресурса вида "{имя}/{имя}-{версия}.ospx".
//  УсловныйETag - Строка - ETag для If-None-Match; пустой даёт безусловный запрос
//                 (необязательный, по умолчанию "").
//  Токен - Строка - токен доступа к приватной выдаче источника; пустой даёт анонимный
//          запрос (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Код (Число; 0 — апстрим недоступен), Данные (ДвоичныеДанные при Код = 200,
//              иначе Неопределено), ETag (Строка),
//              Пояснение (Строка, причина недоступности либо "").
//
Функция СкачатьДанные(Знач БазовыйURL, Знач ОтносительныйПуть, Знач УсловныйETag = "",
	Знач Токен = "") Экспорт

	Результат = Новый Структура("Код, Данные, ETag, Пояснение", 0, Неопределено, "", "");

	Попытка
		Ответ = ВыполнитьЗапрос(БазовыйURL, ОтносительныйПуть, УсловныйETag, Токен);
		Результат.Код = Ответ.Код;
		Результат.ETag = ЗаголовокОтвета(Ответ.Заголовки, "ETag");
		Если Ответ.Код = 200 Тогда
			Результат.Данные = Ответ.Данные;
		КонецЕсли;
	Исключение
		Результат.Код = 0;
		Результат.Пояснение = Ошибки.Однострочно(ОписаниеОшибки());
		ОтметитьНедоступность(БазовыйURL, ОтносительныйПуть, Результат.Пояснение);
	КонецПопытки;

	Возврат Результат;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьЗапрос(Знач БазовыйURL, Знач ОтносительныйПуть, Знач УсловныйETag, Знач Токен)

	ПолныйURL = ОбъединитьПутьЗапроса(БазовыйURL, ОтносительныйПуть);

	Заголовки = Новый Соответствие();
	// значения заголовков только ASCII — ограничение HTTP-клиента
	Заголовки.Вставить("User-Agent", "openhub-proxy");
	Если ЗначениеЗаполнено(УсловныйETag) Тогда
		Заголовки.Вставить("If-None-Match", Строка(УсловныйETag));
	КонецЕсли;
	Секрет.Предъявить(Заголовки, Токен);

	// в журнал едет факт наличия токена, а не его значение
	Лог.Отладка("Апстрим: запрос %1, условный по ETag: %2, токен источника %3, таймаут %4 с",
		Обезличивание.Адрес(ПолныйURL), ЗначениеЗаполнено(УсловныйETag),
		Секрет.ДляЖурнала(Токен), ТаймаутСек());

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Ответ = ПройтиЦепочку(ПолныйURL, Заголовки);

	Лог.Отладка("Апстрим: %1 ответил %2, тело %3 байт, ETag %4, за %5 мс",
		Обезличивание.Адрес(ПолныйURL), Ответ.Код, РазмерТела(Ответ.Данные),
		ЗаголовокОтвета(Ответ.Заголовки, "ETag"),
		ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало);

	Возврат Ответ;

КонецФункции

// По Location ходит хаб, а не транспорт: только так переходы можно посчитать и оборвать.
Функция ПройтиЦепочку(Знач ПервыйURL, Знач Заголовки)

	Потолок = ПотолокПеренаправлений();
	Адрес = ПервыйURL;
	Отправляемые = Заголовки;
	Переходов = 0;

	Пока Истина Цикл
		Ответ = Транспорт.Получить(Адрес, Отправляемые, ТаймаутСек(), Истина, Ложь);

		Цель = ЦельПеренаправления(Ответ, Адрес);
		Если НЕ ЗначениеЗаполнено(Цель) Тогда
			Возврат Ответ;
		КонецЕсли;

		Если Переходов >= Потолок Тогда
			ВызватьИсключение СтрШаблон(
				"цепочка перенаправлений длиннее %1 переходов (потолок oshub.proxy.max_redirects)",
				Формат(Потолок, "ЧГ=0; ЧН=0"));
		КонецЕсли;

		Переходов = Переходов + 1;
		Лог.Отладка("Апстрим: переход %1 по Location на %2",
			Формат(Переходов, "ЧГ=0; ЧН=0"), Обезличивание.Адрес(Цель));
		Отправляемые = ЗаголовкиДляПерехода(Отправляемые, Адрес, Цель);
		Адрес = Цель;
	КонецЦикла;

КонецФункции

// Токен выдан узлом источника и не уезжает ни на чужой узел, ни в открытый канал.
Функция ЗаголовкиДляПерехода(Знач Заголовки, Знач Откуда, Знач Куда)

	Если Узел(Откуда) = Узел(Куда) И НЕ ЭтоПонижениеКанала(Откуда, Куда) Тогда
		Возврат Заголовки;
	КонецЕсли;

	Лог.Отладка("Апстрим: переход на %1 уводит запрос с узла источника либо в открытый канал"
		+ " — токен источника не предъявляется", Обезличивание.Адрес(Куда));
	Возврат Секрет.Отозвать(Заголовки);

КонецФункции

// Понижение — это уход с https куда угодно, кроме https: обратный шаг раздевает секрет.
Функция ЭтоПонижениеКанала(Знач Откуда, Знач Куда)
	Возврат Схема(Откуда) = "https" И Схема(Куда) <> "https";
КонецФункции

Функция Схема(Знач Адрес)

	Значение = СокрЛП(Строка(Адрес));
	Позиция = Найти(Значение, "://");
	Возврат ?(Позиция = 0, "", НРег(Лев(Значение, Позиция - 1)));

КонецФункции

// Узел адреса — хост с портом, без учёта регистра; схему судит ЭтоПонижениеКанала.
Функция Узел(Знач Адрес)

	Значение = СокрЛП(Строка(Адрес));
	Позиция = Найти(Значение, "://");
	Остаток = ?(Позиция = 0, Значение, Сред(Значение, Позиция + 3));

	Конец = СтрДлина(Остаток);
	Для Каждого Разделитель Из СтрРазделить("/,?,#", ",") Цикл
		Найдено = Найти(Остаток, Разделитель);
		Если Найдено > 0 И (Найдено - 1) < Конец Тогда
			Конец = Найдено - 1;
		КонецЕсли;
	КонецЦикла;

	Возврат НРег(Лев(Остаток, Конец));

КонецФункции

// Пусто, если ответ не перенаправление либо Location отсутствует.
Функция ЦельПеренаправления(Знач Ответ, Знач ТекущийАдрес)

	Код = Цел(Ответ.Код);
	Если Код <> 301 И Код <> 302 И Код <> 303 И Код <> 307 И Код <> 308 Тогда
		Возврат "";
	КонецЕсли;

	Location = СокрЛП(ЗаголовокОтвета(Ответ.Заголовки, "Location"));
	Если НЕ ЗначениеЗаполнено(Location) Тогда
		Возврат "";
	КонецЕсли;

	Возврат АбсолютныйАдрес(ТекущийАдрес, Location);

КонецФункции

// Относительный Location разворачивается относительно текущего адреса цепочки.
Функция АбсолютныйАдрес(Знач Текущий, Знач Location)

	Если Найти(Location, "://") > 0 Тогда
		Возврат Location;
	КонецЕсли;

	Позиция = Найти(Текущий, "://");
	НачалоХоста = ?(Позиция > 0, Позиция + 3, 1);
	Слеш = Найти(Сред(Текущий, НачалоХоста), "/");
	Корень = ?(Слеш = 0, Текущий, Лев(Текущий, НачалоХоста + Слеш - 2));

	Если Лев(Location, 1) = "/" Тогда
		Возврат Корень + Location;
	КонецЕсли;

	Каталог = Текущий;
	ПоследнийСлеш = СтрНайти(Сред(Каталог, НачалоХоста), "/", НаправлениеПоиска.СКонца);
	Если ПоследнийСлеш > 0 Тогда
		Каталог = Лев(Каталог, НачалоХоста + ПоследнийСлеш - 1);
	Иначе
		Каталог = Каталог + "/";
	КонецЕсли;
	Возврат Каталог + Location;

КонецФункции

// Единственное место в журнале, где видно, почему хаб ушёл в offline: наверх идёт код 0.
Процедура ОтметитьНедоступность(Знач БазовыйURL, Знач ОтносительныйПуть, Знач Пояснение)

	Лог.Отладка("Апстрим: %1 недоступен (offline), причина: %2",
		Обезличивание.Адрес(ОбъединитьПутьЗапроса(БазовыйURL, ОтносительныйПуть)), Пояснение);

КонецПроцедуры

Функция РазмерТела(Знач Данные)

	Если Данные = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
		Возврат Данные.Размер();
	КонецЕсли;

	Возврат СтрДлина(Строка(Данные));

КонецФункции

// Ровно один слеш на стыке; схема в базовом URL не затрагивается.
Функция ОбъединитьПутьЗапроса(Знач БазовыйURL, Знач Относительный)

	Левая = СокрЛП(БазовыйURL);
	Если НЕ СтрЗаканчиваетсяНа(Левая, "/") Тогда
		Левая = Левая + "/";
	КонецЕсли;

	Правая = СокрЛП(Относительный);
	Пока СтрНачинаетсяС(Правая, "/") Цикл
		Правая = Сред(Правая, 2);
	КонецЦикла;

	Возврат Левая + Правая;

КонецФункции

Функция ЗаголовокОтвета(Знач ЗаголовкиОтвета, Знач Имя)
	Возврат ЧтениеЗаголовков.Текст(ЗаголовкиОтвета, Имя);
КонецФункции

// Таймаут спрашивается на запросе: правка из формы действует со следующего похода наружу.
Функция ТаймаутСек()
	Возврат Настройки.Значение("oshub.proxy.timeout.sec");
КонецФункции

Функция ПотолокПеренаправлений()
	Возврат Макс(0, Цел(Настройки.Значение("oshub.proxy.max_redirects")));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТранспортHTTP") _Транспорт,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "СекретИсточника") _Секрет = Неопределено,
	&Пластилин(Значение = "ЗаголовкиHTTP") _Заголовки = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Транспорт = _Транспорт;
	Настройки = _Настройки;
	// прямое создание вне контейнера (наборы) обходится своим экземпляром правила секрета
	Секрет = ?(_Секрет = Неопределено, Новый СекретИсточника(), _Секрет);
	ЧтениеЗаголовков = ?(_Заголовки = Неопределено, Новый ЗаголовкиHTTP(), _Заголовки);
	Обезличивание = Новый ОбезличиваниеЖурнала();

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
