// Где у записи источника лежит его адрес и каким ключом этот адрес узнаётся. Апстрим пула
// и зеркало хаба держат адрес в разных полях, и знать об этом обязано ровно одно место:
// иначе третья форма записи починится в одном классе, а в соседнем молча даст пустой адрес.

#Область ПубличныйИнтерфейс

// Адрес источника по его записи.
//
// Параметры:
//  Источник - АпстримПула, ЗеркалоХаба, Строка, Неопределено - запись источника либо
//             сам адрес строкой.
//
// Возвращаемое значение:
//  Строка - адрес; пустая строка, если адреса у записи нет.
//
Функция Источника(Знач Источник) Экспорт

	Если Источник = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Источник) = Тип("Строка") Тогда
		Возврат Строка(Источник);
	КонецЕсли;

	Попытка
		Возврат Строка(Источник.Url);
	Исключение
		// зеркало держит адрес источника в своём поле
	КонецПопытки;

	Попытка
		Возврат Строка(Источник.АпстримURL);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Ключ адреса: им один источник отличается от другого в картах памяти и в отпечатке
// доступа. Регистр адреса значения не имеет — один адрес, заведённый и пулом, и зеркалом,
// обязан помниться один раз.
//
// Параметры:
//  Адрес - Строка - адрес источника.
//
// Возвращаемое значение:
//  Строка - ключ; пустая строка, если адреса нет.
//
Функция Ключом(Знач Адрес) Экспорт
	Возврат НРег(СокрЛП(Строка(Адрес)));
КонецФункции

#КонецОбласти

&Прозвище("АдресаИсточников")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
