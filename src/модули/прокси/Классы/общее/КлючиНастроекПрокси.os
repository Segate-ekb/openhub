// Ключи настроек прокси апстрима: офлайн, пороги похода наружу, проба нового источника
// и уборка кэша.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей прокси в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи прокси.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(120)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "oshub.proxy.offline", ЗначениеПоУмолчанию = "") _Офлайн = "",
	&Деталька(Значение = "oshub.proxy.timeout.sec", ЗначениеПоУмолчанию = "") _ТаймаутАпстрима = "",
	&Деталька(Значение = "oshub.proxy.negative.ttl.sec", ЗначениеПоУмолчанию = "") _НегативныйTTL = "",
	&Деталька(Значение = "oshub.proxy.upstream.recheck.ttl.sec", ЗначениеПоУмолчанию = "") _TTLПерепроверки = "",
	&Деталька(Значение = "oshub.proxy.max_redirects", ЗначениеПоУмолчанию = "") _ПотолокРедиректов = "",
	&Деталька(Значение = "oshub.upstream.probe.enabled", ЗначениеПоУмолчанию = "") _ПробаИсточника = "",
	&Деталька(Значение = "oshub.jobs.proxy_gc_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалGCПрокси = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	// Офлайн — переключатель с последствиями, остальное — пороги похода наружу.
	Ключи.Объявить("oshub.proxy.offline", "булево", Ложь, Неопределено, "прикладная", _Офлайн);
	Ключи.Объявить("oshub.proxy.timeout.sec", "целое", 20, _Правила.Минимум(1), "прикладная",
		_ТаймаутАпстрима);
	Ключи.Объявить("oshub.proxy.negative.ttl.sec", "целое", 60, _Правила.Минимум(0), "прикладная",
		_НегативныйTTL);
	Ключи.Объявить("oshub.proxy.upstream.recheck.ttl.sec", "целое", 300, _Правила.Минимум(0), "прикладная",
		_TTLПерепроверки);
	Ключи.Объявить("oshub.proxy.max_redirects", "целое", 5, _Правила.Минимум(0), "прикладная",
		_ПотолокРедиректов);

	// Источник заводится пробным подключением; выключатель нужен инсталляции без выхода наружу.
	Ключи.Объявить("oshub.upstream.probe.enabled", "булево", Истина, Неопределено, "прикладная",
		_ПробаИсточника);

	Ключи.Объявить("oshub.jobs.proxy_gc_interval_sec", "целое", 3600, _Правила.Минимум(1), "bootstrap",
		_ИнтервалGCПрокси);

КонецПроцедуры
