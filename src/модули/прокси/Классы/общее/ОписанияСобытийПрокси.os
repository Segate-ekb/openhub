// События прокси словами: версия, подтянутая с апстрима, и имя, захваченное локально при живом имени на апстриме.

Перем События;  // ОбъявленияСобытий (события)

#Область ПубличныйИнтерфейс

// Объявления событий прокси в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияСобытий - события прокси словами.
//
Функция Объявления() Экспорт
	Возврат События;
КонецФункции

#КонецОбласти

&Прозвище("ОписанияСобытий")
&Порядок(40)
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ИздательСобытий") _Издатель) Экспорт

	События = Новый ОбъявленияСобытий();

	События.ОбъявитьВнутреннее(_Издатель.ТипКоллизияИмениАпстрима(), "Коллизия имени с апстримом",
		"Публикуемое имя уже присутствует на апстриме пула — имя захвачено локально.",
		"Диагностика публикации: нагрузка события описывает случай для журнала аудита и не"
		+ " несёт скоупа доставки. Читается в аудите хаба.");

	События.ОбъявитьВнутреннее(_Издатель.ТипВерсияПодтянута(), "Версия подтянута с апстрима",
		"Кэширующий пул скачал с апстрима версию, которой у него не было, и завёл её в реестре.",
		"Версию подтягивает запрос скачивания, в том числе анонимный: действия принципала над"
		+ " хабом нет, происхождение «апстрим» записано у самой версии. Событие нужно тем, кто"
		+ " держит готовые страницы; отдача уже лежащей версии его не даёт.");

КонецПроцедуры
