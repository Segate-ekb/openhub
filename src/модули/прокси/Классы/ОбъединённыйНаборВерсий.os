// Объединённый набор версий имени: то, что есть в индексе пула, и то, что называют его
// источники. Побеждает самая ПОЗДНЯЯ версия, а не та, что оказалась ближе: своя не
// выигрывает по факту наличия, и порядок источников решает только спор равных.
// Равные версии остаются за пулом — на своей координате своя версия непобедима, и это
// весь объём защиты имени: кто подключён источником, решает администратор пула.
// Лежащий источник поиска не отменяет: набор собирается из того, что известно, и говорит
// вызывающему, все ли источники удалось спросить.

Перем РезолверСпецификации; // РезолверСпецификации (реестр) — та же лесенка, что и у реестра
Перем Сравнитель;           // СравнительВерсий (реестр)
Перем Индекс;               // ИндексВерсийИсточника (прокси)
Перем Обезличивание;        // ОбезличиваниеЖурнала (наблюдаемость)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Выбирает версию имени по спецификации среди своих версий и версий источников пула.
//
// Параметры:
//  Пул - Пул - пул, в котором ищут.
//  Источники - Массив из АпстримПула - источники пула в порядке опроса; пустой список
//              означает «спрашивать некого» и не даёт ни одного исходящего запроса.
//  Пакет - Пакет, Неопределено - пакет пула; Неопределено — имени в индексе ещё нет.
//  ИмяПакета - Строка - имя пакета, как его спросил клиент.
//  Спецификация - Строка - точная версия, имя тега либо выражение версии; пустая строка
//                 означает «версия основного тега пакета».
//  СвояВерсия - ВерсияПакета, Неопределено - версия, которую по той же спецификации выбрал
//               индекс пула.
//
// Возвращаемое значение:
//  Структура - Найдена (Булево), СтрокаВерсии (Строка),
//              Апстрим (АпстримПула, Неопределено — победила версия индекса пула),
//              ВсеИсточникиОпрошены (Булево; Ложь означает, что часть источников сейчас
//              не слышно, и «новее нет» проверенным фактом не является).
//
Функция ВыбратьПоСпецификации(Знач Пул, Знач Источники, Знач Пакет, Знач ИмяПакета,
	Знач Спецификация, Знач СвояВерсия) Экспорт

	Возврат Выбрать(Пул, Источники, Пакет, ИмяПакета, Спецификация, Ложь, СвояВерсия);

КонецФункции

// Выбирает версию имени по имени тега — так читается канальный сегмент пути выдачи.
//
// Параметры:
//  Пул - Пул - пул, в котором ищут.
//  Источники - Массив из АпстримПула - источники пула в порядке опроса.
//  Пакет - Пакет, Неопределено - пакет пула.
//  ИмяПакета - Строка - имя пакета, как его спросил клиент.
//  ИмяТега - Строка - имя тега; пустая строка означает «основной тег пакета».
//  СвояВерсия - ВерсияПакета, Неопределено - версия, которую по тому же тегу выбрал
//               индекс пула.
//
// Возвращаемое значение:
//  Структура - та же, что у ВыбратьПоСпецификации.
//
Функция ВыбратьТегом(Знач Пул, Знач Источники, Знач Пакет, Знач ИмяПакета, Знач ИмяТега,
	Знач СвояВерсия) Экспорт

	Возврат Выбрать(Пул, Источники, Пакет, ИмяПакета, ИмяТега, Истина, СвояВерсия);

КонецФункции

#КонецОбласти

#Область СборНабора

Функция Выбрать(Знач Пул, Знач Источники, Знач Пакет, Знач ИмяПакета, Знач Условие,
	Знач ЭтоИмяТега, Знач СвояВерсия)

	Если Источники.Количество() = 0 Тогда
		Возврат Своя(СвояВерсия);
	КонецЕсли;

	Предложения = ПредложенияИсточников(Пул, Источники, ИмяПакета);

	Лучшая = ?(ЭтоИмяТега,
		РезолверСпецификации.РазрешитьТегомСредиСтрок(Пакет, Условие, Предложения.Строки),
		РезолверСпецификации.РазрешитьСредиСтрок(Пакет, Условие, Предложения.Строки));

	Если НЕ Лучшая.Найдена ИЛИ НЕ Позднее(Лучшая.СтрокаВерсии, СвояВерсия) Тогда
		Лог.Отладка("Объединённый набор: ""%1"" — источники версии новее не назвали"
			+ " (их версий в наборе %2, все источники опрошены: %3)",
			ИмяПакета, Предложения.Строки.Количество(), Предложения.ВсеОпрошены);
		Возврат Своя(СвояВерсия, Предложения.ВсеОпрошены);
	КонецЕсли;

	Апстрим = Предложения.Владельцы.Получить(Ключ(Лучшая.СтрокаВерсии));
	Лог.Отладка("Объединённый набор: ""%1"" — источник %2 называет %3, и она позднее нашей (%4)",
		ИмяПакета, Обезличивание.Адрес(Апстрим.Url), Лучшая.СтрокаВерсии, СтрокаСвоей(СвояВерсия));

	Возврат Новый Структура("Найдена, СтрокаВерсии, Апстрим, ВсеИсточникиОпрошены",
		Истина, Лучшая.СтрокаВерсии, Апстрим, Предложения.ВсеОпрошены);

КонецФункции

// Версии всех источников подряд с дедупликацией: спор равных решает позиция источника
// в списке пула, поэтому первое вхождение строки версии закрепляет её за своим источником.
Функция ПредложенияИсточников(Знач Пул, Знач Источники, Знач ИмяПакета)

	Строки = Новый Массив();
	Владельцы = Новый Соответствие();
	ВсеОпрошены = Истина;

	Для Каждого Источник Из Источники Цикл
		Ответ = Индекс.Версии(Пул, Источник, ИмяПакета);
		ВсеОпрошены = ВсеОпрошены И Ответ.Спрошен;
		Если НЕ Ответ.Спрошен Тогда
			Лог.Отладка("Объединённый набор: источник %1 сейчас не слышно — берём известное о ""%2""",
				Обезличивание.Адрес(Источник.Url), ИмяПакета);
		КонецЕсли;
		Для Каждого СтрокаВерсии Из Ответ.Версии Цикл
			Если Владельцы.Получить(Ключ(СтрокаВерсии)) = Неопределено Тогда
				Владельцы.Вставить(Ключ(СтрокаВерсии), Источник);
				Строки.Добавить(СтрокаВерсии);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Новый Структура("Строки, Владельцы, ВсеОпрошены", Строки, Владельцы, ВсеОпрошены);

КонецФункции

// Строго позднее: равная версия остаётся за индексом пула — она уже здесь, и качать
// её заново неоткуда и незачем. Версия вне порядка версий чужой не проигрывает и не
// выигрывает: сравнить их нечем, и решение остаётся за своей.
Функция Позднее(Знач Чужая, Знач СвояВерсия)

	Если СвояВерсия = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Первая = Сравнитель.ПопытатьсяРазобрать(Чужая);
	Вторая = Сравнитель.ПопытатьсяРазобрать(СвояВерсия.Версия);
	Если Первая = Неопределено ИЛИ Вторая = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Первая.Сравнить(Вторая) > 0;

КонецФункции

Функция Своя(Знач СвояВерсия, Знач ВсеОпрошены = Истина)

	Возврат Новый Структура("Найдена, СтрокаВерсии, Апстрим, ВсеИсточникиОпрошены",
		СвояВерсия <> Неопределено, СтрокаСвоей(СвояВерсия), Неопределено, ВсеОпрошены);

КонецФункции

Функция СтрокаСвоей(Знач СвояВерсия)
	Возврат ?(СвояВерсия = Неопределено, "", Строка(СвояВерсия.Версия));
КонецФункции

Функция Ключ(Знач СтрокаВерсии)
	Возврат НРег(СокрЛП(Строка(СтрокаВерсии)));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РезолверСпецификации") _РезолверСпецификации,
	&Пластилин(Значение = "СравнительВерсий") _Сравнитель,
	&Пластилин(Значение = "ИндексВерсийИсточника") _Индекс,
	&Лог _Лог = Неопределено)

	РезолверСпецификации = _РезолверСпецификации;
	Сравнитель = _Сравнитель;
	Индекс = _Индекс;
	Обезличивание = Новый ОбезличиваниеЖурнала();

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
