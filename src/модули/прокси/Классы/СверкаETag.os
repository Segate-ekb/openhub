// Сверка скачанных байтов с ETag апстрима: сверять есть чем, только если ETag — sha256.

// Проверяет, что sha256 данных совпадает с ETag апстрима. Произвольный либо слабый ETag
// сверить нечем — такая загрузка принимается (усечённый zip отсекает разбор манифеста).
//
// Параметры:
//  Данные - ДвоичныеДанные - скачанные байты.
//  ETag - Строка - значение заголовка ETag, как его прислал апстрим.
//
// Возвращаемое значение:
//  Булево - Истина, если сумма совпала либо сверять нечем.
//
Функция Совпадает(Знач Данные, Знач ETag) Экспорт

	Эталон = Нормализовать(ETag);
	Если НЕ ЭтоSha256Hex(Эталон) Тогда
		Возврат Истина;
	КонецЕсли;

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма)) = Эталон;

КонецФункции

Функция Нормализовать(Знач ETag)
	Значение = СокрЛП(Строка(ETag));
	Если СтрНачинаетсяС(ВРег(Значение), "W/") Тогда
		Значение = СокрЛП(Сред(Значение, 3));
	КонецЕсли;
	Если СтрНачинаетсяС(Значение, """") И СтрЗаканчиваетсяНа(Значение, """") И СтрДлина(Значение) >= 2 Тогда
		Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
	КонецЕсли;
	Возврат НРег(Значение);
КонецФункции

Функция ЭтоSha256Hex(Знач Значение)
	Если СтрДлина(Значение) <> 64 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По 64 Цикл
		Если СтрНайти("0123456789abcdef", Сред(Значение, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
