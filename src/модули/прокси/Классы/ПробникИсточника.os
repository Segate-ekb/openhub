// Пробное подключение к источнику: хаб сам ходит по адресу за list.txt и называет исход
// словами. Выключатель oshub.upstream.probe.enabled снимает пробу целиком.

Перем Клиент;      // КлиентАпстрима (прокси)
Перем Настройки;   // СервисНастроек (настройки) — выключатель пробы и таймаут похода наружу
Перем Секрет;      // СекретИсточника (прокси) — задан ли токен у пробуемого источника
&Лог
Перем Лог;
Перем Таймауты;   // ТаймаутыHTTP (сеть)

#Область ПубличныйИнтерфейс

// Пробует подключиться к источнику по контракту opm.
//
// Параметры:
//  БазовыйURL - Строка - базовый URL выдачи источника.
//  Токен - Строка - токен доступа к приватной выдаче источника; пустой пробует
//          анонимно (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Ок (Булево), Причина (Строка, что именно не получилось; пусто при Ок),
//              Код (Число, HTTP-код ответа; 0 — источник не ответил),
//              Отказано (Булево, источник ответил, но доступа не дал).
//
Функция Проверить(Знач БазовыйURL, Знач Токен = "") Экспорт

	Если НЕ ПробаВключена() Тогда
		Лог.Отладка("Проба источника %1 пропущена: oshub.upstream.probe.enabled выключен", БазовыйURL);
		Возврат Удача(0);
	КонецЕсли;

	Ответ = Клиент.ПолучитьТекст(БазовыйURL, "list.txt", "", Токен);

	Если Ответ.Код = 0 Тогда
		Возврат Неудача(0, ПричинаНедоступности(Ответ.Пояснение));
	КонецЕсли;

	Если Секрет.ЭтоОтказДоступа(Ответ.Код) Тогда
		Возврат Отказ(Ответ.Код, ПричинаОтказаДоступа(Ответ.Код, Токен));
	КонецЕсли;

	Если Ответ.Код <> 200 Тогда
		Возврат Неудача(Ответ.Код, СтрШаблон(
			"ответ не по контракту opm: за списком пакетов (list.txt) источник ответил %1",
			Формат(Цел(Ответ.Код), "ЧГ=0; ЧН=0")));
	КонецЕсли;

	Если НЕ ЭтоСписокПакетов(Ответ.Тело) Тогда
		Возврат Неудача(200, "ответ не по контракту opm: по адресу лежит страница, а не список"
			+ " пакетов. Базовый URL источника — это адрес каталога выдачи"
			+ " (например https://hub.oscript.io/download/), а не главной страницы хаба");
	КонецЕсли;

	Возврат Удача(200);

КонецФункции

// Проба, обязанная удаться: неудача — исключение с названной причиной. Одно правило
// на все двери заведения источника — и апстрим пула, и зеркало.
//
// Параметры:
//  БазовыйURL - Строка - базовый URL выдачи источника.
//  Токен - Строка - токен доступа к приватной выдаче источника; пустой пробует
//          анонимно (необязательный, по умолчанию "").
//
Процедура ТребоватьПодключение(Знач БазовыйURL, Знач Токен = "") Экспорт

	Проба = Проверить(БазовыйURL, Токен);
	Если НЕ Проба.Ок Тогда
		ВызватьИсключение СтрШаблон("К апстриму ""%1"" не удалось подключиться: %2",
			БазовыйURL, Проба.Причина);
	КонецЕсли;

КонецПроцедуры

// Включена ли проба подключения прямо сейчас.
//
// Возвращаемое значение:
//  Булево - Истина, если источник проверяется подключением.
//
Функция ПробаВключена() Экспорт
	Возврат Настройки.Флаг("oshub.upstream.probe.enabled", Ложь);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Объяснение зависит от того, был ли токен предъявлен: нужен он вовсе либо не подошёл.
Функция ПричинаОтказаДоступа(Знач Код, Знач Токен)

	Хвост = ?(Секрет.Задан(Токен),
		". Токен источника задан — проверьте, что он действует и открывает этот пул",
		". Это приватная выдача — задайте токен доступа к источнику");

	Возврат СтрШаблон("источник не пустил: за списком пакетов (list.txt) он ответил %1%2",
		Формат(Цел(Код), "ЧГ=0; ЧН=0"), Хвост);

КонецФункции

// Неузнанный текст транспорта отдаётся как есть — молчать о нём хуже, чем угадывать.
Функция ПричинаНедоступности(Знач Пояснение)

	Текст = НРег(СокрЛП(Строка(Пояснение)));

	Если Найти(Текст, "цепочка перенаправлений") > 0 Тогда
		Возврат СокрЛП(Строка(Пояснение));
	КонецЕсли;

	Если СодержитОдно(Текст, "timed out,timeout,time out,таймаут,время ожидания") Тогда
		Возврат СтрШаблон("таймаут: источник не ответил за %1 с",
			Формат(ТаймаутСек(), "ЧГ=0; ЧН=0"));
	КонецЕсли;

	Если СодержитОдно(Текст, "no such host,not known,getaddrinfo,name resolution,resolve,dns,неизвестный узел") Тогда
		Возврат "имя не разрешилось: у адреса нет ответа DNS";
	КонецЕсли;

	Если СодержитОдно(Текст, "refused,отказано,unreachable,недоступен,reset,connection closed,ssl,certificate,сертификат") Тогда
		Возврат СтрШаблон("соединение отбито: %1", СокрЛП(Строка(Пояснение)));
	КонецЕсли;

	Возврат СтрШаблон("источник не ответил: %1", СокрЛП(Строка(Пояснение)));

КонецФункции

Функция СодержитОдно(Знач Текст, Знач Образцы)

	Для Каждого Образец Из СтрРазделить(Образцы, ",", Ложь) Цикл
		Если Найти(Текст, Образец) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// list.txt по контракту opm — имена по строке на имя; пустой список законен, разметка — нет.
Функция ЭтоСписокПакетов(Знач Тело)

	Для Каждого СтрокаТела Из СтрРазделить(Строка(Тело), Символы.ПС, Ложь) Цикл
		Значение = СокрЛП(СтрЗаменить(СтрокаТела, Символы.ВК, ""));
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Возврат Найти(Значение, "<") = 0;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ТаймаутСек()
	Возврат Таймауты.ТаймаутАпстрима(Настройки);
КонецФункции

Функция Удача(Знач Код)
	Возврат Новый Структура("Ок, Причина, Код, Отказано", Истина, "", Код, Ложь);
КонецФункции

Функция Неудача(Знач Код, Знач Причина)
	Возврат Новый Структура("Ок, Причина, Код, Отказано", Ложь, Причина, Код, Ложь);
КонецФункции

Функция Отказ(Знач Код, Знач Причина)
	Возврат Новый Структура("Ок, Причина, Код, Отказано", Ложь, Причина, Код, Истина);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КлиентАпстрима") _Клиент,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "СекретИсточника") _Секрет = Неопределено,
	&Пластилин(Значение = "ТаймаутыHTTP") _Таймауты = Неопределено)

	Таймауты = ?(_Таймауты = Неопределено, Новый ТаймаутыHTTP(), _Таймауты);

	Клиент = _Клиент;
	Настройки = _Настройки;
	Секрет = ?(_Секрет = Неопределено, Новый СекретИсточника(), _Секрет);

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
