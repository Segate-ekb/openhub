// Регулярная проверка живости источников: обходит включённые апстримы пулов и зеркала,
// пробует подключиться к каждому и складывает исход в память СтражаАпстримов.

Перем Источники;     // СервисАпстримовПула (реестр) — источники пула в порядке обхода
Перем СервисПулов;   // СервисПулов (реестр)
Перем СервисЗеркал;  // СервисЗеркал (зеркала), опционален
Перем Пробник;       // ПробникИсточника (прокси)
Перем Страж;         // СтражАпстримов (прокси)
Перем Секрет;        // СекретИсточника (прокси) — токен записи источника
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Проверяет каждый включённый источник один раз и запоминает исход.
//
// Возвращаемое значение:
//  Структура - Проверено (Число источников), Живых (Число), Лежащих (Число),
//              НеПустивших (Число источников, ответивших отказом в доступе).
//
Функция Обойти() Экспорт

	Итог = Новый Структура("Проверено, Живых, Лежащих, НеПустивших", 0, 0, 0, 0);

	Если НЕ Пробник.ПробаВключена() Тогда
		Лог.Отладка("Здоровье источников: проба выключена, обход пропущен");
		Возврат Итог;
	КонецЕсли;

	Пройденные = Новый Соответствие();
	Для Каждого Источник Из Источники() Цикл
		// один источник — одна проба за обход; приватный и анонимный доступ к одному
		// адресу это два разных источника, и каждый пробуется своим доступом
		Ключ = НРег(СокрЛП(Источник.Адрес)) + "|" + Секрет.Отпечаток(Источник.Токен);
		Если Пройденные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Пройденные.Вставить(Ключ, Истина);
		ПроверитьОдин(Источник, Итог);
	КонецЦикла;

	Лог.Отладка("Здоровье источников: проверено %1, живых %2, лежащих %3, не пустивших %4",
		Формат(Итог.Проверено, "ЧГ=0; ЧН=0"), Формат(Итог.Живых, "ЧГ=0; ЧН=0"),
		Формат(Итог.Лежащих, "ЧГ=0; ЧН=0"), Формат(Итог.НеПустивших, "ЧГ=0; ЧН=0"));
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОдин(Знач Источник, Итог)

	Адрес = Источник.Адрес;
	Итог.Проверено = Итог.Проверено + 1;
	Проба = Пробник.Проверить(Адрес, Источник.Токен);

	Если Проба.Успех Тогда
		// поднявшийся источник возвращается в работу сам, вмешательство человека не нужно
		Если НЕ Страж.Состояние(Адрес).Живой Тогда
			Лог.Информация("Источник ""%1"" снова отвечает и возвращается в опрос", Адрес);
		КонецЕсли;
		Страж.ОтметитьЖивым(Адрес, Источник.Токен);
		Итог.Живых = Итог.Живых + 1;
		Возврат;
	КонецЕсли;

	// «не пустил» — это не «лежит»: источник ответил, и запирать его нельзя
	Если Проба.Отказано Тогда
		Лог.Предупреждение("Источник ""%1"" не пустил хаб: %2", Адрес, Проба.Сообщение);
		Страж.ОтметитьНеПустившим(Адрес, Проба.Сообщение, Источник.Токен);
		Итог.НеПустивших = Итог.НеПустивших + 1;
		Возврат;
	КонецЕсли;

	Страж.ОтметитьЛежащим(Адрес, Проба.Сообщение, Источник.Токен);
	Итог.Лежащих = Итог.Лежащих + 1;

КонецПроцедуры

// Выключенный источник не проверяется — тумблер и живость это две независимые вещи.
Функция Источники()

	Результат = Новый Массив();

	Для Каждого Пул Из СервисПулов.ПулыСАпстримами() Цикл
		Для Каждого Апстрим Из Источники.ДляОпроса(Пул) Цикл
			Результат.Добавить(Источник(Апстрим.Url, Апстрим));
		КонецЦикла;
	КонецЦикла;

	Если СервисЗеркал <> Неопределено Тогда
		Для Каждого Зеркало Из СервисЗеркал.ВключённыеЗеркала() Цикл
			Результат.Добавить(Источник(Зеркало.АпстримURL, Зеркало));
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция Источник(Знач Адрес, Знач Запись)
	Возврат Новый Структура("Адрес, Токен", Строка(Адрес), Секрет.ИзИсточника(Запись));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисАпстримовПула") _Источники,
	&Пластилин(Значение = "ПробникИсточника") _Пробник,
	&Пластилин(Значение = "СтражАпстримов") _Страж,
	&Пластилин(Значение = "СервисЗеркал", Тип = "Массив") _СервисЗеркал,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "СекретИсточника") _Секрет = Неопределено)

	СервисПулов = _СервисПулов;
	Источники = _Источники;
	Пробник = _Пробник;
	Страж = _Страж;
	Секрет = ?(_Секрет = Неопределено, Новый СекретИсточника(), _Секрет);
	СервисЗеркал = ?(_СервисЗеркал = Неопределено ИЛИ _СервисЗеркал.Количество() = 0,
		Неопределено, _СервисЗеркал[0]);

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
