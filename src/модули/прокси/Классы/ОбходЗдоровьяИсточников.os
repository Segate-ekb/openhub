// Регулярная проверка живости источников: обходит включённые апстримы пулов и включённые
// зеркала, пробует подключиться к каждому адресу один раз и складывает исход в память
// СтражаАпстримов. Проверку не заказывает ни запрос пользователя, ни цикл зеркала —
// её ведёт хаб сам, с периодом oshub.jobs.upstream_health_interval_sec.

Перем СервисПулов;   // СервисПулов (реестр)
Перем СервисЗеркал;  // СервисЗеркал (зеркала), опционален
Перем Пробник;       // ПробникИсточника (прокси)
Перем Страж;         // СтражАпстримов (прокси)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Проверяет каждый включённый источник один раз и запоминает исход.
//
// Возвращаемое значение:
//  Структура - Проверено (Число адресов), Живых (Число), Лежащих (Число).
//
Функция Обойти() Экспорт

	Итог = Новый Структура("Проверено, Живых, Лежащих", 0, 0, 0);

	Если НЕ Пробник.ПробаВключена() Тогда
		Лог.Отладка("Здоровье источников: проба выключена, обход пропущен");
		Возврат Итог;
	КонецЕсли;

	Пройденные = Новый Соответствие();
	Для Каждого Адрес Из Адреса() Цикл
		Ключ = НРег(СокрЛП(Адрес));
		Если Пройденные.Получить(Ключ) <> Неопределено Тогда
			Продолжить; // один адрес — одна проба за обход, кем бы он ни был заведён
		КонецЕсли;
		Пройденные.Вставить(Ключ, Истина);
		ПроверитьОдин(Адрес, Итог);
	КонецЦикла;

	Лог.Отладка("Здоровье источников: проверено %1, живых %2, лежащих %3",
		Формат(Итог.Проверено, "ЧГ=0; ЧН=0"), Формат(Итог.Живых, "ЧГ=0; ЧН=0"),
		Формат(Итог.Лежащих, "ЧГ=0; ЧН=0"));
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОдин(Знач Адрес, Итог)

	Итог.Проверено = Итог.Проверено + 1;
	Проба = Пробник.Проверить(Адрес);

	Если Проба.Ок Тогда
		// поднявшийся источник возвращается в работу сам, вмешательство человека не нужно
		Если НЕ Страж.Состояние(Адрес).Живой Тогда
			Лог.Информация("Источник ""%1"" снова отвечает и возвращается в опрос", Адрес);
		КонецЕсли;
		Страж.ОтметитьЖивым(Адрес);
		Итог.Живых = Итог.Живых + 1;
		Возврат;
	КонецЕсли;

	Страж.ОтметитьЛежащим(Адрес, Проба.Причина);
	Итог.Лежащих = Итог.Лежащих + 1;

КонецПроцедуры

// Адреса включённых источников: апстримы пулов и зеркала. Выключенный источник
// не проверяется — тумблер и живость это две независимые вещи.
Функция Адреса()

	Результат = Новый Массив();

	Для Каждого Пул Из СервисПулов.ПулыСАпстримами() Цикл
		Для Каждого Апстрим Из СервисПулов.АпстримыДляОпроса(Пул) Цикл
			Результат.Добавить(Строка(Апстрим.Url));
		КонецЦикла;
	КонецЦикла;

	Если СервисЗеркал <> Неопределено Тогда
		Для Каждого Зеркало Из СервисЗеркал.ВключённыеЗеркала() Цикл
			Результат.Добавить(Строка(Зеркало.АпстримURL));
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ПробникИсточника") _Пробник,
	&Пластилин(Значение = "СтражАпстримов") _Страж,
	&Пластилин(Значение = "СервисЗеркал", Тип = "Массив") _СервисЗеркал,
	&Лог _Лог = Неопределено)

	СервисПулов = _СервисПулов;
	Пробник = _Пробник;
	Страж = _Страж;
	СервисЗеркал = ?(_СервисЗеркал = Неопределено ИЛИ _СервисЗеркал.Количество() = 0,
		Неопределено, _СервисЗеркал[0]);

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
