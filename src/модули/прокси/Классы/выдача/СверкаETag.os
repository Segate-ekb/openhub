// Сверка скачанных байтов с ETag апстрима: сверять есть чем, только если ETag — sha256.

Перем Заголовки;   // ЗаголовкиКэша (основа) — единственное правило разбора ETag
Перем Хеши;        // Хеш (основа)

// Проверяет, что sha256 скачанного совпадает с ETag апстрима. Произвольный либо слабый ETag
// сверить нечем — такая загрузка принимается (усечённый zip отсекает разбор манифеста).
//
// Параметры:
//  Скачанное - ДвоичныеДанные, Строка - скачанные байты либо путь к файлу с ними; файл
//              хешируется потоком.
//  ETag - Строка - значение заголовка ETag, как его прислал апстрим.
//
// Возвращаемое значение:
//  Булево - Истина, если сумма совпала либо сверять нечем.
//
Функция Совпадает(Знач Скачанное, Знач ETag) Экспорт

	// Hex сравнивается без учёта регистра — это про запись суммы, а не про разбор метки.
	Эталон = НРег(Заголовки.ТелоМетки(ETag));
	Если НЕ ЭтоSha256Hex(Эталон) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ТипЗнч(Скачанное) = Тип("Строка") Тогда
		Возврат Хеши.ОтФайла(Скачанное) = Эталон;
	КонецЕсли;
	Возврат Хеши.ОтДанных(Скачанное) = Эталон;

КонецФункции

Функция ЭтоSha256Hex(Знач Значение)
	Если СтрДлина(Значение) <> 64 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По 64 Цикл
		Если СтрНайти("0123456789abcdef", Сред(Значение, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗаголовкиКэша") _Заголовки,
	&Пластилин(Значение = "Хеш") _Хеши = Неопределено) Экспорт

	Заголовки = _Заголовки;
	Хеши = ?(_Хеши = Неопределено, Новый Хеш(), _Хеши);

КонецПроцедуры
