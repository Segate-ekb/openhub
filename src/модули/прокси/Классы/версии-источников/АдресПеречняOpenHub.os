// Где у источника-OpenHub лежит JSON-перечень версий имени: адрес выдачи называет пул либо
// ведёт в основной пул хаба, а перечень живёт в API этого пула.

#Использовать url

Перем Адреса; // РазборАдреса (основа)

#Область ПубличныйИнтерфейс

// Раскладывает адрес выдачи OpenHub на корень хаба и пул. Понимает формы
// "<хаб>/download", "<хаб>/pools/<пул>/download", "<хаб>/api/v1/pools/<пул>/download";
// хаб может жить на подпути. У адреса канала "…/channels/<канал>/download" перечня пула
// не спрашивают: последнюю версию там выбирает канал источника.
//
// Параметры:
//  АпстримURL - Строка - базовый URL выдачи источника.
//
// Возвращаемое значение:
//  Структура, Неопределено - Префикс (Строка, корень хаба без хвостового слеша),
//              Пул (Строка, имя пула как в адресе; пустая — адрес ведёт в основной пул);
//              Неопределено, если адрес не оканчивается сегментом выдачи либо ведёт в канал.
//
Функция Разобрать(Знач АпстримURL) Экспорт

	Адрес = Адреса.БезХвостовыхСлешей(СокрЛП(Строка(АпстримURL)));
	Голова = Адреса.ДоПути(Адрес);
	Сегменты = СтрРазделить(Сред(Адрес, СтрДлина(Голова) + 1), "/", Ложь);

	Если НЕ СнятьХвост(Сегменты, "download") ИЛИ ЗаканчиваетсяПарой(Сегменты, "channels") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пул = "";
	Если ЗаканчиваетсяПарой(Сегменты, "pools") Тогда
		Пул = Сегменты[Сегменты.ВГраница()];
		СнятьПару(Сегменты, "pools");
		Если ЗаканчиваетсяПарой(Сегменты, "api") И НРег(Сегменты[Сегменты.ВГраница()]) = "v1" Тогда
			СнятьПару(Сегменты, "api");
		КонецЕсли;
	КонецЕсли;

	Префикс = Голова + ?(Сегменты.Количество() = 0, "", "/" + СтрСоединить(Сегменты, "/"));
	Возврат Новый Структура("Префикс, Пул", Префикс, Пул);

КонецФункции

// База API пула источника — рядом с ней лежит перечень версий.
//
// Параметры:
//  Префикс - Строка - корень хаба из Разобрать.
//  Пул - Строка - имя пула.
//
// Возвращаемое значение:
//  Строка - "<корень>/api/v1/pools/<пул>".
//
Функция БазаПула(Знач Префикс, Знач Пул) Экспорт
	Возврат СтрШаблон("%1/api/v1/pools/%2", Префикс, Пул);
КонецФункции

// Путь перечня версий имени относительно базы API пула.
//
// Параметры:
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Строка - "packages/<имя>/versions".
//
Функция ПутьПеречня(Знач ИмяПакета) Экспорт
	Возврат СтрШаблон("packages/%1/versions", Сегмент(ИмяПакета));
КонецФункции

// Путь самого короткого среза изменений основного пула относительно корня хаба: срез
// называет свой пул, и короткий адрес выдачи узнаёт по нему имя основного пула.
//
// Возвращаемое значение:
//  Строка - "changes?limit=1".
//
Функция ПутьСрезаОсновногоПула() Экспорт
	Возврат "changes?limit=1";
КонецФункции

// Имя пула из ответа среза изменений.
//
// Параметры:
//  Тело - Строка - тело ответа.
//
// Возвращаемое значение:
//  Строка - имя пула, закодированное сегментом пути; пустая строка, если тело не срез
//           изменений OpenHub либо пула не называет.
//
Функция ПулСреза(Знач Тело) Экспорт

	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(Строка(Тело));
		Разобрано = ПрочитатьJSON(Чтение, Истина); // в соответствия: ключи чужого ответа произвольны
	Исключение
		Возврат "";
	КонецПопытки;

	Если ТипЗнч(Разобрано) <> Тип("Соответствие")
		ИЛИ ТипЗнч(Разобрано.Получить("changes")) <> Тип("Массив")
		ИЛИ ТипЗнч(Разобрано.Получить("pool")) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Пул = СокрЛП(Разобрано.Получить("pool"));
	Возврат ?(ПустаяСтрока(Пул), "", Сегмент(Пул));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СнятьХвост(Сегменты, Знач Слово)

	Если Сегменты.Количество() = 0 ИЛИ НРег(Сегменты[Сегменты.ВГраница()]) <> Слово Тогда
		Возврат Ложь;
	КонецЕсли;
	Сегменты.Удалить(Сегменты.ВГраница());
	Возврат Истина;

КонецФункции

// Пара «слово/значение» в хвосте пути: "pools/<пул>", "channels/<канал>".
Функция ЗаканчиваетсяПарой(Знач Сегменты, Знач Слово)
	Возврат Сегменты.Количество() >= 2 И НРег(Сегменты[Сегменты.ВГраница() - 1]) = Слово;
КонецФункции

Процедура СнятьПару(Сегменты, Знач Слово)

	Если НЕ ЗаканчиваетсяПарой(Сегменты, Слово) Тогда
		Возврат;
	КонецЕсли;
	Сегменты.Удалить(Сегменты.ВГраница());
	Сегменты.Удалить(Сегменты.ВГраница());

КонецПроцедуры

// Имя едет сегментом пути, а не куском строки: слеш и процент в чужом имени увели бы запрос.
Функция Сегмент(Знач Значение)
	Возврат КодированиеURL.КодироватьСегментПути(Строка(Значение));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "РазборАдреса") _Адреса)
	Адреса = _Адреса;
КонецПроцедуры
