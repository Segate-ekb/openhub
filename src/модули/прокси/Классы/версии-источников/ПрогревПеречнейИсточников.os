// Прогрев перечней источников: у своих имён с привезёнными версиями перечень источника читается
// заранее, и страница пакета после старта хаба сразу говорит о версии, которую отдаст установка.

Перем СервисПулов;   // СервисПулов (реестр)
Перем СервисПакетов; // СервисПакетов (реестр)
Перем Провенанс;     // СервисПроисхождения (реестр)
Перем Перечень;      // ПереченьИсточников (контракт реестра, реализация здесь же)
Перем Ошибки;        // ТекстОшибки (основа)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Обходит пулы с источниками и дочитывает перечни для своих имён. Сбой на имени обход не роняет.
//
// Возвращаемое значение:
//  Число - сколько своих имён в пулах с источниками обошёл прогрев.
//
Функция Прогреть() Экспорт

	Обойдено = 0;
	Для Каждого Пул Из СервисПулов.ПулыСАпстримами() Цикл
		Пакеты = СервисПакетов.ПакетыПулаДляЧтения(Пул.Идентификатор);
		Свои = Провенанс.СвоиИменаСреди(Идентификаторы(Пакеты));
		Для Каждого Пакет Из Пакеты Цикл
			Если Свои.Получить(Пакет.Идентификатор) = Истина Тогда
				Дочитать(Пакет);
				Обойдено = Обойдено + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Лог.Отладка("Прогрев перечней источников: своих имён в пулах с источниками %1", Обойдено);
	Возврат Обойдено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Дочитать(Знач Пакет)
	Попытка
		Перечень.Дочитать(Пакет);
	Исключение
		Лог.Ошибка("Прогрев перечней источников: имя ""%1"" не дочитано: %2",
			Пакет.Имя, Ошибки.Причина(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

Функция Идентификаторы(Знач Пакеты)
	Результат = Новый Массив();
	Для Каждого Пакет Из Пакеты Цикл
		Результат.Добавить(Пакет.Идентификатор);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисПроисхождения") _Провенанс,
	&Пластилин(Значение = "ПереченьИсточников") _Перечень,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Лог _Лог = Неопределено)

	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	Провенанс = _Провенанс;
	Перечень = _Перечень;
	Ошибки = _Ошибки;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
