// Версии имени, названные источниками пула: последние прочитанные перечни из памяти индекса,
// и дочитывание этих перечней для имён, чей выбор версии от них зависит.

// Табакерки: перечень зовёт РезолверСпецификации, а СервисПулов тянет за собой уборку пула со всеми
// её последствиями — собирать их вместе с резолвером незачем
Перем СервисПулов; // Табакерка: СервисПулов (реестр)
Перем Источники;   // Табакерка: СервисАпстримовПула (реестр)
Перем Индекс;      // Табакерка: ИндексВерсийИсточника (прокси)
Перем Провенанс;   // Табакерка: СервисПроисхождения (реестр)
Перем СервисВерсий; // Табакерка: СервисВерсий (реестр)

#Область ПубличныйИнтерфейс

// Версии имени, которые включённые источники пула назвали своими перечнями. Наружу не ходит:
// перечни читают выдача и прогрев, здесь — только то, что они уже узнали.
//
// Параметры:
//  Пакет - Пакет - пакет пула.
//
// Возвращаемое значение:
//  Соответствие - ключ — строка версии в нижнем регистре, значение Истина.
//
Функция НазванныеВерсии(Знач Пакет) Экспорт

	Названные = Новый Соответствие();
	Пул = СервисПулов.Достать().ПулПоИдентификатору(Пакет.ПулИдентификатор);
	Перечни = Индекс.Достать();
	Для Каждого Апстрим Из Источники.Достать().ДляОпроса(Пул) Цикл
		Для Каждого СтрокаВерсии Из Перечни.ИзвестныеВерсии(Пул, Апстрим, Пакет.Имя) Цикл
			Названные.Вставить(НРег(СокрЛП(СтрокаВерсии)), Истина);
		КонецЦикла;
	КонецЦикла;
	Возврат Названные;

КонецФункции

// Читает перечни источников пула для имени, если от них зависит выбор версии: имя своё,
// а в пуле есть и привезённые версии. Ходит наружу по правилам выдачи — срок источника,
// офлайн, память о его живости; отказ источника не бросает.
//
// Параметры:
//  Пакет - Пакет - пакет пула.
//
Процедура Дочитать(Знач Пакет) Экспорт

	Если НЕ ВыборЗависитОтИсточников(Пакет) Тогда
		Возврат;
	КонецЕсли;

	Пул = СервисПулов.Достать().ПулПоИдентификатору(Пакет.ПулИдентификатор);
	Перечни = Индекс.Достать();
	Для Каждого Апстрим Из Источники.Достать().ДляОпроса(Пул) Цикл
		Перечни.Версии(Пул, Апстрим, Пакет.Имя);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Имя своё, и рядом со своими лежат привезённые версии — только их перечень источника и меняет.
Функция ВыборЗависитОтИсточников(Знач Пакет)

	Снимок = Провенанс.Достать().ПровенансПакетаДляЧтения(Пакет.Идентификатор);
	Если НЕ Снимок.ЕстьСобственныеВерсии() Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Версия Из СервисВерсий.Достать().ВерсииПакетаДляЧтения(Пакет.Идентификатор) Цикл
		Если НЕ Снимок.ЭтоСвоя(Версия) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

&Желудь
&Прозвище("ПереченьИсточников")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Табакерка &Пластилин(Значение = "СервисАпстримовПула") _Источники,
	&Табакерка &Пластилин(Значение = "ИндексВерсийИсточника") _Индекс,
	&Табакерка &Пластилин(Значение = "СервисПроисхождения") _Провенанс,
	&Табакерка &Пластилин(Значение = "СервисВерсий") _Версии)

	СервисПулов = _СервисПулов;
	Источники = _Источники;
	Индекс = _Индекс;
	Провенанс = _Провенанс;
	СервисВерсий = _Версии;

КонецПроцедуры
