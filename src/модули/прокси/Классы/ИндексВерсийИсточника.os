// Какие версии имени знает ОДИН внешний источник: перечень версий пула OpenHub либо
// страница пакета по контракту opm. Перечень кэшируется по TTL источника.

#Использовать url

Перем Клиент;     // КлиентАпстрима (прокси)
Перем Страж;      // СтражАпстримов (прокси)
Перем Кэш;        // КэшИзменяемыхРесурсов (прокси)
Перем Секрет;     // СекретИсточника (прокси) — токен приватного источника
Перем Адреса;     // РазборАдреса (основа)
Перем Правила;    // ПравилаИменования (реестр)
Перем Allowlist;  // АллоулистИмён (реестр)
Перем Настройки;  // СервисНастроек (настройки) — режим offline
Перем Разбор;     // РазборВерсийПакета (прокси) — версии со страницы пакета
Перем Сравнитель; // СравнительВерсий (реестр) — что вообще является строкой версии
Перем Обезличивание; // ОбезличиваниеЖурнала (наблюдаемость)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Версии пакета, известные источнику.
//
// Параметры:
//  Пул - Пул - пул, которому принадлежит источник.
//  Апстрим - АпстримПула - опрашиваемый источник пула.
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Структура - Версии (Массив из Строка, строки версий как их пишет источник),
//              Спрошен (Булево; Ложь означает «источника сейчас не слышно», и ответ
//              собран из того, что известно).
//
Функция Версии(Знач Пул, Знач Апстрим, Знач ИмяПакета) Экспорт

	Если Апстрим = Неопределено Тогда
		Возврат НеСпрошен(Новый Массив());
	КонецЕсли;

	Если НЕ Правила.ИмяКорректно(ИмяПакета) Тогда
		Лог.Отладка("Индекс версий: имя ""%1"" не проходит правила именования — источник не спрашиваем",
			ИмяПакета);
		Возврат НеСпрошен(Новый Массив());
	КонецЕсли;

	Если НЕ Allowlist.Пропускает(Апстрим.СписокРазрешенийJSON, ИмяПакета, Строка(Апстрим.Url)) Тогда
		Лог.Отладка("Индекс версий: имя ""%1"" не пропущено allowlist источника %2 — не спрашиваем",
			ИмяПакета, Обезличивание.Адрес(Апстрим.Url));
		Возврат НеСпрошен(Новый Массив());
	КонецЕсли;

	Ключ = КлючПеречня(Пул, Апстрим, ИмяПакета);

	Если Кэш.Актуально(Ключ, Апстрим.ВремяЖизниСек) Тогда
		Запись = Кэш.Запись(Ключ).Значение;
		Лог.Отладка("Индекс версий: ""%1"" у источника %2 свеж по TTL (%3 с) — версий %4",
			ИмяПакета, Обезличивание.Адрес(Апстрим.Url), Апстрим.ВремяЖизниСек,
			Запись.Версии.Количество());
		Возврат Запись;
	КонецЕсли;

	Если ОффлайнРежим() Тогда
		Лог.Отладка("Индекс версий: включён oshub.proxy.offline — ""%1"" берём из кэша", ИмяПакета);
		Возврат НеСпрошен(ПоследнийПеречень(Ключ));
	КонецЕсли;

	Если НЕ Страж.Пропустить(Апстрим) Тогда
		Лог.Отладка("Индекс версий: источник %1 числится лежащим — ""%2"" берём из кэша",
			Обезличивание.Адрес(Апстрим.Url), ИмяПакета);
		Возврат НеСпрошен(ПоследнийПеречень(Ключ));
	КонецЕсли;

	Возврат Спросить(Ключ, Апстрим, ИмяПакета);

КонецФункции

#КонецОбласти

#Область ОпросИсточника

// Протоколы пробуются по порядку; молчание источника прерывает опрос — узел у них один.
Функция Спросить(Знач Ключ, Знач Апстрим, Знач ИмяПакета)

	Перечень = ИзПеречняВерсийOpenHub(Апстрим, ИмяПакета);
	Если Перечень.Ответил Тогда
		Возврат Запомнить(Ключ, Перечень.Версии, Истина);
	КонецЕсли;
	Если Перечень.Молчит Тогда
		Возврат НеСпрошен(ПоследнийПеречень(Ключ));
	КонецЕсли;

	Страница = СоСтраницыПакета(Апстрим, ИмяПакета);
	Если Страница.Ответил Тогда
		Возврат Запомнить(Ключ, Страница.Версии, Истина);
	КонецЕсли;
	Если Страница.Молчит Тогда
		Возврат НеСпрошен(ПоследнийПеречень(Ключ));
	КонецЕсли;

	// источник ответил обоими протоколами, и ни один перечня не дал: индекса у него нет.
	// Пустой ответ кэшируется, иначе каждый запрос latest стоил бы двух походов наружу
	Лог.Отладка("Индекс версий: источник %1 перечня версий ""%2"" не отдаёт ни одним протоколом",
		Обезличивание.Адрес(Апстрим.Url), ИмяПакета);
	Возврат Запомнить(Ключ, Новый Массив(), Ложь);

КонецФункции

// Страница пакета — сосед выдачи: выдача "{корень}/download/", страница "{корень}/package/{имя}".
Функция СоСтраницыПакета(Знач Апстрим, Знач ИмяПакета)

	Ответ = Клиент.ПолучитьТекст(КореньВыдачи(Апстрим.Url), "package/" + Сегмент(ИмяПакета),
		"", Секрет.ИзИсточника(Апстрим));
	ЗапомнитьЖивость(Апстрим, Ответ);

	Если Ответ.Код <> 200 Тогда
		Возврат Исход(Новый Массив(), Ложь, Ответ.Код = 0);
	КонецЕсли;

	Попытка
		Найденные = Разбор.Версии(Ответ.Тело, ИмяПакета);
	Исключение
		Возврат Исход(Новый Массив(), Ложь, Ложь); // чужая разметка перечнем версий не стала
	КонецПопытки;

	Лог.Отладка("Индекс версий: страница пакета ""%1"" на %2 дала версий %3",
		ИмяПакета, Обезличивание.Адрес(Апстрим.Url), Найденные.Количество());
	// пустой разбор за ответ не считаем: 200 на этом адресе мог отдать и не тот маршрут,
	// а страница без единой ссылки на артефакт перечнем версий не является
	Возврат Исход(Найденные, Найденные.Количество() > 0, Ложь);

КонецФункции

// "{корень}/packages/{имя}/versions": отозванная версия в набор не идёт.
Функция ИзПеречняВерсийOpenHub(Знач Апстрим, Знач ИмяПакета)

	Ответ = Клиент.ПолучитьТекст(КореньВыдачи(Апстрим.Url),
		СтрШаблон("packages/%1/versions", Сегмент(ИмяПакета)), "", Секрет.ИзИсточника(Апстрим));
	ЗапомнитьЖивость(Апстрим, Ответ);

	Если Ответ.Код <> 200 Тогда
		Возврат Исход(Новый Массив(), Ложь, Ответ.Код = 0);
	КонецЕсли;

	Найденные = ВерсииИзJSON(Ответ.Тело);
	Если Найденные = Неопределено Тогда
		Возврат Исход(Новый Массив(), Ложь, Ложь); // ответ не перечень версий
	КонецЕсли;

	Лог.Отладка("Индекс версий: перечень версий ""%1"" на %2 дал версий %3",
		ИмяПакета, Обезличивание.Адрес(Апстрим.Url), Найденные.Количество());
	Возврат Исход(Найденные, Истина, Ложь);

КонецФункции

// Неопределено, если тело не разбирается как перечень версий OpenHub.
Функция ВерсииИзJSON(Знач Тело)

	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(Строка(Тело));
		Разобрано = ПрочитатьJSON(Чтение, Истина); // в соответствия: ключи чужого ответа произвольны
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Перечень = Разобрано.Получить("versions");
	Если ТипЗнч(Перечень) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Найденные = Новый Массив();
	Для Каждого Элемент Из Перечень Цикл
		Значение = СтрокаВерсииЭлемента(Элемент);
		Если ЗначениеЗаполнено(Значение) Тогда
			Найденные.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Найденные;

КонецФункции

// Пусто, если элемент не описывает действующую версию: строка не станет координатой артефакта.
Функция СтрокаВерсииЭлемента(Знач Элемент)

	Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Если Элемент.Получить("yanked") = Истина Тогда
		Возврат "";
	КонецЕсли;

	Значение = СокрЛП(Строка(?(Элемент.Получить("version") = Неопределено, "",
		Элемент.Получить("version"))));

	Возврат ?(Сравнитель.ПопытатьсяРазобрать(Значение) = Неопределено, "", Значение);

КонецФункции

// Имя пакета едет сегментом пути, а не куском строки: слеш и процент в чужом имени
// иначе увели бы запрос на другой ресурс.
Функция Сегмент(Знач Значение)
	Возврат КодированиеURL.КодироватьСегментПути(Строка(Значение));
КонецФункции

// Перечень версий лежит рядом с выдачей, а не в корне сайта: у хаба на подпути его там нет.
Функция КореньВыдачи(Знач АпстримURL)
	Возврат Адреса.БезХвостовогоСегмента(АпстримURL, "/download");
КонецФункции

// Любой ответ означает, что источник жив; отказ доступа — вопрос доступа, а не живости.
Процедура ЗапомнитьЖивость(Знач Апстрим, Знач Ответ)

	Доступ = Секрет.ИзИсточника(Апстрим);
	Если Ответ.Код = 0 Тогда
		Страж.ОтметитьЛежащим(Апстрим.Url, ?(ЗначениеЗаполнено(Ответ.Пояснение),
			Ответ.Пояснение, "источник не ответил"), Доступ);
	ИначеЕсли Секрет.ЭтоОтказДоступа(Ответ.Код) Тогда
		Страж.ОтметитьНеПустившим(Апстрим.Url,
			СтрШаблон("источник не пустил (ответил %1), токен источника %2",
				Формат(Цел(Ответ.Код), "ЧГ=0; ЧН=0"), Секрет.ДляЖурнала(Доступ)), Доступ);
	Иначе
		Страж.ОтметитьЖивым(Апстрим.Url, Доступ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область КэшПеречня

Функция Запомнить(Знач Ключ, Знач Перечень, Знач Спрошен)

	Итог = Новый Структура("Версии, Спрошен", Перечень, Спрошен);
	Кэш.Сохранить(Ключ, Итог);
	Возврат Итог;

КонецФункции

// Последний известный перечень независимо от возраста: лежащий источник поиска не отменяет.
Функция ПоследнийПеречень(Знач Ключ)

	Запись = Кэш.Запись(Ключ);
	Если Запись = Неопределено ИЛИ Запись.Негатив ИЛИ Запись.Значение = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат Запись.Значение.Версии;

КонецФункции

Функция КлючПеречня(Знач Пул, Знач Апстрим, Знач ИмяПакета)

	Возврат СтрШаблон("versions|%1#%2|%3", Пул.Имя,
		Формат(Цел(Апстрим.Идентификатор), "ЧГ=0; ЧН=0"), НРег(СокрЛП(Строка(ИмяПакета))));

КонецФункции

Функция Исход(Знач Перечень, Знач Ответил, Знач Молчит)
	Возврат Новый Структура("Версии, Ответил, Молчит", Перечень, Ответил, Молчит);
КонецФункции

Функция НеСпрошен(Знач Перечень)
	Возврат Новый Структура("Версии, Спрошен", Перечень, Ложь);
КонецФункции

// Офлайн спрашивается на запросе: его включают ровно тогда, когда рестарт некстати.
Функция ОффлайнРежим()
	Возврат Настройки.Флаг("oshub.proxy.offline", Ложь);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КлиентАпстрима") _Клиент,
	&Пластилин(Значение = "СтражАпстримов") _Страж,
	&Пластилин(Значение = "КэшИзменяемыхРесурсов") _Кэш,
	&Пластилин(Значение = "ПравилаИменования") _Правила,
	&Пластилин(Значение = "АллоулистИмён") _Allowlist,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "РазборВерсийПакета") _Разбор,
	&Пластилин(Значение = "СравнительВерсий") _Сравнитель,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "СекретИсточника") _Секрет = Неопределено,
	&Пластилин(Значение = "РазборАдреса") _Адреса = Неопределено)

	Адреса = ?(_Адреса = Неопределено, Новый РазборАдреса(), _Адреса);
	Клиент = _Клиент;
	Страж = _Страж;
	Кэш = _Кэш;
	Правила = _Правила;
	Allowlist = _Allowlist;
	Настройки = _Настройки;
	Разбор = _Разбор;
	Сравнитель = _Сравнитель;
	Обезличивание = Новый ОбезличиваниеЖурнала();
	Секрет = ?(_Секрет = Неопределено, Новый СекретИсточника(), _Секрет);

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
