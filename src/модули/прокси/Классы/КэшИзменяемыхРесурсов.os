// Кэш метаданных ИЗМЕНЯЕМЫХ ресурсов апстрима в памяти: list.txt, указатель latest,
// перечень версий — и негативные записи о том, чего у источника нет. Положительная запись
// хранит последнее известное значение источника и не снимается ничем: ею отвечают, пока
// источник лежит. Снимаются только негативы, каждый по своему сроку: имя и версию в их
// ключе называет клиент, а не источник, и множество таких ключей ничем не ограничено.

Перем Записи;             // Соответствие: Ключ (Строка) -> Структура(Значение, ETag, Момент, Негатив, Истекает)
Перем БлижайшееИстечение; // Дата — когда истекает самый ранний негатив; Неопределено, если негативов нет
Перем Блокировка;         // БлокировкаРесурса — под ней карта пересобирается и публикуется целиком
Перем Часы;               // Объект с методом Сейчас() -> Дата, либо Неопределено (системные часы)

// Подставляет источник времени — тестовый шов; в рабочем контейнере не вызывается.
//
// Параметры:
//  ИсточникВремени - Произвольный - объект с методом Сейчас(), возвращающим Дату.
//
Процедура УстановитьЧасы(Знач ИсточникВремени) Экспорт
	Часы = ИсточникВремени;
КонецПроцедуры

// Сохраняет положительную запись с отметкой текущего момента.
//
// Параметры:
//  Ключ - Строка - ключ ресурса, включает имя пула и вид ресурса.
//  Значение - Произвольный - кэшируемое значение: массив имён, строка версии и подобное.
//  ETag - Строка - ETag апстрима для условной ревалидации (необязательный, по умолчанию "").
//
Процедура Сохранить(Знач Ключ, Знач Значение, Знач ETag = "") Экспорт

	Положить(Ключ, Новый Структура("Значение, ETag, Момент, Негатив, Истекает",
		Значение, Строка(ETag), Сейчас(), Ложь, Неопределено));

КонецПроцедуры

// Сохраняет негативную запись — того, чего у источника нет, — на заданный срок.
// Негатив с нулевым сроком не хранится вовсе: он всё равно «всегда устаревший».
//
// Параметры:
//  Ключ - Строка - ключ отсутствующего ресурса.
//  СрокСек - Число - сколько секунд отсутствие считается известным.
//
Процедура СохранитьНегатив(Знач Ключ, Знач СрокСек) Экспорт

	Срок = Цел(СрокСек);
	Если Срок <= 0 Тогда
		Возврат;
	КонецЕсли;

	Момент = Сейчас();
	Положить(Ключ, Новый Структура("Значение, ETag, Момент, Негатив, Истекает",
		Неопределено, "", Момент, Истина, Момент + Срок));

КонецПроцедуры

// Сырая запись кэша, положительная либо негативная, без учёта возраста —
// для offline-режима, когда нужно отдать последнее известное значение.
//
// Параметры:
//  Ключ - Строка - ключ ресурса.
//
// Возвращаемое значение:
//  Структура, Неопределено - Значение (Произвольный), ETag (Строка), Момент (Дата),
//              Негатив (Булево), Истекает (Дата, заполнена только у негатива);
//              Неопределено, если записи нет.
//
Функция Запись(Знач Ключ) Экспорт
	Возврат Записи.Получить(Ключ);
КонецФункции

// Положительная запись, если она есть и не устарела. Спрашивается одним вопросом,
// а не «актуальна ли» плюс «дай»: между двумя вопросами соседний поток вправе
// переписать ключ, и ответы разъехались бы.
//
// Параметры:
//  Ключ - Строка - ключ ресурса.
//  TTLСек - Число - время жизни в секундах; 0 делает запись всегда устаревшей.
//
// Возвращаемое значение:
//  Структура, Неопределено - запись в форме Запись(); Неопределено, если записи нет,
//              она негативная или устарела.
//
Функция СвежаяЗапись(Знач Ключ, Знач TTLСек) Экспорт

	ТекЗапись = Записи.Получить(Ключ);
	Если ТекЗапись = Неопределено ИЛИ ТекЗапись.Негатив Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ?(Возраст(ТекЗапись) < TTLСек, ТекЗапись, Неопределено);

КонецФункции

// Известно ли ещё, что этого у источника нет. Срок записи задан при её сохранении
// и позже не меняется: правка настройки действует на новые отсутствия, а не на лежащие.
//
// Параметры:
//  Ключ - Строка - ключ ресурса.
//
// Возвращаемое значение:
//  Булево - Истина, если негативная запись есть и её срок ещё не вышел.
//
Функция НегативАктуален(Знач Ключ) Экспорт

	ТекЗапись = Записи.Получить(Ключ);
	Если ТекЗапись = Неопределено ИЛИ НЕ ТекЗапись.Негатив Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Сейчас() < ТекЗапись.Истекает;

КонецФункции

// Удаляет запись кэша, например после ревалидации со сменой значения.
//
// Параметры:
//  Ключ - Строка - ключ ресурса.
//
Процедура Сбросить(Знач Ключ) Экспорт

	Блокировка.Заблокировать();
	Попытка
		Обновлённые = Копия();
		Обновлённые.Удалить(Ключ);
		Записи = Обновлённые;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

КонецПроцедуры

// Карта меняется только копией: читатель работает с неизменным снимком и замка не берёт,
// а опубликованная карта после публикации уже никем не правится.
Процедура Положить(Знач Ключ, Знач ТекЗапись)

	Блокировка.Заблокировать();
	Попытка
		Обновлённые = Копия();
		Обновлённые.Вставить(Ключ, ТекЗапись);
		Если ТекЗапись.Негатив И (БлижайшееИстечение = Неопределено
			ИЛИ ТекЗапись.Истекает < БлижайшееИстечение) Тогда
			БлижайшееИстечение = ТекЗапись.Истекает;
		КонецЕсли;
		// уборка на любой записи, а не только на негативе: всплеск промахов обязан
		// сойти сам, не дожидаясь следующего промаха
		Записи = БезИстёкшихНегативов(Обновлённые, ТекЗапись.Момент);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

КонецПроцедуры

// Карта обходится не на каждой записи, а когда ближайший срок и правда вышел;
// негативов нет — обхода нет. Зовётся под блокировкой.
Функция БезИстёкшихНегативов(Знач Карта, Знач Момент)

	Если БлижайшееИстечение = Неопределено ИЛИ Момент < БлижайшееИстечение Тогда
		Возврат Карта;
	КонецЕсли;

	Оставшиеся = Новый Соответствие();
	Ближайшее = Неопределено;
	Для Каждого Пара Из Карта Цикл

		ТекЗапись = Пара.Значение;
		Если ТекЗапись.Негатив Тогда
			Если Момент >= ТекЗапись.Истекает Тогда
				Продолжить; // срок вышел — негатив больше ни на что не влияет
			КонецЕсли;
			Если Ближайшее = Неопределено ИЛИ ТекЗапись.Истекает < Ближайшее Тогда
				Ближайшее = ТекЗапись.Истекает;
			КонецЕсли;
		КонецЕсли;
		Оставшиеся.Вставить(Пара.Ключ, ТекЗапись);

	КонецЦикла;

	БлижайшееИстечение = Ближайшее;
	Возврат Оставшиеся;

КонецФункции

// Зовётся под блокировкой: карту, которую обходим, никто в это время не правит.
Функция Копия()

	Итог = Новый Соответствие();
	Для Каждого Пара Из Записи Цикл
		Итог.Вставить(Пара.Ключ, Пара.Значение);
	КонецЦикла;
	Возврат Итог;

КонецФункции

Функция Возраст(Знач ТекЗапись)
	Возврат Сейчас() - ТекЗапись.Момент; // разность дат в OneScript — секунды
КонецФункции

Функция Сейчас()
	Если Часы = Неопределено Тогда
		Возврат ТекущаяУниверсальнаяДата();
	КонецЕсли;
	Возврат Часы.Сейчас();
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта()

	Записи = Новый Соответствие();
	БлижайшееИстечение = Неопределено;
	Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
	Часы = Неопределено;

КонецПроцедуры
