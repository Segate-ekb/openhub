// Единая точка резолва артефакта и списка пакетов для контроллера выдачи: объединённый
// набор версий, затем апстримы пула по порядку, затем кэш и индекс пула, затем 404.

Перем Источники;            // СервисАпстримовПула (реестр) — источники пула в порядке обхода
Перем СервисПулов;          // реестр
Перем СервисПакетов;        // реестр
Перем СервисПроисхождения;  // реестр — чья версия: своя публикация или привезённая
Перем СервисВерсий;         // реестр
Перем РезолверСпецификации; // реестр — лесенка «точная версия → тег → выражение»
Перем СервисТегов;          // реестр — слова отказа «такого канала нет»
Перем Хранилище;            // ХранилищеАртефактов (хранилище)
Перем СервисПрокси;         // прокси — скачивание с источника и его кэш
Перем Набор;                // ОбъединённыйНаборВерсий (прокси) — свои версии и версии источников
Перем КэшАртефактов;        // КэшАртефактов (хранилище) — содержимое часто скачиваемых версий
Перем Обезличивание;        // ОбезличиваниеЖурнала (наблюдаемость)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Разрешает запрос .ospx-файла в пуле до версии и адреса артефакта; содержимое не читается.
//
// Параметры:
//  ИмяПула - Строка - имя пула либо его алиас.
//  ИмяКанала - Строка - имя тега из канального сегмента пути; пустая строка означает
//              безверсионный путь, то есть основной тег пакета.
//  ИмяПакета - Строка - имя пакета из URL.
//  ЗапросФайла - Структура - результат РезолверФайлаПакета.РазобратьЗапросФайла:
//                БезСпецификации (Булево), Спецификация (Строка).
//
// Возвращаемое значение:
//  Структура - Найдено (Булево), Версия (ВерсияПакета), Координаты (КоординатыАртефакта),
//              ИмяАртефакта (Строка, "{имя}-{версия}.ospx"),
//              ВерсиюВыбралХаб (Булево, Ложь только когда клиент назвал точную версию),
//              ИмяПула (Строка, каноническое имя пула из реестра, а не написание клиента);
//              поля артефакта заполнены только при Найдено.
//
Функция РазрешитьФайл(
	&АтрибутСпана("oshub.pool") Знач ИмяПула,
	&АтрибутСпана("oshub.channel") Знач ИмяКанала,
	&АтрибутСпана("oshub.package") Знач ИмяПакета,
	Знач ЗапросФайла) Экспорт

	Лог.Отладка("Выдача: пул ""%1"", канал ""%2"", пакет ""%3"", спецификация %4",
		ИмяПула, ИмяКанала, ИмяПакета,
		?(ЗапросФайла.БезСпецификации, "не названа", ЗапросФайла.Спецификация));

	Пул = СервисПулов.ПулДляЧтения(ИмяПула);
	Если Пул = Неопределено Тогда
		Лог.Отладка("Выдача: пула ""%1"" нет — 404 ещё до поиска пакета", ИмяПула);
		Возврат НеНайдено();
	КонецЕсли;

	Результат = РазрешитьЕдинымПутём(Пул, ИмяКанала, ИмяПакета, ЗапросФайла);

	Если Результат.Найдено Тогда
		Лог.Отладка("Выдача: отдаём %1 из пула ""%2""", Результат.ИмяАртефакта, Пул.Имя);
	Иначе
		Лог.Отладка("Выдача: ""%1"" в пуле ""%2"" не разрешён ни своим реестром, ни апстримами — 404",
			ИмяПакета, Пул.Имя);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Объясняет уже состоявшийся отказ выдачи, когда причина — незаведённый канал: тем же
// вопросом к лесенке резолва, что и сама выдача, и теми же словами, какими отвечает
// адрес резолва. Читающая функция: спрашивается ПОСЛЕ 404 и ничего не меняет.
//
// Параметры:
//  ИмяПула - Строка - имя пула либо его алиас.
//  ИмяКанала - Строка - имя тега из канального сегмента пути; пустая строка — безверсионный путь.
//  ИмяПакета - Строка - имя пакета из URL.
//  ЗапросФайла - Структура - тот же, что у РазрешитьФайл.
//
// Возвращаемое значение:
//  Строка - текст отказа; "" — причина не в имени канала, и объяснять нечего.
//
Функция ОбъяснитьОтказ(
	&АтрибутСпана("oshub.pool") Знач ИмяПула,
	&АтрибутСпана("oshub.channel") Знач ИмяКанала,
	&АтрибутСпана("oshub.package") Знач ИмяПакета,
	Знач ЗапросФайла) Экспорт

	Пул = СервисПулов.ПулДляЧтения(ИмяПула);
	Если Пул = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Пакет = СервисПакетов.ПакетДляЧтения(Пул.Идентификатор, ИмяПакета);
	Если Пакет = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	// безверсионный путь называет канал сегментом адреса; пустой сегмент — это установка
	// без спецификации, и своего канала у неё нет
	Если ЗапросФайла.БезСпецификации Тогда
		Возврат ?(ПустаяСтрока(СокрЛП(Строка(ИмяКанала))), "",
			СервисТегов.ОбъяснитьНеизвестныйТег(Пакет, ИмяКанала));
	КонецЕсли;

	Разрешение = РезолверСпецификации.Разрешить(Пакет, ЗапросФайла.Спецификация,
		КругВыбораХаба(Пакет));
	Возврат ?(НЕ Разрешение.ТегНеизвестен, "",
		СервисТегов.ОбъяснитьНеизвестныйТег(Пакет, ЗапросФайла.Спецификация));

КонецФункции

// Содержимое разрешённого артефакта: из кэша выдачи, а то, что кэш не держит, — из хранилища.
//
// Параметры:
//  Разрешение - Структура - результат РазрешитьФайл с Найдено = Истина.
//
// Возвращаемое значение:
//  ДвоичныеДанные - содержимое артефакта.
//
// Выбрасывает исключение, если хранилище артефакт не отдало.
//
Функция Содержимое(Знач Разрешение) Экспорт

	Данные = КэшАртефактов.Содержимое(Разрешение.Версия.Sha256, Разрешение.Координаты);
	Если Данные <> Неопределено Тогда
		Лог.Отладка("Выдача: тело %1 отдал слой кэша (промах или попадание — строкой кэша выше), %2 байт",
			Разрешение.ИмяАртефакта, Данные.Размер());
		Возврат Данные;
	КонецЕсли;

	Данные = Хранилище.ПолучитьДанные(Разрешение.Координаты);
	Лог.Отладка("Выдача: тело %1 — мимо кэша, из хранилища, %2 байт", Разрешение.ИмяАртефакта, Данные.Размер());

	Возврат Данные;

КонецФункции

// Имена пакетов пула для list.txt и время последнего изменения.
// Список объединяет свои пакеты и списки всех апстримов пула, дедуплицируя без учёта регистра.
//
// Параметры:
//  ИмяПула - Строка - имя пула либо его алиас.
//
// Возвращаемое значение:
//  Структура, Неопределено - Имена (Массив из Строка), ПоследнееИзменение (Дата);
//              Неопределено, если пул не найден.
//
Функция ИменаПула(&АтрибутСпана("oshub.pool") Знач ИмяПула) Экспорт

	Пул = СервисПулов.ПулДляЧтения(ИмяПула);
	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Аккумулятор = Новый Структура("Соответствие, ПоследнееИзменение", Новый Соответствие(), Неопределено);
	СобратьИмена(Пул, Аккумулятор);

	Имена = Новый Массив();
	Для Каждого КиЗ Из Аккумулятор.Соответствие Цикл
		Имена.Добавить(КиЗ.Значение);
	КонецЦикла;

	Возврат Новый Структура("Имена, ПоследнееИзменение", Имена, Аккумулятор.ПоследнееИзменение);

КонецФункции

#КонецОбласти

#Область РезолвФайла
Функция РазрешитьЕдинымПутём(Знач Пул, Знач ИмяКанала, Знач ИмяПакета, Знач ЗапросФайла)

	Пакет = СервисПакетов.ПакетДляЧтения(Пул.Идентификатор, ИмяПакета);

	// СтрокиПула, а не Все: у пула, которому апстримы недопустимы по типу, строк нет независимо
	// от содержимого таблицы. Строки читаются один раз — по ним решают и опрос, и сверку наличия
	СтрокиИсточников = Источники.СтрокиПула(Пул);
	Апстримы = Источники.Включённые(СтрокиИсточников);

	Если Апстримы.Количество() = 0 Тогда
		Лог.Отладка("Выдача: у пула ""%1"" апстримов нет — ищем только в своём реестре", Пул.Имя);
		Возврат РазрешитьИзРеестраПула(Пул, Пакет, ИмяКанала, ЗапросФайла,
			ФайлыПулаВытесняются(СтрокиИсточников));
	КонецЕсли;

	// 1) версию выбирает ХАБ: выбираем из всего, что видит пул, — своих версий и версий,
	// которые называют индексы источников. Побеждает самая поздняя, а не ближайшая.
	// Названную клиентом координату набор не трогает: за ней идут ниже, по порядку
	Если ХабВыбираетВерсию(ЗапросФайла) Тогда
		ИзНабора = РазрешитьОбъединённымНабором(Пул, Апстримы, Пакет, ИмяКанала, ИмяПакета, ЗапросФайла);
		Если ИзНабора.Найдено Тогда
			Возврат ИзНабора;
		КонецЕсли;
		// 2) захваченное имя остаётся при своей версии: безверсионный файл источника ему
		// не предлагают — он может оказаться СТАРШЕ, и `opm update` откатил бы назад
		Если ИмяПринадлежитПулу(Пакет) Тогда
			Лог.Отладка("Выдача: ""%1"" — имя своё, а источники версии новее не назвали",
				ИмяПакета);
			Возврат РазрешитьИзРеестраПула(Пул, Пакет, ИмяКанала, ЗапросФайла);
		КонецЕсли;
	КонецЕсли;

	// 3) апстримы строго по порядку: первый ответивший отдаёт артефакт
	Для Каждого Апстрим Из Апстримы Цикл
		Результат = РазрешитьЧерезАпстрим(Пул, Апстрим, ИмяКанала, ИмяПакета, ЗапросФайла);
		Если Результат.Найдено Тогда
			Возврат Результат;
		КонецЕсли;
		Лог.Отладка("Выдача: апстрим %1 пакет ""%2"" не дал — идём к следующему",
			Обезличивание.Адрес(Апстрим.Url), ИмяПакета);
	КонецЦикла;

	Лог.Отладка("Выдача: апстримы (%1 шт.) пакет ""%2"" не дали — остаётся кэш и каналы пула",
		Апстримы.Количество(), ИмяПакета);

	// 4) кэш пула и каналы, которые у апстрима не спрашиваются; он же обслуживает offline.
	// Пакет ищем заново: шаг 3 мог завести его ленивой индексацией скачанного
	Возврат РазрешитьИзРеестраПула(Пул, СервисПакетов.ПакетДляЧтения(Пул.Идентификатор, ИмяПакета),
		ИмяКанала, ЗапросФайла);

КонецФункции

// Круг выбора хаба из снимков версий и провенанса: резолв выдачи в базу за ними не ходит.
Функция КругВыбораХаба(Знач Пакет)

	Если Пакет = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат РезолверСпецификации.КругВыбораХаба(Пакет,
		СервисВерсий.ВерсииПакетаДляЧтения(Пакет.Идентификатор),
		СервисПроисхождения.СнимокПакетаДляЧтения(Пакет.Идентификатор));

КонецФункции

// Точную координату называет клиент, всё остальное — последнюю, тег, выражение — выбирает хаб.
Функция ХабВыбираетВерсию(Знач ЗапросФайла)

	Возврат ЗапросФайла.БезСпецификации
		ИЛИ НЕ РезолверСпецификации.ЭтоСтрокаВерсии(ЗапросФайла.Спецификация);

КонецФункции

// Ответ принимается, только когда набор полон: непрочитанный индекс источника — не факт.
Функция РазрешитьОбъединённымНабором(Знач Пул, Знач Апстримы, Знач Пакет, Знач ИмяКанала,
	Знач ИмяПакета, Знач ЗапросФайла)

	Свой = РазрешитьВерсиюПакета(Пакет, ИмяКанала, ЗапросФайла);

	Если ЗапросФайла.БезСпецификации Тогда
		Выбор = Набор.ВыбратьТегом(Пул, Апстримы, Пакет, ИмяПакета, ИмяКанала, Свой.Версия);
	Иначе
		Выбор = Набор.ВыбратьПоСпецификации(Пул, Апстримы, Пакет, ИмяПакета,
			ЗапросФайла.Спецификация, Свой.Версия);
	КонецЕсли;

	Если НЕ Выбор.Найдена Тогда
		Возврат НеНайдено();
	КонецЕсли;

	Если Выбор.Апстрим = Неопределено Тогда
		Возврат ?(Выбор.ВсеИсточникиОпрошены,
			ГотовоПоВерсии(Пул, Пакет, Свой.Версия, Свой.ВерсиюВыбралХаб), НеНайдено());
	КонецЕсли;

	// наружу уходит КООРДИНАТА версии — и это проверяется здесь, у самой двери наружу,
	// а не только на входе индекса: чужой ответ «version: stable» иначе лёг бы в пул
	// артефактом с координатой stable
	Если НЕ РезолверСпецификации.ЭтоСтрокаВерсии(Выбор.СтрокаВерсии) Тогда
		Лог.Отладка("Выдача: источник назвал ""%1"" — это не координата версии, наружу с ней не идём",
			Выбор.СтрокаВерсии);
		Возврат НеНайдено();
	КонецЕсли;

	Если НЕ СервисПрокси.ОбеспечитьВерсию(Пул, Выбор.Апстрим, ИмяПакета, Выбор.СтрокаВерсии) Тогда
		Лог.Отладка("Выдача: источник назвал %1-%2, но артефакт не отдал — идём дальше по лестнице",
			ИмяПакета, Выбор.СтрокаВерсии);
		Возврат НеНайдено();
	КонецЕсли;

	Возврат ГотовоПослеСкачивания(Пул, ИмяПакета, Выбор.СтрокаВерсии, Истина);

КонецФункции

// Есть ли у имени хоть одна собственная версия, опубликованная здесь, а не взятая с апстрима.
Функция ИмяПринадлежитПулу(Знач Пакет)

	Если Пакет = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СервисПроисхождения.ЕстьСобственныеВерсии(Пакет.Идентификатор);

КонецФункции

// Обслуживает и свои публикации, и ранее закэшированное; пакет передаётся уже найденным.
Функция РазрешитьИзРеестраПула(Знач Пул, Знач Пакет, Знач ИмяКанала, Знач ЗапросФайла,
	Знач СверитьНаличие = Истина)

	Если Пакет = Неопределено Тогда
		Возврат НеНайдено();
	КонецЕсли;

	Разрешение = РазрешитьВерсиюПакета(Пакет, ИмяКанала, ЗапросФайла);
	Возврат ГотовоПоВерсии(Пул, Пакет, Разрешение.Версия, Разрешение.ВерсиюВыбралХаб, СверитьНаличие);

КонецФункции

// Координаты — по каноническому имени из реестра; наличие файла сверяется по просьбе вызывающего.
Функция ГотовоПоВерсии(Знач Пул, Знач Пакет, Знач Версия, Знач ВерсиюВыбралХаб,
	Знач СверитьНаличие = Истина)

	Если Версия = Неопределено Тогда
		Возврат НеНайдено();
	КонецЕсли;

	Координаты = Новый КоординатыАртефакта(Пул.Имя, Пакет.Имя, Версия.Версия);
	Если СверитьНаличие И НЕ Хранилище.Существует(Координаты) Тогда
		Лог.Отладка("Выдача: версия %1-%2 в реестре есть, а артефакта в хранилище нет",
			Пакет.Имя, Версия.Версия);
		Возврат НеНайдено();
	КонецЕсли;

	Возврат Готово(Версия, Координаты, ВерсиюВыбралХаб);

КонецФункции

// Файлы пула вытесняет уборка кэша источников — у пула есть строки источников, пусть и выключенные.
// Без них запись версии появляется после укладки файла, и о наличии хранилище не спрашивают.
Функция ФайлыПулаВытесняются(Знач СтрокиИсточников)
	Возврат СтрокиИсточников.Количество() > 0;
КонецФункции

// Кэш-хит либо скачивание с ленивой индексацией; промах уводит вызывающего к следующему апстриму.
Функция РазрешитьЧерезАпстрим(Знач Пул, Знач Апстрим, Знач ИмяКанала, Знач ИмяПакета, Знач ЗапросФайла)

	Если ЗапросФайла.БезСпецификации Тогда
		// апстрим отдаёт ровно один безверсионный {name}.ospx, и это его stable;
		// прочие теги обслуживает локальный индекс пула шагом ниже
		Если НЕ БезверсионныйДоходитДоАпстрима(ИмяКанала) Тогда
			Возврат НеНайдено();
		КонецЕсли;
		ВерсиюВыбралХаб = Истина; // спросили «последнюю» — какую именно, решил не клиент
		СтрокаВерсии = СервисПрокси.ОбеспечитьПоследнюю(Пул, Апстрим, ИмяПакета);
	Иначе
		// апстрим понимает только координату версии; спроси его «версией stable» —
		// и в хранилище ляжет артефакт с координатой-версией stable
		Если НЕ РезолверСпецификации.ЭтоСтрокаВерсии(ЗапросФайла.Спецификация) Тогда
			Лог.Отладка("Выдача: спецификация ""%1"" — не координата версии, апстримы не опрашиваются",
				ЗапросФайла.Спецификация);
			Возврат НеНайдено();
		КонецЕсли;
		ВерсиюВыбралХаб = Ложь; // координату назвал клиент: ответ по этому адресу не изменится
		СтрокаВерсии = ЗапросФайла.Спецификация;
		Если НЕ СервисПрокси.ОбеспечитьВерсию(Пул, Апстрим, ИмяПакета, СтрокаВерсии) Тогда
			Возврат НеНайдено();
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СтрокаВерсии) Тогда
		Возврат НеНайдено();
	КонецЕсли;

	Возврат ГотовоПослеСкачивания(Пул, ИмяПакета, СтрокаВерсии, ВерсиюВыбралХаб);

КонецФункции

// Координаты по имени из URL, как сохранил СервисПрокси: файлы выдачи регистрозависимы.
Функция ГотовоПослеСкачивания(Знач Пул, Знач ИмяПакета, Знач СтрокаВерсии, Знач ВерсиюВыбралХаб)

	Пакет = СервисПакетов.ПакетДляЧтения(Пул.Идентификатор, ИмяПакета);
	Если Пакет = Неопределено Тогда
		Возврат НеНайдено();
	КонецЕсли;

	Версия = СервисВерсий.НайтиВерсиюДляЧтения(Пакет.Идентификатор, СтрокаВерсии);
	Если Версия = Неопределено Тогда
		Возврат НеНайдено();
	КонецЕсли;

	Координаты = Новый КоординатыАртефакта(Пул.Имя, ИмяПакета, СтрокаВерсии);
	Если НЕ Хранилище.Существует(Координаты) Тогда
		Возврат НеНайдено();
	КонецЕсли;

	Возврат Готово(Версия, Координаты, ВерсиюВыбралХаб);

КонецФункции

// Апстрим знает один безверсионный файл — свой stable; прочие теги на него не ложатся.
Функция БезверсионныйДоходитДоАпстрима(Знач ИмяКанала)

	Имя = НРег(СокрЛП(Строка(ИмяКанала)));
	Возврат ПустаяСтрока(Имя) ИЛИ Имя = "stable" ИЛИ Имя = "latest";

КонецФункции

// Единственная точка резолва версии на все ветки выдачи: круг кандидатов сужается здесь же.
Функция РазрешитьВерсиюПакета(Знач Пакет, Знач ИмяКанала, Знач ЗапросФайла)

	Кандидаты = КругВыбораХаба(Пакет);

	Если ЗапросФайла.БезСпецификации Тогда
		// спецификации нет: канальный сегмент называет тег, а его отсутствие — основной тег
		Возврат РезолверСпецификации.РазрешитьТегом(Пакет, ИмяКанала, Кандидаты);
	КонецЕсли;

	// одна лесенка на все пути получения пакета: точная версия, имя тега, выражение версии
	Возврат РезолверСпецификации.Разрешить(Пакет, ЗапросФайла.Спецификация, Кандидаты);

КонецФункции

// Имя пула берётся у координат артефакта, а не у запроса: в координаты оно попало
// из сущности пула и потому каноническое. Клиент вправе написать имя пула в любом
// регистре — статистика и метрики обязаны видеть один пул, а не ряд написаний.
Функция Готово(Знач Версия, Знач Координаты, Знач ВерсиюВыбралХаб)

	Возврат Новый Структура("Найдено, Версия, Координаты, ИмяАртефакта, ВерсиюВыбралХаб, ИмяПула",
		Истина,
		Версия,
		Координаты,
		СтрШаблон("%1-%2.ospx", Координаты.Пакет(), Версия.Версия),
		ВерсиюВыбралХаб,
		Координаты.Пул());

КонецФункции

Функция НеНайдено()

	Возврат Новый Структура("Найдено, Версия, Координаты, ИмяАртефакта, ВерсиюВыбралХаб, ИмяПула",
		Ложь, Неопределено, Неопределено, "", Ложь, "");

КонецФункции

#КонецОбласти

#Область СписокПакетов

Процедура СобратьИмена(Знач Пул, Знач Аккумулятор)

	// имена, уже проиндексированные в реестре пула
	Для Каждого Пакет Из СервисПакетов.ПакетыПулаДляЧтения(Пул.Идентификатор) Цикл
		Если НЕ Пакет.Скрыт Тогда
			ДобавитьИмя(Аккумулятор, Пакет.Имя);
			Аккумулятор.ПоследнееИзменение = Позднее(Аккумулятор.ПоследнееИзменение, Пакет.Создан);
		КонецЕсли;
	КонецЦикла;

	// списки апстримов в порядке опроса: наполнение видно ещё до первых скачиваний
	Апстримы = Источники.ДляОпроса(Пул);
	Для Каждого Апстрим Из Апстримы Цикл
		Для Каждого Имя Из СервисПрокси.ИменаАпстрима(Пул, Апстрим) Цикл
			ДобавитьИмя(Аккумулятор, Имя);
		КонецЦикла;
	КонецЦикла;
	Если Апстримы.Количество() > 0 Тогда
		Аккумулятор.ПоследнееИзменение = Позднее(Аккумулятор.ПоследнееИзменение, ТекущаяУниверсальнаяДата());
	КонецЕсли;

КонецПроцедуры

// Дедупликация без учёта регистра, первое вхождение сохраняет свой регистр.
Процедура ДобавитьИмя(Знач Аккумулятор, Знач Имя)

	Ключ = НРег(СокрЛП(Имя));
	Если ЗначениеЗаполнено(Ключ) И Аккумулятор.Соответствие.Получить(Ключ) = Неопределено Тогда
		Аккумулятор.Соответствие.Вставить(Ключ, СокрЛП(Имя));
	КонецЕсли;

КонецПроцедуры

Функция Позднее(Знач Первая, Знач Вторая)

	Если НЕ ЗначениеЗаполнено(Вторая) Тогда
		Возврат Первая;
	КонецЕсли;
	Если Первая = Неопределено Тогда
		Возврат Вторая;
	КонецЕсли;
	Возврат ?(Вторая > Первая, Вторая, Первая);

КонецФункции

#КонецОбласти

&Желудь
&Наблюдаемый
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисАпстримовПула") _Источники,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "РезолверСпецификации") _РезолверСпецификации,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "ХранилищеАртефактов") _Хранилище,
	&Пластилин(Значение = "СервисПрокси") _СервисПрокси,
	&Пластилин(Значение = "СервисПроисхождения") _СервисПроисхождения,
	&Пластилин(Значение = "ОбъединённыйНаборВерсий") _Набор,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "КэшАртефактов") _КэшАртефактов)

	Обезличивание = Новый ОбезличиваниеЖурнала();
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

	СервисПулов = _СервисПулов;
	Источники = _Источники;
	СервисПакетов = _СервисПакетов;
	СервисПроисхождения = _СервисПроисхождения;
	СервисВерсий = _СервисВерсий;
	РезолверСпецификации = _РезолверСпецификации;
	СервисТегов = _СервисТегов;
	Хранилище = _Хранилище;
	СервисПрокси = _СервисПрокси;
	Набор = _Набор;
	КэшАртефактов = _КэшАртефактов;

КонецПроцедуры
