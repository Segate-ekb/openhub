// Единая точка резолва артефакта и списка пакетов для контроллера выдачи.
// Путь выдачи: своё имя -> апстримы пула по порядку -> кэш и индекс пула -> 404;
// пул без апстримов не делает ни одного исходящего запроса.
// Защита от dependency-confusion: у имени с хотя бы одной СОБСТВЕННОЙ версией своя версия
// всегда выигрывает у одноимённой апстримной, а всё, что выбирает ХАБ — тег, выражение
// версии, основной тег, — выбирается только из своих версий, какой бы формой ни спросили.
// Точная апстримная версия захваченного имени при этом остаётся доступной через нас.
// Признак «своё имя» берётся из провенанса версий, а не из изменяемых настроек пула.
// Allowlist — гейт скачивания, а не выдачи: лежащий в кэше артефакт отдаётся и после
// сужения allowlist или удаления пакета у апстрима; лечится пуржем кэша.
// Какую версию называет спецификация — решает РезолверСпецификации, один на все пути
// получения пакета; наружу уходит только координата версии и «последняя».

Перем СервисПулов;          // реестр
Перем СервисПакетов;        // реестр
Перем СервисПроисхождения;  // реестр — чья версия: своя публикация или привезённая
Перем СервисВерсий;         // реестр
Перем РезолверСпецификации; // реестр — лесенка «точная версия → тег → выражение»
Перем Хранилище;            // ХранилищеАртефактов (хранилище)
Перем СервисПрокси;         // прокси — скачивание с источника и его кэш
Перем Обезличивание;        // ОбезличиваниеЖурнала (наблюдаемость)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Разрешает запрос .ospx-файла в пуле до готового артефакта.
// Выданный ПутьКФайлу вызывающий обязан вернуть методом Освободить.
//
// Параметры:
//  ИмяПула - Строка - имя пула либо его алиас.
//  ИмяКанала - Строка - имя тега из канального сегмента пути; пустая строка означает
//              безверсионный путь, то есть основной тег пакета.
//  ИмяПакета - Строка - имя пакета из URL.
//  ЗапросФайла - Структура - результат РезолверФайлаПакета.РазобратьЗапросФайла:
//                БезСпецификации (Булево), Спецификация (Строка).
//
// Возвращаемое значение:
//  Структура - Найдено (Булево), Версия (ВерсияПакета), ПутьКФайлу (Строка, путь артефакта
//              в хранилище), ИмяАртефакта (Строка, "{имя}-{версия}.ospx"),
//              ВерсиюВыбралХаб (Булево, Ложь только когда клиент назвал точную версию);
//              поля артефакта заполнены только при Найдено.
//
Функция РазрешитьФайл(Знач ИмяПула, Знач ИмяКанала, Знач ИмяПакета, Знач ЗапросФайла) Экспорт

	Лог.Отладка("Выдача: пул ""%1"", канал ""%2"", пакет ""%3"", спецификация %4",
		ИмяПула, ИмяКанала, ИмяПакета,
		?(ЗапросФайла.БезСпецификации, "не названа", ЗапросФайла.Спецификация));

	Пул = СервисПулов.НайтиПул(ИмяПула);
	Если Пул = Неопределено Тогда
		Лог.Отладка("Выдача: пула ""%1"" нет — 404 ещё до поиска пакета", ИмяПула);
		Возврат НеНайдено();
	КонецЕсли;

	Результат = РазрешитьЕдинымПутём(Пул, ИмяКанала, ИмяПакета, ЗапросФайла);

	Если Результат.Найдено Тогда
		Лог.Отладка("Выдача: отдаём %1 из пула ""%2""", Результат.ИмяАртефакта, Пул.Имя);
	Иначе
		Лог.Отладка("Выдача: ""%1"" в пуле ""%2"" не разрешён ни своим реестром, ни апстримами — 404",
			ИмяПакета, Пул.Имя);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Освобождает путь артефакта, выданный методом РазрешитьФайл. Вызывающий обязан позвать
// его, закончив читать файл, на любом пути выхода. Идемпотентна.
//
// Параметры:
//  ПутьКФайлу - Строка - значение ПутьКФайлу из результата РазрешитьФайл.
//
Процедура Освободить(Знач ПутьКФайлу) Экспорт
	Хранилище.ОсвободитьВыдачу(ПутьКФайлу);
КонецПроцедуры

// Имена пакетов пула для list.txt и время последнего изменения.
// Список объединяет свои пакеты и списки всех апстримов пула, дедуплицируя без учёта регистра.
//
// Параметры:
//  ИмяПула - Строка - имя пула либо его алиас.
//
// Возвращаемое значение:
//  Структура, Неопределено - Имена (Массив из Строка), ПоследнееИзменение (Дата);
//              Неопределено, если пул не найден.
//
Функция ИменаПула(Знач ИмяПула) Экспорт

	Пул = СервисПулов.НайтиПул(ИмяПула);
	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Аккумулятор = Новый Структура("Соответствие, ПоследнееИзменение", Новый Соответствие(), Неопределено);
	СобратьИмена(Пул, Аккумулятор);

	Имена = Новый Массив();
	Для Каждого КиЗ Из Аккумулятор.Соответствие Цикл
		Имена.Добавить(КиЗ.Значение);
	КонецЦикла;

	Возврат Новый Структура("Имена, ПоследнееИзменение", Имена, Аккумулятор.ПоследнееИзменение);

КонецФункции

#КонецОбласти

#Область РезолвФайла
Функция РазрешитьЕдинымПутём(Знач Пул, Знач ИмяКанала, Знач ИмяПакета, Знач ЗапросФайла)

	Пакет = СервисПакетов.НайтиПакет(Пул.Идентификатор, ИмяПакета);

	// АпстримыДляОпроса, а не АпстримыПула: у пула, которому апстримы недопустимы по типу,
	// список пуст независимо от содержимого таблицы
	Апстримы = СервисПулов.АпстримыДляОпроса(Пул);
	Если Апстримы.Количество() = 0 Тогда
		Лог.Отладка("Выдача: у пула ""%1"" апстримов нет — ищем только в своём реестре", Пул.Имя);
		Возврат РазрешитьИзРеестраПула(Пул, Пакет, ИмяКанала, ЗапросФайла);
	КонецЕсли;

	// 1) своё имя: точная версия, которой у нас нет, идёт дальше на апстримы
	Если ИмяПринадлежитПулу(Пакет) Тогда
		Свой = РазрешитьСвойПакет(Пул, Пакет, ИмяКанала, ЗапросФайла);
		Если Свой.Найдено ИЛИ ЗапросФайла.БезСпецификации Тогда
			Лог.Отладка("Выдача: имя ""%1"" своё — апстримы не опрашиваются", ИмяПакета);
			Возврат Свой; // latest своего имени наружу не ходит никогда
		КонецЕсли;
	КонецЕсли;

	// 2) апстримы строго по порядку: первый ответивший отдаёт артефакт
	Для Каждого Апстрим Из Апстримы Цикл
		Результат = РазрешитьЧерезАпстрим(Пул, Апстрим, ИмяКанала, ИмяПакета, ЗапросФайла);
		Если Результат.Найдено Тогда
			Возврат Результат;
		КонецЕсли;
		Лог.Отладка("Выдача: апстрим %1 пакет ""%2"" не дал — идём к следующему",
			Обезличивание.Адрес(Апстрим.Url), ИмяПакета);
	КонецЦикла;

	Лог.Отладка("Выдача: апстримы (%1 шт.) пакет ""%2"" не дали — остаётся кэш и каналы пула",
		Апстримы.Количество(), ИмяПакета);

	// 3) кэш пула и каналы, которые у апстрима не спрашиваются; он же обслуживает offline.
	// Пакет ищем заново: шаг 2 мог завести его ленивой индексацией скачанного
	Возврат РазрешитьИзРеестраПула(Пул, СервисПакетов.НайтиПакет(Пул.Идентификатор, ИмяПакета),
		ИмяКанала, ЗапросФайла);

КонецФункции

// Есть ли у имени хоть одна собственная версия, опубликованная здесь, а не взятая с апстрима.
Функция ИмяПринадлежитПулу(Знач Пакет)

	Если Пакет = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СервисПроисхождения.ЕстьСобственныеВерсии(Пакет.Идентификатор);

КонецФункции

// Только собственный реестр, без обращения к апстримам.
Функция РазрешитьСвойПакет(Знач Пул, Знач Пакет, Знач ИмяКанала, Знач ЗапросФайла)

	Разрешение = РазрешитьВерсиюПакета(Пакет, ИмяКанала, ЗапросФайла);
	Возврат ГотовоПоВерсии(Пул, Пакет, Разрешение.Версия, Разрешение.ВерсиюВыбралХаб);

КонецФункции

// Обслуживает и свои публикации, и ранее закэшированное с апстримов.
// Пакет передаётся уже найденным: один поиск по имени на ветку резолва.
Функция РазрешитьИзРеестраПула(Знач Пул, Знач Пакет, Знач ИмяКанала, Знач ЗапросФайла)

	Если Пакет = Неопределено Тогда
		Возврат НеНайдено();
	КонецЕсли;

	Разрешение = РазрешитьВерсиюПакета(Пакет, ИмяКанала, ЗапросФайла);
	Возврат ГотовоПоВерсии(Пул, Пакет, Разрешение.Версия, Разрешение.ВерсиюВыбралХаб);

КонецФункции

// Артефакт обязан физически лежать в хранилище; координаты — по каноническому имени из реестра.
Функция ГотовоПоВерсии(Знач Пул, Знач Пакет, Знач Версия, Знач ВерсиюВыбралХаб)

	Если Версия = Неопределено Тогда
		Возврат НеНайдено();
	КонецЕсли;

	Координаты = Новый КоординатыАртефакта(Пул.Имя, Пакет.Имя, Версия.Версия);
	Если НЕ Хранилище.Существует(Координаты) Тогда
		Лог.Отладка("Выдача: версия %1-%2 в реестре есть, а артефакта в хранилище нет",
			Пакет.Имя, Версия.Версия);
		Возврат НеНайдено();
	КонецЕсли;

	Возврат Готово(Версия, Координаты, ВерсиюВыбралХаб);

КонецФункции

// Кэш-хит либо скачивание с апстрима с ленивой индексацией; промах даёт НеНайдено,
// и вызывающий переходит к следующему апстриму.
Функция РазрешитьЧерезАпстрим(Знач Пул, Знач Апстрим, Знач ИмяКанала, Знач ИмяПакета, Знач ЗапросФайла)

	Если ЗапросФайла.БезСпецификации Тогда
		// апстрим отдаёт ровно один безверсионный {name}.ospx, и это его stable;
		// прочие теги обслуживает локальный индекс пула шагом ниже
		Если НЕ БезверсионныйДоходитДоАпстрима(ИмяКанала) Тогда
			Возврат НеНайдено();
		КонецЕсли;
		ВерсиюВыбралХаб = Истина; // спросили «последнюю» — какую именно, решил не клиент
		СтрокаВерсии = СервисПрокси.ОбеспечитьПоследнюю(Пул, Апстрим, ИмяПакета);
	Иначе
		// апстрим понимает только координату версии; спроси его «версией stable» —
		// и в хранилище ляжет артефакт с координатой-версией stable
		Если НЕ РезолверСпецификации.ЭтоСтрокаВерсии(ЗапросФайла.Спецификация) Тогда
			Лог.Отладка("Выдача: спецификация ""%1"" — не координата версии, апстримы не опрашиваются",
				ЗапросФайла.Спецификация);
			Возврат НеНайдено();
		КонецЕсли;
		ВерсиюВыбралХаб = Ложь; // координату назвал клиент: ответ по этому адресу не изменится
		СтрокаВерсии = ЗапросФайла.Спецификация;
		Если НЕ СервисПрокси.ОбеспечитьВерсию(Пул, Апстрим, ИмяПакета, СтрокаВерсии) Тогда
			Возврат НеНайдено();
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СтрокаВерсии) Тогда
		Возврат НеНайдено();
	КонецЕсли;

	Пакет = СервисПакетов.НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Если Пакет = Неопределено Тогда
		Возврат НеНайдено();
	КонецЕсли;

	Версия = СервисВерсий.НайтиВерсию(Пакет.Идентификатор, СтрокаВерсии);
	Если Версия = Неопределено Тогда
		Возврат НеНайдено();
	КонецЕсли;

	// координаты по имени из URL, как сохранил СервисПрокси: файлы выдачи регистрозависимы
	Координаты = Новый КоординатыАртефакта(Пул.Имя, ИмяПакета, СтрокаВерсии);
	Если НЕ Хранилище.Существует(Координаты) Тогда
		Возврат НеНайдено();
	КонецЕсли;

	Возврат Готово(Версия, Координаты, ВерсиюВыбралХаб);

КонецФункции

// Апстрим знает один безверсионный файл — свой stable. Пустой канальный сегмент
// (основной тег пакета) и имена stable/latest на него ложатся, прочие теги — нет.
Функция БезверсионныйДоходитДоАпстрима(Знач ИмяКанала)

	Имя = НРег(СокрЛП(Строка(ИмяКанала)));
	Возврат ПустаяСтрока(Имя) ИЛИ Имя = "stable" ИЛИ Имя = "latest";

КонецФункции

// Единственная точка резолва версии на все три ветки выдачи: свой пакет, кэш апстрима
// и пул без апстримов. Круг кандидатов сужается здесь же, поэтому защита имени работает
// одинаково на всех трёх и на любой форме запроса.
Функция РазрешитьВерсиюПакета(Знач Пакет, Знач ИмяКанала, Знач ЗапросФайла)

	Кандидаты = КругКандидатов(Пакет);

	Если ЗапросФайла.БезСпецификации Тогда
		// спецификации нет: канальный сегмент называет тег, а его отсутствие — основной тег
		Возврат РезолверСпецификации.РазрешитьТегом(Пакет, ИмяКанала, Кандидаты);
	КонецЕсли;

	// одна лесенка на все пути получения пакета: точная версия, имя тега, выражение версии
	Возврат РезолверСпецификации.Разрешить(Пакет, ЗапросФайла.Спецификация, Кандидаты);

КонецФункции

// Из чего хабу разрешено ВЫБИРАТЬ версию. У захваченного имени — только из своих:
// апстримные версии могли осесть в реестре, пока имя ещё не было своим, и отдавать их
// под своим именем — та самая подмена, от которой защищает провенанс (ИСТ-ВЫД-013).
// Правило не зависит от формы запроса: «pkg» и «pkg@stable» обязаны отвечать одинаково.
// Точную координату круг не сужает: её называет клиент, и она достаётся всегда.
Функция КругКандидатов(Знач Пакет)

	Если НЕ ИмяПринадлежитПулу(Пакет) Тогда
		Возврат Неопределено; // чужое имя — выбираем из всего, что о нём знаем
	КонецЕсли;

	Возврат СервисПроисхождения.ТолькоСобственные(СервисВерсий.ВерсииПакета(Пакет.Идентификатор));

КонецФункции

Функция Готово(Знач Версия, Знач Координаты, Знач ВерсиюВыбралХаб)

	Возврат Новый Структура("Найдено, Версия, ПутьКФайлу, ИмяАртефакта, ВерсиюВыбралХаб",
		Истина,
		Версия,
		Хранилище.Получить(Координаты),
		СтрШаблон("%1-%2.ospx", Координаты.Пакет(), Версия.Версия),
		ВерсиюВыбралХаб);

КонецФункции

Функция НеНайдено()

	Возврат Новый Структура("Найдено, Версия, ПутьКФайлу, ИмяАртефакта, ВерсиюВыбралХаб",
		Ложь, Неопределено, "", "", Ложь);

КонецФункции

#КонецОбласти

#Область СписокПакетов

Процедура СобратьИмена(Знач Пул, Знач Аккумулятор)

	// имена, уже проиндексированные в реестре пула
	Для Каждого Пакет Из СервисПакетов.ПакетыПула(Пул.Идентификатор) Цикл
		Если НЕ Пакет.Скрыт Тогда
			ДобавитьИмя(Аккумулятор, Пакет.Имя);
			Аккумулятор.ПоследнееИзменение = Позднее(Аккумулятор.ПоследнееИзменение, Пакет.Создан);
		КонецЕсли;
	КонецЦикла;

	// списки апстримов в порядке опроса: наполнение видно ещё до первых скачиваний
	Апстримы = СервисПулов.АпстримыДляОпроса(Пул);
	Для Каждого Апстрим Из Апстримы Цикл
		Для Каждого Имя Из СервисПрокси.ИменаУпстрима(Пул, Апстрим) Цикл
			ДобавитьИмя(Аккумулятор, Имя);
		КонецЦикла;
	КонецЦикла;
	Если Апстримы.Количество() > 0 Тогда
		Аккумулятор.ПоследнееИзменение = Позднее(Аккумулятор.ПоследнееИзменение, ТекущаяУниверсальнаяДата());
	КонецЕсли;

КонецПроцедуры

// Дедупликация без учёта регистра, первое вхождение сохраняет свой регистр.
Процедура ДобавитьИмя(Знач Аккумулятор, Знач Имя)

	Ключ = НРег(СокрЛП(Имя));
	Если ЗначениеЗаполнено(Ключ) И Аккумулятор.Соответствие.Получить(Ключ) = Неопределено Тогда
		Аккумулятор.Соответствие.Вставить(Ключ, СокрЛП(Имя));
	КонецЕсли;

КонецПроцедуры

Функция Позднее(Знач Первая, Знач Вторая)

	Если НЕ ЗначениеЗаполнено(Вторая) Тогда
		Возврат Первая;
	КонецЕсли;
	Если Первая = Неопределено Тогда
		Возврат Вторая;
	КонецЕсли;
	Возврат ?(Вторая > Первая, Вторая, Первая);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "РезолверСпецификации") _РезолверСпецификации,
	&Пластилин(Значение = "ХранилищеАртефактов") _Хранилище,
	&Пластилин(Значение = "СервисПрокси") _СервисПрокси,
	&Пластилин(Значение = "СервисПроисхождения") _СервисПроисхождения,
	&Лог _Лог = Неопределено)

	Обезличивание = Новый ОбезличиваниеЖурнала();
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	СервисПроисхождения = _СервисПроисхождения;
	СервисВерсий = _СервисВерсий;
	РезолверСпецификации = _РезолверСпецификации;
	Хранилище = _Хранилище;
	СервисПрокси = _СервисПрокси;

КонецПроцедуры
