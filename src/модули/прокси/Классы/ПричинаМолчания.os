// Почему источник не ответил — одной фразой для человека. Одно правило на все точки, где
// исход похода наружу становится причиной: слово о том, что случилось, плюс КОРНЕВАЯ
// причина. Диагностика транспорта приезжает сюда целым блобом со служебной обёрткой
// OneScript, путями внутрь контейнера и номерами строк чужой библиотеки — наружу из этого
// не уходит ничего.

Перем Ошибки;         // ТекстОшибки (основа) — снятие служебной обёртки
Перем Адреса;         // РазборАдреса (основа) — узел адреса без учётных данных
Перем Обезличивание;  // ОбезличиваниеЖурнала (наблюдаемость) — адрес без учётных данных

#Область ПубличныйИнтерфейс

// Причина молчания источника словами.
//
// Параметры:
//  Пояснение - Строка - диагностика транспорта как есть либо уже готовая фраза.
//  Адрес - Строка - адрес источника: из него берутся координаты узла
//          (необязательный, по умолчанию "").
//  ТаймаутСек - Число - сколько хаб ждал ответа; 0 — порог не называется
//               (необязательный, по умолчанию 0).
//
// Возвращаемое значение:
//  Строка - фраза для человека: без координат модулей, номеров строк и путей файловой
//           системы, не длиннее ПределаДлины().
//
Функция Словами(Знач Пояснение, Знач Адрес = "", Знач ТаймаутСек = 0) Экспорт

	Корень = КорневаяПричина(Пояснение);
	Если НЕ ЗначениеЗаполнено(Корень) Тогда
		Возврат "источник не ответил";
	КонецЕсли;

	Примета = НРег(Корень);

	Если Найти(Примета, "цепочка перенаправлений") > 0 Тогда
		Возврат Корень;
	КонецЕсли;

	Если СодержитОдно(Примета, "timed out,timeout,time out,таймаут,время ожидания") Тогда
		Возврат Фразой("таймаут", ОжиданиеСловами(ТаймаутСек));
	КонецЕсли;

	Если СодержитОдно(Примета,
		"no such host,not known,getaddrinfo,name resolution,resolve,dns,неизвестный узел,имя не разрешилось") Тогда
		Возврат "имя не разрешилось: у адреса нет ответа DNS";
	КонецЕсли;

	// доверие к сертификату — не вопрос сети: она в порядке, а чинится это другими руками,
	// поэтому ветка стоит ПЕРЕД отбитым соединением
	Если СодержитОдно(Примета,
		"certificate,сертификат,ssl,tls,trust,доверие") Тогда
		Возврат Фразой("сертификат источника не принят", Узел(Адрес));
	КонецЕсли;

	Если СодержитОдно(Примета,
		"refused,отбито,отказано,unreachable,недоступен,reset,connection closed") Тогда
		Возврат Фразой("соединение отбито", Узел(Адрес));
	КонецЕсли;

	// фраза, уже написанная для человека, второго объяснения не требует
	Возврат ?(НаписаноДляЧеловека(Корень), Корень, Фразой("источник не ответил", Корень));

КонецФункции

// Потолок длины фразы: причина объясняет молчание, а не возит чужую портянку.
//
// Возвращаемое значение:
//  Число - символов.
//
Функция ПределДлины() Экспорт
	Возврат 200;
КонецФункции

#КонецОбласти

#Область КорневаяПричина

// Корневая причина из диагностики транспорта. 1connector дописывает её в хвост блоба
// строками «caused by:», и последняя из них — самая глубокая; там, где их нет, остаётся
// снять служебную обёртку OneScript, вложенную саму в себя.
Функция КорневаяПричина(Знач Пояснение)

	Текст = СокрЛП(Ошибки.Однострочно(?(Пояснение = Неопределено, "", Пояснение)));

	Маркер = "caused by:";
	Позиция = СтрНайти(НРег(Текст), Маркер, НаправлениеПоиска.СКонца);
	Если Позиция > 0 Тогда
		Возврат Корнем(БезХвостовыхСкобок(Сред(Текст, Позиция + СтрДлина(Маркер))));
	КонецЕсли;

	Возврат Корнем(БезОбёртки(Текст));

КонецФункции

// Служебная обёртка «{Модуль … / Error in line: N / текст}» бывает вложена в себя, а за
// её закрывающей скобкой тянется строка исходника — её отрезаем до разбора.
Функция БезОбёртки(Знач Текст)

	Значение = ДоПоследнейСкобки(Текст);

	Для Заход = 1 По 5 Цикл
		Снятое = СокрЛП(Ошибки.БезСлужебного(Значение));
		Если Снятое = Значение Тогда
			Прервать;
		КонецЕсли;
		Значение = ДоПоследнейСкобки(Снятое);
	КонецЦикла;

	Возврат Значение;

КонецФункции

// Корень отдаётся наружу дословно, поэтому учётные данные из адресов внутри него
// вычёркиваются ЗДЕСЬ: память стража обезличивания не знает, а читают её и экран, и API.
Функция Корнем(Знач Текст)
	Возврат Обрезанная(БезУчётныхДанных(Текст));
КонецФункции

// Слово с «://» — адрес, и обезличивается целиком; хвостовая пунктуация фразы адресом
// не является и остаётся при ней.
Функция БезУчётныхДанных(Знач Текст)

	Слова = СтрРазделить(СокрЛП(Строка(Текст)), " ", Истина);
	Для Индекс = 0 По Слова.ВГраница() Цикл
		Если СтрНайти(Слова[Индекс], "://") > 0 Тогда
			Слова[Индекс] = ОбезличенныйАдрес(Слова[Индекс]);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Слова, " ");

КонецФункции

Функция ОбезличенныйАдрес(Знач Слово)

	Хвост = "";
	Тело = Слово;
	Пока ЗначениеЗаполнено(Тело) И Найти(".,;:!?)]}»""'", Прав(Тело, 1)) > 0 Цикл
		Хвост = Прав(Тело, 1) + Хвост;
		Тело = Лев(Тело, СтрДлина(Тело) - 1);
	КонецЦикла;

	Возврат Обезличивание.Адрес(Тело) + Хвост;

КонецФункции

Функция ДоПоследнейСкобки(Знач Текст)

	Если Лев(Текст, 1) <> "{" Тогда
		Возврат Текст;
	КонецЕсли;

	Конец = СтрНайти(Текст, "}", НаправлениеПоиска.СКонца);
	Возврат ?(Конец > 0, СокрЛП(Лев(Текст, Конец)), Текст);

КонецФункции

Функция БезХвостовыхСкобок(Знач Текст)

	Значение = СокрЛП(Текст);
	Пока ЗначениеЗаполнено(Значение) И Прав(Значение, 1) = "}" Цикл
		Значение = СокрЛП(Лев(Значение, СтрДлина(Значение) - 1));
	КонецЦикла;
	Возврат Значение;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Написан ли текст для человека: корень, в котором не осталось ни обёртки платформы,
// ни имени типа исключения, объяснять второй раз незачем.
Функция НаписаноДляЧеловека(Знач Текст)

	Для Каждого Примета Из СтрРазделить(СлужебныеПриметы(), ",", Ложь) Цикл
		Если Найти(НРег(Текст), Примета) > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Кириллица(Текст);

КонецФункции

// По чему видно, что текст собран не для человека: обёртка платформы, внутренности
// контейнера, путь файловой системы, имя типа исключения.
Функция СлужебныеПриметы()
	Возврат "{модуль,error in line,ошибка в строке,caused by,oscript_modules,"
		+ "внешнее исключение,exception,/src/,.os";
КонецФункции

Функция Кириллица(Знач Текст)

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если Найти("абвгдежзийклмнопрстуфхцчшщъыьэюя", НРег(Сред(Текст, Позиция, 1))) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция Фразой(Знач Слово, Знач Хвост)
	Возврат ?(ЗначениеЗаполнено(Хвост), Слово + ": " + Обрезанная(Хвост), Слово);
КонецФункции

// Узел адреса — «хост:порт» без учётных данных: значению токена в причине не место.
Функция Узел(Знач Адрес)
	Возврат Адреса.Узел(Адрес);
КонецФункции

Функция СодержитОдно(Знач Текст, Знач Образцы)

	Для Каждого Образец Из СтрРазделить(Образцы, ",", Ложь) Цикл
		Если Найти(Текст, Образец) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция Обрезанная(Знач Текст)

	Значение = СокрЛП(Строка(Текст));
	Если СтрДлина(Значение) <= ПределДлины() Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Лев(Значение, ПределДлины() - 1) + "…";

КонецФункции

// Порог ожидания называется, только если вызывающий его знает: выдумывать чужое число
// хуже, чем промолчать о нём.
Функция ОжиданиеСловами(Знач ТаймаутСек)

	Если Цел(ТаймаутСек) <= 0 Тогда
		Возврат "источник не ответил";
	КонецЕсли;

	Возврат СтрШаблон("источник не ответил за %1 с", Формат(Цел(ТаймаутСек), "ЧГ=0; ЧН=0"));

КонецФункции

#КонецОбласти

&Прозвище("ПричинаМолчания")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
	// без внедрений: правило зовут и страж, и проба, и обе создают его напрямую там,
	// где контейнера под рукой нет
	Ошибки = Новый ТекстОшибки();
	Адреса = Новый РазборАдреса();
	Обезличивание = Новый ОбезличиваниеЖурнала();
КонецПроцедуры
