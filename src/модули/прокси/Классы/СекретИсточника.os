// Правило токена доступа к внешнему источнику в одном месте: приём маски, предъявление
// заголовком авторизации, отзыв при уходе запроса с узла источника и отпечаток доступа.

Перем ИмяЗаголовка;

#Область ПубличныйИнтерфейс

// Задан ли токен.
//
// Параметры:
//  Токен - Строка, Неопределено - значение токена.
//
// Возвращаемое значение:
//  Булево.
//
Функция Задан(Знач Токен) Экспорт
	Возврат ЗначениеЗаполнено(Нормализованный(Токен));
КонецФункции

// Токен источника, если он у записи есть. Запись без колонки токена читается как
// анонимный источник — таковы, например, заглушки источников в наборах.
//
// Параметры:
//  Источник - АпстримПула, ЗеркалоХаба, Неопределено - запись источника.
//
// Возвращаемое значение:
//  Строка - токен либо пустая строка.
//
Функция ИзИсточника(Знач Источник) Экспорт

	Если Источник = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат Нормализованный(Источник.ТокенДоступа);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Как токен называется в журнале: в строку лога едет факт, а не значение.
//
// Параметры:
//  Токен - Строка, Неопределено - значение токена.
//
// Возвращаемое значение:
//  Строка.
//
Функция ДляЖурнала(Знач Токен) Экспорт
	Возврат ?(Задан(Токен), "задан", "не задан");
КонецФункции

// Значение токена после ввода: пустое поле и маска означают «оставить прежний»,
// иначе принимается введённое. Годность нового значения проверяется здесь же.
//
// Параметры:
//  Введённое - Строка, Неопределено - то, что пришло формой либо телом запроса.
//  Прежний - Строка, Неопределено - токен, который уже записан у источника.
//
// Возвращаемое значение:
//  Строка - токен, который следует записать.
//
// Выбрасывает исключение, если введённое значение непригодно как заголовок авторизации.
//
Функция ПринятьВвод(Знач Введённое, Знач Прежний) Экспорт

	Значение = Нормализованный(Введённое);
	Если Значение = Маска() ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Нормализованный(Прежний);
	КонецЕсли;

	ПроверитьПригодность(Значение);
	Возврат Значение;

КонецФункции

// Предъявляет токен запросу к источнику. Незаданный токен не добавляет заголовка:
// источник опрашивается анонимно, как до появления токенов.
//
// Параметры:
//  Заголовки - Соответствие - заголовки запроса, в которые добавляется авторизация.
//  Токен - Строка, Неопределено - значение токена.
//
Процедура Предъявить(Заголовки, Знач Токен) Экспорт

	Значение = Нормализованный(Токен);
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;

	Заголовки.Вставить(ИмяЗаголовка, "Bearer " + Значение);

КонецПроцедуры

// Отпечаток доступа: им один доступ к адресу отличается от другого там, где значение
// токена хранить нельзя (память процесса, ключи карт). Необратим и одинаков для
// одинаковых токенов; у анонимного доступа пуст.
//
// Параметры:
//  Токен - Строка, Неопределено - значение токена.
//
// Возвращаемое значение:
//  Строка - пусто у анонимного доступа, иначе короткий hex.
//
Функция Отпечаток(Знач Токен) Экспорт

	Значение = Нормализованный(Токен);
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(Значение);
	Возврат Лев(НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма)), 16);

КонецФункции

// Означает ли ответ источника «не пустил»: вопрос доступа, а не отсутствие пакета
// и не молчание источника.
//
// Параметры:
//  Код - Число - HTTP-код ответа источника.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоОтказДоступа(Знач Код) Экспорт
	Возврат Цел(Код) = 401 ИЛИ Цел(Код) = 403;
КонецФункции

// Копия заголовков без токена — для запроса, уходящего на другой узел: токен выдан
// одним хостом и чужому не предъявляется.
//
// Параметры:
//  Заголовки - Соответствие, Неопределено - заголовки запроса.
//
// Возвращаемое значение:
//  Соответствие - заголовки без авторизации.
//
Функция Отозвать(Знач Заголовки) Экспорт

	Результат = Новый Соответствие();
	Если Заголовки = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого КиЗ Из Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) <> ВРег(ИмяЗаголовка) Тогда
			Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Значение заголовка ограничено печатной латиницей: перевод строки внутри токена — подделка.
Процедура ПроверитьПригодность(Знач Значение)

	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Позиция);
		Если Код < 33 ИЛИ Код > 126 Тогда
			ВызватьИсключение
				"Токен доступа к источнику состоит из печатных символов латиницы без пробелов:"
				+ " он едет к источнику заголовком авторизации";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Маска нужна лишь затем, чтобы узнать её в пришедшем обратно вводе; наружу не отдаётся.
Функция Маска()
	Возврат "•••";
КонецФункции

Функция Нормализованный(Знач Значение)
	Возврат СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
КонецФункции

#КонецОбласти

&Прозвище("СекретИсточника")
&Желудь
Процедура ПриСозданииОбъекта()
	ИмяЗаголовка = "Authorization";
КонецПроцедуры
