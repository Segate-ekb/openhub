// Память хаба о том, жив ли источник. Пока источник числится лежащим, запросы к нему
// не отправляются вовсе: ни выдачей, ни зеркалом. Заполняют память два источника —
// регулярная проверка (фоновыеЗадания/ЗадачаЗдоровьяИсточников) и боевой запрос, честно оплативший
// один таймаут. Отметка живёт oshub.proxy.upstream.recheck.ttl.sec: протухшая означает
// «неизвестно», и источник получает свой честный шанс.
// Ручной тумблер источника этой памятью не переключается — это две независимые вещи.

Перем Настройки;   // СервисНастроек (настройки) — срок жизни отметки
Перем Отметки;     // Соответствие: адрес источника → Структура(Живой, Причина, Проверено)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Можно ли обращаться к источнику прямо сейчас.
//
// Параметры:
//  Апстрим - АпстримПула, ЗеркалоХаба, Неопределено - источник; берётся его адрес.
//
// Возвращаемое значение:
//  Булево - Ложь, если источник числится лежащим.
//
Функция Допустим(Знач Апстрим) Экспорт
	Возврат СостояниеПоАдресу(АдресИсточника(Апстрим)).Живой;
КонецФункции

// Причина, по которой к источнику не ходят.
//
// Параметры:
//  Апстрим - АпстримПула, ЗеркалоХаба, Неопределено - источник.
//
// Возвращаемое значение:
//  Строка - причина либо пустая строка, если источник опрашивается.
//
Функция ПричинаОтказа(Знач Апстрим) Экспорт
	Состояние = СостояниеПоАдресу(АдресИсточника(Апстрим));
	Возврат ?(Состояние.Живой, "", Состояние.Причина);
КонецФункции

// Проверяет источник и при отказе пишет в лог единую для всех точек выдачи формулировку:
// «лежит» не выдаётся за «пакета нет».
//
// Параметры:
//  Апстрим - АпстримПула, ЗеркалоХаба, Неопределено - источник.
//
// Возвращаемое значение:
//  Булево - Истина, если обращение разрешено.
//
Функция Пропустить(Знач Апстрим) Экспорт

	Адрес = АдресИсточника(Апстрим);
	Состояние = СостояниеПоАдресу(Адрес);
	Если Состояние.Живой Тогда
		Возврат Истина;
	КонецЕсли;

	Лог.Предупреждение(
		"Источник ""%1"" числится лежащим с %2, поэтому не опрашивается: %3."
		+ " Он остаётся в настройках и вернётся в работу сам, когда снова ответит.",
		Адрес, Формат(Состояние.Проверено, "ДФ='yyyy-MM-dd HH:mm:ss'"), Состояние.Причина);
	Возврат Ложь;

КонецФункции

// Состояние источника для экрана: жив, лежит либо ещё не проверялся.
//
// Параметры:
//  Апстрим - АпстримПула, ЗеркалоХаба, Строка, Неопределено - источник либо его адрес.
//
// Возвращаемое значение:
//  Структура - Известно (Булево, источник хотя бы раз проверяли), Живой (Булево),
//              Причина (Строка), Проверено (Дата, момент последней проверки).
//
Функция Состояние(Знач Апстрим) Экспорт
	Возврат СостояниеПоАдресу(?(ТипЗнч(Апстрим) = Тип("Строка"),
		Строка(Апстрим), АдресИсточника(Апстрим)));
КонецФункции

// Запоминает, что источник ответил.
//
// Параметры:
//  Адрес - Строка - адрес источника.
//
Процедура ОтметитьЖивым(Знач Адрес) Экспорт
	Запомнить(Адрес, Истина, "");
КонецПроцедуры

// Запоминает, что источник не ответил: следующие запросы к нему не отправляются.
//
// Параметры:
//  Адрес - Строка - адрес источника.
//  Причина - Строка - что именно не получилось.
//
Процедура ОтметитьЛежащим(Знач Адрес, Знач Причина) Экспорт
	Запомнить(Адрес, Ложь, Причина);
КонецПроцедуры

// Забывает всё, что известно о живости источников — при смене настроек и в тестах.
//
Процедура Забыть() Экспорт
	Отметки = Новый Соответствие();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СостояниеПоАдресу(Знач Адрес)

	Ключ = Ключ_(Адрес);
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат Неизвестно();
	КонецЕсли;

	Запись = Отметки.Получить(Ключ);
	Если Запись = Неопределено Тогда
		Возврат Неизвестно();
	КонецЕсли;

	// протухшая отметка — это «неизвестно»: источник получает свой честный запрос.
	// Нулевой срок означает «не помнить вовсе»: каждая проверка начинается с чистого листа.
	Если ТекущаяУниверсальнаяДата() - Запись.Проверено >= ВремяЖизни() Тогда
		Возврат Неизвестно();
	КонецЕсли;

	Возврат Новый Структура("Известно, Живой, Причина, Проверено",
		Истина, Запись.Живой, Запись.Причина, Запись.Проверено);

КонецФункции

// Карта присваивается целиком и последним: гонящийся поток обязан видеть либо прежнюю
// карту, либо полностью готовую новую (ленивая публикация полупустого состояния).
Процедура Запомнить(Знач Адрес, Знач Живой, Знач Причина)

	Ключ = Ключ_(Адрес);
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;

	Запись = Новый Структура("Живой, Причина, Проверено",
		Живой = Истина, Строка(Причина), ТекущаяУниверсальнаяДата());

	Если Отметки.Получить(Ключ) <> Неопределено Тогда
		Отметки.Вставить(Ключ, Запись); // перезапись значения существующего ключа безопасна
		Возврат;
	КонецЕсли;

	Новая = Новый Соответствие();
	Для Каждого КиЗ Из Отметки Цикл
		Новая.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Новая.Вставить(Ключ, Запись);
	Отметки = Новая;

КонецПроцедуры

Функция АдресИсточника(Знач Апстрим)

	Если Апстрим = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат Строка(Апстрим.Url);
	Исключение
		// зеркало держит адрес источника в своём поле
	КонецПопытки;

	Попытка
		Возврат Строка(Апстрим.АпстримURL);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция Ключ_(Знач Адрес)
	Возврат НРег(СокрЛП(Строка(Адрес)));
КонецФункции

Функция Неизвестно()
	Возврат Новый Структура("Известно, Живой, Причина, Проверено",
		Ложь, Истина, "", '00010101000000');
КонецФункции

// Срок памяти о живости спрашивается на проверке: опущенный из формы TTL начинает
// действовать со следующего же обращения.
Функция ВремяЖизни()
	Возврат Макс(0, Цел(Настройки.Значение("oshub.proxy.upstream.recheck.ttl.sec")));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Лог _Лог = Неопределено)

	Настройки = _Настройки;
	Отметки = Новый Соответствие();

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
