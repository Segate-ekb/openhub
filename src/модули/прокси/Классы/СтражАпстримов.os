// Память хаба о том, жив ли источник: пока источник числится лежащим, запросы к нему
// не отправляются вовсе. Живость — свойство адреса, «не пустил» — свойство доступа.

Перем Настройки;   // СервисНастроек (настройки) — срок жизни отметки
Перем Секрет;      // СекретИсточника (прокси) — отпечаток доступа и токен записи
Перем Адреса;      // АдресаИсточников (прокси) — где у записи адрес и каким он ключом
Перем Причины;     // ПричинаМолчания (прокси) — диагностика транспорта фразой для человека
Перем Таймауты;    // ТаймаутыHTTP (сеть) — сколько хаб ждёт источник
Перем Живость;     // Соответствие: адрес → Структура(Живой, Причина, Проверено)
Перем Отказы;      // Соответствие: адрес + отпечаток доступа → Структура(Причина, Проверено)
Перем Письмо;      // ЛетописьИсточников (прокси) — письменный двойник памяти; Неопределено
                   // означает «память живёт только до перезапуска»
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Можно ли обращаться к источнику прямо сейчас.
//
// Параметры:
//  Апстрим - АпстримПула, ЗеркалоХаба, Неопределено - источник; берётся его адрес.
//
// Возвращаемое значение:
//  Булево - Ложь, если источник числится лежащим.
//
Функция Допустим(Знач Апстрим) Экспорт
	Возврат ЖивостьПоАдресу(Адреса.Источника(Апстрим)).Живой;
КонецФункции

// Причина, по которой к источнику не ходят.
//
// Параметры:
//  Апстрим - АпстримПула, ЗеркалоХаба, Неопределено - источник.
//
// Возвращаемое значение:
//  Строка - причина либо пустая строка, если источник опрашивается.
//
Функция ПричинаОтказа(Знач Апстрим) Экспорт
	Состояние = ЖивостьПоАдресу(Адреса.Источника(Апстрим));
	Возврат ?(Состояние.Живой, "", Состояние.Причина);
КонецФункции

// Проверяет источник и при отказе пишет в лог единую для всех точек выдачи формулировку:
// «лежит» не выдаётся за «пакета нет».
//
// Параметры:
//  Апстрим - АпстримПула, ЗеркалоХаба, Неопределено - источник.
//
// Возвращаемое значение:
//  Булево - Истина, если обращение разрешено.
//
Функция Пропустить(Знач Апстрим) Экспорт

	Адрес = Адреса.Источника(Апстрим);
	Состояние = ЖивостьПоАдресу(Адрес);
	Если Состояние.Живой Тогда
		Возврат Истина;
	КонецЕсли;

	Лог.Предупреждение(
		"Источник ""%1"" числится лежащим с %2, поэтому не опрашивается: %3."
		+ " Он остаётся в настройках и вернётся в работу сам, когда снова ответит.",
		Адрес, Формат(Состояние.Проверено, "ДФ='yyyy-MM-dd HH:mm:ss'"), Состояние.Причина);
	Возврат Ложь;

КонецФункции

// Состояние источника для экрана: жив, лежит, не пустил либо ещё не проверялся.
// Лежащий адрес показывается лежащим независимо от прошлых отказов: молчание источника —
// факт более крупный, чем вопрос доступа к нему.
//
// Параметры:
//  Апстрим - АпстримПула, ЗеркалоХаба, Строка, Неопределено - источник либо его адрес;
//            у строки доступ считается анонимным.
//
// Возвращаемое значение:
//  Структура - Известно (Булево, источник хотя бы раз проверяли), Живой (Булево),
//              ОтказДоступа (Булево, источник ответил, но этот доступ не пустил),
//              Причина (Строка), Проверено (Дата, момент последней проверки).
//
Функция Состояние(Знач Апстрим) Экспорт

	ЭтоАдрес = (ТипЗнч(Апстрим) = Тип("Строка"));
	Адрес = Адреса.Источника(Апстрим);
	Доступ = ?(ЭтоАдрес, "", Секрет.ИзИсточника(Апстрим));

	Жив = ЖивостьПоАдресу(Адрес);
	Если НЕ Жив.Живой Тогда
		Возврат Слепок(Жив.Известно, Ложь, Ложь, Жив.Причина, Жив.Проверено);
	КонецЕсли;

	Отказ = ОтказПоДоступу(Адрес, Доступ);
	Если Отказ = Неопределено Тогда
		Возврат Слепок(Жив.Известно, Истина, Ложь, Жив.Причина, Жив.Проверено);
	КонецЕсли;

	Возврат Слепок(Истина, Истина, Истина, Отказ.Причина, Отказ.Проверено);

КонецФункции

// Запоминает, что источник ответил и пустил.
//
// Параметры:
//  Адрес - Строка - адрес источника.
//  Токен - Строка - токен доступа, которым ходили; пусто — анонимно
//          (необязательный, по умолчанию "").
//
Процедура ОтметитьЖивым(Знач Адрес, Знач Токен = "") Экспорт

	ЗапомнитьЖивость(Адрес, Истина, "");
	ЗабытьОтказ(Адрес, Токен);

	Если Письмо <> Неопределено Тогда
		Письмо.Ответил(Адрес);
	КонецЕсли;

КонецПроцедуры

// Запоминает, что источник не ответил: следующие запросы к нему не отправляются.
//
// Параметры:
//  Адрес - Строка - адрес источника.
//  Причина - Строка - что именно не получилось.
//  Токен - Строка - токен доступа, которым ходили; пусто — анонимно
//          (необязательный, по умолчанию "").
//
Процедура ОтметитьЛежащим(Знач Адрес, Знач Причина, Знач Токен = "") Экспорт

	// граница стража — единственное место, где диагностика транспорта становится фразой:
	// в память, в письменный двойник и на экран уходит одна и та же нормализованная причина
	Словами = Причины.Словами(Причина, Адрес, Таймауты.ТаймаутАпстрима(Настройки));

	ЗапомнитьЖивость(Адрес, Ложь, Словами);
	ЗабытьОтказ(Адрес, Токен);

	Если Письмо <> Неопределено Тогда
		Письмо.Лежит(Адрес, Словами, Токен);
	КонецЕсли;

КонецПроцедуры

// Запоминает, что источник ответил, но ЭТОТ доступ не пустил. Запросы к адресу продолжают
// отправляться: отвечающий источник жив, а доступ решает токен каждого источника
// в отдельности — соседний источник с тем же адресом от чужого отказа не страдает.
//
// Параметры:
//  Адрес - Строка - адрес источника.
//  Причина - Строка - чем именно источник ответил.
//  Токен - Строка - токен доступа, которому отказали; пусто — анонимно
//          (необязательный, по умолчанию "").
//
Процедура ОтметитьНеПустившим(Знач Адрес, Знач Причина, Знач Токен = "") Экспорт

	ЗапомнитьЖивость(Адрес, Истина, "");

	Ключ = КлючДоступа(Адрес, Токен);
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;

	Лог.Отладка("Страж источников: ""%1"" не пустил этот доступ, причина: ""%2""", Адрес, Причина);
	Отказы = СКлючом(Отказы, Ключ,
		Новый Структура("Причина, Проверено", Строка(Причина), ТекущаяУниверсальнаяДата()));

	Если Письмо <> Неопределено Тогда
		Письмо.НеПустил(Адрес, Причина, Токен);
	КонецЕсли;

КонецПроцедуры

// Забывает всё, что известно о живости источников и об отказах доступа. Продукт этого
// не делает — сбрасывают память наборы, каждый перед своим тестом. Написанное в базу
// не стирается: забывается лишь то, что о нём помнит процесс, и первая же отметка
// сверит письменную память заново.
//
Процедура Забыть() Экспорт

	Живость = Новый Соответствие();
	Отказы = Новый Соответствие();

	Если Письмо <> Неопределено Тогда
		Письмо.Забыть();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЖивостьПоАдресу(Знач Адрес)

	Запись = Свежая(Живость, Адреса.Ключом(Адрес), Адрес);
	Если Запись = Неопределено Тогда
		Возврат Новый Структура("Известно, Живой, Причина, Проверено",
			Ложь, Истина, "", '00010101000000');
	КонецЕсли;

	Возврат Новый Структура("Известно, Живой, Причина, Проверено",
		Истина, Запись.Живой, Запись.Причина, Запись.Проверено);

КонецФункции

Функция ОтказПоДоступу(Знач Адрес, Знач Токен)
	Возврат Свежая(Отказы, КлючДоступа(Адрес, Токен), Адрес);
КонецФункции

// Протухшая отметка — это «неизвестно»; нулевой срок означает «не помнить вовсе».
Функция Свежая(Знач Карта, Знач Ключ, Знач Адрес)

	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запись = Карта.Получить(Ключ);
	Если Запись = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПрошлоСек = ТекущаяУниверсальнаяДата() - Запись.Проверено;
	СрокПамятиСек = ВремяЖизни();
	Если ПрошлоСек >= СрокПамятиСек Тогда
		Лог.Отладка("Страж источников: отметка о ""%1"" протухла (ей %2 с при сроке %3 с)"
			+ " — источник получает честный запрос", Адрес, ПрошлоСек, СрокПамятиСек);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Запись;

КонецФункции

Процедура ЗапомнитьЖивость(Знач Адрес, Знач Живой, Знач Причина)

	Ключ = Адреса.Ключом(Адрес);
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат;
	КонецЕсли;

	Лог.Отладка("Страж источников: ""%1"" отмечен как %2, причина: ""%3""",
		Адрес, ?(Живой = Истина, "живой", "лежащий"), Причина);
	Живость = СКлючом(Живость, Ключ, Новый Структура("Живой, Причина, Проверено",
		Живой = Истина, Строка(Причина), ТекущаяУниверсальнаяДата()));

КонецПроцедуры

// Пустивший доступ прошлого отказа за собой не тянет: иначе экран показывал бы «не пустил».
Процедура ЗабытьОтказ(Знач Адрес, Знач Токен)

	Ключ = КлючДоступа(Адрес, Токен);
	Если НЕ ЗначениеЗаполнено(Ключ) ИЛИ Отказы.Получить(Ключ) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Новая = Новый Соответствие();
	Для Каждого КиЗ Из Отказы Цикл
		Если КиЗ.Ключ <> Ключ Тогда
			Новая.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Отказы = Новая;

КонецПроцедуры

// Карта присваивается целиком и последним: гонящийся поток не увидит полупустого состояния.
Функция СКлючом(Знач Карта, Знач Ключ, Знач Запись)

	Если Карта.Получить(Ключ) <> Неопределено Тогда
		Карта.Вставить(Ключ, Запись); // перезапись значения существующего ключа безопасна
		Возврат Карта;
	КонецЕсли;

	Новая = Новый Соответствие();
	Для Каждого КиЗ Из Карта Цикл
		Новая.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Новая.Вставить(Ключ, Запись);
	Возврат Новая;

КонецФункции

// Ключ отказа — адрес и отпечаток доступа: значение токена в памяти процесса не живёт.
Функция КлючДоступа(Знач Адрес, Знач Токен)
	Ключ = Адреса.Ключом(Адрес);
	Возврат ?(ЗначениеЗаполнено(Ключ), Ключ + "|" + Секрет.Отпечаток(Токен), "");
КонецФункции

Функция Слепок(Знач Известно, Знач Живой, Знач ОтказДоступа, Знач Причина, Знач Проверено)
	Возврат Новый Структура("Известно, Живой, ОтказДоступа, Причина, Проверено",
		Известно, Живой, ОтказДоступа, Причина, Проверено);
КонецФункции

// Спрашивается на проверке: опущенный из формы TTL действует со следующего же обращения.
Функция ВремяЖизни()
	Возврат Настройки.Целое("oshub.proxy.upstream.recheck.ttl.sec", 0);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "СекретИсточника") _Секрет = Неопределено,
	&Пластилин(Значение = "ЛетописьИсточников") _Письмо = Неопределено,
	&Пластилин(Значение = "АдресаИсточников") _Адреса = Неопределено,
	&Пластилин(Значение = "ПричинаМолчания") _Причины = Неопределено,
	&Пластилин(Значение = "ТаймаутыHTTP") _Таймауты = Неопределено)

	Настройки = _Настройки;
	Секрет = ?(_Секрет = Неопределено, Новый СекретИсточника(), _Секрет);
	Письмо = _Письмо;
	Адреса = ?(_Адреса = Неопределено, Новый АдресаИсточников(), _Адреса);
	Причины = ?(_Причины = Неопределено, Новый ПричинаМолчания(), _Причины);
	Таймауты = ?(_Таймауты = Неопределено, Новый ТаймаутыHTTP(), _Таймауты);
	Живость = Новый Соответствие();
	Отказы = Новый Соответствие();

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
