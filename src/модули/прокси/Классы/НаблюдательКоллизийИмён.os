// Подписчик события «версия опубликована»: замечает, что опубликованное имя уже занято
// на апстриме пула, и сообщает об этом в лог и событием «коллизия.имени.апстрима» для аудита.
// С момента публикации имя принадлежит пулу: свой пакет и свой latest апстримом не
// перекрываются, апстримные версии остаются доступны по точной координате.
// Сети на пути публикации нет: список апстрима берётся только из свежего TTL-кэша,
// иначе диагностика молча пропускается. Любая ошибка внутри гасится.

Перем СервисПулов;    // СервисПулов (реестр)
Перем Готовность;   // ГотовностьХаба (наблюдаемость)
Перем СервисПакетов;  // СервисПакетов (реестр)
Перем СервисВерсий;   // СервисВерсий (реестр)
Перем Провенанс;      // СервисПроисхождения (реестр)
Перем СервисПрокси;   // СервисПрокси (прокси)
Перем Издатель;       // ИздательСобытий (события)
Перем ИменаЖурнала;          // ИмяОбъектаАудита (аудит) — вид объекта в журнале
&Лог
Перем Лог;

#Область КонтрактПодписчикаСобытий

// Реагирует на публикацию версии — контракт подписчика ИздателяСобытий.
//
// Параметры:
//  Событие - Структура - Тип (Строка), Когда (Дата), Данные (Структура с ИмяПакета,
//            ПулИдентификатор, Версия, Кто, АдресIP).
//
Процедура ОбработатьСобытие(Знач Событие) Экспорт

	Попытка
		ПроверитьКоллизию(Событие.Данные);
	Исключение
		Лог.Предупреждение("Диагностика коллизии имени пропущена: %1",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ПубличныйИнтерфейс

// Точка входа рогатки: подписывает наблюдателя на событие публикации и закрывает гейт
// готовности. Подписка в стартовом хуке, а не в конструкторе: желуди ОСень инстанцирует лениво.
//
Процедура ПриЗапускеПриложения() Экспорт
	Издатель.Подписать(Издатель.ТипВерсияОпубликована(), ЭтотОбъект);
	// Гейт закрывается последней строкой и без Попытка: сбой выше оставит /ready в 503
	Готовность.ОтметитьЗадачуВыполненной("proxy.наблюдатель-коллизий");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьКоллизию(Знач Данные)

	ИмяПакета = Поле(Данные, "ИмяПакета", "");
	ПулИдентификатор = Поле(Данные, "ПулИдентификатор", 0);
	Если НЕ ЗначениеЗаполнено(ИмяПакета) ИЛИ НЕ ЗначениеЗаполнено(ПулИдентификатор) Тогда
		Возврат;
	КонецЕсли;

	Пул = СервисПулов.ПулПоИдентификатору(ПулИдентификатор);
	Если Пул = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Апстримы = СервисПулов.АпстримыПула(ПулИдентификатор);
	Если Апстримы.Количество() = 0 Тогда
		Возврат; // пул без апстримов — коллизии не с кем ловить
	КонецЕсли;

	Если НЕ ЭтоПерваяСвояВерсия(Пул, ИмяПакета) Тогда
		Возврат; // имя захвачено раньше, диагностика уже была
	КонецЕсли;

	Для Каждого Апстрим Из Апстримы Цикл
		Если ИмяЕстьНаАпстриме(Пул, Апстрим, ИмяПакета) Тогда
			СообщитьОКоллизии(Данные, Пул, Апстрим, ИмяПакета);
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Считаются только собственные версии: у ранее проксировавшегося имени апстримных
// сколько угодно, а захватывает имя именно первая своя публикация.
Функция ЭтоПерваяСвояВерсия(Знач Пул, Знач ИмяПакета)

	Пакет = СервисПакетов.НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Если Пакет = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Собственные = Провенанс.ТолькоСобственные(СервисВерсий.ВерсииПакета(Пакет.Идентификатор));
	Возврат Собственные.Количество() = 1;

КонецФункции

// Нет свежего кэша — Ложь: за списком в сеть с пути публикации не ходим.
Функция ИмяЕстьНаАпстриме(Знач Пул, Знач Апстрим, Знач ИмяПакета)

	Имена = СервисПрокси.ИменаУпстримаИзКэша(Пул, Апстрим);
	Если Имена = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Искомое = НРег(СокрЛП(ИмяПакета));
	Для Каждого Имя Из Имена Цикл
		Если НРег(СокрЛП(Строка(Имя))) = Искомое Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура СообщитьОКоллизии(Знач Данные, Знач Пул, Знач Апстрим, Знач ИмяПакета)

	Версия = Поле(Данные, "Версия", "");

	Лог.Предупреждение(
		"Имя пакета ""%1"" уже присутствует на апстриме %2 пула ""%3"": публикация %1 %4 захватывает имя —"
		+ " свой пакет и его latest больше не берутся с апстрима (апстримные версии остаются доступными по точной версии)",
		ИмяПакета, Апстрим.Url, Пул.Имя, Версия);

	Событие = Новый Структура();
	Событие.Вставить("Кто", Поле(Данные, "Кто", "anonymous"));
	Событие.Вставить("Действие", "коллизия.имени.апстрима");
	Событие.Вставить("Объект", ИменаЖурнала.ПакетПоИменам(Пул.Имя, ИмяПакета));
	Событие.Вставить("ДеталиJSON", ДеталиJSON(Пул, Апстрим, ИмяПакета, Версия));
	Событие.Вставить("АдресIP", Поле(Данные, "АдресIP", ""));

	Издатель.Опубликовать(Издатель.ТипКоллизияИмениАпстрима(), Событие);

КонецПроцедуры

Функция ДеталиJSON(Знач Пул, Знач Апстрим, Знач ИмяПакета, Знач Версия)

	Детали = Новый Структура();
	Детали.Вставить("пул", Пул.Имя);
	Детали.Вставить("пакет", ИмяПакета);
	Детали.Вставить("версия", Версия);
	Детали.Вставить("апстрим", Апстрим.Url);

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Детали);
	Возврат Запись.Закрыть();

КонецФункции

Функция Поле(Знач Данные, Знач Имя, Знач ПоУмолчанию)
	Значение = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

#КонецОбласти

// Параметр _Лог — второй вход для прямого создания через `Новый` вне контейнера ОСени:
// инъекция в поле до таких объектов не доезжает.
&Рогатка
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисПроисхождения") _Провенанс,
	&Пластилин(Значение = "СервисПрокси") _СервисПрокси,
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "ИмяОбъектаАудита") _Имена,
	&Пластилин(Значение = "ГотовностьХаба") _Готовность,
	&Лог _Лог = Неопределено)

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;
	Провенанс = _Провенанс;
	СервисПрокси = _СервисПрокси;
	Издатель = _Издатель;
	ИменаЖурнала = _Имена;
	Готовность = _Готовность;
	// Заявка в конструкторе: список гейтов должен быть полон до первого запуска рогаток
	Готовность.ЗаявитьЗадачу("proxy.наблюдатель-коллизий");

КонецПроцедуры
