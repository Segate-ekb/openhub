// Сквозное скачивание с кэшированием для пары «пул + ОДИН его апстрим» и ленивая индексация
// скачанного. Порядок опроса апстримов и приоритет своих пакетов — выше, в РезолверВыдачи.

Перем СервисПакетов;  // СервисПакетов (реестр)
Перем СервисВерсий;   // СервисВерсий (реестр)
Перем Приём;          // ПриёмВерсии (реестр)
Перем Сверка;         // СверкаETag (прокси)
Перем Правила;        // ПравилаИменования (реестр)
Перем Хранилище;      // ХранилищеАртефактов (хранилище)
Перем Клиент;         // КлиентАпстрима (прокси)
Перем Секрет;         // СекретИсточника (прокси) — токен источника и разбор отказа доступа
Перем Страж;          // СтражАпстримов (прокси)
Перем Кэш;            // КэшИзменяемыхРесурсов (прокси)
Перем Занятое;        // ЗаписьЗанятогоМеста (реестр)
Перем Настройки;      // СервисНастроек (настройки) — офлайн и TTL негативного кэша
Перем Allowlist;      // СписокРазрешённыхИмён (реестр) — маски имён у источника
&Лог
Перем Лог;
Перем Ошибки;      // ТекстОшибки (основа)
Перем Уборка;         // ТихаяУборка (основа)

#Область ПубличныйИнтерфейс

// Обеспечивает наличие точной версии пакета в кэше пула: при кэш-хите ничего не делает,
// иначе скачивает с апстрима, валидирует, сохраняет артефакт и лениво индексирует метаданные.
//
// Параметры:
//  Пул - Пул - пул, в кэш которого забирается артефакт.
//  Апстрим - АпстримПула - опрашиваемый апстрим пула.
//  ИмяПакета - Строка - имя пакета.
//  СтрокаВерсии - Строка - точная строка версии, как в имени файла апстрима.
//
// Возвращаемое значение:
//  Булево - Истина, если версия доступна в кэше; Ложь при 404, недоступности апстрима,
//           запрете allowlist, битом артефакте и offline-промахе.
//
Функция ОбеспечитьВерсию(Знач Пул, Знач Апстрим, Знач ИмяПакета, Знач СтрокаВерсии) Экспорт

	Лог.Отладка("Прокси: пул ""%1"" спрашивает %2-%3", Пул.Имя, ИмяПакета, СтрокаВерсии);

	// имя проверяется до формирования пути, чтобы "../" не задало иной путь на апстрим-хосте
	Если НЕ Правила.ИмяКорректно(ИмяПакета) Тогда
		Лог.Отладка("Прокси: имя ""%1"" не проходит правила именования — наружу не идём", ИмяПакета);
		Возврат Ложь;
	КонецЕсли;

	Координаты = БезопасныеКоординаты(Пул.Имя, ИмяПакета, СтрокаВерсии);
	Если Координаты = Неопределено Тогда
		Лог.Отладка("Прокси: версия ""%1"" недопустима как сегмент пути — наружу не идём", СтрокаВерсии);
		Возврат Ложь; // недопустимая строка версии
	КонецЕсли;

	Если Хранилище.Существует(Координаты) Тогда
		Лог.Отладка("Прокси: %1-%2 уже в кэше пула ""%3"" — апстрим не опрашивается",
			ИмяПакета, СтрокаВерсии, Пул.Имя);
		Возврат Истина;
	КонецЕсли;

	Если Апстрим = Неопределено Тогда
		Лог.Отладка("Прокси: апстрим не задан — %1-%2 качать неоткуда", ИмяПакета, СтрокаВерсии);
		Возврат Ложь;
	КонецЕсли;
	Если НЕ РазрешеноИмя(Апстрим, ИмяПакета) Тогда
		Лог.Отладка("Прокси: имя ""%1"" не пропущено allowlist апстрима %2 — не качаем",
			ИмяПакета, Апстрим.Url);
		Возврат Ложь;
	КонецЕсли;

	// TTL негатива и режим offline читаются один раз: аргумент отладочной строки — значение
	// под рукой, а не второй поход в настройки на каждый запрос
	ТТЛНегатива = НегативныйTTL();
	КлючНегатива = "neg|" + КлючАпстрима(Пул, Апстрим) + "|" + НРег(ИмяПакета) + "-" + НРег(СтрокаВерсии);
	Если Кэш.НегативАктуален(КлючНегатива, ТТЛНегатива) Тогда
		Лог.Отладка("Прокси: %1-%2 у апстрима %3 лежит в негативном кэше (TTL %4 с) — промах без похода",
			ИмяПакета, СтрокаВерсии, Апстрим.Url, ТТЛНегатива);
		Возврат Ложь;
	КонецЕсли;

	Если ОффлайнРежим() Тогда
		Лог.Отладка("Прокси: включён oshub.proxy.offline, %1-%2 в кэше нет — промах",
			ИмяПакета, СтрокаВерсии);
		Возврат Ложь; // offline и в immutable-кэше нет — промах
	КонецЕсли;

	// страж закрывает выход в сеть, а не выдачу: кэш-хит выше обслуживается локально
	Если НЕ Страж.Пропустить(Апстрим) Тогда
		Лог.Отладка("Прокси: апстрим %1 числится лежащим — в сеть не идём, промах", Апстрим.Url);
		Возврат Ложь;
	КонецЕсли;

	ОтносительныйПуть = СтрШаблон("%1/%2-%3.ospx", ИмяПакета, ИмяПакета, СтрокаВерсии);
	Результат = Клиент.СкачатьДанные(Апстрим.Url, ОтносительныйПуть, "", Секрет.ИзИсточника(Апстрим));
	ЗапомнитьЖивость(Апстрим, Результат);
	Лог.Отладка("Прокси: апстрим %1 на ""%2"" ответил %3", Апстрим.Url, ОтносительныйПуть, Результат.Код);

	Если Результат.Код = 0 Тогда
		СообщитьОбИсходе(Апстрим, ОтносительныйПуть, Результат);
		Возврат Ложь; // апстрим недоступен во время запроса — offline-промах
	КонецЕсли;
	Если Результат.Код = 404 Тогда
		СообщитьОбИсходе(Апстрим, ОтносительныйПуть, Результат);
		Кэш.СохранитьНегатив(КлючНегатива);
		Возврат Ложь;
	КонецЕсли;
	Если Результат.Код <> 200 Тогда
		СообщитьОбИсходе(Апстрим, ОтносительныйПуть, Результат);
		Возврат Ложь;
	КонецЕсли;

	Проверка = ПодготовитьАртефакт(Результат.Данные, Результат.ETag);
	Если НЕ Проверка.Успех Тогда
		Возврат Ложь; // битый .ospx не кэшируем — следующий запрос перекачает
	КонецЕсли;

	Успех = ЗакэшироватьПроверенное(Пул, Апстрим, ИмяПакета, СтрокаВерсии, Проверка);
	Уборка.УдалитьФайл(Проверка.ВременныйПуть);
	Если Успех Тогда
		Лог.Информация("Пул ""%1"": %2-%3 скачан с апстрима %4 и закэширован",
			Пул.Имя, ИмяПакета, СтрокаВерсии, Апстрим.Url);
	КонецЕсли;
	Возврат Успех;

КонецФункции

// Обеспечивает актуальность latest пакета у заданного апстрима и возвращает строку версии.
// Пока указатель свеж по TTL, берётся из кэша; иначе ревалидируется скачиванием {имя}.ospx;
// при offline отдаётся последнее известное значение.
//
// Параметры:
//  Пул - Пул - пул, в кэш которого забирается артефакт.
//  Апстрим - АпстримПула - опрашиваемый апстрим пула.
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Строка, Неопределено - строка последней версии; Неопределено, если latest недоступен.
//
Функция ОбеспечитьПоследнюю(Знач Пул, Знач Апстрим, Знач ИмяПакета) Экспорт

	Если НЕ Правила.ИмяКорректно(ИмяПакета) Тогда
		Лог.Отладка("Прокси: latest — имя ""%1"" не проходит правила именования", ИмяПакета);
		Возврат Неопределено;
	КонецЕсли;

	Если Апстрим = Неопределено Тогда
		Лог.Отладка("Прокси: latest ""%1"" — апстрим не задан", ИмяПакета);
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ РазрешеноИмя(Апстрим, ИмяПакета) Тогда
		Лог.Отладка("Прокси: latest ""%1"" не пропущен allowlist апстрима %2", ИмяПакета, Апстрим.Url);
		Возврат Неопределено;
	КонецЕсли;

	Ключ = "latest|" + КлючАпстрима(Пул, Апстрим) + "|" + НРег(ИмяПакета);

	Если Кэш.Актуально(Ключ, Апстрим.ВремяЖизниСек) Тогда
		Значение = Кэш.Запись(Ключ).Значение;
		Лог.Отладка("Прокси: latest ""%1"" свеж по TTL апстрима (%2 с) — %3 из кэша указателей",
			ИмяПакета, Апстрим.ВремяЖизниСек, Значение);
		Возврат Значение;
	КонецЕсли;

	Если ОффлайнРежим() Тогда
		Лог.Отладка("Прокси: включён oshub.proxy.offline — latest ""%1"" берём из кэша или индекса",
			ИмяПакета);
		Возврат ПоследняяИзКэшаИлиИндекса(Пул, ИмяПакета, Ключ);
	КонецЕсли;

	// лежачий источник обслуживается как offline — по последнему известному указателю
	Если НЕ Страж.Пропустить(Апстрим) Тогда
		Лог.Отладка("Прокси: апстрим %1 числится лежащим — latest ""%2"" берём из кэша или индекса",
			Апстрим.Url, ИмяПакета);
		Возврат ПоследняяИзКэшаИлиИндекса(Пул, ИмяПакета, Ключ);
	КонецЕсли;

	ПредыдущаяЗапись = Кэш.Запись(Ключ);
	УсловныйETag = ?(ПредыдущаяЗапись = Неопределено, "", ПредыдущаяЗапись.ETag);

	ОтносительныйПуть = СтрШаблон("%1/%1.ospx", ИмяПакета);
	Результат = Клиент.СкачатьДанные(Апстрим.Url, ОтносительныйПуть, УсловныйETag,
		Секрет.ИзИсточника(Апстрим));
	ЗапомнитьЖивость(Апстрим, Результат);
	Лог.Отладка("Прокси: апстрим %1 на latest ""%2"" ответил %3 (условный запрос: %4)",
		Апстрим.Url, ИмяПакета, Результат.Код, ЗначениеЗаполнено(УсловныйETag));

	Если Результат.Код = 0 Тогда
		СообщитьОбИсходе(Апстрим, ОтносительныйПуть, Результат);
		Возврат ПоследняяИзКэшаИлиИндекса(Пул, ИмяПакета, Ключ); // offline во время запроса
	КонецЕсли;
	Если Результат.Код = 304 Тогда
		Лог.Отладка("Прокси: latest ""%1"" у апстрима не изменился — продлеваем %2",
			ИмяПакета, ПредыдущаяЗапись.Значение);
		Кэш.Сохранить(Ключ, ПредыдущаяЗапись.Значение, ПредыдущаяЗапись.ETag);
		Возврат ПредыдущаяЗапись.Значение;
	КонецЕсли;
	Если Результат.Код <> 200 Тогда
		СообщитьОбИсходе(Апстрим, ОтносительныйПуть, Результат);
		Возврат ?(Результат.Код = 404, Неопределено, ПоследняяИзКэшаИлиИндекса(Пул, ИмяПакета, Ключ));
	КонецЕсли;

	// версия latest берётся из уже проверенного манифеста
	Проверка = ПодготовитьАртефакт(Результат.Данные, Результат.ETag);
	Если НЕ Проверка.Успех Тогда
		Возврат Неопределено;
	КонецЕсли;

	Версия = Проверка.Манифест.Версия();
	Успех = ЗакэшироватьПроверенное(Пул, Апстрим, ИмяПакета, Версия, Проверка);
	Уборка.УдалитьФайл(Проверка.ВременныйПуть);
	Если НЕ Успех Тогда
		Возврат Неопределено;
	КонецЕсли;

	Лог.Информация("Пул ""%1"": последняя версия %2 — %3, скачана с апстрима %4 и закэширована",
		Пул.Имя, ИмяПакета, Версия, Апстрим.Url);
	Кэш.Сохранить(Ключ, Версия, Результат.ETag);
	Возврат Версия;

КонецФункции

// Имена пакетов апстрима из list.txt с TTL-кэшем и offline-фолбэком.
//
// Параметры:
//  Пул - Пул - пул, которому принадлежит апстрим.
//  Апстрим - АпстримПула - опрашиваемый апстрим пула.
//
// Возвращаемое значение:
//  Массив из Строка - имена пакетов апстрима, отфильтрованные allowlist.
//
Функция ИменаАпстрима(Знач Пул, Знач Апстрим) Экспорт

	Если Апстрим = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Ключ = "list|" + КлючАпстрима(Пул, Апстрим);

	Если Кэш.Актуально(Ключ, Апстрим.ВремяЖизниСек) Тогда
		Возврат Кэш.Запись(Ключ).Значение;
	КонецЕсли;

	Если ОффлайнРежим() Тогда
		Лог.Отладка("Прокси: включён oshub.proxy.offline — список имён апстрима %1 берём из кэша",
			Апстрим.Url);
		Возврат ПоследнийСписокИлиПусто(Ключ);
	КонецЕсли;

	// лежачий источник обслуживается как offline — последним известным списком
	Если НЕ Страж.Пропустить(Апстрим) Тогда
		Лог.Отладка("Прокси: апстрим %1 числится лежащим — список имён берём из кэша", Апстрим.Url);
		Возврат ПоследнийСписокИлиПусто(Ключ);
	КонецЕсли;

	ПредыдущаяЗапись = Кэш.Запись(Ключ);
	УсловныйETag = ?(ПредыдущаяЗапись = Неопределено, "", ПредыдущаяЗапись.ETag);

	Результат = Клиент.ПолучитьТекст(Апстрим.Url, "list.txt", УсловныйETag,
		Секрет.ИзИсточника(Апстрим));
	ЗапомнитьЖивость(Апстрим, Результат);
	Лог.Отладка("Прокси: апстрим %1 на list.txt ответил %2", Апстрим.Url, Результат.Код);

	Если Результат.Код = 304 Тогда
		Кэш.Сохранить(Ключ, ПредыдущаяЗапись.Значение, ПредыдущаяЗапись.ETag);
		Возврат ПредыдущаяЗапись.Значение;
	КонецЕсли;
	Если Результат.Код <> 200 Тогда
		СообщитьОбИсходе(Апстрим, "list.txt", Результат);
		Возврат ПоследнийСписокИлиПусто(Ключ);
	КонецЕсли;

	Имена = РазобратьСписок(Результат.Тело, Апстрим);
	Лог.Отладка("Прокси: апстрим %1 отдал имён после allowlist: %2", Апстрим.Url, Имена.Количество());
	Кэш.Сохранить(Ключ, Имена, Результат.ETag);
	Возврат Имена;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Имена пакетов апстрима только из свежего TTL-кэша, без единого обращения к сети.
// Для потребителей, которым нельзя платить сетевым таймаутом: поход на лежачий апстрим
// задержал бы их на весь oshub.proxy.timeout.sec.
//
// Параметры:
//  Пул - Пул - пул, которому принадлежит апстрим.
//  Апстрим - АпстримПула - апстрим пула.
//
// Возвращаемое значение:
//  Массив из Строка, Неопределено - имена из свежего кэша; Неопределено, если список
//              ни разу не запрашивали либо его TTL истёк.
//
Функция ИменаАпстримаИзКэша(Знач Пул, Знач Апстрим) Экспорт

	Если Апстрим = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ключ = "list|" + КлючАпстрима(Пул, Апстрим);
	Если НЕ Кэш.Актуально(Ключ, Апстрим.ВремяЖизниСек) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кэш.Запись(Ключ).Значение;

КонецФункции

// Любой ответ, включая 404, означает «жив»; отказ в доступе запоминается отдельно.
Процедура ЗапомнитьЖивость(Знач Апстрим, Знач Результат)

	Если Апстрим = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Доступ = Секрет.ИзИсточника(Апстрим);
	Если Результат.Код = 0 Тогда
		Страж.ОтметитьЛежащим(Апстрим.Url, ?(ЗначениеЗаполнено(Результат.Пояснение),
			Результат.Пояснение, "источник не ответил"), Доступ);
	ИначеЕсли Секрет.ЭтоОтказДоступа(Результат.Код) Тогда
		Страж.ОтметитьНеПустившим(Апстрим.Url, ПричинаОтказаДоступа(Апстрим, Результат.Код), Доступ);
	Иначе
		Страж.ОтметитьЖивым(Апстрим.Url, Доступ);
	КонецЕсли;

КонецПроцедуры

// Объяснение зависит от того, задан ли токен; значение токена в текст не попадает.
Функция ПричинаОтказаДоступа(Знач Апстрим, Знач Код)

	Возврат СтрШаблон("источник не пустил (ответил %1), токен источника %2",
		Формат(Цел(Код), "ЧГ=0; ЧН=0"), Секрет.ДляЖурнала(Секрет.ИзИсточника(Апстрим)));

КонецФункции

Функция КлючАпстрима(Знач Пул, Знач Апстрим)
	Возврат Пул.Имя + "#" + Формат(Цел(Апстрим.Идентификатор), "ЧГ=0; ЧН=0");
КонецФункции

// Без этой записи промах апстрима и промах своего реестра выглядят снаружи одинаково.
Процедура СообщитьОбИсходе(Знач Апстрим, Знач ОтносительныйПуть, Знач Результат)

	Адрес = СтрШаблон("%1 (ресурс %2)", Строка(Апстрим.Url), ОтносительныйПуть);
	Пояснение = ?(ЗначениеЗаполнено(Результат.Пояснение), " — " + Результат.Пояснение, "");

	Если Результат.Код = 0 Тогда
		Лог.Предупреждение("Апстрим %1 недоступен%2", Адрес, Пояснение);
		Возврат;
	КонецЕсли;

	Если Результат.Код = 404 Тогда
		Лог.Информация("Апстрим %1 ответил 404%2%3", Адрес, Пояснение, ПодсказкаОПутиВыдачи(Апстрим.Url));
		Возврат;
	КонецЕсли;

	// «не пустил» не выдаётся ни за «пакета нет», ни за «источник лежит»: разница видна
	// человеку прямо в строке журнала, а не только по коду
	Если Секрет.ЭтоОтказДоступа(Результат.Код) Тогда
		Лог.Предупреждение("Апстрим %1 не пустил хаб: ответил %2, токен источника %3%4",
			Адрес, Формат(Результат.Код, "ЧГ=0; ЧН=0"),
			Секрет.ДляЖурнала(Секрет.ИзИсточника(Апстрим)), Пояснение);
		Возврат;
	КонецЕсли;

	Лог.Предупреждение("Апстрим %1 ответил %2%3", Адрес,
		Формат(Результат.Код, "ЧГ=0; ЧН=0"), Пояснение);

КонецПроцедуры

// Базовый URL апстрима — это путь ВЫДАЧИ по контракту opm, а не адрес главной страницы хаба.
Функция ПодсказкаОПутиВыдачи(Знач БазовыйURL)

	Значение = СокрЛП(Строка(БазовыйURL));
	Позиция = Найти(Значение, "://");
	Путь = ?(Позиция = 0, Значение, Сред(Значение, Позиция + 3));
	СлешПозиция = Найти(Путь, "/");
	Если СлешПозиция > 0 И ЗначениеЗаполнено(СтрЗаменить(Сред(Путь, СлешПозиция), "/", "")) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ". Базовый URL апстрима не содержит пути выдачи: по контракту opm это адрес"
		+ " каталога выдачи (например https://hub.oscript.io/download/), а не главной страницы хаба";

КонецФункции

// Неопределено на недопустимом сегменте: исключение валидации гасится в промах, а не в 500.
Функция БезопасныеКоординаты(Знач ИмяПула, Знач ИмяПакета, Знач СтрокаВерсии)
	Попытка
		Возврат Новый КоординатыАртефакта(ИмяПула, ИмяПакета, СтрокаВерсии);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// При Успех = Ложь временный файл уже удалён.
Функция ПодготовитьАртефакт(Знач Данные, Знач ETag)

	Отказ = Новый Структура("Успех, Манифест, ТекстREADME, ВременныйПуть",
		Ложь, Неопределено, Неопределено, "");

	ВременныйПуть = ОбъединитьПути(КаталогВременныхФайлов(),
		Строка(Новый УникальныйИдентификатор) + ".ospx");
	Данные.Записать(ВременныйПуть);

	Попытка
		Манифест = ПакетыOspx.ПрочитатьМанифестПакета(ВременныйПуть);
	Исключение
		Лог.Предупреждение("Проксируемый .ospx не читается (битая/усечённая загрузка) — не кэшируем: %1",
			Ошибки.Причина(ИнформацияОбОшибке()));
		Уборка.УдалитьФайл(ВременныйПуть);
		Возврат Отказ;
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(Манифест.Имя()) ИЛИ НЕ ЗначениеЗаполнено(Манифест.Версия()) Тогда
		Лог.Предупреждение("Проксируемый .ospx с пустым именем/версией в манифесте — не кэшируем");
		Уборка.УдалитьФайл(ВременныйПуть);
		Возврат Отказ;
	КонецЕсли;

	Если НЕ Сверка.Совпадает(Данные, ETag) Тогда
		Лог.Предупреждение("sha256 проксируемого .ospx не совпал с ETag апстрима (усечённая загрузка) — не кэшируем");
		Уборка.УдалитьФайл(ВременныйПуть);
		Возврат Отказ;
	КонецЕсли;

	Возврат Новый Структура("Успех, Манифест, ТекстREADME, ВременныйПуть",
		Истина, Манифест, ОписаниеИзПакета(ВременныйПуть), ВременныйПуть);

КонецФункции

// Распаковка — отдельная попытка после гейта манифеста: нераспаковавшийся пакет кэшируется.
Функция ОписаниеИзПакета(Знач ВременныйПуть)

	Попытка
		Пакет = ПакетыOspx.ПрочитатьПакет(ВременныйПуть);
	Исключение
		Лог.Предупреждение("README проксируемого .ospx не извлечён — страница соберёт его позже: %1",
			Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

	Возврат ?(Пакет.ЕстьREADME(), Пакет.ТекстREADME(), "");

КонецФункции

// Сбой сохранения либо индексации откатывает артефакт: иначе cache-hit залипал бы без индекса.
Функция ЗакэшироватьПроверенное(Знач Пул, Знач Апстрим, Знач ИмяПакета, Знач СтрокаВерсии, Знач Проверка)

	Координаты = Неопределено;
	Попытка
		Координаты = Новый КоординатыАртефакта(Пул.Имя, ИмяПакета, СтрокаВерсии);
		Если Хранилище.Существует(Координаты) Тогда
			Возврат Истина; // гонка либо latest указал на скачанную ранее версию
		КонецЕсли;
		РезультатСохранения = Хранилище.Сохранить(Координаты, Проверка.ВременныйПуть);
		ПроиндексироватьАртефакт(Пул, Апстрим, ИмяПакета, СтрокаВерсии, Проверка.Манифест,
			РезультатСохранения, Проверка.ТекстREADME);
	Исключение
		Причина = Ошибки.Причина(ИнформацияОбОшибке());
		Если Координаты <> Неопределено Тогда
			ПопытатьсяУдалитьАртефакт(Координаты);
		КонецЕсли;
		Лог.Ошибка(
			"Сбой кэширования/индексации проксируемого %1-%2 (пул ""%3"", апстрим %4)"
			+ " — артефакт откачен из кэша: %5",
			ИмяПакета, СтрокаВерсии, Пул.Имя, ?(Апстрим = Неопределено, "не задан", Строка(Апстрим.Url)), Причина);
		Возврат Ложь;
	КонецПопытки;

	// счётчик ведёт тот, кто пишет файл: индекс версии вытеснение не удаляет
	Занятое.Учесть(Пул, РезультатСохранения.Размер, "кэширование " + ИмяПакета + "-" + СтрокаВерсии);

	Возврат Истина;

КонецФункции

// Имя и версия — из URL, остальное из манифеста; версия помечается провенансом «апстрим».
Процедура ПроиндексироватьАртефакт(Знач Пул, Знач Апстрим, Знач ИмяПакета, Знач СтрокаВерсии,
	Знач Манифест, Знач РезультатСохранения, Знач ТекстREADME)

	Приём.ПринятьВнешнюю(Пул, ИмяПакета, СтрокаВерсии, Манифест, РезультатСохранения,
		?(Апстрим = Неопределено, 0, Апстрим.Идентификатор), ТекстREADME);

КонецПроцедуры

// Откат кэша: сам он ошибку индексации затирать не должен.
Процедура ПопытатьсяУдалитьАртефакт(Знач Координаты)
	Попытка
		Хранилище.Удалить(Координаты);
	Исключение
	КонецПопытки;
КонецПроцедуры

Функция ПоследняяИзКэшаИлиИндекса(Знач Пул, Знач ИмяПакета, Знач Ключ)

	Запись = Кэш.Запись(Ключ);
	Если Запись <> Неопределено И НЕ Запись.Негатив И ЗначениеЗаполнено(Запись.Значение) Тогда
		Возврат Запись.Значение;
	КонецЕсли;

	Пакет = СервисПакетов.НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Если Пакет = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Последняя = СервисВерсий.ПоследняяВерсия(Пакет.Идентификатор);
	Возврат ?(Последняя = Неопределено, Неопределено, Последняя.Версия);

КонецФункции

Функция ПоследнийСписокИлиПусто(Знач Ключ)

	Запись = Кэш.Запись(Ключ);
	Если Запись <> Неопределено И НЕ Запись.Негатив И Запись.Значение <> Неопределено Тогда
		Возврат Запись.Значение;
	КонецЕсли;
	Возврат Новый Массив();

КонецФункции

Функция РазрешеноИмя(Знач Апстрим, Знач ИмяПакета)
	Возврат Allowlist.Пропускает(Апстрим.СписокРазрешенийJSON, ИмяПакета, Строка(Апстрим.Url));
КонецФункции

Функция РазобратьСписок(Знач Тело, Знач Апстрим)

	Имена = Новый Массив();
	Для Каждого СтрокаТела Из СтрРазделить(Строка(Тело), Символы.ПС, Ложь) Цикл
		Имя = СокрЛП(СтрЗаменить(СтрокаТела, Символы.ВК, ""));
		Если ЗначениеЗаполнено(Имя) И РазрешеноИмя(Апстрим, Имя) Тогда
			Имена.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;

КонецФункции

// Спрашиваются на запросе: их включают ровно тогда, когда рестарт некстати.
Функция ОффлайнРежим()
	Возврат Настройки.Значение("oshub.proxy.offline") = Истина;
КонецФункции

Функция НегативныйTTL()
	Возврат Настройки.Значение("oshub.proxy.negative.ttl.sec");
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "ПриёмВерсии") _Приём,
	&Пластилин(Значение = "СверкаETag") _Сверка,
	&Пластилин(Значение = "ПравилаИменования") _Правила,
	&Пластилин(Значение = "ХранилищеАртефактов") _Хранилище,
	&Пластилин(Значение = "КлиентАпстрима") _Клиент,
	&Пластилин(Значение = "СтражАпстримов") _Страж,
	&Пластилин(Значение = "КэшИзменяемыхРесурсов") _Кэш,
	&Пластилин(Значение = "ЗаписьЗанятогоМеста") _Занятое,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "СписокРазрешённыхИмён") _Allowlist,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "СекретИсточника") _Секрет = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Пластилин(Значение = "ТихаяУборка") _Уборка = Неопределено)

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Секрет = ?(_Секрет = Неопределено, Новый СекретИсточника(), _Секрет);
	Уборка = ?(_Уборка = Неопределено, Новый ТихаяУборка(), _Уборка);
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;
	Приём = _Приём;
	Сверка = _Сверка;
	Правила = _Правила;
	Хранилище = _Хранилище;
	Клиент = _Клиент;
	Страж = _Страж;
	Кэш = _Кэш;
	Занятое = _Занятое;
	Настройки = _Настройки;
	Allowlist = _Allowlist;

КонецПроцедуры
