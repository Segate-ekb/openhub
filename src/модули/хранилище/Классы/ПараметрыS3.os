// Параметры подключения к корзине S3 из настроек хаба: адрес, корзина, регион, адресация
// и ключи доступа — значением либо файлом секрета.

Перем ЗначениеЭндпоинта;
Перем ЗначениеРегиона;
Перем ЗначениеБакета;
Перем ЗначениеПрефикса;
Перем ЗначениеПутьСтиля;
Перем ЗначениеКлючаДоступа;
Перем ЗначениеСекретногоКлюча;

#Область ПубличныйИнтерфейс

// Адрес хранилища.
//
// Возвращаемое значение:
//  Строка - адрес; пусто — не задан.
//
Функция Эндпоинт() Экспорт
	Возврат ЗначениеЭндпоинта;
КонецФункции

// Регион корзины; умолчание — us-east-1: его принимают и AWS, и MinIO.
//
// Возвращаемое значение:
//  Строка - регион.
//
Функция Регион() Экспорт
	Возврат ЗначениеРегиона;
КонецФункции

// Имя корзины.
//
// Возвращаемое значение:
//  Строка - имя; пусто — не задано.
//
Функция Бакет() Экспорт
	Возврат ЗначениеБакета;
КонецФункции

// Префикс ключей артефактов внутри корзины.
//
// Возвращаемое значение:
//  Строка - префикс; пусто — корень корзины.
//
Функция Префикс() Экспорт
	Возврат ЗначениеПрефикса;
КонецФункции

// Адресация корзины путём, а не поддоменом; умолчание — путём: иначе MinIO недоступен.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПутьСтиль() Экспорт
	Возврат ЗначениеПутьСтиля;
КонецФункции

// Ключ доступа: значение настройки либо содержимое файла секрета.
//
// Возвращаемое значение:
//  Строка - ключ; пусто — не задан.
//
Функция КлючДоступа() Экспорт
	Возврат ЗначениеКлючаДоступа;
КонецФункции

// Секретный ключ: значение настройки либо содержимое файла секрета.
//
// Возвращаемое значение:
//  Строка - ключ; пусто — не задан.
//
Функция СекретныйКлюч() Экспорт
	Возврат ЗначениеСекретногоКлюча;
КонецФункции

// Чего не хватает, чтобы подключиться к корзине.
//
// Возвращаемое значение:
//  Массив из Строка - по строке на недостающую настройку; пустой — хватает всего.
//
Функция Недостающее() Экспорт

	Результат = Новый Массив();
	Если НЕ ЗначениеЗаполнено(ЗначениеБакета) Тогда
		Результат.Добавить("не задан бакет (oshub.storage.s3.bucket)");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ЗначениеЭндпоинта) Тогда
		Результат.Добавить("не задан эндпоинт (oshub.storage.s3.endpoint)");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ЗначениеКлючаДоступа) Тогда
		Результат.Добавить("не задан ключ доступа (oshub.storage.s3.access_key"
			+ " либо файлом — oshub.storage.s3.access_key_file)");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ЗначениеСекретногоКлюча) Тогда
		Результат.Добавить("не задан секретный ключ (oshub.storage.s3.secret_key"
			+ " либо файлом — oshub.storage.s3.secret_key_file)");
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пустая строка — не задано; Ложь из файла настроек — задано.
Функция Сырое(Знач Настройки, Знач Имя)

	Значение = Неопределено;
	Если НЕ Настройки.Свойство(Имя, Значение)
		ИЛИ ТипЗнч(Значение) = Тип("Строка") И ПустаяСтрока(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция Текст(Знач Настройки, Знач Имя, Знач ПоУмолчанию)
	Значение = Сырое(Настройки, Имя);
	Возврат ?(Значение = Неопределено, ПоУмолчанию, СокрЛП(Строка(Значение)));
КонецФункции

#КонецОбласти

// Параметры:
//  Настройки - Структура - сырые значения деталек: Эндпоинт, Регион, Бакет, Префикс, ПутьСтиль,
//              КлючДоступа, ФайлКлючаДоступа, СекретныйКлюч, ФайлСекретногоКлюча; отсутствующее
//              поле — не задано.
//  _Лог - Лог - куда назвать путь к несуществующему файлу секрета (необязательный).
//
Процедура ПриСозданииОбъекта(Знач Настройки, Знач _Лог = Неопределено) Экспорт

	ЗначениеЭндпоинта = Текст(Настройки, "Эндпоинт", "");
	ЗначениеРегиона = Текст(Настройки, "Регион", "us-east-1");
	ЗначениеБакета = Текст(Настройки, "Бакет", "");
	ЗначениеПрефикса = Текст(Настройки, "Префикс", "");
	ЗначениеПутьСтиля = Новый ПриведениеФлагов().ФлагОкружения(Сырое(Настройки, "ПутьСтиль"), Истина);

	Секреты = Новый СекретИзФайла(_Лог);
	ЗначениеКлючаДоступа = Секреты.Секрет(Сырое(Настройки, "КлючДоступа"),
		Сырое(Настройки, "ФайлКлючаДоступа"), "oshub.storage.s3.access_key_file");
	ЗначениеСекретногоКлюча = Секреты.Секрет(Сырое(Настройки, "СекретныйКлюч"),
		Сырое(Настройки, "ФайлСекретногоКлюча"), "oshub.storage.s3.secret_key_file");

КонецПроцедуры
