// Содержимое артефактов для выдачи потоком, кэшированное по sha256 версии; локальное хранилище — мимо кэша.

#Использовать errors

Перем Хранилище;           // ХранилищеАртефактов (хранилище)
Перем Ошибки;              // ТекстОшибки (основа) — фраза отказа сверки для отладки
Перем ИмяБэкенда;          // Строка - "file" либо "s3"
Перем ХранилищеУдалённое;  // Булево - артефакты лежат не на диске хаба
&Лог
Перем Лог;

// Содержимое артефакта потоком, сверенное с контрольной суммой версии. Повторный вызов с той же
// суммой открывает поток над записью кэша, не обращаясь к хранилищу.
//
// Параметры:
//  Sha256 - Строка - контрольная сумма версии из реестра.
//  Координаты - КоординатыАртефакта - адрес артефакта в хранилище.
//
// Возвращаемое значение:
//  Поток, Неопределено - содержимое с позицией в начале, закрывает получатель; Неопределено, если
//                        хранилище локальное, сумма пуста либо байты в хранилище с ней не совпали.
//
&Кэшируемый("артефакты")
Функция Содержимое(&КлючКэша Знач Sha256, Знач Координаты) Экспорт

	// адрес собирается, только когда строки отладки печатаются
	Адрес = "";
	Если Лог.Уровень() <= УровниЛога.Отладка Тогда
		Адрес = Координаты.Представление();
	КонецЕсли;

	Если НЕ ХранилищеУдалённое Тогда
		Лог.Отладка("Мимо кэша артефактов: %1 — хранилище не удалённое (бэкенд %2)", Адрес, ИмяБэкенда);
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Sha256) Тогда
		Лог.Отладка("Мимо кэша артефактов: %1 — у версии нет контрольной суммы", Адрес);
		Возврат Неопределено;
	КонецЕсли;

	// сумма не совпала — окно перезаписи версии: несверенное в кэш не кладётся, прочие отказы — наверх
	Попытка
		Поток = Хранилище.ОткрытьПоток(Координаты, Sha256);
	Исключение
		Сбой = ИнформацияОбОшибке();
		Если НЕ ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.ДанныеПовреждены()) Тогда
			ВызватьИсключение;
		КонецЕсли;
		Лог.Отладка("Мимо кэша артефактов: %1", Ошибки.Фраза(Сбой));
		Возврат Неопределено;
	КонецПопытки;

	Лог.Отладка("Чтение в кэш артефактов: %1 (sha256 %2) прочитан из хранилища, %3 байт",
		Адрес, НРег(Sha256), Поток.Размер());

	Возврат Поток;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеАртефактов") _Хранилище,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Лог _Лог = Неопределено)

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

	Хранилище = _Хранилище;
	Ошибки = _Ошибки;
	ИмяБэкенда = Хранилище.Бэкенд();
	ХранилищеУдалённое = ИмяБэкенда = "s3";

КонецПроцедуры
