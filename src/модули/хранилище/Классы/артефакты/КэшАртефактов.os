// Содержимое артефактов для выдачи потоком, кэшированное по sha256 версии; на промахе удалённого хранилища
// артефакт качается фоном во временный файл, который выдача читает по ходу, а готовый ложится в кэш.

#Использовать errors

Перем Хранилище;           // ХранилищеАртефактов (хранилище)
Перем Ошибки;              // ТекстОшибки (основа)
Перем Фон;                 // ЗапускВФоне (фоновыеЗадания); Неопределено — контейнер без фоновой работы
Перем Кэши;                // Табакерка МенеджерКэшей (autumn-cache) — куда ложится готовый файл
Перем Помощник;            // ПомощникАртефакта — сумма файла и отказ сверки теми же словами, что у бэкендов
Перем Уборка;              // ТихаяУборка (основа)
Перем Загрузки;            // Соответствие sha256 -> Структура(Путь, Размер, Начата) - загрузки в работе
Перем КУборке;             // Массив Структура(Путь, После) - готовые временные файлы и срок их уборки
Перем Замок;               // БлокировкаРесурса (основа) — реестр загрузок делят запросы и задания
Перем ИмяБэкенда;          // Строка - "file" либо "s3"
Перем ХранилищеУдалённое;  // Булево - артефакты лежат не на диске хаба
Перем ТаймаутЧитателяМс;   // Число - сколько выдача ждёт новых байтов растущего файла (winow.ТаймаутОжиданияФайла)
Перем ПаузаПередУборкойМс; // Число - сколько готовый файл живёт после снятия загрузки
&Лог
Перем Лог;

// Содержимое артефакта потоком из кэша. На промахе стартует фоновую загрузку и отвечает
// Неопределено: файл, в который артефакт качается, отдаёт Загрузка. Без запуска в фоне промах
// читает поток хранилища со сверкой суммы прямо в запросе.
//
// Параметры:
//  Sha256 - Строка - контрольная сумма версии из реестра.
//  Координаты - КоординатыАртефакта - адрес артефакта в хранилище.
//
// Возвращаемое значение:
//  Поток, Неопределено - содержимое с позицией в начале, закрывает получатель; Неопределено, если
//                        хранилище локальное, сумма пуста, артефакт ещё качается либо байты
//                        в хранилище с суммой не совпали.
//
// Выбрасывает исключение, если хранилище не назвало размер артефакта либо загрузку не удалось начать:
// регистрации загрузки и её файла после этого нет.
//
&Кэшируемый("артефакты")
Функция Содержимое(&КлючКэша Знач Sha256, Знач Координаты) Экспорт

	Если НЕ ХранилищеУдалённое Тогда
		Лог.Отладка("Мимо кэша артефактов: %1 — хранилище не удалённое (бэкенд %2)", Адрес(Координаты), ИмяБэкенда);
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Sha256) Тогда
		Лог.Отладка("Мимо кэша артефактов: %1 — у версии нет контрольной суммы", Адрес(Координаты));
		Возврат Неопределено;
	КонецЕсли;

	Если Фон = Неопределено Тогда
		Возврат ПрочитатьСразу(Sha256, Координаты);
	КонецЕсли;

	НачатьЗагрузку(Sha256, Координаты);
	Возврат Неопределено;

КонецФункции

// Файл, в который артефакт качается прямо сейчас, и его полный размер.
//
// Параметры:
//  Sha256 - Строка - контрольная сумма версии из реестра.
//
// Возвращаемое значение:
//  Структура, Неопределено - Путь (Строка), Размер (Число); Неопределено, если загрузки нет.
//
Функция Загрузка(Знач Sha256) Экспорт

	Запись = ЗаписьЗагрузки(Sha256);
	Если Запись = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Путь, Размер", Запись.Путь, Запись.Размер);

КонецФункции

// Тело фонового задания: качает артефакт в файл, сверяет сумму, удачный файл кладёт в кэш,
// загрузку снимает с реестра, а файл ставит в уборку. Загрузка, которую сняли по застою,
// вернувшись, в кэш не кладёт и новую загрузку той же суммы не трогает. Сбой уходит в журнал,
// а не наружу.
//
// Параметры:
//  Sha256 - Строка - контрольная сумма версии из реестра.
//  Координаты - КоординатыАртефакта - адрес артефакта в хранилище.
//  Путь - Строка - файл загрузки из Загрузка.
//
Процедура Загрузить(Знач Sha256, Знач Координаты, Знач Путь) Экспорт

	Удачно = Ложь;
	Попытка
		Хранилище.СкачатьВФайл(Координаты, Путь, СрокОтветаХранилищаСек());
		Удачно = СуммаСовпала(Sha256, Координаты, Путь);
	Исключение
		Лог.Ошибка("Загрузка в кэш артефактов: %1 (sha256 %2) не скачан: %3",
			Координаты.Представление(), НРег(Sha256), Ошибки.Причина(ИнформацияОбОшибке()));
	КонецПопытки;

	Если НЕ ЗагрузкаЧислится(Sha256, Путь) Тогда
		Лог.Предупреждение("Загрузка в кэш артефактов: %1 (sha256 %2) вернулась после снятия по застою —"
			+ " в кэш не кладётся", Координаты.Представление(), НРег(Sha256));
	ИначеЕсли Удачно Тогда
		ПоложитьВКэш(Sha256, Путь);
	КонецЕсли;

	СнятьЗагрузку(Sha256, Путь);

КонецПроцедуры

// Убирает временные файлы загрузок, пережившие паузу: созревшие в очереди уборки и оставленные
// в каталоге временных файлов прежним процессом либо вызовом, который так и не вернулся. Свои
// файлы узнаются по префиксу и расширению; файл загрузки в реестре и файл, ждущий своей паузы
// в очереди уборки, не трогаются.
//
Процедура УбратьОставленное() Экспорт

	Замок.Заблокировать();
	Попытка
		УбратьСозревшие();
		Занятые = ИменаСвоихФайлов();
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Порог = ТекущаяДата() - ПаузаПередУборкойМс / 1000;
	Для Каждого Файл Из НайтиФайлы(КаталогВременныхФайлов(), ПрефиксФайла() + "*." + РасширениеФайла()) Цикл
		Если Занятые.Получить(Файл.Имя) = Неопределено И Файл.ПолучитьВремяИзменения() < Порог Тогда
			Уборка.УдалитьФайл(Файл.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Расхождение суммы — окно перезаписи версии: несверенное в кэш не кладётся.
Функция СуммаСовпала(Знач Sha256, Знач Координаты, Знач Путь)

	СуммаФайла = Помощник.Sha256Файла(Путь);
	Если СуммаФайла = НРег(Sha256) Тогда
		Возврат Истина;
	КонецЕсли;

	Лог.Отладка("Мимо кэша артефактов: %1", Ошибки.Фраза(Помощник.ОтказСверки(Координаты, Sha256, СуммаФайла)));
	Возврат Ложь;

КонецФункции

// Как без фоновой работы: поток хранилища сверяет сумму, в запись кэша его копирует напильник.
Функция ПрочитатьСразу(Знач Sha256, Знач Координаты)

	Попытка
		Поток = Хранилище.ОткрытьПоток(Координаты, Sha256);
	Исключение
		Сбой = ИнформацияОбОшибке();
		Если НЕ ДиагностикаОшибок.Содержит(Сбой, КодыСтандартныхОшибок.ДанныеПовреждены()) Тогда
			ВызватьИсключение;
		КонецЕсли;
		Лог.Отладка("Мимо кэша артефактов: %1", Ошибки.Фраза(Сбой));
		Возврат Неопределено;
	КонецПопытки;

	Лог.Отладка("Чтение в кэш артефактов: %1 (sha256 %2) прочитан из хранилища, %3 байт",
		Адрес(Координаты), НРег(Sha256), Поток.Размер());

	Возврат Поток;

КонецФункции

// Размер спрашивается до замка: поход в хранилище под ним задержал бы соседние промахи.
Процедура НачатьЗагрузку(Знач Sha256, Знач Координаты)

	СнятьЗастывшую(Sha256);
	Если ЗаписьЗагрузки(Sha256) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Размер = Хранилище.Размер(Координаты, СрокОтветаХранилищаСек());
	Путь = Уборка.ВременныйПуть(ПрефиксФайла(), РасширениеФайла());

	Если НЕ ЗарегистрироватьЗагрузку(Sha256, Путь, Размер) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		// файл есть до старта задания: читатель открывает его сразу, а хранилище перезаписывает на месте
		Пустой = Новый ФайловыйПоток(Путь, РежимОткрытияФайла.Создать, ДоступКФайлу.Запись);
		Пустой.Закрыть();
		Фон.Запустить(Новый ЗагрузкаАртефактаВКэш(ЭтотОбъект, Sha256, Координаты, Путь));
	Исключение
		ОтменитьЗагрузку(Sha256, Путь);
		ВызватьИсключение;
	КонецПопытки;

	Лог.Отладка("Загрузка в кэш артефактов: %1 (sha256 %2) качается в %3, %4 байт",
		Адрес(Координаты), НРег(Sha256), Путь, Размер);

КонецПроцедуры

// Копия, а не перемещение: путь ещё держит выдача, получившая его от Загрузка.
Процедура ПоложитьВКэш(Знач Sha256, Знач Путь)

	Если Кэши = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Поток = Неопределено;
	Попытка
		Поток = Новый ФайловыйПоток(Путь, РежимОткрытияФайла.Открыть, ДоступКФайлу.Чтение);
		Кэши.Достать().Кэш("артефакты").Положить(Sha256, Поток).Закрыть();
	Исключение
		Лог.Ошибка("Кэш артефактов: %1 не положен: %2", НРег(Sha256), ОписаниеОшибки());
		Если Поток <> Неопределено Тогда
			Поток.Закрыть();
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

// Ответа хранилища не ждут дольше, чем выдача ждёт байтов.
Функция СрокОтветаХранилищаСек()
	Возврат Макс(1, Цел((ТаймаутЧитателяМс + 999) / 1000));
КонецФункции

Функция ЗаписьЗагрузки(Знач Sha256)

	Замок.Заблокировать();
	Попытка
		Запись = Загрузки.Получить(Sha256);
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Возврат Запись;

КонецФункции

// Файл застывшей остаётся вызову, который его пишет: вернувшись, тот поставит его в уборку.
Процедура СнятьЗастывшую(Знач Sha256)

	Замок.Заблокировать();
	Попытка
		Запись = Загрузки.Получить(Sha256);
		Снята = Запись <> Неопределено И Застыла(Запись);
		Если Снята Тогда
			Загрузки.Удалить(Sha256);
		КонецЕсли;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Если Снята Тогда
		Лог.Предупреждение("Загрузка в кэш артефактов: sha256 %1 снята — файл %2 не растёт дольше %3 мс,"
			+ " промах начнёт заново", НРег(Sha256), Запись.Путь, ТаймаутЧитателяМс);
	КонецЕсли;

КонецПроцедуры

// Под замком: рост судится по времени изменения файла, а не по тому, как часто спрашивают.
Функция Застыла(Знач Запись)

	Файл = Новый Файл(Запись.Путь);
	Если НЕ Файл.Существует() Тогда
		Возврат ТекущаяУниверсальнаяДатаВМиллисекундах() - Запись.Начата > ТаймаутЧитателяМс;
	КонецЕсли;

	Если Файл.Размер() >= Запись.Размер Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат (ТекущаяДата() - Файл.ПолучитьВремяИзменения()) * 1000 > ТаймаутЧитателяМс;

КонецФункции

Функция ЗагрузкаЧислится(Знач Sha256, Знач Путь)

	Запись = ЗаписьЗагрузки(Sha256);
	Возврат Запись <> Неопределено И Запись.Путь = Путь;

КонецФункции

// Ложь, если загрузку той же суммы успел зарегистрировать сосед.
Функция ЗарегистрироватьЗагрузку(Знач Sha256, Знач Путь, Знач Размер)

	Замок.Заблокировать();
	Попытка
		УбратьСозревшие();
		Первая = Загрузки.Получить(Sha256) = Неопределено;
		Если Первая Тогда
			Загрузки.Вставить(Sha256, Новый Структура("Путь, Размер, Начата", Путь, Размер,
				ТекущаяУниверсальнаяДатаВМиллисекундах()));
		КонецЕсли;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Возврат Первая;

КонецФункции

// Файл живёт ещё паузу после снятия: читатели, получившие путь до снятия, успевают его открыть.
Процедура СнятьЗагрузку(Знач Sha256, Знач Путь)

	Замок.Заблокировать();
	Попытка
		СнятьСвою(Sha256, Путь);
		КУборке.Добавить(Новый Структура("Путь, После", Путь,
			ТекущаяУниверсальнаяДатаВМиллисекундах() + ПаузаПередУборкойМс));
		УбратьСозревшие();
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

КонецПроцедуры

// Задание путь не получило, читать в файле нечего — он убирается сразу.
Процедура ОтменитьЗагрузку(Знач Sha256, Знач Путь)

	Замок.Заблокировать();
	Попытка
		СнятьСвою(Sha256, Путь);
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Уборка.УдалитьФайл(Путь);

КонецПроцедуры

// Под замком: регистрация снимается, только если числится за этим файлом.
Процедура СнятьСвою(Знач Sha256, Знач Путь)

	Запись = Загрузки.Получить(Sha256);
	Если Запись <> Неопределено И Запись.Путь = Путь Тогда
		Загрузки.Удалить(Sha256);
	КонецЕсли;

КонецПроцедуры

// Под замком: убирает файлы, у которых пауза вышла.
Процедура УбратьСозревшие()

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Оставшиеся = Новый Массив();
	Для Каждого Файл Из КУборке Цикл
		Если Файл.После <= Сейчас Тогда
			Уборка.УдалитьФайл(Файл.Путь);
		Иначе
			Оставшиеся.Добавить(Файл);
		КонецЕсли;
	КонецЦикла;
	КУборке = Оставшиеся;

КонецПроцедуры

// Под замком: файлы реестра и очереди уборки — их судьбу решают застой и своя пауза.
Функция ИменаСвоихФайлов()

	Имена = Новый Соответствие();
	Для Каждого КлючЗначение Из Загрузки Цикл
		Имена.Вставить(Новый Файл(КлючЗначение.Значение.Путь).Имя, Истина);
	КонецЦикла;
	Для Каждого Файл Из КУборке Цикл
		Имена.Вставить(Новый Файл(Файл.Путь).Имя, Истина);
	КонецЦикла;

	Возврат Имена;

КонецФункции

// По префиксу уборка узнаёт свои файлы в общем каталоге.
Функция ПрефиксФайла()
	Возврат "артефакт-";
КонецФункции

Функция РасширениеФайла()
	Возврат "ospx";
КонецФункции

// Адрес собирается, только когда строки отладки печатаются.
Функция Адрес(Знач Координаты)
	Возврат ?(Лог.Уровень() <= УровниЛога.Отладка, Координаты.Представление(), "");
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеАртефактов") _Хранилище,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Пластилин(Значение = "ЗапускВФоне") _Фон = Неопределено,
	&Лог _Лог = Неопределено,
	&Табакерка &Пластилин(Значение = "МенеджерКэшей") _Кэши = Неопределено,
	&Деталька(Значение = "winow.ТаймаутОжиданияФайла", ЗначениеПоУмолчанию = 30000) _ТаймаутЧитателяМс = 30000)

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

	Хранилище = _Хранилище;
	Ошибки = _Ошибки;
	Фон = _Фон;
	Кэши = _Кэши;
	Помощник = Новый ПомощникАртефакта();
	Уборка = Новый ТихаяУборка();
	Загрузки = Новый Соответствие();
	КУборке = Новый Массив();
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
	ТаймаутЧитателяМс = Макс(1, Новый ПриведениеЧисел().ЧислоИлиДефолт(_ТаймаутЧитателяМс, 30000));
	// читатель, получивший путь до снятия, открывает файл позже и сам ждёт байтов до таймаута
	ПаузаПередУборкойМс = 2 * ТаймаутЧитателяМс;
	ИмяБэкенда = Хранилище.Бэкенд();
	ХранилищеУдалённое = ИмяБэкенда = "s3";

КонецПроцедуры
