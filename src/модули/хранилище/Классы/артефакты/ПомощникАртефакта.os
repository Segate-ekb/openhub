// Общее у всех бэкендов хранилища: размер источника до загрузки и sha256 содержимого.
// Источником артефакта хаб считает две вещи — двоичные данные и путь к файлу.

Перем Хеши;   // Хеш (основа)

// Проверяет, что источник артефакта годен: двоичные данные либо путь к существующему файлу.
// Негодный источник — вина вызывающего, а не хранилища.
//
// Параметры:
//  Источник - Произвольный - то, что вызывающий передал как содержимое артефакта.
//
Процедура ПроверитьИсточник(Знач Источник) Экспорт

	Если ТипЗнч(Источник) = Тип("ДвоичныеДанные") Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Источник) <> Тип("Строка") Тогда
		ВызватьИсключение СтрШаблон(
			"Неподдерживаемый тип источника артефакта: %1 (ожидались Строка или ДвоичныеДанные)",
			ТипЗнч(Источник));
	КонецЕсли;

	ФайлИсточника = Новый Файл(Источник);
	Если НЕ ФайлИсточника.Существует() ИЛИ НЕ ФайлИсточника.ЭтоФайл() Тогда
		ВызватьИсключение СтрШаблон("Файл-источник артефакта не найден: %1", Источник);
	КонецЕсли;

КонецПроцедуры

// Размер источника без копирования: предпроверка квоты. Негодный источник отвергает.
//
// Параметры:
//  Источник - ДвоичныеДанные, Строка - содержимое артефакта либо путь к файлу.
//
// Возвращаемое значение:
//  Число - размер в байтах.
//
Функция РазмерИсточника(Знач Источник) Экспорт

	ПроверитьИсточник(Источник);

	Если ТипЗнч(Источник) = Тип("ДвоичныеДанные") Тогда
		Возврат Источник.Размер();
	КонецЕсли;

	Возврат Новый Файл(Источник).Размер();

КонецФункции

// Текст отказа сверки: сумма прочитанного артефакта не совпала с ожидаемой.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта.
//  ОжидаемыйSha256 - Строка - сумма, с которой сверяли.
//  ФактическийSha256 - Строка - сумма прочитанного.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОтказСверки(Знач Координаты, Знач ОжидаемыйSha256, Знач ФактическийSha256) Экспорт
	Возврат СтрШаблон("Контрольная сумма артефакта %1 не совпадает: ожидалась %2, фактическая %3",
		Координаты.Представление(), НРег(ОжидаемыйSha256), ФактическийSha256);
КонецФункции

// sha256 источника — тем же способом, каким его считает бэкенд при чтении.
//
// Параметры:
//  Источник - ДвоичныеДанные, Строка - содержимое артефакта либо путь к файлу.
//
// Возвращаемое значение:
//  Строка - hex-строка в нижнем регистре.
//
Функция Sha256Источника(Знач Источник) Экспорт

	Если ТипЗнч(Источник) = Тип("ДвоичныеДанные") Тогда
		Возврат Sha256Данных(Источник);
	КонецЕсли;
	Возврат Sha256Файла(Источник);

КонецФункции

// sha256 файла на диске.
//
// Параметры:
//  Путь - Строка - путь к файлу.
//
// Возвращаемое значение:
//  Строка - hex-строка в нижнем регистре.
//
Функция Sha256Файла(Знач Путь) Экспорт
	Возврат Хеши.ОтФайла(Путь);
КонецФункции

// sha256 двоичных данных.
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое артефакта.
//
// Возвращаемое значение:
//  Строка - hex-строка в нижнем регистре.
//
Функция Sha256Данных(Знач Данные) Экспорт
	Возврат Хеши.ОтДанных(Данные);
КонецФункции

Процедура ПриСозданииОбъекта() Экспорт
	Хеши = Новый Хеш();
КонецПроцедуры
