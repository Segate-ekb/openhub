// Чем содержимое артефакта является: единственное место, где имя файла превращается
// в тип содержимого. Свойство того, ЧТО кладут, — бэкенд его только передаёт дальше.

Перем ТипыПоРасширению; // Соответствие расширение(Строка) -> тип содержимого(Строка)

#Область ПубличныйИнтерфейс

// Тип содержимого артефакта по имени его файла.
//
// Параметры:
//  ИмяФайла - Строка - имя файла артефакта.
//
// Возвращаемое значение:
//  Строка - тип содержимого для заголовка Content-Type; "" — расширение незнакомое,
//           и называть тип нечем.
//
Функция ПоИмениФайла(Знач ИмяФайла) Экспорт

	Известный = ТипыПоРасширению.Получить(Расширение(ИмяФайла));

	Возврат ?(Известный = Неопределено, "", Известный);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Расширение(Знач ИмяФайла)

	Текст = НРег(СокрЛП(Строка(?(ИмяФайла = Неопределено, "", ИмяФайла))));
	Точка = СтрНайти(Текст, ".", НаправлениеПоиска.СКонца);

	Возврат ?(Точка = 0, "", Сред(Текст, Точка + 1));

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()

	ТипыПоРасширению = Новый Соответствие();
	// описание версии читает человек и браузер: Markdown, а не поток байт
	ТипыПоРасширению.Вставить("md", "text/markdown; charset=utf-8");
	// пакет — архив: скачивается, а не показывается
	ТипыПоРасширению.Вставить("ospx", "application/octet-stream");

КонецПроцедуры
