// Задача планировщика «уборка-загрузок-артефактов»: временные файлы загрузок кэша артефактов,
// пережившие паузу, убираются по расписанию, а не только при следующей загрузке.

Перем Кэш;  // КэшАртефактов (хранилище)

// Регистрация в планировщике: уборка раз в минуту. Первый заход после старта убирает и то,
// что оставил прежний процесс.
//
// Параметры:
//  Регистрации - РегистрацииЗадачи - куда записывается регистрация.
//
Процедура Зарегистрировать(Регистрации) Экспорт
	Регистрации.КаждыеСекунд("уборка-загрузок-артефактов", ИнтервалСек());
КонецПроцедуры

// Выполняет одну уборку.
// Сбой перебрасывается планировщику.
//
&Наблюдаемый("job.artifact_downloads_gc")
Процедура Исполнить() Экспорт
	Кэш.УбратьОставленное();
КонецПроцедуры

// Файл, переживший паузу, лежит на диске лишнего не дольше интервала.
Функция ИнтервалСек()
	Возврат 60;
КонецФункции

&Прозвище("ЗадачаПланировщика")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "КэшАртефактов") _Кэш)
	Кэш = _Кэш;
КонецПроцедуры
