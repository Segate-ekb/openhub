// Потолок объёма хранилища — желудь модуля хранилище: бэкенд спрашивает его на операции,
// поэтому поднятый из формы порог судит уже следующую публикацию.

Перем Настройки;  // СервисНастроек (настройки)

// Действующий потолок объёма хранилища.
//
// Возвращаемое значение:
//  Число - потолок в байтах; 0 — хаб объём не ограничивает.
//
Функция ПотолокБайт() Экспорт
	Возврат Настройки.Значение("oshub.storage.quota.bytes");
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки) Экспорт

	Настройки = _Настройки;

КонецПроцедуры
