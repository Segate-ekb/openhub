// Неизменяемый объект-значение: пул / пакет / версия / имя файла. Каждая компонента —
// ровно один сегмент пути, path traversal отсекается здесь, до обращения к ФС.
// Канонизацию имён (регистр, NFC/NFD) не делает — это ответственность registry.
// Имя файла по умолчанию — каноническое для .ospx: "{пакет}-{версия}.ospx".

Перем ЗначениеПула;      // Строка - имя пула
Перем ЗначениеПакета;    // Строка - имя пакета
Перем ЗначениеВерсии;    // Строка - версия (semver или legacy)
Перем ЗначениеИмениФайла; // Строка - имя файла артефакта

// Имя пула.
//
// Возвращаемое значение:
//  Строка - имя пула.
//
Функция Пул() Экспорт
	Возврат ЗначениеПула;
КонецФункции

// Имя пакета.
//
// Возвращаемое значение:
//  Строка - имя пакета.
//
Функция Пакет() Экспорт
	Возврат ЗначениеПакета;
КонецФункции

// Версия пакета.
//
// Возвращаемое значение:
//  Строка - версия, semver либо legacy.
//
Функция Версия() Экспорт
	Возврат ЗначениеВерсии;
КонецФункции

// Имя файла артефакта.
//
// Возвращаемое значение:
//  Строка - имя файла.
//
Функция ИмяФайла() Экспорт
	Возврат ЗначениеИмениФайла;
КонецФункции

// Человекочитаемое представление координат для сообщений об ошибках и логов.
//
// Возвращаемое значение:
//  Строка - "пул/пакет/имя файла".
//
Функция Представление() Экспорт
	Возврат СтрШаблон("%1/%2/%3", ЗначениеПула, ЗначениеПакета, ЗначениеИмениФайла);
КонецФункции

Процедура ПриСозданииОбъекта(Знач Пул, Знач Пакет, Знач Версия, Знач ИмяФайла = "")

	ПроверитьКомпоненту("пул", Пул);
	ПроверитьКомпоненту("пакет", Пакет);
	ПроверитьКомпоненту("версия", Версия);

	Если НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
		ИмяФайла = СтрШаблон("%1-%2.ospx", Пакет, Версия);
	КонецЕсли;
	ПроверитьКомпоненту("имя файла", ИмяФайла);

	ЗначениеПула = Пул;
	ЗначениеПакета = Пакет;
	ЗначениеВерсии = Версия;
	ЗначениеИмениФайла = ИмяФайла;

КонецПроцедуры

Процедура ПроверитьКомпоненту(Знач НазваниеКомпоненты, Знач Значение)

	Если ТипЗнч(Значение) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение СтрШаблон(
			"Недопустимые координаты артефакта: компонента ""%1"" должна быть непустой строкой",
			НазваниеКомпоненты);
	КонецЕсли;

	Если СтрДлина(Значение) > МаксимальнаяДлинаКомпоненты() Тогда
		ВызватьИсключение СтрШаблон(
			"Недопустимые координаты артефакта: компонента ""%1"" длиннее %2 символов",
			НазваниеКомпоненты, МаксимальнаяДлинаКомпоненты());
	КонецЕсли;

	Если Значение = "." ИЛИ Значение = ".." Тогда
		ВызватьИсключение СтрШаблон(
			"Недопустимые координаты артефакта: компонента ""%1"" не может быть ""%2""",
			НазваниеКомпоненты, Значение);
	КонецЕсли;

	// хвостовые точки и пробелы Windows молча отбрасывает — имя на диске разошлось бы с координатами
	Если СтрЗаканчиваетсяНа(Значение, ".") ИЛИ СтрЗаканчиваетсяНа(Значение, " ")
		ИЛИ СтрНачинаетсяС(Значение, " ") Тогда
		ВызватьИсключение СтрШаблон(
			"Недопустимые координаты артефакта: компонента ""%1"" (значение ""%2"") не может начинаться или заканчиваться пробелом либо заканчиваться точкой",
			НазваниеКомпоненты, Значение);
	КонецЕсли;

	ЗапрещенныеСимволы = "/\:*?""<>|";

	Для НомерСимвола = 1 По СтрДлина(Значение) Цикл

		Символ = Сред(Значение, НомерСимвола, 1);

		Если СтрНайти(ЗапрещенныеСимволы, Символ) > 0 ИЛИ КодСимвола(Символ) < 32 Тогда
			ВызватьИсключение СтрШаблон(
				"Недопустимые координаты артефакта: компонента ""%1"" (значение ""%2"") содержит запрещённый символ",
				НазваниеКомпоненты, Значение);
		КонецЕсли;

	КонецЦикла;

	ПроверитьЗарезервированноеИмяWindows(НазваниеКомпоненты, Значение);

КонецПроцедуры

// Имена устройств Windows недопустимы как сегмент пути, в том числе с расширением (CON.ospx).
Процедура ПроверитьЗарезервированноеИмяWindows(Знач НазваниеКомпоненты, Знач Значение)

	БазоваяЧасть = Значение;
	ПозицияТочки = СтрНайти(БазоваяЧасть, ".");
	Если ПозицияТочки > 0 Тогда
		БазоваяЧасть = Лев(БазоваяЧасть, ПозицияТочки - 1);
	КонецЕсли;

	Если СтрНайти(ЗарезервированныеИменаWindows(), "," + ВРег(БазоваяЧасть) + ",") > 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Недопустимые координаты артефакта: компонента ""%1"" (значение ""%2"") — зарезервированное имя Windows",
			НазваниеКомпоненты, Значение);
	КонецЕсли;

КонецПроцедуры

Функция ЗарезервированныеИменаWindows()
	Возврат ",CON,PRN,AUX,NUL,"
		+ "COM1,COM2,COM3,COM4,COM5,COM6,COM7,COM8,COM9,"
		+ "LPT1,LPT2,LPT3,LPT4,LPT5,LPT6,LPT7,LPT8,LPT9,";
КонецФункции

Функция МаксимальнаяДлинаКомпоненты()
	// удерживает сегмент в файловых лимитах (255 байт у ext4/APFS/NTFS)
	Возврат 100;
КонецФункции
