// Потолок объёма хранилища и приговор по нему — общий для файлового и S3 бэкендов.
// Потолком бывает число либо источник с ПотолокБайт(): тогда он спрашивается на каждой записи.

Перем Фиксированный;  // Число - потолок, заданный числом; 0 = без лимита
Перем Источник;       // Объект с ПотолокБайт() либо Неопределено
Перем Вместимость;    // ВместимостьКвоты (хранилище) — правило «влезает ли новое в предел»

// Действующий потолок объёма.
//
// Возвращаемое значение:
//  Число - потолок в байтах; 0 — хаб объём не ограничивает.
//
Функция Байт() Экспорт
	Возврат ?(Источник = Неопределено, Фиксированный, Число(Источник.ПотолокБайт()));
КонецФункции

// Судит размещение артефакта: превышение потолка — исключение с числами.
//
// Параметры:
//  Занято - Число - занятый объём хранилища за вычетом перезаписываемого артефакта.
//  РазмерНового - Число - размер размещаемого артефакта.
//
Процедура Проверить(Знач Занято, Знач РазмерНового) Экспорт

	Потолок = Байт();
	Если НЕ Вместимость.Помещается(Занято, 0, РазмерНового, Потолок) Тогда
		ВызватьИсключение СтрШаблон(
			"Превышена квота хранилища: занято %1 из %2 байт, артефакт размером %3 байт не помещается",
			Формат(Занято, "ЧГ=0"), Формат(Потолок, "ЧГ=0"), Формат(РазмерНового, "ЧГ=0"));
	КонецЕсли;

КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач ЛимитОбъемаБайт = Неопределено, Знач ПотолокЖивой = Неопределено)

	Фиксированный = Число(?(ЗначениеЗаполнено(ЛимитОбъемаБайт), ЛимитОбъемаБайт, 0));

	Если Фиксированный < 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Некорректная конфигурация хранилища: квота oshub.storage.quota.bytes"
			+ " не может быть отрицательной (%1); 0 = без лимита", Формат(Фиксированный, "ЧГ=0"));
	КонецЕсли;

	Источник = ПотолокЖивой;
	Вместимость = Новый ВместимостьКвоты();

КонецПроцедуры
