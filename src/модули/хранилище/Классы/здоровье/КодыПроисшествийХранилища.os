// Машинные коды происшествий хранилища артефактов: обе причины про чужую сторону, обе
// проходят сами.

Перем Коды;  // ОбъявленияКодовПроисшествий (происшествия)

#Область ПубличныйИнтерфейс

// Имя подсистемы артефактов: S3 либо файловый корень.
//
// Возвращаемое значение:
//  Строка.
//
Функция Подсистема() Экспорт
	Возврат Коды.Подсистема();
КонецФункции

// Объявления кодов подсистемы в порядке объявления.
//
// Возвращаемое значение:
//  ОбъявленияКодовПроисшествий - имя подсистемы и её коды.
//
Функция Объявления() Экспорт
	Возврат Коды;
КонецФункции

// Хранилище артефактов не отвечает.
//
// Возвращаемое значение:
//  Строка.
//
Функция ХранилищеНеОтвечает() Экспорт
	Возврат Коды.Объявленный("storage_unreachable");
КонецФункции

// Хранилище артефактов не пустило: ключи, права, политика бакета.
//
// Возвращаемое значение:
//  Строка.
//
Функция ХранилищеНеПустило() Экспорт
	Возврат Коды.Объявленный("storage_denied");
КонецФункции

#КонецОбласти

&Прозвище("КодыПроисшествийПодсистемы")
&Порядок(30)
&Желудь
Процедура ПриСозданииОбъекта() Экспорт

	Коды = Новый ОбъявленияКодовПроисшествий("хранилище");

	Коды.Объявить("storage_unreachable", Истина);
	Коды.Объявить("storage_denied", Истина);

КонецПроцедуры
