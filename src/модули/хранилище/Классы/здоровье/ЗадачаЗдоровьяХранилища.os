// Задача планировщика «здоровье-хранилища»: регулярная проба доступности хранилища артефактов.
// Исход пробы запоминает СтражХранилища — экран спрашивает его, а не хранилище.

Перем Хранилище;   // ХранилищеАртефактов
Перем Интервал;    // интервал пробы из настройки, секунды

// Регистрация в планировщике: проба раз в интервал из настройки.
//
// Параметры:
//  Регистрации - РегистрацииЗадачи - куда записывается регистрация.
//
Процедура Зарегистрировать(Регистрации) Экспорт
	Регистрации.КаждыеСекунд("здоровье-хранилища", Интервал);
КонецПроцедуры

// Выполняет одну пробу хранилища: ответа она ждёт столько же, сколько любое обращение к нему.
// Сбой пробы перебрасывается планировщику.
//
&Наблюдаемый("job.storage_health")
Процедура Исполнить() Экспорт
	Хранилище.Доступность();
КонецПроцедуры

&Прозвище("ЗадачаПланировщика")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеАртефактов") _Хранилище,
	&Деталька(Значение = "oshub.jobs.storage_health_interval_sec", ЗначениеПоУмолчанию = 60) _Интервал = Неопределено)

	Хранилище = _Хранилище;
	Интервал = Новый ПриведениеЧисел().ЧислоИлиДефолт(_Интервал, 60);

КонецПроцедуры
