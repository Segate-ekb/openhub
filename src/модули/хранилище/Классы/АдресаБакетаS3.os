// Адреса объектов бакета: path-style (эндпоинт/бакет/ключ) и virtual-hosted
// (схема://бакет.хост/ключ). Сборку адреса oint наружу не отдаёт, а подписанному
// запросу со своим сроком адрес нужен готовым.

Перем Эндпоинт;   // Строка - адрес сервиса без бакета
Перем Бакет;      // Строка
Перем ПутьСтиль;  // Булево - Истина => имя бакета первым сегментом пути (MinIO)

#Область ПубличныйИнтерфейс

// Адрес объекта в бакете.
//
// Параметры:
//  Ключ - Строка - плоский ключ объекта.
//
// Возвращаемое значение:
//  Строка - полный адрес запроса.
//
Функция Объект(Знач Ключ) Экспорт
	Возврат Корзина() + Строка(Ключ);
КонецФункции

// Адрес самой корзины — со слешем на конце, сразу пригодный под ключ.
//
// Возвращаемое значение:
//  Строка.
//
Функция Корзина() Экспорт

	Если ПутьСтиль Тогда
		Возврат СоСлешем(СоСлешем(Эндпоинт) + Бакет);
	КонецЕсли;

	Возврат СоСлешем(СБакетомВИмени(СоСлешем(Эндпоинт)));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Virtual-hosted: имя бакета встаёт перед хостом, а схема остаётся своей.
Функция СБакетомВИмени(Знач Адрес)

	Признак = "://";
	Позиция = СтрНайти(Адрес, Признак);
	Если Позиция = 0 Тогда
		Возврат Бакет + "." + Адрес;
	КонецЕсли;

	Возврат Лев(Адрес, Позиция + СтрДлина(Признак) - 1) + Бакет + "."
		+ Сред(Адрес, Позиция + СтрДлина(Признак));

КонецФункции

Функция СоСлешем(Знач Адрес)
	Значение = Строка(Адрес);
	Возврат ?(СтрЗаканчиваетсяНа(Значение, "/"), Значение, Значение + "/");
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач АдресСервиса, Знач ИмяБакета, Знач АдресацияПутём = Истина)

	// значение-объект с позиционным конструктором: внедрять сюда нечем
	Эндпоинт = СокрЛП(Строка(АдресСервиса));
	Бакет = СокрЛП(Строка(ИмяБакета));
	ПутьСтиль = (АдресацияПутём = Истина);

КонецПроцедуры
