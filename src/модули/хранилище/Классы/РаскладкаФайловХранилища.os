// Раскладка файлов на диске: {корень}/pools/{пул}/{пакет}/{имя файла}. Имя пула и
// координаты приходят из данных, поэтому каждый собранный путь нормализуется и
// проверяется на выход за каталог pools — вторая линия защиты после КоординатАртефакта.
// Не желудь — создаётся ФайловымХранилищем от его корня.

Перем КаталогПулов;  // Строка - {корень}/pools

#Область ПубличныйИнтерфейс

// Каталог, под которым живут области всех пулов.
//
// Возвращаемое значение:
//  Строка - абсолютный путь.
//
Функция КореньПулов() Экспорт
	Возврат КаталогПулов;
КонецФункции

// Каталог области пула.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Строка - абсолютный путь.
//
// Выбрасывает исключение при пустом имени и при выходе пути за пределы корня.
//
Функция КаталогПула(Знач ИмяПула) Экспорт

	Если НЕ ЗначениеЗаполнено(ИмяПула) Тогда
		ВызватьИсключение "Не задано имя пула для операции над областью хранения";
	КонецЕсли;

	Возврат ВнутриКорня(Новый Файл(ОбъединитьПути(КаталогПулов, Строка(ИмяПула))).ПолноеИмя,
		СтрШаблон("Недопустимое имя пула ""%1"": путь области хранения выходит за пределы корня",
			ИмяПула));

КонецФункции

// Путь файла артефакта по координатам.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта.
//
// Возвращаемое значение:
//  Строка - абсолютный путь.
//
// Выбрасывает исключение, если путь выходит за пределы корня.
//
Функция ПутьАртефакта(Знач Координаты) Экспорт

	КаталогПакета = ОбъединитьПути(КаталогПулов, Координаты.Пул(), Координаты.Пакет());

	Возврат ВнутриКорня(Новый Файл(ОбъединитьПути(КаталогПакета, Координаты.ИмяФайла())).ПолноеИмя,
		СтрШаблон("Недопустимые координаты артефакта %1: путь выходит за пределы корня хранилища",
			Координаты.Представление()));

КонецФункции

// Путь файла по компонентам, без разбора координат — для уборки по описи.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//  ИмяФайла - Строка - имя файла артефакта.
//
// Возвращаемое значение:
//  Строка - абсолютный путь.
//
// Выбрасывает исключение, если путь выходит за пределы корня.
//
Функция ПутьФайла(Знач ИмяПула, Знач ИмяПакета, Знач ИмяФайла) Экспорт

	Собранный = ОбъединитьПути(КаталогПулов, Строка(ИмяПула), Строка(ИмяПакета));

	Возврат ВнутриКорня(Новый Файл(ОбъединитьПути(Собранный, Строка(ИмяФайла))).ПолноеИмя,
		СтрШаблон("Недопустимый путь артефакта для удаления: %1/%2/%3 выходит за пределы корня хранилища",
			ИмяПула, ИмяПакета, ИмяФайла));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВнутриКорня(Знач Путь, Знач ТекстОшибки)

	Если НЕ СтрНачинаетсяС(Путь, КаталогПулов + ПолучитьРазделительПути()) Тогда
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	Возврат Путь;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач КореньХранилища)
	КаталогПулов = ОбъединитьПути(Строка(КореньХранилища), "pools");
КонецПроцедуры
