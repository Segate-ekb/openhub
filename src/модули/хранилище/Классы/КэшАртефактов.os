// Содержимое артефактов для выдачи, кэшированное по sha256 версии; локальное хранилище — мимо кэша.

Перем Хранилище;           // ХранилищеАртефактов (хранилище)
Перем Хеши;                // Хеш (основа)
Перем ИмяБэкенда;          // Строка - "fs" либо "s3"
Перем ХранилищеУдалённое;  // Булево - артефакты лежат не на диске хаба
&Лог
Перем Лог;

// Содержимое артефакта, сверенное с контрольной суммой версии. Повторный вызов с той же
// суммой отдаёт содержимое из кэша, не обращаясь к хранилищу.
//
// Параметры:
//  Sha256 - Строка - контрольная сумма версии из реестра.
//  Координаты - КоординатыАртефакта - адрес артефакта в хранилище.
//
// Возвращаемое значение:
//  ДвоичныеДанные, Неопределено - содержимое; Неопределено, если хранилище локальное, сумма
//                                 пуста либо байты в хранилище с ней не совпали.
//
&Кэшируемый("артефакты")
Функция Содержимое(&КлючКэша Знач Sha256, Знач Координаты) Экспорт

	// адрес собирается, только когда строки отладки печатаются
	Адрес = "";
	Если Лог.Уровень() <= УровниЛога.Отладка Тогда
		Адрес = Координаты.Представление();
	КонецЕсли;

	Если НЕ ХранилищеУдалённое Тогда
		Лог.Отладка("Мимо кэша артефактов: %1 — хранилище не удалённое (бэкенд %2)", Адрес, ИмяБэкенда);
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Sha256) Тогда
		Лог.Отладка("Мимо кэша артефактов: %1 — у версии нет контрольной суммы", Адрес);
		Возврат Неопределено;
	КонецЕсли;

	Данные = Хранилище.ПолучитьДанные(Координаты);
	СуммаПрочитанного = Хеши.ОтДанных(Данные);
	Лог.Отладка("Чтение в кэш артефактов: %1 (sha256 %2) прочитан из хранилища, %3 байт",
		Адрес, НРег(Sha256), Данные.Размер());

	Если СуммаПрочитанного <> НРег(Sha256) Тогда
		Лог.Отладка("Мимо кэша артефактов: %1 — сумма не совпала: ждали %2, получили %3",
			Адрес, НРег(Sha256), СуммаПрочитанного);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Данные;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеАртефактов") _Хранилище,
	&Пластилин(Значение = "Хеш") _Хеши,
	&Лог _Лог = Неопределено)

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

	Хранилище = _Хранилище;
	Хеши = _Хеши;
	ИмяБэкенда = Хранилище.Бэкенд();
	ХранилищеУдалённое = ИмяБэкенда = "s3";

КонецПроцедуры
