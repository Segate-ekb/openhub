КонецПроцедуры

#КонецОбласти

#Область Доступность

// Контракт ХранилищеАртефактов: проба доступности, исход которой запоминает страж.
//
// Параметры:
//  СрокСек - Число - сколько ждать ответа, секунды.
//
// Возвращаемое значение:
//  Структура - Успех, ОтказДоступа, Сообщение.
//
Функция Доступность(Знач СрокСек) Экспорт

	Проба = Бэкенд_.Доступность(СрокСек);
	// вердикт пробы разбирает сам страж: только он знает, что боевой отказ весомее
	Страж.ПринятьПробу(Проба);
	Возврат Проба;

КонецФункции

#КонецОбласти

#Область Диагностика

// Контракт реализации: имя бэкенда.
//
// Возвращаемое значение:
//  Строка.
//
Функция Бэкенд() Экспорт
	Возврат Бэкенд_.Бэкенд();
КонецФункции

// Контракт файлового бэкенда: корень данных.
//
// Возвращаемое значение:
//  Строка.
//
Функция Корень() Экспорт
	Возврат Бэкенд_.Корень();
КонецФункции

// Контракт файлового бэкенда: корень данных по умолчанию.
//
// Возвращаемое значение:
//  Строка.
//
Функция КореньПоУмолчанию() Экспорт
	Возврат Бэкенд_.КореньПоУмолчанию();
КонецФункции

// Контракт объектного бэкенда: число невозвращённых выдач.
//
// Возвращаемое значение:
//  Число.
//
Функция ЧислоВыданныхКопий() Экспорт
	Возврат Бэкенд_.ЧислоВыданныхКопий();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Исключение бэкенда страж слышит по машинному коду. Сбой — только отказ ЗАВИСИМОСТИ.
// «Объекта нет» — не сбой, а ответ по существу: хранилище живо и ответило, это успех.
// Прочее (негодная сумма и т.п.) о доступности хранилища не говорит ничего.
//
// Своя Попытка здесь обязательна: отметка стоит ПЕРЕД перебросом, и сбой внутри неё
// подменил бы вызывающему исходный отказ хранилища своим — отказ потерял бы причину.
Процедура ОтметитьИсключениеБэкенда(Знач Инфо)

	Попытка
		Если ДиагностикаОшибок.Содержит(Инфо, КодыСтандартныхОшибок.ЗависимостьНедоступна()) Тогда
			Страж.ОтметитьБоевойОтказ(Ошибки.Фраза(Инфо));
		ИначеЕсли ДиагностикаОшибок.Содержит(Инфо, КодыСтандартныхОшибок.РесурсНеНайден()) Тогда
			Страж.ОтметитьБоевойУспех();
		КонецЕсли;
	Исключение
		Пожаловаться(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Страж молчит наружу, но не молчит в журнале: пропавшее объяснение неудачи само стало бы
// необъяснимым.
Процедура Пожаловаться(Знач Инфо)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Лог.Предупреждение("Страж хранилища не принял боевой отказ, работа продолжается: %1",
		Ошибки.Причина(Инфо));

КонецПроцедуры

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач Хранилище, Знач НовыйСтраж, Знач НовыйЛог = Неопределено)

	Если Хранилище = Неопределено ИЛИ НовыйСтраж = Неопределено Тогда
		ВызватьИсключение "ХранилищеПодСтражем требует хранилище и стража: без них ему нечего"
			+ " делегировать и некому объявлять";
	КонецЕсли;

	Бэкенд_ = Хранилище;
	Страж = НовыйСтраж;
	Ошибки = Новый ТекстОшибки();
	Лог = НовыйЛог;

КонецПроцедуры
