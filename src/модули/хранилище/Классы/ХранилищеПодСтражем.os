// Хранилище артефактов, каждый ответ которого слышит страж: удался вызов — «отвечает»,
// отказала зависимость — «не отвечает», проба — своим троичным вердиктом. Своего
// поведения у класса нет: работу делает бэкенд, а страж узнаёт о ней, не дожидаясь пробы.

#Использовать errors

Перем Бэкенд_;  // ХранилищеАртефактов — настоящее хранилище
Перем Страж;    // СтражХранилища (хранилище)
Перем Ошибки;   // ТекстОшибки (основа) — фраза отказа для человека
Перем Лог;      // Лог создателя: класс не желудь, инъекции ОСени сюда не доезжают

#Область Артефакты

// Контракт ХранилищеАртефактов.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта в хранилище.
//  Источник - Строка, ДвоичныеДанные - путь к файлу либо содержимое артефакта.
//
// Возвращаемое значение:
//  Структура - Sha256, Размер.
//
Функция Сохранить(Знач Координаты, Знач Источник) Экспорт

	Попытка
		Результат = Бэкенд_.Сохранить(Координаты, Источник);
	Исключение
		ОтметитьИсключениеБэкенда(ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

	Страж.ОтметитьБоевойУспех();
	Возврат Результат;

КонецФункции

// Контракт ХранилищеАртефактов.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта в хранилище.
//  ОжидаемыйSha256 - Строка - контрольная сумма для сверки (необязательный).
//
// Возвращаемое значение:
//  Строка - путь к файлу с содержимым артефакта.
//
Функция Получить(Знач Координаты, Знач ОжидаемыйSha256 = "") Экспорт

	Попытка
		Результат = Бэкенд_.Получить(Координаты, ОжидаемыйSha256);
	Исключение
		ОтметитьИсключениеБэкенда(ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

	Страж.ОтметитьБоевойУспех();
	Возврат Результат;

КонецФункции

// Контракт ХранилищеАртефактов: освобождение выданного пути хранилища не спрашивает.
//
// Параметры:
//  Путь - Строка - путь, полученный из Получить.
//
Процедура ОсвободитьВыдачу(Знач Путь) Экспорт
	Бэкенд_.ОсвободитьВыдачу(Путь);
КонецПроцедуры

// Контракт ХранилищеАртефактов.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта в хранилище.
//  ОжидаемыйSha256 - Строка - контрольная сумма для сверки (необязательный).
//
// Возвращаемое значение:
//  ДвоичныеДанные - содержимое артефакта.
//
Функция ПолучитьДанные(Знач Координаты, Знач ОжидаемыйSha256 = "") Экспорт

	Попытка
		Результат = Бэкенд_.ПолучитьДанные(Координаты, ОжидаемыйSha256);
	Исключение
		ОтметитьИсключениеБэкенда(ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;

	Страж.ОтметитьБоевойУспех();
	Возврат Результат;

КонецФункции

