// Рогатка старта: срок ответа запросов через oint из oshub.storage.s3.timeout.sec — раньше прочих рогаток,
// до первого запроса к корзине S3 и к Bot API Telegram.

Перем Назначенный; // Число - срок из настройки, секунды

#Область ПубличныйИнтерфейс

// Ставит срок из настройки всем запросам через oint в этом процессе.
//
Процедура ПриЗапускеПриложения() Экспорт
	Срок = Новый СрокОтветаOint();
	Срок.Установить(Назначенный);
КонецПроцедуры

#КонецОбласти

// мусор и пусто — умолчание реестра; меньше секунды Установить поднимает до секунды
&Рогатка(ЗапускатьВФоне = Ложь)
&Порядок(0)
Процедура ПриСозданииОбъекта(
	&Деталька(Значение = "oshub.storage.s3.timeout.sec", ЗначениеПоУмолчанию = "") СыройСрок = "")

	Назначенный = Новый ПриведениеЧисел().ЧислоИлиДефолт(СыройСрок, 30);

КонецПроцедуры
