// Клиент S3 для S3Хранилище поверх oint (OPI_S3): плоские ключи, SigV4, загрузка частями по 5 МиБ, процессный срок
// oint; формат oint скрыт, отказы — кодами errors. Фейк тестов — ФейкКлиентS3. Не желудь: создаёт КонфигурацияХранилища.

#Использовать oint
#Использовать errors

Перем ОсновныеДанные; // Структура - данные запроса oint (URL/AccessKey/SecretKey/Region)
Перем Бакет;         // Строка   - имя бакета
Перем ФорсПутьСтиль; // Булево   - path-style адресация (для MinIO)
Перем Вердикт;       // ВердиктОтветаS3 (хранилище) — приговор по структуре ответа
Перем Срок;          // СрокОтветаOint (хранилище) — сколько oint ждёт ответа, для слов отказа
Перем Лог;           // Лог создателя: класс не желудь, инъекции ОСени сюда не доезжают
Перем Числа;         // ПриведениеЧисел (основа)
Перем Флаги;         // ПриведениеФлагов (основа) — «true» протокола S3
Перем Ошибки;        // ТекстОшибки (основа) — краткая диагностика без своих ключей

// Загружает объект по ключу; тело больше части уходит multipart, упавшая часть повторяется теми же байтами.
//
// Параметры:
//  Ключ - Строка - плоский ключ объекта в бакете.
//  Источник - Строка, ДвоичныеДанные - путь к существующему файлу либо содержимое объекта.
//  ТипСодержимого - Строка - чем объект является (Content-Type); "" — тип не называется
//                   и остаётся тем, который проставит транспорт (необязательный).
//
// Выбрасывает dependency.unavailable при коде ответа вне 2xx, если хранилище не ответило за срок и если
// часть не легла и после повторов.
//
Процедура Положить(Знач Ключ, Знач Источник, Знач ТипСодержимого = "") Экспорт

	Попытка
		Ответ = OPI_S3.ЗагрузитьОбъект(Ключ, Бакет, Источник, ОсновныеДанные,
			ЗаголовкиТипа(ТипСодержимого), ФорсПутьСтиль);
	Исключение
		ВызватьИсключение ОтказОбмена("загрузка", Ключ, ИнформацияОбОшибке());
	КонецПопытки;

	Код = Вердикт.Статус(Ответ);
	Лог.Отладка("S3: положили ""%1"" в бакет ""%2"", статус %3", Ключ, Бакет, Код);
	Если Код > 299 Тогда
		ВызватьИсключение СтандартныеОшибки.ЗависимостьНедоступна(АдресБакета(), СтрШаблон(
			"Ошибка загрузки объекта S3 ""%1"": сервер вернул статус %2. %3",
			Ключ, Формат(Код, "ЧГ=0"), Вердикт.ПояснениеОтказа(Ответ)));
	КонецЕсли;

КонецПроцедуры

// Скачивает объект прямо в файл: описание, затем один GET, тело пишется по мере прихода байтов — файл читают,
// не дожидаясь конца.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//  ПутьСохранения - Строка - путь целевого файла; перезаписывается.
//
// Выбрасывает resource.not_found, если хранилище ответило «нет объекта», dependency.unavailable, если
// оно не ответило за срок либо отказало, и исключение без кода с причиной, если скачивание оборвалось
// по ходу: часть объекта не пришла, файл не записался.
//
Процедура Скачать(Знач Ключ, Знач ПутьСохранения) Экспорт

	Попытка
		Результат = OPI_S3.ПолучитьОбъект(Ключ, Бакет, ОсновныеДанные, "", , ПутьСохранения, ФорсПутьСтиль);
	Исключение
		ВызватьИсключение ОтказСкачивания(Ключ, ИнформацияОбОшибке());
	КонецПопытки;

	// успех — путь к записанному файлу; иначе oint вернул структуру-описание ответа
	Если ТипЗнч(Результат) = Тип("Строка") Тогда
		Лог.Отладка("S3: скачали ""%1"" из бакета ""%2"" в %3", Ключ, Бакет, ПутьСохранения);
		Возврат;
	КонецЕсли;

	ВызватьИсключение ОтказЧтения(Ключ, Результат, "скачивание");

КонецПроцедуры

// Проверяет наличие объекта HEAD-запросом.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//
// Возвращаемое значение:
//  Булево - Истина, если объект существует; Ложь, если хранилище сказало «его нет».
//
// Выбрасывает dependency.unavailable, если хранилище не ответило по существу: молчаливое
// «объекта нет» на лежащем S3 увело бы вызывающего отвечать 404 вместо 503.
//
Функция Существует(Знач Ключ) Экспорт

	Ответ = ОписаниеОбъекта(Ключ);

	Если Вердикт.ХранилищеНеОтветилоПоСуществу(Ответ) Тогда
		ВызватьИсключение ОтказПоОбъекту(Ключ, Ответ);
	КонецЕсли;

	Возврат Вердикт.Успех(Ответ);

КонецФункции

// Отдаёт ответ хранилища на описание объекта как есть: статус вне 2xx не отказ, приговор по нему
// выносит вызывающий через ВердиктОтветаS3.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//
// Возвращаемое значение:
//  Структура - ответ хранилища: status, headers.
//
// Выбрасывает dependency.unavailable, если ответа не было вовсе: срок вышел, соединение отбито,
// имя не разрешилось.
//
Функция ОписаниеОбъекта(Знач Ключ) Экспорт

	Попытка
		Ответ = OPI_S3.ПолучитьОписаниеОбъекта(Ключ, Бакет, ОсновныеДанные, , , ФорсПутьСтиль);
	Исключение
		ВызватьИсключение ОтказОбмена("описание", Ключ, ИнформацияОбОшибке());
	КонецПопытки;

	Лог.Отладка("S3: описание ""%1"" в бакете ""%2"" — статус %3", Ключ, Бакет, Вердикт.Статус(Ответ));
	Возврат Ответ;

КонецФункции

// Возвращает размер объекта по заголовку Content-Length HEAD-ответа.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//
// Возвращаемое значение:
//  Число - размер в байтах.
//
// Выбрасывает resource.not_found, если хранилище ответило «нет объекта»,
// и dependency.unavailable, если не ответило за срок, отказало либо описало объект без Content-Length.
//
Функция Размер(Знач Ключ) Экспорт

	Ответ = ОписаниеОбъекта(Ключ);

	Если НЕ Вердикт.Успех(Ответ) Тогда
		ВызватьИсключение ОтказЧтения(Ключ, Ответ, "описание");
	КонецЕсли;

	Длина = Вердикт.ДлинаСодержимого(Ответ);
	Если Длина < 0 Тогда
		ВызватьИсключение ОтказБезДлины(Ключ);
	КонецЕсли;

	Возврат Длина;

КонецФункции

// Удаляет объект. Идемпотентна: отсутствие объекта не ошибка.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//
// Выбрасывает dependency.unavailable при коде ответа вне 2xx, кроме 404, и если хранилище не ответило за срок.
//
Процедура Удалить(Знач Ключ) Экспорт

	Попытка
		Ответ = OPI_S3.УдалитьОбъект(Ключ, Бакет, ОсновныеДанные, , , ФорсПутьСтиль);
	Исключение
		ВызватьИсключение ОтказОбмена("удаление", Ключ, ИнформацияОбОшибке());
	КонецПопытки;

	Код = Вердикт.Статус(Ответ);

	Лог.Отладка("S3: удалили ""%1"" из бакета ""%2"", статус %3", Ключ, Бакет, Код);

	// 404 — объект уже отсутствует, это идемпотентность, а не ошибка
	Если Код > 299 И Код <> 404 Тогда
		ВызватьИсключение СтандартныеОшибки.ЗависимостьНедоступна(АдресБакета(), СтрШаблон(
			"Ошибка удаления объекта S3 ""%1"": сервер вернул статус %2. %3",
			Ключ, Формат(Код, "ЧГ=0"), Вердикт.ПояснениеОтказа(Ответ)));
	КонецЕсли;

КонецПроцедуры

// Перечисляет объекты бакета по префиксу с постраничным обходом; читает только метаданные.
// Префикс уходит серверу целиком: листинг пула не перечисляет соседние пулы бакета.
//
// Параметры:
//  Префикс - Строка - префикс ключей, например "pools/main/".
//
// Возвращаемое значение:
//  Массив из Структура - Ключ (Строка), Размер (Число), Изменён (Дата, LastModified).
//
// Выбрасывает dependency.unavailable при ошибке сервера, при усечении списка без токена продолжения
// и если хранилище не ответило за срок.
//
Функция Перечислить(Знач Префикс) Экспорт

	Результат = Новый Массив();
	СерверныйПрефикс = Префикс;
	Токен = "";

	Пока Истина Цикл

		Попытка
			Ответ = OPI_S3.ПолучитьСписокОбъектов(Бакет, ОсновныеДанные, СерверныйПрефикс, Токен, , ФорсПутьСтиль);
		Исключение
			ВызватьИсключение ОтказОбмена("листинг", Префикс, ИнформацияОбОшибке());
		КонецПопытки;

		Код = Вердикт.Статус(Ответ);
		Если Код > 299 Тогда
			ВызватьИсключение СтандартныеОшибки.ЗависимостьНедоступна(АдресБакета(), СтрШаблон(
				"Ошибка получения списка объектов S3 (префикс ""%1""): статус %2. %3",
				Префикс, Формат(Код, "ЧГ=0"), Вердикт.ПояснениеОтказа(Ответ)));
		КонецЕсли;

		РезультатСписка = Вердикт.ЗначениеПоля(Ответ["response"], "ListBucketResult");
		Если РезультатСписка = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Для Каждого Элемент Из ВМассив(Вердикт.ЗначениеПоля(РезультатСписка, "Contents")) Цикл
			Ключ = Строка(Вердикт.ЗначениеПоля(Элемент, "Key"));
			// сверка префикса и на клиенте: сервер, читающий префикс шире, чужого не подсунет
			Если ЗначениеЗаполнено(Префикс) И НЕ СтрНачинаетсяС(Ключ, Префикс) Тогда
				Продолжить;
			КонецЕсли;
			Результат.Добавить(Новый Структура("Ключ, Размер, Изменён",
				Ключ,
				ВЧисло(Вердикт.ЗначениеПоля(Элемент, "Size")),
				ВДату(Вердикт.ЗначениеПоля(Элемент, "LastModified"))));
		КонецЦикла;

		Усечён = Флаги.ФлагТолькоTrue(Вердикт.ЗначениеПоля(РезультатСписка, "IsTruncated"));
		СледующийТокен = Вердикт.ЗначениеПоля(РезультатСписка, "NextContinuationToken");

		Если НЕ Усечён Тогда
			Прервать;
		КонецЕсли;

		// без токена продолжения — отказ, а не тихий недосчёт квоты
		Если СледующийТокен = Неопределено Тогда
			ВызватьИсключение СтандартныеОшибки.ЗависимостьНедоступна(АдресБакета(), СтрШаблон(
				"Список объектов S3 (префикс ""%1"") усечён на %2 записях, но сервер не вернул токен продолжения",
				Префикс, Формат(Результат.Количество(), "ЧГ=0")));
		КонецЕсли;

		Токен = Строка(СледующийТокен);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ПриСозданииОбъекта(Знач Эндпоинт, Знач Регион, Знач ИмяБакета, Знач AccessKey,
	Знач SecretKey, Знач ПутьСтиль = Истина, Знач НовыйЛог = Неопределено)

	Если НовыйЛог = Неопределено Тогда
		ВызватьИсключение "КлиентS3Oint создан без лога — создатель обязан передать свой лог";
	КонецЕсли;
	Лог = НовыйЛог;
	// клиент не желудь: его создаёт фабрика хранилища, инъекции сюда не доезжают
	Числа = Новый ПриведениеЧисел();
	Флаги = Новый ПриведениеФлагов();
	Ошибки = Новый ТекстОшибки();
	Срок = Новый СрокОтветаOint();

	ОсновныеДанные = OPI_S3.ПолучитьСтруктуруДанных(Эндпоинт, AccessKey, SecretKey, Регион);
	// часть — сколько oint держит в памяти за раз при загрузке частями
	ОсновныеДанные.Вставить("ChunkSize", РазмерЧасти());
	Бакет = Строка(ИмяБакета);
	ФорсПутьСтиль = (ПутьСтиль = Истина);
	Вердикт = Новый ВердиктОтветаS3();

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Наименьшая часть multipart, которую принимает S3: меньше — отказ сервера.
Функция РазмерЧасти()
	Возврат 5242880;
КонецФункции

// Тип содержимого едет заголовком запроса: у загрузки частями он же уходит в инициализацию
// multipart, и бакет запоминает его для собранного объекта. Неназванный тип заголовков
// не добавляет вовсе — объект получит тот, что проставит транспорт.
Функция ЗаголовкиТипа(Знач ТипСодержимого)

	Если НЕ ЗначениеЗаполнено(ТипСодержимого) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", Строка(ТипСодержимого));

	Возврат Заголовки;

КонецФункции

// Сбой любого обмена, кроме скачивания, — отказ корзины: не ответила либо не приняла часть и после повторов.
Функция ОтказОбмена(Знач Операция, Знач Ключ, Знач Сбой)

	Причина = БезСвоихСекретов(Ошибки.Фраза(Сбой));
	Лог.Отладка("S3: %1 ""%2"" в бакете ""%3"" не состоялось: %4", Операция, Ключ, Бакет, Причина);

	Если ОтветаНеБыло(Сбой) Тогда
		Возврат НеОтветила();
	КонецЕсли;

	Возврат СтандартныеОшибки.ЗависимостьНедоступна(АдресБакета(), СтрШаблон(
		"Обмен с хранилищем S3 (%1 ""%2"") не состоялся: %3", Операция, Ключ, Причина));

КонецФункции

// Обрыв тела и сбой записи файла неразличимы, а хаб на диске — не корзина: такой сбой без кода.
Функция ОтказСкачивания(Знач Ключ, Знач Сбой)

	Причина = БезСвоихСекретов(Ошибки.Фраза(Сбой));
	Лог.Отладка("S3: скачивание ""%1"" из бакета ""%2"" не состоялось: %3", Ключ, Бакет, Причина);

	Если ОтветаНеБыло(Сбой) Тогда
		Возврат НеОтветила();
	КонецЕсли;

	Возврат СтрШаблон("Скачивание объекта S3 ""%1"" оборвалось: %2", Ключ, Причина);

КонецФункции

Функция НеОтветила()
	Возврат СтандартныеОшибки.ЗависимостьНедоступна(АдресБакета(), СтрШаблон(
		"хранилище не ответило (срок ожидания — %1 с)", Формат(Срок.Секунд(), "ЧГ=0")));
КонецФункции

// Пока ответа нет (срок, отказ соединения, имя), платформа бросает WebException, а oint кладёт её текст в своё.
Функция ОтветаНеБыло(Знач Сбой)
	Возврат СтрНайти(Сбой.Описание, "System.Net.WebException") > 0;
КонецФункции

// Диагностику собирает чужая библиотека: вычеркнуть свои ключи обязан тот, чьи они.
Функция БезСвоихСекретов(Знач Текст)
	Очищенный = Ошибки.БезСекрета(Ошибки.Кратко(Текст), ОсновныеДанные["SecretKey"]);
	Возврат Ошибки.БезСекрета(Очищенный, ОсновныеДанные["AccessKey"]);
КонецФункции

// Отказ хранилища называется машинным кодом библиотеки errors: приговор «объекта нет»
// против «хранилище не смогло» выносит ВердиктОтветаS3 по структуре ответа.
Функция ОтказПоОбъекту(Знач Ключ, Знач Ответ)

	Код = Формат(Вердикт.Статус(Ответ), "ЧГ=0");

	Если Вердикт.ЭтоОтсутствие(Ответ) Тогда
		Возврат СтандартныеОшибки.РесурсНеНайден(Ключ, СтрШаблон(
			"Объект S3 не найден: %1 (бакет ""%2"", статус %3)", Ключ, Бакет, Код));
	КонецЕсли;

	Возврат СтандартныеОшибки.ЗависимостьНедоступна(АдресБакета(), СтрШаблон(
		"Хранилище S3 не отдало объект ""%1"": статус %2. %3",
		Ключ, Код, Вердикт.ПояснениеОтказа(Ответ)));

КонецФункции

// Чтение не дало содержимого: хранилище отказало либо описало объект без длины.
Функция ОтказЧтения(Знач Ключ, Знач Ответ, Знач Операция)

	Лог.Отладка("S3: %1 ""%2"" из бакета ""%3"" не состоялось, статус %4",
		Операция, Ключ, Бакет, Вердикт.Статус(Ответ));

	Если Вердикт.Успех(Ответ) Тогда
		Возврат ОтказБезДлины(Ключ);
	КонецЕсли;

	Возврат ОтказПоОбъекту(Ключ, Ответ);

КонецФункции

// Хранилище ответило успехом, но размер объекта из ответа не читается: отдавать нечего.
Функция ОтказБезДлины(Знач Ключ)
	Возврат СтандартныеОшибки.ЗависимостьНедоступна(АдресБакета(), СтрШаблон(
		"Хранилище S3 описало объект ""%1"" без заголовка Content-Length: размер неизвестен",
		Ключ));
КонецФункции

// Имя зависимости в стандартной ошибке: бакет, а не эндпоинт с ключами доступа.
Функция АдресБакета()
	Возврат "s3://" + Бакет;
КонецФункции

// XML-парсер oint кладёт одиночный повторяемый элемент как коллекцию, несколько — как массив.
Функция ВМассив(Знач Значение)
	Результат = Новый Массив();
	Если Значение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;
	Результат.Добавить(Значение);
	Возврат Результат;
КонецФункции

Функция ВЧисло(Знач Значение)
	Возврат Числа.ЧислоИлиНоль(Значение);
КонецФункции

Функция ВДату(Знач Значение)
	Попытка
		Возврат ПрочитатьДатуJSON(Строка(Значение), ФорматДатыJSON.ISO);
	Исключение
		Возврат '00010101';
	КонецПопытки;
КонецФункции

#КонецОбласти
