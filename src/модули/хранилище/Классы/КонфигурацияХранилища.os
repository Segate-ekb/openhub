// Фабрика (&Дуб) хранилища артефактов: единственная точка регистрации прозвища
// "ХранилищеАртефактов". Бэкенд — деталька oshub.storage.backend ("file" | "s3").

Перем Бэкенд;          // Строка - "file" | "s3"
Перем КореньДанных;    // Строка - каталог данных файлового бэкенда
Перем Потолок;         // ПотолокХранилища (хранилище) — живой лимит суммарного объёма
Перем S3Эндпоинт;      // Строка
Перем S3Регион;        // Строка
Перем S3Бакет;         // Строка
Перем S3Префикс;       // Строка
Перем S3ПутьСтиль;     // Булево - path-style (для MinIO)
Перем S3AccessKey;     // Строка - ключ доступа: значением либо файлом
Перем S3SecretKey;     // Строка - секретный ключ: значением либо файлом
Перем Страж;           // СтражХранилища (хранилище) — память о доступности; опционален
Перем Лог;
Перем Флаги;            // ПриведениеФлагов (основа) — чтение булева из детальки

// Собирает реализацию контракта ХранилищеАртефактов по конфигурации.
//
// Возвращаемое значение:
//  ХранилищеАртефактов - S3Хранилище при backend=s3, иначе ФайловоеХранилище; под стражем,
//                        если он задан.
//
// Выбрасывает исключение, если для backend=s3 не задан бакет, эндпоинт или ключи доступа.
//
&Завязь(Значение = "ХранилищеАртефактов", Тип = "ХранилищеАртефактов")
&Прозвище("ХранилищеАртефактов")
Функция ХранилищеАртефактов() Экспорт

	Если НРег(Бэкенд) = "s3" Тогда
		Лог.Информация("Бэкенд хранилища артефактов: S3 (бакет ""%1"", эндпоинт ""%2"", path-style=%3)",
			S3Бакет, S3Эндпоинт, ?(S3ПутьСтиль, "да", "нет"));
		// ключи доступа называются фактом наличия: в журнал не попадает ни один их символ
		Лог.Отладка("Хранилище: регион ""%1"", префикс ""%2"", ключ доступа задан: %3,"
			+ " секретный ключ задан: %4",
			S3Регион, S3Префикс, ЗначениеЗаполнено(S3AccessKey), ЗначениеЗаполнено(S3SecretKey));
		Возврат ПодСтражем(СобратьS3());
	КонецЕсли;

	Лог.Информация("Бэкенд хранилища артефактов: файловый (каталог ""%1"")", КореньДанных);
	Лог.Отладка("Хранилище: значение oshub.storage.backend — ""%1"", потолок объёма задан: %2",
		Бэкенд, Потолок <> Неопределено);
	Возврат ПодСтражем(Новый ФайловоеХранилище(КореньДанных, 0, Потолок));

КонецФункции

&Дуб
Процедура ПриСозданииОбъекта(
	&Деталька(Значение = "oshub.storage.backend", ЗначениеПоУмолчанию = "") СыройБэкенд = Неопределено,
	&Деталька(Значение = "oshub.storage.root", ЗначениеПоУмолчанию = "") СыройКорень = Неопределено,
	&Деталька(Значение = "oshub.storage.s3.endpoint", ЗначениеПоУмолчанию = "") СыройЭндпоинт = Неопределено,
	&Деталька(Значение = "oshub.storage.s3.region", ЗначениеПоУмолчанию = "") СыройРегион = Неопределено,
	&Деталька(Значение = "oshub.storage.s3.bucket", ЗначениеПоУмолчанию = "") СыройБакет = Неопределено,
	&Деталька(Значение = "oshub.storage.s3.force_path_style", ЗначениеПоУмолчанию = "") СыройПутьСтиль = Неопределено,
	&Деталька(Значение = "oshub.storage.s3.prefix", ЗначениеПоУмолчанию = "") СыройПрефикс = Неопределено,
	&Пластилин(Значение = "ПотолокХранилища") _Потолок = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "СтражХранилища") _Страж = Неопределено,
	&Деталька(Значение = "oshub.storage.s3.access_key", ЗначениеПоУмолчанию = "") КлючДоступа = Неопределено,
	&Деталька(Значение = "oshub.storage.s3.access_key_file", ЗначениеПоУмолчанию = "") ФайлКлючаДоступа = Неопределено,
	&Деталька(Значение = "oshub.storage.s3.secret_key", ЗначениеПоУмолчанию = "") СекретныйКлюч = Неопределено,
	&Деталька(Значение = "oshub.storage.s3.secret_key_file", ЗначениеПоУмолчанию = "") ФайлСекретногоКлюча = Неопределено)

	// Лог параметром, а не полем: инъекция в поле доезжает только ПОСЛЕ ПриСозданииОбъекта,
	// а предупреждения пишутся из конструктора
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "КонфигурацияХранилища создана без лога — контейнер или тест обязан его передать";
	КонецЕсли;
	Лог = _Лог;
	Флаги = Новый ПриведениеФлагов();
	Страж = _Страж;

	Бэкенд = ?(ЗначениеЗаполнено(СыройБэкенд), СокрЛП(Строка(СыройБэкенд)), "file");

	КореньДанных = ?(ЗначениеЗаполнено(СыройКорень), Строка(СыройКорень), "./data");
	Потолок = _Потолок;

	S3Эндпоинт = ?(ЗначениеЗаполнено(СыройЭндпоинт), СокрЛП(Строка(СыройЭндпоинт)), "");
	S3Регион = ?(ЗначениеЗаполнено(СыройРегион), СокрЛП(Строка(СыройРегион)), "us-east-1");
	S3Бакет = ?(ЗначениеЗаполнено(СыройБакет), СокрЛП(Строка(СыройБакет)), "");
	S3Префикс = ?(ЗначениеЗаполнено(СыройПрефикс), СокрЛП(Строка(СыройПрефикс)), "");
	S3ПутьСтиль = ПрочитатьБулево(СыройПутьСтиль, Истина);

	Секреты = Новый СекретИзФайла(Лог);
	S3AccessKey = Секреты.Секрет(КлючДоступа, ФайлКлючаДоступа, "oshub.storage.s3.access_key_file");
	S3SecretKey = Секреты.Секрет(СекретныйКлюч, ФайлСекретногоКлюча, "oshub.storage.s3.secret_key_file");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Страж приезжает желудём, поэтому в живом хабе он есть всегда. Собранная руками фабрика
// (тест, скрипт) обходится без него: слушать отказы тогда некому, и хранилище идёт как есть.
Функция ПодСтражем(Знач Хранилище)
	Возврат ?(Страж = Неопределено, Хранилище,
		Новый ХранилищеПодСтражем(Хранилище, Страж, Лог));
КонецФункции

Функция СобратьS3()

	ОшибкиКонфига = Новый Массив();
	Если НЕ ЗначениеЗаполнено(S3Бакет) Тогда
		ОшибкиКонфига.Добавить("не задан бакет (oshub.storage.s3.bucket)");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(S3Эндпоинт) Тогда
		ОшибкиКонфига.Добавить("не задан эндпоинт (oshub.storage.s3.endpoint)");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(S3AccessKey) Тогда
		ОшибкиКонфига.Добавить("не задан ключ доступа (oshub.storage.s3.access_key либо файлом — oshub.storage.s3.access_key_file)");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(S3SecretKey) Тогда
		ОшибкиКонфига.Добавить("не задан секретный ключ (oshub.storage.s3.secret_key либо файлом — oshub.storage.s3.secret_key_file)");
	КонецЕсли;

	Если ОшибкиКонфига.Количество() > 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Ошибка конфигурации S3-хранилища (oshub.storage.backend=s3): %1",
			СтрСоединить(ОшибкиКонфига, "; "));
	КонецЕсли;

	Клиент = Новый КлиентS3Oint(S3Эндпоинт, S3Регион, S3Бакет, S3AccessKey, S3SecretKey,
		S3ПутьСтиль, Лог);
	Возврат Новый S3Хранилище(Клиент, S3Префикс, 0, Потолок);

КонецФункции

// Значения детальки из окружения/файла приходят строками.
Функция ПрочитатьБулево(Знач Значение, Знач ПоУмолчанию)
	Возврат Флаги.ФлагОкружения(Значение, ПоУмолчанию);
КонецФункции

#КонецОбласти
