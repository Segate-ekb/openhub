// Фабрика (&Дуб) хранилища артефактов: единственная точка регистрации прозвища
// "ХранилищеАртефактов" — сами реализации его не берут, иначе выбор по конфигу невозможен.
// Бэкенд — деталька oshub.storage.backend ("fs" | "s3"); ключи доступа S3 — только из окружения.

Перем Бэкенд;          // Строка - "fs" | "s3"
Перем КореньДанных;    // Строка - каталог данных файлового бэкенда
Перем Потолок;         // ПотолокХранилища (хранилище) — живой лимит суммарного объёма
Перем S3Эндпоинт;      // Строка
Перем S3Регион;        // Строка
Перем S3Бакет;         // Строка
Перем S3Префикс;       // Строка
Перем S3ПутьСтиль;     // Булево - path-style (для MinIO)
Перем S3AccessKey;     // Строка - секрет из окружения
Перем S3SecretKey;     // Строка - секрет из окружения
Перем Лог;

// Собирает реализацию контракта ХранилищеАртефактов по конфигурации.
//
// Возвращаемое значение:
//  ХранилищеАртефактов - S3Хранилище при backend=s3, иначе ФайловоеХранилище.
//
// Выбрасывает исключение, если для backend=s3 не задан бакет, эндпоинт или ключи доступа.
//
&Завязь(Значение = "ХранилищеАртефактов", Тип = "ХранилищеАртефактов")
&Прозвище("ХранилищеАртефактов")
Функция ХранилищеАртефактов() Экспорт

	Если НРег(Бэкенд) = "s3" Тогда
		Лог.Информация("Бэкенд хранилища артефактов: S3 (бакет ""%1"", эндпоинт ""%2"", path-style=%3)",
			S3Бакет, S3Эндпоинт, ?(S3ПутьСтиль, "да", "нет"));
		Возврат СобратьS3();
	КонецЕсли;

	Лог.Информация("Бэкенд хранилища артефактов: файловый (каталог ""%1"")", КореньДанных);
	Возврат Новый ФайловоеХранилище(КореньДанных, 0, Потолок);

КонецФункции

&Дуб
Процедура ПриСозданииОбъекта(
	&Деталька(Значение = "oshub.storage.backend", ЗначениеПоУмолчанию = "") Бэкенд_ = Неопределено,
	&Деталька(Значение = "oshub.storage.root", ЗначениеПоУмолчанию = "") Корень_ = Неопределено,
	&Деталька(Значение = "oshub.storage.s3.endpoint", ЗначениеПоУмолчанию = "") Эндпоинт_ = Неопределено,
	&Деталька(Значение = "oshub.storage.s3.region", ЗначениеПоУмолчанию = "") Регион_ = Неопределено,
	&Деталька(Значение = "oshub.storage.s3.bucket", ЗначениеПоУмолчанию = "") Бакет_ = Неопределено,
	&Деталька(Значение = "oshub.storage.s3.force_path_style", ЗначениеПоУмолчанию = "") ПутьСтиль_ = Неопределено,
	&Деталька(Значение = "oshub.storage.s3.prefix", ЗначениеПоУмолчанию = "") Префикс_ = Неопределено,
	&Пластилин(Значение = "ПотолокХранилища") _Потолок = Неопределено,
	&Лог _Лог = Неопределено)

	// Лог параметром, а не полем: инъекция в поле доезжает только ПОСЛЕ ПриСозданииОбъекта,
	// а предупреждения пишутся из конструктора
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "КонфигурацияХранилища создана без лога — контейнер или тест обязан его передать";
	КонецЕсли;
	Лог = _Лог;

	Бэкенд = ?(ЗначениеЗаполнено(Бэкенд_), СокрЛП(Строка(Бэкенд_)), "fs");

	КореньДанных = ?(ЗначениеЗаполнено(Корень_), Строка(Корень_), "./data");
	Потолок = _Потолок;

	S3Эндпоинт = ?(ЗначениеЗаполнено(Эндпоинт_), СокрЛП(Строка(Эндпоинт_)), "");
	S3Регион = ?(ЗначениеЗаполнено(Регион_), СокрЛП(Строка(Регион_)), "us-east-1");
	S3Бакет = ?(ЗначениеЗаполнено(Бакет_), СокрЛП(Строка(Бакет_)), "");
	S3Префикс = ?(ЗначениеЗаполнено(Префикс_), СокрЛП(Строка(Префикс_)), "");
	S3ПутьСтиль = ПрочитатьБулево(ПутьСтиль_, Истина);

	// секреты — только из окружения (env или *_FILE Docker-secret), не из конфиг-файла
	S3AccessKey = ПрочитатьСекрет("OSHUB_STORAGE_S3_ACCESS_KEY");
	S3SecretKey = ПрочитатьСекрет("OSHUB_STORAGE_S3_SECRET_KEY");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция СобратьS3()

	ОшибкиКонфига = Новый Массив();
	Если НЕ ЗначениеЗаполнено(S3Бакет) Тогда
		ОшибкиКонфига.Добавить("не задан бакет (oshub.storage.s3.bucket)");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(S3Эндпоинт) Тогда
		ОшибкиКонфига.Добавить("не задан эндпоинт (oshub.storage.s3.endpoint)");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(S3AccessKey) Тогда
		ОшибкиКонфига.Добавить("не задан ключ доступа (переменная окружения OSHUB_STORAGE_S3_ACCESS_KEY или *_FILE)");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(S3SecretKey) Тогда
		ОшибкиКонфига.Добавить("не задан секретный ключ (переменная окружения OSHUB_STORAGE_S3_SECRET_KEY или *_FILE)");
	КонецЕсли;

	Если ОшибкиКонфига.Количество() > 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Ошибка конфигурации S3-хранилища (oshub.storage.backend=s3): %1",
			СтрСоединить(ОшибкиКонфига, "; "));
	КонецЕсли;

	Клиент = Новый КлиентS3Oint(S3Эндпоинт, S3Регион, S3Бакет, S3AccessKey, S3SecretKey,
		S3ПутьСтиль, Лог);
	Возврат Новый S3Хранилище(Клиент, S3Префикс, 0, Потолок);

КонецФункции

// Сначала прямая переменная, затем её *_FILE-вариант (Docker/K8s secret).
Функция ПрочитатьСекрет(Знач ИмяПеременной)

	Значение = ПолучитьПеременнуюСреды(ИмяПеременной);
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат СокрЛП(Строка(Значение));
	КонецЕсли;

	ПутьКФайлу = ПолучитьПеременнуюСреды(ИмяПеременной + "_FILE");
	Если ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Файл = Новый Файл(Строка(ПутьКФайлу));
		Если Файл.Существует() И Файл.ЭтоФайл() Тогда
			Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
			Содержимое = Чтение.Прочитать();
			Чтение.Закрыть();
			Возврат СокрЛП(Строка(Содержимое));
		Иначе
			Лог.Предупреждение("Файл секрета из %1_FILE не найден: %2", ИмяПеременной, ПутьКФайлу);
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

// Значения детальки из окружения/файла приходят строками.
Функция ПрочитатьБулево(Знач Значение, Знач ПоУмолчанию)

	Если Значение = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Строка(Значение)) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Нормализованное = НРег(СокрЛП(Строка(Значение)));
	Возврат Нормализованное = "истина" ИЛИ Нормализованное = "true"
		ИЛИ Нормализованное = "1" ИЛИ Нормализованное = "да" ИЛИ Нормализованное = "yes";

КонецФункции

#КонецОбласти
