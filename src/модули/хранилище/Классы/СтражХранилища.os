// Память хаба о том, отвечает ли хранилище артефактов: вердикт, причина и момент,
// с которого он такой. Смену состояния объявляет летописи помех — не чаще раза в срок.
//
// У памяти две двери, и они неравны: боевой вызов писал, листал и читал, а проба задала
// один дешёвый вопрос. Поэтому успех пробы свежий боевой отказ НЕ отменяет.

Перем Настройки;   // СервисНастроек (настройки) — срок памяти и адрес хранилища
Перем Летопись;    // ЛетописьПомех (помехи) — наружу не бросает
Перем Объекты;     // ОбъектыПомех (помехи) — адрес объекта помехи
Перем Коды;        // КодыПомех (помехи)
Перем Состояние_;  // Структура, присваиваемая целиком: гонящийся поток не увидит полупустой
Перем БоевойОтказ; // Дата - момент последнего отказа боевого вызова; пустая — отказов нет
Перем Объявленное; // Структура(Состояние, Момент) — что и когда ушло в летопись
Перем Часы;        // Объект с методом Сейчас() -> Дата, либо Неопределено (системные часы)
&Лог
Перем Лог;

#Область ТестовыеШвы

// Подставляет источник времени — тестовый шов; в рабочем контейнере не вызывается.
//
// Параметры:
//  ИсточникВремени - Произвольный - объект с методом Сейчас(), возвращающим Дату.
//
Процедура УстановитьЧасы(Знач ИсточникВремени) Экспорт
	Часы = ИсточникВремени;
КонецПроцедуры

#КонецОбласти

#Область ПубличныйИнтерфейс

// Что хаб знает о хранилище прямо сейчас. Отметка старше срока памяти — это «неизвестно»:
// экран честно скажет «ещё не проверялось», а не покажет вчерашний вердикт.
//
// Возвращаемое значение:
//  Структура - Известно (Булево, хранилище хоть раз отвечало на вопрос), Отвечает (Булево),
//              ОтказДоступа (Булево, ответило но не пустило), Причина (Строка),
//              Проверено (Дата, последний ответ), Изменилось (Дата, с какого момента
//              состояние такое).
//
Функция Состояние() Экспорт

	Запись = Свежее();
	Если Запись = Неопределено Тогда
		Возврат Слепок(Ложь, Отвечает(), "", ПустойМомент(), ПустойМомент());
	КонецЕсли;

	Возврат Слепок(Истина, Запись.Состояние, Запись.Причина, Запись.Проверено,
		Запись.Изменилось);

КонецФункции

// Боевой вызов хранилища удался: оно и отвечает, и делает работу. Это сильнейшее из
// свидетельств — оно снимает и отказ, и удерживающую его отметку.
//
Процедура ОтметитьБоевойУспех() Экспорт
	БоевойОтказ = ПустойМомент();
	Запомнить(Отвечает(), "");
КонецПроцедуры

// Боевой вызов хранилища отказал зависимостью: хранилище не сделало работу — и это
// известно точно, безо всякой пробы.
//
// Параметры:
//  Причина - Строка - чем именно отказало хранилище.
//
Процедура ОтметитьБоевойОтказ(Знач Причина) Экспорт
	БоевойОтказ = Сейчас();
	Запомнить(НеОтвечает(), Причина);
КонецПроцедуры

// Исход плановой пробы. Отказ пробы кладётся сразу, а вот её успех слабее боевого отказа:
// проба не пишет и не листает, и на корзине с опечаткой в имени она отвечает тем же
// «объекта нет», что и на исправной. Поэтому свежий боевой отказ она лишь продлевает,
// а отпускает — не раньше, чем через срок памяти после него.
//
// Параметры:
//  Проба - Структура - Успех (Булево), ОтказДоступа (Булево), Сообщение (Строка).
//
Процедура ПринятьПробу(Знач Проба) Экспорт

	Если НЕ Проба.Успех Тогда
		Запомнить(?(Проба.ОтказДоступа, НеПустило(), НеОтвечает()), Проба.Сообщение);
		Возврат;
	КонецЕсли;

	Если БоевойОтказДержит() Тогда
		ПродлитьОтказ();
		Возврат;
	КонецЕсли;

	БоевойОтказ = ПустойМомент();
	Запомнить(Отвечает(), "");

КонецПроцедуры

// Забывает всё, что известно о хранилище — при смене настроек и в тестах.
//
Процедура Забыть() Экспорт
	Состояние_ = Неопределено;
	БоевойОтказ = ПустойМомент();
	Объявленное = Неопределено;
КонецПроцедуры

// Сколько живёт отметка о хранилище, секунды.
//
// Возвращаемое значение:
//  Число.
//
Функция СрокПамятиСек() Экспорт
	Возврат Настройки.Целое("oshub.storage.health.ttl.sec", 300, 1);
КонецФункции

#КонецОбласти

#Область Слова

// Состояние — слово, а не флаг: «не пустило» третье, и парой булевых оно не выражается.

Функция Отвечает()
	Возврат "отвечает";
КонецФункции

Функция НеОтвечает()
	Возврат "не отвечает";
КонецФункции

Функция НеПустило()
	Возврат "не пустило";
КонецФункции

#КонецОбласти

#Область Память

// Запись присваивается целиком и последней: страж стоит на горячем пути запросов,
// и гонящийся поток увидит либо прежнее состояние, либо новое, но не полусобранное.
Процедура Запомнить(Знач Новое, Знач Причина)

	Сейчас = Сейчас();
	Прежнее = Свежее();

	Если Прежнее = Неопределено ИЛИ Прежнее.Состояние <> Новое Тогда
		Изменилось = Сейчас;
	Иначе
		Изменилось = Прежнее.Изменилось;
	КонецЕсли;

	Состояние_ = Новый Структура("Состояние, Причина, Проверено, Изменилось",
		Новое, Строка(Причина), Сейчас, Изменилось);

	Если Прежнее = Неопределено ИЛИ Прежнее.Состояние <> Новое Тогда
		Лог.Информация("Хранилище артефактов %1%2", Новое,
			?(ЗначениеЗаполнено(Причина), ": " + Строка(Причина), ""));
	КонецЕсли;

	ОбъявитьЛетописи(Новое, Причина, Сейчас);

КонецПроцедуры

// Боевой отказ держит вердикт срок памяти: столько хаб считает его свежее любой пробы.
// Дальше отпускает — на тихом хабе боевых вызовов может не быть часами, и вечно держать
// вердикт по одному давнему отказу значило бы показывать позавчерашнюю беду.
Функция БоевойОтказДержит()
	Возврат ЗначениеЗаполнено(БоевойОтказ) И Сейчас() - БоевойОтказ < СрокПамятиСек();
КонецФункции

// Успех пробы под удержанием не меняет ни вердикта, ни причины — он лишь подтверждает,
// что хаб на посту: без этого отметка протухла бы по сроку и «не отвечает» на экране
// сменилось бы на «ещё не проверялось». В летопись такое подтверждение не идёт.
Процедура ПродлитьОтказ()

	Запись = Состояние_;
	Если Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Состояние_ = Новый Структура("Состояние, Причина, Проверено, Изменилось",
		Запись.Состояние, Запись.Причина, Сейчас(), Запись.Изменилось);

КонецПроцедуры

// Протухшая отметка — это «неизвестно»: показывать вчерашний вердикт как сегодняшний
// значит соврать ровно там, где на него и смотрят.
Функция Свежее()

	Запись = Состояние_;
	Если Запись = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ?(Сейчас() - Запись.Проверено >= СрокПамятиСек(), Неопределено, Запись);

КонецФункции

Функция Слепок(Знач Известно, Знач Состояние, Знач Причина, Знач Проверено, Знач Изменилось)

	Возврат Новый Структура("Известно, Отвечает, ОтказДоступа, Причина, Проверено, Изменилось",
		Известно, Состояние = Отвечает(), Состояние = НеПустило(),
		Строка(Причина), Проверено, Изменилось);

КонецФункции

Функция ПустойМомент()
	Возврат '00010101000000';
КонецФункции

Функция Сейчас()
	Возврат ?(Часы = Неопределено, ТекущаяУниверсальнаяДата(), Часы.Сейчас());
КонецФункции

#КонецОбласти

#Область ОбъявлениеЛетописи

// Летопись — два обращения к базе под процессным замком, а страж слышит КАЖДЫЙ ответ
// хранилища. Поэтому пишется переход, а повтор того же отказа — не чаще раза в срок
// памяти: так помеха остаётся свежей, а горячий путь не платит за неё на каждом запросе.
Процедура ОбъявитьЛетописи(Знач Новое, Знач Причина, Знач Сейчас)

	Если НЕ ПораОбъявить(Новое, Сейчас) Тогда
		Возврат;
	КонецЕсли;

	Если Новое = Отвечает() Тогда
		Летопись.Снять(Коды.ПодсистемаХранилище(), АдресХранилища());
	Иначе
		Летопись.Записать(Коды.ПодсистемаХранилище(), АдресХранилища(), "",
			КодПомехи(Новое), Причина);
	КонецЕсли;

	Объявленное = Новый Структура("Состояние, Момент", Новое, Сейчас);

КонецПроцедуры

Функция ПораОбъявить(Знач Новое, Знач Сейчас)

	Если Объявленное = Неопределено ИЛИ Объявленное.Состояние <> Новое Тогда
		Возврат Истина;
	КонецЕсли;

	// снимать снятое незачем: повторяется только помеха, и та по сроку
	Возврат Новое <> Отвечает() И Сейчас - Объявленное.Момент >= СрокПамятиСек();

КонецФункции

Функция КодПомехи(Знач Состояние)
	Возврат ?(Состояние = НеПустило(), Коды.ХранилищеНеПустило(), Коды.ХранилищеНеОтвечает());
КонецФункции

// Объект помехи — корзина либо корень артефактов: у эндпоинта рядом лежат ключи доступа,
// и место им не на экране.
Функция АдресХранилища()

	Если НРег(Настройки.Текстом("oshub.storage.backend", "fs")) = "s3" Тогда
		Возврат Объекты.ХранилищеS3(Настройки.Текстом("oshub.storage.s3.bucket", ""));
	КонецЕсли;

	Возврат Объекты.ХранилищеФайлами(Настройки.Текстом("oshub.storage.root", ""));

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ЛетописьПомех") _Летопись,
	&Пластилин(Значение = "ОбъектыПомех") _Объекты,
	&Пластилин(Значение = "КодыПомех") _Коды,
	&Лог _Лог = Неопределено)

	Настройки = _Настройки;
	Летопись = _Летопись;
	Объекты = _Объекты;
	Коды = _Коды;
	Состояние_ = Неопределено;
	БоевойОтказ = ПустойМомент();
	Объявленное = Неопределено;
	Часы = Неопределено;

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
