// Ключи настроек хранилища артефактов: корень и вид бэкенда, потолок объёма, проба
// доступности и подключение к S3.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей хранилища в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи хранилища.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(20)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "oshub.storage.root", ЗначениеПоУмолчанию = "") _КаталогХранилища = "",
	&Деталька(Значение = "oshub.storage.backend", ЗначениеПоУмолчанию = "") _Бэкенд = "",
	&Деталька(Значение = "oshub.storage.quota.bytes", ЗначениеПоУмолчанию = "") _КвотаБайт = "",
	&Деталька(Значение = "oshub.storage.health.ttl.sec", ЗначениеПоУмолчанию = "") _СрокПробыХранилища = "",
	&Деталька(Значение = "oshub.storage.health.timeout.sec", ЗначениеПоУмолчанию = "") _ТаймаутПробыХранилища = "",
	&Деталька(Значение = "oshub.jobs.storage_health_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалПробыХранилища = "",
	&Деталька(Значение = "oshub.storage.s3.endpoint", ЗначениеПоУмолчанию = "") _ЭндпоинтS3 = "",
	&Деталька(Значение = "oshub.storage.s3.bucket", ЗначениеПоУмолчанию = "") _БакетS3 = "",
	&Деталька(Значение = "oshub.storage.s3.region", ЗначениеПоУмолчанию = "") _РегионS3 = "",
	&Деталька(Значение = "oshub.storage.s3.prefix", ЗначениеПоУмолчанию = "") _ПрефиксS3 = "",
	&Деталька(Значение = "oshub.storage.s3.force_path_style", ЗначениеПоУмолчанию = "") _ПутьСтильS3 = "",
	&Деталька(Значение = "oshub.storage.s3.access_key", ЗначениеПоУмолчанию = "") _КлючДоступаS3 = "",
	&Деталька(Значение = "oshub.storage.s3.access_key_file", ЗначениеПоУмолчанию = "") _ФайлКлючаДоступаS3 = "",
	&Деталька(Значение = "oshub.storage.s3.secret_key", ЗначениеПоУмолчанию = "") _СекретныйКлючS3 = "",
	&Деталька(Значение = "oshub.storage.s3.secret_key_file", ЗначениеПоУмолчанию = "") _ФайлСекретногоКлючаS3 = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	// Всё хранилище — часть развёртывания: корень, вид бэкенда и потолок объёма решает
	// тот, кто разворачивает хаб, а не его администратор.
	Ключи.Объявить("oshub.storage.root", "строка", "./data", Неопределено, "bootstrap", _КаталогХранилища);
	Ключи.Объявить("oshub.storage.backend", "строка", "file", _Правила.Перечисление("file,s3"),
		"bootstrap", _Бэкенд);
	Ключи.Объявить("oshub.storage.quota.bytes", "целое", 0, _Правила.Минимум(0), "bootstrap", _КвотаБайт);

	// Проба доступности: сколько её результат считается свежим, сколько хаб ждёт ответа и как
	// часто её зовёт планировщик. Сроки похода наружу — числа машины, как и у прокси апстрима.
	Ключи.Объявить("oshub.storage.health.ttl.sec", "целое", 300, _Правила.Минимум(1), "bootstrap",
		_СрокПробыХранилища);
	Ключи.Объявить("oshub.storage.health.timeout.sec", "целое", 10, _Правила.Минимум(1), "bootstrap",
		_ТаймаутПробыХранилища);
	Ключи.Объявить("oshub.jobs.storage_health_interval_sec", "целое", 60, _Правила.Минимум(1), "bootstrap",
		_ИнтервалПробыХранилища);

	// S3 собирается один раз при старте — как и вид хранилища.
	Ключи.Объявить("oshub.storage.s3.endpoint", "строка", "", Неопределено, "bootstrap", _ЭндпоинтS3);
	Ключи.Объявить("oshub.storage.s3.bucket", "строка", "", Неопределено, "bootstrap", _БакетS3);
	Ключи.Объявить("oshub.storage.s3.region", "строка", "us-east-1", Неопределено, "bootstrap", _РегионS3);
	Ключи.Объявить("oshub.storage.s3.prefix", "строка", "", Неопределено, "bootstrap", _ПрефиксS3);
	Ключи.Объявить("oshub.storage.s3.force_path_style", "булево", Истина, Неопределено, "bootstrap",
		_ПутьСтильS3);
	// Ключи доступа — значением либо путём к файлу секрета; значение сильнее файла.
	Ключи.ОбъявитьСекрет("oshub.storage.s3.access_key", "строка", "", Неопределено, "bootstrap",
		_КлючДоступаS3);
	Ключи.Объявить("oshub.storage.s3.access_key_file", "строка", "", Неопределено, "bootstrap",
		_ФайлКлючаДоступаS3);
	Ключи.ОбъявитьСекрет("oshub.storage.s3.secret_key", "строка", "", Неопределено, "bootstrap",
		_СекретныйКлючS3);
	Ключи.Объявить("oshub.storage.s3.secret_key_file", "строка", "", Неопределено, "bootstrap",
		_ФайлСекретногоКлючаS3);

КонецПроцедуры
