// Реализация шва КлиентS3 поверх oint (OPI_S3): SigV4, HTTP, авто-multipart >20 МБ.
// Скрывает формат ответов oint. Не желудь — создаётся фабрикой КонфигурацияХранилища.

#Использовать oint
#Использовать errors

Перем ОсновныеДанные; // Структура - данные запроса oint (URL/AccessKey/SecretKey/Region)
Перем Бакет;         // Строка   - имя бакета
Перем ФорсПутьСтиль; // Булево   - path-style адресация (для MinIO)
Перем Вердикт;       // ВердиктОтветаS3 (хранилище) — приговор по структуре ответа
Перем Лог;           // Лог создателя: класс не желудь, инъекции ОСени сюда не доезжают

// Загружает объект по ключу; multipart включается автоматически для тел больше 20 МБ.
//
// Параметры:
//  Ключ - Строка - плоский ключ объекта в бакете.
//  Источник - Строка, ДвоичныеДанные - путь к существующему файлу либо содержимое объекта.
//
// Выбрасывает исключение при коде ответа вне 2xx.
//
Процедура Положить(Знач Ключ, Знач Источник) Экспорт

	Ответ = OPI_S3.ЗагрузитьОбъект(Ключ, Бакет, Источник, ОсновныеДанные, , ФорсПутьСтиль);

	Код = Вердикт.Статус(Ответ);
	Лог.Отладка("S3: положили ""%1"" в бакет ""%2"", статус %3", Ключ, Бакет, Код);
	Если Код > 299 Тогда
		ВызватьИсключение СтандартныеОшибки.ЗависимостьНедоступна(АдресБакета(), СтрШаблон(
			"Ошибка загрузки объекта S3 ""%1"": сервер вернул статус %2. %3",
			Ключ, Формат(Код, "ЧГ=0"), Вердикт.ПояснениеОтказа(Ответ)));
	КонецЕсли;

КонецПроцедуры

// Скачивает объект в локальный файл потоково.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//  ПутьСохранения - Строка - путь целевого файла; перезаписывается.
//
// Возвращаемое значение:
//  Строка - абсолютный путь к записанному файлу.
//
// Выбрасывает resource.not_found, если хранилище ответило «нет объекта»,
// и dependency.unavailable при любом другом отказе.
//
Функция Скачать(Знач Ключ, Знач ПутьСохранения) Экспорт

	Результат = OPI_S3.ПолучитьОбъект(Ключ, Бакет, ОсновныеДанные, "", , ПутьСохранения, ФорсПутьСтиль);

	// успех — путь к записанному файлу; иначе oint вернул структуру-описание ответа
	Если ТипЗнч(Результат) = Тип("Строка") Тогда
		Лог.Отладка("S3: скачали ""%1"" из бакета ""%2"" в %3", Ключ, Бакет, ПутьСохранения);
		Возврат Результат;
	КонецЕсли;

	ВызватьИсключение ОтказЧтения(Ключ, Результат, "скачивание");

КонецФункции

// Возвращает содержимое объекта в память.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//
// Возвращаемое значение:
//  ДвоичныеДанные - содержимое объекта.
//
// Выбрасывает resource.not_found, если хранилище ответило «нет объекта»,
// и dependency.unavailable при любом другом отказе.
//
Функция ПолучитьБайты(Знач Ключ) Экспорт

	Результат = OPI_S3.ПолучитьОбъект(Ключ, Бакет, ОсновныеДанные, "", , "", ФорсПутьСтиль);

	Если ТипЗнч(Результат) = Тип("ДвоичныеДанные") Тогда
		Лог.Отладка("S3: прочитали ""%1"" из бакета ""%2"", %3 байт",
			Ключ, Бакет, Результат.Размер());
		Возврат Результат;
	КонецЕсли;

	ВызватьИсключение ОтказЧтения(Ключ, Результат, "чтение");

КонецФункции

// Проверяет наличие объекта HEAD-запросом.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//
// Возвращаемое значение:
//  Булево - Истина, если объект существует; Ложь, если хранилище сказало «его нет».
//
// Выбрасывает dependency.unavailable, если хранилище не ответило по существу: молчаливое
// «объекта нет» на лежащем S3 увело бы вызывающего отвечать 404 вместо 503.
//
Функция Существует(Знач Ключ) Экспорт

	Ответ = OPI_S3.ПолучитьОписаниеОбъекта(Ключ, Бакет, ОсновныеДанные, , , ФорсПутьСтиль);

	Лог.Отладка("S3: описание ""%1"" в бакете ""%2"" — статус %3",
		Ключ, Бакет, Вердикт.Статус(Ответ));

	Если Вердикт.ХранилищеНеОтветилоПоСуществу(Ответ) Тогда
		ВызватьИсключение ОтказПоОбъекту(Ключ, Ответ);
	КонецЕсли;

	Возврат Вердикт.Успех(Ответ);

КонецФункции

// Возвращает размер объекта по заголовку Content-Length HEAD-ответа.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//
// Возвращаемое значение:
//  Число - размер в байтах.
//
// Выбрасывает resource.not_found, если хранилище ответило «нет объекта»,
// и dependency.unavailable при другом отказе и при описании без Content-Length.
//
Функция Размер(Знач Ключ) Экспорт

	Ответ = OPI_S3.ПолучитьОписаниеОбъекта(Ключ, Бакет, ОсновныеДанные, , , ФорсПутьСтиль);

	Если НЕ Вердикт.Успех(Ответ) Тогда
		ВызватьИсключение ОтказЧтения(Ключ, Ответ, "описание");
	КонецЕсли;

	Длина = Вердикт.ДлинаСодержимого(Ответ);
	Если Длина < 0 Тогда
		ВызватьИсключение ОтказБезДлины(Ключ);
	КонецЕсли;

	Возврат Длина;

КонецФункции

// Удаляет объект. Идемпотентна: отсутствие объекта не ошибка.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//
// Выбрасывает исключение при коде ответа вне 2xx, кроме 404.
//
Процедура Удалить(Знач Ключ) Экспорт

	Ответ = OPI_S3.УдалитьОбъект(Ключ, Бакет, ОсновныеДанные, , , ФорсПутьСтиль);
	Код = Вердикт.Статус(Ответ);

	Лог.Отладка("S3: удалили ""%1"" из бакета ""%2"", статус %3", Ключ, Бакет, Код);

	// 404 — объект уже отсутствует, это идемпотентность, а не ошибка
	Если Код > 299 И Код <> 404 Тогда
		ВызватьИсключение СтандартныеОшибки.ЗависимостьНедоступна(АдресБакета(), СтрШаблон(
			"Ошибка удаления объекта S3 ""%1"": сервер вернул статус %2. %3",
			Ключ, Формат(Код, "ЧГ=0"), Вердикт.ПояснениеОтказа(Ответ)));
	КонецЕсли;

КонецПроцедуры

// Перечисляет объекты бакета по префиксу с постраничным обходом; читает только метаданные.
// Обход бага oint 2.3.0: query-значение ?prefix= со слешем подписывается SigV4 несогласованно
// с URL -> 403 SignatureDoesNotMatch, поэтому серверу отдаётся лишь ведущий сегмент префикса,
// а точная фильтрация делается клиентом.
//
// Параметры:
//  Префикс - Строка - префикс ключей, например "pools/main/".
//
// Возвращаемое значение:
//  Массив из Структура - Ключ (Строка), Размер (Число), Изменён (Дата).
//
// Выбрасывает исключение при ошибке сервера и при усечении списка без токена продолжения:
// листинг более 250 объектов по бакету ненадёжен из-за того же бага подписи.
//
Функция Перечислить(Знач Префикс) Экспорт

	Результат = Новый Массив();
	СерверныйПрефикс = ВедущийСегментБезСлеша(Префикс);
	Токен = "";

	Пока Истина Цикл

		Ответ = OPI_S3.ПолучитьСписокОбъектов(Бакет, ОсновныеДанные, СерверныйПрефикс, Токен, , ФорсПутьСтиль);
		Код = Вердикт.Статус(Ответ);
		Если Код > 299 Тогда
			ВызватьИсключение СтандартныеОшибки.ЗависимостьНедоступна(АдресБакета(), СтрШаблон(
				"Ошибка получения списка объектов S3 (префикс ""%1""): статус %2. %3",
				Префикс, Формат(Код, "ЧГ=0"), Вердикт.ПояснениеОтказа(Ответ)));
		КонецЕсли;

		РезультатСписка = Вердикт.ЗначениеПоля(Ответ["response"], "ListBucketResult");
		Если РезультатСписка = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Для Каждого Элемент Из ВМассив(Вердикт.ЗначениеПоля(РезультатСписка, "Contents")) Цикл
			Ключ = Строка(Вердикт.ЗначениеПоля(Элемент, "Key"));
			// клиентская фильтрация по полному префиксу (серверу отдавали лишь ведущий сегмент)
			Если ЗначениеЗаполнено(Префикс) И НЕ СтрНачинаетсяС(Ключ, Префикс) Тогда
				Продолжить;
			КонецЕсли;
			Результат.Добавить(Новый Структура("Ключ, Размер, Изменён",
				Ключ,
				ВЧисло(Вердикт.ЗначениеПоля(Элемент, "Size")),
				ВДату(Вердикт.ЗначениеПоля(Элемент, "LastModified"))));
		КонецЦикла;

		Усечён = НРег(Строка(Вердикт.ЗначениеПоля(РезультатСписка, "IsTruncated"))) = "true";
		СледующийТокен = Вердикт.ЗначениеПоля(РезультатСписка, "NextContinuationToken");

		Если НЕ Усечён Тогда
			Прервать;
		КонецЕсли;

		// Продолжение возможно только токеном, а он подвержен тому же багу подписи: fail-loud,
		// чтобы не получить тихий недосчёт квоты
		Если СледующийТокен = Неопределено Тогда
			ВызватьИсключение СтандартныеОшибки.ЗависимостьНедоступна(АдресБакета(), СтрШаблон(
				"Список объектов S3 (префикс ""%1"") усечён на %2 записях, но сервер не вернул токен продолжения:"
					+ " листинг >250 объектов суммарно по бакету не поддерживается (ограничение oint 2.3.0)",
				Префикс, Формат(Результат.Количество(), "ЧГ=0")));
		КонецЕсли;

		Токен = Строка(СледующийТокен);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ПриСозданииОбъекта(Знач Эндпоинт, Знач Регион, Знач ИмяБакета, Знач AccessKey,
	Знач SecretKey, Знач ПутьСтиль = Истина, Знач НовыйЛог = Неопределено)

	Если НовыйЛог = Неопределено Тогда
		ВызватьИсключение "КлиентS3Oint создан без лога — создатель обязан передать свой лог";
	КонецЕсли;
	Лог = НовыйЛог;

	ОсновныеДанные = OPI_S3.ПолучитьСтруктуруДанных(Эндпоинт, AccessKey, SecretKey, Регион);
	Бакет = Строка(ИмяБакета);
	ФорсПутьСтиль = (ПутьСтиль = Истина);
	Вердикт = Новый ВердиктОтветаS3();

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция ВедущийСегментБезСлеша(Знач Префикс)
	Если НЕ ЗначениеЗаполнено(Префикс) Тогда
		Возврат "";
	КонецЕсли;
	Позиция = СтрНайти(Префикс, "/");
	Если Позиция = 0 Тогда
		Возврат Префикс;
	КонецЕсли;
	Возврат Лев(Префикс, Позиция - 1);
КонецФункции

// Отказ хранилища называется машинным кодом библиотеки errors: приговор «объекта нет»
// против «хранилище не смогло» выносит ВердиктОтветаS3 по структуре ответа.
Функция ОтказПоОбъекту(Знач Ключ, Знач Ответ)

	Код = Формат(Вердикт.Статус(Ответ), "ЧГ=0");

	Если Вердикт.ЭтоОтсутствие(Ответ) Тогда
		Возврат СтандартныеОшибки.РесурсНеНайден(Ключ, СтрШаблон(
			"Объект S3 не найден: %1 (бакет ""%2"", статус %3)", Ключ, Бакет, Код));
	КонецЕсли;

	Возврат СтандартныеОшибки.ЗависимостьНедоступна(АдресБакета(), СтрШаблон(
		"Хранилище S3 не отдало объект ""%1"": статус %2. %3",
		Ключ, Код, Вердикт.ПояснениеОтказа(Ответ)));

КонецФункции

// Чтение не дало содержимого: либо хранилище отказало, либо описало объект без длины.
// Одна дверь на скачивание, чтение в память и описание — отладочная строка одна на всех.
Функция ОтказЧтения(Знач Ключ, Знач Ответ, Знач Операция)

	Лог.Отладка("S3: %1 ""%2"" из бакета ""%3"" не состоялось, статус %4",
		Операция, Ключ, Бакет, Вердикт.Статус(Ответ));

	Если Вердикт.Успех(Ответ) Тогда
		Возврат ОтказБезДлины(Ключ);
	КонецЕсли;

	Возврат ОтказПоОбъекту(Ключ, Ответ);

КонецФункции

// Хранилище ответило успехом, но размер объекта из ответа не читается: отдавать нечего.
Функция ОтказБезДлины(Знач Ключ)
	Возврат СтандартныеОшибки.ЗависимостьНедоступна(АдресБакета(), СтрШаблон(
		"Хранилище S3 описало объект ""%1"" без заголовка Content-Length: размер неизвестен",
		Ключ));
КонецФункции

// Имя зависимости в стандартной ошибке: бакет, а не эндпоинт с ключами доступа.
Функция АдресБакета()
	Возврат "s3://" + Бакет;
КонецФункции

// XML-парсер oint кладёт одиночный повторяемый элемент как коллекцию, несколько — как массив.
Функция ВМассив(Знач Значение)
	Результат = Новый Массив();
	Если Значение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;
	Результат.Добавить(Значение);
	Возврат Результат;
КонецФункции

Функция ВЧисло(Знач Значение)
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция ВДату(Знач Значение)
	Попытка
		Возврат ПрочитатьДатуJSON(Строка(Значение), ФорматДатыJSON.ISO);
	Исключение
		Возврат '00010101';
	КонецПопытки;
КонецФункции

#КонецОбласти
