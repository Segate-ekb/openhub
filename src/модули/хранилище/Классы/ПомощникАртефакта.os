// Общее у всех бэкендов хранилища: размер источника до загрузки и sha256 содержимого.
// Источником артефакта хаб считает две вещи — двоичные данные и путь к файлу.

// Размер источника без копирования: предпроверка квоты. Заодно валидирует тип
// и существование источника.
//
// Параметры:
//  Источник - ДвоичныеДанные, Строка - содержимое артефакта либо путь к файлу.
//
// Возвращаемое значение:
//  Число - размер в байтах.
//
Функция РазмерИсточника(Знач Источник) Экспорт

	Если ТипЗнч(Источник) = Тип("ДвоичныеДанные") Тогда
		Возврат Источник.Размер();
	КонецЕсли;

	Если ТипЗнч(Источник) = Тип("Строка") Тогда
		ФайлИсточника = Новый Файл(Источник);
		Если НЕ ФайлИсточника.Существует() ИЛИ НЕ ФайлИсточника.ЭтоФайл() Тогда
			ВызватьИсключение СтрШаблон("Файл-источник артефакта не найден: %1", Источник);
		КонецЕсли;
		Возврат ФайлИсточника.Размер();
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Неподдерживаемый тип источника артефакта: %1 (ожидались Строка или ДвоичныеДанные)",
		ТипЗнч(Источник));

КонецФункции

// sha256 источника — тем же способом, каким его считает бэкенд при чтении.
//
// Параметры:
//  Источник - ДвоичныеДанные, Строка - содержимое артефакта либо путь к файлу.
//
// Возвращаемое значение:
//  Строка - hex-строка в нижнем регистре.
//
Функция Sha256Источника(Знач Источник) Экспорт

	Если ТипЗнч(Источник) = Тип("ДвоичныеДанные") Тогда
		Возврат Sha256Данных(Источник);
	КонецЕсли;
	Возврат Sha256Файла(Источник);

КонецФункции

// sha256 файла на диске.
//
// Параметры:
//  Путь - Строка - путь к файлу.
//
// Возвращаемое значение:
//  Строка - hex-строка в нижнем регистре.
//
Функция Sha256Файла(Знач Путь) Экспорт
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.ДобавитьФайл(Путь);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции

// sha256 двоичных данных.
//
// Параметры:
//  Данные - ДвоичныеДанные - содержимое артефакта.
//
// Возвращаемое значение:
//  Строка - hex-строка в нижнем регистре.
//
Функция Sha256Данных(Знач Данные) Экспорт
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции

