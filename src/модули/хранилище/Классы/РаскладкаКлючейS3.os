// Раскладка ключей объектов в бакете: {префикс}pools/{пул}/{пакет}/{имя файла}. Вторая
// линия защиты от выхода за корень: небезопасный сегмент ключа не собирает.

Перем Префикс;  // Строка - нормализованный префикс ("" либо "xxx/")
Перем Контроль;   // КонтрольСимволов (основа)

#Область ПубличныйИнтерфейс

// Голова всех ключей артефактов: {префикс}pools/.
//
// Возвращаемое значение:
//  Строка.
//
Функция ГоловаПулов() Экспорт
	Возврат Префикс + "pools/";
КонецФункции

// Префикс области пула: {префикс}pools/{пул}/.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПрефиксПула(Знач ИмяПула) Экспорт
	Возврат ГоловаПулов() + Строка(ИмяПула) + "/";
КонецФункции

// Собирает ключ объекта из компонент.
//
// Параметры:
//  Пул - Строка - имя пула.
//  Пакет - Строка - имя пакета.
//  ИмяФайла - Строка - имя файла артефакта.
//
// Возвращаемое значение:
//  Строка - ключ объекта.
//
// Выбрасывает исключение, если компонента уводит ключ за пределы корня.
//
Функция Собрать(Знач Пул, Знач Пакет, Знач ИмяФайла) Экспорт

	ПроверитьСегмент("пул", Пул);
	ПроверитьСегмент("пакет", Пакет);
	ПроверитьСегмент("имя файла", ИмяФайла);

	Возврат ГоловаПулов() + Строка(Пул) + "/" + Строка(Пакет) + "/" + Строка(ИмяФайла);

КонецФункции

// Разбирает ключ в компоненты раскладки.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//
// Возвращаемое значение:
//  Структура, Неопределено - Пул, Пакет, ИмяФайла; Неопределено, если ключ не
//                            соответствует раскладке pools/{пул}/{пакет}/{файл}.
//
Функция Разобрать(Знач Ключ) Экспорт

	Голова = ГоловаПулов();
	Если НЕ СтрНачинаетсяС(Ключ, Голова) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сегменты = СтрРазделить(Сред(Ключ, СтрДлина(Голова) + 1), "/", Истина);
	Если Сегменты.Количество() <> 3 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Пул, Пакет, ИмяФайла", Сегменты[0], Сегменты[1], Сегменты[2]);

КонецФункции

// Имя пула, которому принадлежит ключ.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//
// Возвращаемое значение:
//  Строка - имя пула; пусто, если ключ лежит не в области пула.
//
Функция ПулКлюча(Знач Ключ) Экспорт

	Голова = ГоловаПулов();
	Если НЕ СтрНачинаетсяС(Ключ, Голова) Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(Строка(Ключ), СтрДлина(Голова) + 1);
	Позиция = СтрНайти(Остаток, "/");
	Возврат ?(Позиция > 1, Лев(Остаток, Позиция - 1), "");

КонецФункции

// Непустая строка, не "." и не "..", без "/", "\" и управляющих символов.
//
// Параметры:
//  Значение - Произвольный - проверяемая компонента.
//
// Возвращаемое значение:
//  Булево.
//
Функция СегментБезопасен(Знач Значение) Экспорт

	Если ТипЗнч(Значение) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Значение = "." ИЛИ Значение = ".." Тогда
		Возврат Ложь;
	КонецЕсли;

	Для НомерСимвола = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, НомерСимвола, 1);
		Если Символ = "/" ИЛИ Символ = "\" ИЛИ Контроль.ЭтоУправляющийC0(КодСимвола(Символ)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьСегмент(Знач Название, Знач Значение)

	Если НЕ СегментБезопасен(Значение) Тогда
		ВызватьИсключение СтрШаблон(
			"Недопустимые координаты артефакта: компонента ""%1"" (значение ""%2"") уводит ключ за пределы корня хранилища",
			Название, Значение);
	КонецЕсли;

КонецПроцедуры

// Пустой -> ""; непустой -> с завершающим "/". Небезопасные сегменты отклоняются.
Функция Нормализовать(Знач Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Собранные = Новый Массив();
	Для Каждого Часть Из СтрРазделить(СтрЗаменить(Строка(Значение), "\", "/"), "/", Ложь) Цикл
		Если НЕ ЗначениеЗаполнено(Часть) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ СегментБезопасен(Часть) Тогда
			ВызватьИсключение СтрШаблон(
				"Некорректная конфигурация хранилища: небезопасный сегмент префикса oshub.storage.s3.prefix (""%1"")", Часть);
		КонецЕсли;
		Собранные.Добавить(Часть);
	КонецЦикла;

	Возврат ?(Собранные.Количество() = 0, "", СтрСоединить(Собранные, "/") + "/");

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач ПрефиксИнсталляции = "")
	// раскладка — значение-объект с позиционным конструктором: внедрять сюда нечем
	Контроль = Новый КонтрольСимволов();
	Префикс = Нормализовать(ПрефиксИнсталляции);
КонецПроцедуры
