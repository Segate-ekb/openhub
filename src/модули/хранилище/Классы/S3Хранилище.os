// Реализация ХранилищеАртефактов поверх S3; ввод-вывод — через шов КлиентS3.
// Раскладка ключей: {префикс}pools/{пул}/{пакет}/{имя файла}.

#Использовать errors

Перем Клиент;         // КлиентS3 - шов доступа к S3 (реальный oint или фейк)
Перем Ключи;          // РаскладкаКлючейS3 - раскладка и безопасность ключей
Перем Квота;          // КвотаХранилища (хранилище) — действующий потолок и приговор по нему
Перем ВыданныеКопии;  // Соответствие путь->Истина - незакрытые временные копии от Получить
Перем Замок;          // БлокировкаРесурса — реестр копий делят все параллельные скачивания
Перем Артефакты;      // ПомощникАртефакта (хранилище) — размер и sha256 источника
Перем ТипыСодержимого; // ТипСодержимогоАртефакта (хранилище) — чем артефакт является
Перем Уборка;         // ТихаяУборка (основа) — временный файл, который не роняет вызывающего
Перем Приговор;       // ВердиктОтветаS3 (хранилище) — что означает ответ корзины
Перем Вердикты;       // Вердикт (основа) — форма ответа пробы
Перем Ошибки;         // ТекстОшибки (основа) — фраза хаба из отказа клиента

// Сохраняет артефакт по координатам; публикация атомарна свойством PutObject.
// Квота проверяется до загрузки, sha256 считается из источника.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта в хранилище.
//  Источник - Строка, ДвоичныеДанные - путь к файлу с содержимым либо само содержимое.
//
// Возвращаемое значение:
//  Структура - Sha256 (Строка, hex в нижнем регистре), Размер (Число, байт).
//
// Выбрасывает исключение при превышении квоты и при недоступности файла-источника.
//
Функция Сохранить(Знач Координаты, Знач Источник) Экспорт

	Ключ = КлючИзКоординат(Координаты);
	РазмерАртефакта = Артефакты.РазмерИсточника(Источник);

	ПроверитьКвоту(Ключ, РазмерАртефакта);

	Sha256 = Артефакты.Sha256Источника(Источник);

	Клиент.Положить(Ключ, Источник, ТипыСодержимого.ПоИмениФайла(Координаты.ИмяФайла()));

	Возврат Новый Структура("Sha256, Размер", Sha256, РазмерАртефакта);

КонецФункции

// Скачивает артефакт во временную копию и отдаёт путь к ней.
// Вызывающий обязан вызвать ОсвободитьВыдачу, иначе копии .ospx накапливаются на диске.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта в хранилище.
//  ОжидаемыйSha256 - Строка - контрольная сумма для сверки (необязательный, по умолчанию "" — не сверять).
//
// Возвращаемое значение:
//  Строка - абсолютный путь к временной копии.
//
// Выбрасывает исключение, если артефакта нет или сумма не совпала.
//
Функция Получить(Знач Координаты, Знач ОжидаемыйSha256 = "") Экспорт

	Ключ = КлючИзКоординат(Координаты);
	ПутьКопии = ПолучитьИмяВременногоФайла("ospx");

	Попытка
		Клиент.Скачать(Ключ, ПутьКопии);
	Исключение
		Уборка.УдалитьФайл(ПутьКопии);
		ВызватьИсключение ОтказСКоординатами(ИнформацияОбОшибке(), Координаты);
	КонецПопытки;

	Если ЗначениеЗаполнено(ОжидаемыйSha256) Тогда

		ФактическийSha256 = Артефакты.Sha256Файла(ПутьКопии);
		Если ФактическийSha256 <> НРег(ОжидаемыйSha256) Тогда
			Уборка.УдалитьФайл(ПутьКопии);
			ВызватьИсключение СтрШаблон(
				"Контрольная сумма артефакта %1 не совпадает: ожидалась %2, фактическая %3",
				Координаты.Представление(), НРег(ОжидаемыйSha256), ФактическийSha256);
		КонецЕсли;

	КонецЕсли;

	ВзятьНаУчёт(ПутьКопии);

	Возврат ПутьКопии;

КонецФункции

// Удаляет временную копию, выданную методом Получить.
// Идемпотентна; пути вне реестра выданных копий игнорирует.
//
// Параметры:
//  Путь - Строка - путь, полученный из Получить.
//
Процедура ОсвободитьВыдачу(Знач Путь) Экспорт

	Если НЕ ЗначениеЗаполнено(Путь) ИЛИ НЕ СнятьСУчёта(Путь) Тогда
		Возврат;
	КонецЕсли;

	Уборка.УдалитьФайл(Путь);

КонецПроцедуры

// Число ещё не освобождённых временных копий. Диагностика, не часть контракта хранилища.
//
// Возвращаемое значение:
//  Число - количество невозвращённых выдач.
//
Функция ЧислоВыданныхКопий() Экспорт

	Замок.Заблокировать();
	Попытка
		Итог = ВыданныеКопии.Количество();
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Возврат Итог;

КонецФункции

// Возвращает содержимое артефакта в память.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта в хранилище.
//  ОжидаемыйSha256 - Строка - контрольная сумма для сверки (необязательный, по умолчанию "" — не сверять).
//
// Возвращаемое значение:
//  ДвоичныеДанные - содержимое артефакта.
//
// Выбрасывает исключение, если артефакта нет или сумма не совпала.
//
Функция ПолучитьДанные(Знач Координаты, Знач ОжидаемыйSha256 = "") Экспорт

	Ключ = КлючИзКоординат(Координаты);

	Попытка
		Данные = Клиент.ПолучитьБайты(Ключ);
	Исключение
		ВызватьИсключение ОтказСКоординатами(ИнформацияОбОшибке(), Координаты);
	КонецПопытки;

	Если ЗначениеЗаполнено(ОжидаемыйSha256) Тогда

		ФактическийSha256 = Артефакты.Sha256Данных(Данные);
		Если ФактическийSha256 <> НРег(ОжидаемыйSha256) Тогда
			ВызватьИсключение СтрШаблон(
				"Контрольная сумма артефакта %1 не совпадает: ожидалась %2, фактическая %3",
				Координаты.Представление(), НРег(ОжидаемыйSha256), ФактическийSha256);
		КонецЕсли;

	КонецЕсли;

	Возврат Данные;

КонецФункции

// Проверяет наличие артефакта в хранилище.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта в хранилище.
//
// Возвращаемое значение:
//  Булево - Истина, если артефакт существует; Ложь, если хранилище сказало «его нет».
//
// Выбрасывает dependency.unavailable, если хранилище не ответило по существу.
//
Функция Существует(Знач Координаты) Экспорт
	Возврат Клиент.Существует(КлючИзКоординат(Координаты));
КонецФункции

// Удаляет артефакт. Идемпотентна: отсутствие артефакта не ошибка.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта в хранилище.
//
Процедура Удалить(Знач Координаты) Экспорт
	Клиент.Удалить(КлючИзКоординат(Координаты));
КонецПроцедуры

// Возвращает размер артефакта.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта в хранилище.
//
// Возвращаемое значение:
//  Число - размер в байтах.
//
// Выбрасывает исключение, если артефакта нет.
//
Функция Размер(Знач Координаты) Экспорт

	Ключ = КлючИзКоординат(Координаты);

	Попытка
		Возврат Клиент.Размер(Ключ);
	Исключение
		ВызватьИсключение ОтказСКоординатами(ИнформацияОбОшибке(), Координаты);
	КонецПопытки;

КонецФункции

// Суммарный объём хранимых артефактов; по нему проверяется квота.
//
// Возвращаемое значение:
//  Число - занятый объём в байтах.
//
Функция ЗанятыйОбъем() Экспорт
	Возврат ОбъёмПрефикса(Ключи.ГоловаПулов());
КонецФункции

// Отвечает ли хранилище: описание заведомо отсутствующего объекта. «Объекта нет» —
// это успех пробы: корзина ответила по существу. Класть ничего нельзя — запись дала бы
// ложный отказ там, где ключи открыты только на чтение.
//
// Параметры:
//  СрокСек - Число - сколько ждать ответа, секунды.
//
// Возвращаемое значение:
//  Структура - Успех, ОтказДоступа, Сообщение.
//
Функция Доступность(Знач СрокСек) Экспорт

	Попытка
		Ответ = Клиент.ОписаниеОбъекта(Ключи.КлючПробы(), СрокСек);
	Исключение
		Возврат НеОтвечает(Ошибки.Фраза(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Приговор.Успех(Ответ) ИЛИ Приговор.ЭтоОтсутствие(Ответ) Тогда
		Возврат Отвечает();
	КонецЕсли;

	Если Приговор.ЭтоОтказДоступа(Ответ) Тогда
		Возврат НеПустило(ЧемОтветило(Ответ));
	КонецЕсли;

	Возврат НеОтвечает(ЧемОтветило(Ответ));

КонецФункции

// Объём области хранения пула: все объекты под префиксом пула, независимо от того,
// разбираются ли их ключи в координаты. Пустое либо небезопасное имя пула даёт 0.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Число - занятый объём, байты.
//
// Выбрасывает исключение, если листинг бакета не удался: тихий недосчёт занятого
// хуже отказа (ограничения листинга S3).
//
Функция ОбъёмПула(Знач ИмяПула) Экспорт

	Если НЕ ЗначениеЗаполнено(ИмяПула) ИЛИ НЕ Ключи.СегментБезопасен(ИмяПула) Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ОбъёмПрефикса(Ключи.ПрефиксПула(ИмяПула));

КонецФункции

// Объёмы областей всех пулов ОДНИМ листингом префикса pools: поштучный ОбъёмПула стоит
// столько же, сколько этот проход, — oint сужает серверный префикс только до pools.
//
// Возвращаемое значение:
//  Соответствие - имя пула (Строка) -> занятый объём (Число, байты).
//
// Выбрасывает исключение, если листинг бакета не удался.
//
Функция ОбъёмыПулов() Экспорт

	Результат = Новый Соответствие();

	Для Каждого Объект Из Клиент.Перечислить(Ключи.ГоловаПулов()) Цикл

		ИмяПула = Ключи.ПулКлюча(Объект.Ключ);
		Если НЕ ЗначениеЗаполнено(ИмяПула) Тогда
			Продолжить; // ключ ровно вида «pools/» — области пула не принадлежит
		КонецЕсли;

		Было = Результат.Получить(ИмяПула);
		Результат.Вставить(ИмяПула, ?(Было = Неопределено, 0, Было) + Объект.Размер);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Опись артефактов пула с размерами и временем изменения: один перечень вместо вопроса на объект.
// Пустое либо небезопасное имя пула даёт пустую опись, а не ошибку.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Массив из Структура - Пул, Пакет, ИмяФайла (Строка), Размер (Число), Изменён (Дата).
//
Функция Опись(Знач ИмяПула) Экспорт

	Результат = Новый Массив();

	Если НЕ ЗначениеЗаполнено(ИмяПула) ИЛИ НЕ Ключи.СегментБезопасен(ИмяПула) Тогда
		Возврат Результат;
	КонецЕсли;

	ПрефиксПула = Ключи.ПрефиксПула(ИмяПула);

	Для Каждого Объект Из Клиент.Перечислить(ПрефиксПула) Цикл

		Компоненты = Ключи.Разобрать(Объект.Ключ);
		Если Компоненты = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Новый Структура("Пул, Пакет, ИмяФайла, Размер, Изменён",
			Компоненты.Пул,
			Компоненты.Пакет,
			Компоненты.ИмяФайла,
			Объект.Размер,
			Объект.Изменён));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Удаляет один артефакт по компонентам пути, без версии. Идемпотентна.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//  ИмяФайла - Строка - имя файла артефакта.
//
Процедура УдалитьФайл(Знач ИмяПула, Знач ИмяПакета, Знач ИмяФайла) Экспорт
	Клиент.Удалить(Ключи.Собрать(ИмяПула, ИмяПакета, ИмяФайла));
КонецПроцедуры

// Сносит область хранения пула целиком: все ключи под префиксом пула, независимо от того,
// разбираются ли они в координаты. Идемпотентна: пустой префикс — не ошибка.
//
// Параметры:
//  ИмяПула - Строка - имя пула, чья область сносится.
//
// Возвращаемое значение:
//  Число - сколько объектов фактически удалено.
//
Функция УдалитьОбластьПула(Знач ИмяПула) Экспорт

	Если НЕ ЗначениеЗаполнено(ИмяПула) ИЛИ НЕ Ключи.СегментБезопасен(ИмяПула) Тогда
		Возврат 0;
	КонецЕсли;

	// перечисление ПРЕФИКСОМ, а не описью: опись отбрасывает ключи, не разобравшиеся
	// в координаты, а сносить надо всё, что лежит под именем пула
	Снято = 0;
	Для Каждого Объект Из Клиент.Перечислить(Ключи.ПрефиксПула(ИмяПула)) Цикл
		Клиент.Удалить(Объект.Ключ);
		Снято = Снято + 1;
	КонецЦикла;

	Возврат Снято;

КонецФункции

// Переносит область хранения пула целиком. У объектного хранилища нет дешёвого rename:
// перенос идёт скачать/положить/удалить по каждому ключу, порядок оставляет при сбое
// лишнюю копию, а не потерю. Отсутствие исходной области не ошибка.
//
// Параметры:
//  СтароеИмя - Строка - имя пула, чья область переносится.
//  НовоеИмя - Строка - имя пула-приёмника.
//
// Выбрасывает исключение при небезопасных именах и при непустой целевой области.
//
Процедура ПереименоватьПул(Знач СтароеИмя, Знач НовоеИмя) Экспорт

	Если НЕ Ключи.СегментБезопасен(СтароеИмя) ИЛИ НЕ Ключи.СегментБезопасен(НовоеИмя) Тогда
		ВызватьИсключение "Недопустимое имя пула для переноса области хранения";
	КонецЕсли;
	Если Строка(СтароеИмя) = Строка(НовоеИмя) Тогда
		Возврат;
	КонецЕсли;

	Перенос = Опись(СтароеИмя);
	Если Перенос.Количество() = 0 Тогда
		Возврат; // области нет — переносить нечего
	КонецЕсли;

	Если Опись(НовоеИмя).Количество() > 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Область хранения пула ""%1"" уже существует: сливать её с областью ""%2"" нельзя",
			НовоеИмя, СтароеИмя);
	КонецЕсли;

	Для Каждого Запись Из Перенос Цикл

		СтарыйКлюч = Ключи.Собрать(СтароеИмя, Запись.Пакет, Запись.ИмяФайла);
		НовыйКлюч = Ключи.Собрать(НовоеИмя, Запись.Пакет, Запись.ИмяФайла);

		Временный = Уборка.ВременныйПуть("oshub-move-", "bin");
		Попытка
			Клиент.Скачать(СтарыйКлюч, Временный);
			// тип переезжает вместе с объектом: у корзины он живёт только в самом объекте
			Клиент.Положить(НовыйКлюч, Временный, ТипыСодержимого.ПоИмениФайла(Запись.ИмяФайла));
		Исключение
			Уборка.УдалитьФайл(Временный);
			ВызватьИсключение;
		КонецПопытки;
		Уборка.УдалитьФайл(Временный);

		Клиент.Удалить(СтарыйКлюч);

	КонецЦикла;

КонецПроцедуры

// Имя бэкенда для диагностики и health-проверок.
//
// Возвращаемое значение:
//  Строка - "s3".
//
Функция Бэкенд() Экспорт
	Возврат "s3";
КонецФункции

Процедура ПриСозданииОбъекта(Знач _Клиент, Знач Префикс = "", Знач ЛимитОбъемаБайт = 0,
	Знач ПотолокЖивой = Неопределено)

	Если _Клиент = Неопределено Тогда
		ВызватьИсключение "S3Хранилище требует КлиентS3 (передайте реализацию шва)";
	КонецЕсли;

	Клиент = _Клиент;
	Ключи = Новый РаскладкаКлючейS3(Префикс);
	Артефакты = Новый ПомощникАртефакта();
	ТипыСодержимого = Новый ТипСодержимогоАртефакта();
	Уборка = Новый ТихаяУборка();
	Приговор = Новый ВердиктОтветаS3();
	Вердикты = Новый Вердикт();
	Ошибки = Новый ТекстОшибки();
	ВыданныеКопии = Новый Соответствие();
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);

	Квота = Новый КвотаХранилища(ЛимитОбъемаБайт, ПотолокЖивой);

КонецПроцедуры

#Область ОтветПробы

Функция Отвечает()
	Возврат Вердикты.УспехСловами(Новый Структура("ОтказДоступа", Ложь));
КонецФункции

Функция НеОтвечает(Знач Сообщение)
	Возврат Вердикты.ОтказСловами(Сообщение, Новый Структура("ОтказДоступа", Ложь));
КонецФункции

Функция НеПустило(Знач Сообщение)
	Возврат Вердикты.ОтказСловами(Сообщение, Новый Структура("ОтказДоступа", Истина));
КонецФункции

// Чем ответила корзина: статус и, если ответ его нёс, машинный код с сообщением.
// Больше из ответа не берётся ничего — рядом с кодом S3 кладёт эхо ключа доступа.
Функция ЧемОтветило(Знач Ответ)

	Пояснение = Приговор.ПояснениеОтказа(Ответ);
	Возврат СтрШаблон("хранилище ответило %1%2",
		Формат(Приговор.Статус(Ответ), "ЧГ=0"),
		?(ЗначениеЗаполнено(Пояснение), ": " + Пояснение, ""));

КонецФункции

#КонецОбласти

#Область РеестрВыданныхКопий

Процедура ВзятьНаУчёт(Знач Путь)

	Замок.Заблокировать();
	Попытка
		ВыданныеКопии.Вставить(Путь, Истина);
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

КонецПроцедуры

// Проверка и снятие — один шаг под замком: Ложь, если путь не выдавался или уже освобождён.
Функция СнятьСУчёта(Знач Путь)

	Замок.Заблокировать();
	Попытка
		Выдан = ВыданныеКопии.Получить(Путь) <> Неопределено;
		Если Выдан Тогда
			ВыданныеКопии.Удалить(Путь);
		КонецЕсли;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Возврат Выдан;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбъёмПрефикса(Знач Префикс)

	Всего = 0;
	Для Каждого Объект Из Клиент.Перечислить(Префикс) Цикл
		Всего = Всего + Объект.Размер;
	КонецЦикла;
	Возврат Всего;

КонецФункции

Функция КлючИзКоординат(Знач Координаты)
	Возврат Ключи.Собрать(Координаты.Пул(), Координаты.Пакет(), Координаты.ИмяФайла());
КонецФункции

Процедура ПроверитьКвоту(Знач Ключ, Знач РазмерНового)

	Если Квота.Байт() <= 0 Тогда
		Возврат;
	КонецЕсли;

	Занято = ЗанятыйОбъем();

	// при перезаписи прежний размер объекта освобождается
	Если Клиент.Существует(Ключ) Тогда
		Занято = Занято - Клиент.Размер(Ключ);
	КонецЕсли;

	Квота.Проверить(Занято, РазмерНового);

КонецПроцедуры

// Ключ шва — плоский, а зовущему нужны координаты артефакта. Отказ клиента не подменяется,
// а оборачивается СВОИМ кодом и СВОИМ сообщением: наружу идёт фраза хаба, а дословный
// текст библиотеки хранилища остаётся причиной и доезжает только до журнала.
Функция ОтказСКоординатами(Знач Причина, Знач Координаты)

	Если ДиагностикаОшибок.Содержит(Причина, КодыСтандартныхОшибок.РесурсНеНайден()) Тогда
		Возврат ФабрикаОшибок.Обернуть(Причина, КодыСтандартныхОшибок.РесурсНеНайден(),
			СтрШаблон("Артефакт не найден в хранилище: %1", Координаты.Представление()));
	КонецЕсли;

	Если ДиагностикаОшибок.Содержит(Причина, КодыСтандартныхОшибок.ЗависимостьНедоступна()) Тогда
		Возврат ФабрикаОшибок.Обернуть(Причина, КодыСтандартныхОшибок.ЗависимостьНедоступна(),
			СтрШаблон("Хранилище не отдало артефакт %1", Координаты.Представление()));
	КонецЕсли;

	// сбой без машинного кода за отказ хранилища не выдаём: пусть остаётся неклассифицированным
	Возврат ФабрикаОшибок.ОбернутьКонтекстом(Причина,
		СтрШаблон("Чтение артефакта %1 из хранилища", Координаты.Представление()));

КонецФункции

#КонецОбласти
