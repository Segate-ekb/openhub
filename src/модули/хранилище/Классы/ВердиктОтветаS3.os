// Приговор по ответу S3-хранилища: успех, отсутствие объекта и пояснение отказа читаются
// из СТРУКТУРЫ ответа, а не из слов в его тексте. Ни сети, ни oint — только разбор значения.

#Область ПубличныйИнтерфейс

// Статус HTTP из ответа хранилища.
//
// Параметры:
//  Ответ - Произвольный - структура ответа oint; допускается любое значение.
//
// Возвращаемое значение:
//  Число - код состояния; 0, если ответ структурой не является либо статуса не несёт.
//
Функция Статус(Знач Ответ) Экспорт

	Если ТипЗнч(Ответ) <> Тип("Структура") ИЛИ НЕ Ответ.Свойство("status") Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Возврат Число(Ответ["status"]);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Хранилище выполнило запрос.
//
// Параметры:
//  Ответ - Произвольный - структура ответа oint.
//
// Возвращаемое значение:
//  Булево - Истина для статусов 2xx.
//
Функция Успех(Знач Ответ) Экспорт
	Код = Статус(Ответ);
	Возврат Код >= 200 И Код < 300;
КонецФункции

// Хранилище ответило «объекта нет» — и это ответ по существу, а не отказ обслуживать.
// Признаётся по статусу 404 и по машинному коду S3 `NoSuchKey`: второй приезжает и с 403,
// когда бакет закрыт листингом, но объект честно отсутствует.
//
// Параметры:
//  Ответ - Произвольный - структура ответа oint.
//
// Возвращаемое значение:
//  Булево - Истина, если хранилище сообщило именно об отсутствии объекта.
//
Функция ЭтоОтсутствие(Знач Ответ) Экспорт
	Возврат Статус(Ответ) = 404 ИЛИ НРег(КодОшибки(Ответ)) = "nosuchkey";
КонецФункции

// Хранилище не ответило по существу на вопрос «есть ли объект»: это не «есть» и не «нет»,
// а отказ обслуживать. Выдать такой ответ за отсутствие значит сказать клиенту «пакета нет»
// вместо «попробуйте позже».
//
// Параметры:
//  Ответ - Произвольный - структура ответа oint.
//
// Возвращаемое значение:
//  Булево - Истина, если по ответу о наличии объекта судить нельзя.
//
Функция ХранилищеНеОтветилоПоСуществу(Знач Ответ) Экспорт
	Возврат НЕ Успех(Ответ) И НЕ ЭтоОтсутствие(Ответ);
КонецФункции

// Машинный код ошибки S3 из тела ответа: NoSuchKey, NoSuchBucket, AccessDenied и т.п.
//
// Параметры:
//  Ответ - Произвольный - структура ответа oint.
//
// Возвращаемое значение:
//  Строка - код; пустая строка, если тело кода не несёт.
//
Функция КодОшибки(Знач Ответ) Экспорт

	Ошибка = БлокОшибки(Ответ);
	Если Ошибка = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Код = ЗначениеПоля(Ошибка, "Code");
	Возврат ?(Код = Неопределено, "", Строка(Код));

КонецФункции

// Пояснение отказа для журнала: только Error.Code и Error.Message — эхо AccessKeyId,
// которое S3 кладёт рядом, в текст исключения попасть не должно.
//
// Параметры:
//  Ответ - Произвольный - структура ответа oint.
//
// Возвращаемое значение:
//  Строка - «код X: сообщение»; пустая строка, если тело ошибки не описано.
//
Функция ПояснениеОтказа(Знач Ответ) Экспорт

	Ошибка = БлокОшибки(Ответ);
	Если Ошибка = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив();

	Код = ЗначениеПоля(Ошибка, "Code");
	Если Код <> Неопределено Тогда
		Части.Добавить("код " + Строка(Код));
	КонецЕсли;

	Сообщение = ЗначениеПоля(Ошибка, "Message");
	Если Сообщение <> Неопределено Тогда
		Части.Добавить(Строка(Сообщение));
	КонецЕсли;

	Возврат СтрСоединить(Части, ": ");

КонецФункции

// Размер объекта по заголовку Content-Length.
//
// Параметры:
//  Ответ - Произвольный - структура ответа oint.
//
// Возвращаемое значение:
//  Число - длина в байтах; -1, если заголовка нет либо он не число.
//
Функция ДлинаСодержимого(Знач Ответ) Экспорт

	Если ТипЗнч(Ответ) <> Тип("Структура") ИЛИ НЕ Ответ.Свойство("headers")
		ИЛИ Ответ["headers"] = Неопределено Тогда
		Возврат -1;
	КонецЕсли;

	Для Каждого КлючЗначение Из Ответ["headers"] Цикл
		Если НРег(Строка(КлючЗначение.Ключ)) = "content-length" Тогда
			Попытка
				Возврат Число(КлючЗначение.Значение);
			Исключение
				Возврат -1;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Возврат -1;

КонецФункции

// Значение поля коллекции ответа: разбор oint кладёт узлы то структурой, то соответствием.
//
// Параметры:
//  Коллекция - Произвольный - узел разобранного ответа.
//  Имя - Строка - имя поля.
//
// Возвращаемое значение:
//  Произвольный - значение поля; Неопределено, если поля нет.
//
Функция ЗначениеПоля(Знач Коллекция, Знач Имя) Экспорт

	Если ТипЗнч(Коллекция) = Тип("Соответствие") Тогда
		Возврат Коллекция.Получить(Имя);
	ИначеЕсли ТипЗнч(Коллекция) = Тип("Структура") И Коллекция.Свойство(Имя) Тогда
		Возврат Коллекция[Имя];
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция БлокОшибки(Знач Ответ)

	Если ТипЗнч(Ответ) <> Тип("Структура") ИЛИ НЕ Ответ.Свойство("response")
		ИЛИ Ответ["response"] = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ЗначениеПоля(Ответ["response"], "Error");

КонецФункции

#КонецОбласти
