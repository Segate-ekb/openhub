// Readiness хаба: «стартовая последовательность завершена И все обязательные стартовые
// задачи отработали». Отдельно от /health (liveness) — за балансировщиком живой, но
// недособранный инстанс не должен получать трафик.
//
// Гейт — задача, без которой хаб отдаёт неверный результат или молча теряет данные.
// Задача заявляет себя в конструкторе рогатки, а закрывает гейт последней строкой
// ПриЗапускеПриложения без Попытка вокруг тела: упала — /ready честно отвечает 503.
// Ошибки ФОНОВЫХ рогаток ОСень только логирует, поэтому порядка старта недостаточно.

Перем Задачи;              // Соответствие: имя задачи -> Булево (выполнена)
&Лог
Перем Лог;
Перем СтартЗавершён;       // Булево - синхронная фаза дошла до открытия порта
Перем МоментГотовности_;   // Дата (UTC), Неопределено — пока не готов

// Объявляет обязательную стартовую задачу. Вызывается в конструкторе рогатки,
// чтобы список гейтов был полон до первого запуска задач.
//
// Параметры:
//  Имя - Строка - имя задачи; попадает в /ready как pending.
//
Процедура ЗаявитьЗадачу(Знач Имя) Экспорт

	Если Задачи.Получить(Имя) = Неопределено Тогда
		Задачи.Вставить(Имя, Ложь);
		Лог.Отладка("Готовность: заявлен гейт ""%1"", всего заявлено %2", Имя, Задачи.Количество());
	КонецЕсли;

КонецПроцедуры

// Отмечает, что стартовая задача отработала полностью, и пишет остаток гейтов в лог.
// Вызывается последней строкой ПриЗапускеПриложения.
//
// Параметры:
//  Имя - Строка - то же имя, что при заявке.
//
Процедура ОтметитьЗадачуВыполненной(Знач Имя) Экспорт

	Задачи.Вставить(Имя, Истина);
	ЗафиксироватьМоментГотовности();

	// В журнал безусловно: при незавершённом старте порт закрыт и /ready недоступен,
	// по этим строкам видно, какой гейт остался открытым.
	Осталось = НезавершённыеЗадачи();
	Лог.Информация("Стартовая задача ""%1"" отработала; осталось задач: %2%3",
		Имя, Осталось.Количество(),
		?(Осталось.Количество() = 0, "", " (" + СтрСоединить(Осталось, ", ") + ")"));

КонецПроцедуры

// Отмечает завершение синхронной фазы старта. Вызывается желудём ОткрытиеПорта
// перед тем, как поднять слушатель.
//
Процедура ОтметитьСтартЗавершённым() Экспорт
	СтартЗавершён = Истина;
	ЗафиксироватьМоментГотовности();
	Лог.Отладка("Готовность: синхронная фаза старта завершена, открытых гейтов %1",
		НезавершённыеЗадачи().Количество());
КонецПроцедуры

// Готов ли хаб принимать трафик: синхронная фаза завершена и все заявленные задачи
// отработали.
//
// Возвращаемое значение:
//  Булево - Истина, если хаб готов.
//
Функция Готов() Экспорт

	Если НЕ СтартЗавершён Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НезавершённыеЗадачи().Количество() = 0;

КонецФункции

// Вынесено из Готов(), чтобы запрос состояния оставался запросом, а не менял состояние.
Процедура ЗафиксироватьМоментГотовности()

	Если МоментГотовности_ = Неопределено И Готов() Тогда
		МоментГотовности_ = ТекущаяУниверсальнаяДата();
	КонецЕсли;

КонецПроцедуры

// Имена заявленных, но ещё не отработавших стартовых задач.
//
// Возвращаемое значение:
//  Массив - имена задач (Строка).
//
Функция НезавершённыеЗадачи() Экспорт

	Результат = Новый Массив();

	Для Каждого Задача Из Задачи Цикл
		Если НЕ Задача.Значение Тогда
			Результат.Добавить(Задача.Ключ);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Момент, когда хаб впервые оказался готов.
//
// Возвращаемое значение:
//  Дата, Неопределено - момент готовности в UTC; Неопределено, пока хаб не готов.
//
Функция МоментГотовности() Экспорт
	Возврат МоментГотовности_;
КонецФункции

// Машиночитаемое состояние готовности для эндпоинта /ready.
//
// Возвращаемое значение:
//  Структура - status ("ready" либо "starting"), ready (Булево),
//              pending (Массив имён незавершённых задач).
//
Функция Состояние() Экспорт

	Готовность = Готов();
	Ожидают = НезавершённыеЗадачи();

	// «почему /ready отвечает 503» разбирается здесь: видно и фазу старта, и остаток гейтов
	Лог.Отладка("Готовность: готов %1, синхронная фаза завершена %2, ждём гейтов %3 (%4)",
		Готовность, СтартЗавершён, Ожидают.Количество(), СтрСоединить(Ожидают, ", "));

	Данные = Новый Структура();
	Данные.Вставить("status", ?(Готовность, "ready", "starting"));
	Данные.Вставить("ready", Готовность);
	Данные.Вставить("pending", Ожидают);

	Возврат Данные;

КонецФункции

// Лог инъекцией в поле (&Лог выше) — боевой путь; параметр _Лог — для прямого
// создания вне контейнера, куда инъекция в поле не доезжает.
&Желудь
Процедура ПриСозданииОбъекта(
	&Лог _Лог = Неопределено)
	Задачи = Новый Соответствие();
	СтартЗавершён = Ложь;
	МоментГотовности_ = Неопределено;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
КонецПроцедуры
