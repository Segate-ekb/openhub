// GET /ready -> 200 {"status":"ready"} либо 503 {"status":"starting"}. Отдельно от /health:
// тот обязан отвечать 200, пока процесс жив, иначе оркестратор перезапустит стартующий хаб.

Перем Готовность; // ГотовностьХаба

// GET /ready — готовность хаба принимать трафик: 200 для готового, 503 для стартующего.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow, заполняется JSON-состоянием готовности.
//
&ТочкаМаршрута("/ready")
Процедура СостояниеГотовности(Ответ) Экспорт

	Состояние = Готовность.Состояние();

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Состояние);

	Если Готовность.Готов() Тогда
		Ответ.УстановитьСостояниеОК();
	Иначе
		// 503: балансировщик выводит инстанс из ротации, оркестратор не перезапускает.
		Ответ.УстановитьСостояние(503);
	КонецЕсли;

	Ответ.Заголовки["Content-Type"] = "application/json; charset=utf-8";
	Ответ.ТелоТекст = Запись.Закрыть();

КонецПроцедуры

&Контроллер("/")
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ГотовностьХаба") _Готовность)
	Готовность = _Готовность;
КонецПроцедуры
