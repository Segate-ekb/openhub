// GET /ready -> 200 {"status":"ready"} либо 503 {"status":"starting"|"database_unavailable"}.
// Отдельно от /health: тот обязан отвечать 200, пока процесс жив, иначе оркестратор
// перезапустит стартующий хаб — и тот же перезапуск не вылечит отвалившуюся базу.

Перем Готовность; // ГотовностьХаба — реестр стартовых гейтов
Перем База;       // ПробаБазы (данные) — отвечает ли база и снимок её пула
Перем Ответы;     // ОтветыAPI (основа) - JSON-ответ машинной двери

// GET /ready — готовность хаба принимать трафик: 200 для готового, 503 для стартующего
// и для того, у кого не отвечает база.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow, заполняется JSON-состоянием готовности.
//
&ТочкаМаршрута("/ready")
Процедура СостояниеГотовности(Ответ) Экспорт

	Гейты = Готовность.Состояние();
	СостояниеБазы = База.Состояние();
	ПринимаетТрафик = Гейты.СтартЗавершён И База.Отвечает(СостояниеБазы);

	Тело = Новый Структура();
	Тело.Вставить("status", ПризнакГотовности(ПринимаетТрафик, Гейты.СтартЗавершён));
	Тело.Вставить("ready", ПринимаетТрафик);
	Тело.Вставить("pending", Гейты.Ожидают);
	Тело.Вставить("database", СостояниеБазы);

	// 503: балансировщик выводит инстанс из ротации, оркестратор не перезапускает.
	Ответы.JSON(Ответ, ?(ПринимаетТрафик, 200, 503), Тело);

КонецПроцедуры

// «Стартую» и «база не отвечает» — разные поводы для 503, и оператор обязан их различать:
// первый пройдёт сам, второй не пройдёт никогда, сколько инстанс ни перезапускай.
Функция ПризнакГотовности(Знач ПринимаетТрафик, Знач СтартЗавершён)

	Если ПринимаетТрафик Тогда
		Возврат "ready";
	КонецЕсли;

	Возврат ?(СтартЗавершён, "database_unavailable", "starting");

КонецФункции

&Контроллер("/")
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ГотовностьХаба") _Готовность,
	&Пластилин(Значение = "ПробаБазы") _База,
	&Пластилин(Значение = "ОтветыAPI") _Ответы)
	Готовность = _Готовность;
	База = _База;
	Ответы = _Ответы;
КонецПроцедуры
