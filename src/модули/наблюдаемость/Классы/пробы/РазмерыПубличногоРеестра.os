// Сколько пулов и пакетов видит анонимный посетитель. Одни и те же числа отдаёт
// эндпоинт /api/v1/metrics и снимают приборы OTel — считаются они здесь, в одном месте.

Перем СервисПулов;   // СервисПулов (реестр)
Перем СервисПакетов; // СервисПакетов (реестр)
Перем Права;         // СервисПрав (права) — признак публичности пула
Перем Лог;
Перем Ошибки;        // ТекстОшибки (основа)

#Область ПубличныйИнтерфейс

// Снимок размеров публичной части реестра. Сбой подсчёта не выбрасывается наружу:
// числа нужны анонимному эндпоинту и фоновому срезу метрик, ронять их нечем — но
// причина сбоя называется в журнале, иначе «-1» оставался бы загадкой.
//
// Возвращаемое значение:
//  Структура - Пулы (Число), Пакеты (Число); -1 в обоих полях, если подсчёт сорвался.
//
Функция Снимок() Экспорт

	Попытка
		Пулы = 0;
		Пакеты = 0;
		Для Каждого Пул Из СервисПулов.ВсеПулы() Цикл
			Если НЕ Права.ПулПубличный(Пул) Тогда
				Продолжить;
			КонецЕсли;
			Пулы = Пулы + 1;
			Для Каждого Пакет Из СервисПакетов.ПакетыПула(Пул.Идентификатор) Цикл
				Если Пакет.Скрыт <> Истина Тогда
					Пакеты = Пакеты + 1;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Возврат Новый Структура("Пулы, Пакеты", Пулы, Пакеты);
	Исключение
		Лог.Предупреждение("Размеры публичного реестра не посчитаны, отдаю -1: %1",
			Ошибки.Однострочно(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Новый Структура("Пулы, Пакеты", -1, -1);
	КонецПопытки;

КонецФункции

// Сорвался ли подсчёт: снимок с отрицательным числом смысла не несёт и в метрику
// не годится.
//
// Параметры:
//  Значение - Число - число из снимка.
//
// Возвращаемое значение:
//  Булево - Истина, если число посчитано.
//
Функция Посчитано(Знач Значение) Экспорт
	Возврат Значение >= 0;
КонецФункции

#КонецОбласти

&Прозвище("РазмерыПубличногоРеестра")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисПрав") _Права,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	Права = _Права;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);

	// Лог параметром, а не полем: сбой подсчёта называется в конструкторе несобранного
	// желудя тоже, а инъекция в поле доезжает только после ПриСозданииОбъекта.
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "РазмерыПубличногоРеестра созданы без лога — сбой подсчёта был бы немым";
	КонецЕсли;
	Лог = _Лог;

КонецПроцедуры
