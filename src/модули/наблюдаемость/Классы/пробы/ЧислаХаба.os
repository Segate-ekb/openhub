// Числа работающего хаба одним снимком: пулы и пакеты, версии, пользователи, скачивания,
// занятое место, очереди фона. Их отдаёт GET /api/v1/metrics и снимают приборы OTel —
// считаются они здесь, в одном месте и в одно мгновение.
//
// Сорванное число отдаётся признаком «посчитать не вышло», а не исключением: анонимный
// адрес и фоновый срез метрик ронять нечем. Сбой одного числа остальных не касается.

Перем Размеры;             // РазмерыПубличногоРеестра — публичные пулы и пакеты
Перем СервисПулов;         // СервисПулов (реестр) — пулы и занятое ими место
Перем Права;               // СервисПрав (права) — признак публичности пула
Перем ХранилищеВерсий;     // ХранилищеВерсийПакета (данные)
Перем СервисПользователей; // СервисПользователей (вход)
Перем Статистика;          // СлужбаСтатистикиСкачиваний (статистика)
Перем Доставка;            // СлужбаДоставкиПодписок (подписки)
Перем СинхронизацияЗеркал; // ОчередьСинхронизацииЗеркал (зеркала)
Перем Издатель;            // ИздательСобытий (события)
Перем Лог;
Перем Ошибки;              // ТекстОшибки (основа)

#Область ПубличныйИнтерфейс

// Снимок чисел хаба. Все числа снимаются одним вызовом, чтобы график и ответ адреса
// рассказывали об одном мгновении, а не о девяти разных.
//
// Возвращаемое значение:
//  Структура - Пулы, Пакеты, Версии, Пользователи, Скачивания, ОчередьВебхуков,
//              ОчередьЗеркал, ПропущенныеСобытия, МестоПублично (Число; -1, если
//              подсчёт сорвался), МестоПоПулам (Массив из Структура Имя, Байт,
//              Публичный).
//
&Наблюдаемый("metrics.hub_numbers")
Функция Снимок() Экспорт

	// пулы читаются ОДИН раз на снимок: их спрашивают и числа реестра, и занятое место
	Пулы = ПулыРеестра();
	Публичное = Размеры.Снимок(Пулы);
	Место = ЗанятоеМесто(Пулы);

	Снимок = Новый Структура();
	Снимок.Вставить("Пулы", Публичное.Пулы);
	Снимок.Вставить("Пакеты", Публичное.Пакеты);
	Снимок.Вставить("Версии", Версии());
	Снимок.Вставить("Пользователи", Пользователи());
	Снимок.Вставить("Скачивания", Скачивания());
	Снимок.Вставить("МестоПоПулам", Место.ПоПулам);
	Снимок.Вставить("МестоПублично", Место.Публично);
	Снимок.Вставить("ОчередьВебхуков", ОчередьВебхуков());
	Снимок.Вставить("ОчередьЗеркал", ОчередьЗеркал());
	Снимок.Вставить("ПропущенныеСобытия", ПропущенныеСобытия());

	Возврат Снимок;

КонецФункции

// Сорвался ли подсчёт: признак у всех чисел хаба один, и правило ему — тоже одно.
//
// Параметры:
//  Значение - Число - число из снимка.
//
// Возвращаемое значение:
//  Булево - Истина, если число посчитано.
//
Функция Посчитано(Знач Значение) Экспорт
	Возврат Размеры.Посчитано(Значение);
КонецФункции

#КонецОбласти

#Область ОтдельныеЧисла

Функция Версии()
	Попытка
		Возврат ХранилищеВерсий.Количество();
	Исключение
		Возврат НеПосчитано("версии реестра", ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция Пользователи()
	Попытка
		Возврат СервисПользователей.ВсегоПользователей();
	Исключение
		Возврат НеПосчитано("пользователи хаба", ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// База плюс ещё не слитое из памяти: число хаба не имеет права отставать от витрин
// на один сброс счётчиков. Сумму считает база одним агрегатом — анонимный адрес
// не должен платить чтением всей таблицы агрегатов за одно число.
Функция Скачивания()
	Попытка
		Возврат Статистика.СкачиванийВсего();
	Исключение
		Возврат НеПосчитано("скачивания", ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// Пулы реестра одним чтением; Неопределено — реестр не читается, и об этом уже сказано
// в журнале. Пустой массив тут не годится: он значил бы «пулов нет».
Функция ПулыРеестра()

	Попытка
		Возврат СервисПулов.ВсеПулы();
	Исключение
		НеПосчитано("пулы реестра", ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Занятое место сразу двумя глазами: по пулам — оператору в метрику, суммой по публичным —
// анонимному адресу, которому приватные пулы не видны даже агрегатом.
Функция ЗанятоеМесто(Знач Пулы)

	Если Пулы = Неопределено Тогда
		Возврат Новый Структура("ПоПулам, Публично", Новый Массив(), -1);
	КонецЕсли;

	Попытка
		ПоПулам = Новый Массив();
		Публично = 0;
		Для Каждого Пул Из Пулы Цикл
			Публичный = Права.ПулПубличный(Пул);
			Байт = СервисПулов.ЗанятоБайт(Пул);
			ПоПулам.Добавить(Новый Структура("Имя, Байт, Публичный",
				Строка(Пул.Имя), Байт, Публичный));
			Если Публичный Тогда
				Публично = Публично + Байт;
			КонецЕсли;
		КонецЦикла;
		Возврат Новый Структура("ПоПулам, Публично", ПоПулам, Публично);
	Исключение
		Возврат Новый Структура("ПоПулам, Публично",
			Новый Массив(), НеПосчитано("занятое пулами место", ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

Функция ОчередьВебхуков()
	Попытка
		Возврат Доставка.РазмерОчереди();
	Исключение
		Возврат НеПосчитано("очередь доставок", ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ОчередьЗеркал()
	Попытка
		Возврат СинхронизацияЗеркал.Размер();
	Исключение
		Возврат НеПосчитано("очередь обходов зеркал", ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ПропущенныеСобытия()
	Попытка
		Возврат Издатель.ПропущенныхДоставок();
	Исключение
		Возврат НеПосчитано("пропущенные доставки событий", ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Число-признак и строка журнала: «-1» без причины остаётся загадкой, а исключение
// уронило бы вместе с одним числом весь снимок. Сбой передаётся параметром: снаружи
// обработчика исключения ИнформацияОбОшибке() уже пуста.
Функция НеПосчитано(Знач Что, Знач Сбой)

	Лог.Предупреждение("Числа хаба: %1 не посчитаны, отдаю -1: %2", Что, Ошибки.Причина(Сбой));

	Возврат -1;

КонецФункции

#КонецОбласти

&Прозвище("ЧислаХаба")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазмерыПубличногоРеестра") _Размеры,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПрав") _Права,
	&Пластилин(Значение = "ХранилищеВерсийПакета") _ХранилищеВерсий,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "СлужбаСтатистикиСкачиваний") _Статистика,
	&Пластилин(Значение = "СлужбаДоставкиПодписок") _Доставка,
	&Пластилин(Значение = "ОчередьСинхронизацииЗеркал") _ОчередьЗеркал,
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Размеры = _Размеры;
	СервисПулов = _СервисПулов;
	Права = _Права;
	ХранилищеВерсий = _ХранилищеВерсий;
	СервисПользователей = _СервисПользователей;
	Статистика = _Статистика;
	Доставка = _Доставка;
	СинхронизацияЗеркал = _ОчередьЗеркал;
	Издатель = _Издатель;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);

	// Лог параметром, а не полем: сбой подсчёта называется и в конструкторе несобранного
	// желудя, а инъекция в поле доезжает только после ПриСозданииОбъекта.
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "ЧислаХаба созданы без лога — сбой подсчёта был бы немым";
	КонецЕсли;
	Лог = _Лог;

КонецПроцедуры
