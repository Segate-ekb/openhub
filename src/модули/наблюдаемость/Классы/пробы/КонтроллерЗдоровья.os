// Контроллер health-эндпоинта.
//   GET /health -> 200, application/json: {"status":"ok","version":"...","uptime_seconds":N,
//   "database":{...}}

Перем СостояниеХаба;        // СостояниеХаба - аптайм приложения
Перем ОписаниеПриложения;   // ОписаниеПриложения - имя и версия
Перем База;                 // ПробаБазы (данные) - отвечает ли база и снимок её пула
Перем Ответы;               // ОтветыAPI (основа) - JSON-ответ машинной двери

// GET /health — проверка живости хаба: статус, версия, аптайм и состояние базы.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow, заполняется JSON-состоянием.
//
&ТочкаМаршрута("/health")
Процедура Здоровье(Ответ) Экспорт

	Данные = Новый Структура();
	Данные.Вставить("status", "ok");
	Данные.Вставить("version", ОписаниеПриложения.Версия());
	Данные.Вставить("uptime_seconds", СостояниеХаба.АптаймСекунд());

	// База названа, но кода не меняет: мёртвая база — не повод перезапускать живой процесс,
	// перезапуск её не лечит. Отказ по базе — дело готовности, а не живости.
	Данные.Вставить("database", База.Состояние());

	Ответы.JSON(Ответ, 200, Данные);

КонецПроцедуры

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СостояниеХаба") _СостояниеХаба,
	&Пластилин(Значение = "ОписаниеПриложения") _ОписаниеПриложения,
	&Пластилин(Значение = "ПробаБазы") _База,
	&Пластилин(Значение = "ОтветыAPI") _Ответы)
	СостояниеХаба = _СостояниеХаба;
	ОписаниеПриложения = _ОписаниеПриложения;
	База = _База;
	Ответы = _Ответы;
КонецПроцедуры
