// Место лога в дереве экрана без списка имён: класс хаба — по месту своего файла в исходниках,
// библиотека — по имени лога, «oshub.*» и «аудит» — особняком.

Перем КаталогМодулей;  // Строка — src/модули
Перем МестаКлассов;    // Соответствие: имя класса → "модуль[/раздел]"; Неопределено — дерево не разобрано

#Область ПубличныйИнтерфейс

// Группа лога — путь через «/».
//
// Параметры:
//  ИмяЛога - Строка - имя лога.
//
// Возвращаемое значение:
//  Строка - "хаб/<модуль>[/<раздел>]" для класса хаба, "хаб/oshub" для логов хаба мимо классов,
//           "библиотеки/<библиотека>" для чужих логов, "библиотеки/?" — голое имя, которого
//           нет среди классов хаба.
//
Функция Группа(Знач ИмяЛога) Экспорт

	Место = Места().Получить(ИмяЛога);
	Если Место <> Неопределено Тогда
		Возврат "хаб/" + Место;
	ИначеЕсли СтрНачинаетсяС(ИмяЛога, "oshub.") ИЛИ ИмяЛога = "аудит" Тогда
		Возврат "хаб/oshub";
	КонецЕсли;
	Возврат "библиотеки/" + Библиотека(ИмяЛога);

КонецФункции

// Входит ли группа в ветку дерева: ветка — начало пути группы по целым сегментам.
//
// Параметры:
//  Группа - Строка - группа лога.
//  Ветка - Строка - путь ветки: "хаб", "хаб/вход", "хаб/вход/паролем".
//
// Возвращаемое значение:
//  Булево
//
Функция ВВетке(Знач Группа, Знач Ветка) Экспорт
	Возврат Группа = Ветка ИЛИ СтрНачинаетсяС(Группа, Ветка + "/");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// «oscript.lib.<библиотека>.*» и «oscript.app.<библиотека>.*», «oscript.<библиотека>.*»,
// «<библиотека>.*»; голое имя без точек библиотеку не называет.
Функция Библиотека(Знач ИмяЛога)

	Части = СтрРазделить(ИмяЛога, ".");
	Если Части.Количество() >= 3 И Части[0] = "oscript" И (Части[1] = "lib" ИЛИ Части[1] = "app") Тогда
		Возврат Части[2];
	ИначеЕсли Части.Количество() >= 2 И Части[0] = "oscript" Тогда
		Возврат Части[1];
	ИначеЕсли Части.Количество() >= 2 Тогда
		Возврат Части[0];
	КонецЕсли;
	Возврат "?";

КонецФункции

// Дерево исходников разбирается один раз, при первом вопросе: модуль/Классы/раздел/Класс.os —
// раздел значим, каталог «Классы» — нет.
Функция Места()

	Если МестаКлассов <> Неопределено Тогда
		Возврат МестаКлассов;
	КонецЕсли;

	Карта = Новый Соответствие();
	Если ЗначениеЗаполнено(КаталогМодулей) Тогда
		Корень = Новый Файл(КаталогМодулей).ПолноеИмя;
		Для Каждого Файл Из НайтиФайлы(Корень, "*.os", Истина) Цикл
			Путь = СтрРазделить(Сред(Файл.Путь, СтрДлина(Корень) + 1), ПолучитьРазделительПути(), Ложь);
			Если Путь.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Место = Путь[0];
			Если Путь.Количество() >= 3 И Путь[1] = "Классы" Тогда
				Место = Место + "/" + Путь[2];
			КонецЕсли;
			Карта.Вставить(Файл.ИмяБезРасширения, Место);
		КонецЦикла;
	КонецЕсли;

	МестаКлассов = Карта;
	Возврат МестаКлассов;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Деталька(Значение = "winow.КаталогСПриложениями", ЗначениеПоУмолчанию = "") _КаталогМодулей = "")

	КаталогМодулей = _КаталогМодулей;

КонецПроцедуры
