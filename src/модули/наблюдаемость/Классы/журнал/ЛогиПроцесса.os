// Логи процесса глазами logos: какие созданы, с каким уровнем пишут и в какие выходы хаба, —
// и правка уровня лога и уровня его выхода в коллектор на месте. Помнит уровень лога до первой правки.

Перем Шкала;       // ШкалаЖурнала (наблюдаемость) — уровни словами и их номера в logos
Перем Коллектор;   // ВыводЛогаВOTelХаба (наблюдаемость) — выход в коллектор, желудь
Перем Память;      // ВыводЛогаВПамятьХаба (наблюдаемость) — выход в память, желудь
Перем Объекты;     // Соответствие: имя лога → лог logos, уже взятый у менеджера логов
Перем Исходные;    // Соответствие: имя лога → уровень до первой правки
Перем Замок;       // БлокировкаРесурса — оба соответствия пополняют потоки запросов

#Область ПубличныйИнтерфейс

// Имена логов, созданных в процессе.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция Имена() Экспорт
	Возврат Логирование.СписокСозданныхЛогов();
КонецФункции

// Создан ли в процессе лог с таким именем. Лога, которого нет, дверь не заводит.
//
// Параметры:
//  Имя - Строка - имя лога.
//
// Возвращаемое значение:
//  Булево
//
Функция Есть(Знач Имя) Экспорт
	Возврат Имена().Найти(Имя) <> Неопределено;
КонецФункции

// Как лог пишет прямо сейчас.
//
// Параметры:
//  Имя - Строка - имя созданного лога.
//
// Возвращаемое значение:
//  Структура:
//   * Уровень - Строка - уровень лога.
//   * ОтНастроек - Булево - лог получил выходы из настроек; Ложь — создан раньше настроек
//                           и пишет выходом logos по умолчанию.
//   * ВКонсоль - Булево - строки лога печатаются в консоль.
//   * ВПамять - Булево - строки лога идут в память хаба.
//   * ЕстьКоллектор - Булево - на логе висит выход хаба в коллектор.
//   * ВКоллектор - Булево - строки лога уходят в коллектор.
//   * УровеньВыходаКоллектора - Строка, Неопределено - свой уровень выхода в коллектор;
//                               Неопределено — выход следует уровню лога либо его нет.
//   * ПрочиеВыходы - Массив из Строка - имена типов чужих выходов лога.
//
Функция Состояние(Знач Имя) Экспорт

	ОбъектЛога = Объект(Имя);

	Итог = Новый Структура();
	Итог.Вставить("Уровень", Словом(ОбъектЛога.Уровень()));
	Итог.Вставить("ОтНастроек", ОбъектЛога.ДобавленыСобственныеСпособыВывода());
	Итог.Вставить("ВКонсоль", Ложь);
	Итог.Вставить("ВПамять", Ложь);
	Итог.Вставить("ЕстьКоллектор", Ложь);
	Итог.Вставить("ВКоллектор", Ложь);
	Итог.Вставить("УровеньВыходаКоллектора", Неопределено);
	Итог.Вставить("ПрочиеВыходы", Новый Массив());

	Для Каждого Выход Из ОбъектЛога.СпособыВывода() Цикл
		Пишет = Выход.Уровень < УровниЛога.Отключить;
		Если Выход.СпособВывода = Коллектор Тогда
			Итог.ЕстьКоллектор = Истина;
			Итог.ВКоллектор = Пишет;
			Итог.УровеньВыходаКоллектора = ?(Выход.ЗаданЯвно, Словом(Выход.Уровень), Неопределено);
		ИначеЕсли Выход.СпособВывода = Память Тогда
			Итог.ВПамять = Пишет;
		ИначеЕсли ЭтоКонсоль(Выход.СпособВывода) Тогда
			Итог.ВКонсоль = Итог.ВКонсоль ИЛИ Пишет;
		ИначеЕсли НЕ ЭтоНемойВыходХаба(Выход.СпособВывода) Тогда
			Итог.ПрочиеВыходы.Добавить(Строка(ТипЗнч(Выход.СпособВывода)));
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// С каким уровнем лог писал до первой правки через эту дверь; нетронутый — с каким пишет сейчас.
//
// Параметры:
//  Имя - Строка - имя созданного лога.
//
// Возвращаемое значение:
//  Строка - уровень.
//
Функция ИсходныйУровень(Знач Имя) Экспорт

	Замок.Заблокировать();
	Запомненный = Исходные.Получить(Имя);
	Замок.Разблокировать();

	Возврат ?(Запомненный = Неопределено, Состояние(Имя).Уровень, Запомненный);

КонецФункции

// Задаёт логу уровень и уровень выхода в коллектор, не меняя состава выходов. Порядок правки
// не даёт окна, в котором коллектор получил бы больше, чем до правки и после неё.
//
// Параметры:
//  Имя - Строка - имя созданного лога.
//  Уровень - Строка - уровень лога.
//  УровеньВыходаКоллектора - Строка, Неопределено - уровень выхода в коллектор (DISABLE — не
//                            отправлять); Неопределено — выход следует уровню лога. У лога без
//                            выхода в коллектор не действует.
//
Процедура Установить(Знач Имя, Знач Уровень, Знач УровеньВыходаКоллектора) Экспорт

	Запомнить(Имя);
	ОбъектЛога = Объект(Имя);
	Число_ = Числом(Уровень);

	Если НЕ Состояние(Имя).ЕстьКоллектор Тогда
		ОбъектЛога.УстановитьУровень(Число_);
	ИначеЕсли УровеньВыходаКоллектора = Неопределено Тогда
		ОбъектЛога.УстановитьУровень(Число_);
		ОбъектЛога.УстановитьУровеньСпособаВывода(Коллектор, Неопределено);
	Иначе
		ОбъектЛога.УстановитьУровеньСпособаВывода(Коллектор, Числом(УровеньВыходаКоллектора));
		ОбъектЛога.УстановитьУровень(Число_);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Выходы

Функция ЭтоКонсоль(Знач Выход)
	Тип_ = ТипЗнч(Выход);
	Возврат Тип_ = Тип("ВыводЛогаВКонсольХаба") ИЛИ Тип_ = Тип("ВыводЛогаВКонсоль");
КонецФункции

// Выход в коллектор или в память, созданный самой logos по имени типа, а не контейнером, немой.
Функция ЭтоНемойВыходХаба(Знач Выход)
	Тип_ = ТипЗнч(Выход);
	Возврат Тип_ = Тип("ВыводЛогаВOTelХаба") ИЛИ Тип_ = Тип("ВыводЛогаВПамятьХаба");
КонецФункции

#КонецОбласти

#Область Логи

// Лог берётся у менеджера один раз: каждое взятие увеличивает счётчик ссылок на лог.
Функция Объект(Знач Имя)

	Замок.Заблокировать();
	Попытка
		ОбъектЛога = Объекты.Получить(Имя);
		Если ОбъектЛога = Неопределено Тогда
			Если НЕ Есть(Имя) Тогда
				ВызватьИсключение СтрШаблон("Лога %1 в процессе нет", Имя);
			КонецЕсли;
			ОбъектЛога = Логирование.ПолучитьЛог(Имя);
			Объекты.Вставить(Имя, ОбъектЛога);
		КонецЕсли;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Возврат ОбъектЛога;

КонецФункции

Процедура Запомнить(Знач Имя)

	Замок.Заблокировать();
	Запомнен = Исходные.Получить(Имя) <> Неопределено;
	Замок.Разблокировать();
	Если Запомнен Тогда
		Возврат;
	КонецЕсли;

	Уровень = Состояние(Имя).Уровень;

	Замок.Заблокировать();
	Если Исходные.Получить(Имя) = Неопределено Тогда
		Исходные.Вставить(Имя, Уровень);
	КонецЕсли;
	Замок.Разблокировать();

КонецПроцедуры

#КонецОбласти

#Область Уровни

Функция Словом(Знач Число_)
	Возврат Шкала.Уровни()[Число_];
КонецФункции

Функция Числом(Знач Слово)

	Место = Шкала.Место(Слово);
	Если Место = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Уровня %1 у logos нет", Слово);
	КонецЕсли;
	Возврат Место;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ШкалаЖурнала") _Шкала,
	&Пластилин(Значение = "ВыводЛогаВOTelХаба") _Коллектор,
	&Пластилин(Значение = "ВыводЛогаВПамятьХаба") _Память)

	Шкала = _Шкала;
	Коллектор = _Коллектор;
	Память = _Память;
	Объекты = Новый Соответствие();
	Исходные = Новый Соответствие();
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);

КонецПроцедуры
