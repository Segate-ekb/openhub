// Заданное с экрана пульта журнала строками переменных окружения, с которыми хаб стартует в том же
// состоянии: что при старте назвала та же переменная, остаётся в строке, заданное с экрана — поверх.

Перем Шкала;   // ШкалаЖурнала (наблюдаемость) — имя корня
Перем Старт;   // СтартЖурнала (наблюдаемость) — что назвали настройки при старте
Перем Имена;   // ИменаПеременныхОкружения (настройки) — имя переменной ключа

#Область ПубличныйИнтерфейс

// Строки переменных окружения, закрепляющие заданное с экрана.
//
// Параметры:
//  Закрепляемое - Структура - то, что задано с экрана, так, как с ним должен стартовать хаб:
//   * Уровни - Соответствие - имя лога (корень — rootLogger) → уровень.
//   * Пороги - Соответствие - имя лога (корень — rootLogger) → порог коллектора: уровень,
//              DISABLE — не отправлять, DEBUG — порога нет, отправлять всё, что пишет лог.
//
// Возвращаемое значение:
//  Массив из Строка - "ПЕРЕМЕННАЯ=значение"; пусто, если с экрана ничего не задано.
//
Функция Строки(Знач Закрепляемое) Экспорт

	Итог = Новый Массив();
	Добавить(Итог, "oshub.log.level", "oshub.log.levels", Закрепляемое.Уровни,
		Старт.УровниНазванные(ПеременнаяКлюча("oshub.log.levels")));
	Добавить(Итог, "oshub.log.otel.level", "oshub.log.otel.levels", Закрепляемое.Пороги,
		Старт.ПорогиНазванные(ПеременнаяКлюча("oshub.log.otel.levels")));
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Корень — своей переменной, логи — списком пар. Переменная списка заменяет своё прежнее значение
// целиком, поэтому названное ею при старте переносится в строку; названное ключом файла остаётся
// в файле — переменная сильнее его только для логов, которые называет сама. Корень из списка
// уходит, когда у него своя строка.
Процедура Добавить(Итог, Знач КлючКорня, Знач КлючЛогов, Знач СЭкрана, Знач Названные)

	Корень = СЭкрана.Получить(Шкала.ИмяКорня());
	Если Корень <> Неопределено Тогда
		Итог.Добавить(Переменная(КлючКорня, Корень));
		Названные.Удалить(Шкала.ИмяКорня());
	КонецЕсли;

	Логов = 0;
	Для Каждого ИмяИЗначение Из СЭкрана Цикл
		Если ИмяИЗначение.Ключ <> Шкала.ИмяКорня() Тогда
			Названные.Вставить(ИмяИЗначение.Ключ, ИмяИЗначение.Значение);
			Логов = Логов + 1;
		КонецЕсли;
	КонецЦикла;
	Если Логов > 0 Тогда
		Итог.Добавить(Переменная(КлючЛогов, Пары(Названные)));
	КонецЕсли;

КонецПроцедуры

Функция ПеременнаяКлюча(Знач Ключ)
	Итог = Новый Массив();
	Итог.Добавить(Имена.Переменная(Ключ));
	Возврат Итог;
КонецФункции

// Пары «Имя=Значение» по алфавиту имён: одна и та же правка даёт одну и ту же строку.
Функция Пары(Знач ПоИменам)

	Список = Новый СписокЗначений();
	Для Каждого ИмяИЗначение Из ПоИменам Цикл
		Список.Добавить(ИмяИЗначение.Ключ + "=" + ИмяИЗначение.Значение, ИмяИЗначение.Ключ);
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	Возврат СтрСоединить(Список.ВыгрузитьЗначения(), ",");

КонецФункции

Функция Переменная(Знач Ключ, Знач Значение)
	Возврат Имена.Переменная(Ключ) + "=" + Значение;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ШкалаЖурнала") _Шкала,
	&Пластилин(Значение = "СтартЖурнала") _Старт,
	&Пластилин(Значение = "ИменаПеременныхОкружения") _Имена)

	Шкала = _Шкала;
	Старт = _Старт;
	Имена = _Имена;

КонецПроцедуры
