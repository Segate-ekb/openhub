// След правок пульта журнала в журнале аудита: кто, откуда, каким логам и с какого значения на какое.
// Одна правка — одна запись; групповая правка перечисляет в деталях все затронутые логи.

Перем Шкала;           // ШкалаЖурнала (наблюдаемость) — имя корня
Перем Издатель;        // ИздательСобытий (события)
Перем ИменаЖурнала;    // ИмяОбъектаАудита (аудит) — вид объекта в журнале
Перем СобытиеЖурнала;  // СобытиеАудита (аудит) — форма нагрузки записи

#Область ПубличныйИнтерфейс

// Записывает правку пульта.
//
// Параметры:
//  Правка - Структура - правка пульта:
//   * Что - Строка - уровень, отправка либо возврат (к старту).
//   * Кто - Строка - логин администратора.
//   * АдресIP - Строка - адрес клиента; пусто — адреса нет.
//   * Когда - Дата - момент правки (UTC).
//   * Было - Соответствие - имя лога (корень — rootLogger) → своё значение лога до правки: уровень;
//            слово отправки (DISABLE — не отправлять, уровень — только с него, DEBUG — всё, что
//            пишет лог); DEFAULT — своего не было, лог жил как корень; у возврата — Структура
//            уровень, отправка.
//   * Стало - Строка, Соответствие - уровень у правки уровня, иначе имя лога → значение после.
//   * Пропущены - Массив из Строка - логи, которые групповая правка не тронула: пульт их не правит.
//   * Возвращено - Строка - у возврата: уровень, отправка либо всё — что было задано с экрана.
//
Процедура Записать(Знач Правка) Экспорт

	Логи = Новый Массив();
	Для Каждого ИмяИЗначение Из Правка.Было Цикл
		Логи.Добавить(ИмяИЗначение.Ключ);
	КонецЦикла;

	Детали = Новый Структура("логи, было, стало", Логи, Подробности(Правка.Было), Подробности(Правка.Стало));
	Если Правка.Пропущены.Количество() > 0 Тогда
		Детали.Вставить("пропущены", Правка.Пропущены);
	КонецЕсли;

	Объект = ИменаЖурнала.Настройка(Ключ(Правка, Логи));
	Издатель.Опубликовать(Издатель.ТипНастройкаИзменена(),
		СобытиеЖурнала.Собрать(Правка.Кто, Действие(Правка), Объект, "", Детали, Правка.АдресIP), Правка.Когда);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Значение до и после возврата — уровень и отправка; подробности записи — словами журнала.
Функция Подробности(Знач Значение)

	Если ТипЗнч(Значение) <> Тип("Соответствие") Тогда
		Возврат Значение;
	КонецЕсли;
	Итог = Новый Соответствие();
	Для Каждого ИмяИЗначение Из Значение Цикл
		Значение_ = ИмяИЗначение.Значение;
		Если ТипЗнч(Значение_) = Тип("Структура") Тогда
			Значение_ = Новый Структура("уровень, отправка", Значение_.Уровень, Значение_.Отправка);
		КонецЕсли;
		Итог.Вставить(ИмяИЗначение.Ключ, Значение_);
	КонецЦикла;
	Возврат Итог;

КонецФункции

Функция Действие(Знач Правка)
	Если Правка.Что = "уровень" Тогда
		Возврат "логи.уровень.изменён";
	ИначеЕсли Правка.Что = "отправка" Тогда
		Возврат "логи.коллектор.изменён";
	КонецЕсли;
	Возврат "логи.возвращены";
КонецФункции

// Ключ настройки, которую правка перекрыла: уровни либо отправка, корня либо логов; возврат
// того и другого — журнал целиком.
Функция Ключ(Знач Правка, Знач Логи)

	Что = ?(Правка.Что = "возврат", Правка.Возвращено, Правка.Что);
	Если Что = "всё" Тогда
		Возврат "oshub.log";
	КонецЕсли;

	ТолькоКорень = Логи.Количество() = 1 И Логи[0] = Шкала.ИмяКорня();
	Если Что = "уровень" Тогда
		Возврат ?(ТолькоКорень, "oshub.log.level", "oshub.log.levels");
	КонецЕсли;
	Возврат ?(ТолькоКорень, "oshub.log.otel.level", "oshub.log.otel.levels");

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ШкалаЖурнала") _Шкала,
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "ИмяОбъектаАудита") _ИменаЖурнала,
	&Пластилин(Значение = "СобытиеАудита") _Событие)

	Шкала = _Шкала;
	Издатель = _Издатель;
	ИменаЖурнала = _ИменаЖурнала;
	СобытиеЖурнала = _Событие;

КонецПроцедуры
