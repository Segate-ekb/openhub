// Пути оператора: какие логи пишут, пока идёт одно дело хаба — выдача пакета, поход к чужому
// хабу, приём внешней версии, публикация, вход, очередь уведомлений, хранилище. Знание устройства.

#Область ПубличныйИнтерфейс

// Пути оператора закрытым списком ключей.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Ключ - Строка - delivery, upstream, intake, publish, login, notifications, storage.
//   * Логи - Массив из Строка - логи дела в порядке хода запроса.
//
Функция Пути() Экспорт

	Итог = Новый Массив();
	Итог.Добавить(Путь("delivery", Выдача()));
	Итог.Добавить(Путь("upstream", ЧужойХаб()));
	Итог.Добавить(Путь("intake", ПриёмВнешнейВерсии()));
	Итог.Добавить(Путь("publish", Публикация()));
	Итог.Добавить(Путь("login", Вход()));
	Итог.Добавить(Путь("notifications", Уведомления()));
	Итог.Добавить(Путь("storage", Хранилище()));
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область Дела

// Скачивание .ospx и list.txt: выбор версии, докачка у апстрима с фильтром имён и учётом места,
// тело из хранилища, событие скачивания и его счёт.
Функция Выдача()
	Возврат "КонтроллерВыдачиAPI, РезолверВыдачи, ОбъединённыйНаборВерсий, ИндексВерсийИсточника,
	|СервисПрокси, СтражАпстримов, КлиентАпстрима, АллоулистИмён, ПриёмВерсии, ЗаписьЗанятогоМеста,
	|КэшАртефактов, КонфигурацияХранилища, СтражХранилища, ИздательСобытий, СлужбаСтатистикиСкачиваний";
КонецФункции

// Прокси и кэш к апстриму, плановый обход здоровья источников и уборка кэша прокси.
Функция ЧужойХаб()
	Возврат "СервисПрокси, ОбъединённыйНаборВерсий, ИндексВерсийИсточника, СтражАпстримов,
	|КлиентАпстрима, ОбходЗдоровьяИсточников, ПробникИсточника, СостояниеИсточников,
	|ЛетописьПроисшествий, СборщикКэшаПрокси, АллоулистИмён, ЖурналФоновыхЗадач";
КонецФункции

// Синхронизация зеркала: заявка, фоновый обход порциями, перенос элемента, приём версии в реестр.
Функция ПриёмВнешнейВерсии()
	Возврат "КонтроллерЗеркалAPI, ОчередьСинхронизацииЗеркал, РабочийСинхронизацииЗеркал,
	|СинхронизаторЗеркал, ИсточникАпстримаOpm, КлиентАпстрима, СтражАпстримов, СнимкиПула,
	|ПереносЭлементаСинка, РазборПакетовЗеркала, ПриёмВерсии, ЗаписьЗанятогоМеста,
	|ЛетописьПроисшествий, ПодборОборванныхПрогонов, ЖурналФоновыхЗадач";
КонецФункции

// opm push: право на публикацию токеном CI либо GitHub, запись версии и .ospx в хранилище, README
// и места, грант автору, событие публикации.
Функция Публикация()
	Возврат "КонтроллерПубликации, СервисПубликации, СервисДоверияCI, ПроверяющийПодписиJWKS,
	|ТранспортJWKSХаба, СтражИздателейCI, АудиторияТокенаCI, ПроверяющийGitHubHTTP,
	|ОпознаниеGitHubHTTP, ПриёмВерсии, КонфигурацияХранилища, СтражХранилища, ХранилищеREADME,
	|ЗаписьЗанятогоМеста, СервисПравДоступа, ИздательСобытий, РассмотрениеВходящих";
КонецФункции

// Вход паролем и через провайдера: замки, адрес клиента, правило по стране, учётка и группы.
Функция Вход()
	Возврат "СервисАутентификации, ПолитикаПарольногоВхода, ГейтПодтвержденияАдреса,
	|СервисПользователей, АдресКлиентаЗапроса, ДоверенныеПрокси, СервисВходаOIDC, КонфигурацияOIDC,
	|ГейтВходаПоСтране, ГеоправилоПровайдера, БазаСтран, ДовериеЗаголовкуСтраны, СервисАвтопривязки,
	|ПровижинингГруппOIDC, АвтовыдачаПравПоGitHub";
КонецФункции

// Событие хаба — задание подписке — фоновая доставка вебхуком и в Telegram; личные письма.
Функция Уведомления()
	Возврат "ИздательСобытий, ПодписчикВебхуков, ТелоСобытия, СлужбаДоставкиПодписок,
	|ОчередьДоставокПодписок, ДоставщикПодписок, ДоставкаВебхуком, ДоставкаTelegram,
	|СлужбаЛичныхУведомлений, ЛентаУведомлений, СлужбаПочты";
КонецФункции

// Файлы либо S3: выбор и ввод-вывод хранилища, его здоровье, кэш тел, учёт и сверка объёма.
Функция Хранилище()
	Возврат "КонфигурацияХранилища, СтражХранилища, КэшАртефактов, ЛетописьПроисшествий,
	|ЖурналФоновыхЗадач, ЗаписьЗанятогоМеста, СверкаОбъёмовПулов";
КонецФункции

Функция Путь(Знач Ключ, Знач Перечень)

	Логи = Новый Массив();
	Для Каждого Имя Из СтрРазделить(СтрЗаменить(Перечень, Символы.ПС, ""), ",", Ложь) Цикл
		Логи.Добавить(СокрЛП(Имя));
	КонецЦикла;
	Возврат Новый Структура("Ключ, Логи", Ключ, Логи);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
