// Заданное с экрана пульта журнала: уровень и отправка в коллектор по логам и корню — кем и когда.
// Живёт до перезапуска процесса. Своего замка нет: правят и читают под замком пульта.

Перем Правки;   // Соответствие: имя лога (корень — rootLogger) → ФиксированнаяСтруктура правки

#Область ПубличныйИнтерфейс

// Что задано логу с экрана.
//
// Параметры:
//  Имя - Строка - имя лога либо rootLogger.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура:
//   * Уровень - Строка, Неопределено - уровень с экрана; Неопределено — не задан.
//   * УровеньКто - Строка, Неопределено - логин того, кто задал уровень.
//   * УровеньКогда - Дата, Неопределено - когда задан уровень (UTC).
//   * Отправлять - Булево, Неопределено - отправлять ли строки в коллектор; Неопределено — отправка
//                  с экрана не задана.
//   * Порог - Строка, Неопределено - с какого уровня отправлять; Неопределено — порог с экрана
//             не задан, действует заданный настройкой.
//   * ОтправкаКто - Строка, Неопределено - логин того, кто изменил отправку.
//   * ОтправкаКогда - Дата, Неопределено - когда изменена отправка (UTC).
//
Функция Правка(Знач Имя) Экспорт
	Найденная = Правки.Получить(Имя);
	Возврат ?(Найденная = Неопределено, ПустаяПравка(), Найденная);
КонецФункции

// Задаёт логу уровень с экрана.
//
// Параметры:
//  Имя - Строка - имя лога либо rootLogger.
//  Уровень - Строка - уровень.
//  Кто - Строка - логин администратора.
//  Когда - Дата - момент правки (UTC).
//
Процедура ЗадатьУровень(Знач Имя, Знач Уровень, Знач Кто, Знач Когда) Экспорт

	Было = Правка(Имя);
	Правки.Вставить(Имя, НоваяПравка(Уровень, Кто, Когда,
		Было.Отправлять, Было.Порог, Было.ОтправкаКто, Было.ОтправкаКогда));

КонецПроцедуры

// Задаёт логу отправку в коллектор с экрана.
//
// Параметры:
//  Имя - Строка - имя лога либо rootLogger.
//  Отправлять - Булево - отправлять ли строки лога в коллектор.
//  Порог - Строка, Неопределено - с какого уровня отправлять; Неопределено — порог с экрана не задан.
//  Кто - Строка - логин администратора.
//  Когда - Дата - момент правки (UTC).
//
Процедура ЗадатьОтправку(Знач Имя, Знач Отправлять, Знач Порог, Знач Кто, Знач Когда) Экспорт

	Было = Правка(Имя);
	Правки.Вставить(Имя, НоваяПравка(Было.Уровень, Было.УровеньКто, Было.УровеньКогда,
		Отправлять, Порог, Кто, Когда));

КонецПроцедуры

// Снимает с лога всё, что задано с экрана.
//
// Параметры:
//  Имя - Строка - имя лога либо rootLogger.
//
// Возвращаемое значение:
//  Булево - Истина, если было что снимать.
//
Функция Снять(Знач Имя) Экспорт
	Было = Правки.Получить(Имя) <> Неопределено;
	Правки.Удалить(Имя);
	Возврат Было;
КонецФункции

// Логи (и корень), у которых что-то задано с экрана.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция Имена() Экспорт
	Итог = Новый Массив();
	Для Каждого ИмяИПравка Из Правки Цикл
		Итог.Добавить(ИмяИПравка.Ключ);
	КонецЦикла;
	Возврат Итог;
КонецФункции

// Копия заданного: читать её можно без замка, пока пульт правит подлинник.
//
// Возвращаемое значение:
//  ЗаданноеСЭкрана
//
Функция Снимок() Экспорт
	Возврат Новый ЗаданноеСЭкрана(Правки);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НоваяПравка(Знач Уровень, Знач УровеньКто, Знач УровеньКогда,
	Знач Отправлять, Знач Порог, Знач ОтправкаКто, Знач ОтправкаКогда)

	Возврат Новый ФиксированнаяСтруктура(
		"Уровень, УровеньКто, УровеньКогда, Отправлять, Порог, ОтправкаКто, ОтправкаКогда",
		Уровень, УровеньКто, УровеньКогда, Отправлять, Порог, ОтправкаКто, ОтправкаКогда);

КонецФункции

Функция ПустаяПравка()
	Возврат НоваяПравка(Неопределено, Неопределено, Неопределено,
		Неопределено, Неопределено, Неопределено, Неопределено);
КонецФункции

#КонецОбласти

// Параметры:
//  Исходные - Соответствие - правки, с которых начать (необязательный): так собирается снимок.
//
Процедура ПриСозданииОбъекта(Знач Исходные = Неопределено) Экспорт

	Правки = Новый Соответствие();
	Если Исходные <> Неопределено Тогда
		Для Каждого ИмяИПравка Из Исходные Цикл
			Правки.Вставить(ИмяИПравка.Ключ, ИмяИПравка.Значение);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры
