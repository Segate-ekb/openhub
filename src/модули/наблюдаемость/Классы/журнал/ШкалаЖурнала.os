// Шкала журнала хаба — одна на связку, память и пульт: ряд уровней от подробного к молчаливому
// с его концами и умолчанием, слово «как у корня», имя корневого лога и правило, когда порог
// коллектора сужает поток лога.

#Область ПубличныйИнтерфейс

// Уровни словами от подробного к молчаливому: номер уровня в logos — место в ряду.
//
// Возвращаемое значение:
//  Массив из Строка - DEBUG, INFO, WARN, ERROR, CRITICALERROR, DISABLE.
//
Функция Уровни() Экспорт
	Возврат СтрРазделить("DEBUG,INFO,WARN,ERROR,CRITICALERROR,DISABLE", ",");
КонецФункции

// Самый подробный конец ряда: порог на нём ничего не сужает.
//
// Возвращаемое значение:
//  Строка - DEBUG.
//
Функция Подробнейший() Экспорт
	Возврат Уровни()[0];
КонецФункции

// Самый молчаливый конец ряда: лог либо выход на нём не пишет ничего.
//
// Возвращаемое значение:
//  Строка - DISABLE.
//
Функция Молчание() Экспорт
	Ряд = Уровни();
	Возврат Ряд[Ряд.ВГраница()];
КонецФункции

// Уровень журнала, которому настройки уровня не назвали, — и корня тоже.
//
// Возвращаемое значение:
//  Строка - INFO.
//
Функция УровеньПоУмолчанию() Экспорт
	Возврат "INFO";
КонецФункции

// Слово настроек «как у корня»: журнал, которому оно названо, своего значения не держит.
//
// Возвращаемое значение:
//  Строка - DEFAULT.
//
Функция СловоКакУКорня() Экспорт
	Возврат "DEFAULT";
КонецФункции

// Место уровня в ряду — оно же номер уровня в logos.
//
// Параметры:
//  Уровень - Строка - уровень словом, заглавными.
//
// Возвращаемое значение:
//  Число, Неопределено - место; Неопределено — такого уровня нет.
//
Функция Место(Знач Уровень) Экспорт
	Возврат Уровни().Найти(Уровень);
КонецФункции

// Имя корневого лога в настройках, в таблице старта и у пульта.
//
// Возвращаемое значение:
//  Строка - rootLogger.
//
Функция ИмяКорня() Экспорт
	Возврат "rootLogger";
КонецФункции

// Сужает ли порог коллектора поток лога: только порог строго молчаливее уровня лога. Порог
// не молчаливее уровня подробностей в коллектор не добавляет — выход следует уровню лога.
//
// Параметры:
//  Порог - Строка, Неопределено - заданный порог коллектора; пусто либо Неопределено — порога нет.
//  Уровень - Строка - уровень лога.
//
// Возвращаемое значение:
//  Булево
//
Функция ПорогСужает(Знач Порог, Знач Уровень) Экспорт
	Если НЕ ЗначениеЗаполнено(Порог) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Место(Порог) > Место(Уровень);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
