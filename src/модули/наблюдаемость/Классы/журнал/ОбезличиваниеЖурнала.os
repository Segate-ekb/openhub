// Обезличивание значений перед записью в журнал: адрес теряет строку запроса и учётные
// данные, адрес почты — ящик, секрет остаётся фактом наличия и длиной. Здесь же дверь
// выхода: строка журнала и запись аудита теряют ящики найденных в них адресов почты.

Перем Адреса_;  // РазборАдреса (основа) — собирается при первом адресе
Перем Канон_;   // КанонIP (основа) — одна дверь к записи IP на весь хаб

#Область ПубличныйИнтерфейс

// Приводит адрес к виду, безопасному для журнала: строка запроса и учётные данные
// в authority снимаются, наличие параметров обозначается многоточием.
//
// Параметры:
//  Значение - Строка - произвольный адрес; Неопределено и пустая строка допустимы.
//
// Возвращаемое значение:
//  Строка - адрес без параметров и учётных данных либо «пусто».
//
Функция Адрес(Знач Значение) Экспорт

	Текст = СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Пусто();
	КонецЕсли;

	Текст = ДоРазделителя(Текст, "#");
	БылЗапрос = СтрНайти(Текст, "?") > 0;
	Текст = ДоРазделителя(Текст, "?");

	Возврат Адреса().ПрефиксСхемы(Текст) + БезУчётныхДанных(Адреса().БезСхемы(Текст))
		+ ?(БылЗапрос, "?…", "");

КонецФункции

// Приводит адрес клиента к виду, безопасному для журнала: сеть остаётся, а хозяин
// адреса — нет. Строку отказа по такому адресу можно соотнести с сетью, но не с человеком.
//
// Запись сначала приводится к канону хаба (`основа/КанонIP`): скобки и порт снимаются,
// отображённый IPv4 разворачивается в IPv4. Иначе «::ffff:203.0.113.7» — а именно так
// веб-сервер на двойном стеке называет клиента IPv4 — уехал бы в журнал целиком.
//
// Параметры:
//  Значение - Строка - адрес клиента в любой записи, допускаются порт и скобки;
//             Неопределено и пустая строка допустимы.
//
// Возвращаемое значение:
//  Строка - адрес без хозяина, «пусто» либо «не адрес».
//
Функция АдресКлиента(Знач Значение) Экспорт

	Текст = СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Пусто();
	КонецЕсли;

	Адрес = Канон().Адрес(Канон().БезСкобокИПорта(Текст));
	Если Адрес = Неопределено Тогда
		Возврат Неразборчивый();
	КонецЕсли;

	Возврат ?(Адрес.ЭтоIPv4(), БезХозяинаIPv4(Адрес), БезХозяинаIPv6(Адрес));

КонецФункции

// Приводит адрес почты к виду, безопасному для журнала: почтовая система остаётся,
// ящик — нет. Строку о письме можно соотнести с доменом получателя, но не с человеком.
//
// Параметры:
//  Значение - Строка - адрес почты; Неопределено и пустая строка допустимы.
//
// Возвращаемое значение:
//  Строка - адрес без ящика, «пусто» либо «не адрес».
//
Функция Почта(Знач Значение) Экспорт

	Текст = СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Пусто();
	КонецЕсли;

	// домен живёт после ПОСЛЕДНЕЙ собаки, до неё — ящик; от ящика в журнал уходит одна
	// буква, и по ней адрес узнаёт только тот, кто его и так знает
	Собака = СтрНайти(Текст, "@", НаправлениеПоиска.СКонца);
	Если Собака < 2 Тогда
		Возврат Неразборчивый();
	КонецЕсли;

	Возврат Лев(Текст, 1) + "***" + Сред(Текст, Собака);

КонецФункции

// Находит в тексте адреса почты и оставляет от каждого то же, что оставляет Почта: первую
// букву ящика и домен. Адрес узнаётся по значению, а не по месту: ящик до 64 знаков, собака
// и домен до 255 знаков из двух и более меток с зоной из букв (или IDN-зоной «xn--»).
// Не трогаются: домен, начинающийся как номер версии, — цифры (с «v» впереди или без),
// за которыми сразу точка с цифрой или дефис («@1.0.0», «@1.0-beta.rc», «@1-rc.beta»,
// «@v1.0.0.beta»); ящик после двоеточия внутри адреса со схемой («https://user:pass@host» —
// его снимает Адрес); координата «git@github.com:org/repo» — за доменом двоеточие и путь
// с косой («ivan@mail.ru:550 rejected» — адрес). Версия, похожая на домен целиком
// («@latest.stable», «@1.x.dev»),
// от домена не отличима и маскируется как адрес.
// Повторный проход ничего не меняет: обезличенный адрес узнаётся и обезличивается в себя же.
//
// Параметры:
//  Значение - Строка - произвольный текст; Неопределено допустимо.
//
// Возвращаемое значение:
//  Строка - текст без ящиков; Неопределено превращается в пустую строку.
//
Функция ПочтаВТексте(Знач Значение) Экспорт

	Текст = ?(Значение = Неопределено, "", Строка(Значение));
	Если СтрНайти(Текст, "@") = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Итог = "";
	Прочитано = 1; // всё левее уже в итоге
	Собака = СтрНайти(Текст, "@");

	Пока Собака > 0 Цикл

		Начало = НачалоЯщика(Текст, Собака, Прочитано);
		Конец = КонецДомена(Текст, Собака);

		Если ЭтоАдресПочты(Текст, Начало, Собака, Конец) Тогда
			Итог = Итог + Сред(Текст, Прочитано, Начало - Прочитано)
				+ Почта(Сред(Текст, Начало, Конец - Начало + 1));
			Прочитано = Конец + 1;
		КонецЕсли;

		Собака = СледующаяСобака(Текст, Макс(Собака, Прочитано - 1) + 1);

	КонецЦикла;

	Возврат Итог + Сред(Текст, Прочитано);

КонецФункции

// Событие журнала в том виде, в каком ему можно уйти наружу: в сообщении, в готовой строке
// и в дополнительных полях ящики адресов почты сняты (см. ПочтаВТексте). Событие без
// собаки возвращается как было — ни копии, ни разбора.
//
// Параметры:
//  СобытиеЛога - СобытиеЛога - событие библиотеки logos.
//
// Возвращаемое значение:
//  СобытиеЛога - исходное событие либо его обезличенная копия.
//
Функция Событие(Знач СобытиеЛога) Экспорт

	Сообщение = СобытиеЛога.ПолучитьСообщение();
	Готовое = СобытиеЛога.ПолучитьФорматированноеСообщение();
	Поля = СобытиеЛога.ПолучитьДополнительныеПоля();

	Если НЕ ЕстьСобака(Сообщение) И НЕ ЕстьСобака(Готовое) И НЕ ПоляССобакой(Поля) Тогда
		Возврат СобытиеЛога;
	КонецЕсли;

	Обезличенное = Новый СобытиеЛога(СобытиеЛога.ПолучитьИмяЛога(), СобытиеЛога.ПолучитьУровень(),
		ПочтаВТексте(Сообщение), СобытиеЛога.ПолучитьВремяСобытия(),
		СобытиеЛога.ПолучитьУровеньЛога(), ПоляБезПочты(Поля));
	Обезличенное.УстановитьФорматированноеСообщение(ПочтаВТексте(Готовое));

	Возврат Обезличенное;

КонецФункции

// Заменяет секрет фактом его наличия: содержимое в журнал не попадает никогда.
//
// Параметры:
//  Значение - Произвольный - токен, пароль, ключ; Неопределено допустимо.
//
// Возвращаемое значение:
//  Строка - «пусто» либо «задано, N симв.».
//
Функция Секрет(Знач Значение) Экспорт

	Текст = Строка(?(Значение = Неопределено, "", Значение));
	Если НЕ ЗначениеЗаполнено(СокрЛП(Текст)) Тогда
		Возврат Пусто();
	КонецЕсли;

	Возврат СтрШаблон("«задано, %1 симв.»", СтрДлина(Текст));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Пусто()
	Возврат "«пусто»";
КонецФункции

// Примитивы основы собираются при первом адресе, а не в конструкторе: консольный вывод
// хаба создаёт обезличивание раньше, чем ОСень разложит классы основы.
Функция Адреса()
	Если Адреса_ = Неопределено Тогда
		Адреса_ = Новый РазборАдреса();
	КонецЕсли;
	Возврат Адреса_;
КонецФункции

Функция Канон()
	Если Канон_ = Неопределено Тогда
		Канон_ = Новый КанонIP();
	КонецЕсли;
	Возврат Канон_;
КонецФункции

#Область ПочтаВТексте

// Ящик тянется от собаки влево до разделителя, но не дальше 64 знаков: длиннее ящиков
// не бывает, а без предела строка из тысяч собак разбиралась бы за квадратичное время.
// Адрес, приклеенный к длинному токену, маскируется по последним 64 знакам — ящик уходит.
// Собака разделителем не считается: в «a@b@c.org» ящиком будет «a@b», как и у Почта.
// Ведущие апострофы — кавычки вокруг адреса, а не ящик: видимой остаётся его первая буква.
Функция НачалоЯщика(Знач Текст, Знач Собака, Знач Граница)

	Предел = Макс(Граница, Собака - НаибольшийЯщик());
	Позиция = Собака;
	Пока Позиция > Предел И НЕ РазделительЯщика(Сред(Текст, Позиция - 1, 1)) Цикл
		Позиция = Позиция - 1;
	КонецЦикла;

	Пока Позиция < Собака - 1 И Сред(Текст, Позиция, 1) = "'" Цикл
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Позиция;

КонецФункции

// Домен тянется от собаки вправо по буквам, цифрам, дефисам и точкам; точка и дефис
// в хвосте — это знак препинания после адреса, а не часть домена.
Функция КонецДомена(Знач Текст, Знач Собака)

	Длина = Мин(СтрДлина(Текст), Собака + НаибольшийДомен());
	Позиция = Собака;
	Пока Позиция < Длина И ЗнакДомена(Сред(Текст, Позиция + 1, 1)) Цикл
		Позиция = Позиция + 1;
	КонецЦикла;

	Пока Позиция > Собака И СтрНайти(".-", Сред(Текст, Позиция, 1)) > 0 Цикл
		Позиция = Позиция - 1;
	КонецЦикла;

	Возврат Позиция;

КонецФункции

Функция ЭтоАдресПочты(Знач Текст, Знач Начало, Знач Собака, Знач Конец)

	Если Начало >= Собака ИЛИ Конец <= Собака Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ПарольАдресаСоСхемой(Текст, Начало) ИЛИ КоординатаРепозитория(Текст, Конец) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ЭтоДоменПочты(Сред(Текст, Собака + 1, Конец - Собака));

КонецФункции

// Двоеточие перед ящиком внутри authority («https://user:pass@host») — это пароль, а не почта:
// его снимает Адрес, и кусок пароля в «p***» превращать нельзя. «кому:ivan@mail.ru» — почта.
Функция ПарольАдресаСоСхемой(Знач Текст, Знач Начало)

	Если Начало < 2 ИЛИ Сред(Текст, Начало - 1, 1) <> ":" Тогда
		Возврат Ложь;
	КонецЕсли;

	// authority тянется от «://» до первой косой или пробела; ищем его начало влево от ящика
	Позиция = Начало - 2;
	Пока Позиция > 0 И Начало - Позиция <= НаибольшийДомен() Цикл
		Знак = Сред(Текст, Позиция, 1);
		Если Знак = "/" Тогда
			Возврат Позиция > 2 И Сред(Текст, Позиция - 2, 3) = "://";
		ИначеЕсли РазделительЯщика(Знак) И Знак <> ":" Тогда
			Возврат Ложь;
		КонецЕсли;
		Позиция = Позиция - 1;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// «git@github.com:org/repo.git», «ssh://git@host:2222/org/repo»: за хостом двоеточие и путь
// с косой — это адрес репозитория. «ivan@mail.ru:550 rejected» и «ivan@mail.ru:secret» — почта.
Функция КоординатаРепозитория(Знач Текст, Знач Конец)

	Если Сред(Текст, Конец + 1, 1) <> ":" Тогда
		Возврат Ложь;
	КонецЕсли;

	Длина = Мин(СтрДлина(Текст), Конец + 1 + НаибольшийДомен());
	Позиция = Конец + 2;
	Пока Позиция <= Длина Цикл
		Знак = Сред(Текст, Позиция, 1);
		Если РазделительЯщика(Знак) Тогда
			Возврат Знак = "/";
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Домен почты — хотя бы две непустые метки и зона из букв (или IDN-зона «xn--…»),
// и начинается он не как номер версии.
Функция ЭтоДоменПочты(Знач Домен)

	Метки = СтрРазделить(Домен, ".", Истина);
	Если Метки.Количество() < 2 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Метка Из Метки Цикл
		Если НЕ ЗначениеЗаполнено(Метка) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Если НачалоВерсии(Домен) Тогда
		Возврат Ложь;
	КонецЕсли;

	Зона = Метки[Метки.ВГраница()];
	Возврат НРег(Лев(Зона, 4)) = "xn--" ИЛИ (СтрДлина(Зона) >= 2 И ТолькоБуквы(Зона));

КонецФункции

// «1.0-beta.rc», «1-rc.beta», «v1.0.0.beta»: цифры (с «v» впереди или без), за которыми сразу
// точка с цифрой или дефис с буквой. «163.com», «67890.com», «1-800-flowers.com» — домены.
// Край: домен вида «1-abc.com» читается версией и остаётся открытым.
Функция НачалоВерсии(Знач Домен)

	Позиция = ?(НРег(Лев(Домен, 1)) = "v", 2, 1);
	Начало = Позиция;
	Пока ЭтоЦифра(Сред(Домен, Позиция, 1)) Цикл
		Позиция = Позиция + 1;
	КонецЦикла;

	Если Позиция = Начало Тогда
		Возврат Ложь;
	КонецЕсли;

	Знак = Сред(Домен, Позиция, 1);
	Следующий = Сред(Домен, Позиция + 1, 1);
	Возврат (Знак = "-" И ЭтоБуква(Следующий)) ИЛИ (Знак = "." И ЭтоЦифра(Следующий));

КонецФункции

Функция НаибольшийЯщик()
	Возврат 64;
КонецФункции

Функция НаибольшийДомен()
	Возврат 255;
КонецФункции

Функция РазделительЯщика(Знач Знак)
	Возврат КодСимвола(Знак) <= 32 ИЛИ ПустаяСтрока(Знак)
		ИЛИ СтрНайти("""`<>()[]{},;:/\|=&?#«»", Знак) > 0;
КонецФункции

Функция ЗнакДомена(Знач Знак)
	Возврат ЭтоБуква(Знак) ИЛИ ЭтоЦифра(Знак) ИЛИ Знак = "-" ИЛИ Знак = ".";
КонецФункции

Функция ЭтоБуква(Знач Знак)
	Возврат ВРег(Знак) <> НРег(Знак);
КонецФункции

Функция ЭтоЦифра(Знач Знак)
	Возврат СтрДлина(Знак) = 1 И СтрНайти("0123456789", Знак) > 0;
КонецФункции

Функция ТолькоБуквы(Знач Текст)
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если НЕ ЭтоБуква(Сред(Текст, Позиция, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// СтрНайти падает, когда начало поиска стоит за концом строки.
Функция СледующаяСобака(Знач Текст, Знач Откуда)
	Возврат ?(Откуда > СтрДлина(Текст), 0, СтрНайти(Текст, "@", , Откуда));
КонецФункции

#КонецОбласти

#Область Событие

Функция ЕстьСобака(Знач Значение)
	Возврат ТипЗнч(Значение) = Тип("Строка") И СтрНайти(Значение, "@") > 0;
КонецФункции

Функция ПоляССобакой(Знач Поля)

	Если ТипЗнч(Поля) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Поле Из Поля Цикл
		Если ЕстьСобака(Поле.Значение) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Поля лога общие на все его события: обезличивается копия, а не они сами.
Функция ПоляБезПочты(Знач Поля)

	Если НЕ ПоляССобакой(Поля) Тогда
		Возврат Поля;
	КонецЕсли;

	Копия = Новый Соответствие();
	Для Каждого Поле Из Поля Цикл
		Копия.Вставить(Поле.Ключ,
			?(ЕстьСобака(Поле.Значение), ПочтаВТексте(Поле.Значение), Поле.Значение));
	КонецЦикла;
	Возврат Копия;

КонецФункции

#КонецОбласти

Функция ДоРазделителя(Знач Текст, Знач Разделитель)
	Возврат Адреса().ДоСимвола(Текст, Разделитель);
КонецФункции

// Последний октет — это хозяин адреса, сеть перед ним.
Функция БезХозяинаIPv4(Знач Адрес)

	Части = СтрРазделить(Адрес.ВСтроку(), ".", Ложь);
	Части[3] = "x";
	Возврат СтрСоединить(Части, ".");

КонецФункции

// У IPv6 хозяину принадлежит хвост адреса: сетью провайдер раздаёт первые группы,
// и их довольно, чтобы узнать сеть, но мало, чтобы узнать узел. Группы считаются
// по РАЗВЁРНУТОЙ записи: в сжатой «2a00:1450::8a2e» третья группа — это хвост чужого
// узла, а не третья группа адреса.
Функция БезХозяинаIPv6(Знач Адрес)

	Группы = СтрРазделить(Адрес.ВРазвернутуюСтроку(), ":", Ложь);

	Начало = Новый Массив();
	Для Индекс = 0 По ГруппIPv6() - 1 Цикл
		Начало.Добавить(БезВедущихНулей(Группы[Индекс]));
	КонецЦикла;

	Возврат СтрСоединить(Начало, ":") + ":…";

КонецФункции

// Развёрнутая запись дополняет группы нулями слева; человеку привычнее «2a02:6b8:0»,
// а не «2a02:06b8:0000».
Функция БезВедущихНулей(Знач Группа)

	Значащие = Группа;
	Пока СтрДлина(Значащие) > 1 И Лев(Значащие, 1) = "0" Цикл
		Значащие = Сред(Значащие, 2);
	КонецЦикла;
	Возврат Значащие;

КонецФункции

// Первые три группы — сеть провайдера или организации (обычно /48), хозяин живёт
// в остальных пяти: по ним адрес соотносится с сетью, но не с узлом.
Функция ГруппIPv6()
	Возврат 3;
КонецФункции

Функция Неразборчивый()
	Возврат "«не адрес»";
КонецФункции

// Учётные данные — всё до ПОСЛЕДНЕГО «@»: пароль законно содержит «/», и недосрез опаснее лишнего.
Функция БезУчётныхДанных(Знач Текст)

	Собака = СтрНайти(Текст, "@", НаправлениеПоиска.СКонца);
	Возврат ?(Собака = 0, Текст, "…@" + Сред(Текст, Собака + 1));

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	// обезличивание создают «Новым» классы журнала — внедрений у него нет, и примитивы
	// основы оно собирает так же, при первом адресе
	Адреса_ = Неопределено;
	Канон_ = Неопределено;
КонецПроцедуры
