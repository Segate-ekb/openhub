// Кольцо строк журнала фиксированной ёмкости: новая запись затирает самую старую.
// Своего замка у кольца нет — его держит владелец, ПамятьЖурнала.

Перем Записи;     // Массив фиксированной длины — само кольцо
Перем Ёмкость_;   // Число — сколько записей кольцо держит
Перем Положено;   // Число — сколько записей легло за жизнь кольца

#Область ПубличныйИнтерфейс

// Кладёт запись; при полном кольце затирается самая старая.
//
// Параметры:
//  Запись - Произвольный - запись журнала.
//
Процедура Положить(Знач Запись) Экспорт

	Если Ёмкость_ = 0 Тогда
		Возврат;
	КонецЕсли;

	Записи[Положено % Ёмкость_] = Запись;
	Положено = Положено + 1;

КонецПроцедуры

// Записи, которые кольцо держит сейчас, от новых к старым. Копия: её можно разбирать без замка.
//
// Возвращаемое значение:
//  Массив - записи.
//
Функция Снимок() Экспорт

	Результат = Новый Массив();
	Сколько = Мин(Положено, Ёмкость_);
	Для Сдвиг = 1 По Сколько Цикл
		Результат.Добавить(Записи[(Положено - Сдвиг) % Ёмкость_]);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Сколько записей кольцо держит самое большее.
//
// Возвращаемое значение:
//  Число - ёмкость; 0 — кольцо ничего не держит.
//
Функция Ёмкость() Экспорт
	Возврат Ёмкость_;
КонецФункции

#КонецОбласти

// Параметры:
//  _Ёмкость - Число - сколько записей держать; 0 — кольцо ничего не держит.
//
Процедура ПриСозданииОбъекта(Знач _Ёмкость) Экспорт

	Ёмкость_ = _Ёмкость;
	Записи = Новый Массив(Макс(1, Ёмкость_));
	Положено = 0;

КонецПроцедуры
