// Память журнала процесса для экрана: кольцо всех строк, кольцо важных (WARN и выше — отладка
// их не вытесняет) и темп каждого лога за минуту. Пишут потоки запросов и фона — под одним замком.

Перем Всё;           // КольцоЖурнала — любые строки
Перем Важное;        // КольцоЖурнала — строки WARN и выше
Перем Темп;          // Соответствие: имя лога → Структура Счёт, Секунда (массивы по секунде минуты)
Перем Всего;         // Число — строк за жизнь процесса; номер следующей
Перем Замок;         // БлокировкаРесурса
Перем Поля;          // ФиксированнаяСтруктура: имя поля записи → место в массиве записи
Перем ПорогВажного;  // Число — уровень logos, с которого строка ложится и в кольцо важного
Перем Шкала;         // ШкалаЖурнала (наблюдаемость) — уровни словами и их номера в logos

#Область ПубличныйИнтерфейс

// Запоминает строку журнала.
//
// Параметры:
//  Время - Число - универсальное время события, миллисекунды от 0001-01-01.
//  Уровень - Число - уровень строки logos: 0 — DEBUG … 4 — CRITICALERROR.
//  ИмяЛога - Строка - имя лога.
//  Текст - Строка - сообщение, уже прошедшее дверь обезличивания.
//  Трасса - Строка - идентификатор трассы; пусто — строка вне трассы.
//
Процедура Записать(Знач Время, Знач Уровень, Знач ИмяЛога, Знач Текст, Знач Трасса) Экспорт

	Запись = Новый Массив(Поля.Количество());
	Запись[Поля.Время] = Время;
	Запись[Поля.Уровень] = Уровень;
	Запись[Поля.Лог] = ИмяЛога;
	Запись[Поля.Текст] = Текст;
	Запись[Поля.Трасса] = Трасса;
	Секунда = Цел(Время / 1000);

	Замок.Заблокировать();
	Попытка
		Всего = Всего + 1;
		Запись[Поля.Номер] = Всего;
		Всё.Положить(Запись);
		Если Уровень >= ПорогВажного Тогда
			Важное.Положить(Запись);
		КонецЕсли;
		Отсчитать(ИмяЛога, Секунда);
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

КонецПроцедуры

// Последние строки, прошедшие отбор, свежие первыми.
//
// Параметры:
//  Отбор - Структура - любое поле можно не задавать (необязательный):
//   * Логи - Массив из Строка - только строки этих логов.
//   * УровеньНеНиже - Строка - DEBUG, INFO, WARN, ERROR, CRITICALERROR.
//   * Содержит - Строка - подстрока текста без учёта регистра.
//   * После - Число - только записи с номером больше этого: дочитать новое.
//   * Количество - Число - не больше стольких (по умолчанию 200).
//   * ТолькоВажное - Булево - читать кольцо предупреждений и ошибок.
//
// Возвращаемое значение:
//  Массив из Структура - Номер (Число), Время (Дата UTC), Миллисекунды (Число), Уровень (Строка),
//                        Лог, Текст, Трасса.
//
Функция Хвост(Знач Отбор = Неопределено) Экспорт

	Условия = Условия(Отбор);

	Замок.Заблокировать();
	Попытка
		Снимок = ?(Условия.ТолькоВажное, Важное.Снимок(), Всё.Снимок());
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Найдено = Новый Массив();
	Для Каждого Запись Из Снимок Цикл
		Если Найдено.Количество() >= Условия.Количество ИЛИ Запись[Поля.Номер] <= Условия.После Тогда
			Прервать;
		КонецЕсли;
		Если Проходит(Запись, Условия) Тогда
			Найдено.Добавить(ЗаписьХвоста(Запись));
		КонецЕсли;
	КонецЦикла;
	Возврат Найдено;

КонецФункции

// Сколько строк записано и сколько держат кольца.
//
// Возвращаемое значение:
//  Структура - Всего (строк за жизнь процесса), Ёмкость (кольцо «всё»),
//              ЁмкостьВажного (кольцо предупреждений и ошибок).
//
Функция Счёт() Экспорт

	Замок.Заблокировать();
	Итог = Новый Структура("Всего, Ёмкость, ЁмкостьВажного", Всего, Всё.Ёмкость(), Важное.Ёмкость());
	Замок.Разблокировать();
	Возврат Итог;

КонецФункции

// Сколько строк каждый лог написал за последние шестьдесят секунд.
//
// Возвращаемое значение:
//  Соответствие - имя лога → Число; лога, не писавшего ни разу, в нём нет.
//
Функция СтрокЗаМинуту() Экспорт

	Сейчас = Цел(ТекущаяУниверсальнаяДатаВМиллисекундах() / 1000);
	Итог = Новый Соответствие();

	Замок.Заблокировать();
	Попытка
		Для Каждого Отсчёт Из Темп Цикл
			Итог.Вставить(Отсчёт.Ключ, ЗаМинуту(Отсчёт.Значение, Сейчас));
		КонецЦикла;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область Темп

// Шестьдесят ячеек по секунде минуты: ячейка чужой секунды обнуляется при первой записи в неё.
Процедура Отсчитать(Знач ИмяЛога, Знач Секунда)

	Ячейки = Темп.Получить(ИмяЛога);
	Если Ячейки = Неопределено Тогда
		Ячейки = Новый Структура("Счёт, Секунда", Новый Массив(60), Новый Массив(60));
		Темп.Вставить(ИмяЛога, Ячейки);
	КонецЕсли;

	Ячейка = Секунда % 60;
	Если Ячейки.Секунда[Ячейка] <> Секунда Тогда
		Ячейки.Секунда[Ячейка] = Секунда;
		Ячейки.Счёт[Ячейка] = 0;
	КонецЕсли;
	Ячейки.Счёт[Ячейка] = Ячейки.Счёт[Ячейка] + 1;

КонецПроцедуры

Функция ЗаМинуту(Знач Ячейки, Знач Сейчас)

	Сумма = 0;
	Для Ячейка = 0 По 59 Цикл
		Секунда = Ячейки.Секунда[Ячейка];
		Если Секунда <> Неопределено И Секунда > Сейчас - 60 И Секунда <= Сейчас Тогда
			Сумма = Сумма + Ячейки.Счёт[Ячейка];
		КонецЕсли;
	КонецЦикла;
	Возврат Сумма;

КонецФункции

#КонецОбласти

#Область Отбор

Функция Условия(Знач Отбор)

	Условия = Новый Структура("Логи, УровеньНеНиже, Содержит, После, Количество, ТолькоВажное",
		Неопределено, "", "", 0, 200, Ложь);
	Если Отбор <> Неопределено Тогда
		Для Каждого Поле Из Отбор Цикл
			Если Условия.Свойство(Поле.Ключ) И Поле.Значение <> Неопределено Тогда
				Условия.Вставить(Поле.Ключ, Поле.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Условия.Вставить("Уровень", УровеньЧислом(Условия.УровеньНеНиже));
	Условия.Содержит = НРег(Условия.Содержит);
	Возврат Условия;

КонецФункции

Функция Проходит(Знач Запись, Знач Условия)

	Если Условия.Уровень <> Неопределено И Запись[Поля.Уровень] < Условия.Уровень Тогда
		Возврат Ложь;
	ИначеЕсли Условия.Логи <> Неопределено И Условия.Логи.Найти(Запись[Поля.Лог]) = Неопределено Тогда
		Возврат Ложь;
	ИначеЕсли ЗначениеЗаполнено(Условия.Содержит) И СтрНайти(НРег(Запись[Поля.Текст]), Условия.Содержит) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

Функция ЗаписьХвоста(Знач Запись)

	Время = Запись[Поля.Время];
	Возврат Новый Структура("Номер, Время, Миллисекунды, Уровень, Лог, Текст, Трасса",
		Запись[Поля.Номер], Дата(1, 1, 1) + Цел(Время / 1000), Время % 1000, ИмяУровня(Запись[Поля.Уровень]),
		Запись[Поля.Лог], Запись[Поля.Текст], Запись[Поля.Трасса]);

КонецФункции

Функция ИмяУровня(Знач Уровень)
	Имена = Шкала.Уровни();
	Возврат ?(Уровень >= 0 И Уровень <= Имена.ВГраница(), Имена[Уровень], Строка(Уровень));
КонецФункции

Функция УровеньЧислом(Знач Имя)
	Возврат Шкала.Место(ВРег(СокрЛП(Строка(Имя))));
КонецФункции

#КонецОбласти

// Четверть ёмкости всего: ручка у оператора одна, и ноль выключает оба кольца.
Функция ЁмкостьВажного(Знач Ёмкость)
	Возврат ?(Ёмкость = 0, 0, Макс(1, Окр(Ёмкость / 4)));
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Деталька(Значение = "oshub.log.tail.size", ЗначениеПоУмолчанию = 2000) _Ёмкость,
	&Пластилин(Значение = "ШкалаЖурнала") _Шкала = Неопределено)

	Шкала = ?(_Шкала = Неопределено, Новый ШкалаЖурнала(), _Шкала);
	// ёмкость приходит числом: её разбирает загрузка настроек, отвергнутое сюда не доходит
	Всё = Новый КольцоЖурнала(_Ёмкость);
	Важное = Новый КольцоЖурнала(ЁмкостьВажного(_Ёмкость));
	Темп = Новый Соответствие();
	Всего = 0;
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
	// запись — массив, а не структура: строка журнала пишется на каждый вызов лога
	Поля = Новый ФиксированнаяСтруктура("Номер, Время, Уровень, Лог, Текст, Трасса", 0, 1, 2, 3, 4, 5);
	ПорогВажного = УровеньЧислом("WARN");

КонецПроцедуры
