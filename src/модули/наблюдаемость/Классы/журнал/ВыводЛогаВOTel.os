// Способ вывода logos, отдающий строки журнала мосту autumn-opentelemetry. Пока
// телеметрия выключена, мост не достают вовсе — SDK не поднимается и не стоит ничего.

Перем ТабакеркаМоста;   // Табакерка ОтелАппендерLogos — библиотечный мост logos → OTel
Перем ВыводВключён;         // otel.enabled, прочитанный по правилу OpenTelemetry
Перем Мост;             // достаётся лениво, на первом событии
Перем ПодъёмИдёт;       // события, пришедшие во время подъёма моста, отбрасываются
Перем Отдано;           // сколько событий ушло в OTel
Перем Уровни;           // УровниЖурнала (наблюдаемость) — отбор по уровню своего лога

#Область ПубличныйИнтерфейс

// Отдаёт событие журнала мосту OTel. Контракт способа вывода logos.
//
// Параметры:
//  СобытиеЛога - СобытиеЛога - событие библиотеки logos.
//
Процедура ВывестиСобытие(Знач СобытиеЛога) Экспорт

	Если НЕ ВыводВключён ИЛИ ПодъёмИдёт ИЛИ НЕ Уровни.СтрокаПроходит(СобытиеЛога) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ДействующийМост().ВывестиСобытие(СобытиеЛога);
		Отдано = Отдано + 1;
	Исключение
		// Отказ моста не должен ни ронять операцию, ни повторяться на каждой строке:
		// пожаловаться некуда — жалоба пришла бы сюда же.
		ВыводВключён = Ложь;
	КонецПопытки;

КонецПроцедуры

// Закрывает способ вывода. Контракт logos; ресурсов, требующих закрытия, нет.
//
Процедура Закрыть() Экспорт
КонецПроцедуры

// Принимает свойство из настроек logos. Контракт logos; настраивается способ вывода
// деталькой otel.enabled, а не свойствами.
//
// Параметры:
//  ИмяСвойства - Строка - имя свойства из logos.appender.
//  Значение - Произвольный - значение свойства.
//
Процедура УстановитьСвойство(Знач ИмяСвойства, Знач Значение) Экспорт
КонецПроцедуры

// Отдаются ли строки журнала в OTel.
//
// Возвращаемое значение:
//  Булево - Истина, если мост включён и не сорвался.
//
Функция Включён() Экспорт
	Возврат ВыводВключён;
КонецФункции

// Сколько событий журнала ушло мосту.
//
// Возвращаемое значение:
//  Число - счётчик отданных событий.
//
Функция ЧислоОтданных() Экспорт
	Возврат Отдано;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пока мост достают, ОСень собирает желудь SDK — и любой желудь этой цепочки, попросив
// себе лог, приводит нас сюда снова, когда мост ещё не получен. Флаг разрывает повторный
// заход: такие строки уходят только в консоль. Своих строк SDK сюда не приносит — он
// пишет в логи, взятые у logos напрямую, а до способа вывода хаба доходят только логи
// желудей.
Функция ДействующийМост()

	Если Мост = Неопределено Тогда
		ПодъёмИдёт = Истина;
		Попытка
			Мост = ТабакеркаМоста.Достать();
		Исключение
			ПодъёмИдёт = Ложь;
			ВызватьИсключение;
		КонецПопытки;
		ПодъёмИдёт = Ложь;
	КонецЕсли;

	Возврат Мост;

КонецФункции

#КонецОбласти

&Прозвище("ВыводЛогаВOTel")
&Желудь
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ОтелАппендерLogos") _ТабакеркаМоста = Неопределено,
	&Деталька(Значение = "otel.enabled", ЗначениеПоУмолчанию = Ложь) _Включено = Ложь,
	&Пластилин(Значение = "ПриведениеФлагов") _Флаги = Неопределено)

	ТабакеркаМоста = _ТабакеркаМоста;
	Мост = Неопределено;
	ПодъёмИдёт = Ложь;
	Отдано = 0;
	Уровни = Новый УровниЖурнала();

	// Без табакерки объект создан не ОСенью, а самой logos — по имени типа из настроек,
	// пока контейнера ещё нет. Такой экземпляр молчит: журнал ему отдают только до того,
	// как ФабрикаЛогов заменит его настоящим желудём.
	Если ТабакеркаМоста = Неопределено Тогда
		ВыводВключён = Ложь;
		Возврат;
	КонецЕсли;

	Приведение = ?(_Флаги = Неопределено, Новый ПриведениеФлагов(), _Флаги);
	ВыводВключён = Приведение.ФлагТолькоTrue(_Включено);

КонецПроцедуры
