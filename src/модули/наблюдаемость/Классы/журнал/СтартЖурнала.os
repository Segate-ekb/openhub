// Как логи стартовали по настройкам: строка таблицы старта, которую собрала загрузка настроек,
// для самого лога, его ближайшего предка по имени либо корня — так настройку ищет сам logos.

Перем Шкала;     // ШкалаЖурнала (наблюдаемость) — имя корня и уровень по умолчанию
Перем Таблица;   // Соответствие: имя лога (корень — rootLogger) → строка старта (Соответствие)

#Область ПубличныйИнтерфейс

// Как стартовал корень.
//
// Возвращаемое значение:
//  Структура:
//   * Уровень - Строка - уровень корня.
//   * Свой - Булево - уровень корню назвала настройка.
//   * Откуда - Строка - окружение, файл, программно либо умолчание.
//   * ИмяНастройки - Строка - переменная либо ключ, которым задан уровень; пусто при умолчании.
//   * Порог - Строка - заданный порог коллектора, в том числе не сужающий; "" — порога нет,
//             DISABLE — в коллектор не идёт.
//   * ПорогНазван - Булево - порог назвала настройка.
//   * Выходы - Массив из Строка - логические имена выходов: console, memory, otel.
//
Функция Корень() Экспорт
	Корень_ = СтрокаСтарта(Шкала.ИмяКорня());
	Возврат Описание(Корень_, Поле(Корень_, "Свой", Ложь) = Истина, Поле(Корень_, "ПорогСвой", Ложь) = Истина);
КонецФункции

// Как стартовал лог: по своей строке, иначе по строке ближайшего предка по имени, иначе как корень.
//
// Параметры:
//  Имя - Строка - имя лога.
//
// Возвращаемое значение:
//  Структура - поля как у Корень(), где:
//   * Свой - Булево - уровень назвала настройка этому логу либо его предку по имени; Ложь —
//            лог живёт на уровне корня.
//   * ПорогНазван - Булево - порог коллектора назвала настройка этому логу либо его предку по
//                   имени; Ложь — у лога порог общий либо его нет.
//
Функция Лога(Знач Имя) Экспорт

	СвойУровень = Ложь;
	СвойПорог = Ложь;
	Найденная = Неопределено;
	Для Каждого ИмяВЦепочке Из ЦепочкаИмён(Имя) Цикл
		Запись = Таблица.Получить(ИмяВЦепочке);
		Если Запись = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Найденная = Неопределено Тогда
			Найденная = Запись;
		КонецЕсли;
		СвойУровень = СвойУровень ИЛИ Поле(Запись, "Свой", Ложь) = Истина;
		СвойПорог = СвойПорог ИЛИ Поле(Запись, "ПорогСвой", Ложь) = Истина;
	КонецЦикла;

	Если Найденная = Неопределено Тогда
		Возврат Описание(СтрокаСтарта(Шкала.ИмяКорня()), Ложь, Ложь);
	КонецЕсли;
	Возврат Описание(Найденная, СвойУровень, СвойПорог);

КонецФункции

// Как стартовал лог, созданный раньше, чем хаб прочитал настройки: настройки до него не дошли,
// он живёт умолчанием logos.
//
// Параметры:
//  Уровень - Строка - уровень, с которым лог писал до первой правки.
//
// Возвращаемое значение:
//  Структура - поля как у Лога(): свой уровень, откуда — умолчание, порога и выходов хаба нет.
//
Функция ДоНастроек(Знач Уровень) Экспорт
	Возврат Описание(Новый Соответствие(), Истина, Ложь, Уровень);
КонецФункции

// Логи, чей уровень при старте назвала одна из этих настроек; корень — под именем rootLogger.
//
// Параметры:
//  ИменаНастройки - Массив из Строка - имена переменной и ключа настройки.
//
// Возвращаемое значение:
//  Соответствие - имя лога → уровень.
//
Функция УровниНазванные(Знач ИменаНастройки) Экспорт

	Итог = Новый Соответствие();
	Для Каждого ИмяИСтрока Из Таблица Цикл
		Запись = ИмяИСтрока.Значение;
		Если Поле(Запись, "Свой", Ложь) = Истина
			И ИменаНастройки.Найти(Поле(Запись, "ИмяНастройки", "")) <> Неопределено Тогда
			Итог.Вставить(ИмяИСтрока.Ключ, Поле(Запись, "Уровень", ""));
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Логи, чей порог коллектора при старте назвала именно им одна из этих настроек, — не предку
// и не всем; корень — под именем rootLogger.
//
// Параметры:
//  ИменаНастройки - Массив из Строка - имена переменной и ключа настройки.
//
// Возвращаемое значение:
//  Соответствие - имя лога → порог (уровень либо DISABLE).
//
Функция ПорогиНазванные(Знач ИменаНастройки) Экспорт

	Итог = Новый Соответствие();
	Для Каждого ИмяИСтрока Из Таблица Цикл
		Запись = ИмяИСтрока.Значение;
		Порог = Поле(Запись, "Порог", "");
		Если Поле(Запись, "ПорогСвой", Ложь) = Истина И ЗначениеЗаполнено(Порог)
			И ИменаНастройки.Найти(Поле(Запись, "ПорогИмяНастройки", "")) <> Неопределено Тогда
			Итог.Вставить(ИмяИСтрока.Ключ, Порог);
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сам лог и его предки от ближнего к дальнему: «a.b.c», «a.b», «a».
Функция ЦепочкаИмён(Знач Имя)

	Цепочка = Новый Массив();
	Части = СтрРазделить(Имя, ".");
	Пока Части.Количество() > 0 Цикл
		Цепочка.Добавить(СтрСоединить(Части, "."));
		Части.Удалить(Части.ВГраница());
	КонецЦикла;
	Возврат Цепочка;

КонецФункции

// Строка без полей — умолчание: уровень шкалы по умолчанию, откуда — умолчание, ни порога, ни
// выходов хаба.
Функция Описание(Знач Запись, Знач Свой, Знач ПорогНазван, Знач УровеньБезЗаписи = Неопределено)

	Итог = Новый Структура();
	Итог.Вставить("Уровень", Поле(Запись, "Уровень",
		?(УровеньБезЗаписи = Неопределено, Шкала.УровеньПоУмолчанию(), УровеньБезЗаписи)));
	Итог.Вставить("Свой", Свой);
	Итог.Вставить("Откуда", Поле(Запись, "Откуда", "умолчание"));
	Итог.Вставить("ИмяНастройки", Поле(Запись, "ИмяНастройки", ""));
	Итог.Вставить("Порог", Поле(Запись, "Порог", ""));
	Итог.Вставить("ПорогНазван", ПорогНазван);
	Итог.Вставить("Выходы", Поле(Запись, "Выходы", Новый Массив()));
	Возврат Итог;

КонецФункции

// Строка корня есть у каждого старта сервера; без таблицы — корень по умолчанию logos.
Функция СтрокаСтарта(Знач Имя)
	Найденная = Таблица.Получить(Имя);
	Возврат ?(Найденная = Неопределено, Новый Соответствие(), Найденная);
КонецФункции

Функция Поле(Знач Запись, Знач Имя, Знач ПоУмолчанию)
	Значение = Запись.Получить(Имя);
	Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Деталька(Значение = "oshub.log.startup", ЗначениеПоУмолчанию = Неопределено) _Таблица,
	&Пластилин(Значение = "ШкалаЖурнала") _Шкала)

	Шкала = _Шкала;
	Таблица = Новый Соответствие();
	Если ТипЗнч(_Таблица) = Тип("Соответствие") ИЛИ ТипЗнч(_Таблица) = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого ИмяИСтрока Из _Таблица Цикл
			Таблица.Вставить(ИмяИСтрока.Ключ, ИмяИСтрока.Значение);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры
