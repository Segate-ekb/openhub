// Пульт журнала: логи процесса такими, какими они стартовали и какими их сделали с экрана, —
// и правка уровня и отправки в коллектор на лету, до перезапуска, со следом в журнале аудита.

Перем Шкала;            // ШкалаЖурнала (наблюдаемость) — ряд уровней, имя корня, правило порога
Перем Процесс;          // ЛогиПроцесса (наблюдаемость) — логи logos и их выходы
Перем Старт;            // СтартЖурнала (наблюдаемость) — как логи стартовали по настройкам
Перем Группы;           // ГруппыЛогов (наблюдаемость) — место лога в дереве
Перем ПутиОператора;    // ПутиЖурнала (наблюдаемость) — логи дел оператора
Перем Память;           // ПамятьЖурнала (наблюдаемость) — строки журнала для просмотра
Перем Закрепление;      // ЗакреплениеЖурнала (наблюдаемость) — заданное с экрана строками окружения
Перем Летопись;         // ЛетописьПультаЖурнала (наблюдаемость) — след правки в журнале аудита
Перем Заданное;         // ЗаданноеСЭкрана (наблюдаемость) — правки с экрана, только под замком
Перем Замок;            // БлокировкаРесурса — правки идут по одной, чтение видит правку целиком
Перем УходитВКоллектор; // Булево — телеметрия включена и экспортёр журнала не выключен
Перем Лог;

#Область Сведения

// Уровни от подробного к молчаливому.
//
// Возвращаемое значение:
//  Массив из Строка - DEBUG, INFO, WARN, ERROR, CRITICALERROR, DISABLE.
//
Функция Уровни() Экспорт
	Возврат Шкала.Уровни();
КонецФункции

// Логи процесса. Ничего не меняет.
//
// Возвращаемое значение:
//  Массив из Структура - узел на лог:
//   * Имя, Группа - Строка - имя лога и путь его ветки в дереве через «/».
//   * УровеньПриСтарте, СвойПриСтарте, ОткудаПриСтарте, ИмяНастройки - как лог стартовал:
//     уровень, назван ли он этому логу либо его предку по имени (Ложь — лог живёт на корне),
//     окружение, файл либо умолчание и имя переменной либо ключа.
//   * УровеньСЭкрана, ЗаданоКем, ЗаданоКогда - уровень, заданный с экрана, кто и когда (UTC);
//     Неопределено — не задан.
//   * УровеньДействующий - Строка - с каким уровнем лог пишет сейчас.
//   * ВКонсоль, ВПамять, ВOTel - Булево - куда уходят строки лога.
//   * ПорогOTel - Строка, Неопределено - заданный логу порог коллектора (настройкой либо с экрана),
//     в том числе тот, что сейчас не сужает; Неопределено — порога нет, коллектор следует уровню.
//   * OTelСЭкрана, OTelЗаданКем, OTelЗаданКогда - отправка изменена с экрана, кем и когда.
//   * МожноВOTel - Булево - Ложь: выхода в коллектор у лога нет, отправка не правится.
//   * ТолькоЧтение - Булево - пульт лог не правит.
//   * ПочемуТолькоЧтение - Строка - audit: на логе выход кода — журнал аудита; before_wiring: лог
//     создан раньше, чем хаб прочитал настройки, и пишет мимо двери обезличивания; "" — правится.
//   * ПрочиеВыходы - Массив из Строка - имена типов чужих выходов.
//   * СтрокЗаМинуту - Число - строк в памяти от лога за последнюю минуту.
//
Функция Логи() Экспорт

	Правки = СнимокЗаданного();
	Темп = Память.СтрокЗаМинуту();

	Итог = Новый Массив();
	Для Каждого Имя Из Процесс.Имена() Цикл
		Итог.Добавить(Узел(Имя, Правки, Темп));
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Корневой лог rootLogger: его уровень получают логи без своего. Ничего не меняет.
//
// Возвращаемое значение:
//  Структура - узел с полями как у Логи(); Группа пуста.
//
Функция Корень() Экспорт
	Возврат УзелКорня(СнимокЗаданного());
КонецФункции

// Пути оператора.
//
// Возвращаемое значение:
//  Массив из Структура - Ключ (Строка), Логи (Массив из Строка).
//
Функция Пути() Экспорт
	Возврат ПутиОператора.Пути();
КонецФункции

// Уходит ли журнал в коллектор: телеметрия включена и экспортёр журнала не выключен.
//
// Возвращаемое значение:
//  Булево
//
Функция ЖурналУходитВКоллектор() Экспорт
	Возврат УходитВКоллектор;
КонецФункции

// Готовые строки переменных окружения, с которыми хаб стартует в том состоянии, какое задано
// с экрана сейчас.
//
// Возвращаемое значение:
//  Массив из Строка - пусто, если с экрана ничего не задано.
//
Функция СтрокиДляЗакрепления() Экспорт
	Возврат Закрепление.Строки(Закрепляемое(СнимокЗаданного()));
КонецФункции

#КонецОбласти

#Область Строки

// Последние строки журнала из памяти, свежие первыми.
//
// Параметры:
//  Отбор - Структура - любое поле можно не задавать (необязательный):
//   * Логи - Массив из Строка - только строки этих логов; регистр имени не важен.
//   * Группа - Строка - только логи ветки дерева: начало пути группы.
//   * УровеньНеНиже - Строка - уровень строк; слово не из перечня уровней строк отбор не сужает.
//   * Содержит - Строка - подстрока текста.
//   * После - Число - только записи с номером больше этого; не число — не сужает.
//   * Количество - Число - не больше стольких (по умолчанию и при не числе — 200).
//   * ТолькоВажное - Булево - читать кольцо предупреждений и ошибок.
//
// Возвращаемое значение:
//  Массив из Структура - Номер, Время (Дата UTC), Миллисекунды, Уровень, Лог, Текст, Трасса.
//
Функция Хвост(Знач Отбор = Неопределено) Экспорт

	Условия = Новый Структура();
	Если Отбор = Неопределено Тогда
		Возврат Память.Хвост(Условия);
	КонецЕсли;

	Имена = Неопределено;
	Если Отбор.Свойство("Логи") И ЗначениеЗаполнено(Отбор.Логи) Тогда
		Имена = НастоящиеИмена(Отбор.Логи);
	КонецЕсли;
	Если Отбор.Свойство("Группа") И ЗначениеЗаполнено(Отбор.Группа) Тогда
		Имена = ОбщиеИмена(Имена, ЛогиВетки(Отбор.Группа));
	КонецЕсли;
	Если Имена <> Неопределено Тогда
		Условия.Вставить("Логи", Имена);
	КонецЕсли;

	Уровень = ?(Отбор.Свойство("УровеньНеНиже"), ВРег(СокрЛП(Строка(Отбор.УровеньНеНиже))), "");
	Если УровниСтрок().Найти(Уровень) <> Неопределено Тогда
		Условия.Вставить("УровеньНеНиже", Уровень);
	КонецЕсли;
	Если Отбор.Свойство("Содержит") И ЗначениеЗаполнено(Отбор.Содержит) Тогда
		Условия.Вставить("Содержит", Строка(Отбор.Содержит));
	КонецЕсли;
	Если Отбор.Свойство("После") И ТипЗнч(Отбор.После) = Тип("Число") Тогда
		Условия.Вставить("После", Отбор.После);
	КонецЕсли;
	Если Отбор.Свойство("Количество") И ТипЗнч(Отбор.Количество) = Тип("Число") Тогда
		Условия.Вставить("Количество", Отбор.Количество);
	КонецЕсли;
	Если Отбор.Свойство("ТолькоВажное") Тогда
		Условия.Вставить("ТолькоВажное", Отбор.ТолькоВажное = Истина);
	КонецЕсли;

	Возврат Память.Хвост(Условия);

КонецФункции

// Сколько строк помнит память.
//
// Возвращаемое значение:
//  Структура - Всего (записано за жизнь процесса), Ёмкость, ЁмкостьВажного.
//
Функция СчётПамяти() Экспорт
	Возврат Память.Счёт();
КонецФункции

#КонецОбласти

#Область Правки

// Задаёт уровень каждому названному логу; корень называется rootLogger. Лог, который пульт
// не правит, в списке из нескольких логов пропускается, а названный один — отвергается. Правкой
// не считается повтор своего уровня лога: заданного с экрана, а без него — названного логу либо
// предку настройкой. Уровень, полученный от корня, своим не считается.
//
// Параметры:
//  ИменаЛогов - Массив из Строка - имена логов.
//  Уровень - Строка - DEBUG, INFO, WARN, ERROR, CRITICALERROR, DISABLE.
//  Кто - Строка - логин администратора.
//  АдресIP - Строка - адрес клиента для журнала аудита (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Применено (Массив из Строка — логи, чьё состояние изменилось), Пропущено (Массив
//              из Строка — логи только для чтения, которых правка не коснулась).
//
Функция ЗадатьУровень(Знач ИменаЛогов, Знач Уровень, Знач Кто, Знач АдресIP = "") Экспорт

	Уровень = ПризнанныйУровень(Уровень);

	Замок.Заблокировать();
	Попытка
		Правимые = ПравимыеИз(ИменаЛогов);
		Правка = НоваяПравка("уровень", Кто, АдресIP, Правимые.Пропущены);
		Правка.Стало = Уровень;
		Для Каждого Имя Из Правимые.Имена Цикл
			Если НЕ СвойУровеньТакой(Имя, Уровень) Тогда
				Правка.Было.Вставить(Имя, СловоСвоегоУровня(Имя));
				Заданное.ЗадатьУровень(Имя, Уровень, Кто, Правка.Когда);
			КонецЕсли;
		КонецЦикла;
		Применить(Затронутые(Правка.Было));
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	ОставитьСлед(Правка);
	Возврат ИтогПравки(Правка);

КонецФункции

// Задаёт уровень корню: его получают логи без своего уровня.
//
// Параметры:
//  Уровень - Строка - уровень.
//  Кто - Строка - логин администратора.
//  АдресIP - Строка - адрес клиента для журнала аудита (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - см. ЗадатьУровень.
//
Функция ЗадатьУровеньКорню(Знач Уровень, Знач Кто, Знач АдресIP = "") Экспорт
	Возврат ЗадатьУровень(ОдноИмя(Шкала.ИмяКорня()), Уровень, Кто, АдресIP);
КонецФункции

// Включает и выключает отправку строк логов в коллектор. Порог только сужает: в коллектор не уходит
// ничего подробнее уровня лога и подробнее порога. Без порога у лога остаётся порог, заданный ему
// раньше, — с экрана либо настройкой. Правкой не считается повтор своей отправки лога: заданной
// с экрана, а без неё — названной логу либо предку настройкой.
//
// Параметры:
//  ИменаЛогов - Массив из Строка - имена логов; корень — rootLogger.
//  Отправлять - Булево - отправлять ли.
//  Кто - Строка - логин администратора.
//  АдресIP - Строка - адрес клиента для журнала аудита (необязательный, по умолчанию "").
//  Порог - Строка - с какого уровня отправлять; "" — порог прежний; DEBUG — без порога
//          (необязательный).
//
// Возвращаемое значение:
//  Структура - см. ЗадатьУровень.
//
Функция ОтправлятьВOTel(Знач ИменаЛогов, Знач Отправлять, Знач Кто, Знач АдресIP = "",
	Знач Порог = "") Экспорт

	Порог = ?(ЗначениеЗаполнено(Порог), ПризнанныйУровень(Порог), Неопределено);

	Замок.Заблокировать();
	Попытка
		Правимые = ПравимыеИз(ИменаЛогов);
		ПроверитьДорогуВКоллектор(Правимые.Имена);
		Правка = НоваяПравка("отправка", Кто, АдресIP, Правимые.Пропущены);
		Правка.Стало = Новый Соответствие();
		Для Каждого Имя Из Правимые.Имена Цикл
			Если НЕ СвояОтправкаТакая(Имя, Отправлять, Порог) Тогда
				Правка.Было.Вставить(Имя, СловоСвоейОтправки(Имя));
				ПорогСЭкрана = ?(Порог = Неопределено, Заданное.Правка(Имя).Порог, Порог);
				Заданное.ЗадатьОтправку(Имя, Отправлять, ПорогСЭкрана, Кто, Правка.Когда);
				Правка.Стало.Вставить(Имя, СловоСвоейОтправки(Имя));
			КонецЕсли;
		КонецЦикла;
		Применить(Затронутые(Правка.Было));
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	ОставитьСлед(Правка);
	Возврат ИтогПравки(Правка);

КонецФункции

// Снимает заданное с экрана — уровень и отправку — с названных логов: лог пишет так, как стартовал.
//
// Параметры:
//  ИменаЛогов - Массив из Строка - имена логов; корень — rootLogger.
//  Кто - Строка - логин администратора.
//  АдресIP - Строка - адрес клиента для журнала аудита (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - см. ЗадатьУровень; Применено — логи, у которых было что снимать.
//
Функция ВернутьКСтарту(Знач ИменаЛогов, Знач Кто, Знач АдресIP = "") Экспорт

	Замок.Заблокировать();
	Попытка
		Правимые = ПравимыеИз(ИменаЛогов);
		Правка = Вернуть(Правимые.Имена, НоваяПравка("возврат", Кто, АдресIP, Правимые.Пропущены));
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	ОставитьСлед(Правка);
	Возврат ИтогПравки(Правка);

КонецФункции

#КонецОбласти

#Область Узлы

// Лог так, как он пишет сейчас в logos, со стартом из настроек и правкой с экрана.
Функция Узел(Знач Имя, Знач Правки, Знач Темп)

	Пишет = Процесс.Состояние(Имя);
	Стартовал = ?(Пишет.ОтНастроек, Старт.Лога(Имя), Старт.ДоНастроек(Процесс.ИсходныйУровень(Имя)));
	Правка = Правки.Правка(Имя);
	СтрокЗаМинуту = Темп.Получить(Имя);

	Описание = НовыйУзел(Имя, Группы.Группа(Имя), Стартовал, Правка);
	Описание.УровеньДействующий = Пишет.Уровень;
	Описание.ВКонсоль = Пишет.ВКонсоль;
	Описание.ВПамять = Пишет.ВПамять;
	Описание.ВOTel = Пишет.ВКоллектор;
	Описание.МожноВOTel = Пишет.ЕстьКоллектор;
	Описание.ПорогOTel = ?(Пишет.ЕстьКоллектор, ЗаданнаяОтправка(Имя, Правки).Порог, Неопределено);
	Описание.ПочемуТолькоЧтение = ПочемуТолькоЧтение(Пишет);
	Описание.ТолькоЧтение = ЗначениеЗаполнено(Описание.ПочемуТолькоЧтение);
	Описание.ПрочиеВыходы = Пишет.ПрочиеВыходы;
	Описание.СтрокЗаМинуту = ?(СтрокЗаМинуту = Неопределено, 0, СтрокЗаМинуту);
	Возврат Описание;

КонецФункции

// Корень — не лог logos, а настройка: пишет он так, как велят старт и правка с экрана.
Функция УзелКорня(Знач Правки)

	Стартовал = Старт.Корень();
	Правка = Правки.Правка(Шкала.ИмяКорня());
	Уровень = ?(Правка.Уровень = Неопределено, Стартовал.Уровень, Правка.Уровень);
	Отправка = ЗаданнаяОтправка(Шкала.ИмяКорня(), Правки);
	Пишет = Уровень <> Шкала.Молчание();

	Описание = НовыйУзел(Шкала.ИмяКорня(), "", Стартовал, Правка);
	Описание.УровеньДействующий = Уровень;
	Описание.ВКонсоль = Пишет И Стартовал.Выходы.Найти("console") <> Неопределено;
	Описание.ВПамять = Пишет И Стартовал.Выходы.Найти("memory") <> Неопределено;
	Описание.МожноВOTel = Стартовал.Выходы.Найти("otel") <> Неопределено;
	Описание.ВOTel = Пишет И Описание.МожноВOTel И Отправка.Отправлять;
	Описание.ПорогOTel = ?(Описание.МожноВOTel, Отправка.Порог, Неопределено);
	Возврат Описание;

КонецФункции

Функция НовыйУзел(Знач Имя, Знач Группа, Знач Стартовал, Знач Правка)

	Описание = Новый Структура();
	Описание.Вставить("Имя", Имя);
	Описание.Вставить("Группа", Группа);
	Описание.Вставить("УровеньПриСтарте", Стартовал.Уровень);
	Описание.Вставить("СвойПриСтарте", Стартовал.Свой);
	Описание.Вставить("ОткудаПриСтарте", Стартовал.Откуда);
	Описание.Вставить("ИмяНастройки", Стартовал.ИмяНастройки);
	Описание.Вставить("УровеньСЭкрана", Правка.Уровень);
	Описание.Вставить("ЗаданоКем", Правка.УровеньКто);
	Описание.Вставить("ЗаданоКогда", Правка.УровеньКогда);
	Описание.Вставить("УровеньДействующий", Стартовал.Уровень);
	Описание.Вставить("ВКонсоль", Ложь);
	Описание.Вставить("ВПамять", Ложь);
	Описание.Вставить("ВOTel", Ложь);
	Описание.Вставить("ПорогOTel", Неопределено);
	Описание.Вставить("OTelСЭкрана", Правка.Отправлять <> Неопределено);
	Описание.Вставить("OTelЗаданКем", Правка.ОтправкаКто);
	Описание.Вставить("OTelЗаданКогда", Правка.ОтправкаКогда);
	Описание.Вставить("МожноВOTel", Ложь);
	Описание.Вставить("ТолькоЧтение", Ложь);
	Описание.Вставить("ПочемуТолькоЧтение", "");
	Описание.Вставить("ПрочиеВыходы", Новый Массив());
	Описание.Вставить("СтрокЗаМинуту", 0);
	Возврат Описание;

КонецФункции

// Лог, созданный раньше настроек, пишет консолью logos мимо двери обезличивания; лог, которому
// код повесил свой выход, — журнал аудита.
Функция ПочемуТолькоЧтение(Знач Пишет)
	Если НЕ Пишет.ОтНастроек Тогда
		Возврат "before_wiring";
	ИначеЕсли Пишет.ПрочиеВыходы.Количество() > 0 Тогда
		Возврат "audit";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ТолькоЧтение(Знач Пишет)
	Возврат ЗначениеЗаполнено(ПочемуТолькоЧтение(Пишет));
КонецФункции

#КонецОбласти

#Область Отправка

// Отправка лога (либо корня) в коллектор по заданному: с экрана, иначе корнем с экрана — если
// порог логу настройка не называла, иначе как при старте.
//
// Возвращаемое значение:
//  Структура - Отправлять (Булево), Порог (Строка либо Неопределено — порога нет).
//
Функция ЗаданнаяОтправка(Знач Имя, Знач Правки)

	Корня = Правки.Правка(Шкала.ИмяКорня());
	Если Имя = Шкала.ИмяКорня() Тогда
		Возврат ОтправкаСЭкрана(Корня, ОтправкаСтарта(Старт.Корень().Порог));
	КонецЕсли;

	Стартовал = Старт.Лога(Имя);
	Своя = Правки.Правка(Имя);
	Если Своя.Отправлять <> Неопределено Тогда
		Возврат ОтправкаСЭкрана(Своя, ОтправкаСтарта(Стартовал.Порог));
	ИначеЕсли НЕ Стартовал.ПорогНазван Тогда
		Возврат ОтправкаСЭкрана(Корня, ОтправкаСтарта(Стартовал.Порог));
	КонецЕсли;
	Возврат ОтправкаСтарта(Стартовал.Порог);

КонецФункции

// Порог DISABLE при старте — отправка выключена: включают её, а не порог снимают.
Функция ОтправкаСтарта(Знач Порог)
	Если Порог = Шкала.Молчание() Тогда
		Возврат Отправка(Ложь, Неопределено);
	КонецЕсли;
	Возврат Отправка(Истина, ПорогИлиНичего(Порог));
КонецФункции

// Правка с экрана без своего порога оставляет порог старта; правки нет — отправка как при старте.
Функция ОтправкаСЭкрана(Знач Правка, Знач КакПриСтарте)
	Если Правка.Отправлять = Неопределено Тогда
		Возврат КакПриСтарте;
	КонецЕсли;
	Порог = ?(Правка.Порог = Неопределено, КакПриСтарте.Порог, ПорогИлиНичего(Правка.Порог));
	Возврат Отправка(Правка.Отправлять, Порог);
КонецФункции

// Порог DEBUG ничего не сужает ни при каком уровне — это отсутствие порога.
Функция ПорогИлиНичего(Знач Слово)
	Возврат ?(ЗначениеЗаполнено(Слово) И Слово <> Шкала.Подробнейший(), Слово, Неопределено);
КонецФункции

// У выключенной отправки порога нет: включённая снова, она берёт порог из заданного с экрана.
Функция Отправка(Знач Отправлять, Знач Порог)
	Возврат Новый Структура("Отправлять, Порог", Отправлять, ?(Отправлять, Порог, Неопределено));
КонецФункции

// Отправка одним словом — для аудита и закрепления: DISABLE — не отправлять, уровень — только
// с него, DEBUG — порога нет, всё, что пишет лог.
Функция СловоОтправки(Знач Отправка_)
	Если НЕ Отправка_.Отправлять Тогда
		Возврат Шкала.Молчание();
	КонецЕсли;
	Возврат ?(Отправка_.Порог = Неопределено, Шкала.Подробнейший(), Отправка_.Порог);
КонецФункции

// Выход коллектора в logos: выключен; порог, если он сужает поток лога; иначе следует уровню лога.
Функция УровеньВыходаКоллектора(Знач Отправка_, Знач Уровень)
	Если НЕ Отправка_.Отправлять Тогда
		Возврат Шкала.Молчание();
	ИначеЕсли Шкала.ПорогСужает(Отправка_.Порог, Уровень) Тогда
		Возврат Отправка_.Порог;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

#КонецОбласти

#Область Применение

// Имена из правки, которые пульт правит, и пропущенные; незнакомое имя отвергает всю правку.
Функция ПравимыеИз(Знач ИменаЛогов)

	Итог = Новый Структура("Имена, Пропущены", Новый Массив(), Новый Массив());
	Незнакомые = Новый Массив();
	Для Каждого Имя Из ИменаЛогов Цикл
		Если Итог.Имена.Найти(Имя) <> Неопределено ИЛИ Итог.Пропущены.Найти(Имя) <> Неопределено Тогда
			Продолжить;
		ИначеЕсли Имя = Шкала.ИмяКорня() Тогда
			Итог.Имена.Добавить(Имя);
		ИначеЕсли НЕ Процесс.Есть(Имя) Тогда
			Незнакомые.Добавить(Имя);
		ИначеЕсли ТолькоЧтение(Процесс.Состояние(Имя)) Тогда
			Итог.Пропущены.Добавить(Имя);
		Иначе
			Итог.Имена.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Если Незнакомые.Количество() > 0 Тогда
		ВызватьИсключение "log.unknown_logger: " + СтрСоединить(Незнакомые, ", ");
	ИначеЕсли Итог.Имена.Количество() = 0 И Итог.Пропущены.Количество() > 0 Тогда
		ВызватьИсключение "log.read_only: " + СтрСоединить(Итог.Пропущены, ", ");
	КонецЕсли;
	Возврат Итог;

КонецФункции

Процедура ПроверитьДорогуВКоллектор(Знач Имена)

	Недоступные = Новый Массив();
	Для Каждого Имя Из Имена Цикл
		Если Имя = Шкала.ИмяКорня() Тогда
			Дорога = Старт.Корень().Выходы.Найти("otel") <> Неопределено;
		Иначе
			Дорога = Процесс.Состояние(Имя).ЕстьКоллектор;
		КонецЕсли;
		Если НЕ Дорога Тогда
			Недоступные.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Если Недоступные.Количество() > 0 Тогда
		ВызватьИсключение "log.otel_unreachable: " + СтрСоединить(Недоступные, ", ");
	КонецЕсли;

КонецПроцедуры

// Правка корня доходит до логов, которые живут на корне; правка лога — до него самого.
Процедура Применить(Знач Правленые)

	ЛогиПравки = Новый Массив();
	Для Каждого Имя Из Правленые Цикл
		Если Имя <> Шкала.ИмяКорня() Тогда
			ЛогиПравки.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Если Правленые.Найти(Шкала.ИмяКорня()) <> Неопределено Тогда
		Для Каждого Имя Из Процесс.Имена() Цикл
			Если ЛогиПравки.Найти(Имя) = Неопределено И НаКорне(Имя) Тогда
				ЛогиПравки.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого Имя Из ЛогиПравки Цикл
		Цель = Желаемое(Имя);
		Процесс.Установить(Имя, Цель.Уровень, Цель.УровеньВыходаКоллектора);
	КонецЦикла;

КонецПроцедуры

// Лог, до которого может дойти правка корня: правимый, и настройка не назвала ему либо уровня,
// либо порога. Что именно от корня он получит, решает Желаемое.
Функция НаКорне(Знач Имя)

	Если ТолькоЧтение(Процесс.Состояние(Имя)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Стартовал = Старт.Лога(Имя);
	Возврат НЕ Стартовал.Свой ИЛИ НЕ Стартовал.ПорогНазван;

КонецФункции

// Уровень: с экрана, иначе корня с экрана — если лог живёт на уровне корня, иначе исходный.
// Выход коллектора: выключен либо не подробнее уровня лога и не подробнее заданного порога.
Функция Желаемое(Знач Имя)

	Своя = Заданное.Правка(Имя);
	Корня = Заданное.Правка(Шкала.ИмяКорня());

	Уровень = Процесс.ИсходныйУровень(Имя);
	Если Своя.Уровень <> Неопределено Тогда
		Уровень = Своя.Уровень;
	ИначеЕсли Корня.Уровень <> Неопределено И НЕ Старт.Лога(Имя).Свой Тогда
		Уровень = Корня.Уровень;
	КонецЕсли;

	Возврат Новый Структура("Уровень, УровеньВыходаКоллектора", Уровень,
		УровеньВыходаКоллектора(ЗаданнаяОтправка(Имя, Заданное), Уровень));

КонецФункции

// Снимает заданное с экрана и возвращает логи к старту; Возвращено — что снимали: уровень,
// отправку либо всё.
Функция Вернуть(Знач Имена, Знач Правка)

	Правка.Стало = Новый Соответствие();
	Уровень = Ложь;
	Отправку = Ложь;
	Для Каждого Имя Из Имена Цикл
		Было = СвоёСловами(Имя);
		Снятая = Заданное.Правка(Имя);
		Если Заданное.Снять(Имя) Тогда
			Правка.Было.Вставить(Имя, Было);
			Уровень = Уровень ИЛИ Снятая.Уровень <> Неопределено;
			Отправку = Отправку ИЛИ Снятая.Отправлять <> Неопределено;
		КонецЕсли;
	КонецЦикла;
	Правка.Возвращено = ?(Уровень И Отправку, "всё", ?(Отправку, "отправка", "уровень"));

	Вернувшиеся = Затронутые(Правка.Было);
	Применить(Вернувшиеся);
	Для Каждого Имя Из Вернувшиеся Цикл
		Правка.Стало.Вставить(Имя, СвоёСловами(Имя));
	КонецЦикла;
	Возврат Правка;

КонецФункции

// След правки — запись в журнале аудита и строка в своём логе; правка без изменений следа не оставляет.
Процедура ОставитьСлед(Знач Правка)

	Если Правка.Было.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Летопись.Записать(Правка);
	Лог.Информация("Пульт журнала: %1, %2 — %3", Правка.Кто, Правка.Что,
		СтрСоединить(Затронутые(Правка.Было), ", "));

КонецПроцедуры

// Что изменила правка и кого пропустила: повторы — ни там, ни там.
Функция ИтогПравки(Знач Правка)
	Возврат Новый Структура("Применено, Пропущено", Затронутые(Правка.Было), Правка.Пропущены);
КонецФункции

#КонецОбласти

#Область Значения

// Правка для летописи: что правят, кто и откуда, когда, значения логов до правки и после,
// пропущенные логи.
Функция НоваяПравка(Знач Что, Знач Кто, Знач АдресIP, Знач Пропущены)
	Возврат Новый Структура("Что, Кто, АдресIP, Когда, Было, Стало, Пропущены, Возвращено", Что, Кто,
		Строка(АдресIP), ТекущаяУниверсальнаяДата(), Новый Соответствие(), Неопределено, Пропущены, "");
КонецФункции

// Правкой не считается повтор своего уровня лога; уровень корня своим у лога не считается, и явная
// правка того же значения закрепляет его за логом.
Функция СвойУровеньТакой(Знач Имя, Знач Уровень)
	Возврат УровеньСвой(Имя) И ДействующийУровень(Имя) = Уровень;
КонецФункции

// Правкой не считается повтор своей отправки лога; отправка от корня своей у лога не считается.
Функция СвояОтправкаТакая(Знач Имя, Знач Отправлять, Знач Порог)

	Если НЕ ОтправкаСвоя(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;

	Сейчас = ЗаданнаяОтправка(Имя, Заданное);
	Если Сейчас.Отправлять <> Отправлять Тогда
		Возврат Ложь;
	ИначеЕсли НЕ Отправлять ИЛИ Порог = Неопределено Тогда
		// выключенная — та же при любом пороге; включённая без порога оставляет прежний
		Возврат Истина;
	КонецЕсли;
	Возврат Сейчас.Порог = ПорогИлиНичего(Порог);

КонецФункции

// Свой уровень — заданный с экрана либо названный логу или предку настройкой; у корня он свой всегда.
Функция УровеньСвой(Знач Имя)
	Если Имя = Шкала.ИмяКорня() Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат (Заданное.Правка(Имя).Уровень <> Неопределено) ИЛИ Старт.Лога(Имя).Свой;
КонецФункции

// Своя отправка — заданная с экрана либо с порогом, названным логу или предку настройкой; у корня
// она своя всегда.
Функция ОтправкаСвоя(Знач Имя)
	Если Имя = Шкала.ИмяКорня() Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат (Заданное.Правка(Имя).Отправлять <> Неопределено) ИЛИ Старт.Лога(Имя).ПорогНазван;
КонецФункции

// Уровень лога для аудита: свой — словом уровня, живущий на корне — словом «как у корня».
Функция СловоСвоегоУровня(Знач Имя)
	Возврат ?(УровеньСвой(Имя), ДействующийУровень(Имя), Шкала.СловоКакУКорня());
КонецФункции

// Отправка лога для аудита: своя — словом отправки, от корня — словом «как у корня».
Функция СловоСвоейОтправки(Знач Имя)
	Возврат ?(ОтправкаСвоя(Имя), СловоОтправки(ЗаданнаяОтправка(Имя, Заданное)), Шкала.СловоКакУКорня());
КонецФункции

// Свои уровень и отправка лога словами — до возврата к старту и после него.
Функция СвоёСловами(Знач Имя)
	Возврат Новый Структура("Уровень, Отправка", СловоСвоегоУровня(Имя), СловоСвоейОтправки(Имя));
КонецФункции

Функция ДействующийУровень(Знач Имя)
	Если Имя = Шкала.ИмяКорня() Тогда
		Возврат УзелКорня(Заданное).УровеньДействующий;
	КонецЕсли;
	Возврат Процесс.Состояние(Имя).Уровень;
КонецФункции

// Заданное с экрана так, как с ним должен стартовать хаб: уровни и отправки словами.
Функция Закрепляемое(Знач Правки)

	Итог = Новый Структура("Уровни, Пороги", Новый Соответствие(), Новый Соответствие());
	Для Каждого Имя Из Правки.Имена() Цикл
		Правка = Правки.Правка(Имя);
		Если Правка.Уровень <> Неопределено Тогда
			Итог.Уровни.Вставить(Имя, Правка.Уровень);
		КонецЕсли;
		Если Правка.Отправлять <> Неопределено Тогда
			Итог.Пороги.Вставить(Имя, СловоОтправки(ЗаданнаяОтправка(Имя, Правки)));
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Незнакомое слово отвергается кодом log.unknown_level и называется как есть.
Функция ПризнанныйУровень(Знач Написанное)
	Уровень = ВРег(СокрЛП(Строка(Написанное)));
	Если Шкала.Место(Уровень) = Неопределено Тогда
		ВызватьИсключение "log.unknown_level: " + Строка(Написанное);
	КонецЕсли;
	Возврат Уровень;
КонецФункции

// Уровни, которыми пишутся строки: молчание строкой не бывает.
Функция УровниСтрок()
	Итог = Шкала.Уровни();
	Итог.Удалить(Итог.Найти(Шкала.Молчание()));
	Возврат Итог;
КонецФункции

#КонецОбласти

#Область Служебное

Функция СнимокЗаданного()
	Замок.Заблокировать();
	Снимок = Заданное.Снимок();
	Замок.Разблокировать();
	Возврат Снимок;
КонецФункции

// Имена так, как их знает logos: оператор вправе написать имя лога в другом регистре.
Функция НастоящиеИмена(Знач Написанные)

	Известные = Новый Соответствие();
	Для Каждого Имя Из Процесс.Имена() Цикл
		Известные.Вставить(НРег(Имя), Имя);
	КонецЦикла;

	Итог = Новый Массив();
	Для Каждого Написанное Из Написанные Цикл
		Имя = Известные.Получить(НРег(СокрЛП(Написанное)));
		Итог.Добавить(?(Имя = Неопределено, Написанное, Имя));
	КонецЦикла;
	Возврат Итог;

КонецФункции

Функция ЛогиВетки(Знач Ветка)
	Итог = Новый Массив();
	Для Каждого Имя Из Процесс.Имена() Цикл
		Если Группы.ВВетке(Группы.Группа(Имя), Ветка) Тогда
			Итог.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;
КонецФункции

// Пересечение: Неопределено — «любые логи».
Функция ОбщиеИмена(Знач Имена, Знач Ещё)
	Если Имена = Неопределено Тогда
		Возврат Ещё;
	КонецЕсли;
	Итог = Новый Массив();
	Для Каждого Имя Из Имена Цикл
		Если Ещё.Найти(Имя) <> Неопределено Тогда
			Итог.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;
КонецФункции

// Имена логов, которых правка коснулась, в порядке правки.
Функция Затронутые(Знач Было)
	Итог = Новый Массив();
	Для Каждого ИмяИЗначение Из Было Цикл
		Итог.Добавить(ИмяИЗначение.Ключ);
	КонецЦикла;
	Возврат Итог;
КонецФункции

Функция ОдноИмя(Знач Имя)
	Итог = Новый Массив();
	Итог.Добавить(Имя);
	Возврат Итог;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ШкалаЖурнала") _Шкала,
	&Пластилин(Значение = "ЛогиПроцесса") _Процесс,
	&Пластилин(Значение = "СтартЖурнала") _Старт,
	&Пластилин(Значение = "ГруппыЛогов") _Группы,
	&Пластилин(Значение = "ПутиЖурнала") _Пути,
	&Пластилин(Значение = "ПамятьЖурнала") _Память,
	&Пластилин(Значение = "ЗакреплениеЖурнала") _Закрепление,
	&Пластилин(Значение = "ЛетописьПультаЖурнала") _Летопись,
	&Пластилин(Значение = "ПриведениеФлагов") _Флаги,
	&Деталька(Значение = "otel.enabled", ЗначениеПоУмолчанию = Ложь) _ТелеметрияВключена = Ложь,
	&Деталька(Значение = "otel.logs.exporter", ЗначениеПоУмолчанию = "otlp") _ЭкспортёрЖурнала = "otlp",
	&Лог _Лог = Неопределено)

	Шкала = _Шкала;
	Процесс = _Процесс;
	Старт = _Старт;
	Группы = _Группы;
	ПутиОператора = _Пути;
	Память = _Память;
	Закрепление = _Закрепление;
	Летопись = _Летопись;
	Заданное = Новый ЗаданноеСЭкрана();
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
	УходитВКоллектор = _Флаги.ФлагТолькоTrue(_ТелеметрияВключена) И НРег(СокрЛП(_ЭкспортёрЖурнала)) <> "none";
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "ПультЖурнала создан без лога — контейнер обязан прилепить &Лог";
	КонецЕсли;
	Лог = _Лог;

КонецПроцедуры
