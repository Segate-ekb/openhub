// Связка журнала для configor — узлы «logos.logger» и «logos.appender» из уровней корневого лога
// и компонентов — и отбор строки по уровню её собственного лога и по журналу со своим приёмником.

Перем СписокЗамечаний;         // Массив строк — что отвергнуто и чем заменено
Перем УровеньВывода;   // самый подробный из запрошенных уровней; им живут способы вывода
Перем ИменаНастроек;   // Структура: Корневой, Компоненты — как оператор называет обе настройки

#Область ПубличныйИнтерфейс

// Собирает связку журнала из значений настроек уровня корневого журнала и уровней компонентов.
//
// Параметры:
//  КорневойУровень - Строка - уровень корневого журнала; пустое и незнакомое дают INFO.
//  УровниКомпонентов - Строка - уровни вида "Имя=Уровень,Имя2=Уровень"; пустое допустимо.
//                      Имя компонента — имя лога, то есть имя класса.
//  ТипыСпособовВывода - Соответствие - имя способа вывода -> имя класса.
//  Названия - Структура - как замечания называют обе настройки (необязательный):
//   * Корневой - Строка - настройка корневого уровня.
//   * Компоненты - Строка - настройка уровней компонентов.
//  ЖурналыСоСвоимПриёмником - Строка - имена журналов через запятую, которые пишут в свой
//                             приёмник: способы вывода хаба их строк не печатают
//                             (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Логи (Соответствие, узел "logos.logger"),
//              СпособыВывода (Соответствие, узел "logos.appender").
//
Функция Связка(Знач КорневойУровень, Знач УровниКомпонентов, Знач ТипыСпособовВывода,
	Знач Названия = Неопределено, Знач ЖурналыСоСвоимПриёмником = "") Экспорт

	СписокЗамечаний = Новый Массив();
	Если Названия <> Неопределено Тогда
		ИменаНастроек = Названия;
	КонецЕсли;

	Имена = Новый Массив();
	Для Каждого ТипПоИмени Из ТипыСпособовВывода Цикл
		Имена.Добавить(ТипПоИмени.Ключ);
	КонецЦикла;

	Логи = Новый Соответствие();
	Логи.Вставить("rootLogger", Лог(Признанный(КорневойУровень, ИменаНастроек.Корневой, "INFO"), Имена));
	ДобавитьКомпоненты(Логи, УровниКомпонентов, Имена);

	УровеньВывода = СамыйПодробный(Логи);

	Возврат Новый Структура("Логи, СпособыВывода",
		Логи, СпособыВывода(ТипыСпособовВывода, ЖурналыСоСвоимПриёмником));

КонецФункции

// Пропускает ли строку её собственный лог.
//
// Способы вывода объявлены самым подробным из запрошенных уровней: явный уровень способа
// вывода logos считает вместе с уровнем лога по МИНИМУМУ, и способ вывода на INFO обрезал
// бы точечный DEBUG компонента. Разделяет их это правило: чужую подробность отсекает оно,
// а не способ вывода.
//
// Параметры:
//  СобытиеЛога - СобытиеЛога - событие библиотеки logos.
//
// Возвращаемое значение:
//  Булево - Истина, если строку печатать.
//
Функция СтрокаПроходит(Знач СобытиеЛога) Экспорт

	Попытка
		Возврат СобытиеЛога.ПолучитьУровень() >= СобытиеЛога.ПолучитьУровеньЛога();
	Исключение
		// Событие без уровня лога (чужая реализация контракта) отбору не подлежит.
		Возврат Истина;
	КонецПопытки;

КонецФункции

// Имя свойства способа вывода хаба со списком журналов, которые пишут в свой приёмник.
// logos наследует способы вывода корня каждому журналу и выключить это не даёт, поэтому
// общий вывод отсеивает такие строки сам.
//
// Возвращаемое значение:
//  Строка.
//
Функция СвойствоСвоихПриёмников() Экспорт
	Возврат "own_sink_loggers";
КонецФункции

// Журналы со своим приёмником из значения свойства способа вывода.
//
// Параметры:
//  Значение - Строка - имена журналов через запятую.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ЖурналыСоСвоимПриёмником(Знач Значение) Экспорт

	Журналы = Новый Массив();
	Для Каждого Имя Из СтрРазделить(Строка(?(Значение = Неопределено, "", Значение)), ",", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Имя)) Тогда
			Журналы.Добавить(СокрЛП(Имя));
		КонецЕсли;
	КонецЦикла;
	Возврат Журналы;

КонецФункции

// Пишет ли журнал строки в свой приёмник: общий вывод хаба такую строку не повторяет.
//
// Параметры:
//  СобытиеЛога - СобытиеЛога - событие библиотеки logos.
//  Журналы - Массив из Строка - журналы со своим приёмником.
//
// Возвращаемое значение:
//  Булево.
//
Функция УСвоегоПриёмника(Знач СобытиеЛога, Знач Журналы) Экспорт

	Если Журналы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Журналы.Найти(СобытиеЛога.ПолучитьИмяЛога()) <> Неопределено;

КонецФункции

// Что оператору сказать про отвергнутое. Пустой массив — уровни поняты целиком.
//
// Возвращаемое значение:
//  Массив из Строка - готовые строки предупреждений.
//
Функция Замечания() Экспорт
	Возврат ?(СписокЗамечаний = Неопределено, Новый Массив(), СписокЗамечаний);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДопустимыеУровни()
	Возврат "DEFAULT,DEBUG,INFO,WARN,ERROR,CRITICALERROR,DISABLE";
КонецФункции

// Уровни от самого подробного к самому молчаливому; DEFAULT — это корневой уровень, его в ряду нет.
Функция РядПодробности()
	Возврат "DEBUG,INFO,WARN,ERROR,CRITICALERROR,DISABLE";
КонецФункции

Функция Лог(Знач Уровень, Знач ИменаСпособовВывода)

	// у названного лога свой набор способов вывода — без него поднятая подробность уходит в никуда
	Настройка = Новый Соответствие();
	Настройка.Вставить("level", Уровень);
	Настройка.Вставить("appenders", ИменаСпособовВывода);

	Возврат Настройка;

КонецФункции

Процедура ДобавитьКомпоненты(Логи, Знач Написанное, Знач ИменаСпособовВывода)

	Если НЕ ЗначениеЗаполнено(СокрЛП(Строка(Написанное))) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Пара Из СтрРазделить(Строка(Написанное), ",", Ложь) Цикл

		Знак = СтрНайти(Пара, "=");
		ИмяЛога = ?(Знак = 0, "", СокрЛП(Лев(Пара, Знак - 1)));

		Если НЕ ЗначениеЗаполнено(ИмяЛога) Тогда
			СписокЗамечаний.Добавить(СтрШаблон("%1: ""%2"" не пара ""Имя=Уровень"" — пропущено",
				ИменаНастроек.Компоненты, СокрЛП(Пара)));
			Продолжить;
		КонецЕсли;

		// DEFAULT оставляет компонент на корневом уровне — как без непонятого слова
		Логи.Вставить(ИмяЛога, Лог(Признанный(Сред(Пара, Знак + 1),
			ИменаНастроек.Компоненты + "[" + ИмяЛога + "]", "DEFAULT"), ИменаСпособовВывода));

	КонецЦикла;

КонецПроцедуры

// Самый подробный из запрошенных уровней: DEBUG всегда открыл бы сборку отладочных строк у каждого лога.
Функция СамыйПодробный(Знач Логи)

	Ряд = СтрРазделить(РядПодробности(), ",");
	Место = Ряд.Найти(Логи["rootLogger"]["level"]);
	Место = ?(Место = Неопределено, Ряд.Найти("INFO"), Место);

	Для Каждого Настройка Из Логи Цикл
		Запрошено = Ряд.Найти(Настройка.Значение["level"]);
		Если Запрошено <> Неопределено И Запрошено < Место Тогда
			Место = Запрошено;
		КонецЕсли;
	КонецЦикла;

	Возврат Ряд[Место];

КонецФункции

Функция СпособыВывода(Знач ТипыСпособовВывода, Знач ЖурналыСоСвоимПриёмником)

	Узел = Новый Соответствие();

	Для Каждого ТипПоИмени Из ТипыСпособовВывода Цикл
		Описание = Новый Соответствие();
		Описание.Вставить("type", ТипПоИмени.Значение);
		Описание.Вставить("level", УровеньВывода);
		Если ЗначениеЗаполнено(ЖурналыСоСвоимПриёмником) Тогда
			Описание.Вставить(СвойствоСвоихПриёмников(), ЖурналыСоСвоимПриёмником);
		КонецЕсли;
		Узел.Вставить(ТипПоИмени.Ключ, Описание);
	КонецЦикла;

	Возврат Узел;

КонецФункции

// Незнакомое слово заменяется запасным уровнем с замечанием: logos на нём не поднял бы хаб.
Функция Признанный(Знач Написанное, Знач ИмяНастройки, Знач Запасной)

	Уровень = ВРег(СокрЛП(Строка(Написанное)));
	Если СтрРазделить(ДопустимыеУровни(), ",").Найти(Уровень) <> Неопределено Тогда
		Возврат Уровень;
	КонецЕсли;

	// Неназванное — не ошибка оператора, а умолчание: жаловаться не на что.
	Если НЕ ЗначениеЗаполнено(Уровень) Тогда
		Возврат Запасной;
	КонецЕсли;

	СписокЗамечаний.Добавить(СтрШаблон("%1: ""%2"" не уровень журнала, беру %3. Допустимы: %4",
		ИмяНастройки, СокрЛП(Строка(Написанное)), Запасной, ДопустимыеУровни()));

	Возврат Запасной;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	СписокЗамечаний = Новый Массив();
	УровеньВывода = "INFO";
	ИменаНастроек = Новый Структура("Корневой, Компоненты", "уровень журнала", "уровни журналов");
КонецПроцедуры
