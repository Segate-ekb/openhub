// Связка журнала для деталек configor: узел "logos.logger" (корневой лог и уровни
// отдельных компонентов из окружения) и узел "logos.appender" (способы вывода). Здесь же
// живёт отбор строки по уровню её лога — потому что уровень способа вывода и уровень лога
// в logos спорят друг с другом, и разрешать спор приходится в обе стороны одним правилом.

Перем СписокЗамечаний;         // Массив строк — что отвергнуто и чем заменено
Перем УровеньВывода;   // самый подробный из запрошенных уровней; им живут способы вывода

#Область ПубличныйИнтерфейс

// Собирает связку журнала из значений окружения.
//
// Параметры:
//  КорневойУровень - Строка - значение OSHUB_LOG_LEVEL; пустое и незнакомое дают INFO.
//  УровниКомпонентов - Строка - значение OSHUB_LOG_LEVELS вида "Имя=Уровень,Имя2=Уровень";
//                      пустое допустимо. Имя компонента — имя лога, то есть имя класса.
//  ТипыСпособовВывода - Соответствие - имя способа вывода -> имя класса.
//
// Возвращаемое значение:
//  Структура - Логи (Соответствие, узел "logos.logger"),
//              СпособыВывода (Соответствие, узел "logos.appender").
//
Функция Связка(Знач КорневойУровень, Знач УровниКомпонентов, Знач ТипыСпособовВывода) Экспорт

	СписокЗамечаний = Новый Массив();

	Имена = Новый Массив();
	Для Каждого ТипПоИмени Из ТипыСпособовВывода Цикл
		Имена.Добавить(ТипПоИмени.Ключ);
	КонецЦикла;

	Логи = Новый Соответствие();
	Логи.Вставить("rootLogger",
		Лог(Признанный(КорневойУровень, "OSHUB_LOG_LEVEL", "INFO"), Имена));
	ДобавитьКомпоненты(Логи, УровниКомпонентов, Имена);

	УровеньВывода = СамыйПодробный(Логи);

	Возврат Новый Структура("Логи, СпособыВывода",
		Логи, СпособыВывода(ТипыСпособовВывода));

КонецФункции

// Пропускает ли строку её собственный лог.
//
// Способы вывода объявлены самым подробным из запрошенных уровней: явный уровень способа
// вывода logos считает вместе с уровнем лога по МИНИМУМУ, и способ вывода на INFO обрезал
// бы точечный DEBUG компонента. Разделяет их это правило: чужую подробность отсекает оно,
// а не способ вывода.
//
// Параметры:
//  СобытиеЛога - СобытиеЛога - событие библиотеки logos.
//
// Возвращаемое значение:
//  Булево - Истина, если строку печатать.
//
Функция СтрокаПроходит(Знач СобытиеЛога) Экспорт

	Попытка
		Возврат СобытиеЛога.ПолучитьУровень() >= СобытиеЛога.ПолучитьУровеньЛога();
	Исключение
		// Событие без уровня лога (чужая реализация контракта) отбору не подлежит.
		Возврат Истина;
	КонецПопытки;

КонецФункции

// Что оператору сказать про отвергнутое. Пустой массив — окружение понято целиком.
//
// Возвращаемое значение:
//  Массив из Строка - готовые строки предупреждений.
//
Функция Замечания() Экспорт
	Возврат ?(СписокЗамечаний = Неопределено, Новый Массив(), СписокЗамечаний);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДопустимыеУровни()
	Возврат "DEFAULT,DEBUG,INFO,WARN,ERROR,CRITICALERROR,DISABLE";
КонецФункции

// Уровни от самого подробного к самому молчаливому: DEFAULT в ряду нет — компонент
// с ним живёт на корневом уровне и подробности собой не добавляет.
Функция РядПодробности()
	Возврат "DEBUG,INFO,WARN,ERROR,CRITICALERROR,DISABLE";
КонецФункции

Функция Лог(Знач Уровень, Знач ИменаСпособовВывода)

	// Способы вывода перечисляются и компоненту: у названного лога свой набор, и без него
	// поднятая подробность уходит в никуда — уровень DEBUG при пустом выводе.
	Настройка = Новый Соответствие();
	Настройка.Вставить("level", Уровень);
	Настройка.Вставить("appenders", ИменаСпособовВывода);

	Возврат Настройка;

КонецФункции

Процедура ДобавитьКомпоненты(Логи, Знач Написанное, Знач ИменаСпособовВывода)

	Если НЕ ЗначениеЗаполнено(СокрЛП(Строка(Написанное))) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Пара Из СтрРазделить(Строка(Написанное), ",", Ложь) Цикл

		Знак = СтрНайти(Пара, "=");
		ИмяЛога = ?(Знак = 0, "", СокрЛП(Лев(Пара, Знак - 1)));

		Если НЕ ЗначениеЗаполнено(ИмяЛога) Тогда
			СписокЗамечаний.Добавить(СтрШаблон(
				"OSHUB_LOG_LEVELS: ""%1"" не пара ""Имя=Уровень"" — пропущено", СокрЛП(Пара)));
			Продолжить;
		КонецЕсли;

		// DEFAULT запасным не случаен: заготовка logos пропускает такой ключ, и компонент
		// остаётся на корневом уровне — ровно то, что было бы без непонятого слова.
		Логи.Вставить(ИмяЛога, Лог(Признанный(Сред(Пара, Знак + 1),
			"OSHUB_LOG_LEVELS[" + ИмяЛога + "]", "DEFAULT"), ИменаСпособовВывода));

	КонецЦикла;

КонецПроцедуры

// Самый подробный из фактически запрошенных уровней. Ставить способам вывода DEBUG
// всегда нельзя: гейт logos откроется, и подавленная отладочная строка будет собираться
// целиком у КАЖДОГО лога — «выключенная подробность ничего не стоит» перестанет быть правдой.
Функция СамыйПодробный(Знач Логи)

	Ряд = СтрРазделить(РядПодробности(), ",");
	Место = Ряд.Найти(Логи["rootLogger"]["level"]);
	Место = ?(Место = Неопределено, Ряд.Найти("INFO"), Место);

	Для Каждого Настройка Из Логи Цикл
		Запрошено = Ряд.Найти(Настройка.Значение["level"]);
		Если Запрошено <> Неопределено И Запрошено < Место Тогда
			Место = Запрошено;
		КонецЕсли;
	КонецЦикла;

	Возврат Ряд[Место];

КонецФункции

Функция СпособыВывода(Знач ТипыСпособовВывода)

	Узел = Новый Соответствие();

	Для Каждого ТипПоИмени Из ТипыСпособовВывода Цикл
		Описание = Новый Соответствие();
		Описание.Вставить("type", ТипПоИмени.Значение);
		Описание.Вставить("level", УровеньВывода);
		Узел.Вставить(ТипПоИмени.Ключ, Описание);
	КонецЦикла;

	Возврат Узел;

КонецФункции

// logos на незнакомом слове падает голой ошибкой, в которой нет ни имени переменной,
// ни списка допустимых, — и хаб не поднимается вовсе.
Функция Признанный(Знач Написанное, Знач ИмяПеременной, Знач Запасной)

	Уровень = ВРег(СокрЛП(Строка(Написанное)));
	Если СтрРазделить(ДопустимыеУровни(), ",").Найти(Уровень) <> Неопределено Тогда
		Возврат Уровень;
	КонецЕсли;

	// Неназванное — не ошибка оператора, а умолчание: жаловаться не на что.
	Если НЕ ЗначениеЗаполнено(Уровень) Тогда
		Возврат Запасной;
	КонецЕсли;

	СписокЗамечаний.Добавить(СтрШаблон("%1: ""%2"" не уровень журнала, беру %3. Допустимы: %4",
		ИмяПеременной, СокрЛП(Строка(Написанное)), Запасной, ДопустимыеУровни()));

	Возврат Запасной;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	СписокЗамечаний = Новый Массив();
	УровеньВывода = "INFO";
КонецПроцедуры
