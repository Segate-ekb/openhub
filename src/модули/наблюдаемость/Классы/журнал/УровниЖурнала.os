// Связка журнала для деталек: узел "logos.logger" — уровень и выходы корня и каждого названного
// лога, с порогом коллектора поверх; узел "logos.appender" — объявления выходов хаба.

Перем ТипыВыходов;       // Соответствие: логическое имя выхода → класс способа вывода
Перем СоСвоимПриёмником; // Массив из Строка — журналы, которые пишут только в приёмник, повешенный кодом
Перем СписокЗамечаний;   // Массив из Строка — что отвергнуто и почему
Перем Шкала;             // ШкалаЖурнала (наблюдаемость) — ряд уровней, умолчание, «как у корня», имя корня, правило порога

#Область ПубличныйИнтерфейс

// Собирает связку журнала из того, что задал оператор, в два шага.
//
// Уровни и выходы каждого журнала — так, как их настроила бы сама logos: источники ложатся
// по старшинству — программно, окружение, родной узел logos.logger файла, ключи хаба файла
// (псевдонимы узла); каждый занимает только свободное место, а непонятое слово места
// не занимает. Журнал берёт свою запись либо запись ближайшего предка по имени, чего в ней
// нет — у корня.
//
// Порог коллектора — отдельный слой поверх: он трогает только выход коллектора и только
// сужает — выход получает уровень не подробнее уровня журнала и не подробнее порога. Порог,
// названный журналу, действует на него и на его потомков по имени, общий — на остальных.
//
// Журнал со своим приёмником выходов хаба не получает, что бы ни задал оператор: его строки
// пишет только приёмник, повешенный кодом. Журнал, которому не осталось ни одного выхода,
// получает заглушённый выход консоли: молчит, но настроен.
//
// Параметры:
//  Заданное - Структура - что задал оператор, по источникам; любое поле может отсутствовать:
//   * Программно - Структура - ключи хаба программными детальками (см. ниже).
//   * Окружение - Структура - ключи хаба переменными окружения.
//   * Файл - Структура - ключи хаба файла настроек и Узел — узел logos.logger файла
//            (Соответствие: уровень строкой либо level, appenders, additivity, прочие опции).
//            Поля каждого источника — Написанное (Структура Значение, Откуда, ИмяНастройки,
//            Название): Уровень (уровень корня), Уровни ("Имя=Уровень,…"), Порог (порог
//            коллектора всем логам), Пороги ("Имя=Уровень,…").
//
// Возвращаемое значение:
//  Структура:
//   * Логи - Соответствие - узел "logos.logger".
//   * СпособыВывода - Соответствие - узел "logos.appender".
//   * ПриСтарте - Соответствие - имя лога (корень — rootLogger) → Соответствие:
//     Уровень, Свой (Булево), Откуда, ИмяНастройки, Порог (заданный журналу порог коллектора,
//     "" — не задан), ПорогОткуда, ПорогИмяНастройки, ПорогСвой (Булево — порог назван именно
//     этому журналу), Выходы (Массив логических имён).
//
Функция Связка(Знач Заданное) Экспорт

	СписокЗамечаний = Новый Массив();
	Корень = НоваяЗапись();
	Записи = Новый Соответствие();
	Пороги = Новый Структура("Общий, ПоИменам", Неопределено, Новый Соответствие());

	УровниИсточника(Корень, Записи, Поле(Заданное, "Программно"));
	УровниИсточника(Корень, Записи, Поле(Заданное, "Окружение"));
	УзелФайла(Корень, Записи, Поле(Поле(Заданное, "Файл"), "Узел"));
	УровниИсточника(Корень, Записи, Поле(Заданное, "Файл"));

	ПорогиИсточника(Пороги, Поле(Заданное, "Программно"));
	ПорогиИсточника(Пороги, Поле(Заданное, "Окружение"));
	ПорогиИсточника(Пороги, Поле(Заданное, "Файл"));

	Итог = Новый Структура("Логи, СпособыВывода, ПриСтарте",
		Новый Соответствие(), ОбъявленияВыходов(), Новый Соответствие());

	Для Каждого Имя Из ИменаВУзле(Записи, Пороги) Цикл
		Журнал = ЖурналПоLogos(Имя, Корень, Записи);
		Порог = ПорогЖурнала(Имя, Пороги);
		ЗамечаниеОПорогеБезКоллектора(Имя, Журнал, Порог);
		ПоложитьЛог(Итог, Имя, Журнал, Порог);
	КонецЦикла;

	Для Каждого Имя Из СоСвоимПриёмником Цикл
		ЗамечаниеОЖурналеСоСвоимПриёмником(Имя, Итог);
		ПоложитьЛог(Итог, Имя, ЖурналСоСвоимПриёмником(), Неопределено);
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Что оператору сказать про отвергнутое. Пустой массив — всё понято.
//
// Возвращаемое значение:
//  Массив из Строка - готовые строки предупреждений.
//
Функция Замечания() Экспорт
	Возврат СписокЗамечаний;
КонецФункции

// Логические имена выходов, которые хаб знает: их оператор пишет в appenders узла logos.logger.
//
// Возвращаемое значение:
//  Массив из Строка - console, memory, otel.
//
Функция ИменаВыходов() Экспорт
	Возврат СтрРазделить("console,memory,otel", ",");
КонецФункции

#КонецОбласти

#Область КлючиХаба

Процедура УровниИсточника(Корень, Записи, Знач Источник)

	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УровеньКорня(Корень, Поле(Источник, "Уровень"));
	УровниЛогов(Корень, Записи, Поле(Источник, "Уровни"));

КонецПроцедуры

Процедура ПорогиИсточника(Пороги, Знач Источник)

	Если Источник = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбщийПорог(Пороги, Поле(Источник, "Порог"));
	ПорогиЛогов(Пороги, Поле(Источник, "Пороги"));

КонецПроцедуры

Процедура УровеньКорня(Корень, Знач Написанное)

	Если Написанное = Неопределено ИЛИ Корень.Уровень <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Уровень = Признанный(Написанное.Значение, Написанное.Название);
	Если Уровень <> Неопределено Тогда
		Корень.Уровень = СПроисхождением(Уровень, Написанное);
	КонецЕсли;

КонецПроцедуры

Процедура УровниЛогов(Корень, Записи, Знач Написанное)

	Для Каждого Пара Из Пары(Написанное) Цикл
		Запись = ?(ЭтоКорень(Пара.Имя), Корень, Записи.Получить(Пара.Имя));
		Если Запись <> Неопределено И Запись.Уровень <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Уровень = Признанный(Пара.Слово, Пара.Название);
		Если Уровень <> Неопределено Тогда
			ЗаписьПоИмени(Корень, Записи, Пара.Имя).Уровень = СПроисхождением(Уровень, НаписанноеПары(Пара, Написанное));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбщийПорог(Пороги, Знач Написанное)

	Если Написанное = Неопределено ИЛИ Пороги.Общий <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Порог = Признанный(Написанное.Значение, Написанное.Название);
	Если Порог <> Неопределено Тогда
		Пороги.Общий = СПроисхождением(Порог, Написанное);
	КонецЕсли;

КонецПроцедуры

// Порог корню по имени — тот же общий порог.
Процедура ПорогиЛогов(Пороги, Знач Написанное)

	Для Каждого Пара Из Пары(Написанное) Цикл
		Если ЭтоКорень(Пара.Имя) Тогда
			ОбщийПорог(Пороги, НаписанноеПары(Пара, Написанное));
			Продолжить;
		ИначеЕсли Пороги.ПоИменам.Получить(Пара.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Порог = Признанный(Пара.Слово, Пара.Название);
		Если Порог <> Неопределено Тогда
			Пороги.ПоИменам.Вставить(Пара.Имя, СПроисхождением(Порог, НаписанноеПары(Пара, Написанное)));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Одна пара списка — как отдельно написанное значение: называется ключом и именем журнала.
Функция НаписанноеПары(Знач Пара, Знач Написанное)
	Возврат Новый Структура("Значение, Откуда, ИмяНастройки, Название", Пара.Слово, Написанное.Откуда,
		Написанное.ИмяНастройки, Пара.Название);
КонецФункции

// Пары "Имя=Слово" в порядке написания; не пара — замечание.
Функция Пары(Знач Написанное)

	Результат = Новый Массив();
	Если Написанное = Неопределено ИЛИ НЕ Скаляр(Написанное.Значение) Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Пара Из СтрРазделить(Строка(Написанное.Значение), ",", Ложь) Цикл
		Знак = СтрНайти(Пара, "=");
		Имя = ?(Знак = 0, "", СокрЛП(Лев(Пара, Знак - 1)));
		Если НЕ ЗначениеЗаполнено(Имя) Тогда
			Если ЗначениеЗаполнено(СокрЛП(Пара)) Тогда
				СписокЗамечаний.Добавить(СтрШаблон("%1: ""%2"" не пара ""Имя=Уровень"" — пропущено",
					Написанное.Название, СокрЛП(Пара)));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Имя, Слово, Название", Имя, Сред(Пара, Знак + 1),
			Написанное.Название + "[" + Имя + "]"));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// logos на незнакомом слове падает голой ошибкой без имени настройки и списка допустимых,
// и хаб не поднимается: такое слово места не занимает, а называется оператору.
Функция Признанный(Знач Написанное, Знач Название)

	Уровень = ВРег(СокрЛП(Строка(Написанное)));
	Если НЕ ЗначениеЗаполнено(Уровень) Тогда
		Возврат Неопределено;
	ИначеЕсли СтрРазделить(ДопустимыеУровни(), ",").Найти(Уровень) <> Неопределено Тогда
		Возврат Уровень;
	КонецЕсли;

	СписокЗамечаний.Добавить(СтрШаблон("%1: ""%2"" не уровень журнала — не применено, действует"
		+ " следующий по старшинству источник. Допустимы: %3",
		Название, СокрЛП(Строка(Написанное)), ДопустимыеУровни()));
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область УзелФайла

Процедура УзелФайла(Корень, Записи, Знач Написанное)

	Если Написанное = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Написанное.Значение) <> Тип("Соответствие") Тогда
		СписокЗамечаний.Добавить(СтрШаблон("%1 задан не узлом — не применён", Написанное.Название));
		Возврат;
	КонецЕсли;

	Для Каждого Элемент Из Написанное.Значение Цикл
		Имя = Строка(Элемент.Ключ);
		Запись = ЗаписьПоИмени(Корень, Записи, Имя);
		Где = "logos.logger." + Имя;
		Если ТипЗнч(Элемент.Значение) = Тип("Соответствие") Тогда
			ОпцииУзла(Запись, Элемент.Значение, Где, Написанное);
		ИначеЕсли Скаляр(Элемент.Значение) Тогда
			УровеньУзла(Запись, Элемент.Значение, Где, Написанное);
		Иначе
			СписокЗамечаний.Добавить(СтрШаблон("%1 файла настроек: ожидался уровень либо узел"
				+ " с level и appenders — не применён", Где));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Опции, которых хаб не разбирает (раскладки autumn-logos), переходят в узел как были.
Процедура ОпцииУзла(Запись, Знач Опции, Знач Где, Знач Написанное)

	Добавочно = Добавочность(Опции, Где);
	Для Каждого Опция Из Опции Цикл
		Если НРег(Опция.Ключ) = "level" Тогда
			УровеньУзла(Запись, Опция.Значение, Где + ".level", Написанное);
		ИначеЕсли НРег(Опция.Ключ) = "appenders" Тогда
			Выходы = ВыходыУзла(Опция.Значение, Где + ".appenders");
			Если Выходы <> Неопределено Тогда
				Запись.Выходы = ВыходыСПроисхождением(Выходы, Написанное, Где + ".appenders", Добавочно);
			КонецЕсли;
		ИначеЕсли НРег(Опция.Ключ) <> "additivity" Тогда
			Запись.Прочее.Вставить(Опция.Ключ, Опция.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Место уровня уже могла занять переменная окружения: она сильнее файла.
Процедура УровеньУзла(Запись, Знач Слово, Знач Где, Знач Написанное)

	Если Запись.Уровень <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Уровень = Признанный(Слово, Где + " файла настроек");
	Если Уровень <> Неопределено Тогда
		Запись.Уровень = СПроисхождением(Уровень, Написанное, Где);
	КонецЕсли;

КонецПроцедуры

// additivity по правилу logos: по умолчанию выходы лога добавляются к выходам корня.
Функция Добавочность(Знач Опции, Знач Где)

	Для Каждого Опция Из Опции Цикл
		Если НРег(Опция.Ключ) <> "additivity" Тогда
			Продолжить;
		КонецЕсли;
		Текст = НРег(СокрЛП(Строка(Опция.Значение)));
		Если Опция.Значение = Ложь ИЛИ Текст = "false" Тогда
			Возврат Ложь;
		ИначеЕсли Опция.Значение <> Истина И Текст <> "true" Тогда
			СписокЗамечаний.Добавить(СтрШаблон("%1.additivity файла настроек: ""%2"" не true и не false —"
				+ " выходы лога добавляются к выходам корня", Где, Опция.Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Незнакомое имя выхода снимается с замечанием; список без единого знакомого — как не написан.
Функция ВыходыУзла(Знач Написанное, Знач Где)

	Если ТипЗнч(Написанное) = Тип("Массив") Тогда
		Названные = Написанное;
	ИначеЕсли Скаляр(Написанное) Тогда
		Названные = СтрРазделить(Строка(Написанное), ",", Ложь);
	Иначе
		Названные = Новый Массив();
	КонецЕсли;

	Выходы = Новый Массив();
	Для Каждого Названный Из Названные Цикл
		Имя = НРег(СокрЛП(Строка(Названный)));
		Если НЕ ЗначениеЗаполнено(Имя) ИЛИ Выходы.Найти(Имя) <> Неопределено Тогда
			Продолжить;
		ИначеЕсли ИменаВыходов().Найти(Имя) = Неопределено Тогда
			СписокЗамечаний.Добавить(СтрШаблон("%1 файла настроек: выход ""%2"" хабу не известен —"
				+ " пропущен. Выходы: %3", Где, СокрЛП(Строка(Названный)), СтрСоединить(ИменаВыходов(), ", ")));
			Продолжить;
		КонецЕсли;
		Выходы.Добавить(Имя);
	КонецЦикла;

	Возврат ?(Выходы.Количество() = 0, Неопределено, Выходы);

КонецФункции

#КонецОбласти

#Область ЖурналПоLogos

// Как logos настроила бы журнал без порога: своя запись, иначе запись ближайшего предка
// по имени, иначе корень. Своё — только у журнала, которому запись назначена по имени.
Функция ЖурналПоLogos(Знач Имя, Знач Корень, Знач Записи)

	Если Имя = ИмяКорня() Тогда
		Возврат ЖурналИзЗаписи(Корень, Корень);
	КонецЕсли;

	Своя = Записи.Получить(Имя);
	Если Своя <> Неопределено Тогда
		Возврат ЖурналИзЗаписи(Своя, Корень);
	КонецЕсли;

	Унаследованный = ЖурналИзЗаписи(Корень, Корень);
	Для Каждого Предок Из Предки(Имя) Цикл
		ЗаписьПредка = Записи.Получить(Предок);
		Если ЗаписьПредка <> Неопределено Тогда
			Унаследованный = ЖурналИзЗаписи(ЗаписьПредка, Корень);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Унаследованный.Свой = Ложь;
	Возврат Унаследованный;

КонецФункции

// Чего в записи нет, берётся у корня; выходы записи добавляются к выходам корня, с
// additivity: false — заменяют их. Корень без своих выходов пишет во все выходы процесса,
// без уровня — на INFO.
Функция ЖурналИзЗаписи(Знач Запись, Знач Корень)

	ИсточникУровня = ?(ЗаданоИменно(Запись.Уровень), Запись.Уровень, Корень.Уровень);
	Если НЕ ЗаданоИменно(ИсточникУровня) Тогда
		ИсточникУровня = Неопределено;
	КонецЕсли;

	Журнал = Новый Структура();
	Журнал.Вставить("Уровень", ?(ИсточникУровня = Неопределено, Шкала.УровеньПоУмолчанию(), ИсточникУровня.Значение));
	Журнал.Вставить("ИсточникУровня", ИсточникУровня);
	Журнал.Вставить("Свой", ЗаданоИменно(Запись.Уровень));
	Журнал.Вставить("Выходы", ВыходыПроцесса(ВыходыЗаписи(Запись, Корень)));
	Журнал.Вставить("Прочее", Запись.Прочее);
	Возврат Журнал;

КонецФункции

Функция ВыходыЗаписи(Знач Запись, Знач Корень)

	ВыходыКорня = ?(Корень.Выходы = Неопределено, ИменаВыходов(), Корень.Выходы.Значение);
	Если Запись = Корень ИЛИ Запись.Выходы = Неопределено Тогда
		Возврат КопияМассива(ВыходыКорня);
	ИначеЕсли НЕ Запись.Выходы.Добавочно Тогда
		Возврат КопияМассива(Запись.Выходы.Значение);
	КонецЕсли;

	Выходы = КопияМассива(ВыходыКорня);
	Для Каждого Выход Из Запись.Выходы.Значение Цикл
		Если Выходы.Найти(Выход) = Неопределено Тогда
			Выходы.Добавить(Выход);
		КонецЕсли;
	КонецЦикла;
	Возврат Выходы;

КонецФункции

// Выход, которого у процесса нет (вне сервера — коллектор и память), снимается молча.
Функция ВыходыПроцесса(Знач Названные)

	Выходы = Новый Массив();
	Для Каждого Имя Из ИменаВыходов() Цикл
		Если Названные.Найти(Имя) <> Неопределено И ТипыВыходов.Получить(Имя) <> Неопределено Тогда
			Выходы.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Выходы;

КонецФункции

// DEFAULT — «как у корня»: место оно занимает, но своего значения не несёт.
Функция ЗаданоИменно(Знач Значение)
	Возврат Значение <> Неопределено И Значение.Значение <> Шкала.СловоКакУКорня();
КонецФункции

#КонецОбласти

#Область СвойПриёмник

// Выходов хаба нет, уровень свой: строки пишет только приёмник, который вешает код со своим
// уровнем, — уровень корня до него не доходит, а выход консоли стоит заглушённым.
Функция ЖурналСоСвоимПриёмником()

	Журнал = Новый Структура();
	Журнал.Вставить("Уровень", Шкала.УровеньПоУмолчанию());
	Журнал.Вставить("ИсточникУровня", Неопределено);
	Журнал.Вставить("Свой", Истина);
	Журнал.Вставить("Выходы", Новый Массив());
	Журнал.Вставить("Прочее", Новый Соответствие());
	Возврат Журнал;

КонецФункции

// Что оператор назвал такому журналу — уровень, выходы, порог, — не применяется.
Процедура ЗамечаниеОЖурналеСоСвоимПриёмником(Знач Имя, Знач Итог)

	Если Итог.Логи.Получить(Имя) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СписокЗамечаний.Добавить(СтрШаблон("журнал %1 пишет только в свой приёмник: уровень, выходы и порог"
		+ " коллектора, заданные ему настройками, не применяются", Имя));

КонецПроцедуры

#КонецОбласти

#Область Порог

// Порог, названный самому журналу либо ближайшему предку по имени, иначе общий. DEFAULT
// у названного — «как у всех»: общий порог.
Функция ПорогЖурнала(Знач Имя, Знач Пороги)

	Для Каждого ИмяВЦепочке Из ЦепочкаИмён(Имя) Цикл
		Названный = Пороги.ПоИменам.Получить(ИмяВЦепочке);
		Если Названный = Неопределено Тогда
			Продолжить;
		ИначеЕсли ЗаданоИменно(Названный) Тогда
			Возврат ПорогСПометкойСвой(Названный, ИмяВЦепочке = Имя);
		КонецЕсли;
		Прервать;
	КонецЦикла;

	Если ЗаданоИменно(Пороги.Общий) Тогда
		Возврат ПорогСПометкойСвой(Пороги.Общий, Имя = ИмяКорня());
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Свой — порог назван именно этому журналу, а не достался от предка и не общий.
Функция ПорогСПометкойСвой(Знач Порог, Знач Свой)
	Итог = Новый Структура("Значение, Откуда, ИмяНастройки, Название", Порог.Значение, Порог.Откуда,
		Порог.ИмяНастройки, Порог.Название);
	Итог.Вставить("Свой", Свой);
	Возврат Итог;
КонецФункции

// Сужать можно только то, что есть: порог, названный журналу без коллектора, не действует.
Процедура ЗамечаниеОПорогеБезКоллектора(Знач Имя, Знач Журнал, Знач Порог)

	Если Порог = Неопределено ИЛИ НЕ Порог.Свой ИЛИ Имя = ИмяКорня()
		ИЛИ ТипыВыходов.Получить("otel") = Неопределено ИЛИ Журнал.Выходы.Найти("otel") <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	СписокЗамечаний.Добавить(СтрШаблон("%1 не действует: коллектора у журнала %2 нет — выходы ему"
		+ " назвал узел logos.logger, а порог только сужает; выходы журнала не изменены",
		Порог.Название, Имя));

КонецПроцедуры

// Выход коллектора не подробнее уровня журнала и не подробнее порога: порог выше уровня —
// свой способ вывода с этим уровнем, не выше — способ вывода следует уровню журнала.
Функция СпособВыводаВыхода(Знач Выход, Знач Уровень, Знач Порог)

	Если Выход = "otel" И Шкала.ПорогСужает(Порог, Уровень) Тогда
		Возврат "otel-" + НРег(Порог);
	КонецЕсли;
	Возврат Выход;

КонецФункции

#КонецОбласти

#Область Узлы

// Корень, журналы, названные уровнями и узлом файла, и журналы, названные порогом: последним
// нужна своя запись, чтобы порог не достался их предку.
Функция ИменаВУзле(Знач Записи, Знач Пороги)

	Имена = Новый Массив();
	Имена.Добавить(ИмяКорня());
	Для Каждого Названный Из Записи Цикл
		Имена.Добавить(Названный.Ключ);
	КонецЦикла;
	Для Каждого Названный Из Пороги.ПоИменам Цикл
		Если Записи.Получить(Названный.Ключ) = Неопределено Тогда
			Имена.Добавить(Названный.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;

КонецФункции

// Лог без единого выхода получает заглушённый выход консоли: пустой список logos прочла бы
// как «выходы корня», а без выходов из настроек пульт принял бы лог за созданный до них.
Процедура ПоложитьЛог(Итог, Знач Имя, Знач Журнал, Знач Порог)

	Уровень = Журнал.Уровень;
	ЗначениеПорога = ?(Порог = Неопределено, "", Порог.Значение);

	СпособыВыводаЛога = Новый Массив();
	Для Каждого Выход Из Журнал.Выходы Цикл
		СпособыВыводаЛога.Добавить(СпособВыводаВыхода(Выход, Уровень, ЗначениеПорога));
	КонецЦикла;
	Если СпособыВыводаЛога.Количество() = 0 Тогда
		СпособыВыводаЛога.Добавить(ЗаглушённаяКонсоль());
	КонецЕсли;

	Для Каждого СпособВывода Из СпособыВыводаЛога Цикл
		ОбъявитьВыходСоСвоимУровнем(Итог.СпособыВывода, СпособВывода);
	КонецЦикла;

	Настройка = Новый Соответствие();
	Для Каждого Опция Из Журнал.Прочее Цикл
		Настройка.Вставить(Опция.Ключ, Опция.Значение);
	КонецЦикла;
	Настройка.Вставить("level", Уровень);
	Настройка.Вставить("appenders", СпособыВыводаЛога);
	Если Имя <> ИмяКорня() Тогда
		// список посчитан целиком, с выходами корня: logos не добавит их второй раз
		Настройка.Вставить("additivity", Ложь);
	КонецЕсли;
	Итог.Логи.Вставить(Имя, Настройка);

	Итог.ПриСтарте.Вставить(Имя, СтрокаСтарта(Журнал, Уровень, Порог));

КонецПроцедуры

// Способ вывода «<выход>-<уровень>» — тот же класс выхода со своим уровнем: otel-warn, console-disable.
Процедура ОбъявитьВыходСоСвоимУровнем(СпособыВывода, Знач СпособВывода)

	Если СпособыВывода.Получить(СпособВывода) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Дефис = СтрНайти(СпособВывода, "-");
	Описание = Новый Соответствие();
	Описание.Вставить("type", ТипыВыходов.Получить(Лев(СпособВывода, Дефис - 1)));
	Описание.Вставить("level", ВРег(Сред(СпособВывода, Дефис + 1)));
	СпособыВывода.Вставить(СпособВывода, Описание);

КонецПроцедуры

// Выход консоли на DISABLE: не пишет ничего и гейта журнала не открывает.
Функция ЗаглушённаяКонсоль()
	Возврат "console-disable";
КонецФункции

// level DEFAULT: способ вывода следует уровню своего лога, а не стоит на своём.
Функция ОбъявленияВыходов()

	Узел = Новый Соответствие();
	Для Каждого ТипПоИмени Из ТипыВыходов Цикл
		Описание = Новый Соответствие();
		Описание.Вставить("type", ТипПоИмени.Значение);
		Описание.Вставить("level", "DEFAULT");
		Узел.Вставить(ТипПоИмени.Ключ, Описание);
	КонецЦикла;
	Возврат Узел;

КонецФункции

// Порог в таблице — заданный журналу, даже если при старте он ничего не сужает: пульту он
// нужен, когда уровень журнала поднимут на лету.
Функция СтрокаСтарта(Знач Журнал, Знач Уровень, Знач Порог)

	Строка_ = Новый Соответствие();
	Строка_.Вставить("Уровень", Уровень);
	Строка_.Вставить("Свой", Журнал.Свой);
	Строка_.Вставить("Откуда", Откуда(Журнал.ИсточникУровня));
	Строка_.Вставить("ИмяНастройки", ИмяНастройки(Журнал.ИсточникУровня));
	Строка_.Вставить("Порог", ?(Порог = Неопределено, "", Порог.Значение));
	Строка_.Вставить("ПорогОткуда", Откуда(Порог));
	Строка_.Вставить("ПорогИмяНастройки", ИмяНастройки(Порог));
	Строка_.Вставить("ПорогСвой", Порог <> Неопределено И Порог.Свой);
	Строка_.Вставить("Выходы", КопияМассива(Журнал.Выходы));
	Возврат Строка_;

КонецФункции

Функция Откуда(Знач Источник)
	Возврат ?(Источник = Неопределено, "умолчание", Источник.Откуда);
КонецФункции

Функция ИмяНастройки(Знач Источник)
	Возврат ?(Источник = Неопределено, "", Источник.ИмяНастройки);
КонецФункции

#КонецОбласти

#Область Служебное

Функция ИмяКорня()
	Возврат Шкала.ИмяКорня();
КонецФункции

Функция ЭтоКорень(Знач Имя)
	Возврат НРег(Имя) = НРег(ИмяКорня());
КонецФункции

// DEFAULT — слово настроек «как у предка», а не уровень.
Функция ДопустимыеУровни()
	Возврат Шкала.СловоКакУКорня() + "," + СтрСоединить(Шкала.Уровни(), ",");
КонецФункции

// Предки по имени от ближнего к дальнему: «a.b.c» → «a.b», «a» — так их перебирает logos.
Функция Предки(Знач Имя)

	Итог = Новый Массив();
	Части = СтрРазделить(Имя, ".");
	Пока Части.Количество() > 1 Цикл
		Части.Удалить(Части.ВГраница());
		Итог.Добавить(СтрСоединить(Части, "."));
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Сам журнал и его предки по имени от ближнего к дальнему.
Функция ЦепочкаИмён(Знач Имя)
	Цепочка = Предки(Имя);
	Цепочка.Вставить(0, Имя);
	Возврат Цепочка;
КонецФункции

// Уровень и выходы лога — каждое Неопределено, пока место не занято, иначе значение
// с происхождением (см. СПроисхождением). Прочее — опции узла файла, которых хаб не разбирает.
Функция НоваяЗапись()
	Возврат Новый Структура("Уровень, Выходы, Прочее", Неопределено, Неопределено, Новый Соответствие());
КонецФункции

// Запись корня либо названного журнала; нет её — заводится.
Функция ЗаписьПоИмени(Корень, Записи, Знач Имя)

	Если ЭтоКорень(Имя) Тогда
		Возврат Корень;
	КонецЕсли;

	Запись = Записи.Получить(Имя);
	Если Запись = Неопределено Тогда
		Запись = НоваяЗапись();
		Записи.Вставить(Имя, Запись);
	КонецЕсли;
	Возврат Запись;

КонецФункции

// Значение и откуда оно: источник, имя настройки, которым его задали, и как назвать его
// в замечании.
Функция СПроисхождением(Знач Значение, Знач Написанное, Знач ИмяНастройки = "", Знач Название = "")
	Возврат Новый Структура("Значение, Откуда, ИмяНастройки, Название", Значение, Написанное.Откуда,
		?(ЗначениеЗаполнено(ИмяНастройки), ИмяНастройки, Написанное.ИмяНастройки),
		?(ЗначениеЗаполнено(Название), Название, Написанное.Название));
КонецФункции

// Выходы с происхождением и признаком: добавляются ли они к выходам корня (additivity).
Функция ВыходыСПроисхождением(Знач Выходы, Знач Написанное, Знач ИмяНастройки, Знач Добавочно)
	Итог = СПроисхождением(Выходы, Написанное, ИмяНастройки);
	Итог.Вставить("Добавочно", Добавочно);
	Возврат Итог;
КонецФункции

Функция Поле(Знач Структура_, Знач Имя)
	Значение = Неопределено;
	Если Структура_ <> Неопределено И Структура_.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция КопияМассива(Знач Массив_)
	Копия = Новый Массив();
	Для Каждого Элемент Из Массив_ Цикл
		Копия.Добавить(Элемент);
	КонецЦикла;
	Возврат Копия;
КонецФункции

Функция Скаляр(Знач Значение)
	Возврат Значение <> Неопределено И ТипЗнч(Значение) <> Тип("Соответствие") И ТипЗнч(Значение) <> Тип("Массив");
КонецФункции

#КонецОбласти

// Параметры:
//  _ТипыВыходов - Соответствие - логическое имя выхода (console, memory, otel) → имя класса
//                 способа вывода; выхода, которого нет в перечне, у процесса нет.
//  _СоСвоимПриёмником - Массив из Строка - имена журналов, которые пишут только в приёмник,
//                       повешенный кодом; выходов хаба они не получают.
//
Процедура ПриСозданииОбъекта(Знач _ТипыВыходов, Знач _СоСвоимПриёмником = Неопределено) Экспорт
	ТипыВыходов = _ТипыВыходов;
	СоСвоимПриёмником = ?(_СоСвоимПриёмником = Неопределено, Новый Массив(), _СоСвоимПриёмником);
	СписокЗамечаний = Новый Массив();
	Шкала = Новый ШкалаЖурнала(); // не желудь: связка собирается до контейнера
КонецПроцедуры
