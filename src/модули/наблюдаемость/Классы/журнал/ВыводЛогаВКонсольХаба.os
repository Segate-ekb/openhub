// Консоль хаба: печатает библиотечный ВыводЛогаВКонсоль, а решает уровень своего лога.
//
// Так приходится потому, что logos фильтрует по МИНИМУМУ из уровня лога и уровня способа
// вывода: способ вывода на INFO обрезал бы точечный DEBUG компонента, а способ вывода
// на DEBUG открыл бы отладку всем логам сразу. Способы вывода объявлены самыми подробными,
// а уровень своего лога каждая строка проходит здесь.

Перем Консоль;  // ВыводЛогаВКонсоль (logos) — сама печать
Перем Уровни;   // УровниЖурнала (наблюдаемость) — правило отбора по уровню своего лога

#Область ПубличныйИнтерфейс

// Печатает событие журнала. Контракт способа вывода logos.
//
// Параметры:
//  СобытиеЛога - СобытиеЛога - событие библиотеки logos.
//
Процедура ВывестиСобытие(Знач СобытиеЛога) Экспорт

	Если Уровни.СтрокаПроходит(СобытиеЛога) Тогда
		Консоль.ВывестиСобытие(СобытиеЛога);
	КонецЕсли;

КонецПроцедуры

// Закрывает способ вывода. Контракт logos.
//
Процедура Закрыть() Экспорт
	Консоль.Закрыть();
КонецПроцедуры

// Принимает свойство из настроек logos. Контракт logos; своих свойств у консоли нет.
//
// Параметры:
//  ИмяСвойства - Строка - имя свойства из logos.appender.
//  Значение - Произвольный - значение свойства.
//
Процедура УстановитьСвойство(Знач ИмяСвойства, Знач Значение) Экспорт
	Консоль.УстановитьСвойство(ИмяСвойства, Значение);
КонецПроцедуры

#КонецОбласти

&Прозвище("ВыводЛогаВКонсольХаба")
&Желудь
Процедура ПриСозданииОбъекта()
	Консоль = Новый ВыводЛогаВКонсоль();
	Уровни = Новый УровниЖурнала();
КонецПроцедуры
