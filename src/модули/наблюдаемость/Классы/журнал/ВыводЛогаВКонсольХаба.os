// Консоль хаба: печатает библиотечный ВыводЛогаВКонсоль, строку пропускает уровень её собственного
// лога, а на печать она уходит через ОбезличиваниеЖурнала.Событие.

Перем Печать;   // ВыводЛогаВКонсоль (logos) — сама печать
Перем Уровни;   // УровниЖурнала (наблюдаемость) — правило отбора по уровню своего лога
Перем Обезличивание; // ОбезличиваниеЖурнала (наблюдаемость) — дверь выхода строки

#Область ПубличныйИнтерфейс

// Печатает событие журнала. Контракт способа вывода logos.
//
// Параметры:
//  СобытиеЛога - СобытиеЛога - событие библиотеки logos.
//
Процедура ВывестиСобытие(Знач СобытиеЛога) Экспорт

	Если Уровни.СтрокаПроходит(СобытиеЛога) Тогда
		Печать.ВывестиСобытие(Обезличивание.Событие(СобытиеЛога));
	КонецЕсли;

КонецПроцедуры

// Закрывает способ вывода. Контракт logos.
//
Процедура Закрыть() Экспорт
	Печать.Закрыть();
КонецПроцедуры

// Принимает свойство из настроек logos. Контракт logos; своих свойств у консоли нет.
//
// Параметры:
//  ИмяСвойства - Строка - имя свойства из logos.appender.
//  Значение - Произвольный - значение свойства.
//
Процедура УстановитьСвойство(Знач ИмяСвойства, Знач Значение) Экспорт
	Печать.УстановитьСвойство(ИмяСвойства, Значение);
КонецПроцедуры

#КонецОбласти

&Прозвище("ВыводЛогаВКонсольХаба")
&Желудь
Процедура ПриСозданииОбъекта()
	Печать = Новый ВыводЛогаВКонсоль();
	Уровни = Новый УровниЖурнала();
	Обезличивание = Новый ОбезличиваниеЖурнала();
КонецПроцедуры
