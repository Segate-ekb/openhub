// Коллектор хаба: строку журнала отдаёт библиотечный мост ОтелАппендерLogos, но уже
// прошедшую дверь ОбезличиваниеЖурнала.Событие — та же строка, что видит консоль; строку
// журнала со своим приёмником не отдаёт, как и консоль.

Перем Мост;          // ОтелАппендерLogos (opentelemetry) — сама отправка в коллектор
Перем Обезличивание; // ОбезличиваниеЖурнала (наблюдаемость) — дверь выхода строки
Перем Уровни;        // УровниЖурнала (наблюдаемость) — правило «журнал со своим приёмником»
Перем СвоиПриёмники; // Массив из Строка — журналы, чьи строки уходят в свой приёмник, а не сюда

#Область ПубличныйИнтерфейс

// Отдаёт событие журнала мосту OTel. Контракт способа вывода logos.
//
// Параметры:
//  СобытиеЛога - СобытиеЛога - событие библиотеки logos.
//
Процедура ВывестиСобытие(Знач СобытиеЛога) Экспорт
	Если НЕ Уровни.УСвоегоПриёмника(СобытиеЛога, СвоиПриёмники) Тогда
		Мост.ВывестиСобытие(Обезличивание.Событие(СобытиеЛога));
	КонецЕсли;
КонецПроцедуры

// Закрывает способ вывода. Контракт logos.
//
Процедура Закрыть() Экспорт
	Мост.Закрыть();
КонецПроцедуры

// Принимает свойство из настроек logos. Контракт logos; своё свойство у вывода одно —
// журналы со своим приёмником, остальные уходят мосту.
//
// Параметры:
//  ИмяСвойства - Строка - имя свойства из logos.appender.
//  Значение - Произвольный - значение свойства.
//
Процедура УстановитьСвойство(Знач ИмяСвойства, Знач Значение) Экспорт
	Если ИмяСвойства = Уровни.СвойствоСвоихПриёмников() Тогда
		СвоиПриёмники = Уровни.ЖурналыСоСвоимПриёмником(Значение);
		Возврат;
	КонецЕсли;
	Мост.УстановитьСвойство(ИмяСвойства, Значение);
КонецПроцедуры

#КонецОбласти

&Прозвище("ВыводЛогаВOTelХаба")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ОтелАппендерLogos") _Мост = Неопределено)
	// без моста экземпляр создан самой logos до контейнера и молчит, пока его не заменит желудь
	Мост = ?(_Мост = Неопределено, Новый ОтелАппендерLogos(), _Мост);
	Обезличивание = Новый ОбезличиваниеЖурнала();
	Уровни = Новый УровниЖурнала();
	СвоиПриёмники = Новый Массив();
КонецПроцедуры
