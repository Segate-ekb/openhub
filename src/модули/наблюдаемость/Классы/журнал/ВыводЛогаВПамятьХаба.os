// Память хаба: строку журнала кладёт в ПамятьЖурнала, но уже прошедшую дверь
// ОбезличиваниеЖурнала.Событие — та же строка, что видят консоль и коллектор.

#Использовать opentelemetry

Перем Память;        // ПамятьЖурнала (наблюдаемость) — хвост и темп журнала
Перем Обезличивание; // ОбезличиваниеЖурнала (наблюдаемость) — дверь выхода строки

#Область ПубличныйИнтерфейс

// Кладёт событие журнала в память. Контракт способа вывода logos.
//
// Параметры:
//  СобытиеЛога - СобытиеЛога - событие библиотеки logos.
//
Процедура ВывестиСобытие(Знач СобытиеЛога) Экспорт

	// экземпляр, созданный самой logos по имени типа до сборки контейнера, молчит
	Если Память = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Выход = Обезличивание.Событие(СобытиеЛога);
	Память.Записать(Выход.ПолучитьВремяСобытия(), Выход.ПолучитьУровень(), Выход.ПолучитьИмяЛога(),
		Выход.ПолучитьСообщение(), ТекущаяТрасса());

КонецПроцедуры

// Закрывает способ вывода. Контракт logos; закрывать нечего — память общая.
//
Процедура Закрыть() Экспорт
КонецПроцедуры

// Принимает свойство из настроек logos. Контракт logos; своих свойств у вывода нет.
//
// Параметры:
//  ИмяСвойства - Строка - имя свойства из logos.appender.
//  Значение - Произвольный - значение свойства.
//
Процедура УстановитьСвойство(Знач ИмяСвойства, Знач Значение) Экспорт
КонецПроцедуры

#КонецОбласти

// Трасса операции потока; пусто — строка вне трассы, и сбой чтения контекста строку не роняет.
Функция ТекущаяТрасса()

	Попытка
		Спан = ОтелКонтекст.ТекущийСпан();
		Если Спан = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Контекст = Спан.КонтекстСпана();
		Возврат ?(Контекст.Валиден(), Контекст.ИдТрассировки(), "");
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

&Прозвище("ВыводЛогаВПамятьХаба")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ПамятьЖурнала") _Память = Неопределено)
	Память = _Память;
	Обезличивание = Новый ОбезличиваниеЖурнала();
КонецПроцедуры
