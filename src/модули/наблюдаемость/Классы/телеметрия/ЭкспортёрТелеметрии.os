// Фоновый цикл: периодически просит фасад Телеметрия отправить партию спанов из буфера
// OTLP-коллектору. Реальная сеть — здесь, в фоне; горячий путь только наполняет буфер.
// При выключенном OTel цикл не запускается. В autumn/winow нет хука завершения
// приложения, поэтому в бою цикл живёт до остановки процесса.

Перем Телеметрия;
Перем ИнтервалСек;
Перем ОстановкаЗапрошена;
Перем Числа;         // ПриведениеЧисел (основа)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Крутит фоновый цикл экспорта спанов до запроса остановки.
// При выключенном OTel цикл не запускается.
//
Процедура ПриЗапускеПриложения() Экспорт
	// Перехват на всю рогатку, а не только на тело цикла: фоновую рогатку
	// с ОжидатьЗавершения = Ложь ОСень не дожидается и её исход не смотрит.
	Попытка
		Если НЕ Телеметрия.Включена() Тогда
			Лог.Информация("Экспортёр OTel не запущен (oshub.otel.enabled=false)");
			Возврат;
		КонецЕсли;
		Лог.Информация("Экспортёр OTel запущен: выгрузка спанов каждые %1с", ИнтервалСек);
		Пока НЕ ОстановкаЗапрошена Цикл
			ШагЦикла();
			Приостановить(ИнтервалСек * 1000);
		КонецЦикла;
	Исключение
		Лог.Ошибка("Фоновый цикл экспортёра OTel прерван, трассы больше не выгружаются: %1",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

// Просит фоновый цикл экспорта завершиться после текущего шага.
//
Процедура Остановить() Экспорт
	ОстановкаЗапрошена = Истина;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сбой экспорта партии не роняет фоновое задание.
Процедура ШагЦикла()
	Попытка
		Лог.Отладка("Экспортёр OTel: выгружаем партию спанов");
		Телеметрия.ЭкспортироватьПартию();
	Исключение
		Лог.Ошибка("Сбой шага экспортёра OTel (изолирован, цикл продолжается): %1",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

&Рогатка(ЗапускатьВФоне = Истина, ОжидатьЗавершения = Ложь)
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Телеметрия") НоваяТелеметрия,
	&Деталька(Значение = "oshub.otel.export_interval_sec", ЗначениеПоУмолчанию = 5) _Интервал = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа = Неопределено)
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Телеметрия = НоваяТелеметрия;
	Числа = ?(_Числа = Неопределено, Новый ПриведениеЧисел(), _Числа);
	ИнтервалСек = Макс(1, Числа.ЧислоИлиДефолт(_Интервал, 5));
	ОстановкаЗапрошена = Ложь;
КонецПроцедуры
