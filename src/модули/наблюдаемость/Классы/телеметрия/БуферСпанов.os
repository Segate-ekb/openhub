// Ограниченная потокобезопасная очередь завершённых спанов: развязка горячего пути
// (ПроцессорСпановХаба наполняет) и фонового экспорта (ЭкспортёрТелеметрии сливает).
// При переполнении дропается старейший спан — защита от OOM при недоступном коллекторе.
//
// Лог приходит параметром конструктора: буфер создаётся не только контейнером,
// и предупреждение о переполнении обязано работать и там.
Перем Очередь;    // Массив из ОтелСпан
Перем Блокировка; // БлокировкаРесурса
Перем МаксРазмер;
Перем Числа;      // ПриведениеЧисел (основа)
Перем Лог;

#Область ПубличныйИнтерфейс

// Кладёт завершённый спан в очередь. При достижении лимита отбрасывает старейшие
// спаны и пишет предупреждение в лог.
//
// Параметры:
//  Спан - ОтелСпан - завершённый спан.
//
Процедура Добавить(Знач Спан) Экспорт
	Блокировка.Заблокировать();
	Попытка
		Переполнено = Ложь;
		Пока Очередь.Количество() >= МаксРазмер Цикл
			Очередь.Удалить(0); // старейший
			Переполнено = Истина;
		КонецЦикла;
		Очередь.Добавить(Спан);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();
	Если Переполнено Тогда
		Лог.Предупреждение("Буфер спанов переполнен (лимит %1) — старейшие спаны отброшены", МаксРазмер);
	КонецЕсли;
КонецПроцедуры

// Атомарно забирает всю очередь, оставляя её пустой.
//
// Возвращаемое значение:
//  Массив - забранная партия спанов; может быть пустой.
//
Функция ЗабратьВсе() Экспорт
	Блокировка.Заблокировать();
	Попытка
		Партия = Очередь;
		Очередь = Новый Массив();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();
	Лог.Отладка("Буфер спанов: забрано %1 спанов при лимите очереди %2",
		Партия.Количество(), МаксРазмер);
	Возврат Партия;
КонецФункции

// Текущее число спанов в очереди.
//
// Возвращаемое значение:
//  Число - размер очереди.
//
Функция Размер() Экспорт
	Блокировка.Заблокировать();
	Попытка
		Результат = Очередь.Количество();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

#КонецОбласти

&Прозвище("БуферСпановТелеметрии")
&Желудь
Процедура ПриСозданииОбъекта(
	&Деталька(Значение = "oshub.otel.max_queue", ЗначениеПоУмолчанию = 2048) _МаксРазмер = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа = Неопределено)
	Числа = ?(_Числа = Неопределено, Новый ПриведениеЧисел(), _Числа);
	МаксРазмер = Макс(1, Числа.ЧислоИлиДефолт(_МаксРазмер, 2048));
	Очередь = Новый Массив();
	Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "БуферСпанов создан без лога — контейнер или создатель обязан его передать";
	КонецЕсли;
	Лог = _Лог;
КонецПроцедуры
