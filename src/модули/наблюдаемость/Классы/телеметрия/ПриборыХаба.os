// Доменные приборы хаба. Наблюдаемые датчики снимают числа хаба раз в интервал экспорта
// теми же глазами, что и /api/v1/metrics: датчик спрашивает значение сам, поэтому на
// горячем пути хаба этих чисел нет вовсе. Счётчики событий растут на шине: скачивание,
// публикация, отзыв и приезд версии зеркалом приходят к ним доменным событием.

#Использовать opentelemetry

Перем ТабакеркаSdk;      // Табакерка ОтелSdk
Перем ТабакеркаЧисел;    // Табакерка ЧислаХаба (наблюдаемость)
Перем ТабакеркаГейта;    // Табакерка ГейтВходаПоСтране (вход) — сколько посетителей отбито
Перем ТабакеркаЗаданий;  // Табакерка РеестрЗаданийПлатформы (фоновыеЗадания)
Перем ТабакеркаИздателя; // Табакерка ИздательСобытий (события)
Перем ТелеметрияВключена;         // otel.enabled
Перем Датчики;           // ссылки на приборы: без них наблюдателя некому опрашивать
Перем Счётчики;          // тип события -> Структура(Прибор, Действие)
Перем Лог;
Перем Ошибки;            // ТекстОшибки (основа)

#Область ПубличныйИнтерфейс

// Заводит приборы хаба и подписывает счётчики на шину событий. Отказ телеметрии старт
// не отменяет.
//
Процедура ПриЗапускеПриложения() Экспорт

	Если НЕ ТелеметрияВключена Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Метр = ТабакеркаSdk.Достать().ПолучитьМетр("openhub");
		ЗавестиЧислаХаба(Метр);
		ЗавестиОтказыПоСтране(Метр);
		ЗавестиРеестрЗаданий(Метр);
		ЗавестиСчётчикиСобытий(Метр);
		Лог.Информация("OTel: приборы хаба заведены — датчиков %1, событий под счётом %2",
			Датчики.Количество(), Счётчики.Количество());
	Исключение
		Лог.Ошибка("OTel: приборы хаба не заведены: %1",
			Ошибки.Причина(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Обратный вызов приборов: все числа хаба одним снимком.
//
// Параметры:
//  Наблюдения - Соответствие - имя прибора -> ОтелНаблюдениеМетрики.
//
Процедура СнятьЧислаХаба(Наблюдения) Экспорт

	Числа = ТабакеркаЧисел.Достать();
	Снимок = Числа.Снимок();

	ЗаписатьПосчитанное(Наблюдения[ИмяПрибораПулов()], Числа, Снимок.Пулы);
	ЗаписатьПосчитанное(Наблюдения[ИмяПрибораПакетов()], Числа, Снимок.Пакеты);
	ЗаписатьПосчитанное(Наблюдения[ИмяПрибораВерсий()], Числа, Снимок.Версии);
	ЗаписатьПосчитанное(Наблюдения[ИмяПрибораПользователей()], Числа, Снимок.Пользователи);
	ЗаписатьПосчитанное(Наблюдения[ИмяСкачиванийЗаВсёВремя()], Числа, Снимок.Скачивания);
	ЗаписатьПосчитанное(Наблюдения[ИмяПрибораОчередиВебхуков()], Числа, Снимок.ОчередьВебхуков);
	ЗаписатьПосчитанное(Наблюдения[ИмяПрибораОчередиЗеркал()], Числа, Снимок.ОчередьЗеркал);
	ЗаписатьПосчитанное(Наблюдения[ИмяПрибораПропущенныхСобытий()], Числа,
		Снимок.ПропущенныеСобытия);
	ЗаписатьЗанятоеПулами(Наблюдения[ИмяПрибораЗанятого()], Числа, Снимок.МестоПоПулам);

КонецПроцедуры

// Обратный вызов прибора отказов: сколько посетителей гейт отбил правилом по стране
// за жизнь процесса. Счётчик накопительный — дельту считает SDK.
//
// Параметры:
//  Наблюдения - Соответствие - имя прибора -> ОтелНаблюдениеМетрики.
//
Процедура СнятьОтказыПоСтране(Наблюдения) Экспорт

	Наблюдение = Наблюдения[ИмяПрибораОтказовПоСтране()];
	Если Наблюдение <> Неопределено Тогда
		Наблюдение.Записать(ТабакеркаГейта.Достать().Отказов());
	КонецЕсли;

КонецПроцедуры

// Обратный вызов прибора заданий: сколько записей о фоновых заданиях держит реестр
// платформы прямо сейчас. Число спрашивается у реестра на каждый срез.
//
// Параметры:
//  Наблюдения - Соответствие - имя прибора -> ОтелНаблюдениеМетрики.
//
Процедура СнятьРазмерРеестраЗаданий(Наблюдения) Экспорт

	Наблюдение = Наблюдения[ИмяПрибораЗаданий()];
	Если Наблюдение <> Неопределено Тогда
		Наблюдение.Записать(ТабакеркаЗаданий.Достать().Размер());
	КонецЕсли;

КонецПроцедуры

// Реагирует на доменное событие — контракт подписчика ИздателяСобытий. Событие под счётом
// прибавляет единицу своему счётчику, прочие типы игнорируются.
//
// Параметры:
//  Событие - Структура - Тип (Строка), Данные (Структура), Когда (Дата, UTC).
//
Процедура ОбработатьСобытие(Знач Событие) Экспорт

	Учёт = Счётчики.Получить(Событие.Тип);
	Если Учёт = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Учёт.Прибор.Добавить(1, АтрибутыСобытия(Событие.Данные, Учёт.Действие));
	Исключение
		// сбой прибора не имеет права отнять событие у остальных подписчиков, но и молчать
		// о нём нельзя: счётчик, который не растёт, выглядит как затихший хаб
		Лог.Предупреждение("OTel: событие ""%1"" прибором не сосчитано: %2",
			Событие.Тип, Ошибки.Причина(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ЗаводПриборов

// Один обратный вызов на все числа хаба: иначе они уезжали бы из разных мгновений,
// а снимок собирался бы заново на каждый прибор.
Процедура ЗавестиЧислаХаба(Знач Метр)

	Свои = Новый Массив();
	Свои.Добавить(Метр.СоздатьНаблюдаемыйДатчик(ИмяПрибораПулов(),
		, "Публичные пулы реестра", "{pool}"));
	Свои.Добавить(Метр.СоздатьНаблюдаемыйДатчик(ИмяПрибораПакетов(),
		, "Публичные пакеты реестра", "{package}"));
	Свои.Добавить(Метр.СоздатьНаблюдаемыйДатчик(ИмяПрибораВерсий(),
		, "Версии пакетов в реестре", "{version}"));
	Свои.Добавить(Метр.СоздатьНаблюдаемыйДатчик(ИмяПрибораПользователей(),
		, "Пользователи хаба", "{user}"));
	Свои.Добавить(Метр.СоздатьНаблюдаемыйСчетчик(ИмяСкачиванийЗаВсёВремя(),
		, "Скачивания артефактов за всё время", "{download}"));
	Свои.Добавить(Метр.СоздатьНаблюдаемыйДатчик(ИмяПрибораЗанятого(),
		, "Занятое пулом место в хранилище", "By"));
	Свои.Добавить(Метр.СоздатьНаблюдаемыйДатчик(ИмяПрибораОчередиВебхуков(),
		, "Задания в очереди доставки подписок", "{task}"));
	Свои.Добавить(Метр.СоздатьНаблюдаемыйДатчик(ИмяПрибораОчередиЗеркал(),
		, "Заявки в очереди обходов зеркал", "{request}"));
	Свои.Добавить(Метр.СоздатьНаблюдаемыйСчетчик(ИмяПрибораПропущенныхСобытий(),
		, "Доставки событий, уроненные подписчиками", "{event}"));

	Метр.ЗарегистрироватьОбратныйВызов(
		Новый Действие(ЭтотОбъект, "СнятьЧислаХаба"), Свои);
	Запомнить(Свои);

КонецПроцедуры

// У отказов свой обратный вызов: реестр и вход опрашиваются по разным поводам, и один
// срез на двоих связал бы их в единое мгновение без всякой на то причины.
Процедура ЗавестиОтказыПоСтране(Знач Метр)

	Свои = Новый Массив();
	Свои.Добавить(Метр.СоздатьНаблюдаемыйСчетчик(ИмяПрибораОтказовПоСтране(),
		, "Посетители, отбитые правилом по стране", "{denial}"));

	Метр.ЗарегистрироватьОбратныйВызов(
		Новый Действие(ЭтотОбъект, "СнятьОтказыПоСтране"), Свои);
	Запомнить(Свои);

КонецПроцедуры

// У заданий свой обратный вызов: их число живёт в памяти процесса и к мгновению,
// которым сняты числа хаба, отношения не имеет.
Процедура ЗавестиРеестрЗаданий(Знач Метр)

	Свои = Новый Массив();
	Свои.Добавить(Метр.СоздатьНаблюдаемыйДатчик(ИмяПрибораЗаданий(),
		, "Записи в реестре фоновых заданий платформы", "{job}"));

	Метр.ЗарегистрироватьОбратныйВызов(
		Новый Действие(ЭтотОбъект, "СнятьРазмерРеестраЗаданий"), Свои);
	Запомнить(Свои);

КонецПроцедуры

// Работа хаба считается там, где о ней объявляют, — на шине событий. Отзыв и возврат
// версии считает ОДИН прибор: это две стороны одного действия, и различает их атрибут.
Процедура ЗавестиСчётчикиСобытий(Знач Метр)

	Издатель = ТабакеркаИздателя.Достать();

	Считать(Издатель.ТипСкачиваниеЗафиксировано(), Метр.СоздатьСчетчик(
		ИмяСчётчикаСкачиваний(), "Отданные тела артефактов", "{download}"));
	Считать(Издатель.ТипВерсияОпубликована(), Метр.СоздатьСчетчик(
		ИмяСчётчикаПубликаций(), "Принятые публикации версий", "{publication}"));
	Считать(Издатель.ТипВерсияЗеркалирована(), Метр.СоздатьСчетчик(
		ИмяСчётчикаЗеркалирования(), "Версии, приехавшие зеркалом", "{version}"));

	СменаСостояния = Метр.СоздатьСчетчик(ИмяСчётчикаСменСостояния(),
		"Отзывы версий и возвраты из отзыва", "{change}");
	Считать(Издатель.ТипВерсияОтозвана(), СменаСостояния, ДействиеОтзыва());
	Считать(Издатель.ТипВерсияВосстановлена(), СменаСостояния, ДействиеВозврата());

	Для Каждого КиЗ Из Счётчики Цикл
		Издатель.Подписать(КиЗ.Ключ, ЭтотОбъект);
	КонецЦикла;

КонецПроцедуры

Процедура Считать(Знач ТипСобытия, Знач Прибор, Знач Действие = "")
	Счётчики.Вставить(ТипСобытия, Новый Структура("Прибор, Действие", Прибор, Действие));
КонецПроцедуры

// Список приборов у каждой регистрации свой: SDK держит переданный массив ссылкой,
// и прибор, дописанный в общий список позже, уехал бы ещё и в чужой обратный вызов.
Процедура Запомнить(Знач Приборы)

	Для Каждого Прибор Из Приборы Цикл
		Датчики.Добавить(Прибор);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ЗаписьСреза

// Сорванный подсчёт остаётся без наблюдения: отрицательное число на графике «пулов
// в реестре» врало бы убедительнее, чем разрыв в ряду.
Процедура ЗаписатьПосчитанное(Наблюдение, Знач Числа, Знач Значение)

	Если Наблюдение <> Неопределено И Числа.Посчитано(Значение) Тогда
		Наблюдение.Записать(Значение);
	КонецЕсли;

КонецПроцедуры

// У места в хранилище точка данных на каждый пул: оператору нужно не только «сколько
// занято», но и «кем».
Процедура ЗаписатьЗанятоеПулами(Наблюдение, Знач Числа, Знач ПоПулам)

	Если Наблюдение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Пул Из ПоПулам Цикл
		Если Числа.Посчитано(Пул.Байт) Тогда
			Наблюдение.Записать(Пул.Байт, АтрибутыПула(Пул.Имя));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Имя пула кладётся событию, которое его несёт: имена пакетов и версий в метрики
// не идут вовсе — их кардинальность не ограничена ничем.
Функция АтрибутыСобытия(Знач Данные, Знач Действие)

	Перем ИмяПула;

	Атрибуты = Новый ОтелАтрибуты();

	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("ИмяПула", ИмяПула)
		И ЗначениеЗаполнено(ИмяПула) Тогда
		Атрибуты.Установить(КлючПула(), Строка(ИмяПула));
	КонецЕсли;

	Если ЗначениеЗаполнено(Действие) Тогда
		Атрибуты.Установить(КлючДействия(), Действие);
	КонецЕсли;

	Возврат Атрибуты;

КонецФункции

Функция АтрибутыПула(Знач ИмяПула)

	Атрибуты = Новый ОтелАтрибуты();
	Атрибуты.Установить(КлючПула(), Строка(ИмяПула));

	Возврат Атрибуты;

КонецФункции

#КонецОбласти

#Область ИменаПриборов

Функция ИмяПрибораПулов()
	Возврат "oshub.pools";
КонецФункции

Функция ИмяПрибораПакетов()
	Возврат "oshub.packages";
КонецФункции

Функция ИмяПрибораВерсий()
	Возврат "oshub.versions";
КонецФункции

Функция ИмяПрибораПользователей()
	Возврат "oshub.users";
КонецФункции

// Скачивания за всё время: база плюс ещё не слитое из памяти. Имя отличается от счётчика
// событий намеренно — в Prometheus оба приезжают с суффиксом _total, и «oshub.downloads.total»
// столкнулся бы с ним именем.
Функция ИмяСкачиванийЗаВсёВремя()
	Возврат "oshub.downloads.all_time";
КонецФункции

Функция ИмяПрибораЗанятого()
	Возврат "oshub.storage.used_bytes";
КонецФункции

Функция ИмяПрибораОчередиВебхуков()
	Возврат "oshub.webhooks.queue";
КонецФункции

Функция ИмяПрибораОчередиЗеркал()
	Возврат "oshub.mirror.queue";
КонецФункции

Функция ИмяПрибораПропущенныхСобытий()
	Возврат "oshub.events.dropped";
КонецФункции

Функция ИмяПрибораОтказовПоСтране()
	Возврат "oshub.login.geo_denied";
КонецФункции

Функция ИмяПрибораЗаданий()
	Возврат "oshub.background_jobs";
КонецФункции

Функция ИмяСчётчикаСкачиваний()
	Возврат "oshub.downloads";
КонецФункции

Функция ИмяСчётчикаПубликаций()
	Возврат "oshub.publications";
КонецФункции

Функция ИмяСчётчикаСменСостояния()
	Возврат "oshub.versions.state_changes";
КонецФункции

Функция ИмяСчётчикаЗеркалирования()
	Возврат "oshub.mirror.versions";
КонецФункции

Функция КлючПула()
	Возврат "oshub.pool";
КонецФункции

Функция КлючДействия()
	Возврат "oshub.version.action";
КонецФункции

Функция ДействиеОтзыва()
	Возврат "yanked";
КонецФункции

Функция ДействиеВозврата()
	Возврат "restored";
КонецФункции

#КонецОбласти

&Прозвище("ПриборыХаба")
&Рогатка(ЗапускатьВФоне = Ложь)
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ОтелSdk") _ТабакеркаSdk,
	&Табакерка &Пластилин(Значение = "ЧислаХаба") _ТабакеркаЧисел,
	&Табакерка &Пластилин(Значение = "ГейтВходаПоСтране") _ТабакеркаГейта,
	&Деталька(Значение = "otel.enabled", ЗначениеПоУмолчанию = Ложь) _Включено = Ложь,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Пластилин(Значение = "ПриведениеФлагов") _Флаги = Неопределено,
	&Табакерка &Пластилин(Значение = "РеестрЗаданийПлатформы") _ТабакеркаЗаданий,
	&Табакерка &Пластилин(Значение = "ИздательСобытий") _ТабакеркаИздателя)

	ТабакеркаSdk = _ТабакеркаSdk;
	ТабакеркаЧисел = _ТабакеркаЧисел;
	ТабакеркаГейта = _ТабакеркаГейта;
	ТабакеркаЗаданий = _ТабакеркаЗаданий;
	ТабакеркаИздателя = _ТабакеркаИздателя;
	Датчики = Новый Массив();
	Счётчики = Новый Соответствие();
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Приведение = ?(_Флаги = Неопределено, Новый ПриведениеФлагов(), _Флаги);
	ТелеметрияВключена = Приведение.ФлагТолькоTrue(_Включено);

	Если _Лог = Неопределено Тогда
		ВызватьИсключение "ПриборыХаба созданы без лога — контейнер обязан прилепить &Лог";
	КонецЕсли;
	Лог = _Лог;

КонецПроцедуры
