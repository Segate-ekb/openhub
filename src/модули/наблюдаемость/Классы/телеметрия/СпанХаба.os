// Тонкая fail-safe обёртка над спаном OTel: при выключенном OTel методы дёшево ничего
// не делают, а любой вызов SDK обёрнут Попыткой — сбой телеметрии ничего не роняет.

Перем РеальныйСпан; // ОтелСпан или Неопределено (no-op)
Перем ОбластьКонтекста; // область «сделать текущим» либо Неопределено
Перем КодОшибки; // значение ОтелКодСтатуса.Ошибка() либо Неопределено
Перем КодОк; // значение ОтелКодСтатуса.Ок() либо Неопределено

#Область ПубличныйИнтерфейс

// Устанавливает атрибут спана. Атрибуты уходят в коллектор — секреты и PII писать
// сюда нельзя. На no-op обёртке ничего не делает.
//
// Параметры:
//  Ключ - Строка - имя атрибута по семантическим конвенциям OTel.
//  Значение - Строка, Число, Булево - значение атрибута.
//
// Возвращаемое значение:
//  СпанХаба - ЭтотОбъект для цепочки вызовов.
//
Функция УстановитьАтрибут(Знач Ключ, Знач Значение) Экспорт
	Если РеальныйСпан <> Неопределено Тогда
		Попытка
			РеальныйСпан.УстановитьАтрибут(Ключ, Значение);
		Исключение
			// изоляция
		КонецПопытки;
	КонецЕсли;
	Возврат ЭтотОбъект;
КонецФункции

// Помечает спан статусом Error. На no-op обёртке ничего не делает.
//
// Параметры:
//  Сообщение - Строка - краткое сообщение без стектрейса и секретов
//              (необязательный, по умолчанию пустая строка).
//
Процедура Ошибка(Знач Сообщение = "") Экспорт
	Если РеальныйСпан <> Неопределено И КодОшибки <> Неопределено Тогда
		Попытка
			РеальныйСпан.УстановитьСтатус(КодОшибки, Строка(Сообщение));
		Исключение
			// изоляция
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Помечает спан статусом Ok. Вызывать необязательно: по умолчанию статус Unset.
//
Процедура Ок() Экспорт
	Если РеальныйСпан <> Неопределено И КодОк <> Неопределено Тогда
		Попытка
			РеальныйСпан.УстановитьСтатус(КодОк);
		Исключение
			// изоляция
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Завершает спан: закрывает область «сделать текущим», если она создавалась,
// и фиксирует спан. Безопасна к повторному вызову и к no-op обёртке.
//
Процедура Завершить() Экспорт
	Если ОбластьКонтекста <> Неопределено Тогда
		Попытка
			ОбластьКонтекста.Закрыть();
		Исключение
			// изоляция
		КонецПопытки;
		ОбластьКонтекста = Неопределено;
	КонецЕсли;
	Если РеальныйСпан <> Неопределено Тогда
		Попытка
			РеальныйСпан.Завершить();
		Исключение
			// изоляция
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Несёт ли обёртка реальный спан.
//
// Возвращаемое значение:
//  Булево - Ложь для no-op обёртки при выключенном OTel.
//
Функция Активен() Экспорт
	Возврат РеальныйСпан <> Неопределено;
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач Спан = Неопределено, Знач Область = Неопределено,
	Знач НовыйКодОшибки = Неопределено, Знач НовыйКодОк = Неопределено)
	РеальныйСпан = Спан;
	ОбластьКонтекста = Область;
	КодОшибки = НовыйКодОшибки;
	КодОк = НовыйКодОк;
КонецПроцедуры
