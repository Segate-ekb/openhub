// Фасад наблюдаемости хаба на OpenTelemetry: единая инъектируемая точка трассировки,
// точки инструментации зависят только от него, а не от SDK. Выключен по умолчанию —
// тогда НачатьСпан отдаёт no-op СпанХаба. Сбой сборки конвейера не роняет старт хаба:
// OTel помечается выключенным. Заголовки авторизации коллектора берутся только из
// окружения (OSHUB_OTEL_HEADERS) и не логируются.

#Использовать opentelemetry

Перем Включена_;
Перем Трассировщик;   // ОтелТрассировщик либо Неопределено
Перем Экспортер;      // ОтелЭкспортерСпанов либо Неопределено
Перем Буфер;          // БуферСпанов
Перем КодОшибки;      // ОтелКодСтатуса.Ошибка()
Перем КодОк;          // ОтелКодСтатуса.Ок()
Перем Лог;
Перем Числа;       // ПриведениеЧисел (основа)
Перем ЧтениеФлагов;  // ПриведениеФлагов (основа)
Перем Ошибки;      // ТекстОшибки (основа)

#Область ПубличныйИнтерфейс

// Включён ли OTel и собран ли конвейер трассировки.
//
// Возвращаемое значение:
//  Булево - Истина, если спаны реально создаются.
//
Функция Включена() Экспорт
	Возврат Включена_ И Трассировщик <> Неопределено;
КонецФункции

// Начинает спан заданного вида. При выключенном OTel и при сбое SDK возвращает no-op.
//
// Параметры:
//  Имя - Строка - имя операции низкой кардинальности, без идентификаторов и версий.
//  ВидИмя - Строка - "server", "client", "producer", "consumer" либо "internal"
//           (необязательный, по умолчанию "internal").
//  Атрибуты - Соответствие - начальные атрибуты без секретов и PII (необязательный,
//             по умолчанию Неопределено).
//  СделатьТекущим - Булево - сделать спан текущим в контексте (необязательный,
//                   по умолчанию Ложь).
//
// Возвращаемое значение:
//  СпанХаба - обёртка спана, реальная либо no-op.
//
Функция НачатьСпан(Знач Имя, Знач ВидИмя = "internal", Знач Атрибуты = Неопределено,
	Знач СделатьТекущим = Ложь) Экспорт
	Если НЕ Включена() Тогда
		Возврат Новый СпанХаба();
	КонецЕсли;
	Попытка
		Спан = Трассировщик.НачатьСпан(Имя, ВидПоИмени(ВидИмя), Атрибуты);
		Возврат ОбернутьСпан(Спан, СделатьТекущим);
	Исключение
		Лог.Предупреждение("OTel: сбой создания спана ""%1"" (изолирован): %2", Имя,
			Ошибки.Однострочно(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Новый СпанХаба();
	КонецПопытки;
КонецФункции

// Начинает серверный спан, продолжая входящую трассировку по заголовку traceparent
// (W3C Trace Context); при пустом или невалидном заголовке спан корневой.
//
// Параметры:
//  Имя - Строка - имя операции.
//  Traceparent - Строка - значение заголовка traceparent (необязательный,
//                по умолчанию пустая строка).
//  Атрибуты - Соответствие - начальные атрибуты без секретов и PII (необязательный,
//             по умолчанию Неопределено).
//  СделатьТекущим - Булево - сделать спан текущим в контексте (необязательный,
//                   по умолчанию Истина).
//
// Возвращаемое значение:
//  СпанХаба - обёртка спана, реальная либо no-op.
//
Функция НачатьСпанСервера(Знач Имя, Знач Traceparent = "", Знач Атрибуты = Неопределено,
	Знач СделатьТекущим = Истина) Экспорт
	Если НЕ Включена() Тогда
		Возврат Новый СпанХаба();
	КонецЕсли;
	Попытка
		КонтекстРодителя = КонтекстИзTraceparent(Traceparent);
		Если КонтекстРодителя <> Неопределено Тогда
			Спан = Трассировщик.НачатьДочернийСпан(Имя, КонтекстРодителя, ОтелВидСпана.Сервер(), Атрибуты);
		Иначе
			Спан = Трассировщик.НачатьСпан(Имя, ОтелВидСпана.Сервер(), Атрибуты);
		КонецЕсли;
		Возврат ОбернутьСпан(Спан, СделатьТекущим);
	Исключение
		Лог.Предупреждение("OTel: сбой создания серверного спана ""%1"" (изолирован): %2", Имя,
			Ошибки.Однострочно(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Новый СпанХаба();
	КонецПопытки;
КонецФункции

// Забирает партию завершённых спанов из буфера и экспортирует её по OTLP.
// Сбой экспорта изолирован, партия в любом случае выведена из буфера.
//
// Возвращаемое значение:
//  Число - размер обработанной партии; 0 при выключенном OTel и пустом буфере.
//
Функция ЭкспортироватьПартию() Экспорт
	Если НЕ Включена() Тогда
		Возврат 0;
	КонецЕсли;
	Партия = Буфер.ЗабратьВсе();
	Если Партия.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Лог.Отладка("OTel: экспортируем партию из %1 спанов", Партия.Количество());
	Попытка
		Экспортер.Экспортировать(Партия);
	Исключение
		Лог.Предупреждение("OTel: сбой экспорта партии из %1 спанов (изолирован): %2",
			Партия.Количество(), Ошибки.Однострочно(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Возврат Партия.Количество();
КонецФункции

// Текущее число спанов в буфере.
//
// Возвращаемое значение:
//  Число - размер буфера.
//
Функция РазмерБуфера() Экспорт
	Возврат Буфер.Размер();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбернутьСпан(Знач Спан, Знач СделатьТекущим)
	Область = Неопределено;
	Если СделатьТекущим Тогда
		Попытка
			Область = Спан.СделатьТекущим();
		Исключение
			Область = Неопределено;
		КонецПопытки;
	КонецЕсли;
	Возврат Новый СпанХаба(Спан, Область, КодОшибки, КодОк);
КонецФункции

Функция ВидПоИмени(Знач ВидИмя)
	Значение = НРег(СокрЛП(Строка(ВидИмя)));
	Если Значение = "server" Тогда
		Возврат ОтелВидСпана.Сервер();
	ИначеЕсли Значение = "client" Тогда
		Возврат ОтелВидСпана.Клиент();
	ИначеЕсли Значение = "producer" Тогда
		Возврат ОтелВидСпана.Производитель();
	ИначеЕсли Значение = "consumer" Тогда
		Возврат ОтелВидСпана.Потребитель();
	Иначе
		Возврат ОтелВидСпана.Внутренний();
	КонецЕсли;
КонецФункции

// Разбирает W3C traceparent "00-<32hex trace>-<16hex span>-<2hex flags>";
// Неопределено — значение пустое или невалидное.
Функция КонтекстИзTraceparent(Знач Traceparent)
	Значение = СокрЛП(Строка(Traceparent));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Части = СтрРазделить(Значение, "-", Истина);
	Если Части.Количество() < 4 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИдТрассировки = НРег(Части[1]);
	ИдСпана = НРег(Части[2]);
	Если НЕ HexДлины(ИдТрассировки, 32) ИЛИ НЕ HexДлины(ИдСпана, 16) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ВсеНули(ИдТрассировки) ИЛИ ВсеНули(ИдСпана) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Флаги = 0;
	Попытка
		Флаги = HexВЧисло(Части[3]);
	Исключение
		Флаги = 0;
	КонецПопытки;
	Возврат Новый ОтелКонтекстСпана(ИдТрассировки, ИдСпана, Флаги, Новый ОтелСостояниеТрассировки());
КонецФункции

Функция HexДлины(Знач Строка_, Знач Длина)
	Если СтрДлина(Строка_) <> Длина Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Н = 1 По Длина Цикл
		С = Сред(Строка_, Н, 1);
		Если СтрНайти("0123456789abcdef", С) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ВсеНули(Знач Строка_)
	Для Н = 1 По СтрДлина(Строка_) Цикл
		Если Сред(Строка_, Н, 1) <> "0" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция HexВЧисло(Знач Hex)
	Цифры = "0123456789abcdef";
	Результат = 0;
	Для Н = 1 По СтрДлина(Hex) Цикл
		П = СтрНайти(Цифры, НРег(Сред(Hex, Н, 1)));
		Если П = 0 Тогда
			ВызватьИсключение "не hex";
		КонецЕсли;
		Результат = Результат * 16 + (П - 1);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// При ошибке бросает исключение — его перехватывает конструктор.
Процедура СобратьКонвейер(Знач КлиентHTTP, Знач Endpoint, Знач Протокол, Знач ИмяСервиса,
	Знач Доля, Знач ТаймаутСек, Знач ПроверятьSSL)

	Заголовки = ЗаголовкиИзОкружения();
	// Лог передаётся вниз: транспорт не желудь, инъекция к нему не применима.
	Транспорт = Новый ТранспортOTLPХаба(КлиентHTTP, Endpoint, Заголовки, ТаймаутСек, ПроверятьSSL, Лог, Ошибки);
	Экспортер = Новый ОтелЭкспортерСпанов(Транспорт, "/v1/traces");
	Процессор = Новый ПроцессорСпановХаба(Буфер);

	Ресурс = Новый ОтелПостроительРесурса().Установить("service.name", ИмяСервиса).Построить();
	Построитель = Новый ОтелПостроительПровайдераТрассировки();
	Построитель.УстановитьРесурс(Ресурс).ДобавитьПроцессор(Процессор);
	ПрименитьСэмплер(Построитель, Доля);
	Провайдер = Построитель.Построить();

	Трассировщик = Провайдер.ПолучитьТрассировщик("openhub", ВерсияХаба());

	// Транспорт хаба шлёт только http/json; http/protobuf сознательно не поддержан.
	Если НРег(СокрЛП(Строка(Протокол))) = "http/protobuf" Тогда
		Лог.Предупреждение("OTel: protocol=http/protobuf не поддержан транспортом хаба — используется http/json");
	КонецЕсли;
КонецПроцедуры

Процедура ПрименитьСэмплер(Знач Построитель, Знач Доля)
	Если Доля >= 1.0 Тогда
		Построитель.УстановитьСэмплер(ОтелСэмплер.ВсегдаВключен());
	ИначеЕсли Доля <= 0.0 Тогда
		Построитель.УстановитьСэмплер(ОтелСэмплер.ВсегдаВыключен());
	Иначе
		// Дочерние сэмплированного родителя сэмплируются; корневые — по доле.
		Построитель.УстановитьСэмплер(ОтелСэмплер.НаОсновеРодителя(), Доля, ОтелСэмплер.ПоДолеТрассировок());
	КонецЕсли;
КонецПроцедуры

// Формат OSHUB_OTEL_HEADERS: "Ключ1=Значение1,Ключ2=Значение2".
Функция ЗаголовкиИзОкружения()
	Результат = Новый Соответствие();
	Сырое = ПолучитьПеременнуюСреды("OSHUB_OTEL_HEADERS");
	Если НЕ ЗначениеЗаполнено(Сырое) Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Пара Из СтрРазделить(Сырое, ",", Ложь) Цикл
		П = СокрЛП(Пара);
		Поз = СтрНайти(П, "=");
		Если Поз > 1 Тогда
			Ключ = СокрЛП(Лев(П, Поз - 1));
			Значение = СокрЛП(Сред(П, Поз + 1));
			Если ЗначениеЗаполнено(Ключ) Тогда
				Результат.Вставить(Ключ, Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ВерсияХаба()
	Возврат "0.1.0";
КонецФункции

Функция ДробноеИлиДефолт(Знач Значение, Знач Дефолт)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Дефолт;
	КонецЕсли;
	Попытка
		Возврат Число(СтрЗаменить(Строка(Значение), ",", "."));
	Исключение
		Возврат Дефолт;
	КонецПопытки;
КонецФункции

Функция СтрокаИлиДефолт(Знач Значение, Знач Дефолт)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Дефолт;
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

#КонецОбласти

// Контейнер, где инструментированный класс требует «Телеметрия», обязан регистрировать
// и модуль сеть: исходящий HTTP приходит желудём «ТранспортHTTP».
&Прозвище("Телеметрия")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТранспортHTTP") НовыйКлиентHTTP = Неопределено,
	&Пластилин(Значение = "БуферСпановТелеметрии") НовыйБуфер,
	&Деталька(Значение = "oshub.otel.enabled", ЗначениеПоУмолчанию = Ложь) _Включено = Неопределено,
	&Деталька(Значение = "oshub.otel.endpoint", ЗначениеПоУмолчанию = "http://localhost:4318") _Endpoint = Неопределено,
	&Деталька(Значение = "oshub.otel.protocol", ЗначениеПоУмолчанию = "http/json") _Протокол = Неопределено,
	&Деталька(Значение = "oshub.otel.service_name", ЗначениеПоУмолчанию = "openhub") _ИмяСервиса = Неопределено,
	&Деталька(Значение = "oshub.otel.sampling_ratio", ЗначениеПоУмолчанию = 1.0) _Доля = Неопределено,
	&Деталька(Значение = "oshub.otel.timeout_sec", ЗначениеПоУмолчанию = 10) _Таймаут = Неопределено,
	&Деталька(Значение = "oshub.otel.insecure_skip_verify", ЗначениеПоУмолчанию = Ложь) _Insecure = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Пластилин(Значение = "ПриведениеФлагов") _Флаги = Неопределено)

	Числа = _Числа;
	Ошибки = _Ошибки;
	ЧтениеФлагов = ?(_Флаги = Неопределено, Новый ПриведениеФлагов(), _Флаги);

	// Лог параметром, а не полем: конструктор сам собирает конвейер и логирует его судьбу,
	// а инъекция в поле доезжает только после ПриСозданииОбъекта.
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "Телеметрия создана без лога — контейнер обязан прилепить &Лог";
	КонецЕсли;
	Лог = _Лог;
	Буфер = НовыйБуфер;
	Трассировщик = Неопределено;
	Экспортер = Неопределено;
	КодОшибки = ОтелКодСтатуса.Ошибка();
	КодОк = ОтелКодСтатуса.Ок();

	Включена_ = ЧтениеФлагов.ФлагИстина(_Включено, Ложь);
	Если НЕ Включена_ Тогда
		Возврат; // OTel выключен — конвейер не строим
	КонецЕсли;

	Если НовыйКлиентHTTP = Неопределено Тогда
		Включена_ = Ложь;
		Лог.Ошибка("OTel: нет исходящего HTTP-клиента (ТранспортHTTP) — OTel выключен");
		Возврат;
	КонецЕсли;
	Клиент = НовыйКлиентHTTP;

	Endpoint = СтрокаИлиДефолт(_Endpoint, "http://localhost:4318");
	ИмяСервиса = СтрокаИлиДефолт(_ИмяСервиса, "openhub");
	Доля = ДробноеИлиДефолт(_Доля, 1.0);
	ТаймаутСек = Макс(1, Числа.ЧислоИлиДефолт(_Таймаут, 10));
	ПроверятьSSL = НЕ ЧтениеФлагов.ФлагИстина(_Insecure, Ложь);

	Попытка
		СобратьКонвейер(Клиент, Endpoint, СтрокаИлиДефолт(_Протокол, "http/json"),
			ИмяСервиса, Доля, ТаймаутСек, ПроверятьSSL);
		Лог.Информация("OTel включён: endpoint=%1 service=%2 sampling=%3 (экспорт через 1connector)",
			Endpoint, ИмяСервиса, Формат(Доля, "ЧДЦ=3"));
	Исключение
		// Fail-safe: плохой конфиг не роняет старт хаба, OTel выключается.
		Включена_ = Ложь;
		Трассировщик = Неопределено;
		Лог.Ошибка("OTel: сбой сборки конвейера — OTel выключен: %1",
			Ошибки.Однострочно(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
КонецПроцедуры
