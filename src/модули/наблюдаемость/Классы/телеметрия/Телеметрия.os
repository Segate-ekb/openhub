// Доменная трассировка хаба: спаны того, что запросом не является, и доменные атрибуты
// на серверном спане winow. Конвейер, экспорт и traceparent — дело SDK и веб-каркаса.

#Использовать opentelemetry

Перем ТабакеркаSdk;   // Табакерка ОтелSdk — SDK поднимается только когда трассы включены
Перем Включена_;      // otel.enabled
Перем Трассировщик;   // ОтелТрассировщик; достаётся лениво, на первом спане
Перем КодОшибки;
Перем Лог;
Перем Ошибки;         // ТекстОшибки (основа)

#Область ПубличныйИнтерфейс

// Включена ли трассировка. Ответ не поднимает SDK: читается только настройка.
//
// Возвращаемое значение:
//  Булево - Истина, если спаны реально создаются.
//
Функция Включена() Экспорт
	Возврат Включена_;
КонецФункции

// Начинает спан заданного вида. Родителем становится текущий спан контекста —
// серверный спан winow, если операция идёт внутри запроса.
//
// Параметры:
//  Имя - Строка - имя операции низкой кардинальности, без идентификаторов и версий.
//  ВидИмя - Строка - "server", "client", "producer", "consumer" либо "internal"
//           (необязательный, по умолчанию "internal").
//  Атрибуты - Соответствие - начальные атрибуты без секретов и PII (необязательный,
//             по умолчанию Неопределено).
//
// Возвращаемое значение:
//  СпанХаба - обёртка спана, реальная либо пустышка.
//
Функция НачатьСпан(Знач Имя, Знач ВидИмя = "internal", Знач Атрибуты = Неопределено) Экспорт

	Если НЕ Включена_ Тогда
		Возврат Новый СпанХаба();
	КонецЕсли;

	Попытка
		Возврат Новый СпанХаба(
			ДействующийТрассировщик().НачатьСпан(Имя, ВидПоИмени(ВидИмя), Атрибуты), КодОшибки);
	Исключение
		ВыключитьПослеСбоя(СтрШаблон("создание спана ""%1""", Имя));
		Возврат Новый СпанХаба();
	КонецПопытки;

КонецФункции

// Вешает доменные атрибуты на текущий спан — серверный спан запроса, заведённый winow.
// Вне запроса и при выключенной трассировке не делает ничего.
//
// Параметры:
//  Атрибуты - Соответствие - атрибуты без секретов и PII.
//
Процедура ДополнитьТекущийСпан(Знач Атрибуты) Экспорт

	Если НЕ Включена_ ИЛИ Атрибуты = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Спан = ОтелКонтекст.ТекущийСпан();
		Если Спан = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Для Каждого Атрибут Из Атрибуты Цикл
			Спан.УстановитьАтрибут(Атрибут.Ключ, Атрибут.Значение);
		КонецЦикла;
	Исключение
		ВыключитьПослеСбоя("дополнение текущего спана");
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// SDK достаётся из табакерки на первом спане: пока трасс не просят, он не поднят,
// а значит нет ни фонового экспорта, ни его цены.
Функция ДействующийТрассировщик()

	Если Трассировщик = Неопределено Тогда
		Трассировщик = ТабакеркаSdk.Достать().ПолучитьТрассировщик("openhub");
		КодОшибки = ОтелКодСтатуса.Ошибка();
		// Момент подъёма SDK — то, чем разбирается «трассы не доезжают»: до этой строки
		// коллектору никто не звонил, после неё за экспорт отвечает SDK.
		Лог.Информация("OTel: SDK поднят, доменные спаны идут в область ""openhub""");
	КонецЕсли;

	Возврат Трассировщик;

КонецФункции

// Сбой телеметрии не роняет операцию и не повторяется на каждом спане: трассировка
// выключается, причина называется один раз.
Процедура ВыключитьПослеСбоя(Знач ЧтоДелали)

	Включена_ = Ложь;
	Лог.Ошибка("OTel: сбой на шаге ""%1"" — трассировка выключена: %2", ЧтоДелали,
		Ошибки.Однострочно(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));

КонецПроцедуры

Функция ВидПоИмени(Знач ВидИмя)

	Значение = НРег(СокрЛП(Строка(ВидИмя)));
	Если Значение = "server" Тогда
		Возврат ОтелВидСпана.Сервер();
	ИначеЕсли Значение = "client" Тогда
		Возврат ОтелВидСпана.Клиент();
	ИначеЕсли Значение = "producer" Тогда
		Возврат ОтелВидСпана.Производитель();
	ИначеЕсли Значение = "consumer" Тогда
		Возврат ОтелВидСпана.Потребитель();
	Иначе
		Возврат ОтелВидСпана.Внутренний();
	КонецЕсли;

КонецФункции

#КонецОбласти

&Прозвище("Телеметрия")
&Желудь
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ОтелSdk") _ТабакеркаSdk,
	&Деталька(Значение = "otel.enabled", ЗначениеПоУмолчанию = Ложь) _Включено = Ложь,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Пластилин(Значение = "ПриведениеФлагов") _Флаги = Неопределено)

	ТабакеркаSdk = _ТабакеркаSdk;
	// Читаем терпимо, как читает экосистема: напильник winow считает строку "true"
	// истиной и шлёт спаны. Тождество с Истина расходилось бы с ним, и телеметрия
	// выходила бы наполовину — каркас трассирует, а домен считает себя выключенным.
	// Приведение — переменная конструктора, а не поле: после прочтения флага оно не нужно.
	Приведение = ?(_Флаги = Неопределено, Новый ПриведениеФлагов(), _Флаги);
	Включена_ = Приведение.ФлагИстина(_Включено, Ложь);
	Трассировщик = Неопределено;
	КодОшибки = Неопределено;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);

	// Лог параметром, а не полем: фасад отчитывается о сбоях сам, а инъекция в поле
	// доезжает только после ПриСозданииОбъекта.
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "Телеметрия создана без лога — контейнер обязан прилепить &Лог";
	КонецЕсли;
	Лог = _Лог;

	// Одна строка на старте отвечает оператору «почему трасс нет»: настройка названа
	// вслух, а искать её в конфигурации инсталляции не нужно.
	Если Включена_ Тогда
		Лог.Информация("OTel: трассировка включена (otel.enabled), SDK поднимется на первом спане");
	Иначе
		Лог.Информация("OTel: трассировка выключена (otel.enabled=false) — SDK не поднимается");
	КонецЕсли;

КонецПроцедуры
