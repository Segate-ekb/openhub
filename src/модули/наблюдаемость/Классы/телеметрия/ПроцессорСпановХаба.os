// Процессор спанов OTel: на завершении спана только кладёт его в БуферСпанов,
// без сети и сериализации на горячем пути. Экспорт делает ЭкспортёрТелеметрии.

#Использовать opentelemetry

Перем Буфер; // БуферСпанов (наблюдаемость)

#Область ПрограммныйИнтерфейс

// OnStart контракта ИнтерфейсПроцессорСпанов — начало спана не обрабатываем.
//
// Параметры:
//  Спан - ОтелСпан - начатый спан.
//  РодительскийКонтекст - Произвольный - контекст родителя (необязательный,
//                         по умолчанию Неопределено).
//
Процедура ПриНачале(Спан, РодительскийКонтекст = Неопределено) Экспорт
КонецПроцедуры

// OnEnding контракта ИнтерфейсПроцессорСпанов — не обрабатываем.
//
// Параметры:
//  Спан - ОтелСпан - завершаемый спан.
//
Процедура ПередЗавершением(Спан) Экспорт
КонецПроцедуры

// OnEnd контракта ИнтерфейсПроцессорСпанов: кладёт завершённый спан в буфер хаба.
// Сбой постановки изолирован и не роняет завершение спана в SDK.
//
// Параметры:
//  Спан - ОтелСпан - завершённый спан.
//
Процедура ПриЗавершении(Спан) Экспорт
	Попытка
		Буфер.Добавить(Спан);
	Исключение
		// изоляция
	КонецПопытки;
КонецПроцедуры

// ForceFlush контракта ИнтерфейсПроцессорСпанов: буфер в памяти, спец-действий
// не требуется.
//
// Параметры:
//  ТаймаутМс - Число - таймаут ожидания (необязательный, по умолчанию 0).
//
// Возвращаемое значение:
//  Произвольный - ОтелРезультатыЭкспорта.Успех().
//
Функция СброситьБуфер(ТаймаутМс = 0) Экспорт
	Возврат ОтелРезультатыЭкспорта.Успех();
КонецФункции

// Shutdown контракта ИнтерфейсПроцессорСпанов: собственных ресурсов не держим.
//
// Параметры:
//  ТаймаутМс - Число - таймаут ожидания (необязательный, по умолчанию 0).
//
// Возвращаемое значение:
//  Неопределено.
//
Функция Закрыть(ТаймаутМс = 0) Экспорт
	Возврат Неопределено;
КонецФункции

#КонецОбласти

&Реализует("ИнтерфейсПроцессорСпанов")
Процедура ПриСозданииОбъекта(Знач НовыйБуфер)
	Буфер = НовыйБуфер;
КонецПроцедуры
