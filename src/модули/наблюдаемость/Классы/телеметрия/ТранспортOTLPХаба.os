// OTLP/HTTP-транспорт хаба поверх единого исходящего клиента сеть/КлиентHTTP.
// Подставляется вместо штатного ОтелHttpТранспорт SDK, который дёргает 1connector
// напрямую в обход адаптера хаба. Протокол — только http/json; http/protobuf
// сознательно не поддержан. Класс не желудь: лог и помощники передаёт создатель.

Перем КлиентHTTP;   // ТранспортHTTP (сеть)
Перем БазовыйURL;   // endpoint коллектора, например http://localhost:4318
Перем Заголовки;    // Соответствие доп. заголовков, в т.ч. секретные из окружения
Перем ТаймаутСек;
Перем ПроверятьSSL;
Перем Лог;
Перем Ошибки;       // ТекстОшибки (основа)

#Область ПрограммныйИнтерфейс

// Контракт транспорта SDK: отправляет OTLP-данные на путь сигнала.
//
// Параметры:
//  Путь - Строка - путь сигнала, например "/v1/traces".
//  Данные - Соответствие - OTLP-нагрузка (resourceSpans и прочее).
//
// Возвращаемое значение:
//  Булево - Истина при HTTP 2xx; Ложь при любой ошибке, наружу не бросает.
//
Функция Отправить(Знач Путь, Знач Данные) Экспорт
	Попытка
		Запись = Новый ЗаписьJSON();
		Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, ""));
		ЗаписатьJSON(Запись, Данные);
		Тело = Запись.Закрыть();

		ЗаголовкиЗапроса = Новый Соответствие();
		Для Каждого КВ Из Заголовки Цикл
			ЗаголовкиЗапроса.Вставить(КВ.Ключ, КВ.Значение);
		КонецЦикла;
		ЗаголовкиЗапроса.Вставить("Content-Type", "application/json");

		ПолныйURL = СклеитьURL(БазовыйURL, Путь);
		Ответ = КлиентHTTP.Отправить(ПолныйURL, Тело, ЗаголовкиЗапроса, ТаймаутСек, ПроверятьSSL);
		Успех = Ответ.Код >= 200 И Ответ.Код < 300;
		// адрес коллектора и код — то, чем разбирается «трассы не доезжают»; сами спаны
		// в журнал не идут, их место в коллекторе
		Лог.Отладка("OTLP экспорт %1: %2 ответил %3, тело %4 байт при таймауте %5 с",
			Путь, ПолныйURL, Ответ.Код, СтрДлина(Тело), ТаймаутСек);
		Если НЕ Успех Тогда
			Лог.Предупреждение("OTLP экспорт %1: коллектор ответил %2", Путь, Ответ.Код);
		КонецЕсли;
		Возврат Успех;
	Исключение
		// Fail-safe: недоступный коллектор не роняет фоновый экспорт.
		Лог.Предупреждение("OTLP экспорт %1: сбой отправки: %2", Путь,
			Ошибки.Однострочно(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Заголовки транспорта — контракт совместимости с транспортами SDK.
//
// Возвращаемое значение:
//  Соответствие - дополнительные заголовки запроса к коллектору.
//
Функция ПолучитьЗаголовки() Экспорт
	Возврат Заголовки;
КонецФункции

// Закрытие транспорта по контракту SDK: собственных ресурсов не держим.
//
Процедура Закрыть() Экспорт
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СклеитьURL(Знач База, Знач Путь)
	Б = Строка(База);
	П = Строка(Путь);
	Если СтрЗаканчиваетсяНа(Б, "/") И СтрНачинаетсяС(П, "/") Тогда
		Возврат Лев(Б, СтрДлина(Б) - 1) + П;
	КонецЕсли;
	Если НЕ СтрЗаканчиваетсяНа(Б, "/") И НЕ СтрНачинаетсяС(П, "/") Тогда
		Возврат Б + "/" + П;
	КонецЕсли;
	Возврат Б + П;
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач НовыйКлиентHTTP, Знач Endpoint, Знач НовыеЗаголовки = Неопределено,
	Знач НовыйТаймаут = 10, Знач НовыйПроверятьSSL = Истина, Знач НовыйЛог = Неопределено,
	Знач НовыеОшибки = Неопределено)
	КлиентHTTP = НовыйКлиентHTTP;
	БазовыйURL = Строка(Endpoint);
	Заголовки = ?(НовыеЗаголовки = Неопределено, Новый Соответствие(), НовыеЗаголовки);
	ТаймаутСек = НовыйТаймаут;
	ПроверятьSSL = НовыйПроверятьSSL;
	Если НовыйЛог = Неопределено Тогда
		ВызватьИсключение "ТранспортOTLPХаба создан без лога — создатель обязан передать свой лог";
	КонецЕсли;
	Лог = НовыйЛог;
	Если НовыеОшибки = Неопределено Тогда
		// тот же контракт, что и у лога (6.C п.8): класс не желудь, помощник передаёт создатель
		ВызватьИсключение "ТранспортOTLPХаба создан без помощника ТекстОшибки — передайте его параметром";
	КонецЕсли;
	Ошибки = НовыеОшибки;
КонецПроцедуры
