// Ключи настроек страны посетителя: файл базы стран, заголовок обратного прокси, порядок
// источников и обновление базы.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей страны посетителя в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи страны посетителя.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(160)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "oshub.geo.db_path", ЗначениеПоУмолчанию = "") _ПутьБазыСтран = "",
	&Деталька(Значение = "oshub.geo.header", ЗначениеПоУмолчанию = "") _ЗаголовокСтраны = "",
	&Деталька(Значение = "oshub.geo.source_order", ЗначениеПоУмолчанию = "") _ПорядокИсточниковСтраны = "",
	&Деталька(Значение = "oshub.geo.update.enabled", ЗначениеПоУмолчанию = "") _ОбновлениеБазыСтран = "",
	&Деталька(Значение = "oshub.geo.update.url", ЗначениеПоУмолчанию = "") _АдресВыпускаБазыСтран = "",
	&Деталька(Значение = "oshub.jobs.geo_update_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалБазыСтран = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	// свойства развёртывания: пустой путь — каталог «гео» в корне данных, пустой заголовок не читается;
	// порядок источников — одним словом через дефис: запятая разделяет значения перечисления
	Ключи.Объявить("oshub.geo.db_path", "строка", "", Неопределено, "bootstrap", _ПутьБазыСтран);
	Ключи.Объявить("oshub.geo.header", "строка", "CF-IPCountry", Неопределено, "bootstrap", _ЗаголовокСтраны);
	Ключи.Объявить("oshub.geo.source_order", "строка", "база-прокси",
		_Правила.Перечисление("база-прокси,прокси-база"), "bootstrap", _ПорядокИсточниковСтраны);
	// закрытый контур наружу не ходит: базу кладут файлом, и хаб замечает её по отпечатку
	Ключи.Объявить("oshub.geo.update.enabled", "булево", Ложь, Неопределено, "bootstrap", _ОбновлениеБазыСтран);
	Ключи.Объявить("oshub.geo.update.url", "строка",
		"https://download.db-ip.com/free/dbip-country-lite-{ГОД}-{МЕСЯЦ}.csv.gz",
		Неопределено, "bootstrap", _АдресВыпускаБазыСтран);

	// выпуск базы месячный — суточного захода хватает; минута снизу против непрерывного скачивания
	Ключи.Объявить("oshub.jobs.geo_update_interval_sec", "целое", 86400, _Правила.Минимум(60), "bootstrap",
		_ИнтервалБазыСтран);

КонецПроцедуры
