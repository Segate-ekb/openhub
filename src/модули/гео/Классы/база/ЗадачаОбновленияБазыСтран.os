// Задача планировщика «обновление-базы-стран»: заход обновления встроенной базы стран —
// однократно вскоре после старта и дальше раз в интервал из настройки.

Перем Обновление;  // ОбновлениеБазыСтран
Перем Интервал;    // интервал обновления из настройки, секунды

// Две регистрации одной работы: однократный заход вскоре после старта и интервал —
// у интервального расписания первый запуск наступает через интервал после регистрации.
//
// Параметры:
//  Регистрации - РегистрацииЗадачи - куда записываются регистрации.
//
Процедура Зарегистрировать(Регистрации) Экспорт
	Регистрации.ОднократноЧерез("обновление-базы-стран-при-старте", ЗадержкаСтартовогоЗаходаСек());
	Регистрации.КаждыеСекунд("обновление-базы-стран", Интервал);
КонецПроцедуры

// Выполняет один заход обновления базы.
// Сбой перебрасывается планировщику.
//
&Наблюдаемый("job.geo_update")
Процедура Исполнить() Экспорт
	Обновление.Обойти();
КонецПроцедуры

// Не в первую секунду старта: заход тянет десятки мегабайт и строит индекс.
Функция ЗадержкаСтартовогоЗаходаСек()
	Возврат 120;
КонецФункции

&Прозвище("ЗадачаПланировщика")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОбновлениеБазыСтран") _Обновление,
	&Деталька(Значение = "oshub.jobs.geo_update_interval_sec", ЗначениеПоУмолчанию = 86400) _Интервал = Неопределено)

	Обновление = _Обновление;
	Интервал = Новый ПриведениеЧисел().ЧислоИлиДефолт(_Интервал, 86400);

КонецПроцедуры
