// Встроенная база стран инсталляции: заказ стран от правил и опубликованный снимок индекса —
// два поля, у каждого один писатель; оба присваиваются целиком одной ссылкой.

Перем Настройки;   // СервисНастроек (настройки)
Перем Фон;         // ЗапускВФоне (фоновыеЗадания)
Перем Сборка;      // СборкаИндексаСтран (гео)
Перем Коды;        // КодыСтран (гео)
Перем Ошибки;      // ТекстОшибки (основа)
Перем Заказ_;      // Структура(Страны, КлючСтран) — что назвали правила
Перем Снимок_;     // Структура(Страны, КлючСтран, КлючЗаказа, Индекс, Отпечаток, Итог, Неудача)
Перем Замок;       // БлокировкаРесурса — одна перестройка за раз
Перем Прочтений_;  // сколько раз файл базы был прочитан за жизнь процесса
Перем Часы;        // объект с методом Сейчас() -> Дата, либо Неопределено (системные часы)
&Лог
Перем Лог;

#Область ТестовыеШвы

// Подставляет источник времени — тестовый шов; в рабочем контейнере не вызывается.
// Время здесь местное: с ним сравнивается время изменения файла базы.
//
// Параметры:
//  ИсточникВремени - Произвольный - объект с методом Сейчас(), возвращающим Дату.
//
Процедура УстановитьЧасы(Знач ИсточникВремени) Экспорт
	Часы = ИсточникВремени;
КонецПроцедуры

#КонецОбласти

#Область ПубличныйИнтерфейс

// Ключ настройки с путём к файлу базы.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючПути() Экспорт
	Возврат "oshub.geo.db_path";
КонецФункции

// Полное имя файла базы: названный путь либо каталог «гео» в корне данных инсталляции.
//
// Возвращаемое значение:
//  Строка.
//
Функция Путь() Экспорт

	Заданный = Настройки.Текстом(КлючПути(), "");
	Если ЗначениеЗаполнено(Заданный) Тогда
		Возврат Новый Файл(Заданный).ПолноеИмя;
	КонецЕсли;

	Корень = Настройки.Текстом("oshub.storage.root", "./data");
	Возврат Новый Файл(ОбъединитьПути(?(ЗначениеЗаполнено(Корень), Корень, "./data"),
		"гео", "dbip-country-lite.csv")).ПолноеИмя;

КонецФункции

// Объявляет, какие страны нужны действующим правилам. Возврат управления не значит, что
// новый индекс уже построен: сборка уезжает в фон, а до её публикации хаб отвечает
// по прежнему индексу.
//
// Параметры:
//  Страны - Массив из Строка - коды стран в любой записи; пустой массив — наблюдать нечего.
//
Процедура НаблюдатьСтраны(Знач Страны) Экспорт

	Набор = Наблюдаемые(Страны);
	Ключ = СтрСоединить(Набор, ",");

	Если Заказ_.КлючСтран = Ключ Тогда
		Возврат;
	КонецЕсли;

	Заказ_ = НовыйЗаказ(Набор, Ключ);
	Фон.Запустить(Новый ПерестройкаИндексаСтран(ЭтотОбъект));

КонецПроцедуры

// Страны, которые хаб различает ПРЯМО СЕЙЧАС, — набор опубликованного индекса.
//
// Возвращаемое значение:
//  Массив из Строка - коды в каноне, по алфавиту; пустой массив — индекса нет.
//
Функция НаблюдаемыеСтраны() Экспорт
	Возврат Копия(Снимок_.Страны);
КонецФункции

// Страны, которые назвали правила. От наблюдаемых отличаются ровно тем временем,
// пока строится новый индекс, — и ещё тогда, когда построить его не из чего.
//
// Возвращаемое значение:
//  Массив из Строка - коды в каноне, по алфавиту.
//
Функция ЗаказанныеСтраны() Экспорт
	Возврат Копия(Заказ_.Страны);
КонецФункции

// Снимок для определителя: индекс и почему его нет — одним значением про одно состояние.
//
// Возвращаемое значение:
//  Структура - Индекс (ИндексСтран либо Неопределено), Страны (Массив из Строка — набор
//              этого индекса), Строится (Булево — заказом ещё не занимались, чем бы сборка
//              ни кончилась), Причина (Строка, словами; пустая, когда индекс есть).
//
Функция ОтветБазы() Экспорт

	Заказ = Заказ_;
	Снимок = Снимок_;

	Возврат Новый Структура("Индекс, Страны, Строится, Причина",
		Снимок.Индекс, Копия(Снимок.Страны), Заказ.КлючСтран <> Снимок.КлючЗаказа,
		ПочемуМолчит(Заказ, Снимок));

КонецФункции

// Перечитывает файл базы и публикует новый индекс, если он и вправду нужен. Сбой сборки
// наружу не выпускает: её зовут и фоновое задание, чей исход не смотрит никто, и обновление
// базы. Сорвавшаяся сборка прежний индекс не трогает — только объясняет себя неудачей.
//
Процедура ПерестроитьСейчас() Экспорт

	// заказ запоминается до захода: упавшая сборка называет, с чем не справилась
	Заказано = Заказ_.КлючСтран;
	Сорвавшаяся = Пересобрать();

	Если ЗначениеЗаполнено(Сорвавшаяся) Тогда
		ЗапомнитьНеудачу(Заказано, Сорвавшаяся);
	КонецЕсли;

КонецПроцедуры

// Заход за переменами: сменился заказ, сменился файл — индекс пересобирается. Ею же
// замечается база, положенная руками.
//
// Возвращаемое значение:
//  Булево - прочитался ли файл базы за время захода, чьей бы сборкой ни был прочитан.
//
Функция ПересмотретьФайл() Экспорт

	ДоЗахода = Прочтений_;
	ПерестроитьСейчас();
	Возврат Прочтений_ > ДоЗахода;

КонецФункции

// Что сейчас с базой — для экрана администратора и для происшествий.
//
// Возвращаемое значение:
//  Структура - Путь (Строка), Есть (Булево), Дата (Дата изменения файла), ВозрастСек (Число),
//              Устарела (Булево), Диапазонов (Число), Страны (Массив, набор действующего
//              индекса), Заказано (Массив, что назвали правила), Строится (Булево),
//              Неудача (Строка, последняя неудача сборки), Битых (Число), Прочтений (Число).
//
Функция Состояние() Экспорт

	Снимок = Снимок_;
	Ответ = ОтветБазы();
	Файл = Новый ФайлБазыСтран(Путь());
	Есть = Файл.Существует();
	Возраст = ?(Есть, Сейчас() - Файл.ДатаИзменения(), 0);

	Возврат Новый Структура(
		"Путь, Есть, Дата, ВозрастСек, Устарела, Диапазонов, Страны, Заказано, Строится,"
		+ " Неудача, Битых, Прочтений",
		Файл.Путь(), Есть, Файл.ДатаИзменения(), Возраст,
		Есть И Возраст > ПорогУстареванияСек(),
		?(Ответ.Индекс = Неопределено, 0, Ответ.Индекс.Диапазонов()),
		Ответ.Страны, ЗаказанныеСтраны(), Ответ.Строится, Снимок.Неудача,
		?(Снимок.Итог = Неопределено, 0, Снимок.Итог.Битых),
		Прочтений_);

КонецФункции

// Сколько раз файл базы был прочитан за жизнь процесса. Правила не назвали стран —
// значение не растёт: именно это и значит «запрос без правил за страну не платит».
//
// Возвращаемое значение:
//  Число.
//
Функция ПрочтенийФайла() Экспорт
	Возврат Прочтений_;
КонецФункции

// С какого возраста база считается устаревшей. DB-IP выпускает файл раз в месяц, поэтому
// полтора месяца — это пропущенный выпуск, а не «чуть залежалась».
//
// Возвращаемое значение:
//  Число - секунд.
//
Функция ПорогУстареванияСек() Экспорт
	Возврат 45 * 86400;
КонецФункции

#КонецОбласти

#Область Перестройка

// Единственное место замка перестройки; отпускается при любом исходе. Возвращает причину срыва или "".
Функция Пересобрать()

	Замок.Заблокировать();

	Сорвалось = Ложь;
	Отчёт = Неопределено;
	Попытка
		Перестроить();
	Исключение
		Сорвалось = Истина;
		Отчёт = ИнформацияОбОшибке();
	КонецПопытки;

	Замок.Разблокировать();

	Возврат ?(Сорвалось,
		СтрШаблон("индекс не перестроен: %1", Ошибки.Причина(Отчёт)), "");

КонецФункции

// Неудача — вторым коротким заходом под замок: внутри лишь присваивание поля.
Процедура ЗапомнитьНеудачу(Знач Заказано, Знач Причина)

	Объяснение = Объяснённый(Снимок_, Заказано, Причина);

	Замок.Заблокировать();
	Опубликовать(Объяснение);
	Замок.Разблокировать();

	Пожаловаться(Причина);

КонецПроцедуры

// Под замком; снимок публикуется на любом пути и уносит разобранный заказ, неудача индекс не отнимает.
Процедура Перестроить()

	Заказ = Заказ_;
	Снимок = Снимок_;

	Если Заказ.Страны.Количество() = 0 Тогда
		Опубликовать(Отпущенный(Заказ));
		Возврат;
	КонецЕсли;

	Файл = Новый ФайлБазыСтран(Путь());
	Если НЕ ЕстьЗаЧем(Заказ, Снимок, Файл) Тогда
		Опубликовать(Зачтённый(Снимок, Заказ.КлючСтран));
		Возврат;
	КонецЕсли;

	Если НЕ Файл.Существует() Тогда
		Причина = СтрШаблон("файла базы стран нет: %1", Файл.Путь());
		Опубликовать(Объяснённый(Снимок, Заказ.КлючСтран, Причина));
		Пожаловаться(СтрШаблон("файла базы стран нет: %1."
			+ " Страна посетителя будет неизвестна, пока файл не положат на место", Файл.Путь()));
		Возврат;
	КонецЕсли;

	Опубликовать(Собранный(Заказ, Собрать(Файл, Заказ.Страны), Файл.Отпечаток()));

КонецПроцедуры

// Повод пересобрать: другой заказ, индекса нет или файл сменился.
Функция ЕстьЗаЧем(Знач Заказ, Знач Снимок, Знач Файл)

	Возврат Заказ.КлючСтран <> Снимок.КлючСтран
		ИЛИ Снимок.Индекс = Неопределено
		ИЛИ Файл.Отпечаток() <> Снимок.Отпечаток;

КонецФункции

Функция Собрать(Знач Файл, Знач Страны)

	Прочтений_ = Прочтений_ + 1;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Итог = Сборка.ПоФайлу(Файл.Путь(), Страны);
	Потрачено = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Доложить(СтрШаблон("собрана по %1: стран %2, диапазонов %3, битых строк %4,"
		+ " прочитано строк %5, за %6 мс",
		Файл.Путь(), СтрСоединить(Страны, ","), Итог.Индекс.Диапазонов(), Итог.Битых,
		Итог.Строк, Потрачено));

	Возврат Итог;

КонецФункции

// Поле присваивается целиком: читающий видит прежний снимок или готовый новый.
Процедура Опубликовать(Знач Снимок)
	Снимок_ = Снимок;
КонецПроцедуры

// Прежний снимок с причиной неудачи и разобранным заказом.
Функция Объяснённый(Знач Прежний, Знач Заказано, Знач Причина)
	Возврат НовыйСнимок(Прежний.Страны, Прежний.КлючСтран, Заказано, Прежний.Индекс,
		Прежний.Отпечаток, Прежний.Итог, Причина);
КонецФункции

// Прежний снимок с разобранным заказом: индекс уже отвечает под него.
Функция Зачтённый(Знач Прежний, Знач Заказано)
	Возврат НовыйСнимок(Прежний.Страны, Прежний.КлючСтран, Заказано, Прежний.Индекс,
		Прежний.Отпечаток, Прежний.Итог, Прежний.Неудача);
КонецФункции

Функция Собранный(Знач Заказ, Знач Собрано, Знач Отпечаток)
	Возврат НовыйСнимок(Заказ.Страны, Заказ.КлючСтран, Заказ.КлючСтран, Собрано.Индекс,
		Отпечаток, Собрано, "");
КонецФункции

// Наблюдать нечего — индекс отпускается.
Функция Отпущенный(Знач Заказ)
	Возврат НовыйСнимок(Заказ.Страны, Заказ.КлючСтран, Заказ.КлючСтран,
		Неопределено, "", Неопределено, "");
КонецФункции

Функция НовыйСнимок(Знач Страны, Знач Ключ, Знач Заказано, Знач Индекс, Знач Отпечаток,
	Знач Итог, Знач Неудача)

	Возврат Новый Структура("Страны, КлючСтран, КлючЗаказа, Индекс, Отпечаток, Итог, Неудача",
		Страны, Ключ, Заказано, Индекс, Отпечаток, Итог, Неудача);

КонецФункции

Функция НовыйЗаказ(Знач Страны, Знач Ключ)
	Возврат Новый Структура("Страны, КлючСтран", Страны, Ключ);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Почему индекса нет — словами для администратора.
Функция ПочемуМолчит(Знач Заказ, Знач Снимок)

	Если Снимок.Индекс <> Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если Заказ.Страны.Количество() = 0 Тогда
		Возврат "встроенная база: правила не называют ни одной страны";
	КонецЕсли;

	Если ЗначениеЗаполнено(Снимок.Неудача) Тогда
		Возврат "встроенная база: " + Снимок.Неудача;
	КонецЕсли;

	Возврат "встроенная база: индекс ещё не построен";

КонецФункции

Функция Сейчас()
	Возврат ?(Часы = Неопределено, ТекущаяДата(), Часы.Сейчас());
КонецФункции

Функция Копия(Знач Страны)

	Результат = Новый Массив();
	Для Каждого Код Из Страны Цикл
		Результат.Добавить(Код);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Канон без повторов и по алфавиту: запись правила не меняет набора.
Функция Наблюдаемые(Знач Страны)

	Встреченные = Новый Соответствие();
	Если Страны <> Неопределено Тогда
		Для Каждого Запись Из Страны Цикл
			Код = Коды.Канон(Запись);
			Если ЗначениеЗаполнено(Код) Тогда
				Встреченные.Вставить(Код, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Массив();
	Для Каждого Код Из Коды.Все() Цикл
		Если Встреченные.Получить(Код) <> Неопределено Тогда
			Результат.Добавить(Код);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура Пожаловаться(Знач Текст)
	Если Лог <> Неопределено Тогда
		Лог.Предупреждение("База стран: %1", Текст);
	КонецЕсли;
КонецПроцедуры

Процедура Доложить(Знач Текст)
	Если Лог <> Неопределено Тогда
		Лог.Информация("База стран: %1", Текст);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ЗапускВФоне") _Фон,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено) Экспорт

	Настройки = _Настройки;
	Фон = _Фон;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	// классы страна/ без аннотаций ОСени создаются «Новым»
	Сборка = Новый СборкаИндексаСтран();
	Коды = Новый КодыСтран();
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
	Прочтений_ = 0;
	Часы = Неопределено;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

	Заказ_ = НовыйЗаказ(Новый Массив(), "");
	Снимок_ = НовыйСнимок(Новый Массив(), "", "", Неопределено, "", Неопределено, "");

КонецПроцедуры
