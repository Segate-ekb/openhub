// Обновление встроенной базы стран: скачать выпуск месяца, распаковать, проверить и подменить;
// неудача любого шага оставляет прежнюю базу, а причину — в происшествиях.

#Использовать compressor

Перем База;        // БазаСтран (гео)
Перем Транспорт;   // ТранспортHTTP (сеть)
Перем Настройки;   // СервисНастроек (настройки)
Перем Летопись;    // ЛетописьПроисшествий (происшествия)
Перем КодыПричин;  // КодыПроисшествийГео (гео)
Перем Объекты;     // ОбъектыПроисшествий (происшествия)
Перем Ошибки;      // ТекстОшибки (основа)
Перем Часы;        // объект с методом Сейчас() -> Дата, либо Неопределено
Перем Потолок;     // байт на тело ответа и на распакованное
&Лог
Перем Лог;

#Область ТестовыеШвы

// Подставляет источник времени — из него берётся месяц выпуска базы.
//
// Параметры:
//  ИсточникВремени - Произвольный - объект с методом Сейчас(), возвращающим Дату.
//
Процедура УстановитьЧасы(Знач ИсточникВремени) Экспорт
	Часы = ИсточникВремени;
КонецПроцедуры

// Подставляет потолок скачивания — тестовый шов; в рабочем контейнере не вызывается.
//
// Параметры:
//  Байт - Число - потолок и на тело ответа, и на распакованное.
//
Процедура УстановитьПотолок(Знач Байт) Экспорт
	Потолок = Байт;
КонецПроцедуры

#КонецОбласти

#Область ПубличныйИнтерфейс

// Один заход: подхватить положенный руками файл, при разрешении — обновить базу из сети
// и доложить о состоянии происшествиями. Наружу не бросает: её зовёт фоновая задача.
//
Процедура Обойти() Экспорт

	// заказ, а не индекс: базы может не быть вовсе — за ней заход и идёт
	Если База.ЗаказанныеСтраны().Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Заход();
	Исключение
		Пожаловаться(СтрШаблон("заход обновления сорвался: %1",
			Ошибки.Причина(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры

// Ключ настройки «ходить ли за базой наружу».
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючВключено() Экспорт
	Возврат "oshub.geo.update.enabled";
КонецФункции

// Ключ настройки с шаблоном адреса выпуска.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючАдреса() Экспорт
	Возврат "oshub.geo.update.url";
КонецФункции

// Разрешено ли хабу ходить за базой наружу.
//
// Возвращаемое значение:
//  Булево.
//
Функция Включено() Экспорт
	Возврат Настройки.Флаг(КлючВключено(), Ложь);
КонецФункции

// Адрес выпуска базы за названный месяц.
//
// Параметры:
//  Момент - Дата - любой день нужного месяца.
//
// Возвращаемое значение:
//  Строка.
//
Функция АдресВыпуска(Знач Момент) Экспорт

	Шаблон = Настройки.Текстом(КлючАдреса(), АдресПоУмолчанию());
	СГодом = СтрЗаменить(Шаблон, "{ГОД}", Формат(Год(Момент), "ЧГ=0"));
	Возврат СтрЗаменить(СГодом, "{МЕСЯЦ}", Прав("0" + Формат(Месяц(Момент), "ЧГ=0"), 2));

КонецФункции

// Шаблон адреса выпуска по умолчанию.
//
// Возвращаемое значение:
//  Строка.
//
Функция АдресПоУмолчанию() Экспорт
	Возврат "https://download.db-ip.com/free/dbip-country-lite-{ГОД}-{МЕСЯЦ}.csv.gz";
КонецФункции

#КонецОбласти

#Область ЗаходОбновления

Процедура Заход()

	// заход может подождать на замке чужую сборку — суточной задаче это дешевле второго чтения
	База.ПересмотретьФайл();
	Сбой = ?(Включено(), Обновить(), "");
	Отчитаться(Сбой);

КонецПроцедуры

// Возвращает причину неудачи словами; пустая строка — база обновлена.
Функция Обновить()

	Файл = Новый ФайлБазыСтран(База.Путь());
	Файл.ОбеспечитьКаталог();
	Файл.УбратьВременный();

	Скачано = Скачать(Файл.ВременныйПуть());
	Если ЗначениеЗаполнено(Скачано) Тогда
		Файл.УбратьВременный();
		Возврат Скачано;
	КонецЕсли;

	// кандидат судится ДО подмены: оборванная закачка и страница ошибки чужого сервера
	// выглядят файлом ровно так же, как база
	Годность = Новый ПроверкаБазыСтран().Проверить(Файл.ВременныйПуть());
	Если НЕ Годность.Годен Тогда
		Файл.УбратьВременный();
		Возврат СтрШаблон("привезённый файл базой стран не является: %1", Годность.Причина);
	КонецЕсли;

	Попытка
		Файл.Заменить(Файл.ВременныйПуть());
	Исключение
		Файл.УбратьВременный();
		Возврат СтрШаблон("подменить базу не удалось: %1",
			Ошибки.Причина(ИнформацияОбОшибке()));
	КонецПопытки;

	База.ПерестроитьСейчас();
	Доложить(СтрШаблон("база стран обновлена: строк %1, диапазонов IPv4 %2, IPv6 %3",
		Годность.Строк, Годность.IPv4, Годность.IPv6));

	Возврат "";

КонецФункции

// Выпуск текущего месяца, а если его ещё нет — прошлого.
Функция Скачать(Знач Куда)

	Отказ = "";

	Для Каждого Момент Из Выпуски() Цикл
		Адрес = АдресВыпуска(Момент);
		Ответ = Запросить(Адрес);
		Если ЗначениеЗаполнено(Ответ.Причина) Тогда
			Отказ = ?(ЗначениеЗаполнено(Отказ), Отказ, Ответ.Причина);
			Продолжить;
		КонецЕсли;

		Попытка
			Разжать(Ответ.Данные, Куда);
		Исключение
			Возврат СтрШаблон("выпуск %1 не распаковался: %2",
				Адрес, Ошибки.Причина(ИнформацияОбОшибке()));
		КонецПопытки;

		Возврат "";
	КонецЦикла;

	Возврат Отказ;

КонецФункции

Функция Запросить(Знач Адрес)

	Попытка
		Ответ = Транспорт.Получить(Адрес, , ТаймаутСек(), Истина, Истина);
	Исключение
		Возврат Неудача(СтрШаблон("%1 не ответил: %2",
			Адрес, Ошибки.Причина(ИнформацияОбОшибке())));
	КонецПопытки;

	Если Ответ.Код <> 200 Тогда
		Возврат Неудача(СтрШаблон("%1 ответил кодом %2", Адрес, Ответ.Код));
	КонецЕсли;

	Если Ответ.Данные = Неопределено ИЛИ Ответ.Данные.Размер() = 0 Тогда
		Возврат Неудача(СтрШаблон("%1 ответил пустым телом", Адрес));
	КонецЕсли;

	Если Ответ.Данные.Размер() > ПотолокБайт() Тогда
		Возврат Неудача(СтрШаблон("%1 прислал %2 байт — больше потолка %3",
			Адрес, Ответ.Данные.Размер(), ПотолокБайт()));
	КонецЕсли;

	Возврат Новый Структура("Данные, Причина", Ответ.Данные, "");

КонецФункции

// Распаковка сразу в файл; обещанный размер сверяется с потолком до распаковки.
Процедура Разжать(Знач Данные, Знач Куда)

	Обещано = ОбещанныйРазмер(Данные);
	Если Обещано > ПотолокБайт() Тогда
		ВызватьИсключение СтрШаблон("архив обещает %1 байт распакованного — больше потолка %2",
			Обещано, ПотолокБайт());
	КонецЕсли;

	Компрессор = Новый GZipКомпрессор();
	Поток = Новый ФайловыйПоток(Куда, РежимОткрытияФайла.Создать, ДоступКФайлу.Запись);

	Попытка
		Компрессор.Распаковать(Данные, Поток);
	Исключение
		Поток.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Поток.Закрыть();

	// вторая сеть: размер в хвосте gzip записан по модулю 2^32
	Написано = Новый Файл(Куда).Размер();
	Если Написано > ПотолокБайт() Тогда
		ВызватьИсключение СтрШаблон("распакованного вышло %1 байт — больше потолка %2",
			Написано, ПотолокБайт());
	КонецЕсли;

КонецПроцедуры

// Размер распакованного из последних четырёх байт gzip (RFC 1952).
Функция ОбещанныйРазмер(Знач Данные)

	Если Данные.Размер() < 4 Тогда
		Возврат 0;
	КонецЕсли;

	Чтение = Новый ЧтениеДанных(Данные);
	Попытка
		Чтение.Пропустить(Данные.Размер() - 4);
		Обещано = Чтение.ПрочитатьЦелое32();
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();

	Возврат Обещано;

КонецФункции

// Потолок и на тело ответа, и на распакованное.
Функция ПотолокБайт()
	Возврат Потолок;
КонецФункции

Функция Выпуски()

	Сейчас = ?(Часы = Неопределено, ТекущаяДата(), Часы.Сейчас());
	Результат = Новый Массив();
	Результат.Добавить(Сейчас);

	ГодВыпуска = Год(Сейчас);
	МесяцВыпуска = Месяц(Сейчас);
	Если МесяцВыпуска = 1 Тогда
		ГодВыпуска = ГодВыпуска - 1;
		МесяцВыпуска = 12;
	Иначе
		МесяцВыпуска = МесяцВыпуска - 1;
	КонецЕсли;
	Результат.Добавить(Дата(ГодВыпуска, МесяцВыпуска, 1));

	Возврат Результат;

КонецФункции

Функция Неудача(Знач Причина)
	Возврат Новый Структура("Данные, Причина", Неопределено, Причина);
КонецФункции

Функция ТаймаутСек()
	Возврат 120;
КонецФункции

#КонецОбласти

#Область Происшествия

// Причины пишутся разом; снятие — только когда причин нет.
Процедура Отчитаться(Знач Сбой)

	Состояние = База.Состояние();
	Поводы = Новый Массив();

	Если НЕ Состояние.Есть Тогда
		Поводы.Добавить(Повод(КодыПричин.БазыСтранНет(),
			СтрШаблон("файла базы стран нет: %1. Положите файл по этому пути либо включите"
				+ " обновление настройкой %2", Состояние.Путь, КлючВключено())));
	ИначеЕсли Состояние.Устарела Тогда
		Поводы.Добавить(Повод(КодыПричин.БазаСтранУстарела(),
			СтрШаблон("база стран изменялась %1 — это дольше %2 суток назад,"
				+ " и страны в ней могли сместиться",
				Формат(Состояние.Дата, "ДЛФ=DD"), Цел(База.ПорогУстареванияСек() / 86400))));
	КонецЕсли;

	Если ЗначениеЗаполнено(Сбой) Тогда
		Поводы.Добавить(Повод(КодыПричин.БазаСтранНеОбновилась(), Сбой));
	КонецЕсли;

	Если Поводы.Количество() = 0 Тогда
		Летопись.Снять(КодыПричин.Подсистема(), Объект(Состояние));
		Возврат;
	КонецЕсли;

	Для Каждого Запись Из Поводы Цикл
		Летопись.Записать(КодыПричин.Подсистема(), Объект(Состояние), "",
			Запись.Код, Запись.Текст);
	КонецЦикла;

КонецПроцедуры

Функция Объект(Знач Состояние)
	Возврат Объекты.БазаСтран(Новый Файл(Состояние.Путь).Имя);
КонецФункции

Функция Повод(Знач Код, Знач Текст)
	Возврат Новый Структура("Код, Текст", Код, Текст);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Пожаловаться(Знач Текст)
	Если Лог <> Неопределено Тогда
		Лог.Предупреждение("Обновление базы стран: %1", Текст);
	КонецЕсли;
КонецПроцедуры

Процедура Доложить(Знач Текст)
	Если Лог <> Неопределено Тогда
		Лог.Информация("Обновление базы стран: %1", Текст);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "БазаСтран") _База,
	&Пластилин(Значение = "ТранспортHTTP") _Транспорт,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ЛетописьПроисшествий") _Летопись,
	&Пластилин(Значение = "КодыПроисшествийГео") _КодыПричин,
	&Пластилин(Значение = "ОбъектыПроисшествий") _Объекты,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено) Экспорт

	База = _База;
	Транспорт = _Транспорт;
	Настройки = _Настройки;
	Летопись = _Летопись;
	КодыПричин = _КодыПричин;
	Объекты = _Объекты;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Часы = Неопределено;
	Потолок = 200 * 1024 * 1024;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
