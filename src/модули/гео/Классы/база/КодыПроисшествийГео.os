// Машинные коды происшествий встроенной базы стран и признак «пройдёт само следующим
// заходом обновления».

Перем Коды;  // ОбъявленияКодовПроисшествий (происшествия)

#Область ПубличныйИнтерфейс

// Имя подсистемы базы стран.
//
// Возвращаемое значение:
//  Строка.
//
Функция Подсистема() Экспорт
	Возврат Коды.Подсистема();
КонецФункции

// Объявления кодов подсистемы в порядке объявления.
//
// Возвращаемое значение:
//  ОбъявленияКодовПроисшествий - имя подсистемы и её коды.
//
Функция Объявления() Экспорт
	Возврат Коды;
КонецФункции

// Файла встроенной базы стран в инсталляции нет: страна посетителя никому не известна.
//
// Возвращаемое значение:
//  Строка.
//
Функция БазыСтранНет() Экспорт
	Возврат Коды.Объявленный("geo_db_missing");
КонецФункции

// Сходить за новым выпуском базы стран не получилось: сеть, отказ издателя, негодный файл.
//
// Возвращаемое значение:
//  Строка.
//
Функция БазаСтранНеОбновилась() Экспорт
	Возврат Коды.Объявленный("geo_db_update_failed");
КонецФункции

// База стран давно не менялась: страны в ней могли сместиться.
//
// Возвращаемое значение:
//  Строка.
//
Функция БазаСтранУстарела() Экспорт
	Возврат Коды.Объявленный("geo_db_stale");
КонецФункции

#КонецОбласти

&Прозвище("КодыПроисшествийПодсистемы")
&Порядок(20)
&Желудь
Процедура ПриСозданииОбъекта() Экспорт

	Коды = Новый ОбъявленияКодовПроисшествий("гео");

	// Устарелость снимет следующий удачный заход, неудачу обновления — тоже. Отсутствие
	// файла само не проходит: в закрытом контуре базу кладут руками.
	Коды.Объявить("geo_db_missing", Ложь);
	Коды.Объявить("geo_db_update_failed", Истина);
	Коды.Объявить("geo_db_stale", Истина);

КонецПроцедуры
