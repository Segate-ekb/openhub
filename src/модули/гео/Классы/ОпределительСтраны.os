// Из какой страны пришёл запрос — единственное место, где хаб это решает. Что делать
// с неизвестной страной, решает правило, а не определитель: здесь только исход и причина.
//
// «Своя сеть» судится ДО базы намеренно: в хвосте IPv6 база относит служебные диапазоны
// к настоящей стране (в выпуске 2026-09 и fe00::/9, и fec0::/10 записаны за Швейцарией),
// и спроси хаб сначала базу — петлевой сосед получил бы гражданство.

Перем База;        // БазаСтран (гео)
Перем Политика;    // СвояСеть (сеть)
Перем Канон;       // КанонIP (основа)
Перем Настройки;   // СервисНастроек (настройки)
Перем Чтение;      // ЗаголовкиHTTP (основа)
Перем Справочник;  // СправочникСтран (гео)
Перем Порядок;     // ПорядокАдресов (гео)
Перем ИсходыВердикта;

#Область ПубличныйИнтерфейс

// Коды исходов: по ним судит правило, а не по тексту причины.
//
// Возвращаемое значение:
//  Структура - Известна, НеНаблюдаемая, Неизвестна (Строка).
//
Функция Исходы() Экспорт
	Возврат ИсходыВердикта;
КонецФункции

// Страна одного запроса.
//
// Параметры:
//  АдресКлиента - Строка - адрес клиента, каким его знает хаб.
//  КодОтПрокси - Строка - код страны от доверенного обратного прокси; пустая строка —
//                заголовка не было либо ему не поверили (необязательный).
//
// Возвращаемое значение:
//  Структура - Исход (Строка, см. Исходы), Страна (Строка, код либо пустая строка),
//              Источник (Строка, «база» | «прокси» | пустая строка),
//              Причина (Строка, словами; пустая у известной страны).
//
Функция Определить(Знач АдресКлиента, Знач КодОтПрокси = "") Экспорт

	Запись = СокрЛП(Строка(?(АдресКлиента = Неопределено, "", АдресКлиента)));
	Сеть = Политика.Вердикт(Запись);

	Если Сеть.Код = Политика.Коды().НеАдрес Тогда
		Возврат Неизвестна(СтрШаблон("адрес ""%1"" адресом не является", Запись));
	КонецЕсли;

	Если Сеть.Код <> Политика.Коды().Интернет Тогда
		Возврат Неизвестна(СтрШаблон("адрес не публичный: %1", Сеть.Текст));
	КонецЕсли;

	Адрес = Канон.Адрес(Запись);
	Если Адрес = Неопределено Тогда
		Возврат Неизвестна(СтрШаблон("адрес ""%1"" адресом не является", Запись));
	КонецЕсли;

	Возврат ПоИсточникам(Адрес, КодОтПрокси);

КонецФункции

// Страна одного запроса, когда заголовки под рукой: имя заголовка определитель знает сам.
// Заголовок к этому моменту уже проверен швом входа — недоверенный оттуда снят.
//
// Параметры:
//  АдресКлиента - Строка - адрес клиента, каким его знает хаб.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//
// Возвращаемое значение:
//  Структура - Исход, Страна, Источник, Причина (см. Определить).
//
Функция ОпределитьПоЗапросу(Знач АдресКлиента, Знач ЗаголовкиЗапроса) Экспорт
	Возврат Определить(АдресКлиента, Чтение.Текст(ЗаголовкиЗапроса, ИмяЗаголовка()));
КонецФункции

// Ключ настройки с именем заголовка страны от обратного прокси.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючЗаголовка() Экспорт
	Возврат "oshub.geo.header";
КонецФункции

// Ключ настройки с порядком источников.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючПорядка() Экспорт
	Возврат "oshub.geo.source_order";
КонецФункции

// Имя заголовка, в котором обратный прокси называет страну.
//
// Возвращаемое значение:
//  Строка - имя заголовка; пустая строка — заголовок не читается вовсе.
//
Функция ИмяЗаголовка() Экспорт
	Возврат Настройки.Текстом(КлючЗаголовка(), "CF-IPCountry");
КонецФункции

// Источники в том порядке, в каком их спрашивают.
//
// Возвращаемое значение:
//  Массив из Строка - «база» и «прокси».
//
Функция ПорядокИсточников() Экспорт

	Результат = Новый Массив();
	Если НРег(Настройки.Текстом(КлючПорядка(), ПорядокПоУмолчанию())) = ПорядокОтПрокси() Тогда
		Результат.Добавить(ИсточникПрокси());
		Результат.Добавить(ИсточникБазы());
	Иначе
		Результат.Добавить(ИсточникБазы());
		Результат.Добавить(ИсточникПрокси());
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Имя источника «встроенная база».
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсточникБазы() Экспорт
	Возврат "база";
КонецФункции

// Имя источника «заголовок доверенного прокси».
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсточникПрокси() Экспорт
	Возврат "прокси";
КонецФункции

// Объявляет, какие страны нужны действующим правилам: под них и строится индекс. Пока
// новый индекс строится, хаб отвечает по прежнему, если он есть.
//
// Параметры:
//  Страны - Массив из Строка - коды стран в любой записи; пустой массив — наблюдать нечего.
//
Процедура НаблюдатьСтраны(Знач Страны) Экспорт
	База.НаблюдатьСтраны(Страны);
КонецПроцедуры

// Страны, которые хаб различает прямо сейчас, — набор действующего индекса.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция НаблюдаемыеСтраны() Экспорт
	Возврат База.НаблюдаемыеСтраны();
КонецФункции

// Страны, которые назвали правила. От наблюдаемых отличаются ровно тем временем, пока
// строится новый индекс, — и ещё тогда, когда построить его не из чего.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ЗаказанныеСтраны() Экспорт
	Возврат База.ЗаказанныеСтраны();
КонецФункции

// Что сейчас с файлом базы: есть ли он, когда изменён, сколько в индексе диапазонов,
// под какой набор он строится.
//
// Возвращаемое значение:
//  Структура - см. БазаСтран.Состояние.
//
Функция СостояниеБазы() Экспорт
	Возврат База.Состояние();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Источники спрашиваются по порядку; первый, которому есть что сказать, и отвечает.
// Не ответил ни один — неизвестна, и причиной становится отказ старшего источника.
Функция ПоИсточникам(Знач Адрес, Знач КодОтПрокси)

	Отказ = "";

	Для Каждого Источник Из ПорядокИсточников() Цикл
		Спрошенный = ?(Источник = ИсточникПрокси(), ПоЗаголовку(КодОтПрокси), ПоБазе(Адрес));
		Если Спрошенный.Ответ <> Неопределено Тогда
			Возврат Спрошенный.Ответ;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Отказ) Тогда
			Отказ = Спрошенный.Причина;
		КонецЕсли;
	КонецЦикла;

	Возврат Неизвестна(Отказ);

КонецФункции

// Снимок базы берётся ОДИН раз на вызов: два раздельных вопроса к разным полям дали бы
// ответ про одно состояние и причину про другое.
Функция ПоБазе(Знач Адрес)

	Ответ = База.ОтветБазы();
	Если Ответ.Индекс = Неопределено Тогда
		Возврат БезОтвета(Ответ.Причина);
	КонецЕсли;

	Код = Ответ.Индекс.Страна(Порядок.Ключ(Адрес));
	Если ЗначениеЗаполнено(Код) Тогда
		Возврат СОтветом(Известна(Код, ИсточникБазы()));
	КонецЕсли;

	Возврат СОтветом(НеНаблюдаемая(ИсточникБазы(),
		"адрес публичный, но ни в один диапазон наблюдаемых стран не попал"));

КонецФункции

// Заголовку здесь уже можно верить: недоверенное соединение сняло его на шве входа,
// и второй проверки доверия тут нет — она одна, и живёт там, где известен адрес соединения.
Функция ПоЗаголовку(Знач КодОтПрокси)

	Имя = ИмяЗаголовка();
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Возврат БезОтвета("заголовок страны не читается: имя заголовка не задано");
	КонецЕсли;

	Код = Справочник.Канон(КодОтПрокси);
	Если НЕ ЗначениеЗаполнено(Код) Тогда
		Возврат БезОтвета(СтрШаблон("заголовок %1 страны не принёс", Имя));
	КонецЕсли;

	Возврат СОтветом(Известна(Код, ИсточникПрокси()));

КонецФункции

Функция СОтветом(Знач Вердикт)
	Возврат Новый Структура("Ответ, Причина", Вердикт, "");
КонецФункции

Функция БезОтвета(Знач Причина)
	Возврат Новый Структура("Ответ, Причина", Неопределено, Причина);
КонецФункции

Функция Известна(Знач Код, Знач Источник)
	Возврат НовыйВердикт(Исходы().Известна, Код, Источник, "");
КонецФункции

Функция НеНаблюдаемая(Знач Источник, Знач Причина)
	Возврат НовыйВердикт(Исходы().НеНаблюдаемая, "", Источник, Причина);
КонецФункции

Функция Неизвестна(Знач Причина)
	Возврат НовыйВердикт(Исходы().Неизвестна, "", "", Причина);
КонецФункции

Функция НовыйВердикт(Знач Исход, Знач Страна, Знач Источник, Знач Причина)
	Возврат Новый Структура("Исход, Страна, Источник, Причина",
		Исход, Страна, Источник, Причина);
КонецФункции

Функция ПорядокПоУмолчанию()
	Возврат "база-прокси";
КонецФункции

Функция ПорядокОтПрокси()
	Возврат "прокси-база";
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "БазаСтран") _База,
	&Пластилин(Значение = "СвояСеть") _Политика,
	&Пластилин(Значение = "КанонIP") _Канон,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ЗаголовкиHTTP") _Чтение = Неопределено,
	&Пластилин(Значение = "СправочникСтран") _Справочник = Неопределено) Экспорт

	База = _База;
	Политика = _Политика;
	Канон = _Канон;
	Настройки = _Настройки;
	Чтение = ?(_Чтение = Неопределено, Новый ЗаголовкиHTTP(), _Чтение);
	Справочник = ?(_Справочник = Неопределено, Новый СправочникСтран(), _Справочник);
	Порядок = Новый ПорядокАдресов();
	ИсходыВердикта = Новый Структура("Известна, НеНаблюдаемая, Неизвестна",
		"известна", "не-наблюдаемая", "неизвестна");

КонецПроцедуры
