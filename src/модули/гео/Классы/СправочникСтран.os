// Коды стран для всего хаба: одна дверь к справочнику ISO 3166-1 alpha-2. Спрашивают
// и определитель страны, и тот, кто проверяет введённое администратором.
//
// Сам справочник живёт в страна/КодыСтран и аннотаций ОСени не несёт — это граница
// будущего сателлита. Этот класс её не дублирует, а только делает желудём: второго списка
// кодов на хабе нет и быть не должно.

Перем Коды;  // КодыСтран (гео)

// Код страны в канонической записи — две прописные латинские буквы.
//
// Параметры:
//  Запись - Строка - код страны в любой записи.
//
// Возвращаемое значение:
//  Строка - код; пустая строка — страны с таким кодом нет.
//
Функция Канон(Знач Запись) Экспорт
	Возврат Коды.Канон(Запись);
КонецФункции

// Называет ли запись страну.
//
// Параметры:
//  Запись - Строка - код страны в любой записи.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоКод(Знач Запись) Экспорт
	Возврат Коды.ЭтоКодСтраны(Запись);
КонецФункции

// Все известные коды в алфавитном порядке.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Все() Экспорт
	Возврат Коды.Все();
КонецФункции

// Сколько кодов знает справочник.
//
// Возвращаемое значение:
//  Число.
//
Функция Количество() Экспорт
	Возврат Коды.Количество();
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
	Коды = Новый КодыСтран();
КонецПроцедуры
