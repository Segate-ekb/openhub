// Годен ли файл быть базой стран: строк не меньше порога, оба семейства адресов на месте,
// а хвост строки — запятая и две буквы кода. Проверяется КАНДИДАТ, до подмены: оборванная
// закачка и страница ошибки чужого сервера выглядят файлом ровно так же, как база.

Перем Буквы;

#Область ПубличныйИнтерфейс

// Судит файл, не разбирая его целиком: семейство узнаётся по двоеточию в записи адреса,
// код — по хвосту строки.
//
// Параметры:
//  Путь - Строка - полное имя проверяемого файла.
//  МинимумСтрок - Число - меньше этого числа строк базой не считается
//                 (необязательный, по умолчанию 100000).
//
// Возвращаемое значение:
//  Структура - Годен (Булево), Причина (Строка, словами; пустая у годного),
//              Строк (Число), IPv4 (Число), IPv6 (Число), Битых (Число).
//
Функция Проверить(Знач Путь, Знач МинимумСтрок = 100000) Экспорт

	Итог = Новый Структура("Годен, Причина, Строк, IPv4, IPv6, Битых",
		Ложь, "", 0, 0, 0, 0);

	Если НЕ Новый Файл(Путь).Существует() Тогда
		Итог.Причина = СтрШаблон("файла %1 нет", Путь);
		Возврат Итог;
	КонецЕсли;

	Сосчитать(Итог, Путь);
	Итог.Причина = Возражение(Итог, МинимумСтрок);
	Итог.Годен = НЕ ЗначениеЗаполнено(Итог.Причина);

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Сосчитать(Итог, Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, "UTF-8");

	Попытка
		Строчка = Чтение.ПрочитатьСтроку();
		Пока Строчка <> Неопределено Цикл
			Итог.Строк = Итог.Строк + 1;
			Если НЕ ХвостПохожНаКод(Строчка) Тогда
				Итог.Битых = Итог.Битых + 1;
			ИначеЕсли Найти(Строчка, ":") > 0 Тогда
				Итог.IPv6 = Итог.IPv6 + 1;
			Иначе
				Итог.IPv4 = Итог.IPv4 + 1;
			КонецЕсли;
			Строчка = Чтение.ПрочитатьСтроку();
		КонецЦикла;
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Чтение.Закрыть();

КонецПроцедуры

Функция Возражение(Знач Итог, Знач МинимумСтрок)

	Если Итог.Строк < МинимумСтрок Тогда
		Возврат СтрШаблон("строк %1, а база стран короче %2 не бывает",
			Итог.Строк, МинимумСтрок);
	КонецЕсли;

	Если Итог.IPv4 = 0 Тогда
		Возврат "в файле нет ни одного диапазона IPv4";
	КонецЕсли;

	Если Итог.IPv6 = 0 Тогда
		Возврат "в файле нет ни одного диапазона IPv6";
	КонецЕсли;

	// одиночная испорченная строка базу не отменяет, а сплошной мусор — это не база:
	// страница ошибки чужого сервера тоже состоит из строк
	Если Итог.Битых * 100 > Итог.Строк Тогда
		Возврат СтрШаблон("строк без кода страны %1 из %2 — это не файл базы",
			Итог.Битых, Итог.Строк);
	КонецЕсли;

	Возврат "";

КонецФункции

// Хвост строки базы — запятая и две прописные латинские буквы: «,RU», «,ZZ». Проверяется
// форма, а не членство в справочнике: «ZZ» кодом страны не является, но строкой базы — да.
Функция ХвостПохожНаКод(Знач Строчка)

	Если СтрДлина(Строчка) < 3 ИЛИ Сред(Строчка, СтрДлина(Строчка) - 2, 1) <> "," Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Найти(Буквы, Сред(Строчка, СтрДлина(Строчка) - 1, 1)) > 0
		И Найти(Буквы, Прав(Строчка, 1)) > 0;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	Буквы = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
КонецПроцедуры
