// Коды стран ISO 3166-1 alpha-2: запись приводится к канону, а несуществующий код страной
// не становится. «ZZ», «XX», «T1» и пустая запись — это «страна неизвестна»: такими метками
// база помечает диапазоны, за которыми страны нет.

Перем Известные;  // Соответствие: код -> Истина
Перем Порядок;    // Массив из Строка в алфавитном порядке

#Область ПубличныйИнтерфейс

// Код страны в канонической записи — две прописные латинские буквы.
//
// Параметры:
//  Запись - Строка - код страны в любой записи.
//
// Возвращаемое значение:
//  Строка - код; пустая строка — страны с таким кодом нет.
//
Функция Канон(Знач Запись) Экспорт

	Текст = ВРег(СокрЛП(Строка(?(Запись = Неопределено, "", Запись))));
	Возврат ?(Известные.Получить(Текст) = Неопределено, "", Текст);

КонецФункции

// Называет ли запись страну.
//
// Параметры:
//  Запись - Строка - код страны в любой записи.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоКодСтраны(Знач Запись) Экспорт
	Возврат ЗначениеЗаполнено(Канон(Запись));
КонецФункции

// Все известные коды в алфавитном порядке.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Все() Экспорт

	Результат = Новый Массив();
	Для Каждого Код Из Порядок Цикл
		Результат.Добавить(Код);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Сколько кодов знает справочник.
//
// Возвращаемое значение:
//  Число.
//
Функция Количество() Экспорт
	Возврат Порядок.Количество();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Объявить(Знач Строчка)

	Для Каждого Код Из СтрРазделить(Строчка, " ", Ложь) Цикл
		Порядок.Добавить(Код);
		Известные.Вставить(Код, Истина);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

Процедура ПриСозданииОбъекта()

	Известные = Новый Соответствие();
	Порядок = Новый Массив();

	// Назначенные коды ISO 3166-1 alpha-2, и сверх них «XK». Стандарт ISO 3166 кода XK
	// не назначает; так Косово зовут DB-IP и большинство геобаз, и без него диапазоны
	// Косова наблюдать нечем.
	Объявить("AD AE AF AG AI AL AM AO AQ AR AS AT AU AW AX");
	Объявить("AZ BA BB BD BE BF BG BH BI BJ BL BM BN BO BQ");
	Объявить("BR BS BT BV BW BY BZ CA CC CD CF CG CH CI CK");
	Объявить("CL CM CN CO CR CU CV CW CX CY CZ DE DJ DK DM");
	Объявить("DO DZ EC EE EG EH ER ES ET FI FJ FK FM FO FR");
	Объявить("GA GB GD GE GF GG GH GI GL GM GN GP GQ GR GS");
	Объявить("GT GU GW GY HK HM HN HR HT HU ID IE IL IM IN");
	Объявить("IO IQ IR IS IT JE JM JO JP KE KG KH KI KM KN");
	Объявить("KP KR KW KY KZ LA LB LC LI LK LR LS LT LU LV");
	Объявить("LY MA MC MD ME MF MG MH MK ML MM MN MO MP MQ");
	Объявить("MR MS MT MU MV MW MX MY MZ NA NC NE NF NG NI");
	Объявить("NL NO NP NR NU NZ OM PA PE PF PG PH PK PL PM");
	Объявить("PN PR PS PT PW PY QA RE RO RS RU RW SA SB SC");
	Объявить("SD SE SG SH SI SJ SK SL SM SN SO SR SS ST SV");
	Объявить("SX SY SZ TC TD TF TG TH TJ TK TL TM TN TO TR");
	Объявить("TT TV TW TZ UA UG UM US UY UZ VA VC VE VG VI");
	Объявить("VN VU WF WS XK YE YT ZA ZM ZW");

КонецПроцедуры
