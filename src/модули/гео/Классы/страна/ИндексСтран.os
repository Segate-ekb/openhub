// Диапазоны адресов по странам, сложенные для двоичного поиска: на каждое семейство —
// три параллельных массива (начала, концы, страны), упорядоченных по началу диапазона.
//
// Индекс наполняют один раз, до того как им начинают пользоваться: читающих потоков много,
// и правка на месте рвала бы им массивы. Новый набор стран — новый индекс, а не правка этого.

Перем Порядок;      // ПорядокАдресов
Перем Полки;        // Соответствие: семейство -> Структура(Начала, Концы, Страны, Упорядочена)
Перем Страны_;      // Соответствие: код -> Истина
Перем Диапазонов_;
Перем Сортировали_;

#Область Наполнение

// Добавляет диапазон в конец своей полки.
//
// Параметры:
//  НачалоКлюч - Структура - ключ первого адреса диапазона (ПорядокАдресов).
//  КонецКлюч - Структура - ключ последнего адреса диапазона.
//  Страна - Строка - код страны диапазона.
//
Процедура Добавить(Знач НачалоКлюч, Знач КонецКлюч, Знач Страна) Экспорт

	Полка = Полки.Получить(НачалоКлюч.Семейство);
	Если Полка = Неопределено Тогда
		ВызватьИсключение СтрШаблон("ИндексСтран: семейство %1 неизвестно", НачалоКлюч.Семейство);
	КонецЕсли;

	Предыдущее = Полка.Начала.Количество() - 1;
	Если Предыдущее >= 0 И Порядок.Сравнить(Полка.Начала[Предыдущее], НачалоКлюч) > 0 Тогда
		Полка.Упорядочена = Ложь;
	КонецЕсли;

	Полка.Начала.Добавить(НачалоКлюч);
	Полка.Концы.Добавить(КонецКлюч);
	Полка.Страны.Добавить(Страна);

	Страны_.Вставить(Страна, Истина);
	Диапазонов_ = Диапазонов_ + 1;

КонецПроцедуры

// Приводит полки в порядок. Файл базы отсортирован внутри семейства, поэтому сортируется
// только та полка, где порядок и вправду нарушен: сортировка семисот тысяч строк ради
// того, что уже отсортировано, — это вся цена сборки заново.
//
Процедура Упорядочить() Экспорт

	Для Каждого КиЗ Из Полки Цикл
		Если НЕ КиЗ.Значение.Упорядочена Тогда
			Отсортировать(КиЗ.Значение);
			КиЗ.Значение.Упорядочена = Истина;
			Сортировали_ = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Поиск

// Страна, чьему диапазону принадлежит адрес.
//
// Параметры:
//  Ключ - Структура - ключ адреса (ПорядокАдресов).
//
// Возвращаемое значение:
//  Строка - код страны; пустая строка — адрес не попал ни в один диапазон индекса.
//
Функция Страна(Знач Ключ) Экспорт

	Полка = Полки.Получить(Ключ.Семейство);
	Если Полка = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Позиция = ПоследнийНачавшийсяНеПозже(Полка, Ключ);
	Если Позиция < 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат ?(Порядок.Сравнить(Ключ, Полка.Концы[Позиция]) <= 0, Полка.Страны[Позиция], "");

КонецФункции

#КонецОбласти

#Область ЧтоВИндексе

// Сколько диапазонов в индексе.
//
// Возвращаемое значение:
//  Число.
//
Функция Диапазонов() Экспорт
	Возврат Диапазонов_;
КонецФункции

// Сколько диапазонов лежит на полке семейства.
//
// Параметры:
//  Семейство - Число - семейство адреса (ПорядокАдресов.IPv4, .IPv6).
//
// Возвращаемое значение:
//  Число.
//
Функция ДиапазоновСемейства(Знач Семейство) Экспорт

	Полка = Полки.Получить(Семейство);
	Возврат ?(Полка = Неопределено, 0, Полка.Начала.Количество());

КонецФункции

// Страны, диапазоны которых в индексе есть.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Страны() Экспорт

	Результат = Новый Массив();
	Для Каждого КиЗ Из Страны_ Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пришлось ли сортировать хоть одну полку: у файла, пришедшего в своём порядке, — Ложь.
//
// Возвращаемое значение:
//  Булево.
//
Функция Сортировали() Экспорт
	Возврат Сортировали_;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Последний диапазон, начавшийся не позже адреса. Диапазоны базы не перекрываются,
// поэтому попадание проверяется ровно по нему.
Функция ПоследнийНачавшийсяНеПозже(Знач Полка, Знач Ключ)

	Левая = 0;
	Правая = Полка.Начала.Количество() - 1;
	Найденная = -1;

	Пока Левая <= Правая Цикл
		Середина = Цел((Левая + Правая) / 2);
		Если Порядок.Сравнить(Полка.Начала[Середина], Ключ) <= 0 Тогда
			Найденная = Середина;
			Левая = Середина + 1;
		Иначе
			Правая = Середина - 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Найденная;

КонецФункции

// Сортировка идёт через таблицу значений: своего сравнения массивов в платформе нет,
// а пузырёк на пятнадцати тысячах диапазонов стоит дороже всей сборки.
Процедура Отсортировать(Полка)

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Старшие");
	Таблица.Колонки.Добавить("Младшие");
	Таблица.Колонки.Добавить("Позиция");

	Для Позиция = 0 По Полка.Начала.ВГраница() Цикл
		Строчка = Таблица.Добавить();
		Строчка.Старшие = Полка.Начала[Позиция].Старшие;
		Строчка.Младшие = Полка.Начала[Позиция].Младшие;
		Строчка.Позиция = Позиция;
	КонецЦикла;

	Таблица.Сортировать("Старшие, Младшие");

	Начала = Новый Массив();
	Концы = Новый Массив();
	Страны = Новый Массив();
	Для Каждого Строчка Из Таблица Цикл
		Начала.Добавить(Полка.Начала[Строчка.Позиция]);
		Концы.Добавить(Полка.Концы[Строчка.Позиция]);
		Страны.Добавить(Полка.Страны[Строчка.Позиция]);
	КонецЦикла;

	Полка.Начала = Начала;
	Полка.Концы = Концы;
	Полка.Страны = Страны;

КонецПроцедуры

Функция НоваяПолка()
	Возврат Новый Структура("Начала, Концы, Страны, Упорядочена",
		Новый Массив(), Новый Массив(), Новый Массив(), Истина);
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач _Порядок = Неопределено)

	Порядок = ?(_Порядок = Неопределено, Новый ПорядокАдресов(), _Порядок);
	Страны_ = Новый Соответствие();
	Диапазонов_ = 0;
	Сортировали_ = Ложь;

	// полки заводятся сразу обе: структурная правка Соответствия из читающего потока
	// рвёт его, а читают индекс потоки запросов
	Полки = Новый Соответствие();
	Полки.Вставить(Порядок.IPv4(), НоваяПолка());
	Полки.Вставить(Порядок.IPv6(), НоваяПолка());

КонецПроцедуры
