// Индекс по файлу «первый адрес,последний адрес,код»: строки наблюдаемых стран отбираются
// по хвосту до разбора; битая строка считается и сборку не роняет.

Перем Порядок;  // ПорядокАдресов

#Область ПубличныйИнтерфейс

// Собирает индекс наблюдаемых стран по файлу базы.
//
// Параметры:
//  Путь - Строка - полное имя файла базы.
//  Страны - Массив из Строка - наблюдаемые коды стран в каноне; пустой массив —
//           наблюдать нечего, и файл не открывается вовсе.
//
// Возвращаемое значение:
//  Структура - Индекс (ИндексСтран), Строк (Число, прочитано), Принято (Число, легло
//              в индекс), Битых (Число, отобрано хвостом, но не разобрано),
//              Сортировали (Булево, файл пришёл не в своём порядке).
//
Функция ПоФайлу(Знач Путь, Знач Страны) Экспорт

	Индекс = Новый ИндексСтран(Порядок);
	Итог = Новый Структура("Индекс, Строк, Принято, Битых, Сортировали",
		Индекс, 0, 0, 0, Ложь);

	Хвосты = Хвосты(Страны);
	Если Хвосты.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;

	Прочитать(Итог, Индекс, Хвосты, Путь);

	Индекс.Упорядочить();
	Итог.Сортировали = Индекс.Сортировали();

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Прочитать(Итог, Индекс, Знач Хвосты, Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, "UTF-8");

	Попытка
		Строчка = Чтение.ПрочитатьСтроку();
		Пока Строчка <> Неопределено Цикл
			Итог.Строк = Итог.Строк + 1;
			Если Хвосты.Получить(Прав(Строчка, ДлинаХвоста())) <> Неопределено Тогда
				Если Принять(Индекс, Строчка) Тогда
					Итог.Принято = Итог.Принято + 1;
				Иначе
					Итог.Битых = Итог.Битых + 1;
				КонецЕсли;
			КонецЕсли;
			Строчка = Чтение.ПрочитатьСтроку();
		КонецЦикла;
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

	Чтение.Закрыть();

КонецПроцедуры

Функция Принять(Индекс, Знач Строчка)

	Части = СтрРазделить(Строчка, ",", Истина);
	Если Части.Количество() <> 3 Тогда
		Возврат Ложь;
	КонецЕсли;

	Первый = Порядок.КлючЗаписи(Части[0]);
	Последний = Порядок.КлючЗаписи(Части[1]);
	Если Первый = Неопределено ИЛИ Последний = Неопределено
		ИЛИ Первый.Семейство <> Последний.Семейство
		ИЛИ Порядок.Сравнить(Первый, Последний) > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Индекс.Добавить(Первый, Последний, СокрЛП(Части[2]));
	Возврат Истина;

КонецФункции

// Запятая плюс две буквы кода: отбор строки — одно Прав и один поиск.
Функция ДлинаХвоста()
	Возврат 3;
КонецФункции

Функция Хвосты(Знач Страны)

	Результат = Новый Соответствие();
	Если Страны = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Код Из Страны Цикл
		Запись = СокрЛП(Строка(Код));
		Если СтрДлина(Запись) = ДлинаХвоста() - 1 Тогда
			Результат.Вставить("," + Запись, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач _Порядок = Неопределено)
	Порядок = ?(_Порядок = Неопределено, Новый ПорядокАдресов(), _Порядок);
КонецПроцедуры
