// Файл базы стран в инсталляции: путь, отпечаток «размер плюс время изменения» и подмена
// через временный файл рядом. Отпечаток нужен, чтобы заметить файл, положенный руками:
// перечитывать тридцать мегабайт на каждом тике не за чем, а размер и время меняются.
//
// Подмена идёт tmp → rename, и прежний файл уезжает в сторону, а не удаляется: fsync
// платформе недоступен, и сбой посреди подмены обязан оставить инсталляцию с базой.

Перем ПутьФайла;

#Область ПубличныйИнтерфейс

// Полное имя файла базы.
//
// Возвращаемое значение:
//  Строка.
//
Функция Путь() Экспорт
	Возврат ПутьФайла;
КонецФункции

// Имя файла базы без каталога.
//
// Возвращаемое значение:
//  Строка.
//
Функция Имя() Экспорт
	Возврат Новый Файл(ПутьФайла).Имя;
КонецФункции

// Лежит ли файл на месте.
//
// Возвращаемое значение:
//  Булево.
//
Функция Существует() Экспорт
	Возврат Новый Файл(ПутьФайла).Существует();
КонецФункции

// Отпечаток файла: размер и время изменения одной строкой.
//
// Возвращаемое значение:
//  Строка - отпечаток; пустая строка — файла нет.
//
Функция Отпечаток() Экспорт

	Файл = Новый Файл(ПутьФайла);
	Если НЕ Файл.Существует() Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("%1:%2", Файл.Размер(),
		Формат(Файл.ПолучитьВремяИзменения(), "ДФ=yyyyMMddHHmmss"));

КонецФункции

// Время последнего изменения файла.
//
// Возвращаемое значение:
//  Дата - время изменения; пустая дата — файла нет.
//
Функция ДатаИзменения() Экспорт

	Файл = Новый Файл(ПутьФайла);
	Возврат ?(Файл.Существует(), Файл.ПолучитьВремяИзменения(), '00010101');

КонецФункции

// Имя временного файла рядом с базой — в него пишется кандидат до подмены.
//
// Возвращаемое значение:
//  Строка.
//
Функция ВременныйПуть() Экспорт
	Возврат ПутьФайла + ".tmp";
КонецФункции

// Создаёт каталог базы, если его ещё нет.
//
Процедура ОбеспечитьКаталог() Экспорт

	Каталог = Новый Файл(ПутьФайла).Путь;
	Если ЗначениеЗаполнено(Каталог) И НЕ Новый Файл(Каталог).Существует() Тогда
		СоздатьКаталог(Каталог);
	КонецЕсли;

КонецПроцедуры

// Ставит подготовленный файл на место базы. Прежняя база уезжает в сторону и удаляется
// только после удачной подмены; сорвавшаяся подмена возвращает её обратно.
//
// Параметры:
//  Кандидат - Строка - полное имя готового файла.
//
Процедура Заменить(Знач Кандидат) Экспорт

	ОбеспечитьКаталог();
	Прежняя = ПутьФайла + ".прежняя";
	Убрать(Прежняя);

	Если Существует() Тогда
		ПереместитьФайл(ПутьФайла, Прежняя);
	КонецЕсли;

	Попытка
		ПереместитьФайл(Кандидат, ПутьФайла);
	Исключение
		Если Новый Файл(Прежняя).Существует() Тогда
			ПереместитьФайл(Прежняя, ПутьФайла);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	// уборка отработавшей копии идёт молча: подмена УЖЕ удалась, и жалоба на неубранный
	// файл сошла бы за «подменить не удалось» — хаб остался бы с индексом от старой базы
	Попытка
		Убрать(Прежняя);
	Исключение
		Возврат;
	КонецПопытки;

КонецПроцедуры

// Убирает временный файл, оставшийся от сорвавшегося обновления.
//
Процедура УбратьВременный() Экспорт
	Убрать(ВременныйПуть());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Убрать(Знач Путь)
	Если Новый Файл(Путь).Существует() Тогда
		УдалитьФайлы(Путь);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач Путь)

	Запись = СокрЛП(Строка(?(Путь = Неопределено, "", Путь)));
	Если НЕ ЗначениеЗаполнено(Запись) Тогда
		ВызватьИсключение "ФайлБазыСтран создан без пути — читать и подменять нечего";
	КонецЕсли;

	ПутьФайла = Новый Файл(Запись).ПолноеИмя;

КонецПроцедуры
