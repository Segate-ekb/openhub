// Markdown README версии из её репозитория на GitHub: сырое содержимое на теге версии, затем
// в ветке по умолчанию. API GitHub и его лимита здесь нет — только адреса файлов.

Перем Транспорт;          // ТранспортHTTP (сеть)
Перем Таймауты;           // ТаймаутыHTTP (сеть)
Перем АдресСодержимого;   // Строка — корень сырого содержимого без хвостового слеша
Перем Ошибки;             // ТекстОшибки (основа)
Перем Уборка;             // ТихаяУборка (основа) — временный файл тела ответа

#Область ПубличныйИнтерфейс

// Ищет README версии в репозитории: теги «v<версия>» и «<версия>», затем ветка по умолчанию;
// на каждом рефе — README.md, readme.md, Readme.md. Первый отказ GitHub, кроме «файла нет»,
// поиск обрывает: остальные адреса спрашивать незачем.
//
// Параметры:
//  Репозиторий - Структура - Владелец, Имя (как у РепозиторийGitHub.Координаты).
//  Версия      - Строка    - строка версии.
//
// Возвращаемое значение:
//  Структура - Исход (Строка: "найден", "нет" либо "сбой"), Текст (Строка — Markdown README),
//              Вид (Строка: "tag" либо "default_branch"), Реф (Строка — тег либо "HEAD"),
//              Ссылка (Строка — файл на GitHub), Причина (Строка — что ответил GitHub на сбое).
//
Функция НайтиВРепозитории(Знач Репозиторий, Знач Версия) Экспорт

	Для Каждого Реф Из Рефы(Версия) Цикл
		Для Каждого Файл Из ИменаФайла() Цикл

			Отклик = Спросить(Репозиторий, Реф.Имя, Файл);
			Если Отклик.Исход = "найден" Тогда
				Возврат Найденное(Отклик.Текст, Реф, СтраницаФайла(Репозиторий, Реф.Имя, Файл));
			ИначеЕсли Отклик.Исход = "сбой" Тогда
				Возврат Отклик;
			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

	Возврат Исход("нет", "");

КонецФункции

#КонецОбласти

#Область Адреса

// Тег без «v» — вторая запись того же номера; номер, уже начатый с «v», второй записи не даёт.
Функция Рефы(Знач Версия)

	Номер = СокрЛП(Строка(Версия));
	Порядок = Новый Массив();
	Если НЕ СтрНачинаетсяС(НРег(Номер), "v") Тогда
		Порядок.Добавить(НовыйРеф("tag", "v" + Номер));
	КонецЕсли;
	Порядок.Добавить(НовыйРеф("tag", Номер));
	Порядок.Добавить(НовыйРеф("default_branch", "HEAD"));

	Возврат Порядок;

КонецФункции

// Имя файла на GitHub чувствительно к регистру: это записи, которые авторы пакетов пишут на деле.
Функция ИменаФайла()
	Возврат СтрРазделить("README.md,readme.md,Readme.md", ",");
КонецФункции

Функция АдресФайла(Знач Репозиторий, Знач Реф, Знач Файл)
	Возврат СтрШаблон("%1/%2/%3/%4/%5", АдресСодержимого, Репозиторий.Владелец, Репозиторий.Имя,
		Сегмент(Реф), Файл);
КонецФункции

// HEAD в адресе страницы файла GitHub сам ведёт на ветку по умолчанию.
Функция СтраницаФайла(Знач Репозиторий, Знач Реф, Знач Файл)
	Возврат СтрШаблон("https://github.com/%1/%2/blob/%3/%4", Репозиторий.Владелец, Репозиторий.Имя,
		Сегмент(Реф), Файл);
КонецФункции

// Номер версии — один сегмент адреса: «+» метаданных сборки и прочее кодируется.
Функция Сегмент(Знач Значение)
	Возврат КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти

#Область Отклик

// «Файла нет» — 404 и переадресация: по Location поиск не идёт, адрес он строит сам. Тело
// ложится во временный файл, а не в память: в память читается только то, что не больше предела.
Функция Спросить(Знач Репозиторий, Знач Реф, Знач Файл)

	Адрес = АдресФайла(Репозиторий, Реф, Файл);
	ПутьТела = Уборка.ВременныйПуть("readme-github-", "md");
	Попытка
		Отклик = Прочитанное(Адрес, ПутьТела);
	Исключение
		Отклик = Исход("сбой", СтрШаблон("%1 не ответил: %2", Адрес, Ошибки.Причина(ИнформацияОбОшибке())));
	КонецПопытки;
	Уборка.УдалитьФайл(ПутьТела);

	Возврат Отклик;

КонецФункции

Функция Прочитанное(Знач Адрес, Знач ПутьТела)

	Ответ = Транспорт.Скачать(Адрес, ПутьТела, , Таймауты.ТаймаутСлужебногоЗапроса(), Истина, Ложь);

	Если Ответ.Код = 404 ИЛИ (Ответ.Код >= 300 И Ответ.Код < 400) Тогда
		Возврат Исход("нет", "");
	ИначеЕсли Ответ.Код <> 200 Тогда
		Возврат Исход("сбой", СтрШаблон("%1 ответил кодом %2", Адрес, Формат(Ответ.Код, "ЧГ=0")));
	КонецЕсли;

	// ответ без тела файла не создаёт: показывать нечего
	Тело = Новый Файл(ПутьТела);
	Если НЕ Тело.Существует() Тогда
		Возврат Исход("нет", "");
	ИначеЕсли Тело.Размер() > ПотолокБайт() Тогда
		Возврат Исход("сбой", СтрШаблон("%1 больше %2 байт", Адрес, Формат(ПотолокБайт(), "ЧГ=0")));
	КонецЕсли;

	Текст = ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(ПутьТела), "UTF-8");
	Если НЕ ЗначениеЗаполнено(СокрЛП(Текст)) Тогда
		Возврат Исход("нет", "");
	КонецЕсли;

	Результат = Исход("найден", "");
	Результат.Текст = Текст;
	Возврат Результат;

КонецФункции

// README в мегабайт — уже не описание: столько страница пакета не показывает.
Функция ПотолокБайт()
	Возврат 1048576;
КонецФункции

Функция НовыйРеф(Знач Вид, Знач Имя)
	Возврат Новый Структура("Вид, Имя", Вид, Имя);
КонецФункции

Функция Найденное(Знач Текст, Знач Реф, Знач Ссылка)

	Результат = Исход("найден", "");
	Результат.Текст = Текст;
	Результат.Вид = Реф.Вид;
	Результат.Реф = Реф.Имя;
	Результат.Ссылка = Ссылка;
	Возврат Результат;

КонецФункции

Функция Исход(Знач Какой, Знач Причина)
	Возврат Новый Структура("Исход, Текст, Вид, Реф, Ссылка, Причина", Какой, "", "", "", "", Причина);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТранспортHTTP") _Транспорт,
	&Пластилин(Значение = "ТаймаутыHTTP") _Таймауты,
	&Пластилин(Значение = "ТихаяУборка") _Уборка,
	&Деталька(Значение = "oshub.readme.repository.raw.url", ЗначениеПоУмолчанию = "https://raw.githubusercontent.com")
	_АдресСодержимого = "https://raw.githubusercontent.com",
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Уборка = _Уборка;
	Транспорт = _Транспорт;
	Таймауты = _Таймауты;
	Адрес = СокрЛП(Строка(_АдресСодержимого));
	Пока СтрЗаканчиваетсяНа(Адрес, "/") Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	АдресСодержимого = ?(ЗначениеЗаполнено(Адрес), Адрес, "https://raw.githubusercontent.com");

КонецПроцедуры
