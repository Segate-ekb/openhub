// Описание версии на диске — README из пакета рядом с артефактом и справка о том, что ответил
// о нём репозиторий пакета. Наружу не бросает ничего: описание — не то, из-за чего срывается приём версии.

#Использовать errors

Перем Хранилище;   // ХранилищеАртефактов (хранилище)
Перем Адреса;      // КоординатыREADME
Перем Момент;      // МоментISO (основа)
Перем Ошибки;      // ТекстОшибки (основа)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Кладёт рядом с артефактом описание версии из её пакета. Пустой текст — законное значение
// «README в пакете нет»: оно запоминается наравне с текстом, иначе страница такого пакета
// распаковывала бы .ospx на каждый показ. Справка о репозитории при этом снимается:
// описание снова из пакета.
//
// Параметры:
//  ИмяПула   - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета, под которым записан артефакт версии.
//  Версия    - Строка - строка версии.
//  Текст     - Строка - Markdown README; "" — README у версии нет.
//
// Возвращаемое значение:
//  Число - приращение занятого пулом места, байты; 0, если записать не удалось.
//
Функция Записать(Знач ИмяПула, Знач ИмяПакета, Знач Версия, Знач Текст) Экспорт

	Адрес = АдресОписания(ИмяПула, ИмяПакета, Версия);
	Если Адрес = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Дельта = Положить(Адрес, Строка(Текст), ИмяПакета, Версия);
	Если Дельта = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Дельта - Убрать(АдресСправки(ИмяПула, ИмяПакета, Версия), ИмяПакета, Версия);

КонецФункции

// Длина описания версии на диске, без его скачивания.
//
// Параметры:
//  ИмяПула   - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета, под которым записан артефакт версии.
//  Версия    - Строка - строка версии.
//
// Возвращаемое значение:
//  Число, Неопределено - байты (0 — README в пакете нет); Неопределено, если описания на диске
//                        нет либо хранилище о нём не ответило.
//
Функция ДлинаОписания(Знач ИмяПула, Знач ИмяПакета, Знач Версия) Экспорт

	Адрес = АдресОписания(ИмяПула, ИмяПакета, Версия);
	Если Адрес = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Длина = РазмерИлиНеопределено(Адрес);
	Исключение
		Лог.Предупреждение("Описание версии ""%1"" %2 с диска не прочиталось: %3",
			ИмяПакета, Версия, Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

	Если Длина = Неопределено Тогда
		Лог.Отладка("Описание версии ""%1"" %2 на диске не лежит — придётся снять с .ospx",
			ИмяПакета, Версия);
	КонецЕсли;
	Возврат Длина;

КонецФункции

// Читает описание версии с диска. Пустое описание узнаётся по размеру и не скачивается.
//
// Параметры:
//  ИмяПула   - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета, под которым записан артефакт версии.
//  Версия    - Строка - строка версии.
//
// Возвращаемое значение:
//  Строка, Неопределено - Markdown README из пакета ("" — у версии его нет); Неопределено,
//                         если на диске описания нет и его надо снимать с артефакта.
//
Функция Прочитать(Знач ИмяПула, Знач ИмяПакета, Знач Версия) Экспорт

	Длина = ДлинаОписания(ИмяПула, ИмяПакета, Версия);
	Если Длина = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли Длина = 0 Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат ТекстФайла(АдресОписания(ИмяПула, ИмяПакета, Версия));
	Исключение
		Лог.Предупреждение("Описание версии ""%1"" %2 с диска не прочиталось: %3",
			ИмяПакета, Версия, Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Кладёт справку о том, что ответил репозиторий пакета о README версии, вместе с найденным
// текстом; описание из пакета не трогает.
//
// Параметры:
//  ИмяПула   - Строка    - имя пула.
//  ИмяПакета - Строка    - имя пакета, под которым записан артефакт версии.
//  Версия    - Строка    - строка версии.
//  Справка   - Структура - как у ПрочитатьСправку.
//
// Возвращаемое значение:
//  Число - приращение занятого пулом места, байты; 0, если записать не удалось.
//
Функция ЗаписатьСправку(Знач ИмяПула, Знач ИмяПакета, Знач Версия, Знач Справка) Экспорт

	Адрес = АдресСправки(ИмяПула, ИмяПакета, Версия);
	Если Адрес = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Дельта = Положить(Адрес, СправкаТекстом(Справка), ИмяПакета, Версия);
	Возврат ?(Дельта = Неопределено, 0, Дельта);

КонецФункции

// Читает справку о том, что ответил репозиторий пакета о README версии.
//
// Параметры:
//  ИмяПула   - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета, под которым записан артефакт версии.
//  Версия    - Строка - строка версии.
//
// Возвращаемое значение:
//  Структура, Неопределено - Репозиторий (Строка — адрес, у которого спрашивали),
//                            Спрошено (Дата, UTC), Найдено (Булево), Вид (Строка — "tag"
//                            либо "default_branch"; "" — не найдено), Реф (Строка — тег либо
//                            "HEAD"), Ссылка (Строка — файл на GitHub), Текст (Строка — Markdown
//                            найденного README); Неопределено — в репозиторий за README этой
//                            версии не ходили либо справка не читается.
//
Функция ПрочитатьСправку(Знач ИмяПула, Знач ИмяПакета, Знач Версия) Экспорт

	Адрес = АдресСправки(ИмяПула, ИмяПакета, Версия);
	Если Адрес = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат СправкаИзТекста(ТекстФайла(Адрес));
	Исключение
		Инфо = ИнформацияОбОшибке();
		Если НЕ ЭтоОтсутствие(Инфо) Тогда
			Лог.Предупреждение("Справка о README версии ""%1"" %2 с диска не прочиталась: %3",
				ИмяПакета, Версия, Ошибки.Причина(Инфо));
		КонецЕсли;
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Снимает описание версии и справку о нём с диска. Идемпотентна: отсутствие файлов не ошибка.
//
// Параметры:
//  ИмяПула   - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета, под которым записан артефакт версии.
//  Версия    - Строка - строка версии.
//
// Возвращаемое значение:
//  Число - освобождённые байты.
//
Функция Снять(Знач ИмяПула, Знач ИмяПакета, Знач Версия) Экспорт

	Возврат Убрать(АдресОписания(ИмяПула, ИмяПакета, Версия), ИмяПакета, Версия)
		+ Убрать(АдресСправки(ИмяПула, ИмяПакета, Версия), ИмяПакета, Версия);

КонецФункции

#КонецОбласти

#Область Файлы

// Неопределено — файл не лёг; иначе приращение занятого места.
Функция Положить(Знач Адрес, Знач Текст, Знач ИмяПакета, Знач Версия)

	Попытка
		БылоБайт = РазмерИлиНоль(Адрес);
		Записанное = Хранилище.Сохранить(Адрес, ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8"));
	Исключение
		Лог.Предупреждение(
			"Описание версии ""%1"" %2 не легло на диск (%3) — страница соберёт его заново: %4",
			ИмяПакета, Версия, Адрес.ИмяФайла(), Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

	Лог.Отладка("Описание версии ""%1"" %2 лежит на диске (%3): %4 байт (было %5)",
		ИмяПакета, Версия, Адрес.ИмяФайла(), Записанное.Размер, БылоБайт);
	Возврат Записанное.Размер - БылоБайт;

КонецФункции

// Освобождённые байты; файла не было либо он не снялся — ноль.
Функция Убрать(Знач Адрес, Знач ИмяПакета, Знач Версия)

	Если Адрес = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Освобождается = РазмерИлиНеопределено(Адрес);
		Если Освобождается = Неопределено Тогда
			Возврат 0;
		КонецЕсли;
		Хранилище.Удалить(Адрес);
	Исключение
		Лог.Предупреждение("Описание версии ""%1"" %2 не снято с диска (%3): %4",
			ИмяПакета, Версия, Адрес.ИмяФайла(), Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат 0;
	КонецПопытки;

	Возврат Освобождается;

КонецФункции

// Один вопрос хранилищу: «нет такого файла» отличается от нуля байт кодом отказа, а не вторым запросом.
Функция РазмерИлиНеопределено(Знач Адрес)

	Попытка
		Возврат Макс(0, Цел(Число(Хранилище.Размер(Адрес))));
	Исключение
		Инфо = ИнформацияОбОшибке();
		Если ЭтоОтсутствие(Инфо) Тогда
			Возврат Неопределено;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// Замер для дельты: файла нет или замер не удался — ноль, перезапись и уборка считают разницу.
Функция РазмерИлиНоль(Знач Адрес)

	Попытка
		Размер = РазмерИлиНеопределено(Адрес);
	Исключение
		Возврат 0;
	КонецПопытки;
	Возврат ?(Размер = Неопределено, 0, Размер);

КонецФункции

Функция ТекстФайла(Знач Адрес)
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Хранилище.ПолучитьДанные(Адрес), "UTF-8");
КонецФункции

Функция ЭтоОтсутствие(Знач Инфо)
	Возврат ДиагностикаОшибок.Содержит(Инфо, КодыСтандартныхОшибок.РесурсНеНайден());
КонецФункции

// Имя описания длиннее имени артефакта: пакет с очень длинным именем живёт без дискового кэша.
Функция АдресОписания(Знач ИмяПула, Знач ИмяПакета, Знач Версия)

	Попытка
		Возврат Адреса.ДляВерсии(ИмяПула, ИмяПакета, Версия);
	Исключение
		Лог.Отладка("Описание версии ""%1"" %2 в координаты хранилища не укладывается —"
			+ " кэша описания у этого пакета не будет: %3",
			ИмяПакета, Версия, Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Не укладывается в координаты — справки нет, и в репозиторий за этой версией не ходят.
Функция АдресСправки(Знач ИмяПула, Знач ИмяПакета, Знач Версия)

	Попытка
		Возврат Адреса.СправкиДляВерсии(ИмяПула, ИмяПакета, Версия);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Справка

Функция СправкаТекстом(Знач Справка)

	Данные = Новый Структура();
	Данные.Вставить("repository", Строка(Справка.Репозиторий));
	Данные.Вставить("asked_at", Момент.Строкой(Справка.Спрошено));
	Данные.Вставить("found", Справка.Найдено = Истина);
	Данные.Вставить("ref_kind", Строка(Справка.Вид));
	Данные.Вставить("ref", Строка(Справка.Реф));
	Данные.Вставить("url", Строка(Справка.Ссылка));
	Данные.Вставить("readme", Строка(Справка.Текст));

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

// Справку пишет только хаб; не разобралась — значит, в репозиторий её версии не ходили.
Функция СправкаИзТекста(Знач Текст)

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Прочитанная = Новый Структура("Репозиторий, Спрошено, Найдено, Вид, Реф, Ссылка, Текст");
	Прочитанная.Репозиторий = Строкой(Данные.Получить("repository"));
	Прочитанная.Спрошено = XMLЗначение(Тип("Дата"), СтрЗаменить(Строкой(Данные.Получить("asked_at")), "Z", ""));
	Прочитанная.Найдено = (Данные.Получить("found") = Истина);
	Прочитанная.Вид = Строкой(Данные.Получить("ref_kind"));
	Прочитанная.Реф = Строкой(Данные.Получить("ref"));
	Прочитанная.Ссылка = Строкой(Данные.Получить("url"));
	Прочитанная.Текст = ?(Данные.Получить("readme") = Неопределено, "", Строка(Данные.Получить("readme")));

	Возврат Прочитанная;

КонецФункции

Функция Строкой(Знач Значение)
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеАртефактов") _Хранилище,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Хранилище = _Хранилище;
	Адреса = Новый КоординатыREADME();
	Момент = Новый МоментISO();
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
