// Описание версии на диске — желудь модуля описания: текст README рядом с артефактом.
// Наружу не бросает ничего: описание — не то, из-за чего срывается приём версии.

Перем Хранилище;   // ХранилищеАртефактов (хранилище)
Перем Адреса;      // КоординатыREADME
Перем Ошибки;      // ТекстОшибки (основа)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Кладёт описание версии рядом с её артефактом. Пустой текст — законное значение
// «у версии описания нет»: оно запоминается наравне с текстом, иначе страница такого
// пакета распаковывала бы .ospx на каждый показ.
//
// Параметры:
//  ИмяПула   - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета, под которым записан артефакт версии.
//  Версия    - Строка - строка версии.
//  Текст     - Строка - Markdown README; "" — README у версии нет.
//
// Возвращаемое значение:
//  Число - приращение занятого пулом места, байты; 0, если записать не удалось.
//
Функция Записать(Знач ИмяПула, Знач ИмяПакета, Знач Версия, Знач Текст) Экспорт

	Адрес = АдресОписания(ИмяПула, ИмяПакета, Версия);
	Если Адрес = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		БылоБайт = РазмерИлиНоль(Адрес);
		Записанное = Хранилище.Сохранить(Адрес,
			ПолучитьДвоичныеДанныеИзСтроки(Строка(Текст), "UTF-8"));
	Исключение
		Лог.Предупреждение(
			"Описание версии ""%1"" %2 не легло на диск — страница соберёт его из .ospx: %3",
			ИмяПакета, Версия, Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат 0;
	КонецПопытки;

	Лог.Отладка("Описание версии ""%1"" %2 лежит на диске: %3 байт (было %4)",
		ИмяПакета, Версия, Записанное.Размер, БылоБайт);
	Возврат Записанное.Размер - БылоБайт;

КонецФункции

// Читает описание версии с диска.
//
// Параметры:
//  ИмяПула   - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета, под которым записан артефакт версии.
//  Версия    - Строка - строка версии.
//
// Возвращаемое значение:
//  Строка, Неопределено - Markdown README ("" — у версии его нет); Неопределено, если
//                         на диске описания нет и его надо снимать с артефакта.
//
Функция Прочитать(Знач ИмяПула, Знач ИмяПакета, Знач Версия) Экспорт

	Адрес = АдресОписания(ИмяПула, ИмяПакета, Версия);
	Если Адрес = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Если НЕ Хранилище.Существует(Адрес) Тогда
			Лог.Отладка("Описание версии ""%1"" %2 на диске не лежит — придётся снять с .ospx",
				ИмяПакета, Версия);
			Возврат Неопределено;
		КонецЕсли;
		Возврат ПолучитьСтрокуИзДвоичныхДанных(Хранилище.ПолучитьДанные(Адрес), "UTF-8");
	Исключение
		Лог.Предупреждение("Описание версии ""%1"" %2 с диска не прочиталось: %3",
			ИмяПакета, Версия, Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Снимает описание версии с диска. Идемпотентна: отсутствие файла не ошибка.
//
// Параметры:
//  ИмяПула   - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета, под которым записан артефакт версии.
//  Версия    - Строка - строка версии.
//
// Возвращаемое значение:
//  Число - освобождённые байты.
//
Функция Снять(Знач ИмяПула, Знач ИмяПакета, Знач Версия) Экспорт

	Адрес = АдресОписания(ИмяПула, ИмяПакета, Версия);
	Если Адрес = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Освобождается = РазмерИлиНоль(Адрес);
		Хранилище.Удалить(Адрес);
	Исключение
		Лог.Предупреждение("Описание версии ""%1"" %2 не снято с диска: %3",
			ИмяПакета, Версия, Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат 0;
	КонецПопытки;

	Возврат Освобождается;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Имя описания длиннее имени артефакта: пакет с очень длинным именем живёт без дискового кэша.
Функция АдресОписания(Знач ИмяПула, Знач ИмяПакета, Знач Версия)

	Попытка
		Возврат Адреса.ДляВерсии(ИмяПула, ИмяПакета, Версия);
	Исключение
		Лог.Отладка("Описание версии ""%1"" %2 в координаты хранилища не укладывается —"
			+ " кэша описания у этого пакета не будет: %3",
			ИмяПакета, Версия, Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Замер несуществующего файла — не ошибка, а ноль: перезапись и уборка считают дельту.
Функция РазмерИлиНоль(Знач Адрес)

	Попытка
		Возврат ?(Хранилище.Существует(Адрес), Макс(0, Цел(Число(Хранилище.Размер(Адрес)))), 0);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеАртефактов") _Хранилище,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Хранилище = _Хранилище;
	Адреса = Новый КоординатыREADME();
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
