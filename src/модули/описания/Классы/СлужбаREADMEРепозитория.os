// README версии из репозитория её пакета, когда в самом пакете его нет: пора ли спрашивать GitHub
// и что положить рядом с описанием. Наружу не бросает: описание не срывает ни приём, ни обход.

Перем ХранилищеОписаний;  // ХранилищеREADME
Перем Источник;           // ИсточникREADMEGitHub
Перем Репозитории;        // РепозиторийGitHub (основа)
Перем Настройки;          // СервисНастроек (настройки)
Перем Ошибки;             // ТекстОшибки (основа)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Дополняет описание версии README из репозитория пакета на GitHub. В репозиторий идёт, только
// если поход включён, у пакета адрес на github.com, описание версии на диске пусто и о нём
// репозиторий ещё не спрашивали: не спрашивали вовсе, спрашивали другой адрес либо прошлый
// вопрос без ответа был в прошлые сутки. Найденное ложится справкой рядом с описанием, и только
// пока описание всё ещё пусто: README пакета, легший за время похода, главнее. Отказ GitHub
// пишется в журнал одной строкой.
//
// Параметры:
//  Пул    - Пул          - пул пакета.
//  Пакет  - Пакет        - пакет; нужен адрес репозитория.
//  Версия - ВерсияПакета, Неопределено - версия; Неопределено — дополнять нечего.
//
// Возвращаемое значение:
//  Число - приращение занятого пулом места, байты; 0 — на диск ничего не легло.
//
Функция Дополнить(Знач Пул, Знач Пакет, Знач Версия) Экспорт

	Попытка
		Возврат ДополнитьИзРепозитория(Пул, Пакет, Версия);
	Исключение
		Лог.Предупреждение("README версии ""%1"" %2 из репозитория не взят: %3",
			Пакет.Имя, ?(Версия = Неопределено, "", Версия.Версия), Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат 0;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДополнитьИзРепозитория(Знач Пул, Знач Пакет, Знач Версия)

	Если Версия = Неопределено ИЛИ НЕ Настройки.Флаг("oshub.readme.repository.enabled", Истина) Тогда
		Возврат 0;
	КонецЕсли;

	Адрес = СокрЛП(Строка(Пакет.АдресРепозитория));
	Репозиторий = Репозитории.Координаты(Адрес);
	Если Репозиторий = Неопределено ИЛИ НЕ ОписаниеПусто(Пул, Пакет, Версия) Тогда
		Возврат 0;
	КонецЕсли;

	Если НЕ ПораСпросить(ХранилищеОписаний.ПрочитатьСправку(Пул.Имя, Пакет.Имя, Версия.Версия), Адрес) Тогда
		Возврат 0;
	КонецЕсли;

	Найденное = Источник.НайтиВРепозитории(Репозиторий, Версия.Версия);

	// поход длится до минуты: за это время версию могли переопубликовать с README в пакете
	Если НЕ ОписаниеПусто(Пул, Пакет, Версия) Тогда
		Лог.Отладка("README версии ""%1"" %2 из репозитория не положен: за время похода лёг README пакета",
			Пакет.Имя, Версия.Версия);
		Возврат 0;
	КонецЕсли;

	Если Найденное.Исход = "найден" Тогда
		Лог.Информация("README версии ""%1"" %2 взят из репозитория: %3",
			Пакет.Имя, Версия.Версия, Найденное.Ссылка);
	ИначеЕсли Найденное.Исход = "сбой" Тогда
		Лог.Предупреждение("README версии ""%1"" %2 из репозитория %3 не получен — страница"
			+ " остаётся без описания до следующей попытки: %4",
			Пакет.Имя, Версия.Версия, Адрес, Найденное.Причина);
	Иначе
		Лог.Отладка("README версии ""%1"" %2 нет и в репозитории %3: ни на теге, ни в ветке по умолчанию",
			Пакет.Имя, Версия.Версия, Адрес);
	КонецЕсли;

	Возврат ХранилищеОписаний.ЗаписатьСправку(Пул.Имя, Пакет.Имя, Версия.Версия, НоваяСправка(Адрес, Найденное));

КонецФункции

// Длина без скачивания: нуль байт — README в пакете нет; описания на диске нет — неизвестно.
Функция ОписаниеПусто(Знач Пул, Знач Пакет, Знач Версия)
	Возврат ХранилищеОписаний.ДлинаОписания(Пул.Имя, Пакет.Имя, Версия.Версия) = 0;
КонецФункции

// Найденный README больше не ищут. Ненайденный — спрашивают снова через сутки по часам: ночной
// обход идёт в один и тот же час, и секунды его очерёдности не должны отодвигать повтор на
// следующую ночь. Сменился адрес — вопрос новый, а не повтор.
Функция ПораСпросить(Знач Справка, Знач Адрес)

	Если Справка = Неопределено ИЛИ Справка.Репозиторий <> Адрес Тогда
		Возврат Истина;
	ИначеЕсли Справка.Найдено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НачалоЧаса(ТекущаяУниверсальнаяДата()) >= НачалоЧаса(Справка.Спрошено) + СекундВСутках();

КонецФункции

Функция НоваяСправка(Знач Адрес, Знач Найденное)

	Справка = Новый Структура("Репозиторий, Спрошено, Найдено, Вид, Реф, Ссылка, Текст");
	Справка.Репозиторий = Адрес;
	Справка.Спрошено = ТекущаяУниверсальнаяДата();
	Справка.Найдено = (Найденное.Исход = "найден");
	Справка.Вид = Найденное.Вид;
	Справка.Реф = Найденное.Реф;
	Справка.Ссылка = Найденное.Ссылка;
	Справка.Текст = Найденное.Текст;

	Возврат Справка;

КонецФункции

Функция СекундВСутках()
	Возврат 86400;
КонецФункции

#КонецОбласти

&Желудь
&Наблюдаемый
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеREADME") _ХранилищеОписаний,
	&Пластилин(Значение = "ИсточникREADMEGitHub") _Источник,
	&Пластилин(Значение = "РепозиторийGitHub") _Репозитории,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	ХранилищеОписаний = _ХранилищеОписаний;
	Источник = _Источник;
	Репозитории = _Репозитории;
	Настройки = _Настройки;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
