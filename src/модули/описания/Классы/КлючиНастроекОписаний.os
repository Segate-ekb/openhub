// Ключи настроек описаний: ходить ли за README в репозиторий пакета и куда.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей описаний в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи описаний.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(180)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "oshub.readme.repository.enabled", ЗначениеПоУмолчанию = "") _ИзРепозитория = "",
	&Деталька(Значение = "oshub.readme.repository.raw.url", ЗначениеПоУмолчанию = "") _АдресСодержимого = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	// Политика похода наружу: инсталляция в закрытой сети выключает его, и README у версии
	// без него в пакете не появится.
	Ключи.Объявить("oshub.readme.repository.enabled", "булево", Истина, Неопределено, "прикладная",
		_ИзРепозитория);
	// Откуда берётся сырое содержимое репозитория GitHub — часть развёртывания.
	Ключи.Объявить("oshub.readme.repository.raw.url", "строка", "https://raw.githubusercontent.com",
		_Правила.Адрес(), "bootstrap", _АдресСодержимого);

КонецПроцедуры
