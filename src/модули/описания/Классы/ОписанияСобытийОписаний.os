// События описаний словами: README версии из репозитория пакета появился или пропал.

Перем События;  // ОбъявленияСобытий (события)

#Область ПубличныйИнтерфейс

// Объявления событий описаний в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияСобытий - события описаний словами.
//
Функция Объявления() Экспорт
	Возврат События;
КонецФункции

#КонецОбласти

&Прозвище("ОписанияСобытий")
&Порядок(25)
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ИздательСобытий") _Издатель) Экспорт

	События = Новый ОбъявленияСобытий();

	События.ОбъявитьВнутреннее(_Издатель.ТипОписаниеВерсииИзменено(), "Описание версии изменено",
		"README версии, найденный в репозитории пакета, лёг рядом с версией либо перестал"
		+ " показываться на её странице.",
		"Фоновая запись без принципала: README из репозитория кладут фон публикации и ночной"
		+ " обход. Событие нужно тем, кто держит готовые страницы; действие над хабом уже"
		+ " записано событием публикации или синка.");

КонецПроцедуры
