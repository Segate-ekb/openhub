// Кэш отрендеренного README — желудь модуля описания.
// Потокобезопасен: читают обработчики winow, пишет фоновая рогатка прогрева.

Перем Записи;         // Соответствие - идВерсии -> Структура(ЕстьREADME, HTML)
Перем Блокировка;     // БлокировкаРесурса

// Возвращает закэшированное представление README по ключу.
//
// Параметры:
//  Ключ - Произвольный - идентификатор версии.
//
// Возвращаемое значение:
//  Структура, Неопределено - ЕстьREADME, HTML либо Неопределено при промахе кэша.
//
Функция Получить(Знач Ключ) Экспорт
	Блокировка.Заблокировать();
	Попытка
		Значение = Записи.Получить(Ключ);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();
	Возврат Значение;
КонецФункции

// Кладёт представление README в кэш, перезаписывая имеющееся.
//
// Параметры:
//  Ключ     - Произвольный - идентификатор версии.
//  Значение - Структура    - ЕстьREADME, HTML.
//
Процедура Сохранить(Знач Ключ, Знач Значение) Экспорт
	Блокировка.Заблокировать();
	Попытка
		Записи.Вставить(Ключ, Значение);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();
КонецПроцедуры

// Признак наличия ключа в кэше.
//
// Параметры:
//  Ключ - Произвольный - идентификатор версии.
//
// Возвращаемое значение:
//  Булево
//
Функция Содержит(Знач Ключ) Экспорт
	Возврат Получить(Ключ) <> Неопределено;
КонецФункции

// Число записей в кэше.
//
// Возвращаемое значение:
//  Число
//
Функция Размер() Экспорт
	Блокировка.Заблокировать();
	Попытка
		Количество = Записи.Количество();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();
	Возврат Количество;
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
	Записи = Новый Соответствие();
	Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
КонецПроцедуры
