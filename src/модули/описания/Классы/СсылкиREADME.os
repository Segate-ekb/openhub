// Относительные адреса отрисованного README — в файлы его репозитория: ссылка — на страницу файла,
// картинка — на сам файл; адрес без места в репозитории снимается.

Перем Адреса;     // АдресаРепозитория
Перем Рендерер;   // РендерерREADME

#Область ПубличныйИнтерфейс

// Разрешает относительные href и src безопасного HTML README от репозитория пакета. Путь
// считается от каталога README в репозитории, «/» в начале — от корня репозитория, «..» выше
// корня репозиторий не покидает. Абсолютные адреса, «//хост», «mailto:», «#якорь» и «?запрос»
// остаются как были. Без репозитория относительный адрес снимается: ссылка становится текстом,
// картинка остаётся подписью. Изменённая разметка ещё раз проходит санитайзер.
//
// Параметры:
//  БезопасныйHTML   - Строка - результат РендерерREADME.ВБезопасныйHTML.
//  АдресРепозитория - Строка - адрес репозитория из карточки пакета; недоверенное значение.
//  Источник         - Структура, Неопределено - откуда README, как у СлужбаREADME.ПредставлениеREADME:
//                     Вид ("tag" либо "default_branch") и Реф; Неопределено — README из пакета.
//
// Возвращаемое значение:
//  Строка - санитизированный HTML.
//
Функция ВРепозиторий(Знач БезопасныйHTML, Знач АдресРепозитория, Знач Источник) Экспорт

	Если НЕ ЗначениеЗаполнено(БезопасныйHTML) Тогда
		Возврат БезопасныйHTML;
	КонецЕсли;

	Основа = ОсноваАдресов(Адреса.Разобрать(АдресРепозитория), Источник);

	Части = Новый Массив();
	Начало = 1;
	Найденный = СледующийАдрес(БезопасныйHTML, Начало);
	Пока Найденный <> Неопределено Цикл

		Адрес = ИзЗначенияАтрибута(Найденный.Значение);
		Если ЭтоОтносительный(Адрес) Тогда
			Части.Добавить(Сред(БезопасныйHTML, Начало, Найденный.Начало - Начало));
			Части.Добавить(ЗаписьАтрибута(Найденный.Имя, Разрешённый(Адрес, Найденный.Имя = "src", Основа)));
			Начало = Найденный.Конец;
		КонецЕсли;
		Найденный = СледующийАдрес(БезопасныйHTML, Найденный.Конец);

	КонецЦикла;

	Если Части.Количество() = 0 Тогда
		Возврат БезопасныйHTML;
	КонецЕсли;

	Части.Добавить(Сред(БезопасныйHTML, Начало));

	// новый адрес прошёл не через санитайзер — последнее слово за ним, он же ставит rel внешней ссылке
	Возврат Рендерер.ОчиститьHTML(БезСсылокБезАдреса(СтрСоединить(Части, "")));

КонецФункции

#КонецОбласти

#Область Основа

// README из репозитория — в корне на рефе находки; из пакета — по адресу карточки (тег версии без сети не проверить).
Функция ОсноваАдресов(Знач Репозиторий, Знач Источник)

	Основа = Новый Структура("Репозиторий, Реф, Каталог", Репозиторий, Неопределено, "");
	Если Репозиторий = Неопределено Тогда
		Возврат Основа;
	КонецЕсли;

	Если Источник = Неопределено Тогда
		Основа.Реф = Репозиторий.Реф;
		Основа.Каталог = Репозиторий.Каталог;
	Иначе
		Основа.Реф = Адреса.Реф(Источник.Реф, ?(Источник.Вид = "tag", "tag", "branch"));
	КонецЕсли;

	Возврат Основа;

КонецФункции

#КонецОбласти

#Область Разрешение

// Схема, «//хост», «#якорь» и «?запрос» — не путь в репозитории. Схему санитайзер уже проверил.
Функция ЭтоОтносительный(Знач Адрес)

	Первый = Лев(Адрес, 1);
	Если Адрес = "" ИЛИ Первый = "#" ИЛИ Первый = "?" ИЛИ СтрНачинаетсяС(Адрес, "//") Тогда
		Возврат Ложь;
	КонецЕсли;

	Двоеточие = СтрНайти(Адрес, ":");
	Если Двоеточие = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Разделитель Из СтрРазделить("/,?,#", ",") Цикл
		Позиция = СтрНайти(Адрес, Разделитель);
		Если Позиция > 0 И Позиция < Двоеточие Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Пустая строка — адресу нет места в репозитории, атрибут снимается.
Функция Разрешённый(Знач Адрес, Знач НуженСамФайл, Знач Основа)

	Если Основа.Репозиторий = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	КонецПути = КонецПути(Адрес);
	Путь = ПутьВРепозитории(Лев(Адрес, КонецПути - 1), Основа.Каталог);
	Хвост = Сред(Адрес, КонецПути);

	Если Путь = Неопределено ИЛИ (НуженСамФайл И Путь = "") Тогда
		Возврат "";
	ИначеЕсли НуженСамФайл Тогда
		Возврат Адреса.СыройФайл(Основа.Репозиторий, Основа.Реф, Путь) + Хвост;
	КонецЕсли;

	Возврат Адреса.СтраницаФайла(Основа.Репозиторий, Основа.Реф, Путь) + Хвост;

КонецФункции

// Позиция «?» либо «#», с которой начинается хвост адреса; нет их — за концом строки.
Функция КонецПути(Знач Адрес)

	Конец = СтрДлина(Адрес) + 1;
	Для Каждого Разделитель Из СтрРазделить("?,#", ",") Цикл
		Позиция = СтрНайти(Адрес, Разделитель);
		Если Позиция > 0 И Позиция < Конец Тогда
			Конец = Позиция;
		КонецЕсли;
	КонецЦикла;
	Возврат Конец;

КонецФункции

// Путь от корня репозитория, сегменты раскодированы; Неопределено — «..» выводит выше корня.
Функция ПутьВРепозитории(Знач Путь, Знач Каталог)

	Сегменты = Новый Массив();
	Если НЕ СтрНачинаетсяС(Путь, "/") И ЗначениеЗаполнено(Каталог) Тогда
		Для Каждого Сегмент Из СтрРазделить(Каталог, "/") Цикл
			Сегменты.Добавить(Сегмент);
		КонецЦикла;
	КонецЕсли;

	Для Каждого Сегмент Из СтрРазделить(Путь, "/", Ложь) Цикл
		Имя = РаскодироватьСтроку(Сегмент, СпособКодированияСтроки.КодировкаURL);
		Если Имя = "." Тогда
			Продолжить;
		ИначеЕсли Имя = ".." Тогда
			Если Сегменты.Количество() = 0 Тогда
				Возврат Неопределено;
			КонецЕсли;
			Сегменты.Удалить(Сегменты.ВГраница());
		Иначе
			Сегменты.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Сегменты, "/");

КонецФункции

#КонецОбласти

#Область СсылкаБезАдреса

// Ссылка без адреса — текст: тег снимается с ближайшим закрывающим (ссылки не вкладываются).
Функция БезСсылокБезАдреса(Знач HTML)

	Части = Новый Массив();
	Начало = 1;
	Открытие = СледующаяСсылка(HTML, Начало);
	Пока Открытие > 0 Цикл

		КонецТега = СтрНайти(HTML, ">", НаправлениеПоиска.СНачала, Открытие);
		Закрытие = ?(КонецТега = 0, 0, СтрНайти(HTML, "</a>", НаправлениеПоиска.СНачала, КонецТега));
		Если Закрытие = 0 Тогда
			Прервать;
		КонецЕсли;

		Если СтрНайти(Сред(HTML, Открытие, КонецТега - Открытие), " href=""") = 0 Тогда
			Части.Добавить(Сред(HTML, Начало, Открытие - Начало));
			Части.Добавить(Сред(HTML, КонецТега + 1, Закрытие - КонецТега - 1));
			Начало = Закрытие + СтрДлина("</a>");
		КонецЕсли;
		Открытие = СледующаяСсылка(HTML, КонецТега);

	КонецЦикла;

	Части.Добавить(Сред(HTML, Начало));
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция СледующаяСсылка(Знач HTML, Знач С)

	Ближайшая = 0;
	Для Каждого Запись Из СтрРазделить("<a>,<a ", ",") Цикл
		Позиция = СтрНайти(HTML, Запись, НаправлениеПоиска.СНачала, С);
		Если Позиция > 0 И (Ближайшая = 0 ИЛИ Позиция < Ближайшая) Тогда
			Ближайшая = Позиция;
		КонецЕсли;
	КонецЦикла;
	Возврат Ближайшая;

КонецФункции

#КонецОбласти

#Область ЗначениеАтрибута

// Ближайший « href="…"»/« src="…"»: санитайзер пишет кавычку сущностью, вне тегов такой записи нет.
Функция СледующийАдрес(Знач HTML, Знач С)

	Ближайший = Неопределено;
	Для Каждого Имя Из СтрРазделить("href,src", ",") Цикл
		Запись = СтрШаблон(" %1=""", Имя);
		Позиция = СтрНайти(HTML, Запись, НаправлениеПоиска.СНачала, С);
		Если Позиция > 0 И (Ближайший = Неопределено ИЛИ Позиция < Ближайший.Начало) Тогда
			Ближайший = Новый Структура("Имя, Начало, НачалоЗначения", Имя, Позиция, Позиция + СтрДлина(Запись));
		КонецЕсли;
	КонецЦикла;

	Если Ближайший = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Кавычка = СтрНайти(HTML, """", НаправлениеПоиска.СНачала, Ближайший.НачалоЗначения);
	Если Кавычка = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ближайший.Вставить("Значение", Сред(HTML, Ближайший.НачалоЗначения, Кавычка - Ближайший.НачалоЗначения));
	Ближайший.Вставить("Конец", Кавычка + 1);
	Возврат Ближайший;

КонецФункции

// Санитайзер печатает значения атрибутов пятью сущностями — их и снимаем.
Функция ИзЗначенияАтрибута(Знач Значение)

	Значение = СтрЗаменить(Значение, "&quot;", """");
	Значение = СтрЗаменить(Значение, "&#39;", "'");
	Значение = СтрЗаменить(Значение, "&lt;", "<");
	Значение = СтрЗаменить(Значение, "&gt;", ">");
	Возврат СтрЗаменить(Значение, "&amp;", "&");

КонецФункции

// Пустое значение — атрибута нет вовсе.
Функция ЗаписьАтрибута(Знач Имя, Знач Значение)

	Если Значение = "" Тогда
		Возврат "";
	КонецЕсли;

	Значение = СтрЗаменить(Значение, "&", "&amp;");
	Значение = СтрЗаменить(Значение, """", "&quot;");
	Значение = СтрЗаменить(Значение, "'", "&#39;");
	Значение = СтрЗаменить(Значение, "<", "&lt;");
	Значение = СтрЗаменить(Значение, ">", "&gt;");

	Возврат СтрШаблон(" %1=""%2""", Имя, Значение);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "АдресаРепозитория") _Адреса,
	&Пластилин(Значение = "РендерерREADME") _Рендерер) Экспорт

	Адреса = _Адреса;
	Рендерер = _Рендерер;

КонецПроцедуры
