// Недоверенный Markdown → HTML → санитизация; санитизация обязательна всегда.
// Пресет GitHub-like: авторы пакетов пишут README для GitHub.

#Использовать oscript-md

// Рендерит Markdown в санитизированный HTML, безопасный для вставки в страницу.
//
// Параметры:
//  ТекстMarkdown - Строка - исходный README (недоверенный).
//
// Возвращаемое значение:
//  Строка - санитизированный HTML.
//
Функция ВБезопасныйHTML(Знач ТекстMarkdown) Экспорт

	Если НЕ ЗначениеЗаполнено(ТекстMarkdown) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Markdown.ВБезопасныйHTML(ТекстMarkdown, Markdown.НастройкиGitHubLike());

КонецФункции

// Говорит, есть ли в отрендеренном README блок кода с языком — тот, что раскрашивает подсветка.
//
// Параметры:
//  БезопасныйHTML - Строка - результат ВБезопасныйHTML.
//
// Возвращаемое значение:
//  Булево - Истина, если есть хотя бы один блок кода с языком.
//
Функция ЕстьКодСЯзыком(Знач БезопасныйHTML) Экспорт
	// блок с языком разбор печатает как <pre><code class="language-…">, без языка — без класса
	Возврат СтрНайти(БезопасныйHTML, "<pre><code class=""language-") > 0;
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
