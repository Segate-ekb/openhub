// Прогревщик README — желудь модуля описания: обход всех пакетов с рендером README
// последней версии в кэш. Идемпотентен, best-effort. Зовут стартовая рогатка и jobs.

Перем СервисПулов;
Перем СервисПакетов;
Перем СервисВерсий;
Перем СлужбаREADME;

#Область ПубличныйИнтерфейс

// Прогревает кэш README последних версий всех пакетов. Ошибка на отдельном пакете
// проход не роняет — пакет попадает в «пропущено».
//
// Возвращаемое значение:
//  Структура - Обработано (Число), Пропущено (Число).
//
Функция ПрогретьВсе() Экспорт

	Сводка = Новый Структура("Обработано, Пропущено", 0, 0);

	Для Каждого Пакет Из СервисПакетов.ВсеПакеты() Цикл

		Попытка

			Пул = СервисПулов.ПулПоИдентификатору(Пакет.ПулИдентификатор);
			Если Пул = Неопределено Тогда
				Сводка.Пропущено = Сводка.Пропущено + 1;
				Продолжить;
			КонецЕсли;

			Версия = СервисВерсий.ПоследняяВерсия(Пакет.Идентификатор);
			Если Версия = Неопределено Тогда
				Сводка.Пропущено = Сводка.Пропущено + 1;
				Продолжить;
			КонецЕсли;

			СлужбаREADME.ПредставлениеREADME(Пул, Пакет, Версия);
			Сводка.Обработано = Сводка.Обработано + 1;

		Исключение
			// best-effort: пропускаем проблемный пакет, не роняя проход
			Сводка.Пропущено = Сводка.Пропущено + 1;
		КонецПопытки;

	КонецЦикла;

	Возврат Сводка;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СлужбаREADME") _СлужбаREADME)

	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;
	СлужбаREADME = _СлужбаREADME;

КонецПроцедуры
