// Прогрев README — фоновая рогатка модуля описания: при старте прогревает кэш README
// последних версий всех пакетов. Оптимизация, не гарантия — промах кэша чинит СлужбаREADME.

Перем Прогревщик;  // ПрогревщикREADME
&Лог
Перем Лог;

// Точка входа рогатки: прогревает кэш README последних версий всех пакетов.
//
Процедура ПриЗапускеПриложения() Экспорт
	// Без перехвата сбой прогрева не оставит в журнале ни строки: фоновую рогатку
	// с ОжидатьЗавершения = Ложь ОСень не дожидается и её исход не смотрит.
	Попытка
		Прогревщик.ПрогретьВсе();
	Исключение
		Лог.Ошибка("Прогрев README прерван, кэш остался холодным: %1",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

&Рогатка(ЗапускатьВФоне = Истина, ОжидатьЗавершения = Ложь)
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПрогревщикREADME") _Прогревщик,
	&Лог _Лог = Неопределено)

	Прогревщик = _Прогревщик;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
