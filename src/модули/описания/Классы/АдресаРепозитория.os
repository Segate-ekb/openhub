// Репозиторий пакета по его адресу и адреса файлов в нём: страница файла и сам файл на GitHub,
// GitLab, Gitea и Forgejo, Bitbucket, а на незнакомом хостинге — по образцу GitHub.

Перем Адреса;     // РазборАдреса (основа)
Перем Хостинги;   // Соответствие — вид хостинга → шаблоны страницы файла и сырого файла

#Область ПубличныйИнтерфейс

// Репозиторий по адресу из карточки пакета. Адрес клона («git@хост:о/р.git», «ssh://», «git://»,
// «.git» в конце) становится https-адресом; адрес внутри дерева («/tree/<реф>/<каталог>») называет
// реф и каталог пакета в репозитории. Публичные хостинги — всегда по https, свой домен — по схеме
// из адреса. Незнакомый хостинг принимается только по https и только с двумя сегментами
// «владелец/имя» — иначе не угадать, где кончается репозиторий.
//
// Параметры:
//  Адрес - Строка - адрес репозитория; недоверенное значение.
//
// Возвращаемое значение:
//  Структура, Неопределено - Вид (Строка: "github", "gitlab", "gitea", "bitbucket" либо "github-like"),
//    База (Строка — https://хост/путь-репозитория, у своего домена возможно http://), ПутьРепозитория (Строка — «владелец/имя»,
//    у GitLab с подгруппами), Реф (Структура — Имя, Вид: "branch", "tag" либо "commit"; без рефа
//    в адресе — "HEAD", ветка по умолчанию), Каталог (Строка — каталог пакета в репозитории,
//    сегменты через «/»; "" — корень); Неопределено, если адрес в репозиторий не ведёт.
//
Функция Разобрать(Знач Адрес) Экспорт

	Веб = ВебАдрес(СокрЛП(Строка(?(Адрес = Неопределено, "", Адрес))));
	Если Веб = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Вид = ВидХостинга(Веб.Хост, Веб.Сегменты);
	Схема = ?(ЭтоПубличныйХостинг(Веб.Хост), "https", Веб.Схема);
	Если Вид = "github-like" И Схема <> "https" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Вид = "gitlab" Тогда
		Разбор = ПутьGitLab(Веб.Сегменты);
	ИначеЕсли Вид = "gitea" Тогда
		Разбор = ПутьGitea(Веб.Сегменты);
	ИначеЕсли Вид = "bitbucket" Тогда
		Разбор = ПутьВладельцаИИмени(Веб.Сегменты, "src", Ложь);
	Иначе
		Разбор = ПутьВладельцаИИмени(Веб.Сегменты, "tree,blob", Вид = "github-like");
	КонецЕсли;

	Если Разбор = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура("Вид, База, ПутьРепозитория, Реф, Каталог");
	Результат.Вид = Вид;
	Результат.ПутьРепозитория = СтрСоединить(Разбор.Репозиторий, "/");
	Результат.База = СтрШаблон("%1://%2/%3", Схема, Веб.Узел, Результат.ПутьРепозитория);
	Результат.Реф = Разбор.Реф;
	Результат.Каталог = СтрСоединить(Разбор.Каталог, "/");

	Возврат Результат;

КонецФункции

// Реф по имени и виду. Ветка по умолчанию — «HEAD»: её понимают все поддержанные хостинги.
//
// Параметры:
//  Имя - Строка - имя ветки, тега либо коммита.
//  Вид - Строка - "branch", "tag" либо "commit".
//
// Возвращаемое значение:
//  Структура - Имя, Вид.
//
Функция Реф(Знач Имя, Знач Вид) Экспорт
	Возврат Новый Структура("Имя, Вид", Имя, Вид);
КонецФункции

// Страница файла в репозитории — то, что открывает ссылка.
//
// Параметры:
//  Репозиторий - Структура - результат Разобрать.
//  Реф         - Структура - результат Реф.
//  Путь        - Строка    - путь файла от корня репозитория, сегменты через «/» (не закодированы).
//
// Возвращаемое значение:
//  Строка - абсолютный https-адрес; путь пуст — главная страница репозитория.
//
Функция СтраницаФайла(Знач Репозиторий, Знач Реф, Знач Путь) Экспорт

	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат Репозиторий.База;
	КонецЕсли;

	Возврат АдресПоШаблону(Хостинги[Репозиторий.Вид].Страница, Репозиторий, Реф, Путь);

КонецФункции

// Сам файл из репозитория — то, что грузит картинка: байты файла, а не страница о нём.
//
// Параметры:
//  Репозиторий - Структура - результат Разобрать.
//  Реф         - Структура - результат Реф.
//  Путь        - Строка    - непустой путь файла от корня репозитория, сегменты через «/» (не закодированы).
//
// Возвращаемое значение:
//  Строка - абсолютный https-адрес.
//
Функция СыройФайл(Знач Репозиторий, Знач Реф, Знач Путь) Экспорт

	Возврат АдресПоШаблону(Хостинги[Репозиторий.Вид].Сырой, Репозиторий, Реф, Путь);

КонецФункции

#КонецОбласти

#Область ВебАдрес

// Адрес клона и веб-адрес — к одному виду; адрес с данными пользователя — чей-то вход, не берётся.
Функция ВебАдрес(Знач Адрес)

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = Адреса.БезЗапросаИЯкоря(Адрес);
	БезПорта = Ложь;
	Если СтрНачинаетсяС(НРег(Значение), "git+") Тогда
		Значение = Сред(Значение, 5);
	КонецЕсли;
	Нижний = НРег(Значение);

	Если СтрНачинаетсяС(Нижний, "git@") И СтрНайти(Значение, "://") = 0 Тогда
		// «git@хост:владелец/имя.git» — вход по ssh, веб-страницы того же хоста
		Двоеточие = СтрНайти(Значение, ":");
		Если Двоеточие = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Значение = "https://" + Сред(Значение, 5, Двоеточие - 5) + "/" + Сред(Значение, Двоеточие + 1);
	ИначеЕсли СтрНачинаетсяС(Нижний, "ssh://") ИЛИ СтрНачинаетсяС(Нижний, "git://") Тогда
		// порт ssh — не порт веб-страниц
		Значение = "https://" + БезВхода(Адреса.БезСхемы(Значение));
		БезПорта = Истина;
	ИначеЕсли НЕ (СтрНачинаетсяС(Нижний, "https://") ИЛИ СтрНачинаетсяС(Нижний, "http://")) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Части = Адреса.СхемаИУзел(Значение);
	Если Части.СДаннымиПользователя ИЛИ НЕ ЗначениеЗаполнено(Части.Хост) ИЛИ НЕ ЭтоИмяХоста(Части.Хост) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Хост = ?(Части.Хост = "www.github.com", "github.com", Части.Хост);
	Узел = НРег(Адреса.Узел(Значение));
	ПортПоУмолчанию = ?(Части.Схема = "https", ":443", ":80");
	Если БезПорта ИЛИ Хост <> Части.Хост ИЛИ СтрЗаканчиваетсяНа(Узел, ПортПоУмолчанию) Тогда
		Узел = Хост;
	КонецЕсли;

	НачалоПути = Адреса.ПозицияПути(Значение);
	Путь = ?(НачалоПути = 0, "", Сред(Значение, НачалоПути + 1));

	Результат = Новый Структура("Схема, Узел, Хост, Сегменты");
	Результат.Схема = Части.Схема;
	Результат.Узел = Узел;
	Результат.Хост = Хост;
	Результат.Сегменты = СтрРазделить(Путь, "/", Ложь);

	Возврат Результат;

КонецФункции

// «git@хост:22/путь» без схемы: вход отбрасывается, хост и путь остаются.
Функция БезВхода(Знач БезСхемы)

	Слеш = СтрНайти(БезСхемы, "/");
	Узел = ?(Слеш = 0, БезСхемы, Лев(БезСхемы, Слеш - 1));
	Собака = СтрНайти(Узел, "@", НаправлениеПоиска.СКонца);
	Возврат ?(Собака = 0, БезСхемы, Сред(БезСхемы, Собака + 1));

КонецФункции

// Имя хоста: латиница, цифры, точка, дефис — адрес из карточки печатается в страницу.
Функция ЭтоИмяХоста(Знач Хост)

	Для Позиция = 1 По СтрДлина(Хост) Цикл
		Если СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789.-", Сред(Хост, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрНайти(Хост, ".") > 0;

КонецФункции

#КонецОбласти

#Область ВидХостинга

// Публичные хостинги отдают страницы только по https — http из адреса до них не доживает.
Функция ЭтоПубличныйХостинг(Знач Хост)
	Возврат СтрРазделить("github.com,gitlab.com,bitbucket.org,codeberg.org,gitea.com", ",").Найти(Хост) <> Неопределено;
КонецФункции

// Хостинг узнаётся по узлу, свой домен GitLab и Gitea — ещё и по виду пути.
Функция ВидХостинга(Знач Хост, Знач Сегменты)

	Если Хост = "github.com" Тогда
		Возврат "github";
	ИначеЕсли Хост = "bitbucket.org" Тогда
		Возврат "bitbucket";
	ИначеЕсли Хост = "gitlab.com" ИЛИ СтрНайти(Хост, "gitlab") > 0 ИЛИ Сегменты.Найти("-") <> Неопределено Тогда
		Возврат "gitlab";
	ИначеЕсли Хост = "gitea.com" ИЛИ Хост = "codeberg.org" ИЛИ СтрНайти(Хост, "gitea") > 0
		ИЛИ СтрНайти(Хост, "forgejo") > 0 ИЛИ ЭтоДеревоGitea(Сегменты) Тогда
		Возврат "gitea";
	КонецЕсли;

	Возврат "github-like";

КонецФункции

Функция ЭтоДеревоGitea(Знач Сегменты)
	Возврат Сегменты.Количество() > 4 И Сегменты[2] = "src" И ЭтоВидРефаGitea(Сегменты[3]);
КонецФункции

Функция ЭтоВидРефаGitea(Знач Сегмент)
	Возврат Сегмент = "branch" ИЛИ Сегмент = "tag" ИЛИ Сегмент = "commit";
КонецФункции

#КонецОбласти

#Область ПутьРепозитория

// «владелец/имя[/<дерево>/<реф>/<каталог>]»; прочий хвост у незнакомого хостинга неоднозначен.
Функция ПутьВладельцаИИмени(Знач Сегменты, Знач ВидыДерева, Знач ТолькоДерево)

	Если Сегменты.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Репозиторий = Новый Массив();
	Репозиторий.Добавить(Сегменты[0]);
	Репозиторий.Добавить(БезСуффиксаКлона(Сегменты[1]));

	ЕстьДерево = Сегменты.Количество() > 3 И СтрРазделить(ВидыДерева, ",").Найти(Сегменты[2]) <> Неопределено;
	Если ТолькоДерево И Сегменты.Количество() > 2 И НЕ ЕстьДерево Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ ЕстьДерево Тогда
		Возврат Разбор(Репозиторий, Неопределено, Новый Массив());
	КонецЕсли;

	// «/blob/<реф>/<файл>» называет файл, а каталог пакета — тот, где он лежит
	Каталог = Хвост(Сегменты, 4);
	Если Сегменты[2] = "blob" И Каталог.Количество() > 0 Тогда
		Каталог.Удалить(Каталог.ВГраница());
	КонецЕсли;

	Возврат Разбор(Репозиторий, РефИзАдреса(Сегменты[3], "branch"), Каталог);

КонецФункции

// GitLab: подгруппы делают путь репозитория любой длины, дерево отделяет сегмент «-».
Функция ПутьGitLab(Знач Сегменты)

	Граница = Сегменты.Найти("-");
	Конец = ?(Граница = Неопределено, Сегменты.Количество(), Граница);
	Если Конец < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Репозиторий = Новый Массив();
	Для Индекс = 0 По Конец - 1 Цикл
		Репозиторий.Добавить(Сегменты[Индекс]);
	КонецЦикла;
	Репозиторий[Конец - 1] = БезСуффиксаКлона(Репозиторий[Конец - 1]);

	Если Граница = Неопределено ИЛИ Сегменты.Количество() < Граница + 3
		ИЛИ (Сегменты[Граница + 1] <> "tree" И Сегменты[Граница + 1] <> "blob") Тогда
		Возврат Разбор(Репозиторий, Неопределено, Новый Массив());
	КонецЕсли;

	Каталог = Хвост(Сегменты, Граница + 3);
	Если Сегменты[Граница + 1] = "blob" И Каталог.Количество() > 0 Тогда
		Каталог.Удалить(Каталог.ВГраница());
	КонецЕсли;

	Возврат Разбор(Репозиторий, РефИзАдреса(Сегменты[Граница + 2], "branch"), Каталог);

КонецФункции

// Gitea и Forgejo: «владелец/имя[/src/<branch|tag|commit>/<реф>/<каталог>]».
Функция ПутьGitea(Знач Сегменты)

	Если Сегменты.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Репозиторий = Новый Массив();
	Репозиторий.Добавить(Сегменты[0]);
	Репозиторий.Добавить(БезСуффиксаКлона(Сегменты[1]));

	Если НЕ ЭтоДеревоGitea(Сегменты) Тогда
		Возврат Разбор(Репозиторий, Неопределено, Новый Массив());
	КонецЕсли;

	Возврат Разбор(Репозиторий, РефИзАдреса(Сегменты[4], Сегменты[3]), Хвост(Сегменты, 5));

КонецФункции

// Сегменты репозитория печатаются в адрес как есть — поэтому только безопасные символы пути.
Функция Разбор(Знач Репозиторий, Знач РефДерева, Знач Каталог)

	Для Каждого Сегмент Из Репозиторий Цикл
		Если НЕ ЭтоСегментРепозитория(Сегмент) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	Раскодированный = КаталогВРепозитории(Каталог);
	Если Раскодированный = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура("Репозиторий, Реф, Каталог");
	Результат.Репозиторий = Репозиторий;
	Результат.Реф = ?(РефДерева = Неопределено, Реф("HEAD", "branch"), РефДерева);
	Результат.Каталог = Раскодированный;

	Возврат Результат;

КонецФункции

// Каталог раскодируется до разбора точек («%2F..» — тоже подъём); выше корня — не репозиторий.
Функция КаталогВРепозитории(Знач Сегменты)

	Каталог = Новый Массив();
	Для Каждого Сегмент Из Сегменты Цикл
		Для Каждого Имя Из СтрРазделить(Раскодировать(Сегмент), "/", Ложь) Цикл
			Если Имя = ".." Тогда
				Если Каталог.Количество() = 0 Тогда
					Возврат Неопределено;
				КонецЕсли;
				Каталог.Удалить(Каталог.ВГраница());
			ИначеЕсли Имя <> "." Тогда
				Каталог.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Каталог;

КонецФункции

Функция РефИзАдреса(Знач Сегмент, Знач Вид)
	Возврат Реф(Раскодировать(Сегмент), Вид);
КонецФункции

Функция ЭтоСегментРепозитория(Знач Сегмент)

	Если НЕ ЗначениеЗаполнено(Сегмент) ИЛИ Сегмент = "." ИЛИ Сегмент = ".." Тогда
		Возврат Ложь;
	КонецЕсли;
	Допустимые = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.~";
	Для Позиция = 1 По СтрДлина(Сегмент) Цикл
		Если СтрНайти(Допустимые, Сред(Сегмент, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// «acme/lib.git» — адрес клона, а репозиторий называется «lib».
Функция БезСуффиксаКлона(Знач Имя)
	Возврат ?(СтрЗаканчиваетсяНа(НРег(Имя), ".git"), Лев(Имя, СтрДлина(Имя) - 4), Имя);
КонецФункции

Функция Хвост(Знач Сегменты, Знач С)

	Результат = Новый Массив();
	Для Индекс = С По Сегменты.ВГраница() Цикл
		Результат.Добавить(Сегменты[Индекс]);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Раскодировать(Знач Сегмент)
	Возврат РаскодироватьСтроку(Сегмент, СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти

#Область АдресФайла

// Реф и путь кодируются посегментно: «+» в теге и кириллица в имени файла остаются одним сегментом.
Функция АдресПоШаблону(Знач Шаблон, Знач Репозиторий, Знач Реф, Знач Путь)

	Адрес = СтрЗаменить(Шаблон, "{база}", Репозиторий.База);
	Адрес = СтрЗаменить(Адрес, "{репозиторий}", Репозиторий.ПутьРепозитория);
	Адрес = СтрЗаменить(Адрес, "{вид}", Реф.Вид);
	Адрес = СтрЗаменить(Адрес, "{реф}", Закодированный(Реф.Имя));
	Возврат СтрЗаменить(Адрес, "{путь}", Закодированный(Путь));

КонецФункции

Функция Закодированный(Знач Путь)

	Сегменты = СтрРазделить(Путь, "/");
	Для Индекс = 0 По Сегменты.ВГраница() Цикл
		Сегменты[Индекс] = КодироватьСтроку(Сегменты[Индекс], СпособКодированияСтроки.КодировкаURL);
	КонецЦикла;
	Возврат СтрСоединить(Сегменты, "/");

КонецФункции

Функция НовыеХостинги()

	Результат = Новый Соответствие();
	// github.com отдаёт файл переадресацией на raw.githubusercontent.com — картинка идёт туда сразу
	Результат.Вставить("github", Шаблоны("{база}/blob/{реф}/{путь}",
		"https://raw.githubusercontent.com/{репозиторий}/{реф}/{путь}"));
	Результат.Вставить("github-like", Шаблоны("{база}/blob/{реф}/{путь}", "{база}/raw/{реф}/{путь}"));
	Результат.Вставить("gitlab", Шаблоны("{база}/-/blob/{реф}/{путь}", "{база}/-/raw/{реф}/{путь}"));
	// «HEAD» в ветке Gitea и Forgejo понимают как ветку по умолчанию
	Результат.Вставить("gitea", Шаблоны("{база}/src/{вид}/{реф}/{путь}", "{база}/raw/{вид}/{реф}/{путь}"));
	Результат.Вставить("bitbucket", Шаблоны("{база}/src/{реф}/{путь}", "{база}/raw/{реф}/{путь}"));

	Возврат Результат;

КонецФункции

Функция Шаблоны(Знач Страница, Знач Сырой)
	Возврат Новый Структура("Страница, Сырой", Страница, Сырой);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "РазборАдреса") _Адреса) Экспорт
	Адреса = _Адреса;
	Хостинги = НовыеХостинги();
КонецПроцедуры
