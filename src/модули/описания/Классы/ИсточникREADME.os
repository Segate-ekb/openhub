// Источник README — желудь модуля описания.
// Извлекает Markdown README версии из её артефакта .ospx; любая ошибка = «README недоступен».

#Использовать ospx-tools

Перем ХранилищеАртефактов;   // ХранилищеАртефактов

// Извлекает текст README версии из её артефакта .ospx.
//
// Параметры:
//  Пул    - Пул          - пул пакета (нужно имя).
//  Пакет  - Пакет        - пакет (нужно имя).
//  Версия - ВерсияПакета - версия (нужна строка версии).
//
// Возвращаемое значение:
//  Строка, Неопределено - Markdown README либо Неопределено, если README нет
//                         или артефакт недоступен.
//
Функция MarkdownДляВерсии(Знач Пул, Знач Пакет, Знач Версия) Экспорт

	Попытка
		Координаты = Новый КоординатыАртефакта(Пул.Имя, Пакет.Имя, Версия.Версия);
	Исключение
		// имя/версия не укладываются в координаты — README считаем недоступным
		Возврат Неопределено;
	КонецПопытки;

	Если НЕ ХранилищеАртефактов.Существует(Координаты) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Получить материализует временную копию — ОсвободитьВыдачу обязателен на любом выходе
	ПутьКФайлу = "";
	Результат = Неопределено;
	Попытка
		ПутьКФайлу = ХранилищеАртефактов.Получить(Координаты);
		ПакетOspx = ПакетыOspx.ПрочитатьПакет(ПутьКФайлу);
		Если ПакетOspx.ЕстьREADME() Тогда
			Результат = ПакетOspx.ТекстREADME();
		КонецЕсли;
	Исключение
		// битый артефакт, превышение лимитов распаковки и т.п. — README недоступен
		Результат = Неопределено;
	КонецПопытки;

	Если ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ХранилищеАртефактов.ОсвободитьВыдачу(ПутьКФайлу);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеАртефактов") _ХранилищеАртефактов)
	ХранилищеАртефактов = _ХранилищеАртефактов;
КонецПроцедуры
