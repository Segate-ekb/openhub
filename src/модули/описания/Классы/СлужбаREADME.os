// Служба README — желудь модуля описания: описание версии с диска, а при промахе —
// с её артефакта. Показу отдаётся санитизированным HTML, плановой актуализации — ответом
// «на диске оно есть»; путь до описания у обоих один.

Перем ХранилищеОписаний;  // ХранилищеREADME
Перем Источник;           // ИсточникREADME
Перем Рендерер;           // РендерерREADME

#Область ПубличныйИнтерфейс

// Возвращает представление README версии: санитизированный HTML описания.
//
// Параметры:
//  Пул    - Пул          - пул пакета.
//  Пакет  - Пакет        - пакет.
//  Версия - ВерсияПакета, Неопределено - версия; Неопределено означает «README нет».
//
// Возвращаемое значение:
//  Структура - ЕстьREADME (Булево), HTML (Строка, санитизированный).
//
Функция ПредставлениеREADME(Знач Пул, Знач Пакет, Знач Версия) Экспорт

	Если Версия = Неопределено Тогда
		Возврат Пусто();
	КонецЕсли;

	Описание = ОписаниеВерсии(Пул, Пакет, Версия);
	Если НЕ ЗначениеЗаполнено(Описание.Текст) Тогда
		Возврат Пусто();
	КонецЕсли;

	Возврат Новый Структура("ЕстьREADME, HTML", Истина, Рендерер.ВБезопасныйHTML(Описание.Текст));

КонецФункции

// Обеспечивает описание версии на диске: тот же путь, что и у показа, только без рендера.
// Ею живёт плановая актуализация — своего способа положить описание на диск у неё нет.
// Имя глагольное намеренно: вызов не спрашивает, а делает — на промахе диска он читает
// артефакт и отправляет описание на диск.
//
// Параметры:
//  Пул    - Пул          - пул пакета.
//  Пакет  - Пакет        - пакет.
//  Версия - ВерсияПакета, Неопределено - версия; Неопределено означает «обеспечивать нечего».
//
// Возвращаемое значение:
//  Булево - Истина, если описание версии прочитано: лежало на диске либо снято с артефакта
//           (и тогда же отправлено на диск — запись best-effort, см. ХранилищеREADME).
//           Ложь означает, что артефакт недоступен и читать было нечего.
//
Функция ОбеспечитьОписаниеНаДиске(Знач Пул, Знач Пакет, Знач Версия) Экспорт

	Если Версия = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ОписаниеВерсии(Пул, Пакет, Версия).Разобран;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Описание версии: диск, а при промахе — артефакт, чей разбор тут же уходит на диск.
// Пустой текст прочитанного артефакта запоминается наравне с непустым: «README нет» —
// такой же ответ, и распаковывать .ospx ради него второй раз незачем.
//
// Возвращаемое значение:
//  Структура - Текст (Строка — Markdown; "" означает «README у версии нет»),
//              Разобран (Булево — Ложь только когда артефакт недоступен и читать нечего).
//
Функция ОписаниеВерсии(Знач Пул, Знач Пакет, Знач Версия)

	СДиска = ХранилищеОписаний.Прочитать(Пул.Имя, Пакет.Имя, Версия.Версия);
	Если СДиска <> Неопределено Тогда
		Возврат Новый Структура("Текст, Разобран", СДиска, Истина);
	КонецЕсли;

	ИзАртефакта = Источник.ПрочитатьИзАртефакта(Пул, Пакет, Версия);
	Если ИзАртефакта.Разобран Тогда
		ХранилищеОписаний.Записать(Пул.Имя, Пакет.Имя, Версия.Версия, ИзАртефакта.Текст);
	КонецЕсли;

	Возврат Новый Структура("Текст, Разобран", ИзАртефакта.Текст, ИзАртефакта.Разобран);

КонецФункции

Функция Пусто()
	Возврат Новый Структура("ЕстьREADME, HTML", Ложь, "");
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеREADME") _ХранилищеОписаний,
	&Пластилин(Значение = "ИсточникREADME") _Источник,
	&Пластилин(Значение = "РендерерREADME") _Рендерер)

	ХранилищеОписаний = _ХранилищеОписаний;
	Источник = _Источник;
	Рендерер = _Рендерер;

КонецПроцедуры
