// Описание версии с диска, а при промахе — с её артефакта. Показу отдаётся санитизированным
// HTML и источником, плановой актуализации — ответом «на диске оно есть»; путь до описания у обоих один.

Перем ХранилищеОписаний;  // ХранилищеREADME
Перем Источник;           // ИсточникREADME
Перем Рендерер;           // РендерерREADME

#Область ПубличныйИнтерфейс

// Возвращает представление README версии: санитизированный HTML описания, есть ли в нём
// блоки кода с языком и откуда оно взято.
//
// Параметры:
//  Пул    - Пул          - пул пакета.
//  Пакет  - Пакет        - пакет.
//  Версия - ВерсияПакета, Неопределено - версия; Неопределено означает «README нет».
//
// Возвращаемое значение:
//  Структура - ЕстьREADME (Булево), HTML (Строка, санитизированный),
//              ЕстьКодСЯзыком (Булево, есть ли блок кода с языком),
//              Источник (Структура, Неопределено — README из пакета либо его нет:
//                Вид (Строка: "tag" либо "default_branch"), Реф (Строка — тег либо "HEAD"),
//                Ссылка (Строка — файл README на GitHub)).
//
Функция ПредставлениеREADME(Знач Пул, Знач Пакет, Знач Версия) Экспорт

	Если Версия = Неопределено Тогда
		Возврат Пусто();
	КонецЕсли;

	Описание = ОписаниеВерсии(Пул, Пакет, Версия);
	Если НЕ ЗначениеЗаполнено(Описание.Текст) Тогда
		Возврат Пусто();
	КонецЕсли;

	HTML = Рендерер.ВБезопасныйHTML(Описание.Текст);
	Возврат Новый Структура("ЕстьREADME, HTML, ЕстьКодСЯзыком, Источник", Истина, HTML,
		Рендерер.ЕстьКодСЯзыком(HTML), Описание.Источник);

КонецФункции

// Обеспечивает описание версии на диске: лежит — спрашивается только его длина; на промахе
// диска описание снимается с артефакта и ложится на диск тем же путём, что у показа.
//
// Параметры:
//  Пул    - Пул          - пул пакета.
//  Пакет  - Пакет        - пакет.
//  Версия - ВерсияПакета, Неопределено - версия; Неопределено означает «обеспечивать нечего».
//
// Возвращаемое значение:
//  Булево - Истина, если описание версии прочитано: лежало на диске либо снято с артефакта
//           (и тогда же отправлено на диск — запись best-effort, см. ХранилищеREADME).
//           Ложь означает, что артефакт недоступен и читать было нечего.
//
Функция ОбеспечитьОписаниеНаДиске(Знач Пул, Знач Пакет, Знач Версия) Экспорт

	Если Версия = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ХранилищеОписаний.ДлинаОписания(Пул.Имя, Пакет.Имя, Версия.Версия) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ОписаниеИзАртефакта(Пул, Пакет, Версия).Разобран;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пустое описание из пакета — повод заглянуть в справку: README мог найтись в репозитории.
Функция ОписаниеВерсии(Знач Пул, Знач Пакет, Знач Версия)

	СДиска = ХранилищеОписаний.Прочитать(Пул.Имя, Пакет.Имя, Версия.Версия);
	Если СДиска = Неопределено Тогда
		Возврат ОписаниеИзАртефакта(Пул, Пакет, Версия);
	ИначеЕсли ЗначениеЗаполнено(СДиска) Тогда
		Возврат ПрочитанноеОписание(СДиска, Истина, Неопределено);
	КонецЕсли;

	Справка = ХранилищеОписаний.ПрочитатьСправку(Пул.Имя, Пакет.Имя, Версия.Версия);
	Если Справка = Неопределено ИЛИ НЕ Справка.Найдено Тогда
		Возврат ПрочитанноеОписание("", Истина, Неопределено);
	КонецЕсли;

	Возврат ПрочитанноеОписание(Справка.Текст, Истина,
		Новый Структура("Вид, Реф, Ссылка", Справка.Вид, Справка.Реф, Справка.Ссылка));

КонецФункции

// Пустой текст артефакта запоминается наравне с непустым: «README нет» — такой же ответ.
Функция ОписаниеИзАртефакта(Знач Пул, Знач Пакет, Знач Версия)

	ИзАртефакта = Источник.ПрочитатьИзАртефакта(Пул, Пакет, Версия);
	Если ИзАртефакта.Разобран Тогда
		ХранилищеОписаний.Записать(Пул.Имя, Пакет.Имя, Версия.Версия, ИзАртефакта.Текст);
	КонецЕсли;

	Возврат ПрочитанноеОписание(ИзАртефакта.Текст, ИзАртефакта.Разобран, Неопределено);

КонецФункции

Функция ПрочитанноеОписание(Знач Текст, Знач Разобран, Знач ОткудаВзят)
	Возврат Новый Структура("Текст, Разобран, Источник", Текст, Разобран, ОткудаВзят);
КонецФункции

Функция Пусто()
	Возврат Новый Структура("ЕстьREADME, HTML, ЕстьКодСЯзыком, Источник", Ложь, "", Ложь, Неопределено);
КонецФункции

#КонецОбласти

&Желудь
&Наблюдаемый
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеREADME") _ХранилищеОписаний,
	&Пластилин(Значение = "ИсточникREADME") _Источник,
	&Пластилин(Значение = "РендерерREADME") _Рендерер)

	ХранилищеОписаний = _ХранилищеОписаний;
	Источник = _Источник;
	Рендерер = _Рендерер;

КонецПроцедуры
