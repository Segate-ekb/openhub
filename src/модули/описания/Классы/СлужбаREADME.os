// Служба README — желудь модуля описания: кэш → при промахе извлечение Markdown →
// безопасный рендер → запись в кэш. Single-flight не реализован сознательно.

Перем Кэш;        // КэшREADME
Перем Источник;   // ИсточникREADME
Перем Рендерер;   // РендерерREADME

// Возвращает представление README версии: из кэша либо с рендером и кэшированием.
//
// Параметры:
//  Пул    - Пул          - пул пакета.
//  Пакет  - Пакет        - пакет.
//  Версия - ВерсияПакета, Неопределено - версия; Неопределено означает «README нет».
//
// Возвращаемое значение:
//  Структура - ЕстьREADME (Булево), HTML (Строка, санитизированный).
//
Функция ПредставлениеREADME(Знач Пул, Знач Пакет, Знач Версия) Экспорт

	Если Версия = Неопределено Тогда
		Возврат Пусто();
	КонецЕсли;

	Ключ = Версия.Идентификатор;

	Кэшированное = Кэш.Получить(Ключ);
	Если Кэшированное <> Неопределено Тогда
		Возврат Кэшированное;
	КонецЕсли;

	Результат = Отрендерить(Пул, Пакет, Версия);
	Кэш.Сохранить(Ключ, Результат);
	Возврат Результат;

КонецФункции

Функция Отрендерить(Знач Пул, Знач Пакет, Знач Версия)

	ТекстMarkdown = Источник.MarkdownДляВерсии(Пул, Пакет, Версия);
	Если ТекстMarkdown = Неопределено Тогда
		Возврат Пусто();
	КонецЕсли;

	HTML = Рендерер.ВБезопасныйHTML(ТекстMarkdown);
	Возврат Новый Структура("ЕстьREADME, HTML", Истина, HTML);

КонецФункции

Функция Пусто()
	Возврат Новый Структура("ЕстьREADME, HTML", Ложь, "");
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КэшREADME") _Кэш,
	&Пластилин(Значение = "ИсточникREADME") _Источник,
	&Пластилин(Значение = "РендерерREADME") _Рендерер)

	Кэш = _Кэш;
	Источник = _Источник;
	Рендерер = _Рендерер;

КонецПроцедуры
