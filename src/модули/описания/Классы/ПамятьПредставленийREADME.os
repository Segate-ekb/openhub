// Готовые представления README версий — в кэше autumn-cache «представленияREADME»: разбор Markdown
// и санитайзер проходят один раз на версию, запись сбрасывает дверь ХранилищеREADME.

Перем Сам;   // Табакерка с этой же памятью: перехват кэша работает только при вызове снаружи

#Область ПубличныйИнтерфейс

// Возвращает представление README версии: запомненное либо собранное сборщиком и запомненное.
// Неокончательный ответ сборщика не запоминается.
//
// Параметры:
//  Сборщик - СлужбаREADME - собирает представление мимо памяти (СобратьПредставление).
//  Пул     - Пул          - пул пакета.
//  Пакет   - Пакет        - пакет; представление, собранное от другого адреса репозитория, не отдаётся.
//  Версия  - ВерсияПакета - версия.
//
// Возвращаемое значение:
//  Структура, Неопределено - как у СлужбаREADME.ПредставлениеREADME, новая копия на каждый вызов;
//                            Неопределено — показывать нечего, ответ не окончателен.
//
Функция Представление(Знач Сборщик, Знач Пул, Знач Пакет, Знач Версия) Экспорт

	ИмяПула = НРег(Пул.Имя);
	ИмяПакета = НРег(Пакет.Имя);
	АдресРепозитория = Строкой(Пакет.АдресРепозитория);

	Память = ?(Сам = Неопределено, ЭтотОбъект, Сам.Достать());
	Собранное = Память.Собранное(ИмяПула, ИмяПакета, Версия.Версия, Сборщик, Пул, Пакет, Версия);
	Если Собранное <> Неопределено И Собранное.АдресРепозитория <> АдресРепозитория Тогда
		Память.Забыть(ИмяПула, ИмяПакета, Версия.Версия);
		Собранное = Память.Собранное(ИмяПула, ИмяПакета, Версия.Версия, Сборщик, Пул, Пакет, Версия);
	КонецЕсли;

	Если Собранное = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Источник = Неопределено;
	Если Собранное.Источник <> Неопределено Тогда
		Источник = Новый Структура(Собранное.Источник);
	КонецЕсли;

	Возврат Новый Структура("ЕстьREADME, HTML, ЕстьКодСЯзыком, Источник", Собранное.ЕстьREADME,
		Собранное.HTML, Собранное.ЕстьКодСЯзыком, Источник);

КонецФункции

// Собирает представление README версии сборщиком; результат хранит кэш по именам в нижнем регистре
// и версии. Зовётся из Представление.
//
// Параметры:
//  ИмяПула      - Строка       - имя пула в нижнем регистре.
//  ИмяПакета    - Строка       - имя пакета в нижнем регистре.
//  Версия       - Строка       - строка версии.
//  Сборщик      - СлужбаREADME - собирает представление мимо памяти.
//  Пул          - Пул          - пул пакета.
//  Пакет        - Пакет        - пакет.
//  ВерсияПакета - ВерсияПакета - версия.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - АдресРепозитория, ЕстьREADME, HTML, ЕстьКодСЯзыком,
//                                         Источник; Неопределено — ответ не окончателен.
//
&Кэшируемый("представленияREADME")
Функция Собранное(&КлючКэша Знач ИмяПула, &КлючКэша Знач ИмяПакета, &КлючКэша Знач Версия,
	Знач Сборщик, Знач Пул, Знач Пакет, Знач ВерсияПакета) Экспорт

	Представление = Сборщик.СобратьПредставление(Пул, Пакет, ВерсияПакета);
	Если Представление = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Источник = Неопределено;
	Если Представление.Источник <> Неопределено Тогда
		Источник = Новый ФиксированнаяСтруктура(Представление.Источник);
	КонецЕсли;

	Возврат Новый ФиксированнаяСтруктура("АдресРепозитория, ЕстьREADME, HTML, ЕстьКодСЯзыком, Источник",
		Строкой(Пакет.АдресРепозитория), Представление.ЕстьREADME, Представление.HTML,
		Представление.ЕстьКодСЯзыком, Источник);

КонецФункции

// Забывает представление README версии: описание или справка на диске изменились (зовёт
// ХранилищеREADME после каждой записи) либо представление собрано от прежнего адреса репозитория.
//
// Параметры:
//  ИмяПула   - Строка - имя пула в нижнем регистре.
//  ИмяПакета - Строка - имя пакета в нижнем регистре.
//  Версия    - Строка - строка версии.
//
&СбрасываетКэш("представленияREADME")
Процедура Забыть(&КлючКэша Знач ИмяПула, &КлючКэша Знач ИмяПакета, &КлючКэша Знач Версия) Экспорт
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Строкой(Знач Значение)
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин(Значение = "ПамятьПредставленийREADME") _Сам = Неопределено)
	Сам = _Сам;
КонецПроцедуры
