// Актуализатор описаний — желудь модуля описания: обход всех пакетов, у каждого — описание
// той версии, которую отдаёт установка без тега и версии, на диске. Показ так же читает
// диск, поэтому обход только опережает читателя, а не заменяет ему источник.

Перем СервисПулов;   // СервисПулов (реестр)
Перем СервисПакетов; // СервисПакетов (реестр)
Перем Резолвер;      // РезолверСпецификации (реестр) — версия установки без спецификации
Перем Служба;        // СлужбаREADME
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Обходит пакеты хаба и обеспечивает на диске описание версии, которую каждый из них
// отдаёт по умолчанию. Сбой на отдельном пакете обход не роняет — пакет попадает
// в «пропущено».
//
// Возвращаемое значение:
//  Структура - Обработано (Число — описание версии по умолчанию лежит на диске),
//              Пропущено (Число — пакет без пула, без версии по умолчанию либо с недоступным
//              артефактом).
//
Функция Актуализировать() Экспорт

	Сводка = Новый Структура("Обработано, Пропущено", 0, 0);

	Для Каждого Пакет Из СервисПакетов.ВсеПакеты() Цикл

		Попытка
			Обеспечено = ОписаниеОбеспечено(Пакет);
		Исключение
			// Проблема одного пакета не срывает обход остальных, но молчать о ней нельзя:
			// отвалившееся хранилище пропустило бы ВСЕ пакеты, а журнал отчитался бы успехом.
			Лог.Ошибка("Актуализация описаний пакета ""%1"" прервана ошибкой: %2",
				Пакет.Имя, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Обеспечено = Ложь;
		КонецПопытки;

		Если Обеспечено Тогда
			Сводка.Обработано = Сводка.Обработано + 1;
		Иначе
			Сводка.Пропущено = Сводка.Пропущено + 1;
		КонецЕсли;

	КонецЦикла;

	Лог.Отладка("Актуализация описаний завершена: обработано %1, пропущено %2",
		Сводка.Обработано, Сводка.Пропущено);

	Возврат Сводка;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вердикт по одному пакету: описание версии, которую он отдаёт по умолчанию, на диске.
// Ложь — обеспечить не удалось: пул пропал, канал по умолчанию пуст либо артефакт версии
// недоступен. Всё это ожидаемо и в журнал не пишется.
Функция ОписаниеОбеспечено(Знач Пакет)

	Пул = СервисПулов.ПулПоИдентификатору(Пакет.ПулИдентификатор);
	Если Пул = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Служба.ОбеспечитьОписаниеНаДиске(Пул, Пакет, Резолвер.ВерсияПоУмолчанию(Пакет));

КонецФункции

#КонецОбласти

// Параметр _Лог — второй вход для прямого создания вне контейнера ОСени.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "РезолверСпецификации") _Резолвер,
	&Пластилин(Значение = "СлужбаREADME") _Служба,
	&Лог _Лог = Неопределено)

	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	Резолвер = _Резолвер;
	Служба = _Служба;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
