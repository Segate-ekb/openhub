// Счёт, сумма и признак наличия по таблице: один запрос к базе, где бэкенд исполняет SQL, и та же
// цифра выборкой в памяти, где не исполняет. Вердикт пробы — один на процесс.

#Использовать entity
#Использовать errors

Перем Источник;         // ИсточникДанных (autumn-data) — тип коннектора для строки журнала
Перем Текст;            // ТекстАгрегата — текст запроса по описанию сущности
Перем Ошибки;           // ТекстОшибки (основа)
Перем ВердиктПробы;     // Булево, Неопределено — исполняет ли бэкенд SQL; Неопределено — не пробовали
Перем НазванныеОтказы;  // Соответствие: «таблица/агрегат/вид отказа» → Истина
Перем ОписанияСущностей;  // Соответствие: имя таблицы → ОписаниеСущности
Перем Замок;            // БлокировкаРесурса — желудь-одиночка живёт под потоками winow
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Исполняет ли база SQL, то есть считает ли агрегаты она сама. Проба делается один раз —
// на хранилище, о котором спросили первым, — дальше её вердикт только вспоминается.
//
// Параметры:
//  Хранилище - Произвольный - хранилище &ХранилищеСущностей любой таблицы базы.
//
// Возвращаемое значение:
//  Булево.
//
Функция БазаСчитает(Знач Хранилище) Экспорт

	Если ВердиктПробы <> Неопределено Тогда
		Возврат ВердиктПробы;
	КонецЕсли;

	Возврат ВердиктПробыПодЗамком(Хранилище);

КонецФункции

// Сколько строк таблицы отвечает отбору.
//
// Параметры:
//  Хранилище - Произвольный - хранилище &ХранилищеСущностей нужной таблицы.
//  Опции - ОпцииПоиска, Неопределено - отбор; Неопределено — вся таблица.
//
// Возвращаемое значение:
//  Число.
//
&Наблюдаемый
Функция Количество(Знач Хранилище, Знач Опции = Неопределено) Экспорт

	Сущность = СущностьЕслиЕстьЧтоСчитать(Хранилище, Опции);
	Если Сущность = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Если БазаСчитает(Хранилище) Тогда
		Попытка
			Возврат ЧислоЗапросом(Хранилище, Текст.Количество(Сущность, Опции));
		Исключение
			НазватьОтказ(Сущность, "количество", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Возврат Хранилище.Получить(Опции).Количество();

КонецФункции

// Отвечает ли отбору хоть одна строка таблицы.
//
// Параметры:
//  Хранилище - Произвольный - хранилище &ХранилищеСущностей нужной таблицы.
//  Опции - ОпцииПоиска, Неопределено - отбор; Неопределено — вся таблица.
//
// Возвращаемое значение:
//  Булево.
//
&Наблюдаемый
Функция Есть(Знач Хранилище, Знач Опции = Неопределено) Экспорт

	Сущность = СущностьЕслиЕстьЧтоСчитать(Хранилище, Опции);
	Если Сущность = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если БазаСчитает(Хранилище) Тогда
		Попытка
			Возврат НаличиеЗапросом(Хранилище, Текст.Наличие(Сущность, Опции));
		Исключение
			НазватьОтказ(Сущность, "наличие", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Возврат Хранилище.Получить(ОднаСтрока(Опции)).Количество() > 0;

КонецФункции

// Сумма поля по строкам, отвечающим отбору. Строк нет — ноль.
//
// Параметры:
//  Хранилище - Произвольный - хранилище &ХранилищеСущностей нужной таблицы.
//  ИмяПоля - Строка - суммируемое поле сущности.
//  Опции - ОпцииПоиска, Неопределено - отбор; Неопределено — вся таблица.
//
// Возвращаемое значение:
//  Число.
//
&Наблюдаемый
Функция Сумма(Знач Хранилище,
	&АтрибутСпана("oshub.aggregate.field") Знач ИмяПоля,
	Знач Опции = Неопределено) Экспорт

	Сущность = СущностьЕслиЕстьЧтоСчитать(Хранилище, Опции, ИмяПоля);
	Если Сущность = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Если БазаСчитает(Хранилище) Тогда
		Попытка
			Возврат ЧислоЗапросом(Хранилище, Текст.Сумма(Сущность, ИмяПоля, Опции));
		Исключение
			НазватьОтказ(Сущность, "сумма", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Возврат СуммаВПамяти(Хранилище, Сущность, ИмяПоля, Опции);

КонецФункции

// Сколько строк отвечает отбору в разрезе ключа — одним обращением на весь разрез.
//
// Параметры:
//  Хранилище - Произвольный - хранилище &ХранилищеСущностей нужной таблицы.
//  ИмяПоляКлюча - Строка - поле, по которому идёт разрез.
//  Опции - ОпцииПоиска, Неопределено - отбор; Неопределено — вся таблица.
//
// Возвращаемое значение:
//  Соответствие - ключ разреза → Число; ключей без строк в соответствии нет.
//
&Наблюдаемый
Функция КоличествоПоКлючу(Знач Хранилище,
	&АтрибутСпана("oshub.aggregate.group_by") Знач ИмяПоляКлюча,
	Знач Опции = Неопределено) Экспорт

	Сущность = СущностьЕслиЕстьЧтоСчитать(Хранилище, Опции);
	Если Сущность = Неопределено Тогда
		Возврат Новый Соответствие();
	КонецЕсли;

	Если БазаСчитает(Хранилище) Тогда
		Попытка
			Возврат Разрез(Сущность, ИмяПоляКлюча,
				ОтветБазы(Хранилище, Текст.КоличествоПоКлючу(Сущность, ИмяПоляКлюча, Опции)));
		Исключение
			НазватьОтказ(Сущность, "количество по ключу", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Возврат СчётПоКлючуВПамяти(Хранилище, Сущность, ИмяПоляКлюча, Опции);

КонецФункции

// Сумма поля в разрезе ключа — одним обращением на весь разрез.
//
// Параметры:
//  Хранилище - Произвольный - хранилище &ХранилищеСущностей нужной таблицы.
//  ИмяПоляКлюча - Строка - поле, по которому идёт разрез.
//  ИмяПоляСуммы - Строка - суммируемое поле сущности.
//  Опции - ОпцииПоиска, Неопределено - отбор; Неопределено — вся таблица.
//
// Возвращаемое значение:
//  Соответствие - ключ разреза → Число; ключей без строк в соответствии нет.
//
&Наблюдаемый
Функция СуммаПоКлючу(Знач Хранилище,
	&АтрибутСпана("oshub.aggregate.group_by") Знач ИмяПоляКлюча,
	&АтрибутСпана("oshub.aggregate.field") Знач ИмяПоляСуммы,
	Знач Опции = Неопределено) Экспорт

	Сущность = СущностьЕслиЕстьЧтоСчитать(Хранилище, Опции, ИмяПоляСуммы);
	Если Сущность = Неопределено Тогда
		Возврат Новый Соответствие();
	КонецЕсли;

	Если БазаСчитает(Хранилище) Тогда
		Попытка
			Возврат Разрез(Сущность, ИмяПоляКлюча,
				ОтветБазы(Хранилище, Текст.СуммаПоКлючу(Сущность, ИмяПоляКлюча, ИмяПоляСуммы, Опции)));
		Исключение
			НазватьОтказ(Сущность, "сумма по ключу", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Возврат СуммаПоКлючуВПамяти(Хранилище, Сущность, ИмяПоляКлюча, ИмяПоляСуммы, Опции);

КонецФункции

#КонецОбласти

#Область ОбщийПрологАгрегата

// Общий пролог агрегатов: неверный вызов отвергается; Неопределено — отбору заведомо не отвечает ни одна строка.
Функция СущностьЕслиЕстьЧтоСчитать(Знач Хранилище, Знач Опции, Знач ИмяПоляСуммы = "")

	ПроверитьЧтоОтборНеПостраничный(Опции);

	Сущность = ОписаниеСущности(Хранилище.ПолучитьОбъектМодели());
	Если ЗначениеЗаполнено(ИмяПоляСуммы) Тогда
		ПроверитьЧтоПолеСуммируемо(Сущность, ИмяПоляСуммы);
	КонецЕсли;

	Возврат ?(Текст.ОтборНикогоНеВыберет(Опции), Неопределено, Сущность);

КонецФункции

// Описание сущности строится один раз на таблицу: модель на процесс неизменна.
Функция ОписаниеСущности(Знач Модель)

	Готовое = ОписанияСущностей.Получить(Модель.ИмяТаблицы());

	Возврат ?(Готовое = Неопределено, ЗапомнитьОписание(Модель), Готовое);

КонецФункции

// Агрегат по странице дал бы на двух дорогах разные цифры, поэтому постраничный отбор отвергается сразу.
Процедура ПроверитьЧтоОтборНеПостраничный(Знач Опции)

	Если Опции = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Опции.ВыбираютсяПервые() <> Неопределено ИЛИ Опции.ВыбираетсяСоСмещением() <> Неопределено Тогда
		ВызватьИсключение СтандартныеОшибки.НедопустимоеЗначениеАргумента("Опции",
			"отбор без Первые и Смещение: агрегат по странице не считается");
	КонецЕсли;

КонецПроцедуры

// Текст и дату не суммирует ни SQL, ни память — обе дороги отказывают одинаково и сразу.
Процедура ПроверитьЧтоПолеСуммируемо(Знач Сущность, Знач ИмяПоля)

	ТипПоля = Сущность.ТипПоля(ИмяПоля);
	Если ТипПоля <> ТипыКолонок.Целое И ТипПоля <> ТипыКолонок.Дробное Тогда
		ВызватьИсключение СтандартныеОшибки.ОперацияНеПоддерживается("агрегат",
			СтрШаблон("поле %1 таблицы %2 имеет тип %3 и не суммируется",
				ИмяПоля, Сущность.ИмяТаблицы(), ТипПоля));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПутьБазы

// Бэкенд без SQL — штатная работа, а не сбой: вердикт пробы уходит в журнал информацией.
Функция ПробаУдалась(Знач Хранилище)

	Попытка
		ОтветБазы(Хранилище, СтрШаблон("SELECT 1 AS %1", Текст.КолонкаЧисла()));
	Исключение
		Лог.Информация("Агрегаты считаются в памяти: коннектор %1 не исполняет SQL (%2)",
			Источник.ТипКоннектора(), Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

Функция ОтветБазы(Знач Хранилище, Знач ТекстЗапроса)

	Возврат Хранилище.ВычислитьСКоннектором(АлгоритмЗапроса(),
		Новый Структура("Текст", ТекстЗапроса));

КонецФункции

Функция АлгоритмЗапроса()
	Возврат "Коннектор -> Коннектор.ВыполнитьЗапрос(Текст)";
КонецФункции

// Число агрегатного запроса; пустой результат и NULL (SUM по пустому отбору) — ноль.
Функция ЧислоЗапросом(Знач Хранилище, Знач ТекстЗапроса)

	Таблица = ОтветБазы(Хранилище, ТекстЗапроса);
	Если Таблица.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Значение = Таблица[0][Текст.КолонкаЧисла()];

	Возврат ?(ЗначениеЗаполнено(Значение), Число(Значение), 0);

КонецФункции

Функция НаличиеЗапросом(Знач Хранилище, Знач ТекстЗапроса)
	Возврат ОтветБазы(Хранилище, ТекстЗапроса).Количество() > 0;
КонецФункции

// Разрез из ответа базы; ключ приводится к типу поля, как в разрезе, собранном в памяти.
Функция Разрез(Знач Сущность, Знач ИмяПоляКлюча, Знач Таблица)

	Итог = Новый Соответствие();
	ЦелыйКлюч = Сущность.ТипПоля(ИмяПоляКлюча) = ТипыКолонок.Целое;

	Для Каждого СтрокаОтвета Из Таблица Цикл
		Ключ = СтрокаОтвета[Текст.КолонкаКлюча()];
		Значение = СтрокаОтвета[Текст.КолонкаЧисла()];
		Итог.Вставить(?(ЦелыйКлюч, Цел(Ключ), Ключ), ?(ЗначениеЗаполнено(Значение), Число(Значение), 0));
	КонецЦикла;

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область ЖурналОтказов

// Несобранный хабом запрос и отказ базы называются разными словами: первый база не видела вовсе.
Процедура НазватьОтказ(Знач Сущность, Знач ВидАгрегата, Знач Инфо)

	НашаСборка = ДиагностикаОшибок.Содержит(Инфо,
		КодыСтандартныхОшибок.ОперацияНеПоддерживается());

	Шаблон = ?(НашаСборка,
		"Агрегат ""%1"" по таблице %2 не собран, считаю в памяти: %3",
		"Агрегат ""%1"" по таблице %2 база не посчитала, считаю в памяти: %3");

	// в журнал — готовой строкой: причина от базы может сама нести «%1»
	Сообщение = СтрШаблон(Шаблон, ВидАгрегата, Сущность.ИмяТаблицы(), Ошибки.Причина(Инфо));

	Ключ = СтрШаблон("%1/%2/%3", Сущность.ИмяТаблицы(), ВидАгрегата,
		?(НашаСборка, "сборка", "база"));

	Если ОтказНазванВпервые(Ключ) Тогда
		Лог.Предупреждение(Сообщение);
	Иначе
		Лог.Отладка(Сообщение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПутьПамяти

// Пустые значения пропускаются, как их пропускает SUM в SQL.
Функция СуммаВПамяти(Знач Хранилище, Знач Сущность, Знач ИмяПоля, Знач Опции)

	Итог = 0;
	Для Каждого Запись Из Хранилище.Получить(Опции) Цикл
		Слагаемое = Сущность.Значение(Запись, ИмяПоля);
		Если Слагаемое <> Неопределено Тогда
			Итог = Итог + Слагаемое;
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

Функция СчётПоКлючуВПамяти(Знач Хранилище, Знач Сущность, Знач ИмяПоляКлюча, Знач Опции)

	Итог = Новый Соответствие();
	Для Каждого Запись Из Хранилище.Получить(Опции) Цикл
		Ключ = Сущность.Значение(Запись, ИмяПоляКлюча);
		Итог.Вставить(Ключ, Накоплено(Итог, Ключ) + 1);
	КонецЦикла;

	Возврат Итог;

КонецФункции

Функция СуммаПоКлючуВПамяти(Знач Хранилище, Знач Сущность, Знач ИмяПоляКлюча, Знач ИмяПоляСуммы, Знач Опции)

	Итог = Новый Соответствие();
	Для Каждого Запись Из Хранилище.Получить(Опции) Цикл
		Ключ = Сущность.Значение(Запись, ИмяПоляКлюча);
		Слагаемое = Сущность.Значение(Запись, ИмяПоляСуммы);
		Итог.Вставить(Ключ, Накоплено(Итог, Ключ) + ?(Слагаемое = Неопределено, 0, Слагаемое));
	КонецЦикла;

	Возврат Итог;

КонецФункции

Функция Накоплено(Знач Итог, Знач Ключ)
	Было = Итог.Получить(Ключ);
	Возврат ?(Было = Неопределено, 0, Было);
КонецФункции

// Копия опций с «хватит одной строки»: Первые правит объект, а он принадлежит вызывающему.
Функция ОднаСтрока(Знач Опции)

	Копия = Новый ОпцииПоиска();
	Если Опции <> Неопределено Тогда
		Для Каждого Элемент Из Опции.Отборы() Цикл
			Копия.Отбор(Элемент.ПутьКДанным, Элемент.ВидСравнения, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат Копия.Первые(1);

КонецФункции

#КонецОбласти

#Область ОбщееСостояниеЖелудя

// Под замком: желудь-одиночка живёт под потоками winow, а проба одна на процесс.
Функция ВердиктПробыПодЗамком(Знач Хранилище)

	Замок.Заблокировать();
	Попытка
		Если ВердиктПробы = Неопределено Тогда
			ВердиктПробы = ПробаУдалась(Хранилище);
		КонецЕсли;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Возврат ВердиктПробы;

КонецФункции

// Под замком: два запроса под потоками winow строят описание одновременно.
Функция ЗапомнитьОписание(Знач Модель)

	Замок.Заблокировать();
	Попытка
		Готовое = ОписанияСущностей.Получить(Модель.ИмяТаблицы());
		Если Готовое = Неопределено Тогда
			Готовое = Новый ОписаниеСущности(Модель);
			ОписанияСущностей.Вставить(Модель.ИмяТаблицы(), Готовое);
		КонецЕсли;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Возврат Готовое;

КонецФункции

// Предупреждение одно на тройку «таблица, агрегат, вид отказа»; под замком — вставка из потоков winow.
Функция ОтказНазванВпервые(Знач Ключ)

	Замок.Заблокировать();
	Попытка
		Впервые = НазванныеОтказы.Получить(Ключ) = Неопределено;
		НазванныеОтказы.Вставить(Ключ, Истина);
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Возврат Впервые;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ИсточникДанных") _Источник,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Источник = _Источник;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Текст = Новый ТекстАгрегата();
	НазванныеОтказы = Новый Соответствие();
	ОписанияСущностей = Новый Соответствие();
	ВердиктПробы = Неопределено;
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
