// Снятие пачки строк со счётом снятого. Строку снимает либо она сама (запись entity умеет
// это без чужой помощи), либо фасад хранилища, который её отдал, — обе двери за одним
// правилом, потому что счёт снятого одинаков и нужен вызывающему как итог уборки.

// Снимает строки, каждая из которых удаляет себя сама, и считает снятые.
//
// Параметры:
//  Строки - Массив - снимаемые строки.
//
// Возвращаемое значение:
//  Число - сколько строк снято.
//
Функция Снять(Знач Строки) Экспорт

	Снято = 0;
	Для Каждого Запись Из Строки Цикл
		Запись.Удалить();
		Снято = Снято + 1;
	КонецЦикла;

	Возврат Снято;

КонецФункции

// Снимает строки фасадом хранилища, который их отдал, и считает снятые.
//
// Параметры:
//  Хранилище - Произвольный - фасад, которым снимать строку.
//  Строки - Массив - снимаемые строки.
//
// Возвращаемое значение:
//  Число - сколько строк снято.
//
Функция СнятьЧерез(Знач Хранилище, Знач Строки) Экспорт

	Снято = 0;
	Для Каждого Запись Из Строки Цикл
		Хранилище.Удалить(Запись);
		Снято = Снято + 1;
	КонецЦикла;

	Возврат Снято;

КонецФункции

&Прозвище("СнятиеСтрок")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
