// Хранилище прикладных настроек — доменный фасад над ЗапросыПрикладныхНастроек.
// Хранит только введённое руками; конфиг сюда не копируется никогда.

Перем Запросы;

// Значение ключа либо Неопределено, если руками ничего не вводилось.
//
// Параметры:
//  Ключ - Строка - ключ настройки (НРег).
//
// Возвращаемое значение:
//  Строка, Неопределено.
//
Функция Значение(Знач Ключ) Экспорт

	Запись = НайтиЗапись(Ключ);
	Возврат ?(Запись = Неопределено, Неопределено, Запись.Значение);

КонецФункции

// Записывает значение ключа: вставка либо перезапись той же строки.
//
// Параметры:
//  Ключ - Строка - ключ настройки (НРег).
//  Значение - Строка - каноничная строковая форма значения.
//  Кто - Строка - логин автора изменения.
//  Когда - Дата - момент (UTC).
//
Процедура Установить(Знач Ключ, Знач Значение, Знач Кто, Знач Когда) Экспорт

	Запись = НайтиЗапись(Ключ);
	Если Запись = Неопределено Тогда
		Запись = Запросы.СоздатьЭлемент();
		Запись.Ключ = Ключ;
	КонецЕсли;

	Запись.Значение = Значение;
	Запись.Обновлена = Когда;
	Запись.КемОбновлена = Кто;
	Запись.Сохранить();

КонецПроцедуры

// Удаляет значение ключа; отсутствие записи — не ошибка, сброс идемпотентен.
//
// Параметры:
//  Ключ - Строка - ключ настройки из реестра (НРег).
//
Процедура Удалить(Знач Ключ) Экспорт

	Запись = НайтиЗапись(Ключ);
	Если Запись <> Неопределено Тогда
		Запросы.Удалить(Запись);
	КонецЕсли;

КонецПроцедуры

// Все введённые руками значения.
//
// Возвращаемое значение:
//  Массив из ПрикладнаяНастройка.
//
Функция Все() Экспорт
	Возврат Запросы.ПолучитьУпорядочитьПоКлючВозр();
КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция НайтиЗапись(Знач Ключ)

	Найденные = Запросы.ПолучитьПоКлючРавноПервые(НРег(СокрЛП(Строка(Ключ))), 1);
	Возврат ?(Найденные.Количество() = 0, Неопределено, Найденные[0]);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин ЗапросыПрикладныхНастроек) Экспорт
	Запросы = ЗапросыПрикладныхНастроек;
КонецПроцедуры
