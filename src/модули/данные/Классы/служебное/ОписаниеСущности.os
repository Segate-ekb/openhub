// Сущность глазами агрегата: имя таблицы, имя колонки поля, тип поля и значение поля
// в строке. Колонки читаются один раз — ОбъектМодели отдаёт копию своей таблицы на каждый
// вызов, и поиск поля в ней стоил бы копии всей таблицы на каждое поле отбора.

#Использовать errors

Перем Модель;
Перем ИмяТаблицы_;
Перем ПоИмениПоля;   // Соответствие: имя поля → ФиксированнаяСтруктура(ИмяКолонки, ТипКолонки)

// Имя таблицы сущности в базе.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяТаблицы() Экспорт
	Возврат ИмяТаблицы_;
КонецФункции

// Имя колонки, которой поле лежит в базе.
//
// Параметры:
//  ИмяПоля - Строка - имя поля сущности.
//
// Возвращаемое значение:
//  Строка.
//
Функция Колонка(Знач ИмяПоля) Экспорт
	Возврат Описание(ИмяПоля).ИмяКолонки;
КонецФункции

// Тип поля в модели: «Целое», «Строка», «Булево», «ДатаВремя» и прочие имена ТипыКолонок.
//
// Параметры:
//  ИмяПоля - Строка - имя поля сущности.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТипПоля(Знач ИмяПоля) Экспорт
	Возврат Описание(ИмяПоля).ТипКолонки;
КонецФункции

// Значение поля в строке сущности.
//
// Параметры:
//  Запись - Произвольный - строка сущности.
//  ИмяПоля - Строка - имя поля сущности.
//
// Возвращаемое значение:
//  Произвольный - значение поля.
//
Функция Значение(Знач Запись, Знач ИмяПоля) Экспорт

	// поле, которого в модели нет, обязано отказать одинаково на обеих дорогах
	ПроверитьПоле(ИмяПоля);

	Возврат Модель.ПолучитьЗначениеПоля(Запись, ИмяПоля);

КонецФункции

#Область СлужебныеПроцедурыИФункции

// Чужое поле — это наша несобранная выборка, а не отказ базы, и код говорит именно это.
Процедура ПроверитьПоле(Знач ИмяПоля)
	Описание(ИмяПоля);
КонецПроцедуры

Функция Описание(Знач ИмяПоля)

	Найденное = ПоИмениПоля.Получить(ИмяПоля);
	Если Найденное = Неопределено Тогда
		ВызватьИсключение СтандартныеОшибки.ОперацияНеПоддерживается("агрегат",
			СтрШаблон("в таблице %1 нет поля %2", ИмяТаблицы_, ИмяПоля));
	КонецЕсли;

	Возврат Найденное;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач ОбъектМодели)

	Модель = ОбъектМодели;
	ИмяТаблицы_ = ОбъектМодели.ИмяТаблицы();
	ПоИмениПоля = Новый Соответствие();

	Для Каждого СтрокаКолонки Из ОбъектМодели.Колонки() Цикл
		ПоИмениПоля.Вставить(СтрокаКолонки.ИмяПоля,
			Новый ФиксированнаяСтруктура("ИмяКолонки, ТипКолонки",
				СтрокаКолонки.ИмяКолонки, СтрокаКолонки.ТипКолонки));
	КонецЦикла;

КонецПроцедуры
