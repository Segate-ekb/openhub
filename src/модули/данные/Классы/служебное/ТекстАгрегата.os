// Текст SQL-агрегата по описанию сущности: счёт строк, сумма поля, признак наличия и те же
// два в разрезе ключа. Имя таблицы и имена колонок приходят из модели, значения отбора
// попадают в текст единственной дверью — функцией Литерал.
//
// Всё, чего класс собрать не может — незнакомый вид сравнения, значение без литерала,
// чужое поле, — он объявляет кодом «операция не поддерживается»: так вызывающий отличает
// свой несобранный запрос от отказа базы.
//
// Незаполненный момент база хранит не так, как память: Npgsql пишет пустую дату
// в timestamp как -infinity, и «= '0001-01-01 00:00:00'» не находит ни строки — молча,
// без единой ошибки. Поэтому «равно пустому моменту» печатается как «<= пустого»,
// «не равно» — как «> пустого», и вызывающий пишет отбор так же, как пишет его деривация.
// Сходятся с памятью только «больше пустого» и «не позже пустого»; «не раньше пустого»
// и «раньше пустого» на -infinity отвечают наоборот, и агрегат их отвергает.

#Использовать entity
#Использовать errors

Перем ИзвестныеВиды;   // Соответствие: вид сравнения entity → Истина

#Область ПубличныйИнтерфейс

// Имя колонки, которой запрос отдаёт число — счёт либо сумму.
//
// Возвращаемое значение:
//  Строка.
//
Функция КолонкаЧисла() Экспорт
	Возврат "n";
КонецФункции

// Имя колонки, которой запрос с группировкой отдаёт ключ разреза.
//
// Возвращаемое значение:
//  Строка.
//
Функция КолонкаКлюча() Экспорт
	Возврат "k";
КонецФункции

// Запрос счёта строк таблицы.
//
// Параметры:
//  Сущность - ОписаниеСущности - сущность, строки которой считаются.
//  Опции - ОпцииПоиска, Неопределено - отбор; Неопределено — вся таблица.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция Количество(Знач Сущность, Знач Опции = Неопределено) Экспорт

	Возврат СтрШаблон("SELECT COUNT(*) AS %1 FROM %2%3",
		КолонкаЧисла(), Сущность.ИмяТаблицы(), Условия(Сущность, Опции));

КонецФункции

// Запрос, отдающий строку тогда и только тогда, когда отбору отвечает хоть одна строка
// таблицы. Сами значения строки не нужны, поэтому выбирается константа.
//
// Параметры:
//  Сущность - ОписаниеСущности - описание сущности.
//  Опции - ОпцииПоиска, Неопределено - отбор; Неопределено — вся таблица.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция Наличие(Знач Сущность, Знач Опции = Неопределено) Экспорт

	Возврат СтрШаблон("SELECT 1 AS %1 FROM %2%3 LIMIT 1",
		КолонкаЧисла(), Сущность.ИмяТаблицы(), Условия(Сущность, Опции));

КонецФункции

// Запрос суммы поля по строкам таблицы.
//
// Параметры:
//  Сущность - ОписаниеСущности - описание сущности.
//  ИмяПоля - Строка - суммируемое поле сущности.
//  Опции - ОпцииПоиска, Неопределено - отбор; Неопределено — вся таблица.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция Сумма(Знач Сущность, Знач ИмяПоля, Знач Опции = Неопределено) Экспорт

	Возврат СтрШаблон("SELECT SUM(%1) AS %2 FROM %3%4",
		Сущность.Колонка(ИмяПоля), КолонкаЧисла(), Сущность.ИмяТаблицы(), Условия(Сущность, Опции));

КонецФункции

// Запрос счёта строк в разрезе ключа.
//
// Параметры:
//  Сущность - ОписаниеСущности - описание сущности.
//  ИмяПоляКлюча - Строка - поле, по которому идёт группировка.
//  Опции - ОпцииПоиска, Неопределено - отбор; Неопределено — вся таблица.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция КоличествоПоКлючу(Знач Сущность, Знач ИмяПоляКлюча, Знач Опции = Неопределено) Экспорт

	Ключ = Сущность.Колонка(ИмяПоляКлюча);

	Возврат СтрШаблон("SELECT %1 AS %2, COUNT(*) AS %3 FROM %4%5 GROUP BY %1",
		Ключ, КолонкаКлюча(), КолонкаЧисла(), Сущность.ИмяТаблицы(), Условия(Сущность, Опции));

КонецФункции

// Запрос суммы поля в разрезе ключа.
//
// Параметры:
//  Сущность - ОписаниеСущности - описание сущности.
//  ИмяПоляКлюча - Строка - поле, по которому идёт группировка.
//  ИмяПоляСуммы - Строка - суммируемое поле сущности.
//  Опции - ОпцииПоиска, Неопределено - отбор; Неопределено — вся таблица.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция СуммаПоКлючу(Знач Сущность, Знач ИмяПоляКлюча, Знач ИмяПоляСуммы, Знач Опции = Неопределено) Экспорт

	Ключ = Сущность.Колонка(ИмяПоляКлюча);

	Возврат СтрШаблон("SELECT %1 AS %2, SUM(%3) AS %4 FROM %5%6 GROUP BY %1",
		Ключ, КолонкаКлюча(), Сущность.Колонка(ИмяПоляСуммы), КолонкаЧисла(),
		Сущность.ИмяТаблицы(), Условия(Сущность, Опции));

КонецФункции

// Отбор, которому заведомо не отвечает ни одна строка: «В» с пустым списком значений.
// Такой агрегат отвечает нулём, не спрашивая базу ни запросом, ни выборкой.
//
// Параметры:
//  Опции - ОпцииПоиска, Неопределено - отбор.
//
// Возвращаемое значение:
//  Булево.
//
Функция ОтборНикогоНеВыберет(Знач Опции) Экспорт

	Если Опции = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Элемент Из Опции.Отборы() Цикл
		Если Элемент.ВидСравнения = ВидСравнения.В И Элемент.Значение.Количество() = 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Условия(Знач Сущность, Знач Опции)

	Если Опции = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив();
	Для Каждого Элемент Из Опции.Отборы() Цикл
		Части.Добавить(Условие(Сущность, Элемент));
	КонецЦикла;

	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	// отборы складываются, а не выбираются: ОпцииПоиска знают только «И», и entity
	// склеивает их точно так же
	Возврат " WHERE " + СтрСоединить(Части, " AND ");

КонецФункции

Функция Условие(Знач Сущность, Знач Элемент)

	Вид = Оператор(Элемент.ВидСравнения, Элемент.ПутьКДанным);
	Поле = Сущность.Колонка(Элемент.ПутьКДанным);

	ТипКолонки = Сущность.ТипПоля(Элемент.ПутьКДанным);

	Если Элемент.ВидСравнения = ВидСравнения.В ИЛИ Элемент.ВидСравнения = ВидСравнения.НеВ Тогда
		Возврат Множество(Поле, Вид, Элемент.Значение, ТипКолонки);
	КонецЕсли;

	Возврат СтрШаблон("%1 %2 %3", Поле,
		ВидДляЗначения(Вид, Элемент.Значение, Элемент.ПутьКДанным),
		Литерал(Элемент.Значение, ТипКолонки));

КонецФункции

// Пустая дата лежит в базах по-разному: PostgreSQL хранит её как -infinity, остальные —
// как 0001-01-01. Равенство сходится только на вторых, «не позже» и «больше» — на всех.
//
// «Не раньше пустого» и «раньше пустого» на -infinity отвечают ровно наоборот памяти:
// в памяти первое берёт ВСЕ строки, а второе — НИ ОДНОЙ; в PostgreSQL наоборот. Переписать
// их нечем, и агрегат отказывается громко — ответ приедет выборкой, а не тихо неверным
// числом.
Функция ВидДляЗначения(Знач Вид, Знач Значение, Знач ИмяПоля)

	Если НЕ ЭтоПустойМомент(Значение) Тогда
		Возврат Вид;
	КонецЕсли;

	Если Вид = ВидСравнения.Равно Тогда
		Возврат ВидСравнения.МеньшеИлиРавно;
	ИначеЕсли Вид = ВидСравнения.НеРавно Тогда
		Возврат ВидСравнения.Больше;
	ИначеЕсли Вид = ВидСравнения.БольшеИлиРавно ИЛИ Вид = ВидСравнения.Меньше Тогда
		ВызватьИсключение СтандартныеОшибки.ОперацияНеПоддерживается("агрегат",
			СтрШаблон("вид сравнения ""%1"" с незаполненным моментом (поле %2)"
				+ " в базе и в памяти отбирает разное", Вид, ИмяПоля));
	КонецЕсли;

	Возврат Вид;

КонецФункции

Функция ЭтоПустойМомент(Знач Значение)
	Возврат ТипЗнч(Значение) = Тип("Дата") И НЕ ЗначениеЗаполнено(Значение);
КонецФункции

// Вид сравнения entity — это и есть оператор SQL («=», «<>», «IN»), и печатает его так же
// сама entity. Белый список нужен, чтобы незнакомое значение не уехало в текст оператором
// и чтобы отбор не пропал молча: число по всей таблице выглядит как настоящее.
Функция Оператор(Знач Вид, Знач ИмяПоля)

	Если ИзвестныеВиды.Получить(Вид) = Неопределено Тогда
		ВызватьИсключение СтандартныеОшибки.ОперацияНеПоддерживается("агрегат",
			СтрШаблон("вид сравнения ""%1"" (поле %2) агрегату неизвестен", Вид, ИмяПоля));
	КонецЕсли;

	Возврат Вид;

КонецФункции

// Скобок с пустым нутром SQL не понимает, поэтому пустое множество превращается
// в константу условия: «В пустом» не выберет никого, «НЕ В пустом» не отсеет никого.
Функция Множество(Знач Поле, Знач Вид, Знач Значения, Знач ТипКолонки)

	Литералы = Новый Массив();
	Для Каждого Значение Из Значения Цикл
		Если ЭтоПустойМомент(Значение) Тогда
			// диапазоном список не переписать, а равенством пустой момент на PostgreSQL
			// не находится: отказываем громко, а не отвечаем тихо не тем числом
			ВызватьИсключение СтандартныеОшибки.ОперацияНеПоддерживается("агрегат",
				"незаполненный момент в списке значений отбора не сравнивается");
		КонецЕсли;
		Литералы.Добавить(Литерал(Значение, ТипКолонки));
	КонецЦикла;

	Если Литералы.Количество() = 0 Тогда
		Возврат ?(Вид = ВидСравнения.НеВ, "TRUE", "FALSE");
	КонецЕсли;

	Возврат СтрШаблон("%1 %2 (%3)", Поле, Вид, СтрСоединить(Литералы, ", "));

КонецФункции

// Единственная дверь, которой значение попадает в текст запроса.
//
// Строка проходит через удвоение одинарной кавычки: апостроф в имени пула — законное имя,
// а не попытка дописать запрос. Число печатается только целым и только через Строку:
// Формат под русской локалью отдаёт «1,5», и такой текст база разбирает как два значения.
// Момент печатается по типу колонки: колонке «Дата» база отбрасывает время сама, и время
// в литерале сделало бы «равно моменту» равенством целым суткам.
Функция Литерал(Знач Значение, Знач ТипКолонки)

	ТипЗначения = ТипЗнч(Значение);

	Если ТипЗначения = Тип("Строка") Тогда
		Возврат "'" + СтрЗаменить(Значение, "'", "''") + "'";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат ЦелоеЛитералом(Значение);
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		// оба диалекта понимают слова; «1»/«0» в PostgreSQL для boolean не проходят
		Возврат ?(Значение, "TRUE", "FALSE");
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат МоментЛитералом(Значение, ТипКолонки);
	КонецЕсли;

	ВызватьИсключение СтандартныеОшибки.ОперацияНеПоддерживается("агрегат",
		СтрШаблон("значению типа %1 литерала в запросе нет", ТипЗначения));

КонецФункции

// Форма литерала — по типу колонки: колонке суток база отбрасывает время сама, и время
// в литерале сделало бы «равно моменту» равенством целым суткам.
//
// Представление пустой даты задаётся явно: без «ДП» Формат печатает пустую дату ПУСТОЙ
// СТРОКОЙ, и отбор «момент не заполнен» — законный вопрос хаба про бессрочный ключ —
// уезжал бы в запрос как сравнение с ''. PostgreSQL на это отвечает «invalid input syntax
// for type timestamp», а SQLite молча не находит ни одной строки.
Функция МоментЛитералом(Знач Значение, Знач ТипКолонки)

	Если ТипКолонки = ТипыКолонок.Дата Тогда
		Шаблон = "ДФ='yyyy-MM-dd'; ДП='0001-01-01'";
	ИначеЕсли ТипКолонки = ТипыКолонок.Время Тогда
		Шаблон = "ДФ='HH:mm:ss'; ДП='00:00:00'";
	Иначе
		Шаблон = "ДФ='yyyy-MM-dd HH:mm:ss'; ДП='0001-01-01 00:00:00'";
	КонецЕсли;

	Возврат "'" + Формат(Значение, Шаблон) + "'";

КонецФункции

Функция ЦелоеЛитералом(Знач Значение)

	Если Цел(Значение) <> Значение Тогда
		ВызватьИсключение СтандартныеОшибки.ОперацияНеПоддерживается("агрегат",
			СтрШаблон("дробному числу %1 литерала в запросе нет", Строка(Значение)));
	КонецЕсли;

	Возврат Строка(Цел(Значение));

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()

	ИзвестныеВиды = Новый Соответствие();
	ИзвестныеВиды.Вставить(ВидСравнения.Равно, Истина);
	ИзвестныеВиды.Вставить(ВидСравнения.НеРавно, Истина);
	ИзвестныеВиды.Вставить(ВидСравнения.Больше, Истина);
	ИзвестныеВиды.Вставить(ВидСравнения.БольшеИлиРавно, Истина);
	ИзвестныеВиды.Вставить(ВидСравнения.Меньше, Истина);
	ИзвестныеВиды.Вставить(ВидСравнения.МеньшеИлиРавно, Истина);
	ИзвестныеВиды.Вставить(ВидСравнения.В, Истина);
	ИзвестныеВиды.Вставить(ВидСравнения.НеВ, Истина);

КонецПроцедуры
