// Хранилище помех — фасад сущности «Помеха» над ЗапросыПомех: выборки по паре
// подсистема + объект, уборка по сроку и заведение строки.

Перем Запросы;

// Помехи подсистемы по объекту, последние сверху.
//
// Параметры:
//  Подсистема - Строка - «хранилище» | «зеркало» | «источник».
//  Объект - Строка - адрес объекта.
//
// Возвращаемое значение:
//  Массив из Помеха.
//
Функция ПоОбъекту(Знач Подсистема, Знач Объект) Экспорт

	Возврат Запросы.ПолучитьПоПодсистемаРавноИОбъектРавноУпорядочитьПоПоследнийУбывИдентификаторУбыв(
		Текстом(Подсистема), Текстом(Объект));

КонецФункции

// Помехи подсистемы по нескольким объектам сразу, последние сверху: срез для экрана,
// показывающего список объектов. Пустой список объектов до базы не доезжает.
//
// Параметры:
//  Подсистема - Строка - «хранилище» | «зеркало» | «источник».
//  Объекты - Массив из Строка - адреса объектов.
//
// Возвращаемое значение:
//  Массив из Помеха.
//
Функция ПоОбъектам(Знач Подсистема, Знач Объекты) Экспорт

	Отбор = Новый Массив();
	Для Каждого Объект Из Объекты Цикл
		Отбор.Добавить(Текстом(Объект));
	КонецЦикла;

	Если Отбор.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Возврат Запросы.ПолучитьПоПодсистемаРавноИОбъектВУпорядочитьПоПоследнийУбывИдентификаторУбыв(
		Текстом(Подсистема), Отбор);

КонецФункции

// Помехи подсистемы по объекту в пределах одного обхода, последние сверху.
//
// Параметры:
//  Подсистема - Строка - подсистема.
//  Объект - Строка - адрес объекта.
//  Прогон - Строка - метка обхода.
//
// Возвращаемое значение:
//  Массив из Помеха.
//
Функция ПоОбъектуИПрогону(Знач Подсистема, Знач Объект, Знач Прогон) Экспорт

	Возврат Запросы.ПолучитьПоПодсистемаРавноИОбъектРавноИПрогонРавноУпорядочитьПоПоследнийУбывИдентификаторУбыв(
		Текстом(Подсистема), Текстом(Объект), Текстом(Прогон));

КонецФункции

// Помехи, которых последний раз касались раньше названного момента.
//
// Параметры:
//  Момент - Дата - граница срока (UTC).
//
// Возвращаемое значение:
//  Массив из Помеха.
//
Функция СтарееЧем(Знач Момент) Экспорт
	Возврат Запросы.ПолучитьПоПоследнийМеньше(Момент);
КонецФункции

// Новая несохранённая помеха.
//
// Возвращаемое значение:
//  Помеха.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

// Удаляет помеху.
//
// Параметры:
//  Запись - Помеха - строка таблицы.
//
Процедура Удалить(Знач Запись) Экспорт
	Запросы.Удалить(Запись);
КонецПроцедуры

// Пустая строка вместо Неопределено: отбор сверяется равенством, и незаполненное
// поле обязано быть одним и тем же значением у записи и у условия.
Функция Текстом(Знач Значение)
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ЗапросыПомех") _Запросы)
	Запросы = _Запросы;
КонецПроцедуры
