// Отвечает ли база: снимок пула соединений и одно дешёвое чтение из него же.
// Спрашивают пробу адреса живости и готовности, то есть раз в несколько секунд.
//
// Одно правило объясняет тут всё остальное: проба НЕ ВСТАЁТ В ОЧЕРЕДЬ за соединением.
// Исчерпанный пул она называет отказом по снимку и запрос не делает — иначе заявка ждала бы
// предела ожидания пула (30 с) и не уложилась бы ни в один таймаут оркестратора, а сама проба
// заняла бы место в очереди, которого не хватает работающим запросам.

#Использовать entity
#Использовать errors

Перем Менеджер;          // МенеджерСущностей (entity)
Перем Ошибки;            // ТекстОшибки (основа)
Перем Замок;             // БлокировкаРесурса — желудь-одиночка живёт под потоками winow
Перем БазаОтвечала;      // Булево, Неопределено — вердикт прошлой пробы; Неопределено — не пробовали
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Состояние базы для тела проб: отвечает ли, снимок пула и причина отказа.
//
// Возвращаемое значение:
//  Структура - status ("ok" либо "unavailable"), pool (busy, free, waiting, created, limit),
//              reason (Строка) — только у отказа.
//
Функция Состояние() Экспорт

	Снимок = Неопределено;
	Отказ = "";
	ОтказЖурналу = "";

	Попытка
		Снимок = СнимокПула();
		Отказ = ПричинаПоСнимку(Снимок);
		ОтказЖурналу = Отказ;
		Если НЕ ЗначениеЗаполнено(Отказ) Тогда
			ПрочитатьСтрокуИзБазы();
		КонецЕсли;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Отказ = ФразаОтказа(Инфо);
		ОтказЖурналу = Ошибки.Причина(Инфо);
	КонецПопытки;

	ЗаписатьСменуВердикта(Отказ, ОтказЖурналу);

	Возврат РазделБазы(Снимок, Отказ);

КонецФункции

// Означает ли снятое состояние, что база отвечает.
//
// Параметры:
//  СостояниеБазы - Структура - результат Состояние().
//
// Возвращаемое значение:
//  Булево.
//
Функция Отвечает(Знач СостояниеБазы) Экспорт
	Возврат СостояниеБазы["status"] = "ok";
КонецФункции

#КонецОбласти

#Область Замер

// Снимок пула читается ДО запроса и по нему же решается, делать ли запрос вообще.
// Между снимком и захватом соединение может уйти другому потоку — тогда проба всё-таки
// встанет в очередь. Гонка неустранима без захвата с нулевым ожиданием, которого пул
// не предлагает: снимок сужает окно с «всегда» до «редко», а не закрывает его.
Функция СнимокПула()

	Источник = Менеджер.ИсточникДанных();
	ПулСоединений = Источник.ПулСоединений();

	Снимок = Новый Структура();
	Снимок.Вставить("Занято", ПулСоединений.КоличествоЗанятых());
	Снимок.Вставить("Свободно", ПулСоединений.КоличествоСвободных());
	Снимок.Вставить("Ожидают", ПулСоединений.КоличествоОжидающих());
	Снимок.Вставить("Создано", ПулСоединений.КоличествоСозданных());
	Снимок.Вставить("Предел", Источник.РазмерПула());

	Возврат Снимок;

КонецФункции

// Пустая строка — пул отдаст соединение, не ставя пробу в очередь: либо есть свободное,
// либо у пула остались места и он вправе открыть новое.
//
// С пределом сравниваются ЗАНЯТЫЕ МЕСТА, а не соединения у потоков: место занимает и бронь
// под соединение, которое прямо сейчас открывается, — по самой entity «именно это число
// сравнивается с размером пула, и именно оно протекает, если неудачное открытие не вернёт
// своё место». Считай проба по занятым соединениям — она пошла бы в базу ровно тогда, когда
// мест уже нет, и встала бы в очередь.
Функция ПричинаПоСнимку(Знач Снимок)

	Если Снимок.Свободно > 0 Тогда
		Возврат "";
	КонецЕсли;

	// Нулевой предел очереди не создаёт: пул без предела открывает соединение каждому,
	// кому свободного не досталось, — исчерпать его нечем.
	ПулИсчерпан = Снимок.Ожидают > 0
		ИЛИ (Снимок.Предел > 0 И Снимок.Создано >= Снимок.Предел);

	Если НЕ ПулИсчерпан Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(
		"пул соединений исчерпан: занято %1, свободных нет, ждут %2, мест занято %3 из %4",
		Снимок.Занято, Снимок.Ожидают, Снимок.Создано, Снимок.Предел);

КонецФункции

// Дешёвое чтение, одинаковое на любом бэкенде: настройки читаются и коннектором с SQL,
// и файловым. Пишет проба только в журнал и только на смене вердикта — её зовут раз
// в секунды, и строка на каждый вызов завалила бы и журнал, и базу.
Процедура ПрочитатьСтрокуИзБазы()
	Менеджер.Получить(Тип("ПрикладнаяНастройка"), Новый ОпцииПоиска().Первые(1));
КонецПроцедуры

#КонецОбласти

#Область ФормаОтвета

Функция РазделБазы(Знач Снимок, Знач Отказ)

	Отвечает = НЕ ЗначениеЗаполнено(Отказ);

	Данные = Новый Структура();
	Данные.Вставить("status", ?(Отвечает, "ok", "unavailable"));
	// снимка нет ровно в одном случае: источник данных закрыт и пула у него уже нет
	Если Снимок <> Неопределено Тогда
		Данные.Вставить("pool", РазделПула(Снимок));
	КонецЕсли;
	Если НЕ Отвечает Тогда
		Данные.Вставить("reason", Отказ);
	КонецЕсли;

	Возврат Данные;

КонецФункции

Функция РазделПула(Знач Снимок)

	Данные = Новый Структура();
	Данные.Вставить("busy", Снимок.Занято);
	Данные.Вставить("free", Снимок.Свободно);
	Данные.Вставить("waiting", Снимок.Ожидают);
	Данные.Вставить("created", Снимок.Создано);
	Данные.Вставить("limit", Снимок.Предел);

	Возврат Данные;

КонецФункции

// В тело проб уходит фраза без внутренностей хаба: /health и /ready открыты кому угодно,
// и путь к файлу библиотеки с номером строки там — подсказка не оператору, а атакующему.
// Полная причина с местом возникновения уходит в журнал.
Функция ФразаОтказа(Знач Инфо)

	Фраза = Ошибки.ДляЧеловека(Инфо);

	Возврат ?(ЗначениеЗаполнено(Фраза), Фраза, "обращение к базе завершилось ошибкой");

КонецФункции

#КонецОбласти

#Область ЖурналСмены

// В журнал попадает смена вердикта, а не каждая проба: оператору нужен момент, когда база
// отвалилась и когда вернулась, а не пятитысячная строка «база отвечает» за сутки.
Процедура ЗаписатьСменуВердикта(Знач Отказ, Знач ОтказЖурналу)

	Отвечает = НЕ ЗначениеЗаполнено(Отказ);

	Если НЕ ВердиктСменился(Отвечает) Тогда
		Возврат;
	КонецЕсли;

	Если Отвечает Тогда
		Лог.Информация("Проба базы: база отвечает");
	Иначе
		Лог.Предупреждение("Проба базы: база не отвечает — %1", ОтказЖурналу);
	КонецЕсли;

КонецПроцедуры

// Под замком, потому что желудь-одиночка живёт под потоками winow: без него две
// одновременные пробы записали бы смену дважды.
Функция ВердиктСменился(Знач Отвечает)

	Замок.Заблокировать();
	Попытка
		Сменился = БазаОтвечала <> Отвечает;
		БазаОтвечала = Отвечает;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Возврат Сменился;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "МенеджерСущностей") _Менеджер,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Менеджер = _Менеджер;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
	БазаОтвечала = Неопределено;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
