// Заявка со сроком: три таблицы людей — вход из CLI, установка пароля, подтверждение
// адреса — живут по одному правилу «заведена, дождалась своего или истекла». Общее здесь:
// срок, создание и удаление заявки. Своё у каждой таблицы — ключ, которым заявку ищут
// (код устройства, идентификатор, учётка): за ним фасад берёт Запросы() и спрашивает сам.

Перем ЗапросыЗаявок;

// Заявки с истёкшим на момент сроком.
//
// Параметры:
//  Момент - Дата - универсальное время.
//
// Возвращаемое значение:
//  Массив - заявки, чей срок истёк.
//
Функция ИстёкшиеДо(Знач Момент) Экспорт
	Возврат ЗапросыЗаявок.ПолучитьПоИстекаетМеньшеИлиРавно(Момент);
КонецФункции

// Новая несохранённая заявка.
//
// Возвращаемое значение:
//  Произвольный - запись таблицы.
//
Функция СоздатьЭлемент() Экспорт
	Возврат ЗапросыЗаявок.СоздатьЭлемент();
КонецФункции

// Удаляет заявку.
//
// Параметры:
//  Заявка - Произвольный - запись таблицы.
//
Процедура Удалить(Знач Заявка) Экспорт
	ЗапросыЗаявок.Удалить(Заявка);
КонецПроцедуры

// Деривованные запросы таблицы — ими фасад ищет заявку по своему ключу.
//
// Возвращаемое значение:
//  Произвольный - класс запросов сущности.
//
Функция Запросы() Экспорт
	Возврат ЗапросыЗаявок;
КонецФункции

Процедура ПриСозданииОбъекта(Знач Запросы)
	ЗапросыЗаявок = Запросы;
КонецПроцедуры
