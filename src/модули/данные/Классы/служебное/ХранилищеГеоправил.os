// Хранилище геоправил — репозиторий сущности «ГеоПравило», таблицы правил по ключу. Единственная
// точка записи — НайтиИлиЗавести таблицы: второй строки на тот же ключ ей взяться неоткуда.
// Точечного чтения в доменном API нет намеренно: правил на инсталляции десятки, и владелец
// правил держит снимок всей таблицы, а не ходит в базу на каждый вопрос.

// BSLLS:UnusedParameters-off

Перем Сам;     // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё
Перем Замок;   // БлокировкаРесурса — сериализация read-modify-write «найти или завести»
               // в пределах ОДНОГО процесса: двух рабочих хаба она не разводит

// Строки с заданным ключом; ключ нормализует вызывающий.
//
// Параметры:
//  Ключ - Строка - каноничная форма (НРег без окружающих пробелов).
//  Лимит - Число - максимум строк.
//
// Возвращаемое значение:
//  Массив из ГеоПравило.
//
&МетодЗапроса
Функция ПолучитьПоКлючРавноПервые(Ключ, Лимит) Экспорт
	Возврат Неопределено;
КонецФункции

// Вся таблица правил в порядке ключа.
//
// Возвращаемое значение:
//  Массив из ГеоПравило.
//
&МетодЗапроса
Функция ПолучитьУпорядочитьПоКлючВозр() Экспорт
	Возврат Неопределено;
КонецФункции

// Записывает страны правила: вставка либо перезапись той же строки.
//
// Параметры:
//  Ключ - Строка - ключ правила; регистр и окружающие пробелы не значимы.
//  Страны - Строка - каноничный список кодов через запятую.
//  Кто - Строка - логин автора изменения.
//  Когда - Дата - момент (UTC).
//
&Наблюдаемый
Процедура Установить(Знач Ключ, Знач Страны, Знач Кто, Знач Когда) Экспорт

	Замок.Заблокировать();
	Попытка
		Записать(Ключ, Страны, Кто, Когда);
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

КонецПроцедуры

// Удаляет правило; отсутствие строки — не ошибка, снятие идемпотентно.
//
// Параметры:
//  Ключ - Строка - ключ правила; регистр и окружающие пробелы не значимы.
//
&Наблюдаемый
Процедура Удалить(Знач Ключ) Экспорт

	Замок.Заблокировать();
	Попытка
		Таблица().Удалить(Ключ);
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

КонецПроцедуры

// Все правила в порядке ключа.
//
// Возвращаемое значение:
//  Массив из ГеоПравило.
//
Функция Все() Экспорт
	Возврат Таблица().Все();
КонецФункции

#Область СлужебныеПроцедурыИФункции

// «Найти или завести» — read-modify-write: без замка два администратора, правящие правило
// одновременно, заводят на один ключ две строки, и снятие убирает только первую. Замок
// держит это в пределах одного процесса; для нескольких рабочих сразу его недостаточно.
Процедура Записать(Знач Ключ, Знач Страны, Знач Кто, Знач Когда)

	Запись = Таблица().НайтиИлиЗавести(Ключ);

	Запись.Страны = Страны;
	Запись.Обновлено = Когда;
	Запись.КемОбновлено = Кто;
	Запись.Сохранить();

КонецПроцедуры

// Таблица «ключ → строка» над этим же хранилищем.
Функция Таблица()
	Возврат Новый ТаблицаПоКлючу(Сам.Достать());
КонецФункции

#КонецОбласти

&ХранилищеСущностей("ГеоПравило")
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин(Значение = "ХранилищеГеоправил") _Сам)
	Сам = _Сам;
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
КонецПроцедуры
