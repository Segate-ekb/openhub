// Таблица «ключ → строка» над хранилищем с заглушками ПолучитьПоКлючРавноПервые и
// ПолучитьУпорядочитьПоКлючВозр; строку удаляет сама запись — «Удалить» хранилища занят удалением по ключу.

Перем Хранилище;  // хранилище таблицы из контейнера: заглушки отвечают только у декоратора
Перем Строки;     // КанонСтроки (основа)

// Строка с этим ключом.
//
// Параметры:
//  Ключ - Строка - регистр и окружающие пробелы не значимы.
//
// Возвращаемое значение:
//  Произвольный - строка таблицы либо Неопределено, если ключа в ней нет.
//
Функция НайтиЗапись(Знач Ключ) Экспорт

	Найденные = Хранилище.ПолучитьПоКлючРавноПервые(Канон(Ключ), 1);

	Возврат ?(Найденные.Количество() = 0, Неопределено, Найденные[0]);

КонецФункции

// Строка, в которую пишется значение этого ключа: найденная либо новая с каноничным
// ключом. Новая несохранена — поля заполняет и сохраняет вызывающий.
//
// Параметры:
//  Ключ - Строка - регистр и окружающие пробелы не значимы.
//
// Возвращаемое значение:
//  Произвольный - строка таблицы.
//
Функция НайтиИлиЗавести(Знач Ключ) Экспорт

	Запись = НайтиЗапись(Ключ);
	Если Запись = Неопределено Тогда
		Запись = Хранилище.СоздатьЭлемент();
		Запись.Ключ = Канон(Ключ);
	КонецЕсли;

	Возврат Запись;

КонецФункции

// Удаляет строку ключа; отсутствие строки — не ошибка, сброс идемпотентен.
//
// Параметры:
//  Ключ - Строка - регистр и окружающие пробелы не значимы.
//
Процедура Удалить(Знач Ключ) Экспорт

	Запись = НайтиЗапись(Ключ);
	Если Запись <> Неопределено Тогда
		Запись.Удалить();
	КонецЕсли;

КонецПроцедуры

// Вся таблица в порядке ключа.
//
// Возвращаемое значение:
//  Массив - строки таблицы.
//
Функция Все() Экспорт
	Возврат Хранилище.ПолучитьУпорядочитьПоКлючВозр();
КонецФункции

#Область СлужебныеПроцедурыИФункции

// Единственное правило канона: одно и то же и на чтении, и на записи — иначе записанное
// под «  Logo  » не находится по «logo», а вторая запись заводит ещё одну строку.
Функция Канон(Знач Ключ)
	Возврат Строки.Канон(Ключ);
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач _Хранилище)
	Хранилище = _Хранилище;
	Строки = Новый КанонСтроки();
КонецПроцедуры
