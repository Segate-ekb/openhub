// Хранилище брендовых активов — репозиторий сущности «БрендовыйАктив», таблицы картинок
// по ключу. Уникальность ключа держит перезапись найденной строки.

// BSLLS:UnusedParameters-off

Перем Сам;   // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё

// Строки с заданным ключом; ключ нормализует вызывающий.
//
// Параметры:
//  Ключ - Строка - каноничная форма (НРег без окружающих пробелов).
//  Лимит - Число - максимум строк.
//
// Возвращаемое значение:
//  Массив из БрендовыйАктив.
//
&МетодЗапроса
Функция ПолучитьПоКлючРавноПервые(Ключ, Лимит) Экспорт
	Возврат Неопределено;
КонецФункции

// Вся таблица активов в порядке ключа.
//
// Возвращаемое значение:
//  Массив из БрендовыйАктив.
//
&МетодЗапроса
Функция ПолучитьУпорядочитьПоКлючВозр() Экспорт
	Возврат Неопределено;
КонецФункции

// Актив по ключу либо Неопределено, если ничего не загружали.
//
// Параметры:
//  Ключ - Строка - назначение картинки; регистр и окружающие пробелы не значимы.
//
// Возвращаемое значение:
//  БрендовыйАктив, Неопределено.
//
Функция Актив(Знач Ключ) Экспорт
	Возврат Таблица().НайтиЗапись(Ключ);
КонецФункции

// Записывает картинку: вставка либо перезапись строки того же ключа.
//
// Параметры:
//  Ключ - Строка - назначение картинки; регистр и окружающие пробелы не значимы.
//  Содержимое - ДвоичныеДанные - байты файла.
//  ТипКонтента - Строка - Content-Type отдачи.
//  Отпечаток - Строка - SHA-256 содержимого (hex, НРег).
//  Кто - Строка - логин загрузившего.
//  Когда - Дата - момент (UTC).
//
&Наблюдаемый
Процедура Установить(Знач Ключ, Знач Содержимое, Знач ТипКонтента, Знач Отпечаток,
	Знач Кто, Знач Когда) Экспорт

	Запись = Таблица().НайтиИлиЗавести(Ключ);

	Запись.Содержимое = Содержимое;
	Запись.ТипКонтента = ТипКонтента;
	Запись.Отпечаток = Отпечаток;
	Запись.Размер = Содержимое.Размер();
	Запись.Загружен = Когда;
	Запись.КемЗагружен = Кто;
	Запись.Сохранить();

КонецПроцедуры

// Удаляет актив; отсутствие записи — не ошибка, возврат к фирменному идемпотентен.
//
// Параметры:
//  Ключ - Строка - назначение картинки; регистр и окружающие пробелы не значимы.
//
&Наблюдаемый
Процедура Удалить(Знач Ключ) Экспорт
	Таблица().Удалить(Ключ);
КонецПроцедуры

// Все загруженные активы.
//
// Возвращаемое значение:
//  Массив из БрендовыйАктив.
//
Функция Все() Экспорт
	Возврат Таблица().Все();
КонецФункции

// Таблица «ключ → строка» над этим же хранилищем.
Функция Таблица()
	Возврат Новый ТаблицаПоКлючу(Сам.Достать());
КонецФункции

&ХранилищеСущностей("БрендовыйАктив")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеБрендовыхАктивов") _Сам)

	Сам = _Сам;

КонецПроцедуры
