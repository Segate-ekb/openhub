// Хранилище брендовых активов — доменный фасад над таблицей картинок по ключу.
// Уникальность ключа держит перезапись найденной строки.

Перем Таблица;

// Актив по ключу либо Неопределено, если ничего не загружали.
//
// Параметры:
//  Ключ - Строка - назначение картинки; регистр и окружающие пробелы не значимы.
//
// Возвращаемое значение:
//  БрендовыйАктив, Неопределено.
//
Функция Актив(Знач Ключ) Экспорт
	Возврат Таблица.НайтиЗапись(Ключ);
КонецФункции

// Записывает картинку: вставка либо перезапись строки того же ключа.
//
// Параметры:
//  Ключ - Строка - назначение картинки; регистр и окружающие пробелы не значимы.
//  Содержимое - ДвоичныеДанные - байты файла.
//  ТипКонтента - Строка - Content-Type отдачи.
//  Отпечаток - Строка - SHA-256 содержимого (hex, НРег).
//  Кто - Строка - логин загрузившего.
//  Когда - Дата - момент (UTC).
//
Процедура Установить(Знач Ключ, Знач Содержимое, Знач ТипКонтента, Знач Отпечаток,
	Знач Кто, Знач Когда) Экспорт

	Запись = Таблица.НайтиИлиЗавести(Ключ);

	Запись.Содержимое = Содержимое;
	Запись.ТипКонтента = ТипКонтента;
	Запись.Отпечаток = Отпечаток;
	Запись.Размер = Содержимое.Размер();
	Запись.Загружен = Когда;
	Запись.КемЗагружен = Кто;
	Запись.Сохранить();

КонецПроцедуры

// Удаляет актив; отсутствие записи — не ошибка, возврат к фирменному идемпотентен.
//
// Параметры:
//  Ключ - Строка - назначение картинки; регистр и окружающие пробелы не значимы.
//
Процедура Удалить(Знач Ключ) Экспорт
	Таблица.Удалить(Ключ);
КонецПроцедуры

// Все загруженные активы.
//
// Возвращаемое значение:
//  Массив из БрендовыйАктив.
//
Функция Все() Экспорт
	Возврат Таблица.Все();
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин ЗапросыБрендовыхАктивов) Экспорт
	Таблица = Новый ТаблицаПоКлючу(ЗапросыБрендовыхАктивов);
КонецПроцедуры
