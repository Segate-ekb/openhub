// Хранилище брендовых активов — доменный фасад над ЗапросыБрендовыхАктивов.
// Уникальность ключа держит перезапись найденной строки: вторая строка того же
// назначения не рождается ни при какой последовательности загрузок.

Перем Запросы;

// Актив по ключу либо Неопределено, если ничего не загружали.
//
// Параметры:
//  Ключ - Строка - назначение картинки (НРег).
//
// Возвращаемое значение:
//  БрендовыйАктив, Неопределено.
//
Функция Актив(Знач Ключ) Экспорт
	Возврат НайтиЗапись(Ключ);
КонецФункции

// Записывает картинку: вставка либо перезапись строки того же ключа.
//
// Параметры:
//  Ключ - Строка - назначение картинки (НРег).
//  Содержимое - ДвоичныеДанные - байты файла.
//  ТипКонтента - Строка - Content-Type отдачи.
//  Отпечаток - Строка - SHA-256 содержимого (hex, НРег).
//  Кто - Строка - логин загрузившего.
//  Когда - Дата - момент (UTC).
//
Процедура Установить(Знач Ключ, Знач Содержимое, Знач ТипКонтента, Знач Отпечаток,
	Знач Кто, Знач Когда) Экспорт

	Запись = НайтиЗапись(Ключ);
	Если Запись = Неопределено Тогда
		Запись = Запросы.СоздатьЭлемент();
		Запись.Ключ = Норм(Ключ);
	КонецЕсли;

	Запись.Содержимое = Содержимое;
	Запись.ТипКонтента = ТипКонтента;
	Запись.Отпечаток = Отпечаток;
	Запись.Размер = Содержимое.Размер();
	Запись.Загружен = Когда;
	Запись.КемЗагружен = Кто;
	Запись.Сохранить();

КонецПроцедуры

// Удаляет актив; отсутствие записи — не ошибка, возврат к фирменному идемпотентен.
//
// Параметры:
//  Ключ - Строка - назначение картинки (НРег).
//
Процедура Удалить(Знач Ключ) Экспорт

	Запись = НайтиЗапись(Ключ);
	Если Запись <> Неопределено Тогда
		Запросы.Удалить(Запись);
	КонецЕсли;

КонецПроцедуры

// Все загруженные активы.
//
// Возвращаемое значение:
//  Массив из БрендовыйАктив.
//
Функция Все() Экспорт
	Возврат Запросы.ПолучитьУпорядочитьПоКлючВозр();
КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция НайтиЗапись(Знач Ключ)

	Найденные = Запросы.ПолучитьПоКлючРавноПервые(Норм(Ключ), 1);
	Возврат ?(Найденные.Количество() = 0, Неопределено, Найденные[0]);

КонецФункции

Функция Норм(Знач Ключ)
	Возврат НРег(СокрЛП(Строка(Ключ)));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин ЗапросыБрендовыхАктивов) Экспорт
	Запросы = ЗапросыБрендовыхАктивов;
КонецПроцедуры
