// Счёт, сумма и признак наличия по таблице: один запрос к базе там, где бэкенд исполняет
// SQL, и та же цифра выборкой в памяти там, где не исполняет. Вызывающий обе дороги
// не различает — он спрашивает число и получает число.
//
// Два ограничения снаружи не видны, поэтому названы здесь. Вердикт пробы один на желудь,
// то есть на процесс, а не на источник данных: источник у хаба один, и второй потребовал бы
// пробы на каждый. «LIMIT 1» в признаке наличия — диалект SQLite и PostgreSQL; других
// SQL-коннекторов у entity нет.

#Использовать entity
#Использовать errors

Перем Менеджер;         // МенеджерСущностей (entity) — на нём делается проба SQL
Перем Текст;            // ТекстАгрегата — текст запроса по описанию сущности
Перем Ошибки;           // ТекстОшибки (основа)
Перем ВердиктПробы;     // Булево, Неопределено — исполняет ли бэкенд SQL; Неопределено — не пробовали
Перем НазванныеОтказы;  // Соответствие: «таблица/агрегат/вид отказа» → Истина
Перем ОписанияСущностей;  // Соответствие: имя таблицы → ОписаниеСущности
Перем Замок;            // БлокировкаРесурса — желудь-одиночка живёт под потоками winow
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Исполняет ли база SQL, то есть считает ли агрегаты она сама. Проба делается один раз,
// дальше её вердикт только вспоминается.
//
// Возвращаемое значение:
//  Булево.
//
Функция БазаСчитает() Экспорт

	Если ВердиктПробы <> Неопределено Тогда
		Возврат ВердиктПробы;
	КонецЕсли;

	Возврат ВердиктПробыПодЗамком();

КонецФункции

// Сколько строк таблицы отвечает отбору.
//
// Параметры:
//  Запросы - Произвольный - репозиторий &ХранилищеСущностей нужной таблицы.
//  Опции - ОпцииПоиска, Неопределено - отбор; Неопределено — вся таблица.
//
// Возвращаемое значение:
//  Число.
//
&Наблюдаемый
Функция Количество(Знач Запросы, Знач Опции = Неопределено) Экспорт

	Сущность = СущностьЕслиЕстьЧтоСчитать(Запросы, Опции);
	Если Сущность = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Если БазаСчитает() Тогда
		Попытка
			Возврат ЧислоЗапросом(Запросы, Текст.Количество(Сущность, Опции));
		Исключение
			НазватьОтказ(Сущность, "количество", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Возврат Запросы.Получить(Опции).Количество();

КонецФункции

// Отвечает ли отбору хоть одна строка таблицы.
//
// Параметры:
//  Запросы - Произвольный - репозиторий &ХранилищеСущностей нужной таблицы.
//  Опции - ОпцииПоиска, Неопределено - отбор; Неопределено — вся таблица.
//
// Возвращаемое значение:
//  Булево.
//
&Наблюдаемый
Функция Есть(Знач Запросы, Знач Опции = Неопределено) Экспорт

	Сущность = СущностьЕслиЕстьЧтоСчитать(Запросы, Опции);
	Если Сущность = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если БазаСчитает() Тогда
		Попытка
			Возврат НаличиеЗапросом(Запросы, Текст.Наличие(Сущность, Опции));
		Исключение
			НазватьОтказ(Сущность, "наличие", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Возврат Запросы.Получить(ОднаСтрока(Опции)).Количество() > 0;

КонецФункции

// Сумма поля по строкам, отвечающим отбору. Строк нет — ноль.
//
// Параметры:
//  Запросы - Произвольный - репозиторий &ХранилищеСущностей нужной таблицы.
//  ИмяПоля - Строка - суммируемое поле сущности.
//  Опции - ОпцииПоиска, Неопределено - отбор; Неопределено — вся таблица.
//
// Возвращаемое значение:
//  Число.
//
&Наблюдаемый
Функция Сумма(Знач Запросы, Знач ИмяПоля, Знач Опции = Неопределено) Экспорт

	Сущность = СущностьЕслиЕстьЧтоСчитать(Запросы, Опции, ИмяПоля);
	Если Сущность = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Если БазаСчитает() Тогда
		Попытка
			Возврат ЧислоЗапросом(Запросы, Текст.Сумма(Сущность, ИмяПоля, Опции));
		Исключение
			НазватьОтказ(Сущность, "сумма", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Возврат СуммаВПамяти(Запросы, Сущность, ИмяПоля, Опции);

КонецФункции

// Сколько строк отвечает отбору в разрезе ключа — одним обращением на весь разрез.
//
// Параметры:
//  Запросы - Произвольный - репозиторий &ХранилищеСущностей нужной таблицы.
//  ИмяПоляКлюча - Строка - поле, по которому идёт разрез.
//  Опции - ОпцииПоиска, Неопределено - отбор; Неопределено — вся таблица.
//
// Возвращаемое значение:
//  Соответствие - ключ разреза → Число; ключей без строк в соответствии нет.
//
&Наблюдаемый
Функция КоличествоПоКлючу(Знач Запросы, Знач ИмяПоляКлюча, Знач Опции = Неопределено) Экспорт

	Сущность = СущностьЕслиЕстьЧтоСчитать(Запросы, Опции);
	Если Сущность = Неопределено Тогда
		Возврат Новый Соответствие();
	КонецЕсли;

	Если БазаСчитает() Тогда
		Попытка
			Возврат Разрез(Сущность, ИмяПоляКлюча,
				ОтветБазы(Запросы, Текст.КоличествоПоКлючу(Сущность, ИмяПоляКлюча, Опции)));
		Исключение
			НазватьОтказ(Сущность, "количество по ключу", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Возврат СчётПоКлючуВПамяти(Запросы, Сущность, ИмяПоляКлюча, Опции);

КонецФункции

// Сумма поля в разрезе ключа — одним обращением на весь разрез.
//
// Параметры:
//  Запросы - Произвольный - репозиторий &ХранилищеСущностей нужной таблицы.
//  ИмяПоляКлюча - Строка - поле, по которому идёт разрез.
//  ИмяПоляСуммы - Строка - суммируемое поле сущности.
//  Опции - ОпцииПоиска, Неопределено - отбор; Неопределено — вся таблица.
//
// Возвращаемое значение:
//  Соответствие - ключ разреза → Число; ключей без строк в соответствии нет.
//
&Наблюдаемый
Функция СуммаПоКлючу(Знач Запросы, Знач ИмяПоляКлюча, Знач ИмяПоляСуммы, Знач Опции = Неопределено) Экспорт

	Сущность = СущностьЕслиЕстьЧтоСчитать(Запросы, Опции, ИмяПоляСуммы);
	Если Сущность = Неопределено Тогда
		Возврат Новый Соответствие();
	КонецЕсли;

	Если БазаСчитает() Тогда
		Попытка
			Возврат Разрез(Сущность, ИмяПоляКлюча,
				ОтветБазы(Запросы, Текст.СуммаПоКлючу(Сущность, ИмяПоляКлюча, ИмяПоляСуммы, Опции)));
		Исключение
			НазватьОтказ(Сущность, "сумма по ключу", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Возврат СуммаПоКлючуВПамяти(Запросы, Сущность, ИмяПоляКлюча, ИмяПоляСуммы, Опции);

КонецФункции

#КонецОбласти

#Область ОбщийПрологАгрегата

// Пролог, одинаковый у всех пяти агрегатов: неверный вызов отвергается — и отвергается
// раньше, чем отбор успеет ответить «считать нечего», — а в остальных случаях читается
// описание сущности, по которому собирается и текст запроса, и разрез.
//
// Параметры:
//  Запросы - Произвольный - репозиторий &ХранилищеСущностей.
//  Опции - ОпцииПоиска, Неопределено - отбор.
//  ИмяПоляСуммы - Строка - суммируемое поле; пусто — агрегат не суммирует.
//
// Возвращаемое значение:
//  ОписаниеСущности - сущность, по которой считается агрегат;
//  Неопределено - отбору не отвечает ни одна строка, и базу спрашивать не о чем.
//
Функция СущностьЕслиЕстьЧтоСчитать(Знач Запросы, Знач Опции, Знач ИмяПоляСуммы = "")

	ПроверитьЧтоОтборНеПостраничный(Опции);

	Сущность = ОписаниеСущности(Запросы.ПолучитьОбъектМодели());
	Если ЗначениеЗаполнено(ИмяПоляСуммы) Тогда
		ПроверитьЧтоПолеСуммируемо(Сущность, ИмяПоляСуммы);
	КонецЕсли;

	Возврат ?(Текст.ОтборНикогоНеВыберет(Опции), Неопределено, Сущность);

КонецФункции

// Модель сущности на процесс неизменна, и её описание строится один раз на таблицу:
// на горячем пути это копия таблицы колонок и по фиксированной структуре на поле — на
// каждый вопрос о счётчике.
Функция ОписаниеСущности(Знач Модель)

	Готовое = ОписанияСущностей.Получить(Модель.ИмяТаблицы());

	Возврат ?(Готовое = Неопределено, ЗапомнитьОписание(Модель), Готовое);

КонецФункции

// Агрегат по странице дал бы две разные цифры, смотря какой дорогой его посчитали:
// SQL сосчитал бы всю выборку, а выборка в памяти — только страницу. Поэтому постраничные
// опции отвергаются сразу, а не считаются одной из дорог.
Процедура ПроверитьЧтоОтборНеПостраничный(Знач Опции)

	Если Опции = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Опции.ВыбираютсяПервые() <> Неопределено ИЛИ Опции.ВыбираетсяСоСмещением() <> Неопределено Тогда
		ВызватьИсключение СтандартныеОшибки.НедопустимоеЗначениеАргумента("Опции",
			"отбор без Первые и Смещение: агрегат по странице не считается");
	КонецЕсли;

КонецПроцедуры

// Суммировать текст и дату не умеет ни SQL («function sum(text) does not exist»), ни сложение
// в памяти. Обе дороги обязаны отказывать одинаково и сразу, а не одна тихо, другая громко.
Процедура ПроверитьЧтоПолеСуммируемо(Знач Сущность, Знач ИмяПоля)

	ТипПоля = Сущность.ТипПоля(ИмяПоля);
	Если ТипПоля <> ТипыКолонок.Целое И ТипПоля <> ТипыКолонок.Дробное Тогда
		ВызватьИсключение СтандартныеОшибки.ОперацияНеПоддерживается("агрегат",
			СтрШаблон("поле %1 таблицы %2 имеет тип %3 и не суммируется",
				ИмяПоля, Сущность.ИмяТаблицы(), ТипПоля));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПутьБазы

// Бэкенд без SQL — не сбой: на файловой базе хаб работает штатно. Поэтому вердикт пробы
// уходит в журнал уровнем «информация», и повторять его не на чем — проба одна.
Функция ПробаУдалась()

	Попытка
		Менеджер.ВычислитьСКоннектором(АлгоритмЗапроса(),
			Новый Структура("Текст", СтрШаблон("SELECT 1 AS %1", Текст.КолонкаЧисла())));
	Исключение
		Лог.Информация("Агрегаты считаются в памяти: коннектор %1 не исполняет SQL (%2)",
			Менеджер.ИсточникДанных().ТипКоннектора(), Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

Функция ОтветБазы(Знач Запросы, Знач ТекстЗапроса)

	Возврат Запросы.ВычислитьСКоннектором(АлгоритмЗапроса(),
		Новый Структура("Текст", ТекстЗапроса));

КонецФункции

Функция АлгоритмЗапроса()
	Возврат "Коннектор -> Коннектор.ВыполнитьЗапрос(Текст)";
КонецФункции

// Единственное число агрегатного запроса. Пустой результат и NULL — это ноль: SUM
// по отбору, которому не отвечает ни одна строка, в SQL даёт NULL, а не ноль.
Функция ЧислоЗапросом(Знач Запросы, Знач ТекстЗапроса)

	Таблица = ОтветБазы(Запросы, ТекстЗапроса);
	Если Таблица.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Значение = Таблица[0][Текст.КолонкаЧисла()];

	Возврат ?(ЗначениеЗаполнено(Значение), Число(Значение), 0);

КонецФункции

Функция НаличиеЗапросом(Знач Запросы, Знач ТекстЗапроса)
	Возврат ОтветБазы(Запросы, ТекстЗапроса).Количество() > 0;
КонецФункции

// Разрез из ответа базы. Ключ приводится к типу поля сущности: соответствие, собранное
// в памяти, адресуется целым, и пул, приехавший из базы другим типом числа, оказался бы
// в разрезе вторым ключом.
Функция Разрез(Знач Сущность, Знач ИмяПоляКлюча, Знач Таблица)

	Итог = Новый Соответствие();
	ЦелыйКлюч = Сущность.ТипПоля(ИмяПоляКлюча) = ТипыКолонок.Целое;

	Для Каждого СтрокаОтвета Из Таблица Цикл
		Ключ = СтрокаОтвета[Текст.КолонкаКлюча()];
		Значение = СтрокаОтвета[Текст.КолонкаЧисла()];
		Итог.Вставить(?(ЦелыйКлюч, Цел(Ключ), Ключ), ?(ЗначениеЗаполнено(Значение), Число(Значение), 0));
	КонецЦикла;

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область ЖурналОтказов

// Отказ отказу рознь: запрос, который хаб не собрал, база не видела вовсе, и обвинять её
// в нём — значит слать администратора чинить исправную СУБД. Поэтому два пути называются
// разными словами и считаются разными ключами.
Процедура НазватьОтказ(Знач Сущность, Знач ВидАгрегата, Знач Инфо)

	НашаСборка = ДиагностикаОшибок.Содержит(Инфо,
		КодыСтандартныхОшибок.ОперацияНеПоддерживается());

	Шаблон = ?(НашаСборка,
		"Агрегат ""%1"" по таблице %2 не собран, считаю в памяти: %3",
		"Агрегат ""%1"" по таблице %2 база не посчитала, считаю в памяти: %3");

	// сообщение собирается ЗДЕСЬ и уходит в журнал одним аргументом: шаблон-переменная
	// в самом вызове журнала непроверяем на арность, а текст причины, пришедший от базы,
	// может нести «%1» и сам напросился бы на вторую подстановку
	Сообщение = СтрШаблон(Шаблон, ВидАгрегата, Сущность.ИмяТаблицы(), Ошибки.Причина(Инфо));

	Ключ = СтрШаблон("%1/%2/%3", Сущность.ИмяТаблицы(), ВидАгрегата,
		?(НашаСборка, "сборка", "база"));

	Если ОтказНазванВпервые(Ключ) Тогда
		Лог.Предупреждение(Сообщение);
	Иначе
		Лог.Отладка(Сообщение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПутьПамяти

// SUM в SQL пустые значения пропускает — пропускает их и подсчёт в памяти, иначе одна
// незаполненная колонка роняла бы сумму там, где база отдала бы число.
Функция СуммаВПамяти(Знач Запросы, Знач Сущность, Знач ИмяПоля, Знач Опции)

	Итог = 0;
	Для Каждого Запись Из Запросы.Получить(Опции) Цикл
		Слагаемое = Сущность.Значение(Запись, ИмяПоля);
		Если Слагаемое <> Неопределено Тогда
			Итог = Итог + Слагаемое;
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

Функция СчётПоКлючуВПамяти(Знач Запросы, Знач Сущность, Знач ИмяПоляКлюча, Знач Опции)

	Итог = Новый Соответствие();
	Для Каждого Запись Из Запросы.Получить(Опции) Цикл
		Ключ = Сущность.Значение(Запись, ИмяПоляКлюча);
		Итог.Вставить(Ключ, Накоплено(Итог, Ключ) + 1);
	КонецЦикла;

	Возврат Итог;

КонецФункции

Функция СуммаПоКлючуВПамяти(Знач Запросы, Знач Сущность, Знач ИмяПоляКлюча, Знач ИмяПоляСуммы, Знач Опции)

	Итог = Новый Соответствие();
	Для Каждого Запись Из Запросы.Получить(Опции) Цикл
		Ключ = Сущность.Значение(Запись, ИмяПоляКлюча);
		Слагаемое = Сущность.Значение(Запись, ИмяПоляСуммы);
		Итог.Вставить(Ключ, Накоплено(Итог, Ключ) + ?(Слагаемое = Неопределено, 0, Слагаемое));
	КонецЦикла;

	Возврат Итог;

КонецФункции

Функция Накоплено(Знач Итог, Знач Ключ)
	Было = Итог.Получить(Ключ);
	Возврат ?(Было = Неопределено, 0, Было);
КонецФункции

// Опции «хватит одной строки»: копия, потому что Первые правит переданный объект,
// а он принадлежит вызывающему.
Функция ОднаСтрока(Знач Опции)

	Копия = Новый ОпцииПоиска();
	Если Опции <> Неопределено Тогда
		Для Каждого Элемент Из Опции.Отборы() Цикл
			Копия.Отбор(Элемент.ПутьКДанным, Элемент.ВидСравнения, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат Копия.Первые(1);

КонецФункции

#КонецОбласти

#Область ОбщееСостояниеЖелудя

// Желудь-одиночка живёт под потоками winow: без замка проба ушла бы в базу дважды и двумя
// строками журнала.
Функция ВердиктПробыПодЗамком()

	Замок.Заблокировать();
	Попытка
		Если ВердиктПробы = Неопределено Тогда
			ВердиктПробы = ПробаУдалась();
		КонецЕсли;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Возврат ВердиктПробы;

КонецФункции

// Описание сущности кладётся под тем же замком, что и остальное общее состояние желудя:
// под потоками winow два запроса строят его одновременно, и второй затирал бы первое.
Функция ЗапомнитьОписание(Знач Модель)

	Замок.Заблокировать();
	Попытка
		Готовое = ОписанияСущностей.Получить(Модель.ИмяТаблицы());
		Если Готовое = Неопределено Тогда
			Готовое = Новый ОписаниеСущности(Модель);
			ОписанияСущностей.Вставить(Модель.ИмяТаблицы(), Готовое);
		КонецЕсли;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Возврат Готовое;

КонецФункции

// Предупреждение — одно на тройку «таблица, агрегат, вид отказа»: счётчик спрашивают
// на каждой отрисовке страницы, и повтор той же строки завалил бы журнал, ничего к ней
// не добавив. Под замком, потому что исключение параллельной вставки вылетело бы прямо
// из блока Исключение агрегата и ушло бы человеку пятисоткой.
Функция ОтказНазванВпервые(Знач Ключ)

	Замок.Заблокировать();
	Попытка
		Впервые = НазванныеОтказы.Получить(Ключ) = Неопределено;
		НазванныеОтказы.Вставить(Ключ, Истина);
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Возврат Впервые;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "МенеджерСущностей") _Менеджер,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Менеджер = _Менеджер;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Текст = Новый ТекстАгрегата();
	НазванныеОтказы = Новый Соответствие();
	ОписанияСущностей = Новый Соответствие();
	ВердиктПробы = Неопределено;
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
