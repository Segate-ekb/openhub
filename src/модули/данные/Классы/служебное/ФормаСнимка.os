// Форма снимка строки для кэша в памяти: все колонки модели сущности, кроме названных,
// в фиксированной структуре — общий бюджет кэша принимает только неизменяемое.

Перем Поля;   // Строка — имена полей снимка через запятую

// Снимок строки сущности.
//
// Параметры:
//  Запись - Произвольный, Неопределено - строка сущности.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - снимок; нет строки — нет и снимка.
//
Функция Снимок(Знач Запись) Экспорт

	Если Запись = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значения = Новый Структура(Поля);
	ЗаполнитьЗначенияСвойств(Значения, Запись);
	Возврат Новый ФиксированнаяСтруктура(Значения);

КонецФункции

// Снимки строк сущности в том же порядке.
//
// Параметры:
//  Записи - Массив - строки сущности.
//
// Возвращаемое значение:
//  ФиксированныйМассив из ФиксированнаяСтруктура - снимки строк.
//
Функция Снимки(Знач Записи) Экспорт

	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Результат.Добавить(Снимок(Запись));
	КонецЦикла;

	Возврат Новый ФиксированныйМассив(Результат);

КонецФункции

Процедура ПриСозданииОбъекта(Знач ОбъектМодели, Знач Исключая = "")

	Исключения = СтрРазделить(Исключая, ", ", Ложь);
	Имена = Новый Массив();
	Для Каждого Колонка Из ОбъектМодели.Колонки() Цикл
		Если Исключения.Найти(Колонка.ИмяПоля) = Неопределено Тогда
			Имена.Добавить(Колонка.ИмяПоля);
		КонецЕсли;
	КонецЦикла;

	Поля = СтрСоединить(Имена, ",");

КонецПроцедуры
