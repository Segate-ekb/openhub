// Хранилище групп — фасад сущности "Группа" над деривованными запросами.
// Имя канонизирует сервис (нижний регистр); поиск ждёт уже канонический вид.

Перем Запросы;

// Группа по идентификатору.
//
// Параметры:
//  Идентификатор - Число.
//
// Возвращаемое значение:
//  Группа, Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Запросы.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Группа по имени (ожидается каноническим).
//
// Параметры:
//  Имя - Строка.
//
// Возвращаемое значение:
//  Группа, Неопределено.
//
Функция НайтиПоИмени(Знач Имя) Экспорт
	Возврат Запросы.ПолучитьОдноПоИмяРавно(Имя);
КонецФункции

// Все группы.
//
// Возвращаемое значение:
//  Массив из Группа.
//
Функция Все() Экспорт
	Возврат Запросы.ПолучитьПо();
КонецФункции

// Новая несохранённая группа.
//
// Возвращаемое значение:
//  Группа.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

// Удаляет группу.
//
// Параметры:
//  Группа - Группа.
//
Процедура Удалить(Знач Группа) Экспорт
	Запросы.Удалить(Группа);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗапросыГрупп") _Запросы)

	Запросы = _Запросы;

КонецПроцедуры
