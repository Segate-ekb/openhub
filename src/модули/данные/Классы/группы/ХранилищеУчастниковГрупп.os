// Хранилище участников групп — фасад сущности "УчастникГруппы" над деривованными запросами.
// Поле Источник отделяет local от oidc, чтобы синхронизация не трогала локальные записи.

#Использовать entity

Перем Запросы;
Перем Агрегаты;   // АгрегатыБазы (данные) — разрез по группам спрашивается у базы

// Участники группы.
//
// Параметры:
//  ГруппаИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из УчастникГруппы.
//
Функция ПолучитьПоГруппаИдентификаторРавно(Знач ГруппаИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоГруппаИдентификаторРавно(ГруппаИдентификатор);
КонецФункции

// Членства пользователя во всех группах.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из УчастникГруппы.
//
Функция ПолучитьПоПользовательИдентификаторРавно(Знач ПользовательИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПользовательИдентификаторРавно(ПользовательИдентификатор);
КонецФункции

// Запись членства пользователя в конкретной группе (или Неопределено).
//
// Параметры:
//  ГруппаИдентификатор - Число.
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  УчастникГруппы, Неопределено.
//
Функция НайтиЧленство(Знач ГруппаИдентификатор, Знач ПользовательИдентификатор) Экспорт

	Возврат Запросы.ПолучитьОдноПоГруппаИдентификаторРавноИПользовательИдентификаторРавно(
		ГруппаИдентификатор, ПользовательИдентификатор);

КонецФункции

// Сколько участников в каждой из названных групп — одним разрезом вместо вопроса
// про каждую группу.
//
// Параметры:
//  ГруппаИдентификаторы - Массив из Число - идентификаторы групп.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (идентификатор группы), значение Число; пустых групп в нём нет.
//
Функция СчётПоГруппам(Знач ГруппаИдентификаторы) Экспорт

	Целые = Новый Массив();
	Для Каждого Идентификатор Из ГруппаИдентификаторы Цикл
		Целые.Добавить(Цел(Идентификатор));
	КонецЦикла;

	Возврат Агрегаты.КоличествоПоКлючу(Запросы, "ГруппаИдентификатор",
		Новый ОпцииПоиска().Отбор("ГруппаИдентификатор", ВидСравнения.В, Целые));

КонецФункции

// Новая несохранённая запись членства.
//
// Возвращаемое значение:
//  УчастникГруппы.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

// Удаляет запись членства.
//
// Параметры:
//  Участник - УчастникГруппы.
//
Процедура Удалить(Знач Участник) Экспорт
	Запросы.Удалить(Участник);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗапросыУчастниковГрупп") _Запросы,
	&Пластилин(Значение = "АгрегатыБазы") _Агрегаты)

	Запросы = _Запросы;
	Агрегаты = _Агрегаты;

КонецПроцедуры
