// Хранилище сопоставлений групп OIDC — доменный фасад над ЗапросыСопоставленийГруппOIDC.
// Правило маппинга: {issuer, имя_клейма, значение} → группа хаба.

Перем Запросы;

// Сопоставление по идентификатору.
//
// Параметры:
//  Идентификатор - Число.
//
// Возвращаемое значение:
//  СопоставлениеГруппыOIDC, Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Запросы.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Все сопоставления одного провайдера (issuer) — для синхронизации членства на входе.
//
// Параметры:
//  Издатель - Строка - issuer провайдера.
//
// Возвращаемое значение:
//  Массив из СопоставлениеГруппыOIDC.
//
Функция ПолучитьПоИздательРавно(Знач Издатель) Экспорт
	Возврат Запросы.ПолучитьПоИздательРавно(Издатель);
КонецФункции

// Сопоставления, ведущие в конкретную группу (для админ-UI и очистки при удалении группы).
//
// Параметры:
//  ГруппаИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из СопоставлениеГруппыOIDC.
//
Функция ПолучитьПоГруппаИдентификаторРавно(Знач ГруппаИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоГруппаИдентификаторРавно(ГруппаИдентификатор);
КонецФункции

// Все сопоставления хаба (админ-обзор).
//
// Возвращаемое значение:
//  Массив из СопоставлениеГруппыOIDC.
//
Функция Все() Экспорт
	Возврат Запросы.ПолучитьПо();
КонецФункции

// Существующее сопоставление по полному ключу (идемпотентное создание / поиск для удаления).
//
// Параметры:
//  ГруппаИдентификатор - Число.
//  Издатель - Строка.
//  ИмяКлейма - Строка.
//  Значение - Строка.
//
// Возвращаемое значение:
//  СопоставлениеГруппыOIDC, Неопределено.
//
Функция НайтиСопоставление(Знач ГруппаИдентификатор, Знач Издатель, Знач ИмяКлейма, Знач Значение) Экспорт

	Возврат Запросы.ПолучитьОдноПоГруппаИдентификаторРавноИздательРавноИмяКлеймаРавноЗначениеРавно(
		Цел(ГруппаИдентификатор), Строка(Издатель), Строка(ИмяКлейма), Строка(Значение));

КонецФункции

// Новая несохранённая строка сопоставления.
//
// Возвращаемое значение:
//  СопоставлениеГруппыOIDC.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

// Удаляет сопоставление.
//
// Параметры:
//  Сопоставление - СопоставлениеГруппыOIDC.
//
Процедура Удалить(Знач Сопоставление) Экспорт
	Запросы.Удалить(Сопоставление);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин ЗапросыСопоставленийГруппOIDC) Экспорт
	Запросы = ЗапросыСопоставленийГруппOIDC;
КонецПроцедуры
