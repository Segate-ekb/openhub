// Хранилище связок групп OIDC — доменный фасад над ЗапросыСвязокГруппOIDC; одна строка на группу.

Перем Запросы;

// Связка по идентификатору.
//
// Параметры:
//  Идентификатор - Число.
//
// Возвращаемое значение:
//  СвязкаГруппыOIDC, Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Запросы.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Связка конкретной группы.
//
// Параметры:
//  ГруппаИдентификатор - Число.
//
// Возвращаемое значение:
//  СвязкаГруппыOIDC, Неопределено.
//
Функция НайтиПоГруппе(Знач ГруппаИдентификатор) Экспорт
	Возврат Запросы.ПолучитьОдноПоГруппаИдентификаторРавно(Цел(ГруппаИдентификатор));
КонецФункции

// Все связки хаба (админ-обзор).
//
// Возвращаемое значение:
//  Массив из СвязкаГруппыOIDC.
//
Функция Все() Экспорт
	Возврат Запросы.ПолучитьПо();
КонецФункции

// Новая несохранённая строка связки.
//
// Возвращаемое значение:
//  СвязкаГруппыOIDC.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

// Удаляет связку.
//
// Параметры:
//  Связка - СвязкаГруппыOIDC.
//
Процедура Удалить(Знач Связка) Экспорт
	Запросы.Удалить(Связка);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин ЗапросыСвязокГруппOIDC) Экспорт
	Запросы = ЗапросыСвязокГруппOIDC;
КонецПроцедуры
