// Хранилище вебхуков — доменный фасад над ЗапросыВебхуков (подписки объектов).
// CRUD и инварианты — СервисПодписок, доставку читает ПодписчикВебхуков.

Перем Запросы;

// Вебхук по идентификатору (для операций управления/переключения/удаления).
//
// Параметры:
//  Идентификатор - Число.
//
// Возвращаемое значение:
//  Вебхук, Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Запросы.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Все подписки хаба без отбора — для админских сводок; прикладной код читает по объекту.
//
// Возвращаемое значение:
//  Массив из Вебхук.
//
Функция Все() Экспорт
	Возврат Запросы.ПолучитьПо();
КонецФункции

// Все подписки объекта (список в доме объекта, подсчёт лимита, выбор для доставки).
//
// Параметры:
//  ТипОбъекта - Строка - "хаб" | "пул" | "пакет".
//  ОбъектИдентификатор - Число - id объекта (0 для «хаб»).
//
// Возвращаемое значение:
//  Массив из Вебхук.
//
Функция ПолучитьПоОбъекту(Знач ТипОбъекта, Знач ОбъектИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоТипОбъектаРавноИОбъектИдентификаторРавно(
		Строка(ТипОбъекта), Цел(ОбъектИдентификатор));
КонецФункции

// Новый несохранённый вебхук.
//
// Возвращаемое значение:
//  Вебхук.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

// Удаляет вебхук.
//
// Параметры:
//  Вебхук - Вебхук.
//
Процедура Удалить(Знач Вебхук) Экспорт
	Запросы.Удалить(Вебхук);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ЗапросыВебхуков") _Запросы)
	Запросы = _Запросы;
КонецПроцедуры
