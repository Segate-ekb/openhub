// Хранилище заданий доставки — доменный фасад над ЗапросамиЗаданийДоставки.
// Порядок и созревание считает очередь (подписки/ОчередьДоставокПодписок).

Перем Запросы;

// Все незавершённые задания очереди.
//
// Возвращаемое значение:
//  Массив из ЗаданиеДоставки.
//
Функция Все() Экспорт
	Возврат Запросы.ПолучитьПо();
КонецФункции

// Новое несохранённое задание.
//
// Возвращаемое значение:
//  ЗаданиеДоставки.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

// Удаляет задание из очереди.
//
// Параметры:
//  Задание - ЗаданиеДоставки.
//
Процедура Удалить(Знач Задание) Экспорт
	Запросы.Удалить(Задание);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ЗапросыЗаданийДоставки") _Запросы)
	Запросы = _Запросы;
КонецПроцедуры
