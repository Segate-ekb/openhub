// Снятие пачки строк со счётом снятого: строку снимает она сама либо хранилище, которое её отдало.

// Снимает строки, каждая из которых удаляет себя сама, и считает снятые.
//
// Параметры:
//  Строки - Массив - снимаемые строки.
//
// Возвращаемое значение:
//  Число - сколько строк снято.
//
&Наблюдаемый
Функция Снять(Знач Строки) Экспорт

	Снято = 0;
	Для Каждого Запись Из Строки Цикл
		Запись.Удалить();
		Снято = Снято + 1;
	КонецЦикла;

	Возврат Снято;

КонецФункции

// Снимает строки хранилищем, которое их отдало, и считает снятые.
//
// Параметры:
//  Хранилище - Произвольный - хранилище, которым снимать строку.
//  Строки - Массив - снимаемые строки.
//
// Возвращаемое значение:
//  Число - сколько строк снято.
//
&Наблюдаемый
Функция СнятьЧерез(Знач Хранилище, Знач Строки) Экспорт

	Снято = 0;
	Для Каждого Запись Из Строки Цикл
		Хранилище.Удалить(Запись);
		Снято = Снято + 1;
	КонецЦикла;

	Возврат Снято;

КонецФункции

&Прозвище("СнятиеСтрок")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
