// Сущность "Пул" — пул пакетов. Тип отвечает «чьё это пространство имён»: user — личное
// пространство, custom — произвольный; основной пул хаба помечен признаком ПоУмолчанию.

&Идентификатор
&ГенерируемоеЗначение
&Колонка(Тип = "Целое")
Перем Идентификатор Экспорт;

&Колонка
Перем Имя Экспорт;

// user | custom
&Колонка
Перем Тип Экспорт;

// основной пул хаба; носитель признака ровно один, исключительность держит СервисПулов
&Колонка(Тип = "Булево")
Перем ПоУмолчанию Экспорт;

// public | private
&Колонка
Перем Видимость Экспорт;

&Колонка(Тип = "Целое")
Перем ВладелецИдентификатор Экспорт;

// принимает ли пул публикации; колонка, а не флаг в блобе — там read-modify-write с гонкой
&Колонка(Тип = "Булево")
Перем ПубликацияРазрешена Экспорт;

// произвольные настройки пула (JSON-строка)
&Колонка
Перем НастройкиJSON Экспорт;

// -1 — как в хабе (квота по умолчанию), 0 — без ограничения, больше нуля — своя квота
&Колонка(Тип = "Целое")
Перем КвотаМб Экспорт;

// объём собственных действующих версий пула, байты; накопительный счётчик УчётаОбъёмаПула
&Колонка(Тип = "Целое")
Перем ЗанятоБайт Экспорт;

&Колонка(Тип = "ДатаВремя")
Перем Создан Экспорт;

// Булев флаг пула из НастройкиJSON; пустой/некорректный JSON → значение по умолчанию.
//
// Параметры:
//  ИмяФлага - Строка.
//  ЗначениеПоУмолчанию - Булево (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Булево.
//
Функция Флаг(Знач ИмяФлага, Знач ЗначениеПоУмолчанию = Ложь) Экспорт

	Настройки = РазобратьНастройки();
	Если Настройки = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Значение = Настройки.Получить(ИмяФлага);
	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат КЛогическому(Значение, ЗначениеПоУмолчанию);

КонецФункции

// Тип «личное пространство пользователя».
//
// Возвращаемое значение:
//  Строка - каноническое значение колонки Тип.
//
Функция ТипПользователя() Экспорт
	Возврат "user";
КонецФункции

// Тип «произвольный пул команды или проекта».
//
// Возвращаемое значение:
//  Строка - каноническое значение колонки Тип.
//
Функция ТипПроизвольный() Экспорт
	Возврат "custom";
КонецФункции

// Единственный список типов пула — сервисный слой сверяется с ним.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ДопустимыеТипы() Экспорт

	Типы = Новый Массив();
	Типы.Добавить(ТипПользователя());
	Типы.Добавить(ТипПроизвольный());
	Возврат Типы;

КонецФункции

// Основной пул хаба (короткие адреса /download, /push, /dev-channel): неудаляем
// и всегда публичен.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоДефолтный() Экспорт
	Возврат ПоУмолчанию = Истина;
КонецФункции

// Личное пространство пользователя (/{логин}/{pkg}).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоЛичный() Экспорт
	Возврат НормТип() = ТипПользователя();
КонецФункции

// Структурный запрет апстримов личному пулу: он раздаётся автоматически, и право
// настраивать исходящие запросы хаба (SSRF) не должно приезжать вместе с ним.
// Предикат спрашивает и РезолверВыдачи — строка апстрима мимо сервиса не опрашивается.
//
// Возвращаемое значение:
//  Булево - Истина, если пулу этого типа апстримы вообще допустимы.
//
Функция АпстримыДопустимы() Экспорт
	Возврат НЕ ЭтоЛичный();
КонецФункции

Функция НормТип()
	Возврат НРег(СокрЛП(Строка(Тип)));
КонецФункции

// Устанавливает булев флаг в НастройкиJSON; сущность сохраняет вызывающий.
// Гонка: read-modify-write всего блоба — конкурентная установка разных флагов теряется.
//
// Параметры:
//  ИмяФлага - Строка.
//  Значение - Булево.
//
Процедура УстановитьФлаг(Знач ИмяФлага, Знач Значение) Экспорт
	УстановитьНастройку(ИмяФлага, Значение);
КонецПроцедуры

// Записывает произвольное значение настройки; сущность сохраняет вызывающий.
//
// Параметры:
//  Имя - Строка.
//  Значение - Произвольный - сериализуемое в JSON значение.
//
Процедура УстановитьНастройку(Знач Имя, Знач Значение) Экспорт

	Настройки = РазобратьНастройки();
	Если Настройки = Неопределено Тогда
		Настройки = Новый Соответствие();
	КонецЕсли;
	Настройки.Вставить(Имя, Значение);

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Настройки);
	НастройкиJSON = Запись.Закрыть();

КонецПроцедуры

// Значение настройки строкой либо "" — ключа нет.
//
// Параметры:
//  Имя - Строка.
//
// Возвращаемое значение:
//  Строка.
//
Функция Настройка(Знач Имя) Экспорт

	Настройки = РазобратьНастройки();
	Если Настройки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение = Настройки.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));

КонецФункции

Функция РазобратьНастройки()
	Если НЕ ЗначениеЗаполнено(НастройкиJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(НастройкиJSON);
		Разобрано = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Разобрано;
КонецФункции

// Слова флага читает один владелец на весь хаб; незнакомое слово оставляет умолчание
// настройки пула. Сущность желудей не принимает, поэтому чтение создаётся здесь.
Функция КЛогическому(Знач Значение, Знач ПоУмолчанию)
	Прочитанное = Новый ПриведениеФлагов().ФлагТрёхзначный(Значение);
	Возврат ?(Прочитанное = Неопределено, ПоУмолчанию, Прочитанное);
КонецФункции

&Сущность(ИмяТаблицы = "Пулы")
Процедура ПриСозданииОбъекта()
КонецПроцедуры
