// Хранилище апстримов пула — репозиторий сущности «АпстримПула»: выборки идут деривацией,
// признак наличия и разрез — агрегатом базы, снимки для чтения — из кэша «источникиПула».

// BSLLS:UnusedParameters-off

#Использовать entity

Перем Сам;        // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё
Перем Агрегаты;   // АгрегатыБазы (данные) — признак наличия и разрез спрашиваются у базы
Перем ФормаСнимка; // ФормаСнимка (данные) — снимок строки источника для кэша; строится при первом снимке

// Апстримы пула (без гарантии порядка — используйте АпстримыУпорядоченно).
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из АпстримПула.
//
&МетодЗапроса
Функция ПолучитьПоПулИдентификаторРавно(ПулИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Апстримы пула, упорядоченные по колонке Порядок по возрастанию.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из АпстримПула - в порядке обхода.
//
&МетодЗапроса
Функция ПолучитьПоПулИдентификаторРавноУпорядочитьПоПорядокВозр(ПулИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Апстримы пула, упорядоченные по колонке Порядок (по возрастанию) — порядок опроса.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из АпстримПула - в порядке обхода.
//
Функция АпстримыУпорядоченно(Знач ПулИдентификатор) Экспорт
	Возврат Сам.Достать().ПолучитьПоПулИдентификаторРавноУпорядочитьПоПорядокВозр(ПулИдентификатор);
КонецФункции

// Снимки строк источников пула в порядке обхода из кэша «источникиПула»: поля записей,
// только для чтения. Пул без источников — пустой массив, и он тоже ответ.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  ФиксированныйМассив из ФиксированнаяСтруктура - снимки строк источников.
//
&Кэшируемый("источникиПула")
Функция СнимкиПула(Знач ПулИдентификатор) Экспорт
	Возврат Форма().Снимки(АпстримыУпорядоченно(ПулИдентификатор));
КонецФункции

// Забывает снимки строк источников пула: зовёт каждый, кто их записал или удалил.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
&СбрасываетКэш("источникиПула")
Процедура ЗабытьСнимкиПула(Знач ПулИдентификатор) Экспорт
КонецПроцедуры

// Есть ли у пула хоть один источник.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьУПула(Знач ПулИдентификатор) Экспорт

	Возврат Агрегаты.Есть(Сам.Достать(), Новый ОпцииПоиска()
		.Отбор("ПулИдентификатор", ВидСравнения.Равно, Цел(ПулИдентификатор)));

КонецФункции

// Идентификаторы пулов, у которых есть хоть один источник, — одним разрезом вместо
// вопроса про каждый пул хаба.
//
// Возвращаемое значение:
//  Массив из Число - идентификаторы пулов; пулов без источников в нём нет,
//                    порядок не гарантируется.
//
Функция ПулыСИсточниками() Экспорт

	Результат = Новый Массив();
	Для Каждого КлючИЗначение Из Агрегаты.КоличествоПоКлючу(Сам.Достать(), "ПулИдентификатор") Цикл
		Результат.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Модель сущности есть только у собранного репозитория, поэтому форма снимка строится при первом снимке.
Функция Форма()
	Если ФормаСнимка = Неопределено Тогда
		ФормаСнимка = Новый ФормаСнимка(Сам.Достать().ПолучитьОбъектМодели());
	КонецЕсли;
	Возврат ФормаСнимка;
КонецФункции

&ХранилищеСущностей("АпстримПула")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеАпстримовПула") _Сам,
	&Пластилин(Значение = "АгрегатыБазы") _Агрегаты)

	Сам = _Сам;
	Агрегаты = _Агрегаты;

КонецПроцедуры
