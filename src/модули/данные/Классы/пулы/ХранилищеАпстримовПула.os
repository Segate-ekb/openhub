// Хранилище апстримов пула — доменный фасад над ЗапросыАпстримовПула.

#Использовать entity

Перем Запросы;
Перем Агрегаты;   // АгрегатыБазы (данные) — признак наличия и разрез спрашиваются у базы

// Апстримы пула (без гарантии порядка — используйте АпстримыУпорядоченно).
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из АпстримПула.
//
Функция ПолучитьПоПулИдентификаторРавно(Знач ПулИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПулИдентификаторРавно(ПулИдентификатор);
КонецФункции

// Апстримы пула, упорядоченные по колонке Порядок (по возрастанию) — порядок опроса.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из АпстримПула - в порядке обхода.
//
Функция АпстримыУпорядоченно(Знач ПулИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПулИдентификаторРавноУпорядочитьПоПорядокВозр(ПулИдентификатор);
КонецФункции

// Есть ли у пула хоть один источник.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьУПула(Знач ПулИдентификатор) Экспорт

	Возврат Агрегаты.Есть(Запросы, Новый ОпцииПоиска()
		.Отбор("ПулИдентификатор", ВидСравнения.Равно, Цел(ПулИдентификатор)));

КонецФункции

// Идентификаторы пулов, у которых есть хоть один источник, — одним разрезом вместо
// вопроса про каждый пул хаба.
//
// Возвращаемое значение:
//  Массив из Число - идентификаторы пулов; пулов без источников в нём нет,
//                    порядок не гарантируется.
//
Функция ПулыСИсточниками() Экспорт

	Результат = Новый Массив();
	Для Каждого КлючИЗначение Из Агрегаты.КоличествоПоКлючу(Запросы, "ПулИдентификатор") Цикл
		Результат.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Новый несохранённый апстрим.
//
// Возвращаемое значение:
//  АпстримПула.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗапросыАпстримовПула") _Запросы,
	&Пластилин(Значение = "АгрегатыБазы") _Агрегаты)

	Запросы = _Запросы;
	Агрегаты = _Агрегаты;

КонецПроцедуры
