// Хранилище участников пулов — доменный фасад над ЗапросыУчастниковПула.
// СервисПрав объединяет права пользователя и его групп.

Перем Запросы;

// Все записи прав на пул.
//
// Параметры:
//  ПулИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из УчастникПула.
//
Функция ПолучитьПоПулИдентификаторРавно(Знач ПулИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПулИдентификаторРавно(ПулИдентификатор);
КонецФункции

// Роль конкретного субъекта на пуле (или Неопределено).
//
// Параметры:
//  ПулИдентификатор - Число.
//  ТипСубъекта - Строка - пользователь | группа.
//  СубъектИдентификатор - Число.
//
// Возвращаемое значение:
//  УчастникПула, Неопределено.
//
Функция НайтиРоль(Знач ПулИдентификатор, Знач ТипСубъекта, Знач СубъектИдентификатор) Экспорт
	Возврат Запросы.ПолучитьОдноПоПулИдентификаторРавноИТипСубъектаРавноИСубъектИдентификаторРавно(
		ПулИдентификатор, ТипСубъекта, СубъектИдентификатор);
КонецФункции

// Все роли одного субъекта на всех пулах: каталог «которыми я могу управлять» обязан
// спросить «где у меня есть права», а не перебирать все пулы хаба (их столько же, сколько учёток).
//
// Параметры:
//  ТипСубъекта - Строка - пользователь | группа.
//  СубъектИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из УчастникПула.
//
Функция РолиСубъекта(Знач ТипСубъекта, Знач СубъектИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоТипСубъектаРавноИСубъектИдентификаторРавно(ТипСубъекта, СубъектИдентификатор);
КонецФункции

// Роли сразу всех названных субъектов одного типа: снимок прав спрашивает о человеке
// и обо всех его группах, и вопрос на субъекта делал бы цену снимка числом групп.
//
// Параметры:
//  ТипСубъекта - Строка - пользователь | группа.
//  Идентификаторы - Массив из Число - идентификаторы субъектов.
//
// Возвращаемое значение:
//  Массив из УчастникПула - роли названных субъектов; пустой список — пустая выдача.
//
Функция РолиСубъектов(Знач ТипСубъекта, Знач Идентификаторы) Экспорт

	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Целые = Новый Массив();
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Целые.Добавить(Цел(Идентификатор));
	КонецЦикла;

	Возврат Запросы.ПолучитьПоТипСубъектаРавноИСубъектИдентификаторВ(ТипСубъекта, Целые);

КонецФункции

// Новая несохранённая запись прав.
//
// Возвращаемое значение:
//  УчастникПула.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

// Удаляет запись прав.
//
// Параметры:
//  Участник - УчастникПула.
//
Процедура Удалить(Знач Участник) Экспорт
	Запросы.Удалить(Участник);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ЗапросыУчастниковПула") _Запросы)
	Запросы = _Запросы;
КонецПроцедуры
