// Хранилище зеркал хабов — доменный фасад над ЗапросыЗеркалХабов.
// CRUD и уникальность — СервисЗеркал, перечисление для синк-джоба — СинхронизаторЗеркал.

Перем Запросы;

// Зеркало по идентификатору (операции управления/переключения/удаления).
//
// Параметры:
//  Идентификатор - Число.
//
// Возвращаемое значение:
//  ЗеркалоХаба, Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Запросы.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Все зеркала пула назначения (список в кабинете + подсчёт лимита на пул).
//
// Параметры:
//  ПулНазначенияИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из ЗеркалоХаба.
//
Функция ПолучитьПоПулНазначенияИдентификаторРавно(Знач ПулНазначенияИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПулНазначенияИдентификаторРавно(ПулНазначенияИдентификатор);
КонецФункции

// Все зеркала хаба; включённые синк-джоб фильтрует в приложении — работает на любом бэкенде.
//
// Возвращаемое значение:
//  Массив из ЗеркалоХаба.
//
Функция Все() Экспорт
	Возврат Запросы.ПолучитьПо();
КонецФункции

// Зеркало пула назначения с заданным апстрим-URL — база проверки уникальности в сервисе.
//
// Параметры:
//  ПулНазначенияИдентификатор - Число.
//  АпстримURL - Строка.
//
// Возвращаемое значение:
//  ЗеркалоХаба, Неопределено.
//
Функция НайтиПоПулИАпстриму(Знач ПулНазначенияИдентификатор, Знач АпстримURL) Экспорт
	Возврат Запросы.ПолучитьОдноПоПулНазначенияИдентификаторРавноИАпстримURLРавно(
		Цел(ПулНазначенияИдентификатор), Строка(АпстримURL));
КонецФункции

// Новое несохранённое зеркало.
//
// Возвращаемое значение:
//  ЗеркалоХаба.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

// Удаляет зеркало.
//
// Параметры:
//  Зеркало - ЗеркалоХаба.
//
Процедура Удалить(Знач Зеркало) Экспорт
	Запросы.Удалить(Зеркало);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ЗапросыЗеркалХабов") _Запросы)
	Запросы = _Запросы;
КонецПроцедуры
