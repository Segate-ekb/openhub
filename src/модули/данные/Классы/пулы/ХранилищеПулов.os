// Хранилище пулов — доменный фасад над ЗапросыПулов; сам к entity не обращается.

Перем Запросы;

// Пул по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Пул, Неопределено - найденный пул.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Запросы.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Пулы перечисленных идентификаторов одним запросом. Пустой список — пустая выдача.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пулов.
//
// Возвращаемое значение:
//  Массив из Пул - найденные пулы; ненайденных в выдаче нет.
//
Функция ПолучитьПоИдентификаторВ(Знач Идентификаторы) Экспорт

	Целые = Новый Массив();
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Целые.Добавить(Цел(Идентификатор));
	КонецЦикла;

	Возврат Запросы.ПолучитьПоИдентификаторВ(Целые);

КонецФункции

// Пул по имени (имена пулов уникальны на хабе).
//
// Параметры:
//  Имя - Строка - имя пула.
//
// Возвращаемое значение:
//  Пул, Неопределено - найденный пул.
//
Функция ПолучитьОдноПоИмяРавно(Знач Имя) Экспорт
	Возврат Запросы.ПолучитьОдноПоИмяРавно(Имя);
КонецФункции

// Пулы заданного типа.
//
// Параметры:
//  Тип - Строка - local | proxy | group.
//
// Возвращаемое значение:
//  Массив из Пул - пулы указанного типа.
//
Функция ПолучитьПоТипРавно(Знач Тип) Экспорт
	Возврат Запросы.ПолучитьПоТипРавно(Тип);
КонецФункции

// Все пулы хаба (для статистики web-ui). Порядок не гарантируется.
//
// Возвращаемое значение:
//  Массив из Пул.
//
Функция Все() Экспорт
	Возврат Запросы.ПолучитьПо();
КонецФункции

// Новый несохранённый пул.
//
// Возвращаемое значение:
//  Пул.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ЗапросыПулов") _Запросы)
	Запросы = _Запросы;
КонецПроцедуры
