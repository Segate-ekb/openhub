// Хранилище пакетов — фасад доступа к сущности "Пакет" поверх деривованных ЗапросыПакетов.
// Канонический ключ поиска по имени — колонка ИмяНижнийРегистр, уникальная в разрезе пула.

Перем Запросы;

// Пакет по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Пакет, Неопределено - найденный пакет.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Запросы.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Пакеты перечисленных идентификаторов — один запрос на весь список там, где вопрос
// задаётся про горстку адресов сразу, а не про один пакет.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Массив из Пакет - найденные пакеты.
//
Функция ПакетыПоИдентификаторам(Знач Идентификаторы) Экспорт

	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат Запросы.ПолучитьПоИдентификаторВ(Идентификаторы);

КонецФункции

// Все пакеты пула.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из Пакет - пакеты пула.
//
Функция ПолучитьПоПулИдентификаторРавно(Знач ПулИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПулИдентификаторРавно(ПулИдентификатор);
КонецФункции

// Пакеты перечисленных пулов — один запрос на весь список там, где выдача ограничена
// частью пулов хаба, а не всей таблицей.
//
// Параметры:
//  ПулИдентификаторы - Массив из Число - идентификаторы пулов.
//
// Возвращаемое значение:
//  Массив из Пакет - пакеты названных пулов.
//
Функция ПакетыПулов(Знач ПулИдентификаторы) Экспорт

	Если ПулИдентификаторы.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Целые = Новый Массив();
	Для Каждого ПулИдентификатор Из ПулИдентификаторы Цикл
		Целые.Добавить(Цел(ПулИдентификатор));
	КонецЦикла;
	Возврат Запросы.ПолучитьПоПулИдентификаторВ(Целые);

КонецФункции

// Пакет пула по каноническому (нижнерегистровому) имени.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  ИмяНижнийРегистр - Строка - имя пакета в нижнем регистре.
//
// Возвращаемое значение:
//  Пакет, Неопределено - найденный пакет.
//
Функция ПолучитьОдноПоПулИдентификаторРавноИИмяНижнийРегистрРавно(
	Знач ПулИдентификатор, Знач ИмяНижнийРегистр) Экспорт

	Возврат Запросы.ПолучитьОдноПоПулИдентификаторРавноИИмяНижнийРегистрРавно(
		ПулИдентификатор, ИмяНижнийРегистр);

КонецФункции

// Пакет пула по имени в любом регистре (канонизация внутри).
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Имя - Строка - имя пакета в любом регистре.
//
// Возвращаемое значение:
//  Пакет, Неопределено - найденный пакет.
//
Функция НайтиПоИмени(Знач ПулИдентификатор, Знач Имя) Экспорт

	Возврат Запросы.ПолучитьОдноПоПулИдентификаторРавноИИмяНижнийРегистрРавно(
		ПулИдентификатор, НРег(Имя));

КонецФункции

// Одноимённые пакеты всех пулов — там, где пул ещё не назван: legacy-адрес /package/{имя}
// ищет имя по всему хабу, и перебор всей таблицы ради одной строки ему не нужен.
//
// Параметры:
//  Имя - Строка - имя пакета в любом регистре.
//
// Возвращаемое значение:
//  Массив из Пакет - пакеты этого имени во всех пулах.
//
Функция ОдноимённыеВоВсехПулах(Знач Имя) Экспорт

	Канон = НРег(СокрЛП(Строка(Имя)));
	Если ПустаяСтрока(Канон) Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Результат = Запросы.ПолучитьПоИмяНижнийРегистрРавно(Канон);
	Возврат ?(Результат = Неопределено, Новый Массив(), Результат);

КонецФункции

// Все пакеты хаба; порядок не гарантируется — сортировку и пагинацию делает вызывающий.
//
// Возвращаемое значение:
//  Массив из Пакет - все пакеты хаба.
//
Функция Все() Экспорт
	Возврат Запросы.ПолучитьПо();
КонецФункции

// Новая (несохранённая) строка пакета.
//
// Возвращаемое значение:
//  Пакет - элемент, привязанный к хранилищу сущностей.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ЗапросыПакетов") _Запросы)
	Запросы = _Запросы;
КонецПроцедуры
