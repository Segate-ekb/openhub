// Каналы пакета для чтения из кэша «каналыПакета»: строки тегов пакета и помеченные вручную
// версии каждого тега одним снимком — резолв без версии и страницы пакета спрашивают их
// на каждый запрос.

Перем ХранилищеТегов;  // ХранилищеТегов (данные)
Перем ХранилищеМеток;  // ХранилищеМетокТегов (данные)
Перем ФормаСнимка;      // ФормаСнимка (данные) — снимок строки тега

// Снимок каналов пакета, только для чтения.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Теги (ФиксированныйМассив из ФиксированнаяСтруктура — строки
//                           тегов пакета), Метки (ФиксированноеСоответствие: идентификатор
//                           тега (Число) → ФиксированноеСоответствие: идентификатор
//                           помеченной версии (Число) → Истина).
//
&Кэшируемый("каналыПакета")
Функция СнимокПакета(Знач ПакетИдентификатор) Экспорт

	Теги = ХранилищеТегов.ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор);
	Теги = ?(Теги = Неопределено, Новый Массив(), Теги);

	Возврат Новый ФиксированнаяСтруктура("Теги, Метки",
		ФормаСнимка.Снимки(Теги), МеткиТегов(Теги));

КонецФункции

// Забывает снимок каналов пакета: зовёт каждый, кто записал или удалил тег пакета либо
// метку его тега.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
&СбрасываетКэш("каналыПакета")
Процедура ЗабытьСнимокПакета(Знач ПакетИдентификатор) Экспорт
КонецПроцедуры

// Метки всех тегов пакета одной выборкой; у тега-правила их нет, и в ответе он пуст.
Функция МеткиТегов(Знач Теги)

	Номера = Новый Массив();
	Для Каждого Тег Из Теги Цикл
		Номера.Добавить(Цел(Тег.Идентификатор));
	КонецЦикла;

	ПоТегам = Новый Соответствие();
	Для Каждого Метка Из ХранилищеМеток.СоставТегов(Номера) Цикл
		Помеченные = ПоТегам.Получить(Цел(Метка.ТегИдентификатор));
		Если Помеченные = Неопределено Тогда
			Помеченные = Новый Соответствие();
			ПоТегам.Вставить(Цел(Метка.ТегИдентификатор), Помеченные);
		КонецЕсли;
		Помеченные.Вставить(Цел(Метка.ВерсияИдентификатор), Истина);
	КонецЦикла;

	Результат = Новый Соответствие();
	Для Каждого Элемент Из ПоТегам Цикл
		Результат.Вставить(Элемент.Ключ, Новый ФиксированноеСоответствие(Элемент.Значение));
	КонецЦикла;

	Возврат Новый ФиксированноеСоответствие(Результат);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеТегов") _ХранилищеТегов,
	&Пластилин(Значение = "ХранилищеМетокТегов") _ХранилищеМеток)

	ХранилищеТегов = _ХранилищеТегов;
	ХранилищеМеток = _ХранилищеМеток;
	ФормаСнимка = Новый ФормаСнимка(ХранилищеТегов.ПолучитьОбъектМодели());

КонецПроцедуры
