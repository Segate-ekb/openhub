// Хранилище тегов: репозиторий сущности «Тег». Тела методов запроса строит autumn-data
// по их именам.

// BSLLS:UnusedParameters-off

#Использовать entity

&Родитель
Перем ХранилищеСущностей;
Перем Агрегаты;   // АгрегатыБазы (данные) — признак наличия спрашивается у базы

// Все теги пакета.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив из Тег - теги пакета.
//
&МетодЗапроса
Функция ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Тег пакета по имени.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега (например "latest", "lts").
//
// Возвращаемое значение:
//  Тег, Неопределено - найденный тег.
//
&МетодЗапроса
Функция ПолучитьОдноПоПакетИдентификаторРавноИИмяРавно(ПакетИдентификатор, Имя) Экспорт
	Возврат Неопределено;
КонецФункции

// Есть ли у пакета хоть один тег — там, где сам список не нужен.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьТегиПакета(Знач ПакетИдентификатор) Экспорт

	// напрямую у репозитория entity: агрегату нужен он, а не декоратор снаружи
	Возврат Агрегаты.Есть(ХранилищеСущностей, Новый ОпцииПоиска()
		.Отбор("ПакетИдентификатор", ВидСравнения.Равно, Цел(ПакетИдентификатор)));

КонецФункции

&ХранилищеСущностей("Тег")
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "АгрегатыБазы") _Агрегаты)
	Агрегаты = _Агрегаты;
КонецПроцедуры
