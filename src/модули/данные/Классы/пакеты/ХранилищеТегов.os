// Хранилище тегов — доменный фасад над ЗапросыТегов.

Перем Запросы;

// Все теги пакета.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив из Тег - теги пакета.
//
Функция ПолучитьПоПакетИдентификаторРавно(Знач ПакетИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор);
КонецФункции

// Тег пакета по имени.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега (например "latest", "lts").
//
// Возвращаемое значение:
//  Тег, Неопределено - найденный тег.
//
Функция ПолучитьОдноПоПакетИдентификаторРавноИИмяРавно(Знач ПакетИдентификатор, Знач Имя) Экспорт
	Возврат Запросы.ПолучитьОдноПоПакетИдентификаторРавноИИмяРавно(ПакетИдентификатор, Имя);
КонецФункции

// Новая несохранённая строка тега.
//
// Возвращаемое значение:
//  Тег.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ЗапросыТегов") _Запросы)
	Запросы = _Запросы;
КонецПроцедуры
