// Хранилище версий пакета — фасад доступа к сущности "ВерсияПакета" поверх деривованных
// ЗапросыВерсийПакета; только выборки. Резолв версии по semver-выражению/каналу — задача РезолвераВерсий.

#Использовать entity

Перем Запросы;
Перем Агрегаты;   // АгрегатыБазы (данные) — счёт и признак наличия спрашиваются у базы
Перем ФормаСнимка; // ФормаСнимка (данные) — снимок строки версии для кэша

// Все версии пакета.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив из ВерсияПакета - версии пакета.
//
Функция ПолучитьПоПакетИдентификаторРавно(Знач ПакетИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор);
КонецФункции

// Версии сразу нескольких пакетов одним отбором — там, где вопрос задаётся про целый
// список пакетов («у кого из них есть хоть одна версия») и запрос на каждый пакет
// превратил бы страницу в N+1.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Массив из ВерсияПакета - версии всех перечисленных пакетов.
//
Функция ВерсииПакетов(Знач ПакетИдентификаторы) Экспорт
	Если ПакетИдентификаторы.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат Запросы.ПолучитьПоПакетИдентификаторВ(ПакетИдентификаторы);
КонецФункции

// Версии перечисленных пакетов, изменившиеся не раньше названного момента. Отбор делает
// база: срез изменений зеркала спрашивается по кругу, а меняется между обходами горстка
// строк, и вычитывать ради неё все версии пула незачем.
//
// Граница ВКЛЮЧИТЕЛЬНА, и это не деталь: зеркало подаёт обратно момент снятия прошлого
// среза, а он округлён вниз до секунды. Версия, изменившаяся внутри той же секунды,
// приезжает следующим обходом только по «не раньше»; «позже» теряло бы её молча.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//  Момент - Дата - нижняя граница включительно; незаполненная означает «все версии».
//
// Возвращаемое значение:
//  Массив из ВерсияПакета - изменившиеся версии.
//
Функция ТронутыеПосле(Знач ПакетИдентификаторы, Знач Момент) Экспорт

	Если ПакетИдентификаторы.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Момент) Тогда
		Возврат Запросы.ПолучитьПоПакетИдентификаторВ(ПакетИдентификаторы);
	КонецЕсли;

	Возврат Запросы.ПолучитьПоПакетИдентификаторВИИзмененаБольшеИлиРавно(
		ПакетИдентификаторы, Момент);

КонецФункции

// Версия по идентификатору — там, где версия адресуется ссылкой, а не парой (пакет, строка).
//
// Параметры:
//  Идентификатор - Число - идентификатор версии.
//
// Возвращаемое значение:
//  ВерсияПакета, Неопределено - найденная версия.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Запросы.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Версии перечисленных идентификаторов одним отбором — там, где версии адресует целый
// список ссылок: строки «кто зависит» указывают на версию каждая своей.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы версий.
//
// Возвращаемое значение:
//  Массив из ВерсияПакета - найденные версии; отсутствующих в выдаче нет.
//
Функция ВерсииПоИдентификаторам(Знач Идентификаторы) Экспорт

	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат Запросы.ПолучитьПоИдентификаторВ(Идентификаторы);

КонецФункции

// Конкретная версия пакета по строке версии.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Версия - Строка - полная строка версии.
//
// Возвращаемое значение:
//  ВерсияПакета, Неопределено - найденная версия.
//
Функция ПолучитьОдноПоПакетИдентификаторРавноИВерсияРавно(Знач ПакетИдентификатор, Знач Версия) Экспорт
	Возврат Запросы.ПолучитьОдноПоПакетИдентификаторРавноИВерсияРавно(ПакетИдентификатор, Версия);
КонецФункции

// Версии пакета с учётом признака отзыва (yanked).
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Отозвана - Булево - Ложь: только действующие версии.
//
// Возвращаемое значение:
//  Массив из ВерсияПакета - версии пакета.
//
Функция ПолучитьПоПакетИдентификаторРавноИОтозванаРавно(Знач ПакетИдентификатор, Знач Отозвана) Экспорт
	Возврат Запросы.ПолучитьПоПакетИдентификаторРавноИОтозванаРавно(ПакетИдентификатор, Отозвана);
КонецФункции

// Версии, опубликованные конкретным пользователем — иначе вопрос «опубликовал ли он
// хоть что-нибудь» стоил бы обхода всех пулов × пакетов × версий на каждый показ страницы.
//
// Параметры:
//  ОпубликовалИдентификатор - Число - идентификатор пользователя-публикатора.
//
// Возвращаемое значение:
//  Массив из ВерсияПакета - версии этого публикатора.
//
Функция ПолучитьПоОпубликовалИдентификаторРавно(Знач ОпубликовалИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоОпубликовалИдентификаторРавно(ОпубликовалИдентификатор);
КонецФункции

// Действующие (неотозванные) версии пакета.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив из ВерсияПакета - версии без yanked.
//
Функция ДействующиеВерсии(Знач ПакетИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПакетИдентификаторРавноИОтозванаРавно(ПакетИдентификатор, Ложь);
КонецФункции

// Последние опубликованные версии хаба, новые первыми. Порядок и предел задаёт база:
// витрине «что вышло недавно» нельзя вычитывать всю таблицу версий на каждый показ.
//
// Параметры:
//  Лимит - Число - сколько версий вернуть.
//
// Возвращаемое значение:
//  Массив из ВерсияПакета - версии в порядке убывания даты публикации.
//
Функция ПоследниеОпубликованные(Знач Лимит) Экспорт

	Предел = Цел(?(ЗначениеЗаполнено(Лимит), Лимит, 0));
	Если Предел <= 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат Запросы.ПолучитьПервыеУпорядочитьПоОпубликованаУбывИдентификаторУбыв(Предел);

КонецФункции

// Снимки последних опубликованных версий из кэша «новинки»: поля версий, только для чтения.
//
// Параметры:
//  Лимит - Число - сколько версий вернуть.
//
// Возвращаемое значение:
//  ФиксированныйМассив из ФиксированнаяСтруктура - снимки в порядке убывания даты публикации.
//
&Кэшируемый("новинки")
Функция СнимкиПоследних(Знач Лимит) Экспорт
	Возврат ФормаСнимка.Снимки(ПоследниеОпубликованные(Лимит));
КонецФункции

// Снимки всех версий пакета из кэша «версииПакета»: поля версий, только для чтения.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  ФиксированныйМассив из ФиксированнаяСтруктура - снимки версий пакета.
//
&Кэшируемый("версииПакета")
Функция СнимкиПакета(Знач ПакетИдентификатор) Экспорт
	Возврат ФормаСнимка.Снимки(ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор));
КонецФункции

// Забывает снимки версий пакета и новинки хаба: зовёт каждый, кто записал или удалил
// версию. Новинки забываются целиком — версия пакета может войти в любое окно новинок.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
&СбрасываетКэш("версииПакета")
&СбрасываетКэш(Значение = "новинки", ВсеЗаписи = Истина)
Процедура ЗабытьСнимкиПакета(Знач ПакетИдентификатор) Экспорт
КонецПроцедуры

// Сколько версий лежит в реестре — всего, по всем пакетам всех пулов.
//
// Возвращаемое значение:
//  Число.
//
Функция Количество() Экспорт
	Возврат Агрегаты.Количество(Запросы);
КонецФункции

// Сколько версий у названных пакетов суммарно. Пустой список пакетов — ноль.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоВПакетах(Знач ПакетИдентификаторы) Экспорт

	Целые = Новый Массив();
	Для Каждого Идентификатор Из ПакетИдентификаторы Цикл
		Целые.Добавить(Цел(Идентификатор));
	КонецЦикла;

	Возврат Агрегаты.Количество(Запросы, Новый ОпцииПоиска()
		.Отбор("ПакетИдентификатор", ВидСравнения.В, Целые));

КонецФункции

// Есть ли у пакета хоть одна версия — вопрос уборки и отката одобрения, которым список
// версий не нужен.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьВерсии(Знач ПакетИдентификатор) Экспорт

	Возврат Агрегаты.Есть(Запросы, Новый ОпцииПоиска()
		.Отбор("ПакетИдентификатор", ВидСравнения.Равно, Цел(ПакетИдентификатор)));

КонецФункции

// Публиковал ли человек хоть одну версию этого пакета — вопрос права на пакет, и задают
// его на каждую проверку.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  ОпубликовалИдентификатор - Число - идентификатор публикатора.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьВерсияПубликатора(Знач ПакетИдентификатор, Знач ОпубликовалИдентификатор) Экспорт

	Возврат Агрегаты.Есть(Запросы, Новый ОпцииПоиска()
		.Отбор("ПакетИдентификатор", ВидСравнения.Равно, Цел(ПакетИдентификатор))
		.Отбор("ОпубликовалИдентификатор", ВидСравнения.Равно, Цел(ОпубликовалИдентификатор)));

КонецФункции

// Публиковал ли человек хоть одну версию где бы то ни было в хабе — вопрос подсказки
// первой публикации, которой всё равно, в каком пакете эта версия лежит.
//
// Параметры:
//  ОпубликовалИдентификатор - Число - идентификатор публикатора.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьВерсииПубликатораВХабе(Знач ОпубликовалИдентификатор) Экспорт

	Возврат Агрегаты.Есть(Запросы, Новый ОпцииПоиска()
		.Отбор("ОпубликовалИдентификатор", ВидСравнения.Равно, Цел(ОпубликовалИдентификатор)));

КонецФункции

// Новая (несохранённая) строка версии.
//
// Возвращаемое значение:
//  ВерсияПакета - элемент, привязанный к хранилищу сущностей.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗапросыВерсийПакета") _Запросы,
	&Пластилин(Значение = "АгрегатыБазы") _Агрегаты)

	Запросы = _Запросы;
	Агрегаты = _Агрегаты;
	ФормаСнимка = Новый ФормаСнимка(Запросы.ПолучитьОбъектМодели());

КонецПроцедуры
