// Хранилище агрегатов скачиваний — репозиторий сущности «СкачиваниеАгрегат»: суточные строки
// и суммы по ним. Пишет пачками СлужбаСтатистикиСкачиваний; гранулярность — (пакет, версия, день).

// BSLLS:UnusedParameters-off

#Использовать entity

Перем Сам;             // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё
Перем Агрегаты;        // АгрегатыБазы (данные) — суммы спрашиваются у базы
Перем НомерПоколения;  // Число - меняется на каждой записи в таблицу

// Агрегат за конкретные пакет, версию и сутки.
//
// Параметры:
//  ПакетИдентификатор - Число.
//  ВерсияИдентификатор - Число.
//  ДатаДень - Дата.
//
// Возвращаемое значение:
//  СкачиваниеАгрегат, Неопределено.
//
&МетодЗапроса
Функция ПолучитьОдноПоПакетИдентификаторРавноИВерсияИдентификаторРавноИДатаДеньРавно(
	ПакетИдентификатор, ВерсияИдентификатор, ДатаДень) Экспорт
	Возврат Неопределено;
КонецФункции

// Все суточные агрегаты пакета (по всем его версиям).
//
// Параметры:
//  ПакетИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из СкачиваниеАгрегат.
//
&МетодЗапроса
Функция ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Все суточные агрегаты версии.
//
// Параметры:
//  ВерсияИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из СкачиваниеАгрегат.
//
&МетодЗапроса
Функция ПолучитьПоВерсияИдентификаторРавно(ВерсияИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Суточные агрегаты сразу нескольких пакетов.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число.
//
// Возвращаемое значение:
//  Массив из СкачиваниеАгрегат.
//
&МетодЗапроса
Функция ПолучитьПоПакетИдентификаторВ(ПакетИдентификаторы) Экспорт
	Возврат Неопределено;
КонецФункции

// Все агрегаты хаба.
//
// Возвращаемое значение:
//  Массив из СкачиваниеАгрегат.
//
&МетодЗапроса
Функция ПолучитьПо() Экспорт
	Возврат Неопределено;
КонецФункции

// Поколение таблицы агрегатов: номер, который меняется на каждой записи ЧЕРЕЗ ЭТО
// хранилище. Витрина, сложившая суммы у себя, сверяет его и пересчитывает разрез, когда
// в таблицу написали мимо неё. Записи соседнего процесса и правку базы руками номер
// не видит — он про этот экземпляр, а не про таблицу.
//
// Возвращаемое значение:
//  Число - номер поколения.
//
Функция Поколение() Экспорт
	Возврат НомерПоколения;
КонецФункции

// Накопительно добавляет скачивания в суточный агрегат (upsert по пакет+версия+день).
// Чтение строки и её запись — два обращения к базе, а не атомарный инкремент: два
// параллельных вызова по одной строке теряют приращение, сериализует их вызывающий.
// Поколение меняется, когда запись уже видна: витрина, спросившая посреди записи,
// сложит старую сумму под старым поколением и пересчитает её следующим вопросом.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  ВерсияИдентификатор - Число - идентификатор версии.
//  ДатаДень - Дата - начало суток агрегации (UTC).
//  Количество - Число - сколько скачиваний добавить.
//
&Наблюдаемый
Процедура Накопить(Знач ПакетИдентификатор, Знач ВерсияИдентификатор, Знач ДатаДень, Знач Количество) Экспорт

	Строка = НайтиЗаДень(ПакетИдентификатор, ВерсияИдентификатор, ДатаДень);
	Если Строка = Неопределено Тогда
		Строка = Сам.Достать().СоздатьЭлемент();
		Строка.ПакетИдентификатор = ПакетИдентификатор;
		Строка.ВерсияИдентификатор = ВерсияИдентификатор;
		Строка.ДатаДень = ДатаДень;
		Строка.Количество = Количество;
	Иначе
		Строка.Количество = Строка.Количество + Количество;
	КонецЕсли;
	Строка.Сохранить();

	НомерПоколения = НомерПоколения + 1;

КонецПроцедуры

// Строка агрегата за конкретные (пакет, версия, день) либо Неопределено.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  ВерсияИдентификатор - Число - идентификатор версии.
//  ДатаДень - Дата - сутки агрегата.
//
// Возвращаемое значение:
//  СкачиваниеАгрегат, Неопределено - строка агрегата.
//
Функция НайтиЗаДень(Знач ПакетИдентификатор, Знач ВерсияИдентификатор, Знач ДатаДень) Экспорт

	Возврат Сам.Достать().ПолучитьОдноПоПакетИдентификаторРавноИВерсияИдентификаторРавноИДатаДеньРавно(
		ПакетИдентификатор, ВерсияИдентификатор, ДатаДень);

КонецФункции

// Всего скачиваний пакета за всё время (сумма всех суточных агрегатов всех версий).
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Число - суммарное количество.
//
Функция СуммаПоПакету(Знач ПакетИдентификатор) Экспорт

	Возврат Агрегаты.Сумма(Сам.Достать(), "Количество", Новый ОпцииПоиска()
		.Отбор("ПакетИдентификатор", ВидСравнения.Равно, Цел(ПакетИдентификатор)));

КонецФункции

// Всего скачиваний версии за всё время (сумма суточных агрегатов версии).
//
// Параметры:
//  ВерсияИдентификатор - Число - идентификатор версии.
//
// Возвращаемое значение:
//  Число - суммарное количество скачиваний.
//
Функция СуммаПоВерсии(Знач ВерсияИдентификатор) Экспорт

	Возврат Агрегаты.Сумма(Сам.Достать(), "Количество", Новый ОпцииПоиска()
		.Отбор("ВерсияИдентификатор", ВидСравнения.Равно, Цел(ВерсияИдентификатор)));

КонецФункции

// Скачивания версий пакета из кэша «скачиванияВерсий»: одна сумма базы на весь пакет.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  ФиксированноеСоответствие - ключ Число (идентификатор версии), значение Число; версий
//                              без скачиваний в нём нет.
//
&Кэшируемый("скачиванияВерсий")
Функция СуммыВерсийПакета(Знач ПакетИдентификатор) Экспорт

	Пакеты = Новый Массив();
	Пакеты.Добавить(ПакетИдентификатор);
	Возврат Новый ФиксированноеСоответствие(СуммыВерсийПакетов(Пакеты));

КонецФункции

// Скачивания версий названных пакетов одним разрезом, мимо кэша. Пустой список — пустой разрез.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (идентификатор версии), значение Число.
//
Функция СуммыВерсийПакетов(Знач ПакетИдентификаторы) Экспорт

	Целые = Новый Массив();
	Для Каждого Идентификатор Из ПакетИдентификаторы Цикл
		Целые.Добавить(Цел(Идентификатор));
	КонецЦикла;
	Если Целые.Количество() = 0 Тогда
		Возврат Новый Соответствие();
	КонецЕсли;

	Возврат Агрегаты.СуммаПоКлючу(Сам.Достать(), "ВерсияИдентификатор", "Количество",
		Новый ОпцииПоиска().Отбор("ПакетИдентификатор", ВидСравнения.В, Целые));

КонецФункции

// Забывает скачивания версий пакета: зовёт каждый, кто записал или удалил его агрегаты.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
&СбрасываетКэш("скачиванияВерсий")
Процедура ЗабытьСуммыВерсийПакета(Знач ПакетИдентификатор) Экспорт
КонецПроцедуры

// Строки агрегатов пакета — для уборки вместе с пакетом; счёт даёт СуммаПоПакету.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив из СкачиваниеАгрегат - суточные агрегаты всех версий пакета.
//
Функция АгрегатыПакета(Знач ПакетИдентификатор) Экспорт
	Возврат Сам.Достать().ПолучитьПоПакетИдентификаторРавно(Цел(ПакетИдентификатор));
КонецФункции

// Суточные агрегаты перечисленных пакетов одним отбором — витрине, которой нужен счёт
// по своей горстке, а не по всему хабу.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Массив из СкачиваниеАгрегат - агрегаты всех перечисленных пакетов.
//
Функция АгрегатыПакетов(Знач ПакетИдентификаторы) Экспорт

	Если ПакетИдентификаторы.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат Сам.Достать().ПолучитьПоПакетИдентификаторВ(ПакетИдентификаторы);

КонецФункции

// Скачивания всего хаба ОДНИМ числом — тому, кому разрез по пакетам не нужен вовсе:
// сумма считается базой, а не чтением всей таблицы агрегатов.
//
// Возвращаемое значение:
//  Число.
//
Функция СуммаПоХабу() Экспорт
	Возврат Агрегаты.Сумма(Сам.Достать(), "Количество");
КонецФункции

// Скачивания всех пакетов хаба одним разрезом: витрине нужны суммы, а не суточные строки.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (идентификатор пакета), значение Число; пакетов без
//                 скачиваний в нём нет.
//
Функция СуммыПоПакетам() Экспорт
	Возврат Агрегаты.СуммаПоКлючу(Сам.Достать(), "ПакетИдентификатор", "Количество");
КонецФункции

// Скачивания названных пакетов одним разрезом. Пустой список — пустой разрез.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (идентификатор пакета), значение Число.
//
Функция СуммыПакетов(Знач ПакетИдентификаторы) Экспорт

	Целые = Новый Массив();
	Для Каждого Идентификатор Из ПакетИдентификаторы Цикл
		Целые.Добавить(Цел(Идентификатор));
	КонецЦикла;

	Возврат Агрегаты.СуммаПоКлючу(Сам.Достать(), "ПакетИдентификатор", "Количество",
		Новый ОпцииПоиска().Отбор("ПакетИдентификатор", ВидСравнения.В, Целые));

КонецФункции

// Все агрегаты (для админ-витрин/диагностики; порядок не гарантируется).
//
// Возвращаемое значение:
//  Массив из СкачиваниеАгрегат - все агрегаты.
//
Функция Все() Экспорт
	Возврат Сам.Достать().ПолучитьПо();
КонецФункции

&ХранилищеСущностей("СкачиваниеАгрегат")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеСкачиванийАгрегатов") _Сам,
	&Пластилин(Значение = "АгрегатыБазы") _Агрегаты)

	Сам = _Сам;
	Агрегаты = _Агрегаты;
	НомерПоколения = 0;

КонецПроцедуры
