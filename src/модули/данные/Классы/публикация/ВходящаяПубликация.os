// Сущность «ВходящаяПубликация» — заявка во «входящих» пула: push свободного имени
// от пользователя без прав принимается сюда (202), версия не создаётся.

&Идентификатор
&ГенерируемоеЗначение
&Колонка(Тип = "Целое")
Перем Идентификатор Экспорт;

// пул, во «входящие» которого положена заявка
&Колонка(Тип = "Целое")
Перем ПулИдентификатор Экспорт;

// имя пакета в регистре, в котором его прислал заявитель
&Колонка
Перем ИмяПакета Экспорт;

// канонический ключ имени (НРег) — по нему ищется конкурентная заявка на то же имя
&Колонка
Перем ИмяНижнийРегистр Экспорт;

&Колонка
Перем Версия Экспорт;

// кто подал заявку (id пользователя)
&Колонка(Тип = "Целое")
Перем ЗаявительИдентификатор Экспорт;

// ожидает | одобрена | отклонена
&Колонка
Перем Состояние Экспорт;

&Колонка(Тип = "ДатаВремя")
Перем Создана Экспорт;

&Колонка(Тип = "ДатаВремя")
Перем Рассмотрена Экспорт;

// кто рассмотрел (id пользователя; 0 — ещё не рассмотрена)
&Колонка(Тип = "Целое")
Перем РассмотрелИдентификатор Экспорт;

// значение заголовка FILE-NAME исходного push
&Колонка
Перем ИмяФайла Экспорт;

// значение заголовка CHANNEL исходного push (legacy-метка)
&Колонка
Перем Канал Экспорт;

// автор из манифеста присланного .ospx — рассматривающему нужен он, а не только логин
// заявителя: это разные люди, когда пакет публикует не его автор
&Колонка
Перем АвторМанифеста Экспорт;

&Колонка(Тип = "Целое")
Перем Размер Экспорт;

&Колонка
Перем Sha256 Экспорт;

// имя файла артефакта во «входящих» хранилища (уникальное)
&Колонка
Перем КлючХранилища Экспорт;

// причина отклонения либо пояснение рассмотревшего
&Колонка
Перем Комментарий Экспорт;

// Состояние живой заявки, ожидающей рассмотрения.
//
// Возвращаемое значение:
//  Строка - каноническое значение колонки Состояние.
//
Функция СостояниеОжидает() Экспорт
	Возврат "ожидает";
КонецФункции

// Состояние одобренной заявки.
//
// Возвращаемое значение:
//  Строка - каноническое значение колонки Состояние.
//
Функция СостояниеОдобрена() Экспорт
	Возврат "одобрена";
КонецФункции

// Состояние отклонённой заявки.
//
// Возвращаемое значение:
//  Строка - каноническое значение колонки Состояние.
//
Функция СостояниеОтклонена() Экспорт
	Возврат "отклонена";
КонецФункции

// Ждёт ли заявка рассмотрения.
//
// Возвращаемое значение:
//  Булево.
//
Функция Ожидает() Экспорт
	Возврат НРег(СокрЛП(Строка(Состояние))) = СостояниеОжидает();
КонецФункции

&Сущность(ИмяТаблицы = "ВходящиеПубликации")
Процедура ПриСозданииОбъекта()
КонецПроцедуры
