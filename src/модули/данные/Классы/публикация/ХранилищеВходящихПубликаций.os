// Хранилище входящих публикаций — фасад сущности «ВходящаяПубликация» над ЗапросыВходящихПубликаций.
// Доменные операции — публикация/СервисВходящих; «одна живая заявка на имя+версию»
// держит сервисный слой: тройка законно повторяется после отклонения заявки.

Перем Запросы;

// Заявка по идентификатору.
//
// Параметры:
//  Идентификатор - Число.
//
// Возвращаемое значение:
//  ВходящаяПубликация, Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Запросы.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Все заявки пула (любого состояния) — витрина «входящих».
//
// Параметры:
//  ПулИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация.
//
Функция ПолучитьПоПулИдентификаторРавно(Знач ПулИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПулИдентификаторРавно(ПулИдентификатор);
КонецФункции

// Все заявки, поданные пользователем (витрина «мои заявки»).
//
// Параметры:
//  ЗаявительИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация.
//
Функция ПолучитьПоЗаявительИдентификаторРавно(Знач ЗаявительИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоЗаявительИдентификаторРавно(ЗаявительИдентификатор);
КонецФункции

// Заявки пула в заданном состоянии.
//
// Параметры:
//  ПулИдентификатор - Число.
//  Состояние - Строка.
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация.
//
Функция ЗаявкиПулаВСостоянии(Знач ПулИдентификатор, Знач Состояние) Экспорт

	Возврат Запросы.ПолучитьПоПулИдентификаторРавноИСостояниеРавно(
		Цел(ПулИдентификатор), Строка(Состояние));

КонецФункции

// Живая (ожидающая) заявка на конкретное имя и версию в пуле.
//
// Параметры:
//  ПулИдентификатор - Число.
//  ИмяНижнийРегистр - Строка - канонический ключ имени пакета.
//  Версия - Строка.
//  Состояние - Строка.
//
// Возвращаемое значение:
//  ВходящаяПубликация, Неопределено.
//
Функция НайтиПоИмениИВерсии(Знач ПулИдентификатор, Знач ИмяНижнийРегистр, Знач Версия, Знач Состояние) Экспорт

	Возврат Запросы.ПолучитьОдноПоПулИдентификаторРавноИИмяНижнийРегистрРавноИВерсияРавноИСостояниеРавно(
		Цел(ПулИдентификатор), Строка(ИмяНижнийРегистр), Строка(Версия), Строка(Состояние));

КонецФункции

// Ожидающие заявки на имя пакета в пуле (конкурентные заявки разных людей).
//
// Параметры:
//  ПулИдентификатор - Число.
//  ИмяНижнийРегистр - Строка.
//  Состояние - Строка.
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация.
//
Функция ЗаявкиНаИмя(Знач ПулИдентификатор, Знач ИмяНижнийРегистр, Знач Состояние) Экспорт

	Возврат Запросы.ПолучитьПоПулИдентификаторРавноИИмяНижнийРегистрРавноИСостояниеРавно(
		Цел(ПулИдентификатор), Строка(ИмяНижнийРегистр), Строка(Состояние));

КонецФункции

// Все заявки хаба (витрина администратора и уборка).
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация.
//
Функция Все() Экспорт
	Возврат Запросы.ПолучитьПо();
КонецФункции

// Новая несохранённая заявка.
//
// Возвращаемое значение:
//  ВходящаяПубликация.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

// Удаляет заявку.
//
// Параметры:
//  Заявка - ВходящаяПубликация.
//
Процедура Удалить(Знач Заявка) Экспорт
	Запросы.Удалить(Заявка);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ЗапросыВходящихПубликаций") _Запросы)
	Запросы = _Запросы;
КонецПроцедуры
