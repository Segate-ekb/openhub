// Хранилище доверенных конвейеров — фасад сущности «ДовериеCI» над ЗапросыДоверияCI.
// Доменные операции и валидация — публикация/СервисДоверияCI, он же держит уникальность.

Перем Запросы;

// Запись доверия по идентификатору.
//
// Параметры:
//  Идентификатор - Число.
//
// Возвращаемое значение:
//  ДовериеCI, Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Запросы.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Все доверенные конвейеры пакета.
//
// Параметры:
//  ПакетИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из ДовериеCI.
//
Функция ПолучитьПоПакетИдентификаторРавно(Знач ПакетИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор);
КонецФункции

// Все записи хаба (уборка и витрина администратора).
//
// Возвращаемое значение:
//  Массив из ДовериеCI.
//
Функция Все() Экспорт
	Возврат Запросы.ПолучитьПо();
КонецФункции

// Новая несохранённая запись доверия.
//
// Возвращаемое значение:
//  ДовериеCI.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

// Удаляет запись доверия.
//
// Параметры:
//  Запись - ДовериеCI.
//
Процедура Удалить(Знач Запись) Экспорт
	Запросы.Удалить(Запись);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ЗапросыДоверияCI") _Запросы)
	Запросы = _Запросы;
КонецПроцедуры
