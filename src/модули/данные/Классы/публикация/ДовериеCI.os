// Сущность «ДовериеCI» — доверенный конвейер сборки: какой конвейер какого репозитория
// вправе публиковать пакет. Сверяется с клеймами OIDC id-token конвейера.
// Непустые поля сверяются по И; пустыми могут быть только Конвейер и Реф —
// Провайдер, Издатель и Репозиторий обязательны (валидация в СервисДоверияCI).

&Идентификатор
&ГенерируемоеЗначение
&Колонка(Тип = "Целое")
Перем Идентификатор Экспорт;

// пакет, которому доверяет конвейер (→ Пакет.Идентификатор)
&Колонка(Тип = "Целое")
Перем ПакетИдентификатор Экспорт;

// пул пакета — денормализация: привязка PAT проверяется по пулу на каждой проверке
&Колонка(Тип = "Целое")
Перем ПулИдентификатор Экспорт;

// github | gitlab
&Колонка
Перем Провайдер Экспорт;

// клейм iss (нормализован: без хвостового «/», нижний регистр схемы и хоста)
&Колонка
Перем Издатель Экспорт;

// owner/repo (GitHub) либо group/project (GitLab)
&Колонка
Перем Репозиторий Экспорт;

// путь конвейера; "" — любой конвейер репозитория
&Колонка
Перем Конвейер Экспорт;

// ref ветки/тега; "" — любой
&Колонка
Перем Реф Экспорт;

&Колонка(Тип = "ДатаВремя")
Перем Создано Экспорт;

// кто настроил доверие (id пользователя; 0 — системно)
&Колонка(Тип = "Целое")
Перем КемСоздано Экспорт;

// Провайдер «GitHub Actions».
//
// Возвращаемое значение:
//  Строка - каноническое значение колонки Провайдер.
//
Функция ПровайдерGitHub() Экспорт
	Возврат "github";
КонецФункции

// Провайдер «GitLab CI».
//
// Возвращаемое значение:
//  Строка - каноническое значение колонки Провайдер.
//
Функция ПровайдерGitLab() Экспорт
	Возврат "gitlab";
КонецФункции

// Единственный список поддерживаемых провайдеров — сервис и UI сверяются с ним.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ДопустимыеПровайдеры() Экспорт
	Список = Новый Массив();
	Список.Добавить(ПровайдерGitHub());
	Список.Добавить(ПровайдерGitLab());
	Возврат Список;
КонецФункции

&Сущность(ИмяТаблицы = "ДовериеCI")
Процедура ПриСозданииОбъекта()
КонецПроцедуры
