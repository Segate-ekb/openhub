// Хранилище сессий — фасад сущности "ВебСессия" над деривованными запросами;
// обслуживает ХранилищеСессийБД (auth).

Перем Запросы;

// Сессия по идентификатору.
//
// Параметры:
//  Идентификатор - Строка.
//
// Возвращаемое значение:
//  ВебСессия, Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Запросы.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Все сессии.
//
// Возвращаемое значение:
//  Массив из ВебСессия.
//
Функция Все() Экспорт
	Возврат Запросы.ПолучитьПо();
КонецФункции

// Сессии пользователя: по ним снимаются его следы при удалении учётки.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из ВебСессия.
//
Функция ПолучитьПоПользовательИдентификаторРавно(Знач ПользовательИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПользовательИдентификаторРавно(ПользовательИдентификатор);
КонецФункции

// Недействительные сессии на момент: завершённые ИЛИ с дедлайном <= момент.
//
// Параметры:
//  Момент - Дата - универсальное время.
//
// Возвращаемое значение:
//  Массив из ВебСессия - объединение без дублей.
//
Функция НедействительныеДо(Знач Момент) Экспорт

	Результат = Новый Массив();
	ВиденныеИд = Новый Соответствие();

	Для Каждого Сессия Из Запросы.ПолучитьПоЗавершенаРавно(Истина) Цикл
		Если ВиденныеИд.Получить(Сессия.Идентификатор) = Неопределено Тогда
			ВиденныеИд.Вставить(Сессия.Идентификатор, Истина);
			Результат.Добавить(Сессия);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Сессия Из Запросы.ПолучитьПоИстекаетМеньшеИлиРавно(Момент) Цикл
		Если ВиденныеИд.Получить(Сессия.Идентификатор) = Неопределено Тогда
			ВиденныеИд.Вставить(Сессия.Идентификатор, Истина);
			Результат.Добавить(Сессия);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Новая несохранённая запись сессии.
//
// Возвращаемое значение:
//  ВебСессия.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

// Удаляет запись сессии.
//
// Параметры:
//  Сессия - ВебСессия.
//
Процедура Удалить(Знач Сессия) Экспорт
	Запросы.Удалить(Сессия);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗапросыСессий") _Запросы)

	Запросы = _Запросы;

КонецПроцедуры
