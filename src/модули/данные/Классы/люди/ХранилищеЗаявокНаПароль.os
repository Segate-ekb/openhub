// Хранилище заявок на установку пароля — фасад сущности "ЗаявкаНаПароль" над
// деривованными запросами.

Перем Запросы;

// Заявка по идентификатору.
//
// Параметры:
//  Идентификатор - Число.
//
// Возвращаемое значение:
//  ЗаявкаНаПароль, Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Запросы.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Заявки одной учётной записи.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из ЗаявкаНаПароль.
//
Функция ПолучитьПоПользовательИдентификаторРавно(Знач ПользовательИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПользовательИдентификаторРавно(ПользовательИдентификатор);
КонецФункции

// Заявки, выпущенные на один адрес получателя (нормализованный).
//
// Параметры:
//  Адрес - Строка - адрес получателя.
//
// Возвращаемое значение:
//  Массив из ЗаявкаНаПароль.
//
Функция ПолучитьПоАдресРавно(Знач Адрес) Экспорт
	Возврат Запросы.ПолучитьПоАдресРавно(Строка(Адрес));
КонецФункции

// Заявки, запрошенные с одного адреса клиента.
//
// Параметры:
//  АдресIP - Строка - адрес клиента.
//
// Возвращаемое значение:
//  Массив из ЗаявкаНаПароль.
//
Функция ПолучитьПоАдресIPРавно(Знач АдресIP) Экспорт
	Возврат Запросы.ПолучитьПоАдресIPРавно(Строка(АдресIP));
КонецФункции

// Заявки с истёкшим на момент сроком.
//
// Параметры:
//  Момент - Дата - универсальное время.
//
// Возвращаемое значение:
//  Массив из ЗаявкаНаПароль.
//
Функция ИстёкшиеДо(Знач Момент) Экспорт
	Возврат Запросы.ПолучитьПоИстекаетМеньшеИлиРавно(Момент);
КонецФункции

// Новая несохранённая заявка.
//
// Возвращаемое значение:
//  ЗаявкаНаПароль.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

// Удаляет заявку.
//
// Параметры:
//  Заявка - ЗаявкаНаПароль.
//
Процедура Удалить(Знач Заявка) Экспорт
	Запросы.Удалить(Заявка);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗапросыЗаявокНаПароль") _Запросы)

	Запросы = _Запросы;

КонецПроцедуры
