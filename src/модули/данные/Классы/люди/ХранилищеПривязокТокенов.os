// Хранилище привязок токена к пулам — фасад сущности "ПривязкаТокена" над деривованными
// запросами. Привязка живёт ровно столько, сколько живёт её токен.

Перем Запросы;

// Привязки токена.
//
// Параметры:
//  ТокенИдентификатор - Число - идентификатор токена доступа.
//
// Возвращаемое значение:
//  Массив из ПривязкаТокена.
//
Функция ПривязкиТокена(Знач ТокенИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоТокенИдентификаторРавно(Цел(ТокенИдентификатор));
КонецФункции

// Привязки нескольких токенов сразу: список экрана стоит одного запроса, а не запроса
// на строку. Пустой список идентификаторов — пустая выдача.
//
// Параметры:
//  ТокенИдентификаторы - Массив из Число - идентификаторы токенов доступа.
//
// Возвращаемое значение:
//  Массив из ПривязкаТокена.
//
Функция ПривязкиТокенов(Знач ТокенИдентификаторы) Экспорт

	Целые = Новый Массив();
	Для Каждого Идентификатор Из ТокенИдентификаторы Цикл
		Целые.Добавить(Цел(Идентификатор));
	КонецЦикла;

	Возврат Запросы.ПолучитьПоТокенИдентификаторВ(Целые);

КонецФункции

// Привязки к пулу: по ним видно, какие токены его называют.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ПривязкаТокена.
//
Функция ПривязкиПула(Знач ПулИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПулИдентификаторРавно(Цел(ПулИдентификатор));
КонецФункции

// Записывает привязку токена к пулу.
//
// Параметры:
//  ТокенИдентификатор - Число - идентификатор токена доступа.
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  ПривязкаТокена - сохранённая запись.
//
Функция Записать(Знач ТокенИдентификатор, Знач ПулИдентификатор) Экспорт

	Привязка = Запросы.СоздатьЭлемент();
	Привязка.ТокенИдентификатор = Цел(ТокенИдентификатор);
	Привязка.ПулИдентификатор = Цел(ПулИдентификатор);
	Привязка.Сохранить();
	Возврат Привязка;

КонецФункции

// Удаляет привязку.
//
// Параметры:
//  Привязка - ПривязкаТокена.
//
Процедура Удалить(Знач Привязка) Экспорт
	Запросы.Удалить(Привязка);
КонецПроцедуры

// Снимает все привязки токена.
//
// Параметры:
//  ТокенИдентификатор - Число - идентификатор токена доступа.
//
// Возвращаемое значение:
//  Число - сколько привязок снято.
//
Функция СнятьПривязкиТокена(Знач ТокенИдентификатор) Экспорт

	Снято = 0;
	Для Каждого Привязка Из ПривязкиТокена(ТокенИдентификатор) Цикл
		Запросы.Удалить(Привязка);
		Снято = Снято + 1;
	КонецЦикла;
	Возврат Снято;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗапросыПривязокТокенов") _Запросы)

	Запросы = _Запросы;

КонецПроцедуры
