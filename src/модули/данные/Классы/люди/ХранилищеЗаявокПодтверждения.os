// Хранилище заявок подтверждения адреса — фасад сущности "ЗаявкаПодтвержденияEmail"
// над деривованными запросами.

Перем СоСроком;  // ХранилищеЗаявокСоСроком (данные) — срок, создание и удаление заявки

// Заявка по идентификатору.
//
// Параметры:
//  Идентификатор - Число.
//
// Возвращаемое значение:
//  ЗаявкаПодтвержденияEmail, Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат СоСроком.Запросы().ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Заявки одной учётной записи.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из ЗаявкаПодтвержденияEmail.
//
Функция ПолучитьПоПользовательИдентификаторРавно(Знач ПользовательИдентификатор) Экспорт
	Возврат СоСроком.Запросы().ПолучитьПоПользовательИдентификаторРавно(ПользовательИдентификатор);
КонецФункции

// Заявки с истёкшим на момент сроком.
//
// Параметры:
//  Момент - Дата - универсальное время.
//
// Возвращаемое значение:
//  Массив из ЗаявкаПодтвержденияEmail.
//
Функция ИстёкшиеДо(Знач Момент) Экспорт
	Возврат СоСроком.ИстёкшиеДо(Момент);
КонецФункции

// Новая несохранённая заявка.
//
// Возвращаемое значение:
//  ЗаявкаПодтвержденияEmail.
//
Функция СоздатьЭлемент() Экспорт
	Возврат СоСроком.СоздатьЭлемент();
КонецФункции

// Удаляет заявку.
//
// Параметры:
//  Заявка - ЗаявкаПодтвержденияEmail.
//
Процедура Удалить(Знач Заявка) Экспорт
	СоСроком.Удалить(Заявка);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗапросыЗаявокПодтверждения") _Запросы)

	СоСроком = Новый ХранилищеЗаявокСоСроком(_Запросы);

КонецПроцедуры
