// Хранилище внешних личностей — фасад сущности "ВнешняяЛичность" над деривованными запросами.

Перем Запросы;

// Личность по идентификатору.
//
// Параметры:
//  Идентификатор - Число.
//
// Возвращаемое значение:
//  ВнешняяЛичность, Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Запросы.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Все личности пользователя (для кабинета «мои привязки»).
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из ВнешняяЛичность.
//
Функция ПолучитьПоПользовательИдентификаторРавно(Знач ПользовательИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПользовательИдентификаторРавно(ПользовательИдентификатор);
КонецФункции

// Личность по паре issuer+subject (уникальный ключ личности провайдера).
//
// Параметры:
//  Издатель - Строка - issuer провайдера.
//  Субъект - Строка - sub у провайдера.
//
// Возвращаемое значение:
//  ВнешняяЛичность, Неопределено.
//
Функция НайтиПоЛичности(Знач Издатель, Знач Субъект) Экспорт
	Возврат Запросы.ПолучитьОдноПоИздательРавноИСубъектРавно(Строка(Издатель), Строка(Субъект));
КонецФункции

// Все привязки личностей.
//
// Возвращаемое значение:
//  Массив из ВнешняяЛичность.
//
Функция Получить() Экспорт
	Возврат Запросы.ПолучитьПо();
КонецФункции

// Новая несохранённая привязка личности.
//
// Возвращаемое значение:
//  ВнешняяЛичность.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

// Удаляет запись привязки личности.
//
// Параметры:
//  Личность - ВнешняяЛичность.
//
Процедура Удалить(Знач Личность) Экспорт
	Запросы.Удалить(Личность);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗапросыВнешнихЛичностей") _Запросы)

	Запросы = _Запросы;

КонецПроцедуры
