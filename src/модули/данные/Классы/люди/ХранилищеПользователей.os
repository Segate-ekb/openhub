// Хранилище пользователей — фасад сущности "Пользователь" над деривованными запросами.
// Логин хранится уже нормализованным (НормализаторУчётки на слое auth).

Перем Запросы;

// Пользователь по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пользователя.
//
// Возвращаемое значение:
//  Пользователь, Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Запросы.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Пользователь по нормализованному логину.
//
// Параметры:
//  Логин - Строка - логин (ожидается уже нормализованным).
//
// Возвращаемое значение:
//  Пользователь, Неопределено.
//
Функция НайтиПоЛогину(Знач Логин) Экспорт
	Возврат Запросы.ПолучитьОдноПоЛогинРавно(Логин);
КонецФункции

// Пользователи с указанным (нормализованным) email. Email не уникален на уровне схемы,
// поэтому возвращается массив — политику «ровно один» применяет вызывающий.
//
// Параметры:
//  Email - Строка - email (ожидается нормализованным: нижний регистр, без краёв).
//
// Возвращаемое значение:
//  Массив из Пользователь.
//
Функция НайтиВсехПоEmail(Знач Email) Экспорт
	Возврат Запросы.ПолучитьПоEmailРавно(Строка(Email));
КонецФункции

// Все пользователи хаба.
//
// Возвращаемое значение:
//  Массив из Пользователь.
//
Функция Все() Экспорт
	Возврат Запросы.ПолучитьПо();
КонецФункции

// Поля учётной записи, по которым идёт отбор списков, в порядке убывания важности.
//
// Возвращаемое значение:
//  Строка - имена полей через запятую для ПоискПоКоллекции.
//
Функция ПоляОтбора() Экспорт
	Возврат "Логин,Email";
КонецФункции

// Число пользователей (для онбординга: 0 → режим первого запуска).
//
// Возвращаемое значение:
//  Число.
//
Функция Количество() Экспорт
	Возврат Все().Количество();
КонецФункции

// Новый несохранённый пользователь.
//
// Возвращаемое значение:
//  Пользователь.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗапросыПользователей") _Запросы)

	Запросы = _Запросы;

КонецПроцедуры
