// Хранилище пользователей — репозиторий сущности «Пользователь». Логин хранится уже
// нормализованным (НормализаторУчётки на слое auth).

// BSLLS:UnusedParameters-off

Перем Сам;        // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё
Перем Агрегаты;   // АгрегатыБазы (данные) — счёт спрашивается у базы

// Пользователь по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пользователя.
//
// Возвращаемое значение:
//  Пользователь, Неопределено.
//
&МетодЗапроса
Функция ПолучитьОдноПоИдентификаторРавно(Идентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Учётки перечисленных идентификаторов — один запрос на весь список.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пользователей.
//
// Возвращаемое значение:
//  Массив из Пользователь.
//
&МетодЗапроса
Функция ПолучитьПоИдентификаторВ(Идентификаторы) Экспорт
	Возврат Неопределено;
КонецФункции

// Пользователь по логину (значение сравнивается как есть, без канонизации).
//
// Параметры:
//  Логин - Строка - нормализованный логин.
//
// Возвращаемое значение:
//  Пользователь, Неопределено.
//
&МетодЗапроса
Функция ПолучитьОдноПоЛогинРавно(Логин) Экспорт
	Возврат Неопределено;
КонецФункции

// Пользователи с указанным email.
//
// Параметры:
//  Email - Строка - нормализованный email.
//
// Возвращаемое значение:
//  Массив из Пользователь.
//
&МетодЗапроса
Функция ПолучитьПоEmailРавно(Email) Экспорт
	Возврат Неопределено;
КонецФункции

// Все пользователи хаба.
//
// Возвращаемое значение:
//  Массив из Пользователь.
//
&МетодЗапроса
Функция ПолучитьПо() Экспорт
	Возврат Неопределено;
КонецФункции

// Первые учётки без отбора — вопрос «есть ли в хабе хоть кто-нибудь» задаётся на каждой
// странице кабинета, и всю таблицу ради него не читают.
//
// Параметры:
//  Количество - Число - сколько записей вернуть.
//
// Возвращаемое значение:
//  Массив из Пользователь.
//
&МетодЗапроса
Функция ПолучитьПервые(Количество) Экспорт
	Возврат Неопределено;
КонецФункции

// Учётки перечисленных идентификаторов одним отбором — там, где имена нужны сразу целому
// списку строк и вопрос на строку превратил бы экран в N+1.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пользователей.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (идентификатор), значение Пользователь; ненайденных в нём нет.
//
Функция ПоИдентификаторам(Знач Идентификаторы) Экспорт

	Результат = Новый Соответствие();
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Учётка Из Сам.Достать().ПолучитьПоИдентификаторВ(Идентификаторы) Цикл
		Результат.Вставить(Цел(Учётка.Идентификатор), Учётка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пользователь по нормализованному логину.
//
// Параметры:
//  Логин - Строка - логин (ожидается уже нормализованным).
//
// Возвращаемое значение:
//  Пользователь, Неопределено.
//
Функция НайтиПоЛогину(Знач Логин) Экспорт
	Возврат Сам.Достать().ПолучитьОдноПоЛогинРавно(Логин);
КонецФункции

// Пользователи с указанным (нормализованным) email. Email не уникален на уровне схемы,
// поэтому возвращается массив — политику «ровно один» применяет вызывающий.
//
// Параметры:
//  Email - Строка - email (ожидается нормализованным: нижний регистр, без краёв).
//
// Возвращаемое значение:
//  Массив из Пользователь.
//
Функция НайтиВсехПоEmail(Знач Email) Экспорт
	Возврат Сам.Достать().ПолучитьПоEmailРавно(Строка(Email));
КонецФункции

// Все пользователи хаба — выборка ПолучитьПо под именем, которым её зовут потребители.
//
// Возвращаемое значение:
//  Массив из Пользователь.
//
Функция Все() Экспорт
	Возврат Сам.Достать().ПолучитьПо();
КонецФункции

// Поля учётной записи, по которым идёт отбор списков, в порядке убывания важности.
//
// Возвращаемое значение:
//  Строка - имена полей через запятую для ПоискПоКоллекции.
//
Функция ПоляОтбора() Экспорт
	Возврат "Логин,Email";
КонецФункции

// Число пользователей.
//
// Возвращаемое значение:
//  Число.
//
Функция Количество() Экспорт
	Возврат Агрегаты.Количество(Сам.Достать());
КонецФункции

// Есть ли в хабе хоть одна учётка. Спрашивается на каждой странице кабинета, поэтому
// читается одна строка, а не вся таблица.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьХотяБыОдна() Экспорт
	Возврат Сам.Достать().ПолучитьПервые(1).Количество() > 0;
КонецФункции

// Ответ «учётка есть» из кэша «учётки». Ответ «нет» не кэшируется: он открывает мастер
// первого запуска, а учётку может завести и процесс мимо хаба (admin-cli).
//
// Возвращаемое значение:
//  Булево, Неопределено - Истина, если учётка есть; Неопределено — учёток нет.
//
&Кэшируемый("учётки")
Функция УчёткаЕсть() Экспорт
	Возврат ?(ЕстьХотяБыОдна(), Истина, Неопределено);
КонецФункции

// Забывает ответ «учётка есть»: зовёт удаление учётки.
//
&СбрасываетКэш(Значение = "учётки", ВсеЗаписи = Истина)
Процедура ЗабытьНаличиеУчёток() Экспорт
КонецПроцедуры

&ХранилищеСущностей("Пользователь")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеПользователей") _Сам,
	&Пластилин(Значение = "АгрегатыБазы") _Агрегаты)

	Сам = _Сам;
	Агрегаты = _Агрегаты;

КонецПроцедуры
