// Хранилище личных уведомлений — фасад сущности «ЛичноеУведомление» над деривованными
// запросами.

#Использовать entity

Перем Запросы;
Перем Агрегаты;   // АгрегатыБазы (данные) — счёт непрочитанного спрашивается у базы

// Лента учётной записи, свежие записи первыми.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из ЛичноеУведомление.
//
Функция ЛентаУчётки(Знач ПользовательИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПользовательИдентификаторРавноУпорядочитьПоСозданоУбывИдентификаторУбыв(
		ПользовательИдентификатор);
КонецФункции

// Непрочитанные уведомления одной учётной записи.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из ЛичноеУведомление.
//
Функция Непрочитанные(Знач ПользовательИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПользовательИдентификаторРавноИПрочитаноРавно(
		ПользовательИдентификатор, Ложь);
КонецФункции

// Непрочитанные уведомления учётной записи, свежие первыми.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из ЛичноеУведомление.
//
Функция НепрочитанныеСвежимиПервыми(Знач ПользовательИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПользовательИдентификаторРавноИПрочитаноРавноУпорядочитьПоСозданоУбывИдентификаторУбыв(
		ПользовательИдентификатор, Ложь);
КонецФункции

// Несколько свежайших непрочитанных уведомлений учётной записи.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//  Предел - Число - сколько записей вернуть.
//
// Возвращаемое значение:
//  Массив из ЛичноеУведомление.
//
Функция СвежиеНепрочитанные(Знач ПользовательИдентификатор, Знач Предел) Экспорт
	Возврат Запросы.ПолучитьПервыеПоПользовательИдентификаторРавноИПрочитаноРавноУпорядочитьПоСозданоУбывИдентификаторУбыв(
		Предел, ПользовательИдентификатор, Ложь);
КонецФункции

// Сколько уведомлений учётной записи не прочитано. Бейдж ленты спрашивают на каждой
// странице хаба, и ради числа лента не поднимается.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Число.
//
Функция СчётНепрочитанных(Знач ПользовательИдентификатор) Экспорт

	Возврат Агрегаты.Количество(Запросы, Новый ОпцииПоиска()
		.Отбор("ПользовательИдентификатор", ВидСравнения.Равно, Цел(ПользовательИдентификатор))
		.Отбор("Прочитано", ВидСравнения.Равно, Ложь));

КонецФункции

// Новое несохранённое уведомление.
//
// Возвращаемое значение:
//  ЛичноеУведомление.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

// Удаляет уведомление.
//
// Параметры:
//  Уведомление - ЛичноеУведомление.
//
Процедура Удалить(Знач Уведомление) Экспорт
	Запросы.Удалить(Уведомление);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗапросыЛичныхУведомлений") _Запросы,
	&Пластилин(Значение = "АгрегатыБазы") _Агрегаты)

	Запросы = _Запросы;
	Агрегаты = _Агрегаты;

КонецПроцедуры
