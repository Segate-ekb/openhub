// Хранилище личных уведомлений — репозиторий сущности «ЛичноеУведомление».

// BSLLS:UnusedParameters-off

#Использовать entity

Перем Сам;        // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё
Перем Агрегаты;   // АгрегатыБазы (данные) — счёт непрочитанного спрашивается у базы

// Лента учётной записи, свежие записи первыми. Порядок задаёт база: сортировать массив
// в памяти нечем, а лента растёт.
//
// Параметры:
//  ПользовательИдентификатор - Число - адресат.
//
// Возвращаемое значение:
//  Массив из ЛичноеУведомление.
//
&МетодЗапроса
Функция ПолучитьПоПользовательИдентификаторРавноУпорядочитьПоСозданоУбывИдентификаторУбыв(
	ПользовательИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Уведомления одной учётной записи в заданном состоянии прочтения.
//
// Параметры:
//  ПользовательИдентификатор - Число - адресат.
//  Прочитано - Булево - состояние прочтения.
//
// Возвращаемое значение:
//  Массив из ЛичноеУведомление.
//
&МетодЗапроса
Функция ПолучитьПоПользовательИдентификаторРавноИПрочитаноРавно(
	ПользовательИдентификатор, Прочитано) Экспорт
	Возврат Неопределено;
КонецФункции

// Уведомления учётной записи в заданном состоянии прочтения, свежие первыми — виджету,
// которому нужны и верхние строки, и их общее число: два разных запроса ради одного
// и того же среза стоили бы двойного чтения.
//
// Параметры:
//  ПользовательИдентификатор - Число - адресат.
//  Прочитано - Булево - состояние прочтения.
//
// Возвращаемое значение:
//  Массив из ЛичноеУведомление.
//
&МетодЗапроса
Функция ПолучитьПоПользовательИдентификаторРавноИПрочитаноРавноУпорядочитьПоСозданоУбывИдентификаторУбыв(
	ПользовательИдентификатор, Прочитано) Экспорт
	Возврат Неопределено;
КонецФункции

// Несколько свежайших уведомлений учётной записи в заданном состоянии прочтения —
// для виджета кабинета, которому нужны единицы записей, а не вся лента.
//
// Параметры:
//  Лимит - Число - сколько записей вернуть.
//  ПользовательИдентификатор - Число - адресат.
//  Прочитано - Булево - состояние прочтения.
//
// Возвращаемое значение:
//  Массив из ЛичноеУведомление.
//
&МетодЗапроса
Функция ПолучитьПервыеПоПользовательИдентификаторРавноИПрочитаноРавноУпорядочитьПоСозданоУбывИдентификаторУбыв(
	Лимит, ПользовательИдентификатор, Прочитано) Экспорт
	Возврат Неопределено;
КонецФункции

// Лента учётной записи, свежие записи первыми.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из ЛичноеУведомление.
//
Функция ЛентаУчётки(Знач ПользовательИдентификатор) Экспорт
	Возврат Сам.Достать().ПолучитьПоПользовательИдентификаторРавноУпорядочитьПоСозданоУбывИдентификаторУбыв(
		ПользовательИдентификатор);
КонецФункции

// Непрочитанные уведомления одной учётной записи.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из ЛичноеУведомление.
//
Функция Непрочитанные(Знач ПользовательИдентификатор) Экспорт
	Возврат Сам.Достать().ПолучитьПоПользовательИдентификаторРавноИПрочитаноРавно(
		ПользовательИдентификатор, Ложь);
КонецФункции

// Непрочитанные уведомления учётной записи, свежие первыми.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из ЛичноеУведомление.
//
Функция НепрочитанныеСвежимиПервыми(Знач ПользовательИдентификатор) Экспорт
	Возврат Сам.Достать().ПолучитьПоПользовательИдентификаторРавноИПрочитаноРавноУпорядочитьПоСозданоУбывИдентификаторУбыв(
		ПользовательИдентификатор, Ложь);
КонецФункции

// Несколько свежайших непрочитанных уведомлений учётной записи.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//  Предел - Число - сколько записей вернуть.
//
// Возвращаемое значение:
//  Массив из ЛичноеУведомление.
//
Функция СвежиеНепрочитанные(Знач ПользовательИдентификатор, Знач Предел) Экспорт
	Возврат Сам.Достать().ПолучитьПервыеПоПользовательИдентификаторРавноИПрочитаноРавноУпорядочитьПоСозданоУбывИдентификаторУбыв(
		Предел, ПользовательИдентификатор, Ложь);
КонецФункции

// Сколько уведомлений учётной записи не прочитано. Бейдж ленты спрашивают на каждой
// странице хаба, и ради числа лента не поднимается.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Число.
//
Функция СчётНепрочитанных(Знач ПользовательИдентификатор) Экспорт

	Возврат Агрегаты.Количество(Сам.Достать(), Новый ОпцииПоиска()
		.Отбор("ПользовательИдентификатор", ВидСравнения.Равно, Цел(ПользовательИдентификатор))
		.Отбор("Прочитано", ВидСравнения.Равно, Ложь));

КонецФункции

&ХранилищеСущностей("ЛичноеУведомление")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеЛичныхУведомлений") _Сам,
	&Пластилин(Значение = "АгрегатыБазы") _Агрегаты)

	Сам = _Сам;
	Агрегаты = _Агрегаты;

КонецПроцедуры
