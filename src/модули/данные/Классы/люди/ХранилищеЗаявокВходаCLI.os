// Хранилище заявок входа CLI — фасад сущности "ЗаявкаВходаCLI" над деривованными запросами.

Перем Запросы;

// Заявка по хешу кода устройства.
//
// Параметры:
//  ХешКодаУстройства - Строка.
//
// Возвращаемое значение:
//  ЗаявкаВходаCLI, Неопределено.
//
Функция ПолучитьОдноПоХешКодаУстройстваРавно(Знач ХешКодаУстройства) Экспорт
	Возврат Запросы.ПолучитьОдноПоХешКодаУстройстваРавно(ХешКодаУстройства);
КонецФункции

// Заявки с заданным кодом человека (уникальность держит сервисный слой).
//
// Параметры:
//  КодПользователя - Строка.
//
// Возвращаемое значение:
//  Массив из ЗаявкаВходаCLI.
//
Функция ПолучитьПоКодПользователяРавно(Знач КодПользователя) Экспорт
	Возврат Запросы.ПолучитьПоКодПользователяРавно(КодПользователя);
КонецФункции

// Заявки с истёкшим на момент сроком.
//
// Параметры:
//  Момент - Дата - универсальное время.
//
// Возвращаемое значение:
//  Массив из ЗаявкаВходаCLI.
//
Функция ИстёкшиеДо(Знач Момент) Экспорт
	Возврат Запросы.ПолучитьПоИстекаетМеньшеИлиРавно(Момент);
КонецФункции

// Новая несохранённая заявка.
//
// Возвращаемое значение:
//  ЗаявкаВходаCLI.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

// Удаляет заявку.
//
// Параметры:
//  Заявка - ЗаявкаВходаCLI.
//
Процедура Удалить(Знач Заявка) Экспорт
	Запросы.Удалить(Заявка);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗапросыЗаявокВходаCLI") _Запросы)

	Запросы = _Запросы;

КонецПроцедуры
