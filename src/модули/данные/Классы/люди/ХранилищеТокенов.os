// Хранилище токенов доступа (PAT) — репозиторий сущности «ТокенДоступа». Хранится только
// хеш секрета; отзыв токена = удаление записи вместе с её привязками к пулам.

// BSLLS:UnusedParameters-off

#Использовать entity

Перем Сам;        // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё
Перем Агрегаты;   // АгрегатыБазы (данные) — признак наличия спрашивается у базы
Перем Привязки;   // ХранилищеПривязокТокенов (данные)

// Токен по идентификатору (числовой id из значения oshub_{id}_{secret}).
//
// Параметры:
//  Идентификатор - Число - идентификатор токена.
//
// Возвращаемое значение:
//  ТокенДоступа, Неопределено.
//
&МетодЗапроса
Функция ПолучитьОдноПоИдентификаторРавно(Идентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Токены пользователя (для списка в кабинете).
//
// Параметры:
//  ПользовательИдентификатор - Число - идентификатор владельца токенов.
//
// Возвращаемое значение:
//  Массив из ТокенДоступа.
//
&МетодЗапроса
Функция ПолучитьПоПользовательИдентификаторРавно(ПользовательИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Токены, привязанные к пулу.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула привязки.
//
// Возвращаемое значение:
//  Массив из ТокенДоступа.
//
&МетодЗапроса
Функция ПолучитьПоПулИдентификаторРавно(ПулИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Токены со СТАРОЙ одиночной привязкой к пулу: такой ключ действует ровно в одном пуле
// и вместе с ним теряет смысл. Набор пулов живёт отдельными строками —
// см. ХранилищеПривязокТокенов.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула привязки.
//
// Возвращаемое значение:
//  Массив из ТокенДоступа - токены с этой привязкой.
//
Функция ТокеныПула(Знач ПулИдентификатор) Экспорт
	Возврат Сам.Достать().ПолучитьПоПулИдентификаторРавно(Цел(ПулИдентификатор));
КонецФункции

// Есть ли у человека хоть один действующий ключ доступа: бессрочный либо с моментом
// истечения позже названного. Два вопроса, а не один: «ИЛИ» опции поиска не выражают,
// а бессрочный ключ отличается от срочного пустым моментом, а не поздним.
//
// Параметры:
//  ПользовательИдентификатор - Число - владелец ключей.
//  Момент - Дата - момент, на который проверяется срок (UTC).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьДействующий(Знач ПользовательИдентификатор, Знач Момент) Экспорт

	Владелец = Цел(ПользовательИдентификатор);

	Бессрочный = Новый ОпцииПоиска()
		.Отбор("ПользовательИдентификатор", ВидСравнения.Равно, Владелец)
		.Отбор("Истекает", ВидСравнения.Равно, ПустаяДата());
	Если Агрегаты.Есть(Сам.Достать(), Бессрочный) Тогда
		Возврат Истина;
	КонецЕсли;

	Срочный = Новый ОпцииПоиска()
		.Отбор("ПользовательИдентификатор", ВидСравнения.Равно, Владелец)
		.Отбор("Истекает", ВидСравнения.Больше, Момент);

	Возврат Агрегаты.Есть(Сам.Достать(), Срочный);

КонецФункции

// Момент, которым записан бессрочный ключ: ЗначениеЗаполнено считает его незаполненным.
Функция ПустаяДата()
	Возврат '00010101';
КонецФункции

// Удаляет (отзывает) токен вместе с его привязками: осиротевшая привязка пережила бы
// свой токен и досталась бы следующему с тем же идентификатором.
//
// Параметры:
//  Токен - ТокенДоступа.
//
&Наблюдаемый
Процедура Удалить(Знач Токен) Экспорт
	Привязки.СнятьПривязкиТокена(Цел(Токен.Идентификатор));
	// своё «Удалить» заменяет базовое, поэтому строку удаляет сама запись
	Токен.Удалить();
КонецПроцедуры

&ХранилищеСущностей("ТокенДоступа")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеТокенов") _Сам,
	&Пластилин(Значение = "ХранилищеПривязокТокенов") _Привязки,
	&Пластилин(Значение = "АгрегатыБазы") _Агрегаты)

	Сам = _Сам;
	Привязки = _Привязки;
	Агрегаты = _Агрегаты;

КонецПроцедуры
