// Хранилище токенов доступа (PAT) — фасад сущности "ТокенДоступа" над деривованными запросами.
// Хранится только хеш секрета; отзыв токена = удаление записи вместе с её привязками к пулам.

Перем Запросы;
Перем Привязки;   // ХранилищеПривязокТокенов (данные)

// Токен по идентификатору (числовой id из значения oshub_{id}_{secret}).
//
// Параметры:
//  Идентификатор - Число.
//
// Возвращаемое значение:
//  ТокенДоступа, Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Запросы.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Токены пользователя (для списка в кабинете).
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из ТокенДоступа.
//
Функция ПолучитьПоПользовательИдентификаторРавно(Знач ПользовательИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПользовательИдентификаторРавно(ПользовательИдентификатор);
КонецФункции

// Токены со СТАРОЙ одиночной привязкой к пулу: такой ключ действует ровно в одном пуле
// и вместе с ним теряет смысл. Набор пулов живёт отдельными строками —
// см. ХранилищеПривязокТокенов.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула привязки.
//
// Возвращаемое значение:
//  Массив из ТокенДоступа - токены с этой привязкой.
//
Функция ТокеныПула(Знач ПулИдентификатор) Экспорт
	Возврат Запросы.ПолучитьПоПулИдентификаторРавно(Цел(ПулИдентификатор));
КонецФункции

// Новый несохранённый токен.
//
// Возвращаемое значение:
//  ТокенДоступа.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Запросы.СоздатьЭлемент();
КонецФункции

// Удаляет (отзывает) токен вместе с его привязками: осиротевшая привязка пережила бы
// свой токен и досталась бы следующему с тем же идентификатором.
//
// Параметры:
//  Токен - ТокенДоступа.
//
Процедура Удалить(Знач Токен) Экспорт
	Привязки.СнятьПривязкиТокена(Цел(Токен.Идентификатор));
	Запросы.Удалить(Токен);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗапросыТокенов") _Запросы,
	&Пластилин(Значение = "ХранилищеПривязокТокенов") _Привязки)

	Запросы = _Запросы;
	Привязки = _Привязки;

КонецПроцедуры
