// Хранилище провайдеров входа — доменный фасад над ЗапросыПровайдеровВхода; политики и
// валидация — в СервисПровайдеровВхода, сборка конфигурации — в КонфигурацияOIDC.
// Инвариант «одно имя — одна строка» держит единственная точка записи Записать.

Перем Запросы;

#Область ПубличныйИнтерфейс

// Все провайдеры в порядке имени (порядок кнопок входа детерминирован).
//
// Возвращаемое значение:
//  Массив из ПровайдерВхода.
//
Функция Все() Экспорт
	Возврат Запросы.ПолучитьУпорядочитьПоИмяВозр();
КонецФункции

// Провайдер по имени (регистр не значим) либо Неопределено.
//
// Параметры:
//  Имя - Строка.
//
// Возвращаемое значение:
//  ПровайдерВхода, Неопределено.
//
Функция НайтиПоИмени(Знач Имя) Экспорт

	Ключ = НормализованноеИмя(Имя);
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Найденные = Запросы.ПолучитьПоИмяРавноПервые(Ключ, 1);
	Возврат ?(Найденные.Количество() = 0, Неопределено, Найденные[0]);

КонецФункции

// Создаёт новую строку провайдера; существование имени вызывающий проверяет заранее.
//
// Параметры:
//  Имя - Строка - нормализуется к НРег.
//
// Возвращаемое значение:
//  ПровайдерВхода - НЕсохранённая запись (поля заполняет вызывающий, затем Сохранить).
//
Функция СоздатьЗапись(Знач Имя) Экспорт

	Запись = Запросы.СоздатьЭлемент();
	Запись.Имя = НормализованноеИмя(Имя);
	Возврат Запись;

КонецФункции

// Записывает строку (вставка либо перезапись той же строки).
//
// Параметры:
//  Запись - ПровайдерВхода;.
//  Кто - Строка - логин автора изменения;.
//  Когда - Дата - момент (UTC).
//
Процедура Записать(Запись, Знач Кто, Знач Когда) Экспорт

	Если НЕ ЗначениеЗаполнено(Запись.Создан) Тогда
		Запись.Создан = Когда;
	КонецЕсли;
	Запись.Обновлён = Когда;
	Запись.КемОбновлён = Кто;
	Запись.Сохранить();

КонецПроцедуры

// Удаляет строку провайдера. Отсутствие записи — не ошибка (удаление идемпотентно).
//
// Параметры:
//  Имя - Строка.
//
// Возвращаемое значение:
//  Булево - была ли такая строка.
//
Функция УдалитьПоИмени(Знач Имя) Экспорт

	Запись = НайтиПоИмени(Имя);
	Если Запись = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Запросы.Удалить(Запись);
	Возврат Истина;

КонецФункции

// Каноничная форма имени провайдера: НРег без окружающих пробелов.
// Экспортируется намеренно — тем же преобразованием пользуются сервис и конфигурация.
//
// Параметры:
//  Имя - Строка.
//
// Возвращаемое значение:
//  Строка.
//
Функция НормализованноеИмя(Знач Имя) Экспорт
	Возврат НРег(СокрЛП(Строка(Имя)));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин ЗапросыПровайдеровВхода) Экспорт
	Запросы = ЗапросыПровайдеровВхода;
КонецПроцедуры
