// Превращает проверенную личность (issuer+subject) и профиль в пользователя хаба.
// Сетевого кода нет; протокол OIDC — в СервисВходаOIDC.
//
// К СУЩЕСТВУЮЩЕЙ учётке личность автоматически не привязывается никогда: email владением
// учёткой не доказывается — саморегистрация пишет любой адрес неподтверждённым, поэтому
// поиск учётки по адресу отдавал бы её тому, кто зарегистрировался на чужой адрес первым.
// Единственная склейка — ПривязатьВручную из кабинета, где связывает сам вошедший.
// АвтоСоздание = Ложь закрывает вход непривязанной личности целиком.

Перем СервисЛичностей;      // СервисЛичностей (auth)
Перем СервисПользователей;  // СервисПользователей (auth)
Перем Адреса;               // АдресУчётки (auth)
Перем Нормализатор;         // НормализаторУчётки (auth)
Перем Автовыдача;           // АвтовыдачаПравGitHub (публикация); опциональна
&Лог
Перем Лог;

// Разрешает вход по проверенной личности и профилю: находит либо создаёт пользователя
// хаба и переносит в учётку адрес из профиля. Сессию не создаёт. Привязки к чужой
// существующей учётке не делает — непривязанная личность получает новую.
//
// Параметры:
//  Издатель - Строка - issuer из конфигурации провайдера либо проверенного iss.
//  Субъект - Строка - sub из проверенных клеймов id_token.
//  Профиль - Структура - Email, EmailПодтверждён, ПредпочтительныйЛогин.
//  АвтоСоздание - Булево - флаг auto-provisioning провайдера; Ложь закрывает вход всем
//                 непривязанным личностям.
//  ТокенGitHub - Строка - access-token GitHub для автовыдачи прав на этом входе;
//                пусто — вход не через GitHub либо токена нет (необязательный,
//                по умолчанию ""). Не сохраняется: живёт только на время вызова.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка: "" | "provisioning_disabled"),
//              Пользователь (Пользователь, Неопределено), Новая (Булево — создан ли новый).
//
Функция РазрешитьВход(Знач Издатель, Знач Субъект, Знач Профиль, Знач АвтоСоздание,
	Знач ТокенGitHub = "") Экспорт

	Существующий = СервисЛичностей.НайтиПользователяПоЛичности(Издатель, Субъект);
	Если Существующий <> Неопределено Тогда
		ПринятьПрофиль(Существующий, Издатель, Субъект, Профиль);
		РаздатьПраваПоGitHub(Существующий.Идентификатор, Профиль, ТокенGitHub);
		Возврат Результат(Истина, "", Существующий, Ложь);
	КонецЕсли;

	Если НЕ АвтоСоздание Тогда
		Возврат Результат(Ложь, "provisioning_disabled", Неопределено, Ложь);
	КонецЕсли;

	// адрес почты принадлежит одной учётке: молча завести вторую значило бы развести
	// письма хаба по двум адресатам, а восстановление пароля — по двум учёткам
	Если Адреса.Занят(ПригодныйEmail(ПолеСтруктуры(Профиль, "Email", ""))) Тогда
		Возврат Результат(Ложь, Адреса.ПричинаЗанят(), Неопределено, Ложь);
	КонецЕсли;

	Пользователь = ЗавестиПользователя(Издатель, Субъект, Профиль);
	РаздатьПраваПоGitHub(Пользователь.Идентификатор, Профиль, ТокенGitHub);
	Возврат Результат(Истина, "", Пользователь, Истина);

КонецФункции

// Ручная привязка провайдера из кабинета. Подтверждённый email не требуется — это
// осознанное действие самого вошедшего; занятую другим личность отклоняет СервисЛичностей.
//
// Параметры:
//  ПользовательИдентификатор - Число - инициатор, уже вошедший пользователь.
//  Издатель - Строка - issuer провайдера.
//  Субъект - Строка - sub из проверенных клеймов.
//  Профиль - Структура - Email, EmailПодтверждён, ПредпочтительныйЛогин (необязательный,
//            по умолчанию Неопределено — привязка без справочных данных провайдера).
//  ТокенGitHub - Строка - access-token GitHub для автовыдачи прав при ЗАВЕДЕНИИ личности;
//                пусто — привязка не GitHub-личности либо токена нет (необязательный,
//                по умолчанию ""). Не сохраняется: живёт только на время вызова.
//
// Возвращаемое значение:
//  ВнешняяЛичность - созданная или уже существующая привязка.
//
Функция ПривязатьВручную(Знач ПользовательИдентификатор, Знач Издатель, Знач Субъект,
	Знач Профиль = Неопределено, Знач ТокенGitHub = "") Экспорт

	// раздача идёт ровно на ЗАВЕДЕНИЕ личности: повторная привязка уже привязанной
	// её не повторяет. Отвязка и привязка заново заводят личность снова — и раздача
	// пройдёт снова, это осознанно: адресного отзыва у механизма нет
	Новая = (СервисЛичностей.НайтиЛичность(Издатель, Субъект) = Неопределено);
	Личность = СервисЛичностей.Привязать(ПользовательИдентификатор, Издатель, Субъект,
		ПолеСтруктуры(Профиль, "Email", ""),
		ПолеСтруктуры(Профиль, "ПредпочтительныйЛогин", ""));
	Если Новая Тогда
		РаздатьПраваПоGitHub(ПользовательИдентификатор, Профиль, ТокенGitHub);
	КонецЕсли;
	Возврат Личность;

КонецФункции

#Область СлужебныеПроцедурыИФункции

// Зовётся на КАЖДОМ входе через GitHub: у человека в организации могло прибавиться прав,
// и хаб их добирает. Вход при этом не ждёт ничего — раздача уходит в фон целиком.
// Токен провайдера дальше этого вызова не живёт: в поля не кладётся, в базу и в журнал
// не попадает. Без реализации автовыдачи (сборка без модуля публикация) прав не раздаётся.
Процедура РаздатьПраваПоGitHub(Знач ПользовательИдентификатор, Знач Профиль, Знач ТокенGitHub)

	Если Автовыдача = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ТокенGitHub) Тогда
		Возврат;
	КонецЕсли;
	Автовыдача.Раздать(ПользовательИдентификатор,
		ПолеСтруктуры(Профиль, "ПредпочтительныйЛогин", ""), ТокенGitHub);

КонецПроцедуры

// Данные свежего профиля в уже привязанную учётку и в саму личность.
Процедура ПринятьПрофиль(Знач Пользователь, Знач Издатель, Знач Субъект, Знач Профиль)

	Email = ПригодныйEmail(ПолеСтруктуры(Профиль, "Email", ""));
	ПринятьEmailПровайдера(Пользователь, Email, ПодтверждёнПровайдером(Профиль, Email));
	СервисЛичностей.АктуализироватьПрофиль(Издатель, Субъект, Email,
		ПолеСтруктуры(Профиль, "ПредпочтительныйЛогин", ""));

КонецПроцедуры

// Новый локальный пользователь без пароля — вход только через провайдера.
Функция ЗавестиПользователя(Знач Издатель, Знач Субъект, Знач Профиль)

	Email = ПригодныйEmail(ПолеСтруктуры(Профиль, "Email", ""));
	Предпочтительный = ПолеСтруктуры(Профиль, "ПредпочтительныйЛогин", "");
	Пользователь = СервисПользователей.СоздатьПользователя(
		ПодобратьЛогин(Предпочтительный, Email), Email, "", "user");
	Если ПодтверждёнПровайдером(Профиль, Email) Тогда
		Адреса.Подтвердить(Пользователь);
	КонецЕсли;
	СервисЛичностей.Привязать(Пользователь.Идентификатор, Издатель, Субъект, Email, Предпочтительный);
	Возврат Пользователь;

КонецФункции

// Флаг только поднимается: подтверждение хаба провайдер не отменяет.
Процедура ПринятьEmailПровайдера(Знач Пользователь, Знач Email, Знач EmailПодтверждён)

	Если НЕ ЗначениеЗаполнено(Email) Тогда
		Возврат;
	КонецЕсли;

	Текущий = ПригодныйEmail(Пользователь.Email);
	Если ПустаяСтрока(Текущий) Тогда
		// адрес мог оказаться занятым чужой учёткой — это не повод не пустить человека
		// в его собственную: вход продолжается, учётка остаётся без адреса
		Попытка
			Адреса.Сменить(Пользователь, Email);
		Исключение
			СообщитьОЗанятомАдресе(Пользователь, Email);
			Возврат;
		КонецПопытки;
	ИначеЕсли Текущий <> Email Тогда
		Возврат; // свой адрес человека провайдер не трогает
	КонецЕсли;

	Если EmailПодтверждён Тогда
		Адреса.Подтвердить(Пользователь);
	КонецЕсли;

КонецПроцедуры

Функция ПодтверждёнПровайдером(Знач Профиль, Знач Email)
	Возврат ЗначениеЗаполнено(Email)
		И (ПолеСтруктуры(Профиль, "EmailПодтверждён", Ложь) = Истина);
КонецФункции

// Мусор вместо адреса стоит адреса, а не входа: за содержимое клеймов отвечает провайдер.
Функция ПригодныйEmail(Знач Сырой)

	Попытка
		Возврат Нормализатор.НормализоватьEmail(Сырой);
	Исключение
		СообщитьОНепригодномАдресе(Сырой);
		Возврат "";
	КонецПопытки;

КонецФункции

// Занятость адреса — состояние хаба, а не действие человека: рассказываем оператору
// в лог, чужой логин при этом не называем.
Процедура СообщитьОЗанятомАдресе(Знач Пользователь, Знач Email)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Лог.Предупреждение("OIDC: адрес ""%1"" из профиля уже принадлежит другой учётной записи —"
		+ " в учётку ""%2"" он не записан, вход продолжен.",
		Строка(Email), Строка(Пользователь.Логин));

КонецПроцедуры

// Лог опционален: при сборке вне контейнера объяснять некому, а вход всё равно идёт.
Процедура СообщитьОНепригодномАдресе(Знач Сырой)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Лог.Предупреждение("OIDC: провайдер прислал непригодный адрес ""%1"" — в учётку он"
		+ " не записан, вход продолжен. Проверьте клейм email на стороне провайдера.",
		Строка(Сырой));

КонецПроцедуры

// Свободный логин из preferred_username / email (коллизия → числовой суффикс).
Функция ПодобратьЛогин(Знач Предпочтительный, Знач Email)

	База = СанитизироватьЛогин(Предпочтительный);
	Если ПустаяСтрока(База) Тогда
		База = СанитизироватьЛогин(ЛокальнаяЧастьEmail(Email));
	КонецЕсли;
	Если ПустаяСтрока(База) Тогда
		База = "user";
	КонецЕсли;

	// гарантируем минимальную длину логина (валидатор требует ≥ 2)
	Если СтрДлина(База) < 2 Тогда
		База = База + "0";
	КонецЕсли;

	Если СервисПользователей.НайтиПоЛогину(База) = Неопределено Тогда
		Возврат База;
	КонецЕсли;
	Суффикс = 2;
	Пока Суффикс < 100000 Цикл
		Кандидат = База + Формат(Суффикс, "ЧГ=0");
		Если СервисПользователей.НайтиПоЛогину(Кандидат) = Неопределено Тогда
			Возврат Кандидат;
		КонецЕсли;
		Суффикс = Суффикс + 1;
	КонецЦикла;
	// крайне маловероятно — уникализируем временем
	Возврат База + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0");

КонецФункции

// Оставляет только допустимые символы логина и обрезает ведущие не-буквенно-цифровые.
Функция СанитизироватьЛогин(Знач Источник)

	Норм = НРег(СокрЛП(Строка(Источник)));
	Разрешённые = "abcdefghijklmnopqrstuvwxyz0123456789._-";
	Результат = "";
	Для НомерСимвола = 1 По СтрДлина(Норм) Цикл
		Символ = Сред(Норм, НомерСимвола, 1);
		Если СтрНайти(Разрешённые, Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	// логин должен начинаться с буквы/цифры — срезаем ведущие . _ -
	Пока СтрДлина(Результат) > 0 И СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789", Лев(Результат, 1)) = 0 Цикл
		Результат = Сред(Результат, 2);
	КонецЦикла;
	Возврат Лев(Результат, 64);

КонецФункции

Функция ЛокальнаяЧастьEmail(Знач Email)
	Значение = СокрЛП(Строка(Email));
	Поз = СтрНайти(Значение, "@");
	Возврат ?(Поз > 0, Лев(Значение, Поз - 1), Значение);
КонецФункции

Функция ПолеСтруктуры(Знач Структура_, Знач Имя, Знач ПоУмолчанию)
	Значение = ПоУмолчанию;
	Если ТипЗнч(Структура_) = Тип("Структура") И Структура_.Свойство(Имя) Тогда
		Структура_.Свойство(Имя, Значение);
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция Результат(Знач Успех, Знач Причина, Знач Пользователь, Знач Новая)
	Возврат Новый Структура("Успех, Причина, Пользователь, Новая", Успех, Причина, Пользователь, Новая);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисЛичностей") _СервисЛичностей,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "АдресУчётки") _Адреса,
	&Пластилин(Значение = "НормализаторУчётки") _Нормализатор,
	&Пластилин(Значение = "АвтовыдачаПравGitHub") _Автовыдача = Неопределено,
	&Лог _Лог = Неопределено)

	СервисЛичностей = _СервисЛичностей;
	СервисПользователей = _СервисПользователей;
	Адреса = _Адреса;
	Нормализатор = _Нормализатор;
	Автовыдача = _Автовыдача;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
