// Закрыт ли провайдер входа посетителю этого запроса. Один вопрос на все двери входа:
// кнопка на странице, старт, возврат от провайдера и привязка в кабинете спрашивают его же.
//
// Не смог проверить — отказал: недоступная таблица правил и любой другой
// сбой здесь означают ОТКАЗ. Ответ «открыт» в перехвате был бы fail-open одной строкой.
// Несобранный механизм правил — не сбой, а инсталляция без геоправил: там вход работает
// как раньше, и спрашивать страну не у кого.

Перем Геоправило;    // ГеоправилоПровайдера (вход) — кому провайдер закрыт
Перем Определитель;  // ОпределительСтраны (гео) — из какой страны пришёл запрос
Перем Обезличивание; // ОбезличиваниеЖурнала (наблюдаемость) — адрес в журнале без хозяина
Перем Ошибки;        // ТекстОшибки (основа)
&Лог
Перем Лог;

Перем Отказов_;      // Число — сколько посетителей отбито за жизнь процесса
Перем Обращений_;    // Число — сколько раз спрашивали страну
Перем Названные_;    // Соответствие: провайдер -> Структура(Всего, ЗаОкно, Окно); подменяется целиком
Перем Часы;          // объект с методом Сейчас() -> Дата, либо Неопределено (системные часы)

#Область ТестовыеШвы

// Подставляет источник времени — тестовый шов; в рабочем контейнере не вызывается.
//
// Параметры:
//  ИсточникВремени - Произвольный - объект с методом Сейчас(), возвращающим Дату.
//
Процедура УстановитьЧасы(Знач ИсточникВремени) Экспорт
	Часы = ИсточникВремени;
КонецПроцедуры

#КонецОбласти

#Область ПубличныйИнтерфейс

// Закрыт ли этот провайдер этому посетителю. Каждый отказ пишется в журнал приложения
// и считается: журнал доступа геоправило не ведёт, но немым оно быть не вправе.
//
// Параметры:
//  ИмяПровайдера - Строка - имя провайдера; регистр не значим.
//  Посетитель - Структура, Неопределено - посетитель запроса (гео/ПосетительЗапроса);
//               Неопределено — о нём не известно ничего, и при живом правиле это
//               «страна неизвестна».
//
// Возвращаемое значение:
//  Структура - Закрыт (Булево), Страна (Строка — код либо пусто), Исход (Строка —
//              исход определителя либо «сбой»), Причина (Строка словами).
//
Функция Закрыт(Знач ИмяПровайдера, Знач Посетитель) Экспорт

	Попытка
		Возврат Решение(ИмяПровайдера, Посетитель);
	Исключение
		Сбой = Ошибки.Причина(ИнформацияОбОшибке());
	КонецПопытки;

	Пожаловаться(ИмяПровайдера, Сбой);
	Возврат Отбить(ИмяПровайдера, Посетитель, Сбойный(Сбой));

КонецФункции

// Провайдеры, которые этому посетителю вообще предлагаются. Кнопка и отказ спрашивают
// одно правило, поэтому закрытого провайдера человек не видит и в списке.
//
// Параметры:
//  Провайдеры - Массив из Структура - описания провайдеров действующей конфигурации.
//  Посетитель - Структура, Неопределено - посетитель запроса (гео/ПосетительЗапроса).
//
// Возвращаемое значение:
//  Массив из Структура - те же описания, оставшиеся открытыми; при сбое проверки —
//                        пустой массив.
//
Функция ПровайдерыДляПосетителя(Знач Провайдеры, Знач Посетитель) Экспорт

	Попытка
		Возврат Открытые(Провайдеры, Посетитель);
	Исключение
		Сбой = Ошибки.Причина(ИнформацияОбОшибке());
	КонецПопытки;

	Пожаловаться("*", Сбой);
	Возврат Новый Массив();

КонецФункции

// Сколько посетителей гейт отбил за жизнь процесса — это число снимает телеметрия.
//
// Возвращаемое значение:
//  Число.
//
&Наблюдаемый("metrics.login_geo_denied")
Функция Отказов() Экспорт
	Возврат Отказов_;
КонецФункции

// Сколько раз гейт спрашивал страну. Пока правил нет, значение не растёт: запрос,
// которому страна не нужна, за неё не платит.
//
// Возвращаемое значение:
//  Число.
//
Функция ОбращенийКОпределителю() Экспорт
	Возврат Обращений_;
КонецФункции

#КонецОбласти

#Область Решение

Функция Решение(Знач ИмяПровайдера, Знач Посетитель)

	Если НЕ ЕстьПравила() Тогда
		Возврат Открыт("", "", "правил по стране на хабе нет");
	КонецЕсли;

	Вердикт = Страна(Посетитель);
	Если Вердикт.Исход = Определитель.Исходы().НеНаблюдаемая Тогда
		Возврат Открыт("", Вердикт.Исход, Вердикт.Причина);
	КонецЕсли;

	Если НЕ Геоправило.Закрыт(ИмяПровайдера, Вердикт.Страна) Тогда
		Возврат Открыт(Вердикт.Страна, Вердикт.Исход, Вердикт.Причина);
	КонецЕсли;

	Возврат Отбить(ИмяПровайдера, Посетитель, Вердикт);

КонецФункции

Функция Открытые(Знач Провайдеры, Знач Посетитель)

	Если НЕ ЕстьПравила() Тогда
		Возврат Провайдеры;
	КонецЕсли;

	Вердикт = Страна(Посетитель);
	// «адрес публичный, но не из наблюдаемых стран» — это ответ, а не молчание: такому
	// посетителю закрывать нечего, и список остаётся прежним
	Если Вердикт.Исход = Определитель.Исходы().НеНаблюдаемая Тогда
		Возврат Провайдеры;
	КонецЕсли;

	Результат = Новый Массив();
	Для Каждого Провайдер Из Провайдеры Цикл
		Если НЕ Геоправило.Закрыт(Провайдер.Имя, Вердикт.Страна) Тогда
			Результат.Добавить(Провайдер);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Несобранный механизм правил — это инсталляция, на которой правил не существует вовсе,
// а не сломанная проверка: вход работает как до этой истории. Сломанная проверка — это
// когда правила есть, и её исход разбирает Закрыт().
Функция ЕстьПравила()
	Возврат Геоправило <> Неопределено И Геоправило.ЕстьПравила();
КонецФункции

// Страна спрашивается только тогда, когда её есть кому спросить, и каждый такой вопрос
// считается: сторож «без правил определитель не зовётся» смотрит на это число.
Функция Страна(Знач Посетитель)

	Если Определитель = Неопределено Тогда
		ВызватьИсключение "ГейтВходаПоСтране собран без определителя страны: правила есть,"
			+ " а проверить их нечем";
	КонецЕсли;

	Обращений_ = Обращений_ + 1;

	Если Посетитель = Неопределено Тогда
		Возврат Неизвестна("о посетителе запроса не известно ничего");
	КонецЕсли;

	Возврат Определитель.ОпределитьПоЗапросу(Посетитель.Адрес, Посетитель.Заголовки);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отказ считается и называется в журнале приложения: журналом аудита он не является
// (аудит — журнал мутаций), но следа после себя не оставлять не вправе.
//
// Отбитых посетителей бывает столько же, сколько запросов, поэтому журнал говорит тремя
// уровнями: ПЕРВЫЙ отказ провайдера — предупреждением («начал отсекать»), каждый
// следующий — отладкой, и не чаще раза в окно — предупреждение-сводка с числами.
// Без сводки оператор с уровнем по умолчанию не узнал бы, что отсечение продолжается.
Функция Отбить(Знач ИмяПровайдера, Знач Посетитель, Знач Вердикт)

	Отказов_ = Отказов_ + 1;

	Если Лог = Неопределено Тогда
		Возврат НовыйВердикт(Истина, Вердикт.Страна, Вердикт.Исход, Вердикт.Причина);
	КонецЕсли;

	Счёт = Отметить(ИмяПровайдера);
	Сообщение = СтрШаблон(
		"Вход через провайдера ""%1"" закрыт правилом по стране: исход ""%2"", адрес %3",
		Строка(ИмяПровайдера), Вердикт.Исход, Адрес(Посетитель));

	Если Счёт.Первый Тогда
		Лог.Предупреждение(Сообщение);
	Иначе
		Лог.Отладка(Сообщение);
	КонецЕсли;

	Если Счёт.Сводка Тогда
		Лог.Предупреждение(
			"Вход через провайдера ""%1"" закрыт правилом по стране: за последние %2 мин"
			+ " отбито %3 посетителей (всего за жизнь процесса %4)",
			Строка(ИмяПровайдера), Числом(Счёт.Минут), Числом(Счёт.ЗаОкно),
			Числом(Счёт.Всего));
	КонецЕсли;

	Возврат НовыйВердикт(Истина, Вердикт.Страна, Вердикт.Исход, Вердикт.Причина);

КонецФункции

// Память процесса публикуется подменой ссылки: новое Соответствие собирается из прежнего
// и присваивается полю целиком. Поток запроса читает либо старую карту, либо новую, но
// никогда — правленную на месте. Потерянная гонкой пометка стоит одной лишней строки
// журнала: счёт отказов ведёт не она, а Отказов_ и телеметрия.
Функция Отметить(Знач ИмяПровайдера)

	Ключ = НРег(СокрЛП(Строка(ИмяПровайдера)));
	Прежние = Названные_;
	Прежняя = Прежние.Получить(Ключ);
	Сейчас = Сейчас();

	Если Прежняя = Неопределено Тогда
		Опубликовать(Прежние, Ключ, ПамятьПровайдера(1, 0, Сейчас));
		Возврат Счёт(Истина, Ложь, 0, 1, 0);
	КонецЕсли;

	Всего = Прежняя.Всего + 1;
	ЗаОкно = Прежняя.ЗаОкно + 1;
	Прошло = Сейчас - Прежняя.Окно;
	Пора = Прошло >= ОкноСводкиСек();

	Опубликовать(Прежние, Ключ, ПамятьПровайдера(Всего, ?(Пора, 0, ЗаОкно),
		?(Пора, Сейчас, Прежняя.Окно)));

	Возврат Счёт(Ложь, Пора, ЗаОкно, Всего, Цел(Прошло / 60));

КонецФункции

Процедура Опубликовать(Знач Прежние, Знач Ключ, Знач Память)

	Свежие = Новый Соответствие();
	Для Каждого КиЗ Из Прежние Цикл
		Свежие.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Свежие.Вставить(Ключ, Память);

	Названные_ = Свежие;

КонецПроцедуры

Функция ПамятьПровайдера(Знач Всего, Знач ЗаОкно, Знач Окно)
	Возврат Новый Структура("Всего, ЗаОкно, Окно", Всего, ЗаОкно, Окно);
КонецФункции

Функция Счёт(Знач Первый, Знач Сводка, Знач ЗаОкно, Знач Всего, Знач Минут)
	Возврат Новый Структура("Первый, Сводка, ЗаОкно, Всего, Минут",
		Первый, Сводка, ЗаОкно, Всего, Минут);
КонецФункции

// Как часто провайдер напоминает о себе сводкой. Реже — и оператор час не узнаёт, что
// вход закрыт; чаще — и предупреждения снова становятся шумом.
Функция ОкноСводкиСек()
	Возврат 600;
КонецФункции

Функция Сейчас()
	Возврат ?(Часы = Неопределено, ТекущаяУниверсальнаяДата(), Часы.Сейчас());
КонецФункции

Функция Числом(Знач Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=");
КонецФункции

Процедура Пожаловаться(Знач ИмяПровайдера, Знач Сбой)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Лог.Ошибка(
		"Правило по стране для провайдера ""%1"" не проверено — закрываю вход: %2",
		Строка(ИмяПровайдера), Сбой);

КонецПроцедуры

Функция Адрес(Знач Посетитель)
	Возврат Обезличивание.АдресКлиента(?(Посетитель = Неопределено, "", Посетитель.Адрес));
КонецФункции

Функция Открыт(Знач Код, Знач Исход, Знач Причина)
	Возврат НовыйВердикт(Ложь, Код, Исход, Причина);
КонецФункции

Функция Неизвестна(Знач Причина)
	Возврат НовыйВердикт(Ложь, "", Определитель.Исходы().Неизвестна, Причина);
КонецФункции

Функция Сбойный(Знач Причина)
	Возврат НовыйВердикт(Истина, "", ИсходСбой(), Причина);
КонецФункции

// Исход, которого у определителя нет: проверка не состоялась вовсе.
Функция ИсходСбой()
	Возврат "сбой";
КонецФункции

Функция НовыйВердикт(Знач Закрыт, Знач Код, Знач Исход, Знач Причина)
	Возврат Новый Структура("Закрыт, Страна, Исход, Причина",
		Закрыт, Строка(Код), Строка(Исход), Строка(Причина));
КонецФункции

#КонецОбласти

&Прозвище("ГейтВходаПоСтране")
&Желудь
&Наблюдаемый
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГеоправилоПровайдера") _Геоправило = Неопределено,
	&Пластилин(Значение = "ОпределительСтраны") _Определитель = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Геоправило = _Геоправило;
	Определитель = _Определитель;
	Обезличивание = Новый ОбезличиваниеЖурнала();
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

	Отказов_ = 0;
	Обращений_ = 0;
	Названные_ = Новый Соответствие();

КонецПроцедуры
