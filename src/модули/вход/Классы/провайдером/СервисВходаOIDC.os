// Хабовая часть входа через провайдера: политика автосоздания, привязка личности
// и синхронизация групп. Протокол держит библиотека, HTTP-объектов winow здесь нет.

Перем Конфигурация;              // КонфигурацияOIDC (oidc)
Перем СервисАвтопривязки;        // СервисАвтопривязки (auth)
Перем СервисСопоставленийГрупп;  // СервисСопоставленийГрупп (auth)
Перем Издатели;                  // ИздателиOAuth2 (oidc) — опознание входа через GitHub
Перем ГейтВходаПоСтране;         // ГейтВходаПоСтране (oidc) — закрыт ли провайдер посетителю
Перем Лог;
Перем Вердикты;                  // Вердикт (основа) — форма ответа

#Область ПубличныйИнтерфейс

// Код исхода «провайдер закрыт посетителю правилом по стране». Регистрация и вход идут
// одной дорогой, поэтому код у них общий — и у привязки в кабинете тоже.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаЗакрытаСтрана() Экспорт
	Возврат "geo_denied";
КонецФункции

// Начинает вход: генерирует PKCE, state и nonce и строит адрес авторизации. Транзакцию
// вызывающий обязан положить в серверное хранилище, а браузер увести на её адрес.
//
// Параметры:
//  ИмяПровайдера - Строка - имя настроенного провайдера.
//  Посетитель - Структура, Неопределено - посетитель запроса (ГейтВходаПоСтране.Посетитель);
//               Неопределено — о посетителе не известно ничего (необязательный).
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка: "" | geo_denied), URL (Строка),
//              Транзакция (Соответствие, Неопределено); ненастроенный провайдер —
//              исключение: это поломка конфигурации, а не исход входа.
//
&Наблюдаемый
Функция Начать(Знач ИмяПровайдера, Знач Посетитель = Неопределено) Экспорт

	Вход = Конфигурация.Вход(ИмяПровайдера);
	Если Вход = Неопределено Тогда
		ВызватьИсключение СтрШаблон("СервисВходаOIDC: провайдер ""%1"" не настроен",
			Строка(ИмяПровайдера));
	КонецЕсли;

	Если ЗакрытПосетителю(ИмяПровайдера, Посетитель) Тогда
		Возврат НачалоОтбито();
	КонецЕсли;

	Начало = Вход.Начать();
	Возврат Вердикты.Успех(Новый Структура("URL, Транзакция",
		Начало.URL, Начало.Транзакция));

КонецФункции

// Завершает вход по возврату от провайдера: обмен кода и проверки делает библиотека,
// здесь — привязка личности, автосоздание учётки и синхронизация групп.
// Сессию не создаёт.
//
// Параметры:
//  Транзакция - Соответствие - транзакция из серверного хранилища; провайдера называет она.
//  Код - Строка - authorization code из редиректа.
//  Состояние - Строка - state из запроса; сверяется библиотекой с транзакцией.
//  ПривязкаКПользователю - Число - идентификатор пользователя для ручной привязки,
//                          0 — обычный вход (необязательный, по умолчанию 0).
//  Посетитель - Структура, Неопределено - посетитель запроса (ГейтВходаПоСтране.Посетитель);
//               Неопределено — о посетителе не известно ничего (необязательный).
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка: "" | state_mismatch | unknown_provider |
//              exchange_failed | id_token_invalid | no_subject | provisioning_disabled |
//              identity_taken | geo_denied), Пользователь (Пользователь, Неопределено),
//              Новая (Булево — создан ли новый пользователь).
//
&Наблюдаемый
Функция Завершить(Знач Транзакция, Знач Код, Знач Состояние,
	Знач ПривязкаКПользователю = 0, Знач Посетитель = Неопределено) Экспорт

	ИмяПровайдера = ПровайдерТранзакции(Транзакция);
	Вход = Конфигурация.Вход(ИмяПровайдера);
	Если Вход = Неопределено Тогда
		Лог.Отладка("Возврат OIDC: провайдера ""%1"" из транзакции в конфигурации нет",
			ИмяПровайдера);
		Возврат Отказ("unknown_provider");
	КонецЕсли;

	// правило судится ДО обмена кода: закрытому посетителю у провайдера делать нечего,
	// и прямой заход на адрес возврата проходит той же дверью, что и старт
	Если ЗакрытПосетителю(ИмяПровайдера, Посетитель) Тогда
		Возврат Отказ(ПричинаЗакрытаСтрана());
	КонецЕсли;

	Итог = Вход.Завершить(Транзакция, Код, Состояние);
	Если НЕ Итог.Успех Тогда
		Лог.Отладка("Возврат OIDC ""%1"": протокольная часть отказала, причина %2",
			ИмяПровайдера, Итог.Причина);
		Возврат Отказ(Итог.Причина);
	КонецЕсли;

	// провайдер уже разрешён библиотекой, здесь он нужен только за политиками хаба
	Провайдер = Конфигурация.Провайдер(ИмяПровайдера);
	Профиль = ПрофильВхода(Итог);
	// токен провайдера дальше вызова не живёт: ни в профиле, ни в полях, ни в базе
	ТокенGitHub = ТокенGitHub(Итог);

	Если ПривязкаКПользователю > 0 Тогда
		Попытка
			СервисАвтопривязки.ПривязатьВручную(ПривязкаКПользователю, Итог.Издатель, Итог.Субъект,
				Профиль, ТокенGitHub);
		Исключение
			Возврат Отказ("identity_taken");
		КонецПопытки;
		// при ручной привязке провижининг не подключаем (Неопределено передаётся явно):
		// пользователь связывает свою учётку, а не входит через IdP
		Если КлеймамМожноВерить(Итог, ИмяПровайдера) Тогда
			СервисСопоставленийГрупп.СинхронизироватьЧленство(
				ПривязкаКПользователю, Итог.Издатель, Итог.Клеймы, Неопределено);
		КонецЕсли;
		Возврат Успех(Неопределено, Ложь); // пользователь и так известен вызывающему
	КонецЕсли;

	Результат = СервисАвтопривязки.РазрешитьВход(
		Итог.Издатель, Итог.Субъект, Профиль, Провайдер.АвтоСоздание, ТокенGitHub);
	Если НЕ Результат.Успех Тогда
		Лог.Отладка("Возврат OIDC ""%1"": протокол прошёл, отказал хаб — %2"
			+ " (автосоздание учёток: %3)",
			ИмяПровайдера, Результат.Причина, Провайдер.АвтоСоздание);
		Возврат Отказ(Результат.Причина);
	КонецЕсли;

	Лог.Отладка("Возврат OIDC ""%1"": вход принят, пользователь #%2, учётка заведена сейчас: %3",
		ИмяПровайдера, Результат.Пользователь.Идентификатор, Результат.Новая);

	// провайдер передаётся целиком: от его флагов зависят провижининг и связка по имени
	Если КлеймамМожноВерить(Итог, ИмяПровайдера) Тогда
		СервисСопоставленийГрупп.СинхронизироватьЧленство(
			Результат.Пользователь.Идентификатор, Итог.Издатель, Итог.Клеймы, Провайдер);
	КонецЕсли;

	Возврат Успех(Результат.Пользователь, Результат.Новая);

КонецФункции

// Допустима ли синхронизация групп по клеймам этого входа. Чистый предикат, проверяется
// тестом напрямую; от наличия лога поведение не зависит.
//
// Параметры:
//  Итог - Структура - исход завершения потока входа.
//
// Возвращаемое значение:
//  Булево - Истина, только если исход явно сообщает ПрофильПолучен = Истина.
//
Функция СинхронизацияГруппДопустима(Знач Итог) Экспорт

	Если ТипЗнч(Итог) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	ПрофильПолучен = Ложь;
	Итог.Свойство("ПрофильПолучен", ПрофильПолучен);

	// спрашиваем и тип, и значение: в OneScript `1 = Истина`, и проверка «= Истина»
	// пропустила бы число 1 или строку, то есть контракт «ровно Булево» не держался бы
	Возврат ТипЗнч(ПрофильПолучен) = Тип("Булево") И ПрофильПолучен;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Единственная дверь к правилу по стране: и старт, и возврат спрашивают её. Несобранный
// гейт означает, что механизма правил на инсталляции нет вовсе, — вход работает как
// раньше; сам гейт, не сумевший проверить правило, отвечает «закрыт».
Функция ЗакрытПосетителю(Знач ИмяПровайдера, Знач Посетитель)

	Если ГейтВходаПоСтране = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ГейтВходаПоСтране.Закрыт(ИмяПровайдера, Посетитель).Закрыт;

КонецФункции

// Default-closed: деградировавший ответ провайдера иначе отобрал бы все группы разом.
Функция КлеймамМожноВерить(Знач Итог, Знач ИмяПровайдера)

	Если СинхронизацияГруппДопустима(Итог) Тогда
		Возврат Истина;
	КонецЕсли;

	Лог.Предупреждение(
		"OIDC-провайдер <%1>: userinfo не ответил (деградация профиля) — синхронизация групп"
		+ " ПРОПУЩЕНА. Состав групп пользователя оставлен как есть: клеймы id_token обычно"
		+ " не содержат групп, и синхронизация по ним сняла бы с пользователя ВСЕ его"
		+ " OIDC-членства из-за одного неудачного ответа провайдера. Группы обновятся на"
		+ " следующем входе, когда профиль будет получен.",
		ИмяПровайдера);

	Возврат Ложь;

КонецФункции

// Сравнение точное, а не «издатель из пространства OAuth2»: иначе чужой токен уехал бы в GitHub.
Функция ТокенGitHub(Знач Итог)

	Если Издатели = Неопределено ИЛИ СокрЛП(Строка(Итог.Издатель)) <> Издатели.ИздательGitHub() Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Итог.Токены) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Значение = Итог.Токены.Получить("access_token");
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));

КонецФункции

Функция ПрофильВхода(Знач Итог)
	Профиль = Новый Структура();
	Профиль.Вставить("Email", Итог.Email);
	Профиль.Вставить("EmailПодтверждён", Итог.EmailПодтверждён);
	Профиль.Вставить("ПредпочтительныйЛогин", ЗначениеКлейма(Итог.Клеймы, "preferred_username"));
	Возврат Профиль;
КонецФункции

Функция ЗначениеКлейма(Знач Клеймы, Знач Имя)
	Значение = Клеймы.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

// Провайдера называет сама транзакция; битая даёт пустое имя и отказ unknown_provider.
Функция ПровайдерТранзакции(Знач Транзакция)
	Если ТипЗнч(Транзакция) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Значение = Транзакция.Получить("Провайдер");
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
КонецФункции

Функция Отказ(Знач Причина)
	Возврат Вердикты.Отказ(Причина, Новый Структура("Пользователь, Новая", Неопределено, Ложь));
КонецФункции

Функция НачалоОтбито()
	Возврат Вердикты.Отказ(ПричинаЗакрытаСтрана(),
		Новый Структура("URL, Транзакция", "", Неопределено));
КонецФункции

Функция Успех(Знач Пользователь, Знач Новая)
	Возврат Вердикты.Успех(Новый Структура("Пользователь, Новая", Пользователь, Новая));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КонфигурацияOIDC") _Конфигурация,
	&Пластилин(Значение = "СервисАвтопривязки") _СервисАвтопривязки,
	&Пластилин(Значение = "СервисСопоставленийГрупп") _СервисСопоставленийГрупп,
	&Пластилин(Значение = "ИздателиOAuth2") _Издатели = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "Вердикт") _Вердикты = Неопределено,
	&Пластилин(Значение = "ГейтВходаПоСтране") _ГейтВходаПоСтране = Неопределено)

	Вердикты = ?(_Вердикты = Неопределено, Новый Вердикт(), _Вердикты);
	Конфигурация = _Конфигурация;
	СервисАвтопривязки = _СервисАвтопривязки;
	СервисСопоставленийГрупп = _СервисСопоставленийГрупп;
	Издатели = _Издатели;
	ГейтВходаПоСтране = _ГейтВходаПоСтране;
	// Лог параметром: инъекция в поле доезжает только после конструктора, а объяснять
	// пропуск синхронизации групп надо уже в нём. Отсутствие лога — поломка сборки.
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "СервисВходаOIDC создан без лога — создатель обязан передать свой лог";
	КонецЕсли;
	Лог = _Лог;

КонецПроцедуры
