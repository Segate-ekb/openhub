// Синтетические издатели OAuth2-провайдеров. Протокол OAuth2 издателя не сообщает, а хабу
// он нужен как половина ключа внешней личности. Формат «oauth2:<ключ>» выбран за три
// свойства: он не URL (ветка oidc требует https, поэтому подделать издателя пресета оттуда
// нельзя), он не зависит от имени строки в базе (иначе переименование провайдера обнулило
// бы все привязки) и он стабилен во времени — менять его нельзя никогда.

#Область ПубличныйИнтерфейс

// Синтетический издатель для OAuth2-провайдера. Пустой ключ — исключение.
//
// Параметры:
//  Ключ - Строка - ключ пресета либо хост конечной точки авторизации.
//
// Возвращаемое значение:
//  Строка - издатель вида "oauth2:<ключ>".
//
Функция Значение_(Знач Ключ) Экспорт

	Норм = Нормализовать(Ключ);
	Если НЕ ЗначениеЗаполнено(Норм) Тогда
		ВызватьИсключение "ИздателиOAuth2: синтетический издатель требует непустого ключа";
	КонецЕсли;
	Возврат Префикс() + Норм;

КонецФункции

// Префикс пространства синтетических издателей. По нему валидатор адресов запрещает
// ветке oidc заходить в это пространство — второй копии литерала быть не должно.
//
// Возвращаемое значение:
//  Строка.
//
Функция Префикс() Экспорт
	Возврат "oauth2:";
КонецФункции

// Издатель личностей GitHub. Спрашивается там, где решение зависит именно от GitHub,
// а не от «какого-нибудь OAuth2»: токен одного провайдера не должен уехать в API другого.
//
// Возвращаемое значение:
//  Строка - издатель пресета GitHub.
//
Функция ИздательGitHub() Экспорт
	Возврат Значение_("github");
КонецФункции

// Принадлежит ли издатель пространству синтетических.
//
// Параметры:
//  Издатель - Строка - проверяемый издатель.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоСинтетический(Знач Издатель) Экспорт
	Возврат Лев(Нормализовать(Издатель), СтрДлина(Префикс())) = Префикс();
КонецФункции

// Синтетический издатель для OAuth2-провайдера, заведённого вручную: ключом служит хост
// конечной точки авторизации — куда пользователь на самом деле ходит, а не как строку
// назвали в базе. Хост без схемы и хост, совпавший с ключом пресета, — исключение.
//
// Параметры:
//  АдресАвторизации - Строка - конечная точка авторизации провайдера.
//
// Возвращаемое значение:
//  Строка - издатель вида "oauth2:<хост>".
//
Функция ИздательПоАдресуАвторизации(Знач АдресАвторизации, Знач ЗанятыеКлючи) Экспорт

	Хост = ХостАдреса(АдресАвторизации);
	Если НЕ ЗначениеЗаполнено(Хост) Тогда
		ВызватьИсключение "ИздателиOAuth2: не удалось определить хост конечной точки авторизации —"
			+ " синтетический издатель OAuth2-провайдера строится по нему";
	КонецЕсли;

	// Второй замок, рядом с формулой издателя: хост, совпавший с ключом пресета, дал бы
	// ручному провайдеру ключ «издатель + субъект» настоящих личностей пресета.
	Если ЗанятыеКлючи.Найти(Хост) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"ИздателиOAuth2: хост ""%1"" занят пресетом того же имени — синтетический издатель"
			+ " ""%2"" принадлежит ему, и ручной провайдер получил бы личности его"
			+ " пользователей. Заведите провайдера пресетом.", Хост, Значение_(Хост));
	КонецЕсли;

	Возврат Значение_(Хост);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Хост из URL без схемы, userinfo и порта.
Функция ХостАдреса(Знач Адрес)

	Значение = Нормализовать(Адрес);
	Позиция = Найти(Значение, "://");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(Значение, Позиция + 3);
	Для Каждого Разделитель Из СтрРазделить("/,?,#", ",") Цикл
		П = Найти(Остаток, Разделитель);
		Если П > 0 Тогда
			Остаток = Лев(Остаток, П - 1);
		КонецЕсли;
	КонецЦикла;

	П = Найти(Остаток, "@");
	Если П > 0 Тогда
		Остаток = Сред(Остаток, П + 1);
	КонецЕсли;

	Если Лев(Остаток, 1) = "[" Тогда
		Закрытие = Найти(Остаток, "]");
		Возврат ?(Закрытие > 0, Сред(Остаток, 2, Закрытие - 2), "");
	КонецЕсли;

	ПортП = СтрНайти(Остаток, ":", НаправлениеПоиска.СКонца);
	Если ПортП > 0 Тогда
		Остаток = Лев(Остаток, ПортП - 1);
	КонецЕсли;
	Возврат СокрЛП(Остаток);

КонецФункции

Функция Нормализовать(Знач Значение)
	Возврат НРег(СокрЛП(Строка(Значение)));
КонецФункции

#КонецОбласти

&Прозвище("ИздателиOAuth2")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
