// Значок провайдера входа — имя значка-бренда кита «бренд:<ключ>» из закрытого списка значков
// кита; пусто — значок выбирает экран по издателю и типу провайдера.

Перем Раскладка; // РаскладкаСтатики (кит) — закрытый список ключей значков-брендов

#Область ПубличныйИнтерфейс

// Значок к хранимому виду. Прежний вид — голый ключ значка (github, key) — читается: ключ
// бренда становится его именем, общий ключ key — пустым значком (значок по издателю).
//
// Параметры:
//  Значение - Произвольный - значок из формы, строки базы или конфигурации инсталляции.
//
// Возвращаемое значение:
//  Строка - «бренд:<ключ>» либо "" — значок не задан или незнаком.
//
Функция Нормализовать(Знач Значение) Экспорт

	Норм = Приведённое(Значение);
	Если СтрНачинаетсяС(Норм, ПриставкаБренда()) Тогда
		Ключ = Сред(Норм, СтрДлина(ПриставкаБренда()) + 1);
	ИначеЕсли Норм = ПрежнийОбщийКлюч() Тогда
		Возврат "";
	Иначе
		Ключ = Норм;
	КонецЕсли;
	Возврат ?(Раскладка.КлючиЗначков().Найти(Ключ) = Неопределено, "", ПриставкаБренда() + Ключ);

КонецФункции

// Знаком ли значок: пустой, имя бренда кита или прежний ключ значка.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//  Булево
//
Функция Допустим(Знач Значение) Экспорт

	Норм = Приведённое(Значение);
	Возврат ПустаяСтрока(Норм) ИЛИ Норм = ПрежнийОбщийКлюч() ИЛИ ЗначениеЗаполнено(Нормализовать(Норм));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Приведённое(Знач Значение)
	Возврат НРег(СокрЛП(?(Значение = Неопределено, "", Строка(Значение))));
КонецФункции

Функция ПриставкаБренда()
	Возврат "бренд:";
КонецФункции

// До выбора значка сеткой кита (2026-10-13) поле хранило голый ключ файла значка, и key был
// умолчанием своего провайдера — «значок не выбран».
Функция ПрежнийОбщийКлюч()
	Возврат "key";
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "РаскладкаСтатики") _Раскладка) Экспорт
	Раскладка = _Раскладка;
КонецПроцедуры
