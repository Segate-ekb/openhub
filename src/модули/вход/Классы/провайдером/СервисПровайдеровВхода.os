// Единственная точка мутации таблицы провайдеров входа: форма администратора,
// инструменты и тесты проходят здесь.
//
// Мутации принимают принципала (кто пришёл и как), а не пользователя: сигнатуры другой
// формы нет, поэтому забыть рамки ключа нельзя. Порядок проверок — аноним, рамки ключа
// (fail-closed), запрет ключу целиком, админ хаба. Ключ не управляет провайдерами по
// способу обращения, а не по скоупу: заведя провайдера с автосозданием, ключ вошёл бы
// через него человеком и получил сессию вообще без рамок.
//
// Секрет клиента хранится обратимо (его предъявляют token endpoint), но наружу не выходит
// никогда: карточка и аудит отдают маску.

Перем Хранилище;     // ХранилищеПровайдеровВхода (данные)
Перем Конфигурация;  // КонфигурацияOIDC (oidc)
Перем Разбор_;       // РазборПровайдераВхода (oidc)
Перем ГейтКлюча;     // ГейтТокена (auth); Неопределено — fail-closed для запросов с ключом
Перем Перехватчик;   // ПерехватчикАутентификации (auth)
Перем СервисПрав;    // СервисПрав (auth)
Перем Издатель;      // ИздательСобытий (события) — аудит
Перем ИменаЖурнала;  // ИмяОбъектаАудита (аудит) — вид объекта в журнале
Перем Тексты;        // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Маска секрета в открытых представлениях.
//
// Возвращаемое значение:
//  Строка.
//
Функция МаскаСекрета() Экспорт
	Возврат Разбор_.МаскаСекрета();
КонецФункции

// Карточки провайдеров для витрины админки: значения без секрета и источник значения.
//
// Возвращаемое значение:
//  Массив из Структура - поля провайдера, СекретЗадан (Булево), Секрет (маска),
//                        Перекрыт (Булево), Источник (Строка), Редактируемая (Булево).
//
Функция Карточки() Экспорт

	Результат = Новый Массив();
	Для Каждого Запись Из Хранилище.Все() Цикл
		Результат.Добавить(Карточка(Запись));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Все инсталляции провайдеров: строки базы плюс те, что объявлены только конфигурацией.
// Провайдер, которого нет в базе, иначе не виден администратору вовсе, а он работает.
//
// Возвращаемое значение:
//  Массив из Структура - карточки; у объявленных конфигурацией Редактируемая = Ложь.
//
Функция Инсталляции() Экспорт

	Результат = Новый Массив();
	Известные = Новый Соответствие();

	Для Каждого Запись Из Хранилище.Все() Цикл
		Карточка = Карточка(Запись);
		Известные.Вставить(НРег(Карточка.Имя), Истина);
		Результат.Добавить(Карточка);
	КонецЦикла;

	Для Каждого Провайдер Из Конфигурация.Провайдеры() Цикл
		Имя = НРег(СокрЛП(Строка(Провайдер.Имя)));
		Если Известные.Получить(Имя) = Неопределено Тогда
			Результат.Добавить(КарточкаКонфигурации(Провайдер));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Карточка одного провайдера базы.
//
// Параметры:
//  Имя - Строка - имя провайдера.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если строки нет.
//
Функция КарточкаПоИмени(Знач Имя) Экспорт

	Запись = Хранилище.НайтиПоИмени(Имя);
	Возврат ?(Запись = Неопределено, Неопределено, Карточка(Запись));

КонецФункции

// Заводит провайдера входа. Занятое имя — отказ; отказ по правам пишется в аудит.
//
// Параметры:
//  Принципал - Структура - принципал запроса.
//  Данные - Структура - поля формы заведения.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число — HTTP-статус), Ошибка (Строка), Имя (Строка).
//
Функция Завести(Знач Принципал, Знач Данные) Экспорт

	Вердикт = ПроверитьПраво(Принципал, "создание");
	Если НЕ Вердикт.Успех Тогда
		ЗаписатьОтказВАудит("создание", ПолеСтруктуры(Данные, "Имя", ""), Вердикт, Принципал);
		Возврат Вердикт;
	КонецЕсли;

	Разбор = Разбор_.ДляСоздания(Данные);
	Если НЕ Разбор.Успех Тогда
		Возврат Разбор;
	КонецЕсли;

	Если Хранилище.НайтиПоИмени(Разбор.Имя) <> Неопределено Тогда
		Возврат Отказ(400, Тексты.Шаблон("providers.error.name.taken", Разбор.Имя));
	КонецЕсли;

	Запись = Хранилище.СоздатьЗапись(Разбор.Имя);
	Записать(Запись, Разбор, Принципал);
	ЗаписатьВАудит("провайдер.заведён", Разбор, Принципал);
	Возврат Успех(Разбор.Имя);

КонецФункции

// Изменяет существующего провайдера; пустое поле секрета означает «оставить прежний».
// Переименование не поддерживается: имя — половина адреса входа и ключ перекрытия
// окружением. Перекрытая окружением строка правке не подлежит.
//
// Параметры:
//  Принципал - Структура - принципал запроса.
//  Имя - Строка - имя изменяемого провайдера.
//  Данные - Структура - изменяемые поля формы.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Ошибка (Строка), Имя (Строка).
//
Функция Изменить(Знач Принципал, Знач Имя, Знач Данные) Экспорт

	Вердикт = ПроверитьПраво(Принципал, "изменение");
	Если НЕ Вердикт.Успех Тогда
		ЗаписатьОтказВАудит("изменение", Имя, Вердикт, Принципал);
		Возврат Вердикт;
	КонецЕсли;

	Запись = Хранилище.НайтиПоИмени(Имя);
	Если Запись = Неопределено Тогда
		Возврат Отказ(404, Тексты.Шаблон("providers.error.notfound", Строка(Имя)));
	КонецЕсли;

	Перекрытие = ПроверитьПерекрытие(Запись.Имя);
	Если НЕ Перекрытие.Успех Тогда
		Возврат Перекрытие;
	КонецЕсли;

	// имя в теле формы, отличное от имени в адресе, — попытка править не тот провайдер;
	// разбор его и так не читает, проверка нужна ради внятного отказа
	ИмяИзФормы = Разбор_.НормализованноеИмя(ПолеСтруктуры(Данные, "Имя", Запись.Имя));
	Если ЗначениеЗаполнено(ИмяИзФормы) И ИмяИзФормы <> Хранилище.НормализованноеИмя(Имя) Тогда
		Возврат Отказ(400, Тексты.Текст("providers.error.rename"));
	КонецЕсли;

	Разбор = Разбор_.ДляПравки(Данные, Запись);
	Если НЕ Разбор.Успех Тогда
		Возврат Разбор;
	КонецЕсли;

	Записать(Запись, Разбор, Принципал);
	ЗаписатьВАудит("провайдер.изменён", Разбор, Принципал);
	Возврат Успех(Разбор.Имя);

КонецФункции

// Включает или выключает провайдера: вместе с ним появляется и исчезает кнопка входа,
// а выключенный провайдер не принимает и возврат от IdP.
//
// Параметры:
//  Принципал - Структура - принципал запроса.
//  Имя - Строка - имя провайдера.
//  Включён - Булево - новое состояние.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Ошибка (Строка), Имя (Строка).
//
Функция Переключить(Знач Принципал, Знач Имя, Знач Включён) Экспорт

	Вердикт = ПроверитьПраво(Принципал, "изменение");
	Если НЕ Вердикт.Успех Тогда
		ЗаписатьОтказВАудит("переключение", Имя, Вердикт, Принципал);
		Возврат Вердикт;
	КонецЕсли;

	Запись = Хранилище.НайтиПоИмени(Имя);
	Если Запись = Неопределено Тогда
		Возврат Отказ(404, Тексты.Шаблон("providers.error.notfound", Строка(Имя)));
	КонецЕсли;

	Перекрытие = ПроверитьПерекрытие(Запись.Имя);
	Если НЕ Перекрытие.Успех Тогда
		Возврат Перекрытие;
	КонецЕсли;

	Запись.Включён = (Включён = Истина);
	Хранилище.Записать(Запись, Логин(Принципал), ТекущаяУниверсальнаяДата());
	Конфигурация.Перечитать();

	Детали = Новый Структура("Имя, Включён", Строка(Запись.Имя), Запись.Включён);
	ЗаписатьВАудитДетали(?(Запись.Включён, "провайдер.включён", "провайдер.выключен"),
		Строка(Запись.Имя), Детали, Принципал);
	Возврат Успех(Строка(Запись.Имя));

КонецФункции

// Удаляет провайдера. Привязки внешних личностей намеренно остаются: они живут на паре
// «издатель + субъект», и возвращённый провайдер того же издателя пускает прежних
// пользователей обратно — иначе случайное удаление кнопки необратимо отключало бы вход.
//
// Параметры:
//  Принципал - Структура - принципал запроса.
//  Имя - Строка - имя провайдера.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Ошибка (Строка), Имя (Строка).
//
Функция Удалить(Знач Принципал, Знач Имя) Экспорт

	Вердикт = ПроверитьПраво(Принципал, "удаление");
	Если НЕ Вердикт.Успех Тогда
		ЗаписатьОтказВАудит("удаление", Имя, Вердикт, Принципал);
		Возврат Вердикт;
	КонецЕсли;

	Норм = Хранилище.НормализованноеИмя(Имя);
	Если НЕ Хранилище.УдалитьПоИмени(Норм) Тогда
		Возврат Отказ(404, Тексты.Шаблон("providers.error.notfound", Строка(Имя)));
	КонецЕсли;
	Конфигурация.Перечитать();

	ЗаписатьВАудитДетали("провайдер.удалён", Норм, Новый Структура("Имя", Норм), Принципал);
	Возврат Успех(Норм);

КонецФункции

#КонецОбласти

#Область Права

// Вердикт по праву мутации: аноним → 401, рамки ключа, запрет ключу, админ хаба → 403.
// Экспортируется намеренно: правило проверяется тестом напрямую, иначе «отказ по правам»
// неотличим от «отказ по валидации».
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  Действие - Строка - создание | изменение | удаление; нужно скоупу ключа.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Ошибка (Строка), Имя (Строка).
//
Функция ПроверитьПраво(Знач Принципал, Знач Действие) Экспорт

	Если Принципал = Неопределено ИЛИ Принципал.Пользователь = Неопределено Тогда
		Возврат Отказ(401, Тексты.Текст("providers.error.auth"));
	КонецЕсли;

	// рамки ключа стоят перед запретом ключа целиком, чтобы отказ называл ближайшую
	// причину; несобранный гейт для запроса с ключом — отказ, а не пропуск
	ЭтоКлюч = Перехватчик.ЭтоКлюч(Принципал);
	Если ЭтоКлюч Тогда
		Если ГейтКлюча = Неопределено Тогда
			Возврат Отказ(403, Тексты.Текст("providers.error.key.gate"));
		КонецЕсли;
		ВердиктКлюча = ГейтКлюча.Проверить(Принципал, Действие, 0);
		Если НЕ ВердиктКлюча.Разрешено Тогда
			Если ВердиктКлюча.Причина = ГейтКлюча.ПричинаПривязка() Тогда
				Причина = Тексты.Текст("providers.error.key.binding");
			Иначе
				Причина = Тексты.Текст("providers.error.key.scope");
			КонецЕсли;
			Возврат Отказ(403, Тексты.Шаблон("providers.error.key.denied", Причина));
		КонецЕсли;
	КонецЕсли;

	// ключ не управляет входом в хаб — запрет по способу обращения
	Если ЭтоКлюч Тогда
		Возврат Отказ(403, Тексты.Текст("providers.error.key.forbidden"));
	КонецЕсли;

	Если НЕ СервисПрав.ПользовательАдмин(Принципал.Пользователь) Тогда
		Возврат Отказ(403, Тексты.Текст("providers.error.admin"));
	КонецЕсли;

	Возврат Успех("");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Записать(Запись, Знач Разбор, Знач Принципал)

	Запись.Имя = Разбор.Имя;
	Запись.Метка = Разбор.Метка;
	Запись.Значок = Разбор.Значок;
	Запись.ВидПротокола = Разбор.ВидПротокола;
	Запись.Издатель = Разбор.Издатель;
	Запись.ИдентификаторКлиента = Разбор.ИдентификаторКлиента;
	Запись.СекретКлиента = Разбор.СекретКлиента;
	Запись.АдресВозврата = Разбор.АдресВозврата;
	Запись.Область = Разбор.Область;
	Запись.КонечныеТочки = Разбор.КонечныеТочки;
	Запись.МаппингПрофиля = Разбор.МаппингПрофиля;
	Запись.ИмяКлеймаГрупп = Разбор.ИмяКлеймаГрупп;
	Запись.АвтоСоздание = Разбор.АвтоСоздание;
	Запись.ПровижинингГрупп = Разбор.ПровижинингГрупп;
	Запись.СвязкаГруппПоИмени = Разбор.СвязкаГруппПоИмени;
	Запись.ПрефиксГрупп = Разбор.ПрефиксГрупп;
	Запись.Включён = Разбор.Включён;
	Запись.Пресет = Разбор.Пресет;

	Хранилище.Записать(Запись, Логин(Принципал), ТекущаяУниверсальнаяДата());
	Конфигурация.Перечитать(); // изменение действует без рестарта

КонецПроцедуры

// Карточка строки без секрета: наружу уходит только признак «задан» и маска.
Функция Карточка(Знач Запись)

	Имя = Строка(Запись.Имя);
	Перекрыт = Конфигурация.ПерекрытОкружением(Имя);
	СекретЗадан = ЗначениеЗаполнено(Запись.СекретКлиента);

	Результат = Новый Структура();
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Метка", Строка(Запись.Метка));
	Результат.Вставить("Значок", Строка(Запись.Значок));
	Результат.Вставить("ВидПротокола", Строка(Запись.ВидПротокола));
	Результат.Вставить("Издатель", Строка(Запись.Издатель));
	Результат.Вставить("ИдентификаторКлиента", Строка(Запись.ИдентификаторКлиента));
	Результат.Вставить("СекретЗадан", СекретЗадан);
	Результат.Вставить("Секрет", ?(СекретЗадан, МаскаСекрета(), ""));
	Результат.Вставить("АдресВозврата", Строка(Запись.АдресВозврата));
	Результат.Вставить("Область", Строка(Запись.Область));
	Результат.Вставить("ИмяКлеймаГрупп", Строка(Запись.ИмяКлеймаГрупп));
	Результат.Вставить("АвтоСоздание", Запись.АвтоСоздание = Истина);
	Результат.Вставить("ПровижинингГрупп", Запись.ПровижинингГрупп = Истина);
	Результат.Вставить("СвязкаГруппПоИмени", Запись.СвязкаГруппПоИмени = Истина);
	Результат.Вставить("ПрефиксГрупп", Строка(Запись.ПрефиксГрупп));
	Результат.Вставить("Включён", Запись.Включён = Истина);
	Результат.Вставить("Пресет", Строка(Запись.Пресет));
	Результат.Вставить("Перекрыт", Перекрыт);
	// перекрытая строка базы на действующую конфигурацию не влияет
	Результат.Вставить("Источник", ?(Перекрыт, "конфиг", "база"));
	Результат.Вставить("Редактируемая", НЕ Перекрыт);
	Возврат Результат;

КонецФункции

// Карточка провайдера, которого нет в базе: поля берутся из действующей конфигурации,
// секрет — маской, как и у строк базы.
Функция КарточкаКонфигурации(Знач Провайдер)

	СекретЗадан = ЗначениеЗаполнено(Текст(Провайдер, "СекретКлиента"));

	Результат = Новый Структура();
	Результат.Вставить("Имя", Текст(Провайдер, "Имя"));
	Результат.Вставить("Метка", Текст(Провайдер, "Метка"));
	Результат.Вставить("Значок", "");
	Результат.Вставить("ВидПротокола", Текст(Провайдер, "Тип"));
	Результат.Вставить("Издатель", Текст(Провайдер, "Издатель"));
	Результат.Вставить("ИдентификаторКлиента", Текст(Провайдер, "ИдентификаторКлиента"));
	Результат.Вставить("СекретЗадан", СекретЗадан);
	Результат.Вставить("Секрет", ?(СекретЗадан, МаскаСекрета(), ""));
	Результат.Вставить("АдресВозврата", Текст(Провайдер, "АдресВозврата"));
	Результат.Вставить("Область", Текст(Провайдер, "Область"));
	Результат.Вставить("ИмяКлеймаГрупп", Текст(Провайдер, "ИмяКлеймаГрупп"));
	Результат.Вставить("АвтоСоздание", ПолеСтруктуры(Провайдер, "АвтоСоздание", Ложь) = Истина);
	Результат.Вставить("ПровижинингГрупп", ПолеСтруктуры(Провайдер, "ПровижинингГрупп", Ложь) = Истина);
	Результат.Вставить("СвязкаГруппПоИмени", ПолеСтруктуры(Провайдер, "СвязкаГруппПоИмени", Ложь) = Истина);
	Результат.Вставить("ПрефиксГрупп", Текст(Провайдер, "ПрефиксГрупп"));
	// в реестре живут только действующие провайдеры: выключенных там нет по построению
	Результат.Вставить("Включён", Истина);
	Результат.Вставить("Пресет", "");
	Результат.Вставить("Перекрыт", Истина);
	Результат.Вставить("Источник", "конфиг");
	Результат.Вставить("Редактируемая", Ложь);
	Возврат Результат;

КонецФункции

Функция Текст(Знач Провайдер, Знач Имя)
	Возврат СокрЛП(Строка(ПолеСтруктуры(Провайдер, Имя, "")));
КонецФункции

// В журнал уходит маска, а не секрет: иначе доступ к журналу давал бы client_secret
// всех провайдеров.
Процедура ЗаписатьВАудит(Знач Действие, Знач Разбор, Знач Принципал)

	Детали = Новый Структура();
	Детали.Вставить("Имя", Разбор.Имя);
	Детали.Вставить("ВидПротокола", Разбор.ВидПротокола);
	Детали.Вставить("Издатель", Разбор.Издатель);
	Детали.Вставить("ИдентификаторКлиента", Разбор.ИдентификаторКлиента);
	Детали.Вставить("СекретКлиента", ?(ЗначениеЗаполнено(Разбор.СекретКлиента), МаскаСекрета(), ""));
	Детали.Вставить("АдресВозврата", Разбор.АдресВозврата);
	Детали.Вставить("АвтоСоздание", Разбор.АвтоСоздание);
	Детали.Вставить("Включён", Разбор.Включён);
	Детали.Вставить("Пресет", Разбор.Пресет);
	ЗаписатьВАудитДетали(Действие, Разбор.Имя, Детали, Принципал);

КонецПроцедуры

Процедура ЗаписатьВАудитДетали(Знач Действие, Знач Имя, Знач Детали, Знач Принципал)

	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Детали);

	Данные = Новый Структура();
	Данные.Вставить("Кто", Логин(Принципал));
	Данные.Вставить("Действие", Действие);
	Данные.Вставить("Объект", ИменаЖурнала.Провайдер(Имя));
	Данные.Вставить("ДеталиJSON", Запись.Закрыть());
	Данные.Вставить("АдресIP", "");
	Издатель.Опубликовать(Издатель.ТипПровайдерВходаИзменён(), Данные);

КонецПроцедуры

// Отказ тоже событие: поверхность решает, кто войдёт в хаб, и журнал без следа отказов
// даёт неверную картину «никто не подбирался». Секрета в деталях нет по построению.
Процедура ЗаписатьОтказВАудит(Знач Действие, Знач Имя, Знач Вердикт, Знач Принципал)

	Детали = Новый Структура();
	Детали.Вставить("Действие", Действие);
	Детали.Вставить("Код", Вердикт.Код);
	Детали.Вставить("Причина", Вердикт.Ошибка);
	Детали.Вставить("Способ", СпособОбращения(Принципал));
	ЗаписатьВАудитДетали("провайдер.отказ", Строка(Имя), Детали, Принципал);

КонецПроцедуры

// Перекрытая окружением строка правке и переключению не подлежит: «защита разметкой»
// защитой не является, а молчаливое игнорирование POST читается как сломанный хаб.
// Удаление при этом разрешено: снять мёртвую строку базы — уборка, а не смена поведения.
Функция ПроверитьПерекрытие(Знач Имя)

	Если Конфигурация.ПерекрытОкружением(Имя) Тогда
		Возврат Отказ(409, Тексты.Шаблон("providers.error.overridden", Строка(Имя)));
	КонецЕсли;
	Возврат Успех(Строка(Имя));

КонецФункции

// Аноним до предиката «это ключ» не доходит: спрашивать перехватчик о Неопределено нельзя.
Функция СпособОбращения(Знач Принципал)
	Если Принципал = Неопределено ИЛИ Принципал.Пользователь = Неопределено Тогда
		Возврат "аноним";
	КонецЕсли;
	Возврат ?(Перехватчик.ЭтоКлюч(Принципал), "ключ", "сессия");
КонецФункции

Функция Логин(Знач Принципал)
	Если Принципал = Неопределено ИЛИ Принципал.Пользователь = Неопределено Тогда
		Возврат "anonymous";
	КонецЕсли;
	Возврат Строка(Принципал.Пользователь.Логин);
КонецФункции

Функция Успех(Знач Имя)
	Возврат Новый Структура("Успех, Код, Ошибка, Имя", Истина, 200, "", Имя);
КонецФункции

Функция Отказ(Знач Код, Знач Причина)
	Возврат Новый Структура("Успех, Код, Ошибка, Имя", Ложь, Код, Причина, "");
КонецФункции

Функция ПолеСтруктуры(Знач Данные, Знач Имя, Знач ПоУмолчанию)
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Найденное = Неопределено;
		Если Данные.Свойство(Имя, Найденное) И Найденное <> Неопределено Тогда
			Возврат Найденное;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Найденное = Данные.Получить(Имя);
		Если Найденное <> Неопределено Тогда
			Возврат Найденное;
		КонецЕсли;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

#КонецОбласти

&Прозвище("СервисПровайдеровВхода")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПровайдеровВхода") _Хранилище,
	&Пластилин(Значение = "КонфигурацияOIDC") _Конфигурация,
	&Пластилин(Значение = "РазборПровайдераВхода") _Разбор,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ИмяОбъектаАудита") _ИменаЖурнала,
	&Пластилин(Значение = "ГейтТокена") _ГейтКлюча = Неопределено,
	&Пластилин(Значение = "ИздательСобытий") _Издатель = Неопределено)

	Хранилище = _Хранилище;
	Конфигурация = _Конфигурация;
	Разбор_ = _Разбор;
	Перехватчик = _Перехватчик;
	СервисПрав = _СервисПрав;
	Тексты = _Тексты;
	ИменаЖурнала = _ИменаЖурнала;
	// гейт с умолчанием: в контейнере без него запрос с ключом получает отказ (fail-closed)
	ГейтКлюча = _ГейтКлюча;
	Издатель = _Издатель;

КонецПроцедуры
