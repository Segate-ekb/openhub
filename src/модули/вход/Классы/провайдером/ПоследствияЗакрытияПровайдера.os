// Что станет с людьми, если названный провайдер закроется: сколько активных учётных
// записей останется без другого способа войти и что хаб может им предложить взамен.
// Счёт идёт по ИЗДАТЕЛЮ, а не по имени провайдера: два провайдера одного издателя дадут
// одинаковый — и для каждого из них завышенный — ответ, потому что личность учётки знает
// издателя, а не то, какой кнопкой её завели.

Перем Пользователи;   // ХранилищеПользователей (данные)
Перем Личности;       // ХранилищеВнешнихЛичностей (данные)
Перем Провайдеры;     // ХранилищеПровайдеровВхода (данные) — издатель выключенной строки
Перем Конфигурация;   // КонфигурацияOIDC (вход) — издатель действующего провайдера
Перем ПарольныйВход;  // ПолитикаПарольногоВхода (вход)
Перем Восстановление; // ВосстановлениеПароля (вход)
Перем РазмерПорции;   // Число — сколько идентификаторов уходит в один запрос личностей

#Область ТестовыеШвы

// Задаёт размер порции идентификаторов — тестовый шов; в рабочем контейнере не вызывается.
//
// Параметры:
//  Значение - Число - идентификаторов в одном запросе; меньше единицы не бывает.
//
Процедура УстановитьРазмерПорции(Знач Значение) Экспорт
	РазмерПорции = Макс(1, Цел(Значение));
КонецПроцедуры

#КонецОбласти

#Область ПубличныйИнтерфейс

// Обстановка вокруг провайдера: её видит администратор, закрывая провайдера, и она же
// ложится в журнал аудита. Стоит обхода учёток и чтения их личностей порциями, поэтому
// спрашивается на открытие окна и на сохранение, а не на отрисовку списка.
//
// Параметры:
//  ИмяПровайдера - Строка - имя провайдера; регистр не значим.
//
// Возвращаемое значение:
//  Структура - Учёток (Число — активных учёток, у которых этот провайдер единственный
//              способ войти), ПарольныйВход (Булево), ВосстановлениеПароля (Булево).
//
Функция ДляПровайдера(Знач ИмяПровайдера) Экспорт

	Возврат Новый Структура("Учёток, ПарольныйВход, ВосстановлениеПароля",
		УчётокБезДругогоВхода(ИздательПровайдера(ИмяПровайдера)),
		ПарольныйВход.Включён(),
		Восстановление.Доступно());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Издатель есть и у выключенного провайдера: в действующей конфигурации его нет,
// а учётки, входящие через него, остались.
Функция ИздательПровайдера(Знач ИмяПровайдера)

	Описание = Конфигурация.Провайдер(ИмяПровайдера);
	Если Описание <> Неопределено Тогда
		Возврат Норм(Описание.Издатель);
	КонецЕсли;

	Запись = Провайдеры.НайтиПоИмени(ИмяПровайдера);
	Возврат ?(Запись = Неопределено, "", Норм(Запись.Издатель));

КонецФункции

// Учётка считается оставшейся без входа, когда действующего пароля у неё нет, личности
// есть и ВСЕ они принадлежат этому издателю: личность соседнего провайдера — другой вход.
Функция УчётокБезДругогоВхода(Знач Издатель)

	Если НЕ ЗначениеЗаполнено(Издатель) Тогда
		Возврат 0;
	КонецЕсли;

	Активные = АктивныеУчётки();
	ИздателиУчёток = ИздателиЛичностей(Активные);

	ВходВключён = ПарольныйВход.Включён();

	Результат = 0;
	Для Каждого Пользователь Из Активные Цикл
		Если ПарольныйВход.ПарольДействует(Пользователь, ВходВключён) Тогда
			Продолжить;
		КонецЕсли;
		Свои = ИздателиУчёток.Получить(Цел(Пользователь.Идентификатор));
		Если Свои <> Неопределено И Свои.Количество() = 1 И Свои.Получить(Издатель) = Истина Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция АктивныеУчётки()

	Результат = Новый Массив();
	Для Каждого Пользователь Из Пользователи.Все() Цикл
		Если Пользователь.Активен = Истина Тогда
			Результат.Добавить(Пользователь);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Личности читаются ПОРЦИЯМИ, а не запросом на строку и не одним списком на всю базу:
// «IN (…)» из всех активных идентификаторов на большой инсталляции упирается в предел
// параметров запроса.
Функция ИздателиЛичностей(Знач Активные)

	Результат = Новый Соответствие();

	Порция = Новый Массив();
	Для Каждого Пользователь Из Активные Цикл
		Порция.Добавить(Цел(Пользователь.Идентификатор));
		Если Порция.Количество() >= РазмерПорции Тогда
			ДобавитьИздателейПорции(Результат, Порция);
			Порция = Новый Массив();
		КонецЕсли;
	КонецЦикла;
	ДобавитьИздателейПорции(Результат, Порция);

	Возврат Результат;

КонецФункции

Процедура ДобавитьИздателейПорции(Результат, Знач Порция)

	Если Порция.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Личность Из Личности.ПолучитьПоПользовательИдентификаторВ(Порция) Цикл
		Ключ = Цел(Личность.ПользовательИдентификатор);
		Свои = Результат.Получить(Ключ);
		Если Свои = Неопределено Тогда
			Свои = Новый Соответствие();
			Результат.Вставить(Ключ, Свои);
		КонецЕсли;
		Свои.Вставить(Норм(Личность.Издатель), Истина);
	КонецЦикла;

КонецПроцедуры

Функция Норм(Знач Значение)
	Возврат НРег(СокрЛП(Строка(?(Значение = Неопределено, "", Значение))));
КонецФункции

#КонецОбласти

&Желудь
&Наблюдаемый
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПользователей") _Пользователи,
	&Пластилин(Значение = "ХранилищеВнешнихЛичностей") _Личности,
	&Пластилин(Значение = "ХранилищеПровайдеровВхода") _Провайдеры,
	&Пластилин(Значение = "КонфигурацияOIDC") _Конфигурация,
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _ПарольныйВход,
	&Пластилин(Значение = "ВосстановлениеПароля") _Восстановление)

	Пользователи = _Пользователи;
	Личности = _Личности;
	Провайдеры = _Провайдеры;
	Конфигурация = _Конфигурация;
	ПарольныйВход = _ПарольныйВход;
	Восстановление = _Восстановление;

	РазмерПорции = 200;

КонецПроцедуры
