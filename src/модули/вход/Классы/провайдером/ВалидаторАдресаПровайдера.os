// SSRF-гейт формы администратора: только https, без userinfo, без управляющих символов,
// без адресов, ведущих не в интернет. Проверки не бросают — отдают вердикт.

Перем ПолитикаСети;   // СвояСеть (сеть) — одно определение своей сети на хаб
Перем Издатели;       // ИздателиOAuth2 (вход) — пространство синтетических издателей
Перем Тексты;         // ТекстыВхода (вход) — слова домена по ключам
Перем Форма;          // ФормаАдреса (основа) — общий каркас проверки формы адреса
Перем Вердикты;       // Вердикт (основа) — форма ответа

#Область ПубличныйИнтерфейс

// Проверяет конечную точку провайдера (authorization, token, userinfo, emails).
//
// Параметры:
//  Адрес - Строка - полный URL точки.
//  Роль - Строка - имя точки словами для текста отказа, уже из словаря
//         (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Сообщение (Строка — текст отказа для администратора).
//
Функция ПроверитьТочку(Знач Адрес, Знач Роль = "") Экспорт

	Коды = Форма.Коды();
	Разбор = Форма.Разобрать(Адрес, "https");

	Если Разбор.Код = Коды.Пусто Тогда
		Возврат Вердикты.ОтказСловами(Тексты.Шаблон("providers.error.address.empty", ИмяРоли(Роль)));
	ИначеЕсли Разбор.Код = Коды.Управляющий Тогда
		Возврат Вердикты.ОтказСловами(Тексты.Шаблон("providers.error.address.control", ИмяРоли(Роль), Разбор.Символ));
	ИначеЕсли Разбор.Код = Коды.СхемыНет Тогда
		Возврат Вердикты.ОтказСловами(Тексты.Шаблон("providers.error.address.scheme.missing", ИмяРоли(Роль)));
	ИначеЕсли Разбор.Код = Коды.ЧужаяСхема Тогда
		Возврат Вердикты.ОтказСловами(Тексты.Шаблон("providers.error.address.scheme", Разбор.Схема, ИмяРоли(Роль)));
	ИначеЕсли Разбор.Код = Коды.ДанныеПользователя Тогда
		Возврат Вердикты.ОтказСловами(Тексты.Шаблон("providers.error.address.userinfo", ИмяРоли(Роль)));
	ИначеЕсли Разбор.Код = Коды.ХостаНет Тогда
		Возврат Вердикты.ОтказСловами(Тексты.Шаблон("providers.error.address.host", ИмяРоли(Роль)));
	КонецЕсли;

	Хост = Разбор.Хост;

	// запись адреса судится до однословности: «2130706433» — нестрогая запись петли, а не имя
	ПоЗаписи = ПолитикаСети.Вердикт(Хост);
	Если ПоЗаписи.Код <> ПолитикаСети.Коды().Интернет Тогда
		Возврат ОтказПоСети(ПоЗаписи, Хост, Роль);
	КонецЕсли;

	// однословный хост — отказ: публичный провайдер живёт на FQDN
	Если Найти(Хост, ".") = 0 И Найти(Хост, ":") = 0 Тогда
		Возврат Вердикты.ОтказСловами(Тексты.Шаблон("providers.error.address.single-label", Хост, ИмяРоли(Роль)));
	КонецЕсли;

	Возврат Вердикты.УспехСловами();

КонецФункции

// Проверяет издателя провайдера с учётом вида протокола: у oauth2 издатель обязан быть
// синтетическим (его назначает хаб), у oidc — настоящим https-адресом.
//
// Параметры:
//  Издатель - Строка - издатель провайдера.
//  ВидПротокола - Строка - oidc | oauth2.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Сообщение (Строка).
//
Функция ПроверитьИздателя(Знач Издатель, Знач ВидПротокола) Экспорт

	Значение = СокрЛП(Строка(Издатель));

	Если НРег(СокрЛП(Строка(ВидПротокола))) = "oauth2" Тогда
		Если НЕ Издатели.ЭтоСинтетический(Значение) Тогда
			Возврат Вердикты.ОтказСловами(Тексты.Шаблон("providers.error.issuer.synthetic.required", Издатели.Префикс()));
		КонецЕсли;
		Возврат Вердикты.УспехСловами();
	КонецЕсли;

	// проверка «не из пространства синтетики» стоит первой, чтобы отказ объяснял подделку
	Если Издатели.ЭтоСинтетический(Значение) Тогда
		Возврат Вердикты.ОтказСловами(Тексты.Шаблон("providers.error.issuer.synthetic.forbidden", Издатели.Префикс()));
	КонецЕсли;

	Возврат ПроверитьТочку(Значение, Тексты.Текст("providers.role.issuer"));

КонецФункции

// Проверяет набор конечных точек провайдера разом и отдаёт его очищенным; издатель
// в наборе точкой не считается.
//
// Параметры:
//  Набор - Соответствие, Структура, Неопределено - конечные точки провайдера.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Сообщение (Строка), Точки (Соответствие либо Неопределено —
//              пустой набор означает «точки берутся из discovery»).
//
Функция ПроверитьНаборТочек(Знач Набор) Экспорт

	Точки = Неопределено;
	Если Набор <> Неопределено Тогда
		Точки = Новый Соответствие();
		Для Каждого КиЗ Из КНабору(Набор) Цикл
			Если НРег(СокрЛП(Строка(КиЗ.Ключ))) = "issuer" Тогда
				Продолжить;
			КонецЕсли;
			Проверка = ПроверитьТочку(КиЗ.Значение, ИмяТочки(КиЗ.Ключ));
			Если НЕ Проверка.Успех Тогда
				Возврат ОтказНабора(Проверка.Сообщение);
			КонецЕсли;
			Точки.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
		Если Точки.Количество() = 0 Тогда
			Точки = Неопределено;
		КонецЕсли;
	КонецЕсли;

	Возврат Вердикты.УспехСловами(СНабором(Точки));

КонецФункции

// Проверяет адрес возврата (redirect_uri): https куда угодно либо http в петлю;
// чужая схема (javascript:, data:) и userinfo — отказ.
//
// Параметры:
//  Адрес - Строка - адрес возврата.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Сообщение (Строка).
//
Функция ПроверитьАдресВозврата(Знач Адрес) Экспорт

	Коды = Форма.Коды();
	// схему судим сами и последней: у адреса возврата своё правило
	Разбор = Форма.Разобрать(Адрес);

	Если Разбор.Код = Коды.Пусто Тогда
		Возврат Вердикты.ОтказСловами(Тексты.Текст("providers.error.redirect.empty"));
	ИначеЕсли Разбор.Код = Коды.Управляющий Тогда
		Возврат Вердикты.ОтказСловами(Тексты.Шаблон("providers.error.redirect.control", Разбор.Символ));
	ИначеЕсли Разбор.Код = Коды.СхемыНет Тогда
		Возврат Вердикты.ОтказСловами(Тексты.Текст("providers.error.redirect.scheme.missing"));
	ИначеЕсли Разбор.Код = Коды.ДанныеПользователя Тогда
		Возврат Вердикты.ОтказСловами(Тексты.Текст("providers.error.redirect.userinfo"));
	ИначеЕсли Разбор.Код = Коды.ХостаНет Тогда
		Возврат Вердикты.ОтказСловами(Тексты.Текст("providers.error.redirect.host"));
	КонецЕсли;

	Схема = Разбор.Схема;
	Хост = Разбор.Хост;

	Если Схема = "https" Тогда
		Возврат Вердикты.УспехСловами();
	КонецЕсли;
	// http — только в петлю: authorization code открытым каналом не покидает узел
	Если Схема = "http" И ПолитикаСети.ЭтоПетля(Хост) Тогда
		Возврат Вердикты.УспехСловами();
	КонецЕсли;

	Возврат Вердикты.ОтказСловами(Тексты.Шаблон("providers.error.redirect.scheme", Схема, Хост));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отвергнутый набор — пустой набор точек, а не Неопределено («точки из discovery»).
Функция ОтказНабора(Знач Сообщение)
	Возврат Вердикты.ОтказСловами(Сообщение, СНабором(Новый Соответствие()));
КонецФункции

Функция СНабором(Знач Точки)
	Возврат Новый Структура("Точки", Точки);
КонецФункции

// Вызывающий передаёт уже разрешённый текст роли; пустая роль — общий заменитель.
Функция ИмяТочки(Знач Точка)
	Найденное = ИменаТочек().Получить(Строка(Точка));
	Возврат ?(Найденное = Неопределено, Тексты.Текст("providers.role.default"), Найденное);
КонецФункции

Функция ИменаТочек()
	Имена = Новый Соответствие();
	Имена.Вставить("Авторизация", Тексты.Текст("providers.role.authorize"));
	Имена.Вставить("Токен", Тексты.Текст("providers.role.token"));
	Имена.Вставить("Профиль", Тексты.Текст("providers.role.profile"));
	Имена.Вставить("Emails", Тексты.Текст("providers.role.emails"));
	Возврат Имена;
КонецФункции

Функция КНабору(Знач Сырое)
	Результат = Новый Соответствие();
	Если ТипЗнч(Сырое) = Тип("Соответствие") ИЛИ ТипЗнч(Сырое) = Тип("Структура") Тогда
		Для Каждого КиЗ Из Сырое Цикл
			Результат.Вставить(Строка(КиЗ.Ключ), КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Слова причины — из политики сети; подсказка про окружение — только для своей сети.
Функция ОтказПоСети(Знач Вердикт, Знач Хост, Знач Роль)

	Если Вердикт.Код = ПолитикаСети.Коды().СвояСеть Тогда
		Возврат Вердикты.ОтказСловами(Тексты.Шаблон("providers.error.address.network.own",
			Хост, ИмяРоли(Роль), Вердикт.Текст));
	КонецЕсли;

	Возврат Вердикты.ОтказСловами(Тексты.Шаблон("providers.error.address.network",
		Хост, ИмяРоли(Роль), Вердикт.Текст));

КонецФункции

Функция ИмяРоли(Знач Роль)
	Возврат ?(ЗначениеЗаполнено(Роль), Строка(Роль), Тексты.Текст("providers.role.default"));
КонецФункции

#КонецОбласти

&Прозвище("ВалидаторАдресаПровайдера")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СвояСеть") _ПолитикаСети,
	&Пластилин(Значение = "ИздателиOAuth2") _Издатели,
	&Пластилин(Значение = "ТекстыВхода") _Тексты,
	&Пластилин(Значение = "ФормаАдреса") _Форма = Неопределено)

	Форма = ?(_Форма = Неопределено, Новый ФормаАдреса(), _Форма);
	ПолитикаСети = _ПолитикаСети;
	Издатели = _Издатели;
	Тексты = _Тексты;
	Вердикты = Новый Вердикт();

КонецПроцедуры
