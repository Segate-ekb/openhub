// SSRF-гейт формы администратора: адреса провайдера входа задаёт админ, а ходит по ним
// сервер (discovery, token, userinfo). Правила ветки провайдера:
// только https (по каналу едут client_secret и токены), без userinfo в URL, без
// управляющих символов (CRLF в заголовки и журнал), без приватных, loopback и link-local
// адресов в любой форме записи — флага «разрешить приватные» здесь нет и не будет,
// внутренний IdP заводится переменными окружения. Издатель ветки oidc обязан быть
// настоящим https-адресом: иначе админ заведёт издателя из пространства синтетических
// («oauth2:github») и начнёт выдавать личности, неотличимые от гитхабовских.
// Канонизация IP и резолв DNS не дублируются — движок инъектируется.
// Проверки исключений не бросают, отвечают Структура(Ок, Ошибка).

Перем ВалидаторХоста; // ВалидаторАдресаВебхука (подписки) — канонизация и резолв
Перем Издатели;       // ИздателиOAuth2 (oidc) — пространство синтетических издателей
Перем Тексты;         // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Проверяет конечную точку провайдера (authorization, token, userinfo, emails).
//
// Параметры:
//  Адрес - Строка - полный URL точки.
//  Роль - Строка - имя точки словами для текста отказа, уже из словаря
//         (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Ок (Булево), Ошибка (Строка — текст отказа для администратора).
//
Функция ПроверитьТочку(Знач Адрес, Знач Роль = "") Экспорт

	Значение = СокрЛП(Строка(Адрес));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Отказ(Тексты.Шаблон("providers.error.address.empty", ИмяРоли(Роль)));
	КонецЕсли;

	Управляющий = ВалидаторХоста.НайтиУправляющий(Значение);
	Если ЗначениеЗаполнено(Управляющий) Тогда
		Возврат Отказ(Тексты.Шаблон("providers.error.address.control", ИмяРоли(Роль), Управляющий));
	КонецЕсли;

	Позиция = Найти(Значение, "://");
	Если Позиция = 0 Тогда
		Возврат Отказ(Тексты.Шаблон("providers.error.address.scheme.missing", ИмяРоли(Роль)));
	КонецЕсли;

	Схема = НРег(Лев(Значение, Позиция - 1));
	Если Схема <> "https" Тогда
		Возврат Отказ(Тексты.Шаблон("providers.error.address.scheme", Схема, ИмяРоли(Роль)));
	КонецЕсли;

	Авторитет = ВыделитьАвторитет(Сред(Значение, Позиция + 3));
	Если Найти(Авторитет, "@") > 0 Тогда
		Возврат Отказ(Тексты.Шаблон("providers.error.address.userinfo", ИмяРоли(Роль)));
	КонецЕсли;

	Хост = НРег(ВыделитьХост(Авторитет));
	Если НЕ ЗначениеЗаполнено(Хост) Тогда
		Возврат Отказ(Тексты.Шаблон("providers.error.address.host", ИмяРоли(Роль)));
	КонецЕсли;

	// Однословный хост — отказ: публичный провайдер живёт на FQDN, а «https://github/…»
	// это либо внутреннее имя, либо подгонка под синтетического издателя (он строится
	// по хосту). Резолв не спасает: несуществующее имя приватным не признаётся.
	Если Найти(Хост, ".") = 0 И Найти(Хост, ":") = 0 Тогда
		Возврат Отказ(Тексты.Шаблон("providers.error.address.single-label", Хост, ИмяРоли(Роль)));
	КонецЕсли;

	// link-local отдельной ступенью ради текста отказа: там живёт сервис метаданных облака
	Если ВалидаторХоста.ХостLinkLocal(Хост) Тогда
		Возврат Отказ(Тексты.Шаблон("providers.error.address.linklocal", Хост, ИмяРоли(Роль)));
	КонецЕсли;

	Если ВалидаторХоста.ХостПриватный(Хост) Тогда
		Возврат Отказ(Тексты.Шаблон("providers.error.address.private", Хост, ИмяРоли(Роль)));
	КонецЕсли;

	Возврат Ок();

КонецФункции

// Проверяет издателя провайдера с учётом вида протокола: у oauth2 издатель обязан быть
// синтетическим (его назначает хаб), у oidc — настоящим https-адресом.
//
// Параметры:
//  Издатель - Строка - издатель провайдера.
//  ВидПротокола - Строка - oidc | oauth2.
//
// Возвращаемое значение:
//  Структура - Ок (Булево), Ошибка (Строка).
//
Функция ПроверитьИздателя(Знач Издатель, Знач ВидПротокола) Экспорт

	Значение = СокрЛП(Строка(Издатель));

	Если НРег(СокрЛП(Строка(ВидПротокола))) = "oauth2" Тогда
		Если НЕ Издатели.ЭтоСинтетический(Значение) Тогда
			Возврат Отказ(Тексты.Шаблон("providers.error.issuer.synthetic.required", Издатели.Префикс()));
		КонецЕсли;
		Возврат Ок();
	КонецЕсли;

	// проверка «не из пространства синтетики» стоит первой, чтобы отказ объяснял подделку
	Если Издатели.ЭтоСинтетический(Значение) Тогда
		Возврат Отказ(Тексты.Шаблон("providers.error.issuer.synthetic.forbidden", Издатели.Префикс()));
	КонецЕсли;

	Возврат ПроверитьТочку(Значение, Тексты.Текст("providers.role.issuer"));

КонецФункции

// Проверяет адрес возврата (redirect_uri). Сервер по нему не ходит — по нему возвращается
// браузер, — поэтому правило другое: https либо http на localhost, но никогда чужая схема
// (javascript:, data:) и не адрес с userinfo.
//
// Параметры:
//  Адрес - Строка - адрес возврата.
//
// Возвращаемое значение:
//  Структура - Ок (Булево), Ошибка (Строка).
//
// Проверяет НАБОР конечных точек провайдера разом и отдаёт его очищенным. Издатель
// в наборе приезжает отдельным ключом, но точкой не является: у него своя проверка,
// а у OAuth2-пресета он синтетический и адресом быть не обязан.
//
// Параметры:
//  Набор - Соответствие, Структура, Неопределено - конечные точки провайдера.
//
// Возвращаемое значение:
//  Структура - Ок (Булево), Ошибка (Строка), Точки (Соответствие либо Неопределено —
//              пустой набор означает «точки берутся из discovery»).
//
Функция ПроверитьНаборТочек(Знач Набор) Экспорт

	Точки = Неопределено;
	Если Набор <> Неопределено Тогда
		Точки = Новый Соответствие();
		Для Каждого КиЗ Из КНабору(Набор) Цикл
			Если НРег(СокрЛП(Строка(КиЗ.Ключ))) = "issuer" Тогда
				Продолжить;
			КонецЕсли;
			Проверка = ПроверитьТочку(КиЗ.Значение, ИмяТочки(КиЗ.Ключ));
			Если НЕ Проверка.Ок Тогда
				Возврат Отказ(Проверка.Ошибка);
			КонецЕсли;
			Точки.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
		Если Точки.Количество() = 0 Тогда
			Точки = Неопределено;
		КонецЕсли;
	КонецЕсли;

	Результат = Ок();
	Результат.Вставить("Точки", Точки);
	Возврат Результат;

КонецФункции

Функция ПроверитьАдресВозврата(Знач Адрес) Экспорт

	Значение = СокрЛП(Строка(Адрес));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Отказ(Тексты.Текст("providers.error.redirect.empty"));
	КонецЕсли;

	Управляющий = ВалидаторХоста.НайтиУправляющий(Значение);
	Если ЗначениеЗаполнено(Управляющий) Тогда
		Возврат Отказ(Тексты.Шаблон("providers.error.redirect.control", Управляющий));
	КонецЕсли;

	Позиция = Найти(Значение, "://");
	Если Позиция = 0 Тогда
		Возврат Отказ(Тексты.Текст("providers.error.redirect.scheme.missing"));
	КонецЕсли;

	Схема = НРег(Лев(Значение, Позиция - 1));
	Авторитет = ВыделитьАвторитет(Сред(Значение, Позиция + 3));
	Если Найти(Авторитет, "@") > 0 Тогда
		Возврат Отказ(Тексты.Текст("providers.error.redirect.userinfo"));
	КонецЕсли;
	Хост = НРег(ВыделитьХост(Авторитет));
	Если НЕ ЗначениеЗаполнено(Хост) Тогда
		Возврат Отказ(Тексты.Текст("providers.error.redirect.host"));
	КонецЕсли;

	Если Схема = "https" Тогда
		Возврат Ок();
	КонецЕсли;
	// ровно http на localhost: по этому адресу едет authorization code
	Если Схема = "http" И (Хост = "localhost" ИЛИ Хост = "127.0.0.1" ИЛИ Хост = "::1") Тогда
		Возврат Ок();
	КонецЕсли;

	Возврат Отказ(Тексты.Шаблон("providers.error.redirect.scheme", Схема, Хост));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вызывающий передаёт уже разрешённый текст роли; пустая роль — общий заменитель.
Функция ИмяТочки(Знач Точка)
	Найденное = ИменаТочек().Получить(Строка(Точка));
	Возврат ?(Найденное = Неопределено, Тексты.Текст("providers.role.default"), Найденное);
КонецФункции

Функция ИменаТочек()
	Имена = Новый Соответствие();
	Имена.Вставить("Авторизация", Тексты.Текст("providers.role.authorize"));
	Имена.Вставить("Токен", Тексты.Текст("providers.role.token"));
	Имена.Вставить("Профиль", Тексты.Текст("providers.role.profile"));
	Имена.Вставить("Emails", Тексты.Текст("providers.role.emails"));
	Возврат Имена;
КонецФункции

Функция КНабору(Знач Значение_)
	Результат = Новый Соответствие();
	Если ТипЗнч(Значение_) = Тип("Соответствие") ИЛИ ТипЗнч(Значение_) = Тип("Структура") Тогда
		Для Каждого КиЗ Из Значение_ Цикл
			Результат.Вставить(Строка(КиЗ.Ключ), КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ИмяРоли(Знач Роль)
	Возврат ?(ЗначениеЗаполнено(Роль), Строка(Роль), Тексты.Текст("providers.role.default"));
КонецФункции

Функция Ок()
	Возврат Новый Структура("Ок, Ошибка", Истина, "");
КонецФункции

Функция Отказ(Знач Причина)
	Возврат Новый Структура("Ок, Ошибка", Ложь, Причина);
КонецФункции

// Authority (user@host:port) — часть после "://" до первого '/', '?' или '#'.
Функция ВыделитьАвторитет(Знач Остаток)
	Результат = Остаток;
	Для Каждого Разделитель Из СтрРазделить("/,?,#", ",") Цикл
		П = Найти(Результат, Разделитель);
		Если П > 0 Тогда
			Результат = Лев(Результат, П - 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Хост из authority: отбрасывает userinfo и порт, снимает скобки IPv6.
Функция ВыделитьХост(Знач Авторитет)

	Хост = Авторитет;
	П = Найти(Хост, "@");
	Если П > 0 Тогда
		Хост = Сред(Хост, П + 1);
	КонецЕсли;

	Если Лев(Хост, 1) = "[" Тогда
		Закрытие = Найти(Хост, "]");
		Если Закрытие > 0 Тогда
			Возврат Сред(Хост, 2, Закрытие - 2);
		КонецЕсли;
	КонецЕсли;

	ПортП = СтрНайти(Хост, ":", НаправлениеПоиска.СКонца);
	Если ПортП > 0 Тогда
		Хост = Лев(Хост, ПортП - 1);
	КонецЕсли;
	Возврат СокрЛП(Хост);

КонецФункции

#КонецОбласти

&Прозвище("ВалидаторАдресаПровайдера")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВалидаторАдресаВебхука") _ВалидаторХоста,
	&Пластилин(Значение = "ИздателиOAuth2") _Издатели,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	ВалидаторХоста = _ВалидаторХоста;
	Издатели = _Издатели;
	Тексты = _Тексты;

КонецПроцедуры
