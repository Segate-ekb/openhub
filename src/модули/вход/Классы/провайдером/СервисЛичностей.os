// Хранение связок «локальный пользователь ↔ личность у OIDC-провайдера»: личность
// однозначна по паре issuer+subject и принадлежит ровно одному пользователю.

Перем Хранилище;           // ХранилищеВнешнихЛичностей (данные)
Перем СервисПользователей; // СервисПользователей (auth)

// Личность по паре issuer+subject.
//
// Параметры:
//  Издатель - Строка - issuer провайдера.
//  Субъект - Строка - sub у провайдера.
//
// Возвращаемое значение:
//  ВнешняяЛичность, Неопределено.
//
Функция НайтиЛичность(Знач Издатель, Знач Субъект) Экспорт
	Возврат Хранилище.НайтиПоЛичности(СокрЛП(Строка(Издатель)), СокрЛП(Строка(Субъект)));
КонецФункции

// Пользователь, которому принадлежит личность issuer+subject.
//
// Параметры:
//  Издатель - Строка - issuer провайдера.
//  Субъект - Строка - sub у провайдера.
//
// Возвращаемое значение:
//  Пользователь, Неопределено.
//
Функция НайтиПользователяПоЛичности(Знач Издатель, Знач Субъект) Экспорт

	Личность = НайтиЛичность(Издатель, Субъект);
	Если Личность = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СервисПользователей.ПоИдентификатору(Личность.ПользовательИдентификатор);

КонецФункции

// Привязывает личность issuer+subject к пользователю; повторная привязка к тому же
// пользователю идемпотентна. Пустые issuer/subject и личность, занятая другим
// пользователем, — исключение (защита от угона аккаунта).
// Политику, разрешающую саму привязку, держит вызывающий.
//
// Параметры:
//  ПользовательИдентификатор - Число - владелец личности.
//  Издатель - Строка - issuer провайдера.
//  Субъект - Строка - sub у провайдера.
//  Email - Строка - адрес из клеймов, справочно (необязательный, по умолчанию "").
//  ПредпочтительныйЛогин - Строка - preferred_username у провайдера, справочно
//                          (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  ВнешняяЛичность - созданная или уже существующая привязка.
//
Функция Привязать(Знач ПользовательИдентификатор, Знач Издатель, Знач Субъект, Знач Email = "",
	Знач ПредпочтительныйЛогин = "") Экспорт

	НормИздатель = СокрЛП(Строка(Издатель));
	НормСубъект = СокрЛП(Строка(Субъект));
	Если ПустаяСтрока(НормИздатель) ИЛИ ПустаяСтрока(НормСубъект) Тогда
		ВызватьИсключение "OIDC: личность требует непустых issuer и subject";
	КонецЕсли;

	Существующая = Хранилище.НайтиПоЛичности(НормИздатель, НормСубъект);
	Если Существующая <> Неопределено Тогда
		Если Существующая.ПользовательИдентификатор = ПользовательИдентификатор Тогда
			Возврат Существующая; // уже привязана к этому же пользователю
		КонецЕсли;
		ВызватьИсключение "OIDC: эта личность уже привязана к другому пользователю";
	КонецЕсли;

	Личность = Хранилище.СоздатьЭлемент();
	Личность.ПользовательИдентификатор = ПользовательИдентификатор;
	Личность.Издатель = НормИздатель;
	Личность.Субъект = НормСубъект;
	Личность.Email = АдресЛичности(Email);
	Личность.ПредпочтительныйЛогин = ЛогинЛичности(ПредпочтительныйЛогин);
	Личность.Создана = ТекущаяУниверсальнаяДата();
	Личность.Сохранить();

	Возврат Личность;

КонецФункции

// Обновляет справочные данные личности значениями из свежего профиля: и адрес, и логин
// у провайдера меняются, а кабинет показывает именно их. Пустое значение ничего не
// затирает, личность неизвестной пары issuer+subject игнорируется.
//
// Параметры:
//  Издатель - Строка - issuer провайдера.
//  Субъект - Строка - sub у провайдера.
//  Email - Строка - адрес из клеймов текущего входа.
//  ПредпочтительныйЛогин - Строка - preferred_username из клеймов текущего входа
//                          (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Булево - Истина, если запись изменилась.
//
Функция АктуализироватьПрофиль(Знач Издатель, Знач Субъект, Знач Email,
	Знач ПредпочтительныйЛогин = "") Экспорт

	Личность = НайтиЛичность(Издатель, Субъект);
	Если Личность = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Изменилась = Ложь;

	НормEmail = АдресЛичности(Email);
	Если ЗначениеЗаполнено(НормEmail) И Строка(Личность.Email) <> НормEmail Тогда
		Личность.Email = НормEmail;
		Изменилась = Истина;
	КонецЕсли;

	НормЛогин = ЛогинЛичности(ПредпочтительныйЛогин);
	Если ЗначениеЗаполнено(НормЛогин) И Строка(Личность.ПредпочтительныйЛогин) <> НормЛогин Тогда
		Личность.ПредпочтительныйЛогин = НормЛогин;
		Изменилась = Истина;
	КонецЕсли;

	Если Изменилась Тогда
		Личность.Сохранить();
	КонецЕсли;
	Возврат Изменилась;

КонецФункции

// Личности пользователя (кабинет «мои привязки»).
//
// Параметры:
//  ПользовательИдентификатор - Число - идентификатор пользователя.
//
// Возвращаемое значение:
//  Массив из ВнешняяЛичность.
//
Функция ЛичностиПользователя(Знач ПользовательИдентификатор) Экспорт
	Возврат Хранилище.ПолучитьПоПользовательИдентификаторРавно(ПользовательИдентификатор);
КонецФункции

// Отвязывает личность, только если она принадлежит указанному пользователю: чужую
// отвязать нельзя (защита от IDOR, как в отзыве чужого PAT).
//
// Параметры:
//  ПользовательИдентификатор - Число - инициатор.
//  ЛичностьИдентификатор - Число - идентификатор личности.
//
// Возвращаемое значение:
//  Булево - Ложь, если личность не найдена или принадлежит другому пользователю.
//
Функция Отвязать(Знач ПользовательИдентификатор, Знач ЛичностьИдентификатор) Экспорт

	Личность = Хранилище.ПолучитьОдноПоИдентификаторРавно(ЛичностьИдентификатор);
	Если Личность = Неопределено ИЛИ Личность.ПользовательИдентификатор <> ПользовательИдентификатор Тогда
		Возврат Ложь;
	КонецЕсли;
	Хранилище.Удалить(Личность);
	Возврат Истина;

КонецФункции

// Приводит регистр, но НЕ проверяет адрес: битый клейм не должен рушить саму привязку.
Функция АдресЛичности(Знач Email)
	Возврат НРег(СокрЛП(Строка(Email)));
КонецФункции

// Регистр логина у провайдера значим — его показывают человеку как есть.
Функция ЛогинЛичности(Знач ПредпочтительныйЛогин)
	Возврат СокрЛП(Строка(ПредпочтительныйЛогин));
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеВнешнихЛичностей") _Хранилище,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей)

	Хранилище = _Хранилище;
	СервисПользователей = _СервисПользователей;

КонецПроцедуры
