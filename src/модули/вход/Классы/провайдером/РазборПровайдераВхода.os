// Превращает ввод формы администратора в набор полей будущей строки провайдера и проверяет
// его. Правка личность провайдера из ввода не читает — она берётся из прежней строки.

Перем Пресеты;   // ПресетыВхода (oidc)
Перем Издатели;  // ИздателиOAuth2 (oidc) — синтетический издатель ручного провайдера
Перем Валидатор; // ВалидаторАдресаПровайдера (oidc) — SSRF-гейт адресов
Перем Значки;    // РаскладкаСтатики (кит) — закрытый список ключей значков
Перем Тексты;    // ТекстыИнтерфейса (кит)
Перем Ошибки;    // ТекстОшибки (основа) — краткая причина вместо служебной обёртки
Перем Лог;

#Область ПубличныйИнтерфейс

// Маска секрета в открытых представлениях; та же строка, что у настроек хаба.
//
// Возвращаемое значение:
//  Строка.
//
Функция МаскаСекрета() Экспорт
	Возврат "•••";
КонецФункции

// Каноничная форма имени провайдера: нижний регистр без окружающих пробелов.
//
// Параметры:
//  Имя - Строка - сырое имя.
//
// Возвращаемое значение:
//  Строка.
//
Функция НормализованноеИмя(Знач Имя) Экспорт
	Возврат НРег(СокрЛП(Строка(Имя)));
КонецФункции

// Разбор ввода формы заведения провайдера: читает все поля, проверяет имя, пресет,
// протокол и прогоняет адреса через SSRF-гейт.
//
// Параметры:
//  Данные - Структура - поля формы заведения.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число — HTTP-статус отказа), Ошибка (Строка)
//              и поля будущей записи при успехе.
//
Функция ДляСоздания(Знач Данные) Экспорт

	Имя = НормализованноеИмя(ПолеСтруктуры(Данные, "Имя", ""));
	ПроблемаИмени = ПроверитьИмя(Имя);
	Если ЗначениеЗаполнено(ПроблемаИмени) Тогда
		Возврат Отказ(400, ПроблемаИмени);
	КонецЕсли;

	Пресет = НРег(СокрЛП(Строка(ПолеСтруктуры(Данные, "Пресет", ""))));
	Если НЕ Пресеты.Известен(Пресет) Тогда
		Возврат Отказ(400, Тексты.Шаблон("providers.error.preset", Пресет));
	КонецЕсли;

	// протокол определяется ДО набора полей: у «своего провайдера» набор зависит от него
	Протокол = ?(ЗначениеЗаполнено(Пресет), Пресеты.ВидПротокола(Пресет),
		НРег(СокрЛП(Строка(ПолеСтруктуры(Данные, "ВидПротокола", "oidc")))));
	Если Протокол <> "oidc" И Протокол <> "oauth2" Тогда
		Возврат Отказ(400, Тексты.Шаблон("providers.error.protocol", Протокол));
	КонецЕсли;

	Лог.Отладка("Разбор провайдера ""%1"": пресет ""%2"", протокол ""%3""",
		Имя, Пресет, Протокол);

	// поле, которого набор не показывает, он и не принимает: иначе «скрытое» поле
	// правится подделанной формой, и запись расходится с тем, что видит администратор
	Запрещённое = ПервоеЗапрещённоеПоле(Пресет, Протокол, Данные);
	Если ЗначениеЗаполнено(Запрещённое) Тогда
		Лог.Отладка("Разбор провайдера ""%1"": поле ""%2"" набором не показывается —"
			+ " ввод отклонён", Имя, Запрещённое);
		Возврат ОтказПоПолю(Пресет, Протокол, Запрещённое);
	КонецЕсли;

	Значок = ЗначокИзВвода(Пресет, Протокол, Данные, Неопределено);
	Если НЕ Значок.Успех Тогда
		Возврат Значок;
	КонецЕсли;

	Общее = ОбщиеПоля(Данные, Неопределено);
	Если НЕ Общее.Успех Тогда
		Возврат Общее;
	КонецЕсли;

	Если ЗначениеЗаполнено(Пресет) Тогда
		Возврат ПоПресету(Пресет, Имя, Данные, Общее, Протокол, Значок.Значение);
	КонецЕсли;
	Возврат Вручную(Имя, Данные, Общее, Протокол, Значок.Значение);

КонецФункции

// Разбор ввода формы правки. Личность провайдера берётся из прежней строки, а не из ввода.
//
// Параметры:
//  Данные - Структура - изменяемые поля формы.
//  Прежняя - ПровайдерВхода - действующая строка.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Ошибка (Строка) и поля будущей записи.
//
Функция ДляПравки(Знач Данные, Знач Прежняя) Экспорт

	Общее = ОбщиеПоля(Данные, Прежняя);
	Если НЕ Общее.Успех Тогда
		Возврат Общее;
	КонецЕсли;

	Пресет = НРег(СокрЛП(Строка(Прежняя.Пресет)));
	Значок = ЗначокИзВвода(Пресет, Строка(Прежняя.ВидПротокола), Данные, Прежняя);
	Если НЕ Значок.Успех Тогда
		Возврат Значок;
	КонецЕсли;

	Итог = ЗаготовкаИтога(Строка(Прежняя.Имя), Данные);
	// личность — из строки, а не из ввода
	Итог.Вставить("Пресет", Строка(Прежняя.Пресет));
	Итог.Вставить("ВидПротокола", Строка(Прежняя.ВидПротокола));
	Итог.Вставить("Издатель", Строка(Прежняя.Издатель));
	Итог.Вставить("КонечныеТочки", Строка(Прежняя.КонечныеТочки));
	Итог.Вставить("МаппингПрофиля", Строка(Прежняя.МаппингПрофиля));
	// изменяемое — из формы
	Итог.Вставить("Метка", МеткаПравки(Пресет, Данные, Прежняя));
	Итог.Вставить("Значок", Значок.Значение);
	Итог.Вставить("ИдентификаторКлиента", Общее.ИдентификаторКлиента);
	Итог.Вставить("СекретКлиента", Общее.СекретКлиента);
	Итог.Вставить("АдресВозврата", Общее.АдресВозврата);
	// пустая графа областей означает «оставить как было»: незаполненное поле формы не
	// стирает ни прежнее значение, ни умолчание пресета
	Итог.Вставить("Область", СтрокаИлиУмолчание(ПолеСтруктуры(Данные, "Область", ""),
		СтрокаИлиУмолчание(Прежняя.Область,
			Пресеты.УмолчаниеПоля(Пресет, "Область", Строка(Прежняя.ВидПротокола)))));

	Итог.Вставить("Успех", Истина);
	Итог.Вставить("Код", 200);
	Итог.Вставить("Ошибка", "");
	Возврат Итог;

КонецФункции

// Проверяет имя провайдера: оно едет в URL и служит ключом перекрытия окружением,
// отсюда алфавит — латиница, цифры и дефис не по краям.
//
// Параметры:
//  Имя - Строка - нормализованное имя провайдера.
//
// Возвращаемое значение:
//  Строка - причина отказа либо "", если имя годится.
//
Функция ПроверитьИмя(Знач Имя) Экспорт

	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Возврат Тексты.Текст("providers.error.name.empty");
	КонецЕсли;
	Если СтрДлина(Имя) < 2 ИЛИ СтрДлина(Имя) > 32 Тогда
		Возврат Тексты.Текст("providers.error.name.length");
	КонецЕсли;

	Алфавит = "abcdefghijklmnopqrstuvwxyz0123456789-";
	Для Позиция = 1 По СтрДлина(Имя) Цикл
		Если Найти(Алфавит, Сред(Имя, Позиция, 1)) = 0 Тогда
			Возврат Тексты.Текст("providers.error.name.charset");
		КонецЕсли;
	КонецЦикла;
	Если Лев(Имя, 1) = "-" ИЛИ Прав(Имя, 1) = "-" Тогда
		Возврат Тексты.Текст("providers.error.name.dash");
	КонецЕсли;
	Возврат "";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Первое непустое поле ввода, которого набор не разрешает («» — таких нет).
Функция ПервоеЗапрещённоеПоле(Знач Пресет, Знач Протокол, Знач Данные)

	Для Каждого Поле Из Пресеты.ПоляЛичности() Цикл
		Если Пресеты.ПолеРазрешено(Пресет, Поле, Протокол) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(СокрЛП(Строка(ПолеСтруктуры(Данные, Поле, "")))) Тогда
			Возврат Поле;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Отказ называет ближнюю причину: поле чужого протокола отбито протоколом, а не пресетом.
Функция ОтказПоПолю(Знач Пресет, Знач Протокол, Знач Поле)

	Другой = ?(Протокол = "oauth2", "oidc", "oauth2");
	Если Пресеты.ПолеРазрешено(Пресет, Поле, Другой) Тогда
		Возврат Отказ(400, Тексты.Шаблон("providers.error.field.protocol",
			Пресеты.ПодписьПоля(Поле), Пресеты.ПодписьПротокола(Протокол)));
	КонецЕсли;
	Возврат Отказ(400, Тексты.Шаблон("providers.error.field.forbidden",
		Пресеты.ПодписьПоля(Поле), Пресеты.Подпись(Пресет)));

КонецФункции

// Только из закрытого списка СтатикаХаба: значение печатается в адрес картинки.
Функция ЗначокИзВвода(Знач Пресет, Знач Протокол, Знач Данные, Знач Прежняя)

	Умолчание = Пресеты.УмолчаниеПоля(Пресет, "Значок", Протокол);
	Если НЕ Пресеты.ПолеРазрешено(Пресет, "Значок", Протокол) Тогда
		Возврат Разобрано(Умолчание);
	КонецЕсли;

	Прежний = ?(Прежняя = Неопределено, "", НРег(СокрЛП(Строка(Прежняя.Значок))));
	Введённый = НРег(СокрЛП(Строка(ПолеСтруктуры(Данные, "Значок", ""))));
	Если НЕ ЗначениеЗаполнено(Введённый) Тогда
		Возврат Разобрано(?(ЗначениеЗаполнено(Прежний), Прежний, Умолчание));
	КонецЕсли;

	Если Значки.КлючиЗначков().Найти(Введённый) = Неопределено Тогда
		Возврат Отказ(400, Тексты.Шаблон("providers.error.icon", Введённый));
	КонецЕсли;
	Возврат Разобрано(Введённый);

КонецФункции

// У пресета подпись следует за пресетом, у своего провайдера — за формой.
Функция МеткаПравки(Знач Пресет, Знач Данные, Знач Прежняя)

	Если ЗначениеЗаполнено(Пресет) Тогда
		Возврат Пресеты.Подпись(Пресет);
	КонецЕсли;
	Возврат СтрокаИлиУмолчание(ПолеСтруктуры(Данные, "Метка", Прежняя.Метка), Строка(Прежняя.Имя));

КонецФункции

Функция Разобрано(Знач Значение)
	Возврат Новый Структура("Успех, Код, Ошибка, Имя, Значение", Истина, 200, "", "", Значение);
КонецФункции

// Поля, читаемые из формы одинаково в обоих режимах: учётные данные и адрес возврата.
Функция ОбщиеПоля(Знач Данные, Знач Прежняя)

	Секрет = СекретИзВвода(Данные, Прежняя);
	ИдКлиента = СокрЛП(Строка(ПолеСтруктуры(Данные, "ИдентификаторКлиента",
		?(Прежняя = Неопределено, "", Прежняя.ИдентификаторКлиента))));
	Если НЕ ЗначениеЗаполнено(ИдКлиента) Тогда
		Возврат Отказ(400, Тексты.Текст("providers.error.client"));
	КонецЕсли;
	// хаб заводит только конфиденциальных клиентов: публичный клиент (PKCE без секрета)
	// формой не настраивается, и пустая графа здесь означает недозаполненную форму,
	// а не осознанный выбор способа аутентификации
	Если НЕ ЗначениеЗаполнено(Секрет) Тогда
		Возврат Отказ(400, Тексты.Текст("providers.error.secret"));
	КонецЕсли;

	АдресВозврата = СокрЛП(Строка(ПолеСтруктуры(Данные, "АдресВозврата",
		?(Прежняя = Неопределено, "", Прежняя.АдресВозврата))));
	ПроверкаВозврата = Валидатор.ПроверитьАдресВозврата(АдресВозврата);
	Если НЕ ПроверкаВозврата.Ок Тогда
		Возврат Отказ(400, ПроверкаВозврата.Ошибка);
	КонецЕсли;

	Результат = Новый Структура("Успех, Код, Ошибка, Имя", Истина, 200, "", "");
	Результат.Вставить("ИдентификаторКлиента", ИдКлиента);
	Результат.Вставить("СекретКлиента", Секрет);
	Результат.Вставить("АдресВозврата", АдресВозврата);
	Возврат Результат;

КонецФункции

// Заведение по пресету: точки, области и маппинг подставляет библиотека.
Функция ПоПресету(Знач Пресет, Знач Имя, Знач Данные, Знач Общее, Знач Протокол, Знач Значок)

	Настройки = Новый Структура();
	Настройки.Вставить("Имя", Имя);
	Настройки.Вставить("ИдентификаторКлиента", Общее.ИдентификаторКлиента);
	Настройки.Вставить("СекретКлиента", Общее.СекретКлиента);
	Настройки.Вставить("АдресВозврата", Общее.АдресВозврата);
	// подпись кнопки у пресета своя: поля формы для неё нет и ввод её не задаёт
	Настройки.Вставить("Метка", Пресеты.Подпись(Пресет));
	База = ПолеПресетаИзВвода(Пресет, "БазовыйАдрес", Данные);
	Если ЗначениеЗаполнено(База) Тогда
		Настройки.Вставить("БазовыйАдрес", База);
	КонецЕсли;
	Настройки.Вставить("Область", ПолеПресетаИзВвода(Пресет, "Область", Данные));

	Попытка
		Описание = Пресеты.ОписаниеПресета(Пресет, Настройки);
	Исключение
		Возврат ОтказПоИсключению(Тексты.Шаблон("providers.error.preset.rejected", Пресет),
			ОписаниеОшибки());
	КонецПопытки;

	Итог = ЗаготовкаИтога(Имя, Данные);
	Итог.Вставить("Пресет", Пресет);
	Итог.Вставить("ВидПротокола", Протокол);
	Итог.Вставить("Значок", Значок);
	Итог.Вставить("Метка", Строка(ПолеСтруктуры(Описание, "Метка", Имя)));
	Итог.Вставить("Издатель", Строка(ПолеСтруктуры(Описание, "Издатель", "")));
	Итог.Вставить("ИдентификаторКлиента", Общее.ИдентификаторКлиента);
	Итог.Вставить("СекретКлиента", Общее.СекретКлиента);
	Итог.Вставить("АдресВозврата", Общее.АдресВозврата);
	Итог.Вставить("Область", Строка(ПолеСтруктуры(Описание, "Область", "")));
	Точки = Валидатор.ПроверитьНаборТочек(ПолеСтруктуры(Описание, "КонечныеТочки", Неопределено));
	Если НЕ Точки.Ок Тогда
		Возврат Отказ(400, Точки.Ошибка);
	КонецЕсли;
	Итог.Вставить("КонечныеТочки", ВJSON(Точки.Точки));
	Итог.Вставить("МаппингПрофиля", ВJSON(ПолеСтруктуры(Описание, "МаппингПрофиля", Неопределено)));

	Возврат ПроверитьАдреса(Итог, Точки.Точки);

КонецФункции

// Пустая графа означает «умолчание»: незаполненное поле не стирает подставленное пресетом.
Функция ПолеПресетаИзВвода(Знач Пресет, Знач Поле, Знач Данные)

	Умолчание = Пресеты.УмолчаниеПоля(Пресет, Поле);
	Если НЕ Пресеты.ПолеРазрешено(Пресет, Поле) Тогда
		Возврат Умолчание;
	КонецЕсли;
	Возврат СтрокаИлиУмолчание(ПолеСтруктуры(Данные, Поле, ""), Умолчание);

КонецФункции

// Заведение вручную: администратор задаёт всё сам, и всё проверяется SSRF-гейтом.
Функция Вручную(Знач Имя, Знач Данные, Знач Общее, Знач Протокол, Знач Значок)

	Итог = ЗаготовкаИтога(Имя, Данные);
	Итог.Вставить("Пресет", Пресеты.БезПресета());
	Итог.Вставить("ВидПротокола", Протокол);
	Итог.Вставить("Значок", Значок);
	Итог.Вставить("Метка", СтрокаИлиУмолчание(ПолеСтруктуры(Данные, "Метка", ""), Имя));
	Итог.Вставить("ИдентификаторКлиента", Общее.ИдентификаторКлиента);
	Итог.Вставить("СекретКлиента", Общее.СекретКлиента);
	Итог.Вставить("АдресВозврата", Общее.АдресВозврата);
	Итог.Вставить("Область", СтрокаИлиУмолчание(ПолеСтруктуры(Данные, "Область", ""),
		Пресеты.УмолчаниеПоля(Пресеты.БезПресета(), "Область", Протокол)));

	// При дискавери конечные точки приходят из документа издателя, поэтому из ввода они
	// не читаются вовсе — набор их и не показывал.
	Точки = ?(Протокол = "oauth2", ТочкиИзВвода(Данные), Новый Соответствие());

	Если Протокол = "oauth2" Тогда
		Для Каждого КиЗ Из ОбязательныеТочкиOAuth2() Цикл
			Если Точки.Получить(КиЗ.Ключ) = Неопределено Тогда
				Возврат Отказ(400, Тексты.Шаблон("providers.error.endpoint", КиЗ.Значение));
			КонецЕсли;
		КонецЦикла;
		// сначала адреса, потом издатель: он строится по хосту точки авторизации, и
		// выводить ключ личности из непроверенной гейтом строки нельзя
		ПроверкаТочек = Валидатор.ПроверитьНаборТочек(Точки);
		Если НЕ ПроверкаТочек.Ок Тогда
			Возврат Отказ(400, ПроверкаТочек.Ошибка);
		КонецЕсли;
		Попытка
			Итог.Вставить("Издатель", Издатели.ИздательПоАдресуАвторизации(Точки.Получить("Авторизация"), Пресеты.Ключи()));
		Исключение
			Возврат ОтказПоИсключению(Тексты.Текст("providers.error.issuer.derive"), ОписаниеОшибки());
		КонецПопытки;
	Иначе
		Итог.Вставить("Издатель", СокрЛП(Строка(ПолеСтруктуры(Данные, "Издатель", ""))));
	КонецЕсли;

	Итог.Вставить("КонечныеТочки", ?(Точки.Количество() = 0, "", ВJSON(Точки)));
	Итог.Вставить("МаппингПрофиля", "");

	Возврат ПроверитьАдреса(Итог, Точки);

КонецФункции

// Литерал имени поля обязан стоять первым аргументом, иначе страж строк читает его как текст.
Функция ТочкиИзВвода(Знач Данные)

	Точки = Новый Соответствие();
	Авторизация = СокрЛП(Строка(ПолеСтруктуры(Данные, "АдресАвторизации", "")));
	Если ЗначениеЗаполнено(Авторизация) Тогда
		Точки.Вставить("Авторизация", Авторизация);
	КонецЕсли;
	АдресТокена = СокрЛП(Строка(ПолеСтруктуры(Данные, "АдресТокена", "")));
	Если ЗначениеЗаполнено(АдресТокена) Тогда
		Точки.Вставить("Токен", АдресТокена);
	КонецЕсли;
	АдресПрофиля = СокрЛП(Строка(ПолеСтруктуры(Данные, "АдресПрофиля", "")));
	Если ЗначениеЗаполнено(АдресПрофиля) Тогда
		Точки.Вставить("Профиль", АдресПрофиля);
	КонецЕсли;
	АдресПисем = СокрЛП(Строка(ПолеСтруктуры(Данные, "АдресEmails", "")));
	Если ЗначениеЗаполнено(АдресПисем) Тогда
		Точки.Вставить("Emails", АдресПисем);
	КонецЕсли;
	Возврат Точки;

КонецФункции

// SSRF-гейт: издатель + каждая заданная конечная точка.
Функция ПроверитьАдреса(Итог, Знач НаборТочек)

	ПроверкаИздателя = Валидатор.ПроверитьИздателя(Итог.Издатель, Итог.ВидПротокола);
	Если НЕ ПроверкаИздателя.Ок Тогда
		Возврат Отказ(400, ПроверкаИздателя.Ошибка);
	КонецЕсли;

	ПроверкаТочек = Валидатор.ПроверитьНаборТочек(НаборТочек);
	Если НЕ ПроверкаТочек.Ок Тогда
		Возврат Отказ(400, ПроверкаТочек.Ошибка);
	КонецЕсли;

	Итог.Вставить("Успех", Истина);
	Итог.Вставить("Код", 200);
	Итог.Вставить("Ошибка", "");
	Возврат Итог;

КонецФункции

// Политики хаба и признак включённости — одинаково в обоих режимах.
Функция ЗаготовкаИтога(Знач Имя, Знач Данные)

	Итог = Новый Структура();
	Итог.Вставить("Имя", Имя);
	Итог.Вставить("ИмяКлеймаГрупп", СтрокаИлиУмолчание(ПолеСтруктуры(Данные, "ИмяКлеймаГрупп", ""), "groups"));
	Итог.Вставить("АвтоСоздание", ПолеСтруктуры(Данные, "АвтоСоздание", Ложь) = Истина);
	Итог.Вставить("ПровижинингГрупп", ПолеСтруктуры(Данные, "ПровижинингГрупп", Ложь) = Истина);
	Итог.Вставить("СвязкаГруппПоИмени", ПолеСтруктуры(Данные, "СвязкаГруппПоИмени", Ложь) = Истина);
	Итог.Вставить("ПрефиксГрупп", НРег(СокрЛП(Строка(ПолеСтруктуры(Данные, "ПрефиксГрупп", "")))));
	Итог.Вставить("Включён", ПолеСтруктуры(Данные, "Включён", Ложь) = Истина);
	Возврат Итог;

КонецФункции

// Пустое поле и маска означают «оставить прежний»: иначе маска записалась бы как client_secret.
Функция СекретИзВвода(Знач Данные, Знач Прежняя)

	Введённый = СокрЛП(Строка(ПолеСтруктуры(Данные, "СекретКлиента", "")));
	Если Введённый = МаскаСекрета() Тогда
		Введённый = "";
	КонецЕсли;
	Если ЗначениеЗаполнено(Введённый) Тогда
		Возврат Введённый;
	КонецЕсли;
	Возврат ?(Прежняя = Неопределено, "", Строка(Прежняя.СекретКлиента));

КонецФункции

// Точки, без которых OAuth2-провайдер не работает: discovery у него нет.
Функция ОбязательныеТочкиOAuth2()
	Имена = Новый Соответствие();
	Имена.Вставить("Авторизация", Тексты.Текст("providers.role.authorize"));
	Имена.Вставить("Токен", Тексты.Текст("providers.role.token"));
	Имена.Вставить("Профиль", Тексты.Текст("providers.role.profile"));
	Возврат Имена;
КонецФункции

Функция Отказ(Знач Код, Знач Причина)
	Возврат Новый Структура("Успех, Код, Ошибка, Имя", Ложь, Код, Причина, "");
КонецФункции

// На экран — своя формулировка плюс краткая причина, в журнал — описание целиком.
Функция ОтказПоИсключению(Знач Пояснение, Знач ОписаниеИсключения)

	Лог.Предупреждение("Провайдер входа не заведён: %1 | %2",
		Пояснение, Ошибки.Однострочно(ОписаниеИсключения));

	Причина = Ошибки.Кратко(ОписаниеИсключения);
	Возврат Отказ(400, ?(ЗначениеЗаполнено(Причина), Пояснение + " (" + Причина + ")", Пояснение));

КонецФункции

Функция КакСоответствие(Знач Значение_)
	Если ТипЗнч(Значение_) = Тип("Соответствие") Тогда
		Возврат Значение_;
	КонецЕсли;
	Результат = Новый Соответствие();
	Если ТипЗнч(Значение_) = Тип("Структура") Тогда
		Для Каждого КиЗ Из Значение_ Цикл
			Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ВJSON(Знач Значение_)
	Если Значение_ = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, КакСоответствие(Значение_));
	Возврат Запись.Закрыть();
КонецФункции

Функция ПолеСтруктуры(Знач Данные, Знач Имя, Знач ПоУмолчанию)
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Найденное = Неопределено;
		Если Данные.Свойство(Имя, Найденное) И Найденное <> Неопределено Тогда
			Возврат Найденное;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Найденное = Данные.Получить(Имя);
		Если Найденное <> Неопределено Тогда
			Возврат Найденное;
		КонецЕсли;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция СтрокаИлиУмолчание(Знач Значение_, Знач ПоУмолчанию)
	Возврат ?(ЗначениеЗаполнено(Значение_), СокрЛП(Строка(Значение_)), ПоУмолчанию);
КонецФункции

#КонецОбласти

&Прозвище("РазборПровайдераВхода")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПресетыВхода") _Пресеты,
	&Пластилин(Значение = "ИздателиOAuth2") _Издатели,
	&Пластилин(Значение = "ВалидаторАдресаПровайдера") _Валидатор,
	&Пластилин(Значение = "РаскладкаСтатики") _Значки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Лог _Лог = Неопределено)

	Пресеты = _Пресеты;
	Издатели = _Издатели;
	Валидатор = _Валидатор;
	Значки = _Значки;
	Тексты = _Тексты;
	Ошибки = _Ошибки;
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "РазборПровайдераВхода создан без лога — контейнер или тест обязан его передать";
	КонецЕсли;
	Лог = _Лог;

КонецПроцедуры
