// Рогатка старта: говорит встроенной базе, какие страны различать, — это те, что назвали
// действующие правила. Сборку индекса не ждёт: она фоновая, а порт открывается сразу.
// Правил нет — заказ пуст, и файл базы не открывается вовсе.

Перем Геоправило;   // ГеоправилоПровайдера (вход)
Перем Определитель; // ОпределительСтраны (гео)
Перем Ошибки;       // ТекстОшибки (основа)
&Лог
Перем Лог;

// Заказывает базе страны действующих правил. Сбой старт не отменяет: без заказа хаб
// считает страну неизвестной, а неизвестная страна при живом правиле и так закрыта.
//
Процедура ПриЗапускеПриложения() Экспорт

	// собранного механизма правил на этой инсталляции нет — заказывать некому и нечего
	Если Геоправило = Неопределено ИЛИ Определитель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Страны = Геоправило.СтраныПравил();
		Определитель.НаблюдатьСтраны(Страны);
	Исключение
		Пожаловаться(Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Доложить(Страны);

КонецПроцедуры

Процедура Доложить(Знач Страны)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Страны.Количество() = 0 Тогда
		Лог.Отладка("Страны посетителей: правил по стране нет — база стран не читается");
		Возврат;
	КонецЕсли;

	Лог.Информация("Страны посетителей: правила назвали %1 — индекс строится в фоне",
		СтрСоединить(Страны, ", "));

КонецПроцедуры

Процедура Пожаловаться(Знач Причина)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Лог.Ошибка("Страны правил не заказаны базе — страна посетителя останется неизвестной: %1",
		Причина);

КонецПроцедуры

&Прозвище("ЗаказНаблюдаемыхСтран")
&Рогатка(ЗапускатьВФоне = Ложь)
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГеоправилоПровайдера") _Геоправило = Неопределено,
	&Пластилин(Значение = "ОпределительСтраны") _Определитель = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Геоправило = _Геоправило;
	Определитель = _Определитель;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
