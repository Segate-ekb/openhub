// Провайдеры входа, объявленные переменными окружения OSHUB_OIDC_*. Умолчаний здесь нет:
// они живут в сборке описания. Незаданная переменная означает «поле не задано».

Перем Флаги;   // ПриведениеФлагов (основа) — чтение булева из переменной окружения

#Область ПубличныйИнтерфейс

// Описания провайдеров из окружения в порядке объявления в OSHUB_OIDC_PROVIDERS.
//
// Возвращаемое значение:
//  Массив из Структура - сырые поля провайдера; пустой массив, если список не задан.
//
Функция Провайдеры() Экспорт

	Результат = Новый Массив();
	Список = ПолучитьПеременнуюСреды("OSHUB_OIDC_PROVIDERS");
	Если НЕ ЗначениеЗаполнено(Список) Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого СыройИд Из СтрРазделить(Строка(Список), ",", Ложь) Цикл
		Ид = НРег(СокрЛП(Строка(СыройИд)));
		Если ПустаяСтрока(Ид) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Провайдер(Ид));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Провайдер(Знач Ид)

	Префикс = "OSHUB_OIDC_" + ВРег(СтрЗаменить(Ид, "-", "_")) + "_";
	Данные = Новый Структура();
	Данные.Вставить("Имя", Ид);
	Данные.Вставить("Метка", СтрокаИлиУмолчание(ПолучитьПеременнуюСреды(Префикс + "LABEL"), Ид));
	Данные.Вставить("Значок", ПолучитьПеременнуюСреды(Префикс + "ICON"));
	Данные.Вставить("Издатель", ПолучитьПеременнуюСреды(Префикс + "ISSUER"));
	Данные.Вставить("ИдентификаторКлиента", ПолучитьПеременнуюСреды(Префикс + "CLIENT_ID"));
	Данные.Вставить("СекретКлиента", СтрокаИлиУмолчание(ПолучитьПеременнуюСреды(Префикс + "CLIENT_SECRET"), ""));
	Данные.Вставить("АдресВозврата", ПолучитьПеременнуюСреды(Префикс + "REDIRECT_URI"));
	Данные.Вставить("Область", ПолучитьПеременнуюСреды(Префикс + "SCOPES"));
	Данные.Вставить("ИмяКлеймаГрупп", ПолучитьПеременнуюСреды(Префикс + "GROUPS_CLAIM"));
	Данные.Вставить("АвтоСоздание", Флаг(ПолучитьПеременнуюСреды(Префикс + "AUTOPROVISION")));
	Данные.Вставить("ПровижинингГрупп", Флаг(ПолучитьПеременнуюСреды(Префикс + "PROVISION_GROUPS")));
	Данные.Вставить("СвязкаГруппПоИмени", Флаг(ПолучитьПеременнуюСреды(Префикс + "LINK_GROUPS_BY_NAME")));
	Данные.Вставить("ПрефиксГрупп", ПолучитьПеременнуюСреды(Префикс + "GROUP_PREFIX"));
	Возврат Данные;

КонецФункции

// Незаданная переменная — это Ложь: все флаги провайдера выключены по умолчанию.
Функция Флаг(Знач Значение)
	Возврат Флаги.ФлагОкружения(Значение, Ложь);
КонецФункции

Функция СтрокаИлиУмолчание(Знач Значение, Знач ПоУмолчанию)
	Возврат ?(ЗначениеЗаполнено(Значение), СокрЛП(Строка(Значение)), ПоУмолчанию);
КонецФункции

#КонецОбласти

&Прозвище("ПровайдерыИзОкружения")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПриведениеФлагов") _Флаги = Неопределено) Экспорт

	Флаги = ?(_Флаги = Неопределено, Новый ПриведениеФлагов(), _Флаги);

КонецПроцедуры
