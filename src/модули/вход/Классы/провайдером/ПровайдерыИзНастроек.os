// Провайдеры входа из настройки-узла oshub.oidc: список providers и ветка полей на каждого.
// Умолчаний здесь нет — они в сборке описания; незаданное поле значит «не задано».

Перем Узел;    // Соответствие — узел oshub.oidc либо пустое
Перем Флаги;   // ПриведениеФлагов (основа) — чтение булева из настройки

#Область ПубличныйИнтерфейс

// Описания провайдеров в порядке объявления в oshub.oidc.providers.
//
// Возвращаемое значение:
//  Массив из Структура - сырые поля провайдера; пустой массив, если список не задан.
//
Функция Провайдеры() Экспорт

	Результат = Новый Массив();
	Список = Поле(Узел, "providers");
	Если НЕ ЗначениеЗаполнено(Список) Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого СыройИд Из СтрРазделить(Строка(Список), ",", Ложь) Цикл
		Ид = НРег(СокрЛП(Строка(СыройИд)));
		Если ПустаяСтрока(Ид) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Провайдер(Ид));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Провайдер(Знач Ид)

	Ветка = Поле(Узел, Ид);
	Если ТипЗнч(Ветка) <> Тип("Соответствие") Тогда
		Ветка = Новый Соответствие();
	КонецЕсли;

	Данные = Новый Структура();
	Данные.Вставить("Имя", Ид);
	Данные.Вставить("Метка", СтрокаИлиУмолчание(Поле(Ветка, "label"), Ид));
	Данные.Вставить("Значок", Поле(Ветка, "icon"));
	Данные.Вставить("Издатель", Поле(Ветка, "issuer"));
	Данные.Вставить("ИдентификаторКлиента", Поле(Ветка, "client_id"));
	Данные.Вставить("СекретКлиента", СтрокаИлиУмолчание(Поле(Ветка, "client_secret"), ""));
	Данные.Вставить("АдресВозврата", Поле(Ветка, "redirect_uri"));
	Данные.Вставить("Область", Поле(Ветка, "scopes"));
	Данные.Вставить("ИмяКлеймаГрупп", Поле(Ветка, "groups_claim"));
	Данные.Вставить("АвтоСоздание", Флаг(Поле(Ветка, "autoprovision")));
	Данные.Вставить("ПровижинингГрупп", Флаг(Поле(Ветка, "provision_groups")));
	Данные.Вставить("СвязкаГруппПоИмени", Флаг(Поле(Ветка, "link_groups_by_name")));
	Данные.Вставить("ПрефиксГрупп", Поле(Ветка, "group_prefix"));
	Возврат Данные;

КонецФункции

// Поле ищется без учёта регистра: из окружения ветка приходит в написании переменной.
Функция Поле(Знач Ветка, Знач Имя)

	Для Каждого Элемент Из Ветка Цикл
		Если НРег(Элемент.Ключ) = Имя Тогда
			Возврат Элемент.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Незаданный флаг — это Ложь: все флаги провайдера выключены по умолчанию.
Функция Флаг(Знач Значение)
	Возврат Флаги.ФлагОкружения(Значение, Ложь);
КонецФункции

Функция СтрокаИлиУмолчание(Знач Значение, Знач ПоУмолчанию)
	Возврат ?(ЗначениеЗаполнено(Значение), СокрЛП(Строка(Значение)), ПоУмолчанию);
КонецФункции

#КонецОбласти

&Прозвище("ПровайдерыИзНастроек")
&Желудь
Процедура ПриСозданииОбъекта(
	&Деталька(Значение = "oshub.oidc", ЗначениеПоУмолчанию = "") _Узел = "",
	&Пластилин(Значение = "ПриведениеФлагов") _Флаги = Неопределено) Экспорт

	Узел = ?(ТипЗнч(_Узел) = Тип("Соответствие"), _Узел, Новый Соответствие());
	Флаги = ?(_Флаги = Неопределено, Новый ПриведениеФлагов(), _Флаги);

КонецПроцедуры
