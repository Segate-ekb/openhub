// Действующая конфигурация провайдеров входа: на каждого настроенного — свой
// ВходЧерезПровайдера библиотеки и описание для хаба (протокольные поля, развёрнутые
// библиотекой, плюс политики: автосоздание учёток, механизмы групп, префикс имён).
//
// Два источника: база (форма администратора) и окружение OSHUB_OIDC_* поверх неё —
// провайдер с тем же именем перекрывается целиком, слияние по полям дало бы
// конфигурацию, которую невозможно прочитать глазами. Программные регистрации идут
// той же дорогой. Негодный провайдер хаб не роняет — пропускается с предупреждением.

Перем Входы_;             // Соответствие: имя → ВходЧерезПровайдера (oidc-client)
Перем Описания_;          // Соответствие: имя → Структура (протокол + политики хаба)
Перем Порядок_;           // Массив имён в порядке регистрации
Перем Устарел_;           // Булево — источники изменились, конфигурацию нужно пересобрать
Перем Оверрайды_;         // Соответствие: имя → сырое описание (env + программные)
Перем ПорядокОверрайдов_; // Массив имён оверрайдов в порядке объявления
Перем База_;              // ПровайдерыИзБазы (oidc) либо Неопределено
Перем Сессия_;            // СессияИсходящегоHTTP (сеть) либо Неопределено — шов сети
Перем Лог;

// Вход через названного провайдера. Объект ведёт одного провайдера и держит снимок
// его конфигурации: пересборка подменяет ссылку, а не правит выданный объект.
//
// Параметры:
//  Имя - Строка - имя провайдера; регистр не значим.
//
// Возвращаемое значение:
//  ВходЧерезПровайдера, Неопределено - Неопределено, если провайдер не настроен.
//
Функция Вход(Знач Имя) Экспорт
	ОбеспечитьАктуальность();
	Возврат Входы_.Получить(НРег(СокрЛП(Строка(Имя))));
КонецФункции

// Помечает конфигурацию устаревшей: следующее чтение пересоберёт её из источников.
// Зовётся после каждой мутации таблицы провайдеров — правка действует без рестарта,
// но и без похода в базу на каждый рендер страницы входа.
//
Процедура Перечитать() Экспорт
	Устарел_ = Истина;
КонецПроцедуры

// Пересобирает действующую конфигурацию: база, поверх неё окружение.
// Вызывающий, который держит ссылку на реестр, обязан позвать её сам.
//
Процедура Актуализировать() Экспорт

	// Собираем новый реестр и подменяем ссылку, а не чистим действующий на месте: иначе
	// параллельный запрос видит полупустую конфигурацию — нет кнопок входа, unknown_provider.
	СвежиеВходы = Новый Соответствие();
	СвежиеОписания = Новый Соответствие();
	СвежийПорядок = Новый Массив();

	Если База_ <> Неопределено Тогда
		Для Каждого Данные Из База_.Провайдеры() Цикл
			Попытка
				Зарегистрировать(СвежиеВходы, СвежиеОписания, СвежийПорядок, СыроеОписание(Данные));
			Исключение
				Лог.Предупреждение("OIDC-провайдер <%1> из базы пропущен: %2",
					Строка(Данные.Имя), ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	// окружение и программные регистрации — поверх базы, перекрывая одноимённых
	Для Каждого Имя Из ПорядокОверрайдов_ Цикл
		Зарегистрировать(СвежиеВходы, СвежиеОписания, СвежийПорядок, Оверрайды_.Получить(Имя));
	КонецЦикла;

	Входы_ = СвежиеВходы;
	Описания_ = СвежиеОписания;
	Порядок_ = СвежийПорядок;
	Устарел_ = Ложь;

КонецПроцедуры

// Одна регистрация. Негодное описание бросает исключение — провайдер пропускается
// с предупреждением, а хаб поднимается. Имя берётся у библиотеки: так она и хаб
// заведомо зовут провайдера одинаково.
Процедура Зарегистрировать(Входы, Описания, Порядок, Знач Сырое)

	Вход = Новый ВходЧерезПровайдера(ПротокольныеПоля(Сырое), НастройкиВхода());
	Имя = Вход.Имя();

	Если Описания.Получить(Имя) = Неопределено Тогда
		Порядок.Добавить(Имя);
	КонецЕсли;
	Входы.Вставить(Имя, Вход);
	Описания.Вставить(Имя, КОписаниюХаба(Вход.Описание(), Сырое));
	ПредупредитьОПустомПрефиксе(Описания.Получить(Имя));

КонецПроцедуры

// Пересборка по признаку устаревания: в установившемся состоянии чтение — это возврат
// готовой ссылки, без похода в базу.
Процедура ОбеспечитьАктуальность()
	Если Устарел_ Тогда
		Актуализировать();
	КонецЕсли;
КонецПроцедуры

// Перекрыт ли провайдер окружением или программной регистрацией. Нужно витрине админки:
// иначе администратор правит строку базы, которая ни на что не влияет.
//
// Параметры:
//  Имя - Строка - имя провайдера.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПерекрытОкружением(Знач Имя) Экспорт
	Возврат Оверрайды_.Получить(НРег(СокрЛП(Строка(Имя)))) <> Неопределено;
КонецФункции

// Список провайдеров в порядке регистрации.
//
// Возвращаемое значение:
//  Массив из Структура - описание провайдера: протокольные поля модели плюс
//                        прикладные политики хаба.
//
Функция Провайдеры() Экспорт
	ОбеспечитьАктуальность();
	Результат = Новый Массив();
	Для Каждого Имя Из Порядок_ Цикл
		Результат.Добавить(Описания_.Получить(Имя));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Провайдер по имени; регистр имени не значим.
//
// Параметры:
//  Имя - Строка - имя провайдера.
//
// Возвращаемое значение:
//  Структура, Неопределено - описание провайдера.
//
Функция Провайдер(Знач Имя) Экспорт
	ОбеспечитьАктуальность();
	Возврат Описания_.Получить(НРег(СокрЛП(Строка(Имя))));
КонецФункции

// Есть ли хотя бы один настроенный провайдер — показывать ли блок входа через провайдера.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьПровайдеры() Экспорт
	ОбеспечитьАктуальность();
	Возврат Порядок_.Количество() > 0;
КонецФункции

// Регистрирует или перекрывает провайдера программно — путь env-загрузки и тестов.
// Отсутствие обязательных полей — исключение.
//
// Параметры:
//  Данные - Структура, Соответствие - поля провайдера.
//
// Возвращаемое значение:
//  Структура - нормализованное описание провайдера.
//
Функция ДобавитьПровайдер(Знач Данные) Экспорт

	// вход строится сразу: негодное описание обязано упасть здесь, а не потеряться
	// предупреждением при пересборке конфигурации
	Сырое = СыроеОписание(Данные);
	Имя = Новый ВходЧерезПровайдера(ПротокольныеПоля(Сырое), НастройкиВхода()).Имя();

	Если Оверрайды_.Получить(Имя) = Неопределено Тогда
		ПорядокОверрайдов_.Добавить(Имя);
	КонецЕсли;
	Оверрайды_.Вставить(Имя, Сырое);

	Актуализировать();
	Возврат Описания_.Получить(Имя);

КонецФункции

// Нужно ли предупредить инсталляцию о пустом префиксе имён групп: с включённым
// механизмом групп и без префикса имена клеймов совпадают с именами локальных групп,
// и их состав (вместе с грантами на пулы) начинает определять администратор IdP.
// Сценарий законный, поэтому это предупреждение, а не отказ; проверяется тестом напрямую.
//
// Параметры:
//  Провайдер - Структура, Неопределено - нормализованное описание провайдера.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПрефиксГруппНуженНоНеЗадан(Знач Провайдер) Экспорт

	Если Провайдер = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Механизм = Провайдер.ПровижинингГрупп ИЛИ Провайдер.СвязкаГруппПоИмени;
	Возврат Механизм И НЕ ЗначениеЗаполнено(Провайдер.ПрефиксГрупп);

КонецФункции

#Область СлужебныеПроцедурыИФункции

// Общая точка сборки описания для env-пути, программного пути и строк базы — иначе
// источники тихо разъезжаются по умолчаниям.
Функция СыроеОписание(Знач Данные)

	Описание = Новый Структура();
	Описание.Вставить("Имя", Поле(Данные, "Имя", ""));
	Описание.Вставить("Метка", Поле(Данные, "Метка", ""));
	// "oidc" (умолчание библиотеки) либо "oauth2" — провайдер без discovery
	Тип_ = НРег(СокрЛП(Строка(Поле(Данные, "Тип", Поле(Данные, "ВидПротокола", "")))));
	Если ЗначениеЗаполнено(Тип_) Тогда
		Описание.Вставить("Тип", Тип_);
	КонецЕсли;
	// пресет разворачивает библиотека — здесь он едет ключом, а не развёрнутыми полями
	Пресет = НРег(СокрЛП(Строка(Поле(Данные, "Пресет", ""))));
	Если ЗначениеЗаполнено(Пресет) Тогда
		Описание.Вставить("Пресет", Пресет);
	КонецЕсли;
	База = СокрЛП(Строка(Поле(Данные, "БазовыйАдрес", "")));
	Если ЗначениеЗаполнено(База) Тогда
		Описание.Вставить("БазовыйАдрес", База);
	КонецЕсли;

	Описание.Вставить("Издатель", Поле(Данные, "Издатель", ""));
	Описание.Вставить("ИдентификаторКлиента", Поле(Данные, "ИдентификаторКлиента", ""));
	Описание.Вставить("СекретКлиента", Поле(Данные, "СекретКлиента", ""));
	Описание.Вставить("АдресВозврата", Поле(Данные, "АдресВозврата", ""));
	// у пресета области свои; заданное значение пресет не перебивает, поэтому умолчание
	// OIDC подставляется только там, где пресета нет
	Область = СтрокаИлиУмолчание(Поле(Данные, "Область", ""),
		?(ЗначениеЗаполнено(Пресет), "", "openid profile email groups"));
	Если ЗначениеЗаполнено(Область) Тогда
		Описание.Вставить("Область", Область);
	КонецЕсли;

	Точки = Поле(Данные, "КонечныеТочки", Неопределено);
	Если Точки <> Неопределено Тогда
		Описание.Вставить("КонечныеТочки", Точки);
	КонецЕсли;
	Маппинг = Поле(Данные, "МаппингПрофиля", Неопределено);
	Если Маппинг <> Неопределено Тогда
		Описание.Вставить("МаппингПрофиля", Маппинг);
	КонецЕсли;

	// политики хаба — плоскими полями рядом: «карман» описания библиотека больше не носит
	Описание.Вставить("Значок", НРег(СокрЛП(Строка(Поле(Данные, "Значок", "")))));
	Описание.Вставить("ИмяКлеймаГрупп", СтрокаИлиУмолчание(Поле(Данные, "ИмяКлеймаГрупп", ""), "groups"));
	Описание.Вставить("АвтоСоздание", Поле(Данные, "АвтоСоздание", Ложь) = Истина);
	Описание.Вставить("ПровижинингГрупп", Поле(Данные, "ПровижинингГрупп", Ложь) = Истина);
	Описание.Вставить("СвязкаГруппПоИмени", Поле(Данные, "СвязкаГруппПоИмени", Ложь) = Истина);
	Описание.Вставить("ПрефиксГрупп", НРег(СокрЛП(Строка(Поле(Данные, "ПрефиксГрупп", "")))));
	Возврат Описание;

КонецФункции

// Только то, что читает библиотека: политики хаба ей не нужны, а лишние поля описания
// она бы приняла молча и тем скрыла опечатку в имени поля.
Функция ПротокольныеПоля(Знач Сырое)

	Результат = Новый Структура();
	Для Каждого Имя Из СтрРазделить("Имя,Тип,Пресет,БазовыйАдрес,Издатель,ИдентификаторКлиента,"
		+ "СекретКлиента,АдресВозврата,Область,КонечныеТочки,МаппингПрофиля", ",") Цикл
		Значение = Неопределено;
		Если Сырое.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
			Результат.Вставить(Имя, Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Сессия отдаётся своя: иначе библиотека заведёт собственную, и тесты входа пошли бы
// в сеть. Несобранная сессия (ручная сборка вне контейнера) — умолчание библиотеки.
Функция НастройкиВхода()
	Возврат ?(Сессия_ = Неопределено, Неопределено, Новый Структура("Сессия", Сессия_));
КонецФункции

// Развёрнутое библиотекой описание плюс политики хаба. Структура, а не объект: потребители
// читают её как плоский набор полей. Издатель, точки, области и маппинг берутся
// РАЗВЁРНУТЫМИ — у пресета их подставила библиотека, и второй копии здесь быть не должно.
Функция КОписаниюХаба(Знач Развёрнутое, Знач Сырое)

	Провайдер = Развёрнутое;
	Провайдер.Вставить("Метка", СтрокаИлиУмолчание(Поле(Сырое, "Метка", ""), Провайдер.Имя));
	// ключ значка кнопки входа: картинку по нему ищет страница входа, и ключ вне
	// закрытого списка там просто не даёт изображения
	Провайдер.Вставить("Значок", Поле(Сырое, "Значок", ""));
	Провайдер.Вставить("ИмяКлеймаГрупп", Поле(Сырое, "ИмяКлеймаГрупп", "groups"));
	Провайдер.Вставить("АвтоСоздание", Поле(Сырое, "АвтоСоздание", Ложь) = Истина);
	Провайдер.Вставить("ПровижинингГрупп", Поле(Сырое, "ПровижинингГрупп", Ложь) = Истина);
	Провайдер.Вставить("СвязкаГруппПоИмени", Поле(Сырое, "СвязкаГруппПоИмени", Ложь) = Истина);
	Провайдер.Вставить("ПрефиксГрупп", Поле(Сырое, "ПрефиксГрупп", ""));
	Возврат Провайдер;

КонецФункции

// Формулировка называет последствие, а не факт: иначе строку в журнале читают как шум.
Процедура ПредупредитьОПустомПрефиксе(Знач Провайдер)

	Если НЕ ПрефиксГруппНуженНоНеЗадан(Провайдер) Тогда
		Возврат;
	КонецЕсли;

	Лог.Предупреждение(
		"OIDC-провайдер <%1>: механизмы групп включены, а префикс имён групп пуст"
		+ " (поле «Префикс имён групп» в /hub/settings/providers либо переменная"
		+ " OSHUB_OIDC_<ID>_GROUP_PREFIX) — значения клейма <%2> сопоставляются"
		+ " с ЛОКАЛЬНЫМИ группами хаба по имени."
		+ " Это значит, что состав локальных групп (и выданные им гранты на пулы) теперь"
		+ " определяет тот, кто управляет клеймами в IdP. Если это не то, чего вы хотите,"
		+ " задайте префикс (например sso-).",
		Провайдер.Имя, Провайдер.ИмяКлеймаГрупп);

КонецПроцедуры

Функция СтрокаИлиУмолчание(Знач Значение, Знач ПоУмолчанию)
	Возврат ?(ЗначениеЗаполнено(Значение), СокрЛП(Строка(Значение)), ПоУмолчанию);
КонецФункции

Функция Поле(Знач Данные, Знач Имя, Знач ПоУмолчанию)
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Значение = ПоУмолчанию;
		Если Данные.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат ПоУмолчанию;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Значение = Данные.Получить(Имя);
		Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ПровайдерыИзБазы") _База = Неопределено,
	&Пластилин(Значение = "СессияИсходящегоHTTP") _Сессия = Неопределено,
	&Пластилин(Значение = "ПровайдерыИзОкружения") _Окружение = Неопределено)

	// Лог параметром, а не полем: инъекция в поле доезжает только ПОСЛЕ конструктора,
	// а предупреждения пишутся из него — и терялись бы вместе с провайдером под Попыткой.
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "КонфигурацияOIDC создана без лога — контейнер или тест обязан его передать";
	КонецЕсли;
	Лог = _Лог;

	База_ = _База;
	Сессия_ = _Сессия;

	Входы_ = Новый Соответствие();
	Описания_ = Новый Соответствие();
	Порядок_ = Новый Массив();
	Устарел_ = Истина;
	Оверрайды_ = Новый Соответствие();
	ПорядокОверрайдов_ = Новый Массив();

	// окружение читается один раз при сборке: переменные процесса по ходу работы не меняются
	Если _Окружение <> Неопределено Тогда
		Для Каждого Данные Из _Окружение.Провайдеры() Цикл
			Попытка
				ДобавитьПровайдер(Данные);
			Исключение
				Лог.Предупреждение("OIDC-провайдер <%1> из окружения пропущен: %2",
					Строка(Данные.Имя), ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
