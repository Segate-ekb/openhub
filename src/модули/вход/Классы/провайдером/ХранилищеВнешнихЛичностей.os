// Хранилище внешних личностей — репозиторий сущности «ВнешняяЛичность».

// BSLLS:UnusedParameters-off

Перем Сам;   // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё

// Личность по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор личности.
//
// Возвращаемое значение:
//  ВнешняяЛичность, Неопределено.
//
&МетодЗапроса
Функция ПолучитьОдноПоИдентификаторРавно(Идентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Все личности пользователя (для кабинета «мои привязки»).
//
// Параметры:
//  ПользовательИдентификатор - Число - идентификатор пользователя хаба.
//
// Возвращаемое значение:
//  Массив из ВнешняяЛичность.
//
&МетодЗапроса
Функция ПолучитьПоПользовательИдентификаторРавно(ПользовательИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Личности сразу нескольких пользователей — один запрос на весь список; идентификаторы
// сравниваются как есть.
//
// Параметры:
//  ПользовательИдентификаторы - Массив из Число - идентификаторы пользователей хаба.
//
// Возвращаемое значение:
//  Массив из ВнешняяЛичность.
//
&МетодЗапроса
Функция ПолучитьПоПользовательИдентификаторВ(ПользовательИдентификаторы) Экспорт
	Возврат Неопределено;
КонецФункции

// Личность по паре issuer+subject.
//
// Параметры:
//  Издатель - Строка - issuer провайдера.
//  Субъект - Строка - sub у провайдера.
//
// Возвращаемое значение:
//  ВнешняяЛичность, Неопределено.
//
&МетодЗапроса
Функция ПолучитьОдноПоИздательРавноИСубъектРавно(Издатель, Субъект) Экспорт
	Возврат Неопределено;
КонецФункции

// Личности нескольких пользователей одним запросом; идентификаторы приводятся к числу.
//
// Параметры:
//  ПользовательИдентификаторы - Массив из Число, Строка - идентификаторы пользователей.
//
// Возвращаемое значение:
//  Массив из ВнешняяЛичность - порядок не гарантируется.
//
Функция ЛичностиПользователей(Знач ПользовательИдентификаторы) Экспорт

	Целые = Новый Массив();
	Для Каждого Идентификатор Из ПользовательИдентификаторы Цикл
		Целые.Добавить(Цел(Идентификатор));
	КонецЦикла;

	Возврат Сам.Достать().ПолучитьПоПользовательИдентификаторВ(Целые);

КонецФункции

// Личность по паре issuer+subject (уникальный ключ личности провайдера).
//
// Параметры:
//  Издатель - Строка - issuer провайдера.
//  Субъект - Строка - sub у провайдера.
//
// Возвращаемое значение:
//  ВнешняяЛичность, Неопределено.
//
Функция НайтиПоЛичности(Знач Издатель, Знач Субъект) Экспорт
	Возврат Сам.Достать().ПолучитьОдноПоИздательРавноИСубъектРавно(Строка(Издатель), Строка(Субъект));
КонецФункции

&ХранилищеСущностей("ВнешняяЛичность")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеВнешнихЛичностей") _Сам)

	Сам = _Сам;

КонецПроцедуры
