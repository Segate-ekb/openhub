// Хранилище OIDC-транзакций поверх СлужбаСессий: одна короткоживущая сессия на попытку
// входа. В куке только ключ-адрес в хранилище; транзакция одноразовая.

Перем СлужбаСессий; // СлужбаСессий (auth)

// Имя куки, в которой едет ключ OIDC-транзакции (не основная сессия).
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяКуки() Экспорт
	Возврат "oshub_oidc_txn";
КонецФункции

// Сохраняет транзакцию и возвращает её ключ для куки. Пользователь сессии — 0: это
// транзиентное состояние, а не аутентификация. Пустая транзакция — исключение.
//
// Параметры:
//  Транзакция - Соответствие - транзакция библиотеки (state, nonce, verifier, провайдер).
//  ПутьВозврата - Строка - куда вернуть человека после входа; едет рядом с транзакцией,
//                 а не через провайдера (необязательный, по умолчанию "").
//  Контекст - Число - идентификатор пользователя для режима ручной привязки, 0 — обычный
//             вход (необязательный, по умолчанию 0).
//
// Возвращаемое значение:
//  Строка - ключ транзакции.
//
Функция Сохранить(Знач Транзакция, Знач ПутьВозврата = "", Знач Контекст = 0) Экспорт

	Если ТипЗнч(Транзакция) <> Тип("Соответствие") ИЛИ Транзакция.Количество() = 0 Тогда
		ВызватьИсключение "ХранительТранзакцийOIDC: нечего сохранять (транзакция не задана)";
	КонецЕсли;

	Данные = Новый Соответствие();
	Данные.Вставить("oidc", Транзакция);
	Данные.Вставить("возврат", Строка(ПутьВозврата));
	// контекст — данные хаба: библиотека транзакцию не расширяет и чужого в ней не носит
	Данные.Вставить("контекст", Цел(Контекст));

	Сессия = СлужбаСессий.Создать(0, Данные, ТТЛСек());
	Возврат Сессия.Идентификатор();

КонецФункции

// Кому привязывается личность по возврату: идентификатор пользователя для ручной
// привязки из кабинета, 0 — обычный вход.
//
// Параметры:
//  Ключ - Строка - ключ транзакции из куки.
//
// Возвращаемое значение:
//  Число - 0, если транзакции нет либо контекст не задавался.
//
Функция Контекст(Знач Ключ) Экспорт

	Сохранённый = Значение(Ключ, "контекст");
	// после сериализации сессия могла отдать число строкой
	Возврат ?(ЗначениеЗаполнено(Сохранённый), Цел(Число(Сохранённый)), 0);

КонецФункции

// Адрес возврата, положенный рядом с транзакцией на старте входа. Значение пришло
// от клиента, поэтому вызывающий обязан проверить его заново, а не доверять хранилищу.
//
// Параметры:
//  Ключ - Строка - ключ транзакции из куки.
//
// Возвращаемое значение:
//  Строка - сохранённый адрес возврата; "" — транзакции нет либо адрес не задавался.
//
Функция ПутьВозврата(Знач Ключ) Экспорт
	Сохранённый = Значение(Ключ, "возврат");
	Возврат ?(Сохранённый = Неопределено, "", Строка(Сохранённый));
КонецФункции

// Читает транзакцию по ключу; возврат по устаревшей ссылке — штатный случай, а не авария.
//
// Параметры:
//  Ключ - Строка - ключ транзакции из куки.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - транзакция библиотеки; Неопределено, если сессии нет,
//                               она истекла или её данные повреждены.
//
Функция Прочитать(Знач Ключ) Экспорт

	OIDC = Значение(Ключ, "oidc");
	Возврат ?(ТипЗнч(OIDC) = Тип("Соответствие"), OIDC, Неопределено);

КонецФункции

// Гасит транзакцию: после callback она повторно не используется.
//
// Параметры:
//  Ключ - Строка - ключ транзакции.
//
Процедура Удалить(Знач Ключ) Экспорт
	Если ЗначениеЗаполнено(Ключ) Тогда
		СлужбаСессий.Завершить(Ключ);
	КонецЕсли;
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Возврат по устаревшей ссылке — штатный случай, а не авария: нет сессии — нет значения.
Функция Значение(Знач Ключ, Знач Имя)

	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Сессия = СлужбаСессий.Получить(Ключ);
	Возврат ?(Сессия = Неопределено, Неопределено, Сессия.Значение(Имя));

КонецФункции

Функция ТТЛСек()
	Возврат 600; // 10 минут на завершение входа
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СлужбаСессий") _СлужбаСессий)

	СлужбаСессий = _СлужбаСессий;

КонецПроцедуры
