// Правило «этот провайдер закрыт для посетителей из названных стран»: единственное место,
// где оно читается и правится. Механизм общий — «функция × страна», — поэтому правило
// живёт своей таблицей под ключом функции, а не колонкой на провайдере.

Перем Хранилище;      // ХранилищеГеоправил (данные)
Перем Справочник;     // СправочникСтран (гео) — что на хабе считается страной
Перем Списки;         // СписокЧерезЗапятую (основа) — разбор ввода через запятую
Перем Конфигурация;   // КонфигурацияOIDC (вход) — включённые провайдеры
Перем ПарольныйВход;  // ПолитикаПарольногоВхода (вход)
Перем Оценка;         // ПоследствияЗакрытияПровайдера (вход) — что увидит администратор
Перем Тексты;         // ТекстыИнтерфейса (кит)
Перем Вердикты;       // Вердикт (основа) — форма ответа
Перем Издатель;       // ИздательСобытий (события) — аудит
Перем ИменаЖурнала;   // ИмяОбъектаАудита (аудит) — вид объекта в журнале
Перем СобытиеЖурнала; // СобытиеАудита (аудит) — форма нагрузки записи
Перем Определитель;   // ОпределительСтраны (гео) — кому заказывать наблюдаемые страны
&Лог
Перем Лог;

Перем Снимок;         // Соответствие: ключ правила -> Строка стран; Неопределено — не читан
Перем ВерсияПравил;   // Число — растёт на каждой записи; снимок, начатый до неё, не публикуется

#Область ПубличныйИнтерфейс

// Правило провайдера. Недоступная таблица правил — исключение: ответом «правил нет»
// сбой чтения не становится никогда, иначе упавшая база молча открывала бы закрытое.
//
// Параметры:
//  ИмяПровайдера - Строка - имя провайдера; регистр не значим.
//
// Возвращаемое значение:
//  Структура - Есть (Булево — колонка непуста), Страны (Массив из Строка — каноничные коды
//              по возрастанию; запись, страной не названная, в список не попадает),
//              Текстом (Строка — колонка как есть).
//
Функция Правило(Знач ИмяПровайдера) Экспорт

	Текстом = СтраныПровайдера(Норм(ИмяПровайдера));

	Возврат Новый Структура("Есть, Страны, Текстом",
		ЗначениеЗаполнено(Текстом), КаноничныеСтраны(Текстом), Текстом);

КонецФункции

// Есть ли на хабе хоть одно геоправило. Там, где правил нет, страну спрашивать не у кого.
// Недоступная таблица правил — исключение, а не ответ «правил нет».
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьПравила() Экспорт
	Возврат Правила().Количество() > 0;
КонецФункции

// Все страны, названные хоть одним правилом: только их хабу и нужно уметь различать.
// Недоступная таблица правил — исключение, а не пустой список.
//
// Возвращаемое значение:
//  Массив из Строка - коды ВРег по возрастанию, без дублей.
//
Функция СтраныПравил() Экспорт

	Собранные = Новый Соответствие();
	Для Каждого КиЗ Из Правила() Цикл
		Для Каждого Код Из КаноничныеСтраны(КиЗ.Значение) Цикл
			Собранные.Вставить(Код, Истина);
		КонецЦикла;
	КонецЦикла;

	Возврат ПоВозрастанию(Собранные);

КонецФункции

// Закрыт ли этот провайдер для посетителя из этой страны. Пустой код означает «страну
// определить не удалось», а не «страна не из списка»: не проверил — отказал, поэтому при
// живом правиле такой посетитель считается закрытым. Недоступная таблица правил —
// исключение, а не ответ «открыт».
//
// Параметры:
//  ИмяПровайдера - Строка - имя провайдера; регистр не значим.
//  КодСтраны - Строка - код ISO 3166-1 alpha-2; регистр и окружающие пробелы не значимы.
//              Пустая строка и всё, что кодом страны не является, читаются как «страна
//              неизвестна».
//
// Возвращаемое значение:
//  Булево - Истина, когда правило у провайдера есть и посетитель под него подпадает.
//
Функция Закрыт(Знач ИмяПровайдера, Знач КодСтраны) Экспорт

	Действующее = Правило(ИмяПровайдера);
	Если НЕ Действующее.Есть Тогда
		Возврат Ложь;
	КонецЕсли;

	Код = Справочник.Канон(КодСтраны);
	Если НЕ ЗначениеЗаполнено(Код) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Действующее.Страны.Найти(Код) <> Неопределено;

КонецФункции

// Обстановка вокруг провайдера, которую администратор видит, ставя правило.
//
// Параметры:
//  ИмяПровайдера - Строка - имя провайдера; регистр не значим.
//
// Возвращаемое значение:
//  Структура - Учёток (Число), ПарольныйВход (Булево), ВосстановлениеПароля (Булево).
//
Функция Обстановка(Знач ИмяПровайдера) Экспорт
	Возврат Оценка.ДляПровайдера(Норм(ИмяПровайдера));
КонецФункции

// Ставит правило провайдеру. Пустой ввод снимает правило. Повторное сохранение того же
// списка записи в журнал не создаёт: журнал показывает изменения, а не нажатия кнопки.
//
// Параметры:
//  Принципал - Структура - принципал запроса (его логин идёт в журнал).
//  ИмяПровайдера - Строка - имя провайдера; регистр не значим.
//  СтраныТекстом - Строка - коды стран через запятую.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число — HTTP-статус), Сообщение (Строка),
//              Страны (Строка — каноничный список после правки).
//
Функция Сохранить(Знач Принципал, Знач ИмяПровайдера, Знач СтраныТекстом) Экспорт

	Имя = Норм(ИмяПровайдера);

	Разбор = РазобратьСтраны(СтраныТекстом);
	Если НЕ Разбор.Успех Тогда
		Возврат Разбор;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Разбор.Страны) Тогда
		Возврат Снять(Принципал, Имя);
	КонецЕсли;

	Предохранитель = ПроверитьПотерюДвери(Имя);
	Если НЕ Предохранитель.Успех Тогда
		Возврат Предохранитель;
	КонецЕсли;

	Было = СтраныПровайдера(Имя);
	Если Разбор.Страны = Было Тогда
		Возврат Успех(Разбор.Страны);
	КонецЕсли;

	Хранилище.Установить(Ключ(Имя), Разбор.Страны, Логин(Принципал), ТекущаяУниверсальнаяДата());
	ЗабытьСнимок();
	ПересмотретьНаблюдаемые();
	ЗаписатьВАудит(Принципал, Имя, Было, Разбор.Страны);

	Возврат Успех(Разбор.Страны);

КонецФункции

// Снимает правило провайдера. Отсутствие правила — не ошибка и не событие журнала.
//
// Параметры:
//  Принципал - Структура - принципал запроса (его логин идёт в журнал).
//  ИмяПровайдера - Строка - имя провайдера; регистр не значим.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка), Страны (Строка — "").
//
Функция Снять(Знач Принципал, Знач ИмяПровайдера) Экспорт

	Имя = Норм(ИмяПровайдера);

	Было = СтраныПровайдера(Имя);
	Если НЕ ЗначениеЗаполнено(Было) Тогда
		Возврат Успех("");
	КонецЕсли;

	Хранилище.Удалить(Ключ(Имя));
	ЗабытьСнимок();
	ПересмотретьНаблюдаемые();
	ЗаписатьВАудит(Принципал, Имя, Было, "");

	Возврат Успех("");

КонецФункции

// Провайдер уходит с хаба — его выключают или удаляют, — и вместе с ним уходит дверь.
// Спрашивают выключение и удаление; правку самого правила судит предохранитель внутри
// Сохранить, и вопрос у обоих один: не останется ли хаб без единой свободной двери.
//
// Параметры:
//  ИмяПровайдера - Строка - провайдер, который перестаёт быть дверью; регистр не значим.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка), Страны (Строка).
//
Функция ПроверитьУходПровайдера(Знач ИмяПровайдера) Экспорт

	// пока на хабе нет ни одного геоправила, выключение и удаление провайдера геоправил
	// не касаются вовсе: «выключить последнего» хаб разрешал и разрешает
	Если НЕ ЕстьПравила() Тогда
		Возврат Успех("");
	КонецЕсли;

	Возврат ПроверитьПотерюДвери(Норм(ИмяПровайдера));

КонецФункции

// Двери среди названных провайдеров. Дверь — тот, через кого войдёт кто угодно: издатель
// у него есть (без издателя вход не собирается вовсе) и правила по стране на нём нет.
// Единственное место, где хаб решает, что считать дверью: его спрашивают и правка правила,
// и выключение, и удаление провайдера, и предохранитель парольного входа.
//
// Параметры:
//  Провайдеры - Массив из Структура - описания провайдеров действующей конфигурации.
//
// Возвращаемое значение:
//  Массив из Структура - те же описания, оставшиеся дверями.
//
Функция Двери(Знач Провайдеры) Экспорт

	Результат = Новый Массив();
	Для Каждого Провайдер Из Провайдеры Цикл
		Если ЗначениеЗаполнено(Норм(Провайдер.Издатель))
			И НЕ ЗначениеЗаполнено(СтраныПровайдера(Норм(Провайдер.Имя))) Тогда
			Результат.Добавить(Провайдер);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Предохранитель

// Последняя дверь при выключенном парольном входе — это весь вход в хаб: отняв её,
// администратор запер бы инсталляцию молча. Что считать дверью, решает Двери() — здесь
// только счёт.
Функция ПроверитьПотерюДвери(Знач Имя)

	Если ПарольныйВход.Включён() Тогда
		Возврат Успех("");
	КонецЕсли;

	Двери = ДвериБезПравил();
	Если Двери.Получить(Имя) = Неопределено ИЛИ Двери.Количество() > 1 Тогда
		Возврат Успех("");
	КонецЕсли;

	Возврат Отказ(409, Тексты.Шаблон("providers.geo.error.last", Имя));

КонецФункции

Функция ДвериБезПравил()

	Результат = Новый Соответствие();
	Для Каждого Провайдер Из Двери(Конфигурация.Провайдеры()) Цикл
		Результат.Вставить(Норм(Провайдер.Имя), Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Разбор

// Канон списка: верхний регистр, по возрастанию, без дублей. Неизвестный код назван
// в отказе им самим — иначе человек не поймёт, какой из пяти введённых хаб не принял.
Функция РазобратьСтраны(Знач СтраныТекстом)

	Собранные = Новый Соответствие();

	Для Каждого Введённое Из Списки.Разобрать(СтраныТекстом, Ложь) Цикл
		Код = Справочник.Канон(Введённое);
		// отказ называет НАБРАННОЕ, а не канон: у не-кода канон пуст, и человек прочитал бы
		// «не код страны: », не узнав, что именно хаб не принял
		Если НЕ ЗначениеЗаполнено(Код) Тогда
			Возврат Отказ(400, Тексты.Шаблон("providers.geo.error.code", Введённое));
		КонецЕсли;
		Собранные.Вставить(Код, Истина);
	КонецЦикла;

	Возврат Успех(СтрСоединить(ПоВозрастанию(Собранные), ","));

КонецФункции

// Колонку мог наполнить не сервис: запись читается каноном справочника, и то, что страной
// не является, из списка выбрасывается. Само правило при этом остаётся ЖИВЫМ — иначе одна
// испорченная запись молча открыла бы провайдера, а неизвестную страну он закрывать обязан.
Функция КаноничныеСтраны(Знач Текстом)

	Собранные = Новый Соответствие();
	Для Каждого Запись Из Списки.Разобрать(Текстом, Ложь) Цикл
		Код = Справочник.Канон(Запись);
		Если ЗначениеЗаполнено(Код) Тогда
			Собранные.Вставить(Код, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат ПоВозрастанию(Собранные);

КонецФункции

Функция ПоВозрастанию(Знач Собранные)

	Список = Новый СписокЗначений();
	Для Каждого КиЗ Из Собранные Цикл
		Список.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Список.СортироватьПоЗначению();

	Результат = Новый Массив();
	Для Каждого Элемент Из Список Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Снимок

// Снимок публикуется подменой ссылки: параллельный запрос видит либо прежнюю таблицу
// правил, либо новую, но никогда — полупустую. Читатель, начавший до чужой записи,
// свой результат НЕ публикует: иначе снятое правило вернулось бы в кэш и жило бы там
// до следующей мутации.
Функция Правила()

	Готовый = Снимок;
	Если Готовый <> Неопределено Тогда
		Возврат Готовый;
	КонецЕсли;

	ВерсияЧтения = ВерсияПравил;
	Свежий = ПрочитатьПравила();

	Если ВерсияЧтения = ВерсияПравил Тогда
		Снимок = Свежий;
	КонецЕсли;

	Возврат Свежий;

КонецФункции

// Строка с пустым списком стран никого не закрывает и правилом не считается: иначе
// «правила есть» отвечало бы Истина там, где закрытых стран нет ни одной.
Функция ПрочитатьПравила()

	Результат = Новый Соответствие();
	Для Каждого Запись Из Хранилище.Все() Цикл
		Страны = СокрЛП(Строка(Запись.Страны));
		Если ЗначениеЗаполнено(Страны) Тогда
			Результат.Вставить(Норм(Запись.Ключ), Страны);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ЗабытьСнимок()
	ВерсияПравил = ВерсияПравил + 1;
	Снимок = Неопределено;
КонецПроцедуры

// Правило изменилось — изменился и список стран, которые хабу нужно различать. Заказ
// сборку не ждёт: она фоновая, и до публикации нового индекса отвечает прежний. Сбой
// заказа правку НЕ отменяет — правило уже записано, а незаказанная страна остаётся
// неизвестной, то есть закрытой.
Процедура ПересмотретьНаблюдаемые()

	Если Определитель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Определитель.НаблюдатьСтраны(СтраныПравил());
	Исключение
		Причина = ОписаниеОшибки();
		Если Лог <> Неопределено Тогда
			Лог.Ошибка("Страны правил не заказаны базе после правки правила: %1", Причина);
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

Функция СтраныПровайдера(Знач Имя)

	Найденное = Правила().Получить(Ключ(Имя));
	Возврат ?(Найденное = Неопределено, "", Найденное);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ключ канона «функция:объект»: вторая функция под геоправилом второй таблицы не потребует.
Функция Ключ(Знач Имя)
	Возврат "вход.провайдер:" + Норм(Имя);
КонецФункции

// В журнал идёт и то, что администратор при этом видел: без обстановки запись отвечает
// на «что изменили», но не на «понимал ли, чем это кончится для людей».
Процедура ЗаписатьВАудит(Знач Принципал, Знач Имя, Знач Было, Знач Стало)

	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Видел = Обстановка(Имя);

	Детали = Новый Структура();
	Детали.Вставить("Имя", Имя);
	Детали.Вставить("было", Было);
	Детали.Вставить("стало", Стало);
	Детали.Вставить("УчётокБезДругогоВхода", Видел.Учёток);
	Детали.Вставить("ПарольныйВход", Видел.ПарольныйВход);
	Детали.Вставить("ВосстановлениеПароля", Видел.ВосстановлениеПароля);

	Издатель.Опубликовать(Издатель.ТипПровайдерВходаИзменён(), СобытиеЖурнала.Собрать(
		Логин(Принципал), "провайдер.геоправило", ИменаЖурнала.Провайдер(Имя), "", Детали));

КонецПроцедуры

Функция Логин(Знач Принципал)
	Если Принципал = Неопределено ИЛИ Принципал.Пользователь = Неопределено Тогда
		Возврат "anonymous";
	КонецЕсли;
	Возврат Строка(Принципал.Пользователь.Логин);
КонецФункции

Функция Норм(Знач Значение)
	Возврат НРег(СокрЛП(Строка(?(Значение = Неопределено, "", Значение))));
КонецФункции

Функция Успех(Знач Страны)
	Возврат Вердикты.УспехСКодом(200, "", Новый Структура("Страны", Страны));
КонецФункции

Функция Отказ(Знач Код, Знач Причина)
	Возврат Вердикты.ОтказСКодом(Код, Причина, Новый Структура("Страны", ""));
КонецФункции

#КонецОбласти

&Желудь
&Наблюдаемый
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеГеоправил") _Хранилище,
	&Пластилин(Значение = "СправочникСтран") _Справочник,
	&Пластилин(Значение = "СписокЧерезЗапятую") _Списки,
	&Пластилин(Значение = "КонфигурацияOIDC") _Конфигурация,
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _ПарольныйВход,
	&Пластилин(Значение = "ПоследствияЗакрытияПровайдера") _Оценка,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ИмяОбъектаАудита") _ИменаЖурнала,
	&Пластилин(Значение = "СобытиеАудита") _Событие,
	&Пластилин(Значение = "ИздательСобытий") _Издатель = Неопределено,
	&Пластилин(Значение = "ОпределительСтраны") _Определитель = Неопределено)

	Хранилище = _Хранилище;
	Справочник = _Справочник;
	Списки = _Списки;
	Конфигурация = _Конфигурация;
	ПарольныйВход = _ПарольныйВход;
	Оценка = _Оценка;
	Тексты = _Тексты;
	ИменаЖурнала = _ИменаЖурнала;
	СобытиеЖурнала = _Событие;
	Издатель = _Издатель;
	Определитель = _Определитель;

	Вердикты = Новый Вердикт();
	Снимок = Неопределено;
	ВерсияПравил = 0;

КонецПроцедуры
