// Провайдеры входа, заведённые формой администратора: строки таблицы ПровайдерыВхода
// в сырые описания. Выключенные строки не отдаются вовсе.

Перем ХранилищеПровайдеров; // ХранилищеПровайдеровВхода (данные) либо Неопределено

#Область ПубличныйИнтерфейс

// Описания включённых провайдеров в порядке строк таблицы.
//
// Возвращаемое значение:
//  Массив из Структура - сырые поля провайдера; пустой массив, если хранилища нет
//                        либо таблица ещё не создана.
//
Функция Провайдеры() Экспорт

	Результат = Новый Массив();
	Если ХранилищеПровайдеров = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Записи = ХранилищеПровайдеров.Все();
	Исключение
		// таблицы ещё нет — конфигурация не обязана падать
		Возврат Результат;
	КонецПопытки;

	Для Каждого Запись Из Записи Цикл
		Если Запись.Включён = Истина Тогда
			Результат.Добавить(Описание(Запись));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Описание(Знач Запись)

	Данные = Новый Структура();
	Данные.Вставить("Имя", Строка(Запись.Имя));
	Данные.Вставить("Метка", Строка(Запись.Метка));
	Данные.Вставить("Значок", Строка(Запись.Значок));
	Данные.Вставить("Тип", Строка(Запись.ВидПротокола));
	// пресет едет ключом: алиасы клеймов колонкой не хранятся, и без него профиль GitHub
	// приезжал бы без preferred_username — библиотека развернёт их сама
	Данные.Вставить("Пресет", Строка(Запись.Пресет));
	Данные.Вставить("Издатель", Строка(Запись.Издатель));
	Данные.Вставить("ИдентификаторКлиента", Строка(Запись.ИдентификаторКлиента));
	Данные.Вставить("СекретКлиента", Строка(Запись.СекретКлиента));
	Данные.Вставить("АдресВозврата", Строка(Запись.АдресВозврата));
	Данные.Вставить("Область", Строка(Запись.Область));
	Данные.Вставить("КонечныеТочки", ИзJSON(Запись.КонечныеТочки));
	Данные.Вставить("МаппингПрофиля", ИзJSON(Запись.МаппингПрофиля));
	Данные.Вставить("ИмяКлеймаГрупп", Строка(Запись.ИмяКлеймаГрупп));
	Данные.Вставить("АвтоСоздание", Запись.АвтоСоздание = Истина);
	Данные.Вставить("ПровижинингГрупп", Запись.ПровижинингГрупп = Истина);
	Данные.Вставить("СвязкаГруппПоИмени", Запись.СвязкаГруппПоИмени = Истина);
	Данные.Вставить("ПрефиксГрупп", Строка(Запись.ПрефиксГрупп));
	Возврат Данные;

КонецФункции

// Пусто или мусор в колонке даёт Неопределено — тогда действуют умолчания библиотеки.
Функция ИзJSON(Знач Значение)

	Текст = СокрЛП(Строка(Значение));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(Текст);
		Разобранное = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат ?(ТипЗнч(Разобранное) = Тип("Соответствие"), Разобранное, Неопределено);

КонецФункции

#КонецОбласти

&Прозвище("ПровайдерыИзБазы")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПровайдеровВхода") _Хранилище = Неопределено)

	// Хранилище необязательно: без модуля данные источником остаётся только окружение.
	// Это безопасно ровно потому, что сужает конфигурацию, а не расширяет её.
	ХранилищеПровайдеров = _Хранилище;

КонецПроцедуры
