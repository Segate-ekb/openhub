// Единственная точка требований к паролю на хабе: адаптер над политикой сложности (pwhash)
// поверх настроек oshub.auth.password.*. max_length — он же anti-DoS-лимит.

#Использовать pwhash

Перем Настройки; // СервисНастроек (настройки) — действующие значения политики

#Область ПубличныйИнтерфейс

// Минимальная допустимая длина пароля.
//
// Возвращаемое значение:
//  Число.
//
Функция МинДлина() Экспорт
	Возврат Политика().МинДлина();
КонецФункции

// Максимальная допустимая длина пароля (она же anti-DoS-лимит хеширования).
//
// Возвращаемое значение:
//  Число.
//
Функция МаксДлина() Экспорт
	Возврат Политика().МаксДлина();
КонецФункции

// Превышает ли пароль максимальную длину. Дешёвая проверка на пути входа до передачи
// значения в KDF: гигантский пароль отвергается, не нагружая хеширование.
//
// Параметры:
//  Пароль - Строка - сырой пароль.
//
// Возвращаемое значение:
//  Булево - Истина, если пароль нужно отвергнуть сразу.
//
Функция ПревышаетМаксимум(Знач Пароль) Экспорт
	Возврат Политика().ПревышаетМаксимум(Пароль);
КонецФункции

// Проверяет пароль на соответствие политике; несоответствие — исключение с текстом
// требований для человека.
//
// Параметры:
//  Пароль - Строка - сырой пароль.
//
Процедура Проверить(Знач Пароль) Экспорт
	Политика().Проверить(Пароль);
КонецПроцедуры

// Соответствует ли пароль политике, не бросая исключение (для предпроверок в UI).
//
// Параметры:
//  Пароль - Строка - сырой пароль.
//
// Возвращаемое значение:
//  Булево.
//
Функция Допустим(Знач Пароль) Экспорт
	Возврат Политика().Допустим(Пароль);
КонецФункции

// Список требований политики человекочитаемым текстом.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Требования() Экспорт
	Возврат Политика().Требования();
КонецФункции

// Однострочное описание требований (например: «длина от 8 до 256 символов; цифра»).
//
// Возвращаемое значение:
//  Строка.
//
Функция ОписаниеОднойСтрокой() Экспорт
	Возврат Политика().ОписаниеОднойСтрокой();
КонецФункции

// Те же требования, но с машинным кодом у каждого: по нему пароль проверяется по мере
// набора, не отправляя его на сервер. Код латиницей — он уезжает в разметку атрибутом.
//
// Возвращаемое значение:
//  Массив из Структура - Код (Строка: "length", "lower", "upper", "digit", "special"
//   либо "" для требования, кода которому здесь нет), Текст (Строка — та же
//   формулировка, что у Требования()), Минимум (Число), Максимум (Число).
//
Функция ТребованияПодробно() Экспорт

	Действующая = Политика();
	Тексты = Действующая.Требования();
	Перечень = КодыТребований();

	Результат = Новый Массив();
	Для Номер = 0 По Тексты.ВГраница() Цикл
		Результат.Добавить(Новый Структура("Код, Текст, Минимум, Максимум",
			?(Номер <= Перечень.ВГраница(), Перечень[Номер], ""),
			Тексты[Номер], Действующая.МинДлина(), Действующая.МаксДлина()));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Флаги читаются тем же выражением, каким передаются в политику: списки не разойдутся.
Функция КодыТребований()

	Результат = Новый Массив();
	Результат.Добавить("length");
	Если Настройки.Значение("oshub.auth.password.require_lowercase") = Истина Тогда
		Результат.Добавить("lower");
	КонецЕсли;
	Если Настройки.Значение("oshub.auth.password.require_uppercase") = Истина Тогда
		Результат.Добавить("upper");
	КонецЕсли;
	Если Настройки.Значение("oshub.auth.password.require_digit") = Истина Тогда
		Результат.Добавить("digit");
	КонецЕсли;
	Если Настройки.Значение("oshub.auth.password.require_special") = Истина Тогда
		Результат.Добавить("special");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Собирается НА ВЫЗОВЕ: правка из формы работает на ближайшей же проверке пароля.
Функция Политика()

	Возврат ХешированиеПаролей.ПолитикаСложности(
		Настройки.Значение("oshub.auth.password.min_length"),
		Настройки.Значение("oshub.auth.password.max_length"),
		Настройки.Значение("oshub.auth.password.require_lowercase"),
		Настройки.Значение("oshub.auth.password.require_uppercase"),
		Настройки.Значение("oshub.auth.password.require_digit"),
		Настройки.Значение("oshub.auth.password.require_special"));

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки)

	Настройки = _Настройки;

КонецПроцедуры
