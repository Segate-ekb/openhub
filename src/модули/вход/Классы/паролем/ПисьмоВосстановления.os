// Тема и текст письма восстановления пароля. Письмо простым текстом: разметки в нём нет,
// а строки приходят из словаря — это то же пользовательское слово, что и на экране.

Перем Тексты;    // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Приглашения; // СервисПриглашений (auth) — срок жизни ссылки
Перем Адрес;     // АдресИнстанса (основа) — чем хаб называет себя в письме

// Тема письма.
//
// Возвращаемое значение:
//  Строка.
//
Функция Тема() Экспорт
	Возврат Тексты.Текст("mail.recover.subject");
КонецФункции

// Текст письма: чья учётка, какой хаб, ссылка, её срок и что делать, если письма
// не просили.
//
// Параметры:
//  Логин - Строка - логин учётной записи.
//  Ссылка - Строка - готовая ссылка установки пароля.
//
// Возвращаемое значение:
//  Строка.
//
Функция Текст(Знач Логин, Знач Ссылка) Экспорт

	Возврат Тексты.Шаблон("mail.recover.body",
		Строка(Логин), Адрес.Базовый(), Строка(Ссылка),
		Тексты.ЧислоТекстом(Приглашения.СрокЖизниДней()));

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисПриглашений") _Приглашения,
	&Пластилин(Значение = "АдресИнстанса") _Адрес)

	Тексты = _Тексты;
	Приглашения = _Приглашения;
	Адрес = _Адрес;

КонецПроцедуры
