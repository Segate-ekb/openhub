// Ведро ограничителя по адресу клиента: канон адреса для IPv4, сеть /64 для IPv6 —
// сменой записи адреса счёт не обходится.

Перем Канон;  // КанонIP (основа)

#Область ПубличныйИнтерфейс

// Ведро адреса: сам адрес для IPv4, сеть /64 для IPv6.
//
// Параметры:
//  Запись - Строка - адрес клиента в любой записи.
//
// Возвращаемое значение:
//  Строка - ведро; пустая строка — адрес неизвестен либо не разобран, ведра ему нет.
//
Функция Ведро(Знач Запись) Экспорт

	Адрес = Канон.Адрес(Запись);
	Если Адрес = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат ?(Адрес.ЭтоIPv4(), Адрес.ВСтроку(), Адрес.СоздатьПрефикс(ШиринаСетиIPv6()).ВСтроку());

КонецФункции

// Ключ ведра с назначением: у подбора ссылки и у входа по паролю замки свои,
// иначе один запирал бы другой.
//
// Параметры:
//  Назначение - Строка - за чем считаются неудачи ("ip", "восстановление", …).
//  Запись - Строка - адрес клиента в любой записи.
//
// Возвращаемое значение:
//  Строка - «назначение:ведро»; пустая строка — адрес неизвестен.
//
Функция Ключ(Знач Назначение, Знач Запись) Экспорт

	Значение = Ведро(Запись);
	Возврат ?(ЗначениеЗаполнено(Значение), Назначение + ":" + Значение, "");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ширина по обычаю раздачи адресов провайдерами: клиенту достаётся /64 целиком.
Функция ШиринаСетиIPv6()
	Возврат 64;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "КанонIP") _Канон) Экспорт
	Канон = _Канон;
КонецПроцедуры
