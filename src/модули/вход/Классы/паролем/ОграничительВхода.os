// Простой in-memory лимитер попыток входа: считает неудачи по ключу и блокирует ключ
// на настраиваемый срок. Ключ формирует вызывающий (логин и IP — независимо).

Перем Попытки;   // Соответствие: ключ -> Структура(Неудач, Неизвестных, ПоследняяНеудача,
                 //                                  ЗаблокированДо, БылЗамок)
Перем Настройки; // СервисНастроек (настройки)

// Разрешена ли попытка входа для ключа (ключ не под блокировкой).
//
// Параметры:
//  Ключ - Строка - логин или адрес клиента.
//  Момент - Дата - момент проверки, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Булево.
//
Функция РазрешёнЛи(Знач Ключ, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Состояние = Попытки.Получить(Ключ);
	Если Состояние = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если ЗначениеЗаполнено(Состояние.ЗаблокированДо) И Состояние.ЗаблокированДо > Сейчас Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Фиксирует неудачную попытку; при достижении порога включает блокировку ключа.
//
// Параметры:
//  Ключ - Строка - логин или адрес клиента.
//  Момент - Дата - момент неудачи, UTC (необязательный, по умолчанию текущий).
//  ЛогинНеизвестен - Булево - попытка пришлась на несуществующую учётку; счётчик таких
//                    попыток и есть агрегат перебора логинов (необязательный,
//                    по умолчанию Ложь).
//
// Возвращаемое значение:
//  Булево - активна ли теперь блокировка ключа.
//
Функция ЗафиксироватьНеудачу(Знач Ключ, Знач Момент = Неопределено,
	Знач ЛогинНеизвестен = Ложь) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Состояние = Попытки.Получить(Ключ);

	Если Состояние = Неопределено
		ИЛИ (ЗначениеЗаполнено(Состояние.ПоследняяНеудача)
			И Состояние.ПоследняяНеудача + СрокБлокировки() <= Сейчас
			И НЕ (ЗначениеЗаполнено(Состояние.ЗаблокированДо) И Состояние.ЗаблокированДо > Сейчас)) Тогда
		// новое окно
		Состояние = Новый Структура("Неудач, Неизвестных, ПоследняяНеудача, ЗаблокированДо, БылЗамок",
			0, 0, '00010101', '00010101', Ложь);
	КонецЕсли;

	Состояние.Неудач = Состояние.Неудач + 1;
	Если ЛогинНеизвестен Тогда
		Состояние.Неизвестных = Состояние.Неизвестных + 1;
	КонецЕсли;
	Состояние.ПоследняяНеудача = Сейчас;
	Если Состояние.Неудач >= МаксимумПопыток() Тогда
		Состояние.ЗаблокированДо = Сейчас + СрокБлокировки();
		Состояние.БылЗамок = Истина;
	КонецЕсли;

	Попытки.Вставить(Ключ, Состояние);
	Возврат ЗначениеЗаполнено(Состояние.ЗаблокированДо) И Состояние.ЗаблокированДо > Сейчас;

КонецФункции

// Сбрасывает счётчик ключа (успешный вход).
//
// Параметры:
//  Ключ - Строка - логин или адрес клиента.
//
Процедура Сбросить(Знач Ключ) Экспорт
	Попытки.Удалить(Ключ);
КонецПроцедуры

// Число оставшихся до блокировки попыток (для сообщений и заголовков).
//
// Параметры:
//  Ключ - Строка - логин или адрес клиента.
//  Момент - Дата - момент проверки, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Число - 0, если ключ уже заблокирован.
//
Функция ОставшихсяПопыток(Знач Ключ, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Если НЕ РазрешёнЛи(Ключ, Сейчас) Тогда
		Возврат 0;
	КонецЕсли;
	Состояние = Попытки.Получить(Ключ);
	Если Состояние = Неопределено Тогда
		Возврат МаксимумПопыток();
	КонецЕсли;
	Остаток = МаксимумПопыток() - Состояние.Неудач;
	Возврат ?(Остаток < 0, 0, Остаток);

КонецФункции

// Сколько неудач записано за ключом в текущем окне.
//
// Параметры:
//  Ключ - Строка - логин или адрес клиента.
//
// Возвращаемое значение:
//  Число - 0, если о ключе ничего не известно.
//
Функция НеудачПодряд(Знач Ключ) Экспорт
	Состояние = Попытки.Получить(Ключ);
	Возврат ?(Состояние = Неопределено, 0, Состояние.Неудач);
КонецФункции

// Сколько неудач окна пришлось на несуществующие учётки — агрегат перебора логинов.
//
// Параметры:
//  Ключ - Строка - логин или адрес клиента.
//
// Возвращаемое значение:
//  Число.
//
Функция НеизвестныхПодряд(Знач Ключ) Экспорт
	Состояние = Попытки.Получить(Ключ);
	Возврат ?(Состояние = Неопределено, 0, Состояние.Неизвестных);
КонецФункции

// Замыкался ли ключ в текущем окне. Спрашивается вместо сравнения счётчика с порогом:
// порог читается из настроек на каждом вызове и между замком и входом может измениться.
//
// Параметры:
//  Ключ - Строка - логин или адрес клиента.
//
// Возвращаемое значение:
//  Булево.
//
Функция БылЗамок(Знач Ключ) Экспорт
	Состояние = Попытки.Получить(Ключ);
	Возврат Состояние <> Неопределено И Состояние.БылЗамок = Истина;
КонецФункции

// До какого момента ключ заперт. Делает запись журнала самоописывающей: по сроку видно,
// когда замок истёк, и отсутствие парной записи о снятии перестаёт что-либо значить.
//
// Параметры:
//  Ключ - Строка - логин или адрес клиента.
//
// Возвращаемое значение:
//  Дата - пустая дата, если ключ не запирался.
//
Функция ЗаблокированДо(Знач Ключ) Экспорт
	Состояние = Попытки.Получить(Ключ);
	Возврат ?(Состояние = Неопределено, '00010101', Состояние.ЗаблокированДо);
КонецФункции

// Порог неудачных попыток; читается у резолвера настроек в месте использования —
// правка действует на следующую же попытку, без рестарта.
//
// Возвращаемое значение:
//  Число.
//
Функция МаксимумПопыток() Экспорт
	Возврат Настройки.Значение("oshub.auth.login.maxattempts");
КонецФункции

// Срок блокировки, секунды.
Функция СрокБлокировки()
	Возврат Настройки.Значение("oshub.auth.login.lockoutseconds");
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки)

	Попытки = Новый Соответствие();
	Настройки = _Настройки;

КонецПроцедуры
