// Интерактивный вход по паролю: проверка учётных данных и открытие серверной сессии.
// Лимит попыток считается по логину и по IP независимо.

Перем СервисПользователей;  // СервисПользователей (auth)
Перем СлужбаСессий;         // СлужбаСессий (auth)
Перем Ограничитель;         // ОграничительВхода (auth)
Перем Ведра;                // ВедроОграничителяПоАдресу (вход) — ключ ведра по адресу
Перем ПарольныйВход;        // ПолитикаПарольногоВхода (auth)
Перем ГейтАдреса;           // ГейтПодтвержденияАдреса (auth)
Перем Издатель;             // ИздательСобытий (события); опционален
Перем ИменаЖурнала;         // ИмяОбъектаАудита (аудит) — вид объекта в журнале
&Лог
Перем Лог;

// Пытается войти по логину и паролю; при успехе открывает сессию.
// Неизвестный логин, неверный пароль и заблокированная учётка неразличимы для клиента.
//
// Параметры:
//  Логин - Строка - логин пользователя.
//  Пароль - Строка - сырой пароль.
//  IP - Строка - адрес клиента для лимита попыток (необязательный, по умолчанию "").
//  Момент - Дата - момент входа, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка: "" | "password_login_disabled" |
//              "rate_limited" | "invalid_credentials" | "email_not_confirmed"),
//              Пользователь (Пользователь, Неопределено — назван только при
//              "email_not_confirmed", когда пароль уже сошёлся),
//              Сессия (СессияХаба, Неопределено). При "email_not_confirmed" добавляется
//              Письмо — исход ГейтПодтвержденияАдреса.НапомнитьПисьмом.
//
Функция ВойтиПоПаролю(Знач Логин, Знач Пароль, Знач IP = "", Знач Момент = Неопределено) Экспорт

	// первой проверкой, до лимитов и до хеширования: выключенный пароль не проверяется вовсе
	Если ПарольныйВход.Выключен() Тогда
		Лог.Отладка("Вход ""%1"": отказ — парольный вход на хабе выключен", Логин);
		Возврат Результат(Ложь, ПричинаВыключен(), Неопределено, Неопределено);
	КонецЕсли;

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);

	КлючЛогин = "login:" + НРег(СокрЛП(Строка(Логин)));
	КлючIP = Ведра.Ключ("ip", IP);

	Если НЕ Ограничитель.РазрешёнЛи(КлючЛогин, Сейчас)
		ИЛИ (ЗначениеЗаполнено(КлючIP) И НЕ Ограничитель.РазрешёнЛи(КлючIP, Сейчас)) Тогда
		Лог.Отладка("Вход ""%1"" с %2: отказ — сработал лимит попыток (учётка заперта до %3,"
			+ " адрес — до %4)", Логин, IP,
			ВUTC(Ограничитель.ЗаблокированДо(КлючЛогин)), ВUTC(Ограничитель.ЗаблокированДо(КлючIP)));
		Возврат Результат(Ложь, "rate_limited", Неопределено, Неопределено);
	КонецЕсли;

	Пользователь = СервисПользователей.НайтиПоЛогину(Логин);

	Если Пользователь = Неопределено
		ИЛИ НЕ Пользователь.Активен
		ИЛИ НЕ СервисПользователей.ПроверитьПароль(Пользователь, Пароль) Тогда
		Лог.Отладка("Вход ""%1"" с %2: отказ — %3", Логин, IP, ПочемуОтказ(Пользователь));
		ЗафиксироватьНеудачу(КлючЛогин, КлючIP, Сейчас, Пользователь = Неопределено);
		// подбор по несуществующему логину учётку не запирает: запирать нечего
		Если Пользователь <> Неопределено И НЕ Ограничитель.РазрешёнЛи(КлючЛогин, Сейчас) Тогда
			ОпубликоватьЗамокУчётки(Пользователь, КлючЛогин, IP, Сейчас);
		КонецЕсли;
		// замок по адресу — след распыления паролей и перебора логинов: учётки разные,
		// источник один, и без этой записи журнал о самой частой атаке молчит
		Если ЗначениеЗаполнено(КлючIP) И НЕ Ограничитель.РазрешёнЛи(КлючIP, Сейчас) Тогда
			ОпубликоватьЗамокАдреса(КлючIP, IP, Сейчас);
		КонецЕсли;
		Возврат Результат(Ложь, "invalid_credentials", Неопределено, Неопределено);
	КонецЕсли;

	// пароль сошёлся, но адрес не подтверждён — сессии не будет, а ссылка уходит заново:
	// человек с потерянным письмом иначе заперт навсегда. Проверка стоит ПОСЛЕ пароля,
	// чтобы состояние чужой учётки не рассказывалось тому, кто пароля не знает
	Если ГейтАдреса.Закрыт(Пользователь) Тогда
		Письмо = ГейтАдреса.НапомнитьПисьмом(Пользователь, IP);
		Лог.Отладка("Вход ""%1"" с %2: отказ — адрес учётки не подтверждён"
			+ " (письмо отправлено: %3, годная ссылка уже была: %4, отказ отправки: %5)",
			Логин, IP, Письмо.Отправлено, Письмо.СсылкаБыла, Письмо.Причина);
		Отказ = Результат(Ложь, ГейтАдреса.Причина(), Пользователь, Неопределено);
		Отказ.Вставить("Письмо", Письмо);
		Возврат Отказ;
	КонецЕсли;

	// флаг читается ДО сброса: после него о бывшем замке спросить уже некого. Именно флаг,
	// а не сравнение счётчика с порогом: порог админ вправе понизить между замком и входом.
	БылЗамок = Ограничитель.БылЗамок(КлючЛогин);
	БылоНеудач = Ограничитель.НеудачПодряд(КлючЛогин);
	Ограничитель.Сбросить(КлючЛогин);
	Если ЗначениеЗаполнено(КлючIP) Тогда
		Ограничитель.Сбросить(КлючIP);
	КонецЕсли;
	Если БылЗамок Тогда
		ОпубликоватьСнятиеЗамка(Пользователь, IP, Сейчас, БылоНеудач);
	КонецЕсли;

	Сессия = СлужбаСессий.Создать(Пользователь.Идентификатор, Неопределено, Неопределено, Сейчас);
	Лог.Отладка("Вход ""%1"" с %2: успех, пользователь #%3, сессия открыта",
		Логин, IP, Пользователь.Идентификатор);
	Возврат Результат(Истина, "", Пользователь, Сессия);

КонецФункции

// Код причины отказа «вход по логину и паролю выключен на хабе».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаВыключен() Экспорт
	Возврат "password_login_disabled";
КонецФункции

// --- служебные ---

// Код, а не фраза: наружу все три случая уходят одним invalid_credentials намеренно.
Функция ПочемуОтказ(Знач Пользователь)

	Если Пользователь = Неопределено Тогда
		Возврат "login_unknown";
	КонецЕсли;
	Если НЕ Пользователь.Активен Тогда
		Возврат "account_disabled";
	КонецЕсли;

	Возврат "password_mismatch";

КонецФункции

Процедура ЗафиксироватьНеудачу(Знач КлючЛогин, Знач КлючIP, Знач Сейчас,
	Знач ЛогинНеизвестен)
	Ограничитель.ЗафиксироватьНеудачу(КлючЛогин, Сейчас, ЛогинНеизвестен);
	Если ЗначениеЗаполнено(КлючIP) Тогда
		Ограничитель.ЗафиксироватьНеудачу(КлючIP, Сейчас, ЛогинНеизвестен);
	КонецЕсли;
КонецПроцедуры

// Запись самоописывающая: несёт срок, до которого вход закрыт, — парной записи о снятии нет.
Процедура ОпубликоватьЗамокУчётки(Знач Пользователь, Знач КлючЛогин, Знач IP, Знач Момент)

	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Детали = Новый Структура();
	Детали.Вставить("логин", Строка(Пользователь.Логин));
	Детали.Вставить("попыток", Ограничитель.НеудачПодряд(КлючЛогин));
	Детали.Вставить("заперт_до", ВUTC(Ограничитель.ЗаблокированДо(КлючЛогин)));

	Данные = Нагрузка(Издатель.ТипВходЗаблокирован(), Детали, IP);
	Данные.Вставить("Объект", ИменаЖурнала.Пользователь(Пользователь.Логин));
	Данные.Вставить("Субъект", ИменаЖурнала.Пользователь(Пользователь.Логин));

	Издатель.Опубликовать(Издатель.ТипВходЗаблокирован(), Данные, Момент);

КонецПроцедуры

// Объект записи — адрес, а не учётка: запирается источник запросов.
Процедура ОпубликоватьЗамокАдреса(Знач КлючIP, Знач IP, Знач Момент)

	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Детали = Новый Структура();
	Детали.Вставить("адрес", Строка(IP));
	Детали.Вставить("попыток", Ограничитель.НеудачПодряд(КлючIP));
	Детали.Вставить("несуществующих_логинов", Ограничитель.НеизвестныхПодряд(КлючIP));
	Детали.Вставить("заперт_до", ВUTC(Ограничитель.ЗаблокированДо(КлючIP)));

	Данные = Нагрузка(Издатель.ТипВходЗаблокирован(), Детали, IP);
	Данные.Вставить("Объект", ИменаЖурнала.Адрес(IP));
	Данные.Вставить("Субъект", "");

	Издатель.Опубликовать(Издатель.ТипВходЗаблокирован(), Данные, Момент);

КонецПроцедуры

Процедура ОпубликоватьСнятиеЗамка(Знач Пользователь, Знач IP, Знач Момент, Знач Неудач)

	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Детали = Новый Структура();
	Детали.Вставить("логин", Строка(Пользователь.Логин));
	Детали.Вставить("попыток", Цел(Неудач));

	Данные = Нагрузка(Издатель.ТипВходРазблокирован(), Детали, IP);
	Данные.Вставить("Объект", ИменаЖурнала.Пользователь(Пользователь.Логин));
	Данные.Вставить("Субъект", ИменаЖурнала.Пользователь(Пользователь.Логин));

	Издатель.Опубликовать(Издатель.ТипВходРазблокирован(), Данные, Момент);

КонецПроцедуры

// Журнал аудита получает ФАКТ замка, а не каждую неудачную попытку: поток попыток — лог доступа.
Функция Нагрузка(Знач ТипСобытия, Знач Детали, Знач IP)

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Детали);

	Данные = Новый Структура();
	Данные.Вставить("Кто", ИменаЖурнала.Система());
	Данные.Вставить("Действие", ТипСобытия);
	Данные.Вставить("ДеталиJSON", Запись.Закрыть());
	Данные.Вставить("АдресIP", Строка(IP));
	Возврат Данные;

КонецФункции

Функция ВUTC(Знач Момент)
	Возврат ?(ЗначениеЗаполнено(Момент), Формат(Момент, "ДФ=""yyyy-MM-ddTHH:mm:ssZ"""), "");
КонецФункции

Функция Результат(Знач Успех, Знач Причина, Знач Пользователь, Знач Сессия)
	Структура = Новый Структура();
	Структура.Вставить("Успех", Успех);
	Структура.Вставить("Причина", Причина);
	Структура.Вставить("Пользователь", Пользователь);
	Структура.Вставить("Сессия", Сессия);
	Возврат Структура;
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "СлужбаСессий") _СлужбаСессий,
	&Пластилин(Значение = "ОграничительВхода") _Ограничитель,
	&Пластилин(Значение = "ВедроОграничителяПоАдресу") _Ведра,
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _ПарольныйВход,
	&Пластилин(Значение = "ГейтПодтвержденияАдреса") _ГейтАдреса,
	&Пластилин(Значение = "ИмяОбъектаАудита") _Имена,
	&Пластилин(Значение = "ИздательСобытий") _Издатель = Неопределено,
	&Лог _Лог = Неопределено)

	СервисПользователей = _СервисПользователей;
	СлужбаСессий = _СлужбаСессий;
	Ограничитель = _Ограничитель;
	Ведра = _Ведра;
	ПарольныйВход = _ПарольныйВход;
	ГейтАдреса = _ГейтАдреса;
	Издатель = _Издатель;
	ИменаЖурнала = _Имена;

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
