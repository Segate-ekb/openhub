// Самостоятельное восстановление пароля: человек называет логин или адрес, хаб шлёт письмо
// со ссылкой. Ссылка уходит только на адрес, подтверждённый собственным письмом хаба.

Перем ПоискУчётки;    // УчёткаПоНазванному (auth) — логин либо адрес из формы
Перем Адреса;         // АдресУчётки (auth) — доказательство владения адресом
Перем Приглашения;    // СервисПриглашений (auth)
Перем АдресСсылки;    // АдресПриглашения (auth)
Перем Письмо;         // ПисьмоВосстановления (auth)
Перем Канал;          // СлужбаЛичныхУведомлений (уведомления) — личный канал хаба
Перем ПарольныйВход;  // ПолитикаПарольногоВхода (auth)

#Область ПубличныйИнтерфейс

// Просит ссылку восстановления для учётки, названной логином или адресом. Исход
// вызывающему ОДИНАКОВ независимо от того, нашлась учётка или нет: перебором логинов
// и адресов существующие учётки не вычисляются. Что произошло на самом деле, знает
// только журнал.
//
// Параметры:
//  ЛогинИлиАдрес - Строка - то, что человек набрал в форме.
//  Момент - Дата - момент запроса, UTC (необязательный, по умолчанию текущий).
//  АдресIP - Строка - адрес клиента для журнала (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Принято (Булево — всегда Истина, пока путь восстановления работает),
//              Причина (Строка — код внутреннего исхода, наружу не показывается).
//
Функция Запросить(Знач ЛогинИлиАдрес, Знач Момент = Неопределено, Знач АдресIP = "") Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Источник = СокрЛП(Строка(АдресIP));

	Причина = Отработать(СокрЛП(Строка(ЛогинИлиАдрес)), Сейчас, Источник);
	Возврат Новый Структура("Принято, Причина", Истина, Причина);

КонецФункции

// Работает ли путь восстановления на этой инсталляции. Страница спрашивает это до формы:
// хаб без почты честно говорит, что письмо слать нечем, а не притворяется работающим.
//
// Возвращаемое значение:
//  Булево.
//
Функция Доступно() Экспорт
	Возврат НЕ ПарольныйВход.Выключен() И Канал.ПочтаНастроена()
		И АдресСсылки.АдресХабаЗадан();
КонецФункции

// Код исхода «ссылка выпущена и письмо ушло».
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсходОтправлено() Экспорт
	Возврат "recover_sent";
КонецФункции

// Код исхода «такой учётки нет» — наружу неотличим от отправленного.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсходНетУчётки() Экспорт
	Возврат "recover_no_user";
КонецФункции

// Код исхода «адрес учётки не доказан собственным подтверждением хаба»: клейма
// провайдера для смены пароля не хватает.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсходАдресНеДоказан() Экспорт
	Возврат "recover_unconfirmed";
КонецФункции

// Код исхода «путь восстановления на хабе не работает» (нет почты, выключен пароль).
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсходНедоступно() Экспорт
	Возврат "recover_unavailable";
КонецФункции

// Код исхода «учётная запись закрыта либо входит только через провайдера».
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсходВходЗакрыт() Экспорт
	Возврат "recover_login_closed";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Порядок проверок: состояние хаба, затем учётка.
Функция Отработать(Знач Названное, Знач Сейчас, Знач Источник)

	Если НЕ Доступно() Тогда
		Возврат ИсходНедоступно();
	КонецЕсли;

	Пользователь = ПоискУчётки.ПоЛогинуИлиАдресу(Названное);
	Если Пользователь = Неопределено Тогда
		Возврат ИсходНетУчётки();
	КонецЕсли;
	Если НЕ Пользователь.Активен = Истина Тогда
		Возврат ИсходВходЗакрыт();
	КонецЕсли;

	// единственное доказательство владения адресом, которое выдал сам хаб
	Если НЕ Адреса.ДоказанХабом(Пользователь) Тогда
		Возврат ИсходАдресНеДоказан();
	КонецЕсли;

	Выпуск = Приглашения.Выпустить(Пользователь, Приглашения.ПоводВосстановление(),
		Строка(Пользователь.Логин), Сейчас, Источник);

	// сам факт выпуска ссылки СервисПриглашений уже записал в журнал; здесь остаётся
	// только исход письма
	Итог = Канал.ПисьмоСоСсылкой(Пользователь, Канал.Поводы().ВосстановлениеПароля(),
		Письмо.Тема(),
		Письмо.Текст(Строка(Пользователь.Логин), АдресСсылки.Ссылка(Выпуск.Значение)));

	Возврат ?(Итог.Успех, ИсходОтправлено(), Итог.Причина);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "УчёткаПоНазванному") _ПоискУчётки,
	&Пластилин(Значение = "АдресУчётки") _Адреса,
	&Пластилин(Значение = "СервисПриглашений") _Приглашения,
	&Пластилин(Значение = "АдресПриглашения") _АдресСсылки,
	&Пластилин(Значение = "ПисьмоВосстановления") _Письмо,
	&Пластилин(Значение = "СлужбаЛичныхУведомлений") _Канал,
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _ПарольныйВход)

	ПоискУчётки = _ПоискУчётки;
	Адреса = _Адреса;
	Приглашения = _Приглашения;
	АдресСсылки = _АдресСсылки;
	Письмо = _Письмо;
	Канал = _Канал;
	ПарольныйВход = _ПарольныйВход;

КонецПроцедуры
