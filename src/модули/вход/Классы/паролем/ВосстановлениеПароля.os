// Самостоятельное восстановление пароля: человек называет логин или адрес, хаб шлёт письмо
// со ссылкой. Ссылка уходит только на адрес, подтверждённый собственным письмом хаба.

Перем ПоискУчётки;    // УчёткаПоНазванному (auth) — логин либо адрес из формы
Перем Адреса;         // АдресУчётки (auth) — доказательство владения адресом
Перем Приглашения;    // СервисПриглашений (auth)
Перем АдресСсылки;    // АдресПриглашения (auth)
Перем Письмо;         // ПисьмоВосстановления (auth)
Перем Канал;          // СлужбаЛичныхУведомлений (уведомления) — личный канал хаба
Перем ПарольныйВход;  // ПолитикаПарольногоВхода (auth)
Перем Летопись;       // ЛетописьУчёток (auth) — исход письма в журнал аудита
Перем Обезличивание;  // ОбезличиваниеЖурнала (наблюдаемость) — адрес клиента без хозяина
Перем Ошибки;         // ТекстОшибки (основа) — набранное человеком в одну строку
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Просит ссылку восстановления для учётки, названной логином или адресом. Исход
// вызывающему ОДИНАКОВ независимо от того, нашлась учётка или нет: перебором логинов
// и адресов существующие учётки не вычисляются. Что произошло на самом деле, называет
// журнал: строка уровня ИНФОРМАЦИЯ на каждый запрос, а для найденной учётки — ещё
// и событие аудита с исходом письма.
//
// Параметры:
//  ЛогинИлиАдрес - Строка - то, что человек набрал в форме.
//  Момент - Дата - момент запроса, UTC (необязательный, по умолчанию текущий).
//  АдресIP - Строка - адрес клиента для журнала (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Принято (Булево — всегда Истина, пока путь восстановления работает),
//              Причина (Строка — код внутреннего исхода, наружу не показывается).
//
Функция Запросить(Знач ЛогинИлиАдрес, Знач Момент = Неопределено, Знач АдресIP = "") Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Источник = СокрЛП(Строка(АдресIP));
	Названное = СокрЛП(Строка(ЛогинИлиАдрес));

	Исход = Отработать(Названное, Сейчас, Источник);

	НазватьИсход(Исход, Источник);
	НазватьНабранное(Исход, Названное);
	// ненайденная учётка в аудит не пишется вовсе: перебором логинов журнал засорялся бы
	// чужими именами
	Если Исход.Пользователь <> Неопределено Тогда
		ЗаписатьИсходПисьма(Исход, Источник);
	КонецЕсли;

	Возврат Новый Структура("Принято, Причина", Истина, Исход.Причина);

КонецФункции

// Работает ли путь восстановления на этой инсталляции. Страница спрашивает это до формы:
// хаб без почты честно говорит, что письмо слать нечем, а не притворяется работающим.
//
// Возвращаемое значение:
//  Булево.
//
Функция Доступно() Экспорт
	Возврат НЕ ПарольныйВход.Выключен() И Канал.ПочтаНастроена()
		И АдресСсылки.АдресХабаЗадан();
КонецФункции

// Код исхода «ссылка выпущена и письмо ушло».
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсходОтправлено() Экспорт
	Возврат "recover_sent";
КонецФункции

// Код исхода «такой учётки нет» — наружу неотличим от отправленного.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсходНетУчётки() Экспорт
	Возврат "recover_no_user";
КонецФункции

// Код исхода «адрес учётки не доказан собственным подтверждением хаба»: клейма
// провайдера для смены пароля не хватает.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсходАдресНеДоказан() Экспорт
	Возврат "recover_unconfirmed";
КонецФункции

// Код исхода «путь восстановления на хабе не работает» (нет почты, выключен пароль).
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсходНедоступно() Экспорт
	Возврат "recover_unavailable";
КонецФункции

// Код исхода «учётная запись закрыта либо входит только через провайдера».
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсходВходЗакрыт() Экспорт
	Возврат "recover_login_closed";
КонецФункции

#КонецОбласти

#Область ХодЗапроса

// Порядок проверок: состояние хаба, затем учётка.
Функция Отработать(Знач Названное, Знач Сейчас, Знач Источник)

	Если НЕ Доступно() Тогда
		Возврат ИсходЗапроса(ИсходНедоступно(), Неопределено);
	КонецЕсли;

	Пользователь = ПоискУчётки.ПоЛогинуИлиАдресу(Названное);
	Если Пользователь = Неопределено Тогда
		Возврат ИсходЗапроса(ИсходНетУчётки(), Неопределено);
	КонецЕсли;
	Если НЕ Пользователь.Активен = Истина Тогда
		Возврат ИсходЗапроса(ИсходВходЗакрыт(), Пользователь);
	КонецЕсли;

	// единственное доказательство владения адресом, которое выдал сам хаб
	Если НЕ Адреса.ДоказанХабом(Пользователь) Тогда
		Возврат ИсходЗапроса(ИсходАдресНеДоказан(), Пользователь);
	КонецЕсли;

	Возврат ИсходЗапроса(ПослатьПисьмо(Пользователь, Сейчас, Источник), Пользователь);

КонецФункции

// Сам факт выпуска ссылки СервисПриглашений уже записал в журнал; здесь остаётся
// только исход письма.
Функция ПослатьПисьмо(Знач Пользователь, Знач Сейчас, Знач Источник)

	Выпуск = Приглашения.Выпустить(Пользователь, Приглашения.ПоводВосстановление(),
		Строка(Пользователь.Логин), Сейчас, Источник);

	Итог = Канал.ПисьмоСоСсылкой(Пользователь, Канал.Поводы().ВосстановлениеПароля(),
		Письмо.Тема(),
		Письмо.Текст(Строка(Пользователь.Логин), АдресСсылки.Ссылка(Выпуск.Значение)));

	Возврат ?(Итог.Успех, ИсходОтправлено(), Итог.Причина);

КонецФункции

Функция ИсходЗапроса(Знач Причина, Знач Пользователь)
	Возврат Новый Структура("Причина, Пользователь", Причина, Пользователь);
КонецФункции

#КонецОбласти

#Область Журнал

// Одна строка на запрос: код говорит, чем кончилось нажатие «забыли пароль», логин —
// для кого, обезличенный адрес — откуда. Значения ссылки здесь нет и быть не может.
Процедура НазватьИсход(Знач Исход, Знач Источник)

	Лог.Информация("Восстановление пароля: исход %1, учётка ""%2"", клиент %3",
		Исход.Причина, ЛогинУчётки(Исход.Пользователь),
		Обезличивание.АдресКлиента(Источник));

КонецПроцедуры

// Единственное место, где набранное называется вслух, и только когда учётки с таким
// именем нет: опечатку человека оператору видно только так. Набирал его аноним, поэтому
// запись схлопывается в одну строку — перевод строки внутри неё это чужая запись журнала.
Процедура НазватьНабранное(Знач Исход, Знач Названное)

	Если Исход.Причина = ИсходНетУчётки() Тогда
		Лог.Отладка("Восстановление пароля: учётки по набранному ""%1"" нет",
			Ошибки.Однострочно(Названное));
	КонецЕсли;

КонецПроцедуры

// В аудит уходит исход письма; самой ссылки в нём нет и быть не может.
Процедура ЗаписатьИсходПисьма(Знач Исход, Знач Источник)

	Отправлено = (Исход.Причина = ИсходОтправлено());
	Детали = Новый Структура("адрес, отправлено, причина",
		Строка(Исход.Пользователь.Email), Отправлено, ?(Отправлено, "", Исход.Причина));

	// инициатор запроса анонимен: принципалом события стоит сама учётка
	Логин = Строка(Исход.Пользователь.Логин);
	Летопись.СобытиеУчётки(Летопись.ДействиеПисьмоВосстановления(), Логин, Логин,
		Детали, Источник);

КонецПроцедуры

// Ненайденную учётку журнал называет прочерком: набранное в строку исхода не попадает.
Функция ЛогинУчётки(Знач Пользователь)
	Возврат ?(Пользователь = Неопределено, "—", Строка(Пользователь.Логин));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "УчёткаПоНазванному") _ПоискУчётки,
	&Пластилин(Значение = "АдресУчётки") _Адреса,
	&Пластилин(Значение = "СервисПриглашений") _Приглашения,
	&Пластилин(Значение = "АдресПриглашения") _АдресСсылки,
	&Пластилин(Значение = "ПисьмоВосстановления") _Письмо,
	&Пластилин(Значение = "СлужбаЛичныхУведомлений") _Канал,
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _ПарольныйВход,
	&Пластилин(Значение = "ЛетописьУчёток") _Летопись,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	ПоискУчётки = _ПоискУчётки;
	Адреса = _Адреса;
	Приглашения = _Приглашения;
	АдресСсылки = _АдресСсылки;
	Письмо = _Письмо;
	Канал = _Канал;
	ПарольныйВход = _ПарольныйВход;
	Летопись = _Летопись;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Обезличивание = Новый ОбезличиваниеЖурнала();
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
