// Допуск ко входу по состоянию адреса: пока обещанное письмом подтверждение не получено,
// парольный вход учётке закрыт. Гейт же и высылает свежую ссылку.

Перем Политика;      // ПолитикаПодтвержденияEmail (auth)
Перем Подтверждение; // СервисПодтвержденияEmail (auth)
Перем Коды;          // КодыПодтверждения (auth) — коды отказов цикла подтверждения
Перем Ошибки;        // ТекстОшибки (основа)
Перем Вердикты;      // Вердикт (основа) — форма ответа
&Лог
Перем Лог;

// Закрыт ли учётной записи вход неподтверждённым адресом.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - учётная запись.
//
// Возвращаемое значение:
//  Булево.
//
Функция Закрыт(Знач Пользователь) Экспорт

	Если Пользователь = Неопределено ИЛИ НЕ Политика.Включено() Тогда
		Возврат Ложь;
	КонецЕсли;

	// учётке без адреса подтверждать нечего: администратор мастера /setup заводится
	// без почты, и хаб, запертый на нём, остался бы вообще без входа
	Если НЕ ЗначениеЗаполнено(Пользователь.Email) Тогда
		Возврат Ложь;
	КонецЕсли;

	// обещанное, но невыполнимое подтверждение никого не запирает: слать ссылку нечем,
	// и запертому нечего нажать. Иначе администратор, включивший подтверждение раньше
	// почты, разом отобрал бы вход у всех, у кого адрес есть
	Если Подтверждение.ПодтверждениеНедостижимо() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НЕ Пользователь.EmailПодтверждён = Истина;

КонецФункции

// Высылает ссылку подтверждения, если нажимать человеку нечего: годной ссылки у учётки
// нет либо она истекла. Живую ссылку письмо не заменяет — выпуск гасит прежнюю, и то
// письмо, которое человек как раз открыл, стало бы недействительным у него в руках.
// Уходит письмо только на адрес самой учётки и только тому, кто назвал верный пароль.
//
// Параметры:
//  Пользователь - Пользователь - чей адрес подтверждается.
//  АдресIP - Строка - адрес клиента для журнала (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка — машинный код отказа, "" при успехе),
//              Сообщение (Строка — текст сорвавшегося выпуска для человека, "" когда
//              выпуск не срывался), СсылкаБыла (Булево — письма не было, потому что
//              годная ссылка уже у него).
//
Функция НапомнитьПисьмом(Знач Пользователь, Знач АдресIP = "") Экспорт

	Если Подтверждение.ЕстьЖиваяСсылка(Пользователь) Тогда
		Возврат ОтказЖиваяСсылка();
	КонецЕсли;

	// логин снимается ДО Попытки: обработчик отказа обязан обойтись тем, что уже на руках.
	// Читай он учётку сам — сбой самой сущности поднял бы второе исключение уже из
	// обработчика, и оно ушло бы наружу мимо отказа
	Логин = Строка(Пользователь.Логин);

	// сорвавшееся письмо не превращает закрытый вход в открытый: человеку остаётся
	// кнопка «выслать заново», а молчащее исключение сделало бы отказ необъяснимым
	Попытка
		Итог = Подтверждение.Запросить(Пользователь, Неопределено, АдресIP);
	Исключение
		Возврат ОтказСорвавшегосяВыпуска(Логин, ИнформацияОбОшибке());
	КонецПопытки;

	Возврат ?(Итог.Успех, ПисьмоУшло(), ОтказСлужбы(Итог.Причина));

КонецФункции

// Код причины отказа «адрес учётной записи не подтверждён».
//
// Возвращаемое значение:
//  Строка.
//
Функция Причина() Экспорт
	Возврат "email_not_confirmed";
КонецФункции

// Письмо ушло: сбоя не было, ссылки на руках не было.
Функция ПисьмоУшло()
	Возврат Вердикты.Успех(Поля("", Ложь));
КонецФункции

// Служба подтверждения отказала своим кодом — его и передаём дальше как есть.
Функция ОтказСлужбы(Знач Код)
	Возврат Вердикты.Отказ(Код, Поля("", Ложь));
КонецФункции

// Годная ссылка у человека уже на руках: выпуск следующей погасил бы ту, которую он
// как раз открыл, — поэтому письма нет, и отказ говорит об этом кодом.
Функция ОтказЖиваяСсылка()
	Возврат Вердикты.Отказ(Коды.ЖиваяСсылка(), Поля("", Истина));
КонецФункции

// Код отказа сверяют с константой, а слова сбоя показывают человеку — поэтому едут они
// РАЗНЫМИ полями, а подробность дублируется в журнал по правилам НФТ-ЭКСП-012.
Функция ОтказСорвавшегосяВыпуска(Знач Логин, Знач Сбой)

	Лог.Ошибка("Подтверждение адреса учётки ""%1"": выпуск ссылки сорвался исключением: %2",
		Логин, Ошибки.Причина(Сбой));
	// отчёт стои́т разбора цепочки: собираем его только тогда, когда отладку включили
	Если Лог.Уровень() <= УровниЛога.Отладка Тогда
		Лог.Отладка("Подтверждение адреса учётки ""%1"": разбор сбоя целиком:%2%3",
			Логин, Символы.ПС, Ошибки.ПодробныйОтчёт(Сбой));
	КонецЕсли;

	Возврат Вердикты.Отказ(Коды.Сорвалось(), Поля(Ошибки.ДляЧеловека(Сбой), Ложь));

КонецФункции

// Нагрузка ответа. Пара «Успех/Отказ» несёт ОДИН набор полей: и слова сбоя, и признак
// живой ссылки названы в обеих половинах, иначе читатель удачи спрашивал бы
// отсутствующее поле.
Функция Поля(Знач Сообщение, Знач СсылкаБыла)
	Возврат Новый Структура("Сообщение, СсылкаБыла", Сообщение, СсылкаБыла);
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПолитикаПодтвержденияEmail") _Политика,
	&Пластилин(Значение = "СервисПодтвержденияEmail") _Подтверждение,
	&Пластилин(Значение = "КодыПодтверждения") _Коды,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "Вердикт") _Вердикты = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Вердикты = ?(_Вердикты = Неопределено, Новый Вердикт(), _Вердикты);
	Политика = _Политика;
	Подтверждение = _Подтверждение;
	Коды = _Коды;

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
