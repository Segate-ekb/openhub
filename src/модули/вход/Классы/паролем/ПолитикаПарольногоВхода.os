// Единственная точка ответа «работает ли на хабе вход по логину и паролю»; правку
// состояния держит СтражПарольногоВхода.

Перем Настройки;  // СервисНастроек (настройки)
Перем Ошибки;     // ТекстОшибки (основа)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Ключ настройки, которой описывается состояние парольного входа.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючНастройки() Экспорт
	Возврат "oshub.auth.password.enabled";
КонецФункции

// Работает ли прямо сейчас вход по логину и паролю. Нечитаемая настройка не запирает
// хаб: ответ совпадает с дефолтом реестра.
//
// Возвращаемое значение:
//  Булево.
//
Функция Включён() Экспорт

	Попытка
		Решение = Настройки.Значение(КлючНастройки()) = Истина;
	Исключение
		ПредупредитьОбОткрытойДвери(ИнформацияОбОшибке());
		Возврат Истина;
	КонецПопытки;

	Если Лог <> Неопределено Тогда
		Лог.Отладка("Парольный вход: %1 = %2", КлючНастройки(), Решение);
	КонецЕсли;
	Возврат Решение;

КонецФункции

// Выключен ли вход по логину и паролю.
//
// Возвращаемое значение:
//  Булево.
//
Функция Выключен() Экспорт
	Возврат НЕ Включён();
КонецФункции

// Считается ли пароль этой учётки способом войти. Хеш в учётке сам по себе двери
// не открывает: выключенный парольный вход делает его мёртвым. Правило одно на хаб,
// и живёт оно здесь — там же, где ответ «работает ли парольный вход вообще».
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - учётная запись.
//  ВходВключён - Булево, Неопределено - уже снятое состояние парольного входа;
//                Неопределено — спросить его самому (необязательный, по умолчанию
//                Неопределено). Обход списка учёток снимает состояние ОДИН раз на список:
//                настройка одна на хаб, а не на строку.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПарольДействует(Знач Пользователь, Знач ВходВключён = Неопределено) Экспорт

	Если Пользователь = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Работает = ?(ВходВключён = Неопределено, Включён(), ВходВключён = Истина);

	Возврат ЗначениеЗаполнено(Пользователь.ХешПароля) И Работает;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Тихое «включено» на нечитаемой настройке открывает дверь, которую администратор закрыл.
Процедура ПредупредитьОбОткрытойДвери(Знач Ошибка)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Лог.Предупреждение("setting %1 unreadable (%2): password login stays ENABLED by registry"
		+ " default — the login form is open until the setting can be read",
		КлючНастройки(), Ошибки.Причина(Ошибка));

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Настройки = _Настройки;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
