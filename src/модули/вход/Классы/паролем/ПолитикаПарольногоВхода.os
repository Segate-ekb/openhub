// Единственная точка ответа «работает ли на хабе вход по логину и паролю»; правку
// состояния держит СтражПарольногоВхода.

Перем Настройки;  // СервисНастроек (настройки)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Ключ настройки, которой описывается состояние парольного входа.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючНастройки() Экспорт
	Возврат "oshub.auth.password.enabled";
КонецФункции

// Работает ли прямо сейчас вход по логину и паролю. Нечитаемая настройка не запирает
// хаб: ответ совпадает с дефолтом реестра.
//
// Возвращаемое значение:
//  Булево.
//
Функция Включён() Экспорт

	Попытка
		Решение = Настройки.Значение(КлючНастройки()) = Истина;
	Исключение
		ПредупредитьОбОткрытойДвери(ИнформацияОбОшибке());
		Возврат Истина;
	КонецПопытки;

	Если Лог <> Неопределено Тогда
		Лог.Отладка("Парольный вход: %1 = %2", КлючНастройки(), Решение);
	КонецЕсли;
	Возврат Решение;

КонецФункции

// Выключен ли вход по логину и паролю.
//
// Возвращаемое значение:
//  Булево.
//
Функция Выключен() Экспорт
	Возврат НЕ Включён();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Тихое «включено» на нечитаемой настройке открывает дверь, которую администратор закрыл,
// поэтому оно обязано быть видно оператору. Текст лога — без кириллицы, как у соседей.
Процедура ПредупредитьОбОткрытойДвери(Знач Ошибка)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Лог.Предупреждение("setting %1 unreadable (%2): password login stays ENABLED by registry"
		+ " default — the login form is open until the setting can be read",
		КлючНастройки(), КраткоеПредставлениеОшибки(Ошибка));

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Лог _Лог = Неопределено)

	Настройки = _Настройки;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
