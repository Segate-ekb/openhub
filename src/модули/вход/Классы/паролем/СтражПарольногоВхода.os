// Предохранитель и единственная точка правки состояния парольного входа: выключить
// можно, только пока остаётся администратор с личностью включённого провайдера.

Перем Настройки;               // СервисНастроек (настройки) — запись значения
Перем Политика;                // ПолитикаПарольногоВхода (auth) — ключ настройки
Перем ХранилищеПользователей;  // ХранилищеПользователей (данные)
Перем СервисЛичностей;         // СервисЛичностей (auth)
Перем Конфигурация;            // КонфигурацияOIDC (oidc) — только включённые провайдеры

#Область ПубличныйИнтерфейс

// Код отказа «на хабе нет ни одного включённого провайдера входа».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНетПровайдеров() Экспорт
	Возврат "password_login_no_providers";
КонецФункции

// Код отказа «ни один администратор не входит через включённого провайдера».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНетАдминов() Экспорт
	Возврат "password_login_no_external_admin";
КонецФункции

// Можно ли выключить вход по паролю, не заперев администраторов снаружи.
//
// Возвращаемое значение:
//  Структура - Можно (Булево), Причина (Строка — код отказа, "" при Можно),
//              Админов (Число — администраторов, готовых войти провайдером),
//              Провайдеров (Число — включённых провайдеров входа).
//
Функция ПроверитьВыключение() Экспорт

	Издатели = ИздателиВключённыхПровайдеров();
	Если Издатели.Количество() = 0 Тогда
		Возврат Вердикт(Ложь, ПричинаНетПровайдеров(), 0, 0);
	КонецЕсли;

	Админов = 0;
	Для Каждого Пользователь Из ХранилищеПользователей.Все() Цикл
		Если ЭтоДействующийАдмин(Пользователь) И ВходитПровайдером(Пользователь, Издатели) Тогда
			Админов = Админов + 1;
		КонецЕсли;
	КонецЦикла;

	Если Админов = 0 Тогда
		Возврат Вердикт(Ложь, ПричинаНетАдминов(), 0, Издатели.Количество());
	КонецЕсли;

	Возврат Вердикт(Истина, "", Админов, Издатели.Количество());

КонецФункции

// Выключает вход по логину и паролю. Отказ предохранителя — исключение с кодом причины:
// значение, записанное в обход этой точки, запирает администраторов снаружи навсегда.
//
// Параметры:
//  Кто - Строка - принципал для аудита.
//  АдресIP - Строка - адрес клиента для аудита (необязательный, по умолчанию "").
//
Процедура Выключить(Знач Кто, Знач АдресIP = "") Экспорт

	Итог = ПроверитьВыключение();
	Если НЕ Итог.Можно Тогда
		ВызватьИсключение СтрШаблон(
			"%1: выключение парольного входа запрещено предохранителем — после него"
			+ " на хабе не осталось бы администратора, способного войти провайдером",
			Итог.Причина);
	КонецЕсли;

	Настройки.Установить(КлючНастройки(), Ложь, Кто, АдресIP);

КонецПроцедуры

// Включает вход по логину и паролю: предохранитель не спрашивается, способов входа
// включение не отнимает.
//
// Параметры:
//  Кто - Строка - принципал для аудита.
//  АдресIP - Строка - адрес клиента для аудита (необязательный, по умолчанию "").
//
Процедура Включить(Знач Кто, Знач АдресIP = "") Экспорт
	Настройки.Установить(КлючНастройки(), Истина, Кто, АдресIP);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлючНастройки()
	Возврат Политика.КлючНастройки();
КонецФункции

// Издатели действующей конфигурации: выключенные строки базы в неё не попадают,
// поэтому «включённый провайдер» — это ровно то, что отдаёт КонфигурацияOIDC.
Функция ИздателиВключённыхПровайдеров()

	Результат = Новый Соответствие();
	Для Каждого Провайдер Из Конфигурация.Провайдеры() Цикл
		Издатель = Норм(Провайдер.Издатель);
		Если ЗначениеЗаполнено(Издатель) Тогда
			Результат.Вставить(Издатель, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЭтоДействующийАдмин(Знач Пользователь)
	Возврат Пользователь.Активен = Истина И НРег(Строка(Пользователь.РольХаба)) = "admin";
КонецФункции

Функция ВходитПровайдером(Знач Пользователь, Знач Издатели)

	Для Каждого Личность Из СервисЛичностей.ЛичностиПользователя(Пользователь.Идентификатор) Цикл
		Если Издатели.Получить(Норм(Личность.Издатель)) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция Норм(Знач Значение)
	Возврат НРег(СокрЛП(Строка(Значение)));
КонецФункции

Функция Вердикт(Знач Можно, Знач Причина, Знач Админов, Знач Провайдеров)
	Возврат Новый Структура("Можно, Причина, Админов, Провайдеров",
		Можно, Причина, Админов, Провайдеров);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _Политика,
	&Пластилин(Значение = "ХранилищеПользователей") _ХранилищеПользователей,
	&Пластилин(Значение = "СервисЛичностей") _СервисЛичностей,
	&Пластилин(Значение = "КонфигурацияOIDC") _Конфигурация)

	Настройки = _Настройки;
	Политика = _Политика;
	ХранилищеПользователей = _ХранилищеПользователей;
	СервисЛичностей = _СервисЛичностей;
	Конфигурация = _Конфигурация;

КонецПроцедуры
