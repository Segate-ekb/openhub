// Предохранитель и единственная точка правки состояния парольного входа: выключить
// можно, только пока остаётся администратор с личностью включённого провайдера.

Перем Настройки;               // СервисНастроек (настройки) — запись значения
Перем Политика;                // ПолитикаПарольногоВхода (auth) — ключ настройки
Перем ХранилищеПользователей;  // ХранилищеПользователей (данные)
Перем СервисЛичностей;         // СервисЛичностей (auth)
Перем Конфигурация;            // КонфигурацияOIDC (oidc) — только включённые провайдеры
Перем Геоправило;              // ГеоправилоПровайдера (oidc) — закрыт ли провайдер по стране
Перем Вердикты;                // Вердикт (основа) — форма ответа

#Область ПубличныйИнтерфейс

// Код отказа «на хабе нет ни одного включённого провайдера входа».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНетПровайдеров() Экспорт
	Возврат "password_login_no_providers";
КонецФункции

// Код отказа «ни один администратор не входит через включённого провайдера».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНетАдминов() Экспорт
	Возврат "password_login_no_external_admin";
КонецФункции

// Код отказа «каждый включённый провайдер закрыт правилом по стране».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаВсеПодГеоправилом() Экспорт
	Возврат "password_login_all_providers_geofenced";
КонецФункции

// Можно ли выключить вход по паролю, не заперев администраторов снаружи. Провайдер
// с правилом по стране надёжным способом входа не считается: для посетителя из этой
// страны он закрыт, и остаться без пароля значило бы остаться совсем без входа.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка — код отказа, "" при успехе),
//              Админов (Число — администраторов, готовых войти провайдером),
//              Провайдеров (Число — ИЗДАТЕЛЕЙ у провайдеров без правила по стране).
//
Функция ПроверитьВыключение() Экспорт

	Включённые = Конфигурация.Провайдеры();

	Издатели = ИздателиПровайдеров(Включённые);
	Если Издатели.Количество() = 0 Тогда
		Возврат Вердикты.Отказ(ПричинаНетПровайдеров(), Обстановка(0, 0));
	КонецЕсли;

	Свободные = ИздателиПровайдеров(Геоправило.Двери(Включённые));
	Если Свободные.Количество() = 0 Тогда
		Возврат Вердикты.Отказ(ПричинаВсеПодГеоправилом(), Обстановка(0, 0));
	КонецЕсли;

	Админов = 0;
	Для Каждого Пользователь Из ХранилищеПользователей.Все() Цикл
		Если ЭтоДействующийАдмин(Пользователь) И ВходитПровайдером(Пользователь, Свободные) Тогда
			Админов = Админов + 1;
		КонецЕсли;
	КонецЦикла;

	Если Админов = 0 Тогда
		Возврат Вердикты.Отказ(ПричинаНетАдминов(), Обстановка(0, Свободные.Количество()));
	КонецЕсли;

	Возврат Вердикты.Успех(Обстановка(Админов, Свободные.Количество()));

КонецФункции

// Выключает вход по логину и паролю. Отказ предохранителя — исключение с кодом причины:
// значение, записанное в обход этой точки, запирает администраторов снаружи навсегда.
//
// Параметры:
//  Кто - Строка - принципал для аудита.
//  АдресIP - Строка - адрес клиента для аудита (необязательный, по умолчанию "").
//
Процедура Выключить(Знач Кто, Знач АдресIP = "") Экспорт

	Итог = ПроверитьВыключение();
	Если НЕ Итог.Успех Тогда
		ВызватьИсключение СтрШаблон(
			"%1: выключение парольного входа запрещено предохранителем — после него"
			+ " войти в хаб было бы нечем или некому",
			Итог.Причина);
	КонецЕсли;

	Записать(Ложь, Кто, АдресIP);

КонецПроцедуры

// Включает вход по логину и паролю: предохранитель не спрашивается, способов входа
// включение не отнимает.
//
// Параметры:
//  Кто - Строка - принципал для аудита.
//  АдресIP - Строка - адрес клиента для аудита (необязательный, по умолчанию "").
//
Процедура Включить(Знач Кто, Знач АдресIP = "") Экспорт
	Записать(Истина, Кто, АдресIP);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Реестр отдал правку этого ключа стражу: обычная запись значения на нём отказывает.
Процедура Записать(Знач Значение, Знач Кто, Знач АдресIP)
	Настройки.УстановитьМеханизмом(КлючНастройки(), Значение, Кто,
		Строка(ТипЗнч(ЭтотОбъект)), АдресIP);
КонецПроцедуры

Функция КлючНастройки()
	Возврат Политика.КлючНастройки();
КонецФункции

// Считаются ИЗДАТЕЛИ, а не строки: два провайдера одного издателя — одна дверь,
// а провайдер без издателя дверью не является вовсе.
Функция ИздателиПровайдеров(Знач Провайдеры)

	Результат = Новый Соответствие();
	Для Каждого Провайдер Из Провайдеры Цикл
		Издатель = Норм(Провайдер.Издатель);
		Если ЗначениеЗаполнено(Издатель) Тогда
			Результат.Вставить(Издатель, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЭтоДействующийАдмин(Знач Пользователь)
	Возврат Пользователь.Активен = Истина И НРег(Строка(Пользователь.РольХаба)) = "admin";
КонецФункции

Функция ВходитПровайдером(Знач Пользователь, Знач Издатели)

	Для Каждого Личность Из СервисЛичностей.ЛичностиПользователя(Пользователь.Идентификатор) Цикл
		Если Издатели.Получить(Норм(Личность.Издатель)) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция Норм(Знач Значение)
	Возврат НРег(СокрЛП(Строка(Значение)));
КонецФункции

Функция Обстановка(Знач Админов, Знач Провайдеров)
	Возврат Новый Структура("Админов, Провайдеров", Админов, Провайдеров);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _Политика,
	&Пластилин(Значение = "ХранилищеПользователей") _ХранилищеПользователей,
	&Пластилин(Значение = "СервисЛичностей") _СервисЛичностей,
	&Пластилин(Значение = "КонфигурацияOIDC") _Конфигурация,
	&Пластилин(Значение = "ГеоправилоПровайдера") _Геоправило)

	Настройки = _Настройки;
	Политика = _Политика;
	ХранилищеПользователей = _ХранилищеПользователей;
	СервисЛичностей = _СервисЛичностей;
	Конфигурация = _Конфигурация;
	Геоправило = _Геоправило;

	Вердикты = Новый Вердикт();

КонецПроцедуры
