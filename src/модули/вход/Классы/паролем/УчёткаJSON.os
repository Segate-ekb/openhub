// Учётка вошедшего; как он вошёл — только в ответе «кто я».

&Сериализуемое("id")
&Заполнено
&Тип("Число")
Перем Ид;

&Сериализуемое("login")
&Заполнено
&Тип("Строка")
Перем Логин;

&Сериализуемое("email")
&Заполнено
&Тип("Строка")
Перем Почта;

&Сериализуемое("role")
&Заполнено
&Тип("Строка")
&ОдинИз("admin", "user")
Перем Роль;

&Сериализуемое("email_confirmed")
&Заполнено
&Тип("Булево")
Перем ПочтаПодтверждена;

&Сериализуемое("must_change_password")
&Заполнено
&Тип("Булево")
Перем НуженНовыйПароль;

&Сериализуемое("auth_method")
&Тип("Строка")
&ОдинИз("token", "session")
Перем СпособВхода;
