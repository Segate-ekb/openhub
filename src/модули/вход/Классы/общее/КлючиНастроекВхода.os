// Ключи настроек входа: первый администратор, доверенные прокси, регистрация, сессии, замок
// подбора, парольный вход и политика пароля, приглашения, ключи доступа, подтверждение адреса.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей входа в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи входа.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(50)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "oshub.admin.login", ЗначениеПоУмолчанию = "") _ЛогинАдмина = "",
	&Деталька(Значение = "oshub.admin.password", ЗначениеПоУмолчанию = "") _ПарольАдмина = "",
	&Деталька(Значение = "oshub.admin.password_file", ЗначениеПоУмолчанию = "") _ФайлПароляАдмина = "",
	&Деталька(Значение = "oshub.instance.trusted_proxies", ЗначениеПоУмолчанию = "") _ДоверенныеПрокси = "",
	&Деталька(Значение = "oshub.auth.registration.mode", ЗначениеПоУмолчанию = "") _РежимРегистрации = "",
	&Деталька(Значение = "oshub.auth.session.ttlseconds", ЗначениеПоУмолчанию = "") _TTLСессии = "",
	&Деталька(Значение = "oshub.auth.login.maxattempts", ЗначениеПоУмолчанию = "") _МаксПопыток = "",
	&Деталька(Значение = "oshub.auth.login.lockoutseconds", ЗначениеПоУмолчанию = "") _СекундБлокировки = "",
	&Деталька(Значение = "oshub.auth.password.enabled", ЗначениеПоУмолчанию = "") _ПарольныйВход = "",
	&Деталька(Значение = "oshub.auth.invite.ttl.days", ЗначениеПоУмолчанию = "") _СрокПриглашения = "",
	&Деталька(Значение = "oshub.auth.token.cli_days", ЗначениеПоУмолчанию = "") _СрокТокенаCLI = "",
	&Деталька(Значение = "oshub.auth.token.max_days", ЗначениеПоУмолчанию = "") _ПотолокСрокаТокена = "",
	&Деталька(Значение = "oshub.auth.email.confirm.enabled", ЗначениеПоУмолчанию = "") _ПодтверждениеАдреса = "",
	&Деталька(Значение = "oshub.auth.email.confirm.ttl.hours", ЗначениеПоУмолчанию = "") _СрокПодтверждения = "",
	&Деталька(Значение = "oshub.auth.password.min_length", ЗначениеПоУмолчанию = "") _МинДлина = "",
	&Деталька(Значение = "oshub.auth.password.max_length", ЗначениеПоУмолчанию = "") _МаксДлина = "",
	&Деталька(Значение = "oshub.auth.password.require_lowercase", ЗначениеПоУмолчанию = "") _Строчная = "",
	&Деталька(Значение = "oshub.auth.password.require_uppercase", ЗначениеПоУмолчанию = "") _Прописная = "",
	&Деталька(Значение = "oshub.auth.password.require_digit", ЗначениеПоУмолчанию = "") _Цифра = "",
	&Деталька(Значение = "oshub.auth.password.require_special", ЗначениеПоУмолчанию = "") _Спец = "",
	&Деталька(Значение = "oshub.jobs.cli_device_gc_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалЗаявокCLI = "",
	&Деталька(Значение = "oshub.jobs.invite_gc_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалПриглашений = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	// Первый администратор — дело того, кто разворачивает хаб, а не администратора.
	Ключи.Объявить("oshub.admin.login", "строка", "", Неопределено, "bootstrap", _ЛогинАдмина);
	Ключи.ОбъявитьСекрет("oshub.admin.password", "строка", "", Неопределено, "bootstrap", _ПарольАдмина);
	Ключи.Объявить("oshub.admin.password_file", "строка", "", Неопределено, "bootstrap", _ФайлПароляАдмина);

	// Сети обратных прокси: пусто — заголовки пересылки не читаются вовсе.
	Ключи.Объявить("oshub.instance.trusted_proxies", "строка", "", _Правила.Сети(), "bootstrap",
		_ДоверенныеПрокси);

	Ключи.Объявить("oshub.auth.registration.mode", "строка", "open",
		_Правила.Перечисление("open,invite,disabled"), "прикладная", _РежимРегистрации);
	Ключи.Объявить("oshub.auth.session.ttlseconds", "целое", 86400, _Правила.Минимум(1), "bootstrap",
		_TTLСессии);
	Ключи.Объявить("oshub.auth.login.maxattempts", "целое", 5, _Правила.Минимум(1), "bootstrap",
		_МаксПопыток);
	Ключи.Объявить("oshub.auth.login.lockoutseconds", "целое", 300, _Правила.Минимум(1), "bootstrap",
		_СекундБлокировки);

	// Парольный вход правит только страж: правка — переход с предохранителем.
	Ключи.Объявить("oshub.auth.password.enabled", "булево", Истина, Неопределено, "прикладная",
		_ПарольныйВход);
	Ключи.ПравитМеханизм("oshub.auth.password.enabled", "СтражПарольногоВхода");

	// Срок одноразовой ссылки установки пароля: и приглашения, и сброса.
	Ключи.Объявить("oshub.auth.invite.ttl.days", "целое", 7, _Правила.Минимум(1), "bootstrap",
		_СрокПриглашения);

	// Бессрочных токенов нет: ноль ни в одном из ключей не значит «вечно».
	Ключи.Объявить("oshub.auth.token.cli_days", "целое", 7, _Правила.Минимум(1), "прикладная",
		_СрокТокенаCLI);
	Ключи.Объявить("oshub.auth.token.max_days", "целое", 365, _Правила.Минимум(1), "bootstrap",
		_ПотолокСрокаТокена);

	// Подтверждение адреса — политика входа, поэтому ключи в oshub.auth.*, а не у почты.
	Ключи.Объявить("oshub.auth.email.confirm.enabled", "булево", Истина, Неопределено, "прикладная",
		_ПодтверждениеАдреса);
	Ключи.Объявить("oshub.auth.email.confirm.ttl.hours", "целое", 24, _Правила.Минимум(1), "bootstrap",
		_СрокПодтверждения);

	// Политика пароля; границы длины сверяются друг с другом, иначе пара запирает вход.
	Ключи.Объявить("oshub.auth.password.min_length", "целое", 8,
		_Правила.НеБольшеЧем("oshub.auth.password.max_length", 1), "прикладная", _МинДлина);
	Ключи.Объявить("oshub.auth.password.max_length", "целое", 256,
		_Правила.НеМеньшеЧем("oshub.auth.password.min_length", 1), "прикладная", _МаксДлина);
	Ключи.Объявить("oshub.auth.password.require_lowercase", "булево", Ложь, Неопределено, "прикладная",
		_Строчная);
	Ключи.Объявить("oshub.auth.password.require_uppercase", "булево", Ложь, Неопределено, "прикладная",
		_Прописная);
	Ключи.Объявить("oshub.auth.password.require_digit", "булево", Ложь, Неопределено, "прикладная", _Цифра);
	Ключи.Объявить("oshub.auth.password.require_special", "булево", Ложь, Неопределено, "прикладная", _Спец);

	// Уборка просроченных заявок входа из CLI и приглашений.
	Ключи.Объявить("oshub.jobs.cli_device_gc_interval_sec", "целое", 300, _Правила.Минимум(1), "bootstrap",
		_ИнтервалЗаявокCLI);
	Ключи.Объявить("oshub.jobs.invite_gc_interval_sec", "целое", 3600, _Правила.Минимум(1), "bootstrap",
		_ИнтервалПриглашений);

КонецПроцедуры
