// Сборка ссылки на публичную страницу хаба: внешний адрес инсталляции, путь страницы
// и сырое значение, уезжающее в параметр адреса.

Перем Адрес;            // АдресИнстанса (настройки)
Перем ПараметрыСсылки;  // ПараметрыСсылки (основа) — параметр запроса на адресе

// Ссылка целиком: с внешним адресом инсталляции, если он задан, иначе относительным
// путём — адрес хаба получатель дописывает сам.
//
// Параметры:
//  Путь - Строка - путь публичной страницы от корня хаба.
//  ИмяПараметра - Строка - имя параметра адреса, в который уезжает значение.
//  Значение - Строка - сырое значение ссылки.
//
// Возвращаемое значение:
//  Строка.
//
Функция Ссылка(Знач Путь, Знач ИмяПараметра, Знач Значение) Экспорт

	Возврат ПараметрыСсылки.Установить(Адрес.Базовый() + Путь, ИмяПараметра, СокрЛП(Строка(Значение)));

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "АдресИнстанса") _Адрес,
	&Пластилин(Значение = "ПараметрыСсылки") _Параметры = Неопределено)

	Адрес = _Адрес;
	ПараметрыСсылки = ?(_Параметры = Неопределено, Новый ПараметрыСсылки(), _Параметры);

КонецПроцедуры
