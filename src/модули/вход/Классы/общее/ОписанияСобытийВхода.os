// События входа словами: роль учётки на хабе, приглашение, подтверждение адреса,
// провайдер входа и замок подбора.

Перем События;  // ОбъявленияСобытий (события)

#Область ПубличныйИнтерфейс

// Объявления событий входа в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияСобытий - события входа словами.
//
Функция Объявления() Экспорт
	Возврат События;
КонецФункции

#КонецОбласти

&Прозвище("ОписанияСобытий")
&Порядок(70)
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ИздательСобытий") _Издатель) Экспорт

	События = Новый ОбъявленияСобытий();

	События.ОбъявитьВнутреннее(_Издатель.ТипРольХабаИзменена(), "Роль учётки на хабе изменена",
		"Учётной записи выдана либо снята роль администратора хаба.",
		"Событие безопасности уровня хаба: администратор получает полные права на всю"
		+ " инсталляцию, и адресат такой записи — журнал аудита, а не подписчик пакета."
		+ " Нагрузка собрана под журнал (Кто/Действие/Объект/ДеталиJSON) и называет чужую"
		+ " учётку — раздавать это подпиской нельзя.");

	События.ОбъявитьВнутреннее(_Издатель.ТипПриглашениеУчётки(), "Приглашение учётной записи",
		"Администратор завёл учётную запись или выпустил ей одноразовую ссылку установки"
		+ " пароля; по такой ссылке установлен пароль и открыт вход.",
		"Событие безопасности уровня хаба: ссылка установки пароля открывает вход в чужую"
		+ " учётку, и адресат такой записи — журнал аудита и администратор. Нагрузка"
		+ " собрана под журнал (Кто/Действие/Объект/ДеталиJSON), самой ссылки в ней нет"
		+ " и быть не может — раздавать это подпиской нельзя.");

	События.ОбъявитьВнутреннее(_Издатель.ТипПодтверждениеАдреса(), "Подтверждение адреса учётной записи",
		"Владелец сменил или снял адрес учётки, учётке послано письмо со ссылкой подтверждения"
		+ " адреса либо адрес подтверждён переходом по такой ссылке.",
		"Событие безопасности уровня хаба: адресат такой записи — журнал аудита"
		+ " и администратор. Нагрузка собрана под журнал (Кто/Действие/Объект/ДеталиJSON)"
		+ " и называет адрес чужой учётки — раздавать это подпиской нельзя.");

	События.ОбъявитьВнутреннее(_Издатель.ТипПровайдерВходаИзменён(), "Провайдер входа изменён",
		"Провайдер социального логина заведён, изменён, включён, выключен или удалён.",
		"Событие безопасности уровня хаба: его адресат — журнал аудита и администратор."
		+ " Нагрузка собрана под журнал (Кто/Действие/Объект/ДеталиJSON), скоупа пула или"
		+ " пакета у неё нет — доставить подписке объекта её некуда.");

	События.ОбъявитьВнутреннее(_Издатель.ТипВходЗаблокирован(), "Вход заблокирован",
		"Подбор исчерпал лимит попыток: заперта учётная запись либо адрес источника."
		+ " Запись несёт срок, до которого вход закрыт.",
		"Событие безопасности уровня хаба: закрытый вход администратора — это отъём его"
		+ " власти над инсталляцией, и адресат такой записи — журнал аудита и администратор."
		+ " Нагрузка называет чужую учётку и адрес источника — раздавать это подпиской нельзя.");

	События.ОбъявитьВнутреннее(_Издатель.ТипВходРазблокирован(), "Вход после блокировки состоялся",
		"Запертая учётная запись снова вошла — подбор прекратился, срок замка истёк.",
		"Событие безопасности того же класса, что и замок. Парности с ним НЕ обещает:"
		+ " замок истекает сам, а лимит попыток живёт в памяти процесса и рестартом"
		+ " стирается — поэтому «когда закрылся» отвечает срок в записи замка,"
		+ " а не наличие этой записи.");

КонецПроцедуры
