// Админский вход в приглашения: порог операции «завести учётку со ссылкой установки
// пароля» и «выпустить ссылку заново». Жизненный цикл самой ссылки — в СервисПриглашений.

Перем Приглашения;         // СервисПриглашений (auth)
Перем АдресСсылки;         // АдресПриглашения (auth)
Перем ПарольныйВход;       // ПолитикаПарольногоВхода (auth)
Перем СервисПользователей; // СервисПользователей (auth)
Перем Онбординг;           // ОнбордингПервогоЗапуска (auth)
Перем Перехватчик;         // ПерехватчикАутентификации (auth)
Перем ГейтКлюча;           // ГейтТокена (auth); Неопределено — fail-closed для ключа
Перем СервисПрав;          // СервисПрав (auth)
Перем Летопись;            // ЛетописьУчёток (auth)

#Область ПубличныйИнтерфейс

// Заводит учётную запись и выпускает на неё ссылку установки пароля. Учётка рождается
// закрытой: пароля у неё нет, и вход откроется только вместе с ним. Режим регистрации
// хаба к этому пути не применяется — учётки администратора он не касается.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  Логин - Строка - логин новой учётной записи.
//  Email - Строка - адрес, может быть пустым.
//  Роль - Строка - admin | user.
//  АдресIP - Строка - адрес клиента для журнала (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число — HTTP-статус), Причина (Строка — код отказа),
//              Сообщение (Строка — доменный текст отказа), Ссылка (Строка — показать
//              один раз), Логин (Строка).
//
Функция Пригласить(Знач Принципал, Знач Логин, Знач Email, Знач Роль,
	Знач АдресIP = "") Экспорт

	Вердикт = ПроверитьПраво(Принципал, "создание");
	Если НЕ Вердикт.Успех Тогда
		Возврат Вердикт;
	КонецЕсли;

	Попытка
		Новая = СервисПользователей.СоздатьПользователя(Логин, Email, "", Роль, Ложь, Ложь);
	Исключение
		// текст доменного отказа уже написан для человека: занятый логин, чужое имя
		// пространства, неизвестная роль
		Возврат Отказ(400, ПричинаСоздание(), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Детали = Новый Структура();
	Детали.Вставить("логин", Строка(Новая.Логин));
	Детали.Вставить("роль", Строка(Новая.РольХаба));
	Детали.Вставить("активна", Ложь);
	Летопись.СобытиеУчётки(Летопись.ДействиеУчёткаЗаведена(), Логин(Принципал),
		Строка(Новая.Логин), Детали, АдресIP);

	Возврат ВыпуститьСсылку(Новая, Приглашения.ПоводПриглашение(), Принципал, АдресIP);

КонецФункции

// Выпускает учётной записи новую ссылку установки пароля. Прежний пароль продолжает
// работать, пока по ссылке не задан новый: ссылка меняет пароль, а не отбирает его.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  ИдентификаторЦели - Число - учётная запись, которой выпускается ссылка.
//  АдресIP - Строка - адрес клиента для журнала (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - как у Пригласить.
//
Функция СброситьПароль(Знач Принципал, Знач ИдентификаторЦели, Знач АдресIP = "") Экспорт

	Вердикт = ПроверитьПраво(Принципал, "изменение");
	Если НЕ Вердикт.Успех Тогда
		Возврат Вердикт;
	КонецЕсли;

	Цель = СервисПользователей.ПоИдентификатору(ИдентификаторЦели);
	Если Цель = Неопределено Тогда
		Возврат Отказ(404, ПричинаНетУчётки(), "");
	КонецЕсли;

	Возврат ВыпуститьСсылку(Цель, Приглашения.ПоводСброс(), Принципал, АдресIP);

КонецФункции

// Вправе ли принципал заводить учётки и выпускать ссылки. Отдельным методом — чтобы
// экран мог не показывать действие, которое всё равно не состоится.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  Действие - Строка - создание | изменение; нужно скоупу ключа.
//
// Возвращаемое значение:
//  Структура - как у Пригласить.
//
Функция ПроверитьПраво(Знач Принципал, Знач Действие) Экспорт

	// гейт первого запуска — первой проверкой: пока администратора нет, заведение учёток
	// перехватило бы установку хаба, а мастер /setup закрылся бы навсегда
	Если Онбординг.НуженОнбординг() Тогда
		Возврат Отказ(403, ПричинаОнбординг(), "");
	КонецЕсли;

	Если Принципал = Неопределено ИЛИ Принципал.Пользователь = Неопределено Тогда
		Возврат Отказ(401, ПричинаАноним(), "");
	КонецЕсли;

	// рамки ключа стоят перед запретом ключа целиком, чтобы отказ называл ближайшую
	// причину; несобранный гейт для запроса с ключом — отказ, а не пропуск
	ЭтоКлюч = Перехватчик.ЭтоКлюч(Принципал);
	Если ЭтоКлюч Тогда
		Если ГейтКлюча = Неопределено Тогда
			Возврат Отказ(403, ПричинаГейтКлюча(), "");
		КонецЕсли;
		Если НЕ ГейтКлюча.Проверить(Принципал, Действие, 0).Разрешено Тогда
			Возврат Отказ(403, ПричинаКлючОтклонён(), "");
		КонецЕсли;
		Возврат Отказ(403, ПричинаКлючЗапрещён(), "");
	КонецЕсли;

	Если НЕ СервисПрав.ПользовательАдмин(Принципал.Пользователь) Тогда
		Возврат Отказ(403, ПричинаНеАдмин(), "");
	КонецЕсли;

	// конфигурация хаба — последней проверкой: анониму и не-админу отказ обязан называть
	// их собственную причину, а не рассказывать, как устроен вход на этой инсталляции
	Если ПарольныйВход.Выключен() Тогда
		Возврат Отказ(403, ПричинаПарольныйВходВыключен(), "");
	КонецЕсли;

	Возврат Успех("", "");

КонецФункции

// Код отказа «хаб ещё не инициализирован».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаОнбординг() Экспорт
	Возврат "invite_locked_onboarding";
КонецФункции

// Код отказа «запрос без учётной записи».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаАноним() Экспорт
	Возврат "invite_anonymous";
КонецФункции

// Код отказа «гейт ключа не собран» (fail-closed).
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаГейтКлюча() Экспорт
	Возврат "invite_key_gate";
КонецФункции

// Код отказа «ключу не хватило скоупа либо он привязан к пулу».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаКлючОтклонён() Экспорт
	Возврат "invite_key_denied";
КонецФункции

// Код отказа «ключом учётки не заводят» — запрет по способу обращения.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаКлючЗапрещён() Экспорт
	Возврат "invite_key_forbidden";
КонецФункции

// Код отказа «на хабе выключен вход по логину и паролю»: пароль, заданный по ссылке,
// никого не пустит. Код общий с жизненным циклом самой ссылки.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаПарольныйВходВыключен() Экспорт
	Возврат Приглашения.ПричинаПарольныйВходВыключен();
КонецФункции

// Код отказа «учётки заводит только администратор хаба».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНеАдмин() Экспорт
	Возврат "invite_not_admin";
КонецФункции

// Код отказа «учётная запись не заведена»; текст причины — в Сообщении.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаСоздание() Экспорт
	Возврат "invite_create_failed";
КонецФункции

// Код отказа «учётной записи не существует».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНетУчётки() Экспорт
	Возврат "invite_no_user";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыпуститьСсылку(Знач Цель, Знач Повод, Знач Принципал, Знач АдресIP)
	Выпуск = Приглашения.Выпустить(Цель, Повод, Логин(Принципал), Неопределено, АдресIP);
	Возврат Успех(АдресСсылки.Ссылка(Выпуск.Значение), Строка(Цель.Логин));
КонецФункции

Функция Логин(Знач Принципал)
	Если Принципал = Неопределено ИЛИ Принципал.Пользователь = Неопределено Тогда
		Возврат "anonymous";
	КонецЕсли;
	Возврат Строка(Принципал.Пользователь.Логин);
КонецФункции

Функция Успех(Знач Ссылка, Знач Логин)
	Возврат Новый Структура("Успех, Код, Причина, Сообщение, Ссылка, Логин",
		Истина, 200, "", "", Ссылка, Логин);
КонецФункции

Функция Отказ(Знач Код, Знач Причина, Знач Сообщение)
	Возврат Новый Структура("Успех, Код, Причина, Сообщение, Ссылка, Логин",
		Ложь, Код, Причина, Сообщение, "", "");
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПриглашений") _Приглашения,
	&Пластилин(Значение = "АдресПриглашения") _АдресСсылки,
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _ПарольныйВход,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "ОнбордингПервогоЗапуска") _Онбординг,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ЛетописьУчёток") _Летопись,
	&Пластилин(Значение = "ГейтТокена") _ГейтКлюча = Неопределено)

	Приглашения = _Приглашения;
	АдресСсылки = _АдресСсылки;
	ПарольныйВход = _ПарольныйВход;
	СервисПользователей = _СервисПользователей;
	Онбординг = _Онбординг;
	Перехватчик = _Перехватчик;
	СервисПрав = _СервисПрав;
	Летопись = _Летопись;
	ГейтКлюча = _ГейтКлюча;

КонецПроцедуры
