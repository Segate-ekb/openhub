// Задача планировщика «чистка-приглашений»: удаление заявок на установку пароля с истёкшим
// сроком.

Перем Приглашения;  // СервисПриглашений (вход)
Перем Интервал;     // интервал чистки из настройки, секунды

// Регистрация в планировщике: чистка раз в интервал из настройки.
//
// Параметры:
//  Регистрации - РегистрацииЗадачи - куда записывается регистрация.
//
Процедура Зарегистрировать(Регистрации) Экспорт
	Регистрации.КаждыеСекунд("чистка-приглашений", Интервал);
КонецПроцедуры

// Удаляет просроченные ссылки установки пароля за один проход.
// Сбой перебрасывается планировщику.
//
&Наблюдаемый("job.invite_gc")
Процедура Исполнить() Экспорт
	Приглашения.УдалитьПросроченные();
КонецПроцедуры

&Прозвище("ЗадачаПланировщика")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПриглашений") _Приглашения,
	&Деталька(Значение = "oshub.jobs.invite_gc_interval_sec", ЗначениеПоУмолчанию = 3600) _Интервал = Неопределено)

	Приглашения = _Приглашения;
	Интервал = Новый ПриведениеЧисел().ЧислоИлиДефолт(_Интервал, 3600);

КонецПроцедуры
