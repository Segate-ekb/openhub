// Онбординг первого запуска (в БД нет ни одного пользователя): мастер /setup,
// безголовое создание из настроек/env этой рогаткой и admin-cli create-admin.
// Созданные из конфигурации данные подключения печатаются оператору в консоль один раз —
// именно в поток вывода процесса, а не в журнал: журнал уезжает во внешний сборщик.
// Первые два идемпотентны; admin-cli на инициализированном хабе умеет ещё и
// восстановление (создать/повысить админа мимо этого гейта, под --force).
// Секрет админа — только env или *_FILE, в коммиченный autumn-properties.json не класть.

Перем СервисПользователей;  // СервисПользователей (auth)
Перем ЛогинИзДеталей;       // деталь oshub.admin.login (fallback к env)
Перем ПарольИзДеталей;      // деталь oshub.admin.password (fallback к env)
Перем ФайлПароляИзДеталей;  // деталь oshub.admin.password_file (fallback к env)
Перем ДанныеПодключения;    // напечатанное в консоль: секрет живёт здесь и мимо журнала
&Лог
Перем Лог;

// Нужен ли онбординг (в хабе ещё нет пользователей).
//
// Возвращаемое значение:
//  Булево.
//
Функция НуженОнбординг() Экспорт
	Возврат СервисПользователей.ВсегоПользователей() = 0;
КонецФункции

// Создаёт первого администратора хаба. Если пользователи уже есть — исключение
// already_initialized: этот вход закрывается навсегда после первой учётки.
//
// Параметры:
//  Логин - Строка - логин администратора.
//  Пароль - Строка - пароль администратора.
//  ТребуетсяСменаПароля - Булево - потребовать смену при первом входе
//                         (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Пользователь - созданный администратор.
//
Функция СоздатьПервогоАдмина(Знач Логин, Знач Пароль, Знач ТребуетсяСменаПароля = Ложь) Экспорт

	Если НЕ НуженОнбординг() Тогда
		ВызватьИсключение "already_initialized: администратор уже создан, онбординг завершён";
	КонецЕсли;

	Возврат СервисПользователей.СоздатьПользователя(Логин, "", Пароль, "admin", ТребуетсяСменаПароля);

КонецФункции

// Рогатка старта: безголовое создание администратора из настроек или окружения.
// Best-effort — ошибка конфигурации не роняет обслуживание запросов; итог печатается
// в журнал в каждой ветке.
//
Процедура ПриЗапускеПриложения() Экспорт

	Лог.Информация("Онбординг первого запуска: %1", БезголовыйОнбординг());

КонецПроцедуры

// Данные подключения первого администратора, напечатанные в консоль. Пусто — печатать
// было нечего: администратор уже был либо конфигурация его не называла.
//
// Возвращаемое значение:
//  Строка.
//
Функция НапечатанныеДанныеПодключения() Экспорт
	Возврат ДанныеПодключения;
КонецФункции

// Выполняет безголовый онбординг и возвращает читаемый итог для журнала.
Функция БезголовыйОнбординг()

	Если НЕ НуженОнбординг() Тогда
		Возврат "пропущен, администратор уже есть"; // идемпотентность
	КонецЕсли;

	Логин = ПрочитатьЛогин();
	Если НЕ ЗначениеЗаполнено(Логин) Тогда
		Лог.Отладка("Онбординг: логин администратора не задан ни деталью, ни окружением");
		// безголовый сценарий не задействован — ждём /setup или admin-cli
		Возврат "пропущен, логин администратора не задан (ожидается /setup или admin-cli)";
	КонецЕсли;

	Пароль = ПрочитатьПароль();
	// пароль называется только фактом наличия: он печатается в консоль и мимо журнала
	Лог.Отладка("Онбординг: логин администратора задан, пароль задан: %1",
		ЗначениеЗаполнено(Пароль));
	Если НЕ ЗначениеЗаполнено(Пароль) Тогда
		Возврат "администратор НЕ создан: логин задан без пароля"
			+ " (oshub.admin.password / _file или OSHUB_ADMIN_PASSWORD / _FILE)";
	КонецЕсли;

	Попытка
		СоздатьПервогоАдмина(Логин, Пароль, Истина);
	Исключение
		Возврат "администратор НЕ создан: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	НапечататьВКонсоль(СтрШаблон(
		"Данные подключения первого администратора: логин ""%1"", пароль ""%2""."
			+ " Хаб покажет их только сейчас; при первом входе пароль потребуется сменить.",
		НРег(СокрЛП(Строка(Логин))), Пароль));

	Возврат СтрШаблон("создан администратор ""%1"" из настроек/окружения (требуется смена"
			+ " пароля); данные подключения напечатаны в консоли",
		НРег(СокрЛП(Строка(Логин))));

КонецФункции

// --- служебные ---

// Ровно один раз и ровно в поток вывода процесса: пароль виден тому, кто смотрит на
// запуск хаба, и не попадает ни в файл журнала, ни в конвейер к внешнему сборщику.
Процедура НапечататьВКонсоль(Знач Текст)

	ДанныеПодключения = Текст;
	Сообщить(Текст);

КонецПроцедуры

// env OSHUB_ADMIN_LOGIN имеет приоритет над деталью oshub.admin.login.
Функция ПрочитатьЛогин()
	Возврат ПерваяЗаполненная(ПолучитьПеременнуюСреды("OSHUB_ADMIN_LOGIN"), ЛогинИзДеталей);
КонецФункции

// Приоритет: прямое значение, затем файл-секрет (Docker-secret-стиль). env читается
// напрямую: мост main.os превращает _ в точку и дал бы ключ oshub.admin.password.file.
Функция ПрочитатьПароль()

	Прямой = ПерваяЗаполненная(ПолучитьПеременнуюСреды("OSHUB_ADMIN_PASSWORD"), ПарольИзДеталей);
	Если ЗначениеЗаполнено(Прямой) Тогда
		Возврат Прямой;
	КонецЕсли;

	ПутьФайла = ПерваяЗаполненная(ПолучитьПеременнуюСреды("OSHUB_ADMIN_PASSWORD_FILE"), ФайлПароляИзДеталей);
	Если ЗначениеЗаполнено(ПутьФайла) И Новый Файл(ПутьФайла).Существует() Тогда
		Чтение = Новый ЧтениеТекста(ПутьФайла, КодировкаТекста.UTF8);
		Содержимое = Чтение.Прочитать();
		Чтение.Закрыть();
		// файл-секрет часто заканчивается переводом строки — убираем края
		Возврат СокрЛП(Содержимое);
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ПерваяЗаполненная(Знач Основное, Знач Запасное)
	Если ЗначениеЗаполнено(Основное) Тогда
		Возврат Строка(Основное);
	КонецЕсли;
	Возврат ?(Запасное = Неопределено, "", Строка(Запасное));
КонецФункции

// Лог параметром (последним, чтобы не сдвигать позиционные вызовы) — для создания
// объекта через `Новый` вне контейнера: инъекция в поле `&Лог` туда не доезжает.
&Рогатка(ЗапускатьВФоне = Ложь)
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Деталька(Значение = "oshub.admin.login", ЗначениеПоУмолчанию = "") _ЛогинДеталь = "",
	&Деталька(Значение = "oshub.admin.password", ЗначениеПоУмолчанию = "") _ПарольДеталь = "",
	&Деталька(Значение = "oshub.admin.password_file", ЗначениеПоУмолчанию = "") _ФайлПароляДеталь = "",
	&Лог _Лог = Неопределено)

	// Лог параметром — только при прямом создании; в контейнере поле прилепит напильник.
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	СервисПользователей = _СервисПользователей;
	ДанныеПодключения = "";
	ЛогинИзДеталей = _ЛогинДеталь;
	ПарольИзДеталей = _ПарольДеталь;
	ФайлПароляИзДеталей = _ФайлПароляДеталь;

КонецПроцедуры
