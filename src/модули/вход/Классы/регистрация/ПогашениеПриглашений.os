// Гасит живые заявки на установку пароля. Отдельный класс, потому что гасят их с двух
// сторон — выпуск ссылки и закрытие учётки.

Перем Хранилище;  // ХранилищеЗаявокНаПароль (данные)

// Гасит все негашёные заявки учётной записи.
//
// Параметры:
//  ПользовательИдентификатор - Число - владелец заявок.
//
// Возвращаемое значение:
//  Число - сколько заявок погашено.
//
Функция ПогаситьЖивые(Знач ПользовательИдентификатор) Экспорт

	Погашено = 0;
	Для Каждого Заявка Из Хранилище.ПолучитьПоПользовательИдентификаторРавно(
		Цел(ПользовательИдентификатор)) Цикл
		Если Заявка.Погашена = Истина Тогда
			Продолжить;
		КонецЕсли;
		Заявка.Погашена = Истина;
		Заявка.Сохранить();
		Погашено = Погашено + 1;
	КонецЦикла;

	Возврат Погашено;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеЗаявокНаПароль") _Хранилище)

	Хранилище = _Хранилище;

КонецПроцедуры
