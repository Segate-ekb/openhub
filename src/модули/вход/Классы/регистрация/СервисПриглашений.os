// Жизненный цикл одноразовой ссылки установки пароля: выпуск, проверка, погашение и чистка
// просроченных. Значение показывается один раз, в базе лежит sha256-хеш секрета.

#Использовать pwhash

Перем Хранилище;           // ХранилищеЗаявокНаПароль (данные)
Перем СервисПользователей; // СервисПользователей (auth)
Перем Активность;          // СервисАктивностиУчёток (auth)
Перем Погашение;           // ПогашениеПриглашений (auth)
Перем ПолитикаПароля;      // ПолитикаПароля (auth)
Перем ПарольныйВход;       // ПолитикаПарольногоВхода (auth)
Перем Настройки;           // СервисНастроек (настройки)
Перем Летопись;            // ЛетописьУчёток (auth)
Перем Сверка;              // СверкаСекретов (auth)
Перем Хеши;                // Хеш (основа)
Перем Вердикты;      // Вердикт (основа) — форма ответа

#Область ЖизненныйЦиклСсылки

// Срок жизни ссылки, дней. Читается в месте использования, поэтому правка настройки
// действует без перезапуска хаба.
//
// Возвращаемое значение:
//  Число.
//
Функция СрокЖизниДней() Экспорт
	Возврат Настройки.Значение("oshub.auth.invite.ttl.days");
КонецФункции

// Выпускает ссылку установки пароля. Прежние живые ссылки этой учётки гасятся: у учётной
// записи в каждый момент годна не больше одной, иначе отозванное приглашение продолжало
// бы открывать вход.
//
// Параметры:
//  Пользователь - Пользователь - кому выпускается ссылка.
//  Повод - Строка - приглашение | сброс | восстановление.
//  КемСоздано - Строка - логин администратора, выпустившего ссылку; у самостоятельного
//               восстановления — логин самой учётки.
//  Момент - Дата - момент выпуска, UTC (необязательный, по умолчанию текущий).
//  АдресIP - Строка - адрес клиента: попадает в журнал и в счёт писем восстановления
//            с одного источника (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Значение (Строка — сырая ссылка, показать один раз), Заявка (ЗаявкаНаПароль).
//
Функция Выпустить(Знач Пользователь, Знач Повод, Знач КемСоздано,
	Знач Момент = Неопределено, Знач АдресIP = "") Экспорт

	Если Пользователь = Неопределено Тогда
		ВызватьИсключение "Ссылка установки пароля выпускается только существующей учётке";
	КонецЕсли;
	// ссылка заводит пароль, поэтому выключенный парольный вход закрывает и этот путь:
	// на SSO-only хабе она не откроет вход НИКОГДА, а не «пока»
	Если ПарольныйВход.Выключен() Тогда
		ВызватьИсключение СтрШаблон("%1: ссылка установки пароля не выпускается —"
			+ " вход по логину и паролю на хабе выключен", ПричинаПарольныйВходВыключен());
	КонецЕсли;
	Если НЕ ПоводДопустим(Повод) Тогда
		ВызватьИсключение СтрШаблон("Неизвестный повод ссылки ""%1"": ожидается %2, %3 или %4",
			Повод, ПоводПриглашение(), ПоводСброс(), ПоводВосстановление());
	КонецЕсли;

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Погашение.ПогаситьЖивые(Цел(Пользователь.Идентификатор));

	Секрет = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешированиеПаролей.СгенерироватьСоль(24)));

	Заявка = Хранилище.СоздатьЭлемент();
	Заявка.ПользовательИдентификатор = Цел(Пользователь.Идентификатор);
	Заявка.ХешТокена = "";
	Заявка.Повод = Повод;
	Заявка.АдресIP = СокрЛП(Строка(АдресIP));
	Заявка.Адрес = НРег(СокрЛП(Строка(Пользователь.Email)));
	Заявка.Погашена = Ложь;
	Заявка.КемСоздана = Строка(КемСоздано);
	Заявка.Создана = Сейчас;
	Заявка.Истекает = Сейчас + СрокЖизниДней() * 86400;
	Заявка.Сохранить(); // первое сохранение даёт идентификатор для значения ссылки

	Заявка.ХешТокена = Sha256Hex(Секрет);
	Заявка.Сохранить();

	Летопись.СобытиеУчётки(Летопись.ДействиеСсылкаВыпущена(), Строка(КемСоздано),
		Строка(Пользователь.Логин), Новый Структура("повод, истекает",
			Повод, XMLСтрока(Заявка.Истекает)), АдресIP);

	Возврат Новый Структура("Значение, Заявка",
		СтрШаблон("oshub_inv_%1_%2", Заявка.Идентификатор, Секрет), Заявка);

КонецФункции

// Проверяет сырое значение ссылки.
//
// Параметры:
//  Токен - Строка - значение вида oshub_inv_{id}_{secret}.
//  Момент - Дата - момент проверки, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Структура - Годна (Булево), Причина (Строка — код отказа, "" при Годна),
//              Заявка (ЗаявкаНаПароль, Неопределено), Пользователь (Пользователь,
//              Неопределено).
//
Функция Проверить(Знач Токен, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);

	// второй конец того же гейта: годной ссылки на хабе без парольного входа не бывает,
	// даже если её выпустили до выключения
	Если ПарольныйВход.Выключен() Тогда
		Возврат ГодностьЗаявки(Ложь, ПричинаПарольныйВходВыключен(), Неопределено, Неопределено);
	КонецЕсли;

	Разобранный = Разобрать(Токен);
	Если Разобранный = Неопределено Тогда
		Возврат ГодностьЗаявки(Ложь, ПричинаНетСсылки(), Неопределено, Неопределено);
	КонецЕсли;

	Заявка = Хранилище.ПолучитьОдноПоИдентификаторРавно(Разобранный.Идентификатор);
	Если Заявка = Неопределено Тогда
		Возврат ГодностьЗаявки(Ложь, ПричинаНетСсылки(), Неопределено, Неопределено);
	КонецЕсли;

	// чужой секрет при существующем идентификаторе неотличим от несуществующей ссылки:
	// иначе перебор идентификаторов рассказывал бы, какие из них живые
	Если НЕ Сверка.Совпадают(Sha256Hex(Разобранный.Секрет), Заявка.ХешТокена) Тогда
		Возврат ГодностьЗаявки(Ложь, ПричинаНетСсылки(), Неопределено, Неопределено);
	КонецЕсли;

	Если Заявка.Погашена = Истина Тогда
		Возврат ГодностьЗаявки(Ложь, ПричинаПогашена(), Заявка, Неопределено);
	КонецЕсли;
	// граница включительная: в секунду истечения ссылка уже мертва, лишнего интервала нет
	Если Заявка.Истекает <= Сейчас Тогда
		Возврат ГодностьЗаявки(Ложь, ПричинаПросрочена(), Заявка, Неопределено);
	КонецЕсли;

	Пользователь = СервисПользователей.ПоИдентификатору(Заявка.ПользовательИдентификатор);
	Если Пользователь = Неопределено Тогда
		Возврат ГодностьЗаявки(Ложь, ПричинаНетУчётки(), Заявка, Неопределено);
	КонецЕсли;

	Возврат ГодностьЗаявки(Истина, "", Заявка, Пользователь);

КонецФункции

// Устанавливает пароль по ссылке и открывает вход в учётную запись. Порядок шагов —
// пароль, активация, погашение: активной учётка становится только со способом входа,
// а сбой на любом шаге оставляет ссылку годной для повтора. Пароль вне политики ссылку
// не гасит: человеку дают попробовать ещё раз.
//
// Параметры:
//  Токен - Строка - сырое значение ссылки.
//  Пароль - Строка - назначаемый пароль.
//  Момент - Дата - момент погашения, UTC (необязательный, по умолчанию текущий).
//  АдресIP - Строка - адрес клиента для журнала (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка — код отказа, "" при успехе),
//              Требования (Строка — требования политики при отказе по паролю),
//              Пользователь (Пользователь, Неопределено).
//
Функция Погасить(Знач Токен, Знач Пароль, Знач Момент = Неопределено,
	Знач АдресIP = "") Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);

	Проверка = Проверить(Токен, Сейчас);
	Если НЕ Проверка.Годна Тогда
		Возврат Исход(Ложь, Проверка.Причина, "", Неопределено);
	КонецЕсли;

	Если НЕ ПолитикаПароля.Допустим(Пароль) Тогда
		Возврат Исход(Ложь, ПричинаПароль(), ПолитикаПароля.ОписаниеОднойСтрокой(), Неопределено);
	КонецЕсли;

	Пользователь = Проверка.Пользователь;
	СервисПользователей.УстановитьПароль(Пользователь, Пароль);
	Активность.Активировать(Пользователь);
	// закрытой учётке личное пространство не полагалось — заводим его вместе с входом
	СервисПользователей.ОбеспечитьЛичныйПул(Пользователь);
	Погашение.ПогаситьЖивые(Цел(Пользователь.Идентификатор));

	Летопись.СобытиеУчётки(Летопись.ДействиеПарольУстановлен(), Строка(Пользователь.Логин),
		Строка(Пользователь.Логин), Новый Структура("повод", Строка(Проверка.Заявка.Повод)),
		АдресIP);

	Возврат Исход(Истина, "", "", Пользователь);

КонецФункции

// Удаляет заявки с истёкшим сроком: мёртвая ссылка не хранится дольше своего срока.
//
// Параметры:
//  Момент - Дата - граница срока, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Число - сколько заявок удалено.
//
Функция УдалитьПросроченные(Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);

	Удалено = 0;
	Для Каждого Заявка Из Хранилище.ИстёкшиеДо(Сейчас) Цикл
		Хранилище.Удалить(Заявка);
		Удалено = Удалено + 1;
	КонецЦикла;

	Возврат Удалено;

КонецФункции

#КонецОбласти

#Область ПоводыИКоды

// Повод «учётку завели, вход открывается впервые».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПоводПриглашение() Экспорт
	Возврат "приглашение";
КонецФункции

// Повод «пароль существующей учётки сброшен администратором».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПоводСброс() Экспорт
	Возврат "сброс";
КонецФункции

// Повод «человек сам попросил ссылку восстановления со страницы входа». Отличается
// от сброса администратором тем, что за ним никто не ручался: ссылка ушла письмом
// на подтверждённый самим хабом адрес, а не была передана из рук в руки.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПоводВосстановление() Экспорт
	Возврат "восстановление";
КонецФункции

// Код отказа «такой ссылки нет» (в том числе мусор и чужой секрет).
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНетСсылки() Экспорт
	Возврат "invite_unknown";
КонецФункции

// Код отказа «срок ссылки вышел».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаПросрочена() Экспорт
	Возврат "invite_expired";
КонецФункции

// Код отказа «ссылкой уже воспользовались либо её погасил новый выпуск».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаПогашена() Экспорт
	Возврат "invite_used";
КонецФункции

// Код отказа «учётной записи ссылки больше нет».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНетУчётки() Экспорт
	Возврат "invite_no_user";
КонецФункции

// Код отказа «вход по логину и паролю на хабе выключен»: ссылка ни выпускается,
// ни погашается — пароль, заведённый по ней, вход не откроет.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаПарольныйВходВыключен() Экспорт
	Возврат "invite_password_login_disabled";
КонецФункции

// Код отказа «пароль не удовлетворяет политике»; ссылка при этом остаётся годной.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаПароль() Экспорт
	Возврат "invite_weak_password";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПоводДопустим(Знач Повод)
	Возврат Повод = ПоводПриглашение() ИЛИ Повод = ПоводСброс()
		ИЛИ Повод = ПоводВосстановление();
КонецФункции

// Разбирает oshub_inv_{id}_{secret}; Неопределено при любом отклонении.
Функция Разобрать(Знач Токен)

	Части = СтрРазделить(СокрЛП(Строка(Токен)), "_", Ложь);
	Если Части.Количество() <> 4 ИЛИ Части[0] <> "oshub" ИЛИ Части[1] <> "inv" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Идентификатор = Число(Части[2]);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ПустаяСтрока(Части[3]) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Идентификатор, Секрет", Идентификатор, Части[3]);

КонецФункции

Функция Sha256Hex(Знач Значение)
	Возврат Хеши.ОтСтроки(Значение);
КонецФункции

Функция ГодностьЗаявки(Знач Годна, Знач Причина, Знач Заявка, Знач Пользователь)
	Возврат Новый Структура("Годна, Причина, Заявка, Пользователь",
		Годна, Причина, Заявка, Пользователь);
КонецФункции

Функция Исход(Знач Удалось, Знач Причина, Знач Требования, Знач Пользователь)
	Поля = Новый Структура("Требования, Пользователь", Требования, Пользователь);
	Возврат ?(Удалось, Вердикты.Успех(Поля), Вердикты.Отказ(Причина, Поля));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеЗаявокНаПароль") _Хранилище,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "СервисАктивностиУчёток") _Активность,
	&Пластилин(Значение = "ПогашениеПриглашений") _Погашение,
	&Пластилин(Значение = "ПолитикаПароля") _ПолитикаПароля,
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _ПарольныйВход,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ЛетописьУчёток") _Летопись,
	&Пластилин(Значение = "СверкаСекретов") _Сверка,
	&Пластилин(Значение = "Хеш") _Хеши = Неопределено,
	&Пластилин(Значение = "Вердикт") _Вердикты = Неопределено)

	Вердикты = ?(_Вердикты = Неопределено, Новый Вердикт(), _Вердикты);
	Хеши = ?(_Хеши = Неопределено, Новый Хеш(), _Хеши);
	Хранилище = _Хранилище;
	СервисПользователей = _СервисПользователей;
	Активность = _Активность;
	Погашение = _Погашение;
	ПолитикаПароля = _ПолитикаПароля;
	ПарольныйВход = _ПарольныйВход;
	Настройки = _Настройки;
	Летопись = _Летопись;
	Сверка = _Сверка;

КонецПроцедуры
