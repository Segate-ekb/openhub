// Политика самостоятельной регистрации: режим хаба open | invite | disabled и гейт первого
// запуска. В режиме invite учётку заводит администратор и выдаёт одноразовую ссылку.

Перем СервисПользователей;  // СервисПользователей (auth)
Перем Настройки;            // СервисНастроек (настройки)
Перем ПарольныйВход;        // ПолитикаПарольногоВхода (auth)
Перем Подтверждение;        // СервисПодтвержденияEmail (auth)
&Лог
Перем Лог;

// Текущий режим регистрации; читается у резолвера в месте использования, поэтому
// правка настройки действует без рестарта.
//
// Возвращаемое значение:
//  Строка - open | invite | disabled.
//
Функция РежимРегистрации() Экспорт

	// список режимов и дефолт знает только реестр настроек, своей нормализации здесь нет
	Возврат Настройки.Значение("oshub.auth.registration.mode");

КонецФункции

// Открыта ли самостоятельная регистрация прямо сейчас. Регистрация заводит пароль,
// поэтому выключенный парольный вход закрывает её в любом режиме.
//
// Возвращаемое значение:
//  Булево.
//
Функция РегистрацияОткрыта() Экспорт
	Возврат РежимРегистрации() = "open" И НЕ ЗакрытаПарольнымВходом();
КонецФункции

// Закрыта ли регистрация из-за выключенного парольного входа.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЗакрытаПарольнымВходом() Экспорт
	Возврат ПарольныйВход.Выключен();
КонецФункции

// Закрыта ли регистрация состоянием почты: подтверждение адреса обещано настройкой,
// а слать письма нечем. Молча заведённая учётка, которой некуда выслать письмо, — это
// не «работает», а «сломано, и никто не заметил».
//
// Возвращаемое значение:
//  Булево.
//
Функция ЗакрытаНенастроеннойПочтой() Экспорт
	Возврат Подтверждение.ПодтверждениеНедостижимо();
КонецФункции

// Закрыта ли регистрация из-за незавершённого онбординга. Пока администратора нет,
// самостоятельная регистрация запрещена в любом режиме: иначе аноним создал бы первого
// пользователя с ролью user, необратимо закрыв мастер /setup и оставив хаб без админа.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЗаблокированаОнбордингом() Экспорт
	Возврат НЕ СервисПользователей.ЕстьХотяБыОднаУчётка();
КонецФункции

// Регистрирует пользователя логином и паролем с ролью user. До завершения онбординга —
// исключение registration_locked_onboarding независимо от режима; выключенный парольный
// вход, режимы invite и disabled, а также обещанное, но необеспеченное подтверждение
// адреса дают исключение с кодом причины в тексте.
//
// Параметры:
//  Логин - Строка - логин пользователя.
//  Email - Строка - адрес, может быть пустым.
//  Пароль - Строка - сырой пароль.
//  АдресIP - Строка - адрес клиента: по нему считается суточный потолок писем
//            с одного источника (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Пользователь - созданная запись; активна, email не подтверждён, письмо со ссылкой
//                 подтверждения послано, если почта настроена.
//
Функция Зарегистрировать(Знач Логин, Знач Email, Знач Пароль, Знач АдресIP = "") Экспорт

	Перем Режим;

	// гейт первого запуска — первой проверкой, до режима и до создания пользователя
	Если ЗаблокированаОнбордингом() Тогда
		Лог.Отладка("Регистрация ""%1"" закрыта: registration_locked_onboarding —"
			+ " администратора хаба ещё нет", Логин);
		ВызватьИсключение
			"registration_locked_onboarding: регистрация закрыта до создания первого администратора (мастер /setup)";
	КонецЕсли;

	// пароль здесь заводится, поэтому выключенный парольный вход закрывает и этот путь
	Если ЗакрытаПарольнымВходом() Тогда
		Лог.Отладка("Регистрация ""%1"" закрыта: registration_password_login_disabled", Логин);
		ВызватьИсключение
			"registration_password_login_disabled: регистрация по паролю закрыта — вход по логину и паролю выключен на хабе";
	КонецЕсли;

	Режим = РежимРегистрации();
	Лог.Отладка("Регистрация ""%1"": действующий режим хаба — ""%2""", Логин, Режим);
	Если Режим = "disabled" Тогда
		ВызватьИсключение "registration_disabled: регистрация на хабе отключена";
	КонецЕсли;
	Если Режим = "invite" Тогда
		ВызватьИсключение "registration_invite_only: регистрация только по приглашению —"
			+ " учётную запись заводит администратор и выдаёт ссылку установки пароля";
	КонецЕсли;

	// застава почты — последней из запретов, но до создания учётки: решение администратора
	// (режим хаба) объясняет отказ лучше, чем состояние почты, а заведённая сейчас учётная
	// запись осталась бы с неподтверждённым адресом навсегда
	Если ЗакрытаНенастроеннойПочтой() Тогда
		Лог.Отладка("Регистрация ""%1"" закрыта: registration_mail_not_configured —"
			+ " подтверждение адреса обещано настройкой, а слать письма нечем", Логин);
		ВызватьИсключение
			"registration_mail_not_configured: регистрация закрыта — на хабе включено"
			+ " подтверждение адреса письмом, а отправка почты не настроена."
			+ " Администратору: настроить почту либо выключить подтверждение адреса"
			+ " в настройках хаба";
	КонецЕсли;

	Новая = СервисПользователей.СоздатьПользователя(Логин, Email, Пароль, "user", Ложь);
	Лог.Отладка("Регистрация ""%1"": учётка заведена, пользователь #%2, адрес не подтверждён",
		Логин, Новая.Идентификатор);

	// письмо — попутное дело регистрации: сорвавшаяся отправка учётку не отменяет
	// (ненастроенную почту застава выше уже отсекла). Молча глохнуть исключение при этом
	// не имеет права: иначе упавшее хранилище заявок выглядит как «письма просто нет»
	Попытка
		Подтверждение.Запросить(Новая, Неопределено, АдресIP);
	Исключение
		Лог.Ошибка("Письмо подтверждения адреса учётки ""%1"" не запрошено: %2."
			+ " Учётная запись заведена, цикл подтверждения не начат.",
			Строка(Новая.Логин), СтрЗаменить(ОписаниеОшибки(), Символы.ПС, " "));
	КонецПопытки;

	Возврат Новая;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _ПарольныйВход,
	&Пластилин(Значение = "СервисПодтвержденияEmail") _Подтверждение,
	&Лог _Лог = Неопределено)

	СервисПользователей = _СервисПользователей;
	Настройки = _Настройки;
	ПарольныйВход = _ПарольныйВход;
	Подтверждение = _Подтверждение;
	// Лог параметром — для создания через `Новый` вне контейнера: инъекция в поле
	// `&Лог` туда не доезжает.
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
