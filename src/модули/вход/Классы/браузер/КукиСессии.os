// Сессионная кука браузера: имя, выдача, гашение и чтение из запроса. Любая дверь,
// выдающая или гасящая сессию, ходит сюда.

Перем Перехватчик;   // ПерехватчикАутентификации (вход) — имя куки
Перем Кука;          // КукаБраузера (вход) — атрибуты выдачи и гашения

// Имя сессионной куки.
//
// Возвращаемое значение:
//  Строка.
//
Функция Имя() Экспорт
	Возврат Перехватчик.ИмяКукиСессии();
КонецФункции

// Выдаёт браузеру сессионную куку.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//  ИдСессии - Строка - идентификатор сессии.
//
Процедура Установить(Ответ, Знач ИдСессии) Экспорт
	Кука.Установить(Ответ, Имя(), ИдСессии);
КонецПроцедуры

// Гасит сессионную куку у браузера: пустое значение и срок в прошлом.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//
Процедура Сбросить(Ответ) Экспорт
	Кука.Сбросить(Ответ, Имя());
КонецПроцедуры

// Идентификатор сессии из кук запроса.
//
// Параметры:
//  КукиЗапроса - Куки, Неопределено - куки запроса.
//
// Возвращаемое значение:
//  Строка, Неопределено - значение куки либо Неопределено, если её нет.
//
Функция ИзЗапроса(Знач КукиЗапроса) Экспорт
	Возврат Кука.ИзЗапроса(КукиЗапроса, Имя());
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик)

	Перехватчик = _Перехватчик;
	Кука = Новый КукаБраузера();

КонецПроцедуры
