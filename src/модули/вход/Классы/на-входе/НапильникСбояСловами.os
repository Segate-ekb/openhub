// Ставит на обработку запроса перевод сбоя в слова: желудь winow, через который проходит
// каждый запрос, подменяется обёрткой ОбработчикСоСбоемСловами.
//
// Порядок среди обёрток шва значим, и здесь он задан явно. Обёртка сбоя обязана стоять
// СНАРУЖИ всех остальных: только так она ловит исключение, вылетевшее из соседней обёртки,
// а не одну лишь поломку самого winow. Соседи по шву порядка не объявляют и получают
// осенний порядок по умолчанию, поэтому эта обёртка берёт число заведомо большее —
// напильники применяются по возрастанию, и последний становится внешним.

Перем Поделка;
Перем Лог;

// Подменяет обработчик запросов winow обёрткой, переводящей сбой в слова.
//
// Параметры:
//  Желудь - ОбработчикЗапросов - собранный желудь winow.
//  ОпределениеЖелудя - ОпределениеЖелудя - определение подменяемого желудя.
//
// Возвращаемое значение:
//  ОбработчикСоСбоемСловами.
//
Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт // BSLLS:UnusedParameters-off

	Лог.Отладка("Обработчик запросов обёрнут переводом сбоя в слова: сырая пятисотка"
		+ " и необработанное исключение станут страницей либо конвертом ошибки API");

	Возврат Новый ОбработчикСоСбоемСловами(Желудь,
		Поделка.НайтиЖелудь("ПричинаСбояЗапроса"),
		Поделка.НайтиЖелудь("ОтветыAPI"),
		Поделка.НайтиЖелудь("ФабрикаОтветов"),
		Поделка, Лог);

КонецФункции

&Напильник(ПрименяетсяТолькоНа = "ОбработчикЗапросов")
&Порядок(900)
Процедура ПриСозданииОбъекта(&Пластилин("Поделка") _Поделка, &Лог _Лог = Неопределено)

	// Лог параметром, а не полем: напильник собирается раньше прилепления полей.
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "НапильникСбояСловами собран без лога — сбой остался бы немым";
	КонецЕсли;

	Поделка = _Поделка;
	Лог = _Лог;

КонецПроцедуры
