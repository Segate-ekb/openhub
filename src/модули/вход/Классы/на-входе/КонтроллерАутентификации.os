// Контроллер аутентификации: register / login / logout / whoami под /api/v1.
// Кука сессии: HttpOnly, SameSite=Lax, Path=/.

Перем СервисАутентификации;   // СервисАутентификации (auth)
Перем СервисРегистрации;      // СервисРегистрации (auth)
Перем СлужбаСессий;           // СлужбаСессий (auth)
Перем Перехватчик;            // ПерехватчикАутентификации (auth)
Перем Кука;                   // КукиСессии (вход) — имя и атрибуты сессионной куки
Перем Ответы;                 // ОтветыAPI (основа)
Перем Отказы;                 // ОтказыУчётки (auth) — код, статус и текст причины отказа
Перем ГейтАдреса;             // ГейтПодтвержденияАдреса (auth) — нужен ли подтверждённый адрес
Перем ПустыеКуки;             // Куки (winow) - для снятия сессионной куки
Перем HTTP;                   // МетодыHTTP (основа)

#Область ТочкиМаршрута

// Регистрация с открытием сессии.
//
// Параметры:
//  Ответ - Ответ - ответ winow: 201 с пользователем, статус отказа из таблицы
//          ОтказыУчётки, 405 на другой метод.
//  ТелоЗапроса - Строка - тело запроса (json либо form-urlencoded): логин, email, пароль.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  МетодЗапроса - Строка - HTTP-метод запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента: по нему хаб считает суточный потолок
//                        писем подтверждения с одного источника.
//
&ТочкаМаршрута("register", Метод = "post")
&Операция(Сводка = "Регистрация с входом",
	Описание = "Тело (JSON или форма): `логин | login`, `email`, `пароль | password`. Если хаб требует
	|подтверждённый адрес, адрес указан и подтверждение достижимо, сессия не открывается и
	|`email_confirmation_required = true`; иначе ответ ставит куку `oshub_session`. Ответ
	|`{user, email_confirmation_required}`, `user` — учётка.")
&Возвращает(Код = 201, Описание = "`{user, email_confirmation_required}`")
&Возвращает(Код = 400, Описание = "`registration_failed` — логин, адрес или пароль не приняты")
&Возвращает(Код = 403, Описание = "`registration_disabled`, `registration_invite_only`,
	|`registration_password_login_disabled`, `registration_locked_onboarding` — регистрация закрыта")
&Возвращает(Код = 405, Описание = "`method_not_allowed`")
&Возвращает(Код = 409, Описание = "`user_exists` — логин занят; `email_taken` — адрес занят")
&Возвращает(Код = 503, Описание = "`registration_mail_not_configured` — подтверждение адреса включено, а
	|почта не настроена")
Процедура Регистрация(Ответ, ТелоЗапроса, ЗаголовкиЗапроса, МетодЗапроса, АдресУдаленногоУзла) Экспорт

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		ОтветМетодНеРазрешён(Ответ, "POST");
		Возврат;
	КонецЕсли;

	Тело = Ответы.РазобратьТело(ТелоЗапроса, ЗаголовкиЗапроса);
	Логин = Ответы.Поле(Тело, "логин", Ответы.Поле(Тело, "login"));
	Email = Ответы.Поле(Тело, "email");
	Пароль = Ответы.Поле(Тело, "пароль", Ответы.Поле(Тело, "password"));

	Попытка
		Пользователь = СервисРегистрации.Зарегистрировать(Логин, Email, Пароль,
			Строка(АдресУдаленногоУзла));
	Исключение
		Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
		ОтдатьОтказРегистрации(Ответ, ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;

	ПодтверждениеНужно = ГейтАдреса.Закрыт(Пользователь);

	// сессию открывает подтверждённый адрес, а не сама регистрация: пока ссылка из письма
	// не нажата, учётка заведена, но войти ею нельзя
	Если ПодтверждениеНужно Тогда
		Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
	Иначе
		Сессия = СлужбаСессий.Создать(Пользователь.Идентификатор);
		Кука.Установить(Ответ, Сессия.Идентификатор());
	КонецЕсли;

	Данные = Новый Структура("user", ПользовательВJSON(Пользователь));
	Данные.Вставить("email_confirmation_required", ПодтверждениеНужно);
	Ответы.JSON(Ответ, 201, Данные);

КонецПроцедуры

// Вход по логину и паролю.
//
// Параметры:
//  Ответ - Ответ - ответ winow: 200 с пользователем, 401, 429 при лимите, 405.
//  ТелоЗапроса - Строка - тело запроса: логин, пароль.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  МетодЗапроса - Строка - HTTP-метод запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента, ключ ограничителя попыток.
//
&ТочкаМаршрута("login", Метод = "post")
&Операция(Сводка = "Вход по паролю",
	Описание = "Тело (JSON или форма): `логин | login`, `пароль | password`. Успех ставит куку `oshub_session`.
	|Ответ `{user}` — учётка.")
&Возвращает(Код = 200, Описание = "`{user}`, кука сессии выставлена")
&Возвращает(Код = 401, Описание = "`invalid_credentials` — неверный логин или пароль")
&Возвращает(Код = 403, Описание = "`password_login_disabled` — вход по паролю выключен; `email_not_confirmed`")
&Возвращает(Код = 405, Описание = "`method_not_allowed`")
&Возвращает(Код = 429, Описание = "`rate_limited` — слишком много попыток входа")
Процедура Вход(Ответ, ТелоЗапроса, ЗаголовкиЗапроса, МетодЗапроса, АдресУдаленногоУзла) Экспорт

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		ОтветМетодНеРазрешён(Ответ, "POST");
		Возврат;
	КонецЕсли;

	Тело = Ответы.РазобратьТело(ТелоЗапроса, ЗаголовкиЗапроса);
	Логин = Ответы.Поле(Тело, "логин", Ответы.Поле(Тело, "login"));
	Пароль = Ответы.Поле(Тело, "пароль", Ответы.Поле(Тело, "password"));

	Результат = СервисАутентификации.ВойтиПоПаролю(Логин, Пароль, Строка(АдресУдаленногоУзла));

	Если НЕ Результат.Успех Тогда
		Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
		Если Результат.Причина = СервисАутентификации.ПричинаВыключен() Тогда
			Ответы.Ошибка(Ответ, 403, Результат.Причина,
				"Вход по логину и паролю на этом хабе выключен: войдите через провайдера");
		ИначеЕсли Результат.Причина = ГейтАдреса.Причина() Тогда
			Ответы.Ошибка(Ответ, 403, Результат.Причина,
				"Адрес электронной почты учётной записи не подтверждён: откройте ссылку"
				+ " из письма и нажмите кнопку подтверждения");
		ИначеЕсли Результат.Причина = "rate_limited" Тогда
			Ответы.Ошибка(Ответ, 429, "rate_limited", "Слишком много попыток входа, попробуйте позже");
		Иначе
			Ответы.Ошибка(Ответ, 401, "invalid_credentials", "Неверный логин или пароль");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Кука.Установить(Ответ, Результат.Сессия.Идентификатор());
	Ответы.JSON(Ответ, 200, Новый Структура("user", ПользовательВJSON(Результат.Пользователь)));

КонецПроцедуры

// Выход: завершение сессии.
//
// Параметры:
//  Ответ - Ответ - ответ winow: 200 либо 405 на другой метод.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса (идентификатор сессии).
//  МетодЗапроса - Строка - HTTP-метод запроса.
//
&ТочкаМаршрута("logout", Метод = "post")
&Операция(Сводка = "Выход",
	Описание = "Завершает сессию из куки `oshub_session` и сбрасывает куку; CSRF не требуется.
	|Отвечает 200 и без сессии. Ответ `{status: logged_out}`.")
&Возвращает(Код = 200, Описание = "`{status: logged_out}`")
&Возвращает(Код = 405, Описание = "`method_not_allowed`")
Процедура Выход(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		ОтветМетодНеРазрешён(Ответ, "POST");
		Возврат;
	КонецЕсли;

	ИдСессии = Кука.ИзЗапроса(КукиЗапроса);
	Если ЗначениеЗаполнено(ИдСессии) Тогда
		СлужбаСессий.Завершить(ИдСессии);
	КонецЕсли;

	Кука.Сбросить(Ответ);
	Ответы.JSON(Ответ, 200, Новый Структура("status", "logged_out"));

КонецПроцедуры

// Учётка запроса.
//
// Параметры:
//  Ответ - Ответ - ответ winow: 200 с пользователем и способом входа, 401, 405.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса (Authorization для PAT).
//  КукиЗапроса - Куки - куки запроса (сессия браузера).
//  МетодЗапроса - Строка - HTTP-метод запроса.
//
&ТочкаМаршрута("whoami", Метод = "get")
&Операция(Сводка = "Учётка запроса",
	Описание = "Кем хаб считает запрос — по ключу доступа либо по сессии. Ответ `{user}` —
	|учётка с полем `auth_method`: `token` | `session`.")
&Возвращает(Код = 200, Описание = "`{user}`")
&Возвращает(Код = 401, Описание = "`unauthorized`")
&Возвращает(Код = 405, Описание = "`method_not_allowed`")
Процедура КтоЯ(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтветМетодНеРазрешён(Ответ, "GET");
		Возврат;
	КонецЕсли;

	Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);

	Если Принципал.Пользователь = Неопределено Тогда
		Ответы.Ошибка(Ответ, 401, "unauthorized", "Требуется аутентификация");
		Возврат;
	КонецЕсли;

	Данные = ПользовательВJSON(Принципал.Пользователь);
	Данные.Вставить("auth_method", Принципал.Способ);
	Ответы.JSON(Ответ, 200, Новый Структура("user", Данные));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Причина отказа приезжает машинным кодом; статус, текст и подробности берёт таблица —
// одна на все двери регистрации.
Процедура ОтдатьОтказРегистрации(Ответ, Знач ИнфОбОшибке)
	Отказ = Отказы.Разобрать(ИнфОбОшибке);
	Ответы.Ошибка(Ответ, Отказ.Статус, Отказ.Код, Отказ.Сообщение, Отказ.Подробности);
КонецПроцедуры

Функция ПользовательВJSON(Знач Пользователь)
	Структура = Новый Структура();
	Структура.Вставить("id", Пользователь.Идентификатор);
	Структура.Вставить("login", Пользователь.Логин);
	Структура.Вставить("email", Пользователь.Email);
	Структура.Вставить("role", Пользователь.РольХаба);
	Структура.Вставить("email_confirmed", Пользователь.EmailПодтверждён);
	Структура.Вставить("must_change_password", Пользователь.ТребуетсяСменаПароля);
	Возврат Структура;
КонецФункции

Процедура ОтветМетодНеРазрешён(Ответ, Знач Разрешённый)
	Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
	Ответ.Заголовки["Allow"] = Разрешённый;
	Ответы.Ошибка(Ответ, 405, "method_not_allowed", СтрШаблон("Разрешён только метод %1", Разрешённый));
КонецПроцедуры

#КонецОбласти

&Контроллер("/api/v1")
&Группа("Вход", Описание = "Регистрация, вход и выход по паролю, учётка запроса. Сессия —
	|кука `oshub_session`; как ею пользоваться для мутаций, сказано в шапке документа. Учётка —
	|`{id, login, email, role, email_confirmed, must_change_password}`.")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисАутентификации") _СервисАутентификации,
	&Пластилин(Значение = "СервисРегистрации") _СервисРегистрации,
	&Пластилин(Значение = "СлужбаСессий") _СлужбаСессий,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ОтказыУчётки") _Отказы,
	&Пластилин(Значение = "ГейтПодтвержденияАдреса") _ГейтАдреса,
	&Пластилин(Значение = "Куки") _ПустыеКуки,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "КукиСессии") _Кука)

	HTTP = _HTTP;
	Кука = _Кука;

	СервисАутентификации = _СервисАутентификации;
	СервисРегистрации = _СервисРегистрации;
	СлужбаСессий = _СлужбаСессий;
	Перехватчик = _Перехватчик;
	Ответы = _Ответы;
	Отказы = _Отказы;
	ГейтАдреса = _ГейтАдреса;
	ПустыеКуки = _ПустыеКуки;

КонецПроцедуры
