// Ставит отметку негодного токена доступа на сборку ответа хаба: желудь winow, через
// который проходит каждый ответ, подменяется обёрткой ОбработчикСОтметкойТокена.

Перем Поделка;
Перем Лог;

// Подменяет обработчик запросов winow обёрткой, отмечающей негодный токен доступа.
//
// Параметры:
//  Желудь - ОбработчикЗапросов - собранный желудь winow.
//  ОпределениеЖелудя - ОпределениеЖелудя - определение подменяемого желудя.
//
// Возвращаемое значение:
//  ОбработчикСОтметкойТокена.
//
Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт // BSLLS:UnusedParameters-off

	Возврат Новый ОбработчикСОтметкойТокена(Желудь,
		Поделка.НайтиЖелудь("ПерехватчикАутентификации"), Лог);

КонецФункции

&Напильник(ПрименяетсяТолькоНа = "ОбработчикЗапросов")
Процедура ПриСозданииОбъекта(&Пластилин("Поделка") _Поделка, &Лог _Лог = Неопределено)

	// Лог параметром, а не полем: напильник собирается раньше прилепления полей.
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "НапильникОтметкиТокена собран без лога — сбой отметки был бы немым";
	КонецЕсли;

	Поделка = _Поделка;
	Лог = _Лог;

КонецПроцедуры
