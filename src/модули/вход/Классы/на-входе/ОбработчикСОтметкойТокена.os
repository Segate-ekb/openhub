// Обработчик запросов winow, обёрнутый отметкой состояния токена доступа. Обслуживание
// не меняется; меняются два заголовка — состояние токена и запрет кэшировать за анонима.

Перем Обработчик;   // ОбработчикЗапросов (winow)
Перем Перехватчик;  // ПерехватчикАутентификации (вход)
Перем Лог;

// Формирует ответ обёрнутым обработчиком и отмечает в нём негодный токен доступа.
//
// Параметры:
//  Запрос - ВходящийЗапрос - запрос winow.
//
// Возвращаемое значение:
//  Ответ - ответ winow, каким его собрал обёрнутый обработчик.
//
Функция СформироватьОтвет(Запрос) Экспорт

	Ответ = Обработчик.СформироватьОтвет(Запрос);

	// Отметка — сведение о запросе, а не сам ответ: собранный ответ она отменять не вправе,
	// иначе поход в хранилище токенов ронял бы пятисоткой адреса, к токенам не ходившие.
	Попытка
		Отметить(Ответ, Перехватчик.ПроблемаТокена(Запрос.Заголовки));
	Исключение
		Лог.Ошибка("Состояние токена не определено, ответ уходит без отметки: %1",
			ОписаниеОшибки());
	КонецПопытки;

	Возврат Ответ;

КонецФункции

// --- служебные ---

Функция ИмяЗаголовка()
	Возврат "OSHub-Token-Status";
КонецФункции

Процедура Отметить(Ответ, Знач ПроблемаТокена)

	Если НЕ ЗначениеЗаполнено(ПроблемаТокена) Тогда
		Возврат;
	КонецЕсли;

	Ответ.Заголовки[ИмяЗаголовка()] = ПроблемаТокена;

	КлючКэша = КлючУказанийКэшу(Ответ.Заголовки);
	Ответ.Заголовки[КлючКэша] = БезОбщегоКэша(Ответ.Заголовки[КлючКэша]);

КонецПроцедуры

// Одна поправка к Cache-Control; остальные указания контроллера остаются как были.
Функция БезОбщегоКэша(Знач ТекущееЗначение)

	Указания = Новый Массив();
	Указания.Добавить("private");

	Для Каждого Часть Из СтрРазделить(?(ТекущееЗначение = Неопределено, "", Строка(ТекущееЗначение)), ",", Ложь) Цикл
		Указание = СокрЛП(Часть);
		Если ЗначениеЗаполнено(Указание) И НРег(Указание) <> "public" И НРег(Указание) <> "private" Тогда
			Указания.Добавить(Указание);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Указания, ", ");

КонецФункции

// Ключ в написании контроллера: соответствие заголовков различает регистр.
Функция КлючУказанийКэшу(Знач Заголовки)

	Для Каждого КиЗ Из Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = "CACHE-CONTROL" Тогда
			Возврат КиЗ.Ключ;
		КонецЕсли;
	КонецЦикла;

	Возврат "Cache-Control";

КонецФункции

Процедура ПриСозданииОбъекта(Знач ОбёрнутыйОбработчик, Знач ПерехватчикЗапроса, Знач _Лог) Экспорт

	// Обёртку собирает напильник оператором «Новый»: желудем она не бывает, поэтому лог
	// приходит от создателя наравне с остальными сотрудниками. Без лога сбой отметки
	// был бы немым — падаем сразу.
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "ОбработчикСОтметкойТокена создан без лога — напильник или тест обязан его передать";
	КонецЕсли;

	Обработчик = ОбёрнутыйОбработчик;
	Перехватчик = ПерехватчикЗапроса;
	Лог = _Лог;

КонецПроцедуры
