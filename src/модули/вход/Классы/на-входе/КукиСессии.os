// Сессионная кука браузера: имя, атрибуты выдачи и чтение из запроса. Атрибуты собраны
// одним местом — кука, выданная без HttpOnly или без SameSite, открывает сессию чужому
// скрипту и чужому сайту, и разойтись у двух выдающих её сторон они не должны.

Перем Перехватчик;   // ПерехватчикАутентификации (вход) — имя куки

// Имя сессионной куки.
//
// Возвращаемое значение:
//  Строка.
//
Функция Имя() Экспорт
	Возврат Перехватчик.ИмяКукиСессии();
КонецФункции

// Выдаёт браузеру сессионную куку.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//  ИдСессии - Строка - идентификатор сессии.
//
Процедура Установить(Ответ, Знач ИдСессии) Экспорт

	Кука = Ответ.Куки.Добавить(Имя(), ИдСессии);
	Кука.ТолькоХттп = Истина;
	Кука.Путь = "/";
	Кука.ТотжеСайт = "Lax";

КонецПроцедуры

// Гасит сессионную куку у браузера: пустое значение и срок в прошлом.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//
Процедура Сбросить(Ответ) Экспорт

	Кука = Ответ.Куки.Добавить(Имя(), "");
	Кука.ТолькоХттп = Истина;
	Кука.Путь = "/";
	Кука.ТотжеСайт = "Lax";
	Кука.ДатаИстечения = Дата(2000, 1, 1);

КонецПроцедуры

// Идентификатор сессии из кук запроса.
//
// Параметры:
//  КукиЗапроса - Куки, Неопределено - куки запроса.
//
// Возвращаемое значение:
//  Строка, Неопределено - значение куки либо Неопределено, если её нет.
//
Функция ИзЗапроса(Знач КукиЗапроса) Экспорт

	Если КукиЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат КукиЗапроса.ПолучитьЗначениеПоИмени(Имя());

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик)

	Перехватчик = _Перехватчик;

КонецПроцедуры
