// Перехватчик аутентификации: определяет личность запроса — PAT в Authorization:
// Bearer или OAUTH-TOKEN (приоритет), иначе сессионная кука браузера.
// Сервис-охранник, а не middleware winow: штатный механизм &Роли даёт глобальные роли
// и под объектную модель прав хаба не годится, решение 401/403 остаётся за контроллером.

Перем СервисТокенов;        // СервисТокенов (auth)
Перем СлужбаСессий;         // СлужбаСессий (auth)
Перем СервисПользователей;  // СервисПользователей (auth)

// Пришёл ли запрос с ключом (PAT), а не по сессии браузера.
//
// Параметры:
//  Принципал - Структура, Неопределено - результат ОпределитьПринципала.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоКлюч(Знач Принципал) Экспорт
	Возврат Принципал <> Неопределено
		И НРег(СокрЛП(Строка(Принципал.Способ))) = "token";
КонецФункции

// Может ли принципал управлять ключами доступа (выпуск, отзыв, перечисление).
// Инвариант «ключ не размножается» — одна формулировка на весь хаб: ключом эти операции
// недоступны, иначе read-only PAT выписал бы себе полный непривязанный токен.
//
// Параметры:
//  Принципал - Структура, Неопределено - результат ОпределитьПринципала.
//
// Возвращаемое значение:
//  Булево.
//
Функция УправлениеКлючамиРазрешено(Знач Принципал) Экспорт
	Возврат НЕ ЭтоКлюч(Принципал);
КонецФункции

// Имя сессионной куки (общая константа для контроллеров).
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяКукиСессии() Экспорт
	Возврат "oshub_session";
КонецФункции

// Определяет принципала запроса: ключ имеет приоритет над сессией, негодный ключ
// делает запрос анонимным (к куке не откатываемся). Результат — всегда структура.
//
// Параметры:
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса (Authorization, OAUTH-TOKEN).
//  КукиЗапроса - Куки, Неопределено - куки запроса.
//  Момент - Дата - момент проверки, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Структура - Пользователь (Пользователь, Неопределено — аноним), Способ
//              (Строка: "token" | "session" | ""), Права (Строка — скоупы ключа),
//              ПулИдентификатор (Число — привязка ключа, 0 — весь хаб),
//              Сессия (СессияХаба, Неопределено).
//
Функция ОпределитьПринципала(Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);

	ЗначениеТокена = ИзвлечьТокен(ЗаголовкиЗапроса);
	Если ЗначениеЗаполнено(ЗначениеТокена) Тогда
		Проверка = СервисТокенов.Проверить(ЗначениеТокена, Сейчас);
		Если Проверка <> Неопределено Тогда
			Пользователь = СервисПользователей.ПоИдентификатору(Проверка.ПользовательИдентификатор);
			Если Пользователь <> Неопределено И Пользователь.Активен Тогда
				Возврат Принципал(Пользователь, "token", Проверка.Права, Проверка.ПулИдентификатор, Неопределено);
			КонецЕсли;
		КонецЕсли;
		// негодный токен → аноним; cookie не пробуем, клиент прислал токен явно
		Возврат Принципал(Неопределено, "", "", 0, Неопределено);
	КонецЕсли;

	ИдСессии = ЗначениеКуки(КукиЗапроса, ИмяКукиСессии());
	Если ЗначениеЗаполнено(ИдСессии) Тогда
		Сессия = СлужбаСессий.Получить(ИдСессии, Сейчас);
		Если Сессия <> Неопределено Тогда
			ПользовательИд = Сессия.Значение("пользователь");
			Если ТипЗнч(ПользовательИд) = Тип("Число") Тогда
				Пользователь = СервисПользователей.ПоИдентификатору(ПользовательИд);
				Если Пользователь <> Неопределено И Пользователь.Активен Тогда
					Возврат Принципал(Пользователь, "session", "", 0, Сессия);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Возврат Принципал(Неопределено, "", "", 0, Неопределено);

КонецФункции

// --- служебные ---

// Извлекает значение PAT из заголовков: "Authorization: Bearer X" или "OAUTH-TOKEN: X".
Функция ИзвлечьТокен(Знач ЗаголовкиЗапроса)

	Авторизация = Заголовок(ЗаголовкиЗапроса, "Authorization");
	Если ЗначениеЗаполнено(Авторизация) Тогда
		ЗначениеАвт = СокрЛП(Строка(Авторизация));
		Если СтрНачинаетсяС(ВРег(ЗначениеАвт), "BEARER ") Тогда
			Возврат СокрЛП(Сред(ЗначениеАвт, 8));
		КонецЕсли;
	КонецЕсли;

	OAuth = Заголовок(ЗаголовкиЗапроса, "OAUTH-TOKEN");
	Если ЗначениеЗаполнено(OAuth) Тогда
		Возврат СокрЛП(Строка(OAuth));
	КонецЕсли;

	Возврат "";

КонецФункции

// Значение заголовка по имени (регистр имени не значим).
Функция Заголовок(Знач ЗаголовкиЗапроса, Знач Имя)

	Если ЗаголовкиЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИскомыйКлюч = ВРег(Имя);
	Для Каждого КиЗ Из ЗаголовкиЗапроса Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = ИскомыйКлюч Тогда
			Возврат КиЗ.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Значение request-cookie по имени (объект Куки winow).
Функция ЗначениеКуки(Знач КукиЗапроса, Знач Имя)
	Если КукиЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат КукиЗапроса.ПолучитьЗначениеПоИмени(Имя);
КонецФункции

Функция Принципал(Знач Пользователь, Знач Способ, Знач Права, Знач ПулИдентификатор, Знач Сессия)
	Структура = Новый Структура();
	Структура.Вставить("Пользователь", Пользователь);
	Структура.Вставить("Способ", Способ);
	Структура.Вставить("Права", Права);
	Структура.Вставить("ПулИдентификатор", ПулИдентификатор);
	Структура.Вставить("Сессия", Сессия);
	Возврат Структура;
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисТокенов") _СервисТокенов,
	&Пластилин(Значение = "СлужбаСессий") _СлужбаСессий,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей)

	СервисТокенов = _СервисТокенов;
	СлужбаСессий = _СлужбаСессий;
	СервисПользователей = _СервисПользователей;

КонецПроцедуры
