// Обработчик запросов winow, обёрнутый определением адреса клиента: меняется одно поле
// запроса — адрес узла, и всё, что считается по адресу, берёт его отсюда.

Перем Обработчик;   // ОбработчикЗапросов (winow)
Перем Адреса;       // АдресКлиентаЗапроса (вход)
Перем Лог;

// Проставляет запросу адрес клиента и отдаёт его обёрнутому обработчику.
//
// Параметры:
//  Запрос - ВходящийЗапрос - запрос winow.
//
// Возвращаемое значение:
//  Ответ - ответ winow, каким его собрал обёрнутый обработчик.
//
Функция СформироватьОтвет(Запрос) Экспорт

	// сбой определения адреса обслуживание не роняет: запрос уходит с адресом соединения
	Попытка
		Запрос.АдресУдаленногоУзла = Адреса.Определить(Запрос.АдресУдаленногоУзла, Запрос.Заголовки);
	Исключение
		Лог.Ошибка("Адрес клиента не определён, запрос обслуживается с адресом соединения: %1",
			ОписаниеОшибки());
	КонецПопытки;

	Возврат Обработчик.СформироватьОтвет(Запрос);

КонецФункции

Процедура ПриСозданииОбъекта(Знач ОбёрнутыйОбработчик, Знач ОпределительАдреса, Знач _Лог) Экспорт

	// обёртку собирает напильник оператором «Новый»: лог приходит параметром и обязателен
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "ОбработчикСАдресомКлиента создан без лога — напильник или тест обязан его передать";
	КонецЕсли;

	Обработчик = ОбёрнутыйОбработчик;
	Адреса = ОпределительАдреса;
	Лог = _Лог;

КонецПроцедуры
