// Ответ на адрес, который не объявил ни один маршрут: winow отвечает своим 404 с голым
// шаблоном, а хаб называет его словами по двери — конвертом «not_found» машине и страницей
// «адрес не найден» с навигацией человеку.

Перем Ответы;     // ОтветыAPI (основа) — конверт ошибки машинной двери
Перем Дверь;      // ДверьЗапроса (вход) — чья дверь: машины или человека
Перем Поделка;    // поиск слов: страница собирается на первом неизвестном адресе, не на старте
Перем Слова_;     // НеизвестныйАдресСловами — найденный желудь
Перем Лог;

#Область ПубличныйИнтерфейс

// Подменяет 404, собранный winow, ответом хаба. Неизвестный адрес — не сбой: в журнал
// он уходит отладкой, иначе перебор адресов ботом засыпал бы журнал ошибками.
//
// Параметры:
//  Запрос - ВходящийЗапрос - запрос winow.
//  Собранный - Ответ - 404 со стандартным шаблоном winow; он же и возвращается.
//  КодЗапроса - Строка - код запроса, которым подписаны ответ и строка журнала.
//
// Возвращаемое значение:
//  Ответ - тот же ответ с телом хаба.
//
Функция Ответить(Знач Запрос, Знач Собранный, Знач КодЗапроса) Экспорт

	Лог.Отладка("Запрос %1: %2 %3 — маршрута нет", КодЗапроса, Строка(Запрос.Метод),
		Строка(Запрос.Путь));

	Собранный.ИдентификаторЗапроса = КодЗапроса;
	Если Дверь.Машинная(Запрос) Тогда
		Ответы.Ошибка(Собранный, 404, КодОтказа(), Фраза());
	Иначе
		ОтдатьСтраницу(Собранный, Запрос);
	КонецЕсли;

	Возврат Собранный;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Страница собирается слоем представления. Не собралась — наружу уходит фраза текстом.
Процедура ОтдатьСтраницу(Ответ, Знач Запрос)

	Разметка = "";
	Попытка
		Разметка = Слова().Страница(Запрос.Заголовки, Запрос.Куки, Строка(Запрос.Путь));
	Исключение
		Лог.Ошибка("Страница неизвестного адреса не собралась, ответ уходит текстом: %1",
			ОписаниеОшибки());
	КонецПопытки;

	Если ЗначениеЗаполнено(Разметка) Тогда
		Ответ.Заголовки["Content-Type"] = "text/html; charset=utf-8";
		Ответ.ТелоТекст = Разметка;
		Возврат;
	КонецЕсли;

	Ответ.Заголовки["Content-Type"] = "text/plain; charset=utf-8";
	Ответ.ТелоТекст = Фраза();

КонецПроцедуры

// Фраза приходит из слоя представления; не пришла — наружу уходит машинный код.
Функция Фраза()

	Попытка
		Возврат Слова().Фраза();
	Исключение
		Лог.Ошибка("Слова о неизвестном адресе недоступны, наружу уходит машинный код: %1",
			ОписаниеОшибки());
		Возврат КодОтказа();
	КонецПопытки;

КонецФункции

// Желудь слов ищется на первом неизвестном адресе: иначе граф представления поднимался бы
// до старта веб-сервера.
Функция Слова()

	Если Слова_ = Неопределено Тогда
		Слова_ = Поделка.НайтиЖелудь("НеизвестныйАдресСловами");
	КонецЕсли;

	Возврат Слова_;

КонецФункции

Функция КодОтказа()
	Возврат "not_found";
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач ОтветыМашиннойДвери, Знач ДверьЗапроса, Знач ЖелудиХаба,
	Знач _Лог) Экспорт

	Ответы = ОтветыМашиннойДвери;
	Дверь = ДверьЗапроса;
	Поделка = ЖелудиХаба;
	Лог = _Лог;

КонецПроцедуры
