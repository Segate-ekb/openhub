// Напильник обработчика запросов winow: пара обёрток в значимом порядке — снаружи проверка
// заголовка страны по адресу соединения, внутри адрес клиента из заголовка пересылки.

Перем Поделка;
Перем Лог;

// Подменяет обработчик запросов winow парой обёрток: внешняя проверяет заголовок страны,
// внутренняя проставляет запросу адрес клиента.
//
// Параметры:
//  Желудь - ОбработчикЗапросов - собранный желудь winow.
//  ОпределениеЖелудя - ОпределениеЖелудя - определение подменяемого желудя.
//
// Возвращаемое значение:
//  ОбработчикСоСтранойОтПрокси.
//
Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт // BSLLS:UnusedParameters-off

	Лог.Отладка("Обработчик запросов обёрнут определением адреса клиента и проверкой"
		+ " заголовка страны: за доверенным прокси адресом запроса станет адрес человека,"
		+ " а заголовок страны с недоверенного соединения будет снят");

	САдресом = Новый ОбработчикСАдресомКлиента(Желудь,
		Поделка.НайтиЖелудь("АдресКлиентаЗапроса"), Лог);

	Возврат Новый ОбработчикСоСтранойОтПрокси(САдресом,
		Поделка.НайтиЖелудь("ДовериеЗаголовкуСтраны"));

КонецФункции

&Напильник(ПрименяетсяТолькоНа = "ОбработчикЗапросов")
Процедура ПриСозданииОбъекта(&Пластилин("Поделка") _Поделка, &Лог _Лог = Неопределено)

	// Лог параметром, а не полем: напильник собирается раньше прилепления полей.
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "НапильникАдресаКлиента собран без лога — сбой определения адреса был бы немым";
	КонецЕсли;

	Поделка = _Поделка;
	Лог = _Лог;

КонецПроцедуры
