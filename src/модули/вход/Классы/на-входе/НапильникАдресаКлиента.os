// Ставит определение адреса клиента на обработку запроса: желудь winow, через который
// проходит каждый запрос, подменяется обёрткой ОбработчикСАдресомКлиента.
//
// С НапильникОтметкиТокена порядок безразличен: этот пишет поле запроса ДО делегирования,
// тот правит собранный ответ ПОСЛЕ. Третий напильник на том же желуде безразличным быть
// уже не обязан — заводя его, проверьте, что он не читает адрес до нашей записи.

Перем Поделка;
Перем Лог;

// Подменяет обработчик запросов winow обёрткой, проставляющей запросу адрес клиента.
//
// Параметры:
//  Желудь - ОбработчикЗапросов - собранный желудь winow.
//  ОпределениеЖелудя - ОпределениеЖелудя - определение подменяемого желудя.
//
// Возвращаемое значение:
//  ОбработчикСАдресомКлиента.
//
Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт // BSLLS:UnusedParameters-off

	Лог.Отладка("Обработчик запросов обёрнут определением адреса клиента:"
		+ " за доверенным прокси адресом запроса станет адрес человека");

	Возврат Новый ОбработчикСАдресомКлиента(Желудь,
		Поделка.НайтиЖелудь("АдресКлиентаЗапроса"), Лог);

КонецФункции

&Напильник(ПрименяетсяТолькоНа = "ОбработчикЗапросов")
Процедура ПриСозданииОбъекта(&Пластилин("Поделка") _Поделка, &Лог _Лог = Неопределено)

	// Лог параметром, а не полем: напильник собирается раньше прилепления полей.
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "НапильникАдресаКлиента собран без лога — сбой определения адреса был бы немым";
	КонецЕсли;

	Поделка = _Поделка;
	Лог = _Лог;

КонецПроцедуры
