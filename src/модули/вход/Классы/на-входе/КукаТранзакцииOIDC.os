// Кука серверной транзакции OIDC: имя спрашивается у хранителя транзакций, атрибуты —
// те же, что у сессионной куки. Ставят её две двери — вход провайдером и привязка
// личности в кабинете, и разъехаться атрибутам нельзя.

Перем Транзакции;  // ХранительТранзакцийOIDC (вход) — имя куки

// Имя куки транзакции.
//
// Возвращаемое значение:
//  Строка.
//
Функция Имя() Экспорт
	Возврат Транзакции.ИмяКуки();
КонецФункции

// Выдаёт браузеру ключ транзакции.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//  Ключ - Строка - ключ серверной транзакции.
//
Процедура Установить(Ответ, Знач Ключ) Экспорт

	Кука = Ответ.Куки.Добавить(Имя(), Ключ);
	Кука.ТолькоХттп = Истина;
	Кука.Путь = "/";
	Кука.ТотжеСайт = "Lax";

КонецПроцедуры

// Гасит куку транзакции у браузера: пустое значение и срок в прошлом.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//
Процедура Сбросить(Ответ) Экспорт

	Кука = Ответ.Куки.Добавить(Имя(), "");
	Кука.ТолькоХттп = Истина;
	Кука.Путь = "/";
	Кука.ТотжеСайт = "Lax";
	Кука.ДатаИстечения = Дата(2000, 1, 1);

КонецПроцедуры

// Ключ транзакции из кук запроса.
//
// Параметры:
//  КукиЗапроса - Куки, Неопределено - куки запроса.
//
// Возвращаемое значение:
//  Строка, Неопределено - значение куки либо Неопределено, если её нет.
//
Функция ИзЗапроса(Знач КукиЗапроса) Экспорт

	Если КукиЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат КукиЗапроса.ПолучитьЗначениеПоИмени(Имя());

КонецФункции

&Прозвище("КукаТранзакцииOIDC")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранительТранзакцийOIDC") _Транзакции) Экспорт

	Транзакции = _Транзакции;

КонецПроцедуры
