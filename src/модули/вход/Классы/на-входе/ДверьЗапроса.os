// Какой двери адресован запрос: машинной — по адресу ходят программы либо клиент сам попросил
// JSON, — или человеческой. От двери зависит, чем хаб отвечает на исход без обработчика:
// конвертом ошибки API или страницей.

Перем ЧтениеЗаголовков; // ЗаголовкиHTTP (основа) — чтение Accept без оглядки на регистр

#Область ПубличныйИнтерфейс

// Адресован ли запрос машинной двери.
//
// Параметры:
//  Запрос - ВходящийЗапрос - запрос winow: путь и заголовки.
//
// Возвращаемое значение:
//  Булево - Истина, если отвечать нужно конвертом, а не страницей.
//
Функция Машинная(Знач Запрос) Экспорт

	Путь = НРег(СокрЛП(Строка(Запрос.Путь)));

	Если МашинныеАдреса().Найти(Путь) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Корень Из МашинныеКорни() Цикл
		Если Путь = Корень ИЛИ СтрНачинаетсяС(Путь, Корень + "/") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Если ЭтоМашиннаяРучкаПула(Путь) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СтрНайти(НРег(ЧтениеЗаголовков.Текст(Запрос.Заголовки, "Accept")),
		"application/json") > 0;

КонецФункции

#КонецОбласти

#Область МашинныеАдреса

// Адреса целиком: у проб продолжения не бывает, и «/readymade» пробой не является.
// Пробы в этом списке потому, что ходит по ним kubelet, а он Accept не шлёт вовсе.
Функция МашинныеАдреса()

	Результат = Новый Массив();
	Результат.Добавить("/health");
	Результат.Добавить("/ready");
	Возврат Результат;

КонецФункции

// Начала адресов: под ними лежат целые семейства машинных ручек.
Функция МашинныеКорни()

	Результат = Новый Массив();
	Результат.Добавить("/api");
	Результат.Добавить("/push");
	Результат.Добавить("/download");
	Результат.Добавить("/dev-channel");
	Результат.Добавить("/changes");
	Возврат Результат;

КонецФункции

// Под «/pools/{пул}» живут и страницы пула, и ручки opm. Машинные — выдача, каналы, публикация
// и лента изменений пула; страница пула, его пакеты и настройки — человеческие.
Функция ЭтоМашиннаяРучкаПула(Знач Путь)

	Части = СтрРазделить(Путь, "/", Ложь);
	Если Части.Количество() < 3 ИЛИ Части[0] <> "pools" Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат МашинныеРучкиПула().Найти(Части[2]) <> Неопределено;

КонецФункции

Функция МашинныеРучкиПула()

	Результат = Новый Массив();
	Результат.Добавить("download");
	Результат.Добавить("channels");
	Результат.Добавить("push");
	Результат.Добавить("changes");
	Возврат Результат;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта() Экспорт
	ЧтениеЗаголовков = Новый ЗаголовкиHTTP();
КонецПроцедуры
