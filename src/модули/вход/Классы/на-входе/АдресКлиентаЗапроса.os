// Единственное место, где хаб решает, с какого адреса пришёл запрос: за доверенным
// обратным прокси это адрес клиента из цепочки пересылки.

Перем ДоверенныеСети;  // ДоверенныеПрокси (вход)
Перем Пересылка;       // ЗаписиПересылки (вход)
Перем Канон;           // КанонIP (основа)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Адрес клиента одного запроса.
//
// Параметры:
//  АдресСоединения - Строка - адрес, с которого пришло соединение.
//  Заголовки - Соответствие - заголовки запроса.
//
// Возвращаемое значение:
//  Строка - адрес клиента; за недоверенным соединением и при нечитаемой цепочке —
//           адрес соединения, каким он пришёл.
//
Функция Определить(Знач АдресСоединения, Знач Заголовки) Экспорт

	Соединение = СокрЛП(Строка(?(АдресСоединения = Неопределено, "", АдресСоединения)));

	// список читается один раз на запрос: дальше его спрашивают по разу на запись цепочки
	Свои = ДоверенныеСети.Снимок();

	Если НЕ ДоверенныеСети.Доверенный(Свои, Соединение) Тогда
		Возврат Соединение;
	КонецЕсли;

	Цепочка = Пересылка.Цепочка(Заголовки);
	Если Цепочка.Количество() = 0 Тогда
		Отладка("Соединение %1 доверенное, но заголовка пересылки в запросе нет —"
			+ " адресом клиента остаётся адрес соединения", Соединение);
		Возврат Соединение;
	КонецЕсли;

	Возврат ПервыйСправаНеПрокси(Цепочка, Свои, Соединение);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Свои прокси в хвосте цепочки пропускаются; левее первого чужого не читается — это пишет клиент.
Функция ПервыйСправаНеПрокси(Знач Цепочка, Знач Свои, Знач Соединение)

	Для Сдвиг = 0 По Цепочка.ВГраница() Цикл

		Запись = Цепочка[Цепочка.ВГраница() - Сдвиг];
		Адрес = Канон.Строкой(Запись);

		Если НЕ ЗначениеЗаполнено(Адрес) Тогда
			Отладка("Запись ""%1"" в цепочке пересылки адресом не является —"
				+ " адресом клиента остаётся адрес соединения %2", Запись, Соединение);
			Возврат Соединение;
		КонецЕсли;

		Если НЕ ДоверенныеСети.Доверенный(Свои, Адрес) Тогда
			Возврат Адрес;
		КонецЕсли;

	КонецЦикла;

	Отладка("Вся цепочка пересылки — свои прокси, клиента в ней нет —"
		+ " адресом клиента остаётся адрес соединения %1", Соединение);

	Возврат Соединение;

КонецФункции

// Подстановка — до вызова журнала: шаблон-переменная в самом вызове скрыла бы арность.
Процедура Отладка(Знач Шаблон, Знач Первый = Неопределено, Знач Второй = Неопределено)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Сообщение = СтрШаблон(Шаблон, Первый, Второй);
	Лог.Отладка(Сообщение);

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ДоверенныеПрокси") _ДоверенныеСети,
	&Пластилин(Значение = "ЗаписиПересылки") _Пересылка,
	&Пластилин(Значение = "КанонIP") _Канон,
	&Лог _Лог = Неопределено) Экспорт

	ДоверенныеСети = _ДоверенныеСети;
	Пересылка = _Пересылка;
	Канон = _Канон;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
