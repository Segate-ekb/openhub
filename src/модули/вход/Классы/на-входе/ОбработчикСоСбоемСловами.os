// Обработчик запросов winow, обёрнутый переводом в слова исходов, до которых не дотянулся
// ни один обработчик: сбоя и адреса без маршрута. Обслуживание не меняется. Сбой шов
// называет сам; ответ на адрес без маршрута — ОтветНеизвестномуАдресу, дверь запроса
// у обоих исходов одна — ДверьЗапроса.
//
// Сбой перехватывается с двух сторон, потому что winow теряет его двумя разными способами.
// Исключение, вылетевшее мимо его собственной ловушки (маршрутизация, проверка токена,
// соседняя обёртка), не ловит никто, и сервер отвечает своим текстом. Исключение, до
// которого ловушка дотянулась, становится пятисоткой с дословным ОписаниемОшибки()
// в теле — путь к модулю чужой библиотеки и номер строки на экране у посетителя.
//
// Наружу вместо этого уходит фраза и код запроса: машинной двери — конвертом ошибки API,
// человеку — страницей в оформлении хаба. Подробности остаются в журнале.

Перем Обработчик;  // ОбработчикЗапросов (winow)
Перем Причины;     // ПричинаСбояЗапроса (основа) — код отказа, статус и Retry-After
Перем Ответы;      // ОтветыAPI (основа) — конверт ошибки машинной двери
Перем Дверь;       // ДверьЗапроса (вход) — чья дверь: машины или человека
Перем Неизвестный; // ОтветНеизвестномуАдресу (вход) — исход «маршрута нет»
Перем Ошибки;      // ТекстОшибки (основа) — причина строкой и полный отчёт
Перем Фабрика;     // ФабрикаОтветов (winow) — ответ, которого ещё нет
Перем Поделка;     // поиск желудей слов: их ищут на первом исходе, а не на старте
Перем СловаОСбое;  // СбойХабаСловами — найденный желудь
Перем Лог;

// Формирует ответ обёрнутым обработчиком, подменяя сбой и неизвестный адрес понятной
// страницей либо конвертом.
//
// Параметры:
//  Запрос - ВходящийЗапрос - запрос winow.
//
// Возвращаемое значение:
//  Ответ - ответ winow: чужой, если запрос обслужен, и собранный здесь, если нет.
//
Функция СформироватьОтвет(Запрос) Экспорт

	Попытка
		Ответ = Обработчик.СформироватьОтвет(Запрос);
	Исключение
		Возврат СбойОбъектом(Запрос, ИнформацияОбОшибке());
	КонецПопытки;

	Если ЭтоОтказСобранныйWinow(Ответ, 500) Тогда
		Возврат СбойСтрокой(Запрос, Ответ);
	КонецЕсли;

	Если ЭтоОтказСобранныйWinow(Ответ, 404) Тогда
		Возврат Неизвестный.Ответить(Запрос, Ответ, КодЗапроса(Запрос));
	КонецЕсли;

	Возврат Ответ;

КонецФункции

#Область ДваВидаСбоя

// Сбой на руках объектом: цепочка причин видна целиком, и отказ базы узнаётся по ней.
Функция СбойОбъектом(Знач Запрос, Знач Инфо)

	Причина = Причины.ПоСбою(Инфо);
	Записать(Запрос, Причина, Ошибки.Причина(Инфо));
	Лог.Отладка("Сбой запроса %1 целиком:%2%3", КодЗапроса(Запрос), Символы.ПС,
		Ошибки.ПодробныйОтчёт(Инфо));

	Возврат ОтветСоСбоем(Запрос, Неопределено, Причина);

КонецФункции

// Сбой на руках строкой: исключение winow уже проглотил, и от него остался текст в модели.
Функция СбойСтрокой(Знач Запрос, Знач Собранный)

	Текст = Строка(Собранный.Модель.ТекстСообщения);
	Причина = Причины.ПоТексту(Текст);
	Записать(Запрос, Причина, Ошибки.Кратко(Текст));

	Возврат ОтветСоСбоем(Запрос, Собранный, Причина);

КонецФункции

#КонецОбласти

#Область ОтказСобранныйWinow

// Отказ, собранный самим winow: код и его же модель стандартного шаблона — 500 на пойманном
// исключении, 404 на адресе без маршрута. Отказ, который собрал контроллер хаба, эта примета
// не задевает — до него обработчик дотянулся, и своё тело у него уже есть.
Функция ЭтоОтказСобранныйWinow(Знач Ответ, Знач Код)

	Если Ответ = Неопределено ИЛИ ЧислоСостояния(Ответ) <> Код Тогда
		Возврат Ложь;
	КонецЕсли;

	Модель = Ответ.Модель;
	Если ТипЗнч(Модель) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Модель.Свойство("ТекстСообщения") И Модель.Свойство("КодСостояния")
		И Модель.Свойство("Запрос");

КонецФункции

// Состояние ответа бывает и пустой строкой: у ответа, которому его ещё не ставили.
Функция ЧислоСостояния(Знач Ответ)

	Попытка
		Возврат Число(Ответ.СостояниеКод);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СборкаОтвета

Функция ОтветСоСбоем(Знач Запрос, Знач Собранный, Знач Причина)

	Ответ = ?(Собранный = Неопределено, Фабрика.ПустойОтвет(), Собранный);
	Ответ.ИдентификаторЗапроса = КодЗапроса(Запрос);
	Ответ.УстановитьСостояние(Причина.Статус);
	Ответ.Заголовки["Cache-Control"] = "no-store";
	Если Причина.ПовторитьЧерез > 0 Тогда
		Ответ.Заголовки["Retry-After"] = Формат(Причина.ПовторитьЧерез, "ЧГ=0; ЧН=0");
	КонецЕсли;

	Если Дверь.Машинная(Запрос) Тогда
		Ответы.Ошибка(Ответ, Причина.Статус, Причина.Код, Фраза(Причина.Код));
	Иначе
		ОтдатьСтраницу(Ответ, Запрос, Причина);
	КонецЕсли;

	Возврат Ответ;

КонецФункции

// Страница собирается слоем представления. Не собралась — наружу уходит та же фраза
// голым текстом: пустое тело не сообщает посетителю ничего.
Процедура ОтдатьСтраницу(Ответ, Знач Запрос, Знач Причина)

	Разметка = "";
	Попытка
		Разметка = Слова().Страница(Причина.Код, Причина.Статус, КодЗапроса(Запрос),
			Запрос.Куки);
	Исключение
		Лог.Ошибка("Страница сбоя не собралась, ответ уходит текстом: %1", ОписаниеОшибки());
	КонецПопытки;

	Если ЗначениеЗаполнено(Разметка) Тогда
		Ответ.Заголовки["Content-Type"] = "text/html; charset=utf-8";
		Ответ.ТелоТекст = Разметка;
		Возврат;
	КонецЕсли;

	Ответ.Заголовки["Content-Type"] = "text/plain; charset=utf-8";
	Ответ.ТелоТекст = Фраза(Причина.Код) + " " + КодЗапроса(Запрос);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Одна строка ОШИБКА на сбой: по коду запроса оператор находит её, не переспрашивая.
Процедура Записать(Знач Запрос, Знач Причина, Знач Пояснение)

	Лог.Ошибка("Сбой запроса %1: %2 %3 — %4; причина: %5", КодЗапроса(Запрос),
		Строка(Запрос.Метод), Строка(Запрос.Путь), Причина.Код, Пояснение);

КонецПроцедуры

// Фраза приходит из слоя представления. Не пришла — наружу уходит машинный код: он хуже
// читается, но врать посетителю своей формулировкой шов входа не вправе.
Функция Фраза(Знач Код)

	Попытка
		Возврат Слова().Фраза(Код);
	Исключение
		Лог.Ошибка("Слова о сбое недоступны, наружу уходит машинный код: %1", ОписаниеОшибки());
		Возврат Код;
	КонецПопытки;

КонецФункции

// Желудь слов ищется на первом сбое, а не при сборке напильника: иначе граф представления
// поднимался бы до старта веб-сервера.
Функция Слова()

	Если СловаОСбое = Неопределено Тогда
		СловаОСбое = Поделка.НайтиЖелудь("СбойХабаСловами");
	КонецЕсли;

	Возврат СловаОСбое;

КонецФункции

// Код запроса называется здесь один раз на оба исхода: им подписаны строка журнала и ответ.
Функция КодЗапроса(Знач Запрос)
	Возврат СокрЛП(Строка(Запрос.Идентификатор));
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач ОбёрнутыйОбработчик, Знач ПричиныСбоя, Знач ОтветыМашиннойДвери,
	Знач ФабрикаОтветов, Знач ЖелудиХаба, Знач _Лог) Экспорт

	// Обёртку собирает напильник оператором «Новый»: желудём она не бывает, поэтому лог
	// приходит от создателя наравне с остальными сотрудниками. Без лога сбой остался бы
	// немым — ровно того, ради чего обёртка заведена, и не случилось бы.
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "ОбработчикСоСбоемСловами создан без лога — напильник или тест обязан его передать";
	КонецЕсли;

	Обработчик = ОбёрнутыйОбработчик;
	Причины = ПричиныСбоя;
	Ответы = ОтветыМашиннойДвери;
	Фабрика = ФабрикаОтветов;
	Поделка = ЖелудиХаба;
	Лог = _Лог;
	Ошибки = Новый ТекстОшибки();
	Дверь = Новый ДверьЗапроса();
	Неизвестный = Новый ОтветНеизвестномуАдресу(Ответы, Дверь, Поделка, Лог);

КонецПроцедуры
