// Цепочка адресов из заголовка `X-Forwarded-For`: каждый прокси дописывает СПРАВА того,
// от кого получил запрос. Других заголовков пересылки хаб не читает: у `Forwarded`
// (RFC 7239) своя цепочка, и прокси, заполнивший только его, оставил бы клиентский
// `X-Forwarded-For` нетронутым — выбор адреса достался бы самому клиенту.

Перем Канон;  // КанонIP (основа) — скобки и порт снимает он

#Область ПубличныйИнтерфейс

// Цепочка адресов запроса в порядке заголовка: слева тот, кто начал, справа — последний прокси.
//
// Параметры:
//  Заголовки - Соответствие - заголовки запроса.
//
// Возвращаемое значение:
//  Массив из Строка - записи адресов; пустой массив — заголовка пересылки нет.
//
Функция Цепочка(Знач Заголовки) Экспорт
	Возврат Записи(ЗначениеЗаголовка(Заголовки, "X-Forwarded-For"));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Соответствие заголовков различает регистр, а пишут их как придётся. Берётся первое
// совпадение: склеить одноимённые заголовки в один — забота веб-сервера, и Kestrel
// её выполняет, отдавая значения через запятую одной строкой.
Функция ЗначениеЗаголовка(Знач Заголовки, Знач Имя)

	Если ТипЗнч(Заголовки) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого КиЗ Из Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = ВРег(Имя) Тогда
			Возврат СокрЛП(Строка(КиЗ.Значение));
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция Записи(Знач Заголовок)

	Результат = Новый Массив();
	Для Каждого Часть Из СтрРазделить(Заголовок, ",", Ложь) Цикл
		Запись = Канон.БезСкобокИПорта(Часть);
		Если ЗначениеЗаполнено(Запись) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "КанонIP") _Канон) Экспорт
	Канон = _Канон;
КонецПроцедуры
