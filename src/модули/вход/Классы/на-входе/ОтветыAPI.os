// Помощник HTTP-ответов auth-контроллеров: единый JSON-формат ошибок
// {error:{code,message}} и разбор тела из json / x-www-form-urlencoded.
// Content-Length ставится вручную — native-режим winow сам его не ставит.

// Отправляет JSON-ответ, выставляя Content-Type и Content-Length.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//  Код - Число - HTTP-статус.
//  Данные - Структура, Соответствие - тело ответа.
//
Процедура JSON(Ответ, Знач Код, Знач Данные) Экспорт

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Тело = Запись.Закрыть();

	Ответ.УстановитьСостояние(Код);
	Ответ.Заголовки["Content-Type"] = "application/json; charset=utf-8";
	Ответ.Заголовки["Content-Length"] = Формат(ПолучитьДвоичныеДанныеИзСтроки(Тело).Размер(), "ЧГ=0; ЧН=0");
	Ответ.ТелоТекст = Тело;

КонецПроцедуры

// Отправляет ошибку в едином формате {error:{code,message}}.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//  Код - Число - HTTP-статус.
//  КодОшибки - Строка - машиночитаемый код ошибки.
//  Сообщение - Строка - человекочитаемое сообщение.
//
Процедура Ошибка(Ответ, Знач Код, Знач КодОшибки, Знач Сообщение) Экспорт

	Ошибка = Новый Структура();
	Ошибка.Вставить("code", КодОшибки);
	Ошибка.Вставить("message", Сообщение);
	Обёртка = Новый Структура();
	Обёртка.Вставить("error", Ошибка);
	JSON(Ответ, Код, Обёртка);

КонецПроцедуры

// Разбирает тело запроса в Соответствие полей (JSON-объект либо form-urlencoded).
//
// Параметры:
//  ТелоЗапроса - Строка - сырое тело запроса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса (Content-Type).
//
// Возвращаемое значение:
//  Соответствие - поля тела; пустое, если тело пустое или JSON некорректен.
//
Функция РазобратьТело(Знач ТелоЗапроса, Знач ЗаголовкиЗапроса) Экспорт

	Результат = Новый Соответствие();
	Если НЕ ЗначениеЗаполнено(ТелоЗапроса) Тогда
		Возврат Результат;
	КонецЕсли;

	ТипКонтента = НРег(Строка(ЗаголовокЗапроса(ЗаголовкиЗапроса, "Content-Type")));

	Если СтрНайти(ТипКонтента, "application/json") > 0 Тогда
		Попытка
			Чтение = Новый ЧтениеJSON();
			Чтение.УстановитьСтроку(ТелоЗапроса);
			Разобрано = ПрочитатьJSON(Чтение, Истина);
			Чтение.Закрыть();
			Если ТипЗнч(Разобрано) = Тип("Соответствие") Тогда
				Возврат Разобрано;
			КонецЕсли;
		Исключение
			Возврат Результат;
		КонецПопытки;
		Возврат Результат;
	КонецЕсли;

	// x-www-form-urlencoded (и как fallback)
	Для Каждого Пара Из СтрРазделить(ТелоЗапроса, "&", Ложь) Цикл
		ЧастиПары = СтрРазделить(Пара, "=", Истина);
		Если ЧастиПары.Количество() >= 1 И ЗначениеЗаполнено(ЧастиПары[0]) Тогда
			Ключ = РаскодироватьСтроку(ЧастиПары[0], СпособКодированияСтроки.КодировкаURL);
			Значение = ?(ЧастиПары.Количество() >= 2,
				РаскодироватьСтроку(ЧастиПары[1], СпособКодированияСтроки.КодировкаURL), "");
			Результат.Вставить(Ключ, Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строковое значение поля тела.
//
// Параметры:
//  Тело - Соответствие - разобранное тело запроса.
//  Имя - Строка - имя поля.
//  ПоУмолчанию - Строка - значение при отсутствии поля (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Строка.
//
Функция Поле(Знач Тело, Знач Имя, Знач ПоУмолчанию = "") Экспорт
	Значение = Тело.Получить(Имя);
	Возврат ?(Значение = Неопределено, ПоУмолчанию, Строка(Значение));
КонецФункции

// Снимает сессионную куку winow с ответа: без Set-Cookie ответ остаётся кэшируемым.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//  ПустыеКуки - Куки - заранее подготовленная пустая коллекция кук.
//
Процедура БезСессионнойКуки(Ответ, Знач ПустыеКуки) Экспорт
	Ответ.Куки = ПустыеКуки;
КонецПроцедуры

// --- служебные ---

Функция ЗаголовокЗапроса(Знач ЗаголовкиЗапроса, Знач Имя)
	Если ЗаголовкиЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИскомыйКлюч = ВРег(Имя);
	Для Каждого КиЗ Из ЗаголовкиЗапроса Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = ИскомыйКлюч Тогда
			Возврат КиЗ.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
