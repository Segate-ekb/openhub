// Тема и текст письма подтверждения адреса. Письмо простым текстом: разметки в нём нет,
// а строки приходят из словаря — это то же пользовательское слово, что и на экране.

Перем Тексты;    // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Политика;  // ПолитикаПодтвержденияEmail (auth) — срок жизни ссылки
Перем Адрес;     // АдресИнстанса (основа) — чем хаб называет себя в письме

// Тема письма.
//
// Возвращаемое значение:
//  Строка.
//
Функция Тема() Экспорт
	Возврат Тексты.Текст("mail.confirm.subject");
КонецФункции

// Текст письма: чья учётка, какой хаб, ссылка и её срок.
//
// Параметры:
//  Логин - Строка - логин учётной записи.
//  Ссылка - Строка - готовая ссылка подтверждения.
//
// Возвращаемое значение:
//  Строка.
//
Функция Текст(Знач Логин, Знач Ссылка) Экспорт

	Возврат Тексты.Шаблон("mail.confirm.body",
		Строка(Логин), Адрес.Базовый(), Строка(Ссылка),
		Тексты.ЧислоТекстом(Политика.СрокЖизниЧасов()));

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПолитикаПодтвержденияEmail") _Политика,
	&Пластилин(Значение = "АдресИнстанса") _Адрес)

	Тексты = _Тексты;
	Политика = _Политика;
	Адрес = _Адрес;

КонецПроцедуры
