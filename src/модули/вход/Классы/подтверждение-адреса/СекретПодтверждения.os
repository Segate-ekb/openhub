// Значение ссылки подтверждения адреса: выпуск секрета, сборка и разбор
// oshub_cnf_{id}_{secret} и хеш для базы.

#Использовать pwhash

Перем Сверка;  // СверкаСекретов (auth)

// Новый секрет ссылки — 24 крипто-стойких байта в hex.
//
// Возвращаемое значение:
//  Строка.
//
Функция Выпустить() Экспорт
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешированиеПаролей.СгенерироватьСоль(24)));
КонецФункции

// Собирает значение ссылки из идентификатора заявки и секрета.
//
// Параметры:
//  Идентификатор - Число - идентификатор заявки.
//  Секрет - Строка - секрет ссылки.
//
// Возвращаемое значение:
//  Строка.
//
Функция Собрать(Знач Идентификатор, Знач Секрет) Экспорт
	Возврат СтрШаблон("oshub_cnf_%1_%2", Идентификатор, Секрет);
КонецФункции

// Разбирает значение ссылки.
//
// Параметры:
//  Токен - Строка - сырое значение.
//
// Возвращаемое значение:
//  Структура, Неопределено - Идентификатор (Число), Секрет (Строка); Неопределено при
//                            любом отклонении от формата.
//
Функция Разобрать(Знач Токен) Экспорт

	Части = СтрРазделить(СокрЛП(Строка(Токен)), "_", Ложь);
	Если Части.Количество() <> 4 ИЛИ Части[0] <> "oshub" ИЛИ Части[1] <> "cnf" Тогда
		Возврат Неопределено;
	КонецЕсли;

	// разбор строгий: «1e300» и прочее, что Число() съедает, ушло бы в хранилище и
	// вернулось оттуда не отказом 404, а пятисоткой драйвера
	Если НЕ ЭтоНомер(Части[2]) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Идентификатор = Число(Части[2]);

	Если ПустаяСтрока(Части[3]) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Идентификатор, Секрет", Идентификатор, Части[3]);

КонецФункции

// Хеш секрета для хранения: сырого значения ссылки в базе не бывает.
//
// Параметры:
//  Значение - Строка - секрет ссылки.
//
// Возвращаемое значение:
//  Строка - sha256 в hex, нижним регистром.
//
Функция Хеш(Знач Значение) Экспорт

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Значение));
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

// Сравнивает hex-хеши по общему правилу хаба.
//
// Параметры:
//  Первое - Строка - первый хеш.
//  Второе - Строка - второй хеш.
//
// Возвращаемое значение:
//  Булево.
//
Функция Совпадают(Знач Первое, Знач Второе) Экспорт
	Возврат Сверка.Совпадают(Первое, Второе);
КонецФункции

// Только цифры и разумная длина: идентификатор заявки — это счётчик, а не выражение.
Функция ЭтоНомер(Знач Значение)

	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ СтрДлина(Значение) > 18 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для НомерСимвола = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, НомерСимвола, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СверкаСекретов") _Сверка)

	Сверка = _Сверка;

КонецПроцедуры
