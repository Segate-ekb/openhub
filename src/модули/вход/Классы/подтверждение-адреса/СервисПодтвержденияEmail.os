// Жизненный цикл ссылки подтверждения адреса: выпуск с письмом, проверка, погашение
// и чистка просроченных. Значение уходит только в письмо, в базе лежит sha256-хеш секрета.

Перем Хранилище;           // ХранилищеЗаявокПодтверждения (вход)
Перем СервисПользователей; // СервисПользователей (вход)
Перем Адреса;              // АдресУчётки (вход) — отметка подтверждения
Перем Политика;            // ПолитикаПодтвержденияEmail (вход)
Перем АдресСсылки;         // АдресПодтверждения (вход)
Перем Письмо;              // ПисьмоПодтверждения (вход)
Перем Канал;               // СлужбаЛичныхУведомлений (уведомления) — личный канал хаба
Перем Секрет;              // СекретПодтверждения (вход) — формат и хеш значения ссылки
Перем Коды;                // КодыПодтверждения (вход) — коды отказов цикла и почты
Перем Заявки;              // ЗаявкиПодтверждения (вход) — погашение живых и уборка
Перем Летопись;            // ЛетописьУчёток (вход)
Перем ПоискУчётки;         // УчёткаПоНазванному (вход) — логин либо адрес из формы
Перем Вердикты;            // Вердикт (основа) — форма ответа
Перем Ошибки;              // ТекстОшибки (основа) — причина и слова сорвавшегося выпуска
&Лог
Перем Лог;

#Область ЖизненныйЦиклСсылки

// Выпускает ссылку подтверждения и шлёт её письмом на адрес самой учётной записи.
// Прежние живые ссылки гасятся: годной в каждый момент не больше одной.
//
// Параметры:
//  Пользователь - Пользователь - чей адрес подтверждается.
//  Момент - Дата - момент выпуска, UTC (необязательный, по умолчанию текущий).
//  АдресIP - Строка - адрес клиента для журнала (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка — код отказа, "" при успехе),
//              Заявка (ЗаявкаПодтвержденияEmail, Неопределено).
//
Функция Запросить(Знач Пользователь, Знач Момент = Неопределено, Знач АдресIP = "") Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Источник = СокрЛП(Строка(АдресIP));

	Отказ = ПочемуНельзяВыслать(Пользователь);
	Если ЗначениеЗаполнено(Отказ) Тогда
		Возврат Исход(Ложь, Отказ, Неопределено);
	КонецЕсли;

	Заявки.ПогаситьЖивые(Цел(Пользователь.Идентификатор));

	Значение = Секрет.Выпустить();

	Заявка = Хранилище.СоздатьЭлемент();
	Заявка.ПользовательИдентификатор = Цел(Пользователь.Идентификатор);
	Заявка.ХешТокена = "";
	Заявка.Адрес = НРег(СокрЛП(Строка(Пользователь.Email)));
	Заявка.АдресIP = Источник;
	Заявка.Погашена = Ложь;
	Заявка.Создана = Сейчас;
	Заявка.Истекает = Сейчас + Политика.СрокЖизниСекунд();
	Заявка.Сохранить(); // первое сохранение даёт идентификатор для значения ссылки

	Заявка.ХешТокена = Секрет.Хеш(Значение);
	Заявка.Сохранить();

	Итог = Канал.ПисьмоСоСсылкой(Пользователь, Канал.Поводы().ПодтверждениеАдреса(),
		Письмо.Тема(),
		Письмо.Текст(Строка(Пользователь.Логин),
			АдресСсылки.Ссылка(Секрет.Собрать(Заявка.Идентификатор, Значение))));

	ЗаписатьПисьмо(Пользователь, Итог, Источник);

	Возврат Исход(Итог.Успех, Итог.Причина, Заявка);

КонецФункции

// Как Запросить, но исключение выпуска не бросает: сбой уходит в журнал, а ответ называет
// его кодом «выпуск сорвался» и словами для человека.
//
// Параметры:
//  Пользователь - Пользователь - чей адрес подтверждается.
//  Момент - Дата - момент выпуска, UTC (необязательный, по умолчанию текущий).
//  АдресIP - Строка - адрес клиента для журнала (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка — код отказа, "" при успехе),
//              Заявка (ЗаявкаПодтвержденияEmail, Неопределено),
//              Сообщение (Строка — слова сорвавшегося выпуска, "" когда выпуск не срывался).
//
Функция ЗапроситьНеРоняя(Знач Пользователь, Знач Момент = Неопределено, Знач АдресIP = "") Экспорт

	// логин снимается ДО Попытки: обработчик отказа обходится тем, что уже на руках
	Логин = ?(Пользователь = Неопределено, "", Строка(Пользователь.Логин));

	Попытка
		Итог = Запросить(Пользователь, Момент, АдресIP);
	Исключение
		Возврат ОтказСорвавшегосяВыпуска(Логин, ИнформацияОбОшибке());
	КонецПопытки;

	Поля = Новый Структура("Заявка, Сообщение", Итог.Заявка, "");
	Возврат ?(Итог.Успех, Вердикты.Успех(Поля), Вердикты.Отказ(Итог.Причина, Поля));

КонецФункции

// Проверяет сырое значение ссылки. Выключенное настройкой подтверждение проверке не
// мешает: политика гасит выпуск новых ссылок, а посланная остаётся доказательством.
//
// Параметры:
//  Токен - Строка - значение вида oshub_cnf_{id}_{secret}.
//  Момент - Дата - момент проверки, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка — код отказа, "" при успехе),
//              Заявка (ЗаявкаПодтвержденияEmail, Неопределено),
//              Пользователь (Пользователь, Неопределено).
//
Функция Проверить(Знач Токен, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);

	Разобранный = Секрет.Разобрать(Токен);
	Если Разобранный = Неопределено Тогда
		Возврат ГодностьЗаявки(Ложь, Коды.НетСсылки(), Неопределено, Неопределено);
	КонецЕсли;

	Заявка = Хранилище.ПолучитьОдноПоИдентификаторРавно(Разобранный.Идентификатор);
	Если Заявка = Неопределено Тогда
		Возврат ГодностьЗаявки(Ложь, Коды.НетСсылки(), Неопределено, Неопределено);
	КонецЕсли;

	// чужой секрет неотличим от несуществующей ссылки: перебор не выдаёт живые идентификаторы
	Если НЕ Секрет.Совпадают(Секрет.Хеш(Разобранный.Секрет), Строка(Заявка.ХешТокена)) Тогда
		Возврат ГодностьЗаявки(Ложь, Коды.НетСсылки(), Неопределено, Неопределено);
	КонецЕсли;

	Если Заявка.Погашена = Истина Тогда
		Возврат ГодностьЗаявки(Ложь, Коды.Погашена(), Заявка, Неопределено);
	КонецЕсли;
	// граница включительная: в секунду истечения ссылка уже мертва
	Если Заявка.Истекает <= Сейчас Тогда
		Возврат ГодностьЗаявки(Ложь, Коды.Просрочена(), Заявка, Неопределено);
	КонецЕсли;

	Пользователь = СервисПользователей.ПоИдентификатору(Заявка.ПользовательИдентификатор);
	Если Пользователь = Неопределено Тогда
		Возврат ГодностьЗаявки(Ложь, Коды.НетУчётки(), Заявка, Неопределено);
	КонецЕсли;

	// ссылка подтверждает только тот адрес, на который её послали
	Если НРег(СокрЛП(Строка(Заявка.Адрес))) <> НРег(СокрЛП(Строка(Пользователь.Email))) Тогда
		Возврат ГодностьЗаявки(Ложь, Коды.АдресСменился(), Заявка, Неопределено);
	КонецЕсли;

	Возврат ГодностьЗаявки(Истина, "", Заявка, Пользователь);

КонецФункции

// Подтверждает адрес по ссылке и гасит её; повторный переход отказывает кодом
// «уже воспользовались».
//
// Параметры:
//  Токен - Строка - сырое значение ссылки.
//  Момент - Дата - момент погашения, UTC (необязательный, по умолчанию текущий).
//  АдресIP - Строка - адрес клиента для журнала (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка — код отказа, "" при успехе),
//              Пользователь (Пользователь, Неопределено).
//
Функция Подтвердить(Знач Токен, Знач Момент = Неопределено, Знач АдресIP = "") Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);

	Проверка = Проверить(Токен, Сейчас);
	Если НЕ Проверка.Успех Тогда
		Возврат Результат(Ложь, Проверка.Причина, Неопределено);
	КонецЕсли;

	Пользователь = Проверка.Пользователь;
	// сначала отметка (собственная — ссылку выпустил хаб), потом погашение
	Адреса.Подтвердить(Пользователь, Истина);
	Заявки.ПогаситьЖивые(Цел(Пользователь.Идентификатор));

	Летопись.СобытиеПодтверждения(Летопись.ДействиеАдресПодтверждён(),
		Строка(Пользователь.Логин), Новый Структура("адрес", Строка(Пользователь.Email)),
		АдресIP);

	Возврат Результат(Истина, "", Пользователь);

КонецФункции

// Удаляет отработавшие заявки подтверждения.
//
// Параметры:
//  Момент - Дата - граница срока, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Число - сколько заявок удалено.
//
Функция УдалитьПросроченные(Знач Момент = Неопределено) Экспорт
	Возврат Заявки.УдалитьОтработавшие(
		?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент));
КонецФункции

// Высылает ссылку подтверждения учётке, названной логином или адресом, на её собственный
// адрес. Отвечает одинаково, нашлась учётка или нет.
//
// Параметры:
//  Названное - Строка - логин либо адрес почты.
//  Момент - Дата - момент выпуска, UTC (необязательный, по умолчанию текущий).
//  АдресIP - Строка - адрес клиента для журнала (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Успех (Булево — форму приняли; про судьбу письма не говорит ничего),
//              Причина (Строка — код отказа состояния хаба, "" если хаб готов слать).
//
Функция ЗапроситьПоНазванному(Знач Названное, Знач Момент = Неопределено,
	Знач АдресIP = "") Экспорт

	// состояние хаба назвать можно и нужно: это не про конкретную учётку
	Если НЕ Политика.Включено() Тогда
		Возврат Вердикты.Отказ(Коды.Выключено());
	КонецЕсли;
	Если НЕ Канал.ПочтаНастроена() Тогда
		Возврат Вердикты.Отказ(Коды.ПочтаНеНастроена());
	КонецЕсли;

	Пользователь = ПоискУчётки.ПоЛогинуИлиАдресу(Названное);
	Если Пользователь <> Неопределено Тогда
		// исход письма наружу не едет: по нему читалось бы, есть ли такая учётка
		ЗапроситьНеРоняя(Пользователь, Момент, АдресIP);
	КонецЕсли;

	// успех и ненайденной учётке: иначе перебором вычислялись бы существующие
	Возврат Вердикты.Успех();

КонецФункции

// Есть ли у учётной записи годная прямо сейчас ссылка подтверждения.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - учётная запись.
//  Момент - Дата - момент проверки, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьЖиваяСсылка(Знач Пользователь, Знач Момент = Неопределено) Экспорт

	Если Пользователь = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Заявки.ЕстьЖивая(Цел(Пользователь.Идентификатор),
		?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент));

КонецФункции

// Обещано ли подтверждение адреса, которое хаб не в состоянии выполнить: цикл включён
// настройкой, а слать письма нечем.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПодтверждениеНедостижимо() Экспорт
	Возврат Политика.Включено() И НЕ Канал.ПочтаНастроена();
КонецФункции

// Почему письмо подтверждения учётной записи прямо сейчас не выпустить; тот же порядок
// причин судит и сам выпуск.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - учётная запись.
//
// Возвращаемое значение:
//  Строка - код отказа из КодыПодтверждения либо "" — письмо выпустить можно.
//
Функция ПочемуНельзяВыслать(Знач Пользователь) Экспорт

	Если НЕ Политика.Включено() Тогда
		Возврат Коды.Выключено();
	КонецЕсли;
	Если Пользователь = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Пользователь.Email) Тогда
		Возврат Коды.НетАдреса();
	КонецЕсли;
	Если Пользователь.EmailПодтверждён = Истина Тогда
		Возврат Коды.УжеПодтверждён();
	КонецЕсли;
	Если НЕ Канал.ПочтаНастроена() Тогда
		Возврат Коды.ПочтаНеНастроена();
	КонецЕсли;
	Если НЕ АдресСсылки.АдресХабаЗадан() Тогда
		Возврат Коды.НетАдресаХаба();
	КонецЕсли;

	Возврат "";

КонецФункции

// Коды отказов цикла и почтового слоя одним объектом.
//
// Возвращаемое значение:
//  КодыПодтверждения.
//
Функция Причины() Экспорт
	Возврат Коды;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Код отказа и слова сбоя едут разными полями, подробность пишется в журнал.
Функция ОтказСорвавшегосяВыпуска(Знач Логин, Знач Сбой)

	Лог.Ошибка("Подтверждение адреса учётки ""%1"": выпуск ссылки сорвался исключением: %2",
		Логин, Ошибки.Причина(Сбой));
	// отчёт стои́т разбора цепочки: собираем его только тогда, когда отладку включили
	Если Лог.Уровень() <= УровниЛога.Отладка Тогда
		Лог.Отладка("Подтверждение адреса учётки ""%1"": разбор сбоя целиком:%2%3",
			Логин, Символы.ПС, Ошибки.ПодробныйОтчёт(Сбой));
	КонецЕсли;

	Поля = Новый Структура("Заявка, Сообщение", Неопределено, Ошибки.ДляЧеловека(Сбой));
	Возврат Вердикты.Отказ(Коды.Сорвалось(), Поля);

КонецФункции

// В журнал уходит факт письма и его исход; самой ссылки в нём нет и быть не может.
Процедура ЗаписатьПисьмо(Знач Пользователь, Знач Итог, Знач АдресIP)

	Детали = Новый Структура("адрес, отправлено, причина",
		Строка(Пользователь.Email), Итог.Успех, Итог.Причина);

	Летопись.СобытиеПодтверждения(Летопись.ДействиеПисьмоПодтверждения(),
		Строка(Пользователь.Логин), Детали, АдресIP);

КонецПроцедуры

Функция ГодностьЗаявки(Знач Годна, Знач Причина, Знач Заявка, Знач Пользователь)

	Поля = Новый Структура("Заявка, Пользователь", Заявка, Пользователь);
	Возврат ?(Годна, Вердикты.Успех(Поля), Вердикты.Отказ(Причина, Поля));

КонецФункции

Функция Исход(Знач Отправлено, Знач Причина, Знач Заявка)

	Поля = Новый Структура("Заявка", Заявка);
	Возврат ?(Отправлено, Вердикты.Успех(Поля), Вердикты.Отказ(Причина, Поля));

КонецФункции

Функция Результат(Знач Удалось, Знач Причина, Знач Пользователь)
	Поля = Новый Структура("Пользователь", Пользователь);
	Возврат ?(Удалось, Вердикты.Успех(Поля), Вердикты.Отказ(Причина, Поля));
КонецФункции

#КонецОбласти

&Желудь
&Наблюдаемый
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеЗаявокПодтверждения") _Хранилище,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "АдресУчётки") _Адреса,
	&Пластилин(Значение = "ПолитикаПодтвержденияEmail") _Политика,
	&Пластилин(Значение = "АдресПодтверждения") _АдресСсылки,
	&Пластилин(Значение = "ПисьмоПодтверждения") _Письмо,
	&Пластилин(Значение = "СлужбаЛичныхУведомлений") _Канал,
	&Пластилин(Значение = "СекретПодтверждения") _Секрет,
	&Пластилин(Значение = "КодыПодтверждения") _Коды,
	&Пластилин(Значение = "ЗаявкиПодтверждения") _Заявки,
	&Пластилин(Значение = "ЛетописьУчёток") _Летопись,
	&Пластилин(Значение = "УчёткаПоНазванному") _ПоискУчётки,
	&Пластилин(Значение = "Вердикт") _Вердикты = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Лог _Лог = Неопределено)

	Вердикты = ?(_Вердикты = Неопределено, Новый Вердикт(), _Вердикты);
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	// Лог параметром — для создания через `Новый` вне контейнера, где `&Лог` не внедряется
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Хранилище = _Хранилище;
	СервисПользователей = _СервисПользователей;
	Адреса = _Адреса;
	Политика = _Политика;
	АдресСсылки = _АдресСсылки;
	Письмо = _Письмо;
	Канал = _Канал;
	Секрет = _Секрет;
	Коды = _Коды;
	Заявки = _Заявки;
	Летопись = _Летопись;
	ПоискУчётки = _ПоискУчётки;

КонецПроцедуры
