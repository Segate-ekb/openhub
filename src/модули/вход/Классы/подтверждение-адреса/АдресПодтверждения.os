// Адрес публичной страницы подтверждения адреса и сборка ссылки из её значения — один
// литерал маршрута на весь хаб.

Перем Адрес;  // АдресИнстанса (основа)

// Путь публичной страницы подтверждения адреса.
//
// Возвращаемое значение:
//  Строка.
//
Функция Путь() Экспорт
	Возврат "/confirm-email";
КонецФункции

// Имя параметра адреса со значением ссылки.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПараметра() Экспорт
	Возврат "token";
КонецФункции

// Ссылка целиком: с внешним адресом инсталляции, если он задан, иначе относительным
// путём. В письме относительный путь бесполезен, поэтому письмо шлётся только тогда,
// когда внешний адрес задан.
//
// Параметры:
//  Значение - Строка - сырое значение ссылки.
//
// Возвращаемое значение:
//  Строка.
//
Функция Ссылка(Знач Значение) Экспорт

	Возврат Адрес.Базовый() + Путь() + "?" + ИмяПараметра() + "="
		+ КодироватьСтроку(СокрЛП(Строка(Значение)), СпособКодированияСтроки.КодировкаURL);

КонецФункции

// Задан ли внешний адрес инсталляции: без него ссылка в письме никуда не ведёт.
//
// Возвращаемое значение:
//  Булево.
//
Функция АдресХабаЗадан() Экспорт
	Возврат Адрес.Задан();
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "АдресИнстанса") _Адрес)

	Адрес = _Адрес;

КонецПроцедуры
