// Операции над набором заявок подтверждения адреса: погашение живых и уборка отработавших.
// Жизненный цикл отдельной ссылки — в СервисПодтвержденияEmail.

Перем Хранилище; // ХранилищеЗаявокПодтверждения (данные)

// Гасит все живые заявки учётки: годной у неё в каждый момент не больше одной.
//
// Параметры:
//  ПользовательИдентификатор - Число - учётная запись.
//
Процедура ПогаситьЖивые(Знач ПользовательИдентификатор) Экспорт

	Для Каждого Заявка Из Все(ПользовательИдентификатор) Цикл
		Если Заявка.Погашена = Истина Тогда
			Продолжить;
		КонецЕсли;
		Заявка.Погашена = Истина;
		Заявка.Сохранить();
	КонецЦикла;

КонецПроцедуры

// Есть ли у учётной записи ссылка, по которой прямо сейчас можно подтвердить адрес.
// По ней и надо идти: новое письмо гасит прежнюю ссылку, и человек, открывший старое,
// упёрся бы в «уже воспользовались».
//
// Параметры:
//  ПользовательИдентификатор - Число - учётная запись.
//  Момент - Дата - относительно какого мгновения считается срок, UTC.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьЖивая(Знач ПользовательИдентификатор, Знач Момент) Экспорт

	Для Каждого Заявка Из Все(ПользовательИдентификатор) Цикл
		Если Заявка.Погашена = Истина Тогда
			Продолжить;
		КонецЕсли;
		// граница включительная — та же, что у проверки ссылки: в секунду истечения мертва
		Если Заявка.Истекает <= Момент Тогда
			Продолжить;
		КонецЕсли;
		Возврат Истина;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Удаляет истёкшие заявки: для перехода они больше не нужны, а считать по ним нечего.
//
// Параметры:
//  Момент - Дата - граница срока, UTC.
//
// Возвращаемое значение:
//  Число - сколько заявок удалено.
//
Функция УдалитьОтработавшие(Знач Момент) Экспорт

	Удалено = 0;
	Для Каждого Заявка Из Хранилище.ИстёкшиеДо(Момент) Цикл
		Хранилище.Удалить(Заявка);
		Удалено = Удалено + 1;
	КонецЦикла;

	Возврат Удалено;

КонецФункции

Функция Все(Знач ПользовательИдентификатор)
	Возврат Хранилище.ПолучитьПоПользовательИдентификаторРавно(ПользовательИдентификатор);
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеЗаявокПодтверждения") _Хранилище)

	Хранилище = _Хранилище;

КонецПроцедуры
