// Коды отказов цикла подтверждения адреса — одно место на домен и на экран. Коды
// почтового слоя отдаются отсюда же, чтобы экран не знал, что за доменом стоит почта.

Перем Почта; // СлужбаПочты (почта)

#Область ЦиклПодтверждения

// Подтверждение адреса письмом выключено настройкой хаба.
//
// Возвращаемое значение:
//  Строка.
//
Функция Выключено() Экспорт
	Возврат "confirm_disabled";
КонецФункции

// У учётной записи нет адреса.
//
// Возвращаемое значение:
//  Строка.
//
Функция НетАдреса() Экспорт
	Возврат "confirm_no_email";
КонецФункции

// Адрес учётной записи уже подтверждён.
//
// Возвращаемое значение:
//  Строка.
//
Функция УжеПодтверждён() Экспорт
	Возврат "confirm_already";
КонецФункции

// Внешний адрес инсталляции не задан: ссылка в письме вела бы в никуда.
//
// Возвращаемое значение:
//  Строка.
//
Функция НетАдресаХаба() Экспорт
	Возврат "confirm_no_instance_url";
КонецФункции

// Такой ссылки нет (в том числе мусор и чужой секрет).
//
// Возвращаемое значение:
//  Строка.
//
Функция НетСсылки() Экспорт
	Возврат "confirm_unknown";
КонецФункции

// Срок ссылки вышел.
//
// Возвращаемое значение:
//  Строка.
//
Функция Просрочена() Экспорт
	Возврат "confirm_expired";
КонецФункции

// Ссылкой уже воспользовались либо её погасил выпуск следующей.
//
// Возвращаемое значение:
//  Строка.
//
Функция Погашена() Экспорт
	Возврат "confirm_used";
КонецФункции

// Учётной записи этой ссылки больше нет.
//
// Возвращаемое значение:
//  Строка.
//
Функция НетУчётки() Экспорт
	Возврат "confirm_no_user";
КонецФункции

// Адрес учётки сменился после выпуска ссылки.
//
// Возвращаемое значение:
//  Строка.
//
Функция АдресСменился() Экспорт
	Возврат "confirm_email_changed";
КонецФункции

#КонецОбласти

#Область ПочтовыйСлой

// Отправка почты на хабе не настроена.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПочтаНеНастроена() Экспорт
	Возврат Почта.ПричинаНеНастроена();
КонецФункции

// Сервер письмо не принял.
//
// Возвращаемое значение:
//  Строка.
//
Функция Отправка() Экспорт
	Возврат Почта.ПричинаОтказ();
КонецФункции

// Адрес получателя не годится для отправки.
//
// Возвращаемое значение:
//  Строка.
//
Функция АдресНеГоден() Экспорт
	Возврат Почта.ПричинаАдрес();
КонецФункции

// Отказ ли это почтового слоя — экран показывает такие одним текстом про почту.
//
// Параметры:
//  Причина - Строка - код отказа.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоОтказПочты(Знач Причина) Экспорт
	Возврат Причина = ПочтаНеНастроена() ИЛИ Причина = Отправка()
		ИЛИ Причина = АдресНеГоден();
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СлужбаПочты") _Почта)

	Почта = _Почта;

КонецПроцедуры
