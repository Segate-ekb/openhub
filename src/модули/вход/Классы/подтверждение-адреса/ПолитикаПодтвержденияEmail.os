// Настройки цикла подтверждения адреса: включён ли он и сколько живёт ссылка. Значения
// читаются в месте использования, поэтому правка действует без перезапуска хаба.

Перем Настройки; // СервисНастроек (настройки)

// Ключ настройки «подтверждать адрес письмом».
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючВключено() Экспорт
	Возврат "oshub.auth.email.confirm.enabled";
КонецФункции

// Ключ настройки «срок жизни ссылки подтверждения, часов».
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючСрок() Экспорт
	Возврат "oshub.auth.email.confirm.ttl.hours";
КонецФункции

// Включено ли подтверждение адреса письмом. Гасит только ВЫПУСК ссылок: уже посланная
// ссылка подтверждает адрес и после выключения — доказательство владения не отменяется
// сменой политики.
//
// Возвращаемое значение:
//  Булево.
//
Функция Включено() Экспорт
	Возврат Настройки.Значение(КлючВключено()) = Истина;
КонецФункции

// Срок жизни ссылки в часах.
//
// Возвращаемое значение:
//  Число.
//
Функция СрокЖизниЧасов() Экспорт
	Возврат Цел(Настройки.Значение(КлючСрок()));
КонецФункции

// Срок жизни ссылки в секундах.
//
// Возвращаемое значение:
//  Число.
//
Функция СрокЖизниСекунд() Экспорт
	Возврат СрокЖизниЧасов() * 3600;
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки)

	Настройки = _Настройки;

КонецПроцедуры
