// Доменные операции над учётными записями: создание, поиск, пароль (pwhash с прозрачным
// перехешированием) и роль на уровне хаба. Всё, что касается адреса почты, — в АдресУчётки.

#Использовать pwhash
Перем Хранилище;         // ХранилищеПользователей (вход)
Перем Нормализатор;      // НормализаторУчётки (вход)
Перем Адреса;            // АдресУчётки (вход) — занятость и подтверждение адреса
Перем ПолитикаПароля;    // ПолитикаПароля (вход)
Перем ПространствоИмён;  // ПространствоИмён (реестр) — одно пространство имён пулов и логинов
Перем СервисПулов;       // СервисПулов (реестр)
Перем СервисПрав;        // СервисПрав (права)
Перем СервисПравДоступа; // СервисПравДоступа (права)
Перем Вердикты;          // Вердикт (основа) — форма ответа
Перем Летопись;          // ЛетописьУчёток (вход) — события безопасности в журнал аудита
Перем Отказы;            // ОтказыУчётки (вход) — код и текст причины «логин занят»
&Лог
Перем Лог;

// Создаёт пользователя и его личный пул. Занятый логин, чужое имя пула и неизвестная
// роль — исключение; с пустым паролем учётка входит только через провайдера.
//
// Параметры:
//  Логин - Строка - логин пользователя.
//  Email - Строка - адрес, может быть пустым (необязательный, по умолчанию "").
//  Пароль - Строка - сырой пароль либо "" (необязательный, по умолчанию "").
//  РольХаба - Строка - admin | user (необязательный, по умолчанию "user").
//  ТребуетсяСменаПароля - Булево - потребовать смену при первом входе
//                         (необязательный, по умолчанию Ложь).
//  Активен - Булево - открыт ли вход сразу; Ложь — учётка ждёт ссылки установки пароля
//            (необязательный, по умолчанию Истина).
//
// Возвращаемое значение:
//  Пользователь - созданная запись.
//
&Наблюдаемый
Функция СоздатьПользователя(Знач Логин, Знач Email = "", Знач Пароль = "",
	Знач РольХаба = "user", Знач ТребуетсяСменаПароля = Ложь, Знач Активен = Истина) Экспорт

	НормЛогин = Нормализатор.НормализоватьЛогин(Логин);
	Нормализатор.ПроверитьЛогин(НормЛогин);
	// логин и имя пула делят одно пространство; учётки заводит не только контроллер
	ПроверитьСвободуЛогина(НормЛогин);
	НормEmail = Нормализатор.НормализоватьEmail(Email);

	ПроверитьРольХаба(РольХаба);

	Если Хранилище.НайтиПоЛогину(НормЛогин) <> Неопределено Тогда
		ВызватьИсключение Отказы.Ошибка(Отказы.ЛогинЗанят(), ЗанятыйЛогин(НормЛогин));
	КонецЕсли;
	Адреса.ПроверитьСвободу(НормEmail, 0);

	ХешПароля = "";
	Если ЗначениеЗаполнено(Пароль) Тогда
		ПолитикаПароля.Проверить(Пароль);
		ХешПароля = ХешированиеПаролей.Захешировать(Нормализатор.НормализоватьПароль(Пароль));
	КонецЕсли;

	Пользователь = Хранилище.СоздатьЭлемент();
	Пользователь.Логин = НормЛогин;
	Пользователь.Email = НормEmail;
	Пользователь.EmailПодтверждён = Ложь;
	Пользователь.ПодтверждёнХабом = Ложь;
	Пользователь.ХешПароля = ХешПароля;
	Пользователь.Активен = (Активен = Истина);
	Пользователь.РольХаба = РольХаба;
	Пользователь.ТребуетсяСменаПароля = ТребуетсяСменаПароля;
	Пользователь.Создан = ТекущаяУниверсальнаяДата();
	Пользователь.Сохранить();

	// итог обеспечения регистрации не важен: сбой уже записан в лог и учётку не отменяет
	ИтогПространства = ОбеспечитьЛичныйПул(Пользователь);

	Лог.Отладка("Учётка ""%1"" заведена: #%2, роль хаба ""%3"", активна: %4, пароль задан: %5,"
		+ " личное пространство — %6",
		НормЛогин, Пользователь.Идентификатор, РольХаба, Пользователь.Активен,
		ЗначениеЗаполнено(ХешПароля), ИтогПространства);

	Возврат Пользователь;

КонецФункции

// Заводит личное пространство пользователя (пул типа user с именем-логином) и роль
// мейнтейнера на нём. Идемпотентна; сбой не роняет вызывающего, причина пишется в лог.
//
// Параметры:
//  Пользователь - Пользователь - хозяин пространства.
//
// Возвращаемое значение:
//  Строка - ИтогСоздан (пространство заведено), ИтогБыло (уже было), ИтогПропущен
//           (личные пространства выключены либо учётка отключена), ИтогИмяЗанято
//           (имя логина носит чужой пул — пространства нет и не будет), ИтогОшибка.
//
&Наблюдаемый
Функция ОбеспечитьЛичныйПул(Знач Пользователь) Экспорт

	Попытка

		Если НЕ СервисПулов.ЛичныеПулыРазрешены() ИЛИ НЕ Пользователь.Активен = Истина Тогда
			Возврат ИтогПропущен();
		КонецЕсли;

		Личный = СервисПулов.НайтиПул(Пользователь.Логин);
		Заведён = Личный = Неопределено;
		Если Заведён Тогда
			Личный = СервисПулов.СоздатьЛичныйПул(Пользователь.Логин, Пользователь.Идентификатор);
		КонецЕсли;

		// имя логина может носить чужой пул — это не «пространство уже есть»
		Если НЕ Личный.ЭтоЛичный()
			ИЛИ Цел(Личный.ВладелецИдентификатор) <> Цел(Пользователь.Идентификатор) Тогда
			Лог.Ошибка("Личное пространство ""%1"" не заведено: имя носит пул типа ""%2""."
				+ " Освободите имя либо верните пулу тип ""%3"".",
				Пользователь.Логин, Личный.Тип, СервисПулов.ТипЛичный());
			Возврат ИтогИмяЗанято();
		КонецЕсли;

		// Роль выдаётся и уже существующему личному пулу; фиксация идемпотентна.
		СервисПравДоступа.ЗафиксироватьГрант("пользователь", Пользователь.Идентификатор,
			СервисПрав.ОбъектПул(Личный),
			СервисПрав.НаборРоли(СервисПрав.РольМейнтейнер()), 0, "");

		Возврат ?(Заведён, ИтогСоздан(), ИтогБыло());

	Исключение
		Лог.Ошибка("Личный пул пользователя ""%1"" не создан: %2. Заведите пул вручную.",
			Пользователь.Логин, ОписаниеОшибки());
		Возврат ИтогОшибка();
	КонецПопытки;

КонецФункции

// Итог обеспечения: пространство заведено этим вызовом.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИтогСоздан() Экспорт
	Возврат "создан";
КонецФункции

// Итог обеспечения: пространство уже существовало.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИтогБыло() Экспорт
	Возврат "был";
КонецФункции

// Итог обеспечения: имя логина носит чужой пул — пространства у учётки нет.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИтогИмяЗанято() Экспорт
	Возврат "занято";
КонецФункции

// Итог обеспечения: пространство не полагается (выключено настройкой либо учётка отключена).
//
// Возвращаемое значение:
//  Строка.
//
Функция ИтогПропущен() Экспорт
	Возврат "пропущен";
КонецФункции

// Итог обеспечения: попытка сорвалась, причина в логе.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИтогОшибка() Экспорт
	Возврат "ошибка";
КонецФункции

// Пользователь по логину (нормализация внутри).
//
// Параметры:
//  Логин - Строка - логин в любом регистре.
//
// Возвращаемое значение:
//  Пользователь, Неопределено.
//
&Наблюдаемый
Функция НайтиПоЛогину(Знач Логин) Экспорт
	Возврат Хранилище.НайтиПоЛогину(Нормализатор.НормализоватьЛогин(Логин));
КонецФункции

// Пользователь по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пользователя.
//
// Возвращаемое значение:
//  Пользователь, Неопределено.
//
&Наблюдаемый
Функция ПоИдентификатору(Знач Идентификатор) Экспорт
	Возврат Хранилище.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Учётки перечисленных идентификаторов одним разрезом — списку строк, которому нужны
// имена сразу всех участников.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пользователей.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (идентификатор), значение Пользователь; ненайденных в нём нет.
//
&Наблюдаемый
Функция ПоИдентификаторам(Знач Идентификаторы) Экспорт
	Возврат Хранилище.ПоИдентификаторам(Идентификаторы);
КонецФункции

// Число пользователей хаба (0 означает первый запуск).
//
// Возвращаемое значение:
//  Число.
//
&Наблюдаемый
Функция ВсегоПользователей() Экспорт
	Возврат Хранилище.Количество();
КонецФункции

// Все учётные записи хаба. Порядок не гарантируется.
//
// Возвращаемое значение:
//  Массив из Пользователь.
//
&Наблюдаемый
Функция ВсеПользователи() Экспорт
	Возврат Хранилище.Все();
КонецФункции

// Заведена ли в хабе хоть одна учётка (Ложь означает первый запуск). Отдельный вопрос
// от ВсегоПользователей: онбординг спрашивают на каждой странице, а число — нет.
//
// Возвращаемое значение:
//  Булево.
//
&Наблюдаемый
Функция ЕстьХотяБыОднаУчётка() Экспорт
	Возврат Хранилище.УчёткаЕсть() = Истина;
КонецФункции

// Задан ли у учётной записи пароль. Учётка, заведённая входом через провайдера,
// живёт без пароля: подтверждать при первой его установке нечего.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - учётная запись.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПарольЗадан(Знач Пользователь) Экспорт
	Возврат Пользователь <> Неопределено И ЗначениеЗаполнено(Пользователь.ХешПароля);
КонецФункции

// Устанавливает новый пароль пользователю и снимает требование смены.
// Пароль вне политики — исключение.
//
// Параметры:
//  Пользователь - Пользователь - изменяемая учётная запись.
//  НовыйПароль - Строка - сырой пароль.
//
&Наблюдаемый
Процедура УстановитьПароль(Знач Пользователь, Знач НовыйПароль) Экспорт

	ПолитикаПароля.Проверить(НовыйПароль);
	Пользователь.ХешПароля = ХешированиеПаролей.Захешировать(Нормализатор.НормализоватьПароль(НовыйПароль));
	Пользователь.ТребуетсяСменаПароля = Ложь;
	Пользователь.Сохранить();

КонецПроцедуры

// Роль хаба «администратор»: полные права на все объекты инсталляции.
//
// Возвращаемое значение:
//  Строка.
//
Функция РольАдмин() Экспорт
	Возврат "admin";
КонецФункции

// Роль хаба «обычный пользователь».
//
// Возвращаемое значение:
//  Строка.
//
Функция РольПользователь() Экспорт
	Возврат "user";
КонецФункции

// Код отказа «роль хаба меняет только администратор».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНеАдмин() Экспорт
	Возврат "role_change_not_admin";
КонецФункции

// Код отказа «учётной записи не существует».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНетУчётки() Экспорт
	Возврат "role_change_no_user";
КонецФункции

// Код отказа «менять роль себе нельзя».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаСебе() Экспорт
	Возврат "role_change_self";
КонецФункции

// Код отказа «роли с таким именем на хабе нет».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНеизвестнаяРоль() Экспорт
	Возврат "role_change_unknown_role";
КонецФункции

// Разрешена ли смена роли хаба: только администратору и только над чужой учёткой —
// так хаб не остаётся без администратора.
//
// Параметры:
//  Инициатор - Пользователь, Неопределено - кто меняет роль.
//  Цель - Пользователь, Неопределено - чья роль меняется.
//  НоваяРоль - Строка - admin | user.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка — код отказа, "" при успехе).
//
&Наблюдаемый
Функция ПроверитьСменуРоли(Знач Инициатор, Знач Цель, Знач НоваяРоль) Экспорт

	Если НЕ СервисПрав.ПользовательАдмин(Инициатор) Тогда
		Возврат Вердикты.Отказ(ПричинаНеАдмин());
	КонецЕсли;
	Если Цель = Неопределено Тогда
		Возврат Вердикты.Отказ(ПричинаНетУчётки());
	КонецЕсли;
	Если Цел(Цель.Идентификатор) = Цел(Инициатор.Идентификатор) Тогда
		Возврат Вердикты.Отказ(ПричинаСебе());
	КонецЕсли;
	Если НЕ РольДопустима(НоваяРоль) Тогда
		Возврат Вердикты.Отказ(ПричинаНеизвестнаяРоль());
	КонецЕсли;

	Возврат Вердикты.Успех();

КонецФункции

// Назначает учётной записи роль на уровне хаба. Порог судит ПроверитьСменуРоли,
// отказ — исключение.
//
// Параметры:
//  Инициатор - Пользователь, Неопределено - кто меняет роль.
//  Цель - Пользователь, Неопределено - чья роль меняется.
//  НоваяРоль - Строка - admin | user.
//  АдресIP - Строка - адрес клиента для журнала (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Булево - Истина, если роль изменилась; Ложь, если она уже была такой.
//
&Наблюдаемый
Функция НазначитьРольХаба(Знач Инициатор, Знач Цель, Знач НоваяРоль, Знач АдресIP = "") Экспорт

	Итог = ПроверитьСменуРоли(Инициатор, Цель, НоваяРоль);
	Если НЕ Итог.Успех Тогда
		Лог.Отладка("Роль хаба: смена на ""%1"" отклонена, причина %2", НоваяРоль, Итог.Причина);
		ВызватьИсключение СтрШаблон("%1: смена роли хаба запрещена — форму подделать можно,"
			+ " эту точку нельзя", Итог.Причина);
	КонецЕсли;

	Прежняя = НРег(СокрЛП(Строка(Цель.РольХаба)));
	Лог.Отладка("Роль хаба пользователя #%1: ""%2"" → ""%3""",
		Цель.Идентификатор, Прежняя, НоваяРоль);
	Если Прежняя = НоваяРоль Тогда
		Возврат Ложь;
	КонецЕсли;

	Цель.РольХаба = НоваяРоль;
	Цель.Сохранить();

	Летопись.СменаРоли(Инициатор, Цель, Прежняя, НоваяРоль, АдресIP);
	Возврат Истина;

КонецФункции

// Проверяет пароль пользователя; при устаревших параметрах хеша прозрачно перехеширует
// и сохраняет. Пароль сверх максимума политики отвергается до хеширования (anti-DoS).
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - учётная запись.
//  Пароль - Строка - сырой пароль.
//
// Возвращаемое значение:
//  Булево - Ложь, если пароля у учётки нет (чисто-OIDC) либо он неверен.
//
&Наблюдаемый
Функция ПроверитьПароль(Знач Пользователь, Знач Пароль) Экспорт

	Если НЕ ПарольЗадан(Пользователь) Тогда
		Возврат Ложь;
	КонецЕсли;

	// anti-DoS: гигантский ввод не должен нагружать KDF на пути входа
	Если ПолитикаПароля.ПревышаетМаксимум(Пароль) Тогда
		Возврат Ложь;
	КонецЕсли;

	НормПароль = Нормализатор.НормализоватьПароль(Пароль);
	Если НЕ ХешированиеПаролей.Проверить(НормПароль, Пользователь.ХешПароля) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ХешированиеПаролей.ТребуетПерехеширования(Пользователь.ХешПароля) Тогда
		Пользователь.ХешПароля = ХешированиеПаролей.Захешировать(НормПароль);
		Пользователь.Сохранить();
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция РольДопустима(Знач Роль)
	Возврат Роль = РольАдмин() ИЛИ Роль = РольПользователь();
КонецФункции

Процедура ПроверитьРольХаба(Знач Роль)
	Если НЕ РольДопустима(Роль) Тогда
		ВызватьИсключение СтрШаблон("Некорректная роль хаба ""%1"": ожидается admin или user", Роль);
	КонецЕсли;
КонецПроцедуры

// Сначала предикат, а не пойманное исключение: сбой хранилища пулов — не «логин занят».
Процедура ПроверитьСвободуЛогина(Знач НормЛогин)

	Если НЕ ПространствоИмён.ЗанятоПулом(НормЛогин) Тогда
		Возврат;
	КонецЕсли;

	// причина отказа рождается тем же правилом реестра: в журнале видно, чем занято имя
	Попытка
		ПространствоИмён.ПроверитьСвободноДляЛогина(НормЛогин);
	Исключение
		ВызватьИсключение Отказы.ОшибкаНад(Отказы.ЛогинЗанят(), ИнформацияОбОшибке(),
			ЗанятыйЛогин(НормЛогин));
	КонецПопытки;

КонецПроцедуры

// В подробностях отказа — только то имя, которое прислал сам обратившийся.
Функция ЗанятыйЛогин(Знач НормЛогин)
	Возврат Новый Структура("login", НормЛогин);
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПользователей") _Хранилище,
	&Пластилин(Значение = "НормализаторУчётки") _Нормализатор,
	&Пластилин(Значение = "АдресУчётки") _Адреса,
	&Пластилин(Значение = "ПолитикаПароля") _ПолитикаПароля,
	&Пластилин(Значение = "ПространствоИмён") _ПространствоИмён,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисПравДоступа") _СервисПравДоступа,
	&Пластилин(Значение = "ЛетописьУчёток") _Летопись,
	&Пластилин(Значение = "ОтказыУчётки") _Отказы,
	&Лог _Лог = Неопределено)

	Хранилище = _Хранилище;
	Нормализатор = _Нормализатор;
	Адреса = _Адреса;
	ПолитикаПароля = _ПолитикаПароля;
	ПространствоИмён = _ПространствоИмён;
	СервисПулов = _СервисПулов;
	СервисПрав = _СервисПрав;
	СервисПравДоступа = _СервисПравДоступа;
	Летопись = _Летопись;
	Отказы = _Отказы;
	// Лог параметром — для создания через `Новый` вне контейнера, где `&Лог` не внедряется
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

	Вердикты = Новый Вердикт();

КонецПроцедуры
