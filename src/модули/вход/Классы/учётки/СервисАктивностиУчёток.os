// Единственная точка СМЕНЫ признака активности у существующей учётки (рождение учётки —
// отдельный вход, СервисПользователей.СоздатьПользователя) и порог этой операции.
// Инвариант домена: активной не бывает учётка, в которую нечем войти, — ни действующего
// пароля, ни привязанной внешней личности. Проверка стоит здесь, а не в контроллере:
// форму подделать можно, эту точку нельзя.

Перем ХранилищеЛичностей;  // ХранилищеВнешнихЛичностей (данные)
Перем СервисПрав;          // СервисПрав (auth)
Перем ПарольныйВход;       // ПолитикаПарольногоВхода (auth)
Перем Погашение;           // ПогашениеПриглашений (auth) — закрытая учётка не ждёт ссылок

#Область ПубличныйИнтерфейс

// Есть ли у учётки способ войти: действующий пароль либо привязанная внешняя личность.
// Проверяется именно это, а не наличие хеша: чисто-OIDC учётка пароля не имеет by design,
// и запрет по пустому хешу навсегда запер бы её после блокировки. Пароль считается
// способом входа, только пока парольный вход включён на хабе: выключенный делает его
// мёртвым, и «активная» учётка с одним лишь паролем никого не пускает.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - учётная запись.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьСпособВхода(Знач Пользователь) Экспорт

	Если Пользователь = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(Пользователь.ХешПароля) И ПарольныйВход.Включён() Тогда
		Возврат Истина;
	КонецЕсли;

	Личности = ХранилищеЛичностей.ПолучитьПоПользовательИдентификаторРавно(
		Цел(Пользователь.Идентификатор));
	Возврат Личности <> Неопределено И Личности.Количество() > 0;

КонецФункции

// Разрешена ли смена активности. Менять вправе только администратор и только чужую
// учётку: закрыть вход себе — мгновенный само-локаут. Открыть вход учётке без способа
// войти нельзя вовсе, кем бы ни был инициатор.
//
// Параметры:
//  Инициатор - Пользователь, Неопределено - кто меняет.
//  Цель - Пользователь, Неопределено - чья активность меняется.
//  Активность - Булево - Истина открывает вход, Ложь закрывает.
//
// Возвращаемое значение:
//  Структура - Можно (Булево), Причина (Строка — код отказа, "" при Можно).
//
Функция ПроверитьСменуАктивности(Знач Инициатор, Знач Цель, Знач Активность) Экспорт

	Если НЕ СервисПрав.ПользовательАдмин(Инициатор) Тогда
		Возврат Вердикт(Ложь, ПричинаНеАдмин());
	КонецЕсли;
	Если Цель = Неопределено Тогда
		Возврат Вердикт(Ложь, ПричинаНетУчётки());
	КонецЕсли;
	Если Цел(Цель.Идентификатор) = Цел(Инициатор.Идентификатор) Тогда
		Возврат Вердикт(Ложь, ПричинаСебе());
	КонецЕсли;
	Если Активность = Истина И НЕ ЕстьСпособВхода(Цель) Тогда
		Возврат Вердикт(Ложь, ПричинаНетСпособаВхода());
	КонецЕсли;

	Возврат Вердикт(Истина, "");

КонецФункции

// Открывает либо закрывает вход в учётную запись. Порог операции судит
// ПроверитьСменуАктивности, отказ — исключение: значение, записанное в обход этой точки,
// возвращает вход заблокированному и открывает учётку, войти в которую нечем.
//
// Параметры:
//  Инициатор - Пользователь, Неопределено - кто меняет.
//  Цель - Пользователь, Неопределено - чья активность меняется.
//  Активность - Булево - Истина открывает вход, Ложь закрывает.
//
// Возвращаемое значение:
//  Булево - Истина, если признак изменился; Ложь, если он уже был таким.
//
Функция УстановитьАктивность(Знач Инициатор, Знач Цель, Знач Активность) Экспорт

	Итог = ПроверитьСменуАктивности(Инициатор, Цель, Активность);
	Если НЕ Итог.Можно Тогда
		ВызватьИсключение СтрШаблон("%1: смена активности учётки запрещена — форму подделать"
			+ " можно, эту точку нельзя", Итог.Причина);
	КонецЕсли;

	Возврат Записать(Цель, Активность = Истина);

КонецФункции

// Открывает вход учётной записи без инициатора — системный путь установки пароля
// по одноразовой ссылке. Прав не спрашивает (их спросили при выпуске ссылки),
// но инвариант «нет способа входа — нет активности» соблюдает.
//
// Параметры:
//  Пользователь - Пользователь - активируемая учётная запись.
//
// Возвращаемое значение:
//  Булево - Истина, если учётка была неактивной и стала активной.
//
Функция Активировать(Знач Пользователь) Экспорт
	Возврат Записать(Пользователь, Истина);
КонецФункции

// Код отказа «активность учёток меняет только администратор».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНеАдмин() Экспорт
	Возврат "activity_not_admin";
КонецФункции

// Код отказа «учётной записи не существует».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНетУчётки() Экспорт
	Возврат "activity_no_user";
КонецФункции

// Код отказа «менять активность себе нельзя».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаСебе() Экспорт
	Возврат "activity_self";
КонецФункции

// Код отказа «в учётку нечем войти: ни пароля, ни привязанной личности».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНетСпособаВхода() Экспорт
	Возврат "activity_no_login_method";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Инвариант живёт здесь, а не у вызывающих: это единственное место, где признак
// активности попадает в базу.
Функция Записать(Знач Пользователь, Знач Активность)

	Если Пользователь = Неопределено Тогда
		ВызватьИсключение СтрШаблон("%1: активность несуществующей учётки не меняется",
			ПричинаНетУчётки());
	КонецЕсли;
	// учётка с мёртвым паролем и учётка без пароля вовсе выглядят одинаково, а лечатся
	// по-разному: первой нужен включённый парольный вход, второй — ссылка установки пароля
	Если Активность И НЕ ЕстьСпособВхода(Пользователь) Тогда
		ВызватьИсключение СтрШаблон("%1: учётка ""%2"" не активируется — %3",
			ПричинаНетСпособаВхода(), Строка(Пользователь.Логин),
			?(ЗначениеЗаполнено(Пользователь.ХешПароля) И ПарольныйВход.Выключен(),
				"пароль у неё есть, но вход по логину и паролю на хабе выключен,"
					+ " а внешней личности к ней не привязано",
				"ни пароля, ни привязанной внешней личности у неё нет"));
	КонецЕсли;

	// Закрытая учётка не ждёт ссылок: живая ссылка установки пароля вернула бы ей вход
	// в обход блокировки — «заблокировать» отменялось бы само собой. Гасим ДО проверки
	// «признак уже такой»: инвариант держится и на повторном закрытии, иначе ссылка
	// переживала бы блокировку уже закрытой учётки. Осознанный выпуск новой ссылки после
	// блокировки остаётся рабочим: это явное действие администратора.
	Если НЕ Активность Тогда
		Погашение.ПогаситьЖивые(Цел(Пользователь.Идентификатор));
	КонецЕсли;

	Если (Пользователь.Активен = Истина) = Активность Тогда
		Возврат Ложь;
	КонецЕсли;

	Пользователь.Активен = Активность;
	Пользователь.Сохранить();
	Возврат Истина;

КонецФункции

Функция Вердикт(Знач Можно, Знач Причина)
	Возврат Новый Структура("Можно, Причина", Можно, Причина);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеВнешнихЛичностей") _ХранилищеЛичностей,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _ПарольныйВход,
	&Пластилин(Значение = "ПогашениеПриглашений") _Погашение)

	ХранилищеЛичностей = _ХранилищеЛичностей;
	СервисПрав = _СервисПрав;
	ПарольныйВход = _ПарольныйВход;
	Погашение = _Погашение;

КонецПроцедуры
