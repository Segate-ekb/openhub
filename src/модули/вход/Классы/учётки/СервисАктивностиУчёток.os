// Единственная точка смены признака активности у существующей учётки и порог этой операции.
// Инвариант домена: активной не бывает учётка, в которую нечем войти.

Перем ХранилищеЛичностей;  // ХранилищеВнешнихЛичностей (вход)
Перем СервисПрав;          // СервисПрав (права)
Перем ПарольныйВход;       // ПолитикаПарольногоВхода (вход)
Перем Погашение;           // ПогашениеПриглашений (вход) — закрытая учётка не ждёт ссылок
Перем Вердикты;            // Вердикт (основа) — форма ответа

#Область ПубличныйИнтерфейс

// Есть ли у учётки способ войти: пароль, пока парольный вход включён на хабе, либо
// привязанная внешняя личность.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - учётная запись.
//
// Возвращаемое значение:
//  Булево.
//
&Наблюдаемый
Функция ЕстьСпособВхода(Знач Пользователь) Экспорт

	Если Пользователь = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПарольныйВход.ПарольДействует(Пользователь) Тогда
		Возврат Истина;
	КонецЕсли;

	Личности = ХранилищеЛичностей.ПолучитьПоПользовательИдентификаторРавно(
		Цел(Пользователь.Идентификатор));
	Возврат Личности <> Неопределено И Личности.Количество() > 0;

КонецФункции

// ЕстьСпособВхода сразу для списка учёток: привязанные личности читаются одним запросом.
//
// Параметры:
//  Пользователи - Массив из Пользователь - учётные записи.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (идентификатор учётки), значение Булево.
//
&Наблюдаемый
Функция СпособыВхода(Знач Пользователи) Экспорт

	// настройка спрашивается один раз на список: она одна на хаб, а не на учётку
	ВходВключён = ПарольныйВход.Включён();

	Идентификаторы = Новый Массив();
	Для Каждого Пользователь Из Пользователи Цикл
		Идентификаторы.Добавить(Цел(Пользователь.Идентификатор));
	КонецЦикла;

	СЛичностью = Новый Соответствие();
	Если Идентификаторы.Количество() > 0 Тогда
		Личности = ХранилищеЛичностей.ЛичностиПользователей(Идентификаторы);
		Для Каждого Личность Из Личности Цикл
			СЛичностью.Вставить(Цел(Личность.ПользовательИдентификатор), Истина);
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Соответствие();
	Для Каждого Пользователь Из Пользователи Цикл
		Ключ = Цел(Пользователь.Идентификатор);
		Результат.Вставить(Ключ,
			ПарольныйВход.ПарольДействует(Пользователь, ВходВключён)
				ИЛИ СЛичностью.Получить(Ключ) = Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Разрешена ли смена активности: только администратору и только над чужой учёткой;
// открыть вход учётке без способа войти нельзя никому.
//
// Параметры:
//  Инициатор - Пользователь, Неопределено - кто меняет.
//  Цель - Пользователь, Неопределено - чья активность меняется.
//  Активность - Булево - Истина открывает вход, Ложь закрывает.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка — код отказа, "" при успехе).
//
&Наблюдаемый
Функция ПроверитьСменуАктивности(Знач Инициатор, Знач Цель, Знач Активность) Экспорт

	Если НЕ СервисПрав.ПользовательАдмин(Инициатор) Тогда
		Возврат Вердикты.Отказ(ПричинаНеАдмин());
	КонецЕсли;
	Если Цель = Неопределено Тогда
		Возврат Вердикты.Отказ(ПричинаНетУчётки());
	КонецЕсли;
	Если Цел(Цель.Идентификатор) = Цел(Инициатор.Идентификатор) Тогда
		Возврат Вердикты.Отказ(ПричинаСебе());
	КонецЕсли;
	Если Активность = Истина И НЕ ЕстьСпособВхода(Цель) Тогда
		Возврат Вердикты.Отказ(ПричинаНетСпособаВхода());
	КонецЕсли;

	Возврат Вердикты.Успех();

КонецФункции

// Открывает либо закрывает вход в учётную запись. Порог судит ПроверитьСменуАктивности,
// отказ — исключение.
//
// Параметры:
//  Инициатор - Пользователь, Неопределено - кто меняет.
//  Цель - Пользователь, Неопределено - чья активность меняется.
//  Активность - Булево - Истина открывает вход, Ложь закрывает.
//
// Возвращаемое значение:
//  Булево - Истина, если признак изменился; Ложь, если он уже был таким.
//
&Наблюдаемый
Функция УстановитьАктивность(Знач Инициатор, Знач Цель, Знач Активность) Экспорт

	Итог = ПроверитьСменуАктивности(Инициатор, Цель, Активность);
	Если НЕ Итог.Успех Тогда
		ВызватьИсключение СтрШаблон("%1: смена активности учётки запрещена — форму подделать"
			+ " можно, эту точку нельзя", Итог.Причина);
	КонецЕсли;

	Возврат Записать(Цель, Активность = Истина);

КонецФункции

// Открывает вход учётной записи без инициатора — при установке пароля по одноразовой
// ссылке. Прав не спрашивает, инвариант «нет способа входа — нет активности» соблюдает.
//
// Параметры:
//  Пользователь - Пользователь - активируемая учётная запись.
//
// Возвращаемое значение:
//  Булево - Истина, если учётка была неактивной и стала активной.
//
&Наблюдаемый
Функция Активировать(Знач Пользователь) Экспорт
	Возврат Записать(Пользователь, Истина);
КонецФункции

// Код отказа «активность учёток меняет только администратор».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНеАдмин() Экспорт
	Возврат "activity_not_admin";
КонецФункции

// Код отказа «учётной записи не существует».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНетУчётки() Экспорт
	Возврат "activity_no_user";
КонецФункции

// Код отказа «менять активность себе нельзя».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаСебе() Экспорт
	Возврат "activity_self";
КонецФункции

// Код отказа «в учётку нечем войти: ни пароля, ни привязанной личности».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНетСпособаВхода() Экспорт
	Возврат "activity_no_login_method";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Единственное место, где признак активности попадает в базу, поэтому инвариант живёт здесь.
Функция Записать(Знач Пользователь, Знач Активность)

	Если Пользователь = Неопределено Тогда
		ВызватьИсключение СтрШаблон("%1: активность несуществующей учётки не меняется",
			ПричинаНетУчётки());
	КонецЕсли;
	// мёртвый пароль и отсутствие пароля лечатся по-разному — текст называет, что именно
	Если Активность И НЕ ЕстьСпособВхода(Пользователь) Тогда
		ВызватьИсключение СтрШаблон("%1: учётка ""%2"" не активируется — %3",
			ПричинаНетСпособаВхода(), Строка(Пользователь.Логин),
			?(ЗначениеЗаполнено(Пользователь.ХешПароля) И ПарольныйВход.Выключен(),
				"пароль у неё есть, но вход по логину и паролю на хабе выключен,"
					+ " а внешней личности к ней не привязано",
				"ни пароля, ни привязанной внешней личности у неё нет"));
	КонецЕсли;

	// живые ссылки гаснут до проверки «признак уже такой»: блокировку не переживает ни одна
	Если НЕ Активность Тогда
		Погашение.ПогаситьЖивые(Цел(Пользователь.Идентификатор));
	КонецЕсли;

	Если (Пользователь.Активен = Истина) = Активность Тогда
		Возврат Ложь;
	КонецЕсли;

	Пользователь.Активен = Активность;
	Пользователь.Сохранить();
	Возврат Истина;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеВнешнихЛичностей") _ХранилищеЛичностей,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _ПарольныйВход,
	&Пластилин(Значение = "ПогашениеПриглашений") _Погашение)

	ХранилищеЛичностей = _ХранилищеЛичностей;
	СервисПрав = _СервисПрав;
	ПарольныйВход = _ПарольныйВход;
	Погашение = _Погашение;

	Вердикты = Новый Вердикт();

КонецПроцедуры
