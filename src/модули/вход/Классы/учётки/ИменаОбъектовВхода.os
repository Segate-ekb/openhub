// Логины учёток для журнала аудита - реализация контракта ИменаОбъектовАудита.

Перем ХранилищеПользователей;  // ХранилищеПользователей (вход)

// Типы объектов, которые называет вход.
//
// Возвращаемое значение:
//  Массив из Строка - пользователь.
//
Функция НазываемыеТипы() Экспорт

	Результат = Новый Массив();
	Результат.Добавить("пользователь");
	Возврат Результат;

КонецФункции

// Логин учётки.
//
// Параметры:
//  ТипОбъекта - Строка - пользователь.
//  Идентификатор - Число - идентификатор учётки.
//
// Возвращаемое значение:
//  Структура, Неопределено - Имя (Строка) - логин, Пул (Строка) - пусто; Неопределено -
//   учётки нет.
//
Функция ИменаОбъекта(Знач ТипОбъекта, Знач Идентификатор) Экспорт

	Учетка = ХранилищеПользователей.ПолучитьОдноПоИдентификаторРавно(Цел(Идентификатор));
	Если Учетка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Имя, Пул", Учетка.Логин, "");

КонецФункции

&Прозвище("ИменаОбъектовАудита")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ХранилищеПользователей") _ХранилищеПользователей)
	ХранилищеПользователей = _ХранилищеПользователей;
КонецПроцедуры
