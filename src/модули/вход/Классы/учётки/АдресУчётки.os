// Адрес почты учётной записи: занятость, смена, подтверждение и доказательство владения.
// Уникальность адреса держит этот слой, а не база.

Перем Хранилище;    // ХранилищеПользователей (данные)
Перем Нормализатор; // НормализаторУчётки (auth)
Перем Отказы;       // ОтказыУчётки (auth) — код и текст причины «адрес занят»

#Область Занятость

// Код отказа «адрес почты уже принадлежит другой учётной записи».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаЗанят() Экспорт
	Возврат Отказы.Код(Отказы.АдресЗанят());
КонецФункции

// Занят ли адрес другой учётной записью. Сравнение идёт по нормализованному адресу:
// регистр и краевые пробелы занятости не обходят. Пустой адрес занятым не считается —
// учёток без почты бывает сколько угодно.
//
// Параметры:
//  Email - Строка - проверяемый адрес в любом виде.
//  ИсключаяИдентификатор - Число - чью занятость не считать (своя учётка при смене
//                          адреса); 0 — не исключать никого (необязательный,
//                          по умолчанию 0).
//
// Возвращаемое значение:
//  Булево.
//
Функция Занят(Знач Email, Знач ИсключаяИдентификатор = 0) Экспорт

	Попытка
		НормEmail = Нормализатор.НормализоватьEmail(Email);
	Исключение
		Возврат Ложь; // негодный адрес отвергнет нормализация записи, а не эта проверка
	КонецПопытки;

	Возврат ЗанятДругим(НормEmail, ИсключаяИдентификатор);

КонецФункции

// Отвергает занятый адрес исключением. Отказ называет занятость, но никогда — чужой
// логин: иначе форма смены адреса стала бы разведкой того, кто на хабе зарегистрирован.
//
// Параметры:
//  НормEmail - Строка - уже нормализованный адрес.
//  ИсключаяИдентификатор - Число - чью занятость не считать; 0 — не исключать никого.
//
Процедура ПроверитьСвободу(Знач НормEmail, Знач ИсключаяИдентификатор) Экспорт

	Если НЕ ЗанятДругим(НормEmail, ИсключаяИдентификатор) Тогда
		Возврат;
	КонецЕсли;
	// в подробности едет адрес, который прислал сам обратившийся, — но никогда не то,
	// чей он: иначе форма стала бы разведкой чужих учёток
	ВызватьИсключение Отказы.Ошибка(Отказы.АдресЗанят(),
		Новый Структура("email", НормEmail));

КонецПроцедуры

// Учётные записи с указанным адресом. Адрес уникален, поэтому в исправных данных их
// не больше одной — массив отдаётся, чтобы вызывающий видел нарушение, а не выбирал
// вслепую из двух. Пустой адрес не ищется вовсе.
//
// Параметры:
//  Email - Строка - адрес в любом виде.
//
// Возвращаемое значение:
//  Массив из Пользователь.
//
Функция НайтиВсех(Знач Email) Экспорт

	Попытка
		НормEmail = Нормализатор.НормализоватьEmail(Email);
	Исключение
		Возврат Новый Массив();
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(НормEmail) Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат Хранилище.НайтиВсехПоEmail(НормEmail);

КонецФункции

#КонецОбласти

#Область СменаИПодтверждение

// Обновляет адрес учётной записи; при смене сбрасываются обе отметки подтверждения.
// Пустой адрес допускается, некорректный и занятый другой учётной записью — исключение.
// Отказ по занятости приходит до записи, то есть и до письма подтверждения.
//
// Параметры:
//  Пользователь - Пользователь - изменяемая учётная запись.
//  НовыйEmail - Строка - новый адрес.
//
Процедура Сменить(Знач Пользователь, Знач НовыйEmail) Экспорт

	НормEmail = Нормализатор.НормализоватьEmail(НовыйEmail);
	Если НормEmail = Пользователь.Email Тогда
		Возврат;
	КонецЕсли;

	ПроверитьСвободу(НормEmail, Цел(Пользователь.Идентификатор));

	Пользователь.Email = НормEmail;
	Пользователь.EmailПодтверждён = Ложь;
	Пользователь.ПодтверждёнХабом = Ложь;
	Пользователь.Сохранить();

КонецПроцедуры

// Отмечает адрес учётной записи подтверждённым. Зовёт эту точку только источник, который
// вправе за адрес ручаться (провайдер входа, ссылка из письма); пустой адрес не
// подтверждается.
//
// Отметка «подтвердил сам хаб» поднимается только ссылкой из письма хаба и живёт отдельно
// от общего флага: клеймо провайдера переживает и отвязку личности, и снос провайдера,
// поэтому доверять ему там, где решается доступ к учётке, нельзя.
//
// Параметры:
//  Пользователь - Пользователь - изменяемая учётная запись.
//  СобственноеПодтверждение - Булево - Истина, если адрес доказан ссылкой из письма
//                             самого хаба (необязательный, по умолчанию Ложь —
//                             за адрес ручается кто-то внешний).
//
Процедура Подтвердить(Знач Пользователь, Знач СобственноеПодтверждение = Ложь) Экспорт

	Если НЕ ЗначениеЗаполнено(Пользователь.Email) Тогда
		Возврат;
	КонецЕсли;

	Изменилось = Ложь;
	Если НЕ Пользователь.EmailПодтверждён = Истина Тогда
		Пользователь.EmailПодтверждён = Истина;
		Изменилось = Истина;
	КонецЕсли;
	// вниз отметка не едет: сначала письмо хаба, потом вход через провайдера — это
	// по-прежнему адрес, который хаб проверил сам
	Если СобственноеПодтверждение = Истина И НЕ Пользователь.ПодтверждёнХабом = Истина Тогда
		Пользователь.ПодтверждёнХабом = Истина;
		Изменилось = Истина;
	КонецЕсли;

	Если Изменилось Тогда
		Пользователь.Сохранить();
	КонецЕсли;

КонецПроцедуры

// Доказан ли адрес учётной записи собственным подтверждением хаба — тем единственным,
// которое хаб выдал сам и которое не переживает подмену внешнего источника.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - учётная запись.
//
// Возвращаемое значение:
//  Булево.
//
Функция ДоказанХабом(Знач Пользователь) Экспорт

	Если Пользователь = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗначениеЗаполнено(Пользователь.Email)
		И Пользователь.EmailПодтверждён = Истина
		И Пользователь.ПодтверждёнХабом = Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗанятДругим(Знач НормEmail, Знач ИсключаяИдентификатор)

	Если НЕ ЗначениеЗаполнено(НормEmail) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Чужая Из Хранилище.НайтиВсехПоEmail(НормEmail) Цикл
		Если Цел(Чужая.Идентификатор) <> Цел(ИсключаяИдентификатор) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПользователей") _Хранилище,
	&Пластилин(Значение = "НормализаторУчётки") _Нормализатор,
	&Пластилин(Значение = "ОтказыУчётки") _Отказы)

	Хранилище = _Хранилище;
	Нормализатор = _Нормализатор;
	Отказы = _Отказы;

КонецПроцедуры
