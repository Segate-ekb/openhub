// Удаление учётной записи со всем, что к ней привязано: следы в слое людей, гранты
// на чужих пулах, личное пространство целиком. Опубликованное в ОБЩИХ пулах остаётся
// жить, но становится безымянным — иначе снос человека ломал бы сборку тем, кто от его
// пакетов зависит. Журнал аудита не чистится: летопись переживает участников.

Перем СервисПрав;         // СервисПрав (auth)
Перем ХранилищеУчёток;    // ХранилищеПользователей (данные) — пересчёт администраторов
Перем Следы;              // СледыУчётки (auth)
Перем УчастникиПулов;     // ХранилищеУчастниковПула (данные)
Перем Пулы;               // ХранилищеПулов (данные)
Перем СервисПулов;        // СервисПулов (реестр)
Перем Версии;             // ХранилищеВерсийПакета (данные)
Перем Летопись;           // ЛетописьУчёток (auth)

#Область ПубличныйИнтерфейс

// Разрешено ли удаление. Отдельным методом — чтобы экран не рисовал кнопку, которая
// заведомо получит отказ.
//
// Параметры:
//  Инициатор - Пользователь, Неопределено - кто удаляет.
//  Цель - Пользователь, Неопределено - кого удаляют.
//
// Возвращаемое значение:
//  Структура - Можно (Булево), Причина (Строка — код отказа, "" при Можно).
//
Функция ПроверитьУдаление(Знач Инициатор, Знач Цель) Экспорт

	Если НЕ СервисПрав.ПользовательАдмин(Инициатор) Тогда
		Возврат Вердикт(Ложь, ПричинаНеАдмин());
	КонецЕсли;
	Если Цель = Неопределено Тогда
		Возврат Вердикт(Ложь, ПричинаНетУчётки());
	КонецЕсли;
	// последний администратор — раньше «себя»: единственный админ и есть тот, кто это
	// нажимает, и причина «хаб останется без хозяина» объясняет отказ точнее, чем
	// «себя удалить нельзя». Поставь эту ветку ниже — она станет недостижимой
	Если СервисПрав.ПользовательАдмин(Цель) И АдминовКроме(Цель) = 0 Тогда
		Возврат Вердикт(Ложь, ПричинаПоследнийАдмин());
	КонецЕсли;
	// снести себя — мгновенный само-локаут, причём необратимый: вернуть учётку нечем
	Если Цел(Цель.Идентификатор) = Цел(Инициатор.Идентификатор) Тогда
		Возврат Вердикт(Ложь, ПричинаСебе());
	КонецЕсли;

	Возврат Вердикт(Истина, "");

КонецФункции

// Удаляет учётную запись со всем связанным. Порог операции судит ПроверитьУдаление,
// отказ — исключение: удаление необратимо, и точка, обойдённая мимо проверки, снесла бы
// последнего администратора хаба.
//
// Параметры:
//  Инициатор - Пользователь, Неопределено - кто удаляет.
//  Цель - Пользователь, Неопределено - кого удаляют.
//  АдресIP - Строка - адрес клиента для журнала (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - что унесло за собой: Логин, Сессий, Ключей, Личностей, Заявок, Членств,
//              Грантов, Пулов, Обезличено.
//
Функция Удалить(Знач Инициатор, Знач Цель, Знач АдресIP = "") Экспорт

	Итог = ПроверитьУдаление(Инициатор, Цель);
	Если НЕ Итог.Можно Тогда
		ВызватьИсключение СтрШаблон("%1: удаление учётной записи запрещено — форму подделать"
			+ " можно, эту точку нельзя", Итог.Причина);
	КонецЕсли;

	Идентификатор = Цел(Цель.Идентификатор);
	Логин = Строка(Цель.Логин);

	// личное пространство — ПЕРВЫМ: это единственный шаг, который ходит во внешнее
	// хранилище и потому вправе сорваться (дефект листинга S3 в oint, ЗНАНИЕ №15).
	// Сорвавшись здесь, он оставляет учётку нетронутой; сорвавшись последним, он оставлял
	// бы человека без сессий и ключей, но живым — это хуже, чем не удалить вовсе
	Пулов = СнестиЛичныеПулы(Идентификатор);

	Снято = Следы.Убрать(Идентификатор);
	Снято.Вставить("Логин", Логин);
	Снято.Вставить("Пулов", Пулов);
	Снято.Вставить("Грантов", СнятьГранты(Идентификатор));
	Снято.Вставить("Обезличено", ОбезличитьПубликации(Идентификатор));

	Цель.Удалить();

	Летопись.СобытиеУчётки(Летопись.ДействиеУчёткаУдалена(), Логин(Инициатор), Логин,
		Детали(Снято), АдресIP);

	Возврат Снято;

КонецФункции

// Код отказа «удалять учётки вправе только администратор хаба».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНеАдмин() Экспорт
	Возврат "delete_not_admin";
КонецФункции

// Код отказа «такой учётной записи нет».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНетУчётки() Экспорт
	Возврат "delete_no_user";
КонецФункции

// Код отказа «себя не удаляют».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаСебе() Экспорт
	Возврат "delete_self";
КонецФункции

// Код отказа «это последний администратор хаба».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаПоследнийАдмин() Экспорт
	Возврат "delete_last_admin";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Гранты на ЧУЖИХ пулах: роль человека снимается, сам пул остаётся чужим и целым.
Функция СнятьГранты(Знач Идентификатор)

	Снято = 0;
	Для Каждого Роль Из УчастникиПулов.РолиСубъекта(ТипСубъектаПользователь(), Идентификатор) Цикл
		УчастникиПулов.Удалить(Роль);
		Снято = Снято + 1;
	КонецЦикла;

	Возврат Снято;

КонецФункции

// Опубликованное в общих пулах переживает автора: у версии остаётся тот же файл и та же
// история, но публикатор становится безымянным — ровно как у публикации без учётки.
Функция ОбезличитьПубликации(Знач Идентификатор)

	Обезличено = 0;
	Для Каждого Версия Из Версии.ПолучитьПоОпубликовалИдентификаторРавно(Идентификатор) Цикл
		Версия.ОпубликовалИдентификатор = 0;
		Версия.Сохранить();
		Обезличено = Обезличено + 1;
	КонецЦикла;

	Возврат Обезличено;

КонецФункции

// Личное пространство уходит целиком — с пакетами, версиями, файлами и подписками:
// его имя равно логину, и без хозяина оно не живёт.
Функция СнестиЛичныеПулы(Знач Идентификатор)

	Снесено = 0;
	Для Каждого Пул Из Пулы.Все() Цикл
		Если Цел(Пул.ВладелецИдентификатор) <> Идентификатор ИЛИ НЕ Пул.ЭтоЛичный() Тогда
			Продолжить;
		КонецЕсли;
		СервисПулов.УдалитьПул(Пул.Идентификатор);
		Снесено = Снесено + 1;
	КонецЦикла;

	Возврат Снесено;

КонецФункции

// Сколько администраторов останется, если этого удалить.
Функция АдминовКроме(Знач Цель)

	Прочих = 0;
	Для Каждого Пользователь Из ХранилищеУчёток.Все() Цикл
		Если Цел(Пользователь.Идентификатор) = Цел(Цель.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Если СервисПрав.ПользовательАдмин(Пользователь) Тогда
			Прочих = Прочих + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Прочих;

КонецФункции

Функция ТипСубъектаПользователь()
	Возврат "user";
КонецФункции

Функция Логин(Знач Пользователь)
	Возврат ?(Пользователь = Неопределено, "system", Строка(Пользователь.Логин));
КонецФункции

Функция Детали(Знач Снято)

	Результат = Новый Структура();
	Результат.Вставить("сессий", Снято.Сессий);
	Результат.Вставить("ключей", Снято.Ключей);
	Результат.Вставить("личностей", Снято.Личностей);
	Результат.Вставить("заявок", Снято.Заявок);
	Результат.Вставить("членств", Снято.Членств);
	Результат.Вставить("грантов", Снято.Грантов);
	Результат.Вставить("пулов", Снято.Пулов);
	Результат.Вставить("обезличено_версий", Снято.Обезличено);
	Возврат Результат;

КонецФункции

Функция Вердикт(Знач Можно, Знач Причина)
	Возврат Новый Структура("Можно, Причина", Можно, Причина);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ХранилищеПользователей") _ХранилищеУчёток,
	&Пластилин(Значение = "СледыУчётки") _Следы,
	&Пластилин(Значение = "ХранилищеУчастниковПула") _УчастникиПулов,
	&Пластилин(Значение = "ХранилищеПулов") _Пулы,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ХранилищеВерсийПакета") _Версии,
	&Пластилин(Значение = "ЛетописьУчёток") _Летопись)

	СервисПрав = _СервисПрав;
	ХранилищеУчёток = _ХранилищеУчёток;
	Следы = _Следы;
	УчастникиПулов = _УчастникиПулов;
	Пулы = _Пулы;
	СервисПулов = _СервисПулов;
	Версии = _Версии;
	Летопись = _Летопись;

КонецПроцедуры
