// События безопасности учётной записи в журнал аудита: роль хаба, заведение и удаление
// учётки, ссылки и письма установки пароля, смена и подтверждение адреса.

Перем Издатель;       // ИздательСобытий (события); Неопределено — аудит не собран
Перем ИменаЖурнала;   // ИмяОбъектаАудита (аудит) — вид объекта в журнале
Перем СобытиеЖурнала; // СобытиеАудита (аудит) — форма нагрузки записи
Перем Обезличивание;  // ОбезличиваниеЖурнала (наблюдаемость) — адрес почты в строке вехи
&Лог
Перем Лог;

// Пишет смену роли на уровне хаба.
//
// Параметры:
//  Инициатор - Пользователь - кто менял роль.
//  Цель - Пользователь - чья роль изменена.
//  Прежняя - Строка - роль до изменения.
//  Новая - Строка - роль после изменения.
//  АдресIP - Строка - адрес клиента.
//
Процедура СменаРоли(Знач Инициатор, Знач Цель, Знач Прежняя, Знач Новая, Знач АдресIP) Экспорт

	Если Лог <> Неопределено Тогда
		Лог.Информация("Учётка ""%1"": роль хаба ""%2"" → ""%3"", кто ""%4""",
			Строка(Цель.Логин), Прежняя, Новая, Строка(Инициатор.Логин));
	КонецЕсли;

	Если Издатель = Неопределено Тогда
		Если Лог <> Неопределено Тогда
			Лог.Предупреждение("Аудит учётных записей отключён: издатель событий не собран"
				+ " в контейнере. Смена роли учётки ""%1"" (%2 → %3) в журнал НЕ ПОПАЛА",
				Строка(Цель.Логин), Прежняя, Новая);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Детали = Новый Структура();
	Детали.Вставить("логин", Строка(Цель.Логин));
	Детали.Вставить("было", Прежняя);
	Детали.Вставить("стало", Новая);

	Опубликовать(Издатель.ТипРольХабаИзменена(), Издатель.ТипРольХабаИзменена(),
		Строка(Инициатор.Логин), Строка(Цель.Логин), Детали, АдресIP);

КонецПроцедуры

// Пишет событие жизненного цикла учётки: заведение администратором, выпуск ссылки
// установки пароля, исход письма восстановления, установка пароля по ссылке.
//
// Параметры:
//  Действие - Строка - код действия для журнала (см. функции-константы).
//  Кто - Строка - логин принципала операции.
//  Логин - Строка - логин затронутой учётной записи.
//  Детали - Структура - подробности операции; секретов в них не бывает.
//  АдресIP - Строка - адрес клиента (необязательный, по умолчанию "").
//
Процедура СобытиеУчётки(Знач Действие, Знач Кто, Знач Логин, Знач Детали,
	Знач АдресIP = "") Экспорт

	НазватьСобытиеУчётки(Действие, Кто, Логин);

	Если Издатель = Неопределено Тогда
		Если Лог <> Неопределено Тогда
			Лог.Предупреждение("Аудит учётных записей отключён: издатель событий не собран"
				+ " в контейнере. Действие ""%1"" над учёткой ""%2"" (принципал ""%3"")"
				+ " в журнал НЕ ПОПАЛО", Действие, Логин, Кто);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Опубликовать(Издатель.ТипПриглашениеУчётки(), Действие, Кто, Логин, Детали, АдресIP);

КонецПроцедуры

// Действие журнала «администратор завёл учётную запись».
//
// Возвращаемое значение:
//  Строка.
//
Функция ДействиеУчёткаЗаведена() Экспорт
	Возврат "учётка.заведена";
КонецФункции

// Действие журнала «администратор удалил учётную запись со всем связанным».
//
// Возвращаемое значение:
//  Строка.
//
Функция ДействиеУчёткаУдалена() Экспорт
	Возврат "учётка.удалена";
КонецФункции

// Действие журнала «выпущена одноразовая ссылка установки пароля».
//
// Возвращаемое значение:
//  Строка.
//
Функция ДействиеСсылкаВыпущена() Экспорт
	Возврат "ссылка.выпущена";
КонецФункции

// Действие журнала «на адрес учётки послано письмо со ссылкой восстановления пароля».
// Значения ссылки в деталях нет и быть не может — журнал читают шире, чем почтовый ящик.
//
// Возвращаемое значение:
//  Строка.
//
Функция ДействиеПисьмоВосстановления() Экспорт
	Возврат "восстановление.письмо";
КонецФункции

// Действие журнала «по ссылке установлен пароль, учётка активирована».
//
// Возвращаемое значение:
//  Строка.
//
Функция ДействиеПарольУстановлен() Экспорт
	Возврат "пароль.установлен";
КонецФункции

// Пишет событие подтверждения адреса: смену или снятие адреса владельцем, письмо со ссылкой
// и само подтверждение. Ссылки в деталях нет и быть не может — журнал читают шире, чем почтовый ящик.
//
// Параметры:
//  Действие - Строка - код действия для журнала (см. функции-константы).
//  Логин - Строка - логин затронутой учётной записи.
//  Детали - Структура - подробности операции.
//  АдресIP - Строка - адрес клиента (необязательный, по умолчанию "").
//
Процедура СобытиеПодтверждения(Знач Действие, Знач Логин, Знач Детали,
	Знач АдресIP = "") Экспорт

	НазватьСобытиеПодтверждения(Действие, Логин, Детали);

	Если Издатель = Неопределено Тогда
		Если Лог <> Неопределено Тогда
			Лог.Предупреждение("Аудит учётных записей отключён: издатель событий не собран"
				+ " в контейнере. Действие ""%1"" над учёткой ""%2"" в журнал НЕ ПОПАЛО",
				Действие, Логин);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Опубликовать(Издатель.ТипПодтверждениеАдреса(), Действие, Логин, Логин, Детали, АдресIP);

КонецПроцедуры

// Действие журнала «на адрес учётки послано письмо со ссылкой подтверждения».
//
// Возвращаемое значение:
//  Строка.
//
Функция ДействиеПисьмоПодтверждения() Экспорт
	Возврат "подтверждение.письмо";
КонецФункции

// Действие журнала «адрес учётки подтверждён переходом по ссылке из письма».
//
// Возвращаемое значение:
//  Строка.
//
Функция ДействиеАдресПодтверждён() Экспорт
	Возврат "подтверждение.адрес";
КонецФункции

// Действие журнала «владелец сменил или снял адрес учётки»: подтверждение прежнего адреса
// снято вместе с ним.
//
// Возвращаемое значение:
//  Строка.
//
Функция ДействиеАдресСменён() Экспорт
	Возврат "адрес.сменён";
КонецФункции

// Письмо восстановления и удаление учётки называют свои строки: восстановления пароля и удаления с числом снятого.
Процедура НазватьСобытиеУчётки(Знач Действие, Знач Кто, Знач Логин)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Действие = ДействиеУчёткаЗаведена() Тогда
		Лог.Информация("Учётка ""%1"": заведена, кто ""%2""", Логин, Кто);
	ИначеЕсли Действие = ДействиеСсылкаВыпущена() Тогда
		Лог.Информация("Учётка ""%1"": выпущена ссылка установки пароля, кто ""%2""", Логин, Кто);
	ИначеЕсли Действие = ДействиеПарольУстановлен() Тогда
		Лог.Информация("Учётка ""%1"": пароль установлен по ссылке, кто ""%2""", Логин, Кто);
	КонецЕсли;

КонецПроцедуры

// Письмо подтверждения называет почта; веха — сам адрес. Ящик в строку не идёт — только его первая буква.
Процедура НазватьСобытиеПодтверждения(Знач Действие, Знач Логин, Знач Детали)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Адрес = Обезличивание.Почта(АдресИзДеталей(Детали));
	Если Действие = ДействиеАдресПодтверждён() Тогда
		Лог.Информация("Учётка ""%1"": подтверждён адрес %2", Логин, Адрес);
	ИначеЕсли Действие = ДействиеАдресСменён() Тогда
		Лог.Информация("Учётка ""%1"": адрес сменён на %2", Логин, Адрес);
	КонецЕсли;

КонецПроцедуры

// Адрес, к которому пришла учётка: после смены — новый, после подтверждения — подтверждённый.
Функция АдресИзДеталей(Знач Детали)

	// без Перем присваивание уйдёт в ПОЛЕ объекта, общее на процесс
	Перем Адрес;

	Адрес = "";
	Если ТипЗнч(Детали) = Тип("Структура") И НЕ Детали.Свойство("стало", Адрес) Тогда
		Детали.Свойство("адрес", Адрес);
	КонецЕсли;
	Возврат Строка(?(Адрес = Неопределено, "", Адрес));

КонецФункции

Процедура Опубликовать(Знач ТипСобытия, Знач Действие, Знач Кто, Знач Логин,
	Знач Детали, Знач АдресIP)

	// лог опционален так же, как в предупреждениях выше: летопись собирают и без него
	Если Лог <> Неопределено Тогда
		Лог.Отладка("Летопись учёток: событие ""%1"" по учётке ""%2""", Действие, Логин);
	КонецЕсли;

	Учётка = ИменаЖурнала.Пользователь(Логин);

	Издатель.Опубликовать(ТипСобытия,
		СобытиеЖурнала.Собрать(Кто, Действие, Учётка, Учётка, Детали, АдресIP));

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ИмяОбъектаАудита") _Имена,
	&Пластилин(Значение = "СобытиеАудита") _Событие,
	&Пластилин(Значение = "ИздательСобытий") _Издатель = Неопределено,
	&Лог _Лог = Неопределено)

	ИменаЖурнала = _Имена;
	СобытиеЖурнала = _Событие;
	Обезличивание = Новый ОбезличиваниеЖурнала();
	Издатель = _Издатель;
	// Лог параметром — для создания через `Новый` вне контейнера, где `&Лог` не внедряется
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
