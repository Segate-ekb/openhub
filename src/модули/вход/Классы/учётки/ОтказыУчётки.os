// Причины отказа завести или изменить учётную запись: машинный код в ответ, HTTP-статус,
// текст и состав подробностей. Одна таблица на все двери — API, форму регистрации
// и смену адреса.

#Использовать errors

Перем Ошибки;        // ТекстОшибки (основа)
Перем Правила;       // Соответствие: внутренний код причины → правило ответа
Перем ОбщееПравило;  // ответ на нераспознанное исключение

#Область Причины

// Регистрация закрыта до создания первого администратора (мастер /setup).
//
// Возвращаемое значение:
//  Строка - внутренний код причины.
//
Функция ОнбордингНеЗавершён() Экспорт
	Возврат "registration.locked_onboarding";
КонецФункции

// Вход по логину и паролю выключен, поэтому регистрация с паролем закрыта.
//
// Возвращаемое значение:
//  Строка - внутренний код причины.
//
Функция ПарольныйВходВыключен() Экспорт
	Возврат "registration.password_login_disabled";
КонецФункции

// Самостоятельная регистрация выключена режимом хаба.
//
// Возвращаемое значение:
//  Строка - внутренний код причины.
//
Функция РегистрацияВыключена() Экспорт
	Возврат "registration.disabled";
КонецФункции

// Учётные записи заводит администратор и выдаёт ссылку установки пароля.
//
// Возвращаемое значение:
//  Строка - внутренний код причины.
//
Функция ТолькоПоПриглашению() Экспорт
	Возврат "registration.invite_only";
КонецФункции

// Подтверждение адреса обещано настройкой, а слать письма нечем.
//
// Возвращаемое значение:
//  Строка - внутренний код причины.
//
Функция ПочтаНеНастроена() Экспорт
	Возврат "registration.mail_not_configured";
КонецФункции

// Адрес почты уже принадлежит другой учётной записи.
//
// Возвращаемое значение:
//  Строка - внутренний код причины.
//
Функция АдресЗанят() Экспорт
	Возврат "account.email_taken";
КонецФункции

// Логин уже принадлежит другой учётной записи.
//
// Возвращаемое значение:
//  Строка - внутренний код причины.
//
Функция ЛогинЗанят() Экспорт
	Возврат "account.user_exists";
КонецФункции

#КонецОбласти

#Область ПубличныйИнтерфейс

// Ошибка отказа: машинный код причины едет с ней, а не словами в тексте.
//
// Параметры:
//  Причина - Строка - внутренний код причины из этой таблицы.
//  Подробности - Структура, Неопределено - данные отказа; наружу уходят только поля,
//                объявленные таблицей для этой причины (необязательный, по умолчанию
//                Неопределено).
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - кадр для ВызватьИсключение.
//
Функция Ошибка(Знач Причина, Знач Подробности = Неопределено) Экспорт
	Правило = ПравилоПричины(Причина);
	Возврат ФабрикаОшибок.Создать(Причина, Правило.Сообщение, Подробности);
КонецФункции

// Та же ошибка отказа поверх пойманной: снаружи видна причина отказа, а в журнале
// остаётся то, из-за чего она возникла на самом деле.
//
// Параметры:
//  Причина - Строка - внутренний код причины из этой таблицы.
//  ИнфОбОшибке - ИнформацияОбОшибке - пойманное исключение, ставшее причиной отказа.
//  Подробности - Структура, Неопределено - данные отказа (необязательный, по умолчанию
//                Неопределено).
//
// Возвращаемое значение:
//  ИнформацияОбОшибке - кадр для ВызватьИсключение.
//
Функция ОшибкаНад(Знач Причина, Знач ИнфОбОшибке, Знач Подробности = Неопределено) Экспорт
	Правило = ПравилоПричины(Причина);
	Возврат ФабрикаОшибок.Обернуть(ИнфОбОшибке, Причина, Правило.Сообщение, Подробности);
КонецФункции

// Как отвечает дверь на пойманное исключение. Причина читается машинным кодом, а не
// поиском слов в тексте: постороннее исключение — общий отказ, чем бы оно ни называлось.
//
// Параметры:
//  ИнфОбОшибке - ИнформацияОбОшибке - пойманное исключение.
//
// Возвращаемое значение:
//  Структура - Причина (Строка, внутренний код; "" — причина не названа),
//              Код (Строка, машинный код наружу), Статус (Число, HTTP),
//              Сообщение (Строка), Подробности (Структура, Неопределено).
//
Функция Разобрать(Знач ИнфОбОшибке) Экспорт

	Причина = ПричинаКадра(ИнфОбОшибке);
	Если Причина = "" Тогда
		Возврат Отказ("", ОбщееПравило.Код, ОбщееПравило.Статус, ОбщийТекст(ИнфОбОшибке),
			ПодробностиЧужогоОтказа(ИнфОбОшибке));
	КонецЕсли;

	Правило = ПравилоПричины(Причина);
	Возврат Отказ(Причина, Правило.Код, Правило.Статус, Правило.Сообщение,
		ПодробностиОтказа(Правило, ИнфОбОшибке));

КонецФункции

// Машинный код причины в том виде, в каком его читает клиент.
//
// Параметры:
//  Причина - Строка - внутренний код причины из этой таблицы.
//
// Возвращаемое значение:
//  Строка.
//
Функция Код(Знач Причина) Экспорт
	Возврат ПравилоПричины(Причина).Код;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Наружный код и HTTP-статус — контракт клиентов; поля подробностей перечислены явно,
// чтобы в ответ не уехало ничего, кроме названного здесь.
Процедура ЗаполнитьТаблицу()

	Правила = Новый Соответствие();

	Объявить(ОнбордингНеЗавершён(), "registration_locked_onboarding", 403,
		"Регистрация закрыта до создания первого администратора (мастер /setup)");
	Объявить(ПарольныйВходВыключен(), "registration_password_login_disabled", 403,
		"Вход по логину и паролю выключен: регистрация с паролем закрыта");
	Объявить(РегистрацияВыключена(), "registration_disabled", 403,
		"Регистрация на хабе отключена");
	Объявить(ТолькоПоПриглашению(), "registration_invite_only", 403,
		"Регистрация доступна только по приглашению: учётную запись заводит администратор"
		+ " и выдаёт ссылку установки пароля");
	Объявить(ПочтаНеНастроена(), "registration_mail_not_configured", 503,
		"Регистрация закрыта: включено подтверждение адреса письмом, а отправка почты"
		+ " на хабе не настроена. Администратору — настроить почту либо выключить"
		+ " подтверждение адреса в настройках хаба");
	Объявить(АдресЗанят(), "email_taken", 409,
		"Адрес электронной почты уже принадлежит другой учётной записи").Поля.Добавить("email");
	// логин занят учёткой либо именем пула: адрес /<имя>/… один на тех и других, и для
	// того, кто регистрируется, разница только в том, что имя занято
	Объявить(ЛогинЗанят(), "user_exists", 409,
		"Логин уже занят: имена учётных записей и пулов делят первый сегмент адреса."
		+ " Выберите другой логин.").Поля.Добавить("login");

	// нераспознанное исключение: причина неизвестна, поэтому наружу едут общий код
	// и собственный текст исключения — без подробностей
	ОбщееПравило = НовоеПравило("registration_failed", 400, "");

КонецПроцедуры

Функция Объявить(Знач Причина, Знач Код, Знач Статус, Знач Сообщение)
	Правило = НовоеПравило(Код, Статус, Сообщение);
	Правила.Вставить(Причина, Правило);
	Возврат Правило;
КонецФункции

Функция НовоеПравило(Знач Код, Знач Статус, Знач Сообщение)
	Возврат Новый Структура("Код, Статус, Сообщение, Поля", Код, Статус, Сообщение,
		Новый Массив());
КонецФункции

Функция ПравилоПричины(Знач Причина)

	Правило = Правила.Получить(Причина);
	Если Правило = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"Причина отказа ""%1"" в таблице ОтказыУчётки не объявлена", Причина);
	КонецЕсли;
	Возврат Правило;

КонецФункции

// Причина отказа либо "" — исключение поднято не этой таблицей. Чужой машинный код
// (своя причина у библиотеки) — тоже посторонняя причина: наружу он не транслируется.
Функция ПричинаКадра(Знач ИнфОбОшибке)

	Причина = ДиагностикаОшибок.КодОшибки(ИнфОбОшибке);
	Если Причина = Неопределено ИЛИ Правила.Получить(Причина) = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Причина;

КонецФункции

// Наружу уходят только поля, объявленные для этой причины: что положили в данные ошибки
// сверх них — внутреннее дело хаба.
Функция ПодробностиОтказа(Знач Правило, Знач ИнфОбОшибке)

	Если Правило.Поля.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Данные = ДиагностикаОшибок.Разобрать(ИнфОбОшибке).Данные();
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура();
	Для Каждого Имя Из Правило.Поля Цикл
		Значение = Неопределено;
		Если Данные.Свойство(Имя, Значение) И ЗначениеЗаполнено(Значение) Тогда
			Результат.Вставить(Имя, Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат ?(Результат.Количество() = 0, Неопределено, Результат);

КонецФункции

// Отказ пришёл из библиотеки — наружу едет её машинный код, и только он: ни цепочки
// причин, ни стека, ни мест возникновения.
Функция ПодробностиЧужогоОтказа(Знач ИнфОбОшибке)

	Код = ДиагностикаОшибок.КодОшибки(ИнфОбОшибке);
	Если Код = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("error_code", Строка(Код));

КонецФункции

Функция ОбщийТекст(Знач ИнфОбОшибке)
	Возврат СокрЛП(Ошибки.Кратко(КраткоеПредставлениеОшибки(ИнфОбОшибке)));
КонецФункции

Функция Отказ(Знач Причина, Знач Код, Знач Статус, Знач Сообщение, Знач Подробности)
	Возврат Новый Структура("Причина, Код, Статус, Сообщение, Подробности",
		Причина, Код, Статус, Сообщение, Подробности);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ТекстОшибки") _Ошибки)
	Ошибки = _Ошибки;
	ЗаполнитьТаблицу();
КонецПроцедуры
