// Удаление учётной записи со всем, что к ней привязано: следы в слое людей, права на чужих
// объектах, личное пространство. Опубликованное в общих пулах остаётся, но становится безымянным.

Перем СервисПрав;         // СервисПрав (права)
Перем ПраваДоступа;       // СервисПравДоступа (права) - отзыв грантов учётки
Перем ХранилищеУчеток;    // ХранилищеПользователей (вход) - пересчёт администраторов
Перем Следы;              // СледыУчетки (вход)
Перем СервисПулов;        // СервисПулов (реестр)
Перем СервисВерсий;       // СервисВерсий (реестр)
Перем Летопись;           // ЛетописьУчеток (вход)
Перем Вердикты;           // Вердикт (основа) - форма ответа
// BSLLS:MissingVariablesDescription-off
&Лог
Перем Лог;
// BSLLS:MissingVariablesDescription-on

#Область ПубличныйИнтерфейс

// Разрешено ли удаление. Отдельным методом - чтобы экран не рисовал кнопку, которая
// заведомо получит отказ.
//
// Параметры:
//  Инициатор - Пользователь, Неопределено - кто удаляет.
//  Цель - Пользователь, Неопределено - кого удаляют.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка - код отказа, "" при успехе).
//
Функция ПроверитьУдаление(Знач Инициатор, Знач Цель) Экспорт

	Если НЕ СервисПрав.ПользовательАдмин(Инициатор) Тогда
		Возврат Вердикты.Отказ(ПричинаНеАдмин());
	КонецЕсли;
	Если Цель = Неопределено Тогда
		Возврат Вердикты.Отказ(ПричинаНетУчетки());
	КонецЕсли;
	// раньше «себя»: единственный админ и есть тот, кто нажимает, и эта причина точнее
	Если СервисПрав.ПользовательАдмин(Цель) И АдминовКроме(Цель) = 0 Тогда
		Возврат Вердикты.Отказ(ПричинаПоследнийАдмин());
	КонецЕсли;
	// снести себя - мгновенный само-локаут, причём необратимый: вернуть учётку нечем
	Если Цел(Цель.Идентификатор) = Цел(Инициатор.Идентификатор) Тогда
		Возврат Вердикты.Отказ(ПричинаСебе());
	КонецЕсли;

	Возврат Вердикты.Успех();

КонецФункции

// Удаляет учётную запись со всем связанным. Порог судит ПроверитьУдаление,
// отказ - исключение.
//
// Параметры:
//  Инициатор - Пользователь, Неопределено - кто удаляет.
//  Цель - Пользователь, Неопределено - кого удаляют.
//  АдресIP - Строка - адрес клиента для журнала (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - что унесло за собой: Логин, Сессий, Ключей, Личностей, Заявок, Членств,
//              Уведомлений, Грантов, Ролей, Пулов, Обезличено.
//
Функция Удалить(Знач Инициатор, Знач Цель, Знач АдресIP = "") Экспорт

	Итог = ПроверитьУдаление(Инициатор, Цель);
	Если НЕ Итог.Успех Тогда
		ВызватьИсключение СтрШаблон("%1: удаление учётной записи запрещено - форму подделать"
			+ " можно, эту точку нельзя", Итог.Причина);
	КонецЕсли;

	Идентификатор = Цел(Цель.Идентификатор);
	Логин = Строка(Цель.Логин);

	// первым: единственный шаг, который вправе сорваться, оставив учётку нетронутой
	Пулов = СнестиЛичныеПулы(Идентификатор);

	Снято = Следы.Убрать(Идентификатор);
	Снято.Вставить("Логин", Логин);
	Снято.Вставить("Пулов", Пулов);
	ТипУчетки = СервисПрав.ТипСубъектаПользователь();
	Снято.Вставить("Грантов", ПраваДоступа.ОтозватьГрантыСубъекта(ТипУчетки, Идентификатор, Логин(Инициатор)));
	Снято.Вставить("Ролей", СервисПрав.СнятьРолиСубъекта(ТипУчетки, Идентификатор));
	Снято.Вставить("Обезличено", СервисВерсий.ОбезличитьПубликации(Идентификатор));

	Цель.Удалить();
	ХранилищеУчеток.ЗабытьНаличиеУчеток();

	// одно дело - одна строка: права, снятые пачкой, названы здесь числом
	Лог.Информация("Учётка ""%1"": удалена, кто ""%2"" - снято прав %3, ролей %4, личных пространств %5, сессий %6,"
		+ " ключей %7, заявок %8; обезличено версий %9", Логин, Логин(Инициатор), Снято.Грантов, Снято.Ролей,
		Снято.Пулов, Снято.Сессий, Снято.Ключей, Снято.Заявок, Снято.Обезличено);
	Летопись.СобытиеУчетки(Летопись.ДействиеУчеткаУдалена(), Логин(Инициатор), Логин,
		Детали(Снято), АдресIP);

	Возврат Снято;

КонецФункции

// Код отказа «удалять учётки вправе только администратор хаба».
//
// Возвращаемое значение:
//  Строка
//
Функция ПричинаНеАдмин() Экспорт
	Возврат "delete_not_admin";
КонецФункции

// Код отказа «такой учётной записи нет».
//
// Возвращаемое значение:
//  Строка
//
Функция ПричинаНетУчетки() Экспорт
	Возврат "delete_no_user";
КонецФункции

// Код отказа «себя не удаляют».
//
// Возвращаемое значение:
//  Строка
//
Функция ПричинаСебе() Экспорт
	Возврат "delete_self";
КонецФункции

// Код отказа «это последний администратор хаба».
//
// Возвращаемое значение:
//  Строка
//
Функция ПричинаПоследнийАдмин() Экспорт
	Возврат "delete_last_admin";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off

// Личное пространство уходит целиком: его имя равно логину, и без хозяина оно не живёт.
Функция СнестиЛичныеПулы(Знач Идентификатор)

	Снесено = 0;
	Для Каждого Пул Из СервисПулов.ПулыПоТипу(СервисПулов.ТипЛичный()) Цикл
		Если Цел(Пул.ВладелецИдентификатор) <> Идентификатор Тогда
			Продолжить;
		КонецЕсли;
		СервисПулов.УдалитьПул(Пул.Идентификатор);
		Снесено = Снесено + 1;
	КонецЦикла;

	Возврат Снесено;

КонецФункции

// Сколько администраторов останется, если этого удалить.
Функция АдминовКроме(Знач Цель)

	Прочих = 0;
	Для Каждого Пользователь Из ХранилищеУчеток.Все() Цикл
		Если Цел(Пользователь.Идентификатор) = Цел(Цель.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Если СервисПрав.ПользовательАдмин(Пользователь) Тогда
			Прочих = Прочих + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Прочих;

КонецФункции

Функция Логин(Знач Пользователь)
	Возврат ?(Пользователь = Неопределено, "system", Строка(Пользователь.Логин));
КонецФункции

Функция Детали(Знач Снято)

	Результат = Новый Структура();
	Результат.Вставить("сессий", Снято.Сессий);
	Результат.Вставить("ключей", Снято.Ключей);
	Результат.Вставить("личностей", Снято.Личностей);
	Результат.Вставить("заявок", Снято.Заявок);
	Результат.Вставить("членств", Снято.Членств);
	Результат.Вставить("уведомлений", Снято.Уведомлений);
	Результат.Вставить("грантов", Снято.Грантов);
	Результат.Вставить("ролей", Снято.Ролей);
	Результат.Вставить("пулов", Снято.Пулов);
	Результат.Вставить("обезличено_версий", Снято.Обезличено);
	Возврат Результат;

КонецФункции

// BSLLS:MissingParameterDescription-on
// BSLLS:MissingReturnedValueDescription-on
#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисПравДоступа") _ПраваДоступа,
	&Пластилин(Значение = "ХранилищеПользователей") _ХранилищеУчеток,
	&Пластилин(Значение = "СледыУчетки") _Следы,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "ЛетописьУчеток") _Летопись)

	СервисПрав = _СервисПрав;
	ПраваДоступа = _ПраваДоступа;
	ХранилищеУчеток = _ХранилищеУчеток;
	Следы = _Следы;
	СервисПулов = _СервисПулов;
	СервисВерсий = _СервисВерсий;
	Летопись = _Летопись;

	Вердикты = Новый Вердикт();

КонецПроцедуры
