// Списки учёток для экранов: «Пользователи» — отбор по подстроке с признаком «есть чем войти»
// одним запросом на весь список; «Участники группы» — кандидаты вне состава группы.

Перем Хранилище;    // ХранилищеПользователей (вход)
Перем Активность;   // СервисАктивностиУчёток (вход) — есть ли чем войти
Перем Отбор;        // ПоискПоКоллекции (основа)

// Учётки хаба, отобранные подстрокой, с признаком «есть чем войти» у каждой.
//
// Параметры:
//  Подстрока - Строка - подстрока логина или email; пустая — весь список.
//
// Возвращаемое значение:
//  Массив из Структура - Пользователь (Пользователь), ЕстьВход (Булево).
//
Функция Отобранные(Знач Подстрока) Экспорт

	Учётки = Отбор.Отобрать(Хранилище.Все(), Подстрока, Хранилище.ПоляОтбора());
	Способы = Активность.СпособыВхода(Учётки);

	Результат = Новый Массив();
	Для Каждого Пользователь Из Учётки Цикл
		Результат.Добавить(Новый Структура("Пользователь, ЕстьВход",
			Пользователь, Способы.Получить(Цел(Пользователь.Идентификатор)) = Истина));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Учётки хаба вне названного состава, отобранные подстрокой: кандидаты в участники группы.
//
// Параметры:
//  Подстрока - Строка - подстрока логина или email; пустая — все учётки вне состава.
//  Состав - Массив из Число - идентификаторы учёток, которых в выдаче быть не должно.
//
// Возвращаемое значение:
//  Массив из Пользователь - в порядке релевантности отбора.
//
Функция ОтобранныеВнеСостава(Знач Подстрока, Знач Состав) Экспорт

	ВСоставе = Новый Соответствие();
	Для Каждого Идентификатор Из Состав Цикл
		ВСоставе.Вставить(Цел(Идентификатор), Истина);
	КонецЦикла;

	Свободные = Новый Массив();
	Для Каждого Пользователь Из Хранилище.Все() Цикл
		Если ВСоставе.Получить(Цел(Пользователь.Идентификатор)) = Неопределено Тогда
			Свободные.Добавить(Пользователь);
		КонецЕсли;
	КонецЦикла;

	Возврат Отбор.Отобрать(Свободные, Подстрока, Хранилище.ПоляОтбора());

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПользователей") _Хранилище,
	&Пластилин(Значение = "СервисАктивностиУчёток") _Активность,
	&Пластилин(Значение = "ПоискПоКоллекции") _Отбор)

	Хранилище = _Хранилище;
	Активность = _Активность;
	Отбор = _Отбор;

КонецПроцедуры
