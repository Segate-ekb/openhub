// Список учёток хаба для экрана администратора: отбор по подстроке и признак «есть чем
// войти» на каждой строке. Данные собирает домен, а не витрина, и способ входа стоит
// одного запроса на весь список.

Перем Хранилище;    // ХранилищеПользователей (данные)
Перем Активность;   // СервисАктивностиУчёток (auth) — есть ли чем войти
Перем Отбор;        // ПоискПоКоллекции (поиск)

// Учётки хаба, отобранные подстрокой, с признаком «есть чем войти» у каждой.
//
// Параметры:
//  Подстрока - Строка - подстрока логина или email; пустая — весь список.
//
// Возвращаемое значение:
//  Массив из Структура - Пользователь (Пользователь), ЕстьВход (Булево).
//
Функция Отобранные(Знач Подстрока) Экспорт

	Учётки = Отбор.Отобрать(Хранилище.Все(), Подстрока, Хранилище.ПоляОтбора());
	Способы = Активность.СпособыВхода(Учётки);

	Результат = Новый Массив();
	Для Каждого Пользователь Из Учётки Цикл
		Результат.Добавить(Новый Структура("Пользователь, ЕстьВход",
			Пользователь, Способы.Получить(Цел(Пользователь.Идентификатор)) = Истина));
	КонецЦикла;
	Возврат Результат;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПользователей") _Хранилище,
	&Пластилин(Значение = "СервисАктивностиУчёток") _Активность,
	&Пластилин(Значение = "ПоискПоКоллекции") _Отбор)

	Хранилище = _Хранилище;
	Активность = _Активность;
	Отбор = _Отбор;

КонецПроцедуры
