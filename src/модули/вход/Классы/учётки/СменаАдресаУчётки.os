// Смена адреса почты учётной записи её владельцем: запись нового адреса и письмо
// подтверждения на него одной операцией, а по просьбе владельца — письмо повторно.

Перем Адреса;        // АдресУчётки (auth) — занятость и запись адреса
Перем Подтверждение; // СервисПодтвержденияEmail (auth) — выпуск ссылки с письмом
Перем Коды;          // КодыПодтверждения (auth) — коды отказов цикла и почты
Перем Летопись;      // ЛетописьУчёток (auth) — след смены в журнале аудита
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Записывает учётной записи новый адрес и сразу высылает на него письмо подтверждения.
// Занятый и негодный адрес отвергаются исключением до записи, то есть и до письма.
// Прежний адрес не меняет ничего: подтверждение остаётся, письма нет. Пустой адрес
// снимает почту с учётки, и письма тоже нет — подтверждать нечего.
//
// Параметры:
//  Пользователь - Пользователь - учётная запись, чей адрес меняется.
//  НовыйEmail - Строка - адрес в том виде, как его набрали.
//  АдресIP - Строка - адрес клиента для журнала (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Сменён (Булево — записан адрес, отличный от прежнего),
//              Письмо (Структура, Неопределено — исход письма, как у ВыслатьПисьмо;
//              Неопределено — письма не было: адрес прежний либо пустой).
//
Функция Сменить(Знач Пользователь, Знач НовыйEmail, Знач АдресIP = "") Экспорт

	Прежний = Строка(Пользователь.Email);

	Если НЕ Адреса.Сменить(Пользователь, НовыйEmail) Тогда
		Возврат Исход(Ложь, Неопределено);
	КонецЕсли;

	Летопись.СобытиеПодтверждения(Летопись.ДействиеАдресСменён(), Строка(Пользователь.Логин),
		Новый Структура("было, стало", Прежний, Строка(Пользователь.Email)), АдресIP);

	Если НЕ ЗначениеЗаполнено(Пользователь.Email) Тогда
		Возврат Исход(Истина, Неопределено);
	КонецЕсли;

	Возврат Исход(Истина, ВыслатьПисьмо(Пользователь, АдресIP));

КонецФункции

// Высылает письмо подтверждения на адрес учётной записи. Прежняя живая ссылка гаснет:
// годной у учётки остаётся одна — из этого письма. Сорвавшийся выпуск исключения наружу
// не бросает: адрес к этому моменту уже записан, и отменять его нечем. Отказ почты
// пишется в журнал предупреждением.
//
// Параметры:
//  Пользователь - Пользователь - чей адрес подтверждается.
//  АдресIP - Строка - адрес клиента для журнала (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - как у СервисПодтвержденияEmail.ЗапроситьНеРоняя: Успех (Булево — письмо
//              принято к отправке), Причина (Строка — код отказа из КодыПодтверждения,
//              "" при успехе), Заявка, Сообщение.
//
Функция ВыслатьПисьмо(Знач Пользователь, Знач АдресIP = "") Экспорт

	Итог = Подтверждение.ЗапроситьНеРоняя(Пользователь, Неопределено, АдресIP);

	Если ОтказалаПочта(Итог.Причина) Тогда
		Лог.Предупреждение("Письмо подтверждения адреса учётки ""%1"" не выслано: %2",
			Строка(Пользователь.Логин), Итог.Причина);
	КонецЕсли;

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отказ внешней системы, а не состояние учётки или решение администратора.
Функция ОтказалаПочта(Знач Причина)
	Возврат Коды.ЭтоОтказПочты(Причина) ИЛИ Причина = Коды.НетАдресаХаба();
КонецФункции

Функция Исход(Знач Сменён, Знач Письмо)
	Возврат Новый Структура("Сменён, Письмо", Сменён, Письмо);
КонецФункции

#КонецОбласти

&Желудь
&Наблюдаемый
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "АдресУчётки") _Адреса,
	&Пластилин(Значение = "СервисПодтвержденияEmail") _Подтверждение,
	&Пластилин(Значение = "КодыПодтверждения") _Коды,
	&Пластилин(Значение = "ЛетописьУчёток") _Летопись,
	&Лог _Лог = Неопределено)

	Адреса = _Адреса;
	Подтверждение = _Подтверждение;
	Коды = _Коды;
	Летопись = _Летопись;
	// Лог параметром — для создания через `Новый` вне контейнера: инъекция в поле
	// `&Лог` туда не доезжает.
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
