// Поиск учётной записи по тому, что человек набрал в форме: логин либо адрес почты.
// Один поиск на все публичные формы, где учётку называют, — восстановление пароля
// и запрос письма подтверждения.

Перем Пользователи; // СервисПользователей (auth)
Перем Адреса;       // АдресУчётки (auth)

// Учётка по логину или адресу. Адрес ищется только целиком совпадающий: подстроки
// и частичные совпадения тут были бы разведкой чужих ящиков.
//
// Параметры:
//  Названное - Строка - логин либо адрес почты.
//
// Возвращаемое значение:
//  Пользователь, Неопределено - Неопределено, если такой учётки нет.
//
Функция ПоЛогинуИлиАдресу(Знач Названное) Экспорт

	Если НЕ ЗначениеЗаполнено(Названное) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// нормализатор логина отвергает то, что логином быть не может, — для адреса это норма
	Попытка
		Найденный = Пользователи.НайтиПоЛогину(Названное);
	Исключение
		Найденный = Неопределено;
	КонецПопытки;
	Если Найденный <> Неопределено Тогда
		Возврат Найденный;
	КонецЕсли;

	Возврат ПоАдресу(Названное);

КонецФункции

// Адрес принадлежит одной учётке (ИСТ-ДОСТ-029), поэтому «нашли двоих» — это сломанные
// данные, а не выбор: в таком случае не находим никого.
Функция ПоАдресу(Знач Названное)

	Норм = НРег(Названное);
	Если СтрНайти(Норм, "@") = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Найденные = Адреса.НайтиВсех(Норм);
	Возврат ?(Найденные.Количество() = 1, Найденные[0], Неопределено);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПользователей") _Пользователи,
	&Пластилин(Значение = "АдресУчётки") _Адреса)

	Пользователи = _Пользователи;
	Адреса = _Адреса;

КонецПроцедуры
