// Единая точка нормализации логина и пароля до хеширования и поиска. Алфавит логина
// ограничен ASCII [a-z0-9._-], пароль уходит в pwhash байт-в-байт как есть.

Перем МинДлинаЛогина;
Перем МаксДлинаЛогина;

// Нормализует логин: краевые пробелы убираются, регистр приводится к нижнему.
//
// Параметры:
//  Логин - Строка - сырой логин.
//
// Возвращаемое значение:
//  Строка - нормализованный логин.
//
Функция НормализоватьЛогин(Знач Логин) Экспорт
	Возврат НРег(СокрЛП(Строка(Логин)));
КонецФункции

// Проверяет уже нормализованный логин: длина, алфавит [a-z0-9._-], первый символ —
// буква или цифра. Некорректный логин — исключение с текстом для человека.
//
// Параметры:
//  Логин - Строка - уже нормализованный логин.
//
Процедура ПроверитьЛогин(Знач Логин) Экспорт

	Если СтрДлина(Логин) < МинДлинаЛогина ИЛИ СтрДлина(Логин) > МаксДлинаЛогина Тогда
		ВызватьИсключение СтрШаблон(
			"Логин должен быть длиной %1–%2 символов", МинДлинаЛогина, МаксДлинаЛогина);
	КонецЕсли;

	Разрешённые = "abcdefghijklmnopqrstuvwxyz0123456789._-";
	Для НомерСимвола = 1 По СтрДлина(Логин) Цикл
		Символ = Сред(Логин, НомерСимвола, 1);
		Если СтрНайти(Разрешённые, Символ) = 0 Тогда
			ВызватьИсключение
				"Логин может содержать только строчные латинские буквы, цифры и символы . _ -";
		КонецЕсли;
	КонецЦикла;

	Первый = Лев(Логин, 1);
	Если СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789", Первый) = 0 Тогда
		ВызватьИсключение "Логин должен начинаться с латинской буквы или цифры";
	КонецЕсли;

КонецПроцедуры

// Пароль как есть (регистр и краевые пробелы значимы), единая точка на случай NFC.
//
// Параметры:
//  Пароль - Строка - сырой пароль.
//
// Возвращаемое значение:
//  Строка - пароль без изменений.
//
Функция НормализоватьПароль(Знач Пароль) Экспорт
	Возврат Строка(Пароль);
КонецФункции

// Базовая проверка e-mail (без RFC-строгости): ровно один @, точка в домене, ни пробела,
// ни управляющего символа внутри. Пустой адрес допускается, некорректный непустой —
// исключение.
//
// Параметры:
//  Email - Строка - сырой адрес.
//
// Возвращаемое значение:
//  Строка - адрес в нижнем регистре без краевых пробелов либо "".
//
Функция НормализоватьEmail(Знач Email) Экспорт

	Значение = НРег(СокрЛП(Строка(Email)));
	Если ПустаяСтрока(Значение) Тогда
		Возврат "";
	КонецЕсли;

	ЧастиПоСобаке = СтрРазделить(Значение, "@", Истина);
	Если ЧастиПоСобаке.Количество() <> 2
		ИЛИ ПустаяСтрока(ЧастиПоСобаке[0])
		ИЛИ СтрНайти(ЧастиПоСобаке[1], ".") = 0
		ИЛИ ЕстьПробелИлиУправляющий(Значение) Тогда
		ВызватьИсключение "Некорректный адрес электронной почты";
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Разрывом считается не только «код меньше 32»: строки заголовка разделяют и NEL, и U+2028/2029.
Функция ЕстьПробелИлиУправляющий(Знач Значение)

	Для НомерСимвола = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, НомерСимвола, 1);
		Код = КодСимвола(Символ);
		Если Символ = " " ИЛИ Код < 32 ИЛИ Код = 127 ИЛИ Код = 133 ИЛИ Код = 160
			ИЛИ Код = 8232 ИЛИ Код = 8233 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта()
	МинДлинаЛогина  = 2;
	МаксДлинаЛогина = 64;
КонецПроцедуры
