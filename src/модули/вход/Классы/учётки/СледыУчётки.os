// Всё, что учётная запись оставляет за собой в слое людей: сессии, ключи доступа, личности
// провайдеров, незакрытые заявки и адресованные ей уведомления.

Перем Сессии;              // ХранилищеСессий (данные)
Перем Токены;              // ХранилищеТокенов (данные)
Перем Личности;            // ХранилищеВнешнихЛичностей (данные)
Перем ЗаявкиНаПароль;      // ХранилищеЗаявокНаПароль (данные)
Перем ЗаявкиПодтверждения; // ХранилищеЗаявокПодтверждения (данные)
Перем УчастникиГрупп;      // ХранилищеУчастниковГрупп (данные)
Перем Уведомления;         // ХранилищеЛичныхУведомлений (данные)
Перем Снятие;              // СнятиеСтрок (данные) — снятие пачки строк со счётом

// Сносит следы учётной записи. Сам Пользователь остаётся: его удаляет вызывающий,
// когда всё связанное уже убрано.
//
// Параметры:
//  ПользовательИдентификатор - Число - учётная запись.
//
// Возвращаемое значение:
//  Структура - сколько чего снято: Сессий, Ключей, Личностей, Заявок, Членств,
//              Уведомлений.
//
Функция Убрать(Знач ПользовательИдентификатор) Экспорт

	Идентификатор = Цел(ПользовательИдентификатор);

	Снято = Новый Структура();
	Снято.Вставить("Сессий", Снятие.СнятьЧерез(Сессии,
		Сессии.ПолучитьПоПользовательИдентификаторРавно(Идентификатор)));
	Снято.Вставить("Ключей", Снятие.СнятьЧерез(Токены,
		Токены.ПолучитьПоПользовательИдентификаторРавно(Идентификатор)));
	Снято.Вставить("Личностей", Снятие.СнятьЧерез(Личности,
		Личности.ПолучитьПоПользовательИдентификаторРавно(Идентификатор)));

	Заявок = Снятие.СнятьЧерез(ЗаявкиНаПароль,
		ЗаявкиНаПароль.ПолучитьПоПользовательИдентификаторРавно(Идентификатор));
	Заявок = Заявок + Снятие.СнятьЧерез(ЗаявкиПодтверждения,
		ЗаявкиПодтверждения.ПолучитьПоПользовательИдентификаторРавно(Идентификатор));
	Снято.Вставить("Заявок", Заявок);

	Снято.Вставить("Членств", СнятьЧленства(Идентификатор));
	// лента адресована учётке: без неё записи стали бы уведомлениями для никого
	Снято.Вставить("Уведомлений", Снятие.СнятьЧерез(Уведомления,
		Уведомления.ЛентаУчётки(Идентификатор)));

	Возврат Снято;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция СнятьЧленства(Знач Идентификатор)
	Возврат Снятие.СнятьЧерез(УчастникиГрупп,
		УчастникиГрупп.ПолучитьПоПользовательИдентификаторРавно(Идентификатор));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеСессий") _Сессии,
	&Пластилин(Значение = "ХранилищеТокенов") _Токены,
	&Пластилин(Значение = "ХранилищеВнешнихЛичностей") _Личности,
	&Пластилин(Значение = "ХранилищеЗаявокНаПароль") _ЗаявкиНаПароль,
	&Пластилин(Значение = "ХранилищеЗаявокПодтверждения") _ЗаявкиПодтверждения,
	&Пластилин(Значение = "ХранилищеУчастниковГрупп") _УчастникиГрупп,
	&Пластилин(Значение = "ХранилищеЛичныхУведомлений") _Уведомления,
	&Пластилин(Значение = "СнятиеСтрок") _Снятие)

	Сессии = _Сессии;
	Токены = _Токены;
	Личности = _Личности;
	ЗаявкиНаПароль = _ЗаявкиНаПароль;
	ЗаявкиПодтверждения = _ЗаявкиПодтверждения;
	УчастникиГрупп = _УчастникиГрупп;
	Уведомления = _Уведомления;
	Снятие = _Снятие;

КонецПроцедуры
