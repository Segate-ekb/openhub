// Задача планировщика «чистка-заявок-cli»: удаление заявок входа CLI с истёкшим сроком.

Перем СервисВхода;  // СервисВходаCLI (вход)
Перем Интервал;     // интервал чистки из настройки, секунды

// Регистрация в планировщике: чистка раз в интервал из настройки.
//
// Параметры:
//  Регистрации - РегистрацииЗадачи - куда записывается регистрация.
//
Процедура Зарегистрировать(Регистрации) Экспорт
	Регистрации.КаждыеСекунд("чистка-заявок-cli", Интервал);
КонецПроцедуры

// Удаляет просроченные заявки входа CLI за один проход.
// Сбой перебрасывается планировщику.
//
&Наблюдаемый("job.cli_device_gc")
Процедура Исполнить() Экспорт
	СервисВхода.УдалитьПросроченные();
КонецПроцедуры

&Прозвище("ЗадачаПланировщика")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисВходаCLI") _СервисВхода,
	&Деталька(Значение = "oshub.jobs.cli_device_gc_interval_sec", ЗначениеПоУмолчанию = 300) _Интервал = Неопределено)

	СервисВхода = _СервисВхода;
	Интервал = Новый ПриведениеЧисел().ЧислоИлиДефолт(_Интервал, 300);

КонецПроцедуры
