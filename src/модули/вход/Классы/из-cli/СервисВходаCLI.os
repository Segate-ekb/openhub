// Вход CLI по device authorization grant (RFC 8628): выдача пары кодов, одобрение человеком
// в браузере, опрос клиентом. Секрет CLI хранится только sha256-хешем.

#Использовать pwhash

Перем Хранилище;      // ХранилищеЗаявокВходаCLI (данные)
Перем СервисТокенов;  // СервисТокенов (auth)
Перем Хеши;           // Хеш (основа)
Перем Контроль;       // КонтрольСимволов (основа)
Перем ЧерезЗапятую;   // СписокЧерезЗапятую (основа)

#Область Параметры

// Срок жизни заявки, секунды.
//
// Возвращаемое значение:
//  Число.
//
Функция СрокЖизниСек() Экспорт
	Возврат 600;
КонецФункции

// Минимальный интервал опроса клиентом, секунды.
//
// Возвращаемое значение:
//  Число.
//
Функция ИнтервалОпросаСек() Экспорт
	Возврат 5;
КонецФункции

// Порог отвергнутых попыток распорядиться заявкой, после которого заявка сгорает.
//
// Возвращаемое значение:
//  Число.
//
Функция ПорогПопыток() Экспорт
	Возврат 5;
КонецФункции

#КонецОбласти

#Область ЖизненныйЦиклЗаявки

// Заводит заявку и выдаёт клиенту пару кодов. Код человека уникален среди живых заявок.
//
// Параметры:
//  ИмяКлиента - Строка - как представился клиент (необязательный, по умолчанию "").
//  Права - Строка - запрошенные скоупы через запятую (необязательный, по умолчанию "read").
//  Момент - Дата - момент выдачи, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Структура - КодУстройства (Строка — секрет клиента, отдаётся один раз),
//              КодПользователя (Строка), Заявка (ЗаявкаВходаCLI).
//
Функция НачатьЗаявку(Знач ИмяКлиента = "", Знач Права = "read", Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);

	Для НомерПопытки = 1 По 10 Цикл
		Код = СгенерироватьКодПользователя();
		Если КодСвободен(Код, Сейчас) Тогда
			Возврат ЗарегистрироватьЗаявку(Код, ИмяКлиента, Права, Сейчас);
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "Не удалось подобрать свободный код входа CLI";

КонецФункции

// Заводит заявку с заданным кодом человека. Занятый код — исключение: уникальность
// кода держит приложение, а не база.
//
// Параметры:
//  КодПользователя - Строка - код в каноничной форме XXXX-XXXX.
//  ИмяКлиента - Строка - как представился клиент.
//  Права - Строка - запрошенные скоупы через запятую.
//  Момент - Дата - момент выдачи, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Структура - КодУстройства (Строка), КодПользователя (Строка), Заявка (ЗаявкаВходаCLI).
//
Функция ЗарегистрироватьЗаявку(Знач КодПользователя, Знач ИмяКлиента, Знач Права,
	Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);

	Код = НормализоватьКод(КодПользователя);
	Если НЕ ЗначениеЗаполнено(Код) Тогда
		ВызватьИсключение "Некорректный код входа CLI";
	КонецЕсли;
	Если НЕ КодСвободен(Код, Сейчас) Тогда
		ВызватьИсключение СтрШаблон("Код входа CLI %1 уже занят", Код);
	КонецЕсли;

	Скоупы = НормализоватьПрава(Права);
	Если НЕ ЗначениеЗаполнено(Скоупы) Тогда
		ВызватьИсключение "Запрошено неизвестное право токена";
	КонецЕсли;

	КодУстройства = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешированиеПаролей.СгенерироватьСоль(32)));

	Заявка = Хранилище.СоздатьЭлемент();
	Заявка.ХешКодаУстройства = Sha256Hex(КодУстройства);
	Заявка.КодПользователя = Код;
	Заявка.ИмяКлиента = ОчиститьИмяКлиента(ИмяКлиента);
	Заявка.Права = Скоупы;
	Заявка.Статус = СтатусОжидание();
	Заявка.ПользовательИдентификатор = 0;
	Заявка.ТокенИдентификатор = 0;
	Заявка.НеудачныхПопыток = 0;
	Заявка.Создана = Сейчас;
	Заявка.Истекает = Сейчас + СрокЖизниСек();
	Заявка.ПоследнийОпрос = '00010101';
	Заявка.Сохранить();

	Результат = Новый Структура();
	Результат.Вставить("КодУстройства", КодУстройства);
	Результат.Вставить("КодПользователя", Код);
	Результат.Вставить("Заявка", Заявка);
	Возврат Результат;

КонецФункции

// Свободен ли код человека: занятым считается код живой (не истёкшей) заявки.
//
// Параметры:
//  КодПользователя - Строка - код в любой форме записи.
//  Момент - Дата - момент проверки, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Булево.
//
Функция КодСвободен(Знач КодПользователя, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Код = НормализоватьКод(КодПользователя);
	Если НЕ ЗначениеЗаполнено(Код) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Заявка Из Хранилище.ПолучитьПоКодПользователяРавно(Код) Цикл
		Если Заявка.Истекает > Сейчас Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Живая заявка по коду человека.
//
// Параметры:
//  КодПользователя - Строка - код в любой форме записи.
//  Момент - Дата - момент проверки, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  ЗаявкаВходаCLI, Неопределено - Неопределено, если код неизвестен или срок вышел.
//
Функция ЖиваяЗаявкаПоКоду(Знач КодПользователя, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Код = НормализоватьКод(КодПользователя);
	Если НЕ ЗначениеЗаполнено(Код) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Заявка Из Хранилище.ПолучитьПоКодПользователяРавно(Код) Цикл
		Если Заявка.Истекает > Сейчас Тогда
			Возврат Заявка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Одобряет заявку от имени пользователя. Токен здесь не выпускается: одобрение только
// фиксирует, кто и что разрешил.
//
// Параметры:
//  КодПользователя - Строка - код в любой форме записи.
//  ПользовательИдентификатор - Число - кто одобряет.
//  Момент - Дата - момент одобрения, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка: "" | "не найдена" | "не в ожидании"),
//              Заявка (ЗаявкаВходаCLI, Неопределено).
//
Функция Одобрить(Знач КодПользователя, Знач ПользовательИдентификатор, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Заявка = ЖиваяЗаявкаПоКоду(КодПользователя, Сейчас);
	Если Заявка = Неопределено Тогда
		Возврат Исход(Ложь, ПричинаНеНайдена(), Неопределено);
	КонецЕсли;
	Если Заявка.Статус <> СтатусОжидание() Тогда
		ЗафиксироватьНеудачу(Заявка);
		Возврат Исход(Ложь, ПричинаНеВОжидании(), Заявка);
	КонецЕсли;

	Заявка.Статус = СтатусОдобрена();
	Заявка.ПользовательИдентификатор = ПользовательИдентификатор;
	Заявка.Сохранить();
	Возврат Исход(Истина, "", Заявка);

КонецФункции

// Отклоняет заявку: статус терминальный, повторное одобрение невозможно.
//
// Параметры:
//  КодПользователя - Строка - код в любой форме записи.
//  Момент - Дата - момент отказа, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка), Заявка (ЗаявкаВходаCLI, Неопределено).
//
Функция Отклонить(Знач КодПользователя, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Заявка = ЖиваяЗаявкаПоКоду(КодПользователя, Сейчас);
	Если Заявка = Неопределено Тогда
		Возврат Исход(Ложь, ПричинаНеНайдена(), Неопределено);
	КонецЕсли;
	Если Заявка.Статус <> СтатусОжидание() Тогда
		ЗафиксироватьНеудачу(Заявка);
		Возврат Исход(Ложь, ПричинаНеВОжидании(), Заявка);
	КонецЕсли;

	Заявка.Статус = СтатусОтклонена();
	Заявка.Сохранить();
	Возврат Исход(Истина, "", Заявка);

КонецФункции

// Считает отвергнутую попытку распорядиться заявкой; на пороге заявка сгорает.
//
// Параметры:
//  Заявка - ЗаявкаВходаCLI - заявка, по которой отвергнута попытка.
//
// Возвращаемое значение:
//  Булево - сгорела ли заявка этой попыткой.
//
Функция ЗафиксироватьНеудачу(Знач Заявка) Экспорт

	Если Заявка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Заявка.НеудачныхПопыток = Цел(?(Заявка.НеудачныхПопыток = Неопределено, 0,
		Заявка.НеудачныхПопыток)) + 1;
	Сгорела = Заявка.НеудачныхПопыток >= ПорогПопыток() И Заявка.Статус = СтатусОжидание();
	Если Сгорела Тогда
		Заявка.Статус = СтатусОтклонена();
	КонецЕсли;
	Заявка.Сохранить();

	Возврат Сгорела;

КонецФункции

// Опрос клиентом: единственное место, где выпускается и отдаётся PAT.
//
// Параметры:
//  КодУстройства - Строка - секрет клиента (device_code).
//  Момент - Дата - момент опроса, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Структура - Статус (Строка: "ожидание" | "часто" | "отклонена" | "истекла" | "выдан"),
//              ЗначениеТокена (Строка — только при "выдан"), Права (Строка),
//              ТокенИдентификатор (Число).
//
Функция Опросить(Знач КодУстройства, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);

	Значение = СокрЛП(Строка(КодУстройства));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат ОтветОпроса("истекла", "", "", 0);
	КонецЕсли;

	Заявка = Хранилище.ПолучитьОдноПоХешКодаУстройстваРавно(Sha256Hex(Значение));
	Если Заявка = Неопределено ИЛИ Заявка.Истекает <= Сейчас Тогда
		Возврат ОтветОпроса("истекла", "", "", 0);
	КонецЕсли;

	ОпрошеноРано = ЗначениеЗаполнено(Заявка.ПоследнийОпрос)
		И Заявка.ПоследнийОпрос + ИнтервалОпросаСек() > Сейчас;
	Заявка.ПоследнийОпрос = Сейчас;
	Заявка.Сохранить();

	Если Заявка.Статус = СтатусОтклонена() Тогда
		Возврат ОтветОпроса("отклонена", "", "", 0);
	КонецЕсли;
	Если Заявка.Статус = СтатусВыдана() Тогда
		Возврат ОтветОпроса("истекла", "", "", 0);
	КонецЕсли;
	Если ОпрошеноРано Тогда
		Возврат ОтветОпроса("часто", "", "", 0);
	КонецЕсли;
	Если Заявка.Статус <> СтатусОдобрена() Тогда
		Возврат ОтветОпроса("ожидание", "", "", 0);
	КонецЕсли;

	Выпуск = СервисТокенов.ВыпуститьТокен(Заявка.ПользовательИдентификатор, Заявка.Права,
		СервисТокенов.СрокПоУмолчаниюДней(), 0, ИмяТокена(Заявка.ИмяКлиента));

	Заявка.Статус = СтатусВыдана();
	Заявка.ТокенИдентификатор = Выпуск.Запись.Идентификатор;
	Заявка.Сохранить();

	Возврат ОтветОпроса("выдан", Выпуск.ЗначениеТокена, Заявка.Права, Выпуск.Запись.Идентификатор);

КонецФункции

// Удаляет заявки с истёкшим сроком — «висящих» одобрений после этого не остаётся.
//
// Параметры:
//  Момент - Дата - граница срока, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Число - сколько заявок удалено.
//
Функция УдалитьПросроченные(Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);

	Удалено = 0;
	Для Каждого Заявка Из Хранилище.ИстёкшиеДо(Сейчас) Цикл
		Хранилище.Удалить(Заявка);
		Удалено = Удалено + 1;
	КонецЦикла;

	Возврат Удалено;

КонецФункции

#КонецОбласти

#Область СтатусыИФормат

// Статус «ждём человека».
//
// Возвращаемое значение:
//  Строка.
//
Функция СтатусОжидание() Экспорт
	Возврат "ожидание";
КонецФункции

// Статус «человек разрешил, токен ещё не забран».
//
// Возвращаемое значение:
//  Строка.
//
Функция СтатусОдобрена() Экспорт
	Возврат "одобрена";
КонецФункции

// Терминальный статус «человек отказал либо заявка сгорела».
//
// Возвращаемое значение:
//  Строка.
//
Функция СтатусОтклонена() Экспорт
	Возврат "отклонена";
КонецФункции

// Терминальный статус «токен выдан клиенту».
//
// Возвращаемое значение:
//  Строка.
//
Функция СтатусВыдана() Экспорт
	Возврат "выдана";
КонецФункции

// Код причины отказа «живой заявки с таким кодом нет».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНеНайдена() Экспорт
	Возврат "не_найдена";
КонецФункции

// Код причины отказа «заявка уже не ждёт решения».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНеВОжидании() Экспорт
	Возврат "не_в_ожидании";
КонецФункции

// Каноничная форма кода человека: XXXX-XXXX из алфавита без двусмысленных знаков.
// Регистр, пробелы и дефисы во вводе значения не имеют.
//
// Параметры:
//  КодПользователя - Строка - код в любой форме записи.
//
// Возвращаемое значение:
//  Строка - каноничный код либо "", если запись кодом не является.
//
Функция НормализоватьКод(Знач КодПользователя) Экспорт

	Значащие = "";
	Исходный = ВРег(СокрЛП(Строка(КодПользователя)));
	Для НомерСимвола = 1 По СтрДлина(Исходный) Цикл
		Символ = Сред(Исходный, НомерСимвола, 1);
		Если СтрНайти(Алфавит(), Символ) > 0 Тогда
			Значащие = Значащие + Символ;
		КонецЕсли;
	КонецЦикла;

	Если СтрДлина(Значащие) <> ДлинаКода() Тогда
		Возврат "";
	КонецЕсли;

	Возврат Лев(Значащие, 4) + "-" + Сред(Значащие, 5);

КонецФункции

// Имя выпускаемого токена по имени клиента.
//
// Параметры:
//  ИмяКлиента - Строка - как представился клиент.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяТокена(Знач ИмяКлиента) Экспорт
	Имя = ОчиститьИмяКлиента(ИмяКлиента);
	Возврат "opm CLI" + ?(ЗначениеЗаполнено(Имя), " — " + Имя, "");
КонецФункции

// Скоупы в каноничном виде: только известные хабу, без повторов и в едином порядке.
//
// Параметры:
//  Права - Строка - запрошенные скоупы через запятую.
//
// Возвращаемое значение:
//  Строка - "read" либо "read,write"; "" — запрошено неизвестное право.
//
Функция НормализоватьПрава(Знач Права) Экспорт

	Запрошено = СокрЛП(Строка(Права));
	Если НЕ ЗначениеЗаполнено(Запрошено) Тогда
		Возврат "read";
	КонецЕсли;

	ЕстьЧтение = Ложь;
	ЕстьЗапись = Ложь;
	Для Каждого Скоуп Из ЧерезЗапятую.Разобрать(Запрошено) Цикл
		Если Скоуп = "read" Тогда
			ЕстьЧтение = Истина;
		ИначеЕсли Скоуп = "write" Тогда
			ЕстьЗапись = Истина;
		Иначе
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЕстьЧтение И НЕ ЕстьЗапись Тогда
		Возврат "read";
	КонецЕсли;

	Возврат ?(ЕстьЗапись, ?(ЕстьЧтение, "read,write", "write"), "read");

КонецФункции

// Имя клиента без управляющих знаков и длиннее разумного: оно попадает и в имя токена,
// и на страницу подтверждения.
//
// Параметры:
//  ИмяКлиента - Строка - как представился клиент.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОчиститьИмяКлиента(Знач ИмяКлиента) Экспорт
	Возврат СокрЛП(Контроль.Очистить(ИмяКлиента, 64));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Алфавит кода без двусмысленных знаков: ни нуля с буквой O, ни единицы с I и L.
Функция Алфавит()
	Возврат "23456789ABCDEFGHJKMNPQRSTUVWXYZ";
КонецФункции

Функция ДлинаКода()
	Возврат 8;
КонецФункции

// Байты вне кратного алфавиту диапазона отбрасываются: иначе первые знаки выпадают чаще.
Функция СгенерироватьКодПользователя()

	Мощность = СтрДлина(Алфавит());
	Предел = Мощность * Цел(256 / Мощность);
	Значащие = "";

	Пока СтрДлина(Значащие) < ДлинаКода() Цикл
		Для Каждого Байт Из Байты(ХешированиеПаролей.СгенерироватьСоль(32)) Цикл
			Если Байт >= Предел Тогда
				Продолжить;
			КонецЕсли;
			Значащие = Значащие + Сред(Алфавит(), Байт % Мощность + 1, 1);
			Если СтрДлина(Значащие) = ДлинаКода() Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Лев(Значащие, 4) + "-" + Сред(Значащие, 5);

КонецФункции

// Значения байт двоичных данных: платформа отдаёт их только hex-строкой.
Функция Байты(Знач ДвоичныеДанные)

	Значения = Новый Массив();
	Hex = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ДвоичныеДанные));

	Позиция = 1;
	Пока Позиция < СтрДлина(Hex) Цикл
		Значения.Добавить(ЦифраHex(Сред(Hex, Позиция, 1)) * 16 + ЦифраHex(Сред(Hex, Позиция + 1, 1)));
		Позиция = Позиция + 2;
	КонецЦикла;

	Возврат Значения;

КонецФункции

Функция ЦифраHex(Знач Символ)
	Возврат СтрНайти("0123456789abcdef", Символ) - 1;
КонецФункции

Функция Sha256Hex(Знач Значение)
	Возврат Хеши.ОтСтроки(Значение);
КонецФункции

Функция Исход(Знач Успех, Знач Причина, Знач Заявка)
	Структура = Новый Структура();
	Структура.Вставить("Успех", Успех);
	Структура.Вставить("Причина", Причина);
	Структура.Вставить("Заявка", Заявка);
	Возврат Структура;
КонецФункции

Функция ОтветОпроса(Знач Статус, Знач ЗначениеТокена, Знач Права, Знач ТокенИдентификатор)
	Структура = Новый Структура();
	Структура.Вставить("Статус", Статус);
	Структура.Вставить("ЗначениеТокена", ЗначениеТокена);
	Структура.Вставить("Права", Права);
	Структура.Вставить("ТокенИдентификатор", ТокенИдентификатор);
	Возврат Структура;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеЗаявокВходаCLI") _Хранилище,
	&Пластилин(Значение = "СервисТокенов") _СервисТокенов,
	&Пластилин(Значение = "Хеш") _Хеши = Неопределено,
	&Пластилин(Значение = "КонтрольСимволов") _Контроль = Неопределено,
	&Пластилин(Значение = "СписокЧерезЗапятую") _ЧерезЗапятую = Неопределено)

	ЧерезЗапятую = ?(_ЧерезЗапятую = Неопределено, Новый СписокЧерезЗапятую(), _ЧерезЗапятую);

	Хранилище = _Хранилище;
	СервисТокенов = _СервисТокенов;
	Хеши = ?(_Хеши = Неопределено, Новый Хеш(), _Хеши);
	Контроль = ?(_Контроль = Неопределено, Новый КонтрольСимволов(), _Контроль);

КонецПроцедуры
