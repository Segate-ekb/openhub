// Ключ доступа, выданный устройству после подтверждения входа.

&Сериализуемое("access_token")
&Заполнено
&Тип("Строка")
Перем Ключ;

&Сериализуемое("token_type")
&Заполнено
&Тип("Строка")
&ОдинИз("Bearer")
Перем ТипКлюча;

&Сериализуемое("scope")
&Заполнено
&Тип("Строка")
&ОдинИз("read", "write", "read,write")
Перем Права;

&Сериализуемое("token_id")
&Заполнено
&Тип("Число")
Перем ИдКлюча;
