// Device authorization grant (RFC 8628) под /api/v1: инициация заявки клиентом и опрос
// до выдачи PAT. Обе точки анонимны — секретом служит device_code.

Перем СервисВхода;      // СервисВходаCLI (auth)
Перем Ответы;           // ОтветыAPI (основа)
Перем ПустыеКуки;       // Куки (winow)
Перем HTTP;             // МетодыHTTP (основа)
Перем Адрес;            // АдресИнстанса (основа)
Перем Заголовки;        // ЗаголовкиHTTP (основа)
Перем Адреса;           // РазборАдреса (основа) — узел из заголовка Host
Перем ПараметрыСсылки;  // ПараметрыСсылки (основа) — параметр запроса на адресе
Перем Ошибки;           // ТекстОшибки (основа) — причина сбоя одной строкой

#Область ТочкиМаршрута

// Вход CLI через браузер: заведение заявки.
//
// Параметры:
//  Ответ - Ответ - ответ winow: 201 с кодами, 400 на неизвестный скоуп, 405 на другой метод.
//  ТелоЗапроса - Строка - тело запроса: client_name, scopes.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса (Host для адреса подтверждения).
//  МетодЗапроса - Строка - HTTP-метод запроса.
//
&ТочкаМаршрута("cli/auth/device", Метод = "post")
&Операция(Сводка = "Заявка входа CLI",
	Описание = "Вход CLI по коду устройства (RFC 8628): разрешение даёт человек в браузере по
	|`verification_uri`. Вход не нужен; отказы — в форме RFC 8628 `{error, error_description}`.")
&Возвращает(Код = 201, Описание = "Код устройства и адрес для браузера")
&Возвращает(Код = 400, Описание = "`invalid_scope`, `invalid_request`")
&Возвращает(Код = 405, Описание = "`invalid_request` — чужой глагол")
Процедура НачалоВхода(Ответ, ТелоЗапроса, ЗаголовкиЗапроса, МетодЗапроса) Экспорт

	Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		ОтветМетодНеРазрешён(Ответ, "POST");
		Возврат;
	КонецЕсли;

	Тело = Ответы.РазобратьТело(ТелоЗапроса, ЗаголовкиЗапроса);
	ИмяКлиента = Ответы.Поле(Тело, "client_name", Ответы.Поле(Тело, "имя_клиента"));
	Права = Ответы.Поле(Тело, "scopes", Ответы.Поле(Тело, "права", "read"));

	Если НЕ ЗначениеЗаполнено(СервисВхода.НормализоватьПрава(Права)) Тогда
		ОшибкаПотока(Ответ, "invalid_scope", "Запрошено неизвестное право: допустимы read и write");
		Возврат;
	КонецЕсли;

	Попытка
		Выдача = СервисВхода.НачатьЗаявку(ИмяКлиента, Права);
	Исключение
		ОшибкаПотока(Ответ, "invalid_request", Ошибки.ДляЧеловека(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	База = БазовыйАдрес(ЗаголовкиЗапроса);
	АдресПодтверждения = База + ПутьПодтверждения();

	Данные = Новый Структура();
	Данные.Вставить("device_code", Выдача.КодУстройства);
	Данные.Вставить("user_code", Выдача.КодПользователя);
	Данные.Вставить("verification_uri", АдресПодтверждения);
	Данные.Вставить("verification_uri_complete",
		СКодомПользователя(АдресПодтверждения, Выдача.КодПользователя));
	Данные.Вставить("expires_in", СервисВхода.СрокЖизниСек());
	Данные.Вставить("interval", СервисВхода.ИнтервалОпросаСек());
	Ответы.JSON(Ответ, 201, Данные);

КонецПроцедуры

// Адрес подтверждения с уже вписанным кодом: человеку остаётся открыть ссылку.
Функция СКодомПользователя(Знач Адрес, Знач Код)
	Возврат ПараметрыСсылки.Установить(Адрес, "user_code", Строка(Код));
КонецФункции

// Вход CLI через браузер: опрос заявки.
//
// Параметры:
//  Ответ - Ответ - ответ winow: 200 с токеном либо 400 с кодом ошибки RFC 8628, 405.
//  ТелоЗапроса - Строка - тело запроса: device_code.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  МетодЗапроса - Строка - HTTP-метод запроса.
//
&ТочкаМаршрута("cli/auth/device/token", Метод = "post")
&Операция(Сводка = "Опрос заявки входа CLI",
	Описание = "Опрос заявки по `device_code`; отказы — в форме RFC 8628. После разрешения выдаёт
	|ключ доступа, один раз.")
&Возвращает(Код = 200, Описание = "Ключ доступа")
&Возвращает(Код = 400, Описание = "`authorization_pending`, `slow_down`, `access_denied`, `expired_token`")
&Возвращает(Код = 405, Описание = "`invalid_request` — чужой глагол")
&Возвращает(Код = 500, Описание = "`server.error` в конверте API — ключ не выпущен")
Процедура ОпросТокена(Ответ, ТелоЗапроса, ЗаголовкиЗапроса, МетодЗапроса) Экспорт

	Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		ОтветМетодНеРазрешён(Ответ, "POST");
		Возврат;
	КонецЕсли;

	Тело = Ответы.РазобратьТело(ТелоЗапроса, ЗаголовкиЗапроса);
	КодУстройства = Ответы.Поле(Тело, "device_code", Ответы.Поле(Тело, "код_устройства"));

	Исход = СервисВхода.Опросить(КодУстройства);

	Если Исход.Статус = "выдан" Тогда
		Данные = Новый Структура();
		Данные.Вставить("access_token", Исход.ЗначениеТокена);
		Данные.Вставить("token_type", "Bearer");
		Данные.Вставить("scope", Исход.Права);
		Данные.Вставить("token_id", Исход.ТокенИдентификатор);
		Ответы.JSON(Ответ, 200, Данные);
		Возврат;
	КонецЕсли;

	ОтветОжидания(Ответ, Исход.Статус);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Адрес страницы подтверждения — её отдаёт КонтроллерПодтвержденияCLI (web-ui).
Функция ПутьПодтверждения()
	Возврат "/cli/login";
КонецФункции

// Коды отказа — из RFC 8628 §3.5: клиент опознаёт их по имени, а не по тексту.
Процедура ОтветОжидания(Ответ, Знач Статус)

	Если Статус = "ожидание" Тогда
		ОшибкаПотока(Ответ, "authorization_pending", "Заявка ещё не подтверждена в браузере");
	ИначеЕсли Статус = "часто" Тогда
		ОшибкаПотока(Ответ, "slow_down", "Опрос чаще разрешённого интервала");
	ИначеЕсли Статус = "отклонена" Тогда
		ОшибкаПотока(Ответ, "access_denied", "Вход отклонён в браузере");
	Иначе
		ОшибкаПотока(Ответ, "expired_token", "Заявка неизвестна, истекла или уже израсходована");
	КонецЕсли;

КонецПроцедуры

// Формат ошибок этого потока задан RFC 8628: плоские error и error_description.
Процедура ОшибкаПотока(Ответ, Знач КодОшибки, Знач Описание, Знач Код = 400)

	Данные = Новый Структура();
	Данные.Вставить("error", КодОшибки);
	Данные.Вставить("error_description", Описание);
	Ответы.JSON(Ответ, Код, Данные);

КонецПроцедуры

// Внешний адрес инсталляции, а при незаданном — узел из заголовка запроса. Заголовок
// пишет клиент, поэтому в адрес идёт РОВНО узел: путь и данные пользователя из него
// отрезает разбор адреса, а не доверие отправителю.
Функция БазовыйАдрес(Знач ЗаголовкиЗапроса)

	Если Адрес.Задан() Тогда
		Возврат Адрес.Базовый();
	КонецЕсли;

	Узел = Адреса.Узел(Заголовки.Текст(ЗаголовкиЗапроса, "Host"));
	Возврат ?(ЗначениеЗаполнено(Узел), "http://" + Узел, "");

КонецФункции

// Ответ 405 тоже в форме потока: клиент разбирает одну структуру ошибки на весь обмен.
Процедура ОтветМетодНеРазрешён(Ответ, Знач Разрешённый)
	Ответ.Заголовки["Allow"] = Разрешённый;
	ОшибкаПотока(Ответ, "invalid_request", СтрШаблон("Разрешены методы: %1", Разрешённый), 405);
КонецПроцедуры

#КонецОбласти

&Контроллер("/api/v1")
&Группа("Ключи доступа")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисВходаCLI") _СервисВхода,
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "Куки") _ПустыеКуки,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "АдресИнстанса") _Адрес,
	&Пластилин(Значение = "ЗаголовкиHTTP") _Заголовки,
	&Пластилин(Значение = "ПараметрыСсылки") _Параметры = Неопределено,
	&Пластилин(Значение = "РазборАдреса") _Адреса = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	СервисВхода = _СервисВхода;
	Ответы = _Ответы;
	ПустыеКуки = _ПустыеКуки;
	HTTP = _HTTP;
	Адрес = _Адрес;
	Заголовки = _Заголовки;
	ПараметрыСсылки = ?(_Параметры = Неопределено, Новый ПараметрыСсылки(), _Параметры);
	Адреса = ?(_Адреса = Неопределено, Новый РазборАдреса(), _Адреса);
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);

КонецПроцедуры
