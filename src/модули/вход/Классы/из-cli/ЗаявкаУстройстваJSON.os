// Заявка входа с устройства: коды и адрес подтверждения в браузере.

&Сериализуемое("device_code")
&Заполнено
&Тип("Строка")
Перем КодУстройства;

&Сериализуемое("user_code")
&Заполнено
&Тип("Строка")
Перем КодПользователя;

&Сериализуемое("verification_uri")
&Заполнено
&Тип("Строка")
Перем АдресПодтверждения;

&Сериализуемое("verification_uri_complete")
&Заполнено
&Тип("Строка")
Перем АдресПодтвержденияСКодом;

&Сериализуемое("expires_in")
&Заполнено
&Тип("Число")
Перем ЖивётСекунд;

&Сериализуемое("interval")
&Заполнено
&Тип("Число")
Перем ИнтервалОпроса;
