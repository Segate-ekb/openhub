// Модель серверной сессии: идентификатор, данные, времена создания и доступа, TTL,
// признак завершения. В данных живёт ключ «пользователь».

Перем ИдентификаторСессии;
Перем ЗначенияСессии;
Перем СозданаВ;
Перем ПоследнийДоступВ;
Перем СрокЖизниСекунд;
Перем СессияЗавершена;
Перем ТекстыJSON;   // ТекстJSON (основа) — формат хранимого снимка

Процедура ПриСозданииОбъекта(Идентификатор = Неопределено, Данные = Неопределено,
	МоментСоздания = Неопределено, ТТЛСекунд = Неопределено)

	ИдентификаторСессии = ?(Идентификатор = Неопределено, "", Идентификатор);
	ЗначенияСессии      = ?(Данные = Неопределено, Новый Соответствие, Данные);
	СозданаВ            = ?(МоментСоздания = Неопределено, '00010101', МоментСоздания);
	ПоследнийДоступВ    = СозданаВ;
	СрокЖизниСекунд     = ?(ТТЛСекунд = Неопределено, 0, ТТЛСекунд);
	СессияЗавершена     = Ложь;
	ТекстыJSON          = Новый ТекстJSON();

КонецПроцедуры

// Идентификатор сессии.
//
// Возвращаемое значение:
//  Строка.
//
Функция Идентификатор() Экспорт
	Возврат ИдентификаторСессии;
КонецФункции

// Данные сессии.
//
// Возвращаемое значение:
//  Соответствие - строковый ключ → JSON-значение.
//
Функция Данные() Экспорт
	Возврат ЗначенияСессии;
КонецФункции

// Срок жизни сессии.
//
// Возвращаемое значение:
//  Число - секунды.
//
Функция ТТЛСекунд() Экспорт
	Возврат СрокЖизниСекунд;
КонецФункции

// Завершена ли сессия явным выходом.
//
// Возвращаемое значение:
//  Булево.
//
Функция Завершена() Экспорт
	Возврат СессияЗавершена;
КонецФункции

// Дедлайн сессии: время последнего доступа плюс TTL. Производное значение для
// индексируемой колонки, по которой идёт очистка недействительных.
//
// Возвращаемое значение:
//  Дата - UTC.
//
Функция Дедлайн() Экспорт
	Возврат ПоследнийДоступВ + СрокЖизниСекунд;
КонецФункции

// Значение ключа данных сессии.
//
// Параметры:
//  Ключ - Строка - имя ключа.
//  ПоУмолчанию - Произвольный - значение при отсутствии ключа
//                (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Произвольный.
//
Функция Значение(Знач Ключ, Знач ПоУмолчанию = Неопределено) Экспорт
	Результат = ЗначенияСессии.Получить(Ключ);
	Возврат ?(Результат = Неопределено, ПоУмолчанию, Результат);
КонецФункции

// Устанавливает значение ключа данных сессии.
//
// Параметры:
//  Ключ - Строка - имя ключа.
//  ЗначениеКлюча - Произвольный - сохраняемое значение.
//
Процедура УстановитьЗначение(Знач Ключ, Знач ЗначениеКлюча) Экспорт
	ЗначенияСессии.Вставить(Ключ, ЗначениеКлюча);
КонецПроцедуры

// Сдвигает время последнего доступа (скользящее продление).
//
// Параметры:
//  Момент - Дата - новый момент доступа, UTC.
//
Процедура ОбновитьВремяДоступа(Знач Момент) Экспорт
	ПоследнийДоступВ = Момент;
КонецПроцедуры

// Помечает сессию завершённой.
//
Процедура Завершить() Экспорт
	СессияЗавершена = Истина;
КонецПроцедуры

// Просрочена ли сессия; момент, равный дедлайну, уже считается просрочкой.
//
// Параметры:
//  Момент - Дата - проверяемый момент, UTC.
//
// Возвращаемое значение:
//  Булево.
//
Функция Просрочена(Знач Момент) Экспорт
	Возврат Момент >= ПоследнийДоступВ + СрокЖизниСекунд;
КонецФункции

// Действительна ли сессия: не завершена и не просрочена.
//
// Параметры:
//  Момент - Дата - проверяемый момент, UTC.
//
// Возвращаемое значение:
//  Булево.
//
Функция Действительна(Знач Момент) Экспорт
	Возврат НЕ СессияЗавершена И НЕ Просрочена(Момент);
КонецФункции

// Копия сессии с новым идентификатором и свежим временем доступа — защита от
// фиксации сессии; данные, TTL и время создания сохраняются.
//
// Параметры:
//  НовыйИдентификатор - Строка - идентификатор копии.
//  Момент - Дата - момент перевыпуска, UTC.
//
// Возвращаемое значение:
//  СессияХаба.
//
Функция Перевыпущенная(Знач НовыйИдентификатор, Знач Момент) Экспорт
	Копия = Новый СессияХаба(НовыйИдентификатор, ЗначенияСессии, СозданаВ, СрокЖизниСекунд);
	Копия.ОбновитьВремяДоступа(Момент);
	Возврат Копия;
КонецФункции

// Сериализация в формат хранения. Снимок пишется С ПЕРЕНОСАМИ намеренно: так он лёг
// в хранилище сессий с самого начала, и формат хранения этой правкой не меняется.
//
// Возвращаемое значение:
//  Строка - JSON.
//
Функция ВСтрокуJSON() Экспорт

	Представление = Новый Структура;
	Представление.Вставить("формат", ВерсияФормата());
	Представление.Вставить("ид", ИдентификаторСессии);
	Представление.Вставить("данные", ЗначенияСессии);
	Представление.Вставить("создана", XMLСтрока(СозданаВ));
	Представление.Вставить("доступ", XMLСтрока(ПоследнийДоступВ));
	Представление.Вставить("ттл", СрокЖизниСекунд);
	Представление.Вставить("завершена", СессияЗавершена);

	Возврат ТекстыJSON.СПереносами(Представление);

КонецФункции

// Восстанавливает состояние из JSON. Любое несоответствие формату — исключение;
// хранилище трактует его как повреждённую запись (fail-closed).
//
// Параметры:
//  СтрокаJSON - Строка - сериализованная сессия.
//
Процедура ЗаполнитьИзСтрокиJSON(Знач СтрокаJSON) Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Представление = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Если ТипЗнч(Представление) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Сериализованная сессия не является объектом JSON";
	КонецЕсли;

	Формат = Представление.Получить("формат");
	Если ТипЗнч(Формат) <> Тип("Число") ИЛИ Формат <> ВерсияФормата() Тогда
		ВызватьИсключение "Неподдерживаемая версия формата сериализованной сессии";
	КонецЕсли;

	Идентификатор = Представление.Получить("ид");
	Если ТипЗнч(Идентификатор) <> Тип("Строка") ИЛИ ПустаяСтрока(Идентификатор) Тогда
		ВызватьИсключение "В сериализованной сессии нет корректного идентификатора";
	КонецЕсли;

	Данные = Представление.Получить("данные");
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		ВызватьИсключение "В сериализованной сессии нет корректных данных";
	КонецЕсли;

	ТТЛ = Представление.Получить("ттл");
	Если ТипЗнч(ТТЛ) <> Тип("Число") ИЛИ ТТЛ <= 0 Тогда
		ВызватьИсключение "В сериализованной сессии нет корректного TTL";
	КонецЕсли;

	Завершена = Представление.Получить("завершена");
	Если ТипЗнч(Завершена) <> Тип("Булево") Тогда
		ВызватьИсключение "В сериализованной сессии нет корректного признака завершения";
	КонецЕсли;

	ИдентификаторСессии = Идентификатор;
	ЗначенияСессии      = Данные;
	СозданаВ            = ПрочитатьДату(Представление, "создана");
	ПоследнийДоступВ    = ПрочитатьДату(Представление, "доступ");
	СрокЖизниСекунд     = ТТЛ;
	СессияЗавершена     = Завершена;

КонецПроцедуры

Функция ВерсияФормата()
	Возврат 1;
КонецФункции

Функция ПрочитатьДату(Знач Представление, Знач Ключ)

	// ПрочитатьJSON сам приводит строки ISO 8601 к типу Дата — допустимы оба типа
	Значение = Представление.Получить(Ключ);

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ВызватьИсключение СтрШаблон("В сериализованной сессии нет корректного поля '%1'", Ключ);
	КонецЕсли;

	Попытка
		Возврат XMLЗначение(Тип("Дата"), Значение);
	Исключение
		ВызватьИсключение СтрШаблон("Некорректная дата в поле '%1' сериализованной сессии", Ключ);
	КонецПопытки;

КонецФункции
