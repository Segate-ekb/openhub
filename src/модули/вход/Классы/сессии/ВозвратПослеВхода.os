// Адрес, куда вернуть человека после входа: проверка «это путь этого хаба»
// и вплетение проверенного пути в ссылки на вход, регистрацию и провайдера.

Перем ПараметрыСсылки;  // ПараметрыСсылки (основа) — параметр запроса на адресе

// Куда уходит человек, если возврат не задан или не принят.
//
// Возвращаемое значение:
//  Строка - путь кабинета.
//
Функция ПутьПоУмолчанию() Экспорт
	Возврат "/me";
КонецФункции

// Имя параметра и поля формы, в котором едет адрес возврата.
//
// Возвращаемое значение:
//  Строка - имя параметра.
//
Функция ИмяПараметра() Экспорт
	Возврат "next";
КонецФункции

// Проверенный адрес возврата. Принимается только путь этого хаба: адрес чужого узла,
// «//узел» и обратный слеш увели бы человека с хаба чужой ссылкой (open redirect).
// Проверять обязан и тот, кто принимает адрес, и тот, кто отдаёт его из хранилища.
//
// Двоеточие в пути не запрещаем: авторитет в относительной ссылке начинается только
// с «//», а «/search?q=время:обед» и «/pool:tag» — обычные адреса этого хаба.
//
// Параметры:
//  АдресВозврата - Строка - адрес возврата из запроса, формы или серверной транзакции.
//  Отвергнутый - Строка - куда уводить непринятый адрес: у входа это кабинет, у смены
//                темы — корень хаба (необязательный, по умолчанию "" — ПутьПоУмолчанию()).
//
// Возвращаемое значение:
//  Строка - путь этого хаба либо Отвергнутый.
//
Функция Путь(Знач АдресВозврата, Знач Отвергнутый = "") Экспорт

	Запасной = ?(ЗначениеЗаполнено(Отвергнутый), Отвергнутый, ПутьПоУмолчанию());
	НормализованныйПуть = СокрЛП(Строка(?(АдресВозврата = Неопределено, "", АдресВозврата)));

	Если НЕ СтрНачинаетсяС(НормализованныйПуть, "/") ИЛИ СтрНачинаетсяС(НормализованныйПуть, "//") Тогда
		Возврат Запасной;
	КонецЕсли;

	// длину режем до разбора: адрес пришёл от анонима и оседает в серверной транзакции
	Если СтрДлина(НормализованныйПуть) > ПределДлины() Тогда
		Возврат Запасной;
	КонецЕсли;

	Для НомерСимвола = 1 По СтрДлина(НормализованныйПуть) Цикл
		Символ = Сред(НормализованныйПуть, НомерСимвола, 1);
		Если КодСимвола(Символ) < 32 ИЛИ Символ = "\" ИЛИ Символ = """" Тогда
			Возврат Запасной;
		КонецЕсли;
	КонецЦикла;

	Возврат НормализованныйПуть;

КонецФункции

// Предельная длина адреса возврата: больше ни один осмысленный путь хаба не занимает,
// а анонимный запрос кладёт этот адрес в серверную транзакцию.
//
// Возвращаемое значение:
//  Число - предел в знаках.
//
Функция ПределДлины() Экспорт
	Возврат 2048;
КонецФункции

// Просит ли адрес особого возврата — не в кабинет. Ложь и для незаданного, и для
// отвергнутого адреса: ни тот, ни другой в ссылках и полях формы не нужен.
//
// Параметры:
//  АдресВозврата - Строка - адрес возврата.
//
// Возвращаемое значение:
//  Булево.
//
Функция Задан(Знач АдресВозврата) Экспорт
	Возврат Путь(АдресВозврата) <> ПутьПоУмолчанию();
КонецФункции

// Адрес с прицепленным возвратом: по такой ссылке человек уходит на вход,
// регистрацию или к провайдеру, не теряя, куда он шёл. Отвергнутый адрес
// не прицепляется вовсе.
//
// Параметры:
//  Адрес - Строка - путь этого хаба, к которому цепляется возврат.
//  АдресВозврата - Строка - адрес возврата.
//
// Возвращаемое значение:
//  Строка - адрес с параметром возврата либо исходный адрес.
//
Функция СВозвратом(Знач Адрес, Знач АдресВозврата) Экспорт

	Если НЕ Задан(АдресВозврата) Тогда
		Возврат Строка(Адрес);
	КонецЕсли;

	// параметр ставится НА АДРЕС, а не приклеивается к строке: разделитель выбирать
	// не приходится, и второго «?» в ссылке не появляется
	Возврат ПараметрыСсылки.Установить(Адрес, ИмяПараметра(), Путь(АдресВозврата));

КонецФункции

// Адрес страницы входа с возвратом. Зовут её те страницы, которые сами знают, куда
// вернуть человека; гвард кабинета своего пути не знает и уводит анонима на голый /login.
//
// Параметры:
//  АдресВозврата - Строка - куда вернуть человека после входа.
//
// Возвращаемое значение:
//  Строка - адрес страницы входа.
//
Функция АдресВхода(Знач АдресВозврата) Экспорт
	Возврат СВозвратом(ПутьВхода(), АдресВозврата);
КонецФункции

// Путь страницы входа — один литерал на весь хаб.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПутьВхода() Экспорт
	Возврат "/login";
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ПараметрыСсылки") _Параметры = Неопределено) Экспорт
	ПараметрыСсылки = ?(_Параметры = Неопределено, Новый ПараметрыСсылки(), _Параметры);
КонецПроцедуры
