// Адрес, куда вернуть человека после входа: проверка «это путь этого хаба»
// и вплетение проверенного пути в ссылки на вход, регистрацию и провайдера.

// Куда уходит человек, если возврат не задан или не принят.
//
// Возвращаемое значение:
//  Строка - путь кабинета.
//
Функция ПутьПоУмолчанию() Экспорт
	Возврат "/me";
КонецФункции

// Имя параметра и поля формы, в котором едет адрес возврата.
//
// Возвращаемое значение:
//  Строка - имя параметра.
//
Функция ИмяПараметра() Экспорт
	Возврат "next";
КонецФункции

// Проверенный адрес возврата. Принимается только путь этого хаба: адрес чужого узла,
// «//узел» и обратный слеш увели бы человека с хаба чужой ссылкой (open redirect).
// Проверять обязан и тот, кто принимает адрес, и тот, кто отдаёт его из хранилища.
//
// Двоеточие в пути не запрещаем: авторитет в относительной ссылке начинается только
// с «//», а «/search?q=время:обед» и «/pool:tag» — обычные адреса этого хаба.
//
// Параметры:
//  Возврат_ - Строка - адрес возврата из запроса, формы или серверной транзакции.
//
// Возвращаемое значение:
//  Строка - путь этого хаба либо ПутьПоУмолчанию().
//
Функция Путь(Знач Возврат_) Экспорт

	Путь_ = СокрЛП(Строка(?(Возврат_ = Неопределено, "", Возврат_)));

	Если НЕ СтрНачинаетсяС(Путь_, "/") ИЛИ СтрНачинаетсяС(Путь_, "//") Тогда
		Возврат ПутьПоУмолчанию();
	КонецЕсли;

	// длину режем до разбора: адрес пришёл от анонима и оседает в серверной транзакции
	Если СтрДлина(Путь_) > ПределДлины() Тогда
		Возврат ПутьПоУмолчанию();
	КонецЕсли;

	Для НомерСимвола = 1 По СтрДлина(Путь_) Цикл
		Символ = Сред(Путь_, НомерСимвола, 1);
		Если КодСимвола(Символ) < 32 ИЛИ Символ = "\" ИЛИ Символ = """" Тогда
			Возврат ПутьПоУмолчанию();
		КонецЕсли;
	КонецЦикла;

	Возврат Путь_;

КонецФункции

// Предельная длина адреса возврата: больше ни один осмысленный путь хаба не занимает,
// а анонимный запрос кладёт этот адрес в серверную транзакцию.
//
// Возвращаемое значение:
//  Число - предел в знаках.
//
Функция ПределДлины() Экспорт
	Возврат 2048;
КонецФункции

// Просит ли адрес особого возврата — не в кабинет. Ложь и для незаданного, и для
// отвергнутого адреса: ни тот, ни другой в ссылках и полях формы не нужен.
//
// Параметры:
//  Возврат_ - Строка - адрес возврата.
//
// Возвращаемое значение:
//  Булево.
//
Функция Задан(Знач Возврат_) Экспорт
	Возврат Путь(Возврат_) <> ПутьПоУмолчанию();
КонецФункции

// Адрес с прицепленным возвратом: по такой ссылке человек уходит на вход,
// регистрацию или к провайдеру, не теряя, куда он шёл. Отвергнутый адрес
// не прицепляется вовсе.
//
// Параметры:
//  Адрес - Строка - путь этого хаба, к которому цепляется возврат.
//  Возврат_ - Строка - адрес возврата.
//
// Возвращаемое значение:
//  Строка - адрес с параметром возврата либо исходный адрес.
//
Функция СВозвратом(Знач Адрес, Знач Возврат_) Экспорт

	Если НЕ Задан(Возврат_) Тогда
		Возврат Строка(Адрес);
	КонецЕсли;

	Разделитель = ?(СтрНайти(Строка(Адрес), "?") > 0, "&", "?");
	Возврат Строка(Адрес) + Разделитель + ИмяПараметра() + "="
		+ КодироватьСтроку(Путь(Возврат_), СпособКодированияСтроки.КодировкаURL);

КонецФункции

// Адрес страницы входа с возвратом. Зовут её те страницы, которые сами знают, куда
// вернуть человека; гвард кабинета своего пути не знает и уводит анонима на голый /login.
//
// Параметры:
//  Возврат_ - Строка - куда вернуть человека после входа.
//
// Возвращаемое значение:
//  Строка - адрес страницы входа.
//
Функция АдресВхода(Знач Возврат_) Экспорт
	Возврат СВозвратом(ПутьВхода(), Возврат_);
КонецФункции

// Путь страницы входа — один литерал на весь хаб.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПутьВхода() Экспорт
	Возврат "/login";
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
