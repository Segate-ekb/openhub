// Хранилище сессий — репозиторий сущности «ВебСессия»; обслуживает ХранилищеСессийБД.

// BSLLS:UnusedParameters-off

Перем Сам;   // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё

// Сессия по идентификатору.
//
// Параметры:
//  Идентификатор - Строка - идентификатор сессии.
//
// Возвращаемое значение:
//  ВебСессия, Неопределено.
//
&МетодЗапроса
Функция ПолучитьОдноПоИдентификаторРавно(Идентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Сессии пользователя: по ним снимаются его следы при удалении учётки.
//
// Параметры:
//  ПользовательИдентификатор - Число - идентификатор владельца сессий.
//
// Возвращаемое значение:
//  Массив из ВебСессия.
//
&МетодЗапроса
Функция ПолучитьПоПользовательИдентификаторРавно(ПользовательИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Сессии с заданным признаком завершения.
//
// Параметры:
//  Завершена - Булево - искомое значение признака.
//
// Возвращаемое значение:
//  Массив из ВебСессия.
//
&МетодЗапроса
Функция ПолучитьПоЗавершенаРавно(Завершена) Экспорт
	Возврат Неопределено;
КонецФункции

// Сессии, дедлайн которых не позже границы.
//
// Параметры:
//  Граница - Дата - универсальное время.
//
// Возвращаемое значение:
//  Массив из ВебСессия.
//
&МетодЗапроса
Функция ПолучитьПоИстекаетМеньшеИлиРавно(Граница) Экспорт
	Возврат Неопределено;
КонецФункции

// Вся таблица сессий без отбора.
//
// Возвращаемое значение:
//  Массив из ВебСессия.
//
&МетодЗапроса
Функция ПолучитьПо() Экспорт
	Возврат Неопределено;
КонецФункции

// Все сессии.
//
// Возвращаемое значение:
//  Массив из ВебСессия.
//
Функция Все() Экспорт
	Возврат Сам.Достать().ПолучитьПо();
КонецФункции

// Недействительные сессии на момент: завершённые ИЛИ с дедлайном <= момент.
//
// Параметры:
//  Момент - Дата - универсальное время.
//
// Возвращаемое значение:
//  Массив из ВебСессия - объединение без дублей.
//
&Наблюдаемый
Функция НедействительныеДо(Знач Момент) Экспорт

	Результат = Новый Массив();
	ВиденныеИд = Новый Соответствие();

	Для Каждого Сессия Из Сам.Достать().ПолучитьПоЗавершенаРавно(Истина) Цикл
		Если ВиденныеИд.Получить(Сессия.Идентификатор) = Неопределено Тогда
			ВиденныеИд.Вставить(Сессия.Идентификатор, Истина);
			Результат.Добавить(Сессия);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Сессия Из Сам.Достать().ПолучитьПоИстекаетМеньшеИлиРавно(Момент) Цикл
		Если ВиденныеИд.Получить(Сессия.Идентификатор) = Неопределено Тогда
			ВиденныеИд.Вставить(Сессия.Идентификатор, Истина);
			Результат.Добавить(Сессия);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&ХранилищеСущностей("ВебСессия")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеСессий") _Сам)

	Сам = _Сам;

КонецПроцедуры
