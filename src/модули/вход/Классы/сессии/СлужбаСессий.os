// Жизненный цикл серверных сессий поверх БД: TTL со скользящим продлением,
// ленивое удаление недействительных, перевыпуск идентификатора.
// Имя `МенеджерСессий` занято классом winow — отсюда `СлужбаСессий`.
// Идентификатор — 64 hex-символа из крипто-стойких байт pwhash; встроенный
// ГенераторСлучайныхЧисел не крипто-стойкий и здесь не годится.
// TTL читается у резолвера настроек в момент создания сессии, поэтому правка действует
// без рестарта; уже выданные сессии живут со своим TTL.

#Использовать pwhash

Перем Хранилище;     // ХранилищеСессийБД (auth)
Перем Настройки;     // СервисНастроек (настройки)

// Создаёт и сохраняет сессию пользователя. Неположительный TTL — исключение.
//
// Параметры:
//  ПользовательИдентификатор - Число - владелец сессии.
//  Данные - Соответствие - дополнительные данные сессии
//           (необязательный, по умолчанию Неопределено — пустое соответствие).
//  ТТЛСекунд - Число - срок жизни (необязательный, по умолчанию из настроек хаба).
//  Момент - Дата - момент создания, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  СессияХаба.
//
Функция Создать(Знач ПользовательИдентификатор, Знач Данные = Неопределено,
	Знач ТТЛСекунд = Неопределено, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	ТТЛ = ?(ТТЛСекунд = Неопределено, Настройки.Значение("oshub.auth.session.ttlseconds"), ТТЛСекунд);
	ПроверитьТТЛ(ТТЛ);

	ДанныеСессии = ?(Данные = Неопределено, Новый Соответствие, Данные);
	ДанныеСессии.Вставить("пользователь", ПользовательИдентификатор);

	Сессия = Новый СессияХаба(СгенерироватьИдентификатор(), ДанныеСессии, Сейчас, ТТЛ);
	Хранилище.Записать(Сессия);
	Возврат Сессия;

КонецФункции

// Действительная сессия по идентификатору; сдвигает дедлайн скользящим продлением.
// Просроченная и завершённая сессии неотличимы от отсутствующей и лениво удаляются.
//
// Параметры:
//  Идентификатор - Строка - идентификатор сессии.
//  Момент - Дата - момент обращения, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  СессияХаба, Неопределено.
//
Функция Получить(Знач Идентификатор, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);

	Сессия = Хранилище.Прочитать(Идентификатор);
	Если Сессия = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ Сессия.Действительна(Сейчас) Тогда
		Хранилище.Удалить(Сессия.Идентификатор());
		Возврат Неопределено;
	КонецЕсли;

	Сессия.ОбновитьВремяДоступа(Сейчас);
	Хранилище.Записать(Сессия);
	Возврат Сессия;

КонецФункции

// Сохраняет изменённые данные сессии.
//
// Параметры:
//  Сессия - СессияХаба - изменённая сессия.
//
Процедура Сохранить(Знач Сессия) Экспорт
	Хранилище.Записать(Сессия);
КонецПроцедуры

// Завершает сессию; признак завершения сохраняется в хранилище.
//
// Параметры:
//  Идентификатор - Строка - идентификатор сессии.
//  Момент - Дата - момент выхода, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Булево - была ли найдена действительная сессия.
//
Функция Завершить(Знач Идентификатор, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Сессия = Хранилище.Прочитать(Идентификатор);
	Если Сессия = Неопределено Или НЕ Сессия.Действительна(Сейчас) Тогда
		Возврат Ложь;
	КонецЕсли;
	Сессия.Завершить();
	Хранилище.Записать(Сессия);
	Возврат Истина;

КонецФункции

// Завершает все сессии того же пользователя, кроме указанной — «выйти на других
// устройствах».
//
// Параметры:
//  Идентификатор - Строка - сохраняемая сессия.
//  Момент - Дата - момент выхода, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Число - сколько сессий завершено.
//
Функция ЗавершитьВсеКроме(Знач Идентификатор, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Сохраняемая = Получить(Идентификатор, Сейчас);
	Если Сохраняемая = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	ПользовательИд = Сохраняемая.Значение("пользователь");
	Если ПользовательИд = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Завершено = 0;
	Для Каждого Сессия Из Хранилище.СессииСоЗначением("пользователь", ПользовательИд) Цикл
		Если ИдентификаторыСовпадают(Сессия.Идентификатор(), Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ Сессия.Действительна(Сейчас) Тогда
			Продолжить;
		КонецЕсли;
		Сессия.Завершить();
		Хранилище.Записать(Сессия);
		Завершено = Завершено + 1;
	КонецЦикла;
	Возврат Завершено;

КонецФункции

// Перевыпускает сессию: новый идентификатор, те же данные и TTL. Вызывать сразу после
// успешной аутентификации — защита от фиксации сессии.
//
// Параметры:
//  Идентификатор - Строка - идентификатор текущей сессии.
//  Момент - Дата - момент перевыпуска, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  СессияХаба, Неопределено - Неопределено, если сессия недействительна.
//
Функция Перевыпустить(Знач Идентификатор, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Сессия = Хранилище.Прочитать(Идентификатор);
	Если Сессия = Неопределено Или НЕ Сессия.Действительна(Сейчас) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Новая = Сессия.Перевыпущенная(СгенерироватьИдентификатор(), Сейчас);
	Хранилище.Записать(Новая);
	Хранилище.Удалить(Сессия.Идентификатор());
	Возврат Новая;

КонецФункции

// Удаляет все недействительные сессии — точка входа фоновой очистки.
//
// Параметры:
//  Момент - Дата - момент очистки, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Число - сколько сессий удалено.
//
Функция УдалитьПросроченные(Знач Момент = Неопределено) Экспорт
	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Возврат Хранилище.УдалитьНедействительные(Сейчас);
КонецФункции

Функция СгенерироватьИдентификатор()
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешированиеПаролей.СгенерироватьСоль(32)));
КонецФункции

// Сравнение идентификаторов без раннего выхода — защита от timing-атаки.
Функция ИдентификаторыСовпадают(Знач Ид1, Знач Ид2)

	С1 = Строка(Ид1);
	С2 = Строка(Ид2);
	Если СтрДлина(С1) <> СтрДлина(С2) Тогда
		Возврат Ложь;
	КонецЕсли;
	Расхождение = 0;
	Для НомерСимвола = 1 По СтрДлина(С1) Цикл
		Если Сред(С1, НомерСимвола, 1) <> Сред(С2, НомерСимвола, 1) Тогда
			Расхождение = Расхождение + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Расхождение = 0;

КонецФункции

Процедура ПроверитьТТЛ(Знач ТТЛСекунд)
	Если ТипЗнч(ТТЛСекунд) <> Тип("Число") Или ТТЛСекунд <= 0 Тогда
		ВызватьИсключение "TTL сессии должен быть положительным числом секунд";
	КонецЕсли;
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеСессийБД") _Хранилище,
	&Пластилин(Значение = "СервисНастроек") _Настройки)

	Хранилище = _Хранилище;
	Настройки = _Настройки;

КонецПроцедуры
