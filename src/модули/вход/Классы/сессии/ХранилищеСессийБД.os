// БД-бэкенд хранилища сессий: полное состояние пишется JSON-строкой, дедлайн, признак
// завершения и пользователь дублируются в колонки под запрос. На битой записи fail-closed.

Перем Хранилище;   // ХранилищеСессий (данные)

// Вставка или полная замена записи по идентификатору.
// Небезопасный идентификатор (не 64 hex-символа) — исключение.
//
// Параметры:
//  Сессия - СессияХаба - сохраняемая сессия.
//
Процедура Записать(Знач Сессия) Экспорт

	Ид = Сессия.Идентификатор();
	Если НЕ ИдентификаторБезопасен(Ид) Тогда
		ВызватьИсключение "Небезопасный идентификатор сессии";
	КонецЕсли;

	Запись = Хранилище.ПолучитьОдноПоИдентификаторРавно(Ид);
	Если Запись = Неопределено Тогда
		Запись = Хранилище.СоздатьЭлемент();
		Запись.Идентификатор = Ид;
	КонецЕсли;

	ПользовательИд = Сессия.Значение("пользователь");
	Запись.ПользовательИдентификатор = ?(ТипЗнч(ПользовательИд) = Тип("Число"), ПользовательИд, 0);
	Запись.ДанныеJSON = Сессия.ВСтрокуJSON();
	Запись.Истекает = Сессия.Дедлайн();
	Запись.Завершена = Сессия.Завершена();
	Запись.Сохранить();

КонецПроцедуры

// Читает сессию по идентификатору. Повреждённая и рассогласованная с ключом запись
// удаляется и считается отсутствующей.
//
// Параметры:
//  Идентификатор - Строка - идентификатор сессии.
//
// Возвращаемое значение:
//  СессияХаба, Неопределено.
//
Функция Прочитать(Знач Идентификатор) Экспорт

	Если НЕ ИдентификаторБезопасен(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запись = Хранилище.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
	Если Запись = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сессия = ВосстановитьИзЗаписи(Запись);
	Если Сессия = Неопределено Тогда
		Хранилище.Удалить(Запись);
		Возврат Неопределено;
	КонецЕсли;

	Если Сессия.Идентификатор() <> Идентификатор Тогда
		Хранилище.Удалить(Запись);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Сессия;

КонецФункции

// Удаляет запись сессии; отсутствие записи ошибкой не считается.
//
// Параметры:
//  Идентификатор - Строка - идентификатор сессии.
//
Процедура Удалить(Знач Идентификатор) Экспорт

	Если НЕ ИдентификаторБезопасен(Идентификатор) Тогда
		Возврат;
	КонецЕсли;
	Запись = Хранилище.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
	Если Запись <> Неопределено Тогда
		Хранилище.Удалить(Запись);
	КонецЕсли;

КонецПроцедуры

// Все читаемые сессии; повреждённые пропускаются.
//
// Возвращаемое значение:
//  Массив из СессияХаба.
//
Функция ВсеСессии() Экспорт

	Результат = Новый Массив();
	Для Каждого Запись Из Хранилище.Все() Цикл
		Сессия = ВосстановитьИзЗаписи(Запись);
		Если Сессия <> Неопределено Тогда
			Результат.Добавить(Сессия);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Удаляет завершённые и просроченные на момент сессии индексированным запросом,
// без полного перебора.
//
// Параметры:
//  Момент - Дата - момент очистки, UTC.
//
// Возвращаемое значение:
//  Число - сколько записей удалено.
//
Функция УдалитьНедействительные(Знач Момент) Экспорт

	Удалено = 0;
	Для Каждого Запись Из Хранилище.НедействительныеДо(Момент) Цикл
		Хранилище.Удалить(Запись);
		Удалено = Удалено + 1;
	КонецЦикла;
	Возврат Удалено;

КонецФункции

// Сессии, у которых данные по ключу равны значению. Ключ «пользователь» идёт
// индексированным запросом, прочие ключи — полным перебором с фильтрацией у вызывающего.
//
// Параметры:
//  КлючДанных - Строка - имя ключа данных сессии.
//  Значение - Произвольный - искомое значение.
//
// Возвращаемое значение:
//  Массив из СессияХаба.
//
Функция СессииСоЗначением(Знач КлючДанных, Знач Значение) Экспорт

	Результат = Новый Массив();

	Если КлючДанных = "пользователь" И ТипЗнч(Значение) = Тип("Число") Тогда
		Записи = Хранилище.ПолучитьПоПользовательИдентификаторРавно(Значение);
	Иначе
		Возврат ВсеСессии();
	КонецЕсли;

	Для Каждого Запись Из Записи Цикл
		Сессия = ВосстановитьИзЗаписи(Запись);
		Если Сессия <> Неопределено Тогда
			Результат.Добавить(Сессия);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Повреждённое содержимое даёт Неопределено, а не исключение.
Функция ВосстановитьИзЗаписи(Знач Запись)
	Попытка
		Сессия = Новый СессияХаба();
		Сессия.ЗаполнитьИзСтрокиJSON(Запись.ДанныеJSON);
		Возврат Сессия;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Безопасен ли идентификатор сессии: ровно 64 символа из [0-9a-f].
//
// Параметры:
//  Ид - Строка - проверяемый идентификатор.
//
// Возвращаемое значение:
//  Булево.
//
Функция ИдентификаторБезопасен(Знач Ид) Экспорт

	Значение = Строка(Ид);
	Если СтрДлина(Значение) <> 64 Тогда
		Возврат Ложь;
	КонецЕсли;
	Разрешённые = "0123456789abcdef";
	Для НомерСимвола = 1 По 64 Цикл
		Если СтрНайти(Разрешённые, Сред(Значение, НомерСимвола, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеСессий") _Хранилище)

	Хранилище = _Хранилище;

КонецПроцедуры
