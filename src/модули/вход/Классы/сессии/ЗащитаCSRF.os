// Защита CSRF — желудь модуля auth: токен сессии и имя скрытого поля формы, которым
// его передают.

#Использовать pwhash

Перем СлужбаСессий;  // СлужбаСессий

// Ключ хранения CSRF-токена в данных сессии.
//
// Возвращаемое значение:
//  Строка - ключ хранения CSRF-токена в данных сессии.
//
Функция КлючТокена() Экспорт
	Возврат "csrf";
КонецФункции

// Имя скрытого поля формы с CSRF-токеном.
//
// Возвращаемое значение:
//  Строка - имя скрытого поля формы с CSRF-токеном.
//
Функция ИмяПоля() Экспорт
	Возврат "_csrf";
КонецФункции

// Возвращает CSRF-токен сессии, создавая и персистя его при первом обращении.
//
// Параметры:
//  Сессия - СессияХаба - действующая сессия пользователя.
//
// Возвращаемое значение:
//  Строка - CSRF-токен (64 hex-символа) либо "" при отсутствии сессии.
//
Функция ТокенСессии(Знач Сессия) Экспорт

	Если Сессия = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Токен = Сессия.Значение(КлючТокена());
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		Токен = СгенерироватьТокен();
		Сессия.УстановитьЗначение(КлючТокена(), Токен);
		СлужбаСессий.Сохранить(Сессия);
	КонецЕсли;

	Возврат Строка(Токен);

КонецФункции

// Проверяет переданный из формы CSRF-токен против токена сессии.
//
// Параметры:
//  Сессия - СессияХаба, Неопределено - сессия текущего запроса.
//  ПереданныйТокен - Строка - значение поля "_csrf" из тела запроса.
//
// Возвращаемое значение:
//  Булево - Истина, если токены совпадают.
//
Функция Проверить(Знач Сессия, Знач ПереданныйТокен) Экспорт

	Если Сессия = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Ожидаемый = Сессия.Значение(КлючТокена());
	Если НЕ ЗначениеЗаполнено(Ожидаемый) ИЛИ НЕ ЗначениеЗаполнено(ПереданныйТокен) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СовпадаютПостоянноеВремя(Строка(Ожидаемый), Строка(ПереданныйТокен));

КонецФункции

// 64 hex-символа из 32 крипто-стойких байт (pwhash.СгенерироватьСоль), как у сессий.
Функция СгенерироватьТокен()
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешированиеПаролей.СгенерироватьСоль(32)));
КонецФункции

// Сравнение строк без раннего выхода (аккумуляция расхождений) — защита от тайминга.
Функция СовпадаютПостоянноеВремя(Знач Ожидаемый, Знач Переданный)

	Если СтрДлина(Ожидаемый) <> СтрДлина(Переданный) Тогда
		Возврат Ложь;
	КонецЕсли;
	Расхождение = 0;
	Для НомерСимвола = 1 По СтрДлина(Ожидаемый) Цикл
		Если Сред(Ожидаемый, НомерСимвола, 1) <> Сред(Переданный, НомерСимвола, 1) Тогда
			Расхождение = Расхождение + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Расхождение = 0;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СлужбаСессий") _СлужбаСессий)

	СлужбаСессий = _СлужбаСессий;

КонецПроцедуры
