// Токены доступа (PAT) — аутентификация CLI и API. Значение вида oshub_{id}_{secret}
// показывается один раз, в БД хранится только SHA-256-хеш секрета.

#Использовать pwhash

Перем Хранилище;   // ХранилищеТокенов (данные)
Перем Настройки;   // СервисНастроек (настройки)
Перем Привязки;    // ХранилищеПривязокТокенов (данные) — набор пулов токена
Перем Сверка;      // СверкаСекретов (auth)

// Срок токена по умолчанию, дней: столько живёт ключ, выданный входом CLI, и это же
// значение подставляется в форму выпуска. Потолка не превышает никогда.
//
// Возвращаемое значение:
//  Число - срок в днях, не меньше 1.
//
Функция СрокПоУмолчаниюДней() Экспорт
	Срок = Настройки.Значение("oshub.auth.token.cli_days");
	Потолок = ПотолокСрокаДней();
	Возврат ?(Срок > Потолок, Потолок, Срок);
КонецФункции

// Наибольший срок, на который хаб выпускает токен, дней.
//
// Возвращаемое значение:
//  Число - потолок в днях, не меньше 1.
//
Функция ПотолокСрокаДней() Экспорт
	Возврат Настройки.Значение("oshub.auth.token.max_days");
КонецФункции

// Выпускает новый токен пользователю. Пустые права — исключение. Срок обязателен:
// бессрочных токенов хаб не выпускает, ноль и пропуск — исключение, как и срок
// больше потолка.
//
// Параметры:
//  ПользовательИдентификатор - Число - владелец токена.
//  Права - Строка - скоупы через запятую (необязательный, по умолчанию "read").
//  СрокДней - Число - срок жизни в днях, от 1 до ПотолокСрокаДней()
//             (необязательный, по умолчанию 0 — исключение).
//  ПулИдентификатор - Число - одиночная привязка к пулу, 0 — весь хаб
//                     (необязательный, по умолчанию 0).
//  Имя - Строка - имя происхождения токена для списка в кабинете
//        (необязательный, по умолчанию "").
//  Пулы - Массив из Число, Неопределено - набор пулов, которыми ограничен токен;
//         пустой набор и Неопределено — весь хаб (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - ЗначениеТокена (Строка — сырое значение, показать один раз),
//              Запись (ТокенДоступа).
//
Функция ВыпуститьТокен(Знач ПользовательИдентификатор, Знач Права = "read",
	Знач СрокДней = 0, Знач ПулИдентификатор = 0, Знач Имя = "", Знач Пулы = Неопределено) Экспорт

	Если ПустаяСтрока(СокрЛП(Строка(Права))) Тогда
		ВызватьИсключение "Не заданы права токена";
	КонецЕсли;

	Срок = ПроверенныйСрок(СрокДней);

	Секрет = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешированиеПаролей.СгенерироватьСоль(24)));

	Запись = Хранилище.СоздатьЭлемент();
	Запись.ПользовательИдентификатор = ПользовательИдентификатор;
	Запись.Права = СокрЛП(Строка(Права));
	Запись.Имя = ОграничитьИмя(Имя);
	Запись.ПулИдентификатор = ПулИдентификатор;
	Запись.Создан = ТекущаяУниверсальнаяДата();
	Запись.Истекает = ТекущаяУниверсальнаяДата() + Срок * 86400;
	Запись.Сохранить(); // первое сохранение даёт идентификатор для префикса

	Запись.Префикс = СтрШаблон("oshub_%1", Запись.Идентификатор);
	Запись.Хеш = Sha256Hex(Секрет);
	Запись.Сохранить();

	ЗаписатьПривязки(Запись, Пулы);

	Результат = Новый Структура();
	Результат.Вставить("ЗначениеТокена", СтрШаблон("oshub_%1_%2", Запись.Идентификатор, Секрет));
	Результат.Вставить("Запись", Запись);
	Возврат Результат;

КонецФункции

// Проверяет токен и называет причину отказа: у истёкшего токена запись цела и секрет
// сошёлся, всё остальное хаб не опознал.
//
// Параметры:
//  ЗначениеТокена - Строка - значение вида oshub_{id}_{secret}.
//  Момент - Дата - момент проверки срока, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Структура - Проверка (Структура: ПользовательИдентификатор, Права, ПулИдентификатор,
//              Пулы, Запись; Неопределено для негодного токена),
//              ПроблемаТокена (Строка — "" для годного, иначе ПроблемаИстёк
//              или ПроблемаНеОпознан).
//
Функция РезультатПроверки(Знач ЗначениеТокена, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);

	Разобранный = Разобрать(ЗначениеТокена);
	Если Разобранный = Неопределено Тогда
		Возврат Отказ(ПроблемаНеОпознан());
	КонецЕсли;

	Запись = Хранилище.ПолучитьОдноПоИдентификаторРавно(Разобранный.Идентификатор);
	Если Запись = Неопределено Тогда
		Возврат Отказ(ПроблемаНеОпознан());
	КонецЕсли;

	Если НЕ Сверка.Совпадают(Sha256Hex(Разобранный.Секрет), Запись.Хеш) Тогда
		Возврат Отказ(ПроблемаНеОпознан());
	КонецЕсли;

	Если ЗначениеЗаполнено(Запись.Истекает) И Запись.Истекает <= Сейчас Тогда
		Возврат Отказ(ПроблемаИстёк());
	КонецЕсли;

	Проверка = Новый Структура();
	Проверка.Вставить("ПользовательИдентификатор", Запись.ПользовательИдентификатор);
	Проверка.Вставить("Права", Запись.Права);
	Проверка.Вставить("ПулИдентификатор", Запись.ПулИдентификатор);
	Проверка.Вставить("Пулы", ПулыТокена(Запись));
	Проверка.Вставить("Запись", Запись);
	Возврат Успех(Проверка);

КонецФункции

// Пулы, которыми ограничен токен: строки набора плюс одиночная привязка старой записи.
// Пустой массив — токен на весь хаб.
//
// Параметры:
//  Запись - ТокенДоступа - запись токена.
//
// Возвращаемое значение:
//  Массив из Число - идентификаторы пулов без повторов.
//
Функция ПулыТокена(Знач Запись) Экспорт

	НазванныеПулы = Новый Массив();
	Для Каждого Привязка Из Привязки.ПривязкиТокена(Цел(Запись.Идентификатор)) Цикл
		НазванныеПулы.Добавить(Привязка.ПулИдентификатор);
	КонецЦикла;
	// ключ, выпущенный до появления набора, несёт свою единственную рамку колонкой записи
	НазванныеПулы.Добавить(Запись.ПулИдентификатор);

	Возврат НаборПулов(НазванныеПулы);

КонецФункции

// Наборы пулов сразу нескольких токенов: то же правило, что у ПулыТокена, но привязки
// всего списка читаются ОДНИМ запросом — список кабинета иначе стоил бы запроса на строку.
//
// Параметры:
//  Записи - Массив из ТокенДоступа - записи токенов.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (идентификатор токена), значение Массив из Число
//                 (идентификаторы пулов без повторов).
//
Функция НаборыПулов(Знач Записи) Экспорт

	ПоТокенам = Новый Соответствие();
	ТокенИдентификаторы = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		ПоТокенам.Вставить(Цел(Запись.Идентификатор), Новый Массив());
		ТокенИдентификаторы.Добавить(Цел(Запись.Идентификатор));
	КонецЦикла;

	Если ТокенИдентификаторы.Количество() > 0 Тогда
		Для Каждого Привязка Из Привязки.ПривязкиТокенов(ТокенИдентификаторы) Цикл
			НазванныеПулы = ПоТокенам.Получить(Цел(Привязка.ТокенИдентификатор));
			НазванныеПулы.Добавить(Привязка.ПулИдентификатор);
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Соответствие();
	Для Каждого Запись Из Записи Цикл
		НазванныеПулы = ПоТокенам.Получить(Цел(Запись.Идентификатор));
		// ключ, выпущенный до появления набора, несёт свою единственную рамку колонкой записи
		НазванныеПулы.Добавить(Запись.ПулИдентификатор);
		Результат.Вставить(Цел(Запись.Идентификатор), НаборПулов(НазванныеПулы));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Рамки токена из перечисленных идентификаторов: ноль, пустое и повтор рамками не являются
// (ноль означает «весь хаб», а повтор сделал бы одно ограничение двумя). Единственное место,
// где это правило записано: по нему набор и пишется в базу, и читается, и судится гейтом.
//
// Параметры:
//  НазванныеПулы - Массив, Неопределено - идентификаторы пулов как их назвал источник.
//
// Возвращаемое значение:
//  Массив из Число - идентификаторы больше нуля, без повторов, в порядке первого упоминания.
//
Функция НаборПулов(Знач НазванныеПулы) Экспорт

	Пулы = Новый Массив();
	Для Каждого Идентификатор Из ?(НазванныеПулы = Неопределено, Новый Массив(), НазванныеПулы) Цикл
		Значение = ?(ЗначениеЗаполнено(Идентификатор), Цел(Идентификатор), 0);
		Если Значение > 0 И Пулы.Найти(Значение) = Неопределено Тогда
			Пулы.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Пулы;

КонецФункции

// Причина отказа для токена с вышедшим сроком.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПроблемаИстёк() Экспорт
	Возврат "expired";
КонецФункции

// Причина отказа для токена, который хаб не опознал: строка не разобрана, записи нет
// (отозван) либо секрет не сошёлся.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПроблемаНеОпознан() Экспорт
	Возврат "invalid";
КонецФункции

// Отзывает токен пользователя, удаляя запись. Чужой токен не отзывается (защита от IDOR).
//
// Параметры:
//  ПользовательИдентификатор - Число - владелец токена.
//  ТокенИдентификатор - Число - идентификатор токена.
//
// Возвращаемое значение:
//  Булево - Ложь, если токен не найден или принадлежит другому пользователю.
//
Функция Отозвать(Знач ПользовательИдентификатор, Знач ТокенИдентификатор) Экспорт

	Запись = Хранилище.ПолучитьОдноПоИдентификаторРавно(ТокенИдентификатор);
	Если Запись = Неопределено ИЛИ Запись.ПользовательИдентификатор <> ПользовательИдентификатор Тогда
		Возврат Ложь;
	КонецЕсли;
	Хранилище.Удалить(Запись);
	Возврат Истина;

КонецФункции

// Токены пользователя для списка в кабинете; сырое значение секрета в них не хранится.
//
// Параметры:
//  ПользовательИдентификатор - Число - владелец токенов.
//
// Возвращаемое значение:
//  Массив из ТокенДоступа.
//
Функция ТокеныПользователя(Знач ПользовательИдентификатор) Экспорт
	Возврат Хранилище.ПолучитьПоПользовательИдентификаторРавно(ПользовательИдентификатор);
КонецФункции

// Содержит ли строка прав указанный скоуп (регистронезависимо).
//
// Параметры:
//  Права - Строка - скоупы через запятую.
//  Скоуп - Строка - искомый скоуп.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПраваСодержат(Знач Права, Знач Скоуп) Экспорт

	ИскомыйСкоуп = НРег(СокрЛП(Строка(Скоуп)));
	Для Каждого Часть Из СтрРазделить(Строка(Права), ",", Ложь) Цикл
		Если НРег(СокрЛП(Часть)) = ИскомыйСкоуп Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Набор пулов пишется строками связи: авто-DDL заводит таблицу, а колонку существующей — нет.
Процедура ЗаписатьПривязки(Знач Запись, Знач Пулы)

	Для Каждого ПулИдентификатор Из НаборПулов(Пулы) Цикл
		Привязки.Записать(Запись.Идентификатор, ПулИдентификатор);
	КонецЦикла;

КонецПроцедуры

Функция Успех(Знач Проверка)
	Возврат ИтогПроверки(Проверка, "");
КонецФункции

Функция Отказ(Знач ПроблемаТокена)
	Возврат ИтогПроверки(Неопределено, ПроблемаТокена);
КонецФункции

Функция ИтогПроверки(Знач Проверка, Знач ПроблемаТокена)
	Итог = Новый Структура();
	Итог.Вставить("Проверка", Проверка);
	Итог.Вставить("ПроблемаТокена", ПроблемаТокена);
	Возврат Итог;
КонецФункции

// Нечисло и Неопределено считаются нулём — и отвергаются наравне с ним.
Функция ПроверенныйСрок(Знач СрокДней)

	Срок = ?(ТипЗнч(СрокДней) = ТипЗнч(0), Цел(СрокДней), 0);
	Потолок = ПотолокСрокаДней();

	Если Срок < 1 Тогда
		ВызватьИсключение СтрШаблон(
			"Бессрочные токены не выпускаются: укажите срок от 1 до %1 дней",
			Формат(Потолок, "ЧГ=0"));
	КонецЕсли;
	Если Срок > Потолок Тогда
		ВызватьИсключение СтрШаблон("Срок токена %1 дней больше потолка хаба %2 дней",
			Формат(Срок, "ЧГ=0"), Формат(Потолок, "ЧГ=0"));
	КонецЕсли;

	Возврат Срок;

КонецФункции

// Разбирает oshub_{id}_{secret}; Неопределено при любом отклонении.
Функция Разобрать(Знач ЗначениеТокена)

	Значение = СокрЛП(Строка(ЗначениеТокена));
	Части = СтрРазделить(Значение, "_", Ложь);
	Если Части.Количество() <> 3 ИЛИ Части[0] <> "oshub" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Идентификатор = Число(Части[1]);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ПустаяСтрока(Части[2]) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("Идентификатор", Идентификатор);
	Результат.Вставить("Секрет", Части[2]);
	Возврат Результат;

КонецФункции

// Имя токена — короткая метка списка; управляющие символы и переносы из него убираются.
Функция ОграничитьИмя(Знач Имя)

	Очищенное = "";
	Для НомерСимвола = 1 По СтрДлина(Строка(Имя)) Цикл
		Символ = Сред(Строка(Имя), НомерСимвола, 1);
		Если КодСимвола(Символ) >= 32 Тогда
			Очищенное = Очищенное + Символ;
		КонецЕсли;
	КонецЦикла;

	Очищенное = СокрЛП(Очищенное);
	Возврат ?(СтрДлина(Очищенное) > 120, Лев(Очищенное, 120), Очищенное);

КонецФункции

Функция Sha256Hex(Знач Строка)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Строка));
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеТокенов") _Хранилище,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ХранилищеПривязокТокенов") _Привязки,
	&Пластилин(Значение = "СверкаСекретов") _Сверка)

	Хранилище = _Хранилище;
	Настройки = _Настройки;
	Привязки = _Привязки;
	Сверка = _Сверка;

КонецПроцедуры
