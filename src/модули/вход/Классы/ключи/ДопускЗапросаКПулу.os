// Допуск запроса к двери пула: принципала определяет перехватчик аутентификации, рамки ключа
// судит гейт токена. Без гейта аноним и сессия проходят, ключ — нет.

Перем Перехватчик;  // ПерехватчикАутентификации (вход)
Перем ГейтТокена;   // ГейтТокена (вход); Неопределено у прямого экземпляра — гейт не собран

// Принципал запроса: сессия браузера, ключ доступа либо аноним.
//
// Параметры:
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса (Authorization для ключа).
//  КукиЗапроса - Куки, Неопределено - куки запроса (сессия браузера).
//
// Возвращаемое значение:
//  Структура - принципал (см. ПерехватчикАутентификации.ОпределитьПринципала).
//
Функция Принципал(Знач ЗаголовкиЗапроса, Знач КукиЗапроса) Экспорт
	Возврат Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);
КонецФункции

// Пускают ли рамки ключа запроса читать пул. Запрос без ключа рамками не сужен.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса; Неопределено — ключа в запросе нет.
//  Пул - Пул - пул, о котором спрашивают.
//
// Возвращаемое значение:
//  Булево.
//
Функция КлючЧитает(Знач Принципал, Знач Пул) Экспорт
	Если ГейтТокена = Неопределено Тогда
		Возврат БезГейтаПропускаем(Принципал);
	КонецЕсли;
	Возврат ГейтТокена.ЧтениеРазрешено(Принципал, Пул);
КонецФункции

// Пускают ли рамки ключа запроса в пул хоть на что-то — чтение или запись.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса; Неопределено — ключа в запросе нет.
//  Пул - Пул - пул, о котором спрашивают.
//
// Возвращаемое значение:
//  Булево.
//
Функция КлючТрогает(Знач Принципал, Знач Пул) Экспорт
	Если ГейтТокена = Неопределено Тогда
		Возврат БезГейтаПропускаем(Принципал);
	КонецЕсли;
	Возврат ГейтТокена.ЧтениеРазрешено(Принципал, Пул)
		ИЛИ ГейтТокена.ЗаписьРазрешена(Принципал, Пул);
КонецФункции

// Мягкий fail-closed: аноним и сессия читают публичное, запрос с ключом не открываем — проверить нечем.
Функция БезГейтаПропускаем(Знач Принципал)
	Возврат НЕ Перехватчик.ЭтоКлюч(Принципал);
КонецФункции

&Прозвище("ДопускЗапроса")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "ГейтТокена") _ГейтТокена)

	Перехватчик = _Перехватчик;
	ГейтТокена = _ГейтТокена;

КонецПроцедуры
