// Гейт токена доступа: второй контур авторизации, независимый от модели прав.
// СервисПрав отвечает «что вправе человек», гейт — «что вправе ключ от его имени»
// (скоупы read/write и привязка к пулу). Права он только сужает, никогда не расширяет;
// для сессии и анонима прозрачен.

Перем СервисТокенов;  // СервисТокенов (auth) — разбор строки скоупов

#Область ПубличныйИнтерфейс

// Скоуп чтения (выдача метаданных и артефактов).
//
// Возвращаемое значение:
//  Строка.
//
Функция СкоупЧтения() Экспорт
	Возврат "read";
КонецФункции

// Скоуп записи (публикация, мутации кабинета и API).
//
// Возвращаемое значение:
//  Строка.
//
Функция СкоупЗаписи() Экспорт
	Возврат "write";
КонецФункции

// Скоуп, требуемый действием модели прав. Чтение → read, всё остальное → write.
//
// Параметры:
//  Действие - Строка - создание | изменение | удаление | чтение.
//
// Возвращаемое значение:
//  Строка.
//
Функция СкоупДействия(Знач Действие) Экспорт
	Возврат ?(НРег(СокрЛП(Строка(Действие))) = "чтение", СкоупЧтения(), СкоупЗаписи());
КонецФункции

// Позволяет ли ключ запроса выполнить действие над объектом этого пула.
// Права только сужает: для сессии и анонима всегда «разрешено».
//
// Параметры:
//  Принципал - Структура, Неопределено - результат ПерехватчикАутентификации
//              (Способ, Права, ПулИдентификатор); Неопределено — ключа нет.
//  Действие - Строка - создание | изменение | удаление | чтение.
//  ПулИдентификатор - Число - пул объекта (необязательный, по умолчанию 0 — уровень хаба).
//
// Возвращаемое значение:
//  Структура - Разрешено (Булево), Причина (Строка: "" | "скоуп" | "привязка").
//
Функция Проверить(Знач Принципал, Знач Действие, Знач ПулИдентификатор = 0) Экспорт

	Если НЕ ЭтоТокен(Принципал) Тогда
		Возврат Вердикт(Истина, ""); // сессия/аноним: ключа нет, сужать нечего
	КонецЕсли;

	Если НЕ СервисТокенов.ПраваСодержат(Принципал.Права, СкоупДействия(Действие)) Тогда
		Возврат Вердикт(Ложь, ПричинаСкоуп());
	КонецЕсли;

	// Токен с привязкой действует ровно в одном пуле; хаб-уровневые операции (пул 0) ему
	// недоступны тем более — иначе ключ от пула открывал бы создание пулов на всём хабе.
	Привязка = Цел(?(Принципал.ПулИдентификатор = Неопределено, 0, Принципал.ПулИдентификатор));
	Если Привязка > 0 И Привязка <> Цел(ПулИдентификатор) Тогда
		Возврат Вердикт(Ложь, ПричинаПривязка());
	КонецЕсли;

	Возврат Вердикт(Истина, "");

КонецФункции

// Позволяет ли ключ читать этот пул.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  Пул - Пул, Неопределено - пул объекта (Неопределено — уровень хаба).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЧтениеРазрешено(Знач Принципал, Знач Пул) Экспорт
	Возврат Проверить(Принципал, "чтение", ?(Пул = Неопределено, 0, Пул.Идентификатор)).Разрешено;
КонецФункции

// Позволяет ли ключ писать в этот пул (публикация и мутации).
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  Пул - Пул, Неопределено - пул объекта (Неопределено — уровень хаба).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЗаписьРазрешена(Знач Принципал, Знач Пул) Экспорт
	Возврат Проверить(Принципал, "изменение", ?(Пул = Неопределено, 0, Пул.Идентификатор)).Разрешено;
КонецФункции

// Код причины отказа «привязка»; текст для человека собирает вызывающий.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаПривязка() Экспорт
	Возврат "привязка";
КонецФункции

// Код причины отказа «скоуп».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаСкоуп() Экспорт
	Возврат "скоуп";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пришёл ли запрос с ключом. Пустая строка скоупов = отказ, а не «нет ограничений»:
// выпуск токена без прав невозможен, значит запись испорчена (fail-closed).
Функция ЭтоТокен(Знач Принципал)
	Возврат Принципал <> Неопределено
		И НРег(СокрЛП(Строка(Принципал.Способ))) = "token";
КонецФункции

Функция Вердикт(Знач Разрешено, Знач Причина)
	Возврат Новый Структура("Разрешено, Причина", Разрешено, Причина);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисТокенов") _СервисТокенов) Экспорт

	СервисТокенов = _СервисТокенов;

КонецПроцедуры
