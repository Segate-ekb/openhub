// Хранилище привязок токена к пулам — репозиторий «ПривязкаТокена»; живёт, пока жив токен.

// BSLLS:UnusedParameters-off

Перем Сам;   // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё

// Привязки одного токена.
//
// Параметры:
//  ТокенИдентификатор - Число - идентификатор токена доступа.
//
// Возвращаемое значение:
//  Массив из ПривязкаТокена.
//
&МетодЗапроса
Функция ПолучитьПоТокенИдентификаторРавно(ТокенИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Привязки сразу нескольких токенов — один запрос на список токенов.
//
// Параметры:
//  ТокенИдентификаторы - Массив из Число - идентификаторы токенов доступа.
//
// Возвращаемое значение:
//  Массив из ПривязкаТокена.
//
&МетодЗапроса
Функция ПолучитьПоТокенИдентификаторВ(ТокенИдентификаторы) Экспорт
	Возврат Неопределено;
КонецФункции

// Привязки к одному пулу — все токены, которые его называют.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ПривязкаТокена.
//
&МетодЗапроса
Функция ПолучитьПоПулИдентификаторРавно(ПулИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Привязки токена.
//
// Параметры:
//  ТокенИдентификатор - Число - идентификатор токена доступа.
//
// Возвращаемое значение:
//  Массив из ПривязкаТокена.
//
Функция ПривязкиТокена(Знач ТокенИдентификатор) Экспорт
	Возврат Сам.Достать().ПолучитьПоТокенИдентификаторРавно(Цел(ТокенИдентификатор));
КонецФункции

// Привязки нескольких токенов одним запросом; пустой список идентификаторов — пустая выдача.
//
// Параметры:
//  ТокенИдентификаторы - Массив из Число - идентификаторы токенов доступа.
//
// Возвращаемое значение:
//  Массив из ПривязкаТокена.
//
Функция ПривязкиТокенов(Знач ТокенИдентификаторы) Экспорт

	Если ТокенИдентификаторы.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Целые = Новый Массив();
	Для Каждого Идентификатор Из ТокенИдентификаторы Цикл
		Целые.Добавить(Цел(Идентификатор));
	КонецЦикла;

	Возврат Сам.Достать().ПолучитьПоТокенИдентификаторВ(Целые);

КонецФункции

// Привязки к пулу: по ним видно, какие токены его называют.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ПривязкаТокена.
//
Функция ПривязкиПула(Знач ПулИдентификатор) Экспорт
	Возврат Сам.Достать().ПолучитьПоПулИдентификаторРавно(Цел(ПулИдентификатор));
КонецФункции

// Записывает привязку токена к пулу.
//
// Параметры:
//  ТокенИдентификатор - Число - идентификатор токена доступа.
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  ПривязкаТокена - сохранённая запись.
//
Функция Записать(Знач ТокенИдентификатор, Знач ПулИдентификатор) Экспорт

	Привязка = Сам.Достать().СоздатьЭлемент();
	Привязка.ТокенИдентификатор = Цел(ТокенИдентификатор);
	Привязка.ПулИдентификатор = Цел(ПулИдентификатор);
	Привязка.Сохранить();
	Возврат Привязка;

КонецФункции

// Снимает все привязки токена.
//
// Параметры:
//  ТокенИдентификатор - Число - идентификатор токена доступа.
//
// Возвращаемое значение:
//  Число - сколько привязок снято.
//
&Наблюдаемый
Функция СнятьПривязкиТокена(Знач ТокенИдентификатор) Экспорт

	Снято = 0;
	Для Каждого Привязка Из ПривязкиТокена(ТокенИдентификатор) Цикл
		Сам.Достать().Удалить(Привязка);
		Снято = Снято + 1;
	КонецЦикла;
	Возврат Снято;

КонецФункции

&ХранилищеСущностей("ПривязкаТокена")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеПривязокТокенов") _Сам)

	Сам = _Сам;

КонецПроцедуры
