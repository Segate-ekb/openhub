// Гвард ключа: сужает уже имеющееся право человека до рамок предъявленного PAT.
// Несобранный ГейтТокена — отказ всему, включая сессию (fail-closed).

Перем ГейтТокена;  // ГейтТокена (auth); Неопределено — гейт не собран (fail-closed)

#Область ПубличныйИнтерфейс

// Пропускают ли рамки предъявленного ключа действие над объектом этого пула.
// Несобранный гейт токена отказывает всем, включая сессию (fail-closed).
//
// Параметры:
//  Принципал - Структура, Неопределено - результат ПерехватчикАутентификации
//              (Способ, Права, ПулИдентификатор); Неопределено — ключа нет.
//  Действие - Строка - создание | изменение | удаление | чтение.
//  ПулИдентификатор - Число - пул объекта (необязательный, по умолчанию 0 — уровень хаба).
//
// Возвращаемое значение:
//  Структура - Разрешено (Булево), Причина (Строка: "" | "скоуп" | "привязка" | "гейт").
//
Функция Пропустить(Знач Принципал, Знач Действие, Знач ПулИдентификатор = 0) Экспорт

	Если ГейтТокена = Неопределено Тогда
		Возврат Новый Структура("Разрешено, Причина", Ложь, ПричинаГейт());
	КонецЕсли;
	Возврат ГейтТокена.Проверить(Принципал, Действие, ПулИдентификатор);

КонецФункции

// Человекочитаемая причина отказа рамок ключа — одна формулировка на весь хаб.
//
// Параметры:
//  Причина - Строка - код причины из Пропустить.
//
// Возвращаемое значение:
//  Строка - текст для показа человеку.
//
Функция ОписаниеПричины(Знач Причина) Экспорт

	Норм = НРег(СокрЛП(Строка(Причина)));
	Если Норм = ПричинаГейт() Тогда
		Возврат "гейт ключа доступа не собран";
	ИначеЕсли ГейтТокена <> Неопределено И Норм = ГейтТокена.ПричинаПривязка() Тогда
		Возврат "токен привязан к другому пулу";
	ИначеЕсли Норм = "привязка" Тогда
		Возврат "токен привязан к другому пулу";
	КонецЕсли;
	Возврат "токену не хватает скоупа write";

КонецФункции

// Код причины «гейт ключа не собран в контейнере».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаГейт() Экспорт
	Возврат "гейт";
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГейтТокена") _ГейтТокена = Неопределено)

	ГейтТокена = _ГейтТокена;

КонецПроцедуры
