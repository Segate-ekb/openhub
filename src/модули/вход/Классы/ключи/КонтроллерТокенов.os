// Контроллер токенов доступа (PAT) под /api/v1: список, выпуск, отзыв. Все маршруты
// защищены, аноним — 401; значение выпущенного токена отдаётся один раз.

Перем СервисТокенов;   // СервисТокенов (auth)
Перем Перехватчик;     // ПерехватчикАутентификации (auth)
Перем ЧтениеПулов;     // ГвардДоступаКПулу (auth) — какие пулы запрос вправе называть
Перем Ответы;          // ОтветыAPI (auth)
Перем ПустыеКуки;      // Куки (winow)
Перем Числа;           // ПриведениеЧисел (основа)
Перем HTTP;            // МетодыHTTP (основа)

#Область ТочкиМаршрута

// GET /api/v1/tokens — список токенов пользователя, POST — выпуск нового.
// Ключом эти операции недоступны: ключ не выпускает и не отзывает ключи (403).
//
// Параметры:
//  Ответ - Ответ - ответ winow: 200/201, 400 на срок больше потолка, на незнакомый пул
//          и на оба поля пулов разом, 401 анониму, 403 ключу, 405 на другой метод.
//  ТелоЗапроса - Строка - тело POST: права, пулы (набор идентификаторов) ЛИБО пул
//                (одиночная привязка прежних клиентов), срок_дней (1..потолок; пропуск
//                и ноль — срок хаба по умолчанию, бессрочные токены не выпускаются).
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса (сессия браузера).
//  МетодЗапроса - Строка - HTTP-метод запроса.
//
&ТочкаМаршрута("tokens")
Процедура Токены(Ответ, ТелоЗапроса, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
	Принципал = ТребоватьСессию(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Принципал = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		СписокТокенов(Ответ, Принципал.Пользователь);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		ВыпуститьТокен(Ответ, Принципал, ТелоЗапроса, ЗаголовкиЗапроса);
	Иначе
		ОтветМетодНеРазрешён(Ответ, "GET, POST");
	КонецЕсли;

КонецПроцедуры

// DELETE /api/v1/tokens/{ИдТокена} — отзыв собственного токена пользователя.
//
// Параметры:
//  Ответ - Ответ - ответ winow: 200, 400 на нечисловой идентификатор, 401, 403, 404, 405.
//  ИдТокена - Строка - идентификатор токена из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса (сессия браузера).
//  МетодЗапроса - Строка - HTTP-метод запроса.
//
&ТочкаМаршрута("tokens/{ИдТокена}")
Процедура ТокенПоИд(Ответ, ИдТокена, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
	Принципал = ТребоватьСессию(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Принципал = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Пользователь = Принципал.Пользователь;

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "DELETE") Тогда
		ОтветМетодНеРазрешён(Ответ, "DELETE");
		Возврат;
	КонецЕсли;

	Попытка
		Идентификатор = Число(ИдТокена);
	Исключение
		Ответы.Ошибка(Ответ, 400, "invalid_token_id", "Некорректный идентификатор токена");
		Возврат;
	КонецПопытки;

	Если СервисТокенов.Отозвать(Пользователь.Идентификатор, Идентификатор) Тогда
		Ответы.JSON(Ответ, 200, Новый Структура("status", "revoked"));
	Иначе
		Ответы.Ошибка(Ответ, 404, "token_not_found", "Токен не найден");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ДействияТокенов

Процедура СписокТокенов(Ответ, Знач Пользователь)

	Массив = Новый Массив();
	Для Каждого Токен Из СервисТокенов.ТокеныПользователя(Пользователь.Идентификатор) Цикл
		Массив.Добавить(ТокенВJSON(Токен));
	КонецЦикла;
	Ответы.JSON(Ответ, 200, Новый Структура("tokens", Массив));

КонецПроцедуры

Процедура ВыпуститьТокен(Ответ, Знач Принципал, Знач ТелоЗапроса, Знач ЗаголовкиЗапроса)

	Тело = Ответы.РазобратьТело(ТелоЗапроса, ЗаголовкиЗапроса);
	Права = Ответы.Поле(Тело, "права", Ответы.Поле(Тело, "scopes", "read"));
	ПулИд = Числа.ЧислоИлиНоль(Ответы.Поле(Тело, "пул", Ответы.Поле(Тело, "pool", "0")));
	Имя = Ответы.Поле(Тело, "имя", Ответы.Поле(Тело, "name"));

	Заявленные = ЗаявленныеПулы(Тело);
	Если ПулИд > 0 И Заявленные.Количество() > 0 Тогда
		// Два поля разом дали бы рамки из обоих, но живут они по разным правилам:
		// одиночное пишется колонкой записи и уносит ключ вместе со своим пулом,
		// набор — строками. Смешение молча сносило бы ключ с живыми рамками.
		Ответы.Ошибка(Ответ, 400, "pool_fields_conflict",
			"Задайте либо «пул» (одиночная привязка), либо «пулы» (набор), но не оба сразу");
		Возврат;
	КонецЕсли;

	Названные = ЧтениеПулов.НазванныеПулы(Принципал, Заявленные);
	Если ЗначениеЗаполнено(Названные.Отвергнутый) Тогда
		// невидимый пул отвечает ровно как несуществующий: иначе перебор идентификаторов
		// рассказывал бы, какие приватные пулы на хабе есть
		Ответы.Ошибка(Ответ, 400, "pool_not_found",
			СтрШаблон("Пул %1 не найден", Названные.Отвергнутый));
		Возврат;
	КонецЕсли;

	// пропуск и ноль — срок хаба по умолчанию, а не вечный токен; минус — ошибка клиента
	Потолок = СервисТокенов.ПотолокСрокаДней();
	СрокДней = Числа.ЧислоИлиНоль(Ответы.Поле(Тело, "срок_дней", Ответы.Поле(Тело, "expires_in_days", "0")));
	Если СрокДней < 0 Тогда
		Ответы.Ошибка(Ответ, 400, "invalid_expires_in_days",
			"Срок токена задаётся числом дней от 1 до " + Формат(Потолок, "ЧГ=0"));
		Возврат;
	КонецЕсли;
	Если СрокДней = 0 Тогда
		СрокДней = СервисТокенов.СрокПоУмолчаниюДней();
	КонецЕсли;
	Если СрокДней > Потолок Тогда
		Ответы.Ошибка(Ответ, 400, "token_ttl_too_long",
			СтрШаблон("Срок токена не может превышать %1 дней", Формат(Потолок, "ЧГ=0")));
		Возврат;
	КонецЕсли;

	Попытка
		Выпуск = СервисТокенов.ВыпуститьТокен(Принципал.Пользователь.Идентификатор, Права,
			СрокДней, ПулИд, Имя, Названные.Пулы);
	Исключение
		Ответы.Ошибка(Ответ, 400, "token_issue_failed", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Данные = ТокенВJSON(Выпуск.Запись);
	Данные.Вставить("token", Выпуск.ЗначениеТокена); // показывается ОДИН раз
	Ответы.JSON(Ответ, 201, Новый Структура("token_info", Данные));

КонецПроцедуры

// Русское и английское имя поля называют одно и то же: побеждает присланное клиентом.
Функция ЗаявленныеПулы(Знач Тело)

	Названные = Ответы.Список(Тело, "пулы");
	Возврат ?(Названные.Количество() > 0, Названные, Ответы.Список(Тело, "pools"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТокенВJSON(Знач Токен)

	Пулы = СервисТокенов.ПулыТокена(Токен);

	Структура = Новый Структура();
	Структура.Вставить("id", Токен.Идентификатор);
	Структура.Вставить("prefix", Токен.Префикс);
	Структура.Вставить("name", ?(ЗначениеЗаполнено(Токен.Имя), Строка(Токен.Имя), ""));
	Структура.Вставить("scopes", Токен.Права);
	// клиенты прежних версий читают одиночное поле: набор из одного пула им виден как раньше,
	// набор из нескольких одним числом не выражается и приезжает нулём
	Структура.Вставить("pool_id", ?(Пулы.Количество() = 1, Пулы[0], 0));
	Структура.Вставить("pool_ids", Пулы);
	Структура.Вставить("created", ?(ЗначениеЗаполнено(Токен.Создан), XMLСтрока(Токен.Создан), ""));
	Структура.Вставить("expires", ?(ЗначениеЗаполнено(Токен.Истекает), XMLСтрока(Токен.Истекает), ""));
	Возврат Структура;

КонецФункции

// Ключ не размножается: инвариант живёт в перехватчике, здесь только его вопрос.
Функция ТребоватьСессию(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);
	Если Принципал.Пользователь = Неопределено Тогда
		Ответы.Ошибка(Ответ, 401, "unauthorized", "Требуется аутентификация");
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ Перехватчик.УправлениеКлючамиРазрешено(Принципал) Тогда
		Ответы.Ошибка(Ответ, 403, "token_cannot_manage_tokens",
			"Управление токенами доступно только из кабинета: ключ не выпускает и не отзывает ключи");
		Возврат Неопределено;
	КонецЕсли;
	Возврат Принципал;

КонецФункции

Процедура ОтветМетодНеРазрешён(Ответ, Знач Разрешённый)
	Ответ.Заголовки["Allow"] = Разрешённый;
	Ответы.Ошибка(Ответ, 405, "method_not_allowed", СтрШаблон("Разрешены методы: %1", Разрешённый));
КонецПроцедуры

#КонецОбласти

&Контроллер("/api/v1")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисТокенов") _СервисТокенов,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "Куки") _ПустыеКуки,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "ГвардДоступаКПулу") _ЧтениеПулов)

	Числа = _Числа;
	HTTP = _HTTP;

	СервисТокенов = _СервисТокенов;
	Перехватчик = _Перехватчик;
	ЧтениеПулов = _ЧтениеПулов;
	Ответы = _Ответы;
	ПустыеКуки = _ПустыеКуки;

КонецПроцедуры
