// Ключ доступа: права, привязка к пулам и сроки; сам ключ — только при выпуске.

&Сериализуемое("id")
&Заполнено
&Тип("Число")
Перем Ид;

&Сериализуемое("prefix")
&Заполнено
&Тип("Строка")
Перем Префикс;

&Сериализуемое("name")
&Заполнено
&Тип("Строка")
Перем Имя;

&Сериализуемое("scopes")
&Заполнено
&Тип("Строка")
Перем Права;

&Сериализуемое("pool_id")
&Заполнено
&Тип("Число")
Перем ИдПула;

&Сериализуемое("pool_ids")
&Заполнено
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("Число")
Перем ИдПулов;

&Сериализуемое("created")
&Заполнено
&Тип("Строка")
Перем Выпущен;

&Сериализуемое("expires")
&Заполнено
&Тип("Строка")
Перем Истекает;

&Сериализуемое("token")
&Тип("Строка")
Перем Ключ;
