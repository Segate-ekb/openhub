// Страница ключей доступа учётки.

&Сериализуемое("tokens")
&Заполнено
&Тип("Массив")
&ДляКаждого("Значение")
&Тип("КлючДоступаJSON")
Перем Ключи;

&Сериализуемое("page")
&Заполнено
&Тип("Число")
Перем Номер;

&Сериализуемое("pageSize")
&Заполнено
&Тип("Число")
Перем Размер;

&Сериализуемое("total")
&Заполнено
&Тип("Число")
Перем Всего;

&Сериализуемое("has_more")
&Заполнено
&Тип("Булево")
Перем ЕстьЕщё;
