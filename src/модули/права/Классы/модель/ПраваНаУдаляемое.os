// Права на удаляемый пул и пакет — реализация контрактов ПоследствияУдаленияПула и
// ПоследствияУдаленияПакета: гранты на объект и роли на пул уходят первыми.

Перем ХранилищеПрав;        // ХранилищеПравДоступа (права)
Перем ХранилищеУчастников;  // ХранилищеУчастниковПула (права) — роли на пуле
Перем Снятие;               // СнятиеСтрок (данные) — снятие пачки строк со счётом

// Снимает гранты на пул и роли на нём.
//
// Параметры:
//  Пул - Пул - удаляемый пул.
//
// Возвращаемое значение:
//  Структура - Доступов (Число) — снятые гранты, Ролей (Число), Строк (Число).
//
Функция СнятьСтрокиПула(Знач Пул) Экспорт

	ПулИд = Цел(Пул.Идентификатор);
	Доступов = Снятие.Снять(ХранилищеПрав.ГрантыНаОбъект("пул", ПулИд));
	Ролей = Снятие.Снять(ХранилищеУчастников.ПолучитьПоПулИдентификаторРавно(ПулИд));

	Возврат Новый Структура("Доступов, Ролей, Строк", Доступов, Ролей, Доступов + Ролей);

КонецФункции

// Снимает гранты на пакет.
//
// Параметры:
//  Пакет - Пакет - удаляемый пакет.
//
// Возвращаемое значение:
//  Число - сколько строк снято.
//
Функция СнятьСтрокиПакета(Знач Пакет) Экспорт
	Возврат Снятие.Снять(ХранилищеПрав.ГрантыНаОбъект("пакет", Цел(Пакет.Идентификатор)));
КонецФункции

&Прозвище("ПоследствияУдаленияПула")
&Прозвище("ПоследствияУдаленияПакета")
&Порядок(10)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПравДоступа") _ХранилищеПрав,
	&Пластилин(Значение = "ХранилищеУчастниковПула") _ХранилищеУчастников,
	&Пластилин(Значение = "СнятиеСтрок") _Снятие)

	ХранилищеПрав = _ХранилищеПрав;
	ХранилищеУчастников = _ХранилищеУчастников;
	Снятие = _Снятие;

КонецПроцедуры
