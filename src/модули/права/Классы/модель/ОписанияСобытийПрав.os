// События прав словами: выданная, изменённая или отозванная роль.

Перем События;  // ОбъявленияСобытий (события)

#Область ПубличныйИнтерфейс

// Объявления событий прав в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияСобытий - события прав словами.
//
Функция Объявления() Экспорт
	Возврат События;
КонецФункции

#КонецОбласти

&Прозвище("ОписанияСобытий")
&Порядок(60)
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ИздательСобытий") _Издатель) Экспорт

	События = Новый ОбъявленияСобытий();

	События.ОбъявитьВнутреннее(_Издатель.ТипПраваИзменены(), "Права доступа изменены",
		"Субъекту выдана, изменена или отозвана роль на хабе, пуле или пакете.",
		"Событие безопасности: его адресат — журнал аудита и администратор, а не подписчик"
		+ " пакета. Нагрузка собрана под журнал (Кто/Действие/Объект/ДеталиJSON) и назвала бы"
		+ " подписчику субъектов чужих прав — раздавать это подпиской нельзя.");

КонецПроцедуры
