// Запись и чтение гранулярных грантов: выдача и отзыв прав субъектам (пользователь, группа)
// на объекты (хаб, пул, пакет). Резолвинг прав живёт в СервисПрав, пустой набор — отзыв.

Перем СервисПрав;            // СервисПрав (auth)
Перем ХранилищеПравДоступа;  // ХранилищеПравДоступа (данные)
Перем ХранилищеПакетов;      // ХранилищеПакетов (данные) — реальный пул пакета
Перем ХранилищеПулов;        // ХранилищеПулов (данные) — существование пула
Перем ИменаЖурнала;          // ИмяОбъектаАудита (аудит) — вид объекта и субъекта в журнале
Перем СобытиеЖурнала;        // СобытиеАудита (аудит) — форма нагрузки записи
Перем Издатель;              // ИздательСобытий (события); опционален
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Может ли пользователь выдавать и отзывать роли на объекте: админ хаба — всегда,
// на самом объекте — роль мейнтейнера и выше, на уровне хаба — только админ.
// Объект перепроверяется по сущности: клиентскому ПулИдентификатору доверия нет,
// подделкой пула чужой пакет подставлялся бы в мою область наследования (IDOR).
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - инициатор.
//  Объект - Структура - описание объекта; несуществующий объект — исключение.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетВыдаватьГрант(Знач Пользователь, Знач Объект) Экспорт
	Возврат МожетВыдаватьНаДостоверном(Пользователь, Достоверный(Объект));
КонецФункции

// Авторизованная выдача роли субъекту на объект — рабочая форма для UI и API.
// Неизвестная роль и роли выше мейнтейнера (владелец, админ хаба) — исключение:
// владение сущностью даёт роль на её контейнере, роль хаба назначает только админ.
//
// Параметры:
//  КтоВыдаёт - Пользователь - инициатор, мейнтейнер объекта и выше.
//  ТипСубъекта - Строка - пользователь | группа.
//  СубъектИд - Число - идентификатор субъекта.
//  Объект - Структура - описание объекта.
//  Роль - Строка - читатель | райтер | мейнтейнер.
//
// Возвращаемое значение:
//  ПравоДоступа, Неопределено - запись права; Неопределено, если роль снята.
//
Функция ВыдатьРоль(Знач КтоВыдаёт, Знач ТипСубъекта, Знач СубъектИд, Знач Объект, Знач Роль) Экспорт

	Если СервисПрав.РангРоли(Роль) = 0 Тогда
		ВызватьИсключение СтрШаблон("Неизвестная роль ""%1"": ожидается читатель, райтер или мейнтейнер", Роль);
	КонецЕсли;
	Если СервисПрав.РангРоли(Роль) > СервисПрав.РангРоли(СервисПрав.РольМейнтейнер()) Тогда
		ВызватьИсключение СтрШаблон(
			"Роль ""%1"" на объекте не выдаётся: владение сущностью даёт роль на её контейнере,"
			+ " роль администратора хаба назначается только администратором хаба", Роль);
	КонецЕсли;

	Возврат ВыдатьГрант(КтоВыдаёт, ТипСубъекта, СубъектИд, Объект, СервисПрав.НаборРоли(Роль));

КонецФункции

// Роль готовой записи права — для витрин, которые уже держат запись в руках и не должны
// заводить свой резолв набора действий.
//
// Параметры:
//  Грант - ПравоДоступа, Неопределено - запись права.
//
// Возвращаемое значение:
//  Строка - читатель | райтер | мейнтейнер | "".
//
Функция РольЗаписи(Знач Грант) Экспорт
	Возврат ?(Грант = Неопределено, "", СервисПрав.РольПоНабору(НаборГранта(Грант)));
КонецФункции

// Авторизованная выдача гранулярного гранта. Инициатор без права управления доступом
// к объекту получает исключение, а попытка попадает в журнал безопасности.
//
// Параметры:
//  КтоВыдаёт - Пользователь - инициатор, мейнтейнер объекта и выше.
//  ТипСубъекта - Строка - пользователь | группа.
//  СубъектИд - Число - идентификатор субъекта.
//  Объект - Структура - описание объекта.
//  Действия - Структура - создание, изменение, удаление, чтение (отсутствующие — Ложь).
//
// Возвращаемое значение:
//  ПравоДоступа, Неопределено - грант; Неопределено, если действия пусты и грант отозван.
//
Функция ВыдатьГрант(Знач КтоВыдаёт, Знач ТипСубъекта, Знач СубъектИд, Знач Объект, Знач Действия) Экспорт

	Цель = Достоверный(Объект);
	Если НЕ МожетВыдаватьНаДостоверном(КтоВыдаёт, Цель) Тогда
		ОтказатьВУправленииПравами(КтоВыдаёт, ТипСубъекта, СубъектИд, Цель, "выдача");
	КонецЕсли;
	ИдВыдавшего = ?(КтоВыдаёт = Неопределено, 0, КтоВыдаёт.Идентификатор);
	Возврат ЗафиксироватьГрант(ТипСубъекта, СубъектИд, Цель, Действия, ИдВыдавшего, ИмяПринципала(КтоВыдаёт));

КонецФункции

// Авторизованный отзыв гранта субъекта на объект. Инициатор без права управления
// доступом получает исключение.
//
// Параметры:
//  КтоВыдаёт - Пользователь - инициатор, мейнтейнер объекта и выше.
//  ТипСубъекта - Строка - пользователь | группа.
//  СубъектИд - Число - идентификатор субъекта.
//  Объект - Структура - описание объекта.
//
// Возвращаемое значение:
//  Булево - был ли грант удалён.
//
Функция ОтозватьГрант(Знач КтоВыдаёт, Знач ТипСубъекта, Знач СубъектИд, Знач Объект) Экспорт

	Цель = Достоверный(Объект);
	Если НЕ МожетВыдаватьНаДостоверном(КтоВыдаёт, Цель) Тогда
		ОтказатьВУправленииПравами(КтоВыдаёт, ТипСубъекта, СубъектИд, Цель, "отзыв");
	КонецЕсли;
	Грант = НайтиГрант(ТипСубъекта, СубъектИд, Цель);
	Если Грант = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	СнятаяРоль = РольЗаписи(Грант);
	ХранилищеПравДоступа.Удалить(Грант);
	ОпубликоватьИзменениеПрав(ИмяПринципала(КтоВыдаёт), "права.отозваны",
		ТипСубъекта, СубъектИд, Цель, СнятаяРоль, "", Неопределено);
	Возврат Истина;

КонецФункции

// Системная фиксация гранта (upsert, без проверки выдающего) — TOFU-владение и роль
// создателю пула. Единственная точка записи прав, поэтому аудит проходит через неё.
//
// Параметры:
//  ТипСубъекта - Строка - пользователь | группа.
//  СубъектИд - Число - идентификатор субъекта.
//  Объект - Структура - описание объекта; перепроверяется по сущности.
//  Действия - Структура - создание, изменение, удаление, чтение (отсутствующие — Ложь).
//  КемВыдано - Число - идентификатор выдавшего, 0 означает системную выдачу
//              (необязательный, по умолчанию 0).
//  КтоСтрокой - Строка - принципал для журнала аудита (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  ПравоДоступа, Неопределено - грант; Неопределено, если действия пусты и грант отозван.
//
Функция ЗафиксироватьГрант(Знач ТипСубъекта, Знач СубъектИд, Знач Объект, Знач Действия, Знач КемВыдано = 0, Знач КтоСтрокой = "") Экспорт

	НормТипСубъекта = НормализоватьТипСубъекта(ТипСубъекта);
	// системный контур тоже пишет только по достоверному объекту
	Объект = Достоверный(Объект);
	Создание  = Флаг(Действия, "создание");
	Изменение = Флаг(Действия, "изменение");
	Удаление  = Флаг(Действия, "удаление");
	Чтение    = Флаг(Действия, "чтение");

	Грант = НайтиГрант(НормТипСубъекта, СубъектИд, Объект);
	// роль снимается ДО перезаписи полей гранта: после неё прежнего состояния уже нет
	РольДо = РольЗаписи(Грант);

	// пустой набор — идемпотентный отзыв существующего гранта
	Если НЕ (Создание ИЛИ Изменение ИЛИ Удаление ИЛИ Чтение) Тогда
		Если Грант <> Неопределено Тогда
			ХранилищеПравДоступа.Удалить(Грант);
			ОпубликоватьИзменениеПрав(КтоСтрокой, "права.отозваны",
				НормТипСубъекта, СубъектИд, Объект, РольДо, "", Неопределено);
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;

	Если Грант = Неопределено Тогда
		Грант = ХранилищеПравДоступа.СоздатьЭлемент();
		Грант.ТипСубъекта = НормТипСубъекта;
		Грант.СубъектИдентификатор = Цел(СубъектИд);
		Грант.ТипОбъекта = НРег(СокрЛП(Строка(Объект.ТипОбъекта)));
		Грант.ОбъектИдентификатор = Цел(Объект.Идентификатор);
	КонецЕсли;
	Грант.Создание = Создание;
	Грант.Изменение = Изменение;
	Грант.Удаление = Удаление;
	Грант.Чтение = Чтение;
	Грант.КемВыдано = Цел(КемВыдано);
	Грант.Выдано = ТекущаяУниверсальнаяДата();
	Грант.Сохранить();

	ОпубликоватьИзменениеПрав(КтоСтрокой, "права.выданы", НормТипСубъекта, СубъектИд, Объект,
		РольДо, СервисПрав.РольПоНабору(НаборГранта(Грант)), Грант);

	Возврат Грант;

КонецФункции

// Системный отзыв ВСЕХ грантов субъекта — уборка при удалении самого субъекта.
// Достоверность объекта не спрашивается: удалённый объект гранта не должен мешать
// снять право, иначе строка остаётся сиротой и достаётся следующему субъекту с тем же
// идентификатором.
//
// Параметры:
//  ТипСубъекта - Строка - пользователь | группа.
//  СубъектИд - Число - идентификатор субъекта.
//  КтоСтрокой - Строка - принципал для журнала аудита (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Число - сколько грантов снято.
//
Функция ОтозватьГрантыСубъекта(Знач ТипСубъекта, Знач СубъектИд, Знач КтоСтрокой = "") Экспорт

	НормТипСубъекта = НормализоватьТипСубъекта(ТипСубъекта);

	Снято = 0;
	Для Каждого Грант Из ХранилищеПравДоступа.ГрантыСубъекта(НормТипСубъекта, Цел(СубъектИд)) Цикл
		Объект = СервисПрав.ОписаниеОбъекта(Грант.ТипОбъекта, Грант.ОбъектИдентификатор, 0);
		СнятаяРоль = РольЗаписи(Грант);
		ХранилищеПравДоступа.Удалить(Грант);
		ОпубликоватьИзменениеПрав(КтоСтрокой, "права.отозваны",
			НормТипСубъекта, СубъектИд, Объект, СнятаяРоль, "", Неопределено);
		Снято = Снято + 1;
	КонецЦикла;

	Возврат Снято;

КонецФункции

// Грант субъекта на объект.
//
// Параметры:
//  ТипСубъекта - Строка - пользователь | группа.
//  СубъектИд - Число - идентификатор субъекта.
//  Объект - Структура - описание объекта.
//
// Возвращаемое значение:
//  ПравоДоступа, Неопределено.
//
Функция НайтиГрант(Знач ТипСубъекта, Знач СубъектИд, Знач Объект) Экспорт
	Возврат ХранилищеПравДоступа.НайтиГрант(
		НормализоватьТипСубъекта(ТипСубъекта), Цел(СубъектИд),
		НРег(СокрЛП(Строка(Объект.ТипОбъекта))), Цел(Объект.Идентификатор));
КонецФункции

// Достоверное описание объекта: тип и идентификатор сверены с хранилищем, пул взят из
// сущности. Нужна и вызывающим вне auth, которые строят объект сами.
//
// Параметры:
//  Объект - Структура - описание объекта; может быть подделано клиентом.
//
// Возвращаемое значение:
//  Структура - описание с реальным ПулИдентификатором; несуществующий объект и
//              неизвестный тип — исключение.
//
Функция ДостоверныйОбъект(Знач Объект) Экспорт
	Возврат Достоверный(Объект);
КонецФункции

// Все гранты на объект — витрина «кто имеет доступ».
//
// Параметры:
//  Объект - Структура - описание объекта.
//
// Возвращаемое значение:
//  Массив из ПравоДоступа.
//
Функция ГрантыНаОбъект(Знач Объект) Экспорт
	Возврат ХранилищеПравДоступа.ГрантыНаОбъект(
		НРег(СокрЛП(Строка(Объект.ТипОбъекта))), Цел(Объект.Идентификатор));
КонецФункции

// Все гранты субъекта — витрина «на что есть права». Это строки выдачи, а не
// эффективные права: наследование и группы не учитываются, их считает СервисПрав.
//
// Параметры:
//  ТипСубъекта - Строка - пользователь | группа.
//  СубъектИд - Число - идентификатор субъекта.
//
// Возвращаемое значение:
//  Массив из ПравоДоступа.
//
Функция ГрантыСубъекта(Знач ТипСубъекта, Знач СубъектИд) Экспорт
	Возврат ХранилищеПравДоступа.ГрантыСубъекта(НормализоватьТипСубъекта(ТипСубъекта), Цел(СубъектИд));
КонецФункции

#КонецОбласти

#Область ЗащитаОбъекта

// Пул берётся из сущности и затирает пришедший; несуществующий объект — исключение.
Функция Достоверный(Знач Объект)

	Если Объект = Неопределено Тогда
		ВызватьИсключение "Объект права доступа не задан";
	КонецЕсли;

	Тип = НРег(СокрЛП(Строка(Объект.ТипОбъекта)));

	Если Тип = "хаб" Тогда
		Возврат СервисПрав.ОписаниеОбъекта("хаб", 0, 0);
	ИначеЕсли Тип = "пул" Тогда
		Пул = ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(Цел(Объект.Идентификатор));
		Если Пул = Неопределено Тогда
			ВызватьИсключение "Объект права доступа не найден: пул не существует";
		КонецЕсли;
		Возврат СервисПрав.ОписаниеОбъекта("пул", Пул.Идентификатор, Пул.Идентификатор);
	ИначеЕсли Тип = "пакет" Тогда
		Пакет = ХранилищеПакетов.ПолучитьОдноПоИдентификаторРавно(Цел(Объект.Идентификатор));
		Если Пакет = Неопределено Тогда
			ВызватьИсключение "Объект права доступа не найден: пакет не существует";
		КонецЕсли;
		Возврат СервисПрав.ОписаниеОбъекта("пакет", Пакет.Идентификатор, Пакет.ПулИдентификатор);
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Неизвестный тип объекта права доступа ""%1"": поддерживаются хаб, пул и пакет", Объект.ТипОбъекта);

КонецФункции

// Порог управления правами на УЖЕ достоверном объекте (второй раз в хранилище не ходим).
Функция МожетВыдаватьНаДостоверном(Знач Пользователь, Знач Объект)
	Если СервисПрав.ПользовательАдмин(Пользователь) Тогда
		Возврат Истина;
	КонецЕсли;
	Если НРег(Строка(Объект.ТипОбъекта)) = "хаб" Тогда
		Лог.Отладка("Права: роли уровня хаба раздаёт только администратор хаба — отказ ""%1""",
			ИмяПринципала(Пользователь));
		Возврат Ложь; // роли уровня хаба раздаёт только админ хаба
	КонецЕсли;
	Решение = СервисПрав.РольНеНиже(Пользователь, Объект, СервисПрав.РольМейнтейнер());
	Лог.Отладка("Права: ""%1"" на объекте %2 #%3 при пороге ""%4"" — управление правами: %5",
		ИмяПринципала(Пользователь), Объект.ТипОбъекта, Объект.Идентификатор,
		СервисПрав.РольМейнтейнер(), Решение);
	Возврат Решение;
КонецФункции

// Сначала событие журнала безопасности, потом исключение: попытка эскалации обязана оставлять след.
Процедура ОтказатьВУправленииПравами(Знач КтоВыдаёт, Знач ТипСубъекта, Знач СубъектИд,
	Знач Объект, Знач ВидПопытки)

	Лог.Отладка("Права: %1 отклонена — ""%2"" не управляет правами объекта %3 #%4",
		ВидПопытки, ИмяПринципала(КтоВыдаёт), Объект.ТипОбъекта, Объект.Идентификатор);

	ОпубликоватьИзменениеПрав(ИмяПринципала(КтоВыдаёт), "права.отказано",
		ТипСубъекта, СубъектИд, Объект, "", "", Неопределено, ВидПопытки);

	ВызватьИсключение СтрШаблон(
		"Недостаточно прав для управления правами доступа к объекту: требуется роль"
		+ " мейнтейнера и выше%1", ?(НРег(Строка(Объект.ТипОбъекта)) = "хаб",
			" (роли уровня хаба выдаёт только администратор хаба)", ""));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НормализоватьТипСубъекта(Знач ТипСубъекта)
	Норм = НРег(СокрЛП(Строка(ТипСубъекта)));
	Если Норм <> "пользователь" И Норм <> "группа" Тогда
		ВызватьИсключение СтрШаблон("Некорректный тип субъекта ""%1"": ожидается пользователь или группа", ТипСубъекта);
	КонецЕсли;
	Возврат Норм;
КонецФункции

Функция Флаг(Знач Действия, Знач Имя)
	Если Действия = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Значение = Ложь;
	Если Действия.Свойство(Имя, Значение) Тогда
		Возврат Значение = Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция НаборГранта(Знач Грант)
	Возврат Новый Структура("создание, изменение, удаление, чтение",
		Грант.Создание = Истина, Грант.Изменение = Истина,
		Грант.Удаление = Истина, Грант.Чтение = Истина);
КонецФункции

// Принципал для журнала: логин инициатора либо сам хаб.
Функция ИмяПринципала(Знач Пользователь)
	Возврат ?(Пользователь = Неопределено, ИменаЖурнала.Система(), Строка(Пользователь.Логин));
КонецФункции

// Издатель опционален: право пишется и без модуля события, но пропажа аудита видна в логе.
Процедура ОпубликоватьИзменениеПрав(Знач Кто, Знач Действие, Знач ТипСубъекта, Знач СубъектИд,
	Знач Объект, Знач РольДо, Знач РольПосле, Знач Грант, Знач ВидПопытки = "")

	Лог.Отладка("Права: %1 — субъект %2 #%3 на объекте %4 #%5, роль ""%6"" → ""%7""",
		Действие, ТипСубъекта, СубъектИд, Объект.ТипОбъекта, Объект.Идентификатор,
		ИмяРоли(РольДо), ИмяРоли(РольПосле));

	Если Издатель = Неопределено Тогда
		Лог.Предупреждение(
			"Аудит прав доступа отключён: издатель событий не собран в контейнере."
			+ " Изменение прав (%1) в журнал НЕ ПОПАЛО", Действие);
		Возврат;
	КонецЕсли;

	НормТип = НРег(СокрЛП(Строка(ТипСубъекта)));
	Субъект = ИменаЖурнала.Субъект(НормТип, СубъектИд);

	Детали = Новый Структура();
	Детали.Вставить("тип_субъекта", НормТип);
	Детали.Вставить("субъект_ид", Цел(СубъектИд));
	Детали.Вставить("субъект", Субъект);
	// прежнее состояние обязательно: без него понижение роли неотличимо от повышения
	Детали.Вставить("роль_было", ИмяРоли(РольДо));
	Детали.Вставить("роль_стало", ИмяРоли(РольПосле));
	Если ЗначениеЗаполнено(ВидПопытки) Тогда
		Детали.Вставить("попытка", Строка(ВидПопытки));
	КонецЕсли;
	Если Грант <> Неопределено Тогда
		Детали.Вставить("действия", СтрСоединить(ДействияСписком(Грант), ","));
	КонецЕсли;

	Издатель.Опубликовать(Издатель.ТипПраваИзменены(), СобытиеЖурнала.Собрать(
		Кто, Действие, ИменаЖурнала.ПоТипу(Объект.ТипОбъекта, Объект.Идентификатор),
		Субъект, Детали));

КонецПроцедуры

Функция ИмяРоли(Знач Роль)
	Возврат ?(ЗначениеЗаполнено(Роль), Строка(Роль), "нет");
КонецФункции

Функция ДействияСписком(Знач Грант)
	Список = Новый Массив();
	Если Грант.Чтение = Истина Тогда Список.Добавить("чтение"); КонецЕсли;
	Если Грант.Создание = Истина Тогда Список.Добавить("создание"); КонецЕсли;
	Если Грант.Изменение = Истина Тогда Список.Добавить("изменение"); КонецЕсли;
	Если Грант.Удаление = Истина Тогда Список.Добавить("удаление"); КонецЕсли;
	Возврат Список;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ХранилищеПравДоступа") _ХранилищеПравДоступа,
	&Пластилин(Значение = "ХранилищеПакетов") _ХранилищеПакетов,
	&Пластилин(Значение = "ХранилищеПулов") _ХранилищеПулов,
	&Пластилин(Значение = "ИмяОбъектаАудита") _Имена,
	&Пластилин(Значение = "СобытиеАудита") _Событие,
	&Пластилин(Значение = "ИздательСобытий") _Издатель = Неопределено,
	&Лог _Лог = Неопределено)

	СервисПрав = _СервисПрав;
	ХранилищеПравДоступа = _ХранилищеПравДоступа;
	ХранилищеПакетов = _ХранилищеПакетов;
	ХранилищеПулов = _ХранилищеПулов;
	ИменаЖурнала = _Имена;
	СобытиеЖурнала = _Событие;
	Издатель = _Издатель;
	// лог параметром — для прямого создания вне контейнера
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
