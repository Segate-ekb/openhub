// Чтение принципала запроса: кто за ним стоит и чем он предъявлен. Принципал бывает
// анонимным и приходит из разных дверей, поэтому чтение поля — правило, а не выражение:
// у принципала без учётки ответ «никто», а не исключение.

// Учётная запись принципала.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//
// Возвращаемое значение:
//  Пользователь, Неопределено - учётка либо Неопределено у анонима.
//
Функция Пользователь(Знач Принципал) Экспорт

	Если Принципал = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = Неопределено;
	Если Принципал.Свойство("Пользователь", Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Пришёл ли запрос с ключом доступа (PAT), а не по сессии браузера. Читается так же,
// как учётка: у принципала без способа ответ «нет», а не исключение.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоКлюч(Знач Принципал) Экспорт

	Если Принципал = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Способ = Неопределено;
	Если НЕ Принципал.Свойство("Способ", Способ) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НРег(СокрЛП(Строка(Способ))) = "token";

КонецФункции

&Прозвище("УчёткаПринципала")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
