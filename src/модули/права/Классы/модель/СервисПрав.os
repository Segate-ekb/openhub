// Ядро модели прав: эффективное право — аддитивное объединение источников, без explicit deny.
// Наружу модель говорит ролями: читатель → райтер → мейнтейнер → владелец, плюс админ хаба.

Перем СервисГрупп;              // СервисГрупп (auth)
Перем ХранилищеУчастниковПула;  // ХранилищеУчастниковПула (данные) — пресеты ролей на пуле
Перем ХранилищеПравДоступа;     // ХранилищеПравДоступа (данные) — гранулярные гранты
Перем ПроверяющийGitHub;        // ПроверяющийGitHub (auth)

#Область ПубличныйИнтерфейс

// Является ли пользователь администратором хаба (суперправо на всех объектах).
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект (аноним — Неопределено).
//
// Возвращаемое значение:
//  Булево.
//
Функция ПользовательАдмин(Знач Пользователь) Экспорт
	Возврат Пользователь <> Неопределено И НРег(Строка(Пользователь.РольХаба)) = "admin";
КонецФункции

// Объект уровня «хаб» — глобальный контейнер всех пулов.
//
// Возвращаемое значение:
//  Структура - описание объекта действия.
//
Функция ОбъектХаб() Экспорт
	Возврат ОписаниеОбъекта("хаб", 0, 0);
КонецФункции

// Объект «пул».
//
// Параметры:
//  Пул - Пул - пул хаба.
//
// Возвращаемое значение:
//  Структура - описание объекта действия.
//
Функция ОбъектПул(Знач Пул) Экспорт
	Возврат ОписаниеОбъекта("пул", Пул.Идентификатор, Пул.Идентификатор);
КонецФункции

// Объект «пакет»; несёт свой пул для наследования прав от него.
//
// Параметры:
//  Пакет - Пакет - пакет пула.
//
// Возвращаемое значение:
//  Структура - описание объекта действия.
//
Функция ОбъектПакет(Знач Пакет) Экспорт
	Возврат ОписаниеОбъекта("пакет", Пакет.Идентификатор, Пакет.ПулИдентификатор);
КонецФункции

// Нормализованное описание объекта действия из сырых полей.
//
// Параметры:
//  ТипОбъекта - Строка - хаб | пул | пакет; прочие типы прав не дают (fail-closed).
//  Идентификатор - Число - идентификатор объекта (0 для «хаб»).
//  ПулИдентификатор - Число - пул-контейнер для наследования
//                     (необязательный, по умолчанию 0).
//
// Возвращаемое значение:
//  Структура - ТипОбъекта (Строка), Идентификатор (Число), ПулИдентификатор (Число).
//
Функция ОписаниеОбъекта(Знач ТипОбъекта, Знач Идентификатор, Знач ПулИдентификатор = 0) Экспорт
	Возврат Новый Структура("ТипОбъекта, Идентификатор, ПулИдентификатор",
		НРег(СокрЛП(Строка(ТипОбъекта))), Цел(Идентификатор), Цел(ПулИдентификатор));
КонецФункции

// Разрешено ли субъекту (пользователю и его группам) действие над объектом.
// Аноним явных прав не имеет; публичное чтение решает обёртка МожетЧитать.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект (аноним — Неопределено).
//  Действие - Строка - создание | изменение | удаление | чтение.
//  Объект - Структура - результат ОбъектХаб, ОбъектПул или ОбъектПакет.
//  Снимок - Структура, Неопределено - снимок прав субъекта (СнимокПрав); Неопределено —
//           снять его на этот вопрос (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Булево.
//
Функция РазрешеноДействие(Знач Пользователь, Знач Действие, Знач Объект, Знач Снимок = Неопределено) Экспорт

	Если ПользовательАдмин(Пользователь) Тогда
		Возврат Истина;
	КонецЕсли;

	Набор = ЭффективныеДействия(Пользователь, Объект, Истина, Снимок);
	Возврат ДействиеВНаборе(Набор, Действие);

КонецФункции

// Снимок прав субъекта: все его гранты и все его роли, снятые разом. Экран, спрашивающий
// про десятки объектов подряд, снимает его один раз и передаёт во все проверки — иначе
// каждая пара «объект × субъект» стоит двух отдельных обращений к базе.
// Решения по снимку те же, что и без него: снимок подменяет только источник строк.
// Живёт снимок в пределах одного прохода: изменения прав он не видит, и переживший
// выдачу снимок разрешил бы уже отозванное.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект (аноним — Неопределено).
//
// Возвращаемое значение:
//  Структура, Неопределено - ПользовательИдентификатор (Число), Субъекты (Массив),
//                            Гранты (Массив из ПравоДоступа), Роли (Массив из УчастникПула),
//                            ГрантПоКлючу (Соответствие), РольПоКлючу (Соответствие);
//                            Неопределено для анонима.
//
Функция СнимокПрав(Знач Пользователь) Экспорт

	Если Пользователь = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Снимок = Новый Структура(
		"ПользовательИдентификатор, Субъекты, Гранты, Роли, ГрантПоКлючу, РольПоКлючу",
		Цел(Пользователь.Идентификатор), СубъектыПользователя(Пользователь),
		Новый Массив(), Новый Массив(), Новый Соответствие(), Новый Соответствие());

	Для Каждого Субъект Из Снимок.Субъекты Цикл

		Для Каждого Грант Из ХранилищеПравДоступа.ГрантыСубъекта(Субъект.Тип, Субъект.Ид) Цикл
			Снимок.Гранты.Добавить(Грант);
			ЗапомнитьПервый(Снимок.ГрантПоКлючу, КлючГранта(Субъект.Тип, Субъект.Ид,
				Грант.ТипОбъекта, Грант.ОбъектИдентификатор), Грант);
		КонецЦикла;

		Для Каждого Участие Из ХранилищеУчастниковПула.РолиСубъекта(Субъект.Тип, Субъект.Ид) Цикл
			Снимок.Роли.Добавить(Участие);
			ЗапомнитьПервый(Снимок.РольПоКлючу,
				КлючРоли(Участие.ПулИдентификатор, Субъект.Тип, Субъект.Ид), Участие);
		КонецЦикла;

	КонецЦикла;

	Возврат Снимок;

КонецФункции

// Эффективный набор действий субъекта на объекте: объединение грантов, пресетов ролей
// и наследования по иерархии.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект (аноним — Неопределено).
//  Объект - Структура - описание объекта действия.
//  МаскироватьСоздание - Булево - гасить ли «создание», пришедшее с уровня хаба на
//                        не-хаб-объект (необязательный, по умолчанию Истина); Ложь
//                        нужна резолву роли, ограничение касается действия, а не ранга.
//  Снимок - Структура, Неопределено - снимок прав субъекта (СнимокПрав); Неопределено —
//           снять его на этот вопрос (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - создание, изменение, удаление, чтение (Булево).
//
Функция ЭффективныеДействия(Знач Пользователь, Знач Объект, Знач МаскироватьСоздание = Истина,
	Знач Снимок = Неопределено) Экспорт

	Набор = ПустойНабор();
	Если Пользователь = Неопределено Тогда
		Возврат Набор;
	КонецЕсли;
	Если ПользовательАдмин(Пользователь) Тогда
		Возврат ПолныйНабор();
	КонецЕсли;

	Права = ПраваСубъекта(Пользователь, Снимок);
	Области = ОбластиОбъекта(Объект);

	// Создание не наследуется через границу Хаб→Пул: хаб-создание = право создать пул,
	// иначе оно, выданное всем ради self-service, раздало бы создание имён в public.
	ЦельХаб = (НРег(Строка(Объект.ТипОбъекта)) = "хаб");

	Для Каждого Область Из Области Цикл
		РазрешитьСоздание = НЕ (МаскироватьСоздание И Область.ТипОбъекта = "хаб" И НЕ ЦельХаб);
		Для Каждого Субъект Из Права.Субъекты Цикл
			Грант = Права.ГрантПоКлючу.Получить(КлючГранта(
				Субъект.Тип, Субъект.Ид, Область.ТипОбъекта, Область.ОбъектИд));
			Если Грант <> Неопределено Тогда
				ОбъединитьГрант(Набор, Грант, РазрешитьСоздание);
			КонецЕсли;
			// пресеты ролей живут только на уровне пула
			Если Область.ЭтоПул Тогда
				РольЗапись = Права.РольПоКлючу.Получить(
					КлючРоли(Область.ОбъектИд, Субъект.Тип, Субъект.Ид));
				Если РольЗапись <> Неопределено Тогда
					ОбъединитьПресет(Набор, РольЗапись.Роль);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Набор;

КонецФункции

// Может ли субъект читать пул: публичный читают все, включая анонима, приватный —
// только по праву чтения.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект (аноним — Неопределено).
//  Пул - Пул - проверяемый пул.
//  Снимок - Структура, Неопределено - снимок прав субъекта (СнимокПрав); Неопределено —
//           снять его на этот вопрос (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетЧитать(Знач Пользователь, Знач Пул, Знач Снимок = Неопределено) Экспорт
	Если ПулПубличный(Пул) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат РазрешеноДействие(Пользователь, "чтение", ОбъектПул(Пул), Снимок);
КонецФункции

// Публичен ли пул — его содержимое открыто всем, включая анонима. Единственная
// формулировка признака: и право чтения, и перечисление пулов спрашивают её.
//
// Параметры:
//  Пул - Пул, Неопределено - проверяемый пул.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПулПубличный(Знач Пул) Экспорт
	Возврат Пул <> Неопределено И НРег(Строка(Пул.Видимость)) = "public";
КонецФункции

// Может ли субъект писать в пул — есть ли у него создание либо изменение.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект (аноним — Неопределено).
//  Пул - Пул - проверяемый пул.
//  Снимок - Структура, Неопределено - снимок прав субъекта (СнимокПрав); Неопределено —
//           снять его на этот вопрос (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетПисать(Знач Пользователь, Знач Пул, Знач Снимок = Неопределено) Экспорт
	Объект = ОбъектПул(Пул);
	Возврат РазрешеноДействие(Пользователь, "создание", Объект, Снимок)
		ИЛИ РазрешеноДействие(Пользователь, "изменение", Объект, Снимок);
КонецФункции

// Может ли субъект администрировать пул — роль мейнтейнера и выше: настройки своего
// уровня, вложенные сущности и управление правами. Райтеру это недоступно.
// Вопрос задан ролью, а не голым «удалением на пуле»: набор из одного удаления ролью
// не является и администратором не делает.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект (аноним — Неопределено).
//  Пул - Пул - проверяемый пул.
//  Снимок - Структура, Неопределено - снимок прав субъекта (СнимокПрав); Неопределено —
//           снять его на этот вопрос (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетАдминистрировать(Знач Пользователь, Знач Пул, Знач Снимок = Неопределено) Экспорт
	Возврат РольНеНиже(Пользователь, ОбъектПул(Пул), РольМейнтейнер(), Снимок);
КонецФункции

// Может ли субъект создавать пулы — право создания на объекте «хаб».
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект (аноним — Неопределено).
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетСоздаватьПул(Знач Пользователь) Экспорт
	Возврат РазрешеноДействие(Пользователь, "создание", ОбъектХаб());
КонецФункции

// Может ли субъект назначить пул основным пулом хаба — право изменения на объекте «хаб»,
// а не на пуле: короткие адреса /download и /push принадлежат хабу целиком, и
// администратор отдельного пула не должен уводить их на себя.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект (аноним — Неопределено).
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетНазначатьОсновнойПул(Знач Пользователь) Экспорт
	Возврат РазрешеноДействие(Пользователь, "изменение", ОбъектХаб());
КонецФункции

// Может ли субъект удалить пул — право удаления на объекте «хаб», а не на пуле:
// жизненный цикл пула и администрирование его содержимого — разные права, иначе
// владелец любого личного пула распоряжался бы пулами хаба.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект (аноним — Неопределено).
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетУдалятьПул(Знач Пользователь) Экспорт
	Возврат РазрешеноДействие(Пользователь, "удаление", ОбъектХаб());
КонецФункции

// Обратный вопрос к модели прав: где субъекту вообще можно изменять. Нужен спискам
// с отбором «которыми я могу управлять», иначе они перебирают все пулы хаба.
// Возвращаются области, а не пакеты: содержимое пулов сервис прав не знает.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект (аноним — Неопределено).
//  Снимок - Структура, Неопределено - снимок прав субъекта (СнимокПрав); Неопределено —
//           снять его на этот вопрос (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - ВесьХаб (Булево — админ либо грант «изменение» на хаб),
//              Пулы (Массив из Число — пулы, изменяемые целиком),
//              Пакеты (Массив из Число — отдельные изменяемые пакеты).
//
Функция ОбластиИзменения(Знач Пользователь, Знач Снимок = Неопределено) Экспорт

	Результат = Новый Структура("ВесьХаб, Пулы, Пакеты", Ложь, Новый Массив(), Новый Массив());

	Если Пользователь = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если ПользовательАдмин(Пользователь) Тогда
		Результат.ВесьХаб = Истина;
		Возврат Результат;
	КонецЕсли;

	Права = ПраваСубъекта(Пользователь, Снимок);
	Пулы = Новый Соответствие();
	Пакеты = Новый Соответствие();

	Для Каждого Грант Из Права.Гранты Цикл
		Если Грант.Изменение <> Истина Тогда
			Продолжить;
		КонецЕсли;
		ТипОбъекта = НРег(СокрЛП(Строка(Грант.ТипОбъекта)));
		Если ТипОбъекта = "хаб" Тогда
			Результат.ВесьХаб = Истина;
		ИначеЕсли ТипОбъекта = "пул" Тогда
			Пулы.Вставить(Цел(Грант.ОбъектИдентификатор), Истина);
		ИначеЕсли ТипОбъекта = "пакет" Тогда
			Пакеты.Вставить(Цел(Грант.ОбъектИдентификатор), Истина);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Участие Из Права.Роли Цикл
		Если РангРоли(Участие.Роль) >= РангРоли(РольРайтер()) Тогда
			Пулы.Вставить(Цел(Участие.ПулИдентификатор), Истина);
		КонецЕсли;
	КонецЦикла;

	Для Каждого КиЗ Из Пулы Цикл
		Результат.Пулы.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Для Каждого КиЗ Из Пакеты Цикл
		Результат.Пакеты.Добавить(КиЗ.Ключ);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Эффективная роль пользователя на пуле по записям участия. Считается только по
// пресетам ролей, гранулярные гранты сюда не входят — полную картину даёт РольНаОбъекте.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект (аноним — Неопределено).
//  ПулИдентификатор - Число - идентификатор пула.
//  Снимок - Структура, Неопределено - снимок прав субъекта (СнимокПрав); Неопределено —
//           снять его на этот вопрос (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Строка - админ | мейнтейнер | райтер | читатель | "".
//
Функция РольНаПул(Знач Пользователь, Знач ПулИдентификатор, Знач Снимок = Неопределено) Экспорт

	Если Пользователь = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ПользовательАдмин(Пользователь) Тогда
		Возврат РольАдминХаба();
	КонецЕсли;

	Права = ПраваСубъекта(Пользователь, Снимок);

	ЛучшийРанг = 0;
	Для Каждого Субъект Из Права.Субъекты Цикл
		РольЗапись = Права.РольПоКлючу.Получить(
			КлючРоли(ПулИдентификатор, Субъект.Тип, Субъект.Ид));
		Если РольЗапись <> Неопределено Тогда
			ЛучшийРанг = Макс(ЛучшийРанг, РангРоли(РольЗапись.Роль));
		КонецЕсли;
	КонецЦикла;
	Возврат РольПоРангу(ЛучшийРанг);

КонецФункции

// Разрешён ли push. Новое имя требует создания на пуле, новая версия существующего
// пакета — изменения на пакете: захват имён отделён от публикации версий.
// Легаси-путь GitHub — дополнительный источник права, применим только при включённой
// опции хаба и только в основном пуле; проверка stateless, гранта не создаёт.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - принципал (Неопределено — токен или аноним).
//  Пул - Пул - пул публикации.
//  ИмяПакета - Строка - имя публикуемого пакета.
//  Токен - Строка - значение GitHub-токена для легаси-пути
//          (необязательный, по умолчанию "").
//  Пакет - Пакет, Неопределено - существующий пакет; Неопределено означает новое имя
//          (необязательный, по умолчанию Неопределено).
//  ЛегасиGitHubВключён - Булево - значение хаб-опции; умолчание Ложь сужает права
//                        вызывающему, забывшему его передать
//                        (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Булево.
//
Функция РазрешёнPush(Знач Пользователь, Знач Пул, Знач ИмяПакета, Знач Токен = "",
	Знач Пакет = Неопределено, Знач ЛегасиGitHubВключён = Ложь) Экспорт

	Если Пакет = Неопределено Тогда
		Разрешено = РазрешеноДействие(Пользователь, "создание", ОбъектПул(Пул));
	Иначе
		Разрешено = РазрешеноДействие(Пользователь, "изменение", ОбъектПакет(Пакет));
	КонецЕсли;
	Если Разрешено Тогда
		Возврат Истина;
	КонецЕсли;

	// условие закрытое: пропускаем именно этот случай, иначе отказ
	Если ЛегасиGitHubПрименим(Пул, ЛегасиGitHubВключён) И ЗначениеЗаполнено(Токен) Тогда
		Возврат ПроверяющийGitHub.ЕстьПравоЗаписи(Токен, СокрЛП(Строка(ИмяПакета)));
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Работает ли на этом пуле легаси-путь «GitHub-токен вместо роли»: опция хаба включена
// и пул — основной пул хаба (путь существует ради зеркала oscript-library). Спрашивается
// признак пула, а не его имя: переименование незаметно меняло бы поведение.
// Значение опции приходит параметром: инъекция СервисНастроек уронила бы ядро прав
// в каждом контейнере без модуля настройки.
//
// Параметры:
//  Пул - Пул, Неопределено - проверяемый пул.
//  ОпцияВключена - Булево - значение хаб-опции oshub.publish.github_legacy.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЛегасиGitHubПрименим(Знач Пул, Знач ОпцияВключена) Экспорт
	Возврат ОпцияВключена = Истина И Пул <> Неопределено И Пул.ЭтоДефолтный();
КонецФункции

#КонецОбласти

#Область РолеваяМодель

// Роль «читатель»: чтение сущности и всего вложенного.
//
// Возвращаемое значение:
//  Строка.
//
Функция РольЧитатель() Экспорт
	Возврат "читатель";
КонецФункции

// Роль «райтер»: читатель плюс запись и создание вложенных сущностей.
//
// Возвращаемое значение:
//  Строка.
//
Функция РольРайтер() Экспорт
	Возврат "райтер";
КонецФункции

// Роль «мейнтейнер»: райтер плюс настройки своего уровня, удаление вложенных
// и управление правами на свою сущность.
//
// Возвращаемое значение:
//  Строка.
//
Функция РольМейнтейнер() Экспорт
	Возврат "мейнтейнер";
КонецФункции

// Роль «владелец»: мейнтейнер плюс удаление самой сущности.
//
// Возвращаемое значение:
//  Строка.
//
Функция РольВладелец() Экспорт
	Возврат "владелец";
КонецФункции

// Роль «админ хаба»: всё на всех объектах; только он раздаёт роли уровня хаба.
//
// Возвращаемое значение:
//  Строка.
//
Функция РольАдминХаба() Экспорт
	Возврат "админ";
КонецФункции

// Роли, назначаемые на объект, от младшей к старшей (порядок значим — он же в UI).
// Админ хаба сюда не входит: это роль уровня хаба, а не выдача на объекте.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция РолиОбъекта() Экспорт
	Результат = Новый Массив();
	Результат.Добавить(РольЧитатель());
	Результат.Добавить(РольРайтер());
	Результат.Добавить(РольМейнтейнер());
	Результат.Добавить(РольВладелец());
	Возврат Результат;
КонецФункции

// Ранг роли. Понимает и легаси-имена reader/publisher/owner — они свёрнуты в ту же шкалу.
//
// Параметры:
//  Роль - Строка - имя роли.
//
// Возвращаемое значение:
//  Число - 0 нет · 1 читатель · 2 райтер · 3 мейнтейнер · 4 владелец · 5 админ хаба.
//
Функция РангРоли(Знач Роль) Экспорт

	НормРоль = НормализоватьРоль(Роль);
	Если НормРоль = РольАдминХаба() Тогда
		Возврат 5;
	ИначеЕсли НормРоль = РольВладелец() Тогда
		Возврат 4;
	ИначеЕсли НормРоль = РольМейнтейнер() Тогда
		Возврат 3;
	ИначеЕсли НормРоль = РольРайтер() Тогда
		Возврат 2;
	ИначеЕсли НормРоль = РольЧитатель() Тогда
		Возврат 1;
	КонецЕсли;
	Возврат 0;

КонецФункции

// Имя роли по рангу.
//
// Параметры:
//  Ранг - Число - ранг роли.
//
// Возвращаемое значение:
//  Строка - имя роли либо "" для ранга 0.
//
Функция РольПоРангу(Знач Ранг) Экспорт
	Если Ранг >= 5 Тогда
		Возврат РольАдминХаба();
	ИначеЕсли Ранг = 4 Тогда
		Возврат РольВладелец();
	ИначеЕсли Ранг = 3 Тогда
		Возврат РольМейнтейнер();
	ИначеЕсли Ранг = 2 Тогда
		Возврат РольРайтер();
	ИначеЕсли Ранг = 1 Тогда
		Возврат РольЧитатель();
	КонецЕсли;
	Возврат "";
КонецФункции

// Пресет роли: набор гранулярных действий, которым роль записывается в хранилище.
// Мейнтейнер и владелец дают на самом объекте один и тот же набор — разница между ними
// живёт на родителе, поэтому владельца различает только РольНаОбъекте.
//
// Параметры:
//  Роль - Строка - имя роли (легаси-имена тоже понимаются).
//
// Возвращаемое значение:
//  Структура - создание, изменение, удаление, чтение (Булево).
//
Функция НаборРоли(Знач Роль) Экспорт

	Набор = ПустойНабор();
	Ранг = РангРоли(Роль);
	Если Ранг >= РангРоли(РольЧитатель()) Тогда
		Набор.чтение = Истина;
	КонецЕсли;
	Если Ранг >= РангРоли(РольРайтер()) Тогда
		Набор.создание = Истина;
		Набор.изменение = Истина;
	КонецЕсли;
	Если Ранг >= РангРоли(РольМейнтейнер()) Тогда
		Набор.удаление = Истина;
	КонецЕсли;
	Возврат Набор;

КонецФункции

// Обратный резолв: набор гранулярных действий → имя роли. Совпадение точное, а не
// покрытие: набор {чтение, удаление} ролью не является, иначе витрина назвала бы
// читателем того, кто удаляет пакеты пула.
//
// Параметры:
//  Набор - Структура - создание, изменение, удаление, чтение (отсутствующие — Ложь).
//
// Возвращаемое значение:
//  Строка - читатель | райтер | мейнтейнер либо "", если набор не совпал ни с одним
//           пресетом (владельца по одному набору не отличить).
//
Функция РольПоНабору(Знач Набор) Экспорт

	Для Каждого ИмяРоли Из РолиОбъекта() Цикл
		Если РангРоли(ИмяРоли) > РангРоли(РольМейнтейнер()) Тогда
			Продолжить;
		КонецЕсли;
		Если НаборыСовпадают(Набор, НаборРоли(ИмяРоли)) Тогда
			Возврат ИмяРоли;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Эффективная роль субъекта на объекте — главный вопрос UI и гейтов. Учитывает личные
// права, группы, пресеты и наследование, плюс суперправо админа и владение через родителя.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект (аноним — Неопределено).
//  Объект - Структура - описание объекта действия.
//
// Возвращаемое значение:
//  Строка - админ | владелец | мейнтейнер | райтер | читатель | "".
//
Функция РольНаОбъекте(Знач Пользователь, Знач Объект, Знач Снимок = Неопределено) Экспорт

	Если Пользователь = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ПользовательАдмин(Пользователь) Тогда
		Возврат РольАдминХаба();
	КонецЕсли;

	// снимок снимается один раз на оба вопроса: их у роли два — набор и удаление родителя
	Права = ПраваСубъекта(Пользователь, Снимок);

	// Набор без маски создания: с маской носитель полного хаб-права резолвился бы
	// на любом пуле как «читатель», хотя вправе снести пул целиком.
	Роль = РольПоНабору(ЭффективныеДействия(Пользователь, Объект, Ложь, Права));
	Если РангРоли(Роль) = РангРоли(РольМейнтейнер())
		И УдалениеСамойСущностиРазрешено(Пользователь, Объект, Права) Тогда
		Возврат РольВладелец();
	КонецЕсли;
	Возврат Роль;

КонецФункции

// Порог «роль не ниже указанной» — форма, в которой гейты задают вопрос, не пересчитывая
// ранги у себя.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект (аноним — Неопределено).
//  Объект - Структура - описание объекта действия.
//  Роль - Строка - требуемый минимум.
//  Снимок - Структура, Неопределено - снимок прав субъекта (СнимокПрав); Неопределено —
//           снять его на этот вопрос (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Булево.
//
Функция РольНеНиже(Знач Пользователь, Знач Объект, Знач Роль, Знач Снимок = Неопределено) Экспорт
	Возврат РангРоли(РольНаОбъекте(Пользователь, Объект, Снимок)) >= РангРоли(Роль);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// owner → мейнтейнер, а не владелец: старый пресет никогда не давал удаления пула.
Функция НормализоватьРоль(Знач Роль)

	НормРоль = НРег(СокрЛП(Строка(Роль)));
	Если НормРоль = "owner" Тогда
		Возврат РольМейнтейнер();
	ИначеЕсли НормРоль = "publisher" Тогда
		Возврат РольРайтер();
	ИначеЕсли НормРоль = "reader" Тогда
		Возврат РольЧитатель();
	ИначеЕсли НормРоль = "admin" Тогда
		Возврат РольАдминХаба();
	КонецЕсли;
	Возврат НормРоль;

КонецФункции

// Совпадают ли наборы полностью — и по включённым действиям, и по выключенным.
Функция НаборыСовпадают(Знач Набор, Знач Эталон)
	Для Каждого КиЗ Из Эталон Цикл
		Если ДействиеВНаборе(Набор, КиЗ.Ключ) <> (КиЗ.Значение = Истина) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Право удалить саму сущность спрашивается у родителя; у объекта «хаб» родителя нет.
Функция УдалениеСамойСущностиРазрешено(Знач Пользователь, Знач Объект, Знач Снимок = Неопределено)

	Тип = НРег(СокрЛП(Строка(Объект.ТипОбъекта)));
	Если Тип = "пул" Тогда
		Возврат РазрешеноДействие(Пользователь, "удаление", ОбъектХаб(), Снимок);
	ИначеЕсли Тип = "пакет" Тогда
		Возврат РазрешеноДействие(Пользователь, "удаление",
			ОписаниеОбъекта("пул", Объект.ПулИдентификатор, Объект.ПулИдентификатор), Снимок);
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Снимок принадлежит одному субъекту, и вопрос о правах ДРУГОГО по нему — ошибка
// программиста, а не редкий случай: ответ был бы правами чужого человека. Падаем громко.
Функция ПраваСубъекта(Знач Пользователь, Знач Снимок)

	Если Снимок = Неопределено Тогда
		Возврат СнимокПрав(Пользователь);
	КонецЕсли;

	Если Снимок.ПользовательИдентификатор <> Цел(Пользователь.Идентификатор) Тогда
		ВызватьИсключение СтрШаблон(
			"Снимок прав снят для учётки %1, а спрашивают о %2: чужой снимок ответил бы"
				+ " чужими правами",
			Формат(Снимок.ПользовательИдентификатор, "ЧГ=0; ЧН=0"),
			Формат(Цел(Пользователь.Идентификатор), "ЧГ=0; ЧН=0"));
	КонецЕсли;

	Возврат Снимок;

КонецФункции

// Строки снимка адресуются теми же ключами, что и точечные отборы хранилищ: тип объекта
// берётся из записи как есть, потому что отбор базы сравнивает его тоже как есть.
Функция КлючГранта(Знач ТипСубъекта, Знач СубъектИдентификатор, Знач ТипОбъекта, Знач ОбъектИдентификатор)
	Возврат СтрШаблон("%1|%2|%3|%4", ТипСубъекта, Формат(Цел(СубъектИдентификатор), "ЧГ=0"),
		ТипОбъекта, Формат(Цел(ОбъектИдентификатор), "ЧГ=0"));
КонецФункции

Функция КлючРоли(Знач ПулИдентификатор, Знач ТипСубъекта, Знач СубъектИдентификатор)
	Возврат СтрШаблон("%1|%2|%3", Формат(Цел(ПулИдентификатор), "ЧГ=0"), ТипСубъекта,
		Формат(Цел(СубъектИдентификатор), "ЧГ=0"));
КонецФункции

// Первая строка, а не последняя: точечный отбор базы отдаёт ровно её.
Процедура ЗапомнитьПервый(Индекс, Знач Ключ, Знач Запись)
	Если Индекс.Получить(Ключ) = Неопределено Тогда
		Индекс.Вставить(Ключ, Запись);
	КонецЕсли;
КонецПроцедуры

// Субъекты пользователя: он сам и все его группы.
Функция СубъектыПользователя(Знач Пользователь)
	Список = Новый Массив();
	Список.Добавить(Новый Структура("Тип, Ид", "пользователь", Пользователь.Идентификатор));
	Для Каждого Группа Из СервисГрупп.ГруппыПользователя(Пользователь.Идентификатор) Цикл
		Список.Добавить(Новый Структура("Тип, Ид", "группа", Группа.Идентификатор));
	КонецЦикла;
	Возврат Список;
КонецФункции

// Неизвестный тип даёт пустой список (fail-closed): иначе хаб-грант накрывал бы подделанный ввод.
Функция ОбластиОбъекта(Знач Объект)

	Области = Новый Массив();
	Тип = Объект.ТипОбъекта;

	Если Тип <> "хаб" И Тип <> "пул" И Тип <> "пакет" Тогда
		Возврат Области;
	КонецЕсли;

	Области.Добавить(Область("хаб", 0, Ложь));

	Если Тип = "хаб" Тогда
		Возврат Области;
	КонецЕсли;

	Области.Добавить(Область("пул", Объект.ПулИдентификатор, Истина));

	Если Тип = "пакет" Тогда
		Области.Добавить(Область("пакет", Объект.Идентификатор, Ложь));
	КонецЕсли;

	Возврат Области;

КонецФункции

Функция Область(Знач ТипОбъекта, Знач ОбъектИд, Знач ЭтоПул)
	Возврат Новый Структура("ТипОбъекта, ОбъектИд, ЭтоПул", ТипОбъекта, Цел(ОбъектИд), ЭтоПул);
КонецФункции

Функция ПустойНабор()
	Возврат Новый Структура("создание, изменение, удаление, чтение", Ложь, Ложь, Ложь, Ложь);
КонецФункции

Функция ПолныйНабор()
	Возврат Новый Структура("создание, изменение, удаление, чтение", Истина, Истина, Истина, Истина);
КонецФункции

Функция ДействиеВНаборе(Знач Набор, Знач Действие)
	Норм = НРег(СокрЛП(Строка(Действие)));
	Значение = Ложь;
	Если Набор.Свойство(Норм, Значение) Тогда
		Возврат Значение = Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Процедура ОбъединитьГрант(Набор, Знач Грант, Знач РазрешитьСоздание = Истина)
	Если Грант.Создание = Истина И РазрешитьСоздание Тогда Набор.создание = Истина; КонецЕсли;
	Если Грант.Изменение = Истина Тогда Набор.изменение = Истина; КонецЕсли;
	Если Грант.Удаление = Истина Тогда Набор.удаление = Истина; КонецЕсли;
	Если Грант.Чтение = Истина Тогда Набор.чтение = Истина; КонецЕсли;
КонецПроцедуры

Процедура ОбъединитьПресет(Набор, Знач Роль)
	ОбъединитьНабор(Набор, НаборРоли(Роль));
КонецПроцедуры

Процедура ОбъединитьНабор(Набор, Знач Добавка)
	Если Добавка.создание = Истина Тогда Набор.создание = Истина; КонецЕсли;
	Если Добавка.изменение = Истина Тогда Набор.изменение = Истина; КонецЕсли;
	Если Добавка.удаление = Истина Тогда Набор.удаление = Истина; КонецЕсли;
	Если Добавка.чтение = Истина Тогда Набор.чтение = Истина; КонецЕсли;
КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп,
	&Пластилин(Значение = "ХранилищеУчастниковПула") _ХранилищеУчастниковПула,
	&Пластилин(Значение = "ХранилищеПравДоступа") _ХранилищеПравДоступа,
	&Пластилин(Значение = "ПроверяющийGitHub") _ПроверяющийGitHub)

	СервисГрупп = _СервисГрупп;
	ХранилищеУчастниковПула = _ХранилищеУчастниковПула;
	ХранилищеПравДоступа = _ХранилищеПравДоступа;
	ПроверяющийGitHub = _ПроверяющийGitHub;

КонецПроцедуры
