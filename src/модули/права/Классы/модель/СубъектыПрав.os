// Субъекты прав доступа — желудь модуля auth: перевод между идентификатором субъекта
// и его человеческим именем (логин пользователя либо имя группы).

Перем СервисПользователей;  // СервисПользователей
Перем СервисГрупп;          // СервисГрупп

#Область ПубличныйИнтерфейс

// Человеческое имя субъекта: логин пользователя либо имя группы.
//
// Параметры:
//  ТипСубъекта - Строка - "пользователь" | "группа" (регистр и пробелы не важны).
//  СубъектИд - Число.
//  Имена - Соответствие, Неопределено - готовые имена списка, снятые Имена(Записи);
//          Неопределено — спросить базу об этом субъекте (необязательный, по умолчанию
//          Неопределено).
//
// Возвращаемое значение:
//  Строка - логин, имя группы либо строковое представление идентификатора.
//
Функция Имя(Знач ТипСубъекта, Знач СубъектИд, Знач Имена = Неопределено) Экспорт

	Если Имена <> Неопределено Тогда
		Готовое = Имена.Получить(Ключ(ТипСубъекта, СубъектИд));
		Если Готовое <> Неопределено Тогда
			Возврат Готовое;
		КонецЕсли;
	КонецЕсли;

	Если ЭтоГруппа(ТипСубъекта) Тогда
		Группа = СервисГрупп.ПоИдентификатору(СубъектИд);
		Возврат ?(Группа = Неопределено, КакТекст(СубъектИд), Группа.Имя);
	КонецЕсли;

	Пользователь = СервисПользователей.ПоИдентификатору(СубъектИд);
	Возврат ?(Пользователь = Неопределено, КакТекст(СубъектИд), Пользователь.Логин);

КонецФункции

// Имена всех субъектов, названных списком записей прав, — по одному разрезу на тип
// субъекта. Таблица прав, спрашивающая имя на строку, стоила бы числа строк.
//
// Параметры:
//  Записи - Массив - записи с полями ТипСубъекта (Строка) и СубъектИдентификатор (Число).
//
// Возвращаемое значение:
//  Соответствие - готовые имена; читает его форма Имя(ТипСубъекта, СубъектИд, Имена),
//                 ключи наружу не показываются.
//
Функция Имена(Знач Записи) Экспорт

	Люди = Новый Массив();
	Группы = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Куда = ?(ЭтоГруппа(Запись.ТипСубъекта), Группы, Люди);
		Номер = Цел(Запись.СубъектИдентификатор);
		Если Куда.Найти(Номер) = Неопределено Тогда
			Куда.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Соответствие();
	НазватьГруппы(Результат, Группы);
	НазватьЛюдей(Результат, Люди);
	Возврат Результат;

КонецФункции

// Идентификатор субъекта по типу и человеческому имени; 0 — не найден.
//
// Параметры:
//  ТипСубъекта - Строка - "пользователь" | "группа".
//  Значение - Строка - логин пользователя либо имя группы (из формы).
//
// Возвращаемое значение:
//  Число - идентификатор либо 0.
//
Функция Идентификатор(Знач ТипСубъекта, Знач Значение) Экспорт

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;

	Если ЭтоГруппа(ТипСубъекта) Тогда
		Группа = СервисГрупп.НайтиГруппу(Значение);
		Возврат ?(Группа = Неопределено, 0, Группа.Идентификатор);
	КонецЕсли;

	Пользователь = СервисПользователей.НайтиПоЛогину(Значение);
	Возврат ?(Пользователь = Неопределено, 0, Пользователь.Идентификатор);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ключ субъекта в соответствии имён: один на обе формы вопроса. Наружу не выдаётся —
// снимок читается только через Имя(...), и форма ключа остаётся делом этого класса.
Функция Ключ(Знач ТипСубъекта, Знач СубъектИд)
	Возврат ?(ЭтоГруппа(ТипСубъекта), "группа", "пользователь") + "#" + КакТекст(СубъектИд);
КонецФункции

// Пропавшая группа называется номером — ровно так же, как и в одиночной форме вопроса.
Процедура НазватьГруппы(Имена, Знач Идентификаторы)

	Если Идентификаторы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Найденные = СервисГрупп.ПоИдентификаторам(Идентификаторы);
	Для Каждого Номер Из Идентификаторы Цикл
		Группа = Найденные.Получить(Номер);
		Имена.Вставить(Ключ("группа", Номер),
			?(Группа = Неопределено, КакТекст(Номер), Группа.Имя));
	КонецЦикла;

КонецПроцедуры

// Снесённая учётка называется номером — ровно так же, как и в одиночной форме вопроса.
Процедура НазватьЛюдей(Имена, Знач Идентификаторы)

	Если Идентификаторы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Найденные = СервисПользователей.ПоИдентификаторам(Идентификаторы);
	Для Каждого Номер Из Идентификаторы Цикл
		Пользователь = Найденные.Получить(Номер);
		Имена.Вставить(Ключ("пользователь", Номер),
			?(Пользователь = Неопределено, КакТекст(Номер), Пользователь.Логин));
	КонецЦикла;

КонецПроцедуры

// Нормализация типа субъекта: «Группа» и «группа » значат одно и то же.
Функция ЭтоГруппа(Знач ТипСубъекта)
	Возврат НРег(СокрЛП(Строка(ТипСубъекта))) = "группа";
КонецФункции

// Строковое представление идентификатора без разделителей групп разрядов: «17», не «17 ».
Функция КакТекст(Знач Значение)
	Возврат Формат(?(Значение = Неопределено, 0, Значение), "ЧН=0; ЧГ=0");
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп) Экспорт

	СервисПользователей = _СервисПользователей;
	СервисГрупп = _СервисГрупп;

КонецПроцедуры
