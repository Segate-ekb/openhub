// Субъекты прав доступа — желудь модуля auth: перевод между идентификатором субъекта
// и его человеческим именем (логин пользователя либо имя группы).

Перем СервисПользователей;  // СервисПользователей
Перем СервисГрупп;          // СервисГрупп

#Область ПубличныйИнтерфейс

// Человеческое имя субъекта: логин пользователя либо имя группы.
//
// Параметры:
//  ТипСубъекта - Строка - "пользователь" | "группа" (регистр и пробелы не важны).
//  СубъектИд - Число.
//
// Возвращаемое значение:
//  Строка - логин, имя группы либо строковое представление идентификатора.
//
Функция Имя(Знач ТипСубъекта, Знач СубъектИд) Экспорт

	Если ЭтоГруппа(ТипСубъекта) Тогда
		Группа = СервисГрупп.ПоИдентификатору(СубъектИд);
		Возврат ?(Группа = Неопределено, КакТекст(СубъектИд), Группа.Имя);
	КонецЕсли;

	Пользователь = СервисПользователей.ПоИдентификатору(СубъектИд);
	Возврат ?(Пользователь = Неопределено, КакТекст(СубъектИд), Пользователь.Логин);

КонецФункции

// Идентификатор субъекта по типу и человеческому имени; 0 — не найден.
//
// Параметры:
//  ТипСубъекта - Строка - "пользователь" | "группа".
//  Значение - Строка - логин пользователя либо имя группы (из формы).
//
// Возвращаемое значение:
//  Число - идентификатор либо 0.
//
Функция Идентификатор(Знач ТипСубъекта, Знач Значение) Экспорт

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;

	Если ЭтоГруппа(ТипСубъекта) Тогда
		Группа = СервисГрупп.НайтиГруппу(Значение);
		Возврат ?(Группа = Неопределено, 0, Группа.Идентификатор);
	КонецЕсли;

	Пользователь = СервисПользователей.НайтиПоЛогину(Значение);
	Возврат ?(Пользователь = Неопределено, 0, Пользователь.Идентификатор);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Нормализация типа субъекта: «Группа» и «группа » значат одно и то же.
Функция ЭтоГруппа(Знач ТипСубъекта)
	Возврат НРег(СокрЛП(Строка(ТипСубъекта))) = "группа";
КонецФункции

// Строковое представление идентификатора без разделителей групп разрядов: «17», не «17 ».
Функция КакТекст(Знач Значение)
	Возврат Формат(?(Значение = Неопределено, 0, Значение), "ЧН=0; ЧГ=0");
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп) Экспорт

	СервисПользователей = _СервисПользователей;
	СервисГрупп = _СервисГрупп;

КонецПроцедуры
