// Группы — носители прав. Членство двух видов: local (кабинет) и oidc (синхронизация
// из клеймов); источник у записи позволяет синхронизации не трогать локальные записи.

Перем ХранилищеГрупп;      // ХранилищеГрупп (данные)
Перем ХранилищеУчастников; // ХранилищеУчастниковГрупп (данные)
Перем Строки;              // КанонСтроки (основа)

// Создаёт группу. Пустое имя и дубль по каноническому имени — исключение.
//
// Параметры:
//  Имя - Строка - имя группы, канонизируется.
//  Описание - Строка - описание группы (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Группа - созданная группа.
//
Функция СоздатьГруппу(Знач Имя, Знач Описание = "") Экспорт

	КаноническоеИмя = КанонизироватьИмя(Имя);
	Если ПустаяСтрока(КаноническоеИмя) Тогда
		ВызватьИсключение "Имя группы не может быть пустым";
	КонецЕсли;
	Если ХранилищеГрупп.НайтиПоИмени(КаноническоеИмя) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон("Группа ""%1"" уже существует", КаноническоеИмя);
	КонецЕсли;

	Группа = ХранилищеГрупп.СоздатьЭлемент();
	Группа.Имя = КаноническоеИмя;
	Группа.Описание = Строка(Описание);
	Группа.Создана = ТекущаяУниверсальнаяДата();
	Группа.Сохранить();

	Возврат Группа;

КонецФункции

// Удаляет группу вместе с её членствами. Обвязку за пределами этих двух хранилищ
// (гранты, сопоставления OIDC, роли на пулах) снимает СлужбаГрупп.
//
// Параметры:
//  ГруппаИдентификатор - Число - идентификатор группы.
//
// Возвращаемое значение:
//  Булево - была ли группа удалена.
//
Функция УдалитьГруппу(Знач ГруппаИдентификатор) Экспорт

	Группа = ХранилищеГрупп.ПолучитьОдноПоИдентификаторРавно(Цел(ГруппаИдентификатор));
	Если Группа = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Участник Из ХранилищеУчастников.ПолучитьПоГруппаИдентификаторРавно(Цел(ГруппаИдентификатор)) Цикл
		ХранилищеУчастников.Удалить(Участник);
	КонецЦикла;
	ХранилищеГрупп.Удалить(Группа);

	Возврат Истина;

КонецФункции

// Группа по имени (канонизация внутри).
//
// Параметры:
//  Имя - Строка - имя группы в любом регистре.
//
// Возвращаемое значение:
//  Группа, Неопределено.
//
Функция НайтиГруппу(Знач Имя) Экспорт
	Возврат ХранилищеГрупп.НайтиПоИмени(КанонизироватьИмя(Имя));
КонецФункции

// Группа по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор группы.
//
// Возвращаемое значение:
//  Группа, Неопределено.
//
Функция ПоИдентификатору(Знач Идентификатор) Экспорт
	Возврат ХранилищеГрупп.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Все группы хаба.
//
// Возвращаемое значение:
//  Массив из Группа.
//
Функция ВсеГруппы() Экспорт
	Возврат ХранилищеГрупп.Все();
КонецФункции

// Добавляет пользователя в группу, идемпотентно. Источник вне {local, oidc} — исключение.
//
// Параметры:
//  ГруппаИдентификатор - Число - идентификатор группы.
//  ПользовательИдентификатор - Число - идентификатор пользователя.
//  Источник - Строка - local | oidc (необязательный, по умолчанию "local").
//
// Возвращаемое значение:
//  УчастникГруппы - существующая или созданная запись членства.
//
Функция ДобавитьУчастника(Знач ГруппаИдентификатор, Знач ПользовательИдентификатор,
	Знач Источник = "local") Экспорт

	Если Источник <> "local" И Источник <> "oidc" Тогда
		ВызватьИсключение СтрШаблон("Некорректный источник членства ""%1"": ожидается local или oidc", Источник);
	КонецЕсли;

	Существующая = ХранилищеУчастников.НайтиЧленство(ГруппаИдентификатор, ПользовательИдентификатор);
	Если Существующая <> Неопределено Тогда
		Возврат Существующая;
	КонецЕсли;

	Участник = ХранилищеУчастников.СоздатьЭлемент();
	Участник.ГруппаИдентификатор = ГруппаИдентификатор;
	Участник.ПользовательИдентификатор = ПользовательИдентификатор;
	Участник.Источник = Источник;
	Участник.Сохранить();

	Возврат Участник;

КонецФункции

// Удаляет пользователя из группы, если членство есть.
//
// Параметры:
//  ГруппаИдентификатор - Число - идентификатор группы.
//  ПользовательИдентификатор - Число - идентификатор пользователя.
//
// Возвращаемое значение:
//  Булево - было ли удалено членство.
//
Функция УдалитьУчастника(Знач ГруппаИдентификатор, Знач ПользовательИдентификатор) Экспорт

	Участник = ХранилищеУчастников.НайтиЧленство(ГруппаИдентификатор, ПользовательИдентификатор);
	Если Участник = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ХранилищеУчастников.Удалить(Участник);
	Возврат Истина;

КонецФункции

// Идентификаторы пользователей — участников группы.
//
// Параметры:
//  ГруппаИдентификатор - Число - идентификатор группы.
//
// Возвращаемое значение:
//  Массив из Число.
//
Функция УчастникиГруппы(Знач ГруппаИдентификатор) Экспорт

	Результат = Новый Массив();
	Для Каждого Участник Из ХранилищеУчастников.ПолучитьПоГруппаИдентификаторРавно(ГруппаИдентификатор) Цикл
		Результат.Добавить(Участник.ПользовательИдентификатор);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Состав группы с источником членства: администратору настроек нужно видеть, назначен
// участник вручную или пришёл из клеймов провайдера и вернётся после следующего входа.
//
// Параметры:
//  ГруппаИдентификатор - Число - идентификатор группы.
//
// Возвращаемое значение:
//  Массив из Структура - ПользовательИдентификатор (Число), Источник (Строка).
//
Функция СоставГруппы(Знач ГруппаИдентификатор) Экспорт

	Результат = Новый Массив();
	Для Каждого Участник Из ХранилищеУчастников.ПолучитьПоГруппаИдентификаторРавно(ГруппаИдентификатор) Цикл
		Результат.Добавить(Новый Структура("ПользовательИдентификатор, Источник",
			Участник.ПользовательИдентификатор,
			?(ЗначениеЗаполнено(Участник.Источник), Участник.Источник, "local")));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Группы, в которых состоит пользователь. Список групп нужен КАЖДОМУ вопросу о правах,
// поэтому сами группы читаются одним разрезом: поштучное чтение делало его цену
// множителем всей модели прав.
//
// Параметры:
//  ПользовательИдентификатор - Число - идентификатор пользователя.
//
// Возвращаемое значение:
//  Массив из Группа - в порядке записей членства; пропавшие группы пропущены.
//
Функция ГруппыПользователя(Знач ПользовательИдентификатор) Экспорт

	Членства = ХранилищеУчастников.ПолучитьПоПользовательИдентификаторРавно(ПользовательИдентификатор);
	ПоИдентификатору = ГруппыПоИдентификаторам(ИдентификаторыГрупп(Членства));

	Результат = Новый Массив();
	Для Каждого Участник Из Членства Цикл
		Группа = ПоИдентификатору.Получить(Цел(Участник.ГруппаИдентификатор));
		Если Группа <> Неопределено Тогда
			Результат.Добавить(Группа);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// --- служебные ---

Функция КанонизироватьИмя(Знач Имя)
	Возврат Строки.Канон(Имя);
КонецФункции

// Без повторов: две записи членства в одну группу спрашивают её один раз.
Функция ИдентификаторыГрупп(Знач Членства)

	Встреченные = Новый Соответствие();
	Список = Новый Массив();
	Для Каждого Участник Из Членства Цикл
		Идентификатор = Цел(Участник.ГруппаИдентификатор);
		Если Встреченные.Получить(Идентификатор) = Неопределено Тогда
			Встреченные.Вставить(Идентификатор, Истина);
			Список.Добавить(Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Возврат Список;

КонецФункции

Функция ГруппыПоИдентификаторам(Знач Идентификаторы)

	Результат = Новый Соответствие();
	Для Каждого Группа Из ХранилищеГрупп.ПолучитьПоИдентификаторВ(Идентификаторы) Цикл
		Результат.Вставить(Цел(Группа.Идентификатор), Группа);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеГрупп") _ХранилищеГрупп,
	&Пластилин(Значение = "ХранилищеУчастниковГрупп") _ХранилищеУчастников,
	&Пластилин(Значение = "КанонСтроки") _Строки = Неопределено)

	Строки = ?(_Строки = Неопределено, Новый КанонСтроки(), _Строки);
	ХранилищеГрупп = _ХранилищеГрупп;
	ХранилищеУчастников = _ХранилищеУчастников;

КонецПроцедуры
