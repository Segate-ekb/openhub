// Хранилище сопоставлений групп OIDC — репозиторий сущности «СопоставлениеГруппыOIDC».
// Правило маппинга: {issuer, имя_клейма, значение} → группа хаба.

// BSLLS:UnusedParameters-off

Перем Сам;   // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё

// Сопоставление по идентификатору.
//
// Параметры:
//  Идентификатор - Число.
//
// Возвращаемое значение:
//  СопоставлениеГруппыOIDC, Неопределено.
//
&МетодЗапроса
Функция ПолучитьОдноПоИдентификаторРавно(Идентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Все сопоставления одного провайдера (issuer) — для синхронизации членства на входе.
//
// Параметры:
//  Издатель - Строка - issuer провайдера.
//
// Возвращаемое значение:
//  Массив из СопоставлениеГруппыOIDC.
//
&МетодЗапроса
Функция ПолучитьПоИздательРавно(Издатель) Экспорт
	Возврат Неопределено;
КонецФункции

// Сопоставления, ведущие в конкретную группу (для админ-UI и очистки при удалении группы).
//
// Параметры:
//  ГруппаИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив из СопоставлениеГруппыOIDC.
//
&МетодЗапроса
Функция ПолучитьПоГруппаИдентификаторРавно(ГруппаИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Вся таблица сопоставлений без отбора.
//
// Возвращаемое значение:
//  Массив из СопоставлениеГруппыOIDC.
//
&МетодЗапроса
Функция ПолучитьПо() Экспорт
	Возврат Неопределено;
КонецФункции

// Сопоставление по полному ключу.
//
// Параметры:
//  ГруппаИдентификатор - Число.
//  Издатель - Строка.
//  ИмяКлейма - Строка.
//  ЗначениеКлейма - Строка.
//
// Возвращаемое значение:
//  СопоставлениеГруппыOIDC, Неопределено.
//
&МетодЗапроса
Функция ПолучитьОдноПоГруппаИдентификаторРавноИздательРавноИмяКлеймаРавноЗначениеРавно(
	ГруппаИдентификатор, Издатель, ИмяКлейма, ЗначениеКлейма) Экспорт
	Возврат Неопределено;
КонецФункции

// Все сопоставления хаба (админ-обзор).
//
// Возвращаемое значение:
//  Массив из СопоставлениеГруппыOIDC.
//
Функция Все() Экспорт
	Возврат Сам.Достать().ПолучитьПо();
КонецФункции

// Существующее сопоставление по полному ключу (идемпотентное создание / поиск для удаления).
//
// Параметры:
//  ГруппаИдентификатор - Число.
//  Издатель - Строка.
//  ИмяКлейма - Строка.
//  Значение - Строка.
//
// Возвращаемое значение:
//  СопоставлениеГруппыOIDC, Неопределено.
//
Функция НайтиСопоставление(Знач ГруппаИдентификатор, Знач Издатель, Знач ИмяКлейма, Знач Значение) Экспорт

	Возврат Сам.Достать().ПолучитьОдноПоГруппаИдентификаторРавноИздательРавноИмяКлеймаРавноЗначениеРавно(
		Цел(ГруппаИдентификатор), Строка(Издатель), Строка(ИмяКлейма), Строка(Значение));

КонецФункции

&ХранилищеСущностей("СопоставлениеГруппыOIDC")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеСопоставленийГруппOIDC") _Сам)

	Сам = _Сам;

КонецПроцедуры
