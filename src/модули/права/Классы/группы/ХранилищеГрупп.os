// Хранилище групп — репозиторий сущности «Группа».
// Имя канонизирует сервис (нижний регистр); поиск ждёт уже канонический вид.

// BSLLS:UnusedParameters-off

Перем Сам;   // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё

// Группа по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор группы.
//
// Возвращаемое значение:
//  Группа, Неопределено.
//
&МетодЗапроса
Функция ПолучитьОдноПоИдентификаторРавно(Идентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Группы перечисленных идентификаторов — один запрос на весь список; идентификаторы
// сравниваются как есть.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы групп.
//
// Возвращаемое значение:
//  Массив из Группа.
//
&МетодЗапроса
Функция ПолучитьПоИдентификаторВ(Идентификаторы) Экспорт
	Возврат Неопределено;
КонецФункции

// Группа по имени (значение сравнивается как есть, без канонизации).
//
// Параметры:
//  Имя - Строка - каноническое имя группы.
//
// Возвращаемое значение:
//  Группа, Неопределено.
//
&МетодЗапроса
Функция ПолучитьОдноПоИмяРавно(Имя) Экспорт
	Возврат Неопределено;
КонецФункции

// Группы перечисленных имён — один запрос на весь список (значения сравниваются как есть,
// без канонизации).
//
// Параметры:
//  Имена - Массив из Строка - канонические имена групп.
//
// Возвращаемое значение:
//  Массив из Группа.
//
&МетодЗапроса
Функция ПолучитьПоИмяВ(Имена) Экспорт
	Возврат Неопределено;
КонецФункции

// Вся таблица групп без отбора.
//
// Возвращаемое значение:
//  Массив из Группа.
//
&МетодЗапроса
Функция ПолучитьПо() Экспорт
	Возврат Неопределено;
КонецФункции

// Группы перечисленных идентификаторов одним запросом. В отличие от ПолучитьПоИдентификаторВ
// приводит идентификаторы к числу, так что годятся и строковые, а на пустой список отвечает
// пустой выдачей, не спрашивая базу.
//
// Параметры:
//  Идентификаторы - Массив из Число, Строка - идентификаторы групп.
//
// Возвращаемое значение:
//  Массив из Группа - найденные группы; ненайденных в выдаче нет, порядок не гарантируется.
//
Функция ГруппыПоИдентификаторам(Знач Идентификаторы) Экспорт

	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Целые = Новый Массив();
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Целые.Добавить(Цел(Идентификатор));
	КонецЦикла;

	Возврат Сам.Достать().ПолучитьПоИдентификаторВ(Целые);

КонецФункции

// Группа по имени (ожидается каноническим).
//
// Параметры:
//  Имя - Строка.
//
// Возвращаемое значение:
//  Группа, Неопределено.
//
Функция НайтиПоИмени(Знач Имя) Экспорт
	Возврат Сам.Достать().ПолучитьОдноПоИмяРавно(Имя);
КонецФункции

// Группы перечисленных имён одним запросом (имена ожидаются каноническими).
// Пустой список — пустая выдача.
//
// Параметры:
//  Имена - Массив из Строка - канонические имена групп.
//
// Возвращаемое значение:
//  Массив из Группа - найденные группы; ненайденных в выдаче нет.
//
Функция НайтиПоИменам(Знач Имена) Экспорт

	Если Имена.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат Сам.Достать().ПолучитьПоИмяВ(Имена);

КонецФункции

// Все группы.
//
// Возвращаемое значение:
//  Массив из Группа.
//
Функция Все() Экспорт
	Возврат Сам.Достать().ПолучитьПо();
КонецФункции

&ХранилищеСущностей("Группа")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеГрупп") _Сам)

	Сам = _Сам;

КонецПроцедуры
