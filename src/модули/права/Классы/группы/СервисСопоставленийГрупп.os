// Маппинг клеймов IdP на группы хаба и синхронизация членства при каждом входе.
// Локальные членства неприкосновенны: снимаются только записи с источником oidc.

Перем Хранилище;               // ХранилищеСопоставленийГруппOIDC (данные)
Перем СервисГрупп;             // СервисГрупп (auth)
Перем ХранилищеУчастников;     // ХранилищеУчастниковГрупп (данные)
Перем ХранилищеСвязок;         // ХранилищеСвязокГруппOIDC (данные) — политика и время сверки
Перем Провижининг;             // ПровижинингГруппOIDC (auth)

#Область УправлениеСопоставлениями

// Добавляет правило маппинга, идемпотентно по полному ключу. Пустые issuer и значение —
// исключение.
//
// Параметры:
//  ГруппаИдентификатор - Число - группа хаба, в которую ведёт правило.
//  Издатель - Строка - issuer провайдера.
//  Значение - Строка - значение клейма, например имя группы в IdP.
//  ИмяКлейма - Строка - имя клейма (необязательный, по умолчанию "groups").
//
// Возвращаемое значение:
//  СопоставлениеГруппыOIDC - созданное или уже существующее правило.
//
Функция ДобавитьСопоставление(Знач ГруппаИдентификатор, Знач Издатель, Знач Значение, Знач ИмяКлейма = "groups") Экспорт

	НормИздатель = СокрЛП(Строка(Издатель));
	НормКлейм = НормализоватьИмяКлейма(ИмяКлейма);
	НормЗначение = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(НормИздатель) ИЛИ ПустаяСтрока(НормЗначение) Тогда
		ВызватьИсключение "OIDC-маппинг: issuer и значение клейма не могут быть пустыми";
	КонецЕсли;

	Существующее = Хранилище.НайтиСопоставление(ГруппаИдентификатор, НормИздатель, НормКлейм, НормЗначение);
	Если Существующее <> Неопределено Тогда
		Возврат Существующее;
	КонецЕсли;

	Сопоставление = Хранилище.СоздатьЭлемент();
	Сопоставление.ГруппаИдентификатор = Цел(ГруппаИдентификатор);
	Сопоставление.Издатель = НормИздатель;
	Сопоставление.ИмяКлейма = НормКлейм;
	Сопоставление.Значение = НормЗначение;
	Сопоставление.Сохранить();
	Возврат Сопоставление;

КонецФункции

// Удаляет правило маппинга.
//
// Параметры:
//  ГруппаИдентификатор - Число - группа хаба, в которую ведёт правило.
//  Издатель - Строка - issuer провайдера.
//  Значение - Строка - значение клейма.
//  ИмяКлейма - Строка - имя клейма (необязательный, по умолчанию "groups").
//
// Возвращаемое значение:
//  Булево - было ли правило удалено.
//
Функция УдалитьСопоставление(Знач ГруппаИдентификатор, Знач Издатель, Знач Значение, Знач ИмяКлейма = "groups") Экспорт

	Существующее = Хранилище.НайтиСопоставление(
		ГруппаИдентификатор, СокрЛП(Строка(Издатель)), НормализоватьИмяКлейма(ИмяКлейма), СокрЛП(Строка(Значение)));
	Если Существующее = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Хранилище.Удалить(Существующее);
	Возврат Истина;

КонецФункции

// Снимает с группы всю её OIDC-обвязку: правила маппинга и строку связки с политикой.
//
// Параметры:
//  ГруппаИдентификатор - Число - группа хаба.
//
// Возвращаемое значение:
//  Число - сколько правил маппинга удалено.
//
Функция УдалитьСвязкиГруппы(Знач ГруппаИдентификатор) Экспорт

	Снято = 0;
	Для Каждого Правило Из Хранилище.ПолучитьПоГруппаИдентификаторРавно(Цел(ГруппаИдентификатор)) Цикл
		Хранилище.Удалить(Правило);
		Снято = Снято + 1;
	КонецЦикла;

	Связка = ХранилищеСвязок.НайтиПоГруппе(Цел(ГруппаИдентификатор));
	Если Связка <> Неопределено Тогда
		ХранилищеСвязок.Удалить(Связка);
	КонецЕсли;

	Возврат Снято;

КонецФункции

// Все правила маппинга провайдера.
//
// Параметры:
//  Издатель - Строка - issuer провайдера.
//
// Возвращаемое значение:
//  Массив из СопоставлениеГруппыOIDC.
//
Функция СопоставленияПровайдера(Знач Издатель) Экспорт
	Возврат Хранилище.ПолучитьПоИздательРавно(СокрЛП(Строка(Издатель)));
КонецФункции

// Все правила маппинга хаба (админ-обзор).
//
// Возвращаемое значение:
//  Массив из СопоставлениеГруппыOIDC.
//
Функция ВсеСопоставления() Экспорт
	Возврат Хранилище.Все();
КонецФункции

#КонецОбласти

#Область Синхронизация

// Синхронизирует OIDC-членство пользователя по актуальным клеймам провайдера: добавляет
// членства в целевые группы и снимает выпавшие из клеймов. Локальные членства не трогает.
//
// Параметры:
//  ПользовательИдентификатор - Число - синхронизируемый пользователь.
//  Издатель - Строка - issuer провайдера.
//  Клеймы - Соответствие - объединённые проверенные клеймы id_token и userinfo.
//  Провайдер - Структура, Неопределено - описание провайдера для провижининга и связки
//              по имени; параметр без умолчания намеренно — пропуск аргумента должен быть
//              ошибкой вызова, а явное Неопределено означает «только явные правила».
//
// Возвращаемое значение:
//  Структура - Добавлено, Удалено, Оставлено (Число); Оставлено — сколько выпавших
//              членств сохранила политика «оставлять».
//
Функция СинхронизироватьЧленство(Знач ПользовательИдентификатор, Знач Издатель, Знач Клеймы, Знач Провайдер) Экспорт

	НормИздатель = СокрЛП(Строка(Издатель));

	// явные правила маппинга, сработавшие по клеймам
	ЦелевыеГруппы = Новый Соответствие(); // ГруппаИд -> Истина
	Для Каждого Правило Из Хранилище.ПолучитьПоИздательРавно(НормИздатель) Цикл
		ЗначенияКлейма = ИзвлечьЗначенияКлейма(Клеймы, Правило.ИмяКлейма);
		Если ЗначениеВНаборе(ЗначенияКлейма, Правило.Значение) Тогда
			ЦелевыеГруппы.Вставить(Цел(Правило.ГруппаИдентификатор), Истина);
		КонецЕсли;
	КонецЦикла;

	// провижининг и связка по имени
	Для Каждого Идентификатор Из Провижининг.ЦелевыеГруппы(Провайдер, Клеймы) Цикл
		ЦелевыеГруппы.Вставить(Цел(Идентификатор), Истина);
	КонецЦикла;

	// уже локальное членство сохранит свой источник: СервисГрупп вернёт существующую запись
	Добавлено = 0;
	Для Каждого КиЗ Из ЦелевыеГруппы Цикл
		Запись = СервисГрупп.ДобавитьУчастника(КиЗ.Ключ, ПользовательИдентификатор, "oidc");
		Если Запись <> Неопределено Тогда
			Добавлено = Добавлено + 1;
		КонецЕсли;
		ОтметитьСинхронизацию(КиЗ.Ключ);
	КонецЦикла;

	Удалено = 0;
	Оставлено = 0;
	Для Каждого Членство Из ХранилищеУчастников.ПолучитьПоПользовательИдентификаторРавно(ПользовательИдентификатор) Цикл
		Если Строка(Членство.Источник) <> "oidc" Тогда
			Продолжить;
		КонецЕсли;
		Если ЦелевыеГруппы.Получить(Цел(Членство.ГруппаИдентификатор)) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Если ПолитикаВыпавших(Членство.ГруппаИдентификатор) = ПолитикаОставлять() Тогда
			Оставлено = Оставлено + 1;
			ОтметитьСинхронизацию(Членство.ГруппаИдентификатор);
			Продолжить;
		КонецЕсли;
		ХранилищеУчастников.Удалить(Членство);
		Удалено = Удалено + 1;
		ОтметитьСинхронизацию(Членство.ГруппаИдентификатор);
	КонецЦикла;

	Возврат Новый Структура("Добавлено, Удалено, Оставлено", Добавлено, Удалено, Оставлено);

КонецФункции

#КонецОбласти

#Область ПолитикаВыпавших

// Политика «исключать» — выпавший из клеймов участник снимается (умолчание).
//
// Возвращаемое значение:
//  Строка.
//
Функция ПолитикаИсключать() Экспорт
	Возврат "исключать";
КонецФункции

// Политика «оставлять» — выпавший из клеймов участник остаётся в группе.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПолитикаОставлять() Экспорт
	Возврат "оставлять";
КонецФункции

// Политика выпавших для группы; отсутствие настройки означает «исключать», иначе
// молчаливая смена поведения расширяла бы доступ задним числом.
//
// Параметры:
//  ГруппаИдентификатор - Число - группа хаба.
//
// Возвращаемое значение:
//  Строка - исключать | оставлять.
//
Функция ПолитикаВыпавших(Знач ГруппаИдентификатор) Экспорт

	Связка = ХранилищеСвязок.НайтиПоГруппе(ГруппаИдентификатор);
	Если Связка = Неопределено Тогда
		Возврат ПолитикаИсключать();
	КонецЕсли;
	Возврат ?(Строка(Связка.ПолитикаВыпавших) = ПолитикаОставлять(), ПолитикаОставлять(), ПолитикаИсключать());

КонецФункции

// Устанавливает политику выпавших для группы, идемпотентно. Неизвестное значение
// приводится к «исключать»: опечатка в форме не должна давать третий режим.
//
// Параметры:
//  ГруппаИдентификатор - Число - группа хаба.
//  Политика - Строка - исключать | оставлять.
//
// Возвращаемое значение:
//  Строка - фактически установленная политика.
//
Функция УстановитьПолитикуВыпавших(Знач ГруппаИдентификатор, Знач Политика) Экспорт

	Значение = ?(НРег(СокрЛП(Строка(Политика))) = ПолитикаОставлять(), ПолитикаОставлять(), ПолитикаИсключать());
	Связка = ОбеспечитьСвязку(ГруппаИдентификатор);
	Связка.ПолитикаВыпавших = Значение;
	Связка.Сохранить();
	Возврат Значение;

КонецФункции

// Время последней синхронизации состава группы с клеймами.
//
// Параметры:
//  ГруппаИдентификатор - Число - группа хаба.
//
// Возвращаемое значение:
//  Дата, Неопределено - Неопределено, если группа ещё не сверялась.
//
Функция СинхронизированаВ(Знач ГруппаИдентификатор) Экспорт

	Связка = ХранилищеСвязок.НайтиПоГруппе(ГруппаИдентификатор);
	Если Связка = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Связка.СинхронизированаВ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Связка.СинхронизированаВ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Значения клейма как массив строк: массив разворачивается, скаляр даёт один элемент.
Функция ИзвлечьЗначенияКлейма(Знач Клеймы, Знач ИмяКлейма)

	Результат = Новый Массив();
	Если ТипЗнч(Клеймы) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;

	Значение = Клеймы.Получить(ИмяКлейма);
	Если Значение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(СокрЛП(Строка(Элемент)));
		КонецЦикла;
	Иначе
		Стр = СокрЛП(Строка(Значение));
		Если ЗначениеЗаполнено(Стр) Тогда
			Результат.Добавить(Стр);
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЗначениеВНаборе(Знач Набор, Знач Искомое)
	Цель = СокрЛП(Строка(Искомое));
	Для Каждого Элемент Из Набор Цикл
		Если Элемент = Цель Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция НормализоватьИмяКлейма(Знач ИмяКлейма)
	Значение = СокрЛП(Строка(ИмяКлейма));
	Возврат ?(ПустаяСтрока(Значение), "groups", Значение);
КонецФункции

// Пишется при каждом касании группы: иначе стабильная группа выглядит брошенной.
Процедура ОтметитьСинхронизацию(Знач ГруппаИдентификатор)
	Связка = ОбеспечитьСвязку(ГруппаИдентификатор);
	Связка.СинхронизированаВ = ТекущаяУниверсальнаяДата();
	Связка.Сохранить();
КонецПроцедуры

// Строка связки создаётся лениво: группа без настроек живёт без строки, по умолчанию.
Функция ОбеспечитьСвязку(Знач ГруппаИдентификатор)

	Связка = ХранилищеСвязок.НайтиПоГруппе(ГруппаИдентификатор);
	Если Связка <> Неопределено Тогда
		Возврат Связка;
	КонецЕсли;

	Связка = ХранилищеСвязок.СоздатьЭлемент();
	Связка.ГруппаИдентификатор = Цел(ГруппаИдентификатор);
	Связка.ПолитикаВыпавших = ПолитикаИсключать();
	Возврат Связка;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеСопоставленийГруппOIDC") _Хранилище,
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп,
	&Пластилин(Значение = "ХранилищеУчастниковГрупп") _ХранилищеУчастников,
	&Пластилин(Значение = "ХранилищеСвязокГруппOIDC") _ХранилищеСвязок,
	&Пластилин(Значение = "ПровижинингГруппOIDC") _Провижининг)

	Хранилище = _Хранилище;
	СервисГрупп = _СервисГрупп;
	ХранилищеУчастников = _ХранилищеУчастников;
	ХранилищеСвязок = _ХранилищеСвязок;
	Провижининг = _Провижининг;

КонецПроцедуры
