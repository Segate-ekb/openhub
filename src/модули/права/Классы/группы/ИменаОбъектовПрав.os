// Имена групп для журнала аудита — реализация контракта ИменаОбъектовАудита.

Перем ХранилищеГрупп;  // ХранилищеГрупп (права)

// Типы объектов, которые называют права.
//
// Возвращаемое значение:
//  Массив из Строка - группа.
//
Функция НазываемыеТипы() Экспорт

	Результат = Новый Массив();
	Результат.Добавить("группа");
	Возврат Результат;

КонецФункции

// Имя группы.
//
// Параметры:
//  ТипОбъекта - Строка - группа.
//  Идентификатор - Число - идентификатор группы.
//
// Возвращаемое значение:
//  Структура, Неопределено - Имя (Строка) — имя группы, Пул (Строка) — пусто; Неопределено —
//   группы нет.
//
Функция ИменаОбъекта(Знач ТипОбъекта, Знач Идентификатор) Экспорт

	Найденная = ХранилищеГрупп.ПолучитьОдноПоИдентификаторРавно(Цел(Идентификатор));
	Если Найденная = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Имя, Пул", Найденная.Имя, "");

КонецФункции

&Прозвище("ИменаОбъектовАудита")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ХранилищеГрупп") _ХранилищеГрупп)
	ХранилищеГрупп = _ХранилищеГрупп;
КонецПроцедуры
