// Жизненный цикл группы целиком: заведение с проверкой уникальности имени и удаление
// вместе со всей обвязкой — гранты, роли на пулах, сопоставления OIDC, состав.

Перем СервисГрупп;             // СервисГрупп (auth)
Перем СервисСопоставлений;     // СервисСопоставленийГрупп (auth)
Перем СервисПравДоступа;       // СервисПравДоступа (auth)
Перем ХранилищеУчастниковПула; // ХранилищеУчастниковПула (данные) — пресеты ролей на пулах
Перем Снятие;                  // СнятиеСтрок (данные) — снятие пачки строк со счётом

#Область ПубличныйИнтерфейс

// Заводит группу. Пустое имя и дубль по каноническому имени — исключение.
//
// Параметры:
//  Имя - Строка - имя группы, канонизируется.
//  Описание - Строка - описание группы (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Группа - созданная группа.
//
Функция Создать(Знач Имя, Знач Описание = "") Экспорт
	Возврат СервисГрупп.СоздатьГруппу(Имя, Описание);
КонецФункции

// Удаляет группу и всё, что на неё ссылается. Права снимаются ПЕРВЫМИ: если уборка
// оборвётся, группа останется без доступа, а не с доступом без владельца.
//
// Параметры:
//  ГруппаИдентификатор - Число - идентификатор группы.
//  КтоСтрокой - Строка - принципал для журнала аудита (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Удалена (Булево), Грантов (Число), Ролей (Число), Сопоставлений (Число).
//
Функция Удалить(Знач ГруппаИдентификатор, Знач КтоСтрокой = "") Экспорт

	Идентификатор = Цел(ГруппаИдентификатор);

	Если СервисГрупп.ПоИдентификатору(Идентификатор) = Неопределено Тогда
		Возврат Итог(Ложь, 0, 0, 0);
	КонецЕсли;

	Грантов = СервисПравДоступа.ОтозватьГрантыСубъекта("группа", Идентификатор, КтоСтрокой);
	Ролей = СнятьРолиНаПулах(Идентификатор);
	Сопоставлений = СервисСопоставлений.УдалитьСвязкиГруппы(Идентификатор);

	Возврат Итог(СервисГрупп.УдалитьГруппу(Идентификатор), Грантов, Ролей, Сопоставлений);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СнятьРолиНаПулах(Знач ГруппаИдентификатор)
	Возврат Снятие.СнятьЧерез(ХранилищеУчастниковПула,
		ХранилищеУчастниковПула.РолиСубъекта("группа", ГруппаИдентификатор));
КонецФункции

Функция Итог(Знач Удалена, Знач Грантов, Знач Ролей, Знач Сопоставлений)
	Возврат Новый Структура("Удалена, Грантов, Ролей, Сопоставлений",
		Удалена, Грантов, Ролей, Сопоставлений);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп,
	&Пластилин(Значение = "СервисСопоставленийГрупп") _СервисСопоставлений,
	&Пластилин(Значение = "СервисПравДоступа") _СервисПравДоступа,
	&Пластилин(Значение = "ХранилищеУчастниковПула") _ХранилищеУчастниковПула,
	&Пластилин(Значение = "СнятиеСтрок") _Снятие)

	СервисГрупп = _СервисГрупп;
	СервисСопоставлений = _СервисСопоставлений;
	СервисПравДоступа = _СервисПравДоступа;
	ХранилищеУчастниковПула = _ХранилищеУчастниковПула;
	Снятие = _Снятие;

КонецПроцедуры
