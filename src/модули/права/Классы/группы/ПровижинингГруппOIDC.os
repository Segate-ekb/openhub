// Группы пользователя по клеймам OIDC. Два независимых механизма, оба выключены
// по умолчанию (включение расширяет влияние IdP на права хаба):
//   PROVISION_GROUPS   — группа с именем из клейма создаётся, если её нет (JIT);
//   LINK_GROUPS_BY_NAME — клейм связывается с уже созданной вручную группой того же
//                        имени, отсутствующая не создаётся.
// Префикс GROUP_PREFIX держит провижининг в своём пространстве имён: без него клейм
// «admins» приводит в локальную группу «admins» с её грантами на пулы.
// Имя из клейма валидируется: достоверное значение ещё не значит пригодное имя.

Перем СервисГрупп;  // СервисГрупп (auth)
&Лог
Перем Лог;

// Максимальная длина имени группы, полученного из клейма.
//
// Возвращаемое значение:
//  Число.
//
Функция ПределДлиныИмени() Экспорт
	Возврат 64;
КонецФункции

// Идентификаторы групп, которые полагаются пользователю по клеймам провайдера.
// Недостающие группы создаются только при включённом провижининге; непригодное как имя
// значение клейма пропускается, а не превращается в группу.
//
// Параметры:
//  Провайдер - Структура, Неопределено - описание провайдера: ИмяКлеймаГрупп,
//              ПровижинингГрупп, СвязкаГруппПоИмени, ПрефиксГрупп, Издатель.
//  Клеймы - Соответствие - объединённые проверенные клеймы id_token и userinfo.
//
// Возвращаемое значение:
//  Массив из Число - идентификаторы групп без дублей, в порядке клеймов; пустой, если
//                    оба механизма выключены.
//
Функция ЦелевыеГруппы(Знач Провайдер, Знач Клеймы) Экспорт

	Результат = Новый Массив();
	Если Провайдер = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Создавать = Флаг(Провайдер, "ПровижинингГрупп");
	Связывать = Флаг(Провайдер, "СвязкаГруппПоИмени");
	Если НЕ Создавать И НЕ Связывать Тогда
		Возврат Результат; // оба механизма выключены — имя клейма ничего не значит
	КонецЕсли;

	Префикс = НРег(СокрЛП(Строка(Поле(Провайдер, "ПрефиксГрупп", ""))));
	Учтённые = Новый Соответствие();

	Для Каждого Значение Из ЗначенияКлейма(Клеймы, Поле(Провайдер, "ИмяКлеймаГрупп", "groups")) Цикл

		Имя = ИмяГруппы(Префикс, Значение);
		Если НЕ ЗначениеЗаполнено(Имя) Тогда
			Продолжить; // значение клейма непригодно как имя группы — уже залогировано
		КонецЕсли;

		Группа = СервисГрупп.НайтиГруппу(Имя);
		Если Группа = Неопределено Тогда
			Если НЕ Создавать Тогда
				Продолжить; // связка по имени НЕ создаёт групп — это её отличие от JIT
			КонецЕсли;
			Группа = СоздатьГруппу(Имя, Поле(Провайдер, "Издатель", ""));
			Если Группа = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Идентификатор = Цел(Группа.Идентификатор);
		Если Учтённые.Получить(Идентификатор) = Неопределено Тогда
			Учтённые.Вставить(Идентификатор, Истина);
			Результат.Добавить(Идентификатор);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#Область СлужебныеПроцедурыИФункции

// Имя группы из значения клейма: префикс + канонизированное значение. Пусто, если
// значение непригодно (пустое, длинное, посторонние символы) — тогда шаг пропускается.
Функция ИмяГруппы(Знач Префикс, Знач Значение)

	Канон = НРег(СокрЛП(Строка(Значение)));
	Если ПустаяСтрока(Канон) Тогда
		Возврат "";
	КонецЕсли;

	Имя = Префикс + Канон;
	Если СтрДлина(Имя) > ПределДлиныИмени() Тогда
		Лог.Предупреждение("OIDC-провижининг: значение клейма <%1> пропущено — имя группы длиннее %2 символов",
			Канон, ПределДлиныИмени());
		Возврат "";
	КонецЕсли;

	Если НЕ ДопустимоеИмя(Имя) Тогда
		Лог.Предупреждение("OIDC-провижининг: значение клейма <%1> пропущено — недопустимые символы в имени группы", Канон);
		Возврат "";
	КонецЕсли;

	Возврат Имя;

КонецФункции

// Латиница, цифры и «-», «_», «.»: имя группы попадает в адрес /groups/{g}/settings,
// поэтому пробелы, слеши и кириллица отбрасываются.
Функция ДопустимоеИмя(Знач Имя)

	Разрешённые = "abcdefghijklmnopqrstuvwxyz0123456789-_.";
	Для Поз = 1 По СтрДлина(Имя) Цикл
		Если СтрНайти(Разрешённые, Сред(Имя, Поз, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Создаёт группу JIT. Гонка двух одновременных входов разрешается перечитыванием:
// проигравший получает исключение «уже существует» и берёт созданную соперником.
Функция СоздатьГруппу(Знач Имя, Знач Издатель)

	Попытка
		Возврат СервисГрупп.СоздатьГруппу(Имя,
			СтрШаблон("Создана провижинингом OIDC (%1)", СокрЛП(Строка(Издатель))));
	Исключение
		Существующая = СервисГрупп.НайтиГруппу(Имя);
		Если Существующая <> Неопределено Тогда
			Возврат Существующая;
		КонецЕсли;
		Лог.Предупреждение("OIDC-провижининг: группа <%1> не создана: %2", Имя, ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Значения клейма как массив строк: массив → каждый элемент; скаляр → один элемент.
Функция ЗначенияКлейма(Знач Клеймы, Знач ИмяКлейма)

	Результат = Новый Массив();
	Если ТипЗнч(Клеймы) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;

	Значение = Клеймы.Получить(СокрЛП(Строка(ИмяКлейма)));
	Если Значение = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(СокрЛП(Строка(Элемент)));
		КонецЦикла;
	Иначе
		Результат.Добавить(СокрЛП(Строка(Значение)));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция Флаг(Знач Провайдер, Знач Имя)
	Возврат Поле(Провайдер, Имя, Ложь) = Истина;
КонецФункции

Функция Поле(Знач Провайдер, Знач Имя, Знач ПоУмолчанию)
	Если ТипЗнч(Провайдер) <> Тип("Структура") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Значение = ПоУмолчанию;
	Если Провайдер.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп)

	СервисГрупп = _СервисГрупп;

КонецПроцедуры
