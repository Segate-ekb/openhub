// Хранилище участников групп — репозиторий сущности «УчастникГруппы».
// Поле Источник отделяет local от oidc, чтобы синхронизация не трогала локальные записи.

// BSLLS:UnusedParameters-off

#Использовать entity

Перем Сам;        // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё
Перем Агрегаты;   // АгрегатыБазы (данные) — разрез по группам спрашивается у базы

// Участники группы.
//
// Параметры:
//  ГруппаИдентификатор - Число - идентификатор группы.
//
// Возвращаемое значение:
//  Массив из УчастникГруппы.
//
&МетодЗапроса
Функция ПолучитьПоГруппаИдентификаторРавно(ГруппаИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Членства пользователя во всех группах.
//
// Параметры:
//  ПользовательИдентификатор - Число - идентификатор пользователя.
//
// Возвращаемое значение:
//  Массив из УчастникГруппы.
//
&МетодЗапроса
Функция ПолучитьПоПользовательИдентификаторРавно(ПользовательИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Членство пользователя в конкретной группе.
//
// Параметры:
//  ГруппаИдентификатор - Число - идентификатор группы.
//  ПользовательИдентификатор - Число - идентификатор пользователя.
//
// Возвращаемое значение:
//  УчастникГруппы, Неопределено.
//
&МетодЗапроса
Функция ПолучитьОдноПоГруппаИдентификаторРавноИПользовательИдентификаторРавно(
	ГруппаИдентификатор, ПользовательИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Запись членства пользователя в конкретной группе (или Неопределено).
//
// Параметры:
//  ГруппаИдентификатор - Число.
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  УчастникГруппы, Неопределено.
//
Функция НайтиЧленство(Знач ГруппаИдентификатор, Знач ПользовательИдентификатор) Экспорт

	Возврат Сам.Достать().ПолучитьОдноПоГруппаИдентификаторРавноИПользовательИдентификаторРавно(
		ГруппаИдентификатор, ПользовательИдентификатор);

КонецФункции

// Сколько участников в каждой из названных групп — одним разрезом вместо вопроса
// про каждую группу.
//
// Параметры:
//  ГруппаИдентификаторы - Массив из Число - идентификаторы групп.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (идентификатор группы), значение Число; пустых групп в нём нет.
//
Функция СчётПоГруппам(Знач ГруппаИдентификаторы) Экспорт

	Целые = Новый Массив();
	Для Каждого Идентификатор Из ГруппаИдентификаторы Цикл
		Целые.Добавить(Цел(Идентификатор));
	КонецЦикла;

	Возврат Агрегаты.КоличествоПоКлючу(Сам.Достать(), "ГруппаИдентификатор",
		Новый ОпцииПоиска().Отбор("ГруппаИдентификатор", ВидСравнения.В, Целые));

КонецФункции

&ХранилищеСущностей("УчастникГруппы")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеУчастниковГрупп") _Сам,
	&Пластилин(Значение = "АгрегатыБазы") _Агрегаты)

	Сам = _Сам;
	Агрегаты = _Агрегаты;

КонецПроцедуры
