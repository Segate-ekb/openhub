// Реализация ПроверяющийGitHub через GitHub REST API: GET /repos/{организация}/{пакет}
// с токеном, читается permissions.push. Любая ошибка или недоступность → Ложь
// (fail-closed). Выключателем служит настройка хаба oshub.publish.github_legacy —
// та же, что открывает публикацию по GitHub-токену; второго рубильника нет.
// В тестах в реальный GitHub не ходим: класс подменяется фейком контракта.

Перем Настройки;     // СервисНастроек (настройки) - резолвер конфиг → база → дефолт
Перем БазовыйАдрес;  // Строка - хост GitHub API (переопределяемо для тестов/GHE)
Перем Транспорт;     // ТранспортHTTP - единый исходящий HTTP-клиент (1connector)
&Лог
Перем Лог;

// Есть ли у владельца токена право записи (push) в репозиторий зеркала для этого пакета.
// Реализация контракта ПроверяющийGitHub через GitHub REST API.
//
// Параметры:
//  Токен - Строка - GitHub-токен из заголовка запроса.
//  ИмяПакета - Строка - имя пакета; репозиторий зеркала — «организация/имя».
//
// Возвращаемое значение:
//  Булево - Ложь при выключенной проверке, отсутствии права, пустом токене и любой
//           ошибке обращения к GitHub (fail-closed).
//
Функция ЕстьПравоЗаписи(Знач Токен, Знач ИмяПакета) Экспорт

	Если НЕ Включена() ИЛИ НЕ ЗначениеЗаполнено(Токен) ИЛИ НЕ ЗначениеЗаполнено(ИмяПакета) Тогда
		Возврат Ложь;
	КонецЕсли;

	ИмяРепозитория = Настройки.Значение("oshub.publish.github.org")
		+ "/" + СокрЛП(Строка(ИмяПакета));
	Попытка
		Право = ЗапроситьПраво(СокрЛП(Строка(Токен)), ИмяРепозитория);
		Лог.Отладка("Легаси-право GitHub: репозиторий %1 — право записи: %2",
			ИмяРепозитория, Право);
		Возврат Право;
	Исключение
		Лог.Предупреждение("Проверка права записи в GitHub-репозиторий %1 не удалась (fail-closed): %2",
			ИмяРепозитория, СтрЗаменить(ОписаниеОшибки(), Символы.ПС, " "));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// --- служебные ---

// Значение спрашивается на каждый вызов: настройка правится из интерфейса и обязана
// действовать сразу. Нет резолвера или ошибка чтения — выключено (fail-closed):
// внешний источник права не включается по недоразумению.
Функция Включена()

	Если Настройки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Возврат Настройки.Значение("oshub.publish.github_legacy") = Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ЗапроситьПраво(Знач Токен, Знач ИмяРепозитория)

	URL = "https://" + БазовыйАдрес + "/repos/" + ИмяРепозитория;

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Authorization", "token " + Токен);
	Заголовки.Вставить("User-Agent", "OpenHub");
	Заголовки.Вставить("Accept", "application/vnd.github+json");

	Ответ = Транспорт.Получить(URL, Заголовки, ТаймаутСек());
	Если Ответ.Код <> 200 Тогда
		Возврат Ложь; // нет доступа к репозиторию или ошибка авторизации
	КонецЕсли;

	Тело = ПолучитьСтрокуИзДвоичныхДанных(Ответ.Данные, "UTF-8");
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Тело);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Права = Данные.Получить("permissions");
	Если ТипЗнч(Права) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Права.Получить("push") = Истина;

КонецФункции

// Своё значение, не общее с каталогом репозиториев: здесь один запрос на push, а там
// до трёх на вход, и суммарное ожидание человека считается отдельно.
Функция ТаймаутСек()
	Возврат 15;
КонецФункции

// Лог параметром — для создания объекта через `Новый` вне контейнера: инъекция
// в поле `&Лог` туда не доезжает.
&Прозвище("ПроверяющийGitHub")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТранспортHTTP") _Транспорт,
	&Пластилин(Значение = "СервисНастроек") _Настройки = Неопределено,
	&Деталька(Значение = "oshub.publish.github.api", ЗначениеПоУмолчанию = "api.github.com") АдресЗначение = Неопределено,
	&Лог _Лог = Неопределено)

	// Лог параметром — только при прямом создании; в контейнере поле прилепит напильник.
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Транспорт = _Транспорт;
	Настройки = _Настройки;
	БазовыйАдрес = ?(ЗначениеЗаполнено(АдресЗначение), Строка(АдресЗначение), "api.github.com");

КонецПроцедуры
