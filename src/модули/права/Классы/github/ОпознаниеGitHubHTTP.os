// Реализация ОпознаниеGitHub через GitHub REST API: GET /user с токеном, читается login.
// Любой сбой — пустая строка: опознание подписывает публикацию, а не решает её судьбу.

#Использовать url

Перем Транспорт;     // ТранспортHTTP (сеть) — единый исходящий HTTP-клиент
Перем Таймауты;      // ТаймаутыHTTP (сеть)
Перем Ошибки;        // ТекстОшибки (основа) — маска секрета одна на хаб
&Лог
Перем Лог;
Перем АдресПрофиля;  // Строка — адрес профиля владельца токена в GitHub API
Перем ФормаЛогина;   // РегулярноеВыражение — чем логин GitHub бывает

// Логин владельца токена на GitHub. Реализация контракта ОпознаниеGitHub.
//
// Параметры:
//  Токен - Строка - GitHub-токен из заголовка запроса.
//
// Возвращаемое значение:
//  Строка - логин; пустая строка при пустом токене, не-200, ответе без годного login
//           и любой ошибке обращения к GitHub. Исключений не бросает.
//
Функция Логин(Знач Токен) Экспорт

	Значение = СокрЛП(Строка(Токен));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат ЛогинИзОтвета(Транспорт.Получить(АдресПрофиля, ЗаголовкиЗапроса(Значение),
			Таймауты.ТаймаутСлужебногоЗапроса()));
	Исключение
		Лог.Предупреждение("Владелец GitHub-токена не опознан: %1",
			Ошибки.БезСекрета(Ошибки.Однострочно(ОписаниеОшибки()), Значение));
		Возврат "";
	КонецПопытки;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ЗаголовкиЗапроса(Знач Токен)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Authorization", "token " + Токен);
	Заголовки.Вставить("User-Agent", "OpenHub");
	Заголовки.Вставить("Accept", "application/vnd.github+json");

	Возврат Заголовки;

КонецФункции

Функция ЛогинИзОтвета(Знач Ответ)

	Если Ответ.Код <> 200 Тогда
		Лог.Предупреждение("Владелец GitHub-токена не опознан: GitHub ответил кодом %1",
			Формат(Ответ.Код, "ЧГ=0; ЧН=0"));
		Возврат "";
	КонецЕсли;

	Результат = ЛогинИзПрофиля(ПолучитьСтрокуИзДвоичныхДанных(Ответ.Данные, "UTF-8"));
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Лог.Предупреждение("Владелец GitHub-токена не опознан: в ответе GitHub нет годного логина");
		Возврат "";
	КонецЕсли;

	Лог.Отладка("Владелец GitHub-токена опознан: <%1>", Результат);
	Возврат Результат;

КонецФункции

// Всё, что логином GitHub быть не может, — пустая строка: значение уходит в журнал и уведомления.
Функция ЛогинИзПрофиля(Знач Тело)

	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(Тело);
		Профиль = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат "";
	КонецПопытки;

	Если ТипЗнч(Профиль) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Значение = Профиль.Получить("login");
	Если ТипЗнч(Значение) <> Тип("Строка") ИЛИ НЕ ФормаЛогина.Совпадает(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Значение;

КонецФункции

#КонецОбласти

&Прозвище("ОпознаниеGitHub")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТранспортHTTP") _Транспорт,
	&Деталька(Значение = "oshub.publish.github.api", ЗначениеПоУмолчанию = "api.github.com") АдресЗначение = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Пластилин(Значение = "ТаймаутыHTTP") _Таймауты = Неопределено)

	Таймауты = ?(_Таймауты = Неопределено, Новый ТаймаутыHTTP(), _Таймауты);
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	// Лог параметром — только при прямом создании; в контейнере поле прилепит напильник.
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Транспорт = _Транспорт;
	// хост переопределяем для тестов и GitHub Enterprise
	Хост = ?(ЗначениеЗаполнено(АдресЗначение), Строка(АдресЗначение), "api.github.com");
	АдресПрофиля = Новый ШаблонURI("https://{+host}/user").Раскрыть(Новый Структура("host", Хост)).ВСтроку();
	// буквы, цифры, дефис; подчёркивание — у управляемых учёток GitHub Enterprise
	ФормаЛогина = Новый РегулярноеВыражение("\A[A-Za-z0-9][A-Za-z0-9_-]{0,63}\z");

КонецПроцедуры
