// Реализация ОпознаниеGitHub через GitHub REST API: GET /user с токеном и GET /users/{логин}
// без него, читаются login и name. Любой сбой — пустой ответ: опознание подписывает публикацию
// и называет человека, а не решает судьбу публикации.

#Использовать url

Перем Транспорт;     // ТранспортHTTP (сеть) — единый исходящий HTTP-клиент
Перем Таймауты;      // ТаймаутыHTTP (сеть)
Перем Ошибки;        // ТекстОшибки (основа) — маска секрета одна на хаб
Перем Контроль;      // КонтрольСимволов (основа) — имя из профиля становится строкой текста
Перем ПаузаДо;       // Дата — до этого момента GitHub об именах не спрашивают: он только что не ответил
&Лог
Перем Лог;
Перем Хост;          // Строка — хост GitHub API
Перем АдресПрофиля;  // Строка — адрес профиля владельца токена в GitHub API
Перем ШаблонЧужогоПрофиля; // ШаблонURI — адрес публичного профиля по логину
Перем ФормаЛогина;   // РегулярноеВыражение — чем логин GitHub бывает

// Владелец токена на GitHub. Реализация контракта ОпознаниеGitHub.
//
// Параметры:
//  Токен - Строка - GitHub-токен из заголовка запроса.
//
// Возвращаемое значение:
//  Структура - Логин (Строка), Имя (Строка); пустой логин при пустом токене, не-200, ответе
//              без годного login и любой ошибке обращения к GitHub. Исключений не бросает.
//
Функция Владелец(Знач Токен) Экспорт

	Значение = СокрЛП(Строка(Токен));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопознан();
	КонецЕсли;

	Попытка
		Возврат ВладелецИзОтвета(Транспорт.Получить(АдресПрофиля, ЗаголовкиЗапроса(Значение),
			Таймауты.ТаймаутСлужебногоЗапроса()));
	Исключение
		Лог.Предупреждение("Владелец GitHub-токена не опознан: %1",
			Ошибки.БезСекрета(Ошибки.Однострочно(ОписаниеОшибки()), Значение));
		Возврат Неопознан();
	КонецПопытки;

КонецФункции

// Имя из публичного профиля пользователя GitHub. Реализация контракта ОпознаниеGitHub. Ответ
// GitHub помнится по логину (кэш «именаGitHub»): без токена GitHub отвечает одному адресу
// ограниченное число раз в час. Неудача в кэш не идёт, но после неё GitHub несколько минут
// не спрашивают вовсе — повторы и соседние доставки не ждут его таймаута и не продлевают лимит.
//
// Параметры:
//  Логин - Строка - логин пользователя GitHub.
//  Момент - Дата - текущий момент UTC, тестовый шов (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Строка, Неопределено - имя; "" — имени нет, пользователя нет (404) или логин негоден;
//                         Неопределено — сбой сети, иной код ответа либо пауза после сбоя.
//                         Исключений не бросает.
//
&Кэшируемый("именаGitHub")
Функция Имя(&КлючКэша Знач Логин, Знач Момент = Неопределено) Экспорт

	Значение = СокрЛП(Строка(Логин));
	Если НЕ ФормаЛогина.Совпадает(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Если ЗначениеЗаполнено(ПаузаДо) И Сейчас < ПаузаДо Тогда
		Лог.Отладка("Имя пользователя GitHub <%1> не спрошено: GitHub недавно не ответил", Значение);
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Ответ = Транспорт.Получить(АдресЧужогоПрофиля(Значение), ЗаголовкиЗапроса(""),
			Таймауты.ТаймаутСлужебногоЗапроса());
	Исключение
		Лог.Предупреждение("Имя пользователя GitHub <%1> не прочитано: %2", Значение,
			Ошибки.Однострочно(ОписаниеОшибки()));
		ПаузаДо = Сейчас + ПаузаПослеСбояСек();
		Возврат Неопределено;
	КонецПопытки;

	Если Ответ.Код = 404 Тогда
		Лог.Отладка("Пользователя GitHub <%1> нет: имени не будет", Значение);
		Возврат "";
	КонецЕсли;
	Если Ответ.Код <> 200 Тогда
		Лог.Предупреждение("Имя пользователя GitHub <%1> не прочитано: GitHub ответил кодом %2",
			Значение, Формат(Ответ.Код, "ЧГ=0; ЧН=0"));
		ПаузаДо = Сейчас + ПаузаПослеСбояСек();
		Возврат Неопределено;
	КонецЕсли;

	Возврат ИмяИзПрофиля(Профиль(Ответ));

КонецФункции

#Область СлужебныеПроцедурыИФункции

// Без токена заголовка Authorization нет вовсе: публичный профиль его не требует.
Функция ЗаголовкиЗапроса(Знач Токен)

	Заголовки = Новый Соответствие();
	Если ЗначениеЗаполнено(Токен) Тогда
		Заголовки.Вставить("Authorization", "token " + Токен);
	КонецЕсли;
	Заголовки.Вставить("User-Agent", "OpenHub");
	Заголовки.Вставить("Accept", "application/vnd.github+json");

	Возврат Заголовки;

КонецФункции

Функция ВладелецИзОтвета(Знач Ответ)

	Если Ответ.Код <> 200 Тогда
		Лог.Предупреждение("Владелец GitHub-токена не опознан: GitHub ответил кодом %1",
			Формат(Ответ.Код, "ЧГ=0; ЧН=0"));
		Возврат Неопознан();
	КонецЕсли;

	Данные = Профиль(Ответ);
	Логин = ЛогинИзПрофиля(Данные);
	Если НЕ ЗначениеЗаполнено(Логин) Тогда
		Лог.Предупреждение("Владелец GitHub-токена не опознан: в ответе GitHub нет годного логина");
		Возврат Неопознан();
	КонецЕсли;

	Лог.Отладка("Владелец GitHub-токена опознан: <%1>", Логин);
	Возврат Новый Структура("Логин, Имя", Логин, ИмяИзПрофиля(Данные));

КонецФункции

Функция Неопознан()
	Возврат Новый Структура("Логин, Имя", "", "");
КонецФункции

// Неразборчивое тело — Неопределено: ни логина, ни имени из него не будет.
Функция Профиль(Знач Ответ)

	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(ПолучитьСтрокуИзДвоичныхДанных(Ответ.Данные, "UTF-8"));
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные, Неопределено);

КонецФункции

// Всё, что логином GitHub быть не может, — пустая строка: значение уходит в журнал и уведомления.
Функция ЛогинИзПрофиля(Знач Данные)

	Если Данные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение = Данные.Получить("login");
	Если ТипЗнч(Значение) <> Тип("Строка") ИЛИ НЕ ФормаЛогина.Совпадает(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Имя набирает человек: переводы строк и прочие управляющие выпадают, длина ограничена.
Функция ИмяИзПрофиля(Знач Данные)

	Если Данные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение = Данные.Получить("name");
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрокаТекста(Значение);

КонецФункции

// Имя набирает человек, а уходит оно строкой в чат: управляющие и форматирующие символы
// (переводы и разрывы строк, C1, смена направления письма, невидимые) становятся пробелом,
// пробелы схлопываются, края снимаются, длина ограничена.
Функция СтрокаТекста(Знач Значение)

	Части = Новый Массив();
	Слово = "";
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Позиция, 1);
		Если Символ = " " ИЛИ НеПечатный(КодСимвола(Символ)) Тогда
			ДобавитьСлово(Части, Слово);
			Слово = "";
		Иначе
			Слово = Слово + Символ;
		КонецЕсли;
	КонецЦикла;
	ДобавитьСлово(Части, Слово);

	Результат = СтрСоединить(Части, " ");
	Если СтрДлина(Результат) <= ПределИмени() Тогда
		Возврат Результат;
	КонецЕсли;
	// суррогатная пара (эмодзи) на границе не разрезается: отрезается целиком
	Длина = ?(ЭтоСтаршийСуррогат(КодСимвола(Результат, ПределИмени())), ПределИмени() - 1, ПределИмени());
	Возврат СокрП(Лев(Результат, Длина));

КонецФункции

Процедура ДобавитьСлово(Части, Знач Слово)
	Если ЗначениеЗаполнено(Слово) Тогда
		Части.Добавить(Слово);
	КонецЕсли;
КонецПроцедуры

// C0, DEL и C1, разрывы строк Юникода и символы формата (Cf) — то, что в строке текста
// переносит, переворачивает или прячет написанное. ZWNJ и ZWJ (U+200C, U+200D) остаются: они лишь
// склеивают и разделяют соседние знаки (эмодзи-последовательности, персидское и индийское письмо)
// и не переносят строку, не меняют направления и не прячут текст.
Функция НеПечатный(Знач Код)
	Возврат Контроль.ЭтоУправляющийC0(Код) ИЛИ Контроль.ЭтоDEL(Код) ИЛИ (Код >= 128 И Код <= 159)
		ИЛИ Контроль.ЭтоРазрывЮникода(Код) ИЛИ ЭтоСимволФормата(Код);
КонецФункции

Функция ЭтоСимволФормата(Знач Код)
	Возврат Код = 173 ИЛИ (Код >= 1536 И Код <= 1541) ИЛИ Код = 1564 ИЛИ Код = 1757 ИЛИ Код = 1807
		ИЛИ Код = 2274 ИЛИ Код = 6158 ИЛИ Код = 8203 ИЛИ Код = 8206 ИЛИ Код = 8207 ИЛИ (Код >= 8232 И Код <= 8238)
		ИЛИ (Код >= 8288 И Код <= 8303) ИЛИ Код = 65279 ИЛИ (Код >= 65529 И Код <= 65531);
КонецФункции

// Пять минут: повторы и соседние доставки не ждут таймаута, а оживший GitHub спросят скоро.
Функция ПаузаПослеСбояСек()
	Возврат 300;
КонецФункции

// Логин — сегментом пути: GitHub-логин без слеша, но адрес не должен зависеть от проверки формы.
Функция АдресЧужогоПрофиля(Знач Логин)
	Возврат ШаблонЧужогоПрофиля.Раскрыть(Новый Структура("host, login", Хост, Логин)).ВСтроку();
КонецФункции

Функция ЭтоСтаршийСуррогат(Знач Код)
	Возврат Код >= 55296 И Код <= 56319;
КонецФункции

Функция ПределИмени()
	Возврат 100;
КонецФункции

#КонецОбласти

&Прозвище("ОпознаниеGitHub")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТранспортHTTP") _Транспорт,
	&Деталька(Значение = "oshub.publish.github.api", ЗначениеПоУмолчанию = "api.github.com") АдресЗначение = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Пластилин(Значение = "ТаймаутыHTTP") _Таймауты = Неопределено,
	&Пластилин(Значение = "КонтрольСимволов") _Контроль = Неопределено)

	Таймауты = ?(_Таймауты = Неопределено, Новый ТаймаутыHTTP(), _Таймауты);
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Контроль = ?(_Контроль = Неопределено, Новый КонтрольСимволов(), _Контроль);
	// Лог параметром — только при прямом создании; в контейнере поле прилепит напильник.
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Транспорт = _Транспорт;
	// хост переопределяем для тестов и GitHub Enterprise
	Хост = ?(ЗначениеЗаполнено(АдресЗначение), Строка(АдресЗначение), "api.github.com");
	АдресПрофиля = Новый ШаблонURI("https://{+host}/user").Раскрыть(Новый Структура("host", Хост)).ВСтроку();
	ШаблонЧужогоПрофиля = Новый ШаблонURI("https://{+host}/users/{login}");
	// буквы, цифры, дефис; подчёркивание — у управляемых учёток GitHub Enterprise
	ФормаЛогина = Новый РегулярноеВыражение("\A[A-Za-z0-9][A-Za-z0-9_-]{0,63}\z");

КонецПроцедуры
