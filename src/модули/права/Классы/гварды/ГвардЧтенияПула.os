// Гвард чтения пула: вправе ли автор запроса видеть этот пул (сессия или PAT).
// Форму ответа выбирает вызывающий — гвард в Ответ не пишет.
//
// «Пула нет», «читать нельзя» и «ключ не тот» намеренно неразличимы (Разрешено = Ложь,
// один и тот же 404): иначе перебор имён отвечал бы, какие приватные пулы существуют.

Перем Перехватчик;   // ПерехватчикАутентификации (auth)
Перем СервисПрав;    // СервисПрав (auth)
Перем СервисПулов;   // СервисПулов (реестр)
Перем ГейтТокена;    // ГейтТокена (auth) — скоупы PAT и привязка к пулу

// Проверяет право читать пул по имени из URL (сессия браузера или PAT).
// «Пула нет» и «читать нельзя» неразличимы — вызывающий обязан отдать один и тот же 404.
//
// Параметры:
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса (Authorization для PAT).
//  КукиЗапроса - Куки, Неопределено - куки запроса (сессия браузера).
//  ИмяПула - Строка - имя пула из адреса.
//
// Возвращаемое значение:
//  Структура - Разрешено (Булево), Пул (Пул, Неопределено — только при Разрешено),
//              Пользователь (Пользователь, Неопределено — аноним).
//
Функция Проверить(Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ИмяПула) Экспорт

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);
	Пользователь = Принципал.Пользователь;

	Пул = ЧитаемыйПул(Пользователь, ИмяПула, Принципал);
	Если Пул = Неопределено Тогда
		Возврат Новый Структура("Разрешено, Пул, Пользователь", Ложь, Неопределено, Пользователь);
	КонецЕсли;

	Возврат Новый Структура("Разрешено, Пул, Пользователь", Истина, Пул, Пользователь);

КонецФункции

// Проверка для мест, где принципал уже определён вызывающим.
// Принципал передаётся целиком: без него гейт ключа не отработает.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - принципал запроса (аноним — Неопределено).
//  ИмяПула - Строка - имя пула из адреса.
//  Принципал - Структура, Неопределено - принципал целиком для гейта ключа
//              (необязательный, по умолчанию Неопределено — «ключа в запросе нет»).
//
// Возвращаемое значение:
//  Пул, Неопределено - пул, если он есть и его можно читать; иначе Неопределено.
//
Функция ЧитаемыйПул(Знач Пользователь, Знач ИмяПула, Знач Принципал = Неопределено) Экспорт

	Пул = СервисПулов.НайтиПул(ИмяПула);
	Если Пул = Неопределено ИЛИ НЕ СервисПрав.МожетЧитать(Пользователь, Пул) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ КлючВправеЧитать(Принципал, Пул) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Пул;

КонецФункции

// Мягкий fail-closed: нет гейта — отказ только запросам С КЛЮЧОМ, аноним и сессия
// продолжают читать публичное (гвард инстанцируют и напрямую — тесты, утилиты).
Функция КлючВправеЧитать(Знач Принципал, Знач Пул)

	Если ГейтТокена <> Неопределено Тогда
		Возврат ГейтТокена.ЧтениеРазрешено(Принципал, Пул);
	КонецЕсли;
	Если Принципал <> Неопределено И НРег(СокрЛП(Строка(Принципал.Способ))) = "token" Тогда
		Возврат Ложь; // ключ есть, проверить его нечем — не открываем
	КонецЕсли;
	Возврат Истина;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ГейтТокена") _ГейтТокена) Экспорт

	Перехватчик = _Перехватчик;
	СервисПрав = _СервисПрав;
	СервисПулов = _СервисПулов;
	ГейтТокена = _ГейтТокена;

КонецПроцедуры
