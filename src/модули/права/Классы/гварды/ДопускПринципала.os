// Общий пролог доменной мутации: гейт ключа собран, рамки ключа пропускают действие
// в этом пуле, за принципалом стоит учётка. Порядок шагов — часть инварианта: рамки ключа
// спрашиваются ДО прав человека и до состояния объекта, иначе read-only ключ узнавал бы
// по коду ответа о чужих пулах, заявках и пакетах. Роль человека проверяет вызывающий:
// она у каждой двери своя, а лесенка до неё — одна.

Перем ГвардКлюча;         // ГвардКлюча (вход), может быть Неопределено — гейт не собран
Перем Учётки;             // УчёткаПринципала (права)
Перем Вердикты;           // Вердикт (основа)

#Область ПубличныйИнтерфейс

// Как называется дело в отказе. Обе формулировки нужны целиком: род у дел разный
// («Публикация запрещена», «Резервирование имени запрещено»).
//
// Параметры:
//  БезГейта - Строка - начало фразы «… : гейт ключа доступа не собран».
//  БезРамок - Строка - начало фразы «… ключом доступа: <причина>».
//
// Возвращаемое значение:
//  Структура - БезГейта, БезРамок.
//
Функция Дело(Знач БезГейта, Знач БезРамок) Экспорт
	Возврат Новый Структура("БезГейта, БезРамок", Строка(БезГейта), Строка(БезРамок));
КонецФункции

// Лесенка целиком: гейт собран → рамки ключа → учётка за принципалом.
// Несобранный гейт закрывает дорогу всем, включая сессию (fail-closed).
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  Действие - Строка - создание | изменение | удаление | чтение.
//  ПулИдентификатор - Число - пул объекта.
//  ЧтоЗаДело - Структура - результат Дело().
//
// Возвращаемое значение:
//  Структура - вердикт: при Успех = Истина несёт Код (200), Сообщение ("")
//              и Пользователь (Пользователь); при отказе — Код (401 либо 403)
//              и Сообщение для человека.
//
Функция Пропустить(Знач Принципал, Знач Действие, Знач ПулИдентификатор, Знач ЧтоЗаДело) Экспорт

	ВердиктРамок = РамкиКлюча(Принципал, Действие, ПулИдентификатор, ЧтоЗаДело);
	Если НЕ ВердиктРамок.Успех Тогда
		Возврат ВердиктРамок;
	КонецЕсли;

	Пользователь = Учётки.Пользователь(Принципал);
	Если Пользователь = Неопределено Тогда
		Возврат Вердикты.ОтказСКодом(401, "Требуется аутентификация");
	КонецЕсли;

	Возврат Вердикты.УспехСКодом(200, "", Новый Структура("Пользователь", Пользователь));

КонецФункции

// Только рамки ключа, без учётки: так спрашивает публикация, где личность запроса
// разбирается дальше по дороге. Несобранный гейт закрывает дорогу ТОЛЬКО предъявителю
// ключа: сессии и анониму сужать нечего, и отказывать им было бы отказом всему хабу.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  Действие - Строка - создание | изменение | удаление | чтение.
//  ПулИдентификатор - Число - пул объекта.
//  ЧтоЗаДело - Структура - результат Дело().
//
// Возвращаемое значение:
//  Структура - вердикт: Успех (Булево), Код, Сообщение.
//
Функция РамкиКлючаБезУчётки(Знач Принципал, Знач Действие, Знач ПулИдентификатор, Знач ЧтоЗаДело) Экспорт

	Если ГвардКлюча = Неопределено Тогда
		Если Учётки.ЭтоКлюч(Принципал) Тогда
			Возврат ОтказБезГейта(ЧтоЗаДело);
		КонецЕсли;
		Возврат Вердикты.УспехСКодом(200, "");
	КонецЕсли;

	Возврат ПоРамкамКлюча(Принципал, Действие, ПулИдентификатор, ЧтоЗаДело);

КонецФункции

// Пропускают ли рамки ключа — без объяснений: так спрашивает выдача, которой нужен
// не текст отказа, а «показывать или нет». Несобранный гейт закрывает всех.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  Действие - Строка - создание | изменение | удаление | чтение.
//  ПулИдентификатор - Число - пул объекта.
//
// Возвращаемое значение:
//  Булево.
//
Функция РамкиПропускают(Знач Принципал, Знач Действие, Знач ПулИдентификатор) Экспорт

	Если ГвардКлюча = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ГвардКлюча.Пропустить(Принципал, Действие, Цел(ПулИдентификатор)).Разрешено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Fail-closed: несобранная зависимость молча отключила бы энфорсмент рамок ключа.
Функция РамкиКлюча(Знач Принципал, Знач Действие, Знач ПулИдентификатор, Знач ЧтоЗаДело)

	Если ГвардКлюча = Неопределено Тогда
		Возврат ОтказБезГейта(ЧтоЗаДело);
	КонецЕсли;

	Возврат ПоРамкамКлюча(Принципал, Действие, ПулИдентификатор, ЧтоЗаДело);

КонецФункции

Функция ПоРамкамКлюча(Знач Принципал, Знач Действие, Знач ПулИдентификатор, Знач ЧтоЗаДело)

	ВердиктКлюча = ГвардКлюча.Пропустить(Принципал, Действие, Цел(ПулИдентификатор));
	Если ВердиктКлюча.Разрешено Тогда
		Возврат Вердикты.УспехСКодом(200, "");
	КонецЕсли;

	Возврат Вердикты.ОтказСКодом(403, ЧтоЗаДело.БезРамок + " ключом доступа: "
		+ ГвардКлюча.ОписаниеПричины(ВердиктКлюча.Причина));

КонецФункции

Функция ОтказБезГейта(Знач ЧтоЗаДело)
	Возврат Вердикты.ОтказСКодом(403, ЧтоЗаДело.БезГейта + ": гейт ключа доступа не собран");
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "УчёткаПринципала") _Учётки = Неопределено,
	&Пластилин(Значение = "ГвардКлюча") _ГвардКлюча = Неопределено,
	&Пластилин(Значение = "Вердикт") _Вердикты = Неопределено) Экспорт

	Учётки = ?(_Учётки = Неопределено, Новый УчёткаПринципала(), _Учётки);
	ГвардКлюча = _ГвардКлюча;
	Вердикты = ?(_Вердикты = Неопределено, Новый Вердикт(), _Вердикты);

КонецПроцедуры
