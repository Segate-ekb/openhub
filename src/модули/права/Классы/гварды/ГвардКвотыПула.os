// Гвард квоты пула: дисковую квоту пула назначает администратор хаба и только он.
// Право сознательно не следует за администрированием пула — предел, который подопечный
// меняет сам, пределом не является. Одна формулировка на все входы: форму дома пула,
// REST-API и создание пула.

Перем СервисПрав;  // СервисПрав (auth)

#Область ПубличныйИнтерфейс

// Вправе ли субъект назначать квоту пула.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект (аноним — Неопределено).
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетМенятьКвоту(Знач Пользователь) Экспорт
	Возврат СервисПрав <> Неопределено И СервисПрав.ПользовательАдмин(Пользователь);
КонецФункции

// Человекочитаемая причина отказа — одна формулировка на весь хаб.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаОтказа() Экспорт
	Возврат "Квоту пула назначает администратор хаба";
КонецФункции

// Машинный код отказа для API.
//
// Возвращаемое значение:
//  Строка.
//
Функция КодОтказа() Экспорт
	Возврат "quota_forbidden";
КонецФункции

#КонецОбласти

&Прозвище("ГвардКвотыПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПрав") _СервисПрав)

	СервисПрав = _СервисПрав;

КонецПроцедуры
