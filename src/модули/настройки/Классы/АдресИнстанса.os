// Внешний адрес инсталляции (настройка oshub.instance.url) и всё, что из него выводится:
// в первую очередь redirect_uri провайдеров входа.

Перем Настройки; // СервисНастроек (настройки)
Перем Адреса;     // РазборАдреса (основа) — хвостовые слеши снимает он

// Ключ настройки с внешним адресом хаба.
//
// Возвращаемое значение:
//  Строка.
//
Функция Ключ() Экспорт
	Возврат "oshub.instance.url";
КонецФункции

// Действующий внешний адрес без завершающего слеша («» — не задан).
//
// Возвращаемое значение:
//  Строка.
//
Функция Базовый() Экспорт
	Возврат Нормализовать(Настройки.Значение(Ключ()));
КонецФункции

// Задан ли внешний адрес инсталляции.
//
// Возвращаемое значение:
//  Булево.
//
Функция Задан() Экспорт
	Возврат ЗначениеЗаполнено(Базовый());
КонецФункции

// Путь точки возврата OIDC — вторая половина redirect_uri.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПутьВозврата() Экспорт
	Возврат "/oidc/callback";
КонецФункции

// Адрес возврата провайдера входа, выведенный из внешнего адреса инсталляции.
//
// Возвращаемое значение:
//  Строка - готовый redirect_uri либо «», если внешний адрес не задан.
//
Функция АдресВозврата() Экспорт
	База = Базовый();
	Возврат ?(ЗначениеЗаполнено(База), База + ПутьВозврата(), "");
КонецФункции

// Каноничная форма адреса: без окружающих пробелов и без завершающих слешей.
//
// Параметры:
//  Адрес - Строка - сырой адрес.
//
// Возвращаемое значение:
//  Строка.
//
Функция Нормализовать(Знач Адрес) Экспорт
	Возврат Адреса.БезХвостовыхСлешей(СокрЛП(Строка(Адрес)));
КонецФункции

&Прозвище("АдресИнстанса")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "РазборАдреса") _Адреса = Неопределено) Экспорт

	Адреса = ?(_Адреса = Неопределено, Новый РазборАдреса(), _Адреса);

	Настройки = _Настройки;

КонецПроцедуры
