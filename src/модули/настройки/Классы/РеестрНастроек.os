// Реестр настроек хаба: единый перечень ключей, который собирается из объявлений предметов
// (контракт КлючиНастроек) — каждый предмет объявляет свои ключи сам.

Перем Описания;        // Соответствие: ключ (НРег) -> Структура-описание
Перем ПорядокКлючей;   // Массив ключей в порядке объявления (стабильный для UI)
Перем Имена;           // ИменаПеременныхОкружения (настройки) — конвенция и псевдонимы
Перем Механизмы;       // Соответствие: ключ (НРег) -> имя класса-владельца правки
Перем Строки;          // КанонСтроки (основа)

#Область ПубличныйИнтерфейс

// Все ключи реестра в порядке объявления.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Ключи() Экспорт
	Результат = Новый Массив();
	Для Каждого Ключ Из ПорядокКлючей Цикл
		Результат.Добавить(Ключ);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Есть ли ключ в реестре.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Булево - есть ли ключ в реестре.
//
Функция Есть(Знач Ключ) Экспорт
	Возврат Описания.Получить(Норм(Ключ)) <> Неопределено;
КонецФункции

// Описание настройки.
//
// Параметры:
//  Ключ - Строка - ключ настройки ("oshub.auth.registration.mode").
//
// Возвращаемое значение:
//  Структура - Ключ, Тип ("строка"|"целое"|"булево"), Дефолт, Валидатор (Структура либо
//              Неопределено), Класс ("bootstrap"|"прикладная"), Секрет (Булево),
//              ЗначениеКонфига (сырое), КонфигЗадан (Булево).
//
Функция Описание(Знач Ключ) Экспорт

	Найдено = Описания.Получить(Норм(Ключ));
	Если Найдено = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Реестр настроек: неизвестный ключ ""%1""", Ключ);
	КонецЕсли;
	Возврат Найдено;

КонецФункции

// Прикладная ли настройка (редактируется через доменный API и хранится в базе).
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Булево - прикладная ли настройка (редактируется через доменный API и хранится в базе).
//
Функция ЭтоПрикладная(Знач Ключ) Экспорт
	Возврат Описание(Ключ).Класс = "прикладная";
КонецФункции

// Задан ли ключ в конфигурации (файл/env/программная деталька).
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Булево - задан ли ключ в конфигурации.
//
Функция КонфигЗадан(Знач Ключ) Экспорт
	Возврат Описание(Ключ).КонфигЗадан;
КонецФункции

// Механизм, которому принадлежит правка ключа. У такой настройки правка — не запись
// значения, а переход: предохранитель, снос, раздача. Пустая строка — обычная запись.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - имя класса-владельца правки либо пустая строка.
//
Функция МеханизмПравки(Знач Ключ) Экспорт
	Найдено = Механизмы.Получить(Норм(Ключ));
	Возврат ?(Найдено = Неопределено, "", Найдено);
КонецФункции

// Имя переменной окружения для ключа: конвенция configor либо псевдоним из закрытого списка.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - имя переменной ("OSHUB_STORAGE_ROOT").
//
Функция ПеременнаяОкружения(Знач Ключ) Экспорт
	Возврат Имена.Переменная(Ключ);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Норм(Знач Ключ)
	Возврат Строки.Канон(Ключ);
КонецФункции

Процедура Объявить(Знач Объявление)

	НормКлюч = Норм(Объявление.Ключ);
	Если Описания.Получить(НормКлюч) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон("Реестр настроек: ключ ""%1"" объявлен дважды", Объявление.Ключ);
	КонецЕсли;

	// сентинел «не задано» — Неопределено или "": Ложь и 0 из JSON — заданные значения
	Сырое = Объявление.Сырое;
	Задан = НЕ (Сырое = Неопределено ИЛИ Сырое = "");

	Описание = Новый Структура("Ключ, Тип, Дефолт, Валидатор, Класс, Секрет, ЗначениеКонфига, КонфигЗадан",
		НормКлюч, Объявление.Тип, Объявление.Дефолт, Объявление.Валидатор, Объявление.Класс,
		Объявление.Секрет, ?(Задан, Сырое, ""), Задан);

	Описания.Вставить(НормКлюч, Описание);
	ПорядокКлючей.Добавить(НормКлюч);

КонецПроцедуры

// Ключ обязан быть объявлен: опечатка иначе молча отключила бы предохранитель.
Процедура ПравитМеханизм(Знач Ключ, Знач Механизм)
	Описание(Ключ);
	Механизмы.Вставить(Норм(Ключ), Механизм);
КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КлючиНастроек", Тип = "Массив") _Предметы,
	&Пластилин(Значение = "ИменаПеременныхОкружения") _Имена = Неопределено) Экспорт

	Имена = ?(_Имена = Неопределено, Новый ИменаПеременныхОкружения(), _Имена);
	Строки = Новый КанонСтроки();
	Описания = Новый Соответствие();
	ПорядокКлючей = Новый Массив();
	Механизмы = Новый Соответствие();

	// Ключи объявляет каждый предмет о себе: bootstrap — только конфиг/env, в интерфейсе
	// карточка для чтения; прикладная — дефолт из кода, значение из базы либо форсировано конфигом.
	Для Каждого Предмет Из _Предметы Цикл
		Для Каждого Объявление Из Предмет.Объявления().Ключи() Цикл
			Объявить(Объявление);
		КонецЦикла;
	КонецЦикла;

	// Механизмы — после всех ключей: правку ключа одного предмета вправе вести механизм другого.
	Для Каждого Предмет Из _Предметы Цикл
		Для Каждого Правка Из Предмет.Объявления().Механизмы() Цикл
			ПравитМеханизм(Правка.Ключ, Правка.Значение);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры
