// Реестр настроек хаба — желудь модуля настройки.

Перем Описания;        // Соответствие: ключ (НРег) -> Структура-описание
Перем ПорядокКлючей;   // Массив ключей в порядке объявления (стабильный для UI)
Перем ИсключенияEnv;   // Соответствие: ключ (НРег) -> имя переменной окружения
Перем Механизмы;       // Соответствие: ключ (НРег) -> имя класса-владельца правки
Перем Правила;         // ВидыПроверок (настройки) — конструкторы декларативных проверок

#Область ПубличныйИнтерфейс

// Все ключи реестра в порядке объявления.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Ключи() Экспорт
	Результат = Новый Массив();
	Для Каждого Ключ Из ПорядокКлючей Цикл
		Результат.Добавить(Ключ);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Есть ли ключ в реестре.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Булево - есть ли ключ в реестре.
//
Функция Есть(Знач Ключ) Экспорт
	Возврат Описания.Получить(Норм(Ключ)) <> Неопределено;
КонецФункции

// Описание настройки.
//
// Параметры:
//  Ключ - Строка - ключ настройки ("oshub.auth.registration.mode").
//
// Возвращаемое значение:
//  Структура - Ключ, Тип ("строка"|"целое"|"булево"), Дефолт, Валидатор (Структура либо
//              Неопределено), Класс ("bootstrap"|"прикладная"), Секрет (Булево),
//              ЗначениеКонфига (сырое), КонфигЗадан (Булево).
//
Функция Описание(Знач Ключ) Экспорт

	Найдено = Описания.Получить(Норм(Ключ));
	Если Найдено = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Реестр настроек: неизвестный ключ ""%1""", Ключ);
	КонецЕсли;
	Возврат Найдено;

КонецФункции

// Прикладная ли настройка (редактируется через доменный API и хранится в базе).
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Булево - прикладная ли настройка (редактируется через доменный API и хранится в базе).
//
Функция ЭтоПрикладная(Знач Ключ) Экспорт
	Возврат Описание(Ключ).Класс = "прикладная";
КонецФункции

// Задан ли ключ в конфигурации (файл/env/программная деталька).
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Булево - задан ли ключ в конфигурации.
//
Функция КонфигЗадан(Знач Ключ) Экспорт
	Возврат Описание(Ключ).КонфигЗадан;
КонецФункции

// Сырое значение ключа из конфигурации ("" — не задано).
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - сырое значение ключа из конфигурации ("".
//
Функция ЗначениеКонфига(Знач Ключ) Экспорт
	Возврат Описание(Ключ).ЗначениеКонфига;
КонецФункции

// Механизм, которому принадлежит правка ключа. У такой настройки правка — не запись
// значения, а переход: предохранитель, снос, раздача. Пустая строка — обычная запись.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - имя класса-владельца правки либо пустая строка.
//
Функция МеханизмПравки(Знач Ключ) Экспорт
	Найдено = Механизмы.Получить(Норм(Ключ));
	Возврат ?(Найдено = Неопределено, "", Найдено);
КонецФункции

// Имя переменной окружения для ключа (конвенция configor + карта исключений).
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - имя переменной ("OSHUB_STORAGE_ROOT").
//
Функция ПеременнаяОкружения(Знач Ключ) Экспорт

	Особый = ИсключенияEnv.Получить(Норм(Ключ));
	Если Особый <> Неопределено Тогда
		Возврат Особый;
	КонецЕсли;

	// "_" внутри сегмента экранируется удвоением, затем точка становится "_"
	Экранированное = СтрЗаменить(Строка(Ключ), "_", "__");
	Возврат ВРег(СтрЗаменить(Экранированное, ".", "_"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Норм(Знач Ключ)
	Возврат НРег(СокрЛП(Строка(Ключ)));
КонецФункции

Процедура Объявить(Знач Ключ, Знач Тип, Знач Дефолт, Знач Валидатор, Знач Класс,
	Знач Секрет, Знач СыроеЗначение)

	НормКлюч = Норм(Ключ);
	Если Описания.Получить(НормКлюч) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон("Реестр настроек: ключ ""%1"" объявлен дважды", Ключ);
	КонецЕсли;

	// сентинел «не задано» — Неопределено или "": Ложь и 0 из JSON — заданные значения
	Задан = НЕ (СыроеЗначение = Неопределено ИЛИ СыроеЗначение = "");

	Описание = Новый Структура("Ключ, Тип, Дефолт, Валидатор, Класс, Секрет, ЗначениеКонфига, КонфигЗадан",
		НормКлюч, Тип, Дефолт, Валидатор, Класс, Секрет,
		?(Задан, СыроеЗначение, ""), Задан);

	Описания.Вставить(НормКлюч, Описание);
	ПорядокКлючей.Добавить(НормКлюч);

КонецПроцедуры

// Ключ обязан быть объявлен: опечатка иначе молча отключила бы предохранитель.
Процедура ПравитМеханизм(Знач Ключ, Знач Механизм)
	Описание(Ключ);
	Механизмы.Вставить(Норм(Ключ), Механизм);
КонецПроцедуры

// Декларативные валидаторы (применяет СервисНастроек) — конструкторы у ВидыПроверок.
Функция Перечисление(Знач ЗначенияЧерезЗапятую)
	Возврат Правила.Перечисление(ЗначенияЧерезЗапятую);
КонецФункции

Функция Минимум(Знач Мин)
	Возврат Правила.Минимум(Мин);
КонецФункции

Функция Адрес()
	Возврат Правила.Адрес();
КонецФункции

Функция Цвет()
	Возврат Правила.Цвет();
КонецФункции

Функция Сети()
	Возврат Правила.Сети();
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Пластилин(Значение = "НастройкиПодсистем") _Подсистемы,
	&Деталька(Значение = "winow.Порт", ЗначениеПоУмолчанию = "") _Порт = "",
	&Деталька(Значение = "oshub.storage.root", ЗначениеПоУмолчанию = "") _КаталогХранилища = "",
	&Деталька(Значение = "oshub.storage.backend", ЗначениеПоУмолчанию = "") _Бэкенд = "",
	&Деталька(Значение = "oshub.ui.theme", ЗначениеПоУмолчанию = "") _Тема = "",
	&Деталька(Значение = "oshub.ui.accent", ЗначениеПоУмолчанию = "") _Акцент = "",
	&Деталька(Значение = "oshub.ui.brand", ЗначениеПоУмолчанию = "") _Знак = "",
	&Деталька(Значение = "oshub.ui.tagline", ЗначениеПоУмолчанию = "") _Подпись = "",
	&Деталька(Значение = "oshub.ui.show_name", ЗначениеПоУмолчанию = "") _ПоказыватьНазвание = "",
	&Деталька(Значение = "oshub.ui.asset.max_bytes", ЗначениеПоУмолчанию = "") _ПотолокКартинки = "",
	&Деталька(Значение = "oshub.jobs.enabled", ЗначениеПоУмолчанию = "") _ЗадачиВключены = "",
	&Деталька(Значение = "otel.enabled", ЗначениеПоУмолчанию = "") _ТелеметрияВключена = "",
	&Деталька(Значение = "otel.exporter.otlp.endpoint", ЗначениеПоУмолчанию = "") _ТелеметрияАдрес = "",
	&Деталька(Значение = "oshub.admin.login", ЗначениеПоУмолчанию = "") _ЛогинАдмина = "",
	&Деталька(Значение = "oshub.admin.password", ЗначениеПоУмолчанию = "") _ПарольАдмина = "",
	&Деталька(Значение = "oshub.admin.password_file", ЗначениеПоУмолчанию = "") _ФайлПароляАдмина = "",
	&Деталька(Значение = "oshub.auth.registration.mode", ЗначениеПоУмолчанию = "") _РежимРегистрации = "",
	&Деталька(Значение = "oshub.auth.session.ttlseconds", ЗначениеПоУмолчанию = "") _TTLСессии = "",
	&Деталька(Значение = "oshub.auth.login.maxattempts", ЗначениеПоУмолчанию = "") _МаксПопыток = "",
	&Деталька(Значение = "oshub.auth.login.lockoutseconds", ЗначениеПоУмолчанию = "") _СекундБлокировки = "",
	&Деталька(Значение = "oshub.auth.invite.ttl.days", ЗначениеПоУмолчанию = "") _СрокПриглашения = "",
	&Деталька(Значение = "oshub.auth.token.cli_days", ЗначениеПоУмолчанию = "") _СрокТокенаCLI = "",
	&Деталька(Значение = "oshub.auth.token.max_days", ЗначениеПоУмолчанию = "") _ПотолокСрокаТокена = "",
	&Деталька(Значение = "oshub.storage.quota.bytes", ЗначениеПоУмолчанию = "") _КвотаБайт = "",
	&Деталька(Значение = "oshub.publish.max_upload_bytes", ЗначениеПоУмолчанию = "") _МаксЗагрузка = "",
	&Деталька(Значение = "oshub.publish.max_unpacked_bytes", ЗначениеПоУмолчанию = "") _МаксРаспаковка = "",
	&Деталька(Значение = "oshub.publish.max_files", ЗначениеПоУмолчанию = "") _МаксФайлов = "",
	&Деталька(Значение = "oshub.publish.max_manifest_bytes", ЗначениеПоУмолчанию = "") _МаксМанифест = "",
	&Деталька(Значение = "oshub.publish.github_legacy", ЗначениеПоУмолчанию = "") _ЛегасиGitHub = "",
	&Деталька(Значение = "oshub.pools.personal_enabled", ЗначениеПоУмолчанию = "") _ЛичныеПулы = "",
	&Деталька(Значение = "oshub.pools.default_quota_mb", ЗначениеПоУмолчанию = "") _КвотаПулаПоУмолчанию = "",
	&Деталька(Значение = "oshub.publish.ci.audience", ЗначениеПоУмолчанию = "") _АудиторияCI = "",
	&Деталька(Значение = "oshub.publish.ci.issuers", ЗначениеПоУмолчанию = "") _ИздателиCI = "",
	&Деталька(Значение = "oshub.publish.inbox.max_pending_per_pool", ЗначениеПоУмолчанию = "") _ВходящихНаПул = "",
	&Деталька(Значение = "oshub.publish.inbox.max_pending_per_user", ЗначениеПоУмолчанию = "") _ВходящихНаАвтора = "",
	&Деталька(Значение = "oshub.instance.url", ЗначениеПоУмолчанию = "") _АдресИнстанса = "",
	&Деталька(Значение = "oshub.instance.trusted_proxies", ЗначениеПоУмолчанию = "") _ДоверенныеПрокси = "",
	&Деталька(Значение = "oshub.auth.password.enabled", ЗначениеПоУмолчанию = "") _ПарольныйВход = "",
	&Деталька(Значение = "oshub.mail.enabled", ЗначениеПоУмолчанию = "") _ПочтаВключена = "",
	&Деталька(Значение = "oshub.mail.smtp.host", ЗначениеПоУмолчанию = "") _ХостSMTP = "",
	&Деталька(Значение = "oshub.mail.smtp.port", ЗначениеПоУмолчанию = "") _ПортSMTP = "",
	&Деталька(Значение = "oshub.mail.smtp.user", ЗначениеПоУмолчанию = "") _ПользовательSMTP = "",
	&Деталька(Значение = "oshub.mail.smtp.password", ЗначениеПоУмолчанию = "") _ПарольSMTP = "",
	&Деталька(Значение = "oshub.mail.from", ЗначениеПоУмолчанию = "") _ОтправительПисем = "",
	&Деталька(Значение = "oshub.auth.email.confirm.enabled", ЗначениеПоУмолчанию = "") _ПодтверждениеАдреса = "",
	&Деталька(Значение = "oshub.auth.email.confirm.ttl.hours", ЗначениеПоУмолчанию = "") _СрокПодтверждения = "",
	&Деталька(Значение = "oshub.mirror.sync_enabled", ЗначениеПоУмолчанию = "") _СинкЗеркал = "",
	&Деталька(Значение = "oshub.mirror.max_per_pool", ЗначениеПоУмолчанию = "") _ЗеркалНаПул = "",
	&Деталька(Значение = "oshub.mirror.default_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалЗеркала = "",
	&Деталька(Значение = "oshub.mirror.min_interval_sec", ЗначениеПоУмолчанию = "") _МинИнтервалЗеркала = "",
	&Деталька(Значение = "oshub.mirror.run_stale_sec", ЗначениеПоУмолчанию = "") _ПорогЗависанияПрогона = "",
	&Деталька(Значение = "oshub.mirror.max_packages_per_cycle", ЗначениеПоУмолчанию = "") _ПорцияЗеркала = "",
	&Деталька(Значение = "oshub.mirror.max_cycles_per_run", ЗначениеПоУмолчанию = "") _ЦикловЗаПрогон = "",
	&Деталька(Значение = "oshub.mirror.queue_max", ЗначениеПоУмолчанию = "") _ОчередьЗеркал = "",
	&Деталька(Значение = "oshub.mirror.cycles_per_turn", ЗначениеПоУмолчанию = "") _ЦикловЗаЗаход = "",
	&Деталька(Значение = "oshub.mirror.queue_poll_sec", ЗначениеПоУмолчанию = "") _ОпросОчередиЗеркал = "") Экспорт

	Правила = _Правила;
	Описания = Новый Соответствие();
	ПорядокКлючей = Новый Массив();

	// bootstrap: только конфиг/env, в UI — read-only карточка. Сюда попадает всё, что
	// решает не администратор хаба, а тот, кто его разворачивает: порт, хранилище,
	// первый старт, размеры приёма, сроки, интервалы и пороги очередей.
	Объявить("winow.Порт",                 "целое",  3333,     Минимум(1),  "bootstrap", Ложь,   _Порт);
	Объявить("oshub.storage.root",         "строка", "./data", Неопределено, "bootstrap", Ложь,  _КаталогХранилища);
	Объявить("oshub.storage.backend",      "строка", "file",   Перечисление("file,s3"), "bootstrap", Ложь, _Бэкенд);
	Объявить("oshub.jobs.enabled",         "булево", Истина,   Неопределено, "bootstrap", Ложь,  _ЗадачиВключены);
	Объявить("otel.enabled",               "булево", Ложь,     Неопределено, "bootstrap", Ложь,  _ТелеметрияВключена);
	Объявить("otel.exporter.otlp.endpoint", "строка", "http://localhost:4318", Неопределено, "bootstrap", Ложь, _ТелеметрияАдрес);
	Объявить("oshub.admin.login",          "строка", "",       Неопределено, "bootstrap", Ложь,  _ЛогинАдмина);
	Объявить("oshub.admin.password",       "строка", "",       Неопределено, "bootstrap", Истина, _ПарольАдмина);
	Объявить("oshub.admin.password_file",  "строка", "",       Неопределено, "bootstrap", Ложь,  _ФайлПароляАдмина);

	// прикладные: дефолт здесь, значение — база (UI) либо форсировано конфигом
	// внешний адрес хаба: из него выводится redirect_uri провайдеров входа
	Объявить("oshub.instance.url",               "строка", "",      Адрес(),    "прикладная", Ложь, _АдресИнстанса);
	// сети обратных прокси этой инсталляции: пусто — заголовки пересылки не читаются вовсе,
	// потому что писать в них чужой адрес может кто угодно
	Объявить("oshub.instance.trusted_proxies",   "строка", "",      Сети(),     "bootstrap", Ложь, _ДоверенныеПрокси);
	Объявить("oshub.auth.registration.mode",     "строка", "open",  Перечисление("open,invite,disabled"), "прикладная", Ложь, _РежимРегистрации);
	// оформление и знак инсталляции: значения читаются на запросе, рестарта правка не требует
	Объявить("oshub.ui.theme",                   "строка", "тёмная", Перечисление("тёмная,светлая"), "прикладная", Ложь, _Тема);
	// пусто — акцент темы (ТокеныТемы), поэтому валидатор цвета пустое значение пропускает
	Объявить("oshub.ui.accent",                  "строка", "",      Цвет(),     "прикладная", Ложь, _Акцент);
	// пусто — знак и подпись по умолчанию; их текст живёт в слое интерфейса (Брендирование),
	// потому что это пользовательская строка, а не значение конфигурации
	Объявить("oshub.ui.brand",                   "строка", "",      Неопределено, "прикладная", Ложь, _Знак);
	Объявить("oshub.ui.tagline",                 "строка", "",      Неопределено, "прикладная", Ложь, _Подпись);
	// выключается, когда загруженный знак уже несёт название хаба рисунком
	Объявить("oshub.ui.show_name",               "булево", Истина,  Неопределено, "прикладная", Ложь, _ПоказыватьНазвание);
	// потолок картинки оформления: она лежит двоичной колонкой и читается строкой таблицы
	// целиком, поэтому мегабайта хватает знаку и иконке с запасом, а базу он бережёт
	Объявить("oshub.ui.asset.max_bytes",         "целое",  1048576, Минимум(1), "bootstrap", Ложь, _ПотолокКартинки);
	Объявить("oshub.auth.session.ttlseconds",    "целое",  86400,    Минимум(1), "bootstrap", Ложь, _TTLСессии);
	Объявить("oshub.auth.login.maxattempts",     "целое",  5,        Минимум(1), "bootstrap", Ложь, _МаксПопыток);
	Объявить("oshub.auth.login.lockoutseconds",  "целое",  300,      Минимум(1), "bootstrap", Ложь, _СекундБлокировки);
	// выключение гасит форму входа, POST входа, API-вход и регистрацию по паролю;
	// значение из конфига перебивает базу и возвращает форму запертому администратору
	Объявить("oshub.auth.password.enabled",      "булево", Истина,   Неопределено, "прикладная", Ложь, _ПарольныйВход);
	// срок одноразовой ссылки установки пароля: и приглашения, и сброса
	Объявить("oshub.auth.invite.ttl.days",       "целое",  7,        Минимум(1), "bootstrap", Ложь, _СрокПриглашения);
	// бессрочных токенов хаб не выпускает: ноль ни в одном из ключей не значит «вечно».
	// Срок токена CLI администратор выбирает сам, потолок срока — число инсталляции
	Объявить("oshub.auth.token.cli_days",        "целое",  7,        Минимум(1), "прикладная", Ложь, _СрокТокенаCLI);
	Объявить("oshub.auth.token.max_days",        "целое",  365,      Минимум(1), "bootstrap", Ложь, _ПотолокСрокаТокена);
	Объявить("oshub.publish.max_upload_bytes",   "целое",  26214400, Минимум(1), "bootstrap", Ложь, _МаксЗагрузка);
	Объявить("oshub.publish.max_unpacked_bytes", "целое",  67108864, Минимум(1), "bootstrap", Ложь, _МаксРаспаковка);
	Объявить("oshub.publish.max_files",          "целое",  5000,     Минимум(1), "bootstrap", Ложь, _МаксФайлов);
	Объявить("oshub.publish.max_manifest_bytes", "целое",  524288,   Минимум(1), "bootstrap", Ложь, _МаксМанифест);

	// переключатель с последствиями: включение раздаёт личные пулы всем, выключение сносит их
	Объявить("oshub.pools.personal_enabled",     "булево", Истина,   Неопределено, "прикладная", Ложь, _ЛичныеПулы);
	// квота пулов, не выставивших свою; ноль здесь означает «хаб пулы не ограничивает»
	Объявить("oshub.pools.default_quota_mb",     "целое",  1024,     Минимум(0), "прикладная", Ложь, _КвотаПулаПоУмолчанию);
	// легаси-токен GitHub на публикации: опция хаба, действует только в основном пуле, дефолт Ложь
	Объявить("oshub.publish.github_legacy",      "булево", Ложь,     Неопределено, "прикладная", Ложь, _ЛегасиGitHub);
	// ожидаемый aud id-token доверенного конвейера; пусто — берётся oshub.instance.url
	Объявить("oshub.publish.ci.audience",        "строка", "",       Неопределено, "прикладная", Ложь, _АудиторияCI);
	// издатели доверенных конвейеров сверх встроенных GitHub и GitLab (self-hosted), через запятую
	Объявить("oshub.publish.ci.issuers",         "строка", "",       Неопределено, "прикладная", Ложь, _ИздателиCI);
	// ноль в любом из ключей выключает приём заявок целиком — отдельного флага не заводим
	Объявить("oshub.publish.inbox.max_pending_per_pool", "целое", 50, Минимум(0), "bootstrap", Ложь, _ВходящихНаПул);
	Объявить("oshub.publish.inbox.max_pending_per_user", "целое",  5, Минимум(0), "bootstrap", Ложь, _ВходящихНаАвтора);

	// подтверждение адреса письмом — политика входа, поэтому ключи живут в oshub.auth.*,
	// а не рядом с транспортом: почта их только доставляет. Подтверждать ли адрес — решение
	// администратора, срок ссылки — число инсталляции
	Объявить("oshub.auth.email.confirm.enabled",     "булево", Истина, Неопределено, "прикладная", Ложь, _ПодтверждениеАдреса);
	Объявить("oshub.auth.email.confirm.ttl.hours",   "целое",  24,     Минимум(1),  "bootstrap", Ложь, _СрокПодтверждения);

	// исходящая почта: выключена по умолчанию — хаб без своего SMTP обязан работать,
	// а включённая пустая настройка молча копила бы неотправленные письма
	Объявить("oshub.mail.enabled",               "булево", Ложь,    Неопределено, "прикладная", Ложь, _ПочтаВключена);
	Объявить("oshub.mail.smtp.host",             "строка", "",      Неопределено, "прикладная", Ложь, _ХостSMTP);
	Объявить("oshub.mail.smtp.port",             "целое",  587,     Минимум(1),  "прикладная", Ложь, _ПортSMTP);
	Объявить("oshub.mail.smtp.user",             "строка", "",      Неопределено, "прикладная", Ложь, _ПользовательSMTP);
	// пароль SMTP — секрет, который ВВОДЯТ из формы: поле открывается пустым, а карточка
	// отдаёт маску. Кому база не годится — задаёт переменной окружения, и поле запирается
	Объявить("oshub.mail.smtp.password",         "строка", "",      Неопределено, "прикладная", Истина, _ПарольSMTP);
	Объявить("oshub.mail.from",                  "строка", "",      Неопределено, "прикладная", Ложь, _ОтправительПисем);

	// зеркалирование: из интерфейса правится только рубильник подсистемы — «синхронизируем
	// или нет». Девять чисел темпа и квот задаёт разворачивающий. Своих пределов приёма
	// у зеркала нет — привозимый пакет судится числами oshub.publish.max_*
	Объявить("oshub.mirror.sync_enabled",           "булево", Истина, Неопределено, "прикладная", Ложь, _СинкЗеркал);
	Объявить("oshub.mirror.max_per_pool",           "целое",  5,      Минимум(1), "bootstrap", Ложь, _ЗеркалНаПул);
	Объявить("oshub.mirror.default_interval_sec",   "целое",  3600,   Минимум(1), "bootstrap", Ложь, _ИнтервалЗеркала);
	Объявить("oshub.mirror.min_interval_sec",       "целое",  60,     Минимум(1), "bootstrap", Ложь, _МинИнтервалЗеркала);
	// таймаут ЖИВОГО прогона: живой цикл отмечается на каждом имени и каждой версии,
	// поэтому единицы минут — честный срок, а не четверть часа
	Объявить("oshub.mirror.run_stale_sec",          "целое",  300,    Минимум(1), "bootstrap", Ложь, _ПорогЗависанияПрогона);
	Объявить("oshub.mirror.max_packages_per_cycle", "целое",  25,     Минимум(1), "bootstrap", Ложь, _ПорцияЗеркала);
	Объявить("oshub.mirror.max_cycles_per_run",     "целое",  20,     Минимум(1), "bootstrap", Ложь, _ЦикловЗаПрогон);
	Объявить("oshub.mirror.queue_max",              "целое",  100,    Минимум(1), "bootstrap", Ложь, _ОчередьЗеркал);
	Объявить("oshub.mirror.cycles_per_turn",        "целое",  20,     Минимум(1), "bootstrap", Ложь, _ЦикловЗаЗаход);
	Объявить("oshub.mirror.queue_poll_sec",         "целое",  2,      Минимум(1), "bootstrap", Ложь, _ОпросОчередиЗеркал);

	// потолок объёма хранилища — часть развёртывания, как корень и вид бэкенда
	Объявить("oshub.storage.quota.bytes",        "целое",  0,       Минимум(0), "bootstrap", Ложь, _КвотаБайт);

	// ключи подсистем объявлены своей таблицей: реестр их только принимает
	Для Каждого Объявление Из _Подсистемы.Объявления() Цикл
		Объявить(Объявление.Ключ, Объявление.Тип, Объявление.Дефолт, Объявление.Валидатор,
			Объявление.Класс, Объявление.Секрет, Объявление.Сырое);
	КонецЦикла;

	// Настройки, у которых правка — переход, а не запись значения: их пишет только свой
	// механизм, потому что вторая половина работы (предохранитель, снос пространств,
	// раздача) без него не выполняется, а значение в обход запирает инсталляцию.
	Механизмы = Новый Соответствие();
	ПравитМеханизм("oshub.auth.password.enabled", "СтражПарольногоВхода");
	ПравитМеханизм("oshub.pools.personal_enabled", "ПультЛичныхПространств");

	// Спец-случаи src/main.os: имя переменной задано вручную, конвенция к нему не ведёт.
	ИсключенияEnv = Новый Соответствие();
	ИсключенияEnv.Вставить("winow.порт", "OSHUB_PORT");
	ИсключенияEnv.Вставить("oshub.admin.password_file", "OSHUB_ADMIN_PASSWORD_FILE");
	ИсключенияEnv.Вставить("oshub.instance.trusted_proxies", "OSHUB_INSTANCE_TRUSTED_PROXIES");

КонецПроцедуры
