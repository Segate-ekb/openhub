// Сервис брендовых активов — картинки оформления, загруженные администратором:
// знак шапки и иконка сайта. Пустое хранилище означает «в ходу фирменные из поставки».
//
// СОДЕРЖИМОЕ ФАЙЛА НЕ ПРОВЕРЯЕТСЯ И НЕ САНИТАЙЗИТСЯ — решение владельца.
// Загрузка доступна только администратору хаба, и он вправе положить в свой хаб любую
// картинку, включая SVG со скриптом. Здесь стоят ровно два порога: размер (защита базы
// и ответа) и тип отдачи (защита заголовка ответа от произвольной строки клиента).

Перем Хранилище;     // ХранилищеБрендовыхАктивов (данные)
Перем Настройки;     // СервисНастроек (настройки) — потолок размера
Перем Типы;          // ТипыКартинок (настройки)
Перем Издатель;      // ИздательСобытий (события)
Перем ИменаЖурнала;  // ИмяОбъектаАудита (аудит)
Перем Кэш;           // Соответствие: ключ -> Структура сведений с полем Момент
Перем КэшСекунд;

#Область ПубличныйИнтерфейс

// Ключ знака — картинки в шапке рядом с названием.
//
// Возвращаемое значение:
//  Строка
//
Функция КлючЗнака() Экспорт
	Возврат "logo";
КонецФункции

// Ключ иконки сайта.
//
// Возвращаемое значение:
//  Строка
//
Функция КлючИконки() Экспорт
	Возврат "favicon";
КонецФункции

// Все ключи активов в порядке показа.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция Ключи() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(КлючЗнака());
	Результат.Добавить(КлючИконки());
	Возврат Результат;

КонецФункции

// Ключ настройки потолка размера загружаемой картинки.
//
// Возвращаемое значение:
//  Строка
//
Функция КлючПотолка() Экспорт
	Возврат "oshub.ui.asset.max_bytes";
КонецФункции

// Действующий потолок размера картинки в байтах.
//
// Возвращаемое значение:
//  Число
//
Функция ПотолокБайт() Экспорт
	Возврат Настройки.Значение(КлючПотолка());
КонецФункции

// Код отказа «файл не выбран или пуст».
//
// Возвращаемое значение:
//  Строка
//
Функция КодПусто() Экспорт
	Возврат "empty";
КонецФункции

// Код отказа «файл больше потолка».
//
// Возвращаемое значение:
//  Строка
//
Функция КодВелик() Экспорт
	Возврат "too_large";
КонецФункции

// Код отказа «это не картинка известного формата».
//
// Возвращаемое значение:
//  Строка
//
Функция КодТип() Экспорт
	Возврат "unsupported_type";
КонецФункции

// Сведения об активе БЕЗ содержимого: их спрашивает каждая отрисовка страницы, поэтому
// они держатся в коротком кэше.
//
// Параметры:
//  Ключ - Строка - ключ актива.
//
// Возвращаемое значение:
//  Структура - Есть (Булево), ТипКонтента, Отпечаток, Размер, ПубличноеИмя.
//
Функция Сведения(Знач Ключ) Экспорт

	НормКлюч = ПроверенныйКлюч(Ключ);

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Запись = Кэш.Получить(НормКлюч);
	Если Запись <> Неопределено И Сейчас - Запись.Момент < КэшСекунд * 1000 Тогда
		Возврат Запись;
	КонецЕсли;

	Запись = СведенияИзБазы(НормКлюч, Сейчас);
	Кэш.Вставить(НормКлюч, Запись);
	Возврат Запись;

КонецФункции

// Байты актива — их читает только отдача по адресу, поэтому кэша здесь нет.
//
// Параметры:
//  Ключ - Строка - ключ актива.
//
// Возвращаемое значение:
//  ДвоичныеДанные, Неопределено - Неопределено, если ничего не загружали.
//
Функция Содержимое(Знач Ключ) Экспорт

	Запись = Хранилище.Актив(ПроверенныйКлюч(Ключ));
	Возврат ?(Запись = Неопределено, Неопределено, Запись.Содержимое);

КонецФункции

// Публичное имя актива: ключ, отпечаток содержимого и расширение типа. Имя — функция
// содержимого, поэтому правка картинки без смены адреса невозможна как класс.
//
// Параметры:
//  Ключ - Строка - ключ актива.
//
// Возвращаемое значение:
//  Строка - имя вида "logo-1f2e3d4c5b6a7988.svg" либо "" для незагруженного актива.
//
Функция ПубличноеИмя(Знач Ключ) Экспорт
	Возврат Сведения(Ключ).ПубличноеИмя;
КонецФункции

// Ключ актива, которому принадлежит публичное имя из адреса. Присланная строка ни с чем
// не склеивается: она сравнивается ЦЕЛИКОМ с именем, собранным из содержимого базы.
//
// Параметры:
//  Имя - Строка - сегмент адреса.
//
// Возвращаемое значение:
//  Строка - ключ актива либо "" — такого адреса нет.
//
Функция КлючПоПубличномуИмени(Знач Имя) Экспорт

	Искомое = СокрЛП(Строка(Имя));
	Если НЕ ЗначениеЗаполнено(Искомое) Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого Ключ Из Ключи() Цикл
		Если Сведения(Ключ).ПубличноеИмя = Искомое Тогда
			Возврат Ключ;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Записывает картинку: одна строка на ключ, повтор перезаписывает её.
//
// Параметры:
//  Ключ - Строка - ключ актива.
//  Данные - ДвоичныеДанные, Неопределено - байты файла.
//  ОбъявленныйТип - Строка - Content-Type части формы.
//  ИмяФайла - Строка - имя файла из формы.
//  Кто - Строка - логин администратора для аудита.
//  АдресIP - Строка - адрес клиента для аудита (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Принято (Булево), Код (Строка: "" при успехе, иначе см. Код*),
//              Потолок (Число), Размер (Число).
//
Функция Загрузить(Знач Ключ, Знач Данные, Знач ОбъявленныйТип, Знач ИмяФайла,
	Знач Кто, Знач АдресIP = "") Экспорт

	НормКлюч = ПроверенныйКлюч(Ключ);
	Потолок = ПотолокБайт();

	Если Данные = Неопределено ИЛИ Данные.Размер() = 0 Тогда
		Возврат Вердикт(КодПусто(), Потолок, 0);
	КонецЕсли;
	Если Данные.Размер() > Потолок Тогда
		Возврат Вердикт(КодВелик(), Потолок, Данные.Размер());
	КонецЕсли;

	ТипКонтента = Типы.ТипОтдачи(ОбъявленныйТип, ИмяФайла);
	Если НЕ ЗначениеЗаполнено(ТипКонтента) Тогда
		Возврат Вердикт(КодТип(), Потолок, Данные.Размер());
	КонецЕсли;

	// снимок ДО записи: журнал, в котором не видно, что заменили, ничем не лучше
	// отсутствующего журнала
	Было = Снимок(НормКлюч);

	Хранилище.Установить(НормКлюч, Данные, ТипКонтента, Отпечаток(Данные), Кто,
		ТекущаяУниверсальнаяДата());
	Кэш.Удалить(НормКлюч);

	Записать(НормКлюч, "настройка.изменена", Было, Кто, АдресIP);
	Возврат Вердикт("", Потолок, Данные.Размер());

КонецФункции

// Возврат к фирменной картинке из поставки: идемпотентен, пишется в аудит.
//
// Параметры:
//  Ключ - Строка - ключ актива.
//  Кто - Строка - логин администратора для аудита.
//  АдресIP - Строка - адрес клиента для аудита (необязательный, по умолчанию "").
//
Процедура Сбросить(Знач Ключ, Знач Кто, Знач АдресIP = "") Экспорт

	НормКлюч = ПроверенныйКлюч(Ключ);

	// снимок ДО удаления: после него сведений уже нет, и в журнал ушло бы «сняли ничто»
	Было = Снимок(НормКлюч);

	Хранилище.Удалить(НормКлюч);
	Кэш.Удалить(НормКлюч);

	Записать(НормКлюч, "настройка.сброшена", Было, Кто, АдресIP);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверенныйКлюч(Знач Ключ)

	Норм = НРег(СокрЛП(Строка(Ключ)));
	Если Ключи().Найти(Норм) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"Брендовые активы: неизвестный ключ ""%1"". Допустимы только %2",
			Ключ, СтрСоединить(Ключи(), ", "));
	КонецЕсли;
	Возврат Норм;

КонецФункции

Функция СведенияИзБазы(Знач Ключ, Знач Момент)

	Запись = Хранилище.Актив(Ключ);
	Если Запись = Неопределено Тогда
		Возврат Новый Структура("Есть, ТипКонтента, Отпечаток, Размер, ПубличноеИмя, Момент",
			Ложь, "", "", 0, "", Момент);
	КонецЕсли;

	Отпечаток_ = НРег(СокрЛП(Строка(Запись.Отпечаток)));
	Возврат Новый Структура("Есть, ТипКонтента, Отпечаток, Размер, ПубличноеИмя, Момент",
		Истина, Строка(Запись.ТипКонтента), Отпечаток_, Запись.Размер,
		СобратьИмя(Ключ, Отпечаток_, Строка(Запись.ТипКонтента)), Момент);

КонецФункции

Функция СобратьИмя(Знач Ключ, Знач Отпечаток_, Знач ТипКонтента)

	Расширение = Типы.РасширениеТипа(ТипКонтента);
	Имя = Ключ + "-" + Лев(Отпечаток_, ДлинаПрефиксаХеша());
	Возврат ?(ЗначениеЗаполнено(Расширение), Имя + "." + Расширение, Имя);

КонецФункции

// Столько же символов отпечатка, сколько несут адреса статики: адрес не должен выглядеть
// по-разному у фирменной и загруженной картинки.
Функция ДлинаПрефиксаХеша()
	Возврат 16;
КонецФункции

Функция Отпечаток(Знач Данные)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

Функция Вердикт(Знач Код, Знач Потолок, Знач Размер)
	Возврат Новый Структура("Принято, Код, Потолок, Размер",
		НЕ ЗначениеЗаполнено(Код), Код, Потолок, Размер);
КонецФункции

// Снимок состояния актива для журнала: Неопределено означает «фирменная из поставки».
Функция Снимок(Знач Ключ)

	Сведения_ = Сведения(Ключ);
	Если НЕ Сведения_.Есть Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("тип, размер, отпечаток",
		Сведения_.ТипКонтента, Сведения_.Размер, Сведения_.Отпечаток);

КонецФункции

// След в журнале: объект называется настройкой, потому что для администратора это она
// и есть, но пространство имён своё — с ключами реестра активы не пересекаются.
// Пишется парой «было/стало», как у СервисНастроек: из записи обязано быть видно,
// что именно заменили или сняли.
Процедура Записать(Знач Ключ, Знач Действие, Знач Было, Знач Кто, Знач АдресIP)

	Детали = Новый Структура("актив, было, стало", Ключ, Было, Снимок(Ключ));
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Детали);

	Данные = Новый Структура();
	Данные.Вставить("Кто", Кто);
	Данные.Вставить("Действие", Действие);
	Данные.Вставить("Объект", ИменаЖурнала.Настройка("oshub.ui.asset." + Ключ));
	Данные.Вставить("ДеталиJSON", ЗаписьJSON.Закрыть());
	Данные.Вставить("АдресIP", АдресIP);

	Издатель.Опубликовать(Издатель.ТипНастройкаИзменена(), Данные);

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеБрендовыхАктивов") _Хранилище,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ТипыКартинок") _Типы,
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "ИмяОбъектаАудита") _ИменаЖурнала) Экспорт

	Хранилище = _Хранилище;
	Настройки = _Настройки;
	Типы = _Типы;
	Издатель = _Издатель;
	ИменаЖурнала = _ИменаЖурнала;
	Кэш = Новый Соответствие();
	КэшСекунд = 5;

КонецПроцедуры
