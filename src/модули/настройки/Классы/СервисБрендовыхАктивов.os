// Картинки оформления, загруженные администратором: знак шапки и иконка сайта. Пустое
// хранилище означает «в ходу фирменные из поставки». Порогов два: размер и тип отдачи.

Перем Хранилище;     // ХранилищеБрендовыхАктивов (настройки)
Перем Настройки;     // СервисНастроек (настройки) — потолок размера
Перем Типы;          // ТипыКартинок (настройки)
Перем Издатель;      // ИздательСобытий (события)
Перем ИменаЖурнала;   // ИмяОбъектаАудита (аудит)
Перем СобытиеЖурнала; // СобытиеАудита (аудит) — форма нагрузки записи
Перем Хеши;           // Хеш (основа)
Перем Вердикты;       // Вердикт (основа) — форма ответа
Перем Кэш;           // Соответствие: ключ -> Структура сведений с полем Момент
Перем КэшСекунд;
Перем ЗамокКэша;     // БлокировкаРесурса — кэш делят потоки запросов
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Ключ знака — картинки в шапке рядом с названием.
//
// Возвращаемое значение:
//  Строка
//
Функция КлючЗнака() Экспорт
	Возврат "logo";
КонецФункции

// Ключ иконки сайта.
//
// Возвращаемое значение:
//  Строка
//
Функция КлючИконки() Экспорт
	Возврат "favicon";
КонецФункции

// Все ключи активов в порядке показа.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция Ключи() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(КлючЗнака());
	Результат.Добавить(КлючИконки());
	Возврат Результат;

КонецФункции

// Ключ настройки потолка размера загружаемой картинки.
//
// Возвращаемое значение:
//  Строка
//
Функция КлючПотолка() Экспорт
	Возврат "oshub.ui.asset.max_bytes";
КонецФункции

// Действующий потолок размера картинки в байтах.
//
// Возвращаемое значение:
//  Число
//
&Наблюдаемый
Функция ПотолокБайт() Экспорт
	Возврат Настройки.Значение(КлючПотолка());
КонецФункции

// Код отказа «файл не выбран или пуст».
//
// Возвращаемое значение:
//  Строка
//
Функция КодПусто() Экспорт
	Возврат "empty";
КонецФункции

// Код отказа «файл больше потолка».
//
// Возвращаемое значение:
//  Строка
//
Функция КодВелик() Экспорт
	Возврат "too_large";
КонецФункции

// Код отказа «это не картинка известного формата».
//
// Возвращаемое значение:
//  Строка
//
Функция КодТип() Экспорт
	Возврат "unsupported_type";
КонецФункции

// Сведения об активе без содержимого — из короткого кэша: их спрашивает каждая отрисовка.
//
// Параметры:
//  Ключ - Строка - ключ актива.
//
// Возвращаемое значение:
//  Структура - Есть (Булево), ТипКонтента, Отпечаток, Размер, ПубличноеИмя.
//
&Наблюдаемый
Функция Сведения(&АтрибутСпана("oshub.asset.key") Знач Ключ) Экспорт

	НормКлюч = ПроверенныйКлюч(Ключ);

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Запись = Запомненное(НормКлюч);
	Если Запись <> Неопределено И Сейчас - Запись.Момент < КэшСекунд * 1000 Тогда
		Возврат Запись;
	КонецЕсли;

	// база спрашивается вне замка: два промахнувшихся разом потока положат одни и те же сведения
	Запись = СведенияИзБазы(НормКлюч, Сейчас);
	Запомнить(НормКлюч, Запись);
	Возврат Запись;

КонецФункции

// Байты актива — их читает только отдача по адресу, поэтому кэша здесь нет.
//
// Параметры:
//  Ключ - Строка - ключ актива.
//
// Возвращаемое значение:
//  ДвоичныеДанные, Неопределено - Неопределено, если ничего не загружали.
//
&Наблюдаемый
Функция Содержимое(Знач Ключ) Экспорт

	Запись = Хранилище.Актив(ПроверенныйКлюч(Ключ));
	Возврат ?(Запись = Неопределено, Неопределено, Запись.Содержимое);

КонецФункции

// Публичное имя актива: ключ, отпечаток содержимого и расширение типа — новая картинка
// всегда получает новый адрес.
//
// Параметры:
//  Ключ - Строка - ключ актива.
//
// Возвращаемое значение:
//  Строка - имя вида "logo-1f2e3d4c5b6a7988.svg" либо "" для незагруженного актива.
//
&Наблюдаемый
Функция ПубличноеИмя(Знач Ключ) Экспорт
	Возврат Сведения(Ключ).ПубличноеИмя;
КонецФункции

// Ключ актива, которому принадлежит публичное имя из адреса: имя сравнивается целиком.
//
// Параметры:
//  Имя - Строка - сегмент адреса.
//
// Возвращаемое значение:
//  Строка - ключ актива либо "" — такого адреса нет.
//
&Наблюдаемый
Функция КлючПоПубличномуИмени(Знач Имя) Экспорт

	Искомое = СокрЛП(Строка(Имя));
	Если НЕ ЗначениеЗаполнено(Искомое) Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого Ключ Из Ключи() Цикл
		Если Сведения(Ключ).ПубличноеИмя = Искомое Тогда
			Возврат Ключ;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Записывает картинку: одна строка на ключ, повтор перезаписывает её.
//
// Параметры:
//  Ключ - Строка - ключ актива.
//  Данные - ДвоичныеДанные, Неопределено - байты файла.
//  ОбъявленныйТип - Строка - Content-Type части формы.
//  ИмяФайла - Строка - имя файла из формы.
//  Кто - Строка - логин администратора для аудита.
//  АдресIP - Строка - адрес клиента для аудита (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка: "" при успехе, иначе см. Код*),
//              Потолок (Число), Размер (Число).
//
&Наблюдаемый
Функция Загрузить(&АтрибутСпана("oshub.asset.key") Знач Ключ, Знач Данные,
	Знач ОбъявленныйТип, Знач ИмяФайла, Знач Кто, Знач АдресIP = "") Экспорт

	НормКлюч = ПроверенныйКлюч(Ключ);
	Потолок = ПотолокБайт();

	Если Данные = Неопределено ИЛИ Данные.Размер() = 0 Тогда
		Возврат ИтогЗагрузки(КодПусто(), Потолок, 0);
	КонецЕсли;
	Если Данные.Размер() > Потолок Тогда
		Возврат ИтогЗагрузки(КодВелик(), Потолок, Данные.Размер());
	КонецЕсли;

	ТипКонтента = Типы.ТипОтдачи(ОбъявленныйТип, ИмяФайла);
	Если НЕ ЗначениеЗаполнено(ТипКонтента) Тогда
		Возврат ИтогЗагрузки(КодТип(), Потолок, Данные.Размер());
	КонецЕсли;

	// снимок ДО записи: журнал, в котором не видно, что заменили, ничем не лучше
	// отсутствующего журнала
	Было = Снимок(НормКлюч);

	Хранилище.Установить(НормКлюч, Данные, ТипКонтента, Отпечаток(Данные), Кто,
		ТекущаяУниверсальнаяДата());
	Забыть(НормКлюч);

	Записать(НормКлюч, "настройка.изменена", "изменено", Было, Кто, АдресIP);
	Возврат ИтогЗагрузки("", Потолок, Данные.Размер());

КонецФункции

// Возврат к фирменной картинке из поставки: идемпотентен, пишется в аудит.
//
// Параметры:
//  Ключ - Строка - ключ актива.
//  Кто - Строка - логин администратора для аудита.
//  АдресIP - Строка - адрес клиента для аудита (необязательный, по умолчанию "").
//
&Наблюдаемый
Процедура Сбросить(&АтрибутСпана("oshub.asset.key") Знач Ключ, Знач Кто,
	Знач АдресIP = "") Экспорт

	НормКлюч = ПроверенныйКлюч(Ключ);

	// снимок ДО удаления: после него сведений уже нет, и в журнал ушло бы «сняли ничто»
	Было = Снимок(НормКлюч);

	Хранилище.Удалить(НормКлюч);
	Забыть(НормКлюч);

	Записать(НормКлюч, "настройка.сброшена", "сброшено", Было, Кто, АдресIP);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверенныйКлюч(Знач Ключ)

	Норм = НРег(СокрЛП(Строка(Ключ)));
	Если Ключи().Найти(Норм) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"Брендовые активы: неизвестный ключ ""%1"". Допустимы только %2",
			Ключ, СтрСоединить(Ключи(), ", "));
	КонецЕсли;
	Возврат Норм;

КонецФункции

// Записи кэша заменяются целиком, поэтому под замком стоит только сам поиск.
Функция Запомненное(Знач Ключ)

	ЗамокКэша.Заблокировать();
	Попытка
		Запись = Кэш.Получить(Ключ);
	Исключение
		ЗамокКэша.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	ЗамокКэша.Разблокировать();

	Возврат Запись;

КонецФункции

Процедура Запомнить(Знач Ключ, Знач Запись)

	ЗамокКэша.Заблокировать();
	Попытка
		Кэш.Вставить(Ключ, Запись);
	Исключение
		ЗамокКэша.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	ЗамокКэша.Разблокировать();

КонецПроцедуры

Процедура Забыть(Знач Ключ)

	ЗамокКэша.Заблокировать();
	Попытка
		Кэш.Удалить(Ключ);
	Исключение
		ЗамокКэша.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	ЗамокКэша.Разблокировать();

КонецПроцедуры

Функция СведенияИзБазы(Знач Ключ, Знач Момент)

	Запись = Хранилище.Актив(Ключ);
	Если Запись = Неопределено Тогда
		Возврат НовыеСведения(Ложь, "", "", 0, "", Момент);
	КонецЕсли;

	Хеш = НРег(СокрЛП(Строка(Запись.Отпечаток)));
	Тип = Строка(Запись.ТипКонтента);
	Возврат НовыеСведения(Истина, Тип, Хеш, Запись.Размер, СобратьИмя(Ключ, Хеш, Тип), Момент);

КонецФункции

Функция НовыеСведения(Знач Есть, Знач ТипКонтента, Знач Отпечаток, Знач Размер, Знач ПубличноеИмя, Знач Момент)
	Возврат Новый Структура("Есть, ТипКонтента, Отпечаток, Размер, ПубличноеИмя, Момент",
		Есть, ТипКонтента, Отпечаток, Размер, ПубличноеИмя, Момент);
КонецФункции

Функция СобратьИмя(Знач Ключ, Знач Хеш, Знач ТипКонтента)

	Расширение = Типы.РасширениеТипа(ТипКонтента);
	Имя = Ключ + "-" + Лев(Хеш, ДлинаПрефиксаХеша());
	Возврат ?(ЗначениеЗаполнено(Расширение), Имя + "." + Расширение, Имя);

КонецФункции

// Длина отпечатка в имени — как у адресов статики.
Функция ДлинаПрефиксаХеша()
	Возврат Хеши.ДлинаОтпечатка();
КонецФункции

Функция Отпечаток(Знач Данные)
	Возврат Хеши.ОтДанных(Данные);
КонецФункции

Функция ИтогЗагрузки(Знач Код, Знач Потолок, Знач Размер)

	Поля = Новый Структура("Потолок, Размер", Потолок, Размер);
	Возврат ?(ЗначениеЗаполнено(Код), Вердикты.Отказ(Код, Поля), Вердикты.Успех(Поля));

КонецФункции

// Снимок состояния актива для журнала: Неопределено означает «фирменная из поставки».
Функция Снимок(Знач Ключ)

	СведенияАктива = Сведения(Ключ);
	Если НЕ СведенияАктива.Есть Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("тип, размер, отпечаток",
		СведенияАктива.ТипКонтента, СведенияАктива.Размер, СведенияАктива.Отпечаток);

КонецФункции

// След в журнале парой «было/стало», как у СервисНастроек, но в своём пространстве имён; журнал хаба — словом.
Процедура Записать(Знач Ключ, Знач Действие, Знач Исход, Знач Было, Знач Кто, Знач АдресIP)

	Если Лог <> Неопределено Тогда
		Лог.Информация("Оформление ""%1"" %2, кто ""%3""", Ключ, Исход, Кто);
	КонецЕсли;
	Детали = Новый Структура("актив, было, стало", Ключ, Было, Снимок(Ключ));

	Издатель.Опубликовать(Издатель.ТипНастройкаИзменена(), СобытиеЖурнала.Собрать(
		Кто, Действие, ИменаЖурнала.Настройка("oshub.ui.asset." + Ключ), "", Детали, АдресIP));

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеБрендовыхАктивов") _Хранилище,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ТипыКартинок") _Типы,
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "ИмяОбъектаАудита") _ИменаЖурнала,
	&Пластилин(Значение = "СобытиеАудита") _Событие,
	&Пластилин(Значение = "Хеш") _Хеши = Неопределено,
	&Лог _Лог = Неопределено) Экспорт

	Хранилище = _Хранилище;
	Настройки = _Настройки;
	Типы = _Типы;
	Издатель = _Издатель;
	ИменаЖурнала = _ИменаЖурнала;
	СобытиеЖурнала = _Событие;
	Хеши = ?(_Хеши = Неопределено, Новый Хеш(), _Хеши);
	Кэш = Новый Соответствие();
	// строка актива несёт картинку целиком; свою запись правка забывает сразу
	КэшСекунд = 60;
	ЗамокКэша = Новый БлокировкаРесурса(ЭтотОбъект);

	Вердикты = Новый Вердикт();
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
