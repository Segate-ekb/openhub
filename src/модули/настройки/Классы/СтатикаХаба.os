// Статика этой инсталляции — реализация контракта кита «СтатикаИнсталляции»: какие файлы
// хаб отдаёт по /static, в каком подкаталоге они лежат и с каким типом уходят. Под каким
// адресом файл виден снаружи, знает кит; здесь — только поставка.
//
// Здесь живёт ЛИЦО ЭТОГО ХАБА: знак, иконка вкладки, иконка домашнего экрана, свой лист
// стилей поверх базового и свой скрипт. Общее — базовый лист, глифы и значки чужих
// сервисов — везёт кит, и переобъявлять его файлы здесь нечего.

Перем Корень;  // Строка - абсолютный путь к каталогу статики инсталляции

#Область КонтрактКита

// Каталог статики инсталляции на диске.
//
// Возвращаемое значение:
//  Строка
//
Функция Каталог() Экспорт
	Возврат Корень;
КонецФункции

// Файлы, которые хаб отдаёт по /static.
//
// Возвращаемое значение:
//  Соответствие - имя файла (Строка) -> Структура("Подкаталог, ТипКонтента").
//
Функция Файлы() Экспорт

	Результат = Новый Соответствие();

	Объявить(Результат, ФайлСтилей(), "", "text/css; charset=utf-8");
	Объявить(Результат, ФайлСкрипта(), "", "application/javascript; charset=utf-8");
	Объявить(Результат, ФайлИконки(), ПодкаталогБренда(), ТипИконки());
	Объявить(Результат, ФайлЗапаснойИконки(), ПодкаталогБренда(), ТипЗапаснойИконки());
	Объявить(Результат, ФайлЗнака(), ПодкаталогБренда(), ТипИконки());
	Объявить(Результат, ФайлИконкиДомашнегоЭкрана(), ПодкаталогБренда(),
		ТипИконкиДомашнегоЭкрана());

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ИменаФайлов

// Имя файла стилей на диске — без версии и хеша.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлСтилей() Экспорт
	Возврат "openhub.css";
КонецФункции

// Имя файла скрипта на диске — ванильный, без сборки.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлСкрипта() Экспорт
	Возврат "openhub.js";
КонецФункции

// Имя файла иконки сайта.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлИконки() Экспорт
	Возврат "favicon.svg";
КонецФункции

// Имя файла запасной иконки сайта: многоразмерный .ico для тех, кто не берёт SVG.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлЗапаснойИконки() Экспорт
	Возврат "favicon.ico";
КонецФункции

// Имя файла знака бренда — того, что стоит в шапке сайта рядом с названием.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлЗнака() Экспорт
	Возврат "mark.svg";
КонецФункции

// Имя файла иконки для домашнего экрана мобильного устройства.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлИконкиДомашнегоЭкрана() Экспорт
	Возврат "apple-touch-icon.png";
КонецФункции

#КонецОбласти

#Область ТипыИПодкаталоги

// Тип контента иконки сайта — нужен разметке <link type="…">, чтобы тип не разъехался
// с белым списком отдачи.
//
// Возвращаемое значение:
//  Строка
//
Функция ТипИконки() Экспорт
	Возврат "image/svg+xml";
КонецФункции

// Тип контента запасной иконки сайта.
//
// Возвращаемое значение:
//  Строка
//
Функция ТипЗапаснойИконки() Экспорт
	Возврат "image/vnd.microsoft.icon";
КонецФункции

// Тип контента иконки домашнего экрана.
//
// Возвращаемое значение:
//  Строка
//
Функция ТипИконкиДомашнегоЭкрана() Экспорт
	Возврат "image/png";
КонецФункции

// Подкаталог знака инсталляции.
//
// Возвращаемое значение:
//  Строка
//
Функция ПодкаталогБренда() Экспорт
	Возврат "бренд";
КонецФункции

// Имя каталога статики относительно src/.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяКаталога() Экспорт
	Возврат "статика";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Объявить(Раскладка, Знач Имя, Знач Подкаталог, Знач ТипКонтента)
	Раскладка.Вставить(Имя,
		Новый Структура("Подкаталог, ТипКонтента", Подкаталог, ТипКонтента));
КонецПроцедуры

// Каталог ищется ВВЕРХ по имени, а не отсчётом уровней: жёсткий отсчёт ломается при
// перекладке классов, и статика «пропадает» молча — адреса вырождаются в /static/openhub.css
// без хеша, а страницы продолжают отдаваться.
Функция НайтиКаталог()

	Текущий = Новый Файл(ТекущийСценарий().Источник).Путь;

	// предел страхует от зацикливания на корне файловой системы
	Для Шаг = 1 По 12 Цикл

		Кандидат = ОбъединитьПути(Текущий, ИмяКаталога());
		Если Новый Файл(Кандидат).Существует() Тогда
			Возврат Кандидат;
		КонецЕсли;

		Родитель = Новый Файл(Текущий).Путь;
		Если НЕ ЗначениеЗаполнено(Родитель) ИЛИ Родитель = Текущий Тогда
			Прервать;
		КонецЕсли;
		Текущий = Родитель;

	КонецЦикла;

	ВызватьИсключение СтрШаблон(
		"Каталог статики ""%1"" не найден ни в одном родительском каталоге %2."
			+ " Без него адреса ассетов теряют контент-хеш.",
		ИмяКаталога(), Новый Файл(ТекущийСценарий().Источник).Путь);

КонецФункции

#КонецОбласти

&Верховный
&Прозвище("СтатикаИнсталляции")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
	Корень = НайтиКаталог();
КонецПроцедуры
