// Статика этой инсталляции — реализация контракта кита «СтатикаИнсталляции»: знак, иконки,
// свой лист стилей поверх базового, свой скрипт и вендоренный Swagger UI, которым рисуется
// страница описания API. Общее для всех хабов везёт кит.

Перем Корень;  // Строка - абсолютный путь к каталогу статики инсталляции

#Область КонтрактКита

// Каталог статики инсталляции на диске.
//
// Возвращаемое значение:
//  Строка
//
Функция Каталог() Экспорт
	Возврат Корень;
КонецФункции

// Файлы, которые хаб отдаёт по /static.
//
// Возвращаемое значение:
//  Соответствие - имя файла (Строка) -> Структура("Подкаталог, ТипКонтента").
//
Функция Файлы() Экспорт

	Результат = Новый Соответствие();

	Объявить(Результат, ФайлСтилей(), "", ТипСтилей());
	Объявить(Результат, ФайлСкрипта(), "", ТипСкрипта());
	Объявить(Результат, ФайлЗапускаОписанияAPI(), "", ТипСкрипта());
	Объявить(Результат, ФайлИконки(), ПодкаталогБренда(), ТипИконки());
	Объявить(Результат, ФайлЗапаснойИконки(), ПодкаталогБренда(), ТипЗапаснойИконки());
	Объявить(Результат, ФайлЗнака(), ПодкаталогБренда(), ТипИконки());
	Объявить(Результат, ФайлИконкиДомашнегоЭкрана(), ПодкаталогБренда(),
		ТипИконкиДомашнегоЭкрана());

	ОбъявитьSwaggerUI(Результат);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ИменаФайлов

// Имя файла стилей на диске — без версии и хеша.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлСтилей() Экспорт
	Возврат "openhub.css";
КонецФункции

// Имя файла скрипта на диске — ванильный, без сборки.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлСкрипта() Экспорт
	Возврат "openhub.js";
КонецФункции

// Имя файла, которым хаб запускает движок на своей странице описания API. Свой скрипт,
// а не вендоренный: адрес описания и тема приезжают в него разметкой.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлЗапускаОписанияAPI() Экспорт
	Возврат "openhub-swagger.js";
КонецФункции

// Имя файла иконки сайта.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлИконки() Экспорт
	Возврат "favicon.svg";
КонецФункции

// Имя файла запасной иконки сайта: многоразмерный .ico для тех, кто не берёт SVG.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлЗапаснойИконки() Экспорт
	Возврат "favicon.ico";
КонецФункции

// Имя файла знака бренда — того, что стоит в шапке сайта рядом с названием.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлЗнака() Экспорт
	Возврат "mark.svg";
КонецФункции

// Имя файла иконки для домашнего экрана мобильного устройства.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлИконкиДомашнегоЭкрана() Экспорт
	Возврат "apple-touch-icon.png";
КонецФункции

#КонецОбласти

#Область ВендоренныйSwaggerUI

// Имя файла стилей Swagger UI — того, которым движок рисует сам себя.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлЛистаSwaggerUI() Экспорт
	Возврат "swagger-ui.css";
КонецФункции

// Имя файла движка Swagger UI: раскладка BaseLayout живёт в нём же, поэтому отдельный
// standalone-пресет инсталляции не нужен.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлДвижкаSwaggerUI() Экспорт
	Возврат "swagger-ui-bundle.js";
КонецФункции

// Имя файла с текстом разрешения на движок: авторство указывается в отдаваемом файле,
// а не только в записи о происхождении.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлЛицензииSwaggerUI() Экспорт
	Возврат "swagger-ui-LICENSE.txt";
КонецФункции

// Имя файла с уведомлением об авторских правах на движок.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлАвторстваSwaggerUI() Экспорт
	Возврат "swagger-ui-NOTICE.txt";
КонецФункции

// Имя файла с уведомлениями об авторстве библиотек, вкатанных сборкой внутрь движка:
// на него ссылается первая строка самого движка, поэтому имя оставлено как в пакете.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлЛицензийЗависимостейSwaggerUI() Экспорт
	Возврат "swagger-ui-bundle.js.LICENSE.txt";
КонецФункции

#КонецОбласти

#Область ТипыИПодкаталоги

// Тип контента таблицы стилей.
//
// Возвращаемое значение:
//  Строка
//
Функция ТипСтилей() Экспорт
	Возврат "text/css; charset=utf-8";
КонецФункции

// Тип контента скрипта.
//
// Возвращаемое значение:
//  Строка
//
Функция ТипСкрипта() Экспорт
	Возврат "application/javascript; charset=utf-8";
КонецФункции

// Тип контента отдаваемого текста — разрешений и уведомлений об авторстве.
//
// Возвращаемое значение:
//  Строка
//
Функция ТипТекста() Экспорт
	Возврат "text/plain; charset=utf-8";
КонецФункции

// Тип контента иконки сайта — нужен разметке <link type="…">, чтобы тип не разъехался
// с белым списком отдачи.
//
// Возвращаемое значение:
//  Строка
//
Функция ТипИконки() Экспорт
	Возврат "image/svg+xml";
КонецФункции

// Тип контента запасной иконки сайта.
//
// Возвращаемое значение:
//  Строка
//
Функция ТипЗапаснойИконки() Экспорт
	Возврат "image/vnd.microsoft.icon";
КонецФункции

// Тип контента иконки домашнего экрана.
//
// Возвращаемое значение:
//  Строка
//
Функция ТипИконкиДомашнегоЭкрана() Экспорт
	Возврат "image/png";
КонецФункции

// Подкаталог знака инсталляции.
//
// Возвращаемое значение:
//  Строка
//
Функция ПодкаталогБренда() Экспорт
	Возврат "бренд";
КонецФункции

// Подкаталог вендоренного Swagger UI: всё, что приехало из чужого пакета, лежит одной
// кучкой, и происхождение любого файла видно по месту.
//
// Возвращаемое значение:
//  Строка
//
Функция ПодкаталогSwaggerUI() Экспорт
	Возврат "swagger-ui";
КонецФункции

// Имя каталога статики относительно src/.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяКаталога() Экспорт
	Возврат "статика";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Объявить(Раскладка, Знач Имя, Знач Подкаталог, Знач ТипКонтента)
	Раскладка.Вставить(Имя,
		Новый Структура("Подкаталог, ТипКонтента", Подкаталог, ТипКонтента));
КонецПроцедуры

// Здесь только вендоренное: Swagger UI приехал из чужого пакета целиком, вместе
// с разрешением и уведомлениями об авторстве. Страница описания API собирается из этих
// файлов и наружу за ними не ходит.
Процедура ОбъявитьSwaggerUI(Раскладка)

	Объявить(Раскладка, ФайлЛистаSwaggerUI(), ПодкаталогSwaggerUI(), ТипСтилей());
	Объявить(Раскладка, ФайлДвижкаSwaggerUI(), ПодкаталогSwaggerUI(), ТипСкрипта());
	Объявить(Раскладка, ФайлЛицензииSwaggerUI(), ПодкаталогSwaggerUI(), ТипТекста());
	Объявить(Раскладка, ФайлАвторстваSwaggerUI(), ПодкаталогSwaggerUI(), ТипТекста());
	Объявить(Раскладка, ФайлЛицензийЗависимостейSwaggerUI(), ПодкаталогSwaggerUI(),
		ТипТекста());

КонецПроцедуры

// Каталог ищется ВВЕРХ по имени, а не отсчётом уровней: отсчёт ломается при перекладке классов.
Функция НайтиКаталог()

	Текущий = Новый Файл(ТекущийСценарий().Источник).Путь;

	// предел страхует от зацикливания на корне файловой системы
	Для Шаг = 1 По 12 Цикл

		Кандидат = ОбъединитьПути(Текущий, ИмяКаталога());
		Если Новый Файл(Кандидат).Существует() Тогда
			Возврат Кандидат;
		КонецЕсли;

		Родитель = Новый Файл(Текущий).Путь;
		Если НЕ ЗначениеЗаполнено(Родитель) ИЛИ Родитель = Текущий Тогда
			Прервать;
		КонецЕсли;
		Текущий = Родитель;

	КонецЦикла;

	ВызватьИсключение СтрШаблон(
		"Каталог статики ""%1"" не найден ни в одном родительском каталоге %2."
			+ " Без него адреса ассетов теряют контент-хеш.",
		ИмяКаталога(), Новый Файл(ТекущийСценарий().Источник).Путь);

КонецФункции

#КонецОбласти

&Верховный
&Прозвище("СтатикаИнсталляции")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
	Корень = НайтиКаталог();
КонецПроцедуры
