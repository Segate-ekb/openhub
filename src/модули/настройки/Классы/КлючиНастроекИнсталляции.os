// Ключи настроек самой инсталляции: внешний адрес хаба и потолок картинки оформления.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей инсталляции в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи инсталляции.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(60)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "oshub.instance.url", ЗначениеПоУмолчанию = "") _АдресИнстанса = "",
	&Деталька(Значение = "oshub.ui.asset.max_bytes", ЗначениеПоУмолчанию = "") _ПотолокКартинки = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	// Внешний адрес хаба: из него выводится redirect_uri провайдеров входа.
	Ключи.Объявить("oshub.instance.url", "строка", "", _Правила.Адрес(), "прикладная", _АдресИнстанса);

	// Потолок картинки оформления: она лежит двоичной колонкой и читается строкой таблицы
	// целиком, поэтому мегабайта хватает знаку и иконке с запасом, а базу он бережёт.
	Ключи.Объявить("oshub.ui.asset.max_bytes", "целое", 1048576, _Правила.Минимум(1), "bootstrap",
		_ПотолокКартинки);

КонецПроцедуры
