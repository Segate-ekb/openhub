// Объявления ключей настроек одного предмета: ими предмет отвечает на контракт КлючиНастроек,
// а РеестрНастроек собирает объявления всех предметов в один перечень.

Перем Записи;   // Массив из Структура в порядке объявления
Перем Правки;   // Соответствие: ключ -> имя класса-механизма

#Область ПубличныйИнтерфейс

// Объявляет ключ настройки.
//
// Параметры:
//  Ключ - Строка - ключ настройки («oshub.mail.enabled»).
//  Тип - Строка - «строка», «целое» либо «булево».
//  Дефолт - Произвольный - значение из кода, когда ни конфигурация, ни база его не задали.
//  Валидатор - Структура, Неопределено - проверка из ВидыПроверок либо Неопределено.
//  Класс - Строка - «bootstrap» — только конфигурация, «прикладная» — правится из интерфейса.
//  Сырое - Произвольный - значение детальки этого ключа; Неопределено и "" — конфигурация
//          ключ не задала.
//
Процедура Объявить(Знач Ключ, Знач Тип, Знач Дефолт, Знач Валидатор, Знач Класс, Знач Сырое) Экспорт
	Добавить(Ключ, Тип, Дефолт, Валидатор, Класс, Ложь, Сырое);
КонецПроцедуры

// Объявляет секрет: значение, которое вводят, но не читают обратно — поле формы
// открывается пустым, карточка и API отдают маску.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//  Тип - Строка - «строка», «целое» либо «булево».
//  Дефолт - Произвольный - значение из кода.
//  Валидатор - Структура, Неопределено - проверка из ВидыПроверок либо Неопределено.
//  Класс - Строка - «bootstrap» либо «прикладная».
//  Сырое - Произвольный - значение детальки этого ключа.
//
Процедура ОбъявитьСекрет(Знач Ключ, Знач Тип, Знач Дефолт, Знач Валидатор, Знач Класс, Знач Сырое) Экспорт
	Добавить(Ключ, Тип, Дефолт, Валидатор, Класс, Истина, Сырое);
КонецПроцедуры

// Отдаёт правку ключа механизму: у такой настройки правка — переход (предохранитель, снос,
// раздача), а не запись значения, и пишет её только названный класс. Ключ вправе принадлежать
// другому предмету: реестр сверяет его с объявленными ключами всех предметов.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//  ИмяКласса - Строка - класс, который пишет значение через СервисНастроек.УстановитьМеханизмом.
//
Процедура ПравитМеханизм(Знач Ключ, Знач ИмяКласса) Экспорт
	Правки.Вставить(Ключ, ИмяКласса);
КонецПроцедуры

// Ключи в порядке объявления.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Ключ - Строка - ключ настройки.
//   * Тип - Строка - «строка», «целое» либо «булево».
//   * Дефолт - Произвольный - значение из кода.
//   * Валидатор - Структура, Неопределено - проверка либо Неопределено.
//   * Класс - Строка - «bootstrap» либо «прикладная».
//   * Секрет - Булево - значение вводят, но не читают обратно.
//   * Сырое - Произвольный - значение детальки ключа.
//
Функция Ключи() Экспорт
	Возврат Записи;
КонецФункции

// Ключи, правку которых ведёт механизм.
//
// Возвращаемое значение:
//  Соответствие - ключ -> имя класса-механизма.
//
Функция Механизмы() Экспорт
	Возврат Правки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Добавить(Знач Ключ, Знач Тип, Знач Дефолт, Знач Валидатор, Знач Класс,
	Знач Секрет, Знач Сырое)

	Записи.Добавить(Новый Структура("Ключ, Тип, Дефолт, Валидатор, Класс, Секрет, Сырое",
		Ключ, Тип, Дефолт, Валидатор, Класс, Секрет, Сырое));

КонецПроцедуры

#КонецОбласти

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	Правки = Новый Соответствие();
КонецПроцедуры
