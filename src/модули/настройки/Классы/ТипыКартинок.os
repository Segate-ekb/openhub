// Таблица «Content-Type ↔ расширение» для картинок оформления — желудь модуля настройки.
// Содержимое файла не разбирается и не проверяется НИКОГДА (решение владельца):
// таблица отвечает лишь на вопрос «под каким типом это отдавать» и защищает заголовок
// ответа от произвольной строки клиента.

Перем ПоТипу;          // Соответствие: Content-Type -> расширение
Перем ПоРасширению;    // Соответствие: расширение -> Content-Type

// Тип отдачи для загруженного файла: объявленный браузером, если он в таблице, иначе
// выведенный из расширения имени.
//
// Параметры:
//  ОбъявленныйТип - Строка - значение Content-Type части формы.
//  ИмяФайла - Строка - имя файла из формы.
//
// Возвращаемое значение:
//  Строка - канонический Content-Type либо "" — таким файлам отказывают.
//
Функция ТипОтдачи(Знач ОбъявленныйТип, Знач ИмяФайла) Экспорт

	Канон = Канонический(ОбъявленныйТип);
	Если ПоТипу.Получить(Канон) <> Неопределено Тогда
		Возврат Канон;
	КонецЕсли;

	ПоИмени = ПоРасширению.Получить(Расширение(ИмяФайла));
	Возврат ?(ПоИмени = Неопределено, "", ПоИмени);

КонецФункции

// Расширение для типа — им заканчивается публичный адрес актива.
//
// Параметры:
//  ТипКонтента - Строка - канонический Content-Type.
//
// Возвращаемое значение:
//  Строка - расширение без точки либо "" для типа вне таблицы.
//
Функция РасширениеТипа(Знач ТипКонтента) Экспорт
	Найдено = ПоТипу.Получить(Канонический(ТипКонтента));
	Возврат ?(Найдено = Неопределено, "", Найдено);
КонецФункции

#Область СлужебныеПроцедурыИФункции

// Тип без параметров («image/svg+xml; charset=utf-8») и без регистра.
Функция Канонический(Знач Значение)

	Текст = НРег(СокрЛП(Строка(Значение)));
	Точка = СтрНайти(Текст, ";");
	Возврат ?(Точка = 0, Текст, СокрЛП(Лев(Текст, Точка - 1)));

КонецФункции

Функция Расширение(Знач ИмяФайла)

	Текст = НРег(СокрЛП(Строка(ИмяФайла)));
	Результат = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = "." Тогда
			Результат = "";
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура Объявить(Знач ТипКонтента, Знач Расширение_, Знач Основной)

	ПоРасширению.Вставить(Расширение_, ТипКонтента);
	// у типа расширение одно: первым объявляется то, которое пойдёт в адрес
	Если Основной Тогда
		ПоТипу.Вставить(ТипКонтента, Расширение_);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт

	ПоТипу = Новый Соответствие();
	ПоРасширению = Новый Соответствие();

	Объявить("image/svg+xml", "svg", Истина);
	Объявить("image/png", "png", Истина);
	Объявить("image/jpeg", "jpg", Истина);
	Объявить("image/jpeg", "jpeg", Ложь);
	Объявить("image/gif", "gif", Истина);
	Объявить("image/webp", "webp", Истина);
	Объявить("image/avif", "avif", Истина);
	Объявить("image/vnd.microsoft.icon", "ico", Истина);
	// исторический тип того же .ico: браузеры шлют и его
	ПоТипу.Вставить("image/x-icon", "ico");

КонецПроцедуры
