// Проверка значения настройки декларативным валидатором реестра — желудь модуля настройки.

#Область ПубличныйИнтерфейс

// Проверяет значение валидатором из описания настройки; непрошедшее — исключение.
//
// Параметры:
//  Значение - Произвольный - значение, уже приведённое к типу настройки.
//  Описание - Структура - описание настройки из РеестрНастроек.
//  Резолвер - Произвольный - источник действующих значений соседних ключей (СервисНастроек);
//             Неопределено — парные проверки пропускаются (необязательный, по умолчанию Неопределено).
//
Процедура Проверить(Знач Значение, Знач Описание, Знач Резолвер = Неопределено) Экспорт

	Валидатор = Описание.Валидатор;
	Если Валидатор = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Валидатор.Вид = "перечисление" Тогда
		ПроверитьПеречисление(Значение, Описание, Валидатор);
	ИначеЕсли Валидатор.Вид = "минимум" Тогда
		ПроверитьМинимум(Значение, Описание, Валидатор.Мин);
	ИначеЕсли Валидатор.Вид = "диапазон" Тогда
		ПроверитьМинимум(Значение, Описание, Валидатор.Мин);
		Если Значение > Валидатор.Макс Тогда
			ВызватьИсключение СтрШаблон("Настройка %1: значение %2 больше максимума %3",
				Описание.Ключ, Значение, Валидатор.Макс);
		КонецЕсли;
	ИначеЕсли Валидатор.Вид = "неБольшеКлюча" ИЛИ Валидатор.Вид = "неМеньшеКлюча" Тогда
		ПроверитьПару(Значение, Описание, Валидатор, Резолвер);
	ИначеЕсли Валидатор.Вид = "адрес" Тогда
		ПроверитьАдрес(Значение, Описание);
	ИначеЕсли Валидатор.Вид = "цвет" Тогда
		ПроверитьЦвет(Значение, Описание);
	КонецЕсли;

КонецПроцедуры

// Каноничная форма значения: значение перечисления приводится к записи из реестра,
// остальные типы отдаются как есть.
//
// Параметры:
//  Значение - Произвольный - значение, прошедшее Проверить.
//  Описание - Структура - описание настройки из РеестрНастроек.
//
// Возвращаемое значение:
//  Произвольный - каноничное значение.
//
Функция Каноничное(Знач Значение, Знач Описание) Экспорт

	Валидатор = Описание.Валидатор;
	Если Валидатор = Неопределено ИЛИ Валидатор.Вид <> "перечисление" Тогда
		Возврат Значение;
	КонецЕсли;

	Для Каждого Допустимое Из Валидатор.Значения Цикл
		Если НРег(СокрЛП(Допустимое)) = НРег(Строка(Значение)) Тогда
			Возврат СокрЛП(Допустимое);
		КонецЕсли;
	КонецЦикла;
	Возврат Значение;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьМинимум(Знач Значение, Знач Описание, Знач Мин)

	Если Значение < Мин Тогда
		ВызватьИсключение СтрШаблон("Настройка %1: значение %2 меньше минимума %3",
			Описание.Ключ, Значение, Мин);
	КонецЕсли;

КонецПроцедуры

// Пара границ, которые запирают друг друга: минимальная длина пароля выше максимальной
// не сужает требование, а делает вход невозможным, поэтому отвергается вводом.
Процедура ПроверитьПару(Знач Значение, Знач Описание, Знач Валидатор, Знач Резолвер)

	ПроверитьМинимум(Значение, Описание, Валидатор.Мин);

	Если Резолвер = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Сосед = Резолвер.Значение(Валидатор.Ключ);

	Если Валидатор.Вид = "неБольшеКлюча" И Значение > Сосед Тогда
		ВызватьИсключение СтрШаблон("Настройка %1: значение %2 больше, чем %3 (%4)",
			Описание.Ключ, Значение, Валидатор.Ключ, Сосед);
	КонецЕсли;
	Если Валидатор.Вид = "неМеньшеКлюча" И Значение < Сосед Тогда
		ВызватьИсключение СтрШаблон("Настройка %1: значение %2 меньше, чем %3 (%4)",
			Описание.Ключ, Значение, Валидатор.Ключ, Сосед);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПеречисление(Знач Значение, Знач Описание, Знач Валидатор)

	Для Каждого Допустимое Из Валидатор.Значения Цикл
		Если НРег(СокрЛП(Допустимое)) = НРег(Строка(Значение)) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение СтрШаблон("Настройка %1: ""%2"" вне допустимых значений (%3)",
		Описание.Ключ, Значение, СтрСоединить(Валидатор.Значения, ", "));

КонецПроцедуры

// Цвет уезжает в CSS-переменную внутри <style>, где HTML-экранирование бесполезно:
// пропускается только запись #rgb/#rrggbb, всё прочее — отказ с называнием формата.
Процедура ПроверитьЦвет(Знач Значение, Знач Описание)

	Текст = СокрЛП(Строка(Значение));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат;
	КонецЕсли;

	Хвост = ?(Лев(Текст, 1) = "#", Сред(Текст, 2), "");
	Годен = (СтрДлина(Хвост) = 3 ИЛИ СтрДлина(Хвост) = 6);

	Если Годен Тогда
		Для Поз = 1 По СтрДлина(Хвост) Цикл
			Если СтрНайти("0123456789abcdef", НРег(Сред(Хвост, Поз, 1))) = 0 Тогда
				Годен = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если НЕ Годен Тогда
		ВызватьИсключение СтрШаблон(
			"Настройка %1: ""%2"" не цвет — нужна запись #rrggbb либо #rgb",
			Описание.Ключ, Текст);
	КонецЕсли;

КонецПроцедуры

// Внешний адрес инсталляции: из него выводятся ссылки, которые администратор отдаёт
// наружу, поэтому принимается ровно «схема://хост[:порт]» — путь, запрос и якорь
// в такой основе означают опечатку, а не адрес.
Процедура ПроверитьАдрес(Знач Значение, Знач Описание)

	Адрес = СокрЛП(Строка(Значение));
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат;
	КонецЕсли;

	Позиция = Найти(Адрес, "://");
	Если Позиция = 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Настройка %1: адрес должен начинаться с https:// либо http://", Описание.Ключ);
	КонецЕсли;

	Схема = НРег(Лев(Адрес, Позиция - 1));
	Если Схема <> "https" И Схема <> "http" Тогда
		ВызватьИсключение СтрШаблон("Настройка %1: схема ""%2"" недопустима, нужны https либо http",
			Описание.Ключ, Схема);
	КонецЕсли;

	Остаток = Сред(Адрес, Позиция + 3);
	Хвост = "";
	Для Каждого Разделитель Из СтрРазделить("/,?,#", ",") Цикл
		П = Найти(Остаток, Разделитель);
		Если П > 0 Тогда
			Хвост = Хвост + Сред(Остаток, П);
			Остаток = Лев(Остаток, П - 1);
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(СокрЛП(Остаток)) Тогда
		ВызватьИсключение СтрШаблон("Настройка %1: в адресе не удалось определить хост", Описание.Ключ);
	КонецЕсли;
	Если Найти(Остаток, "@") > 0 Тогда
		ВызватьИсключение СтрШаблон("Настройка %1: запись вида user@host не допускается", Описание.Ключ);
	КонецЕсли;
	Если Найти(Адрес, " ") > 0 Тогда
		ВызватьИсключение СтрШаблон("Настройка %1: адрес не может содержать пробел", Описание.Ключ);
	КонецЕсли;
	Если ЗначениеЗаполнено(Хвост) И Хвост <> "/" Тогда
		ВызватьИсключение СтрШаблон(
			"Настройка %1: нужен только адрес хаба (%2://хост[:порт]), без пути ""%3""",
			Описание.Ключ, Схема, Хвост);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
