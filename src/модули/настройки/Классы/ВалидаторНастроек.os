// Проверка значения настройки декларативным валидатором реестра — желудь модуля настройки.

Перем Канон;  // КанонIP (основа) — разбор списка сетей
Перем Форма;  // ФормаАдреса (основа) — общий каркас проверки формы адреса
Перем Адреса; // РазборАдреса (основа) — граница адреса и пути

#Область ПубличныйИнтерфейс

// Ключ соседней настройки, действующее значение которой нужно проверке этой настройки.
// Спрашивается перед Проверить(): значение соседа добывает резолвер, а валидатор судит
// уже добытое — иначе проверка ходила бы за значениями сама и знала бы вызывающего.
//
// Параметры:
//  Описание - Структура - описание настройки из РеестрНастроек.
//
// Возвращаемое значение:
//  Строка - ключ соседа; пустая строка, если проверке сосед не нужен.
//
Функция КлючСоседа(Знач Описание) Экспорт

	Валидатор = Описание.Валидатор;
	Если Валидатор = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат ?(ЭтоПарная(Валидатор.Вид), Валидатор.Ключ, "");

КонецФункции

// Проверяет значение валидатором из описания настройки; непрошедшее — исключение.
//
// Параметры:
//  Значение - Произвольный - значение, уже приведённое к типу настройки.
//  Описание - Структура - описание настройки из РеестрНастроек.
//  ЗначениеСоседа - Произвольный - действующее значение ключа, названного КлючСоседа();
//                   Неопределено допустимо только там, где КлючСоседа() вернул пустую строку.
//
Процедура Проверить(Знач Значение, Знач Описание, Знач ЗначениеСоседа) Экспорт

	Валидатор = Описание.Валидатор;
	Если Валидатор = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Валидатор.Вид = "перечисление" Тогда
		ПроверитьПеречисление(Значение, Описание, Валидатор);
	ИначеЕсли Валидатор.Вид = "минимум" Тогда
		ПроверитьМинимум(Значение, Описание, Валидатор.Мин);
	ИначеЕсли Валидатор.Вид = "диапазон" Тогда
		ПроверитьМинимум(Значение, Описание, Валидатор.Мин);
		Если Значение > Валидатор.Макс Тогда
			ВызватьИсключение СтрШаблон("Настройка %1: значение %2 больше максимума %3",
				Описание.Ключ, Значение, Валидатор.Макс);
		КонецЕсли;
	ИначеЕсли ЭтоПарная(Валидатор.Вид) Тогда
		ПроверитьПару(Значение, Описание, Валидатор, ЗначениеСоседа);
	ИначеЕсли Валидатор.Вид = "адрес" Тогда
		ПроверитьАдрес(Значение, Описание);
	ИначеЕсли Валидатор.Вид = "цвет" Тогда
		ПроверитьЦвет(Значение, Описание);
	ИначеЕсли Валидатор.Вид = "сети" Тогда
		ПроверитьСети(Значение, Описание);
	КонецЕсли;

КонецПроцедуры

// Каноничная форма значения: значение перечисления приводится к записи из реестра,
// остальные типы отдаются как есть.
//
// Параметры:
//  Значение - Произвольный - значение, прошедшее Проверить.
//  Описание - Структура - описание настройки из РеестрНастроек.
//
// Возвращаемое значение:
//  Произвольный - каноничное значение.
//
Функция Каноничное(Знач Значение, Знач Описание) Экспорт

	Валидатор = Описание.Валидатор;
	Если Валидатор = Неопределено ИЛИ Валидатор.Вид <> "перечисление" Тогда
		Возврат Значение;
	КонецЕсли;

	Для Каждого Допустимое Из Валидатор.Значения Цикл
		Если НРег(СокрЛП(Допустимое)) = НРег(Строка(Значение)) Тогда
			Возврат СокрЛП(Допустимое);
		КонецЕсли;
	КонецЦикла;
	Возврат Значение;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Единственное место, где перечислены виды проверок, судящих значение вместе с соседом.
Функция ЭтоПарная(Знач Вид)
	Возврат Вид = "неБольшеКлюча" ИЛИ Вид = "неМеньшеКлюча";
КонецФункции

Процедура ПроверитьМинимум(Знач Значение, Знач Описание, Знач Мин)

	Если Значение < Мин Тогда
		ВызватьИсключение СтрШаблон("Настройка %1: значение %2 меньше минимума %3",
			Описание.Ключ, Значение, Мин);
	КонецЕсли;

КонецПроцедуры

// Минимальная длина пароля выше максимальной не сужает требование, а делает вход невозможным.
Процедура ПроверитьПару(Знач Значение, Знач Описание, Знач Валидатор, Знач Сосед)

	ПроверитьМинимум(Значение, Описание, Валидатор.Мин);

	// отсутствующий сосед — не «проверять нечего», а поломанный резолвер: пропусти его молча,
	// и пара границ, запирающая вход, снова начнёт сохраняться
	Если Сосед = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"Настройка %1: проверка сверяется с ключом %2, а его действующее значение не добыто",
			Описание.Ключ, Валидатор.Ключ);
	КонецЕсли;

	Если Валидатор.Вид = "неБольшеКлюча" И Значение > Сосед Тогда
		ВызватьИсключение СтрШаблон("Настройка %1: значение %2 больше, чем %3 (%4)",
			Описание.Ключ, Значение, Валидатор.Ключ, Сосед);
	КонецЕсли;
	Если Валидатор.Вид = "неМеньшеКлюча" И Значение < Сосед Тогда
		ВызватьИсключение СтрШаблон("Настройка %1: значение %2 меньше, чем %3 (%4)",
			Описание.Ключ, Значение, Валидатор.Ключ, Сосед);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПеречисление(Знач Значение, Знач Описание, Знач Валидатор)

	Для Каждого Допустимое Из Валидатор.Значения Цикл
		Если НРег(СокрЛП(Допустимое)) = НРег(Строка(Значение)) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение СтрШаблон("Настройка %1: ""%2"" вне допустимых значений (%3)",
		Описание.Ключ, Значение, СтрСоединить(Валидатор.Значения, ", "));

КонецПроцедуры

// Цвет уезжает в CSS-переменную, где HTML-экранирование бесполезно: только #rgb или #rrggbb.
Процедура ПроверитьЦвет(Знач Значение, Знач Описание)

	Текст = СокрЛП(Строка(Значение));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат;
	КонецЕсли;

	Хвост = ?(Лев(Текст, 1) = "#", Сред(Текст, 2), "");
	Годен = (СтрДлина(Хвост) = 3 ИЛИ СтрДлина(Хвост) = 6);

	Если Годен Тогда
		Для Поз = 1 По СтрДлина(Хвост) Цикл
			Если СтрНайти("0123456789abcdef", НРег(Сред(Хвост, Поз, 1))) = 0 Тогда
				Годен = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если НЕ Годен Тогда
		ВызватьИсключение СтрШаблон(
			"Настройка %1: ""%2"" не цвет — нужна запись #rrggbb либо #rgb",
			Описание.Ключ, Текст);
	КонецЕсли;

КонецПроцедуры

// Опечатка в списке доверенных сетей молча оставила бы список пустым, а хаб — слепым
// к заголовкам пересылки: негодная запись названа вместе с причиной.
Процедура ПроверитьСети(Знач Значение, Знач Описание)

	Разобранный = Канон.Список(Значение);
	Если НЕ ЗначениеЗаполнено(Разобранный.Негодная) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Настройка %1: ""%2"" не сеть — нужна запись CIDR вида 10.0.0.0/8 либо 2001:db8::/32,"
			+ " длина префикса в границах семейства адреса",
		Описание.Ключ, Разобранный.Негодная);

КонецПроцедуры

// Ровно «схема://хост[:порт]»: путь, запрос и якорь в основе внешних ссылок — опечатка.
Процедура ПроверитьАдрес(Знач Значение, Знач Описание)

	Адрес = СокрЛП(Строка(Значение));
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат;
	КонецЕсли;

	Схема = ПроверитьФормуАдреса(Адрес, Описание);
	ПроверитьОтсутствиеПути(Адрес, Схема, Описание);

КонецПроцедуры

// Форма адреса — общим каркасом: пусто, управляющий символ, схема, userinfo, хост.
// Возвращает схему: её называет отказ по пути.
Функция ПроверитьФормуАдреса(Знач Адрес, Знач Описание)

	Коды = Форма.Коды();
	Разбор = Форма.Разобрать(Адрес, "https,http");

	Если Разбор.Код = Коды.Управляющий Тогда
		ВызватьИсключение ?(Разбор.Символ = "пробел",
			СтрШаблон("Настройка %1: адрес не может содержать пробел", Описание.Ключ),
			СтрШаблон("Настройка %1: адрес не может содержать управляющий символ (%2)",
				Описание.Ключ, Разбор.Символ));
	ИначеЕсли Разбор.Код = Коды.СхемыНет Тогда
		ВызватьИсключение СтрШаблон(
			"Настройка %1: адрес должен начинаться с https:// либо http://", Описание.Ключ);
	ИначеЕсли Разбор.Код = Коды.ЧужаяСхема Тогда
		ВызватьИсключение СтрШаблон("Настройка %1: схема ""%2"" недопустима, нужны https либо http",
			Описание.Ключ, Разбор.Схема);
	ИначеЕсли Разбор.Код = Коды.ДанныеПользователя Тогда
		ВызватьИсключение СтрШаблон("Настройка %1: запись вида user@host не допускается", Описание.Ключ);
	ИначеЕсли Разбор.Код = Коды.ХостаНет Тогда
		ВызватьИсключение СтрШаблон("Настройка %1: в адресе не удалось определить хост", Описание.Ключ);
	КонецЕсли;

	Возврат Разбор.Схема;

КонецФункции

// За префиксом пути хаб жить не обещает: адрес инсталляции — основа, из которой
// собираются redirect_uri провайдера, образец конфига opm и ссылки писем.
Процедура ПроверитьОтсутствиеПути(Знач Адрес, Знач Схема, Знач Описание)

	Хвост = Сред(Адрес, СтрДлина(Адреса.ДоПути(Адрес)) + 1);
	Если ЗначениеЗаполнено(Хвост) И Хвост <> "/" Тогда
		ВызватьИсключение СтрШаблон(
			"Настройка %1: нужен только адрес хаба (%2://хост[:порт]), без пути ""%3""",
			Описание.Ключ, Схема, Хвост);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КанонIP") _Канон,
	&Пластилин(Значение = "ФормаАдреса") _Форма = Неопределено,
	&Пластилин(Значение = "РазборАдреса") _Адреса = Неопределено) Экспорт

	Канон = _Канон;
	Форма = ?(_Форма = Неопределено, Новый ФормаАдреса(), _Форма);
	Адреса = ?(_Адреса = Неопределено, Новый РазборАдреса(), _Адреса);

КонецПроцедуры
