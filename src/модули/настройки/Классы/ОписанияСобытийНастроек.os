// События настроек словами: изменённая или сброшенная прикладная настройка.

Перем События;  // ОбъявленияСобытий (события)

#Область ПубличныйИнтерфейс

// Объявления событий настроек в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияСобытий - события настроек словами.
//
Функция Объявления() Экспорт
	Возврат События;
КонецФункции

#КонецОбласти

&Прозвище("ОписанияСобытий")
&Порядок(100)
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ИздательСобытий") _Издатель) Экспорт

	События = Новый ОбъявленияСобытий();

	События.ОбъявитьВнутреннее(_Издатель.ТипНастройкаИзменена(), "Настройка изменена",
		"Прикладная настройка хаба изменена или сброшена через кабинет.",
		"Административное событие хаба: нагрузка собрана под журнал аудита"
		+ " (Кто/Действие/Объект/ДеталиJSON) и не несёт скоупа пула или пакета —"
		+ " доставить его подписке объекта некуда.");

КонецПроцедуры
