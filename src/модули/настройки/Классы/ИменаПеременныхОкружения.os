// Имя переменной окружения для ключа настройки: конвенция configor и закрытый список
// псевдонимов — имён для ключей, которых из POSIX-оболочки не набрать.

Перем СписокПсевдонимов;   // Массив из Структура — см. Псевдонимы()

#Область ПубличныйИнтерфейс

// Имя переменной, которой оператор задаёт ключ. У ключа с псевдонимом это имя
// псевдонима: родное имя из оболочки не набирается.
//
// Параметры:
//  Ключ - Строка - ключ настройки ("oshub.storage.root", "winow.Порт").
//
// Возвращаемое значение:
//  Строка - имя переменной ("OSHUB_STORAGE_ROOT", "OSHUB_PORT").
//
Функция Переменная(Знач Ключ) Экспорт

	Псевдоним = ПсевдонимЦели(Ключ);
	Возврат ?(Псевдоним = Неопределено, ПоКонвенции(Ключ), Псевдоним.Переменная);

КонецФункции

// Имя по конвенции configor: подчёркивание внутри сегмента удваивается, точка становится
// подчёркиванием, регистр — верхний. Обратное превращение делает провайдер окружения
// configor: "OSHUB_ADMIN_PASSWORD__FILE" читается им как "OSHUB.ADMIN.PASSWORD_FILE".
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - имя переменной.
//
Функция ПоКонвенции(Знач Ключ) Экспорт
	Возврат ВРег(РодноеИмя(Ключ));
КонецФункции

// Родное имя ключа: конвенция configor с регистром самого ключа. Так задают лист узла,
// который потребитель читает с учётом регистра: "data.ИсточникиДанных.СтрокаСоединения" →
// "data_ИсточникиДанных_СтрокаСоединения".
//
// Параметры:
//  Ключ - Строка - ключ настройки либо ключ провайдера окружения configor.
//
// Возвращаемое значение:
//  Строка - имя переменной.
//
Функция РодноеИмя(Знач Ключ) Экспорт

	Экранированное = СтрЗаменить(Строка(Ключ), "_", "__");
	Возврат СтрЗаменить(Экранированное, ".", "_");

КонецФункции

// Закрытый список псевдонимов. Псевдоним — обычный ключ configor, который набирается
// в оболочке, и загрузка настроек переносит его значение на ключ-цель.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Ключ - Строка - ключ-псевдоним, под которым configor видит переменную.
//   * Переменная - Строка - имя переменной окружения.
//   * Цель - Строка - ключ, на который ложится значение; «<кэш>» в нём — каждый кэш
//            чтений из базы.
//   * ЦельУзел - Булево - цель читается узлом целиком: одной переменной её не задать.
//   * Число - Булево - потребитель цели принимает только число.
//   * Флаг - Булево - потребитель цели принимает только булево.
//   * Пара - Булево - цель — лист пары «коннектор, строка соединения»: псевдонимы пары
//            из окружения не действуют, если окружение назвало родным именем хоть один
//            лист пары.
//
Функция Псевдонимы() Экспорт

	Результат = Новый Массив();
	Для Каждого Псевдоним Из СписокПсевдонимов Цикл
		Результат.Добавить(Псевдоним);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Описание псевдонима по его цели.
//
// Параметры:
//  Цель - Строка - ключ-цель ("winow.Порт", "logos.logger").
//
// Возвращаемое значение:
//  Структура, Неопределено - описание (см. Псевдонимы()) либо Неопределено, если у цели
//                            псевдонима нет.
//
Функция ПсевдонимЦели(Знач Цель) Экспорт

	Для Каждого Псевдоним Из СписокПсевдонимов Цикл
		Если НРег(Псевдоним.Цель) = НРег(Цель) Тогда
			Возврат Псевдоним;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Добавить(Знач Ключ, Знач Цель, Знач Признаки = "")

	Отмеченные = СтрРазделить(Признаки, ",", Ложь);
	СписокПсевдонимов.Добавить(Новый Структура(
		"Ключ, Переменная, Цель, ЦельУзел, Число, Флаг, Пара",
		Ключ, ПоКонвенции(Ключ), Цель,
		Отмеченные.Найти("узел") <> Неопределено,
		Отмеченные.Найти("число") <> Неопределено,
		Отмеченные.Найти("флаг") <> Неопределено,
		Отмеченные.Найти("пара") <> Неопределено));

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт

	СписокПсевдонимов = Новый Массив();

	// кириллица в ключе winow
	Добавить("oshub.port",                        "winow.Порт", "число");
	// кириллица в узле autumn-data, который читается целиком
	Добавить("oshub.db.connector",                "data.ИсточникиДанных.ТипКоннектора", "пара");
	Добавить("oshub.db.connection",               "data.ИсточникиДанных.СтрокаСоединения", "пара");
	Добавить("oshub.db.pool.size",                "data.ИсточникиДанных.РазмерПула", "число");
	// узел logos: уровень корневого журнала и уровни отдельных журналов «Имя=Уровень»
	Добавить("oshub.log.level",                   "logos.logger", "узел");
	Добавить("oshub.log.levels",                  "logos.logger.<журнал>", "узел");
	// дефис в ключе autumn-opentelemetry
	Добавить("otel.entity.query.text",            "otel.entity.query-text");
	// кириллица в ключах autumn-cache; срок жизни — одно значение на все кэши чтений из базы
	Добавить("oshub.cache.artifacts.dir",         "cache.артефакты.Каталог");
	Добавить("oshub.cache.artifacts.limit_bytes", "cache.артефакты.Предел");
	Добавить("oshub.cache.memory.limit_bytes",    "cache.ПределПамяти");
	Добавить("oshub.cache.memory.ttl_sec",        "cache.<кэш>.СрокЖизни");
	// кириллица в ключе winow: описание API включается оператором, в поставке оно выключено
	Добавить("oshub.openapi.enabled",             "winow.openapi.Включено", "флаг");

КонецПроцедуры
