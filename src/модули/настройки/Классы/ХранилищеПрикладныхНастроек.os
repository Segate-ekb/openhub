// Хранилище прикладных настроек — репозиторий сущности «ПрикладнаяНастройка», таблицы
// настроек по ключу. Хранит только введённое руками; конфиг сюда не копируется никогда.

// BSLLS:UnusedParameters-off

Перем Сам;   // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё

// Строки с заданным ключом; ключ нормализует вызывающий.
//
// Параметры:
//  Ключ - Строка - каноничная форма (НРег без окружающих пробелов).
//  Лимит - Число - максимум строк.
//
// Возвращаемое значение:
//  Массив из ПрикладнаяНастройка.
//
&МетодЗапроса
Функция ПолучитьПоКлючРавноПервые(Ключ, Лимит) Экспорт
	Возврат Неопределено;
КонецФункции

// Вся таблица настроек в порядке ключа.
//
// Возвращаемое значение:
//  Массив из ПрикладнаяНастройка.
//
&МетодЗапроса
Функция ПолучитьУпорядочитьПоКлючВозр() Экспорт
	Возврат Неопределено;
КонецФункции

// Первые строки таблицы без отбора и порядка — дешёвое чтение, которым проба базы
// проверяет, что база отвечает.
//
// Параметры:
//  Количество - Число - максимум строк.
//
// Возвращаемое значение:
//  Массив из ПрикладнаяНастройка.
//
&МетодЗапроса
Функция ПолучитьПервые(Количество) Экспорт
	Возврат Неопределено;
КонецФункции

// Значение ключа либо Неопределено, если руками ничего не вводилось.
//
// Параметры:
//  Ключ - Строка - ключ настройки; регистр и окружающие пробелы не значимы.
//
// Возвращаемое значение:
//  Строка, Неопределено.
//
Функция Значение(Знач Ключ) Экспорт

	Запись = Таблица().НайтиЗапись(Ключ);

	Возврат ?(Запись = Неопределено, Неопределено, Запись.Значение);

КонецФункции

// Записывает значение ключа: вставка либо перезапись той же строки.
//
// Параметры:
//  Ключ - Строка - ключ настройки; регистр и окружающие пробелы не значимы.
//  Значение - Строка - каноничная строковая форма значения.
//  Кто - Строка - логин автора изменения.
//  Когда - Дата - момент (UTC).
//
&Наблюдаемый
Процедура Установить(Знач Ключ, Знач Значение, Знач Кто, Знач Когда) Экспорт

	Запись = Таблица().НайтиИлиЗавести(Ключ);

	Запись.Значение = Значение;
	Запись.Обновлена = Когда;
	Запись.КемОбновлена = Кто;
	Запись.Сохранить();

КонецПроцедуры

// Удаляет значение ключа; отсутствие записи — не ошибка, сброс идемпотентен.
//
// Параметры:
//  Ключ - Строка - ключ настройки из реестра; регистр и окружающие пробелы не значимы.
//
&Наблюдаемый
Процедура Удалить(Знач Ключ) Экспорт
	Таблица().Удалить(Ключ);
КонецПроцедуры

// Все введённые руками значения.
//
// Возвращаемое значение:
//  Массив из ПрикладнаяНастройка.
//
Функция Все() Экспорт
	Возврат Таблица().Все();
КонецФункции

// Таблица «ключ → строка» над этим же хранилищем.
Функция Таблица()
	Возврат Новый ТаблицаПоКлючу(Сам.Достать());
КонецФункции

&ХранилищеСущностей("ПрикладнаяНастройка")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеПрикладныхНастроек") _Сам)

	Сам = _Сам;

КонецПроцедуры
