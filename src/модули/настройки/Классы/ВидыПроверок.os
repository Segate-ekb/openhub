// Конструкторы декларативных проверок значений настроек — желудь модуля настройки.
// Структуру вида читает ВалидаторНастроек, объявляют её таблицы ключей реестра.

#Область ПубличныйИнтерфейс

// Проверка «значение входит в перечень».
//
// Параметры:
//  ЗначенияЧерезЗапятую - Строка - допустимые значения ("file,s3").
//
// Возвращаемое значение:
//  Структура - описание проверки.
//
Функция Перечисление(Знач ЗначенияЧерезЗапятую) Экспорт
	Возврат Новый Структура("Вид, Значения", "перечисление",
		СтрРазделить(ЗначенияЧерезЗапятую, ","));
КонецФункции

// Проверка «значение не меньше границы».
//
// Параметры:
//  Мин - Число - нижняя граница включительно.
//
// Возвращаемое значение:
//  Структура - описание проверки.
//
Функция Минимум(Знач Мин) Экспорт
	Возврат Новый Структура("Вид, Мин", "минимум", Мин);
КонецФункции

// Проверка «значение лежит в границах включительно».
//
// Параметры:
//  Мин - Число - нижняя граница.
//  Макс - Число - верхняя граница.
//
// Возвращаемое значение:
//  Структура - описание проверки.
//
Функция Диапазон(Знач Мин, Знач Макс) Экспорт
	Возврат Новый Структура("Вид, Мин, Макс", "диапазон", Мин, Макс);
КонецФункции

// Проверка «значение — внешний адрес вида схема://хост[:порт]».
//
// Возвращаемое значение:
//  Структура - описание проверки.
//
Функция Адрес() Экспорт
	Возврат Новый Структура("Вид", "адрес");
КонецФункции

// Проверка «значение — цвет записи #rgb либо #rrggbb».
//
// Возвращаемое значение:
//  Структура - описание проверки.
//
Функция Цвет() Экспорт
	Возврат Новый Структура("Вид", "цвет");
КонецФункции

// Проверка «не больше действующего значения соседнего ключа» плюс своя нижняя граница.
//
// Параметры:
//  Ключ - Строка - ключ соседа, с которым сверяется значение.
//  Мин - Число - собственная нижняя граница включительно.
//
// Возвращаемое значение:
//  Структура - описание проверки.
//
Функция НеБольшеЧем(Знач Ключ, Знач Мин) Экспорт
	Возврат Новый Структура("Вид, Ключ, Мин", "неБольшеКлюча", Ключ, Мин);
КонецФункции

// Проверка «не меньше действующего значения соседнего ключа» плюс своя нижняя граница.
//
// Параметры:
//  Ключ - Строка - ключ соседа, с которым сверяется значение.
//  Мин - Число - собственная нижняя граница включительно.
//
// Возвращаемое значение:
//  Структура - описание проверки.
//
Функция НеМеньшеЧем(Знач Ключ, Знач Мин) Экспорт
	Возврат Новый Структура("Вид, Ключ, Мин", "неМеньшеКлюча", Ключ, Мин);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
