// Таблица ключей подсистем хаба: политика пароля, подписки, прокси апстрима, счётчики,
// телеметрия, хранилище S3 и расписание фоновых задач. Второго списка ключей нет.

Перем Правила;  // ВидыПроверок (настройки)
Перем Список;   // Массив описаний для РеестрНастроек

#Область ПубличныйИнтерфейс

// Объявления ключей подсистем в порядке показа на экране.
//
// Возвращаемое значение:
//  Массив из Структура - Ключ, Тип, Дефолт, Валидатор, Класс, Секрет, Сырое.
//
Функция Объявления() Экспорт
	Возврат Список;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Объявить(Знач Ключ, Знач Тип, Знач Дефолт, Знач Валидатор, Знач Класс, Знач Сырое)

	Список.Добавить(Новый Структура("Ключ, Тип, Дефолт, Валидатор, Класс, Секрет, Сырое",
		Ключ, Тип, Дефолт, Валидатор, Класс, Ложь, Сырое));

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "oshub.auth.password.min_length", ЗначениеПоУмолчанию = "") _МинДлина = "",
	&Деталька(Значение = "oshub.auth.password.max_length", ЗначениеПоУмолчанию = "") _МаксДлина = "",
	&Деталька(Значение = "oshub.auth.password.require_lowercase", ЗначениеПоУмолчанию = "") _Строчная = "",
	&Деталька(Значение = "oshub.auth.password.require_uppercase", ЗначениеПоУмолчанию = "") _Прописная = "",
	&Деталька(Значение = "oshub.auth.password.require_digit", ЗначениеПоУмолчанию = "") _Цифра = "",
	&Деталька(Значение = "oshub.auth.password.require_special", ЗначениеПоУмолчанию = "") _Спец = "",
	&Деталька(Значение = "oshub.webhooks.delivery_enabled", ЗначениеПоУмолчанию = "") _ДоставкаВключена = "",
	&Деталька(Значение = "oshub.webhooks.allow_insecure", ЗначениеПоУмолчанию = "") _РазрешитьHTTP = "",
	&Деталька(Значение = "oshub.webhooks.max_queue", ЗначениеПоУмолчанию = "") _ОчередьДоставки = "",
	&Деталька(Значение = "oshub.webhooks.max_attempts", ЗначениеПоУмолчанию = "") _МаксПопыток = "",
	&Деталька(Значение = "oshub.webhooks.backoff_base_sec", ЗначениеПоУмолчанию = "") _БэкоффБаза = "",
	&Деталька(Значение = "oshub.webhooks.delivery_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалДоставки = "",
	&Деталька(Значение = "oshub.webhooks.delivery_timeout_sec", ЗначениеПоУмолчанию = "") _ТаймаутДоставки = "",
	&Деталька(Значение = "oshub.webhooks.test_max_per_hour", ЗначениеПоУмолчанию = "") _ПотолокПроб = "",
	&Деталька(Значение = "oshub.proxy.offline", ЗначениеПоУмолчанию = "") _Офлайн = "",
	&Деталька(Значение = "oshub.proxy.timeout.sec", ЗначениеПоУмолчанию = "") _ТаймаутАпстрима = "",
	&Деталька(Значение = "oshub.proxy.negative.ttl.sec", ЗначениеПоУмолчанию = "") _НегативныйTTL = "",
	&Деталька(Значение = "oshub.proxy.max_redirects", ЗначениеПоУмолчанию = "") _ПотолокРедиректов = "",
	&Деталька(Значение = "oshub.upstream.probe.enabled", ЗначениеПоУмолчанию = "") _ПробаИсточника = "",
	&Деталька(Значение = "oshub.proxy.upstream.recheck.ttl.sec", ЗначениеПоУмолчанию = "") _TTLПерепроверки = "",
	&Деталька(Значение = "oshub.publish.github.org", ЗначениеПоУмолчанию = "") _ОрганизацияGitHub = "",
	&Деталька(Значение = "oshub.ui.audit_page_size", ЗначениеПоУмолчанию = "") _СтраницаАудита = "",
	&Деталька(Значение = "oshub.stats.flush_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалСчётчиков = "",
	&Деталька(Значение = "oshub.stats.flush_threshold", ЗначениеПоУмолчанию = "") _ПорогСчётчиков = "",
	&Деталька(Значение = "oshub.jobs.tick_interval_ms", ЗначениеПоУмолчанию = "") _ИнтервалТика = "",
	&Деталька(Значение = "oshub.jobs.readme_reindex_hour", ЗначениеПоУмолчанию = "") _ЧасREADME = "",
	&Деталька(Значение = "oshub.jobs.mirror_sync_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалЗеркал = "",
	&Деталька(Значение = "oshub.jobs.proxy_gc_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалGCПрокси = "",
	&Деталька(Значение = "oshub.jobs.cli_device_gc_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалЗаявокCLI = "",
	&Деталька(Значение = "oshub.jobs.invite_gc_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалПриглашений = "",
	&Деталька(Значение = "oshub.jobs.pool_volume_audit_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалОбъёмов = "",
	&Деталька(Значение = "oshub.jobs.upstream_health_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалЗдоровья = "",
	&Деталька(Значение = "otel.exporter.otlp.protocol", ЗначениеПоУмолчанию = "") _ПротоколOTel = "",
	&Деталька(Значение = "otel.service.name", ЗначениеПоУмолчанию = "") _ИмяСлужбыOTel = "",
	&Деталька(Значение = "otel.traces.sampler", ЗначениеПоУмолчанию = "") _Сэмплер = "",
	&Деталька(Значение = "otel.traces.sampler.arg", ЗначениеПоУмолчанию = "") _ДоляТрасс = "",
	&Деталька(Значение = "otel.bsp.schedule.delay", ЗначениеПоУмолчанию = "") _ИнтервалВыгрузки = "",
	&Деталька(Значение = "otel.bsp.max.queue.size", ЗначениеПоУмолчанию = "") _БуферСпанов = "",
	&Деталька(Значение = "otel.exporter.otlp.timeout", ЗначениеПоУмолчанию = "") _ТаймаутВыгрузки = "",
	&Деталька(Значение = "otel.exporter.otlp.insecure", ЗначениеПоУмолчанию = "") _БезПроверкиСертификата = "",
	&Деталька(Значение = "oshub.storage.s3.endpoint", ЗначениеПоУмолчанию = "") _ЭндпоинтS3 = "",
	&Деталька(Значение = "oshub.storage.s3.bucket", ЗначениеПоУмолчанию = "") _БакетS3 = "",
	&Деталька(Значение = "oshub.storage.s3.region", ЗначениеПоУмолчанию = "") _РегионS3 = "",
	&Деталька(Значение = "oshub.storage.s3.prefix", ЗначениеПоУмолчанию = "") _ПрефиксS3 = "",
	&Деталька(Значение = "oshub.storage.s3.force_path_style", ЗначениеПоУмолчанию = "") _ПутьСтильS3 = "") Экспорт

	Правила = _Правила;
	Список = Новый Массив();

	// Политика пароля: шесть значений одним блоком — раздел «Политика пароля» дома «Хаб».
	// Границы длины сверяются друг с другом, иначе пара запирает вход, а не сужает его.
	Объявить("oshub.auth.password.min_length", "целое", 8,
		Правила.НеБольшеЧем("oshub.auth.password.max_length", 1), "прикладная", _МинДлина);
	Объявить("oshub.auth.password.max_length", "целое", 256,
		Правила.НеМеньшеЧем("oshub.auth.password.min_length", 1), "прикладная", _МаксДлина);
	Объявить("oshub.auth.password.require_lowercase", "булево", Ложь, Неопределено, "прикладная", _Строчная);
	Объявить("oshub.auth.password.require_uppercase", "булево", Ложь, Неопределено, "прикладная", _Прописная);
	Объявить("oshub.auth.password.require_digit", "булево", Ложь, Неопределено, "прикладная", _Цифра);
	Объявить("oshub.auth.password.require_special", "булево", Ложь, Неопределено, "прикладная", _Спец);

	// Подписки: из интерфейса правятся рубильник доставки и разрешение http — решения
	// администратора; пороги доставки и потолок проб — числа машины, они за конфигурацией.
	Объявить("oshub.webhooks.delivery_enabled", "булево", Истина, Неопределено, "прикладная", _ДоставкаВключена);
	Объявить("oshub.webhooks.allow_insecure", "булево", Ложь, Неопределено, "прикладная", _РазрешитьHTTP);
	Объявить("oshub.webhooks.max_queue", "целое", 10000, Правила.Минимум(1), "bootstrap", _ОчередьДоставки);
	Объявить("oshub.webhooks.max_attempts", "целое", 5, Правила.Минимум(1), "bootstrap", _МаксПопыток);
	Объявить("oshub.webhooks.backoff_base_sec", "целое", 10, Правила.Минимум(1), "bootstrap", _БэкоффБаза);
	Объявить("oshub.webhooks.delivery_interval_sec", "целое", 5, Правила.Минимум(1), "bootstrap", _ИнтервалДоставки);
	Объявить("oshub.webhooks.delivery_timeout_sec", "целое", 10, Правила.Минимум(1), "bootstrap", _ТаймаутДоставки);
	Объявить("oshub.webhooks.test_max_per_hour", "целое", 100, Правила.Минимум(1), "bootstrap", _ПотолокПроб);

	// Прокси апстрима: офлайн — переключатель с последствиями, остальное — пороги похода наружу.
	Объявить("oshub.proxy.offline", "булево", Ложь, Неопределено, "прикладная", _Офлайн);
	Объявить("oshub.proxy.timeout.sec", "целое", 20, Правила.Минимум(1), "прикладная", _ТаймаутАпстрима);
	Объявить("oshub.proxy.negative.ttl.sec", "целое", 60, Правила.Минимум(0), "прикладная", _НегативныйTTL);
	Объявить("oshub.proxy.upstream.recheck.ttl.sec", "целое", 300, Правила.Минимум(0), "прикладная", _TTLПерепроверки);
	Объявить("oshub.proxy.max_redirects", "целое", 5, Правила.Минимум(0), "прикладная", _ПотолокРедиректов);

	// Источник заводится пробным подключением; выключатель нужен инсталляции без выхода наружу.
	Объявить("oshub.upstream.probe.enabled", "булево", Истина, Неопределено, "прикладная", _ПробаИсточника);

	// Легаси-путь GitHub: организация обязана стоять рядом со своим выключателем.
	Объявить("oshub.publish.github.org", "строка", "oscript-library", Неопределено, "прикладная", _ОрганизацияGitHub);

	Объявить("oshub.ui.audit_page_size", "целое", 20, Правила.Минимум(1), "прикладная", _СтраницаАудита);

	Объявить("oshub.stats.flush_interval_sec", "целое", 60, Правила.Минимум(1), "прикладная", _ИнтервалСчётчиков);
	Объявить("oshub.stats.flush_threshold", "целое", 50, Правила.Минимум(1), "прикладная", _ПорогСчётчиков);

	// Расписание фоновых задач вшивается в планировщик при сборке и на ходу не перечитывается:
	// правка из формы обещала бы «сохранилось, но заработает потом» — значения показываются
	// карточкой «управляется конфигурацией».
	Объявить("oshub.jobs.tick_interval_ms", "целое", 1000, Правила.Минимум(1), "bootstrap", _ИнтервалТика);
	Объявить("oshub.jobs.readme_reindex_hour", "целое", 3, Правила.Диапазон(0, 23), "bootstrap", _ЧасREADME);
	Объявить("oshub.jobs.mirror_sync_interval_sec", "целое", 3600, Правила.Минимум(1), "bootstrap", _ИнтервалЗеркал);
	Объявить("oshub.jobs.proxy_gc_interval_sec", "целое", 3600, Правила.Минимум(1), "bootstrap", _ИнтервалGCПрокси);
	Объявить("oshub.jobs.cli_device_gc_interval_sec", "целое", 300, Правила.Минимум(1), "bootstrap", _ИнтервалЗаявокCLI);
	Объявить("oshub.jobs.invite_gc_interval_sec", "целое", 3600, Правила.Минимум(1), "bootstrap", _ИнтервалПриглашений);
	Объявить("oshub.jobs.pool_volume_audit_interval_sec", "целое", 3600, Правила.Минимум(1), "bootstrap", _ИнтервалОбъёмов);
	Объявить("oshub.jobs.upstream_health_interval_sec", "целое", 60, Правила.Минимум(1), "bootstrap", _ИнтервалЗдоровья);

	// Телеметрия: SDK собирается при старте процесса, поэтому все ключи — карточки.
	// Имена и умолчания — стандартные OpenTelemetry, их читает SDK, а не хаб.
	Объявить("otel.exporter.otlp.protocol", "строка", "http/protobuf", Неопределено, "bootstrap", _ПротоколOTel);
	Объявить("otel.service.name", "строка", "openhub", Неопределено, "bootstrap", _ИмяСлужбыOTel);
	// Сэмплер обязан стоять рядом с долей: при пустом имени SDK ставит ParentBased(AlwaysOn)
	// и долю ИГНОРИРУЕТ — карточка «доля отбираемых трасс» врала бы оператору.
	Объявить("otel.traces.sampler", "строка", "parentbased_traceidratio",
		Правила.Перечисление("always_on,always_off,traceidratio,"
			+ "parentbased_always_on,parentbased_always_off,parentbased_traceidratio"),
		"bootstrap", _Сэмплер);
	// доля трасс дробная, и таких типов у реестра нет: карточка читается, а не правится
	Объявить("otel.traces.sampler.arg", "строка", "1.0", Неопределено, "bootstrap", _ДоляТрасс);
	Объявить("otel.bsp.schedule.delay", "целое", 5000, Правила.Минимум(1), "bootstrap", _ИнтервалВыгрузки);
	Объявить("otel.bsp.max.queue.size", "целое", 2048, Правила.Минимум(1), "bootstrap", _БуферСпанов);
	Объявить("otel.exporter.otlp.timeout", "целое", 10000, Правила.Минимум(1), "bootstrap", _ТаймаутВыгрузки);
	Объявить("otel.exporter.otlp.insecure", "булево", Ложь, Неопределено, "bootstrap", _БезПроверкиСертификата);

	// Хранилище S3 собирается один раз при старте — как и вид хранилища.
	Объявить("oshub.storage.s3.endpoint", "строка", "", Неопределено, "bootstrap", _ЭндпоинтS3);
	Объявить("oshub.storage.s3.bucket", "строка", "", Неопределено, "bootstrap", _БакетS3);
	Объявить("oshub.storage.s3.region", "строка", "", Неопределено, "bootstrap", _РегионS3);
	Объявить("oshub.storage.s3.prefix", "строка", "", Неопределено, "bootstrap", _ПрефиксS3);
	Объявить("oshub.storage.s3.force_path_style", "булево", Ложь, Неопределено, "bootstrap", _ПутьСтильS3);

КонецПроцедуры
