// Сервис настроек — резолвер значений по реестру.

Перем Реестр;      // РеестрНастроек (настройки)
Перем Валидаторы;  // ВалидаторНастроек (настройки) — декларативные проверки значений
Перем Хранилище;   // ХранилищеПрикладныхНастроек (данные)
Перем Издатель;    // ИздательСобытий (события)
Перем ИменаЖурнала; // ИмяОбъектаАудита (аудит) — вид объекта в журнале
Перем Кэш;         // Соответствие: ключ -> Структура(ЕстьВБазе, Значение, Момент)
Перем КэшСекунд;   // Число - TTL кэша значений базы
Перем Разрешаемые; // Соответствие: ключ -> Истина, пока он разрешается (парные валидаторы)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Действующее типизированное значение настройки: конфиг → база → дефолт.
//
// Параметры:
//  Ключ - Строка - ключ из реестра.
//
// Возвращаемое значение:
//  Произвольный - значение типа настройки (Строка/Число/Булево).
//
Функция Значение(Знач Ключ) Экспорт
	Возврат Разрешить(Ключ).Значение;
КонецФункции

// Источник действующего значения: "конфиг" | "база" | "дефолт".
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - «конфиг», «база» либо «дефолт».
//
Функция Источник(Знач Ключ) Экспорт
	Возврат Разрешить(Ключ).Источник;
КонецФункции

// Форсирована ли настройка конфигом: резолвер отдаёт конфиг, поле в UI блокируется.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Булево - форсирована ли настройка конфигом.
//
Функция ФорсированаКонфигом(Знач Ключ) Экспорт
	Возврат Реестр.ЭтоПрикладная(Ключ) И Реестр.КонфигЗадан(Ключ);
КонецФункции

// Значение прикладной настройки — доменный API «правится из UI».
//
// Параметры:
//  Ключ - Строка - ключ прикладной настройки.
//  Значение - Произвольный - новое значение (типизированное либо строкой).
//  Кто - Строка - принципал для аудита (логин администратора) — ОБЯЗАТЕЛЕН: мутация без автора обесценивает журнал (ревью 7.E М-е).
//  АдресIP - Строка - IP источника (может быть пустым) (необязательный, по умолчанию "").
//
Процедура Установить(Знач Ключ, Знач Значение, Знач Кто, Знач АдресIP = "") Экспорт

	Описание = ОписаниеПрикладной(Ключ, "установить");

	Механизм = Реестр.МеханизмПравки(Описание.Ключ);
	Если ЗначениеЗаполнено(Механизм) Тогда
		ВызватьИсключение СтрШаблон(
			"Настройка ""%1"" правится только своим механизмом (%2): её правка — переход,"
				+ " а не запись значения, и в обход него инсталляция остаётся в состоянии,"
				+ " из которого нет выхода",
			Описание.Ключ, Механизм);
	КонецЕсли;

	Записать(Описание, Значение, Кто, АдресIP);

КонецПроцедуры

// Значение настройки, правку которой ведёт свой механизм: он называет себя, и чужое имя
// записи не даёт. Уборка введённого механизму не принадлежит (Сбросить): она возвращает
// ключ к конфигурации либо умолчанию, то есть к тому, что действовало бы и без базы.
//
// Параметры:
//  Ключ - Строка - ключ прикладной настройки.
//  Значение - Произвольный - новое значение (типизированное либо строкой).
//  Кто - Строка - принципал для аудита.
//  Механизм - Строка - имя класса-владельца правки (ТипЗнч вызывающего).
//  АдресIP - Строка - IP источника (может быть пустым) (необязательный, по умолчанию "").
//
Процедура УстановитьМеханизмом(Знач Ключ, Знач Значение, Знач Кто, Знач Механизм,
	Знач АдресIP = "") Экспорт

	Описание = ОписаниеПрикладной(Ключ, "установить");

	Владелец = Реестр.МеханизмПравки(Описание.Ключ);
	Если Владелец <> Механизм Тогда
		ВызватьИсключение СтрШаблон(
			"Настройка ""%1"" механизму %2 не принадлежит: её правку ведёт %3",
			Описание.Ключ, Механизм, ?(ЗначениеЗаполнено(Владелец), Владелец, "обычная запись"));
	КонецЕсли;

	Записать(Описание, Значение, Кто, АдресIP);

КонецПроцедуры

// Сброс прикладной настройки: идемпотентен, пишется в аудит, разрешён и под конфигом.
//
// Параметры:
//  Ключ - Строка - ключ.
//  Кто - Строка - автор изменения для аудита.
//  АдресIP - Строка - адрес клиента для аудита (необязательный, по умолчанию "").
//
Процедура Сбросить(Знач Ключ, Знач Кто, Знач АдресIP = "") Экспорт

	Описание = ОписаниеПрикладной(Ключ, "сбросить");

	Было = ОткрытоеЗначение(Описание.Ключ);

	Хранилище.Удалить(Описание.Ключ);
	Кэш.Удалить(Описание.Ключ);

	ОпубликоватьИзменение(Описание, "настройка.сброшена", Было, Кто, АдресIP);

КонецПроцедуры

// Знает ли реестр такой ключ. Спрашивают перед Карточкой: у незнакомого ключа
// её нет, и разбирать причину по тексту исключения вызывающему не приходится.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Булево - знает ли реестр такой ключ.
//
Функция Известна(Знач Ключ) Экспорт
	Возврат Реестр.Есть(Ключ);
КонецФункции

// Открытое представление настройки — модель для карточек и форм.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Структура - Ключ, Класс, Тип, Секрет, Значение (маска для секрета), Источник, Форсирована (Булево), Переменная (env-имя), Редактируемая (Булево), Механизм (имя владельца правки либо "").
//
Функция Карточка(Знач Ключ) Экспорт

	Описание = Реестр.Описание(Ключ);
	Итог = Разрешить(Ключ);

	Возврат Новый Структура(
		"Ключ, Класс, Тип, Секрет, Значение, Источник, Форсирована, Переменная, Редактируемая, Механизм",
		Описание.Ключ,
		Описание.Класс,
		Описание.Тип,
		Описание.Секрет,
		?(Описание.Секрет, МаскаСекрета(Итог.Значение), Итог.Значение),
		Итог.Источник,
		ФорсированаКонфигом(Ключ),
		Реестр.ПеременнаяОкружения(Ключ),
		Описание.Класс = "прикладная" И НЕ ФорсированаКонфигом(Ключ),
		Реестр.МеханизмПравки(Ключ));

КонецФункции

// Открытые представления всех настроек реестра (порядок объявления реестра).
//
// Возвращаемое значение:
//  Массив - открытые представления всех настроек реестра (порядок объявления реестра).
//
Функция Карточки() Экспорт

	Результат = Новый Массив();
	Для Каждого Ключ Из Реестр.Ключи() Цикл
		Результат.Добавить(Карточка(Ключ));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Общая запись обеих дорог: конфигурация старше любой из них, поэтому проверяется здесь.
Процедура Записать(Знач Описание, Знач Значение, Знач Кто, Знач АдресIP)

	Если Описание.КонфигЗадан Тогда
		ВызватьИсключение СтрШаблон(
			"Настройка ""%1"" форсирована конфигурацией (файл/env): правка через доменный API"
				+ " запрещена — уберите ключ из конфигурации либо меняйте её значением",
			Описание.Ключ);
	КонецЕсли;
	Новое = ТипизированноеПроверенное(Значение, Описание);

	Было = ОткрытоеЗначение(Описание.Ключ);

	Хранилище.Установить(Описание.Ключ, ВСтроку(Новое), Кто, ТекущаяУниверсальнаяДата());
	Кэш.Удалить(Описание.Ключ);

	ОпубликоватьИзменение(Описание, "настройка.изменена", Было, Кто, АдресIP);

КонецПроцедуры

// Разрешение значения по приоритету. Парный валидатор спрашивает соседний ключ, а тот —
// этот же: ключ, который уже разрешается, отдаёт умолчание вместо второго круга.
Функция Разрешить(Знач Ключ)

	Описание = Реестр.Описание(Ключ);

	Если Разрешаемые.Получить(Описание.Ключ) <> Неопределено Тогда
		Возврат Итог(Описание.Дефолт, "дефолт");
	КонецЕсли;

	Разрешаемые.Вставить(Описание.Ключ, Истина);
	Попытка
		Результат = ПоИсточникам(Описание);
	Исключение
		Разрешаемые.Удалить(Описание.Ключ);
		ВызватьИсключение;
	КонецПопытки;
	Разрешаемые.Удалить(Описание.Ключ);

	Возврат Результат;

КонецФункции

Функция ПоИсточникам(Знач Описание)

	Если Описание.КонфигЗадан Тогда
		Попытка
			Возврат Разрешённое(Описание, ТипизированноеПроверенное(Описание.ЗначениеКонфига, Описание), "конфиг");
		Исключение
			Предупредить(Описание, "config", ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Если Описание.Класс = "прикладная" Тогда
		ИзБазы = ЗначениеБазы(Описание.Ключ);
		Если ИзБазы.ЕстьВБазе Тогда
			Попытка
				Возврат Разрешённое(Описание, ТипизированноеПроверенное(ИзБазы.Значение, Описание), "база");
			Исключение
				Предупредить(Описание, "database", ИнформацияОбОшибке());
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

	Возврат Разрешённое(Описание, Описание.Дефолт, "дефолт");

КонецФункции

// Действующее значение и его источник — то, ради чего отладку настроек и включают:
// иначе «сколько сейчас на самом деле» добывается чтением файла конфигурации и базы.
// Секретная настройка называет себя маской: в журнал она не попадает ни одним источником.
Функция Разрешённое(Знач Описание, Знач Значение, Знач Источник)

	Если Лог <> Неопределено Тогда
		Лог.Отладка("Настройка ""%1"" = %2, источник: %3",
			Описание.Ключ, ?(Описание.Секрет, МаскаСекрета(Значение), Значение), Источник);
	КонецЕсли;

	Возврат Итог(Значение, Источник);

КонецФункции

Функция Итог(Знач Значение, Знач Источник)
	Возврат Новый Структура("Значение, Источник", Значение, Источник);
КонецФункции

// Приведение к типу и валидатор; значение перечисления — к каноничной форме из реестра.
Функция ТипизированноеПроверенное(Знач Значение, Знач Описание)

	Типизированное = ПривестиКТипу(Значение, Описание);
	Валидаторы.Проверить(Типизированное, Описание, ЭтотОбъект);
	Возврат Валидаторы.Каноничное(Типизированное, Описание);

КонецФункции

// Текст лога — диагностика оператору, без кириллицы: страж «строки живут в СловареТекстов».
Процедура Предупредить(Знач Описание, Знач Где, Знач Ошибка)
	Если Лог <> Неопределено Тогда
		Лог.Предупреждение("setting %1: value from %2 rejected by type/validator (%3), falling back",
			Описание.Ключ, Где, КраткоеПредставлениеОшибки(Ошибка));
	КонецЕсли;
КонецПроцедуры

// Значение базы через короткий кэш. Структура: ЕстьВБазе + Значение (строка).
Функция ЗначениеБазы(Знач Ключ)

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Запись = Кэш.Получить(Ключ);
	Если Запись <> Неопределено И Сейчас - Запись.Момент < КэшСекунд * 1000 Тогда
		Возврат Запись;
	КонецЕсли;

	Сырое = Хранилище.Значение(Ключ);
	Запись = Новый Структура("ЕстьВБазе, Значение, Момент",
		Сырое <> Неопределено, ?(Сырое = Неопределено, "", Строка(Сырое)), Сейчас);
	Кэш.Вставить(Ключ, Запись);
	Возврат Запись;

КонецФункции

Функция ОписаниеПрикладной(Знач Ключ, Знач Глагол)

	Описание = Реестр.Описание(Ключ);
	Если Описание.Класс <> "прикладная" Тогда
		ВызватьИсключение СтрШаблон(
			"Настройка ""%1"" класса bootstrap: %2 её можно только конфигурацией (файл/env)",
			Описание.Ключ, Глагол);
	КонецЕсли;
	Возврат Описание;

КонецФункции

// Приведение произвольного значения (конфиг/база/ввод API) к типу настройки.
Функция ПривестиКТипу(Знач Значение, Знач Описание)

	Если Описание.Тип = "целое" Тогда
		Возврат ПривестиЦелое(Значение, Описание.Ключ);
	ИначеЕсли Описание.Тип = "булево" Тогда
		Возврат ПривестиБулево(Значение, Описание.Ключ);
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция ПривестиЦелое(Знач Значение, Знач Ключ)

	Если ТипЗнч(Значение) = ТипЗнч(0) Тогда
		Число_ = Значение;
	Иначе
		Попытка
			Число_ = Число(СокрЛП(Строка(Значение)));
		Исключение
			ВызватьИсключение СтрШаблон("Настройка %1: ""%2"" не является числом", Ключ, Значение);
		КонецПопытки;
	КонецЕсли;

	Если Число_ <> Цел(Число_) Тогда
		ВызватьИсключение СтрШаблон("Настройка %1: значение должно быть целым", Ключ);
	КонецЕсли;
	Возврат Число_;

КонецФункции

Функция ПривестиБулево(Знач Значение, Знач Ключ)

	Если ТипЗнч(Значение) = ТипЗнч(Истина) Тогда
		Возврат Значение;
	КонецЕсли;

	Норм = НРег(СокрЛП(Строка(Значение)));
	Если Норм = "true" Или Норм = "1" Или Норм = "да" Или Норм = "истина" Тогда
		Возврат Истина;
	ИначеЕсли Норм = "false" Или Норм = "0" Или Норм = "нет" Или Норм = "ложь" Тогда
		Возврат Ложь;
	КонецЕсли;
	ВызватьИсключение СтрШаблон("Настройка %1: ""%2"" не является булевым", Ключ, Значение);

КонецФункции

// Каноничная строковая форма для базы: XMLСтрока — без локали и разделителей групп.
Функция ВСтроку(Знач Значение)
	Возврат XMLСтрока(Значение);
КонецФункции

// Значение для деталей аудита: у секретной настройки — маска.
Функция ОткрытоеЗначение(Знач Ключ)
	Описание = Реестр.Описание(Ключ);
	Итог = Разрешить(Ключ);
	Возврат ?(Описание.Секрет, МаскаСекрета(Итог.Значение), ВСтроку(Итог.Значение));
КонецФункции

Функция МаскаСекрета(Знач Значение)
	Возврат ?(ЗначениеЗаполнено(Значение), "•••", "");
КонецФункции

// Публикация мутации: нагрузка — готовые поля контракта СлужбыАудита.
Процедура ОпубликоватьИзменение(Знач Описание, Знач Действие, Знач Было, Знач Кто, Знач АдресIP)

	Стало = ОткрытоеЗначение(Описание.Ключ);

	Детали = Новый Структура("было, стало, источник", Было, Стало, Источник(Описание.Ключ));
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Детали);

	Данные = Новый Структура();
	Данные.Вставить("Кто", Кто);
	Данные.Вставить("Действие", Действие);
	Данные.Вставить("Объект", ИменаЖурнала.Настройка(Описание.Ключ));
	Данные.Вставить("ДеталиJSON", ЗаписьJSON.Закрыть());
	Данные.Вставить("АдресIP", АдресIP);

	Издатель.Опубликовать(Издатель.ТипНастройкаИзменена(), Данные);

КонецПроцедуры

#КонецОбласти

// Лог берётся инъекцией ОСени в поле (&Лог выше) — боевой путь.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РеестрНастроек") _Реестр,
	&Пластилин(Значение = "ХранилищеПрикладныхНастроек") _Хранилище,
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "ИмяОбъектаАудита") _ИменаЖурнала,
	&Пластилин(Значение = "ВалидаторНастроек") _Валидаторы,
	&Лог _Лог = Неопределено)

	Реестр = _Реестр;
	Валидаторы = _Валидаторы;
	Хранилище = _Хранилище;
	Издатель = _Издатель;
	ИменаЖурнала = _ИменаЖурнала;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Кэш = Новый Соответствие();
	КэшСекунд = 5;
	Разрешаемые = Новый Соответствие();

КонецПроцедуры
