// Разделы настроек хаба - желудь модуля настройки: раздел, которому принадлежит ключ.
// Спрашивают обе двери - форма дома «Хаб» и адрес настроек в API.

Перем Правила; // ФиксированныйМассив правил «образец → раздел» в порядке суда

#Область ПубличныйИнтерфейс

// Раздел дома «Хаб», в котором показывается настройка.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - ключ раздела дома («identity», «login», …).
//
Функция РазделКлюча(Знач Ключ) Экспорт

	Норм = НРег(СокрЛП(Строка(Ключ)));

	Для Каждого Правило Из Правила Цикл
		Если Подходит(Норм, Правило) Тогда
			Возврат Правило.Раздел;
		КонецЕсли;
	КонецЦикла;

	Возврат "maintenance";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Подходит(Знач Норм, Знач Правило)
	Если Правило.Точно Тогда
		Возврат Норм = Правило.Образец;
	КонецЕсли;
	Возврат Лев(Норм, СтрДлина(Правило.Образец)) = Правило.Образец;
КонецФункции

// Порядок правил значим: узкое правило судится до широкого.
Функция ПравилаРазделов()

	Результат = Новый Массив();
	ДобавитьПрефикс(Результат, "winow.", "identity");
	ДобавитьПрефикс(Результат, "oshub.instance.", "identity");
	// настройка экрана журнала - к обслуживанию, а не к оформлению
	ДобавитьКлюч(Результат, "oshub.ui.audit_page_size", "maintenance");
	// предел выдачи API - обслуживание инсталляции
	ДобавитьПрефикс(Результат, "oshub.api.", "maintenance");
	ДобавитьПрефикс(Результат, "oshub.ui.", "branding");
	ДобавитьПрефикс(Результат, "oshub.mail.", "mail");
	// подтверждение адреса письмом - часть почты хаба, а не отдельная политика входа
	ДобавитьПрефикс(Результат, "oshub.auth.email.confirm.", "mail");
	ДобавитьПрефикс(Результат, "oshub.mirror.", "mirrors");
	// легаси-флоу GitHub к доверенной публикации отношения не имеет: свой блок
	ДобавитьПрефикс(Результат, "oshub.publish.github", "legacy");
	ДобавитьПрефикс(Результат, "oshub.publish.ci.", "trusted");
	ДобавитьПрефикс(Результат, "oshub.publish.inbox.", "pools");
	ДобавитьПрефикс(Результат, "oshub.pools.", "pools");
	ДобавитьКлюч(Результат, "oshub.auth.password.enabled", "login");
	ДобавитьПрефикс(Результат, "oshub.auth.password.", "password");
	ДобавитьПрефикс(Результат, "oshub.auth.", "login");
	ДобавитьПрефикс(Результат, "oshub.admin.", "login");
	ДобавитьПрефикс(Результат, "oshub.webhooks.", "delivery");
	ДобавитьПрефикс(Результат, "oshub.proxy.", "proxy");
	ДобавитьПрефикс(Результат, "oshub.storage.", "storage");
	ДобавитьПрефикс(Результат, "oshub.publish.", "storage");
	Возврат Новый ФиксированныйМассив(Результат);

КонецФункции

Процедура ДобавитьПрефикс(Правила, Знач Префикс, Знач Раздел)
	Правила.Добавить(Новый ФиксированнаяСтруктура("Образец, Точно, Раздел", Префикс, Ложь, Раздел));
КонецПроцедуры

Процедура ДобавитьКлюч(Правила, Знач Ключ, Знач Раздел)
	Правила.Добавить(Новый ФиксированнаяСтруктура("Образец, Точно, Раздел", Ключ, Истина, Раздел));
КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
	Правила = ПравилаРазделов();
КонецПроцедуры
