// Гвард домена «Пул» — желудь модуля кабинет.

Перем ГвардКабинета;  // ГвардКабинета (кабинет)
Перем Каркас;         // КаркасСтраницы (кит) — страница отказа
Перем Кит;            // Кит (кит) — тело страницы отказа
Перем Тексты;         // ТекстыИнтерфейса (кит)
Перем СервисПрав;     // СервисПрав (auth)
Перем СервисПулов;    // СервисПулов (реестр)
Перем Заголовки;      // ЗаголовкиКэша (основа) — страница отказа не остаётся у чужой стороны

// Проверяет доступ к маршруту домена «Пул».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки (winow).
//  ИмяПула - Строка - имя пула из URL-сегмента {pool}.
//
// Возвращаемое значение:
//  Структура: Разрешено, Принципал, Пользователь, Сессия, Пул.
//
Функция Проверить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ИмяПула) Экспорт

	Вердикт = ГвардКабинета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Отказ(); // редирект уже записан базовым гвардом
	КонецЕсли;

	Пользователь = Вердикт.Пользователь;
	Пул = СервисПулов.НайтиПул(ИмяПула);

	// приватность: несуществующий ИЛИ нечитаемый приватный пул → 404 (не раскрываем)
	Если Пул = Неопределено ИЛИ НЕ СервисПрав.МожетЧитать(Пользователь, Пул) Тогда
		ОтдатьНеНайдено(Ответ, Пользователь, Тексты.Текст("settings.guard.pool.notfound"), КукиЗапроса);
		Возврат Отказ();
	КонецЕсли;

	Если НЕ СервисПрав.МожетАдминистрировать(Пользователь, Пул) Тогда
		ОтдатьЗапрещено(Ответ, Пользователь,
			Тексты.Текст("settings.guard.pool.forbidden"), КукиЗапроса);
		Возврат Отказ();
	КонецЕсли;

	Результат = Новый Структура("Разрешено, Принципал, Пользователь, Сессия, Пул",
		Истина, Вердикт.Принципал, Пользователь, Вердикт.Сессия, Пул);
	Возврат Результат;

КонецФункции

Процедура ОтдатьЗапрещено(Ответ, Знач Пользователь, Знач Сообщение, Знач КукиЗапроса)
	Заголовки.ЗакрытьСтраницу(Ответ);
	Ответ.УстановитьСостояние(403);
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Тексты.Текст("settings.reply.forbidden.title"),
		Кит.СтраницаОшибки(Новый Структура("Код, Сообщение", 403, Сообщение)),
		КонтекстОтказа(Пользователь, КукиЗапроса));
КонецПроцедуры

Процедура ОтдатьНеНайдено(Ответ, Знач Пользователь, Знач Сообщение, Знач КукиЗапроса)
	Заголовки.ЗакрытьСтраницу(Ответ);
	Ответ.УстановитьСостояниеНеНайдено();
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Тексты.Текст("settings.reply.notfound.title"),
		Кит.СтраницаОшибки(Новый Структура("Код, Сообщение", 404, Сообщение)),
		КонтекстОтказа(Пользователь, КукиЗапроса));
КонецПроцедуры

// Страница отказа принадлежит приватной части: над ней стоит навигация кабинета.
Функция КонтекстОтказа(Знач Пользователь, Знач КукиЗапроса)
	Возврат Каркас.КонтекстСтраницы(Пользователь, КукиЗапроса,
		СервисПрав.ПользовательАдмин(Пользователь), Истина);
КонецФункции

Функция Отказ()
	Возврат Новый Структура("Разрешено, Принципал, Пользователь, Сессия, Пул",
		Ложь, Неопределено, Неопределено, Неопределено, Неопределено);
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _ГвардКабинета,
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ЗаголовкиКэша") _Заголовки)

	ГвардКабинета = _ГвардКабинета;
	Каркас = _Каркас;
	Кит = _Кит;
	Тексты = _Тексты;
	СервисПрав = _СервисПрав;
	СервисПулов = _СервисПулов;
	Заголовки = _Заголовки;

КонецПроцедуры
