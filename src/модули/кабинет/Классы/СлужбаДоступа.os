// Служба доступа — желудь модуля кабинет.

Перем СервисПулов;        // СервисПулов (реестр)
Перем СервисПакетов;      // СервисПакетов (реестр)
Перем СервисПрав;         // СервисПрав (auth)
Перем СервисПравДоступа;  // СервисПравДоступа (auth)
Перем ГвардКвоты;         // ГвардКвотыПула (auth)

#Область ПубличныйИнтерфейс

// Self-service создание пула.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Имя - Строка - имя.
//  Тип - Строка - local | proxy | group (необязательный, по умолчанию "custom").
//  Видимость - Строка - public | private (необязательный, по умолчанию "public").
//  КвотаМб - Число, Неопределено - квота нового пула; Неопределено — пул наследует
//            квоту хаба. Задавать её вправе только администратор хаба
//            (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Пул - созданный пул.
//
Функция СоздатьПул(Знач Пользователь, Знач Имя, Знач Тип = "custom", Знач Видимость = "public",
	Знач КвотаМб = Неопределено) Экспорт

	Если НЕ СервисПрав.МожетСоздаватьПул(Пользователь) Тогда
		ВызватьИсключение "Недостаточно прав для создания пула (требуется право создания на уровне хаба)";
	КонецЕсли;

	// Создание — второй вход к квоте, и он закрыт тем же гвардом, что и её правка:
	// иначе предел назначал бы себе тот, кого он ограничивает.
	Если КвотаМб = Неопределено Тогда
		КвотаМб = СервисПулов.КвотаКакВХабе();
	ИначеЕсли НЕ ГвардКвоты.МожетМенятьКвоту(Пользователь) Тогда
		ВызватьИсключение ГвардКвоты.ПричинаОтказа();
	КонецЕсли;

	ИдВладельца = ?(Пользователь = Неопределено, 0, Пользователь.Идентификатор);
	Пул = СервисПулов.СоздатьПул(Имя, Тип, Видимость, ИдВладельца, КвотаМб);

	// создатель — owner своего пула
	Если Пользователь <> Неопределено Тогда
		ПолныйНаборДействий = Новый Структура("создание, изменение, удаление, чтение", Истина, Истина, Истина, Истина);
		СервисПравДоступа.ЗафиксироватьГрант(
			"пользователь", Пользователь.Идентификатор, СервисПрав.ОбъектПул(Пул), ПолныйНаборДействий, ИдВладельца);
	КонецЕсли;

	Возврат Пул;

КонецФункции

// Назначает пул основным пулом хаба: короткие адреса /download, /dev-channel и /push
// начинают вести в него, инварианты «публичен и неудаляем» переезжают с прежнего.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Пул - пул, ставший основным.
//
Функция НазначитьОсновнойПул(Знач Пользователь, Знач ПулИдентификатор) Экспорт

	Если НЕ СервисПрав.МожетНазначатьОсновнойПул(Пользователь) Тогда
		ВызватьИсключение
			"Недостаточно прав, чтобы назначить основной пул хаба (требуется право изменения"
			+ " на уровне хаба; роль администратора пула его не даёт)";
	КонецЕсли;

	Кем = ?(Пользователь = Неопределено, "", Строка(Пользователь.Логин));
	Возврат СервисПулов.НазначитьПулПоУмолчанию(ПулИдентификатор, Кем);

КонецФункции

// Удаляет пул.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  ПулИдентификатор - Число.
//
Процедура УдалитьПул(Знач Пользователь, Знач ПулИдентификатор) Экспорт

	Если НЕ СервисПрав.МожетУдалятьПул(Пользователь) Тогда
		ВызватьИсключение
			"Недостаточно прав для удаления пула (требуется право удаления на уровне хаба;"
			+ " роль администратора пула его не даёт)";
	КонецЕсли;

	СервисПулов.УдалитьПул(ПулИдентификатор);

КонецПроцедуры

// Заводит/обновляет апстрим пула.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  ПулИдентификатор - Число.
//  Url - Строка - базовый URL выдачи апстрима (контракт opm).
//  ВремяЖизниСек - Число (необязательный, по умолчанию 900).
//  СписокРазрешенийJSON - Строка (необязательный, по умолчанию "").
//  РазрешитьПриватные - Булево - явное разрешение интранет-адреса (необязательный, по умолчанию Ложь).
//  Токен - Строка - токен доступа к приватной выдаче источника; пусто оставляет прежний
//          (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  АпстримПула.
//
Функция ЗадатьАпстрим(Знач Пользователь, Знач ПулИдентификатор, Знач Url, Знач ВремяЖизниСек = 900,
	Знач СписокРазрешенийJSON = "", Знач РазрешитьПриватные = Ложь, Знач Токен = "") Экспорт

	Пул = СервисПулов.ПулПоИдентификатору(ПулИдентификатор);
	Если Пул = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Пул с идентификатором %1 не найден", ПулИдентификатор);
	КонецЕсли;

	Если НЕ СервисПрав.МожетНастраиватьАпстримы(Пользователь, Пул) Тогда
		ВызватьИсключение "Недостаточно прав для настройки апстримов пула (требуется изменение пула)";
	КонецЕсли;

	Возврат СервисПулов.ДобавитьАпстрим(
		ПулИдентификатор, Url, ВремяЖизниСек, СписокРазрешенийJSON, РазрешитьПриватные, Токен);

КонецФункции

// Поддерживается ли тип объекта гранта.
//
// Параметры:
//  ТипОбъекта - Строка.
//
// Возвращаемое значение:
//  Булево.
//
Функция ТипОбъектаПоддерживается(Знач ТипОбъекта) Экспорт
	Норм = НРег(СокрЛП(Строка(ТипОбъекта)));
	Возврат Норм = "хаб" ИЛИ Норм = "пул" ИЛИ Норм = "пакет";
КонецФункции

// Живёт ли объект такого типа внутри пула (пул · пакет).
//
// Параметры:
//  ТипОбъекта - Строка.
//
// Возвращаемое значение:
//  Булево.
//
Функция ТипОбъектаВПуле(Знач ТипОбъекта) Экспорт
	Норм = НРег(СокрЛП(Строка(ТипОбъекта)));
	Возврат Норм = "пул" ИЛИ Норм = "пакет";
КонецФункции

// Грант субъекту на объект; авторизацию выполняет СервисПравДоступа.
//
// Параметры:
//  Пользователь - Пользователь - инициатор (owner/admin объекта).
//  ТипСубъекта - Строка - пользователь | группа.
//  СубъектИд - Число.
//  ТипОбъекта - Строка - хаб | пул | пакет.
//  ОбъектИд - Число.
//  Действия - Структура - {создание, изменение, удаление, чтение}.
//
// Возвращаемое значение:
//  ПравоДоступа, Неопределено.
//
Функция ВыдатьГрант(Знач Пользователь, Знач ТипСубъекта, Знач СубъектИд, Знач ТипОбъекта, Знач ОбъектИд, Знач Действия) Экспорт
	Объект = ОбъектСРеальнымПулом(ТипОбъекта, ОбъектИд);
	Возврат СервисПравДоступа.ВыдатьГрант(Пользователь, ТипСубъекта, СубъектИд, Объект, Действия);
КонецФункции

// Роль субъекту на объект — рабочая форма экранов прав доступа.
//
// Параметры:
//  Пользователь - Пользователь - инициатор (мейнтейнер объекта и выше).
//  ТипСубъекта - Строка - пользователь | группа.
//  СубъектИд - Число.
//  ТипОбъекта - Строка - хаб | пул | пакет.
//  ОбъектИд - Число.
//  Роль - Строка - читатель | райтер | мейнтейнер.
//
// Возвращаемое значение:
//  ПравоДоступа, Неопределено.
//
Функция ВыдатьРоль(Знач Пользователь, Знач ТипСубъекта, Знач СубъектИд, Знач ТипОбъекта, Знач ОбъектИд, Знач Роль) Экспорт
	Объект = ОбъектСРеальнымПулом(ТипОбъекта, ОбъектИд);
	Возврат СервисПравДоступа.ВыдатьРоль(Пользователь, ТипСубъекта, СубъектИд, Объект, Роль);
КонецФункции

// Может ли пользователь выдавать и отзывать права на объекте. Пул объекта берётся из
// сущности, поэтому подделать область наследования вводом нельзя.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - инициатор.
//  ТипОбъекта - Строка - хаб | пул | пакет.
//  ОбъектИд - Число - идентификатор объекта.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетВыдаватьГрант(Знач Пользователь, Знач ТипОбъекта, Знач ОбъектИд) Экспорт
	Возврат СервисПравДоступа.МожетВыдаватьГрант(Пользователь, ОбъектСРеальнымПулом(ТипОбъекта, ОбъектИд));
КонецФункции

// Гранты субъекта (для UI «на что есть права»).
//
// Параметры:
//  ТипСубъекта - Строка - пользователь | группа.
//  СубъектИд - Число - идентификатор субъекта.
//
// Возвращаемое значение:
//  Массив из ПравоДоступа.
//
Функция ГрантыСубъекта(Знач ТипСубъекта, Знач СубъектИд) Экспорт
	Возврат СервисПравДоступа.ГрантыСубъекта(ТипСубъекта, СубъектИд);
КонецФункции

// Роль, записанная строкой прав — обратный резолв набора действий.
//
// Параметры:
//  Грант - ПравоДоступа.
//
// Возвращаемое значение:
//  Строка.
//
Функция РольЗаписи(Знач Грант) Экспорт
	Возврат СервисПравДоступа.РольЗаписи(Грант);
КонецФункции

// Отзывает грант субъекта на объект (авторизацию выполняет СервисПравДоступа).
//
// Параметры:
//  Пользователь - СправочникСсылка - пользователь запроса.
//  ТипСубъекта - Строка - тип субъекта («пользователь», «группа»).
//  СубъектИд - Число - идентификатор субъекта.
//  ТипОбъекта - Строка - тип объекта («пул», «пакет»).
//  ОбъектИд - Число - идентификатор объекта.
//
// Возвращаемое значение:
//  Булево - Истина, если грант был найден и отозван.
//
Функция ОтозватьГрант(Знач Пользователь, Знач ТипСубъекта, Знач СубъектИд, Знач ТипОбъекта, Знач ОбъектИд) Экспорт
	Объект = ОбъектСРеальнымПулом(ТипОбъекта, ОбъектИд);
	Возврат СервисПравДоступа.ОтозватьГрант(Пользователь, ТипСубъекта, СубъектИд, Объект);
КонецФункции

// Пул-владелец объекта из сущности, а не из ввода — защита от кросс-пулового IDOR.
//
// Параметры:
//  ТипОбъекта - Строка - пул | пакет | хаб.
//  ОбъектИд - Число.
//
// Возвращаемое значение:
//  Пул, Неопределено.
//
Функция РеальныйПулОбъекта(Знач ТипОбъекта, Знач ОбъектИд) Экспорт
	Норм = НРег(СокрЛП(Строка(ТипОбъекта)));
	Если Норм = "пул" Тогда
		Возврат СервисПулов.ПулПоИдентификатору(ОбъектИд);
	ИначеЕсли Норм = "пакет" Тогда
		Пакет = СервисПакетов.ПакетПоИдентификатору(ОбъектИд);
		Возврат ?(Пакет = Неопределено, Неопределено, СервисПулов.ПулПоИдентификатору(Пакет.ПулИдентификатор));
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Гранты на объект (для UI «кто имеет доступ»).
//
// Параметры:
//  ТипОбъекта - Строка - тип объекта («пул», «пакет»).
//  ОбъектИд - Число - идентификатор объекта.
//
// Возвращаемое значение:
//  Массив из ПравоДоступа.
//
Функция ГрантыНаОбъект(Знач ТипОбъекта, Знач ОбъектИд) Экспорт
	Возврат СервисПравДоступа.ГрантыНаОбъект(СервисПрав.ОписаниеОбъекта(ТипОбъекта, ОбъектИд, 0));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Объект действия с реальным пулом из сущности.
Функция ОбъектСРеальнымПулом(Знач ТипОбъекта, Знач ОбъектИд)
	Норм = НРег(СокрЛП(Строка(ТипОбъекта)));
	Если НЕ ТипОбъектаПоддерживается(Норм) Тогда
		ВызватьИсключение СтрШаблон(
			"Неизвестный тип объекта права доступа ""%1"": поддерживаются хаб, пул и пакет", ТипОбъекта);
	КонецЕсли;
	Если Норм = "хаб" Тогда
		Возврат СервисПрав.ОбъектХаб();
	КонецЕсли;
	Пул = РеальныйПулОбъекта(Норм, ОбъектИд);
	Если Пул = Неопределено Тогда
		ВызватьИсключение "Объект права доступа не найден";
	КонецЕсли;
	ИдОбъекта = ?(Норм = "пул", Пул.Идентификатор, Цел(ОбъектИд));
	Возврат СервисПрав.ОписаниеОбъекта(Норм, ИдОбъекта, Пул.Идентификатор);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисПравДоступа") _СервисПравДоступа,
	&Пластилин(Значение = "ГвардКвотыПула") _ГвардКвоты)

	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	СервисПрав = _СервисПрав;
	СервисПравДоступа = _СервисПравДоступа;
	ГвардКвоты = _ГвардКвоты;

КонецПроцедуры
