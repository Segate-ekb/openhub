// Гвард кабинета — желудь модуля кабинет.

Перем Перехватчик;   // ПерехватчикАутентификации (auth)
Перем Онбординг;     // ОнбордингПервогоЗапуска (auth)

// Путь редиректа на мастер первого запуска.
//
// Возвращаемое значение:
//  Строка - путь редиректа на мастер первого запуска.
//
Функция ПутьНастройки() Экспорт
	Возврат "/setup";
КонецФункции

// Путь редиректа для форсированной смены пароля.
//
// Возвращаемое значение:
//  Строка - путь редиректа для форсированной смены пароля.
//
Функция ПутьСменыПароля() Экспорт
	Возврат "/me/settings/security";
КонецФункции

// Проверяет доступ к маршруту кабинета.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow (для редиректа).
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки (winow).
//  ЭтоСтраницаСменыПароля - Булево - Истина только для маршрутов смены пароля (иначе форс-смена зациклит редирект на самой странице смены) (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура:
//    * Разрешено - Булево - можно ли продолжать обработку;
//    * Принципал - Структура, Неопределено - принципал (при Разрешено = Истина);
//    * Пользователь - Пользователь, Неопределено - удобный доступ к пользователю;
//    * Сессия - СессияХаба, Неопределено - сессия (для CSRF).
//
Функция Проверить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ЭтоСтраницаСменыПароля = Ложь) Экспорт

	Если Онбординг.НуженОнбординг() Тогда
		Ответ.Перенаправить(ПутьНастройки());
		Возврат Вердикт(Ложь, Неопределено);
	КонецЕсли;

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);
	Если Принципал.Пользователь = Неопределено Тогда
		Ответ.Перенаправить("/login");
		Возврат Вердикт(Ложь, Неопределено);
	КонецЕсли;

	Если Принципал.Пользователь.ТребуетсяСменаПароля = Истина И НЕ ЭтоСтраницаСменыПароля Тогда
		Ответ.Перенаправить(ПутьСменыПароля());
		Возврат Вердикт(Ложь, Неопределено);
	КонецЕсли;

	Возврат Вердикт(Истина, Принципал);

КонецФункции

Функция Вердикт(Знач Разрешено, Знач Принципал)
	Структура = Новый Структура();
	Структура.Вставить("Разрешено", Разрешено);
	Структура.Вставить("Принципал", Принципал);
	Структура.Вставить("Пользователь", ?(Принципал = Неопределено, Неопределено, Принципал.Пользователь));
	Структура.Вставить("Сессия", ?(Принципал = Неопределено, Неопределено, Принципал.Сессия));
	Возврат Структура;
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "ОнбордингПервогоЗапуска") _Онбординг)

	Перехватчик = _Перехватчик;
	Онбординг = _Онбординг;

КонецПроцедуры
