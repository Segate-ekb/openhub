// Гвард домена «Хаб» — желудь модуля кабинет.

Перем ГвардКабинета;  // ГвардКабинета (кабинет) — базовые гейты приватной части
Перем Каркас;         // КаркасСтраницы (кит) — страница отказа
Перем Кит;            // Кит (кит) — тело страницы отказа
Перем Тексты;         // ТекстыИнтерфейса (кит)
Перем СервисПрав;     // СервисПрав (auth) — суперправо хаб-admin
Перем Заголовки;      // ЗаголовкиКэша (основа) — страница отказа не остаётся у чужой стороны
Перем Вердикты;       // ВердиктГварда (права) — форма ответа гварда

// Проверяет доступ к маршруту домена «Хаб».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки (winow).
//
// Возвращаемое значение:
//  Структура (как у ГвардКабинета).
//
Функция Проверить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса) Экспорт

	Вердикт = ГвардКабинета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Вердикт; // онбординг/аноним/форс-смена — редирект уже записан
	КонецЕсли;

	Если НЕ СервисПрав.ПользовательАдмин(Вердикт.Пользователь) Тогда
		ОтдатьЗапрещено(Ответ, Вердикт.Пользователь,
			Тексты.Текст("settings.guard.hub.forbidden"), КукиЗапроса);
		Возврат Отказ();
	КонецЕсли;

	Возврат Вердикт;

КонецФункции

Процедура ОтдатьЗапрещено(Ответ, Знач Пользователь, Знач Сообщение, Знач КукиЗапроса)
	Заголовки.ЗакрытьСтраницу(Ответ);
	Ответ.УстановитьСостояние(403);
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Тексты.Текст("settings.reply.forbidden.title"),
		Кит.СтраницаОшибки(Новый Структура("Код, Сообщение", 403, Сообщение)),
		КонтекстОтказа(Пользователь, КукиЗапроса));
КонецПроцедуры

// Страница отказа приватная: разделы администратора в её навигации не показываются.
Функция КонтекстОтказа(Знач Пользователь, Знач КукиЗапроса)
	Возврат Каркас.КонтекстСтраницы(Пользователь, КукиЗапроса, Ложь, Истина);
КонецФункции

Функция Отказ()
	Возврат Вердикты.Отказ("", Вердикты.ПоляПринципала());
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _ГвардКабинета,
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ЗаголовкиКэша") _Заголовки,
	&Пластилин(Значение = "ВердиктГварда") _Вердикты = Неопределено)

	Вердикты = ?(_Вердикты = Неопределено, Новый ВердиктГварда(), _Вердикты);
	ГвардКабинета = _ГвардКабинета;
	Каркас = _Каркас;
	Кит = _Кит;
	Тексты = _Тексты;
	СервисПрав = _СервисПрав;
	Заголовки = _Заголовки;

КонецПроцедуры
