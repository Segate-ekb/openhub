// Служба кабинета — желудь модуля кабинет.

Перем СервисПулов;    // СервисПулов (реестр)
Перем СервисПакетов;  // СервисПакетов (реестр)
Перем СервисВерсий;   // СервисВерсий (реестр)
Перем СервисПрав;     // СервисПрав (auth)

// Может ли пользователь управлять пакетом (редактировать метаданные, yank версий).
//
// Параметры:
//  Пользователь - Пользователь, Неопределено.
//  Пул - Пул - контекст вызова (в решении не участвует: объект права — сам пакет, а пул он несёт в себе для наследования).
//  Пакет - Пакет.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетУправлять(Знач Пользователь, Знач Пул, Знач Пакет) Экспорт

	Если Пользователь = Неопределено ИЛИ Пул = Неопределено ИЛИ Пакет = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СервисПрав.РазрешеноДействие(Пользователь, "изменение", СервисПрав.ОбъектПакет(Пакет)) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ПользовательОпубликовал(Пользователь, Пакет);

КонецФункции

// Пакеты под управлением пользователя: по правам и публикациям, без полного обхода пулов.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено.
//
// Возвращаемое значение:
//  Массив из Структура {Пул, Пакет} - детерминированный порядок (пул, затем пакет).
//
Функция ПакетыВУправлении(Знач Пользователь) Экспорт

	Если Пользователь = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Найденные = Новый Соответствие(); // идентификатор пакета -> Пакет
	Области = СервисПрав.ОбластиИзменения(Пользователь);

	Если Области.ВесьХаб Тогда
		Для Каждого Пакет Из СервисПакетов.ВсеПакеты() Цикл
			Найденные.Вставить(Пакет.Идентификатор, Пакет);
		КонецЦикла;
	Иначе
		Для Каждого ПулИдентификатор Из Области.Пулы Цикл
			Для Каждого Пакет Из СервисПакетов.ПакетыПула(ПулИдентификатор) Цикл
				Найденные.Вставить(Пакет.Идентификатор, Пакет);
			КонецЦикла;
		КонецЦикла;
		Для Каждого ПакетИдентификатор Из Области.Пакеты Цикл
			ДобавитьПакет(Найденные, ПакетИдентификатор);
		КонецЦикла;
		Для Каждого Версия Из СервисВерсий.ВерсииПользователя(Пользователь.Идентификатор) Цикл
			ДобавитьПакет(Найденные, Версия.ПакетИдентификатор);
		КонецЦикла;
	КонецЕсли;

	Возврат Упорядоченные(Найденные);

КонецФункции

// Пулы под управлением пользователя: по правам, без полного обхода реестра. Админу хаба
// принадлежат все пулы, поэтому ему список и отдаётся целиком.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено.
//
// Возвращаемое значение:
//  Массив из Пул - детерминированный порядок (по имени пула).
//
Функция ПулыВУправлении(Знач Пользователь) Экспорт

	Если Пользователь = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Области = СервисПрав.ОбластиИзменения(Пользователь);
	Если Области.ВесьХаб Тогда
		Возврат ПоИмени(СервисПулов.ВсеПулы());
	КонецЕсли;

	Найденные = Новый Массив();
	Для Каждого ПулИдентификатор Из Области.Пулы Цикл
		Пул = СервисПулов.ПулПоИдентификатору(ПулИдентификатор);
		Если Пул <> Неопределено Тогда
			Найденные.Добавить(Пул);
		КонецЕсли;
	КонецЦикла;

	Возврат ПоИмени(Найденные);

КонецФункции

// Пулы, которыми пользователь РАСПОРЯЖАЕТСЯ: настраивает зеркала, права и опасную зону.
// Порог здесь выше, чем у ПулыВУправлении: туда пускает право записи (райтер и выше),
// сюда — только роль мейнтейнера и выше. Райтер публикует в пул, но не решает, откуда
// пул наполняется.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено.
//
// Возвращаемое значение:
//  Массив из Пул - детерминированный порядок (по имени пула).
//
Функция ПулыВРаспоряжении(Знач Пользователь) Экспорт

	Результат = Новый Массив();
	Для Каждого Пул Из ПулыВУправлении(Пользователь) Цикл
		Если СервисПрав.МожетАдминистрировать(Пользователь, Пул) Тогда
			Результат.Добавить(Пул);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ДобавитьПакет(Найденные, Знач ПакетИдентификатор)

	Если Найденные.Получить(ПакетИдентификатор) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Пакет = СервисПакетов.ПакетПоИдентификатору(ПакетИдентификатор);
	Если Пакет <> Неопределено Тогда
		Найденные.Вставить(Пакет.Идентификатор, Пакет);
	КонецЕсли;

КонецПроцедуры

// Детерминированный порядок выдачи: пул, затем пакет.
Функция Упорядоченные(Знач Найденные)

	Пулы = Новый Соответствие();

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("КлючПула");
	Таблица.Колонки.Добавить("КлючПакета");
	Таблица.Колонки.Добавить("Пул");
	Таблица.Колонки.Добавить("Пакет");

	Для Каждого КиЗ Из Найденные Цикл
		Пакет = КиЗ.Значение;
		Пул = Пулы.Получить(Пакет.ПулИдентификатор);
		Если Пул = Неопределено Тогда
			Пул = СервисПулов.ПулПоИдентификатору(Пакет.ПулИдентификатор);
			Если Пул = Неопределено Тогда
				Продолжить; // пакет без пула в выдачу не попадает: его некуда открыть
			КонецЕсли;
			Пулы.Вставить(Пакет.ПулИдентификатор, Пул);
		КонецЕсли;
		Строка = Таблица.Добавить();
		Строка.КлючПула = НРег(Строка(Пул.Имя));
		Строка.КлючПакета = Пакет.ИмяНижнийРегистр;
		Строка.Пул = Пул;
		Строка.Пакет = Пакет;
	КонецЦикла;

	Таблица.Сортировать("КлючПула Возр, КлючПакета Возр");

	Результат = Новый Массив();
	Для Каждого Строка Из Таблица Цикл
		Результат.Добавить(Новый Структура("Пул, Пакет", Строка.Пул, Строка.Пакет));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Детерминированный порядок выдачи пулов: две страницы подряд обязаны показать одно и то же.
Функция ПоИмени(Знач Пулы)

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Ключ");
	Таблица.Колонки.Добавить("Пул");

	Для Каждого Пул Из Пулы Цикл
		Запись = Таблица.Добавить();
		Запись.Ключ = НРег(Строка(Пул.Имя));
		Запись.Пул = Пул;
	КонецЦикла;

	Таблица.Сортировать("Ключ Возр");

	Результат = Новый Массив();
	Для Каждого Запись Из Таблица Цикл
		Результат.Добавить(Запись.Пул);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПользовательОпубликовал(Знач Пользователь, Знач Пакет)

	ИдПользователя = Пользователь.Идентификатор;
	Для Каждого Версия Из СервисВерсий.ВерсииПакета(Пакет.Идентификатор) Цикл
		Если ЗначениеЗаполнено(Версия.ОпубликовалИдентификатор)
			И Версия.ОпубликовалИдентификатор = ИдПользователя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисПрав") _СервисПрав)

	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;
	СервисПрав = _СервисПрав;

КонецПроцедуры
