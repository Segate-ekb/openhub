// Оба перехода настройки «Личные пространства» (oshub.pools.personal_enabled): выключение
// сносит все пулы типа user каскадом, включение раздаёт пространство каждой активной учётке.

Перем СервисПулов;            // СервисПулов (реестр) — типы пулов и каскадное удаление
Перем СервисПакетов;          // СервисПакетов (реестр) — числа для окна предупреждения
Перем СервисВерсий;           // СервисВерсий (реестр)
Перем СервисПользователей;    // СервисПользователей (вход) — учётки и их личные пространства
Перем Издатель;               // ИздательСобытий (события) — след в журнале аудита
Перем ИменаЖурнала;           // ИмяОбъектаАудита (аудит) — вид объекта в журнале
Перем СобытиеЖурнала;         // СобытиеАудита (аудит) — форма нагрузки записи
&Лог
Перем Лог;
Перем Желуди;   // ВнедрённыеЖелуди (основа) — три формы внедрения необязательной зависимости

#Область ПубличныйИнтерфейс

// Что именно унесёт выключение настройки. Числа считаются на месте, по текущей базе.
//
// Возвращаемое значение:
//  Структура - Пулов (Число), ПуловСПакетами (Число), Пакетов (Число), Версий (Число),
//              Ошибок (Число, всегда 0 — форма общая с итогом операции).
//
&Наблюдаемый
Функция СводкаУдаления() Экспорт

	Итог = ПустаяСводка();

	Для Каждого Пул Из ЛичныеПулы() Цикл
		Сложить(Итог, СводкаПула(Пул));
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Удаляет все личные пулы полным каскадом; потеря необратима. Сбой на одном пространстве
// считается в Ошибок и операцию не обрывает.
//
// Параметры:
//  Кто - Строка - принципал операции для журнала аудита.
//
// Возвращаемое значение:
//  Структура - Пулов (Число), ПуловСПакетами (Число), Пакетов (Число), Версий (Число) —
//              ФАКТИЧЕСКИ снесённое; Ошибок (Число) — пространств, снести которые не вышло.
//
&Наблюдаемый
Функция УдалитьВсе(Знач Кто) Экспорт

	Итог = ПустаяСводка();

	Для Каждого Пул Из ЛичныеПулы() Цикл

		Свод = СводкаПула(Пул);

		Попытка
			СервисПулов.УдалитьПул(Цел(Пул.Идентификатор));
		Исключение
			Итог.Ошибок = Итог.Ошибок + 1;
			Лог.Ошибка("Личное пространство ""%1"" не снесено: %2. Остальные пространства"
				+ " сносятся дальше, операцию можно повторить.", Пул.Имя, ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Сложить(Итог, Свод);

	КонецЦикла;

	Лог.Отладка("Личные пространства: снесено пулов %1 (с пакетами %2), пакетов %3,"
		+ " версий %4, не снеслось %5",
		Итог.Пулов, Итог.ПуловСПакетами, Итог.Пакетов, Итог.Версий, Итог.Ошибок);

	ЗаписатьВАудит(Кто, ДействиеВыключены(), Новый Структура(
		"Пулов, ПуловСПакетами, Пакетов, Версий, Ошибок",
		Итог.Пулов, Итог.ПуловСПакетами, Итог.Пакетов, Итог.Версий, Итог.Ошибок));

	Возврат Итог;

КонецФункции

// Заводит личное пространство каждой активной учётке, у которой его нет. Идемпотентна:
// повторный вызов ничего не создаёт и не падает. Отключённые учётки пропускаются.
//
// Параметры:
//  Кто - Строка - принципал операции для журнала аудита.
//
// Возвращаемое значение:
//  Структура - Создано (Число), Было (Число), Пропущено (Число), Ошибок (Число —
//              учётки, оставшиеся без пространства: имя занято чужим пулом либо сбой).
//
&Наблюдаемый
Функция РаздатьВсем(Знач Кто) Экспорт

	Создано = 0;
	Было = 0;
	Пропущено = 0;
	Ошибок = 0;

	Для Каждого Пользователь Из СервисПользователей.ВсеПользователи() Цикл

		Итог = СервисПользователей.ОбеспечитьЛичныйПул(Пользователь);

		Если Итог = СервисПользователей.ИтогСоздан() Тогда
			Создано = Создано + 1;
		ИначеЕсли Итог = СервисПользователей.ИтогБыло() Тогда
			Было = Было + 1;
		ИначеЕсли Итог = СервисПользователей.ИтогПропущен() Тогда
			Пропущено = Пропущено + 1;
		Иначе
			// «имя занято» и «сбой» — оба «учётка без пространства»; различает их журнал
			Ошибок = Ошибок + 1;
			Лог.Ошибка("Личное пространство ""%1"" не заведено: %2",
				Пользователь.Логин, Итог);
		КонецЕсли;

	КонецЦикла;

	Лог.Отладка("Личные пространства: заведено %1, уже было %2, пропущено %3, без пространства %4",
		Создано, Было, Пропущено, Ошибок);

	ЗаписатьВАудит(Кто, ДействиеВключены(), Новый Структура("Создано, Было, Пропущено, Ошибок",
		Создано, Было, Пропущено, Ошибок));

	Возврат Новый Структура("Создано, Было, Пропущено, Ошибок", Создано, Было, Пропущено, Ошибок);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Действия журнала аудита для выключения и включения настройки.
Функция ДействиеВыключены()
	Возврат "пространства.личные.снесены";
КонецФункции

Функция ДействиеВключены()
	Возврат "пространства.личные.розданы";
КонецФункции

// Список берётся заново перед каждым проходом: удаление меняет выборку под ногами.
Функция ЛичныеПулы()
	Возврат СервисПулов.ПулыПоТипу(СервисПулов.ТипЛичный());
КонецФункции

Функция ПустаяСводка()
	Возврат Новый Структура("Пулов, ПуловСПакетами, Пакетов, Версий, Ошибок", 0, 0, 0, 0, 0);
КонецФункции

// Версии считаются одним счётом на все пакеты пула, а не вопросом про каждый пакет.
Функция СводкаПула(Знач Пул)

	Пакеты = СервисПакетов.ПакетыПула(Цел(Пул.Идентификатор));

	Идентификаторы = Новый Массив();
	Для Каждого Пакет Из Пакеты Цикл
		Идентификаторы.Добавить(Цел(Пакет.Идентификатор));
	КонецЦикла;

	Пакетов = Пакеты.Количество();

	Возврат Новый Структура("Пулов, ПуловСПакетами, Пакетов, Версий, Ошибок",
		1, ?(Пакетов > 0, 1, 0), Пакетов, СервисВерсий.КоличествоВерсийВПакетах(Идентификаторы), 0);

КонецФункции

Процедура Сложить(Итог, Знач Слагаемое)
	Итог.Пулов = Итог.Пулов + Слагаемое.Пулов;
	Итог.ПуловСПакетами = Итог.ПуловСПакетами + Слагаемое.ПуловСПакетами;
	Итог.Пакетов = Итог.Пакетов + Слагаемое.Пакетов;
	Итог.Версий = Итог.Версий + Слагаемое.Версий;
КонецПроцедуры

Процедура ЗаписатьВАудит(Знач Кто, Знач Действие, Знач Детали)

	Данные = СобытиеЖурнала.Собрать(Кто, Действие,
		ИменаЖурнала.Настройка("oshub.pools.personal_enabled"), "", Детали);

	Если Издатель = Неопределено Тогда
		Возврат; // контейнер без модуля события: операция состоялась, журналировать некому
	КонецЕсли;

	Попытка
		Издатель.Опубликовать(Издатель.ТипЛичныеПространстваИзменены(), Данные);
	Исключение
		// журнал вторичен: операция уже состоялась и откату не подлежит
	КонецПопытки;

КонецПроцедуры

Функция Первый(Знач Коллекция)
	Возврат Желуди.ПервыйИз(Коллекция);
КонецФункции

#КонецОбласти

&Прозвище("СлужбаЛичныхПространств")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "ИздательСобытий", Тип = "Массив") _Издатель,
	&Пластилин(Значение = "ИмяОбъектаАудита") _ИменаЖурнала,
	&Пластилин(Значение = "СобытиеАудита") _Событие,
	&Лог _Лог = Неопределено) Экспорт

	Желуди = Новый ВнедрённыеЖелуди();

	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;
	СервисПользователей = _СервисПользователей;
	// массив вместо желудя — необязательная зависимость: без модуля события аудит не пишется
	Издатель = Первый(_Издатель);
	ИменаЖурнала = _ИменаЖурнала;
	СобытиеЖурнала = _Событие;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
