// Протокол зеркалируемого хаба режима "opm": имена пакетов из list.txt, версии — со страницы
// пакета, скачивание .ospx через КлиентАпстрима. Об изменениях этот протокол не сообщает.

#Использовать url

Перем Клиент; // КлиентАпстрима (прокси)
Перем Разбор; // РазборВерсийПакета (зеркала)
Перем Секрет; // СекретИсточника (прокси) — токен доступа записи зеркала
Перем Корень; // КореньАпстрима (зеркала) — адрес соседа выдачи
Перем Фильтр; // ФильтрИмёнЗеркала (зеркала) — маски имён из настройки зеркала

#Область ПубличныйИнтерфейс

// Режим, который обслуживает этот источник.
//
// Возвращаемое значение:
//  Строка - "opm".
//
Функция Режим() Экспорт
	Возврат "opm";
КонецФункции

// Перечисляет элементы синка ОЧЕРЕДНОЙ ПОРЦИИ имён — по элементу на каждую версию каждого
// пакета порции с учётом фильтра зеркала. Пакет, перечень версий которого получить не
// удалось, представлен одним элементом latest с неизвестной версией.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - конфигурация зеркала: АпстримURL, ФильтрJSON.
//  РазмерПорции - Число - сколько ПАКЕТОВ берётся за цикл; версии отобранного пакета
//                 перечисляются целиком.
//  Курсор - Строка - имя пакета, с которого продолжается обход (включительно);
//           пусто — с начала списка (необязательный, по умолчанию "").
//  Отметка - Произвольный - объект с методом Шаг(ИмяПакета): зовётся на каждом имени
//            порции, чтобы живой обход не молчал дольше одного запроса к апстриму
//            (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - Код (Число, HTTP-код list.txt; 0 — апстрим недоступен),
//              Элементы (Массив из Структура: ИмяПакета, Версия, ПутьСкачивания, ВерсияИзвестна),
//              ЕстьЕщё (Булево, за порцией остались непройденные имена),
//              Курсор (Строка, имя для следующего цикла; пусто — обход списка завершён),
//              ИменВсего (Число, имён у апстрима после фильтра — знаменатель обхода),
//              ИменПройдено (Число, имён, пройденных обходом ДО этой порции).
//
Функция Перечислить(Знач Зеркало, Знач РазмерПорции, Знач Курсор = "", Знач Отметка = Неопределено) Экспорт

	Результат = Клиент.ПолучитьТекст(Зеркало.АпстримURL, "list.txt", "", Токен(Зеркало));
	Ответ = Новый Структура("Код, Элементы, ЕстьЕщё, Курсор, ИменВсего, ИменПройдено",
		Результат.Код, Новый Массив(), Ложь, "", 0, 0);
	Если Результат.Код <> 200 Тогда
		Возврат Ответ; // 0 — offline, иное — списка нет
	КонецЕсли;

	Порция = ОтобратьПорцию(Строка(Результат.Тело), Зеркало.ФильтрJSON, РазмерПорции, Курсор);
	Ответ.ЕстьЕщё = Порция.ЕстьЕщё;
	Ответ.Курсор = Порция.Курсор;
	Ответ.ИменВсего = Порция.ИменВсего;
	Ответ.ИменПройдено = Порция.ИменПройдено;
	Для Каждого Имя Из Порция.Имена Цикл
		ДобавитьПакет(Ответ.Элементы, Зеркало, Имя);
		// страница версий — отдельный запрос к апстриму: без отметки перечисление порции
		// молчит порция × таймаут, и живой обход объявляют брошенным
		Если Отметка <> Неопределено Тогда
			Отметка.Шаг(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Ответ;

КонецФункции

// Скачивает .ospx элемента синка с апстрима.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - конфигурация зеркала.
//  Элемент - Структура - элемент синка с полем ПутьСкачивания.
//
// Возвращаемое значение:
//  Структура - Код (Число; 0 — апстрим недоступен), Данные (ДвоичныеДанные), ETag (Строка).
//
Функция Скачать(Знач Зеркало, Знач Элемент) Экспорт
	Возврат Клиент.СкачатьДанные(Зеркало.АпстримURL, Элемент.ПутьСкачивания, "", Токен(Зеркало));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Порция считает ПАКЕТЫ: по версиям она встала бы на первых же именах list.txt.
Функция ОтобратьПорцию(Знач Тело, Знач ФильтрJSON, Знач РазмерПорции, Знач Курсор)

	Ответ = Новый Структура("Имена, ЕстьЕщё, Курсор, ИменВсего, ИменПройдено",
		Новый Массив(), Ложь, "", 0, 0);
	Маски = Фильтр.Маски(ФильтрJSON);
	КурсорКлюч = НРег(СокрЛП(Строка(Курсор)));

	Для Каждого Имя Из ПоВозрастанию(Тело) Цикл
		Если НЕ Фильтр.Пропускает(Маски, Имя) Тогда
			Продолжить;
		КонецЕсли;
		Ответ.ИменВсего = Ответ.ИменВсего + 1;
		Если НРег(Имя) < КурсорКлюч Тогда
			Ответ.ИменПройдено = Ответ.ИменПройдено + 1;
			Продолжить;
		КонецЕсли;
		Если Ответ.Имена.Количество() >= РазмерПорции Тогда
			Если НЕ Ответ.ЕстьЕщё Тогда
				Ответ.ЕстьЕщё = Истина;
				Ответ.Курсор = Имя;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Ответ.Имена.Добавить(Имя);
	КонецЦикла;

	Возврат Ответ;

КонецФункции

// Курсор — позиция в УСТОЙЧИВОМ порядке: иначе перестановка строк list.txt уводит продолжение.
Функция ПоВозрастанию(Знач Тело)

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Ключ");
	Таблица.Колонки.Добавить("Имя");
	Для Каждого СтрокаТела Из СтрРазделить(Тело, Символы.ПС, Ложь) Цикл
		Имя = СокрЛП(СтрЗаменить(СтрокаТела, Символы.ВК, ""));
		Если НЕ ЗначениеЗаполнено(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Запись = Таблица.Добавить();
		Запись.Ключ = НРег(Имя);
		Запись.Имя = Имя;
	КонецЦикла;
	Таблица.Сортировать("Ключ Возр");

	Имена = Новый Массив();
	Для Каждого Запись Из Таблица Цикл
		Имена.Добавить(Запись.Имя);
	КонецЦикла;
	Возврат Имена;

КонецФункции

// Пакет без перечня версий не теряется: за ним остаётся элемент latest.
Процедура ДобавитьПакет(Элементы, Знач Зеркало, Знач Имя)

	Перечень = ВерсииПакета(Зеркало, Имя);
	Если Перечень.Количество() = 0 Тогда
		Элементы.Добавить(Новый Структура("ИмяПакета, Версия, ПутьСкачивания, ВерсияИзвестна",
			Имя, "", СтрШаблон("%1/%1.ospx", Сегмент(Имя)), Ложь));
		Возврат;
	КонецЕсли;

	Для Каждого Версия Из Перечень Цикл
		Элементы.Добавить(Новый Структура("ИмяПакета, Версия, ПутьСкачивания, ВерсияИзвестна",
			Имя, Версия,
			СтрШаблон("%1/%1-%2.ospx", Сегмент(Имя), Сегмент(Версия)), Истина));
	КонецЦикла;

КонецПроцедуры

// Имя и версия едут сегментами пути, а не кусками строки: слеш и процент в чужом имени
// иначе увели бы скачивание на другой ресурс.
Функция Сегмент(Знач Значение)
	Возврат КодированиеURL.КодироватьСегментПути(Строка(Значение));
КонецФункции

// Сбой одной страницы не роняет перечисление остальных пакетов — пакет деградирует к latest.
Функция ВерсииПакета(Знач Зеркало, Знач Имя)

	Попытка
		Страница = Клиент.ПолучитьТекст(Корень.ПоАдресуВыдачи(Зеркало.АпстримURL),
			"package/" + Сегмент(Имя),
			"", Токен(Зеркало));
		Если Страница.Код <> 200 Тогда
			Возврат Новый Массив();
		КонецЕсли;
		Возврат Разбор.Версии(Страница.Тело, Имя);
	Исключение
		Возврат Новый Массив();
	КонецПопытки;

КонецФункции

Функция Токен(Знач Зеркало)
	Возврат Секрет.ИзИсточника(Зеркало);
КонецФункции

#КонецОбласти

&Прозвище("ИсточникАпстрима")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КлиентАпстрима") _Клиент,
	&Пластилин(Значение = "РазборВерсийПакета") _Разбор,
	&Пластилин(Значение = "СекретИсточника") _Секрет = Неопределено,
	&Пластилин(Значение = "КореньАпстрима") _Корень,
	&Пластилин(Значение = "ФильтрИмёнЗеркала") _Фильтр = Неопределено)
	Клиент = _Клиент;
	Разбор = _Разбор;
	Секрет = ?(_Секрет = Неопределено, Новый СекретИсточника(), _Секрет);
	Корень = _Корень;
	Фильтр = ?(_Фильтр = Неопределено, Новый ФильтрИмёнЗеркала(), _Фильтр);
КонецПроцедуры
