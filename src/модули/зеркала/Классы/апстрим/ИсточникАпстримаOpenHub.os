// Протокол зеркалируемого OpenHub (режим "api-v1"): порция имён берётся из среза изменений
// источника — одним запросом на цикл, вместе с версиями каждого имени.

Перем Клиент;  // КлиентАпстрима (прокси)
Перем Разбор;  // РазборСрезаИзменений (зеркала)
Перем Секрет;  // СекретИсточника (прокси) — токен доступа записи зеркала
Перем Корень;  // КореньАпстрима (зеркала) — срез живёт рядом с выдачей
Перем Фильтр;  // ФильтрИмёнЗеркала (зеркала) — маски имён из настройки зеркала

#Область ПубличныйИнтерфейс

// Режим, который обслуживает этот источник.
//
// Возвращаемое значение:
//  Строка - "api-v1".
//
Функция Режим() Экспорт
	Возврат "api-v1";
КонецФункции

// Перечисляет элементы синка очередной порции: по элементу на каждую изменившуюся версию
// каждого имени порции с учётом фильтра зеркала.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - конфигурация зеркала: АпстримURL, ФильтрJSON, момент инкремента
//            и момент среза текущего обхода.
//  РазмерПорции - Число - сколько ИМЁН берётся за цикл; версии отобранного имени
//                 перечисляются целиком.
//  Курсор - Строка - имя пакета, с которого продолжается обход (включительно);
//           пусто — начало нового обхода (необязательный, по умолчанию "").
//  Отметка - Произвольный - объект с методом Шаг(ИмяПакета): зовётся на каждом имени порции
//            (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - Код (Число, HTTP-код среза; 0 — источник недоступен, 502 — ответ срезом
//              не является),
//              Элементы (Массив из Структура: ИмяПакета, Версия, ПутьСкачивания,
//              ВерсияИзвестна),
//              ЕстьЕщё (Булево, за порцией остались имена), Курсор (Строка, имя для
//              следующего цикла; пусто — срез пройден), ИменВсего, ИменПройдено (Число,
//              шкала обхода), СрезС (Дата, момент, с которого спрошен срез; пустая —
//              обход полный), МоментСреза (Дата, момент, до которого источник вычитан
//              этим обходом).
//
Функция Перечислить(Знач Зеркало, Знач РазмерПорции, Знач Курсор = "", Знач Отметка = Неопределено) Экспорт

	Продолжение = ЗначениеЗаполнено(СокрЛП(Строка(Курсор)));
	СрезС = ?(Продолжение, МоментСрезаОбхода(Зеркало), ЗаведомоВычитаноДо(Зеркало));

	Результат = Клиент.ПолучитьТекст(Корень.ПоАдресуВыдачи(Зеркало.АпстримURL),
		АдресСреза(СрезС, Курсор, РазмерПорции), "", Токен(Зеркало));

	Ответ = Новый Структура(
		"Код, Элементы, ЕстьЕщё, Курсор, ИменВсего, ИменПройдено, СрезС, МоментСреза",
		Результат.Код, Новый Массив(), Ложь, "", 0, 0, СрезС, ПустойМомент());
	Если Результат.Код <> 200 Тогда
		Возврат Ответ; // 0 — offline, иное — среза нет
	КонецЕсли;

	Срез = Разбор.Разобрать(Результат.Тело);
	Если Срез = Неопределено Тогда
		// ответ не срезом — отказ перечисления, а не пустой срез: иначе битый ответ выглядел
		// бы как «ничего не изменилось» и двигал бы момент, до которого источник вычитан
		Ответ.Код = 502;
		Возврат Ответ;
	КонецЕсли;

	НаполнитьПорцию(Ответ, Зеркало, Срез, Отметка);
	Ответ.МоментСреза = ?(Продолжение И ЗначениеЗаполнено(МоментВычиткиОбхода(Зеркало)),
		МоментВычиткиОбхода(Зеркало), Срез.Снят);
	Возврат Ответ;

КонецФункции

// Скачивает .ospx элемента синка с источника.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - конфигурация зеркала.
//  Элемент - Структура - элемент синка с полем ПутьСкачивания.
//
// Возвращаемое значение:
//  Структура - Код (Число; 0 — источник недоступен), Данные (ДвоичныеДанные), ETag (Строка).
//
Функция Скачать(Знач Зеркало, Знач Элемент) Экспорт
	Возврат Клиент.СкачатьДанные(Зеркало.АпстримURL, Элемент.ПутьСкачивания, "", Токен(Зеркало));
КонецФункции

#КонецОбласти

#Область Порция

Процедура НаполнитьПорцию(Ответ, Знач Зеркало, Знач Срез, Знач Отметка)

	Маски = Фильтр.Маски(Зеркало.ФильтрJSON);

	Ответ.ЕстьЕщё = Срез.ЕстьЕщё;
	Ответ.Курсор = Срез.Курсор;
	// шкалу считает источник, и фильтра зеркала он не знает: у зеркала с фильтром доля
	// обхода остаётся неизвестной (ноль), а не врёт числом чужих имён
	Если НЕ Фильтр.Задан(Маски) Тогда
		Ответ.ИменВсего = Срез.ИменВсего;
		Ответ.ИменПройдено = Срез.ИменДо;
	КонецЕсли;

	Для Каждого Пакет Из Срез.Пакеты Цикл
		Если Фильтр.Пропускает(Маски, Пакет.ИмяПакета) Тогда
			ДобавитьВерсии(Ответ.Элементы, Пакет);
		КонецЕсли;
		Если Отметка <> Неопределено Тогда
			Отметка.Шаг(Пакет.ИмяПакета);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Версия среза известна до скачивания всегда: источник называет её сам.
Процедура ДобавитьВерсии(Элементы, Знач Пакет)

	Для Каждого Версия Из Пакет.Версии Цикл
		Элементы.Добавить(Новый Структура("ИмяПакета, Версия, ПутьСкачивания, ВерсияИзвестна",
			Пакет.ИмяПакета, Версия,
			СтрШаблон("%1/%1-%2.ospx", Пакет.ИмяПакета, Версия), Истина));
	КонецЦикла;

КонецПроцедуры

// Пустой момент означает полный срез: источник отдаёт весь свой состав.
Функция АдресСреза(Знач СрезС, Знач Курсор, Знач РазмерПорции)

	Параметры = Новый Массив();
	Если ЗначениеЗаполнено(СрезС) Тогда
		Параметры.Добавить("since=" + ВПараметр(XMLСтрока(СрезС)));
	КонецЕсли;
	Если ЗначениеЗаполнено(СокрЛП(Строка(Курсор))) Тогда
		Параметры.Добавить("cursor=" + ВПараметр(СокрЛП(Строка(Курсор))));
	КонецЕсли;
	Параметры.Добавить("limit=" + Формат(Макс(1, Цел(РазмерПорции)), "ЧГ=0"));

	Возврат "changes?" + СтрСоединить(Параметры, "&");

КонецФункции

#КонецОбласти

#Область ПоляЗаписиЗеркала

// Незаполненный момент означает «отсчитывать не от чего» — обход идёт полным.
Функция ЗаведомоВычитаноДо(Знач Зеркало)
	Возврат Дата_(Зеркало.ВычитаноДо);
КонецФункции

// Продолжение порции обязано смотреть на тот же срез, что и первая порция обхода.
Функция МоментСрезаОбхода(Знач Зеркало)
	Возврат Дата_(Зеркало.ПрогонСрезС);
КонецФункции

// Снят первой порцией и до конца обхода не пересматривается: иначе изменения между порциями пропадут.
Функция МоментВычиткиОбхода(Знач Зеркало)
	Возврат Дата_(Зеркало.ПрогонМоментСреза);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Токен(Знач Зеркало)
	Возврат Секрет.ИзИсточника(Зеркало);
КонецФункции

Функция Дата_(Знач Значение)
	Возврат ?(ТипЗнч(Значение) = Тип("Дата"), Значение, ПустойМомент());
КонецФункции

Функция ПустойМомент()
	Возврат '00010101000000';
КонецФункции

Функция ВПараметр(Знач Значение)
	Возврат КодироватьСтроку(Строка(Значение), СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти

&Прозвище("ИсточникАпстрима")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КлиентАпстрима") _Клиент,
	&Пластилин(Значение = "РазборСрезаИзменений") _Разбор = Неопределено,
	&Пластилин(Значение = "СекретИсточника") _Секрет = Неопределено,
	&Пластилин(Значение = "КореньАпстрима") _Корень,
	&Пластилин(Значение = "ФильтрИмёнЗеркала") _Фильтр = Неопределено)

	Клиент = _Клиент;
	Разбор = ?(_Разбор = Неопределено, Новый РазборСрезаИзменений(), _Разбор);
	Секрет = ?(_Секрет = Неопределено, Новый СекретИсточника(), _Секрет);
	Корень = _Корень;
	Фильтр = ?(_Фильтр = Неопределено, Новый ФильтрИмёнЗеркала(), _Фильтр);

КонецПроцедуры
