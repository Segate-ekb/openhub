// Фильтр имён зеркала: JSON-массив масок из настройки зеркала и вердикт по одному имени.
// Правило одно на все протоколы источников.

#Область ПубличныйИнтерфейс

// Маски фильтра зеркала.
//
// Параметры:
//  ФильтрJSON - Строка - JSON-массив масок имён; пустой пропускает всё.
//
// Возвращаемое значение:
//  Массив из Строка, Неопределено - маски; Неопределено — фильтр не разбирается
//   и не пропускает ничего (fail-closed).
//
Функция Маски(Знач ФильтрJSON) Экспорт

	Результат = Новый Массив();
	Если НЕ ЗначениеЗаполнено(ФильтрJSON) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(ФильтрJSON);
		Разобрано = ПрочитатьJSON(Чтение);
	Исключение
		Возврат Неопределено; // некорректный JSON — fail-closed
	КонецПопытки;

	Если ТипЗнч(Разобрано) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Маска Из Разобрано Цикл
		Результат.Добавить(НРег(СокрЛП(Строка(Маска))));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Задан ли фильтр: заданный сужает состав зеркала, и обход это учитывает.
//
// Параметры:
//  Маски - Массив из Строка, Неопределено - разобранные маски.
//
// Возвращаемое значение:
//  Булево - Ложь только у пустого списка масок, пропускающего всё.
//
Функция Задан(Знач Маски_) Экспорт
	Возврат Маски_ = Неопределено ИЛИ Маски_.Количество() > 0;
КонецФункции

// Пропускает ли фильтр имя апстрима. Регистр имени значения не имеет: имена пакетов
// хаб канонизирует нижним регистром.
//
// Параметры:
//  Маски - Массив из Строка, Неопределено - разобранные маски; пустой список пропускает
//          всё, Неопределено — ничего.
//  Имя - Строка - имя пакета у апстрима.
//
// Возвращаемое значение:
//  Булево.
//
Функция Пропускает(Знач Маски_, Знач Имя) Экспорт

	Если Маски_ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Маски_.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	ИмяНиж = НРег(Имя);
	Для Каждого Маска Из Маски_ Цикл
		Если Новый МаскаИмениПакета(Маска).Совпадает(ИмяНиж) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
