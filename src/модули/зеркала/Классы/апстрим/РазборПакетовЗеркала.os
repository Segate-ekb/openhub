// Разбор .ospx под ограничениями зеркала: проверка недоверенной загрузки перед сохранением
// и чтение манифеста артефакта, уже лежащего в хранилище.

#Использовать ospx-tools

Перем Хранилище;      // ХранилищеАртефактов (хранилище)
Перем ПределыПриёма;  // ПределыПриёмаПакета (публикация) — числа публикации, они же для зеркала
&Лог
Перем Лог;
Перем Ошибки;      // ТекстОшибки (основа)
Перем Уборка;         // ТихаяУборка (основа)

#Область ПубличныйИнтерфейс

// Кладёт скачанные байты во временный файл и проверяет их как недоверенный .ospx:
// разбор под ограничениями и непустые имя с версией в манифесте.
//
// Параметры:
//  Данные - ДвоичныеДанные - скачанные байты артефакта.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Манифест (МанифестПакета, Неопределено),
//              ТекстREADME (Строка, "" — README в пакете нет), ВременныйПуть (Строка);
//              при Успех = Ложь временный файл уже удалён.
//
Функция ПроверитьЗагрузку(Знач Данные) Экспорт

	Отказ = Новый Структура("Успех, Манифест, ТекстREADME, ВременныйПуть",
		Ложь, Неопределено, "", "");

	ВременныйПуть = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-mirror-" + Строка(Новый УникальныйИдентификатор) + ".ospx");
	Данные.Записать(ВременныйПуть);

	Лог.Отладка("Разбор зеркалируемого .ospx: %1 байт во временном файле", Данные.Размер());
	Попытка
		Пакет = ПакетыOspx.ПрочитатьПакет(ВременныйПуть, ПределыПриёма.ОграниченияРазбора());
		Манифест = Пакет.Манифест();
	Исключение
		Лог.Предупреждение("Зеркалируемый .ospx не прошёл валидацию (битый/зловредный) — не сохраняем: %1",
			Ошибки.Причина(ИнформацияОбОшибке()));
		УбратьВременный(ВременныйПуть);
		Возврат Отказ;
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(Манифест.Имя()) ИЛИ НЕ ЗначениеЗаполнено(Манифест.Версия()) Тогда
		Лог.Предупреждение("Зеркалируемый .ospx с пустым именем/версией в манифесте — не сохраняем");
		УбратьВременный(ВременныйПуть);
		Возврат Отказ;
	КонецЕсли;

	Лог.Отладка("Зеркалируемый .ospx разобран: манифест ""%1"" %2",
		Манифест.Имя(), Манифест.Версия());
	Возврат Новый Структура("Успех, Манифест, ТекстREADME, ВременныйПуть",
		Истина, Манифест, ?(Пакет.ЕстьREADME(), Пакет.ТекстREADME(), ""), ВременныйПуть);

КонецФункции

// Сведения об артефакте для индексации версии. Готовый манифест (вызывающий только что
// разобрал загрузку) хранилища не читает вовсе; sha в этом случае неизвестен — сумму
// считаем по тому файлу, что ЛЕЖИТ, а не по тому, что скачали: совпадать они не обязаны.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта в хранилище.
//  Манифест - МанифестПакета, Неопределено - уже разобранный манифест этого артефакта
//             (необязательный, по умолчанию Неопределено — прочитать хранимый).
//
// Возвращаемое значение:
//  Структура - Манифест (МанифестПакета, Неопределено), Sha256 (Строка),
//              ВерсияДвижка (Строка), АвторМанифеста (Строка); нечитаемый артефакт даёт
//              Неопределено и пустые строки.
//
Функция СведенияАртефакта(Знач Координаты, Знач Манифест = Неопределено) Экспорт

	Сведения = Новый Структура("Манифест, Sha256, ВерсияДвижка, АвторМанифеста",
		Манифест, "", "", "");

	Если Манифест = Неопределено Тогда
		ПрочитатьХранимое(Координаты, Сведения);
	КонецЕсли;

	Если Сведения.Манифест <> Неопределено Тогда
		Сведения.ВерсияДвижка = Сведения.Манифест.ВерсияДвижка();
		Сведения.АвторМанифеста = Сведения.Манифест.Автор();
	КонецЕсли;

	Возврат Сведения;

КонецФункции

// Удаляет временный файл загрузки. Идемпотентна и безопасна к пустому пути.
//
// Параметры:
//  Путь - Строка - путь к временному файлу.
//
Процедура УбратьВременный(Знач Путь) Экспорт
	Уборка.УдалитьФайл(Путь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет манифест и sha по хранимому файлу; нечитаемый артефакт оставляет сведения пустыми.
Процедура ПрочитатьХранимое(Знач Координаты, Сведения)

	Путь = "";
	Попытка
		Путь = Хранилище.Получить(Координаты);
		Сведения.Манифест = ПакетыOspx.ПрочитатьМанифестПакета(Путь, ПределыПриёма.ОграниченияРазбора());
		Сведения.Sha256 = Sha256Файла(Путь);
	Исключение
		Лог.Предупреждение("Хранимый .ospx не прочитан — метаданные версии остаются как есть: %1",
			Ошибки.Причина(ИнформацияОбОшибке()));
	КонецПопытки;

	ОсвободитьВыдачу(Путь);

КонецПроцедуры

Функция Sha256Файла(Знач Путь)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.ДобавитьФайл(Путь);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции

Процедура ОсвободитьВыдачу(Знач Путь)
	Попытка
		Если ЗначениеЗаполнено(Путь) Тогда
			Хранилище.ОсвободитьВыдачу(Путь);
		КонецЕсли;
	Исключение
		// временную копию хранилища не отдали — исходный итог чтения важнее
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

// Параметр _Лог — второй вход для прямого создания через `Новый` вне контейнера ОСени:
// инъекция в поле до таких объектов не доезжает.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеАртефактов") _Хранилище,
	&Пластилин(Значение = "ПределыПриёмаПакета") _ПределыПриёма,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Пластилин(Значение = "ТихаяУборка") _Уборка = Неопределено)

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Уборка = ?(_Уборка = Неопределено, Новый ТихаяУборка(), _Уборка);
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Хранилище = _Хранилище;
	ПределыПриёма = _ПределыПриёма;

КонецПроцедуры
