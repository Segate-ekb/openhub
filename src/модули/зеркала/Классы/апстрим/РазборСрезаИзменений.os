// Разбор ответа среза изменений OpenHub: имена пакетов с изменившимися версиями, шкала
// обхода, курсор следующей порции и момент снятия среза. Нетерпим к форме, терпим к составу.

#Область ПубличныйИнтерфейс

// Разбирает тело ответа среза изменений.
//
// Параметры:
//  Тело - Строка - JSON-ответ адреса среза изменений.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если тело не разбирается как объект JSON.
//   Поля: Снят (Дата, момент снятия среза; пустая — источник его не назвал),
//   Пакеты (Массив из Структура: ИмяПакета, Версии — Массив из Строка),
//   ИменВсего, ИменДо (Число, шкала обхода), ЕстьЕщё (Булево), Курсор (Строка).
//
Функция Разобрать(Знач Тело) Экспорт

	Разобрано = ПрочитатьОбъект(Тело);
	Если Разобрано = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура("Снят, Пакеты, ИменВсего, ИменДо, ЕстьЕщё, Курсор",
		Момент(Разобрано.Получить("as_of")), Новый Массив(),
		Целое(Разобрано.Получить("names_total")), Целое(Разобрано.Получить("names_before")),
		Разобрано.Получить("has_more") = Истина, Текст(Разобрано.Получить("next_cursor")));

	НаполнитьПакеты(Результат.Пакеты, Разобрано.Получить("changes"));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Версии одного имени собираются в одну запись: порция считает ИМЕНА.
Процедура НаполнитьПакеты(Пакеты, Знач Изменения)

	Если ТипЗнч(Изменения) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	ПоИмени = Новый Соответствие();
	Для Каждого Изменение Из Изменения Цикл

		Имя = ИмяПакета(Изменение);
		Версия = СтрокаВерсии(Изменение);
		Если НЕ ЗначениеЗаполнено(Имя) ИЛИ НЕ ЗначениеЗаполнено(Версия) Тогда
			Продолжить; // запись без имени либо без версии переносить нечем
		КонецЕсли;

		Запись = ПоИмени.Получить(НРег(Имя));
		Если Запись = Неопределено Тогда
			Запись = Новый Структура("ИмяПакета, Версии", Имя, Новый Массив());
			ПоИмени.Вставить(НРег(Имя), Запись);
			Пакеты.Добавить(Запись);
		КонецЕсли;
		Если Запись.Версии.Найти(Версия) = Неопределено Тогда
			Запись.Версии.Добавить(Версия);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция ИмяПакета(Знач Изменение)

	Если ТипЗнч(Изменение) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Возврат Текст(Изменение.Получить("package"));

КонецФункции

// Строка версии живёт в форме версии — той же, что отдают карточка пакета и /versions.
Функция СтрокаВерсии(Знач Изменение)

	Если ТипЗнч(Изменение) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Версия = Изменение.Получить("version");
	Если ТипЗнч(Версия) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Возврат Текст(Версия.Получить("version"));

КонецФункции

Функция ПрочитатьОбъект(Знач Тело)

	Если НЕ ЗначениеЗаполнено(Тело) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(Строка(Тело));
		// в Соответствие, а не в Структуру: ключи чужого ответа идентификаторами BSL быть
		// не обязаны, и разбор в структуру падал бы на первом же неудобном имени
		Разобрано = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат ?(ТипЗнч(Разобрано) = Тип("Соответствие"), Разобрано, Неопределено);

КонецФункции

// Строку вида ISO-8601 ПрочитатьJSON превращает в Дату сам, поэтому дата разбирается отдельно.
Функция Момент(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;

	Текст_ = Текст(Значение);
	Если НЕ ЗначениеЗаполнено(Текст_) Тогда
		Возврат '00010101000000';
	КонецЕсли;

	Попытка
		Возврат XMLЗначение(Тип("Дата"), Текст_);
	Исключение
		Возврат '00010101000000';
	КонецПопытки;

КонецФункции

Функция Целое(Знач Значение)

	Попытка
		Возврат Макс(0, Цел(Число(?(Значение = Неопределено, 0, Значение))));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

Функция Текст(Знач Значение)
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
