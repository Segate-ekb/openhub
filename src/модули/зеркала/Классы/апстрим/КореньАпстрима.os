// Корень чужого хаба по адресу его выдачи. Соседи выдачи — страница пакета у легаси-хаба
// и срез изменений у OpenHub — живут рядом с ней, а не в корне сайта: у хаба на подпути
// ("/api/v1/pools/{pool}/download/") корень сайта не отдаёт ни того, ни другого.

#Область ПубличныйИнтерфейс

// Корень хаба, рядом с которым лежат соседи выдачи.
//
// Параметры:
//  АпстримURL - Строка - базовый URL выдачи апстрима.
//
// Возвращаемое значение:
//  Строка - адрес без хвостового сегмента выдачи; адрес не по контракту opm
//           возвращается как есть.
//
Функция ПоАдресуВыдачи(Знач АпстримURL) Экспорт

	Адрес = БезХвостовыхСлешей(СокрЛП(Строка(АпстримURL)));
	// адрес без пути отсекается здесь, поэтому "/download" в имени хоста сегментом не станет
	Если ПозицияПути(Адрес) = 0 Тогда
		Возврат Адрес;
	КонецЕсли;

	Сегмент = "/download";
	Хвост = СтрДлина(Адрес) - СтрДлина(Сегмент) + 1;
	// база не по контракту opm: не гадаем, спрашиваем соседа относительно неё самой
	Если НРег(Сред(Адрес, Хвост)) <> Сегмент Тогда
		Возврат Адрес;
	КонецЕсли;
	Возврат Лев(Адрес, Хвост - 1);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ноль, если пути нет вовсе: "/download" в имени хоста сегментом выдачи не считается.
Функция ПозицияПути(Знач Адрес)

	Позиция = СтрНайти(Адрес, "://");
	НачалоХоста = ?(Позиция > 0, Позиция + 3, 1);
	Слеш = СтрНайти(Сред(Адрес, НачалоХоста), "/");
	Возврат ?(Слеш = 0, 0, НачалоХоста + Слеш - 1);

КонецФункции

Функция БезХвостовыхСлешей(Знач Адрес)

	Результат = Адрес;
	Пока СтрЗаканчиваетсяНа(Результат, "/") Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
