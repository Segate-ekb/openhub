// Задача планировщика «здоровье-источников»: регулярная проверка живости источников пулов
// и зеркал.

Перем Обход;     // ОбходЗдоровьяИсточников
Перем Интервал;  // интервал обхода из настройки, секунды

// Регистрация в планировщике: обход раз в интервал из настройки.
//
// Параметры:
//  Регистрации - РегистрацииЗадачи - куда записывается регистрация.
//
Процедура Зарегистрировать(Регистрации) Экспорт
	Регистрации.КаждыеСекунд("здоровье-источников", Интервал);
КонецПроцедуры

// Выполняет один обход источников.
// Сбой обхода перебрасывается планировщику.
//
&Наблюдаемый("job.upstream_health")
Процедура Исполнить() Экспорт
	Обход.Обойти();
КонецПроцедуры

&Прозвище("ЗадачаПланировщика")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОбходЗдоровьяИсточников") _Обход,
	&Деталька(Значение = "oshub.jobs.upstream_health_interval_sec", ЗначениеПоУмолчанию = 60) _Интервал = Неопределено)

	Обход = _Обход;
	Интервал = Новый ПриведениеЧисел().ЧислоИлиДефолт(_Интервал, 60);

КонецПроцедуры
