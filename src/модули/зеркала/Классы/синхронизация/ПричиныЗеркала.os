// Причины, по которым текущий обход зеркала не привёз версии: происшествия подсистемы «зеркало».
// Бросает на лежащей базе: пустой список обязан означать «всё привезено».

Перем Читатель;  // ЧитательПроисшествий (происшествия)
Перем Объекты;   // ОбъектыПроисшествий (происшествия)
Перем Коды;      // КодыПроисшествийЗеркала (зеркала)
Перем Прогон;    // ПрогонЗеркала (зеркала) — метка обхода

// Причины текущего обхода, последние сверху. Своего потолка у выдачи нет: число строк
// на объект держит сама летопись, и лишнее она уже свела в одну строку «прочее».
//
// Параметры:
//  Зеркало - ЗеркалоХаба - прочитанная запись зеркала.
//
// Возвращаемое значение:
//  Массив из Структура - Подсистема, Объект, Предмет, Код, Причина, Количество,
//                        Впервые, Последний, Прогон, Устранимо.
//
Функция Обхода(Знач Зеркало) Экспорт

	Возврат Читатель.ПроисшествияОбъекта(Коды.Подсистема(),
		Объекты.Зеркало(Зеркало.Идентификатор), Прогон.МеткаОбхода(Зеркало));

КонецФункции

&Прозвище("ПричиныЗеркала")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЧитательПроисшествий") _Читатель,
	&Пластилин(Значение = "ОбъектыПроисшествий") _Объекты,
	&Пластилин(Значение = "КодыПроисшествийЗеркала") _Коды,
	&Пластилин(Значение = "ПрогонЗеркала") _Прогон)

	Читатель = _Читатель;
	Объекты = _Объекты;
	Коды = _Коды;
	Прогон = _Прогон;

КонецПроцедуры
