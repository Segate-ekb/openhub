// Причины, по которым обход зеркала не привёз версии: помехи подсистемы «зеркало»
// по объекту зеркала, отобранные меткой ТЕКУЩЕГО обхода.
//
// ⚠ БРОСАЕТ: лежащая база даёт ошибку, а не пустую выдачу. Пустой список обязан означать
// «всё привезено» — иначе экран врёт ровно тогда, когда он нужнее всего, и решать,
// что показать вместо причин, приходится самому экрану.

Перем Читатель;  // ЧитательПомех (помехи)
Перем Объекты;   // ОбъектыПомех (помехи)
Перем Коды;      // КодыПомех (помехи)
Перем Прогон;    // ПрогонЗеркала (зеркала) — метка обхода

// Причины текущего обхода, последние сверху. Своего потолка у выдачи нет: число строк
// на объект держит сама летопись, и лишнее она уже свела в одну строку «прочее».
//
// Параметры:
//  Зеркало - ЗеркалоХаба - прочитанная запись зеркала.
//
// Возвращаемое значение:
//  Массив из Структура - Подсистема, Объект, Предмет, Код, Причина, Количество,
//                        Впервые, Последний, Прогон, Устранимо.
//
Функция Обхода(Знач Зеркало) Экспорт

	Возврат Читатель.ПомехиОбъекта(Коды.ПодсистемаЗеркало(),
		Объекты.Зеркало(Зеркало.Идентификатор), Прогон.МеткаОбхода(Зеркало));

КонецФункции

&Прозвище("ПричиныЗеркала")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЧитательПомех") _Читатель,
	&Пластилин(Значение = "ОбъектыПомех") _Объекты,
	&Пластилин(Значение = "КодыПомех") _Коды,
	&Пластилин(Значение = "ПрогонЗеркала") _Прогон)

	Читатель = _Читатель;
	Объекты = _Объекты;
	Коды = _Коды;
	Прогон = _Прогон;

КонецПроцедуры
