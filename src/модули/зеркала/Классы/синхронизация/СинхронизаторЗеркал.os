// Движок плановой репликации: перечисляет очередную порцию пакетов апстрима начиная
// с курсора, переносит её ПереносомЭлементаСинка и пишет прогресс по ходу цикла.
//
// Обход, закончившийся ничем, называет причину не только в статусе: каждый ранний выход
// и каждый сорвавшийся пакет оставляют происшествие, которое читает экран зеркала.

#Использовать errors

Перем СервисЗеркал;    // СервисЗеркал (зеркала)
Перем СервисПулов;     // СервисПулов (реестр)
Перем Перенос;         // ПереносЭлементаСинка (зеркала)
Перем Прогон;          // ПрогонЗеркала (зеркала)
Перем След;            // СледЦиклаЗеркала (зеркала) — спан цикла и событие о законченном обходе
Перем Валидатор;       // ВалидаторАдресаАпстрима (зеркала) — форма адреса
Перем Страж;           // СтражАпстримов (прокси) — память о том, жив ли источник
Перем ИсточникиПоПротоколу; // Соответствие: протокол -> ИсточникАпстрима
Перем Канон;           // РазборНастроекЗеркала (зеркала) — имена протоколов и порядок проб
Перем Числа;           // ПриведениеЧисел (основа)
Перем Ошибки;      // ТекстОшибки (основа)
Перем ЧислаЗеркал;     // ЧислаЗеркалирования (зеркала) — порция, циклы и период из настроек хаба
Перем Срез;            // СрезОбхода (зеркала) — моменты обхода и его способ
Перем Происшествия;    // ПроисшествияЗеркала (зеркала) — почему обход не привёз версию
Перем Коды;            // КодыПроисшествий (происшествия) — машинные коды причин
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// ⛔ ВЫЗЫВАТЬ ИЗ БОЕВОГО КОДА НЕЛЬЗЯ: подвешивание этого метода к эндпоинту, планировщику
// или второй рогатке ломает инвариант «один прогон на зеркало». Он гоняет обход ПРЯМО
// в потоке вызывающего, минуя ОчередьСинхронизацииЗеркал, а Занять() рассчитан на то, что
// его зовёт единственный потребитель очереди (РабочийСинхронизацииЗеркал, один поток).
// На этом же держится отказ от «пола» порога зависания: два параллельных Занять() сделали бы
// объявление живого прогона брошенным опасным, а не просто шумным.
// На эту же однопоточность опирается память уровней журнала в ПроисшествияЗеркала («первая
// причина с этим кодом в обходе»): она живёт в памяти процесса и замка не имеет.
// Нужен новый вход в синхронизацию — ставьте заявку в очередь, как это делают кнопка,
// API и ЗадачаСинхронизацииЗеркал.
//
// Синхронизирует зеркала, которым подошёл срок по их собственному ИнтервалуСинкаСек.
// Каждое зеркало обрабатывается в изоляции: сбой одного не роняет остальные; обход апстрима
// идёт порциями, пока в списке остаются непройденные имена.
//
// Возвращаемое значение:
//  Число - количество синхронизированных зеркал.
//
Функция СинхронизироватьВсе() Экспорт

	Обработано = 0;
	Для Каждого Зеркало Из СервисЗеркал.ВключённыеЗеркала() Цикл
		Попытка
			Если ПораСинхронизировать(Зеркало) Тогда
				ПрогнатьОбход(Зеркало);
				Обработано = Обработано + 1;
			КонецЕсли;
		Исключение
			Лог.Ошибка("Сбой синхронизации зеркала #%1 (изолирован): %2",
				Зеркало.Идентификатор, Ошибки.Причина(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	Возврат Обработано;

КонецФункции

// Прогоняет ОДИН цикл синхронизации зеркала: порцию имён начиная с курсора. Наружу не
// бросает: итог возвращается и пишется в состояние прогона зеркала. Пока цикл идёт,
// второй запуск того же зеркала отклоняется.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - конфигурация синхронизируемого зеркала.
//  Запустил - Строка - идентификатор пользователя, запустившего синк руками;
//             пусто — плановый запуск (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Всего (Число, перечислено элементов), Скачано (Число, новых версий),
//              Пропущено (Число: уже было, не прошло фильтр либо битое), Ошибок (Число),
//              Offline (Булево, апстрим был недоступен), Недоступно (Число, элементов
//              без ответа апстрима), ЕстьЕщё (Булево, в списке апстрима остались
//              непройденные имена), Курсор (Строка, имя для следующего цикла),
//              Статус (Строка, человекочитаемый итог), ИмёнВсего (Число, имён у апстрима
//              после фильтра), ИмёнПройдено (Число, имён, пройденных обходом),
//              СрезС (Дата, момент, с которого источник спрошен об изменениях; пустая —
//              обход полный), МоментСреза (Дата, момент, до которого источник вычитан
//              этим обходом), Протокол (Строка, протокол, которым источник ответил на
//              перечисление; пустая строка — не ответил ни одним).
//
Функция Синхронизировать(Знач Зеркало, Знач Запустил = "") Экспорт

	Итог = НовыйИтог();
	Лог.Отладка("Зеркало #%1: цикл синхронизации запрошен (%2), порог молчания %3 с",
		Зеркало.Идентификатор,
		?(ЗначениеЗаполнено(Запустил), "инициатор " + Запустил, "по расписанию"),
		Прогон.ПорогЗависания());
	Захват = Прогон.Занять(Зеркало.Идентификатор, Запустил);
	Если НЕ Захват.Занят Тогда
		Итог.Статус = ?(Захват.Причина = "идёт",
			"синхронизация этого зеркала уже идёт — повторный запуск пропущен",
			"зеркало не найдено — синк пропущен");
		// Отказ захвата раньше был нем: заявка пропадала, а в журнале не появлялось
		// ни строки — снаружи это выглядело как «кнопка ничего не делает».
		Лог.Предупреждение("Зеркало #%1: %2", Зеркало.Идентификатор, Итог.Статус);
		Возврат Итог;
	КонецЕсли;

	// цикл работает с записью, какой она стала ПОСЛЕ захвата: курсор и моменты обхода пишет
	// прогон, и копия, прочитанная до захвата, их уже не знает
	Захваченное = ЗахваченнаяЗапись(Зеркало, Захват);
	Итог.Курсор = Захват.Курсор;
	// метка обхода у всех его порций одна, поэтому объявление безвредно повторяется
	// на каждом цикле и сносит только причины ПРОШЛЫХ обходов
	Происшествия.НачатьОбход(Захваченное);
	Спан = След.НачатьСпан(Захваченное);
	Сбой = Ложь;
	Попытка
		ВыполнитьСинхронизацию(Захваченное, Итог, Захват.Курсор);
	Исключение
		Сбой = Истина;
		Отказ = ИнформацияОбОшибке();
		// в статус, который читает оператор на экране зеркала, служебные координаты кадра
		// не едут; полная причина с местом возникновения остаётся журналу
		Итог.Статус = "ошибка синхронизации: " + Ошибки.ДляЧеловека(Отказ);
		Лог.Ошибка("Синхронизация зеркала #%1: %2", Захваченное.Идентификатор,
			Ошибки.Причина(Отказ));
	КонецПопытки;

	След.ЗавершитьСпан(Спан, Сбой);
	ЗафиксироватьИтог(Захваченное, Итог, Сбой);
	ОбъявитьИтогЦикла(Захваченное, Итог);
	Лог.Отладка("Зеркало #%1: цикл закончен — %2; имён пройдено %3 из %4, курсор ""%5""",
		Захваченное.Идентификатор, Итог.Статус, Итог.ИмёнПройдено, Итог.ИмёнВсего, Итог.Курсор);
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Цикл синка — такой же честный запрос, как и выдача: его исход пополняет общую память о живости.
Процедура ЗапомнитьЖивость(Знач Зеркало, Знач Код)

	Если Страж = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Цел(Код) = 0 Тогда
		Страж.ОтметитьЛежащим(Зеркало.АпстримURL, "источник не ответил на перечисление пакетов");
	Иначе
		Страж.ОтметитьЖивым(Зеркало.АпстримURL);
	КонецЕсли;

КонецПроцедуры

// Шкала считает ИМЕНА апстрима, а не версии, и потому монотонна.
Функция НовыйИтог()
	Возврат Новый Структура(
		"Всего, Скачано, Пропущено, Ошибок, Offline, Недоступно, ЕстьЕщё, Курсор, Статус,"
			+ " ИмёнВсего, ИмёнПройдено, СрезС, МоментСреза, Протокол",
		0, 0, 0, 0, Ложь, 0, Ложь, "", "", 0, 0, '00010101000000', '00010101000000', "");
КонецФункции

// Захват перечитывает запись и возвращает; не назвал — цикл идёт по пришедшей параметром.
Функция ЗахваченнаяЗапись(Знач Зеркало, Знач Захват)

	// без Перем присваивание уйдёт в ПОЛЕ объекта, общее на процесс
	Перем Запись;

	Запись = Неопределено;
	Захват.Свойство("Запись", Запись);
	Возврат ?(Запись = Неопределено, Зеркало, Запись);

КонецФункции

// Способ обхода называет ИСТОЧНИК: не умеющий инкремента протокол моментов не приносит.
Процедура ЗапомнитьСрез(Знач Зеркало, Итог, Знач Перечень)

	Моменты = Срез.Прочитать(Перечень);
	Итог.СрезС = Моменты.СрезС;
	Итог.МоментСреза = Моменты.МоментСреза;

	// оператору, который смотрит «почему зеркало опять идёт полным», нужен именно момент:
	// секретов в нём нет, а без него причина не видна ниоткуда
	Лог.Отладка("Зеркало #%1: обход %2, изменения спрошены с %3",
		Зеркало.Идентификатор, Срез.ПоМоменту(Итог.СрезС),
		?(ЗначениеЗаполнено(Итог.СрезС), Срез.Печатью(Итог.СрезС), "начала списка источника"));

КонецПроцедуры

// Плановый прогон крутит циклы сам, но не бесконечно: иначе обход растянется на тики расписания.
Процедура ПрогнатьОбход(Знач Зеркало)
	Циклов = 0;
	Пока Циклов < ЧислаЗеркал.ЦикловЗаПрогон() Цикл
		Итог = Синхронизировать(Зеркало);
		Циклов = Циклов + 1;
		Если НЕ (Итог.ЕстьЕщё = Истина) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Интервала не ждёт одно состояние — «поставлено»; оборванный обход своего интервала ЖДЁТ.
Функция ПораСинхронизировать(Знач Зеркало)

	Состояние = Прогон.Состояние(Зеркало.Идентификатор);
	Если Состояние <> Неопределено И Состояние.Состояние = Прогон.Состояния().Поставлено Тогда
		Возврат Истина;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Зеркало.ПоследнийСинк) Тогда
		Возврат Истина;
	КонецЕсли;

	Интервал = Макс(1, Цел(Числа.ЧислоИлиДефолт(Зеркало.ИнтервалСинкаСек,
		ЧислаЗеркал.ИнтервалПоУмолчанию())));
	Молчит = ТекущаяУниверсальнаяДата() - Зеркало.ПоследнийСинк;
	Лог.Отладка("Зеркало #%1: с прошлого синка %2 с при интервале %3 с — %4",
		Зеркало.Идентификатор, Молчит, Интервал, ?(Молчит >= Интервал, "пора", "рано"));
	Возврат Молчит >= Интервал;

КонецФункции

Процедура ВыполнитьСинхронизацию(Знач Зеркало, Итог, Знач Курсор)

	ПулНазн = СервисПулов.ПулПоИдентификатору(Зеркало.ПулНазначенияИдентификатор);
	Если ПулНазн = Неопределено Тогда
		// прежде этот выход был нем целиком: ни строки в журнале, ни следа на экране,
		// и обход выглядел завершённым с нулём
		Итог.Статус = "пул назначения не найден";
		ОбъяснитьРаннийВыход(Зеркало, Коды.ПулНазначенияНеНайден(),
			"Пул назначения не найден: складывать привезённое некуда");
		Возврат;
	КонецЕсли;

	Вердикт = Валидатор.Проверить(Зеркало.АпстримURL);
	Если НЕ Вердикт.Успех Тогда
		Итог.Статус = "адрес апстрима не разбирается: " + Вердикт.Сообщение;
		ОбъяснитьРаннийВыход(Зеркало, Коды.АдресНеРазбирается(),
			"Адрес апстрима не разбирается: " + Вердикт.Сообщение);
		Возврат;
	КонецЕсли;

	// в лежачий источник не ходит и зеркало: пока он числится упавшим, цикл не платит
	// за него ни одного таймаута
	Если Страж <> Неопределено И НЕ Страж.Допустим(Зеркало) Тогда
		Итог.Offline = Истина;
		Итог.Статус = "источник числится лежащим: " + Страж.ПричинаОтказа(Зеркало);
		ОбъяснитьРаннийВыход(Зеркало, Коды.ИсточникЧислитсяЛежащим(),
			"Источник числится лежащим, обход отложен: " + Страж.ПричинаОтказа(Зеркало));
		Возврат;
	КонецЕсли;

	Лог.Отладка("Зеркало #%1: перечисляю порцию в %2 имён с курсора ""%3"" (%4)",
		Зеркало.Идентификатор, ЧислаЗеркал.РазмерПорции(), Курсор, Зеркало.АпстримURL);

	Проба = ОпроситьИсточники(Зеркало, Курсор,
		Новый ОтметкаПеречисления(Прогон, Зеркало.Идентификатор, Итог, Курсор));
	Перечень = Проба.Перечень;
	// способ обхода запоминается до разбора кода: он верен и у цикла, которому источник
	// не ответил, и без него экран показывал бы «полный обход» на инкрементном зеркале
	ЗапомнитьСрез(Зеркало, Итог, Перечень);
	ЗапомнитьЖивость(Зеркало, Перечень.Код);
	Если Проба.Источник = Неопределено И Перечень.Код = 0 Тогда
		Итог.Offline = Истина;
		Итог.Статус = "апстрим недоступен (offline) — синк отложен до следующего цикла";
		ОбъяснитьРаннийВыход(Зеркало, Коды.ИсточникНеОтветил(),
			СтрШаблон("Источник не ответил на перечисление пакетов — обход отложен,"
				+ " курсор остаётся на ""%1""", Курсор));
		Возврат; // курсор не двигаем: порция не перечислена
	КонецЕсли;
	Если Проба.Источник = Неопределено Тогда
		// источник отвечает, но ни одним известным протоколом: прогон закрывается ОШИБКОЙ
		// с названной причиной. Прежде такой цикл закрывался «завершён» с нулём, и угаданный
		// человеком протокол решал, приедут пакеты или нет
		Происшествия.Записать(Зеркало, "", Коды.ПротоколНеОпределён(), Проба.Причина);
		ВызватьИсключение Проба.Причина;
	КонецЕсли;

	Итог.Протокол = Проба.Протокол;
	ОбъяснитьДеградации(Зеркало, Перечень);
	Итог.Всего = Перечень.Элементы.Количество();
	Итог.ЕстьЕщё = (Перечень.ЕстьЕщё = Истина);
	Итог.ИмёнВсего = Перечень.ИменВсего;
	Итог.ИмёнПройдено = Перечень.ИменПройдено;
	Лог.Отладка("Зеркало #%1: порция дала %2 элементов синка; имён у апстрима %3,"
		+ " пройдено до этой порции %4, есть ещё: %5",
		Зеркало.Идентификатор, Итог.Всего,
		Перечень.ИменВсего, Перечень.ИменПройдено, Итог.ЕстьЕщё);
	ОбойтиПорцию(Зеркало, ПулНазн, Проба.Источник, Перечень.Элементы, Итог);
	// курсор двигается ПОСЛЕ порции: сорвись обход на середине — продолжим с недойденного
	Если НЕ Итог.Offline Тогда
		Итог.Курсор = Строка(Перечень.Курсор);
	КонецЕсли;

	Итог.Статус = СтрШаблон("%1: всего %2, скачано %3, пропущено %4, ошибок %5%6",
		?(Итог.Offline, "апстрим отвалился на середине порции", "синк ок"),
		Итог.Всего, Итог.Скачано, Итог.Пропущено, Итог.Ошибок,
		?(Итог.ЕстьЕщё, СтрШаблон("; обход продолжится с ""%1""", Итог.Курсор),
			?(Итог.Offline, СтрШаблон("; обход продолжится с ""%1"" в следующем цикле", Итог.Курсор), "")));

КонецПроцедуры

// Прогресс пишется по ходу порции; отвалившийся апстрим её обрывает, курсор остаётся на месте.
Процедура ОбойтиПорцию(Знач Зеркало, Знач ПулНазн, Знач Источник, Знач Элементы, Итог)

	ТекущийПакет = Итог.Курсор;
	ПредыдущийПакет = "";
	Для Каждого Элемент Из Элементы Цикл
		ТекущийПакет = СокрЛП(Строка(Элемент.ИмяПакета));
		// имя считается пройденным, когда обход ушёл со следующего на него элемента:
		// шкала двигается только на ЗАКОНЧЕННОМ имени и потому не едет назад
		Если ЗначениеЗаполнено(ПредыдущийПакет) И ПредыдущийПакет <> ТекущийПакет Тогда
			Итог.ИмёнПройдено = Итог.ИмёнПройдено + 1;
		КонецЕсли;
		ПредыдущийПакет = ТекущийПакет;
		Попытка
			Исход = Перенос.Перенести(Зеркало, ПулНазн, Источник, Элемент);
			УчестьИсход(Итог, Исход);
		Исключение
			Итог.Ошибок = Итог.Ошибок + 1;
			ОбъяснитьСбойПакета(Зеркало, Элемент, ИнформацияОбОшибке());
		КонецПопытки;
		Прогон.Отметить(Зеркало.Идентификатор, Итог, ТекущийПакет);
		Если Итог.Offline Тогда
			Итог.ЕстьЕщё = Ложь;
			Итог.Курсор = ТекущийПакет;
			Возврат; // недоделанное имя пройденным не считается
		КонецЕсли;
	КонецЦикла;

	// порция дошла до конца — последнее её имя тоже пройдено
	Если ЗначениеЗаполнено(ПредыдущийПакет) Тогда
		Итог.ИмёнПройдено = Итог.ИмёнПройдено + 1;
	КонецЕсли;

КонецПроцедуры

// Одна строка уровня хаба на цикл вместо строки на каждую невзятую версию: числа здесь,
// подробности — на экране зеркала. Цикл, которому нечего объяснять, молчит и тут.
Процедура ОбъявитьИтогЦикла(Знач Зеркало, Знач Итог)

	Если Итог.Пропущено = 0 И Итог.Ошибок = 0 Тогда
		Возврат;
	КонецЕсли;

	Лог.Информация("Зеркало #%1: за цикл пропущено %2, ошибок %3; разных причин за обход: %4"
		+ " — причины на экране зеркала", Зеркало.Идентификатор, Итог.Пропущено, Итог.Ошибок,
		Происшествия.ЧислоПричинОбхода(Зеркало));

КонецПроцедуры

// Ранний выход обхода: предмета у него нет — не взят весь обход, а не отдельная версия.
// Уровень ПРЕДУПРЕЖДЕНИЕ без оговорок: такая строка бывает одна на цикл, топить журнал
// ей нечем — в отличие от причин отдельных версий.
Процедура ОбъяснитьРаннийВыход(Знач Зеркало, Знач Код, Знач Причина)

	Лог.Предупреждение("Зеркало #%1: %2 — обход не начат", Зеркало.Идентификатор, Причина);
	Происшествия.Записать(Зеркало, "", Код, Причина);

КонецПроцедуры

// Сбой одного пакета изолирован: обход идёт дальше, а причина остаётся и в журнале,
// и на экране зеркала. Уровень ПРЕДУПРЕЖДЕНИЕ без оговорок: сбой — это не штатный отказ
// правила, и молчать о нём на уровне хаба нельзя даже при повторе.
Процедура ОбъяснитьСбойПакета(Знач Зеркало, Знач Элемент, Знач Отказ)

	Предмет = Происшествия.Предмет(Элемент.ИмяПакета, Элемент.Версия);
	Лог.Предупреждение("Зеркало #%1: сбой пакета ""%2"" (изолирован): %3",
		Зеркало.Идентификатор, Предмет, Ошибки.Причина(Отказ));
	Происшествия.Записать(Зеркало, Предмет, КодСбояПакета(Отказ), Ошибки.ДляЧеловека(Отказ));

КонецПроцедуры

// Причина отдельного пакета: ПЕРВАЯ с этим кодом в обходе — новость уровня хаба, повторы —
// подробность отладки. Иначе перенос с сотнями одинаковых отказов топит журнал контейнера.
Процедура Объяснить(Знач Зеркало, Знач Предмет, Знач Код, Знач Причина)

	Если Происшествия.ПервоеВОбходе(Зеркало, Код) Тогда
		Лог.Предупреждение("Зеркало #%1: ""%2"" — %3", Зеркало.Идентификатор, Предмет, Причина);
	Иначе
		Лог.Отладка("Зеркало #%1: ""%2"" — %3", Зеркало.Идентификатор, Предмет, Причина);
	КонецЕсли;
	Происшествия.Записать(Зеркало, Предмет, Код, Причина);

КонецПроцедуры

// Сбой называет себя МАШИННЫМ КОДОМ, а не текстом сообщения. Конфликтом его зовёт приём
// версии: реестр отказывает правилом — занятый тегом номер, занятое имя пакета,
// неизменяемая версия, — и перенос пересобирает такой отказ конфликтом операции.
// Хранилище артефактов свои отказы кодирует само. Всё прочее остаётся сбоем переноса:
// приписывать ему знакомую причину значило бы соврать оператору.
Функция КодСбояПакета(Знач Отказ)

	Код = Ошибки.МашинныйКод(Отказ);
	Если Код = КодыСтандартныхОшибок.КонфликтОперации()
		ИЛИ Код = КодыСтандартныхОшибок.РесурсУжеСуществует() Тогда
		Возврат Коды.КонфликтВерсии();
	КонецЕсли;
	Если Код = КодыСтандартныхОшибок.ЗависимостьНедоступна()
		ИЛИ Код = КодыСтандартныхОшибок.РесурсНеНайден() Тогда
		Возврат Коды.ХранилищеНеПриняло();
	КонецЕсли;
	Возврат Коды.СбойПереноса();

КонецФункции

// «Не взято» держит момент вычитки, «источник молчит» обрывает порцию: качать дальше нечем.
// «Пропущено» считает ТОЛЬКО то, что не приехало и имеет причину: второй обход по расписанию
// иначе превращал бы всё привезённое в «пропущено», и счётчик спорил бы со списком причин.
Процедура УчестьИсход(Итог, Знач Исход)

	Если Исход.Скачано = Истина Тогда
		Итог.Скачано = Итог.Скачано + 1;
		Возврат;
	КонецЕсли;

	// «Пропущено» ШИРЕ списка причин: сюда же попадает то, что везти было нечего — версия
	// уже в пуле либо у источника не менялась (ПереносЭлементаСинка.БезРаботы). Своим числом
	// это не живёт: колонки под него нет, а завести её нечем — схему строит авто-DDL,
	// ALTER TABLE он не делает. Поэтому счётчик объясняет себя подписью на экране
	Итог.Пропущено = Итог.Пропущено + 1;
	Если Исход.Недоступно = Истина Тогда
		Итог.Недоступно = Итог.Недоступно + 1;
	КонецЕсли;
	Если Исход.ИсточникМолчит = Истина Тогда
		Итог.Offline = Истина;
	КонецЕсли;

КонецПроцедуры

// Пакеты, перечень версий которых источник не отдал: приедет только последняя, остальные
// обход не увидит. Легаси-протокол деградировал так МОЛЧА — мимо счётчиков и журнала.
Процедура ОбъяснитьДеградации(Знач Зеркало, Знач Перечень)

	Перем Деградации;  // местная намеренно: Свойство() пишет по ссылке

	Деградации = Неопределено;
	Если НЕ Перечень.Свойство("Деградации", Деградации) ИЛИ Деградации = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Деградация Из Деградации Цикл
		Объяснить(Зеркало, Происшествия.Предмет(Деградация.ИмяПакета),
			Коды.ПереченьВерсийНеПолучен(),
			СтрШаблон("Перечень версий получить не удалось — взята только последняя: %1",
				Деградация.Причина));
	КонецЦикла;

КонецПроцедуры

// Событие уходит на ЗАКРЫТЫЙ обход: запись на каждую порцию топила бы журнал.
Процедура ЗафиксироватьИтог(Знач Зеркало, Знач Итог, Знач Сбой)

	// без Перем присваивание уйдёт в ПОЛЕ объекта, общее на процесс
	Перем ИтогОбхода;

	Момент = ТекущаяУниверсальнаяДата();
	Попытка
		ИтогОбхода = Прогон.Завершить(Зеркало.Идентификатор, Итог, Итог.Курсор, Момент, Сбой);
	Исключение
		// Итог уже в результате, но НЕЗАКРЫТАЯ запись оставляет зеркало помеченным идущим:
		// заявки будут отбиваться до подбора на старте либо до молчания дольше порога.
		Лог.Ошибка("Зеркало #%1: итог цикла не записан, прогон остался помечен идущим"
			+ " и сам не закроется: %2",
			Зеркало.Идентификатор, Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат; // обход не закрыт — объявлять нечего
	КонецПопытки;

	Если ИтогОбхода <> Неопределено И ИтогОбхода.ОбходЗакрыт Тогда
		След.ОбъявитьЗавершениеОбхода(Зеркало, ИтогОбхода, Момент);
	КонецЕсли;

КонецПроцедуры

Функция ПостроитьКартуИсточников(Знач Источники)
	Карта = Новый Соответствие();
	Если Источники <> Неопределено Тогда
		Для Каждого Источник Из Источники Цикл
			Карта.Вставить(Канон.Протокол(Источник.Протокол()), Источник);
		КонецЦикла;
	КонецЕсли;
	Возврат Карта;
КонецФункции

// Протокол источника хаб определяет САМ и на каждом обходе: сначала срез изменений, не вышло —
// легаси-список. Перечисление и есть проба: ответивший протокол уже принёс порцию.
//
// Возвращает Структуру: Источник (ИсточникАпстрима либо Неопределено, если не ответил никто),
// Протокол (Строка), Перечень (ответ, по которому цикл решает, что делать дальше),
// Причина (Строка, заполнена, когда ни один протокол не ответил).
Функция ОпроситьИсточники(Знач Зеркало, Знач Курсор, Знач Отметка)

	Отказы = Новый Массив();

	Для Каждого Протокол Из Канон.ПорядокПроб() Цикл
		Источник = ИсточникиПоПротоколу.Получить(Протокол);
		Если Источник = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Перечень = Источник.Перечислить(Зеркало, ЧислаЗеркал.РазмерПорции(), Курсор, Отметка);
		Лог.Отладка("Зеркало #%1: проба протокола %2 ответила кодом %3",
			Зеркало.Идентификатор, Протокол, Перечень.Код);
		Если Перечень.Код = 200 Тогда
			Возврат Новый Структура("Источник, Протокол, Перечень, Причина",
				Источник, Протокол, Перечень, "");
		КонецЕсли;
		Отказы.Добавить(Новый Структура("Протокол, Перечень", Протокол, Перечень));
	КонецЦикла;

	Если Отказы.Количество() = 0 Тогда
		// собранный без протоколов движок молчал бы так же, как лежащий источник, и зеркало
		// ждало бы вечно: такую сборку называем прямо
		ВызватьИсключение "движок синхронизации собран без протоколов чтения источника";
	КонецЕсли;

	Возврат Новый Структура("Источник, Протокол, Перечень, Причина",
		Неопределено, "", ОтветОтказа(Отказы), ПричинаОтказа(Отказы));

КонецФункции

// Молчание источника важнее кода следующей пробы: лежащий источник цикл откладывает, а не
// закрывает ошибкой — лежать он может и минуту. Не молчал никто — берётся ПОСЛЕДНИЙ отказ:
// по нему цикл видит, что источник отвечает, и закрывает прогон ошибкой с причиной.
Функция ОтветОтказа(Знач Отказы)

	Для Каждого Отказ Из Отказы Цикл
		Если Отказ.Перечень.Код = 0 Тогда
			Возврат Отказ.Перечень;
		КонецЕсли;
	КонецЦикла;
	Возврат Отказы[Отказы.ВГраница()].Перечень;

КонецФункции

// Причина называет каждую пробу с её кодом: без кодов «источник не отвечает» не говорит,
// чем именно он не ответил.
Функция ПричинаОтказа(Знач Отказы)

	// «Коды» — ПОЛЕ этого класса (словарь машинных кодов), и без Перем список проб
	// затёр бы его на первом же отказе. Имя здесь другое именно поэтому
	Перем Пробы;

	Пробы = Новый Массив();
	Для Каждого Отказ Из Отказы Цикл
		Пробы.Добавить(СтрШаблон("%1 — код %2", Отказ.Протокол, Отказ.Перечень.Код));
	КонецЦикла;
	Возврат "источник не отвечает ни срезом изменений, ни списком пакетов ("
		+ СтрСоединить(Пробы, "; ") + ")";

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ПереносЭлементаСинка") _Перенос,
	&Пластилин(Значение = "ПрогонЗеркала") _Прогон,
	&Пластилин(Значение = "СледЦиклаЗеркала") _След,
	&Пластилин(Значение = "ВалидаторАдресаАпстрима") _Валидатор,
	&Пластилин(Значение = "СтражАпстримов", Тип = "Массив") _Страж,
	&Пластилин(Значение = "ИсточникАпстрима", Тип = "Массив") _Источники,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "ЧислаЗеркалирования") _ЧислаЗеркал,
	&Пластилин(Значение = "РазборНастроекЗеркала") _Канон,
	&Пластилин(Значение = "ПроисшествияЗеркала") _Происшествия,
	&Пластилин(Значение = "КодыПроисшествий") _Коды,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "СрезОбхода") _Срез = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	СервисЗеркал = _СервисЗеркал;
	СервисПулов = _СервисПулов;
	Перенос = _Перенос;
	Прогон = _Прогон;
	След = _След;
	Валидатор = _Валидатор;
	// без модуля прокси (юнит-наборы зеркала) память о живости недоступна — синк идёт как прежде
	Страж = ?(_Страж = Неопределено ИЛИ _Страж.Количество() = 0, Неопределено, _Страж[0]);
	Числа = _Числа;
	ЧислаЗеркал = _ЧислаЗеркал;
	Канон = _Канон;
	Происшествия = _Происшествия;
	Коды = _Коды;
	Срез = ?(_Срез = Неопределено, Новый СрезОбхода(), _Срез);
	ИсточникиПоПротоколу = ПостроитьКартуИсточников(_Источники);

КонецПроцедуры
