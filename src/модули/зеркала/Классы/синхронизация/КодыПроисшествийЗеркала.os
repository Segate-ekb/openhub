// Машинные коды происшествий планового зеркалирования хаб↔хаб и признак «пройдёт само
// следующим обходом».

Перем Коды;  // ОбъявленияКодовПроисшествий (происшествия)

#Область ПубличныйИнтерфейс

// Имя подсистемы зеркалирования.
//
// Возвращаемое значение:
//  Строка.
//
Функция Подсистема() Экспорт
	Возврат Коды.Подсистема();
КонецФункции

// Объявления кодов подсистемы в порядке объявления.
//
// Возвращаемое значение:
//  ОбъявленияКодовПроисшествий - имя подсистемы и её коды.
//
Функция Объявления() Экспорт
	Возврат Коды;
КонецФункции

// Имя пакета у апстрима не проходит правила именования хаба.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяНеПоПравилам() Экспорт
	Возврат Коды.Объявленный("mirror_name_rejected");
КонецФункции

// Адрес апстрима не разбирается: собрать ссылку на артефакт нечем.
//
// Возвращаемое значение:
//  Строка.
//
Функция АдресНеРазбирается() Экспорт
	Возврат Коды.Объявленный("mirror_url_unparsable");
КонецФункции

// Источник не ответил: сеть, таймаут, отказ соединения.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсточникНеОтветил() Экспорт
	Возврат Коды.Объявленный("mirror_upstream_unreachable");
КонецФункции

// Источник ответил отказом; код ответа называет причина, а не код происшествия —
// иначе на одно зеркало пришлось бы по записи на каждый HTTP-статус.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсточникОтветилОтказом() Экспорт
	Возврат Коды.Объявленный("mirror_upstream_rejected");
КонецФункции

// Источник ответил без тела: качать нечего.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПустоеТело() Экспорт
	Возврат Коды.Объявленный("mirror_empty_body");
КонецФункции

// Пакет больше предела приёма инсталляции.
//
// Возвращаемое значение:
//  Строка.
//
Функция БольшеПределаПриёма() Экспорт
	Возврат Коды.Объявленный("mirror_too_large");
КонецФункции

// Привезённый архив не разбирается как пакет OneScript.
//
// Возвращаемое значение:
//  Строка.
//
Функция АрхивНеРазбирается() Экспорт
	Возврат Коды.Объявленный("mirror_archive_unreadable");
КонецФункции

// Версия не годится сегментом пути: из неё не собрать ключ в хранилище.
//
// Возвращаемое значение:
//  Строка.
//
Функция ВерсияНеГоднаПутём() Экспорт
	Возврат Коды.Объявленный("mirror_version_unsafe");
КонецФункции

// Пул назначения не принял пакет по квоте.
//
// Возвращаемое значение:
//  Строка.
//
Функция КвотаПула() Экспорт
	Возврат Коды.Объявленный("mirror_pool_quota");
КонецФункции

// Конфликт с тем, что уже лежит: занятая версия, чужой резерв, запрет перезаписи.
//
// Возвращаемое значение:
//  Строка.
//
Функция КонфликтВерсии() Экспорт
	Возврат Коды.Объявленный("mirror_version_conflict");
КонецФункции

// Хранилище артефактов пакет не приняло.
//
// Возвращаемое значение:
//  Строка.
//
Функция ХранилищеНеПриняло() Экспорт
	Возврат Коды.Объявленный("mirror_storage_rejected");
КонецФункции

// Артефакт лёг, а реестр о нём не узнал: запись версии сорвалась.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИндексНеОбновился() Экспорт
	Возврат Коды.Объявленный("mirror_index_failed");
КонецФункции

// Пула назначения больше нет: обход не начинается вовсе.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПулНазначенияНеНайден() Экспорт
	Возврат Коды.Объявленный("mirror_pool_missing");
КонецФункции

// Источник числится лежащим: проба живости его уже отвергла.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсточникЧислитсяЛежащим() Экспорт
	Возврат Коды.Объявленный("mirror_upstream_down");
КонецФункции

// Источник не ответил ни одним протоколом чтения — читать его нечем.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПротоколНеОпределён() Экспорт
	Возврат Коды.Объявленный("mirror_protocol_unknown");
КонецФункции

// Перенос пакета сорвался, и отказ не назвал себя ни конфликтом, ни хранилищем:
// причину читает человек в самом происшествии.
//
// Возвращаемое значение:
//  Строка.
//
Функция СбойПереноса() Экспорт
	Возврат Коды.Объявленный("mirror_transfer_failed");
КонецФункции

// Перечень версий пакета источник не отдал: приедет только последняя, остальные
// обход не увидит вовсе.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПереченьВерсийНеПолучен() Экспорт
	Возврат Коды.Объявленный("mirror_versions_unlisted");
КонецФункции

#КонецОбласти

&Прозвище("КодыПроисшествийПодсистемы")
&Порядок(10)
&Желудь
Процедура ПриСозданииОбъекта() Экспорт

	Коды = Новый ОбъявленияКодовПроисшествий("зеркало");

	// устранимо то, что зависит от чужой стороны и от места в пуле; неустранимо то,
	// что решено самим пакетом, адресом либо отсутствием пула назначения
	Коды.Объявить("mirror_name_rejected", Ложь);
	Коды.Объявить("mirror_url_unparsable", Ложь);
	Коды.Объявить("mirror_upstream_unreachable", Истина);
	Коды.Объявить("mirror_upstream_rejected", Истина);
	Коды.Объявить("mirror_empty_body", Истина);
	Коды.Объявить("mirror_too_large", Ложь);
	Коды.Объявить("mirror_archive_unreadable", Ложь);
	Коды.Объявить("mirror_version_unsafe", Ложь);
	Коды.Объявить("mirror_pool_quota", Истина);
	Коды.Объявить("mirror_version_conflict", Ложь);
	Коды.Объявить("mirror_storage_rejected", Истина);
	Коды.Объявить("mirror_index_failed", Истина);
	Коды.Объявить("mirror_pool_missing", Ложь);
	Коды.Объявить("mirror_upstream_down", Истина);
	Коды.Объявить("mirror_protocol_unknown", Истина);
	// сорвавшийся перенос не разложен по известным причинам: обещать «пройдёт само» не на чем
	Коды.ОбъявитьНеясным("mirror_transfer_failed");
	// перечень версий зависит от чужой стороны: ответит страница пакета — приедут все
	Коды.Объявить("mirror_versions_unlisted", Истина);

КонецПроцедуры
