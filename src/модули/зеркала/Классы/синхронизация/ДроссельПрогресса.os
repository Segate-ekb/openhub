// Дроссель записи прогресса зеркала: как часто прогону разрешено ходить в базу.
// Считает раздельно по зеркалам — соседние обходы друг друга не сбивают.

Перем КаждыхЭлементов; // Число - писать не чаще, чем раз в столько элементов
Перем КаждыхСекунд;    // Число - ... либо раз в столько секунд, что наступит раньше
Перем Состояния_;      // Соответствие: ид зеркала -> Структура(Момент, Элементов)
Перем Числа;           // ПриведениеЧисел (основа)

#Область ПубличныйИнтерфейс

// Пора ли писать прогресс зеркала. Каждый вызов считается за один пройденный элемент.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//  Момент - Дата - текущий момент в UTC.
//
// Возвращаемое значение:
//  Булево - Истина, если запись разрешена.
//
Функция ПораПисать(Знач Идентификатор, Знач Момент) Экспорт

	Состояние_ = Состояния_.Получить(Ключ(Идентификатор));
	Если Состояние_ = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Состояние_.Элементов = Состояние_.Элементов + 1;
	Возврат Состояние_.Элементов >= КаждыхЭлементов
		ИЛИ (Момент - Состояние_.Момент) >= КаждыхСекунд;

КонецФункции

// Отмечает, что прогресс зеркала только что записан: отсчёт начинается заново.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//  Момент - Дата - момент записи в UTC.
//
Процедура Сбросить(Знач Идентификатор, Знач Момент) Экспорт
	Состояния_.Вставить(Ключ(Идентификатор), Новый Структура("Момент, Элементов", Момент, 0));
КонецПроцедуры

// Задаёт темп записи — тестовый шов; в рабочем контейнере не вызывается.
//
// Параметры:
//  Элементов - Число - писать не чаще, чем раз в столько элементов.
//  Секунд - Число - ... либо раз в столько секунд, что наступит раньше.
//
Процедура УстановитьТемп(Знач Элементов, Знач Секунд) Экспорт
	КаждыхЭлементов = Макс(1, Числа.ЧислоИлиДефолт(Элементов, 10));
	КаждыхСекунд = Макс(1, Числа.ЧислоИлиДефолт(Секунд, 2));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Ключ(Знач Идентификатор)
	Возврат Цел(Числа.ЧислоИлиНоль(Идентификатор));
КонецФункции

#КонецОбласти

&Прозвище("ДроссельПрогресса")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПриведениеЧисел") _Числа)

	Числа = _Числа;
	КаждыхЭлементов = 10;
	КаждыхСекунд = 2;
	Состояния_ = Новый Соответствие();

КонецПроцедуры
