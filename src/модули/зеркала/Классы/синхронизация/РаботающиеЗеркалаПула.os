// Зеркало, которое сейчас наполняет пул, — реализация контракта ЗеркалаПула: пул под
// работающим прогоном реестр не удаляет.

Перем ХранилищеЗеркал;  // ХранилищеЗеркалХабов (зеркала)
Перем ПрогонЗеркала;    // ПрогонЗеркала (зеркала) — идёт ли прогон записи, стоит ли в очереди

// Адрес источника зеркала, которое сейчас наполняет пул: его прогон идёт либо стоит в очереди.
//
// Параметры:
//  Пул - Пул - проверяемый пул.
//
// Возвращаемое значение:
//  Строка - адрес источника занявшего пул зеркала; пустая строка — пул не занят.
//
Функция АдресЗанявшегоЗеркала(Знач Пул) Экспорт

	Для Каждого Зеркало Из ХранилищеЗеркал.ПолучитьПоПулНазначенияИдентификаторРавно(
		Цел(Пул.Идентификатор)) Цикл
		Если ЗеркалоЗанято(Зеркало) Тогда
			Возврат Зеркало.АпстримURL;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// «В работе» — и «идёт», и «поставлено»; брошенный прогон зеркало не держит.
Функция ЗеркалоЗанято(Знач Зеркало)

	Если ПрогонЗеркала.ИдётПоЗаписи(Зеркало) Тогда
		Возврат Истина;
	КонецЕсли;

	СостояниеЗеркала = ПрогонЗеркала.СостояниеПоЗаписи(Зеркало);
	Возврат СостояниеЗеркала <> Неопределено
		И СостояниеЗеркала.Состояние = ПрогонЗеркала.Состояния().Поставлено
		И НЕ ПрогонЗеркала.ЗаписьБрошена(Зеркало);

КонецФункции

&Прозвище("ЗеркалаПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеЗеркалХабов") _ХранилищеЗеркал,
	&Пластилин(Значение = "ПрогонЗеркала") _Прогон)

	ХранилищеЗеркал = _ХранилищеЗеркал;
	ПрогонЗеркала = _Прогон;

КонецПроцедуры
