// Снимок пула назначения на одну порцию обхода: какие версии порции проиндексированы
// в реестре и какие артефакты пула лежат в хранилище по его описи.

Перем Проиндексированные;  // Соответствие: ключ версии -> Истина
Перем Лежащие;             // Соответствие: ключ артефакта -> Истина
Перем ОписьЕсть;           // Булево - снята ли опись хранилища

#Область ПубличныйИнтерфейс

// Проиндексирована ли версия в реестре пула на момент снятия снимка.
//
// Параметры:
//  ИмяПакета - Строка - имя пакета у источника.
//  Версия - Строка - строка версии.
//
// Возвращаемое значение:
//  Булево.
//
Функция ВерсияПроиндексирована(Знач ИмяПакета, Знач Версия) Экспорт
	Возврат Проиндексированные.Получить(КлючВерсии(ИмяПакета, Версия)) = Истина;
КонецФункции

// Лежит ли артефакт в хранилище по описи пула. Без снятой описи ответ «нет» ничего
// не значит — сначала спросите ОписьСнята().
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта.
//
// Возвращаемое значение:
//  Булево.
//
Функция АртефактЛежит(Знач Координаты) Экспорт
	Возврат Лежащие.Получить(КлючАртефакта(Координаты.Пакет(), Координаты.ИмяФайла())) = Истина;
КонецФункции

// Снята ли опись хранилища. Ложь означает «про байты снимок не знает».
//
// Возвращаемое значение:
//  Булево.
//
Функция ОписьСнята() Экспорт
	Возврат ОписьЕсть;
КонецФункции

// Кладёт версию в снимок. Зовёт только тот, кто снимок снимает.
//
// Параметры:
//  ИмяПакета - Строка - имя пакета.
//  Версия - Строка - строка версии.
//
Процедура ЗапомнитьВерсию(Знач ИмяПакета, Знач Версия) Экспорт
	Проиндексированные.Вставить(КлючВерсии(ИмяПакета, Версия), Истина);
КонецПроцедуры

// Ключ артефакта описи — одно правило на снимок и на того, кто опись собирает.
// Регистр не сворачивается: имя объекта в хранилище регистрозависимо.
//
// Параметры:
//  ИмяПакета - Строка - имя пакета.
//  ИмяФайла - Строка - имя файла артефакта.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючАртефакта(Знач ИмяПакета, Знач ИмяФайла) Экспорт
	Возврат СокрЛП(Строка(ИмяПакета)) + "/" + СокрЛП(Строка(ИмяФайла));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Имя пакета реестр сравнивает без регистра, версию — точно.
Функция КлючВерсии(Знач ИмяПакета, Знач Версия)
	Возврат НРег(СокрЛП(Строка(ИмяПакета))) + "@" + СокрЛП(Строка(Версия));
КонецФункции

#КонецОбласти

// Опись приходит готовой картой: её снимают раз на обход и делят между порциями.
// Неопределено — опись не снята.
Процедура ПриСозданииОбъекта(Знач ЛежащиеАртефакты = Неопределено)
	Проиндексированные = Новый Соответствие();
	ОписьЕсть = (ЛежащиеАртефакты <> Неопределено);
	Лежащие = ?(ОписьЕсть, ЛежащиеАртефакты, Новый Соответствие());
КонецПроцедуры
