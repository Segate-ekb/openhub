// Состояние прогона синхронизации зеркала: захват прогона (не более одного на зеркало),
// курсор обхода, дросселированная запись прогресса по ходу цикла и завершение с итогом.

Перем ХранилищеЗеркал;   // ХранилищеЗеркалХабов (данные)
Перем Числа;             // ПриведениеЧисел (основа)
Перем ЧислаЗеркал;       // ЧислаЗеркалирования (зеркала) — порог молчания из настроек хаба
Перем Дроссель;          // ДроссельПрогресса (зеркала) - как часто разрешено писать прогресс
Перем Счётчики;          // СчётчикиОбхода (зеркала) — перенос накопленного и запись итога
Перем Срез;              // СрезОбхода (зеркала) — моменты обхода и его способ
Перем Часы;              // Объект с методом Сейчас() -> Дата, либо Неопределено (системные часы)

#Область ПубличныйИнтерфейс

// Состояния прогона: единственный источник истины для движка, очереди и экранов.
//
// Возвращаемое значение:
//  Структура - Простаивает, Поставлено, Идёт, Завершён, Ошибка (Строка).
//
Функция Состояния() Экспорт
	Возврат Новый Структура("Простаивает, Поставлено, Идёт, Завершён, Ошибка",
		"простаивает", "поставлено", "идёт", "завершён", "ошибка");
КонецФункции

// Подставляет источник времени — тестовый шов; в рабочем контейнере не вызывается.
//
// Параметры:
//  ИсточникВремени - Произвольный - объект с методом Сейчас(), возвращающим Дату.
//
Процедура УстановитьЧасы(Знач ИсточникВремени) Экспорт
	Часы = ИсточникВремени;
КонецПроцедуры

// Через сколько секунд молчания прогон считается брошенным — ровно столько, сколько задано
// в настройках хаба. Спрашивают все, кто держит зеркало занятым: порог обязан быть один,
// иначе запись и память рабочего отпускают зеркало в разные моменты.
//
// Возвращаемое значение:
//  Число - секунды.
//
Функция ПорогЗависания() Экспорт
	Возврат ЧислаЗеркал.ПорогЗависания();
КонецФункции

// Ведёт ли прогон зеркала кто-то прямо сейчас — по ЗАПИСИ, а не по памяти процесса.
// Спрашивает очередь: захват отказывает такому зеркалу, и без этой проверки заявка
// принималась бы, чтобы молча пропасть у рабочего.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//
// Возвращаемое значение:
//  Булево - Истина, если прогон числится идущим и не брошен.
//
Функция Идёт(Знач Идентификатор) Экспорт
	Возврат ИдётПоЗаписи(Запись(Идентификатор));
КонецФункции

// То же по УЖЕ ПРОЧИТАННОЙ записи — вопрос списков: второе чтение на каждое зеркало
// превращает страницу в N+1 запрос к базе.
//
// Параметры:
//  Зеркало - ЗеркалоХаба, Неопределено - прочитанная запись зеркала.
//
// Возвращаемое значение:
//  Булево - Истина, если прогон числится идущим и не брошен.
//
Функция ИдётПоЗаписи(Знач Зеркало) Экспорт

	Если Зеркало = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ТекущееСостояние(Зеркало) = Состояния().Идёт И НЕ Брошен(Зеркало);

КонецФункции

// Брошен ли прогон УЖЕ ПРОЧИТАННОЙ записи: занятое состояние есть, а отметок прогресса
// дольше порога нет. Спрашивают экраны — по записи в руках, без второго чтения базы.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - прочитанная запись зеркала.
//
// Возвращаемое значение:
//  Булево - Истина, если прогон числится занятым и молчит дольше порога.
//
Функция ЗаписьБрошена(Знач Зеркало) Экспорт

	Если Зеркало = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Текущее = ТекущееСостояние(Зеркало);
	Если Текущее <> Состояния().Идёт И Текущее <> Состояния().Поставлено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Брошен(Зеркало);

КонецФункции

// Состояние прогона зеркала.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если зеркала нет. Поля: Состояние (Строка),
//   Идёт (Булево, состояние "идёт" и прогон не брошен), Начат, Обновлён (Дата),
//   Всего, Скачано, Пропущено, Ошибок, Недоступно, ИмёнВсего, ИмёнПройдено (Число),
//   Курсор, Запустил, Статус (Строка), ПоследнийСинк (Дата), Способ (Строка из Способы()),
//   СрезС (Дата, момент, с которого спрошены изменения; пустая — обход полный),
//   ВычитаноДо (Дата, момент, до которого источник заведомо вычитан).
//
Функция Состояние(Знач Идентификатор) Экспорт
	Возврат СостояниеПоЗаписи(Запись(Идентификатор));
КонецФункции

// То же состояние по УЖЕ ПРОЧИТАННОЙ записи: списки держат её в руках, и второе чтение
// на каждое зеркало превращало страницу в N+1 запрос к базе.
//
// Параметры:
//  Зеркало - ЗеркалоХаба, Неопределено - прочитанная запись зеркала.
//
// Возвращаемое значение:
//  Структура, Неопределено - те же поля, что у Состояние().
//
Функция СостояниеПоЗаписи(Знач Зеркало) Экспорт

	Если Зеркало = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("Состояние", ТекущееСостояние(Зеркало));
	Результат.Вставить("Идёт", ТекущееСостояние(Зеркало) = Состояния().Идёт И НЕ Брошен(Зеркало));
	Результат.Вставить("Начат", Зеркало.ПрогонНачат);
	Результат.Вставить("Обновлён", Зеркало.ПрогонОбновлён);
	Результат.Вставить("Всего", Числа.ЦелаяЧасть(Зеркало.ПрогонВсего));
	Результат.Вставить("Скачано", Числа.ЦелаяЧасть(Зеркало.ПрогонСкачано));
	Результат.Вставить("Пропущено", Числа.ЦелаяЧасть(Зеркало.ПрогонПропущено));
	Результат.Вставить("Ошибок", Числа.ЦелаяЧасть(Зеркало.ПрогонОшибок));
	Результат.Вставить("Недоступно", Числа.ЦелаяЧасть(Зеркало.ПрогонНедоступно));
	Результат.Вставить("ИмёнВсего", Числа.ЦелаяЧасть(Зеркало.ПрогонИмёнВсего));
	Результат.Вставить("ИмёнПройдено", Числа.ЦелаяЧасть(Зеркало.ПрогонИмёнПройдено));
	Результат.Вставить("Курсор", ТекстЗначения(Зеркало.ПрогонКурсор));
	Результат.Вставить("Запустил", ТекстЗначения(Зеркало.ПрогонЗапустил));
	Результат.Вставить("Статус", ТекстЗначения(Зеркало.Статус));
	Результат.Вставить("ПоследнийСинк", Зеркало.ПоследнийСинк);
	Результат.Вставить("Способ", Срез.ПоМоменту(Зеркало.ПрогонСрезС));
	Результат.Вставить("СрезС", Зеркало.ПрогонСрезС);
	Результат.Вставить("ВычитаноДо", Зеркало.ВычитаноДо);
	Возврат Результат;

КонецФункции

// Ставит прогон в очередь: экран обязан показать «поставлено» сразу по нажатию кнопки,
// не дожидаясь первого цикла движка. Идущий либо уже поставленный прогон второй раз
// не ставится — это защита от «кнопка + расписание одновременно», и живой прогон
// заявка не затирает. Счётчики и курсор прошлого прогона не трогаются: они ещё
// показываются как последний результат.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//  Запустил - Строка - идентификатор пользователя; пусто — плановый запуск
//             (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Булево - Истина, если прогон поставлен этим вызовом.
//
Функция Поставить(Знач Идентификатор, Знач Запустил = "") Экспорт

	Зеркало = Запись(Идентификатор);
	Если Зеркало = Неопределено ИЛИ Занят(Зеркало) Тогда
		Возврат Ложь;
	КонецЕсли;

	Момент = Сейчас();
	Зеркало.СостояниеПрогона = Состояния().Поставлено;
	Зеркало.ПрогонЗапустил = ТекстЗначения(Запустил);
	Зеркало.ПрогонОбновлён = Момент;
	Зеркало.Обновлён = Момент;
	Зеркало.Сохранить();
	Возврат Истина;

КонецФункции

// Захватывает прогон зеркала под текущий цикл: инвариант «не более одного прогона на
// зеркало» держится здесь, а не ограничением базы. Брошенный прогон (молчит дольше порога)
// перехватывается — иначе умерший процесс запер бы зеркало навсегда.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//  Запустил - Строка - идентификатор пользователя; пусто сохраняет того, кто поставил
//             прогон в очередь (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Занят (Булево), Курсор (Строка, имя пакета для продолжения обхода),
//              Причина (Строка: "" | "идёт" | "нет записи"),
//              Запись (ЗеркалоХаба, Неопределено) — запись зеркала, какой она стала после
//              захвата: моменты обхода и курсор в ней свежие, и цикл работает с ней,
//              а не с копией, прочитанной до захвата.
//
Функция Занять(Знач Идентификатор, Знач Запустил = "") Экспорт

	Ответ = Новый Структура("Занят, Курсор, Причина, Запись", Ложь, "", "нет записи", Неопределено);
	Зеркало = Запись(Идентификатор);
	Если Зеркало = Неопределено Тогда
		Возврат Ответ;
	КонецЕсли;
	Если ТекущееСостояние(Зеркало) = Состояния().Идёт И НЕ Брошен(Зеркало) Тогда
		Ответ.Причина = "идёт";
		Возврат Ответ;
	КонецЕсли;

	Момент = Сейчас();
	Курсор = ТекстЗначения(Зеркало.ПрогонКурсор);
	Продолжение = ЗначениеЗаполнено(Курсор);
	Инициатор = ИнициаторПрогона(Зеркало, Запустил);
	Зеркало.СостояниеПрогона = Состояния().Идёт;
	// начало и счётчики — ОБХОДА, а не цикла: пользователь смотрит на прогон целиком,
	// поэтому продолжение с курсора не сбрасывает ни отсчёт времени, ни числа
	Если НЕ Продолжение ИЛИ НЕ ЗначениеЗаполнено(Зеркало.ПрогонНачат) Тогда
		Зеркало.ПрогонНачат = Момент;
	КонецЕсли;
	Если НЕ Продолжение Тогда
		Счётчики.Обнулить(Зеркало);
		// новый обход — новый срез: моменты прошлого обхода не должны выдавать себя за его
		Зеркало.ПрогонСрезС = ПустойМомент();
		Зеркало.ПрогонМоментСреза = ПустойМомент();
	КонецЕсли;
	Зеркало.ПрогонЗапустил = Инициатор;
	Зеркало.ПрогонОбновлён = Момент;
	Зеркало.Обновлён = Момент;
	Зеркало.Сохранить();

	Счётчики.Запомнить(Идентификатор, Зеркало);
	Дроссель.Сбросить(Идентификатор, Момент);
	Ответ.Занят = Истина;
	Ответ.Курсор = Курсор;
	Ответ.Причина = "";
	Ответ.Запись = Зеркало;
	Возврат Ответ;

КонецФункции

// Отмечает прогресс идущего цикла; частоту записи решает ДроссельПрогресса.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//  Итог - Структура - накопленный итог цикла (Всего, Скачано, Пропущено, Ошибок, Недоступно).
//  Курсор - Строка - имя пакета, с которого продолжить обход при обрыве.
//
Процедура Отметить(Знач Идентификатор, Знач Итог, Знач Курсор) Экспорт

	Момент = Сейчас();
	Если НЕ Дроссель.ПораПисать(Идентификатор, Момент) Тогда
		Возврат;
	КонецЕсли;
	Зеркало = Запись(Идентификатор);
	Если Зеркало = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Счётчики.Записать(Зеркало, Итог, Идентификатор);
	ЗаписатьМоментыОбхода(Зеркало, Итог);
	Зеркало.ПрогонКурсор = ТекстЗначения(Курсор);
	Зеркало.ПрогонОбновлён = Момент;
	Зеркало.Обновлён = Момент;
	Зеркало.Сохранить();
	Дроссель.Сбросить(Идентификатор, Момент);

КонецПроцедуры

// Завершает прогон: итоговые счётчики, курсор следующего цикла и человекочитаемый статус.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//  Итог - Структура - итог цикла (Всего, Скачано, Пропущено, Ошибок, Недоступно, ЕстьЕщё,
//         Статус). Источник, умеющий инкремент, добавляет к нему СрезС и МоментСреза (Дата) —
//         с какого момента спрошены изменения и до какого источник вычитан.
//  Курсор - Строка - имя пакета для следующего цикла; пусто — обход начнётся с начала.
//  Момент - Дата - момент завершения в UTC.
//  Сбой - Булево - цикл упал целиком (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура, Неопределено - итог ОБХОДА: те же поля, что у Состояние(), плюс ОбходЗакрыт
//   (Булево — обход закончен целиком, а не отдал очередную порцию). Неопределено, если
//   зеркала нет.
//
Функция Завершить(Знач Идентификатор, Знач Итог, Знач Курсор, Знач Момент, Знач Сбой = Ложь) Экспорт

	Зеркало = Запись(Идентификатор);
	Если Зеркало = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Счётчики.Записать(Зеркало, Итог, Идентификатор);
	ЗаписатьМоментыОбхода(Зеркало, Итог);
	Если ОбходВычиталИсточник(Зеркало, Курсор, Сбой) Тогда
		Зеркало.ВычитаноДо = Зеркало.ПрогонМоментСреза;
	КонецЕсли;
	Зеркало.СостояниеПрогона = СостояниеПоИтогу(Итог, Сбой);
	Зеркало.ПрогонКурсор = ТекстЗначения(Курсор);
	Зеркало.ПрогонОбновлён = Момент;
	Зеркало.Статус = Лев(ТекстЗначения(Итог.Статус), 500);
	Зеркало.ПоследнийСинк = Момент;
	Зеркало.Обновлён = Сейчас();
	Зеркало.Сохранить();
	Дроссель.Сбросить(Идентификатор, Момент);
	Возврат ИтогОбхода(Зеркало);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Запись(Знач Идентификатор)
	Возврат ХранилищеЗеркал.ПолучитьОдноПоИдентификаторРавно(Числа.ЦелаяЧасть(Идентификатор));
КонецФункции

// Итог ОБХОДА, а не порции; незакрытым обход остаётся ровно в состоянии «поставлено».
Функция ИтогОбхода(Знач Зеркало)

	Результат = СостояниеПоЗаписи(Зеркало);
	Результат.Вставить("ОбходЗакрыт", Результат.Состояние <> Состояния().Поставлено);
	Возврат Результат;

КонецФункции

// Пустой момент вычитки не затирает снятый первой порцией: срез обход спрашивает один раз.
Процедура ЗаписатьМоментыОбхода(Зеркало, Знач Итог)

	Моменты = Срез.Прочитать(Итог);
	Зеркало.ПрогонСрезС = Моменты.СрезС;
	Если ЗначениеЗаполнено(Моменты.МоментСреза) Тогда
		Зеркало.ПрогонМоментСреза = Моменты.МоментСреза;
	КонецЕсли;

КонецПроцедуры

// Момент двигается, ТОЛЬКО когда обход дошёл до конца среза и ничего не потерял.
Функция ОбходВычиталИсточник(Знач Зеркало, Знач Курсор, Знач Сбой)

	Если Сбой ИЛИ ЗначениеЗаполнено(ТекстЗначения(Курсор)) Тогда
		Возврат Ложь;
	КонецЕсли;
	// счётчики сложены по ВСЕМУ обходу, а не по последней его порции
	Если Числа.ЦелаяЧасть(Зеркало.ПрогонОшибок) > 0 ИЛИ Числа.ЦелаяЧасть(Зеркало.ПрогонНедоступно) > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗначениеЗаполнено(Зеркало.ПрогонМоментСреза);

КонецФункции

Функция ПустойМомент()
	Возврат '00010101000000';
КонецФункции

// Обход с непройденными именами завершённым не считается: он стоит в очереди, а не отработал.
Функция СостояниеПоИтогу(Знач Итог, Знач Сбой)
	Если Сбой Тогда
		Возврат Состояния().Ошибка;
	КонецЕсли;
	Возврат ?(Итог.ЕстьЕщё = Истина, Состояния().Поставлено, Состояния().Завершён);
КонецФункции

// Поставленный прогон брошенным считается по тому же порогу, что и идущий.
Функция Занят(Знач Зеркало)
	Текущее = ТекущееСостояние(Зеркало);
	Если Текущее <> Состояния().Идёт И Текущее <> Состояния().Поставлено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат НЕ Брошен(Зеркало);
КонецФункции

Функция Брошен(Знач Зеркало)
	Если НЕ ЗначениеЗаполнено(Зеркало.ПрогонОбновлён) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Сейчас() - Зеркало.ПрогонОбновлён >= ПорогЗависания();
КонецФункции

Функция ТекущееСостояние(Знач Зеркало)
	Значение = ТекстЗначения(Зеркало.СостояниеПрогона);
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, Состояния().Простаивает);
КонецФункции

// Инициатор принадлежит ОБХОДУ: плановый захват стирает того, кто нажимал кнопку прошлый раз.
Функция ИнициаторПрогона(Знач Зеркало, Знач Запустил)
	Если ЗначениеЗаполнено(Запустил) Тогда
		Возврат СокрЛП(Строка(Запустил));
	КонецЕсли;
	Если ТекущееСостояние(Зеркало) = Состояния().Поставлено Тогда
		Возврат ТекстЗначения(Зеркало.ПрогонЗапустил);
	КонецЕсли;
	Возврат "";
КонецФункции

Функция Сейчас()
	Если Часы = Неопределено Тогда
		Возврат ТекущаяУниверсальнаяДата();
	КонецЕсли;
	Возврат Часы.Сейчас();
КонецФункции

Функция ТекстЗначения(Знач Значение)
	Возврат ?(ЗначениеЗаполнено(Значение), СокрЛП(Строка(Значение)), "");
КонецФункции

#КонецОбласти

&Прозвище("ПрогонЗеркала")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеЗеркалХабов") _ХранилищеЗеркал,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "ДроссельПрогресса") _Дроссель,
	&Пластилин(Значение = "ЧислаЗеркалирования") _ЧислаЗеркал,
	&Пластилин(Значение = "СчётчикиОбхода") _Счётчики,
	&Пластилин(Значение = "СрезОбхода") _Срез = Неопределено)

	ХранилищеЗеркал = _ХранилищеЗеркал;
	Числа = _Числа;
	Дроссель = _Дроссель;
	ЧислаЗеркал = _ЧислаЗеркал;
	Счётчики = _Счётчики;
	Срез = ?(_Срез = Неопределено, Новый СрезОбхода(), _Срез);
	Часы = Неопределено;

КонецПроцедуры
