// Счётчики обхода зеркала: перенос накопленного между порциями, запись итога в колонки
// прогона и обе величины, которые про обход спрашивают, — «обработано» и доля обхода.

Перем Числа;       // ПриведениеЧисел (основа)
Перем Накопления;  // Соответствие: ид зеркала -> счётчики, накопленные обходом до этого цикла

#Область ПубличныйИнтерфейс

// Сколько элементов обхода уже разобрано. Элемент даёт ровно один инкремент: Скачано ЛИБО
// Пропущено ЛИБО Ошибок. Недоступно — признак поверх Пропущено, и в сумму не входит.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - запись зеркала.
//
// Возвращаемое значение:
//  Число.
//
Функция ОбработаноПоЗаписи(Знач Зеркало) Экспорт
	Возврат Число_(Зеркало.ПрогонСкачано) + Число_(Зеркало.ПрогонПропущено)
		+ Число_(Зеркало.ПрогонОшибок);
КонецФункции

// Доля обхода в процентах — по ИМЕНАМ апстрима, а не по версиям порции: имя считается
// пройденным один раз и назад не отыгрывается, поэтому шкала монотонна. Несосчитанный
// апстрим доли не имеет: ноль означает «неизвестно», а не «ничего не сделано».
//
// Параметры:
//  Зеркало - ЗеркалоХаба - запись зеркала.
//
// Возвращаемое значение:
//  Число - 0..100.
//
Функция ДоляОбходаПоЗаписи(Знач Зеркало) Экспорт

	Всего = Число_(Зеркало.ПрогонИмёнВсего);
	Если Всего <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Мин(100, Макс(0, Цел(Число_(Зеркало.ПрогонИмёнПройдено) * 100 / Всего)));

КонецФункции

// Запоминает базу обхода на время цикла: знаменатель переносится НЕ как есть, а по
// обработанному — оборванный цикл записал в него всю свою порцию, а продолжение с курсора
// перечислит недойденный хвост заново, и сложение посчитало бы хвост дважды.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//  Зеркало - ЗеркалоХаба - запись зеркала на момент захвата.
//
Процедура Запомнить(Знач Идентификатор, Знач Зеркало) Экспорт

	Основа = Новый Структура("Всего, Скачано, Пропущено, Ошибок, Недоступно",
		ОбработаноПоЗаписи(Зеркало), Число_(Зеркало.ПрогонСкачано),
		Число_(Зеркало.ПрогонПропущено), Число_(Зеркало.ПрогонОшибок),
		Число_(Зеркало.ПрогонНедоступно));
	Накопления.Вставить(Число_(Идентификатор), Основа);

КонецПроцедуры

// Пишет счётчики цикла в колонки прогона: к накопленному прибавляется итог текущей порции.
// Шкала имён складывать себя НЕ даёт — источник считает её от начала списка апстрима.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - запись зеркала.
//  Итог - Структура - итог цикла (Всего, Скачано, Пропущено, Ошибок, Недоступно и,
//         если цикл дошёл до перечисления, ИмёнВсего и ИмёнПройдено).
//  Идентификатор - Число - идентификатор зеркала.
//
Процедура Записать(Зеркало, Знач Итог, Знач Идентификатор) Экспорт

	// без Перем присваивание уйдёт в ПОЛЕ объекта, общее на процесс
	Перем ИмёнВсего;
	Перем ИмёнПройдено;

	Основа = Накопленное(Идентификатор);
	Зеркало.ПрогонВсего = Основа.Всего + Число_(Итог.Всего);
	Зеркало.ПрогонСкачано = Основа.Скачано + Число_(Итог.Скачано);
	Зеркало.ПрогонПропущено = Основа.Пропущено + Число_(Итог.Пропущено);
	Зеркало.ПрогонОшибок = Основа.Ошибок + Число_(Итог.Ошибок);
	Зеркало.ПрогонНедоступно = Основа.Недоступно + Число_(Итог.Недоступно);

	ИмёнВсего = 0;
	ИмёнПройдено = 0;
	Итог.Свойство("ИмёнВсего", ИмёнВсего);
	Итог.Свойство("ИмёнПройдено", ИмёнПройдено);
	// нулевой знаменатель означает «апстрим этим циклом не сосчитан» — прошлую шкалу он
	// не стирает, иначе offline-цикл обнулял бы уже показанную долю
	Если Число_(ИмёнВсего) > 0 Тогда
		Зеркало.ПрогонИмёнВсего = Число_(ИмёнВсего);
		Зеркало.ПрогонИмёнПройдено = Мин(Число_(ИмёнВсего), Число_(ИмёнПройдено));
	КонецЕсли;

КонецПроцедуры

// Обнуляет счётчики и шкалу: обход начинается с начала списка апстрима.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - запись зеркала.
//
Процедура Обнулить(Зеркало) Экспорт

	Зеркало.ПрогонВсего = 0;
	Зеркало.ПрогонСкачано = 0;
	Зеркало.ПрогонПропущено = 0;
	Зеркало.ПрогонОшибок = 0;
	Зеркало.ПрогонНедоступно = 0;
	Зеркало.ПрогонИмёнВсего = 0;
	Зеркало.ПрогонИмёнПройдено = 0;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Накопленное(Знач Идентификатор)
	Основа = Накопления.Получить(Число_(Идентификатор));
	Возврат ?(Основа = Неопределено,
		Новый Структура("Всего, Скачано, Пропущено, Ошибок, Недоступно", 0, 0, 0, 0, 0), Основа);
КонецФункции

// Незаполненная колонка приезжает как Неопределено: Цел() на ней падает.
Функция Число_(Знач Значение)
	Возврат Цел(Числа.ЧислоИлиНоль(Значение));
КонецФункции

#КонецОбласти

&Прозвище("СчётчикиОбхода")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПриведениеЧисел") _Числа)

	Числа = _Числа;
	Накопления = Новый Соответствие();

КонецПроцедуры
