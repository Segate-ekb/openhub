// Перенос ОДНОГО элемента синка в пул назначения: инкрементальная проверка, скачивание,
// валидация недоверенного .ospx, иммутабельное сохранение и индексация версии.

Перем СервисПакетов;   // СервисПакетов (реестр)
Перем СервисВерсий;    // СервисВерсий (реестр)
Перем Приём;           // ПриёмВерсии (реестр)
Перем Правила;         // ПравилаИменования (реестр)
Перем Хранилище;       // ХранилищеАртефактов (хранилище)
Перем Разбор;          // РазборПакетовЗеркала (зеркала)
Перем Занятое;         // ЗаписьЗанятогоМеста (реестр)
Перем Валидатор;       // ВалидаторАдресаАпстрима (зеркала)
Перем ПределыПриёма;   // ПределыПриёмаПакета (зеркала) — числа публикации, они же для зеркала
Перем Место;           // МестоВПуле (публикация) — квота пула на пути зеркалирования
Перем След;            // СледЦиклаЗеркала (зеркала) — объявление приезда версии наружу
Перем Желуди;          // ВнедрённыеЖелуди (основа) — три формы внедрения необязательной зависимости
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Переносит элемент синка в пул назначения. Наружу бросает только то, что движок считает
// сбоем пакета: недоступность апстрима сбоем не является.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - конфигурация зеркала.
//  ПулНазн - Пул - пул назначения.
//  Источник - ИсточникАпстрима - источник, которым скачивается элемент.
//  Элемент - Структура - элемент синка: ИмяПакета, Версия, ПутьСкачивания, ВерсияИзвестна.
//
// Возвращаемое значение:
//  Структура - Скачано (Булево, версия появилась в пуле этим вызовом),
//              Недоступно (Булево, элемент не взят по устранимой причине),
//              ИсточникМолчит (Булево, апстрим не ответил — порцию продолжать нечем).
//
Функция Перенести(Знач Зеркало, Знач ПулНазн, Знач Источник, Знач Элемент) Экспорт

	ИмяПакета = СокрЛП(Строка(Элемент.ИмяПакета));
	Лог.Отладка("Зеркало #%1: перенос ""%2"" %3 (версия %4), путь у апстрима ""%5""",
		Зеркало.Идентификатор, ИмяПакета,
		?(Элемент.ВерсияИзвестна = Истина, "известной версии", "latest"),
		Элемент.Версия, Элемент.ПутьСкачивания);
	// координаты берём из имени апстрима, а не из манифеста — защита от traversal
	Если НЕ Правила.ИмяКорректно(ИмяПакета) Тогда
		Лог.Отладка("Зеркало #%1: имя ""%2"" не проходит правила именования — пропущено"
			+ " без обращения к файловой системе", Зеркало.Идентификатор, ИмяПакета);
		Возврат Исход();
	КонецЕсли;

	// известная версия: иммутабельный артефакт уже есть — не качаем
	Если Элемент.ВерсияИзвестна = Истина Тогда
		Координаты = БезопасныеКоординаты(ПулНазн.Имя, ИмяПакета, Элемент.Версия);
		Если Координаты = Неопределено Тогда
			Возврат Исход();
		КонецЕсли;
		Если Хранилище.Существует(Координаты) Тогда
			Лог.Отладка("Зеркало #%1: ""%2"" %3 уже лежит в пуле ""%4"" — не качаем",
				Зеркало.Идентификатор, ИмяПакета, Элемент.Версия, ПулНазн.Имя);
			ОбеспечитьИндекс(ПулНазн, ИмяПакета, Элемент.Версия);
			Возврат Исход();
		КонецЕсли;
	КонецЕсли;

	// адрес разбирается ещё раз: между перечислением и скачиванием его могли переписать
	Вердикт = Валидатор.Проверить(Зеркало.АпстримURL);
	Если НЕ Вердикт.Ок Тогда
		Лог.Предупреждение("Зеркало #%1: адрес апстрима не разбирается (%2) — пакет ""%3"" пропущен",
			Зеркало.Идентификатор, Вердикт.Ошибка, ИмяПакета);
		Возврат Исход();
	КонецЕсли;

	Результат = Источник.Скачать(Зеркало, Элемент);
	Лог.Отладка("Зеркало #%1: апстрим ответил %2 на ""%3""",
		Зеркало.Идентификатор, Результат.Код, Элемент.ПутьСкачивания);
	Если Результат.Код = 0 Тогда
		// апстрим отвалился: порция обрывается, и элемент остаётся невзятым
		Возврат Исход(Ложь, Истина, Истина);
	КонецЕсли;
	Если Результат.Код <> 200 Тогда
		// 404, 500, 503 — отказ УСТРАНИМЫЙ: в другой раз источник отдаст артефакт, и версия
		// обязана приехать. Обход идёт дальше, но невзятым элементом держит момент вычитки
		Лог.Предупреждение("Зеркало #%1: апстрим ответил %2 на ""%3"" — версия не взята,"
			+ " момент вычитки этот обход не сдвинет",
			Зеркало.Идентификатор, Результат.Код, Элемент.ПутьСкачивания);
		Возврат Исход(Ложь, Истина);
	КонецЕсли;

	Возврат Уложить(Зеркало, ПулНазн, ИмяПакета, Элемент, Результат.Данные);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Уложить(Знач Зеркало, Знач ПулНазн, Знач ИмяПакета, Знач Элемент, Знач Данные)

	// без Перем присваивание уйдёт в ПОЛЕ объекта, общее на процесс
	Перем МаксРазмер;
	Перем ЗеркалоИд;

	ЗеркалоИд = Зеркало.Идентификатор;

	Если Данные = Неопределено ИЛИ Данные.Размер() = 0 Тогда
		Возврат Исход();
	КонецЕсли;
	МаксРазмер = ПределыПриёма.РазмерАртефакта();
	Если Данные.Размер() > МаксРазмер Тогда
		Лог.Предупреждение("Зеркало #%1: пакет ""%2"" %3 байт превышает предел приёма %4 байт"
			+ " (%5) — пропущен",
			ЗеркалоИд, ИмяПакета, Данные.Размер(), МаксРазмер, ПределыПриёма.КлючРазмераАртефакта());
		Возврат Исход();
	КонецЕсли;

	// Квота пула — единственный размерный предел сверх чисел приёма: приезжающие байты
	// занимают место пула ровно так же, как опубликованные снаружи.
	// Отказ по квоте УСТРАНИМ: место в пуле расширяют либо освобождают, и версия приезжает
	// следующим прогоном — момент вычитки такой обход не двигает.
	ОтказКвоты = ПричинаОтказаПоКвоте(ПулНазн, Данные.Размер());
	Если ЗначениеЗаполнено(ОтказКвоты) Тогда
		Лог.Предупреждение("Зеркало #%1: пакет ""%2"" в пул не помещается — версия не взята,"
			+ " момент вычитки этот обход не сдвинет. %3",
			ЗеркалоИд, ИмяПакета, ОтказКвоты);
		Возврат Исход(Ложь, Истина);
	КонецЕсли;

	Проверка = Разбор.ПроверитьЗагрузку(Данные);
	Если НЕ Проверка.Успех Тогда
		Возврат Исход();
	КонецЕсли;

	// известная версия приоритетна; иначе берётся из уже проверенного манифеста
	Версия = ?(Элемент.ВерсияИзвестна = Истина, Строка(Элемент.Версия),
		СокрЛП(Строка(Проверка.Манифест.Версия())));
	Координаты = ?(ЗначениеЗаполнено(Версия), БезопасныеКоординаты(ПулНазн.Имя, ИмяПакета, Версия),
		Неопределено);
	Если Координаты = Неопределено Тогда
		Разбор.УбратьВременный(Проверка.ВременныйПуть);
		Возврат Исход();
	КонецЕсли;

	// артефакт уже есть — не перезаписываем; манифест уже разобран, второй раз за ним не ходим
	Если Хранилище.Существует(Координаты) Тогда
		ОбеспечитьИндекс(ПулНазн, ИмяПакета, Версия, Проверка.Манифест);
		Разбор.УбратьВременный(Проверка.ВременныйПуть);
		Возврат Исход();
	КонецЕсли;

	Сохранить(Зеркало, ПулНазн, ИмяПакета, Версия, Координаты, Проверка);
	Лог.Отладка("Зеркало #%1: ""%2"" %3 уложен в пул ""%4""",
		ЗеркалоИд, ИмяПакета, Версия, ПулНазн.Имя);
	Разбор.УбратьВременный(Проверка.ВременныйПуть);
	Возврат Исход(Истина);

КонецФункции

// Сбой индексации откатывает артефакт, чтобы не осталось файла без индекса.
Процедура Сохранить(Знач Зеркало, Знач ПулНазн, Знач ИмяПакета, Знач Версия, Знач Координаты,
	Знач Проверка)

	РезультатСохранения = Хранилище.Сохранить(Координаты, Проверка.ВременныйПуть);
	Попытка
		// апстрим-источника у зеркалирования нет, README привезённого пакета — есть
		Приём.ПринятьВнешнюю(ПулНазн, ИмяПакета, Версия, Проверка.Манифест, РезультатСохранения,
			, Проверка.ТекстREADME);
	Исключение
		ПопытатьсяУдалитьАртефакт(Координаты);
		ВызватьИсключение;
	КонецПопытки;

	// зеркалированные байты занимают место пула: счётчик ведёт тот, кто пишет файл
	Занятое.Учесть(ПулНазн, РезультатСохранения.Размер, "зеркалирование " + ИмяПакета);

	Если След <> Неопределено Тогда
		След.ОбъявитьПриездВерсии(Зеркало, ПулНазн.Имя, ИмяПакета, Версия,
			РезультатСохранения.Размер);
	КонецЕсли;

КонецПроцедуры

// Проиндексированную версию не перечитываем — на S3 это выкачивание пула.
Процедура ОбеспечитьИндекс(Знач ПулНазн, Знач ИмяПакета, Знач Версия, Знач Манифест = Неопределено)
	Попытка
		Пакет = СервисПакетов.НайтиПакет(ПулНазн.Идентификатор, ИмяПакета);
		Если Пакет <> Неопределено И СервисВерсий.НайтиВерсию(Пакет.Идентификатор, Версия) <> Неопределено Тогда
			Возврат;
		КонецЕсли;
		Координаты = Новый КоординатыАртефакта(ПулНазн.Имя, ИмяПакета, Версия);
		Сведения = Разбор.СведенияАртефакта(Координаты, Манифест);
		Лежащее = Новый Структура("Размер, Sha256", Хранилище.Размер(Координаты), Сведения.Sha256);
		Приём.ПринятьВнешнюю(ПулНазн, ИмяПакета, Версия, Сведения.Манифест, Лежащее);
	Исключение
		// индекс существующего артефакта вторичен — синк не роняем
	КонецПопытки;
КонецПроцедуры

// Неопределено, если компоненты недопустимы как сегмент пути.
Функция БезопасныеКоординаты(Знач ИмяПула, Знач ИмяПакета, Знач Версия)
	Попытка
		Возврат Новый КоординатыАртефакта(ИмяПула, ИмяПакета, Версия);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Откат раскладки: сам он исходную ошибку затирать не должен.
Процедура ПопытатьсяУдалитьАртефакт(Знач Координаты)
	Попытка
		Хранилище.Удалить(Координаты);
	Исключение
	КонецПопытки;
КонецПроцедуры

// Устранимая причина («не взято», «источник молчит») момент вычитки НЕ двигает; прочее — пропуск.
Функция Исход(Знач Скачано = Ложь, Знач Недоступно = Ложь, Знач ИсточникМолчит = Ложь)
	Возврат Новый Структура("Скачано, Недоступно, ИсточникМолчит",
		Скачано, Недоступно, ИсточникМолчит);
КонецФункции

// Массив — способ ОСени выразить необязательную зависимость: набор без core-registry собирается.
Функция ГейтКвоты(Знач Зависимость)

	Сервис = Желуди.ПервыйИз(Зависимость);
	Возврат ?(Сервис = Неопределено, Неопределено, Новый МестоВПуле(Сервис));

КонецФункции

// Правило квоты одно на все пути приёма — то же МестоВПуле, что и у публикации снаружи.
Функция ПричинаОтказаПоКвоте(Знач ПулНазн, Знач Размер)

	Если Место = Неопределено Тогда
		// контейнер без core-registry (доменные наборы): спрашивать квоту не у кого,
		// и молчать об этом нельзя — иначе непроверенная квота выглядит как пройденная
		Лог.Отладка("Квота пула не спрошена: гейт места не собран (контейнер без СервисаПулов)");
		Возврат "";
	КонецЕсли;

	Отказ = Место.ПричинаОтказа(ПулНазн, Размер, Неопределено);
	Возврат ?(Отказ = Неопределено, "", Строка(Отказ.Сообщение));

КонецФункции

#КонецОбласти

&Прозвище("ПереносЭлементаСинка")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "ПриёмВерсии") _Приём,
	&Пластилин(Значение = "ПравилаИменования") _Правила,
	&Пластилин(Значение = "ХранилищеАртефактов") _Хранилище,
	&Пластилин(Значение = "РазборПакетовЗеркала") _Разбор,
	&Пластилин(Значение = "ЗаписьЗанятогоМеста") _Занятое,
	&Пластилин(Значение = "ВалидаторАдресаАпстрима") _Валидатор,
	&Пластилин(Значение = "ПределыПриёмаПакета") _ПределыПриёма,
	&Пластилин(Значение = "СервисПулов", Тип = "Массив") _СервисПулов = Неопределено,
	&Пластилин(Значение = "СледЦиклаЗеркала", Тип = "Массив") _След = Неопределено,
	&Лог _Лог = Неопределено)

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Желуди = Новый ВнедрённыеЖелуди();
	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;
	Приём = _Приём;
	Правила = _Правила;
	Хранилище = _Хранилище;
	Разбор = _Разбор;
	Занятое = _Занятое;
	Валидатор = _Валидатор;
	ПределыПриёма = _ПределыПриёма;
	Место = ГейтКвоты(_СервисПулов);
	След = Желуди.ПервыйИз(_След);

КонецПроцедуры
