// Происшествия обхода зеркала: подсистема, адрес объекта, метка обхода и токен источника
// сложены здесь — точке пропуска остаются предмет, код и причина.

Перем Летопись;  // ЛетописьПроисшествий (происшествия)
Перем Объекты;   // ОбъектыПроисшествий (происшествия)
Перем Коды;      // КодыПроисшествий (происшествия)
Перем Прогон;    // ПрогонЗеркала (зеркала) — метка обхода
Перем Виденное;  // Соответствие: ид зеркала -> Структура(Метка, Коды) — что уже сказано
                 // журналу в этом обходе. Память процесса: обход ведёт один рабочий
                 // очереди (см. ⛔ у СинхронизаторЗеркал.Синхронизировать)

#Область ПубличныйИнтерфейс

// Объявляет, что у зеркала начался обход: причины прошлых обходов снимаются, чтобы
// не выдавать себя за причины текущего. Зовётся на каждой порции — метка у порций одна,
// и повторный вызов ничего не сносит.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - захваченная запись зеркала.
//
Процедура НачатьОбход(Знач Зеркало) Экспорт

	Летопись.НачатьПрогон(Коды.ПодсистемаЗеркало(), Объекты.Зеркало(Зеркало.Идентификатор),
		Прогон.МеткаОбхода(Зеркало));
	СвежаяПамять(Зеркало);

КонецПроцедуры

// Впервые ли этот код встречается в этом обходе. Спрашивает журнал: первая встреча —
// новость уровня хаба, остальные — подробность отладки. Ответ запоминается, поэтому
// второй вопрос про тот же код даёт Ложь.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - захваченная запись зеркала.
//  Код - Строка - машинный код причины.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПервоеВОбходе(Знач Зеркало, Знач Код) Экспорт

	Память = СвежаяПамять(Зеркало);
	Ключ = Текстом(Код);
	Если Память.Коды.Получить(Ключ) = Истина Тогда
		Возврат Ложь;
	КонецЕсли;
	Память.Коды.Вставить(Ключ, Истина);
	Возврат Истина;

КонецФункции

// Сколько РАЗНЫХ причин обход назвал журналу. Итоговая строка цикла говорит ею вместо
// того, чтобы перечитывать летопись ради одного числа.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - захваченная запись зеркала.
//
// Возвращаемое значение:
//  Число.
//
Функция ЧислоПричинОбхода(Знач Зеркало) Экспорт
	Возврат СвежаяПамять(Зеркало).Коды.Количество();
КонецФункции

// Запоминает, чего обход не сделал и почему.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - захваченная запись зеркала.
//  Предмет - Строка - «пакет@версия»; пусто — происшествие всего обхода.
//  Код - Строка - машинный код причины из КодыПроисшествий.
//  Причина - Строка - фраза для человека.
//
Процедура Записать(Знач Зеркало, Знач Предмет, Знач Код, Знач Причина) Экспорт

	Летопись.Записать(Коды.ПодсистемаЗеркало(), Объекты.Зеркало(Зеркало.Идентификатор),
		Предмет, Код, Причина, Прогон.МеткаОбхода(Зеркало), Токен(Зеркало));

КонецПроцедуры

// Предмет происшествия — то, над чем не получилось.
//
// Параметры:
//  ИмяПакета - Строка - имя пакета у источника.
//  Версия - Строка - строка версии; пусто — версию источник ещё не назвал
//           (необязательный, по умолчанию пустая строка).
//
// Возвращаемое значение:
//  Строка - «пакет@версия» либо одно имя пакета.
//
Функция Предмет(Знач ИмяПакета, Знач Версия = "") Экспорт

	Имя = Текстом(ИмяПакета);
	Номер = Текстом(Версия);
	Возврат ?(ЗначениеЗаполнено(Номер), Имя + "@" + Номер, Имя);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Память живёт ровно один обход: сменилась метка — сказанное прошлому обходу забыто,
// иначе повторяющаяся из обхода в обход причина навсегда ушла бы с уровня хаба.
Функция СвежаяПамять(Знач Зеркало)

	Ключ = Цел(Зеркало.Идентификатор);
	Метка = Прогон.МеткаОбхода(Зеркало);
	Память = Виденное.Получить(Ключ);
	Если Память = Неопределено ИЛИ Память.Метка <> Метка Тогда
		Память = Новый Структура("Метка, Коды", Метка, Новый Соответствие());
		Виденное.Вставить(Ключ, Память);
	КонецЕсли;
	Возврат Память;

КонецФункции

// Токен приватного источника называется летописи явно: вычёркивать его из причины
// по догадке нечем — в тексте сбоя он бывает и без адреса рядом.
Функция Токен(Знач Зеркало)
	Возврат Текстом(Зеркало.ТокенДоступа);
КонецФункции

Функция Текстом(Знач Значение)
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
КонецФункции

#КонецОбласти

&Прозвище("ПроисшествияЗеркала")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЛетописьПроисшествий") _Летопись,
	&Пластилин(Значение = "ОбъектыПроисшествий") _Объекты,
	&Пластилин(Значение = "КодыПроисшествий") _Коды,
	&Пластилин(Значение = "ПрогонЗеркала") _Прогон)

	Летопись = _Летопись;
	Объекты = _Объекты;
	Коды = _Коды;
	Прогон = _Прогон;
	Виденное = Новый Соответствие();

КонецПроцедуры
