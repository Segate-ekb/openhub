// След зеркала наружу: спан телеметрии, событие «зеркало.синхронизировано» на итог цикла
// и «версия.зеркалирована» на каждую уложенную версию.
// Всё вторично — сбой следа не отменяет ни цикл, ни его итог.

Перем Издатель;      // ИздательСобытий (события) — опционален
Перем ИменаЖурнала;  // ИмяОбъектаАудита (аудит) — вид объекта в журнале
Перем Телеметрия;    // фасад OTel (наблюдаемость) — опционален

#Область ПубличныйИнтерфейс

// Открывает спан цикла.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - синхронизируемое зеркало.
//
// Возвращаемое значение:
//  Произвольный - спан либо Неопределено, если телеметрии нет.
//
Функция НачатьСпан(Знач Зеркало) Экспорт

	Если Телеметрия = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Атрибуты = Новый Соответствие();
	Атрибуты.Вставить("oshub.mirror.id", Зеркало.Идентификатор);
	Атрибуты.Вставить("oshub.mirror.mode", Зеркало.Режим);
	Возврат Телеметрия.НачатьСпан("mirror.sync", "internal", Атрибуты);

КонецФункции

// Закрывает спан цикла.
//
// Параметры:
//  Спан - Произвольный - спан, открытый НачатьСпан.
//  Ошибка - Булево - помечать ли спан сбоем синхронизации (необязательный,
//           по умолчанию Ложь).
//
Процедура ЗавершитьСпан(Знач Спан, Знач Ошибка = Ложь) Экспорт

	Если Спан = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Ошибка Тогда
		Спан.Ошибка("сбой синхронизации");
	КонецЕсли;
	Спан.Завершить();

КонецПроцедуры

// Публикует событие о законченном цикле. Наружу не бросает: публикация вторична.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - синхронизированное зеркало.
//  Итог - Структура - итог цикла.
//  Момент - Дата - момент завершения в UTC.
//
Процедура Опубликовать(Знач Зеркало, Знач Итог, Знач Момент) Экспорт

	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Данные = Новый Структура();
		Данные.Вставить("Кто", "mirror");
		Данные.Вставить("Действие", "зеркало.синхронизировано");
		Данные.Вставить("Объект", ИменаЖурнала.Пул(Зеркало.ПулНазначенияИдентификатор));
		Данные.Вставить("ДеталиJSON", ДеталиJSON(Зеркало, Итог));
		Данные.Вставить("АдресIP", "");
		Данные.Вставить("ЗеркалоИдентификатор", Зеркало.Идентификатор);
		Данные.Вставить("ПулИдентификатор", Зеркало.ПулНазначенияИдентификатор);
		Издатель.Опубликовать(Издатель.ТипЗеркалоСинхронизировано(), Данные, Момент);
	Исключение
		// публикация события вторична
	КонецПопытки;

КонецПроцедуры

// Объявляет, что версия легла в пул зеркалом. Наружу не бросает: след вторичен.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - зеркало, которым версия приехала.
//  ИмяПула - Строка - имя пула назначения.
//  ИмяПакета - Строка - имя пакета.
//  Версия - Строка - версия пакета.
//  Размер - Число - размер уложенного артефакта в байтах.
//
Процедура ОбъявитьПриездВерсии(Знач Зеркало, Знач ИмяПула, Знач ИмяПакета, Знач Версия,
	Знач Размер) Экспорт

	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Данные = Новый Структура();
		// субъект записи — сам хаб: человек в этом пути не участвует, и журнал обязан
		// говорить это прямо, иначе приезд зеркалом не отличить от чужой публикации
		Данные.Вставить("Кто", "mirror");
		// действие названо в одном ряду с «публикация.версии» и «перезапись.версии»:
		// журнал отбирается по действию, и три способа появления версии обязаны читаться рядом
		Данные.Вставить("Действие", "зеркалирование.версии");
		Данные.Вставить("Объект", ИменаЖурнала.ВерсияПоИменам(ИмяПула, ИмяПакета, Версия));
		Данные.Вставить("ДеталиJSON",
			ДеталиПриездаJSON(Зеркало, ИмяПула, ИмяПакета, Версия, Размер));
		Данные.Вставить("АдресIP", "");
		Данные.Вставить("ЗеркалоИдентификатор", Зеркало.Идентификатор);
		Данные.Вставить("ПулИдентификатор", Зеркало.ПулНазначенияИдентификатор);
		Издатель.Опубликовать(Издатель.ТипВерсияЗеркалирована(), Данные);
	Исключение
		// публикация события вторична
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДеталиПриездаJSON(Знач Зеркало, Знач ИмяПула, Знач ИмяПакета, Знач Версия, Знач Размер)

	Данные = Новый Структура();
	Данные.Вставить("пул", Строка(ИмяПула));
	Данные.Вставить("пакет", Строка(ИмяПакета));
	Данные.Вставить("версия", Строка(Версия));
	Данные.Вставить("зеркало", Зеркало.Идентификатор);
	Данные.Вставить("апстрим", Строка(Зеркало.АпстримURL));
	Данные.Вставить("размер", Цел(Размер));
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

Функция ДеталиJSON(Знач Зеркало, Знач Итог)

	Данные = Новый Структура();
	Данные.Вставить("зеркало", Зеркало.Идентификатор);
	Данные.Вставить("апстрим", Зеркало.АпстримURL);
	Данные.Вставить("режим", Зеркало.Режим);
	Данные.Вставить("всего", Итог.Всего);
	Данные.Вставить("скачано", Итог.Скачано);
	Данные.Вставить("пропущено", Итог.Пропущено);
	Данные.Вставить("ошибок", Итог.Ошибок);
	Данные.Вставить("offline", Итог.Offline);
	Данные.Вставить("естьЕщё", Итог.ЕстьЕщё);
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

// Массив — способ ОСени выразить необязательные зависимости: наборы домена собирают
// контейнер без events и телеметрии, и след в нём просто никуда не уходит.
&Прозвище("СледЦиклаЗеркала")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ИмяОбъектаАудита") _Имена,
	&Пластилин(Значение = "ИздательСобытий", Тип = "Массив") _Издатель = Неопределено,
	&Пластилин(Значение = "Телеметрия", Тип = "Массив") _Телеметрия = Неопределено)

	ИменаЖурнала = _Имена;
	Издатель = Первый(_Издатель);
	Телеметрия = Первый(_Телеметрия);

КонецПроцедуры

// ОСень внедряет коллекцию ФиксированныйМассив, прямое создание в тестах — обычный Массив
// либо сам объект; разбираются все три формы.
Функция Первый(Знач Зависимость)
	Если Зависимость = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Зависимость) = Тип("Массив")
		ИЛИ ТипЗнч(Зависимость) = Тип("ФиксированныйМассив") Тогда
		Возврат ?(Зависимость.Количество() = 0, Неопределено, Зависимость[0]);
	КонецЕсли;
	Возврат Зависимость;
КонецФункции
