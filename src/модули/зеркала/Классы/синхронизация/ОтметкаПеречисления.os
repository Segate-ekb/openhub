// Отметка живости на время перечисления порции: пока источник обходит имена апстрима,
// прогон обязан подавать признаки жизни, иначе живой обход объявят брошенным.
// Курсор при этом НЕ двигается: перечисленное имя ещё не перенесено, и продолжать
// обход после обрыва надо с начала порции.

Перем Прогон;      // ПрогонЗеркала (зеркала)
Перем ЗеркалоИд;
Перем Итог;        // Структура итога цикла — счётчики пишутся из неё
Перем КурсорПорции;

#Область ПубличныйИнтерфейс

// Отмечает, что перечисление дошло до очередного имени апстрима.
//
// Параметры:
//  ИмяПакета - Строка - имя, до которого дошло перечисление.
//
Процедура Шаг(Знач ИмяПакета) Экспорт
	Прогон.Отметить(ЗеркалоИд, Итог, КурсорПорции);
КонецПроцедуры

#КонецОбласти

// Не желудь: отметка живёт ровно один цикл и создаётся тем, кто этот цикл ведёт.
Процедура ПриСозданииОбъекта(Знач _Прогон, Знач _ЗеркалоИд, Знач _Итог, Знач _КурсорПорции)
	Прогон = _Прогон;
	ЗеркалоИд = _ЗеркалоИд;
	Итог = _Итог;
	КурсорПорции = _КурсорПорции;
КонецПроцедуры
