// Срез обхода: с какого момента у источника спрошены изменения, до какого момента он этим
// обходом вычитан и как такой обход называется. Правило ОДНО на движок, прогон, экран
// и журнал — инкрементным обход делает названный момент среза.

#Область ПубличныйИнтерфейс

// Обход, перечисляющий источник целиком.
//
// Возвращаемое значение:
//  Строка.
//
Функция Полный() Экспорт
	Возврат "полный";
КонецФункции

// Обход, спрашивающий у источника только изменившееся с момента.
//
// Возвращаемое значение:
//  Строка.
//
Функция Инкремент() Экспорт
	Возврат "инкремент";
КонецФункции

// Способ обхода по моменту его среза.
//
// Параметры:
//  СрезС - Дата, Неопределено - момент, с которого спрошены изменения; незаполненный
//          означает, что источник перечисляется целиком.
//
// Возвращаемое значение:
//  Строка - Полный() либо Инкремент().
//
Функция ПоМоменту(Знач СрезС) Экспорт
	Возврат ?(ЗначениеЗаполнено(СрезС), Инкремент(), Полный());
КонецФункции

// Читает моменты среза из ответа источника либо из итога цикла. Оба необязательны:
// протокол, инкремента не умеющий, их не называет, и обход остаётся полным.
//
// Параметры:
//  Ответ - Структура - ответ источника на перечисление либо итог цикла.
//
// Возвращаемое значение:
//  Структура - СрезС (Дата, момент отсчёта; пустая — обход полный),
//              МоментСреза (Дата, момент, до которого источник вычитан этим обходом).
//
Функция Прочитать(Знач Ответ) Экспорт

	// Перем обязательна: присваивание необъявленной переменной уходит в ПОЛЕ объекта
	Перем Значение;

	Результат = Новый Структура("СрезС, МоментСреза", ПустойМомент(), ПустойМомент());

	Значение = Неопределено;
	Если Ответ.Свойство("СрезС", Значение) И ТипЗнч(Значение) = Тип("Дата") Тогда
		Результат.СрезС = Значение;
	КонецЕсли;

	Значение = Неопределено;
	Если Ответ.Свойство("МоментСреза", Значение) И ТипЗнч(Значение) = Тип("Дата") Тогда
		Результат.МоментСреза = Значение;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Момент среза для машинного читателя: незаполненный печатается пустой строкой, а не
// нулевой датой, которую читатель принял бы за настоящий момент.
//
// Параметры:
//  Момент - Дата, Неопределено - момент среза.
//
// Возвращаемое значение:
//  Строка - XML-дата либо пустая строка.
//
Функция Печатью(Знач Момент) Экспорт
	Возврат ?(ЗначениеЗаполнено(Момент), XMLСтрока(Момент), "");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПустойМомент()
	Возврат '00010101000000';
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
