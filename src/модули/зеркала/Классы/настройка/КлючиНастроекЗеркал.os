// Ключи настроек зеркалирования: рубильник синхронизации, числа темпа и квот, расписание
// обхода зеркал и пробы здоровья источников.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей зеркалирования в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи зеркалирования.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(100)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "oshub.mirror.sync_enabled", ЗначениеПоУмолчанию = "") _СинкЗеркал = "",
	&Деталька(Значение = "oshub.mirror.max_per_pool", ЗначениеПоУмолчанию = "") _ЗеркалНаПул = "",
	&Деталька(Значение = "oshub.mirror.default_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалЗеркала = "",
	&Деталька(Значение = "oshub.mirror.min_interval_sec", ЗначениеПоУмолчанию = "") _МинИнтервалЗеркала = "",
	&Деталька(Значение = "oshub.mirror.run_stale_sec", ЗначениеПоУмолчанию = "") _ПорогЗависанияПрогона = "",
	&Деталька(Значение = "oshub.mirror.max_packages_per_cycle", ЗначениеПоУмолчанию = "") _ПорцияЗеркала = "",
	&Деталька(Значение = "oshub.mirror.max_cycles_per_run", ЗначениеПоУмолчанию = "") _ЦикловЗаПрогон = "",
	&Деталька(Значение = "oshub.mirror.queue_max", ЗначениеПоУмолчанию = "") _ОчередьЗеркал = "",
	&Деталька(Значение = "oshub.mirror.cycles_per_turn", ЗначениеПоУмолчанию = "") _ЦикловЗаЗаход = "",
	&Деталька(Значение = "oshub.mirror.queue_poll_sec", ЗначениеПоУмолчанию = "") _ОпросОчередиЗеркал = "",
	&Деталька(Значение = "oshub.jobs.mirror_sync_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалЗеркал = "",
	&Деталька(Значение = "oshub.jobs.upstream_health_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалЗдоровья = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	// Из интерфейса правится только рубильник подсистемы — «синхронизируем или нет». Числа
	// темпа и квот задаёт разворачивающий. Своих пределов приёма у зеркала нет — привозимый
	// пакет судится числами oshub.publish.max_*.
	Ключи.Объявить("oshub.mirror.sync_enabled", "булево", Истина, Неопределено, "прикладная", _СинкЗеркал);
	Ключи.Объявить("oshub.mirror.max_per_pool", "целое", 5, _Правила.Минимум(1), "bootstrap", _ЗеркалНаПул);
	Ключи.Объявить("oshub.mirror.default_interval_sec", "целое", 3600, _Правила.Минимум(1), "bootstrap",
		_ИнтервалЗеркала);
	Ключи.Объявить("oshub.mirror.min_interval_sec", "целое", 60, _Правила.Минимум(1), "bootstrap",
		_МинИнтервалЗеркала);
	// Таймаут ЖИВОГО прогона: живой цикл отмечается на каждом имени и каждой версии,
	// поэтому единицы минут — честный срок, а не четверть часа.
	Ключи.Объявить("oshub.mirror.run_stale_sec", "целое", 300, _Правила.Минимум(1), "bootstrap",
		_ПорогЗависанияПрогона);
	Ключи.Объявить("oshub.mirror.max_packages_per_cycle", "целое", 25, _Правила.Минимум(1), "bootstrap",
		_ПорцияЗеркала);
	Ключи.Объявить("oshub.mirror.max_cycles_per_run", "целое", 20, _Правила.Минимум(1), "bootstrap",
		_ЦикловЗаПрогон);
	Ключи.Объявить("oshub.mirror.queue_max", "целое", 100, _Правила.Минимум(1), "bootstrap", _ОчередьЗеркал);
	Ключи.Объявить("oshub.mirror.cycles_per_turn", "целое", 20, _Правила.Минимум(1), "bootstrap",
		_ЦикловЗаЗаход);
	Ключи.Объявить("oshub.mirror.queue_poll_sec", "целое", 2, _Правила.Минимум(1), "bootstrap",
		_ОпросОчередиЗеркал);

	// Расписание обхода зеркал и пробы здоровья источников.
	Ключи.Объявить("oshub.jobs.mirror_sync_interval_sec", "целое", 3600, _Правила.Минимум(1), "bootstrap",
		_ИнтервалЗеркал);
	Ключи.Объявить("oshub.jobs.upstream_health_interval_sec", "целое", 60, _Правила.Минимум(1), "bootstrap",
		_ИнтервалЗдоровья);

КонецПроцедуры
