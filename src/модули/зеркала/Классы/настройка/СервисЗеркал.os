// Доменный CRUD конфигураций зеркал пула назначения: права владельца пула на каждой
// мутации, SSRF-валидация апстрима, лимит зеркал на пул и уникальность пары (пул, URL).

Перем ХранилищеЗеркал;  // ХранилищеЗеркалХабов (данные)
Перем СервисПрав;       // СервисПрав (auth)
Перем Валидатор;        // ВалидаторАдресаАпстрима (зеркала) — форма адреса
Перем Пробник;          // ПробникИсточника (прокси) — пробное подключение к источнику
Перем Разбор;           // РазборНастроекЗеркала (зеркала) — приведение и проверка того, что пришло
Перем Секрет;           // СекретИсточника (прокси) — правило токена доступа к апстриму
Перем Прогон;           // ПрогонЗеркала (зеркала)
Перем ЧислаЗеркал;      // ЧислаЗеркалирования (зеркала) — настройки хаба, читаются на каждый вызов

#Область ПубличныйИнтерфейс

// Поддерживаемые движком режимы синхронизации — источник истины для UI и валидации.
//
// Возвращаемое значение:
//  Массив из Строка - имена режимов.
//
Функция ИзвестныеРежимы() Экспорт
	Возврат Разбор.ИзвестныеРежимы();
КонецФункции

// Все зеркала пула назначения — список в кабинете.
//
// Параметры:
//  ПулНазначенияИдентификатор - Число - идентификатор пула назначения.
//
// Возвращаемое значение:
//  Массив из ЗеркалоХаба - зеркала пула, включённые и выключенные.
//
Функция СписокПула(Знач ПулНазначенияИдентификатор) Экспорт
	Возврат ХранилищеЗеркал.ПолучитьПоПулНазначенияИдентификаторРавно(Цел(ПулНазначенияИдентификатор));
КонецФункции

// Создаёт зеркало в пуле назначения.
//
// Параметры:
//  Пользователь - Пользователь - инициатор, обязан быть владельцем либо админом пула.
//  Пул - Пул - пул назначения; обязан допускать внешние источники по своему типу.
//        Выключенная публикация заведению зеркала не мешает: она закрывает пул
//        для людей, а не для хаба.
//  АпстримURL - Строка - базовый URL апстрим-хаба, проходит SSRF-валидацию.
//  Режим - Строка - режим синхронизации (необязательный, по умолчанию "opm").
//  ФильтрJSON - Строка - JSON-массив масок имён; пустой пропускает всё
//               (необязательный, по умолчанию "").
//  ИнтервалСинкаСек - Число - интервал синка; 0 берёт значение по умолчанию
//                     (необязательный, по умолчанию 0).
//  Токен - Строка - токен доступа к приватной выдаче апстрима; пусто — апстрим читается
//          анонимно (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  ЗеркалоХаба - созданная конфигурация зеркала, включённая.
//
// Выбрасывает исключение без прав администрирования, при недопустимом типе либо режиме пула,
// неразбираемом URL, неудачной пробе подключения, неверном фильтре, достижении лимита
// зеркал и дубле апстрима в пуле.
//
Функция Создать(Знач Пользователь, Знач Пул, Знач АпстримURL, Знач Режим = "opm",
	Знач ФильтрJSON = "", Знач ИнтервалСинкаСек = 0, Знач Токен = "") Экспорт

	// без Перем присваивание уйдёт в ПОЛЕ объекта, общее на процесс
	Перем МаксНаПул;

	ТребоватьПрава(Пользователь, Пул);

	// зеркало — ещё один путь к внешнему источнику, поэтому спрашивается тот же предикат
	// типа пула, что и на апстримах
	Если НЕ Пул.АпстримыДопустимы() Тогда
		ВызватьИсключение СтрШаблон(
			"Пулу ""%1"" нельзя завести зеркало: это личное пространство пользователя,"
			+ " а личный пул внешние источники не тянет. Запрет структурный — на уровне типа"
			+ " пула, а не настройки.", Пул.Имя);
	КонецЕсли;

	НормУРЛ = Разбор.Адрес(АпстримURL);
	Вердикт = Валидатор.Проверить(НормУРЛ);
	Если НЕ Вердикт.Ок Тогда
		ВызватьИсключение "Недопустимый URL апстрима: " + Вердикт.Ошибка;
	КонецЕсли;

	// правило одно для источника пула и для зеркала: адрес, по которому не удалось
	// подключиться тем же доступом, не сохраняется
	ТокенЗаписи = Секрет.ПринятьВвод(Токен, "");
	ПроверитьПодключение(НормУРЛ, ТокенЗаписи);

	НормРежим = Разбор.Режим(Режим);
	Разбор.ПроверитьФильтр(ФильтрJSON);

	МаксНаПул = ЧислаЗеркал.ЗеркалНаПул();
	Существующие = СписокПула(Пул.Идентификатор);
	Если Существующие.Количество() >= МаксНаПул Тогда
		ВызватьИсключение СтрШаблон("Достигнут лимит зеркал на пул (%1)", МаксНаПул);
	КонецЕсли;
	Если ХранилищеЗеркал.НайтиПоПулИАпстриму(Пул.Идентификатор, НормУРЛ) <> Неопределено Тогда
		ВызватьИсключение "Зеркало на этот апстрим в пуле уже существует";
	КонецЕсли;

	Зеркало = ХранилищеЗеркал.СоздатьЭлемент();
	Зеркало.ПулНазначенияИдентификатор = Цел(Пул.Идентификатор);
	Зеркало.АпстримURL = НормУРЛ;
	Зеркало.ТокенДоступа = ТокенЗаписи;
	Зеркало.Режим = НормРежим;
	Зеркало.ФильтрJSON = ?(ЗначениеЗаполнено(ФильтрJSON), Строка(ФильтрJSON), "");
	Зеркало.ИнтервалСинкаСек = Разбор.Интервал(ИнтервалСинкаСек);
	Зеркало.Включено = Истина;
	Зеркало.РазрешитьПриватные = Ложь;
	Зеркало.ПоследнийСинк = '00010101000000';
	Зеркало.Статус = "создано, ещё не синхронизировано";
	Зеркало.СостояниеПрогона = Прогон.Состояния().Простаивает;
	Зеркало.ПрогонНачат = '00010101000000';
	Зеркало.ПрогонОбновлён = '00010101000000';
	Зеркало.ПрогонВсего = 0;
	Зеркало.ПрогонСкачано = 0;
	Зеркало.ПрогонПропущено = 0;
	Зеркало.ПрогонОшибок = 0;
	Зеркало.ПрогонНедоступно = 0;
	Зеркало.ПрогонИмёнВсего = 0;
	Зеркало.ПрогонИмёнПройдено = 0;
	Зеркало.ПрогонКурсор = "";
	Зеркало.ПрогонЗапустил = "";
	// первый обход нового зеркала — всегда полный: инкременту не от чего отсчитывать
	Зеркало.ВычитаноДо = '00010101000000';
	Зеркало.ПрогонСрезС = '00010101000000';
	Зеркало.ПрогонМоментСреза = '00010101000000';
	Зеркало.СозданКем = ?(Пользователь = Неопределено, 0, Цел(Пользователь.Идентификатор));
	Зеркало.Создан = ТекущаяУниверсальнаяДата();
	Зеркало.Обновлён = Зеркало.Создан;
	Зеркало.Сохранить();

	Возврат Зеркало;

КонецФункции

// Включает либо выключает зеркало пула. Идемпотентна.
//
// Параметры:
//  Пользователь - Пользователь - инициатор, обязан быть владельцем либо админом пула.
//  Пул - Пул - пул назначения зеркала.
//  Идентификатор - Число - идентификатор зеркала.
//  Включено - Булево - новое состояние.
//
// Возвращаемое значение:
//  Булево - Истина, если зеркало найдено в этом пуле и обновлено.
//
// Выбрасывает исключение без прав администрирования пула.
//
Функция Переключить(Знач Пользователь, Знач Пул, Знач Идентификатор, Знач Включено) Экспорт

	ТребоватьПрава(Пользователь, Пул);
	Зеркало = ЗеркалоПула(Пул, Идентификатор);
	Если Зеркало = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Зеркало.Включено = (Включено = Истина);
	Зеркало.Обновлён = ТекущаяУниверсальнаяДата();
	Зеркало.Сохранить();
	Возврат Истина;

КонецФункции

// Задаёт зеркалу токен доступа к приватной выдаче апстрима. Пустое значение и маска
// оставляют прежний токен: правка прочих полей зеркала вводить его заново не требует.
//
// Параметры:
//  Пользователь - Пользователь - инициатор, обязан быть владельцем либо админом пула.
//  Пул - Пул - пул назначения зеркала.
//  Идентификатор - Число - идентификатор зеркала.
//  Токен - Строка - новое значение токена.
//
// Возвращаемое значение:
//  Булево - Истина, если зеркало найдено в этом пуле.
//
// Выбрасывает исключение без прав администрирования пула и при непригодном токене.
//
Функция ЗадатьТокен(Знач Пользователь, Знач Пул, Знач Идентификатор, Знач Токен) Экспорт

	Зеркало = АдминистрируемоеЗеркало(Пользователь, Пул, Идентификатор);
	Если Зеркало = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗаписатьТокен(Зеркало, Секрет.ПринятьВвод(Токен, Секрет.ИзИсточника(Зеркало)));
	Возврат Истина;

КонецФункции

// Снимает токен доступа с зеркала: апстрим возвращается к анонимному чтению.
// Идемпотентна.
//
// Параметры:
//  Пользователь - Пользователь - инициатор, обязан быть владельцем либо админом пула.
//  Пул - Пул - пул назначения зеркала.
//  Идентификатор - Число - идентификатор зеркала.
//
// Возвращаемое значение:
//  Булево - Истина, если зеркало найдено в этом пуле.
//
// Выбрасывает исключение без прав администрирования пула.
//
Функция СнятьТокен(Знач Пользователь, Знач Пул, Знач Идентификатор) Экспорт

	Зеркало = АдминистрируемоеЗеркало(Пользователь, Пул, Идентификатор);
	Если Зеркало = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗаписатьТокен(Зеркало, "");
	Возврат Истина;

КонецФункции

// Удаляет зеркало пула.
//
// Параметры:
//  Пользователь - Пользователь - инициатор, обязан быть владельцем либо админом пула.
//  Пул - Пул - пул назначения зеркала.
//  Идентификатор - Число - идентификатор зеркала.
//
// Возвращаемое значение:
//  Булево - Истина, если зеркало найдено в этом пуле и удалено.
//
// Выбрасывает исключение без прав администрирования пула.
//
Функция Удалить(Знач Пользователь, Знач Пул, Знач Идентификатор) Экспорт

	ТребоватьПрава(Пользователь, Пул);
	Зеркало = ЗеркалоПула(Пул, Идентификатор);
	Если Зеркало = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ХранилищеЗеркал.Удалить(Зеркало);
	Возврат Истина;

КонецФункции

// Зеркало пула по идентификатору с проверкой принадлежности пулу.
// Прав не спрашивает: гейт — на вызывающем контроллере «синхронизировать сейчас».
//
// Параметры:
//  Пул - Пул - пул назначения зеркала.
//  Идентификатор - Число - идентификатор зеркала.
//
// Возвращаемое значение:
//  ЗеркалоХаба, Неопределено - Неопределено, если зеркало не найдено либо принадлежит другому пулу.
//
Функция ЗеркалоПула(Знач Пул, Знач Идентификатор) Экспорт
	Зеркало = ХранилищеЗеркал.ПолучитьОдноПоИдентификаторРавно(Цел(Идентификатор));
	Если Зеркало = Неопределено ИЛИ Зеркало.ПулНазначенияИдентификатор <> Цел(Пул.Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Зеркало;
КонецФункции

// Все включённые зеркала хаба — системный путь синк-джоба.
// Фильтрация идёт в приложении, чтобы работать на любом бэкенде БД.
//
// Возвращаемое значение:
//  Массив из ЗеркалоХаба - зеркала с признаком Включено.
//
Функция ВключённыеЗеркала() Экспорт
	Результат = Новый Массив();
	Для Каждого Зеркало Из ХранилищеЗеркал.Все() Цикл
		Если Зеркало.Включено = Истина Тогда
			Результат.Добавить(Зеркало);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Зеркало по идентификатору без привязки к пулу — системный путь «синхронизировать сейчас».
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//
// Возвращаемое значение:
//  ЗеркалоХаба, Неопределено - Неопределено, если зеркало не найдено.
//
Функция ПоИдентификатору(Знач Идентификатор) Экспорт
	Возврат ХранилищеЗеркал.ПолучитьОдноПоИдентификаторРавно(Цел(Идентификатор));
КонецФункции

// Состояние прогона синхронизации зеркала — то, что показывает экран и по чему
// очередь решает, ставить ли прогон.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если зеркала нет; иначе Состояние (Строка),
//   Идёт (Булево), Начат, Обновлён (Дата), Всего, Скачано, Пропущено, Ошибок,
//   Недоступно (Число), Курсор, Запустил, Статус (Строка), ПоследнийСинк (Дата).
//
Функция СостояниеПрогона(Знач Идентификатор) Экспорт
	Возврат Прогон.Состояние(Идентификатор);
КонецФункции

// То же состояние по уже прочитанной записи — вопрос списков: они держат записи в руках,
// и второе чтение на каждое зеркало превращает страницу в N+1 запрос к базе.
//
// Параметры:
//  Зеркало - ЗеркалоХаба, Неопределено - прочитанная запись зеркала.
//
// Возвращаемое значение:
//  Структура, Неопределено - те же поля, что у СостояниеПрогона().
//
Функция СостояниеПрогонаПоЗаписи(Знач Зеркало) Экспорт
	Возврат Прогон.СостояниеПоЗаписи(Зеркало);
КонецФункции

// Ставит прогон зеркала в очередь на синхронизацию. Идущий либо уже поставленный прогон
// второй раз не ставится — так расписание и кнопка не запускают синк дважды.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//  Запустил - Строка - идентификатор пользователя; пусто — плановый запуск
//             (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Булево - Истина, если прогон поставлен этим вызовом.
//
Функция ПоставитьПрогон(Знач Идентификатор, Знач Запустил = "") Экспорт
	Возврат Прогон.Поставить(Идентификатор, Запустил);
КонецФункции

// Через сколько секунд молчания прогон зеркала считается брошенным.
//
// Возвращаемое значение:
//  Число - секунды.
//
Функция ПорогЗависанияПрогона() Экспорт
	Возврат Прогон.ПорогЗависания();
КонецФункции

// Ведёт ли прогон зеркала кто-то прямо сейчас — по записи, а не по памяти процесса.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//
// Возвращаемое значение:
//  Булево - Истина, если прогон числится идущим и не брошен.
//
Функция ПрогонИдёт(Знач Идентификатор) Экспорт
	Возврат Прогон.Идёт(Идентификатор);
КонецФункции

// То же по уже прочитанной записи — вопрос списков: см. СостояниеПрогонаПоЗаписи.
//
// Параметры:
//  Зеркало - ЗеркалоХаба, Неопределено - прочитанная запись зеркала.
//
// Возвращаемое значение:
//  Булево - Истина, если прогон числится идущим и не брошен.
//
Функция ПрогонИдётПоЗаписи(Знач Зеркало) Экспорт
	Возврат Прогон.ИдётПоЗаписи(Зеркало);
КонецФункции

// Брошен ли прогон уже прочитанной записи — вопрос экранов: они держат запись в руках
// и второго чтения базы себе позволить не могут.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - прочитанная запись зеркала.
//
// Возвращаемое значение:
//  Булево - Истина, если прогон числится занятым и молчит дольше порога.
//
Функция ПрогонБрошен(Знач Зеркало) Экспорт
	Возврат Прогон.ЗаписьБрошена(Зеркало);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Не подключился — не сохраняем. Контейнер без пробника пробу не делает: ходить нечем.
Процедура ПроверитьПодключение(Знач Url, Знач Токен)

	Если Пробник = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Пробник.ТребоватьПодключение(Url, Токен);

КонецПроцедуры

// Право спрашивается на каждой мутации зеркала — токен здесь не исключение.
Функция АдминистрируемоеЗеркало(Знач Пользователь, Знач Пул, Знач Идентификатор)
	ТребоватьПрава(Пользователь, Пул);
	Возврат ЗеркалоПула(Пул, Идентификатор);
КонецФункции

// Смена доступа меняет состав источника, поэтому обход начинается заново — с чистой памятью.
Процедура ЗаписатьТокен(Зеркало, Знач Токен)

	Зеркало.ТокенДоступа = Токен;
	Зеркало.ВычитаноДо = '00010101000000';
	Зеркало.ПрогонСрезС = '00010101000000';
	Зеркало.ПрогонМоментСреза = '00010101000000';
	Зеркало.ПрогонКурсор = "";
	Зеркало.Обновлён = ТекущаяУниверсальнаяДата();
	Зеркало.Сохранить();

КонецПроцедуры

Процедура ТребоватьПрава(Знач Пользователь, Знач Пул)
	Если Пул = Неопределено Тогда
		ВызватьИсключение "Пул назначения не задан";
	КонецЕсли;
	Если НЕ СервисПрав.МожетАдминистрировать(Пользователь, Пул) Тогда
		ВызватьИсключение "Недостаточно прав для управления зеркалами пула (требуется owner/admin)";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

&Прозвище("СервисЗеркал")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеЗеркалХабов") _ХранилищеЗеркал,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ВалидаторАдресаАпстрима") _Валидатор,
	&Пластилин(Значение = "ПробникИсточника", Тип = "Массив") _Пробник,
	&Пластилин(Значение = "ПрогонЗеркала") _Прогон,
	&Пластилин(Значение = "ЧислаЗеркалирования") _ЧислаЗеркал,
	&Пластилин(Значение = "РазборНастроекЗеркала") _Разбор,
	&Пластилин(Значение = "СекретИсточника") _Секрет = Неопределено)

	Секрет = ?(_Секрет = Неопределено, Новый СекретИсточника(), _Секрет);
	ХранилищеЗеркал = _ХранилищеЗеркал;
	СервисПрав = _СервисПрав;
	Валидатор = _Валидатор;
	// пробник живёт в модуле прокси: контейнер без него заводит зеркало без пробы
	Пробник = ?(_Пробник = Неопределено ИЛИ _Пробник.Количество() = 0, Неопределено, _Пробник[0]);
	Прогон = _Прогон;
	ЧислаЗеркал = _ЧислаЗеркал;
	Разбор = _Разбор;

КонецПроцедуры
