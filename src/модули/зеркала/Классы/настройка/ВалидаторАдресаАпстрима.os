// Форма адреса источника: схема http либо https, отсутствие userinfo, непустой хост,
// отсутствие управляющих символов. Куда адрес ведёт — не судится.

Перем ВалидаторХоста; // ВалидаторАдресаВебхука (подписки) — канонизация литералов и разбор строки
Перем Адреса;        // РазборАдреса (основа)

#Область ПубличныйИнтерфейс

// Проверяет, что строка вообще является адресом выдачи внешнего хаба.
// О сети, в которой живёт адрес, не говорит ничего. Исключений не бросает.
//
// Параметры:
//  URL - Строка - базовый URL источника, схема http либо https.
//
// Возвращаемое значение:
//  Структура - Ок (Булево), Ошибка (Строка, причина отказа при Ок = Ложь).
//
Функция Проверить(Знач URL) Экспорт

	Разбор = РазобратьАдрес(URL);
	Возврат ?(Разбор.Ок, Ок(), Отказ(Разбор.Ошибка));

КонецФункции

// Форма адреса плюс сетевая политика по литералам: link-local, обфусцированные записи IPv4
// и приватные адреса отклоняются. DNS-имя не резолвится и пропускается.
// Потребитель один — адреса доверенных издателей CI, которым хаб доверяет подписи.
//
// Параметры:
//  URL - Строка - проверяемый URL, схема http либо https.
//
// Возвращаемое значение:
//  Структура - Ок (Булево), Ошибка (Строка, причина отказа при Ок = Ложь).
//
Функция ПроверитьБезРезолва(Знач URL) Экспорт

	Разбор = РазобратьАдрес(URL);
	Если НЕ Разбор.Ок Тогда
		Возврат Отказ(Разбор.Ошибка);
	КонецЕсли;

	Хост = Разбор.Хост;
	Если НЕ ЭтоЛитералАдреса(Хост) Тогда
		Возврат Ок();
	КонецЕсли;

	Если ВалидаторХоста.ХостLinkLocal(Хост) Тогда
		Возврат Отказ(СтрШаблон(
			"Адрес ""%1"" — link-local (169.254.0.0/16 или fe80::/10, сюда же сервис"
			+ " метаданных облака). Запрещён независимо от настроек.", Хост));
	КонецЕсли;

	Проблема = ПроблемаОбфускации(Хост);
	Если ЗначениеЗаполнено(Проблема) Тогда
		Возврат Отказ(Проблема);
	КонецЕсли;

	Если ВалидаторХоста.ХостПриватный(Хост) Тогда
		Возврат Отказ(СтрШаблон("Хост ""%1"" приватный/loopback", Хост));
	КонецЕсли;

	Возврат Ок();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает Структуру(Ок, Ошибка, Хост): разбор строки без единого суждения о сети.
Функция РазобратьАдрес(Знач URL)

	Значение = СокрЛП(Строка(URL));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат ПлохойАдрес("Пустой URL источника");
	КонецЕсли;

	Управляющий = ВалидаторХоста.НайтиУправляющий(Значение);
	Если ЗначениеЗаполнено(Управляющий) Тогда
		Возврат ПлохойАдрес(СтрШаблон(
			"URL источника содержит управляющий символ или пробел (%1) — это не адрес", Управляющий));
	КонецЕсли;

	Позиция = Найти(Значение, "://");
	Если Позиция = 0 Тогда
		Возврат ПлохойАдрес("URL источника должен содержать схему (http:// или https://)");
	КонецЕсли;

	Схема = НРег(Лев(Значение, Позиция - 1));
	Если Схема <> "http" И Схема <> "https" Тогда
		Возврат ПлохойАдрес(СтрШаблон("Недопустимая схема ""%1"" — только http или https", Схема));
	КонецЕсли;

	Авторитет = Адреса.Авторитет(Сред(Значение, Позиция + 3));
	Если Найти(Авторитет, "@") > 0 Тогда
		Возврат ПлохойАдрес("userinfo в URL (user@host) не допускается");
	КонецЕсли;

	Хост = НРег(Адреса.Хост(Авторитет));
	Если НЕ ЗначениеЗаполнено(Хост) Тогда
		Возврат ПлохойАдрес("Не удалось определить хост в URL источника");
	КонецЕсли;

	Возврат Новый Структура("Ок, Ошибка, Хост", Истина, "", Хост);

КонецФункции

Функция ПлохойАдрес(Знач Причина)
	Возврат Новый Структура("Ок, Ошибка, Хост", Ложь, Причина, "");
КонецФункции

// Литерал разбирается строкой; всё остальное — DNS-имя, о котором без резолва сказать нечего.
Функция ЭтоЛитералАдреса(Знач Хост)

	Если Хост = "localhost" ИЛИ Адреса.ЗаканчиваетсяНа(Хост, ".localhost") Тогда
		Возврат Истина;
	КонецЕсли;
	Если Найти(Хост, ":") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ВалидаторХоста.РазобратьIPv4Литерал(Хост) <> Неопределено;

КонецФункции

// IPv4 вне канонической записи и IPv4, завёрнутый в IPv6; чистый IPv6 обфускацией не считается.
Функция ПроблемаОбфускации(Знач Хост)

	Если Найти(Хост, ":") = 0 Тогда
		АдресЧислом = ВалидаторХоста.РазобратьIPv4Литерал(Хост);
		Если АдресЧислом <> Неопределено И Хост <> КаноническийIPv4(АдресЧислом) Тогда
			Возврат СтрШаблон(
				"Адрес ""%1"" записан в обфусцированной форме (каноническая запись — ""%2"")."
				+ " Такие формы не принимаются ни при каких настройках.", Хост, КаноническийIPv4(АдресЧислом));
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Вложенный = ВалидаторХоста.ВложенныйIPv4(Хост);
	Если Вложенный <> Неопределено Тогда
		Возврат СтрШаблон(
			"Адрес ""%1"" — это IPv4 %2, записанный через IPv6 (mapped/compat/NAT64)."
			+ " Такие формы не принимаются ни при каких настройках: пишите адрес как ""%2"".",
			Хост, КаноническийIPv4(Вложенный));
	КонецЕсли;

	Возврат "";

КонецФункции

Функция КаноническийIPv4(Знач АдресЧислом)

	О1 = Цел(АдресЧислом / 16777216);
	Ост = АдресЧислом - О1 * 16777216;
	О2 = Цел(Ост / 65536);
	Ост = Ост - О2 * 65536;
	О3 = Цел(Ост / 256);
	О4 = Ост - О3 * 256;

	// ЧН=0 обязателен: Формат(0, "ЧГ=0") даёт пустую строку, и «10.0.0.5» стало бы «10...5»
	Возврат СтрШаблон("%1.%2.%3.%4", Формат(О1, "ЧГ=0; ЧН=0"), Формат(О2, "ЧГ=0; ЧН=0"),
		Формат(О3, "ЧГ=0; ЧН=0"), Формат(О4, "ЧГ=0; ЧН=0"));

КонецФункции

Функция Ок()
	Возврат Новый Структура("Ок, Ошибка", Истина, "");
КонецФункции

Функция Отказ(Знач Причина)
	Возврат Новый Структура("Ок, Ошибка", Ложь, Причина);
КонецФункции

#КонецОбласти

&Прозвище("ВалидаторАдресаАпстрима")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВалидаторАдресаВебхука") _ВалидаторХоста,
	&Пластилин(Значение = "РазборАдреса") _Адреса = Неопределено)

	Адреса = ?(_Адреса = Неопределено, Новый РазборАдреса(), _Адреса);
	ВалидаторХоста = _ВалидаторХоста;

КонецПроцедуры
