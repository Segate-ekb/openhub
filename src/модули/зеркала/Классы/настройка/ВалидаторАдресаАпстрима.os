// Форма адреса источника: схема http либо https, отсутствие userinfo, непустой хост,
// отсутствие управляющих символов. Куда адрес ведёт — не судится.

Перем Форма;         // ФормаАдреса (основа) — общий каркас проверки формы адреса
Перем Вердикты;      // Вердикт (основа) — форма ответа

#Область ПубличныйИнтерфейс

// Проверяет, что строка вообще является адресом выдачи внешнего хаба.
// О сети, в которой живёт адрес, не говорит ничего. Исключений не бросает.
//
// Параметры:
//  URL - Строка - базовый URL источника, схема http либо https.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Сообщение (Строка, причина отказа словами).
//
Функция Проверить(Знач URL) Экспорт

	Разбор = Разобрать(URL);
	Возврат ?(Разбор.Успех, Вердикты.УспехСловами(), Вердикты.ОтказСловами(Разбор.Сообщение));

КонецФункции

// Разбирает адрес источника и отдаёт его хост. Ни одного суждения о сети: хост нужен тем,
// кто судит её сам — сегодня это издатель доверенного конвейера.
//
// Параметры:
//  URL - Строка - базовый URL источника, схема http либо https.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Сообщение (Строка, причина отказа словами),
//              Хост (Строка, в нижнем регистре, без скобок и порта).
//
Функция Разобрать(Знач URL) Экспорт

	Коды = Форма.Коды();
	Разбор = Форма.Разобрать(URL, "http,https");

	Если Разбор.Код = Коды.Пусто Тогда
		Возврат ПлохойАдрес("Пустой URL источника");
	ИначеЕсли Разбор.Код = Коды.Управляющий Тогда
		Возврат ПлохойАдрес(СтрШаблон(
			"URL источника содержит управляющий символ или пробел (%1) — это не адрес", Разбор.Символ));
	ИначеЕсли Разбор.Код = Коды.СхемыНет Тогда
		Возврат ПлохойАдрес("URL источника должен содержать схему (http:// или https://)");
	ИначеЕсли Разбор.Код = Коды.ЧужаяСхема Тогда
		Возврат ПлохойАдрес(СтрШаблон(
			"Недопустимая схема ""%1"" — только http или https", Разбор.Схема));
	ИначеЕсли Разбор.Код = Коды.ДанныеПользователя Тогда
		Возврат ПлохойАдрес("userinfo в URL (user@host) не допускается");
	ИначеЕсли Разбор.Код = Коды.ХостаНет Тогда
		Возврат ПлохойАдрес("Не удалось определить хост в URL источника");
	КонецЕсли;

	Возврат Вердикты.УспехСловами(Новый Структура("Хост", Разбор.Хост));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПлохойАдрес(Знач Сообщение)
	Возврат Вердикты.ОтказСловами(Сообщение, Новый Структура("Хост", ""));
КонецФункции

#КонецОбласти

&Прозвище("ВалидаторАдресаАпстрима")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ФормаАдреса") _Форма = Неопределено)

	Форма = ?(_Форма = Неопределено, Новый ФормаАдреса(), _Форма);
	Вердикты = Новый Вердикт();

КонецПроцедуры
