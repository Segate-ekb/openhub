// Числа зеркалирования: единственное место, где называются ключи oshub.mirror.*.
// Значение спрашивается на каждый вызов — правка в настройках хаба действует без рестарта.

Перем Настройки;  // СервисНастроек (настройки) — опционален
Перем Числа;      // ПриведениеЧисел (основа)

#Область ПубличныйИнтерфейс

// Ведёт ли хаб фоновую синхронизацию зеркал.
//
// Возвращаемое значение:
//  Булево.
//
Функция СинхронизацияВключена() Экспорт
	Возврат Флаг("oshub.mirror.sync_enabled", Истина);
КонецФункции

// Сколько зеркал разрешено одному пулу.
//
// Возвращаемое значение:
//  Число.
//
Функция ЗеркалНаПул() Экспорт
	Возврат Целое("oshub.mirror.max_per_pool", 5, 1);
КонецФункции

// Период синхронизации зеркала, не задавшего свой, секунды.
//
// Возвращаемое значение:
//  Число.
//
Функция ИнтервалПоУмолчанию() Экспорт
	Возврат Целое("oshub.mirror.default_interval_sec", 3600, 1);
КонецФункции

// Нижняя граница периода синхронизации зеркала, секунды.
//
// Возвращаемое значение:
//  Число.
//
Функция НаименьшийИнтервал() Экспорт
	Возврат Целое("oshub.mirror.min_interval_sec", 60, 1);
КонецФункции

// После скольких секунд молчания прогон считается брошенным.
//
// Возвращаемое значение:
//  Число.
//
Функция ПорогЗависания() Экспорт
	Возврат Целое("oshub.mirror.run_stale_sec", 300, 1);
КонецФункции

// Сколько ПАКЕТОВ перечисляется за один цикл обхода.
//
// Возвращаемое значение:
//  Число.
//
Функция РазмерПорции() Экспорт
	Возврат Целое("oshub.mirror.max_packages_per_cycle", 25, 1);
КонецФункции

// Сколько циклов делает один плановый прогон.
//
// Возвращаемое значение:
//  Число.
//
Функция ЦикловЗаПрогон() Экспорт
	Возврат Целое("oshub.mirror.max_cycles_per_run", 20, 1);
КонецФункции

// Сколько циклов рабочий берёт за один заход в очередь.
//
// Возвращаемое значение:
//  Число.
//
Функция ЦикловЗаЗаход() Экспорт
	Возврат Целое("oshub.mirror.cycles_per_turn", 20, 1);
КонецФункции

// Потолок очереди заявок на синхронизацию.
//
// Возвращаемое значение:
//  Число.
//
Функция ПотолокОчереди() Экспорт
	Возврат Целое("oshub.mirror.queue_max", 100, 1);
КонецФункции

// Как часто рабочий заглядывает в очередь, секунды.
//
// Возвращаемое значение:
//  Число.
//
Функция ПериодОпросаОчереди() Экспорт
	Возврат Целое("oshub.mirror.queue_poll_sec", 2, 1);
КонецФункции

// Ключи зеркалирования в порядке, в котором они показываются оператору.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Ключи() Экспорт

	Результат = Новый Массив();
	Для Каждого Ключ Из СтрРазделить("oshub.mirror.sync_enabled,oshub.mirror.max_per_pool,"
		+ "oshub.mirror.default_interval_sec,oshub.mirror.min_interval_sec,"
		+ "oshub.mirror.run_stale_sec,oshub.mirror.max_packages_per_cycle,"
		+ "oshub.mirror.max_cycles_per_run,oshub.mirror.queue_max,"
		+ "oshub.mirror.cycles_per_turn,oshub.mirror.queue_poll_sec", ",") Цикл
		Результат.Добавить(Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Нечитаемая настройка не вправе остановить синхронизацию: берётся умолчание кода.
Функция Целое(Знач Ключ, Знач Дефолт, Знач Минимум)

	Если Настройки = Неопределено Тогда
		Возврат Макс(Минимум, Дефолт);
	КонецЕсли;

	Попытка
		Возврат Макс(Минимум, Цел(Числа.ЧислоИлиДефолт(Настройки.Значение(Ключ), Дефолт)));
	Исключение
		Возврат Макс(Минимум, Дефолт);
	КонецПопытки;

КонецФункции

Функция Флаг(Знач Ключ, Знач Дефолт)

	Если Настройки = Неопределено Тогда
		Возврат Дефолт;
	КонецЕсли;

	Попытка
		Значение = Настройки.Значение(Ключ);
	Исключение
		Возврат Дефолт;
	КонецПопытки;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Норма = НРег(СокрЛП(Строка(Значение)));
	Если НЕ ЗначениеЗаполнено(Норма) Тогда
		Возврат Дефолт;
	КонецЕсли;
	Возврат Норма = "истина" ИЛИ Норма = "true" ИЛИ Норма = "1" ИЛИ Норма = "да";

КонецФункции

#КонецОбласти

&Прозвище("ЧислаЗеркалирования")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "СервисНастроек", Тип = "Массив") _Настройки = Неопределено)

	Числа = _Числа;
	Настройки = ПервыйЖелудь(_Настройки);

КонецПроцедуры

// Разбираются все три формы внедрения: ФиксированныйМассив ОСени, обычный Массив и сам объект.
Функция ПервыйЖелудь(Знач Зависимость)

	Если Зависимость = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТипЗнч(Зависимость) = Тип("Массив")
		ИЛИ ТипЗнч(Зависимость) = Тип("ФиксированныйМассив") Тогда
		Возврат ?(Зависимость.Количество() = 0, Неопределено, Зависимость[0]);
	КонецЕсли;
	Возврат Зависимость;

КонецФункции
