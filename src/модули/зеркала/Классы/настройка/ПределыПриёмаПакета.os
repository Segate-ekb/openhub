// Пределы приёма пакета для пути зеркалирования: те же числа oshub.publish.max_*,
// которыми судится публикация снаружи. Своих чисел у зеркала нет.

#Использовать ospx-tools

Перем Настройки;  // СервисНастроек (настройки) — опционален
Перем Желуди;     // ВнедрённыеЖелуди (основа) — три формы внедрения необязательной зависимости

#Область ПубличныйИнтерфейс

// Наибольший размер принимаемого артефакта, байт.
//
// Возвращаемое значение:
//  Число.
//
Функция РазмерАртефакта() Экспорт
	Возврат Целое("oshub.publish.max_upload_bytes", 26214400);
КонецФункции

// Ключ настройки, которой судится размер принимаемого артефакта.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючРазмераАртефакта() Экспорт
	Возврат "oshub.publish.max_upload_bytes";
КонецФункции

// Ограничения разбора .ospx по действующим настройкам хаба. Читаются на каждый разбор:
// правка предела действует сразу, без рестарта.
//
// Возвращаемое значение:
//  ОграниченияРаспаковки.
//
Функция ОграниченияРазбора() Экспорт

	ОбщийРазмер = Целое("oshub.publish.max_unpacked_bytes", 67108864);
	Возврат ПакетыOspx.НовыеОграничения()
		.УстановитьМаксимальныйОбщийРазмер(ОбщийРазмер)
		.УстановитьМаксимальноеКоличествоФайлов(Целое("oshub.publish.max_files", 5000))
		.УстановитьМаксимальнуюГлубинуПутей(24)
		.УстановитьМаксимальныйРазмерМанифеста(Целое("oshub.publish.max_manifest_bytes", 524288))
		.УстановитьМаксимальныйРазмерREADME(1024 * 1024)
		.УстановитьМаксимальнуюТранзиторнуюЗапись(ОбщийРазмер);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Контейнер без модуля настроек берёт умолчание кода: нечитаемая настройка не вправе
// обнулить предел.
Функция Целое(Знач Ключ, Знач Дефолт)
	Возврат ?(Настройки = Неопределено, Дефолт, Настройки.Целое(Ключ, Дефолт, 1));
КонецФункции

#КонецОбласти

&Прозвище("ПределыПриёмаПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек", Тип = "Массив") _Настройки = Неопределено)

	Желуди = Новый ВнедрённыеЖелуди();
	Настройки = Желуди.ПервыйИз(_Настройки);

КонецПроцедуры
