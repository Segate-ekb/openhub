// Канонизация и проверка того, что пришло в зеркало снаружи: адрес апстрима, режим,
// фильтр имён и интервал синхронизации. Негодное отвергается сразу при настройке.

Перем ЧислаЗеркал;  // ЧислаЗеркалирования (зеркала) — умолчание и нижняя граница интервала
Перем Числа;        // ПриведениеЧисел (основа)
Перем Адреса;       // РазборАдреса (основа) — канонизация адреса апстрима

#Область ПубличныйИнтерфейс

// Режимы синхронизации, поддерживаемые движком, — источник истины для UI и валидации.
// Режим появляется здесь ОДНОВРЕМЕННО со своим ИсточникомАпстрима: без источника зеркало
// такого режима молча не реплицировало бы.
//
// Возвращаемое значение:
//  Массив из Строка - имена режимов.
//
Функция ИзвестныеРежимы() Экспорт
	Результат = Новый Массив();
	Результат.Добавить("opm");
	Результат.Добавить("api-v1");
	Возврат Результат;
КонецФункции

// Каноничный режим. Неизвестный отвергается исключением.
//
// Параметры:
//  Режим - Строка - режим из формы либо тела запроса.
//
// Возвращаемое значение:
//  Строка.
//
Функция Режим(Знач СыройРежим) Экспорт

	Норм = НРег(СокрЛП(Строка(СыройРежим)));
	Если ИзвестныеРежимы().Найти(Норм) = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Неизвестный режим зеркала ""%1"" (ожидается opm или api-v1)", СыройРежим);
	КонецЕсли;
	Возврат Норм;

КонецФункции

// Интервал синхронизации зеркала: непонятное и неположительное берёт умолчание хаба,
// заданное — поднимается до наименьшего разрешённого.
//
// Параметры:
//  Значение - Произвольный - интервал из формы либо тела запроса.
//
// Возвращаемое значение:
//  Число - секунды.
//
Функция Интервал(Знач Значение) Экспорт

	Секунды = Числа.ЧислоИлиДефолт(Значение, 0);
	Если Секунды <= 0 Тогда
		Возврат ЧислаЗеркал.ИнтервалПоУмолчанию();
	КонецЕсли;
	Возврат Макс(ЧислаЗеркал.НаименьшийИнтервал(), Цел(Секунды));

КонецФункции

// Проверяет фильтр имён. Некорректный JSON — исключение сразу при настройке.
//
// Параметры:
//  ФильтрJSON - Строка - JSON-массив масок имён; пустая строка пропускает всё.
//
Процедура ПроверитьФильтр(Знач ФильтрJSON) Экспорт

	Если НЕ ЗначениеЗаполнено(ФильтрJSON) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(ФильтрJSON);
		Разобрано = ПрочитатьJSON(Чтение);
	Исключение
		// без текста платформенного разбора: он несёт координаты чужого кадра, а не подсказку
		ВызватьИсключение
			"Некорректный JSON фильтра зеркала: ожидается JSON-массив масок имён"
			+ " (например [""corp-*"",""mylib""])";
	КонецПопытки;
	Если ТипЗнч(Разобрано) <> Тип("Массив") Тогда
		ВызватьИсключение "Фильтр зеркала должен быть JSON-массивом масок имён (например [""corp-*"",""mylib""])";
	КонецЕсли;

КонецПроцедуры

// Каноничный адрес апстрима: схема и authority к нижнему регистру, путь и query как есть.
// На этом держится инвариант уникальности пары (пул, URL).
//
// Параметры:
//  URL - Строка - адрес из формы либо тела запроса.
//
// Возвращаемое значение:
//  Строка.
//
Функция Адрес(Знач URL) Экспорт
	Возврат Адреса.Каноничный(URL);
КонецФункции

#КонецОбласти

&Прозвище("РазборНастроекЗеркала")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЧислаЗеркалирования") _ЧислаЗеркал,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа = Неопределено,
	&Пластилин(Значение = "РазборАдреса") _Адреса = Неопределено)

	ЧислаЗеркал = _ЧислаЗеркал;
	Числа = ?(_Числа = Неопределено, Новый ПриведениеЧисел(), _Числа);
	Адреса = ?(_Адреса = Неопределено, Новый РазборАдреса(), _Адреса);

КонецПроцедуры
