// Зеркала, наполняющие удаляемый пул, — реализация контракта ПоследствияУдаленияПула.

Перем ХранилищеЗеркал;  // ХранилищеЗеркалХабов (зеркала)
Перем Снятие;           // СнятиеСтрок (данные) — снятие пачки строк со счётом

// Снимает зеркала, у которых пул — пул назначения.
//
// Параметры:
//  Пул - Пул - удаляемый пул.
//
// Возвращаемое значение:
//  Структура - Зеркал (Число), Строк (Число).
//
Функция СнятьСтрокиПула(Знач Пул) Экспорт

	Зеркал = Снятие.Снять(ХранилищеЗеркал.ПолучитьПоПулНазначенияИдентификаторРавно(Цел(Пул.Идентификатор)));
	Возврат Новый Структура("Зеркал, Строк", Зеркал, Зеркал);

КонецФункции

&Прозвище("ПоследствияУдаленияПула")
&Порядок(40)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеЗеркалХабов") _ХранилищеЗеркал,
	&Пластилин(Значение = "СнятиеСтрок") _Снятие)

	ХранилищеЗеркал = _ХранилищеЗеркал;
	Снятие = _Снятие;

КонецПроцедуры
