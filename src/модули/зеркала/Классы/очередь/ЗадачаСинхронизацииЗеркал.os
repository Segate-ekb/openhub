// Задача планировщика «синхронизация-зеркал»: ставит все включённые зеркала в очередь
// синхронизации. Саму репликацию ведёт фоновый рабочий — цикл планировщика её не ждёт.

Перем Очередь;       // ОчередьСинхронизацииЗеркал
Перем СервисЗеркал;  // СервисЗеркал
Перем Интервал;      // интервал постановки из настройки, секунды

// Регистрация в планировщике: постановка раз в интервал из настройки.
//
// Параметры:
//  Регистрации - РегистрацииЗадачи - куда записывается регистрация.
//
Процедура Зарегистрировать(Регистрации) Экспорт
	Регистрации.КаждыеСекунд("синхронизация-зеркал", Интервал);
КонецПроцедуры

// Ставит заявку на каждое включённое зеркало; уже идущие и уже поставленные пропускаются.
// Сбой прохода перебрасывается планировщику.
//
&Наблюдаемый("job.mirror_sync")
Процедура Исполнить() Экспорт
	ПоставитьВсе();
КонецПроцедуры

// Сколько зеркал поставлено в очередь этим проходом.
//
// Возвращаемое значение:
//  Число - принятых заявок.
//
Функция ПоставитьВсе() Экспорт
	Поставлено = 0;
	Для Каждого Зеркало Из СервисЗеркал.ВключённыеЗеркала() Цикл
		// пустой инициатор = запуск по расписанию, а не человеком
		Если Очередь.Поставить(Зеркало.Идентификатор, "") Тогда
			Поставлено = Поставлено + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Поставлено;
КонецФункции

&Прозвище("ЗадачаПланировщика")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОчередьСинхронизацииЗеркал") _Очередь,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Деталька(Значение = "oshub.jobs.mirror_sync_interval_sec", ЗначениеПоУмолчанию = 3600) _Интервал = Неопределено)

	Очередь = _Очередь;
	СервисЗеркал = _СервисЗеркал;
	Интервал = Новый ПриведениеЧисел().ЧислоИлиДефолт(_Интервал, 3600);

КонецПроцедуры
