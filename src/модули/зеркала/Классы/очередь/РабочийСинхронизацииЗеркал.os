// Фоновый цикл синхронизации зеркал: разбирает очередь заявок и гоняет движок порциями,
// пока апстрим не пройден до конца. Хука завершения приложения нет — цикл вечен.

Перем Очередь;        // ОчередьСинхронизацииЗеркал (зеркала)
Перем СервисЗеркал;   // СервисЗеркал (зеркала)
Перем Синхронизатор;  // СинхронизаторЗеркал (зеркала)
Перем Готовность;     // ГотовностьХаба (наблюдаемость)
Перем ЧислаЗеркал;    // ЧислаЗеркалирования (зеркала) — рубильник, темп и циклы из настроек хаба
Перем Ошибки;         // ТекстОшибки (основа)
Перем Цикл_;          // ФоновыйЦикл (фоновыеЗадания) — каркас вечного цикла
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Крутит фоновый цикл разбора очереди синхронизации до запроса остановки. Рубильник
// oshub.mirror.sync_enabled спрашивается на каждом обороте: выключенный не даёт рабочему
// работы, но и не убивает цикл — включённый экраном действует без рестарта хаба.
//
Процедура ПриЗапускеПриложения() Экспорт

	Сбой = Цикл_.Крутить(ЭтотОбъект, "mirror.синхронизация");
	Если Сбой = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Лог.Ошибка("Фоновый цикл синхронизации зеркал прерван,"
		+ " зеркала больше не синхронизируются: %1", Ошибки.Причина(Сбой));
	// отчёт стои́т разбора цепочки: собираем его только тогда, когда отладку включили
	Если Лог.Уровень() <= УровниЛога.Отладка Тогда
		Лог.Отладка("Фоновый цикл синхронизации зеркал прерван, разбор целиком:%1%2",
			Символы.ПС, Ошибки.ПодробныйОтчёт(Сбой));
	КонецЕсли;

КонецПроцедуры

// Просит фоновый цикл синхронизации завершиться после текущего шага.
//
Процедура Остановить() Экспорт
	Цикл_.Остановить();
КонецПроцедуры

// Разбирает одну заявку очереди: гоняет циклы движка, пока в апстриме остаются
// непройденные имена либо не исчерпан лимит циклов за заход. Недобранное зеркало
// возвращается в хвост очереди, чтобы соседние не ждали конца длинного прогона.
// Наружу не бросает.
//
// Возвращаемое значение:
//  Структура - Взято (Булево, была ли заявка), Зеркало (Число, идентификатор),
//              Циклов (Число, вызовов движка), Возвращено (Булево, зеркало снова в очереди).
//
Функция ОбработатьЗаявку() Экспорт

	Заявка = Очередь.Забрать();
	Итог = Новый Структура("Взято, Зеркало, Циклов, Возвращено", Ложь, 0, 0, Ложь);
	Если Заявка = Неопределено Тогда
		Возврат Итог;
	КонецЕсли;

	Итог.Взято = Истина;
	Итог.Зеркало = Заявка.ЗеркалоИдентификатор;

	ЕстьЕщё = Ложь;
	Сбой = "";
	Попытка
		ЕстьЕщё = ПрогнатьЦиклы(Заявка.ЗеркалоИдентификатор, Итог);
	Исключение
		// ИнформацияОбОшибке достоверна только в кадре обработчика.
		Сбой = Ошибки.Причина(ИнформацияОбОшибке());
	КонецПопытки;

	// Отпускаем ПЕРВЫМ делом: упавший журнал не должен оставить зеркало вечно «идущим».
	// И до повторной постановки — идущее зеркало очередь в себя не принимает.
	Очередь.Завершить(Заявка.ЗеркалоИдентификатор);
	Если ЗначениеЗаполнено(Сбой) Тогда
		// Изоляция: сбой одного зеркала не роняет фоновый цикл.
		Лог.Ошибка("Синхронизация зеркала #%1: сбой заявки (изолирован): %2",
			Заявка.ЗеркалоИдентификатор, Сбой);
	КонецЕсли;
	// После записи о сбое: постановка ходит в базу и сама может упасть, а причина
	// уже прошедшего цикла тогда потерялась бы.
	Если ЕстьЕщё Тогда
		Итог.Возвращено = Очередь.Поставить(Заявка.ЗеркалоИдентификатор, Заявка.ЗапустилИдентификатор);
	КонецЕсли;

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область ЦиклРазбораОчереди

// Выключенный рубильник цикл не отменяет: он спрашивается на каждом обороте, и включённый
// экраном действует без рестарта хаба.
//
// Возвращаемое значение:
//  Булево - Истина: цикл крутится всегда.
//
Функция ПередЦиклом() Экспорт

	Лог.Информация("Фоновая синхронизация зеркал запущена (%1): разбор очереди каждые %2с,"
		+ " до %3 циклов за заход",
		?(ЧислаЗеркал.СинхронизацияВключена(), "включена", "выключена настройкой хаба"),
		ЧислаЗеркал.ПериодОпросаОчереди(), ЧислаЗеркал.ЦикловЗаЗаход());
	Возврат Истина;

КонецФункции

// Истина — заявка была взята, спать не нужно. Сбой разбора не роняет фоновое задание.
//
// Возвращаемое значение:
//  Булево - была ли работа на этом шаге.
//
Функция ШагЦикла() Экспорт
	Попытка
		Возврат ОбработатьЗаявку().Взято;
	Исключение
		Лог.Ошибка("Сбой шага фоновой синхронизации зеркал (изолирован, цикл продолжается): %1",
			Ошибки.Причина(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Ложь;
КонецФункции

// Пауза между шагами, миллисекунды. Спим только на пустой очереди: с бэклогом заявки
// разбираются подряд, иначе накопленные зеркала ждали бы по интервалу каждое.
//
// Возвращаемое значение:
//  Число.
//
Функция ПаузаМс() Экспорт
	Возврат Макс(1, ЧислаЗеркал.ПериодОпросаОчереди()) * 1000;
КонецФункции

// Хвоста у рабочего нет: он останавливается ровно на границе заявки.
//
Процедура ПослеЦикла() Экспорт
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Истина — лимит циклов исчерпан, а в апстриме ещё осталось непройденное.
Функция ПрогнатьЦиклы(Знач ЗеркалоИдентификатор, Итог)

	// строка под перехватом вызывающего: упавший журнал не запирает взятое зеркало
	Лог.Отладка("Заявка зеркала #%1 взята в работу, до %2 циклов за заход",
		ЗеркалоИдентификатор, ЧислаЗеркал.ЦикловЗаЗаход());

	Пока Итог.Циклов < ЧислаЗеркал.ЦикловЗаЗаход() Цикл

		// перечитываем перед каждым циклом: заявка могла ждать, а зеркало — измениться
		Зеркало = СервисЗеркал.ПоИдентификатору(ЗеркалоИдентификатор);
		Если Зеркало = Неопределено Тогда
			Лог.Предупреждение("Синхронизация зеркала #%1: зеркало исчезло — заявка снята",
				ЗеркалоИдентификатор);
			Возврат Ложь;
		КонецЕсли;

		Результат = Синхронизатор.Синхронизировать(Зеркало);
		Итог.Циклов = Итог.Циклов + 1;
		Лог.Отладка("Зеркало #%1: цикл %2 за этот заход, есть ещё: %3",
			ЗеркалоИдентификатор, Итог.Циклов, ЕстьЕщё(Результат));
		Если НЕ ЕстьЕщё(Результат) Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЦикла;

	Возврат Истина;

КонецФункции

// Итог без поля ЕстьЕщё означает «апстрим пройден целиком».
Функция ЕстьЕщё(Знач Результат)
	Значение = Ложь;
	Если Результат <> Неопределено И ТипЗнч(Результат) = Тип("Структура") Тогда
		Результат.Свойство("ЕстьЕщё", Значение);
	КонецЕсли;
	Возврат Значение = Истина;
КонецФункции

#КонецОбласти

&Рогатка(ЗапускатьВФоне = Истина, ОжидатьЗавершения = Ложь)
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОчередьСинхронизацииЗеркал") _Очередь,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Пластилин(Значение = "СинхронизаторЗеркал") _Синхронизатор,
	&Пластилин(Значение = "ГотовностьХаба") _Готовность,
	&Пластилин(Значение = "ЧислаЗеркалирования") _ЧислаЗеркал,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	ЧислаЗеркал = _ЧислаЗеркал;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Очередь = _Очередь;
	СервисЗеркал = _СервисЗеркал;
	Синхронизатор = _Синхронизатор;
	Готовность = _Готовность;
	// Заявка в конструкторе: список гейтов должен быть полон до первого запуска рогаток.
	Готовность.ЗаявитьЗадачу("mirror.синхронизация");
	Цикл_ = Новый ФоновыйЦикл(Готовность, Истина);

КонецПроцедуры
