// Очередь заявок «синхронизировать зеркало» в памяти: дедупликация по зеркалу, выдача
// заявок рабочему и отметка «поставлено» на записи зеркала. Доступ сериализован
// БлокировкойРесурса.

Перем Очередь;      // Массив из Структура — заявки в порядке постановки
Перем ВРаботе;      // Соответствие: идентификатор зеркала → Дата, когда рабочий его взял
Перем Блокировка;   // БлокировкаРесурса — сериализация доступа к Очередь и ВРаботе
Перем СервисЗеркал; // СервисЗеркал (зеркала) — постоянное состояние прогона
Перем ЧислаЗеркал;  // ЧислаЗеркалирования (зеркала) — рубильник и потолок из настроек хаба
Перем Числа;        // ПриведениеЧисел (основа)
Перем Часы;         // Объект с методом Сейчас() -> Дата, либо Неопределено (системные часы)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Ставит зеркало в очередь синхронизации и помечает его прогон поставленным: экран
// читает запись, а не память процесса, и обязан показать очередь сразу по нажатию кнопки.
//
// Параметры:
//  ЗеркалоИдентификатор - Число - идентификатор зеркала.
//  ЗапустилИдентификатор - Строка - логин инициатора; пустая строка — плановый запуск.
//
// Возвращаемое значение:
//  Булево - Истина, если заявка принята; Ложь, если зеркало уже в очереди, его прогон
//  уже идёт, идентификатор зеркала пуст либо фоновая синхронизация выключена настройкой.
//
Функция Поставить(Знач ЗеркалоИдентификатор, Знач ЗапустилИдентификатор) Экспорт

	Ид = Цел(Числа.ЧислоИлиНоль(ЗеркалоИдентификатор));
	Инициатор = СокрЛП(Строка(ЗапустилИдентификатор));
	Кто = ?(ЗначениеЗаполнено(Инициатор), Инициатор, "по расписанию");

	// аргументы отладки — значения под рукой: включённая отладка не стоит хабу ни блокировки,
	// ни запроса к базе
	Лог.Отладка("Заявка на синхронизацию зеркала #%1 (%2) принята к разбору", Ид, Кто);

	Отказ = ПринятьЗаявку(Ид, Инициатор);
	Если ЗначениеЗаполнено(Отказ) Тогда
		// Каждое нажатие обязано оставлять след: жалоба «кнопка вообще ничего не делает»
		// родилась ровно из того, что отвергнутая заявка не писала в журнал ни строки.
		Лог.Предупреждение("Заявка на синхронизацию зеркала #%1 (%2) не принята: %3",
			Ид, Кто, Отказ);
		Возврат Ложь;
	КонецЕсли;

	// Одна запись на нажатие кнопки: без неё между нажатием и первым циклом движка экран
	// показывал бы «простаивает», то есть кнопка выглядела бы не сработавшей.
	СервисЗеркал.ПоставитьПрогон(Ид, Инициатор);
	Лог.Информация("Зеркало #%1 поставлено в очередь синхронизации (%2)", Ид, Кто);
	Возврат Истина;

КонецФункции

// Забирает старейшую заявку и помечает её зеркало идущим. Пока зеркало не отпущено
// Завершить() и не истёк порог зависания, повторная постановка того же зеркала отвергается.
//
// Возвращаемое значение:
//  Структура, Неопределено - заявка (ЗеркалоИдентификатор — Число, ЗапустилИдентификатор —
//  Строка, Поставлена — Дата); Неопределено, если очередь пуста.
//
Функция Забрать() Экспорт

	Блокировка.Заблокировать();
	Попытка
		Заявка = Неопределено;
		Если Очередь.Количество() > 0 Тогда
			Заявка = Очередь[0];
			Очередь.Удалить(0);
			ВРаботе.Вставить(Заявка.ЗеркалоИдентификатор, Сейчас());
		КонецЕсли;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();
	// журнала здесь нет намеренно: зеркало уже помечено взятым, и упавшая строка заперла бы
	// его до перезапуска процесса. О взятой заявке пишет рабочий — там это под перехватом
	Возврат Заявка;

КонецФункции

// Отпускает зеркало: его прогон больше не идёт, новая заявка снова принимается.
//
// Параметры:
//  ЗеркалоИдентификатор - Число - идентификатор зеркала.
//
Процедура Завершить(Знач ЗеркалоИдентификатор) Экспорт

	Блокировка.Заблокировать();
	Попытка
		ВРаботе.Удалить(Цел(Числа.ЧислоИлиНоль(ЗеркалоИдентификатор)));
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();
	// строго ПОСЛЕ отпускания: упавший журнал не вправе оставить зеркало вечно «идущим»
	Лог.Отладка("Рабочий отпустил зеркало #%1", ЗеркалоИдентификатор);

КонецПроцедуры

// Подставляет источник времени — тестовый шов; в рабочем контейнере не вызывается.
//
// Параметры:
//  ИсточникВремени - Произвольный - объект с методом Сейчас(), возвращающим Дату.
//
Процедура УстановитьЧасы(Знач ИсточникВремени) Экспорт
	Часы = ИсточникВремени;
КонецПроцедуры

// Что очередь знает о зеркале прямо сейчас.
//
// Параметры:
//  ЗеркалоИдентификатор - Число - идентификатор зеркала.
//
// Возвращаемое значение:
//  Строка - "выключено" (фоновая синхронизация отключена настройкой), "идёт", "поставлено"
//  либо "простаивает".
//
Функция Состояние(Знач ЗеркалоИдентификатор) Экспорт

	Значение = СостояниеПамяти(ЗеркалоИдентификатор);
	Если Значение <> "простаивает" Тогда
		Возврат Значение;
	КонецЕсли;

	// Запись спрашивается ВНЕ блокировки: она ходит в базу, а под этой блокировкой стоит
	// горячий путь HTTP.
	Возврат ?(ПрогонВедётся(ЗеркалоИдентификатор), "идёт", Значение);

КонецФункции

// То же по УЖЕ ПРОЧИТАННОЙ записи: список пула держит записи в руках, и второе чтение
// на каждое зеркало превращало страницу в N+1 запрос к базе.
//
// Параметры:
//  Зеркало - ЗеркалоХаба, Неопределено - прочитанная запись зеркала.
//
// Возвращаемое значение:
//  Строка - "выключено", "идёт", "поставлено" либо "простаивает".
//
Функция СостояниеПоЗаписи(Знач Зеркало) Экспорт

	Если Зеркало = Неопределено Тогда
		Возврат "простаивает";
	КонецЕсли;

	Значение = СостояниеПамяти(Зеркало.Идентификатор);
	Если Значение <> "простаивает" Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ?(СервисЗеркал.ПрогонИдётПоЗаписи(Зеркало), "идёт", Значение);

КонецФункции

// Текущее число ожидающих заявок.
//
// Возвращаемое значение:
//  Число - размер очереди.
//
Функция Размер() Экспорт

	Блокировка.Заблокировать();
	Попытка
		Результат = Очередь.Количество();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Что о зеркале знает ПАМЯТЬ процесса: выключенный рубильник, взятое рабочим зеркало
// либо ожидающая заявка. Базы не касается.
Функция СостояниеПамяти(Знач ЗеркалоИдентификатор)

	// Перем обязательна: присваивание необъявленной переменной уходит в ПОЛЕ объекта
	Перем Порог;

	Если НЕ ЧислаЗеркал.СинхронизацияВключена() Тогда
		Возврат "выключено";
	КонецЕсли;

	Ид = Цел(Числа.ЧислоИлиНоль(ЗеркалоИдентификатор));
	// порог спрашивается ДО блокировки: он приходит из настроек, а настройка умеет сходить
	// в базу — под этой блокировкой стоит горячий путь HTTP
	Порог = СервисЗеркал.ПорогЗависанияПрогона();

	Блокировка.Заблокировать();
	Попытка
		Значение = ?(ВРаботеАктивно(Ид, Порог), "идёт", ?(ВОчереди(Ид), "поставлено", "простаивает"));
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();
	Возврат Значение;

КонецФункции

// Принимает заявку в очередь. Пустая строка — принята и уже стоит в очереди; иначе причина
// отказа словами. Проверка и постановка тут неразделимы намеренно: между ними влезал бы
// второй запрос, и одно зеркало получило бы две заявки.
Функция ПринятьЗаявку(Знач Ид, Знач Инициатор)

	Если НЕ ЧислаЗеркал.СинхронизацияВключена() Тогда
		// не enqueue-им: очередь не должна расти без консьюмера
		Возврат "фоновая синхронизация зеркал выключена в настройках хаба"
			+ " (oshub.mirror.sync_enabled)";
	КонецЕсли;
	Если Ид = 0 Тогда
		Возврат "идентификатор зеркала пуст";
	КонецЕсли;
	Если ПрогонВедётся(Ид) Тогда
		Возврат ПричинаИдущегоПрогона(Ид);
	КонецЕсли;

	Заявка = Новый Структура("ЗеркалоИдентификатор, ЗапустилИдентификатор, Поставлена",
		Ид, Инициатор, ТекущаяУниверсальнаяДата());
	Возврат ДобавитьВОчередь(Заявка);

КонецФункции

// Пустая строка — заявка добавлена; иначе причина отказа дедупликации.
Функция ДобавитьВОчередь(Знач Заявка)

	// Перем обязательна: присваивание необъявленной переменной уходит в ПОЛЕ объекта
	Перем МаксОчередь;
	Перем Порог;

	// оба числа спрашиваются ДО блокировки: они приходят из настроек, а настройка умеет
	// сходить в базу
	МаксОчередь = ЧислаЗеркал.ПотолокОчереди();
	Порог = СервисЗеркал.ПорогЗависанияПрогона();
	Блокировка.Заблокировать();
	Попытка
		Отказ = "";
		Переполнено = Ложь;
		Если ВРаботеАктивно(Заявка.ЗеркалоИдентификатор, Порог) Тогда
			Отказ = "рабочий уже ведёт это зеркало";
		ИначеЕсли ВОчереди(Заявка.ЗеркалоИдентификатор) Тогда
			Отказ = "зеркало уже стоит в очереди";
		Иначе
			Пока Очередь.Количество() >= МаксОчередь Цикл
				Очередь.Удалить(0); // старейшее — защита от OOM на всплеске
				Переполнено = Истина;
			КонецЦикла;
			Очередь.Добавить(Заявка);
		КонецЕсли;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Если Переполнено Тогда
		Лог.Предупреждение("Очередь синхронизации зеркал переполнена (лимит %1) — старейшие заявки отброшены",
			МаксОчередь);
	КонецЕсли;
	Возврат Отказ;

КонецФункции

// Взятое рабочим зеркало отпускается САМО по тому же порогу, что и запись прогона:
// иначе умерший рабочий запирает зеркало до перезапуска процесса, и кнопка молча
// отбивает каждое нажатие. Вызывается под уже взятой блокировкой.
Функция ВРаботеАктивно(Знач ЗеркалоИдентификатор, Знач Порог)

	Взято = ВРаботе.Получить(ЗеркалоИдентификатор);
	Если Взято = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если (Сейчас() - Взято) < Порог Тогда
		Возврат Истина;
	КонецЕсли;

	ВРаботе.Удалить(ЗеркалоИдентификатор);
	Возврат Ложь;

КонецФункции

// Память процесса знает только СВОЕГО рабочего. Прогон, начатый прошлым запуском хаба,
// живёт в записи: захват такому зеркалу откажет, и принятая заявка пропала бы у рабочего
// молча — ни строки в журнале, ни движения на экране.
Функция ПрогонВедётся(Знач ЗеркалоИдентификатор)
	Возврат СервисЗеркал.ПрогонИдёт(ЗеркалоИдентификатор);
КонецФункции

// Отказ обязан называть ЦИФРЫ: сколько прогон молчит и когда его отпустят. Без них строка
// «прогон уже идёт» не отличает живой обход от осиротевшего, а порог зависания не совпадает
// с настройкой и не печатается нигде. Второе чтение записи — цена только пути отказа:
// заявки приходят по расписанию и по кнопке, а не на каждый опрос очереди.
Функция ПричинаИдущегоПрогона(Знач ЗеркалоИдентификатор)

	Порог = СервисЗеркал.ПорогЗависанияПрогона();
	Состояние = СервисЗеркал.СостояниеПрогона(ЗеркалоИдентификатор);
	Если Состояние = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Состояние.Обновлён) Тогда
		Возврат "прогон этого зеркала уже идёт";
	КонецЕсли;

	Молчит = Макс(0, Цел(Сейчас() - Состояние.Обновлён));
	Возврат СтрШаблон(
		"прогон этого зеркала уже идёт: последняя отметка прогресса %1 с назад, брошенным"
		+ " он будет объявлен через %2 с (порог %3 с)",
		Молчит, Макс(0, Порог - Молчит), Порог);

КонецФункции

Функция Сейчас()
	Возврат ?(Часы = Неопределено, ТекущаяУниверсальнаяДата(), Часы.Сейчас());
КонецФункции

// Вызывается под уже взятой блокировкой.
Функция ВОчереди(Знач ЗеркалоИдентификатор)
	Для Каждого Заявка Из Очередь Цикл
		Если Заявка.ЗеркалоИдентификатор = ЗеркалоИдентификатор Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

#КонецОбласти

// Лог инъекцией в поле (&Лог выше) — боевой путь; параметр _Лог — для прямого
// создания вне контейнера, куда инъекция в поле не доезжает.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Пластилин(Значение = "ЧислаЗеркалирования") _ЧислаЗеркал,
	&Лог _Лог = Неопределено)

	Числа = _Числа;
	СервисЗеркал = _СервисЗеркал;
	ЧислаЗеркал = _ЧислаЗеркал;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

	Очередь = Новый Массив();
	ВРаботе = Новый Соответствие();
	Часы = Неопределено;
	Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);

КонецПроцедуры
