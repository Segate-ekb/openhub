// Рогатка старта: прогоны зеркал, оставшиеся в состоянии «идёт» от прошлого запуска хаба,
// закрываются как оборванные, а их обходы возвращаются в очередь синхронизации.

Перем ХранилищеЗеркал; // ХранилищеЗеркалХабов (данные) — нужны ВСЕ зеркала, включая выключенные
Перем Прогон;          // ПрогонЗеркала (зеркала)
Перем Очередь;         // ОчередьСинхронизацииЗеркал (зеркала)
Перем Числа;           // ПриведениеЧисел (основа)
Перем ТаймаутАпстрима; // Число - секунд на один запрос к апстриму
Перем Ошибки;          // ТекстОшибки (основа)
&Лог
Перем Лог;
Перем Таймауты;        // ТаймаутыHTTP (сеть)

#Область ПубличныйИнтерфейс

// Называет действующий порог зависания и подбирает прогоны, оборванные остановкой процесса.
// Собственный сбой перехватывает: хаб обязан стартовать и без подбора.
//
Процедура ПриЗапускеПриложения() Экспорт

	Попытка

		НазватьПорог();
		// Допущение произносится ВСЛУХ на каждом старте: второй инстанс за балансировщиком
		// заведут не те, кто читал этот файл, и молчащее допущение они бы не нашли.
		Лог.Информация(
			"Подбор оборванных прогонов зеркал включён: прогон в состоянии «идёт» на старте"
			+ " считается осиротевшим, потому что инстанс хаба ОДИН по устройству продукта."
			+ " Разворачивая второй инстанс за балансировщиком, подбор придётся переделать:"
			+ " иначе он отберёт обход у соседа.");
		Подобрать();

	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог.Ошибка(
			"Подбор оборванных прогонов зеркал не выполнен: зеркало, застрявшее в состоянии"
			+ " «идёт», будет отбивать заявки, пока не промолчит дольше порога. %1",
			Ошибки.Причина(Инфо));
		// отчёт стои́т разбора цепочки: собираем его только тогда, когда отладку включили
		Если Лог.Уровень() <= УровниЛога.Отладка Тогда
			Лог.Отладка("Подбор оборванных прогонов зеркал не выполнен, разбор целиком:%1%2",
				Символы.ПС, Ошибки.ПодробныйОтчёт(Инфо));
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Оператор обязан прочитать действующий порог, а не выводить его из исходников.
Процедура НазватьПорог()

	Порог = Прогон.ПорогЗависания();
	Окно = ОкноМолчанияЦикла();
	Лог.Информация("Прогон зеркала считается брошенным после %1 с молчания"
		+ " (oshub.mirror.run_stale_sec, настройки хаба). Живой цикл отмечается на каждом"
		+ " перечисленном имени и на каждой перенесённой версии, поэтому дольше %2 с"
		+ " (один запрос к апстриму с запасом) он не молчит.", Порог, Окно);

	// Порог ниже окна одного запроса объявляет брошенным ЖИВОЙ обход — но это выбор
	// оператора, а не повод молча поднять ему порог до часов.
	Если Порог >= Окно Тогда
		Возврат;
	КонецЕсли;
	Лог.Предупреждение(
		"Порог зависания зеркал (%1 с) меньше окна молчания цикла (%2 с = 2 ×"
		+ " %5 %3): между отметками прогресса умещается один запрос"
		+ " к апстриму, и ЖИВОЙ обход будет объявлен брошенным."
		+ " Следствие: заявка посреди обхода примется, запись перебьётся на «поставлено»"
		+ " поверх идущего обхода, инициатор в карточке затрётся, а дошедший до конца обход"
		+ " пойдёт по второму кругу. Данные при этом целы — курсор уже сдвинут, счётчики"
		+ " не удваиваются; цена — лишний проход и врущий экран."
		+ " Лечится с любой стороны: либо oshub.mirror.run_stale_sec поднять до %2,"
		+ " либо %5 опустить до %4.",
		Порог, Окно, ТаймаутАпстрима, ТаймаутПодПорог(Порог), Таймауты.КлючТаймаутаАпстрима());

КонецПроцедуры

// Сколько цикл молчит в самом долгом своём месте: один запрос к апстриму, с запасом.
Функция ОкноМолчанияЦикла()
	Возврат 2 * ТаймаутАпстрима;
КонецФункции

// Какой таймаут запроса укладывается в заданный порог: 2 × таймаут ≤ порог.
Функция ТаймаутПодПорог(Знач Порог)
	Возврат Макс(1, Цел(Порог / 2));
КонецФункции

Процедура Подобрать()

	Для Каждого Зеркало Из ХранилищеЗеркал.Все() Цикл

		Лог.Отладка("Зеркало #%1: состояние прогона на старте — ""%2""",
			Зеркало.Идентификатор, Зеркало.СостояниеПрогона);
		Если СокрЛП(Строка(Зеркало.СостояниеПрогона)) <> Прогон.Состояния().Идёт Тогда
			Продолжить;
		КонецЕсли;

		Курсор = СокрЛП(Строка(Зеркало.ПрогонКурсор));
		Отметка = ПоследняяОтметка(Зеркало);
		Итог = ИтогОборванного(Зеркало, Курсор);
		// закрываем через владельца состояния прогона; моментом синка идёт ПОСЛЕДНЯЯ отметка,
		// а не «сейчас» — в момент подбора этот обход ничего не синхронизировал
		Прогон.Завершить(Зеркало.Идентификатор, Итог, Курсор, Отметка, Истина);
		Исход = ВозобновитьОбход(Зеркало, Курсор);

		Лог.Предупреждение(
			"Зеркало #%1: прогон был оборван остановкой процесса (последняя отметка прогресса"
			+ " %2 UTC, обработано %3 из %4). Прогон закрыт как брошенный, %5.",
			Зеркало.Идентификатор, МоментТекстом(Отметка),
			Итог.Скачано + Итог.Пропущено + Итог.Ошибок, Итог.Всего, Исход);

	КонецЦикла;

КонецПроцедуры

// Заявка на старте — единственное, что отличает «рестарт вылечил» от «ждём планового прохода».
Функция ВозобновитьОбход(Знач Зеркало, Знач Курсор)

	Если НЕ (Зеркало.Включено = Истина) Тогда
		Возврат "зеркало выключено — обход не возобновляется";
	КонецЕсли;
	Если НЕ Очередь.Поставить(Зеркало.Идентификатор, "") Тогда
		// Плановый проход ходит через ТУ ЖЕ очередь: при выключенной синхронизации обещать
		// его — значит отправить оператора ждать того, чего не будет.
		Возврат ?(Очередь.Состояние(Зеркало.Идентификатор) = "выключено",
			"фоновая синхронизация выключена в настройках хаба (oshub.mirror.sync_enabled)"
			+ " — обход не возобновится, пока её не включат",
			"заявку очередь не приняла — обход подхватит плановый проход");
	КонецЕсли;
	Возврат ?(ЗначениеЗаполнено(Курсор),
		СтрШаблон("обход возобновлён с пакета ""%1""", Курсор),
		"обход возобновлён с начала списка");

КонецФункции

// Счётчики обхода переносятся как есть: подбор закрывает прогон, а не переписывает его итог.
Функция ИтогОборванного(Знач Зеркало, Знач Курсор)

	Итог = Новый Структура("Всего, Скачано, Пропущено, Ошибок, Недоступно, ЕстьЕщё, Статус",
		Числа.ЧислоИлиНоль(Зеркало.ПрогонВсего), Числа.ЧислоИлиНоль(Зеркало.ПрогонСкачано),
		Числа.ЧислоИлиНоль(Зеркало.ПрогонПропущено), Числа.ЧислоИлиНоль(Зеркало.ПрогонОшибок),
		Числа.ЧислоИлиНоль(Зеркало.ПрогонНедоступно), Ложь, "");
	Итог.Статус = "прогон оборван остановкой процесса хаба; "
		+ ?(ЗначениеЗаполнено(Курсор),
			СтрШаблон("обход продолжится с пакета ""%1""", Курсор),
			"обход начнётся с начала списка");
	Возврат Итог;

КонецФункции

// Отметки прогона живут в UTC, а вывод по умолчанию печатает их в формате хоста.
Функция МоментТекстом(Знач Момент)
	Возврат Формат(Момент, "ДФ=""yyyy-MM-dd HH:mm:ss""");
КонецФункции

Функция ПоследняяОтметка(Знач Зеркало)
	Возврат ?(ЗначениеЗаполнено(Зеркало.ПрогонОбновлён),
		Зеркало.ПрогонОбновлён, ТекущаяУниверсальнаяДата());
КонецФункции

#КонецОбласти

&Рогатка(ЗапускатьВФоне = Ложь)
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеЗеркалХабов") _ХранилищеЗеркал,
	&Пластилин(Значение = "ПрогонЗеркала") _Прогон,
	&Пластилин(Значение = "ОчередьСинхронизацииЗеркал") _Очередь,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Пластилин(Значение = "ТаймаутыHTTP") _Таймауты = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	ХранилищеЗеркал = _ХранилищеЗеркал;
	Прогон = _Прогон;
	Очередь = _Очередь;
	Числа = _Числа;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	// Детальки приезжают СТРОКАМИ, и опечатка в OSHUB_* не вправе уронить сборку контейнера:
	// конструктор считается вне перехвата ПриЗапускеПриложения, то есть хаб не поднялся бы вовсе.
	// прикладной ключ читается сервисом, а не Деталькой: правка обязана действовать без рестарта
	Таймауты = ?(_Таймауты = Неопределено, Новый ТаймаутыHTTP(), _Таймауты);
	ТаймаутАпстрима = Макс(1, Таймауты.ТаймаутАпстрима(_Настройки));

КонецПроцедуры
