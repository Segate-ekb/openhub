// Объектный шов над статическим модулем КоннекторHTTP библиотеки 1connector —
// коннектор по умолчанию для КлиентHTTP (в тестах подменяется фейком).

#Использовать 1connector

// Выполняет GET через 1connector.
//
// Параметры:
//  URL - Строка - полный URL ресурса.
//  ПараметрыЗапроса - Соответствие - параметры query-строки (необязательный, по умолчанию Неопределено).
//  ДопПараметры - Структура - дополнительные параметры 1connector (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Произвольный - ответ 1connector: КодСостояния, Заголовки, ДвоичныеДанные().
//
Функция Get(Знач URL, Знач ПараметрыЗапроса = Неопределено, Знач ДопПараметры = Неопределено) Экспорт
	Возврат КоннекторHTTP.Get(URL, ПараметрыЗапроса, ДопПараметры);
КонецФункции

// Выполняет POST через 1connector.
//
// Параметры:
//  URL - Строка - полный URL ресурса.
//  Данные - Строка, ДвоичныеДанные - тело запроса (необязательный, по умолчанию Неопределено).
//  Json - Произвольный - тело в виде JSON-структуры (необязательный, по умолчанию Неопределено).
//  ДопПараметры - Структура - дополнительные параметры 1connector (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Произвольный - ответ 1connector: КодСостояния, Заголовки, ДвоичныеДанные().
//
Функция Post(Знач URL, Знач Данные = Неопределено, Знач Json = Неопределено, Знач ДопПараметры = Неопределено) Экспорт
	Возврат КоннекторHTTP.Post(URL, Данные, Json, ДопПараметры);
КонецФункции

&Прозвище("КоннекторИсходящегоHTTP")
&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
