// Единая точка исходящего HTTP хаба — адаптер поверх 1connector.
// Без ретраев (код отдаётся как есть); сетевой сбой пробрасывается исключением.
// Редиректы по умолчанию выключены и включаются GET-запросом поштучно: ходит по ним
// 1connector, конечный адрес цепочки не проверяет никто.

Перем Коннектор_; // объект с Get/Post (обёртка над 1connector либо фейк в тестах)

// Выполняет исходящий GET-запрос.
//
// Параметры:
//  URL - Строка - полный URL ресурса со схемой http или https.
//  Заголовки - Соответствие - заголовки запроса, только ASCII-значения (необязательный, по умолчанию Неопределено).
//  ТаймаутСек - Число - таймаут соединения в секундах (необязательный, по умолчанию 20).
//  ПроверятьSSL - Булево - проверять сертификат сервера (необязательный, по умолчанию Истина).
//  РазрешитьПеренаправление - Булево - идти по Location силами 1connector; конечный адрес
//                             цепочки при этом никем не проверяется, поэтому включает его
//                             только вызывающий, которому редирект нужен по делу
//                             (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура - Код (Число, как есть, в том числе 304 и 404), Заголовки (Соответствие),
//              Данные (ДвоичныеДанные, без разжатия).
//
// Сетевой сбой и таймаут пробрасываются исключением: трактует их вызывающий.
//
Функция Получить(Знач URL, Знач Заголовки = Неопределено, Знач ТаймаутСек = 20, Знач ПроверятьSSL = Истина,
	Знач РазрешитьПеренаправление = Ложь) Экспорт

	ДопПараметры = СобратьДопПараметры(Заголовки, ТаймаутСек, ПроверятьSSL, РазрешитьПеренаправление);
	Возврат СобратьОтвет(Коннектор_.Get(URL, , ДопПараметры));

КонецФункции

// Выполняет исходящий POST-запрос с телом.
// Content-Type из Заголовков побеждает: свой urlencoded 1connector ставит лишь при его отсутствии.
//
// Параметры:
//  URL - Строка - полный URL ресурса со схемой http или https.
//  Тело - Строка - тело запроса; кодирует его вызывающий.
//  Заголовки - Соответствие - заголовки запроса, только ASCII-значения (необязательный, по умолчанию Неопределено).
//  ТаймаутСек - Число - таймаут соединения в секундах (необязательный, по умолчанию 20).
//  ПроверятьSSL - Булево - проверять сертификат сервера (необязательный, по умолчанию Истина).
//
// Возвращаемое значение:
//  Структура - Код, Заголовки, Данные; как у Получить.
//
// Сетевой сбой и таймаут пробрасываются исключением.
//
Функция Отправить(Знач URL, Знач Тело, Знач Заголовки = Неопределено, Знач ТаймаутСек = 20, Знач ПроверятьSSL = Истина) Экспорт

	ДопПараметры = СобратьДопПараметры(Заголовки, ТаймаутСек, ПроверятьSSL, Ложь);
	ТелоЗапроса = ?(Тело = Неопределено, "", Строка(Тело));
	Возврат СобратьОтвет(Коннектор_.Post(URL, ТелоЗапроса, , ДопПараметры));

КонецФункции

// Значение заголовка User-Agent по умолчанию для всего исходящего HTTP хаба.
//
// Возвращаемое значение:
//  Строка - значение User-Agent.
//
Функция ИмяАгента() Экспорт
	Возврат "OpenHub/1.0 (+https://github.com/oscript-library/openhub)";
КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция СобратьДопПараметры(Знач Заголовки, Знач ТаймаутСек, Знач ПроверятьSSL, Знач РазрешитьПеренаправление)

	ЗаголовкиЗапроса = Новый Соответствие();
	// identity — гарантия целостности двоичного тела: 1connector не разжимает gzip
	ЗаголовкиЗапроса.Вставить("Accept-Encoding", "identity");
	// api.github.com отвечает 403 на запрос без User-Agent; значение вызывающего побеждает
	ЗаголовкиЗапроса.Вставить("User-Agent", ИмяАгента());
	Если Заголовки <> Неопределено Тогда
		Для Каждого КлючЗначение Из Заголовки Цикл
			ЗаголовкиЗапроса.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	ДопПараметры = Новый Структура();
	ДопПараметры.Вставить("Заголовки", ЗаголовкиЗапроса);
	ДопПараметры.Вставить("Таймаут", ТаймаутСек);
	ДопПараметры.Вставить("ПроверятьSSL", ПроверятьSSL);
	ДопПараметры.Вставить("РазрешитьПеренаправление", РазрешитьПеренаправление = Истина);
	ДопПараметры.Вставить("МаксимальноеКоличествоПовторов", 0);

	Возврат ДопПараметры;

КонецФункции

Функция СобратьОтвет(Знач Ответ)
	Результат = Новый Структура("Код, Заголовки, Данные");
	Результат.Код = Ответ.КодСостояния;
	Результат.Заголовки = Ответ.Заголовки;
	Результат.Данные = Ответ.ДвоичныеДанные();
	Возврат Результат;
КонецФункции

#КонецОбласти

&Прозвище("ТранспортHTTP")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КоннекторИсходящегоHTTP") Коннектор = Неопределено)
	Коннектор_ = ?(Коннектор = Неопределено, Новый КоннекторHTTPБиблиотеки, Коннектор);
КонецПроцедуры
