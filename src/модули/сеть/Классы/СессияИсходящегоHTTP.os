// Сессия 1connector для библиотек, которые ходят в сеть сами (oidc-client). Класс — шов:
// в тестах его прозвище занимает двойник.

#Использовать 1connector

Перем СессияКоннектора;

// Выполняет HTTP-запрос по контракту сессии 1connector.
//
// Параметры:
//  Метод - Строка - HTTP-метод.
//  URL - Строка - полный URL ресурса.
//  ДополнительныеПараметры - Структура - параметры 1connector (необязательный,
//                            по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Произвольный - ответ 1connector: КодСостояния, Текст(), Json().
//
Функция ВызватьМетод(Знач Метод, Знач URL, Знач ДополнительныеПараметры = Неопределено) Экспорт
	Возврат СессияКоннектора.ВызватьМетод(Метод, URL, ДополнительныеПараметры);
КонецФункции

&Прозвище("СессияИсходящегоHTTP")
&Желудь
Процедура ПриСозданииОбъекта()
	СессияКоннектора = Новый Сессия;
КонецПроцедуры
