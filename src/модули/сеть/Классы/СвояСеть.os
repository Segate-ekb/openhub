// Одно определение «своей сети» на весь хаб: строгий разбор адреса библиотекой ip плюс
// один список сетей. Спрашивают провайдер входа и издатель доверенного конвейера.

#Использовать ip

Перем Разрешитель;       // РазрешительImён (сеть) — резолв имени; без него гейт не собирается
Перем Сети;              // Массив из Структура(Префикс, Код, Имя, Петля) — список сетей, один на хаб
Перем КодыВердикта;
Перем ПрефиксNAT64;
Перем ПрефиксСовместимый;

#Область ПубличныйИнтерфейс

// Коды вердикта: по ним судят двери, а не по тексту причины.
//
// Возвращаемое значение:
//  Структура - Интернет, СвояСеть, НеДляИнтернета, НеАдрес (Строка).
//
Функция Коды() Экспорт
	Возврат КодыВердикта;
КонецФункции

// Куда ведёт хост, судя по его записи. Имя не резолвится: о нём без резолва сказать нечего,
// и вердикт для него — «интернет».
//
// Параметры:
//  Хост - Строка - хост без скобок и порта.
//
// Возвращаемое значение:
//  Структура - Код (Строка, см. Коды), Сеть (Строка, имя распознанной сети либо ""),
//              Петля (Булево, адрес ведёт на сам узел), Текст (Строка, причина словами;
//              пустая при коде «интернет»).
//
Функция Вердикт(Знач Хост) Экспорт

	Значение = Нормализованный(Хост);
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат НеАдрес();
	КонецЕсли;

	Если ЭтоИмяПетли(Значение) Тогда
		Возврат ПетляПоИмени();
	КонецЕсли;

	Если НЕ ЭтоЛитералАдреса(Значение) Тогда
		Возврат Интернет();
	КонецЕсли;

	Адрес = РазборIP.ПопытатьсяРазобратьАдрес(Значение);
	Если Адрес = Неопределено Тогда
		Возврат НеАдрес();
	КонецЕсли;

	Возврат ВердиктАдреса(Адрес);

КонецФункции

// Тот же вердикт, но имя разрешается в адреса и судится по ним же. Недоступный резолв
// оставляет вердикт «интернет»: неизвестное имя своим не объявляется.
//
// Параметры:
//  Хост - Строка - хост без скобок и порта.
//
// Возвращаемое значение:
//  Структура - Код, Сеть, Петля, Текст (см. Вердикт).
//
Функция ВердиктСРезолвом(Знач Хост) Экспорт

	ПоЗаписи = Вердикт(Хост);
	Значение = Нормализованный(Хост);
	Если ПоЗаписи.Код <> Коды().Интернет ИЛИ ЭтоЛитералАдреса(Значение) Тогда
		Возврат ПоЗаписи;
	КонецЕсли;

	Разрешённые = Разрешитель.Разрешить(Значение);
	Если Разрешённые = Неопределено Тогда
		Возврат ПоЗаписи;
	КонецЕсли;

	Для Каждого Найденный Из Разрешённые Цикл
		Адрес = РазборIP.ПопытатьсяРазобратьАдрес(Нормализованный(Найденный));
		Если Адрес = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПоАдресу = ВердиктАдреса(Адрес);
		Если ПоАдресу.Код <> Коды().Интернет Тогда
			Возврат ПоРезолву(ПоАдресу, Адрес);
		КонецЕсли;
	КонецЦикла;

	Возврат ПоЗаписи;

КонецФункции

// Ведёт ли хост в свою сеть по одной лишь записи адреса.
//
// Параметры:
//  Хост - Строка - хост без скобок и порта.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоСвояСеть(Знач Хост) Экспорт
	Возврат Вердикт(Хост).Код = Коды().СвояСеть;
КонецФункции

// Ведёт ли хост на сам узел — петля во всех записях: 127.0.0.0/8, ::1/128, отображённый
// и завёрнутый в IPv6 тот же IPv4, а также имя localhost и его поддомены. Строже, чем
// «своя сеть»: частная сеть, link-local и CGNAT петлёй не являются.
//
// Параметры:
//  Хост - Строка - хост без скобок и порта.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоПетля(Знач Хост) Экспорт
	Возврат Вердикт(Хост).Петля;
КонецФункции

#КонецОбласти

#Область СписокСетей

// СПИСОК СЕТЕЙ — один на хаб и меняется только здесь. Порядок значения не имеет:
// диапазоны не пересекаются.
Функция СетиПолитики()

	Результат = Новый Массив();

	Петля(Результат, "127.0.0.0/8");
	Петля(Результат, "::1/128");
	Своя(Результат, "0.0.0.0/8", "незаданный адрес");
	Своя(Результат, "::/128", "незаданный адрес");
	Своя(Результат, "10.0.0.0/8", "частная сеть RFC 1918");
	Своя(Результат, "172.16.0.0/12", "частная сеть RFC 1918");
	Своя(Результат, "192.168.0.0/16", "частная сеть RFC 1918");
	Своя(Результат, "169.254.0.0/16", "link-local, сюда же ходят за метаданными облака");
	Своя(Результат, "fe80::/10", "link-local");
	Своя(Результат, "fc00::/7", "уникальные локальные адреса");
	Своя(Результат, "100.64.0.0/10", "CGNAT");

	Чужая(Результат, "224.0.0.0/4", "групповые адреса");
	Чужая(Результат, "ff00::/8", "групповые адреса");
	Чужая(Результат, "240.0.0.0/4", "зарезервированный диапазон");
	Чужая(Результат, "192.0.2.0/24", "сеть для документации");
	Чужая(Результат, "198.51.100.0/24", "сеть для документации");
	Чужая(Результат, "203.0.113.0/24", "сеть для документации");
	Чужая(Результат, "2001:db8::/32", "сеть для документации");
	Чужая(Результат, "198.18.0.0/15", "сеть для нагрузочных испытаний");

	Возврат Результат;

КонецФункции

Процедура Петля(Список, Знач Запись)
	Добавить(Список, Запись, Коды().СвояСеть, ИмяПетли(), Истина);
КонецПроцедуры

Процедура Своя(Список, Знач Запись, Знач Имя)
	Добавить(Список, Запись, Коды().СвояСеть, Имя, Ложь);
КонецПроцедуры

Процедура Чужая(Список, Знач Запись, Знач Имя)
	Добавить(Список, Запись, Коды().НеДляИнтернета, Имя, Ложь);
КонецПроцедуры

Процедура Добавить(Список, Знач Запись, Знач Код, Знач Имя, Знач ВедётНаУзел)
	Список.Добавить(Новый Структура("Префикс, Код, Имя, Петля",
		Новый IPПрефикс(Запись), Код, Имя, ВедётНаУзел));
КонецПроцедуры

// Имя петли одно на все её записи: и на префиксы, и на localhost. Чем они различаются,
// говорит поле Текст, а не второе имя сети.
Функция ИмяПетли()
	Возврат "петля";
КонецФункции

#КонецОбласти

#Область ФабрикиВердиктов

Функция НовыйВердикт(Знач Код, Знач Сеть, Знач ВедётНаУзел, Знач Текст)
	Возврат Новый Структура("Код, Сеть, Петля, Текст", Код, Сеть, ВедётНаУзел, Текст);
КонецФункции

Функция Интернет()
	Возврат НовыйВердикт(Коды().Интернет, "", Ложь, "");
КонецФункции

Функция НеАдрес()
	Возврат НовыйВердикт(Коды().НеАдрес, "", Ложь,
		"адресом не является: IPv4 записывается четырьмя десятичными октетами без ведущих"
		+ " нулей, IPv6 — по RFC 4291. Восьмеричные, шестнадцатеричные, сокращённые"
		+ " и однословные числовые формы адресами не считаются");
КонецФункции

Функция ПетляПоИмени()
	Возврат НовыйВердикт(Коды().СвояСеть, ИмяПетли(), Истина,
		СвоейСетью("петля по имени localhost"));
КонецФункции

// Текст называет ИМЯ сети и её префикс, а вложенный IPv4 — ещё и сам вложенный адрес:
// иначе отказ на «[::ffff:169.254.169.254]» не объясняет, что именно узнал хаб.
Функция ПоСети(Знач Сеть, Знач Адрес, Знач Обёртка)

	Описание = СтрШаблон("%1 — %2", Сеть.Префикс.ВСтроку(), Сеть.Имя);
	Если Обёртка <> Неопределено Тогда
		Описание = Описание + СтрШаблон(", вложенный IPv4 %1", Адрес.ВСтроку());
	КонецЕсли;

	Если Сеть.Код = Коды().СвояСеть Тогда
		Возврат НовыйВердикт(Сеть.Код, Сеть.Имя, Сеть.Петля, СвоейСетью(Описание));
	КонецЕсли;

	Возврат НовыйВердикт(Сеть.Код, Сеть.Имя, Ложь,
		СтрШаблон("для интернета непригоден (%1)", Описание));

КонецФункции

Функция ПоРезолву(Знач ПоАдресу, Знач Адрес)
	Возврат НовыйВердикт(ПоАдресу.Код, ПоАдресу.Сеть, ПоАдресу.Петля,
		СтрШаблон("разрешается в %1, который %2", Адрес.ВСтроку(), ПоАдресу.Текст));
КонецФункции

Функция СвоейСетью(Знач Описание)
	Возврат СтрШаблон("ведёт в свою сеть (%1)", Описание);
КонецФункции

#КонецОбласти

#Область МеханикаАдреса

// Вложенный IPv4 — отображённый, совместимый и NAT64 — судится как сам IPv4.
Функция ВердиктАдреса(Знач Адрес)

	Совпадение = СетьАдреса(Адрес);
	Если Совпадение <> Неопределено Тогда
		Возврат ПоСети(Совпадение, Адрес, Неопределено);
	КонецЕсли;

	Вложенный = ВложенныйIPv4(Адрес);
	Если Вложенный <> Неопределено Тогда
		Совпадение = СетьАдреса(Вложенный);
		Если Совпадение <> Неопределено Тогда
			Возврат ПоСети(Совпадение, Вложенный, Адрес);
		КонецЕсли;
	КонецЕсли;

	Возврат Интернет();

КонецФункции

Функция СетьАдреса(Знач Адрес)

	Для Каждого Сеть Из Сети Цикл
		Если Сеть.Префикс.Содержит(Адрес) Тогда
			Возврат Сеть;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// IPv4, завёрнутый в IPv6: отображённый ::ffff:a.b.c.d, совместимый ::a.b.c.d и NAT64.
// Окрестность нуля (:: и ::1) сюда не доходит — её раньше называет сам список сетей.
Функция ВложенныйIPv4(Знач Адрес)

	Если Адрес.ЭтоIPv4() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Адрес.ЭтоIPv6СОтображеннымIPv4() Тогда
		Возврат Адрес.IPv4();
	КонецЕсли;

	Если ПрефиксNAT64.Содержит(Адрес) ИЛИ ПрефиксСовместимый.Содержит(Адрес) Тогда
		Возврат ХвостовойIPv4(Адрес);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ХвостовойIPv4(Знач Адрес)

	Октеты = Адрес.Октеты();
	Четыре = Новый Массив();
	Для Индекс = 12 По 15 Цикл
		Четыре.Добавить(Октеты[Индекс]);
	КонецЦикла;

	Возврат Новый IPАдрес(Четыре);

КонецФункции

// Записан ли хост как адрес, а не как имя узла: у имени последняя метка начинается
// с буквы. Строгость разбора проверяется отдельно — «127.1» литерал, но не адрес.
Функция ЭтоЛитералАдреса(Знач Хост)

	Значение = Нормализованный(Хост);
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Найти(Значение, ":") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Метки = СтрРазделить(Значение, ".", Истина);
	Последняя = Метки[Метки.Количество() - 1];
	Возврат ЗначениеЗаполнено(Последняя) И ЭтоЦифра(Лев(Последняя, 1));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоИмяПетли(Знач Значение)
	Возврат Значение = "localhost" ИЛИ СтрЗаканчиваетсяНа(Значение, ".localhost");
КонецФункции

Функция ЭтоЦифра(Знач Символ)
	Возврат Найти("0123456789", Символ) > 0;
КонецФункции

Функция Нормализованный(Знач Хост)
	Возврат НРег(СокрЛП(Строка(?(Хост = Неопределено, "", Хост))));
КонецФункции

#КонецОбласти

&Прозвище("СвояСеть")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "РазрешительImён") _Разрешитель)

	Разрешитель = _Разрешитель;
	КодыВердикта = Новый Структура("Интернет, СвояСеть, НеДляИнтернета, НеАдрес",
		"интернет", "своя-сеть", "не-для-интернета", "не-адрес");
	Сети = СетиПолитики();
	ПрефиксNAT64 = Новый IPПрефикс("64:ff9b::/96");
	ПрефиксСовместимый = Новый IPПрефикс("::/96");

КонецПроцедуры
