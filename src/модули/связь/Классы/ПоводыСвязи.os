// Перечень поводов личного канала. Повод бывает ровно двух видов, и объявить его иначе
// нечем: **ленточный** оставляет след в ленте кабинета, **секретный** несёт в письме
// одноразовую ссылку и следа не оставляет. Третьего объявителя нет, поэтому «и то и другое»
// на этом каталоге невыразимо — секрет в ленту попасть не может.

Перем Ключи;    // Массив — порядок объявления
Перем Виды;     // Соответствие: повод -> вид повода

#Область Поводы

// Заявку на имя пакета одобрили.
//
// Возвращаемое значение:
//  Строка - повод.
//
Функция ЗаявкаОдобрена() Экспорт
	Возврат "заявка.одобрена";
КонецФункции

// Заявку на имя пакета отклонили.
//
// Возвращаемое значение:
//  Строка - повод.
//
Функция ЗаявкаОтклонена() Экспорт
	Возврат "заявка.отклонена";
КонецФункции

// Письмо со ссылкой подтверждения адреса.
//
// Возвращаемое значение:
//  Строка - повод.
//
Функция ПодтверждениеАдреса() Экспорт
	Возврат "адрес.подтверждение";
КонецФункции

// Письмо со ссылкой восстановления пароля.
//
// Возвращаемое значение:
//  Строка - повод.
//
Функция ВосстановлениеПароля() Экспорт
	Возврат "пароль.восстановление";
КонецФункции

// Письмо со ссылкой приглашения в хаб.
//
// Возвращаемое значение:
//  Строка - повод.
//
Функция Приглашение() Экспорт
	Возврат "учётка.приглашение";
КонецФункции

#КонецОбласти

#Область ПубличныйИнтерфейс

// Все поводы канала в порядке объявления.
//
// Возвращаемое значение:
//  Массив из Строка - копия перечня: правка возвращённого списка каталог не меняет.
//
Функция Все() Экспорт

	Результат = Новый Массив();
	Для Каждого Повод Из Ключи Цикл
		Результат.Добавить(Повод);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Объявлен ли такой повод.
//
// Параметры:
//  Повод - Строка - повод.
//
// Возвращаемое значение:
//  Булево.
//
Функция Известен(Знач Повод) Экспорт
	Возврат Виды.Получить(Ключ(Повод)) <> Неопределено;
КонецФункции

// Оставляет ли повод след в ленте кабинета.
//
// Параметры:
//  Повод - Строка - повод.
//
// Возвращаемое значение:
//  Булево - Ложь для неизвестного повода.
//
Функция ОставляетСлед(Знач Повод) Экспорт
	Возврат Виды.Получить(Ключ(Повод)) = ВидЛенточный();
КонецФункции

// Несёт ли письмо повода одноразовую ссылку. Такое письмо адресовано тому, кто в кабинет
// войти как раз не может: вход закрыт до подтверждения адреса, пароль утерян, учётки ещё нет.
//
// Параметры:
//  Повод - Строка - повод.
//
// Возвращаемое значение:
//  Булево - Ложь для неизвестного повода.
//
Функция НесётСекрет(Знач Повод) Экспорт
	Возврат Виды.Получить(Ключ(Повод)) = ВидСекретный();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВидЛенточный()
	Возврат "ленточный";
КонецФункции

Функция ВидСекретный()
	Возврат "секретный";
КонецФункции

// Повод, о котором человек читает в кабинете и получает письмо.
Процедура ОбъявитьЛенточный(Знач Повод)
	Объявить(Повод, ВидЛенточный());
КонецПроцедуры

// Повод, письмо которого несёт одноразовую ссылку: в ленту он не ложится никогда.
Процедура ОбъявитьСекретный(Знач Повод)
	Объявить(Повод, ВидСекретный());
КонецПроцедуры

Процедура Объявить(Знач Повод, Знач Вид)

	Ключи.Добавить(Повод);
	Виды.Вставить(Ключ(Повод), Вид);

КонецПроцедуры

Функция Ключ(Знач Повод)
	Возврат НРег(СокрЛП(Строка(Повод)));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()

	Ключи = Новый Массив();
	Виды = Новый Соответствие();

	ОбъявитьЛенточный(ЗаявкаОдобрена());
	ОбъявитьЛенточный(ЗаявкаОтклонена());
	ОбъявитьСекретный(ПодтверждениеАдреса());
	ОбъявитьСекретный(ВосстановлениеПароля());
	ОбъявитьСекретный(Приглашение());

КонецПроцедуры
