// Личный канал хаба: единственная дверь, через которую хаб обращается к человеку. Повод
// решает, куда обращение доходит — записью в ленту кабинета либо письмом с одноразовой
// ссылкой. Исключений наружу не отдаёт: недошедшее уведомление не должно отменять операцию,
// ради которой его слали, — ни отказ ленты, ни отказ почты.

Перем КаталогПоводов; // ПоводыСвязи (связь)
Перем Лента;          // ЛентаУведомлений (связь)
Перем Почта;          // СлужбаПочты (почта)
Перем АдресХаба;      // АдресИнстанса (настройки) — относительная ссылка в письме бесполезна
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Сообщает человеку о том, что с ним произошло. Запись в ленте кабинета появляется всегда:
// на хабе без настроенной почты человек всё равно видит своё событие. Письмо уходит вдобавок.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - адресат.
//  Повод - Строка - ленточный повод из ПоводыСвязи.
//  Заголовок - Строка - о чём событие; он же тема письма.
//  Текст - Строка - подробности события; они же тело письма.
//  Ссылка - Строка - относительный адрес, куда ведёт событие (необязательный,
//           по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Записано (Булево — событие легло в ленту),
//              Отправлено (Булево — письмо принято к отправке),
//              Причина (Строка — код отказа, "" при полном успехе; отказ ленты называется
//              вперёд отказа почты).
//
Функция Уведомить(Знач Пользователь, Знач Повод, Знач Заголовок, Знач Текст,
	Знач Ссылка = "") Экспорт

	Если АдресатаНет(Пользователь, Повод) Тогда
		Возврат Итог(Ложь, Ложь, ПричинаНетАдресата());
	КонецЕсли;
	Если НЕ КаталогПоводов.Известен(Повод) Тогда
		Лог.Ошибка("Личный канал: повод ""%1"" не объявлен — уведомлять не по чему", Повод);
		Возврат Итог(Ложь, Ложь, ПричинаНеизвестныйПовод());
	КонецЕсли;

	// секретный повод сюда не ходит: его одноразовая ссылка легла бы в ленту, а лента
	// открыта тому, кто уже вошёл
	Если НЕ КаталогПоводов.ОставляетСлед(Повод) Тогда
		Лог.Ошибка("Личный канал: повод ""%1"" в ленте следа не оставляет —"
			+ " уведомление учётке ""%2"" не записано", Повод, Пользователь.Логин);
		Возврат Итог(Ложь, Ложь, ПричинаЧужойПовод());
	КонецЕсли;

	ЛентаПриняла = ЗаписатьВЛенту(Пользователь, Повод, Заголовок, Текст, Ссылка);
	Письмо = Отправить(Повод, Пользователь, Заголовок, ТелоПисьма(Текст, Ссылка));

	Возврат Итог(ЛентаПриняла, Письмо.Отправлено,
		?(ЛентаПриняла, Письмо.Причина, ПричинаЛентаНеПриняла()));

КонецФункции

// Шлёт письмо с одноразовой ссылкой. Следа в ленте такое письмо не оставляет: его адресат
// в кабинет войти как раз не может — вход закрыт до подтверждения адреса, пароль утерян,
// учётки ещё нет.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - адресат.
//  Повод - Строка - секретный повод из ПоводыСвязи.
//  Тема - Строка - тема письма.
//  Текст - Строка - тело письма, уже собранное вместе со ссылкой.
//
// Возвращаемое значение:
//  Структура - Отправлено (Булево), Причина (Строка — код отказа, "" при успехе).
//
Функция ПисьмоСоСсылкой(Знач Пользователь, Знач Повод, Знач Тема, Знач Текст) Экспорт

	Если АдресатаНет(Пользователь, Повод) Тогда
		Возврат Отправка(Ложь, ПричинаНетАдресата());
	КонецЕсли;
	Если НЕ КаталогПоводов.Известен(Повод) Тогда
		Лог.Ошибка("Личный канал: повод ""%1"" не объявлен — писать не по чему", Повод);
		Возврат Отправка(Ложь, ПричинаНеизвестныйПовод());
	КонецЕсли;
	Если НЕ КаталогПоводов.НесётСекрет(Повод) Тогда
		Лог.Ошибка("Личный канал: повод ""%1"" секрета не несёт — этой дверью он не ходит",
			Повод);
		Возврат Отправка(Ложь, ПричинаЧужойПовод());
	КонецЕсли;

	Возврат Отправить(Повод, Пользователь, Тема, Текст);

КонецФункции

// Готова ли почта хаба к отправке. Спрашивают до того, как обещать человеку письмо.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПочтаНастроена() Экспорт
	Возврат Почта.Настроена();
КонецФункции

// Перечень поводов канала — одним объектом, чтобы вызывающий не собирал канал и его
// словарь по двум желудям.
//
// Возвращаемое значение:
//  ПоводыСвязи.
//
Функция Поводы() Экспорт
	Возврат КаталогПоводов;
КонецФункции

// Код отказа «повод пришёл не в ту дверь канала».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаЧужойПовод() Экспорт
	Возврат "channel_wrong_reason";
КонецФункции

// Код отказа «такого повода канал не знает».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНеизвестныйПовод() Экспорт
	Возврат "channel_unknown_reason";
КонецФункции

// Код отказа «обращаться не к кому: адресата нет».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНетАдресата() Экспорт
	Возврат "channel_no_recipient";
КонецФункции

// Код отказа «лента запись не приняла».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаЛентаНеПриняла() Экспорт
	Возврат "channel_feed_failed";
КонецФункции

#КонецОбласти

#Область ГраницыКанала

// Единственное место, где канал решает, что обращаться не к кому: обе двери спрашивают
// здесь, и обе отвечают одним кодом.
Функция АдресатаНет(Знач Пользователь, Знач Повод)

	Если Пользователь <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Лог.Ошибка("Личный канал: повод ""%1"" без адресата — обращаться не к кому", Повод);
	Возврат Истина;

КонецФункции

// Отказ хранилища гасится здесь: операция, породившая событие, уже состоялась, и отменять
// её из-за несохранённого уведомления нельзя.
Функция ЗаписатьВЛенту(Знач Пользователь, Знач Повод, Знач Заголовок, Знач Текст, Знач Ссылка)

	Попытка
		Лента.Записать(Пользователь, Повод, Заголовок, Текст, Ссылка);
	Исключение
		Лог.Ошибка("Личный канал: лента учётки ""%1"" не приняла повод ""%2"": %3",
			Пользователь.Логин, Повод, КраткоеОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Симметрично ленте: почтовый слой отказ отдаёт кодом, но фоновый запуск письма — обычный
// вызов, и упасть он может. Здесь его падение и остаётся.
Функция Отправить(Знач Повод, Знач Пользователь, Знач Тема, Знач Текст)

	Попытка
		Исход = Почта.ОтправитьВФоне(Строка(Пользователь.Email), Тема, Текст);
	Исключение
		Лог.Ошибка("Личный канал: письмо по поводу ""%1"" не отдано почте: %2",
			Повод, КраткоеОписаниеОшибки());
		Возврат Отправка(Ложь, Почта.ПричинаОтказ());
	КонецПопытки;

	Лог.Отладка("Личный канал: письмо по поводу ""%1"" — отправлено=%2, причина=""%3""",
		Повод, Исход.Отправлено, Исход.Причина);
	Возврат Исход;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ссылка ленты относительна, а из почтового ящика такая никуда не ведёт: дописываем
// внешний адрес инсталляции, а без него не зовём в письме вовсе.
Функция ТелоПисьма(Знач Текст, Знач Ссылка)

	Если НЕ ЗначениеЗаполнено(Ссылка) ИЛИ НЕ АдресХаба.Задан() Тогда
		Возврат Строка(Текст);
	КонецЕсли;

	Возврат Строка(Текст) + Символы.ПС + Символы.ПС + АдресХаба.Базовый() + Строка(Ссылка);

КонецФункции

Функция Итог(Знач Записано, Знач Отправлено, Знач Причина)
	Возврат Новый Структура("Записано, Отправлено, Причина", Записано, Отправлено, Причина);
КонецФункции

Функция Отправка(Знач Отправлено, Знач Причина)
	Возврат Новый Структура("Отправлено, Причина", Отправлено, Причина);
КонецФункции

Функция КраткоеОписаниеОшибки()
	Возврат СтрЗаменить(СтрЗаменить(ОписаниеОшибки(), Символы.ПС, " "), Символы.ВК, "");
КонецФункции

#КонецОбласти

&Прозвище("СлужбаЛичныхУведомлений")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПоводыСвязи") _Поводы,
	&Пластилин(Значение = "ЛентаУведомлений") _Лента,
	&Пластилин(Значение = "СлужбаПочты") _Почта,
	&Пластилин(Значение = "АдресИнстанса") _АдресХаба,
	&Лог _Лог = Неопределено)

	КаталогПоводов = _Поводы;
	Лента = _Лента;
	Почта = _Почта;
	АдресХаба = _АдресХаба;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
