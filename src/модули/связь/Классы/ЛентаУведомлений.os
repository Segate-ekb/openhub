// Лента личных уведомлений: запись события в ленту адресата, чтение своей ленты, счёт
// непрочитанного и отметка «прочитано». Адресат везде берётся из учётной записи, поэтому
// чужую ленту через этот класс не прочитать и не отметить. Отбор и порядок держит база:
// в памяти лента не сортируется и целиком без нужды не читается.

Перем Хранилище; // ХранилищеЛичныхУведомлений (данные)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Записывает событие в ленту учётной записи.
//
// Параметры:
//  Пользователь - Пользователь - адресат.
//  Повод - Строка - повод из ПоводыСвязи.
//  Заголовок - Строка - о чём событие.
//  Текст - Строка - подробности события.
//  Ссылка - Строка - куда ведёт запись (необязательный, по умолчанию "").
//  Момент - Дата - момент события, UTC (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  ЛичноеУведомление - сохранённая запись.
//
Функция Записать(Знач Пользователь, Знач Повод, Знач Заголовок, Знач Текст,
	Знач Ссылка = "", Знач Момент = Неопределено) Экспорт

	Запись = Хранилище.СоздатьЭлемент();
	Запись.ПользовательИдентификатор = Цел(Пользователь.Идентификатор);
	Запись.Повод = СокрЛП(Строка(Повод));
	Запись.Заголовок = СокрЛП(Строка(Заголовок));
	Запись.Текст = СокрЛП(Строка(Текст));
	Запись.Ссылка = СокрЛП(Строка(Ссылка));
	Запись.Прочитано = Ложь;
	Запись.Создано = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Запись.Сохранить();

	Лог.Отладка("Лента: учётке ""%1"" записано уведомление по поводу ""%2""",
		Пользователь.Логин, Запись.Повод);

	Возврат Запись;

КонецФункции

// Лента учётной записи целиком, свежие записи первыми.
//
// Параметры:
//  Пользователь - Пользователь - чья лента.
//
// Возвращаемое значение:
//  Массив из ЛичноеУведомление.
//
Функция Мои(Знач Пользователь) Экспорт
	Возврат Хранилище.ЛентаУчётки(Цел(Пользователь.Идентификатор));
КонецФункции

// Несколько свежайших непрочитанных записей — для виджета, которому нужны единицы строк,
// а не вся лента.
//
// Параметры:
//  Пользователь - Пользователь - чья лента.
//  Предел - Число - сколько записей вернуть.
//
// Возвращаемое значение:
//  Массив из ЛичноеУведомление.
//
Функция Свежие(Знач Пользователь, Знач Предел) Экспорт
	Возврат Хранилище.СвежиеНепрочитанные(Цел(Пользователь.Идентификатор), Цел(Предел));
КонецФункции

// Сколько записей ленты человек ещё не читал.
//
// Параметры:
//  Пользователь - Пользователь - чья лента.
//
// Возвращаемое значение:
//  Число.
//
Функция Непрочитано(Знач Пользователь) Экспорт
	Возврат Непрочитанные(Пользователь).Количество();
КонецФункции

// Отмечает прочитанной всю ленту учётной записи. Чужие записи не затрагиваются: отбор
// идёт по адресату, а не по тому, что попросили отметить.
//
// Параметры:
//  Пользователь - Пользователь - чья лента.
//
// Возвращаемое значение:
//  Число - сколько записей отмечено.
//
Функция ОтметитьВсеПрочитанными(Знач Пользователь) Экспорт

	Отмечено = 0;
	Для Каждого Запись Из Непрочитанные(Пользователь) Цикл
		Запись.Прочитано = Истина;
		Запись.Сохранить();
		Отмечено = Отмечено + 1;
	КонецЦикла;

	Лог.Отладка("Лента: учётке ""%1"" отмечено прочитанными %2 уведомлений",
		Пользователь.Логин, Отмечено);

	Возврат Отмечено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Непрочитанное спрашивается отбором, а не перебором всей ленты: счётчик рисуется
// на каждой приватной странице, а лента растёт без предела.
Функция Непрочитанные(Знач Пользователь)
	Возврат Хранилище.Непрочитанные(Цел(Пользователь.Идентификатор));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеЛичныхУведомлений") _Хранилище,
	&Лог _Лог = Неопределено)

	Хранилище = _Хранилище;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
