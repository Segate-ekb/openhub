// Летопись помех: запись того, что у хаба не получилось, со свёрткой повторов в одну
// строку со счётчиком, снятие помех подсистемы и уборка по сроку.

Перем Помехи;         // ХранилищеПомех (данные)
Перем Коды;           // КодыПомех (помехи)
Перем Настройки;      // СервисНастроек (настройки)
Перем Обезличивание;  // ОбезличиваниеЖурнала (наблюдаемость)
Перем Ошибки;         // ТекстОшибки (основа)
Перем Замок;          // БлокировкаРесурса — сериализация read-modify-write свёртки
Перем Часы;           // Объект с методом Сейчас() -> Дата, либо Неопределено (системные часы)
Перем Лог;

#Область ТестовыеШвы

// Подставляет источник времени — тестовый шов; в рабочем контейнере не вызывается.
//
// Параметры:
//  ИсточникВремени - Произвольный - объект с методом Сейчас(), возвращающим Дату.
//
Процедура УстановитьЧасы(Знач ИсточникВремени) Экспорт
	Часы = ИсточникВремени;
КонецПроцедуры

#КонецОбласти

#Область ПубличныйИнтерфейс

// Записывает помеху, сворачивая повторы: тот же ключ (подсистема, объект, предмет, код,
// прогон) увеличивает счётчик и двигает момент последнего. Наружу не бросает ни при каком
// сбое — зеркало и проба хранилища не имеют права упасть из-за летописи.
//
// Параметры:
//  Подсистема - Строка - «хранилище» | «зеркало» | «источник» (КодыПомех.Подсистемы).
//  Объект - Строка - адрес объекта из ОбъектыПомех.
//  Предмет - Строка - «пакет@версия»; пусто — помеха всего объекта.
//  Код - Строка - машинный код из КодыПомех.
//  Причина - Строка - фраза для человека; обезличивается и обрезается здесь.
//  Прогон - Строка - метка обхода (необязательный, по умолчанию пустая).
//  Секрет - Строка - значение, которого в причине быть не должно: токен источника,
//           пароль прокси (необязательный, по умолчанию пустая строка).
//
&Наблюдаемый
Процедура Записать(Знач Подсистема, Знач Объект, Знач Предмет, Знач Код, Знач Причина,
	Знач Прогон = "", Знач Секрет = "") Экспорт

	Попытка
		СвернутьПодЗамком(Подсистема, Объект, Предмет, Код,
			ДляЧеловека(Причина, Секрет), Прогон);
	Исключение
		Пожаловаться(СтрШаблон("запись помехи ""%1"" по объекту ""%2""", Код, Объект),
			ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Снимает помехи подсистемы по объекту: подсистема объявляет, что помех больше нет —
// хранилище поднялось, источник ответил. Чужие подсистемы того же объекта не задеты.
// Наружу не бросает.
//
// Параметры:
//  Подсистема - Строка - чьи помехи снимаются.
//  Объект - Строка - адрес объекта.
//
&Наблюдаемый
Процедура Снять(Знач Подсистема, Знач Объект) Экспорт

	Попытка
		СнятьПодЗамком(Подсистема, Объект);
	Исключение
		Пожаловаться(СтрШаблон("снятие помех ""%1"" по объекту ""%2""", Подсистема, Объект),
			ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Объявляет, что у подсистемы начался новый обход объекта: её помехи прошлых прогонов
// снимаются, чтобы причины позапрошлого раза не выдавались за причины текущего.
// Чужие подсистемы того же объекта не задеты. Наружу не бросает.
//
// Параметры:
//  Подсистема - Строка - чей обход начался.
//  Объект - Строка - адрес объекта.
//  Прогон - Строка - метка начавшегося обхода.
//
&Наблюдаемый
Процедура НачатьПрогон(Знач Подсистема, Знач Объект, Знач Прогон) Экспорт

	Попытка
		НачатьПрогонПодЗамком(Подсистема, Объект, Прогон);
	Исключение
		Пожаловаться(СтрШаблон("начало прогона ""%1"" подсистемы ""%2"" по объекту ""%3""",
			Прогон, Подсистема, Объект), ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

// Убирает помехи, которых дольше названного срока никто не касался.
//
// Параметры:
//  Момент - Дата - «сейчас» вызывающего; Неопределено — часы летописи (необязательный).
//
// Возвращаемое значение:
//  Число - сколько записей убрано.
//
// Сбой перебрасывается вызывающему: уборку зовёт планировщик, и её исход читает
// журнал фоновых задач.
//
&Наблюдаемый
Функция УбратьУстаревшие(Знач Момент = Неопределено) Экспорт

	Граница = ?(Момент = Неопределено, Сейчас(), Момент) - СрокЖизниСек();
	Возврат УбратьУстаревшиеПодЗамком(Граница);

КонецФункции

// Потолок числа записей на пару подсистема + объект: всё, что сверх него, сводится
// в одну строку «прочее» со счётчиком.
//
// Возвращаемое значение:
//  Число.
//
Функция ПотолокНаОбъект() Экспорт
	Возврат Настройки.Целое("oshub.incidents.max_per_object", 50, 1);
КонецФункции

// Сколько живёт запись помехи, секунды.
//
// Возвращаемое значение:
//  Число.
//
Функция СрокЖизниСек() Экспорт
	Возврат Настройки.Целое("oshub.incidents.ttl.sec", 1209600, 60);
КонецФункции

// Потолок длины фразы для человека: причина объясняет неудачу, а не возит в базе
// чужую портянку.
//
// Возвращаемое значение:
//  Число - символов.
//
Функция ПределПричины() Экспорт
	Возврат 500;
КонецФункции

#КонецОбласти

#Область ПодЗамком

// Каждое обращение к таблице сериализовано: свёртка читает срез пары, считает занятое
// и пишет, а снятие читает и удаляет. Без замка два пишущих завели бы дубль ключа,
// потеряли инкремент и перешагнули потолок. Хаб — один процесс, желудь один, поэтому
// процессного замка достаточно.
//
// Под замком — только таблица. Числа инсталляции снимаются ДО него: у СервисаНастроек
// свой замок, и звать его отсюда значило бы выстроить два замка в цепочку без всякой
// на то нужды.

Процедура СвернутьПодЗамком(Знач Подсистема, Знач Объект, Знач Предмет, Знач Код,
	Знач Причина, Знач Прогон)

	Потолок = ПотолокНаОбъект();

	Замок.Заблокировать();
	Попытка
		Свернуть(Подсистема, Объект, Предмет, Код, Причина, Прогон, Сейчас(), Потолок);
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

КонецПроцедуры

Процедура СнятьПодЗамком(Знач Подсистема, Знач Объект)

	Замок.Заблокировать();
	Попытка
		Убрать(Помехи.ПоОбъекту(Подсистема, Объект));
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

КонецПроцедуры

Процедура НачатьПрогонПодЗамком(Знач Подсистема, Знач Объект, Знач Прогон)

	Замок.Заблокировать();
	Попытка
		Убрать(ЧужиеПрогоны(Помехи.ПоОбъекту(Подсистема, Объект), Прогон));
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

КонецПроцедуры

Функция УбратьУстаревшиеПодЗамком(Знач Граница)

	Замок.Заблокировать();
	Попытка
		Убрано = Убрать(Помехи.СтарееЧем(Граница));
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Возврат Убрано;

КонецФункции

#КонецОбласти

#Область Свёртка

// Уникальность ключа держит этот метод, а не база: на бэкенде без ограничений второй
// строки с тем же ключом не заводится. Срез пары читается ОДИН раз — из него же видно
// и занятые слоты, и лежащую сводку переполнения.
Процедура Свернуть(Знач Подсистема, Знач Объект, Знач Предмет, Знач Код, Знач Причина,
	Знач Прогон, Знач Сейчас, Знач Потолок)

	Срез = Помехи.ПоОбъекту(Подсистема, Объект);
	Запись = НайтиКлюч(Срез, Предмет, Код, Прогон);
	Текст = Причина;

	Если Запись = Неопределено Тогда
		Если МестоЕсть(Срез, Потолок) Тогда
			Запись = Заведённая(Подсистема, Объект, Предмет, Код, Прогон, Сейчас);
		Иначе
			Запись = Сводка(Срез, Подсистема, Объект, Прогон, Сейчас);
			Текст = ПричинаПереполнения(Потолок);
		КонецЕсли;
	КонецЕсли;

	Запись.Причина = Текст;
	Запись.Количество = Запись.Количество + 1;
	Запись.Последний = Сейчас;
	Запись.Сохранить();

КонецПроцедуры

// Строка «прочее», которой достаётся счёт переполнения. Порядок предпочтений один:
// сводка этого прогона, затем свободный слот, затем любая сводка пары. Промолчать
// здесь нельзя — переполнение обязано быть видно счётчиком.
Функция Сводка(Знач Срез, Знач Подсистема, Знач Объект, Знач Прогон, Знач Сейчас)

	Своя = НайтиКлюч(Срез, "", Коды.Прочее(), Прогон);
	Если Своя <> Неопределено Тогда
		Возврат Своя;
	КонецЕсли;

	// свободный слот здесь есть всегда, пока своей сводки нет: обычных ключей в срезе
	// не больше «потолок минус один», и последний слот оставлен ровно под сводку
	Чужая = ПерваяСводка(Срез);
	Если Чужая = Неопределено Тогда
		Возврат Заведённая(Подсистема, Объект, "", Коды.Прочее(), Прогон, Сейчас);
	КонецЕсли;

	Возврат Чужая;

КонецФункции

// Обычный ключ занимает слот, только пока под сводку переполнения остаётся место.
Функция МестоЕсть(Знач Срез, Знач Потолок)
	Возврат Срез.Количество() < Потолок - 1;
КонецФункции

Функция НайтиКлюч(Знач Срез, Знач Предмет, Знач Код, Знач Прогон)

	Для Каждого Запись Из Срез Цикл
		Если Запись.Предмет = Текстом(Предмет) И Запись.Код = Текстом(Код)
			И Запись.Прогон = Текстом(Прогон) Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ПерваяСводка(Знач Срез)

	Для Каждого Запись Из Срез Цикл
		Если Запись.Код = Коды.Прочее() Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ЧужиеПрогоны(Знач Срез, Знач Прогон)

	Результат = Новый Массив();
	Для Каждого Запись Из Срез Цикл
		Если Запись.Прогон <> Текстом(Прогон) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Заведённая(Знач Подсистема, Знач Объект, Знач Предмет, Знач Код, Знач Прогон, Знач Сейчас)

	Запись = Помехи.СоздатьЭлемент();
	Запись.Подсистема = Текстом(Подсистема);
	Запись.Объект = Текстом(Объект);
	Запись.Предмет = Текстом(Предмет);
	Запись.Код = Текстом(Код);
	Запись.Прогон = Текстом(Прогон);
	Запись.Количество = 0;
	Запись.Впервые = Сейчас;
	Возврат Запись;

КонецФункции

Функция ПричинаПереполнения(Знач Потолок)
	Возврат СтрШаблон("Прочие причины сверх %1 показанных по этому объекту", Потолок);
КонецФункции

#КонецОбласти

#Область ОбезличиваниеПричины

// Фраза для человека: названный секрет вычеркнут, служебная обёртка OneScript снята,
// адреса внутри лишены строки запроса и учётных данных, длина ограничена. Подпись S3
// («X-Amz-Signature») уезжает со строкой запроса, токен в authority — с учётными данными.
Функция ДляЧеловека(Знач Причина, Знач Секрет)

	Текст = Ошибки.БезСекрета(Строка(?(Причина = Неопределено, "", Причина)), Секрет);
	Текст = Ошибки.Кратко(Текст);

	Слова = СтрРазделить(Текст, " ", Истина);
	Для Индекс = 0 По Слова.ВГраница() Цикл
		Слова[Индекс] = БезСекретаВАдресе(Слова[Индекс]);
	КонецЦикла;

	Возврат Обрезанная(СокрЛП(СтрСоединить(Слова, " ")));

КонецФункции

// Слово с «://» — адрес, и обезличивается целиком. Хвостовая пунктуация фразы адресом
// не является: без её отделения обезличенный адрес утащил бы за собой запятую и скобку.
Функция БезСекретаВАдресе(Знач Слово)

	Если СтрНайти(Слово, "://") = 0 Тогда
		Возврат Слово;
	КонецЕсли;

	Хвост = "";
	Тело = Слово;
	Пока ЗначениеЗаполнено(Тело) И Найти(ХвостоваяПунктуация(), Прав(Тело, 1)) > 0 Цикл
		Хвост = Прав(Тело, 1) + Хвост;
		Тело = Лев(Тело, СтрДлина(Тело) - 1);
	КонецЦикла;

	Возврат Обезличивание.Адрес(Тело) + Хвост;

КонецФункции

Функция ХвостоваяПунктуация()
	Возврат ".,;:!?)]}»""'";
КонецФункции

Функция Обрезанная(Знач Текст)

	Если СтрДлина(Текст) <= ПределПричины() Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, ПределПричины() - 1) + "…";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Убрать(Знач Записи)

	Убрано = 0;
	Для Каждого Запись Из Записи Цикл
		Помехи.Удалить(Запись);
		Убрано = Убрано + 1;
	КонецЦикла;
	Возврат Убрано;

КонецФункции

// Летопись молчит наружу, но не молчит в журнале: иначе пропавшее объяснение неудачи
// само стало бы необъяснимым. Информация приезжает параметром — достоверна она только
// в кадре обработчика, а здесь уже другой кадр.
Процедура Пожаловаться(Знач Что, Знач Инфо)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Лог.Предупреждение("Летопись помех: %1 не удалось, работа продолжается: %2",
		Что, Ошибки.Причина(Инфо));

КонецПроцедуры

Функция Текстом(Знач Значение)
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
КонецФункции

Функция Сейчас()
	Возврат ?(Часы = Неопределено, ТекущаяУниверсальнаяДата(), Часы.Сейчас());
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПомех") _Помехи,
	&Пластилин(Значение = "КодыПомех") _Коды,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Помехи = _Помехи;
	Коды = _Коды;
	Настройки = _Настройки;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	// обезличивание желудём не приезжает: внедрений у него нет, его создают «Новым»
	Обезличивание = Новый ОбезличиваниеЖурнала();
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
	Часы = Неопределено;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
