// Единственная реализация поиска пакетов: выборка читается через entity и ранжируется
// в памяти — тир релевантности, популярность, свежесть, имя.

Перем СервисПакетов;    // СервисПакетов (реестр)
Перем СлужбаСтатистики; // СлужбаСтатистикиСкачиваний (статистика)
Перем ВидимостьПулов;   // ВидимостьПулов (поиск)
Перем Отбор;            // ПоискПоКоллекции (поиск)
Перем Числа;            // ПриведениеЧисел (основа)

Перем РазмерСтраницыПоУмолчанию;

#Область НастройкиОтбора

Функция ПоляРанжирования()   Возврат "Имя,КлючевыеСлова,Описание"; КонецФункции
// Нечёткий этап только по имени: подпоследовательность в длинном описании совпадает со всем.
Функция ПоляНечёткогоЭтапа() Возврат "Имя"; КонецФункции

#КонецОбласти

#Область ПубличныйИнтерфейс

// Ранжированный поиск пакетов с пагинацией; выдача ограничена видимыми субъекту пулами,
// скрытые пакеты в неё не попадают, Страница клампится к диапазону [1; ВсегоСтраниц].
// Если по подстроке не нашлось ничего, отбор повторяется нечётко — запрос с опечаткой
// находит пакет.
//
// Параметры:
//  Запрос - Строка - подстрока, регистр не важен; пустая — каталог целиком (необязательный, по умолчанию "").
//  Страница - Число - номер страницы с 1 (необязательный, по умолчанию 1).
//  РазмерСтраницы - Число - размер страницы; 0 и меньше — размер по умолчанию (необязательный, по умолчанию 0).
//  Принципал - Структура, Неопределено - принципал запроса; Неопределено — аноним (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - Элементы (Массив из Пакет, уже ранжированы), Всего (Число, до пагинации),
//              Страница, ВсегоСтраниц, РазмерСтраницы (Число), Запрос (Строка, нормализованный).
//
Функция НайтиПакеты(Знач Запрос = "", Знач Страница = 1, Знач РазмерСтраницы = 0, Знач Принципал = Неопределено) Экспорт

	НормЗапрос = СокрЛП(?(Запрос = Неопределено, "", Строка(Запрос)));
	РазмерЧисло = Цел(Числа.ЧислоИлиНоль(РазмерСтраницы));
	Размер = ?(РазмерЧисло > 0, РазмерЧисло, РазмерСтраницыПоУмолчанию);

	Ранжированные = ОтобратьИРанжировать(НормЗапрос, Принципал);
	Всего = Ранжированные.Количество();

	ВсегоСтраниц = Макс(1, Цел((Всего + Размер - 1) / Размер));
	ТекСтраница = Мин(Макс(1, ?(Страница = Неопределено, 1, Цел(Страница))), ВсегоСтраниц);

	НачИндекс = (ТекСтраница - 1) * Размер;
	КонИндекс = Мин(НачИндекс + Размер - 1, Всего - 1);

	Элементы = Новый Массив();
	Если Всего > 0 Тогда
		Для Индекс = НачИндекс По КонИндекс Цикл
			Элементы.Добавить(Ранжированные[Индекс]);
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("Элементы", Элементы);
	Результат.Вставить("Всего", Всего);
	Результат.Вставить("Страница", ТекСтраница);
	Результат.Вставить("ВсегоСтраниц", ВсегоСтраниц);
	Результат.Вставить("РазмерСтраницы", Размер);
	Результат.Вставить("Запрос", НормЗапрос);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Оба этапа отбора работают уже над видимой запросу выборкой.
Функция ОтобратьИРанжировать(Знач НормЗапрос, Знач Принципал)

	Видимые = ВидимыеПакеты(Принципал);

	q = НРег(НормЗапрос);
	Если НЕ ЗначениеЗаполнено(q) Тогда
		Возврат ПоИмени(Видимые);
	КонецЕсли;

	Ранжированные = ПоРелевантности(Видимые, q);
	Если Ранжированные.Количество() = 0 Тогда
		Возврат Отбор.ОтобратьНечётко(Видимые, q, ПоляНечёткогоЭтапа());
	КонецЕсли;
	Возврат Ранжированные;

КонецФункции

// Решение ACL-видимости считается единожды на запрос, а не на каждый пакет, и оно же
// задаёт разрез чтения: выдача, ограниченная читаемыми пулами, читает только их пакеты,
// а не всю таблицу хаба. Само правило видимости разрез не заменяет — каждая строка
// проходит через него, и пакет-сирота в выдачу не попадает: fail-closed.
Функция ВидимыеПакеты(Знач Принципал)

	РешениеВидимости = ВидимостьПулов.Решение(Принципал);
	Читаемые = ВидимостьПулов.ЧитаемыеИдентификаторы(РешениеВидимости);

	Результат = Новый Массив();
	Для Каждого Пакет Из СервисПакетов.ПакетыПулов(Читаемые) Цикл
		Если Пакет.Скрыт = Истина Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ВидимостьПулов.ПакетВиден(РешениеВидимости, Пакет.ПулИдентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Пакет);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПоРелевантности(Знач Видимые, Знач q)

	Совпавшие = Совпавшие(Видимые, q);
	Скачивания = СкачиванияСовпавших(Совпавшие);

	Таблица = НоваяТаблицаПорядка();
	Для Каждого Совпадение Из Совпавшие Цикл

		Пакет = Совпадение.Пакет;
		Строка = Таблица.Добавить();
		Строка.Ключ = НРег(?(Пакет.Имя = Неопределено, "", Пакет.Имя));
		Строка.Оценка = Совпадение.Оценка;
		Строка.Популярность = СкачиванийПакета(Скачивания, Пакет.Идентификатор);
		Строка.Создан = ?(Пакет.Создан = Неопределено, '00010101', Пакет.Создан);
		Строка.Пакет = Пакет;

	КонецЦикла;

	Таблица.Сортировать("Оценка Убыв, Популярность Убыв, Создан Убыв, Ключ Возр");
	Возврат Пакеты(Таблица);

КонецФункции

Функция Совпавшие(Знач Видимые, Знач q)

	Результат = Новый Массив();
	Для Каждого Пакет Из Видимые Цикл
		Оценка = Отбор.ОценкаРелевантности(Пакет, q, ПоляРанжирования());
		Если Оценка <> 0 Тогда
			Результат.Добавить(Новый Структура("Пакет, Оценка", Пакет, Оценка));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПоИмени(Знач Видимые)

	Таблица = НоваяТаблицаПорядка();
	Для Каждого Пакет Из Видимые Цикл
		Строка = Таблица.Добавить();
		Строка.Ключ = НРег(?(Пакет.Имя = Неопределено, "", Пакет.Имя));
		Строка.Пакет = Пакет;
	КонецЦикла;
	Таблица.Сортировать("Ключ Возр");
	Возврат Пакеты(Таблица);

КонецФункции

Функция НоваяТаблицаПорядка()
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Ключ");
	Таблица.Колонки.Добавить("Оценка");
	Таблица.Колонки.Добавить("Популярность");
	Таблица.Колонки.Добавить("Создан");
	Таблица.Колонки.Добавить("Пакет");
	Возврат Таблица;
КонецФункции

Функция Пакеты(Знач Таблица)
	Результат = Новый Массив();
	Для Каждого Строка Из Таблица Цикл
		Результат.Добавить(Строка.Пакет);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Скачивания всех совпавших пакетов спрашиваются одним разрезом: вопрос на карточку
// превращал ранжирование в N+1. Сбой или отсутствие службы статистики не роняет поиск —
// тогда популярность у всех нулевая, и порядок задают оценка, свежесть и имя.
Функция СкачиванияСовпавших(Знач Совпавшие)

	Если СлужбаСтатистики = Неопределено Тогда
		Возврат Новый Соответствие();
	КонецЕсли;

	Идентификаторы = Новый Массив();
	Для Каждого Совпадение Из Совпавшие Цикл
		Идентификаторы.Добавить(Цел(Совпадение.Пакет.Идентификатор));
	КонецЦикла;

	Попытка
		Возврат СлужбаСтатистики.СкачиванияПакетов(Идентификаторы);
	Исключение
		Возврат Новый Соответствие();
	КонецПопытки;

КонецФункции

Функция СкачиванийПакета(Знач Скачивания, Знач ПакетИдентификатор)
	Всего = Скачивания.Получить(Цел(ПакетИдентификатор));
	Возврат ?(Всего = Неопределено, 0, Всего);
КонецФункции

#КонецОбласти

&Прозвище("СлужбаПоиска")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СлужбаСтатистикиСкачиваний") _СлужбаСтатистики,
	&Пластилин(Значение = "ВидимостьПулов") _ВидимостьПулов,
	&Пластилин(Значение = "ПоискПоКоллекции") _Отбор,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа)

	Числа = _Числа;

	СервисПакетов = _СервисПакетов;
	СлужбаСтатистики = _СлужбаСтатистики;
	ВидимостьПулов = _ВидимостьПулов;
	Отбор = _Отбор;
	РазмерСтраницыПоУмолчанию = 20;

КонецПроцедуры
