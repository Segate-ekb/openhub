// ACL-видимость пулов для поиска пакетов.
// Fail-closed: пакет с невидимым пулом (в т.ч. сирота без пула) в выдачу не попадает.

Перем СервисПулов;   // СервисПулов (реестр)
Перем СервисПрав;    // СервисПрав (auth)

#Область ПубличныйИнтерфейс

// Вычисляет решение видимости пулов для субъекта; считается единожды на запрос поиска.
// Публичные пулы видны всем, приватные — по праву чтения, для админа ACL не считается.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект запроса; Неопределено — аноним.
//
// Возвращаемое значение:
//  Структура - Админ (Булево), ВидимыеПулы (Соответствие ПулИд -> Истина).
//
Функция Решение(Знач Пользователь) Экспорт

	Админ = СервисПрав.ПользовательАдмин(Пользователь);
	ВидимыеПулы = Новый Соответствие();

	Если НЕ Админ Тогда
		Для Каждого Пул Из СервисПулов.ВсеПулы() Цикл
			Если НРег(Строка(Пул.Видимость)) = "public"
				ИЛИ СервисПрав.МожетЧитать(Пользователь, Пул) Тогда
				ВидимыеПулы.Вставить(Пул.Идентификатор, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("Админ", Админ);
	Результат.Вставить("ВидимыеПулы", ВидимыеПулы);
	Возврат Результат;

КонецФункции

// Виден ли субъекту пул.
//
// Параметры:
//  РешениеВидимости - Структура - результат метода Решение.
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Булево - Истина, если пул можно называть субъекту.
//
Функция ПулВиден(Знач РешениеВидимости, Знач ПулИдентификатор) Экспорт
	Если РешениеВидимости.Админ Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат РешениеВидимости.ВидимыеПулы.Получить(Цел(ПулИдентификатор)) <> Неопределено;
КонецФункции

// Виден ли субъекту пакет данного пула. Пакет-сирота не показывается — fail-closed.
//
// Параметры:
//  РешениеВидимости - Структура - результат метода Решение.
//  ПулИдентификатор - Число - пул пакета.
//
// Возвращаемое значение:
//  Булево - Истина, если пакет попадает в выдачу.
//
Функция ПакетВиден(Знач РешениеВидимости, Знач ПулИдентификатор) Экспорт
	Возврат ПулВиден(РешениеВидимости, ПулИдентификатор);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПрав") _СервисПрав)

	СервисПулов = _СервисПулов;
	СервисПрав = _СервисПрав;

КонецПроцедуры
