// ACL-видимость пулов для одной выдачи: решение считается единожды на запрос. Fail-closed:
// пакет с невидимым пулом, включая сироту без пула, в выдачу не попадает.

Перем ЧтениеПула;    // ГвардДоступаКПулу (права) — какие пулы можно называть запросу

#Область ПубличныйИнтерфейс

// Считает решение видимости для автора запроса. Что именно ему читаемо, решает гвард
// чтения пулов: публичное — всем, приватное — по праву человека в рамках ключа запроса.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса (Пользователь, Способ, Права,
//              ПулИдентификатор); Неопределено — аноним.
//
// Возвращаемое значение:
//  Структура - ВидимыеПулы (Соответствие ПулИд -> Истина).
//
Функция Решение(Знач Принципал) Экспорт

	ВидимыеПулы = Новый Соответствие();
	Для Каждого Пул Из ЧтениеПула.ЧитаемыеПулы(Принципал) Цикл
		ВидимыеПулы.Вставить(Цел(Пул.Идентификатор), Истина);
	КонецЦикла;

	Возврат Новый Структура("ВидимыеПулы", ВидимыеПулы);

КонецФункции

// Идентификаторы пулов, читаемых субъекту — разрез чтения для выдачи, которая не хочет
// поднимать весь хаб ради видимой его части. Состав решения наружу не раскрывается:
// перечисляет его владелец правила, а не тот, кому нужен список.
//
// Параметры:
//  РешениеВидимости - Структура - результат метода Решение.
//
// Возвращаемое значение:
//  Массив из Число - идентификаторы читаемых пулов; пустой массив — читать нечего.
//
Функция ЧитаемыеИдентификаторы(Знач РешениеВидимости) Экспорт

	Результат = Новый Массив();
	Для Каждого КиЗ Из РешениеВидимости.ВидимыеПулы Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Виден ли субъекту пул.
//
// Параметры:
//  РешениеВидимости - Структура - результат метода Решение.
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Булево - Истина, если пул можно называть субъекту.
//
Функция ПулВиден(Знач РешениеВидимости, Знач ПулИдентификатор) Экспорт
	Возврат РешениеВидимости.ВидимыеПулы.Получить(Цел(ПулИдентификатор)) <> Неопределено;
КонецФункции

// Виден ли субъекту пакет данного пула. Пакет-сирота не показывается — fail-closed.
//
// Параметры:
//  РешениеВидимости - Структура - результат метода Решение.
//  ПулИдентификатор - Число - пул пакета.
//
// Возвращаемое значение:
//  Булево - Истина, если пакет попадает в выдачу.
//
Функция ПакетВиден(Знач РешениеВидимости, Знач ПулИдентификатор) Экспорт
	Возврат ПулВиден(РешениеВидимости, ПулИдентификатор);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардДоступаКПулу") _ЧтениеПула)

	ЧтениеПула = _ЧтениеПула;

КонецПроцедуры
