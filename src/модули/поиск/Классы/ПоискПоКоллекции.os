// Отбор элементов коллекции в памяти по подстроке запроса с ранжированием по указанным
// полям; когда подстрока не нашлась, работает нечёткий этап поверх библиотеки fzy.

#Использовать fzy

Перем Строки;   // КанонСтроки (основа)

#Область КонстантыРанжирования

Функция ВесТочного()    Возврат 300; КонецФункции
Функция ВесПрефикса()   Возврат 200; КонецФункции
Функция ВесПодстроки()  Возврат 100; КонецФункции
// Шаг между полями заведомо больше любого веса вида совпадения: поле важнее вида совпадения.
Функция ШагПоля()       Возврат 1000; КонецФункции

// Обрывок в два-три символа нечётко совпадает почти со всем, поэтому вариантами не размывается.
Функция ДлинаЗапросаДляОпечатки() Возврат 4; КонецФункции

#КонецОбласти

#Область ПубличныйИнтерфейс

// Отбирает элементы коллекции по запросу и упорядочивает их по релевантности.
// Пустой запрос — вся коллекция в исходном порядке. Если по подстроке не нашлось
// ничего, отбор повторяется нечётко (опечатка в один символ).
//
// Параметры:
//  Коллекция - Массив, ТаблицаЗначений - элементы с полями, перечисленными в Поля.
//  Запрос - Строка - подстрока, регистр не важен.
//  Поля - Строка - имена полей через запятую в порядке убывания важности.
//
// Возвращаемое значение:
//  Массив - отобранные элементы; при равной релевантности порядок исходной коллекции.
//
Функция Отобрать(Знач Коллекция, Знач Запрос, Знач Поля) Экспорт

	Элементы = ВМассив(Коллекция);
	q = Нормализовать(Запрос);
	Если НЕ ЗначениеЗаполнено(q) Тогда
		Возврат Элементы;
	КонецЕсли;

	СписокПолей = РазобратьПоля(Поля);

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Оценка");
	Таблица.Колонки.Добавить("Позиция");
	Таблица.Колонки.Добавить("Элемент");

	Для Позиция = 0 По Элементы.ВГраница() Цикл
		Оценка = ОценкаПоПолям(Элементы[Позиция], q, СписокПолей);
		Если Оценка = 0 Тогда
			Продолжить;
		КонецЕсли;
		Строка = Таблица.Добавить();
		Строка.Оценка = Оценка;
		Строка.Позиция = Позиция;
		Строка.Элемент = Элементы[Позиция];
	КонецЦикла;

	Если Таблица.Количество() = 0 Тогда
		Возврат ОтобратьНечётко(Элементы, q, Поля);
	КонецЕсли;

	Таблица.Сортировать("Оценка Убыв, Позиция Возр");

	Результат = Новый Массив();
	Для Каждого Строка Из Таблица Цикл
		Результат.Добавить(Строка.Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Оценивает релевантность элемента запросу: поле важнее вида совпадения в нём,
// внутри поля точное совпадение важнее префикса, а префикс — вхождения.
//
// Параметры:
//  Элемент - Произвольный - объект с полями, перечисленными в Поля.
//  Запрос - Строка - подстрока, регистр не важен.
//  Поля - Строка - имена полей через запятую в порядке убывания важности.
//
// Возвращаемое значение:
//  Число - оценка релевантности; 0 — элемент запросу не подошёл.
//
Функция ОценкаРелевантности(Знач Элемент, Знач Запрос, Знач Поля) Экспорт
	q = Нормализовать(Запрос);
	Если НЕ ЗначениеЗаполнено(q) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат ОценкаПоПолям(Элемент, q, РазобратьПоля(Поля));
КонецФункции

// Отбирает элементы нечётко: запрос совпадает, если его символы встречаются в тексте
// полей по порядку. Запрос от четырёх символов ищется ещё и вариантами с одним
// пропущенным символом — так находится опечатка в одну позицию («josn» → «json»).
//
// Параметры:
//  Коллекция - Массив, ТаблицаЗначений - элементы с полями, перечисленными в Поля.
//  Запрос - Строка - подстрока, регистр не важен; пустая — пустая выдача.
//  Поля - Строка - имена полей через запятую; их значения склеиваются в текст поиска.
//
// Возвращаемое значение:
//  Массив - отобранные элементы в порядке убывания близости к запросу.
//
Функция ОтобратьНечётко(Знач Коллекция, Знач Запрос, Знач Поля) Экспорт

	Результат = Новый Массив();

	Элементы = ВМассив(Коллекция);
	q = Нормализовать(Запрос);
	Если НЕ ЗначениеЗаполнено(q) ИЛИ Элементы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	СписокПолей = РазобратьПоля(Поля);
	Тексты = Новый Соответствие();
	Для Позиция = 0 По Элементы.ВГраница() Цикл
		Тексты.Вставить(Позиция, ТекстПолей(Элементы[Позиция], СписокПолей));
	КонецЦикла;

	// имя переменной не «Поиск»: локальная переменная отобрала бы имя у типа библиотеки
	Нечёткий = Новый Поиск(Тексты);

	Найденные = Новый Массив();
	Отмеченные = Новый Соответствие();
	ДобавитьНайденные(Нечёткий, q, Найденные, Отмеченные);

	Если Найденные.Количество() = 0 И СтрДлина(q) >= ДлинаЗапросаДляОпечатки() Тогда
		Для Символ = 1 По СтрДлина(q) Цикл
			ДобавитьНайденные(Нечёткий, БезСимвола(q, Символ), Найденные, Отмеченные);
		КонецЦикла;
	КонецЕсли;

	Для Каждого Найденная Из Найденные Цикл
		Результат.Добавить(Элементы[Найденная]);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Первое подошедшее поле и определяет оценку: важное поле весомее следующего.
Функция ОценкаПоПолям(Знач Элемент, Знач q, Знач СписокПолей)

	Для Индекс = 0 По СписокПолей.ВГраница() Цикл

		Значение = НРег(ЗначениеПоля(Элемент, СписокПолей[Индекс]));
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;

		Если Значение = q Тогда
			Вид = ВесТочного();
		ИначеЕсли СтрНачинаетсяС(Значение, q) Тогда
			Вид = ВесПрефикса();
		ИначеЕсли СтрНайти(Значение, q) > 0 Тогда
			Вид = ВесПодстроки();
		Иначе
			Продолжить;
		КонецЕсли;

		Возврат (СписокПолей.Количество() - Индекс) * ШагПоля() + Вид;

	КонецЦикла;

	Возврат 0;

КонецФункции

Процедура ДобавитьНайденные(Нечёткий, Знач Запрос, Найденные, Отмеченные)

	Если НЕ ЗначениеЗаполнено(Запрос) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Ключ Из Нечёткий.НайтиЗначенияИлиКлючи(Запрос, 0, Истина) Цикл
		Если Отмеченные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Отмеченные.Вставить(Ключ, Истина);
		Найденные.Добавить(Ключ);
	КонецЦикла;

КонецПроцедуры

// Отсутствующее поле не роняет отбор: коллекции разнородны, а имена полей задаёт вызывающий.
Функция ЗначениеПоля(Знач Элемент, Знач ИмяПоля)
	Попытка
		Значение = Элемент[ИмяПоля];
	Исключение
		Возврат "";
	КонецПопытки;
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

Функция ТекстПолей(Знач Элемент, Знач СписокПолей)
	Части = Новый Массив();
	Для Каждого ИмяПоля Из СписокПолей Цикл
		Значение = ЗначениеПоля(Элемент, ИмяПоля);
		Если ЗначениеЗаполнено(Значение) Тогда
			Части.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, " ");
КонецФункции

Функция БезСимвола(Знач Значение, Знач Позиция)
	Возврат Лев(Значение, Позиция - 1) + Сред(Значение, Позиция + 1);
КонецФункции

Функция Нормализовать(Знач Запрос)
	Возврат Строки.Канон(Запрос);
КонецФункции

Функция РазобратьПоля(Знач Поля)
	Результат = Новый Массив();
	Для Каждого ИмяПоля Из СтрРазделить(?(Поля = Неопределено, "", Строка(Поля)), ",", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(ИмяПоля)) Тогда
			Результат.Добавить(СокрЛП(ИмяПоля));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ВМассив(Знач Коллекция)
	Если ТипЗнч(Коллекция) = Тип("Массив") Тогда
		Возврат Коллекция;
	КонецЕсли;
	Результат = Новый Массив();
	Если Коллекция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из Коллекция Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "КанонСтроки") _Строки = Неопределено)

	Строки = ?(_Строки = Неопределено, Новый КанонСтроки(), _Строки);
КонецПроцедуры
