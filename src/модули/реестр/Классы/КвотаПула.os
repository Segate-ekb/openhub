// Единственное место, где разрешается действующая квота пула, читается её сырое значение
// и выносится вердикт по вводу. Колонка Пул.КвотаМб трёхзначная: -1 — как в хабе,
// 0 — без ограничения, больше нуля — своя квота.

Перем Настройки;  // СервисНастроек (настройки) — опционален

#Область ПубличныйИнтерфейс

// Значение колонки КвотаМб, означающее «как в хабе».
//
// Возвращаемое значение:
//  Число.
//
Функция КакВХабе() Экспорт
	Возврат -1;
КонецФункции

// Значение колонки КвотаМб, означающее «без ограничения».
//
// Возвращаемое значение:
//  Число.
//
Функция БезОграничения() Экспорт
	Возврат 0;
КонецФункции

// Квота пула по умолчанию, заданная настройкой хаба.
//
// Возвращаемое значение:
//  Число - МБ; 0 — хаб пулов не ограничивает.
//
Функция ПоУмолчаниюМб() Экспорт

	Если Настройки = Неопределено Тогда
		Возврат ДефолтБезРеестра();
	КонецЕсли;

	Попытка
		Возврат Неотрицательное(Настройки.Значение(КлючНастройки()));
	Исключение
		// нечитаемая настройка не должна превращаться в нулевую квоту всем пулам
		Возврат ДефолтБезРеестра();
	КонецПопытки;

КонецФункции

// Ключ настройки хаба с квотой пула по умолчанию.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючНастройки() Экспорт
	Возврат "oshub.pools.default_quota_mb";
КонецФункции

// Наследует ли пул квоту хаба.
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Булево.
//
Функция НаследуетХаб(Знач Пул) Экспорт
	Возврат Пул <> Неопределено И Собственная(Пул) = КакВХабе();
КонецФункции

// Действующая квота пула с учётом настройки хаба.
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Число - МБ; 0 — без ограничения.
//
Функция ЭффективнаяМб(Знач Пул) Экспорт

	Если Пул = Неопределено Тогда
		Возврат БезОграничения();
	КонецЕсли;

	Своя = Собственная(Пул);
	Если Своя = КакВХабе() Тогда
		Возврат ПоУмолчаниюМб();
	КонецЕсли;
	Возврат Неотрицательное(Своя);

КонецФункции

// Действующая квота пула в байтах.
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Число - байты; 0 — без ограничения.
//
Функция ЭффективнаяБайт(Знач Пул) Экспорт
	Возврат ЭффективнаяМб(Пул) * 1024 * 1024;
КонецФункции

// Наибольшая допустимая квота: величина выше неё теряет точность в арифметике сверки
// занятого объёма, поэтому не принимается ни формой, ни API.
//
// Возвращаемое значение:
//  Число - МБ.
//
Функция ПредельнаяМб() Экспорт
	Возврат 1000000000000;
КонецФункции

// Причина отказа: значение не является допустимым числом мегабайт.
//
// Возвращаемое значение:
//  Строка - код причины.
//
Функция ПричинаЧисло() Экспорт
	Возврат "число";
КонецФункции

// Причина отказа: квота выше потолка.
//
// Возвращаемое значение:
//  Строка - код причины.
//
Функция ПричинаПотолок() Экспорт
	Возврат "потолок";
КонецФункции

// Читает сырое значение квоты, пришедшее из формы или тела запроса. Ведущий минус
// допустим: «как в хабе» пишется числом -1, и парсер, бракующий знак, отверг бы
// собственное значение колонки по умолчанию. Диапазон судит Проверить, а не чтение.
//
// Параметры:
//  Сырое - Произвольный - значение, пришедшее снаружи.
//
// Возвращаемое значение:
//  Число, Неопределено - целое либо Неопределено, если значения нет или оно не целое.
//
Функция Прочитать(Знач Сырое) Экспорт

	Текст = СокрЛП(?(Сырое = Неопределено, "", Строка(Сырое)));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Знак = 1;
	Если Лев(Текст, 1) = "-" Тогда
		Знак = -1;
		Текст = Сред(Текст, 2);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Поз = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Поз, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	Возврат Знак * Число(Текст);

КонецФункции

// Судит квоту до записи. Значимы оба нижних значения: -1 — «как в хабе», 0 — «без
// ограничения», поэтому неразобранное значение (Неопределено) ни к тому, ни к другому
// не приводится, а отвергается.
//
// Параметры:
//  КвотаМб - Число, Неопределено - квота в МБ; Неопределено — значение не разобрано.
//
// Возвращаемое значение:
//  Структура - Ок (Булево), Квота (Число), Причина (Строка: "" либо код причины отказа).
//
Функция Проверить(Знач КвотаМб) Экспорт

	Если ТипЗнч(КвотаМб) <> Тип("Число") ИЛИ КвотаМб < КакВХабе() Тогда
		Возврат Вердикт(Ложь, 0, ПричинаЧисло());
	КонецЕсли;

	Если КвотаМб > ПредельнаяМб() Тогда
		Возврат Вердикт(Ложь, Цел(КвотаМб), ПричинаПотолок());
	КонецЕсли;

	Возврат Вердикт(Истина, Цел(КвотаМб), "");

КонецФункции

// Читает сырое значение и сразу судит его: единственный вход правила для формы раздела
// «Пулы», дома настроек пула, REST-API и создания пула.
//
// Параметры:
//  Сырое - Произвольный - значение, пришедшее снаружи.
//
// Возвращаемое значение:
//  Структура - Ок (Булево), Квота (Число), Причина (Строка: "" либо код причины отказа).
//
Функция Рассудить(Знач Сырое) Экспорт
	Возврат Проверить(Прочитать(Сырое));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Значение колонки как оно записано: -1, 0 либо положительное число.
Функция Собственная(Знач Пул)

	Если Пул.КвотаМб = Неопределено Тогда
		Возврат КакВХабе(); // пул, заведённый мимо сервиса, наследует хаб, а не безлимит
	КонецЕсли;

	Значение = Цел(Число(Пул.КвотаМб));
	Возврат ?(Значение < 0, КакВХабе(), Значение);

КонецФункции

// Контейнер без модуля настройки (юнит-наборы домена) обязан вести себя так же,
// как хаб со значением реестра по умолчанию.
Функция ДефолтБезРеестра()
	Возврат 1024;
КонецФункции

Функция Вердикт(Знач Ок, Знач Квота, Знач Причина)
	Возврат Новый Структура("Ок, Квота, Причина", Ок, Квота, Причина);
КонецФункции

Функция Неотрицательное(Знач Значение)
	Если Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Число_ = Цел(Число(Значение));
	Возврат ?(Число_ < 0, 0, Число_);
КонецФункции

#КонецОбласти

&Прозвище("КвотаПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек", Тип = "Массив") _Настройки)

	// Массив — способ ОСени выразить необязательную зависимость: контейнер без модуля
	// settings собирается, а квота по умолчанию читается тем же числом, что в реестре.
	Настройки = ?(_Настройки = Неопределено ИЛИ _Настройки.Количество() = 0, Неопределено, _Настройки[0]);

КонецПроцедуры
