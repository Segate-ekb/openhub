// Словарь — единственный владелец значений колонки Тег.Значок. Без состояния.
// Хранится КЛЮЧ из закрытого списка: значок рисуется инлайновой иконкой кита и наследует
// цвет стиля через currentColor, поэтому картинок в хранилище не заводим. Пустой ключ —
// плашка без значка, это значение по умолчанию.

#Область ПубличныйИнтерфейс

// Возвращает ключ «без значка».
//
// Возвращаемое значение:
//  Строка - пустая строка.
//
Функция Нет() Экспорт
	Возврат "";
КонецФункции

// Возвращает все допустимые ключи значков в порядке показа, кроме пустого.
//
// Возвращаемое значение:
//  Массив из Строка - ключи значков.
//
Функция Все() Экспорт

	Результат = Новый Массив();
	Результат.Добавить("check");
	Результат.Добавить("verified");
	Результат.Добавить("warning");
	Результат.Добавить("stop");
	Результат.Добавить("lock");
	Результат.Добавить("history");
	Результат.Добавить("cube");
	Результат.Добавить("key");
	Возврат Результат;

КонецФункции

// Нормализует ключ значка. Незнакомый ключ сводится к «без значка»: значок —
// оформление, и старая строка БД не должна ронять показ.
//
// Параметры:
//  Значение - Произвольный - сырое значение из формы, тела запроса или строки БД.
//
// Возвращаемое значение:
//  Строка - ключ значка либо "".
//
Функция Нормализовать(Знач Значение) Экспорт

	Норм = НРег(СокрЛП(?(Значение = Неопределено, "", Строка(Значение))));
	Возврат ?(Все().Найти(Норм) = Неопределено, Нет(), Норм);

КонецФункции

// Проверяет, знаком ли ключ значка.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина для пустого значения и для любого ключа из списка.
//
Функция Допустим(Знач Значение) Экспорт

	Норм = НРег(СокрЛП(?(Значение = Неопределено, "", Строка(Значение))));
	Возврат ПустаяСтрока(Норм) ИЛИ Все().Найти(Норм) <> Неопределено;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
