// Список масок имён пакетов, которым разрешено приезжать из внешнего источника: allowlist
// апстрима пула и фильтр зеркала — один и тот же список и одно правило. Пустой список
// пропускает всё, неразбираемый не пропускает ничего (fail-closed).

&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Проверяет, что список задан корректно. Некорректный — исключение с внятным текстом.
//
// Параметры:
//  JSON - Строка - JSON-массив масок имён; пустая строка — без ограничений.
//
Процедура Проверить(Знач JSON) Экспорт

	Если ЗначениеЗаполнено(JSON) И Маски(JSON) = Неопределено Тогда
		// без текста платформенного разбора: он несёт координаты чужого кадра, а не подсказку
		ВызватьИсключение
			"allowlist источника должен быть JSON-массивом масок имён"
			+ " (например [""corp-*"",""mylib""])";
	КонецЕсли;

КонецПроцедуры

// Маски списка, приведённые к сравнимому виду: нижний регистр и без окружающих пробелов —
// пробел вокруг маски след ручной правки настройки, а не часть имени пакета.
//
// Параметры:
//  JSON - Строка - JSON-массив масок имён; пустая строка — без ограничений.
//
// Возвращаемое значение:
//  Массив из Строка, Неопределено - маски; пустой массив пропускает всё,
//   Неопределено — список не разбирается и не пропускает ничего (fail-closed).
//
Функция Маски(Знач JSON) Экспорт

	Результат = Новый Массив();
	Если НЕ ЗначениеЗаполнено(JSON) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(JSON);
		Разобрано = ПрочитатьJSON(Чтение);
	Исключение
		Возврат Неопределено; // некорректный JSON — fail-closed
	КонецПопытки;

	Если ТипЗнч(Разобрано) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Маска Из Разобрано Цикл
		Результат.Добавить(НРег(СокрЛП(Строка(Маска))));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Задан ли список: заданный сужает состав источника, и обход это учитывает.
//
// Параметры:
//  СписокМасок - Массив из Строка, Неопределено - разобранные маски.
//
// Возвращаемое значение:
//  Булево - Ложь только у пустого списка масок, пропускающего всё.
//
Функция Задан(Знач СписокМасок) Экспорт
	Возврат СписокМасок = Неопределено ИЛИ СписокМасок.Количество() > 0;
КонецФункции

// Пропускают ли разобранные маски имя пакета. Регистр имени значения не имеет: имена
// пакетов хаб канонизирует нижним регистром.
//
// Параметры:
//  СписокМасок - Массив из Строка, Неопределено - разобранные маски; пустой список
//                пропускает всё, Неопределено — ничего.
//  Имя - Строка - имя пакета у источника.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПропускаетИмя(Знач СписокМасок, Знач Имя) Экспорт

	Если СписокМасок = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СписокМасок.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ПервоеСовпадение(СписокМасок, Имя) <> Неопределено;

КонецФункции

// Пропускает ли список имя пакета — дверь для тех, кто держит список строкой и ждёт
// объяснения в журнале.
//
// Параметры:
//  JSON - Строка - JSON-массив масок имён; пустая строка — без ограничений.
//  ИмяПакета - Строка - проверяемое имя.
//  Адрес - Строка - адрес источника для журнала (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Булево - Истина, если имя разрешено. Некорректный список запрещает всё.
//
Функция Пропускает(Знач JSON, Знач ИмяПакета, Знач Адрес = "") Экспорт

	Если НЕ ЗначениеЗаполнено(JSON) Тогда
		Возврат Истина;
	КонецЕсли;

	СписокМасок = Маски(JSON);
	Если СписокМасок = Неопределено Тогда
		Лог.Ошибка("Некорректный allowlist источника %1 — проксирование запрещено (fail-closed)",
			?(ЗначениеЗаполнено(Адрес), Адрес, "не задан"));
		Возврат Ложь;
	КонецЕсли;

	Если СписокМасок.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Совпавшая = ПервоеСовпадение(СписокМасок, ИмяПакета);
	Если Совпавшая <> Неопределено Тогда
		Лог.Отладка("Allowlist источника %1: имя ""%2"" разрешено маской ""%3""",
			Адрес, ИмяПакета, Совпавшая);
		Возврат Истина;
	КонецЕсли;

	Лог.Отладка("Allowlist источника %1: имя ""%2"" не совпало ни с одной из %3 масок",
		Адрес, ИмяПакета, СписокМасок.Количество());
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Первая маска, накрывшая имя, либо Неопределено. Маска возвращается, а не признак:
// журнал называет ту, что решила исход.
Функция ПервоеСовпадение(Знач СписокМасок, Знач Имя)

	ИмяКанон = НРег(Имя);
	Для Каждого Маска Из СписокМасок Цикл
		Если Новый МаскаИмениПакета(Маска).Совпадает(ИмяКанон) Тогда
			Возврат Маска;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

&Прозвище("АллоулистИмён")
&Желудь
Процедура ПриСозданииОбъекта(&Лог _Лог = Неопределено)
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
КонецПроцедуры
