// Приём версии из внешнего источника (зеркало, прокси): индексация версии, базовые теги
// пакета и перенос состава её зависимостей из манифеста — одной операцией, чтобы ветка
// индексации не потеряла ни состав, ни теги.

Перем СервисВерсий;        // СервисВерсий
Перем СервисЗависимостей;  // СервисЗависимостей
Перем СервисТегов;         // СервисТегов
Перем Зависимости;         // ЗависимостиМанифеста
&Лог
Перем Лог;

// Индексирует внешнюю версию, обеспечивает базовые теги её пакета и переносит в реестр
// состав её зависимостей. Легаси-хаб тегов не отдаёт, поэтому привезённый пакет получает
// их здесь — иначе он ставился бы иначе, чем опубликованный тут.
// Идемпотентна: уже проиндексированная версия возвращается как есть, а состав заменяется
// целиком — повторный приём дублей не оставляет. Состав получает та версия, которую
// принимают: вызывающий, пропускающий приём для уже проиндексированной версии (так делает
// зеркало), её состав и не обновит. Манифест = Неопределено прежний состав не трогает:
// нечитаемый артефакт — не повод забыть уже известные зависимости.
//
// Параметры:
//  Заявка - ЗаявкаНаПубликацию - данные внешней версии.
//  Манифест - МанифестПакета, Неопределено - манифест артефакта; Неопределено —
//             манифест недоступен.
//  АпстримИдентификатор - Число - апстрим-источник (необязательный, по умолчанию 0 —
//                         неизвестен).
//
// Возвращаемое значение:
//  ВерсияПакета - созданная либо ранее проиндексированная версия.
//
Функция Принять(Знач Заявка, Знач Манифест, Знач АпстримИдентификатор = 0) Экспорт

	Версия = СервисВерсий.ИндексироватьВнешнюю(Заявка, АпстримИдентификатор);
	СервисТегов.ОбеспечитьБазовыеТеги(Заявка.ПакетИдентификатор);

	Если Манифест = Неопределено Тогда
		Лог.Отладка("Приём внешней версии: пакет #%1 версия %2 с апстрима #%3 проиндексирована"
			+ " как #%4, манифест недоступен — состав зависимостей оставлен прежним",
			Заявка.ПакетИдентификатор, Заявка.Версия, АпстримИдентификатор, Версия.Идентификатор);
	Иначе
		Состав = Зависимости.Состав(Манифест);
		СервисЗависимостей.ЗаписатьСостав(Версия.Идентификатор, Состав);
		Лог.Отладка("Приём внешней версии: пакет #%1 версия %2 с апстрима #%3 проиндексирована"
			+ " как #%4, зависимостей в манифесте %5",
			Заявка.ПакетИдентификатор, Заявка.Версия, АпстримИдентификатор, Версия.Идентификатор,
			Состав.Количество());
	КонецЕсли;

	Возврат Версия;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисЗависимостей") _СервисЗависимостей,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "ЗависимостиМанифеста") _Зависимости,
	&Лог _Лог = Неопределено)

	СервисВерсий = _СервисВерсий;
	СервисЗависимостей = _СервисЗависимостей;
	СервисТегов = _СервисТегов;
	Зависимости = _Зависимости;

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
