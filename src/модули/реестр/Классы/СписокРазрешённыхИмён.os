// Allowlist имён пакетов источника: JSON-массив масок. Пустой список пропускает всё,
// некорректный JSON запрещает всё (fail-closed).

&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Проверяет, что список задан корректно. Некорректный — исключение с внятным текстом.
//
// Параметры:
//  JSON - Строка - JSON-массив масок имён; пустая строка — без ограничений.
//
Процедура Проверить(Знач JSON) Экспорт

	Если НЕ ЗначениеЗаполнено(JSON) Тогда
		Возврат;
	КонецЕсли;

	Разобрано = Разобрать(JSON);
	Если Разобрано = Неопределено ИЛИ ТипЗнч(Разобрано) <> Тип("Массив") Тогда
		// без текста платформенного разбора: он несёт координаты чужого кадра, а не подсказку
		ВызватьИсключение
			"allowlist источника должен быть JSON-массивом масок имён"
			+ " (например [""corp-*"",""mylib""])";
	КонецЕсли;

КонецПроцедуры

// Пропускает ли список имя пакета. Пустой список — без ограничений; маски
// регистронезависимы, "*" в них означает любой фрагмент.
//
// Параметры:
//  JSON - Строка - JSON-массив масок имён; пустая строка — без ограничений.
//  ИмяПакета - Строка - проверяемое имя.
//  Адрес - Строка - адрес источника для журнала (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Булево - Истина, если имя разрешено. Некорректный список запрещает всё.
//
Функция Пропускает(Знач JSON, Знач ИмяПакета, Знач Адрес = "") Экспорт

	Если НЕ ЗначениеЗаполнено(JSON) Тогда
		Возврат Истина;
	КонецЕсли;

	Маски = Разобрать(JSON);
	Если Маски = Неопределено ИЛИ ТипЗнч(Маски) <> Тип("Массив") Тогда
		Лог.Ошибка("Некорректный allowlist источника %1 — проксирование запрещено (fail-closed)",
			?(ЗначениеЗаполнено(Адрес), Адрес, "не задан"));
		Возврат Ложь;
	КонецЕсли;

	Если Маски.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	ИмяКанон = НРег(ИмяПакета);
	Для Каждого Маска Из Маски Цикл
		Если Новый МаскаИмениПакета(НРег(Строка(Маска))).Совпадает(ИмяКанон) Тогда
			Лог.Отладка("Allowlist источника %1: имя ""%2"" разрешено маской ""%3""",
				Адрес, ИмяПакета, Маска);
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Лог.Отладка("Allowlist источника %1: имя ""%2"" не совпало ни с одной из %3 масок",
		Адрес, ИмяПакета, Маски.Количество());
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Разобрать(Знач JSON)
	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(JSON);
		Возврат ПрочитатьJSON(Чтение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Лог _Лог = Неопределено)
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
КонецПроцедуры
