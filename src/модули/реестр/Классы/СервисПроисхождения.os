// Происхождение версии: опубликована в этом хабе или получена с апстрима, и доверенная ли
// это публикация. Отсутствие записи — «свой» и «не доверенная», fail-closed.

Перем ХранилищеПроисхождения; // ХранилищеПроисхожденияВерсий (данные)

#Область ПубличныйИнтерфейс

// Возвращает значение источника «опубликовано в этом хабе».
//
// Возвращаемое значение:
//  Строка - имя источника.
//
Функция ИсточникСвой() Экспорт
	Возврат "свой";
КонецФункции

// Возвращает значение источника «получено с апстрима».
//
// Возвращаемое значение:
//  Строка - имя источника.
//
Функция ИсточникАпстрим() Экспорт
	Возврат "апстрим";
КонецФункции

// Фиксирует происхождение версии. Идемпотентно: повторный вызов обновляет существующую
// запись, дублей не создаёт. Версия Неопределено — исключение.
//
// Параметры:
//  Версия - ВерсияПакета - размечаемая версия.
//  Источник - Строка - ИсточникСвой или ИсточникАпстрим.
//  АпстримИдентификатор - Число - апстрим-источник (необязательный, по умолчанию 0 —
//                        свой либо неизвестен).
//  ДовереннаяПубликация - Булево - версия принята доверенной публикацией
//                         (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  ПроисхождениеВерсии - сохранённая запись.
//
Функция Зафиксировать(Знач Версия, Знач Источник, Знач АпстримИдентификатор = 0,
	Знач ДовереннаяПубликация = Ложь) Экспорт

	Если Версия = Неопределено Тогда
		ВызватьИсключение "Провенанс фиксируется для существующей версии";
	КонецЕсли;

	Запись = ХранилищеПроисхождения.ПолучитьОдноПоВерсияИдентификаторРавно(Версия.Идентификатор);
	Если Запись = Неопределено Тогда
		Запись = ХранилищеПроисхождения.СоздатьЭлемент();
		Запись.ВерсияИдентификатор = Версия.Идентификатор;
	КонецЕсли;

	Запись.ПакетИдентификатор = Версия.ПакетИдентификатор;
	Запись.Источник = НормализованныйИсточник(Источник);
	Запись.АпстримИдентификатор = ?(ЗначениеЗаполнено(АпстримИдентификатор), Цел(АпстримИдентификатор), 0);
	// признак переписывается на каждой фиксации: обычная перезапись версии снимает значок,
	// поставленный прошлой доверенной публикацией
	Запись.ДовереннаяПубликация = (ДовереннаяПубликация = Истина);
	Запись.Зафиксировано = ТекущаяУниверсальнаяДата();
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

// Возвращает источник версии. Версия без записи считается своей.
//
// Параметры:
//  Версия - ВерсияПакета, Неопределено - версия.
//
// Возвращаемое значение:
//  Строка - ИсточникСвой либо ИсточникАпстрим.
//
Функция ИсточникВерсии(Знач Версия) Экспорт

	Если Версия = Неопределено Тогда
		Возврат ИсточникСвой();
	КонецЕсли;

	Запись = ХранилищеПроисхождения.ПолучитьОдноПоВерсияИдентификаторРавно(Версия.Идентификатор);
	Если Запись = Неопределено Тогда
		Возврат ИсточникСвой();
	КонецЕсли;
	Возврат НормализованныйИсточник(Запись.Источник);

КонецФункции

// Проверяет, опубликована ли версия в этом хабе, а не получена с апстрима.
//
// Параметры:
//  Версия - ВерсияПакета, Неопределено - версия.
//
// Возвращаемое значение:
//  Булево - Истина, если версия своя.
//
Функция ЭтоСвоя(Знач Версия) Экспорт
	Возврат ИсточникВерсии(Версия) = ИсточникСвой();
КонецФункции

// Принята ли версия доверенной публикацией. Версия без записи провенанса доверенной
// не считается: признак ставится только приёмом, и «не знаю» здесь значит «нет».
//
// Параметры:
//  Версия - ВерсияПакета, Неопределено - версия.
//
// Возвращаемое значение:
//  Булево - Истина, если версию опубликовал доверенный конвейер.
//
Функция ЭтоДоверенныйКонвейер(Знач Версия) Экспорт

	Если Версия = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Запись = ХранилищеПроисхождения.ПолучитьОдноПоВерсияИдентификаторРавно(Версия.Идентификатор);
	Возврат Запись <> Неопределено И Запись.ДовереннаяПубликация = Истина;

КонецФункции

// Версии пакета, принятые доверенной публикацией, — одним запросом на список версий.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Соответствие - идентификатор версии -> Истина.
//
Функция ДоверенныеВерсииПакета(Знач ПакетИдентификатор) Экспорт

	Множество = Новый Соответствие();
	Для Каждого Запись Из ХранилищеПроисхождения.ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор) Цикл
		Если Запись.ДовереннаяПубликация = Истина Тогда
			Множество.Вставить(Запись.ВерсияИдентификатор, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Множество;

КонецФункции

// Проверяет, есть ли у пакета хоть одна собственная версия — то есть принадлежит ли имя
// пакета этому пулу. Один запрос на резолв.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Булево - Истина, если собственная версия есть.
//
Функция ЕстьСобственныеВерсии(Знач ПакетИдентификатор) Экспорт

	Для Каждого Запись Из ХранилищеПроисхождения.ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор) Цикл
		Если НормализованныйИсточник(Запись.Источник) = ИсточникСвой() Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Отбирает из набора версий только собственные: latest своего пакета не может указывать
// на версию с апстрима. Набор считается однородным по пакету, поэтому провенанс читается
// одним запросом; версии прочих пакетов, если попадут, фильтруются точечно.
//
// Параметры:
//  Версии - Массив из ВерсияПакета - версии одного пакета.
//
// Возвращаемое значение:
//  Массив из ВерсияПакета - собственные версии.
//
Функция ТолькоСобственные(Знач Версии) Экспорт

	Результат = Новый Массив();
	Если Версии.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ПакетИдентификатор = Версии[0].ПакетИдентификатор;
	Апстримные = АпстримныеВерсииПакета(ПакетИдентификатор);

	Для Каждого Версия Из Версии Цикл
		Если Версия.ПакетИдентификатор <> ПакетИдентификатор Тогда
			// набор неоднородный — для чужой версии спрашиваем точечно
			Если ЭтоСвоя(Версия) Тогда
				Результат.Добавить(Версия);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Апстримные.Получить(Версия.Идентификатор) <> Истина Тогда
			Результат.Добавить(Версия); // нет отметки «апстрим» ⇒ своя
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АпстримныеВерсииПакета(Знач ПакетИдентификатор)

	Множество = Новый Соответствие();
	Для Каждого Запись Из ХранилищеПроисхождения.ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор) Цикл
		Если НормализованныйИсточник(Запись.Источник) = ИсточникАпстрим() Тогда
			Множество.Вставить(Запись.ВерсияИдентификатор, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Множество;

КонецФункции

// Любое значение, кроме явного «апстрим», трактуется как «свой» (fail-closed).
Функция НормализованныйИсточник(Знач Значение)
	Возврат ?(НРег(СокрЛП(Строка(Значение))) = ИсточникАпстрим(), ИсточникАпстрим(), ИсточникСвой());
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПроисхожденияВерсий") _ХранилищеПроисхождения)

	ХранилищеПроисхождения = _ХранилищеПроисхождения;

КонецПроцедуры
