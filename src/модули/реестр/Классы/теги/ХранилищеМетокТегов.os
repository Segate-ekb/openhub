// Хранилище меток тегов — репозиторий сущности «МеткаТега»: какие версии помечены
// вручную. Теги-правила сюда не ходят — их состав считается правилом.

// BSLLS:UnusedParameters-off

Перем Сам;  // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё

// Весь состав одного ручного тега одним запросом.
//
// Параметры:
//  ТегИдентификатор - Число - идентификатор тега.
//
// Возвращаемое значение:
//  Массив из МеткаТега - состав канала.
//
&МетодЗапроса
Функция ПолучитьПоТегИдентификаторРавно(ТегИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Состав сразу нескольких ручных тегов.
//
// Параметры:
//  ТегИдентификаторы - Массив из Число - идентификаторы тегов.
//
// Возвращаемое значение:
//  Массив из МеткаТега - метки всех перечисленных тегов.
//
&МетодЗапроса
Функция ПолучитьПоТегИдентификаторВ(ТегИдентификаторы) Экспорт
	Возврат Неопределено;
КонецФункции

// Состав всех ручных тегов пакета одним запросом: у пакета их несколько, и вопрос
// на каждый превращал бы вкладку версий в «2 + число тегов».
//
// Параметры:
//  ТегИдентификаторы - Массив из Число - идентификаторы тегов.
//
// Возвращаемое значение:
//  Массив из МеткаТега - метки всех перечисленных тегов.
//
Функция СоставТегов(Знач ТегИдентификаторы) Экспорт

	Если ТегИдентификаторы.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат Сам.Достать().ПолучитьПоТегИдентификаторВ(ТегИдентификаторы);

КонецФункции

// Помеченные версии нескольких тегов одним запросом, разложенные по тегам.
//
// Параметры:
//  ТегИдентификаторы - Массив из Число - идентификаторы тегов.
//
// Возвращаемое значение:
//  Соответствие - идентификатор тега (Число) → Соответствие: идентификатор помеченной
//                 версии (Число) → Истина; у тега без меток ключа нет.
//
Функция ПомеченныеПоТегам(Знач ТегИдентификаторы) Экспорт

	ПоТегам = Новый Соответствие();
	Для Каждого Метка Из СоставТегов(ТегИдентификаторы) Цикл
		Ключ = Цел(Метка.ТегИдентификатор);
		Помеченные = ПоТегам.Получить(Ключ);
		Если Помеченные = Неопределено Тогда
			Помеченные = Новый Соответствие();
			ПоТегам.Вставить(Ключ, Помеченные);
		КонецЕсли;
		Помеченные.Вставить(Цел(Метка.ВерсияИдентификатор), Истина);
	КонецЦикла;

	Возврат ПоТегам;

КонецФункции

&ХранилищеСущностей("МеткаТега")
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин(Значение = "ХранилищеМетокТегов") _Сам)
	Сам = _Сам;
КонецПроцедуры
