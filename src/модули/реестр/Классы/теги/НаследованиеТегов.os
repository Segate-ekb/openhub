// Теги пакета вместе с унаследованными от пула: свои теги пакета плюс теги пула, если у пула
// включена галка; своя копия с тем же именем заменяет тег пула, выключенный тег пула у пакета
// пропадает. Читает снимками для показа и резолва либо базой для решений пишущего пути.

Перем СнимкиКаналов;        // СнимкиКаналов — свои каналы пакета и теги пула в кэше
Перем ХранилищеТегов;       // ХранилищеТегов
Перем ХранилищеТеговПулов;  // ХранилищеТеговПулов
Перем ХранилищеВыключенных; // ХранилищеВыключенныхТеговПулов
Перем ХранилищеПакетов;     // ХранилищеПакетов — пул пакета
Перем ХранилищеПулов;       // ХранилищеПулов — галка пула
Перем Настройка;            // НастройкаТеговПула — галка «теги пула для пакетов»
Перем Режимы;               // РежимТега
Перем Происхождения;        // ПроисхождениеТега

#Область ПубличныйИнтерфейс

// Теги пакета для чтения — из снимков кэша. Объекты собраны из снимков: сохранить их нельзя.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Структура - Теги (Массив из Тег — теги пакета с унаследованными), Метки
//              (ФиксированноеСоответствие — помеченные версии своих ручных тегов, как
//              в СнимкиКаналов), Происхождение (Соответствие: имя тега → ключ ПроисхождениеТега),
//              Выключенные (Массив из Тег — теги пула, выключенные у пакета), Запросов (Число —
//              стоимость ХОЛОДНОГО чтения: свои теги, их метки, если теги есть, выключенные,
//              пакет, пул и теги пула, если галка включена).
//
Функция ДляЧтения(Знач ПакетИдентификатор) Экспорт

	Снимок = СнимкиКаналов.СнимокПакета(Цел(ПакетИдентификатор));
	СнимокПула = ?(Снимок.ПулИдентификатор = 0, Неопределено, СнимкиКаналов.СнимокПула(Снимок.ПулИдентификатор));

	Свои = Новый Массив();
	Для Каждого СтрокаТега Из Снимок.Теги Цикл
		Тег = Новый Тег();
		ЗаполнитьЗначенияСвойств(Тег, СтрокаТега);
		Свои.Добавить(Тег);
	КонецЦикла;

	Включено = СнимокПула <> Неопределено И СнимокПула.Включено;
	Результат = Слить(ПакетИдентификатор, Свои, ?(Включено, СнимокПула.Теги, Новый Массив()),
		Снимок.Выключенные);
	Результат.Вставить("Метки", Снимок.Метки);
	Результат.Вставить("Запросов", ?(Свои.Количество() = 0, 1, 2) + ?(Включено, 4, 3));
	Возврат Результат;

КонецФункции

// Теги, которые наследует имя, которого в реестре пула ещё нет: теги пула при включённой галке,
// из снимка. Объекты собраны из снимков: сохранить их нельзя.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из Тег - теги пула с пометкой основного; у пула без галки пуст.
//
Функция ДляНовогоИмени(Знач ПулИдентификатор) Экспорт

	СнимокПула = СнимкиКаналов.СнимокПула(Цел(ПулИдентификатор));
	Возврат Слить(0, Новый Массив(), ?(СнимокПула.Включено, СнимокПула.Теги, Новый Массив()),
		Новый Массив()).Теги;

КонецФункции

// Теги пакета для решений пишущего пути — из базы, мимо кэша.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Структура - Теги, Происхождение, Выключенные — как у ДляЧтения; свои теги — строки базы.
//
Функция ИзБазы(Знач ПакетИдентификатор) Экспорт

	Свои = ХранилищеТегов.ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор);
	Возврат Слить(ПакетИдентификатор, ?(Свои = Неопределено, Новый Массив(), Свои),
		ТегиПулаПакета(ПакетИдентификатор), ХранилищеВыключенных.ИменаПакета(ПакетИдентификатор));

КонецФункции

// Тег пула, который наследует пакет, — из базы; выключенный у пакета тоже находится.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  ИмяНорм - Строка - имя тега в нижнем регистре.
//
// Возвращаемое значение:
//  ТегПула, Неопределено - Неопределено, если у пула галка выключена либо тега с таким
//                          именем нет.
//
Функция ТегПулаПакета(Знач ПакетИдентификатор, Знач ИмяНорм) Экспорт

	Для Каждого ТегПула Из ТегиПулаПакета(ПакетИдентификатор) Цикл
		Если Строка(ТегПула.Имя) = ИмяНорм Тогда
			Возврат ТегПула;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Заведён ли в пуле тег с таким именем — при любой галке.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  ИмяНорм - Строка - имя тега в нижнем регистре.
//
// Возвращаемое значение:
//  Булево - Истина, если тег пула с таким именем есть.
//
Функция ЕстьТегПула(Знач ПулИдентификатор, Знач ИмяНорм) Экспорт
	Возврат ХранилищеТеговПулов.ПолучитьОдноПоПулИдентификаторРавноИИмяРавно(ПулИдентификатор, ИмяНорм)
		<> Неопределено;
КонецФункции

// Тег пакета, каким его видит пакет, из строки тега пула: правило, оформление и запрет
// перезаписи — пула, принадлежность — пакета. Сохранить его нельзя: копия у пакета
// заводится службой тегов.
//
// Параметры:
//  ТегПула - ТегПула, ФиксированнаяСтруктура - строка или снимок тега пула.
//  ПакетИдентификатор - Число - пакет, который наследует тег.
//
// Возвращаемое значение:
//  Тег - унаследованный тег; Идентификатор пуст.
//
Функция УнаследованныйТег(Знач ТегПула, Знач ПакетИдентификатор) Экспорт

	Тег = Новый Тег();
	Тег.Идентификатор = 0;
	Тег.ПакетИдентификатор = ПакетИдентификатор;
	Тег.Имя = Строка(ТегПула.Имя);
	Тег.Режим = Режимы.Правило();
	Тег.ТипПравила = ТегПула.ТипПравила;
	Тег.Правило = ТегПула.Правило;
	Тег.ПоУмолчанию = (ТегПула.ПоУмолчанию = Истина);
	Тег.ПерезаписьРазрешена = (ТегПула.ПерезаписьРазрешена = Истина);
	Тег.Стиль = ТегПула.Стиль;
	Тег.Значок = ТегПула.Значок;
	Тег.Обновлён = ТегПула.Обновлён;
	Тег.КемИдентификатор = 0;
	Возврат Тег;

КонецФункции

#КонецОбласти

#Область Слияние

// Свои теги идут первыми в своём порядке, унаследованные — за ними в порядке пула. Основной
// тег пула основной у пакета, пока у пакета нет своего основного, — по имени: своя копия
// основного тега пула тоже основная.
Функция Слить(Знач ПакетИдентификатор, Знач Свои, Знач ТегиПула, Знач Выключенные)

	ИменаПула = Новый Соответствие();
	ОсновнойПула = "";
	Для Каждого ТегПула Из ТегиПула Цикл
		ИменаПула.Вставить(Строка(ТегПула.Имя), ТегПула);
		Если ТегПула.ПоУмолчанию = Истина Тогда
			ОсновнойПула = Строка(ТегПула.Имя);
		КонецЕсли;
	КонецЦикла;

	МножествоВыключенных = Новый Соответствие();
	Для Каждого Имя Из Выключенные Цикл
		МножествоВыключенных.Вставить(Строка(Имя), Истина);
	КонецЦикла;

	Теги = Новый Массив();
	Происхождение = Новый Соответствие();
	ИменаСвоих = Новый Соответствие();
	ЕстьСвойОсновной = Ложь;

	Для Каждого Тег Из Свои Цикл
		Имя = Строка(Тег.Имя);
		ИменаСвоих.Вставить(Имя, Истина);
		Теги.Добавить(Тег);
		Происхождение.Вставить(Имя, ?(ИменаПула.Получить(Имя) = Неопределено,
			Происхождения.Свой(), Происхождения.Перекрывает()));
		ЕстьСвойОсновной = ЕстьСвойОсновной ИЛИ Тег.ПоУмолчанию = Истина;
	КонецЦикла;

	ВыключенныеТеги = Новый Массив();
	Для Каждого ТегПула Из ТегиПула Цикл

		Имя = Строка(ТегПула.Имя);
		Если ИменаСвоих.Получить(Имя) = Истина Тогда
			Продолжить;
		КонецЕсли;

		Унаследованный = УнаследованныйТег(ТегПула, ПакетИдентификатор);
		Унаследованный.ПоУмолчанию = Ложь;
		Если МножествоВыключенных.Получить(Имя) = Истина Тогда
			ВыключенныеТеги.Добавить(Унаследованный);
			Продолжить;
		КонецЕсли;

		Теги.Добавить(Унаследованный);
		Происхождение.Вставить(Имя, Происхождения.ОтПула());

	КонецЦикла;

	Если НЕ ЕстьСвойОсновной И ЗначениеЗаполнено(ОсновнойПула) Тогда
		ОтметитьОсновной(Теги, ОсновнойПула);
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("Теги", Теги);
	Результат.Вставить("Происхождение", Происхождение);
	Результат.Вставить("Выключенные", ВыключенныеТеги);
	Возврат Результат;

КонецФункции

// Отметка ложится на копию объекта: строку базы, которую потом сохранят, она не трогает.
Процедура ОтметитьОсновной(Теги, Знач Имя)

	Для Индекс = 0 По Теги.ВГраница() Цикл
		Если Строка(Теги[Индекс].Имя) <> Имя Тогда
			Продолжить;
		КонецЕсли;
		Копия = Новый Тег();
		ЗаполнитьЗначенияСвойств(Копия, Теги[Индекс]);
		Копия.ПоУмолчанию = Истина;
		Теги[Индекс] = Копия;
		Возврат;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Галка выключена — пакет теги пула не наследует, хотя набор пула хранится.
Функция ТегиПулаПакета(Знач ПакетИдентификатор)

	Пакет = ХранилищеПакетов.ПолучитьОдноПоИдентификаторРавно(ПакетИдентификатор);
	Если Пакет = Неопределено
		ИЛИ НЕ Настройка.Включена(ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(Пакет.ПулИдентификатор)) Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Теги = ХранилищеТеговПулов.ПолучитьПоПулИдентификаторРавно(Пакет.ПулИдентификатор);
	Возврат ?(Теги = Неопределено, Новый Массив(), Теги);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СнимкиКаналов") _СнимкиКаналов,
	&Пластилин(Значение = "ХранилищеТегов") _ХранилищеТегов,
	&Пластилин(Значение = "ХранилищеТеговПулов") _ХранилищеТеговПулов,
	&Пластилин(Значение = "ХранилищеВыключенныхТеговПулов") _ХранилищеВыключенных,
	&Пластилин(Значение = "ХранилищеПакетов") _ХранилищеПакетов,
	&Пластилин(Значение = "ХранилищеПулов") _ХранилищеПулов,
	&Пластилин(Значение = "НастройкаТеговПула") _Настройка,
	&Пластилин(Значение = "РежимТега") _Режимы,
	&Пластилин(Значение = "ПроисхождениеТега") _Происхождения)

	СнимкиКаналов = _СнимкиКаналов;
	ХранилищеТегов = _ХранилищеТегов;
	ХранилищеТеговПулов = _ХранилищеТеговПулов;
	ХранилищеВыключенных = _ХранилищеВыключенных;
	ХранилищеПакетов = _ХранилищеПакетов;
	ХранилищеПулов = _ХранилищеПулов;
	Настройка = _Настройка;
	Режимы = _Режимы;
	Происхождения = _Происхождения;

КонецПроцедуры
