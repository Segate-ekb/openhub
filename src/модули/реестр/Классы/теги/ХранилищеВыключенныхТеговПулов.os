// Хранилище выключенных у пакетов тегов пулов — репозиторий сущности «ВыключенныйТегПула».
// Тела методов запроса строит autumn-data по их именам.

// BSLLS:UnusedParameters-off

Перем Сам;  // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё

// Имена тегов пула, выключенных у пакета.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив из Строка - имена в нижнем регистре.
//
Функция ИменаПакета(Знач ПакетИдентификатор) Экспорт

	Результат = Новый Массив();
	Выключенные = Сам.Достать().ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор);
	Для Каждого Выключение Из ?(Выключенные = Неопределено, Новый Массив(), Выключенные) Цикл
		Результат.Добавить(Строка(Выключение.Имя));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Теги пула, выключенные у пакета.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив из ВыключенныйТегПула - строки выключения.
//
&МетодЗапроса
Функция ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Выключение тега пула у пакета по имени.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега в нижнем регистре.
//
// Возвращаемое значение:
//  ВыключенныйТегПула, Неопределено - строка выключения.
//
&МетодЗапроса
Функция ПолучитьОдноПоПакетИдентификаторРавноИИмяРавно(ПакетИдентификатор, Имя) Экспорт
	Возврат Неопределено;
КонецФункции

// Выключения тега с этим именем у всех пакетов хаба: удалённый тег пула уносит выключения
// у пакетов своего пула, остальные отбирает вызывающий.
//
// Параметры:
//  Имя - Строка - имя тега в нижнем регистре.
//
// Возвращаемое значение:
//  Массив из ВыключенныйТегПула - строки выключения.
//
&МетодЗапроса
Функция ПолучитьПоИмяРавно(Имя) Экспорт
	Возврат Неопределено;
КонецФункции

&ХранилищеСущностей("ВыключенныйТегПула")
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин(Значение = "ХранилищеВыключенныхТеговПулов") _Сам)
	Сам = _Сам;
КонецПроцедуры
