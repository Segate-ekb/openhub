// Летопись тегов: изменения канала — состав, режим, запрет перезаписи, удаление — у тегов
// пакета и пула, выключение тега пула у пакета — доменными событиями для журнала аудита.

Перем ИменаЖурнала;   // ИмяОбъектаАудита (аудит) — вид объекта в журнале
Перем СобытиеЖурнала; // СобытиеАудита (аудит) — форма нагрузки записи
Перем Координаты;     // КоординатыПакета — адрес пакета по идентификатору
Перем Издатель;       // ИздательСобытий (события), необязателен
Перем Обрезание;      // ОбрезаниеТекста (основа) — длинный список версий сворачивается
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Записывает изменение состава канала в аудит через доменное событие «тег.перемещён».
// Сбой публикации гасится: аудит не ломает состоявшееся изменение.
//
// Параметры:
//  Тег - Тег - тег после изменения состава.
//  ВерсияДо - Строка - какую версию тег отдавал до ("" — никакую).
//  ВерсияПосле - Строка - какую отдаёт после ("" — никакую).
//  Добавлено - Массив из Строка - версии, попавшие в канал.
//  Снято - Массив из Строка - версии, покинувшие канал.
//  Причина - Строка - что вызвало изменение: правило, публикация, вручную, метка, снятие метки.
//  Кем - Строка - логин принципала (необязательный, по умолчанию "" — система).
//
Процедура ЗаписатьИзменениеСостава(Знач Тег, Знач ВерсияДо, Знач ВерсияПосле,
	Знач Добавлено, Знач Снято, Знач Причина, Знач Кем = "") Экспорт

	// состав, перестроенный публикацией, — её следствие: веху называет сама публикация
	Если Причина <> "публикация" И ЗначениеЗаполнено(Кем) Тогда
		НазватьПравку(Тег.ПакетИдентификатор, Тег.Имя, "переставлен", Кем);
	КонецЕсли;
	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Опубликовать(Тег, ВерсияДо, ВерсияПосле, Добавлено, Снято, Причина, Кем);
	Исключение
		// аудит не имеет права ломать состоявшееся изменение состава канала
	КонецПопытки;

КонецПроцедуры

// Записывает смену режима тега в аудит отдельным действием: меняется не версия,
// а то, кто вправе двигать тег. Сбой публикации гасится.
//
// Параметры:
//  Тег - Тег - тег после смены режима.
//  РежимДо - Строка - прежний режим ("" — тег только что создан).
//  Кем - Строка - логин принципала (необязательный, по умолчанию "" — система).
//
Процедура ЗаписатьСменуРежима(Знач Тег, Знач РежимДо, Знач Кем = "") Экспорт

	НазватьПравку(Тег.ПакетИдентификатор, Тег.Имя, "сменил режим", Кем);
	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Издатель.Опубликовать(Издатель.ТипРежимТегаИзменён(), СобытиеЖурнала.Собрать(
			Кем, "тег.режим.изменён", АдресТега(Тег), "", ДеталиРежима(Тег, РежимДо)));
	Исключение
		// аудит не имеет права ломать состоявшуюся смену режима
	КонецПопытки;

КонецПроцедуры

// Записывает смену запрета повторной публикации в аудит отдельным действием: снятый
// запрет открывает переиздание номера всем, кто вправе публиковать. Сбой публикации гасится.
//
// Параметры:
//  Тег - Тег - тег после смены запрета.
//  БылоРазрешено - Булево - разрешала ли перезапись прежняя настройка.
//  Кем - Строка - логин принципала (необязательный, по умолчанию "" — система).
//
Процедура ЗаписатьСменуЗапретаПерезаписи(Знач Тег, Знач БылоРазрешено, Знач Кем = "") Экспорт

	НазватьПравку(Тег.ПакетИдентификатор, Тег.Имя, "сменил запрет перезаписи", Кем);
	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Издатель.Опубликовать(Издатель.ТипЗапретПерезаписиИзменён(), СобытиеЖурнала.Собрать(
			Кем, "тег.запрет.перезаписи.изменён", АдресТега(Тег), "",
			ДеталиЗапрета(Тег, БылоРазрешено)));
	Исключение
		// аудит не имеет права ломать состоявшуюся смену запрета
	КонецПопытки;

КонецПроцедуры

// Записывает удаление тега в аудит. Сбой публикации гасится.
//
// Параметры:
//  ПакетИдентификатор - Число - пакет удалённого тега.
//  Имя - Строка - имя удалённого тега.
//  СтрокаВерсии - Строка - версия, которую канал отдавал на момент удаления ("" — никакую).
//  Кем - Строка - логин принципала (необязательный, по умолчанию "" — система).
//
Процедура ЗаписатьУдаление(Знач ПакетИдентификатор, Знач Имя, Знач СтрокаВерсии, Знач Кем = "") Экспорт

	НазватьПравку(ПакетИдентификатор, Имя, "удалён", Кем);
	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Детали = Новый Структура();
		Детали.Вставить("тег", Строка(Имя));
		Детали.Вставить("отдавал", Строка(СтрокаВерсии));

		Адрес = ИменаЖурнала.Тег(Координаты.АдресПакета(ПакетИдентификатор), Имя);

		Издатель.Опубликовать(Издатель.ТипТегУдалён(),
			СобытиеЖурнала.Собрать(Кем, "тег.удалён", Адрес, "", Детали));
	Исключение
		// аудит не имеет права ломать состоявшееся удаление
	КонецПопытки;

КонецПроцедуры

// Записывает в аудит выключение у пакета тега пула либо его возвращение: координата
// «пакет@тег» пропадает или появляется снова. Сбой публикации гасится.
//
// Параметры:
//  ПакетИдентификатор - Число - пакет.
//  Имя - Строка - имя тега пула.
//  Выключен - Булево - Истина: тег выключен; Ложь: возвращён.
//  Кем - Строка - логин принципала (необязательный, по умолчанию "" — система).
//
Процедура ЗаписатьВыключениеТегаПула(Знач ПакетИдентификатор, Знач Имя, Знач Выключен,
	Знач Кем = "") Экспорт

	НазватьПравку(ПакетИдентификатор, Имя, ?(Выключен, "выключен у пакета", "возвращён пакету"), Кем);
	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Адрес = ИменаЖурнала.Тег(Координаты.АдресПакета(ПакетИдентификатор), Имя);
		Детали = Новый Структура("тег", Строка(Имя));
		Если Выключен Тогда
			Издатель.Опубликовать(Издатель.ТипТегУдалён(),
				СобытиеЖурнала.Собрать(Кем, "тег.пула.выключен", Адрес, "", Детали));
		Иначе
			Издатель.Опубликовать(Издатель.ТипТегПеремещён(),
				СобытиеЖурнала.Собрать(Кем, "тег.пула.включён", Адрес, "", Детали));
		КонецЕсли;
	Исключение
		// аудит не имеет права ломать состоявшееся выключение
	КонецПопытки;

КонецПроцедуры

// Записывает в аудит заведение или правку тега пула: состав меняется у всех пакетов пула,
// у которых нет своей копии. Сбой публикации гасится.
//
// Параметры:
//  ТегПула - ТегПула - тег пула после правки.
//  Кем - Строка - логин принципала (необязательный, по умолчанию "" — система).
//
Процедура ЗаписатьПравкуТегаПула(Знач ТегПула, Знач Кем = "") Экспорт

	НазватьПравкуПула(ТегПула.ПулИдентификатор, ТегПула.Имя, "определён", Кем);
	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Детали = Новый Структура();
		Детали.Вставить("тег", Строка(ТегПула.Имя));
		Детали.Вставить("правило", Строка(ТегПула.Правило));
		Детали.Вставить("тип_правила", Строка(ТегПула.ТипПравила));
		Издатель.Опубликовать(Издатель.ТипТегПеремещён(), СобытиеЖурнала.Собрать(
			Кем, "тег.пула.изменён", АдресТегаПула(ТегПула.ПулИдентификатор, ТегПула.Имя), "", Детали));
	Исключение
		// аудит не имеет права ломать состоявшуюся правку
	КонецПопытки;

КонецПроцедуры

// Записывает в аудит смену запрета повторной публикации у тега пула. Сбой публикации гасится.
//
// Параметры:
//  ТегПула - ТегПула - тег пула после смены запрета.
//  БылоРазрешено - Булево - разрешала ли перезапись прежняя настройка.
//  Кем - Строка - логин принципала (необязательный, по умолчанию "" — система).
//
Процедура ЗаписатьСменуЗапретаТегаПула(Знач ТегПула, Знач БылоРазрешено, Знач Кем = "") Экспорт

	НазватьПравкуПула(ТегПула.ПулИдентификатор, ТегПула.Имя, "сменил запрет перезаписи", Кем);
	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Издатель.Опубликовать(Издатель.ТипЗапретПерезаписиИзменён(), СобытиеЖурнала.Собрать(
			Кем, "тег.пула.запрет.перезаписи.изменён",
			АдресТегаПула(ТегПула.ПулИдентификатор, ТегПула.Имя), "", ДеталиЗапрета(ТегПула, БылоРазрешено)));
	Исключение
		// аудит не имеет права ломать состоявшуюся смену запрета
	КонецПопытки;

КонецПроцедуры

// Записывает в аудит удаление тега пула. Сбой публикации гасится.
//
// Параметры:
//  ПулИдентификатор - Число - пул удалённого тега.
//  Имя - Строка - имя удалённого тега.
//  Кем - Строка - логин принципала (необязательный, по умолчанию "" — система).
//
Процедура ЗаписатьУдалениеТегаПула(Знач ПулИдентификатор, Знач Имя, Знач Кем = "") Экспорт

	НазватьПравкуПула(ПулИдентификатор, Имя, "удалён", Кем);
	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Издатель.Опубликовать(Издатель.ТипТегУдалён(), СобытиеЖурнала.Собрать(
			Кем, "тег.пула.удалён", АдресТегаПула(ПулИдентификатор, Имя), "",
			Новый Структура("тег", Строка(Имя))));
	Исключение
		// аудит не имеет права ломать состоявшееся удаление
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строка уровня хаба о правке тега пула; её сбой правку не отменяет.
Процедура НазватьПравкуПула(Знач ПулИдентификатор, Знач ИмяТега, Знач Исход, Знач Кем)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Лог.Информация("Тег ""%1"" пула ""%2"" %3, кто ""%4""",
			ИмяТега, ИменаЖурнала.Пул(ПулИдентификатор), Исход,
			?(ЗначениеЗаполнено(Кем), Кем, ИменаЖурнала.Система()));
	Исключение
		// строка журнала вторична: правка уже состоялась
	КонецПопытки;

КонецПроцедуры

Функция АдресТегаПула(Знач ПулИдентификатор, Знач Имя)
	Возврат ИменаЖурнала.Тег(ИменаЖурнала.Пул(ПулИдентификатор), Имя);
КонецФункции

// Строка уровня хаба о правке тега, исход — словами; её сбой правку не отменяет.
Процедура НазватьПравку(Знач ПакетИдентификатор, Знач ИмяТега, Знач Исход, Знач Кем)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Адрес = Координаты.Пакета(ПакетИдентификатор);
		Лог.Информация("Тег ""%1"" пакета ""%2"" пула ""%3"" %4, кто ""%5""",
			ИмяТега, Адрес.ИмяПакета, Адрес.ИмяПула, Исход, ?(ЗначениеЗаполнено(Кем), Кем, ИменаЖурнала.Система()));
	Исключение
		// строка журнала вторична: правка уже состоялась
	КонецПопытки;

КонецПроцедуры

Функция АдресТега(Знач Тег)
	Возврат ИменаЖурнала.Тег(Координаты.АдресПакета(Тег.ПакетИдентификатор), Тег.Имя);
КонецФункции

Функция ДеталиРежима(Знач Тег, Знач РежимДо)

	Детали = Новый Структура();
	Детали.Вставить("тег", Строка(Тег.Имя));
	Детали.Вставить("режим_было", Строка(РежимДо));
	Детали.Вставить("режим_стало", Строка(Тег.Режим));
	Возврат Детали;

КонецФункции

// Запрет называется положительно и отрицательно сразу: журнал читают глазами.
Функция ДеталиЗапрета(Знач Тег, Знач БылоРазрешено)

	Детали = Новый Структура();
	Детали.Вставить("тег", Строка(Тег.Имя));
	Детали.Вставить("запрет_было", НЕ (БылоРазрешено = Истина));
	Детали.Вставить("запрет_стало", НЕ (Тег.ПерезаписьРазрешена = Истина));
	Возврат Детали;

КонецФункции

Процедура Опубликовать(Знач Тег, Знач ВерсияДо, Знач ВерсияПосле,
	Знач Добавлено, Знач Снято, Знач Причина, Знач Кем)

	Детали = ДеталиПереезда(Тег, ВерсияДо, ВерсияПосле, Добавлено, Снято, Причина);

	Издатель.Опубликовать(Издатель.ТипТегПеремещён(),
		СобытиеЖурнала.Собрать(Кем, "тег.перемещён", АдресТега(Тег), "", Детали));

КонецПроцедуры

Функция ДеталиПереезда(Знач Тег, Знач ВерсияДо, Знач ВерсияПосле, Знач Добавлено, Знач Снято, Знач Причина)

	Детали = Новый Структура();
	Детали.Вставить("тег", Строка(Тег.Имя));
	Детали.Вставить("режим", Строка(Тег.Режим));
	Детали.Вставить("правило", ?(ЗначениеЗаполнено(Тег.Правило), Строка(Тег.Правило), ""));
	Детали.Вставить("было", Строка(ВерсияДо));
	Детали.Вставить("стало", Строка(ВерсияПосле));
	Детали.Вставить("добавлено", КраткийСписок(Добавлено));
	Детали.Вставить("снято", КраткийСписок(Снято));
	Детали.Вставить("причина", Строка(Причина));
	Возврат Детали;

КонецФункции

// Строка вида «1.0.0, 1.1.0 и ещё 98».
Функция КраткийСписок(Знач Версии)
	Возврат ?(Версии = Неопределено, "", Обрезание.ПереченьСОстатком(Версии, ПределСписка()));
КонецФункции

Функция ПределСписка()
	Возврат 10;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ИмяОбъектаАудита") _Имена,
	&Пластилин(Значение = "СобытиеАудита") _Событие,
	&Пластилин(Значение = "КоординатыПакета") _Координаты,
	&Пластилин(Значение = "ИздательСобытий") _Издатель = Неопределено,
	&Пластилин(Значение = "ОбрезаниеТекста") _Обрезание = Неопределено,
	&Лог _Лог = Неопределено)

	Обрезание = ?(_Обрезание = Неопределено, Новый ОбрезаниеТекста(), _Обрезание);
	ИменаЖурнала = _Имена;
	СобытиеЖурнала = _Событие;
	Координаты = _Координаты;
	Издатель = _Издатель;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
