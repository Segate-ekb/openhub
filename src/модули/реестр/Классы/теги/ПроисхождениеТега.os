// Словарь — откуда у пакета тег: свой, унаследован от пула, своя копия перекрывает тег пула
// или тег пула у пакета выключен. Без состояния.

#Область ПубличныйИнтерфейс

// Тег заведён у пакета, у пула такого нет.
//
// Возвращаемое значение:
//  Строка - ключ происхождения.
//
Функция Свой() Экспорт
	Возврат "свой";
КонецФункции

// Тег унаследован от пула, своей копии у пакета нет.
//
// Возвращаемое значение:
//  Строка - ключ происхождения.
//
Функция ОтПула() Экспорт
	Возврат "пул";
КонецФункции

// У пакета своя копия тега пула с тем же именем — она заменяет тег пула целиком.
//
// Возвращаемое значение:
//  Строка - ключ происхождения.
//
Функция Перекрывает() Экспорт
	Возврат "перекрывает";
КонецФункции

// Тег пула у пакета выключен — такого тега у пакета нет.
//
// Возвращаемое значение:
//  Строка - ключ происхождения.
//
Функция Выключен() Экспорт
	Возврат "выключен";
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
