// Словарь значка тега — единственный владелец значений колонки Тег.Значок: имя значка кита
// (глиф набора или «бренд:<ключ>») либо прежний ключ тега. Пустое — плашка без значка,
// это значение по умолчанию.

#Область ПубличныйИнтерфейс

// Возвращает имя «без значка».
//
// Возвращаемое значение:
//  Строка - пустая строка.
//
Функция Нет() Экспорт
	Возврат "";
КонецФункции

// Возвращает имена значков на выбор, кроме пустого: глифы и бренды набора кита — те же,
// что предлагает выбор значка кита. Прежние ключи тега допустимы, но на выбор не предлагаются.
//
// Возвращаемое значение:
//  Массив из Строка - имена значков.
//
Функция Все() Экспорт

	Результат = СтрРазделить(Глифы(), ",");
	Для Каждого Ключ Из СтрРазделить(Бренды(), ",") Цикл
		Результат.Добавить(ПриставкаБренда() + Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Нормализует значок к хранимому виду: имя значка кита либо прежний ключ тега — оба читаются;
// незнакомое значение сводится к «без значка»: значок — оформление, и старая строка БД
// не должна ронять показ.
//
// Параметры:
//  Значение - Произвольный - сырое значение из формы, тела запроса или строки БД.
//
// Возвращаемое значение:
//  Строка - имя значка кита, прежний ключ либо "".
//
Функция Нормализовать(Знач Значение) Экспорт

	Норм = Приведённое(Значение);
	Знаком = ПрежниеКлючи().Получить(Норм) <> Неопределено ИЛИ Все().Найти(Норм) <> Неопределено;
	Возврат ?(Знаком, Норм, Нет());

КонецФункции

// Имя значка кита для показа: прежний ключ тега — по таблице соответствия.
//
// Параметры:
//  Значение - Произвольный - значок из строки БД, формы или тела запроса.
//
// Возвращаемое значение:
//  Строка - имя значка кита либо "" — значка нет или он незнаком.
//
Функция ИмяКита(Знач Значение) Экспорт

	Норм = Нормализовать(Значение);
	Прежнее = ПрежниеКлючи().Получить(Норм);
	Возврат ?(Прежнее = Неопределено, Норм, Прежнее);

КонецФункции

// Проверяет, знаком ли значок.
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина для пустого значения, имени значка кита и прежнего ключа тега.
//
Функция Допустим(Знач Значение) Экспорт
	Возврат ПустаяСтрока(Приведённое(Значение)) ИЛИ ЗначениеЗаполнено(Нормализовать(Значение));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Приведённое(Знач Значение)
	Возврат НРег(СокрЛП(?(Значение = Неопределено, "", Строка(Значение))));
КонецФункции

// Имена глифов набора кита. Домен кита не загружает, поэтому список — копия; сверку с набором
// кита держит набор интерфейса (ЭкранТегов_Тесты): глиф, добавленный китом, краснит её.
Функция Глифы()
	Возврат "аккаунт,вверх,вебхук,весы,влево,вниз,вправо,выход,галочка,группа,закладка,закрыть,замок,"
		+ "инфо,история,карандаш,ключ,конверт,копировать,корзина,куб,луна,меню,отправить,ошибка,пакет,"
		+ "палочка,плюс,подпись,поиск,предупреждение,скачать,солнце,сохранить,ссылка,стопка,стрелка,тег,"
		+ "успех,часы,шестерёнка";
КонецФункции

// Ключи брендов набора кита — та же копия под той же сверкой.
Функция Бренды()
	Возврат "authentik,discord,gitea,github,gitlab,google,key,keycloak,mattermost,okta,telegram";
КонецФункции

Функция ПриставкаБренда()
	Возврат "бренд:";
КонецФункции

// До выбора значка сеткой кита (2026-10-13) тег хранил один из восьми своих ключей: строки БД
// и клиенты API с ними по-прежнему принимаются, показ переводит их по этой таблице; экран
// пишет имя кита.
Функция ПрежниеКлючи()

	Таблица = Новый Соответствие();
	Таблица.Вставить("check", "галочка");
	Таблица.Вставить("verified", "успех");
	Таблица.Вставить("warning", "предупреждение");
	Таблица.Вставить("stop", "ошибка");
	Таблица.Вставить("lock", "замок");
	Таблица.Вставить("history", "история");
	Таблица.Вставить("cube", "куб");
	Таблица.Вставить("key", "ключ");
	Возврат Таблица;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
