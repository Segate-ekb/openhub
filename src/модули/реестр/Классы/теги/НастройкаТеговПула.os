// Галка пула «теги пула для пакетов» и отметка, что набор пула уже заполнялся каналами
// визарда: оба значения — флаги в Пул.НастройкиJSON. Без состояния.

#Область ПубличныйИнтерфейс

// Возвращает имя флага пула «теги пула для пакетов».
//
// Возвращаемое значение:
//  Строка - имя флага пула.
//
Функция Имя() Экспорт
	Возврат "auto_default_tags";
КонецФункции

// Включена ли у пула галка «теги пула для пакетов».
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Булево - Истина, только если галка включена явно.
//
Функция Включена(Знач Пул) Экспорт
	Возврат Флаг(Пул, Имя());
КонецФункции

// Заполнялся ли набор пула каналами визарда: заполняет его только первое включение галки.
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Булево - Истина, если набор уже заполнялся.
//
Функция Заполнялся(Знач Пул) Экспорт
	Возврат Флаг(Пул, ИмяОтметкиЗаполнения());
КонецФункции

// Возвращает имя флага пула «набор уже заполнялся каналами визарда».
//
// Возвращаемое значение:
//  Строка - имя флага пула.
//
Функция ИмяОтметкиЗаполнения() Экспорт
	Возврат "pool_tags_seeded";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Флаг(Знач Пул, Знач ИмяФлага)

	Если Пул = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Пул.Флаг(ИмяФлага, Ложь) = Истина;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
