// Владеет сущностью «ТегПула»: набор тегов-правил, который пакеты пула наследуют, пока у пула
// включена галка «теги пула для пакетов»; первое включение галки заполняет набор каналами
// визарда. Правка набора доезжает до пакетов следующим чтением — снимок пула забывается.

Перем ХранилищеТеговПулов;  // ХранилищеТеговПулов
Перем Выключения;           // ХранилищеВыключенныхТеговПулов — выключения тегов у пакетов
Перем СервисПулов;          // СервисПулов — флаги пула
Перем СервисПакетов;        // СервисПакетов — пакеты пула
Перем СервисВерсий;         // СервисВерсий — строка, занятая версией пакета пула
Перем СервисТегов;          // СервисТегов — алфавит имени тега
Перем Каналы;               // КаналыПоУмолчанию — три канала визарда
Перем Настройка;            // НастройкаТеговПула — галка и отметка заполнения
Перем СнимкиКаналов;        // СнимкиКаналов — снимок тегов пула в кэше
Перем Отбор;                // ОтборВерсийПоПравилу — исполнимость правила
Перем Летопись;             // ЛетописьТегов
Перем Стили;                // СтильТега
Перем Значки;               // ЗначокТега
Перем Строки;               // КанонСтроки (основа)

#Область Галка

// Включена ли у пула галка «теги пула для пакетов».
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Булево - Истина, только если галка включена явно.
//
Функция НаследованиеВключено(Знач Пул) Экспорт
	Возврат Настройка.Включена(Пул);
КонецФункции

// Включает или выключает галку «теги пула для пакетов». Первое включение заполняет набор
// пула тремя каналами визарда — имя, занятое версией пакета пула, пропускается; дальше набор
// правит владелец пула, и повторное включение его не трогает. Выключение набор хранит.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Включено - Булево - новое значение галки.
//  Кем - Строка - принципал для аудита (необязательный, по умолчанию "" — система).
//
// Возвращаемое значение:
//  Структура - Создано (Массив из Строка — заведённые первым включением каналы), Занято
//              (Массив из Строка — пропущенные: имя занято версией пакета пула).
//
&Наблюдаемый
Функция УстановитьНаследование(&АтрибутСпана("oshub.pool.id") Знач ПулИдентификатор,
	Знач Включено, Знач Кем = "") Экспорт

	Итог = Новый Структура("Создано, Занято", Новый Массив(), Новый Массив());
	Пул = СервисПулов.УстановитьФлаг(ПулИдентификатор, Настройка.Имя(), Включено = Истина);

	Если Включено = Истина И НЕ Настройка.Заполнялся(Пул) Тогда
		Заполнить(ПулИдентификатор, Итог, Кем);
		СервисПулов.УстановитьФлаг(ПулИдентификатор, Настройка.ИмяОтметкиЗаполнения(), Истина);
	КонецЕсли;

	СнимкиКаналов.ЗабытьСнимокПула(Цел(ПулИдентификатор));
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область ЧтениеНабора

// Возвращает теги пула — весь набор, при любой галке.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ТегПула - теги пула.
//
&Наблюдаемый
Функция ТегиПула(Знач ПулИдентификатор) Экспорт
	Результат = ХранилищеТеговПулов.ПолучитьПоПулИдентификаторРавно(ПулИдентификатор);
	Возврат ?(Результат = Неопределено, Новый Массив(), Результат);
КонецФункции

// Ищет тег пула по имени; имя нормализуется.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Имя - Строка - имя тега в любом регистре.
//
// Возвращаемое значение:
//  ТегПула, Неопределено - найденный тег.
//
&Наблюдаемый
Функция НайтиТегПула(Знач ПулИдентификатор, &АтрибутСпана("oshub.channel") Знач Имя) Экспорт
	Возврат ХранилищеТеговПулов.ПолучитьОдноПоПулИдентификаторРавноИИмяРавно(
		ПулИдентификатор, Строки.Канон(Имя));
КонецФункции

// Возвращает правило тега пула как значение-объект.
//
// Параметры:
//  ТегПула - ТегПула - тег пула.
//
// Возвращаемое значение:
//  ПравилоТега, Неопределено - Неопределено, если запись правила повреждена.
//
Функция ПравилоТегаПула(Знач ТегПула) Экспорт
	Попытка
		Возврат Новый ПравилоТега(ТегПула.ТипПравила, ТегПула.Правило);
	Исключение
		Возврат Неопределено; // повреждённая запись не роняет показ раздела
	КонецПопытки;
КонецФункции

// Снят ли с тега пула запрет повторной публикации номеров.
//
// Параметры:
//  ТегПула - ТегПула, Неопределено - тег пула.
//
// Возвращаемое значение:
//  Булево - Истина, если переиздание номеров под этим тегом разрешено.
//
Функция ЗапретСнят(Знач ТегПула) Экспорт
	Возврат ТегПула <> Неопределено И ТегПула.ПерезаписьРазрешена = Истина;
КонецФункции

// Проверяет, упрётся ли заведение тега пула с таким именем в номер версии пакета пула.
// Уже заведённое имя препятствием не считается: тег правится как прежде.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Имя - Строка - имя тега.
//
// Возвращаемое значение:
//  Булево - Истина, если тега пула с таким именем нет, а версия с таким номером у пакета
//           пула есть.
//
&Наблюдаемый
Функция ИмяДляТегаПулаЗанято(Знач ПулИдентификатор, Знач Имя) Экспорт

	Если НайтиТегПула(ПулИдентификатор, Имя) <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ИмяЗанятоВерсиейПула(ПулИдентификатор, Строки.Канон(Имя));

КонецФункции

#КонецОбласти

#Область ПравкаНабора

// Заводит либо правит тег пула. Некорректное имя или правило, а для нового тега — имя,
// занятое версией пакета пула, — исключение.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Имя - Строка - имя тега.
//  ТипПравила - Строка - semver или regex.
//  Правило - Строка - выражение отбора.
//  Кем - Строка - принципал для аудита (необязательный, по умолчанию "" — система).
//  Оформление - Структура, Неопределено - Стиль и Значок (ключи из СтильТега и
//               ЗначокТега); Неопределено — оформление не трогать (необязательный,
//               по умолчанию Неопределено).
//
// Возвращаемое значение:
//  ТегПула - сохранённый тег пула.
//
&Наблюдаемый
Функция ОпределитьТегПула(&АтрибутСпана("oshub.pool.id") Знач ПулИдентификатор,
	&АтрибутСпана("oshub.channel") Знач Имя, Знач ТипПравила, Знач Правило, Знач Кем = "",
	Знач Оформление = Неопределено) Экспорт

	ИмяНорм = ПроверитьИмя(Имя);
	Выражение = Новый ПравилоТега(ТипПравила, Правило);
	Отбор.ПроверитьИсполнимость(Выражение);

	ТегПула = НайтиИлиСоздать(ПулИдентификатор, ИмяНорм);
	ТегПула.ТипПравила = Выражение.Тип;
	ТегПула.Правило = Выражение.Выражение;
	Если Оформление <> Неопределено Тогда
		ТегПула.Стиль = Стили.Нормализовать(ЗначениеСвойства(Оформление, "Стиль"));
		ТегПула.Значок = Значки.Нормализовать(ЗначениеСвойства(Оформление, "Значок"));
	КонецЕсли;
	Сохранить(ТегПула);

	Летопись.ЗаписатьПравкуТегаПула(ТегПула, Кем);
	Возврат ТегПула;

КонецФункции

// Назначает тег пула основным: основной тег пула основной у каждого пакета пула, пока у
// пакета нет своего основного. Прежний основной снимается.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Имя - Строка - имя тега.
//
// Возвращаемое значение:
//  Булево - Истина, если тег найден и назначен.
//
&Наблюдаемый
Функция НазначитьОсновным(Знач ПулИдентификатор, Знач Имя) Экспорт

	Целевой = НайтиТегПула(ПулИдентификатор, Имя);
	Если Целевой = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого ТегПула Из ТегиПула(ПулИдентификатор) Цикл
		Если ТегПула.Идентификатор <> Целевой.Идентификатор И ТегПула.ПоУмолчанию = Истина Тогда
			ТегПула.ПоУмолчанию = Ложь;
			Сохранить(ТегПула);
		КонецЕсли;
	КонецЦикла;

	Целевой.ПоУмолчанию = Истина;
	Сохранить(Целевой);
	Возврат Истина;

КонецФункции

// Ставит или снимает запрет повторной публикации номеров под тегом пула. Запись тем же
// значением журнал не пишет.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Имя - Строка - имя тега.
//  Запрещён - Булево - Истина: переиздавать номера нельзя; Ложь: запрет снят.
//  Кем - Строка - принципал для аудита (необязательный, по умолчанию "" — система).
//
// Возвращаемое значение:
//  Булево - Истина, если тег найден.
//
&Наблюдаемый
Функция УстановитьЗапретПерезаписи(Знач ПулИдентификатор, Знач Имя, Знач Запрещён,
	Знач Кем = "") Экспорт

	ТегПула = НайтиТегПула(ПулИдентификатор, Имя);
	Если ТегПула = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	БылСнят = ЗапретСнят(ТегПула);
	СтанетСнят = НЕ (Запрещён = Истина);
	Если БылСнят = СтанетСнят Тогда
		Возврат Истина;
	КонецЕсли;

	ТегПула.ПерезаписьРазрешена = СтанетСнят;
	Сохранить(ТегПула);

	Летопись.ЗаписатьСменуЗапретаТегаПула(ТегПула, БылСнят, Кем);
	Возврат Истина;

КонецФункции

// Удаляет тег пула. Своих копий у пакетов удаление не трогает — они остаются своими тегами
// пакетов; выключения этого тега у пакетов пула уходят вместе с ним.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Имя - Строка - имя тега.
//  Кем - Строка - принципал для аудита (необязательный, по умолчанию "" — система).
//
// Возвращаемое значение:
//  Булево - Истина, если тег был и удалён.
//
&Наблюдаемый
Функция УдалитьТегПула(Знач ПулИдентификатор, &АтрибутСпана("oshub.channel") Знач Имя,
	Знач Кем = "") Экспорт

	ТегПула = НайтиТегПула(ПулИдентификатор, Имя);
	Если ТегПула = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ИмяНорм = Строка(ТегПула.Имя);
	ТегПула.Удалить();
	СнимкиКаналов.ЗабытьСнимокПула(Цел(ПулИдентификатор));
	СнятьВыключенияИмени(ПулИдентификатор, ИмяНорм);

	Летопись.ЗаписатьУдалениеТегаПула(ПулИдентификатор, ИмяНорм, Кем);
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Каналы визарда без перезаписи набора: имя, которое уже есть, не трогается.
Процедура Заполнить(Знач ПулИдентификатор, Итог, Знач Кем)

	ЕстьОсновной = Ложь;
	Для Каждого ТегПула Из ТегиПула(ПулИдентификатор) Цикл
		ЕстьОсновной = ЕстьОсновной ИЛИ ТегПула.ПоУмолчанию = Истина;
	КонецЦикла;

	Для Каждого Предложение Из Каналы.Предложения() Цикл

		Если НайтиТегПула(ПулИдентификатор, Предложение.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ИмяДляТегаПулаЗанято(ПулИдентификатор, Предложение.Имя) Тогда
			Итог.Занято.Добавить(Предложение.Имя);
			Продолжить;
		КонецЕсли;

		ОпределитьТегПула(ПулИдентификатор, Предложение.Имя, Предложение.ТипПравила,
			Предложение.Правило, Кем, Новый Структура("Стиль, Значок", Предложение.Стиль, ""));
		Если Предложение.ПерезаписьРазрешена Тогда
			УстановитьЗапретПерезаписи(ПулИдентификатор, Предложение.Имя, Ложь, Кем);
		КонецЕсли;
		Итог.Создано.Добавить(Предложение.Имя);

	КонецЦикла;

	Если НЕ ЕстьОсновной Тогда
		НазначитьОсновным(ПулИдентификатор, Каналы.ИмяОсновного());
	КонецЕсли;

КонецПроцедуры

// Запрет держит появление нового имени, а не правку тега, заведённого до него.
Функция НайтиИлиСоздать(Знач ПулИдентификатор, Знач ИмяНорм)

	ТегПула = НайтиТегПула(ПулИдентификатор, ИмяНорм);
	Если ТегПула <> Неопределено Тогда
		Возврат ТегПула;
	КонецЕсли;

	Если ИмяЗанятоВерсиейПула(ПулИдентификатор, ИмяНорм) Тогда
		ВызватьИсключение СтрШаблон(
			"Имя ""%1"" занято версией пакета этого пула: спецификацию ""пакет@%1"" резолв читает"
			+ " сначала точной версией, и тег с таким именем у этого пакета остался бы недостижим."
			+ " Назовите тег иначе", ИмяНорм);
	КонецЕсли;

	ТегПула = ХранилищеТеговПулов.СоздатьЭлемент();
	ТегПула.ПулИдентификатор = ПулИдентификатор;
	ТегПула.Имя = ИмяНорм;
	ТегПула.Стиль = Стили.Обычный();
	ТегПула.Значок = Значки.Нет();
	ТегПула.ПоУмолчанию = Ложь;
	// запрет повторной публикации включён у нового тега пула, как у тега пакета
	ТегПула.ПерезаписьРазрешена = Ложь;
	Возврат ТегПула;

КонецФункции

// Тем же поиском, каким лесенка резолва берёт точную версию, — у каждого пакета пула.
Функция ИмяЗанятоВерсиейПула(Знач ПулИдентификатор, Знач ИмяНорм)

	Для Каждого ПакетИдентификатор Из СервисВерсий.ПакетыСВерсией(ИмяНорм) Цикл
		Пакет = СервисПакетов.ПакетПоИдентификатору(ПакетИдентификатор);
		Если Пакет <> Неопределено И Цел(Пакет.ПулИдентификатор) = Цел(ПулИдентификатор) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура СнятьВыключенияИмени(Знач ПулИдентификатор, Знач ИмяНорм)

	Выключенные = Выключения.ПолучитьПоИмяРавно(ИмяНорм);
	Для Каждого Выключение Из ?(Выключенные = Неопределено, Новый Массив(), Выключенные) Цикл
		Пакет = СервисПакетов.ПакетПоИдентификатору(Выключение.ПакетИдентификатор);
		Если Пакет = Неопределено ИЛИ Цел(Пакет.ПулИдентификатор) = Цел(ПулИдентификатор) Тогда
			Выключение.Удалить();
			СнимкиКаналов.ЗабытьСнимокПакета(Цел(Выключение.ПакетИдентификатор));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Запись тега пула сразу забывает снимок пула — оборванная операция не оставит прежний.
Процедура Сохранить(Знач ТегПула)
	ТегПула.Обновлён = ТекущаяУниверсальнаяДата();
	ТегПула.Сохранить();
	СнимкиКаналов.ЗабытьСнимокПула(Цел(ТегПула.ПулИдентификатор));
КонецПроцедуры

// Имя тега пула подставляется в «пакет@тег» каждого пакета пула: алфавит — как у тега пакета.
Функция ПроверитьИмя(Знач Имя)

	Если НЕ СервисТегов.ИмяДопустимо(Имя) Тогда
		ВызватьИсключение СтрШаблон(
			"Недопустимое имя тега ""%1"": латиница, цифры, дефис, подчёркивание и точка,"
			+ " не длиннее 64 символов", Строки.Канон(Имя));
	КонецЕсли;
	Возврат Строки.Канон(Имя);

КонецФункции

Функция ЗначениеСвойства(Знач Структура, Знач Имя)
	Значение = Неопределено;
	Структура.Свойство(Имя, Значение);
	Возврат Значение;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеТеговПулов") _ХранилищеТеговПулов,
	&Пластилин(Значение = "ХранилищеВыключенныхТеговПулов") _Выключения,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "КаналыПоУмолчанию") _Каналы,
	&Пластилин(Значение = "НастройкаТеговПула") _Настройка,
	&Пластилин(Значение = "СнимкиКаналов") _СнимкиКаналов,
	&Пластилин(Значение = "ОтборВерсийПоПравилу") _Отбор,
	&Пластилин(Значение = "ЛетописьТегов") _Летопись,
	&Пластилин(Значение = "СтильТега") _Стили,
	&Пластилин(Значение = "ЗначокТега") _Значки,
	&Пластилин(Значение = "КанонСтроки") _Строки)

	ХранилищеТеговПулов = _ХранилищеТеговПулов;
	Выключения = _Выключения;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;
	СервисТегов = _СервисТегов;
	Каналы = _Каналы;
	Настройка = _Настройка;
	СнимкиКаналов = _СнимкиКаналов;
	Отбор = _Отбор;
	Летопись = _Летопись;
	Стили = _Стили;
	Значки = _Значки;
	Строки = _Строки;

КонецПроцедуры
