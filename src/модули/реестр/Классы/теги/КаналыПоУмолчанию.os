// Предложение из трёх каналов — stable, prerelease и develop, — которое заводит визард
// в форме тегов пакета и первое включение тегов пула; каналы версии в момент события.

Перем СервисТегов;    // СервисТегов
Перем СервисПакетов;  // СервисПакетов
Перем СервисВерсий;   // СервисВерсий — версия, чей состав в каналах спрашивают
Перем Стили;          // СтильТега — словарь стилей плашки
Перем Сравнитель;     // СравнительВерсий — слово, которым зовётся изменяемый слот

#Область ПубличныйИнтерфейс

// Возвращает предлагаемые каналы в порядке показа: что будет заведено и по какому правилу.
//
// Возвращаемое значение:
//  Массив из Структура - Имя (Строка), ТипПравила (Строка), Правило (Строка),
//                        Стиль (Строка: ключ СтильТега), ПерезаписьРазрешена (Булево:
//                        Истина — номера канала переиздаются без force).
//
Функция Предложения() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Предложение(ИмяStable(), "regex", ВыражениеРелизов(),
		Стили.Стабильный(), Ложь));
	Результат.Добавить(Предложение(ИмяPrerelease(), "regex", ВыражениеРелизовИRC(),
		Стили.Предварительный(), Ложь));
	// ночные сборки переиздаются под тем же номером: у develop запрет перезаписи снят с рождения
	Результат.Добавить(Предложение(ИмяDevelop(), "regex", ВыражениеСборочных(),
		Стили.Особый(), Истина));
	Возврат Результат;

КонецФункции

// Заводит предлагаемые каналы пакета. Идемпотентна: тег, который у пакета уже есть, — свой
// или унаследованный от пула — не трогается вовсе: правило, изменённое мейнтейнером,
// визард не переопределяет. Имя, занятое версией пакета, пропускается и остальным создаться
// не мешает. Если у пакета ещё нет основного тега, им становится stable.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Кем - Строка - принципал для аудита (необязательный, по умолчанию "" — система).
//
// Возвращаемое значение:
//  Структура - Создано (Массив из Строка — заведённые имена), Пропущено (Массив из Строка —
//              уже существовавшие), Занято (Массив из Строка — имена, занятые версией пакета),
//              Основной (Строка — имя основного тега после операции; "" — основного нет).
//
Функция Создать(Знач ПакетИдентификатор, Знач Кем = "") Экспорт

	ТребоватьПакет(ПакетИдентификатор);

	Итог = ПустойИтог();
	ЕстьОсновной = ЗначениеЗаполнено(ИмяТегаПоУмолчанию(ПакетИдентификатор));

	Для Каждого Предложение Из Предложения() Цикл

		Если СервисТегов.НайтиДействующийТег(ПакетИдентификатор, Предложение.Имя) <> Неопределено Тогда
			Итог.Пропущено.Добавить(Предложение.Имя);
			Продолжить;
		КонецЕсли;

		Если СервисТегов.ИмяДляНовогоТегаЗанято(ПакетИдентификатор, Предложение.Имя) Тогда
			Итог.Занято.Добавить(Предложение.Имя);
			Продолжить;
		КонецЕсли;

		Завести(ПакетИдентификатор, Предложение, Кем);
		Итог.Создано.Добавить(Предложение.Имя);

	КонецЦикла;

	Если НЕ ЕстьОсновной Тогда
		СервисТегов.НазначитьПоУмолчанию(ПакетИдентификатор, ИмяStable());
	КонецЕсли;

	// основного тега может не оказаться — stable упёрся в номер версии, и сказать об этом должен вызывающий
	Итог.Основной = ИмяТегаПоУмолчанию(ПакетИдентификатор);
	Возврат Итог;

КонецФункции

// Возвращает имя канала, который визард делает основным.
//
// Возвращаемое значение:
//  Строка - имя канала.
//
Функция ИмяОсновного() Экспорт
	Возврат ИмяStable();
КонецФункции

// Возвращает теги пакета, в составе которых версия в момент события, — как состав видит
// служба тегов: теги пакета вместе с унаследованными от пула, у тега-правила по правилу,
// у ручного — по его меткам; выключенный у пакета тег пула в ответ не входит. Теги пула
// пакет наследует сразу, поэтому исход не зависит от того, первая ли это версия пакета.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  СтрокаВерсии - Строка - версия пакета.
//  Публикуется - Булево - событие — публикация этой версии; состав от него не зависит
//                (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Массив из Строка - имена тегов в нижнем регистре; пустой, если пакета или версии нет.
//
Функция КаналыВерсии(Знач ПакетИдентификатор, Знач СтрокаВерсии, Знач Публикуется = Ложь) Экспорт
	Возврат ЗаведённыеКаналыВерсии(ПакетИдентификатор, СтрокаВерсии);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Состав считает служба тегов — по той единственной версии, о которой спрашивают.
Функция ЗаведённыеКаналыВерсии(Знач ПакетИдентификатор, Знач СтрокаВерсии)

	Результат = Новый Массив();
	Версия = СервисВерсий.НайтиВерсию(ПакетИдентификатор, СтрокаВерсии);
	Если Версия = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Кандидаты = Новый Массив();
	Кандидаты.Добавить(Версия);
	Теги = СервисТегов.КаналыПакета(ПакетИдентификатор, Кандидаты).ПоВерсиям.Получить(Версия.Идентификатор);
	Для Каждого Тег Из ?(Теги = Неопределено, Новый Массив(), Теги) Цикл
		Результат.Добавить(НРег(СокрЛП(Тег.Имя)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура Завести(Знач ПакетИдентификатор, Знач Предложение, Знач Кем)

	СервисТегов.ОпределитьТегПравила(ПакетИдентификатор, Предложение.Имя,
		Предложение.ТипПравила, Предложение.Правило, Кем,
		Новый Структура("Стиль, Значок", Предложение.Стиль, ""));

	Если Предложение.ПерезаписьРазрешена Тогда
		СервисТегов.УстановитьЗапретПерезаписи(ПакетИдентификатор, Предложение.Имя, Ложь, Кем);
	КонецЕсли;

КонецПроцедуры

// Основной тег пула — тоже основной у пакета, пока своего нет: визард его не перебивает.
Функция ИмяТегаПоУмолчанию(Знач ПакетИдентификатор)

	Для Каждого Тег Из СервисТегов.ДействующиеТеги(ПакетИдентификатор) Цикл
		Если Тег.ПоУмолчанию = Истина Тогда
			Возврат Строка(Тег.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Процедура ТребоватьПакет(Знач ПакетИдентификатор)

	Если СервисПакетов.ПакетПоИдентификатору(ПакетИдентификатор) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"Пакет с идентификатором %1 не найден — заводить каналы не для кого",
			Строка(ПакетИдентификатор));
	КонецЕсли;

КонецПроцедуры

// Правила каналов — regex по строке версии: диапазон не выражает «релизы и только rc» и не видит
// строк вне порядка. Тела наращиваются одно из другого, поэтому щели между каналами нет: develop —
// отрицание состава prerelease без изменяемого слота источника. Релиз — номер без предрелизного
// суффикса, в том числе со сборочной компонентой («1.2.3.4»).

// Номер версии: от одного до четырёх чисел плюс необязательные метаданные сборки.
Функция ТелоНомера()
	Возврат "[0-9]+(\.[0-9]+)?(\.[0-9]+)?(\.[0-9]+)?";
КонецФункции

Функция ТелоМетаданных()
	Возврат "(\+[0-9A-Za-z.-]+)?";
КонецФункции

Функция ТелоРелиза()
	Возврат ТелоНомера() + ТелоМетаданных();
КонецФункции

Функция ВыражениеРелизов()
	Возврат "^" + ТелоРелиза() + "$";
КонецФункции

// Регистр значим, как и у любого правила тега: «1.0.0-RC1» под «-rc» не подходит.
Функция ТелоРелизовИRC()
	Возврат ТелоНомера() + "(-rc[0-9A-Za-z.-]*)?" + ТелоМетаданных();
КонецФункции

Функция ВыражениеРелизовИRC()
	Возврат "^" + ТелоРелизовИRC() + "$";
КонецФункции

// Всё, что не релиз, не rc и не слот источника («-alpha», «-dev»…); регистр значим, кроме изъятия.
Функция ВыражениеСборочных()
	Возврат "^" + ОтрицаниеСлота() + "(?!" + ТелоРелизовИRC() + "$).+$";
КонецФункции

// Регистр в изъятии не значим: «snapshot» и «SNAPSHOT» — один и тот же слот источника.
Функция ОтрицаниеСлота()
	Возврат "(?!(?i:" + Сравнитель.СловоСлота() + ")$)";
КонецФункции

Функция Предложение(Знач Имя, Знач ТипПравила, Знач Правило, Знач Стиль, Знач ПерезаписьРазрешена)

	Возврат Новый Структура("Имя, ТипПравила, Правило, Стиль, ПерезаписьРазрешена",
		Имя, ТипПравила, Правило, Стиль, ПерезаписьРазрешена);

КонецФункции

Функция ПустойИтог()

	Возврат Новый Структура("Создано, Пропущено, Занято, Основной",
		Новый Массив(), Новый Массив(), Новый Массив(), "");

КонецФункции

Функция ИмяStable()
	Возврат "stable";
КонецФункции

// Это же имя знает СервисТегов.ЛегасиАлиас: переименуешь канал здесь — почини алиас там.
Функция ИмяPrerelease()
	Возврат "prerelease";
КонецФункции

Функция ИмяDevelop()
	Возврат "develop";
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СтильТега") _Стили,
	&Пластилин(Значение = "СравнительВерсий") _Сравнитель,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий)

	СервисТегов = _СервисТегов;
	СервисПакетов = _СервисПакетов;
	Стили = _Стили;
	Сравнитель = _Сравнитель;
	СервисВерсий = _СервисВерсий;

КонецПроцедуры
