// Словарь ключей стиля — единственный владелец значений колонки Тег.Стиль.
// Хранится ключ, а не цвет: цвет даёт переменная темы, и плашка сама инвертируется.

#Область ПубличныйИнтерфейс

// Возвращает стиль «обычный» — канал без выделения, вид плашки по умолчанию.
//
// Возвращаемое значение:
//  Строка - ключ стиля.
//
Функция Обычный() Экспорт
	Возврат "plain";
КонецФункции

// Возвращает стиль «стабильный» — канал, который можно ставить в продакшен.
//
// Возвращаемое значение:
//  Строка - ключ стиля.
//
Функция Стабильный() Экспорт
	Возврат "stable";
КонецФункции

// Возвращает стиль «предварительный» — канал пререлизов: бет, rc и ночных сборок.
//
// Возвращаемое значение:
//  Строка - ключ стиля.
//
Функция Предварительный() Экспорт
	Возврат "prerelease";
КонецФункции

// Возвращает стиль «устаревший» — канал, который больше не развивают.
//
// Возвращаемое значение:
//  Строка - ключ стиля.
//
Функция Устаревший() Экспорт
	Возврат "deprecated";
КонецФункции

// Возвращает стиль «особый» — канал, который мейнтейнер выделяет сам (lts, enterprise).
//
// Возвращаемое значение:
//  Строка - ключ стиля.
//
Функция Особый() Экспорт
	Возврат "special";
КонецФункции

// Возвращает все допустимые стили в порядке показа.
//
// Возвращаемое значение:
//  Массив из Строка - ключи стилей.
//
Функция Все() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Обычный());
	Результат.Добавить(Стабильный());
	Результат.Добавить(Предварительный());
	Результат.Добавить(Устаревший());
	Результат.Добавить(Особый());
	Возврат Результат;

КонецФункции

// Нормализует ключ стиля по регистру и пробелам. Пустое значение и незнакомый ключ
// сводятся к «обычному»: стиль — оформление, и незнакомая строка из старой строки БД
// не должна ронять показ карточки.
//
// Параметры:
//  Значение - Произвольный - сырое значение из формы, тела запроса или строки БД.
//
// Возвращаемое значение:
//  Строка - ключ стиля.
//
Функция Нормализовать(Знач Значение) Экспорт

	Норм = НРег(СокрЛП(?(Значение = Неопределено, "", Строка(Значение))));
	Если Все().Найти(Норм) <> Неопределено Тогда
		Возврат Норм;
	КонецЕсли;
	Возврат Обычный();

КонецФункции

// Проверяет, знаком ли ключ стиля. В отличие от Нормализовать, не прощает: контроллеру
// нужно отличить «прислали мусор» от «прислали обычный».
//
// Параметры:
//  Значение - Произвольный - проверяемое значение.
//
// Возвращаемое значение:
//  Булево - Истина для пустого значения и для любого ключа из списка.
//
Функция Допустим(Знач Значение) Экспорт

	Норм = НРег(СокрЛП(?(Значение = Неопределено, "", Строка(Значение))));
	Возврат ПустаяСтрока(Норм) ИЛИ Все().Найти(Норм) <> Неопределено;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
