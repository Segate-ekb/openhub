// Каналы пакета для чтения из кэша: свои теги пакета с ручными метками и выключенными тегами
// пула — снимком «каналыПакета», набор тегов пула и его галка — снимком «тегиПула»; резолв
// и страницы пакета спрашивают их на каждый запрос.

Перем ХранилищеТегов;       // ХранилищеТегов
Перем ХранилищеМеток;       // ХранилищеМетокТегов
Перем ХранилищеВыключенных; // ХранилищеВыключенныхТеговПулов
Перем ХранилищеТеговПулов;  // ХранилищеТеговПулов
Перем ХранилищеПакетов;     // ХранилищеПакетов — пул пакета
Перем ХранилищеПулов;       // ХранилищеПулов — галка пула
Перем Настройка;            // НастройкаТеговПула — галка «теги пула для пакетов»
Перем ФормаСнимка;          // ФормаСнимка (данные) — снимок строки тега
Перем ФормаСнимкаПула;      // ФормаСнимка (данные) — снимок строки тега пула

// Снимок своих каналов пакета, только для чтения.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Теги (ФиксированныйМассив из ФиксированнаяСтруктура — строки
//                           своих тегов пакета), Метки (ФиксированноеСоответствие:
//                           идентификатор тега (Число) → ФиксированноеСоответствие:
//                           идентификатор помеченной версии (Число) → Истина), Выключенные
//                           (ФиксированныйМассив из Строка — имена тегов пула, выключенных
//                           у пакета), ПулИдентификатор (Число; 0 — пакета нет).
//
&Кэшируемый("каналыПакета")
Функция СнимокПакета(Знач ПакетИдентификатор) Экспорт

	Теги = ХранилищеТегов.ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор);
	Теги = ?(Теги = Неопределено, Новый Массив(), Теги);

	Возврат Новый ФиксированнаяСтруктура("Теги, Метки, Выключенные, ПулИдентификатор",
		ФормаСнимка.Снимки(Теги), МеткиТегов(Теги), Новый ФиксированныйМассив(ХранилищеВыключенных.ИменаПакета(ПакетИдентификатор)),
		ПулПакета(ПакетИдентификатор));

КонецФункции

// Снимок тегов пула, которые наследуют его пакеты, только для чтения.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура - Включено (Булево — галка «теги пула для пакетов»), Теги
//                           (ФиксированныйМассив из ФиксированнаяСтруктура — строки тегов
//                           пула; у пула без галки пуст).
//
&Кэшируемый("тегиПула")
Функция СнимокПула(Знач ПулИдентификатор) Экспорт

	Включено = Настройка.Включена(ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(ПулИдентификатор));

	Теги = Новый Массив();
	Если Включено Тогда
		Теги = ХранилищеТеговПулов.ПолучитьПоПулИдентификаторРавно(ПулИдентификатор);
		Теги = ?(Теги = Неопределено, Новый Массив(), Теги);
	КонецЕсли;

	Возврат Новый ФиксированнаяСтруктура("Включено, Теги", Включено, ФормаСнимкаПула.Снимки(Теги));

КонецФункции

// Забывает снимок каналов пакета: зовёт каждый, кто записал или удалил тег пакета, метку
// его тега либо выключение тега пула у пакета.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
&СбрасываетКэш("каналыПакета")
Процедура ЗабытьСнимокПакета(Знач ПакетИдентификатор) Экспорт
КонецПроцедуры

// Забывает снимок тегов пула: зовёт каждый, кто записал или удалил тег пула либо переключил
// его галку, — все пакеты пула видят правку следующим чтением.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
&СбрасываетКэш("тегиПула")
Процедура ЗабытьСнимокПула(Знач ПулИдентификатор) Экспорт
КонецПроцедуры

// Метки всех тегов пакета одной выборкой; у тега-правила их нет, и в ответе он пуст.
Функция МеткиТегов(Знач Теги)

	Номера = Новый Массив();
	Для Каждого Тег Из Теги Цикл
		Номера.Добавить(Цел(Тег.Идентификатор));
	КонецЦикла;

	Результат = Новый Соответствие();
	Для Каждого Элемент Из ХранилищеМеток.ПомеченныеПоТегам(Номера) Цикл
		Результат.Вставить(Элемент.Ключ, Новый ФиксированноеСоответствие(Элемент.Значение));
	КонецЦикла;

	Возврат Новый ФиксированноеСоответствие(Результат);

КонецФункции

// Пакет из пула не уезжает: пул пакета снимок держит вместе с его тегами.
Функция ПулПакета(Знач ПакетИдентификатор)
	Пакет = ХранилищеПакетов.ПолучитьОдноПоИдентификаторРавно(ПакетИдентификатор);
	Возврат ?(Пакет = Неопределено, 0, Цел(Пакет.ПулИдентификатор));
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеТегов") _ХранилищеТегов,
	&Пластилин(Значение = "ХранилищеМетокТегов") _ХранилищеМеток,
	&Пластилин(Значение = "ХранилищеВыключенныхТеговПулов") _ХранилищеВыключенных,
	&Пластилин(Значение = "ХранилищеТеговПулов") _ХранилищеТеговПулов,
	&Пластилин(Значение = "ХранилищеПакетов") _ХранилищеПакетов,
	&Пластилин(Значение = "ХранилищеПулов") _ХранилищеПулов,
	&Пластилин(Значение = "НастройкаТеговПула") _Настройка)

	ХранилищеТегов = _ХранилищеТегов;
	ХранилищеМеток = _ХранилищеМеток;
	ХранилищеВыключенных = _ХранилищеВыключенных;
	ХранилищеТеговПулов = _ХранилищеТеговПулов;
	ХранилищеПакетов = _ХранилищеПакетов;
	ХранилищеПулов = _ХранилищеПулов;
	Настройка = _Настройка;
	ФормаСнимка = Новый ФормаСнимка(ХранилищеТегов.ПолучитьОбъектМодели());
	ФормаСнимкаПула = Новый ФормаСнимка(ХранилищеТеговПулов.ПолучитьОбъектМодели());

КонецПроцедуры
