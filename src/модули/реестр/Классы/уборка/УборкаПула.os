// Уборка содержимого пула перед его удалением: строки других предметов, апстримы, область
// в хранилище и все пакеты; чужие строки — доступы, ключи, подписки — уходят первыми.

Перем Последствия;          // Массив из ПоследствияУдаленияПула — строки других предметов
Перем УборкаПакета;         // УборкаПакета — пакет со всей обвязкой
Перем ХранилищеАртефактов;  // ХранилищеАртефактов (хранилище) — область пула целиком
Перем ХранилищеАпстримов;   // ХранилищеАпстримовПула
Перем ХранилищеПакетов;     // ХранилищеПакетов
Перем Снятие;               // СнятиеСтрок (данные) — снятие пачки строк со счётом

#Область ПубличныйИнтерфейс

// Снимает всё, что ссылается на пул, и всю его область в хранилище. Сам пул не трогает —
// его удаляет СервисПулов, проверив свои инварианты. Идемпотентна: на пустом пуле
// снимать нечего.
//
// Параметры:
//  Пул - Пул - пул, содержимое которого убирается.
//
// Возвращаемое значение:
//  Структура - Доступов (Число), Ролей (Число), Подписок (Число),
//              Зеркал (Число), Апстримов (Число), Заявок (Число), Артефактов (Число),
//              Пакетов (Число), Строк (Число — всего удалённых строк, со снимками
//              манифеста заявок).
//
Функция ОчиститьСодержимое(Знач Пул) Экспорт

	ПроверитьСостав();

	ПулИд = Цел(Пул.Идентификатор);
	Итог = ПустойИтог();

	Для Каждого Последствие Из Последствия Цикл
		Учесть(Итог, Последствие.СнятьСтрокиПула(Пул));
	КонецЦикла;

	Попытка
		Итог.Апстримов = Снятие.Снять(ХранилищеАпстримов.ПолучитьПоПулИдентификаторРавно(ПулИд));
	Исключение
		ХранилищеАпстримов.ЗабытьСнимкиПула(ПулИд);
		ВызватьИсключение;
	КонецПопытки;
	ХранилищеАпстримов.ЗабытьСнимкиПула(ПулИд);

	// область сносится целиком и до пакетов: под именем пула лежат и кэш прокси, и файлы мимо
	// координат, и Артефактов считает все файлы пула, а не остаток после пакетной уборки
	Итог.Артефактов = ХранилищеАртефактов.УдалитьОбластьПула(Строка(Пул.Имя));

	СтрокПакетов = 0;
	// имя пула у нас на руках: уборка пакета иначе перечитывала бы его на каждый пакет
	Для Каждого Пакет Из ХранилищеПакетов.ПолучитьПоПулИдентификаторРавно(ПулИд) Цикл
		СтрокПакетов = СтрокПакетов + УборкаПакета.УдалитьПакет(Пакет, Строка(Пул.Имя));
		Итог.Пакетов = Итог.Пакетов + 1;
	КонецЦикла;

	Итог.Строк = Итог.Строк + Итог.Апстримов + СтрокПакетов;
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строки других предметов снять некому — отказ до первого удаления, а не сироты в базе.
Процедура ПроверитьСостав()

	Если Последствия.Количество() = 0 Тогда
		ВызватьИсключение "УборкаПула: строки других предметов снять некому — реализации"
			+ " ПоследствияУдаленияПула (модули права, вход, подписки, зеркала, публикация) не внедрены";
	КонецЕсли;

КонецПроцедуры

Функция ПустойИтог()
	Возврат Новый Структура("Доступов, Ролей, Подписок, Зеркал, Апстримов, Заявок, Артефактов, Пакетов, Строк",
		0, 0, 0, 0, 0, 0, 0, 0, 0);
КонецФункции

// Снятое предметом ложится в свои статьи итога; статьи, которой в итоге нет, контракт не знает.
Процедура Учесть(Итог, Знач Снятое)

	Для Каждого Статья Из Снятое Цикл
		Если НЕ Итог.Свойство(Статья.Ключ) Тогда
			ВызватьИсключение СтрШаблон("ПоследствияУдаленияПула: статьи «%1» в итоге уборки пула нет",
				Статья.Ключ);
		КонецЕсли;
		Итог[Статья.Ключ] = Итог[Статья.Ключ] + Статья.Значение;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПоследствияУдаленияПула", Тип = "Массив") _Последствия,
	&Пластилин(Значение = "УборкаПакета") _УборкаПакета,
	&Пластилин(Значение = "ХранилищеАртефактов") _ХранилищеАртефактов,
	&Пластилин(Значение = "ХранилищеАпстримовПула") _ХранилищеАпстримов,
	&Пластилин(Значение = "ХранилищеПакетов") _ХранилищеПакетов,
	&Пластилин(Значение = "СнятиеСтрок") _Снятие)

	// контейнер без предметов собирается, но удалить пул в нём нельзя
	Последствия = _Последствия;
	УборкаПакета = _УборкаПакета;
	ХранилищеАртефактов = _ХранилищеАртефактов;
	ХранилищеАпстримов = _ХранилищеАпстримов;
	ХранилищеПакетов = _ХранилищеПакетов;
	Снятие = _Снятие;

КонецПроцедуры
