// Удаление пакета со всей обвязкой: строки других предметов, теги, скачивания, версии, файлы
// и описания. Порядок «сначала обезоружить»: чужие строки — права, подписки — уходят первыми.

Перем Последствия;            // Массив из ПоследствияУдаленияПакета — строки других предметов
Перем Скачивания;             // СкачиванияПакетов (статистика) — агрегаты скачиваний пакета
Перем ХранилищеАртефактов;    // ХранилищеАртефактов (хранилище) — файлы версий
Перем ХранилищеПулов;         // ХранилищеПулов — имя пула для координат артефакта
Перем СервисПакетов;          // СервисПакетов — удаление опустевшего пакета
Перем СнимкиКаналов;          // СнимкиКаналов — каналы пакета в кэше
Перем ХранилищеТегов;         // ХранилищеТегов
Перем ХранилищеМетокТегов;    // ХранилищеМетокТегов
Перем ХранилищеВыключенных;   // ХранилищеВыключенныхТеговПулов — теги пула, выключенные у пакета
Перем ХранилищеВерсий;        // ХранилищеВерсийПакета
Перем ХранилищеЗависимостей;  // ХранилищеЗависимостей
Перем ХранилищеМетокВерсий;   // ХранилищеМетокВерсий
Перем ХранилищеПроисхождения; // ХранилищеПроисхожденияВерсий
Перем ХранилищеЗапусков;      // ХранилищеЗапусковКонвейеров, необязательно
Перем ХранилищеОписаний;      // ХранилищеREADME (описания), необязательно
Перем Объёмы;                 // УчётОбъёмаПула — занятый пулом объём
Перем Снятие;                 // СнятиеСтрок (данные) — снятие пачки строк со счётом

#Область ПубличныйИнтерфейс

// Удаляет пакет и всё, что на него ссылается.
//
// Параметры:
//  Пакет - Пакет - удаляемый пакет.
//  ИмяПула - Строка, Неопределено - имя пула пакета, если вызывающий его уже прочитал;
//            Неопределено — спросить базу (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Число - сколько строк удалено, включая сам пакет.
//
Функция УдалитьПакет(Знач Пакет, Знач ИмяПула = Неопределено) Экспорт

	Если Пакет = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	ПроверитьСостав();

	// снятое наполовину тоже меняет прочитанное: снимки содержимого забываются и на отказе
	Попытка
		Снято = СнятьПакет(Пакет, ИмяПула);
	Исключение
		ЗабытьСнимкиСодержимого(Пакет);
		ВызватьИсключение;
	КонецПопытки;

	ЗабытьСнимкиСодержимого(Пакет);
	Возврат Снято;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СнятьПакет(Знач Пакет, Знач ИмяПула)

	ПакетИд = Цел(Пакет.Идентификатор);
	Снято = 0;
	ИмяОбласти = ?(ИмяПула = Неопределено, ИмяПулаПакета(Пакет), Строка(ИмяПула));

	Для Каждого Последствие Из Последствия Цикл
		Снято = Снято + Последствие.СнятьСтрокиПакета(Пакет);
	КонецЦикла;

	ТегиПакета = ХранилищеТегов.ПолучитьПоПакетИдентификаторРавно(ПакетИд);
	Снято = Снято + Снятие.Снять(ХранилищеМетокТегов.СоставТегов(Номера(ТегиПакета)));
	Для Каждого Тег Из ТегиПакета Цикл
		Тег.Удалить();
		Снято = Снято + 1;
	КонецЦикла;
	Снято = Снято + Снятие.Снять(ХранилищеВыключенных.ПолучитьПоПакетИдентификаторРавно(ПакетИд));

	Снято = Снято + Снятие.Снять(ХранилищеПроисхождения.ПолучитьПоПакетИдентификаторРавно(ПакетИд));
	Если ХранилищеЗапусков <> Неопределено Тогда
		Снято = Снято + Снятие.Снять(ХранилищеЗапусков.ПолучитьПоПакетИдентификаторРавно(ПакетИд));
	КонецЕсли;
	Снято = Снято + Скачивания.СнятьПакет(ПакетИд);

	ВерсииПакета = ХранилищеВерсий.ПолучитьПоПакетИдентификаторРавно(ПакетИд);
	НомераВерсий = Номера(ВерсииПакета);
	Снято = Снято + Снятие.Снять(ХранилищеЗависимостей.ПоВерсиям(НомераВерсий));
	Снято = Снято + Снятие.Снять(ХранилищеМетокВерсий.МеткиВерсий(НомераВерсий));

	Освобождено = 0;
	Для Каждого Версия Из ВерсииПакета Цикл
		Освобождено = Освобождено + СнятьАртефакт(ИмяОбласти, Пакет, Версия);
		Версия.Удалить();
		Снято = Снято + 1;
	КонецЦикла;

	// до удаления пакета: занятое считается по его пулу, а пул адресуется через пакет
	Объёмы.УчестьПоПакету(ПакетИд, -Освобождено);

	СервисПакетов.УдалитьПустойПакет(Пакет);
	Возврат Снято + 1;

КонецФункции

// Строки других предметов снять некому — отказ до первого удаления, а не сироты в базе.
Процедура ПроверитьСостав()

	Если Последствия.Количество() = 0 Тогда
		ВызватьИсключение "УборкаПакета: строки других предметов снять некому — реализации"
			+ " ПоследствияУдаленияПакета (модули права, подписки, публикация) не внедрены";
	КонецЕсли;

	Если Скачивания = Неопределено Тогда
		ВызватьИсключение "УборкаПакета: скачивания пакета снять некому — СкачиванияПакетов"
			+ " (модуль статистика) не внедрены";
	КонецЕсли;

КонецПроцедуры

// Версии, провенанс, каналы и суммы скачиваний; строку самого пакета забывает служба пакетов.
Процедура ЗабытьСнимкиСодержимого(Знач Пакет)

	ПакетИд = Цел(Пакет.Идентификатор);
	ХранилищеВерсий.ЗабытьСнимкиПакета(ПакетИд);
	ХранилищеПроисхождения.ЗабытьСнимкиПакета(ПакетИд);
	СнимкиКаналов.ЗабытьСнимокПакета(ПакетИд);
	Скачивания.ЗабытьПакет(ПакетИд);

КонецПроцедуры

// Идентификаторы строк: зависимое от них спрашивается одним разрезом, а не на каждую строку.
Функция Номера(Знач Записи)

	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Результат.Добавить(Цел(Запись.Идентификатор));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Координаты собираются ИЗ СУЩНОСТЕЙ, а не из строки ПутьВХранилище: та пишется вербатим.
Функция СнятьАртефакт(Знач ИмяПула, Знач Пакет, Знач Версия)

	Если НЕ ЗначениеЗаполнено(ИмяПула) Тогда
		Возврат 0; // пул уже снят — область его хранения снесена целиком
	КонецЕсли;

	Координаты = Новый КоординатыАртефакта(ИмяПула, Строка(Пакет.Имя), Строка(Версия.Версия));
	Освобождается = 0;
	Попытка
		Если ХранилищеАртефактов.Существует(Координаты) Тогда
			Освобождается = Макс(0, Цел(Число(ХранилищеАртефактов.Размер(Координаты))));
		КонецЕсли;
	Исключение
		Освобождается = 0; // не смогли замерить — не списываем вслепую, счётчик починит сверка
	КонецПопытки;

	ХранилищеАртефактов.Удалить(Координаты);
	Возврат Освобождается + СнятьОписание(ИмяПула, Пакет, Версия);

КонецФункции

// Описание версии лежит рядом с её артефактом и уходит вместе с ним: файла нет — ноль.
Функция СнятьОписание(Знач ИмяПула, Знач Пакет, Знач Версия)

	Если ХранилищеОписаний = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ХранилищеОписаний.Снять(ИмяПула, Строка(Пакет.Имя), Строка(Версия.Версия));

КонецФункции

Функция ИмяПулаПакета(Знач Пакет)
	Пул = ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(Цел(Пакет.ПулИдентификатор));
	Возврат ?(Пул = Неопределено, "", Строка(Пул.Имя));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПоследствияУдаленияПакета", Тип = "Массив") _Последствия,
	&Пластилин(Значение = "СкачиванияПакетов", Тип = "Массив") _Скачивания,
	&Пластилин(Значение = "ХранилищеАртефактов") _ХранилищеАртефактов,
	&Пластилин(Значение = "ХранилищеПулов") _ХранилищеПулов,
	&Пластилин(Значение = "ХранилищеТегов") _ХранилищеТегов,
	&Пластилин(Значение = "ХранилищеМетокТегов") _ХранилищеМетокТегов,
	&Пластилин(Значение = "ХранилищеВерсийПакета") _ХранилищеВерсий,
	&Пластилин(Значение = "ХранилищеЗависимостей") _ХранилищеЗависимостей,
	&Пластилин(Значение = "ХранилищеМетокВерсий") _ХранилищеМетокВерсий,
	&Пластилин(Значение = "ХранилищеПроисхожденияВерсий") _ХранилищеПроисхождения,
	&Пластилин(Значение = "УчётОбъёмаПула") _Объёмы,
	&Пластилин(Значение = "СнятиеСтрок") _Снятие,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СнимкиКаналов") _СнимкиКаналов,
	&Пластилин(Значение = "ХранилищеВыключенныхТеговПулов") _ХранилищеВыключенных,
	&Пластилин(Значение = "ХранилищеREADME", Тип = "Массив") _ХранилищеОписаний = Неопределено,
	&Пластилин(Значение = "ХранилищеЗапусковКонвейеров") _ХранилищеЗапусков = Неопределено)

	Желуди = Новый ВнедрённыеЖелуди();

	// контейнер без предметов и статистики собирается, но удалить пакет в нём нельзя
	Последствия = _Последствия;
	Скачивания = Желуди.ПервыйИз(_Скачивания);
	ХранилищеАртефактов = _ХранилищеАртефактов;
	ХранилищеПулов = _ХранилищеПулов;
	ХранилищеТегов = _ХранилищеТегов;
	ХранилищеМетокТегов = _ХранилищеМетокТегов;
	ХранилищеВерсий = _ХранилищеВерсий;
	ХранилищеЗависимостей = _ХранилищеЗависимостей;
	ХранилищеМетокВерсий = _ХранилищеМетокВерсий;
	ХранилищеПроисхождения = _ХранилищеПроисхождения;
	Объёмы = _Объёмы;
	Снятие = _Снятие;
	СервисПакетов = _СервисПакетов;
	СнимкиКаналов = _СнимкиКаналов;
	ХранилищеВыключенных = _ХранилищеВыключенных;
	ХранилищеОписаний = Желуди.ПервыйИз(_ХранилищеОписаний);
	ХранилищеЗапусков = _ХранилищеЗапусков;

КонецПроцедуры
