// Доменные операции над пулами: создание с валидацией, типы, флаги, апстримы, листинги.
// Тип пула отвечает на вопрос «чьё пространство имён»: user (личное пространство,
// апстримов не имеет структурно) либо custom. Основной пул хаба — не тип, а признак
// Пул.ПоУмолчанию: его носитель обслуживает короткие адреса /download, /push
// и /dev-channel, всегда публичен и неудаляем. Апстрим-фоллбэк и разрешение публикации —
// свойства пула, а не признаки типа: «прокси-пул» это пресет «публикация запрещена плюс
// апстрим». Здесь живут доменные инварианты, а не авторизация — права проверяет
// вызывающий слой. Имя хранится канонизированным; его уникальность держится проверкой
// на этом слое, остаточная гонка двух конкурентных созданий одного имени принята.

Перем ХранилищеПулов;          // ХранилищеПулов (данные)
Перем ХранилищеАпстримов;      // ХранилищеАпстримовПула (данные)
Перем Уборка;                  // УборкаПула — каскад удаления содержимого
Перем Правила;                 // ПравилаИменования
Перем ВалидаторАдреса;         // ВалидаторАдресаАпстрима (зеркала) — форма адреса
Перем Секрет;                  // СекретИсточника (прокси) — правило токена источника
Перем Пробник;                 // ПробникИсточника (прокси) — пробное подключение к источнику
Перем Allowlist;               // СписокРазрешённыхИмён — маски имён у источника
Перем Порядок_;                // ПорядокАпстримов — поиск по адресу и плотная нумерация
Перем Квоты;                   // КвотаПула — разрешение эффективной квоты
Перем Объёмы;                  // УчётОбъёмаПула — занятый объём
Перем Сторож;                  // СторожЗаполненияПула — уведомление о росте заполнения
Перем ПространствоИмён;        // ПространствоИмён
Перем ОбразецПула;             // Пул (данные), несохраняемый носитель словаря типов
Перем Настройки;               // СервисНастроек (настройки), опционален
Перем Издатель;                // ИздательСобытий (события) — аудит смены основного пула
Перем ИменаЖурнала;            // ИмяОбъектаАудита (аудит) — вид объекта в журнале
Перем СидОсновногоПула;        // Строка - имя пула, который станет основным на хабе без основного

// Создаёт пул. Имя канонизируется; дубль имени, зарезервированное имя, некорректный тип
// или видимость и непринятая квота — исключение.
//
// Параметры:
//  Имя - Строка - имя пула.
//  Тип - Строка - user или custom (необязательный, по умолчанию "custom").
//  Видимость - Строка - public или private (необязательный, по умолчанию "public").
//  ВладелецИдентификатор - Число - владелец, 0 — системный (необязательный, по умолчанию 0).
//  КвотаМб - Число - квота хранилища: -1 — как в хабе, 0 — без ограничения
//            (необязательный, по умолчанию -1).
//
// Возвращаемое значение:
//  Пул - созданный пул.
//
Функция СоздатьПул(Знач Имя, Знач Тип = "custom", Знач Видимость = "public",
	Знач ВладелецИдентификатор = 0, Знач КвотаМб = -1) Экспорт

	Возврат Завести(Имя, Тип, Видимость, ВладелецИдентификатор, КвотаМб, "");

КонецФункции

// Создаёт личное пространство пользователя: пул типа user с именем-логином. Отдельная
// операция, потому что имя такого пула совпадает с логином владельца и общая проверка
// «имя пула не занято логином» отвергла бы его. Личный пул всегда публичен: приватным
// он превратил бы хаб в бесплатное закрытое хранилище для любого зарегистрировавшегося,
// поэтому параметра видимости у операции нет.
//
// Параметры:
//  Логин - Строка - логин владельца, он же имя пула.
//  ВладелецИдентификатор - Число - идентификатор пользователя-владельца.
//
// Возвращаемое значение:
//  Пул - созданный личный пул.
//
Функция СоздатьЛичныйПул(Знач Логин, Знач ВладелецИдентификатор) Экспорт
	Возврат Завести(Логин, ТипЛичный(), "public", ВладелецИдентификатор, Квоты.КакВХабе(), Логин);
КонецФункции

// Проверяет, разрешены ли в этом хабе личные пулы (настройка oshub.pools.personal_enabled).
// Выключение прекращает авто-создание личного пространства при регистрации и запрещает
// заводить пулы типа user вручную; снос уже существующих — дело перехода настройки, а не
// этого предиката. Значение спрашивается на каждый вызов: правка из UI действует сразу.
//
// Возвращаемое значение:
//  Булево - Истина, если личные пулы разрешены.
//
Функция ЛичныеПулыРазрешены() Экспорт

	Если Настройки = Неопределено Тогда
		Возврат Истина; // контейнер без модуля настройки: то же значение, что дефолт реестра
	КонецЕсли;

	Попытка
		Возврат Настройки.Значение("oshub.pools.personal_enabled") = Истина;
	Исключение
		// нечитаемая настройка не должна закрывать регистрацию: продуктовая опция, не гейт
		Возврат Истина;
	КонецПопытки;

КонецФункции

Функция Завести(Знач Имя, Знач Тип, Знач Видимость, Знач ВладелецИдентификатор, Знач КвотаМб,
	Знач СвойЛогин)

	КаноническоеИмя = Правила.Канонизировать(Имя);

	НормТип = НРег(СокрЛП(Строка(Тип)));
	Если ДопустимыеТипы().Найти(НормТип) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"Некорректный тип пула ""%1"": ожидается %2", Тип, СтрСоединить(ДопустимыеТипы(), ", "));
	КонецЕсли;

	Если Видимость <> "public" И Видимость <> "private" Тогда
		ВызватьИсключение СтрШаблон(
			"Некорректная видимость пула ""%1"": ожидается public или private", Видимость);
	КонецЕсли;

	Если НормТип = ТипЛичный() И Видимость <> "public" Тогда
		ВызватьИсключение
			"Личный пул приватным быть не может (решение В-5): личное пространство"
			+ " раздаётся автоматически, и приватным оно превратило бы хаб в личное"
			+ " закрытое хранилище для любого зарегистрировавшегося";
	КонецЕсли;

	Если НормТип = ТипЛичный() И НЕ ЛичныеПулыРазрешены() Тогда
		ВызватьИсключение
			"Пользовательские (личные) пулы отключены настройкой хаба"
			+ " oshub.pools.personal_enabled: пул типа user завести нельзя";
	КонецЕсли;

	ПроверитьКвотуИлиИсключение(КвотаМб);

	Если Правила.ИмяПулаЗарезервировано(КаноническоеИмя) Тогда
		ВызватьИсключение СтрШаблон(
			"Имя пула ""%1"" зарезервировано под системный маршрут и недопустимо (зарезервированы: %2)",
			КаноническоеИмя, СтрСоединить(Правила.ЗарезервированныеИменаПулов(), ", "));
	КонецЕсли;

	Если НайтиПул(КаноническоеИмя) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон("Пул с именем ""%1"" уже существует", КаноническоеИмя);
	КонецЕсли;

	ПространствоИмён.ПроверитьСвободноДляПула(КаноническоеИмя, СвойЛогин);

	Пул = ХранилищеПулов.СоздатьЭлемент();
	Пул.Имя = КаноническоеИмя;
	Пул.Тип = НормТип;
	Пул.Видимость = Видимость;
	Пул.ВладелецИдентификатор = ВладелецИдентификатор;
	Пул.КвотаМб = Цел(КвотаМб);
	Пул.ЗанятоБайт = 0;
	Пул.НастройкиJSON = "";
	Пул.Создан = ТекущаяУниверсальнаяДата();
	Пул.ПубликацияРазрешена = Истина;
	Пул.ПоУмолчанию = Ложь;
	Пул.Сохранить();

	ОбеспечитьОсновнойПул();

	Возврат Пул;

КонецФункции

// Возвращает допустимые типы пула. Словарь принадлежит сущности Пул, а не сервису.
//
// Возвращаемое значение:
//  Массив из Строка - user, custom.
//
Функция ДопустимыеТипы() Экспорт
	Возврат СловарьТипов().ДопустимыеТипы();
КонецФункции

// Возвращает тип личного пула пользователя.
//
// Возвращаемое значение:
//  Строка - имя типа.
//
Функция ТипЛичный() Экспорт
	Возврат СловарьТипов().ТипПользователя();
КонецФункции

// Создаётся лениво: на этапе сборки контейнера обращаться к менеджеру сущностей рано.
Функция СловарьТипов()
	Если ОбразецПула = Неопределено Тогда
		ОбразецПула = ХранилищеПулов.СоздатьЭлемент();
	КонецЕсли;
	Возврат ОбразецПула;
КонецФункции

// Возвращает основной пул хаба — носитель признака ПоУмолчанию, тот, что обслуживает
// короткие адреса /download, /push и /dev-channel.
//
// Возвращаемое значение:
//  Пул, Неопределено - основной пул либо Неопределено, если он не назначен.
//
// Носитель ищется обходом всей таблицы, а не отбором: у пустого хаба таблицы пулов ещё
// нет на диске, и отбор по колонке на ней падает, а выборка без отбора отдаёт пустой
// список. Короткие адреса обязаны отвечать объяснением, а не 500.
Функция ДефолтныйПул() Экспорт

	Для Каждого Пул Из ВсеПулы() Цикл
		Если Пул.ЭтоДефолтный() Тогда
			Возврат Пул;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Возвращает имя основного пула хаба.
//
// Возвращаемое значение:
//  Строка - имя основного пула либо "", если он не назначен.
//
Функция ИмяПулаПоУмолчанию() Экспорт
	Пул = ДефолтныйПул();
	Возврат ?(Пул = Неопределено, "", Строка(Пул.Имя));
КонецФункции

// Назначает пул основным пулом хаба: снимает признак с прежнего носителя и переносит
// на новый инварианты основного пула — публичность и запрет удаления. Носитель признака
// на хабе ровно один, исключительность держится здесь. Личное пространство пользователя,
// приватный и неизвестный пул — исключение.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Кем - Строка - принципал для аудита (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Пул - пул, ставший основным.
//
Функция НазначитьПулПоУмолчанию(Знач ПулИдентификатор, Знач Кем = "") Экспорт

	Целевой = ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(ПулИдентификатор);
	Если Целевой = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Пул с идентификатором %1 не найден", ПулИдентификатор);
	КонецЕсли;

	Если Целевой.ЭтоЛичный() Тогда
		ВызватьИсключение СтрШаблон(
			"Пул ""%1"" — личное пространство пользователя и основным пулом хаба быть не может:"
			+ " короткие адреса /download и /push обслуживают общий пул, а личное пространство"
			+ " раздаётся автоматически каждому зарегистрировавшемуся", Целевой.Имя);
	КонецЕсли;

	// Публичность не навязывается назначением: иначе один клик раскрыл бы анониму всё
	// содержимое приватного пула. Инвариант держится отказом — основной пул публичен всегда.
	Если НРег(СокрЛП(Строка(Целевой.Видимость))) <> "public" Тогда
		ВызватьИсключение СтрШаблон(
			"Пул ""%1"" приватный, а основной пул хаба всегда публичен: назначение не раскрывает"
			+ " приватный пул молча. Сделайте пул публичным в его настройках, затем назначайте"
			+ " основным", Целевой.Имя);
	КонецЕсли;

	Прежний = ДефолтныйПул();
	Если Прежний <> Неопределено И Прежний.Идентификатор = Целевой.Идентификатор Тогда
		Возврат Целевой; // идемпотентность: назначение того же пула ничего не меняет
	КонецЕсли;

	// сначала снимается прежний носитель: два признака одновременно не живут даже мгновение
	Для Каждого Пул Из ВсеПулы() Цикл
		Если Пул.ЭтоДефолтный() И Пул.Идентификатор <> Целевой.Идентификатор Тогда
			Пул.ПоУмолчанию = Ложь;
			Пул.Сохранить();
		КонецЕсли;
	КонецЦикла;

	Целевой.ПоУмолчанию = Истина;
	Целевой.Сохранить();

	ЗаписатьВАудит(Целевой, Прежний, Кем);

	Возврат Целевой;

КонецФункции

// Назначает основной пул хаба, если он ещё не назначен: берётся пул с именем из детальки
// oshub.pools.default. Идемпотентна — уже назначенный основной пул не перебивается.
//
// Возвращаемое значение:
//  Пул, Неопределено - назначенный пул либо Неопределено, если назначать было нечего.
//
Функция ОбеспечитьОсновнойПул() Экспорт

	Если ДефолтныйПул() <> Неопределено ИЛИ НЕ ЗначениеЗаполнено(СидОсновногоПула) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Кандидат = НайтиПул(СидОсновногоПула);
	Если Кандидат = Неопределено ИЛИ Кандидат.ЭтоЛичный()
		ИЛИ НРег(СокрЛП(Строка(Кандидат.Видимость))) <> "public" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат НазначитьПулПоУмолчанию(Кандидат.Идентификатор, "");

КонецФункции

// Имя пула, которым засеивается основной пул хаба, пока основной не назначен.
//
// Возвращаемое значение:
//  Строка - имя пула из детальки oshub.pools.default; "" — сид не задан.
//
Функция ИмяСидаОсновногоПула() Экспорт
	Возврат СидОсновногоПула;
КонецФункции

// Событие мутации: аудит собирается подписчиком, поля нагрузки готовит производитель.
Процедура ЗаписатьВАудит(Знач Целевой, Знач Прежний, Знач Кем)

	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Детали = Новый Структура("было, стало",
		?(Прежний = Неопределено, "", Строка(Прежний.Имя)), Строка(Целевой.Имя));
	ЗаписьJSON = Новый ЗаписьJSON();
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Детали);

	Данные = Новый Структура();
	Данные.Вставить("Кто", ?(ЗначениеЗаполнено(Кем), Строка(Кем), ИменаЖурнала.Система()));
	Данные.Вставить("Действие", "пул.основной.назначен");
	Данные.Вставить("Объект", ИменаЖурнала.ПулПоИмени(Целевой.Имя));
	Данные.Вставить("ДеталиJSON", ЗаписьJSON.Закрыть());
	Данные.Вставить("АдресIP", "");

	Попытка
		Издатель.Опубликовать(Издатель.ТипОсновнойПулНазначен(), Данные);
	Исключение
		// журнал вторичен: назначение уже состоялось и откату не подлежит
	КонецПопытки;

КонецПроцедуры

// Удаляет пул вместе со всем его содержимым: доступами, ключами, подписками, зеркалами,
// апстримами, незакрытыми заявками, файлами хранилища и пакетами с версиями.
// Основной пул хаба неудаляем:
// по его адресу обслуживается /download. Неизвестный и основной пул — исключение.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор удаляемого пула.
//
Процедура УдалитьПул(Знач ПулИдентификатор) Экспорт

	Пул = ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(ПулИдентификатор);
	Если Пул = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Пул с идентификатором %1 не найден", ПулИдентификатор);
	КонецЕсли;

	Если Пул.ЭтоДефолтный() Тогда
		ВызватьИсключение СтрШаблон(
			"Пул ""%1"" — основной пул хаба и не может быть удалён: по его адресу"
			+ " обслуживается /download (контракт opm). Назначьте основным другой пул,"
			+ " тогда этот освободится", Пул.Имя);
	КонецЕсли;

	Уборка.ОчиститьСодержимое(Пул);
	Пул.Удалить();

КонецПроцедуры

// Меняет тип пула. Приватный пул, пул с апстримами и основной пул хаба не становятся
// личными — иначе структурные запреты типа user обходились бы сменой типа. Нарушение
// любого инварианта — исключение.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  НовыйТип - Строка - user или custom.
//
// Возвращаемое значение:
//  Пул - обновлённый пул.
//
Функция УстановитьТип(Знач ПулИдентификатор, Знач НовыйТип) Экспорт

	Пул = ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(ПулИдентификатор);
	Если Пул = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Пул с идентификатором %1 не найден", ПулИдентификатор);
	КонецЕсли;

	Норм = НРег(СокрЛП(Строка(НовыйТип)));
	Если ДопустимыеТипы().Найти(Норм) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"Некорректный тип пула ""%1"": ожидается %2", НовыйТип, СтрСоединить(ДопустимыеТипы(), ", "));
	КонецЕсли;

	Если Норм = ТипЛичный() И Пул.ЭтоДефолтный() Тогда
		ВызватьИсключение СтрШаблон(
			"Пул ""%1"" — основной пул хаба и личным быть не может: сначала назначьте"
			+ " основным другой пул", Пул.Имя);
	КонецЕсли;
	Если Норм = ТипЛичный() И НЕ ЛичныеПулыРазрешены() Тогда
		ВызватьИсключение
			"Пользовательские (личные) пулы отключены настройкой хаба"
			+ " oshub.pools.personal_enabled: сделать пул личным нельзя";
	КонецЕсли;
	Если Норм = ТипЛичный() И НРег(СокрЛП(Строка(Пул.Видимость))) <> "public" Тогда
		ВызватьИсключение СтрШаблон(
			"Пул ""%1"" приватный и не может стать личным: личный пул всегда публичен (В-5)",
			Пул.Имя);
	КонецЕсли;
	Если Норм = ТипЛичный() И АпстримыПула(ПулИдентификатор).Количество() > 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Пул ""%1"" имеет апстримы и не может стать личным: у пулов типа user апстримов"
			+ " не бывает структурно", Пул.Имя);
	КонецЕсли;

	Пул.Тип = Норм;
	Пул.Сохранить();
	Возврат Пул;

КонецФункции

// Ищет пул по имени; регистр не значим.
//
// Параметры:
//  Имя - Строка - имя пула в любом регистре.
//
// Возвращаемое значение:
//  Пул, Неопределено - найденный пул.
//
Функция НайтиПул(Знач Имя) Экспорт
	Возврат ХранилищеПулов.ПолучитьОдноПоИмяРавно(НРег(СокрЛП(Имя)));
КонецФункции

// Возвращает пул по имени; отсутствие пула — исключение.
//
// Параметры:
//  Имя - Строка - имя пула в любом регистре.
//
// Возвращаемое значение:
//  Пул - найденный пул.
//
Функция ПолучитьПул(Знач Имя) Экспорт

	Пул = НайтиПул(Имя);
	Если Пул = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Пул ""%1"" не найден", Имя);
	КонецЕсли;
	Возврат Пул;

КонецФункции

// Возвращает пул по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Пул, Неопределено - найденный пул.
//
Функция ПулПоИдентификатору(Знач Идентификатор) Экспорт
	Возврат ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Возвращает пулы заданного типа.
//
// Параметры:
//  Тип - Строка - default, user или custom.
//
// Возвращаемое значение:
//  Массив из Пул - пулы указанного типа.
//
Функция ПулыПоТипу(Знач Тип) Экспорт
	Возврат ХранилищеПулов.ПолучитьПоТипРавно(Тип);
КонецФункции

// Возвращает все пулы хаба. Порядок не гарантируется.
//
// Возвращаемое значение:
//  Массив из Пул - все пулы.
//
Функция ВсеПулы() Экспорт
	Возврат ХранилищеПулов.Все();
КонецФункции

// Возвращает значение булева флага пула из Пул.НастройкиJSON.
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//  ИмяФлага - Строка - имя флага.
//  ЗначениеПоУмолчанию - Булево - значение, если флаг не задан или пул не передан
//                        (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Булево - значение флага.
//
Функция Флаг(Знач Пул, Знач ИмяФлага, Знач ЗначениеПоУмолчанию = Ложь) Экспорт
	Если Пул = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат Пул.Флаг(ИмяФлага, ЗначениеПоУмолчанию);
КонецФункции

// Устанавливает булев флаг пула и сохраняет пул; неизвестный пул — исключение.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  ИмяФлага - Строка - имя флага.
//  Значение - Булево - новое значение.
//
// Возвращаемое значение:
//  Пул - обновлённый пул.
//
Функция УстановитьФлаг(Знач ПулИдентификатор, Знач ИмяФлага, Знач Значение) Экспорт

	Пул = ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(ПулИдентификатор);
	Если Пул = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Пул с идентификатором %1 не найден", ПулИдентификатор);
	КонецЕсли;

	Пул.УстановитьФлаг(ИмяФлага, Значение);
	Пул.Сохранить();

	Возврат Пул;

КонецФункции

// Устанавливает видимость пула. Основной пул хаба и личный пул приватными быть не могут;
// недопустимое значение и неизвестный пул — исключение.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Видимость - Строка - public либо private.
//
// Возвращаемое значение:
//  Пул - обновлённый пул.
//
Функция УстановитьВидимость(Знач ПулИдентификатор, Знач Видимость) Экспорт

	Проблема = ПроблемаВидимости(ПулИдентификатор, Видимость);
	Если ЗначениеЗаполнено(Проблема) Тогда
		ВызватьИсключение Проблема;
	КонецЕсли;

	Пул = ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(ПулИдентификатор);
	Пул.Видимость = НРег(СокрЛП(Строка(Видимость)));
	Пул.Сохранить();
	Возврат Пул;

КонецФункции

// Судит смену видимости, ничего не меняя: вызывающий, который правит видимость вместе
// с другим свойством, обязан рассудить весь ввод до первой записи — иначе отказ второй
// операции оставит первую применённой.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Видимость - Строка - public либо private.
//
// Возвращаемое значение:
//  Строка - причина отказа; "" — смена допустима.
//
Функция ПроблемаВидимости(Знач ПулИдентификатор, Знач Видимость) Экспорт

	Норм = НРег(СокрЛП(Строка(Видимость)));
	Если Норм <> "public" И Норм <> "private" Тогда
		Возврат СтрШаблон("Недопустимая видимость пула ""%1"": ожидается public или private", Видимость);
	КонецЕсли;

	Пул = ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(ПулИдентификатор);
	Если Пул = Неопределено Тогда
		Возврат СтрШаблон("Пул с идентификатором %1 не найден", ПулИдентификатор);
	КонецЕсли;

	Если Пул.ЭтоДефолтный() И Норм <> "public" Тогда
		Возврат СтрШаблон(
			"Пул ""%1"" — основной пул хаба и всегда публичен: по его адресу обслуживается"
			+ " /download (контракт opm). Назначьте основным другой пул, тогда этот"
			+ " можно будет закрыть", Пул.Имя);
	КонецЕсли;

	Если Пул.ЭтоЛичный() И Норм <> "public" Тогда
		Возврат СтрШаблон(
			"Пул ""%1"" — личное пространство пользователя и приватным быть не может"
			+ " (решение В-5)", Пул.Имя);
	КонецЕсли;

	Возврат "";

КонецФункции

// Возвращает потолок дисковой квоты пула. Величина выше него теряет точность
// в арифметике сверки занятого объёма, поэтому не принимается ни формой, ни API.
//
// Возвращаемое значение:
//  Число - наибольшая допустимая квота, МБ.
//
Функция ПредельнаяКвотаМб() Экспорт
	Возврат Квоты.ПредельнаяМб();
КонецФункции

// Причина отказа: значение не является допустимым числом мегабайт.
//
// Возвращаемое значение:
//  Строка - код причины.
//
Функция ПричинаКвотаЧисло() Экспорт
	Возврат Квоты.ПричинаЧисло();
КонецФункции

// Причина отказа: квота выше потолка.
//
// Возвращаемое значение:
//  Строка - код причины.
//
Функция ПричинаКвотаПотолок() Экспорт
	Возврат Квоты.ПричинаПотолок();
КонецФункции

// Судит уже разобранную квоту до записи.
//
// Параметры:
//  КвотаМб - Число, Неопределено - квота в МБ; Неопределено — значение не разобрано.
//
// Возвращаемое значение:
//  Структура - Ок (Булево), Квота (Число), Причина (Строка: "" либо код причины отказа).
//
Функция ПроверитьКвоту(Знач КвотаМб) Экспорт
	Возврат Квоты.Проверить(КвотаМб);
КонецФункции

// Читает сырое значение квоты и судит его — единственный вход правила для формы раздела
// «Пулы», дома настроек пула, REST-API и создания пула.
//
// Параметры:
//  Сырое - Произвольный - значение поля квоты, как оно пришло снаружи.
//
// Возвращаемое значение:
//  Структура - Ок (Булево), Квота (Число), Причина (Строка: "" либо код причины отказа).
//
Функция РассудитьКвоту(Знач Сырое) Экспорт
	Возврат Квоты.Рассудить(Сырое);
КонецФункции

// Действующая квота пула: своя, если задана, иначе квота хаба по умолчанию.
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Число - МБ; 0 — без ограничения.
//
Функция ЭффективнаяКвотаМб(Знач Пул) Экспорт
	Возврат Квоты.ЭффективнаяМб(Пул);
КонецФункции

// Действующая квота пула в байтах.
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Число - байты; 0 — без ограничения.
//
Функция ЭффективнаяКвотаБайт(Знач Пул) Экспорт
	Возврат Квоты.ЭффективнаяБайт(Пул);
КонецФункции

// Значение квоты, означающее «как в хабе».
//
// Возвращаемое значение:
//  Число.
//
Функция КвотаКакВХабе() Экспорт
	Возврат Квоты.КакВХабе();
КонецФункции

// Занятое пулом место — всё, что лежит в хранилище под этим пулом.
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Число - байты.
//
Функция ЗанятоБайт(Знач Пул) Экспорт
	Возврат Объёмы.ЗанятоБайт(Пул);
КонецФункции

// Устанавливает дисковую квоту пула. Непринятая квота и неизвестный пул — исключение.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  КвотаМб - Число - квота в МБ: -1 — как в хабе, 0 — без ограничения.
//
// Возвращаемое значение:
//  Пул - обновлённый пул.
//
Функция УстановитьКвоту(Знач ПулИдентификатор, Знач КвотаМб) Экспорт

	Вердикт = ПроверитьКвотуИлиИсключение(КвотаМб);

	Пул = ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(ПулИдентификатор);
	Если Пул = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Пул с идентификатором %1 не найден", ПулИдентификатор);
	КонецЕсли;

	КвотаДоБайт = Квоты.ЭффективнаяБайт(Пул);
	// Смена квоты в хранилище НЕ ходит: назначение предела — операция админа над строкой
	// пула, и на бэкенде, где замер дорог или недоступен, она обязана проходить. Счётчик
	// ведут дельты писателей и плановая сверка.
	Пул.КвотаМб = Вердикт.Квота;
	Пул.Сохранить();
	// Урезание квоты поднимает процент заполнения, не трогая занятое, — подписки должны
	// узнать об этом ровно так же, как о росте пула.
	Если Сторож <> Неопределено Тогда
		Сторож.ПослеСменыКвоты(Пул, КвотаДоБайт, Квоты.ЭффективнаяБайт(Пул));
	КонецЕсли;
	Возврат Пул;

КонецФункции

// Инвариант квоты держит сервис: мимо него значение в базу не попадает ни одним путём.
Функция ПроверитьКвотуИлиИсключение(Знач КвотаМб)

	Вердикт = ПроверитьКвоту(КвотаМб);
	Если НЕ Вердикт.Ок Тогда
		ВызватьИсключение СтрШаблон(
			"Недопустимая квота ""%1"": ожидается целое число МБ от 0 до %2",
			КвотаМб, ПредельнаяКвотаМб());
	КонецЕсли;
	Возврат Вердикт;

КонецФункции

// Первый желудь необязательной коллекции либо Неопределено, если желудя в контейнере нет.
Функция Первый(Знач Коллекция)
	Возврат ?(Коллекция = Неопределено ИЛИ Коллекция.Количество() = 0, Неопределено, Коллекция[0]);
КонецФункции

// Проверяет, принимает ли пул публикации. Отсутствующий пул — Ложь (fail-closed).
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Булево - Истина, если публикация разрешена.
//
Функция ПубликацияРазрешена(Знач Пул) Экспорт
	Если Пул = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Пул.ПубликацияРазрешена = Истина;
КонецФункции

// Разрешает или запрещает публикацию в пул; неизвестный пул — исключение.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Значение - Булево - разрешена ли публикация.
//
// Возвращаемое значение:
//  Пул - обновлённый пул.
//
Функция УстановитьПубликациюРазрешена(Знач ПулИдентификатор, Знач Значение) Экспорт

	Пул = ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(ПулИдентификатор);
	Если Пул = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Пул с идентификатором %1 не найден", ПулИдентификатор);
	КонецЕсли;

	Пул.ПубликацияРазрешена = (Значение = Истина);
	Пул.Сохранить();
	Возврат Пул;

КонецФункции

// Добавляет апстрим пулу или обновляет уже заведённый с тем же URL. Новый апстрим встаёт
// последним в порядке опроса. Личному пулу апстрим завести нельзя; неразбираемый адрес,
// неудачная проба подключения, некорректный allowlist и отрицательный TTL — исключение.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Url - Строка - базовый URL выдачи апстрима (контракт opm).
//  ВремяЖизниСек - Число - TTL кэша изменяемых ресурсов, сек (необязательный,
//                  по умолчанию 900).
//  СписокРазрешенийJSON - Строка - allowlist как JSON-массив масок, пусто — без
//                         ограничений (необязательный, по умолчанию "").
//  РазрешитьПриватные - Булево - не используется: сеть, в которой живёт источник, хаб
//                       не судит. Параметр сохранён ради вызывающих (необязательный,
//                       по умолчанию Ложь).
//  Токен - Строка - токен доступа к приватной выдаче источника. Пустое значение и маска
//          оставляют прежний токен, поэтому правка TTL заводить его заново не требует
//          (необязательный, по умолчанию "").
//  СнятьТокен - Булево - записать источник без токена: он проверяется и опрашивается
//               анонимно. Старше поля Токен (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  АпстримПула - сохранённая запись апстрима.
//
Функция ДобавитьАпстрим(Знач ПулИдентификатор, Знач Url, Знач ВремяЖизниСек = 900,
	Знач СписокРазрешенийJSON = "", Знач РазрешитьПриватные = Ложь, Знач Токен = "",
	Знач СнятьТокен = Ложь) Экспорт

	Пул = ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(ПулИдентификатор);
	Если Пул = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Пул с идентификатором %1 не найден", ПулИдентификатор);
	КонецЕсли;

	ПроверитьТипДопускаетАпстримы(Пул);
	ПроверитьПараметрыАпстрима(Url, ВремяЖизниСек, СписокРазрешенийJSON);

	Существующие = АпстримыПула(ПулИдентификатор);
	Апстрим = Порядок_.НайтиПоАдресу(Существующие, Url);

	// проба идёт тем доступом, с которым источник будет опрашиваться дальше, и запись
	// происходит только после неё: полуснятого токена при неудачной пробе не бывает
	ТокенЗаписи = ?(СнятьТокен = Истина, "",
		Секрет.ПринятьВвод(Токен, Секрет.ИзИсточника(Апстрим)));
	ПроверитьПодключение(Url, ТокенЗаписи);

	Если Апстрим = Неопределено Тогда
		Апстрим = ХранилищеАпстримов.СоздатьЭлемент();
		Апстрим.ПулИдентификатор = ПулИдентификатор;
		Апстрим.Порядок = Порядок_.Следующая(Существующие);
		Апстрим.Включён = Истина;
	КонецЕсли;

	ЗаписатьАпстрим(Апстрим, Url, ВремяЖизниСек, СписокРазрешенийJSON, ТокенЗаписи);
	Возврат Апстрим;

КонецФункции

// Снимает токен доступа с апстрима: источник возвращается к анонимному чтению.
// Идемпотентна — снятие у источника без токена ничего не меняет.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Url - Строка - базовый URL апстрима.
//
// Возвращаемое значение:
//  Булево - Истина, если апстрим найден.
//
Функция СнятьТокенАпстрима(Знач ПулИдентификатор, Знач Url) Экспорт

	Апстрим = Порядок_.НайтиПоАдресу(АпстримыПула(ПулИдентификатор), Url);
	Если Апстрим = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Апстрим.ТокенДоступа = "";
	Апстрим.Сохранить();
	Возврат Истина;

КонецФункции

// Включает либо выключает апстрим пула, не удаляя его. Идемпотентна: повторный вызов
// с тем же значением ничего не меняет. Неизвестный адрес — Ложь.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Url - Строка - базовый URL апстрима.
//  Включён - Булево - опрашивать ли апстрим.
//
// Возвращаемое значение:
//  Булево - Истина, если апстрим найден.
//
Функция ПереключитьАпстрим(Знач ПулИдентификатор, Знач Url, Знач Включён) Экспорт

	Апстрим = Порядок_.НайтиПоАдресу(АпстримыПула(ПулИдентификатор), Url);
	Если Апстрим = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Новое = (Включён = Истина);
	Если (Апстрим.Включён = Истина) <> Новое Тогда
		Апстрим.Включён = Новое;
		Апстрим.Сохранить();
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Возвращает апстримы пула в порядке опроса: первый ответивший выигрывает.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из АпстримПула - апстримы в порядке обхода.
//
Функция АпстримыПула(Знач ПулИдентификатор) Экспорт
	Возврат ХранилищеАпстримов.АпстримыУпорядоченно(ПулИдентификатор);
КонецФункции

// Возвращает апстримы, которые выдаче разрешено опрашивать: включённые, в порядке обхода.
// У пула, которому апстримы недопустимы по типу, список пуст независимо от содержимого
// таблицы — вторая опора структурного запрета: строка, легшая в базу мимо сервисного слоя,
// исходящим запросом не становится.
//
// Параметры:
//  Пул - Пул, Неопределено - пул, для которого идёт выдача.
//
// Возвращаемое значение:
//  Массив из АпстримПула - включённые апстримы в порядке обхода.
//
Функция АпстримыДляОпроса(Знач Пул) Экспорт

	Если Пул = Неопределено ИЛИ НЕ Пул.АпстримыДопустимы() Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Результат = Новый Массив();
	Для Каждого Апстрим Из АпстримыПула(Пул.Идентификатор) Цикл
		Если Апстрим.Включён = Истина Тогда
			Результат.Добавить(Апстрим);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Удаляет апстрим пула по URL и перенумеровывает оставшиеся, сохраняя порядок опроса.
// Идемпотентна: удаление отсутствующего URL ничего не меняет.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Url - Строка - базовый URL удаляемого апстрима.
//
// Возвращаемое значение:
//  Булево - Истина, если апстрим был найден и удалён.
//
Функция УдалитьАпстрим(Знач ПулИдентификатор, Знач Url) Экспорт

	Апстримы = АпстримыПула(ПулИдентификатор);
	Удаляемый = Порядок_.НайтиПоАдресу(Апстримы, Url);
	Если Удаляемый = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Удаляемый.Удалить();
	Порядок_.Перенумеровать(АпстримыПула(ПулИдентификатор));
	Возврат Истина;

КонецФункции

// Перемещает апстрим на заданную позицию в порядке опроса. Позиция за пределами списка
// прижимается к границе, нумерация остаётся плотной. Неизвестный апстрим — исключение.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Url - Строка - базовый URL перемещаемого апстрима.
//  НоваяПозиция - Число - желаемая позиция, 0 — опрашивается первым.
//
// Возвращаемое значение:
//  Массив из АпстримПула - апстримы пула в новом порядке опроса.
//
Функция ПереместитьАпстрим(Знач ПулИдентификатор, Знач Url, Знач НоваяПозиция) Экспорт

	Апстримы = АпстримыПула(ПулИдентификатор);
	Перемещаемый = Порядок_.НайтиПоАдресу(Апстримы, Url);
	Если Перемещаемый = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Апстрим ""%1"" не найден в пуле %2", Url, ПулИдентификатор);
	КонецЕсли;

	Порядок = Новый Массив();
	Для Каждого Апстрим Из Апстримы Цикл
		Если Апстрим.Идентификатор <> Перемещаемый.Идентификатор Тогда
			Порядок.Добавить(Апстрим);
		КонецЕсли;
	КонецЦикла;

	Позиция = Макс(0, Мин(Цел(НоваяПозиция), Порядок.Количество()));
	Порядок.Вставить(Позиция, Перемещаемый);

	Порядок_.Перенумеровать(Порядок);
	Возврат АпстримыПула(ПулИдентификатор);

КонецФункции

// Возвращает пулы, у которых есть хотя бы один апстрим: именно в них живёт прокси-кэш.
//
// Возвращаемое значение:
//  Массив из Пул - пулы с апстримами.
//
Функция ПулыСАпстримами() Экспорт

	Результат = Новый Массив();
	Для Каждого Пул Из ВсеПулы() Цикл
		Если АпстримыПула(Пул.Идентификатор).Количество() > 0 Тогда
			Результат.Добавить(Пул);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает первый по порядку апстрим пула.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  АпстримПула, Неопределено - первый апстрим либо Неопределено.
//
Функция АпстримПула(Знач ПулИдентификатор) Экспорт
	Апстримы = АпстримыПула(ПулИдентификатор);
	Возврат ?(Апстримы.Количество() = 0, Неопределено, Апстримы[0]);
КонецФункции

// Запрет висит на ТИПЕ пула, а не на настройке и не на праве: отключить его нечем.
Процедура ПроверитьТипДопускаетАпстримы(Знач Пул)

	Если Пул.АпстримыДопустимы() Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Пулу ""%1"" нельзя задать апстрим: это личное пространство пользователя (тип ""%2""),"
		+ " а личный пул чужое не проксирует. Запрет структурный — он снимается только сменой"
		+ " типа пула, а не настройкой.", Пул.Имя, Строка(Пул.Тип));

КонецПроцедуры

// Годность адреса доказывает подключение, а не список запретов: разбирается форма строки,
// затем хаб пробует сходить по адресу. Сеть, в которой живёт источник, не судится —
// её выбирает администратор пула. Отсутствие судьи формы не ослабляет проверку,
// а запрещает операцию.
Процедура ПроверитьПараметрыАпстрима(Знач Url, Знач ВремяЖизниСек, Знач СписокРазрешенийJSON)

	Если НЕ ЗначениеЗаполнено(Url) Тогда
		ВызватьИсключение "Не задан URL апстрима пула";
	КонецЕсли;

	Если ВалидаторАдреса = Неопределено Тогда
		ВызватьИсключение
			"Апстрим не может быть заведён: разбор адресов (модуль зеркала) недоступен."
			+ " Неразобранный адрес апстрима принимать нельзя — хаб ходит по нему сам.";
	КонецЕсли;

	Вердикт = ВалидаторАдреса.Проверить(Url);
	Если НЕ Вердикт.Ок Тогда
		ВызватьИсключение СтрШаблон("Апстрим ""%1"" отклонён: %2", Url, Вердикт.Ошибка);
	КонецЕсли;

	Если ВремяЖизниСек < 0 Тогда
		ВызватьИсключение "TTL кэша апстрима не может быть отрицательным";
	КонецЕсли;

	Allowlist.Проверить(СписокРазрешенийJSON);

КонецПроцедуры

// Не подключился — не сохраняем: заведённый источник это тот, по которому хаб уже сходил
// с тем доступом, который у него будет. Контейнер без пробника (юнит-наборы домена)
// заведение не блокирует: ходить нечем.
Процедура ПроверитьПодключение(Знач Url, Знач Токен)

	Если Пробник = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Проба = Пробник.Проверить(Url, Токен);
	Если НЕ Проба.Ок Тогда
		ВызватьИсключение СтрШаблон("К апстриму ""%1"" не удалось подключиться: %2",
			Url, Проба.Причина);
	КонецЕсли;

КонецПроцедуры

// ПоследняяСинхронизация здесь фиксирует момент НАСТРОЙКИ, а не фактического опроса:
// запись в БД на каждый GET горячего пути недопустима. Момент реального опроса ведёт
// ЗеркалоХаба.ПоследнийСинк.
Процедура ЗаписатьАпстрим(Знач Апстрим, Знач Url, Знач ВремяЖизниСек, Знач СписокРазрешенийJSON,
	Знач Токен)

	Апстрим.Url = СокрЛП(Url);
	Апстрим.ВремяЖизниСек = ВремяЖизниСек;
	Апстрим.СписокРазрешенийJSON = ?(ЗначениеЗаполнено(СписокРазрешенийJSON), СписокРазрешенийJSON, "");
	Апстрим.ТокенДоступа = Токен;
	Апстрим.ПоследняяСинхронизация = ТекущаяУниверсальнаяДата();
	Апстрим.Сохранить();

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПулов") _ХранилищеПулов,
	&Пластилин(Значение = "ХранилищеАпстримовПула") _ХранилищеАпстримов,
	&Пластилин(Значение = "УборкаПула") _Уборка,
	&Пластилин(Значение = "ПравилаИменования") _Правила,
	&Пластилин(Значение = "ПространствоИмён") _ПространствоИмён,
	&Пластилин(Значение = "ВалидаторАдресаАпстрима") _ВалидаторАдреса = Неопределено,
	&Пластилин(Значение = "ПробникИсточника", Тип = "Массив") _Пробник,
	&Пластилин(Значение = "СписокРазрешённыхИмён") _Allowlist,
	&Пластилин(Значение = "КвотаПула") _Квоты,
	&Пластилин(Значение = "УчётОбъёмаПула") _Объёмы,
	&Пластилин(Значение = "СторожЗаполненияПула", Тип = "Массив") _Сторож,
	&Пластилин(Значение = "ИздательСобытий", Тип = "Массив") _Издатель,
	&Пластилин(Значение = "ИмяОбъектаАудита") _ИменаЖурнала,
	&Пластилин(Значение = "СервисНастроек", Тип = "Массив") _Настройки,
	&Деталька(Значение = "oshub.pools.default", ЗначениеПоУмолчанию = "public") _СидОсновногоПула = "public",
	&Пластилин(Значение = "СекретИсточника") _Секрет = Неопределено)

	Секрет = ?(_Секрет = Неопределено, Новый СекретИсточника(), _Секрет);
	ХранилищеПулов = _ХранилищеПулов;
	ХранилищеАпстримов = _ХранилищеАпстримов;
	Уборка = _Уборка;
	Правила = _Правила;
	ПространствоИмён = _ПространствоИмён;
	// «= Неопределено» не означает «работает без модуля зеркала»: отсутствующий бин роняет
	// СервисПулов целиком. Ветка Неопределено — защита в глубину, она ЗАПРЕЩАЕТ заводить
	// апстримы, а не разрешает их без проверки.
	ВалидаторАдреса = _ВалидаторАдреса;
	// Пробник живёт в модуле прокси: контейнер без него (юнит-наборы домена) заводит источник
	// без пробы — сходить наружу всё равно нечем.
	Пробник = Первый(_Пробник);
	Allowlist = _Allowlist;
	Порядок_ = Новый ПорядокАпстримов();
	Квоты = _Квоты;
	Объёмы = _Объёмы;
	Сторож = Первый(_Сторож);
	// Массив вместо одного желудя — это способ ОСени выразить необязательную зависимость:
	// у отсутствующего имени коллекция пуста, и желудь собирается, а не роняет контейнер.
	// В контейнере без модуля события смена основного пула не журналируется.
	Издатель = Первый(_Издатель);
	ИменаЖурнала = _ИменаЖурнала;
	// Резолвер настроек тем же швом: контейнер без модуля настройки (юнит-наборы домена)
	// продолжает работать, а опция читается своим дефолтом.
	Настройки = Первый(_Настройки);
	СидОсновногоПула = ?(ЗначениеЗаполнено(_СидОсновногоПула),
		НРег(СокрЛП(Строка(_СидОсновногоПула))), "public");

КонецПроцедуры
