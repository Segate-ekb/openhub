// Плановая сверка занятого места: приводит счётчик каждого пула к замеру его области
// в хранилище. Дельты теряются на сбоях и на гонках, а по счётчику отвергаются публикации
// и рисуются экраны, поэтому расхождение обязано чиниться само.
// Объёмы снимаются ОДНИМ проходом хранилища на всю сверку: замер, пришедший из снимка,
// не знает о публикациях, случившихся во время прохода, — их учтёт следующая сверка.

Перем СервисПулов;  // СервисПулов (реестр)
Перем Объёмы;       // УчётОбъёмаПула (реестр)
Перем Хранилище;    // ХранилищеАртефактов (хранилище) — источник истины о занятом
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Сверяет занятое место всех пулов с их областями в хранилище. Сбой отдельного пула
// логируется и не срывает сверку остальных; неудавшийся замер хранилища срывает её
// целиком и уходит исключением к планировщику — сверять не с чем.
//
// Возвращаемое значение:
//  Структура - ПуловПроверено (Число), ПуловИсправлено (Число), Расхождение (Число —
//              суммарный модуль поправки, байты).
//
Функция Сверить() Экспорт

	Сводка = Новый Структура("ПуловПроверено, ПуловИсправлено, Расхождение", 0, 0, 0);
	Снимок = СнятьОбъёмы();

	Для Каждого Пул Из СервисПулов.ВсеПулы() Цикл

		Попытка
			Было = Объёмы.ЗанятоБайт(Пул);
			Стало = Объёмы.ПринятьЗамер(Пул, ЗамерПула(Снимок, Пул));
			Сводка.ПуловПроверено = Сводка.ПуловПроверено + 1;
			Если Стало <> Было Тогда
				Сводка.ПуловИсправлено = Сводка.ПуловИсправлено + 1;
				Сводка.Расхождение = Сводка.Расхождение + Макс(Стало - Было, Было - Стало);
				Лог.Предупреждение(
					"Сверка объёма пула ""%1"": счётчик разошёлся, было %2 байт, стало %3 байт",
					Пул.Имя, Было, Стало);
			КонецЕсли;
		Исключение
			Лог.Ошибка("Сверка объёма пула ""%1"" прервана ошибкой: %2",
				Пул.Имя, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	Возврат Сводка;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Неудавшийся замер обязан оставить СТРОКУ В ЖУРНАЛЕ, а не только исключение:
// ИсполнительСинхронный ловит исключение обработчика в дескриптор задачи по своему
// контракту, планировщик задачи не логирует, а спан OTel по умолчанию выключен —
// без записи здесь дрейф счётчиков копился бы молча (S3-инсталляция).
Функция СнятьОбъёмы()

	Попытка
		Возврат Хранилище.ОбъёмыПулов();
	Исключение
		Лог.Ошибка("Сверка объёмов пулов прервана: замер хранилища не удался, счётчики"
			+ " оставлены прежними и разойдутся с диском. %1",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

// Пула нет в снимке — под его именем в хранилище ничего не лежит, и это ноль,
// а не повод пропустить пул: разъехавшийся счётчик чинится именно так.
Функция ЗамерПула(Знач Снимок, Знач Пул)
	Значение = Снимок.Получить(Строка(Пул.Имя));
	Возврат ?(Значение = Неопределено, 0, Значение);
КонецФункции

#КонецОбласти

// Параметр _Лог — второй вход для прямого создания вне контейнера ОСени.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "УчётОбъёмаПула") _Объёмы,
	&Пластилин(Значение = "ХранилищеАртефактов") _Хранилище,
	&Лог _Лог = Неопределено)

	СервисПулов = _СервисПулов;
	Объёмы = _Объёмы;
	Хранилище = _Хранилище;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
