// Удаление пакета со всей обвязкой: гранты, подписки, доверие CI, теги, версии, файлы
// и описания. Порядок «сначала обезоружить»: права и подписки уходят первыми.

Перем ХранилищеАртефактов;    // ХранилищеАртефактов (хранилище) — файлы версий
Перем ХранилищеПулов;         // ХранилищеПулов (данные) — имя пула для координат артефакта
Перем ХранилищеПрав;          // ХранилищеПравДоступа (данные)
Перем ХранилищеВебхуков;      // ХранилищеВебхуков (данные) — подписки на объект «пакет»
Перем ХранилищеДоверия;       // ХранилищеДоверияCI (данные)
Перем ХранилищеТегов;         // ХранилищеТегов (данные)
Перем ХранилищеМетокТегов;    // ХранилищеМетокТегов (данные)
Перем ХранилищеВерсий;        // ХранилищеВерсийПакета (данные)
Перем ХранилищеЗависимостей;  // ХранилищеЗависимостей (данные)
Перем ХранилищеМетокВерсий;   // ХранилищеМетокВерсий (данные)
Перем ХранилищеПроисхождения; // ХранилищеПроисхожденияВерсий (данные)
Перем ХранилищеАгрегатов;     // ХранилищеСкачиванийАгрегатов (данные)
Перем ХранилищеОписаний;      // ХранилищеREADME (описания) — необязательно
Перем Объёмы;                 // УчётОбъёмаПула — занятый пулом объём

#Область ПубличныйИнтерфейс

// Удаляет пакет и всё, что на него ссылается.
//
// Параметры:
//  Пакет - Пакет - удаляемый пакет.
//
// Возвращаемое значение:
//  Число - сколько строк удалено, включая сам пакет.
//
Функция УдалитьПакет(Знач Пакет) Экспорт

	Если Пакет = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	ПакетИд = Цел(Пакет.Идентификатор);
	Снято = 0;
	ИмяПула = ИмяПулаПакета(Пакет);

	Снято = Снято + СнятьВсе(ХранилищеПрав.ГрантыНаОбъект(ТипОбъектаПакет(), ПакетИд));
	Снято = Снято + СнятьВсе(ХранилищеВебхуков.ПолучитьПоОбъекту(ТипОбъектаПакет(), ПакетИд));
	Снято = Снято + СнятьВсе(ХранилищеДоверия.ПолучитьПоПакетИдентификаторРавно(ПакетИд));

	Для Каждого Тег Из ХранилищеТегов.ПолучитьПоПакетИдентификаторРавно(ПакетИд) Цикл
		Снято = Снято + СнятьВсе(ХранилищеМетокТегов.ПолучитьПоТегИдентификаторРавно(Тег.Идентификатор));
		Тег.Удалить();
		Снято = Снято + 1;
	КонецЦикла;

	Снято = Снято + СнятьВсе(ХранилищеПроисхождения.ПолучитьПоПакетИдентификаторРавно(ПакетИд));
	Снято = Снято + СнятьВсе(ХранилищеАгрегатов.АгрегатыПакета(ПакетИд));

	Освобождено = 0;
	Для Каждого Версия Из ХранилищеВерсий.ПолучитьПоПакетИдентификаторРавно(ПакетИд) Цикл
		ВерсияИд = Цел(Версия.Идентификатор);
		Освобождено = Освобождено + СнятьАртефакт(ИмяПула, Пакет, Версия);
		Снято = Снято + СнятьВсе(ХранилищеЗависимостей.ПоВерсии(ВерсияИд));
		Снято = Снято + СнятьВсе(ХранилищеМетокВерсий.ПолучитьПоВерсияИдентификаторРавно(ВерсияИд));
		Версия.Удалить();
		Снято = Снято + 1;
	КонецЦикла;

	// до удаления пакета: занятое считается по его пулу, а пул адресуется через пакет
	Объёмы.УчестьПоПакету(ПакетИд, -Освобождено);

	Пакет.Удалить();
	Возврат Снято + 1;

КонецФункции

// Тип объекта «пакет» в таблицах прав и подписок.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТипОбъектаПакет() Экспорт
	Возврат "пакет";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Координаты собираются ИЗ СУЩНОСТЕЙ, а не из строки ПутьВХранилище: та пишется вербатим.
Функция СнятьАртефакт(Знач ИмяПула, Знач Пакет, Знач Версия)

	Если НЕ ЗначениеЗаполнено(ИмяПула) Тогда
		Возврат 0; // пул уже снят — область его хранения снесена целиком
	КонецЕсли;

	Координаты = Новый КоординатыАртефакта(ИмяПула, Строка(Пакет.Имя), Строка(Версия.Версия));
	Освобождается = 0;
	Попытка
		Если ХранилищеАртефактов.Существует(Координаты) Тогда
			Освобождается = Макс(0, Цел(Число(ХранилищеАртефактов.Размер(Координаты))));
		КонецЕсли;
	Исключение
		Освобождается = 0; // не смогли замерить — не списываем вслепую, счётчик починит сверка
	КонецПопытки;

	ХранилищеАртефактов.Удалить(Координаты);
	Возврат Освобождается + СнятьОписание(ИмяПула, Пакет, Версия);

КонецФункции

// Описание версии лежит рядом с её артефактом и уходит вместе с ним: файла нет — ноль.
Функция СнятьОписание(Знач ИмяПула, Знач Пакет, Знач Версия)

	Если ХранилищеОписаний = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ХранилищеОписаний.Снять(ИмяПула, Строка(Пакет.Имя), Строка(Версия.Версия));

КонецФункции

Функция ИмяПулаПакета(Знач Пакет)
	Пул = ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(Цел(Пакет.ПулИдентификатор));
	Возврат ?(Пул = Неопределено, "", Строка(Пул.Имя));
КонецФункции

Функция СнятьВсе(Знач Строки)
	Снято = 0;
	Для Каждого Запись Из Строки Цикл
		Запись.Удалить();
		Снято = Снято + 1;
	КонецЦикла;
	Возврат Снято;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеАртефактов") _ХранилищеАртефактов,
	&Пластилин(Значение = "ХранилищеПулов") _ХранилищеПулов,
	&Пластилин(Значение = "ХранилищеПравДоступа") _ХранилищеПрав,
	&Пластилин(Значение = "ХранилищеВебхуков") _ХранилищеВебхуков,
	&Пластилин(Значение = "ХранилищеДоверияCI") _ХранилищеДоверия,
	&Пластилин(Значение = "ХранилищеТегов") _ХранилищеТегов,
	&Пластилин(Значение = "ХранилищеМетокТегов") _ХранилищеМетокТегов,
	&Пластилин(Значение = "ХранилищеВерсийПакета") _ХранилищеВерсий,
	&Пластилин(Значение = "ХранилищеЗависимостей") _ХранилищеЗависимостей,
	&Пластилин(Значение = "ХранилищеМетокВерсий") _ХранилищеМетокВерсий,
	&Пластилин(Значение = "ХранилищеПроисхожденияВерсий") _ХранилищеПроисхождения,
	&Пластилин(Значение = "ХранилищеСкачиванийАгрегатов") _ХранилищеАгрегатов,
	&Пластилин(Значение = "УчётОбъёмаПула") _Объёмы,
	&Пластилин(Значение = "ХранилищеREADME", Тип = "Массив") _ХранилищеОписаний = Неопределено)

	ХранилищеАртефактов = _ХранилищеАртефактов;
	ХранилищеПулов = _ХранилищеПулов;
	ХранилищеПрав = _ХранилищеПрав;
	ХранилищеВебхуков = _ХранилищеВебхуков;
	ХранилищеДоверия = _ХранилищеДоверия;
	ХранилищеТегов = _ХранилищеТегов;
	ХранилищеМетокТегов = _ХранилищеМетокТегов;
	ХранилищеВерсий = _ХранилищеВерсий;
	ХранилищеЗависимостей = _ХранилищеЗависимостей;
	ХранилищеМетокВерсий = _ХранилищеМетокВерсий;
	ХранилищеПроисхождения = _ХранилищеПроисхождения;
	ХранилищеАгрегатов = _ХранилищеАгрегатов;
	Объёмы = _Объёмы;
	// Массив — способ ОСени выразить необязательную зависимость: контейнер без модуля
	// описаний собирается, пакет удаляется, описаний в нём просто нет.
	ХранилищеОписаний = ?(_ХранилищеОписаний = Неопределено ИЛИ _ХранилищеОписаний.Количество() = 0,
		Неопределено, _ХранилищеОписаний[0]);

КонецПроцедуры
