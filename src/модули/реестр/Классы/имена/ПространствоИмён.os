// Имена пулов и логины делят одно пространство — двусторонняя проверка занятости:
// личное пространство человека — пул, названный его логином.

Перем ХранилищеПулов;  // ХранилищеПулов
Перем Учётки;          // Массив из ЗанятостьИмени (контракт) — кто знает логины учёток
Перем Строки;          // КанонСтроки (основа)

#Область ПубличныйИнтерфейс

// Проверяет, занято ли имя существующим пулом.
//
// Параметры:
//  Имя - Строка - имя в любом регистре.
//
// Возвращаемое значение:
//  Булево - Истина, если такой пул есть.
//
Функция ЗанятоПулом(Знач Имя) Экспорт
	Возврат ХранилищеПулов.ПолучитьОдноПоИмяРавно(Канон(Имя)) <> Неопределено;
КонецФункции

// Проверяет, что имя свободно для пула; занятое логином — исключение.
//
// Параметры:
//  Имя - Строка - предполагаемое имя пула.
//  СвойЛогин - Строка - логин владельца личного пула, совпадение с которым не считается
//              коллизией; берётся из созданной учётки, а не из пользовательского ввода
//              (необязательный, по умолчанию "").
//
Процедура ПроверитьСвободноДляПула(Знач Имя, Знач СвойЛогин = "") Экспорт

	Если ЗначениеЗаполнено(СвойЛогин) И Канон(СвойЛогин) = Канон(Имя) Тогда
		Возврат;
	КонецЕсли;

	Если ЗанятоЛогином(Имя) Тогда
		ВызватьИсключение СтрШаблон(
			"Имя пула ""%1"" занято логином пользователя: личное пространство — пул с именем"
			+ " логина, поэтому это имя закреплено за учёткой. Выберите другое имя пула.", Канон(Имя));
	КонецЕсли;

КонецПроцедуры

// Проверяет, что имя свободно для логина; занятое пулом — исключение.
//
// Параметры:
//  Логин - Строка - предполагаемый логин.
//
Процедура ПроверитьСвободноДляЛогина(Знач Логин) Экспорт

	Если ЗанятоПулом(Логин) Тогда
		ВызватьИсключение СтрШаблон(
			"Логин ""%1"" занят именем пула: личное пространство — пул с именем логина,"
			+ " а пул /pools/%1 уже есть. Выберите другой логин.", Канон(Логин));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Спросить некому — исключение: без ответа учёток «не занято» было бы неправдой.
Функция ЗанятоЛогином(Знач Имя)

	Если Учётки.Количество() = 0 Тогда
		ВызватьИсключение "ПространствоИмён: занято ли имя логином, спросить некому — реализация"
			+ " ЗанятостьИмени (модуль вход) не внедрена";
	КонецЕсли;

	Для Каждого Знающий Из Учётки Цикл
		Если Знающий.ЗанятоЛогином(Канон(Имя)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция Канон(Знач Значение)
	Возврат Строки.Канон(Значение);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПулов") _ХранилищеПулов,
	&Пластилин(Значение = "ЗанятостьИмени", Тип = "Массив") _Учётки = Неопределено,
	&Пластилин(Значение = "КанонСтроки") _Строки = Неопределено)

	Строки = ?(_Строки = Неопределено, Новый КанонСтроки(), _Строки);
	ХранилищеПулов = _ХранилищеПулов;
	Учётки = ?(_Учётки = Неопределено, Новый Массив(), _Учётки);

КонецПроцедуры
