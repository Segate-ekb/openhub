// Валидация и канонизация имён пакетов, пулов и логинов; правила — ospx-tools.
// NFC-нормализация не выполняется (в OneScript нет примитива): имена всё равно ASCII.

#Использовать ospx-tools

// Проверяет корректность имени пакета или пула.
//
// Параметры:
//  Имя - Строка - проверяемое имя.
//
// Возвращаемое значение:
//  Булево - Истина, если имя допустимо.
//
Функция ИмяКорректно(Знач Имя) Экспорт

	Если ТипЗнч(Имя) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ПакетыOspx.ИмяПакетаКорректно(Имя);

КонецФункции

// Проверяет имя; некорректное — исключение с описанием правил именования.
//
// Параметры:
//  Имя - Строка - проверяемое имя.
//
Процедура ПроверитьИмя(Знач Имя) Экспорт

	Если НЕ ИмяКорректно(Имя) Тогда
		ВызватьИсключение ОтказИмени(Имя);
	КонецЕсли;

КонецПроцедуры

// Отказ недопустимому имени: правило именования целиком, а не одно слово «некорректно».
// Этим же текстом отвечают и экран, и API.
//
// Параметры:
//  Имя - Строка - отвергнутое имя.
//
// Возвращаемое значение:
//  Строка - текст отказа.
//
Функция ОтказИмени(Знач Имя) Экспорт
	Возврат СтрШаблон(
		"Некорректное имя ""%1"": допустимы латинские буквы, цифры, ""-"", ""_"", ""."" (первый символ — буква или цифра, длина до 100 символов)",
		Имя);
КонецФункции

// Канонизирует имя: проверка корректности плюс нижний регистр. Канонический вид —
// ключ уникальности. Некорректное имя — исключение.
//
// Параметры:
//  Имя - Строка - имя в любом регистре.
//
// Возвращаемое значение:
//  Строка - каноническое имя.
//
Функция Канонизировать(Знач Имя) Экспорт

	Обрезанное = ?(ТипЗнч(Имя) = Тип("Строка"), СокрЛП(Имя), Имя);
	ПроверитьИмя(Обрезанное);
	Возврат НРег(Обрезанное);

КонецФункции

// Проверяет безопасность URL репозитория: допустимы пустой адрес и абсолютный http/https.
// Прочие схемы (javascript:, data:) дают stored XSS при выводе как href.
//
// Параметры:
//  URL - Строка - адрес репозитория, недоверенное поле манифеста.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес безопасно хранить и выводить.
//
Функция АдресРепозиторияБезопасен(Знач URL) Экспорт
	Если НЕ ЗначениеЗаполнено(URL) Тогда
		Возврат Истина;
	КонецЕсли;
	Схема = СхемаURL(URL);
	Возврат Схема = "http" ИЛИ Схема = "https";
КонецФункции

// Схема адреса в нижнем регистре без двоеточия; управляющие символы и пробелы внутри схемы браузер игнорирует.
Функция СхемаURL(Знач URL)

	Исходный = Строка(URL);
	Очищенный = "";
	Для Поз = 1 По СтрДлина(Исходный) Цикл
		Символ = Сред(Исходный, Поз, 1);
		Если КодСимвола(Символ) > 32 Тогда
			Очищенный = Очищенный + Символ;
		КонецЕсли;
	КонецЦикла;

	Нижний = НРег(Очищенный);
	ПозицияДвоеточия = СтрНайти(Нижний, ":");
	Если ПозицияДвоеточия = 0 Тогда
		Возврат ""; // нет схемы — относительный URL
	КонецЕсли;

	// двоеточие после структурного разделителя — схемы нет ("foo/bar:baz", "?a=b:c")
	Для Поз = 1 По ПозицияДвоеточия - 1 Цикл
		Символ = Сред(Нижний, Поз, 1);
		Если Символ = "/" ИЛИ Символ = "?" ИЛИ Символ = "#" Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	Возврат Лев(Нижний, ПозицияДвоеточия - 1);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
