// Арифметика заполнения пула: процент занятого от квоты, ступень десятка и правило
// «слать ли алерт» — одно на весь хаб, чтобы сторож и доставка судили одинаково.

#Область ПубличныйИнтерфейс

// Процент заполнения пула, округлённый вниз. Без квоты процента не существует.
//
// Параметры:
//  ЗанятоБайт - Число - занятый объём.
//  КвотаБайт - Число - эффективная квота; 0 или меньше — без ограничения.
//
// Возвращаемое значение:
//  Число - целый процент от 0; больше 100, если пул переполнен. Без квоты — 0.
//
Функция Процент(Знач ЗанятоБайт, Знач КвотаБайт) Экспорт

	Квота = Цел(Число(?(КвотаБайт = Неопределено, 0, КвотаБайт)));
	Если Квота <= 0 Тогда
		Возврат 0;
	КонецЕсли;

	Занято = Цел(Число(?(ЗанятоБайт = Неопределено, 0, ЗанятоБайт)));
	Возврат Макс(0, Цел(Занято * 100 / Квота));

КонецФункции

// Ступень десятка, на которой стоит процент: 0, 10, 20 … Ею меряется «есть что сказать»,
// когда пул уже перешагнул порог.
//
// Параметры:
//  Процент - Число - процент заполнения.
//
// Возвращаемое значение:
//  Число - нижняя граница десятка.
//
Функция Ступень(Знач Процент) Экспорт
	Возврат Цел(Макс(0, Цел(Число(Процент))) / 10) * 10;
КонецФункции

// Правило частоты алерта: письмо уходит на пересечении порога и дальше на каждом
// следующем десятке процентов; падение ниже порога снова взводит правило.
//
// Параметры:
//  Порог - Число - порог алерта в процентах.
//  ПроцентДо - Число - заполнение до операции.
//  ПроцентПосле - Число - заполнение после операции.
//
// Возвращаемое значение:
//  Булево - Истина, если подписке с таким порогом пора слать уведомление.
//
Функция НужноСлать(Знач Порог, Знач ПроцентДо, Знач ПроцентПосле) Экспорт

	Граница = Макс(0, Цел(Число(?(Порог = Неопределено, 0, Порог))));
	До = Макс(0, Цел(Число(?(ПроцентДо = Неопределено, 0, ПроцентДо))));
	После = Макс(0, Цел(Число(?(ПроцентПосле = Неопределено, 0, ПроцентПосле))));

	Если После < Граница ИЛИ После <= До Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат До < Граница ИЛИ Ступень(После) > Ступень(До);

КонецФункции

// Наименьший допустимый порог алерта.
//
// Возвращаемое значение:
//  Число - процент.
//
Функция МинимальныйПорог() Экспорт
	Возврат 1;
КонецФункции

// Наибольший допустимый порог алерта.
//
// Возвращаемое значение:
//  Число - процент.
//
Функция МаксимальныйПорог() Экспорт
	Возврат 100;
КонецФункции

// Порог алерта по умолчанию — им заполняется форма подписки.
//
// Возвращаемое значение:
//  Число - процент.
//
Функция ПорогПоУмолчанию() Экспорт
	Возврат 80;
КонецФункции

#КонецОбласти

&Прозвище("ЗаполнениеПула")
&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
