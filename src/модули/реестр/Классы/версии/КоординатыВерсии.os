// Адрес артефакта версии в хранилище — единственное место, где он собирается. Имя пакета — из реестра:
// по нему артефакт пишут, выдают и снимают, в каком бы регистре ни пришло имя в манифесте или адресе.

// Координаты артефакта версии, записанной в реестр.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  Пакет - Пакет - пакет реестра.
//  Версия - ВерсияПакета - версия реестра.
//
// Возвращаемое значение:
//  КоординатыАртефакта - адрес артефакта в хранилище.
//
Функция ДляВерсии(Знач ИмяПула, Знач Пакет, Знач Версия) Экспорт
	Возврат Новый КоординатыАртефакта(ИмяПула, Строка(Пакет.Имя), Строка(Версия.Версия));
КонецФункции

// Координаты артефакта принимаемой версии: пакет, уже заведённый в пуле, задаёт имя своим регистром,
// иначе имя станет именем пакета в реестре таким, каким пришло.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ПакетВРеестре - Пакет, Неопределено - пакет пула с этим именем в любом регистре; Неопределено —
//                  пакета ещё нет.
//  ИмяПакета - Строка - имя пакета, как его прислали (манифест, адрес источника).
//  СтрокаВерсии - Строка - строка версии.
//
// Возвращаемое значение:
//  КоординатыАртефакта - адрес артефакта в хранилище.
//
Функция ДляПриёма(Знач ИмяПула, Знач ПакетВРеестре, Знач ИмяПакета, Знач СтрокаВерсии) Экспорт
	Возврат Новый КоординатыАртефакта(ИмяПула, ИмяВРеестре(ПакетВРеестре, ИмяПакета), СтрокаВерсии);
КонецФункции

// Относительный путь артефакта в хранилище — справка для записи версии.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта.
//
// Возвращаемое значение:
//  Строка - путь вида pools/<пул>/<пакет>/<файл>.
//
Функция ПутьВХранилище(Знач Координаты) Экспорт
	Возврат СтрШаблон("pools/%1/%2/%3", Координаты.Пул(), Координаты.Пакет(), Координаты.ИмяФайла());
КонецФункции

// Имя пакета, под которым его версии лежат в хранилище.
//
// Параметры:
//  ПакетВРеестре - Пакет, Неопределено - пакет пула с этим именем в любом регистре; Неопределено —
//                  пакета ещё нет.
//  ИмяПакета - Строка - имя пакета, как его прислали.
//
// Возвращаемое значение:
//  Строка - имя из реестра, а без пакета — присланное.
//
Функция ИмяВРеестре(Знач ПакетВРеестре, Знач ИмяПакета) Экспорт
	Если ПакетВРеестре = Неопределено Тогда
		Возврат СокрЛП(Строка(ИмяПакета));
	КонецЕсли;
	Возврат Строка(ПакетВРеестре.Имя);
КонецФункции
