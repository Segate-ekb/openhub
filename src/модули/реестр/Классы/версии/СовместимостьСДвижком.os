// Подходит ли версия пакета установленному OneScript: манифест называет минимальную версию
// движка, установка — свою; ограничение, которое не разбирается как версия, не действует.

Перем Сравнитель; // СравнительВерсий

#Область ПубличныйИнтерфейс

// Проверяет, подходит ли версия пакета движку установки.
//
// Параметры:
//  Версия - ВерсияПакета - версия пакета.
//  ВерсияДвижка - Строка - версия OneScript установки; пустая означает «не названа».
//
// Возвращаемое значение:
//  Булево - Истина, если движок не назван, версия ограничения не несёт либо ограничение
//           не старше движка.
//
Функция Подходит(Знач Версия, Знач ВерсияДвижка) Экспорт
	Возврат ТребованиеВыполнено(Версия.ВерсияДвижка, ВерсияДвижка);
КонецФункции

// Пустое, неразбираемое или не старше движка требование выполнено.
Функция ТребованиеВыполнено(Знач Требуемая, Знач ВерсияДвижка)

	Движок = СокрЛП(Строка(ВерсияДвижка));
	Требование = СокрЛП(Строка(Требуемая));
	Если ПустаяСтрока(Движок) ИЛИ ПустаяСтрока(Требование) Тогда
		Возврат Истина;
	КонецЕсли;
	// неразбираемое ограничение не действует, неразбираемый движок отклоняют двери API
	Если НЕ Сравнитель.ВерсияКорректна(Требование) ИЛИ НЕ Сравнитель.ВерсияКорректна(Движок) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Сравнитель.Сравнить(Требование, Движок) <= 0;

КонецФункции

// Отбирает версии, которые подходят движку установки; порядок сохраняется.
//
// Параметры:
//  Версии - Массив из ВерсияПакета - кандидаты.
//  ВерсияДвижка - Строка - версия OneScript установки; пустая означает «не названа».
//
// Возвращаемое значение:
//  Массив из ВерсияПакета - подходящие версии; при пустом движке — все кандидаты.
//
Функция Отобрать(Знач Версии, Знач ВерсияДвижка) Экспорт

	Подходящие = Новый Массив();
	Для Каждого Версия Из Версии Цикл
		Если Подходит(Версия, ВерсияДвижка) Тогда
			Подходящие.Добавить(Версия);
		КонецЕсли;
	КонецЦикла;
	Возврат Подходящие;

КонецФункции

// Проверяет, разбирается ли названная установкой версия движка как версия.
//
// Параметры:
//  ВерсияДвижка - Строка - версия OneScript установки.
//
// Возвращаемое значение:
//  Булево - Истина для пустой строки (движок не назван) и для разбираемой версии.
//
Функция ВерсияКорректна(Знач ВерсияДвижка) Экспорт

	Движок = СокрЛП(Строка(ВерсияДвижка));
	Возврат ПустаяСтрока(Движок) ИЛИ Сравнитель.ВерсияКорректна(Движок);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "СравнительВерсий") _Сравнитель)
	Сравнитель = _Сравнитель;
КонецПроцедуры
