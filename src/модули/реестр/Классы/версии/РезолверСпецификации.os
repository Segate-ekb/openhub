// Единственная лесенка резолва того, что пользователь пишет после «@»: точная версия,
// затем имя тега, затем выражение версии. Ею живут и выдача файла, и резолв по тегу.

Перем СервисВерсий;   // СервисВерсий
Перем СервисТегов;    // СервисТегов
Перем Сравнитель;     // СравнительВерсий
Перем РезолверВерсий; // РезолверВерсий — выбор среди голых строк версий источника
Перем СервисПроисхождения; // СервисПроисхождения — чья версия: своя публикация или привезённая
Перем Перечень;       // ПереченьИсточников (контракт), необязателен — что называют источники пула
Перем Совместимость;  // СовместимостьСДвижком — что подходит установленному OneScript

#Область ПубличныйИнтерфейс

// Разрешает спецификацию версии в конкретную версию пакета. Ступени пробуются по порядку:
// точная строка версии, имя тега, выражение версии. Пустая спецификация означает «версия
// основного тега пакета».
//
// Параметры:
//  Пакет - Пакет, Неопределено - пакет.
//  Спецификация - Строка - точная версия, имя тега либо выражение версии; пустая строка
//                 означает, что клиент условия не назвал.
//  СредиВерсий - Массив из ВерсияПакета, Неопределено - из чего ХАБУ разрешено выбирать;
//                на ступень точной версии не влияет — названная клиентом координата
//                достаётся всегда (необязательный, по умолчанию Неопределено — все версии).
//  ВерсияДвижка - Строка - версия OneScript установки клиента: хаб выбирает только среди
//                 версий, которые ей подходят; на точную версию не влияет (необязательный,
//                 по умолчанию пустая строка — движок не назван).
//
// Возвращаемое значение:
//  Структура - Найдена (Булево), Версия (ВерсияПакета, Неопределено),
//              ВерсиюВыбралХаб (Булево; Ложь только когда клиент назвал точную версию —
//              такой ответ по тому же адресу больше не изменится),
//              ТегНеизвестен (Булево; спецификация записана как имя тега, а тега нет),
//              ВыражениеБитое (Булево; спецификация не разбирается ни как имя тега,
//              ни как выражение версии),
//              ОтсеяноДвижком (Булево; без версии движка версия нашлась бы).
//
Функция Разрешить(Знач Пакет, Знач Спецификация, Знач СредиВерсий = Неопределено,
	Знач ВерсияДвижка = "") Экспорт

	Итог = РазрешитьСредиКруга(Пакет, Спецификация, СредиВерсий, ВерсияДвижка);
	Если ОтсеяноБыДвижком(Итог, ВерсияДвижка) Тогда
		Итог.ОтсеяноДвижком = РазрешитьСредиКруга(Пакет, Спецификация, СредиВерсий, "").Найдена;
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Разрешает версию по имени тега — так читается канальный сегмент пути выдачи.
// Имя не названо — версия основного тега пакета.
//
// Параметры:
//  Пакет - Пакет, Неопределено - пакет.
//  ИмяТега - Строка - имя тега; пустая строка означает «основной тег пакета».
//  СредиВерсий - Массив из ВерсияПакета, Неопределено - из чего хабу разрешено выбирать
//                (необязательный, по умолчанию Неопределено — все версии пакета).
//  ВерсияДвижка - Строка - версия OneScript установки клиента: хаб выбирает только среди
//                 версий, которые ей подходят (необязательный, по умолчанию пустая строка).
//
// Возвращаемое значение:
//  Структура - та же, что у Разрешить.
//
Функция РазрешитьТегом(Знач Пакет, Знач ИмяТега, Знач СредиВерсий = Неопределено,
	Знач ВерсияДвижка = "") Экспорт

	Итог = РазрешитьТегомСредиКруга(Пакет, ИмяТега, СредиВерсий, ВерсияДвижка);
	Если ОтсеяноБыДвижком(Итог, ВерсияДвижка) Тогда
		Итог.ОтсеяноДвижком = РазрешитьТегомСредиКруга(Пакет, ИмяТега, СредиВерсий, "").Найдена;
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Версия, которую получает установка, не назвавшая ни тега, ни версии, — из того же круга
// кандидатов, из которого выбирает выдача файла. Ею живёт страница пакета: описание,
// зависимости и значки говорят о версии, которую человек получит по `opm install <имя>`.
//
// Параметры:
//  Пакет - Пакет, Неопределено - пакет.
//  ВерсииПакета - Массив из ВерсияПакета, Неопределено - все версии пакета, если вызывающий
//                 их уже прочитал (необязательный, по умолчанию Неопределено — прочитать).
//  Провенанс - СнимокПровенанса, Неопределено - провенанс пакета, если вызывающий его уже
//              снял (необязательный, по умолчанию Неопределено — снять самому).
//  ВерсияДвижка - Строка - версия OneScript установки (необязательный, по умолчанию пустая
//                 строка — движок не назван).
//
// Возвращаемое значение:
//  ВерсияПакета, Неопределено - Неопределено, если канал по умолчанию пуст.
//
Функция ВерсияПоУмолчанию(Знач Пакет, Знач ВерсииПакета = Неопределено,
	Знач Провенанс = Неопределено, Знач ВерсияДвижка = "") Экспорт

	Возврат РазрешитьТегомСредиКруга(Пакет, "",
		КругВыбораХаба(Пакет, ВерсииПакета, Провенанс), ВерсияДвижка).Версия;

КонецФункции

// Подходит ли версия пакета установке с названной версией OneScript — по тому же правилу,
// по которому хаб сужает свой выбор.
//
// Параметры:
//  Версия - ВерсияПакета - версия пакета.
//  ВерсияДвижка - Строка - версия OneScript установки; пустая означает «не названа».
//
// Возвращаемое значение:
//  Булево
//
Функция ПодходитДвижку(Знач Версия, Знач ВерсияДвижка) Экспорт
	Возврат Совместимость.Подходит(Версия, ВерсияДвижка);
КонецФункции

// Разрешает спецификацию среди ГОЛЫХ строк версий — так выбирается версия у чужого
// источника, о сущностях которого этот хаб ничего не знает. Ступени те же и в том же
// порядке: точная строка, имя тега, выражение версии.
//
// Параметры:
//  Пакет - Пакет, Неопределено - пакет; Неопределено означает «имени в реестре ещё нет».
//  Спецификация - Строка - точная версия, имя тега либо выражение версии; пустая строка
//                 означает «версия основного тега пакета».
//  Строки - Массив из Строка - версии, среди которых выбирают.
//  Пул - Пул, Неопределено - пул имени: у имени, которого в реестре ещё нет, действуют теги
//        пула (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - Найдена (Булево), СтрокаВерсии (Строка, пустая при Найдена = Ложь).
//
Функция РазрешитьСредиСтрок(Знач Пакет, Знач Спецификация, Знач Строки, Знач Пул = Неопределено) Экспорт

	Условие = СокрЛП(Строка(Спецификация));
	Если ПустаяСтрока(Условие) Тогда
		Возврат РазрешитьТегомСредиСтрок(Пакет, "", Строки, Пул);
	КонецЕсли;

	Точная = РезолверВерсий.ТочнаяВерсия(Строки, Условие);
	Если Точная <> Неопределено Тогда
		Возврат Строкой(Точная);
	КонецЕсли;

	// тег вперёд выражения — как и на реестре: выражение "1.4" разобралось бы и из имени тега
	Правило = СервисТегов.ПравилоИмениТега(Пакет, Условие, Пул);
	Если Правило <> Неопределено Тогда
		Возврат ПоПравилу(Строки, Правило);
	КонецЕсли;
	Если СервисТегов.ТегИзвестен(Пакет, Условие) Тогда
		Возврат НеВыбрана(); // ручной канал ведёт человек здесь, и чужой версии в нём нет
	КонецЕсли;

	Попытка
		ПоВыражению = РезолверВерсий.МаксимальнаяПоДиапазону(Строки, Условие);
	Исключение
		Возврат НеВыбрана();
	КонецПопытки;

	Возврат Строкой(ПоВыражению);

КонецФункции

// Разрешает имя тега среди голых строк версий; пустое имя означает основной тег пакета.
//
// Параметры:
//  Пакет - Пакет, Неопределено - пакет.
//  ИмяТега - Строка - имя тега; пустая строка означает «основной тег пакета».
//  Строки - Массив из Строка - версии, среди которых выбирают.
//  Пул - Пул, Неопределено - пул имени: у имени, которого в реестре ещё нет, действуют теги
//        пула (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - та же, что у РазрешитьСредиСтрок.
//
Функция РазрешитьТегомСредиСтрок(Знач Пакет, Знач ИмяТега, Знач Строки, Знач Пул = Неопределено) Экспорт

	Имя = СокрЛП(Строка(ИмяТега));
	Если ПустаяСтрока(Имя) Тогда
		Возврат ПоПравилу(Строки, СервисТегов.ПравилоТегаПоУмолчанию(Пакет, Пул));
	КонецЕсли;

	Возврат ПоПравилу(Строки, СервисТегов.ПравилоИмениТега(Пакет, Имя, Пул));

КонецФункции

// Из чего хабу разрешено выбирать версию этого имени. У имени, в которое публиковали
// здесь, — из своих версий и из привезённых, которые источник пула называет своим
// перечнем: версия, осевшая в индексе, пока имя ещё не было своим, сама «последней»
// не становится, а выпуск источника — становится. Точную координату круг не сужает — её
// называет клиент. Правило одно на выдачу файла, резолв версии, страницу и карточку
// пакета; перечни источников берутся из памяти, наружу круг не ходит.
//
// Параметры:
//  Пакет - Пакет, Неопределено - пакет.
//  ВерсииПакета - Массив из ВерсияПакета, Неопределено - все версии пакета, если вызывающий
//                 их уже прочитал (необязательный, по умолчанию Неопределено — прочитать).
//  Провенанс - СнимокПровенанса, Неопределено - провенанс пакета, если вызывающий его уже
//              снял (необязательный, по умолчанию Неопределено — снять самому).
//
// Возвращаемое значение:
//  Массив из ВерсияПакета, Неопределено - Неопределено означает «выбирать из всего,
//              что о версии известно».
//
Функция КругВыбораХаба(Знач Пакет, Знач ВерсииПакета = Неопределено,
	Знач Провенанс = Неопределено) Экспорт

	Если Пакет = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// «чьё имя» и «чья версия» — два ответа одного снимка: провенанс читается один раз
	Снимок = ?(Провенанс = Неопределено,
		СервисПроисхождения.ПровенансПакетаДляЧтения(Пакет.Идентификатор), Провенанс);
	Если НЕ Снимок.ЕстьСобственныеВерсии() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Кандидаты = ?(ВерсииПакета = Неопределено,
		СервисВерсий.ВерсииПакетаДляЧтения(Пакет.Идентификатор), ВерсииПакета);
	Собственные = СервисПроисхождения.ТолькоСобственные(Кандидаты, Снимок);
	Если Собственные.Количество() = Кандидаты.Количество() ИЛИ Перечень = Неопределено Тогда
		Возврат Собственные;
	КонецЕсли;

	Названные = Перечень.НазванныеВерсии(Пакет);
	Круг = Новый Массив();
	Для Каждого Версия Из Кандидаты Цикл
		Если Снимок.ЭтоСвоя(Версия) ИЛИ Названные.Получить(НРег(Версия.Версия)) = Истина Тогда
			Круг.Добавить(Версия);
		КонецЕсли;
	КонецЦикла;
	Возврат Круг;

КонецФункции

// Записана ли спецификация как строка версии. Только такой спрашивают чужой источник:
// имя тега и выражение версии — язык этого хаба, и закачка «версии stable» положила бы
// в хранилище артефакт с координатой-версией stable.
//
// Параметры:
//  Спецификация - Строка - спецификация версии.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоСтрокаВерсии(Знач Спецификация) Экспорт
	Возврат Сравнитель.ВерсияКорректна(Спецификация) ИЛИ Сравнитель.ЭтоSNAPSHOT(Спецификация);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазрешитьСредиКруга(Знач Пакет, Знач Спецификация, Знач СредиВерсий, Знач ВерсияДвижка)

	Если Пакет = Неопределено Тогда
		Возврат НеНайдена();
	КонецЕсли;

	Условие = СокрЛП(Строка(Спецификация));
	Если ПустаяСтрока(Условие) Тогда
		Возврат РазрешитьТегомСредиКруга(Пакет, "", СредиВерсий, ВерсияДвижка);
	КонецЕсли;

	// точная первой и мимо круга кандидатов: координату клиент назвал сам, тег ей проигрывает,
	// а движок установки её не отменяет
	Точная = СервисВерсий.НайтиВерсиюДляЧтения(Пакет.Идентификатор, Условие);
	Если Точная <> Неопределено Тогда
		Возврат НазвалКлиент(Точная);
	КонецЕсли;

	Круг = КругПодДвижок(Пакет, СредиВерсий, ВерсияДвижка);

	// тег вперёд выражения: выражение вида "1.4" разобралось бы и из имени тега
	Если СервисТегов.ТегИзвестен(Пакет, Условие) Тогда
		Возврат ВыбралХаб(СервисТегов.РазрешитьВерсиюТега(Пакет, Условие, Круг));
	КонецЕсли;

	Попытка
		ПоВыражению = СервисВерсий.РазрешитьПоДиапазону(Пакет.Идентификатор, Условие, Круг);
	Исключение
		Возврат НеразобраннаяСпецификация(Условие);
	КонецПопытки;

	Возврат ВыбралХаб(ПоВыражению);

КонецФункции

Функция РазрешитьТегомСредиКруга(Знач Пакет, Знач ИмяТега, Знач СредиВерсий, Знач ВерсияДвижка)

	Если Пакет = Неопределено Тогда
		Возврат НеНайдена();
	КонецЕсли;

	Круг = КругПодДвижок(Пакет, СредиВерсий, ВерсияДвижка);
	Имя = СокрЛП(Строка(ИмяТега));
	Если ПустаяСтрока(Имя) Тогда
		Возврат ВыбралХаб(СервисТегов.РазрешитьПоУмолчанию(Пакет, Круг));
	КонецЕсли;

	Возврат ВыбралХаб(СервисТегов.РазрешитьВерсиюТега(Пакет, Имя, Круг));

КонецФункции

// Круг «всё» при названном движке материализуется: отбор идёт по сущностям версий.
Функция КругПодДвижок(Знач Пакет, Знач СредиВерсий, Знач ВерсияДвижка)

	Если ПустаяСтрока(СокрЛП(Строка(ВерсияДвижка))) Тогда
		Возврат СредиВерсий;
	КонецЕсли;

	Кандидаты = ?(СредиВерсий = Неопределено,
		СервисВерсий.ВерсииПакетаДляЧтения(Пакет.Идентификатор), СредиВерсий);
	Возврат Совместимость.Отобрать(Кандидаты, ВерсияДвижка);

КонецФункции

// Причину отказа уточняет второй резолв без движка — только у версии, которую хаб не нашёл.
Функция ОтсеяноБыДвижком(Знач Итог, Знач ВерсияДвижка)

	Возврат НЕ Итог.Найдена
		И НЕ Итог.ТегНеизвестен
		И НЕ Итог.ВыражениеБитое
		И НЕ ПустаяСтрока(СокрЛП(Строка(ВерсияДвижка)));

КонецФункции

// Semver-правило выбирает максимум диапазона, regex — максимум среди совпавших.
Функция ПоПравилу(Знач Строки, Знач Правило)

	Если Правило = Неопределено Тогда
		Возврат НеВыбрана();
	КонецЕсли;

	Попытка
		Если Правило.Тип = Правило.ТипSemver() Тогда
			Выбранная = РезолверВерсий.МаксимальнаяПоДиапазону(Строки, Правило.Выражение);
		Иначе
			Выбранная = РезолверВерсий.МаксимальнаяПоРегулярному(Строки, Правило.Выражение);
		КонецЕсли;
	Исключение
		Возврат НеВыбрана(); // повреждённое правило чужие версии не выбирает
	КонецПопытки;

	Возврат Строкой(Выбранная);

КонецФункции

Функция Строкой(Знач СтрокаВерсии)

	Найдена = ЗначениеЗаполнено(СтрокаВерсии);
	Возврат Новый Структура("Найдена, СтрокаВерсии",
		Найдена, ?(Найдена, Строка(СтрокаВерсии), ""));

КонецФункции

Функция НеВыбрана()
	Возврат Новый Структура("Найдена, СтрокаВерсии", Ложь, "");
КонецФункции

// Опечатка в имени тега и битое выражение требуют разных действий, поэтому делятся по алфавиту.
Функция НеразобраннаяСпецификация(Знач Условие)
	Возврат ?(СервисТегов.ИмяДопустимо(Условие), ТегаНет(), ВыражениеНеРазбирается());
КонецФункции

Функция НазвалКлиент(Знач Версия)
	Возврат Итог(Версия, Ложь, Ложь, Ложь);
КонецФункции

Функция ВыбралХаб(Знач Версия)
	Возврат Итог(Версия, Истина, Ложь, Ложь);
КонецФункции

Функция ТегаНет()
	Возврат Итог(Неопределено, Истина, Истина, Ложь);
КонецФункции

Функция ВыражениеНеРазбирается()
	Возврат Итог(Неопределено, Истина, Ложь, Истина);
КонецФункции

Функция НеНайдена()
	Возврат Итог(Неопределено, Истина, Ложь, Ложь);
КонецФункции

Функция Итог(Знач Версия, Знач ВерсиюВыбралХаб, Знач ТегНеизвестен, Знач ВыражениеБитое)

	Найдена = (Версия <> Неопределено);
	Возврат Новый Структура("Найдена, Версия, ВерсиюВыбралХаб, ТегНеизвестен, ВыражениеБитое, ОтсеяноДвижком",
		Найдена, Версия, Найдена И ВерсиюВыбралХаб, ТегНеизвестен, ВыражениеБитое, Ложь);

КонецФункции

#КонецОбласти

&Желудь
&Наблюдаемый
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "СравнительВерсий") _Сравнитель,
	&Пластилин(Значение = "РезолверВерсий") _РезолверВерсий,
	&Пластилин(Значение = "СервисПроисхождения") _СервисПроисхождения,
	&Пластилин(Значение = "СовместимостьСДвижком") _Совместимость,
	&Пластилин(Значение = "ПереченьИсточников", Тип = "Массив") _Перечень = Неопределено)

	СервисВерсий = _СервисВерсий;
	СервисТегов = _СервисТегов;
	Сравнитель = _Сравнитель;
	РезолверВерсий = _РезолверВерсий;
	СервисПроисхождения = _СервисПроисхождения;
	Перечень = Новый ВнедрённыеЖелуди().ПервыйИз(_Перечень);
	Совместимость = _Совместимость;

КонецПроцедуры
