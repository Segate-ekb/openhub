// Разобранный диапазон версий — значение-объект. Разбор СВОЙ, а не библиотеки semver
// 1.1.1: та молча теряет верхнюю границу составного диапазона (">=1.2 <2.0"), расширяет
// "^0.0.3" до "<0.1.0" вместо "<0.0.4" и превращает мусорный диапазон в ">=0.0.0".
// Здесь мусор — исключение (fail-closed). Не поддерживаются "||", дефис-диапазоны,
// каретка/тильда над legacy-версиями и пререлиз в неполной версии.
//
// Политика пререлизов проще npm: пререлизы допускаются, если пререлиз есть у ЛЮБОЙ
// границы; npm дополнительно требует совпадения тройки — эту задачу решают каналы.

Перем ИсходнаяСтрока Экспорт;  // Строка - как передали
Перем Условия;                 // Массив Структур: Знак (Строка), Версия (РазобраннаяВерсия)
Перем ЕстьПререлизВГраницах;   // Булево

// Разбирает и валидирует диапазон; некорректный диапазон — исключение.
//
// Параметры:
//  СтрокаДиапазона - Строка - выражение диапазона.
//
Процедура ПриСозданииОбъекта(Знач СтрокаДиапазона)

	Если ТипЗнч(СтрокаДиапазона) <> Тип("Строка") Тогда
		ВызватьИсключение "Диапазон версий должен быть строкой";
	КонецЕсли;

	ИсходнаяСтрока = СокрЛП(СтрокаДиапазона);
	Условия = Новый Массив;
	ЕстьПререлизВГраницах = Ложь;

	Если ПустаяСтрока(ИсходнаяСтрока) Тогда
		ВызватьИсключение "Пустой диапазон версий (для «любой версии» укажите ""*"")";
	КонецЕсли;

	Если СтрНайти(ИсходнаяСтрока, "||") > 0 Тогда
		ВызватьИсключение ОшибкаРазбора("оператор ""||"" не поддерживается");
	КонецЕсли;

	Для Каждого Токен Из ТокеныДиапазона() Цикл
		РазобратьТокен(Токен);
	КонецЦикла;

КонецПроцедуры

// Проверяет попадание версии в диапазон с учётом политики пререлизов.
//
// Параметры:
//  Версия - РазобраннаяВерсия - проверяемая версия.
//
// Возвращаемое значение:
//  Булево - Истина, если версия допускается диапазоном.
//
Функция Допускает(Знач Версия) Экспорт

	Если Версия.ЕстьПререлиз() И НЕ СодержитПререлиз() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СодержитПоПорядку(Версия);

КонецФункции

// Проверяет попадание версии в диапазон чисто по порядку, без политики пререлизов.
//
// Параметры:
//  Версия - РазобраннаяВерсия - проверяемая версия.
//
// Возвращаемое значение:
//  Булево - Истина, если версия удовлетворяет всем условиям диапазона.
//
Функция СодержитПоПорядку(Знач Версия) Экспорт

	Для Каждого Условие Из Условия Цикл
		Если НЕ УсловиеВыполнено(Версия, Условие) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Проверяет, содержит ли пререлиз хотя бы одна граница диапазона — тогда пререлизные
// версии участвуют в отборе.
//
// Возвращаемое значение:
//  Булево - Истина, если пререлиз есть в границах.
//
Функция СодержитПререлиз() Экспорт
	Возврат ЕстьПререлизВГраницах;
КонецФункции

Функция ТокеныДиапазона()

	Нормализованная = СтрЗаменить(СтрЗаменить(ИсходнаяСтрока, Символы.Таб, " "), Символы.ПС, " ");

	Токены = Новый Массив;
	Для Каждого Токен Из СтрРазделить(Нормализованная, " ") Цикл
		Если НЕ ПустаяСтрока(Токен) Тогда
			Токены.Добавить(Токен);
		КонецЕсли;
	КонецЦикла;

	Возврат Токены;

КонецФункции

Процедура РазобратьТокен(Знач Токен)

	Если Токен = "*" ИЛИ Токен = "x" ИЛИ Токен = "X" Тогда
		Возврат; // любая версия — условий не добавляет
	КонецЕсли;

	Знак = "";
	Для Каждого Кандидат Из СтрРазделить(">=,<=,>,<,=,^,~", ",") Цикл
		Если СтрНачинаетсяС(Токен, Кандидат) Тогда
			Знак = Кандидат;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ЧастьВерсии = Сред(Токен, СтрДлина(Знак) + 1);
	Если ПустаяСтрока(ЧастьВерсии) Тогда
		ВызватьИсключение ОшибкаРазбора(СтрШаблон("после ""%1"" ожидается версия", Знак));
	КонецЕсли;

	Разбор = РазобратьЧастьВерсии(ЧастьВерсии);

	Если Знак = "^" Тогда
		ДобавитьКаретку(Разбор);
	ИначеЕсли Знак = "~" Тогда
		ДобавитьТильду(Разбор);
	ИначеЕсли Знак = "=" ИЛИ Знак = "" Тогда
		Если Разбор.КоличествоКомпонент >= 3 Тогда
			ДобавитьУсловие("=", СтрокаВерсииИзРазбора(Разбор, Разбор.КоличествоКомпонент));
		Иначе
			ДобавитьИксДиапазон(Разбор);
		КонецЕсли;
	Иначе
		// неполная версия достраивается нулями: ">=1.2" == ">=1.2.0"
		ДобавитьУсловие(Знак, СтрокаВерсииИзРазбора(Разбор, 3));
	КонецЕсли;

КонецПроцедуры

// Структура: Компоненты, КоличествоКомпонент (без отброшенных x), Пререлиз, ЕстьLegacy.
Функция РазобратьЧастьВерсии(Знач ЧастьВерсии)

	Строка = ЧастьВерсии;

	Пререлиз = "";
	ПозицияПлюса = СтрНайти(Строка, "+");
	Если ПозицияПлюса > 0 Тогда
		Строка = Лев(Строка, ПозицияПлюса - 1); // метаданные сборки на отбор не влияют
	КонецЕсли;

	ПозицияДефиса = СтрНайти(Строка, "-");
	Если ПозицияДефиса > 0 Тогда
		Пререлиз = Сред(Строка, ПозицияДефиса + 1);
		Строка = Лев(Строка, ПозицияДефиса - 1);
		Если ПустаяСтрока(Пререлиз) ИЛИ ПустаяСтрока(Строка) Тогда
			ВызватьИсключение ОшибкаРазбора(СтрШаблон("некорректный токен ""%1""", ЧастьВерсии));
		КонецЕсли;
	КонецЕсли;

	// хвостовые x-компоненты отбрасываются: "1.2.x" -> "1.2"
	Сегменты = СтрРазделить(Строка, ".");
	Пока Сегменты.Количество() > 0 И ЭтоИксСегмент(Сегменты[Сегменты.ВГраница()]) Цикл
		Сегменты.Удалить(Сегменты.ВГраница());
	КонецЦикла;

	Если Сегменты.Количество() = 0 ИЛИ Сегменты.Количество() > 4 Тогда
		ВызватьИсключение ОшибкаРазбора(СтрШаблон("некорректная версия ""%1""", ЧастьВерсии));
	КонецЕсли;

	Компоненты = Новый Массив;
	Для Каждого Сегмент Из Сегменты Цикл
		Если НЕ ЭтоЧисловойСегмент(Сегмент) Тогда
			ВызватьИсключение ОшибкаРазбора(СтрШаблон(
				"некорректная компонента ""%1"" в версии ""%2""", Сегмент, ЧастьВерсии));
		КонецЕсли;
		Компоненты.Добавить(Число(Сегмент));
	КонецЦикла;

	Если НЕ ПустаяСтрока(Пререлиз) Тогда
		Если Компоненты.Количество() <> 3 Тогда
			ВызватьИсключение ОшибкаРазбора(СтрШаблон(
				"пререлиз допустим только у полной трёхкомпонентной версии (""%1"")", ЧастьВерсии));
		КонецЕсли;
		ПроверитьПререлиз(Пререлиз, ЧастьВерсии);
	КонецЕсли;

	Разбор = Новый Структура;
	Разбор.Вставить("Компоненты", Компоненты);
	Разбор.Вставить("КоличествоКомпонент", Компоненты.Количество());
	Разбор.Вставить("Пререлиз", Пререлиз);
	Разбор.Вставить("ЕстьLegacy", Компоненты.Количество() = 4);
	Возврат Разбор;

КонецФункции

Процедура ДобавитьКаретку(Знач Разбор)

	Если Разбор.ЕстьLegacy Тогда
		ВызватьИсключение ОшибкаРазбора("каретка (^) над legacy-версией не поддерживается");
	КонецЕсли;

	ДобавитьУсловие(">=", СтрокаВерсииИзРазбора(Разбор, 3));

	// верхняя граница — по первой ненулевой из ЗАДАННЫХ компонент; все нули — инкремент
	// последней заданной ("^0.0.3" -> "<0.0.4")
	Мажор = Разбор.Компоненты[0];
	Минор = ?(Разбор.КоличествоКомпонент >= 2, Разбор.Компоненты[1], 0);
	Патч = ?(Разбор.КоличествоКомпонент >= 3, Разбор.Компоненты[2], 0);

	Если Мажор > 0 Тогда
		Верх = СтрШаблон("%1.0.0", Формат(Мажор + 1, "ЧГ=0; ЧН=0"));
	ИначеЕсли Разбор.КоличествоКомпонент >= 2 И Минор > 0 Тогда
		Верх = СтрШаблон("0.%1.0", Формат(Минор + 1, "ЧГ=0; ЧН=0"));
	ИначеЕсли Разбор.КоличествоКомпонент >= 3 И Патч > 0 Тогда
		Верх = СтрШаблон("0.0.%1", Формат(Патч + 1, "ЧГ=0; ЧН=0"));
	ИначеЕсли Разбор.КоличествоКомпонент = 1 Тогда
		Верх = "1.0.0";
	ИначеЕсли Разбор.КоличествоКомпонент = 2 Тогда
		Верх = "0.1.0";
	Иначе
		Верх = "0.0.1";
	КонецЕсли;

	ДобавитьУсловие("<", Верх);

КонецПроцедуры

Процедура ДобавитьТильду(Знач Разбор)

	Если Разбор.ЕстьLegacy Тогда
		ВызватьИсключение ОшибкаРазбора("тильда (~) над legacy-версией не поддерживается");
	КонецЕсли;

	ДобавитьУсловие(">=", СтрокаВерсииИзРазбора(Разбор, 3));

	Если Разбор.КоличествоКомпонент >= 2 Тогда
		Верх = СтрШаблон("%1.%2.0",
			Формат(Разбор.Компоненты[0], "ЧГ=0; ЧН=0"), Формат(Разбор.Компоненты[1] + 1, "ЧГ=0; ЧН=0"));
	Иначе
		Верх = СтрШаблон("%1.0.0", Формат(Разбор.Компоненты[0] + 1, "ЧГ=0; ЧН=0"));
	КонецЕсли;

	ДобавитьУсловие("<", Верх);

КонецПроцедуры

Процедура ДобавитьИксДиапазон(Знач Разбор)

	Если НЕ ПустаяСтрока(Разбор.Пререлиз) Тогда
		ВызватьИсключение ОшибкаРазбора("пререлиз в неполной версии не поддерживается");
	КонецЕсли;

	ДобавитьУсловие(">=", СтрокаВерсииИзРазбора(Разбор, 3));

	Если Разбор.КоличествоКомпонент = 1 Тогда
		Верх = СтрШаблон("%1.0.0", Формат(Разбор.Компоненты[0] + 1, "ЧГ=0; ЧН=0"));
	Иначе
		Верх = СтрШаблон("%1.%2.0",
			Формат(Разбор.Компоненты[0], "ЧГ=0; ЧН=0"), Формат(Разбор.Компоненты[1] + 1, "ЧГ=0; ЧН=0"));
	КонецЕсли;

	ДобавитьУсловие("<", Верх);

КонецПроцедуры

Функция СтрокаВерсииИзРазбора(Знач Разбор, Знач МинимумКомпонент)

	Строки = Новый Массив;
	Для Каждого Компонент Из Разбор.Компоненты Цикл
		Строки.Добавить(Формат(Компонент, "ЧГ=0; ЧН=0"));
	КонецЦикла;
	Пока Строки.Количество() < МинимумКомпонент Цикл
		Строки.Добавить("0");
	КонецЦикла;

	Результат = СтрСоединить(Строки, ".");
	Если НЕ ПустаяСтрока(Разбор.Пререлиз) Тогда
		Результат = Результат + "-" + Разбор.Пререлиз;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура ДобавитьУсловие(Знач Знак, Знач СтрокаВерсии)

	Условие = Новый Структура;
	Условие.Вставить("Знак", Знак);
	Условие.Вставить("Версия", Новый РазобраннаяВерсия(СтрокаВерсии));
	Условия.Добавить(Условие);

	Если Условие.Версия.ЕстьПререлиз() Тогда
		ЕстьПререлизВГраницах = Истина;
	КонецЕсли;

КонецПроцедуры

Функция УсловиеВыполнено(Знач Версия, Знач Условие)

	Результат = Версия.Сравнить(Условие.Версия);

	Если Условие.Знак = ">=" Тогда
		Возврат Результат >= 0;
	ИначеЕсли Условие.Знак = ">" Тогда
		Возврат Результат > 0;
	ИначеЕсли Условие.Знак = "<=" Тогда
		Возврат Результат <= 0;
	ИначеЕсли Условие.Знак = "<" Тогда
		Возврат Результат < 0;
	КонецЕсли;

	Возврат Результат = 0; // "="

КонецФункции

Процедура ПроверитьПререлиз(Знач Пререлиз, Знач ЧастьВерсии)

	Шаблон = Новый РегулярноеВыражение("\A[0-9A-Za-z\-]+(\.[0-9A-Za-z\-]+)*\z");
	Если НЕ Шаблон.Совпадает(Пререлиз) Тогда
		ВызватьИсключение ОшибкаРазбора(СтрШаблон(
			"некорректный пререлиз ""%1"" в версии ""%2""", Пререлиз, ЧастьВерсии));
	КонецЕсли;

	Для Каждого Идентификатор Из СтрРазделить(Пререлиз, ".") Цикл
		Если ЭтоТолькоЦифры(Идентификатор) И НЕ ЭтоЧисловойСегмент(Идентификатор) Тогда
			ВызватьИсключение ОшибкаРазбора(СтрШаблон(
				"ведущий ноль в числовом идентификаторе пререлиза ""%1"" в версии ""%2""", Идентификатор, ЧастьВерсии));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЭтоТолькоЦифры(Знач Сегмент)
	Возврат Новый РегулярноеВыражение("\A[0-9]+\z").Совпадает(Сегмент);
КонецФункции

Функция ЭтоИксСегмент(Знач Сегмент)
	Возврат Сегмент = "x" ИЛИ Сегмент = "X" ИЛИ Сегмент = "*";
КонецФункции

// Ведущий ноль в границе (">=01.2.3") — ошибка, а не молчаливая нормализация.
Функция ЭтоЧисловойСегмент(Знач Сегмент)
	Шаблон = Новый РегулярноеВыражение("\A(0|[1-9][0-9]*)\z");
	Возврат Шаблон.Совпадает(Сегмент);
КонецФункции

Функция ОшибкаРазбора(Знач Причина)
	Возврат СтрШаблон("Некорректный диапазон версий ""%1"": %2", ИсходнаяСтрока, Причина);
КонецФункции
