// Единственная точка публикации события «пул заполняется»: событие выпускается, когда
// заполнение выросло. У пула без действующей квоты процента нет, и события не бывает.

Перем Квоты;        // КвотаПула (реестр)
Перем Заполнение;   // ЗаполнениеПула (основа)
Перем Издатель;     // ИздательСобытий (события) — опционален

#Область ПубличныйИнтерфейс

// Публикует событие заполнения, если занятый объём пула вырос и процент поднялся.
//
// Параметры:
//  Пул - Пул - пул, объём которого изменился.
//  ЗанятоДо - Число - занятый объём до операции, байты.
//  ЗанятоПосле - Число - занятый объём после операции, байты.
//
Процедура ПослеИзменения(Знач Пул, Знач ЗанятоДо, Знач ЗанятоПосле) Экспорт

	Если Издатель = Неопределено ИЛИ Пул = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КвотаБайт = Квоты.ЭффективнаяБайт(Пул);
	Если КвотаБайт <= 0 Тогда
		Возврат; // без квоты процента не существует
	КонецЕсли;

	ОпубликоватьРост(Пул, ЗанятоПосле, КвотаБайт,
		Заполнение.Процент(ЗанятоДо, КвотаБайт), Заполнение.Процент(ЗанятоПосле, КвотаБайт));

КонецПроцедуры

// Публикует событие заполнения, если урезание квоты подняло процент. Занятый объём
// при этом не меняется: пул «наполняется» тем, что предел стал ближе.
//
// Параметры:
//  Пул - Пул - пул, квота которого изменилась.
//  КвотаБайтДо - Число - действовавшая квота, байты.
//  КвотаБайтПосле - Число - новая квота, байты.
//
Процедура ПослеСменыКвоты(Знач Пул, Знач КвотаБайтДо, Знач КвотаБайтПосле) Экспорт

	Если Издатель = Неопределено ИЛИ Пул = Неопределено ИЛИ КвотаБайтПосле <= 0 Тогда
		Возврат;
	КонецЕсли;

	Занято = Цел(Число(?(Пул.ЗанятоБайт = Неопределено, 0, Пул.ЗанятоБайт)));
	// прежней квоты не было — считать «до» не от чего, и весь процент новый
	ПроцентДо = ?(КвотаБайтДо <= 0, 0, Заполнение.Процент(Занято, КвотаБайтДо));
	ОпубликоватьРост(Пул, Занято, КвотаБайтПосле, ПроцентДо, Заполнение.Процент(Занято, КвотаБайтПосле));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Имя не «Сообщить»: так называется глобальная процедура платформы, и вызов ушёл бы в неё.
Процедура ОпубликоватьРост(Знач Пул, Знач Занято, Знач КвотаБайт, Знач ПроцентДо, Знач ПроцентПосле)

	Если ПроцентПосле <= ПроцентДо Тогда
		Возврат; // заполнение не выросло — сообщать не о чем
	КонецЕсли;
	Издатель.Опубликовать(Издатель.ТипПулЗаполнен(),
		Нагрузка(Пул, Занято, КвотаБайт, ПроцентДо, ПроцентПосле));

КонецПроцедуры

Функция Нагрузка(Знач Пул, Знач ЗанятоПосле, Знач КвотаБайт, Знач ПроцентДо, Знач ПроцентПосле)

	Данные = Новый Структура();
	Данные.Вставить("ПулИдентификатор", Цел(Пул.Идентификатор));
	Данные.Вставить("ИмяПула", Строка(Пул.Имя));
	Данные.Вставить("ПакетИдентификатор", 0);
	Данные.Вставить("Процент", ПроцентПосле);
	Данные.Вставить("ПроцентДо", ПроцентДо);
	Данные.Вставить("ЗанятоБайт", ЗанятоПосле);
	Данные.Вставить("КвотаБайт", КвотаБайт);
	Возврат Данные;

КонецФункции

#КонецОбласти

&Прозвище("СторожЗаполненияПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КвотаПула") _Квоты,
	&Пластилин(Значение = "ЗаполнениеПула") _Заполнение,
	&Пластилин(Значение = "ИздательСобытий", Тип = "Массив") _Издатель)

	Квоты = _Квоты;
	Заполнение = _Заполнение;
	// Массив — необязательная зависимость: контейнер без модуля события собирается,
	// объём считается, событию просто некуда уходить.
	Издатель = ?(_Издатель = Неопределено ИЛИ _Издатель.Количество() = 0, Неопределено, _Издатель[0]);

КонецПроцедуры
