// Пакет по идентификатору: его пул, имена и адрес для журнала. Ответ кэшируется —
// летописи спрашивают координаты в цикле переезда канала, а меняются они редко.

Перем СервисПакетов; // СервисПакетов (реестр)
Перем СервисПулов;   // СервисПулов (реестр)
Перем ИменаЖурнала;  // ИмяОбъектаАудита (аудит) — адрес пакета в журнале
Перем Кэш;           // Соответствие: ПакетИдентификатор -> Структура координат

#Область ПубличныйИнтерфейс

// Координаты пакета. Неизвестный пакет — нули и пустые имена: событие публикуется,
// но скоуп доставки пуст, а адрес называет утраченную сущность.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Структура - ПулИдентификатор (Число), ИмяПула (Строка), ИмяПакета (Строка),
//              Адрес (Строка) — адрес пакета для журнала аудита.
//
Функция Пакета(Знач ПакетИдентификатор) Экспорт

	Готовые = Кэш.Получить(ПакетИдентификатор);
	Если Готовые <> Неопределено Тогда
		Возврат Готовые;
	КонецЕсли;

	// поле публикуется ЦЕЛИКОМ и последним: соседний поток обязан увидеть либо ничего,
	// либо готовые координаты, а не полупустую структуру
	Найденные = Разыскать(ПакетИдентификатор);
	Кэш.Вставить(ПакетИдентификатор, Найденные);
	Возврат Найденные;

КонецФункции

// Адрес пакета для журнала аудита.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Строка - "пул/пакет" либо "пакет#<идентификатор>" для утраченного пакета.
//
Функция АдресПакета(Знач ПакетИдентификатор) Экспорт
	Возврат Пакета(ПакетИдентификатор).Адрес;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Разыскать(Знач ПакетИдентификатор)

	Результат = Новый Структура("ПулИдентификатор, ИмяПула, ИмяПакета, Адрес",
		0, "", "", ИменаЖурнала.Неизвестный("пакет", ПакетИдентификатор));

	Пакет = СервисПакетов.ПакетПоИдентификатору(ПакетИдентификатор);
	Если Пакет = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.ИмяПакета = Строка(Пакет.Имя);
	Результат.ПулИдентификатор = Цел(Пакет.ПулИдентификатор);

	Пул = СервисПулов.ПулПоИдентификатору(Пакет.ПулИдентификатор);
	Если Пул <> Неопределено Тогда
		Результат.ИмяПула = Строка(Пул.Имя);
	КонецЕсли;

	Результат.Адрес = ИменаЖурнала.ПакетПоИменам(Результат.ИмяПула, Результат.ИмяПакета);
	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ИмяОбъектаАудита") _Имена)

	СервисПакетов = _СервисПакетов;
	СервисПулов = _СервисПулов;
	ИменаЖурнала = _Имена;
	Кэш = Новый Соответствие();

КонецПроцедуры
