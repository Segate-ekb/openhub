// Неизменяемое значение-объект: единое представление semver- и legacy-версий.
// Legacy-хвост — не пререлиз: "1.2.3.4" старше "1.2.3", "1.2.3.0" равно "1.2.3".

#Использовать semver

Перем Исходная Экспорт;        // Строка - как передали, источник истины
Перем Мажор Экспорт;           // Число
Перем Минор Экспорт;           // Число
Перем Патч Экспорт;            // Число
Перем Четвертая Экспорт;       // Число - четвёртая компонента legacy, у semver = 0
Перем Пререлиз Экспорт;        // Строка - идентификаторы через точку, "" - релиз
Перем МетаданныеСборки Экспорт; // Строка - +build, на порядок не влияют
Перем ПризнакLegacy Экспорт;   // Булево

Процедура ПриСозданииОбъекта(Знач СтрокаВерсии, Знач Компоненты = Неопределено)

	Если ТипЗнч(СтрокаВерсии) <> Тип("Строка") Тогда
		ВызватьИсключение "Версия должна быть строкой";
	КонецЕсли;

	Исходная = СокрЛП(СтрокаВерсии);
	Если ПустаяСтрока(Исходная) Тогда
		ВызватьИсключение "Пустая строка версии";
	КонецЕсли;

	Если Компоненты <> Неопределено Тогда
		ПринятьКомпоненты(Компоненты);
		Возврат;
	КонецЕсли;

	// префикс "v"/"V" допускается и отбрасывается (поведение библиотеки semver)
	СтрокаРазбора = Исходная;
	Если СтрНачинаетсяС(НРег(СтрокаРазбора), "v") Тогда
		СтрокаРазбора = Сред(СтрокаРазбора, 2);
	КонецЕсли;

	Если ЭтоLegacyСтрока(СтрокаРазбора) Тогда
		РазобратьLegacy(СтрокаРазбора);
	Иначе
		РазобратьSemver(СтрокаРазбора);
	КонецЕсли;

КонецПроцедуры

// Проверяет наличие пререлизной части. Legacy-версии пререлизными не бывают.
//
// Возвращаемое значение:
//  Булево - Истина, если у версии есть пререлиз.
//
Функция ЕстьПререлиз() Экспорт
	Возврат НЕ ПустаяСтрока(Пререлиз);
КонецФункции

// Сравнивает версию с другой по единому порядку semver и legacy.
// Метаданные сборки на порядок не влияют.
//
// Параметры:
//  Другая - РазобраннаяВерсия - версия для сравнения.
//
// Возвращаемое значение:
//  Число - -1 текущая младше, 0 равны по порядку, 1 текущая старше.
//
Функция Сравнить(Знач Другая) Экспорт

	Результат = СравнитьЧисла(Мажор, Другая.Мажор);
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = СравнитьЧисла(Минор, Другая.Минор);
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Результат = СравнитьЧисла(Патч, Другая.Патч);
	Если Результат <> 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Если ЕстьПререлиз() И НЕ Другая.ЕстьПререлиз() Тогда
		Возврат -1;
	ИначеЕсли НЕ ЕстьПререлиз() И Другая.ЕстьПререлиз() Тогда
		Возврат 1;
	ИначеЕсли ЕстьПререлиз() И Другая.ЕстьПререлиз() Тогда
		// обе пререлизные - значит, обе semver: порядок пререлизов считает библиотека
		Возврат Версии.СравнитьВерсии(НормализованныйSemver(), Другая.НормализованныйSemver());
	КонецЕсли;

	// обе релизные: решает четвёртая компонента (semver = 0)
	Возврат СравнитьЧисла(Четвертая, Другая.Четвертая);

КонецФункции

// Проверяет каноничность числовых компонент исходной строки (semver 2.0.0 п.2 и п.9).
// Библиотека semver (как и opm) к ведущим нулям снисходительна и нормализует "01.2.3"
// в "1.2.3", но исходные строки остаются разными: две такие версии проходят проверку
// уникальности как разные и при этом равны по порядку, а значит latest становится
// недетерминированным. Публикация их отклоняет, чтение и сравнение — нет.
//
// Возвращаемое значение:
//  Булево - Истина, если ведущих нулей в числовых компонентах нет.
//
Функция БезВедущихНулей() Экспорт
	Возврат ПроверитьБезВедущихНулей(Исходная);
КонецФункции

// Возвращает строковое представление версии.
//
// Возвращаемое значение:
//  Строка - версия, как её передали при создании.
//
Функция ВСтроку() Экспорт
	Возврат Исходная;
КонецФункции

// Возвращает каноническую semver-строку без метаданных сборки. У legacy-версий
// четвёртая компонента теряется — для их сравнения используйте Сравнить.
//
// Возвращаемое значение:
//  Строка - мажор.минор.патч[-пререлиз].
//
Функция НормализованныйSemver() Экспорт

	Ядро = СтрШаблон("%1.%2.%3", Формат(Мажор, "ЧГ=0; ЧН=0"), Формат(Минор, "ЧГ=0; ЧН=0"), Формат(Патч, "ЧГ=0; ЧН=0"));
	Если ЕстьПререлиз() Тогда
		Ядро = Ядро + "-" + Пререлиз;
	КонецЕсли;
	Возврат Ядро;

КонецФункции

// Набор проверяется целиком: половина компонент дала бы версию, не совпадающую со своей строкой.
Процедура ПринятьКомпоненты(Знач Компоненты)

	Если ТипЗнч(Компоненты) <> Тип("Структура") Тогда
		ВызватьИсключение "Компоненты версии должны быть структурой";
	КонецЕсли;

	Мажор = ЧисловаяКомпонента(Компоненты, "Мажор");
	Минор = ЧисловаяКомпонента(Компоненты, "Минор");
	Патч = ЧисловаяКомпонента(Компоненты, "Патч");
	Четвертая = ЧисловаяКомпонента(Компоненты, "Четвертая");
	Пререлиз = СтроковаяКомпонента(Компоненты, "Пререлиз");
	МетаданныеСборки = СтроковаяКомпонента(Компоненты, "МетаданныеСборки");

	Признак = Неопределено;
	Если НЕ Компоненты.Свойство("ПризнакLegacy", Признак) ИЛИ ТипЗнч(Признак) <> Тип("Булево") Тогда
		ВызватьИсключение "Компонента ""ПризнакLegacy"" версии не задана";
	КонецЕсли;
	ПризнакLegacy = Признак;

КонецПроцедуры

Функция ЧисловаяКомпонента(Знач Компоненты, Знач Имя)

	Значение = Неопределено;
	Если НЕ Компоненты.Свойство(Имя, Значение) ИЛИ ТипЗнч(Значение) <> Тип("Число") Тогда
		ВызватьИсключение СтрШаблон("Компонента ""%1"" версии не задана числом", Имя);
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция СтроковаяКомпонента(Знач Компоненты, Знач Имя)

	Значение = Неопределено;
	Если НЕ Компоненты.Свойство(Имя, Значение) ИЛИ ТипЗнч(Значение) <> Тип("Строка") Тогда
		ВызватьИсключение СтрШаблон("Компонента ""%1"" версии не задана строкой", Имя);
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция ЭтоLegacyСтрока(Знач Строка)
	Шаблон = Новый РегулярноеВыражение("\A\d+\.\d+\.\d+\.\d+\z");
	Возврат Шаблон.Совпадает(Строка);
КонецФункции

Процедура РазобратьLegacy(Знач Строка)

	Компоненты = СтрРазделить(Строка, ".");
	Мажор = Число(Компоненты[0]);
	Минор = Число(Компоненты[1]);
	Патч = Число(Компоненты[2]);
	Четвертая = Число(Компоненты[3]);
	Пререлиз = "";
	МетаданныеСборки = "";
	ПризнакLegacy = Истина;

КонецПроцедуры

Процедура РазобратьSemver(Знач Строка)

	// Новый Версия не бросает исключение, а ставит флаг ошибки — переводим в исключение
	КлассВерсия = Новый Версия(Строка);
	Если КлассВерсия.Ошибка() Тогда
		ВызватьИсключение СтрШаблон(
			"Некорректная версия ""%1"": %2 (ожидалась semver-версия вида 1.2.3[-пререлиз][+сборка] или legacy-версия 1.2.3.4)",
			Исходная, КлассВерсия.ПолучитьОписаниеОшибки());
	КонецЕсли;

	Мажор = КлассВерсия.Основная;
	Минор = КлассВерсия.Второстепенная;
	Патч = КлассВерсия.Патч;
	Четвертая = 0;
	Пререлиз = МассивКомпонентовВСтроку(КлассВерсия.ПреРелиз);
	МетаданныеСборки = МассивКомпонентовВСтроку(КлассВерсия.МетаданныеСборки);
	ПризнакLegacy = Ложь;

КонецПроцедуры

Функция МассивКомпонентовВСтроку(Знач МассивКомпонентов)

	Строки = Новый Массив;
	Для Каждого Компонент Из МассивКомпонентов Цикл
		Если ТипЗнч(Компонент) = Тип("Число") Тогда
			Строки.Добавить(Формат(Компонент, "ЧГ=0; ЧН=0"));
		Иначе
			Строки.Добавить(Строка(Компонент));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, ".");

КонецФункции

Функция СравнитьЧисла(Знач Число1, Знач Число2)

	Если Число1 < Число2 Тогда
		Возврат -1;
	ИначеЕсли Число1 > Число2 Тогда
		Возврат 1;
	КонецЕсли;
	Возврат 0;

КонецФункции

Функция ПроверитьБезВедущихНулей(Знач Строка)

	Если СтрНачинаетсяС(НРег(Строка), "v") Тогда
		Строка = Сред(Строка, 2);
	КонецЕсли;

	ПозицияПлюса = СтрНайти(Строка, "+");
	Если ПозицияПлюса > 0 Тогда
		Строка = Лев(Строка, ПозицияПлюса - 1);
	КонецЕсли;

	Ядро = Строка;
	Пререлиз = "";
	ПозицияДефиса = СтрНайти(Строка, "-");
	Если ПозицияДефиса > 0 Тогда
		Ядро = Лев(Строка, ПозицияДефиса - 1);
		Пререлиз = Сред(Строка, ПозицияДефиса + 1);
	КонецЕсли;

	Для Каждого Сегмент Из СтрРазделить(Ядро, ".") Цикл
		Если НЕ ЧислоКаноническое(Сегмент) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	// числовые идентификаторы пререлиза — канонические; текстовые (rc, x-y-z) — любые
	Для Каждого Идентификатор Из СтрРазделить(Пререлиз, ".") Цикл
		Если ЭтоТолькоЦифры(Идентификатор) И НЕ ЧислоКаноническое(Идентификатор) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЧислоКаноническое(Знач Сегмент)
	Шаблон = Новый РегулярноеВыражение("\A(0|[1-9][0-9]*)\z");
	Возврат Шаблон.Совпадает(Сегмент);
КонецФункции

Функция ЭтоТолькоЦифры(Знач Сегмент)
	Возврат Новый РегулярноеВыражение("\A[0-9]+\z").Совпадает(Сегмент);
КонецФункции
