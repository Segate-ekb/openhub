// Владеет сущностью «Тег»: жизненный цикл, режимы, инварианты, резолв имени тега в
// конкретную версию. Состав канала ведёт СоставКаналов, отбор по правилу —
// ОтборВерсийПоПравилу, запись в журнал — ЛетописьТегов.
//
// Имя тега и номер версии одного пакета не пересекаются: строку, уже занятую версией,
// тегом не назвать (вторая половина запрета — в ПриёмВерсии).
//
// Тег — канал обновления, а не указатель: он помечает ВСЕ свои версии, а установка
// «pkg@tag» получает максимальную по порядку версий среди них и не отозванную. Состав тега-правила
// нигде не хранится — он вычисляется правилом по всем версиям пакета при обращении (отзыв
// версию из канала не убирает, отозванные отсеиваются на резолве); состав ручного тега
// ведёт мейнтейнер, и версий в нём может быть несколько. Базовые теги stable и prerelease
// заводятся у любого пакета, попавшего в реестр, а до их создания резолвятся
// предопределённым правилом.

Перем ХранилищеТегов;  // ХранилищеТегов (данные)
Перем СервисВерсий;    // СервисВерсий
Перем Отбор;           // ОтборВерсийПоПравилу
Перем Режимы;          // РежимТега
Перем Летопись;        // ЛетописьТегов
Перем Состав;          // СоставКаналов
Перем Стили;           // СтильТега — единственный словарь стилей плашки
Перем Значки;          // ЗначокТега — единственный словарь значков плашки

#Область РезолвИмени

// Резолвит имя тега в конкретную действующую версию пакета. Порядок: строка тега, затем
// предопределённое правило базового имени. Отозванная версия не отдаётся.
//
// Параметры:
//  Пакет - Пакет, Неопределено - пакет.
//  ИмяТега - Строка - имя тега, например "stable" или "lts".
//  СредиВерсий - Массив из ВерсияПакета, Неопределено - кандидаты, из которых выбирать;
//                отозванные отсеиваются здесь. Неопределено — все версии пакета
//                (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  ВерсияПакета, Неопределено - выбранная версия либо Неопределено, если тег неизвестен
//                               или подходящей версии нет.
//
Функция РазрешитьВерсиюТега(Знач Пакет, Знач ИмяТега, Знач СредиВерсий = Неопределено) Экспорт

	Если Пакет = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяНорм = НормализованноеИмя(ИмяТега);
	Если ПустаяСтрока(ИмяНорм) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Тег = НайтиТег(Пакет.Идентификатор, ИмяНорм);
	Если Тег <> Неопределено Тогда
		Возврат Состав.Канал(Тег, СредиВерсий).Отдаваемая;
	КонецЕсли;

	Правило = БазовоеПравило(ИмяНорм);
	Если Правило = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Кандидаты = ?(СредиВерсий = Неопределено, СервисВерсий.ВерсииПакета(Пакет.Идентификатор), СредиВерсий);
	Возврат Состав.ОтдаваемаяСреди(Отбор.ОтобратьВерсии(Кандидаты, Правило));

КонецФункции

// Проверяет, известно ли имя тега для пакета: позволяет вызывающему различать «тега нет»
// и «подходящей версии нет».
//
// Параметры:
//  Пакет - Пакет, Неопределено - пакет.
//  ИмяТега - Строка - имя тега.
//
// Возвращаемое значение:
//  Булево - Истина, если тег есть или имя базовое.
//
Функция ТегИзвестен(Знач Пакет, Знач ИмяТега) Экспорт

	Если Пакет = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ИмяНорм = НормализованноеИмя(ИмяТега);
	Если ПустаяСтрока(ИмяНорм) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НайтиТег(Пакет.Идентификатор, ИмяНорм) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат БазовоеПравило(ИмяНорм) <> Неопределено;

КонецФункции

// Резолвит версию, которую получает установка без тега: тег пакета по умолчанию,
// иначе stable.
//
// Параметры:
//  Пакет - Пакет, Неопределено - пакет.
//  СредиВерсий - Массив из ВерсияПакета, Неопределено - кандидаты, из которых выбирать;
//                отозванные отсеиваются здесь. Неопределено — все версии пакета
//                (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  ВерсияПакета, Неопределено - выбранная версия.
//
Функция РазрешитьПоУмолчанию(Знач Пакет, Знач СредиВерсий = Неопределено) Экспорт

	Если Пакет = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Тег Из ТегиПакета(Пакет.Идентификатор) Цикл
		Если Тег.ПоУмолчанию = Истина Тогда
			Возврат Состав.Канал(Тег, СредиВерсий).Отдаваемая;
		КонецЕсли;
	КонецЦикла;

	Возврат РазрешитьВерсиюТега(Пакет, ИмяStable(), СредиВерсий);

КонецФункции

// Возвращает правило, которым тег отбирает версии, — для случая, когда отбирать приходится
// не из реестра, а из голых строк версий чужого источника. Ручной тег правила не имеет:
// его состав ведёт человек здесь, и чужая версия в него попасть не может.
//
// Параметры:
//  Пакет - Пакет, Неопределено - пакет; Неопределено означает «пакета в реестре ещё нет»,
//          и работают предопределённые правила базовых имён.
//  ИмяТега - Строка - имя тега.
//
// Возвращаемое значение:
//  ПравилоТега, Неопределено - Неопределено, если тег ручной либо имя неизвестно.
//
Функция ПравилоИмениТега(Знач Пакет, Знач ИмяТега) Экспорт

	ИмяНорм = НормализованноеИмя(ИмяТега);
	Если ПустаяСтрока(ИмяНорм) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Пакет = Неопределено Тогда
		Возврат БазовоеПравило(ИмяНорм);
	КонецЕсли;

	Тег = НайтиТег(Пакет.Идентификатор, ИмяНорм);
	Если Тег <> Неопределено Тогда
		Возврат ПравилоИзТега(Тег);
	КонецЕсли;

	Возврат БазовоеПравило(ИмяНорм);

КонецФункции

// Возвращает правило тега, которым резолвится установка без тега: тег пакета по умолчанию,
// иначе stable.
//
// Параметры:
//  Пакет - Пакет, Неопределено - пакет.
//
// Возвращаемое значение:
//  ПравилоТега, Неопределено - Неопределено, если тег по умолчанию ручной.
//
Функция ПравилоТегаПоУмолчанию(Знач Пакет) Экспорт

	Если Пакет <> Неопределено Тогда
		Для Каждого Тег Из ТегиПакета(Пакет.Идентификатор) Цикл
			Если Тег.ПоУмолчанию = Истина Тогда
				Возврат ПравилоИзТега(Тег);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат БазовоеПравило(ИмяStable());

КонецФункции

#КонецОбласти

#Область ЧтениеТегов

// Возвращает теги пакета.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив из Тег - теги пакета.
//
Функция ТегиПакета(Знач ПакетИдентификатор) Экспорт
	Результат = ХранилищеТегов.ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор);
	Возврат ?(Результат = Неопределено, Новый Массив(), Результат);
КонецФункции

// Возвращает ручные теги пакета — те, состав которых ведёт человек. Именно из них
// выбирают, какой тег повесить на версию: у тега-правила состав считается правилом.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив из Тег - ручные теги пакета.
//
Функция РучныеТегиПакета(Знач ПакетИдентификатор) Экспорт

	Результат = Новый Массив();
	Для Каждого Тег Из ТегиПакета(ПакетИдентификатор) Цикл
		Если НЕ Режимы.ЭтоПравило(Тег.Режим) Тогда
			Результат.Добавить(Тег);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ищет тег пакета по имени; имя нормализуется.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега в любом регистре.
//
// Возвращаемое значение:
//  Тег, Неопределено - найденный тег.
//
Функция НайтиТег(Знач ПакетИдентификатор, Знач Имя) Экспорт
	Возврат ХранилищеТегов.ПолучитьОдноПоПакетИдентификаторРавноИИмяРавно(
		ПакетИдентификатор, НормализованноеИмя(Имя));
КонецФункции

// Возвращает версию, которую отдаёт тег: максимальную в канале среди не отозванных.
//
// Параметры:
//  Тег - Тег - тег-канал.
//
// Возвращаемое значение:
//  ВерсияПакета, Неопределено - Неопределено, если канал пуст либо все его версии отозваны.
//
Функция ВерсияТега(Знач Тег) Экспорт
	Возврат Состав.ДействующаяВерсия(Тег);
КонецФункции

// Возвращает весь состав канала — версии тега, включая отозванные.
//
// Параметры:
//  Тег - Тег - тег-канал.
//
// Возвращаемое значение:
//  Массив из ВерсияПакета - состав канала.
//
Функция ВерсииТега(Знач Тег) Экспорт
	Возврат Состав.ВерсииКанала(Тег);
КонецФункции

// Возвращает каналы пакета целиком: каждый тег со своим составом и отдаваемой версией,
// плюс обратная раскладка «версия — её теги». Единственная батч-точка тегов: версии
// пакета читаются ОДИН раз, теги — ОДИН раз, правило каждого тега применяется к списку
// версий ОДИН раз, к хранилищу меток идут только ручные теги.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Структура - Каналы (Массив из Структура с полями Тег, Состав, Отдаваемая),
//              ПоВерсиям (Соответствие: ВерсияИдентификатор (Число) в Массив из Тег),
//              Запросов (Число обращений к хранилищам: 2 на пакет плюс по одному
//              на ручной тег).
//
Функция КаналыПакета(Знач ПакетИдентификатор) Экспорт

	СписокВерсий = СервисВерсий.ВерсииПакета(ПакетИдентификатор);
	Теги = ТегиПакета(ПакетИдентификатор);
	Запросов = 2;

	Каналы = Новый Массив();
	ПоВерсиям = Новый Соответствие();

	Для Каждого Тег Из Теги Цикл

		Канал = Состав.Канал(Тег, СписокВерсий);
		Запросов = Запросов + Канал.Запросов;

		Элемент = Новый Структура();
		Элемент.Вставить("Тег", Тег);
		Элемент.Вставить("Состав", Канал.Состав);
		Элемент.Вставить("Отдаваемая", Канал.Отдаваемая);
		Каналы.Добавить(Элемент);

		Для Каждого Версия Из Канал.Состав Цикл
			Список = ПоВерсиям.Получить(Версия.Идентификатор);
			Если Список = Неопределено Тогда
				Список = Новый Массив();
				ПоВерсиям.Вставить(Версия.Идентификатор, Список);
			КонецЕсли;
			Список.Добавить(Тег);
		КонецЦикла;

	КонецЦикла;

	Результат = Новый Структура();
	Результат.Вставить("Каналы", Каналы);
	Результат.Вставить("ПоВерсиям", ПоВерсиям);
	Результат.Вставить("Запросов", Запросов);
	Возврат Результат;

КонецФункции

// Строит раскладку «версия — её теги» для всего пакета. Отозванные версии из раскладки
// не выпадают; метки на чужие или исчезнувшие версии отсеиваются.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Соответствие - ВерсияИдентификатор (Число) в Массив из Тег.
//
Функция ТегиПоВерсиям(Знач ПакетИдентификатор) Экспорт
	Возврат КаналыПакета(ПакетИдентификатор).ПоВерсиям;
КонецФункции

// Возвращает имена тегов, создаваемых из коробки. Имени latest среди них нет: он был
// копией stable под другим именем. Имя не зарезервировано — завести его руками можно.
//
// Возвращаемое значение:
//  Массив из Строка - stable, prerelease.
//
Функция БазовыеИмена() Экспорт
	Результат = Новый Массив();
	Результат.Добавить(ИмяStable());
	Результат.Добавить(ИмяPrerelease());
	Возврат Результат;
КонецФункции

// Возвращает предопределённое правило базового имени: stable отбирает релизы без
// пререлизов, prerelease — все версии. Понимает legacy-алиас "dev".
//
// Параметры:
//  Имя - Строка - имя тега в любом регистре.
//
// Возвращаемое значение:
//  ПравилоТега, Неопределено - Неопределено, если имя не базовое.
//
Функция БазовоеПравило(Знач Имя) Экспорт

	ИмяНорм = ЛегасиАлиас(НормализованноеИмя(Имя));

	Если ИмяНорм = ИмяStable() Тогда
		Возврат Новый ПравилоТега("semver", "*");
	ИначеЕсли ИмяНорм = ИмяPrerelease() Тогда
		Возврат Новый ПравилоТега("semver", ">=0.0.0-0");
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Проверяет имя тега без исключения — предикат для контроллеров, чтобы 422 отдавался
// на некорректное имя, а не на любое исключение мутации.
//
// Параметры:
//  Имя - Строка - имя тега.
//
// Возвращаемое значение:
//  Булево - Истина, если имя допустимо.
//
Функция ИмяДопустимо(Знач Имя) Экспорт

	Попытка
		ПроверитьИмя(Имя);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

// Проверяет, упрётся ли заведение тега с таким именем в номер версии пакета. Вопрос
// дверей: отказ полагается объяснить до мутации, а тег, заведённый до запрета, правится
// как прежде — поэтому уже существующее имя препятствием не считается.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега.
//
// Возвращаемое значение:
//  Булево - Истина, если тега с таким именем ещё нет, а версия с таким номером есть.
//
Функция ИмяДляНовогоТегаЗанято(Знач ПакетИдентификатор, Знач Имя) Экспорт

	Если НайтиТег(ПакетИдентификатор, Имя) <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ИмяЗанятоВерсией(ПакетИдентификатор, Имя);

КонецФункции

// Возвращает правило тега как значение-объект — тип, выражение и предупреждение для
// UI и API.
//
// Параметры:
//  Тег - Тег - тег-канал.
//
// Возвращаемое значение:
//  ПравилоТега, Неопределено - Неопределено, если тег не в режиме «правило» либо запись
//                              правила повреждена.
//
Функция ПравилоИзТега(Знач Тег) Экспорт
	Возврат Состав.ПравилоКанала(Тег);
КонецФункции

#КонецОбласти

#Область УправлениеТегами

// Определяет тег режима «правило», создавая либо обновляя его. Состав канала считается
// правилом при обращении, поэтому запись правила и есть смена состава: в журнал попадает
// разница «до/после». Некорректное имя или правило — исключение.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега.
//  ТипПравила - Строка - semver или regex.
//  Правило - Строка - выражение отбора.
//  Кем - Строка - принципал для аудита (необязательный, по умолчанию "" — система).
//  Оформление - Структура, Неопределено - Стиль и Значок (ключи из СтильТега и
//               ЗначокТега); Неопределено — оформление не трогать (необязательный,
//               по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Тег - сохранённый тег.
//
Функция ОпределитьТегПравила(Знач ПакетИдентификатор, Знач Имя, Знач ТипПравила,
	Знач Правило, Знач Кем = "", Знач Оформление = Неопределено) Экспорт

	ИмяНорм = ПроверитьИмя(Имя);
	Выражение = Новый ПравилоТега(ТипПравила, Правило);
	Отбор.ПроверитьИсполнимость(Выражение);
	ОформлениеНорм = НормализованноеОформление(Оформление);

	СписокВерсий = СервисВерсий.ВерсииПакета(ПакетИдентификатор);
	Тег = НайтиИлиСоздать(ПакетИдентификатор, ИмяНорм);
	РежимДо = Строка(Тег.Режим);
	КаналДо = Состав.Канал(Тег, СписокВерсий);

	Тег.Режим = Режимы.Правило();
	Тег.ТипПравила = Выражение.Тип;
	Тег.Правило = Выражение.Выражение;
	ПрименитьОформление(Тег, ОформлениеНорм);
	Тег.Обновлён = ТекущаяУниверсальнаяДата();
	Тег.Сохранить();

	Если РежимДо <> Строка(Тег.Режим) Тогда
		// метки прежнего ручного режима — мусор: состав считает правило
		Состав.Очистить(Тег);
		Летопись.ЗаписатьСменуРежима(Тег, РежимДо, Кем);
	КонецЕсли;

	ЗаписатьСменуСостава(Тег, КаналДо, Состав.Канал(Тег, СписокВерсий), "правило", Кем);
	Возврат Тег;

КонецФункции

// Ставит ручной тег ровно на одну версию, создавая либо переставляя его: состав канала
// после вызова — эта версия и только она. Именно замена, а не добавление, — иначе откат
// канала на старую версию не сработал бы: резолв всё равно отдавал бы максимум.
// Неизвестная версия или некорректное имя — исключение.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега.
//  СтрокаВерсии - Строка - точная строка версии.
//  Кем - Строка - принципал для аудита (необязательный, по умолчанию "").
//  Оформление - Структура, Неопределено - Стиль и Значок (ключи из СтильТега и
//               ЗначокТега); Неопределено — оформление не трогать (необязательный,
//               по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Тег - сохранённый тег.
//
Функция ПереместитьТег(Знач ПакетИдентификатор, Знач Имя, Знач СтрокаВерсии, Знач Кем = "",
	Знач Оформление = Неопределено) Экспорт

	ИмяНорм = ПроверитьИмя(Имя);
	Версия = ТребоватьВерсию(ПакетИдентификатор, СтрокаВерсии);
	ОформлениеНорм = НормализованноеОформление(Оформление);

	Возврат УстановитьСостав(ПакетИдентификатор, ИмяНорм, Версия, "вручную", Кем, ОформлениеНорм);

КонецФункции

// Заводит либо переопределяет тег режима «ручной». Состав канала ведёт мейнтейнер, поэтому
// новый тег создаётся ПУСТЫМ: версии набираются у самих версий. Тег, бывший правилом,
// теряет правило и приходит к пустому составу. Некорректное имя — исключение.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега.
//  Кем - Строка - принципал для аудита (необязательный, по умолчанию "" — система).
//  Оформление - Структура, Неопределено - Стиль и Значок (ключи из СтильТега и
//               ЗначокТега); Неопределено — оформление не трогать (необязательный,
//               по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Тег - сохранённый тег.
//
Функция ОпределитьРучнойТег(Знач ПакетИдентификатор, Знач Имя, Знач Кем = "",
	Знач Оформление = Неопределено) Экспорт

	ИмяНорм = ПроверитьИмя(Имя);
	ОформлениеНорм = НормализованноеОформление(Оформление);

	СписокВерсий = СервисВерсий.ВерсииПакета(ПакетИдентификатор);
	Тег = НайтиИлиСоздать(ПакетИдентификатор, ИмяНорм);
	РежимДо = Строка(Тег.Режим);
	КаналДо = Состав.Канал(Тег, СписокВерсий);

	Тег.Режим = Режимы.Ручной();
	Тег.Правило = "";
	Тег.ТипПравила = "";
	ПрименитьОформление(Тег, ОформлениеНорм);
	Тег.Обновлён = ТекущаяУниверсальнаяДата();
	Тег.Сохранить();

	Если РежимДо <> Строка(Тег.Режим) Тогда
		Летопись.ЗаписатьСменуРежима(Тег, РежимДо, Кем);
	КонецЕсли;

	ЗаписатьСменуСостава(Тег, КаналДо, Состав.Канал(Тег, СписокВерсий), "ручной", Кем);
	Возврат Тег;

КонецФункции

// Добавляет версию в ручной канал, не трогая остальные его версии. Тега нет — создаётся
// ручным; тег в режиме «правило» — исключение, его состав считает правило.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега.
//  СтрокаВерсии - Строка - точная строка версии.
//  Кем - Строка - принципал для аудита (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Тег - сохранённый тег.
//
Функция ПометитьВерсию(Знач ПакетИдентификатор, Знач Имя, Знач СтрокаВерсии, Знач Кем = "") Экспорт
	Возврат ПравитьСостав(ПакетИдентификатор, Имя, СтрокаВерсии, Истина, Кем);
КонецФункции

// Снимает версию с ручного канала, не трогая остальные. Тег в режиме «правило»
// и отсутствующий тег — исключение.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега.
//  СтрокаВерсии - Строка - точная строка версии.
//  Кем - Строка - принципал для аудита (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Тег - сохранённый тег.
//
Функция СнятьМетку(Знач ПакетИдентификатор, Знач Имя, Знач СтрокаВерсии, Знач Кем = "") Экспорт
	Возврат ПравитьСостав(ПакетИдентификатор, Имя, СтрокаВерсии, Ложь, Кем);
КонецФункции

// Удаляет тег пакета вместе с его метками и пишет удаление в журнал.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега.
//  Кем - Строка - принципал для аудита (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Булево - Истина, если тег существовал и удалён.
//
Функция УдалитьТег(Знач ПакетИдентификатор, Знач Имя, Знач Кем = "") Экспорт

	Тег = НайтиТег(ПакетИдентификатор, Имя);
	Если Тег = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Отдаваемая = ВерсияТега(Тег);
	СтрокаВерсии = ?(Отдаваемая = Неопределено, "", Строка(Отдаваемая.Версия));
	// метки не должны пережить координату: висячие читались бы как живой ручной канал
	Состав.Очистить(Тег);
	Тег.Удалить();
	Летопись.ЗаписатьУдаление(ПакетИдентификатор, Имя, СтрокаВерсии, Кем);
	Возврат Истина;

КонецФункции

// Назначает тег тегом пакета по умолчанию — им резолвится установка без тега. Инвариант
// «не более одного по умолчанию» держится здесь: прежний снимается.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега.
//
// Возвращаемое значение:
//  Булево - Истина, если тег найден и назначен.
//
Функция НазначитьПоУмолчанию(Знач ПакетИдентификатор, Знач Имя) Экспорт

	Целевой = НайтиТег(ПакетИдентификатор, Имя);
	Если Целевой = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Тег Из ТегиПакета(ПакетИдентификатор) Цикл
		Если Тег.Идентификатор = Целевой.Идентификатор Тогда
			Продолжить;
		КонецЕсли;
		Если Тег.ПоУмолчанию = Истина Тогда
			Тег.ПоУмолчанию = Ложь;
			Тег.Сохранить();
		КонецЕсли;
	КонецЦикла;

	Целевой.ПоУмолчанию = Истина;
	Целевой.Сохранить();
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область Публикация

// Создаёт отсутствующие базовые теги пакета и назначает stable тегом по умолчанию, если
// умолчания ещё нет. Идемпотентна: существующие теги не переопределяются — оператор мог
// осознанно сменить правило.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Число - сколько тегов создано.
//
Функция ОбеспечитьБазовыеТеги(Знач ПакетИдентификатор) Экспорт

	Создано = 0;
	ЕстьУмолчание = Ложь;
	Для Каждого Тег Из ТегиПакета(ПакетИдентификатор) Цикл
		ЕстьУмолчание = ЕстьУмолчание ИЛИ Тег.ПоУмолчанию = Истина;
	КонецЦикла;

	Для Каждого Имя Из БазовыеИмена() Цикл
		Если НайтиТег(ПакетИдентификатор, Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// имя занято версией, попавшей в реестр до запрета: строки тега не будет, а само
		// имя резолвится предопределённым правилом и без неё
		Если ИмяЗанятоВерсией(ПакетИдентификатор, Имя) Тогда
			Продолжить;
		КонецЕсли;
		Правило = БазовоеПравило(Имя);
		ОпределитьТегПравила(ПакетИдентификатор, Имя, Правило.Тип, Правило.Выражение);
		Создано = Создано + 1;
	КонецЦикла;

	Если НЕ ЕстьУмолчание Тогда
		НазначитьПоУмолчанию(ПакетИдентификатор, ИмяStable());
	КонецЕсли;

	Возврат Создано;

КонецФункции

// Сообщает о попадании новой версии в каналы-правила: правило применяется к ОДНОЙ версии,
// и попавшие каналы пишут в журнал то же изменение состава, что и ручная правка. Ничего
// не материализуется — состав канала и без того считается правилом.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  СтрокаВерсии - Строка - строка опубликованной версии.
//  Кем - Строка - принципал для аудита (необязательный, по умолчанию "" — система).
//
// Возвращаемое значение:
//  Структура - Каналов (Число каналов, в которые попала версия), Запросов (Число
//              обращений к хранилищам: их число не зависит ни от версий, ни от тегов).
//
Функция ОбъявитьПопаданиеВКаналы(Знач ПакетИдентификатор, Знач СтрокаВерсии, Знач Кем = "") Экспорт

	СписокВерсий = СервисВерсий.ВерсииПакета(ПакетИдентификатор);
	Новая = НайтиСредиВерсий(СписокВерсий, СтрокаВерсии);
	Если Новая = Неопределено Тогда
		Возврат ИтогОбъявления(0, 1); // версии нет — объявлять нечего
	КонецЕсли;

	Каналов = 0;
	Для Каждого Тег Из ТегиПакета(ПакетИдентификатор) Цикл

		Правило = ПравилоИзТега(Тег);
		Если Правило = Неопределено Тогда
			Продолжить; // ручной канал публикация не двигает
		КонецЕсли;

		Если НЕ Отбор.ПодходитВерсия(Новая, Правило) Тогда
			Продолжить;
		КонецЕсли;

		Каналов = Каналов + 1;
		ЗаписатьПополнение(Тег, Новая, СписокВерсий, Правило, Кем);

	КонецЦикла;

	Возврат ИтогОбъявления(Каналов, 2);

КонецФункции

// Показывает результат правила без записи. Совпадения считаются по всем версиям пакета,
// включая отозванные; отдаваемая версия — только по действующим, потому что резолв
// отозванные не выдаёт. Некорректное правило — исключение.
//
// Параметры:
//  ПакетИдентификатор - Число - пакет, на версиях которого проверяется правило.
//  ТипПравила - Строка - semver или regex.
//  Правило - Строка - выражение отбора.
//
// Возвращаемое значение:
//  Структура - Версия (Строка, "" — отдавать нечего), Тип, Выражение, Предупреждение
//              (Строка, "" — предупреждать не о чем), Совпадения (Массив из Строка — все
//              версии, которые правило отберёт), Отозванные (Массив из Строка — какие
//              из совпавших отозваны).
//
Функция ПредпросмотрПравила(Знач ПакетИдентификатор, Знач ТипПравила, Знач Правило) Экспорт

	Выражение = Новый ПравилоТега(ТипПравила, Правило);
	Отбор.ПроверитьИсполнимость(Выражение);

	ВсеВерсии = СервисВерсий.ВерсииПакета(ПакетИдентификатор);

	Подходящие = Отбор.ОтобратьВерсии(ВсеВерсии, Выражение);

	Совпадения = Новый Массив();
	Отозванные = Новый Массив();
	Для Каждого Версия Из Подходящие Цикл
		Совпадения.Добавить(Версия.Версия);
		Если Версия.Отозвана = Истина Тогда
			Отозванные.Добавить(Версия.Версия);
		КонецЕсли;
	КонецЦикла;

	Выбранная = Состав.ОтдаваемаяСреди(Подходящие);

	Результат = Новый Структура();
	Результат.Вставить("Версия", ?(Выбранная = Неопределено, "", Строка(Выбранная.Версия)));
	Результат.Вставить("Тип", Выражение.Тип);
	Результат.Вставить("Выражение", Выражение.Выражение);
	Результат.Вставить("Предупреждение", Выражение.Предупреждение());
	Результат.Вставить("Совпадения", Совпадения);
	Результат.Вставить("Отозванные", Отозванные);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// «Было» — версия, которую канал отдавал без новой. Состав канала считается один раз,
// а второй выбор максимума нужен только если максимумом стала сама новая версия: снятие
// не-максимума максимума не двигает.
Процедура ЗаписатьПополнение(Знач Тег, Знач Новая, Знач СписокВерсий, Знач Правило, Знач Кем)

	СоставКанала = Отбор.ОтобратьВерсии(СписокВерсий, Правило);
	Стало = Состав.ОтдаваемаяСреди(СоставКанала);

	Если Стало <> Неопределено И Стало.Идентификатор = Новая.Идентификатор Тогда
		Прежние = Новый Массив();
		Для Каждого Версия Из СоставКанала Цикл
			Если Версия.Идентификатор <> Новая.Идентификатор Тогда
				Прежние.Добавить(Версия);
			КонецЕсли;
		КонецЦикла;
		Было = Состав.ОтдаваемаяСреди(Прежние);
	Иначе
		Было = Стало;
	КонецЕсли;

	Добавлено = Новый Массив();
	Добавлено.Добавить(Строка(Новая.Версия));

	Летопись.ЗаписатьИзменениеСостава(Тег, СтрокаОтдаваемой(Было), СтрокаОтдаваемой(Стало),
		Добавлено, Новый Массив(), "публикация", Кем);

КонецПроцедуры

Функция ИтогОбъявления(Знач Каналов, Знач Запросов)
	Результат = Новый Структура();
	Результат.Вставить("Каналов", Каналов);
	Результат.Вставить("Запросов", Запросов);
	Возврат Результат;
КонецФункции

Функция НайтиСредиВерсий(Знач СписокВерсий, Знач СтрокаВерсии)

	Искомая = СокрЛП(Строка(СтрокаВерсии));
	Для Каждого Версия Из СписокВерсий Цикл
		Если Строка(Версия.Версия) = Искомая Тогда
			Возврат Версия;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция УстановитьСостав(Знач ПакетИдентификатор, Знач ИмяНорм, Знач Версия,
	Знач Причина, Знач Кем, Знач ОформлениеНорм = Неопределено)

	СписокВерсий = СервисВерсий.ВерсииПакета(ПакетИдентификатор);
	Тег = НайтиИлиСоздать(ПакетИдентификатор, ИмяНорм);
	РежимДо = Строка(Тег.Режим);
	КаналДо = Состав.Канал(Тег, СписокВерсий);

	Тег.Режим = Режимы.Ручной();
	Тег.Правило = "";
	Тег.ТипПравила = "";
	ПрименитьОформление(Тег, ОформлениеНорм);
	Тег.Обновлён = ТекущаяУниверсальнаяДата();
	Тег.Сохранить(); // до записи меток: у новой строки появляется идентификатор

	Состав.ПометитьОдну(Тег, Версия);
	ЗаписатьСменуСостава(Тег, КаналДо, Состав.Канал(Тег, СписокВерсий), Причина, Кем);

	Если РежимДо <> Строка(Тег.Режим) Тогда
		Летопись.ЗаписатьСменуРежима(Тег, РежимДо, Кем);
	КонецЕсли;

	Возврат Тег;

КонецФункции

Функция ПравитьСостав(Знач ПакетИдентификатор, Знач Имя, Знач СтрокаВерсии,
	Знач Добавляем, Знач Кем)

	ИмяНорм = ПроверитьИмя(Имя);
	Версия = ТребоватьВерсию(ПакетИдентификатор, СтрокаВерсии);

	Тег = НайтиТег(ПакетИдентификатор, ИмяНорм);
	Если Тег <> Неопределено И Режимы.ЭтоПравило(Тег.Режим) Тогда
		ВызватьИсключение СтрШаблон(
			"Тег ""%1"" в режиме правила: его состав считается правилом, и ручная метка"
			+ " ни на что не влияет. Заведите отдельный тег либо переведите этот"
			+ " в ручной режим", ИмяНорм);
	КонецЕсли;

	Если Тег = Неопределено Тогда
		Если НЕ Добавляем Тогда
			ВызватьИсключение СтрШаблон("Тег ""%1"" не найден — снимать метку не с чего", ИмяНорм);
		КонецЕсли;
		Тег = НайтиИлиСоздать(ПакетИдентификатор, ИмяНорм);
		Тег.Режим = Режимы.Ручной();
		Тег.Сохранить();
	КонецЕсли;

	СписокВерсий = СервисВерсий.ВерсииПакета(ПакетИдентификатор);
	КаналДо = Состав.Канал(Тег, СписокВерсий);

	Изменилось = ?(Добавляем, Состав.Добавить(Тег, Версия), Состав.Снять(Тег, Версия));
	Если НЕ Изменилось Тогда
		Возврат Тег; // версия уже в канале либо её там и не было
	КонецЕсли;

	Тег.Обновлён = ТекущаяУниверсальнаяДата();
	Тег.Сохранить();

	ЗаписатьСменуСостава(Тег, КаналДо, Состав.Канал(Тег, СписокВерсий),
		?(Добавляем, "метка", "снятие метки"), Кем);

	Возврат Тег;

КонецФункции

// Журнал пишется только о реальной разнице составов: «до» и «после» уже в памяти.
Процедура ЗаписатьСменуСостава(Знач Тег, Знач КаналДо, Знач КаналПосле, Знач Причина, Знач Кем)

	Добавлено = РазностьСоставов(КаналПосле.Состав, КаналДо.Состав);
	Снято = РазностьСоставов(КаналДо.Состав, КаналПосле.Состав);
	Если Добавлено.Количество() = 0 И Снято.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Летопись.ЗаписатьИзменениеСостава(Тег,
		СтрокаОтдаваемой(КаналДо.Отдаваемая), СтрокаОтдаваемой(КаналПосле.Отдаваемая),
		Добавлено, Снято, Причина, Кем);

КонецПроцедуры

Функция РазностьСоставов(Знач Основной, Знач Вычитаемый)

	Множество = Новый Соответствие();
	Для Каждого Версия Из Вычитаемый Цикл
		Множество.Вставить(Версия.Идентификатор, Истина);
	КонецЦикла;

	Результат = Новый Массив();
	Для Каждого Версия Из Основной Цикл
		Если Множество.Получить(Версия.Идентификатор) <> Истина Тогда
			Результат.Добавить(Строка(Версия.Версия));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СтрокаОтдаваемой(Знач Версия)
	Возврат ?(Версия = Неопределено, "", Строка(Версия.Версия));
КонецФункции

// Имя тега сличается со строками версий тем же поиском, каким лесенка резолва берёт
// точную версию: имя канонизируется, строка версии ищется как есть.
Функция ИмяЗанятоВерсией(Знач ПакетИдентификатор, Знач Имя)
	Возврат СервисВерсий.НайтиВерсию(ПакетИдентификатор, НормализованноеИмя(Имя)) <> Неопределено;
КонецФункции

// Единственная точка создания тега: здесь держится уникальность пары «пакет + имя»
// и непересечение имени тега с номером версии. Существующий тег правится как прежде:
// запрет держит появление нового имени, а не правку заведённого до него.
Функция НайтиИлиСоздать(Знач ПакетИдентификатор, Знач ИмяНорм)

	Тег = НайтиТег(ПакетИдентификатор, ИмяНорм);
	Если Тег <> Неопределено Тогда
		Возврат Тег;
	КонецЕсли;

	Если ИмяЗанятоВерсией(ПакетИдентификатор, ИмяНорм) Тогда
		ВызватьИсключение СтрШаблон(
			"Имя ""%1"" занято версией пакета: спецификацию ""пакет@%1"" резолв читает"
			+ " сначала точной версией, и тег с таким именем остался бы недостижим."
			+ " Назовите тег иначе", ИмяНорм);
	КонецЕсли;

	Тег = ХранилищеТегов.СоздатьЭлемент();
	Тег.ПакетИдентификатор = ПакетИдентификатор;
	Тег.Имя = ИмяНорм;
	Тег.Режим = Режимы.Ручной();
	Тег.Правило = "";
	Тег.ТипПравила = "";
	Тег.Стиль = Стили.Обычный();
	Тег.Значок = Значки.Нет();
	Тег.ПоУмолчанию = Ложь;
	Тег.КемИдентификатор = 0;
	Тег.Обновлён = ТекущаяУниверсальнаяДата();
	Возврат Тег;

КонецФункции

// Оформление сводится к ключам ДО первой записи. Незнакомый ключ не отказ, а
// умолчание: стиль и значок — оформление, и мусор в них не повод не сохранить тег.
Функция НормализованноеОформление(Знач Оформление)

	Если Оформление = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Стиль = Неопределено;
	Значок = Неопределено;
	Оформление.Свойство("Стиль", Стиль);
	Оформление.Свойство("Значок", Значок);
	Возврат Новый Структура("Стиль, Значок",
		Стили.Нормализовать(Стиль), Значки.Нормализовать(Значок));

КонецФункции

Процедура ПрименитьОформление(Тег, Знач ОформлениеНорм)

	Если ОформлениеНорм = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Тег.Стиль = ОформлениеНорм.Стиль;
	Тег.Значок = ОформлениеНорм.Значок;

КонецПроцедуры

Функция ТребоватьВерсию(Знач ПакетИдентификатор, Знач СтрокаВерсии)

	Версия = СервисВерсий.НайтиВерсию(ПакетИдентификатор, СтрокаВерсии);
	Если Версия = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Версия ""%1"" не найдена — тег ставить не на что", Строка(СтрокаВерсии));
	КонецЕсли;
	Возврат Версия;

КонецФункции

// Имя участвует в URL и в записи "pkg@tag", поэтому алфавит ограничен.
Функция ПроверитьИмя(Знач Имя)

	ИмяНорм = НормализованноеИмя(Имя);
	Если ПустаяСтрока(ИмяНорм) Тогда
		ВызватьИсключение "Не задано имя тега";
	КонецЕсли;
	Если СтрДлина(ИмяНорм) > 64 Тогда
		ВызватьИсключение СтрШаблон("Имя тега ""%1"" длиннее 64 символов", ИмяНорм);
	КонецЕсли;

	Допустимые = "abcdefghijklmnopqrstuvwxyz0123456789-_.";
	Для Позиция = 1 По СтрДлина(ИмяНорм) Цикл
		Если СтрНайти(Допустимые, Сред(ИмяНорм, Позиция, 1)) = 0 Тогда
			ВызватьИсключение СтрШаблон(
				"Недопустимый символ в имени тега ""%1"": разрешены латиница, цифры, дефис,"
				+ " подчёркивание и точка", ИмяНорм);
		КонецЕсли;
	КонецЦикла;

	Возврат ИмяНорм;

КонецФункции

// Алиас /dev-channel маппится на тег prerelease: контракт opm не меняется.
Функция ЛегасиАлиас(Знач ИмяНорм)
	Возврат ?(ИмяНорм = "dev", ИмяPrerelease(), ИмяНорм);
КонецФункции

Функция НормализованноеИмя(Знач Имя)
	Возврат НРег(СокрЛП(Строка(Имя)));
КонецФункции

Функция ИмяStable()
	Возврат "stable";
КонецФункции

Функция ИмяPrerelease()
	Возврат "prerelease";
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеТегов") _ХранилищеТегов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "ОтборВерсийПоПравилу") _Отбор,
	&Пластилин(Значение = "РежимТега") _Режимы,
	&Пластилин(Значение = "ЛетописьТегов") _Летопись,
	&Пластилин(Значение = "СоставКаналов") _Состав,
	&Пластилин(Значение = "СтильТега") _Стили,
	&Пластилин(Значение = "ЗначокТега") _Значки)

	ХранилищеТегов = _ХранилищеТегов;
	СервисВерсий = _СервисВерсий;
	Отбор = _Отбор;
	Режимы = _Режимы;
	Летопись = _Летопись;
	Состав = _Состав;
	Стили = _Стили;
	Значки = _Значки;

КонецПроцедуры
