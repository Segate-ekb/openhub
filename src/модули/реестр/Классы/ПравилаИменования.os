// Валидация и канонизация имён пакетов, пулов и логинов; правила — ospx-tools.
// NFC-нормализация не выполняется (в OneScript нет примитива): имена всё равно ASCII.

#Использовать ospx-tools

// Проверяет корректность имени пакета или пула.
//
// Параметры:
//  Имя - Строка - проверяемое имя.
//
// Возвращаемое значение:
//  Булево - Истина, если имя допустимо.
//
Функция ИмяКорректно(Знач Имя) Экспорт

	Если ТипЗнч(Имя) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ПакетыOspx.ИмяПакетаКорректно(Имя);

КонецФункции

// Проверяет имя; некорректное — исключение с описанием правил именования.
//
// Параметры:
//  Имя - Строка - проверяемое имя.
//
Процедура ПроверитьИмя(Знач Имя) Экспорт

	Если НЕ ИмяКорректно(Имя) Тогда
		ВызватьИсключение СтрШаблон(
			"Некорректное имя ""%1"": допустимы латинские буквы, цифры, ""-"", ""_"", ""."" (первый символ — буква или цифра, длина до 100 символов)",
			Имя);
	КонецЕсли;

КонецПроцедуры

// Канонизирует имя: проверка корректности плюс нижний регистр. Канонический вид —
// ключ уникальности. Некорректное имя — исключение.
//
// Параметры:
//  Имя - Строка - имя в любом регистре.
//
// Возвращаемое значение:
//  Строка - каноническое имя.
//
Функция Канонизировать(Знач Имя) Экспорт

	Обрезанное = ?(ТипЗнч(Имя) = Тип("Строка"), СокрЛП(Имя), Имя);
	ПроверитьИмя(Обрезанное);
	Возврат НРег(Обрезанное);

КонецФункции

// Имена пулов, совпадающие с литеральными маршрутами первого сегмента: winow —
// first-match без бэктрекинга, такой пул был бы недостижим. Новый литеральный маршрут
// первого сегмента обязан добавляться сюда вместе с маршрутом.
//
// Возвращаемое значение:
//  Массив из Строка - зарезервированные имена в нижнем регистре.
//
Функция ЗарезервированныеИменаПулов() Экспорт
	Возврат СтрРазделить(
		"health,ready,packages,package,api,login,register,setup,office,download,static,assets,"
		+ "me,hub,groups,logout,push,pools,dev-channel,oidc,settings,"
		+ "tour,invite,confirm-email,forgot-password,cli,"
		+ "ui,brand", ",");
КонецФункции

// Проверяет, зарезервировано ли имя пула под литеральный маршрут.
//
// Параметры:
//  Имя - Строка - имя пула в любом регистре.
//
// Возвращаемое значение:
//  Булево - Истина, если имя недопустимо для пула.
//
Функция ИмяПулаЗарезервировано(Знач Имя) Экспорт
	Возврат ЗарезервированныеИменаПулов().Найти(Канон(Имя)) <> Неопределено;
КонецФункции

// Имена пакетов, совпадающие с литеральными маршрутами второго сегмента (/{pool}/…).
// Список намеренно короче списка пулов: пакету мешают только литералы под /{pool}/.
//
// Возвращаемое значение:
//  Массив из Строка - зарезервированные имена в нижнем регистре.
//
Функция ЗарезервированныеИменаПакетов() Экспорт
	Возврат СтрРазделить("settings", ",");
КонецФункции

// Проверяет, зарезервировано ли имя пакета под литеральный маршрут второго сегмента.
//
// Параметры:
//  Имя - Строка - имя пакета в любом регистре.
//
// Возвращаемое значение:
//  Булево - Истина, если имя недопустимо для пакета.
//
Функция ИмяПакетаЗарезервировано(Знач Имя) Экспорт
	Возврат ЗарезервированныеИменаПакетов().Найти(Канон(Имя)) <> Неопределено;
КонецФункции

// Проверяет, зарезервирован ли логин под системный сегмент URL. Список общий с пулами:
// логин становится первым сегментом адреса личного пула.
//
// Параметры:
//  Логин - Строка - логин в любом регистре.
//
// Возвращаемое значение:
//  Булево - Истина, если логин недопустим.
//
Функция ЛогинЗарезервирован(Знач Логин) Экспорт
	Возврат ЗарезервированныеИменаПулов().Найти(Канон(Логин)) <> Неопределено;
КонецФункции

// Проверяет логин; зарезервированный — исключение с объяснением.
//
// Параметры:
//  Логин - Строка - логин в любом регистре.
//
Процедура ПроверитьЛогин(Знач Логин) Экспорт

	Если ЛогинЗарезервирован(Логин) Тогда
		ВызватьИсключение СтрШаблон(
			"Логин ""%1"" зарезервирован хабом: логины и имена пулов делят первый сегмент адреса,"
			+ " и такое имя перекрыл бы системный маршрут. Выберите другой логин.", Логин);
	КонецЕсли;

КонецПроцедуры

Функция Канон(Знач Значение)
	Возврат НРег(СокрЛП(?(ТипЗнч(Значение) = Тип("Строка"), Значение, Строка(Значение))));
КонецФункции

// Проверяет безопасность URL репозитория: допустимы пустой адрес и абсолютный http/https.
// Прочие схемы (javascript:, data:) дают stored XSS при выводе как href.
//
// Параметры:
//  URL - Строка - адрес репозитория, недоверенное поле манифеста.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес безопасно хранить и выводить.
//
Функция АдресРепозиторияБезопасен(Знач URL) Экспорт
	Если НЕ ЗначениеЗаполнено(URL) Тогда
		Возврат Истина;
	КонецЕсли;
	Схема = СхемаURL(URL);
	Возврат Схема = "http" ИЛИ Схема = "https";
КонецФункции

// Возвращает нормализованную схему URL. Управляющие символы и пробелы вырезаются:
// браузер игнорирует их внутри схемы ("java\tscript:" эквивалентно "javascript:").
//
// Параметры:
//  URL - Строка - произвольный адрес.
//
// Возвращаемое значение:
//  Строка - схема без двоеточия в нижнем регистре либо "" для относительного адреса.
//
Функция СхемаURL(Знач URL) Экспорт

	Исходный = Строка(URL);
	Очищенный = "";
	Для Поз = 1 По СтрДлина(Исходный) Цикл
		Символ = Сред(Исходный, Поз, 1);
		Если КодСимвола(Символ) > 32 Тогда
			Очищенный = Очищенный + Символ;
		КонецЕсли;
	КонецЦикла;

	Нижний = НРег(Очищенный);
	ПозицияДвоеточия = СтрНайти(Нижний, ":");
	Если ПозицияДвоеточия = 0 Тогда
		Возврат ""; // нет схемы — относительный URL
	КонецЕсли;

	// двоеточие после структурного разделителя — схемы нет ("foo/bar:baz", "?a=b:c")
	Для Поз = 1 По ПозицияДвоеточия - 1 Цикл
		Символ = Сред(Нижний, Поз, 1);
		Если Символ = "/" ИЛИ Символ = "?" ИЛИ Символ = "#" Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	Возврат Лев(Нижний, ПозицияДвоеточия - 1);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
