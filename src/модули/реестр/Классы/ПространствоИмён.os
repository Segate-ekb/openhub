// Имена пулов и логины делят первый сегмент URL — двусторонняя проверка занятости.
// Статический резерв системных сегментов — в ПравилаИменования.

Перем ХранилищеПулов;          // ХранилищеПулов (данные)
Перем ХранилищеПользователей;  // ХранилищеПользователей (данные)
Перем Строки;                  // КанонСтроки (основа)

#Область ПубличныйИнтерфейс

// Проверяет, занято ли имя логином существующего пользователя.
//
// Параметры:
//  Имя - Строка - имя в любом регистре.
//
// Возвращаемое значение:
//  Булево - Истина, если такой логин есть.
//
Функция ЗанятоЛогином(Знач Имя) Экспорт
	Возврат ХранилищеПользователей.НайтиПоЛогину(Канон(Имя)) <> Неопределено;
КонецФункции

// Проверяет, занято ли имя существующим пулом.
//
// Параметры:
//  Имя - Строка - имя в любом регистре.
//
// Возвращаемое значение:
//  Булево - Истина, если такой пул есть.
//
Функция ЗанятоПулом(Знач Имя) Экспорт
	Возврат ХранилищеПулов.ПолучитьОдноПоИмяРавно(Канон(Имя)) <> Неопределено;
КонецФункции

// Проверяет, что имя свободно для пула; занятое логином — исключение.
//
// Параметры:
//  Имя - Строка - предполагаемое имя пула.
//  СвойЛогин - Строка - логин владельца личного пула, совпадение с которым не считается
//              коллизией; берётся из созданной учётки, а не из пользовательского ввода
//              (необязательный, по умолчанию "").
//
Процедура ПроверитьСвободноДляПула(Знач Имя, Знач СвойЛогин = "") Экспорт

	Если ЗначениеЗаполнено(СвойЛогин) И Канон(СвойЛогин) = Канон(Имя) Тогда
		Возврат;
	КонецЕсли;

	Если ЗанятоЛогином(Имя) Тогда
		ВызватьИсключение СтрШаблон(
			"Имя пула ""%1"" занято логином пользователя: имена пулов и логины делят первый"
			+ " сегмент адреса (/%1/…), и личное пространство этого пользователя уже стоит"
			+ " по этому адресу. Выберите другое имя пула.", Канон(Имя));
	КонецЕсли;

КонецПроцедуры

// Проверяет, что имя свободно для логина; занятое пулом — исключение.
//
// Параметры:
//  Логин - Строка - предполагаемый логин.
//
Процедура ПроверитьСвободноДляЛогина(Знач Логин) Экспорт

	Если ЗанятоПулом(Логин) Тогда
		ВызватьИсключение СтрШаблон(
			"Логин ""%1"" занят именем пула: имена пулов и логины делят первый сегмент адреса"
			+ " (/%1/…), и личное пространство с таким адресом создать нельзя."
			+ " Выберите другой логин.", Канон(Логин));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

Функция Канон(Знач Значение)
	Возврат Строки.Канон(Значение);
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПулов") _ХранилищеПулов,
	&Пластилин(Значение = "ХранилищеПользователей") _ХранилищеПользователей,
	&Пластилин(Значение = "КанонСтроки") _Строки = Неопределено)

	Строки = ?(_Строки = Неопределено, Новый КанонСтроки(), _Строки);
	ХранилищеПулов = _ХранилищеПулов;
	ХранилищеПользователей = _ХранилищеПользователей;

КонецПроцедуры
