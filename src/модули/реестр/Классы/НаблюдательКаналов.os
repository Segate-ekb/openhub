// Подписчик на публикацию версии: сообщает, в какие каналы-правила попала новая версия,
// и заводит новому пакету каналы по умолчанию, если пул это разрешил.

Перем СервисТегов;   // СервисТегов
Перем СервисПакетов; // СервисПакетов
Перем Каналы;        // КаналыПоУмолчанию — предложение визарда, оно же автоматика пула
Перем Издатель;      // ИздательСобытий
Перем Ошибки;        // ТекстОшибки (основа)
&Лог
Перем Лог;
Перем ЧтениеПолей;   // ЧтениеПолей (основа)

#Область КонтрактПодписчикаСобытий

// Обрабатывает событие публикации версии: объявляет попадание версии в каналы-правила
// и на разрешившем это пуле заводит новому пакету каналы по умолчанию. Ошибка гасится
// и логируется — публикация уже состоялась, ронять её нельзя.
//
// Параметры:
//  Событие - Структура - доменное событие с полями Тип, Когда, Данные.
//
Процедура ОбработатьСобытие(Знач Событие) Экспорт

	Попытка
		ОбработатьПубликацию(Событие);
	Исключение
		Лог.Предупреждение("Каналы пакета не обновлены: %1",
			Ошибки.Причина(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ПубличныйИнтерфейс

// Подписывает рогатку на событие публикации версии. Без издателя (частичный контейнер)
// подписка пропускается с предупреждением в лог.
//
Процедура ПриЗапускеПриложения() Экспорт

	Если Издатель = Неопределено Тогда
		Лог.Предупреждение(
			"Наблюдатель каналов не подписан: издатель событий недоступен (частичный контейнер)");
		Возврат;
	КонецЕсли;

	Издатель.Подписать(Издатель.ТипВерсияОпубликована(), ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработатьПубликацию(Знач Событие)

	ПакетИдентификатор = ОпределитьПакет(Событие.Данные);
	Если НЕ ЗначениеЗаполнено(ПакетИдентификатор) Тогда
		Лог.Отладка("Каналы: пакет по событию ""%1"" не определён — теги не трогаем",
			Событие.Тип);
		Возврат;
	КонецЕсли;

	Каналы.ЗавестиЕслиРазрешилПул(ПакетИдентификатор);

	СтрокаВерсии = Поле(Событие.Данные, "Версия", "");
	Перезапись = ЭтоПерезапись(Событие.Данные);
	Лог.Отладка("Каналы: пакет #%1, версия ""%2"", перезапись: %3",
		ПакетИдентификатор, СтрокаВерсии, Перезапись);

	Если НЕ ЗначениеЗаполнено(СтрокаВерсии) ИЛИ Перезапись Тогда
		Возврат;
	КонецЕсли;

	СервисТегов.ОбъявитьПопаданиеВКаналы(ПакетИдентификатор, СтрокаВерсии);

КонецПроцедуры

// Перезапись состав каналов не меняет — строка версии та же, — и объявлять о попадании нечего.
Функция ЭтоПерезапись(Знач Данные)
	Возврат СтрНачинаетсяС(НРег(Строка(Поле(Данные, "Действие", ""))), "перезапись");
КонецФункции

// Идентификатор пакета из полезной нагрузки события; 0 — определить не удалось.
Функция ОпределитьПакет(Знач Данные)

	Прямой = Поле(Данные, "ПакетИдентификатор", 0);
	Если ЗначениеЗаполнено(Прямой) Тогда
		Возврат Прямой;
	КонецЕсли;

	ПулИдентификатор = Поле(Данные, "ПулИдентификатор", 0);
	ИмяПакета = Поле(Данные, "ИмяПакета", "");
	Если НЕ ЗначениеЗаполнено(ПулИдентификатор) ИЛИ НЕ ЗначениеЗаполнено(ИмяПакета) Тогда
		Возврат 0;
	КонецЕсли;

	Пакет = СервисПакетов.НайтиПакет(ПулИдентификатор, ИмяПакета);
	Возврат ?(Пакет = Неопределено, 0, Пакет.Идентификатор);

КонецФункции

Функция Поле(Знач Данные, Знач Имя, Знач ПоУмолчанию)
	Возврат ЧтениеПолей.Поле(Данные, Имя, ПоУмолчанию);
КонецФункции

#КонецОбласти

&Рогатка(ЗапускатьВФоне = Ложь)
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "КаналыПоУмолчанию") _Каналы,
	// издатель опционален: core-registry грузится и без модуля события
	&Пластилин(Значение = "ИздательСобытий") _Издатель = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Пластилин(Значение = "ЧтениеПолей") _ЧтениеПолей = Неопределено)

	ЧтениеПолей = ?(_ЧтениеПолей = Неопределено, Новый ЧтениеПолей(), _ЧтениеПолей);

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	СервисТегов = _СервисТегов;
	СервисПакетов = _СервисПакетов;
	Каналы = _Каналы;
	Издатель = _Издатель;

КонецПроцедуры
