// Запуск доверенного конвейера, принявшего версию: страница релиза и логин запустившего на
// github.com. Строку ставит приём версии и переписывает каждая публикация; нет строки — нет запуска.

Перем Хранилище; // ХранилищеЗапусковКонвейеров
Перем Пулы;      // СервисПулов
Перем Пакеты;    // СервисПакетов
Перем Версии;    // СервисВерсий

#Область ПубличныйИнтерфейс

// Запоминает запуск конвейера, принявшего версию. Пустой запуск (Неопределено либо без релиза
// и запустившего) снимает прежнюю строку: публикация другим путём — уже не из того запуска.
// Строка одна на версию: повторная фиксация переписывает её, а не добавляет вторую.
//
// Параметры:
//  Версия - ВерсияПакета - принятая версия.
//  Запуск - Структура, Неопределено - Релиз (Строка — страница релиза), ЗапустившийGitHub
//           (Строка — логин запустившего на github.com).
//
&Наблюдаемый
Процедура Зафиксировать(Знач Версия, Знач Запуск) Экспорт

	Если Версия = Неопределено Тогда
		ВызватьИсключение "Запуск конвейера фиксируется для существующей версии";
	КонецЕсли;

	Релиз = ПолеЗапуска(Запуск, "Релиз");
	Запустивший = ПолеЗапуска(Запуск, "ЗапустившийGitHub");
	Запись = Хранилище.ПолучитьОдноПоВерсияИдентификаторРавно(Цел(Версия.Идентификатор));

	Если НЕ ЗначениеЗаполнено(Релиз) И НЕ ЗначениеЗаполнено(Запустивший) Тогда
		Если Запись <> Неопределено Тогда
			Хранилище.Удалить(Запись);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Запись = Неопределено Тогда
		Запись = Хранилище.СоздатьЭлемент();
		Запись.ВерсияИдентификатор = Цел(Версия.Идентификатор);
	КонецЕсли;
	Запись.ПакетИдентификатор = Цел(Версия.ПакетИдентификатор);
	Запись.Релиз = Релиз;
	Запись.ЗапустившийGitHub = Запустивший;
	Запись.Зафиксировано = ТекущаяУниверсальнаяДата();
	Запись.Сохранить();

КонецПроцедуры

// Страница релиза, из которого доверенный конвейер опубликовал версию.
//
// Параметры:
//  Версия - ВерсияПакета, Неопределено - версия.
//
// Возвращаемое значение:
//  Строка - адрес страницы релиза; "" — версия не из релиза.
//
&Наблюдаемый
Функция АдресРелиза(Знач Версия) Экспорт
	Запись = ЗапускВерсии(Версия);
	Возврат ?(Запись = Неопределено, "", Текстом(Запись.Релиз));
КонецФункции

// Логин того, на чей запуск конвейера github.com выдан id-token, принявший версию.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//  СтрокаВерсии - Строка - версия.
//
// Возвращаемое значение:
//  Строка - логин; "" — версии нет либо её принял не конвейер github.com.
//
&Наблюдаемый
Функция ЗапустившийGitHub(Знач ИмяПула, Знач ИмяПакета, Знач СтрокаВерсии) Экспорт

	Пул = Пулы.ПулДляЧтения(ИмяПула);
	Если Пул = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Пакет = Пакеты.ПакетДляЧтения(Пул.Идентификатор, ИмяПакета);
	Если Пакет = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Запись = ЗапускВерсии(Версии.НайтиВерсиюДляЧтения(Пакет.Идентификатор, СтрокаВерсии));
	Возврат ?(Запись = Неопределено, "", Текстом(Запись.ЗапустившийGitHub));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗапускВерсии(Знач Версия)
	Если Версия = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Хранилище.ПолучитьОдноПоВерсияИдентификаторРавно(Цел(Версия.Идентификатор));
КонецФункции

Функция ПолеЗапуска(Знач Запуск, Знач Имя)
	Значение = Неопределено;
	Если ТипЗнч(Запуск) = Тип("Структура") Тогда
		Запуск.Свойство(Имя, Значение);
	КонецЕсли;
	Возврат Текстом(Значение);
КонецФункции

Функция Текстом(Знач Значение)
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеЗапусковКонвейеров") _Хранилище,
	&Пластилин(Значение = "СервисПулов") _Пулы,
	&Пластилин(Значение = "СервисПакетов") _Пакеты,
	&Пластилин(Значение = "СервисВерсий") _Версии)

	Хранилище = _Хранилище;
	Пулы = _Пулы;
	Пакеты = _Пакеты;
	Версии = _Версии;

КонецПроцедуры
