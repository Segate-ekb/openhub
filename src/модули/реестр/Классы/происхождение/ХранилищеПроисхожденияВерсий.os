// Хранилище провенанса версий — репозиторий сущности «ПроисхождениеВерсии».
// Инвариант «одна запись на версию» держит СервисПроисхождения (check-and-set).

// BSLLS:UnusedParameters-off

Перем Сам;          // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё
Перем ФормаСнимка;  // ФормаСнимка (данные) — снимок записи провенанса для кэша; строится при первом снимке

// Провенанс конкретной версии.
//
// Параметры:
//  ВерсияИдентификатор - Число - идентификатор версии пакета.
//
// Возвращаемое значение:
//  ПроисхождениеВерсии, Неопределено - запись провенанса.
//
&МетодЗапроса
Функция ПолучитьОдноПоВерсияИдентификаторРавно(ВерсияИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Провенанс всех версий пакета (для вопроса «есть ли своя версия» одним запросом).
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив из ПроисхождениеВерсии.
//
&МетодЗапроса
Функция ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Провенанс версий сразу нескольких пакетов.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Массив из ПроисхождениеВерсии.
//
&МетодЗапроса
Функция ПолучитьПоПакетИдентификаторВ(ПакетИдентификаторы) Экспорт
	Возврат Неопределено;
КонецФункции

// Провенанс версий сразу нескольких пакетов — там, где вопрос «чьё это имя» задаётся
// про целый список: карточки каталога и порция среза изменений.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Массив из ПроисхождениеВерсии.
//
Функция ПровенансПакетов(Знач ПакетИдентификаторы) Экспорт

	Если ПакетИдентификаторы.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат Сам.Достать().ПолучитьПоПакетИдентификаторВ(ПакетИдентификаторы);

КонецФункции

// Снимки записей провенанса пакета из кэша «происхождениеПакета», только для чтения.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  ФиксированныйМассив из ФиксированнаяСтруктура - снимки записей провенанса.
//
&Кэшируемый("происхождениеПакета")
Функция СнимкиПакета(Знач ПакетИдентификатор) Экспорт
	Возврат Форма().Снимки(Сам.Достать().ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор));
КонецФункции

// Забывает снимки провенанса пакета: зовёт каждый, кто записал или удалил провенанс.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
&СбрасываетКэш("происхождениеПакета")
Процедура ЗабытьСнимкиПакета(Знач ПакетИдентификатор) Экспорт
КонецПроцедуры

// Модель сущности есть только у собранного репозитория, поэтому форма снимка строится при первом снимке.
Функция Форма()
	Если ФормаСнимка = Неопределено Тогда
		ФормаСнимка = Новый ФормаСнимка(Сам.Достать().ПолучитьОбъектМодели());
	КонецЕсли;
	Возврат ФормаСнимка;
КонецФункции

&ХранилищеСущностей("ПроисхождениеВерсии")
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин(Значение = "ХранилищеПроисхожденияВерсий") _Сам)
	Сам = _Сам;
КонецПроцедуры
