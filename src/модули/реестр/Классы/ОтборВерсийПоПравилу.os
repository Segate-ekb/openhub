// Отбор версий по ПравилуТега: все подходящие (состав канала) и максимальная из них.
// Чистая функция от (версии, правило) — ни сети, ни записи.
//
// Semver-правило сопоставляется по колонкам версии (SemverМажор, SemverМинор, SemverПатч,
// SemverПререлиз), заполненным при публикации: повторный разбор строки на каждом кандидате
// стоил дороже самого сравнения. Колонки не заполнены — кандидат разбирается по строке.
// Версия вне semver-порядка (SNAPSHOT) не подходит ни под одно semver-правило: ни в latest,
// ни в stable, ни в prerelease она не попадает. Regex-правило по-прежнему ловит её строкой —
// собственный тег на снапшоты человек завести может.

Перем Резолвер;       // РезолверВерсий

#Область ПубличныйИнтерфейс

// Выбирает максимальную версию, подходящую под правило. Отозванные версии отсеивает
// вызывающий, подавая нужный список.
//
// Параметры:
//  Версии - Массив из ВерсияПакета - кандидаты.
//  Правило - ПравилоТега - правило отбора.
//
// Возвращаемое значение:
//  ВерсияПакета, Неопределено - выбранная версия либо Неопределено, если совпадений нет.
//
Функция ВыбратьВерсию(Знач Версии, Знач Правило) Экспорт

	Если Версии = Неопределено ИЛИ Версии.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Выбранная = ЛучшаяСтрока(Версии, Правило);
	Если Выбранная = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Версия Из Версии Цикл
		Если Версия.Версия = Выбранная Тогда
			Возврат Версия;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Отбирает все версии, подходящие под правило, за один проход.
//
// Параметры:
//  Версии - Массив из ВерсияПакета - кандидаты.
//  Правило - ПравилоТега - правило отбора.
//
// Возвращаемое значение:
//  Массив из ВерсияПакета - подходящие версии в исходном порядке.
//
Функция ОтобратьВерсии(Знач Версии, Знач Правило) Экспорт

	Результат = Новый Массив();
	Если Версии = Неопределено ИЛИ Версии.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Версия Из Версии Цикл
		Если ПодходитВерсия(Версия, Правило) Тогда
			Результат.Добавить(Версия);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Проверяет одну версию — горячий путь публикации: правило применяется к новой версии,
// а не к списку.
//
// Параметры:
//  Версия - ВерсияПакета - проверяемая версия.
//  Правило - ПравилоТега - правило отбора.
//
// Возвращаемое значение:
//  Булево - Истина, если версия попадает в правило.
//
Функция ПодходитВерсия(Знач Версия, Знач Правило) Экспорт

	СтрокаВерсии = Строка(Версия.Версия);
	Если Правило.Тип <> Правило.ТипSemver() Тогда
		Возврат Правило.ПодходитСтрока(СтрокаВерсии); // regex работает по строке
	КонецЕсли;

	Возврат Правило.ПодходитСтрока(СтрокаВерсии, РазобратьВерсию(Версия));

КонецФункции

// Возвращает версию, разобранную по её колонкам, — вход отбора и резолвера, которые иначе
// разбирали бы строку заново на каждом кандидате. У legacy-версии четвёртая компонента
// лежит в SemverСборка, пререлиза у неё не бывает.
//
// Параметры:
//  Версия - ВерсияПакета - версия пакета.
//
// Возвращаемое значение:
//  РазобраннаяВерсия, Неопределено - Неопределено, если колонки не заполнены: такой
//                                    кандидат разбирается по строке.
//
Функция РазобратьВерсию(Знач Версия) Экспорт

	Попытка
		// версия вне semver-порядка (SNAPSHOT): semver-колонки у неё нулевые, и выдать их
		// за 0.0.0 значило бы сделать её кандидатом в latest у пакета без релизов
		Если Версия.ПризнакВнеПорядка = Истина Тогда
			Возврат Неопределено;
		КонецЕсли;

		Легаси = (Версия.ПризнакLegacyВерсии = Истина);

		Компоненты = Новый Структура();
		Компоненты.Вставить("Мажор", Число(Версия.SemverМажор));
		Компоненты.Вставить("Минор", Число(Версия.SemverМинор));
		Компоненты.Вставить("Патч", Число(Версия.SemverПатч));
		Компоненты.Вставить("Четвертая", ?(Легаси, Число(Версия.SemverСборка), 0));
		Компоненты.Вставить("Пререлиз", ?(Легаси, "", СокрЛП(Строка(Версия.SemverПререлиз))));
		Компоненты.Вставить("МетаданныеСборки", ?(Легаси, "", СокрЛП(Строка(Версия.SemverСборка))));
		Компоненты.Вставить("ПризнакLegacy", Легаси);

		Возврат Новый РазобраннаяВерсия(Строка(Версия.Версия), Компоненты);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Проверяет исполнимость правила, включая грамматику semver-диапазона.
// Неисполнимое правило — исключение.
//
// Параметры:
//  Правило - ПравилоТега - проверяемое правило.
//
Процедура ПроверитьИсполнимость(Знач Правило) Экспорт

	Если Правило.Тип <> Правило.ТипSemver() Тогда
		Возврат; // regex уже скомпилирован ПравиломТега
	КонецЕсли;

	// резолв по пустому списку: совпадений заведомо нет, мусорный диапазон — исключение
	Резолвер.МаксимальнаяПоДиапазону(Новый Массив(), Правило.Выражение);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЛучшаяСтрока(Знач Кандидаты, Знач Правило)

	// резолвер принимает и готовую версию, и строку: разбор по колонкам избавляет его
	// от повторного разбора строки на каждом кандидате
	Строки = Новый Массив();
	Для Каждого Версия Из Кандидаты Цикл
		Разобранная = РазобратьВерсию(Версия);
		Строки.Добавить(?(Разобранная = Неопределено, Версия.Версия, Разобранная));
	КонецЦикла;

	Если Правило.Тип = Правило.ТипSemver() Тогда
		Возврат Резолвер.МаксимальнаяПоДиапазону(Строки, Правило.Выражение);
	КонецЕсли;

	Возврат Резолвер.МаксимальнаяПоРегулярному(Строки, Правило.Выражение);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РезолверВерсий") _Резолвер)

	Резолвер = _Резолвер;

КонецПроцедуры
