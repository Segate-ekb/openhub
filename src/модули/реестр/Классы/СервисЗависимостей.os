// Состав зависимостей версии: единственная точка записи сущности "ЗависимостьВерсии".
// Состав версии целиком заменяется при каждой публикации, поэтому он всегда равен
// последнему принятому манифесту, а перезапись версии дублей не оставляет.
// Имя зависимости сохраняется как в манифесте: ключ обратного графа выводит хранилище.

Перем ХранилищеЗависимостей; // ХранилищеЗависимостей (данные)

#Область ПубличныйИнтерфейс

// Заменяет состав зависимостей версии переданным. Идемпотентна: прежние строки версии
// удаляются, записывается ровно переданный состав; пустой состав очищает его.
// Зависимость без имени пропускается — адресовать её в графе нечем.
//
// Параметры:
//  ВерсияИдентификатор - Число - идентификатор версии пакета.
//  Зависимости - Массив из Структура, Неопределено - Имя (Строка), ВерсияМин (Строка),
//                ВерсияМакс (Строка), ДляРазработки (Булево).
//
Процедура ЗаписатьСостав(Знач ВерсияИдентификатор, Знач Зависимости) Экспорт

	Версия = Цел(ВерсияИдентификатор);
	ОчиститьСостав(Версия);

	Если Зависимости = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Описание Из Зависимости Цикл

		ИмяПакета = СокрЛП(Строка(Описание.Имя));
		Если ПустаяСтрока(ИмяПакета) Тогда
			Продолжить;
		КонецЕсли;

		ХранилищеЗависимостей.Записать(Версия, ИмяПакета,
			ЗначениеСтрокой(Описание, "ВерсияМин"),
			ЗначениеСтрокой(Описание, "ВерсияМакс"),
			ЗначениеФлагом(Описание, "ДляРазработки"));

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОчиститьСостав(Знач ВерсияИдентификатор)

	Прежние = ХранилищеЗависимостей.ПоВерсии(ВерсияИдентификатор);
	Если Прежние = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Зависимость Из Прежние Цикл
		ХранилищеЗависимостей.Удалить(Зависимость);
	КонецЦикла;

КонецПроцедуры

Функция ЗначениеСтрокой(Знач Описание, Знач ИмяСвойства)

	Значение = Неопределено;
	Если НЕ Описание.Свойство(ИмяСвойства, Значение) ИЛИ Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция ЗначениеФлагом(Знач Описание, Знач ИмяСвойства)

	Значение = Неопределено;
	Описание.Свойство(ИмяСвойства, Значение);
	Возврат (Значение = Истина);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ХранилищеЗависимостей") _ХранилищеЗависимостей)
	ХранилищеЗависимостей = _ХранилищеЗависимостей;
КонецПроцедуры
