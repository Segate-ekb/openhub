// Уборка содержимого пула перед его удалением: доступы, подписки, зеркала,
// апстримы, незакрытые заявки, вся область пула в хранилище и все пакеты с их обвязкой.
// Порядок «сначала обезоружить»: гранты, роли и токены уходят первыми — оборванная
// уборка оставит содержимое без доступа, а не доступ без содержимого.

Перем УборкаПакета;         // УборкаПакета — пакет со всей обвязкой
Перем ХранилищеАртефактов;  // ХранилищеАртефактов (хранилище) — область пула целиком
Перем ХранилищеПрав;        // ХранилищеПравДоступа (данные)
Перем ХранилищеУчастников;  // ХранилищеУчастниковПула (данные) — роли на пуле
Перем ХранилищеТокенов;     // ХранилищеТокенов (данные) — ключи с привязкой к пулу
Перем ХранилищеВебхуков;    // ХранилищеВебхуков (данные) — подписки на объект «пул»
Перем ХранилищеЗеркал;      // ХранилищеЗеркалХабов (данные)
Перем ХранилищеАпстримов;   // ХранилищеАпстримовПула (данные)
Перем ХранилищеВходящих;    // ХранилищеВходящихПубликаций (данные)
Перем ХранилищеПакетов;     // ХранилищеПакетов (данные)

#Область ПубличныйИнтерфейс

// Снимает всё, что ссылается на пул, и всю его область в хранилище. Сам пул не трогает —
// его удаляет СервисПулов, проверив свои инварианты. Идемпотентна: на пустом пуле
// снимать нечего.
//
// Параметры:
//  Пул - Пул - пул, содержимое которого убирается.
//
// Возвращаемое значение:
//  Структура - Доступов (Число), Ролей (Число), Подписок (Число),
//              Зеркал (Число), Апстримов (Число), Заявок (Число), Артефактов (Число),
//              Пакетов (Число), Строк (Число — всего удалённых строк).
//
Функция ОчиститьСодержимое(Знач Пул) Экспорт

	ПулИд = Цел(Пул.Идентификатор);

	Доступов = СнятьВсе(ХранилищеПрав.ГрантыНаОбъект(ТипОбъектаПул(), ПулИд))
		+ СнятьВсе(ХранилищеТокенов.ТокеныПула(ПулИд));
	Ролей = СнятьВсе(ХранилищеУчастников.ПолучитьПоПулИдентификаторРавно(ПулИд));

	Подписок = СнятьВсе(ХранилищеВебхуков.ПолучитьПоОбъекту(ТипОбъектаПул(), ПулИд));
	Зеркал = СнятьВсе(ХранилищеЗеркал.ПолучитьПоПулНазначенияИдентификаторРавно(ПулИд));
	Апстримов = СнятьВсе(ХранилищеАпстримов.ПолучитьПоПулИдентификаторРавно(ПулИд));
	Заявок = СнятьВсе(ХранилищеВходящих.ПолучитьПоПулИдентификаторРавно(ПулИд));

	// Область сносится ЦЕЛИКОМ и ДО пакетов: под именем пула лежат и артефакты реестра,
	// и кэш прокси, и файлы, положенные мимо координат, — по строкам версий их не собрать.
	// Порядок закреплён числом: Артефактов равно ВСЕМ файлам пула, а не остатку после
	// пакетной уборки (перестановка это число уменьшит).
	Артефактов = ХранилищеАртефактов.УдалитьОбластьПула(Строка(Пул.Имя));

	Пакетов = 0;
	СтрокПакетов = 0;
	Для Каждого Пакет Из ХранилищеПакетов.ПолучитьПоПулИдентификаторРавно(ПулИд) Цикл
		СтрокПакетов = СтрокПакетов + УборкаПакета.УдалитьПакет(Пакет);
		Пакетов = Пакетов + 1;
	КонецЦикла;

	Итог = Новый Структура();
	Итог.Вставить("Доступов", Доступов);
	Итог.Вставить("Ролей", Ролей);
	Итог.Вставить("Подписок", Подписок);
	Итог.Вставить("Зеркал", Зеркал);
	Итог.Вставить("Апстримов", Апстримов);
	Итог.Вставить("Заявок", Заявок);
	Итог.Вставить("Артефактов", Артефактов);
	Итог.Вставить("Пакетов", Пакетов);
	Итог.Вставить("Строк", Доступов + Ролей + Подписок + Зеркал + Апстримов
		+ Заявок + СтрокПакетов);
	Возврат Итог;

КонецФункции

// Тип объекта «пул» в таблицах прав, подписок и ключей.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТипОбъектаПул() Экспорт
	Возврат "пул";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СнятьВсе(Знач Строки)
	Снято = 0;
	Для Каждого Строка_ Из Строки Цикл
		Строка_.Удалить();
		Снято = Снято + 1;
	КонецЦикла;
	Возврат Снято;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "УборкаПакета") _УборкаПакета,
	&Пластилин(Значение = "ХранилищеАртефактов") _ХранилищеАртефактов,
	&Пластилин(Значение = "ХранилищеПравДоступа") _ХранилищеПрав,
	&Пластилин(Значение = "ХранилищеУчастниковПула") _ХранилищеУчастников,
	&Пластилин(Значение = "ХранилищеТокенов") _ХранилищеТокенов,
	&Пластилин(Значение = "ХранилищеВебхуков") _ХранилищеВебхуков,
	&Пластилин(Значение = "ХранилищеЗеркалХабов") _ХранилищеЗеркал,
	&Пластилин(Значение = "ХранилищеАпстримовПула") _ХранилищеАпстримов,
	&Пластилин(Значение = "ХранилищеВходящихПубликаций") _ХранилищеВходящих,
	&Пластилин(Значение = "ХранилищеПакетов") _ХранилищеПакетов)

	УборкаПакета = _УборкаПакета;
	ХранилищеАртефактов = _ХранилищеАртефактов;
	ХранилищеПрав = _ХранилищеПрав;
	ХранилищеУчастников = _ХранилищеУчастников;
	ХранилищеТокенов = _ХранилищеТокенов;
	ХранилищеВебхуков = _ХранилищеВебхуков;
	ХранилищеЗеркал = _ХранилищеЗеркал;
	ХранилищеАпстримов = _ХранилищеАпстримов;
	ХранилищеВходящих = _ХранилищеВходящих;
	ХранилищеПакетов = _ХранилищеПакетов;

КонецПроцедуры
