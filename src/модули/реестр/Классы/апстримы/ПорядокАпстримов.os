// Порядок обхода источников пула: поиск по каноничному адресу и плотная нумерация
// позиций. Чистая работа со списком записей — ни настроек, ни журнала.

Перем Адреса;   // РазборАдреса (основа) — канон адреса источника

#Область ПубличныйИнтерфейс

// Ищет источник по адресу; сравнение идёт по каноничной записи, поэтому регистр,
// порт по умолчанию, точечные сегменты и разное процентное кодирование одного адреса
// находят один и тот же источник.
//
// Параметры:
//  Апстримы - Массив из АпстримПула - список источников.
//  Url - Строка - искомый адрес.
//
// Возвращаемое значение:
//  АпстримПула, Неопределено - найденный источник либо Неопределено.
//
Функция НайтиПоАдресу(Знач Апстримы, Знач Url) Экспорт

	Искомый = Адреса.Каноничный(Url);
	Для Каждого Апстрим Из Апстримы Цикл
		Если Адреса.Каноничный(Апстрим.Url) = Искомый Тогда
			Возврат Апстрим;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Проставляет позиции 0..N-1 в порядке следования списка. Сохраняет только изменившиеся.
//
// Параметры:
//  Апстримы - Массив из АпстримПула - список в желаемом порядке.
//
Процедура Перенумеровать(Знач Апстримы) Экспорт

	Позиция = 0;
	Для Каждого Апстрим Из Апстримы Цикл
		Если Цел(Апстрим.Порядок) <> Позиция Тогда
			Апстрим.Порядок = Позиция;
			Апстрим.Сохранить();
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

КонецПроцедуры

// Позиция для нового источника: следующая за наибольшей занятой.
//
// Параметры:
//  Апстримы - Массив из АпстримПула - уже заведённые источники.
//
// Возвращаемое значение:
//  Число - позиция нового источника.
//
Функция Следующая(Знач Апстримы) Экспорт

	Максимум = -1;
	Для Каждого Апстрим Из Апстримы Цикл
		Если Цел(Апстрим.Порядок) > Максимум Тогда
			Максимум = Цел(Апстрим.Порядок);
		КонецЕсли;
	КонецЦикла;
	Возврат Максимум + 1;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач _Адреса = Неопределено)
	Адреса = ?(_Адреса = Неопределено, Новый РазборАдреса(), _Адреса);
КонецПроцедуры
