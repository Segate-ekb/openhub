// Glob-маска имени пакета для allowlist прокси и фильтра зеркала: "*" — любой фрагмент,
// прочие символы литеральны. Сравнение регистрозависимое и по строке целиком.

Перем Маска;      // Строка - исходная маска
Перем Выражение;  // РегулярноеВыражение - только для маски со звёздочкой
Перем ЕстьЗвёздочка;

// Совпадает ли имя с маской целиком.
//
// Параметры:
//  Имя - Строка - проверяемое имя.
//
// Возвращаемое значение:
//  Булево - Истина, если имя совпало с маской целиком.
//
Функция Совпадает(Знач Имя) Экспорт

	Проверяемое = Строка(Имя);

	Если НЕ ЕстьЗвёздочка Тогда
		Возврат Маска = Проверяемое;
	КонецЕсли;

	// маска не скомпилировалась — не совпадает ни с чем (fail-closed)
	Если Выражение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Выражение.Совпадает(Проверяемое);

КонецФункции

Процедура ПриСозданииОбъекта(Знач ТекстМаски)

	Маска = Строка(ТекстМаски);
	ЕстьЗвёздочка = СтрНайти(Маска, "*") > 0;
	Выражение = Неопределено;

	Если НЕ ЕстьЗвёздочка Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Выражение = Новый РегулярноеВыражение("\A" + ШаблонПоМаске(Маска) + "\z");
		Выражение.ИгнорироватьРегистр = Ложь;
		Выражение.Многострочный = Ложь;
	Исключение
		Выражение = Неопределено;
	КонецПопытки;

КонецПроцедуры

Функция ШаблонПоМаске(Знач Текст)

	Шаблон = "";

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = "*" Тогда
			Шаблон = Шаблон + ".*";
		ИначеЕсли СтрНайти(".^$+?()[]{}|\/", Символ) > 0 Тогда
			Шаблон = Шаблон + "\" + Символ;
		Иначе
			Шаблон = Шаблон + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат Шаблон;

КонецФункции
