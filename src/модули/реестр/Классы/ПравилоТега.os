// Правило тега — значение-объект: фильтр версий типа semver или regex, создаётся
// из сущности Тег в любом слое. Грамматику semver-диапазона проверяет СервисТегов.

Перем Тип Экспорт;       // Строка - semver | regex
Перем Выражение Экспорт; // Строка
Перем Матчер;            // РегулярноеВыражение | РазобранныйДиапазон, компилируется однажды

#Область ПубличныйИнтерфейс

// Возвращает имя типа правила «semver».
//
// Возвращаемое значение:
//  Строка - имя типа.
//
Функция ТипSemver() Экспорт
	Возврат Словарь().Semver();
КонецФункции

// Возвращает имя типа правила «regex».
//
// Возвращаемое значение:
//  Строка - имя типа.
//
Функция ТипRegex() Экспорт
	Возврат Словарь().Regex();
КонецФункции

// Проверяет, подходит ли версия под правило. Единственное место матчинга в проекте;
// выражение компилируется один раз на объект правила.
//
// Параметры:
//  СтрокаВерсии - Строка - строка версии пакета.
//  Разобранная - РазобраннаяВерсия, Неопределено - готовый разбор той же версии;
//                Неопределено — строка разбирается здесь. Regex работает по строке
//                в любом случае.
//
// Возвращаемое значение:
//  Булево - Истина, если версия попадает в правило.
//
Функция ПодходитСтрока(Знач СтрокаВерсии, Знач Разобранная = Неопределено) Экспорт

	Если Матчер = Неопределено Тогда
		Матчер = СобратьМатчер();
	КонецЕсли;

	Если Тип = ТипRegex() Тогда
		Возврат Матчер.Совпадает(Строка(СтрокаВерсии));
	КонецЕсли;

	Версия = Разобранная;
	Если Версия = Неопределено Тогда
		Попытка
			Версия = Новый РазобраннаяВерсия(СтрокаВерсии);
		Исключение
			// повреждённая строка версии из БД не подходит под диапазон, но и не роняет отбор
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;

	Возврат Матчер.Допускает(Версия);

КонецФункции

// Проверяет, что правило — незаякоренный regex. Такое выражение совпадает по подстроке,
// и "1\.2" ловит в том числе "11.2.0".
//
// Возвращаемое значение:
//  Булево - Истина, если тип regex и выражение не заякорено с обеих сторон.
//
Функция НезаякоренноеПравило() Экспорт

	Если Тип <> ТипRegex() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат НЕ (СтрНачинаетсяС(Выражение, "^") И СтрЗаканчиваетсяНа(Выражение, "$"));

КонецФункции

// Возвращает текст предупреждения о рискованном правиле для UI и API.
//
// Возвращаемое значение:
//  Строка - текст предупреждения либо "", если предупреждать не о чем.
//
Функция Предупреждение() Экспорт

	Если НЕ НезаякоренноеПравило() Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(
		"Регулярное выражение ""%1"" не заякорено: совпадение ищется по ПОДСТРОКЕ,"
		+ " поэтому под правило попадут и посторонние версии (например ""11.2.0"" под ""1\.2"")."
		+ " Добавьте якоря: ^%1$", Выражение);

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач ТипПравила, Знач Текст)

	ТипНорм = НРег(СокрЛП(Строка(ТипПравила)));
	ТекстНорм = СокрЛП(Строка(Текст));

	Если ПустаяСтрока(ТекстНорм) Тогда
		ВызватьИсключение "Пустое правило тега: правило обязано отбирать версии явно";
	КонецЕсли;

	// упразднённый префикс "label:" отклоняется явно, а не падает «неразобранным диапазоном»
	Если СтрНачинаетсяС(НРег(ТекстНорм), "label:") Тогда
		ВызватьИсключение СтрШаблон(
			"Запись ""%1"" упразднена (6.H): правило тега больше не отбирает версии по метке."
			+ " Задайте semver-диапазон или regex по строке версии", ТекстНорм);
	КонецЕсли;

	Если СтрДлина(ТекстНорм) > МаксимальнаяДлина() Тогда
		ВызватьИсключение СтрШаблон(
			"Правило тега длиннее %1 символов — отклонено", Формат(МаксимальнаяДлина(), "ЧГ=0"));
	КонецЕсли;

	ТипНорм = Словарь().Нормализовать(ТипНорм);

	Если ТипНорм = ТипRegex() Тогда
		Попытка
			Проба = СкомпилироватьВыражение(ТекстНорм);
			Проба = Проба;
		Исключение
			ВызватьИсключение СтрШаблон("Некорректное регулярное выражение правила тега: %1", ТекстНорм);
		КонецПопытки;
		Если ЕстьВложенныйКвантификатор(ТекстНорм) Тогда
			ВызватьИсключение СтрШаблон(
				"Регулярное выражение ""%1"" содержит вложенный квантификатор (например ""(a+)+"")."
				+ " Такие выражения дают катастрофический бэктрекинг и отклоняются:"
				+ " перепишите правило без квантификатора над группой с квантификатором", ТекстНорм);
		КонецЕсли;
	КонецЕсли;

	Тип = ТипНорм;
	Выражение = ТекстНорм;

КонецПроцедуры

Функция СобратьМатчер()

	Если Тип <> ТипRegex() Тогда
		Возврат Новый РазобранныйДиапазон(Выражение);
	КонецЕсли;

	Возврат СкомпилироватьВыражение(Выражение);

КонецФункции

// Regex правила сличается ровно как написан: регистр значим, "^" и "$" — границы строки версии.
Функция СкомпилироватьВыражение(Знач Текст)

	Регулярное = Новый РегулярноеВыражение(Текст);
	Регулярное.ИгнорироватьРегистр = Ложь;
	Регулярное.Многострочный = Ложь;

	Возврат Регулярное;

КонецФункции

// Словарь типов — единственный владелец значений; без состояния, поэтому создаётся прямо.
Функция Словарь()
	Возврат Новый ТипПравилаТега();
КонецФункции

Функция МаксимальнаяДлина()
	Возврат 200;
КонецФункции

// Разбор по скобкам вручную — парсера regex в OneScript нет; ошибается в безопасную сторону.
Функция ЕстьВложенныйКвантификатор(Знач Выражение)

	Начала = Новый Массив();          // позиции открывающих скобок
	ЕстьКвантификаторВнутри = Новый Массив(); // по открытой группе — был ли внутри квантификатор

	Позиция = 1;
	Пока Позиция <= СтрДлина(Выражение) Цикл

		Символ = Сред(Выражение, Позиция, 1);

		Если Символ = "\" Тогда
			Позиция = Позиция + 2; // экранированная пара — literal
			Продолжить;
		КонецЕсли;

		Если Символ = "(" Тогда
			Начала.Добавить(Позиция);
			ЕстьКвантификаторВнутри.Добавить(Ложь);

		ИначеЕсли Символ = ")" Тогда
			Если Начала.Количество() > 0 Тогда
				Индекс = Начала.Количество() - 1;
				БылоВнутри = ЕстьКвантификаторВнутри[Индекс];
				Начала.Удалить(Индекс);
				ЕстьКвантификаторВнутри.Удалить(Индекс);

				// квантификатор сразу за закрывающей скобкой + квантификатор внутри группы
				Если БылоВнутри И ЭтоКвантификатор(Сред(Выражение, Позиция + 1, 1)) Тогда
					Возврат Истина;
				КонецЕсли;

				// сама группа с квантификатором считается квантификатором для внешней группы
				Если ЕстьКвантификаторВнутри.Количество() > 0
					И (БылоВнутри ИЛИ ЭтоКвантификатор(Сред(Выражение, Позиция + 1, 1))) Тогда
					ЕстьКвантификаторВнутри[ЕстьКвантификаторВнутри.Количество() - 1] = Истина;
				КонецЕсли;
			КонецЕсли;

		ИначеЕсли ЭтоКвантификатор(Символ) И ЕстьКвантификаторВнутри.Количество() > 0 Тогда
			ЕстьКвантификаторВнутри[ЕстьКвантификаторВнутри.Количество() - 1] = Истина;
		КонецЕсли;

		Позиция = Позиция + 1;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЭтоКвантификатор(Знач Символ)
	Возврат Символ = "+" ИЛИ Символ = "*" ИЛИ Символ = "{";
КонецФункции
