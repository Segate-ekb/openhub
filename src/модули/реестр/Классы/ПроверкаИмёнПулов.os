// Рогатка старта: сверяет имена уже существующих пулов с резервом системных сегментов
// URL и предупреждает оператора. Не чинит — автопереименование сломало бы opm.cfg клиентов.

Перем СервисПулов;   // СервисПулов
Перем Правила;       // ПравилаИменования
&Лог
Перем Лог;

// Сверяет имена существующих пулов с резервом системных сегментов URL и пишет
// предупреждения в лог. Best-effort: собственные ошибки перехватывает.
//
Процедура ПриЗапускеПриложения() Экспорт

	Попытка
		Предупредить();
	Исключение
		// Диагностика best-effort: в частичном контейнере (тесты) лога может не быть вовсе.
		Если Лог <> Неопределено Тогда
			Лог.Предупреждение("Не удалось сверить имена пулов с резервом системных сегментов: %1",
				ОписаниеОшибки());
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

Процедура Предупредить()

	Пулы = СервисПулов.ВсеПулы();
	// лог опционален так же, как в перехвате выше: в частичном контейнере его может не быть
	Если Лог <> Неопределено Тогда
		Лог.Отладка("Имена пулов: сверяем %1 пулов с резервом системных сегментов",
			Пулы.Количество());
	КонецЕсли;

	Для Каждого Пул Из Пулы Цикл
		Если НЕ Правила.ИмяПулаЗарезервировано(Пул.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Лог.Предупреждение(
			"Пул ""%1"" носит имя, зарезервированное под системный адрес хаба: его веб-страница"
			+ " /%1 недостижима (перекрыта литеральным маршрутом). Выдача пакетов НЕ затронута —"
			+ " /pools/%1/download/... и /api/v1/pools/%1 работают, opm.cfg клиентов менять не нужно."
			+ " Чтобы вернуть пулу его веб-страницу, пул нужно переименовать.",
			Пул.Имя);
	КонецЦикла;

КонецПроцедуры

&Рогатка(ЗапускатьВФоне = Ложь)
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ПравилаИменования") _Правила)

	СервисПулов = _СервисПулов;
	Правила = _Правила;

КонецПроцедуры
