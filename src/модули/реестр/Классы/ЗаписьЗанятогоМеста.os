// Сообщение пулу о записанных или снятых байтах. Счётчик вторичен: ронять публикацию,
// кэширование или уборку из-за него нельзя — расхождение чинит плановая сверка.

Перем Объёмы;  // УчётОбъёмаПула (реестр)
Перем Ошибки;  // ТекстОшибки (основа)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Учитывает изменение занятого пулом места, не пропуская наружу ошибок учёта.
//
// Параметры:
//  Пул - Пул, Неопределено - пул, чьё место изменилось.
//  ДельтаБайт - Число - приращение объёма; отрицательное уменьшает.
//  Пояснение - Строка - что за операция, для журнала (необязательный, по умолчанию "").
//
Процедура Учесть(Знач Пул, Знач ДельтаБайт, Знач Пояснение = "") Экспорт

	Дельта = ?(Пул = Неопределено, 0, Цел(Число(ДельтаБайт)));
	Если Пул = Неопределено ИЛИ Дельта = 0 Тогда
		Возврат;
	КонецЕсли;

	Лог.Отладка("Занятое пула ""%1"" меняется на %2 байт (%3)", Пул.Имя, Дельта, Пояснение);

	Попытка
		Объёмы.Учесть(Пул, Дельта);
	Исключение
		Лог.Предупреждение("Занятое пула ""%1"" не учтено (%2): %3",
			Пул.Имя, Пояснение, Ошибки.Причина(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

&Прозвище("ЗаписьЗанятогоМеста")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "УчётОбъёмаПула") _Объёмы,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Объёмы = _Объёмы;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
