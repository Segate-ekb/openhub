// Имена пулов и пакетов для журнала аудита — реализация контракта ИменаОбъектовАудита.

Перем ХранилищеПулов;    // ХранилищеПулов
Перем ХранилищеПакетов;  // ХранилищеПакетов

// Типы объектов, которые называет реестр.
//
// Возвращаемое значение:
//  Массив из Строка - пул и пакет.
//
Функция НазываемыеТипы() Экспорт

	Результат = Новый Массив();
	Результат.Добавить("пул");
	Результат.Добавить("пакет");
	Возврат Результат;

КонецФункции

// Имена пула либо пакета.
//
// Параметры:
//  ТипОбъекта - Строка - пул либо пакет.
//  Идентификатор - Число - идентификатор объекта.
//
// Возвращаемое значение:
//  Структура, Неопределено - Имя (Строка) — имя пула либо пакета; Пул (Строка) — у пакета
//   имя его пула, пустое, если пула уже нет. Неопределено — объекта нет.
//
Функция ИменаОбъекта(Знач ТипОбъекта, Знач Идентификатор) Экспорт

	Если ТипОбъекта = "пул" Тогда
		Пул = НайтиПул(Идентификатор);
		Возврат ?(Пул = Неопределено, Неопределено, Имена(Пул.Имя));
	КонецЕсли;

	Пакет = ХранилищеПакетов.ПолучитьОдноПоИдентификаторРавно(Цел(Идентификатор));
	Если Пакет = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пул = НайтиПул(Пакет.ПулИдентификатор);
	Возврат Имена(Пакет.Имя, ?(Пул = Неопределено, "", Пул.Имя));

КонецФункции

Функция НайтиПул(Знач Идентификатор)
	Возврат ?(Цел(Идентификатор) <= 0, Неопределено,
		ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(Цел(Идентификатор)));
КонецФункции

Функция Имена(Знач Имя, Знач ИмяПула = "")
	Возврат Новый Структура("Имя, Пул", Имя, ИмяПула);
КонецФункции

&Прозвище("ИменаОбъектовАудита")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПулов") _ХранилищеПулов,
	&Пластилин(Значение = "ХранилищеПакетов") _ХранилищеПакетов)

	ХранилищеПулов = _ХранилищеПулов;
	ХранилищеПакетов = _ХранилищеПакетов;

КонецПроцедуры
