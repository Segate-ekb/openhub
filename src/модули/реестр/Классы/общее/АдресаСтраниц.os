// Адреса страниц пула, пакета, версии и их настроек — одна схема на весь хаб, та же, что у API.

#Область ПубличныйИнтерфейс

// Адрес страницы пула. Личное пространство человека — тоже пул, названный его логином.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Строка - путь страницы от корня хаба.
//
Функция Пула(Знач ИмяПула) Экспорт
	Возврат "/pools/" + Сегмент(ИмяПула);
КонецФункции

// Адрес страницы пакета — вкладка «Описание»; остальные вкладки и настройки пакета лежат под ним.
//
// Параметры:
//  ИмяПула - Строка - имя пула пакета.
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Строка - путь страницы от корня хаба.
//
Функция Пакета(Знач ИмяПула, Знач ИмяПакета) Экспорт
	Возврат Пула(ИмяПула) + "/packages/" + Сегмент(ИмяПакета);
КонецФункции

// Адрес страницы версии — страница пакета, названная версией в запросе: у каждой версии
// свой адрес, хотя показывает страница то же, что страница пакета.
//
// Параметры:
//  ИмяПула - Строка - имя пула пакета.
//  ИмяПакета - Строка - имя пакета.
//  Версия - Строка - номер версии.
//
// Возвращаемое значение:
//  Строка - путь страницы от корня хаба.
//
Функция Версии(Знач ИмяПула, Знач ИмяПакета, Знач Версия) Экспорт
	Возврат Пакета(ИмяПула, ИмяПакета) + "?" + ПараметрВерсии() + "=" + Сегмент(Версия);
КонецФункции

// Адрес списка пакетов пула: форма «Добавить пакет» и снятие резерва отправляются сюда.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Строка - путь от корня хаба.
//
Функция ПакетовПула(Знач ИмяПула) Экспорт
	Возврат Пула(ИмяПула) + "/packages";
КонецФункции

// Адрес окна подтверждения снятия резерва: страница пула, которая печатает это окно открытым.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя снимаемого резерва.
//
// Возвращаемое значение:
//  Строка - путь страницы от корня хаба.
//
Функция СнятияРезерва(Знач ИмяПула, Знач ИмяПакета) Экспорт
	Возврат Пула(ИмяПула) + "?" + Сегмент(ПараметрОкна()) + "=" + Сегмент(ОкноСнятия() + "-" + ИмяПакета);
КонецФункции

// Адрес окна «Добавить пакет»: страница пула, которая печатает это окно открытым.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Строка - путь страницы от корня хаба.
//
Функция ДобавленияПакета(Знач ИмяПула) Экспорт
	Возврат Пула(ИмяПула) + "?" + Сегмент(ПараметрОкна()) + "=" + Сегмент(ОкноДобавления());
КонецФункции

// Какое окно страницы пула названо значением параметра окна — разбор адресов ДобавленияПакета
// и СнятияРезерва. Незнакомое значение не называет ни одного.
//
// Параметры:
//  Значение - Строка, Неопределено - раскодированное значение параметра окна из запроса.
//
// Возвращаемое значение:
//  Структура - Добавление (Булево), Снятие (Строка — имя резерва; "" — окно снятия не названо).
//
Функция ОкноСтраницыПула(Знач Значение) Экспорт

	Результат = Новый Структура("Добавление, Снятие", Ложь, "");
	Текст = СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
	Префикс = ОкноСнятия() + "-";

	Если Текст = ОкноДобавления() Тогда
		Результат.Добавление = Истина;
	ИначеЕсли СтрНачинаетсяС(Текст, Префикс) Тогда
		Результат.Снятие = Сред(Текст, СтрДлина(Префикс) + 1);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Имя параметра окна в запросе страницы пула.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПараметрОкна() Экспорт
	Возврат "окно";
КонецФункции

// Адрес дома настроек пула: настройки лежат под страницей своего пула.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Строка - путь дома настроек от корня хаба.
//
Функция НастроекПула(Знач ИмяПула) Экспорт
	Возврат Пула(ИмяПула) + "/settings";
КонецФункции

// Адрес дома настроек пакета: настройки лежат под страницей своего пакета.
//
// Параметры:
//  ИмяПула - Строка - имя пула пакета.
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Строка - путь дома настроек от корня хаба.
//
Функция НастроекПакета(Знач ИмяПула, Знач ИмяПакета) Экспорт
	Возврат Пакета(ИмяПула, ИмяПакета) + "/settings";
КонецФункции

#КонецОбласти

// Имя параметра — то же, которым версию называет адрес README в API.
Функция ПараметрВерсии()
	Возврат "version";
КонецФункции

// Окно страницы называется в запросе видом и ключом; кириллица в адресе кодируется: адрес уходит
// и в заголовок Location, а он только ASCII.
Функция ОкноСнятия()
	Возврат "снять";
КонецФункции

Функция ОкноДобавления()
	Возврат "добавить";
КонецФункции

// Имя приходит и из адреса до резолва в сущность, поэтому кодируется всегда.
Функция Сегмент(Знач Имя)
	Возврат КодироватьСтроку(?(ТипЗнч(Имя) = Тип("Строка"), Имя, Строка(Имя)),
		СпособКодированияСтроки.КодировкаURL);
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
