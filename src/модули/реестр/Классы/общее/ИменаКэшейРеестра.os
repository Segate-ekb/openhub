// Кэши реестра: снимки пулов, пакетов, версий, тегов и происхождения.

#Область ПубличныйИнтерфейс

// Имена кэшей предмета — контракт ИменаКэшей.
//
// Возвращаемое значение:
//  Массив из Строка - имена кэшей autumn-cache.
//
Функция Имена() Экспорт

	Имена = Новый Массив();
	Имена.Добавить("пулы");
	Имена.Добавить("источникиПула");
	Имена.Добавить("пакеты");
	Имена.Добавить("пакетыПула");
	Имена.Добавить("пакетыПулов");
	Имена.Добавить("новинки");
	Имена.Добавить("версииПакета");
	Имена.Добавить("происхождениеПакета");
	Имена.Добавить("каналыПакета");
	Имена.Добавить("тегиПула");
	Возврат Имена;

КонецФункции

#КонецОбласти

&Прозвище("ИменаКэшей")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
