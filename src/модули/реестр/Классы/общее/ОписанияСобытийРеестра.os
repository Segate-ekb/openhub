// События реестра словами: отзыв и восстановление версии, заполнение пула, правки тегов,
// основной пул и снос пула.

Перем События;  // ОбъявленияСобытий (события)

#Область ПубличныйИнтерфейс

// Объявления событий реестра в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияСобытий - события реестра словами.
//
Функция Объявления() Экспорт
	Возврат События;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПорогЗаполнения(Знач Заполнение)
	Возврат Новый Структура("Имя, Минимум, Максимум, ПоУмолчанию",
		"порог", Заполнение.МинимальныйПорог(), Заполнение.МаксимальныйПорог(),
		Заполнение.ПорогПоУмолчанию());
КонецФункции

#КонецОбласти

&Прозвище("ОписанияСобытий")
&Порядок(20)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "ЗаполнениеПула") _Заполнение) Экспорт

	События = Новый ОбъявленияСобытий();

	События.ОбъявитьПодписочное(_Издатель.ТипВерсияОтозвана(), "Версия отозвана",
		"Новые установки версию не выбирают, артефакт остаётся доступен.");

	События.ОбъявитьПодписочное(_Издатель.ТипВерсияВосстановлена(), "Версия восстановлена",
		"Отзыв снят — версия снова участвует в разрешении зависимостей.");

	// Единственное событие с параметром подписки: порог задаётся при подписке, письмо
	// уходит на его пересечении и дальше на каждом следующем десятке процентов.
	События.ОбъявитьПодписочное(_Издатель.ТипПулЗаполнен(), "Пул заполняется",
		"Занятый пулом объём вырос и достиг заданного при подписке процента квоты.",
		ПорогЗаполнения(_Заполнение));

	События.ОбъявитьВнутреннее(_Издатель.ТипТегПеремещён(), "Состав канала изменён",
		"Тег (канал обновления) стал отдавать другую версию.",
		"Нагрузка события собрана под журнал аудита (Кто/Действие/Объект/ДеталиJSON) и не"
		+ " несёт ни идентификатора пула, ни идентификатора пакета — доставить его подписке"
		+ " объекта некуда.");

	События.ОбъявитьВнутреннее(_Издатель.ТипРежимТегаИзменён(), "Режим тега изменён",
		"Тег переведён из ручного режима в режим правила или обратно.",
		"Та же нагрузка «под аудит», что и у переезда канала.");

	События.ОбъявитьВнутреннее(_Издатель.ТипЗапретПерезаписиИзменён(), "Запрет повторной публикации изменён",
		"Тегу разрешили или запретили переиздавать номер версии, который под него попадает.",
		"Снятый запрет открывает перезапись опубликованного номера всем, кто вправе"
		+ " публиковать, поэтому событие безопасности собрано под журнал аудита"
		+ " (Кто/Действие/Объект/ДеталиJSON), как и прочие правки тега.");

	События.ОбъявитьВнутреннее(_Издатель.ТипТегУдалён(), "Тег удалён",
		"Координата «пакет@тег» перестала существовать.",
		"Та же нагрузка «под аудит», что и у переезда канала.");

	События.ОбъявитьВнутреннее(_Издатель.ТипОсновнойПулНазначен(), "Основной пул хаба назначен",
		"Короткие адреса /download, /dev-channel и /push переведены в другой пул.",
		"Административное событие уровня хаба: нагрузка собрана под журнал аудита"
		+ " (Кто/Действие/Объект/ДеталиJSON). Скоуп у него — весь хаб, а не пул или пакет,"
		+ " поэтому доставить его подписке объекта некуда.");

	События.ОбъявитьВнутреннее(_Издатель.ТипПулУдалён(), "Пул удалён",
		"Пул снесён вместе со всем содержимым: пакетами, файлами, правами, ключами,"
		+ " подписками, зеркалами, апстримами и незакрытыми заявками.",
		"Событие уровня хаба: удаление пула — право уровня хаба, и адресат такой записи —"
		+ " журнал аудита и администратор. Подписаться на него мог бы только тот, чья"
		+ " подписка вместе с пулом и уничтожена, — доставлять её уже некуда.");

КонецПроцедуры
