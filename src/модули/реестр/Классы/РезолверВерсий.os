// Резолвер версий: из списка версий пакета выбирает одну по запросу-ограничению.
// Порядок — единый semver+legacy: 1.2.3 < 1.2.3.4 < 1.2.4-rc.1 < 1.2.4, приоритета
// «semver над legacy» нет; при равенстве побеждает первая встреченная в списке.
// Строка вне этого порядка (SNAPSHOT) стоит НИЖЕ любой разобранной версии и сравнима
// только с такими же — по кодам символов; ни в один отбор по диапазону она не попадает.
// Мусорный диапазон/regex — исключение.

Перем Сравнитель; // СравнительВерсий

// Ищет точное совпадение строки версии. Регистр значим, "1.2.3" и "1.2.3.0" — разные
// строки. Пустая искомая версия — исключение.
//
// Параметры:
//  СтрокиВерсий - Массив из Строка, РазобраннаяВерсия - версии пакета.
//  ИскомаяВерсия - Строка - точная версия.
//
// Возвращаемое значение:
//  Строка, Неопределено - найденная версия либо Неопределено.
//
Функция ТочнаяВерсия(Знач СтрокиВерсий, Знач ИскомаяВерсия) Экспорт

	Эталон = СокрЛП(ИскомаяВерсия);
	Если ПустаяСтрока(Эталон) Тогда
		ВызватьИсключение "Не задана искомая версия";
	КонецЕсли;

	Для Каждого Элемент Из СтрокиВерсий Цикл
		Если СокрЛП(СтрокаВерсииЭлемента(Элемент)) = Эталон Тогда
			Возврат СтрокаВерсииЭлемента(Элемент);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Выбирает максимальную версию, попадающую в диапазон.
// Мусорный диапазон — исключение.
//
// Параметры:
//  СтрокиВерсий - Массив из Строка, РазобраннаяВерсия - версии пакета.
//  СтрокаДиапазона - Строка - semver-выражение.
//
// Возвращаемое значение:
//  Строка, Неопределено - выбранная версия либо Неопределено.
//
Функция МаксимальнаяПоДиапазону(Знач СтрокиВерсий, Знач СтрокаДиапазона) Экспорт

	Диапазон = Сравнитель.РазобратьДиапазон(СтрокаДиапазона);
	Возврат МаксимумПоДиапазону(СтрокиВерсий, Диапазон);

КонецФункции

// Выбирает максимальную версию, строка которой совпала с регулярным выражением.
// Выражение не якорится автоматически — совпадение ищется по подстроке.
// Некорректное выражение — исключение.
//
// Параметры:
//  СтрокиВерсий - Массив из Строка, РазобраннаяВерсия - версии пакета.
//  Выражение - Строка - регулярное выражение.
//
// Возвращаемое значение:
//  Строка, Неопределено - выбранная версия либо Неопределено.
//
Функция МаксимальнаяПоРегулярному(Знач СтрокиВерсий, Знач Выражение) Экспорт

	Попытка
		Регулярное = Новый РегулярноеВыражение(Выражение);
		// выражение сличается как написано: регистр значим, "^" и "$" — границы всей строки
		Регулярное.ИгнорироватьРегистр = Ложь;
		Регулярное.Многострочный = Ложь;
	Исключение
		ВызватьИсключение СтрШаблон("Некорректное регулярное выражение отбора версий: %1", Выражение);
	КонецПопытки;

	// regex сам определяет отбор: политика пререлизов не применяется
	Подходящие = Новый Массив();
	Для Каждого Элемент Из СтрокиВерсий Цикл
		Если Регулярное.Совпадает(СтрокаВерсииЭлемента(Элемент)) Тогда
			Подходящие.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	// старшую среди отобранных выбирает единый порядок: копии этого правила здесь быть
	// не может, иначе канал из одних строк вне порядка версий («SNAPSHOT» у апстрима)
	// отдавал бы по чужому списку не то, что по своему реестру
	Возврат Максимальная(Подходящие);

КонецФункции

// Выбирает старшую версию списка по единому порядку, без всякого отбора. Пререлизы
// здесь не отсеиваются: политику пререлизов уже применило правило при формировании
// состава канала. Строки вне порядка версий проигрывают любой разобранной версии
// и участвуют, только если разобрать не удалось НИ ОДНУ: непустой список кандидатов
// обязан назвать одного, иначе тег с непустым составом ничего не отдаёт.
//
// Параметры:
//  СтрокиВерсий - Массив из Строка, РазобраннаяВерсия - версии-кандидаты.
//
// Возвращаемое значение:
//  Строка, Неопределено - старшая версия либо Неопределено для пустого списка.
//
Функция Максимальная(Знач СтрокиВерсий) Экспорт

	Лучшая = Неопределено;
	СтаршаяВнеПорядка = Неопределено;

	Для Каждого Элемент Из СтрокиВерсий Цикл

		Версия = РазобратьЭлемент(Элемент);
		Если Версия = Неопределено Тогда
			Строка_ = СтрокаВерсииЭлемента(Элемент);
			Если СтаршаяВнеПорядка = Неопределено ИЛИ СтаршеПоКодам(Строка_, СтаршаяВнеПорядка) Тогда
				СтаршаяВнеПорядка = Строка_;
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если Лучшая = Неопределено ИЛИ Версия.Сравнить(Лучшая) > 0 Тогда
			Лучшая = Версия;
		КонецЕсли;

	КонецЦикла;

	Возврат ?(Лучшая = Неопределено, СтаршаяВнеПорядка, Лучшая.ВСтроку());

КонецФункции

// Выбирает «последнюю» версию — максимальную без пререлиза.
//
// Параметры:
//  СтрокиВерсий - Массив из Строка, РазобраннаяВерсия - версии пакета.
//
// Возвращаемое значение:
//  Строка, Неопределено - выбранная версия либо Неопределено, если все версии пререлизные.
//
Функция Последняя(Знач СтрокиВерсий) Экспорт
	Возврат МаксимальнаяПоДиапазону(СтрокиВерсий, ДиапазонБезПререлизов());
КонецФункции

// Возвращает диапазон «все релизы без пререлизов» — правило базового тега stable.
// Пререлизы отсекает наша политика: библиотека semver в "*" их пропускает.
//
// Возвращаемое значение:
//  Строка - выражение диапазона.
//
Функция ДиапазонБезПререлизов() Экспорт
	Возврат "*";
КонецФункции

Функция МаксимумПоДиапазону(Знач СтрокиВерсий, Знач Диапазон)

	Лучшая = Неопределено;

	Для Каждого Элемент Из СтрокиВерсий Цикл

		Версия = РазобратьЭлемент(Элемент);
		Если Версия = Неопределено Тогда
			Продолжить; // повреждённая запись списка
		КонецЕсли;

		Если НЕ Диапазон.Допускает(Версия) Тогда
			Продолжить;
		КонецЕсли;

		Если Лучшая = Неопределено ИЛИ Версия.Сравнить(Лучшая) > 0 Тогда
			Лучшая = Версия;
		КонецЕсли;

	КонецЦикла;

	Возврат ?(Лучшая = Неопределено, Неопределено, Лучшая.ВСтроку());

КонецФункции

// Порядок между строками вне semver: по кодам символов, затем по длине. Кодовое
// сравнение, а не строчное, — оно не зависит ни от локали процесса, ни от регистра.
Функция СтаршеПоКодам(Знач Строка1, Знач Строка2)

	Общая = Мин(СтрДлина(Строка1), СтрДлина(Строка2));
	Для Позиция = 1 По Общая Цикл
		Код1 = КодСимвола(Строка1, Позиция);
		Код2 = КодСимвола(Строка2, Позиция);
		Если Код1 <> Код2 Тогда
			Возврат Код1 > Код2;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрДлина(Строка1) > СтрДлина(Строка2);

КонецФункции

Функция РазобратьЭлемент(Знач Элемент)

	Если ТипЗнч(Элемент) = Тип("РазобраннаяВерсия") Тогда
		Возврат Элемент;
	КонецЕсли;
	Возврат Сравнитель.ПопытатьсяРазобрать(Элемент);

КонецФункции

Функция СтрокаВерсииЭлемента(Знач Элемент)

	Если ТипЗнч(Элемент) = Тип("РазобраннаяВерсия") Тогда
		Возврат Элемент.ВСтроку();
	КонецЕсли;
	Возврат Строка(Элемент);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "СравнительВерсий") _Сравнитель)
	Сравнитель = _Сравнитель;
КонецПроцедуры
