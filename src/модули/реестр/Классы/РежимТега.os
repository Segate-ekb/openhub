// Словарь — единственный владелец значений колонки Тег.Режим. Без состояния.
// Упразднённый режим «пин» = ручной тег ровно с одной версией.

#Область ПубличныйИнтерфейс

// Возвращает режим «ручной».
//
// Возвращаемое значение:
//  Строка - имя режима.
//
Функция Ручной() Экспорт
	Возврат "ручной";
КонецФункции

// Возвращает режим «правило».
//
// Возвращаемое значение:
//  Строка - имя режима.
//
Функция Правило() Экспорт
	Возврат "правило";
КонецФункции

// Возвращает все допустимые режимы тега.
//
// Возвращаемое значение:
//  Массив из Строка - режимы.
//
Функция Все() Экспорт
	Результат = Новый Массив();
	Результат.Добавить(Ручной());
	Результат.Добавить(Правило());
	Возврат Результат;
КонецФункции

// Нормализует значение режима по регистру и пробелам, принимая англоязычные синонимы
// manual и rule. Недопустимый режим — исключение.
//
// Параметры:
//  Значение - Строка - сырое значение из формы, тела запроса или строки БД.
//
// Возвращаемое значение:
//  Строка - нормализованный режим.
//
Функция Нормализовать(Знач Значение) Экспорт

	Норм = НРег(СокрЛП(Строка(Значение)));

	// англоязычные синонимы принимаются на ВХОДЕ; храним и отдаём родное значение
	Если Норм = "manual" Тогда
		Норм = Ручной();
	ИначеЕсли Норм = "rule" Тогда
		Норм = Правило();
	КонецЕсли;

	Если Норм = Ручной() ИЛИ Норм = Правило() Тогда
		Возврат Норм;
	КонецЕсли;

	// упразднённый режим называется поимённо, а не молча переводится в «ручной»
	Если Норм = "пин" ИЛИ Норм = "pin" Тогда
		ВызватьИсключение
			"Режим тега ""пин"" упразднён (6.H): ручной тег, поставленный на одну версию,"
			+ " и есть прежний пин — используйте режим ""ручной""";
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Некорректный режим тега ""%1"": ожидается ручной или правило", Строка(Значение));

КонецФункции

// Проверяет, ведёт ли состав канала правило, а не человек. Истину даёт только «правило»;
// исторические значения из БД читаются как ручные.
//
// Параметры:
//  Режим - Строка - значение колонки Тег.Режим.
//
// Возвращаемое значение:
//  Булево - Истина, если состав канала считается правилом.
//
Функция ЭтоПравило(Знач Режим) Экспорт
	Возврат НРег(СокрЛП(Строка(Режим))) = Правило();
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
