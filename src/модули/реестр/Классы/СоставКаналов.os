// Отвечает на два вопроса о канале: какие версии в нём и какую отдать установке.
// Отозванные отсеиваются здесь — в одном месте на все пути выдачи.

Перем ХранилищеМеток; // ХранилищеМетокТегов (данные)
Перем СервисВерсий;   // СервисВерсий
Перем Резолвер;       // РезолверВерсий
Перем Отбор;          // ОтборВерсийПоПравилу
Перем Режимы;         // РежимТега

#Область ЧтениеСостава

// Возвращает канал целиком: состав и отдаваемую версию. Версии пакета берутся из
// переданного списка — так пакет читается один раз на все свои теги.
//
// Параметры:
//  Тег - Тег - тег-канал.
//  ВерсииПакета - Массив из ВерсияПакета, Неопределено - версии пакета; Неопределено —
//                 прочитать их самостоятельно.
//
// Возвращаемое значение:
//  Структура - Состав (Массив из ВерсияПакета, включая отозванные), Отдаваемая
//              (ВерсияПакета, Неопределено), Запросов (Число обращений к хранилищам:
//              у тега-правила их нет).
//
Функция Канал(Знач Тег, Знач ВерсииПакета = Неопределено) Экспорт

	Запросов = 0;
	СписокВерсий = ВерсииПакета;
	Если СписокВерсий = Неопределено Тогда
		СписокВерсий = СервисВерсий.ВерсииПакета(Тег.ПакетИдентификатор);
		Запросов = 1;
	КонецЕсли;

	Если Режимы.ЭтоПравило(Тег.Режим) Тогда
		СоставКанала = СоставПоПравилу(Тег, СписокВерсий);
	Иначе
		СоставКанала = Помеченные(СписокВерсий, МножествоМеток(Тег));
		Запросов = Запросов + ?(ЗначениеЗаполнено(Тег.Идентификатор), 1, 0);
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("Состав", СоставКанала);
	Результат.Вставить("Отдаваемая", ОтдаваемаяСреди(СоставКанала));
	Результат.Вставить("Запросов", Запросов);
	Возврат Результат;

КонецФункции

// Каналы всех тегов пакета разом. Состав ручных каналов читается ОДНИМ запросом на пакет:
// вопрос на тег делал бы вкладку версий дороже ровно во столько раз, сколько у пакета
// ручных каналов. Версии передаются готовыми — пакет читается один раз на все свои каналы.
//
// Параметры:
//  Теги - Массив из Тег - теги одного пакета.
//  ВерсииПакета - Массив из ВерсияПакета - версии пакета.
//
// Возвращаемое значение:
//  Структура - Каналы (Массив из Структура: Тег, Состав, Отдаваемая),
//              Запросов (Число обращений к хранилищу меток: один, если ручной тег есть,
//              иначе ноль).
//
Функция Каналы(Знач Теги, Знач ВерсииПакета) Экспорт

	СоставыРучных = СоставыРучныхКаналов(Теги);

	Собранные = Новый Массив();
	Для Каждого Тег Из Теги Цикл

		Если Режимы.ЭтоПравило(Тег.Режим) Тогда
			СоставКанала = СоставПоПравилу(Тег, ВерсииПакета);
		ИначеЕсли ЗначениеЗаполнено(Тег.Идентификатор) Тогда
			СоставКанала = Помеченные(ВерсииПакета,
				СоставыРучных.ПоТегам.Получить(Цел(Тег.Идентификатор)));
		Иначе
			СоставКанала = Новый Массив(); // тег ещё не сохранён — помечать было нечем
		КонецЕсли;

		Собранные.Добавить(Новый Структура("Тег, Состав, Отдаваемая",
			Тег, СоставКанала, ОтдаваемаяСреди(СоставКанала)));

	КонецЦикла;

	Результат = Новый Структура();
	Результат.Вставить("Каналы", Собранные);
	Результат.Вставить("Запросов", СоставыРучных.Запросов);
	Возврат Результат;

КонецФункции

// Возвращает весь состав канала как версии пакета, включая отозванные.
//
// Параметры:
//  Тег - Тег - тег-канал.
//
// Возвращаемое значение:
//  Массив из ВерсияПакета - состав в порядке версий пакета.
//
Функция ВерсииКанала(Знач Тег) Экспорт
	Возврат Канал(Тег).Состав;
КонецФункции

// Возвращает версию, которую получает установка по тегу: максимальную среди версий
// канала, кроме отозванных.
//
// Параметры:
//  Тег - Тег - тег-канал.
//
// Возвращаемое значение:
//  ВерсияПакета, Неопределено - Неопределено, если канал пуст либо все его версии отозваны.
//
Функция ДействующаяВерсия(Знач Тег) Экспорт
	Возврат Канал(Тег).Отдаваемая;
КонецФункции

// Возвращает максимальную не отозванную версию среди заданных, без обращений
// к хранилищу.
//
// Параметры:
//  СписокВерсий - Массив из ВерсияПакета - кандидаты, отозванные отсеиваются здесь.
//
// Возвращаемое значение:
//  ВерсияПакета, Неопределено - Неопределено, если кандидатов нет.
//
Функция ОтдаваемаяСреди(Знач СписокВерсий) Экспорт

	Кандидаты = Новый Массив();
	Разобранные = Новый Массив();
	Для Каждого Версия Из СписокВерсий Цикл
		Если Версия.Отозвана = Истина Тогда
			Продолжить; // отзыв версию из канала не убирает, но установке она не отдаётся
		КонецЕсли;
		Кандидаты.Добавить(Версия);
		// резолвер принимает готовую версию: разбор по колонкам вместо разбора строки
		Разобранная = Отбор.РазобратьВерсию(Версия);
		Разобранные.Добавить(?(Разобранная = Неопределено, Строка(Версия.Версия), Разобранная));
	КонецЦикла;

	Если Кандидаты.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// непустой состав обязан назвать версию: канал из одних строк вне semver-порядка
	// (SNAPSHOT под ручным тегом или тегом-regex) отдаёт старшую из них, а не «нет такого»
	Лучшая = Резолвер.Максимальная(Разобранные);

	Для Каждого Версия Из Кандидаты Цикл
		Если Строка(Версия.Версия) = Лучшая Тогда
			Возврат Версия;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Возвращает правило тега-правила как значение-объект.
//
// Параметры:
//  Тег - Тег - тег-канал.
//
// Возвращаемое значение:
//  ПравилоТега, Неопределено - Неопределено, если тег ручной либо запись правила повреждена.
//
Функция ПравилоКанала(Знач Тег) Экспорт

	Если НЕ Режимы.ЭтоПравило(Тег.Режим) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат Новый ПравилоТега(Тег.ТипПравила, Тег.Правило);
	Исключение
		Возврат Неопределено; // повреждённая запись не роняет показ карточки
	КонецПопытки;

КонецФункции

// Возвращает множество помеченных вручную идентификаторов — для сверок вызывающего.
// У тега-правила меток нет.
//
// Параметры:
//  Тег - Тег - тег-канал.
//
// Возвращаемое значение:
//  Соответствие - ВерсияИдентификатор (Число) в Истина.
//
Функция МножествоМеток(Знач Тег) Экспорт

	Результат = Новый Соответствие();
	Для Каждого Метка Из МеткиТега(Тег) Цикл
		Результат.Вставить(Метка.ВерсияИдентификатор, Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ВедениеРучногоСостава

// Приводит состав ручного канала к точно заданному набору версий: отсутствующие метки
// ставятся, лишние снимаются.
//
// Параметры:
//  Тег - Тег - тег-канал, обязан быть сохранён: нужен его идентификатор.
//  СписокВерсий - Массив из ВерсияПакета - точный состав канала после операции.
//
// Возвращаемое значение:
//  Структура - Добавлено, Снято (Массив из Число — идентификаторы версий).
//
Функция Пометить(Знач Тег, Знач СписокВерсий) Экспорт

	Существующие = МеткиТега(Тег);

	Было = Новый Соответствие();
	Для Каждого Метка Из Существующие Цикл
		Было.Вставить(Метка.ВерсияИдентификатор, Истина);
	КонецЦикла;

	Нужные = Новый Соответствие(); // «что должно стать» и защита от дубля в одном вызове
	Добавлено = Новый Массив();

	Для Каждого Версия Из СписокВерсий Цикл

		Идентификатор = Версия.Идентификатор;
		Если Нужные.Получить(Идентификатор) = Истина Тогда
			Продолжить; // версия подана дважды
		КонецЕсли;
		Нужные.Вставить(Идентификатор, Истина);

		Если Было.Получить(Идентификатор) = Истина Тогда
			Продолжить; // уже в канале
		КонецЕсли;

		Метка = ХранилищеМеток.СоздатьЭлемент();
		Метка.ТегИдентификатор = Тег.Идентификатор;
		Метка.ВерсияИдентификатор = Идентификатор;
		Метка.Сохранить();
		Добавлено.Добавить(Идентификатор);

	КонецЦикла;

	Снято = Новый Массив();
	Для Каждого Метка Из Существующие Цикл
		Если Нужные.Получить(Метка.ВерсияИдентификатор) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Метка.Удалить();
		Снято.Добавить(Метка.ВерсияИдентификатор);
	КонецЦикла;

	Результат = Новый Структура();
	Результат.Вставить("Добавлено", Добавлено);
	Результат.Вставить("Снято", Снято);
	Возврат Результат;

КонецФункции

// Ставит канал ровно на одну версию.
//
// Параметры:
//  Тег - Тег - тег-канал.
//  Версия - ВерсияПакета - единственная версия канала после операции.
//
// Возвращаемое значение:
//  Структура - как у Пометить.
//
Функция ПометитьОдну(Знач Тег, Знач Версия) Экспорт
	Одна = Новый Массив();
	Одна.Добавить(Версия);
	Возврат Пометить(Тег, Одна);
КонецФункции

// Добавляет версию в канал, не трогая остальные.
//
// Параметры:
//  Тег - Тег - тег-канал.
//  Версия - ВерсияПакета - добавляемая версия.
//
// Возвращаемое значение:
//  Булево - Истина, если метки не было и она поставлена.
//
Функция Добавить(Знач Тег, Знач Версия) Экспорт

	Если МножествоМеток(Тег).Получить(Версия.Идентификатор) = Истина Тогда
		Возврат Ложь;
	КонецЕсли;

	Метка = ХранилищеМеток.СоздатьЭлемент();
	Метка.ТегИдентификатор = Тег.Идентификатор;
	Метка.ВерсияИдентификатор = Версия.Идентификатор;
	Метка.Сохранить();
	Возврат Истина;

КонецФункции

// Снимает одну версию с канала, не трогая остальные.
//
// Параметры:
//  Тег - Тег - тег-канал.
//  Версия - ВерсияПакета - снимаемая версия.
//
// Возвращаемое значение:
//  Булево - Истина, если метка была и снята.
//
Функция Снять(Знач Тег, Знач Версия) Экспорт

	Для Каждого Метка Из МеткиТега(Тег) Цикл
		Если Метка.ВерсияИдентификатор <> Версия.Идентификатор Тогда
			Продолжить;
		КонецЕсли;
		Метка.Удалить();
		Возврат Истина;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Снимает все метки тега: они не должны пережить ни удаляемый тег, ни его перевод
// в режим правила.
//
// Параметры:
//  Тег - Тег - тег-канал.
//
// Возвращаемое значение:
//  Число - сколько меток снято.
//
Функция Очистить(Знач Тег) Экспорт
	Возврат Пометить(Тег, Новый Массив()).Снято.Количество();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Единственное место обращения к репозиторию меток за составом ОДНОГО тега.
Функция МеткиТега(Знач Тег)

	Если НЕ ЗначениеЗаполнено(Тег.Идентификатор) Тогда
		Возврат Новый Массив(); // тег ещё не сохранён
	КонецЕсли;

	Результат = ХранилищеМеток.ПолучитьПоТегИдентификаторРавно(Тег.Идентификатор);
	Возврат ?(Результат = Неопределено, Новый Массив(), Результат);

КонецФункции

// Составы всех ручных каналов пакета одним чтением: множество помеченных версий на тег
// плюс число обращений, которых чтение стоило.
Функция СоставыРучныхКаналов(Знач Теги)

	НомераТегов = Новый Массив();
	Для Каждого Тег Из Теги Цикл
		Если НЕ Режимы.ЭтоПравило(Тег.Режим) И ЗначениеЗаполнено(Тег.Идентификатор) Тогда
			НомераТегов.Добавить(Цел(Тег.Идентификатор));
		КонецЕсли;
	КонецЦикла;

	// имя «Множества» занято глобальным именем библиотеки autumn: локальная переменная его не перебьёт
	ПоТегам = Новый Соответствие();
	Для Каждого Метка Из ХранилищеМеток.СоставТегов(НомераТегов) Цикл
		Ключ = Цел(Метка.ТегИдентификатор);
		Множество = ПоТегам.Получить(Ключ);
		Если Множество = Неопределено Тогда
			Множество = Новый Соответствие();
			ПоТегам.Вставить(Ключ, Множество);
		КонецЕсли;
		Множество.Вставить(Метка.ВерсияИдентификатор, Истина);
	КонецЦикла;

	Возврат Новый Структура("ПоТегам, Запросов",
		ПоТегам, ?(НомераТегов.Количество() = 0, 0, 1));

КонецФункции

// Повреждённая запись правила даёт пустой канал, а не выдачу чего попало.
Функция СоставПоПравилу(Знач Тег, Знач СписокВерсий)

	Правило = ПравилоКанала(Тег);
	Возврат ?(Правило = Неопределено, Новый Массив(), Отбор.ОтобратьВерсии(СписокВерсий, Правило));

КонецФункции

// Метка на версию чужого пакета или на исчезнувшую строку в состав не попадает.
Функция Помеченные(Знач СписокВерсий, Знач Метки)

	Результат = Новый Массив();
	Если СписокВерсий = Неопределено ИЛИ Метки = Неопределено ИЛИ Метки.Количество() = 0 Тогда
		Возврат Результат; // у канала без единой метки состава нет
	КонецЕсли;

	Для Каждого Версия Из СписокВерсий Цикл
		Если Метки.Получить(Версия.Идентификатор) = Истина Тогда
			Результат.Добавить(Версия);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеМетокТегов") _ХранилищеМеток,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "РезолверВерсий") _Резолвер,
	&Пластилин(Значение = "ОтборВерсийПоПравилу") _Отбор,
	&Пластилин(Значение = "РежимТега") _Режимы)

	ХранилищеМеток = _ХранилищеМеток;
	СервисВерсий = _СервисВерсий;
	Резолвер = _Резолвер;
	Отбор = _Отбор;
	Режимы = _Режимы;

КонецПроцедуры
