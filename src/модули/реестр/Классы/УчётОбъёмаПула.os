// Занятое пулом место — всё, что реально лежит в хранилище под этим пулом. Экраны читают
// счётчик Пул.ЗанятоБайт, Пересчитать() приводит его к замеру хранилища.

Перем ХранилищеПулов;      // ХранилищеПулов (данные)
Перем ХранилищеПакетов;    // ХранилищеПакетов (данные)
Перем ХранилищеАртефактов; // ХранилищеАртефактов (хранилище) — источник истины о занятом
Перем Сторож;              // СторожЗаполненияПула — необязателен
Перем Блокировка;          // БлокировкаРесурса — сериализация read-modify-write счётчика

#Область ПубличныйИнтерфейс

// Занятый пулом объём в байтах.
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Число - занятый объём, байты; 0 для отсутствующего пула.
//
Функция ЗанятоБайт(Знач Пул) Экспорт

	Если Пул = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Неотрицательное(Пул.ЗанятоБайт);

КонецФункции

// Учитывает изменение объёма пула, которому принадлежит пакет, и сообщает о нём сторожу
// заполнения. Нулевая дельта записи не делает.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета, версия которого изменилась.
//  ДельтаБайт - Число - приращение объёма; отрицательное уменьшает.
//
// Возвращаемое значение:
//  Структура, Неопределено - Пул, ЗанятоДо (Число), ЗанятоПосле (Число);
//                            Неопределено, если пакет или его пул не найден.
//
Функция УчестьПоПакету(Знач ПакетИдентификатор, Знач ДельтаБайт) Экспорт

	Пакет = ХранилищеПакетов.ПолучитьОдноПоИдентификаторРавно(Цел(ПакетИдентификатор));
	Если Пакет = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Учесть(ПулПакета(Пакет), ДельтаБайт);

КонецФункции

// Учитывает изменение объёма пула и сообщает о нём сторожу заполнения.
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//  ДельтаБайт - Число - приращение объёма; отрицательное уменьшает.
//
// Возвращаемое значение:
//  Структура, Неопределено - Пул, ЗанятоДо (Число), ЗанятоПосле (Число).
//
Функция Учесть(Знач Пул, Знач ДельтаБайт) Экспорт

	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Итог = ПодБлокировкой(Цел(Пул.Идентификатор), ДельтаБайт, Неопределено);
	Если Итог = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Известить(Итог.Пул, Итог.ЗанятоДо, Итог.ЗанятоПосле);
	Возврат Итог;

КонецФункции

// Замеряет область хранения пула и записывает результат в счётчик. Дорогая операция:
// обход каталога на файловом бэкенде, листинг префикса на S3. Зовётся там, где счётчик
// мог разъехаться с реальностью, — плановой сверкой и перед решениями о квоте.
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Число - замеренный объём, байты.
//
// Выбрасывает исключение, если хранилище не смогло замерить область пула.
//
Функция Пересчитать(Знач Пул) Экспорт

	Если Пул = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ПринятьЗамер(Пул, ХранилищеАртефактов.ОбъёмПула(Строка(Пул.Имя)));

КонецФункции

// Записывает в счётчик уже сделанный замер области пула и сообщает о нём сторожу
// заполнения. Для тех, кто замерил хранилище сам: плановая сверка снимает объёмы всех
// пулов одним проходом, потому что на S3 поштучный замер стоит обхода всего бакета.
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//  ЗамерБайт - Число - занятый объём по замеру хранилища, байты.
//
// Возвращаемое значение:
//  Число - записанный объём, байты.
//
Функция ПринятьЗамер(Знач Пул, Знач ЗамерБайт) Экспорт

	Если Пул = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Замер = Неотрицательное(ЗамерБайт);
	Итог = ПодБлокировкой(Цел(Пул.Идентификатор), 0, Замер);
	Если Итог <> Неопределено Тогда
		Известить(Итог.Пул, Итог.ЗанятоДо, Итог.ЗанятоПосле);
	КонецЕсли;
	Возврат Замер;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Read-modify-write под блокировкой: без неё параллельные публикации теряют инкременты.
Функция ПодБлокировкой(Знач ПулИдентификатор, Знач ДельтаБайт, Знач ТочноеЗначение)

	Блокировка.Заблокировать();
	Попытка
		Итог = Записать(ПулИдентификатор, ДельтаБайт, ТочноеЗначение);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();
	Возврат Итог;

КонецФункции

Функция Записать(Знач ПулИдентификатор, Знач ДельтаБайт, Знач ТочноеЗначение)

	Пул = ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(ПулИдентификатор);
	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЗанятоДо = Неотрицательное(Пул.ЗанятоБайт);
	ЗанятоПосле = ?(ТочноеЗначение = Неопределено,
		Неотрицательное(ЗанятоДо + Цел(ДельтаБайт)), Неотрицательное(ТочноеЗначение));

	Если ЗанятоПосле <> ЗанятоДо Тогда
		Пул.ЗанятоБайт = ЗанятоПосле;
		Пул.Сохранить();
	КонецЕсли;

	Возврат Новый Структура("Пул, ЗанятоДо, ЗанятоПосле", Пул, ЗанятоДо, ЗанятоПосле);

КонецФункции

Функция ПулПакета(Знач Пакет)
	Возврат ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(Цел(Пакет.ПулИдентификатор));
КонецФункции

// Сбой сторожа не должен ронять публикацию: счётчик уже записан, уведомление вторично.
Процедура Известить(Знач Пул, Знач ЗанятоДо, Знач ЗанятоПосле)

	Если Сторож = Неопределено ИЛИ ЗанятоПосле = ЗанятоДо Тогда
		Возврат;
	КонецЕсли;
	Сторож.ПослеИзменения(Пул, ЗанятоДо, ЗанятоПосле);

КонецПроцедуры

Функция Неотрицательное(Знач Значение)
	Если Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Число_ = Цел(Число(Значение));
	Возврат ?(Число_ < 0, 0, Число_);
КонецФункции

#КонецОбласти

&Прозвище("УчётОбъёмаПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПулов") _ХранилищеПулов,
	&Пластилин(Значение = "ХранилищеПакетов") _ХранилищеПакетов,
	&Пластилин(Значение = "ХранилищеАртефактов") _ХранилищеАртефактов,
	&Пластилин(Значение = "СторожЗаполненияПула", Тип = "Массив") _Сторож)

	ХранилищеПулов = _ХранилищеПулов;
	ХранилищеПакетов = _ХранилищеПакетов;
	ХранилищеАртефактов = _ХранилищеАртефактов;
	// Массив — способ ОСени выразить необязательную зависимость: контейнер без модуля
	// events собирается, объём считается, о заполнении просто некому сообщать.
	Сторож = ?(_Сторож = Неопределено ИЛИ _Сторож.Количество() = 0, Неопределено, _Сторож[0]);
	Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);

КонецПроцедуры
