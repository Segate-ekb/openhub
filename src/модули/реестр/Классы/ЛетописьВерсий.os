// Превращает отзыв и восстановление версии в доменное событие; та же нагрузка несёт
// поля журнала аудита — у отзыва два адресата, подписчик и журнал.

Перем СервисПакетов; // СервисПакетов
Перем СервисПулов;   // СервисПулов
Перем ИменаЖурнала;  // ИмяОбъектаАудита (аудит) — вид объекта в журнале
Перем Издатель;      // ИздательСобытий, может быть Неопределено
Перем КэшКоординат;  // Соответствие: ПакетИдентификатор -> Структура координат

#Область ПубличныйИнтерфейс

// Публикует событие отзыва или восстановления версии. Сбой публикации гасится:
// уведомление не имеет права ломать состоявшийся отзыв.
//
// Параметры:
//  ПакетИдентификатор - Число - пакет версии.
//  СтрокаВерсии - Строка - версия.
//  Отозвана - Булево - Истина: отзыв, Ложь: восстановление.
//  Кем - Строка - логин принципала (необязательный, по умолчанию "" — система).
//
Процедура ЗаписатьОтзыв(Знач ПакетИдентификатор, Знач СтрокаВерсии, Знач Отозвана, Знач Кем = "") Экспорт

	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Опубликовать(ПакетИдентификатор, СтрокаВерсии, Отозвана, Кем);
	Исключение
		// уведомление не имеет права ломать состоявшийся отзыв
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Опубликовать(Знач ПакетИдентификатор, Знач СтрокаВерсии, Знач Отозвана, Знач Кем)

	Координаты = Координаты(ПакетИдентификатор);

	Данные = Новый Структура();
	Данные.Вставить("Кто", ?(ЗначениеЗаполнено(Кем), Строка(Кем), ИменаЖурнала.Система()));
	Данные.Вставить("ПулИдентификатор", Координаты.ПулИдентификатор);
	Данные.Вставить("ПакетИдентификатор", Цел(ПакетИдентификатор));
	Данные.Вставить("ИмяПула", Координаты.ИмяПула);
	Данные.Вставить("ИмяПакета", Координаты.ИмяПакета);
	Данные.Вставить("Версия", Строка(СтрокаВерсии));
	Данные.Вставить("Отозвана", Отозвана = Истина);

	ТипСобытия = ?(Отозвана = Истина,
		Издатель.ТипВерсияОтозвана(), Издатель.ТипВерсияВосстановлена());

	Данные.Вставить("Действие", ТипСобытия);
	Данные.Вставить("Объект",
		ИменаЖурнала.ВерсияПоИменам(Координаты.ИмяПула, Координаты.ИмяПакета, СтрокаВерсии));
	Данные.Вставить("ДеталиJSON", ДеталиJSON(СтрокаВерсии, Отозвана));
	Данные.Вставить("АдресIP", "");

	Издатель.Опубликовать(ТипСобытия, Данные);

КонецПроцедуры

Функция ДеталиJSON(Знач СтрокаВерсии, Знач Отозвана)

	Детали = Новый Структура("версия, отозвана", Строка(СтрокаВерсии), Отозвана = Истина);
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Детали);
	Возврат Запись.Закрыть();

КонецФункции

// Неизвестный пакет — нули и пустые имена: событие публикуется, но скоуп доставки пуст.
Функция Координаты(Знач ПакетИдентификатор)

	Готовые = КэшКоординат.Получить(ПакетИдентификатор);
	Если Готовые <> Неопределено Тогда
		Возврат Готовые;
	КонецЕсли;

	Результат = Новый Структура("ПулИдентификатор, ИмяПула, ИмяПакета", 0, "", "");

	Пакет = СервисПакетов.ПакетПоИдентификатору(ПакетИдентификатор);
	Если Пакет <> Неопределено Тогда
		Результат.ИмяПакета = Строка(Пакет.Имя);
		Результат.ПулИдентификатор = Цел(Пакет.ПулИдентификатор);
		Пул = СервисПулов.ПулПоИдентификатору(Пакет.ПулИдентификатор);
		Если Пул <> Неопределено Тогда
			Результат.ИмяПула = Строка(Пул.Имя);
		КонецЕсли;
	КонецЕсли;

	КэшКоординат.Вставить(ПакетИдентификатор, Результат);
	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ИмяОбъектаАудита") _Имена,
	&Пластилин(Значение = "ИздательСобытий") _Издатель = Неопределено)

	СервисПакетов = _СервисПакетов;
	СервисПулов = _СервисПулов;
	ИменаЖурнала = _Имена;
	Издатель = _Издатель;
	КэшКоординат = Новый Соответствие();

КонецПроцедуры
