// Превращает отзыв и восстановление версии в доменное событие; та же нагрузка несёт
// поля журнала аудита — у отзыва два адресата, подписчик и журнал. Поля записи собирает
// СобытиеАудита, координаты пакета для скоупа доставки — КоординатыПакета.

Перем ИменаЖурнала;   // ИмяОбъектаАудита (аудит) — вид объекта в журнале
Перем СобытиеЖурнала; // СобытиеАудита (аудит) — форма нагрузки записи
Перем Координаты;     // КоординатыПакета (реестр) — пул и имена пакета
Перем Издатель;       // ИздательСобытий, может быть Неопределено

#Область ПубличныйИнтерфейс

// Публикует событие отзыва или восстановления версии. Сбой публикации гасится:
// уведомление не имеет права ломать состоявшийся отзыв.
//
// Параметры:
//  ПакетИдентификатор - Число - пакет версии.
//  СтрокаВерсии - Строка - версия.
//  Отозвана - Булево - Истина: отзыв, Ложь: восстановление.
//  Кем - Строка - логин принципала (необязательный, по умолчанию "" — система).
//
Процедура ЗаписатьОтзыв(Знач ПакетИдентификатор, Знач СтрокаВерсии, Знач Отозвана, Знач Кем = "") Экспорт

	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Опубликовать(ПакетИдентификатор, СтрокаВерсии, Отозвана, Кем);
	Исключение
		// уведомление не имеет права ломать состоявшийся отзыв
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Опубликовать(Знач ПакетИдентификатор, Знач СтрокаВерсии, Знач Отозвана, Знач Кем)

	Адрес = Координаты.Пакета(ПакетИдентификатор);
	ТипСобытия = ?(Отозвана = Истина,
		Издатель.ТипВерсияОтозвана(), Издатель.ТипВерсияВосстановлена());

	Данные = СобытиеЖурнала.Собрать(Кем, ТипСобытия,
		ИменаЖурнала.ВерсияПоИменам(Адрес.ИмяПула, Адрес.ИмяПакета, СтрокаВерсии), "",
		Детали(СтрокаВерсии, Отозвана));

	// координаты пакета задают скоуп доставки подпискам — без утечки между пулами
	Данные.Вставить("ПулИдентификатор", Адрес.ПулИдентификатор);
	Данные.Вставить("ПакетИдентификатор", Цел(ПакетИдентификатор));
	Данные.Вставить("ИмяПула", Адрес.ИмяПула);
	Данные.Вставить("ИмяПакета", Адрес.ИмяПакета);
	Данные.Вставить("Версия", Строка(СтрокаВерсии));
	Данные.Вставить("Отозвана", Отозвана = Истина);

	Издатель.Опубликовать(ТипСобытия, Данные);

КонецПроцедуры

Функция Детали(Знач СтрокаВерсии, Знач Отозвана)
	Возврат Новый Структура("версия, отозвана", Строка(СтрокаВерсии), Отозвана = Истина);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ИмяОбъектаАудита") _Имена,
	&Пластилин(Значение = "СобытиеАудита") _Событие,
	&Пластилин(Значение = "КоординатыПакета") _Координаты,
	&Пластилин(Значение = "ИздательСобытий") _Издатель = Неопределено)

	ИменаЖурнала = _Имена;
	СобытиеЖурнала = _Событие;
	Координаты = _Координаты;
	Издатель = _Издатель;

КонецПроцедуры
