// Задача планировщика «сверка-объёмов-пулов»: сверка счётчика занятого объёма пулов
// с действующей квотой.

Перем Сверка;    // СверкаОбъёмовПулов
Перем Интервал;  // интервал сверки из настройки, секунды

// Регистрация в планировщике: сверка раз в интервал из настройки.
//
// Параметры:
//  Регистрации - РегистрацииЗадачи - куда записывается регистрация.
//
Процедура Зарегистрировать(Регистрации) Экспорт
	Регистрации.КаждыеСекунд("сверка-объёмов-пулов", Интервал);
КонецПроцедуры

// Выполняет один проход сверки занятого объёма.
// Сбой сверки перебрасывается планировщику.
//
&Наблюдаемый("job.pool_volume_audit")
Процедура Исполнить() Экспорт
	Сверка.Сверить();
КонецПроцедуры

&Прозвище("ЗадачаПланировщика")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СверкаОбъёмовПулов") _Сверка,
	&Деталька(Значение = "oshub.jobs.pool_volume_audit_interval_sec", ЗначениеПоУмолчанию = 3600) _Интервал = Неопределено)

	Сверка = _Сверка;
	Интервал = Новый ПриведениеЧисел().ЧислоИлиДефолт(_Интервал, 3600);

КонецПроцедуры
