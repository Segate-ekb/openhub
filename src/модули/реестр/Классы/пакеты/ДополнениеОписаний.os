// README из репозитория пакета для версии, у которой его нет в самом пакете: фоном после публикации
// и шагом ночного обхода. Байты дополненного описания учитываются в объёме пула.

Перем Служба;          // СлужбаREADMEРепозитория (описания), необязательно
Перем Фон;             // ЗапускВФоне (фоновыеЗадания), необязательно
Перем СервисПулов;     // СервисПулов
Перем СервисПакетов;   // СервисПакетов
Перем Занятое;         // ЗаписьЗанятогоМеста
Перем Ошибки;          // ТекстОшибки (основа)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Ставит дополнение описания версии в фон и возвращается сразу: ответ публикации GitHub не ждёт.
//
// Параметры:
//  Пул                - Пул          - пул пакета; перечитывается в фоне.
//  Пакет              - Пакет        - пакет; перечитывается в фоне.
//  Версия             - ВерсияПакета - принятая версия.
//
Процедура ЗапуститьВФоне(Знач Пул, Знач Пакет, Знач Версия) Экспорт

	Если Служба = Неопределено ИЛИ Фон = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// публикация не должна упасть из-за описания ни при каком стечении обстоятельств
	Попытка
		Фон.Запустить(Новый ЗаданиеДополненияОписания(ЭтотОбъект, Пул.Идентификатор, Пакет.Идентификатор,
			Версия));
	Исключение
		Лог.Предупреждение("README версии ""%1"" %2 из репозитория искать не стали — фон не принял задание: %3",
			Пакет.Имя, Версия.Версия, Ошибки.Причина(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Дополнение, уже снятое с потока публикации: его зовёт фоновое задание. Пул и пакет перечитываются:
// адрес репозитория могла положить та же публикация, пул — переименоваться. Наружу не бросает.
//
// Параметры:
//  ПулИдентификатор   - Число        - пул пакета.
//  ПакетИдентификатор - Число        - пакет.
//  Версия             - ВерсияПакета - принятая версия.
//
Процедура ДополнитьСейчас(Знач ПулИдентификатор, Знач ПакетИдентификатор, Знач Версия) Экспорт

	Попытка
		Пул = СервисПулов.ПулПоИдентификатору(ПулИдентификатор);
		Пакет = СервисПакетов.ПакетПоИдентификатору(ПакетИдентификатор);
		Если Пул <> Неопределено И Пакет <> Неопределено Тогда
			Дополнить(Пул, Пакет, Версия);
		КонецЕсли;
	Исключение
		Лог.Предупреждение("README версии пакета #%1 %2 из репозитория не взят: %3",
			ПакетИдентификатор, Версия.Версия, Ошибки.Причина(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Дополняет описание версии README из репозитория пакета, если пора, и учитывает его байты.
//
// Параметры:
//  Пул    - Пул          - пул пакета.
//  Пакет  - Пакет        - пакет.
//  Версия - ВерсияПакета, Неопределено - версия; Неопределено — дополнять нечего.
//
Процедура Дополнить(Знач Пул, Знач Пакет, Знач Версия) Экспорт

	Если Служба = Неопределено ИЛИ Версия = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Дельта = Служба.Дополнить(Пул, Пакет, Версия);
	// байты справки лежат в области пула: счётчик ведёт тот, кто решил её положить
	Занятое.Учесть(Пул, Дельта, СтрШаблон("описание из репозитория %1-%2", Пакет.Имя, Версия.Версия));

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "ЗаписьЗанятогоМеста") _Занятое,
	&Пластилин(Значение = "СлужбаREADMEРепозитория", Тип = "Массив") _Служба = Неопределено,
	&Пластилин(Значение = "ЗапускВФоне", Тип = "Массив") _Фон = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Желуди = Новый ВнедрённыеЖелуди();
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	Занятое = _Занятое;
	Служба = Желуди.ПервыйИз(_Служба);
	Фон = Желуди.ПервыйИз(_Фон);
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
