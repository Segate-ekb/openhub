// Пакет по идентификатору: его пул, имена и адрес для журнала. Помнится только последний
// спрошенный — летопись спрашивает координаты одного пакета подряд, в цикле переезда канала.

Перем СервисПакетов; // СервисПакетов
Перем СервисПулов;   // СервисПулов
Перем ИменаЖурнала;  // ИмяОбъектаАудита (аудит) — адрес пакета в журнале
Перем Запомненное;   // Структура(Пакет, Координаты) — пара «чей идентификатор, те и координаты»

#Область ПубличныйИнтерфейс

// Координаты пакета. Неизвестный пакет — нули и пустые имена: событие публикуется,
// но скоуп доставки пуст, а адрес называет утраченную сущность.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Структура - ПулИдентификатор (Число), ИмяПула (Строка), ИмяПакета (Строка),
//              Адрес (Строка) — адрес пакета для журнала аудита.
//
Функция Пакета(Знач ПакетИдентификатор) Экспорт

	// поле читается один раз: соседний поток вправе подменить пару прямо сейчас
	Память = Запомненное;
	Если Память <> Неопределено И Память.Пакет = Цел(ПакетИдентификатор) Тогда
		Возврат Память.Координаты;
	КонецЕсли;

	Найденные = Разыскать(ПакетИдентификатор);
	Если Найденные = Неопределено Тогда
		// утраченный пакет не запоминается: промах не должен жить до конца процесса
		Возврат Утраченные(ПакетИдентификатор);
	КонецЕсли;

	Если ЗначениеЗаполнено(Найденные.ИмяПула) Тогда
		// пара публикуется одним присваиванием; пакет без пула не запоминается, как и утраченный
		Запомненное = Новый Структура("Пакет, Координаты", Цел(ПакетИдентификатор), Найденные);
	КонецЕсли;
	Возврат Найденные;

КонецФункции

// Адрес пакета для журнала аудита.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Строка - "пул/пакет" либо "пакет#<идентификатор>" для утраченного пакета.
//
Функция АдресПакета(Знач ПакетИдентификатор) Экспорт
	Возврат Пакета(ПакетИдентификатор).Адрес;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Разыскать(Знач ПакетИдентификатор)

	Пакет = СервисПакетов.ПакетПоИдентификатору(ПакетИдентификатор);
	Если Пакет = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяПакета = Строка(Пакет.Имя);
	ИмяПула = "";
	Пул = СервисПулов.ПулПоИдентификатору(Пакет.ПулИдентификатор);
	Если Пул <> Неопределено Тогда
		ИмяПула = Строка(Пул.Имя);
	КонецЕсли;

	Возврат Новый Структура("ПулИдентификатор, ИмяПула, ИмяПакета, Адрес",
		Цел(Пакет.ПулИдентификатор), ИмяПула, ИмяПакета,
		ИменаЖурнала.ПакетПоИменам(ИмяПула, ИмяПакета));

КонецФункции

Функция Утраченные(Знач ПакетИдентификатор)

	Возврат Новый Структура("ПулИдентификатор, ИмяПула, ИмяПакета, Адрес",
		0, "", "", ИменаЖурнала.Неизвестный("пакет", ПакетИдентификатор));

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ИмяОбъектаАудита") _Имена)

	СервисПакетов = _СервисПакетов;
	СервисПулов = _СервисПулов;
	ИменаЖурнала = _Имена;
	Запомненное = Неопределено;

КонецПроцедуры
