// Правка карточки пакета его мейнтейнером: проверка введённого адреса репозитория, запись
// и след в журнале аудита — было и стало по изменённым полям.

Перем СервисПакетов;  // СервисПакетов — запись полей карточки
Перем Правила;        // ПравилаИменования — годность адреса репозитория
Перем ИменаЖурнала;   // ИмяОбъектаАудита (аудит) — адрес пакета в журнале
Перем СобытиеЖурнала; // СобытиеАудита (аудит) — форма нагрузки записи
Перем Издатель;       // ИздательСобытий (события), необязателен
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Записывает поля карточки пакета. Изменённый адрес репозитория проверяется
// (ПравилаИменования.ОтказАдресаРепозитория), пустой снимает адрес. Правка, после которой
// карточка та же, записи в журнале не даёт.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Свойства - Структура - поля карточки, как у СервисПакетов.ОбновитьМетаданные.
//  Кем - Строка - логин правящего (необязательный, по умолчанию "" — система).
//
// Возвращаемое значение:
//  Пакет - пакет после правки.
//
Функция Править(Знач ПакетИдентификатор, Знач Свойства, Знач Кем = "") Экспорт

	Пакет = СервисПакетов.ПакетПоИдентификатору(ПакетИдентификатор);
	Если Пакет = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Пакет с идентификатором %1 не найден", ПакетИдентификатор);
	КонецЕсли;
	Было = ПоляКарточки(Пакет);

	Поля = ПроверенныеСвойства(Свойства, Было);
	Пакет = СервисПакетов.ОбновитьМетаданные(ПакетИдентификатор, Поля);

	Разница = Разница(Было, ПоляКарточки(Пакет));
	Если Разница.Количество() > 0 Тогда
		НазватьПравку(Пакет, Разница, Кем);
		ЗаписатьВАудит(Пакет, Разница, Кем);
	КонецЕсли;
	Возврат Пакет;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Прежний адрес мог прийти из манифеста по прежнему правилу: проверяется только изменённый.
Функция ПроверенныеСвойства(Знач Свойства, Знач Было)

	Результат = Новый Структура();
	Для Каждого Пара Из Свойства Цикл
		Результат.Вставить(Пара.Ключ, Пара.Значение);
	КонецЦикла;

	Адрес = Неопределено;
	Если НЕ Результат.Свойство("АдресРепозитория", Адрес) Тогда
		Возврат Результат;
	КонецЕсли;

	Адрес = СокрЛП(Строка(?(Адрес = Неопределено, "", Адрес)));
	Результат.Вставить("АдресРепозитория", Адрес);
	Если Адрес = Было.АдресРепозитория Тогда
		Возврат Результат;
	КонецЕсли;

	Отказ = Правила.ОтказАдресаРепозитория(Адрес);
	Если ЗначениеЗаполнено(Отказ) Тогда
		ВызватьИсключение Отказ;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПоляКарточки(Знач Пакет)

	Поля = Новый Структура();
	Поля.Вставить("Описание", Строка(Пакет.Описание));
	Поля.Вставить("КлючевыеСлова", Строка(Пакет.КлючевыеСлова));
	Поля.Вставить("Лицензия", Строка(Пакет.Лицензия));
	Поля.Вставить("АдресРепозитория", Строка(Пакет.АдресРепозитория));
	Поля.Вставить("Устарел", Пакет.Устарел = Истина);
	Поля.Вставить("Скрыт", Пакет.Скрыт = Истина);
	Возврат Поля;

КонецФункции

Функция Разница(Знач Было, Знач Стало)

	Результат = Новый Структура();
	Для Каждого Пара Из Было Цикл
		Новое = Стало[Пара.Ключ];
		Если Новое <> Пара.Значение Тогда
			Результат.Вставить(ИмяПоляВЖурнале(Пара.Ключ),
				Новый Структура("было, стало", Пара.Значение, Новое));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ключи деталей журнала — те же слова, что у прочих записей: строчными, через подчёркивание.
Функция ИмяПоляВЖурнале(Знач Поле)

	Имена = Новый Соответствие();
	Имена.Вставить("Описание", "описание");
	Имена.Вставить("КлючевыеСлова", "ключевые_слова");
	Имена.Вставить("Лицензия", "лицензия");
	Имена.Вставить("АдресРепозитория", "репозиторий");
	Имена.Вставить("Устарел", "устарел");
	Имена.Вставить("Скрыт", "скрыт");
	Возврат Имена[Поле];

КонецФункции

// Строка уровня хаба о правке; её сбой правку не отменяет.
Процедура НазватьПравку(Знач Пакет, Знач Разница, Знач Кем)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Поля = Новый Массив();
	Для Каждого Пара Из Разница Цикл
		Поля.Добавить(Пара.Ключ);
	КонецЦикла;

	Попытка
		Лог.Информация("Карточка пакета ""%1"" изменена: %2, кто ""%3""",
			ИменаЖурнала.Пакет(Пакет.Идентификатор), СтрСоединить(Поля, ", "),
			?(ЗначениеЗаполнено(Кем), Кем, ИменаЖурнала.Система()));
	Исключение
		// строка журнала вторична: правка уже записана
	КонецПопытки;

КонецПроцедуры

// Аудит не отменяет состоявшуюся правку: сбой публикации гасится.
Процедура ЗаписатьВАудит(Знач Пакет, Знач Разница, Знач Кем)

	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Издатель.Опубликовать(Издатель.ТипКарточкаПакетаИзменена(), СобытиеЖурнала.Собрать(
			Строка(Кем), Издатель.ТипКарточкаПакетаИзменена(),
			ИменаЖурнала.Пакет(Пакет.Идентификатор), "", Разница));
	Исключение
		// журнал вторичен: правка уже записана
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

&Прозвище("ПравкаКарточкиПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "ПравилаИменования") _Правила,
	&Пластилин(Значение = "ИмяОбъектаАудита") _Имена,
	&Пластилин(Значение = "СобытиеАудита") _Событие,
	&Пластилин(Значение = "ИздательСобытий") _Издатель = Неопределено,
	&Лог _Лог = Неопределено) Экспорт

	СервисПакетов = _СервисПакетов;
	Правила = _Правила;
	ИменаЖурнала = _Имена;
	СобытиеЖурнала = _Событие;
	Издатель = _Издатель;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
