// Хранилище пакетов — репозиторий сущности «Пакет»: выборки, счёт и снимки для кэша.
// Канонический ключ поиска по имени — колонка ИмяНижнийРегистр, уникальная в разрезе пула.

// BSLLS:UnusedParameters-off

#Использовать entity

Перем Сам;          // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё
Перем Агрегаты;     // АгрегатыБазы (данные) — счёт спрашивается у базы
Перем ФормаСнимка;  // ФормаСнимка (данные) — снимок строки пакета для кэша; строится при первом снимке

// Пакет по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Пакет, Неопределено - найденный пакет.
//
&МетодЗапроса
Функция ПолучитьОдноПоИдентификаторРавно(Идентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Пакеты перечисленных идентификаторов одним отбором.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Массив из Пакет - найденные пакеты.
//
&МетодЗапроса
Функция ПолучитьПоИдентификаторВ(Идентификаторы) Экспорт
	Возврат Неопределено;
КонецФункции

// Все пакеты пула.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из Пакет - пакеты пула.
//
&МетодЗапроса
Функция ПолучитьПоПулИдентификаторРавно(ПулИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Пакеты перечисленных пулов одним отбором.
//
// Параметры:
//  ПулИдентификаторы - Массив из Число - идентификаторы пулов.
//
// Возвращаемое значение:
//  Массив из Пакет - пакеты названных пулов.
//
&МетодЗапроса
Функция ПолучитьПоПулИдентификаторВ(ПулИдентификаторы) Экспорт
	Возврат Неопределено;
КонецФункции

// Пакет пула по каноническому (нижнерегистровому) имени.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  ИмяНижнийРегистр - Строка - имя пакета в нижнем регистре.
//
// Возвращаемое значение:
//  Пакет, Неопределено - найденный пакет.
//
&МетодЗапроса
Функция ПолучитьОдноПоПулИдентификаторРавноИИмяНижнийРегистрРавно(ПулИдентификатор, ИмяНижнийРегистр) Экспорт
	Возврат Неопределено;
КонецФункции

// Пакеты пула, названные списком имён: разрез под вопрос «какие из этих имён уже есть».
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  ИменаНижнийРегистр - Массив из Строка - канонические имена пакетов.
//
// Возвращаемое значение:
//  Массив из Пакет - найденные пакеты пула.
//
&МетодЗапроса
Функция ПолучитьПоПулИдентификаторРавноИИмяНижнийРегистрВ(ПулИдентификатор, ИменаНижнийРегистр) Экспорт
	Возврат Неопределено;
КонецФункции

// Вся таблица без отбора.
//
// Возвращаемое значение:
//  Массив из Пакет - все пакеты хаба.
//
&МетодЗапроса
Функция ПолучитьПо() Экспорт
	Возврат Неопределено;
КонецФункции

// Пакеты перечисленных идентификаторов — один запрос на весь список там, где вопрос
// задаётся про горстку адресов сразу, а не про один пакет.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Массив из Пакет - найденные пакеты.
//
Функция ПакетыПоИдентификаторам(Знач Идентификаторы) Экспорт

	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат Сам.Достать().ПолучитьПоИдентификаторВ(Идентификаторы);

КонецФункции

// Снимки пакетов пула из кэша «пакетыПула»: поля пакета, только для чтения.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  ФиксированныйМассив из ФиксированнаяСтруктура - снимки пакетов пула.
//
&Кэшируемый("пакетыПула")
Функция СнимкиПула(Знач ПулИдентификатор) Экспорт
	Возврат Форма().Снимки(Сам.Достать().ПолучитьПоПулИдентификаторРавно(ПулИдентификатор));
КонецФункции

// Снимки пакетов нескольких пулов из кэша «пакетыПулов» — одна выборка на промахе, сколько
// бы пулов ни было названо.
//
// Параметры:
//  ПулИдентификаторы - Строка - идентификаторы пулов через запятую по возрастанию, без
//                      повторов: строка и есть ключ кэша.
//
// Возвращаемое значение:
//  ФиксированныйМассив из ФиксированнаяСтруктура - снимки пакетов названных пулов.
//
&Кэшируемый("пакетыПулов")
Функция СнимкиПулов(Знач ПулИдентификаторы) Экспорт

	Идентификаторы = Новый Массив();
	Для Каждого Идентификатор Из СтрРазделить(ПулИдентификаторы, ",", Ложь) Цикл
		Идентификаторы.Добавить(Число(Идентификатор));
	КонецЦикла;

	Возврат Форма().Снимки(ПакетыПулов(Идентификаторы));

КонецФункции

// Снимок пакета пула по каноническому имени из кэша «пакеты»: поля пакета, только для чтения.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  ИмяНижнийРегистр - Строка - имя пакета в нижнем регистре.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - снимок пакета.
//
&Кэшируемый("пакеты")
Функция СнимокПоИмени(Знач ПулИдентификатор, Знач ИмяНижнийРегистр) Экспорт
	Возврат Форма().Снимок(
		Сам.Достать().ПолучитьОдноПоПулИдентификаторРавноИИмяНижнийРегистрРавно(ПулИдентификатор, ИмяНижнийРегистр));
КонецФункции

// Забывает снимок пакета по имени: зовёт каждый, кто записал или удалил строку пакета.
// Заведённому пакету забывать нечего — отсутствие пакета кэш не держит.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  ИмяНижнийРегистр - Строка - имя пакета в нижнем регистре.
//
&СбрасываетКэш("пакеты")
Процедура ЗабытьСнимокПоИмени(Знач ПулИдентификатор, Знач ИмяНижнийРегистр) Экспорт
КонецПроцедуры

// Забывает пакеты пула и снимки всех наборов пулов: зовёт каждый, кто завёл, записал
// или удалил пакет пула. Наборы пулов забываются целиком — ключ набора по пулу не найти.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
&СбрасываетКэш("пакетыПула")
&СбрасываетКэш(Значение = "пакетыПулов", ВсеЗаписи = Истина)
Процедура ЗабытьСнимкиПула(Знач ПулИдентификатор) Экспорт
КонецПроцедуры

// Пакеты перечисленных пулов — один запрос на весь список там, где выдача ограничена
// частью пулов хаба, а не всей таблицей.
//
// Параметры:
//  ПулИдентификаторы - Массив из Число - идентификаторы пулов.
//
// Возвращаемое значение:
//  Массив из Пакет - пакеты названных пулов.
//
Функция ПакетыПулов(Знач ПулИдентификаторы) Экспорт

	Если ПулИдентификаторы.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Возврат Сам.Достать().ПолучитьПоПулИдентификаторВ(ЦелыеИдентификаторы(ПулИдентификаторы));

КонецФункции

// Сколько пакетов в пуле, включая скрытые, — столько же, сколько отдаёт выборка пула.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоВПуле(Знач ПулИдентификатор) Экспорт

	Возврат Агрегаты.Количество(Сам.Достать(), Новый ОпцииПоиска()
		.Отбор("ПулИдентификатор", ВидСравнения.Равно, Цел(ПулИдентификатор)));

КонецФункции

// Сколько нескрытых пакетов лежит в названных пулах. Пустой список пулов — ноль.
//
// Параметры:
//  ПулИдентификаторы - Массив из Число - идентификаторы пулов.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоВидимыхВПулах(Знач ПулИдентификаторы) Экспорт

	Возврат Агрегаты.Количество(Сам.Достать(), Новый ОпцииПоиска()
		.Отбор("ПулИдентификатор", ВидСравнения.В, ЦелыеИдентификаторы(ПулИдентификаторы))
		.Отбор("Скрыт", ВидСравнения.Равно, Ложь));

КонецФункции

// Пакет пула по имени в любом регистре (канонизация внутри).
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Имя - Строка - имя пакета в любом регистре.
//
// Возвращаемое значение:
//  Пакет, Неопределено - найденный пакет.
//
Функция НайтиПоИмени(Знач ПулИдентификатор, Знач Имя) Экспорт

	Возврат Сам.Достать().ПолучитьОдноПоПулИдентификаторРавноИИмяНижнийРегистрРавно(
		ПулИдентификатор, НРег(Имя));

КонецФункции

// Пакеты пула по списку имён — один разрез там, где имён сразу горсть: вопрос на каждое
// имя превращает обход зеркала в запрос на элемент.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Имена - Массив из Строка - имена пакетов в любом регистре.
//
// Возвращаемое значение:
//  Массив из Пакет - найденные пакеты; отсутствующих в выдаче нет.
//
Функция НайтиПоИменам(Знач ПулИдентификатор, Знач Имена) Экспорт

	Канонические = Новый Массив();
	Учтённые = Новый Соответствие();
	Для Каждого Имя Из Имена Цикл
		Канон = НРег(СокрЛП(Строка(Имя)));
		Если ПустаяСтрока(Канон) ИЛИ Учтённые.Получить(Канон) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Учтённые.Вставить(Канон, Истина);
		Канонические.Добавить(Канон);
	КонецЦикла;

	Если Канонические.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Результат = Сам.Достать().ПолучитьПоПулИдентификаторРавноИИмяНижнийРегистрВ(
		ПулИдентификатор, Канонические);
	Возврат ?(Результат = Неопределено, Новый Массив(), Результат);

КонецФункции

// Все пакеты хаба; порядок не гарантируется — сортировку и пагинацию делает вызывающий.
//
// Возвращаемое значение:
//  Массив из Пакет - все пакеты хаба.
//
Функция Все() Экспорт
	Возврат Сам.Достать().ПолучитьПо();
КонецФункции

Функция ЦелыеИдентификаторы(Знач Идентификаторы)

	Целые = Новый Массив();
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Целые.Добавить(Цел(Идентификатор));
	КонецЦикла;

	Возврат Целые;

КонецФункции

// Модель сущности есть только у собранного репозитория, поэтому форма снимка строится при первом снимке.
Функция Форма()
	Если ФормаСнимка = Неопределено Тогда
		ФормаСнимка = Новый ФормаСнимка(Сам.Достать().ПолучитьОбъектМодели());
	КонецЕсли;
	Возврат ФормаСнимка;
КонецФункции

&ХранилищеСущностей("Пакет")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеПакетов") _Сам,
	&Пластилин(Значение = "АгрегатыБазы") _Агрегаты)

	Сам = _Сам;
	Агрегаты = _Агрегаты;

КонецПроцедуры
