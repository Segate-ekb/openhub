// Обход всех пакетов: у каждого — описание той версии, которую отдаёт установка без тега
// и версии, на диске, а без README в пакете — из репозитория. Показ читает тот же диск,
// обход лишь опережает читателя.

Перем СервисПулов;   // СервисПулов
Перем СервисПакетов; // СервисПакетов
Перем Резолвер;      // РезолверСпецификации — версия установки без спецификации
Перем Служба;        // СлужбаREADME (описания)
Перем Дополнение;    // ДополнениеОписаний — README из репозитория, необязательно
Перем Ошибки;        // ТекстОшибки (основа)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Обходит пакеты хаба и обеспечивает на диске описание версии, которую каждый из них
// отдаёт по умолчанию; версии без README в пакете дополняет README из репозитория.
// Сбой на отдельном пакете обход не роняет — пакет попадает в «пропущено».
//
// Возвращаемое значение:
//  Структура - Обработано (Число — описание версии по умолчанию лежит на диске),
//              Пропущено (Число — пакет без пула, без версии по умолчанию либо с недоступным
//              артефактом).
//
Функция Актуализировать() Экспорт

	Сводка = Новый Структура("Обработано, Пропущено", 0, 0);

	Пакеты = СервисПакетов.ВсеПакеты();
	Пулы = СервисПулов.ПулыПакетов(Пакеты);

	Для Каждого Пакет Из Пакеты Цикл

		Попытка
			Обеспечено = ОписаниеОбеспечено(Пакет, Пулы.Получить(Цел(Пакет.ПулИдентификатор)));
		Исключение
			// сбой пакета не срывает обход, но пишется: иначе отказ хранилища сошёл бы за успех
			Лог.Ошибка("Актуализация описаний пакета ""%1"" прервана ошибкой: %2",
				Пакет.Имя, Ошибки.Причина(ИнформацияОбОшибке()));
			Обеспечено = Ложь;
		КонецПопытки;

		Если Обеспечено Тогда
			Сводка.Обработано = Сводка.Обработано + 1;
		Иначе
			Сводка.Пропущено = Сводка.Пропущено + 1;
		КонецЕсли;

	КонецЦикла;

	Лог.Отладка("Актуализация описаний завершена: обработано %1, пропущено %2",
		Сводка.Обработано, Сводка.Пропущено);

	Возврат Сводка;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ложь — обеспечить не удалось: пул пропал, канал пуст либо артефакт недоступен; это ожидаемо.
Функция ОписаниеОбеспечено(Знач Пакет, Знач Пул)

	Если Пул = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Версия = Резолвер.ВерсияПоУмолчанию(Пакет);
	Обеспечено = Служба.ОбеспечитьОписаниеНаДиске(Пул, Пакет, Версия);
	Если Обеспечено И Дополнение <> Неопределено Тогда
		Дополнение.Дополнить(Пул, Пакет, Версия);
	КонецЕсли;

	Возврат Обеспечено;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "РезолверСпецификации") _Резолвер,
	&Пластилин(Значение = "СлужбаREADME") _Служба,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Пластилин(Значение = "ДополнениеОписаний", Тип = "Массив") _Дополнение = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Дополнение = Новый ВнедрённыеЖелуди().ПервыйИз(_Дополнение);
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	Резолвер = _Резолвер;
	Служба = _Служба;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
