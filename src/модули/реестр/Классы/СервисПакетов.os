// Доменные операции над пакетами: регистрация с валидацией имени, поиск и листинги.
// Имя хранится в регистре первой публикации плюс канонический ключ; поиск регистронезависим.

Перем ХранилищеПакетов;  // ХранилищеПакетов (данные)
Перем ХранилищеПулов;    // ХранилищеПулов (данные)
Перем Правила;           // ПравилаИменования

// Регистрирует новый пакет в пуле. Дубль имени в любом регистре и неизвестный пул —
// исключение.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор существующего пула.
//  Имя - Строка - имя пакета, регистр сохраняется.
//  Свойства - Структура, Неопределено - поля Описание, КлючевыеСлова, АдресРепозитория,
//             Лицензия (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Пакет - созданный пакет.
//
Функция ЗарегистрироватьПакет(Знач ПулИдентификатор, &АтрибутСпана("oshub.package") Знач Имя,
	Знач Свойства = Неопределено) Экспорт

	КаноническоеИмя = Правила.Канонизировать(Имя);

	Если ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(ПулИдентификатор) = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Пул с идентификатором %1 не найден", ПулИдентификатор);
	КонецЕсли;

	Существующий = ХранилищеПакетов.ПолучитьОдноПоПулИдентификаторРавноИИмяНижнийРегистрРавно(
		ПулИдентификатор, КаноническоеИмя);
	Если Существующий <> Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"Пакет ""%1"" уже существует в пуле (имена сравниваются без учёта регистра: занято имя ""%2"")",
			Имя, Существующий.Имя);
	КонецЕсли;

	Пакет = ХранилищеПакетов.СоздатьЭлемент();
	Пакет.ПулИдентификатор = ПулИдентификатор;
	Пакет.Имя = СокрЛП(Имя);
	Пакет.ИмяНижнийРегистр = КаноническоеИмя;
	Пакет.Описание = ЗначениеСвойства(Свойства, "Описание");
	Пакет.КлючевыеСлова = ЗначениеСвойства(Свойства, "КлючевыеСлова");
	// недоверенное поле манифеста: опасные схемы обнуляются при приёме — вторая линия
	// защиты от stored XSS поверх фильтрации схемы при выводе
	Пакет.АдресРепозитория = БезопасныйАдресРепозитория(ЗначениеСвойства(Свойства, "АдресРепозитория"));
	Пакет.Лицензия = ЗначениеСвойства(Свойства, "Лицензия");
	Пакет.Устарел = Ложь;
	Пакет.Скрыт = Ложь;
	Пакет.Создан = ТекущаяУниверсальнаяДата();
	Пакет.Сохранить();
	ХранилищеПакетов.ЗабытьПакет(Цел(Пакет.Идентификатор));

	Возврат Пакет;

КонецФункции

// Ищет пакет, а если его нет — регистрирует. У существующего пакета сохраняется
// регистр имени первой публикации.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор существующего пула.
//  Имя - Строка - имя пакета в любом регистре.
//
// Возвращаемое значение:
//  Пакет - найденный или созданный пакет.
//
Функция НайтиИлиЗарегистрировать(Знач ПулИдентификатор,
	&АтрибутСпана("oshub.package") Знач Имя) Экспорт

	Пакет = НайтиПакет(ПулИдентификатор, Имя);
	Если Пакет <> Неопределено Тогда
		Возврат Пакет;
	КонецЕсли;
	Возврат ЗарегистрироватьПакет(ПулИдентификатор, Имя);

КонецФункции

// Ищет пакет по имени; регистр не значим.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Имя - Строка - имя пакета в любом регистре.
//
// Возвращаемое значение:
//  Пакет, Неопределено - найденный пакет.
//
Функция НайтиПакет(Знач ПулИдентификатор, &АтрибутСпана("oshub.package") Знач Имя) Экспорт
	Возврат ХранилищеПакетов.НайтиПоИмени(ПулИдентификатор, СокрЛП(Имя));
КонецФункции

// Возвращает пакет по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Пакет, Неопределено - найденный пакет.
//
Функция ПакетПоИдентификатору(Знач Идентификатор) Экспорт
	Возврат ХранилищеПакетов.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Возвращает пакеты перечисленных идентификаторов одним разрезом — там, где адресов
// сразу горстка и вопрос на каждый превратил бы страницу в N+1.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Массив из Пакет - найденные пакеты; отсутствующих в выдаче нет.
//
Функция ПакетыПоИдентификаторам(Знач Идентификаторы) Экспорт
	Возврат ХранилищеПакетов.ПакетыПоИдентификаторам(Идентификаторы);
КонецФункции

// Возвращает пакеты пула по списку имён одним разрезом — там, где имён сразу горсть.
// Регистр не значим.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Имена - Массив из Строка - имена пакетов в любом регистре.
//
// Возвращаемое значение:
//  Массив из Пакет - найденные пакеты; отсутствующих в выдаче нет.
//
Функция ПакетыПоИменам(Знач ПулИдентификатор, Знач Имена) Экспорт
	Возврат ХранилищеПакетов.НайтиПоИменам(ПулИдентификатор, Имена);
КонецФункции

// Возвращает все пакеты пула, включая скрытые: фильтрация видимости — забота
// вызывающего слоя.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из Пакет - пакеты пула.
//
Функция ПакетыПула(&АтрибутСпана("oshub.pool.id") Знач ПулИдентификатор) Экспорт
	Возврат ХранилищеПакетов.ПолучитьПоПулИдентификаторРавно(ПулИдентификатор);
КонецФункции

// Пакеты пула для чтения — витрина и list.txt: снимки из кэша, сохранить их нельзя.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из Пакет - снимки пакетов пула.
//
Функция ПакетыПулаДляЧтения(Знач ПулИдентификатор) Экспорт

	Пакеты = Новый Массив();
	Для Каждого Снимок Из ХранилищеПакетов.СнимкиПула(Цел(ПулИдентификатор)) Цикл
		Пакеты.Добавить(ПакетИзСнимка(Снимок));
	КонецЦикла;

	Возврат Пакеты;

КонецФункции

// Пакеты перечисленных пулов для чтения — главная, каталог, поиск: снимки из кэша по пулам.
//
// Параметры:
//  ПулИдентификаторы - Массив из Число - идентификаторы пулов.
//
// Возвращаемое значение:
//  Массив из Пакет - снимки пакетов названных пулов.
//
Функция ПакетыПуловДляЧтения(Знач ПулИдентификаторы) Экспорт

	Пакеты = Новый Массив();
	Для Каждого ПулИдентификатор Из ПулИдентификаторы Цикл
		Для Каждого Пакет Из ПакетыПулаДляЧтения(ПулИдентификатор) Цикл
			Пакеты.Добавить(Пакет);
		КонецЦикла;
	КонецЦикла;

	Возврат Пакеты;

КонецФункции

// Забывает всё, что кэш помнит о пакете и о витрине: зовут те, кто удаляет пакет мимо
// этой службы.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
Процедура ЗабытьПакет(Знач ПакетИдентификатор) Экспорт
	ХранилищеПакетов.ЗабытьПакет(Цел(ПакетИдентификатор));
КонецПроцедуры

// Возвращает, сколько пакетов лежит в пуле — для экранов, которым нужно число, а не список.
// Скрытые считаются: столько же, сколько отдаёт ПакетыПула.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоПакетовПула(&АтрибутСпана("oshub.pool.id") Знач ПулИдентификатор) Экспорт
	Возврат ХранилищеПакетов.КоличествоВПуле(Цел(ПулИдентификатор));
КонецФункции

// Возвращает, сколько нескрытых пакетов лежит в названных пулах, — одним счётом вместо
// обхода пулов.
//
// Параметры:
//  ПулИдентификаторы - Массив из Число - идентификаторы пулов.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоВидимыхПакетовПулов(Знач ПулИдентификаторы) Экспорт
	Возврат ХранилищеПакетов.КоличествоВидимыхВПулах(ПулИдентификаторы);
КонецФункции

// Возвращает пакеты перечисленных пулов одним разрезом: выдача, которой видна часть
// хаба, читает эту часть, а не всю таблицу. Порядок не гарантируется, скрытые пакеты
// в разрез входят — фильтрует вызывающий слой.
//
// Параметры:
//  ПулИдентификаторы - Массив из Число - идентификаторы пулов.
//
// Возвращаемое значение:
//  Массив из Пакет - пакеты названных пулов.
//
Функция ПакетыПулов(Знач ПулИдентификаторы) Экспорт
	Возврат ХранилищеПакетов.ПакетыПулов(ПулИдентификаторы);
КонецФункции

// Возвращает одноимённые пакеты всех пулов — там, где пул ещё не назван. Имя уникально
// в разрезе пула, поэтому ответом может быть несколько пакетов; какой из них показать,
// решает вызывающий по правам читателя.
//
// Параметры:
//  Имя - Строка - имя пакета в любом регистре.
//
// Возвращаемое значение:
//  Массив из Пакет - пакеты этого имени; порядок не гарантируется.
//
Функция ОдноимённыеПакеты(Знач Имя) Экспорт
	Возврат ХранилищеПакетов.ОдноимённыеВоВсехПулах(Имя);
КонецФункции

// Возвращает все пакеты хаба. Порядок не гарантируется; фильтрацию видимости
// и сортировку делает вызывающий слой.
//
// Возвращаемое значение:
//  Массив из Пакет - все пакеты.
//
Функция ВсеПакеты() Экспорт
	Возврат ХранилищеПакетов.Все();
КонецФункции

// Обновляет редактируемые метаданные пакета частично: меняются только переданные поля.
// АдресРепозитория как недоверенное поле обнуляется при опасной схеме. Отсутствующий
// пакет — исключение.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор существующего пакета.
//  Свойства - Структура, Неопределено - поля Описание, КлючевыеСлова, АдресРепозитория,
//             Лицензия (Строки), Устарел, Скрыт (Булево).
//
// Возвращаемое значение:
//  Пакет - обновлённый пакет.
//
Функция ОбновитьМетаданные(Знач ПакетИдентификатор, Знач Свойства) Экспорт

	Пакет = ХранилищеПакетов.ПолучитьОдноПоИдентификаторРавно(ПакетИдентификатор);
	Если Пакет = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Пакет с идентификатором %1 не найден", ПакетИдентификатор);
	КонецЕсли;
	Если Свойства = Неопределено Тогда
		Возврат Пакет;
	КонецЕсли;

	Значение = Неопределено;
	Если Свойства.Свойство("Описание", Значение) Тогда
		Пакет.Описание = ?(Значение = Неопределено, "", Строка(Значение));
	КонецЕсли;
	Если Свойства.Свойство("КлючевыеСлова", Значение) Тогда
		Пакет.КлючевыеСлова = ?(Значение = Неопределено, "", Строка(Значение));
	КонецЕсли;
	Если Свойства.Свойство("Лицензия", Значение) Тогда
		Пакет.Лицензия = ?(Значение = Неопределено, "", Строка(Значение));
	КонецЕсли;
	Если Свойства.Свойство("АдресРепозитория", Значение) Тогда
		Пакет.АдресРепозитория = БезопасныйАдресРепозитория(?(Значение = Неопределено, "", Строка(Значение)));
	КонецЕсли;
	Если Свойства.Свойство("Устарел", Значение) Тогда
		Пакет.Устарел = (Значение = Истина);
	КонецЕсли;
	Если Свойства.Свойство("Скрыт", Значение) Тогда
		Пакет.Скрыт = (Значение = Истина);
	КонецЕсли;

	Пакет.Сохранить();
	ХранилищеПакетов.ЗабытьПакет(Цел(Пакет.Идентификатор));
	Возврат Пакет;

КонецФункции

// Переносит в карточку пакета поля манифеста: манифест — источник истины для описания
// и адреса репозитория, поэтому они обновляются при каждой публикации. Пустое поле
// манифеста заполненное значение карточки не затирает; небезопасный адрес репозитория
// не применяется. Полей, которых в манифесте нет (лицензия, ключевые слова), и
// операторских флагов (скрыт, устарел) метод не касается.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор существующего пакета.
//  Свойства - Структура, Неопределено - поля Описание, АдресРепозитория (Строки).
//
// Возвращаемое значение:
//  Пакет - обновлённый пакет.
//
Функция ПринятьМетаданныеМанифеста(Знач ПакетИдентификатор, Знач Свойства) Экспорт

	Заполненные = Новый Структура();

	Описание = СокрЛП(Строка(ЗначениеСвойства(Свойства, "Описание")));
	Если ЗначениеЗаполнено(Описание) Тогда
		Заполненные.Вставить("Описание", Описание);
	КонецЕсли;

	// небезопасный адрес не применяется вовсе: обнулением он стёр бы адрес карточки,
	// выставленный руками
	Адрес = СокрЛП(Строка(ЗначениеСвойства(Свойства, "АдресРепозитория")));
	Если ЗначениеЗаполнено(Адрес) И Правила.АдресРепозиторияБезопасен(Адрес) Тогда
		Заполненные.Вставить("АдресРепозитория", Адрес);
	КонецЕсли;

	Возврат ОбновитьМетаданные(ПакетИдентификатор, Заполненные);

КонецФункции

Функция БезопасныйАдресРепозитория(Знач Значение)
	Возврат ?(Правила.АдресРепозиторияБезопасен(Значение), Значение, "");
КонецФункции

Функция ЗначениеСвойства(Знач Свойства, Знач ИмяСвойства)

	Значение = "";
	Если Свойства <> Неопределено Тогда
		Свойства.Свойство(ИмяСвойства, Значение);
		Если Значение = Неопределено Тогда
			Значение = "";
		КонецЕсли;
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Отдельный объект на каждое чтение: кэш держит неизменяемый снимок. Записи у объекта нет.
Функция ПакетИзСнимка(Знач Снимок)

	Пакет = Новый Пакет();
	ЗаполнитьЗначенияСвойств(Пакет, Снимок);
	Возврат Пакет;

КонецФункции

&Желудь
&Наблюдаемый
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПакетов") _ХранилищеПакетов,
	&Пластилин(Значение = "ХранилищеПулов") _ХранилищеПулов,
	&Пластилин(Значение = "ПравилаИменования") _Правила)

	ХранилищеПакетов = _ХранилищеПакетов;
	ХранилищеПулов = _ХранилищеПулов;
	Правила = _Правила;

КонецПроцедуры
