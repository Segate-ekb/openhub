// Словарь — единственный владелец значений колонки Тег.ТипПравила. Без состояния.

#Область ПубличныйИнтерфейс

// Возвращает тип правила «semver».
//
// Возвращаемое значение:
//  Строка - имя типа.
//
Функция Semver() Экспорт
	Возврат "semver";
КонецФункции

// Возвращает тип правила «regex».
//
// Возвращаемое значение:
//  Строка - имя типа.
//
Функция Regex() Экспорт
	Возврат "regex";
КонецФункции

// Возвращает все допустимые типы правил.
//
// Возвращаемое значение:
//  Массив из Строка - типы правил.
//
Функция Все() Экспорт
	Результат = Новый Массив();
	Результат.Добавить(Semver());
	Результат.Добавить(Regex());
	Возврат Результат;
КонецФункции

// Нормализует тип правила для записи; недопустимое значение — исключение.
//
// Параметры:
//  Значение - Строка - сырое значение из формы, тела запроса или строки БД.
//
// Возвращаемое значение:
//  Строка - нормализованный тип.
//
Функция Нормализовать(Знач Значение) Экспорт

	Норм = НРег(СокрЛП(Строка(Значение)));

	Если Норм = Semver() ИЛИ Норм = Regex() Тогда
		Возврат Норм;
	КонецЕсли;

	Если Норм = "label" Тогда
		ВызватьИсключение
			"Тип правила тега ""label"" упразднён (6.H): правило тега отбирает версии"
			+ " по строке версии (semver или regex); метка версии осталась атрибутом"
			+ " версии и в правилах тегов больше не участвует";
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Некорректный тип правила тега ""%1"": ожидается semver или regex", Строка(Значение));

КонецФункции

// Приводит тип правила к допустимому для отображения: неизвестное значение сводится
// к semver, чтобы подделанный query-параметр дал форму по умолчанию, а не белый экран.
// Запись всё равно проходит через Нормализовать.
//
// Параметры:
//  Значение - Строка - сырое значение.
//
// Возвращаемое значение:
//  Строка - semver или regex.
//
Функция ДляПоказа(Знач Значение) Экспорт
	Возврат ?(НРег(СокрЛП(Строка(Значение))) = Regex(), Regex(), Semver());
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
