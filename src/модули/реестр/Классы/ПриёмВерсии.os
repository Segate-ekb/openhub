// Раскладка принятой версии в реестр — одна и та же для публикации здесь и для приёма
// из внешнего источника; источникоспецифичное остаётся у вызывающего.

Перем СервисПакетов;       // СервисПакетов
Перем СервисВерсий;        // СервисВерсий
Перем СервисЗависимостей;  // СервисЗависимостей
Перем СервисТегов;         // СервисТегов
Перем Каналы;              // КаналыПоУмолчанию — каналы новому пакету, если пул это разрешил
Перем Зависимости;         // ЗависимостиМанифеста
Перем ХранилищеОписаний;   // ХранилищеREADME (описания) — необязательно
Перем Занятое;             // ЗаписьЗанятогоМеста
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Принимает версию, опубликованную в этом хабе: версия становится собственной, повторная
// публикация той же строки заменяет запись только с флагом перезаписи — его ставит дверь,
// уже спросившая ПричинаОтказаПубликации. Номер, который пакет уже понимает как имя
// тега, — исключение.
//
// Параметры:
//  Пул - Пул - пул, в который принята версия.
//  ИмяПакета - Строка - имя пакета; у существующего пакета регистр первой публикации
//              сохраняется.
//  ВерсияСтрока - Строка - строка версии.
//  Манифест - МанифестПакета - манифест принятого артефакта.
//  Артефакт - Структура - Размер (Число), Sha256 (Строка) сохранённого файла.
//  ПубликаторИдентификатор - Число - учётка публикатора, 0 — без учётки (необязательный,
//                            по умолчанию 0).
//  РазрешитьПерезапись - Булево - Истина: обновить существующую запись версии
//                        (необязательный, по умолчанию Ложь).
//  ДовереннаяПубликация - Булево - принято доверенным конвейером (необязательный,
//                         по умолчанию Ложь).
//  ТекстREADME - Строка, Неопределено - README принятого пакета; "" — README в пакете нет,
//                Неопределено — вызывающий пакет не читал (необязательный, по умолчанию
//                Неопределено).
//
// Возвращаемое значение:
//  Структура - Пакет (Пакет), Версия (ВерсияПакета).
//
Функция ПринятьПубликацию(Знач Пул, Знач ИмяПакета, Знач ВерсияСтрока, Знач Манифест,
	Знач Артефакт, Знач ПубликаторИдентификатор = 0, Знач РазрешитьПерезапись = Ложь,
	Знач ДовереннаяПубликация = Ложь, Знач ТекстREADME = Неопределено) Экспорт

	// без Перем присваивание уйдёт в ПОЛЕ объекта, общее на процесс
	Перем Пакет;
	Перем Заявка;
	Перем Версия;

	Пакет = СервисПакетов.НайтиИлиЗарегистрировать(Пул.Идентификатор, ИмяПакета);
	ОтклонитьНомерЗанятыйТегом(Пакет, ВерсияСтрока);

	Заявка = ЗаявкаНаВерсию(Пакет, Пул, ИмяПакета, ВерсияСтрока, Манифест, Артефакт);
	Заявка.ОпубликовалИдентификатор = ПубликаторИдентификатор;
	Заявка.ДовереннаяПубликация = (ДовереннаяПубликация = Истина);

	Версия = СервисВерсий.Опубликовать(Заявка, РазрешитьПерезапись);
	РазложитьВРеестр(Пакет, Версия, Манифест);
	ЗапомнитьОписание(Пул, ИмяПакета, ВерсияСтрока, ТекстREADME);

	Лог.Отладка("Приём публикации: ""%1"" %2 в пул ""%3"" — пакет #%4, версия #%5",
		ИмяПакета, ВерсияСтрока, Пул.Имя, Пакет.Идентификатор, Версия.Идентификатор);

	Возврат Принятое(Пакет, Версия);

КонецФункции

// Принимает версию, привезённую из внешнего источника (зеркало, прокси): версия
// индексируется с происхождением «апстрим», и здесь же спрашивается настройка пула
// «заводить каналы по умолчанию» — события публикации на этом пути нет.
// Номер, который пакет уже понимает как имя тега, — исключение: привезённая версия
// в реестр не попадает, и вызывающий изолирует отказ так же, как любой сбой этого пакета.
// Идемпотентна: уже проиндексированная версия возвращается как есть, а состав зависимостей
// заменяется целиком — повторный приём дублей не оставляет. Состав получает та версия,
// которую принимают: вызывающий, пропускающий приём для уже проиндексированной версии
// (так делает зеркало), её состав и не обновит. Манифест = Неопределено прежний состав
// и карточку не трогает: нечитаемый артефакт — не повод забыть уже известное.
//
// Параметры:
//  Пул - Пул - пул, в который принята версия.
//  ИмяПакета - Строка - имя пакета; берётся из адреса апстрима, а не из манифеста.
//  ВерсияСтрока - Строка - строка версии.
//  Манифест - МанифестПакета, Неопределено - манифест артефакта; Неопределено — манифест
//             недоступен.
//  Артефакт - Структура - Размер (Число), Sha256 (Строка) сохранённого файла.
//  АпстримИдентификатор - Число - апстрим-источник (необязательный, по умолчанию 0 —
//                         неизвестен).
//  ТекстREADME - Строка, Неопределено - README привезённого пакета; "" — README в пакете
//                нет, Неопределено — вызывающий пакет не читал (необязательный,
//                по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - Пакет (Пакет), Версия (ВерсияПакета).
//
Функция ПринятьВнешнюю(Знач Пул, Знач ИмяПакета, Знач ВерсияСтрока, Знач Манифест,
	Знач Артефакт, Знач АпстримИдентификатор = 0, Знач ТекстREADME = Неопределено) Экспорт

	Перем Пакет;
	Перем Заявка;
	Перем Версия;

	Пакет = СервисПакетов.НайтиИлиЗарегистрировать(Пул.Идентификатор, ИмяПакета);
	ОтклонитьНомерЗанятыйТегом(Пакет, ВерсияСтрока);

	Заявка = ЗаявкаНаВерсию(Пакет, Пул, ИмяПакета, ВерсияСтрока, Манифест, Артефакт);

	Версия = СервисВерсий.ИндексироватьВнешнюю(Заявка, АпстримИдентификатор);
	РазложитьВРеестр(Пакет, Версия, Манифест);
	ЗапомнитьОписание(Пул, ИмяПакета, ВерсияСтрока, ТекстREADME);
	// события «версия опубликована» на привезённую версию нет, и подписчик каналов
	// не срабатывает — на этом пути настройку пула спрашивает приём
	Каналы.ЗавестиЕслиРазрешилПул(Пакет.Идентификатор);

	Лог.Отладка("Приём внешней версии: ""%1"" %2 в пул ""%3"" с апстрима #%4 — пакет #%5,"
		+ " версия #%6, манифест %7",
		ИмяПакета, ВерсияСтрока, Пул.Имя, АпстримИдентификатор, Пакет.Идентификатор,
		Версия.Идентификатор, ?(Манифест = Неопределено, "недоступен", "разобран"));

	Возврат Принятое(Пакет, Версия);

КонецФункции

// Почему эта версия не будет опубликована, если спросить сейчас; Неопределено — препятствий
// нет. Вопрос двери публикации: она умеет ответить кодом, поэтому спрашивает заранее и потому
// отличает отказ по правилу от поломки хаба. Зеркалу и прокси, отвечать кодом не умеющим,
// достаётся исключение приёма.
//
// Правила здесь РАЗНОЙ природы, и различие намеренное:
//  * строка версии судится ПУБЛИКАЦИОННЫМИ правилами (разбор, ведущие нули, длина) —
//    приём внешней версии к ним снисходителен намеренно: чем версионирует свои артефакты
//    апстрим, не наше решение;
//  * столкновение номера с именем тега — правило ОБЩЕЕ, его держат обе двери ядра;
//  * запрет повторной публикации номера — правило ЭТОЙ двери: зеркало версию не
//    перезаписывает вовсе, и спрашивать ему нечего.
//
// Параметры:
//  Пул - Пул - пул, в который публикуют версию.
//  ИмяПакета - Строка - имя пакета.
//  ВерсияСтрока - Строка - строка версии.
//  Форсировать - Булево - публикация просит замену номера: снимается ТОЛЬКО запрет повторной
//                публикации; негодная строка версии и столкновение с именем тега остаются
//                отказом (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура, Неопределено - Код (Число: 400 — ввод не годится, 409 — номер уже принят),
//                            Сообщение (Строка); Неопределено — версия принимается.
//
Функция ПричинаОтказаПубликации(Знач Пул, Знач ИмяПакета, Знач ВерсияСтрока,
	Знач Форсировать = Ложь) Экспорт

	// порядок ветвей — часть контракта: форс стоит ПОСЛЕ правил ввода, и обойти он их
	// не может ни при каком значении
	Причина = СервисВерсий.ПричинаОтказаСтроки(ВерсияСтрока);
	Если ЗначениеЗаполнено(Причина) Тогда
		Возврат Отказ(400, Причина);
	КонецЕсли;

	Пакет = СервисПакетов.НайтиПакет(Пул.Идентификатор, ИмяПакета);

	Причина = ПричинаСтолкновенияСТегом(Пакет, ВерсияСтрока);
	Если ЗначениеЗаполнено(Причина) Тогда
		Возврат Отказ(400, Причина);
	КонецЕсли;

	Если Форсировать Тогда
		Возврат Неопределено;
	КонецЕсли;

	Причина = ПричинаОтказаПовторнойПубликации(Пакет, ИмяПакета, ВерсияСтрока);
	Если ЗначениеЗаполнено(Причина) Тогда
		Возврат Отказ(409, Причина);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОтклонитьНомерЗанятыйТегом(Знач Пакет, Знач ВерсияСтрока)

	Причина = ПричинаСтолкновенияСТегом(Пакет, ВерсияСтрока);
	Если ЗначениеЗаполнено(Причина) Тогда
		ВызватьИсключение Причина;
	КонецЕсли;

КонецПроцедуры

// Принятая под именем тега версия навсегда затенила бы его; запрет держит появление номера.
Функция ПричинаСтолкновенияСТегом(Знач Пакет, Знач ВерсияСтрока)

	Если Пакет = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если СервисВерсий.НайтиВерсию(Пакет.Идентификатор, ВерсияСтрока) <> Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если НЕ СервисТегов.ТегИзвестен(Пакет, ВерсияСтрока) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(
		"Версия ""%1"" не принята: пакет ""%2"" уже понимает строку ""%1"" как имя тега."
		+ " Резолв читает спецификацию сначала точной версией, и такая версия навсегда"
		+ " затенила бы одноимённый тег. Переименуйте тег либо примите версию под другим номером",
		СокрЛП(Строка(ВерсияСтрока)), Пакет.Имя);

КонецФункции

// Номер переиздаётся только с разрешения ВСЕХ тегов, под которые попал: один запрет — и он неизменяем.
Функция ПричинаОтказаПовторнойПубликации(Знач Пакет, Знач ИмяПакета, Знач ВерсияСтрока)

	Запрет = СервисТегов.ЗапретПерезаписи(Пакет, ВерсияСтрока);
	Если НЕ Запрет.Запрещён Тогда
		Возврат "";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Запрет.ИмяТега) Тогда
		Возврат СтрШаблон(
			"Версия %1 пакета %2 уже опубликована, а под теги пакета этот номер не попадает —"
			+ " снимать запрет не с чего. Заменить номер можно только явно: %3."
			+ " CHANNEL на это не влияет",
			СокрЛП(Строка(ВерсияСтрока)), ИмяПакета, СпособЗамены());
	КонецЕсли;

	Возврат СтрШаблон(
		"Версия %1 пакета %2 уже опубликована, а тег ""%3"" запрещает публиковать номер"
		+ " повторно. Выходов два: заменить номер явно (%4) либо снять с тега ""%3"" запрет"
		+ " повторной публикации в настройках пакета. CHANNEL на это не влияет",
		СокрЛП(Строка(ВерсияСтрока)), ИмяПакета, Запрет.ИмяТега, СпособЗамены());

КонецФункции

// Совет обязан быть исполнимым сегодня: у выпущенного opm ключа --force ещё нет.
Функция СпособЗамены()
	Возврат "добавьте к адресу push параметр ?force=1, а в новых версиях клиента —"
		+ " opm push --force";
КонецФункции

Функция Отказ(Знач Код, Знач Сообщение)
	Возврат Новый Структура("Код, Сообщение", Код, Сообщение);
КонецФункции

// Всё, что манифест принятой версии добавляет к строке версии: карточка пакета и зависимости.
Процедура РазложитьВРеестр(Знач Пакет, Знач Версия, Знач Манифест)

	Если Манифест = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СервисПакетов.ПринятьМетаданныеМанифеста(Пакет.Идентификатор, КарточкаМанифеста(Манифест));
	СервисЗависимостей.ЗаписатьСостав(Версия.Идентификатор, Зависимости.Состав(Манифест));

КонецПроцедуры

// Пустой текст — такой же ответ («README в пакете нет») и запоминается наравне с непустым.
Процедура ЗапомнитьОписание(Знач Пул, Знач ИмяПакета, Знач ВерсияСтрока, Знач ТекстREADME)

	Если ХранилищеОписаний = Неопределено ИЛИ ТекстREADME = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Дельта = ХранилищеОписаний.Записать(Пул.Имя, ИмяПакета, ВерсияСтрока, ТекстREADME);
	// байты описания лежат в области пула и считаются наравне с артефактом:
	// счётчик ведёт тот, кто пишет файл
	Занятое.Учесть(Пул, Дельта, СтрШаблон("описание %1-%2", ИмяПакета, ВерсияСтрока));

КонецПроцедуры

// Лицензии и ключевых слов в формате .ospx нет — они остаются полями карточки.
Функция КарточкаМанифеста(Знач Манифест)
	Возврат Новый Структура("Описание, АдресРепозитория",
		Манифест.Описание(), Манифест.АдресРепозитория());
КонецФункции

// Имя пакета берётся то же, под каким записан файл, а не то, в каком регистре пакет завели.
Функция ЗаявкаНаВерсию(Знач Пакет, Знач Пул, Знач ИмяПакета, Знач ВерсияСтрока, Знач Манифест,
	Знач Артефакт)

	Перем Заявка;

	Заявка = Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, ВерсияСтрока);
	Заявка.Размер = Артефакт.Размер;
	Заявка.Sha256 = Артефакт.Sha256;
	Заявка.ВерсияДвижка = ?(Манифест = Неопределено, "", Манифест.ВерсияДвижка());
	Заявка.АвторМанифеста = ?(Манифест = Неопределено, "", Манифест.Автор());
	Заявка.ПутьВХранилище = СтрШаблон("pools/%1/%2/%2-%3.ospx", Пул.Имя, ИмяПакета, ВерсияСтрока);

	Возврат Заявка;

КонецФункции

Функция Принятое(Знач Пакет, Знач Версия)
	Возврат Новый Структура("Пакет, Версия", Пакет, Версия);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисЗависимостей") _СервисЗависимостей,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "КаналыПоУмолчанию") _Каналы,
	&Пластилин(Значение = "ЗависимостиМанифеста") _Зависимости,
	&Пластилин(Значение = "ЗаписьЗанятогоМеста") _Занятое,
	&Пластилин(Значение = "ХранилищеREADME", Тип = "Массив") _ХранилищеОписаний = Неопределено,
	&Лог _Лог = Неопределено)

	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;
	СервисЗависимостей = _СервисЗависимостей;
	СервисТегов = _СервисТегов;
	Каналы = _Каналы;
	Зависимости = _Зависимости;
	Занятое = _Занятое;
	// Массив — способ ОСени выразить необязательную зависимость: контейнер без модуля
	// описаний собирается, версия принимается, описание просто не ложится на диск.
	ХранилищеОписаний = ?(_ХранилищеОписаний = Неопределено ИЛИ _ХранилищеОписаний.Количество() = 0,
		Неопределено, _ХранилищеОписаний[0]);

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

