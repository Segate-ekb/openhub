// Метка версии — значение legacy-заголовка CHANNEL при push: независимый атрибут
// версии, на распространение он не влияет. Нормализация единая: НРег(СокрЛП).

Перем ХранилищеМеток; // ХранилищеМетокВерсий (данные)

#Область ПубличныйИнтерфейс

// Присваивает версии метку. Идемпотентно: повторное присвоение той же метки в любом
// регистре дубля не создаёт.
//
// Параметры:
//  ВерсияИдентификатор - Число - идентификатор версии.
//  Метка - Строка - значение метки, например "dev".
//
// Возвращаемое значение:
//  Булево - Истина, если метка создана; Ложь, если она пуста или уже была.
//
Функция ПрисвоитьМетку(Знач ВерсияИдентификатор, Знач Метка) Экспорт

	МеткаЗнач = Нормализовать(Метка);
	Если ПустаяСтрока(МеткаЗнач) Тогда
		Возврат Ложь;
	КонецЕсли;

	Существующая = ХранилищеМеток.ПолучитьОдноПоВерсияИдентификаторРавноИМеткаРавно(
		ВерсияИдентификатор, МеткаЗнач);
	Если Существующая <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Запись = ХранилищеМеток.СоздатьЭлемент();
	Запись.ВерсияИдентификатор = ВерсияИдентификатор;
	Запись.Метка = МеткаЗнач;
	Запись.Сохранить();
	Возврат Истина;

КонецФункции

// Возвращает метки версии.
//
// Параметры:
//  ВерсияИдентификатор - Число - идентификатор версии.
//
// Возвращаемое значение:
//  Массив из Строка - метки версии.
//
Функция МеткиВерсии(Знач ВерсияИдентификатор) Экспорт

	Метки = ХранилищеМеток.ПолучитьПоВерсияИдентификаторРавно(ВерсияИдентификатор);
	Результат = Новый Массив();
	Если Метки <> Неопределено Тогда
		Для Каждого М Из Метки Цикл
			Результат.Добавить(М.Метка);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Проверяет, помечена ли версия заданной меткой; сравнение по нормализованному значению.
//
// Параметры:
//  ВерсияИдентификатор - Число - идентификатор версии.
//  Метка - Строка - искомая метка.
//
// Возвращаемое значение:
//  Булево - Истина, если метка есть у версии.
//
Функция ВерсияИмеетМетку(Знач ВерсияИдентификатор, Знач Метка) Экспорт

	МеткаНорм = Нормализовать(Метка);
	Если ПустаяСтрока(МеткаНорм) Тогда
		Возврат Ложь;
	КонецЕсли;

	Метки = ХранилищеМеток.ПолучитьПоВерсияИдентификаторРавно(ВерсияИдентификатор);
	Если Метки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого М Из Метки Цикл
		Если Нормализовать(М.Метка) = МеткаНорм Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Нормализовать(Знач Метка)
	Возврат НРег(СокрЛП(Строка(Метка)));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ХранилищеМетокВерсий") _ХранилищеМеток)
	ХранилищеМеток = _ХранилищеМеток;
КонецПроцедуры
