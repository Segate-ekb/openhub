// Хранилище пулов — репозиторий сущности «Пул»: выборки идут деривацией, счёт и сумма —
// агрегатом базы, снимки для чтения — из кэша «пулы».

// BSLLS:UnusedParameters-off

#Использовать entity

Перем Сам;        // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё
Перем Агрегаты;   // АгрегатыБазы (данные) — счёт и сумма спрашиваются у базы
Перем ФормаСнимка; // ФормаСнимка (данные) — без занятого места: оно меняется на каждой публикации

// Пул по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Пул, Неопределено - найденный пул.
//
&МетодЗапроса
Функция ПолучитьОдноПоИдентификаторРавно(Идентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Пулы перечисленных идентификаторов — один запрос на весь список; идентификаторы
// сравниваются как есть.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пулов.
//
// Возвращаемое значение:
//  Массив из Пул - найденные пулы.
//
&МетодЗапроса
Функция ПолучитьПоИдентификаторВ(Идентификаторы) Экспорт
	Возврат Неопределено;
КонецФункции

// Пул по имени (имена пулов уникальны на хабе).
//
// Параметры:
//  Имя - Строка - имя пула.
//
// Возвращаемое значение:
//  Пул, Неопределено - найденный пул.
//
&МетодЗапроса
Функция ПолучитьОдноПоИмяРавно(Имя) Экспорт
	Возврат Неопределено;
КонецФункции

// Пулы заданного типа.
//
// Параметры:
//  Тип - Строка - user | custom.
//
// Возвращаемое значение:
//  Массив из Пул - пулы указанного типа.
//
&МетодЗапроса
Функция ПолучитьПоТипРавно(Тип) Экспорт
	Возврат Неопределено;
КонецФункции

// Вся таблица пулов без отбора.
//
// Возвращаемое значение:
//  Массив из Пул - все пулы хаба.
//
&МетодЗапроса
Функция ПолучитьПо() Экспорт
	Возврат Неопределено;
КонецФункции

// Пулы перечисленных идентификаторов одним запросом. В отличие от ПолучитьПоИдентификаторВ
// приводит идентификаторы к числу, так что годятся и строковые. Пустой список — пустая выдача.
//
// Параметры:
//  Идентификаторы - Массив из Число, Строка - идентификаторы пулов.
//
// Возвращаемое значение:
//  Массив из Пул - найденные пулы; ненайденных в выдаче нет, порядок не гарантируется.
//
Функция ПулыПоИдентификаторам(Знач Идентификаторы) Экспорт

	Целые = Новый Массив();
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Целые.Добавить(Цел(Идентификатор));
	КонецЦикла;

	Возврат Сам.Достать().ПолучитьПоИдентификаторВ(Целые);

КонецФункции

// Все пулы хаба. Порядок не гарантируется.
//
// Возвращаемое значение:
//  Массив из Пул.
//
Функция Все() Экспорт
	Возврат Сам.Достать().ПолучитьПо();
КонецФункции

// Снимок пула по имени из кэша «пулы»: поля сущности без занятого места, только для чтения.
//
// Параметры:
//  Имя - Строка - имя пула.
//
// Возвращаемое значение:
//  ФиксированнаяСтруктура, Неопределено - снимок пула.
//
&Кэшируемый("пулы")
Функция СнимокПоИмени(Знач Имя) Экспорт
	Возврат Форма().Снимок(Сам.Достать().ПолучитьОдноПоИмяРавно(Имя));
КонецФункции

// Снимки всех пулов хаба из кэша «пулы». Порядок не гарантируется.
//
// Возвращаемое значение:
//  ФиксированныйМассив из ФиксированнаяСтруктура - снимки пулов.
//
&Кэшируемый("пулы")
Функция СнимкиВсех() Экспорт
	Возврат Форма().Снимки(Сам.Достать().ПолучитьПо());
КонецФункции

// Забывает снимки пулов: зовёт каждый, кто записал пул, кроме счётчика занятого места.
//
&СбрасываетКэш(Значение = "пулы", ВсеЗаписи = Истина)
Процедура ЗабытьСнимки() Экспорт
КонецПроцедуры

// Сколько пулов заведено на хабе.
//
// Возвращаемое значение:
//  Число.
//
Функция Количество() Экспорт
	Возврат Агрегаты.Количество(Сам.Достать());
КонецФункции

// Занятое всеми пулами место по их счётчикам, байты. Счётчик ниже нуля вносит в сумму ноль.
//
// Возвращаемое значение:
//  Число - байты.
//
Функция СуммаЗанятогоБайт() Экспорт

	Возврат Агрегаты.Сумма(Сам.Достать(), "ЗанятоБайт",
		Новый ОпцииПоиска().Отбор("ЗанятоБайт", ВидСравнения.Больше, 0));

КонецФункции

// Модель сущности есть только у собранного репозитория, поэтому форма снимка строится при первом снимке.
Функция Форма()
	Если ФормаСнимка = Неопределено Тогда
		ФормаСнимка = Новый ФормаСнимка(Сам.Достать().ПолучитьОбъектМодели(), "ЗанятоБайт");
	КонецЕсли;
	Возврат ФормаСнимка;
КонецФункции

&ХранилищеСущностей("Пул")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеПулов") _Сам,
	&Пластилин(Значение = "АгрегатыБазы") _Агрегаты)

	Сам = _Сам;
	Агрегаты = _Агрегаты;

КонецПроцедуры
