// Единственная лесенка резолва спецификации версии — того, что пользователь пишет
// после «@»: точная версия, затем имя тега, затем выражение версии. Ею живут и выдача
// файла, и ответ «назови подходящую версию»: две копии правила означали бы, что
// установка по тегу и резолв по тегу отдают разные версии.
// Точная версия находится всегда, включая отозванную; тег и выражение отозванную
// не выбирают никогда — отсев живёт в СоставКаналов и ДействующиеВерсии.

Перем СервисВерсий; // СервисВерсий
Перем СервисТегов;  // СервисТегов
Перем Сравнитель;   // СравнительВерсий

#Область ПубличныйИнтерфейс

// Разрешает спецификацию версии в конкретную версию пакета. Ступени пробуются по порядку:
// точная строка версии, имя тега, выражение версии. Пустая спецификация означает «версия
// основного тега пакета».
//
// Параметры:
//  Пакет - Пакет, Неопределено - пакет.
//  Спецификация - Строка - точная версия, имя тега либо выражение версии; пустая строка
//                 означает, что клиент условия не назвал.
//  СредиВерсий - Массив из ВерсияПакета, Неопределено - из чего ХАБУ разрешено выбирать;
//                на ступень точной версии не влияет — названная клиентом координата
//                достаётся всегда (необязательный, по умолчанию Неопределено — все версии).
//
// Возвращаемое значение:
//  Структура - Найдена (Булево), Версия (ВерсияПакета, Неопределено),
//              ВерсиюВыбралХаб (Булево; Ложь только когда клиент назвал точную версию —
//              такой ответ по тому же адресу больше не изменится),
//              ТегНеизвестен (Булево; спецификация записана как имя тега, а тега нет),
//              ВыражениеБитое (Булево; спецификация не разбирается ни как имя тега,
//              ни как выражение версии).
//
Функция Разрешить(Знач Пакет, Знач Спецификация, Знач СредиВерсий = Неопределено) Экспорт

	Если Пакет = Неопределено Тогда
		Возврат НеНайдена();
	КонецЕсли;

	Условие = СокрЛП(Строка(Спецификация));
	Если ПустаяСтрока(Условие) Тогда
		Возврат РазрешитьТегом(Пакет, "", СредиВерсий);
	КонецЕсли;

	// точная первой: «версия достаётся всегда» — обещание сильнее любой другой трактовки
	// строки, поэтому одноимённый тег ей проигрывает. Круг кандидатов её не сужает:
	// клиент назвал координату сам, и подменять её нечем
	Точная = СервисВерсий.НайтиВерсию(Пакет.Идентификатор, Условие);
	Если Точная <> Неопределено Тогда
		Возврат НазвалКлиент(Точная);
	КонецЕсли;

	// тег вперёд выражения: выражение вида "1.4" разобралось бы и из имени тега
	Если СервисТегов.ТегИзвестен(Пакет, Условие) Тогда
		Возврат ВыбралХаб(СервисТегов.РазрешитьВерсиюТега(Пакет, Условие, СредиВерсий));
	КонецЕсли;

	Попытка
		ПоВыражению = СервисВерсий.РазрешитьПоДиапазону(Пакет.Идентификатор, Условие, СредиВерсий);
	Исключение
		Возврат НеразобраннаяСпецификация(Условие);
	КонецПопытки;

	Возврат ВыбралХаб(ПоВыражению);

КонецФункции

// Разрешает версию по имени тега — так читается канальный сегмент пути выдачи.
// Имя не названо — версия основного тега пакета.
//
// Параметры:
//  Пакет - Пакет, Неопределено - пакет.
//  ИмяТега - Строка - имя тега; пустая строка означает «основной тег пакета».
//  СредиВерсий - Массив из ВерсияПакета, Неопределено - из чего хабу разрешено выбирать
//                (необязательный, по умолчанию Неопределено — все версии пакета).
//
// Возвращаемое значение:
//  Структура - та же, что у Разрешить.
//
Функция РазрешитьТегом(Знач Пакет, Знач ИмяТега, Знач СредиВерсий = Неопределено) Экспорт

	Если Пакет = Неопределено Тогда
		Возврат НеНайдена();
	КонецЕсли;

	Имя = СокрЛП(Строка(ИмяТега));
	Если ПустаяСтрока(Имя) Тогда
		Возврат ВыбралХаб(СервисТегов.РазрешитьПоУмолчанию(Пакет, СредиВерсий));
	КонецЕсли;

	Возврат ВыбралХаб(СервисТегов.РазрешитьВерсиюТега(Пакет, Имя, СредиВерсий));

КонецФункции

// Записана ли спецификация как строка версии. Только такой спрашивают чужой источник:
// имя тега и выражение версии — язык этого хаба, и закачка «версии stable» положила бы
// в хранилище артефакт с координатой-версией stable.
//
// Параметры:
//  Спецификация - Строка - спецификация версии.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоСтрокаВерсии(Знач Спецификация) Экспорт
	Возврат Сравнитель.ВерсияКорректна(Спецификация) ИЛИ Сравнитель.ЭтоSNAPSHOT(Спецификация);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Опечатка в имени тега и битое выражение версии требуют от клиента разных действий,
// поэтому неразобранная спецификация делится надвое по алфавиту имён тегов.
Функция НеразобраннаяСпецификация(Знач Условие)
	Возврат ?(СервисТегов.ИмяДопустимо(Условие), ТегаНет(), ВыражениеНеРазбирается());
КонецФункции

Функция НазвалКлиент(Знач Версия)
	Возврат Итог(Версия, Ложь, Ложь, Ложь);
КонецФункции

Функция ВыбралХаб(Знач Версия)
	Возврат Итог(Версия, Истина, Ложь, Ложь);
КонецФункции

Функция ТегаНет()
	Возврат Итог(Неопределено, Истина, Истина, Ложь);
КонецФункции

Функция ВыражениеНеРазбирается()
	Возврат Итог(Неопределено, Истина, Ложь, Истина);
КонецФункции

Функция НеНайдена()
	Возврат Итог(Неопределено, Истина, Ложь, Ложь);
КонецФункции

Функция Итог(Знач Версия, Знач ВерсиюВыбралХаб, Знач ТегНеизвестен, Знач ВыражениеБитое)

	Найдена = (Версия <> Неопределено);
	Возврат Новый Структура("Найдена, Версия, ВерсиюВыбралХаб, ТегНеизвестен, ВыражениеБитое",
		Найдена, Версия, Найдена И ВерсиюВыбралХаб, ТегНеизвестен, ВыражениеБитое);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "СравнительВерсий") _Сравнитель)

	СервисВерсий = _СервисВерсий;
	СервисТегов = _СервисТегов;
	Сравнитель = _Сравнитель;

КонецПроцедуры
