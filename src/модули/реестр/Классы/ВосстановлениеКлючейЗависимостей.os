// Разовая починка данных: дописывает ключ обратного графа строкам зависимостей,
// записанным сборками, которые его не заполняли. Заполненные строки не трогает,
// поэтому повторный запуск ничего не меняет. Зовёт её последним синхронным шагом
// старта ОткрытиеПорта — до того, как хаб примет первый запрос.

Перем ХранилищеЗависимостей;  // ХранилищеЗависимостей (данные)
&Лог
Перем Лог;

// Проходит строки зависимостей и восстанавливает у них ключ обратного графа.
// Best-effort: собственные ошибки перехватывает — без ключей хаб работает ровно так,
// как работал до починки, и ронять из-за них старт нечестно.
//
// Возвращаемое значение:
//  Число - сколько строк дописано; 0, если работы не было либо проход не удался.
//
Функция Восстановить() Экспорт

	Попытка
		Восстановлено = Пройти();
	Исключение
		// Диагностика best-effort: в частичном контейнере (тесты) лога может не быть вовсе.
		Если Лог <> Неопределено Тогда
			Лог.Предупреждение("Не удалось восстановить ключи имён в зависимостях версий: %1",
				ОписаниеОшибки());
		КонецЕсли;
		Возврат 0;
	КонецПопытки;

	Отчитаться(Восстановлено);
	Возврат Восстановлено;

КонецФункции

Функция Пройти()

	Восстановлено = 0;

	// проход по всей таблице: отбор «где пусто» на разных бэкендах означает разное —
	// в JSON отсутствующий ключ читается как Неопределено, в SQL как пустая строка
	Для Каждого Зависимость Из ХранилищеЗависимостей.Все() Цикл
		Если ХранилищеЗависимостей.ВосстановитьКлюч(Зависимость) Тогда
			Восстановлено = Восстановлено + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Восстановлено;

КонецФункции

Процедура Отчитаться(Знач Восстановлено)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Восстановлено = 0 Тогда
		Лог.Отладка("Ключи имён в зависимостях версий: восстанавливать нечего");
		Возврат;
	КонецЕсли;

	Лог.Информация(
		"Ключи имён в зависимостях версий восстановлены у %1 строк: до этого вкладка"
		+ " «Зависимости» показывала их без имени, а обратный граф не находил вовсе.",
		Восстановлено);

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеЗависимостей") _ХранилищеЗависимостей)

	ХранилищеЗависимостей = _ХранилищеЗависимостей;

КонецПроцедуры
