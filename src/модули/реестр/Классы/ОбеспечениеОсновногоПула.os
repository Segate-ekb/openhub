// Рогатка старта: назначает основной пул хаба по сиду oshub.pools.default, если основной
// ещё не назначен, и предупреждает оператора, когда назначать нечего.

Перем СервисПулов;   // СервисПулов
&Лог
Перем Лог;

// Назначает основной пул хаба по сиду и пишет в лог итог. Best-effort: собственные
// ошибки перехватывает — стартовать хаб без основного пула можно, короткие адреса
// объясняют отказ сами.
//
Процедура ПриЗапускеПриложения() Экспорт

	Попытка
		Обеспечить();
	Исключение
		// Диагностика best-effort: в частичном контейнере (тесты) лога может не быть вовсе.
		Если Лог <> Неопределено Тогда
			Лог.Предупреждение("Не удалось назначить основной пул хаба: %1", ОписаниеОшибки());
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

Процедура Обеспечить()

	Назначенный = СервисПулов.ОбеспечитьОсновнойПул();
	Если Назначенный <> Неопределено Тогда
		Лог.Информация(
			"Основной пул хаба назначен по сиду oshub.pools.default: ""%1"". Дальше сид"
			+ " не участвует — основной пул переключается в разделе «Пулы» настроек хаба.",
			Назначенный.Имя);
		Возврат;
	КонецЕсли;

	Действующий = СервисПулов.ДефолтныйПул();
	Если Действующий <> Неопределено Тогда
		Если Лог <> Неопределено Тогда
			Лог.Отладка("Основной пул хаба уже назначен: ""%1"" — сид не применяется",
				Действующий.Имя);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Лог.Предупреждение(
		"Основной пул хаба не назначен: короткие адреса /download, /dev-channel и /push"
		+ " отвечают отказом с объяснением. Назначьте основной пул в разделе «Пулы»"
		+ " настроек хаба (/hub/settings/pools) либо заведите пул с именем ""%1"""
		+ " (сид oshub.pools.default).",
		СервисПулов.ИмяСидаОсновногоПула());

КонецПроцедуры

&Рогатка(ЗапускатьВФоне = Ложь)
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов)

	СервисПулов = _СервисПулов;

КонецПроцедуры
