// Оркестрирует приём push: рамки ключа, авторизация, валидация .ospx, сверка манифеста
// с именем файла, приём артефакта и публикация версии. Ни запроса, ни ответа не знает.

#Использовать ospx-tools

&Лог
Перем Лог;

Перем СервисПулов;    // СервисПулов
Перем СервисПакетов;  // СервисПакетов
Перем СервисВерсий;   // СервисВерсий
Перем Приём;          // ПриёмВерсии (реестр)
Перем СервисМеток;    // СервисМетокВерсий
Перем Правила;        // ПравилаИменования
Перем Хранилище;      // ХранилищеАртефактов (хранилище)
Перем Занятое;        // ЗаписьЗанятогоМеста (реестр)
Перем Место;          // МестоВПуле (публикация) — гейт квоты на приём артефакта
Перем ГвардКлюча;     // ГвардКлюча (auth)
Перем СервисПрав;     // СервисПрав (auth)
Перем СервисПравДоступа; // СервисПравДоступа (auth)
Перем Издатель;       // ИздательСобытий (события)
Перем ИменаЖурнала;   // ИмяОбъектаАудита (аудит) — вид объекта в журнале
Перем СобытиеЖурнала; // СобытиеАудита (аудит) — форма нагрузки записи
Перем Входящие;       // СервисВходящих, может быть Неопределено
Перем ДовериеКонвейеров; // СервисДоверияCI, может быть Неопределено
Перем Настройки;      // СервисНастроек (настройки)
Перем Ошибки;         // ТекстОшибки (основа)
Перем Уборка;         // ТихаяУборка (основа)
Перем Флаги;          // ПриведениеФлагов (основа) — терпимое чтение булева

#Область ПубличныйИнтерфейс

// Принимает push пакета в пул: проверяет тело и права, валидирует .ospx, кладёт артефакт
// в хранилище и публикует версию. Без прав на свободное имя в видимом пуле заявка уходит
// в очередь «входящих», если та собрана.
//
// Параметры:
//  ИмяПула - Строка - целевой пул.
//  Данные - ДвоичныеДанные - сырые байты .ospx.
//  ИмяФайла - Строка - значение заголовка FILE-NAME.
//  Канал - Строка - значение заголовка CHANNEL, сохраняется как метка версии.
//  Пользователь - Пользователь, Неопределено - аутентифицированный публикатор.
//  Токен - Строка - сырой PAT, легаси-токен GitHub либо id-token конвейера
//          (необязательный, по умолчанию "").
//  Принципал - Структура, Неопределено - принципал запроса для рамок ключа
//              (необязательный, по умолчанию Неопределено).
//  Форсировать - Булево - публикация просит замену номера («?force=1» у адреса push):
//                опубликованный номер заменяется целиком, даже если тег запрещает
//                повторную публикацию. Отдельного права у форса нет — форсит тот,
//                кто вправе публиковать (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число: 200/201 успех, 202 принято во «входящие»,
//              400/401/403/404/409/413 отказ по правилу — с причиной, 500 поломка хаба —
//              с фиксированным текстом), Сообщение (Строка, opm печатает как есть).
//
Функция Опубликовать(Знач ИмяПула, Знач Данные, Знач ИмяФайла, Знач Канал,
	Знач Пользователь, Знач Токен = "", Знач Принципал = Неопределено,
	Знач Форсировать = Ложь) Экспорт

	// без Перем присваивание уйдёт в ПОЛЕ объекта, общее на процесс
	Перем МаксРазмерЗагрузки;
	Перем ВердиктКлюча;

	Если НЕ ЗначениеЗаполнено(ИмяФайла) ИЛИ НРег(Прав(СокрЛП(ИмяФайла), 5)) <> ".ospx" Тогда
		Возврат Отказ(400, "Недопустимое расширение файла пакета. Допускаются только файлы .ospx");
	КонецЕсли;

	Если Данные = Неопределено ИЛИ Данные.Размер() = 0 Тогда
		Возврат Отказ(400, "Пустое тело запроса: ожидались байты .ospx");
	КонецЕсли;

	МаксРазмерЗагрузки = Настройки.Значение(КлючПределаЗагрузки());
	Лог.Отладка("Публикация: пул ""%1"", файл ""%2"", канал ""%3"", размер %4 байт при потолке %5",
		ИмяПула, ИмяФайла, Канал, Данные.Размер(), МаксРазмерЗагрузки);

	Если Данные.Размер() > МаксРазмерЗагрузки Тогда
		Возврат Отказ(413, СтрШаблон(
			"Размер загрузки %1 байт превышает лимит %2 байт", Данные.Размер(), МаксРазмерЗагрузки),
			ПодробностиПредела(КлючПределаЗагрузки(), МаксРазмерЗагрузки, Данные.Размер()));
	КонецЕсли;

	Пул = СервисПулов.НайтиПул(ИмяПула);
	Если Пул = Неопределено Тогда
		Возврат Отказ(404, СтрШаблон("Пул ""%1"" не найден", ИмяПула),
			Новый Структура("pool", Строка(ИмяПула)));
	КонецЕсли;
	// гейт стоит ДО чтения тела и проверки прав: запрещающий пул не создаёт ни версий,
	// ни файлов
	Если НЕ СервисПулов.ПубликацияРазрешена(Пул) Тогда
		Возврат Отказ(409, СтрШаблон(
			"Пул ""%1"" не принимает публикации: публикация в нём запрещена настройкой пула", ИмяПула));
	КонецЕсли;

	// гейт ключа — отдельный контур, ДО модели прав и до чтения тела. Fail-closed на
	// отсутствующий гейт: несобранная зависимость молча отключила бы энфорсмент.
	// Формулировка отказа берётся у гварда, чтобы инвариант объяснялся одними словами.
	Если ГвардКлюча = Неопределено Тогда
		Если Принципал <> Неопределено И НРег(СокрЛП(Строка(Принципал.Способ))) = "token" Тогда
			Возврат Отказ(403, "Публикация по токену недоступна: гейт ключа доступа не собран");
		КонецЕсли;
	Иначе
		ВердиктКлюча = ГвардКлюча.Пропустить(Принципал, "создание", Пул.Идентификатор);
		Если НЕ ВердиктКлюча.Разрешено Тогда
			Лог.Отладка("Публикация: гейт ключа доступа не пропустил в пул #%1, причина %2",
				Пул.Идентификатор, ВердиктКлюча.Причина);
			Возврат Отказ(403, "Публикация запрещена ключом доступа: "
				+ ГвардКлюча.ОписаниеПричины(ВердиктКлюча.Причина));
		КонецЕсли;
	КонецЕсли;

	ВременныйПуть = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-push-" + Строка(Новый УникальныйИдентификатор) + ".ospx");
	Данные.Записать(ВременныйПуть);

	Попытка
		Результат = ПринятьПакет(ПушНаПриёме(Пул, ВременныйПуть, ИмяФайла, Канал,
			Пользователь, Токен, Данные.Размер(), Форсировать));
	Исключение
		Уборка.УдалитьФайл(ВременныйПуть);
		ВызватьИсключение;
	КонецПопытки;

	Уборка.УдалитьФайл(ВременныйПуть);
	Возврат Результат;

КонецФункции

// Читает флаг замены номера из значения параметра адреса «force». Правило одно на все
// двери публикации: отсутствующий и невнятный параметр — обычный push, иначе легаси-клиент,
// ничего о форсе не знающий, попадал бы в ветку замены.
//
// Параметры:
//  Значение - Произвольный - сырое значение параметра запроса.
//
// Возвращаемое значение:
//  Булево - Истина, если публикация просит заменить уже опубликованный номер.
//
Функция ЭтоФорс(Знач Значение) Экспорт
	Возврат Флаги.ФлагИстина(Значение, Ложь);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Всё, что дошло до приёма пакета проверенным по рамкам запроса: пул, байты на диске,
// заголовки push и просьба заменить номер.
Функция ПушНаПриёме(Знач Пул, Знач ВременныйПуть, Знач ИмяФайла, Знач Канал,
	Знач Пользователь, Знач Токен, Знач РазмерЗагрузки, Знач Форсировать)

	Возврат Новый Структура(
		"Пул, ВременныйПуть, ИмяФайла, Канал, Пользователь, Токен, РазмерЗагрузки, Форсировать",
		Пул, ВременныйПуть, ИмяФайла, Канал, Пользователь, Токен, РазмерЗагрузки, Форсировать);

КонецФункции

// Приём пакета в пул. ПОРЯДОК шагов — сам инвариант, а не подробность реализации: каждый
// отказ назван раньше первой записи, поэтому отклонённая публикация не оставляет ни файла
// в хранилище, ни пустой строки в каталоге, ни занятого места за собой.
// Об отказе шаги говорят двумя формами, и это разные вещи: шаг, который везёт данные дальше,
// кладёт причину полем «Отказ» рядом с ними; шаг-предикат отдаёт причину либо Неопределено.
Функция ПринятьПакет(Знач ПушНаПриёме)

	Разбор = РазобратьПакет(ПушНаПриёме);
	Если Разбор.Отказ <> Неопределено Тогда
		Возврат Разбор.Отказ;
	КонецЕсли;

	Допуск = ДопускКПубликации(ПушНаПриёме, Разбор);
	Если НЕ Допуск.Разрешено Тогда
		Возврат ВходящиеЛибоОтказ(ПушНаПриёме, Разбор, Допуск);
	КонецЕсли;

	Номер = ЗанятостьНомера(ПушНаПриёме, Разбор, Допуск);

	ОтказПриёма = ОтказПоПравиламПриёма(ПушНаПриёме, Разбор);
	Если ОтказПриёма <> Неопределено Тогда
		Возврат ОтказПриёма;
	КонецЕсли;

	ОтказМеста = ОтказПоКвотеДоЗаписи(ПушНаПриёме, Номер);
	Если ОтказМеста <> Неопределено Тогда
		Возврат ОтказМеста;
	КонецЕсли;

	Уложенное = УложитьАртефакт(ПушНаПриёме, Разбор, Допуск, Номер);
	Если Уложенное.Отказ <> Неопределено Тогда
		Возврат Уложенное.Отказ;
	КонецЕсли;

	Возврат ЗакрытьПубликацию(ПушНаПриёме, Разбор, Допуск, Номер, Уложенное);

КонецФункции

// Что приехало в .ospx: сам пакет, его манифест, имя и версия. Отказ этого шага всегда 400 —
// негодные байты, негодный манифест, негодное имя либо заголовок FILE-NAME мимо манифеста.
Функция РазобратьПакет(Знач ПушНаПриёме)

	Перем Ограничения;

	Ограничения = ТекущиеОграничения();
	Попытка
		Пакет = ПакетыOspx.ПрочитатьПакет(ПушНаПриёме.ВременныйПуть, Ограничения);
	Исключение
		Возврат Неразобранное(Отказ(400,
			"Некорректный пакет .ospx: " + Ошибки.ДляЧеловека(ИнформацияОбОшибке())));
	КонецПопытки;

	Манифест = Пакет.Манифест();

	РезультатВалидации = ПакетыOspx.ПроверитьМанифест(Манифест);
	Если НЕ РезультатВалидации.Корректен() Тогда
		Возврат Неразобранное(Отказ(400,
			"Пакет не прошёл валидацию: " + РезультатВалидации.ОписаниеОшибок()));
	КонецЕсли;

	ИмяПакета = СокрЛП(Строка(Манифест.Имя()));
	ВерсияСтрока = СокрЛП(Строка(Манифест.Версия()));

	Если НЕ Правила.ИмяКорректно(ИмяПакета) Тогда
		Возврат Неразобранное(Отказ(400,
			СтрШаблон("Недопустимое имя пакета ""%1""", ИмяПакета)));
	КонецЕсли;

	Если Правила.ИмяПакетаЗарезервировано(ИмяПакета) Тогда
		Возврат Неразобранное(Отказ(400, СтрШаблон(
			"Имя пакета ""%1"" зарезервировано хабом под системный адрес: страница такого"
			+ " пакета была бы недостижима. Выберите другое имя.", ИмяПакета)));
	КонецЕсли;

	ОтказИмениФайла = ОтказПоРасхождениюСМанифестом(ПушНаПриёме, ИмяПакета, ВерсияСтрока);
	Если ОтказИмениФайла <> Неопределено Тогда
		Возврат Неразобранное(ОтказИмениФайла);
	КонецЕсли;

	Возврат Новый Структура("Отказ, Пакет, Манифест, ИмяПакета, Версия",
		Неопределено, Пакет, Манифест, ИмяПакета, ВерсияСтрока);

КонецФункции

Функция Неразобранное(Знач Ответ)
	Возврат Новый Структура("Отказ, Пакет, Манифест, ИмяПакета, Версия",
		Ответ, Неопределено, Неопределено, "", "");
КонецФункции

// Сверка FILE-NAME с манифестом: старый хаб доверял заголовку вслепую.
Функция ОтказПоРасхождениюСМанифестом(Знач ПушНаПриёме, Знач ИмяПакета, Знач ВерсияСтрока)

	ОжидаемоеИмяФайла = СтрШаблон("%1-%2.ospx", ИмяПакета, ВерсияСтрока);
	Если НРег(СокрЛП(ПушНаПриёме.ИмяФайла)) = НРег(ОжидаемоеИмяФайла) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Отказ(400, СтрШаблон(
		"Имя файла ""%1"" не соответствует манифесту (id=%2, версия=%3): ожидалось ""%4""",
		ПушНаПриёме.ИмяФайла, ИмяПакета, ВерсияСтрока, ОжидаемоеИмяФайла));

КонецФункции

// Два пути к праву на push: роль человека и легаси-токен GitHub (оба в РазрешёнPush) либо
// доверенный конвейер. Шаг только судит и ничего не пишет: что делать с непропущенным —
// решает вызывающий, у него же стоит третий путь, очередь «входящих».
Функция ДопускКПубликации(Знач ПушНаПриёме, Знач Разбор)

	Перем Разрешено;
	Перем ВердиктКонвейера;

	// новое имя требует права СОЗДАНИЕ на пуле, новая версия — ИЗМЕНЕНИЕ на пакете,
	// поэтому существование пакета определяем ДО авторизации, не создавая его
	ПакетДоПубликации = СервисПакетов.НайтиПакет(ПушНаПриёме.Пул.Идентификатор, Разбор.ИмяПакета);
	НовоеИмя = (ПакетДоПубликации = Неопределено);

	// опция «легаси-токен GitHub» читается здесь и передаётся в ядро прав: инъекция
	// настроек в СервисПрав рушила бы его в контейнерах без модуля настройки
	Разрешено = СервисПрав.РазрешёнPush(ПушНаПриёме.Пользователь, ПушНаПриёме.Пул, Разбор.ИмяПакета,
		ПушНаПриёме.Токен, ПакетДоПубликации, ЛегасиGitHubВключён());

	ВердиктКонвейера = Неопределено;
	Если НЕ Разрешено И ДовериеКонвейеров <> Неопределено
		И ДовериеКонвейеров.ЭтоТокенКонвейера(ПушНаПриёме.Токен) Тогда
		ВердиктКонвейера = ДовериеКонвейеров.РазрешаетПубликацию(ПакетДоПубликации, ПушНаПриёме.Токен);
		Разрешено = ВердиктКонвейера.Разрешено;
	КонецЕсли;

	Лог.Отладка("Публикация: ""%1"" %2 в пул ""%3"" — имя новое: %4, право push: %5, конвейер: %6",
		Разбор.ИмяПакета, Разбор.Версия, ПушНаПриёме.Пул.Имя, НовоеИмя, Разрешено,
		?(ВердиктКонвейера = Неопределено, "не спрашивался", ВердиктКонвейера.Причина));

	Возврат Новый Структура("Разрешено, ВердиктКонвейера, ПакетДоПубликации, НовоеИмя",
		Разрешено, ВердиктКонвейера, ПакетДоПубликации, НовоеИмя);

КонецФункции

// Что отвечаем публикатору, которого допуск не пропустил. Единственный шаг приёма, который
// пишет до укладки артефакта: аутентифицированный человек со свободным именем в видимом пуле
// оставляет заявку в очереди «входящих» и получает 202. Всё прочее — отказ.
Функция ВходящиеЛибоОтказ(Знач ПушНаПриёме, Знач Разбор, Знач Допуск)

	// на id-token отвечаем про конвейер: у CI нет учётки, и совет «заведите PAT» уводит
	Если Допуск.ВердиктКонвейера <> Неопределено Тогда
		Возврат Отказ(403, СтрШаблон(
			"Публикация доверенным конвейером отклонена: %1", Допуск.ВердиктКонвейера.Причина));
	КонецЕсли;

	Если ПушНаПриёме.Пользователь = Неопределено Тогда
		Возврат Отказ(401, "Требуется аутентификация: действительный PAT в заголовке OAUTH-TOKEN или Authorization: Bearer");
	КонецЕсли;

	// условие закрытое: во «входящие» уходит ровно один случай — аутентифицированный
	// человек, свободное имя, ВИДИМЫЙ ему пул, очередь собрана. Всё прочее, включая
	// push без прав в существующий пакет, остаётся 403, иначе очередь стала бы способом
	// достучаться до чужого пакета, а заявка — каналом расхода чужого хранилища
	Если Допуск.НовоеИмя И Входящие <> Неопределено
		И СервисПрав.МожетЧитать(ПушНаПриёме.Пользователь, ПушНаПриёме.Пул) Тогда

		ОтказМеста = ОтказПоКвотеЗаявки(ПушНаПриёме);
		Если ОтказМеста <> Неопределено Тогда
			Возврат ОтказМеста;
		КонецЕсли;

		Лог.Отладка("Публикация: ""%1"" уходит во входящие пула ""%2"" — имя свободно,"
			+ " пул виден заявителю, очередь собрана", Разбор.ИмяПакета, ПушНаПриёме.Пул.Имя);
		Возврат Входящие.Поставить(ПушНаПриёме.Пул, Разбор.ИмяПакета, Разбор.Версия, ПушНаПриёме.ИмяФайла,
			ПушНаПриёме.Канал, ПушНаПриёме.ВременныйПуть, ПушНаПриёме.Пользователь, Разбор.Манифест.Автор());
	КонецЕсли;

	Возврат Отказ(403, ПричинаОтказаPush(ПушНаПриёме.Пул, ПушНаПриёме.Пользователь,
		Разбор.ИмяПакета, Допуск.НовоеИмя));

КонецФункции

// Байты заявки ложатся в область пула и занимают его место: без этого гейта очередь была бы
// дырой на сотни мегабайт мимо предела.
Функция ОтказПоКвотеЗаявки(Знач ПушНаПриёме)

	ОтказМеста = Место.ПричинаОтказа(ПушНаПриёме.Пул, ПушНаПриёме.РазмерЗагрузки, Неопределено);
	Если ОтказМеста = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Лог.Отладка("Публикация: заявка на %1 байт не влезает в квоту пула ""%2"" — код %3",
		ПушНаПриёме.РазмерЗагрузки, ПушНаПриёме.Пул.Имя, ОтказМеста.Код);
	Возврат ОтказМеста;

КонецФункции

// Занят ли номер версии: запись, опубликованная под ним ранее, и признак первой публикации.
// Строку каталога заводит только приём версии, поэтому оба отказа ниже застают имя свободным.
Функция ЗанятостьНомера(Знач ПушНаПриёме, Знач Разбор, Знач Допуск)

	ОпубликованнаяРанее = Неопределено;
	Если Допуск.ПакетДоПубликации <> Неопределено Тогда
		ОпубликованнаяРанее = СервисВерсий.НайтиВерсию(
			Допуск.ПакетДоПубликации.Идентификатор, Разбор.Версия);
	КонецЕсли;
	Впервые = (ОпубликованнаяРанее = Неопределено);

	Лог.Отладка("Публикация: версия %1 уже опубликована: %2, форс: %3",
		Разбор.Версия, НЕ Впервые, ПушНаПриёме.Форсировать);

	Возврат Новый Структура("ОпубликованнаяРанее, Впервые", ОпубликованнаяРанее, Впервые);

КонецФункции

// Приём спрашивается ЗАРАНЕЕ: его отказ по правилу — ответ клиенту причиной со своим кодом
// (400 на негодный ввод, 409 на уже принятый номер), а всё, что упадёт в приёме ПОСЛЕ этого
// вопроса, — поломка хаба, и её текст наружу не идёт.
Функция ОтказПоПравиламПриёма(Знач ПушНаПриёме, Знач Разбор)

	Причина = Приём.ПричинаОтказаПубликации(ПушНаПриёме.Пул, Разбор.ИмяПакета, Разбор.Версия,
		ПушНаПриёме.Форсировать);
	Если Причина = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// имя и номер — те, что скрипт прислал: по ним он и решает, что переименовать
	Возврат Отказ(Причина.Код, Причина.Сообщение, Новый Структура("package, version",
		Строка(Разбор.ИмяПакета), Строка(Разбор.Версия)));

КонецФункции

// До Сохранить: пул не должен вырасти даже на время.
Функция ОтказПоКвотеДоЗаписи(Знач ПушНаПриёме, Знач Номер)

	ОтказМеста = Место.ПричинаОтказа(ПушНаПриёме.Пул, ПушНаПриёме.РазмерЗагрузки, Номер.ОпубликованнаяРанее);
	Если ОтказМеста = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Лог.Отладка("Публикация: %1 байт не влезает в квоту пула ""%2"" — код %3",
		ПушНаПриёме.РазмерЗагрузки, ПушНаПриёме.Пул.Имя, ОтказМеста.Код);
	Возврат ОтказМеста;

КонецФункции

// Артефакт на диск и версия в каталог — один шаг с откатом: перенос манифеста часть приёма,
// а не действие следом за ним, поэтому его сбой сносит только что положенный файл (для
// перезаписи прежний уже заменён — откат неактуален). Сюда доходит только поломка: отказы
// по правилу спрошены выше, и клиенту идёт фиксированный текст, а подробности — в лог.
Функция УложитьАртефакт(Знач ПушНаПриёме, Знач Разбор, Знач Допуск, Знач Номер)

	Координаты = Новый КоординатыАртефакта(ПушНаПриёме.Пул.Имя, Разбор.ИмяПакета, Разбор.Версия);
	// Замер ДО записи: строка версии могла остаться от вытесненного кэша, и списывать
	// по ней несуществующие байты нельзя — в зачёт идёт то, что реально лежало на диске
	БылоНаДиске = РазмерВХранилище(Координаты);
	РезультатСохранения = Хранилище.Сохранить(Координаты, ПушНаПриёме.ВременныйПуть);

	Попытка
		// README принятого пакета уходит в приём вместе с манифестом: страница берёт его
		// с диска, а не распаковывает .ospx на каждый показ
		Принятое = Приём.ПринятьПубликацию(ПушНаПриёме.Пул, Разбор.ИмяПакета, Разбор.Версия,
			Разбор.Манифест, РезультатСохранения,
			?(ПушНаПриёме.Пользователь = Неопределено, 0, ПушНаПриёме.Пользователь.Идентификатор),
			НЕ Номер.Впервые, ПринялКонвейер(Допуск), ТекстREADME(Разбор.Пакет));
	Исключение
		Если Номер.Впервые Тогда
			ПопытатьсяУдалить(Координаты);
		КонецЕсли;
		// в лог — причина с местом: клиенту её не видно вовсе, а оператору нужны
		// модуль и строка, а не только текст
		Лог.Ошибка("Публикация: приём версии %1 пакета ""%2"" сорвался: %3",
			Разбор.Версия, Разбор.ИмяПакета, Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат Новый Структура("Отказ, Принятое, БылоНаДиске, РезультатСохранения",
			Отказ(500, "Не удалось опубликовать версию: внутренняя ошибка хаба"),
			Неопределено, БылоНаДиске, РезультатСохранения);
	КонецПопытки;

	Возврат Новый Структура("Отказ, Принятое, БылоНаДиске, РезультатСохранения",
		Неопределено, Принятое, БылоНаДиске, РезультатСохранения);

КонецФункции

// Признак доверенной публикации берётся ТОЛЬКО из вердикта конвейера: заголовок запроса,
// поле манифеста и галочка формы сюда не доходят и доходить не должны.
Функция ПринялКонвейер(Знач Допуск)
	Возврат Допуск.ВердиктКонвейера <> Неопределено И Допуск.ВердиктКонвейера.Разрешено = Истина;
КонецФункции

// Постэффекты состоявшейся публикации: владелец по TOFU, дельта занятого места, метка канала
// и доменное событие. Дельта учитывается ПОСЛЕ всех откатов — до этой точки любая неудача
// сносит артефакт с диска, а фиксация владельца исключений наружу не выпускает.
Функция ЗакрытьПубликацию(Знач ПушНаПриёме, Знач Разбор, Знач Допуск, Знач Номер, Знач Уложенное)

	ЗаписьПакета = Уложенное.Принятое.Пакет;
	ОпубликованнаяВерсия = Уложенное.Принятое.Версия;
	ДельтаЗанятого = Уложенное.РезультатСохранения.Размер - Уложенное.БылоНаДиске;

	Если Допуск.НовоеИмя Тогда
		ЗафиксироватьВладельцаTOFU(ПушНаПриёме.Пул, ЗаписьПакета, ПушНаПриёме.Пользователь);
	КонецЕсли;

	Занятое.Учесть(ПушНаПриёме.Пул, ДельтаЗанятого,
		"публикация " + Разбор.ИмяПакета + "-" + Разбор.Версия);

	СохранитьМеткуКанала(ОпубликованнаяВерсия, ПушНаПриёме.Канал);

	ОпубликоватьСобытиеПубликации(ПушНаПриёме.Пул, ЗаписьПакета, Разбор.ИмяПакета, Разбор.Версия,
		Номер.Впервые, ПушНаПриёме.Пользователь, ПушНаПриёме.Токен, ПушНаПриёме.РазмерЗагрузки,
		ПушНаПриёме.Форсировать);

	Код = ?(Номер.Впервые, 201, 200);
	Лог.Отладка("Публикация: ""%1"" %2 уложен в пул ""%3"", код %4, занятое изменилось на %5 байт",
		Разбор.ИмяПакета, Разбор.Версия, ПушНаПриёме.Пул.Имя, Код, ДельтаЗанятого);
	Возврат Успех(Код, СтрШаблон("Опубликовано: %1 %2 → пул %3%4",
		Разбор.ИмяПакета, Разбор.Версия, ПушНаПриёме.Пул.Имя, ?(Номер.Впервые, "", " (перезапись)")));

КонецФункции

// Причин три, и совет по ним разный: общий текст назвал бы не ту.
Функция ПричинаОтказаPush(Знач Пул, Знач Пользователь, Знач ИмяПакета, Знач НовоеИмя)

	Если НЕ НовоеИмя Тогда
		Возврат СтрШаблон(
			"Нет права публикации версии в пул ""%1"": имя ""%2"" в нём уже занято, а версии"
			+ " существующего пакета публикует тот, у кого есть право на этот пакет."
			+ " Попросите роль на пакете у его мейнтейнеров — заявка во «входящие» на занятое"
			+ " имя не создаётся.", Пул.Имя, ИмяПакета);
	КонецЕсли;

	Если НЕ СервисПрав.МожетЧитать(Пользователь, Пул) Тогда
		Возврат СтрШаблон(
			"Нет права создания пакета в пул ""%1"": пул вам не виден, поэтому артефакт не"
			+ " принят и во «входящие» — очередь заявок работает только в пулах, которые вы"
			+ " вправе читать. Попросите доступ к пулу у его мейнтейнеров.", Пул.Имя);
	КонецЕсли;

	Если Входящие = Неопределено Тогда
		Возврат СтрШаблон(
			"Нет права создания пакета в пул ""%1"", а очередь заявок на этом хабе не собрана:"
			+ " положить артефакт на рассмотрение некуда. Права на пул нужно получить у его"
			+ " мейнтейнеров.", Пул.Имя);
	КонецЕсли;

	// сюда попадает только основной пул с администрируемыми именами: во всех остальных
	// случаях видимый пул с собранной очередью уже вернул 202
	Возврат СтрШаблон(
		"Нет права создания пакета в пул ""%1""%2", Пул.Имя,
		?(Пул.ЭтоДефолтный(), ": имена в основном пуле хаба администрируются, их заводят"
			+ " администраторы хаба", ""));

КонецФункции

// «Кто» вычисляется здесь, где доступны и Пользователь, и сырой токен.
Процедура ОпубликоватьСобытиеПубликации(Знач Пул, Знач ЗаписьПакета, Знач ИмяПакета, Знач ВерсияСтрока,
	Знач НоваяВерсия, Знач Пользователь, Знач Токен, Знач РазмерЗагрузки, Знач Форсировать)

	Данные = СобытиеЖурнала.Собрать(
		КтоПринципал(Пользователь, Токен),
		?(НоваяВерсия, "публикация.версии", "перезапись.версии"),
		ИменаЖурнала.ВерсияПоИменам(Пул.Имя, ИмяПакета, ВерсияСтрока), "",
		ДеталиПубликации(Пул.Имя, ИмяПакета, ВерсияСтрока, НоваяВерсия, РазмерЗагрузки, Форсировать));

	// идентификаторы пула и пакета задают скоуп доставки подпискам — без утечки между пулами
	Данные.Вставить("ПулИдентификатор", Пул.Идентификатор);
	Данные.Вставить("ПакетИдентификатор", ?(ЗаписьПакета = Неопределено, 0, ЗаписьПакета.Идентификатор));
	Данные.Вставить("ИмяПула", Пул.Имя);
	Данные.Вставить("ИмяПакета", ИмяПакета);
	Данные.Вставить("Версия", ВерсияСтрока);

	Издатель.Опубликовать(Издатель.ТипВерсияОпубликована(), Данные);

КонецПроцедуры

// Логин пользователя, иначе префикс сырого токена, иначе аноним.
Функция КтоПринципал(Знач Пользователь, Знач Токен)
	Если Пользователь <> Неопределено И ЗначениеЗаполнено(Пользователь.Логин) Тогда
		Возврат Строка(Пользователь.Логин);
	КонецЕсли;
	Если ЗначениеЗаполнено(Токен) Тогда
		Возврат "token:" + Лев(Строка(Токен), 8);
	КонецЕсли;
	Возврат "anonymous";
КонецФункции

Функция ДеталиПубликации(Знач ИмяПула, Знач ИмяПакета, Знач ВерсияСтрока, Знач НоваяВерсия,
	Знач РазмерЗагрузки, Знач Форсировать)

	Данные = Новый Структура();
	Данные.Вставить("пул", ИмяПула);
	Данные.Вставить("пакет", ИмяПакета);
	Данные.Вставить("версия", ВерсияСтрока);
	Данные.Вставить("новая", НоваяВерсия);
	Данные.Вставить("размер", РазмерЗагрузки);
	// след перезаписи: по журналу должно быть видно не только ЧТО заменили, но и то,
	// что заменять просили явно
	Данные.Вставить("форс", Форсировать = Истина);
	Возврат Данные;

КонецФункции

// Сбой не критичен: публикация уже состоялась.
Процедура ЗафиксироватьВладельцаTOFU(Знач Пул, Знач Пакет, Знач Пользователь)
	Попытка
		Если Пользователь = Неопределено ИЛИ НЕ ТофуРазрешён(Пул) Тогда
			Возврат;
		КонецЕсли;
		// check-and-set сужает окно гонки двух конкурентных «первых» push; остаточная гонка принята
		Если УжеЕстьВладелецПакета(Пакет) Тогда
			Возврат;
		КонецЕсли;
		Действия = Новый Структура("создание, изменение, удаление, чтение", Истина, Истина, Истина, Истина);
		СервисПравДоступа.ЗафиксироватьГрант(
			"пользователь", Пользователь.Идентификатор, СервисПрав.ОбъектПакет(Пакет), Действия, Пользователь.Идентификатор);
	Исключение
		// фиксация владельца вторична — целостность публикации важнее
	КонецПопытки;
КонецПроцедуры

// Owner-маркер — грант с правом удаления.
Функция УжеЕстьВладелецПакета(Знач Пакет)
	Для Каждого Грант Из СервисПравДоступа.ГрантыНаОбъект(СервисПрав.ОбъектПакет(Пакет)) Цикл
		Если Грант.Удаление = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Спрашивается признак пула, а не его имя: имя основного пула произвольно.
Функция ТофуРазрешён(Знач Пул)
	Если Пул = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат НЕ Пул.ЭтоДефолтный();
КонецФункции

// Сбой не влияет на состоявшуюся публикацию; пустой CHANNEL метку не создаёт.
Процедура СохранитьМеткуКанала(Знач Версия, Знач Канал)
	Попытка
		Если Версия <> Неопределено И ЗначениеЗаполнено(Канал) Тогда
			СервисМеток.ПрисвоитьМетку(Версия.Идентификатор, Канал);
		КонецЕсли;
	Исключение
		// метка вторична — целостность публикации важнее (как счёт скачиваний)
	КонецПопытки;
КонецПроцедуры

// Пакет без README даёт пустую строку — это тоже ответ, и приём запомнит его наравне с текстом.
Функция ТекстREADME(Знач Пакет)
	Возврат ?(Пакет.ЕстьREADME(), Пакет.ТекстREADME(), "");
КонецФункции

// Размер артефакта в хранилище; отсутствующий артефакт — ноль, а не ошибка.
Функция РазмерВХранилище(Знач Координаты)
	Попытка
		Возврат ?(Хранилище.Существует(Координаты), Цел(Число(Хранилище.Размер(Координаты))), 0);
	Исключение
		Возврат 0; // гонка с уборкой: файла уже нет — значит, он ничего и не занимает
	КонецПопытки;
КонецФункции

// Ошибка чтения настроек — выключено: внешний источник права не включается по недоразумению.
Функция ЛегасиGitHubВключён()
	Возврат Настройки.Флаг("oshub.publish.github_legacy", Ложь);
КонецФункции

Функция Успех(Знач Код, Знач Сообщение)
	Возврат Новый Структура("Успех, Код, Сообщение", Истина, Код, Сообщение);
КонецФункции

// Подробности — поля отказа для клиента-скрипта: какой предел, каким числом нарушен,
// какое имя занято. Их состав объявляет тот, кто отказывает; словами то же самое
// по-прежнему сказано в сообщении.
Функция Отказ(Знач Код, Знач Сообщение, Знач Подробности = Неопределено)
	Возврат Новый Структура("Успех, Код, Сообщение, Подробности",
		Ложь, Код, Сообщение, Подробности);
КонецФункции

// Ключ настройки, которой судится размер принимаемого артефакта: он же читается и он же
// называется в отказе, поэтому литерал в модуле один.
Функция КлючПределаЗагрузки()
	Возврат "oshub.publish.max_upload_bytes";
КонецФункции

// Предел назван ключом настройки, числом и тем числом, которым он не пройден: скрипту
// конвейера этого хватает, чтобы решить — пересобрать пакет или просить поднять предел.
Функция ПодробностиПредела(Знач Ключ, Знач ПределБайт, Знач ФактическиБайт)

	Результат = Новый Структура();
	Результат.Вставить("limit", Ключ);
	Результат.Вставить("limit_bytes", Цел(ПределБайт));
	Результат.Вставить("actual_bytes", Цел(ФактическиБайт));
	Возврат Результат;

КонецФункции

// Откат раскладки в хранилище: сам он ошибку индексации затирать не должен.
Процедура ПопытатьсяУдалить(Знач Координаты)
	Попытка
		Хранилище.Удалить(Координаты);
	Исключение
	КонецПопытки;
КонецПроцедуры

// Настройки читаются на каждый push: правка лимитов действует сразу, без рестарта.
Функция ТекущиеОграничения()
	Возврат ПостроитьОграничения(
		Настройки.Значение("oshub.publish.max_unpacked_bytes"),
		Настройки.Значение("oshub.publish.max_files"),
		Настройки.Значение("oshub.publish.max_manifest_bytes"));
КонецФункции

// Дефолтные лимиты ospx-tools (256 МБ, 10000 файлов) на публичном push-эндпоинте слишком щедры.
Функция ПостроитьОграничения(Знач ОбщийРазмер, Знач КоличествоФайлов, Знач РазмерМанифеста)
	Возврат ПакетыOspx.НовыеОграничения()
		.УстановитьМаксимальныйОбщийРазмер(ОбщийРазмер)
		.УстановитьМаксимальноеКоличествоФайлов(КоличествоФайлов)
		.УстановитьМаксимальнуюГлубинуПутей(24)
		.УстановитьМаксимальныйРазмерМанифеста(РазмерМанифеста)
		.УстановитьМаксимальныйРазмерREADME(1024 * 1024)
		.УстановитьМаксимальнуюТранзиторнуюЗапись(ОбщийРазмер);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "ПриёмВерсии") _Приём,
	&Пластилин(Значение = "СервисМетокВерсий") _СервисМеток,
	&Пластилин(Значение = "ПравилаИменования") _Правила,
	&Пластилин(Значение = "ХранилищеАртефактов") _Хранилище,
	&Пластилин(Значение = "ЗаписьЗанятогоМеста") _Занятое,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ГвардКлюча") _ГвардКлюча,
	&Пластилин(Значение = "СервисПравДоступа") _СервисПравДоступа,
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ИмяОбъектаАудита") _Имена,
	&Пластилин(Значение = "СобытиеАудита") _Событие,
	&Пластилин(Значение = "СервисВходящих") _Входящие = Неопределено,
	&Пластилин(Значение = "СервисДоверияCI") _ДовериеКонвейеров = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Пластилин(Значение = "ТихаяУборка") _Уборка = Неопределено,
	&Пластилин(Значение = "ПриведениеФлагов") _Флаги = Неопределено)

	Уборка = ?(_Уборка = Неопределено, Новый ТихаяУборка(), _Уборка);
	СобытиеЖурнала = _Событие;
	Флаги = ?(_Флаги = Неопределено, Новый ПриведениеФлагов(), _Флаги);
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	СервисПулов = _СервисПулов;
	ИменаЖурнала = _Имена;
	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;
	Приём = _Приём;
	СервисМеток = _СервисМеток;
	Правила = _Правила;
	Хранилище = _Хранилище;
	Занятое = _Занятое;
	Место = Новый МестоВПуле(_СервисПулов);
	СервисПрав = _СервисПрав;
	ГвардКлюча = _ГвардКлюча;
	СервисПравДоступа = _СервисПравДоступа;
	Издатель = _Издатель;
	Настройки = _Настройки;
	// очередь заявок и доверенные конвейеры опциональны, и это безопасная сторона:
	// несобранный желудь означает «пути нет» (403), а не «путь открыт всем»
	Входящие = _Входящие;
	ДовериеКонвейеров = _ДовериеКонвейеров;
	// второй вход для лога: инъекция &Лог в ПОЛЕ доезжает только до желудей, собранных
	// контейнером, а при прямом создании первая же запись падает «Value is not of object type»
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
