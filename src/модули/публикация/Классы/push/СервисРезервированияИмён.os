// Резервирование имён пакетов: мейнтейнер пула заводит пакет-плейсхолдер и сразу выдаёт
// на него роль будущему издателю. Снимается только пустой плейсхолдер.

Перем СервисПакетов;      // СервисПакетов
Перем СервисПулов;        // СервисПулов — принимает ли пул публикации
Перем СервисВерсий;       // СервисВерсий
Перем ХранилищеВерсий;    // ХранилищеВерсийПакета (данные) — версии списка пакетов одним отбором
Перем СервисПрав;         // СервисПрав (auth)
Перем СервисПравДоступа;  // СервисПравДоступа (auth)
Перем Правила;            // ПравилаИменования
Перем ГвардКлюча;         // ГвардКлюча (auth), может быть Неопределено
Перем Ошибки;      // ТекстОшибки (основа)
Перем УчёткиПринципалов;  // УчёткаПринципала (права) — учётка за принципалом

#Область ПубличныйИнтерфейс

// Резервирует имя пакета в пуле: создаёт пакет-плейсхолдер и, если заданы субъект и роль,
// сразу выдаёт роль на него. Провал выдачи роли откатывает резерв целиком.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  Пул - Пул, Неопределено - пул резерва.
//  ИмяПакета - Строка - резервируемое имя.
//  ТипСубъекта - Строка - пользователь либо группа, "" — роль не выдавать (необязательный,
//                по умолчанию "").
//  СубъектИд - Число - идентификатор субъекта роли (необязательный, по умолчанию 0).
//  Роль - Строка - читатель, райтер или мейнтейнер, "" — роль не выдавать
//         (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число: 201 создано, 400/401/403/404/409 отказ),
//              Сообщение (Строка), Пакет (Пакет либо отсутствует при отказе).
//
Функция Зарезервировать(Знач Принципал, Знач Пул, Знач ИмяПакета,
	Знач ТипСубъекта = "", Знач СубъектИд = 0, Знач Роль = "") Экспорт

	Перем Пакет;

	Вердикт = Допустить(Принципал, Пул, "создание");
	Если НЕ Вердикт.Успех Тогда
		Возврат Вердикт;
	КонецЕсли;

	// Пул, не принимающий публикации, не должен принимать и резервы: имя оказалось бы
	// занято навсегда — push в него отбивается тем же 409. Признак читается ЖИВОЙ, а не
	// из переданного объекта: тумблер публикации меняют между запросами.
	Если НЕ СервисПулов.ПубликацияРазрешена(СервисПулов.ПулПоИдентификатору(Пул.Идентификатор)) Тогда
		Возврат Отказ(409, СтрШаблон(
			"Пул ""%1"" не принимает публикации: занятое в нём имя останется занятым навсегда,"
			+ " опубликовать в него будет нельзя", Пул.Имя));
	КонецЕсли;

	Норм = СокрЛП(Строка(ИмяПакета));
	Если НЕ Правила.ИмяКорректно(Норм) Тогда
		Возврат Отказ(400, СтрШаблон("Недопустимое имя пакета ""%1""", ИмяПакета));
	КонецЕсли;
	Если Правила.ИмяПакетаЗарезервировано(Норм) Тогда
		Возврат Отказ(400, СтрШаблон(
			"Имя пакета ""%1"" зарезервировано хабом под системный адрес", Норм));
	КонецЕсли;

	Если СервисПакетов.НайтиПакет(Пул.Идентификатор, Норм) <> Неопределено Тогда
		Возврат Отказ(409, СтрШаблон(
			"Имя ""%1"" в пуле ""%2"" уже занято", Норм, Пул.Имя));
	КонецЕсли;

	Пакет = СервисПакетов.ЗарегистрироватьПакет(Пул.Идентификатор, Норм);

	Если ЗначениеЗаполнено(ТипСубъекта) И ЗначениеЗаполнено(Роль) И Цел(СубъектИд) > 0 Тогда
		// выдаём авторизованным контуром, а не системным ЗафиксироватьГрант: тот не
		// спрашивает, вправе ли выдающий, и резерв стал бы способом раздать чужие роли
		Попытка
			СервисПравДоступа.ВыдатьРоль(Вердикт.Пользователь, ТипСубъекта, Цел(СубъектИд),
				СервисПрав.ОбъектПакет(Пакет), Роль);
		Исключение
			// причина снимается ДО отката: вложенная Попытка внутри отката перебила бы её
			Сбой = ИнформацияОбОшибке();
			// откатываем резерв целиком, чтобы имя не осталось занятым «ни за кем»
			Попытка
				Пакет.Удалить();
			Исключение
				// откат best-effort: важнее вернуть внятный отказ
			КонецПопытки;
			Возврат Отказ(403, "Роль на зарезервированное имя не выдана: " + Ошибки.ДляЧеловека(Сбой));
		КонецПопытки;
	КонецЕсли;

	Результат = Успех(201, СтрШаблон(
		"Имя ""%1"" зарезервировано в пуле ""%2"": пакет создан, версий пока нет",
		Пакет.Имя, Пул.Имя));
	Результат.Вставить("Пакет", Пакет);
	Возврат Результат;

КонецФункции

// Снимает резерв: удаляет пустой пакет-плейсхолдер вместе с выданными на него ролями.
// Пакет с версиями — отказ.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  Пул - Пул, Неопределено - пул резерва.
//  ИмяПакета - Строка - имя снимаемого резерва.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка).
//
Функция СнятьРезерв(Знач Принципал, Знач Пул, Знач ИмяПакета) Экспорт

	Вердикт = Допустить(Принципал, Пул, "удаление");
	Если НЕ Вердикт.Успех Тогда
		Возврат Вердикт;
	КонецЕсли;

	Пакет = СервисПакетов.НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Если Пакет = Неопределено Тогда
		Возврат Отказ(404, СтрШаблон("Имя ""%1"" в пуле ""%2"" не зарезервировано",
			ИмяПакета, Пул.Имя));
	КонецЕсли;

	Если СервисВерсий.ВерсииПакета(Пакет.Идентификатор).Количество() > 0 Тогда
		Возврат Отказ(409, СтрШаблон(
			"Пакет ""%1"" уже имеет опубликованные версии: это не резерв имени, и снятием"
			+ " резерва он не удаляется", Пакет.Имя));
	КонецЕсли;

	// роли снимаем вместе с плейсхолдером: иначе следующий владелец имени унаследует их
	Для Каждого Грант Из СервисПравДоступа.ГрантыНаОбъект(СервисПрав.ОбъектПакет(Пакет)) Цикл
		Грант.Удалить();
	КонецЦикла;
	Пакет.Удалить();

	Возврат Успех(200, СтрШаблон("Резерв имени ""%1"" в пуле ""%2"" снят", ИмяПакета, Пул.Имя));

КонецФункции

// Возвращает зарезервированные имена пула — пакеты без единой версии.
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Массив из Пакет - пустые пакеты-плейсхолдеры.
//
Функция Резервы(Знач Пул) Экспорт

	Результат = Новый Массив();
	Если Пул = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	// два отбора на весь раздел вместо запроса версий на каждый пакет: иначе «Резерв имён»
	// открывался тем дольше, чем больше в пуле пакетов, даже когда резервов нет ни одного
	Пакеты = СервисПакетов.ПакетыПула(Пул.Идентификатор);
	Идентификаторы = Новый Массив();
	Для Каждого Пакет Из Пакеты Цикл
		Идентификаторы.Добавить(Пакет.Идентификатор);
	КонецЦикла;

	СВерсиями = Новый Соответствие();
	Для Каждого Версия Из ХранилищеВерсий.ВерсииПакетов(Идентификаторы) Цикл
		СВерсиями.Вставить(Версия.ПакетИдентификатор, Истина);
	КонецЦикла;

	Для Каждого Пакет Из Пакеты Цикл
		Если СВерсиями.Получить(Пакет.Идентификатор) = Неопределено Тогда
			Результат.Добавить(Пакет);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Общий пролог обеих операций; доступ даёт только последняя строка.
Функция Допустить(Знач Принципал, Знач Пул, Знач Действие)

	Если Пул = Неопределено Тогда
		Возврат Отказ(404, "Пул не найден");
	КонецЕсли;

	// рамки ключа — ДО прав человека: код ответа не должен зависеть от того, что ключ
	// узнал сверх своих рамок
	Если ГвардКлюча = Неопределено Тогда
		Возврат Отказ(403, "Резервирование имени недоступно: гейт ключа доступа не собран");
	КонецЕсли;
	ВердиктКлюча = ГвардКлюча.Пропустить(Принципал, Действие, Пул.Идентификатор);
	Если НЕ ВердиктКлюча.Разрешено Тогда
		Возврат Отказ(403, "Резервирование имени запрещено ключом доступа: "
			+ ГвардКлюча.ОписаниеПричины(ВердиктКлюча.Причина));
	КонецЕсли;

	Пользователь = УчёткиПринципалов.Пользователь(Принципал);
	Если Пользователь = Неопределено Тогда
		Возврат Отказ(401, "Требуется аутентификация");
	КонецЕсли;

	Если НЕ СервисПрав.РольНеНиже(Пользователь, СервисПрав.ОбъектПул(Пул),
		СервисПрав.РольМейнтейнер()) Тогда
		Возврат Отказ(403, СтрШаблон(
			"Имена в пуле ""%1"" резервируют его мейнтейнеры и выше", Пул.Имя));
	КонецЕсли;

	Результат = Успех(200, "");
	Результат.Вставить("Пользователь", Пользователь);
	Возврат Результат;

КонецФункции

Функция Успех(Знач Код, Знач Сообщение)
	Возврат Новый Структура("Успех, Код, Сообщение", Истина, Код, Сообщение);
КонецФункции

Функция Отказ(Знач Код, Знач Сообщение)
	Возврат Новый Структура("Успех, Код, Сообщение", Ложь, Код, Сообщение);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "ХранилищеВерсийПакета") _ХранилищеВерсий,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисПравДоступа") _СервисПравДоступа,
	&Пластилин(Значение = "ПравилаИменования") _Правила,
	&Пластилин(Значение = "УчёткаПринципала") _УчёткиПринципалов,
	&Пластилин(Значение = "ГвардКлюча") _ГвардКлюча = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	СервисПакетов = _СервисПакетов;
	СервисПулов = _СервисПулов;
	СервисВерсий = _СервисВерсий;
	ХранилищеВерсий = _ХранилищеВерсий;
	СервисПрав = _СервисПрав;
	СервисПравДоступа = _СервисПравДоступа;
	Правила = _Правила;
	УчёткиПринципалов = _УчёткиПринципалов;
	ГвардКлюча = _ГвардКлюча;

КонецПроцедуры
