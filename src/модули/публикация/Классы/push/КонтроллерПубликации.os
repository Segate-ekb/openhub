// Тонкий контроллер push: разбирает сырое тело, заголовки и принципала, форматирует ответ;
// доменная логика — в СервисПубликации. Совместим с немодифицированным opm 1.4.1.

#Использовать errors

Перем СервисПубликации;  // СервисПубликации
Перем Перехватчик;       // ПерехватчикАутентификации (вход)
Перем СервисПулов;       // СервисПулов (реестр) - основной пул для алиаса /push
Перем ПустыеКуки;        // Куки (winow)
Перем Обезличивание;     // ОбезличиваниеЖурнала (наблюдаемость)
Перем Заголовки;         // ЗаголовкиHTTP (основа)
Перем Ошибки;      // ТекстОшибки (основа)
Перем ТекстыJSON;        // ТекстJSON (основа) — тело ответа opm
Перем Числа;             // ПриведениеЧисел (основа) — длина тела из Content-Length
&Лог
Перем Лог;

#Область ТочкиМаршрута

// Публикация пакета в пул протоколом opm.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//  Пул - Строка - имя целевого пула из адреса.
//  МетодЗапроса - Строка - HTTP-метод.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  ТелоЗапросаПоток - Поток - тело .ospx потоком; в память целиком не читается.
//  force - Строка - параметр адреса «?force=1»: заменить уже опубликованный номер целиком
//          (необязательный, по умолчанию "" — обычная публикация).
//
&ТочкаМаршрута("api/v1/pools/{Пул}/push", Метод = "post, put")
&Группа("Публикация", Описание = "Публикация `.ospx`: тело — файл, `FILE-NAME` — `<имя>-<версия>.ospx`
	|по манифесту; вход — ключ доступа или id-token доверенного конвейера.")
&Операция(Сводка = "Публикация в пул протоколом opm push",
	Описание = "Протокол `opm push`, POST или PUT. Ответ — JSON в форме opm `{КодСостояние, Сообщение}`,
	|без конверта `{error}`.")
&Возвращает(Код = 200, Описание = "Номер переиздан")
&Возвращает(Код = 201, Описание = "Версия опубликована")
&Возвращает(Код = 202, Описание = "Заявка во «входящих», версии ещё нет")
&Возвращает(Код = 400, Описание = "Файл, его имя или манифест не приняты")
&Возвращает(Код = 401, Описание = "Нет ключа")
&Возвращает(Код = 403, Описание = "Нет права, конвейер не доверен либо ключ не даёт создания")
&Возвращает(Код = 405, Описание = "Глагол не POST и не PUT")
&Возвращает(Код = 409, Описание = "Номер занят, имя заявлено либо пул закрыт для публикаций")
&Возвращает(Код = 413, Описание = "Артефакт больше предела хаба")
&Возвращает(Код = 429, Описание = "Предел незакрытых заявок")
&Возвращает(Код = 500, Описание = "Сбой публикации")
&Возвращает(Код = 507, Описание = "Квота пула исчерпана")
&Возвращает(Код = 404, Описание = "Пула нет")
Процедура ПушВПул(Ответ, Пул, МетодЗапроса, ЗаголовкиЗапроса, ТелоЗапросаПоток,
	force = "") Экспорт
	Публиковать(Ответ, Пул, МетодЗапроса, ЗаголовкиЗапроса, ТелоЗапросаПоток, force);
КонецПроцедуры

#КонецОбласти

#Область ВечныеАлиасы

// Адреса ниже прописаны у пользователей в opm.cfg и не снимаются никогда.

// Вечный алиас: публикация в основной пул.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//  МетодЗапроса - Строка - HTTP-метод.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  ТелоЗапросаПоток - Поток - тело .ospx потоком; в память целиком не читается.
//  force - Строка - параметр адреса «?force=1» (необязательный, по умолчанию "").
//
&ТочкаМаршрута("/push")
Процедура АлиасПушПоУмолчанию(Ответ, МетодЗапроса, ЗаголовкиЗапроса, ТелоЗапросаПоток,
	force = "") Экспорт

	ИмяПула = СервисПулов.ИмяПулаПоУмолчанию();
	Если НЕ ЗначениеЗаполнено(ИмяПула) Тогда
		Ответ.Куки = ПустыеКуки;
		ОтправитьРезультат(Ответ, 404,
			"Основной пул хаба не назначен: публиковать без указания пула некуда."
			+ " Назначьте основной пул в настройках хаба (/hub/settings/pools) либо"
			+ " публикуйте в конкретный пул — /api/v1/pools/{пул}/push");
		Возврат;
	КонецЕсли;

	Публиковать(Ответ, ИмяПула, МетодЗапроса, ЗаголовкиЗапроса, ТелоЗапросаПоток, force);

КонецПроцедуры

// Вечный алиас: публикация в пул.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//  Пул - Строка - имя целевого пула из адреса.
//  МетодЗапроса - Строка - HTTP-метод.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  ТелоЗапросаПоток - Поток - тело .ospx потоком; в память целиком не читается.
//  force - Строка - параметр адреса «?force=1» (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{Пул}/push")
Процедура АлиасПушВПул(Ответ, Пул, МетодЗапроса, ЗаголовкиЗапроса, ТелоЗапросаПоток,
	force = "") Экспорт
	Публиковать(Ответ, Пул, МетодЗапроса, ЗаголовкиЗапроса, ТелоЗапросаПоток, force);
КонецПроцедуры

#КонецОбласти

#Область ОбщаяЛогика

Процедура Публиковать(Ответ, Знач ИмяПула, Знач МетодЗапроса, Знач ЗаголовкиЗапроса, Знач Тело,
	Знач ФлагФорса)

	Ответ.Куки = ПустыеКуки;

	Если НЕ ЭтоПушМетод(МетодЗапроса) Тогда
		Ответ.Заголовки["Allow"] = "POST, PUT";
		ОтправитьРезультат(Ответ, 405, СтрШаблон("Метод %1 не разрешён: используйте POST или PUT", МетодЗапроса));
		Возврат;
	КонецЕсли;

	ИмяФайла = Заголовки.Значение(ЗаголовкиЗапроса, "FILE-NAME");
	Канал = Заголовки.Значение(ЗаголовкиЗапроса, "CHANNEL");
	ЗаявленныйРазмер = Числа.ЦелоеИлиНеопределено(Заголовки.Значение(ЗаголовкиЗапроса, "Content-Length"));
	Токен = Перехватчик.ИзвлечьТокен(ЗаголовкиЗапроса);

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, Неопределено);

	Форсировать = СервисПубликации.ЭтоФорс(ФлагФорса);

	// Токен в журнал не попадает — только факт его наличия.
	Лог.Отладка("Публикация: пул ""%1"", файл ""%2"", канал ""%3"", токен %4, форс %5",
		ИмяПула, ИмяФайла, Канал, Обезличивание.Секрет(Токен), Форсировать);

	Попытка
		Результат = СервисПубликации.Опубликовать(
			ИмяПула, Тело, ?(ИмяФайла = Неопределено, "", Строка(ИмяФайла)),
			?(Канал = Неопределено, "", Строка(Канал)), Принципал.Пользователь, Токен,
			Принципал, Форсировать, ЗаявленныйРазмер);
	Исключение
		ОтветитьНаСбойПубликации(Ответ, ИнформацияОбОшибке(), ИмяПула);
		Возврат;
	КонецПопытки;

	// веха здесь — только отказ: принятое называет служба публикации, заявку во «входящие» — сами входящие
	Если Результат.Успех Тогда
		Лог.Отладка("Публикация в пул ""%1"": ответ %2 — %3",
			ИмяПула, Результат.Код, Результат.Сообщение);
	Иначе
		Лог.Информация("Публикация в пул ""%1"" отклонена: файл ""%2"", код %3 — %4",
			ИмяПула, ?(ИмяФайла = Неопределено, "", ИмяФайла), Результат.Код, Результат.Сообщение);
	КонецЕсли;

	ОтправитьРезультат(Ответ, Результат.Код, Результат.Сообщение);

КонецПроцедуры

Процедура ОтправитьРезультат(Ответ, Знач Код, Знач Сообщение)

	Данные = Новый Структура();
	Данные.Вставить("КодСостояние", Код);
	Данные.Вставить("Сообщение", Сообщение);

	Тело = ТекстыJSON.СПереносами(Данные);

	Ответ.УстановитьСостояние(Код);
	Ответ.Заголовки["Content-Type"] = "application/json; charset=utf-8";
	Ответ.Заголовки["Content-Length"] = Формат(ПолучитьДвоичныеДанныеИзСтроки(Тело).Размер(), "ЧГ=0; ЧН=0");
	Ответ.ТелоТекст = Тело;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоПушМетод(Знач МетодЗапроса)
	М = ВРег(Строка(МетодЗапроса));
	Возврат М = "POST" ИЛИ М = "PUT";
КонецФункции

// Консоли opm — фраза без внутренностей хаба, журналу — причина и цепочка на отладке.
Процедура ОтветитьНаСбойПубликации(Ответ, Знач Сбой, Знач ИмяПула)

	Лог.Ошибка("Публикация в пул ""%1"" сорвалась исключением: %2", ИмяПула, Ошибки.Причина(Сбой));
	// отчёт стои́т разбора цепочки: собираем его только тогда, когда отладку включили
	Если Лог.Уровень() <= УровниЛога.Отладка Тогда
		Лог.Отладка("Публикация в пул ""%1"" сорвалась, разбор целиком:%2%3",
			ИмяПула, Символы.ПС, Ошибки.ПодробныйОтчёт(Сбой));
	КонецЕсли;

	ОтправитьРезультат(Ответ, 500, "Внутренняя ошибка публикации: " + Ошибки.ДляЧеловека(Сбой));

КонецПроцедуры

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПубликации") _СервисПубликации,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "Куки") _ПустыеКуки,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ЗаголовкиHTTP") _Заголовки = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Пластилин(Значение = "ТекстJSON") _ТекстыJSON = Неопределено,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	ТекстыJSON = ?(_ТекстыJSON = Неопределено, Новый ТекстJSON(), _ТекстыJSON);
	Числа = ?(_Числа = Неопределено, Новый ПриведениеЧисел(), _Числа);
	СервисПубликации = _СервисПубликации;
	Перехватчик = _Перехватчик;
	ПустыеКуки = _ПустыеКуки;
	СервисПулов = _СервисПулов;
	Заголовки = ?(_Заголовки = Неопределено, Новый ЗаголовкиHTTP(), _Заголовки);
	Обезличивание = Новый ОбезличиваниеЖурнала();

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
