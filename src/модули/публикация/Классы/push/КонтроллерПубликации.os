// Тонкий контроллер push: разбирает сырое тело, заголовки и принципала, форматирует
// ответ; доменная логика — в СервисПубликации. Совместим с немодифицированным opm 1.4.1:
// сырое бинарное тело .ospx без Content-Type, метаданные в FILE-NAME/CHANNEL, авторизация
// в OAUTH-TOKEN или Authorization, ответ — JSON старого формата {КодСостояние, Сообщение}.
// Канонический адрес — /api/v1/pools/{пул}/push; беспрефиксные /push и /pools/{пул}/push
// остаются вечными алиасами: они прописаны у пользователей в opm.cfg.
//
// Питфолы winow: литеральные маршруты пишутся с ведущим "/", маршруты с {параметрами} —
// без него, иначе индексы сегментов расходятся; метод роутером не различается;
// Content-Length в native-режиме ставится вручную.

Перем СервисПубликации;  // СервисПубликации
Перем Перехватчик;       // ПерехватчикАутентификации (auth)
Перем СервисПулов;       // СервисПулов (реестр) - основной пул для алиаса /push
Перем ПустыеКуки;        // Куки (winow)
Перем Обезличивание;     // ОбезличиваниеЖурнала (наблюдаемость)
&Лог
Перем Лог;

#Область ТочкиМаршрута

// POST|PUT /api/v1/pools/{Пул}/push — публикует пакет в указанный пул. Это значение
// РесурсПубликацииПакетов в opm.cfg. Прочие методы — 405.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//  Пул - Строка - имя целевого пула из адреса.
//  МетодЗапроса - Строка - HTTP-метод.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  ТелоЗапросаДвоичныеДанные - ДвоичныеДанные - сырые байты .ospx.
//
&ТочкаМаршрута("api/v1/pools/{Пул}/push")
Процедура ПушВПул(Ответ, Пул, МетодЗапроса, ЗаголовкиЗапроса, ТелоЗапросаДвоичныеДанные) Экспорт
	Публиковать(Ответ, Пул, МетодЗапроса, ЗаголовкиЗапроса, ТелоЗапросаДвоичныеДанные);
КонецПроцедуры

#КонецОбласти

#Область ВечныеАлиасы

// Адреса ниже прописаны у пользователей в opm.cfg и не снимаются никогда.

// POST|PUT /push — алиас публикации в пул по умолчанию.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//  МетодЗапроса - Строка - HTTP-метод.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  ТелоЗапросаДвоичныеДанные - ДвоичныеДанные - сырые байты .ospx.
//
&ТочкаМаршрута("/push")
Процедура АлиасПушПоУмолчанию(Ответ, МетодЗапроса, ЗаголовкиЗапроса, ТелоЗапросаДвоичныеДанные) Экспорт

	ИмяПула = СервисПулов.ИмяПулаПоУмолчанию();
	Если НЕ ЗначениеЗаполнено(ИмяПула) Тогда
		Ответ.Куки = ПустыеКуки;
		ОтправитьРезультат(Ответ, 404,
			"Основной пул хаба не назначен: публиковать без указания пула некуда."
			+ " Назначьте основной пул в настройках хаба (/hub/settings/pools) либо"
			+ " публикуйте в конкретный пул — /api/v1/pools/{пул}/push");
		Возврат;
	КонецЕсли;

	Публиковать(Ответ, ИмяПула, МетодЗапроса, ЗаголовкиЗапроса, ТелоЗапросаДвоичныеДанные);

КонецПроцедуры

// POST|PUT /pools/{Пул}/push — алиас публикации в указанный пул.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//  Пул - Строка - имя целевого пула из адреса.
//  МетодЗапроса - Строка - HTTP-метод.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  ТелоЗапросаДвоичныеДанные - ДвоичныеДанные - сырые байты .ospx.
//
&ТочкаМаршрута("pools/{Пул}/push")
Процедура АлиасПушВПул(Ответ, Пул, МетодЗапроса, ЗаголовкиЗапроса, ТелоЗапросаДвоичныеДанные) Экспорт
	Публиковать(Ответ, Пул, МетодЗапроса, ЗаголовкиЗапроса, ТелоЗапросаДвоичныеДанные);
КонецПроцедуры

#КонецОбласти

#Область ОбщаяЛогика

Процедура Публиковать(Ответ, Знач ИмяПула, Знач МетодЗапроса, Знач ЗаголовкиЗапроса, Знач Тело)

	Ответ.Куки = ПустыеКуки;

	Если НЕ ЭтоПушМетод(МетодЗапроса) Тогда
		Ответ.Заголовки["Allow"] = "POST, PUT";
		ОтправитьРезультат(Ответ, 405, СтрШаблон("Метод %1 не разрешён: используйте POST или PUT", МетодЗапроса));
		Возврат;
	КонецЕсли;

	ИмяФайла = Заголовок(ЗаголовкиЗапроса, "FILE-NAME");
	Канал = Заголовок(ЗаголовкиЗапроса, "CHANNEL");
	Токен = ИзвлечьТокен(ЗаголовкиЗапроса);

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, Неопределено);

	// Токен в журнал не попадает — только факт его наличия.
	Лог.Отладка("Публикация: пул ""%1"", файл ""%2"", канал ""%3"", тело %4 байт, токен %5",
		ИмяПула, ИмяФайла, Канал, РазмерТела(Тело), Обезличивание.Секрет(Токен));

	Попытка
		Результат = СервисПубликации.Опубликовать(
			ИмяПула, Тело, ?(ИмяФайла = Неопределено, "", Строка(ИмяФайла)),
			?(Канал = Неопределено, "", Строка(Канал)), Принципал.Пользователь, Токен,
			Принципал);
	Исключение
		Описание = КраткоеОписаниеОшибки();
		Лог.Ошибка("Публикация в пул ""%1"" сорвалась исключением: %2", ИмяПула, Описание);
		ОтправитьРезультат(Ответ, 500, "Внутренняя ошибка публикации: " + Описание);
		Возврат;
	КонецПопытки;

	Лог.Отладка("Публикация в пул ""%1"": ответ %2 — %3",
		ИмяПула, Результат.Код, Результат.Сообщение);

	ОтправитьРезультат(Ответ, Результат.Код, Результат.Сообщение);

КонецПроцедуры

Процедура ОтправитьРезультат(Ответ, Знач Код, Знач Сообщение)

	Данные = Новый Структура();
	Данные.Вставить("КодСостояние", Код);
	Данные.Вставить("Сообщение", Сообщение);

	Запись = Новый ЗаписьJSON();
	Параметры = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "    ");
	Запись.УстановитьСтроку(Параметры);
	ЗаписатьJSON(Запись, Данные);
	Тело = Запись.Закрыть();

	Ответ.УстановитьСостояние(Код);
	Ответ.Заголовки["Content-Type"] = "application/json; charset=utf-8";
	Ответ.Заголовки["Content-Length"] = Формат(ПолучитьДвоичныеДанныеИзСтроки(Тело).Размер(), "ЧГ=0; ЧН=0");
	Ответ.ТелоТекст = Тело;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоПушМетод(Знач МетодЗапроса)
	М = ВРег(Строка(МетодЗапроса));
	Возврат М = "POST" ИЛИ М = "PUT";
КонецФункции

// "Authorization: Bearer X" либо "OAUTH-TOKEN: X".
Функция ИзвлечьТокен(Знач ЗаголовкиЗапроса)

	Авторизация = Заголовок(ЗаголовкиЗапроса, "Authorization");
	Если ЗначениеЗаполнено(Авторизация) Тогда
		ЗначениеАвт = СокрЛП(Строка(Авторизация));
		Если СтрНачинаетсяС(ВРег(ЗначениеАвт), "BEARER ") Тогда
			Возврат СокрЛП(Сред(ЗначениеАвт, 8));
		КонецЕсли;
	КонецЕсли;

	OAuth = Заголовок(ЗаголовкиЗапроса, "OAUTH-TOKEN");
	Если ЗначениеЗаполнено(OAuth) Тогда
		Возврат СокрЛП(Строка(OAuth));
	КонецЕсли;

	Возврат "";

КонецФункции

Функция Заголовок(Знач ЗаголовкиЗапроса, Знач Имя)
	Если ЗаголовкиЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИскомыйКлюч = ВРег(Имя);
	Для Каждого КиЗ Из ЗаголовкиЗапроса Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = ИскомыйКлюч Тогда
			Возврат КиЗ.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция КраткоеОписаниеОшибки()
	Возврат СтрЗаменить(СтрЗаменить(ОписаниеОшибки(), Символы.ПС, " "), Символы.ВК, "");
КонецФункции

Функция РазмерТела(Знач Тело)
	Возврат ?(Тело = Неопределено, 0, Тело.Размер());
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПубликации") _СервисПубликации,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "Куки") _ПустыеКуки,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Лог _Лог = Неопределено)

	СервисПубликации = _СервисПубликации;
	Перехватчик = _Перехватчик;
	ПустыеКуки = _ПустыеКуки;
	СервисПулов = _СервисПулов;
	Обезличивание = Новый ОбезличиваниеЖурнала();

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
