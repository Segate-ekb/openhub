// Помещается ли публикация в пул: квота — предел, и вышедшая за него публикация отвергается
// до записи артефакта. Занятое — всё, что лежит в области пула, включая кэш прокси.

Перем СервисПулов;   // СервисПулов (реестр)
Перем Вместимость;   // ВместимостьКвоты (хранилище) — правило «влезает ли новое в предел»
Перем Вердикты;      // Вердикт (основа) — форма ответа
Перем Числа;         // ПриведениеЧисел (основа) — терпимое чтение размера записи

#Область ПубличныйИнтерфейс

// Причина отказа по квоте либо Неопределено, если публикация помещается.
// Перезапись кладёт артефакт на место прежнего, поэтому в зачёт идёт приращение.
//
// Параметры:
//  Пул - Пул - пул публикации.
//  РазмерЗагрузки - Число - размер принимаемого артефакта, байты.
//  Заменяемая - ВерсияПакета, Неопределено - запись, которую кладут на место новой.
//
// Возвращаемое значение:
//  Структура, Неопределено - Успех (Ложь), Код (507), Сообщение (Строка),
//                            Подробности (Структура: pool, limit, limit_bytes,
//                            used_bytes, actual_bytes).
//
Функция ПричинаОтказа(Знач Пул, Знач РазмерЗагрузки, Знач Заменяемая) Экспорт

	КвотаБайт = СервисПулов.ЭффективнаяКвотаБайт(Пул);
	Занято = СервисПулов.ЗанятоБайт(Пул);
	Если Вместимость.Помещается(Занято, РазмерЗаписи(Заменяемая),
		РазмерЗагрузки, КвотаБайт) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Вердикты.ОтказСКодом(Код(), СтрШаблон(
		"Квота пула ""%1"" исчерпана: занято %2 из %3 байт, публикация размером %4 байт"
		+ " в неё не помещается. Занятое — это ВСЁ, что лежит в пуле:"
		+ " свои пакеты, кэш прокси и зеркалированное. Освободите место, удалив ненужные"
		+ " пакеты (отзыв версии места не освобождает: артефакт остаётся в хранилище);"
		+ " место, занятое кэшем прокси, возвращает плановая уборка кэша. Либо попросите"
		+ " администратора хаба увеличить квоту пула",
		Пул.Имя, Формат(Занято, "ЧГ=0; ЧН=0"), Формат(КвотаБайт, "ЧГ=0; ЧН=0"),
		Формат(Цел(РазмерЗагрузки), "ЧГ=0; ЧН=0")),
		Новый Структура("Подробности", ПодробностиКвоты(Пул, КвотаБайт, Занято, РазмерЗагрузки)));

КонецФункции

// 507 Insufficient Storage: место кончилось у пула, а не у запроса, и повтор без
// освобождения места смысла не имеет.
//
// Возвращаемое значение:
//  Число - код ответа.
//
Функция Код() Экспорт
	Возврат 507;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Размер артефакта записи числом: незаполненный, нечисло и отрицательное дают ноль.
// Замена кладёт артефакт на место прежнего, и этот размер в зачёт квоты не идёт.
Функция РазмерЗаписи(Знач Заменяемая)
	Возврат ?(Заменяемая = Неопределено, 0, Макс(0, Числа.ЧислоИлиНоль(Заменяемая.Размер)));
КонецФункции

// Скрипту конвейера — те же числа полями: какой предел, каким он числом и каким числом
// не пройден.
Функция ПодробностиКвоты(Знач Пул, Знач КвотаБайт, Знач Занято, Знач РазмерЗагрузки)

	Результат = Новый Структура();
	Результат.Вставить("pool", Строка(Пул.Имя));
	Результат.Вставить("limit", "pool_quota_bytes");
	Результат.Вставить("limit_bytes", Цел(КвотаБайт));
	Результат.Вставить("used_bytes", Макс(0, Цел(Занято)));
	Результат.Вставить("actual_bytes", Цел(РазмерЗагрузки));
	Возврат Результат;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач _СервисПулов)
	СервисПулов = _СервисПулов;
	Вместимость = Новый ВместимостьКвоты();
	Вердикты = Новый Вердикт();
	Числа = Новый ПриведениеЧисел();
КонецПроцедуры
