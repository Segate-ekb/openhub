// Реализация АвтовыдачаПравGitHub: у кого есть push в репозиторий организации-зеркала,
// тот получает роль мейнтейнера на одноимённом пакете основного пула.

Перем Фон;                    // ЗапускВФоне (публикация) - снимает раздачу с потока входа
Перем ХранилищеПользователей; // ХранилищеПользователей (данные)
Перем СервисПулов;            // СервисПулов (реестр) - основной пул хаба
Перем СервисПакетов;          // СервисПакетов (реестр) - поиск по имени
Перем Правила;                // ПравилаИменования (реестр) - что вообще может быть именем
Перем СервисПрав;             // СервисПрав (auth) - роли и эффективные права
Перем СервисПравДоступа;      // СервисПравДоступа (auth) - системная фиксация гранта
Перем Каталог;                // КаталогРепозиториевGitHub (auth)
Перем Настройки;              // СервисНастроек (настройки); опционален
Перем Ошибки;                 // ТекстОшибки (основа) — маска секрета одна на хаб
&Лог
Перем Лог;

// Ставит раздачу прав в фон и возвращается немедленно: ни GitHub, ни выдача прав
// вызывающего не задерживают. Реализация контракта АвтовыдачаПравGitHub.
//
// Параметры:
//  ПользовательИдентификатор - Число - получатель прав.
//  ЛогинGitHub - Строка - логин получателя у провайдера.
//  Токен - Строка - access-token GitHub; живёт только в памяти задания.
//
Процедура Раздать(Знач ПользовательИдентификатор, Знач ЛогинGitHub, Знач Токен) Экспорт

	// Вход человека не должен падать из-за раздачи прав ни при каком стечении
	// обстоятельств — отсюда наружу не летит ничего, даже отказ постановки в фон.
	Попытка
		Фон.Запустить(Новый ЗаданиеРаздачиПравGitHub(ЭтотОбъект, ПользовательИдентификатор,
			ЛогинGitHub, Токен));
	Исключение
		Пожаловаться(ЛогинGitHub, БезТокена(ОписаниеОшибки(), Токен));
	КонецПопытки;

КонецПроцедуры

// Раздача, уже снятая с потока входа: её зовёт фоновое задание. Наружу не бросает —
// исход задания не смотрит никто, поэтому свой сбой она обязана записать сама.
//
// Параметры:
//  ПользовательИдентификатор - Число - получатель прав.
//  ЛогинGitHub - Строка - логин получателя у провайдера.
//  Токен - Строка - access-token GitHub.
//
Процедура РаздатьСейчас(Знач ПользовательИдентификатор, Знач ЛогинGitHub, Знач Токен) Экспорт

	Попытка
		РаздатьПоРепозиториям(ПользовательИдентификатор, ЛогинGitHub, Токен);
	Исключение
		Пожаловаться(ЛогинGitHub, БезТокена(ОписаниеОшибки(), Токен));
	КонецПопытки;

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура РаздатьПоРепозиториям(Знач ПользовательИдентификатор, Знач ЛогинGitHub, Знач Токен)

	// порядок значим: с выключенной опцией в сеть не ходим вовсе
	Если НЕ ЛегасиВключён() Тогда
		ОбъяснитьПропуск(ЛогинGitHub, "legacy_option_off");
		Возврат;
	КонецЕсли;

	// защита от будущего вызывающего: сегодня пустой токен отсекает СервисАвтопривязки
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		ОбъяснитьПропуск(ЛогинGitHub, "no_github_token");
		Возврат;
	КонецЕсли;

	Пул = СервисПулов.ДефолтныйПул();
	Если Пул = Неопределено Тогда
		ОбъяснитьПропуск(ЛогинGitHub, "no_default_pool");
		Возврат;
	КонецЕсли;

	Пользователь = ХранилищеПользователей.ПолучитьОдноПоИдентификаторРавно(Цел(ПользовательИдентификатор));
	// заблокированная учётка права не набирает: вход ей всё равно закрыт, а выданные
	// гранты пережили бы блокировку и ожили при разблокировке
	Если Пользователь = Неопределено ИЛИ Пользователь.Активен <> Истина Тогда
		ОбъяснитьПропуск(ЛогинGitHub, "user_missing_or_inactive");
		Возврат;
	КонецЕсли;

	Найденные = Репозитории(Токен, ЛогинGitHub);
	Выдано = Выдать(Пользователь, Пул, Найденные, ЛогинGitHub);
	Отчитаться(ЛогинGitHub, Найденные.Количество(), Выдано);

КонецПроцедуры

// Число новых прав мейнтейнера, заведённых по найденным репозиториям.
Функция Выдать(Знач Пользователь, Знач Пул, Знач Найденные, Знач ЛогинGitHub)

	Роль = СервисПрав.РольМейнтейнер();
	Набор = СервисПрав.НаборРоли(Роль);
	КемВыдано = Принципал(ЛогинGitHub);
	Выдано = 0;

	// идём по найденным репозиториям, а не по пакетам пула: репозиториев единицы,
	// пакетов основного пула — сотни
	Для Каждого ИмяРепозитория Из Найденные Цикл

		Пакет = НайтиПакет(Пул, Строка(ИмяРепозитория));
		Если Пакет = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Объект = СервисПрав.ОбъектПакет(Пакет);
		// ЗафиксироватьГрант перезаписывает набор действий целиком, поэтому уже имеющееся
		// право проверяется до записи: иначе автоматика понизила бы владельца пакета,
		// назначенного руками, до мейнтейнера
		Если СервисПрав.РольНеНиже(Пользователь, Объект, Роль) Тогда
			Продолжить;
		КонецЕсли;

		СервисПравДоступа.ЗафиксироватьГрант("пользователь", Пользователь.Идентификатор,
			Объект, Набор, 0, КемВыдано);
		Выдано = Выдано + 1;

	КонецЦикла;

	Возврат Выдано;

КонецФункции

// Имя репозитория GitHub именем пакета быть не обязано: в слой данных уходит только годное.
Функция НайтиПакет(Знач Пул, Знач ИмяРепозитория)

	Если НЕ Правила.ИмяКорректно(ИмяРепозитория) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СервисПакетов.НайтиПакет(Пул.Идентификатор, ИмяРепозитория);

КонецФункции

Функция Репозитории(Знач Токен, Знач ЛогинGitHub)
	Возврат Каталог.РепозиторииСПравомЗаписи(Токен, ЛогинGitHub,
		Настройки.Значение("oshub.publish.github.org"));
КонецФункции

// Автовыдача обязана быть отличима в журнале от TOFU-владения и от роли создателю пула.
Функция Принципал(Знач ЛогинGitHub)
	Логин = СокрЛП(Строка(ЛогинGitHub));
	Возврат "автовыдача github" + ?(ЗначениеЗаполнено(Логин), ":" + Логин, "");
КонецФункции

// Спрашивается на каждую раздачу; нет резолвера или ошибка чтения — выключено (fail-closed).
Функция ЛегасиВключён()

	Если Настройки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Настройки.Флаг("oshub.publish.github_legacy", Ложь);

КонецФункции

// Токен не должен доехать до журнала даже случайным эхом транспорта в тексте ошибки.
Функция БезТокена(Знач Текст, Знач Токен)
	Возврат Ошибки.БезСекрета(Ошибки.Однострочно(Текст), Токен);
КонецФункции

// Новые права видны всегда; раздача, ничего не изменившая, идёт на каждый вход и живёт на отладке.
Процедура Отчитаться(Знач ЛогинGitHub, Знач Репозиториев, Знач Выдано)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Выдано > 0 Тогда
		Лог.Информация("Автовыдача прав по GitHub для <%1>: репозиториев с правом записи — %2,"
			+ " новых прав мейнтейнера — %3",
			Строка(ЛогинGitHub), Формат(Репозиториев, "ЧГ=0; ЧН=0"), Формат(Выдано, "ЧГ=0; ЧН=0"));
		Возврат;
	КонецЕсли;

	Лог.Отладка("Автовыдача прав по GitHub для <%1>: репозиториев с правом записи — %2,"
		+ " новых прав мейнтейнера — %3",
		Строка(ЛогинGitHub), Формат(Репозиториев, "ЧГ=0; ЧН=0"), Формат(Выдано, "ЧГ=0; ЧН=0"));

КонецПроцедуры

// Раздача пробуется на каждом входе, поэтому причина незапуска живёт на отладке.
Процедура ОбъяснитьПропуск(Знач ЛогинGitHub, Знач Причина)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Лог.Отладка("Автовыдача прав по GitHub для <%1> не запускалась: %2",
		Строка(ЛогинGitHub), Строка(Причина));

КонецПроцедуры

// Лог опционален: при сборке вне контейнера объяснять некому, а вход всё равно идёт.
Процедура Пожаловаться(Знач ЛогинGitHub, Знач Причина)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Лог.Предупреждение("Автовыдача прав по GitHub для <%1> не выполнена, вход продолжен: %2",
		Строка(ЛогинGitHub), Причина);

КонецПроцедуры

#КонецОбласти

&Прозвище("АвтовыдачаПравGitHub")
&Верховный
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗапускВФоне") _Фон,
	&Пластилин(Значение = "ХранилищеПользователей") _ХранилищеПользователей,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "ПравилаИменования") _Правила,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисПравДоступа") _СервисПравДоступа,
	&Пластилин(Значение = "КаталогРепозиториевGitHub") _Каталог,
	&Пластилин(Значение = "СервисНастроек") _Настройки = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Фон = _Фон;
	ХранилищеПользователей = _ХранилищеПользователей;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	Правила = _Правила;
	СервисПрав = _СервисПрав;
	СервисПравДоступа = _СервисПравДоступа;
	Каталог = _Каталог;
	Настройки = _Настройки;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
