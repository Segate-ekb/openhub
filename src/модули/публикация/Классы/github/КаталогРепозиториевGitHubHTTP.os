// Реализация КаталогРепозиториевGitHub через GitHub REST API: GET /user/repos токеном
// пользователя, отбор по owner.login и permissions.push. Любой сбой — пустой список.

Перем Транспорт;    // ТранспортHTTP (сеть) - единый исходящий HTTP-клиент
Перем БазовыйАдрес; // Строка - хост GitHub API (переопределяемо для тестов/GHE)
Перем ЧтениеЗаголовков;   // ЗаголовкиHTTP (основа)
Перем Ошибки;             // ТекстОшибки (основа) — маска секрета одна на хаб
&Лог
Перем Лог;

// Публичные репозитории организации, в которые у владельца токена есть право записи (push).
// Реализация контракта КаталогРепозиториевGitHub.
//
// Параметры:
//  Токен - Строка - access-token GitHub владельца.
//  ЛогинGitHub - Строка - логин владельца токена; в запрос не входит, служит объяснением
//                в журнале.
//  Организация - Строка - владелец репозиториев (owner.login), по которому идёт отбор.
//
// Возвращаемое значение:
//  Массив из Строка - короткие имена репозиториев; пустой массив при недоступности
//                     GitHub, ошибке, не-200 и пустом токене (fail-closed).
//
Функция РепозиторииСПравомЗаписи(Знач Токен, Знач ЛогинGitHub, Знач Организация) Экспорт

	Если НЕ ЗначениеЗаполнено(Токен) ИЛИ НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Значение = СокрЛП(Строка(Токен));
	Попытка
		Итог = Собрать(Значение, НРег(СокрЛП(Строка(Организация))));
		Отчитаться(ЛогинGitHub, Организация, Итог);
	Исключение
		Пожаловаться(ЛогинGitHub, Организация, БезТокена(ОписаниеОшибки(), Значение));
		Возврат Новый Массив();
	КонецПопытки;

	Возврат Итог.Имена;

КонецФункции

#Область СлужебныеПроцедурыИФункции

// Обход страниц до первой неполной; потолок страниц не даёт входу ждать бесконечно.
Функция Собрать(Знач Токен, Знач Организация)

	Итог = Новый Структура("Имена, Отказ, Области", Новый Массив(), Неопределено, Неопределено);

	Страница = 1;
	Пока Страница <= ПотолокСтраниц() Цикл

		Ответ = Транспорт.Получить(АдресСтраницы(Страница), ЗаголовкиЗапроса(Токен), ТаймаутСек());
		Если Страница = 1 Тогда
			Итог.Области = ОбластиТокена(Ответ, Токен);
		КонецЕсли;

		Порция = Элементы(Ответ);
		Если Порция = Неопределено Тогда
			// частичному списку доверия нет: недобранная страница выглядела бы как
			// «прав больше нет», а список читают как полный
			Итог.Имена = Новый Массив();
			Итог.Отказ = Новый Структура("Код, Страница", Ответ.Код, Страница);
			Возврат Итог;
		КонецЕсли;

		Для Каждого Элемент Из Порция Цикл
			Имя = ИмяСвоего(Элемент, Организация);
			Если ЗначениеЗаполнено(Имя) Тогда
				Итог.Имена.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;

		Если Порция.Количество() < РазмерСтраницы() Тогда
			Прервать;
		КонецЕсли;
		Страница = Страница + 1;

	КонецЦикла;

	Возврат Итог;

КонецФункции

Функция ЗаголовкиЗапроса(Знач Токен)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Authorization", "token " + Токен);
	Заголовки.Вставить("User-Agent", "OpenHub");
	Заголовки.Вставить("Accept", "application/vnd.github+json");

	Возврат Заголовки;

КонецФункции

// Массив элементов страницы либо Неопределено, если ответ не годен.
Функция Элементы(Знач Ответ)

	Если Ответ.Код <> 200 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(ПолучитьСтрокуИзДвоичныхДанных(Ответ.Данные, "UTF-8"));
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат ?(ТипЗнч(Данные) = Тип("Массив"), Данные, Неопределено);

КонецФункции

// Их отсутствие — самая частая причина честного 200 с пустым списком; значение чужое и чистится.
Функция ОбластиТокена(Знач Ответ, Знач Токен)

	Значение = ЧтениеЗаголовков.Значение(Ответ.Заголовки, "X-OAuth-Scopes");
	Возврат ?(Значение = Неопределено, Неопределено, БезТокена(Строка(Значение), Токен));

КонецФункции

Функция АдресСтраницы(Знач Страница)

	Адрес = "https://" + БазовыйАдрес + "/user/repos"
		+ "?affiliation=collaborator,organization_member"
		+ "&visibility=public"
		+ "&per_page=" + Формат(РазмерСтраницы(), "ЧГ=0");
	Возврат ?(Страница <= 1, Адрес, Адрес + "&page=" + Формат(Страница, "ЧГ=0"));

КонецФункции

// Имя репозитория, если он принадлежит организации и в него разрешён push; иначе "".
Функция ИмяСвоего(Знач Элемент, Знач Организация)

	Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Владелец = Элемент.Получить("owner");
	Если ТипЗнч(Владелец) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;
	Если Текст(Владелец.Получить("login")) <> Организация Тогда
		Возврат "";
	КонецЕсли;

	Права = Элемент.Получить("permissions");
	Если ТипЗнч(Права) <> Тип("Соответствие") ИЛИ Права.Получить("push") <> Истина Тогда
		Возврат "";
	КонецЕсли;

	Имя = Элемент.Получить("name");
	Возврат ?(Имя = Неопределено, "", СокрЛП(Строка(Имя)));

КонецФункции

Функция Текст(Знач Значение)
	Возврат ?(Значение = Неопределено, "", НРег(СокрЛП(Строка(Значение))));
КонецФункции

// Токен не должен доехать до журнала даже случайным эхом транспорта в тексте ошибки.
Функция БезТокена(Знач Текст, Знач Токен)
	Возврат Ошибки.БезСекрета(Ошибки.Однострочно(Текст), Токен);
КонецФункции

// Успешный поход идёт на каждый вход, поэтому живёт на отладке.
Процедура Отчитаться(Знач ЛогинGitHub, Знач Организация, Знач Итог)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Итог.Отказ <> Неопределено Тогда
		Лог.Предупреждение("Список репозиториев GitHub организации %1 для <%2> не получен —"
			+ " права по GitHub в этот раз не раздаются: GitHub ответил кодом %3 на странице %4,"
			+ " годного списка репозиториев в ответе нет",
			Строка(Организация), Строка(ЛогинGitHub),
			Формат(Итог.Отказ.Код, "ЧГ=0; ЧН=0"), Формат(Итог.Отказ.Страница, "ЧГ=0; ЧН=0"));
		Возврат;
	КонецЕсли;

	Если Итог.Имена.Количество() = 0 Тогда
		Лог.Отладка("GitHub ответил, что репозиториев организации %1 с правом записи"
			+ " у <%2> нет — права по GitHub не раздаются. Области токена (X-OAuth-Scopes): %3",
			Строка(Организация), Строка(ЛогинGitHub), ОписаниеОбластей(Итог.Области));
		Возврат;
	КонецЕсли;

	Лог.Отладка("GitHub ответил, что репозитории организации %1 с правом записи"
		+ " у <%2> есть. Области токена (X-OAuth-Scopes): %3",
		Строка(Организация), Строка(ЛогинGitHub), ОписаниеОбластей(Итог.Области));

КонецПроцедуры

// Сам список областей либо код: заголовка не было или он пуст — областей токену не выдано.
Функция ОписаниеОбластей(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат "scopes_absent";
	КонецЕсли;
	Возврат ?(ЗначениеЗаполнено(СокрЛП(Значение)), СокрЛП(Значение), "scopes_empty");

КонецФункции

// Лог опционален: при сборке вне контейнера объяснять некому, а список всё равно пуст.
Процедура Пожаловаться(Знач ЛогинGitHub, Знач Организация, Знач Причина)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Лог.Предупреждение("Список репозиториев GitHub организации %1 для <%2> не получен —"
		+ " права по GitHub в этот раз не раздаются: %3",
		Строка(Организация), Строка(ЛогинGitHub), Причина);

КонецПроцедуры

Функция РазмерСтраницы()
	Возврат 100;
КонецФункции

// Потолок и таймаут вместе задают ХУДШЕЕ ожидание человека на входе: 3 × 5 = 15 секунд.
Функция ПотолокСтраниц()
	Возврат 3;
КонецФункции

Функция ТаймаутСек()
	Возврат 5;
КонецФункции

#КонецОбласти

&Прозвище("КаталогРепозиториевGitHub")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТранспортHTTP") _Транспорт,
	&Деталька(Значение = "oshub.publish.github.api", ЗначениеПоУмолчанию = "api.github.com") АдресЗначение = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ЗаголовкиHTTP") _Заголовки = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	ЧтениеЗаголовков = ?(_Заголовки = Неопределено, Новый ЗаголовкиHTTP(), _Заголовки);
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Транспорт = _Транспорт;
	БазовыйАдрес = ?(ЗначениеЗаполнено(АдресЗначение), Строка(АдресЗначение), "api.github.com");

КонецПроцедуры
