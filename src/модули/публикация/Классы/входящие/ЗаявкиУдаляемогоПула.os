// Заявки на публикацию в удаляемый пул — реализация контракта ПоследствияУдаленияПула:
// заявки уходят вместе со снимками их манифестов.

Перем ХранилищеВходящих;    // ХранилищеВходящихПубликаций (публикация)
Перем ХранилищеМанифестов;  // ХранилищеМанифестовЗаявок (публикация) — снимки манифеста заявок
Перем Снятие;               // СнятиеСтрок (данные) — снятие пачки строк со счётом

// Снимает заявки пула и снимки их манифестов.
//
// Параметры:
//  Пул - Пул - удаляемый пул.
//
// Возвращаемое значение:
//  Структура - Заявок (Число), Строк (Число) — заявки вместе со снимками манифестов.
//
Функция СнятьСтрокиПула(Знач Пул) Экспорт

	ЗаявкиПула = ХранилищеВходящих.ПолучитьПоПулИдентификаторРавно(Цел(Пул.Идентификатор));
	Манифестов = Снятие.Снять(ХранилищеМанифестов.МанифестыЗаявок(НомераЗаявок(ЗаявкиПула)));
	Заявок = Снятие.Снять(ЗаявкиПула);

	Возврат Новый Структура("Заявок, Строк", Заявок, Заявок + Манифестов);

КонецФункции

Функция НомераЗаявок(Знач Заявки)

	Результат = Новый Массив();
	Для Каждого Заявка Из Заявки Цикл
		Результат.Добавить(Цел(Заявка.Идентификатор));
	КонецЦикла;
	Возврат Результат;

КонецФункции

&Прозвище("ПоследствияУдаленияПула")
&Порядок(50)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеВходящихПубликаций") _ХранилищеВходящих,
	&Пластилин(Значение = "ХранилищеМанифестовЗаявок") _ХранилищеМанифестов,
	&Пластилин(Значение = "СнятиеСтрок") _Снятие)

	ХранилищеВходящих = _ХранилищеВходящих;
	ХранилищеМанифестов = _ХранилищеМанифестов;
	Снятие = _Снятие;

КонецПроцедуры
