// Хранилище входящих публикаций — репозиторий сущности «ВходящаяПубликация».
// Доменные операции — публикация/СервисВходящих.

// BSLLS:UnusedParameters-off

#Использовать entity

Перем Сам;       // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё
Перем Агрегаты;  // АгрегатыБазы (данные) — счёт очереди спрашивается у базы

// Заявка по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор заявки.
//
// Возвращаемое значение:
//  ВходящаяПубликация, Неопределено.
//
&МетодЗапроса
Функция ПолучитьОдноПоИдентификаторРавно(Идентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Все заявки пула (любого состояния) — витрина «входящих».
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация.
//
&МетодЗапроса
Функция ПолучитьПоПулИдентификаторРавно(ПулИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Все заявки, поданные пользователем (витрина «мои заявки»).
//
// Параметры:
//  ЗаявительИдентификатор - Число - идентификатор подавшего заявку.
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация.
//
&МетодЗапроса
Функция ПолучитьПоЗаявительИдентификаторРавно(ЗаявительИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Заявки пула в заданном состоянии.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Состояние - Строка - состояние заявки.
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация.
//
&МетодЗапроса
Функция ПолучитьПоПулИдентификаторРавноИСостояниеРавно(ПулИдентификатор, Состояние) Экспорт
	Возврат Неопределено;
КонецФункции

// Заявки всех пулов в заданном состоянии.
//
// Параметры:
//  Состояние - Строка - состояние заявки.
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация.
//
&МетодЗапроса
Функция ПолучитьПоСостояниеРавно(Состояние) Экспорт
	Возврат Неопределено;
КонецФункции

// Заявки пула на имя пакета в заданном состоянии.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  ИмяНижнийРегистр - Строка - канонический ключ имени пакета.
//  Состояние - Строка - состояние заявки.
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация.
//
&МетодЗапроса
Функция ПолучитьПоПулИдентификаторРавноИИмяНижнийРегистрРавноИСостояниеРавно(
	ПулИдентификатор, ИмяНижнийРегистр, Состояние) Экспорт
	Возврат Неопределено;
КонецФункции

// Заявка пула на имя и версию в заданном состоянии.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  ИмяНижнийРегистр - Строка - канонический ключ имени пакета.
//  Версия - Строка - номер версии.
//  Состояние - Строка - состояние заявки.
//
// Возвращаемое значение:
//  ВходящаяПубликация, Неопределено.
//
&МетодЗапроса
Функция ПолучитьОдноПоПулИдентификаторРавноИИмяНижнийРегистрРавноИВерсияРавноИСостояниеРавно(
	ПулИдентификатор, ИмяНижнийРегистр, Версия, Состояние) Экспорт
	Возврат Неопределено;
КонецФункции

// Все заявки хаба.
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация.
//
&МетодЗапроса
Функция ПолучитьПо() Экспорт
	Возврат Неопределено;
КонецФункции

// Заявки пула в заданном состоянии. В отличие от ПолучитьПоПулИдентификаторРавноИСостояниеРавно
// приводит пул к числу, а состояние к строке.
//
// Параметры:
//  ПулИдентификатор - Число, Строка - идентификатор пула.
//  Состояние - Строка - состояние заявки.
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация.
//
Функция ЗаявкиПулаВСостоянии(Знач ПулИдентификатор, Знач Состояние) Экспорт

	Возврат Сам.Достать().ПолучитьПоПулИдентификаторРавноИСостояниеРавно(
		Цел(ПулИдентификатор), Строка(Состояние));

КонецФункции

// Заявки всех пулов в заданном состоянии — одной выборкой вместо обхода пулов.
//
// Параметры:
//  Состояние - Строка - состояние заявки.
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация.
//
Функция ЗаявкиВСостоянии(Знач Состояние) Экспорт
	Возврат Сам.Достать().ПолучитьПоСостояниеРавно(Строка(Состояние));
КонецФункции

// Живая (ожидающая) заявка на конкретное имя и версию в пуле.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  ИмяНижнийРегистр - Строка - канонический ключ имени пакета.
//  Версия - Строка - номер версии.
//  Состояние - Строка - состояние заявки.
//
// Возвращаемое значение:
//  ВходящаяПубликация, Неопределено.
//
Функция НайтиПоИмениИВерсии(Знач ПулИдентификатор, Знач ИмяНижнийРегистр, Знач Версия, Знач Состояние) Экспорт

	Возврат Сам.Достать().ПолучитьОдноПоПулИдентификаторРавноИИмяНижнийРегистрРавноИВерсияРавноИСостояниеРавно(
		Цел(ПулИдентификатор), Строка(ИмяНижнийРегистр), Строка(Версия), Строка(Состояние));

КонецФункции

// Ожидающие заявки на имя пакета в пуле (конкурентные заявки разных людей).
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  ИмяНижнийРегистр - Строка - канонический ключ имени пакета.
//  Состояние - Строка - состояние заявки.
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация.
//
Функция ЗаявкиНаИмя(Знач ПулИдентификатор, Знач ИмяНижнийРегистр, Знач Состояние) Экспорт

	Возврат Сам.Достать().ПолучитьПоПулИдентификаторРавноИИмяНижнийРегистрРавноИСостояниеРавно(
		Цел(ПулИдентификатор), Строка(ИмяНижнийРегистр), Строка(Состояние));

КонецФункции

// Сколько заявок пула ждёт решения в заданном состоянии.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Состояние - Строка - состояние заявки.
//
// Возвращаемое значение:
//  Число.
//
Функция СчётЗаявокПула(Знач ПулИдентификатор, Знач Состояние) Экспорт

	Возврат Агрегаты.Количество(Сам.Достать(), Новый ОпцииПоиска()
		.Отбор("ПулИдентификатор", ВидСравнения.Равно, Цел(ПулИдентификатор))
		.Отбор("Состояние", ВидСравнения.Равно, Строка(Состояние)));

КонецФункции

// Сколько заявок подал человек и они всё ещё в заданном состоянии.
//
// Параметры:
//  ЗаявительИдентификатор - Число - идентификатор подавшего заявку.
//  Состояние - Строка - состояние заявки.
//
// Возвращаемое значение:
//  Число.
//
Функция СчётЗаявокЗаявителя(Знач ЗаявительИдентификатор, Знач Состояние) Экспорт

	Возврат Агрегаты.Количество(Сам.Достать(), Новый ОпцииПоиска()
		.Отбор("ЗаявительИдентификатор", ВидСравнения.Равно, Цел(ЗаявительИдентификатор))
		.Отбор("Состояние", ВидСравнения.Равно, Строка(Состояние)));

КонецФункции

// Сколько заявок в заданном состоянии у каждого пула — одним разрезом на весь хаб.
//
// Параметры:
//  Состояние - Строка - состояние заявки.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (идентификатор пула), значение Число; пулов без заявок в нём нет.
//
Функция СчётЗаявокПоПулам(Знач Состояние) Экспорт

	Возврат Агрегаты.КоличествоПоКлючу(Сам.Достать(), "ПулИдентификатор",
		Новый ОпцииПоиска().Отбор("Состояние", ВидСравнения.Равно, Строка(Состояние)));

КонецФункции

// Все заявки хаба (витрина администратора и уборка).
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация.
//
Функция Все() Экспорт
	Возврат Сам.Достать().ПолучитьПо();
КонецФункции

&ХранилищеСущностей("ВходящаяПубликация")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеВходящихПубликаций") _Сам,
	&Пластилин(Значение = "АгрегатыБазы") _Агрегаты)

	Сам = _Сам;
	Агрегаты = _Агрегаты;

КонецПроцедуры
