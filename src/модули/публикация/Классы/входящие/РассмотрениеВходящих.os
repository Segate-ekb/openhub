// Решение по заявке из «входящих»: кому какие заявки видны, кто вправе решать, что
// происходит при одобрении и что при отказе. Хранение очереди ведёт СервисВходящих,
// публикацию — СервисПубликации. Через этот класс ходят и экраны: читающие методы
// СервисВходящих авторизации не спрашивают, порог держится здесь.
//
// Одобрение идёт в три шага, чтобы публикация шла ШТАТНЫМ путём, а не в обход
// авторизации: резервируется имя пакета, заявителю выдаётся роль мейнтейнера, публикация
// вызывается от имени заявителя и проходит обычную проверку прав. Системного входа мимо
// авторизации в СервисПубликации нет. Провал публикации откатывает первые два шага, иначе
// заявитель остался бы с правами на пакет, которого он не публиковал.

Перем Входящие;            // СервисВходящих
Перем СервисПубликации;    // СервисПубликации
Перем СервисПулов;         // СервисПулов
Перем СервисПакетов;       // СервисПакетов
Перем СервисВерсий;        // СервисВерсий
Перем СервисПрав;          // СервисПрав (auth)
Перем СервисПравДоступа;   // СервисПравДоступа (auth)
Перем СервисПользователей; // СервисПользователей (auth)
Перем Канал;               // СлужбаЛичныхУведомлений (связь) — исход заявки заявителю
Перем ГвардКлюча;          // ГвардКлюча (auth), может быть Неопределено
&Лог
Перем Лог;
Перем Ошибки;      // ТекстОшибки (основа)

#Область ПубличныйИнтерфейс

// Возвращает заявки, которые принципал вправе рассматривать в пуле. Рамки ключа
// спрашиваются на чтение: ключ без скоупа read и ключ чужого пула списка не увидят.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация - пусто, если принципал не мейнтейнер пула.
//
Функция ВидимыеЗаявки(Знач Принципал, Знач Пул) Экспорт

	Если Пул = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Если ГвардКлюча = Неопределено
		ИЛИ НЕ ГвардКлюча.Пропустить(Принципал, "чтение", Пул.Идентификатор).Разрешено Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Если НЕ РассматриватьВправе(ПользовательПринципала(Принципал), Пул) Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат Входящие.ОжидающиеПула(Пул.Идентификатор);

КонецФункции

// Возвращает ожидающие заявки пула строками, готовыми к показу: заявка вместе с пулом
// и заявителем. Порог и рамки ключа — те же, что у ВидимыеЗаявки.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Массив из Структура - Пул (Пул), Заявка (ВходящаяПубликация),
//                        Заявитель (Пользователь, Неопределено); свежие первыми.
//
Функция СтрокиПула(Знач Принципал, Знач Пул) Экспорт

	Результат = Новый Массив();
	Для Каждого Заявка Из ВидимыеЗаявки(Принципал, Пул) Цикл
		ВставитьСвежейПервой(Результат, Строка_(Пул, Заявка));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает ожидающие заявки по всем пулам, где принципал вправе решать. Пулы, где он
// не мейнтейнер, отсеиваются тем же порогом — сводка не показывает лишнего.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//
// Возвращаемое значение:
//  Массив из Структура - Пул (Пул), Заявка (ВходящаяПубликация),
//                        Заявитель (Пользователь, Неопределено); свежие первыми.
//
Функция ОжидающиеПринципала(Знач Принципал) Экспорт

	Результат = Новый Массив();
	Если ПользовательПринципала(Принципал) = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Пул Из СервисПулов.ВсеПулы() Цикл
		Для Каждого Заявка Из ВидимыеЗаявки(Принципал, Пул) Цикл
			ВставитьСвежейПервой(Результат, Строка_(Пул, Заявка));
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает, сколько заявок ждёт решения человека. Только число: счётчик в шапке
// спрашивается на каждой странице вошедшего, а каждая строка сводки стоит отдельного
// чтения заявителя. Порог тот же, что у ОжидающиеПринципала, — мейнтейнер пула и выше;
// рамок ключа не спрашивает: шапку видит человек, а не ключ.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - смотрящий.
//
// Возвращаемое значение:
//  Число - сколько ожидающих заявок он вправе рассмотреть.
//
Функция СколькоЖдётРешения(Знач Пользователь) Экспорт

	Если Пользователь = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Результат = 0;
	Для Каждого Очередь Из ОжидающиеПоПулам() Цикл
		Если РассматриватьВправе(Пользователь, СервисПулов.ПулПоИдентификатору(Очередь.Ключ)) Тогда
			Результат = Результат + Очередь.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Возвращает заявку для показа рассматривающему. Проверки — те же и в том же порядке,
// что у решения: экран не должен узнавать о заявке больше, чем позволит по ней решить.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  ЗаявкаИдентификатор - Число - идентификатор заявки.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка); при успехе также
//              Заявка (ВходящаяПубликация), Пул (Пул), Заявитель (Пользователь, Неопределено).
//
Функция ЗаявкаКРассмотрению(Знач Принципал, Знач ЗаявкаИдентификатор) Экспорт

	Контекст = Разрешить(Принципал, ЗаявкаИдентификатор, "чтение");
	Если НЕ Контекст.Успех Тогда
		Возврат Контекст;
	КонецЕсли;

	Контекст.Вставить("Заявитель",
		СервисПользователей.ПоИдентификатору(Цел(Контекст.Заявка.ЗаявительИдентификатор)));
	Возврат Контекст;

КонецФункции

// Проверяет, вправе ли пользователь рассматривать заявки пула: мейнтейнер и выше.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - пользователь.
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Булево - Истина, если вправе.
//
Функция РассматриватьВправе(Знач Пользователь, Знач Пул) Экспорт

	Если Пользователь = Неопределено ИЛИ Пул = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СервисПрав.РольНеНиже(
		Пользователь, СервисПрав.ОбъектПул(Пул), СервисПрав.РольМейнтейнер());

КонецФункции

// Одобряет заявку: публикует версию и делает заявителя мейнтейнером пакета. При провале
// публикации выданное право и пустой пакет откатываются, заявка остаётся ожидающей.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал решающего.
//  ЗаявкаИдентификатор - Число - идентификатор заявки.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка).
//
Функция Одобрить(Знач Принципал, Знач ЗаявкаИдентификатор) Экспорт

	Перем Пакет;
	Перем Грант;
	Перем РезультатПубликации;
	Перем НомерЗаявки;
	Перем ИмяПакета;
	Перем Версия;

	Контекст = Разрешить(Принципал, ЗаявкаИдентификатор, "создание");
	Если НЕ Контекст.Успех Тогда
		Возврат Контекст;
	КонецЕсли;

	Заявка = Контекст.Заявка;
	Пул = Контекст.Пул;
	// номер снимается ДО любой записи: на PostgreSQL Сохранить() существующей строки портит
	// поле Идентификатор в памяти — туда попадает текущее значение последовательности
	НомерЗаявки = Цел(Заявка.Идентификатор);
	ИмяПакета = Строка(Заявка.ИмяПакета);
	Версия = Строка(Заявка.Версия);
	Заявитель = СервисПользователей.ПоИдентификатору(Цел(Заявка.ЗаявительИдентификатор));
	Если Заявитель = Неопределено ИЛИ НЕ Заявитель.Активен Тогда
		Возврат Отказ(409, СтрШаблон(
			"Заявитель по заявке №%1 больше не активен: одобрять нечего — отклоните заявку",
			Формат(НомерЗаявки, "ЧГ=0; ЧН=0")));
	КонецЕсли;

	// имя могло быть занято, пока заявка ждала; одобрение не отбирает занятое имя
	Если СервисПакетов.НайтиПакет(Пул.Идентификатор, Заявка.ИмяПакета) <> Неопределено Тогда
		Возврат Отказ(409, СтрШаблон(
			"Имя ""%1"" в пуле ""%2"" уже занято: заявку №%3 одобрить нельзя, её следует отклонить",
			Заявка.ИмяПакета, Пул.Имя, Формат(НомерЗаявки, "ЧГ=0; ЧН=0")));
	КонецЕсли;

	Попытка
		Данные = Входящие.ДанныеЗаявки(Заявка, Пул.Имя);
	Исключение
		Возврат Отказ(410, СтрШаблон(
			"Артефакт заявки №%1 недоступен во «входящих» (%2): заявку следует отклонить",
			Формат(НомерЗаявки, "ЧГ=0; ЧН=0"), КраткоеОписаниеОшибки()));
	КонецПопытки;

	Лог.Отладка("Входящие: одобряем заявку №%1 — ""%2"" %3 в пул ""%4"", заявитель ""%5""",
		НомерЗаявки, ИмяПакета, Версия, Пул.Имя, Заявитель.Логин);

	// имя и право — до публикации, чтобы она прошла штатной проверкой прав
	Пакет = СервисПакетов.ЗарегистрироватьПакет(Пул.Идентификатор, Заявка.ИмяПакета);
	Грант = СервисПравДоступа.ЗафиксироватьГрант("пользователь", Заявитель.Идентификатор,
		СервисПрав.ОбъектПакет(Пакет), СервисПрав.НаборРоли(СервисПрав.РольМейнтейнер()),
		Цел(Контекст.Пользователь.Идентификатор), Строка(Контекст.Пользователь.Логин));

	Попытка
		// принципал не передаётся: публикует заявитель, ключа у него нет, а рамками ключа
		// решающего сузить публикацию нельзя — публикует не решающий
		РезультатПубликации = СервисПубликации.Опубликовать(Пул.Имя, Данные, Заявка.ИмяФайла,
			Заявка.Канал, Заявитель, "", Неопределено);
	Исключение
		ОткатитьОдобрение(Пакет, Грант, Заявитель);
		Возврат Отказ(500, "Публикация по заявке не удалась: " + КраткоеОписаниеОшибки());
	КонецПопытки;

	Если НЕ РезультатПубликации.Успех Тогда
		Лог.Отладка("Входящие: публикация по заявке №%1 отклонена кодом %2 — откатываем"
			+ " имя и право", НомерЗаявки, РезультатПубликации.Код);
		ОткатитьОдобрение(Пакет, Грант, Заявитель);
		Возврат Отказ(РезультатПубликации.Код,
			"Публикация по заявке отклонена: " + РезультатПубликации.Сообщение);
	КонецЕсли;

	Входящие.Завершить(Заявка, Пул.Имя, Входящие.СостояниеОдобрена(),
		Контекст.Пользователь.Идентификатор, "");

	СообщитьОбОдобрении(Заявитель, НомерЗаявки, ИмяПакета, Версия, Пул.Имя);

	Возврат Успех(200, СтрШаблон(
		"Заявка №%1 одобрена: %2 %3 опубликован в пуле ""%4"", заявитель ""%5"" — мейнтейнер пакета",
		Формат(НомерЗаявки, "ЧГ=0; ЧН=0"), ИмяПакета, Версия, Пул.Имя, Заявитель.Логин));

КонецФункции

// Отклоняет заявку: артефакт из «входящих» удаляется, права не выдаются.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал решающего.
//  ЗаявкаИдентификатор - Число - идентификатор заявки.
//  Причина - Строка - пояснение заявителю (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка).
//
Функция Отклонить(Знач Принципал, Знач ЗаявкаИдентификатор, Знач Причина = "") Экспорт

	Перем НомерЗаявки;

	Контекст = Разрешить(Принципал, ЗаявкаИдентификатор, "удаление");
	Если НЕ Контекст.Успех Тогда
		Возврат Контекст;
	КонецЕсли;

	// номер снимается ДО записи — см. Одобрить
	НомерЗаявки = Цел(Контекст.Заявка.Идентификатор);
	ИмяПакета = Строка(Контекст.Заявка.ИмяПакета);
	Версия = Строка(Контекст.Заявка.Версия);
	Заявитель = СервисПользователей.ПоИдентификатору(
		Цел(Контекст.Заявка.ЗаявительИдентификатор));

	Лог.Отладка("Входящие: заявка №%1 в пуле ""%2"" отклонена решением ""%3""",
		НомерЗаявки, Контекст.Пул.Имя, Контекст.Пользователь.Логин);
	Входящие.Завершить(Контекст.Заявка, Контекст.Пул.Имя, Входящие.СостояниеОтклонена(),
		Контекст.Пользователь.Идентификатор, Причина);

	СообщитьОбОтказе(Заявитель, НомерЗаявки, ИмяПакета, Версия, Контекст.Пул.Имя, Причина);

	Возврат Успех(200, СтрШаблон("Заявка №%1 отклонена", Формат(НомерЗаявки, "ЧГ=0; ЧН=0")));

КонецФункции

#КонецОбласти

#Область ИсходЗаявителю

// Заявитель узнаёт исход сам: заявку он подал и ушёл, а очередь «входящих» — экран
// мейнтейнера. Канал ни решения, ни ответа рассматривающему не отменяет.
Процедура СообщитьОбОдобрении(Знач Заявитель, Знач НомерЗаявки, Знач ИмяПакета,
	Знач Версия, Знач ИмяПула)

	Если Заявитель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Канал.Уведомить(Заявитель, Канал.Поводы().ЗаявкаОдобрена(),
		СтрШаблон("Заявка №%1 на имя «%2» одобрена", Номер(НомерЗаявки), ИмяПакета),
		СтрШаблон("Версия %1 опубликована в пуле «%2»; вы — мейнтейнер пакета «%3».",
			Версия, ИмяПула, ИмяПакета),
		"/" + ИмяПула + "/" + ИмяПакета);

КонецПроцедуры

Процедура СообщитьОбОтказе(Знач Заявитель, Знач НомерЗаявки, Знач ИмяПакета,
	Знач Версия, Знач ИмяПула, Знач Причина)

	Если Заявитель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Пояснение = СокрЛП(?(Причина = Неопределено, "", Строка(Причина)));

	Канал.Уведомить(Заявитель, Канал.Поводы().ЗаявкаОтклонена(),
		СтрШаблон("Заявка №%1 на имя «%2» отклонена", Номер(НомерЗаявки), ИмяПакета),
		СтрШаблон("Версия %1 в пул «%2» не опубликована. %3", Версия, ИмяПула,
			?(ЗначениеЗаполнено(Пояснение), "Причина: " + Пояснение,
				"Причину рассматривающий не назвал.")));

КонецПроцедуры

Функция Номер(Знач Значение)
	Возврат Формат(Цел(Значение), "ЧГ=0; ЧН=0");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ожидающие заявки, сосчитанные по пулам одной выборкой на весь хаб. Обход идёт от заявок,
// а не от пулов: право — самый дорогой вопрос здесь, и на пустой очереди его не задают вовсе.
Функция ОжидающиеПоПулам()

	Результат = Новый Соответствие();
	Для Каждого Заявка Из Входящие.ОжидающиеВсехПулов() Цикл
		Ключ = Цел(Заявка.ПулИдентификатор);
		Сосчитано = Результат.Получить(Ключ);
		Результат.Вставить(Ключ, ?(Сосчитано = Неопределено, 0, Сосчитано) + 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Строка_(Знач Пул, Знач Заявка)
	Возврат Новый Структура("Пул, Заявка, Заявитель", Пул, Заявка,
		СервисПользователей.ПоИдентификатору(Цел(Заявка.ЗаявительИдентификатор)));
КонецФункции

// Порядок держит вставка, а не сортировка: массивы OneScript сортировать нечем, а очередь
// одного пула ограничена настройкой и заведомо коротка.
Процедура ВставитьСвежейПервой(Строки, Знач Новая)

	Номер = Цел(Новая.Заявка.Идентификатор);
	Индекс = 0;
	Пока Индекс < Строки.Количество() Цикл
		Если Номер > Цел(Строки[Индекс].Заявка.Идентификатор) Тогда
			Строки.Вставить(Индекс, Новая);
			Возврат;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Строки.Добавить(Новая);

КонецПроцедуры

// Общий пролог обоих решений: заявка существует и ждёт, пул существует, рамки ключа
// пропускают, человек — мейнтейнер пула.
Функция Разрешить(Знач Принципал, Знач ЗаявкаИдентификатор, Знач Действие)

	Заявка = Входящие.Заявка(Цел(ЗаявкаИдентификатор));
	Если Заявка = Неопределено Тогда
		Возврат Отказ(404, "Заявка не найдена");
	КонецЕсли;

	Пул = СервисПулов.ПулПоИдентификатору(Цел(Заявка.ПулИдентификатор));
	Если Пул = Неопределено Тогда
		Возврат Отказ(404, "Пул заявки не найден");
	КонецЕсли;

	// рамки ключа — ДО прав человека и состояния заявки: read-only ключ не должен узнавать
	// по коду ответа, существует ли заявка и в каком она состоянии
	Если ГвардКлюча = Неопределено Тогда
		Возврат Отказ(403, "Рассмотрение заявок недоступно: гейт ключа доступа не собран");
	КонецЕсли;
	ВердиктКлюча = ГвардКлюча.Пропустить(Принципал, Действие, Пул.Идентификатор);
	Если НЕ ВердиктКлюча.Разрешено Тогда
		Возврат Отказ(403, "Рассмотрение заявок запрещено ключом доступа: "
			+ ГвардКлюча.ОписаниеПричины(ВердиктКлюча.Причина));
	КонецЕсли;

	Пользователь = ПользовательПринципала(Принципал);
	Если Пользователь = Неопределено Тогда
		Возврат Отказ(401, "Требуется аутентификация");
	КонецЕсли;
	Если НЕ РассматриватьВправе(Пользователь, Пул) Тогда
		Возврат Отказ(403, СтрШаблон(
			"Заявки пула ""%1"" рассматривают его мейнтейнеры и выше", Пул.Имя));
	КонецЕсли;

	Если НЕ Заявка.Ожидает() Тогда
		Возврат Отказ(409, СтрШаблон("Заявка №%1 уже рассмотрена (состояние: %2)",
			Формат(Цел(Заявка.Идентификатор), "ЧГ=0; ЧН=0"), Заявка.Состояние));
	КонецЕсли;

	Результат = Успех(200, "");
	Результат.Вставить("Заявка", Заявка);
	Результат.Вставить("Пул", Пул);
	Результат.Вставить("Пользователь", Пользователь);
	Возврат Результат;

КонецФункции

// Best-effort, но громкий: провал отката оставляет заявителю права на чужой пакет.
Процедура ОткатитьОдобрение(Знач Пакет, Знач Грант, Знач Заявитель)

	Попытка
		Если Грант <> Неопределено Тогда
			СервисПравДоступа.ЗафиксироватьГрант("пользователь", Заявитель.Идентификатор,
				СервисПрав.ОбъектПакет(Пакет), Новый Структура(), 0, "");
		КонецЕсли;
	Исключение
		Лог.Ошибка("Откат одобрения заявки: право заявителя ""%1"" на пакет %2 НЕ отозвано: %3",
			Заявитель.Логин, Пакет.Имя, ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Если СервисВерсий.ВерсииПакета(Пакет.Идентификатор).Количество() = 0 Тогда
			Пакет.Удалить();
		КонецЕсли;
	Исключение
		Лог.Ошибка("Откат одобрения заявки: пустой пакет %1 НЕ удалён: %2",
			Пакет.Имя, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Функция ПользовательПринципала(Знач Принципал)
	Если Принципал = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Значение = Неопределено;
	Если Принципал.Свойство("Пользователь", Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция Успех(Знач Код, Знач Сообщение)
	Возврат Новый Структура("Успех, Код, Сообщение", Истина, Код, Сообщение);
КонецФункции

Функция Отказ(Знач Код, Знач Сообщение)
	Возврат Новый Структура("Успех, Код, Сообщение", Ложь, Код, Сообщение);
КонецФункции

Функция КраткоеОписаниеОшибки()
	Возврат Ошибки.Однострочно(ОписаниеОшибки());
КонецФункции

#КонецОбласти

// Второй вход для лога: при прямом создании вне контейнера инъекция в поле не доезжает,
// и первая же запись в журнал падает «Value is not of object type».
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисВходящих") _Входящие,
	&Пластилин(Значение = "СервисПубликации") _СервисПубликации,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисПравДоступа") _СервисПравДоступа,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "СлужбаЛичныхУведомлений") _Канал,
	&Пластилин(Значение = "ГвардКлюча") _ГвардКлюча = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Входящие = _Входящие;
	СервисПубликации = _СервисПубликации;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;
	СервисПрав = _СервисПрав;
	СервисПравДоступа = _СервисПравДоступа;
	СервисПользователей = _СервисПользователей;
	Канал = _Канал;
	ГвардКлюча = _ГвардКлюча;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
