// Хранилище очереди заявок и ничего больше: заявка появляется (push свободного имени
// от пользователя без прав на пул), живёт и завершается; решает — РассмотрениеВходящих.

Перем ХранилищеЗаявок;   // ХранилищеВходящихПубликаций (данные)
Перем Хранилище;         // ХранилищеАртефактов (хранилище)
Перем Занятое;           // ЗаписьЗанятогоМеста (реестр)
Перем ХранилищеПулов;    // ХранилищеПулов (данные) — пул заявки при её завершении
Перем Правила;           // ПравилаИменования
Перем Настройки;         // СервисНастроек (настройки)
Перем ОбразецЗаявки;     // ВходящаяПубликация, несохраняемый носитель словаря состояний
Перем Ошибки;      // ТекстОшибки (основа)

#Область ПубличныйИнтерфейс

// Возвращает служебное имя «пакета» во «входящих» хранилища.
//
// Возвращаемое значение:
//  Строка - служебное имя.
//
Функция СлужебноеИмяВходящих() Экспорт
	Возврат "_входящие";
КонецФункции

// Ставит артефакт во «входящие» пула. Это приём, а не авторизация: уместность заявки
// вызывающий уже решил. Единственная проверка доступа здесь — «заявку подаёт человек».
//
// Параметры:
//  Пул - Пул - пул назначения.
//  ИмяПакета - Строка - имя из манифеста, регистр сохраняется.
//  Версия - Строка - версия из манифеста.
//  ИмяФайла - Строка - значение заголовка FILE-NAME.
//  Канал - Строка - значение заголовка CHANNEL.
//  ВременныйПуть - Строка - путь к принятым байтам .ospx.
//  Заявитель - Пользователь, Неопределено - автор push.
//  АвторМанифеста - Строка - автор из манифеста .ospx (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число: 202 принято, 409 конкурентная заявка,
//              429 предел, 401/500 отказ), Сообщение (Строка),
//              Заявка (ВходящаяПубликация либо Неопределено).
//
Функция Поставить(Знач Пул, Знач ИмяПакета, Знач Версия, Знач ИмяФайла, Знач Канал,
	Знач ВременныйПуть, Знач Заявитель, Знач АвторМанифеста = "") Экспорт

	Перем Существующая;
	Перем Результат;

	Если Заявитель = Неопределено Тогда
		Возврат Отказ(401, "Заявку во «входящие» подаёт только аутентифицированный пользователь");
	КонецЕсли;

	Канон = Правила.Канонизировать(ИмяПакета);
	Существующая = ХранилищеЗаявок.НайтиПоИмениИВерсии(
		Пул.Идентификатор, Канон, СокрЛП(Строка(Версия)), СостояниеОжидает());

	// пределы — после поиска существующей заявки, но до приёма байтов: ретрай того же push
	// не должен упираться в предел, который сам же и занял
	Если Существующая = Неопределено Тогда
		ОтказПредела = ПроверитьВместимость(Пул, Заявитель, Канон);
		Если ОтказПредела <> Неопределено Тогда
			Возврат ОтказПредела;
		КонецЕсли;
	КонецЕсли;

	Если Существующая <> Неопределено Тогда
		// ретрай того же автора идемпотентен: opm повторяет push при сетевом сбое
		Если Цел(Существующая.ЗаявительИдентификатор) = Цел(Заявитель.Идентификатор) Тогда
			Возврат Принято(Существующая, Пул, Истина);
		КонецЕсли;
		Возврат Отказ(409, СтрШаблон(
			"Имя ""%1"" уже ждёт решения по заявке другого пользователя в пуле ""%2"":"
			+ " пока мейнтейнеры пула не рассмотрят её, вторая заявка на это имя не принимается",
			ИмяПакета, Пул.Имя));
	КонецЕсли;

	// другая версия уже заявленного чужого имени — та же гонка за именем: одобрение первой
	// заявки сделает её автора мейнтейнером, и вторая заявка превратится в 403
	Для Каждого Соперница Из ХранилищеЗаявок.ЗаявкиНаИмя(Пул.Идентификатор, Канон, СостояниеОжидает()) Цикл
		Если Цел(Соперница.ЗаявительИдентификатор) <> Цел(Заявитель.Идентификатор) Тогда
			Возврат Отказ(409, СтрШаблон(
				"Имя ""%1"" уже заявлено другим пользователем в пуле ""%2"" (заявка №%3 ждёт решения)",
				ИмяПакета, Пул.Имя, Формат(Цел(Соперница.Идентификатор), "ЧГ=0; ЧН=0")));
		КонецЕсли;
	КонецЦикла;

	КлючХранилища = Строка(Новый УникальныйИдентификатор) + ".ospx";
	Попытка
		Результат = Хранилище.Сохранить(КоординатыЗаявки(Пул.Имя, КлючХранилища), ВременныйПуть);
	Исключение
		Возврат Отказ(500,
			"Не удалось принять артефакт во «входящие»: " + Ошибки.ДляЧеловека(ИнформацияОбОшибке()));
	КонецПопытки;

	Заявка = ХранилищеЗаявок.СоздатьЭлемент();
	Заявка.ПулИдентификатор = Пул.Идентификатор;
	Заявка.ИмяПакета = СокрЛП(Строка(ИмяПакета));
	Заявка.ИмяНижнийРегистр = Канон;
	Заявка.Версия = СокрЛП(Строка(Версия));
	Заявка.ЗаявительИдентификатор = Цел(Заявитель.Идентификатор);
	Заявка.Состояние = СостояниеОжидает();
	Заявка.Создана = ТекущаяУниверсальнаяДата();
	Заявка.Рассмотрена = '00010101';
	Заявка.РассмотрелИдентификатор = 0;
	Заявка.ИмяФайла = СокрЛП(Строка(ИмяФайла));
	Заявка.Канал = ?(Канал = Неопределено, "", СокрЛП(Строка(Канал)));
	Заявка.АвторМанифеста = ?(АвторМанифеста = Неопределено, "", СокрЛП(Строка(АвторМанифеста)));
	Заявка.Размер = Цел(Результат.Размер);
	Заявка.Sha256 = Строка(Результат.Sha256);
	Заявка.КлючХранилища = КлючХранилища;
	Заявка.Комментарий = "";
	Заявка.Сохранить();

	// артефакт заявки лежит в области пула и место пула занимает: счётчик ведёт тот,
	// кто пишет байты, — иначе «входящие» были бы дырой мимо квоты
	Занятое.Учесть(Пул, Цел(Результат.Размер), "приём заявки");

	Возврат Принято(Заявка, Пул, Ложь);

КонецФункции

// Возвращает заявку по идентификатору.
//
// ВНИМАНИЕ: читающие методы этого класса авторизации НЕ спрашивают — так задумано, её
// держит РассмотрениеВходящих. Новый вызывающий обязан идти через него; прямое обращение
// из контроллера отдаст чужие данные любому, кто позвал.
//
// Параметры:
//  Идентификатор - Число - идентификатор заявки.
//
// Возвращаемое значение:
//  ВходящаяПубликация, Неопределено - найденная заявка.
//
Функция Заявка(Знач Идентификатор) Экспорт
	Возврат ХранилищеЗаявок.ПолучитьОдноПоИдентификаторРавно(Цел(Идентификатор));
КонецФункции

// Возвращает ожидающие решения заявки пула. Авторизации не спрашивает — см. Заявка.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация - ожидающие заявки.
//
Функция ОжидающиеПула(Знач ПулИдентификатор) Экспорт
	Возврат ХранилищеЗаявок.ЗаявкиПулаВСостоянии(Цел(ПулИдентификатор), СостояниеОжидает());
КонецФункции

// Возвращает ожидающие решения заявки всех пулов одной выборкой. Авторизации не спрашивает —
// см. Заявка; отбор по праву делает вызывающий.
//
// Возвращаемое значение:
//  Массив из ВходящаяПубликация - ожидающие заявки хаба.
//
Функция ОжидающиеВсехПулов() Экспорт
	Возврат ХранилищеЗаявок.ЗаявкиВСостоянии(СостояниеОжидает());
КонецФункции

// Возвращает байты артефакта заявки. Авторизации не спрашивает — см. Заявка.
//
// Параметры:
//  Заявка - ВходящаяПубликация - заявка.
//  ИмяПула - Строка - имя пула заявки.
//
// Возвращаемое значение:
//  ДвоичныеДанные - содержимое .ospx.
//
Функция ДанныеЗаявки(Знач Заявка, Знач ИмяПула) Экспорт
	Возврат Хранилище.ПолучитьДанные(
		КоординатыЗаявки(ИмяПула, Заявка.КлючХранилища), Заявка.Sha256);
КонецФункции

// Завершает заявку: фиксирует состояние, рассмотревшего и комментарий. Артефакт из
// «входящих» удаляется всегда — при одобрении байты уже перенесены публикацией, при
// отклонении хранилище иначе копило бы отвергнутое.
//
// Параметры:
//  Заявка - ВходящаяПубликация - заявка.
//  ИмяПула - Строка - имя пула заявки.
//  Состояние - Строка - одобрена либо отклонена.
//  КемИд - Число - идентификатор рассмотревшего.
//  Комментарий - Строка - пояснение (необязательный, по умолчанию "").
//
Процедура Завершить(Знач Заявка, Знач ИмяПула, Знач Состояние, Знач КемИд, Знач Комментарий = "") Экспорт

	Заявка.Состояние = НРег(СокрЛП(Строка(Состояние)));
	Заявка.Рассмотрена = ТекущаяУниверсальнаяДата();
	Заявка.РассмотрелИдентификатор = Цел(КемИд);
	Заявка.Комментарий = ?(Комментарий = Неопределено, "", СокрЛП(Строка(Комментарий)));
	Заявка.Сохранить();

	УдалитьАртефакт(Заявка, ИмяПула);

КонецПроцедуры

// Удаляет артефакт заявки из «входящих». Best-effort: решение по заявке уже принято,
// и падение уборки его не отменяет.
//
// Параметры:
//  Заявка - ВходящаяПубликация - заявка.
//  ИмяПула - Строка - имя пула заявки.
//
Процедура УдалитьАртефакт(Знач Заявка, Знач ИмяПула) Экспорт
	Координаты = КоординатыЗаявки(ИмяПула, Заявка.КлючХранилища);
	Попытка
		Снимается = ?(Хранилище.Существует(Координаты), Цел(Число(Хранилище.Размер(Координаты))), 0);
		Хранилище.Удалить(Координаты);
	Исключение
		Возврат; // уборка вторична — состояние заявки важнее
	КонецПопытки;
	// снятые байты возвращаются пулу: их занял приём заявки
	Занятое.Учесть(ПулПоИдентификатору(Заявка.ПулИдентификатор), -Снимается, "снятие заявки");
КонецПроцедуры

// Возвращает состояние «ожидает». Словарь принадлежит сущности, сервис его пересказывает,
// чтобы вызывающие не сравнивали строки руками.
//
// Возвращаемое значение:
//  Строка - имя состояния.
//
Функция СостояниеОжидает() Экспорт
	Возврат Образец().СостояниеОжидает();
КонецФункции

// Возвращает состояние «одобрена».
//
// Возвращаемое значение:
//  Строка - имя состояния.
//
Функция СостояниеОдобрена() Экспорт
	Возврат Образец().СостояниеОдобрена();
КонецФункции

// Возвращает состояние «отклонена».
//
// Возвращаемое значение:
//  Строка - имя состояния.
//
Функция СостояниеОтклонена() Экспорт
	Возврат Образец().СостояниеОтклонена();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Код 429: это не «нельзя», а «сейчас некуда», и opm печатает сообщение как есть.
Функция ПроверитьВместимость(Знач Пул, Знач Заявитель, Знач Канон)

	ПределПула = Предел("oshub.publish.inbox.max_pending_per_pool");
	ПределАвтора = Предел("oshub.publish.inbox.max_pending_per_user");

	Если ПределПула <= 0 ИЛИ ПределАвтора <= 0 Тогда
		Возврат Отказ(429, СтрШаблон(
			"Приём заявок на публикацию в этом хабе выключен настройкой. Права на пул ""%1"""
			+ " нужно получить у его мейнтейнеров до push.", Пул.Имя));
	КонецЕсли;

	ВПуле = ХранилищеЗаявок.ЗаявкиПулаВСостоянии(Пул.Идентификатор, СостояниеОжидает()).Количество();
	Если ВПуле >= ПределПула Тогда
		Возврат Отказ(429, СтрШаблон(
			"«Входящие» пула ""%1"" заполнены: на рассмотрении уже %2 заявок (предел %3)."
			+ " Дождитесь, пока мейнтейнеры разберут очередь.",
			Пул.Имя, Формат(ВПуле, "ЧГ=0; ЧН=0"), Формат(ПределПула, "ЧГ=0; ЧН=0")));
	КонецЕсли;

	СвоихОжидает = 0;
	Для Каждого Заявка Из ХранилищеЗаявок.ПолучитьПоЗаявительИдентификаторРавно(
		Цел(Заявитель.Идентификатор)) Цикл
		Если Заявка.Ожидает() Тогда
			СвоихОжидает = СвоихОжидает + 1;
		КонецЕсли;
	КонецЦикла;
	Если СвоихОжидает >= ПределАвтора Тогда
		Возврат Отказ(429, СтрШаблон(
			"У вас уже %1 заявок на рассмотрении (предел %2). Дождитесь решения по ним,"
			+ " прежде чем подавать заявку на ""%3"".",
			Формат(СвоихОжидает, "ЧГ=0; ЧН=0"), Формат(ПределАвтора, "ЧГ=0; ЧН=0"), Канон));
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Несобранные настройки — ноль, то есть закрыто: очередь пишет чужие байты в хранилище.
Функция Предел(Знач Ключ)
	Возврат ?(Настройки = Неопределено, 0, Настройки.Целое(Ключ, 0));
КонецФункции

Функция КоординатыЗаявки(Знач ИмяПула, Знач КлючХранилища)
	Возврат Новый КоординатыАртефакта(
		ИмяПула, СлужебноеИмяВходящих(), "входящие", КлючХранилища);
КонецФункции

// Создаётся лениво: на этапе сборки контейнера обращаться к менеджеру сущностей рано.
Функция Образец()
	Если ОбразецЗаявки = Неопределено Тогда
		ОбразецЗаявки = ХранилищеЗаявок.СоздатьЭлемент();
	КонецЕсли;
	Возврат ОбразецЗаявки;
КонецФункции

Функция Принято(Знач Заявка, Знач Пул, Знач Повтор)

	Результат = Новый Структура("Успех, Код, Сообщение, Заявка", Истина, 202, СтрШаблон(
		"Принято во «входящие» пула ""%1"": %2 %3 (заявка №%4%5)."
		+ " Прав на публикацию в этом пуле у вас нет, а имя свободно — поэтому артефакт"
		+ " принят на рассмотрение, но версия ещё НЕ опубликована. Заявку одобряют"
		+ " мейнтейнеры пула; после одобрения версия публикуется, а вы становитесь"
		+ " мейнтейнером пакета.",
		Пул.Имя, Заявка.ИмяПакета, Заявка.Версия,
		Формат(Цел(Заявка.Идентификатор), "ЧГ=0; ЧН=0"),
		?(Повтор, ", уже принята ранее", "")), Заявка);
	Возврат Результат;

КонецФункции

Функция Отказ(Знач Код, Знач Сообщение)
	Возврат Новый Структура("Успех, Код, Сообщение, Заявка", Ложь, Код, Сообщение, Неопределено);
КонецФункции

Функция ПулПоИдентификатору(Знач ПулИдентификатор)
	Возврат ХранилищеПулов.ПолучитьОдноПоИдентификаторРавно(Цел(ПулИдентификатор));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеВходящихПубликаций") _ХранилищеЗаявок,
	&Пластилин(Значение = "ХранилищеАртефактов") _Хранилище,
	&Пластилин(Значение = "ЗаписьЗанятогоМеста") _Занятое,
	&Пластилин(Значение = "ХранилищеПулов") _ХранилищеПулов,
	&Пластилин(Значение = "ПравилаИменования") _Правила,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	ХранилищеЗаявок = _ХранилищеЗаявок;
	Хранилище = _Хранилище;
	Занятое = _Занятое;
	ХранилищеПулов = _ХранилищеПулов;
	Правила = _Правила;
	Настройки = _Настройки;

КонецПроцедуры
