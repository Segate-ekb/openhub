// Глоб-маска рефа доверенного конвейера: «*» — любые символы кроме «/», «**» — включая «/».
// Сверка регистрозависима; пустая маска, пустой реф и управляющие символы совпадения не дают.

Перем Контроль;   // КонтрольСимволов (основа)

#Область ПубличныйИнтерфейс

// Совпадает ли фактический реф с маской записи доверия.
//
// Параметры:
//  Маска - Строка - маска записи: «refs/heads/main», «refs/tags/v*», «refs/heads/release/*», «**».
//  Реф - Строка - значение клейма ref предъявленного id-token.
//
// Возвращаемое значение:
//  Булево - Истина только при совпадении всей строки целиком.
//
Функция Совпадает(Знач Маска, Знач Реф) Экспорт

	Шаблон = Нормализовать(Маска);
	Значение = Нормализовать(Реф);

	// пусто — это отказ, а не «любой»: ошибка обязана быть в сторону отказа, а не выдачи
	// права публиковать
	Если НЕ ЗначениеЗаполнено(Шаблон) ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	// клейм ref с переводом строки или управляющим символом легитимным не бывает
	Если ЕстьУправляющие(Шаблон) ИЛИ ЕстьУправляющие(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	// маска без звёздочек — обычное сравнение строк, и оно регистрозависимо
	Если СтрНайти(Шаблон, "*") = 0 Тогда
		Возврат Шаблон = Значение;
	КонецЕсли;

	Возврат СовпадаетГлоб(Токены(Шаблон), Знаки(Значение));

КонецФункции

// Покрывает ли маска любой реф целиком — так, что приставка «refs/heads/» её сузила бы.
//
// Параметры:
//  Маска - Строка - маска из формы либо записи.
//
// Возвращаемое значение:
//  Булево
//
Функция ПокрываетЛюбойРеф(Знач Маска) Экспорт
	Возврат Нормализовать(Маска) = "**";
КонецФункции

// Ограничивает ли маска только пространство имён, но не само имя: «**», «refs/**»,
// «refs/heads/*», «refs/tags/**». Такая запись означает публикацию с ЛЮБОЙ ветки.
//
// Параметры:
//  Маска - Строка - маска из формы либо записи.
//
// Возвращаемое значение:
//  Булево
//
Функция СлишкомШирокая(Знач Маска) Экспорт

	Значение = Нормализовать(Маска);
	Звёздочка = СтрНайти(Значение, "*");
	Если Звёздочка = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Хвост = Сред(Значение, Звёздочка);
	Если Хвост <> "*" И Хвост <> "**" Тогда
		Возврат Ложь;
	КонецЕсли;

	Приставка = Лев(Значение, Звёздочка - 1);
	Возврат Приставка = "" ИЛИ Приставка = "refs/"
		ИЛИ Приставка = "refs/heads/" ИЛИ Приставка = "refs/tags/";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Двух указателей мало: расти бывает обязана РАННЯЯ звезда («**x*y» против «x/ab/xcy»).
Функция СовпадаетГлоб(Знач Токены, Знач Знаки)

	Длина = Знаки.Количество();

	Пред = Новый Массив(Длина + 1);
	Пред[0] = Истина;
	Для Поз = 1 По Длина Цикл
		Пред[Поз] = Ложь;
	КонецЦикла;

	Для Каждого Токен Из Токены Цикл

		ЭтоЗвезда = Токен.Вид <> ВидЛитерал();
		ЧерезКосую = Токен.Вид = ВидДвезда();
		Знак = Токен.Знак;

		Тек = Новый Массив(Длина + 1);
		// литерал съедает ровно один символ, звезда может не съесть ни одного
		Тек[0] = ЭтоЗвезда И Пред[0];
		Живое = Тек[0];

		Для Поз = 1 По Длина Цикл
			Если НЕ ЭтоЗвезда Тогда
				Тек[Поз] = Пред[Поз - 1] И (Знаки[Поз - 1] = Знак);
			ИначеЕсли ЧерезКосую Тогда
				Тек[Поз] = Пред[Поз] ИЛИ Тек[Поз - 1];
			Иначе
				Тек[Поз] = Пред[Поз] ИЛИ (Тек[Поз - 1] И Знаки[Поз - 1] <> "/");
			КонецЕсли;
			Живое = Живое ИЛИ Тек[Поз];
		КонецЦикла;

		Если НЕ Живое Тогда
			Возврат Ложь;
		КонецЕсли;
		Пред = Тек;

	КонецЦикла;

	Возврат Пред[Длина];

КонецФункции

Функция Токены(Знач Шаблон)

	Результат = Новый Массив();
	Позиция = 1;

	Пока Позиция <= СтрДлина(Шаблон) Цикл
		Символ = Сред(Шаблон, Позиция, 1);
		Если Символ <> "*" Тогда
			Результат.Добавить(Новый Структура("Вид, Знак", ВидЛитерал(), Символ));
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Если Сред(Шаблон, Позиция + 1, 1) = "*" Тогда
			Результат.Добавить(Новый Структура("Вид, Знак", ВидДвезда(), ""));
			Позиция = Позиция + 2;
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Вид, Знак", ВидЗвезда(), ""));
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Знаки(Знач Значение)

	Результат = Новый Массив();
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Результат.Добавить(Сред(Значение, Позиция, 1));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЕстьУправляющие(Знач Значение)
	Возврат Контроль.ЕстьУправляющий(Значение);
КонецФункции

Функция ВидЛитерал()
	Возврат 0;
КонецФункции

Функция ВидЗвезда()
	Возврат 1;
КонецФункции

Функция ВидДвезда()
	Возврат 2;
КонецФункции

Функция Нормализовать(Знач Значение)
	Возврат СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
КонецФункции

#КонецОбласти

&Прозвище("МаскаРефа")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "КонтрольСимволов") _Контроль = Неопределено) Экспорт

	Контроль = ?(_Контроль = Неопределено, Новый КонтрольСимволов(), _Контроль);
КонецПроцедуры
