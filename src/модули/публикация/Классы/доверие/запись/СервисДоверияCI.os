// Доверенные конвейеры — третий путь к праву на push: не роль человека и не легаси-токен
// GitHub, а доверие конкретному workflow конкретного репозитория. CI предъявляет
// короткоживущий OIDC id-token своего провайдера, и долгоживущего PAT в секретах
// репозитория не нужно вовсе.
//
// Сверка клеймов закрытая: разрешение даёт только последняя строка. Сначала подпись —
// клеймы неподписанного токена ничего не значат, — затем срок, затем aud, затем издатель,
// репозиторий, реф и (если задан в записи) конвейер. Пустое поле записи означает «любое
// значение» ТОЛЬКО для конвейера: реф — глоб-маска, и пустая маска не совпадает ни с чем.
//
// aud сверяется с настройкой ХАБА, а не с полем записи: иначе владелец пакета ослаблял бы
// проверку у себя и принимал бы токен, выпущенный доверенным репозиторием для чужого сервиса.
//
// Доверие настраивается на СУЩЕСТВУЮЩЕМ пакете и потому не способ занять свободное имя:
// первую публикацию закрывают резервирование имени или очередь заявок.

Перем ХранилищеДоверия;   // ХранилищеДоверияCI (данные)
Перем ХранилищеЛюдей;     // ХранилищеПользователей (данные) — автор записи доверия
Перем ИменаЖурнала;              // ИмяОбъектаАудита (аудит) — вид объекта в журнале
Перем СервисПакетов;      // СервисПакетов
Перем СервисПрав;         // СервисПрав (auth)
Перем ПроверяющийПодписи; // ПроверяющийПодписиCI
Перем ГвардКлюча;         // ГвардКлюча (auth), может быть Неопределено
Перем ШинаСобытий;        // ИздательСобытий (события); опциональна
Перем Аудитория;          // АудиторияТокенаCI — ожидаемый aud и сверка с ним
Перем СтражИздателей;     // СтражИздателейCI, может быть Неопределено
Перем КороткаяФорма;      // КороткаяФормаДоверия — достройка коротких значений формы
Перем Имена;              // ИмяЗаписиДоверия — человекочитаемое имя записи
Перем Маски;              // МаскаРефа — сверка фактического рефа с маской записи
Перем Виды;               // ВидРефаДоверия — словарь видов рефа формы и API
Перем Срок;               // СрокТокенаCI — exp, nbf и допуск на расхождение часов
Перем ОбразецДоверия;     // ДовериеCI, несохраняемый носитель словаря провайдеров
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Проверяет, похоже ли значение на id-token конвейера — компактный JWS из трёх сегментов.
// Нужна, чтобы push отличил CI-токен от PAT в том же заголовке OAUTH-TOKEN и не требовал
// от конвейера модифицированного клиента: PAT хаба трёх сегментов через точку не содержит.
//
// Параметры:
//  Значение - Строка - предъявленный токен.
//
// Возвращаемое значение:
//  Булево - Истина, если значение похоже на id-token.
//
Функция ЭтоТокенКонвейера(Знач Значение) Экспорт

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Части = СтрРазделить(СокрЛП(Строка(Значение)), ".", Истина);
	Если Части.Количество() <> 3 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗначениеЗаполнено(Части[0]) И ЗначениеЗаполнено(Части[1]);

КонецФункции

// Решает, разрешает ли доверенный конвейер публикацию версии этого пакета.
//
// Параметры:
//  Пакет - Пакет, Неопределено - существующий пакет; Неопределено — доверие неприменимо.
//  Токен - Строка - предъявленный id-token.
//
// Возвращаемое значение:
//  Структура - Разрешено (Булево), Причина (Строка: "" при разрешении, иначе текст для
//              ответа push), Конвейер (Строка: описание сработавшего доверия для аудита).
//
Функция РазрешаетПубликацию(Знач Пакет, Знач Токен) Экспорт

	Перем Клеймы;

	Если Пакет = Неопределено Тогда
		// заявка во «входящие» здесь не называется: она принимает только аутентифицированного
		// человека, и до неё исполнение при ненулевом вердикте конвейера не доходит
		Возврат Вердикт(Ложь, "доверенные конвейеры настраиваются на существующем пакете:"
			+ " первую версию под новым именем публикует человек своим ключом доступа —"
			+ " либо имя заводится резервированием на экране пакета");
	КонецЕсли;

	Записи = ХранилищеДоверия.ПолучитьПоПакетИдентификаторРавно(Цел(Пакет.Идентификатор));
	Если Записи.Количество() = 0 Тогда
		Возврат Вердикт(Ложь, СтрШаблон(
			"для пакета ""%1"" не настроено ни одного доверенного конвейера", Пакет.Имя));
	КонецЕсли;

	// подпись первой: сверять клеймы раньше значит подсказывать, какие значения подошли бы.
	// Чьими ключами проверять — решают ЗАПИСИ пакета, а не предъявленный токен
	Проверка = ПодтвердитьПодпись(Токен, Записи);
	Если Проверка.Достоверна <> Истина Тогда
		Возврат Вердикт(Ложь, Проверка.Причина);
	КонецЕсли;

	// дальше решение принимается ТОЛЬКО по клеймам, вернувшимся вместе с подписью
	Клеймы = Проверка.Клеймы;
	Издатель = Канонизировать(Клейм(Клеймы, "iss"));

	СрокОтказ = Срок.ПричинаОтказа(Клеймы);
	Если ЗначениеЗаполнено(СрокОтказ) Тогда
		Возврат Вердикт(Ложь, СрокОтказ);
	КонецЕсли;

	АудиторияОтказ = Аудитория.ПричинаОтказа(Клеймы);
	Если ЗначениеЗаполнено(АудиторияОтказ) Тогда
		Возврат Вердикт(Ложь, АудиторияОтказ);
	КонецЕсли;

	Для Каждого Запись Из Записи Цикл
		Если Совпадает(Запись, Клеймы, Издатель) Тогда
			Возврат Вердикт(Истина, "", ОписаниеЗаписи(Запись));
		КонецЕсли;
	КонецЦикла;

	Возврат Вердикт(Ложь, СтрШаблон(
		"клеймы id-token не совпали ни с одним доверенным конвейером пакета ""%1"""
		+ " (издатель %2, репозиторий %3)", Пакет.Имя, Издатель,
		?(ЗначениеЗаполнено(РепозиторийИзКлеймов(Клеймы)), РепозиторийИзКлеймов(Клеймы), "не указан")));

КонецФункции

// Возвращает доверенные конвейеры пакета.
//
// Параметры:
//  Пакет - Пакет, Неопределено - пакет.
//
// Возвращаемое значение:
//  Массив из ДовериеCI - записи доверия.
//
Функция КонвейерыПакета(Знач Пакет) Экспорт
	Если Пакет = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат ХранилищеДоверия.ПолучитьПоПакетИдентификаторРавно(Цел(Пакет.Идентификатор));
КонецФункции

// Доверенные конвейеры пакета вместе с автором каждой записи — для экрана и API.
//
// Параметры:
//  Пакет - Пакет, Неопределено - пакет.
//
// Возвращаемое значение:
//  Массив из Структура - Доверие (ДовериеCI), Автор (Пользователь либо Неопределено).
//
Функция СтрокиПакета(Знач Пакет) Экспорт

	Результат = Новый Массив();
	Для Каждого Запись Из КонвейерыПакета(Пакет) Цикл
		Результат.Добавить(Новый Структура("Доверие, Автор", Запись, Автор(Запись)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Провайдеры, которым хаб умеет доверять. Словарь один — на сущности; экран и API
// спрашивают его здесь, чтобы второй копии значений колонки не появилось.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ДопустимыеПровайдеры() Экспорт
	Возврат Образец().ДопустимыеПровайдеры();
КонецФункции

// Каноническое значение провайдера «GitLab CI».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПровайдерGitLab() Экспорт
	Возврат Образец().ПровайдерGitLab();
КонецФункции

// Вправе ли человек настраивать доверенные конвейеры пакета: порог — мейнтейнер пакета
// и выше. Управления пакетом (порог дома настроек) для этого мало.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - смотрящий.
//  Пакет - Пакет, Неопределено - пакет.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетНастраивать(Знач Пользователь, Знач Пакет) Экспорт

	Если Пользователь = Неопределено ИЛИ Пакет = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СервисПрав.РольНеНиже(Пользователь, СервисПрав.ОбъектПакет(Пакет),
		СервисПрав.РольМейнтейнер());

КонецФункции

// Добавляет доверие конвейеру для пакета. Идемпотентна: совпадающая запись не дублируется.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  Пакет - Пакет, Неопределено - пакет.
//  Провайдер - Строка - github либо gitlab.
//  Издатель - Строка - ожидаемый клейм iss, обязателен.
//  Репозиторий - Строка - owner/repo у GitHub либо group/project у GitLab, обязателен.
//  Конвейер - Строка - имя файла workflow либо полное значение клейма, "" — любой
//             (необязательный, по умолчанию "").
//  Реф - Строка - имя ветки или тега, глоб-маска («v*», «**») либо полный ref; обязателен.
//  ВидРефа - Строка - «тег» либо «tag», если короткий реф достраивать тегом; «ветка»,
//            «branch» и пустое значение — веткой; иное значение отвергается
//            (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка), Доверие (ДовериеCI,
//              присутствует только при успехе).
//
Функция Доверить(Знач Принципал, Знач Пакет, Знач Провайдер, Знач Издатель,
	Знач Репозиторий, Знач Конвейер = "", Знач Реф, Знач ВидРефа = "") Экспорт

	Допуск = Допустить(Принципал, Пакет, "изменение");
	Если НЕ Допуск.Успех Тогда
		Возврат Допуск;
	КонецЕсли;

	НормПровайдер = НРег(СокрЛП(Строка(Провайдер)));
	Если Образец().ДопустимыеПровайдеры().Найти(НормПровайдер) = Неопределено Тогда
		Возврат Отказ(400, СтрШаблон("Неизвестный провайдер ""%1"": ожидается %2",
			Провайдер, СтрСоединить(Образец().ДопустимыеПровайдеры(), ", ")));
	КонецЕсли;

	// издатель в форме не спрашивается: у типа репозитория он один, а инсталляции
	// с несколькими издателями одного типа выбирают его явно
	НормИздатель = Канонизировать(?(ЗначениеЗаполнено(СокрЛП(Строка(Издатель))), Издатель,
		ИздательПровайдера(НормПровайдер)));
	НормРепозиторий = НРег(СокрЛП(Строка(Репозиторий)));
	Если НЕ ЗначениеЗаполнено(НормИздатель) ИЛИ НЕ ЗначениеЗаполнено(НормРепозиторий) Тогда
		Возврат Отказ(400,
			"Издатель (iss) и репозиторий обязательны: доверие без них означало бы"
			+ " «публиковать вправе любой конвейер любого репозитория»");
	КонецЕсли;

	// по издателю пойдёт САМ ХАБ — за ключами, поэтому список закрытый и его держит хаб,
	// а не тот, кто заполняет форму
	ВердиктИздателя = ДопустимИздатель(НормИздатель);
	Если ВердиктИздателя.Ок <> Истина Тогда
		Возврат Отказ(400, "Издатель не принят: " + ВердиктИздателя.Ошибка);
	КонецЕсли;

	ОтказКонвейера = КороткаяФорма.ПричинаОтказаКонвейера(НормПровайдер, Конвейер);
	Если ЗначениеЗаполнено(ОтказКонвейера) Тогда
		Возврат Отказ(400, "Конвейер не принят: " + ОтказКонвейера);
	КонецЕсли;

	// в записи живёт КАНОНИЧЕСКАЯ форма: клейм приезжает полным, и сверка — сравнение строк
	НормКонвейер = КороткаяФорма.Конвейер(НормПровайдер, НормИздатель, НормРепозиторий, Конвейер);
	// нераспознанный вид рефа — отказ, а не «значит ветка»: молча понятый наоборот «tag»
	// давал бы запись refs/heads/v*, которая не совпадёт никогда
	НормВид = Виды.Распознать(ВидРефа);
	Если НЕ ЗначениеЗаполнено(НормВид) Тогда
		Возврат Отказ(400, Виды.ПричинаОтказа(ВидРефа));
	КонецЕсли;

	НормРеф = КороткаяФорма.Реф(Реф, НормВид = Виды.Тег());
	Если НЕ ЗначениеЗаполнено(НормРеф) Тогда
		Возврат Отказ(400,
			"Ветка, тег или маска обязательны: запись с пустым рефом означала бы"
			+ " «публиковать вправе любая ветка доверенного репозитория» — это и есть атака"
			+ " через форк. Назовите ветку («main»), тег, маску («v*», «release/*») либо"
			+ " «**», если «любой реф» написан осознанно");
	КонецЕсли;

	Существующее = НайтиСовпадающее(Пакет, НормПровайдер, НормИздатель, НормРепозиторий,
		НормКонвейер, НормРеф);
	Если Существующее <> Неопределено Тогда
		Результат = Успех(200, "Такой доверенный конвейер уже настроен");
		Результат.Вставить("Доверие", Существующее);
		Возврат Результат;
	КонецЕсли;

	Запись = ХранилищеДоверия.СоздатьЭлемент();
	Запись.ПакетИдентификатор = Цел(Пакет.Идентификатор);
	Запись.ПулИдентификатор = Цел(Пакет.ПулИдентификатор);
	Запись.Провайдер = НормПровайдер;
	Запись.Издатель = НормИздатель;
	Запись.Репозиторий = НормРепозиторий;
	Запись.Конвейер = НормКонвейер;
	Запись.Реф = НормРеф;
	Запись.Создано = ТекущаяУниверсальнаяДата();
	Запись.КемСоздано = Цел(Допуск.Пользователь.Идентификатор);
	Запись.Сохранить();

	Лог.Информация("Доверенный конвейер добавлен пакету %1: %2", Пакет.Имя, ОписаниеЗаписи(Запись));
	ЗаписатьВАудит("доверие.выдано", Пакет, Запись, Допуск.Пользователь);

	Результат = Успех(201, СтрШаблон("Конвейер %1 теперь вправе публиковать пакет ""%2""",
		ОписаниеЗаписи(Запись), Пакет.Имя));
	Результат.Вставить("Доверие", Запись);
	Возврат Результат;

КонецФункции

// Отзывает доверие конвейеру.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  Пакет - Пакет, Неопределено - пакет.
//  ДовериеИдентификатор - Число - идентификатор записи доверия.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка).
//
Функция ОтозватьДоверие(Знач Принципал, Знач Пакет, Знач ДовериеИдентификатор) Экспорт

	Допуск = Допустить(Принципал, Пакет, "удаление");
	Если НЕ Допуск.Успех Тогда
		Возврат Допуск;
	КонецЕсли;

	Запись = ХранилищеДоверия.ПолучитьОдноПоИдентификаторРавно(Цел(ДовериеИдентификатор));
	// принадлежность сверяется по сущности, а не по присланному клиентом: иначе мейнтейнер
	// своего пакета снимал бы доверие с чужого, назвав его идентификатор
	Если Запись = Неопределено ИЛИ Цел(Запись.ПакетИдентификатор) <> Цел(Пакет.Идентификатор) Тогда
		Возврат Отказ(404, "Доверенный конвейер не найден у этого пакета");
	КонецЕсли;

	// след снимается до удаления, чтобы не зависеть от того, что бэкенд оставляет
	// в удалённой сущности; штатные коннекторы значения сохраняют, и тест это не различит
	Лог.Информация("Доверие конвейеру отозвано у пакета %1: %2", Пакет.Имя, ОписаниеЗаписи(Запись));
	ЗаписатьВАудит("доверие.отозвано", Пакет, Запись, Допуск.Пользователь);
	ХранилищеДоверия.Удалить(Запись);
	Возврат Успех(200, "Доверие конвейеру отозвано");

КонецФункции

// Аудитория, которую хаб ждёт в клейме `aud` id-token. Спрашивается и сверкой клеймов,
// и готовым конвейером на экране: две копии этого правила разошлись бы, и сниппет выдавал
// бы пайплайн с гарантированным отказом по aud.
//
// Возвращаемое значение:
//  Строка - канонический адрес аудитории; "" — хаб не знает, для кого выпускается его
//           id-token, и доверенные конвейеры не публикуют вовсе.
//
Функция ОжидаемаяАудитория() Экспорт
	Возврат Аудитория.Ожидаемая();
КонецФункции

// Человекочитаемое имя записи доверия — одно на журнал, аудит, экран и диалог
// подтверждения: две записи одного репозитория различает конвейер, поэтому он в имени есть.
//
// Параметры:
//  Запись - ДовериеCI - запись доверия.
//
// Возвращаемое значение:
//  Строка - «github:acme/lib/release.yml@refs/heads/main».
//
Функция ОписаниеЗаписи(Знач Запись) Экспорт
	Возврат Имена.Составить(Запись.Провайдер, Запись.Издатель, Запись.Репозиторий,
		Запись.Конвейер, Запись.Реф);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Общий пролог мутаций: пакет существует, рамки ключа пропускают, человек — мейнтейнер
// пакета. Доступ даёт только последняя строка.
Функция Допустить(Знач Принципал, Знач Пакет, Знач Действие)

	Если Пакет = Неопределено Тогда
		Возврат Отказ(404, "Пакет не найден");
	КонецЕсли;
	Если ГвардКлюча = Неопределено Тогда
		Возврат Отказ(403, "Настройка доверенных конвейеров недоступна: гейт ключа доступа не собран");
	КонецЕсли;
	ВердиктКлюча = ГвардКлюча.Пропустить(Принципал, Действие, Цел(Пакет.ПулИдентификатор));
	Если НЕ ВердиктКлюча.Разрешено Тогда
		Возврат Отказ(403, "Настройка доверенных конвейеров запрещена ключом доступа: "
			+ ГвардКлюча.ОписаниеПричины(ВердиктКлюча.Причина));
	КонецЕсли;

	Пользователь = ПользовательПринципала(Принципал);
	Если Пользователь = Неопределено Тогда
		Возврат Отказ(401, "Требуется аутентификация");
	КонецЕсли;
	Если НЕ МожетНастраивать(Пользователь, Пакет) Тогда
		Возврат Отказ(403, СтрШаблон(
			"Доверенные конвейеры пакета ""%1"" настраивают его мейнтейнеры и выше", Пакет.Имя));
	КонецЕсли;

	Результат = Успех(200, "");
	Результат.Вставить("Пользователь", Пользователь);
	Возврат Результат;

КонецФункции

// Токен предъявляется ключам каждого издателя записей пакета, пока один не подтвердит
// подпись: издатель почти всегда один, ключи кэшируются на процесс. Причина отказа издателей
// не называет — предъявителю токена состав доверия пакета знать незачем.
Функция ПодтвердитьПодпись(Знач Токен, Знач Записи)

	Причина = "";
	Пробовали = 0;
	Для Каждого Запись Из Записи Цикл
		Издатель = Канонизировать(Запись.Издатель);
		Если НЕ ЗначениеЗаполнено(Издатель) Тогда
			Продолжить;
		КонецЕсли;
		Проверка = ПроверяющийПодписи.ПроверитьТокен(СокрЛП(Строка(Токен)), Издатель);
		Если Проверка.Достоверна = Истина Тогда
			Возврат Проверка;
		КонецЕсли;
		Пробовали = Пробовали + 1;
		Причина = Проверка.Причина;
	КонецЦикла;

	Возврат Новый Структура("Достоверна, Причина, Клеймы", Ложь,
		"подпись id-token не подтверждена"
		+ ?(Пробовали = 1 И ЗначениеЗаполнено(Причина), ": " + Причина, ""), Неопределено);

КонецФункции

// Каждое заполненное поле записи обязано совпасть; пустым бывает только Конвейер.
Функция Совпадает(Знач Запись, Знач Клеймы, Знач Издатель)

	Если НРег(СокрЛП(Строка(Запись.Издатель))) <> Издатель Тогда
		Возврат Ложь;
	КонецЕсли;

	ФактРепозиторий = РепозиторийИзКлеймов(Клеймы);
	Если НЕ ЗначениеЗаполнено(ФактРепозиторий)
		ИЛИ НРег(ФактРепозиторий) <> НРег(СокрЛП(Строка(Запись.Репозиторий))) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ЗначениеЗаполнено(Запись.Конвейер) Тогда
		ФактКонвейер = КонвейерИзКлеймов(Клеймы, Запись.Провайдер);
		Если НЕ КонвейерСовпадает(ФактКонвейер, Строка(Запись.Конвейер)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	// реф сверяется ВСЕГДА: пустая маска в записи даёт несовпадение, а не пропуск —
	// ошибка обязана быть в сторону отказа, а не выдачи права публиковать
	Если НЕ Маски.Совпадает(Запись.Реф, Клейм(Клеймы, "ref")) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Хвост «@ref» отбрасывается: реф сверяется отдельным полем записи, и склеенный хвост
// заставлял бы записывать ветку дважды.
Функция КонвейерСовпадает(Знач Фактический, Знач Ожидаемый)
	Возврат ЗначениеЗаполнено(Фактический)
		И НРег(БезРефа(Фактический)) = НРег(БезРефа(Ожидаемый));
КонецФункции

Функция БезРефа(Знач Значение)
	Части = СтрРазделить(Строка(Значение), "@", Истина);
	Если Части.Количество() < 2 Тогда
		Возврат СокрЛП(Строка(Значение));
	КонецЕсли;
	// хвост — только последний сегмент: «@» в самом пути конвейера теоретически возможен
	Части.Удалить(Части.Количество() - 1);
	Возврат СокрЛП(СтрСоединить(Части, "@"));
КонецФункции

// Сверяется ВЕРХНЕУРОВНЕВЫЙ конвейер своего репозитория: у GitHub это `workflow_ref`,
// у GitLab — `ci_config_ref_uri` (документация называет его ref-путём определения
// пайплайна верхнего уровня). Клейм `job_workflow_ref`, указывающий на файл, где определён
// job, НЕ используется: при вызове reusable он показывает на чужой репозиторий, а доверие
// у нас означает «публикация разрешена из вот этого файла в вот этом моём репозитории».
Функция КонвейерИзКлеймов(Знач Клеймы, Знач Провайдер)
	Если НРег(СокрЛП(Строка(Провайдер))) = Образец().ПровайдерGitLab() Тогда
		Возврат Клейм(Клеймы, "ci_config_ref_uri");
	КонецЕсли;
	Возврат Клейм(Клеймы, "workflow_ref");
КонецФункции

// GitHub кладёт репозиторий в `repository`, GitLab — в `project_path`. Читаем оба и не
// спрашиваем провайдера, чтобы его подмена в записи не превращала отказ в разрешение.
Функция РепозиторийИзКлеймов(Знач Клеймы)
	Значение = Клейм(Клеймы, "repository");
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, Клейм(Клеймы, "project_path"));
КонецФункции

Функция ДопустимИздатель(Знач Издатель)
	Если СтражИздателей = Неопределено Тогда
		Возврат Новый Структура("Ок, Ошибка", Ложь,
			"страж издателей не собран — непроверенного издателя не принимаем");
	КонецЕсли;
	Возврат СтражИздателей.ДопустимИздатель(Издатель);
КонецФункции

// Канонизацию держит страж — она же решает, совпал ли издатель со списком хаба. Без стража
// возвращается пустая строка, и это fail-closed: пустой издатель не сверяется и не пишется.
Функция Канонизировать(Знач Значение)
	Возврат ?(СтражИздателей = Неопределено, "", СтражИздателей.Нормализовать(Значение));
КонецФункции

Функция ИздательПровайдера(Знач Провайдер)
	Возврат ?(СтражИздателей = Неопределено, "", СтражИздателей.ИздательПоУмолчанию(Провайдер));
КонецФункции

Функция Клейм(Знач Клеймы, Знач Имя)
	Значение = Клеймы.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
КонецФункции

Функция НайтиСовпадающее(Знач Пакет, Знач Провайдер, Знач Издатель, Знач Репозиторий,
	Знач Конвейер, Знач Реф)

	Для Каждого Запись Из ХранилищеДоверия.ПолучитьПоПакетИдентификаторРавно(Цел(Пакет.Идентификатор)) Цикл
		Если НРег(СокрЛП(Строка(Запись.Провайдер))) = Провайдер
			И НРег(СокрЛП(Строка(Запись.Издатель))) = Издатель
			И НРег(СокрЛП(Строка(Запись.Репозиторий))) = Репозиторий
			И НРег(СокрЛП(Строка(Запись.Конвейер))) = НРег(Конвейер)
			И СокрЛП(Строка(Запись.Реф)) = Реф Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция Автор(Знач Запись)
	Если Цел(Запись.КемСоздано) <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ХранилищеЛюдей.ПолучитьОдноПоИдентификаторРавно(Цел(Запись.КемСоздано));
КонецФункции

// Доверенный конвейер — это выданное право публиковать пакет, поэтому его заведение
// и отзыв обязаны оставлять след, как и выдача роли. Событие «под журнал»: подписчику
// пакета оно не предлагается.
Процедура ЗаписатьВАудит(Знач Действие, Знач Пакет, Знач Запись, Знач Кто)

	Если ШинаСобытий = Неопределено Тогда
		Лог.Предупреждение("Аудит доверенных конвейеров отключён: издатель событий не собран"
			+ " в контейнере. Изменение доверия (%1) в журнал НЕ ПОПАЛО", Действие);
		Возврат;
	КонецЕсли;

	Детали = Новый Структура();
	Детали.Вставить("конвейер", ОписаниеЗаписи(Запись));
	Детали.Вставить("провайдер", Строка(Запись.Провайдер));
	Детали.Вставить("издатель", Строка(Запись.Издатель));
	Детали.Вставить("репозиторий", Строка(Запись.Репозиторий));
	Детали.Вставить("реф", Строка(Запись.Реф));

	Данные = Новый Структура();
	Данные.Вставить("Кто", ?(Кто = Неопределено, ИменаЖурнала.Система(), Строка(Кто.Логин)));
	Данные.Вставить("Действие", Действие);
	Данные.Вставить("Объект", ИменаЖурнала.Пакет(Пакет.Идентификатор));
	Данные.Вставить("ДеталиJSON", ВJSON(Детали));
	Данные.Вставить("АдресIP", "");

	ШинаСобытий.Опубликовать(ШинаСобытий.ТипДовериеИзменено(), Данные);

КонецПроцедуры

Функция ВJSON(Знач Данные)
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

// Создаётся лениво: на этапе сборки контейнера обращаться к менеджеру сущностей рано.
Функция Образец()
	Если ОбразецДоверия = Неопределено Тогда
		ОбразецДоверия = ХранилищеДоверия.СоздатьЭлемент();
	КонецЕсли;
	Возврат ОбразецДоверия;
КонецФункции

Функция ПользовательПринципала(Знач Принципал)
	Если Принципал = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Значение = Неопределено;
	Если Принципал.Свойство("Пользователь", Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция Вердикт(Знач Разрешено, Знач Причина, Знач Конвейер = "")
	Возврат Новый Структура("Разрешено, Причина, Конвейер", Разрешено, Причина, Конвейер);
КонецФункции

Функция Успех(Знач Код, Знач Сообщение)
	Возврат Новый Структура("Успех, Код, Сообщение", Истина, Код, Сообщение);
КонецФункции

Функция Отказ(Знач Код, Знач Сообщение)
	Возврат Новый Структура("Успех, Код, Сообщение", Ложь, Код, Сообщение);
КонецФункции

#КонецОбласти

// Второй вход для лога: класс создают напрямую в юнит-тестах, и инъекция в поле там
// не доезжает.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеДоверияCI") _ХранилищеДоверия,
	&Пластилин(Значение = "ХранилищеПользователей") _ХранилищеЛюдей,
	&Пластилин(Значение = "ИмяОбъектаАудита") _ИменаЖурнала,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ПроверяющийПодписиCI") _ПроверяющийПодписи,
	&Пластилин(Значение = "ГвардКлюча") _ГвардКлюча = Неопределено,
	&Пластилин(Значение = "ИздательСобытий") _Издатель = Неопределено,
	&Пластилин(Значение = "АудиторияТокенаCI") _Аудитория,
	&Пластилин(Значение = "СтражИздателейCI") _СтражИздателей = Неопределено,
	&Пластилин(Значение = "КороткаяФормаДоверия") _КороткаяФорма,
	&Пластилин(Значение = "ИмяЗаписиДоверия") _Имена,
	&Пластилин(Значение = "МаскаРефа") _Маски,
	&Пластилин(Значение = "ВидРефаДоверия") _Виды,
	&Пластилин(Значение = "СрокТокенаCI") _Срок,
	&Лог _Лог = Неопределено)

	ХранилищеДоверия = _ХранилищеДоверия;
	ХранилищеЛюдей = _ХранилищеЛюдей;
	ИменаЖурнала = _ИменаЖурнала;
	СервисПакетов = _СервисПакетов;
	СервисПрав = _СервисПрав;
	ПроверяющийПодписи = _ПроверяющийПодписи;
	ГвардКлюча = _ГвардКлюча;
	ШинаСобытий = _Издатель;
	Аудитория = _Аудитория;
	СтражИздателей = _СтражИздателей;
	КороткаяФорма = _КороткаяФорма;
	Имена = _Имена;
	Маски = _Маски;
	Виды = _Виды;
	Срок = _Срок;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
