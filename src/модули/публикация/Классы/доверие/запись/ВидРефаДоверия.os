// Вид рефа записи доверия: канонические значения формы, синонимы API и вид, предлагаемый
// по самому значению рефа. Словарь один на экран, API и домен.

#Область ПубличныйИнтерфейс

// Каноническое значение вида «ветка».
//
// Возвращаемое значение:
//  Строка.
//
Функция Ветка() Экспорт
	Возврат "ветка";
КонецФункции

// Каноническое значение вида «тег».
//
// Возвращаемое значение:
//  Строка.
//
Функция Тег() Экспорт
	Возврат "тег";
КонецФункции

// Приводит присланный вид рефа к каноническому значению. Английские синонимы приняты
// наравне с русскими: ключи тела API английские, и «tag», молча понятый как ветка, дал бы
// запись refs/heads/v*, которая не совпадёт никогда. Нераспознанное значение возвращается
// пустой строкой — вызывающий обязан отказать, а не выбрать вид за пользователя.
//
// Параметры:
//  Значение - Строка - присланное значение; пустое означает «ветка».
//
// Возвращаемое значение:
//  Строка - Ветка(), Тег() либо "" — значение не распознано.
//
Функция Распознать(Знач Значение) Экспорт

	Норм = НРег(СокрЛП(Строка(?(Значение = Неопределено, "", Значение))));
	Если НЕ ЗначениеЗаполнено(Норм) Тогда
		Возврат Ветка();
	КонецЕсли;
	Если Синонимы(Тег()).Найти(Норм) <> Неопределено Тогда
		Возврат Тег();
	КонецЕсли;
	Если Синонимы(Ветка()).Найти(Норм) <> Неопределено Тогда
		Возврат Ветка();
	КонецЕсли;
	Возврат "";

КонецФункции

// Текст отказа для нераспознанного вида рефа.
//
// Параметры:
//  Значение - Строка - присланное значение.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаОтказа(Знач Значение) Экспорт
	Возврат СтрШаблон(
		"Неизвестный вид рефа ""%1"": ожидается «%2» (branch) либо «%3» (tag);"
		+ " пустое значение означает «%2». Полный реф («refs/tags/v1.2.3») вид не спрашивает",
		Значение, Ветка(), Тег());
КонецФункции

// Вид, предлагаемый по значению рефа, ВЫВЕДЕННОМУ ИЗВНЕ — из ссылки на файл в вебе, где
// ветка и тег выглядят одинаково. Полный реф называет пространство имён сам; имя с номером
// версии («v1.2.3», «v1.2.3-rc1», «release-1.2.3», «2026.08.1-hotfix») и маска «v*»
// читаются тегом; всё, где номера нет («main», «v2-migration») либо есть «/»
// («release/1.2»), — веткой. Это ПРЕДЛОЖЕНИЕ: человек видит выбор и подтверждает его.
// На основном пути формы догадок нет — там вид берётся у готового конвейера.
//
// Параметры:
//  Реф - Строка - значение поля «реф».
//
// Возвращаемое значение:
//  Строка - Ветка() либо Тег().
//
Функция ПоЗначению(Знач Реф) Экспорт

	Значение = СокрЛП(Строка(?(Реф = Неопределено, "", Реф)));
	Если СтрНачинаетсяС(Значение, "refs/tags/") Тогда
		Возврат Тег();
	КонецЕсли;
	Если СтрНачинаетсяС(Значение, "refs/") Тогда
		Возврат Ветка();
	КонецЕсли;
	Возврат ?(ЭтоИмяРелиза(Значение), Тег(), Ветка());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Синонимы(Знач Вид)
	Возврат ?(Вид = Тег(), СтрРазделить("тег,теги,tag,tags", ","),
		СтрРазделить("ветка,ветки,branch,branches", ","));
КонецФункции

// Узнаётся по номеру версии внутри либо по маске «v*»; косая черта отменяет догадку.
Функция ЭтоИмяРелиза(Знач Значение)

	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ СтрНайти(Значение, "/") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат МаскаПослеV(Значение) ИЛИ ЕстьНомерВерсии(Значение);

КонецФункции

// «v*», «v1», «v1.2» — номер (или его маска) сразу за «v».
Функция МаскаПослеV(Знач Значение)
	Возврат НРег(Лев(Значение, 1)) = "v"
		И ТолькоИзНабора(Сред(Значение, 2), "0123456789.*");
КонецФункции

// Цифра-точка-цифра в любом месте имени: так выглядит номер версии и только он.
Функция ЕстьНомерВерсии(Знач Значение)

	Для Позиция = 2 По СтрДлина(Значение) - 1 Цикл
		Если Сред(Значение, Позиция, 1) = "."
			И ЭтоЦифра(Сред(Значение, Позиция - 1, 1))
			И ЭтоЦифра(Сред(Значение, Позиция + 1, 1)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЭтоЦифра(Знач Символ)
	Возврат СтрНайти("0123456789", Символ) > 0;
КонецФункции

Функция ТолькоИзНабора(Знач Значение, Знач Набор)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти(Набор, Сред(Значение, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти

&Прозвище("ВидРефаДоверия")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
