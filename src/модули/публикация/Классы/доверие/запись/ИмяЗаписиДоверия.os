// Человекочитаемое имя записи доверенного конвейера — одно на журнал, аудит, экран
// и диалог подтверждения.

Перем КороткаяФорма; // КороткаяФормаДоверия — короткое имя конвейера записи
Перем Стража;        // СтражИздателейCI — издатель по умолчанию у типа репозитория

#Область ПубличныйИнтерфейс

// Составляет имя записи. Две записи одного репозитория различает конвейер, поэтому он
// в имени есть; на инсталляции из настройки хаба их различает ещё и издатель.
//
// Параметры:
//  Провайдер - Строка - github либо gitlab.
//  Издатель - Строка - издатель записи; называется, только если не выводится из типа
//             репозитория.
//  Репозиторий - Строка - owner/repo либо group/subgroup/project.
//  Конвейер - Строка - каноническое значение конвейера; "" — любой конвейер репозитория.
//  Реф - Строка - маска рефа записи.
//
// Возвращаемое значение:
//  Строка - «github:acme/lib/release.yml@refs/heads/main».
//
Функция Составить(Знач Провайдер, Знач Издатель, Знач Репозиторий, Знач Конвейер,
	Знач Реф) Экспорт

	// короткое имя конвейера берётся там же, где его берёт список на экране: каноническое
	// значение начинается с самого репозитория, и печать его целиком повторяла бы имя
	// репозитория дважды
	Имя = КороткаяФорма.АдресаЗаписи(Провайдер, Издатель, Репозиторий, Конвейер, Реф).Имя;

	Возврат СтрШаблон("%1:%2%3%4%5",
		СокрЛП(Строка(?(Провайдер = Неопределено, "", Провайдер))),
		УточнениеИздателя(Провайдер, Издатель),
		СокрЛП(Строка(?(Репозиторий = Неопределено, "", Репозиторий))),
		?(ЗначениеЗаполнено(Имя), "/" + Имя, ""),
		?(ЗначениеЗаполнено(Реф), "@" + СокрЛП(Строка(Реф)), ""));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Издатель попадает в имя только там, где он НЕ выводится из типа репозитория.
Функция УточнениеИздателя(Знач Провайдер, Знач Издатель)

	Значение = СокрЛП(Строка(?(Издатель = Неопределено, "", Издатель)));
	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ Стража = Неопределено
		ИЛИ Стража.Нормализовать(Значение) = Стража.ИздательПоУмолчанию(Провайдер) Тогда
		Возврат "";
	КонецЕсли;

	Хост = КороткаяФорма.ХостИздателя(Значение);
	Возврат ?(ЗначениеЗаполнено(Хост), Хост + "/", "");

КонецФункции

#КонецОбласти

&Прозвище("ИмяЗаписиДоверия")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КороткаяФормаДоверия") _КороткаяФорма,
	&Пластилин(Значение = "СтражИздателейCI") _Стража = Неопределено) Экспорт

	КороткаяФорма = _КороткаяФорма;
	Стража = _Стража;

КонецПроцедуры
