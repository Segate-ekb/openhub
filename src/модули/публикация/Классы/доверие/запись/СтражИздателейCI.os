// Гейт исходящих адресов доверенных конвейеров: какой iss принимается в запись доверия
// и по какому адресу хабу позволено идти за ключами. Список закрытый, схема только https.

Перем Валидатор;  // ВалидаторАдресаАпстрима (зеркала) — форма адреса
Перем ПолитикаСети; // СвояСеть (сеть) — одно определение своей сети на хаб
Перем Настройки;  // СервисНастроек (настройки), может быть Неопределено
&Лог
Перем Лог;
Перем Адреса;   // РазборАдреса (основа) — хвостовые слеши снимает он
Перем Строки;   // КанонСтроки (основа)

#Область ПубличныйИнтерфейс

// Приводит адрес-идентификатор доверенного конвейера (iss, aud) к каноническому виду:
// нижний регистр без хвостовых «/». Одна канонизация на обе стороны любого сравнения —
// вторая рано или поздно разошлась бы с первой.
//
// Параметры:
//  Значение - Строка, Неопределено - издатель, аудитория либо адрес.
//
// Возвращаемое значение:
//  Строка - канонический вид, "" для незаполненного значения.
//
Функция Нормализовать(Знач Значение) Экспорт
	Возврат Адреса.БезХвостовыхСлешей(Строки.Канон(Значение));
КонецФункции

// Издатели, которым этот хаб доверяет выпуск id-token: встроенные провайдеры плюс
// заданные настройкой oshub.publish.ci.issuers.
//
// Возвращаемое значение:
//  Массив из Строка - канонические адреса издателей.
//
Функция РазрешённыеИздатели() Экспорт

	Результат = Новый Массив();
	Для Каждого Издатель Из ВстроенныеИздатели() Цикл
		Результат.Добавить(Издатель);
	КонецЦикла;

	Для Каждого Значение Из СтрРазделить(НастройкаИздателей(), ",", Ложь) Цикл
		Издатель = Нормализовать(Значение);
		Если ЗначениеЗаполнено(Издатель) И Результат.Найти(Издатель) = Неопределено Тогда
			Результат.Добавить(Издатель);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Издатель, которого хаб ждёт от этого типа репозитория. Форма доверия его не спрашивает:
// у github.com и gitlab.com он один, а self-hosted выбирается из РазрешённыхИздателей.
//
// Параметры:
//  Провайдер - Строка - github либо gitlab.
//
// Возвращаемое значение:
//  Строка - канонический адрес издателя.
//
Функция ИздательПоУмолчанию(Знач Провайдер) Экспорт
	Возврат ?(НРег(СокрЛП(Строка(Провайдер))) = "gitlab",
		"https://gitlab.com", "https://token.actions.githubusercontent.com");
КонецФункции

// Можно ли принять этот iss как издателя доверенного конвейера.
//
// Параметры:
//  Издатель - Строка - значение клейма iss либо поля записи доверия.
//
// Возвращаемое значение:
//  Структура - Ок (Булево), Ошибка (Строка, причина отказа при Ок = Ложь).
//
Функция ДопустимИздатель(Знач Издатель) Экспорт

	Норм = Нормализовать(Издатель);
	Если НЕ ЗначениеЗаполнено(Норм) Тогда
		Возврат Отказ("издатель (iss) не задан");
	КонецЕсли;

	Разрешённые = РазрешённыеИздатели();
	// лог опционален: страж собирают и напрямую, инъекция в поле туда не доезжает
	Если Лог <> Неопределено Тогда
		Лог.Отладка("Издатели CI: сверяем ""%1"" со списком доверенных (%2)",
			Норм, СтрСоединить(Разрешённые, ", "));
	КонецЕсли;

	Если Разрешённые.Найти(Норм) = Неопределено Тогда
		Возврат Отказ(СтрШаблон(
			"издатель ""%1"" не в списке доверенных этому хабу (%2)."
			+ " Self-hosted GitLab добавляется настройкой хаба oshub.publish.ci.issuers",
			Норм, СтрСоединить(Разрешённые, ", ")));
	КонецЕсли;

	Возврат ДопустимАдрес(Норм);

КонецФункции

// Можно ли хабу выполнить исходящий запрос по этому адресу: сюда попадают и адрес
// discovery, и jwks_uri из его ответа — второй задаёт чужая сторона.
//
// Параметры:
//  URL - Строка - абсолютный адрес.
//
// Возвращаемое значение:
//  Структура - Ок (Булево), Ошибка (Строка, причина отказа при Ок = Ложь).
//
Функция ДопустимАдрес(Знач URL) Экспорт

	Значение = СокрЛП(Строка(?(URL = Неопределено, "", URL)));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Отказ("адрес не задан");
	КонецЕсли;

	Если НЕ СтрНачинаетсяС(НРег(Значение), "https://") Тогда
		Возврат Отказ(СтрШаблон(
			"адрес ""%1"" не по https: ключи, которыми решается право на публикацию,"
			+ " по открытому каналу не читаем", Значение));
	КонецЕсли;

	Если Валидатор = Неопределено ИЛИ ПолитикаСети = Неопределено Тогда
		Возврат Отказ("судья адресов недоступен — непроверенный адрес не опрашивается");
	КонецЕсли;

	Разбор = Валидатор.Разобрать(Значение);
	Если Разбор.Ок <> Истина Тогда
		Возврат Отказ(Строка(Разбор.Ошибка));
	КонецЕсли;

	// судейство БЕЗ резолва имени: DNS резолвит ОС при соединении, а наш второй резолв
	// стоил бы подпроцесса и гарантии всё равно не давал — между ним и соединением ответ
	// успевает измениться. Литеральный адрес судится полностью, он разбирается строкой
	Сеть = ПолитикаСети.Вердикт(Разбор.Хост);
	Если Сеть.Код <> ПолитикаСети.Коды().Интернет Тогда
		Возврат Отказ(СтрШаблон("хост ""%1"": %2", Разбор.Хост, Сеть.Текст));
	КонецЕсли;

	Возврат Ок();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВстроенныеИздатели()
	Результат = Новый Массив();
	Результат.Добавить(ИздательПоУмолчанию("github"));
	Результат.Добавить(ИздательПоУмолчанию("gitlab"));
	Возврат Результат;
КонецФункции

Функция НастройкаИздателей()
	Возврат ?(Настройки = Неопределено, "", Настройки.Текстом("oshub.publish.ci.issuers"));
КонецФункции

Функция Ок()
	Возврат Новый Структура("Ок, Ошибка", Истина, "");
КонецФункции

Функция Отказ(Знач Причина)
	Возврат Новый Структура("Ок, Ошибка", Ложь, Причина);
КонецФункции

#КонецОбласти

&Прозвище("СтражИздателейCI")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВалидаторАдресаАпстрима") _Валидатор = Неопределено,
	&Пластилин(Значение = "СвояСеть") _СвояСеть = Неопределено,
	&Пластилин(Значение = "СервисНастроек") _Настройки = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "РазборАдреса") _Адреса = Неопределено,
	&Пластилин(Значение = "КанонСтроки") _Строки = Неопределено)

	Строки = ?(_Строки = Неопределено, Новый КанонСтроки(), _Строки);
	Адреса = ?(_Адреса = Неопределено, Новый РазборАдреса(), _Адреса);

	Валидатор = _Валидатор;
	ПолитикаСети = _СвояСеть;
	Настройки = _Настройки;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
