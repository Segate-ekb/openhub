// Короткие формы полей доверенного конвейера: имя файла workflow и имя ветки достраиваются
// до канонических значений клеймов, а ссылка на файл в вебе разбирается на все поля сразу.
// В записи доверия и при сверке клеймов живёт только каноническая форма.

Перем ОбразецДоверия; // ДовериеCI, несохраняемый носитель словаря провайдеров
Перем Хранилище;      // ХранилищеДоверияCI (данные) — только ради образца словаря
Перем Маски;          // МаскаРефа — язык глоб-масок рефа
Перем Стража;         // СтражИздателейCI — кому этот хаб доверяет выпуск id-token

#Область ПубличныйИнтерфейс

// Достраивает конвейер до канонического значения клейма без хвоста «@ref». Формы у
// провайдеров разные: `job_workflow_ref` GitHub — «owner/repo/.github/workflows/e2e.yml»,
// `ci_config_ref_uri` GitLab — «host/group/project//.gitlab-ci.yml».
//
// Параметры:
//  Провайдер - Строка - github либо gitlab.
//  Издатель - Строка - издатель записи; у GitLab из него берётся хост клейма.
//  Репозиторий - Строка - owner/repo либо group/subgroup/project.
//  Значение - Строка - имя файла («e2e.yml»), путь («my/path/.ci.yml») либо уже
//             каноническое значение.
//
// Возвращаемое значение:
//  Строка - канонический путь конвейера; "" остаётся пустым («любой конвейер»).
//
Функция Конвейер(Знач Провайдер, Знач Издатель, Знач Репозиторий, Знач Значение) Экспорт

	Короткое = СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
	Если НЕ ЗначениеЗаполнено(Короткое) Тогда
		Возврат "";
	КонецЕсли;

	Репо = СокрЛП(Строка(?(Репозиторий = Неопределено, "", Репозиторий)));

	Если ЭтоGitLab(Провайдер) Тогда
		// у GitLab путь к конфигу задаёт настройка проекта и попадает в клейм дословно,
		// поэтому вложенный путь — обычное значение, а не признак «уже каноническое»;
		// каноническое узнаётся по «//» — разделителю проекта и пути внутри него
		Если СтрНайти(Короткое, "//") > 0 Тогда
			Возврат Короткое;
		КонецЕсли;
		Хост = ХостИздателя(Издатель);
		Если НЕ ЗначениеЗаполнено(Хост) ИЛИ НЕ ЗначениеЗаполнено(Репо) Тогда
			Возврат Короткое;
		КонецЕсли;
		Возврат Хост + "/" + Репо + "//" + Короткое;
	КонецЕсли;

	// у GitHub каталог workflow один, поэтому значение читается тремя формами:
	// полное значение клейма («owner/repo/.github/workflows/x.yml» — так вводится
	// и reusable из ЧУЖОГО репозитория), путь от корня своего репозитория
	// («.github/workflows/x.yml» — так его набирают руками и так он приходит из ссылки)
	// и просто имя файла. Всё остальное с косой чертой — не путь workflow вовсе
	Если СтрНайти(НРег(Короткое), "/" + КаталогGitHub()) > 0 Тогда
		Возврат Короткое;
	КонецЕсли;

	Файл = Короткое;
	Если СтрНачинаетсяС(НРег(Короткое), КаталогGitHub()) Тогда
		Файл = Сред(Короткое, СтрДлина(КаталогGitHub()) + 1);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Репо) Тогда
		Возврат Файл;
	КонецЕсли;

	Возврат Репо + "/" + КаталогGitHub() + Файл;

КонецФункции

// Причина, по которой значение конвейера принять нельзя, либо "" — принять можно.
// Отдельный вопрос, а не «молча вернуть пустое»: пустой конвейер означает «ЛЮБОЙ конвейер
// репозитория», и превратить в него опечатку значило бы расширить доверие ошибкой.
//
// Параметры:
//  Провайдер - Строка - github либо gitlab.
//  Значение - Строка - введённое значение конвейера.
//
// Возвращаемое значение:
//  Строка - причина отказа для пользователя либо "".
//
Функция ПричинаОтказаКонвейера(Знач Провайдер, Знач Значение) Экспорт

	Короткое = СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
	Если НЕ ЗначениеЗаполнено(Короткое) ИЛИ ЭтоGitLab(Провайдер) Тогда
		Возврат "";
	КонецЕсли;
	Если СтрНайти(НРег(Короткое), "/" + КаталогGitHub()) > 0 Тогда
		Возврат "";
	КонецЕсли;

	Файл = Короткое;
	Если СтрНачинаетсяС(НРег(Короткое), КаталогGitHub()) Тогда
		Файл = Сред(Короткое, СтрДлина(КаталогGitHub()) + 1);
	КонецЕсли;
	Если СтрНайти(Файл, "/") = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(
		"конвейер ""%1"" не похож на workflow GitHub Actions: они лежат только"
		+ " в .github/workflows и подкаталогов не допускают. Введите имя файла"
		+ " («e2e.yml»), путь «.github/workflows/e2e.yml» либо полное значение клейма"
		+ " «owner/repo/.github/workflows/e2e.yml»", Короткое);

КонецФункции

// Достраивает реф до канонического значения клейма `ref`. Глоб-маска достраивается
// так же, как имя: «v*» видом «тег» превращается в «refs/tags/v*».
//
// Параметры:
//  Значение - Строка - имя ветки или тега («develop»), глоб-маска («v*», «**») либо
//             уже полный реф.
//  ЭтоТег - Булево - достраивать как тег, а не как ветку (необязательный,
//           по умолчанию Ложь).
//
// Возвращаемое значение:
//  Строка - «refs/heads/develop»; "" остаётся пустым, и такую запись сервис не создаёт.
//
Функция Реф(Знач Значение, Знач ЭтоТег = Ложь) Экспорт

	Короткое = СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
	Если НЕ ЗначениеЗаполнено(Короткое) Тогда
		// пусто остаётся пустым: превратить его в значение достройка не вправе,
		// а обязательность поля держит сервис
		Возврат "";
	КонецЕсли;

	// приставка сверяется РЕГИСТРОЗАВИСИМО, как и сам клейм: «REFS/heads/main» — не реф,
	// и молча пропустить его значило бы завести запись, которая не совпадёт никогда;
	// маску «всех рефов» приставка не расширила бы, а СУЗИЛА до одного пространства имён
	Если СтрНачинаетсяС(Короткое, "refs/") ИЛИ Маски.ПокрываетЛюбойРеф(Короткое) Тогда
		Возврат Короткое;
	КонецЕсли;

	Возврат ?(ЭтоТег = Истина, "refs/tags/", "refs/heads/") + Короткое;

КонецФункции

// Значение поля «конвейер» для формы по пути файла внутри репозитория: у GitHub каталог
// один и в форме не нужен, у GitLab путь задаёт настройка проекта и значим целиком.
//
// Параметры:
//  Провайдер - Строка - github либо gitlab.
//  ПутьВРепозитории - Строка - путь файла от корня репозитория.
//
// Возвращаемое значение:
//  Строка - то, что показывается в поле формы.
//
Функция ЗначениеДляФормы(Знач Провайдер, Знач ПутьВРепозитории) Экспорт

	Путь = СокрЛП(Строка(?(ПутьВРепозитории = Неопределено, "", ПутьВРепозитории)));
	Если ЭтоGitLab(Провайдер) ИЛИ НЕ СтрНачинаетсяС(НРег(Путь), КаталогGitHub()) Тогда
		Возврат Путь;
	КонецЕсли;
	Возврат Сред(Путь, СтрДлина(КаталогGitHub()) + 1);

КонецФункции

// Разбирает ссылку на файл workflow в вебе: из неё выводятся провайдер, хост, репозиторий,
// реф и имя файла. Формы ссылок разные: у GitHub «/blob/<ref>/<путь>», у GitLab
// «/-/blob/<ref>/<путь>».
//
// Параметры:
//  Ссылка - Строка - адрес файла в веб-интерфейсе GitHub либо GitLab.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Провайдер, Издатель (адрес, которому хаб доверяет), Хост,
//              Репозиторий, Конвейер (путь внутри репозитория), Реф (короткая форма),
//              ЭтоТег (Булево). Успех = Ложь и у ссылки на инсталляцию, издателя которой
//              хаб не знает: молча подставить публичный адрес значило бы перенацелить
//              доверие на чужой репозиторий с тем же именем.
//
Функция РазобратьСсылку(Знач Ссылка) Экспорт

	Значение = СокрЛП(Строка(?(Ссылка = Неопределено, "", Ссылка)));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Пусто();
	КонецЕсли;

	Хост = ХостСсылки(Значение);
	Если НЕ ЗначениеЗаполнено(Хост) Тогда
		Возврат Пусто();
	КонецЕсли;

	Путь = ПутьСсылки(Значение);
	Сегменты = СтрРазделить(Путь, "/", Ложь);
	Разделитель = ПозицияРазделителя(Сегменты);
	Если Разделитель < 0 Тогда
		Возврат Пусто();
	КонецЕсли;

	// тип репозитория и ИЗДАТЕЛЬ выводятся вместе: издатель — это адрес хоста ссылки,
	// и если хаб ему не доверяет, разбирать нечего. Догадка «раз не gitlab, значит
	// github.com» отправила бы доверие на ПУБЛИЧНЫЙ github.com, потеряв настоящий хост
	Личность = ЛичностьПоСсылке(Хост, Сегменты[Разделитель] = "-");
	Если НЕ ЗначениеЗаполнено(Личность.Издатель) Тогда
		Возврат Пусто();
	КонецЕсли;
	Провайдер = Личность.Провайдер;

	// репозиторий — всё до разделителя: у GitLab это может быть group/subgroup/project
	Репозиторий = СоединитьСегменты(Сегменты, 0, Разделитель - 1);
	// «blob» и реф идут сразу за разделителем, остальное — путь файла в репозитории
	Начало = Разделитель + ?(Сегменты[Разделитель] = "-", 2, 1);
	Если Начало + 1 > Сегменты.ВГраница() ИЛИ НЕ ЗначениеЗаполнено(Репозиторий) Тогда
		Возврат Пусто();
	КонецЕсли;

	Реф_ = Сегменты[Начало];
	Файл = СоединитьСегменты(Сегменты, Начало + 1, Сегменты.ВГраница());
	Если НЕ ЗначениеЗаполнено(Реф_) ИЛИ НЕ ЗначениеЗаполнено(Файл) Тогда
		Возврат Пусто();
	КонецЕсли;

	Результат = Пусто();
	Результат.Успех = Истина;
	Результат.Провайдер = Провайдер;
	Результат.Издатель = Личность.Издатель;
	Результат.Хост = Хост;
	Результат.Репозиторий = Репозиторий;
	Результат.Конвейер = Файл;
	Результат.Реф = БезQuery(Реф_);
	Возврат Результат;

КонецФункции

// Адреса записи доверия в веб-интерфейсе провайдера — обратная сторона РазобратьСсылку.
// Издатель хостом репозитория НЕ является: id-token GitHub Actions выпускает
// token.actions.githubusercontent.com, а репозитории лежат на github.com; у GitLab
// издатель как раз совпадает с адресом инсталляции.
//
// Параметры:
//  Провайдер - Строка - github либо gitlab.
//  Издатель - Строка - издатель записи.
//  Репозиторий - Строка - owner/repo либо group/subgroup/project.
//  Конвейер - Строка - каноническое значение конвейера; "" — любой конвейер репозитория.
//  Реф - Строка - маска рефа записи.
//
// Возвращаемое значение:
//  Структура - Репозиторий (Строка: адрес репозитория, "" — не собирается),
//              Конвейер (Строка: адрес файла конвейера, "" — файла за записью нет:
//              конвейер не задан либо реф задан маской или не ветка и не тег),
//              Имя (Строка: короткое имя конвейера для показа, "" — конвейер не задан).
//
Функция АдресаЗаписи(Знач Провайдер, Знач Издатель, Знач Репозиторий, Знач Конвейер,
	Знач Реф) Экспорт

	Результат = Новый Структура("Репозиторий, Конвейер, Имя", "", "", "");

	Место = МестоКонвейера(Провайдер, Издатель, Репозиторий, Конвейер);
	Результат.Имя = ИмяКонвейера(Провайдер, Репозиторий, Место);

	Хост = ХостРепозитория(Провайдер, Издатель);
	Если НЕ ЗначениеЗаполнено(Хост) Тогда
		Возврат Результат;
	КонецЕсли;

	Свой = ПутьРепозитория(Репозиторий);
	Если ЗначениеЗаполнено(Свой) Тогда
		Результат.Репозиторий = "https://" + Хост + "/" + Свой;
	КонецЕсли;

	// маска совпадает со многими рефами, и одного файла за ней нет: выдуманный адрес
	// открыл бы 404
	Ветка = КороткийРеф(Реф);
	Если НЕ ЗначениеЗаполнено(Ветка) ИЛИ СтрНайти(Ветка, "*") > 0
		ИЛИ НЕ ЗначениеЗаполнено(Место.Путь) ИЛИ НЕ ЗначениеЗаполнено(Место.Репозиторий) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Конвейер = "https://" + Хост + "/" + Место.Репозиторий
		+ ?(ЭтоGitLab(Провайдер), "/-/blob/", "/blob/") + Ветка + "/" + Место.Путь;
	Возврат Результат;

КонецФункции

// Хост из адреса издателя: схема и путь отбрасываются, регистр приводится к нижнему.
//
// Параметры:
//  Издатель - Строка - издатель записи.
//
// Возвращаемое значение:
//  Строка - имя хоста, "" — издателя нет.
//
Функция ХостИздателя(Знач Издатель) Экспорт

	Значение = СокрЛП(Строка(?(Издатель = Неопределено, "", Издатель)));
	Позиция = СтрНайти(Значение, "://");
	Если Позиция > 0 Тогда
		Значение = Сред(Значение, Позиция + 3);
	КонецЕсли;
	Конец = СтрНайти(Значение, "/");
	Возврат НРег(?(Конец = 0, Значение, Лев(Значение, Конец - 1)));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Каталог workflow-файлов GitHub Actions один и подкаталогов не допускает.
Функция КаталогGitHub()
	Возврат ".github/workflows/";
КонецФункции

Функция ЭтоGitLab(Знач Провайдер)
	Возврат НРег(СокрЛП(Строка(Провайдер))) = Образец().ПровайдерGitLab();
КонецФункции

// Разделитель пути к файлу: у GitLab это сегмент «-», у GitHub — сам «blob».
// Отрицательное значение означает, что ссылка на файл не похожа.
Функция ПозицияРазделителя(Знач Сегменты)

	Для Индекс = 0 По Сегменты.ВГраница() Цикл
		Если Сегменты[Индекс] = "-" И Индекс + 1 <= Сегменты.ВГраница()
			И ЭтоBlob(Сегменты[Индекс + 1]) Тогда
			Возврат Индекс;
		КонецЕсли;
		Если ЭтоBlob(Сегменты[Индекс]) Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;

	Возврат -1;

КонецФункции

Функция ЭтоBlob(Знач Сегмент)
	Возврат НРег(Строка(Сегмент)) = "blob" ИЛИ НРег(Строка(Сегмент)) = "raw";
КонецФункции

// Хост, на котором лежит репозиторий записи.
Функция ХостРепозитория(Знач Провайдер, Знач Издатель)

	Хост = ХостИздателя(Издатель);
	Если НЕ ЗначениеЗаполнено(Хост) Тогда
		Возврат "";
	КонецЕсли;

	Если НЕ ЭтоGitLab(Провайдер) Тогда
		Эталон = ХостИздателя(ИздательGitHubActions());
		// без стража эталонного издателя не спросить, а угадывать нечего: ошибка увела бы
		// на репозиторий с тем же именем на ЧУЖОМ хосте
		Если НЕ ЗначениеЗаполнено(Эталон) Тогда
			Возврат "";
		КонецЕсли;
		Если Хост = Эталон Тогда
			Возврат ХостGitHub();
		КонецЕсли;
	КонецЕсли;

	Возврат ?(ЭтоИмяХоста(Хост), Хост, "");

КонецФункции

// Где лежит файл конвейера: проект и путь внутри него. Каноническое значение обеих
// сторон может указывать на ЧУЖОЙ проект — у GitHub это reusable, у GitLab конфиг,
// заданный настройкой проекта; сверяется такой проект отдельно от репозитория записи,
// поэтому и в месте он свой.
Функция МестоКонвейера(Знач Провайдер, Знач Издатель, Знач Репозиторий, Знач Конвейер)

	Свой = ПутьРепозитория(Репозиторий);
	Значение = СокрЛП(Строка(?(Конвейер = Неопределено, "", Конвейер)));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат МестоФайла("", "");
	КонецЕсли;

	Если ЭтоGitLab(Провайдер) Тогда
		Позиция = СтрНайти(Значение, "//");
		Если Позиция = 0 Тогда
			Возврат МестоФайла(Свой, Значение);
		КонецЕсли;
		Проект = ПроектКонфига(Лев(Значение, Позиция - 1), Издатель);
		// проект не разобрался — значение остаётся целиком: подстановка своего репозитория
		// стёрла бы разницу между записями, а места файла мы всё равно не знаем
		Возврат ?(ЗначениеЗаполнено(Проект), МестоФайла(Проект, Сред(Значение, Позиция + 2)),
			МестоФайла("", Значение));
	КонецЕсли;

	Позиция = СтрНайти(НРег(Значение), КаталогGitHub());
	Если Позиция = 0 Тогда
		Возврат МестоФайла(Свой, КаталогGitHub() + Значение);
	КонецЕсли;

	Чужой = ПутьРепозитория(Лев(Значение, Позиция - 1));
	Возврат МестоФайла(?(ЗначениеЗаполнено(Чужой), Чужой, Свой), Сред(Значение, Позиция));

КонецФункции

// Проект из клейма GitLab: каноническое значение начинается с ХОСТА инсталляции, и без
// его отбрасывания проект не сравнить с репозиторием записи. Чужой хост даёт "".
Функция ПроектКонфига(Знач ПутьСХостом, Знач Издатель)

	Путь = ПутьРепозитория(ПутьСХостом);
	Хост = ХостИздателя(Издатель);
	Если НЕ ЗначениеЗаполнено(Путь) ИЛИ НЕ ЗначениеЗаполнено(Хост)
		ИЛИ НЕ СтрНачинаетсяС(НРег(Путь), Хост + "/") Тогда
		Возврат "";
	КонецЕсли;

	Возврат Сред(Путь, СтрДлина(Хост) + 2);

КонецФункции

Функция МестоФайла(Знач Репозиторий, Знач Путь)
	Возврат Новый Структура("Репозиторий, Путь", Репозиторий, Путь);
КонецФункции

// Короткое имя конвейера для списка: у GitHub каталог workflow один и в имени не нужен,
// у GitLab путь задаёт настройка проекта и значим целиком. Файл ЧУЖОГО проекта
// показывается вместе с ним — иначе две записи одного репозитория неотличимы; пустой
// проект приставки не даёт, потому что место файла неизвестно.
Функция ИмяКонвейера(Знач Провайдер, Знач Репозиторий, Знач Место)

	Если НЕ ЗначениеЗаполнено(Место.Путь) Тогда
		Возврат "";
	КонецЕсли;

	Части = СтрРазделить(Место.Путь, "/", Ложь);
	Имя = ?(ЭтоGitLab(Провайдер) ИЛИ Части.Количество() = 0, Место.Путь, Части[Части.ВГраница()]);

	Свой = (Место.Репозиторий = ПутьРепозитория(Репозиторий))
		ИЛИ НЕ ЗначениеЗаполнено(Место.Репозиторий);
	Возврат ?(Свой, Имя, Место.Репозиторий + "/" + Имя);

КонецФункции

// Путь репозитория для адреса. Значение вводит мейнтейнер, а уезжает оно в href, поэтому
// пропускается только то, из чего состоят имена репозиториев.
Функция ПутьРепозитория(Знач Значение)

	Путь = СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
	Пока СтрНачинаетсяС(Путь, "/") Цикл
		Путь = Сред(Путь, 2);
	КонецЦикла;
	Пока СтрЗаканчиваетсяНа(Путь, "/") Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(Путь) ИЛИ СтрНайти(Путь, "..") > 0 ИЛИ СтрНайти(Путь, "//") > 0
		ИЛИ НЕ ТолькоИзНабора(НРег(Путь), "abcdefghijklmnopqrstuvwxyz0123456789-_./") Тогда
		Возврат "";
	КонецЕсли;
	Возврат Путь;

КонецФункции

// Хост адреса: буквы, цифры, точка, дефис и необязательный числовой порт.
Функция ЭтоИмяХоста(Знач Значение)

	Части = СтрРазделить(Значение, ":", Истина);
	Если Части.Количество() > 2 ИЛИ СтрНайти(Части[0], ".") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Части.Количество() = 2 И НЕ ТолькоИзНабора(Части[1], "0123456789") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ТолькоИзНабора(Части[0], "abcdefghijklmnopqrstuvwxyz0123456789-.");

КонецФункции

Функция ТолькоИзНабора(Знач Значение, Знач Набор)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти(Набор, Сред(Значение, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Короткая форма рефа — обратная сторона Реф(): «refs/heads/main» → «main». За веткой и
// тегом в вебе стоит файл, за прочими пространствами имён («refs/pull/…») — нет, и адрес
// для них не выдумывается.
Функция КороткийРеф(Знач Реф)

	Значение = СокрЛП(Строка(?(Реф = Неопределено, "", Реф)));
	Для Каждого Приставка Из СтрРазделить("refs/heads/,refs/tags/", ",") Цикл
		Если СтрНачинаетсяС(Значение, Приставка) Тогда
			Возврат Сред(Значение, СтрДлина(Приставка) + 1);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Тип репозитория и издатель ссылки. Догадок по имени хоста здесь нет: издателем может
// быть только адрес, которому ЭТОТ хаб доверяет, — иначе разбор отказывает и человек
// видит настоящую причину, а не молча получает доверие публичному github.com.
//
// github.com — единственный хост, дающий GitHub Actions: у GitHub Enterprise Server свой
// издатель (`https://<хост>/_services/token`), и в списке хаба он появляется настройкой,
// как и self-hosted GitLab.
Функция ЛичностьПоСсылке(Знач Хост, Знач ЕстьСегментGitLab)

	Кандидат = "https://" + НРег(Хост);

	Если НЕ ЕстьСегментGitLab И НРег(Хост) = ХостGitHub() Тогда
		Возврат Личность(Образец().ПровайдерGitHub(), ИздательGitHubActions());
	КонецЕсли;

	// self-hosted GitLab (и старая форма ссылки без «-») опознаётся только по списку хаба
	Если Разрешён(Кандидат) Тогда
		Возврат Личность(Образец().ПровайдерGitLab(), Кандидат);
	КонецЕсли;

	Возврат Личность("", "");

КонецФункции

Функция Личность(Знач Провайдер, Знач Издатель)
	Возврат Новый Структура("Провайдер, Издатель", Провайдер, Издатель);
КонецФункции

Функция Разрешён(Знач Издатель)
	Возврат Стража <> Неопределено
		И Стража.РазрешённыеИздатели().Найти(Стража.Нормализовать(Издатель)) <> Неопределено;
КонецФункции

Функция ИздательGitHubActions()
	Возврат ?(Стража = Неопределено, "", Стража.ИздательПоУмолчанию(Образец().ПровайдерGitHub()));
КонецФункции

// Единственный хост, дающий GitHub Actions: у GitHub Enterprise Server и хост, и издатель
// свои, и в списке хаба он появляется настройкой.
Функция ХостGitHub()
	Возврат "github.com";
КонецФункции

Функция ХостСсылки(Знач Ссылка)

	Значение = НРег(Ссылка);
	Позиция = СтрНайти(Значение, "://");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(Ссылка, Позиция + 3);
	Конец = СтрНайти(Остаток, "/");
	Хост = ?(Конец = 0, Остаток, Лев(Остаток, Конец - 1));
	Возврат ?(СтрНайти(Хост, ".") > 0 ИЛИ СтрНайти(Хост, ":") > 0, Хост, "");

КонецФункции

Функция ПутьСсылки(Знач Ссылка)

	Позиция = СтрНайти(Ссылка, "://");
	Остаток = Сред(Ссылка, Позиция + 3);
	Конец = СтрНайти(Остаток, "/");
	Возврат ?(Конец = 0, "", Сред(Остаток, Конец + 1));

КонецФункции

Функция СоединитьСегменты(Знач Сегменты, Знач Первый, Знач Последний)

	Части = Новый Массив();
	Для Индекс = Макс(Первый, 0) По Мин(Последний, Сегменты.ВГраница()) Цикл
		Части.Добавить(Сегменты[Индекс]);
	КонецЦикла;
	Возврат БезQuery(СтрСоединить(Части, "/"));

КонецФункции

// Хвост «?plain=1» и якорь «#L10» — часть ссылки браузера, а не имени файла.
Функция БезQuery(Знач Значение)

	Результат = Строка(Значение);
	Для Каждого Разделитель Из СтрРазделить("?,#", ",") Цикл
		Позиция = СтрНайти(Результат, Разделитель);
		Если Позиция > 0 Тогда
			Результат = Лев(Результат, Позиция - 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Пусто()
	Возврат Новый Структура("Успех, Провайдер, Издатель, Хост, Репозиторий, Конвейер, Реф, ЭтоТег",
		Ложь, "", "", "", "", "", "", Ложь);
КонецФункции

// Создаётся лениво: на этапе сборки контейнера обращаться к менеджеру сущностей рано.
Функция Образец()
	Если ОбразецДоверия = Неопределено Тогда
		ОбразецДоверия = Хранилище.СоздатьЭлемент();
	КонецЕсли;
	Возврат ОбразецДоверия;
КонецФункции

#КонецОбласти

&Прозвище("КороткаяФормаДоверия")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеДоверияCI") _Хранилище,
	&Пластилин(Значение = "МаскаРефа") _Маски,
	&Пластилин(Значение = "СтражИздателейCI") _Стража = Неопределено) Экспорт

	Хранилище = _Хранилище;
	Маски = _Маски;
	Стража = _Стража;

КонецПроцедуры
