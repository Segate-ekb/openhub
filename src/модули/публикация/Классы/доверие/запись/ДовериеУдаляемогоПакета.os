// Доверие CI к удаляемому пакету — реализация контракта ПоследствияУдаленияПакета.

Перем ХранилищеДоверия;  // ХранилищеДоверияCI (публикация)
Перем Снятие;            // СнятиеСтрок (данные) — снятие пачки строк со счётом

// Снимает записи доверия CI пакета.
//
// Параметры:
//  Пакет - Пакет - удаляемый пакет.
//
// Возвращаемое значение:
//  Число - сколько строк снято.
//
Функция СнятьСтрокиПакета(Знач Пакет) Экспорт
	Возврат Снятие.Снять(ХранилищеДоверия.ПолучитьПоПакетИдентификаторРавно(Цел(Пакет.Идентификатор)));
КонецФункции

&Прозвище("ПоследствияУдаленияПакета")
&Порядок(50)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеДоверияCI") _ХранилищеДоверия,
	&Пластилин(Значение = "СнятиеСтрок") _Снятие)

	ХранилищеДоверия = _ХранилищеДоверия;
	Снятие = _Снятие;

КонецПроцедуры
