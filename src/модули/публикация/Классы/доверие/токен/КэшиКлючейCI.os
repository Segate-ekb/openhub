// Источники ключей JWKS по издателям — один кэш подготовленных ключей на процесс:
// подготовка ключа стоит десятки миллисекунд, а кэш на запрос тянул бы JWKS на каждый push.

#Использовать jwt-verify

Перем Транспорт;  // ТранспортJWKSCI
Перем Источники;  // Соответствие: канонический издатель → КэшJWKS

// Возвращает источник ключей издателя, создавая его при первом обращении.
//
// Параметры:
//  Издатель - Строка - канонический адрес издателя.
//
// Возвращаемое значение:
//  КэшJWKS, Неопределено - источник ключей; Неопределено, если издатель не задан.
//
Функция ИсточникКлючей(Знач Издатель) Экспорт

	Ключ = НРег(СокрЛП(Строка(?(Издатель = Неопределено, "", Издатель))));
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Готовый = Источники.Получить(Ключ);
	Если Готовый <> Неопределено Тогда
		Возврат Готовый;
	КонецЕсли;

	Источник = Новый КэшJWKS(Ключ, Транспорт);
	Источники.Вставить(Ключ, Источник);
	Возврат Источник;

КонецФункции

&Прозвище("КэшиКлючейCI")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТранспортJWKSCI") _Транспорт)

	Транспорт = _Транспорт;
	Источники = Новый Соответствие();

КонецПроцедуры
