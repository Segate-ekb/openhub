// Срок жизни id-token конвейера: exp обязателен, nbf не в будущем, допуск на расхождение
// часов хаба и провайдера.

#Область ПубличныйИнтерфейс

// Причина, по которой срок предъявленного токена принять нельзя.
//
// Параметры:
//  Клеймы - Соответствие - проверенные клеймы токена.
//
// Возвращаемое значение:
//  Строка - текст отказа; "" — срок живой.
//
Функция ПричинаОтказа(Знач Клеймы) Экспорт

	Сейчас = ЮниксСейчас();
	// `exp` обязателен: токен без срока — долгоживущий ключ, ровно то, от чего уходим
	Истекает = Число_(Клейм(Клеймы, "exp"));
	Если Истекает <= 0 Тогда
		Возврат "в id-token нет клейма exp";
	КонецЕсли;
	Если Истекает <= Сейчас - ДопускРасхожденияЧасовСекунд() Тогда
		Возврат "срок действия id-token истёк";
	КонецЕсли;

	Начало = Число_(Клейм(Клеймы, "nbf"));
	Если Начало > 0 И Начало > Сейчас + ДопускРасхожденияЧасовСекунд() Тогда
		Возврат "id-token ещё не действителен (nbf в будущем)";
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Минуты, а не часы: id-token живёт минутами, и суточный допуск принимал бы вчерашний токен.
Функция ДопускРасхожденияЧасовСекунд()
	Возврат 60;
КонецФункции

Функция ЮниксСейчас()
	Возврат ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1);
КонецФункции

Функция Клейм(Знач Клеймы, Знач Имя)
	Значение = Клеймы.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
КонецФункции

Функция Число_(Знач Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Цел(Число(Значение));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

#КонецОбласти

&Прозвище("СрокТокенаCI")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
