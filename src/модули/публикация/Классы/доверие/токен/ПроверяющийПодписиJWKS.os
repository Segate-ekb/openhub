// Поставочная реализация ПроверяющийПодписиCI: RS256 по JWKS издателя (сателлит jwt-verify).
// Fail-closed — недопустимый издатель, недоступный JWKS, незнакомый kid, чужая подпись и
// любое исключение дают отказ; клеймы отдаются только вместе с подтверждённой подписью.

#Использовать jwt-verify

Перем Страж;  // СтражИздателейCI
Перем Кэши;   // КэшиКлючейCI
&Лог
Перем Лог;

// Проверяет подпись предъявленного id-token'а; см. контракт ПроверяющийПодписиCI.
//
// Параметры:
//  Токен - Строка - id-token в компактной форме JWS.
//  Издатель - Строка - ожидаемый iss, у него берутся ключи.
//
// Возвращаемое значение:
//  Структура - Достоверна (Булево), Причина (Строка), Клеймы (Соответствие либо Неопределено).
//
Функция ПроверитьТокен(Знач Токен, Знач Издатель) Экспорт

	Попытка
		Возврат Проверить(Токен, Издатель);
	Исключение
		Лог.Ошибка("Проверка подписи id-token издателя ""%1"" сорвалась исключением: %2",
			Строка(Издатель), ОписаниеОшибки());
		Возврат Отказ("проверка подписи прервалась ошибкой");
	КонецПопытки;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция Проверить(Знач Токен, Знач Издатель)

	Если Страж = Неопределено ИЛИ Кэши = Неопределено Тогда
		Возврат Отказ("проверка подписи id-token не собрана в этом хабе");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		Возврат Отказ("id-token не предъявлен");
	КонецЕсли;

	Вердикт = Страж.ДопустимИздатель(Издатель);
	Если Вердикт.Ок <> Истина Тогда
		Лог.Предупреждение("Ключи издателя ""%1"" не запрашивались: %2",
			Строка(Издатель), Вердикт.Ошибка);
		Возврат Отказ(Строка(Вердикт.Ошибка));
	КонецЕсли;

	Канонический = Страж.Нормализовать(Издатель);
	Проверяющий = Новый ПроверяющийJWS(Кэши.ИсточникКлючей(Канонический));
	Итог = Проверяющий.Проверить(СокрЛП(Строка(Токен)));

	Если НЕ Итог.Успех Тогда
		Лог.Предупреждение("Подпись id-token издателя ""%1"" не подтверждена: %2 — %3",
			Канонический, Итог.Код, Итог.Сообщение);
		Возврат Отказ(СтрШаблон("%1 (%2)", Итог.Сообщение, Итог.Код));
	КонецЕсли;

	// инвариант метода: клеймы принадлежат ТОМУ издателю, чьими ключами их проверяли
	ПодписанныйИздатель = Страж.Нормализовать(Итог.Клеймы.Получить("iss"));
	Если ПодписанныйИздатель <> Канонический Тогда
		Лог.Предупреждение(
			"Подписанный id-token называет издателем ""%1"", а ключи брались у ""%2""",
			ПодписанныйИздатель, Канонический);
		Возврат Отказ("подписанный id-token выпущен другим издателем");
	КонецЕсли;

	Возврат Новый Структура("Достоверна, Причина, Клеймы", Истина, "", Итог.Клеймы);

КонецФункции

Функция Отказ(Знач Причина)
	Возврат Новый Структура("Достоверна, Причина, Клеймы", Ложь, Причина, Неопределено);
КонецФункции

#КонецОбласти

&Прозвище("ПроверяющийПодписиCI")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СтражИздателейCI") _Страж = Неопределено,
	&Пластилин(Значение = "КэшиКлючейCI") _Кэши = Неопределено,
	&Лог _Лог = Неопределено)

	Страж = _Страж;
	Кэши = _Кэши;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
