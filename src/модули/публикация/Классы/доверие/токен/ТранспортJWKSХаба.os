// Транспорт JWKS доверенных конвейеров поверх сеть/КлиентHTTP. Перенаправления не следуются,
// и каждый адрес — включая jwks_uri, который называет чужой документ discovery, — судит
// СтражИздателейCI: иначе конец цепочки не проверял бы никто.

Перем Клиент;  // КлиентHTTP (сеть)
Перем Страж;   // СтражИздателейCI
&Лог
Перем Лог;

// Выполняет GET по адресу JWKS или discovery. Контракт транспорта jwt-verify.
//
// Параметры:
//  URL - Строка - абсолютный адрес.
//  Заголовки - Соответствие, Неопределено - дополнительные заголовки запроса
//              (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - Код (Число), Тело (Строка), Заголовки (Соответствие).
//
// Недопустимый адрес, перенаправление и сетевой сбой пробрасываются исключением: их
// трактует кэш ключей, для которого это недоступность ключей, а не отказ хаба.
//
Функция Получить(Знач URL, Знач Заголовки = Неопределено) Экспорт

	Вердикт = Страж.ДопустимАдрес(URL);
	Если Вердикт.Ок <> Истина Тогда
		Лог.Предупреждение("Обращение за ключами по адресу ""%1"" отменено: %2",
			Строка(URL), Вердикт.Ошибка);
		ВызватьИсключение СтрШаблон("адрес ключей ""%1"" недопустим: %2", URL, Вердикт.Ошибка);
	КонецЕсли;

	Ответ = Клиент.Получить(URL, СобратьЗаголовки(Заголовки), ТаймаутСек(), Истина, Ложь);

	Если Ответ.Код >= 300 И Ответ.Код < 400 Тогда
		ВызватьИсключение СтрШаблон(
			"адрес ключей ""%1"" ответил перенаправлением %2 — по цепочке не идём:"
			+ " её конец никем не проверен", URL, Ответ.Код);
	КонецЕсли;

	Возврат Новый Структура("Код, Тело, Заголовки",
		Ответ.Код, ТелоСтрокой(Ответ.Данные), Ответ.Заголовки);

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ТаймаутСек()
	Возврат 15;
КонецФункции

// Предел проверяется ДО материализации тела в строку: свой предел библиотека применяет
// к уже собранной строке, и мегабайтный ответ успел бы приехать в память целиком.
Функция ПределТелаБайт()
	Возврат 262144;
КонецФункции

Функция СобратьЗаголовки(Знач Заголовки)

	Результат = Новый Соответствие();
	Если ТипЗнч(Заголовки) = Тип("Соответствие") Тогда
		Для Каждого КлючЗначение Из Заголовки Цикл
			Результат.Вставить(Строка(КлючЗначение.Ключ), Строка(КлючЗначение.Значение));
		КонецЦикла;
	КонецЕсли;
	Если Результат.Получить("Accept") = Неопределено Тогда
		Результат.Вставить("Accept", "application/json");
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ТелоСтрокой(Знач Данные)
	Если Данные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если Данные.Размер() > ПределТелаБайт() Тогда
		ВызватьИсключение СтрШаблон(
			"документ ключей больше допустимых %1 байт", Формат(ПределТелаБайт(), "ЧГ=0; ЧН=0"));
	КонецЕсли;
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, "UTF-8");
КонецФункции

#КонецОбласти

&Прозвище("ТранспортJWKSCI")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТранспортHTTP") _Клиент,
	&Пластилин(Значение = "СтражИздателейCI") _Страж,
	&Лог _Лог = Неопределено)

	Клиент = _Клиент;
	Страж = _Страж;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
