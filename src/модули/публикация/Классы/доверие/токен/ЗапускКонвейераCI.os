// Что о запуске конвейера говорят проверенные клеймы id-token: кто запустил конвейер и из какого
// релиза GitHub пришла версия. Клеймы — только те, что вернулись вместе с подтверждённой подписью.

#Использовать url

Перем СтражИздателей; // СтражИздателейCI (публикация), может быть Неопределено — издатель github.com
Перем ШаблонРелиза;   // ШаблонURI — страница релиза на github.com

#Область ПубличныйИнтерфейс

// Логин человека, на чей запуск выдан id-token: у GitHub — клейм actor, у GitLab — user_login.
//
// Параметры:
//  Провайдер - Строка - провайдер записи доверия, пустившей токен: github либо gitlab.
//  Клеймы - Соответствие - клеймы проверенного токена.
//
// Возвращаемое значение:
//  Строка - логин; "" — клейма нет, он длиннее предела либо в нём есть что-то кроме латиницы,
//           цифр и знаков «-», «_», «.», «[», «]» (бот GitHub — «имя[bot]»).
//
Функция Запустивший(Знач Провайдер, Знач Клеймы) Экспорт

	Значение = Клейм(Клеймы, ?(ЭтоGitLab(Провайдер), "user_login", "actor"));
	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ СтрДлина(Значение) > ПределЛогина()
		ИЛИ НЕ ТолькоЗнакиЛогина(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Запущен ли конвейер на github.com: провайдер записи — GitHub, издатель токена — github.com,
// а не GitHub Enterprise. Только такому запуску принадлежат страница релиза и профиль на github.com.
//
// Параметры:
//  Провайдер - Строка - провайдер записи доверия, пустившей токен.
//  Издатель - Строка - канонический издатель проверенного токена.
//
// Возвращаемое значение:
//  Булево.
//
Функция НаGitHubCom(Знач Провайдер, Знач Издатель) Экспорт
	Возврат НЕ ЭтоGitLab(Провайдер) И ЭтоИздательGitHubCom(Издатель);
КонецФункции

// Адрес страницы релиза GitHub, из которого конвейер опубликовал версию: токен выдан запуску
// по событию release (клейм event_name), а реф — тег (клейм ref = refs/tags/<тег>).
//
// Параметры:
//  Провайдер - Строка - провайдер записи доверия, пустившей токен.
//  Издатель - Строка - канонический издатель проверенного токена.
//  Клеймы - Соответствие - клеймы проверенного токена.
//
// Возвращаемое значение:
//  Строка - «https://github.com/<репозиторий>/releases/tag/<тег>», тег и части репозитория —
//           сегментами пути; "" — запуск не из релиза, конвейер не GitHub, издатель не
//           github.com или клеймы не складываются в адрес.
//
Функция Релиз(Знач Провайдер, Знач Издатель, Знач Клеймы) Экспорт

	Если НЕ НаGitHubCom(Провайдер, Издатель) ИЛИ Клейм(Клеймы, "event_name") <> "release" Тогда
		Возврат "";
	КонецЕсли;

	Тег = ТегИзРефа(Клейм(Клеймы, "ref"));
	Части = СтрРазделить(Клейм(Клеймы, "repository"), "/", Истина);
	Если НЕ ЗначениеЗаполнено(Тег) ИЛИ Части.Количество() <> 2
		ИЛИ НЕ ЗначениеЗаполнено(Части[0]) ИЛИ НЕ ЗначениеЗаполнено(Части[1]) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ШаблонРелиза.Раскрыть(Новый Структура("owner, repo, tag", Части[0], Части[1], Тег)).ВСтроку();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Тег — всё после «refs/tags/»; реф ветки тегом не бывает.
Функция ТегИзРефа(Знач Реф)
	Префикс = "refs/tags/";
	Если НЕ СтрНачинаетсяС(Реф, Префикс) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(Реф, СтрДлина(Префикс) + 1);
КонецФункции

// Страница релиза живёт на github.com: у GitHub Enterprise свой хост, и ссылка туда была бы чужой.
Функция ЭтоИздательGitHubCom(Знач Издатель)
	Если СтражИздателей = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Ожидаемый = СтражИздателей.Нормализовать(СтражИздателей.ИздательПоУмолчанию("github"));
	Возврат ЗначениеЗаполнено(Ожидаемый) И СтражИздателей.Нормализовать(Издатель) = Ожидаемый;
КонецФункции

Функция ЭтоGitLab(Знач Провайдер)
	Возврат НРег(СокрЛП(Строка(Провайдер))) = "gitlab";
КонецФункции

Функция Клейм(Знач Клеймы, Знач Имя)
	Если Клеймы = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение = Клеймы.Получить(Имя);
	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), СокрЛП(Значение), "");
КонецФункции

Функция ПределЛогина()
	Возврат 100;
КонецФункции

// Логин уходит строкой в текст уведомления: ни пробела, ни управляющих, ни форматирующих символов.
Функция ТолькоЗнакиЛогина(Знач Значение)
	Допустимые = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.[]";
	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти(Допустимые, Сред(Значение, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

#КонецОбласти

&Прозвище("ЗапускКонвейераCI")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СтражИздателейCI") _СтражИздателей = Неопределено) Экспорт

	СтражИздателей = _СтражИздателей;
	ШаблонРелиза = Новый ШаблонURI("https://github.com/{owner}/{repo}/releases/tag/{tag}");

КонецПроцедуры
