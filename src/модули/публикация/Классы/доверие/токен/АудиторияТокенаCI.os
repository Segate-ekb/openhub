// Аудитория id-token конвейера: кому хаб велит его выпускать и как это сверяется с клеймом
// `aud`. Клейм обязателен: без него годился бы токен, выпущенный для другого сервиса.

Перем Настройки;      // СервисНастроек (настройки), может быть Неопределено
Перем СтражИздателей; // СтражИздателейCI, может быть Неопределено
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Аудитория, которую хаб ждёт в клейме `aud`: настройка oshub.publish.ci.audience, а при
// незаданной — «URL инстанса». Спрашивается и сверкой клеймов, и готовым конвейером на
// экране: две копии этого правила разошлись бы, и сниппет выдавал бы пайплайн
// с гарантированным отказом по aud.
//
// Возвращаемое значение:
//  Строка - канонический адрес аудитории; "" — хаб не знает, для кого выпускается его
//           id-token, и доверенные конвейеры не публикуют вовсе.
//
Функция Ожидаемая() Экспорт
	Своя = Канонизировать(Настройка("oshub.publish.ci.audience"));
	Возврат ?(ЗначениеЗаполнено(Своя), Своя, Канонизировать(Настройка("oshub.instance.url")));
КонецФункции

// Причина, по которой аудиторию предъявленного токена принять нельзя.
//
// Параметры:
//  Клеймы - Соответствие - проверенные клеймы токена.
//
// Возвращаемое значение:
//  Строка - текст отказа; "" — aud сошёлся с ожидаемым.
//
Функция ПричинаОтказа(Знач Клеймы) Экспорт

	Наша = Ожидаемая();
	Если НЕ ЗначениеЗаполнено(Наша) Тогда
		Возврат "хаб не знает, для кого выпускается его id-token: администратору нужно задать"
			+ " oshub.instance.url либо oshub.publish.ci.audience";
	КонецЕсли;

	Заявленные = АудиторииИзКлеймов(Клеймы);
	Лог.Отладка("Аудитория id-token: хаб ждёт ""%1"", токен заявляет ""%2""",
		Наша, СтрСоединить(Заявленные, ", "));

	Если Заявленные.Количество() = 0 Тогда
		Возврат "в id-token нет клейма aud";
	КонецЕсли;

	Для Каждого Значение Из Заявленные Цикл
		Если Значение = Наша Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон("id-token выпущен для другого сервиса: aud=%1, а этот хаб — %2",
		СтрСоединить(Заявленные, ", "), Наша);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// aud по RFC 7519 — строка либо массив строк.
Функция АудиторииИзКлеймов(Знач Клеймы)

	Результат = Новый Массив();
	Значение = Клеймы.Получить("aud");

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Норм = Канонизировать(Элемент);
			Если ЗначениеЗаполнено(Норм) Тогда
				Результат.Добавить(Норм);
			КонецЕсли;
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Норм = Канонизировать(Значение);
	Если ЗначениеЗаполнено(Норм) Тогда
		Результат.Добавить(Норм);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция Настройка(Знач Ключ)
	Если Настройки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат Строка(Настройки.Значение(Ключ));
	Исключение
		Лог.Предупреждение("Настройка ""%1"" не прочитана: %2", Ключ, ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
КонецФункции

// Без стража возвращается пустая строка, и это fail-closed: несравнимая аудитория — отказ.
Функция Канонизировать(Знач Значение)
	Возврат ?(СтражИздателей = Неопределено, "", СтражИздателей.Нормализовать(Значение));
КонецФункции

#КонецОбласти

&Прозвище("АудиторияТокенаCI")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки = Неопределено,
	&Пластилин(Значение = "СтражИздателейCI") _СтражИздателей = Неопределено,
	&Лог _Лог = Неопределено)

	Настройки = _Настройки;
	СтражИздателей = _СтражИздателей;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
