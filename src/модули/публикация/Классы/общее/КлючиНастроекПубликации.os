// Ключи настроек публикации: пределы приёма пакета, легаси-путь GitHub, доверенные конвейеры
// и очередь заявок.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей публикации в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи публикации.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(80)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "oshub.publish.max_upload_bytes", ЗначениеПоУмолчанию = "") _МаксЗагрузка = "",
	&Деталька(Значение = "oshub.publish.max_unpacked_bytes", ЗначениеПоУмолчанию = "") _МаксРаспаковка = "",
	&Деталька(Значение = "oshub.publish.max_files", ЗначениеПоУмолчанию = "") _МаксФайлов = "",
	&Деталька(Значение = "oshub.publish.max_manifest_bytes", ЗначениеПоУмолчанию = "") _МаксМанифест = "",
	&Деталька(Значение = "oshub.publish.github_legacy", ЗначениеПоУмолчанию = "") _ЛегасиGitHub = "",
	&Деталька(Значение = "oshub.publish.github.org", ЗначениеПоУмолчанию = "") _ОрганизацияGitHub = "",
	&Деталька(Значение = "oshub.publish.ci.audience", ЗначениеПоУмолчанию = "") _АудиторияCI = "",
	&Деталька(Значение = "oshub.publish.ci.issuers", ЗначениеПоУмолчанию = "") _ИздателиCI = "",
	&Деталька(Значение = "oshub.publish.inbox.max_pending_per_pool", ЗначениеПоУмолчанию = "") _ВходящихНаПул = "",
	&Деталька(Значение = "oshub.publish.inbox.max_pending_per_user", ЗначениеПоУмолчанию = "") _ВходящихНаАвтора = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	// Пределы приёма судят и публикацию человека, и пакет, привезённый зеркалом.
	Ключи.Объявить("oshub.publish.max_upload_bytes", "целое", 26214400, _Правила.Минимум(1), "bootstrap",
		_МаксЗагрузка);
	Ключи.Объявить("oshub.publish.max_unpacked_bytes", "целое", 67108864, _Правила.Минимум(1), "bootstrap",
		_МаксРаспаковка);
	Ключи.Объявить("oshub.publish.max_files", "целое", 5000, _Правила.Минимум(1), "bootstrap", _МаксФайлов);
	Ключи.Объявить("oshub.publish.max_manifest_bytes", "целое", 524288, _Правила.Минимум(1), "bootstrap",
		_МаксМанифест);

	// Легаси-токен GitHub на публикации: опция хаба, действует только в основном пуле.
	// Организация обязана стоять рядом со своим выключателем.
	Ключи.Объявить("oshub.publish.github_legacy", "булево", Ложь, Неопределено, "прикладная", _ЛегасиGitHub);
	Ключи.Объявить("oshub.publish.github.org", "строка", "oscript-library", Неопределено, "прикладная",
		_ОрганизацияGitHub);

	// Ожидаемый aud id-token доверенного конвейера; пусто — берётся oshub.instance.url.
	Ключи.Объявить("oshub.publish.ci.audience", "строка", "", Неопределено, "прикладная", _АудиторияCI);
	// Издатели доверенных конвейеров сверх встроенных GitHub и GitLab (self-hosted), через запятую.
	Ключи.Объявить("oshub.publish.ci.issuers", "строка", "", Неопределено, "прикладная", _ИздателиCI);

	// Ноль в любом из ключей выключает приём заявок целиком — отдельного флага нет.
	Ключи.Объявить("oshub.publish.inbox.max_pending_per_pool", "целое", 50, _Правила.Минимум(0), "bootstrap",
		_ВходящихНаПул);
	Ключи.Объявить("oshub.publish.inbox.max_pending_per_user", "целое", 5, _Правила.Минимум(0), "bootstrap",
		_ВходящихНаАвтора);

КонецПроцедуры
