// События публикации словами: принятая версия, доверие конвейеру и снятый резерв имени.

Перем События;  // ОбъявленияСобытий (события)

#Область ПубличныйИнтерфейс

// Объявления событий публикации в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияСобытий - события публикации словами.
//
Функция Объявления() Экспорт
	Возврат События;
КонецФункции

#КонецОбласти

&Прозвище("ОписанияСобытий")
&Порядок(10)
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ИздательСобытий") _Издатель) Экспорт

	События = Новый ОбъявленияСобытий();

	// Подписочное событие стоит первым во всём перечне: с него начинается форма подписки.
	События.ОбъявитьПодписочное(_Издатель.ТипВерсияОпубликована(), "version.published", "Версия опубликована",
		"В пул принята новая версия пакета (push через opm или API).");

	События.ОбъявитьВнутреннее(_Издатель.ТипДовериеИзменено(), "Доверие конвейеру изменено",
		"Конвейеру сборки выдано либо отозвано право публиковать версии пакета.",
		"Событие безопасности: доверенный конвейер — это выданное право на публикацию,"
		+ " и его адресат тот же, что у прав доступа, — журнал аудита и администратор."
		+ " Нагрузка собрана под журнал (Кто/Действие/Объект/ДеталиJSON) и называет"
		+ " репозиторий и реф чужой сборки — раздавать это подпиской нельзя.");

	События.ОбъявитьВнутреннее(_Издатель.ТипПакетУдалён(), "Пакет без версий удалён",
		"Резерв имени снят: пакет без единой версии удалён вместе с ролями, доверием"
		+ " конвейерам и подписками на него, имя свободно.",
		"Подписаться на удаление пакета можно было бы только подпиской самого пакета, а она"
		+ " удаляется вместе с ним. Адресат записи — журнал аудита (Кто/Действие/Объект/ДеталиJSON).");

КонецПроцедуры
