// Резерв имени — пакет без единой версии: мейнтейнер пула заводит его, при желании сразу
// с ролью будущему издателю, и снимает, пока версий нет.

Перем СервисПакетов;      // СервисПакетов
Перем Уборка;             // УборкаПакета (реестр) — пакет уходит со всем, что на него ссылается
Перем Издатель;           // ИздательСобытий (события) — снятый резерв уходит в журнал
Перем ИменаЖурнала;       // ИмяОбъектаАудита (аудит) — объект записи журнала
Перем СобытиеЖурнала;     // СобытиеАудита (аудит) — форма нагрузки записи
Перем СервисПулов;        // СервисПулов — принимает ли пул публикации
Перем СервисВерсий;       // СервисВерсий
Перем СервисПрав;         // СервисПрав (права)
Перем СервисПравДоступа;  // СервисПравДоступа (права)
Перем Правила;            // ПравилаИменования
Перем Ошибки;      // ТекстОшибки (основа)
Перем Допуски;            // ДопускПринципала (вход) — лесенка «ключ → учётка»
Перем Вердикты;           // Вердикт (основа) — форма ответа

#Область ПубличныйИнтерфейс

// Резервирует имя пакета в пуле: создаёт пакет-плейсхолдер и, если заданы субъект и роль,
// сразу выдаёт роль на него. Провал выдачи роли откатывает резерв целиком.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  Пул - Пул, Неопределено - пул резерва.
//  ИмяПакета - Строка - резервируемое имя.
//  ТипСубъекта - Строка - пользователь либо группа, "" — роль не выдавать (необязательный,
//                по умолчанию "").
//  СубъектИд - Число - идентификатор субъекта роли (необязательный, по умолчанию 0).
//  Роль - Строка - читатель, райтер или мейнтейнер, "" — роль не выдавать
//         (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число: 201 создано, 400/401/403/404/409 отказ),
//              Сообщение (Строка), Пакет (Пакет либо отсутствует при отказе).
//
Функция Зарезервировать(Знач Принципал, Знач Пул, Знач ИмяПакета,
	Знач ТипСубъекта = "", Знач СубъектИд = 0, Знач Роль = "") Экспорт

	Перем Пакет;

	Вердикт = Допустить(Принципал, Пул, "создание");
	Если НЕ Вердикт.Успех Тогда
		Возврат Вердикт;
	КонецЕсли;

	// закрытый для публикаций пул резервов не принимает; признак читается живым, а не из объекта
	Если НЕ СервисПулов.ПубликацияРазрешена(СервисПулов.ПулПоИдентификатору(Пул.Идентификатор)) Тогда
		Возврат Вердикты.ОтказСКодом(409, СтрШаблон(
			"Пул ""%1"" не принимает публикации: занятое в нём имя останется занятым навсегда,"
			+ " опубликовать в него будет нельзя", Пул.Имя));
	КонецЕсли;

	Норм = СокрЛП(Строка(ИмяПакета));
	Если НЕ Правила.ИмяКорректно(Норм) Тогда
		Возврат Вердикты.ОтказСКодом(400, СтрШаблон("Недопустимое имя пакета ""%1""", ИмяПакета));
	КонецЕсли;

	Если СервисПакетов.НайтиПакет(Пул.Идентификатор, Норм) <> Неопределено Тогда
		Возврат Вердикты.ОтказСКодом(409, СтрШаблон(
			"Имя ""%1"" в пуле ""%2"" уже занято", Норм, Пул.Имя));
	КонецЕсли;

	Пакет = СервисПакетов.ЗарегистрироватьПакет(Пул.Идентификатор, Норм);

	Если ЗначениеЗаполнено(ТипСубъекта) И ЗначениеЗаполнено(Роль) И Цел(СубъектИд) > 0 Тогда
		// выдаём авторизованным контуром, а не системным ЗафиксироватьГрант: тот не
		// спрашивает, вправе ли выдающий, и резерв стал бы способом раздать чужие роли
		Попытка
			СервисПравДоступа.ВыдатьРоль(Вердикт.Пользователь, ТипСубъекта, Цел(СубъектИд),
				СервисПрав.ОбъектПакет(Пакет), Роль);
		Исключение
			// причина снимается ДО отката: вложенная Попытка внутри отката перебила бы её
			Сбой = ИнформацияОбОшибке();
			// откатываем резерв целиком, чтобы имя не осталось занятым «ни за кем»
			Попытка
				СервисПакетов.УдалитьПустойПакет(Пакет);
			Исключение
				// откат best-effort: важнее вернуть внятный отказ
			КонецПопытки;
			Возврат Вердикты.ОтказСКодом(403, "Роль на зарезервированное имя не выдана: " + Ошибки.ДляЧеловека(Сбой));
		КонецПопытки;
	КонецЕсли;

	Результат = Вердикты.УспехСКодом(201, СтрШаблон(
		"Имя ""%1"" зарезервировано в пуле ""%2"": пакет создан, версий пока нет",
		Пакет.Имя, Пул.Имя));
	Результат.Вставить("Пакет", Пакет);
	Возврат Результат;

КонецФункции

// Снимает резерв: удаляет пакет без версий со всем, что на него ссылается, — ролями,
// доверием конвейерам, подписками, — и пишет снятие в журнал аудита. Пакет с версиями, в том
// числе только отозванными, — отказ.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  Пул - Пул, Неопределено - пул резерва.
//  ИмяПакета - Строка - имя снимаемого резерва.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка).
//
Функция СнятьРезерв(Знач Принципал, Знач Пул, Знач ИмяПакета) Экспорт

	Вердикт = Допустить(Принципал, Пул, "удаление");
	Если НЕ Вердикт.Успех Тогда
		Возврат Вердикт;
	КонецЕсли;

	Пакет = СервисПакетов.НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Если Пакет = Неопределено Тогда
		Возврат Вердикты.ОтказСКодом(404, СтрШаблон("Имя ""%1"" в пуле ""%2"" не зарезервировано",
			ИмяПакета, Пул.Имя));
	КонецЕсли;

	Если СервисВерсий.ЕстьВерсии(Пакет.Идентификатор) Тогда
		Возврат Вердикты.ОтказСКодом(409, СтрШаблон(
			"Пакет ""%1"" уже имеет опубликованные версии: это не резерв имени, и снятием"
			+ " резерва он не удаляется", Пакет.Имя));
	КонецЕсли;

	// строки других предметов уходят вместе с пакетом: идентификатор пакета переиспользуется,
	// и следующий пакет иначе унаследовал бы чужие роли, доверие и подписки
	Снято = Уборка.УдалитьПакет(Пакет, Пул.Имя);
	ЗаписатьСнятиеВЖурнал(Вердикт.Пользователь, Пул.Имя, Пакет.Имя, Снято);

	Возврат Вердикты.УспехСКодом(200, СтрШаблон("Резерв имени ""%1"" в пуле ""%2"" снят", Пакет.Имя, Пул.Имя));

КонецФункции

// Отбирает из перечисленных пакетов резервы — пакеты, у которых не было ни одной версии.
// Отозванная версия — тоже версия: пакет с одними отозванными резервом не считается.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Соответствие - идентификатор пакета (Число) в Истина; пакета с версиями в множестве нет.
//
Функция РезервыСреди(Знач ПакетИдентификаторы) Экспорт

	Результат = Новый Соответствие();
	Если ПакетИдентификаторы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	СВерсиями = СервисВерсий.ПакетыСВерсиямиСреди(ПакетИдентификаторы);
	Для Каждого Идентификатор Из ПакетИдентификаторы Цикл
		Если СВерсиями.Получить(Цел(Идентификатор)) = Неопределено Тогда
			Результат.Вставить(Цел(Идентификатор), Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Находит резерв по имени — пакет пула без единой версии.
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Пакет, Неопределено - резерв; Неопределено — имени в пуле нет либо у пакета есть версии.
//
Функция НайтиРезерв(Знач Пул, Знач ИмяПакета) Экспорт

	Если Пул = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ИмяПакета) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пакет = СервисПакетов.НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Если Пакет = Неопределено ИЛИ СервисВерсий.ЕстьВерсии(Пакет.Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Пакет;

КонецФункции

// Вправе ли человек заводить и снимать резервы имён в пуле — порог тот же, что у операций,
// без рамок ключа: так экран решает, показывать ли кнопки.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - смотрящий; гость — Неопределено.
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Булево.
//
Функция ВправеРезервировать(Знач Пользователь, Знач Пул) Экспорт

	Если Пользователь = Неопределено ИЛИ Пул = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СервисПрав.РольНеНиже(Пользователь, СервисПрав.ОбъектПул(Пул), СервисПрав.РольМейнтейнер());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Общий пролог обеих операций; доступ даёт только последняя строка.
Функция Допустить(Знач Принципал, Знач Пул, Знач Действие)

	Если Пул = Неопределено Тогда
		Возврат Вердикты.ОтказСКодом(404, "Пул не найден");
	КонецЕсли;

	// рамки ключа — ДО прав человека: код ответа не должен зависеть от того, что ключ
	// узнал сверх своих рамок
	Допуск = Допуски.Пропустить(Принципал, Действие, Пул.Идентификатор, ДелоРезерва());
	Если НЕ Допуск.Успех Тогда
		Возврат Допуск;
	КонецЕсли;

	Пользователь = Допуск.Пользователь;
	Если НЕ ВправеРезервировать(Пользователь, Пул) Тогда
		Возврат Вердикты.ОтказСКодом(403, СтрШаблон(
			"Имена в пуле ""%1"" резервируют его мейнтейнеры и выше", Пул.Имя));
	КонецЕсли;

	Возврат Вердикты.УспехСКодом(200, "", Новый Структура("Пользователь", Пользователь));

КонецФункции

// Пакета к этому моменту уже нет, поэтому объект записи назван именами, а не идентификатором.
Процедура ЗаписатьСнятиеВЖурнал(Знач Пользователь, Знач ИмяПула, Знач ИмяПакета, Знач Снято)

	Данные = СобытиеЖурнала.Собрать(Строка(Пользователь.Логин), Издатель.ТипПакетУдалён(),
		ИменаЖурнала.ПакетПоИменам(ИмяПула, ИмяПакета), "",
		Новый Структура("пул, пакет, строк", ИмяПула, ИмяПакета, Снято));

	Попытка
		Издатель.Опубликовать(Издатель.ТипПакетУдалён(), Данные);
	Исключение
		// журнал вторичен: пакет уже снят и откату не подлежит
	КонецПопытки;

КонецПроцедуры

// Как зовётся дело в отказе гейта ключа.
Функция ДелоРезерва()
	Возврат Допуски.Дело("Резервирование имени недоступно", "Резервирование имени запрещено");
КонецФункции

#КонецОбласти

&Желудь
&Наблюдаемый
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисПравДоступа") _СервисПравДоступа,
	&Пластилин(Значение = "ПравилаИменования") _Правила,
	&Пластилин(Значение = "ДопускПринципала") _Допуски,
	&Пластилин(Значение = "УборкаПакета") _Уборка,
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "ИмяОбъектаАудита") _ИменаЖурнала,
	&Пластилин(Значение = "СобытиеАудита") _СобытиеЖурнала,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Пластилин(Значение = "Вердикт") _Вердикты = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Вердикты = ?(_Вердикты = Неопределено, Новый Вердикт(), _Вердикты);
	Допуски = _Допуски;
	Уборка = _Уборка;
	Издатель = _Издатель;
	ИменаЖурнала = _ИменаЖурнала;
	СобытиеЖурнала = _СобытиеЖурнала;
	СервисПакетов = _СервисПакетов;
	СервисПулов = _СервисПулов;
	СервисВерсий = _СервисВерсий;
	СервисПрав = _СервисПрав;
	СервисПравДоступа = _СервисПравДоступа;
	Правила = _Правила;

КонецПроцедуры
