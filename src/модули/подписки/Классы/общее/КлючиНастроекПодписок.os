// Ключи настроек подписок: рубильник доставки и разрешение http, пороги доставки, потолок
// проб и прокси до Bot API.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей подписок в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи подписок.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(110)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "oshub.webhooks.delivery_enabled", ЗначениеПоУмолчанию = "") _ДоставкаВключена = "",
	&Деталька(Значение = "oshub.webhooks.allow_insecure", ЗначениеПоУмолчанию = "") _РазрешитьHTTP = "",
	&Деталька(Значение = "oshub.webhooks.max_queue", ЗначениеПоУмолчанию = "") _ОчередьДоставки = "",
	&Деталька(Значение = "oshub.webhooks.max_attempts", ЗначениеПоУмолчанию = "") _МаксПопыток = "",
	&Деталька(Значение = "oshub.webhooks.backoff_base_sec", ЗначениеПоУмолчанию = "") _БэкоффБаза = "",
	&Деталька(Значение = "oshub.webhooks.delivery_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалДоставки = "",
	&Деталька(Значение = "oshub.webhooks.delivery_timeout_sec", ЗначениеПоУмолчанию = "") _ТаймаутДоставки = "",
	&Деталька(Значение = "oshub.webhooks.test_max_per_hour", ЗначениеПоУмолчанию = "") _ПотолокПроб = "",
	&Деталька(Значение = "oshub.webhooks.telegram.proxy.host", ЗначениеПоУмолчанию = "") _СерверПроксиTelegram = "",
	&Деталька(Значение = "oshub.webhooks.telegram.proxy.port", ЗначениеПоУмолчанию = "") _ПортПроксиTelegram = "",
	&Деталька(Значение = "oshub.webhooks.telegram.proxy.user", ЗначениеПоУмолчанию = "") _ПользовательПроксиTelegram = "",
	&Деталька(Значение = "oshub.webhooks.telegram.proxy.password", ЗначениеПоУмолчанию = "") _ПарольПроксиTelegram = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	// Из интерфейса правятся рубильник доставки и разрешение http — решения администратора;
	// пороги доставки и потолок проб — числа машины, они за конфигурацией.
	Ключи.Объявить("oshub.webhooks.delivery_enabled", "булево", Истина, Неопределено, "прикладная",
		_ДоставкаВключена);
	Ключи.Объявить("oshub.webhooks.allow_insecure", "булево", Ложь, Неопределено, "прикладная", _РазрешитьHTTP);
	Ключи.Объявить("oshub.webhooks.max_queue", "целое", 10000, _Правила.Минимум(1), "bootstrap",
		_ОчередьДоставки);
	Ключи.Объявить("oshub.webhooks.max_attempts", "целое", 5, _Правила.Минимум(1), "bootstrap", _МаксПопыток);
	Ключи.Объявить("oshub.webhooks.backoff_base_sec", "целое", 10, _Правила.Минимум(1), "bootstrap",
		_БэкоффБаза);
	Ключи.Объявить("oshub.webhooks.delivery_interval_sec", "целое", 5, _Правила.Минимум(1), "bootstrap",
		_ИнтервалДоставки);
	Ключи.Объявить("oshub.webhooks.delivery_timeout_sec", "целое", 10, _Правила.Минимум(1), "bootstrap",
		_ТаймаутДоставки);
	Ключи.Объявить("oshub.webhooks.test_max_per_hour", "целое", 100, _Правила.Минимум(1), "bootstrap",
		_ПотолокПроб);

	// Прокси до Bot API правится из интерфейса; пустой сервер — Bot API напрямую.
	Ключи.Объявить("oshub.webhooks.telegram.proxy.host", "строка", "", Неопределено, "прикладная",
		_СерверПроксиTelegram);
	Ключи.Объявить("oshub.webhooks.telegram.proxy.port", "целое", 3128, _Правила.Диапазон(1, 65535),
		"прикладная", _ПортПроксиTelegram);
	Ключи.Объявить("oshub.webhooks.telegram.proxy.user", "строка", "", Неопределено, "прикладная",
		_ПользовательПроксиTelegram);
	Ключи.ОбъявитьСекрет("oshub.webhooks.telegram.proxy.password", "строка", "", Неопределено, "прикладная",
		_ПарольПроксиTelegram);

КонецПроцедуры
