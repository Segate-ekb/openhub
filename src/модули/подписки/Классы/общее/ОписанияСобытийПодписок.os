// События подписок словами: пробная доставка с экрана.

Перем События;  // ОбъявленияСобытий (события)

#Область ПубличныйИнтерфейс

// Объявления событий подписок в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияСобытий - события подписок словами.
//
Функция Объявления() Экспорт
	Возврат События;
КонецФункции

#КонецОбласти

&Прозвище("ОписанияСобытий")
&Порядок(80)
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ИздательСобытий") _Издатель) Экспорт

	События = Новый ОбъявленияСобытий();

	События.ОбъявитьВнутреннее(_Издатель.ТипПробаПодписки(), "Пробная доставка подписки",
		"Владелец подписки отправил на неё пробное уведомление с экрана.",
		"Действие администратора, а не событие хаба: адресат у него один — сама подписка,"
		+ " которую и проверяют. Нагрузка собрана под журнал аудита.");

КонецПроцедуры
