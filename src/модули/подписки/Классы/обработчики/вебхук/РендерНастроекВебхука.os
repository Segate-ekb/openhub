// Рендер настроек действия «вебхук»: отдаёт декларацию полей формы, разметку по ней
// строит ПоляПодписки.

#Область КонтрактРендераНастроек

// Тип действия.
//
// Возвращаемое значение:
//  Строка - "вебхук".
//
Функция ТипДействия() Экспорт
	Возврат "вебхук";
КонецФункции

// Ключ подписи типа в переключателе типов действия.
//
// Возвращаемое значение:
//  Строка - ключ СловаряТекстов.
//
Функция КлючПодписи() Экспорт
	Возврат "subscriptions.type.webhook.label";
КонецФункции

// Ключ пояснения к типу.
//
// Возвращаемое значение:
//  Строка - ключ СловаряТекстов; пустая строка, если пояснения нет.
//
Функция КлючПояснения() Экспорт
	Возврат "subscriptions.type.webhook.hint";
КонецФункции

// Декларативное описание полей настроек подписки этого типа.
//
// Возвращаемое значение:
//  Массив - структуры с полями: Имя (свойство во вводе ПодготовитьНастройки),
//  ИмяПоля (атрибут name, уникален среди всех типов), КлючПодписи, КлючПодсказки,
//  КлючПлейсхолдера (ключи СловаряТекстов), Обязательное, Секретное,
//  КлючСвоего (подпись флажка «секрет свой» в форме правки).
//
Функция ОписаниеПолей() Экспорт

	Поля = Новый Массив();
	Поля.Добавить(Поле("URL", "url",
		"subscriptions.webhook.url.label",
		"subscriptions.webhook.url.hint",
		"subscriptions.webhook.url.placeholder", Истина, Ложь));
	Поля.Добавить(Поле("Секрет", "секрет",
		"subscriptions.webhook.secret.label",
		"subscriptions.webhook.secret.hint",
		"subscriptions.webhook.secret.placeholder", Ложь, Истина,
		"subscriptions.webhook.secret.own"));
	Возврат Поля;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Поле(Знач Имя, Знач ИмяПоля, Знач КлючПодписи, Знач КлючПодсказки,
	Знач КлючПлейсхолдера, Знач Обязательное, Знач Секретное, Знач КлючСвоего = "")

	Возврат Новый Структура(
		"Имя, ИмяПоля, КлючПодписи, КлючПодсказки, КлючПлейсхолдера, Обязательное,"
		+ " Секретное, КлючСвоего",
		Имя, ИмяПоля, КлючПодписи, КлючПодсказки, КлючПлейсхолдера, Обязательное,
		Секретное, КлючСвоего);

КонецФункции

#КонецОбласти

&Прозвище("РендерНастроекПодписки")
&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
