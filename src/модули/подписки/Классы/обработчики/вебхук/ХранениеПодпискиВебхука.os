// Описание хранения действия «вебхук»: адрес подписки — целевой URL доставки, секрет —
// для HMAC-подписи тела, показывается создателю ровно один раз.

#Использовать pwhash

Перем Валидатор;  // ВалидаторАдресаВебхука (подписки)

#Область КонтрактХраненияПодписки

// Тип действия.
//
// Возвращаемое значение:
//  Строка - "вебхук".
//
Функция ТипДействия() Экспорт
	Возврат "вебхук";
КонецФункции

// Валидирует и нормализует ввод настроек при создании подписки. Пустой секрет
// генерируется криптостойко. Бросает исключение на недопустимом URL.
//
// Параметры:
//  Ввод - Структура - URL (Строка) и Секрет (Строка, необязательный).
//
// Возвращаемое значение:
//  Структура - Адрес, Секрет, НастройкиДействия для записи подписки.
//
Функция ПодготовитьНастройки(Знач Ввод) Экспорт

	URL = Свойство(Ввод, "URL", "");
	НормУРЛ = НормализоватьURL(URL);
	Вердикт = Валидатор.Проверить(НормУРЛ);
	Если НЕ Вердикт.Ок Тогда
		ВызватьИсключение "Недопустимый URL вебхука: " + Вердикт.Ошибка;
	КонецЕсли;

	Секрет = Свойство(Ввод, "Секрет", "");
	ЭффективныйСекрет = ?(ЗначениеЗаполнено(Секрет), Строка(Секрет), СгенерироватьСекрет());

	Возврат Новый Структура("Адрес, Секрет, НастройкиДействия", НормУРЛ, ЭффективныйСекрет, "");

КонецФункции

// Значения полей типа для формы правки. Значения секрета здесь нет — только признак
// «секрет у подписки свой»: он всегда есть, и снятый флажок означает «выпустить новый».
//
// Параметры:
//  Подписка - Вебхук - запись подписки.
//
// Возвращаемое значение:
//  Структура - значения по именам ввода полей (ОписаниеПолей.Имя) и признаки «<Имя>Свой».
//
Функция ЗначенияПравки(Знач Подписка) Экспорт
	Возврат Новый Структура("URL, СекретСвой", Строка(Подписка.URL), Истина);
КонецФункции

// Валидирует ввод формы правки. Пустой секрет при включённом «своём секрете» означает
// «оставить прежний», выключенный — выпустить новый и показать его один раз.
//
// Параметры:
//  Ввод - Структура - URL, Секрет и признак СекретСвой (Булево).
//  Подписка - Вебхук - правимая запись.
//
// Возвращаемое значение:
//  Структура - Адрес, Секрет, НастройкиДействия, ПоказатьСекрет для записи подписки.
//
Функция ПодготовитьПравку(Знач Ввод, Знач Подписка) Экспорт

	Секрет = СекретПравки(Ввод, Подписка);
	Результат = ПодготовитьНастройки(
		Новый Структура("URL, Секрет", Свойство(Ввод, "URL", ""), Секрет.Значение));
	Результат.Вставить("ПоказатьСекрет", Секрет.Показать);
	Возврат Результат;

КонецФункции

// Разворачивает запись подписки в настройки доставки для задания очереди.
//
// Параметры:
//  Подписка - Вебхук - запись подписки.
//
// Возвращаемое значение:
//  Структура - поля URL и Секрет по контракту ДоставкаВебхуком.
//
Функция НастройкиДоставки(Знач Подписка) Экспорт
	Возврат Новый Структура("URL, Секрет", Строка(Подписка.URL), Строка(Подписка.Секрет));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выключенный «свой секрет» означает «выпустить новый», и новый обязан быть показан.
Функция СекретПравки(Знач Ввод, Знач Подписка)

	Если НЕ (Свойство(Ввод, "СекретСвой", Ложь) = Истина) Тогда
		Возврат Новый Структура("Значение, Показать", СгенерироватьСекрет(), Истина);
	КонецЕсли;

	Введённый = СокрЛП(Строка(Свойство(Ввод, "Секрет", "")));
	Если ЗначениеЗаполнено(Введённый) Тогда
		Возврат Новый Структура("Значение, Показать", Введённый, Ложь);
	КонецЕсли;

	Прежний = Строка(Подписка.Секрет);
	// пустой прежний секрет оставил бы подписку без подписи вовсе
	Если НЕ ЗначениеЗаполнено(Прежний) Тогда
		Возврат Новый Структура("Значение, Показать", СгенерироватьСекрет(), Истина);
	КонецЕсли;
	Возврат Новый Структура("Значение, Показать", Прежний, Ложь);

КонецФункции

// Схема и authority к нижнему регистру: иначе Example.com и example.com дали бы дубль.
Функция НормализоватьURL(Знач URL)
	Значение = СокрЛП(Строка(URL));
	Позиция = Найти(Значение, "://");
	Если Позиция = 0 Тогда
		Возврат Значение; // без схемы валидатор всё равно отклонит
	КонецЕсли;
	Схема = НРег(Лев(Значение, Позиция + 2)); // включая "://"
	Остаток = Сред(Значение, Позиция + 3);

	КонецАвторитета = СтрДлина(Остаток);
	Для Каждого Разделитель Из СтрРазделить("/,?,#", ",") Цикл
		П = Найти(Остаток, Разделитель);
		Если П > 0 И (П - 1) < КонецАвторитета Тогда
			КонецАвторитета = П - 1;
		КонецЕсли;
	КонецЦикла;

	Авторитет = НРег(Лев(Остаток, КонецАвторитета));
	Хвост = Сред(Остаток, КонецАвторитета + 1);
	Возврат Схема + Авторитет + Хвост;
КонецФункции

Функция СгенерироватьСекрет()
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешированиеПаролей.СгенерироватьСоль(32)));
КонецФункции

Функция Свойство(Знач Данные, Знач Имя, Знач ПоУмолчанию)
	Значение = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

#КонецОбласти

&Прозвище("ХранениеПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВалидаторАдресаВебхука") _Валидатор)

	Валидатор = _Валидатор;

КонецПроцедуры
