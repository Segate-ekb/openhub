// Обработчик доставки действия «вебхук»: HTTP-POST на цель подписки с заголовками
// X-OpenHub-Event, X-OpenHub-Delivery и подписью X-OpenHub-Signature (HMAC-SHA256 из
// pwhash). Ретраи клиента HTTP намеренно выключены — ограниченные ретраи с бэкоффом
// даёт ядро (СлужбаДоставкиПодписок).
#Использовать pwhash

Перем Телеметрия;     // фасад OTel (наблюдаемость), опционален
Перем Числа;       // ПриведениеЧисел (основа)
Перем КлиентHTTP;     // ТранспортHTTP (сеть)
Перем Валидатор;      // ВалидаторАдресаВебхука (подписки)
Перем Ошибки;         // ТекстОшибки (основа) — однострочная диагностика пробы
Перем Настройки;      // СервисНастроек (настройки) — таймаут одной доставки
&Лог
Перем Лог;

#Область КонтрактОбработчикаДоставки

// Тип действия, который доставляет обработчик.
//
// Возвращаемое значение:
//  Строка - "вебхук".
//
Функция ТипДействия() Экспорт
	Возврат "вебхук";
КонецФункции

// Разбор цели перед каждым POST: снятое из базы значение обязано остаться адресом.
// Куда адрес ведёт, не проверяется — это выбор того, кто завёл подписку. Вердикт
// «не Ок» отбрасывает задание без ретраев: строка сама себя не починит.
//
// Параметры:
//  Задание - Структура - задание очереди; цель в Действие.URL.
//
// Возвращаемое значение:
//  Структура - Ок (Булево) и Ошибка (Строка).
//
Функция ПередДоставкой(Знач Задание) Экспорт

	Вердикт = Валидатор.Проверить(Задание.Действие.URL);
	Если НЕ Вердикт.Ок Тогда
		Лог.Отладка("Вебхук %1: цель %2 не прошла валидатор — доставки не будет: %3",
			Задание.ИдДоставки, Задание.Действие.URL, Вердикт.Ошибка);
		Возврат Отказ(СтрШаблон("цель %1 не разбирается как адрес: %2",
			Задание.Действие.URL, Вердикт.Ошибка));
	КонецЕсли;
	Возврат Новый Структура("Ок, Ошибка", Истина, "");

КонецФункции

// POST на цель с подписью и заголовками. Атрибуты клиентского спана — тип события,
// попытка и код ответа; ни URL, ни секрет, ни подпись в спан не попадают.
//
// Параметры:
//  Задание - Структура - задание очереди: ИдДоставки, Действие, ТипСобытия, Тело,
//            НомерПопытки.
//
// Возвращаемое значение:
//  Булево - Истина при HTTP 2xx.
//
Функция Доставить(Знач Задание) Экспорт
	Возврат Отправить(Задание).Ок;
КонецФункции

// Пробная отправка: одна попытка, результат — КОД ответа и краткая причина.
// Тело ответа наружу не отдаётся: чтение ответа внутреннего сервиса через наш экран
// превратило бы слепой SSRF в полноценный. Адрес цели в ответе тоже не повторяется —
// его и так видно в форме.
//
// Параметры:
//  Задание - Структура - синтетическое задание пробы.
//
// Возвращаемое значение:
//  Структура - Ок (Булево) и Описание (Строка): код ответа либо причина сбоя.
//
Функция Проба(Знач Задание) Экспорт

	Вердикт = ПередДоставкой(Задание);
	Если НЕ Вердикт.Ок Тогда
		Возврат Новый Структура("Ок, Описание", Ложь, Вердикт.Ошибка);
	КонецЕсли;

	Попытка
		Итог = Отправить(Задание);
	Исключение
		// подробности — в журнал: на экране от них только пути внутрь машины
		Лог.Предупреждение("Проба вебхука %1: сбой отправки: %2", Задание.ИдДоставки,
			Ошибки.Однострочно(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Новый Структура("Ок, Описание", Ложь,
			"цель не ответила: сеть недоступна, имя не разрешается либо истёк таймаут");
	КонецПопытки;

	Возврат Новый Структура("Ок, Описание", Итог.Ок,
		СтрШаблон("HTTP %1", Формат(Итог.Код, "ЧГ=0; ЧН=0")));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Один POST: и боевая доставка, и проба ходят одной дорогой — иначе проверки разъехались бы.
Функция Отправить(Знач Задание)

	Действие = Задание.Действие;

	Спан = Неопределено;
	Если Телеметрия <> Неопределено Тогда
		Атрибуты = Новый Соответствие();
		Атрибуты.Вставить("messaging.system", "openhub-webhook");
		Атрибуты.Вставить("oshub.event.type", Задание.ТипСобытия);
		Атрибуты.Вставить("oshub.webhook.attempt", Задание.НомерПопытки);
		Спан = Телеметрия.НачатьСпан("webhook.deliver", "client", Атрибуты);
	КонецЕсли;

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Заголовки.Вставить("User-Agent", "OpenHub-Webhook/1.0");
	Заголовки.Вставить("X-OpenHub-Event", Задание.ТипСобытия);
	Заголовки.Вставить("X-OpenHub-Delivery", Задание.ИдДоставки);
	Заголовки.Вставить("X-OpenHub-Signature", Подпись(Действие.Секрет, Задание.Тело));

	// секрет называется только фактом наличия: подпись и сам секрет в журнал не идут
	ТаймаутСек = Настройки.Значение("oshub.webhooks.delivery_timeout_sec");
	Лог.Отладка("Вебхук %1: POST на %2, событие ""%3"", попытка %4, таймаут %5 с,"
		+ " подписан секретом: %6",
		Задание.ИдДоставки, Действие.URL, Задание.ТипСобытия, Задание.НомерПопытки,
		ТаймаутСек, ЗначениеЗаполнено(Действие.Секрет));

	Попытка
		Ответ = КлиентHTTP.Отправить(Действие.URL, Задание.Тело, Заголовки, ТаймаутСек);
	Исключение
		Если Спан <> Неопределено Тогда
			Спан.Ошибка("сбой сети");
			Спан.Завершить();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Успех = (Ответ.Код >= 200 И Ответ.Код < 300);
	Если Спан <> Неопределено Тогда
		Спан.УстановитьАтрибут("http.response.status_code", Ответ.Код);
	КонецЕсли;
	Если Успех Тогда
		Лог.Информация("Вебхук %1: доставлен на %2 (код %3)", Задание.ИдДоставки, Действие.URL, Ответ.Код);
	Иначе
		Если Спан <> Неопределено Тогда
			Спан.Ошибка("HTTP " + Ответ.Код);
		КонецЕсли;
		Лог.Предупреждение("Вебхук %1: цель %2 ответила %3 (попытка %4)",
			Задание.ИдДоставки, Действие.URL, Ответ.Код, Задание.НомерПопытки);
	КонецЕсли;
	Если Спан <> Неопределено Тогда
		Спан.Завершить();
	КонецЕсли;
	Возврат Новый Структура("Ок, Код", Успех, Ответ.Код);

КонецФункции

Функция Отказ(Знач Текст)
	Возврат Новый Структура("Ок, Ошибка", Ложь, Текст);
КонецФункции

#КонецОбласти

#Область ПубличныйИнтерфейс

// Заголовок подписи тела секретом вебхука. Ту же формулу проверяет приёмная сторона.
//
// Параметры:
//  Секрет - Строка - секрет вебхука.
//  Тело - Строка - подписываемое тело.
//
// Возвращаемое значение:
//  Строка - "sha256=" и 64 hex-символа HMAC-SHA256.
//
Функция Подпись(Знач Секрет, Знач Тело) Экспорт
	Возврат "sha256=" + НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешированиеПаролей.HMACSHA256(Секрет, Тело)));
КонецФункции

#КонецОбласти

// Лог инъекцией в поле (&Лог выше) — боевой путь; параметр _Лог — для прямого
// создания вне контейнера, куда инъекция в поле не доезжает.
&Прозвище("ОбработчикДоставкиПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТранспортHTTP") _КлиентHTTP,
	&Пластилин(Значение = "ВалидаторАдресаВебхука") _Валидатор,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "Телеметрия") _Телеметрия = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Числа = ?(_Числа = Неопределено, Новый ПриведениеЧисел(), _Числа);
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	КлиентHTTP = _КлиентHTTP;
	Валидатор = _Валидатор;
	Телеметрия = _Телеметрия;
	Настройки = _Настройки;

КонецПроцедуры
