// Рендер настроек действия «telegram»: отдаёт декларацию полей формы, разметку по ней
// строит ФормаДействияПодписки. Токен бота — обязательное секретное поле.

#Область КонтрактРендераНастроек

// Тип действия.
//
// Возвращаемое значение:
//  Строка - "telegram".
//
Функция ТипДействия() Экспорт
	Возврат "telegram";
КонецФункции

// Ключ подписи типа в переключателе типов действия.
//
// Возвращаемое значение:
//  Строка - ключ СловаряТекстов.
//
Функция КлючПодписи() Экспорт
	Возврат "subscriptions.type.telegram.label";
КонецФункции

// Ключ пояснения к типу.
//
// Возвращаемое значение:
//  Строка - ключ СловаряТекстов; пустая строка, если пояснения нет.
//
Функция КлючПояснения() Экспорт
	Возврат "subscriptions.type.telegram.hint";
КонецФункции

// Декларативное описание полей настроек подписки этого типа.
//
// Возвращаемое значение:
//  Массив - структуры Имя, ИмяПоля, КлючПодписи, КлючПодсказки, КлючПлейсхолдера,
//  Обязательное, Секретное, Многострочное, КлючСвоего (подпись флажка «секрет свой»).
//
Функция ОписаниеПолей() Экспорт

	Поля = Новый Массив();
	Поля.Добавить(Поле("ЧатИд", "chat-id",
		"subscriptions.telegram.chat-id.label",
		"subscriptions.telegram.chat-id.hint",
		"subscriptions.telegram.chat-id.placeholder", Истина, Ложь, Ложь));
	Поля.Добавить(Поле("Токен", "бот-токен",
		"subscriptions.telegram.token.label",
		"subscriptions.telegram.token.hint",
		"subscriptions.telegram.token.placeholder", Истина, Истина, Ложь));
	Поля.Добавить(Поле("Шаблон", "шаблон-текста",
		"subscriptions.telegram.template.label",
		"subscriptions.telegram.template.hint",
		"subscriptions.telegram.template.placeholder", Ложь, Ложь, Истина));
	Возврат Поля;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Поле(Знач Имя, Знач ИмяПоля, Знач КлючПодписи, Знач КлючПодсказки,
	Знач КлючПлейсхолдера, Знач Обязательное, Знач Секретное, Знач Многострочное,
	Знач КлючСвоего = "")

	Возврат Новый Структура(
		"Имя, ИмяПоля, КлючПодписи, КлючПодсказки, КлючПлейсхолдера,"
		+ " Обязательное, Секретное, Многострочное, КлючСвоего",
		Имя, ИмяПоля, КлючПодписи, КлючПодсказки, КлючПлейсхолдера,
		Обязательное, Секретное, Многострочное, КлючСвоего);

КонецФункции

#КонецОбласти

&Прозвище("РендерНастроекПодписки")
&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
