// Адрес карточки превью сообщения Telegram: карточка есть, только если в тексте есть ссылка, —
// первая годная из релиза, страницы версии в хабе, репозитория и своей ссылки текста.

Перем ЧтениеПула;   // ГвардДоступаКПулу (права) — прочтёт ли пул аноним
Перем АдресХаба;    // АдресИнстанса (настройки) — внешний адрес хаба
Перем Страницы;     // АдресаСтраниц (реестр) — путь страницы версии
Перем Адреса;       // РазборАдреса (основа)
Перем ЧтениеПолей;  // ЧтениеПолей (основа)
Перем Ошибки;       // ТекстОшибки (основа)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Адрес карточки превью по телу доставки и тексту сообщения. Шаг идёт в карточку, только если
// его адрес стоит в тексте. Порядок: страница релиза; страница версии в хабе — когда в тексте
// страница пакета, у хаба задан внешний адрес и пул прочтёт аноним (краулер Telegram ходит без
// входа); репозиторий пакета; первая своя ссылка текста. Негодный адрес шага — шаг пропускается.
//
// Параметры:
//  Тело - Строка - JSON-тело доставки; неразборчивое — карточка только по своей ссылке текста.
//  Текст - Строка - текст сообщения, который уйдёт в чат.
//
// Возвращаемое значение:
//  Строка - абсолютный адрес http(s) без данных пользователя, пробелов и управляющих символов
//           либо "" — превью не будет: в тексте нет ни одной годной ссылки.
//
Функция Адрес(Знач Тело, Знач Текст) Экспорт

	Ссылки = СсылкиТекста(Текст);
	Если Ссылки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Данные = РазобратьТело(Тело);
	Если СобытиеОВерсии(Данные) Тогда
		Адрес = АдресСобытия(Данные, Ссылки);
		Если ЗначениеЗаполнено(Адрес) Тогда
			Возврат Адрес;
		КонецЕсли;
	КонецЕсли;
	Возврат СвояСсылка(Ссылки, Поле(Данные, "ссылка"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АдресСобытия(Знач Данные, Знач Ссылки)

	Релиз = Поле(Данные, "релиз");
	Если ВТексте(Ссылки, Релиз) И ГодитсяВПревью(Релиз) Тогда
		Возврат Релиз;
	КонецЕсли;

	// пул читается из базы, поэтому страница хаба спрашивается, только когда релиза нет
	Если ВТексте(Ссылки, Поле(Данные, "ссылка")) Тогда
		Страница = СтраницаВерсииДляГостя(Данные);
		Если ГодитсяВПревью(Страница) Тогда
			Возврат Страница;
		КонецЕсли;
	КонецЕсли;

	Репозиторий = Поле(Данные, "репозиторий");
	Возврат ?(ВТексте(Ссылки, Репозиторий) И ГодитсяВПревью(Репозиторий), Репозиторий, "");

КонецФункции

// Своя ссылка — не страница пакета в хабе: её карточку решает шаг страницы версии, и приватную
// страницу краулер всё равно не получит.
Функция СвояСсылка(Знач Ссылки, Знач СтраницаПакета)

	Для Каждого Ссылка Из Ссылки Цикл
		Если ВедётНа(Ссылка, СтраницаПакета) ИЛИ НЕ ГодитсяВПревью(Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		Возврат Ссылка;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ВТексте(Знач Ссылки, Знач Адрес)

	Для Каждого Ссылка Из Ссылки Цикл
		Если ВедётНа(Ссылка, Адрес) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Та же страница — и с параметрами или якорем: страница версии — страница пакета с номером.
Функция ВедётНа(Знач Ссылка, Знач Адрес)

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Ссылка = Адрес ИЛИ СтрНачинаетсяС(Ссылка, Адрес + "?") ИЛИ СтрНачинаетсяС(Ссылка, Адрес + "#");

КонецФункции

// Ссылки http(s) текста в порядке появления. Ссылка кончается пробельным символом или кавычкой,
// знак препинания в её конце — уже текст: «…/v1.2.3.» в конце фразы, а закрывающая скобка —
// текст, только если парной ей открывающей в ссылке нет: «(…/Foo_(bar))».
Функция СсылкиТекста(Знач Текст)

	Результат = Новый Массив();
	Хвост = Строка(Текст);
	Позиция = НачалоСсылки(Хвост);

	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция);
		Длина = 0;
		Пока Длина < СтрДлина(Хвост) И НЕ КонецСсылки(Сред(Хвост, Длина + 1, 1)) Цикл
			Длина = Длина + 1;
		КонецЦикла;
		Ссылка = Лев(Хвост, Длина);
		Пока ЗначениеЗаполнено(Ссылка) И ЛишнийВКонце(Ссылка) Цикл
			Ссылка = Лев(Ссылка, СтрДлина(Ссылка) - 1);
		КонецЦикла;
		Результат.Добавить(Ссылка);
		Хвост = Сред(Хвост, Длина + 1);
		Позиция = НачалоСсылки(Хвост);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЛишнийВКонце(Знач Ссылка)

	Последний = Прав(Ссылка, 1);
	Если СтрНайти(".,;:!?'»", Последний) > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Позиция = СтрНайти(")]}", Последний);
	Если Позиция = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Открывающая = Сред("([{", Позиция, 1);
	Возврат СтрЧислоВхождений(Ссылка, Открывающая) < СтрЧислоВхождений(Ссылка, Последний);

КонецФункции

Функция НачалоСсылки(Знач Текст)

	Строчные = НРег(Текст);
	Защищённая = СтрНайти(Строчные, "https://");
	Открытая = СтрНайти(Строчные, "http://");
	Если Защищённая = 0 ИЛИ (Открытая > 0 И Открытая < Защищённая) Тогда
		Возврат Открытая;
	КонецЕсли;
	Возврат Защищённая;

КонецФункции

Функция КонецСсылки(Знач Символ)
	Возврат ПустаяСтрока(Символ) ИЛИ СтрНайти("""<>«»", Символ) > 0;
КонецФункции

// Без внешнего адреса абсолютной ссылки на страницу нет; карточку приватной страницы
// краулер не получит — он увидит тот же 404, что любой гость. У каждой версии свой адрес:
// Telegram запоминает карточку по адресу.
Функция СтраницаВерсииДляГостя(Знач Данные)

	База = АдресХаба.Базовый();
	Пул = Поле(Данные, "пул");
	Если НЕ ЗначениеЗаполнено(База) ИЛИ НЕ ПулОткрытГостю(Пул) Тогда
		Возврат "";
	КонецЕсли;
	Возврат База + Страницы.Версии(Пул, Поле(Данные, "пакет"), Поле(Данные, "версия"));

КонецФункции

// Сбой чтения пула превью не срывает доставку: страница хаба просто не годится.
Функция ПулОткрытГостю(Знач ИмяПула)

	Попытка
		Возврат ЧтениеПула.ЧитаемыйПул(Неопределено, ИмяПула) <> Неопределено;
	Исключение
		Если Лог <> Неопределено Тогда
			Лог.Предупреждение("Превью Telegram: видимость пула «%1» не прочитана, страница хаба"
				+ " в превью не идёт — %2", ИмяПула, Ошибки.Причина(ИнформацияОбОшибке()));
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// У заполнения пула нет ни пакета, ни версии.
Функция СобытиеОВерсии(Знач Данные)
	Возврат ЗначениеЗаполнено(Поле(Данные, "пакет")) И ЗначениеЗаполнено(Поле(Данные, "версия"));
КонецФункции

// Адрес репозитория пишет публикующий: «git@…» и голый путь карточкой не станут, учётные
// данные в адресе краулер Telegram предъявил бы чужому серверу, а пробел или перевод строки
// делают адрес негодным для Bot API.
Функция ГодитсяВПревью(Знач Кандидат)

	Если НЕ ЗначениеЗаполнено(Кандидат) ИЛИ ЗначениеЗаполнено(Адреса.НайтиУправляющий(Кандидат)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Части = Адреса.СхемаИУзел(Кандидат);
	Возврат (Части.Схема = "https" ИЛИ Части.Схема = "http") И ЗначениеЗаполнено(Части.Хост)
		И НЕ Части.СДаннымиПользователя;

КонецФункции

Функция Поле(Знач Данные, Знач Имя)
	Возврат СокрЛП(Строка(ЧтениеПолей.Поле(Данные, Имя, "")));
КонецФункции

// Неразборчивое тело — Неопределено: превью не будет, а сообщение уйдёт.
Функция РазобратьТело(Знач Тело)
	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(Строка(Тело));
		Результат = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардДоступаКПулу") _ЧтениеПула,
	&Пластилин(Значение = "АдресИнстанса") _АдресХаба,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы,
	&Пластилин(Значение = "РазборАдреса") _Адреса,
	&Пластилин(Значение = "ЧтениеПолей") _ЧтениеПолей,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Лог _Лог = Неопределено)

	ЧтениеПула = _ЧтениеПула;
	АдресХаба = _АдресХаба;
	Страницы = _Страницы;
	Адреса = _Адреса;
	ЧтениеПолей = _ЧтениеПолей;
	Ошибки = _Ошибки;
	// лог параметром — только при прямом создании; в контейнере поле прилепит напильник
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
