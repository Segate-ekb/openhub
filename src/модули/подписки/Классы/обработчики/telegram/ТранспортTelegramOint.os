// Единственная точка отправки сообщений в Telegram Bot API — тонкий адаптер над OPI_Telegram.
// Разметка не используется: Markdown-спецсимволы в именах пулов ломали бы отправку.

#Использовать oint

Перем Ошибки;    // ТекстОшибки (основа) — маскирование токена в диагностике
Перем Вердикты;  // Вердикт (основа) — форма ответа

#Область ПубличныйИнтерфейс

// Отправляет текстовое сообщение в чат. Наружу не бросает: диагностика библиотеки и
// адрес Bot API несут токен, а вызывающий её логирует.
//
// Параметры:
//  Токен - Строка - токен бота (свой у подписки либо настройка инсталляции).
//  ЧатИд - Строка - идентификатор целевого чата или канала.
//  Текст - Строка - текст сообщения без разметки.
//
// Возвращаемое значение:
//  Структура - Успех (Булево) и Сообщение (Строка) — краткая причина отказа без токена.
//
Функция ОтправитьСообщение(Знач Токен, Знач ЧатИд, Знач Текст) Экспорт

	Попытка
		Ответ = OPI_Telegram.ОтправитьТекстовоеСообщение(Строка(Токен), Строка(ЧатИд), Строка(Текст), "", "");
	Исключение
		Возврат Отказ("обращение к Bot API не удалось", Токен);
	КонецПопытки;

	Итог = РазобратьОтвет(Ответ);
	Возврат ?(Итог.Успех, Итог, Отказ(Итог.Сообщение, Токен));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ответ Bot API — JSON с полем ok; описание ошибки в description.
Функция РазобратьОтвет(Знач Ответ)

	Если ТипЗнч(Ответ) = Тип("Соответствие") Тогда
		Если Ответ.Получить("ok") = Истина Тогда
			Возврат Вердикты.УспехСловами();
		КонецЕсли;
		Описание = Ответ.Получить("description");
		Возврат Вердикты.ОтказСловами(
			?(Описание = Неопределено, "ответ Bot API без описания", Строка(Описание)));
	КонецЕсли;
	Возврат Вердикты.ОтказСловами("неожиданная форма ответа Bot API");

КонецФункции

Функция Отказ(Знач Описание, Знач Токен)
	Возврат Вердикты.ОтказСловами(Ошибки.БезСекрета(Описание, Токен));
КонецФункции

#КонецОбласти

&Прозвище("ТранспортTelegram")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТекстОшибки") _Ошибки)

	Ошибки = _Ошибки;
	Вердикты = Новый Вердикт();

КонецПроцедуры
