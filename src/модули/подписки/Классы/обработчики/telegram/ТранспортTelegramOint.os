// Единственная точка отправки сообщений в Telegram Bot API — тонкий адаптер над http-клиентом oint.
// Разметка не используется: Markdown-спецсимволы в именах пулов ломали бы отправку.

#Использовать oint

Перем Прокси;    // ПроксиTelegram (подписки) — прокси до Bot API и вычёркивание его секретов
Перем Тела;      // ТелоСообщенияTelegram (подписки) — поля запроса sendMessage
Перем Числа;     // ЧислаДоставки (подписки) — таймаут одной отправки
Перем Ошибки;    // ТекстОшибки (основа) — вычёркивание токена бота из диагностики
Перем Вердикты;  // Вердикт (основа) — форма ответа

#Область ПубличныйИнтерфейс

// Отправляет текстовое сообщение в чат. Наружу не бросает: диагностика библиотеки и
// адрес Bot API несут токен, а вызывающий её логирует.
//
// Параметры:
//  Токен - Строка - токен бота (свой у подписки либо настройка инсталляции).
//  ЧатИд - Строка - идентификатор целевого чата или канала.
//  Текст - Строка - текст сообщения без разметки.
//
// Возвращаемое значение:
//  Структура - Успех (Булево) и Сообщение (Строка) — краткая причина отказа без секретов.
//
Функция ОтправитьСообщение(Знач Токен, Знач ЧатИд, Знач Текст) Экспорт

	Попытка
		Ответ = ОтветBotAPI(Токен, ЧатИд, Текст);
	Исключение
		Возврат Отказ("обращение к Bot API не удалось", Токен);
	КонецПопытки;

	Итог = РазобратьОтвет(Ответ);
	Возврат ?(Итог.Успех, Итог, Отказ(Итог.Сообщение, Токен));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Прокси ставится пообъектно: общие настройки вызова увели бы чужой одновременный запрос.
Функция ОтветBotAPI(Знач Токен, Знач ЧатИд, Знач Текст)

	Запрос = OPI_ЗапросыHTTP.НовыйЗапрос()
		.Инициализировать(АдресОтправки(Токен))
		.УстановитьТаймаут(Числа.ТаймаутОтправкиСек())
		.МаксимумПопыток(БезСвоихПовторов());

	Соединение = Прокси.Соединение();
	Если Соединение <> Неопределено Тогда
		Запрос.УстановитьПрокси(Соединение);
	КонецЕсли;

	Запрос.УстановитьJsonТело(Тела.Сообщение(ЧатИд, Текст));
	Запрос.ОбработатьЗапрос("POST");

	Возврат Запрос.ВернутьОтветКакJSONКоллекцию(Истина, Истина);

КонецФункции

Функция АдресОтправки(Знач Токен)
	Возврат "api.telegram.org/bot" + Строка(Токен) + "/sendMessage";
КонецФункции

// Неудачу повторяет очередь доставки: второй цикл повторов множил бы её простой.
Функция БезСвоихПовторов()
	Возврат 0;
КонецФункции

// Ответ Bot API — JSON с полем ok; описание ошибки в description.
Функция РазобратьОтвет(Знач Ответ)

	Если ТипЗнч(Ответ) = Тип("Соответствие") Тогда
		Если Ответ.Получить("ok") = Истина Тогда
			Возврат Вердикты.УспехСловами();
		КонецЕсли;
		Описание = Ответ.Получить("description");
		Возврат Вердикты.ОтказСловами(
			?(Описание = Неопределено, "ответ Bot API без описания", Строка(Описание)));
	КонецЕсли;
	Возврат Вердикты.ОтказСловами("неожиданная форма ответа Bot API");

КонецФункции

// Диагностику собирает чужая библиотека: вычеркнуть свой секрет обязан каждый, чей он.
Функция Отказ(Знач Описание, Знач Токен)

	Причина = Ошибки.БезСекрета(Описание, Токен);
	Возврат Вердикты.ОтказСловами(Прокси.БезСвоихСекретов(Причина));

КонецФункции

#КонецОбласти

&Прозвище("ТранспортTelegram")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПроксиTelegram") _Прокси,
	&Пластилин(Значение = "ТелоСообщенияTelegram") _Тела,
	&Пластилин(Значение = "ЧислаДоставки") _Числа,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки)

	Прокси = _Прокси;
	Тела = _Тела;
	Числа = _Числа;
	Ошибки = _Ошибки;
	Вердикты = Новый Вердикт();

КонецПроцедуры
