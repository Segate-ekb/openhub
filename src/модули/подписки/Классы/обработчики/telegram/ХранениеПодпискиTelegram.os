// Описание хранения действия «telegram»: адрес подписки — chat_id целевого чата, токен
// бота — обязательный и свой у каждой подписки, шаблон текста — необязательный.
// Секрет подписи типу не нужен: аутентификация в Bot API идёт токеном.

Перем Шаблоны;  // ШаблонУведомления (подписки) — закрытый перечень плейсхолдеров

#Область КонтрактХраненияПодписки

// Тип действия.
//
// Возвращаемое значение:
//  Строка - "telegram".
//
Функция ТипДействия() Экспорт
	Возврат "telegram";
КонецФункции

// Валидирует и нормализует ввод настроек при создании подписки. Бросает исключение
// на недопустимом chat_id, пустом или непохожем токене бота и неизвестном плейсхолдере.
//
// Параметры:
//  Ввод - Структура - ЧатИд (Строка либо Число), Токен (Строка),
//         Шаблон (Строка, необязательно).
//
// Возвращаемое значение:
//  Структура - Адрес, Секрет, НастройкиДействия, ТокенДействия, ШаблонТекста
//              для записи подписки.
//
Функция ПодготовитьНастройки(Знач Ввод) Экспорт

	ЧатИд = СокрЛП(Строка(Свойство(Ввод, "ЧатИд", "")));
	Если НЕ ДопустимыйЧатИд(ЧатИд) Тогда
		ВызватьИсключение "Недопустимый chat_id Telegram: ожидается числовой идентификатор,"
			+ " @имя канала или «чат*тема»";
	КонецЕсли;

	Токен = ПроверенныйТокен(Свойство(Ввод, "Токен", ""));

	Шаблон = СокрЛП(Строка(Свойство(Ввод, "Шаблон", "")));
	Шаблоны.Проверить(Шаблон);

	Результат = Новый Структура("Адрес, Секрет, НастройкиДействия", ЧатИд, "", "");
	Результат.Вставить("ТокенДействия", Токен);
	Результат.Вставить("ШаблонТекста", Шаблон);
	Возврат Результат;

КонецФункции

// Значения полей типа для формы правки. Токена здесь нет: он в разметку не выходит.
//
// Параметры:
//  Подписка - Вебхук - запись подписки.
//
// Возвращаемое значение:
//  Структура - значения по именам ввода полей (ОписаниеПолей.Имя).
//
Функция ЗначенияПравки(Знач Подписка) Экспорт

	Возврат Новый Структура("ЧатИд, Шаблон",
		Строка(Подписка.URL), Строка(Подписка.ШаблонТекста));

КонецФункции

// Валидирует ввод формы правки. Пустой токен означает «оставить прежний»: стереть его
// нельзя — подписка без токена не работает, а общего бота у инсталляции нет.
//
// Параметры:
//  Ввод - Структура - ЧатИд, Шаблон, Токен (пустой — оставить прежний).
//  Подписка - Вебхук - правимая запись.
//
// Возвращаемое значение:
//  Структура - Адрес, Секрет, НастройкиДействия, ТокенДействия, ШаблонТекста,
//              ПоказатьСекрет для записи подписки.
//
Функция ПодготовитьПравку(Знач Ввод, Знач Подписка) Экспорт

	Результат = ПодготовитьНастройки(Новый Структура("ЧатИд, Шаблон, Токен",
		Свойство(Ввод, "ЧатИд", ""), Свойство(Ввод, "Шаблон", ""),
		ТокенПравки(Ввод, Подписка)));
	Результат.Вставить("ПоказатьСекрет", Ложь);
	Возврат Результат;

КонецФункции

// Разворачивает запись подписки в настройки доставки для задания очереди.
//
// Параметры:
//  Подписка - Вебхук - запись подписки.
//
// Возвращаемое значение:
//  Структура - ЧатИд, Токен и Шаблон по контракту ДоставкаTelegram.
//
Функция НастройкиДоставки(Знач Подписка) Экспорт

	Возврат Новый Структура("ЧатИд, Токен, Шаблон",
		Строка(Подписка.URL), Строка(Подписка.ТокенДействия), Строка(Подписка.ШаблонТекста));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Токен на правке: пустое поле — «оставить прежний»; проверку введённого делает
// ПодготовитьНастройки, одна и та же на заведении и правке.
Функция ТокенПравки(Знач Ввод, Знач Подписка)

	Введённый = СокрЛП(Строка(Свойство(Ввод, "Токен", "")));
	Возврат ?(ЗначениеЗаполнено(Введённый), Введённый, Строка(Подписка.ТокенДействия));

КонецФункции

// Значения токена в тексте отказа нет: он утёк бы на страницу и в журнал.
Функция ПроверенныйТокен(Знач Значение)

	Токен = СокрЛП(Строка(Значение));
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		ВызватьИсключение "Не задан токен Telegram-бота: у каждой подписки он свой —"
			+ " общего бота у хаба нет. Создайте бота у @BotFather и вставьте его токен";
	КонецЕсли;
	Если НЕ ПохожеНаТокенБота(Токен) Тогда
		ВызватьИсключение "Непохожий токен Telegram-бота: ожидается «<цифры>:<строка>»"
			+ " — токен, который выдал @BotFather";
	КонецЕсли;
	Возврат Токен;

КонецФункции

// Формы: "123456789", "-1001234567890", "@channelname", "123456789*42" (чат*тема).
// Свободный текст отклоняется: поле уходит в Bot API как адресат.
Функция ДопустимыйЧатИд(Знач Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Лев(Значение, 1) = "@" Тогда
		Возврат ДопустимоеИмяКанала(Сред(Значение, 2));
	КонецЕсли;

	Части = СтрРазделить(Значение, "*");
	Если Части.Количество() > 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ЦелоеЧисло(Части[0]) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Части.Количество() = 2 И НЕ ЦелоеЧисло(Части[1]) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Целое со знаком: [-]цифры.
Функция ЦелоеЧисло(Знач Значение)
	Тело = ?(Лев(Значение, 1) = "-", Сред(Значение, 2), Значение);
	Если НЕ ЗначениеЗаполнено(Тело) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Ном = 1 По СтрДлина(Тело) Цикл
		Если Найти("0123456789", Сред(Тело, Ном, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Форма токена BotFather: «<цифры бота>:<секретная часть>». Проверяем форму, а не
// работоспособность: токен уходит в адрес Bot API, и мусор с пробелом рвал бы запрос.
Функция ПохожеНаТокенБота(Знач Значение)

	Части = СтрРазделить(Значение, ":");
	Если Части.Количество() <> 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ЦелоеЧисло(Части[0]) ИЛИ Лев(Части[0], 1) = "-" Тогда
		Возврат Ложь;
	КонецЕсли;

	Секретная = Части[1];
	Если СтрДлина(Секретная) < 10 Тогда
		Возврат Ложь;
	КонецЕсли;
	Допустимые = "abcdefghijklmnopqrstuvwxyz0123456789_-";
	Для Ном = 1 По СтрДлина(Секретная) Цикл
		Если Найти(Допустимые, НРег(Сред(Секретная, Ном, 1))) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Имя канала: латиница/цифры/подчёркивание, 5..32 символа (правила Telegram).
Функция ДопустимоеИмяКанала(Знач Имя)
	Если СтрДлина(Имя) < 5 ИЛИ СтрДлина(Имя) > 32 Тогда
		Возврат Ложь;
	КонецЕсли;
	Допустимые = "abcdefghijklmnopqrstuvwxyz0123456789_";
	Для Ном = 1 По СтрДлина(Имя) Цикл
		Если Найти(Допустимые, НРег(Сред(Имя, Ном, 1))) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция Свойство(Знач Данные, Знач Имя, Знач ПоУмолчанию)
	Значение = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

#КонецОбласти

&Прозвище("ХранениеПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ШаблонУведомления") _Шаблоны)

	Шаблоны = _Шаблоны;

КонецПроцедуры
