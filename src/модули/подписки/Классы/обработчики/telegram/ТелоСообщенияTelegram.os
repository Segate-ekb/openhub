// Тело запроса sendMessage: адрес чата, текст уведомления и превью ссылки полями Bot API.
// Разметки в теле нет — текст уходит дословно, и Markdown-спецсимволы имён ничего не ломают.

#Область ПубличныйИнтерфейс

// Тело запроса sendMessage.
//
// Параметры:
//  ЧатИд - Строка - идентификатор чата, «@имя» канала либо «чат*тема» супергруппы.
//  Текст - Строка - текст сообщения без разметки.
//  АдресПревью - Строка - адрес карточки превью; в тексте его быть не обязано
//                (необязательный, по умолчанию "" — превью выключено).
//
// Возвращаемое значение:
//  Структура - text (Строка), chat_id (Строка), для темы супергруппы message_thread_id
//              (Число) и link_preview_options (Структура — объект JSON): url
//              и prefer_large_media = Истина, а без адреса — is_disabled = Истина.
//              Темой считается только целое число после «*»; нечисловой хвост остаётся
//              частью chat_id, и адрес судит сам Bot API.
//
Функция Сообщение(Знач ЧатИд, Знач Текст, Знач АдресПревью = "") Экспорт

	Тело = АдресЧата(ЧатИд);
	Тело.Вставить("text", Строка(Текст));
	Тело.Вставить("link_preview_options", Превью(АдресПревью));
	Возврат Тело;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Без адреса превью выключается явно: иначе Telegram построил бы карточку первой ссылки текста.
Функция Превью(Знач АдресПревью)

	Адрес = СокрЛП(Строка(АдресПревью));
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат Новый Структура("is_disabled", Истина);
	КонецЕсли;

	// крупную картинку Bot API даёт только превью с явным url
	Возврат Новый Структура("url, prefer_large_media", Адрес, Истина);

КонецФункции

// «-1001234567890*17» — чат и тема супергруппы, и тему Bot API ждёт отдельным полем.
Функция АдресЧата(Знач ЧатИд)

	Значение = СокрЛП(Строка(ЧатИд));
	Части = СтрРазделить(Значение, "*", Ложь);

	Если Части.Количество() = 2 Тогда
		Тема = НомерТемы(Части[1]);
		Если Тема <> Неопределено Тогда
			Адрес = Новый Структура("chat_id", СокрЛП(Части[0]));
			Адрес.Вставить("message_thread_id", Тема);
			Возврат Адрес;
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Структура("chat_id", Значение);

КонецФункции

// Неопределено — «темой этот хвост быть не может»: ни словом, ни дробью она не бывает.
Функция НомерТемы(Знач Хвост)

	Попытка
		Разобранный = Число(СокрЛП(Хвост));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат ?(Разобранный = Цел(Разобранный), Разобранный, Неопределено);

КонецФункции

#КонецОбласти

&Прозвище("ТелоСообщенияTelegram")
&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
