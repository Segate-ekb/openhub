// Обработчик доставки действия «telegram»: отправляет человекочитаемое уведомление
// о доменном событии в чат подписки. Токен бота и chat_id — свои у каждой подписки.

Перем Транспорт;   // ТранспортTelegram (подписки)
Перем Шаблоны;     // ШаблонУведомления (подписки) — текст уведомления
Перем Превью;      // ПревьюTelegram (подписки) — адрес карточки превью
Перем Ошибки;      // ТекстОшибки (основа) — маскирование токена в диагностике
Перем Вердикты;    // Вердикт (основа) — форма ответа
&Лог
Перем Лог;

#Область КонтрактОбработчикаДоставки

// Тип действия, который доставляет обработчик.
//
// Возвращаемое значение:
//  Строка - "telegram".
//
Функция ТипДействия() Экспорт
	Возврат "telegram";
КонецФункции

// Проверка перед доставкой: гейт подписки без токена бота.
// Вердикт без успеха отбрасывает задание без ретраев.
//
// Параметры:
//  Задание - Структура - задание очереди.
//
// Возвращаемое значение:
//  Структура - Успех (Булево) и Сообщение (Строка).
//
&Наблюдаемый
Функция ПередДоставкой(Знач Задание) Экспорт

	// подписки без токена быть не может, но задание могло пережить правку записи
	Если НЕ ЗначениеЗаполнено(Настройка(Задание, "Токен")) Тогда
		Лог.Отладка("Telegram %1: у задания нет токена бота — доставки не будет",
			Задание.ИдДоставки);
		Возврат Вердикты.ОтказСловами("у подписки нет токена Telegram-бота");
	КонецЕсли;
	Возврат Вердикты.УспехСловами();

КонецФункции

// Отправляет текстовое уведомление в чат подписки.
//
// Параметры:
//  Задание - Структура - задание очереди: Действие.ЧатИд, ТипСобытия, Тело.
//
// Возвращаемое значение:
//  Булево - Истина, если Bot API ответил ok.
//
&Наблюдаемый
&Подсчитываемый("oshub.telegram.attempts")
Функция Доставить(Знач Задание) Экспорт

	Токен = Настройка(Задание, "Токен");
	// ни chat_id, ни токена: идентификатор чужого приватного чата и секрет подписки
	Лог.Отладка("Telegram %1: шлём уведомление по событию ""%2"", попытка %3",
		Задание.ИдДоставки, Задание.ТипСобытия, Задание.НомерПопытки);
	Итог = Отправить(Токен, Задание);

	Если Итог.Успех Тогда
		Лог.Информация("Telegram %1: уведомление доставлено (событие %2)",
			Задание.ИдДоставки, Задание.ТипСобытия);
	Иначе
		// chat_id в лог не пишем: идентификатор чужого приватного чата; токен — маской
		Лог.Предупреждение("Telegram %1: отправка не удалась (попытка %2): %3",
			Задание.ИдДоставки, Задание.НомерПопытки, Ошибки.БезСекрета(Итог.Сообщение, Токен));
	КонецЕсли;
	Возврат Итог.Успех;

КонецФункции

// Пробная отправка: одна попытка, результат словами. Ретраев и очереди у пробы нет —
// это проверка настроек, а не доставка.
//
// Параметры:
//  Задание - Структура - синтетическое задание пробы.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число — у Bot API кода ответа нет, всегда 0)
//              и Сообщение (Строка) без токена и без chat_id.
//
&Наблюдаемый
Функция Проба(Знач Задание) Экспорт

	Вердикт = ПередДоставкой(Задание);
	Если НЕ Вердикт.Успех Тогда
		Возврат Вердикты.ОтказСКодом(БезКодаОтвета(), Вердикт.Сообщение);
	КонецЕсли;

	Токен = Настройка(Задание, "Токен");
	Итог = Отправить(Токен, Задание);
	Ответ = Ошибки.БезСекрета(Итог.Сообщение, Токен);
	Возврат ?(Итог.Успех, Вердикты.УспехСКодом(БезКодаОтвета(), Ответ),
		Вердикты.ОтказСКодом(БезКодаОтвета(), Ответ));

КонецФункции

// Сообщение по шаблону из формы, ещё не сохранённому: тот же разворот текста и тот же адрес
// карточки ссылки, что у боевой доставки; пустой шаблон — текст по умолчанию. Ничего не отправляет.
//
// Параметры:
//  Ввод - Структура - ввод формы: Шаблон (Строка, необязательно).
//  ТипСобытия - Строка - тип события образца.
//  Тело - Строка - JSON-тело образца.
//
// Возвращаемое значение:
//  Структура - Текст (Строка) и АдресПревью (Строка; "" — сообщение уйдёт без карточки).
//  Неизвестное имя в шаблоне — исключение с перечнем допустимых.
//
Функция Предпросмотр(Знач Ввод, Знач ТипСобытия, Знач Тело) Экспорт

	Шаблон = "";
	Если Ввод <> Неопределено И Ввод.Свойство("Шаблон", Шаблон) И Шаблон <> Неопределено Тогда
		Шаблон = СокрЛП(Строка(Шаблон));
	Иначе
		Шаблон = "";
	КонецЕсли;
	Шаблоны.Проверить(Шаблон);
	Текст = ТекстУведомления(Новый Структура("ТипСобытия, Тело, Действие", ТипСобытия, Тело,
		Новый Структура("Шаблон", Шаблон)));
	Возврат Новый Структура("Текст, АдресПревью", Текст, Превью.Адрес(Тело));

КонецФункции

#КонецОбласти

#Область ПубличныйИнтерфейс

// Собирает текст уведомления по заданию: шаблон подписки либо стандартный текст.
//
// Параметры:
//  Задание - Структура - задание очереди: ТипСобытия, Тело, Действие.Шаблон.
//
// Возвращаемое значение:
//  Строка - человекочитаемый текст без разметки.
//
&Наблюдаемый
Функция ТекстУведомления(Знач Задание) Экспорт
	Возврат Шаблоны.Текст(Настройка(Задание, "Шаблон"), Задание.ТипСобытия, Задание.Тело);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сбой транспорта наружу не выпускается: исключение чужой библиотеки несёт токен в адресе Bot API.
Функция Отправить(Знач Токен, Знач Задание)

	Попытка
		Возврат Транспорт.ОтправитьСообщение(Токен, Настройка(Задание, "ЧатИд"), ТекстУведомления(Задание),
			Превью.Адрес(Задание.Тело));
	Исключение
		// подробности — в журнал: на экране от них только пути внутрь машины
		Лог.Предупреждение("Telegram %1: сбой отправки: %2", Задание.ИдДоставки,
			Ошибки.БезСекрета(
				Ошибки.Причина(ИнформацияОбОшибке()), Токен));
		Возврат Вердикты.ОтказСловами("Bot API не ответил: сеть недоступна либо истёк таймаут");
	КонецПопытки;

КонецФункции

// Bot API отвечает своим «ok», а не HTTP-кодом: кода ответа у пробы telegram нет.
Функция БезКодаОтвета()
	Возврат 0;
КонецФункции

Функция Настройка(Знач Задание, Знач Имя)
	Значение = Неопределено;
	Действие = Задание.Действие;
	Если ТипЗнч(Действие) = Тип("Структура") И Действие.Свойство(Имя, Значение)
		И Значение <> Неопределено Тогда
		Возврат СокрЛП(Строка(Значение));
	КонецЕсли;
	Возврат "";
КонецФункции

#КонецОбласти

&Прозвище("ОбработчикДоставкиПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТранспортTelegram") _Транспорт,
	&Пластилин(Значение = "ШаблонУведомления") _Шаблоны,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Пластилин(Значение = "ПревьюTelegram") _Превью)

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Транспорт = _Транспорт;
	Шаблоны = _Шаблоны;
	Ошибки = _Ошибки;
	Превью = _Превью;
	Вердикты = Новый Вердикт();

КонецПроцедуры
