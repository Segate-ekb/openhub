// Прокси, через который хаб обращается к Bot API: четыре ключа настроек одним объектом.
// Значения спрашиваются на каждую отправку — правка на экране действует без перезапуска.

Перем Настройки;  // СервисНастроек (настройки)
Перем Ошибки;     // ТекстОшибки (основа) — замена секрета маской

#Область ПубличныйИнтерфейс

// Задан ли прокси. Пустой сервер означает «ходить в Bot API напрямую».
//
// Возвращаемое значение:
//  Булево - задан ли прокси.
//
Функция Задан() Экспорт
	Возврат ЗначениеЗаполнено(Сервер());
КонецФункции

// Прокси для обращения к Bot API.
//
// Возвращаемое значение:
//  ИнтернетПрокси, Неопределено - Неопределено, если сервер не задан.
//
Функция Соединение() Экспорт

	Если НЕ Задан() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Прокси = Новый ИнтернетПрокси();
	// «Протокол» здесь — схема ЦЕЛЕВОГО адреса, а не самого прокси; Bot API живёт на https
	Прокси.Установить("https", Сервер(), Порт(), Пользователь(), Пароль(), Ложь);
	Возврат Прокси;

КонецФункции

// Тот же текст, но без секретов прокси: пароль заменён маской. Наружу не бросает —
// вычёркивание не вправе превратить диагностику отказа в сбой доставки.
//
// Параметры:
//  Текст - Строка - диагностическое сообщение.
//
// Возвращаемое значение:
//  Строка - текст, в котором пароля прокси нет.
//
Функция БезСвоихСекретов(Знач Текст) Экспорт

	Попытка
		Возврат Ошибки.БезСекрета(Текст, Пароль());
	Исключение
		Возврат Строка(Текст);
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Пароль()
	Возврат Настройки.Текстом("oshub.webhooks.telegram.proxy.password");
КонецФункции

Функция Сервер()
	Возврат Настройки.Текстом("oshub.webhooks.telegram.proxy.host");
КонецФункции

Функция Порт()
	Возврат Настройки.Целое("oshub.webhooks.telegram.proxy.port", 3128, 1);
КонецФункции

Функция Пользователь()
	Возврат Настройки.Текстом("oshub.webhooks.telegram.proxy.user");
КонецФункции

#КонецОбласти

&Прозвище("ПроксиTelegram")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки)

	Настройки = _Настройки;
	Ошибки = _Ошибки;

КонецПроцедуры
