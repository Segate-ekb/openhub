// Отметки дерева получателей подписки хаба или пула и правило, кому из них событие достаётся.
// У каждого пула дерева режим: «все» — весь пул, новые попадают сами; «выбранные» — только
// выбранные пакеты, новые не попадают; «никакие» — пул исключён целиком. Режим «никакие» — строка
// пула среди исключений, «выбранные» — строка пула среди включений, «все» — ни той, ни другой.
// Исключённый пакет пула «все» — прежняя запись, которую СервисИсключенийПодписок переводит в выбор
// на старте; до перевода он не получает. Чтение — разом на подписку, на страницу подписок или на узел
// события.

Перем Исключения; // ХранилищеИсключенийПодписок (подписки) — исключённые пулы и пакеты
Перем Включения;  // ХранилищеВключенийПодписок (подписки) — пулы в режиме «выбранные» и их пакеты

#Область ПубличныйИнтерфейс

// Режимы пула в порядке, в каком их показывает экран.
//
// Возвращаемое значение:
//  Массив из Строка - "все", "выбранные", "никакие".
//
Функция Режимы() Экспорт
	Возврат СтрРазделить(РежимВсе() + "," + РежимВыбранные() + "," + РежимНикакие(), ",");
КонецФункции

// Режим «все»: пакеты пула, кроме исключённых.
//
// Возвращаемое значение:
//  Строка.
//
Функция РежимВсе() Экспорт
	Возврат "все";
КонецФункции

// Режим «выбранные»: только выбранные пакеты пула.
//
// Возвращаемое значение:
//  Строка.
//
Функция РежимВыбранные() Экспорт
	Возврат "выбранные";
КонецФункции

// Режим «никакие»: пул исключён целиком.
//
// Возвращаемое значение:
//  Строка.
//
Функция РежимНикакие() Экспорт
	Возврат "никакие";
КонецФункции

// Пустые отметки: все пулы в режиме «все», ничего не исключено и не выбрано.
//
// Возвращаемое значение:
//  Структура - Соответствия:
//    * Никакие - Соответствие - пул → Истина: пулы в режиме «никакие»;
//    * Выбранные - Соответствие - пул → Истина: пулы в режиме «выбранные»;
//    * Исключённые - Соответствие - пул → Соответствие (пакет → Истина): исключённые пакеты;
//    * Включённые - Соответствие - пул → Соответствие (пакет → Истина): выбранные пакеты.
//
Функция Пустые() Экспорт
	Возврат Новый Структура("Никакие, Выбранные, Исключённые, Включённые",
		Новый Соответствие(), Новый Соответствие(), Новый Соответствие(), Новый Соответствие());
КонецФункции

// Отметки дерева одной подписки — по чтению на каждое хранилище.
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Структура - см. Пустые.
//
Функция Подписки(Знач ПодпискаИдентификатор) Экспорт

	Отметки = Пустые();
	Разложить(Отметки, Исключения.ПоПодписке(ПодпискаИдентификатор), Ложь);
	Разложить(Отметки, Включения.ПоПодписке(ПодпискаИдентификатор), Истина);
	Возврат Отметки;

КонецФункции

// Отметки деревьев перечня подписок — по чтению на каждое хранилище, сколько бы подписок ни было.
//
// Параметры:
//  ПодпискаИдентификаторы - Массив из Число - идентификаторы подписок.
//
// Возвращаемое значение:
//  Соответствие - идентификатор подписки (Число) -> отметки (см. Пустые); у каждой подписки перечня
//  свои, у подписки без отметок — пустые.
//
Функция Подписок(Знач ПодпискаИдентификаторы) Экспорт

	Результат = Новый Соответствие();
	Для Каждого Идентификатор Из ПодпискаИдентификаторы Цикл
		Результат.Вставить(Цел(Идентификатор), Пустые());
	КонецЦикла;
	Если Результат.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Запись Из Исключения.ПоПодпискам(ПодпискаИдентификаторы) Цикл
		Отметки = Результат.Получить(Цел(Запись.ПодпискаИдентификатор));
		Если Отметки <> Неопределено Тогда
			Отметить(Отметки, Запись, Ложь);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Запись Из Включения.ПоПодпискам(ПодпискаИдентификаторы) Цикл
		Отметки = Результат.Получить(Цел(Запись.ПодпискаИдентификатор));
		Если Отметки <> Неопределено Тогда
			Отметить(Отметки, Запись, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Режим пула в отметках.
//
// Параметры:
//  Отметки - Структура - см. Пустые.
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Строка - "все" | "выбранные" | "никакие".
//
Функция Режим(Знач Отметки, Знач ПулИдентификатор) Экспорт

	Если Отметки.Никакие.Получить(Цел(ПулИдентификатор)) = Истина Тогда
		Возврат РежимНикакие();
	ИначеЕсли Отметки.Выбранные.Получить(Цел(ПулИдентификатор)) = Истина Тогда
		Возврат РежимВыбранные();
	КонецЕсли;
	Возврат РежимВсе();

КонецФункции

// Достаётся ли пакет подписке по её отметкам.
//
// Параметры:
//  Отметки - Структура - см. Пустые.
//  ПулИдентификатор - Число - пул пакета.
//  ПакетИдентификатор - Число - пакет.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПакетПолучает(Знач Отметки, Знач ПулИдентификатор, Знач ПакетИдентификатор) Экспорт

	Режим = Режим(Отметки, ПулИдентификатор);
	Если Режим = РежимНикакие() Тогда
		Возврат Ложь;
	ИначеЕсли Режим = РежимВыбранные() Тогда
		Возврат Отмечен(Отметки.Включённые, ПулИдентификатор, ПакетИдентификатор);
	КонецЕсли;
	Возврат НЕ Отмечен(Отметки.Исключённые, ПулИдентификатор, ПакетИдентификатор);

КонецФункции

// Пакеты пула, которые хозяин подписки снял: исключённые в режиме «все», не выбранные в режиме
// «выбранные», все — в режиме «никакие».
//
// Параметры:
//  Отметки - Структура - см. Пустые.
//  ПулИдентификатор - Число - пул.
//  Пакеты - Массив - пакеты пула (у каждого Идентификатор).
//
// Возвращаемое значение:
//  Соответствие - пакет (Число) → Истина.
//
Функция СнятыеВПуле(Знач Отметки, Знач ПулИдентификатор, Знач Пакеты) Экспорт

	Результат = Новый Соответствие();
	Для Каждого Пакет Из Пакеты Цикл
		Если НЕ ПакетПолучает(Отметки, ПулИдентификатор, Пакет.Идентификатор) Тогда
			Результат.Вставить(Цел(Пакет.Идентификатор), Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пакеты пула, отмеченные в его режиме: исключённые — в режиме «все», выбранные — в режиме
// «выбранные»; в режиме «никакие» пакетов не отмечают.
//
// Параметры:
//  Отметки - Структура - см. Пустые.
//  ПулИдентификатор - Число - пул.
//
// Возвращаемое значение:
//  Массив из Число - идентификаторы пакетов.
//
Функция ОтмеченныеПакеты(Знач Отметки, Знач ПулИдентификатор) Экспорт

	Режим = Режим(Отметки, ПулИдентификатор);
	Если Режим = РежимНикакие() Тогда
		Возврат Новый Массив();
	КонецЕсли;
	ПоПулам = ?(Режим = РежимВыбранные(), Отметки.Включённые, Отметки.Исключённые);
	Пакеты = ПоПулам.Получить(Цел(ПулИдентификатор));
	Результат = Новый Массив();
	Если Пакеты <> Неопределено Тогда
		Для Каждого КиЗ Из Пакеты Цикл
			Результат.Добавить(КиЗ.Ключ);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Подписки, которым узел события не достаётся: пул в режиме «никакие», пакет исключён в режиме
// «все» или не выбран в режиме «выбранные». Строки узла читаются разом — по чтению на хранилище
// и узел; без пакета (событие пула) спрашивается только пул, и режим «выбранные» его не снимает.
//
// Параметры:
//  ПулИдентификатор - Число - пул события.
//  ПакетИдентификатор - Число - пакет события; 0 — событие пула.
//
// Возвращаемое значение:
//  Соответствие - идентификатор подписки (Число) → Истина.
//
Функция Исключившие(Знач ПулИдентификатор, Знач ПакетИдентификатор) Экспорт

	Результат = Новый Соответствие();
	Если Цел(ПулИдентификатор) <> 0 Тогда
		ДобавитьПодписки(Результат, Исключения.ПоОбъекту("пул", Цел(ПулИдентификатор)));
	КонецЕсли;
	Если Цел(ПакетИдентификатор) = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ДобавитьПодписки(Результат, Исключения.ПоОбъекту("пакет", Цел(ПакетИдентификатор)));
	Выбравшие = Новый Соответствие();
	ДобавитьПодписки(Выбравшие, Включения.ПоОбъекту("пакет", Цел(ПакетИдентификатор)));
	Если Цел(ПулИдентификатор) <> 0 Тогда
		Для Каждого Запись Из Включения.ПоОбъекту("пул", Цел(ПулИдентификатор)) Цикл
			Если Выбравшие.Получить(Цел(Запись.ПодпискаИдентификатор)) = Неопределено Тогда
				Результат.Вставить(Цел(Запись.ПодпискаИдентификатор), Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Разложить(Отметки, Знач Записи, Знач Включение)
	Для Каждого Запись Из Записи Цикл
		Отметить(Отметки, Запись, Включение);
	КонецЦикла;
КонецПроцедуры

Процедура Отметить(Отметки, Знач Запись, Знач Включение)

	ПулИдентификатор = Цел(Запись.ПулИдентификатор);
	Если НРег(СокрЛП(Строка(Запись.ТипОбъекта))) = "пул" Тогда
		Пулы = ?(Включение, Отметки.Выбранные, Отметки.Никакие);
		Пулы.Вставить(ПулИдентификатор, Истина);
		Возврат;
	КонецЕсли;

	ПоПулам = ?(Включение, Отметки.Включённые, Отметки.Исключённые);
	Пакеты = ПоПулам.Получить(ПулИдентификатор);
	Если Пакеты = Неопределено Тогда
		Пакеты = Новый Соответствие();
		ПоПулам.Вставить(ПулИдентификатор, Пакеты);
	КонецЕсли;
	Пакеты.Вставить(Цел(Запись.ОбъектИдентификатор), Истина);

КонецПроцедуры

Функция Отмечен(Знач ПоПулам, Знач ПулИдентификатор, Знач ПакетИдентификатор)
	Пакеты = ПоПулам.Получить(Цел(ПулИдентификатор));
	Возврат Пакеты <> Неопределено И Пакеты.Получить(Цел(ПакетИдентификатор)) = Истина;
КонецФункции

Процедура ДобавитьПодписки(Результат, Знач Записи)
	Для Каждого Запись Из Записи Цикл
		Результат.Вставить(Цел(Запись.ПодпискаИдентификатор), Истина);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

&Прозвище("ОтметкиПолучателей")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеИсключенийПодписок") _Исключения,
	&Пластилин(Значение = "ХранилищеВключенийПодписок") _Включения)

	Исключения = _Исключения;
	Включения = _Включения;

КонецПроцедуры
