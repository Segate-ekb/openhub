// Дерево получателей подписки хаба или пула и исключения из него: у подписки хаба — пулы и их
// пакеты, у подписки пула — пакеты пула. Новый пул или пакет попадает в дерево включённым:
// исключён только узел, с которого хозяин подписки снял галку.

Перем Исключения;     // ХранилищеИсключенийПодписок (подписки)
Перем СервисПодписок; // СервисПодписок (подписки) — подписки объекта и право распоряжаться ими
Перем СервисПулов;    // СервисПулов (реестр) — пулы хаба
Перем СервисПакетов;  // СервисПакетов (реестр) — пакеты, отмеченные галкой
Перем Ветки;          // ВеткиДереваПолучателей (подписки) — пулы и пакеты дерева с отметками
Перем Снятие;         // СнятиеСтрок (данные) — снятие исключения тем же путём, что и при удалении подписки

#Область ПубличныйИнтерфейс

// Узел дерева получателей.
//
// Параметры:
//  ТипОбъекта - Строка - "пул" | "пакет".
//  Идентификатор - Число - идентификатор пула или пакета.
//
// Возвращаемое значение:
//  Структура - ТипОбъекта, Идентификатор.
//
Функция Узел(Знач ТипОбъекта, Знач Идентификатор) Экспорт
	Возврат Новый Структура("ТипОбъекта, Идентификатор", НРег(СокрЛП(Строка(ТипОбъекта))), Цел(Идентификатор));
КонецФункции

// Есть ли у подписки дерево получателей: у подписки пакета его нет.
//
// Параметры:
//  Подписка - Вебхук - подписка.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьДерево(Знач Подписка) Экспорт
	Тип = ТипОбъекта(Подписка);
	Возврат Тип = "хаб" ИЛИ Тип = "пул";
КонецФункции

// Дерево получателей подписки объекта: пулы по имени, у каждого его пакеты по имени и отметка
// исключения. У подписки хаба — все пулы хаба, включая приватные; у подписки пула — один её пул,
// исключить который нельзя. Требует права распоряжаться подписками объекта.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание объекта подписок (СервисПодписок.ОбъектХаба, ОбъектПула).
//  Идентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Структура, Неопределено - Подписка (Вебхук), ГалкиПулов (Булево — у подписки хаба: у каждого
//  пула своя галка; Ложь — у подписки пула: галки только у её пакетов)
//  и Пулы (ветки, см. ВеткиДереваПолучателей.Ветки; ИсключёнСверху у пакетов — Ложь: выше
//  хозяина подписки никого нет); Неопределено, если подписки у объекта нет или это подписка пакета.
//
Функция ДеревоПолучателей(Знач Пользователь, Знач Объект, Знач Идентификатор) Экспорт

	ТребоватьПрава(Пользователь, Объект);
	Подписка = ПодпискаСДеревом(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Подписка, ГалкиПулов, Пулы", Подписка, ТипОбъекта(Подписка) = "хаб",
		Ветки.Ветки(ПулыДерева(Подписка), Отметки(Подписка)));

КонецФункции

// Сколько пулов и пакетов исключено из дерева подписки — для сводки без самого дерева.
// Требует права распоряжаться подписками объекта.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание объекта подписок.
//  Идентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Структура, Неопределено - Пулов (Число), Пакетов (Число); Неопределено, если подписки
//  у объекта нет или это подписка пакета.
//
Функция СводкаИсключений(Знач Пользователь, Знач Объект, Знач Идентификатор) Экспорт

	ТребоватьПрава(Пользователь, Объект);
	Подписка = ПодпискаСДеревом(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сводка = Новый Структура("Пулов, Пакетов", 0, 0);
	Для Каждого Запись Из Исключения.ПоПодписке(Подписка.Идентификатор) Цикл
		Если Запись.ТипОбъекта = "пул" Тогда
			Сводка.Пулов = Сводка.Пулов + 1;
		Иначе
			Сводка.Пакетов = Сводка.Пакетов + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Сводка;

КонецФункции

// Ставит и снимает галки узлов дерева: исключает и возвращает названные узлы, остальных
// не касается. Повторное исключение узла второй записи не заводит. Узел, названный в обоих
// перечнях, исключается. Пакет, которого в дереве подписки нет — удалённый или из чужого пула, —
// пропускается молча и одинаково: ответ не говорит, есть ли такой пакет где-то ещё. Требует права
// распоряжаться подписками объекта; бросает исключение на пуле у подписки пула.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание объекта подписок.
//  Идентификатор - Число - идентификатор подписки.
//  Исключаемые - Массив из Структура - узлы (см. Узел), с которых галка снимается.
//  Включаемые - Массив из Структура - узлы (см. Узел), на которые галка ставится.
//
// Возвращаемое значение:
//  Булево - Ложь, если подписки у объекта нет или это подписка пакета.
//
Функция Отметить(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Исключаемые,
	Знач Включаемые) Экспорт

	ТребоватьПрава(Пользователь, Объект);
	Подписка = ПодпискаСДеревом(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	// узел в обоих перечнях исключается: возврат его не касается
	Снимаемые = Новый Соответствие();
	Для Каждого Отмеченный Из Исключаемые Цикл
		Снимаемые.Вставить(КлючУзла(Отмеченный), Истина);
	КонецЦикла;

	УзлыВДереве = НайденныеВДереве(Подписка, Исключаемые);
	Для Каждого Отмеченный Из Включаемые Цикл
		Если Снимаемые.Получить(КлючУзла(Отмеченный)) = Неопределено Тогда
			Вернуть(Подписка, Отмеченный);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Найденный Из УзлыВДереве Цикл
		Исключить(Подписка, Найденный.Узел, Найденный.ПулИдентификатор, Пользователь);
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Заменяет исключения подписки названными: узел вне перечня возвращается в дерево.
// Права и отказы — как у Отметить.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание объекта подписок.
//  Идентификатор - Число - идентификатор подписки.
//  Исключаемые - Массив из Структура - узлы (см. Узел), которые остаются исключёнными.
//
// Возвращаемое значение:
//  Булево - Ложь, если подписки у объекта нет или это подписка пакета.
//
Функция Заменить(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Исключаемые) Экспорт

	ТребоватьПрава(Пользователь, Объект);
	Подписка = ПодпискаСДеревом(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Прежние = Новый Массив();
	Для Каждого Запись Из Исключения.ПоПодписке(Подписка.Идентификатор) Цикл
		Прежние.Добавить(Узел(Запись.ТипОбъекта, Запись.ОбъектИдентификатор));
	КонецЦикла;
	Возврат Отметить(Пользователь, Объект, Идентификатор, Исключаемые, Прежние);

КонецФункции

#КонецОбласти

#Область Дерево

Функция ПулыДерева(Знач Подписка)

	Если ТипОбъекта(Подписка) = "хаб" Тогда
		Возврат СервисПулов.ПулыДляЧтения();
	КонецЕсли;

	Результат = Новый Массив();
	Пул = СервисПулов.ПулПоИдентификатору(Подписка.ОбъектИдентификатор);
	Если Пул <> Неопределено Тогда
		Результат.Добавить(Пул);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Отметки дерева подписки: исключённые её хозяином пулы и пакеты.
Функция Отметки(Знач Подписка)

	Результат = Ветки.ПустыеОтметки();
	Для Каждого Запись Из Исключения.ПоПодписке(Подписка.Идентификатор) Цикл
		Если Запись.ТипОбъекта = "пул" Тогда
			Результат.Пулы.Вставить(Цел(Запись.ОбъектИдентификатор), Истина);
		Иначе
			Результат.Пакеты.Вставить(Цел(Запись.ОбъектИдентификатор), Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Отметки

// Исключаемые узлы, которые есть в дереве подписки, с пулом каждого. Пакет вне дерева —
// удалённый после отрисовки формы, несуществующий или чужого пула — пропускается одинаково.
Функция НайденныеВДереве(Знач Подписка, Знач Исключаемые)

	ПодпискаХаба = ТипОбъекта(Подписка) = "хаб";
	Пулы = Новый Массив();
	Пакеты = Новый Массив();
	Для Каждого Отмеченный Из Исключаемые Цикл
		Если Отмеченный.ТипОбъекта = "пул" И ПодпискаХаба Тогда
			Пулы.Добавить(Отмеченный.Идентификатор);
		ИначеЕсли Отмеченный.ТипОбъекта = "пакет" Тогда
			Пакеты.Добавить(Отмеченный.Идентификатор);
		Иначе
			ВызватьИсключение СтрШаблон("Узел «%1» в дерево получателей этой подписки не входит", Отмеченный.ТипОбъекта);
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив();
	Если Пулы.Количество() > 0 Тогда
		Для Каждого КиЗ Из СервисПулов.ПулыПоИдентификаторам(Пулы) Цикл
			Результат.Добавить(Новый Структура("Узел, ПулИдентификатор", Узел("пул", КиЗ.Ключ), КиЗ.Ключ));
		КонецЦикла;
	КонецЕсли;
	Если Пакеты.Количество() > 0 Тогда
		Для Каждого Пакет Из СервисПакетов.ПакетыПоИдентификаторам(Пакеты) Цикл
			Если НЕ ПодпискаХаба И Цел(Пакет.ПулИдентификатор) <> Цел(Подписка.ОбъектИдентификатор) Тогда
				Продолжить;
			КонецЕсли;
			Результат.Добавить(Новый Структура("Узел, ПулИдентификатор",
				Узел("пакет", Пакет.Идентификатор), Цел(Пакет.ПулИдентификатор)));
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// У пары «подписка — узел» исключение одно: повтор находит прежнее.
Процедура Исключить(Знач Подписка, Знач Отмеченный, Знач ПулИдентификатор, Знач Пользователь)

	Если Исключения.ПоПаре(Подписка.Идентификатор, Отмеченный.ТипОбъекта, Отмеченный.Идентификатор) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запись = Исключения.СоздатьЭлемент();
	Запись.ПодпискаИдентификатор = Цел(Подписка.Идентификатор);
	Запись.ТипОбъекта = Отмеченный.ТипОбъекта;
	Запись.ОбъектИдентификатор = Отмеченный.Идентификатор;
	Запись.ПулИдентификатор = Цел(ПулИдентификатор);
	Запись.КемИдентификатор = ?(Пользователь = Неопределено, 0, Цел(Пользователь.Идентификатор));
	Запись.Создано = ТекущаяУниверсальнаяДата();
	Запись.Сохранить();

КонецПроцедуры

Процедура Вернуть(Знач Подписка, Знач Отмеченный)

	Запись = Исключения.ПоПаре(Подписка.Идентификатор, Отмеченный.ТипОбъекта, Отмеченный.Идентификатор);
	Если Запись <> Неопределено Тогда
		Снимаемые = Новый Массив();
		Снимаемые.Добавить(Запись);
		Снятие.Снять(Снимаемые);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подписка сверху под адресом своего объекта и подписка пакета дерева не имеют.
Функция ПодпискаСДеревом(Знач Объект, Знач Идентификатор)

	Для Каждого Подписка Из СервисПодписок.Список(Объект) Цикл
		Если Цел(Подписка.Идентификатор) = Цел(Идентификатор) Тогда
			Возврат ?(ЕстьДерево(Подписка), Подписка, Неопределено);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция КлючУзла(Знач Узел)
	Возврат Узел.ТипОбъекта + "#" + Формат(Узел.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

Функция ТипОбъекта(Знач Подписка)
	Возврат НРег(СокрЛП(Строка(Подписка.ТипОбъекта)));
КонецФункции

// Дерево видит и правит тот, кто распоряжается подписками объекта.
Процедура ТребоватьПрава(Знач Пользователь, Знач Объект)

	Если НЕ СервисПодписок.МожетУправлять(Пользователь, Объект) Тогда
		ВызватьИсключение "Недостаточно прав, чтобы менять получателей подписки этого объекта";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

&Прозвище("СервисИсключенийПодписок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеИсключенийПодписок") _Исключения,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "ВеткиДереваПолучателей") _Ветки,
	&Пластилин(Значение = "СнятиеСтрок") _Снятие = Неопределено)

	Снятие = ?(_Снятие = Неопределено, Новый СнятиеСтрок(), _Снятие);

	Исключения = _Исключения;
	СервисПодписок = _СервисПодписок;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	Ветки = _Ветки;

КонецПроцедуры
