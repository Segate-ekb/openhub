// Рогатка старта: пулы подписок, которые получали всё, кроме исключённых пакетов, становятся
// «выбранными» с тем же набором — у режима «все» исключений больше нет. Работает в фоне, ждёт гейта
// службы аудита (без слушателя журнала служба перевод откладывает) и держит гейт готовности хаба до
// конца перевода. Повторный старт
// ничего не находит, а оборванный перевод доделывает.

Перем Исключения;  // СервисИсключенийПодписок (подписки)
Перем Готовность;  // ГотовностьХаба (наблюдаемость) — гейт «подписки.перевод»
Перем Ошибки;      // ТекстОшибки (основа)
&Лог
Перем Лог;

// Ждёт слушателя журнала, переводит и называет итог. Собственный сбой перехватывает: хаб стартует
// и без перевода, следующий старт попробует снова; гейт закрывается в любом исходе.
//
Процедура ПриЗапускеПриложения() Экспорт

	Попытка
		Перевести();
	Исключение
		Лог.Ошибка("Пулы «все, кроме исключённых» в «выбранные» не переведены: окно «Получатели» покажет"
			+ " их полными, а исключённые пакеты так и не получают событий. Перевод повторится на"
			+ " следующем старте. %1", Ошибки.Причина(ИнформацияОбОшибке()));
	КонецПопытки;
	Готовность.ОтметитьЗадачуВыполненной("подписки.перевод");

КонецПроцедуры

Процедура Перевести()

	// подписки издателя дописывает фоновый поток службы аудита; читать их можно, когда её гейт закрыт
	Ждать = ТекущаяУниверсальнаяДатаВМиллисекундах() + СрокОжиданияЖурналаСек() * 1000;
	Пока Готовность.НезавершённыеЗадачи().Найти(ГейтЖурнала()) <> Неопределено
		И ТекущаяУниверсальнаяДатаВМиллисекундах() < Ждать Цикл
		Приостановить(200);
	КонецЦикла;

	Итог = Исключения.ПеревестиВсеСИсключениями();
	Если Итог.Отложено Тогда
		Лог.Предупреждение("Получатели подписок: перевод «все, кроме исключённых» в «выбранные» отложен до"
			+ " следующего старта — журнал аудита за %1 с не начал слушать, а без записи в нём переводить"
			+ " нельзя. Данные не тронуты.", СрокОжиданияЖурналаСек());
	ИначеЕсли Итог.Подписок > 0 Тогда
		Лог.Информация("Получатели подписок: переведено пулов из «все, кроме исключённых» в «выбранные» — %1,"
			+ " подписок — %2, выбрано пакетов — %3, снято исключений у пулов «никакие» — %4. Новые пакеты"
			+ " этих пулов подпискам больше не приходят. Каждая подписка — в журнале аудита"
			+ " (получатели.переведены).", Итог.Пулов, Итог.Подписок, Итог.Пакетов, Итог.Снято);
	КонецЕсли;

КонецПроцедуры

// Гейт службы аудита (`СлужбаАудита`): закрывается, когда она подписалась на шину.
Функция ГейтЖурнала()
	Возврат "audit.служба";
КонецФункции

Функция СрокОжиданияЖурналаСек()
	Возврат 120;
КонецФункции

&Рогатка
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисИсключенийПодписок") _Исключения,
	&Пластилин(Значение = "ГотовностьХаба") _Готовность,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки)

	// Заявка в конструкторе: список гейтов должен быть полон до первого запуска рогаток.
	_Готовность.ЗаявитьЗадачу("подписки.перевод");
	Исключения = _Исключения;
	Готовность = _Готовность;
	Ошибки = _Ошибки;

КонецПроцедуры
