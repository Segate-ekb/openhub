// Запись перевода пулов подписки из «все, кроме исключённых» в «выбранные» в журнал аудита:
// действовал сам хаб, объект — объект подписки, в деталях — какие пулы, сколько пакетов выбрано
// и сколько исключений снято без перевода.

Перем Издатель;       // ИздательСобытий (события)
Перем ИменаЖурнала;   // ИмяОбъектаАудита (аудит) — объект подписки и пулы в журнале
Перем СобытиеЖурнала; // СобытиеАудита (аудит) — форма нагрузки записи

#Область ПубличныйИнтерфейс

// Слушает ли журнал аудита записи перевода: служба аудита подписывается на шину своей фоновой рогаткой,
// и до этого опубликованная запись пропала бы.
//
// Возвращаемое значение:
//  Булево.
//
Функция Слушают() Экспорт
	Возврат Издатель <> Неопределено И Издатель.КоличествоПодписчиков(Издатель.ТипПолучателиПереведены()) > 0;
КонецФункции

// Пишет перевод одной подписки в журнал аудита.
//
// Параметры:
//  Подписка - Вебхук - подписка, чьи пулы переведены.
//  Пулы - Массив из Структура - переведённые пулы: Пул (Число), Выбрано (пакетов в выборе),
//         Исключено (исключённых пакетов до перевода).
//  Снято - Число - исключений пакетов у пулов «никакие», снятых без перевода (необязательный,
//          по умолчанию 0).
//
Процедура Записать(Знач Подписка, Знач Пулы, Знач Снято = 0) Экспорт

	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Переведённые = Новый Массив();
	Для Каждого Пул Из Пулы Цикл
		Переведённые.Добавить(Новый Структура("пул, выбрано, исключено", ИменаЖурнала.Пул(Пул.Пул),
			Цел(Пул.Выбрано), Цел(Пул.Исключено)));
	КонецЦикла;
	Детали = Новый Структура("подписка, режим, пулы, снято", Цел(Подписка.Идентификатор), "выбранные", Переведённые,
		Цел(Снято));

	Данные = СобытиеЖурнала.Собрать("", Издатель.ТипПолучателиПереведены(),
		ИменаЖурнала.ПоТипу(Подписка.ТипОбъекта, Подписка.ОбъектИдентификатор), "", Детали);
	Издатель.Опубликовать(Издатель.ТипПолучателиПереведены(), Данные);

КонецПроцедуры

#КонецОбласти

&Прозвище("АудитПереводаПолучателей")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ИмяОбъектаАудита") _Имена,
	&Пластилин(Значение = "СобытиеАудита") _Событие,
	&Пластилин(Значение = "ИздательСобытий") _Издатель = Неопределено)

	Издатель = _Издатель;
	ИменаЖурнала = _Имена;
	СобытиеЖурнала = _Событие;

КонецПроцедуры
