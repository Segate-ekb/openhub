// Хранилище исключений подписок — репозиторий сущности «ИсключениеПодписки». Правила дерева
// получателей держит СервисИсключенийПодписок, действие при доставке — ОтборДоставкиПодписок.

// BSLLS:UnusedParameters-off

Перем Сам;   // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё

// Исключения одной подписки.
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Массив из ИсключениеПодписки.
//
&МетодЗапроса
Функция ПолучитьПоПодпискаИдентификаторРавно(ПодпискаИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Исключения одного узла во всех подписках.
//
// Параметры:
//  ТипОбъекта - Строка - "пул" | "пакет".
//  ОбъектИдентификатор - Число - идентификатор узла.
//
// Возвращаемое значение:
//  Массив из ИсключениеПодписки.
//
&МетодЗапроса
Функция ПолучитьПоТипОбъектаРавноИОбъектИдентификаторРавно(ТипОбъекта, ОбъектИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Исключение пары «подписка — узел».
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//  ТипОбъекта - Строка - "пул" | "пакет".
//  ОбъектИдентификатор - Число - идентификатор узла.
//
// Возвращаемое значение:
//  ИсключениеПодписки, Неопределено.
//
&МетодЗапроса
Функция ПолучитьОдноПоПодпискаИдентификаторРавноИТипОбъектаРавноИОбъектИдентификаторРавно(
	ПодпискаИдентификатор, ТипОбъекта, ОбъектИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Исключения узлов одного пула: самого пула и его пакетов.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ИсключениеПодписки.
//
&МетодЗапроса
Функция ПолучитьПоПулИдентификаторРавно(ПулИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Исключения подписки — её дерево получателей и то, что уходит вместе с ней.
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Массив из ИсключениеПодписки.
//
Функция ПоПодписке(Знач ПодпискаИдентификатор) Экспорт
	Возврат Массивом(Сам.Достать().ПолучитьПоПодпискаИдентификаторРавно(Цел(ПодпискаИдентификатор)));
КонецФункции

// Исключения узла во всех подписках — что спрашивает доставка и что уходит с удалённым пакетом.
//
// Параметры:
//  ТипОбъекта - Строка - "пул" | "пакет".
//  ОбъектИдентификатор - Число - идентификатор узла.
//
// Возвращаемое значение:
//  Массив из ИсключениеПодписки.
//
Функция ПоОбъекту(Знач ТипОбъекта, Знач ОбъектИдентификатор) Экспорт
	Возврат Массивом(Сам.Достать().ПолучитьПоТипОбъектаРавноИОбъектИдентификаторРавно(
		НРег(СокрЛП(Строка(ТипОбъекта))), Цел(ОбъектИдентификатор)));
КонецФункции

// Исключение пары «подписка — узел».
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//  ТипОбъекта - Строка - "пул" | "пакет".
//  ОбъектИдентификатор - Число - идентификатор узла.
//
// Возвращаемое значение:
//  ИсключениеПодписки, Неопределено.
//
Функция ПоПаре(Знач ПодпискаИдентификатор, Знач ТипОбъекта, Знач ОбъектИдентификатор) Экспорт
	Возврат Сам.Достать().ПолучитьОдноПоПодпискаИдентификаторРавноИТипОбъектаРавноИОбъектИдентификаторРавно(
		Цел(ПодпискаИдентификатор), НРег(СокрЛП(Строка(ТипОбъекта))), Цел(ОбъектИдентификатор));
КонецФункции

// Исключения пула и его пакетов — их снимают вместе с пулом.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ИсключениеПодписки.
//
Функция ПоПулу(Знач ПулИдентификатор) Экспорт
	Возврат Массивом(Сам.Достать().ПолучитьПоПулИдентификаторРавно(Цел(ПулИдентификатор)));
КонецФункции

Функция Массивом(Знач Найденные)
	Возврат ?(Найденные = Неопределено, Новый Массив(), Найденные);
КонецФункции

&ХранилищеСущностей("ИсключениеПодписки")
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин(Значение = "ХранилищеИсключенийПодписок") _Сам)
	Сам = _Сам;
КонецПроцедуры
