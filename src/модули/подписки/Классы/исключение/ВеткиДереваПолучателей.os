// Ветки дерева получателей: пул с режимом и его пакеты по имени, у каждого — достаётся ли он подписке.
// Общая сборка дерева подписки хаба и пула и дерева пакетов в поправке пула к подписке хаба.

Перем СервисПулов;   // СервисПулов (реестр) — пул ветки
Перем СервисПакетов; // СервисПакетов (реестр) — пакеты пулов дерева
Перем Отметки_;      // ОтметкиПолучателей (подписки) — режим пула и правило «пакет получает»

#Область ПубличныйИнтерфейс

// Ветки пулов по имени, у каждой — пакеты пула по имени; пакеты всех пулов читаются одним разрезом.
//
// Параметры:
//  Пулы - Массив из Пул - пулы дерева.
//  Отметки - Структура - отметки дерева (ОтметкиПолучателей.Пустые).
//  ЗакрытыеСверху - Соответствие, Неопределено - пакет → Истина: сняты выше того, кто правит
//                   дерево, и закрыты для правки (необязательный, по умолчанию Неопределено — таких нет).
//
// Возвращаемое значение:
//  Массив из Структура - ветка пула: Идентификатор, Имя, Приватный, Режим ("все" | "выбранные" |
//  "никакие"), Исключён (Булево — режим «никакие»), ИсключеноПакетов (пакетов, которым события
//  не достаются, включая закрытые сверху), Пакеты — Массив из Структура: Идентификатор, Имя,
//  Исключён (событие ему не достаётся), ИсключёнСверху (снят выше и закрыт для правки).
//
Функция Ветки(Знач Пулы, Знач Отметки, Знач ЗакрытыеСверху = Неопределено) Экспорт

	Сверху = ?(ЗакрытыеСверху = Неопределено, Новый Соответствие(), ЗакрытыеСверху);
	ПакетыПулов = ПакетыПулов(Пулы);
	Результат = Новый Массив();
	Для Каждого Пул Из Упорядоченные(Пулы) Цикл
		Результат.Добавить(Ветка(Пул, Упорядоченные(ПакетыПулов.Получить(Цел(Пул.Идентификатор))), Отметки,
			Сверху));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ветка одного пула.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Отметки - Структура - отметки дерева (ОтметкиПолучателей.Пустые).
//  ЗакрытыеСверху - Соответствие, Неопределено - см. Ветки (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура, Неопределено - ветка пула (см. Ветки); Неопределено, если пула нет.
//
Функция ВеткаПула(Знач ПулИдентификатор, Знач Отметки, Знач ЗакрытыеСверху = Неопределено) Экспорт

	Пул = СервисПулов.ПулПоИдентификатору(ПулИдентификатор);
	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Пулы = Новый Массив();
	Пулы.Добавить(Пул);
	Возврат Ветки(Пулы, Отметки, ЗакрытыеСверху)[0];

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пакеты всех пулов дерева одним разрезом, разложенные по пулам.
Функция ПакетыПулов(Знач Пулы)

	Идентификаторы = Новый Массив();
	Результат = Новый Соответствие();
	Для Каждого Пул Из Пулы Цикл
		Идентификаторы.Добавить(Цел(Пул.Идентификатор));
		Результат.Вставить(Цел(Пул.Идентификатор), Новый Массив());
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Пакет Из СервисПакетов.ПакетыПуловДляЧтения(Идентификаторы) Цикл
		Пакеты = Результат.Получить(Цел(Пакет.ПулИдентификатор));
		Если Пакеты <> Неопределено Тогда
			Пакеты.Добавить(Пакет);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Ветка(Знач Пул, Знач Пакеты, Знач Отметки, Знач ЗакрытыеСверху)

	ПулИдентификатор = Цел(Пул.Идентификатор);
	Узлы = Новый Массив();
	Исключено = 0;
	Для Каждого Пакет Из Пакеты Цикл
		Сверху = ЗакрытыеСверху.Получить(Цел(Пакет.Идентификатор)) = Истина;
		Исключён = Сверху ИЛИ НЕ Отметки_.ПакетПолучает(Отметки, ПулИдентификатор, Пакет.Идентификатор);
		Узлы.Добавить(Новый Структура("Идентификатор, Имя, Исключён, ИсключёнСверху",
			Цел(Пакет.Идентификатор), Пакет.Имя, Исключён, Сверху));
		Исключено = Исключено + ?(Исключён, 1, 0);
	КонецЦикла;

	Режим = Отметки_.Режим(Отметки, ПулИдентификатор);
	Возврат Новый Структура("Идентификатор, Имя, Приватный, Режим, Исключён, ИсключеноПакетов, Пакеты",
		ПулИдентификатор, Пул.Имя, НРег(СокрЛП(Строка(Пул.Видимость))) <> "public",
		Режим, Режим = Отметки_.РежимНикакие(), Исключено, Узлы);

КонецФункции

// Пулы и пакеты — по имени без учёта регистра.
Функция Упорядоченные(Знач Элементы)

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Ключ");
	Таблица.Колонки.Добавить("Элемент");
	Если Элементы <> Неопределено Тогда
		Для Каждого Элемент Из Элементы Цикл
			Ряд = Таблица.Добавить();
			Ряд.Ключ = НРег(Элемент.Имя);
			Ряд.Элемент = Элемент;
		КонецЦикла;
	КонецЕсли;
	Таблица.Сортировать("Ключ");
	Возврат Таблица.ВыгрузитьКолонку("Элемент");

КонецФункции

#КонецОбласти

&Прозвище("ВеткиДереваПолучателей")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "ОтметкиПолучателей") _Отметки)

	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	Отметки_ = _Отметки;

КонецПроцедуры
