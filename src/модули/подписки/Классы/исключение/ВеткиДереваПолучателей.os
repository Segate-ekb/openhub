// Ветки дерева получателей: пул и его пакеты по имени с отметками исключения. Общая сборка дерева
// подписки хаба и пула и дерева пакетов в поправке пула к подписке хаба.

Перем СервисПулов;   // СервисПулов (реестр) — пул ветки
Перем СервисПакетов; // СервисПакетов (реестр) — пакеты пулов дерева

#Область ПубличныйИнтерфейс

// Пустые отметки веток: ничего не исключено.
//
// Возвращаемое значение:
//  Структура - Соответствия идентификатор → Истина:
//    * Пулы - Соответствие - исключённые пулы;
//    * Пакеты - Соответствие - исключённые пакеты;
//    * ПакетыСверху - Соответствие - пакеты, исключённые выше того, кто правит дерево: сняты
//                     и закрыты для правки.
//
Функция ПустыеОтметки() Экспорт
	Возврат Новый Структура("Пулы, Пакеты, ПакетыСверху", Новый Соответствие(), Новый Соответствие(),
		Новый Соответствие());
КонецФункции

// Ветки пулов по имени, у каждой — пакеты пула по имени; пакеты всех пулов читаются одним разрезом.
//
// Параметры:
//  Пулы - Массив из Пул - пулы дерева.
//  Отметки - Структура - см. ПустыеОтметки.
//
// Возвращаемое значение:
//  Массив из Структура - ветка пула: Идентификатор, Имя, Приватный, Исключён, ИсключеноПакетов
//  (снятых пакетов, включая исключённые сверху), Пакеты — Массив из Структура: Идентификатор, Имя,
//  Исключён, ИсключёнСверху (снят выше и закрыт для правки).
//
Функция Ветки(Знач Пулы, Знач Отметки) Экспорт

	ПакетыПулов = ПакетыПулов(Пулы);
	Результат = Новый Массив();
	Для Каждого Пул Из Упорядоченные(Пулы) Цикл
		Результат.Добавить(Ветка(Пул, Упорядоченные(ПакетыПулов.Получить(Цел(Пул.Идентификатор))), Отметки));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ветка одного пула.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Отметки - Структура - см. ПустыеОтметки.
//
// Возвращаемое значение:
//  Структура, Неопределено - ветка пула (см. Ветки); Неопределено, если пула нет.
//
Функция ВеткаПула(Знач ПулИдентификатор, Знач Отметки) Экспорт

	Пул = СервисПулов.ПулПоИдентификатору(ПулИдентификатор);
	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Пулы = Новый Массив();
	Пулы.Добавить(Пул);
	Возврат Ветки(Пулы, Отметки)[0];

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пакеты всех пулов дерева одним разрезом, разложенные по пулам.
Функция ПакетыПулов(Знач Пулы)

	Идентификаторы = Новый Массив();
	Результат = Новый Соответствие();
	Для Каждого Пул Из Пулы Цикл
		Идентификаторы.Добавить(Цел(Пул.Идентификатор));
		Результат.Вставить(Цел(Пул.Идентификатор), Новый Массив());
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Пакет Из СервисПакетов.ПакетыПуловДляЧтения(Идентификаторы) Цикл
		Пакеты = Результат.Получить(Цел(Пакет.ПулИдентификатор));
		Если Пакеты <> Неопределено Тогда
			Пакеты.Добавить(Пакет);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Ветка(Знач Пул, Знач Пакеты, Знач Отметки)

	Узлы = Новый Массив();
	Исключено = 0;
	Для Каждого Пакет Из Пакеты Цикл
		Сверху = Отметки.ПакетыСверху.Получить(Цел(Пакет.Идентификатор)) = Истина;
		Исключён = Сверху ИЛИ Отметки.Пакеты.Получить(Цел(Пакет.Идентификатор)) = Истина;
		Узлы.Добавить(Новый Структура("Идентификатор, Имя, Исключён, ИсключёнСверху",
			Цел(Пакет.Идентификатор), Пакет.Имя, Исключён, Сверху));
		Исключено = Исключено + ?(Исключён, 1, 0);
	КонецЦикла;

	Возврат Новый Структура("Идентификатор, Имя, Приватный, Исключён, ИсключеноПакетов, Пакеты",
		Цел(Пул.Идентификатор), Пул.Имя, НРег(СокрЛП(Строка(Пул.Видимость))) <> "public",
		Отметки.Пулы.Получить(Цел(Пул.Идентификатор)) = Истина, Исключено, Узлы);

КонецФункции

// Пулы и пакеты — по имени без учёта регистра.
Функция Упорядоченные(Знач Элементы)

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Ключ");
	Таблица.Колонки.Добавить("Элемент");
	Если Элементы <> Неопределено Тогда
		Для Каждого Элемент Из Элементы Цикл
			Ряд = Таблица.Добавить();
			Ряд.Ключ = НРег(Элемент.Имя);
			Ряд.Элемент = Элемент;
		КонецЦикла;
	КонецЕсли;
	Таблица.Сортировать("Ключ");
	Возврат Таблица.ВыгрузитьКолонку("Элемент");

КонецФункции

#КонецОбласти

&Прозвище("ВеткиДереваПолучателей")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов)

	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;

КонецПроцедуры
