// Хранилище включений подписок — репозиторий сущности «ВключениеПодписки»: пулы в режиме «выбранные»
// и выбранные пакеты. Правила дерева получателей держит СервисИсключенийПодписок, чтение отметок — ОтметкиПолучателей.

// BSLLS:UnusedParameters-off

Перем Сам;   // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё

// Включения одной подписки.
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Массив из ВключениеПодписки.
//
&МетодЗапроса
Функция ПолучитьПоПодпискаИдентификаторРавно(ПодпискаИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Включения одного узла во всех подписках.
//
// Параметры:
//  ТипОбъекта - Строка - "пул" | "пакет".
//  ОбъектИдентификатор - Число - идентификатор узла.
//
// Возвращаемое значение:
//  Массив из ВключениеПодписки.
//
&МетодЗапроса
Функция ПолучитьПоТипОбъектаРавноИОбъектИдентификаторРавно(ТипОбъекта, ОбъектИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Включение пары «подписка — узел».
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//  ТипОбъекта - Строка - "пул" | "пакет".
//  ОбъектИдентификатор - Число - идентификатор узла.
//
// Возвращаемое значение:
//  ВключениеПодписки, Неопределено.
//
&МетодЗапроса
Функция ПолучитьОдноПоПодпискаИдентификаторРавноИТипОбъектаРавноИОбъектИдентификаторРавно(
	ПодпискаИдентификатор, ТипОбъекта, ОбъектИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Включения узлов одного пула: самого пула и его пакетов.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ВключениеПодписки.
//
&МетодЗапроса
Функция ПолучитьПоПулИдентификаторРавно(ПулИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Выборка по перечню подписок.
//
// Параметры:
//  ПодпискаИдентификаторы - Массив из Число - идентификаторы подписок.
//
// Возвращаемое значение:
//  Массив из ВключениеПодписки.
//
&МетодЗапроса
Функция ПолучитьПоПодпискаИдентификаторВ(ПодпискаИдентификаторы) Экспорт
	Возврат Неопределено;
КонецФункции

// Включения подписки — её выбор и то, что уходит вместе с ней.
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Массив из ВключениеПодписки.
//
Функция ПоПодписке(Знач ПодпискаИдентификатор) Экспорт
	Возврат Массивом(Сам.Достать().ПолучитьПоПодпискаИдентификаторРавно(Цел(ПодпискаИдентификатор)));
КонецФункции

// Включения узла во всех подписках — что спрашивает доставка и что уходит с удалённым пакетом.
//
// Параметры:
//  ТипОбъекта - Строка - "пул" | "пакет".
//  ОбъектИдентификатор - Число - идентификатор узла.
//
// Возвращаемое значение:
//  Массив из ВключениеПодписки.
//
Функция ПоОбъекту(Знач ТипОбъекта, Знач ОбъектИдентификатор) Экспорт
	Возврат Массивом(Сам.Достать().ПолучитьПоТипОбъектаРавноИОбъектИдентификаторРавно(
		НРег(СокрЛП(Строка(ТипОбъекта))), Цел(ОбъектИдентификатор)));
КонецФункции

// Включение пары «подписка — узел».
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//  ТипОбъекта - Строка - "пул" | "пакет".
//  ОбъектИдентификатор - Число - идентификатор узла.
//
// Возвращаемое значение:
//  ВключениеПодписки, Неопределено.
//
Функция ПоПаре(Знач ПодпискаИдентификатор, Знач ТипОбъекта, Знач ОбъектИдентификатор) Экспорт
	Возврат Сам.Достать().ПолучитьОдноПоПодпискаИдентификаторРавноИТипОбъектаРавноИОбъектИдентификаторРавно(
		Цел(ПодпискаИдентификатор), НРег(СокрЛП(Строка(ТипОбъекта))), Цел(ОбъектИдентификатор));
КонецФункции

// Включения пула и его пакетов — их снимают вместе с пулом.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ВключениеПодписки.
//
Функция ПоПулу(Знач ПулИдентификатор) Экспорт
	Возврат Массивом(Сам.Достать().ПолучитьПоПулИдентификаторРавно(Цел(ПулИдентификатор)));
КонецФункции

// Включения деревьев получателей подписок одним чтением — сводки раздела подписок. Пустой перечень базу не спрашивает.
//
// Параметры:
//  ПодпискаИдентификаторы - Массив из Число - идентификаторы подписок.
//
// Возвращаемое значение:
//  Массив из ВключениеПодписки.
//
Функция ПоПодпискам(Знач ПодпискаИдентификаторы) Экспорт

	Идентификаторы = Новый Массив();
	Для Каждого Идентификатор Из ПодпискаИдентификаторы Цикл
		Идентификаторы.Добавить(Цел(Идентификатор));
	КонецЦикла;
	Если Идентификаторы.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат Массивом(Сам.Достать().ПолучитьПоПодпискаИдентификаторВ(Идентификаторы));

КонецФункции

Функция Массивом(Знач Найденные)
	Возврат ?(Найденные = Неопределено, Новый Массив(), Найденные);
КонецФункции

&ХранилищеСущностей("ВключениеПодписки")
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин(Значение = "ХранилищеВключенийПодписок") _Сам)
	Сам = _Сам;
КонецПроцедуры
