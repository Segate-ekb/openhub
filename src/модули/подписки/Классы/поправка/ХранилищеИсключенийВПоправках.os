// Хранилище исключений в поправках — репозиторий сущности «ИсключениеВПоправке». Правила держит
// СервисПоправокПодписок, действие при доставке — ОтборДоставкиПодписок.

// BSLLS:UnusedParameters-off

Перем Сам;   // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё

// Исключения в поправках к одной подписке.
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Массив из ИсключениеВПоправке.
//
&МетодЗапроса
Функция ПолучитьПоПодпискаИдентификаторРавно(ПодпискаИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Исключения в поправке одного пула к одной подписке.
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ИсключениеВПоправке.
//
&МетодЗапроса
Функция ПолучитьПоПодпискаИдентификаторРавноИПулИдентификаторРавно(ПодпискаИдентификатор, ПулИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Исключения одного пакета во всех поправках.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив из ИсключениеВПоправке.
//
&МетодЗапроса
Функция ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Исключения пакетов одного пула во всех поправках.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ИсключениеВПоправке.
//
&МетодЗапроса
Функция ПолучитьПоПулИдентификаторРавно(ПулИдентификатор) Экспорт
	Возврат Неопределено;
КонецФункции

// Исключения в поправках к подписке — то, что уходит вместе с ней.
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Массив из ИсключениеВПоправке.
//
Функция ПоПодписке(Знач ПодпискаИдентификатор) Экспорт
	Возврат Массивом(Сам.Достать().ПолучитьПоПодпискаИдентификаторРавно(Цел(ПодпискаИдентификатор)));
КонецФункции

// Исключения в поправке пула к подписке: её дерево пакетов и то, что сбрасывается вместе с ней.
//
// Параметры:
//  ПодпискаИдентификатор - Число - идентификатор подписки.
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ИсключениеВПоправке.
//
Функция ПоПоправке(Знач ПодпискаИдентификатор, Знач ПулИдентификатор) Экспорт
	Возврат Массивом(Сам.Достать().ПолучитьПоПодпискаИдентификаторРавноИПулИдентификаторРавно(
		Цел(ПодпискаИдентификатор), Цел(ПулИдентификатор)));
КонецФункции

// Исключения пакета во всех поправках — что спрашивают доставка и подписки сверху и что уходит
// с удалённым пакетом.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив из ИсключениеВПоправке.
//
Функция ПоПакету(Знач ПакетИдентификатор) Экспорт
	Возврат Массивом(Сам.Достать().ПолучитьПоПакетИдентификаторРавно(Цел(ПакетИдентификатор)));
КонецФункции

// Исключения пакетов пула — их снимают вместе с пулом.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ИсключениеВПоправке.
//
Функция ПоПулу(Знач ПулИдентификатор) Экспорт
	Возврат Массивом(Сам.Достать().ПолучитьПоПулИдентификаторРавно(Цел(ПулИдентификатор)));
КонецФункции

Функция Массивом(Знач Найденные)
	Возврат ?(Найденные = Неопределено, Новый Массив(), Найденные);
КонецФункции

&ХранилищеСущностей("ИсключениеВПоправке")
Процедура ПриСозданииОбъекта(&Табакерка &Пластилин(Значение = "ХранилищеИсключенийВПоправках") _Сам)
	Сам = _Сам;
КонецПроцедуры
