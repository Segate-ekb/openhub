// Сущность "ИсключениеВПоправке" — пакет пула, с которого пул в своей поправке к подписке хаба
// снял галку: подписка не сообщает о нём, и пакет её не видит.

&Идентификатор
&ГенерируемоеЗначение
&Колонка(Тип = "Целое")
Перем Идентификатор Экспорт;

// подписка хаба, которую сужает поправка пула (Вебхук.Идентификатор)
&Колонка(Тип = "Целое")
Перем ПодпискаИдентификатор Экспорт;

// пул, поставивший поправку
&Колонка(Тип = "Целое")
Перем ПулИдентификатор Экспорт;

// исключённый пакет пула
&Колонка(Тип = "Целое")
Перем ПакетИдентификатор Экспорт;

// кто исключил (id пользователя; 0 — системно)
&Колонка(Тип = "Целое")
Перем КемИдентификатор Экспорт;

&Колонка(Тип = "ДатаВремя")
Перем Создано Экспорт;

&Сущность(ИмяТаблицы = "ИсключенияВПоправках")
Процедура ПриСозданииОбъекта()
КонецПроцедуры
