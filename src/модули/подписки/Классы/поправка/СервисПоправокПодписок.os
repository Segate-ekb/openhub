// Подписки сверху и поправки к ним: какие подписки хаба и пула видит нижестоящий объект и как
// он их сужает, а пул — ещё и какие свои пакеты исключает из подписки хаба. Поправка не даёт права
// на саму подписку — её ставит распорядитель своего объекта; исключённый узел подписку не видит.

Перем Поправки;             // ХранилищеПоправокПодписок (подписки)
Перем Исключения;           // ХранилищеИсключенийПодписок (подписки) — узлы, исключённые из деревьев получателей
Перем ИсключенияВПоправках; // ХранилищеИсключенийВПоправках (подписки) — пакеты, исключённые поправкой пула
Перем Ветки;                // ВеткиДереваПолучателей (подписки) — дерево пакетов пула в поправке
Перем СервисПакетов;        // СервисПакетов (реестр) — пакеты, отмеченные галкой
Перем СервисПодписок;       // СервисПодписок (подписки) — подписки объектов и право распоряжаться ими
Перем ПараметрыПодписки;    // ПараметрыПодписки (подписки) — разрешение сужать и события подписки
Перем ОтборТегов;           // ОтборПоТегам (подписки) — перечень тегов поправки
Перем ЧерезЗапятую;         // СписокЧерезЗапятую (основа)
Перем Снятие;               // СнятиеСтрок (данные) — снятие поправки тем же путём, что и при удалении подписки

#Область ПубличныйИнтерфейс

// Подписки сверху, которые нижестоящий объект видит: подписки хаба — у пула и пакета, подписки
// пула — у его пакетов; только те, чей хозяин разрешил их сужать и из чьего дерева получателей
// не исключены ни объект, ни его пул, а пакет — ещё и не исключён поправкой своего пула.
//
// Параметры:
//  Объект - Структура - описание нижестоящего объекта (СервисПодписок.ОбъектПула, ОбъектПакета).
//
// Возвращаемое значение:
//  Массив из Вебхук - сначала подписки хаба, затем пула; у хаба — пустой.
//
Функция ПодпискиСверху(Знач Объект) Экспорт

	Результат = Новый Массив();
	Тип = ТипОбъекта(Объект);
	Если Тип <> "пул" И Тип <> "пакет" Тогда
		Возврат Результат;
	КонецЕсли;

	Исключившие = ИсключившиеПодписки(Объект, Тип);
	ДобавитьСужаемые(Результат, СервисПодписок.Список(СервисПодписок.ОбъектХаба()), Исключившие);
	Если Тип = "пакет" Тогда
		ДобавитьСужаемые(Результат, СервисПодписок.Список(
			Новый Структура("ТипОбъекта, Идентификатор", "пул", Цел(Объект.ПулИдентификатор))), Исключившие);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Подписка сверху по идентификатору. Подписка, которую объект не видит, для него не существует.
//
// Параметры:
//  Объект - Структура - описание нижестоящего объекта.
//  Идентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Вебхук, Неопределено - Неопределено, если такой подписки сверху у объекта нет.
//
Функция ПодпискаСверху(Знач Объект, Знач Идентификатор) Экспорт

	Для Каждого Подписка Из ПодпискиСверху(Объект) Цикл
		Если Цел(Подписка.Идентификатор) = Цел(Идентификатор) Тогда
			Возврат Подписка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Поправка объекта к подписке сверху.
//
// Параметры:
//  Объект - Структура - описание нижестоящего объекта.
//  Подписка - Вебхук - подписка сверху.
//
// Возвращаемое значение:
//  ПоправкаПодписки, Неопределено - Неопределено, если объект подписку не сужал.
//
Функция ПоправкаОбъекта(Знач Объект, Знач Подписка) Экспорт
	Возврат Поправки.ПоПаре(Подписка.Идентификатор, ТипОбъекта(Объект), Объект.Идентификатор);
КонецФункции

// Ставит поправку объекта к подписке сверху: у пары «подписка — объект» она одна, повторная
// правит прежнюю. Поправка только сужает: событие, которого у подписки нет, не добавляется.
// Поправка, которая ничего не сужает и пакетов не исключает, снимается; исключения пакетов пула
// (см. ОтметитьПакеты) она не трогает. Требует права распоряжаться подписками объекта; бросает
// исключение без права, на имени не из тегов объекта и на отборе по тегам к подписке без событий
// версии.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание нижестоящего объекта.
//  Идентификатор - Число - идентификатор подписки сверху.
//  Сужение - Структура - любой ключ необязателен:
//    * НеПрисылать - Булево - не доставлять событий этого объекта вовсе; нет — Ложь;
//    * ОставленныеСобытия - Строка - события подписки, которые объект оставляет, через запятую;
//                нет — оставлены все;
//    * ОтборТегов - Массив из Строка - свой отбор: имена из тегов объекта (см. ОтборПоТегам.Перечень);
//                нет — без отбора.
//
// Возвращаемое значение:
//  Структура, Неопределено - Подписка (Вебхук) и Поправка (ПоправкаПодписки, Неопределено —
//  поправка ничего не сужала и снята); Неопределено, если такой подписки сверху у объекта нет.
//
Функция Поставить(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Сужение) Экспорт

	ТребоватьПрава(Пользователь, Объект);
	Подписка = ПодпискаСверху(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	НеПрисылать = (Поле(Сужение, "НеПрисылать") = Истина);
	Оставленные = Поле(Сужение, "ОставленныеСобытия");
	Снятые = СнятыеСобытия(Подписка, ?(Оставленные = Неопределено, Подписка.ТипыСобытий, Оставленные));
	Теги = ОтборТегов.Перечень(Поле(Сужение, "ОтборТегов"), ТипОбъекта(Объект), Объект.Идентификатор);
	Если Теги.Количество() > 0 И НЕ ОтборТегов.СудитНабор(Подписка.ТипыСобытий) Тогда
		ВызватьИсключение "Подписка не доставляет событий версии — отбору по тегам судить нечего:"
			+ " очистите перечень тегов поправки";
	КонецЕсли;

	Поправка = ПоправкаОбъекта(Объект, Подписка);
	Если НЕ НеПрисылать И Снятые.Количество() = 0 И Теги.Количество() = 0
		И НЕ ИсключаетПакеты(Подписка, Объект) Тогда
		СнятьПоправку(Подписка, Объект, Поправка);
		Возврат Новый Структура("Подписка, Поправка", Подписка, Неопределено);
	КонецЕсли;

	Поправка = ?(Поправка = Неопределено, НоваяПоправка(Подписка, Объект), Поправка);
	Поправка.НеПрисылать = НеПрисылать;
	Поправка.СнятыеСобытия = СтрСоединить(Снятые, ",");
	Поправка.ОтборТегов = СтрСоединить(Теги, ",");
	Сохранить(Поправка, Пользователь);

	Возврат Новый Структура("Подписка, Поправка", Подписка, Поправка);

КонецФункции

// Снимает поправку объекта к подписке сверху вместе с исключёнными ею пакетами. Требует права
// распоряжаться подписками объекта.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание нижестоящего объекта.
//  Идентификатор - Число - идентификатор подписки сверху.
//
// Возвращаемое значение:
//  Булево - Ложь, если такой подписки сверху у объекта нет; снимать нечего — тоже Истина.
//
Функция Снять(Знач Пользователь, Знач Объект, Знач Идентификатор) Экспорт

	ТребоватьПрава(Пользователь, Объект);
	Подписка = ПодпискаСверху(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	СнятьПоправку(Подписка, Объект, ПоправкаОбъекта(Объект, Подписка));
	Возврат Истина;

КонецФункции

// Поправки, которые нижестоящие объекты поставили к подписке, — их видит её хозяин.
//
// Параметры:
//  Подписка - Вебхук - подписка хаба или пула.
//
// Возвращаемое значение:
//  Массив из ПоправкаПодписки.
//
Функция ПоправкиПодписки(Знач Подписка) Экспорт
	Возврат Поправки.ПоПодписке(Подписка.Идентификатор);
КонецФункции

// Дерево пакетов пула в его поправке к подписке хаба — тем же видом, что дерево получателей
// подписки пула: пакеты пула по имени, исключённые поправкой и исключённые хозяином подписки
// (сняты и закрыты для правки). Новый пакет попадает в дерево включённым. Требует права
// распоряжаться подписками пула.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание пула (СервисПодписок.ОбъектПула).
//  Идентификатор - Число - идентификатор подписки хаба.
//
// Возвращаемое значение:
//  Структура, Неопределено - Подписка (Вебхук), ГалкиПулов (Ложь — галки только у пакетов пула)
//  и Пулы (одна ветка пула, см. ВеткиДереваПолучателей.Ветки); Неопределено, если объект не пул
//  или такой подписки хаба сверху у него нет.
//
Функция ДеревоПоправки(Знач Пользователь, Знач Объект, Знач Идентификатор) Экспорт

	ТребоватьПрава(Пользователь, Объект);
	Подписка = ПодпискаХабаДляПула(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Отметки = Ветки.ПустыеОтметки();
	Для Каждого Запись Из ИсключенияВПоправках.ПоПоправке(Подписка.Идентификатор, Объект.Идентификатор) Цикл
		Отметки.Пакеты.Вставить(Цел(Запись.ПакетИдентификатор), Истина);
	КонецЦикла;
	Отметки.ПакетыСверху = ИсключённыеСверху(Подписка, Объект.Идентификатор);

	Пулы = Новый Массив();
	Ветка = Ветки.ВеткаПула(Объект.Идентификатор, Отметки);
	Если Ветка <> Неопределено Тогда
		Пулы.Добавить(Ветка);
	КонецЕсли;
	Возврат Новый Структура("Подписка, ГалкиПулов, Пулы", Подписка, Ложь, Пулы);

КонецФункции

// Ставит и снимает галки пакетов в поправке пула к подписке хаба: исключает и возвращает названные
// пакеты, остальных не касается; пакет в обоих перечнях исключается. Пакет вне пула — удалённый,
// несуществующий или чужой — пропускается молча и одинаково; галка на пакет, исключённый хозяином
// подписки, не ложится. Первое исключение заводит поправку, а поправка, которой больше нечего
// сужать, снимается. Требует права распоряжаться подписками пула.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание пула.
//  Идентификатор - Число - идентификатор подписки хаба.
//  Исключаемые - Массив из Число - пакеты, с которых галка снимается.
//  Включаемые - Массив из Число - пакеты, на которые галка ставится.
//
// Возвращаемое значение:
//  Булево - Ложь, если объект не пул или такой подписки хаба сверху у него нет.
//
Функция ОтметитьПакеты(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Исключаемые,
	Знач Включаемые) Экспорт

	ТребоватьПрава(Пользователь, Объект);
	Подписка = ПодпискаХабаДляПула(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ПрименитьГалки(Пользователь, Подписка, Объект,
		ПакетыПослеГалок(Подписка, Объект.Идентификатор, Исключаемые, Включаемые));
	Возврат Истина;

КонецФункции

// Заменяет исключения пакетов в поправке пула названными: пакет вне перечня возвращается.
// Права, пропуски и закрытые пакеты — как у ОтметитьПакеты.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание пула.
//  Идентификатор - Число - идентификатор подписки хаба.
//  Исключаемые - Массив из Число - пакеты, которые остаются исключёнными.
//
// Возвращаемое значение:
//  Булево - Ложь, если объект не пул или такой подписки хаба сверху у него нет.
//
Функция ЗаменитьПакеты(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Исключаемые) Экспорт

	ТребоватьПрава(Пользователь, Объект);
	Подписка = ПодпискаХабаДляПула(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ПрименитьГалки(Пользователь, Подписка, Объект,
		ПакетыПослеЗамены(Подписка, Объект.Идентификатор, Исключаемые));
	Возврат Истина;

КонецФункции

// Сколько пакетов пула подписка хаба обходит — снятых поправкой пула и хозяином подписки, — для
// сводки без самого дерева. Требует права распоряжаться подписками пула.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание пула.
//  Идентификатор - Число - идентификатор подписки хаба.
//
// Возвращаемое значение:
//  Структура, Неопределено - СнялПул (Число — пакеты, снятые поправкой пула и открытые для правки)
//  и СнялХозяин (Число — пакеты пула, снятые хозяином подписки; снятый обоими считается здесь);
//  Неопределено, если объект не пул или такой подписки хаба сверху у него нет.
//
Функция СводкаПоправки(Знач Пользователь, Знач Объект, Знач Идентификатор) Экспорт

	ТребоватьПрава(Пользователь, Объект);
	Подписка = ПодпискаХабаДляПула(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пакеты = ПакетыПоправки(Подписка, Объект.Идентификатор);
	СнялПул = 0;
	Для Каждого КиЗ Из Пакеты.Прежние Цикл
		СнялПул = СнялПул + ?(Пакеты.Закрытые.Получить(КиЗ.Ключ) = Неопределено, 1, 0);
	КонецЦикла;
	Возврат Новый Структура("СнялПул, СнялХозяин", СнялПул, Пакеты.Закрытые.Количество());

КонецФункции

// Пакеты, которые поправка пула исключила из подписки хаба, — их число видит хозяин подписки.
//
// Параметры:
//  Поправка - ПоправкаПодписки - поправка нижестоящего объекта.
//
// Возвращаемое значение:
//  Массив из Число - идентификаторы пакетов; у поправки пакета — пустой.
//
Функция ИсключённыеПакеты(Знач Поправка) Экспорт

	Результат = Новый Массив();
	Если ТипОбъекта(Поправка) <> "пул" Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Запись Из ИсключенияВПоправках.ПоПоправке(Поправка.ПодпискаИдентификатор,
		Поправка.ОбъектИдентификатор) Цикл
		Результат.Добавить(Цел(Запись.ПакетИдентификатор));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// События подписки, которые поправка оставляет объекту.
//
// Параметры:
//  Подписка - Вебхук - подписка сверху.
//  Поправка - ПоправкаПодписки, Неопределено - поправка объекта; Неопределено — не сужал.
//
// Возвращаемое значение:
//  Массив из Строка - типы событий в порядке подписки.
//
Функция ОставленныеСобытия(Знач Подписка, Знач Поправка) Экспорт

	Результат = Новый Массив();
	Снятые = ?(Поправка = Неопределено, "", Поправка.СнятыеСобытия);
	Для Каждого Тип Из ЧерезЗапятую.Разобрать(Подписка.ТипыСобытий) Цикл
		Если НЕ ЧерезЗапятую.Содержит(Снятые, Тип) Тогда
			Результат.Добавить(Тип);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьСужаемые(Результат, Знач Подписки, Знач Исключившие)
	Для Каждого Подписка Из Подписки Цикл
		Если ПараметрыПодписки.Свойства(Подписка).СужениеРазрешено
			И Исключившие.Получить(Цел(Подписка.Идентификатор)) = Неопределено Тогда
			Результат.Добавить(Подписка);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Подписки, из чьих деревьев исключён объект или его пул, и подписки хаба, из которых пакет
// исключён своим пулом, — одним чтением на узел.
Функция ИсключившиеПодписки(Знач Объект, Знач Тип)

	Узлы = Новый Массив();
	Узлы.Добавить(Новый Структура("ТипОбъекта, Идентификатор", "пул", Цел(Объект.ПулИдентификатор)));
	Если Тип = "пакет" Тогда
		Узлы.Добавить(Новый Структура("ТипОбъекта, Идентификатор", "пакет", Цел(Объект.Идентификатор)));
	КонецЕсли;

	Результат = Новый Соответствие();
	Для Каждого Узел Из Узлы Цикл
		Для Каждого Исключённый Из Исключения.ПоОбъекту(Узел.ТипОбъекта, Узел.Идентификатор) Цикл
			Результат.Вставить(Цел(Исключённый.ПодпискаИдентификатор), Истина);
		КонецЦикла;
	КонецЦикла;
	Если Тип = "пакет" Тогда
		Для Каждого Исключённый Из ИсключенияВПоправках.ПоПакету(Объект.Идентификатор) Цикл
			Результат.Вставить(Цел(Исключённый.ПодпискаИдентификатор), Истина);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Оставленное, которого у подписки нет, ничего не добавляет: снимается только своё подписки.
Функция СнятыеСобытия(Знач Подписка, Знач Оставленные)

	Результат = Новый Массив();
	Для Каждого Тип Из ЧерезЗапятую.Разобрать(Подписка.ТипыСобытий) Цикл
		Если НЕ ЧерезЗапятую.Содержит(Оставленные, Тип) Тогда
			Результат.Добавить(Тип);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Поле(Знач Сужение, Знач Имя)
	Значение = Неопределено;
	Если Сужение <> Неопределено Тогда
		Сужение.Свойство(Имя, Значение);
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Поправка снимается вместе с исключёнными ею пакетами.
Процедура СнятьПоправку(Знач Подписка, Знач Объект, Знач Поправка)

	Снимаемые = Новый Массив();
	Если Поправка <> Неопределено Тогда
		Снимаемые.Добавить(Поправка);
	КонецЕсли;
	Если ТипОбъекта(Объект) = "пул" Тогда
		Для Каждого Запись Из ИсключенияВПоправках.ПоПоправке(Подписка.Идентификатор, Объект.Идентификатор) Цикл
			Снимаемые.Добавить(Запись);
		КонецЦикла;
	КонецЕсли;
	Снятие.Снять(Снимаемые);

КонецПроцедуры

Функция НоваяПоправка(Знач Подписка, Знач Объект)

	Поправка = Поправки.СоздатьЭлемент();
	Поправка.ПодпискаИдентификатор = Цел(Подписка.Идентификатор);
	Поправка.ТипОбъекта = ТипОбъекта(Объект);
	Поправка.ОбъектИдентификатор = Цел(Объект.Идентификатор);
	Поправка.ПулИдентификатор = Цел(Объект.ПулИдентификатор);
	Поправка.НеПрисылать = Ложь;
	Поправка.СнятыеСобытия = "";
	Поправка.ОтборТегов = "";
	Поправка.Создана = ТекущаяУниверсальнаяДата();
	Возврат Поправка;

КонецФункции

Процедура Сохранить(Знач Поправка, Знач Пользователь)
	Поправка.КемИдентификатор = ?(Пользователь = Неопределено, 0, Цел(Пользователь.Идентификатор));
	Поправка.Обновлена = ТекущаяУниверсальнаяДата();
	Поправка.Сохранить();
КонецПроцедуры

// Право ставить поправку — то же, что заводить подписки своего объекта.
Процедура ТребоватьПрава(Знач Пользователь, Знач Объект)

	Если НЕ СервисПодписок.МожетУправлять(Пользователь, Объект) Тогда
		ВызватьИсключение "Недостаточно прав, чтобы сузить подписку для этого объекта";
	КонецЕсли;

КонецПроцедуры

Функция ТипОбъекта(Знач Объект)
	Возврат НРег(СокрЛП(Строка(Объект.ТипОбъекта)));
КонецФункции

#КонецОбласти

#Область ИсключенияПакетов

// Пакетами сужает подписку хаба только пул: у пакета дерева нет.
Функция ПодпискаХабаДляПула(Знач Объект, Знач Идентификатор)

	Если ТипОбъекта(Объект) <> "пул" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ПодпискаСверху(Объект, Идентификатор);

КонецФункции

Функция ИсключаетПакеты(Знач Подписка, Знач Объект)
	Возврат ТипОбъекта(Объект) = "пул"
		И ИсключенияВПоправках.ПоПоправке(Подписка.Идентификатор, Объект.Идентификатор).Количество() > 0;
КонецФункции

// Первое исключение заводит поправку; поправка, которой больше нечего сужать, снимается.
Процедура ПрименитьГалки(Знач Пользователь, Знач Подписка, Знач Объект, Знач Пакеты)

	Поправка = ПоправкаОбъекта(Объект, Подписка);
	Если Пакеты.Итог.Количество() = 0 И НЕ СужаетСобытия(Поправка) Тогда
		СнятьПоправку(Подписка, Объект, Поправка);
		Возврат;
	КонецЕсли;

	Поправка = ?(Поправка = Неопределено, НоваяПоправка(Подписка, Объект), Поправка);
	Сохранить(Поправка, Пользователь);
	ЗаписатьПакеты(Поправка, Пакеты, Пользователь);

КонецПроцедуры

Функция СужаетСобытия(Знач Поправка)
	Возврат Поправка <> Неопределено И (Поправка.НеПрисылать = Истина
		ИЛИ ЗначениеЗаполнено(Поправка.СнятыеСобытия) ИЛИ ЗначениеЗаполнено(Поправка.ОтборТегов));
КонецФункции

// Исключения поправки пула одним чтением: Прежние (пакет → строка), Закрытые — снятые хозяином
// подписки (пакет → Истина) и Итог (пакет → Истина), который правят галки.
Функция ПакетыПоправки(Знач Подписка, Знач ПулИдентификатор)

	Прежние = Новый Соответствие();
	Итог = Новый Соответствие();
	Для Каждого Запись Из ИсключенияВПоправках.ПоПоправке(Подписка.Идентификатор, ПулИдентификатор) Цикл
		Прежние.Вставить(Цел(Запись.ПакетИдентификатор), Запись);
		Итог.Вставить(Цел(Запись.ПакетИдентификатор), Истина);
	КонецЦикла;
	Возврат Новый Структура("Прежние, Закрытые, Итог", Прежние, ИсключённыеСверху(Подписка, ПулИдентификатор), Итог);

КонецФункции

// Галки показанных пакетов: пакет в обоих перечнях исключается, закрытый своей отметки не меняет.
Функция ПакетыПослеГалок(Знач Подписка, Знач ПулИдентификатор, Знач Исключаемые, Знач Включаемые)

	Пакеты = ПакетыПоправки(Подписка, ПулИдентификатор);
	Снимаемые = Новый Соответствие();
	Для Каждого Ид Из Исключаемые Цикл
		Снимаемые.Вставить(Цел(Ид), Истина);
	КонецЦикла;

	Для Каждого Ид Из Включаемые Цикл
		Если Снимаемые.Получить(Цел(Ид)) = Неопределено И Пакеты.Закрытые.Получить(Цел(Ид)) = Неопределено
			И Пакеты.Итог.Получить(Цел(Ид)) <> Неопределено Тогда
			Пакеты.Итог.Удалить(Цел(Ид));
		КонецЕсли;
	КонецЦикла;
	ДобавитьОткрытые(Пакеты, ПакетыПула(Исключаемые, ПулИдентификатор));
	Возврат Пакеты;

КонецФункции

// Замена: итог — присланные пакеты пула, кроме закрытых, и закрытые из прежних.
Функция ПакетыПослеЗамены(Знач Подписка, Знач ПулИдентификатор, Знач Исключаемые)

	Пакеты = ПакетыПоправки(Подписка, ПулИдентификатор);
	Пакеты.Итог = Новый Соответствие();
	Для Каждого КиЗ Из Пакеты.Прежние Цикл
		Если Пакеты.Закрытые.Получить(КиЗ.Ключ) <> Неопределено Тогда
			Пакеты.Итог.Вставить(КиЗ.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;
	ДобавитьОткрытые(Пакеты, ПакетыПула(Исключаемые, ПулИдентификатор));
	Возврат Пакеты;

КонецФункции

Процедура ДобавитьОткрытые(Пакеты, Знач Идентификаторы)
	Для Каждого Ид Из Идентификаторы Цикл
		Если Пакеты.Закрытые.Получить(Ид) = Неопределено Тогда
			Пакеты.Итог.Вставить(Ид, Истина);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Пакеты пула среди названных: чужой, удалённый и несуществующий пропускаются одинаково.
Функция ПакетыПула(Знач Идентификаторы, Знач ПулИдентификатор)

	Результат = Новый Массив();
	Названные = Новый Массив();
	Для Каждого Ид Из Идентификаторы Цикл
		Названные.Добавить(Цел(Ид));
	КонецЦикла;
	Если Названные.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Пакет Из СервисПакетов.ПакетыПоИдентификаторам(Названные) Цикл
		Если Цел(Пакет.ПулИдентификатор) = Цел(ПулИдентификатор) Тогда
			Результат.Добавить(Цел(Пакет.Идентификатор));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// У пары «подписка — пакет» исключение одно: заводится только то, чего среди прежних нет.
Процедура ЗаписатьПакеты(Знач Поправка, Знач Пакеты, Знач Пользователь)

	Снимаемые = Новый Массив();
	Для Каждого КиЗ Из Пакеты.Прежние Цикл
		Если Пакеты.Итог.Получить(КиЗ.Ключ) = Неопределено Тогда
			Снимаемые.Добавить(КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Снятие.Снять(Снимаемые);

	Момент = ТекущаяУниверсальнаяДата();
	Для Каждого КиЗ Из Пакеты.Итог Цикл
		Если Пакеты.Прежние.Получить(КиЗ.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Запись = ИсключенияВПоправках.СоздатьЭлемент();
		Запись.ПодпискаИдентификатор = Цел(Поправка.ПодпискаИдентификатор);
		Запись.ПулИдентификатор = Цел(Поправка.ОбъектИдентификатор);
		Запись.ПакетИдентификатор = Цел(КиЗ.Ключ);
		Запись.КемИдентификатор = ?(Пользователь = Неопределено, 0, Цел(Пользователь.Идентификатор));
		Запись.Создано = Момент;
		Запись.Сохранить();
	КонецЦикла;

КонецПроцедуры

// Пакеты пула, которые хозяин подписки исключил из её дерева: в поправке пула они сняты и закрыты.
Функция ИсключённыеСверху(Знач Подписка, Знач ПулИдентификатор)

	Результат = Новый Соответствие();
	Для Каждого Запись Из Исключения.ПоПодписке(Подписка.Идентификатор) Цикл
		Если Запись.ТипОбъекта = "пакет" И Цел(Запись.ПулИдентификатор) = Цел(ПулИдентификатор) Тогда
			Результат.Вставить(Цел(Запись.ОбъектИдентификатор), Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("СервисПоправокПодписок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПоправокПодписок") _Поправки,
	&Пластилин(Значение = "ХранилищеИсключенийПодписок") _Исключения,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "ПараметрыПодписки") _ПараметрыПодписки,
	&Пластилин(Значение = "ОтборПоТегам") _ОтборТегов,
	&Пластилин(Значение = "ХранилищеИсключенийВПоправках") _ИсключенияВПоправках,
	&Пластилин(Значение = "ВеткиДереваПолучателей") _Ветки,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СписокЧерезЗапятую") _ЧерезЗапятую = Неопределено,
	&Пластилин(Значение = "СнятиеСтрок") _Снятие = Неопределено)

	ЧерезЗапятую = ?(_ЧерезЗапятую = Неопределено, Новый СписокЧерезЗапятую(), _ЧерезЗапятую);
	Снятие = ?(_Снятие = Неопределено, Новый СнятиеСтрок(), _Снятие);

	Поправки = _Поправки;
	Исключения = _Исключения;
	СервисПодписок = _СервисПодписок;
	ПараметрыПодписки = _ПараметрыПодписки;
	ОтборТегов = _ОтборТегов;
	ИсключенияВПоправках = _ИсключенияВПоправках;
	Ветки = _Ветки;
	СервисПакетов = _СервисПакетов;

КонецПроцедуры
