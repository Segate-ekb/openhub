// Форма целевого URL исходящего вебхука: схема, управляющие символы, userinfo, непустой
// хост. Куда адрес ведёт — здесь не судится и не разбирается.

Перем Настройки;       // СервисНастроек (настройки) — допускать ли http
Перем Форма;           // ФормаАдреса (основа) — общий каркас проверки формы адреса
Перем Вердикты;        // Вердикт (основа) — форма ответа

#Область ПубличныйИнтерфейс

// Проверяет, разбирается ли строка как адрес доставки вебхука. Отвергается только то,
// что адресом не является: пустая строка, управляющие символы, чужая схема, userinfo,
// отсутствующий хост. Сеть назначения не проверяется. Исключений не бросает.
//
// Параметры:
//  URL - Строка - целевой адрес.
//
// Возвращаемое значение:
//  Структура - Успех (Булево) и Сообщение (Строка) с причиной отказа словами.
//
Функция Проверить(Знач URL) Экспорт

	Коды = Форма.Коды();
	Разбор = Форма.Разобрать(URL, "https");
	// http разрешается настройкой, и спрашивается она только на адресе со схемой http:
	// у остальных ответ настройки на итог не влияет
	Если Разбор.Код = Коды.ЧужаяСхема И Разбор.Схема = "http" И HTTPРазрешён() Тогда
		Разбор = Форма.Разобрать(URL, "http,https");
	КонецЕсли;

	Если Разбор.Код = Коды.Пусто Тогда
		Возврат Вердикты.ОтказСловами("Пустой URL");
	ИначеЕсли Разбор.Код = Коды.Управляющий Тогда
		// адрес приезжает из формы раскодированным, и «%0D%0AX-Evil:+1» доходит сюда
		// настоящими CR/LF — это инъекция в лог и в заголовки
		Возврат Вердикты.ОтказСловами(СтрШаблон(
			"URL содержит недопустимый символ (%1) — управляющие символы и пробелы"
			+ " должны быть закодированы (%%20, %%0D…)", Разбор.Символ));
	ИначеЕсли Разбор.Код = Коды.СхемыНет Тогда
		Возврат Вердикты.ОтказСловами("URL должен содержать схему (https://…)");
	ИначеЕсли Разбор.Код = Коды.ЧужаяСхема Тогда
		Возврат ?(Разбор.Схема = "http",
			Вердикты.ОтказСловами("Схема http запрещена — используйте https"),
			Вердикты.ОтказСловами(СтрШаблон("Недопустимая схема ""%1"" — только https", Разбор.Схема)));
	ИначеЕсли Разбор.Код = Коды.ДанныеПользователя Тогда
		Возврат Вердикты.ОтказСловами("userinfo в URL (user@host) не допускается");
	ИначеЕсли Разбор.Код = Коды.ХостаНет Тогда
		Возврат Вердикты.ОтказСловами("Не удалось определить хост в URL");
	КонецЕсли;

	Возврат Вердикты.УспехСловами();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Настройка спрашивается лениво: контейнер без модуля настроек живёт с https-адресами.
Функция HTTPРазрешён()
	Возврат Настройки.Флаг("oshub.webhooks.allow_insecure", Ложь);
КонецФункции

#КонецОбласти

&Прозвище("ВалидаторАдресаВебхука")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ФормаАдреса") _Форма = Неопределено)

	Форма = ?(_Форма = Неопределено, Новый ФормаАдреса(), _Форма);
	Настройки = _Настройки;
	Вердикты = Новый Вердикт();

КонецПроцедуры
