// Проверка целевого URL исходящего вебхука: разбирается ли присланная строка как адрес.
// Куда этот адрес ведёт — дело того, кто заводит подписку, и здесь не судится.
// Плюс движок канонизации адресов: IPv4 в любой inet_aton-форме, IPv6 (включая mapped,
// compat и NAT64) и резолв DNS-имён. Сам вебхук движком больше не пользуется — его
// переиспользуют валидаторы адресов апстрима и провайдера входа.

Перем Разрешитель;     // РазрешительImён (подписки) — DI-шов резолва DNS
Перем Настройки;       // СервисНастроек (настройки) — допускать ли http
Перем Адреса;        // РазборАдреса (основа)

#Область ПубличныйИнтерфейс

// Проверяет, разбирается ли строка как адрес доставки вебхука. Отвергается только то,
// что адресом не является: пустая строка, управляющие символы, чужая схема, userinfo,
// отсутствующий хост. Сеть назначения не проверяется. Исключений не бросает.
//
// Параметры:
//  URL - Строка - целевой адрес.
//
// Возвращаемое значение:
//  Структура - Ок (Булево) и Ошибка (Строка) с причиной отказа.
//
Функция Проверить(Знач URL) Экспорт

	Значение = СокрЛП(Строка(URL));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Отказ("Пустой URL");
	КонецЕсли;

	// Управляющие символы и пробелы — отказ: адрес приезжает из формы раскодированным,
	// и «%0D%0AX-Evil:+1» доходит сюда настоящими CR/LF (инъекция в лог и в заголовки).
	Управляющий = НайтиУправляющий(Значение);
	Если ЗначениеЗаполнено(Управляющий) Тогда
		Возврат Отказ(СтрШаблон(
			"URL содержит недопустимый символ (%1) — управляющие символы и пробелы"
			+ " должны быть закодированы (%%20, %%0D…)", Управляющий));
	КонецЕсли;

	Позиция = Найти(Значение, "://");
	Если Позиция = 0 Тогда
		Возврат Отказ("URL должен содержать схему (https://…)");
	КонецЕсли;

	Схема = НРег(Лев(Значение, Позиция - 1));
	Остаток = Сред(Значение, Позиция + 3);

	Если Схема = "http" Тогда
		Если НЕ Настройки.Значение("oshub.webhooks.allow_insecure") = Истина Тогда
			Возврат Отказ("Схема http запрещена — используйте https");
		КонецЕсли;
	ИначеЕсли Схема <> "https" Тогда
		Возврат Отказ(СтрШаблон("Недопустимая схема ""%1"" — только https", Схема));
	КонецЕсли;

	Авторитет = Адреса.Авторитет(Остаток);
	Если Найти(Авторитет, "@") > 0 Тогда
		Возврат Отказ("userinfo в URL (user@host) не допускается");
	КонецЕсли;

	Хост = НРег(Адреса.Хост(Авторитет));
	Если НЕ ЗначениеЗаполнено(Хост) Тогда
		Возврат Отказ("Не удалось определить хост в URL");
	КонецЕсли;

	Возврат Ок();

КонецФункции

#КонецОбласти

#Область КлассификацияХоста

// Приватен ли хост по результату канонизации и резолва: loopback, private, link-local,
// ULA, «this-host» либо CGNAT — как IP-литерал или как имя, резолвящееся в такой адрес.
// При недоступном резолве имя приватным не признаётся. Сам вебхук этим не пользуется:
// куда он идёт, решает человек. Спрашивают валидаторы апстрима и провайдера входа.
//
// Параметры:
//  Хост - Строка - хост без скобок и порта.
//
// Возвращаемое значение:
//  Булево - Истина, если хост разрешается в приватный либо служебный адрес.
//
Функция ХостПриватный(Знач Хост) Экспорт

	Х = НРег(СокрЛП(Строка(Хост)));

	Если Х = "localhost" ИЛИ Адреса.ЗаканчиваетсяНа(Х, ".localhost") Тогда
		Возврат Истина;
	КонецЕсли;

	Если Найти(Х, ":") > 0 Тогда
		Возврат IPv6Приватный(Х);
	КонецЕсли;

	N = РазобратьIPv4Литерал(Х);
	Если N <> Неопределено Тогда
		Возврат IPv4Приватный(N);
	КонецЕсли;

	Разрешённые = Разрешитель.Разрешить(Х);
	Если Разрешённые <> Неопределено Тогда
		Для Каждого Адрес Из Разрешённые Цикл
			Если АдресПриватный(Адрес) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция АдресПриватный(Знач Адрес)
	Норм = НРег(СокрЛП(Строка(Адрес)));
	Если Найти(Норм, ":") > 0 Тогда
		Возврат IPv6Приватный(Норм);
	КонецЕсли;
	N = РазобратьIPv4Литерал(Норм);
	Если N = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат IPv4Приватный(N);
КонецФункции

#КонецОбласти

#Область IPv4

// Разбирает IPv4-литерал в любой форме inet_aton: dotted-quad, decimal, hex, octal,
// сокращённые 1–3 части.
//
// Параметры:
//  Хост - Строка - хост без скобок и порта.
//
// Возвращаемое значение:
//  Число, Неопределено - 32-битный адрес; Неопределено, если это не IPv4-литерал
//  и хост следует считать DNS-именем.
//
Функция РазобратьIPv4Литерал(Знач Хост) Экспорт

	Части = СтрРазделить(Хост, ".", Ложь);
	Кол = Части.Количество();
	Если Кол < 1 ИЛИ Кол > 4 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значения = Новый Массив();
	Для Каждого Часть Из Части Цикл
		V = ПарсеЦелоеСБазой(Часть);
		Если V = Неопределено Тогда
			Возврат Неопределено; // нечисловая часть → это не IPv4-литерал
		КонецЕсли;
		Значения.Добавить(V);
	КонецЦикла;

	// Компоновка по inet_aton: последняя часть занимает «хвост» адреса.
	Если Кол = 4 Тогда
		Если Превышает(Значения, 0, 255) ИЛИ Превышает(Значения, 1, 255)
			ИЛИ Превышает(Значения, 2, 255) ИЛИ Превышает(Значения, 3, 255) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Значения[0]*16777216 + Значения[1]*65536 + Значения[2]*256 + Значения[3];
	ИначеЕсли Кол = 3 Тогда
		Если Превышает(Значения, 0, 255) ИЛИ Превышает(Значения, 1, 255) ИЛИ Превышает(Значения, 2, 65535) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Значения[0]*16777216 + Значения[1]*65536 + Значения[2];
	ИначеЕсли Кол = 2 Тогда
		Если Превышает(Значения, 0, 255) ИЛИ Превышает(Значения, 1, 16777215) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Значения[0]*16777216 + Значения[1];
	Иначе
		Если Значения[0] > 4294967295 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Значения[0];
	КонецЕсли;

КонецФункции

Функция Превышает(Знач Массив_, Знач Индекс, Знач Макс)
	Возврат Массив_[Индекс] > Макс;
КонецФункции

// Loopback, private, link-local, this-host и CGNAT.
Функция IPv4Приватный(Знач N)

	О1 = Цел(N / 16777216);
	Ост = N - О1*16777216;
	О2 = Цел(Ост / 65536);

	Если О1 = 127 ИЛИ О1 = 0 ИЛИ О1 = 10 Тогда
		Возврат Истина; // loopback / «this host» / private-A
	КонецЕсли;
	Если О1 = 192 И О2 = 168 Тогда
		Возврат Истина; // private-C
	КонецЕсли;
	Если О1 = 169 И О2 = 254 Тогда
		Возврат Истина; // link-local (вкл. cloud metadata 169.254.169.254)
	КонецЕсли;
	Если О1 = 172 И О2 >= 16 И О2 <= 31 Тогда
		Возврат Истина; // private-B
	КонецЕсли;
	Если О1 = 100 И О2 >= 64 И О2 <= 127 Тогда
		Возврат Истина; // CGNAT 100.64/10
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// База по префиксу: 0x — hex, ведущий 0 — octal, иначе decimal.
Функция ПарсеЦелоеСБазой(Знач Строка_)

	S = НРег(СокрЛП(Строка_));
	Если НЕ ЗначениеЗаполнено(S) Тогда
		Возврат Неопределено;
	КонецЕсли;

	База = 10;
	Цифры = S;
	Если Лев(S, 2) = "0x" Тогда
		База = 16;
		Цифры = Сред(S, 3);
	ИначеЕсли СтрДлина(S) > 1 И Лев(S, 1) = "0" Тогда
		База = 8;
		Цифры = Сред(S, 2);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Цифры) Тогда
		Возврат ?(База = 8, 0, Неопределено); // "0" → 0
	КонецЕсли;

	Алфавит = Лев("0123456789abcdef", База);
	Значение = 0;
	Для Позиция = 1 По СтрДлина(Цифры) Цикл
		Ц = Найти(Алфавит, Сред(Цифры, Позиция, 1));
		Если Ц = 0 Тогда
			Возврат Неопределено; // цифра вне базы → не число
		КонецЕсли;
		Значение = Значение * База + (Ц - 1);
	КонецЦикла;
	Возврат Значение;

КонецФункции

#КонецОбласти

#Область КлассификацияДляАпстримов

// IPv4-адрес, вложенный в запись хоста: и обычный литерал в любой форме inet_aton,
// и IPv6-записи, которые на деле адресуют IPv4 — mapped, compat и NAT64.
//
// Параметры:
//  Хост - Строка - хост без скобок и порта.
//
// Возвращаемое значение:
//  Число, Неопределено - 32-битный вложенный IPv4 либо Неопределено.
//
Функция ВложенныйIPv4(Знач Хост) Экспорт

	H = НРег(СокрЛП(Строка(Хост)));
	ПозицияЗоны = Найти(H, "%");
	Если ПозицияЗоны > 0 Тогда
		H = Лев(H, ПозицияЗоны - 1);
	КонецЕсли;

	Если Найти(H, ":") = 0 Тогда
		Возврат РазобратьIPv4Литерал(H);
	КонецЕсли;

	// Точечную часть внутри IPv6 сворачиваем в два хекстета — однородное представление.
	Если Найти(H, ".") > 0 Тогда
		ПоследнееДвоеточие = ПоследняяПозиция(H, ":");
		Если ПоследнееДвоеточие = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		N = РазобратьIPv4Литерал(Сред(H, ПоследнееДвоеточие + 1));
		Если N = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Hi = Цел(N / 65536);
		Lo = N - Hi * 65536;
		H = Лев(H, ПоследнееДвоеточие) + ВHex(Hi) + ":" + ВHex(Lo);
	КонецЕсли;

	Хекстеты = РазвернутьIPv6(H);
	Если Хекстеты = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Mapped ::ffff:X:Y и compat ::X:Y.
	Если Хекстеты[0]=0 И Хекстеты[1]=0 И Хекстеты[2]=0 И Хекстеты[3]=0 И Хекстеты[4]=0 Тогда
		Если Хекстеты[5]=65535 Тогда
			Возврат Хекстеты[6]*65536 + Хекстеты[7]; // ::ffff:a.b.c.d — однозначно IPv4-mapped
		КонецЕсли;
		Если Хекстеты[5]=0 Тогда
			// Compat-ветка ::X:Y, но окрестность ::/128 из неё исключена: «::» и «::1» —
			// это unspecified и IPv6-loopback, а не IPv4, записанный через IPv6. Иначе
			// IPv6-only интранет-зеркало стало бы ненастраиваемым в принципе; приватность
			// ::/128 ловит IPv6Приватный отдельными ветками выше.
			Если Хекстеты[6] = 0 И Хекстеты[7] <= 1 Тогда
				Возврат Неопределено;
			КонецЕсли;
			Возврат Хекстеты[6]*65536 + Хекстеты[7];
		КонецЕсли;
	КонецЕсли;

	// NAT64 well-known prefix 64:ff9b::/96.
	Если Хекстеты[0]=100 И Хекстеты[1]=65435 И Хекстеты[2]=0 И Хекстеты[3]=0
		И Хекстеты[4]=0 И Хекстеты[5]=0 Тогда
		Возврат Хекстеты[6]*65536 + Хекстеты[7];
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Адресует ли хост link-local: IPv4 169.254.0.0/16, включая сервис метаданных облака
// 169.254.169.254, либо IPv6 fe80::/10. Проверяются все формы записи — литерал, mapped,
// compat, NAT64 и DNS-имя, резолвящееся в link-local.
//
// Параметры:
//  Хост - Строка - хост без скобок и порта.
//
// Возвращаемое значение:
//  Булево - Истина, если хост link-local.
//
Функция ХостLinkLocal(Знач Хост) Экспорт

	H = НРег(СокрЛП(Строка(Хост)));
	Если НЕ ЗначениеЗаполнено(H) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если АдресLinkLocal(H) Тогда
		Возврат Истина;
	КонецЕсли;

	// DNS-имя: правило не должно зависеть от того, литерал перед нами или имя.
	Если Найти(H, ":") = 0 И РазобратьIPv4Литерал(H) = Неопределено Тогда
		Разрешённые = Разрешитель.Разрешить(H);
		Если Разрешённые <> Неопределено Тогда
			Для Каждого Адрес Из Разрешённые Цикл
				Если АдресLinkLocal(НРег(СокрЛП(Строка(Адрес)))) Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция АдресLinkLocal(Знач Адрес)

	Вложенный = ВложенныйIPv4(Адрес);
	Если Вложенный <> Неопределено И IPv4LinkLocal(Вложенный) Тогда
		Возврат Истина;
	КонецЕсли;

	Если Найти(Адрес, ":") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Хост = Адрес;
	ПозицияЗоны = Найти(Хост, "%");
	Если ПозицияЗоны > 0 Тогда
		Хост = Лев(Хост, ПозицияЗоны - 1);
	КонецЕсли;

	Хекстеты = РазвернутьIPv6(Хост);
	Если Хекстеты = Неопределено Тогда
		Возврат Ложь; // малформ разберёт общий фильтр приватности (там fail-closed)
	КонецЕсли;

	Возврат Хекстеты[0] >= 65152 И Хекстеты[0] <= 65215; // fe80::/10

КонецФункции

// 169.254.0.0/16 для 32-битного IPv4.
Функция IPv4LinkLocal(Знач N)
	О1 = Цел(N / 16777216);
	О2 = Цел((N - О1 * 16777216) / 65536);
	Возврат О1 = 169 И О2 = 254;
КонецФункции

#КонецОбласти

#Область IPv6

// Loopback ::1, unspecified ::, link-local fe80::/10, ULA fc00::/7, mapped и compat
// формы IPv4. Малформированный литерал трактуется как приватный (fail-closed).
Функция IPv6Приватный(Знач Хост)

	H = НРег(СокрЛП(Строка(Хост)));
	// Снять zone id.
	ПозицияЗоны = Найти(H, "%");
	Если ПозицияЗоны > 0 Тогда
		H = Лев(H, ПозицияЗоны - 1);
	КонецЕсли;

	// Встроенный IPv4 проверяем как IPv4 и заменяем на два хекстета.
	Если Найти(H, ".") > 0 Тогда
		ПоследнееДвоеточие = ПоследняяПозиция(H, ":");
		Если ПоследнееДвоеточие = 0 Тогда
			Возврат Истина; // точки без двоеточий в IPv6 — малформ
		КонецЕсли;
		IPv4Часть = Сред(H, ПоследнееДвоеточие + 1);
		N = РазобратьIPv4Литерал(IPv4Часть);
		Если N = Неопределено Тогда
			Возврат Истина; // малформированный встроенный IPv4
		КонецЕсли;
		Если IPv4Приватный(N) Тогда
			Возврат Истина;
		КонецЕсли;
		Hi = Цел(N / 65536);
		Lo = N - Hi*65536;
		H = Лев(H, ПоследнееДвоеточие) + ВHex(Hi) + ":" + ВHex(Lo);
	КонецЕсли;

	Хекстеты = РазвернутьIPv6(H);
	Если Хекстеты = Неопределено Тогда
		Возврат Истина; // малформ → fail-closed
	КонецЕсли;

	ВсеНоль = Истина;
	Для Каждого X Из Хекстеты Цикл
		Если X <> 0 Тогда
			ВсеНоль = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ВсеНоль Тогда
		Возврат Истина; // ::
	КонецЕсли;

	Если Хекстеты[0]=0 И Хекстеты[1]=0 И Хекстеты[2]=0 И Хекстеты[3]=0
		И Хекстеты[4]=0 И Хекстеты[5]=0 И Хекстеты[6]=0 И Хекстеты[7]=1 Тогда
		Возврат Истина; // ::1 loopback
	КонецЕсли;

	Если Хекстеты[0] >= 65152 И Хекстеты[0] <= 65215 Тогда
		Возврат Истина; // fe80::/10 link-local (0xfe80..0xfebf)
	КонецЕсли;
	Если Хекстеты[0] >= 64512 И Хекстеты[0] <= 65023 Тогда
		Возврат Истина; // fc00::/7 ULA (0xfc00..0xfdff)
	КонецЕсли;

	// Mapped ::ffff:X:Y и compat ::X:Y — проверяем вложенный IPv4. Без guard N<>0/1:
	// connect(0.0.0.0) на Linux идёт на localhost, а 0.0.0.0/8 режет IPv4Приватный.
	Если Хекстеты[0]=0 И Хекстеты[1]=0 И Хекстеты[2]=0 И Хекстеты[3]=0 И Хекстеты[4]=0 Тогда
		Если Хекстеты[5]=65535 ИЛИ Хекстеты[5]=0 Тогда
			N = Хекстеты[6]*65536 + Хекстеты[7];
			Если IPv4Приватный(N) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// NAT64 64:ff9b::/96 — встроенный IPv4 в последних 32 битах.
	Если Хекстеты[0]=100 И Хекстеты[1]=65435 И Хекстеты[2]=0 И Хекстеты[3]=0
		И Хекстеты[4]=0 И Хекстеты[5]=0 Тогда
		N = Хекстеты[6]*65536 + Хекстеты[7];
		Если IPv4Приватный(N) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Массив из 8 хекстетов 0..65535; Неопределено — малформированный литерал.
Функция РазвернутьIPv6(Знач H)

	Если Найти(H, ":::") > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Найти(H, "::") > 0 Тогда
		Стороны = РазбитьОдин(H, "::");
		Левые = ХекстетыИзГруппы(Стороны.Лево);
		Правые = ХекстетыИзГруппы(Стороны.Право);
		Если Левые = Неопределено ИЛИ Правые = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Пропуск = 8 - (Левые.Количество() + Правые.Количество());
		Если Пропуск < 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Результат = Новый Массив();
		Для Каждого X Из Левые Цикл Результат.Добавить(X); КонецЦикла;
		Для Сч = 1 По Пропуск Цикл Результат.Добавить(0); КонецЦикла;
		Для Каждого X Из Правые Цикл Результат.Добавить(X); КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Группа = ХекстетыИзГруппы(H);
	Если Группа = Неопределено ИЛИ Группа.Количество() <> 8 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Группа;

КонецФункции

Функция ХекстетыИзГруппы(Знач Группа)
	Результат = Новый Массив();
	Если НЕ ЗначениеЗаполнено(Группа) Тогда
		Возврат Результат; // пустая сторона "::" → нет хекстетов
	КонецЕсли;
	Для Каждого Часть Из СтрРазделить(Группа, ":", Ложь) Цикл
		V = ПарсеHex4(Часть);
		Если V = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Результат.Добавить(V);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПарсеHex4(Знач Строка_)
	S = НРег(СокрЛП(Строка_));
	Если НЕ ЗначениеЗаполнено(S) ИЛИ СтрДлина(S) > 4 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Алфавит = "0123456789abcdef";
	Значение = 0;
	Для Позиция = 1 По СтрДлина(S) Цикл
		Ц = Найти(Алфавит, Сред(S, Позиция, 1));
		Если Ц = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Значение = Значение * 16 + (Ц - 1);
	КонецЦикла;
	Возврат Значение;
КонецФункции

Функция ВHex(Знач Значение)
	Алфавит = "0123456789abcdef";
	Н = Цел(Значение);
	Если Н = 0 Тогда
		Возврат "0";
	КонецЕсли;
	Результат = "";
	Пока Н > 0 Цикл
		Остаток = Н - Цел(Н/16)*16;
		Результат = Сред(Алфавит, Остаток + 1, 1) + Результат;
		Н = Цел(Н/16);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Ок()
	Возврат Новый Структура("Ок, Ошибка", Истина, "");
КонецФункции

Функция Отказ(Знач Причина)
	Возврат Новый Структура("Ок, Ошибка", Ложь, Причина);
КонецФункции

// Имя первого управляющего символа или пробела в строке. Возвращается именно имя:
// подставить CR/LF в текст ошибки значило бы повторить инъекцию, от которой защищаемся.
//
// Параметры:
//  Значение - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Строка - имя символа; пустая строка, если таких символов нет.
//
Функция НайтиУправляющий(Знач Значение) Экспорт

	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Позиция);
		Если Код = 32 Тогда
			Возврат "пробел";
		КонецЕсли;
		Если Код < 32 ИЛИ Код = 127 Тогда
			Возврат СтрШаблон("код %1", Формат(Код, "ЧГ=0; ЧН=0"));
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ПоследняяПозиция(Знач Строка_, Знач Подстрока)
	Возврат СтрНайти(Строка_, Подстрока, НаправлениеПоиска.СКонца);
КонецФункции

Функция РазбитьОдин(Знач Строка_, Знач Разделитель)
	П = Найти(Строка_, Разделитель);
	Возврат Новый Структура("Лево, Право",
		Лев(Строка_, П - 1), Сред(Строка_, П + СтрДлина(Разделитель)));
КонецФункции

#КонецОбласти

&Прозвище("ВалидаторАдресаВебхука")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазрешительImён") _Разрешитель,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "РазборАдреса") _Адреса = Неопределено)

	Адреса = ?(_Адреса = Неопределено, Новый РазборАдреса(), _Адреса);
	Разрешитель = _Разрешитель;
	Настройки = _Настройки;

КонецПроцедуры
