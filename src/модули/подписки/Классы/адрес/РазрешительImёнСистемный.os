// SSRF-защита: резолвит DNS-имя цели вебхука в IP-адреса, чтобы валидатор проверял
// результат разрешения, а не доверял строке имени. OneScript не экспонирует DNS отдельным
// примитивом, поэтому имя разрешается системным резолвером через python3/getaddrinfo.
// Имя перед подстановкой в shell ограничивается набором [a-z0-9.-].

Перем Числа;       // ПриведениеЧисел (основа)
Перем Включён;
Перем ТаймаутСек;
Перем ПутьПоследнегоСкрипта;
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Разрешает DNS-имя в список IP-адресов.
//
// Параметры:
//  Хост - Строка - DNS-имя; IP-литералы сюда не попадают.
//
// Возвращаемое значение:
//  Массив, Неопределено - адреса (Строка); Неопределено, если резолв выключен,
//  недоступен, истёк таймаут, вернул ошибку либо имя содержит недопустимые символы.
//
Функция Разрешить(Знач Хост) Экспорт

	Если НЕ Включён Тогда
		Возврат Неопределено;
	КонецЕсли;

	Имя = НРег(СокрЛП(Строка(Хост)));
	Если НЕ БезопасноеИмя(Имя) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат ВыполнитьРезолв(Имя);
	Исключение
		Предупредить(СтрШаблон("Резолв имени ""%1"" не удался: %2", Имя,
			СтрЗаменить(ОписаниеОшибки(), Символы.ПС, " ")));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Путь скрипта, которым выполнен последний резолв. Скрипт живёт во временном каталоге,
// общем для всех процессов машины, поэтому имя обязано быть своим на каждый вызов —
// иначе соседний хаб перезапишет его ровно в момент чтения интерпретатором.
//
// Возвращаемое значение:
//  Строка - путь; "" — резолвов ещё не было.
//
Функция ПутьСкриптаПоследнегоРезолва() Экспорт
	Возврат ?(ПутьПоследнегоСкрипта = Неопределено, "", ПутьПоследнегоСкрипта);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьРезолв(Знач Имя)

	ПутьПоследнегоСкрипта = ПолучитьИмяВременногоФайла("py");
	ФайлВывода = ПолучитьИмяВременногоФайла("txt");

	Попытка
		ЗаписатьСкриптРезолва(ПутьПоследнегоСкрипта);
		// пути в кавычках: временный каталог пользователя может содержать пробел
		Команда = СтрШаблон("/bin/sh -c ""python3 '%1' '%2' '%3' > '%4' 2>/dev/null""",
			ПутьПоследнегоСкрипта, Имя, Формат(ТаймаутСек, "ЧГ=0; ЧН=0"), ФайлВывода);
		КодВозврата = 0;
		ЗапуститьПриложение(Команда, , Истина, КодВозврата);
		Если КодВозврата = 0 Тогда
			Результат = ПрочитатьАдреса(ФайлВывода);
		Иначе
			Результат = Неопределено;
			Предупредить(СтрШаблон(
				"Резолв имени ""%1"" недоступен (код %2): нет python3, ошибка либо таймаут."
				+ " Адрес по РЕЗУЛЬТАТУ разрешения имени для него не проверен",
				Имя, Формат(КодВозврата, "ЧГ=0; ЧН=0")));
		КонецЕсли;
	Исключение
		Результат = Неопределено;
		Предупредить(СтрШаблон("Резолв имени ""%1"" сорвался: %2", Имя,
			СтрЗаменить(ОписаниеОшибки(), Символы.ПС, " ")));
	КонецПопытки;

	УдалитьТихо(ПутьПоследнегоСкрипта);
	УдалитьТихо(ФайлВывода); // без python3 файл создаёт сама оболочка перенаправлением

	Возврат Результат;

КонецФункции

// Лог приходит инъекцией в поле, а при прямом создании через `Новый` инъекция не доезжает:
// без этой проверки запись в лог рушила бы ровно тот путь, который обязан гасить сбои.
Процедура Предупредить(Знач Текст)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Лог.Предупреждение(Текст);

КонецПроцедуры

Процедура УдалитьТихо(Знач Путь)
	Попытка
		Если Новый Файл(Путь).Существует() Тогда
			УдалитьФайлы(Путь);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

Функция ПрочитатьАдреса(Знач ФайлВывода)

	Если НЕ Новый Файл(ФайлВывода).Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Чтение = Новый ЧтениеТекста(ФайлВывода, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Попытка УдалитьФайлы(ФайлВывода); Исключение КонецПопытки;

	Результат = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(Строка(Текст), Символы.ПС, Ложь) Цикл
		Адрес = СокрЛП(Строка_);
		Если ЗначениеЗаполнено(Адрес) Тогда
			Результат.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Только DNS-символы: буквы, цифры, точка, дефис — защита от shell-инъекции.
Функция БезопасноеИмя(Знач Имя)
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Разрешённые = "abcdefghijklmnopqrstuvwxyz0123456789.-";
	Для Позиция = 1 По СтрДлина(Имя) Цикл
		Если Найти(Разрешённые, Сред(Имя, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Процедура ЗаписатьСкриптРезолва(Знач ПутьСкрипта)
	Скрипт = "import socket,sys" + Символы.ПС
		+ "socket.setdefaulttimeout(float(sys.argv[2]))" + Символы.ПС
		+ "try:" + Символы.ПС
		+ "    ips=sorted({r[4][0].split('%')[0] for r in socket.getaddrinfo(sys.argv[1],None)})" + Символы.ПС
		+ "    print('\n'.join(ips))" + Символы.ПС
		+ "except Exception:" + Символы.ПС
		+ "    sys.exit(3)" + Символы.ПС;
	Зп = Новый ЗаписьТекста(ПутьСкрипта, КодировкаТекста.UTF8);
	Зп.Записать(Скрипт);
	Зп.Закрыть();
КонецПроцедуры

Функция ФлагИстина(Знач Значение, Знач Дефолт)
	Если Значение = Неопределено Тогда
		Возврат Дефолт;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Строка_ = НРег(СокрЛП(Строка(Значение)));
	Если НЕ ЗначениеЗаполнено(Строка_) Тогда
		Возврат Дефолт;
	КонецЕсли;
	Возврат Строка_ = "истина" ИЛИ Строка_ = "true" ИЛИ Строка_ = "1" ИЛИ Строка_ = "да";
КонецФункции

#КонецОбласти

// Параметр _Лог — второй вход для прямого создания через `Новый` вне контейнера ОСени:
// инъекция в поле до таких объектов не доезжает.
&Прозвище("РазрешительImён")
&Желудь
Процедура ПриСозданииОбъекта(
	&Деталька(Значение = "oshub.webhooks.resolve_enabled", ЗначениеПоУмолчанию = Истина) _Включён = Неопределено,
	&Деталька(Значение = "oshub.webhooks.resolve_timeout_sec", ЗначениеПоУмолчанию = 3) _Таймаут = Неопределено,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа = Неопределено,
	&Лог _Лог = Неопределено)

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

	Числа = ?(_Числа = Неопределено, Новый ПриведениеЧисел(), _Числа);
	Включён = ФлагИстина(_Включён, Истина);
	ТаймаутСек = Макс(1, Числа.ЧислоИлиДефолт(_Таймаут, 3));

КонецПроцедуры
