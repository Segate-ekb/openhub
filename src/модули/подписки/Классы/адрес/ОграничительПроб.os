// Потолок частоты пробных отправок подписки: скользящее окно в час на ключ. Живёт в памяти
// процесса — перезапуск потолок отпускает. Ключ с остывшим окном снимается с карты:
// счётчик помнит тех, кто пробовал за последний час, а не всех, кто пробовал когда-либо.

Перем Окна;        // Соответствие: ключ -> Массив из Дата (моменты проб в окне)
Перем Блокировка;  // БлокировкаРесурса
Перем Настройки;  // СервисНастроек (настройки) — потолок частоты проб
Перем ОкноСек;
Перем Строки;      // КанонСтроки (основа)

#Область ПубличныйИнтерфейс

// Засчитывает пробу по ключу. Превышение потолка бросает исключение с названной причиной:
// молчаливый отказ пользователь принял бы за сломанную кнопку.
//
// Параметры:
//  Ключ - Строка - что ограничиваем, например "подписка-17".
//  Момент - Дата - момент пробы (необязательный, по умолчанию текущий).
//
Процедура Потребовать(Знач Ключ, Знач Момент = Неопределено) Экспорт

	Сейчас = ?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент);
	Ждать = 0;

	Блокировка.Заблокировать();
	Попытка
		ЗабытьОстывшие(Сейчас);
		Окно = Свежие(Ключ, Сейчас);
		Если Окно.Количество() >= Потолок() Тогда
			Ждать = Макс(1, ОкноСек - (Сейчас - Окно[0]));
		Иначе
			Окно.Добавить(Сейчас);
		КонецЕсли;
		Окна.Вставить(Норм(Ключ), Окно);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Если Ждать > 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Пробных отправок этой подписки не больше %1 за час — попробуйте снова через %2 мин",
			Формат(Потолок(), "ЧГ=0; ЧН=0"), Формат(Цел((Ждать + 59) / 60), "ЧГ=0; ЧН=0"));
	КонецЕсли;

КонецПроцедуры

// Сколько ключей ограничитель сейчас считает. Ключ без свежих проб под счётом
// не числится: остывшее окно памяти процесса не занимает.
//
// Возвращаемое значение:
//  Число - ключей под счётом.
//
Функция КлючейПодСчётом() Экспорт

	Блокировка.Заблокировать();
	Попытка
		Итог = Окна.Количество();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Моменты окна, из которых выпали устаревшие. Зовётся под блокировкой.
Функция Свежие(Знач Ключ, Знач Сейчас)
	Возврат СвежиеИз(Окна.Получить(Норм(Ключ)), Сейчас);
КонецФункции

// Ключи, у которых в окне не осталось ни одной свежей пробы, карту не держат:
// иначе кнопка пробы копила бы по ключу на каждую подписку хаба. Зовётся под блокировкой.
Процедура ЗабытьОстывшие(Знач Сейчас)

	Оставшиеся = Новый Соответствие();
	Для Каждого Пара Из Окна Цикл
		Свежее = СвежиеИз(Пара.Значение, Сейчас);
		Если Свежее.Количество() > 0 Тогда
			Оставшиеся.Вставить(Пара.Ключ, Свежее);
		КонецЕсли;
	КонецЦикла;
	Окна = Оставшиеся;

КонецПроцедуры

Функция СвежиеИз(Знач Прежние, Знач Сейчас)

	Результат = Новый Массив();
	Если Прежние = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Отметка Из Прежние Цикл
		Если Сейчас - Отметка < ОкноСек Тогда
			Результат.Добавить(Отметка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Потолок спрашивается на каждой пробе: правка настройки действует без перезапуска.
Функция Потолок()
	Возврат Настройки.Целое("oshub.webhooks.test_max_per_hour", 10, 1);
КонецФункции

Функция Норм(Знач Ключ)
	Возврат Строки.Канон(Ключ);
КонецФункции

#КонецОбласти

&Прозвище("ОграничительПроб")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "КанонСтроки") _Строки = Неопределено)

	Строки = ?(_Строки = Неопределено, Новый КанонСтроки(), _Строки);
	Настройки = _Настройки;
	ОкноСек = 3600;
	Окна = Новый Соответствие();
	Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);

КонецПроцедуры
