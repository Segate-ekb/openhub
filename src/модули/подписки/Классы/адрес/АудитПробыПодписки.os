// Запись пробной отправки в журнал аудита. Ни адреса, ни секретов в детали не кладём:
// журнал читают шире, чем раздел подписок.

Перем Издатель;       // ИздательСобытий (события)
Перем ИменаЖурнала;   // ИмяОбъектаАудита (аудит) — вид объекта в журнале
Перем СобытиеЖурнала; // СобытиеАудита (аудит) — форма нагрузки записи

#Область ПубличныйИнтерфейс

// Пишет итог пробы в журнал аудита. Проба — исходящий запрос по требованию пользователя,
// и в журнале ей место.
//
// Параметры:
//  Подписка - Вебхук - запись подписки.
//  Кто - Строка - логин инициатора.
//  Итог - Структура - вердикт пробы (Успех, Код, Сообщение) от обработчика типа;
//         код — ответ цели, 0 у транспорта, который кодом не отвечает.
//  Момент - Дата - момент пробы.
//
Процедура Записать(Знач Подписка, Знач Кто, Знач Итог, Знач Момент) Экспорт

	Если Издатель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Детали = Новый Структура();
	Детали.Вставить("подписка", Цел(Подписка.Идентификатор));
	Детали.Вставить("тип", ТипДействия(Подписка));
	Детали.Вставить("итог", ?(Итог.Успех = Истина, "успех", "отказ"));
	Детали.Вставить("описание", Строка(Итог.Сообщение));
	// разбор инцидента упирается в вопрос «а что ответила цель»: 403 от прокси и 500
	// от самого приёмника читаются словами одинаково, а чинятся по-разному
	Детали.Вставить("код", Цел(Итог.Код));

	Данные = СобытиеЖурнала.Собрать(Кто, "проба.подписки",
		ИменаЖурнала.ПоТипу(Подписка.ТипОбъекта, Подписка.ОбъектИдентификатор), "", Детали);

	Издатель.Опубликовать(Издатель.ТипПробаПодписки(), Данные, Момент);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТипДействия(Знач Подписка)
	Тип = НРег(СокрЛП(Строка(Подписка.ТипДействия)));
	Возврат ?(ЗначениеЗаполнено(Тип), Тип, "вебхук");
КонецФункции

#КонецОбласти

&Прозвище("АудитПробыПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ИмяОбъектаАудита") _Имена,
	&Пластилин(Значение = "СобытиеАудита") _Событие,
	&Пластилин(Значение = "ИздательСобытий") _Издатель = Неопределено)

	Издатель = _Издатель;
	ИменаЖурнала = _Имена;
	СобытиеЖурнала = _Событие;

КонецПроцедуры
