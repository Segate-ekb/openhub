// Подписки, поправки и исключения удаляемых пула и пакета — реализация контрактов
// ПоследствияУдаленияПула и ПоследствияУдаленияПакета.

Перем ХранилищеВебхуков;  // ХранилищеВебхуков (подписки)
Перем Поправки;           // ХранилищеПоправокПодписок (подписки)
Перем Исключения;         // ХранилищеИсключенийПодписок (подписки)
Перем Снятие;             // СнятиеСтрок (данные) — снятие пачки строк со счётом

// Снимает подписки на пул, поправки пула и его пакетов и их исключения из деревьев получателей —
// в том числе поставленные к подпискам самого пула: сузить их и исключить из них можно было
// только его пакеты.
//
// Параметры:
//  Пул - Пул - удаляемый пул.
//
// Возвращаемое значение:
//  Структура - Подписок (Число), Строк (Число).
//
Функция СнятьСтрокиПула(Знач Пул) Экспорт

	Подписок = Снятие.Снять(ХранилищеВебхуков.ПолучитьПоОбъекту("пул", Цел(Пул.Идентификатор)));
	ПоправокСнято = Снятие.Снять(Поправки.ПоПулу(Пул.Идентификатор));
	ИсключенийСнято = Снятие.Снять(Исключения.ПоПулу(Пул.Идентификатор));
	Возврат Новый Структура("Подписок, Строк", Подписок, Подписок + ПоправокСнято + ИсключенийСнято);

КонецФункции

// Снимает подписки на пакет, поправки, которые пакет поставил к подпискам сверху, и его исключения
// из деревьев получателей.
//
// Параметры:
//  Пакет - Пакет - удаляемый пакет.
//
// Возвращаемое значение:
//  Число - сколько строк снято.
//
Функция СнятьСтрокиПакета(Знач Пакет) Экспорт
	Возврат Снятие.Снять(ХранилищеВебхуков.ПолучитьПоОбъекту("пакет", Цел(Пакет.Идентификатор)))
		+ Снятие.Снять(Поправки.ПоОбъекту("пакет", Пакет.Идентификатор))
		+ Снятие.Снять(Исключения.ПоОбъекту("пакет", Пакет.Идентификатор));
КонецФункции

&Прозвище("ПоследствияУдаленияПула")
&Прозвище("ПоследствияУдаленияПакета")
&Порядок(30)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеВебхуков") _ХранилищеВебхуков,
	&Пластилин(Значение = "ХранилищеПоправокПодписок") _Поправки,
	&Пластилин(Значение = "ХранилищеИсключенийПодписок") _Исключения,
	&Пластилин(Значение = "СнятиеСтрок") _Снятие)

	ХранилищеВебхуков = _ХранилищеВебхуков;
	Поправки = _Поправки;
	Исключения = _Исключения;
	Снятие = _Снятие;

КонецПроцедуры
