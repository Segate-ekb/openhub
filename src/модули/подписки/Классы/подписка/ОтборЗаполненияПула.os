// Отбор подписок для события заполнения пула: у каждой свой порог, а правило «пора ли
// слать» — общее на весь хаб и принадлежит ЗаполнениюПула.

Перем Параметры;    // ПараметрыПодписки (подписки)
Перем Заполнение;   // ЗаполнениеПула (основа)
Перем Издатель;     // ИздательСобытий (события) — источник имени типа
Перем ЧтениеПолей;   // ЧтениеПолей (основа)

#Область ПубличныйИнтерфейс

// Доставлять ли это событие этой подписке.
//
// Параметры:
//  Подписка - Вебхук - запись подписки.
//  Событие - Структура - Тип, Когда, Данные (Процент, ПроцентДо).
//
// Возвращаемое значение:
//  Булево.
//
Функция Доставлять(Знач Подписка, Знач Событие) Экспорт

	Если НРег(СокрЛП(Строка(Событие.Тип))) <> Издатель.ТипПулЗаполнен() Тогда
		Возврат Истина;
	КонецЕсли;

	Порог = Параметры.Значение(Подписка, Издатель.ТипПулЗаполнен());
	Если Порог = Неопределено Тогда
		Возврат Истина; // каталог параметра не объявил — порогу неоткуда взяться
	КонецЕсли;

	Возврат Заполнение.НужноСлать(Порог,
		Поле(Событие.Данные, "ПроцентДо"), Поле(Событие.Данные, "Процент"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Поле(Знач Данные, Знач Имя)
	Возврат ЧтениеПолей.Поле(Данные, Имя, 0);
КонецФункции

#КонецОбласти

&Прозвище("ОтборЗаполненияПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПараметрыПодписки") _Параметры,
	&Пластилин(Значение = "ЗаполнениеПула") _Заполнение,
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "ЧтениеПолей") _ЧтениеПолей = Неопределено)

	ЧтениеПолей = ?(_ЧтениеПолей = Неопределено, Новый ЧтениеПолей(), _ЧтениеПолей);

	Параметры = _Параметры;
	Заполнение = _Заполнение;
	Издатель = _Издатель;

КонецПроцедуры
