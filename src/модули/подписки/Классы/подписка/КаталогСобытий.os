// Перечень событий хаба: какие события существуют, как называются по-человечески и на какие
// из них пользователь вправе подписаться. Описания даёт каждый предмет о своих событиях.

Перем Записи;      // Массив из Структура; порядок значим — он же порядок в UI
Перем Индекс;      // Соответствие: Тип -> Структура
Перем Строки;      // КанонСтроки (основа)

#Область ПубличныйИнтерфейс

// Полный перечень событий хаба в стабильном порядке.
//
// Возвращаемое значение:
//  Массив - структуры {Тип, Подпись, Пояснение, ДляПодписки, ПочемуВнутреннее, Параметр}.
//
Функция Все() Экспорт
	Возврат Записи;
КонецФункции

// Есть ли тип события в перечне.
//
// Параметры:
//  Тип - Строка - имя типа события.
//
// Возвращаемое значение:
//  Булево - Истина, если тип объявлен в перечне.
//
Функция Содержит(Знач Тип) Экспорт
	Возврат Индекс.Получить(Ключ(Тип)) <> Неопределено;
КонецФункции

// Запись перечня по типу события.
//
// Параметры:
//  Тип - Строка - имя типа события.
//
// Возвращаемое значение:
//  Структура, Неопределено - запись перечня либо Неопределено для неизвестного типа.
//
Функция Запись(Знач Тип) Экспорт
	Возврат Индекс.Получить(Ключ(Тип));
КонецФункции

// Типы событий, на которые пользователь вправе подписаться, в порядке перечня.
//
// Возвращаемое значение:
//  Массив - имена типов событий (Строка).
//
Функция ТипыДляПодписки() Экспорт

	Результат = Новый Массив();
	Для Каждого Элемент Из Записи Цикл
		Если Элемент.ДляПодписки Тогда
			Результат.Добавить(Элемент.Тип);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Доступно ли событие для подписки пользователя.
//
// Параметры:
//  Тип - Строка - имя типа события.
//
// Возвращаемое значение:
//  Булево - Истина, если на событие можно подписаться; для неизвестного типа Ложь.
//
Функция ДоступноДляПодписки(Знач Тип) Экспорт

	Элемент = Запись(Тип);
	Возврат Элемент <> Неопределено И Элемент.ДляПодписки;

КонецФункции

// Описание параметра, который подписка вправе задать этому событию.
//
// Параметры:
//  Тип - Строка - имя типа события.
//
// Возвращаемое значение:
//  Структура, Неопределено - Имя (Строка), Минимум, Максимум, ПоУмолчанию (Число);
//                            Неопределено, если параметра у события нет.
//
Функция ПараметрПодписки(Знач Тип) Экспорт

	Элемент = Запись(Тип);
	Возврат ?(Элемент = Неопределено, Неопределено, Элемент.Параметр);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Ключ(Знач Тип)
	Возврат Строки.Канон(Тип);
КонецФункции

// Повторный тип роняет сборку желудя: дубль означал бы два описания одного события.
Процедура Добавить(Знач Описание)

	Если Индекс.Получить(Ключ(Описание.Тип)) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон("Каталог событий: тип ""%1"" объявлен дважды", Описание.Тип);
	КонецЕсли;

	Записи.Добавить(Описание);
	Индекс.Вставить(Ключ(Описание.Тип), Описание);

КонецПроцедуры

#КонецОбласти

&Прозвище("КаталогСобытий")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОписанияСобытий", Тип = "Массив") _Предметы,
	&Пластилин(Значение = "КанонСтроки") _Строки = Неопределено)

	Строки = ?(_Строки = Неопределено, Новый КанонСтроки(), _Строки);
	Записи = Новый Массив();
	Индекс = Новый Соответствие();

	Для Каждого Предмет Из _Предметы Цикл
		Для Каждого Описание Из Предмет.Объявления().События() Цикл
			Добавить(Описание);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры
