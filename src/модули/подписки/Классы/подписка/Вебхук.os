// Сущность "Вебхук" — подписка объекта (хаб · пул · пакет) на доменные события.
// Тип действия («вебхук» | «telegram» | …) задаёт обработчик; пусто — «вебхук».

&Идентификатор
&ГенерируемоеЗначение
&Колонка(Тип = "Целое")
Перем Идентификатор Экспорт;

// тип объекта-владельца подписки: "хаб" | "пул" | "пакет"
&Колонка
Перем ТипОбъекта Экспорт;

// идентификатор объекта-владельца (0 для «хаб» — объект глобальный)
&Колонка(Тип = "Целое")
Перем ОбъектИдентификатор Экспорт;

// пул-контейнер подписки (скоуп приватности; 0 для подписки хаба)
&Колонка(Тип = "Целое")
Перем ПулИдентификатор Экспорт;

// тип действия подписки: "вебхук" | "telegram" | …; пусто — «вебхук»
&Колонка
Перем ТипДействия Экспорт;

// адрес действия: для вебхука — целевой https-URL, для telegram — chat_id
&Колонка
Перем URL Экспорт;

// секрет для HMAC-SHA256 подписи тела доставки (типы без подписи — "")
&Колонка
Перем Секрет Экспорт;

// дополнительные настройки действия (JSON; "" — нет)
&Колонка
Перем НастройкиДействия Экспорт;

// токен транспорта действия (для telegram — токен бота); "" — токен инсталляции
&Колонка
Перем ТокенДействия Экспорт;

// шаблон текста уведомления для текстовых доставок; "" — текст по умолчанию
&Колонка
Перем ШаблонТекста Экспорт;

// набор типов событий через запятую (например "версия.опубликована,версия.отозвана")
&Колонка
Перем ТипыСобытий Экспорт;

// параметры подписки по типам событий (JSON вида {"пул.заполнен":{"порог":80}}; "" — нет)
&Колонка
Перем ПараметрыСобытийJSON Экспорт;

// активность подписки (выключенный вебхук не получает доставок)
&Колонка(Тип = "Булево")
Перем Активен Экспорт;

// кто создал вебхук (id пользователя; 0 — системно)
&Колонка(Тип = "Целое")
Перем СозданКем Экспорт;

&Колонка(Тип = "ДатаВремя")
Перем Создан Экспорт;

&Колонка(Тип = "ДатаВремя")
Перем Обновлён Экспорт;

&Сущность(ИмяТаблицы = "Вебхуки")
Процедура ПриСозданииОбъекта()
КонецПроцедуры
