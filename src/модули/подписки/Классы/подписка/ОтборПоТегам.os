// Отбор событий версии по тегам: перечень выбирают из тегов объекта подписки или поправки, версия
// проходит, если в момент события входит в состав хотя бы одного тега перечня у своего пакета.
// Действует только то из сохранённого, что есть среди тегов объекта сейчас; пустой перечень
// пропускает всё; события не о версии не судит.

Перем Каналы;        // КаналыПоУмолчанию (реестр) — каналы, в составе которых версия события
Перем Теги;          // СервисТегов (реестр) — имена тегов пула и пакета
Перем Издатель;      // ИздательСобытий (события) — типы событий версии
Перем ЧтениеПолей;   // ЧтениеПолей (основа)
Перем Строки;        // КанонСтроки (основа)

#Область ПубличныйИнтерфейс

// Теги, из которых выбирают отбор подписки или поправки объекта: у пула — теги пула, которые
// наследуют его пакеты; у пакета — его теги вместе с унаследованными, без выключенных. У хаба
// отбора по тегам нет.
//
// Параметры:
//  ТипОбъекта - Строка - "хаб" | "пул" | "пакет".
//  Идентификатор - Число - идентификатор пула или пакета.
//
// Возвращаемое значение:
//  Массив из Строка - имена в нижнем регистре в порядке показа; у хаба пустой.
//
Функция Доступные(Знач ТипОбъекта, Знач Идентификатор) Экспорт

	Тип = Строки.Канон(ТипОбъекта);
	Если Тип = "пул" Тогда
		Возврат Теги.ИменаТеговПула(Цел(Идентификатор));
	ИначеЕсли Тип = "пакет" Тогда
		Возврат Теги.ИменаТеговПакета(Цел(Идентификатор));
	КонецЕсли;
	Возврат Новый Массив();

КонецФункции

// Перечень тегов отбора из ввода — массива имён из тегов объекта (см. Доступные). Регистр
// и пробелы не значимы, повторы схлопываются. Бросает исключение на вводе не массивом, на
// имени не из тегов объекта и на любом отборе у хаба.
//
// Параметры:
//  Ввод - Массив из Строка, Неопределено - выбранные имена; пустая строка — то же, что пустой массив.
//  ТипОбъекта - Строка - "хаб" | "пул" | "пакет".
//  Идентификатор - Число - идентификатор пула или пакета.
//
// Возвращаемое значение:
//  Массив из Строка - имена в нижнем регистре в порядке тегов объекта.
//
Функция Перечень(Знач Ввод, Знач ТипОбъекта, Знач Идентификатор) Экспорт

	Выбранные = ВыбранныеИмена(Ввод);
	Если Выбранные.Количество() = 0 Тогда
		Возврат Выбранные;
	КонецЕсли;
	Если Строки.Канон(ТипОбъекта) = "хаб" Тогда
		ВызватьИсключение "У подписки хаба отбора по тегам нет: её сужают тегами пул и пакет поправкой снизу";
	КонецЕсли;

	ТегиОбъекта = Доступные(ТипОбъекта, Идентификатор);
	Для Каждого Имя Из Выбранные Цикл
		Если ТегиОбъекта.Найти(Имя) = Неопределено Тогда
			ВызватьИсключение ОтказИмени(Имя, ТипОбъекта, ТегиОбъекта);
		КонецЕсли;
	КонецЦикла;
	Возврат Пересечение(Выбранные, ТегиОбъекта);

КонецФункции

// Действующий отбор подписки или поправки — сохранённые имена, которые есть среди тегов её
// объекта сейчас. Тег удалили из пула или пакета — он из отбора выпадает; не осталось ни
// одного — отбор пуст. У подписки хаба отбора нет.
//
// Параметры:
//  Запись - Вебхук, ПоправкаПодписки - подписка или поправка: ТипОбъекта и ОбъектИдентификатор.
//  Сохранённый - Массив из Строка, Строка - сохранённый перечень; строкой — через запятую.
//  ТегиОбъектов - Соответствие, Неопределено - теги уже прочитанных объектов по ключу «тип#ид»:
//                 вызывающий держит их, чтобы прочитать теги объекта один раз на много записей;
//                 прочитанные сюда дописываются (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Массив из Строка - имена в порядке тегов объекта; без сохранённого отбора реестр не спрашивается.
//
Функция Действующий(Знач Запись, Знач Сохранённый, ТегиОбъектов = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(Сохранённый) Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат Пересечение(Сохранённый, ТегиЗаписи(Запись, ТегиОбъектов));

КонецФункции

// Выпавшие из отбора: сохранённые имена, которых среди тегов объекта подписки или поправки
// больше нет.
//
// Параметры:
//  Запись - Вебхук, ПоправкаПодписки - подписка или поправка: ТипОбъекта и ОбъектИдентификатор.
//  Сохранённый - Массив из Строка, Строка - сохранённый перечень; строкой — через запятую.
//
// Возвращаемое значение:
//  Массив из Строка - имена в порядке сохранения; без сохранённого отбора реестр не спрашивается.
//
Функция Выпавшие(Знач Запись, Знач Сохранённый) Экспорт

	Результат = Новый Массив();
	Если НЕ ЗначениеЗаполнено(Сохранённый) Тогда
		Возврат Результат;
	КонецЕсли;
	ТегиОбъекта = ТегиЗаписи(Запись);
	Для Каждого Имя Из Имена(Сохранённый) Цикл
		Если ТегиОбъекта.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Судит ли отбор по тегам событие этого типа: только события версии.
//
// Параметры:
//  ТипСобытия - Строка - тип события.
//
// Возвращаемое значение:
//  Булево.
//
Функция СудитСобытие(Знач ТипСобытия) Экспорт
	Возврат ТипыВерсии().Найти(Строки.Канон(ТипСобытия)) <> Неопределено;
КонецФункции

// Есть ли в наборе событие, которое отбор по тегам судит.
//
// Параметры:
//  ТипыСобытий - Строка - типы через запятую.
//
// Возвращаемое значение:
//  Булево.
//
Функция СудитНабор(Знач ТипыСобытий) Экспорт

	Для Каждого Тип Из СтрРазделить(Строка(ТипыСобытий), ",", Ложь) Цикл
		Если СудитСобытие(Тип) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Каналы пакета, в составе которых версия события в момент события, — свои теги пакета вместе
// с унаследованными от пула. Спрашиваются один раз на событие: подпискам хаба, пула и пакета
// версия одна.
//
// Параметры:
//  Событие - Структура - Тип, Когда, Данные (ПакетИдентификатор, Версия).
//
// Возвращаемое значение:
//  Массив из Строка - имена тегов в нижнем регистре; пустой у события без пакета или версии.
//
Функция КаналыСобытия(Знач Событие) Экспорт

	ПакетИдентификатор = Цел(ЧтениеПолей.Поле(Событие.Данные, "ПакетИдентификатор", 0));
	Версия = Строка(ЧтениеПолей.Поле(Событие.Данные, "Версия", ""));
	Если ПакетИдентификатор = 0 ИЛИ НЕ ЗначениеЗаполнено(Версия) Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат Каналы.КаналыВерсии(ПакетИдентификатор, Версия);

КонецФункции

// Пропускает ли перечень версию события.
//
// Параметры:
//  Перечень - Массив из Строка - имена тегов отбора (см. Перечень); пустой пропускает всё.
//  Событие - Структура - Тип, Когда, Данные.
//  КаналыВерсии - Массив из Строка - каналы, в составе которых версия события (см. КаналыСобытия).
//
// Возвращаемое значение:
//  Булево.
//
Функция Пропускает(Знач Перечень, Знач Событие, Знач КаналыВерсии) Экспорт

	Если Перечень.Количество() = 0 ИЛИ НЕ СудитСобытие(Событие.Тип) Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Имя Из Перечень Цикл
		Если КаналыВерсии.Найти(Строки.Канон(Имя)) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТегиЗаписи(Знач Запись, ТегиОбъектов = Неопределено)

	Ключ = СтрШаблон("%1#%2", Строки.Канон(Запись.ТипОбъекта), Формат(Запись.ОбъектИдентификатор, "ЧГ=0; ЧН=0"));
	ТегиОбъекта = ?(ТегиОбъектов = Неопределено, Неопределено, ТегиОбъектов.Получить(Ключ));
	Если ТегиОбъекта = Неопределено Тогда
		ТегиОбъекта = Доступные(Запись.ТипОбъекта, Запись.ОбъектИдентификатор);
	КонецЕсли;
	Если ТегиОбъектов <> Неопределено Тогда
		ТегиОбъектов.Вставить(Ключ, ТегиОбъекта);
	КонецЕсли;
	Возврат ТегиОбъекта;

КонецФункции

// Имена перечня, которые есть среди доступных, — в порядке доступных.
Функция Пересечение(Знач Перечень, Знач Доступные)

	Имена = Имена(Перечень);
	Результат = Новый Массив();
	Для Каждого Имя Из Доступные Цикл
		Если Имена.Найти(Строки.Канон(Имя)) <> Неопределено Тогда
			Результат.Добавить(Строки.Канон(Имя));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Отбор выбирают галками из тегов объекта: ввод строкой не принимается.
Функция ВыбранныеИмена(Знач Ввод)

	Если Ввод = Неопределено ИЛИ (ТипЗнч(Ввод) = Тип("Строка") И НЕ ЗначениеЗаполнено(СокрЛП(Ввод))) Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Если ТипЗнч(Ввод) <> Тип("Массив") Тогда
		ВызватьИсключение "Отбор по тегам — перечень имён из тегов пула или пакета, а не строка";
	КонецЕсли;
	Возврат Имена(Ввод);

КонецФункции

Функция Имена(Знач Перечень)

	Части = ?(ТипЗнч(Перечень) = Тип("Массив"), Перечень,
		СтрРазделить(Строка(?(Перечень = Неопределено, "", Перечень)), ",", Ложь));
	Результат = Новый Массив();
	Для Каждого Сырое Из Части Цикл
		Имя = Строки.Канон(Сырое);
		Если ЗначениеЗаполнено(Имя) И Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОтказИмени(Знач Имя, Знач ТипОбъекта, Знач Доступные)

	Чьи = ?(Строки.Канон(ТипОбъекта) = "пул", "пула", "пакета");
	Если Доступные.Количество() = 0 Тогда
		Возврат СтрШаблон("Тега «%1» нет: у %2 нет тегов для отбора", Имя, Чьи);
	КонецЕсли;
	Возврат СтрШаблон("Тега «%1» нет среди тегов %2: выберите из %3", Имя, Чьи, СтрСоединить(Доступные, ", "));

КонецФункции

Функция ТипыВерсии()

	Результат = Новый Массив();
	Результат.Добавить(Издатель.ТипВерсияОпубликована());
	Результат.Добавить(Издатель.ТипВерсияОтозвана());
	Результат.Добавить(Издатель.ТипВерсияВосстановлена());
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ОтборПоТегам")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаналыПоУмолчанию") _Каналы,
	&Пластилин(Значение = "СервисТегов") _Теги,
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "ЧтениеПолей") _ЧтениеПолей = Неопределено,
	&Пластилин(Значение = "КанонСтроки") _Строки = Неопределено)

	ЧтениеПолей = ?(_ЧтениеПолей = Неопределено, Новый ЧтениеПолей(), _ЧтениеПолей);
	Строки = ?(_Строки = Неопределено, Новый КанонСтроки(), _Строки);

	Каналы = _Каналы;
	Теги = _Теги;
	Издатель = _Издатель;

КонецПроцедуры
