// Отбор событий версии по тегам: версия проходит, если в момент события входит в состав хотя бы
// одного тега перечня у своего пакета. Пустой перечень пропускает всё; события не о версии не судит.

Перем Каналы;        // КаналыПоУмолчанию (реестр) — каналы, в составе которых версия события
Перем Теги;          // СервисТегов (реестр) — допустимость имени тега
Перем Издатель;      // ИздательСобытий (события) — типы событий версии
Перем ЧтениеПолей;   // ЧтениеПолей (основа)
Перем Строки;        // КанонСтроки (основа)

#Область ПубличныйИнтерфейс

// Перечень имён тегов из ввода: строкой через запятую либо массивом; регистр и пробелы
// не значимы, повторы схлопываются. Бросает исключение на недопустимом имени тега.
//
// Параметры:
//  Ввод - Строка, Массив, Неопределено - имена тегов.
//
// Возвращаемое значение:
//  Массив из Строка - имена в нижнем регистре в порядке ввода.
//
Функция Перечень(Знач Ввод) Экспорт

	Результат = Новый Массив();
	Для Каждого Сырое Из Части(Ввод) Цикл
		Имя = Строки.Канон(Сырое);
		Если НЕ ЗначениеЗаполнено(Имя) ИЛИ Результат.Найти(Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ Теги.ИмяДопустимо(Имя) Тогда
			ВызватьИсключение СтрШаблон(
				"Недопустимое имя тега «%1» в отборе: разрешены латиница, цифры, дефис,"
				+ " подчёркивание и точка", Имя);
		КонецЕсли;
		Результат.Добавить(Имя);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Судит ли отбор по тегам событие этого типа: только события версии.
//
// Параметры:
//  ТипСобытия - Строка - тип события.
//
// Возвращаемое значение:
//  Булево.
//
Функция СудитСобытие(Знач ТипСобытия) Экспорт
	Возврат ТипыВерсии().Найти(Строки.Канон(ТипСобытия)) <> Неопределено;
КонецФункции

// Есть ли в наборе событие, которое отбор по тегам судит.
//
// Параметры:
//  ТипыСобытий - Строка - типы через запятую.
//
// Возвращаемое значение:
//  Булево.
//
Функция СудитНабор(Знач ТипыСобытий) Экспорт

	Для Каждого Тип Из СтрРазделить(Строка(ТипыСобытий), ",", Ложь) Цикл
		Если СудитСобытие(Тип) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Каналы пакета, в составе которых версия события в момент события; каналы, которые заведёт
// автоматика нового пакета, — только на публикации. Спрашиваются один раз на событие:
// подпискам хаба, пула и пакета версия одна.
//
// Параметры:
//  Событие - Структура - Тип, Когда, Данные (ПакетИдентификатор, Версия).
//
// Возвращаемое значение:
//  Массив из Строка - имена тегов в нижнем регистре; пустой у события без пакета или версии.
//
Функция КаналыСобытия(Знач Событие) Экспорт

	ПакетИдентификатор = Цел(ЧтениеПолей.Поле(Событие.Данные, "ПакетИдентификатор", 0));
	Версия = Строка(ЧтениеПолей.Поле(Событие.Данные, "Версия", ""));
	Если ПакетИдентификатор = 0 ИЛИ НЕ ЗначениеЗаполнено(Версия) Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат Каналы.КаналыВерсии(ПакетИдентификатор, Версия,
		Строки.Канон(Событие.Тип) = Издатель.ТипВерсияОпубликована());

КонецФункции

// Пропускает ли перечень версию события.
//
// Параметры:
//  Перечень - Массив из Строка - имена тегов отбора (см. Перечень); пустой пропускает всё.
//  Событие - Структура - Тип, Когда, Данные.
//  КаналыВерсии - Массив из Строка - каналы, в составе которых версия события (см. КаналыСобытия).
//
// Возвращаемое значение:
//  Булево.
//
Функция Пропускает(Знач Перечень, Знач Событие, Знач КаналыВерсии) Экспорт

	Если Перечень.Количество() = 0 ИЛИ НЕ СудитСобытие(Событие.Тип) Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Имя Из Перечень Цикл
		Если КаналыВерсии.Найти(Строки.Канон(Имя)) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Части(Знач Ввод)

	Если ТипЗнч(Ввод) = Тип("Массив") Тогда
		Возврат Ввод;
	КонецЕсли;
	Возврат СтрРазделить(СтрЗаменить(Строка(?(Ввод = Неопределено, "", Ввод)), " ", ","), ",", Ложь);

КонецФункции

Функция ТипыВерсии()

	Результат = Новый Массив();
	Результат.Добавить(Издатель.ТипВерсияОпубликована());
	Результат.Добавить(Издатель.ТипВерсияОтозвана());
	Результат.Добавить(Издатель.ТипВерсияВосстановлена());
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ОтборПоТегам")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаналыПоУмолчанию") _Каналы,
	&Пластилин(Значение = "СервисТегов") _Теги,
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "ЧтениеПолей") _ЧтениеПолей = Неопределено,
	&Пластилин(Значение = "КанонСтроки") _Строки = Неопределено)

	ЧтениеПолей = ?(_ЧтениеПолей = Неопределено, Новый ЧтениеПолей(), _ЧтениеПолей);
	Строки = ?(_Строки = Неопределено, Новый КанонСтроки(), _Строки);

	Каналы = _Каналы;
	Теги = _Теги;
	Издатель = _Издатель;

КонецПроцедуры
