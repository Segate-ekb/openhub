// Доменный CRUD подписок объекта (хаб, пул, пакет): гейт прав на каждой мутации, уникальность
// адреса, набор типов событий по КаталогуСобытий и общие свойства подписки.

Перем ХранилищеВебхуков;    // ХранилищеВебхуков (подписки)
Перем СервисПользователей;  // СервисПользователей (вход) — авторы подписок хаба
Перем СервисПрав;           // СервисПрав (права)
Перем Реестр;               // РеестрДействийПодписок (подписки)
Перем Каталог;              // КаталогСобытий (подписки)
Перем ПараметрыПодписки;    // ПараметрыПодписки (подписки) — параметры событий подписки
Перем Издатель;             // ИздательСобытий (события) — тип события пробы
Перем Аудит;                // АудитПробыПодписки (подписки) — запись пробы в журнал
Перем Ограничитель;         // ОграничительПроб (подписки) — потолок частоты проб
Перем Тела;                 // ТелоСобытия (подписки) — тело пробы
Перем Числа;                // ПриведениеЧисел (основа)
Перем Адреса;               // РазборАдреса (основа) — канон адреса подписки
Перем ЧерезЗапятую;         // СписокЧерезЗапятую (основа)
Перем Поправки;             // ХранилищеПоправокПодписок (подписки) — уходят вместе с подпиской
Перем Исключения;           // ХранилищеИсключенийПодписок (подписки) — уходят вместе с подпиской
Перем ИсключенияВПоправках; // ХранилищеИсключенийВПоправках (подписки) — уходят вместе с подпиской
Перем ОтборТегов;           // ОтборПоТегам (подписки) — перечень тегов отбора
Перем Снятие;               // СнятиеСтрок (данные) — снятие поправок удалённой подписки

#Область ФабрикиОбъектов

// Описание объекта подписки «хаб».
//
// Возвращаемое значение:
//  Структура - описание объекта в формате СервисаПрав.
//
&Наблюдаемый
Функция ОбъектХаба() Экспорт
	Возврат СервисПрав.ОбъектХаб();
КонецФункции

// Описание объекта подписки «пул».
//
// Параметры:
//  Пул - Пул - сущность пула.
//
// Возвращаемое значение:
//  Структура - описание объекта в формате СервисаПрав.
//
&Наблюдаемый
Функция ОбъектПула(Знач Пул) Экспорт
	Возврат СервисПрав.ОбъектПул(Пул);
КонецФункции

// Описание объекта подписки «пакет».
//
// Параметры:
//  Пакет - Пакет - сущность пакета.
//
// Возвращаемое значение:
//  Структура - описание объекта в формате СервисаПрав.
//
&Наблюдаемый
Функция ОбъектПакета(Знач Пакет) Экспорт
	Возврат СервисПрав.ОбъектПакет(Пакет);
КонецФункции

#КонецОбласти

#Область ПубличныйИнтерфейс

// Типы событий, на которые можно подписаться. Источник истины — КаталогСобытий.
//
// Возвращаемое значение:
//  Массив - имена типов событий (Строка).
//
&Наблюдаемый
Функция ИзвестныеТипы() Экспорт
	Возврат Каталог.ТипыДляПодписки();
КонецФункции

// Тип действия записи подписки. Пустое значение старых строк читается как «вебхук».
//
// Параметры:
//  Подписка - Вебхук - запись подписки.
//
// Возвращаемое значение:
//  Строка - нормализованный тип действия.
//
Функция ТипДействияПодписки(Знач Подписка) Экспорт
	Тип = НРег(СокрЛП(Строка(Подписка.ТипДействия)));
	Возврат ?(ЗначениеЗаполнено(Тип), Тип, "вебхук");
КонецФункции

// Вправе ли пользователь распоряжаться подписками объекта. Небросающая пара
// к внутреннему гейту прав: экран спрашивает право заранее, чтобы не рисовать форму,
// которая гарантированно отобьётся.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - инициатор.
//  Объект - Структура - описание объекта.
//
// Возвращаемое значение:
//  Булево - Истина, если мутации подписок объекта разрешены.
//
&Наблюдаемый
Функция МожетУправлять(Знач Пользователь, Знач Объект) Экспорт

	Попытка
		ТребоватьПрава(Пользователь, Объект);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

// Все подписки объекта, включая неактивные.
//
// Параметры:
//  Объект - Структура - описание объекта.
//
// Возвращаемое значение:
//  Массив - записи подписок (Вебхук).
//
&Наблюдаемый
Функция Список(Знач Объект) Экспорт
	Возврат ХранилищеВебхуков.ПолучитьПоОбъекту(ТипОбъекта(Объект), Цел(Объект.Идентификатор));
КонецФункции

// Подписка объекта по идентификатору: подписка другого объекта для этого не существует.
//
// Параметры:
//  Объект - Структура - описание объекта.
//  Идентификатор - Число, Строка - идентификатор подписки.
//
// Возвращаемое значение:
//  Вебхук, Неопределено - Неопределено, если у объекта такой подписки нет.
//
Функция ПодпискаОбъекта(Знач Объект, Знач Идентификатор) Экспорт

	Подписка = ХранилищеВебхуков.ПолучитьОдноПоИдентификаторРавно(Цел(Идентификатор));
	Если Подписка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НРег(СокрЛП(Строка(Подписка.ТипОбъекта))) <> ТипОбъекта(Объект)
		ИЛИ Цел(Подписка.ОбъектИдентификатор) <> Цел(Объект.Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Подписка;

КонецФункции

// Создаёт подписку типа «вебхук» на объекте. Требует прав управления объектом.
// Возвращённая запись несёт секрет — показать его вызывающий обязан один раз.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание объекта.
//  URL - Строка - целевой адрес доставки.
//  ТипыСобытий - Строка - типы через запятую, подмножество ИзвестныеТипы.
//  Секрет - Строка - секрет подписи; пустой генерируется криптостойко
//           (необязательный, по умолчанию пустая строка).
//
// Возвращаемое значение:
//  Вебхук - созданная запись подписки.
//
&Наблюдаемый
Функция Создать(Знач Пользователь, Знач Объект, Знач URL, Знач ТипыСобытий, Знач Секрет = "") Экспорт

	Возврат СоздатьПодписку(Пользователь, Объект, "вебхук",
		Новый Структура("URL, Секрет", Строка(URL), Строка(Секрет)), ТипыСобытий);

КонецФункции

// Создаёт подписку с действием заданного типа на объекте. Требует прав управления
// объектом; валидацию и нормализацию ввода выполняет описание хранения типа. Бросает
// исключение на неизвестном типе, невалидном вводе, пустом наборе типов событий,
// исчерпанном лимите и дубле адреса.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание объекта.
//  ТипДействия - Строка - тип действия, например "вебхук" либо "telegram".
//  Ввод - Структура - настройки типа по контракту ПодготовитьНастройки его хранения.
//  ТипыСобытий - Строка - типы через запятую, подмножество ИзвестныеТипы.
//  ПараметрыСобытий - Соответствие, Неопределено - тип события -> сырое значение его
//                     параметра (необязательный, по умолчанию Неопределено — умолчания каталога).
//  Свойства - Структура, Неопределено - общие свойства подписки, любой ключ необязателен:
//             Название (Строка), СужениеРазрешено (Булево; у подписки пакета не бывает),
//             ОтборТегов (Массив из Строка — имена из тегов пула или пакета, см.
//             ОтборПоТегам.Перечень; у хаба и без событий версии в наборе — исключение)
//             (необязательный, по умолчанию Неопределено — свойств нет).
//
// Возвращаемое значение:
//  Вебхук - созданная запись подписки.
//
&Наблюдаемый
Функция СоздатьПодписку(Знач Пользователь, Знач Объект, Знач ТипДействия, Знач Ввод, Знач ТипыСобытий,
	Знач ПараметрыСобытий = Неопределено, Знач Свойства = Неопределено) Экспорт

	ТребоватьПрава(Пользователь, Объект);

	Тип = НРег(СокрЛП(Строка(ТипДействия)));
	Хранение = Реестр.Хранение(Тип);
	Если Хранение = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Неизвестный тип действия подписки «%1»", Тип);
	КонецЕсли;

	Настройки = Хранение.ПодготовитьНастройки(Ввод);
	НормТипы = НормализоватьТипы(ТипыСобытий);
	Если НЕ ЗначениеЗаполнено(НормТипы) Тогда
		ВызватьИсключение "Не выбран ни один допустимый тип событий";
	КонецЕсли;
	Общие = СвойстваИзВвода(Объект, НормТипы, Свойства, ПараметрыПодписки.ПустыеСвойства());

	// Числа подписок на объект хаб не ограничивает: их бывает по одной на каждый пакет.
	Существующие = Список(Объект);
	Для Каждого Подписка Из Существующие Цикл
		Если ТипДействияПодписки(Подписка) = Тип И ТотЖеАдрес(Подписка.URL, Настройки.Адрес) Тогда
			ВызватьИсключение "Подписка с этим адресом у объекта уже существует";
		КонецЕсли;
	КонецЦикла;

	Подписка = ХранилищеВебхуков.СоздатьЭлемент();
	Подписка.ТипОбъекта = ТипОбъекта(Объект);
	Подписка.ОбъектИдентификатор = Цел(Объект.Идентификатор);
	Подписка.ПулИдентификатор = Цел(Объект.ПулИдентификатор);
	Подписка.ТипДействия = Тип;
	Подписка.URL = Строка(Настройки.Адрес);
	Подписка.Секрет = Строка(Настройки.Секрет);
	Подписка.НастройкиДействия = Строка(Настройки.НастройкиДействия);
	// необязательная часть контракта хранения: тип, которому нечего класть, их не возвращает
	Подписка.ТокенДействия = Необязательное(Настройки, "ТокенДействия");
	Подписка.ШаблонТекста = Необязательное(Настройки, "ШаблонТекста");
	Подписка.ТипыСобытий = НормТипы;
	Подписка.ПараметрыСобытийJSON = ПараметрыПодписки.Собрать(НормТипы, ПараметрыСобытий, Общие);
	Подписка.Активен = Истина;
	Подписка.СозданКем = ?(Пользователь = Неопределено, 0, Цел(Пользователь.Идентификатор));
	Подписка.Создан = ТекущаяУниверсальнаяДата();
	Подписка.Обновлён = Подписка.Создан;
	Подписка.Сохранить();

	Возврат Подписка;

КонецФункции

// Значения полей подписки для формы правки: их состав знает описание хранения её типа.
// Секретов в ответе нет.
//
// Параметры:
//  Подписка - Вебхук - запись подписки.
//
// Возвращаемое значение:
//  Структура - значения по именам ввода; пустая, если тип правку не поддерживает.
//
&Наблюдаемый
Функция ЗначенияПравки(Знач Подписка) Экспорт

	Тип = ТипДействияПодписки(Подписка);
	Хранение = Реестр.Хранение(Тип);
	Если Хранение = Неопределено ИЛИ НЕ Реестр.ПравкаПоддержана(Тип) Тогда
		Возврат Новый Структура();
	КонецЕсли;
	Возврат Хранение.ЗначенияПравки(Подписка);

КонецФункции

// Поддерживает ли тип действия подписки правку существующей записи.
//
// Параметры:
//  Подписка - Вебхук - запись подписки.
//
// Возвращаемое значение:
//  Булево.
//
&Наблюдаемый
Функция МожноПравить(Знач Подписка) Экспорт
	Возврат Реестр.ПравкаПоддержана(ТипДействияПодписки(Подписка));
КонецФункции

// Правит подписку объекта: настройки её типа, набор событий и включённость. Требует прав
// управления объектом. Тип действия не меняется — смена транспорта это другая подписка.
// Бросает исключение на подмене типа, невалидном вводе, пустом наборе событий и дубле
// адреса; чужой идентификатор даёт Неопределено, а не отказ по правам.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание объекта.
//  Идентификатор - Число - идентификатор подписки.
//  ТипДействия - Строка - тип, который прислала форма (сверяется с записью).
//  Ввод - Структура - настройки типа по контракту ПодготовитьПравку его хранения.
//  ТипыСобытий - Строка - типы через запятую, подмножество ИзвестныеТипы.
//  Активен - Булево - новое состояние подписки.
//  ПараметрыСобытий - Соответствие, Неопределено - тип события -> сырое значение его
//                     параметра; событие, которого нет, оставляет прежнее значение
//                     (необязательный, по умолчанию Неопределено — параметры не меняются).
//  Свойства - Структура, Неопределено - общие свойства подписки, как у СоздатьПодписку;
//             ключ, которого нет, оставляет прежнее значение (необязательный, по умолчанию
//             Неопределено — свойства не меняются).
//
// Возвращаемое значение:
//  Структура, Неопределено - Подписка (Вебхук) и Секрет (Строка; заполнен, только если
//  выпущен новый и его нужно показать один раз); Неопределено, если подписки нет у объекта.
//
&Наблюдаемый
Функция ОбновитьПодписку(Знач Пользователь, Знач Объект, Знач Идентификатор,
	Знач ТипДействия, Знач Ввод, Знач ТипыСобытий, Знач Активен,
	Знач ПараметрыСобытий = Неопределено, Знач Свойства = Неопределено) Экспорт

	ТребоватьПрава(Пользователь, Объект);

	Подписка = ПодпискаОбъекта(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Тип = ТипДействияПодписки(Подписка);
	ПроверитьНеизменностьТипа(Тип, ТипДействия);

	Хранение = Реестр.Хранение(Тип);
	Если Хранение = Неопределено ИЛИ НЕ Реестр.ПравкаПоддержана(Тип) Тогда
		ВызватьИсключение СтрШаблон("Подписки типа «%1» правкой не меняются", Тип);
	КонецЕсли;

	Настройки = Хранение.ПодготовитьПравку(Ввод, Подписка);

	НормТипы = НормализоватьТипы(ТипыСобытий);
	Если НЕ ЗначениеЗаполнено(НормТипы) Тогда
		ВызватьИсключение "Не выбран ни один допустимый тип событий";
	КонецЕсли;
	Общие = СвойстваИзВвода(Объект, НормТипы, Свойства, ПрежниеСвойства(Подписка));

	Для Каждого Соседняя Из Список(Объект) Цикл
		Если Цел(Соседняя.Идентификатор) <> Цел(Подписка.Идентификатор)
			И ТипДействияПодписки(Соседняя) = Тип
			И ТотЖеАдрес(Соседняя.URL, Настройки.Адрес) Тогда
			ВызватьИсключение "Подписка с этим адресом у объекта уже существует";
		КонецЕсли;
	КонецЦикла;

	Подписка.URL = Строка(Настройки.Адрес);
	Подписка.Секрет = Строка(Настройки.Секрет);
	Подписка.НастройкиДействия = Строка(Настройки.НастройкиДействия);
	Подписка.ТокенДействия = Необязательное(Настройки, "ТокенДействия");
	Подписка.ШаблонТекста = Необязательное(Настройки, "ШаблонТекста");
	Подписка.ТипыСобытий = НормТипы;
	Подписка.ПараметрыСобытийJSON = ПараметрыПодписки.Собрать(НормТипы,
		ПоверхПрежних(ПараметрыПодписки.ВводСобытий(Подписка), ПараметрыСобытий), Общие);
	Подписка.Активен = (Активен = Истина);
	Подписка.Обновлён = ТекущаяУниверсальнаяДата();
	Подписка.Сохранить();

	Возврат Новый Структура("Подписка, Секрет", Подписка,
		?(Флаг(Настройки, "ПоказатьСекрет"), Строка(Подписка.Секрет), ""));

КонецФункции

// Поддерживает ли тип действия подписки пробную отправку.
//
// Параметры:
//  Подписка - Вебхук - запись подписки.
//
// Возвращаемое значение:
//  Булево.
//
&Наблюдаемый
Функция МожноПробовать(Знач Подписка) Экспорт
	Возврат Реестр.ПробаПоддержана(ТипДействияПодписки(Подписка));
КонецФункции

// Отправляет пробное уведомление СОХРАНЁННЫМИ настройками подписки: одна попытка, без
// очереди и ретраев, теми же проверками адреса, что и боевая доставка. Требует прав
// управления объектом; чужой идентификатор даёт Неопределено. Частота проб ограничена
// потолком, превышение бросает исключение с названной причиной. Результат пишется в аудит.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание объекта.
//  Идентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Структура, Неопределено - вердикт пробы: Успех (Булево), Код (Число) и Сообщение (Строка;
//  без секретов и без тела ответа цели); Неопределено, если подписки нет у этого объекта.
//
&Наблюдаемый
Функция Проверить(Знач Пользователь, Знач Объект, Знач Идентификатор) Экспорт

	ТребоватьПрава(Пользователь, Объект);

	Подписка = ПодпискаОбъекта(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Пробовать(Пользователь, Подписка, ХранениеПробы(ТипДействияПодписки(Подписка)),
		КлючПробыПодписки(Подписка));

КонецФункции

// Отправляет пробное уведомление настройками, ещё не сохранёнными: вводом формы заведения либо
// формы правки подписки. Ничего не заводит и не меняет — проба идёт временной подпиской в памяти;
// в остальном она та же, что проба сохранённой: одна попытка, проверки адреса боевой доставки,
// потолок частоты, запись в аудит. Ввод правки ложится поверх сохранённой подписки по правилам
// её хранения: пустое секретное поле — сохранённый секрет. Потолок незаведённой подписки
// считается на автора и объект, правки — на саму подписку.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание объекта.
//  Идентификатор - Число - подписка формы правки; 0 — форма заведения.
//  ТипДействия - Строка - тип действия формы.
//  Ввод - Структура - настройки типа: как у СоздатьПодписку для заведения, как у ОбновитьПодписку
//         для правки.
//
// Возвращаемое значение:
//  Структура, Неопределено - вердикт пробы, как у Проверить; Неопределено, если подписки правки
//  нет у этого объекта. Невалидный ввод, тип без пробы и превышение потолка — исключение.
//
&Наблюдаемый
Функция ПроверитьНастройки(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач ТипДействия,
	Знач Ввод) Экспорт

	ТребоватьПрава(Пользователь, Объект);

	Если Цел(Идентификатор) = 0 Тогда
		Тип = НРег(СокрЛП(Строка(ТипДействия)));
		Хранение = ХранениеПробы(Тип);
		Временная = ВременнаяПодписка(Объект, Тип, 0, Хранение.ПодготовитьНастройки(Ввод));
		Возврат Пробовать(Пользователь, Временная, Хранение, КлючПробыНезаведённой(Пользователь, Объект));
	КонецЕсли;

	Подписка = ПодпискаОбъекта(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Тип = ТипДействияПодписки(Подписка);
	ПроверитьНеизменностьТипа(Тип, ТипДействия);
	Если НЕ Реестр.ПравкаПоддержана(Тип) Тогда
		ВызватьИсключение СтрШаблон("Подписки типа «%1» правкой не меняются", Тип);
	КонецЕсли;

	Хранение = ХранениеПробы(Тип);
	Временная = ВременнаяПодписка(Объект, Тип, Подписка.Идентификатор,
		Хранение.ПодготовитьПравку(Ввод, Подписка));
	Возврат Пробовать(Пользователь, Временная, Хранение, КлючПробыПодписки(Подписка));

КонецФункции

// Включает или выключает подписку объекта. Требует прав управления объектом.
// Идемпотентна.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание объекта.
//  Идентификатор - Число - идентификатор подписки.
//  Активен - Булево - новое состояние подписки.
//
// Возвращаемое значение:
//  Булево - Истина, если подписка найдена в этом объекте и обновлена.
//
&Наблюдаемый
Функция Переключить(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Активен) Экспорт

	ТребоватьПрава(Пользователь, Объект);
	Подписка = ПодпискаОбъекта(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Подписка.Активен = (Активен = Истина);
	Подписка.Обновлён = ТекущаяУниверсальнаяДата();
	Подписка.Сохранить();
	Возврат Истина;

КонецФункции

// Удаляет подписку объекта вместе с поправками, которые к ней поставили нижестоящие объекты,
// исключёнными ими пакетами и исключениями из её дерева получателей. Требует прав управления объектом.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание объекта.
//  Идентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Булево - Истина, если подписка найдена в этом объекте и удалена.
//
&Наблюдаемый
Функция Удалить(Знач Пользователь, Знач Объект, Знач Идентификатор) Экспорт

	ТребоватьПрава(Пользователь, Объект);
	Подписка = ПодпискаОбъекта(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Снятие.Снять(Поправки.ПоПодписке(Подписка.Идентификатор));
	Снятие.Снять(Исключения.ПоПодписке(Подписка.Идентификатор));
	Снятие.Снять(ИсключенияВПоправках.ПоПодписке(Подписка.Идентификатор));
	ХранилищеВебхуков.Удалить(Подписка);
	Возврат Истина;

КонецФункции

// Активные подписки, которым адресовано событие. Системный путь: прав не проверяет.
// Скоуп доставки — подписки пула события, его пакета и хаба; событие одного пула не
// уходит подпискам другого пула или чужого пакета. У подписок хаба дополнительно
// сверяется, что заведший их субъект до сих пор администратор хаба (fail-closed).
//
// Параметры:
//  ПулИдентификатор - Число - пул события; 0, если событие вне скоупа пула.
//  ТипСобытия - Строка - тип доменного события.
//  ПакетИдентификатор - Число - пакет события; 0, если событие не о пакете
//                      (необязательный, по умолчанию 0).
//
// Возвращаемое значение:
//  Массив - записи подписок (Вебхук).
//
&Наблюдаемый
Функция АктивныеДляСобытия(Знач ПулИдентификатор,
	&АтрибутСпана("oshub.event.type") Знач ТипСобытия, Знач ПакетИдентификатор = 0) Экспорт

	Тип = НРег(СокрЛП(Строка(ТипСобытия)));
	Результат = Новый Массив();

	ДобавитьПодписанные(Результат, ОбъектХаба(), Тип, Истина);
	Если Цел(ПулИдентификатор) > 0 Тогда
		ДобавитьПодписанные(Результат, ОписаниеПула(ПулИдентификатор), Тип, Ложь);
	КонецЕсли;
	Если Цел(ПакетИдентификатор) > 0 Тогда
		ДобавитьПодписанные(Результат, ОписаниеПакета(ПакетИдентификатор, ПулИдентификатор), Тип, Ложь);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Одна попытка по настройкам подписки — сохранённой или временной: потолок, задание пробы, аудит.
// Тип уже проверен ХранениемПробы.
Функция Пробовать(Знач Пользователь, Знач Подписка, Знач Хранение, Знач КлючПотолка)

	Тип = ТипДействияПодписки(Подписка);

	Момент = ТекущаяУниверсальнаяДата();
	Ограничитель.Потребовать(КлючПотолка, Момент);
	Кто = ЛогинИнициатора(Пользователь);
	Задание = Новый Структура("ИдДоставки, ТипДействия, Действие, ТипСобытия, Тело, НомерПопытки, Проба",
		"test-" + Строка(Новый УникальныйИдентификатор()), Тип,
		Хранение.НастройкиДоставки(Подписка), Издатель.ТипПробаПодписки(),
		Тела.Проба(Издатель.ТипПробаПодписки(), Кто, Момент), 1, Истина);

	Итог = Реестр.Обработчик(Тип).Проба(Задание);
	Аудит.Записать(Подписка, Кто, Итог, Момент);
	Возврат Итог;

КонецФункции

// Подписка, которой нет в базе: поля записи, которые читают хранение типа и аудит пробы.
// Сохранить её нечем — у структуры нет записи.
Функция ВременнаяПодписка(Знач Объект, Знач Тип, Знач Идентификатор, Знач Настройки)

	Подписка = Новый Структура("Идентификатор, ТипОбъекта, ОбъектИдентификатор, ПулИдентификатор,"
		+ " ТипДействия, URL, Секрет, НастройкиДействия, ТокенДействия, ШаблонТекста",
		Цел(Идентификатор), ТипОбъекта(Объект), Цел(Объект.Идентификатор), Цел(Объект.ПулИдентификатор),
		Тип, Строка(Настройки.Адрес), Строка(Настройки.Секрет), Строка(Настройки.НастройкиДействия),
		Необязательное(Настройки, "ТокенДействия"), Необязательное(Настройки, "ШаблонТекста"));
	Возврат Подписка;

КонецФункции

// Хранение типа, который умеет пробу: без хранения, обработчика или пробы — названный отказ.
Функция ХранениеПробы(Знач Тип)

	Хранение = Реестр.Хранение(Тип);
	Если Хранение = Неопределено ИЛИ Реестр.Обработчик(Тип) = Неопределено
		ИЛИ НЕ Реестр.ПробаПоддержана(Тип) Тогда
		ВызватьИсключение СтрШаблон("Подписки типа «%1» пробной отправки не поддерживают", Тип);
	КонецЕсли;
	Возврат Хранение;

КонецФункции

Функция КлючПробыПодписки(Знач Подписка)
	Возврат "подписка-" + Формат(Цел(Подписка.Идентификатор), "ЧГ=0; ЧН=0");
КонецФункции

// Незаведённой подписки нет — потолок держит тот, кто пробует, на том объекте, где пробует.
Функция КлючПробыНезаведённой(Знач Пользователь, Знач Объект)
	Возврат СтрШаблон("незаведённая-%1-%2-%3", ЛогинИнициатора(Пользователь), ТипОбъекта(Объект),
		Формат(Цел(Объект.Идентификатор), "ЧГ=0; ЧН=0"));
КонецФункции

Процедура ПроверитьНеизменностьТипа(Знач Тип, Знач ТипДействия)

	Заявленный = НРег(СокрЛП(Строка(ТипДействия)));
	Если ЗначениеЗаполнено(Заявленный) И Заявленный <> Тип Тогда
		ВызватьИсключение СтрШаблон(
			"Тип действия подписки не меняется правкой (сейчас «%1»): заведите новую подписку", Тип);
	КонецЕсли;

КонецПроцедуры

Функция Необязательное(Знач Настройки, Знач Имя)
	Значение = Неопределено;
	Если Настройки.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Возврат "";
КонецФункции

// Системный путь зовёт сервис без пользователя: журналу аудита не место падать из-за пустого поля.
Функция ЛогинИнициатора(Знач Пользователь)
	Значение = Неопределено;
	Если Пользователь = Неопределено Тогда
		Возврат "anonymous";
	КонецЕсли;
	Попытка
		Значение = Пользователь.Логин;
	Исключение
		Возврат "anonymous";
	КонецПопытки;
	Возврат ?(ЗначениеЗаполнено(Значение), Строка(Значение), "anonymous");
КонецФункции

// Присланное ложится поверх прежнего: параметр события, которого правка не назвала, остаётся.
Функция ПоверхПрежних(Знач Прежние, Знач Присланные)
	Если Присланные <> Неопределено Тогда
		Для Каждого КиЗ Из Присланные Цикл
			Прежние.Вставить(НРег(СокрЛП(Строка(КиЗ.Ключ))), КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Прежние;
КонецФункции

// Ввод, которого нет, оставляет прежнее; сужать снизу подписку пакета некому, а отбор по тегам
// без событий версии отклоняется, а не теряется молча.
Функция СвойстваИзВвода(Знач Объект, Знач ТипыСобытий, Знач Ввод, Знач Прежние)

	Результат = Новый Структура("Название, СужениеРазрешено, ОтборТегов",
		Прежние.Название, Прежние.СужениеРазрешено, Прежние.ОтборТегов);
	Значение = Неопределено;
	Если Ввод <> Неопределено И Ввод.Свойство("Название", Значение) И Значение <> Неопределено Тогда
		Результат.Название = НазваниеИзВвода(Значение);
	КонецЕсли;
	Если Ввод <> Неопределено И Ввод.Свойство("СужениеРазрешено", Значение) И Значение <> Неопределено Тогда
		Результат.СужениеРазрешено = (Значение = Истина);
	КонецЕсли;
	Если Ввод <> Неопределено И Ввод.Свойство("ОтборТегов", Значение) И Значение <> Неопределено Тогда
		Результат.ОтборТегов = ОтборТегов.Перечень(Значение, ТипОбъекта(Объект), Объект.Идентификатор);
	КонецЕсли;

	Если ТипОбъекта(Объект) = "пакет" Тогда
		Результат.СужениеРазрешено = Ложь;
	КонецЕсли;
	Если Результат.ОтборТегов.Количество() > 0 И НЕ ОтборТегов.СудитНабор(ТипыСобытий) Тогда
		ВызватьИсключение "Отбор по тегам действует только на события версии: отметьте публикацию,"
			+ " отзыв или восстановление версии либо очистите перечень тегов";
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Из прежнего отбора остаются только теги, которые у объекта ещё есть.
Функция ПрежниеСвойства(Знач Подписка)
	Свойства = ПараметрыПодписки.Свойства(Подписка);
	Свойства.ОтборТегов = ОтборТегов.Действующий(Подписка, Свойства.ОтборТегов);
	Возврат Свойства;
КонецФункции

Функция НазваниеИзВвода(Знач Значение)

	Название = СокрЛП(Строка(Значение));
	Если СтрДлина(Название) > ПределНазвания() Тогда
		ВызватьИсключение СтрШаблон("Название подписки длиннее %1 знаков", ПределНазвания());
	КонецЕсли;
	Возврат Название;

КонецФункции

Функция ПределНазвания()
	Возврат 100;
КонецФункции

Функция Флаг(Знач Настройки, Знач Имя)
	Значение = Неопределено;
	Возврат Настройки.Свойство(Имя, Значение) И Значение = Истина;
КонецФункции

Процедура ДобавитьПодписанные(Результат, Знач Объект, Знач Тип, Знач ПроверятьАвтора)

	Подходящие = Новый Массив();
	Для Каждого Подписка Из Список(Объект) Цикл
		Если Подписка.Активен = Истина И ТипВНаборе(Подписка.ТипыСобытий, Тип) Тогда
			Подходящие.Добавить(Подписка);
		КонецЕсли;
	КонецЦикла;

	Если НЕ ПроверятьАвтора Тогда
		Для Каждого Подписка Из Подходящие Цикл
			Результат.Добавить(Подписка);
		КонецЦикла;
		Возврат;
	КонецЕсли;

	Авторы = АвторыПодписок(Подходящие);
	Для Каждого Подписка Из Подходящие Цикл
		Если СервисПрав.ПользовательАдмин(Авторы.Получить(Цел(Подписка.СозданКем))) Тогда
			Результат.Добавить(Подписка);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Авторы подписок одним разрезом; неназванный автор проверку на админа не проходит.
Функция АвторыПодписок(Знач Подписки)

	Номера = Новый Массив();
	Для Каждого Подписка Из Подписки Цикл
		Номер = Цел(Подписка.СозданКем);
		Если Номер > 0 И Номера.Найти(Номер) = Неопределено Тогда
			Номера.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;

	Попытка
		Возврат СервисПользователей.ПоИдентификаторам(Номера);
	Исключение
		Возврат АвторыПоодиночке(Номера);
	КонецПопытки;

КонецФункции

// Запасная дорога разреза: отказ чтения одной учётки гасит только её подписку.
Функция АвторыПоодиночке(Знач Номера)

	Результат = Новый Соответствие();
	Для Каждого Номер Из Номера Цикл
		Попытка
			Автор = СервисПользователей.ПоИдентификатору(Номер);
		Исключение
			Продолжить;
		КонецПопытки;
		Если Автор <> Неопределено Тогда
			Результат.Вставить(Номер, Автор);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// По идентификатору: на системном пути доставки сущностей на руках нет, а читать их — лишний запрос.
Функция ОписаниеПула(Знач ПулИдентификатор)
	Возврат СервисПрав.ОписаниеОбъекта("пул", Цел(ПулИдентификатор), Цел(ПулИдентификатор));
КонецФункции

Функция ОписаниеПакета(Знач ПакетИдентификатор, Знач ПулИдентификатор)
	Возврат СервисПрав.ОписаниеОбъекта("пакет", Цел(ПакетИдентификатор), Цел(ПулИдентификатор));
КонецФункции

// Описание может прийти и извне, от контроллера, поэтому нормализуем ещё раз.
Функция ТипОбъекта(Знач Объект)
	Возврат НРег(СокрЛП(Строка(Объект.ТипОбъекта)));
КонецФункции

// Гейт прав по типу объекта. Неизвестный тип — отказ (fail-closed).
Процедура ТребоватьПрава(Знач Пользователь, Знач Объект)

	Если Объект = Неопределено Тогда
		ВызватьИсключение "Объект подписки не задан";
	КонецЕсли;

	Тип = ТипОбъекта(Объект);

	Если Тип = "хаб" Тогда
		Если НЕ СервисПрав.ПользовательАдмин(Пользователь) Тогда
			ВызватьИсключение "Подписками хаба распоряжается только администратор хаба";
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Действие = ДействиеУправления(Тип);
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		ВызватьИсключение СтрШаблон("Подписки на объект типа ""%1"" не поддерживаются", Тип);
	КонецЕсли;

	Если НЕ СервисПрав.РазрешеноДействие(Пользователь, Действие, Объект) Тогда
		ВызватьИсключение СтрШаблон(
			"Недостаточно прав для управления подписками объекта (%1: требуется право ""%2"")",
			Тип, Действие);
	КонецЕсли;

КонецПроцедуры

// Какое право означает «распоряжаться подписками этого объекта».
Функция ДействиеУправления(Знач Тип)

	Если Тип = "пул" Тогда
		// Owner-уровень: publisher пула событиями пула не распоряжается.
		Возврат "удаление";
	КонецЕсли;
	Если Тип = "пакет" Тогда
		// «Управлять пакетом» в терминах модели прав; наследуется от пула.
		Возврат "изменение";
	КонецЕсли;
	Возврат "";

КонецФункции

// Недоступный для подписки тип бросает исключение, а не отбрасывается молча.
Функция НормализоватьТипы(Знач ТипыСобытий)

	Известные = ИзвестныеТипы();
	Запрошенные = Новый Соответствие();
	Для Каждого Норм Из ЧерезЗапятую.Разобрать(ТипыСобытий) Цикл
		Если Известные.Найти(Норм) = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Недоступный для подписки тип события ""%1""", Норм);
		КонецЕсли;
		Запрошенные.Вставить(Норм, Истина);
	КонецЦикла;

	Отобранные = Новый Массив();
	Для Каждого Тип Из Известные Цикл
		Если Запрошенные.Получить(Тип) = Истина Тогда
			Отобранные.Добавить(Тип);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Отобранные, ",");

КонецФункции

Функция ТипВНаборе(Знач CSV, Знач Тип)
	Возврат ЧерезЗапятую.Содержит(CSV, Тип);
КонецФункции

#КонецОбласти

// Дубль ищется по канону с обеих сторон: сохранённый адрес мог лечь в базу не каноничным.
Функция ТотЖеАдрес(Знач Сохранённый, Знач Новый_)
	Возврат Адреса.Каноничный(Сохранённый) = Адреса.Каноничный(Новый_);
КонецФункции

&Прозвище("СервисПодписок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеВебхуков") _ХранилищеВебхуков,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "РеестрДействийПодписок") _Реестр,
	&Пластилин(Значение = "КаталогСобытий") _Каталог,
	&Пластилин(Значение = "ПараметрыПодписки") _ПараметрыПодписки,
	&Пластилин(Значение = "АудитПробыПодписки") _Аудит,
	&Пластилин(Значение = "ОграничительПроб") _Ограничитель,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "ХранилищеПоправокПодписок") _Поправки,
	&Пластилин(Значение = "ХранилищеИсключенийПодписок") _Исключения,
	&Пластилин(Значение = "ХранилищеИсключенийВПоправках") _ИсключенияВПоправках,
	&Пластилин(Значение = "ОтборПоТегам") _ОтборТегов,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа = Неопределено,
	&Пластилин(Значение = "ИздательСобытий") _Издатель = Неопределено,
	&Пластилин(Значение = "ТелоСобытия") _Тела = Неопределено,
	&Пластилин(Значение = "РазборАдреса") _Адреса = Неопределено,
	&Пластилин(Значение = "СписокЧерезЗапятую") _ЧерезЗапятую = Неопределено,
	&Пластилин(Значение = "СнятиеСтрок") _Снятие = Неопределено)

	Если _СервисПользователей = Неопределено Тогда
		ВызватьИсключение "СервисПодписок не собран: нет службы учёток — авторов подписок хаба проверить нечем";
	КонецЕсли;

	ЧерезЗапятую = ?(_ЧерезЗапятую = Неопределено, Новый СписокЧерезЗапятую(), _ЧерезЗапятую);
	Снятие = ?(_Снятие = Неопределено, Новый СнятиеСтрок(), _Снятие);

	Числа = ?(_Числа = Неопределено, Новый ПриведениеЧисел(), _Числа);
	Адреса = ?(_Адреса = Неопределено, Новый РазборАдреса(), _Адреса);
	Издатель = _Издатель;
	Тела = _Тела;
	ХранилищеВебхуков = _ХранилищеВебхуков;
	СервисПользователей = _СервисПользователей;
	СервисПрав = _СервисПрав;
	Реестр = _Реестр;
	Каталог = _Каталог;
	ПараметрыПодписки = _ПараметрыПодписки;
	Аудит = _Аудит;
	Ограничитель = _Ограничитель;
	Поправки = _Поправки;
	Исключения = _Исключения;
	ИсключенияВПоправках = _ИсключенияВПоправках;
	ОтборТегов = _ОтборТегов;

КонецПроцедуры
