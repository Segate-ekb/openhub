// Доменный CRUD подписок объекта (хаб, пул, пакет): гейт прав на каждой мутации, лимит
// подписок на объект, уникальность адреса и набор типов событий по КаталогуСобытий.

Перем ХранилищеВебхуков;  // ХранилищеВебхуков (данные)
Перем ХранилищеПользователей; // ХранилищеПользователей (данные)
Перем СервисПрав;         // СервисПрав (auth)
Перем Реестр;             // РеестрДействийПодписок (подписки)
Перем Каталог;            // КаталогСобытий (события)
Перем Параметры;          // ПараметрыПодписки (подписки) — параметры событий подписки
Перем Издатель;           // ИздательСобытий (события) — тип события пробы
Перем Аудит;              // АудитПробыПодписки (подписки) — запись пробы в журнал
Перем Ограничитель;       // ОграничительПроб (подписки) — потолок частоты проб
Перем Тела;               // ТелоСобытия (подписки) — тело пробы
Перем Числа;          // ПриведениеЧисел (основа)

#Область ФабрикиОбъектов

// Описание объекта подписки «хаб».
//
// Возвращаемое значение:
//  Структура - описание объекта в формате СервисаПрав.
//
Функция ОбъектХаба() Экспорт
	Возврат СервисПрав.ОбъектХаб();
КонецФункции

// Описание объекта подписки «пул».
//
// Параметры:
//  Пул - Пул - сущность пула.
//
// Возвращаемое значение:
//  Структура - описание объекта в формате СервисаПрав.
//
Функция ОбъектПула(Знач Пул) Экспорт
	Возврат СервисПрав.ОбъектПул(Пул);
КонецФункции

// Описание объекта подписки «пакет».
//
// Параметры:
//  Пакет - Пакет - сущность пакета.
//
// Возвращаемое значение:
//  Структура - описание объекта в формате СервисаПрав.
//
Функция ОбъектПакета(Знач Пакет) Экспорт
	Возврат СервисПрав.ОбъектПакет(Пакет);
КонецФункции

#КонецОбласти

#Область ПубличныйИнтерфейс

// Типы событий, на которые можно подписаться. Источник истины — КаталогСобытий.
//
// Возвращаемое значение:
//  Массив - имена типов событий (Строка).
//
Функция ИзвестныеТипы() Экспорт
	Возврат Каталог.ТипыДляПодписки();
КонецФункции

// Тип действия записи подписки. Пустое значение старых строк читается как «вебхук».
//
// Параметры:
//  Подписка - Вебхук - запись подписки.
//
// Возвращаемое значение:
//  Строка - нормализованный тип действия.
//
Функция ТипДействияПодписки(Знач Подписка) Экспорт
	Тип = НРег(СокрЛП(Строка(Подписка.ТипДействия)));
	Возврат ?(ЗначениеЗаполнено(Тип), Тип, "вебхук");
КонецФункции

// Вправе ли пользователь распоряжаться подписками объекта. Небросающая пара
// к внутреннему гейту прав: экран спрашивает право заранее, чтобы не рисовать форму,
// которая гарантированно отобьётся.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - инициатор.
//  Объект - Структура - описание объекта.
//
// Возвращаемое значение:
//  Булево - Истина, если мутации подписок объекта разрешены.
//
Функция МожетУправлять(Знач Пользователь, Знач Объект) Экспорт

	Попытка
		ТребоватьПрава(Пользователь, Объект);
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

// Все подписки объекта, включая неактивные.
//
// Параметры:
//  Объект - Структура - описание объекта.
//
// Возвращаемое значение:
//  Массив - записи подписок (Вебхук).
//
Функция Список(Знач Объект) Экспорт
	Возврат ХранилищеВебхуков.ПолучитьПоОбъекту(ТипОбъекта(Объект), Цел(Объект.Идентификатор));
КонецФункции

// Создаёт подписку типа «вебхук» на объекте. Требует прав управления объектом.
// Возвращённая запись несёт секрет — показать его вызывающий обязан один раз.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание объекта.
//  URL - Строка - целевой адрес доставки.
//  ТипыСобытий - Строка - типы через запятую, подмножество ИзвестныеТипы.
//  Секрет - Строка - секрет подписи; пустой генерируется криптостойко
//           (необязательный, по умолчанию пустая строка).
//
// Возвращаемое значение:
//  Вебхук - созданная запись подписки.
//
Функция Создать(Знач Пользователь, Знач Объект, Знач URL, Знач ТипыСобытий, Знач Секрет = "") Экспорт

	Возврат СоздатьПодписку(Пользователь, Объект, "вебхук",
		Новый Структура("URL, Секрет", Строка(URL), Строка(Секрет)), ТипыСобытий);

КонецФункции

// Создаёт подписку с действием заданного типа на объекте. Требует прав управления
// объектом; валидацию и нормализацию ввода выполняет описание хранения типа. Бросает
// исключение на неизвестном типе, невалидном вводе, пустом наборе типов событий,
// исчерпанном лимите и дубле адреса.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание объекта.
//  ТипДействия - Строка - тип действия, например "вебхук" либо "telegram".
//  Ввод - Структура - настройки типа по контракту ПодготовитьНастройки его хранения.
//  ТипыСобытий - Строка - типы через запятую, подмножество ИзвестныеТипы.
//
// Возвращаемое значение:
//  Вебхук - созданная запись подписки.
//
Функция СоздатьПодписку(Знач Пользователь, Знач Объект, Знач ТипДействия, Знач Ввод, Знач ТипыСобытий,
	Знач ПараметрыСобытий = Неопределено) Экспорт

	ТребоватьПрава(Пользователь, Объект);

	Тип = НРег(СокрЛП(Строка(ТипДействия)));
	Хранение = Реестр.Хранение(Тип);
	Если Хранение = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Неизвестный тип действия подписки «%1»", Тип);
	КонецЕсли;

	Настройки = Хранение.ПодготовитьНастройки(Ввод);
	НормТипы = НормализоватьТипы(ТипыСобытий);
	Если НЕ ЗначениеЗаполнено(НормТипы) Тогда
		ВызватьИсключение "Не выбран ни один допустимый тип событий";
	КонецЕсли;

	// Числа подписок на объект хаб не ограничивает: их бывает по одной на каждый пакет.
	Существующие = Список(Объект);
	Для Каждого Подписка Из Существующие Цикл
		Если ТипДействияПодписки(Подписка) = Тип И Строка(Подписка.URL) = Строка(Настройки.Адрес) Тогда
			ВызватьИсключение "Подписка с этим адресом у объекта уже существует";
		КонецЕсли;
	КонецЦикла;

	Подписка = ХранилищеВебхуков.СоздатьЭлемент();
	Подписка.ТипОбъекта = ТипОбъекта(Объект);
	Подписка.ОбъектИдентификатор = Цел(Объект.Идентификатор);
	Подписка.ПулИдентификатор = Цел(Объект.ПулИдентификатор);
	Подписка.ТипДействия = Тип;
	Подписка.URL = Строка(Настройки.Адрес);
	Подписка.Секрет = Строка(Настройки.Секрет);
	Подписка.НастройкиДействия = Строка(Настройки.НастройкиДействия);
	// необязательная часть контракта хранения: тип, которому нечего класть, их не возвращает
	Подписка.ТокенДействия = Необязательное(Настройки, "ТокенДействия");
	Подписка.ШаблонТекста = Необязательное(Настройки, "ШаблонТекста");
	Подписка.ТипыСобытий = НормТипы;
	Подписка.ПараметрыСобытийJSON = Параметры.Собрать(НормТипы, ПараметрыСобытий);
	Подписка.Активен = Истина;
	Подписка.СозданКем = ?(Пользователь = Неопределено, 0, Цел(Пользователь.Идентификатор));
	Подписка.Создан = ТекущаяУниверсальнаяДата();
	Подписка.Обновлён = Подписка.Создан;
	Подписка.Сохранить();

	Возврат Подписка;

КонецФункции

// Значения полей подписки для формы правки: их состав знает описание хранения её типа.
// Секретов в ответе нет.
//
// Параметры:
//  Подписка - Вебхук - запись подписки.
//
// Возвращаемое значение:
//  Структура - значения по именам ввода; пустая, если тип правку не поддерживает.
//
Функция ЗначенияПравки(Знач Подписка) Экспорт

	Тип = ТипДействияПодписки(Подписка);
	Хранение = Реестр.Хранение(Тип);
	Если Хранение = Неопределено ИЛИ НЕ Реестр.ПравкаПоддержана(Тип) Тогда
		Возврат Новый Структура();
	КонецЕсли;
	Возврат Хранение.ЗначенияПравки(Подписка);

КонецФункции

// Поддерживает ли тип действия подписки правку существующей записи.
//
// Параметры:
//  Подписка - Вебхук - запись подписки.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожноПравить(Знач Подписка) Экспорт
	Возврат Реестр.ПравкаПоддержана(ТипДействияПодписки(Подписка));
КонецФункции

// Правит подписку объекта: настройки её типа, набор событий и включённость. Требует прав
// управления объектом. Тип действия не меняется — смена транспорта это другая подписка.
// Бросает исключение на подмене типа, невалидном вводе, пустом наборе событий и дубле
// адреса; чужой идентификатор даёт Неопределено, а не отказ по правам.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание объекта.
//  Идентификатор - Число - идентификатор подписки.
//  ТипДействия - Строка - тип, который прислала форма (сверяется с записью).
//  Ввод - Структура - настройки типа по контракту ПодготовитьПравку его хранения.
//  ТипыСобытий - Строка - типы через запятую, подмножество ИзвестныеТипы.
//  Активен - Булево - новое состояние подписки.
//
// Возвращаемое значение:
//  Структура, Неопределено - Подписка (Вебхук) и Секрет (Строка; заполнен, только если
//  выпущен новый и его нужно показать один раз); Неопределено, если подписки нет у объекта.
//
Функция ОбновитьПодписку(Знач Пользователь, Знач Объект, Знач Идентификатор,
	Знач ТипДействия, Знач Ввод, Знач ТипыСобытий, Знач Активен,
	Знач ПараметрыСобытий = Неопределено) Экспорт

	ТребоватьПрава(Пользователь, Объект);

	Подписка = ПодпискаОбъекта(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Тип = ТипДействияПодписки(Подписка);
	Заявленный = НРег(СокрЛП(Строка(ТипДействия)));
	Если ЗначениеЗаполнено(Заявленный) И Заявленный <> Тип Тогда
		ВызватьИсключение СтрШаблон(
			"Тип действия подписки не меняется правкой (сейчас «%1»): заведите новую подписку", Тип);
	КонецЕсли;

	Хранение = Реестр.Хранение(Тип);
	Если Хранение = Неопределено ИЛИ НЕ Реестр.ПравкаПоддержана(Тип) Тогда
		ВызватьИсключение СтрШаблон("Подписки типа «%1» правкой не меняются", Тип);
	КонецЕсли;

	Настройки = Хранение.ПодготовитьПравку(Ввод, Подписка);

	НормТипы = НормализоватьТипы(ТипыСобытий);
	Если НЕ ЗначениеЗаполнено(НормТипы) Тогда
		ВызватьИсключение "Не выбран ни один допустимый тип событий";
	КонецЕсли;

	Для Каждого Соседняя Из Список(Объект) Цикл
		Если Цел(Соседняя.Идентификатор) <> Цел(Подписка.Идентификатор)
			И ТипДействияПодписки(Соседняя) = Тип
			И Строка(Соседняя.URL) = Строка(Настройки.Адрес) Тогда
			ВызватьИсключение "Подписка с этим адресом у объекта уже существует";
		КонецЕсли;
	КонецЦикла;

	Подписка.URL = Строка(Настройки.Адрес);
	Подписка.Секрет = Строка(Настройки.Секрет);
	Подписка.НастройкиДействия = Строка(Настройки.НастройкиДействия);
	Подписка.ТокенДействия = Необязательное(Настройки, "ТокенДействия");
	Подписка.ШаблонТекста = Необязательное(Настройки, "ШаблонТекста");
	Подписка.ТипыСобытий = НормТипы;
	Подписка.ПараметрыСобытийJSON = Параметры.Собрать(НормТипы, ПараметрыСобытий);
	Подписка.Активен = (Активен = Истина);
	Подписка.Обновлён = ТекущаяУниверсальнаяДата();
	Подписка.Сохранить();

	Возврат Новый Структура("Подписка, Секрет", Подписка,
		?(Флаг(Настройки, "ПоказатьСекрет"), Строка(Подписка.Секрет), ""));

КонецФункции

// Поддерживает ли тип действия подписки пробную отправку.
//
// Параметры:
//  Подписка - Вебхук - запись подписки.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожноПробовать(Знач Подписка) Экспорт
	Возврат Реестр.ПробаПоддержана(ТипДействияПодписки(Подписка));
КонецФункции

// Отправляет пробное уведомление СОХРАНЁННЫМИ настройками подписки: одна попытка, без
// очереди и ретраев, теми же проверками адреса, что и боевая доставка. Требует прав
// управления объектом; чужой идентификатор даёт Неопределено. Частота проб ограничена
// потолком, превышение бросает исключение с названной причиной. Результат пишется в аудит.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание объекта.
//  Идентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Структура, Неопределено - Ок (Булево) и Описание (Строка; без секретов и без тела
//  ответа цели); Неопределено, если подписки нет у этого объекта.
//
Функция Проверить(Знач Пользователь, Знач Объект, Знач Идентификатор) Экспорт

	ТребоватьПрава(Пользователь, Объект);

	Подписка = ПодпискаОбъекта(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Тип = ТипДействияПодписки(Подписка);
	Обработчик = Реестр.Обработчик(Тип);
	Хранение = Реестр.Хранение(Тип);
	Если Обработчик = Неопределено ИЛИ Хранение = Неопределено ИЛИ НЕ Реестр.ПробаПоддержана(Тип) Тогда
		ВызватьИсключение СтрШаблон("Подписки типа «%1» пробной отправки не поддерживают", Тип);
	КонецЕсли;

	Момент = ТекущаяУниверсальнаяДата();
	Ограничитель.Потребовать("подписка-" + Формат(Цел(Подписка.Идентификатор), "ЧГ=0; ЧН=0"), Момент);
	Кто = ЛогинИнициатора(Пользователь);
	Задание = Новый Структура("ИдДоставки, ТипДействия, Действие, ТипСобытия, Тело, НомерПопытки, Проба",
		"проба-" + Строка(Новый УникальныйИдентификатор()), Тип,
		Хранение.НастройкиДоставки(Подписка), Издатель.ТипПробаПодписки(),
		Тела.Проба(Издатель.ТипПробаПодписки(), Кто, Момент), 1, Истина);

	Итог = Обработчик.Проба(Задание);
	Аудит.Записать(Подписка, Кто, Итог, Момент);
	Возврат Итог;

КонецФункции

// Включает или выключает подписку объекта. Требует прав управления объектом.
// Идемпотентна.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание объекта.
//  Идентификатор - Число - идентификатор подписки.
//  Активен - Булево - новое состояние подписки.
//
// Возвращаемое значение:
//  Булево - Истина, если подписка найдена в этом объекте и обновлена.
//
Функция Переключить(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Активен) Экспорт

	ТребоватьПрава(Пользователь, Объект);
	Подписка = ПодпискаОбъекта(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Подписка.Активен = (Активен = Истина);
	Подписка.Обновлён = ТекущаяУниверсальнаяДата();
	Подписка.Сохранить();
	Возврат Истина;

КонецФункции

// Удаляет подписку объекта. Требует прав управления объектом.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Объект - Структура - описание объекта.
//  Идентификатор - Число - идентификатор подписки.
//
// Возвращаемое значение:
//  Булево - Истина, если подписка найдена в этом объекте и удалена.
//
Функция Удалить(Знач Пользователь, Знач Объект, Знач Идентификатор) Экспорт

	ТребоватьПрава(Пользователь, Объект);
	Подписка = ПодпискаОбъекта(Объект, Идентификатор);
	Если Подписка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ХранилищеВебхуков.Удалить(Подписка);
	Возврат Истина;

КонецФункции

// Активные подписки, которым адресовано событие. Системный путь: прав не проверяет.
// Скоуп доставки — подписки пула события, его пакета и хаба; событие одного пула не
// уходит подпискам другого пула или чужого пакета. У подписок хаба дополнительно
// сверяется, что заведший их субъект до сих пор администратор хаба (fail-closed).
//
// Параметры:
//  ПулИдентификатор - Число - пул события; 0, если событие вне скоупа пула.
//  ТипСобытия - Строка - тип доменного события.
//  ПакетИдентификатор - Число - пакет события; 0, если событие не о пакете
//                      (необязательный, по умолчанию 0).
//
// Возвращаемое значение:
//  Массив - записи подписок (Вебхук).
//
Функция АктивныеДляСобытия(Знач ПулИдентификатор, Знач ТипСобытия, Знач ПакетИдентификатор = 0) Экспорт

	Тип = НРег(СокрЛП(Строка(ТипСобытия)));
	Результат = Новый Массив();

	ДобавитьПодписанные(Результат, ОбъектХаба(), Тип, Истина);
	Если Цел(ПулИдентификатор) > 0 Тогда
		ДобавитьПодписанные(Результат, ОписаниеПула(ПулИдентификатор), Тип, Ложь);
	КонецЕсли;
	Если Цел(ПакетИдентификатор) > 0 Тогда
		ДобавитьПодписанные(Результат, ОписаниеПакета(ПакетИдентификатор, ПулИдентификатор), Тип, Ложь);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Необязательное(Знач Настройки, Знач Имя)
	Значение = Неопределено;
	Если Настройки.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Возврат "";
КонецФункции

// Системный путь зовёт сервис без пользователя: журналу аудита не место падать из-за пустого поля.
Функция ЛогинИнициатора(Знач Пользователь)
	Значение = Неопределено;
	Если Пользователь = Неопределено Тогда
		Возврат "anonymous";
	КонецЕсли;
	Попытка
		Значение = Пользователь.Логин;
	Исключение
		Возврат "anonymous";
	КонецПопытки;
	Возврат ?(ЗначениеЗаполнено(Значение), Строка(Значение), "anonymous");
КонецФункции

Функция Флаг(Знач Настройки, Знач Имя)
	Значение = Неопределено;
	Возврат Настройки.Свойство(Имя, Значение) И Значение = Истина;
КонецФункции

Процедура ДобавитьПодписанные(Результат, Знач Объект, Знач Тип, Знач ПроверятьАвтора)

	Для Каждого Подписка Из Список(Объект) Цикл
		Если НЕ (Подписка.Активен = Истина И ТипВНаборе(Подписка.ТипыСобытий, Тип)) Тогда
			Продолжить;
		КонецЕсли;
		Если ПроверятьАвтора И НЕ АвторДоСихПорАдмин(Подписка) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Подписка);
	КонецЦикла;

КонецПроцедуры

// Любая неопределённость трактуется как «нет»: молчащая подписка чинится, утёкшие имена — нет.
Функция АвторДоСихПорАдмин(Знач Подписка)

	Если ХранилищеПользователей = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ИдАвтора = Цел(Подписка.СозданКем);
	Если ИдАвтора = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Автор = ХранилищеПользователей.ПолучитьОдноПоИдентификаторРавно(ИдАвтора);
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат СервисПрав.ПользовательАдмин(Автор);

КонецФункции

// По идентификатору: на системном пути доставки сущностей на руках нет, а читать их — лишний запрос.
Функция ОписаниеПула(Знач ПулИдентификатор)
	Возврат СервисПрав.ОписаниеОбъекта("пул", Цел(ПулИдентификатор), Цел(ПулИдентификатор));
КонецФункции

Функция ОписаниеПакета(Знач ПакетИдентификатор, Знач ПулИдентификатор)
	Возврат СервисПрав.ОписаниеОбъекта("пакет", Цел(ПакетИдентификатор), Цел(ПулИдентификатор));
КонецФункции

// Описание может прийти и извне, от контроллера, поэтому нормализуем ещё раз.
Функция ТипОбъекта(Знач Объект)
	Возврат НРег(СокрЛП(Строка(Объект.ТипОбъекта)));
КонецФункции

// Гейт прав по типу объекта. Неизвестный тип — отказ (fail-closed).
Процедура ТребоватьПрава(Знач Пользователь, Знач Объект)

	Если Объект = Неопределено Тогда
		ВызватьИсключение "Объект подписки не задан";
	КонецЕсли;

	Тип = ТипОбъекта(Объект);

	Если Тип = "хаб" Тогда
		Если НЕ СервисПрав.ПользовательАдмин(Пользователь) Тогда
			ВызватьИсключение "Подписками хаба распоряжается только администратор хаба";
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Действие = ДействиеУправления(Тип);
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		ВызватьИсключение СтрШаблон("Подписки на объект типа ""%1"" не поддерживаются", Тип);
	КонецЕсли;

	Если НЕ СервисПрав.РазрешеноДействие(Пользователь, Действие, Объект) Тогда
		ВызватьИсключение СтрШаблон(
			"Недостаточно прав для управления подписками объекта (%1: требуется право ""%2"")",
			Тип, Действие);
	КонецЕсли;

КонецПроцедуры

// Какое право означает «распоряжаться подписками этого объекта».
Функция ДействиеУправления(Знач Тип)

	Если Тип = "пул" Тогда
		// Owner-уровень: publisher пула событиями пула не распоряжается.
		Возврат "удаление";
	КонецЕсли;
	Если Тип = "пакет" Тогда
		// «Управлять пакетом» в терминах модели прав; наследуется от пула.
		Возврат "изменение";
	КонецЕсли;
	Возврат "";

КонецФункции

// С проверкой принадлежности объекту: чужой идентификатор даёт Неопределено.
Функция ПодпискаОбъекта(Знач Объект, Знач Идентификатор)

	Подписка = ХранилищеВебхуков.ПолучитьОдноПоИдентификаторРавно(Цел(Идентификатор));
	Если Подписка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НРег(СокрЛП(Строка(Подписка.ТипОбъекта))) <> ТипОбъекта(Объект)
		ИЛИ Цел(Подписка.ОбъектИдентификатор) <> Цел(Объект.Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Подписка;

КонецФункции

// Недоступный для подписки тип бросает исключение, а не отбрасывается молча.
Функция НормализоватьТипы(Знач ТипыСобытий)

	Известные = ИзвестныеТипы();
	Запрошенные = Новый Соответствие();
	Для Каждого Элемент Из СтрРазделить(Строка(ТипыСобытий), ",") Цикл
		Норм = НРег(СокрЛП(Элемент));
		Если НЕ ЗначениеЗаполнено(Норм) Тогда
			Продолжить;
		КонецЕсли;
		Если Известные.Найти(Норм) = Неопределено Тогда
			ВызватьИсключение СтрШаблон("Недоступный для подписки тип события ""%1""", Норм);
		КонецЕсли;
		Запрошенные.Вставить(Норм, Истина);
	КонецЦикла;

	Отобранные = Новый Массив();
	Для Каждого Тип Из Известные Цикл
		Если Запрошенные.Получить(Тип) = Истина Тогда
			Отобранные.Добавить(Тип);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Отобранные, ",");

КонецФункции

Функция ТипВНаборе(Знач CSV, Знач Тип)
	Для Каждого Элемент Из СтрРазделить(Строка(CSV), ",") Цикл
		Если НРег(СокрЛП(Элемент)) = Тип Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

#КонецОбласти

&Прозвище("СервисПодписок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеВебхуков") _ХранилищеВебхуков,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "РеестрДействийПодписок") _Реестр,
	&Пластилин(Значение = "КаталогСобытий") _Каталог,
	&Пластилин(Значение = "ПараметрыПодписки") _Параметры,
	&Пластилин(Значение = "АудитПробыПодписки") _Аудит,
	&Пластилин(Значение = "ОграничительПроб") _Ограничитель,
	&Пластилин(Значение = "ХранилищеПользователей") _ХранилищеПользователей = Неопределено,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа = Неопределено,
	&Пластилин(Значение = "ИздательСобытий") _Издатель = Неопределено,
	&Пластилин(Значение = "ТелоСобытия") _Тела = Неопределено)

	Числа = ?(_Числа = Неопределено, Новый ПриведениеЧисел(), _Числа);
	Издатель = _Издатель;
	Тела = _Тела;
	ХранилищеВебхуков = _ХранилищеВебхуков;
	ХранилищеПользователей = _ХранилищеПользователей;
	СервисПрав = _СервисПрав;
	Реестр = _Реестр;
	Каталог = _Каталог;
	Параметры = _Параметры;
	Аудит = _Аудит;
	Ограничитель = _Ограничитель;

КонецПроцедуры
