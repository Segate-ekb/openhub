// Параметры подписки: чтение и запись колонки Вебхук.ПараметрыСобытийJSON — параметры по типам
// событий (что за параметр у события и в каких границах — знает КаталогСобытий) и общие свойства
// подписки ветвью «подписка».

Перем Каталог;  // КаталогСобытий (подписки)
Перем Строки;   // КанонСтроки (основа)
Перем ЧерезЗапятую;   // СписокЧерезЗапятую (основа)
Перем ТекстыJSON;     // ТекстJSON (основа)

#Область ПубличныйИнтерфейс

// Значение параметра подписки для типа события.
//
// Параметры:
//  Подписка - Вебхук - запись подписки.
//  ТипСобытия - Строка - тип события.
//
// Возвращаемое значение:
//  Число, Неопределено - значение параметра; значение по умолчанию из каталога, если
//                        подписка его не задавала; Неопределено, если параметра у события нет.
//
Функция Значение(Знач Подписка, Знач ТипСобытия) Экспорт

	Описание = Каталог.ПараметрПодписки(ТипСобытия);
	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Разобрано = Разобрать(Подписка);
	Если Разобрано = Неопределено Тогда
		Возврат Описание.ПоУмолчанию;
	КонецЕсли;

	Ветка = Разобрано.Получить(Ключ(ТипСобытия));
	Если ТипЗнч(Ветка) <> Тип("Соответствие") Тогда
		Возврат Описание.ПоУмолчанию;
	КонецЕсли;

	Возврат ВГраницах(Ветка.Получить(Описание.Имя), Описание);

КонецФункции

// Сохранённые параметры событий подписки в виде ввода Собрать: правка, которая параметров
// не прислала, собирает колонку из них и прежних значений не теряет.
//
// Параметры:
//  Подписка - Вебхук - запись подписки.
//
// Возвращаемое значение:
//  Соответствие - тип события -> значение его параметра; только заданные подпиской.
//
Функция ВводСобытий(Знач Подписка) Экспорт

	Результат = Новый Соответствие();
	Разобрано = Разобрать(Подписка);
	Если Разобрано = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого КиЗ Из Разобрано Цикл
		Описание = Каталог.ПараметрПодписки(КиЗ.Ключ);
		Если Описание = Неопределено ИЛИ ТипЗнч(КиЗ.Значение) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Значение = КиЗ.Значение.Получить(Описание.Имя);
		Если Значение <> Неопределено Тогда
			Результат.Вставить(Ключ(КиЗ.Ключ), Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Общие свойства подписки: название, разрешение сужать её снизу и отбор по тегам.
//
// Параметры:
//  Подписка - Вебхук - запись подписки.
//
// Возвращаемое значение:
//  Структура - Название (Строка), СужениеРазрешено (Булево), ОтборТегов (Массив из Строка);
//              у подписки без свойств — пустое название, Ложь и пустой перечень.
//
Функция Свойства(Знач Подписка) Экспорт

	Результат = ПустыеСвойства();
	Разобрано = Разобрать(Подписка);
	Ветка = ?(Разобрано = Неопределено, Неопределено, Разобрано.Получить(КлючСвойств()));
	Если ТипЗнч(Ветка) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Название = СокрЛП(Строка(?(Ветка.Получить("название") = Неопределено, "",
		Ветка.Получить("название"))));
	Результат.СужениеРазрешено = (Ветка.Получить("сужение") = Истина);
	Теги = Ветка.Получить("теги");
	Если ТипЗнч(Теги) = Тип("Массив") Тогда
		Для Каждого Имя Из Теги Цикл
			Результат.ОтборТегов.Добавить(Строки.Канон(Имя));
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Свойства подписки, которых у неё нет: пустое название, сужение снизу запрещено, отбора нет.
//
// Возвращаемое значение:
//  Структура - Название, СужениеРазрешено, ОтборТегов (см. Свойства).
//
Функция ПустыеСвойства() Экспорт
	Возврат Новый Структура("Название, СужениеРазрешено, ОтборТегов", "", Ложь, Новый Массив());
КонецФункции

// Собирает значение колонки из пользовательского ввода: остаются только события набора,
// у которых каталог объявил параметр, и только значения в его границах; общие свойства
// ложатся как есть — их проверяет вызывающий.
//
// Параметры:
//  ТипыСобытий - Строка - нормализованный набор типов через запятую.
//  Ввод - Соответствие, Неопределено - тип события -> сырое значение параметра.
//  Свойства - Структура, Неопределено - общие свойства подписки (см. Свойства);
//             Неопределено — свойств нет (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Строка - JSON вида {"пул.заполнен":{"порог":80},"подписка":{…}}; "" — параметров нет.
//
Функция Собрать(Знач ТипыСобытий, Знач Ввод, Знач Свойства = Неопределено) Экспорт

	Собранные = Новый Соответствие();

	Для Каждого Тип Из ЧерезЗапятую.Разобрать(ТипыСобытий) Цикл
		Описание = Каталог.ПараметрПодписки(Ключ(Тип));
		Если Описание = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Сырое = ?(Ввод = Неопределено, Неопределено, Ввод.Получить(Ключ(Тип)));
		Ветка = Новый Соответствие();
		Ветка.Вставить(Описание.Имя, ВГраницах(Сырое, Описание));
		Собранные.Вставить(Ключ(Тип), Ветка);
	КонецЦикла;

	ВеткаСвойств = ВеткаСвойств(Свойства);
	Если ВеткаСвойств <> Неопределено Тогда
		Собранные.Вставить(КлючСвойств(), ВеткаСвойств);
	КонецЕсли;

	Если Собранные.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат ТекстыJSON.ОднойСтрокой(Собранные);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вне границ и неразобранное приводятся к умолчанию каталога: параметр не может отсутствовать.
Функция ВГраницах(Знач Сырое, Знач Описание)

	Если Сырое = Неопределено Тогда
		Возврат Описание.ПоУмолчанию;
	КонецЕсли;

	Попытка
		Значение = Цел(Число(Сырое));
	Исключение
		Возврат Описание.ПоУмолчанию;
	КонецПопытки;

	Если Значение < Описание.Минимум ИЛИ Значение > Описание.Максимум Тогда
		Возврат Описание.ПоУмолчанию;
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция Разобрать(Знач Подписка)

	Если Подписка = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Подписка.ПараметрыСобытийJSON) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(Строка(Подписка.ПараметрыСобытийJSON));
		Разобрано = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат ?(ТипЗнч(Разобрано) = Тип("Соответствие"), Разобрано, Неопределено);

КонецФункции

Функция Ключ(Знач Тип)
	Возврат Строки.Канон(Тип);
КонецФункции

// Ключ без точки: с именем типа события он не совпадёт.
Функция КлючСвойств()
	Возврат "подписка";
КонецФункции

// Свойства по умолчанию в колонку не пишутся: подписка без них хранится, как хранилась.
Функция ВеткаСвойств(Знач Свойства)

	Если Свойства = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ветка = Новый Соответствие();
	Если ЗначениеЗаполнено(Свойства.Название) Тогда
		Ветка.Вставить("название", Строка(Свойства.Название));
	КонецЕсли;
	Если Свойства.СужениеРазрешено = Истина Тогда
		Ветка.Вставить("сужение", Истина);
	КонецЕсли;
	Если Свойства.ОтборТегов.Количество() > 0 Тогда
		Ветка.Вставить("теги", Свойства.ОтборТегов);
	КонецЕсли;

	Возврат ?(Ветка.Количество() = 0, Неопределено, Ветка);

КонецФункции

#КонецОбласти

&Прозвище("ПараметрыПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаталогСобытий") _Каталог,
	&Пластилин(Значение = "КанонСтроки") _Строки = Неопределено,
	&Пластилин(Значение = "СписокЧерезЗапятую") _ЧерезЗапятую = Неопределено,
	&Пластилин(Значение = "ТекстJSON") _ТекстыJSON = Неопределено)

	ЧерезЗапятую = ?(_ЧерезЗапятую = Неопределено, Новый СписокЧерезЗапятую(), _ЧерезЗапятую);
	ТекстыJSON = ?(_ТекстыJSON = Неопределено, Новый ТекстJSON(), _ТекстыJSON);

	Строки = ?(_Строки = Неопределено, Новый КанонСтроки(), _Строки);
	Каталог = _Каталог;

КонецПроцедуры
