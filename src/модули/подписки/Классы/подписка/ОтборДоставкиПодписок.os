// Отбор подписок, которым событие доставляется: исключения из дерева получателей, порог заполнения
// пула, отбор подписки по тегам и поправки нижестоящих объектов события. Итог — подписка без
// исключённых узлов ∩ поправка пула (с исключёнными ею пакетами) ∩ поправка пакета. Отбор по тегам
// действует теми тегами, которые есть у пула или пакета в момент события.

Перем Заполнение;           // ОтборЗаполненияПула (подписки) — порог подписки на заполнение
Перем ОтборТегов;           // ОтборПоТегам (подписки) — версия под тегами перечня
Перем ПараметрыПодписки;    // ПараметрыПодписки (подписки) — отбор тегов и разрешение сужать
Перем Поправки;             // ХранилищеПоправокПодписок (подписки) — поправки объектов события
Перем Исключения;           // ХранилищеИсключенийПодписок (подписки) — исключённые узлы события
Перем ИсключенияВПоправках; // ХранилищеИсключенийВПоправках (подписки) — пакет события, снятый пулом
Перем ЧтениеПолей;          // ЧтениеПолей (основа)
Перем ЧерезЗапятую;         // СписокЧерезЗапятую (основа)
Перем Ошибки;               // ТекстОшибки (основа)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Подписки, которым событие доставляется. Каналы версии, теги объектов, исключения и поправки
// объектов события читаются один раз на событие и только когда они кому-то нужны. Сбой отбора
// одной подписки гасит только её доставку.
//
// Параметры:
//  Подписки - Массив из Вебхук - активные подписки объектов события.
//  Событие - Структура - Тип, Когда, Данные (ПулИдентификатор, ПакетИдентификатор, Версия и др.).
//
// Возвращаемое значение:
//  Массив из Вебхук - подписки, прошедшие отбор, в исходном порядке.
//
Функция Отобрать(Знач Подписки, Знач Событие) Экспорт

	// каналы версии, теги объектов, исключения и поправки читаются один раз на событие и только по нужде
	ПрочитанноеПоСобытию = Новый Структура("КаналыВерсии, ТегиОбъектов, Исключения, Поправки, ИсключенияВПоправках",
		Неопределено, Новый Соответствие(), Неопределено, Неопределено, Неопределено);
	Отобранные = Новый Массив();

	Для Каждого Подписка Из Подписки Цикл
		Попытка
			Если Доставлять(Подписка, Событие, ПрочитанноеПоСобытию) Тогда
				Отобранные.Добавить(Подписка);
			Иначе
				Лог.Отладка("Отбор доставки: подписка %1 событие ""%2"" не пропустила",
					Подписка.Идентификатор, Событие.Тип);
			КонецЕсли;
		Исключение
			Лог.Предупреждение("Отбор доставки: подписка %1 не отобрана: %2",
				Подписка.Идентификатор, Ошибки.Причина(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	Возврат Отобранные;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Доставлять(Знач Подписка, Знач Событие, ПрочитанноеПоСобытию)

	Если УзелИсключён(Подписка, Событие, ПрочитанноеПоСобытию) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ Заполнение.Доставлять(Подписка, Событие) Тогда
		Возврат Ложь;
	КонецЕсли;

	Свойства = ПараметрыПодписки.Свойства(Подписка);
	Перечни = Новый Массив();
	Перечни.Добавить(ОтборТегов.Действующий(Подписка, Свойства.ОтборТегов, ПрочитанноеПоСобытию.ТегиОбъектов));

	Если Свойства.СужениеРазрешено Тогда
		Если ПакетИсключёнПулом(Подписка, Событие, ПрочитанноеПоСобытию) Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Каждого Поправка Из ПоправкиПодписки(Подписка, Событие, ПрочитанноеПоСобытию) Цикл
			Если Поправка.НеПрисылать = Истина
				ИЛИ ЧерезЗапятую.Содержит(Поправка.СнятыеСобытия, Событие.Тип) Тогда
				Возврат Ложь;
			КонецЕсли;
			Перечни.Добавить(ОтборТегов.Действующий(Поправка, Поправка.ОтборТегов,
				ПрочитанноеПоСобытию.ТегиОбъектов));
		КонецЦикла;
	КонецЕсли;

	Для Каждого Перечень Из Перечни Цикл
		Если НЕ ОтборТегов.Пропускает(Перечень, Событие, КаналыВерсии(Перечень, Событие, ПрочитанноеПоСобытию)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Каналы спрашиваются, только когда перечень непуст: подписки без отбора реестр не трогают.
Функция КаналыВерсии(Знач Перечень, Знач Событие, ПрочитанноеПоСобытию)

	Если Перечень.Количество() = 0 ИЛИ НЕ ОтборТегов.СудитСобытие(Событие.Тип) Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Если ПрочитанноеПоСобытию.КаналыВерсии = Неопределено Тогда
		ПрочитанноеПоСобытию.КаналыВерсии = ОтборТегов.КаналыСобытия(Событие);
	КонецЕсли;
	Возврат ПрочитанноеПоСобытию.КаналыВерсии;

КонецФункции

// Дерево получателей есть у подписок хаба и пула: подписке пакета исключения не читаются.
Функция УзелИсключён(Знач Подписка, Знач Событие, ПрочитанноеПоСобытию)

	Если НРег(СокрЛП(Строка(Подписка.ТипОбъекта))) = "пакет" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПрочитанноеПоСобытию.Исключения = Неопределено Тогда
		ПрочитанноеПоСобытию.Исключения = СтрокиОбъектовСобытия(Исключения, Событие);
	КонецЕсли;

	Для Каждого Исключённый Из ПрочитанноеПоСобытию.Исключения Цикл
		Если Цел(Исключённый.ПодпискаИдентификатор) = Цел(Подписка.Идентификатор) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Пакеты из поправки исключает только пул и только у подписки хаба: другим подпискам эти строки
// не читаются.
Функция ПакетИсключёнПулом(Знач Подписка, Знач Событие, ПрочитанноеПоСобытию)

	Если НРег(СокрЛП(Строка(Подписка.ТипОбъекта))) <> "хаб" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПрочитанноеПоСобытию.ИсключенияВПоправках = Неопределено Тогда
		Пакет = Цел(ЧтениеПолей.Поле(Событие.Данные, "ПакетИдентификатор", 0));
		ПрочитанноеПоСобытию.ИсключенияВПоправках = ?(Пакет = 0, Новый Массив(),
			ИсключенияВПоправках.ПоПакету(Пакет));
	КонецЕсли;

	Для Каждого Исключённый Из ПрочитанноеПоСобытию.ИсключенияВПоправках Цикл
		Если Цел(Исключённый.ПодпискаИдентификатор) = Цел(Подписка.Идентификатор) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Поправку подписке пакета ставить некому; подписке пула — только пакет, подписке хаба — пул и пакет.
Функция ПоправкиПодписки(Знач Подписка, Знач Событие, ПрочитанноеПоСобытию)

	Если ПрочитанноеПоСобытию.Поправки = Неопределено Тогда
		ПрочитанноеПоСобытию.Поправки = СтрокиОбъектовСобытия(Поправки, Событие);
	КонецЕсли;

	Результат = Новый Массив();
	Для Каждого Поправка Из ПрочитанноеПоСобытию.Поправки Цикл
		Если Цел(Поправка.ПодпискаИдентификатор) = Цел(Подписка.Идентификатор) Тогда
			Результат.Добавить(Поправка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Строки поправок или исключений, поставленные пулу и пакету события, — их хранилища отвечают
// на один и тот же вопрос ПоОбъекту.
Функция СтрокиОбъектовСобытия(Знач Хранилище, Знач Событие)

	Результат = Новый Массив();
	Добавить(Результат, СтрокиОбъекта(Хранилище, Событие, "пул", "ПулИдентификатор"));
	Добавить(Результат, СтрокиОбъекта(Хранилище, Событие, "пакет", "ПакетИдентификатор"));
	Возврат Результат;

КонецФункции

Функция СтрокиОбъекта(Знач Хранилище, Знач Событие, Знач ТипОбъекта, Знач Поле)

	Идентификатор = Цел(ЧтениеПолей.Поле(Событие.Данные, Поле, 0));
	Возврат ?(Идентификатор = 0, Новый Массив(), Хранилище.ПоОбъекту(ТипОбъекта, Идентификатор));

КонецФункции

Процедура Добавить(Результат, Знач Найденные)
	Для Каждого Элемент Из Найденные Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

&Прозвище("ОтборДоставкиПодписок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтборЗаполненияПула") _Заполнение,
	&Пластилин(Значение = "ОтборПоТегам") _ОтборТегов,
	&Пластилин(Значение = "ПараметрыПодписки") _ПараметрыПодписки,
	&Пластилин(Значение = "ХранилищеПоправокПодписок") _Поправки,
	&Пластилин(Значение = "ХранилищеИсключенийПодписок") _Исключения,
	&Пластилин(Значение = "ХранилищеИсключенийВПоправках") _ИсключенияВПоправках,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ЧтениеПолей") _ЧтениеПолей = Неопределено,
	&Пластилин(Значение = "СписокЧерезЗапятую") _ЧерезЗапятую = Неопределено)

	ЧтениеПолей = ?(_ЧтениеПолей = Неопределено, Новый ЧтениеПолей(), _ЧтениеПолей);
	ЧерезЗапятую = ?(_ЧерезЗапятую = Неопределено, Новый СписокЧерезЗапятую(), _ЧерезЗапятую);
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

	Ошибки = _Ошибки;
	Заполнение = _Заполнение;
	ОтборТегов = _ОтборТегов;
	ПараметрыПодписки = _ПараметрыПодписки;
	Поправки = _Поправки;
	Исключения = _Исключения;
	ИсключенияВПоправках = _ИсключенияВПоправках;

КонецПроцедуры
