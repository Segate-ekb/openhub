// Точка расширения «обработчик действия подписки»: собирает по прозвищам три класса каждого
// типа. Новый тип — новая папка обработчики/<тип>/, ядро и сервис подписок при этом не правятся.

Перем Доставки;   // Соответствие: тип действия -> обработчик доставки
Перем Хранения;   // Соответствие: тип действия -> описание хранения
Перем Рендеры;    // Соответствие: тип действия -> рендер настроек
Перем Правки;     // Соответствие: тип действия -> Булево «хранение умеет править»
Перем Пробы;      // Соответствие: тип действия -> Булево «доставка умеет пробу»

#Область ПубличныйИнтерфейс

// Типы действий, известные хабу, по обработчикам доставки.
//
// Возвращаемое значение:
//  Массив - имена типов (Строка); порядок не гарантируется.
//
Функция Типы() Экспорт
	Результат = Новый Массив();
	Для Каждого КлючЗначение Из Доставки Цикл
		Результат.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Обработчик доставки заданного типа действия.
//
// Параметры:
//  Тип - Строка - имя типа действия.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - обработчик; Неопределено для неизвестного типа.
//
Функция Обработчик(Знач Тип) Экспорт
	Возврат Доставки.Получить(Ключ(Тип));
КонецФункции

// Описание хранения настроек заданного типа действия.
//
// Параметры:
//  Тип - Строка - имя типа действия.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - описание хранения; Неопределено для неизвестного типа.
//
Функция Хранение(Знач Тип) Экспорт
	Возврат Хранения.Получить(Ключ(Тип));
КонецФункции

// Рендер настроек заданного типа действия.
//
// Параметры:
//  Тип - Строка - имя типа действия.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - рендер; Неопределено, если тип неизвестен
//  либо рендер не собран.
//
Функция РендерНастроек(Знач Тип) Экспорт
	Возврат Рендеры.Получить(Ключ(Тип));
КонецФункции

// Умеет ли хранение типа править существующую подписку. Правка — необязательная часть
// контракта хранения: тип, объявивший только создание, из списка не пропадает, но
// карточка правки ему не рисуется, а сервис такую подписку менять отказывается.
//
// Параметры:
//  Тип - Строка - имя типа действия.
//
// Возвращаемое значение:
//  Булево - Истина, если хранение объявило ПодготовитьПравку и ЗначенияПравки.
//
Функция ПравкаПоддержана(Знач Тип) Экспорт
	Возврат Правки.Получить(Ключ(Тип)) = Истина;
КонецФункции

// Умеет ли обработчик доставки типа синхронную пробную отправку. Проба — необязательная
// часть контракта доставки: тип, её не объявивший, кнопки пробы не получает.
//
// Параметры:
//  Тип - Строка - имя типа действия.
//
// Возвращаемое значение:
//  Булево - Истина, если обработчик доставки объявил Проба.
//
Функция ПробаПоддержана(Знач Тип) Экспорт
	Возврат Пробы.Получить(Ключ(Тип)) = Истина;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Ключ(Знач Тип)
	Возврат НРег(СокрЛП(Строка(Тип)));
КонецФункции

Функция Собрать(Знач Список, Знач Роль)

	Карта = Новый Соответствие();
	Если Список = Неопределено Тогда
		Возврат Карта;
	КонецЕсли;
	Для Каждого Компонент Из Список Цикл
		Тип = Ключ(Компонент.ТипДействия());
		Если НЕ ЗначениеЗаполнено(Тип) Тогда
			ВызватьИсключение СтрШаблон("Реестр действий подписок: компонент «%1» с пустым типом", Роль);
		КонецЕсли;
		Если Карта.Получить(Тип) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				"Реестр действий подписок: тип «%1» объявлен дважды (%2)", Тип, Роль);
		КонецЕсли;
		Карта.Вставить(Тип, Компонент);
	КонецЦикла;
	Возврат Карта;

КонецФункции

// Наличие необязательных методов спрашивается у объекта: пробный вызов означал бы правку подписки.
Функция СобратьВозможности(Знач Компоненты, Знач ПервыйМетод, Знач ВторойМетод = "")

	Результат = Новый Соответствие();
	Рефлектор = Новый Рефлектор();
	Для Каждого КлючЗначение Из Компоненты Цикл
		Методы = Рефлектор.ПолучитьТаблицуМетодов(КлючЗначение.Значение);
		Есть = Методы.Найти(ПервыйМетод) <> Неопределено
			И (НЕ ЗначениеЗаполнено(ВторойМетод) ИЛИ Методы.Найти(ВторойМетод) <> Неопределено);
		Результат.Вставить(КлючЗначение.Ключ, Есть);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Спаренность доставки и хранения проверяется в обе стороны.
Процедура ПроверитьСпаренность()

	Для Каждого КлючЗначение Из Доставки Цикл
		Если Хранения.Получить(КлючЗначение.Ключ) = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				"Реестр действий подписок: у типа «%1» есть доставка, но нет описания хранения",
				КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючЗначение Из Хранения Цикл
		Если Доставки.Получить(КлючЗначение.Ключ) = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				"Реестр действий подписок: у типа «%1» есть описание хранения, но нет доставки",
				КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

&Прозвище("РеестрДействийПодписок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОбработчикДоставкиПодписки", Тип = "Массив") _Доставки,
	&Пластилин(Значение = "ХранениеПодписки", Тип = "Массив") _Хранения,
	&Пластилин(Значение = "РендерНастроекПодписки", Тип = "Массив") _Рендеры = Неопределено)

	Доставки = Собрать(_Доставки, "доставка");
	Хранения = Собрать(_Хранения, "хранение");
	Рендеры = Собрать(_Рендеры, "рендер настроек");
	ПроверитьСпаренность();
	Правки = СобратьВозможности(Хранения, "ПодготовитьПравку", "ЗначенияПравки");
	Пробы = СобратьВозможности(Доставки, "Проба");

КонецПроцедуры
