// Хранилище заданий доставки: репозиторий сущности «ЗаданиеДоставки».
// Порядок и созревание считает очередь (подписки/ОчередьДоставокПодписок).

// BSLLS:UnusedParameters-off

Перем Сам;        // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё
Перем Агрегаты;   // АгрегатыБазы (данные) — размер очереди спрашивается у базы

// Вся таблица заданий без отбора. Имена "Получить" и "ПолучитьОдно" ломают сборку желудя,
// поэтому выборка всей таблицы называется "ПолучитьПо".
//
// Возвращаемое значение:
//  Массив из ЗаданиеДоставки.
//
&МетодЗапроса
Функция ПолучитьПо() Экспорт
	Возврат Неопределено;
КонецФункции

// Сколько незавершённых заданий в очереди. Отбора нет — считается вся таблица,
// как её и отдаёт Все().
//
// Возвращаемое значение:
//  Число.
//
Функция Количество() Экспорт
	Возврат Агрегаты.Количество(Сам.Достать());
КонецФункции

// Все незавершённые задания очереди. Отбор по НеРанее не деривуется намеренно:
// на КоннекторJSON запрос с отбором по ещё не созданной таблице падает,
// а выборка без отбора отдаёт пусто.
//
// Возвращаемое значение:
//  Массив из ЗаданиеДоставки.
//
Функция Все() Экспорт
	Возврат Сам.Достать().ПолучитьПо();
КонецФункции

&ХранилищеСущностей("ЗаданиеДоставки")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеЗаданийДоставки") _Сам,
	&Пластилин(Значение = "АгрегатыБазы") _Агрегаты)

	Сам = _Сам;
	Агрегаты = _Агрегаты;

КонецПроцедуры
