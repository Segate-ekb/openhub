// Ядро доставки подписок: постановка исходящих заданий и разбор партий. Само действие
// выполняет обработчик его типа; изоляция ошибок, ретраи и бэкофф — здесь и для всех типов.

Перем Очередь;        // ОчередьДоставокПодписок (подписки)
Перем Реестр;         // РеестрДействийПодписок (подписки)
Перем Числа;      // ЧислаДоставки (подписки) — рубильник доставки и её пороги
&Лог
Перем Лог;
Перем Ошибки;      // ТекстОшибки (основа)

#Область ПубличныйИнтерфейс

// Ставит доставку действия в очередь. Дёшево, без сети — вызывается с горячего пути.
//
// Параметры:
//  ТипДействия - Строка - тип действия подписки, например "вебхук" либо "telegram".
//  Действие - Структура - настройки доставки типа, собранные его описанием хранения.
//  ТипСобытия - Строка - тип доменного события.
//  Тело - Строка - JSON-тело события.
//  Момент - Дата - момент постановки, влияет на созревание задания (необязательный,
//           по умолчанию текущий).
//
// Возвращаемое значение:
//  Строка - идентификатор доставки; пустая строка, если доставка выключена настройкой
//  и задание не поставлено.
//
Функция Поставить(Знач ТипДействия, Знач Действие, Знач ТипСобытия, Знач Тело, Знач Момент = Неопределено) Экспорт

	Если НЕ Числа.ДоставкаВключена() Тогда
		Возврат ""; // не enqueue-им: очередь не должна расти без консьюмера
	КонецЕсли;

	Возврат Очередь.Поставить(НРег(СокрЛП(Строка(ТипДействия))), Действие,
		Строка(ТипСобытия), Строка(Тело),
		?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент));

КонецФункции

// Обрабатывает одну партию: забирает созревшие задания и доставляет их обработчиками
// их типов. Неудачные с оставшимися попытками остаются в очереди с бэкоффом,
// исчерпавшие МаксПопыток снимаются с логом. Наружу не бросает.
//
// Параметры:
//  Сейчас - Дата - текущий момент, тестовый шов (необязательный, по умолчанию текущий).
//
// Возвращаемое значение:
//  Структура - счётчики Доставлено, Повторно, Отброшено.
//
Функция ОбработатьПартию(Знач Сейчас = Неопределено) Экспорт

	Момент = ?(Сейчас = Неопределено, ТекущаяУниверсальнаяДата(), Сейчас);
	Созревшие = Очередь.Созревшие(Момент);

	Итог = Новый Структура("Доставлено, Повторно, Отброшено", 0, 0, 0);

	// Пустая партия — норма простаивающего хаба, и о ней журнал молчит на любом уровне.
	Если Созревшие.Количество() > 0 Тогда
		Лог.Отладка("Доставка: взято в работу %1 созревших заданий, в очереди %2",
			Созревшие.Количество(), Очередь.Размер());
	КонецЕсли;

	Для Каждого Задание Из Созревшие Цикл
		ОбработатьЗадание(Задание, Момент, Итог);
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Текущее число заданий в очереди доставки.
//
// Возвращаемое значение:
//  Число - размер очереди.
//
Функция РазмерОчереди() Экспорт
	Возврат Очередь.Размер();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработатьЗадание(Знач Задание, Знач Момент, Итог)

	Лог.Отладка("Доставка %1 (%2): попытка %3", Задание.ИдДоставки, Задание.ТипДействия,
		Задание.НомерПопытки);

	Обработчик = Реестр.Обработчик(Задание.ТипДействия);
	Если Обработчик = Неопределено Тогда
		// Fail-closed: без обработчика ретрай не поможет.
		Снять(Задание, Итог);
		Лог.Предупреждение("Доставка %1: неизвестный тип действия «%2» — задание отброшено",
			Задание.ИдДоставки, Задание.ТипДействия);
		Возврат;
	КонецЕсли;

	// Вердикт «не Ок» снимает задание без ретраев; ИСКЛЮЧЕНИЕ из самой проверки —
	// сбой попытки, задание идёт по правилам ретраев, соседние не страдают.
	Вердикт = Неопределено;
	Успех = Ложь;
	Попытка
		Вердикт = Обработчик.ПередДоставкой(Задание);
	Исключение
		Лог.Предупреждение("Доставка %1 (%2): сбой проверки перед доставкой (попытка %3): %4",
			Задание.ИдДоставки, Задание.ТипДействия, Задание.НомерПопытки,
			Ошибки.Причина(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Вердикт <> Неопределено Тогда

		Если НЕ Вердикт.Успех Тогда
			Снять(Задание, Итог);
			Лог.Предупреждение("Доставка %1 (%2): отклонена проверкой перед доставкой: %3",
				Задание.ИдДоставки, Задание.ТипДействия, Вердикт.Сообщение);
			Возврат;
		КонецЕсли;

		Попытка
			Успех = Обработчик.Доставить(Задание);
		Исключение
			// Изоляция: сбой доставки одного задания не роняет партию.
			Успех = Ложь;
			Лог.Предупреждение("Доставка %1 (%2): сбой (попытка %3): %4",
				Задание.ИдДоставки, Задание.ТипДействия, Задание.НомерПопытки,
				Ошибки.Причина(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Если Успех Тогда
		Очередь.Завершить(Задание);
		Итог.Доставлено = Итог.Доставлено + 1;
		Лог.Отладка("Доставка %1 (%2): доставлена с попытки %3",
			Задание.ИдДоставки, Задание.ТипДействия, Задание.НомерПопытки);
	ИначеЕсли Задание.НомерПопытки < Числа.МаксПопыток() Тогда
		Очередь.Отложить(Задание, Момент + ЗадержкаБэкоффа(Задание.НомерПопытки));
		Итог.Повторно = Итог.Повторно + 1;
		Лог.Отладка("Доставка %1 (%2): отпущена в повтор, попытка %3 из %4",
			Задание.ИдДоставки, Задание.ТипДействия, Задание.НомерПопытки, Числа.МаксПопыток());
	Иначе
		Снять(Задание, Итог);
		Лог.Предупреждение("Доставка %1 (%2): отброшена после %3 попыток",
			Задание.ИдДоставки, Задание.ТипДействия, Задание.НомерПопытки);
	КонецЕсли;

КонецПроцедуры

Процедура Снять(Знач Задание, Итог)
	Очередь.Завершить(Задание);
	Итог.Отброшено = Итог.Отброшено + 1;
КонецПроцедуры

// База * 2^(попытка-1); попытки нумеруются с 1.
Функция ЗадержкаБэкоффа(Знач НомерПопытки)
	Множитель = 1;
	Для Ном = 2 По НомерПопытки Цикл
		Множитель = Множитель * 2;
	КонецЦикла;
	Возврат Числа.БэкоффБазаСек() * Множитель;
КонецФункции

#КонецОбласти

&Прозвище("СлужбаДоставкиПодписок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РеестрДействийПодписок") _Реестр,
	&Пластилин(Значение = "ОчередьДоставокПодписок") _Очередь,
	&Пластилин(Значение = "ЧислаДоставки") _Числа,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки)

	Ошибки = _Ошибки;

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Реестр = _Реестр;
	Очередь = _Очередь;
	Числа = _Числа;

КонецПроцедуры
