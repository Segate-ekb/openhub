// Имена публикаторов в телах доставки: того, кто запустил доверенный конвейер на github.com,
// GitHub называет по имени перед самой отправкой — в фоне доставки, вне пути публикации.

Перем Опознание; // ОпознаниеGitHub (права), может быть Неопределено — без него публикатор остаётся логином
Перем Запуски;   // СервисЗапусковКонвейеров (реестр), может быть Неопределено — кто запустил конвейер
Перем Тела;      // ТелоСобытия (подписки) — форма тела доставки
Перем Ошибки;    // ТекстОшибки (основа)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Тело задания, в котором публикатор назван по имени из профиля GitHub. Только у доставки
// о доверенной публикации: логин запустившего конвейер берётся из запуска, принявшего версию
// тела. Версию принял не конвейер github.com, GitHub не ответил или имени в профиле нет — тело
// возвращается прежним, публикатор назван логином. Исключений не бросает.
//
// Параметры:
//  Задание - Структура - задание очереди: ИдДоставки, Тело.
//
// Возвращаемое значение:
//  Строка - тело доставки.
//
Функция ТелоСИменем(Знач Задание) Экспорт

	Попытка
		Возврат ТелоСИменемИлиПрежнее(Задание);
	Исключение
		Лог.Предупреждение("Доставка %1: имя публикатора не дочитано, остаётся логин — %2",
			Задание.ИдДоставки, Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат Задание.Тело;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТелоСИменемИлиПрежнее(Знач Задание)

	Если Опознание = Неопределено ИЛИ Запуски = Неопределено Тогда
		Возврат Задание.Тело;
	КонецЕсли;

	// имя дочитывается только запустившему доверенный конвейер: учётка хаба и логин GitHub из
	// легаси-токена — другие люди, даже если логин совпал с запустившим позднейший конвейер
	Поля = Тела.ПоляТела(Задание.Тело);
	Если Поля = Неопределено ИЛИ Поле(Поля, "как") <> СпособДоверенногоКонвейера() Тогда
		Возврат Задание.Тело;
	КонецЕсли;

	Логин = Запуски.ЗапустившийGitHub(Поле(Поля, "пул"), Поле(Поля, "пакет"), Поле(Поля, "версия"));
	// версию с тех пор мог принять другой запуск — тогда тело говорит не о нём
	Если НЕ ЗначениеЗаполнено(Логин) ИЛИ Поле(Поля, "публикатор") <> Логин Тогда
		Возврат Задание.Тело;
	КонецЕсли;

	Имя = Опознание.Имя(Логин);
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Лог.Отладка("Доставка %1: у публикатора <%2> имени нет или GitHub не ответил — остаётся логин",
			Задание.ИдДоставки, Логин);
		Возврат Задание.Тело;
	КонецЕсли;

	Возврат Тела.СИменемПубликатора(Задание.Тело, Имя, Логин);

КонецФункции

// Слова способа из события публикации: их и видит получатель в поле «как».
Функция СпособДоверенногоКонвейера()
	Возврат "доверенная публикация";
КонецФункции

Функция Поле(Знач Поля, Знач Имя)
	Значение = Поля.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТелоСобытия") _Тела,
	&Пластилин(Значение = "ОпознаниеGitHub", Тип = "Массив") _Опознание = Неопределено,
	&Пластилин(Значение = "СервисЗапусковКонвейеров", Тип = "Массив") _Запуски = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Лог _Лог = Неопределено)

	Тела = _Тела;
	Желуди = Новый ВнедрённыеЖелуди();
	Опознание = Желуди.ПервыйИз(_Опознание);
	Запуски = Желуди.ПервыйИз(_Запуски);
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	// лог параметром — только при прямом создании; в контейнере поле прилепит напильник
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
