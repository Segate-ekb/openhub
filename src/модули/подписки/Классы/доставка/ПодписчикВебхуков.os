// Подписчик событий-мутаций версий: на каждое событие ставит в очередь задание-действие
// для каждой активной подписки объектов события. На горячем пути только дешёвое.

Перем СервисПодписок;  // СервисПодписок (подписки)
Перем Готовность;   // ГотовностьХаба (наблюдаемость)
Перем СлужбаДоставки;  // СлужбаДоставкиПодписок (подписки)
Перем Реестр;          // РеестрДействийПодписок (подписки)
Перем Издатель;        // ИздательСобытий (события)
Перем Тела;            // ТелоСобытия (подписки) — JSON-тело доставки
&Лог
Перем Лог;
Перем Ошибки;      // ТекстОшибки (основа)
Перем Отбор;       // ОтборЗаполненияПула (подписки) — порог подписки на заполнение
Перем ЧтениеПолей;   // ЧтениеПолей (основа)

#Область КонтрактПодписчикаСобытий

// Ставит доставки активным подпискам объектов события: пула, его пакета и хаба.
// Событие вне скоупа объектов игнорируется; сбой отдельной подписки изолирован.
//
// Параметры:
//  Событие - Структура - Тип, Когда, Данные (ПулИдентификатор, ПакетИдентификатор и др.).
//
Процедура ОбработатьСобытие(Знач Событие) Экспорт

	Данные = Событие.Данные;
	ПулИд = Цел(Поле(Данные, "ПулИдентификатор", 0));
	ПакетИд = Цел(Поле(Данные, "ПакетИдентификатор", 0));
	Если ПулИд = 0 И ПакетИд = 0 Тогда
		Возврат; // событие вне скоупа объектов — доставлять некому
	КонецЕсли;

	Подписки = СервисПодписок.АктивныеДляСобытия(ПулИд, Событие.Тип, ПакетИд);
	Лог.Отладка("Подписчик вебхуков: событие ""%1"" (пул #%2, пакет #%3) — активных подписок %4",
		Событие.Тип, ПулИд, ПакетИд, Подписки.Количество());
	Если Подписки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Тело = СформироватьТело(Событие);
	Для Каждого Подписка Из Подписки Цикл
		Попытка
			Если НЕ Отбор.Доставлять(Подписка, Событие) Тогда
				Лог.Отладка("Подписчик вебхуков: подписка %1 отбор не прошла — доставки не будет",
					Подписка.Идентификатор);
				Продолжить; // порог подписки ещё не пройден либо о нём уже сообщали
			КонецЕсли;
			ПоставитьДоставку(Подписка, Событие, Тело);
		Исключение
			Лог.Предупреждение("Подписка %1: не удалось поставить доставку: %2",
				Подписка.Идентификатор, Ошибки.Причина(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПубличныйИнтерфейс

// Подписывает подписчика на события версий и закрывает свой гейт готовности.
// Подписка в рогатке, а не в конструкторе: ОСень инстанцирует желуди лениво.
//
Процедура ПриЗапускеПриложения() Экспорт
	Издатель.Подписать(Издатель.ТипВерсияОпубликована(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипВерсияОтозвана(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипВерсияВосстановлена(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипПулЗаполнен(), ЭтотОбъект);
	// Гейт закрывается последней строкой и без Попытка: упавшая подписка оставляет /ready 503.
	Готовность.ОтметитьЗадачуВыполненной("webhooks.подписчик");
КонецПроцедуры

// Формирует компактное JSON-тело доставки из события.
//
// Параметры:
//  Событие - Структура - Тип, Когда, Данные.
//
// Возвращаемое значение:
//  Строка - JSON без переносов и отступов; подписывается и уходит как есть.
//
Функция СформироватьТело(Знач Событие) Экспорт
	Возврат Тела.ПоСобытию(Событие);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подписка типа без хранения в реестре пропускается с логом: fail-closed.
Процедура ПоставитьДоставку(Знач Подписка, Знач Событие, Знач Тело)

	ТипДействия = СервисПодписок.ТипДействияПодписки(Подписка);
	Хранение = Реестр.Хранение(ТипДействия);
	Если Хранение = Неопределено Тогда
		Лог.Предупреждение("Подписка %1: тип действия «%2» неизвестен реестру — доставка пропущена",
			Подписка.Идентификатор, ТипДействия);
		Возврат;
	КонецЕсли;

	СлужбаДоставки.Поставить(ТипДействия, Хранение.НастройкиДоставки(Подписка),
		Событие.Тип, Тело, Событие.Когда);

КонецПроцедуры

Функция Поле(Знач Данные, Знач Имя, Знач ПоУмолчанию)
	Возврат ЧтениеПолей.Поле(Данные, Имя, ПоУмолчанию);
КонецФункции

#КонецОбласти

&Рогатка
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "СлужбаДоставкиПодписок") _СлужбаДоставки,
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "ГотовностьХаба") _Готовность,
	&Пластилин(Значение = "РеестрДействийПодписок") _Реестр,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Пластилин(Значение = "ТелоСобытия") _Тела,
	&Пластилин(Значение = "ОтборЗаполненияПула") _Отбор,
	&Пластилин(Значение = "ЧтениеПолей") _ЧтениеПолей = Неопределено)

	ЧтениеПолей = ?(_ЧтениеПолей = Неопределено, Новый ЧтениеПолей(), _ЧтениеПолей);

	Ошибки = _Ошибки;
	Тела = _Тела;
	Отбор = _Отбор;

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	СервисПодписок = _СервисПодписок;
	СлужбаДоставки = _СлужбаДоставки;
	Издатель = _Издатель;
	Готовность = _Готовность;
	Реестр = _Реестр;
	// Заявка в конструкторе: список гейтов должен быть полон до первого запуска рогаток.
	Готовность.ЗаявитьЗадачу("webhooks.подписчик");

КонецПроцедуры
