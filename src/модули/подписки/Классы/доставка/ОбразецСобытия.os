// Образец события для объекта подписки — один для предпросмотра текста и для пробной доставки:
// пул, пакет и его последняя версия объекта, остальные вставки заполнены тестовыми данными.

Перем Тела;          // ТелоСобытия (подписки) — тело образца
Перем Издатель;      // ИздательСобытий (события) — типы событий образца
Перем СервисПулов;   // СервисПулов (реестр) — имя пула образца
Перем СервисПакетов; // СервисПакетов (реестр) — пакет образца
Перем СервисВерсий;  // СервисВерсий (реестр) — последняя версия пакета образца
Перем ЧерезЗапятую;  // СписокЧерезЗапятую (основа)

#Область ПубличныйИнтерфейс

// Событие образца для объекта подписки. Пул и пакет — объекта, если он их называет, версия —
// последняя у пакета объекта; чего объект не называет, то образцовое. Вставки, которые событие
// этого типа несёт в бою, заполнены: публикатор — смотрящий, способ — учётка хаба, автор — из
// манифеста, а без него — OpenHub, репозиторий и релиз — OpenHub, ссылка на пакет — от внешнего
// адреса хаба, а без него — от образцового адреса.
//
// Параметры:
//  Логин - Строка - логин того, кто смотрит или пробует: публикатор образца.
//  Объект - Структура - описание объекта подписки (СервисПодписок.Объект*).
//  ТипыСобытий - Строка - отмеченные события через запятую: образец — о первом; нет — о публикации версии.
//  Момент - Дата - время события образца, UTC.
//
// Возвращаемое значение:
//  Структура - Тип (Строка — тип события образца) и Тело (Строка — JSON-тело доставки).
//
Функция Событие(Знач Логин, Знач Объект, Знач ТипыСобытий, Знач Момент) Экспорт
	Возврат Собрать(Логин, Объект, ТипыСобытий, Момент, Ложь);
КонецФункции

// То же событие образца, помеченное признаком пробы: так оно уходит пробной доставкой.
//
// Параметры:
//  Логин - Строка - логин инициатора пробы.
//  Объект - Структура - описание объекта подписки.
//  ТипыСобытий - Строка - события подписки через запятую, как у Событие.
//  Момент - Дата - момент пробы, UTC.
//
// Возвращаемое значение:
//  Структура - Тип (Строка) и Тело (Строка), как у Событие; в теле "проба": true.
//
Функция Проба(Знач Логин, Знач Объект, Знач ТипыСобытий, Знач Момент) Экспорт
	Возврат Собрать(Логин, Объект, ТипыСобытий, Момент, Истина);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Собрать(Знач Логин, Знач Объект, Знач ТипыСобытий, Знач Момент, Знач СПризнакомПробы)

	ТипСобытия = ТипСобытия(ТипыСобытий);
	СобытиеОбразца = Новый Структура("Тип, Когда, Данные", ТипСобытия, Момент,
		ДанныеОбразца(Строка(Логин), Объект, ТипСобытия));
	Возврат Новый Структура("Тип, Тело", ТипСобытия,
		Тела.Образец(СобытиеОбразца, СведенияОбразца(), СПризнакомПробы));

КонецФункции

Функция ТипСобытия(Знач ТипыСобытий)
	Отмеченные = ЧерезЗапятую.Разобрать(ТипыСобытий);
	Возврат ?(Отмеченные.Количество() = 0, Издатель.ТипВерсияОпубликована(), Отмеченные[0]);
КонецФункции

// Поля, как их несёт событие этого типа в бою: у заполнения пула нет пакета и публикатора.
Функция ДанныеОбразца(Знач Логин, Знач Объект, Знач ТипСобытия)

	ОПуле = (ТипСобытия = Издатель.ТипПулЗаполнен());
	Публикация = (ТипСобытия = Издатель.ТипВерсияОпубликована());

	Данные = Новый Структура("ПакетИдентификатор, ИмяПула, ИмяПакета, Версия, Кто, ЛогинПубликатора,"
		+ " СпособПубликации, Отозвана, Процент", 0, ОбразцовоеИмя(), "", "", "", "", "", Ложь, 0);
	Данные.Отозвана = (ТипСобытия = Издатель.ТипВерсияОтозвана());
	Если ОПуле Тогда
		Данные.Процент = ОбразцовыйПроцент();
	Иначе
		Данные.ИмяПакета = ОбразцовоеИмя();
		Данные.Версия = ОбразцоваяВерсия();
		Данные.Кто = Логин;
	КонецЕсли;
	Если Публикация Тогда
		Данные.ЛогинПубликатора = Логин;
		Данные.СпособПубликации = ОбразцовыйСпособ();
	КонецЕсли;

	Тип = НРег(СокрЛП(Строка(Объект.ТипОбъекта)));
	Если Тип = "пул" Тогда
		Данные.ИмяПула = ИмяПула(Объект.Идентификатор);
	ИначеЕсли Тип = "пакет" И ОПуле Тогда
		Пакет = СервисПакетов.ПакетПоИдентификатору(Цел(Объект.Идентификатор));
		Данные.ИмяПула = ?(Пакет = Неопределено, Данные.ИмяПула, ИмяПула(Пакет.ПулИдентификатор));
	ИначеЕсли Тип = "пакет" Тогда
		ЗаполнитьПакетом(Данные, СервисПакетов.ПакетПоИдентификатору(Цел(Объект.Идентификатор)));
	КонецЕсли;
	Возврат Данные;

КонецФункции

Процедура ЗаполнитьПакетом(Данные, Знач Пакет)

	Если Пакет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Данные.ПакетИдентификатор = Цел(Пакет.Идентификатор);
	Данные.ИмяПакета = Строка(Пакет.Имя);
	Данные.ИмяПула = ИмяПула(Пакет.ПулИдентификатор);
	Последняя = СервисВерсий.ПоследняяВерсия(Пакет.Идентификатор);
	Если Последняя <> Неопределено Тогда
		Данные.Версия = Строка(Последняя.Версия);
	КонецЕсли;

КонецПроцедуры

Функция ИмяПула(Знач Идентификатор)
	Пул = СервисПулов.ПулПоИдентификатору(Цел(Идентификатор));
	Возврат ?(Пул = Неопределено, ОбразцовоеИмя(), Строка(Пул.Имя));
КонецФункции

// Без внешнего адреса хаба ссылка на пакет строится от зарезервированного домена, а не пропадает.
Функция СведенияОбразца()
	Возврат Новый Структура("Автор, Репозиторий, Релиз, АдресХаба", "OpenHub",
		"https://github.com/Segate-ekb/openhub", "https://github.com/Segate-ekb/openhub/releases/latest",
		"https://openhub.example");
КонецФункции

Функция ОбразцовоеИмя()
	Возврат "example";
КонецФункции

Функция ОбразцоваяВерсия()
	Возврат "1.0.0";
КонецФункции

Функция ОбразцовыйСпособ()
	Возврат "учётка хаба";
КонецФункции

Функция ОбразцовыйПроцент()
	Возврат 85;
КонецФункции

#КонецОбласти

&Прозвище("ОбразецСобытия")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТелоСобытия") _Тела,
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СписокЧерезЗапятую") _ЧерезЗапятую = Неопределено)

	ЧерезЗапятую = ?(_ЧерезЗапятую = Неопределено, Новый СписокЧерезЗапятую(), _ЧерезЗапятую);

	Тела = _Тела;
	Издатель = _Издатель;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;

КонецПроцедуры
