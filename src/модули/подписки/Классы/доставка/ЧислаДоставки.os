// Числа доставки подписок: единственное место, где называются ключи oshub.webhooks.*
// разбора очереди. Значение спрашивается на каждый вызов — правка в настройках хаба
// действует без рестарта, и рубильник, включённый экраном, доходит до фонового цикла.

Перем Настройки;  // СервисНастроек (настройки)

// Ведёт ли хаб доставку подписок.
//
// Возвращаемое значение:
//  Булево.
//
Функция ДоставкаВключена() Экспорт
	Возврат Настройки.Флаг("oshub.webhooks.delivery_enabled", Истина);
КонецФункции

// Как часто разбирается очередь доставок, секунды.
//
// Возвращаемое значение:
//  Число.
//
Функция ПериодРазбораОчереди() Экспорт
	Возврат Настройки.Целое("oshub.webhooks.delivery_interval_sec", 5, 1);
КонецФункции

// Сколько раз доставка повторяется, прежде чем задание признаётся неудавшимся.
//
// Возвращаемое значение:
//  Число.
//
Функция МаксПопыток() Экспорт
	Возврат Настройки.Значение("oshub.webhooks.max_attempts");
КонецФункции

// Основание экспоненциальной паузы между попытками, секунды.
//
// Возвращаемое значение:
//  Число.
//
Функция БэкоффБазаСек() Экспорт
	Возврат Настройки.Значение("oshub.webhooks.backoff_base_sec");
КонецФункции

&Прозвище("ЧислаДоставки")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "СервисНастроек") _Настройки)
	Настройки = _Настройки;
КонецПроцедуры
