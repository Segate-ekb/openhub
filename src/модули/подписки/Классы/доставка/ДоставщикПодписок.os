// Фоновый цикл: периодически просит СлужбуДоставкиПодписок разобрать созревшие задания
// очереди.

Перем СлужбаДоставки;   // СлужбаДоставкиПодписок (подписки)
Перем Готовность;   // ГотовностьХаба (наблюдаемость)
Перем Числа;      // ЧислаДоставки (подписки) — рубильник доставки и темп разбора очереди
Перем Ошибки;     // ТекстОшибки (основа)
Перем Цикл_;      // ФоновыйЦикл (фоновыеЗадания) — каркас вечного цикла
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Крутит фоновый цикл разбора очереди доставок до запроса остановки. Выключенная настройка
// oshub.webhooks.delivery_enabled цикл не отменяет: рубильник спрашивается на каждом шаге.
//
Процедура ПриЗапускеПриложения() Экспорт

	Сбой = Цикл_.Крутить(ЭтотОбъект, "webhooks.доставщик");
	Если Сбой = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Лог.Ошибка("Фоновый цикл доставщика подписок прерван, вебхуки больше не доставляются: %1",
		Ошибки.Причина(Сбой));
	// отчёт стои́т разбора цепочки: собираем его только тогда, когда отладку включили
	Если Лог.Уровень() <= УровниЛога.Отладка Тогда
		Лог.Отладка("Фоновый цикл доставщика подписок прерван, разбор целиком:%1%2",
			Символы.ПС, Ошибки.ПодробныйОтчёт(Сбой));
	КонецЕсли;

КонецПроцедуры

// Просит фоновый цикл доставки завершиться после текущего шага.
//
Процедура Остановить() Экспорт
	Цикл_.Остановить();
КонецПроцедуры

#КонецОбласти

#Область ЦиклДоставки

// Выключенный рубильник цикл не отменяет: он спрашивается на каждом шаге, и включение
// экраном действует без перезапуска процесса.
//
// Возвращаемое значение:
//  Булево - Истина: цикл крутится всегда.
//
Функция ПередЦиклом() Экспорт

	Если НЕ Числа.ДоставкаВключена() Тогда
		Лог.Информация("Доставщик подписок отключён (oshub.webhooks.delivery_enabled=false)");
	Иначе
		Лог.Информация("Доставщик подписок запущен: разбор очереди каждые %1с",
			Числа.ПериодРазбораОчереди());
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Один шаг цикла: рубильник и темп читаются здесь, поэтому отладка показывает не заданное
// когда-то, а то, по чему цикл ходит прямо сейчас.
//
// Возвращаемое значение:
//  Булево - Ложь: доставщик спит между шагами всегда.
//
Функция ШагЦикла() Экспорт

	ШагРазрешён = Числа.ДоставкаВключена();
	Лог.Отладка("Доставщик подписок: шаг цикла, доставка включена: %1, пауза %2 с",
		ШагРазрешён, Числа.ПериодРазбораОчереди());
	Если ШагРазрешён Тогда
		РазобратьПартию();
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Пауза между шагами, миллисекунды.
//
// Возвращаемое значение:
//  Число.
//
Функция ПаузаМс() Экспорт
	Возврат Числа.ПериодРазбораОчереди() * 1000;
КонецФункции

// Хвоста у доставщика нет: он останавливается ровно на границе шага.
//
Процедура ПослеЦикла() Экспорт
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сбой разбора партии не роняет фоновое задание.
Процедура РазобратьПартию()
	Попытка
		СлужбаДоставки.ОбработатьПартию();
	Исключение
		Лог.Ошибка("Сбой шага доставщика подписок (изолирован, цикл продолжается): %1",
			Ошибки.Причина(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

&Рогатка(ЗапускатьВФоне = Истина, ОжидатьЗавершения = Ложь)
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СлужбаДоставкиПодписок") _СлужбаДоставки,
	&Пластилин(Значение = "ЧислаДоставки") _Числа,
	&Пластилин(Значение = "ГотовностьХаба") _Готовность,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Числа = _Числа;
	СлужбаДоставки = _СлужбаДоставки;
	Готовность = _Готовность;
	// Заявка в конструкторе: список гейтов должен быть полон до первого запуска рогаток.
	Готовность.ЗаявитьЗадачу("webhooks.доставщик");
	Цикл_ = Новый ФоновыйЦикл(Готовность);

КонецПроцедуры
