// Фоновый цикл: периодически просит СлужбуДоставкиПодписок разобрать созревшие задания
// очереди.

Перем СлужбаДоставки;   // СлужбаДоставкиПодписок (подписки)
Перем Готовность;   // ГотовностьХаба (наблюдаемость)
Перем Настройки;  // СервисНастроек (настройки) — рубильник доставки и темп разбора очереди
Перем Ошибки;      // ТекстОшибки (основа)
Перем ОстановкаЗапрошена;
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Крутит фоновый цикл разбора очереди доставок до запроса остановки.
// При выключенной настройке oshub.webhooks.delivery_enabled цикл не запускается.
//
Процедура ПриЗапускеПриложения() Экспорт

	// Перехват на всю рогатку, а не только на тело цикла: фоновую рогатку
	// с ОжидатьЗавершения = Ложь ОСень не дожидается и её исход не смотрит.
	Попытка

		Если НЕ Включено() Тогда
			// Выключен настройкой — осознанный выбор оператора, а не сбой. Цикл всё равно
			// крутится: рубильник спрашивается на каждом шаге, и включение действует сразу.
			Лог.Информация("Доставщик подписок отключён (oshub.webhooks.delivery_enabled=false)");
		Иначе
			Лог.Информация("Доставщик подписок запущен: разбор очереди каждые %1с", ИнтервалСек());
		КонецЕсли;

		// Гейт закрывается до входа в цикл: цикл вечен по построению.
		Готовность.ОтметитьЗадачуВыполненной("webhooks.доставщик");

		Пока НЕ ОстановкаЗапрошена Цикл
			// рубильник и темп читаются на каждом шаге: отладка показывает не заданное
			// когда-то, а то, по чему цикл ходит прямо сейчас
			ШагРазрешён = Включено();
			ПаузаСек = ИнтервалСек();
			Лог.Отладка("Доставщик подписок: шаг цикла, доставка включена: %1, пауза %2 с",
				ШагРазрешён, ПаузаСек);
			Если ШагРазрешён Тогда
				ШагЦикла();
			КонецЕсли;
			Приостановить(ПаузаСек * 1000);
		КонецЦикла;

	Исключение
		Инфо = ИнформацияОбОшибке();
		Лог.Ошибка("Фоновый цикл доставщика подписок прерван, вебхуки больше не доставляются: %1",
			Ошибки.Причина(Инфо));
		// отчёт стои́т разбора цепочки: собираем его только тогда, когда отладку включили
		Если Лог.Уровень() <= УровниЛога.Отладка Тогда
			Лог.Отладка("Фоновый цикл доставщика подписок прерван, разбор целиком:%1%2",
				Символы.ПС, Ошибки.ПодробныйОтчёт(Инфо));
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

// Просит фоновый цикл доставки завершиться после текущего шага.
//
Процедура Остановить() Экспорт
	ОстановкаЗапрошена = Истина;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сбой разбора партии не роняет фоновое задание.
Процедура ШагЦикла()
	Попытка
		СлужбаДоставки.ОбработатьПартию();
	Исключение
		Лог.Ошибка("Сбой шага доставщика подписок (изолирован, цикл продолжается): %1",
			Ошибки.Причина(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

// Рубильник и темп спрашиваются на каждом шаге: доставка включается без перезапуска процесса.
Функция Включено()
	Возврат Настройки.Значение("oshub.webhooks.delivery_enabled") = Истина;
КонецФункции

Функция ИнтервалСек()
	Возврат Настройки.Значение("oshub.webhooks.delivery_interval_sec");
КонецФункции

#КонецОбласти

&Рогатка(ЗапускатьВФоне = Истина, ОжидатьЗавершения = Ложь)
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СлужбаДоставкиПодписок") _СлужбаДоставки,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ГотовностьХаба") _Готовность,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Настройки = _Настройки;
	СлужбаДоставки = _СлужбаДоставки;
	Готовность = _Готовность;
	// Заявка в конструкторе: список гейтов должен быть полон до первого запуска рогаток.
	Готовность.ЗаявитьЗадачу("webhooks.доставщик");
	ОстановкаЗапрошена = Ложь;

КонецПроцедуры
