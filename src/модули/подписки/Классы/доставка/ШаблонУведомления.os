// Текст текстового уведомления о доменном событии: шаблон подписки с плейсхолдерами либо
// стандартный текст, если шаблон не задан. Перечень плейсхолдеров закрыт.

Перем Каталог; // КаталогСобытий (события) — человеческая подпись типа события

#Область ПубличныйИнтерфейс

// Имена плейсхолдеров, допустимых в шаблоне (без фигурных скобок), в порядке подсказки.
//
// Возвращаемое значение:
//  Массив - имена (Строка).
//
Функция Плейсхолдеры() Экспорт

	Результат = Новый Массив();
	Результат.Добавить("событие");
	Результат.Добавить("тип");
	Результат.Добавить("пул");
	Результат.Добавить("пакет");
	Результат.Добавить("версия");
	Результат.Добавить("время");
	Результат.Добавить("кто");
	Результат.Добавить("ссылка");
	Результат.Добавить("процент");
	Возврат Результат;

КонецФункции

// Проверяет шаблон уведомления. Неизвестный плейсхолдер — исключение с перечнем
// допустимых: молчаливая пустота в доставленном сообщении дороже отказа на сохранении.
//
// Параметры:
//  Шаблон - Строка - шаблон текста; пустой допустим (означает текст по умолчанию).
//
Процедура Проверить(Знач Шаблон) Экспорт

	Известные = Известные();
	Для Каждого Имя Из ИменаВШаблоне(Шаблон) Цикл
		Если Известные.Получить(Имя) = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				"Неизвестный плейсхолдер «{%1}» в шаблоне текста. Допустимы: %2",
				Имя, Перечень());
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Текст уведомления по заданию доставки. Значения подставляются одним проходом:
// плейсхолдер, попавший в имя пакета, второй раз не разворачивается.
//
// Параметры:
//  Шаблон - Строка - шаблон подписки; пустой даёт стандартный текст.
//  ТипСобытия - Строка - тип доменного события.
//  Тело - Строка - JSON-тело доставки; неразборчивое не роняет доставку.
//
// Возвращаемое значение:
//  Строка - текст без разметки.
//
Функция Текст(Знач Шаблон, Знач ТипСобытия, Знач Тело) Экспорт

	Значения = Значения(ТипСобытия, Тело);
	Если НЕ ЗначениеЗаполнено(СокрЛП(Строка(Шаблон))) Тогда
		Возврат Стандартный(Значения);
	КонецЕсли;
	Возврат Развернуть(Строка(Шаблон), Значения);

КонецФункции

// Перечень плейсхолдеров одной строкой — для текстов отказа и подсказки поля.
//
// Возвращаемое значение:
//  Строка - «{событие}, {тип}, …».
//
Функция Перечень() Экспорт

	Части = Новый Массив();
	Для Каждого Имя Из Плейсхолдеры() Цикл
		Части.Добавить("{" + Имя + "}");
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Известные()
	Результат = Новый Соответствие();
	Для Каждого Имя Из Плейсхолдеры() Цикл
		Результат.Вставить(Имя, Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Имена, записанные в шаблоне как {имя}. Одинокая скобка — обычный текст, а не отказ.
Функция ИменаВШаблоне(Знач Шаблон)

	Результат = Новый Массив();
	Текст = Строка(Шаблон);
	Позиция = СтрНайти(Текст, "{");

	Пока Позиция > 0 Цикл
		Хвост = Сред(Текст, Позиция + 1);
		Конец = СтрНайти(Хвост, "}");
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;
		Имя = Лев(Хвост, Конец - 1);
		Если ЭтоИмяПлейсхолдера(Имя) Тогда
			Результат.Добавить(НРег(Имя));
		КонецЕсли;
		Текст = Сред(Хвост, Конец + 1);
		Позиция = СтрНайти(Текст, "{");
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Имя без пробелов и вложенных скобок: «{ }» и «{a{b}» — текст, а не опечатка в имени.
Функция ЭтоИмяПлейсхолдера(Знач Имя)

	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(Имя, " ") = 0 И СтрНайти(Имя, "{") = 0 И СтрНайти(Имя, Символы.ПС) = 0;

КонецФункции

Функция Развернуть(Знач Шаблон, Знач Значения)

	Результат = "";
	Текст = Шаблон;
	Позиция = СтрНайти(Текст, "{");

	Пока Позиция > 0 Цикл
		Результат = Результат + Лев(Текст, Позиция - 1);
		Хвост = Сред(Текст, Позиция + 1);
		Конец = СтрНайти(Хвост, "}");
		Если Конец = 0 Тогда
			Возврат Результат + "{" + Хвост;
		КонецЕсли;
		Имя = Лев(Хвост, Конец - 1);
		Значение = ?(ЭтоИмяПлейсхолдера(Имя), Значения.Получить(НРег(Имя)), Неопределено);
		// неизвестное имя остаётся текстом: подписка старше правки перечня не должна молчать
		Результат = Результат + ?(Значение = Неопределено, "{" + Имя + "}", Значение);
		Текст = Сред(Хвост, Конец + 1);
		Позиция = СтрНайти(Текст, "{");
	КонецЦикла;

	Возврат Результат + Текст;

КонецФункции

Функция Значения(Знач ТипСобытия, Знач Тело)

	Данные = РазобратьТело(Тело);

	Результат = Новый Соответствие();
	Результат.Вставить("событие", ПодписьСобытия(ТипСобытия));
	Результат.Вставить("тип", Строка(ТипСобытия));
	Результат.Вставить("пул", Поле(Данные, "пул"));
	Результат.Вставить("пакет", Поле(Данные, "пакет"));
	Результат.Вставить("версия", Поле(Данные, "версия"));
	Результат.Вставить("время", Поле(Данные, "время"));
	Результат.Вставить("кто", Поле(Данные, "кто"));
	Результат.Вставить("ссылка", Поле(Данные, "ссылка"));
	Результат.Вставить("процент", Поле(Данные, "процент"));
	Возврат Результат;

КонецФункции

// Стандартный текст: подпись события, координата пакета, время и ссылка, если она есть.
Функция Стандартный(Знач Значения)

	Строки = Новый Массив();
	Строки.Добавить("OpenHub: " + Значения.Получить("событие"));

	Координата = Координата(Значения);
	Если ЗначениеЗаполнено(Координата) Тогда
		Строки.Добавить(Координата);
	КонецЕсли;
	Если ЗначениеЗаполнено(Значения.Получить("время")) Тогда
		Строки.Добавить(Значения.Получить("время"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Значения.Получить("ссылка")) Тогда
		Строки.Добавить(Значения.Получить("ссылка"));
	КонецЕсли;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция Координата(Знач Значения)

	Пакет = Значения.Получить("пакет");
	Если НЕ ЗначениеЗаполнено(Пакет) Тогда
		Возврат "";
	КонецЕсли;

	Пул = Значения.Получить("пул");
	Результат = ?(ЗначениеЗаполнено(Пул), Пул + "/" + Пакет, Пакет);
	Версия = Значения.Получить("версия");
	Возврат ?(ЗначениеЗаполнено(Версия), Результат + " " + Версия, Результат);

КонецФункции

// Подпись типа события из каталога; без каталога или записи — сам тип.
Функция ПодписьСобытия(Знач ТипСобытия)
	Если Каталог <> Неопределено Тогда
		Запись = Каталог.Запись(ТипСобытия);
		Если Запись <> Неопределено Тогда
			Возврат Строка(Запись.Подпись);
		КонецЕсли;
	КонецЕсли;
	Возврат Строка(ТипСобытия);
КонецФункции

// Неразборчивое тело — Неопределено: уведомление уйдёт без деталей, а не упадёт.
Функция РазобратьТело(Знач Тело)
	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(Строка(Тело));
		Результат = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция Поле(Знач Данные, Знач Имя)
	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Значение = Данные.Получить(Имя);
		Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
	КонецЕсли;
	Возврат "";
КонецФункции

#КонецОбласти

&Прозвище("ШаблонУведомления")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаталогСобытий") _Каталог)

	Каталог = _Каталог;

КонецПроцедуры
