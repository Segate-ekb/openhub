// Текст текстового уведомления о доменном событии: шаблон подписки с плейсхолдерами либо
// шаблон по умолчанию, если свой не задан. Перечень плейсхолдеров закрыт.

Перем Каталог; // КаталогСобытий (подписки) — человеческая подпись типа события
Перем ЧтениеПолей;   // ЧтениеПолей (основа)

#Область ПубличныйИнтерфейс

// Вставки, допустимые в шаблоне, в порядке подсказки: имя без фигурных скобок и то, что
// подставится на его место.
//
// Возвращаемое значение:
//  Массив - структуры Имя (Строка), Описание (Строка) и Поле (Строка — поле тела доставки,
//           из которого берётся значение; "" — значение вычисляется: подпись и тип события, человек).
//
Функция Вставки() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Вставка("событие", "что случилось словами: «Версия опубликована»"));
	Результат.Добавить(Вставка("тип", "код события: «версия.опубликована»"));
	Результат.Добавить(Вставка("пул", "имя пула", "пул"));
	Результат.Добавить(Вставка("пакет", "имя пакета", "пакет"));
	Результат.Добавить(Вставка("версия", "номер версии", "версия"));
	Результат.Добавить(Вставка("время", "когда это случилось, UTC", "время"));
	Результат.Добавить(Вставка("кто", "кто опубликовал: «Имя (логин)», без имени — логин"));
	Результат.Добавить(Вставка("как", "способ публикации: доверенная публикация, токен GitHub или учётка хаба", "как"));
	Результат.Добавить(Вставка("автор", "автор из манифеста версии", "автор"));
	Результат.Добавить(Вставка("репозиторий", "адрес репозитория с карточки пакета", "репозиторий"));
	Результат.Добавить(Вставка("ссылка", "страница пакета в хабе", "ссылка"));
	Результат.Добавить(Вставка("релиз", "страница релиза GitHub, если версию опубликовал конвейер релиза", "релиз"));
	Результат.Добавить(Вставка("процент", "сколько квоты пула занято, у события «Пул заполняется»", "процент"));
	Возврат Результат;

КонецФункции

// Имена вставок, допустимых в шаблоне (без фигурных скобок), в порядке подсказки.
//
// Возвращаемое значение:
//  Массив - имена (Строка).
//
Функция ИменаВставок() Экспорт

	Результат = Новый Массив();
	Для Каждого Описание Из Вставки() Цикл
		Результат.Добавить(Описание.Имя);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Шаблон текста по умолчанию: его разворачивает пустой шаблон подписки, и его же форма
// показывает в пустом поле.
//
// Возвращаемое значение:
//  Строка - многострочный шаблон.
//
Функция ПоУмолчанию() Экспорт

	Строки = Новый Массив();
	Строки.Добавить("OpenHub: {событие}");
	Строки.Добавить("{пул}/{пакет} {версия}");
	Строки.Добавить("Опубликовал: {кто}, {как}");
	Строки.Добавить("{время}");
	Строки.Добавить("{ссылка}");
	Строки.Добавить("Релиз: {релиз}");
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Проверяет шаблон уведомления. Неизвестный плейсхолдер — исключение с перечнем
// допустимых: молчаливая пустота в доставленном сообщении дороже отказа на сохранении.
//
// Параметры:
//  Шаблон - Строка - шаблон текста; пустой допустим (означает текст по умолчанию).
//
Процедура Проверить(Знач Шаблон) Экспорт

	Известные = Известные();
	Для Каждого Имя Из ИменаВШаблоне(Шаблон) Цикл
		Если Известные.Получить(Имя) = Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				"Неизвестный плейсхолдер «{%1}» в шаблоне текста. Допустимы: %2",
				Имя, Перечень());
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Текст уведомления по заданию доставки. Значения подставляются одним проходом:
// плейсхолдер, попавший в имя пакета, второй раз не разворачивается. В шаблоне из нескольких
// строк строка, где пуста хоть одна вставка, не приходит; однострочный разворачивается целиком.
//
// Параметры:
//  Шаблон - Строка - шаблон подписки; пустой — шаблон по умолчанию, как и любой, от которого
//           после разворота не осталось текста.
//  ТипСобытия - Строка - тип доменного события.
//  Тело - Строка - JSON-тело доставки; неразборчивое не роняет доставку.
//
// Возвращаемое значение:
//  Строка - текст без разметки.
//
Функция Текст(Знач Шаблон, Знач ТипСобытия, Знач Тело) Экспорт

	Значения = Значения(ТипСобытия, Тело);
	Если ЗначениеЗаполнено(СокрЛП(Строка(Шаблон))) Тогда
		Результат = Развернуть(Строка(Шаблон), Значения);
		Если ЗначениеЗаполнено(СокрЛП(Результат)) Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	Возврат Развернуть(ПоУмолчанию(), Значения);

КонецФункции

// Перечень плейсхолдеров одной строкой — для текстов отказа и подсказки поля.
//
// Возвращаемое значение:
//  Строка - «{событие}, {тип}, …».
//
Функция Перечень() Экспорт

	Части = Новый Массив();
	Для Каждого Имя Из ИменаВставок() Цикл
		Части.Добавить("{" + Имя + "}");
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Известные()
	Результат = Новый Соответствие();
	Для Каждого Имя Из ИменаВставок() Цикл
		Результат.Вставить(Имя, Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Вставка(Знач Имя, Знач Описание, Знач Поле = "")
	Возврат Новый Структура("Имя, Описание, Поле", Имя, Описание, Поле);
КонецФункции

// Имена, записанные в шаблоне как {имя}. Одинокая скобка — обычный текст, а не отказ.
Функция ИменаВШаблоне(Знач Шаблон)

	Результат = Новый Массив();
	Текст = Строка(Шаблон);
	Позиция = СтрНайти(Текст, "{");

	Пока Позиция > 0 Цикл
		Хвост = Сред(Текст, Позиция + 1);
		Конец = СтрНайти(Хвост, "}");
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;
		Имя = Лев(Хвост, Конец - 1);
		Если ЭтоИмяПлейсхолдера(Имя) Тогда
			Результат.Добавить(НРег(Имя));
		КонецЕсли;
		Текст = Сред(Хвост, Конец + 1);
		Позиция = СтрНайти(Текст, "{");
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Имя без пробелов и вложенных скобок: «{ }» и «{a{b}» — текст, а не опечатка в имени.
Функция ЭтоИмяПлейсхолдера(Знач Имя)

	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(Имя, " ") = 0 И СтрНайти(Имя, "{") = 0 И СтрНайти(Имя, Символы.ПС) = 0;

КонецФункции

Функция Развернуть(Знач Шаблон, Знач Значения)

	Строки = СтрРазделить(Шаблон, Символы.ПС, Истина);
	Если Строки.Количество() = 1 Тогда
		Возврат РазвернутьСтроку(Шаблон, Значения).Текст;
	КонецЕсли;

	Результат = Новый Массив();
	Для Каждого СтрокаШаблона Из Строки Цикл
		Развёрнутая = РазвернутьСтроку(СтрокаШаблона, Значения);
		Если НЕ Развёрнутая.ЕстьПустая Тогда
			Результат.Добавить(Развёрнутая.Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Результат, Символы.ПС);

КонецФункции

Функция РазвернутьСтроку(Знач СтрокаШаблона, Знач Значения)

	Результат = "";
	ЕстьПустая = Ложь;
	Текст = СтрокаШаблона;
	Позиция = СтрНайти(Текст, "{");

	Пока Позиция > 0 Цикл
		Результат = Результат + Лев(Текст, Позиция - 1);
		Хвост = Сред(Текст, Позиция + 1);
		Конец = СтрНайти(Хвост, "}");
		Если Конец = 0 Тогда
			Текст = "{" + Хвост;
			Прервать;
		КонецЕсли;
		Имя = Лев(Хвост, Конец - 1);
		Значение = ?(ЭтоИмяПлейсхолдера(Имя), Значения.Получить(НРег(Имя)), Неопределено);
		// неизвестное имя остаётся текстом: подписка старше правки перечня не должна молчать
		Результат = Результат + ?(Значение = Неопределено, "{" + Имя + "}", Значение);
		ЕстьПустая = ЕстьПустая ИЛИ (Значение <> Неопределено И НЕ ЗначениеЗаполнено(Значение));
		Текст = Сред(Хвост, Конец + 1);
		Позиция = СтрНайти(Текст, "{");
	КонецЦикла;

	Возврат Новый Структура("Текст, ЕстьПустая", Результат + Текст, ЕстьПустая);

КонецФункции

// Значения вставок по таблице Вставки: поле тела, а у вставки без поля — вычисленное.
Функция Значения(Знач ТипСобытия, Знач Тело)

	Данные = РазобратьТело(Тело);

	Вычисленные = Новый Соответствие();
	Вычисленные.Вставить("событие", ПодписьСобытия(ТипСобытия));
	Вычисленные.Вставить("тип", Строка(ТипСобытия));
	Вычисленные.Вставить("кто", Кто(Данные));

	Результат = Новый Соответствие();
	Для Каждого Вставка Из Вставки() Цикл
		Результат.Вставить(Вставка.Имя,
			?(ЗначениеЗаполнено(Вставка.Поле), Поле(Данные, Вставка.Поле), Вычисленные.Получить(Вставка.Имя)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Человек, а не идентификатор журнала: «публикатор» тела, а без него — «кто».
Функция Кто(Знач Данные)
	Публикатор = Поле(Данные, "публикатор");
	Возврат ?(ЗначениеЗаполнено(Публикатор), Публикатор, Поле(Данные, "кто"));
КонецФункции

// Подпись типа события из каталога; без каталога или записи — сам тип.
Функция ПодписьСобытия(Знач ТипСобытия)
	Если Каталог <> Неопределено Тогда
		Запись = Каталог.Запись(ТипСобытия);
		Если Запись <> Неопределено Тогда
			Возврат Строка(Запись.Подпись);
		КонецЕсли;
	КонецЕсли;
	Возврат Строка(ТипСобытия);
КонецФункции

// Неразборчивое тело — Неопределено: уведомление уйдёт без деталей, а не упадёт.
Функция РазобратьТело(Знач Тело)
	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(Строка(Тело));
		Результат = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция Поле(Знач Данные, Знач Имя)
	Возврат СокрЛП(Строка(ЧтениеПолей.Поле(Данные, Имя, "")));
КонецФункции

#КонецОбласти

&Прозвище("ШаблонУведомления")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаталогСобытий") _Каталог,
	&Пластилин(Значение = "ЧтениеПолей") _ЧтениеПолей = Неопределено)

	ЧтениеПолей = ?(_ЧтениеПолей = Неопределено, Новый ЧтениеПолей(), _ЧтениеПолей);

	Каталог = _Каталог;

КонецПроцедуры
