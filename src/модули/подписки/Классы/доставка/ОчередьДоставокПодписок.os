// Очередь исходящих доставок подписок, живущая в базе: постановка, отбор созревших,
// завершение и отсрочка. Перезапуск процесса очередь не стирает.

#Использовать pwhash

Перем Хранилище;   // ХранилищеЗаданийДоставки (данные)
Перем Блокировка;  // БлокировкаРесурса — сериализация доступа к очереди
Перем Настройки;  // СервисНастроек (настройки) — потолок очереди
Перем РазмерОчереди;     // Число, Неопределено — кэш размера; Неопределено, пока не считан из базы
Перем Числа;       // ПриведениеЧисел (основа)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Ставит задание в очередь. Переполнение сверх потолка дропает старейшее по моменту
// постановки.
//
// Параметры:
//  ТипДействия - Строка - тип действия подписки.
//  Действие - Структура - снимок настроек доставки типа.
//  ТипСобытия - Строка - тип доменного события.
//  Тело - Строка - JSON-тело события.
//  Момент - Дата - момент постановки.
//
// Возвращаемое значение:
//  Строка - идентификатор доставки.
//
Функция Поставить(Знач ТипДействия, Знач Действие, Знач ТипСобытия, Знач Тело, Знач Момент) Экспорт

	ИдДоставки = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешированиеПаролей.СгенерироватьСоль(16)));
	Переполнено = Ложь;

	Блокировка.Заблокировать();
	Попытка
		Переполнено = ОсвободитьМесто();
		Запись = Хранилище.СоздатьЭлемент();
		Запись.ИдДоставки = ИдДоставки;
		Запись.ТипДействия = НРег(СокрЛП(Строка(ТипДействия)));
		Запись.НастройкиJSON = ВJSON(Действие);
		Запись.ТипСобытия = Строка(ТипСобытия);
		Запись.Тело = Строка(Тело);
		Запись.НомерПопытки = 1;
		Запись.НеРанее = Момент;
		Запись.Поставлено = Момент;
		Запись.Сохранить();
		РазмерОчереди = РазмерОчереди + 1;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Если Переполнено Тогда
		Лог.Предупреждение("Очередь доставок подписок переполнена (лимит %1) — старейшие отброшены", МаксОчередь());
	КонецЕсли;

	Лог.Отладка("Очередь доставок: поставлено %1, тип действия ""%2"", событие ""%3"","
		+ " заданий в очереди %4",
		ИдДоставки, Запись.ТипДействия, Запись.ТипСобытия, РазмерОчереди);

	Возврат ИдДоставки;

КонецФункции

// Созревшие задания в порядке постановки. Задание остаётся в очереди, пока вызывающий
// не завершит либо не отложит его: партия, прерванная падением процесса, доживает
// до следующего запуска.
//
// Параметры:
//  Момент - Дата - текущий момент.
//
// Возвращаемое значение:
//  Массив из Структура - ИдДоставки, ТипДействия, Действие, ТипСобытия, Тело,
//  НомерПопытки, НеРанее и Дескриптор (запись очереди для Завершить и Отложить).
//
Функция Созревшие(Знач Момент) Экспорт

	Блокировка.Заблокировать();
	Попытка
		Записи = ПоПорядку();
		РазмерОчереди = Записи.Количество();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Если Запись.НеРанее <= Момент Тогда
			Результат.Добавить(ЗаданиеИзЗаписи(Запись));
		КонецЕсли;
	КонецЦикла;

	Лог.Отладка("Очередь доставок: в очереди %1, созрело к разбору %2",
		Записи.Количество(), Результат.Количество());
	Возврат Результат;

КонецФункции

// Снимает завершённое задание с очереди: и доставленное, и отброшенное.
//
// Параметры:
//  Задание - Структура - элемент, выданный Созревшие.
//
Процедура Завершить(Знач Задание) Экспорт

	Блокировка.Заблокировать();
	Попытка
		ОбеспечитьРазмер();
		Хранилище.Удалить(Задание.Дескриптор);
		РазмерОчереди = Макс(0, РазмерОчереди - 1);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

КонецПроцедуры

// Отпускает задание в повтор: попытка засчитана, созревание отодвинуто. Число попыток
// и момент созревания хранятся в записи, поэтому переживают перезапуск.
//
// Параметры:
//  Задание - Структура - элемент, выданный Созревшие.
//  НеРанее - Дата - момент следующего созревания.
//
Процедура Отложить(Знач Задание, Знач НеРанее) Экспорт

	Блокировка.Заблокировать();
	Попытка
		Запись = Задание.Дескриптор;
		Запись.НомерПопытки = Цел(Задание.НомерПопытки) + 1;
		Запись.НеРанее = НеРанее;
		Запись.Сохранить();
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

	Лог.Отладка("Очередь доставок: %1 уходит в повтор, попытка %2, созреет не ранее %3",
		Задание.ИдДоставки, Цел(Задание.НомерПопытки) + 1, НеРанее);

КонецПроцедуры

// Число заданий в очереди.
//
// Возвращаемое значение:
//  Число - размер очереди.
//
Функция Размер() Экспорт

	Блокировка.Заблокировать();
	Попытка
		ОбеспечитьРазмер();
		Значение = РазмерОчереди;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();
	Возврат Значение;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Потолок спрашивается на каждой постановке: правка настройки действует без перезапуска.
Функция МаксОчередь()
	Возврат Макс(1, Числа.ЧислоИлиДефолт(Настройки.Значение("oshub.webhooks.max_queue"), 10000));
КонецФункции

// Считает размер один раз за жизнь процесса: подсчёта строк слой данных не даёт.
Процедура ОбеспечитьРазмер()
	Если РазмерОчереди = Неопределено Тогда
		РазмерОчереди = Хранилище.Все().Количество();
	КонецЕсли;
КонецПроцедуры

// Истина, если ради места пришлось отбросить старейшие задания.
Функция ОсвободитьМесто()

	ОбеспечитьРазмер();
	Если РазмерОчереди < МаксОчередь() Тогда
		Возврат Ложь;
	КонецЕсли;

	Записи = ПоПорядку();
	РазмерОчереди = Записи.Количество();
	Индекс = 0;
	Пока РазмерОчереди >= МаксОчередь() И Индекс < Записи.Количество() Цикл
		Хранилище.Удалить(Записи[Индекс]); // старейшее — защита от неограниченного роста
		РазмерОчереди = РазмерОчереди - 1;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Индекс > 0;

КонецФункции

// Порядок постановки — возрастание идентификатора: момент у событий одной публикации общий.
Функция ПоПорядку()

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Ключ");
	Таблица.Колонки.Добавить("Запись");
	Для Каждого Запись Из Хранилище.Все() Цикл
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.Ключ = Цел(Запись.Идентификатор);
		СтрокаТаблицы.Запись = Запись;
	КонецЦикла;
	Таблица.Сортировать("Ключ Возр");

	Результат = Новый Массив();
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Результат.Добавить(СтрокаТаблицы.Запись);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЗаданиеИзЗаписи(Знач Запись)

	Задание = Новый Структура("ИдДоставки, ТипДействия, Действие, ТипСобытия, Тело,"
		+ " НомерПопытки, НеРанее, Дескриптор");
	Задание.ИдДоставки = Строка(Запись.ИдДоставки);
	Задание.ТипДействия = Строка(Запись.ТипДействия);
	Задание.Действие = ИзJSON(Запись.НастройкиJSON);
	Задание.ТипСобытия = Строка(Запись.ТипСобытия);
	Задание.Тело = Строка(Запись.Тело);
	Задание.НомерПопытки = Числа.ЧислоИлиДефолт(Запись.НомерПопытки, 1);
	Задание.НеРанее = Запись.НеРанее;
	Задание.Дескриптор = Запись;
	Возврат Задание;

КонецФункции

Функция ВJSON(Знач Действие)
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, ""));
	ЗаписатьJSON(Запись, ?(Действие = Неопределено, Новый Структура(), Действие));
	Возврат Запись.Закрыть();
КонецФункции

// Битый снимок даёт пустые настройки, а не исключение: разбирать партию обязана доставка типа.
Функция ИзJSON(Знач Значение)

	Результат = Новый Структура();
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(Строка(Значение));
		Разобрано = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Разобрано) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого КлючЗначение Из Разобрано Цикл
		Результат.Вставить(Строка(КлючЗначение.Ключ), КлючЗначение.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ОчередьДоставокПодписок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеЗаданийДоставки") _Хранилище,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа = Неопределено)

	Числа = ?(_Числа = Неопределено, Новый ПриведениеЧисел(), _Числа);
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Хранилище = _Хранилище;
	Настройки = _Настройки;
	РазмерОчереди = Неопределено;
	Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);

КонецПроцедуры
