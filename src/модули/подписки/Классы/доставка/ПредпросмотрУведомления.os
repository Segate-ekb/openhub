// Текст уведомления до сохранения подписки: шаблон из формы на образце данных объекта подписки —
// пул, пакет и его последняя версия, а время, публикатор, способ и страница релиза образцовые.
// Ничего не отправляет и не сохраняет.

Перем СервисПодписок; // СервисПодписок (подписки) — право распоряжаться подписками объекта
Перем Реестр;         // РеестрДействийПодписок (подписки) — обработчик доставки типа
Перем Тела;           // ТелоСобытия (подписки) — тело образца
Перем Издатель;       // ИздательСобытий (события) — типы событий образца
Перем СервисПулов;    // СервисПулов (реестр) — имя пула образца
Перем СервисПакетов;  // СервисПакетов (реестр) — пакет образца
Перем СервисВерсий;   // СервисВерсий (реестр) — последняя версия пакета образца
Перем ЧерезЗапятую;   // СписокЧерезЗапятую (основа)

#Область ПубличныйИнтерфейс

// Умеет ли тип действия показать текст уведомления до сохранения.
//
// Параметры:
//  ТипДействия - Строка - тип действия подписки.
//
// Возвращаемое значение:
//  Булево.
//
Функция Поддержан(Знач ТипДействия) Экспорт
	Возврат Реестр.ПредпросмотрПоддержан(ТипДействия);
КонецФункции

// Текст уведомления по вводу формы на образце объекта подписки. Требует права распоряжаться
// подписками объекта; бросает исключение без права, у типа без предпросмотра и на шаблоне,
// который отклонило бы сохранение.
//
// Параметры:
//  Пользователь - Пользователь - кто смотрит.
//  Объект - Структура - описание объекта подписки (СервисПодписок.Объект*).
//  ТипДействия - Строка - тип действия формы.
//  Ввод - Структура - настройки типа из формы без секретов.
//  ТипыСобытий - Строка - отмеченные события через запятую: образец — о первом; нет — о публикации версии.
//
// Возвращаемое значение:
//  Строка - текст уведомления.
//
Функция Текст(Знач Пользователь, Знач Объект, Знач ТипДействия, Знач Ввод, Знач ТипыСобытий) Экспорт

	Если НЕ СервисПодписок.МожетУправлять(Пользователь, Объект) Тогда
		ВызватьИсключение "Недостаточно прав, чтобы смотреть уведомления подписок этого объекта";
	КонецЕсли;
	Если НЕ Поддержан(ТипДействия) Тогда
		ВызватьИсключение СтрШаблон("Подписки типа «%1» текста уведомления не пишут", ТипДействия);
	КонецЕсли;

	ТипСобытия = ТипСобытия(ТипыСобытий);
	Тело = Тела.Образец(Новый Структура("Тип, Когда, Данные", ТипСобытия, ТекущаяУниверсальнаяДата(),
		ДанныеОбразца(Пользователь, Объект, ТипСобытия)));
	Возврат Реестр.Обработчик(ТипДействия).Предпросмотр(Ввод, ТипСобытия, Тело);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТипСобытия(Знач ТипыСобытий)
	Отмеченные = ЧерезЗапятую.Разобрать(ТипыСобытий);
	Возврат ?(Отмеченные.Количество() = 0, Издатель.ТипВерсияОпубликована(), Отмеченные[0]);
КонецФункции

// Пул и пакет — объекта подписки, если он их называет; чего объект не называет, то образцовое.
Функция ДанныеОбразца(Знач Пользователь, Знач Объект, Знач ТипСобытия)

	Логин = Строка(Пользователь.Логин);
	Данные = Новый Структура("ПакетИдентификатор, ИмяПула, ИмяПакета, Версия, Кто, ЛогинПубликатора,"
		+ " СпособПубликации, Процент", 0, ОбразцовоеИмя(), ОбразцовоеИмя(), ОбразцоваяВерсия(), Логин, Логин,
		"учётка хаба", ?(ТипСобытия = Издатель.ТипПулЗаполнен(), 85, 0));

	Тип = НРег(СокрЛП(Строка(Объект.ТипОбъекта)));
	Если Тип = "пул" Тогда
		Данные.ИмяПула = ИмяПула(Объект.Идентификатор);
	ИначеЕсли Тип = "пакет" Тогда
		ЗаполнитьПакетом(Данные, СервисПакетов.ПакетПоИдентификатору(Цел(Объект.Идентификатор)));
	КонецЕсли;
	Возврат Данные;

КонецФункции

Процедура ЗаполнитьПакетом(Данные, Знач Пакет)

	Если Пакет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Данные.ПакетИдентификатор = Цел(Пакет.Идентификатор);
	Данные.ИмяПакета = Строка(Пакет.Имя);
	Данные.ИмяПула = ИмяПула(Пакет.ПулИдентификатор);
	Последняя = СервисВерсий.ПоследняяВерсия(Пакет.Идентификатор);
	Если Последняя <> Неопределено Тогда
		Данные.Версия = Строка(Последняя.Версия);
	КонецЕсли;

КонецПроцедуры

Функция ИмяПула(Знач Идентификатор)
	Пул = СервисПулов.ПулПоИдентификатору(Цел(Идентификатор));
	Возврат ?(Пул = Неопределено, ОбразцовоеИмя(), Строка(Пул.Имя));
КонецФункции

Функция ОбразцовоеИмя()
	Возврат "example";
КонецФункции

Функция ОбразцоваяВерсия()
	Возврат "1.0.0";
КонецФункции

#КонецОбласти

&Прозвище("ПредпросмотрУведомления")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "РеестрДействийПодписок") _Реестр,
	&Пластилин(Значение = "ТелоСобытия") _Тела,
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СписокЧерезЗапятую") _ЧерезЗапятую = Неопределено)

	ЧерезЗапятую = ?(_ЧерезЗапятую = Неопределено, Новый СписокЧерезЗапятую(), _ЧерезЗапятую);

	СервисПодписок = _СервисПодписок;
	Реестр = _Реестр;
	Тела = _Тела;
	Издатель = _Издатель;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;

КонецПроцедуры
