// Источник выпусков хаба — карточка пакета OpenHub в API хаба пакетов (`GET …/packages/openhub`):
// последняя версия из её поля `latest_version` и страница пакета для человека.

Перем Транспорт;  // ТранспортHTTP (сеть)
Перем Таймауты;   // ТаймаутыHTTP (сеть)
Перем Форма;      // ФормаАдреса (основа) — годен ли адрес источника
Перем Адреса;     // РазборАдреса (основа) — адрес без данных пользователя
Перем Ошибки;     // ТекстОшибки (основа)

#Область ПубличныйИнтерфейс

// Последняя версия у источника. Наружу не бросает: негодный адрес, отказ сети, чужой код ответа,
// слишком большое и негодное тело называются причиной. Негодный адрес наружу не спрашивается.
//
// Параметры:
//  Адрес - Строка - адрес карточки пакета в API хаба пакетов.
//
// Возвращаемое значение:
//  Структура:
//   * Версия - Строка - последняя версия пакета; "" — источник её не назвал.
//   * Причина - Строка - почему версии нет, словами; адрес в ней — без данных пользователя;
//               "" — версия получена.
//
Функция Последняя(Знач Адрес) Экспорт

	Разбор = Форма.Разобрать(Адрес, "https,http");
	Если Разбор.Код <> Форма.Коды().Ок Тогда
		Возврат Отказ(СтрШаблон("адрес источника выпусков негоден (%1): %2", Разбор.Код, Названный(Адрес)));
	КонецЕсли;

	Попытка
		Ответ = Транспорт.Получить(Адрес, ЗаголовкиЗапроса(), Таймауты.ТаймаутСлужебногоЗапроса(), Истина, Ложь);
	Исключение
		Возврат Отказ(СтрШаблон("%1 не ответил: %2", Названный(Адрес), Ошибки.Причина(ИнформацияОбОшибке())));
	КонецПопытки;

	Если Ответ.Код <> 200 Тогда
		Возврат Отказ(СтрШаблон("%1 ответил кодом %2", Названный(Адрес), Ответ.Код));
	КонецЕсли;

	Если Ответ.Данные <> Неопределено И Ответ.Данные.Размер() > ПотолокБайт() Тогда
		Возврат Отказ(СтрШаблон("%1 прислал %2 байт — больше потолка %3 для карточки пакета",
			Названный(Адрес), Ответ.Данные.Размер(), ПотолокБайт()));
	КонецЕсли;

	Версия = ВерсияИзТела(Ответ.Данные);
	Если НЕ ЗначениеЗаполнено(Версия) Тогда
		Возврат Отказ(СтрШаблон("%1 не назвал последнюю версию (package.latest_version)", Названный(Адрес)));
	КонецЕсли;

	Возврат Новый Структура("Версия, Причина", Версия, "");

КонецФункции

// Страница пакета для человека: адрес карточки без префикса API и без данных пользователя — так
// страницы и API раскладывает хаб пакетов (`/api/v1/pools/…` → `/pools/…`). Адрес без префикса API
// ведёт сам на себя.
//
// Параметры:
//  Адрес - Строка - адрес карточки пакета в API хаба пакетов.
//
// Возвращаемое значение:
//  Строка - адрес страницы пакета.
//
Функция Страница(Знач Адрес) Экспорт

	Текст = Названный(Адрес);
	Позиция = СтрНайти(НРег(Текст), ПрефиксAPI());
	Если Позиция = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, Позиция) + Сред(Текст, Позиция + СтрДлина(ПрефиксAPI()));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрефиксAPI()
	Возврат "/api/v1/";
КонецФункции

// Карточке пакета хватает килобайт; больше — не карточка, и в память её не разбирают.
Функция ПотолокБайт()
	Возврат 1048576;
КонецФункции

// Адрес, каким его можно назвать в журнале, отметке и на кнопке: данные пользователя (user:pass@)
// отброшены.
Функция Названный(Знач Адрес)
	Текст = СокрЛП(Строка(Адрес));
	Голова = Адреса.ДоПути(Текст);
	Возврат Адреса.ПрефиксСхемы(Текст) + Адреса.Узел(Текст) + Сред(Текст, СтрДлина(Голова) + 1);
КонецФункции

Функция Отказ(Знач Причина)
	Возврат Новый Структура("Версия, Причина", "", Причина);
КонецФункции

Функция ЗаголовкиЗапроса()
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept", "application/json");
	Возврат Заголовки;
КонецФункции

// Чужое тело судится без доверия: не JSON, не объект, нет карточки или версии — версии нет.
Функция ВерсияИзТела(Знач Данные)

	Если Данные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(ПолучитьСтрокуИзДвоичныхДанных(Данные));
		Карточка = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат "";
	КонецПопытки;

	Пакет = Поле(Карточка, "package");
	Версия = Поле(Пакет, "latest_version");
	Возврат ?(ТипЗнч(Версия) = Тип("Строка"), СокрЛП(Версия), "");

КонецФункции

Функция Поле(Знач Объект, Знач Имя)
	Возврат ?(ТипЗнч(Объект) = Тип("Соответствие"), Объект.Получить(Имя), Неопределено);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТранспортHTTP") _Транспорт,
	&Пластилин(Значение = "ТаймаутыHTTP") _Таймауты,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Пластилин(Значение = "ФормаАдреса") _Форма = Неопределено,
	&Пластилин(Значение = "РазборАдреса") _Адреса = Неопределено)

	Транспорт = _Транспорт;
	Таймауты = _Таймауты;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Форма = ?(_Форма = Неопределено, Новый ФормаАдреса(), _Форма);
	Адреса = ?(_Адреса = Неопределено, Новый РазборАдреса(), _Адреса);

КонецПроцедуры
