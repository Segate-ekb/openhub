// Новая версия хаба: раз в сутки спросить источник выпусков, запомнить ответ и о каждой новой
// версии один раз сообщить событием; экрану — что известно, без похода в сеть.

Перем Источник;    // ИсточникВыпусков (состояние)
Перем Новизна;     // НовизнаВыпуска (состояние)
Перем Отметки;     // ХранилищеОтметокВыпуска (состояние)
Перем Настройки;   // СервисНастроек (настройки)
Перем Приложение;  // ОписаниеПриложения (настройки) — своя версия хаба
Перем Издатель;    // ИздательСобытий (события)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Одна проверка: спросить источник, запомнить ответ, о версии новее своей и новее уже объявленной
// разослать событие. Выключенная проверка наружу не ходит и отметку не трогает. Отказ источника
// не бросает: он ложится причиной в отметку и строкой в журнал. Сбой хранилища отметки
// перебрасывается — прогон задачи журнал назовёт упавшим.
//
Процедура Проверить() Экспорт

	Если НЕ Включена() Тогда
		Лог.Отладка("Проверка новой версии хаба выключена настройкой %1", КлючПроверки());
		Возврат;
	КонецЕсли;

	Сверить(Адрес());

КонецПроцедуры

// Что известно о новой версии — из отметки последней проверки, без похода к источнику.
//
// Возвращаемое значение:
//  Структура:
//   * Доступна - Булево - проверка включена, последняя удалась и назвала версию строго новее своей.
//   * Новая - Строка - последняя версия у источника; "" — ни одна проверка ещё не удалась.
//   * Своя - Строка - версия этого хаба.
//   * Страница - Строка - страница пакета у источника.
//   * Проверено - Дата, Неопределено - момент последней проверки (UTC).
//   * Ошибка - Строка - причина неудачи последней проверки; "" — удалась.
//
Функция Сведения() Экспорт

	Отметка = Отметки.Прочитать();
	Своя = Приложение.Версия();
	Доступна = Включена() И НЕ ЗначениеЗаполнено(Отметка.Ошибка) И Новизна.Новее(Отметка.Последняя, Своя);

	Возврат Новый Структура("Доступна, Новая, Своя, Страница, Проверено, Ошибка", Доступна, Отметка.Последняя,
		Своя, Источник.Страница(Адрес()), Отметка.Проверено, Отметка.Ошибка);

КонецФункции

// Ключ настройки «проверять ли новую версию».
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючПроверки() Экспорт
	Возврат "oshub.updates.check";
КонецФункции

// Ключ настройки с адресом источника выпусков.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючИсточника() Экспорт
	Возврат "oshub.updates.source";
КонецФункции

// Адрес источника выпусков по умолчанию — карточка OpenHub на hub.oscript.io.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсточникПоУмолчанию() Экспорт
	Возврат "https://hub.oscript.io/api/v1/pools/default/packages/openhub";
КонецФункции

#КонецОбласти

#Область Проверка

// Отметка пишется до события: сорвись рассылка или процесс сразу после неё, о той же версии
// хаб второй раз не сообщит.
Процедура Сверить(Знач АдресИсточника)

	Ответ = Источник.Последняя(АдресИсточника);
	Отметка = Отметки.Прочитать();
	Отметка.Проверено = ТекущаяУниверсальнаяДата();

	Если ЗначениеЗаполнено(Ответ.Причина) Тогда
		Отметка.Ошибка = Ответ.Причина;
		Отметки.Записать(Отметка);
		Лог.Предупреждение("Новая версия хаба не проверена: %1", Ответ.Причина);
		Возврат;
	КонецЕсли;

	Своя = Приложение.Версия();
	Объявить = Новизна.Новее(Ответ.Версия, Своя)
		И (НЕ ЗначениеЗаполнено(Отметка.Объявлена) ИЛИ Новизна.Новее(Ответ.Версия, Отметка.Объявлена));

	Отметка.Ошибка = "";
	Отметка.Последняя = Ответ.Версия;
	Если Объявить Тогда
		Отметка.Объявлена = Ответ.Версия;
	КонецЕсли;
	Отметки.Записать(Отметка);

	Если НЕ Объявить Тогда
		Лог.Отладка("Новая версия хаба: у источника %1, у этого хаба %2 — сообщать не о чем",
			Ответ.Версия, Своя);
		Возврат;
	КонецЕсли;

	Издатель.Опубликовать(Издатель.ТипВышлаВерсияХаба(), Новый Структура("Версия, Текущая, Ссылка",
		Ответ.Версия, Своя, Источник.Страница(АдресИсточника)));
	Лог.Информация("Вышла версия хаба %1 (у этого хаба %2): событие разослано подпискам хаба",
		Ответ.Версия, Своя);

КонецПроцедуры

Функция Включена()
	Возврат Настройки.Флаг(КлючПроверки(), Истина);
КонецФункции

Функция Адрес()
	Возврат Настройки.Текстом(КлючИсточника(), ИсточникПоУмолчанию());
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ИсточникВыпусков") _Источник,
	&Пластилин(Значение = "НовизнаВыпуска") _Новизна,
	&Пластилин(Значение = "ХранилищеОтметокВыпуска") _Отметки,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ОписаниеПриложения") _Приложение,
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Лог _Лог = Неопределено)

	Источник = _Источник;
	Новизна = _Новизна;
	Отметки = _Отметки;
	Настройки = _Настройки;
	Приложение = _Приложение;
	Издатель = _Издатель;
	// лог параметром — только при прямом создании; в контейнере поле прилепит напильник
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
