// События выпусков хаба словами: у источника вышла версия новее установленной.

Перем События;  // ОбъявленияСобытий (события)

#Область ПубличныйИнтерфейс

// Объявления событий выпусков в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияСобытий - события выпусков словами.
//
Функция Объявления() Экспорт
	Возврат События;
КонецФункции

#КонецОбласти

&Прозвище("ОписанияСобытий")
&Порядок(110)
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ИздательСобытий") _Издатель) Экспорт

	События = Новый ОбъявленияСобытий();

	События.ОбъявитьПодписочноеХаба(_Издатель.ТипВышлаВерсияХаба(), "hub.version.released",
		"Вышла новая версия хаба", "У источника выпусков опубликована версия OpenHub новее установленной.");

КонецПроцедуры
