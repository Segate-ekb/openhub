// Ключи настроек выпусков хаба: проверять ли новую версию и у какого источника.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей выпусков в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи выпусков.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(190)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "oshub.updates.check", ЗначениеПоУмолчанию = "") _Проверять = "",
	&Деталька(Значение = "oshub.updates.source", ЗначениеПоУмолчанию = "") _Источник = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	// Политика похода наружу: хаб без выхода в интернет выключает проверку.
	Ключи.Объявить("oshub.updates.check", "булево", Истина, Неопределено, "прикладная", _Проверять);
	// Адрес карточки пакета — с путём: https или http, хост, без данных пользователя.
	Ключи.Объявить("oshub.updates.source", "строка",
		"https://hub.oscript.io/api/v1/pools/default/packages/openhub", _Правила.АдресРесурса(), "прикладная",
		_Источник);

КонецПроцедуры
