// Отвечает ли база: снимок пула соединений и одно дешёвое чтение. Проба не встаёт в очередь
// за соединением — исчерпанный пул она называет отказом по снимку, не делая запроса.

#Использовать errors

Перем Источник;          // ИсточникДанных (autumn-data) — снимок пула соединений
Перем Настройки;         // СервисНастроек (настройки) — строка маленькой таблицы мимо кэша
Перем Ошибки;            // ТекстОшибки (основа)
Перем Замок;             // БлокировкаРесурса — желудь-одиночка живёт под потоками winow
Перем БазаОтвечала;      // Булево, Неопределено — вердикт прошлой пробы; Неопределено — не пробовали
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Состояние базы для тела проб: отвечает ли, снимок пула и причина отказа.
//
// Возвращаемое значение:
//  Структура - status ("ok" либо "unavailable"), pool (busy, free, waiting, created, limit),
//              reason (Строка) — только у отказа.
//
Функция Состояние() Экспорт

	Снимок = Неопределено;
	Отказ = "";
	ОтказЖурналу = "";

	Попытка
		Снимок = СнимокПула();
		Отказ = ПричинаПоСнимку(Снимок);
		ОтказЖурналу = Отказ;
		Если НЕ ЗначениеЗаполнено(Отказ) Тогда
			ПрочитатьСтрокуИзБазы();
		КонецЕсли;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Отказ = ФразаОтказа(Инфо);
		ОтказЖурналу = Ошибки.Причина(Инфо);
	КонецПопытки;

	ЗаписатьСменуВердикта(Отказ, ОтказЖурналу);

	Возврат РазделБазы(Снимок, Отказ);

КонецФункции

// Означает ли снятое состояние, что база отвечает.
//
// Параметры:
//  СостояниеБазы - Структура - результат Состояние().
//
// Возвращаемое значение:
//  Булево.
//
Функция Отвечает(Знач СостояниеБазы) Экспорт
	Возврат СостояниеБазы["status"] = "ok";
КонецФункции

#КонецОбласти

#Область Замер

// Снимок читается до запроса и по нему решается, делать ли запрос вообще.
Функция СнимокПула()

	ПулСоединений = Источник.ПулСоединений();

	Снимок = Новый Структура();
	Снимок.Вставить("Занято", ПулСоединений.КоличествоЗанятых());
	Снимок.Вставить("Свободно", ПулСоединений.КоличествоСвободных());
	Снимок.Вставить("Ожидают", ПулСоединений.КоличествоОжидающих());
	Снимок.Вставить("Создано", ПулСоединений.КоличествоСозданных());
	Снимок.Вставить("Предел", Источник.РазмерПула());

	Возврат Снимок;

КонецФункции

// Пустая строка — пул отдаст соединение без очереди; с пределом сравниваются занятые места
// вместе с бронью под открываемое соединение, а не соединения у потоков.
Функция ПричинаПоСнимку(Знач Снимок)

	Если Снимок.Свободно > 0 Тогда
		Возврат "";
	КонецЕсли;

	// нулевой предел — пул без предела: исчерпать его нечем
	ПулИсчерпан = Снимок.Ожидают > 0
		ИЛИ (Снимок.Предел > 0 И Снимок.Создано >= Снимок.Предел);

	Если НЕ ПулИсчерпан Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(
		"пул соединений исчерпан: занято %1, свободных нет, ждут %2, мест занято %3 из %4",
		Снимок.Занято, Снимок.Ожидают, Снимок.Создано, Снимок.Предел);

КонецФункции

Процедура ПрочитатьСтрокуИзБазы()
	Настройки.ПрочитатьСтрокуИзБазы();
КонецПроцедуры

#КонецОбласти

#Область ФормаОтвета

Функция РазделБазы(Знач Снимок, Знач Отказ)

	Отвечает = НЕ ЗначениеЗаполнено(Отказ);

	Данные = Новый Структура();
	Данные.Вставить("status", ?(Отвечает, "ok", "unavailable"));
	// снимка нет, когда источник закрыт и пула у него уже нет
	Если Снимок <> Неопределено Тогда
		Данные.Вставить("pool", РазделПула(Снимок));
	КонецЕсли;
	Если НЕ Отвечает Тогда
		Данные.Вставить("reason", Отказ);
	КонецЕсли;

	Возврат Данные;

КонецФункции

Функция РазделПула(Знач Снимок)

	Данные = Новый Структура();
	Данные.Вставить("busy", Снимок.Занято);
	Данные.Вставить("free", Снимок.Свободно);
	Данные.Вставить("waiting", Снимок.Ожидают);
	Данные.Вставить("created", Снимок.Создано);
	Данные.Вставить("limit", Снимок.Предел);

	Возврат Данные;

КонецФункции

// Адреса проб открыты всем: в тело — фраза без путей и строк кода, полная причина — в журнал.
Функция ФразаОтказа(Знач Инфо)

	Фраза = Ошибки.ДляЧеловека(Инфо);

	Возврат ?(ЗначениеЗаполнено(Фраза), Фраза, "обращение к базе завершилось ошибкой");

КонецФункции

#КонецОбласти

#Область ЖурналСмены

// В журнал — смена вердикта, а не каждая проба: пробу зовут раз в несколько секунд.
Процедура ЗаписатьСменуВердикта(Знач Отказ, Знач ОтказЖурналу)

	Отвечает = НЕ ЗначениеЗаполнено(Отказ);

	Если НЕ ВердиктСменился(Отвечает) Тогда
		Возврат;
	КонецЕсли;

	Если Отвечает Тогда
		Лог.Информация("Проба базы: база отвечает");
	Иначе
		Лог.Предупреждение("Проба базы: база не отвечает — %1", ОтказЖурналу);
	КонецЕсли;

КонецПроцедуры

// Под замком: одновременные пробы не записывают смену дважды.
Функция ВердиктСменился(Знач Отвечает)

	Замок.Заблокировать();
	Попытка
		Сменился = БазаОтвечала <> Отвечает;
		БазаОтвечала = Отвечает;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

	Возврат Сменился;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ИсточникДанных") _Источник,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	Источник = _Источник;
	Настройки = _Настройки;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
	БазаОтвечала = Неопределено;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
