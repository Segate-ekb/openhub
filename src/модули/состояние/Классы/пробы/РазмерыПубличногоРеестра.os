// Сколько пулов и пакетов видит анонимный посетитель — для чисел хаба.

Перем СервисПулов;   // СервисПулов (реестр)
Перем СервисПакетов; // СервисПакетов (реестр)
Перем Права;         // СервисПрав (права) — признак публичности пула
Перем Лог;
Перем Ошибки;        // ТекстОшибки (основа)

#Область ПубличныйИнтерфейс

// Снимок размеров публичной части реестра. Сбой подсчёта наружу не выбрасывается:
// числа -1, причина — в журнале.
//
// Параметры:
//  Пулы - Массив, Неопределено - пулы реестра, уже прочитанные вызывающим; Неопределено —
//         прочитать их самому (необязательный).
//
// Возвращаемое значение:
//  Структура - Пулы (Число), Пакеты (Число); -1 в обоих полях, если подсчёт сорвался.
//
&Наблюдаемый("metrics.registry_sizes")
Функция Снимок(Знач Пулы = Неопределено) Экспорт

	Попытка
		Публичные = ИдентификаторыПубличныхПулов(Пулы);
		Возврат Новый Структура("Пулы, Пакеты", Публичные.Количество(),
			СервисПакетов.КоличествоВидимыхПакетовПулов(Публичные));
	Исключение
		Лог.Предупреждение("Размеры публичного реестра не посчитаны, отдаю -1: %1",
			Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат Новый Структура("Пулы, Пакеты", -1, -1);
	КонецПопытки;

КонецФункции

// Публичность — правило прав: пулы читаются (или берутся у вызывающего), пакеты — одним счётом.
Функция ИдентификаторыПубличныхПулов(Знач Пулы)

	Идентификаторы = Новый Массив();
	Для Каждого Пул Из ?(Пулы = Неопределено, СервисПулов.ВсеПулы(), Пулы) Цикл
		Если Права.ПулПубличный(Пул) Тогда
			Идентификаторы.Добавить(Пул.Идентификатор);
		КонецЕсли;
	КонецЦикла;

	Возврат Идентификаторы;

КонецФункции

// Сорвался ли подсчёт: отрицательное число в метрику не годится.
//
// Параметры:
//  Значение - Число - число из снимка.
//
// Возвращаемое значение:
//  Булево - Истина, если число посчитано.
//
Функция Посчитано(Знач Значение) Экспорт
	Возврат Значение >= 0;
КонецФункции

#КонецОбласти

&Прозвище("РазмерыПубличногоРеестра")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисПрав") _Права,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено)

	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	Права = _Права;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);

	// лог параметром: инъекция в поле доезжает только после конструктора
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "РазмерыПубличногоРеестра созданы без лога — сбой подсчёта был бы немым";
	КонецЕсли;
	Лог = _Лог;

КонецПроцедуры
