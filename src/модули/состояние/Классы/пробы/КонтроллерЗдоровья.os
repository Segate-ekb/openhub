// Проба живости GET /health: 200, пока процесс жив, с версией, аптаймом и состоянием базы.

Перем Живость;   // ЖивостьХаба — тело пробы
Перем Ответы;    // ОтветыAPI (основа)

// Живость хаба.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow, заполняется JSON-состоянием.
//
&ТочкаМаршрута("/health")
Процедура Здоровье(Ответ) Экспорт
	Ответы.JSON(Ответ, 200, Живость.Сводка());
КонецПроцедуры

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЖивостьХаба") _Живость,
	&Пластилин(Значение = "ОтветыAPI") _Ответы)

	Живость = _Живость;
	Ответы = _Ответы;

КонецПроцедуры
