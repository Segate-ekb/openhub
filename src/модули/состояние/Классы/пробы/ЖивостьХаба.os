// Живость хаба одним телом: статус, версия, аптайм и состояние базы. Тело отдают /health
// и /api/v1/health, шапку — ещё и /api/v1/metrics.

Перем СостояниеХаба;       // СостояниеХаба — аптайм приложения
Перем ОписаниеПриложения;  // ОписаниеПриложения (настройки) — версия хаба
Перем База;                // ПробаБазы — отвечает ли база и снимок её пула

#Область ПубличныйИнтерфейс

// Тело пробы живости. База названа, но на живость не влияет: её отказ — дело готовности.
//
// Возвращаемое значение:
//  Структура - status, version, uptime_seconds, database.
//
Функция Сводка() Экспорт
	Данные = Шапка();
	Данные.Вставить("database", База.Состояние());
	Возврат Данные;
КонецФункции

// Шапка ответов о хабе: статус, версия и аптайм.
//
// Возвращаемое значение:
//  Структура - status, version, uptime_seconds.
//
Функция Шапка() Экспорт
	Данные = Новый Структура();
	Данные.Вставить("status", "ok");
	Данные.Вставить("version", ОписаниеПриложения.Версия());
	Данные.Вставить("uptime_seconds", СостояниеХаба.АптаймСекунд());
	Возврат Данные;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СостояниеХаба") _СостояниеХаба,
	&Пластилин(Значение = "ОписаниеПриложения") _ОписаниеПриложения,
	&Пластилин(Значение = "ПробаБазы") _База)

	СостояниеХаба = _СостояниеХаба;
	ОписаниеПриложения = _ОписаниеПриложения;
	База = _База;

КонецПроцедуры
