// Единая точка доступа к настройкам приложения (порт, каталог данных).
// Некорректные значения не роняют старт: деградация к дефолту с предупреждением в лог.

Перем ЗначениеПорта;               // Число
Перем ЗначениеКаталогаДанных;      // Строка - абсолютный путь

Перем Лог;

// Порт HTTP-сервера хаба.
//
// Возвращаемое значение:
//  Число - действующий порт.
//
Функция Порт() Экспорт
	Возврат ЗначениеПорта;
КонецФункции

// Каталог данных хаба (артефакты, кэш, файловая БД).
//
// Возвращаемое значение:
//  Строка - абсолютный путь.
//
Функция КаталогДанных() Экспорт
	Возврат ЗначениеКаталогаДанных;
КонецФункции

// Порт HTTP-сервера по умолчанию; совпадает с деталькой "winow.Порт"
// в autumn-properties.json.
//
// Возвращаемое значение:
//  Число - порт.
//
Функция ПортПоУмолчанию() Экспорт
	Возврат 3333;
КонецФункции

// Каталог данных по умолчанию относительно каталога запуска.
//
// Возвращаемое значение:
//  Строка - путь.
//
Функция КаталогДанныхПоУмолчанию() Экспорт
	Возврат "./data";
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Деталька(Значение = "winow.Порт", ЗначениеПоУмолчанию = 0) ПортСервера = Неопределено,
	&Деталька(Значение = "oshub.storage.root", ЗначениеПоУмолчанию = "") ПутьККаталогуДанных = Неопределено,
	&Лог _Лог = Неопределено)

	// Лог параметром, а не полем: инъекция в поле доезжает только после ПриСозданииОбъекта.
	Если _Лог = Неопределено Тогда
		ВызватьИсключение "КонфигурацияХаба создана без лога — контейнер или тест обязан его передать";
	КонецЕсли;
	Лог = _Лог;

	ЗначениеПорта = ПортИлиУмолчание(ПортСервера);

	Если НЕ ЗначениеЗаполнено(ПутьККаталогуДанных) Тогда
		ПутьККаталогуДанных = КаталогДанныхПоУмолчанию();
	КонецЕсли;
	ЗначениеКаталогаДанных = Новый Файл(Строка(ПутьККаталогуДанных)).ПолноеИмя;

КонецПроцедуры

Функция ПортИлиУмолчание(Знач ЗначениеДетальки)

	Если НЕ ЗначениеЗаполнено(ЗначениеДетальки) Тогда
		Возврат ПортПоУмолчанию();
	КонецЕсли;

	Попытка
		Возврат Число(ЗначениеДетальки);
	Исключение
		Лог.Предупреждение("Значение порта <%1> не является числом, использую порт %2",
			ЗначениеДетальки, ПортПоУмолчанию());
		Возврат ПортПоУмолчанию();
	КонецПопытки;

КонецФункции
