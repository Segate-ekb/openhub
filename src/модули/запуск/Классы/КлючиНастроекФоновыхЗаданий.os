// Ключи настроек планировщика фоновых заданий: выключатель, шаг тика и уборка реестра заданий.
// Планировщик читает их деталькой сам; интервалы задач объявляют модули самих задач.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей фоновых заданий в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи фоновых заданий.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(30)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "oshub.jobs.enabled", ЗначениеПоУмолчанию = "") _ЗадачиВключены = "",
	&Деталька(Значение = "oshub.jobs.tick_interval_ms", ЗначениеПоУмолчанию = "") _ИнтервалТика = "",
	&Деталька(Значение = "oshub.jobs.registry_gc_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалУборкиРеестра = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	// расписание вшивается в планировщик при сборке — карточки «управляется конфигурацией»
	Ключи.Объявить("oshub.jobs.enabled", "булево", Истина, Неопределено, "bootstrap", _ЗадачиВключены);
	Ключи.Объявить("oshub.jobs.tick_interval_ms", "целое", 1000, _Правила.Минимум(1), "bootstrap",
		_ИнтервалТика);

	// реестр заданий платформы сам завершённых не отпускает; снизу пять секунд
	Ключи.Объявить("oshub.jobs.registry_gc_interval_sec", "целое", 60, _Правила.Минимум(5), "bootstrap",
		_ИнтервалУборкиРеестра);

КонецПроцедуры
