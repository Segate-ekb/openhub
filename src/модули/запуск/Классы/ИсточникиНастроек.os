// Прочитанные настройки порознь по источникам — файлы настроек, окружение, программные
// детальки: правила загрузки решают по тому, откуда пришло значение.

#Использовать configor

Перем ИндексФайлов;          // Соответствие: ключ (НРег) → значение из файлов настроек
Перем ПеременныеПровайдера;  // Соответствие: ключ провайдера окружения → значение, пустое тоже
Перем ЗаданоОкружением;      // Соответствие: ключ провайдера окружения → непустое значение
Перем ИндексОкружения;       // Соответствие: ключ (НРег) → непустое значение переменной
Перем ИндексПрограммных;     // Соответствие: ключ (НРег) → программная деталька

#Область ПубличныйИнтерфейс

// Значение ключа в файлах настроек.
//
// Параметры:
//  Ключ - Строка - ключ настройки; регистр не значим.
//
// Возвращаемое значение:
//  Произвольный - значение либо Неопределено.
//
Функция ИзФайлов(Знач Ключ) Экспорт
	Возврат ИндексФайлов.Получить(НРег(Ключ));
КонецФункции

// Значение ключа из переменной окружения. Пустая переменная ничего не задаёт: процесс
// не умеет снять переменную, только обнулить.
//
// Параметры:
//  Ключ - Строка - ключ настройки; регистр не значим.
//
// Возвращаемое значение:
//  Произвольный - непустое значение либо Неопределено.
//
Функция ИзОкружения(Знач Ключ) Экспорт
	Возврат ИндексОкружения.Получить(НРег(Ключ));
КонецФункции

// Программная деталька вызывающего.
//
// Параметры:
//  Ключ - Строка - ключ настройки; регистр не значим.
//
// Возвращаемое значение:
//  Произвольный - значение либо Неопределено.
//
Функция Программно(Знач Ключ) Экспорт
	Возврат ИндексПрограммных.Получить(НРег(Ключ));
КонецФункции

// Значение по старшинству источников: программная деталька, окружение, файлы.
//
// Параметры:
//  Ключ - Строка - ключ настройки; регистр не значим.
//
// Возвращаемое значение:
//  Произвольный - значение либо Неопределено.
//
Функция Действующее(Знач Ключ) Экспорт

	Для Каждого Значение Из ЗначенияПоСтаршинству(Ключ) Цикл
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Непустые переменные окружения так, как их отдал провайдер окружения configor. Копия:
// прочитанное вызывающий не меняет.
//
// Возвращаемое значение:
//  Соответствие - ключ провайдера (OSHUB.STORAGE.ROOT) → значение.
//
Функция ПеременныеОкружения() Экспорт

	Копия = Новый Соответствие();
	Для Каждого Переменная Из ЗаданоОкружением Цикл
		Копия.Вставить(Переменная.Ключ, Переменная.Значение);
	КонецЦикла;
	Возврат Копия;

КонецФункции

// Листья узла, заданные окружением родными именами.
//
// Параметры:
//  КлючУзла - Строка - ключ узла ("data.ИсточникиДанных").
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Ключ - Строка - ключ провайдера окружения в написании переменной.
//   * Путь - Массив из Строка - путь листа под узлом.
//   * Значение - Строка - значение переменной.
//
Функция ЛистьяОкружения(Знач КлючУзла) Экспорт

	Префикс = НРег(КлючУзла) + ".";
	Листья = Новый Массив();
	Для Каждого Переменная Из ЗаданоОкружением Цикл
		Если СтрНачинаетсяС(НРег(Переменная.Ключ), Префикс) Тогда
			Путь = СтрРазделить(Сред(Переменная.Ключ, СтрДлина(Префикс) + 1), ".", Ложь);
			Листья.Добавить(Новый Структура("Ключ, Путь, Значение", Переменная.Ключ, Путь, Переменная.Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Листья;

КонецФункции

// Значения ключей так, как их увидит Поделка, собранная из тех же источников и деталек:
// в порядке configor — окружение, файлы, затем детальки.
//
// Параметры:
//  Детальки - Соответствие - программные детальки Совета.
//
// Возвращаемое значение:
//  Соответствие - ключ (НРег) → значение.
//
Функция КакУвидитПоделка(Знач Детальки) Экспорт

	Итог = ИндексКакВConfigor(ПеременныеПровайдера);
	Для Каждого Прочитанный Из ИндексФайлов Цикл
		Итог.Вставить(Прочитанный.Ключ, Прочитанный.Значение);
	КонецЦикла;

	Для Каждого Деталька Из Детальки Цикл
		Добавка = Новый Соответствие();
		Добавка.Вставить(Деталька.Ключ, Деталька.Значение);
		Для Каждого Элемент Из ИндексКакВConfigor(Добавка) Цикл
			Итог.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЦикла;

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначенияПоСтаршинству(Знач Ключ)

	Значения = Новый Массив();
	Значения.Добавить(Программно(Ключ));
	Значения.Добавить(ИзОкружения(Ключ));
	Значения.Добавить(ИзФайлов(Ключ));
	Возврат Значения;

КонецФункции

// Плоский индекс configor: ключ через точку в нижнем регистре, узлы — и целиком, и листьями.
Функция ИндексКакВConfigor(Знач Дерево)
	Возврат Новый ИндексЗначений().Коллекция(Дерево).ПолучитьИндекс();
КонецФункции

Функция Задано(Знач Значение)
	Возврат Значение <> Неопределено И НЕ (ТипЗнч(Значение) = Тип("Строка") И ПустаяСтрока(Значение));
КонецФункции

#КонецОбласти

// Параметры:
//  ИзФайлов - Соответствие - дерево, прочитанное configor из файлов настроек без окружения.
//  ИзОкружения - Соответствие - плоская карта провайдера окружения configor:
//                ключ через точку (OSHUB.STORAGE.ROOT) → значение переменной.
//  Программные - Соответствие - программные детальки вызывающего.
//
Процедура ПриСозданииОбъекта(Знач ИзФайлов, Знач ИзОкружения, Знач Программные)

	ИндексФайлов = ИндексКакВConfigor(ИзФайлов);
	ИндексПрограммных = ИндексКакВConfigor(Программные);
	ПеременныеПровайдера = ИзОкружения;

	ЗаданоОкружением = Новый Соответствие();
	ИндексОкружения = Новый Соответствие();
	Для Каждого Переменная Из ИзОкружения Цикл
		Если Задано(Переменная.Значение) Тогда
			ЗаданоОкружением.Вставить(Переменная.Ключ, Переменная.Значение);
			ИндексОкружения.Вставить(НРег(Переменная.Ключ), Переменная.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
