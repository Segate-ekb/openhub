// Задача при готовности: отпускает таблицы рефлексии определений желудей ОСени, нужные только
// на сборке контейнера; поля определений сбрасывает только у одиночек. Устройство ОСени сверяется целиком до первого изменения: не сошлось — ничего не трогает.

#Использовать autumn
#Использовать reflector

Перем Поделка;    // Поделка (autumn)
Перем Включено;   // Булево — oshub.start.release_bean_metadata
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Контракт ЗадачаПриГотовности: один прогон освобождения. Любое расхождение с ожидаемым
// устройством ОСени и любое исключение — предупреждение в журнал, контейнер не меняется.
//
&Наблюдаемый("job.bean_metadata_release")
Процедура Исполнить() Экспорт

	Если НЕ Включено Тогда
		Лог.Отладка("Освобождение метаданных желудей выключено настройкой");
		Возврат;
	КонецЕсли;

	Попытка
		Освободить();
	Исключение
		Лог.Предупреждение("Метаданные желудей не освобождены: %1",
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

Процедура Освободить()

	Рефлектор = Новый Рефлектор();
	Одиночка = ХарактерыЖелудей.Одиночка();
	Определения = Новый Массив();
	Для Каждого ИмяИОпределение Из Поделка.ПолучитьОпределенияЖелудей() Цикл
		Определения.Добавить(ИмяИОпределение.Значение);
	КонецЦикла;

	Для Каждого Определение Из Определения Цикл
		Расхождение = РасхождениеСОжидаемымУстройством(Рефлектор, Определение);
		Если Расхождение <> "" Тогда
			Лог.Предупреждение("Метаданные желудей не освобождены: устройство ОСени не то, что ожидалось (%1)",
				Расхождение);
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ОтпущеноСтрок = 0;
	Для Каждого Определение Из Определения Цикл
		ОтпущеноСтрок = ОтпущеноСтрок + ОтпуститьТаблицы(Рефлектор, Определение, Одиночка);
	КонецЦикла;

	Лог.Информация("Метаданные желудей освобождены: определений %1, строк таблиц рефлексии %2",
		Определения.Количество(), ОтпущеноСтрок);

КонецПроцедуры

// Пустая строка — определение устроено как ожидалось; иначе — что именно не сошлось.
Функция РасхождениеСОжидаемымУстройством(Рефлектор, Определение)

	Если ТипЗнч(Определение) <> Тип("ОпределениеЖелудя") Тогда
		Возврат "определение типа " + ТипЗнч(Определение);
	КонецЕсли;

	Поля = Новый Соответствие();
	Для Каждого Поле Из Рефлектор.ПолучитьТаблицуСвойств(Определение, Истина) Цикл
		Поля.Вставить(Поле.Имя, Рефлектор.ПолучитьСвойство(Определение, Поле.Имя));
	КонецЦикла;

	Ожидания = ОжидаемыеПоля();
	Для Каждого Ожидание Из Ожидания Цикл
		Если НЕ ЕстьПоле(Поля, Ожидание.Ключ) Тогда
			Возврат СтрШаблон("у %1 нет поля %2", Определение.Имя(), Ожидание.Ключ);
		КонецЕсли;
		Значение = Поля.Получить(Ожидание.Ключ);
		Если Значение <> Неопределено И Ожидание.Значение.Найти(ТипЗнч(Значение)) = Неопределено Тогда
			Возврат СтрШаблон("у %1 поле %2 типа %3", Определение.Имя(), Ожидание.Ключ, ТипЗнч(Значение));
		КонецЕсли;
	КонецЦикла;

	Если ТипЗнч(Определение.Характер()) <> Тип("Строка") Тогда
		Возврат СтрШаблон("у %1 характер — %2", Определение.Имя(), ТипЗнч(Определение.Характер()));
	КонецЕсли;

	Если ТипЗнч(Определение.ТипЖелудя()) <> Тип("Тип") Тогда
		Возврат СтрШаблон("у %1 тип желудя — %2", Определение.Имя(), ТипЗнч(Определение.ТипЖелудя()));
	КонецЕсли;

	Завязь = Определение.Завязь();
	Если ТипЗнч(Завязь) <> Тип("Завязь") Тогда
		Возврат СтрШаблон("у %1 завязь типа %2", Определение.Имя(), ТипЗнч(Завязь));
	КонецЕсли;
	Строка = Завязь.ДанныеМетода();
	Если ТипЗнч(Строка) <> Тип("СтрокаТаблицыЗначений") Тогда
		Возврат СтрШаблон("у %1 данные метода завязи типа %2", Определение.Имя(), ТипЗнч(Строка));
	КонецЕсли;
	Если ТипЗнч(Строка.Владелец()) <> Тип("ТаблицаЗначений") Тогда
		Возврат СтрШаблон("у %1 владелец строки завязи типа %2", Определение.Имя(), ТипЗнч(Строка.Владелец()));
	КонецЕсли;

	Возврат "";

КонецФункции

// Поле → допустимые типы значения; Неопределено допустимо у всех.
Функция ОжидаемыеПоля()

	Таблицы = Новый Массив();
	Таблицы.Добавить(Тип("ТаблицаЗначений"));
	Кэш = Новый Массив();
	Кэш.Добавить(Тип("Соответствие"));
	Рефлекторы = Новый Массив();
	Рефлекторы.Добавить(Тип("РефлекторОбъекта"));

	Ожидания = Новый Соответствие();
	Ожидания.Вставить("Методы", Таблицы);
	Ожидания.Вставить("Свойства", Таблицы);
	Ожидания.Вставить("КешМетодовПоАннотациям", Кэш);
	Ожидания.Вставить("_РефлекторОбъекта", Рефлекторы);
	Возврат Ожидания;

КонецФункции

Функция ЕстьПоле(Поля, Имя)
	Для Каждого Поле Из Поля Цикл
		Если Поле.Ключ = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Таблицу-владельца строки завязи держат аргументы конструктора Завязи (знание/библиотеки/autumn.md).
Функция ОтпуститьТаблицы(Рефлектор, Определение, Одиночка)

	Владелец = Определение.Завязь().ДанныеМетода().Владелец();
	Отпущено = Владелец.Количество();
	Владелец.Очистить();

	// поля сбрасываются только у одиночек: они уже созданы, и ОСень их метаданные больше не читает;
	// компанейским поля нужны на каждом создании, ленивая пересборка под потоками запросов — гонка
	Если Определение.Характер() = Одиночка Тогда
		Рефлектор.УстановитьСвойство(Определение, "Методы", Неопределено);
		Рефлектор.УстановитьСвойство(Определение, "Свойства", Неопределено);
		Рефлектор.УстановитьСвойство(Определение, "КешМетодовПоАннотациям", Новый Соответствие());
		Рефлектор.УстановитьСвойство(Определение, "_РефлекторОбъекта", Новый РефлекторОбъекта(Определение.ТипЖелудя()));
	КонецЕсли;

	Возврат Отпущено;

КонецФункции

&Прозвище("ЗадачаПриГотовности")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Поделка") _Поделка,
	&Деталька(Значение = "oshub.start.release_bean_metadata", ЗначениеПоУмолчанию = "") _Включено = "",
	&Лог _Лог = Неопределено)

	Поделка = _Поделка;
	Включено = Новый ПриведениеФлагов().ФлагИстина(_Включено, Истина);
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
