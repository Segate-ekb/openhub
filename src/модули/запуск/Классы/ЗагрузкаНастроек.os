// Загрузка настроек хаба — единственная дверь, через которую точка входа получает Совет
// для Новый Поделка(Совет). Окружение руками не читает: спрашивает configor тем же составом
// источников, что и ОСень, и к прочитанному применяет правила трёх видов — окружение
// перебивает файл, производные ключи, устройство хаба. Умолчаний настроек хаба здесь нет:
// они живут у потребителя; ниже только умолчания хаба для чужих деталек, отдельной секцией.

#Использовать autumn
#Использовать configor

Перем КаталогПриложений;      // Строка — каталог модулей хаба для winow; пусто — процесс не сервер
Перем СпособыВыводаЖурнала;   // Соответствие: имя способа вывода → класс; Неопределено — журнал не связывается
Перем Имена;                  // ИменаПеременныхОкружения (настройки)

Перем Индекс;                 // Соответствие: ключ (НРег) → значение, как его прочитал configor
Перем ИзОкружения;            // Соответствие: ключ (НРег) → непустое значение переменной окружения
Перем Окружение;              // Соответствие: ключ, как его отдал провайдер окружения → значение
Перем Итог;                   // Соответствие: ключ (НРег) → значение, как его увидит Поделка
Перем Корень;                 // Строка — абсолютный корень данных
Перем СписокЗамечаний;        // Массив из Строка

#Область ПубличныйИнтерфейс

// Совет для Новый Поделка(Совет): детальки, собранные правилами поверх того, что прочитал
// configor из файла настроек и окружения.
//
// Параметры:
//  Основа - СоветДругогоМастера - откуда читать: имя файла настроек, каталог его поиска
//           и префикс переменных берутся из неё; программные детальки основы сильнее
//           вычисленных (необязательный, по умолчанию — Совет ОСени как есть).
//
// Возвращаемое значение:
//  СоветДругогоМастера - основа с заполненными детальками.
//
Функция Совет(Знач Основа = Неопределено) Экспорт

	Если Основа = Неопределено Тогда
		Основа = Новый СоветДругогоМастера();
	КонецЕсли;

	Провайдер = Новый ПровайдерПараметровENV(Основа.ПрефиксПеременныхСреды());
	Детальки = ДеталькиПоверх(ПрочитатьКакОсень(Основа), Провайдер.ПрочитатьПараметры(Новый Структура()));

	Для Каждого Заданная Из Основа.ЗначенияДеталек() Цикл
		Детальки.Вставить(Заданная.Ключ, Заданная.Значение);
		ДобавитьВИтог(Заданная.Ключ, Заданная.Значение);
	КонецЦикла;

	Возврат Основа.ЗначенияДеталек(Детальки);

КонецФункции

// Правила загрузки над уже прочитанным: чистая функция, окружения и файлов не касается.
//
// Параметры:
//  Прочитанное - Соответствие - дерево, собранное configor из файла настроек и окружения.
//  ИзПровайдераОкружения - Соответствие - плоская карта провайдера окружения configor:
//                          ключ через точку (OSHUB.STORAGE.ROOT) → значение переменной.
//
// Возвращаемое значение:
//  Соответствие - программные детальки для Совета.
//
Функция ДеталькиПоверх(Знач Прочитанное, Знач ИзПровайдераОкружения) Экспорт

	СписокЗамечаний = Новый Массив();
	Индекс = ИндексКакВConfigor(Прочитанное);
	Окружение = ИзПровайдераОкружения;
	ИзОкружения = Новый Соответствие();
	Для Каждого Переменная Из Окружение Цикл
		Если Задано(Переменная.Значение) Тогда
			ИзОкружения.Вставить(НРег(Переменная.Ключ), Переменная.Значение);
		КонецЕсли;
	КонецЦикла;

	Детальки = Новый Соответствие();

	ОкружениеПеребиваетФайл(Детальки);
	Производные(Детальки);
	УстройствоХаба(Детальки);
	УмолчанияХабаДляЧужихДеталек(Детальки);

	Итог = Новый Соответствие();
	Для Каждого Прочитанный Из Индекс Цикл
		Итог.Вставить(Прочитанный.Ключ, Прочитанный.Значение);
	КонецЦикла;
	Для Каждого Деталька Из Детальки Цикл
		ДобавитьВИтог(Деталька.Ключ, Деталька.Значение);
	КонецЦикла;

	Возврат Детальки;

КонецФункции

// Значение ключа так, как его увидит Поделка, собранная из выданного Совета.
//
// Параметры:
//  Ключ - Строка - ключ детальки; регистр не значим.
//
// Возвращаемое значение:
//  Произвольный - значение либо Неопределено, если ключа не знает никто.
//
Функция Значение(Знач Ключ) Экспорт
	ПроверитьЗагружено();
	Возврат Итог.Получить(НРег(Ключ));
КонецФункции

// Абсолютный корень данных хаба: от него считаются умолчания каталогов для чужих деталек.
//
// Возвращаемое значение:
//  Строка - путь.
//
Функция КореньДанных() Экспорт
	ПроверитьЗагружено();
	Возврат Корень;
КонецФункции

// Создаёт корень данных и каталог файловой базы: КоннекторJSON сам каталог не создаёт,
// и первый старт падал бы DirectoryNotFound.
//
Процедура СоздатьКаталогиДанных() Экспорт

	ПроверитьЗагружено();
	СоздатьКаталогЕслиНет(Корень);

	ИсточникДанных = Значение("data.ИсточникиДанных");
	Если ТипЗнч(ИсточникДанных) = Тип("Соответствие")
		И СтрНачинаетсяС(ВРег(Строка(ИсточникДанных["ТипКоннектора"])), ВРег("КоннекторJSON")) Тогда
		СоздатьКаталогЕслиНет(ИсточникДанных["СтрокаСоединения"]);
	КонецЕсли;

КонецПроцедуры

// Что оператору сказать про отвергнутое при загрузке. Пустой массив — всё понято.
//
// Возвращаемое значение:
//  Массив из Строка - готовые строки предупреждений.
//
Функция Замечания() Экспорт
	Возврат ?(СписокЗамечаний = Неопределено, Новый Массив(), СписокЗамечаний);
КонецФункции

// Кэши чтений из базы, которым хаб задаёт срок жизни: общего срока у autumn-cache нет,
// и кэш, которого нет в этом перечне, живёт бессрочно.
//
// Возвращаемое значение:
//  Массив из Строка - имена кэшей.
//
Функция КэшиЧтенийИзБазы() Экспорт

	Кэши = Новый Массив();
	Кэши.Добавить("пулы");
	Кэши.Добавить("источникиПула");
	Кэши.Добавить("учётки");
	Кэши.Добавить("пакеты");
	Кэши.Добавить("пакетыПула");
	Кэши.Добавить("пакетыПулов");
	Кэши.Добавить("новинки");
	Кэши.Добавить("версииПакета");
	Кэши.Добавить("происхождениеПакета");
	Кэши.Добавить("каналыПакета");
	Кэши.Добавить("скачиванияВерсий");
	Возврат Кэши;

КонецФункции

#КонецОбласти

#Область ОкружениеПеребиваетФайл

// Каждая непустая переменная, прочитанная провайдером окружения configor, кладётся
// программной деталькой: у тех приоритет старше файла, а у самого провайдера окружения —
// младше. Пустая переменная не в счёт: процесс не умеет снять переменную, только обнулить.
Процедура ОкружениеПеребиваетФайл(Детальки)

	Для Каждого Переменная Из Окружение Цикл
		Если Задано(Переменная.Значение) Тогда
			Детальки.Вставить(КлючПоверхОкружения(Переменная.Ключ), Переменная.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// configor сливает источники по точному написанию ключа: ключ, совпавший буква в букву
// с ключом провайдера окружения, влился бы в него и остался позади файла.
Функция КлючПоверхОкружения(Знач Ключ)
	Нижний = НРег(Ключ);
	Возврат ?(Нижний = Ключ, ВРег(Ключ), Нижний);
КонецФункции

#КонецОбласти

#Область Производные

// Псевдонимы и узлы. Производная ставится, только если ключ-источник кто-то задал,
// и уступает родному имени цели, заданному окружением.
Процедура Производные(Детальки)

	ПоложитьПроизводную(Детальки, "winow.Порт", ЧислоПорта(Действующее("oshub.port")));
	ПоложитьПроизводную(Детальки, "otel.entity.query-text", Действующее("otel.entity.query.text"));
	ПоложитьПроизводную(Детальки, "cache.артефакты.Каталог", Действующее("oshub.cache.artifacts.dir"));
	ПоложитьПроизводную(Детальки, "cache.артефакты.Предел", Действующее("oshub.cache.artifacts.limit_bytes"));
	ПоложитьПроизводную(Детальки, "cache.ПределПамяти", Действующее("oshub.cache.memory.limit_bytes"));

	СрокЖизни = Действующее("oshub.cache.memory.ttl_sec");
	Для Каждого ИмяКэша Из КэшиЧтенийИзБазы() Цикл
		ПоложитьПроизводную(Детальки, "cache." + ИмяКэша + ".СрокЖизни", СрокЖизни);
	КонецЦикла;

	ПоложитьУзел(Детальки, "data.ИсточникиДанных", ЛистьяПсевдонимовБазы());
	Если Детальки.Получить("data.ИсточникиДанных") <> Неопределено Тогда
		РазмерПулаЧислом(Детальки["data.ИсточникиДанных"]);
	КонецЕсли;
	ПоложитьУзел(Детальки, "oshub.oidc", Новый Массив());

КонецПроцедуры

Процедура ПоложитьПроизводную(Детальки, Знач Цель, Знач Значение)

	Если НЕ Задано(Значение) ИЛИ ИзОкружения.Получить(НРег(Цель)) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Детальки.Вставить(Цель, Значение);

КонецПроцедуры

// winow отдаёт значение детальки прямо в TCP-сервер, поэтому число приходит числом.
Функция ЧислоПорта(Знач Написанное)

	Если НЕ Задано(Написанное) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат Число(Написанное);
	Исключение
		СписокЗамечаний.Добавить(СтрШаблон("%1=%2 не является числом — порт берётся из настроек",
			Имена.Переменная("winow.Порт"), Написанное));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Листья узла базы из псевдонимов oshub.db.*. Пара «коннектор, строка соединения» берётся
// только тогда, когда окружение не назвало ни одного из этих листьев родным именем: пара
// приходит из одного семейства имён, иначе родной коннектор склеился бы со строкой
// соединения, которую зашил образ. Размер пула от пары не зависит.
Функция ЛистьяПсевдонимовБазы()

	Листья = Новый Массив();
	ДобавитьЛист(Листья, "РазмерПула", Действующее("oshub.db.pool.size"));

	Для Каждого Лист Из ЛистьяОкружения("data.ИсточникиДанных") Цикл
		Имя = НРег(Лист.Путь[Лист.Путь.ВГраница()]);
		Если Имя = НРег("ТипКоннектора") ИЛИ Имя = НРег("СтрокаСоединения") Тогда
			Возврат Листья;
		КонецЕсли;
	КонецЦикла;

	ДобавитьЛист(Листья, "ТипКоннектора", Действующее("oshub.db.connector"));
	ДобавитьЛист(Листья, "СтрокаСоединения", Действующее("oshub.db.connection"));
	Возврат Листья;

КонецФункции

// Пул соединений entity принимает только число, а из окружения лист приходит строкой.
Процедура РазмерПулаЧислом(Узел)

	Имя = ИмяВУзле(Узел, "РазмерПула");
	Написанное = Узел.Получить(Имя);
	Если ТипЗнч(Написанное) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Узел.Вставить(Имя, Число(Написанное));
	Исключение
		СписокЗамечаний.Добавить(СтрШаблон("data.ИсточникиДанных.РазмерПула=%1 не является числом",
			Написанное));
	КонецПопытки;

КонецПроцедуры

// Узел, который потребитель читает целиком, а configor из листьев окружения не собирает.
// Лист окружения ложится поверх одноимённого листа файла, остальные листья файла остаются.
Процедура ПоложитьУзел(Детальки, Знач Ключ, Знач ЛистьяПсевдонимов)

	Листья = ЛистьяОкружения(Ключ);
	Если Листья.Количество() = 0 И ЛистьяПсевдонимов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Прочитанный = Индекс.Получить(НРег(Ключ));
	Если Прочитанный <> Неопределено И ТипЗнч(Прочитанный) <> Тип("Соответствие") Тогда
		СписокЗамечаний.Добавить(СтрШаблон("%1 задан в файле настроек не узлом — листья"
			+ " из окружения к нему не применены", Ключ));
		Возврат;
	КонецЕсли;

	Узел = КопияУзла(Прочитанный);
	Для Каждого Лист Из ЛистьяПсевдонимов Цикл
		ВлитьЛист(Узел, Лист.Путь, Лист.Значение);
	КонецЦикла;
	Для Каждого Лист Из Листья Цикл
		ВлитьЛист(Узел, Лист.Путь, Лист.Значение);
	КонецЦикла;

	Детальки.Вставить(Ключ, Узел);

КонецПроцедуры

// Листья узла, заданные окружением: путь под узлом (сегменты в написании переменной) и значение.
Функция ЛистьяОкружения(Знач КлючУзла)

	Префикс = НРег(КлючУзла) + ".";
	Листья = Новый Массив();
	Для Каждого Переменная Из Окружение Цикл
		Если Задано(Переменная.Значение) И СтрНачинаетсяС(НРег(Переменная.Ключ), Префикс) Тогда
			Путь = СтрРазделить(Сред(Переменная.Ключ, СтрДлина(Префикс) + 1), ".", Ложь);
			Листья.Добавить(Новый Структура("Путь, Значение", Путь, Переменная.Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Листья;

КонецФункции

Процедура ДобавитьЛист(Листья, Знач Имя, Знач Значение)

	Если Задано(Значение) Тогда
		Путь = Новый Массив();
		Путь.Добавить(Имя);
		Листья.Добавить(Новый Структура("Путь, Значение", Путь, Значение));
	КонецЕсли;

КонецПроцедуры

// Сегмент ищется без учёта регистра, как ищет configor: найденный сохраняет написание
// файла, новый ложится в написании переменной.
Процедура ВлитьЛист(Узел, Знач Путь, Знач Значение)

	Текущий = Узел;
	Для Номер = 0 По Путь.ВГраница() - 1 Цикл
		Имя = ИмяВУзле(Текущий, Путь[Номер]);
		Если ТипЗнч(Текущий.Получить(Имя)) <> Тип("Соответствие") Тогда
			Текущий.Вставить(Имя, Новый Соответствие());
		КонецЕсли;
		Текущий = Текущий.Получить(Имя);
	КонецЦикла;

	Текущий.Вставить(ИмяВУзле(Текущий, Путь[Путь.ВГраница()]), Значение);

КонецПроцедуры

Функция ИмяВУзле(Знач Узел, Знач Имя)

	Для Каждого Элемент Из Узел Цикл
		Если НРег(Элемент.Ключ) = НРег(Имя) Тогда
			Возврат Элемент.Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат Имя;

КонецФункции

// Узел configor не отдаётся потребителю изменённым: слияние идёт в копии.
Функция КопияУзла(Знач Узел)

	Копия = Новый Соответствие();
	Если Узел = Неопределено Тогда
		Возврат Копия;
	КонецЕсли;

	Для Каждого Элемент Из Узел Цикл
		Если ТипЗнч(Элемент.Значение) = Тип("Соответствие") Тогда
			Копия.Вставить(Элемент.Ключ, КопияУзла(Элемент.Значение));
		Иначе
			Копия.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Копия;

КонецФункции

#КонецОбласти

#Область УстройствоХаба

// Факты композиции хаба, а не настройки: оператор их не меняет, поэтому они ставятся
// поверх всего, что прочитано.
Процедура УстройствоХаба(Детальки)

	// Кэш артефактов выдачи держит .ospx на диске: в памяти он съел бы бюджет процесса.
	Детальки.Вставить("cache.артефакты.Поставщик", "файлы");

	Если НЕ ЗначениеЗаполнено(КаталогПриложений) Тогда
		Возврат;
	КонецЕсли;

	// Слушатель поднимает желудь ОткрытиеПорта после стартовых рогаток: с автостартом
	// winow открыл бы порт в фоне, параллельно им.
	Детальки.Вставить("winow.АвтоСтарт", Ложь);
	// Хаб — собственное приложение winow, а не прикладной сервер со сторонними приложениями.
	Детальки.Вставить("winow.ИспользоватьПрикладнойСервер", Ложь);
	// Классы хаба лежат в исходниках рядом с точкой входа, и нигде больше.
	Детальки.Вставить("winow.КаталогСПриложениями", КаталогПриложений);

	Если СпособыВыводаЖурнала <> Неопределено Тогда
		СвязатьЖурнал(Детальки);
	КонецЕсли;

КонецПроцедуры

// Способы вывода — консоль и OTel хаба — классы исходников: вне процесса хаба их нет,
// поэтому связка живёт здесь, а не в файле. Уровни — производная oshub.log.level(s):
// logos читает узлы logos.logger и logos.appender целиком.
Процедура СвязатьЖурнал(Детальки)

	Уровни = Новый УровниЖурнала();
	Связка = Уровни.Связка(ТекстИлиПусто(Действующее("oshub.log.level")),
		ТекстИлиПусто(Действующее("oshub.log.levels")), СпособыВыводаЖурнала);
	Для Каждого Замечание Из Уровни.Замечания() Цикл
		СписокЗамечаний.Добавить(Замечание);
	КонецЦикла;

	Детальки.Вставить("logos.logger", Связка.Логи);
	Детальки.Вставить("logos.appender", Связка.СпособыВывода);

КонецПроцедуры

#КонецОбласти

#Область УмолчанияХабаДляЧужихДеталек

// Ключи библиотек, чьё умолчание хабу не подходит. Потребитель у них не хаб, поставить
// ЗначениеПоУмолчанию некому, а файл поставки домом не годится: образ его удаляет,
// а файл оператора, смонтированный поверх, заменяет ветку целиком. Ставятся только
// тогда, когда ключа не знает никто — файл, окружение и производные сильнее.
Процедура УмолчанияХабаДляЧужихДеталек(Детальки)

	Корень = Новый РасположениеДанных().Корень(ТекстИлиПусто(Действующее("oshub.storage.root")));

	// autumn-data без узла не поднимает ни одного источника: хаб стартовал бы без базы.
	Если НЕ УзелИзвестен(Детальки, "data.ИсточникиДанных") Тогда
		ИсточникДанных = Новый Соответствие();
		ИсточникДанных.Вставить("ТипКоннектора", "КоннекторJSON");
		ИсточникДанных.Вставить("СтрокаСоединения", ОбъединитьПути(Корень, "entities"));
		Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	КонецЕсли;

	// Без имени сэмплера SDK берёт ParentBased(AlwaysOn) и долю отбираемых трасс игнорирует.
	ПоложитьУмолчание(Детальки, "otel.traces.sampler", "parentbased_traceidratio");
	// Безымянную телеметрию отбор по service_name не находит.
	ПоложитьУмолчание(Детальки, "otel.service.name", "openhub");

	// Файловому поставщику autumn-cache каталог и предел обязательны: своих у него нет.
	ПоложитьУмолчание(Детальки, "cache.артефакты.Каталог", ОбъединитьПути(Корень, "кэш", "артефакты"));
	ПоложитьУмолчание(Детальки, "cache.артефакты.Предел", 1073741824);
	// Без общего бюджета каждый кэш в памяти держит тысячу записей любого размера.
	ПоложитьУмолчание(Детальки, "cache.ПределПамяти", 134217728);
	// Без срока запись бессрочна, а admin-cli пишет в базу мимо процесса хаба.
	Для Каждого ИмяКэша Из КэшиЧтенийИзБазы() Цикл
		ПоложитьУмолчание(Детальки, "cache." + ИмяКэша + ".СрокЖизни", 30);
	КонецЦикла;

КонецПроцедуры

Процедура ПоложитьУмолчание(Детальки, Знач Ключ, Знач Значение)

	Если ЕстьВДетальках(Детальки, Ключ) Тогда
		Возврат;
	КонецЕсли;

	Известное = Действующее(Ключ);
	Если Задано(Известное) И ТипЗнч(Известное) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	Детальки.Вставить(Ключ, Значение);

КонецПроцедуры

Функция УзелИзвестен(Знач Детальки, Знач Ключ)
	Возврат ЕстьВДетальках(Детальки, Ключ) ИЛИ Индекс.Получить(НРег(Ключ)) <> Неопределено;
КонецФункции

#КонецОбласти

#Область Служебное

// Состав источников — как в Поделка.ИнициализироватьМенеджерПараметров ОСени, без
// программных деталек: их загрузка как раз и строит.
Функция ПрочитатьКакОсень(Знач Основа)

	Менеджер = Новый МенеджерПараметров();
	Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровENV(Основа.ПрефиксПеременныхСреды()), 1);
	Менеджер.ИспользоватьПровайдерJSON(2);
	Менеджер.ИспользоватьПровайдерYAML(2);
	Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровINI(), 2);

	Поиск = Менеджер.НастройкаПоискаФайла();
	Поиск.УстановитьСтандартныеКаталогиПоиска(Основа.ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек());
	Поиск.УстановитьИмяФайла(Основа.ИмяФайлаСоЗначениямиДеталек());

	Менеджер.Прочитать();
	Возврат Менеджер.ПрочитанныеПараметры();

КонецФункции

// Плоский индекс configor: ключ через точку в нижнем регистре, узлы — и целиком, и листьями.
Функция ИндексКакВConfigor(Знач Дерево)
	Возврат Новый ИндексЗначений().Коллекция(Дерево).ПолучитьИндекс();
КонецФункции

Процедура ДобавитьВИтог(Знач Ключ, Знач Значение)

	Добавка = Новый Соответствие();
	Добавка.Вставить(Ключ, Значение);
	Для Каждого Элемент Из ИндексКакВConfigor(Добавка) Цикл
		Итог.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

КонецПроцедуры

// Значение ключа до производных: окружение сильнее прочитанного configor.
Функция Действующее(Знач Ключ)

	ИзПеременной = ИзОкружения.Получить(НРег(Ключ));
	Возврат ?(ИзПеременной = Неопределено, Индекс.Получить(НРег(Ключ)), ИзПеременной);

КонецФункции

Функция ЕстьВДетальках(Знач Детальки, Знач Ключ)

	Для Каждого Деталька Из Детальки Цикл
		Если НРег(Деталька.Ключ) = НРег(Ключ) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция Задано(Знач Значение)
	Возврат Значение <> Неопределено И НЕ (ТипЗнч(Значение) = Тип("Строка") И ПустаяСтрока(Значение));
КонецФункции

Функция ТекстИлиПусто(Знач Значение)
	Возврат ?(Задано(Значение) И ТипЗнч(Значение) <> Тип("Соответствие"), Строка(Значение), "");
КонецФункции

Процедура СоздатьКаталогЕслиНет(Знач Путь)
	Если ЗначениеЗаполнено(Путь) И НЕ Новый Файл(Путь).Существует() Тогда
		СоздатьКаталог(Новый Файл(Путь).ПолноеИмя);
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьЗагружено()
	Если Итог = Неопределено Тогда
		ВызватьИсключение "ЗагрузкаНастроек: значения спрошены до Совет() — загрузки ещё не было";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

// Параметры:
//  _КаталогПриложений - Строка - каталог модулей хаба; задан только у процесса-сервера,
//                       и тогда загрузка ставит устройство winow (необязательный).
//  _СпособыВыводаЖурнала - Соответствие - имя способа вывода → имя класса; задано — журнал
//                          хаба связывается узлами logos (необязательный).
//
Процедура ПриСозданииОбъекта(Знач _КаталогПриложений = "",
	Знач _СпособыВыводаЖурнала = Неопределено) Экспорт

	КаталогПриложений = _КаталогПриложений;
	СпособыВыводаЖурнала = _СпособыВыводаЖурнала;
	Имена = Новый ИменаПеременныхОкружения();

КонецПроцедуры
