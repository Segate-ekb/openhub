// Загрузка настроек хаба: Совет для Новый Поделка(Совет) из прочитанного configor и правил
// поверх — окружение сильнее файла, псевдонимы и узлы, устройство хаба, умолчания для библиотек.

#Использовать autumn
#Использовать configor

Перем КаталогПриложений;       // Строка — каталог модулей хаба для winow; пусто — процесс не сервер
Перем СпособыВыводаЖурнала;    // Соответствие: имя способа вывода → класс; Неопределено — журнал не связывается
Перем Имена;                   // ИменаПеременныхОкружения (настройки) — конвенция и список псевдонимов

Перем Источники;               // ИсточникиНастроек — прочитанное порознь: файлы, окружение, программно
Перем Итог;                    // Соответствие: ключ (НРег) → значение, как его увидит Поделка
Перем Корень;                  // Строка — абсолютный корень данных
Перем СписокЗамечаний;         // Массив из Строка — что оператору сказать про отвергнутое
Перем СписокСведений;          // Массив из Строка — что оператору сказать на старте для сведения

#Область ПубличныйИнтерфейс

// Совет для Новый Поделка(Совет): детальки, собранные правилами поверх того, что configor
// прочитал из файлов настроек и из окружения.
//
// Параметры:
//  Основа - СоветДругогоМастера - откуда читать: имя файла настроек, каталог его поиска
//           и префикс переменных берутся из неё; программные детальки основы сильнее
//           всего остального (необязательный, по умолчанию — Совет ОСени как есть).
//
// Возвращаемое значение:
//  СоветДругогоМастера - основа с заполненными детальками.
//
// Выбрасывает исключение, если узел базы задан так, что хаб с ним не поднимется.
//
Функция Совет(Знач Основа = Неопределено) Экспорт

	Если Основа = Неопределено Тогда
		Основа = Новый СоветДругогоМастера();
	КонецЕсли;

	Окружение = Новый ПровайдерПараметровENV(Основа.ПрефиксПеременныхСреды());
	Детальки = ДеталькиПоверх(ПрочитанноеИзФайлов(Основа), Окружение.ПрочитатьПараметры(Новый Структура()),
		Основа.ЗначенияДеталек());

	Возврат Основа.ЗначенияДеталек(Детальки);

КонецФункции

// Правила загрузки над уже прочитанным; окружения и файлов не касается. Итог запоминается:
// его отдают Значение, КореньДанных, Замечания и Сведения.
//
// Параметры:
//  ИзФайлов - Соответствие - дерево, прочитанное configor из файлов настроек без окружения.
//  ИзОкружения - Соответствие - плоская карта провайдера окружения configor:
//                ключ через точку (OSHUB.STORAGE.ROOT) → значение переменной.
//  ЗаданныеПрограммно - Соответствие - программные детальки вызывающего; сильнее всего
//                       остального (необязательный).
//
// Возвращаемое значение:
//  Соответствие - программные детальки для Совета.
//
// Выбрасывает исключение, если узел базы задан так, что хаб с ним не поднимется.
//
Функция ДеталькиПоверх(Знач ИзФайлов, Знач ИзОкружения, Знач ЗаданныеПрограммно = Неопределено) Экспорт

	СписокЗамечаний = Новый Массив();
	СписокСведений = Новый Массив();
	Программные = ?(ЗаданныеПрограммно = Неопределено, Новый Соответствие(), ЗаданныеПрограммно);
	Источники = Новый ИсточникиНастроек(ИзФайлов, ИзОкружения, Программные);

	Детальки = Новый Соответствие();

	ОкружениеПеребиваетФайл(Детальки);
	ПсевдонимыКлючей(Детальки);
	ПоложитьУзел(Детальки, КлючУзлаПровайдеровВхода());
	УстройствоХаба(Детальки);
	Корень = Новый РасположениеДанных().Корень(ТекстИлиПусто(Источники.Действующее("oshub.storage.root")));
	ПоложитьУзелБазы(Детальки);
	УмолчанияХабаДляЧужихДеталек(Детальки);

	Для Каждого Заданная Из Программные Цикл
		Детальки.Вставить(Заданная.Ключ, Заданная.Значение);
	КонецЦикла;

	Итог = Источники.КакУвидитПоделка(Детальки);

	Возврат Детальки;

КонецФункции

// Значение ключа так, как его увидит Поделка, собранная из выданного Совета.
//
// Параметры:
//  Ключ - Строка - ключ детальки; регистр не значим.
//
// Возвращаемое значение:
//  Произвольный - значение либо Неопределено, если ключа не знает никто.
//
Функция Значение(Знач Ключ) Экспорт
	ПроверитьЗагружено();
	Возврат Итог.Получить(НРег(Ключ));
КонецФункции

// Абсолютный корень данных хаба: заданный настройкой oshub.storage.root либо умолчание.
//
// Возвращаемое значение:
//  Строка - путь.
//
Функция КореньДанных() Экспорт
	ПроверитьЗагружено();
	Возврат Корень;
КонецФункции

// Создаёт корень данных и каталог файловой базы: КоннекторJSON сам каталог не создаёт,
// и первый старт падал бы DirectoryNotFound.
//
Процедура СоздатьКаталогиДанных() Экспорт

	ПроверитьЗагружено();
	СоздатьКаталогЕслиНет(Корень);

	ИсточникДанных = Значение(КлючУзлаБазы());
	Если ТипЗнч(ИсточникДанных) = Тип("Соответствие")
		И ЭтоФайловыйКоннектор(Лист(ИсточникДанных, "ТипКоннектора")) Тогда
		СоздатьКаталогЕслиНет(Лист(ИсточникДанных, "СтрокаСоединения"));
	КонецЕсли;

КонецПроцедуры

// Что оператору сказать про отвергнутое при загрузке. Пустой массив — всё понято.
//
// Возвращаемое значение:
//  Массив из Строка - готовые строки предупреждений.
//
Функция Замечания() Экспорт
	Возврат ?(СписокЗамечаний = Неопределено, Новый Массив(), СписокЗамечаний);
КонецФункции

// Что оператору сказать на старте для сведения: как собрано то, что собрано верно,
// но из разных мест. Значений секретов в строках нет.
//
// Возвращаемое значение:
//  Массив из Строка - готовые строки сведений.
//
Функция Сведения() Экспорт
	Возврат ?(СписокСведений = Неопределено, Новый Массив(), СписокСведений);
КонецФункции

// Кэши чтений из базы, которым хаб задаёт срок жизни: общего срока у autumn-cache нет,
// и кэш, которого нет в этом перечне, живёт бессрочно.
//
// Возвращаемое значение:
//  Массив из Строка - имена кэшей.
//
Функция КэшиЧтенийИзБазы() Экспорт

	Кэши = Новый Массив();
	Кэши.Добавить("пулы");
	Кэши.Добавить("источникиПула");
	Кэши.Добавить("учётки");
	Кэши.Добавить("пакеты");
	Кэши.Добавить("пакетыПула");
	Кэши.Добавить("пакетыПулов");
	Кэши.Добавить("новинки");
	Кэши.Добавить("версииПакета");
	Кэши.Добавить("происхождениеПакета");
	Кэши.Добавить("каналыПакета");
	Кэши.Добавить("скачиванияВерсий");
	Возврат Кэши;

КонецФункции

#КонецОбласти

#Область ОкружениеПеребиваетФайл

// Непустая переменная — программной деталькой: у тех приоритет старше файла.
Процедура ОкружениеПеребиваетФайл(Детальки)

	Для Каждого Переменная Из Источники.ПеременныеОкружения() Цикл
		Детальки.Вставить(КлючПоверхОкружения(Переменная.Ключ), Переменная.Значение);
	КонецЦикла;

КонецПроцедуры

// Написание, отличное от ключа провайдера окружения: совпавший ключ configor слил бы с ним.
Функция КлючПоверхОкружения(Знач Ключ)
	Нижний = НРег(Ключ);
	Возврат ?(Нижний = Ключ, ВРег(Ключ), Нижний);
КонецФункции

#КонецОбласти

#Область ПсевдонимыКлючей

// Псевдонимы одиночных ключей — по списку; листья узлов собирают сборщики узлов, журнал — устройство.
Процедура ПсевдонимыКлючей(Детальки)

	Для Каждого Псевдоним Из Имена.Псевдонимы() Цикл
		Если Псевдоним.ЦельУзел ИЛИ ЗначениеЗаполнено(УзелЛиста(Псевдоним.Цель)) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Цель Из ЦелиПсевдонима(Псевдоним) Цикл
			ПоложитьПроизводную(Детальки, Цель, Псевдоним);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ПоложитьПроизводную(Детальки, Знач Цель, Знач Псевдоним)

	Значение = ЗначениеПсевдонима(Псевдоним, Цель);
	Если Псевдоним.Число Тогда
		Значение = Числом(Значение, Псевдоним.Ключ + " / " + Псевдоним.Переменная);
	КонецЕсли;
	Если Задано(Значение) Тогда
		Детальки.Вставить(Цель, Значение);
	КонецЕсли;

КонецПроцедуры

// Сначала источник, потом имя: окружение сильнее файлов, в одном источнике родное имя сильнее.
Функция ЗначениеПсевдонима(Знач Псевдоним, Знач Цель)

	// родное имя из окружения уже легло деталькой
	Если Источники.ИзОкружения(Цель) <> Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИзОкружения = Источники.ИзОкружения(Псевдоним.Ключ);
	Если ИзОкружения <> Неопределено Тогда
		Возврат ИзОкружения;
	КонецЕсли;

	Если Скаляр(Источники.ИзФайлов(Цель)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИзФайлов = Источники.ИзФайлов(Псевдоним.Ключ);
	Возврат ?(Скаляр(ИзФайлов), ИзФайлов, Неопределено);

КонецФункции

// «<кэш>» в цели раздаётся каждому кэшу чтений из базы.
Функция ЦелиПсевдонима(Знач Псевдоним)

	Цели = Новый Массив();
	Если СтрНайти(Псевдоним.Цель, "<кэш>") = 0 Тогда
		Цели.Добавить(Псевдоним.Цель);
		Возврат Цели;
	КонецЕсли;

	Для Каждого ИмяКэша Из КэшиЧтенийИзБазы() Цикл
		Цели.Добавить(СтрЗаменить(Псевдоним.Цель, "<кэш>", ИмяКэша));
	КонецЦикла;
	Возврат Цели;

КонецФункции

Функция Числом(Знач Написанное, Знач Источник)

	Если НЕ Задано(Написанное) ИЛИ ТипЗнч(Написанное) = Тип("Число") Тогда
		Возврат Написанное;
	КонецЕсли;

	Попытка
		Возврат Число(Написанное);
	Исключение
		СписокЗамечаний.Добавить(СтрШаблон("%1=%2 не является числом — значение не применено",
			Источник, Написанное));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область УзлыИзЛистьев

// Узлы, которые потребитель читает целиком, а configor из листьев окружения не собирает.
Функция УзлыИзЛистьев()

	Узлы = Новый Массив();
	Узлы.Добавить(КлючУзлаБазы());
	Узлы.Добавить(КлючУзлаПровайдеровВхода());
	Возврат Узлы;

КонецФункции

Функция КлючУзлаБазы()
	Возврат "data.ИсточникиДанных";
КонецФункции

Функция КлючУзлаПровайдеровВхода()
	Возврат "oshub.oidc";
КонецФункции

// Узел ложится деталькой, только если окружение что-то в нём задало.
Процедура ПоложитьУзел(Детальки, Знач КлючУзла)

	Если ВФайлахЗначениеВместоУзла(КлючУзла) Тогда
		Если Источники.ЛистьяОкружения(КлючУзла).Количество() > 0 Тогда
			СписокЗамечаний.Добавить(СтрШаблон("%1 задан в файле настроек не узлом — листья"
				+ " из окружения к нему не применены", КлючУзла));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Сборка = СобранныйУзел(КлючУзла);
	Если ЕстьЛистьяНеИзФайлов(Сборка) Тогда
		Детальки.Вставить(КлючУзла, Сборка.Узел);
	КонецЕсли;

КонецПроцедуры

// Лист к листу: листья файлов, поверх них листья окружения; каждый лист помнит, откуда пришёл.
//
// Возвращаемое значение:
//  Структура:
//   * Узел - Соответствие - собранный узел.
//   * Откуда - Соответствие - путь листа (НРег) → Структура("Источник, Имя").
//   * ПараРоднымиИменами - Булево - окружение назвало лист пары «коннектор, строка» родным именем.
//
Функция СобранныйУзел(Знач КлючУзла)

	Сборка = Новый Структура("Узел, Откуда, ПараРоднымиИменами",
		Новый Соответствие(), Новый Соответствие(), Ложь);

	ЛистьяИзФайлов(Сборка, КлючУзла);
	ЛистьяИзОкружения(Сборка, КлючУзла);

	Возврат Сборка;

КонецФункции

// Родные листья файлов, затем псевдонимы из файлов — на листья, которых родное имя не задало.
Процедура ЛистьяИзФайлов(Сборка, Знач КлючУзла)

	Прочитанный = Источники.ИзФайлов(КлючУзла);
	Если ТипЗнч(Прочитанный) = Тип("Соответствие") Тогда
		Сборка.Узел = КопияУзла(Прочитанный);
		ОтметитьЛистьяФайла(Сборка, Сборка.Узел, КлючУзла, "");
	КонецЕсли;

	Для Каждого Псевдоним Из ПсевдонимыУзла(КлючУзла) Цикл
		ИзФайлов = Источники.ИзФайлов(Псевдоним.Ключ);
		Если Скаляр(ИзФайлов) И НЕ Скаляр(Источники.ИзФайлов(Псевдоним.Цель)) Тогда
			ПоложитьЛист(Сборка, ПутьЛиста(КлючУзла, Псевдоним.Цель), ИзФайлов,
				Откуда("файл", Псевдоним.Ключ));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Псевдонимы окружения, затем родные листья окружения — родное имя сильнее. Родное имя хоть
// одного листа пары отменяет псевдонимы пары целиком: образ зашивает их своим умолчанием.
Процедура ЛистьяИзОкружения(Сборка, Знач КлючУзла)

	Родные = Источники.ЛистьяОкружения(КлючУзла);
	Сборка.ПараРоднымиИменами = ЕстьЛистПары(КлючУзла, Родные);

	Для Каждого Псевдоним Из ПсевдонимыУзла(КлючУзла) Цикл
		ИзОкружения = Источники.ИзОкружения(Псевдоним.Ключ);
		Если ИзОкружения <> Неопределено И НЕ (Псевдоним.Пара И Сборка.ПараРоднымиИменами) Тогда
			ПоложитьЛист(Сборка, ПутьЛиста(КлючУзла, Псевдоним.Цель), ИзОкружения,
				Откуда("окружение", Псевдоним.Переменная));
		КонецЕсли;
	КонецЦикла;

	Для Каждого Родной Из Родные Цикл
		ПоложитьЛист(Сборка, Родной.Путь, Родной.Значение, Откуда("окружение", Имена.РодноеИмя(Родной.Ключ)));
	КонецЦикла;

КонецПроцедуры

Процедура ОтметитьЛистьяФайла(Сборка, Знач Узел, Знач КлючУзла, Знач Префикс)

	Для Каждого Элемент Из Узел Цикл
		Путь = Префикс + Элемент.Ключ;
		Если ТипЗнч(Элемент.Значение) = Тип("Соответствие") Тогда
			ОтметитьЛистьяФайла(Сборка, Элемент.Значение, КлючУзла, Путь + ".");
		Иначе
			Сборка.Откуда.Вставить(НРег(Путь), Откуда("файл", КлючУзла + "." + Путь));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПоложитьЛист(Сборка, Знач Путь, Знач Значение, Знач Происхождение)
	ВлитьЛист(Сборка.Узел, Путь, Значение);
	Сборка.Откуда.Вставить(НРег(СтрСоединить(Путь, ".")), Происхождение);
КонецПроцедуры

Функция ПутьИзОдногоЛиста(Знач ИмяЛиста)
	Путь = Новый Массив();
	Путь.Добавить(ИмяЛиста);
	Возврат Путь;
КонецФункции

// Источник — "файл", "окружение", "умолчание" или "программно"; имя — ключ либо переменная.
Функция Откуда(Знач Источник, Знач Имя = "")
	Возврат Новый Структура("Источник, Имя", Источник, Имя);
КонецФункции

Функция ЕстьЛистьяНеИзФайлов(Знач Сборка)

	Для Каждого Отметка Из Сборка.Откуда Цикл
		Если Отметка.Значение.Источник <> "файл" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЕстьЛистПары(Знач КлючУзла, Знач Листья)

	Для Каждого Родной Из Листья Цикл
		Если Родной.Путь.Количество() <> 1 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Псевдоним Из ПсевдонимыУзла(КлючУзла) Цикл
			Если Псевдоним.Пара И НРег(ИмяЛиста(КлючУзла, Псевдоним.Цель)) = НРег(Родной.Путь[0]) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ПсевдонимыУзла(Знач КлючУзла)

	Результат = Новый Массив();
	Для Каждого Псевдоним Из Имена.Псевдонимы() Цикл
		Если НРег(УзелЛиста(Псевдоним.Цель)) = НРег(КлючУзла) Тогда
			Результат.Добавить(Псевдоним);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ВФайлахЗначениеВместоУзла(Знач КлючУзла)
	Прочитанный = Источники.ИзФайлов(КлючУзла);
	Возврат Прочитанный <> Неопределено И ТипЗнч(Прочитанный) <> Тип("Соответствие");
КонецФункции

Функция УзелЛиста(Знач Цель)

	Для Каждого КлючУзла Из УзлыИзЛистьев() Цикл
		Если СтрНачинаетсяС(НРег(Цель), НРег(КлючУзла) + ".") Тогда
			Возврат КлючУзла;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ИмяЛиста(Знач КлючУзла, Знач Цель)
	Возврат Сред(Цель, СтрДлина(КлючУзла) + 2);
КонецФункции

Функция ПутьЛиста(Знач КлючУзла, Знач Цель)
	Возврат СтрРазделить(ИмяЛиста(КлючУзла, Цель), ".", Ложь);
КонецФункции

#КонецОбласти

#Область УзелБазы

// Узел базы лист к листу: листья файлов, поверх них листья окружения, умолчания по листьям,
// затем проверка итогового узла — с памятью о том, откуда пришёл каждый лист.
Процедура ПоложитьУзелБазы(Детальки)

	Если ВФайлахЗначениеВместоУзла(КлючУзлаБазы()) Тогда
		ВызватьИсключение ОшибкаБазы("узел " + КлючУзлаБазы() + " в файле настроек задан значением,"
			+ " а должен быть объектом с листьями ТипКоннектора и СтрокаСоединения");
	КонецЕсли;

	Сборка = УзелБазыИзПрограммы();
	Если Сборка = Неопределено Тогда
		Сборка = СобранныйУзел(КлючУзлаБазы());
		ЧислаУзла(Сборка.Узел, КлючУзлаБазы());
		УмолчанияЛистьевБазы(Сборка);
	КонецЕсли;

	ПроверитьУзелБазы(Сборка);
	СведенияОбИсточникахПары(Сборка);

	Если ЕстьЛистьяНеИзФайлов(Сборка) Тогда
		Детальки.Вставить(КлючУзлаБазы(), Сборка.Узел);
	КонецЕсли;

КонецПроцедуры

// Узел, заданный программной деталькой, собран вызывающим целиком; проверяется тем же правилом.
Функция УзелБазыИзПрограммы()

	Заданный = Источники.Программно(КлючУзлаБазы());
	Если ТипЗнч(Заданный) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сборка = Новый Структура("Узел, Откуда, ПараРоднымиИменами", Заданный, Новый Соответствие(), Ложь);
	Для Каждого Элемент Из Заданный Цикл
		Сборка.Откуда.Вставить(НРег(Элемент.Ключ), Откуда("программно"));
	КонецЦикла;
	Возврат Сборка;

КонецФункции

// Лист, которому нужно число, но пришла не-цифра, снимается с замечанием.
Процедура ЧислаУзла(Узел, Знач КлючУзла)

	Для Каждого Псевдоним Из ПсевдонимыУзла(КлючУзла) Цикл
		Имя = ИмяВУзле(Узел, ИмяЛиста(КлючУзла, Псевдоним.Цель));
		Если НЕ Псевдоним.Число ИЛИ Узел.Получить(Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Значение = Числом(Узел.Получить(Имя), Псевдоним.Цель);
		Если Значение = Неопределено Тогда
			Узел.Удалить(Имя);
		Иначе
			Узел.Вставить(Имя, Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Без типа коннектора autumn-data источник не поднимает; файловой базе нужен каталог.
Процедура УмолчанияЛистьевБазы(Сборка)

	Если НЕ Задано(Лист(Сборка.Узел, "ТипКоннектора")) Тогда
		ПоложитьЛист(Сборка, ПутьИзОдногоЛиста("ТипКоннектора"), "КоннекторJSON", Откуда("умолчание"));
	КонецЕсли;

	Если НЕ Задано(Лист(Сборка.Узел, "СтрокаСоединения"))
		И ЭтоФайловыйКоннектор(Лист(Сборка.Узел, "ТипКоннектора")) Тогда
		ПоложитьЛист(Сборка, ПутьИзОдногоЛиста("СтрокаСоединения"), ОбъединитьПути(Корень, "entities"),
			Откуда("умолчание"));
	КонецЕсли;

КонецПроцедуры

// Узел, с которым хаб не поднимется, — ошибка конфигурации сразу, а не каскад на первом запросе.
Процедура ПроверитьУзелБазы(Знач Сборка)

	ТипКоннектора = Лист(Сборка.Узел, "ТипКоннектора");
	СтрокаСоединения = Лист(Сборка.Узел, "СтрокаСоединения");

	Если НЕ Задано(ТипКоннектора) Тогда
		ВызватьИсключение ОшибкаБазы("не задан тип коннектора — " + ГдеЗадатьЛист(Сборка, "ТипКоннектора"));
	ИначеЕсли ЭтоФайловыйКоннектор(ТипКоннектора) И ПохожаНаСтрокуСУБД(СтрокаСоединения) Тогда
		ВызватьИсключение ОтказФайловогоКоннектораСоСтрокойСУБД(Сборка);
	ИначеЕсли ЭтоФайловыйКоннектор(ТипКоннектора) ИЛИ ЭтоКоннекторВПамяти(ТипКоннектора) Тогда
		Возврат;
	ИначеЕсли НЕ Задано(СтрокаСоединения) Тогда
		ВызватьИсключение ОтказБезСтрокиСоединения(Сборка);
	ИначеЕсли НЕ ЕстьПараКлючЗначение(СтрокаСоединения) Тогда
		ВызватьИсключение ОтказСтрокиБезПарКлючЗначение(Сборка);
	КонецЕсли;

КонецПроцедуры

Функция ОтказФайловогоКоннектораСоСтрокойСУБД(Знач Сборка)
	Возврат ОшибкаБазы(СтрШаблон("строка соединения похожа на строку СУБД, а коннектор %1 файловый —"
		+ " задайте тип коннектора: %2. Коннектор — %3; строка соединения — %4",
		Лист(Сборка.Узел, "ТипКоннектора"), ГдеЗадатьЛист(Сборка, "ТипКоннектора"),
		ОткудаЛист(Сборка, "ТипКоннектора"), ОткудаЛист(Сборка, "СтрокаСоединения")));
КонецФункции

Функция ОтказБезСтрокиСоединения(Знач Сборка)
	Возврат ОшибкаБазы(СтрШаблон("для коннектора %1 обязательна строка соединения — %2"
		+ " (например, для КоннекторPostgreSQL - ""Host=...;Username=...;Password=...;Database=...;"")."
		+ " Коннектор — %3",
		Лист(Сборка.Узел, "ТипКоннектора"), ГдеЗадатьЛист(Сборка, "СтрокаСоединения"),
		ОткудаЛист(Сборка, "ТипКоннектора")));
КонецФункции

Функция ОтказСтрокиБезПарКлючЗначение(Знач Сборка)
	Возврат ОшибкаБазы(СтрШаблон("строка соединения коннектора %1 не строка СУБД — в ней нет ни одной"
		+ " пары «ключ=значение». Коннектор — %2; строка соединения — %3. Задайте строку соединения"
		+ " СУБД (например, для КоннекторPostgreSQL - ""Host=...;Username=...;Password=...;Database=...;"")"
		+ " либо файловый коннектор КоннекторJSON",
		Лист(Сборка.Узел, "ТипКоннектора"), ОткудаЛист(Сборка, "ТипКоннектора"),
		ОткудаЛист(Сборка, "СтрокаСоединения")));
КонецФункции

// Листья пары из разных источников — рекомендованная практика, поэтому это сведение, а не замечание.
Процедура СведенияОбИсточникахПары(Знач Сборка)

	ОткудаКоннектор = Сборка.Откуда.Получить(НРег("ТипКоннектора"));
	ОткудаСтрока = Сборка.Откуда.Получить(НРег("СтрокаСоединения"));
	Если ОткудаКоннектор = Неопределено ИЛИ ОткудаСтрока = Неопределено
		ИЛИ ОткудаКоннектор.Источник = ОткудаСтрока.Источник Тогда
		Возврат;
	КонецЕсли;

	СписокСведений.Добавить(СтрШаблон("Узел базы собран из разных источников: коннектор %1 — %2;"
		+ " строка соединения — %3", Лист(Сборка.Узел, "ТипКоннектора"),
		ОткудаЛист(Сборка, "ТипКоннектора"), ОткудаЛист(Сборка, "СтрокаСоединения")));

КонецПроцедуры

// Откуда пришёл лист — словами оператора, без значения.
Функция ОткудаЛист(Знач Сборка, Знач ИмяЛиста)

	ОткудаПришёл = Сборка.Откуда.Получить(НРег(ИмяЛиста));
	Если ОткудаПришёл = Неопределено Тогда
		Возврат "не задана нигде";
	ИначеЕсли ОткудаПришёл.Источник = "окружение" Тогда
		Возврат "переменная " + ОткудаПришёл.Имя;
	ИначеЕсли ОткудаПришёл.Источник = "файл" Тогда
		Возврат "ключ " + ОткудаПришёл.Имя + " файла настроек";
	ИначеЕсли ОткудаПришёл.Источник = "умолчание" Тогда
		Возврат "умолчание хаба";
	КонецЕсли;
	Возврат "программная деталька";

КонецФункции

// Где оператору задать лист: псевдоним, родное имя, ключ файла. Пока пара названа родными
// именами, псевдоним окружения не берётся — и это сказано, если он задан.
Функция ГдеЗадатьЛист(Знач Сборка, Знач ИмяЛиста)

	Цель = КлючУзлаБазы() + "." + ИмяЛиста;
	РодноеИмя = Имена.РодноеИмя(Цель);
	КлючФайла = "ключ " + Цель + " файла настроек";
	Псевдоним = Имена.ПсевдонимЦели(Цель);

	Если Псевдоним = Неопределено Тогда
		Возврат СтрШаблон("%1 либо %2", РодноеИмя, КлючФайла);
	ИначеЕсли Сборка.ПараРоднымиИменами И Источники.ИзОкружения(Псевдоним.Ключ) <> Неопределено Тогда
		Возврат СтрШаблон("%1 либо %2; %3 не берётся, пока пара задана родными именами %4",
			РодноеИмя, КлючФайла, Псевдоним.Переменная, Имена.РодноеИмя(КлючУзлаБазы() + ".*"));
	КонецЕсли;
	Возврат СтрШаблон("%1, %2 либо %3", Псевдоним.Переменная, РодноеИмя, КлючФайла);

КонецФункции

// Строка СУБД — пары «ключ=значение» через точку с запятой либо известный ключ первым.
Функция ПохожаНаСтрокуСУБД(Знач СтрокаСоединения)

	Если НЕ Скаляр(СтрокаСоединения) Тогда
		Возврат Ложь;
	КонецЕсли;

	Текст = НРег(СокрЛП(Строка(СтрокаСоединения)));
	Знак = СтрНайти(Текст, "=");
	Если Знак = 0 Тогда
		Возврат Ложь;
	ИначеЕсли СтрНайти(Текст, ";") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат КлючиСтрокСУБД().Найти(СокрЛП(Лев(Текст, Знак - 1))) <> Неопределено;

КонецФункции

Функция КлючиСтрокСУБД()
	Возврат СтрРазделить("host,server,data source,datasource,username,user id,uid,password,pwd,database", ",");
КонецФункции

Функция ЕстьПараКлючЗначение(Знач СтрокаСоединения)
	Возврат СтрНайти(СокрЛП(Строка(СтрокаСоединения)), "=") > 1;
КонецФункции

Функция ОшибкаБазы(Знач Текст)
	Возврат "Ошибка конфигурации БД: " + Текст + ".";
КонецФункции

Функция ЭтоФайловыйКоннектор(Знач ТипКоннектора)
	Возврат СтрНачинаетсяС(ВРег(Строка(ТипКоннектора)), ВРег("КоннекторJSON"));
КонецФункции

Функция ЭтоКоннекторВПамяти(Знач ТипКоннектора)
	Возврат ВРег(Строка(ТипКоннектора)) = ВРег("КоннекторInMemory");
КонецФункции

#КонецОбласти

#Область УстройствоХаба

// Факты композиции хаба, а не настройки: ставятся поверх всего прочитанного.
Процедура УстройствоХаба(Детальки)

	// Кэш артефактов выдачи держит .ospx на диске: в памяти он съел бы бюджет процесса.
	Детальки.Вставить("cache.артефакты.Поставщик", "файлы");

	Если НЕ ЗначениеЗаполнено(КаталогПриложений) Тогда
		Возврат;
	КонецЕсли;

	// Порт открывает желудь ОткрытиеПорта после стартовых рогаток, а не winow параллельно им.
	Детальки.Вставить("winow.АвтоСтарт", Ложь);
	// Хаб — собственное приложение winow, а не прикладной сервер со сторонними приложениями.
	Детальки.Вставить("winow.ИспользоватьПрикладнойСервер", Ложь);
	// Классы хаба лежат в исходниках рядом с точкой входа, и нигде больше.
	Детальки.Вставить("winow.КаталогСПриложениями", КаталогПриложений);

	Если СпособыВыводаЖурнала <> Неопределено Тогда
		СвязатьЖурнал(Детальки);
	КонецЕсли;

КонецПроцедуры

// Узлы logos целиком: способы вывода — классы хаба, уровни — из псевдонимов журнала.
Процедура СвязатьЖурнал(Детальки)

	Корневой = Имена.ПсевдонимЦели("logos.logger");
	Компоненты = Имена.ПсевдонимЦели("logos.logger.<журнал>");
	ИменаНастроек = Новый Структура("Корневой, Компоненты",
		Корневой.Ключ + " / " + Корневой.Переменная, Компоненты.Ключ + " / " + Компоненты.Переменная);

	Уровни = Новый УровниЖурнала();
	Связка = Уровни.Связка(ТекстИлиПусто(Источники.Действующее(Корневой.Ключ)),
		ТекстИлиПусто(Источники.Действующее(Компоненты.Ключ)), СпособыВыводаЖурнала, ИменаНастроек);
	Для Каждого Замечание Из Уровни.Замечания() Цикл
		СписокЗамечаний.Добавить(Замечание);
	КонецЦикла;

	Детальки.Вставить("logos.logger", Связка.Логи);
	Детальки.Вставить("logos.appender", Связка.СпособыВывода);

КонецПроцедуры

#КонецОбласти

#Область УмолчанияХабаДляЧужихДеталек

// Ключи библиотек, чьё умолчание хабу не подходит; ставятся, только когда ключа не знает никто.
// Умолчания узла базы ставит сборщик узла — по листьям.
Процедура УмолчанияХабаДляЧужихДеталек(Детальки)

	// Без имени сэмплера SDK берёт ParentBased(AlwaysOn) и долю отбираемых трасс игнорирует.
	ПоложитьУмолчание(Детальки, "otel.traces.sampler", "parentbased_traceidratio");
	// Безымянную телеметрию отбор по service_name не находит.
	ПоложитьУмолчание(Детальки, "otel.service.name", "openhub");

	// Файловому поставщику autumn-cache каталог и предел обязательны: своих у него нет.
	ПоложитьУмолчание(Детальки, "cache.артефакты.Каталог", ОбъединитьПути(Корень, "кэш", "артефакты"));
	ПоложитьУмолчание(Детальки, "cache.артефакты.Предел", 1073741824);
	// Без общего бюджета каждый кэш в памяти держит тысячу записей любого размера.
	ПоложитьУмолчание(Детальки, "cache.ПределПамяти", 134217728);
	// Без срока запись бессрочна, а admin-cli пишет в базу мимо процесса хаба.
	Для Каждого ИмяКэша Из КэшиЧтенийИзБазы() Цикл
		ПоложитьУмолчание(Детальки, "cache." + ИмяКэша + ".СрокЖизни", 30);
	КонецЦикла;

КонецПроцедуры

Процедура ПоложитьУмолчание(Детальки, Знач Ключ, Знач Значение)

	Если ЕстьВДетальках(Детальки, Ключ) ИЛИ Скаляр(Источники.Действующее(Ключ)) Тогда
		Возврат;
	КонецЕсли;
	Детальки.Вставить(Ключ, Значение);

КонецПроцедуры

#КонецОбласти

#Область Служебное

// Файлы настроек тем же поиском, что у ОСени, но без провайдера окружения: загрузке важно,
// откуда пришло значение, а configor кладёт переменные в то же дерево плоскими ключами.
Функция ПрочитанноеИзФайлов(Знач Основа)

	Менеджер = Новый МенеджерПараметров();
	Менеджер.ИспользоватьПровайдерJSON(2);
	Менеджер.ИспользоватьПровайдерYAML(2);
	Менеджер.ДобавитьПровайдерПараметров(Новый ПровайдерПараметровINI(), 2);

	Поиск = Менеджер.НастройкаПоискаФайла();
	Поиск.УстановитьСтандартныеКаталогиПоиска(Основа.ДополнительныйКаталогПоискаФайлаСоЗначениямиДеталек());
	Поиск.УстановитьИмяФайла(Основа.ИмяФайлаСоЗначениямиДеталек());

	Менеджер.Прочитать();
	Возврат Менеджер.ПрочитанныеПараметры();

КонецФункции

// Сегмент ищется без учёта регистра, как ищет configor: найденный сохраняет написание файла.
Процедура ВлитьЛист(Узел, Знач Путь, Знач Значение)

	Текущий = Узел;
	Для Номер = 0 По Путь.ВГраница() - 1 Цикл
		Имя = ИмяВУзле(Текущий, Путь[Номер]);
		Если ТипЗнч(Текущий.Получить(Имя)) <> Тип("Соответствие") Тогда
			Текущий.Вставить(Имя, Новый Соответствие());
		КонецЕсли;
		Текущий = Текущий.Получить(Имя);
	КонецЦикла;

	Текущий.Вставить(ИмяВУзле(Текущий, Путь[Путь.ВГраница()]), Значение);

КонецПроцедуры

Функция ИмяВУзле(Знач Узел, Знач Имя)

	Для Каждого Элемент Из Узел Цикл
		Если НРег(Элемент.Ключ) = НРег(Имя) Тогда
			Возврат Элемент.Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат Имя;

КонецФункции

Функция Лист(Знач Узел, Знач Имя)
	Возврат Узел.Получить(ИмяВУзле(Узел, Имя));
КонецФункции

// Узел configor не отдаётся потребителю изменённым: слияние идёт в копии.
Функция КопияУзла(Знач Узел)

	Копия = Новый Соответствие();
	Для Каждого Элемент Из Узел Цикл
		Если ТипЗнч(Элемент.Значение) = Тип("Соответствие") Тогда
			Копия.Вставить(Элемент.Ключ, КопияУзла(Элемент.Значение));
		Иначе
			Копия.Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Копия;

КонецФункции

Функция ЕстьВДетальках(Знач Детальки, Знач Ключ)

	Для Каждого Деталька Из Детальки Цикл
		Если НРег(Деталька.Ключ) = НРег(Ключ) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция Задано(Знач Значение)
	Возврат Значение <> Неопределено И НЕ (ТипЗнч(Значение) = Тип("Строка") И ПустаяСтрока(Значение));
КонецФункции

Функция Скаляр(Знач Значение)
	Возврат Задано(Значение) И ТипЗнч(Значение) <> Тип("Соответствие") И ТипЗнч(Значение) <> Тип("Массив");
КонецФункции

Функция ТекстИлиПусто(Знач Значение)
	Возврат ?(Скаляр(Значение), Строка(Значение), "");
КонецФункции

Процедура СоздатьКаталогЕслиНет(Знач Путь)
	Если ЗначениеЗаполнено(Путь) И НЕ Новый Файл(Путь).Существует() Тогда
		СоздатьКаталог(Новый Файл(Путь).ПолноеИмя);
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьЗагружено()
	Если Итог = Неопределено Тогда
		ВызватьИсключение "ЗагрузкаНастроек: значения спрошены до Совет() — загрузки ещё не было";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

// Параметры:
//  _КаталогПриложений - Строка - каталог модулей хаба; задан только у процесса-сервера,
//                       и тогда загрузка ставит устройство winow (необязательный).
//  _СпособыВыводаЖурнала - Соответствие - имя способа вывода → имя класса; задано — журнал
//                          хаба связывается узлами logos (необязательный).
//  _Имена - ИменаПеременныхОкружения - конвенция и список псевдонимов (необязательный).
//
Процедура ПриСозданииОбъекта(Знач _КаталогПриложений = "", Знач _СпособыВыводаЖурнала = Неопределено,
	Знач _Имена = Неопределено) Экспорт

	КаталогПриложений = _КаталогПриложений;
	СпособыВыводаЖурнала = _СпособыВыводаЖурнала;
	Имена = ?(_Имена = Неопределено, Новый ИменаПеременныхОкружения(), _Имена);

КонецПроцедуры
