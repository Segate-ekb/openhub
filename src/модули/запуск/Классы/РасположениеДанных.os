// Где лежат данные хаба, когда настройка oshub.storage.root их не называет: единственный
// хозяин этого умолчания для конфигурации хаба и загрузки настроек.

// Корень данных по умолчанию — относительно каталога запуска.
//
// Возвращаемое значение:
//  Строка - путь.
//
Функция КореньПоУмолчанию() Экспорт
	Возврат "./data";
КонецФункции

// Абсолютный корень данных: заданный либо умолчание.
//
// Параметры:
//  Заданный - Строка - значение oshub.storage.root; пустое — не задано.
//
// Возвращаемое значение:
//  Строка - абсолютный путь.
//
Функция Корень(Знач Заданный) Экспорт
	Путь = ?(ЗначениеЗаполнено(Заданный), Строка(Заданный), КореньПоУмолчанию());
	Возврат Новый Файл(Путь).ПолноеИмя;
КонецФункции
