// Запуск задач при готовности: одно фоновое задание дожидается готовности хаба и исполняет
// задачи контракта ЗадачаПриГотовности по очереди, сбой одной не трогает прочих.

Перем Задачи;        // Массив из ЗадачаПриГотовности
Перем Готовность;    // ГотовностьХаба (наблюдаемость)
Перем ЗапускВФоне;   // ЗапускВФоне (фоновыеЗадания)
Перем ОжиданиеСек;   // сколько ждать готовности, секунд
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Запускает фоновое задание с задачами; без задач ничего не запускает. Вызывающий не ждёт.
//
Процедура Запустить() Экспорт

	Если Задачи.Количество() = 0 Тогда
		Лог.Отладка("Задач при готовности нет");
		Возврат;
	КонецЕсли;

	Лог.Отладка("Задач при готовности %1, жду готовности не дольше %2 с", Задачи.Количество(), ОжиданиеСек);
	ЗапускВФоне.Запустить(ЭтотОбъект);

КонецПроцедуры

// Тело фонового задания: ждёт готовности хаба, затем исполняет задачи по очереди.
// Хаб не стал готов за отведённое время — задачи не исполняются.
//
Процедура Исполнить() Экспорт

	Если НЕ ДождатьсяГотовности() Тогда
		Лог.Предупреждение("Хаб не стал готов за %1 с — задачи при готовности (%2) не исполнены",
			ОжиданиеСек, Задачи.Количество());
		Возврат;
	КонецЕсли;

	Для Каждого Задача Из Задачи Цикл
		Попытка
			Задача.Исполнить();
		Исключение
			Лог.Ошибка("Задача при готовности %1 упала: %2",
				ТипЗнч(Задача), ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

Функция ДождатьсяГотовности()

	ПаузаМс = 500;
	Предел = ТекущаяУниверсальнаяДатаВМиллисекундах() + ОжиданиеСек * 1000;
	Пока НЕ Готовность.Готов() Цикл
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Предел Тогда
			Возврат Ложь;
		КонецЕсли;
		Приостановить(ПаузаМс);
	КонецЦикла;
	Возврат Истина;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗадачаПриГотовности", Тип = "Массив") _Задачи,
	&Пластилин(Значение = "ГотовностьХаба") _Готовность,
	&Пластилин(Значение = "ЗапускВФоне") _ЗапускВФоне,
	&Деталька(Значение = "oshub.start.ready_wait_sec", ЗначениеПоУмолчанию = "") _ОжиданиеСек = "",
	&Лог _Лог = Неопределено)

	Задачи = _Задачи;
	Готовность = _Готовность;
	ЗапускВФоне = _ЗапускВФоне;
	ОжиданиеСек = Новый ПриведениеЧисел().ЧислоИлиДефолт(_ОжиданиеСек, 600);
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
