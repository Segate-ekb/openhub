// Ключи настроек запуска: порт хаба, ожидание готовности и освобождение метаданных желудей.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей запуска в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи запуска.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(10)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "winow.Порт", ЗначениеПоУмолчанию = "") _Порт = "",
	&Деталька(Значение = "oshub.start.ready_wait_sec", ЗначениеПоУмолчанию = "") _ОжиданиеГотовности = "",
	&Деталька(Значение = "oshub.start.release_bean_metadata", ЗначениеПоУмолчанию = "") _ОсвобождатьМетаданные = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	Ключи.Объявить("winow.Порт", "целое", 3333, _Правила.Минимум(1), "bootstrap", _Порт);

	// задачи при готовности ждут готовности хаба не дольше этого срока
	Ключи.Объявить("oshub.start.ready_wait_sec", "целое", 600, _Правила.Минимум(1), "bootstrap",
		_ОжиданиеГотовности);
	// после готовности таблицы рефлексии ОСени отпускаются; выключатель на случай сюрпризов
	Ключи.Объявить("oshub.start.release_bean_metadata", "булево", Истина, Неопределено, "bootstrap",
		_ОсвобождатьМетаданные);

КонецПроцедуры
