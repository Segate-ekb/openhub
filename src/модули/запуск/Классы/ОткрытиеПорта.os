// Последний шаг старта: main.os ставит winow.АвтоСтарт = Ложь, поэтому слушатель
// поднимает этот класс — после того как отработали стартовые рогатки.

Перем ВебСервер;            // НативныйВебСервер | ПрикладнойВебСервер (winow)
Перем Готовность;           // ГотовностьХаба (наблюдаемость)
Перем ВосстановлениеКлючей; // ВосстановлениеКлючейЗависимостей (реестр)
&Лог
Перем Лог;

// Доводит данные до состояния, в котором хаб отвечает верно, отмечает синхронную фазу
// старта завершённой и открывает HTTP-порт. Вызов блокирующий: управление не
// возвращается до остановки сервера.
//
Процедура Открыть() Экспорт

	// Разовая починка идёт ЗДЕСЬ, а не рогаткой: рогатки читают базу в одно время
	// с фоновыми — на пустой JSON-базе они ловят друг друга на инициализации таблиц
	// (разбор — ЗНАНИЕ.md). Здесь фоновые уже прошли свои первые чтения, а порт ещё
	// закрыт: строка без ключа не успевает попасть ни в одну выдачу.
	ВосстановлениеКлючей.Восстановить();

	Готовность.ОтметитьСтартЗавершённым();
	Лог.Информация("Стартовые задачи завершены — открываю порт");
	// порт открыт, а /ready отвечает 503 — вот список тех, кого ждём
	Лог.Отладка("Открытие порта: незакрытых гейтов готовности %1",
		Готовность.НезавершённыеЗадачи().Количество());

	ВебСервер.Старт();

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВебСервер") _ВебСервер,
	&Пластилин(Значение = "ГотовностьХаба") _Готовность,
	&Пластилин(Значение = "ВосстановлениеКлючейЗависимостей") _ВосстановлениеКлючей)

	ВебСервер = _ВебСервер;
	Готовность = _Готовность;
	ВосстановлениеКлючей = _ВосстановлениеКлючей;

КонецПроцедуры
