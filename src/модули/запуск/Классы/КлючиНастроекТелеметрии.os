// Ключи настроек телеметрии: выключатель, коллектор, сэмплер трасс, экспортёры сигналов
// и сигналы базы данных. Имена и умолчания — стандартные OpenTelemetry.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей телеметрии в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи телеметрии.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(40)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "otel.enabled", ЗначениеПоУмолчанию = "") _ТелеметрияВключена = "",
	&Деталька(Значение = "otel.exporter.otlp.endpoint", ЗначениеПоУмолчанию = "") _ТелеметрияАдрес = "",
	&Деталька(Значение = "otel.exporter.otlp.protocol", ЗначениеПоУмолчанию = "") _ПротоколOTel = "",
	&Деталька(Значение = "otel.service.name", ЗначениеПоУмолчанию = "") _ИмяСлужбыOTel = "",
	&Деталька(Значение = "otel.traces.sampler", ЗначениеПоУмолчанию = "") _Сэмплер = "",
	&Деталька(Значение = "otel.traces.sampler.arg", ЗначениеПоУмолчанию = "") _ДоляТрасс = "",
	&Деталька(Значение = "otel.bsp.schedule.delay", ЗначениеПоУмолчанию = "") _ИнтервалВыгрузки = "",
	&Деталька(Значение = "otel.bsp.max.queue.size", ЗначениеПоУмолчанию = "") _БуферСпанов = "",
	&Деталька(Значение = "otel.exporter.otlp.timeout", ЗначениеПоУмолчанию = "") _ТаймаутВыгрузки = "",
	&Деталька(Значение = "otel.exporter.otlp.insecure", ЗначениеПоУмолчанию = "") _БезПроверкиСертификата = "",
	&Деталька(Значение = "otel.traces.exporter", ЗначениеПоУмолчанию = "") _ЭкспортерТрасс = "",
	&Деталька(Значение = "otel.metrics.exporter", ЗначениеПоУмолчанию = "") _ЭкспортерМетрик = "",
	&Деталька(Значение = "otel.logs.exporter", ЗначениеПоУмолчанию = "") _ЭкспортерЛогов = "",
	&Деталька(Значение = "otel.metric.export.interval", ЗначениеПоУмолчанию = "") _ИнтервалМетрик = "",
	&Деталька(Значение = "otel.entity.enabled", ЗначениеПоУмолчанию = "") _НаблюдательБазы = "",
	&Деталька(Значение = "otel.entity.repository.enabled", ЗначениеПоУмолчанию = "") _ХранилищаБазы = "",
	&Деталька(Значение = "otel.entity.query-text", ЗначениеПоУмолчанию = "") _ТекстЗапросаБазы = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	// SDK собирается при старте процесса: все ключи — карточки, читает их SDK
	Ключи.Объявить("otel.enabled", "булево", Ложь, Неопределено, "bootstrap", _ТелеметрияВключена);
	Ключи.Объявить("otel.exporter.otlp.endpoint", "строка", "http://localhost:4318", Неопределено,
		"bootstrap", _ТелеметрияАдрес);
	Ключи.Объявить("otel.exporter.otlp.protocol", "строка", "http/protobuf", Неопределено, "bootstrap",
		_ПротоколOTel);
	Ключи.Объявить("otel.service.name", "строка", "openhub", Неопределено, "bootstrap", _ИмяСлужбыOTel);

	// без имени сэмплера SDK долю отбираемых трасс не применяет
	Ключи.Объявить("otel.traces.sampler", "строка", "parentbased_traceidratio",
		_Правила.Перечисление("always_on,always_off,traceidratio,"
			+ "parentbased_always_on,parentbased_always_off,parentbased_traceidratio"),
		"bootstrap", _Сэмплер);
	// доля дробная — такого типа у реестра нет, карточка только читается
	Ключи.Объявить("otel.traces.sampler.arg", "строка", "1.0", Неопределено, "bootstrap", _ДоляТрасс);
	Ключи.Объявить("otel.bsp.schedule.delay", "целое", 5000, _Правила.Минимум(1), "bootstrap",
		_ИнтервалВыгрузки);
	Ключи.Объявить("otel.bsp.max.queue.size", "целое", 2048, _Правила.Минимум(1), "bootstrap", _БуферСпанов);
	Ключи.Объявить("otel.exporter.otlp.timeout", "целое", 10000, _Правила.Минимум(1), "bootstrap",
		_ТаймаутВыгрузки);
	Ключи.Объявить("otel.exporter.otlp.insecure", "булево", Ложь, Неопределено, "bootstrap",
		_БезПроверкиСертификата);

	// сигнал выключают его экспортёром: "none" — сигнал не уезжает, остальные работают
	Ключи.Объявить("otel.traces.exporter", "строка", "otlp", _Правила.Перечисление("otlp,none"),
		"bootstrap", _ЭкспортерТрасс);
	Ключи.Объявить("otel.metrics.exporter", "строка", "otlp", _Правила.Перечисление("otlp,none"),
		"bootstrap", _ЭкспортерМетрик);
	Ключи.Объявить("otel.logs.exporter", "строка", "otlp", _Правила.Перечисление("otlp,none"),
		"bootstrap", _ЭкспортерЛогов);
	// метрики уезжают срезом по расписанию
	Ключи.Объявить("otel.metric.export.interval", "целое", 60000, _Правила.Минимум(1), "bootstrap",
		_ИнтервалМетрик);

	// сигналы базы: пусто — «как otel.enabled», поэтому строка; истина — только слово true
	Ключи.Объявить("otel.entity.enabled", "строка", "", _Правила.Перечисление("true,false,"),
		"bootstrap", _НаблюдательБазы);
	Ключи.Объявить("otel.entity.repository.enabled", "строка", "", _Правила.Перечисление("true,false,"),
		"bootstrap", _ХранилищаБазы);
	// текст запроса в спане не обезличен — выключен по умолчанию
	Ключи.Объявить("otel.entity.query-text", "булево", Ложь, Неопределено, "bootstrap", _ТекстЗапросаБазы);

КонецПроцедуры
