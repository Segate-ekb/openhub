// Перечень событий хаба: какие события существуют, как называются по-человечески и на какие
// из них пользователь вправе подписаться.

Перем Издатель;    // ИздательСобытий (события) — источник строковых имён типов
Перем Заполнение;  // ЗаполнениеПула (основа) — границы порога подписки на заполнение
Перем Записи;      // Массив из Структура; порядок значим — он же порядок в UI
Перем Индекс;      // Соответствие: Тип -> Структура
Перем Строки;      // КанонСтроки (основа)

#Область ПубличныйИнтерфейс

// Полный перечень событий хаба в стабильном порядке.
//
// Возвращаемое значение:
//  Массив - структуры {Тип, Подпись, Пояснение, ДляПодписки, ПочемуВнутреннее}.
//
Функция Все() Экспорт
	Возврат Записи;
КонецФункции

// Есть ли тип события в перечне.
//
// Параметры:
//  Тип - Строка - имя типа события.
//
// Возвращаемое значение:
//  Булево - Истина, если тип объявлен в перечне.
//
Функция Содержит(Знач Тип) Экспорт
	Возврат Индекс.Получить(Ключ(Тип)) <> Неопределено;
КонецФункции

// Запись перечня по типу события.
//
// Параметры:
//  Тип - Строка - имя типа события.
//
// Возвращаемое значение:
//  Структура, Неопределено - запись перечня либо Неопределено для неизвестного типа.
//
Функция Запись(Знач Тип) Экспорт
	Возврат Индекс.Получить(Ключ(Тип));
КонецФункции

// Типы событий, на которые пользователь вправе подписаться, в порядке перечня.
//
// Возвращаемое значение:
//  Массив - имена типов событий (Строка).
//
Функция ТипыДляПодписки() Экспорт

	Результат = Новый Массив();
	Для Каждого Элемент Из Записи Цикл
		Если Элемент.ДляПодписки Тогда
			Результат.Добавить(Элемент.Тип);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Доступно ли событие для подписки пользователя.
//
// Параметры:
//  Тип - Строка - имя типа события.
//
// Возвращаемое значение:
//  Булево - Истина, если на событие можно подписаться; для неизвестного типа Ложь.
//
Функция ДоступноДляПодписки(Знач Тип) Экспорт

	Элемент = Запись(Тип);
	Возврат Элемент <> Неопределено И Элемент.ДляПодписки;

КонецФункции

// Описание параметра, который подписка вправе задать этому событию.
//
// Параметры:
//  Тип - Строка - имя типа события.
//
// Возвращаемое значение:
//  Структура, Неопределено - Имя (Строка), Минимум, Максимум, ПоУмолчанию (Число);
//                            Неопределено, если параметра у события нет.
//
Функция ПараметрПодписки(Знач Тип) Экспорт

	Элемент = Запись(Тип);
	Возврат ?(Элемент = Неопределено, Неопределено, Элемент.Параметр);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Ключ(Знач Тип)
	Возврат Строки.Канон(Тип);
КонецФункции

// Повторный тип роняет сборку желудя: дубль означал бы два описания одного события.
Процедура Добавить(Знач Тип, Знач Подпись, Знач Пояснение, Знач ДляПодписки,
	Знач ПочемуВнутреннее = "", Знач Параметр = Неопределено)

	Если Индекс.Получить(Ключ(Тип)) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон("Каталог событий: тип ""%1"" объявлен дважды", Тип);
	КонецЕсли;

	Элемент = Новый Структура("Тип, Подпись, Пояснение, ДляПодписки, ПочемуВнутреннее, Параметр",
		Строка(Тип), Строка(Подпись), Строка(Пояснение), ДляПодписки = Истина,
		Строка(ПочемуВнутреннее), Параметр);

	Записи.Добавить(Элемент);
	Индекс.Вставить(Ключ(Тип), Элемент);

КонецПроцедуры

Функция ПорогЗаполнения()
	Возврат Новый Структура("Имя, Минимум, Максимум, ПоУмолчанию",
		"порог", Заполнение.МинимальныйПорог(), Заполнение.МаксимальныйПорог(),
		Заполнение.ПорогПоУмолчанию());
КонецФункции

#КонецОбласти

&Прозвище("КаталогСобытий")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "ЗаполнениеПула") _Заполнение,
	&Пластилин(Значение = "КанонСтроки") _Строки = Неопределено)

	Строки = ?(_Строки = Неопределено, Новый КанонСтроки(), _Строки);
	Издатель = _Издатель;
	Заполнение = _Заполнение;
	Записи = Новый Массив();
	Индекс = Новый Соответствие();

	// Доступные для подписки: их доставляет ПодписчикВебхуков, их нагрузка несёт скоуп.
	Добавить(Издатель.ТипВерсияОпубликована(), "Версия опубликована",
		"В пул принята новая версия пакета (push через opm или API).", Истина);

	Добавить(Издатель.ТипВерсияОтозвана(), "Версия отозвана",
		"Новые установки версию не выбирают, артефакт остаётся доступен.", Истина);

	Добавить(Издатель.ТипВерсияВосстановлена(), "Версия восстановлена",
		"Отзыв снят — версия снова участвует в разрешении зависимостей.", Истина);

	// Единственное событие с параметром подписки: порог задаётся при подписке, письмо
	// уходит на его пересечении и дальше на каждом следующем десятке процентов.
	Добавить(Издатель.ТипПулЗаполнен(), "Пул заполняется",
		"Занятый пулом объём вырос и достиг заданного при подписке процента квоты.",
		Истина, "", ПорогЗаполнения());

	// Внутренние: перечислены, чтобы список не разъезжался с кодом; подписка не предлагается.
	Добавить(Издатель.ТипСкачиваниеЗафиксировано(), "Скачивание зафиксировано",
		"Отдано тело артефакта .ospx (источник статистики).", Ложь,
		"Событие горячего пути: возникает на КАЖДОЕ скачивание. Подписка на него — это поток"
		+ " трафика, а не уведомление; для чисел есть витрина статистики.");

	Добавить(Издатель.ТипКоллизияИмениАпстрима(), "Коллизия имени с апстримом",
		"Публикуемое имя уже присутствует на апстриме пула — имя захвачено локально.", Ложь,
		"Диагностика публикации: нагрузка события описывает случай для журнала аудита и не"
		+ " несёт скоупа доставки. Читается в аудите хаба.");

	Добавить(Издатель.ТипЗеркалоСинхронизировано(), "Зеркало синхронизировано",
		"Закончен обход апстрима зеркалом — целиком, а не очередной его порцией.", Ложь,
		"Операционное событие обслуживания: относится к настройке зеркала, а не к пакету."
		+ " Итог обхода виден в журнале, ход по порциям — на странице зеркал и в отладке.");

	Добавить(Издатель.ТипВерсияЗеркалирована(), "Версия приехала зеркалом",
		"Версия пакета уложена в пул зеркалом с названного администратором апстрима —"
		+ " публикацией человека она не является.", Ложь,
		"Запись происхождения для журнала аудита: она и отличает приезд зеркалом от push"
		+ " человека. Нагрузка собрана под журнал (Кто/Действие/Объект/ДеталиJSON), Кто"
		+ " у неё — сам хаб; подписчику пакета о появлении версии говорит"
		+ " «версия.опубликована».");

	Добавить(Издатель.ТипТегПеремещён(), "Состав канала изменён",
		"Тег (канал обновления) стал отдавать другую версию.", Ложь,
		"Нагрузка события собрана под журнал аудита (Кто/Действие/Объект/ДеталиJSON) и не"
		+ " несёт ни идентификатора пула, ни идентификатора пакета — доставить его подписке"
		+ " объекта сегодня некуда. Первый кандидат на перевод в подписочные.");

	Добавить(Издатель.ТипРежимТегаИзменён(), "Режим тега изменён",
		"Тег переведён из ручного режима в режим правила или обратно.", Ложь,
		"Та же нагрузка «под аудит», что и у переезда канала.");

	Добавить(Издатель.ТипЗапретПерезаписиИзменён(), "Запрет повторной публикации изменён",
		"Тегу разрешили или запретили переиздавать номер версии, который под него попадает.", Ложь,
		"Снятый запрет открывает перезапись опубликованного номера всем, кто вправе"
		+ " публиковать, поэтому событие безопасности собрано под журнал аудита"
		+ " (Кто/Действие/Объект/ДеталиJSON), как и прочие правки тега.");

	Добавить(Издатель.ТипТегУдалён(), "Тег удалён",
		"Координата «пакет@тег» перестала существовать.", Ложь,
		"Та же нагрузка «под аудит», что и у переезда канала.");

	Добавить(Издатель.ТипПраваИзменены(), "Права доступа изменены",
		"Субъекту выдана, изменена или отозвана роль на хабе, пуле или пакете.", Ложь,
		"Событие безопасности: его адресат — журнал аудита и администратор, а не подписчик"
		+ " пакета. Нагрузка собрана под журнал (Кто/Действие/Объект/ДеталиJSON) и назвала бы"
		+ " подписчику субъектов чужих прав — раздавать это подпиской нельзя.");

	Добавить(Издатель.ТипРольХабаИзменена(), "Роль учётки на хабе изменена",
		"Учётной записи выдана либо снята роль администратора хаба.", Ложь,
		"Событие безопасности уровня хаба: администратор получает полные права на всю"
		+ " инсталляцию, и адресат такой записи — журнал аудита, а не подписчик пакета."
		+ " Нагрузка собрана под журнал (Кто/Действие/Объект/ДеталиJSON) и называет чужую"
		+ " учётку — раздавать это подпиской нельзя.");

	Добавить(Издатель.ТипПриглашениеУчётки(), "Приглашение учётной записи",
		"Администратор завёл учётную запись или выпустил ей одноразовую ссылку установки"
		+ " пароля; по такой ссылке установлен пароль и открыт вход.", Ложь,
		"Событие безопасности уровня хаба: ссылка установки пароля открывает вход в чужую"
		+ " учётку, и адресат такой записи — журнал аудита и администратор. Нагрузка"
		+ " собрана под журнал (Кто/Действие/Объект/ДеталиJSON), самой ссылки в ней нет"
		+ " и быть не может — раздавать это подпиской нельзя.");

	Добавить(Издатель.ТипПодтверждениеАдреса(), "Подтверждение адреса учётной записи",
		"Учётке послано письмо со ссылкой подтверждения адреса либо адрес подтверждён"
		+ " переходом по такой ссылке.", Ложь,
		"Событие безопасности уровня хаба: адресат такой записи — журнал аудита"
		+ " и администратор. Нагрузка собрана под журнал (Кто/Действие/Объект/ДеталиJSON)"
		+ " и называет адрес чужой учётки — раздавать это подпиской нельзя.");

	Добавить(Издатель.ТипДовериеИзменено(), "Доверие конвейеру изменено",
		"Конвейеру сборки выдано либо отозвано право публиковать версии пакета.", Ложь,
		"Событие безопасности: доверенный конвейер — это выданное право на публикацию,"
		+ " и его адресат тот же, что у прав доступа, — журнал аудита и администратор."
		+ " Нагрузка собрана под журнал (Кто/Действие/Объект/ДеталиJSON) и называет"
		+ " репозиторий и реф чужой сборки — раздавать это подпиской нельзя.");

	Добавить(Издатель.ТипПровайдерВходаИзменён(), "Провайдер входа изменён",
		"Провайдер социального логина заведён, изменён, включён, выключен или удалён.", Ложь,
		"Событие безопасности уровня хаба: его адресат — журнал аудита и администратор."
		+ " Нагрузка собрана под журнал (Кто/Действие/Объект/ДеталиJSON), скоупа пула или"
		+ " пакета у неё нет — доставить подписке объекта её некуда.");

	Добавить(Издатель.ТипВходЗаблокирован(), "Вход заблокирован",
		"Подбор исчерпал лимит попыток: заперта учётная запись либо адрес источника."
		+ " Запись несёт срок, до которого вход закрыт.", Ложь,
		"Событие безопасности уровня хаба: закрытый вход администратора — это отъём его"
		+ " власти над инсталляцией, и адресат такой записи — журнал аудита и администратор."
		+ " Нагрузка называет чужую учётку и адрес источника — раздавать это подпиской нельзя.");

	Добавить(Издатель.ТипВходРазблокирован(), "Вход после блокировки состоялся",
		"Запертая учётная запись снова вошла — подбор прекратился, срок замка истёк.", Ложь,
		"Событие безопасности того же класса, что и замок. Парности с ним НЕ обещает:"
		+ " замок истекает сам, а лимит попыток живёт в памяти процесса и рестартом"
		+ " стирается — поэтому «когда закрылся» отвечает срок в записи замка,"
		+ " а не наличие этой записи.");

	Добавить(Издатель.ТипПробаПодписки(), "Пробная доставка подписки",
		"Владелец подписки отправил на неё пробное уведомление с экрана.", Ложь,
		"Действие администратора, а не событие хаба: адресат у него один — сама подписка,"
		+ " которую и проверяют. Нагрузка собрана под журнал аудита.");

	Добавить(Издатель.ТипОсновнойПулНазначен(), "Основной пул хаба назначен",
		"Короткие адреса /download, /dev-channel и /push переведены в другой пул.", Ложь,
		"Административное событие уровня хаба: нагрузка собрана под журнал аудита"
		+ " (Кто/Действие/Объект/ДеталиJSON). Скоуп у него — весь хаб, а не пул или пакет,"
		+ " поэтому доставить его подписке объекта некуда.");

	Добавить(Издатель.ТипПулУдалён(), "Пул удалён",
		"Пул снесён вместе со всем содержимым: пакетами, файлами, правами, ключами,"
		+ " подписками, зеркалами, апстримами и незакрытыми заявками.", Ложь,
		"Событие уровня хаба: удаление пула — право уровня хаба, и адресат такой записи —"
		+ " журнал аудита и администратор. Подписаться на него мог бы только тот, чья"
		+ " подписка вместе с пулом и уничтожена, — доставлять её уже некуда.");

	Добавить(Издатель.ТипЛичныеПространстваИзменены(), "Личные пространства изменены",
		"Настройка «Личные пространства» раздала пулы всем учёткам либо снесла их все.", Ложь,
		"Административное событие уровня хаба: нагрузка собрана под журнал аудита"
		+ " (Кто/Действие/Объект/ДеталиJSON) и несёт числа операции. Скоуп у неё — весь хаб,"
		+ " а не пул или пакет, поэтому доставить её подписке объекта некуда.");

	Добавить(Издатель.ТипНастройкаИзменена(), "Настройка изменена",
		"Прикладная настройка хаба изменена или сброшена через кабинет.", Ложь,
		"Административное событие хаба: нагрузка собрана под журнал аудита"
		+ " (Кто/Действие/Объект/ДеталиJSON) и не несёт скоупа пула или пакета —"
		+ " доставить его подписке объекта некуда.");

КонецПроцедуры
