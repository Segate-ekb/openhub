// Объявления событий одного предмета словами: ими предмет отвечает на контракт
// ОписанияСобытий, а КаталогСобытий собирает объявления всех предметов.

Перем Записи;  // Массив из Структура в порядке объявления

#Область ПубличныйИнтерфейс

// Объявляет событие, на которое пользователь вправе подписаться. Код обязателен: им событие
// называется за пределами хаба, где кириллица не проходит, — в заголовке вебхука.
//
// Параметры:
//  Тип - Строка - имя типа события в шине.
//  Код - Строка - латинский код события: строчные слова через точку, например «version.published».
//  Подпись - Строка - название события для человека.
//  Пояснение - Строка - что произошло.
//  Параметр - Структура, Неопределено - параметр подписки: Имя, Минимум, Максимум,
//             ПоУмолчанию (необязательный, по умолчанию Неопределено — параметра нет).
//
Процедура ОбъявитьПодписочное(Знач Тип, Знач Код, Знач Подпись, Знач Пояснение,
	Знач Параметр = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(Код) Тогда
		ВызватьИсключение СтрШаблон("Объявления событий: у подписочного события «%1» нет латинского кода", Тип);
	КонецЕсли;
	Добавить(Тип, Код, Подпись, Пояснение, Истина, "", Параметр);

КонецПроцедуры

// Объявляет событие, подписка на которое не предлагается.
//
// Параметры:
//  Тип - Строка - имя типа события в шине.
//  Подпись - Строка - название события для человека.
//  Пояснение - Строка - что произошло.
//  ПочемуВнутреннее - Строка - почему подписаться на него нельзя.
//  Код - Строка - латинский код, если событие всё же уходит наружу подписке, как проба
//        (необязательный, по умолчанию "" — наружу не уходит). Стоит последним, а не вторым,
//        как у ОбъявитьПодписочное: у внутреннего события код — исключение, а не правило.
//
Процедура ОбъявитьВнутреннее(Знач Тип, Знач Подпись, Знач Пояснение, Знач ПочемуВнутреннее,
	Знач Код = "") Экспорт
	Добавить(Тип, Код, Подпись, Пояснение, Ложь, ПочемуВнутреннее, Неопределено);
КонецПроцедуры

// События в порядке объявления.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Тип - Строка - имя типа события в шине.
//   * Код - Строка - латинский код события; пусто — наружу событие не уходит.
//   * Подпись - Строка - название события для человека.
//   * Пояснение - Строка - что произошло.
//   * ДляПодписки - Булево - вправе ли пользователь подписаться.
//   * ПочемуВнутреннее - Строка - почему подписка не предлагается; у подписочных пусто.
//   * Параметр - Структура, Неопределено - параметр подписки либо Неопределено.
//
Функция События() Экспорт
	Возврат Записи;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Добавить(Знач Тип, Знач Код, Знач Подпись, Знач Пояснение, Знач ДляПодписки,
	Знач ПочемуВнутреннее, Знач Параметр)

	ПроверитьКод(Тип, Код);
	Записи.Добавить(Новый Структура("Тип, Код, Подпись, Пояснение, ДляПодписки, ПочемуВнутреннее, Параметр",
		Строка(Тип), Строка(Код), Строка(Подпись), Строка(Пояснение), ДляПодписки,
		Строка(ПочемуВнутреннее), Параметр));

КонецПроцедуры

// Код уходит в заголовок HTTP: только строчная латиница, цифры и «_», слова через точку.
Процедура ПроверитьКод(Знач Тип, Знач Код)

	Если НЕ ЗначениеЗаполнено(Код) Тогда
		Возврат;
	КонецЕсли;
	Слова = СтрРазделить(Код, ".", Истина);
	Годен = Слова.Количество() >= 2;
	Для Каждого Слово Из Слова Цикл
		Годен = Годен И ГодноеСлово(Слово);
	КонецЦикла;
	Если НЕ Годен Тогда
		ВызватьИсключение СтрШаблон("Объявления событий: код «%1» события «%2» — не строчные латинские"
			+ " слова через точку", Код, Тип);
	КонецЕсли;

КонецПроцедуры

Функция ГодноеСлово(Знач Слово)
	Если НЕ ЗначениеЗаполнено(Слово) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Номер = 1 По СтрДлина(Слово) Цикл
		Если СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789_", Сред(Слово, Номер, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
КонецПроцедуры
