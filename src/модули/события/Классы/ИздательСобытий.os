#КонецОбласти

#Область ПубличныйИнтерфейс

// Подписывает объект на события заданного типа.
//
// Параметры:
//  ТипСобытия - Строка - имя типа события (см. функции-константы).
//  Подписчик - Объект - объект с методом ОбработатьСобытие(Знач Событие).
//
Процедура Подписать(Знач ТипСобытия, Знач Подписчик) Экспорт

	Список = Подписки.Получить(ТипСобытия);
	Если Список = Неопределено Тогда
		Список = Новый Массив();
		Подписки.Вставить(ТипСобытия, Список);
	КонецЕсли;
	Список.Добавить(Подписчик);

КонецПроцедуры

// Доставляет доменное событие всем подписчикам его типа.
// Наружу исключение не выбрасывает: доставка каждому подписчику изолирована.
//
// Параметры:
//  ТипСобытия - Строка - имя типа события.
//  Данные - Структура - полезная нагрузка, поля зависят от типа (необязательный,
//           по умолчанию пустая структура).
//  Момент - Дата - момент события в UTC (необязательный, по умолчанию текущий).
//
Процедура Опубликовать(Знач ТипСобытия, Знач Данные = Неопределено, Знач Момент = Неопределено) Экспорт

	Событие = Новый Структура("Тип, Когда, Данные",
		ТипСобытия,
		?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент),
		?(Данные = Неопределено, Новый Структура(), Данные));

	Список = Подписки.Получить(ТипСобытия);
	Если Список = Неопределено Тогда
		// лог — по возможности: издателя создают и напрямую, инъекция туда не доезжает
		Если Лог <> Неопределено Тогда
			Лог.Отладка("События: ""%1"" опубликовано, подписчиков на него нет", ТипСобытия);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Сбои = 0;
	Спан = Неопределено;
	Если Телеметрия <> Неопределено Тогда
		Атрибуты = Новый Соответствие();
		Атрибуты.Вставить("messaging.operation", "publish");
		Атрибуты.Вставить("oshub.event.type", ТипСобытия);
		Атрибуты.Вставить("oshub.event.subscribers", Список.Количество());
		Спан = Телеметрия.НачатьСпан("events.publish", "producer", Атрибуты);
	КонецЕсли;

	Для Каждого Подписчик Из Список Цикл
		Попытка
			Подписчик.ОбработатьСобытие(Событие);
		Исключение
			// Изоляция: сбой подписчика не роняет остальных и производителя. Но молчать
			// нельзя: так журнал безопасности переставал писаться без единого следа.
			Сбои = Сбои + 1;
			// счётчик обязателен, лог — по возможности: издателя создают и напрямую,
			// а инъекция &Лог до созданного `Новый` объекта не доезжает
			Если Лог <> Неопределено Тогда
				Лог.Ошибка("Подписчик события ""%1"" упал и событие пропустил: %2",
					ТипСобытия, ОписаниеОшибки());
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	Пропущено = Пропущено + Сбои;

	Если Лог <> Неопределено Тогда
		Лог.Отладка("События: ""%1"" разослано подписчикам (%2), из них уронили доставку %3",
			ТипСобытия, Список.Количество(), Сбои);
	КонецЕсли;

	Если Спан <> Неопределено Тогда
		Спан.Завершить();
	КонецЕсли;

КонецПроцедуры

// Сколько доставок подписчики уронили за жизнь процесса. Ноль — обязательное состояние
// журнала безопасности: любое другое значение означает пропущенные записи.
//
// Возвращаемое значение:
//  Число.
//
Функция ПропущенныхДоставок() Экспорт
	Возврат Пропущено;
КонецФункции

// Число подписчиков заданного типа события.
//
// Параметры:
//  ТипСобытия - Строка - имя типа события.
//
// Возвращаемое значение:
//  Число - количество подписчиков; 0, если подписок нет.
//
Функция КоличествоПодписчиков(Знач ТипСобытия) Экспорт
	Список = Подписки.Получить(ТипСобытия);
	Возврат ?(Список = Неопределено, 0, Список.Количество());
КонецФункции

#КонецОбласти

// Телеметрия опциональна: без неё издатель строится в любом контейнере, спан не создаётся.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Телеметрия") НоваяТелеметрия = Неопределено,
	&Лог _Лог = Неопределено)
	Подписки = Новый Соответствие();
	Телеметрия = НоваяТелеметрия;
	Пропущено = 0;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
КонецПроцедуры
