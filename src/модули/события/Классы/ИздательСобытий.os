#КонецОбласти

#Область ПубличныйИнтерфейс

// Подписывает объект на события заданного типа.
//
// Параметры:
//  ТипСобытия - Строка - имя типа события (см. функции-константы).
//  Подписчик - Объект - объект с методом ОбработатьСобытие(Знач Событие).
//
Процедура Подписать(Знач ТипСобытия, Знач Подписчик) Экспорт

	Блокировка.Заблокировать();
	Попытка
		Подписки = СПодписчиком(ТипСобытия, Подписчик);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

КонецПроцедуры

// Доставляет доменное событие всем подписчикам его типа.
// Наружу исключение не выбрасывает: доставка каждому подписчику изолирована.
//
// Параметры:
//  ТипСобытия - Строка - имя типа события.
//  Данные - Структура - полезная нагрузка, поля зависят от типа (необязательный,
//           по умолчанию пустая структура).
//  Момент - Дата - момент события в UTC (необязательный, по умолчанию текущий).
//
&Наблюдаемый("events.publish", ВидСпана = "producer")
Процедура Опубликовать(&АтрибутСпана("oshub.event.type") Знач ТипСобытия, Знач Данные = Неопределено,
	Знач Момент = Неопределено) Экспорт

	Событие = Новый Структура("Тип, Когда, Данные",
		ТипСобытия,
		?(Момент = Неопределено, ТекущаяУниверсальнаяДата(), Момент),
		?(Данные = Неопределено, Новый Структура(), Данные));

	Список = Подписки.Получить(ТипСобытия);
	Если Список = Неопределено Тогда
		// лог — по возможности: у издателя, созданного Новый, &Лог не внедряется
		Если Лог <> Неопределено Тогда
			Лог.Отладка("События: ""%1"" опубликовано, подписчиков на него нет", ТипСобытия);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Сбои = 0;

	Для Каждого Подписчик Из Список Цикл
		Попытка
			Подписчик.ОбработатьСобытие(Событие);
		Исключение
			// сбой подписчика не роняет остальных, но считается и пишется в журнал
			Сбои = Сбои + 1;
			Если Лог <> Неопределено Тогда
				Лог.Ошибка("Подписчик события ""%1"" упал и событие пропустил: %2",
					ТипСобытия, ОписаниеОшибки());
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	Если Сбои > 0 Тогда
		УчестьПропуски(Сбои);
	КонецЕсли;

	Если Лог <> Неопределено Тогда
		Лог.Отладка("События: ""%1"" разослано подписчикам (%2), из них уронили доставку %3",
			ТипСобытия, Список.Количество(), Сбои);
	КонецЕсли;

КонецПроцедуры

// Сколько доставок подписчики уронили за жизнь процесса. Ноль — обязательное состояние
// журнала безопасности: любое другое значение означает пропущенные записи.
//
// Возвращаемое значение:
//  Число.
//
Функция ПропущенныхДоставок() Экспорт
	Возврат Пропущено;
КонецФункции

// Число подписчиков заданного типа события.
//
// Параметры:
//  ТипСобытия - Строка - имя типа события.
//
// Возвращаемое значение:
//  Число - количество подписчиков; 0, если подписок нет.
//
Функция КоличествоПодписчиков(Знач ТипСобытия) Экспорт
	Список = Подписки.Получить(ТипСобытия);
	Возврат ?(Список = Неопределено, 0, Список.Количество());
КонецФункции

#КонецОбласти

// Подписки меняются только копией: публикация обходит неизменный снимок без замка, а
// опубликованные карта и списки после публикации уже никем не правятся. Зовётся под блокировкой.
Функция СПодписчиком(Знач ТипСобытия, Знач Подписчик)

	Карта = Новый Соответствие();
	Для Каждого Пара Из Подписки Цикл
		Карта.Вставить(Пара.Ключ, Пара.Значение);
	КонецЦикла;

	Список = Новый Массив();
	Прежний = Подписки.Получить(ТипСобытия);
	Если Прежний <> Неопределено Тогда
		Для Каждого Подписанный Из Прежний Цикл
			Список.Добавить(Подписанный);
		КонецЦикла;
	КонецЕсли;
	Список.Добавить(Подписчик);
	Карта.Вставить(ТипСобытия, Список);

	Возврат Карта;

КонецФункции

Процедура УчестьПропуски(Знач Сбои)

	Блокировка.Заблокировать();
	Попытка
		Пропущено = Пропущено + Сбои;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(&Лог _Лог = Неопределено)
	Подписки = Новый Соответствие();
	Пропущено = 0;
	Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
КонецПроцедуры
