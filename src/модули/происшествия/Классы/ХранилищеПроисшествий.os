// Хранилище происшествий — репозиторий сущности «Происшествие»: выборки по паре
// подсистема + объект, уборка по сроку, счёт и признак наличия агрегатом базы.

// BSLLS:UnusedParameters-off

#Использовать entity

Перем Сам;        // Табакерка с этим же хранилищем: &МетодЗапроса изнутри — только через неё
Перем Агрегаты;   // АгрегатыБазы (данные) — счёт и признак наличия спрашиваются у базы

// Происшествия подсистемы по объекту, последние сверху. Свёртка читает этот срез целиком:
// он ограничен потолком на объект, и из него же видно, сколько слотов занято.
//
// Параметры:
//  Подсистема - Строка.
//  Объект - Строка.
//
// Возвращаемое значение:
//  Массив из Происшествие.
//
&МетодЗапроса
Функция ПолучитьПоПодсистемаРавноИОбъектРавноУпорядочитьПоПоследнийУбывИдентификаторУбыв(
	Подсистема, Объект) Экспорт
	Возврат Неопределено;
КонецФункции

// Происшествия подсистемы сразу по нескольким объектам, последние сверху: экран списка
// читает их одним запросом вместо запроса на строку, а отбор делает бэкенд.
//
// Параметры:
//  Подсистема - Строка.
//  Объекты - Массив из Строка.
//
// Возвращаемое значение:
//  Массив из Происшествие.
//
&МетодЗапроса
Функция ПолучитьПоПодсистемаРавноИОбъектВУпорядочитьПоПоследнийУбывИдентификаторУбыв(
	Подсистема, Объекты) Экспорт
	Возврат Неопределено;
КонецФункции

// Происшествия подсистемы по объекту в пределах одного обхода, последние сверху.
//
// Параметры:
//  Подсистема - Строка.
//  Объект - Строка.
//  Прогон - Строка.
//
// Возвращаемое значение:
//  Массив из Происшествие.
//
&МетодЗапроса
Функция ПолучитьПоПодсистемаРавноИОбъектРавноИПрогонРавноУпорядочитьПоПоследнийУбывИдентификаторУбыв(
	Подсистема, Объект, Прогон) Экспорт
	Возврат Неопределено;
КонецФункции

// Происшествия, которых последний раз касались раньше названного момента.
//
// Параметры:
//  Момент - Дата - граница срока.
//
// Возвращаемое значение:
//  Массив из Происшествие.
//
&МетодЗапроса
Функция ПолучитьПоПоследнийМеньше(Момент) Экспорт
	Возврат Неопределено;
КонецФункции

// Происшествия подсистемы по объекту, последние сверху. Аргументы приводятся к тексту
// без окружающих пробелов, Неопределено — к пустой строке: так их записывает летопись.
//
// Параметры:
//  Подсистема - Строка - «хранилище» | «зеркало» | «источник».
//  Объект - Строка - адрес объекта.
//
// Возвращаемое значение:
//  Массив из Происшествие.
//
Функция ПоОбъекту(Знач Подсистема, Знач Объект) Экспорт

	Возврат Сам.Достать().ПолучитьПоПодсистемаРавноИОбъектРавноУпорядочитьПоПоследнийУбывИдентификаторУбыв(
		Текстом(Подсистема), Текстом(Объект));

КонецФункции

// Происшествия подсистемы по нескольким объектам сразу, последние сверху: срез для
// экрана, показывающего список объектов. Пустой список объектов до базы не доезжает.
//
// Параметры:
//  Подсистема - Строка - «хранилище» | «зеркало» | «источник».
//  Объекты - Массив из Строка - адреса объектов.
//
// Возвращаемое значение:
//  Массив из Происшествие.
//
Функция ПоОбъектам(Знач Подсистема, Знач Объекты) Экспорт

	Отбор = Новый Массив();
	Для Каждого Объект Из Объекты Цикл
		Отбор.Добавить(Текстом(Объект));
	КонецЦикла;

	Если Отбор.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Возврат Сам.Достать().ПолучитьПоПодсистемаРавноИОбъектВУпорядочитьПоПоследнийУбывИдентификаторУбыв(
		Текстом(Подсистема), Отбор);

КонецФункции

// Происшествия подсистемы по объекту в пределах одного обхода, последние сверху.
// Аргументы приводит к тексту так же, как ПоОбъекту.
//
// Параметры:
//  Подсистема - Строка - подсистема.
//  Объект - Строка - адрес объекта.
//  Прогон - Строка - метка обхода.
//
// Возвращаемое значение:
//  Массив из Происшествие.
//
Функция ПоОбъектуИПрогону(Знач Подсистема, Знач Объект, Знач Прогон) Экспорт

	Возврат Сам.Достать().ПолучитьПоПодсистемаРавноИОбъектРавноИПрогонРавноУпорядочитьПоПоследнийУбывИдентификаторУбыв(
		Текстом(Подсистема), Текстом(Объект), Текстом(Прогон));

КонецФункции

// Происшествия старше срока — выборка ПолучитьПоПоследнийМеньше под именем, которым её
// зовёт уборка по сроку.
//
// Параметры:
//  Момент - Дата - граница срока (UTC).
//
// Возвращаемое значение:
//  Массив из Происшествие.
//
Функция СтарееЧем(Знач Момент) Экспорт
	Возврат Сам.Достать().ПолучитьПоПоследнийМеньше(Момент);
КонецФункции

// Сколько происшествий подсистемы по объекту, при желании в пределах одного обхода.
//
// Параметры:
//  Подсистема - Строка - «хранилище» | «зеркало» | «источник».
//  Объект - Строка - адрес объекта.
//  Прогон - Строка - метка обхода; пусто — все обходы.
//
// Возвращаемое значение:
//  Число.
//
Функция Количество(Знач Подсистема, Знач Объект, Знач Прогон = "") Экспорт
	Возврат Агрегаты.Количество(Сам.Достать(), ОтборСреза(Подсистема, Объект, Прогон));
КонецФункции

// Есть ли у подсистемы хоть одно происшествие по объекту.
//
// Параметры:
//  Подсистема - Строка - «хранилище» | «зеркало» | «источник».
//  Объект - Строка - адрес объекта.
//  Прогон - Строка - метка обхода; пусто — все обходы.
//
// Возвращаемое значение:
//  Булево.
//
Функция Есть(Знач Подсистема, Знач Объект, Знач Прогон = "") Экспорт
	Возврат Агрегаты.Есть(Сам.Достать(), ОтборСреза(Подсистема, Объект, Прогон));
КонецФункции

// Тот же срез, что у выборок ПоОбъекту и ПоОбъектуИПрогону, — отбором для агрегата.
Функция ОтборСреза(Знач Подсистема, Знач Объект, Знач Прогон)

	Отбор = Новый ОпцииПоиска()
		.Отбор("Подсистема", ВидСравнения.Равно, Текстом(Подсистема))
		.Отбор("Объект", ВидСравнения.Равно, Текстом(Объект));

	Если ЗначениеЗаполнено(Прогон) Тогда
		Отбор.Отбор("Прогон", ВидСравнения.Равно, Текстом(Прогон));
	КонецЕсли;

	Возврат Отбор;

КонецФункции

// Пустая строка вместо Неопределено: незаполненное поле одинаково у записи и у условия.
Функция Текстом(Знач Значение)
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
КонецФункции

&ХранилищеСущностей("Происшествие")
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин(Значение = "ХранилищеПроисшествий") _Сам,
	&Пластилин(Значение = "АгрегатыБазы") _Агрегаты)

	Сам = _Сам;
	Агрегаты = _Агрегаты;

КонецПроцедуры
