// Машинные коды происшествий всех подсистем и признак «устранимо следующим прогоном» —
// одно место на экран и API. Коды объявляет каждая подсистема о себе.

Перем Объявленные;  // Соответствие: код -> Истина
Перем Устранимые;   // Соответствие: код -> Истина
Перем Неясные;      // Соответствие: код -> Истина (исход неизвестен)
Перем ВсеКоды;      // Массив из Строка в порядке объявления
Перем Имена;        // Массив из Строка — подсистемы в порядке объявления

#Область ПубличныйИнтерфейс

// Все подсистемы, о которых хаб помнит происшествия.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Подсистемы() Экспорт

	Результат = Новый Массив();
	Для Каждого Имя Из Имена Цикл
		Результат.Добавить(Имя);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Свёртка переполнения: всё, что не поместилось в потолок объекта. Молчания взамен
// переполнения нет — счётчик этой записи растёт за всех.
//
// Возвращаемое значение:
//  Строка.
//
Функция Прочее() Экспорт
	Возврат "other";
КонецФункции

// Все объявленные коды в порядке объявления.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Все() Экспорт

	Результат = Новый Массив();
	Для Каждого Код Из ВсеКоды Цикл
		Результат.Добавить(Код);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пройдёт ли причина сама на следующем заходе. Утверждение делается только там, где
// оно верно; там, где оно неизвестно, спрашивают ИсходНеясен — «нет» и «не знаем»
// это разные ответы, и выдавать второй за первый значит врать оператору.
//
// Параметры:
//  Код - Строка - машинный код причины.
//
// Возвращаемое значение:
//  Булево.
//
Функция Устранимо(Знач Код) Экспорт
	Возврат Устранимые.Получить(СокрЛП(Строка(Код))) = Истина;
КонецФункции

// Известно ли вообще, пройдёт причина сама или нет. Неясен исход у сводки разных причин,
// у нерасклассифицированного сбоя переноса и у незнакомого кода: про них нельзя сказать
// ни «повторится», ни «пропущено насовсем».
//
// Параметры:
//  Код - Строка - машинный код причины.
//
// Возвращаемое значение:
//  Булево.
//
Функция ИсходНеясен(Знач Код) Экспорт

	Значение = СокрЛП(Строка(Код));
	Возврат Объявленные.Получить(Значение) = Неопределено ИЛИ Неясные.Получить(Значение) = Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Код, объявленный двумя подсистемами, роняет сборку: у причины один признак «пройдёт само».
Процедура Объявить(Знач Код, Знач ПройдётСамо, Знач ИсходНеясен)

	Если Объявленные.Получить(Код) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон("КодыПроисшествий: код ""%1"" объявлен дважды", Код);
	КонецЕсли;

	ВсеКоды.Добавить(Код);
	Объявленные.Вставить(Код, Истина);
	Если ПройдётСамо Тогда
		Устранимые.Вставить(Код, Истина);
	КонецЕсли;
	Если ИсходНеясен Тогда
		Неясные.Вставить(Код, Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КодыПроисшествийПодсистемы", Тип = "Массив") _Подсистемы)

	Объявленные = Новый Соответствие();
	Устранимые = Новый Соответствие();
	Неясные = Новый Соответствие();
	ВсеКоды = Новый Массив();
	Имена = Новый Массив();

	Для Каждого Подсистема Из _Подсистемы Цикл
		Объявления = Подсистема.Объявления();
		Имена.Добавить(Объявления.Подсистема());
		Для Каждого Запись Из Объявления.Коды() Цикл
			Объявить(Запись.Код, Запись.ПройдётСамо, Запись.ИсходНеясен);
		КонецЦикла;
	КонецЦикла;

	// «прочее» — сводка разных причин: утверждать про неё нечего ни в одну сторону
	Объявить(Прочее(), Ложь, Истина);

КонецПроцедуры
