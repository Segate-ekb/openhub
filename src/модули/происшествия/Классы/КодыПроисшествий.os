// Машинные коды происшествий, их подсистемы и признак «устранимо следующим прогоном» —
// одно место на домен, экран и API.

Перем Объявленные;  // Соответствие: код -> Истина
Перем Устранимые;   // Соответствие: код -> Истина
Перем Неясные;      // Соответствие: код -> Истина (исход неизвестен)
Перем ВсеКоды;      // Массив из Строка в порядке объявления

#Область Подсистемы

// Подсистема артефактов: S3 либо файловый корень.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПодсистемаХранилище() Экспорт
	Возврат "хранилище";
КонецФункции

// Подсистема планового зеркалирования хаб↔хаб.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПодсистемаЗеркало() Экспорт
	Возврат "зеркало";
КонецФункции

// Подсистема источников пула (проксируемых апстримов).
//
// Возвращаемое значение:
//  Строка.
//
Функция ПодсистемаИсточник() Экспорт
	Возврат "источник";
КонецФункции

// Подсистема встроенной базы стран посетителей.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПодсистемаГео() Экспорт
	Возврат "гео";
КонецФункции

// Все подсистемы, о которых хаб помнит происшествия.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Подсистемы() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(ПодсистемаХранилище());
	Результат.Добавить(ПодсистемаЗеркало());
	Результат.Добавить(ПодсистемаИсточник());
	Результат.Добавить(ПодсистемаГео());
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Зеркало

// Имя пакета у апстрима не проходит правила именования хаба.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяНеПоПравилам() Экспорт
	Возврат Объявленный("mirror_name_rejected");
КонецФункции

// Адрес апстрима не разбирается: собрать ссылку на артефакт нечем.
//
// Возвращаемое значение:
//  Строка.
//
Функция АдресНеРазбирается() Экспорт
	Возврат Объявленный("mirror_url_unparsable");
КонецФункции

// Источник не ответил: сеть, таймаут, отказ соединения.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсточникНеОтветил() Экспорт
	Возврат Объявленный("mirror_upstream_unreachable");
КонецФункции

// Источник ответил отказом; код ответа называет причина, а не код происшествия —
// иначе на одно зеркало пришлось бы по записи на каждый HTTP-статус.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсточникОтветилОтказом() Экспорт
	Возврат Объявленный("mirror_upstream_rejected");
КонецФункции

// Источник ответил без тела: качать нечего.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПустоеТело() Экспорт
	Возврат Объявленный("mirror_empty_body");
КонецФункции

// Пакет больше предела приёма инсталляции.
//
// Возвращаемое значение:
//  Строка.
//
Функция БольшеПределаПриёма() Экспорт
	Возврат Объявленный("mirror_too_large");
КонецФункции

// Привезённый архив не разбирается как пакет OneScript.
//
// Возвращаемое значение:
//  Строка.
//
Функция АрхивНеРазбирается() Экспорт
	Возврат Объявленный("mirror_archive_unreadable");
КонецФункции

// Версия не годится сегментом пути: из неё не собрать ключ в хранилище.
//
// Возвращаемое значение:
//  Строка.
//
Функция ВерсияНеГоднаПутём() Экспорт
	Возврат Объявленный("mirror_version_unsafe");
КонецФункции

// Пул назначения не принял пакет по квоте.
//
// Возвращаемое значение:
//  Строка.
//
Функция КвотаПула() Экспорт
	Возврат Объявленный("mirror_pool_quota");
КонецФункции

// Конфликт с тем, что уже лежит: занятая версия, чужой резерв, запрет перезаписи.
//
// Возвращаемое значение:
//  Строка.
//
Функция КонфликтВерсии() Экспорт
	Возврат Объявленный("mirror_version_conflict");
КонецФункции

// Хранилище артефактов пакет не приняло.
//
// Возвращаемое значение:
//  Строка.
//
Функция ХранилищеНеПриняло() Экспорт
	Возврат Объявленный("mirror_storage_rejected");
КонецФункции

// Артефакт лёг, а реестр о нём не узнал: запись версии сорвалась.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИндексНеОбновился() Экспорт
	Возврат Объявленный("mirror_index_failed");
КонецФункции

// Пула назначения больше нет: обход не начинается вовсе.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПулНазначенияНеНайден() Экспорт
	Возврат Объявленный("mirror_pool_missing");
КонецФункции

// Источник числится лежащим: проба живости его уже отвергла.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсточникЧислитсяЛежащим() Экспорт
	Возврат Объявленный("mirror_upstream_down");
КонецФункции

// Источник не ответил ни одним протоколом чтения — читать его нечем.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПротоколНеОпределён() Экспорт
	Возврат Объявленный("mirror_protocol_unknown");
КонецФункции

// Перенос пакета сорвался, и отказ не назвал себя ни конфликтом, ни хранилищем:
// причину читает человек в самом происшествии.
//
// Возвращаемое значение:
//  Строка.
//
Функция СбойПереноса() Экспорт
	Возврат Объявленный("mirror_transfer_failed");
КонецФункции

// Перечень версий пакета источник не отдал: приедет только последняя, остальные
// обход не увидит вовсе.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПереченьВерсийНеПолучен() Экспорт
	Возврат Объявленный("mirror_versions_unlisted");
КонецФункции

#КонецОбласти

#Область Хранилище

// Хранилище артефактов не отвечает.
//
// Возвращаемое значение:
//  Строка.
//
Функция ХранилищеНеОтвечает() Экспорт
	Возврат Объявленный("storage_unreachable");
КонецФункции

// Хранилище артефактов не пустило: ключи, права, политика бакета.
//
// Возвращаемое значение:
//  Строка.
//
Функция ХранилищеНеПустило() Экспорт
	Возврат Объявленный("storage_denied");
КонецФункции

#КонецОбласти

#Область Источник

// Источник пула лежит.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсточникЛежит() Экспорт
	Возврат Объявленный("upstream_down");
КонецФункции

// Источник пула не пустил: токен, права, политика доступа.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИсточникНеПустил() Экспорт
	Возврат Объявленный("upstream_denied");
КонецФункции

#КонецОбласти

#Область Гео

// Файла встроенной базы стран в инсталляции нет: страна посетителя никому не известна.
//
// Возвращаемое значение:
//  Строка.
//
Функция БазыСтранНет() Экспорт
	Возврат Объявленный("geo_db_missing");
КонецФункции

// Сходить за новым выпуском базы стран не получилось: сеть, отказ издателя, негодный файл.
//
// Возвращаемое значение:
//  Строка.
//
Функция БазаСтранНеОбновилась() Экспорт
	Возврат Объявленный("geo_db_update_failed");
КонецФункции

// База стран давно не менялась: страны в ней могли сместиться.
//
// Возвращаемое значение:
//  Строка.
//
Функция БазаСтранУстарела() Экспорт
	Возврат Объявленный("geo_db_stale");
КонецФункции

#КонецОбласти

#Область ОбщееДляВсех

// Свёртка переполнения: всё, что не поместилось в потолок объекта. Молчания взамен
// переполнения нет — счётчик этой записи растёт за всех.
//
// Возвращаемое значение:
//  Строка.
//
Функция Прочее() Экспорт
	Возврат Объявленный("other");
КонецФункции

// Все объявленные коды в порядке объявления.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Все() Экспорт

	Результат = Новый Массив();
	Для Каждого Код Из ВсеКоды Цикл
		Результат.Добавить(Код);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пройдёт ли причина сама на следующем заходе. Утверждение делается только там, где
// оно верно; там, где оно неизвестно, спрашивают ИсходНеясен — «нет» и «не знаем»
// это разные ответы, и выдавать второй за первый значит врать оператору.
//
// Параметры:
//  Код - Строка - машинный код причины.
//
// Возвращаемое значение:
//  Булево.
//
Функция Устранимо(Знач Код) Экспорт
	Возврат Устранимые.Получить(СокрЛП(Строка(Код))) = Истина;
КонецФункции

// Известно ли вообще, пройдёт причина сама или нет. Неясен исход у сводки разных причин,
// у нерасклассифицированного сбоя переноса и у незнакомого кода: про них нельзя сказать
// ни «повторится», ни «пропущено насовсем».
//
// Параметры:
//  Код - Строка - машинный код причины.
//
// Возвращаемое значение:
//  Булево.
//
Функция ИсходНеясен(Знач Код) Экспорт

	Значение = СокрЛП(Строка(Код));
	Возврат Объявленные.Получить(Значение) = Неопределено ИЛИ Неясные.Получить(Значение) = Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Код, о котором таблица знает. Забытое объявление иначе дало бы код вне Все()
// и молчаливую Ложь в Устранимо — то есть «пропущено насовсем» вместо «повторится».
Функция Объявленный(Знач Код)

	Если Объявленные.Получить(Код) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"КодыПроисшествий: код ""%1"" не объявлен — впишите его в конструктор рядом с остальными", Код);
	КонецЕсли;
	Возврат Код;

КонецФункции

Процедура ОбъявитьНеясным(Знач Код)
	Неясные.Вставить(Объявленный(Код), Истина);
КонецПроцедуры

Процедура Объявить(Знач Код, Знач ПройдётСамо)
	ВсеКоды.Добавить(Код);
	Объявленные.Вставить(Код, Истина);
	Если ПройдётСамо Тогда
		Устранимые.Вставить(Код, Истина);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()

	Объявленные = Новый Соответствие();
	Устранимые = Новый Соответствие();
	Неясные = Новый Соответствие();
	ВсеКоды = Новый Массив();

	// Зеркало. Устранимо то, что зависит от чужой стороны и от места в пуле: сеть,
	// отказ источника, пустое тело, квота, сбой хранилища и индекса, лежащий источник,
	// неопознанный протокол. Неустранимо то, что решено самим пакетом: имя, размер,
	// битый архив, негодная версия, занятое место в реестре, нечитаемый адрес
	// и отсутствующий пул назначения.
	Объявить("mirror_name_rejected", Ложь);
	Объявить("mirror_url_unparsable", Ложь);
	Объявить("mirror_upstream_unreachable", Истина);
	Объявить("mirror_upstream_rejected", Истина);
	Объявить("mirror_empty_body", Истина);
	Объявить("mirror_too_large", Ложь);
	Объявить("mirror_archive_unreadable", Ложь);
	Объявить("mirror_version_unsafe", Ложь);
	Объявить("mirror_pool_quota", Истина);
	Объявить("mirror_version_conflict", Ложь);
	Объявить("mirror_storage_rejected", Истина);
	Объявить("mirror_index_failed", Истина);
	Объявить("mirror_pool_missing", Ложь);
	Объявить("mirror_upstream_down", Истина);
	Объявить("mirror_protocol_unknown", Истина);
	// сорвавшийся перенос не разложен по известным причинам, и обещать «пройдёт само»
	// не на чем: утверждение делается только там, где оно верно
	Объявить("mirror_transfer_failed", Ложь);
	// перечень версий зависит от чужой стороны: ответит страница пакета — приедут все
	Объявить("mirror_versions_unlisted", Истина);

	// Гео. Устарелость снимет следующий удачный заход, неудачу обновления — тоже.
	// Отсутствие файла само не проходит: в закрытом контуре базу кладут руками.
	Объявить("geo_db_missing", Ложь);
	Объявить("geo_db_update_failed", Истина);
	Объявить("geo_db_stale", Истина);

	// Хранилище и источник: обе причины про чужую сторону, обе проходят сами.
	Объявить("storage_unreachable", Истина);
	Объявить("storage_denied", Истина);
	Объявить("upstream_down", Истина);
	Объявить("upstream_denied", Истина);

	// «прочее» — сводка разных причин: утверждать про неё нечего ни в одну сторону.
	Объявить("other", Ложь);

	// исход неизвестен: сводка разных причин и сбой, который не разложен по причинам
	ОбъявитьНеясным("other");
	ОбъявитьНеясным("mirror_transfer_failed");

КонецПроцедуры
