// Ключи настроек происшествий: сколько причин помнится по одному объекту, сколько они живут
// и как часто убираются устаревшие.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей происшествий в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи происшествий.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(170)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "oshub.incidents.max_per_object", ЗначениеПоУмолчанию = "") _ПотолокПроисшествий = "",
	&Деталька(Значение = "oshub.incidents.ttl.sec", ЗначениеПоУмолчанию = "") _СрокПроисшествия = "",
	&Деталька(Значение = "oshub.jobs.incidents_gc_interval_sec", ЗначениеПоУмолчанию = "") _ИнтервалПроисшествий = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	// Оба числа — свойство инсталляции, а не экрана: они держат рост памяти о неудачах.
	Ключи.Объявить("oshub.incidents.max_per_object", "целое", 50, _Правила.Минимум(1), "bootstrap",
		_ПотолокПроисшествий);
	Ключи.Объявить("oshub.incidents.ttl.sec", "целое", 1209600, _Правила.Минимум(60), "bootstrap",
		_СрокПроисшествия);
	Ключи.Объявить("oshub.jobs.incidents_gc_interval_sec", "целое", 3600, _Правила.Минимум(1), "bootstrap",
		_ИнтервалПроисшествий);

КонецПроцедуры
