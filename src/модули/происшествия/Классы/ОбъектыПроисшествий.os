// Адрес объекта происшествия — одна дверь для пишущих и читающих: форма от ИмяОбъектаАудита
// и обезличивание от ОбезличиваниеЖурнала, сложенные так, что адрес с токеном не собрать.

Перем Имена;          // ИмяОбъектаАудита (аудит)
Перем Обезличивание;  // ОбезличиваниеЖурнала (наблюдаемость)

// Адрес планового зеркала.
//
// Параметры:
//  ЗеркалоИдентификатор - Число - идентификатор зеркала.
//
// Возвращаемое значение:
//  Строка - «зеркало/<идентификатор>».
//
Функция Зеркало(Знач ЗеркалоИдентификатор) Экспорт
	Возврат Имена.Зеркало(ЗеркалоИдентификатор);
КонецФункции

// Адрес хранилища артефактов на S3. Назван корзиной, а не эндпоинтом: у эндпоинта
// рядом лежат ключи доступа, и место им не на экране.
//
// Параметры:
//  Бакет - Строка - имя корзины.
//
// Возвращаемое значение:
//  Строка - «хранилище/s3://<корзина>».
//
Функция ХранилищеS3(Знач Бакет) Экспорт
	Возврат Имена.ХранилищеS3(Бакет);
КонецФункции

// Адрес файлового хранилища артефактов.
//
// Параметры:
//  Корень - Строка - корень артефактов.
//
// Возвращаемое значение:
//  Строка - «хранилище/<корень>».
//
Функция ХранилищеФайлами(Знач Корень) Экспорт
	Возврат Имена.ХранилищеФайлами(Корень);
КонецФункции

// Адрес встроенной базы стран.
//
// Параметры:
//  ИмяФайлаБазы - Строка - имя файла базы без каталога.
//
// Возвращаемое значение:
//  Строка - «база-стран/<имя файла>».
//
Функция БазаСтран(Знач ИмяФайлаБазы) Экспорт
	Возврат Имена.БазаСтран(ИмяФайлаБазы);
КонецФункции

// Адрес источника: апстрим без строки запроса и учётных данных.
//
// Параметры:
//  АдресАпстрима - Строка - базовый адрес источника, возможно с секретом.
//
// Возвращаемое значение:
//  Строка - «источник/<обезличенный адрес>».
//
Функция Источник(Знач АдресАпстрима) Экспорт
	Возврат Имена.Источник(Обезличивание.Адрес(АдресАпстрима));
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ИмяОбъектаАудита") _Имена)
	Имена = _Имена;
	// обезличивание желудём не приезжает: внедрений у него нет, его создают «Новым»
	Обезличивание = Новый ОбезличиваниеЖурнала();
КонецПроцедуры
