// Чтение происшествий для экранов и API: снимки записей подсистемы по объекту, последние сверху,
// с признаком «пройдёт ли причина сама следующим заходом».

Перем Происшествия;  // ХранилищеПроисшествий (данные)
Перем Коды;          // КодыПроисшествий (происшествия)

#Область ПубличныйИнтерфейс

// Происшествия подсистемы по объекту, последние сверху. Подсистема обязательна: в одном
// объекте — «источник/<адрес>» — пишут и проба пула, и обход зеркала, и экран зеркала
// не должен показывать чужие строки. Общего экрана «что у хаба не получилось» в первой
// волне нет, поэтому выдачи «все подсистемы сразу» здесь тоже нет.
//
// Параметры:
//  Подсистема - Строка - «хранилище» | «зеркало» | «источник».
//  Объект - Строка - адрес объекта из ОбъектыПроисшествий.
//  Прогон - Строка - метка обхода; пусто — все обходы (необязательный).
//  Ограничение - Число - сколько снимков вернуть; 0 — все (необязательный).
//
// Возвращаемое значение:
//  Массив из Структура - Подсистема, Объект, Предмет, Код, Причина, Количество,
//                        Впервые, Последний, Прогон, Устранимо, ИсходНеясен.
//
&Наблюдаемый
Функция ПроисшествияОбъекта(&АтрибутСпана("oshub.incident.subsystem") Знач Подсистема,
	&АтрибутСпана("oshub.incident.object") Знач Объект, Знач Прогон = "",
	Знач Ограничение = 0) Экспорт

	Результат = Новый Массив();
	Для Каждого Запись Из Срез(Подсистема, Объект, Прогон) Цикл
		Если Ограничение > 0 И Результат.Количество() >= Ограничение Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Снимок(Запись));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Происшествия подсистемы сразу по нескольким объектам — одним обращением к таблице. Экран,
// показывающий список объектов (источники пула), иначе платил бы за каждую строку
// отдельным запросом.
//
// Параметры:
//  Подсистема - Строка - «хранилище» | «зеркало» | «источник».
//  Объекты - Массив из Строка - адреса объектов из ОбъектыПроисшествий.
//
// Возвращаемое значение:
//  Соответствие - адрес объекта → Массив из Структура (как у ПроисшествияОбъекта), последние
//                 сверху; объект без происшествий ключа не получает.
//
&Наблюдаемый
Функция ПроисшествияОбъектов(&АтрибутСпана("oshub.incident.subsystem") Знач Подсистема,
	Знач Объекты) Экспорт

	Результат = Новый Соответствие();

	Для Каждого Запись Из Происшествия.ПоОбъектам(Подсистема, Объекты) Цикл
		Объект = Текстом(Запись.Объект);
		Снимки = Результат.Получить(Объект);
		Если Снимки = Неопределено Тогда
			Снимки = Новый Массив();
			Результат.Вставить(Объект, Снимки);
		КонецЕсли;
		Снимки.Добавить(Снимок(Запись));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Есть ли у подсистемы происшествия по объекту — вопрос значка на экране.
//
// Параметры:
//  Подсистема - Строка - подсистема.
//  Объект - Строка - адрес объекта.
//  Прогон - Строка - метка обхода; пусто — все обходы (необязательный).
//
// Возвращаемое значение:
//  Булево.
//
&Наблюдаемый
Функция ЕстьПроисшествия(&АтрибутСпана("oshub.incident.subsystem") Знач Подсистема,
	&АтрибутСпана("oshub.incident.object") Знач Объект, Знач Прогон = "") Экспорт
	Возврат Происшествия.Есть(Подсистема, Объект, Прогон);
КонецФункции

// Сколько происшествий держит подсистема по объекту: экрану зеркала нужно «сколько в текущем
// прогоне», и это число он берёт здесь, не вычитывая весь список.
//
// Параметры:
//  Подсистема - Строка - подсистема.
//  Объект - Строка - адрес объекта.
//  Прогон - Строка - метка обхода; пусто — все обходы (необязательный).
//
// Возвращаемое значение:
//  Число.
//
&Наблюдаемый
Функция ЧислоПроисшествий(&АтрибутСпана("oshub.incident.subsystem") Знач Подсистема,
	&АтрибутСпана("oshub.incident.object") Знач Объект, Знач Прогон = "") Экспорт
	Возврат Происшествия.Количество(Подсистема, Объект, Прогон);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Срез(Знач Подсистема, Знач Объект, Знач Прогон)

	Возврат ?(ЗначениеЗаполнено(Прогон),
		Происшествия.ПоОбъектуИПрогону(Подсистема, Объект, Прогон),
		Происшествия.ПоОбъекту(Подсистема, Объект));

КонецФункции

Функция Текстом(Знач Значение)
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
КонецФункции

Функция Снимок(Знач Запись)

	Результат = Новый Структура();
	Результат.Вставить("Подсистема", Строка(Запись.Подсистема));
	Результат.Вставить("Объект", Строка(Запись.Объект));
	Результат.Вставить("Предмет", Строка(Запись.Предмет));
	Результат.Вставить("Код", Строка(Запись.Код));
	Результат.Вставить("Причина", Строка(Запись.Причина));
	Результат.Вставить("Количество", Цел(Запись.Количество));
	Результат.Вставить("Впервые", Запись.Впервые);
	Результат.Вставить("Последний", Запись.Последний);
	Результат.Вставить("Прогон", Строка(Запись.Прогон));
	Результат.Вставить("Устранимо", Коды.Устранимо(Запись.Код));
	// «нет» и «не знаем» — разные ответы: незнакомый код и сводка разных причин
	// не вправе выдаваться за «пропущено насовсем»
	Результат.Вставить("ИсходНеясен", Коды.ИсходНеясен(Запись.Код));
	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ХранилищеПроисшествий") _Происшествия,
	&Пластилин(Значение = "КодыПроисшествий") _Коды)

	Происшествия = _Происшествия;
	Коды = _Коды;

КонецПроцедуры
