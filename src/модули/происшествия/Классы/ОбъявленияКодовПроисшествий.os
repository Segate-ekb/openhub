// Объявления кодов происшествий одной подсистемы: ими подсистема отвечает на контракт
// КодыПроисшествийПодсистемы, а КодыПроисшествий собирает объявления всех подсистем.

Перем ИмяПодсистемы;  // Строка — часть ключа каждого происшествия подсистемы
Перем Записи;         // Массив из Структура в порядке объявления
Перем Индекс;         // Соответствие: код -> Структура

#Область ПубличныйИнтерфейс

// Объявляет код причины.
//
// Параметры:
//  Код - Строка - машинный код причины.
//  ПройдётСамо - Булево - снимет ли причину следующий заход без вмешательства человека.
//
Процедура Объявить(Знач Код, Знач ПройдётСамо) Экспорт
	Добавить(Код, ПройдётСамо, Ложь);
КонецПроцедуры

// Объявляет код, про который нельзя сказать ни «повторится», ни «пропущено насовсем»:
// сбой, не разложенный по известным причинам.
//
// Параметры:
//  Код - Строка - машинный код причины.
//
Процедура ОбъявитьНеясным(Знач Код) Экспорт
	Добавить(Код, Ложь, Истина);
КонецПроцедуры

// Код, о котором объявления знают. Забытое объявление иначе дало бы код вне общего словаря
// и молчаливое «пропущено насовсем» вместо «повторится».
//
// Параметры:
//  Код - Строка - машинный код причины.
//
// Возвращаемое значение:
//  Строка - тот же код.
//
Функция Объявленный(Знач Код) Экспорт

	Если Индекс.Получить(Код) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"Коды происшествий: код ""%1"" не объявлен — впишите его в конструктор рядом с остальными", Код);
	КонецЕсли;
	Возврат Код;

КонецФункции

// Имя подсистемы.
//
// Возвращаемое значение:
//  Строка - «зеркало», «хранилище», …
//
Функция Подсистема() Экспорт
	Возврат ИмяПодсистемы;
КонецФункции

// Коды в порядке объявления.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Код - Строка - машинный код причины.
//   * ПройдётСамо - Булево - снимет ли причину следующий заход.
//   * ИсходНеясен - Булево - неизвестно, пройдёт ли причина сама.
//
Функция Коды() Экспорт
	Возврат Записи;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Добавить(Знач Код, Знач ПройдётСамо, Знач ИсходНеясен)

	Если Индекс.Получить(Код) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон("Коды происшествий: код ""%1"" объявлен дважды", Код);
	КонецЕсли;

	Запись = Новый Структура("Код, ПройдётСамо, ИсходНеясен", Код, ПройдётСамо, ИсходНеясен);
	Записи.Добавить(Запись);
	Индекс.Вставить(Код, Запись);

КонецПроцедуры

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач Подсистема)
	ИмяПодсистемы = Подсистема;
	Записи = Новый Массив();
	Индекс = Новый Соответствие();
КонецПроцедуры
