// Задача планировщика «чистка-происшествий»: удаление происшествий, которых дольше срока
// никто не касался.

Перем Летопись;  // ЛетописьПроисшествий
Перем Интервал;  // интервал чистки из настройки, секунды

// Регистрация в планировщике: чистка раз в интервал из настройки.
//
// Параметры:
//  Регистрации - РегистрацииЗадачи - куда записывается регистрация.
//
Процедура Зарегистрировать(Регистрации) Экспорт
	Регистрации.КаждыеСекунд("чистка-происшествий", Интервал);
КонецПроцедуры

// Убирает устаревшие происшествия за один проход.
// Сбой перебрасывается планировщику.
//
&Наблюдаемый("job.incidents_gc")
Процедура Исполнить() Экспорт
	Летопись.УбратьУстаревшие();
КонецПроцедуры

&Прозвище("ЗадачаПланировщика")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЛетописьПроисшествий") _Летопись,
	&Деталька(Значение = "oshub.jobs.incidents_gc_interval_sec", ЗначениеПоУмолчанию = 3600) _Интервал = Неопределено)

	Летопись = _Летопись;
	Интервал = Новый ПриведениеЧисел().ЧислоИлиДефолт(_Интервал, 3600);

КонецПроцедуры
