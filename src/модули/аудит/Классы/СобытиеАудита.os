// Нагрузка события журнала аудита: одна форма полей и одна сериализация деталей
// на весь хаб. Производитель события называет содержание, форму держит этот класс.

Перем ИменаЖурнала; // ИмяОбъектаАудита (аудит) — принципал «система» на безымянном действии
Перем JSON;         // ТекстJSON (основа)

#Область ПубличныйИнтерфейс

// Собирает нагрузку события для службы аудита.
//
// Параметры:
//  Кто - Строка - логин принципала; пустой означает, что действовал сам хаб.
//  Действие - Строка - код действия журнала.
//  Объект - Строка - адрес объекта записи, собранный ИмяОбъектаАудита.
//  Субъект - Строка - адрес субъекта записи; пустой — у действия субъекта нет.
//  Детали - Структура - подробности действия; секретов в них не бывает.
//  АдресIP - Строка - адрес клиента (необязательный, по умолчанию "" — клиента нет).
//
// Возвращаемое значение:
//  Структура - Кто, Действие, Объект, Субъект, ДеталиJSON, АдресIP.
//
Функция Собрать(Знач Кто, Знач Действие, Знач Объект, Знач Субъект, Знач Детали,
	Знач АдресIP = "") Экспорт

	Данные = Новый Структура();
	Данные.Вставить("Кто", Принципал(Кто));
	Данные.Вставить("Действие", Строка(Действие));
	Данные.Вставить("Объект", Строка(Объект));
	Данные.Вставить("Субъект", Строка(Субъект));
	Данные.Вставить("ДеталиJSON", ДеталиТекстом(Детали));
	Данные.Вставить("АдресIP", Строка(АдресIP));

	Возврат Данные;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Безымянное действие принадлежит хабу: запись с пустым принципалом читается как потерянная.
Функция Принципал(Знач Кто)
	Возврат ?(ЗначениеЗаполнено(Кто), Строка(Кто), ИменаЖурнала.Система());
КонецФункции

// Деталей может не быть вовсе: пустой объект в журнале читается, «Неопределено» — нет.
Функция ДеталиТекстом(Знач Детали)
	Возврат JSON.СПереносами(?(Детали = Неопределено, Новый Структура(), Детали));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ИмяОбъектаАудита") _Имена,
	&Пластилин(Значение = "ТекстJSON") _JSON)

	ИменаЖурнала = _Имена;
	JSON = _JSON;

КонецПроцедуры
