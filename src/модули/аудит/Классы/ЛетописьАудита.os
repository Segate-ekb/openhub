// Файловый след журнала аудита: одно событие — одна строка отдельного лога «аудит».
// Файловый вывод вешается кодом и своим уровнем, поэтому не зависит от настроек logos.

Перем ЛогАудита;
Перем Лог;
Перем Формат;
Перем Аппендер;
Перем ЖалобаОтправлена;

#Область ПубличныйИнтерфейс

// Пишет одно событие аудита в файловый журнал.
//
// Параметры:
//  Когда - Дата - момент операции (UTC).
//  Кто - Строка - логин пользователя, префикс токена или "anonymous".
//  Действие - Строка - тип операции (например, "версия.опубликована").
//  Объект - Строка - затронутый объект (например, "пул/пакет@версия").
//  Субъект - Строка - субъект операции, может быть пустым.
//  Детали - Строка - произвольные детали операции в JSON, могут быть пустыми.
//  АдресIP - Строка - адрес источника, может быть пустым.
//
Процедура Записать(Знач Когда, Знач Кто, Знач Действие, Знач Объект,
	Знач Субъект, Знач Детали, Знач АдресIP) Экспорт

	Запись = Формат.НоваяЗапись();
	Запись.Когда = Когда;
	Запись.Кто = Кто;
	Запись.Действие = Действие;
	Запись.Объект = Объект;
	Запись.Субъект = Субъект;
	Запись.Детали = Детали;
	Запись.АдресIP = АдресIP;

	Строчка = Формат.Строкой(Запись);

	// в обычный журнал идёт только факт записи: сама строка аудита уходит своим выводом,
	// и дублировать её сюда значило бы развести две копии одного события
	Если Лог <> Неопределено Тогда
		Лог.Отладка("Летопись аудита: пишем ""%1"" по объекту ""%2""", Действие, Объект);
	КонецЕсли;

	Попытка
		ЛогАудита.Информация(Строчка);
	Исключение
		Пожаловаться(Строчка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Самый низкий уровень logos: иначе поднятый уровень лога отсекает событие аудита до вывода.
Функция УровеньБезОтсечения()
	Возврат 0;
КонецФункции

// Жалоба повторяется, пока сбой не устранён, но не чаще раза в минуту.
Процедура Пожаловаться(Знач Строчка, Знач Описание)

	Если Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если ЖалобаОтправлена <> Неопределено И Сейчас - ЖалобаОтправлена < 60000 Тогда
		Возврат;
	КонецЕсли;
	ЖалобаОтправлена = Сейчас;

	Лог.Ошибка("Событие аудита ПОТЕРЯНО — файл %1 недоступен (%2). Несохранённая запись: %3",
		?(Аппендер = Неопределено, "", Аппендер.Путь()), Описание, Строчка);

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ФорматЖурналаАудита") _Формат,
	&Пластилин(Значение = "АппендерЖурналаАудита") _Аппендер,
	&Лог(Значение = "аудит", УчитыватьИмяКласса = Ложь) _ЛогАудита = Неопределено,
	&Лог _Лог = Неопределено)

	Формат = _Формат;
	Аппендер = _Аппендер;
	ЛогАудита = _ЛогАудита;
	Лог = _Лог;
	ЖалобаОтправлена = Неопределено;

	Если ЛогАудита <> Неопределено И Аппендер <> Неопределено Тогда
		ЛогАудита.ДобавитьСпособВывода(Аппендер, УровеньБезОтсечения());
	КонецЕсли;

	Если Аппендер <> Неопределено И НЕ Аппендер.Открыт() Тогда
		Пожаловаться("", Аппендер.Сбой());
	КонецЕсли;

КонецПроцедуры
