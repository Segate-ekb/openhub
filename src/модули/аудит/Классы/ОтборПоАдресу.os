// Условие отбора журнала по адресу: точный адрес либо сеть в записи CIDR. Сравнивается
// значение, а не строка, — журнал не мигрируется, и запись, сделанная прежней версией
// хаба адресом как пришёл, обязана находиться наравне с канонической.

Перем Канон;  // КанонIP (основа)

#Область ПубличныйИнтерфейс

// Условие из сырого значения адреса.
//
// Параметры:
//  Значение - Строка - адрес либо сеть в записи CIDR; пустая строка не отбирает.
//
// Возвращаемое значение:
//  Структура - Задано (Булево — условие отбирает), Понято (Булево — значение прочитано),
//              Адрес (IPАдрес либо Неопределено), Сеть (IPПрефикс либо Неопределено).
//
Функция Условие(Знач Значение) Экспорт

	Текст = СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
	Итог = Новый Структура("Задано, Понято, Адрес, Сеть",
		ЗначениеЗаполнено(Текст), Ложь, Неопределено, Неопределено);

	Если НЕ Итог.Задано Тогда
		Возврат Итог;
	КонецЕсли;

	Если Найти(Текст, "/") > 0 Тогда
		Итог.Сеть = Канон.Сеть(Текст);
		Итог.Понято = Итог.Сеть <> Неопределено;
		Возврат Итог;
	КонецЕсли;

	Итог.Адрес = Канон.Адрес(Текст);
	Итог.Понято = Итог.Адрес <> Неопределено;

	Возврат Итог;

КонецФункции

// Подходит ли адрес записи журнала под условие.
//
// Параметры:
//  ПроверяемоеУсловие - Структура - результат Условие.
//  АдресЗаписи - Строка - адрес из записи журнала в любой его записи.
//
// Возвращаемое значение:
//  Булево - непрочитанное условие отбором НЕ становится и пропускает всё: пустой журнал
//           вместо «я не понял адрес» читался бы как «таких операций не было».
//
Функция Подходит(Знач ПроверяемоеУсловие, Знач АдресЗаписи) Экспорт

	Если ТипЗнч(ПроверяемоеУсловие) <> Тип("Структура") ИЛИ НЕ ПроверяемоеУсловие.Задано Тогда
		Возврат Истина;
	КонецЕсли;
	Если НЕ ПроверяемоеУсловие.Понято Тогда
		Возврат Истина;
	КонецЕсли;

	Если ПроверяемоеУсловие.Сеть <> Неопределено Тогда
		Возврат Канон.ВСети(ПроверяемоеУсловие.Сеть, АдресЗаписи);
	КонецЕсли;

	Адрес = Канон.Адрес(АдресЗаписи);
	Возврат Адрес <> Неопределено И Адрес.РавноБезУчетаЗоны(ПроверяемоеУсловие.Адрес);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "КанонIP") _Канон) Экспорт
	Канон = _Канон;
КонецПроцедуры
