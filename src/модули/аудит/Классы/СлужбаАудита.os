// Подписчик доменных событий-мутаций: пишет строку в файловый журнал аудита
// и отдаёт экрану страницы этого журнала через источник чтения.
// Полезная нагрузка события — готовые поля Кто/Действие/Объект/Субъект/ДеталиJSON/АдресIP,
// их заполняет производитель, поэтому новое событие попадает в журнал без правок здесь.

Перем Готовность;       // ГотовностьХаба (наблюдаемость)
Перем Издатель;         // ИздательСобытий (события)
Перем Летопись;         // ЛетописьАудита (аудит) — запись события в файл
Перем Источник;         // ИсточникЖурналаАудита (аудит) — чтение журнала из файла
Перем ИменаЖурнала;     // ИмяОбъектаАудита (аудит) — сверка формы адреса на записи
&Лог
Перем Лог;

#Область КонтрактПодписчикаСобытий

// Пишет строку журнала аудита по доменному событию. Отсутствующие поля нагрузки
// заменяются безопасными значениями по умолчанию.
//
// Параметры:
//  Событие - Структура - Тип, Когда, Данные (Кто, Действие, Объект, Субъект,
//            ДеталиJSON, АдресIP).
//
Процедура ОбработатьСобытие(Знач Событие) Экспорт

	Данные = Событие.Данные;
	Объект = Поле(Данные, "Объект", "");
	Субъект = Поле(Данные, "Субъект", "");

	СверитьФорму(Событие.Тип, "объект", Объект);
	СверитьФорму(Событие.Тип, "субъект", Субъект);

	// лог по возможности: службу создают и напрямую, инъекция туда не доезжает
	Если Лог <> Неопределено Тогда
		Лог.Отладка("Журнал аудита: пишем событие ""%1"", объект ""%2"", субъект ""%3""",
			Событие.Тип, Объект, Субъект);
	КонецЕсли;

	Летопись.Записать(
		Событие.Когда,
		Поле(Данные, "Кто", "anonymous"),
		Поле(Данные, "Действие", Событие.Тип),
		Объект,
		Субъект,
		Поле(Данные, "ДеталиJSON", ""),
		Поле(Данные, "АдресIP", ""));

КонецПроцедуры

// Рантайм-инвариант единого формата: адрес, собранный мимо ИмяОбъектаАудита, формы
// не держит. Запись не отменяется — журнал безопасности молчать не имеет права, —
// но расхождение обязано быть громким, иначе следующий производитель заведёт свой вид.
Процедура СверитьФорму(Знач ТипСобытия, Знач Роль, Знач Значение)

	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ ИменаЖурнала.ЭтоАдресЖурнала(Значение) Тогда
		Возврат;
	КонецЕсли;

	// лог по возможности: службу создают и напрямую, а инъекция &Лог до созданного
	// `Новый` объекта не доезжает — упасть здесь значило бы потерять всю запись, и
	// ровно на нештатном значении, ради которого сверка и заведена
	Если Лог <> Неопределено Тогда
		Лог.Предупреждение(
			"Журнал аудита: %1 события ""%2"" собран мимо ИмяОбъектаАудита и формы не держит: ""%3"".",
			Роль, ТипСобытия, Строка(Значение));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПубличныйИнтерфейс

// Страница журнала по отбору, новые первыми. Читается ХВОСТ файла журнала: за его
// пределами данных нет, поэтому отбор действует в границах прочитанного, а число
// страниц неизвестно — источник отвечает лишь признаком следующей.
//
// Параметры:
//  Отбор - Структура - Действие, Кто, Начало, Конец; незаполненное поле не отбирает.
//  Страница - Число - номер страницы с единицы (необязательный, по умолчанию 1).
//  РазмерСтраницы - Число - записей на странице (необязательный, по умолчанию 20).
//
// Возвращаемое значение:
//  Структура - Записи (Массив), Страница (Число), ЕстьСледующая (Булево),
//              ИсточникДоступен (Булево), ХвостУсечён (Булево — журнал прочитан
//              не целиком, за пределами прочитанного записи могли остаться).
//
Функция ЗаписиСтраницей(Знач Отбор, Знач Страница = 1, Знач РазмерСтраницы = 20) Экспорт

	Номер = Целое(Страница, 1);
	Размер = Целое(РазмерСтраницы, 20);

	Выдача = Источник.Страница(ОтборИсточника(Отбор), (Номер - 1) * Размер, Размер);

	Возврат Новый Структура("Записи, Страница, ЕстьСледующая, ИсточникДоступен, ХвостУсечён",
		Выдача.Записи, Номер, Выдача.ЕстьСледующая = Истина, Выдача.Доступен = Истина,
		Выдача.ХвостУсечён = Истина);

КонецФункции

// Подписывает службу на мутирующие события и закрывает свой гейт готовности.
// Подписка в рогатке, а не в конструкторе: ОСень инстанцирует желуди лениво, и чистого
// подписчика, от которого никто не зависит, иначе бы не создали.
//
Процедура ПриЗапускеПриложения() Экспорт
	Издатель.Подписать(Издатель.ТипВерсияОпубликована(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипВерсияОтозвана(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипВерсияВосстановлена(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипЗеркалоСинхронизировано(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипВерсияЗеркалирована(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипКоллизияИмениАпстрима(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипТегПеремещён(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипРежимТегаИзменён(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипТегУдалён(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипПраваИзменены(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипДовериеИзменено(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипРольХабаИзменена(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипПриглашениеУчётки(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипПодтверждениеАдреса(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипОсновнойПулНазначен(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипНастройкаИзменена(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипЛичныеПространстваИзменены(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипПровайдерВходаИзменён(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипВходЗаблокирован(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипВходРазблокирован(), ЭтотОбъект);
	Издатель.Подписать(Издатель.ТипПробаПодписки(), ЭтотОбъект);
	// Гейт закрывается последней строкой и без Попытка: упавшая подписка оставляет /ready 503.
	Готовность.ОтметитьЗадачуВыполненной("audit.служба");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Границы периода источник журнала называет «С» и «По» — это его контракт, а не наш.
Функция ОтборИсточника(Знач Отбор)

	Результат = Новый Структура("Действие, Кто, С, По");
	Результат.Вставить("Действие", Поле(Отбор, "Действие", ""));
	Результат.Вставить("Кто", Поле(Отбор, "Кто", ""));
	Результат.Вставить("С", Поле(Отбор, "Начало", Неопределено));
	Результат.Вставить("По", Поле(Отбор, "Конец", Неопределено));
	Возврат Результат;

КонецФункции

Функция Целое(Знач Значение, Знач ПоУмолчанию)
	Попытка
		Возврат Макс(1, Цел(Число(?(ЗначениеЗаполнено(Значение), Значение, ПоУмолчанию))));
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
КонецФункции

Функция Поле(Знач Данные, Знач Имя, Знач ПоУмолчанию)
	Значение = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

#КонецОбласти

&Рогатка
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ИздательСобытий") _Издатель,
	&Пластилин(Значение = "ГотовностьХаба") _Готовность,
	&Пластилин(Значение = "ЛетописьАудита") _Летопись,
	&Пластилин(Значение = "ИсточникЖурналаАудита") _Источник,
	&Пластилин(Значение = "ИмяОбъектаАудита") _ИменаЖурнала,
	&Лог _Лог = Неопределено)

	Издатель = _Издатель;
	Готовность = _Готовность;
	Летопись = _Летопись;
	Источник = _Источник;
	ИменаЖурнала = _ИменаЖурнала;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	// Заявка в конструкторе: список гейтов должен быть полон до первого запуска рогаток.
	Готовность.ЗаявитьЗадачу("audit.служба");

КонецПроцедуры
