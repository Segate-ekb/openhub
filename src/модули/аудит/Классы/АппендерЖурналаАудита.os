// Способ вывода logos для журнала аудита: пишет сообщение события в файл как есть.
// Включается кодом (ЛетописьАудита), а не настройками logos, поэтому есть всегда.

Перем ПутьФайла;
Перем Файл_;
Перем ОписаниеСбоя;
Перем Блокировка;

#Область КонтрактСпособаВыводаLogos

// Пишет сообщение события в файл одной строкой. Раскладка намеренно не применяется:
// строку журнала целиком формирует ФорматЖурналаАудита.
//
// Параметры:
//  СобытиеЛога - СобытиеЛога - событие logos.
//
Процедура ВывестиСобытие(Знач СобытиеЛога) Экспорт

	Если Файл_ = Неопределено Тогда
		Открыть(); // оператор мог починить права — журнал возобновляется сам, без рестарта
	КонецЕсли;

	Если Файл_ = Неопределено Тогда
		ВызватьИсключение "Файл журнала аудита не открыт: " + ОписаниеСбоя;
	КонецЕсли;

	Строчка = Строка(СобытиеЛога.ПолучитьСообщение());

	Блокировка.Заблокировать();
	Попытка
		Файл_.ЗаписатьСтроку(Строчка);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Блокировка.Разблокировать();

КонецПроцедуры

// Контракт способа вывода logos: закрытие ресурса.
//
Процедура Закрыть() Экспорт

	Блокировка.Заблокировать();
	Если Файл_ <> Неопределено Тогда
		Попытка
			Файл_.Закрыть();
		Исключение
			ОписаниеСбоя = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Файл_ = Неопределено;
	КонецЕсли;
	Блокировка.Разблокировать();

КонецПроцедуры

// Контракт способа вывода logos: установка свойства из конфигурации.
// Аппендер настраивается кодом, поэтому свойства из logos.appender игнорируются.
//
// Параметры:
//  ИмяСвойства - Строка - имя свойства.
//  Значение - Произвольный - значение свойства.
//
Процедура УстановитьСвойство(Знач ИмяСвойства, Знач Значение) Экспорт // BSLLS:UnusedParameters-off
КонецПроцедуры

#КонецОбласти

#Область ПубличныйИнтерфейс

// Полное имя файла журнала аудита — его же читает ЧитательЖурналаАудита.
//
// Возвращаемое значение:
//  Строка.
//
Функция Путь() Экспорт
	Возврат ПутьФайла;
КонецФункции

// Открыт ли файл журнала.
//
// Возвращаемое значение:
//  Булево.
//
Функция Открыт() Экспорт
	Возврат Файл_ <> Неопределено;
КонецФункции

// Описание причины, по которой файл журнала не открылся; пустая строка — сбоя не было.
//
// Возвращаемое значение:
//  Строка.
//
Функция Сбой() Экспорт
	Возврат ОписаниеСбоя;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ни отсутствие каталога, ни отказ файловой системы не имеют права уронить сборку
// контейнера: без журнала в файле хаб работает, без старта — нет.
Процедура Открыть()

	Попытка
		ОбеспечитьКаталог();
		Файл_ = Новый ЗаписьТекста(ПутьФайла, "utf-8", , Истина);
		ОписаниеСбоя = "";
	Исключение
		Файл_ = Неопределено;
		ОписаниеСбоя = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Процедура ОбеспечитьКаталог()

	Каталог = Новый Файл(ПутьФайла).Путь;
	Если ЗначениеЗаполнено(Каталог) И НЕ Новый Файл(Каталог).Существует() Тогда
		СоздатьКаталог(Каталог);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Деталька(Значение = "oshub.storage.root", ЗначениеПоУмолчанию = "./data") _КореньХранилища)

	Корень = ?(ЗначениеЗаполнено(_КореньХранилища), Строка(_КореньХранилища), "./data");
	ПутьФайла = Новый Файл(ОбъединитьПути(Корень, "аудит.log")).ПолноеИмя;
	ОписаниеСбоя = "";
	Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);

	Открыть();

КонецПроцедуры
