// Единственное место, где решается, как выглядят адрес объекта, субъект и принципал записи
// журнала. Утраченная сущность — "тип#идентификатор"; ЭтоАдресЖурнала проверяет форму обратно.

Перем ИменаПоТипам;  // Соответствие: тип объекта → ИменаОбъектовАудита предмета, который его называет
Перем КанонАдреса;   // КанонIP (основа) — одна форма записи адреса

#Область ПубличныйИнтерфейс

// Объект «весь хаб».
//
// Возвращаемое значение:
//  Строка.
//
Функция Хаб() Экспорт
	Возврат "хаб";
КонецФункции

// Принципал «действие выполнил сам хаб».
//
// Возвращаемое значение:
//  Строка.
//
Функция Система() Экспорт
	Возврат "система";
КонецФункции

// Пул по идентификатору.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Строка - "пул/<имя>"; для несуществующего пула "пул#<идентификатор>".
//
Функция Пул(Знач ПулИдентификатор) Экспорт

	Имена = ИменаОбъекта("пул", ПулИдентификатор);
	Если Имена = Неопределено Тогда
		Возврат Неизвестный("пул", ПулИдентификатор);
	КонецЕсли;
	Возврат ПулПоИмени(Имена.Имя);

КонецФункции

// Пул, чьё имя уже в руках у вызывающего. Слово «пул» в адресе не украшение: личный
// пул учётки называется её логином, и без него запись о пуле неотличима от записи
// об учётной записи.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Строка - "пул/<имя>".
//
Функция ПулПоИмени(Знач ИмяПула) Экспорт
	Возврат Адресуемый("пул", ИмяПула);
КонецФункции

// Пакет по идентификатору.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Строка - "пул/пакет"; для несуществующего пакета "пакет#<идентификатор>".
//
Функция Пакет(Знач ПакетИдентификатор) Экспорт

	Имена = ИменаОбъекта("пакет", ПакетИдентификатор);
	Если Имена = Неопределено Тогда
		Возврат Неизвестный("пакет", ПакетИдентификатор);
	КонецЕсли;
	Возврат ПакетПоИменам(Имена.Пул, Имена.Имя);

КонецФункции

// Пакет, чьи имена уже в руках у вызывающего.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Строка - "пул/пакет".
//
Функция ПакетПоИменам(Знач ИмяПула, Знач ИмяПакета) Экспорт
	Возврат СтрШаблон("%1/%2", Сегмент(ИмяПула), Сегмент(ИмяПакета));
КонецФункции

// Версия пакета.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//  СтрокаВерсии - Строка - версия.
//
// Возвращаемое значение:
//  Строка - "пул/пакет@версия".
//
Функция ВерсияПоИменам(Знач ИмяПула, Знач ИмяПакета, Знач СтрокаВерсии) Экспорт
	Возврат Версия(ПакетПоИменам(ИмяПула, ИмяПакета), СтрокаВерсии);
КонецФункции

// Версия поверх готового адреса пакета — форма для тех, у кого адрес уже собран
// (в том числе фолбэком "пакет#<идентификатор>").
//
// Параметры:
//  АдресПакета - Строка - адрес пакета в журнале.
//  СтрокаВерсии - Строка - версия.
//
// Возвращаемое значение:
//  Строка - "<адрес>@<версия>".
//
Функция Версия(Знач АдресПакета, Знач СтрокаВерсии) Экспорт
	Возврат СтрШаблон("%1@%2", СегментАдреса(АдресПакета), Сегмент(СтрокаВерсии));
КонецФункции

// Тег поверх готового адреса пакета. Разделитель у тега СВОЙ: алфавит тегов допускает
// «1.0.0», и с общим «@» тег и версия дали бы один и тот же адрес.
//
// Параметры:
//  АдресПакета - Строка - адрес пакета в журнале.
//  ИмяТега - Строка - имя тега.
//
// Возвращаемое значение:
//  Строка - "<адрес>:<тег>".
//
Функция Тег(Знач АдресПакета, Знач ИмяТега) Экспорт
	Возврат СтрШаблон("%1:%2", СегментАдреса(АдресПакета), Сегмент(ИмяТега));
КонецФункции

// Учётная запись.
//
// Параметры:
//  Логин - Строка - логин пользователя.
//
// Возвращаемое значение:
//  Строка - "пользователь/<логин>".
//
Функция Пользователь(Знач Логин) Экспорт
	Возврат Адресуемый("пользователь", Логин);
КонецФункции

// Группа. Имена групп не проверяются алфавитом, поэтому без префикса группа "alice"
// неотличима от учётки alice.
//
// Параметры:
//  ИмяГруппы - Строка - имя группы.
//
// Возвращаемое значение:
//  Строка - "группа/<имя>".
//
Функция Группа(Знач ИмяГруппы) Экспорт
	Возврат Адресуемый("группа", ИмяГруппы);
КонецФункции

// Прикладная настройка хаба.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - "настройка/<ключ>".
//
Функция Настройка(Знач Ключ) Экспорт
	Возврат Адресуемый("настройка", Ключ);
КонецФункции

// Провайдер социального логина.
//
// Параметры:
//  Имя - Строка - имя провайдера.
//
// Возвращаемое значение:
//  Строка - "провайдер/<имя>".
//
Функция Провайдер(Знач Имя) Экспорт
	Возврат Адресуемый("провайдер", Имя);
КонецФункции

// Адрес клиента — объект записей, относящихся к источнику запросов, а не к учётке.
//
// Параметры:
//  АдресКлиента - Строка - IP-адрес.
//
// Возвращаемое значение:
//  Строка - "адрес/<ip>".
//
Функция Адрес(Знач АдресКлиента) Экспорт
	Возврат "адрес/" + СегментИсточника(АдресКлиента);
КонецФункции

// Плановое зеркало хаб↔хаб. Имени у зеркала нет — его называет собственный номер,
// как он и показан на экране пула.
//
// Параметры:
//  ЗеркалоИдентификатор - Число - идентификатор зеркала.
//
// Возвращаемое значение:
//  Строка - "зеркало/<идентификатор>".
//
Функция Зеркало(Знач ЗеркалоИдентификатор) Экспорт
	Возврат Адресуемый("зеркало", Формат(Цел(ЗеркалоИдентификатор), "ЧН=0; ЧГ=0"));
КонецФункции

// Хранилище артефактов на S3, названное корзиной. Эндпоинт сюда не попадает никогда:
// рядом с ним живут ключи доступа, и функция их просто не принимает.
//
// Параметры:
//  Бакет - Строка - имя корзины.
//
// Возвращаемое значение:
//  Строка - "хранилище/s3://<корзина>".
//
Функция ХранилищеS3(Знач Бакет) Экспорт
	Возврат "хранилище/s3://" + Координата(Бакет);
КонецФункции

// Файловое хранилище артефактов, названное своим корнем.
//
// Параметры:
//  Корень - Строка - корень артефактов.
//
// Возвращаемое значение:
//  Строка - "хранилище/<корень>".
//
Функция ХранилищеФайлами(Знач Корень) Экспорт
	Возврат "хранилище/" + Координата(Корень);
КонецФункции

// Встроенная база стран, названная своим файлом. Путь целиком в адрес не попадает: он
// различает не объекты, а инсталляции, и объект у базы один.
//
// Параметры:
//  ИмяФайла - Строка - имя файла базы без каталога.
//
// Возвращаемое значение:
//  Строка - "база-стран/<имя файла>".
//
Функция БазаСтран(Знач ИмяФайла) Экспорт
	Возврат Адресуемый("база-стран", ИмяФайла);
КонецФункции

// Источник пакетов — чужой хаб, откуда хаб читает. Адрес приходит УЖЕ обезличенным:
// снимать строку запроса и учётные данные умеет ОбезличиваниеЖурнала, и второй копии
// этого правила здесь нет. Зовут отсюда через ОбъектыПроисшествий, где обе половины сложены.
//
// Параметры:
//  АдресИсточника - Строка - обезличенный адрес апстрима.
//
// Возвращаемое значение:
//  Строка - "источник/<адрес>".
//
Функция Источник(Знач АдресИсточника) Экспорт
	Возврат "источник/" + Координата(АдресИсточника);
КонецФункции

// Объект по описанию «тип + идентификатор» — форма, в которой объект приходит
// от прав доступа и подписок.
//
// Параметры:
//  ТипОбъекта - Строка - хаб | пул | пакет.
//  Идентификатор - Число - идентификатор объекта (для хаба игнорируется).
//
// Возвращаемое значение:
//  Строка.
//
Функция ПоТипу(Знач ТипОбъекта, Знач Идентификатор) Экспорт

	Тип = НРег(СокрЛП(Строка(ТипОбъекта)));
	Если Тип = "хаб" Тогда
		Возврат Хаб();
	ИначеЕсли Тип = "пул" Тогда
		Возврат Пул(Идентификатор);
	ИначеЕсли Тип = "пакет" Тогда
		Возврат Пакет(Идентификатор);
	КонецЕсли;
	Возврат Неизвестный(Тип, Идентификатор);

КонецФункции

// Субъект права — тот, КОМУ выдано. Отвечает на вопрос журнала «кому», который
// по одному лишь идентификатору не читается.
//
// Параметры:
//  ТипСубъекта - Строка - пользователь | группа.
//  СубъектИдентификатор - Число - идентификатор субъекта.
//
// Возвращаемое значение:
//  Строка - "пользователь/<логин>" | "группа/<имя>"; для утраченного субъекта
//           "тип#идентификатор".
//
Функция Субъект(Знач ТипСубъекта, Знач СубъектИдентификатор) Экспорт

	Тип = НРег(СокрЛП(Строка(ТипСубъекта)));
	Если Тип = "пользователь" Тогда
		Имена = ИменаОбъекта(Тип, СубъектИдентификатор);
		Возврат ?(Имена = Неопределено, Неизвестный(Тип, СубъектИдентификатор), Пользователь(Имена.Имя));
	ИначеЕсли Тип = "группа" Тогда
		Имена = ИменаОбъекта(Тип, СубъектИдентификатор);
		Возврат ?(Имена = Неопределено, Неизвестный(Тип, СубъектИдентификатор), Группа(Имена.Имя));
	КонецЕсли;
	Возврат Неизвестный(Тип, СубъектИдентификатор);

КонецФункции

// Объект, чью сущность восстановить нечем: журнал обязан записать факт всё равно.
//
// Параметры:
//  ТипОбъекта - Строка - тип объекта.
//  Идентификатор - Число - идентификатор объекта.
//
// Возвращаемое значение:
//  Строка - "тип#идентификатор".
//
Функция Неизвестный(Знач ТипОбъекта, Знач Идентификатор) Экспорт
	Возврат СтрШаблон("%1#%2", Сегмент(ТипОбъекта), Формат(Цел(Идентификатор), "ЧН=0; ЧГ=0"));
КонецФункции

// Мог ли этот класс выдать такой адрес. Обратная проверка формы — тот самый инвариант,
// который иначе стерёгся бы только текстом исходников: значение, собранное мимо класса,
// формы не держит.
//
// Параметры:
//  Значение - Строка - адрес объекта из записи журнала.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоАдресЖурнала(Знач Значение) Экспорт

	Текст = Строка(?(Значение = Неопределено, "", Значение));
	Если Текст = Хаб() Тогда
		Возврат Истина;
	КонецЕсли;

	// адрес источника — своя ветка: двоеточия внутри IPv6 не метка тега, и резать их
	// нельзя, иначе оператор не перенесёт адрес в правило файрвола
	Если СтрНачинаетсяС(Текст, "адрес/") Тогда
		Возврат ЧистыйИсточник(Сред(Текст, СтрДлина("адрес/") + 1));
	КонецЕсли;

	// координата чужой системы — тоже своя ветка: «s3://bucket» и «https://hub/download/»
	// без схемы и путей перестают называть то, к чему оператор пойдёт руками
	Для Каждого Префикс Из ПрефиксыКоординат() Цикл
		Если СтрНачинаетсяС(Текст, Префикс) Тогда
			Возврат ЧистаяКоордината(Сред(Текст, СтрДлина(Префикс) + 1));
		КонецЕсли;
	КонецЦикла;

	// метка (версия «@» либо тег «:») отделяется ПЕРВОЙ: тело под ней бывает и
	// фолбэком "тип#идентификатор", и он обязан уцелеть
	Тело = Текст;
	Разделитель = ПоследнийИз(Тело, "@:");
	Если Разделитель > 0 Тогда
		Если НЕ ЧистыйСегмент(Сред(Тело, Разделитель + 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
		Тело = Лев(Тело, Разделитель - 1);
	КонецЕсли;

	Решётка = Найти(Тело, "#");
	Если Решётка > 0 Тогда
		Возврат ЧистыйСегмент(Лев(Тело, Решётка - 1))
			И ЭтоЦелоеБезЗнака(Сред(Тело, Решётка + 1));
	КонецЕсли;

	Части = СтрРазделить(Тело, "/", Истина);
	Если Части.Количество() <> 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЧистыйСегмент(Части[0]) И ЧистыйСегмент(Части[1]);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Адресуемый(Знач Префикс, Знач Значение)
	Возврат СтрШаблон("%1/%2", Префикс, Сегмент(Значение));
КонецФункции

// Разделители внутри имени заменяются: группа «пул/main» иначе дала бы неразбираемый адрес.
Функция Сегмент(Знач Значение)
	Возврат Обезврежен(Значение, "/@:#");
КонецФункции

// «/» и «#» внутри готового адреса законны — это части адреса и фолбэка «тип#идентификатор».
Функция СегментАдреса(Знач Значение)
	Возврат Обезврежен(Значение, "@:");
КонецФункции

// Схема и путь координаты сохраняются; снимаются только «#» и управляющие символы.
Функция Координата(Знач Значение)
	Возврат Обезврежен(Значение, "#");
КонецФункции

Функция ЧистаяКоордината(Знач Текст)
	Возврат Чистый(Текст, "#");
КонецФункции

Функция ПрефиксыКоординат()

	Результат = Новый Массив();
	Результат.Добавить("хранилище/");
	Результат.Добавить("источник/");
	Возврат Результат;

КонецФункции

// Адрес в каноне с двоеточиями IPv6; неразбираемый — обезвреженным как есть.
Функция СегментИсточника(Знач Значение)
	Возврат Обезврежен(Каноничный(Значение), "/@#");
КонецФункции

// Не бросает ни при каком сбое: адрес собирает сам путь операции, до публикации события.
Функция Каноничный(Знач Значение)

	Если КанонАдреса = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;

	Попытка
		Приведённый = КанонАдреса.Строкой(Значение);
	Исключение
		Возврат Значение;
	КонецПопытки;

	Возврат ?(ЗначениеЗаполнено(Приведённый), Приведённый, Значение);

КонецФункции

Функция Обезврежен(Знач Значение, Знач Запрещённые)

	Текст = СокрЛП(Строка(Значение));
	Полный = Запрещённые + Управляющие();
	Для Индекс = 1 По СтрДлина(Полный) Цикл
		Текст = СтрЗаменить(Текст, Сред(Полный, Индекс, 1), "_");
	КонецЦикла;
	Возврат ?(ЗначениеЗаполнено(Текст), Текст, "?");

КонецФункции

Функция ЧистыйСегмент(Знач Текст)
	Возврат Чистый(Текст, "/@:#");
КонецФункции

Функция ЧистыйИсточник(Знач Текст)
	Возврат Чистый(Текст, "/@#");
КонецФункции

// Управляющие символы запрещены наравне с разделителями: это инъекция строки в колонку журнала.
Функция Чистый(Знач Текст, Знач Запрещённые)

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Полный = Запрещённые + Управляющие();
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если Найти(Полный, Сред(Текст, Индекс, 1)) > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция Управляющие()
	Возврат " " + Символы.Таб + Символы.ПС + Символы.ВК + Символы.ВТаб + Символы.ПФ + Символы.НПП;
КонецФункции

Функция ЭтоЦелоеБезЗнака(Знач Текст)

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если Найти("0123456789", Сред(Текст, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция ПоследнийИз(Знач Текст, Знач Разделители)
	Результат = 0;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если Найти(Разделители, Сред(Текст, Индекс, 1)) > 0 Тогда
			Результат = Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Некому назвать тип — не утраченная сущность, поэтому исключение, а не «тип#идентификатор».
Функция ИменаОбъекта(Знач ТипОбъекта, Знач Идентификатор)

	Называющий = ИменаПоТипам.Получить(ТипОбъекта);
	Если Называющий = Неопределено Тогда
		ВызватьИсключение СтрШаблон("ИмяОбъектаАудита: объект «%1» назвать некому — модуль, который его"
			+ " называет, не внедрён. Форматтер обязан приезжать желудём контейнера, а не создаваться"
			+ " напрямую.", ТипОбъекта);
	КонецЕсли;

	Возврат ?(Цел(Идентификатор) <= 0, Неопределено, Называющий.ИменаОбъекта(ТипОбъекта, Цел(Идентификатор)));

КонецФункции

Функция РазложенныеПоТипам(Знач Называющие)

	Результат = Новый Соответствие();
	Если Называющие = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Называющий Из Называющие Цикл
		Для Каждого ТипОбъекта Из Называющий.НазываемыеТипы() Цикл
			Если Результат.Получить(ТипОбъекта) <> Неопределено Тогда
				ВызватьИсключение СтрШаблон("ИмяОбъектаАудита: объект «%1» называют два предмета — у типа"
					+ " объекта журнала хозяин один", ТипОбъекта);
			КонецЕсли;
			Результат.Вставить(ТипОбъекта, Называющий);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ИменаОбъектовАудита", Тип = "Массив") _Называющие = Неопределено,
	&Пластилин(Значение = "КанонIP") _Канон = Неопределено)

	ИменаПоТипам = РазложенныеПоТипам(_Называющие);
	КанонАдреса = _Канон;

КонецПроцедуры
