// Чтение журнала аудита из файла. Ротации у файла нет, он растёт вечно, поэтому
// читается только хвост фиксированного размера — от конца файла к началу.

Перем Формат;
Перем Аппендер;
Перем Адреса;   // ОтборПоАдресу (аудит) — сверка адреса записи с условием
Перем Лог;

#Область ПубличныйИнтерфейс

// Страница журнала аудита, новые записи первыми.
//
// Параметры:
//  Отбор - Структура - Действие, Кто, С, По, Адрес (условие ОтборПоАдресу);
//          любое поле может быть незаполнено.
//  Смещение - Число - сколько подходящих записей пропустить.
//  Размер - Число - максимум записей на странице.
//
// Возвращаемое значение:
//  Структура - Записи (Массив структур: Когда, Кто, Действие, Объект, Субъект,
//              Детали, АдресIP), ЕстьСледующая (Булево), ХвостУсечён (Булево —
//              прочитан не весь файл, отбор мог не увидеть старые записи),
//              Доступен (Булево — файл журнала прочитан; пустая выдача при Ложь
//              означает «показать нечем», а не «событий не было»).
//
Функция Страница(Знач Отбор, Знач Смещение, Знач Размер) Экспорт

	Хвост = ПрочитатьХвост();

	Подходящие = Новый Массив();
	Неразобранных = 0;
	Для Каждого Строчка Из Хвост.Строки Цикл
		// сбой разбора одной строки не имеет права уносить весь экран журнала:
		// строка пропускается, чтение продолжается
		Попытка
			Запись = Формат.ИзСтроки(Строчка);
		Исключение
			Неразобранных = Неразобранных + 1;
			Продолжить;
		КонецПопытки;
		Если Запись <> Неопределено И Подходит(Запись, Отбор) Тогда
			Подходящие.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	Если Неразобранных > 0 Тогда
		Лог.Предупреждение("Журнал аудита %1: строк, которые не осилил разбор — %2",
			Аппендер.Путь(), Неразобранных);
	КонецЕсли;

	// «на экране пусто» разбирается отсюда: видно, сколько строк вообще прочитано
	// хвостом, сколько прошло отбор и был ли хвост усечён потолком чтения
	Лог.Отладка("Журнал аудита: прочитано строк %1, отбор прошли %2, хвост усечён: %3",
		Хвост.Строки.Количество(), Подходящие.Количество(), Хвост.Усечён);

	Возврат СобратьСтраницу(Развёрнутые(Подходящие), Смещение, Размер, Хвост);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Верхняя граница чтения: журнал не ротируется, целиком его грузить нельзя.
Функция РазмерХвостаБайт()
	Возврат 4194304;
КонецФункции

Функция ПрочитатьХвост()

	Результат = Новый Структура("Строки, Усечён, Доступен", Новый Массив(), Ложь, Истина);

	Путь = Аппендер.Путь();
	Если НЕ Новый Файл(Путь).Существует() Тогда
		Возврат Результат; // журнала ещё нет — это пустой журнал, а не ошибка
	КонецЕсли;

	Попытка
		Текст = ХвостФайла(Путь, Результат);
	Исключение
		Лог.Предупреждение("Журнал аудита %1 не прочитан: %2", Путь,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Результат.Усечён = Истина;
		// файл есть, но не читается: пустая выдача обязана быть отличима от пустого
		// журнала, иначе экран покажет «событий не было» вместо «показать нечем»
		Результат.Доступен = Ложь;
		Возврат Результат;
	КонецПопытки;

	Строки = СтрРазделить(Текст, Символы.ПС);
	Если Результат.Усечён И Строки.Количество() > 0 Тогда
		Строки.Удалить(0); // первая строка хвоста обрезана посередине
	КонецЕсли;

	Результат.Строки = Строки;

	Возврат Результат;

КонецФункции

Функция ХвостФайла(Знач Путь, Результат)

	Поток = ФайловыеПотоки.ОткрытьДляЧтения(Путь);
	Попытка
		РазмерФайла = Поток.Размер();
		Длина = Мин(РазмерФайла, РазмерХвостаБайт());
		Результат.Усечён = Длина < РазмерФайла;
		Поток.Перейти(РазмерФайла - Длина, ПозицияВПотоке.Начало);
		Чтение = Новый ЧтениеДанных(Поток);
		Буфер = Чтение.ПрочитатьВБуферДвоичныхДанных();
		Чтение.Закрыть();
	Исключение
		Поток.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Поток.Закрыть();

	Возврат ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер, "utf-8");

КонецФункции

// Файл дописывается в конец, поэтому обратный порядок строк — это «новые первыми».
Функция Развёрнутые(Знач Записи)

	Результат = Новый Массив();
	Для Сдвиг = 0 По Записи.ВГраница() Цикл
		Результат.Добавить(Записи[Записи.ВГраница() - Сдвиг]);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Подходит(Знач Запись, Знач Отбор)

	Если ТипЗнч(Отбор) <> Тип("Структура") Тогда
		Возврат Истина;
	КонецЕсли;

	Действие = Условие(Отбор, "Действие");
	Если ЗначениеЗаполнено(Действие) И Запись.Действие <> Действие Тогда
		Возврат Ложь;
	КонецЕсли;

	Кто = Условие(Отбор, "Кто");
	Если ЗначениеЗаполнено(Кто) И Запись.Кто <> Кто Тогда
		Возврат Ложь;
	КонецЕсли;

	НачалоПериода = Условие(Отбор, "С");
	Если ТипЗнч(НачалоПериода) = Тип("Дата") И ЗначениеЗаполнено(НачалоПериода)
		И Запись.Когда < НачалоПериода Тогда
		Возврат Ложь;
	КонецЕсли;

	КонецПериода = Условие(Отбор, "По");
	Если ТипЗнч(КонецПериода) = Тип("Дата") И ЗначениеЗаполнено(КонецПериода)
		И Запись.Когда > КонецПериода Тогда
		Возврат Ложь;
	КонецЕсли;

	// адрес сверяется ЗНАЧЕНИЕМ: журнал не мигрируется, и запись прежней версии хаба
	// с адресом как пришёл обязана находиться наравне с канонической
	Возврат Адреса.Подходит(Условие(Отбор, "Адрес"), Запись.АдресIP);

КонецФункции

Функция Условие(Знач Отбор, Знач Имя)

	Значение = Неопределено;
	Если Отбор.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция СобратьСтраницу(Знач Записи, Знач Смещение, Знач Размер, Знач Хвост)

	Начало = ?(ЗначениеЗаполнено(Смещение) И Смещение > 0, Смещение, 0);
	Сколько = ?(ЗначениеЗаполнено(Размер) И Размер > 0, Размер, 0);

	Отобранные = Новый Массив();
	Индекс = Начало;
	Пока Индекс < Записи.Количество() И Отобранные.Количество() < Сколько Цикл
		Отобранные.Добавить(Записи[Индекс]);
		Индекс = Индекс + 1;
	КонецЦикла;

	Результат = Новый Структура();
	Результат.Вставить("Записи", Отобранные);
	// нулевая страница ничего не показала — обещать продолжение нечему
	Результат.Вставить("ЕстьСледующая", Сколько > 0 И Записи.Количество() > Начало + Сколько);
	Результат.Вставить("ХвостУсечён", Хвост.Усечён);
	Результат.Вставить("Доступен", Хвост.Доступен);

	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ИсточникЖурналаАудита")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ФорматЖурналаАудита") _Формат,
	&Пластилин(Значение = "АппендерЖурналаАудита") _Аппендер,
	&Пластилин(Значение = "ОтборПоАдресу") _Адреса,
	&Лог _Лог = Неопределено)

	Формат = _Формат;
	Аппендер = _Аппендер;
	Адреса = _Адреса;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
