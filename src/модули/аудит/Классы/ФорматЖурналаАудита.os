// Формат строки журнала аудита: одна запись — один JSON-объект в одну строку.
// Пишущая и читающая стороны берут формат только отсюда и разойтись не могут.

Перем ПараметрыЗаписи;
Перем ЧтениеПолей;   // ЧтениеПолей (основа)

#Область ПубличныйИнтерфейс

// Пустая запись журнала нужной формы.
//
// Возвращаемое значение:
//  Структура - Когда, Кто, Действие, Объект, Субъект, Детали, АдресIP.
//
Функция НоваяЗапись() Экспорт

	Запись = Новый Структура();
	Запись.Вставить("Когда", '00010101');
	Запись.Вставить("Кто", "");
	Запись.Вставить("Действие", "");
	Запись.Вставить("Объект", "");
	Запись.Вставить("Субъект", "");
	Запись.Вставить("Детали", "");
	Запись.Вставить("АдресIP", "");

	Возврат Запись;

КонецФункции

// Сериализует запись в одну строку файла журнала.
// Переводы строк, кавычки и разделители внутри значений экранируются JSON,
// поэтому запись остаётся ровно одной строкой при любом содержимом.
//
// Параметры:
//  Запись - Структура - см. НоваяЗапись.
//
// Возвращаемое значение:
//  Строка - JSON-объект без переводов строк.
//
Функция Строкой(Знач Запись) Экспорт

	Поля = Новый Соответствие();
	Поля.Вставить(КлючКогда(), МоментомISO(Значение(Запись, "Когда")));
	Поля.Вставить("кто", Текстом(Значение(Запись, "Кто")));
	Поля.Вставить("действие", Текстом(Значение(Запись, "Действие")));
	Поля.Вставить("объект", Текстом(Значение(Запись, "Объект")));
	Поля.Вставить("субъект", Текстом(Значение(Запись, "Субъект")));
	Поля.Вставить("детали", Текстом(Значение(Запись, "Детали")));
	Поля.Вставить("ip", Текстом(Значение(Запись, "АдресIP")));

	ПисательJSON = Новый ЗаписьJSON();
	ПисательJSON.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ПисательJSON, Поля);

	Возврат ПисательJSON.Закрыть();

КонецФункции

// Разбирает строку файла журнала обратно в запись.
//
// Параметры:
//  Строка - Строка - одна строка файла журнала.
//
// Возвращаемое значение:
//  Структура - см. НоваяЗапись; Неопределено — строка не является записью журнала.
//
Функция ИзСтроки(Знач Строка) Экспорт

	Если ПустаяСтрока(Строка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Поля = РазобратьОбъект(Строка);
	Если Поля = Неопределено ИЛИ Поля.Получить(КлючКогда()) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запись = НоваяЗапись();
	Запись.Когда = МоментомИзISO(Поля.Получить(КлючКогда()));
	Запись.Кто = Текстом(Поля.Получить("кто"));
	Запись.Действие = Текстом(Поля.Получить("действие"));
	Запись.Объект = Текстом(Поля.Получить("объект"));
	Запись.Субъект = Текстом(Поля.Получить("субъект"));
	Запись.Детали = Текстом(Поля.Получить("детали"));
	Запись.АдресIP = Текстом(Поля.Получить("ip"));

	Возврат Запись;

КонецФункции

// Разбирает подробности события обратно в поля. Зеркально записи: строка, ушедшая
// в журнал строкой, возвращается строкой, число — числом, вложенный объект — соответствием.
//
// Параметры:
//  Текст - Строка - JSON-объект подробностей (поле «детали» записи журнала).
//
// Возвращаемое значение:
//  Соответствие - поля подробностей; Неопределено — текст не является JSON-объектом.
//
Функция ДеталиПолями(Знач Текст) Экспорт
	Возврат РазобратьОбъект(Текст, Ложь);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлючКогда()
	Возврат "когда";
КонецФункции

Функция Значение(Знач Запись, Знач Имя)
	Возврат ЧтениеПолей.Поле(Запись, Имя, Неопределено);
КонецФункции

Функция Текстом(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат ISOИзДаты(Значение);
	КонецЕсли;

	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции

Функция ISOИзДаты(Знач Момент)
	Возврат Формат(Момент, "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z";
КонецФункции

Функция МоментомISO(Знач Момент)

	Если ТипЗнч(Момент) <> Тип("Дата") ИЛИ НЕ ЗначениеЗаполнено(Момент) Тогда
		Момент = ТекущаяУниверсальнаяДата();
	КонецЕсли;

	Возврат ISOИзДаты(Момент);

КонецФункции

Функция МоментомИзISO(Знач Значение)

	Текст = ?(Значение = Неопределено, "", Строка(Значение));

	Цифры = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Знак = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Знак) > 0 Тогда
			Цифры = Цифры + Знак;
		КонецЕсли;
		Если СтрДлина(Цифры) = 14 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если СтрДлина(Цифры) < 14 Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		Возврат Дата(Число(Сред(Цифры, 1, 4)), Число(Сред(Цифры, 5, 2)), Число(Сред(Цифры, 7, 2)),
			Число(Сред(Цифры, 9, 2)), Число(Сред(Цифры, 11, 2)), Число(Сред(Цифры, 13, 2)));
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// Разбор свой, а не ЧтениеJSON платформы: тот подменяет ISO-подобное значение Датой
// и теряет доли секунды — и строка журнала, и подробности события вернулись бы не тем,
// чем в журнал ушли.
//
// ТолькоТекстовыеЗначения = Истина — поля строки журнала: они все текстовые, и объект
// с числом на месте поля записью не является. Ложь — подробности события: там число
// осталось числом, флаг флагом, вложенный объект соответствием.
Функция РазобратьОбъект(Знач Текст, Знач ТолькоТекстовыеЗначения = Истина)

	Позиция = Пропуск(Текст, 1);
	Провал = Ложь;
	Поля = ПрочитатьОбъект(Текст, Позиция, ТолькоТекстовыеЗначения, Провал);

	Возврат ?(Провал, Неопределено, Поля);

КонецФункции

Функция ПрочитатьОбъект(Знач Текст, Позиция, Знач ТолькоТекстовыеЗначения, Провал)

	Поля = Новый Соответствие();

	Если Сред(Текст, Позиция, 1) <> "{" Тогда
		Возврат Провалено(Провал);
	КонецЕсли;
	Позиция = Пропуск(Текст, Позиция + 1);

	Если Сред(Текст, Позиция, 1) = "}" Тогда
		Позиция = Позиция + 1;
		Возврат Поля;
	КонецЕсли;

	Пока Истина Цикл

		Ключ = ПрочитатьТекст(Текст, Позиция);
		Если Ключ = Неопределено Тогда
			Возврат Провалено(Провал);
		КонецЕсли;

		Позиция = Пропуск(Текст, Позиция);
		Если Сред(Текст, Позиция, 1) <> ":" Тогда
			Возврат Провалено(Провал);
		КонецЕсли;
		Позиция = Пропуск(Текст, Позиция + 1);

		ЗначениеПоля = ПрочитатьЗначение(Текст, Позиция, ТолькоТекстовыеЗначения, Провал);
		Если Провал Тогда
			Возврат Неопределено;
		КонецЕсли;
		Поля.Вставить(Ключ, ЗначениеПоля);

		Позиция = Пропуск(Текст, Позиция);
		Разделитель = Сред(Текст, Позиция, 1);
		Если Разделитель = "," Тогда
			Позиция = Пропуск(Текст, Позиция + 1);
		ИначеЕсли Разделитель = "}" Тогда
			Позиция = Позиция + 1;
			Прервать;
		Иначе
			Возврат Провалено(Провал);
		КонецЕсли;

	КонецЦикла;

	Возврат Поля;

КонецФункции

Функция ПрочитатьМассив(Знач Текст, Позиция, Знач ТолькоТекстовыеЗначения, Провал)

	Элементы = Новый Массив();
	Позиция = Пропуск(Текст, Позиция + 1);

	Если Сред(Текст, Позиция, 1) = "]" Тогда
		Позиция = Позиция + 1;
		Возврат Элементы;
	КонецЕсли;

	Пока Истина Цикл

		Элементы.Добавить(ПрочитатьЗначение(Текст, Позиция, ТолькоТекстовыеЗначения, Провал));
		Если Провал Тогда
			Возврат Неопределено;
		КонецЕсли;

		Позиция = Пропуск(Текст, Позиция);
		Разделитель = Сред(Текст, Позиция, 1);
		Если Разделитель = "," Тогда
			Позиция = Пропуск(Текст, Позиция + 1);
		ИначеЕсли Разделитель = "]" Тогда
			Позиция = Позиция + 1;
			Прервать;
		Иначе
			Возврат Провалено(Провал);
		КонецЕсли;

	КонецЦикла;

	Возврат Элементы;

КонецФункции

// Провал разбора и JSON-null оба «ничего не значат», поэтому неудача сообщается флагом,
// а не значением: иначе поле со значением null уносило бы весь объект в «не разбирается».
Функция ПрочитатьЗначение(Знач Текст, Позиция, Знач ТолькоТекстовыеЗначения, Провал)

	Знак = Сред(Текст, Позиция, 1);

	Если Знак = """" Тогда
		Прочитанное = ПрочитатьТекст(Текст, Позиция);
		Возврат ?(Прочитанное = Неопределено, Провалено(Провал), Прочитанное);
	КонецЕсли;

	Если ТолькоТекстовыеЗначения Тогда
		Возврат Провалено(Провал);
	КонецЕсли;

	Если Знак = "{" Тогда
		Возврат ПрочитатьОбъект(Текст, Позиция, ТолькоТекстовыеЗначения, Провал);
	ИначеЕсли Знак = "[" Тогда
		Возврат ПрочитатьМассив(Текст, Позиция, ТолькоТекстовыеЗначения, Провал);
	КонецЕсли;

	Возврат ПрочитатьЛитерал(Текст, Позиция, Провал);

КонецФункции

// Число, true, false, null — всё, что записано без кавычек и скобок.
Функция ПрочитатьЛитерал(Знач Текст, Позиция, Провал)

	Начало = Позиция;
	Длина = СтрДлина(Текст);
	Пока Позиция <= Длина И СтрНайти(",}] " + Символы.Таб + Символы.ПС + Символы.ВК,
		Сред(Текст, Позиция, 1)) = 0 Цикл
		Позиция = Позиция + 1;
	КонецЦикла;

	Лексема = Сред(Текст, Начало, Позиция - Начало);
	Если Лексема = "true" Тогда
		Возврат Истина;
	ИначеЕсли Лексема = "false" Тогда
		Возврат Ложь;
	ИначеЕсли Лексема = "null" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат Число(Лексема);
	Исключение
		Возврат Провалено(Провал);
	КонецПопытки;

КонецФункции

Функция Провалено(Провал)
	Провал = Истина;
	Возврат Неопределено;
КонецФункции

Функция Пропуск(Знач Текст, Знач Позиция)

	Пробельные = " " + Символы.Таб + Символы.ПС + Символы.ВК;
	Длина = СтрДлина(Текст);

	Пока Позиция <= Длина И СтрНайти(Пробельные, Сред(Текст, Позиция, 1)) > 0 Цикл
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Позиция;

КонецФункции

Функция ПрочитатьТекст(Знач Текст, Позиция)

	Если Сред(Текст, Позиция, 1) <> """" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Позиция = Позиция + 1;

	Итог = "";

	Пока Истина Цикл

		// строка кончилась, а закрывающей кавычки не было: обрывок, а не запись.
		// Проверка обязана быть ДО СтрНайти — тот падает на позиции за концом строки
		Если Позиция > СтрДлина(Текст) Тогда
			Возврат Неопределено;
		КонецЕсли;

		Кавычка = СтрНайти(Текст, """", , Позиция);
		Если Кавычка = 0 Тогда
			Возврат Неопределено; // строка не закрыта — обрывок, а не запись
		КонецЕсли;

		Экранирование = СтрНайти(Текст, "\", , Позиция);
		Ближайший = ?(Экранирование > 0 И Экранирование < Кавычка, Экранирование, Кавычка);

		Если Ближайший > Позиция Тогда
			Итог = Итог + Сред(Текст, Позиция, Ближайший - Позиция);
		КонецЕсли;
		Позиция = Ближайший;

		Если Позиция = Кавычка Тогда
			Позиция = Позиция + 1;
			Возврат Итог;
		КонецЕсли;

		Расшифрованное = Расшифровка(Текст, Позиция);
		Если Расшифрованное = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Итог = Итог + Расшифрованное;

	КонецЦикла;

КонецФункции

// Разбирает одну escape-последовательность, начиная с обратного слэша, и двигает позицию.
Функция Расшифровка(Знач Текст, Позиция)

	Знак = Сред(Текст, Позиция + 1, 1);
	Позиция = Позиция + 2;

	Если Знак = "n" Тогда
		Возврат Символы.ПС;
	ИначеЕсли Знак = "r" Тогда
		Возврат Символы.ВК;
	ИначеЕсли Знак = "t" Тогда
		Возврат Символы.Таб;
	ИначеЕсли Знак = "b" Тогда
		Возврат Символ(8);
	ИначеЕсли Знак = "f" Тогда
		Возврат Символ(12);
	ИначеЕсли Знак = "u" Тогда
		Код = КодИзHex(Сред(Текст, Позиция, 4));
		Если Код < 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Позиция = Позиция + 4;
		Возврат Символ(Код);
	ИначеЕсли Знак = "" Тогда
		Возврат Неопределено; // слэш на самом конце строки
	КонецЕсли;

	Возврат Знак; // \" \\ \/ и всё прочее — сам символ

КонецФункции

Функция КодИзHex(Знач Текст)

	Если СтрДлина(Текст) <> 4 Тогда
		Возврат -1;
	КонецЕсли;

	Цифры = "0123456789abcdef";
	Код = 0;
	Для Позиция = 1 По 4 Цикл
		Разряд = СтрНайти(Цифры, НРег(Сред(Текст, Позиция, 1)));
		Если Разряд = 0 Тогда
			Возврат -1;
		КонецЕсли;
		Код = Код * 16 + Разряд - 1;
	КонецЦикла;

	Возврат Код;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ЧтениеПолей") _ЧтениеПолей = Неопределено)

	ЧтениеПолей = ?(_ЧтениеПолей = Неопределено, Новый ЧтениеПолей(), _ЧтениеПолей);

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(
		ПереносСтрокJSON.Нет,
		"",
		Истина,
		ЭкранированиеСимволовJSON.Нет,
		Ложь,
		Истина,
		Ложь,
		Истина,
		Истина);

КонецПроцедуры
