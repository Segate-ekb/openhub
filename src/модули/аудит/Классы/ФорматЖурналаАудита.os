// Формат строки журнала аудита: одна запись — один JSON-объект в одну строку.
// Пишущая и читающая стороны берут формат только отсюда и разойтись не могут.

Перем ПараметрыЗаписи;

#Область ПубличныйИнтерфейс

// Пустая запись журнала нужной формы.
//
// Возвращаемое значение:
//  Структура - Когда, Кто, Действие, Объект, Субъект, Детали, АдресIP.
//
Функция НоваяЗапись() Экспорт

	Запись = Новый Структура();
	Запись.Вставить("Когда", '00010101');
	Запись.Вставить("Кто", "");
	Запись.Вставить("Действие", "");
	Запись.Вставить("Объект", "");
	Запись.Вставить("Субъект", "");
	Запись.Вставить("Детали", "");
	Запись.Вставить("АдресIP", "");

	Возврат Запись;

КонецФункции

// Сериализует запись в одну строку файла журнала.
// Переводы строк, кавычки и разделители внутри значений экранируются JSON,
// поэтому запись остаётся ровно одной строкой при любом содержимом.
//
// Параметры:
//  Запись - Структура - см. НоваяЗапись.
//
// Возвращаемое значение:
//  Строка - JSON-объект без переводов строк.
//
Функция Строкой(Знач Запись) Экспорт

	Поля = Новый Соответствие();
	Поля.Вставить(КлючКогда(), МоментомISO(Значение(Запись, "Когда")));
	Поля.Вставить("кто", Текстом(Значение(Запись, "Кто")));
	Поля.Вставить("действие", Текстом(Значение(Запись, "Действие")));
	Поля.Вставить("объект", Текстом(Значение(Запись, "Объект")));
	Поля.Вставить("субъект", Текстом(Значение(Запись, "Субъект")));
	Поля.Вставить("детали", Текстом(Значение(Запись, "Детали")));
	Поля.Вставить("ip", Текстом(Значение(Запись, "АдресIP")));

	ЗаписьJSON_ = Новый ЗаписьJSON();
	ЗаписьJSON_.УстановитьСтроку(ПараметрыЗаписи);
	ЗаписатьJSON(ЗаписьJSON_, Поля);

	Возврат ЗаписьJSON_.Закрыть();

КонецФункции

// Разбирает строку файла журнала обратно в запись.
//
// Параметры:
//  Строка - Строка - одна строка файла журнала.
//
// Возвращаемое значение:
//  Структура - см. НоваяЗапись; Неопределено — строка не является записью журнала.
//
Функция ИзСтроки(Знач Строка) Экспорт

	Если ПустаяСтрока(Строка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Поля = РазобратьОбъект(Строка);
	Если Поля = Неопределено ИЛИ Поля.Получить(КлючКогда()) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запись = НоваяЗапись();
	Запись.Когда = МоментомИзISO(Поля.Получить(КлючКогда()));
	Запись.Кто = Текстом(Поля.Получить("кто"));
	Запись.Действие = Текстом(Поля.Получить("действие"));
	Запись.Объект = Текстом(Поля.Получить("объект"));
	Запись.Субъект = Текстом(Поля.Получить("субъект"));
	Запись.Детали = Текстом(Поля.Получить("детали"));
	Запись.АдресIP = Текстом(Поля.Получить("ip"));

	Возврат Запись;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлючКогда()
	Возврат "когда";
КонецФункции

Функция Значение(Знач Запись, Знач Имя)

	Найденное = Неопределено;
	Если ТипЗнч(Запись) = Тип("Структура") И Запись.Свойство(Имя, Найденное) Тогда
		Возврат Найденное;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция Текстом(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат ISOИзДаты(Значение);
	КонецЕсли;

	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции

Функция ISOИзДаты(Знач Момент)
	Возврат Формат(Момент, "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z";
КонецФункции

Функция МоментомISO(Знач Момент)

	Если ТипЗнч(Момент) <> Тип("Дата") ИЛИ НЕ ЗначениеЗаполнено(Момент) Тогда
		Момент = ТекущаяУниверсальнаяДата();
	КонецЕсли;

	Возврат ISOИзДаты(Момент);

КонецФункции

Функция МоментомИзISO(Знач Значение)

	Текст = ?(Значение = Неопределено, "", Строка(Значение));

	Цифры = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ_ = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Символ_) > 0 Тогда
			Цифры = Цифры + Символ_;
		КонецЕсли;
		Если СтрДлина(Цифры) = 14 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если СтрДлина(Цифры) < 14 Тогда
		Возврат '00010101';
	КонецЕсли;

	Попытка
		Возврат Дата(Число(Сред(Цифры, 1, 4)), Число(Сред(Цифры, 5, 2)), Число(Сред(Цифры, 7, 2)),
			Число(Сред(Цифры, 9, 2)), Число(Сред(Цифры, 11, 2)), Число(Сред(Цифры, 13, 2)));
	Исключение
		Возврат '00010101';
	КонецПопытки;

КонецФункции

// Разбор плоского объекта из строк — свой, потому что ЧтениеJSON платформы молча
// подменяет ISO-подобное значение типом Дата и теряет доли секунды и смещение зоны.
Функция РазобратьОбъект(Знач Текст)

	Поля = Новый Соответствие();
	Позиция = Пропуск(Текст, 1);

	Если Сред(Текст, Позиция, 1) <> "{" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Позиция = Пропуск(Текст, Позиция + 1);

	Если Сред(Текст, Позиция, 1) = "}" Тогда
		Возврат Поля;
	КонецЕсли;

	Пока Истина Цикл

		Ключ = ПрочитатьТекст(Текст, Позиция);
		Если Ключ = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;

		Позиция = Пропуск(Текст, Позиция);
		Если Сред(Текст, Позиция, 1) <> ":" Тогда
			Возврат Неопределено;
		КонецЕсли;
		Позиция = Пропуск(Текст, Позиция + 1);

		ЗначениеПоля = ПрочитатьТекст(Текст, Позиция);
		Если ЗначениеПоля = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Поля.Вставить(Ключ, ЗначениеПоля);

		Позиция = Пропуск(Текст, Позиция);
		Разделитель = Сред(Текст, Позиция, 1);
		Если Разделитель = "," Тогда
			Позиция = Пропуск(Текст, Позиция + 1);
		ИначеЕсли Разделитель = "}" Тогда
			Прервать;
		Иначе
			Возврат Неопределено;
		КонецЕсли;

	КонецЦикла;

	Возврат Поля;

КонецФункции

Функция Пропуск(Знач Текст, Знач Позиция)

	Пробельные = " " + Символы.Таб + Символы.ПС + Символы.ВК;
	Длина = СтрДлина(Текст);

	Пока Позиция <= Длина И СтрНайти(Пробельные, Сред(Текст, Позиция, 1)) > 0 Цикл
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Позиция;

КонецФункции

Функция ПрочитатьТекст(Знач Текст, Позиция)

	Если Сред(Текст, Позиция, 1) <> """" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Позиция = Позиция + 1;

	Итог = "";

	Пока Истина Цикл

		// строка кончилась, а закрывающей кавычки не было: обрывок, а не запись.
		// Проверка обязана быть ДО СтрНайти — тот падает на позиции за концом строки
		Если Позиция > СтрДлина(Текст) Тогда
			Возврат Неопределено;
		КонецЕсли;

		Кавычка = СтрНайти(Текст, """", , Позиция);
		Если Кавычка = 0 Тогда
			Возврат Неопределено; // строка не закрыта — обрывок, а не запись
		КонецЕсли;

		Экранирование = СтрНайти(Текст, "\", , Позиция);
		Ближайший = ?(Экранирование > 0 И Экранирование < Кавычка, Экранирование, Кавычка);

		Если Ближайший > Позиция Тогда
			Итог = Итог + Сред(Текст, Позиция, Ближайший - Позиция);
		КонецЕсли;
		Позиция = Ближайший;

		Если Позиция = Кавычка Тогда
			Позиция = Позиция + 1;
			Возврат Итог;
		КонецЕсли;

		Расшифрованное = Расшифровка(Текст, Позиция);
		Если Расшифрованное = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Итог = Итог + Расшифрованное;

	КонецЦикла;

КонецФункции

// Разбирает одну escape-последовательность, начиная с обратного слэша, и двигает позицию.
Функция Расшифровка(Знач Текст, Позиция)

	Символ_ = Сред(Текст, Позиция + 1, 1);
	Позиция = Позиция + 2;

	Если Символ_ = "n" Тогда
		Возврат Символы.ПС;
	ИначеЕсли Символ_ = "r" Тогда
		Возврат Символы.ВК;
	ИначеЕсли Символ_ = "t" Тогда
		Возврат Символы.Таб;
	ИначеЕсли Символ_ = "b" Тогда
		Возврат Символ(8);
	ИначеЕсли Символ_ = "f" Тогда
		Возврат Символ(12);
	ИначеЕсли Символ_ = "u" Тогда
		Код = КодИзHex(Сред(Текст, Позиция, 4));
		Если Код < 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Позиция = Позиция + 4;
		Возврат Символ(Код);
	ИначеЕсли Символ_ = "" Тогда
		Возврат Неопределено; // слэш на самом конце строки
	КонецЕсли;

	Возврат Символ_; // \" \\ \/ и всё прочее — сам символ

КонецФункции

Функция КодИзHex(Знач Текст)

	Если СтрДлина(Текст) <> 4 Тогда
		Возврат -1;
	КонецЕсли;

	Цифры = "0123456789abcdef";
	Код = 0;
	Для Позиция = 1 По 4 Цикл
		Разряд = СтрНайти(Цифры, НРег(Сред(Текст, Позиция, 1)));
		Если Разряд = 0 Тогда
			Возврат -1;
		КонецЕсли;
		Код = Код * 16 + Разряд - 1;
	КонецЦикла;

	Возврат Код;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта()

	ПараметрыЗаписи = Новый ПараметрыЗаписиJSON(
		ПереносСтрокJSON.Нет,
		"",
		Истина,
		ЭкранированиеСимволовJSON.Нет,
		Ложь,
		Истина,
		Ложь,
		Истина,
		Истина);

КонецПроцедуры
