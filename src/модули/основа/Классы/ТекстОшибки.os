// Приведение ОписаниеОшибки() к одной строке лога, атрибута спана или тоста.
// Текст передаётся аргументом: ОписаниеОшибки() не видно из чужого кадра.

// Убирает из описания ошибки переносы строк и возвраты каретки.
//
// Параметры:
//  Текст - Строка - результат ОписаниеОшибки() вызывающего.
//
// Возвращаемое значение:
//  Строка - описание в одну строку.
//
Функция Однострочно(Знач Текст) Экспорт
	Возврат СтрЗаменить(СтрЗаменить(Строка(Текст), Символы.ПС, " "), Символы.ВК, "");
КонецФункции

// Выделяет пользовательскую часть описания ошибки, снимая служебное обрамление
// OneScript «{Модуль … / Error in line: N / текст}».
//
// Параметры:
//  Значение - Строка - строка ОписаниеОшибки(), возможно уже однострочная.
//
// Возвращаемое значение:
//  Строка - текст без обрамления; пустая строка, если текста не осталось.
//
Функция БезСлужебного(Знач Значение) Экспорт

	Текст = СокрЛП(Строка(Значение));
	Если НЕ (Лев(Текст, 1) = "{" И Прав(Текст, 1) = "}") Тогда
		Возврат Текст;
	КонецЕсли;

	Внутри = СокрЛП(Сред(Текст, 2, СтрДлина(Текст) - 2));

	Разделитель = " / ";
	Первый = СтрНайти(Внутри, Разделитель);
	Если Первый > 0 Тогда
		Хвост = Сред(Внутри, Первый + СтрДлина(Разделитель));
		Второй = СтрНайти(Хвост, Разделитель);
		Если Второй > 0 Тогда
			Внутри = СокрЛП(Сред(Хвост, Второй + СтрДлина(Разделитель)));
		КонецЕсли;
	КонецЕсли;

	Возврат Внутри;

КонецФункции

// Пользовательская часть описания ошибки в одну строку: обёртка снята, переносы убраны.
// Ровно это уходит на экран и в ответ клиенту; служебные координаты чужого модуля —
// в журнал, а не наружу.
//
// Параметры:
//  Значение - Строка - результат ОписаниеОшибки() вызывающего.
//
// Возвращаемое значение:
//  Строка - краткая причина; пустая строка, если пользовательского текста не осталось.
//
Функция Кратко(Знач Значение) Экспорт
	Возврат БезСлужебного(Однострочно(Значение));
КонецФункции

// Заменяет вхождения секрета в тексте на маску. Нужна там, где диагностика транспорта
// собрана чужой библиотекой и может нести учётные данные (адрес Bot API с токеном).
//
// Параметры:
//  Текст - Строка - диагностическое сообщение.
//  Секрет - Строка - значение, которого в сообщении быть не должно.
//
// Возвращаемое значение:
//  Строка - текст, в котором секрет заменён на «•••».
//
Функция БезСекрета(Знач Текст, Знач Секрет) Экспорт

	Значение = Строка(Текст);
	Скрываемое = СокрЛП(Строка(Секрет));
	// короткое значение маскировать нечем: его «вхождения» — это случайные совпадения
	Если СтрДлина(Скрываемое) < 6 Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат СтрЗаменить(Значение, Скрываемое, Маска());

КонецФункции

// Маска, которой заменяется секрет в диагностике.
//
// Возвращаемое значение:
//  Строка.
//
Функция Маска() Экспорт
	Возврат "•••";
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
