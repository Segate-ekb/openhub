// Приведение сбоя к тексту: одна строка для журнала, полный отчёт для отладки,
// понятная фраза для человека. Причина при этом не теряется — её держит библиотека errors.
//
// Класс говорит на двух языках, и области ниже их разделяют. Имея на руках
// ИнформациюОбОшибке, зовут «сбой объектом»: там видна вся цепочка причин. Имея только
// строку ОписаниеОшибки(), зовут «сбой строкой»: там доступна одна строковая хирургия.

#Использовать errors

#Область СбойОбъектом

// Причина сбоя одной строкой для уровня ОШИБКА: контекст хаба, машинный код, дословный
// текст корневой причины и место, где она возникла. Информация приезжает параметром:
// достоверна она только в кадре обработчика. Сбой без текста называет себя типом —
// молчание в журнале хуже некрасивой строки.
//
// Параметры:
//  Инфо - ИнформацияОбОшибке - результат ИнформацияОбОшибке() вызывающего.
//
// Возвращаемое значение:
//  Строка - причина в одну строку либо «сбой без описания (тип)».
//
Функция Причина(Знач Инфо) Экспорт

	Разбор = ДиагностикаОшибок.Разобрать(Инфо);
	Корень = Разбор.КорневаяПричина();

	Части = Новый Массив();
	ДобавитьЧасть(Части, Однострочно(Разбор.КраткоеПредставление()));

	Если Корень <> Неопределено Тогда
		ДобавитьЧасть(Части, ДословнаяПричина(Части, Корень));
		ДобавитьЧасть(Части, МестоВозникновения(Корень));
	КонецЕсли;

	Текст = СтрСоединить(Части, " ");

	Возврат ?(ЗначениеЗаполнено(Текст), Текст, СтрШаблон("сбой без описания (%1)", ТипЗнч(Инфо)));

КонецФункции

// Полный отчёт по сбою для уровня ОТЛАДКА: вся цепочка причин, их данные, места
// возникновения и стек вызовов. Многострочный — журнал печатает его как есть.
// Отчёт раскрывает данные ошибки без маскирования: секретам в них не место.
//
// Параметры:
//  Инфо - ИнформацияОбОшибке - результат ИнформацияОбОшибке() вызывающего.
//
// Возвращаемое значение:
//  Строка - диагностическое представление цепочки.
//
Функция ПодробныйОтчёт(Знач Инфо) Экспорт
	Возврат ДиагностикаОшибок.ДиагностическоеПредставление(Инфо);
КонецФункции

// Текст сбоя для человека: без служебной обёртки OneScript «{Модуль … / Error in line: N}»
// и без внутренностей хаба. Ровно это уходит в консоль opm, на экран и в тело ответа.
//
// Параметры:
//  Инфо - ИнформацияОбОшибке - результат ИнформацияОбОшибке() вызывающего.
//
// Возвращаемое значение:
//  Строка - понятная фраза; пустая строка, если текста у сбоя не оказалось.
//
Функция ДляЧеловека(Знач Инфо) Экспорт
	Возврат СокрЛП(Однострочно(ДиагностикаОшибок.ПользовательскоеПредставление(Инфо)));
КонецФункции

#КонецОбласти

#Область СбойСтрокой

// Убирает из описания ошибки переносы строк и возвраты каретки.
//
// Параметры:
//  Текст - Строка - результат ОписаниеОшибки() вызывающего.
//
// Возвращаемое значение:
//  Строка - описание в одну строку.
//
Функция Однострочно(Знач Текст) Экспорт
	Возврат СтрЗаменить(СтрЗаменить(Строка(Текст), Символы.ПС, " "), Символы.ВК, "");
КонецФункции

// Выделяет пользовательскую часть описания ошибки, снимая служебное обрамление
// OneScript «{Модуль … / Error in line: N / текст}». Нужна там, где на руках только
// строка ОписаниеОшибки(); имея ИнформациюОбОшибке, зовите ДляЧеловека.
//
// Параметры:
//  Значение - Строка - строка ОписаниеОшибки(), возможно уже однострочная.
//
// Возвращаемое значение:
//  Строка - текст без обрамления; пустая строка, если текста не осталось.
//
Функция БезСлужебного(Знач Значение) Экспорт

	Текст = СокрЛП(Строка(Значение));
	Если НЕ (Лев(Текст, 1) = "{" И Прав(Текст, 1) = "}") Тогда
		Возврат Текст;
	КонецЕсли;

	Внутри = СокрЛП(Сред(Текст, 2, СтрДлина(Текст) - 2));

	Разделитель = " / ";
	Первый = СтрНайти(Внутри, Разделитель);
	Если Первый > 0 Тогда
		Хвост = Сред(Внутри, Первый + СтрДлина(Разделитель));
		Второй = СтрНайти(Хвост, Разделитель);
		Если Второй > 0 Тогда
			Внутри = СокрЛП(Сред(Хвост, Второй + СтрДлина(Разделитель)));
		КонецЕсли;
	КонецЕсли;

	Возврат Внутри;

КонецФункции

// Пользовательская часть описания ошибки в одну строку: обёртка снята, переносы убраны.
// Ровно это уходит на экран и в ответ клиенту; служебные координаты чужого модуля —
// в журнал, а не наружу.
//
// Параметры:
//  Значение - Строка - результат ОписаниеОшибки() вызывающего.
//
// Возвращаемое значение:
//  Строка - краткая причина; пустая строка, если пользовательского текста не осталось.
//
Функция Кратко(Знач Значение) Экспорт
	Возврат БезСлужебного(Однострочно(Значение));
КонецФункции

// Заменяет вхождения секрета в тексте на маску. Нужна там, где диагностика транспорта
// собрана чужой библиотекой и может нести учётные данные (адрес Bot API с токеном).
//
// Параметры:
//  Текст - Строка - диагностическое сообщение.
//  Секрет - Строка - значение, которого в сообщении быть не должно.
//
// Возвращаемое значение:
//  Строка - текст, в котором секрет заменён на «•••».
//
Функция БезСекрета(Знач Текст, Знач Секрет) Экспорт

	Значение = Строка(Текст);
	Скрываемое = СокрЛП(Строка(Секрет));
	// короткое значение маскировать нечем: его «вхождения» — это случайные совпадения
	Если СтрДлина(Скрываемое) < 6 Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат СтрЗаменить(Значение, Скрываемое, Маска());

КонецФункции

// Маска, которой заменяется секрет в диагностике.
//
// Возвращаемое значение:
//  Строка.
//
Функция Маска() Экспорт
	Возврат "•••";
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьЧасть(Части, Знач Значение)

	Текст = СокрЛП(Строка(Значение));
	Если ЗначениеЗаполнено(Текст) Тогда
		Части.Добавить(Текст);
	КонецЕсли;

КонецПроцедуры

// Дословный текст корневой причины — но только если краткое представление его ещё
// не назвало: сбой без обёрток иначе печатался бы дважды.
Функция ДословнаяПричина(Знач Части, Знач Корень)

	Исходный = СокрЛП(Однострочно(Корень.Сообщение()));

	Если НЕ ЗначениеЗаполнено(Исходный) ИЛИ СтрНайти(СтрСоединить(Части, " "), Исходный) > 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат "← " + Исходный;

КонецФункции

// Место возникновения корневой причины: модуль и строка чужой библиотеки или платформы.
Функция МестоВозникновения(Знач Корень)

	Где = Корень.МестоСоздания();
	Если НЕ ЗначениеЗаполнено(Где.ИмяМодуля) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("[%1:%2]", Где.ИмяМодуля, Формат(Где.НомерСтроки, "ЧГ=0"));

КонецФункции

#КонецОбласти
