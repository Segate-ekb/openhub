// Секрет, заданный значением либо файлом (Docker и Kubernetes монтируют секреты файлами):
// значение сильнее файла, у содержимого файла снимаются края.

Перем Лог;

// Секрет по прямому значению и пути к файлу.
//
// Параметры:
//  Прямое - Строка - секрет, заданный значением; пустой — не задан.
//  ПутьКФайлу - Строка - путь к файлу секрета; пустой — не задан.
//  ИмяПути - Строка - как назвать путь в предупреждении, если файла нет
//            (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Строка - секрет; пустая строка, если не задан ни он, ни существующий файл.
//
Функция Секрет(Знач Прямое, Знач ПутьКФайлу, Знач ИмяПути = "") Экспорт

	Если ЗначениеЗаполнено(Прямое) Тогда
		Возврат СокрЛП(Строка(Прямое));
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Возврат "";
	КонецЕсли;

	Файл = Новый Файл(Строка(ПутьКФайлу));
	Если НЕ (Файл.Существует() И Файл.ЭтоФайл()) Тогда
		Если Лог <> Неопределено Тогда
			Лог.Предупреждение("Файл секрета %1 не найден: %2", ИмяПути, ПутьКФайлу);
		КонецЕсли;
		Возврат "";
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();

	// файл-секрет обычно кончается переводом строки
	Возврат СокрЛП(Строка(Содержимое));

КонецФункции

// Параметры:
//  _Лог - Лог - куда назвать путь к несуществующему файлу; лог передаёт создатель
//         (необязательный, по умолчанию Неопределено — промолчать).
//
Процедура ПриСозданииОбъекта(Знач _Лог = Неопределено) Экспорт
	Лог = _Лог;
КонецПроцедуры
