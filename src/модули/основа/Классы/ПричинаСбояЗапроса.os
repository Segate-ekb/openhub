// Чем хаб отвечает на сбой, до которого не дотянулся ни один обработчик: машинный код
// отказа, HTTP-статус и срок, через который посетителя зовут вернуться. Один отказ
// узнаётся отдельно — недоступная база: она не вина запроса и не вина посетителя,
// поэтому отвечается 503 с Retry-After, а не общей пятисоткой.
//
// Класс говорит на двух языках, как ТекстОшибки. Имея ИнформациюОбОшибке, зовут «сбой
// объектом»: там на руках машинный код и вся цепочка причин. Имея одну строку
// ОписаниеОшибки() — «сбой строкой»: там от цепочки остался текст, и приметы ниже
// оказываются единственной сетью.
//
// База отваливается двумя разными способами, и приметы у них разные. Хаб не смог
// подключиться — об этом говорит драйвер («failed to connect»). База упала ПОД работающим
// хабом — в пуле остаются мёртвые соединения, и ADO.NET отвечает про состояние соединения
// («Connection is not open»), а не про подключение. Второй случай и есть жалоба владельца.
//
// Приметы двухслойные. Безусловные встречаются только у слоя данных и решают сами;
// общие приметы разрыва («connection refused») звучат так же у похода в апстрим, в S3
// и в почту, и засчитываются лишь вместе с меткой базы.

Перем Ошибки; // ТекстОшибки (основа) — машинный код и причина цепочкой

#Область СбойОбъектом

// Чем ответить на пойманный сбой.
//
// Параметры:
//  Инфо - ИнформацияОбОшибке - результат ИнформацияОбОшибке() вызывающего.
//
// Возвращаемое значение:
//  Структура - Код (машинный код отказа), Статус (Число, код состояния HTTP),
//              ПовторитьЧерез (Число, секунды для Retry-After; ноль — заголовка нет).
//
Функция ПоСбою(Знач Инфо) Экспорт
	Возврат Ответ(ЭтоОтказБазы(Инфо));
КонецФункции

// Отказала ли база: сначала машинный код сбоя, потом приметы в цепочке причин.
// Цепочка ценнее голого текста: вместе с ней приезжает место возникновения корневой
// причины, а модуль entity в нём — самая надёжная метка базы из существующих.
//
// Параметры:
//  Инфо - ИнформацияОбОшибке - результат ИнформацияОбОшибке() вызывающего.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоОтказБазы(Знач Инфо) Экспорт

	Если КодыОтказаБазы().Найти(Ошибки.МашинныйКод(Инфо)) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЭтоОтказБазыПоТексту(Ошибки.Причина(Инфо));

КонецФункции

#КонецОбласти

#Область СбойСтрокой

// Чем ответить на сбой, от которого остался один текст: так приходит пятисотка,
// собранная самим winow, — исключение он уже проглотил.
//
// Параметры:
//  Текст - Строка - описание сбоя, как его сохранил перехватчик.
//
// Возвращаемое значение:
//  Структура - см. ПоСбою.
//
Функция ПоТексту(Знач Текст) Экспорт
	Возврат Ответ(ЭтоОтказБазыПоТексту(Текст));
КонецФункции

// Говорит ли текст об отказе базы.
//
// Параметры:
//  Текст - Строка - описание сбоя или цепочка причин.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоОтказБазыПоТексту(Знач Текст) Экспорт

	Значение = НРег(Строка(Текст));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ЕстьЛюбая(Значение, ПриметыОтказаБазы()) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЕстьЛюбая(Значение, МеткиБазы())
		И ЕстьЛюбая(Значение, ПриметыОборванногоСоединения());

КонецФункции

#КонецОбласти

#Область Коды

// Машинный код недоступной базы — тот, что уходит в конверт ошибки API и по которому
// страница выбирает фразу.
//
// Возвращаемое значение:
//  Строка.
//
Функция КодОтказаБазы() Экспорт
	Возврат "database.unavailable";
КонецФункции

Функция КодОбщегоСбоя()
	Возврат "server.error";
КонецФункции

// Машинные коды сбоя, которые называют отказ базы сами: такой сбой разбирать текстом
// не нужно.
Функция КодыОтказаБазы()

	Результат = Новый Массив();
	Результат.Добавить(КодОтказаБазы());
	Возврат Результат;

КонецФункции

// Через сколько секунд звать посетителя обратно после отказа базы. Совпадает с фразой
// «попробуйте через минуту»: разъехавшись, они сказали бы человеку и машине разное.
Функция ПовторитьЧерез()
	Возврат 60;
КонецФункции

#КонецОбласти

#Область Приметы

// Приметы, встречающиеся только у слоя данных: каждая решает об отказе базы сама.
Функция ПриметыОтказаБазы()

	Результат = Новый Массив();

	// entity, ПулСоединенийСБД: ожидание в очереди исчерпано и пул остановлен
	Результат.Добавить("не дождался свободного соединения");
	Результат.Добавить("пул соединений закрыт");

	// ADO.NET: база упала ПОД хабом, и в пуле осталось мёртвое соединение. Все три
	// сообщения называют СОЕДИНЕНИЕ, а своих ADO.NET-соединений хаб нигде больше
	// не держит — наружу он ходит по HTTP
	Результат.Добавить("connection is not open");
	Результат.Добавить("the connection is already in state");
	Результат.Добавить("connection is disposed");

	// драйверы: своё имя в тексте бывает только у обращения к базе
	Результат.Добавить("npgsql");
	Результат.Добавить("sqlite error");

	// SQLite: файл базы занят либо недоступен
	Результат.Добавить("database is locked");
	Результат.Добавить("unable to open database");

	// PostgreSQL: сервер поднимается, останавливается либо отвергает подключение
	Результат.Добавить("the database system is");
	Результат.Добавить("too many clients already");
	Результат.Добавить("no pg_hba.conf entry");

	// пул драйвера исчерпан
	Результат.Добавить("connection pool has been exhausted");

	Возврат Результат;

КонецФункции

// Приметы оборванного или неустановленного соединения. Одни они ни о чём не говорят:
// так же звучит отказ похода в апстрим, в S3 и в почтовый сервер.
Функция ПриметыОборванногоСоединения()

	Результат = Новый Массив();
	Результат.Добавить("failed to connect");
	Результат.Добавить("connection refused");
	Результат.Добавить("no connection could be made");
	Результат.Добавить("connection is closed");
	Результат.Добавить("connection is broken");
	Результат.Добавить("connection reset");
	Результат.Добавить("broken pipe");
	Результат.Добавить("timeout expired");
	// самое общее исключение .NET: так же звучат закрытый поток тела запроса,
	// освобождённый HttpClient и отменённый CancellationTokenSource
	Результат.Добавить("cannot access a disposed object");
	Результат.Добавить("соединение отклонено");
	Результат.Добавить("соединение сброшено");
	Результат.Добавить("соединение прервано");
	Возврат Результат;

КонецФункции

// Метки базы: по ним общая примета разрыва становится отказом именно базы. Модули entity
// приезжают местом возникновения корневой причины — и в цепочке ТекстОшибки.Причина,
// и в служебной обёртке «{Модуль … / Error in line: N}» голого ОписанияОшибки().
//
// «КоннекторPostgreSQL» и «КоннекторSQLite» отдельными метками не заводятся: их имена
// целиком содержат «postgres» и «sqlite», и такая метка была бы мёртвой.
Функция МеткиБазы()

	Результат = Новый Массив();
	Результат.Добавить("абстрактныйконнекторsql");
	Результат.Добавить("пулсоединенийсбд");
	Результат.Добавить("пул соединений");
	Результат.Добавить("postgres");
	Результат.Добавить("sqlite");
	Результат.Добавить("субд");
	Результат.Добавить(":5432");
	Результат.Добавить("port=5432");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Ответ(Знач ОтказБазы)

	Если ОтказБазы Тогда
		Возврат Новый Структура("Код, Статус, ПовторитьЧерез",
			КодОтказаБазы(), 503, ПовторитьЧерез());
	КонецЕсли;

	Возврат Новый Структура("Код, Статус, ПовторитьЧерез", КодОбщегоСбоя(), 500, 0);

КонецФункции

Функция ЕстьЛюбая(Знач Значение, Знач Приметы)

	Для Каждого Примета Из Приметы Цикл
		Если СтрНайти(Значение, Примета) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено) Экспорт
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
КонецПроцедуры
