// Значение в текст JSON. Форма записи выбирается назначением: в протокол и в хранимый
// снимок — одна строка, в журнал и на глаза человеку — с переносами.

#Область ПубличныйИнтерфейс

// JSON без переносов строк и отступов.
//
// Параметры:
//  Значение - Структура, Соответствие, Массив - что сериализовать.
//
// Возвращаемое значение:
//  Строка - JSON в одну строку.
//
Функция ОднойСтрокой(Знач Значение) Экспорт

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, ""));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

// JSON с переносами строк, как их расставляет платформа.
//
// Параметры:
//  Значение - Структура, Соответствие, Массив - что сериализовать.
//
// Возвращаемое значение:
//  Строка - JSON, разбитый на строки по одному полю.
//
Функция СПереносами(Знач Значение) Экспорт

	// без аргумента и с `Новый ПараметрыЗаписиJSON()` писатель ведёт себя ПО-РАЗНОМУ:
	// пустой конструктор параметров означает «в одну строку», а его отсутствие — переносы
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

// JSON с переносами строк и отступом-табуляцией: так его читает человек, которому
// текст показан образцом конфигурации для копирования.
//
// Параметры:
//  Значение - Структура, Соответствие, Массив - что сериализовать.
//
// Возвращаемое значение:
//  Строка - JSON с отступами.
//
Функция СОтступами(Знач Значение) Экспорт

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
