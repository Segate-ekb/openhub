// Одна форма записи IP-адреса на весь хаб: «::ffff:192.0.2.1», «192.0.2.1», «2001:DB8::1»
// и «2001:db8:0:0:0:0:0:1» — один и тот же адрес, а не четыре. Разбор и сравнение —
// библиотека ip; здесь только правило «какую запись хаб считает канонической».

#Использовать ip

#Область ПубличныйИнтерфейс

// Адрес из любой его записи. Отображённый IPv4 разворачивается в IPv4: именно так
// веб-сервер на двойном стеке называет клиента IPv4.
//
// Параметры:
//  Запись - Строка - адрес в любой записи.
//
// Возвращаемое значение:
//  IPАдрес - адрес; Неопределено — запись адресом не является.
//
Функция Адрес(Знач Запись) Экспорт

	Текст = Текстом(Запись);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Разобранный = РазборIP.ПопытатьсяРазобратьАдрес(Текст);
	Если Разобранный = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ?(Разобранный.ЭтоIPv6СОтображеннымIPv4(), Разобранный.IPv4(), Разобранный);

КонецФункции

// Каноническая строка адреса: строчные буквы, сжатый IPv6, развёрнутый отображённый IPv4.
//
// Параметры:
//  Запись - Строка - адрес в любой записи.
//
// Возвращаемое значение:
//  Строка - канон адреса; пустая строка — запись адресом не является.
//
Функция Строкой(Знач Запись) Экспорт

	Разобранный = Адрес(Запись);
	Возврат ?(Разобранный = Неопределено, "", Разобранный.ВСтроку());

КонецФункции

// Сеть из записи CIDR. Неканоническая база принимается и обнуляется («10.1.2.3/8» —
// это «10.0.0.0/8»): оператор пишет сеть от знакомого ему адреса, а не от нулей.
//
// Параметры:
//  Запись - Строка - сеть в записи CIDR.
//
// Возвращаемое значение:
//  IPПрефикс - сеть; Неопределено — запись сетью не является.
//
Функция Сеть(Знач Запись) Экспорт

	Текст = Текстом(Запись);
	Черта = Найти(Текст, "/");
	Если Черта = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Основание = Адрес(Лев(Текст, Черта - 1));
	Если Основание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Длина = Число(СокрЛП(Сред(Текст, Черта + 1)));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Попытка
		Возврат Основание.СоздатьПрефикс(Длина);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Входит ли адрес в сеть. Семейства сверяются после разворота отображённого IPv4,
// иначе «::ffff:10.1.2.3» не попал бы в «10.0.0.0/8».
//
// Параметры:
//  Диапазон - IPПрефикс - сеть.
//  Запись - Строка - адрес в любой записи.
//
// Возвращаемое значение:
//  Булево - входит ли адрес в сеть.
//
Функция ВСети(Знач Диапазон, Знач Запись) Экспорт

	Проверяемый = Адрес(Запись);
	Возврат Диапазон <> Неопределено И Проверяемый <> Неопределено
		И Диапазон.Содержит(Проверяемый);

КонецФункции

// Разбор списка сетей через запятую — один разбор на валидатор настройки и на того,
// кто списком пользуется: две копии правила разошлись бы на первой же опечатке.
//
// Параметры:
//  Запись - Строка - сети в записи CIDR через запятую; пустая строка — пустой список.
//
// Возвращаемое значение:
//  Структура - Сети (Массив из IPПрефикс — годные записи), Негодная (Строка — первая
//              запись, которую не удалось прочитать; пустая строка, если все годны).
//
Функция Список(Знач Запись) Экспорт

	Результат = Новый Структура("Сети, Негодная", Новый Массив(), "");

	Для Каждого Часть Из СтрРазделить(Текстом(Запись), ",", Ложь) Цикл
		Кусок = СокрЛП(Часть);
		Если НЕ ЗначениеЗаполнено(Кусок) Тогда
			Продолжить;
		КонецЕсли;
		Разобранная = Сеть(Кусок);
		Если Разобранная = Неопределено Тогда
			Результат.Негодная = Кусок;
			Возврат Результат;
		КонецЕсли;
		Результат.Сети.Добавить(Разобранная);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Текстом(Знач Значение)
	Возврат СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
