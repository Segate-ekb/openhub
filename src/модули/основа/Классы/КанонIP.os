// Единственное место, где строка становится IP-адресом или сетью. Здесь же правило
// «какую запись хаб считает канонической»: «::ffff:192.0.2.1», «192.0.2.1», «2001:DB8::1»
// и «2001:db8:0:0:0:0:0:1» — один и тот же адрес, а не четыре. Разбор, сравнение
// и вхождение в сеть — библиотека ip; политику своих сетей строит поверх этого `сеть/СвояСеть`.

#Использовать ip

Перем ПрефиксNAT64;
Перем ПрефиксСовместимый;

#Область ПубличныйИнтерфейс

// Адрес, каким он записан: строгий разбор без приведения. Нужен тому, кто судит запись
// как она есть, — политика своей сети называет вложенный IPv4 отдельно от обёртки.
//
// Параметры:
//  Запись - Строка - адрес в любой записи.
//
// Возвращаемое значение:
//  IPАдрес - адрес; Неопределено — запись адресом не является.
//
Функция Разобрать(Знач Запись) Экспорт

	Текст = Текстом(Запись);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат РазборIP.ПопытатьсяРазобратьАдрес(Текст);

КонецФункции

// Адрес в канонической форме хаба. Отображённый IPv4 разворачивается в IPv4: именно так
// веб-сервер на двойном стеке называет клиента IPv4. Совместимый и NAT64 не разворачиваются
// вовсе — это перевод адреса в другую сеть, а не вторая запись того же адреса.
//
// Параметры:
//  Запись - Строка - адрес в любой записи.
//
// Возвращаемое значение:
//  IPАдрес - адрес; Неопределено — запись адресом не является.
//
Функция Адрес(Знач Запись) Экспорт

	Разобранный = Разобрать(Запись);
	Если Разобранный = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ?(Разобранный.ЭтоIPv6СОтображеннымIPv4(), Разобранный.IPv4(), Разобранный);

КонецФункции

// IPv4, завёрнутый в IPv6: отображённый ::ffff:a.b.c.d, совместимый ::a.b.c.d и NAT64.
//
// Параметры:
//  Адрес - IPАдрес - разобранный адрес.
//
// Возвращаемое значение:
//  IPАдрес - вложенный IPv4; Неопределено — адрес IPv4 не заворачивает.
//
Функция ВложенныйIPv4(Знач Адрес) Экспорт

	Если Адрес = Неопределено ИЛИ Адрес.ЭтоIPv4() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Адрес.ЭтоIPv6СОтображеннымIPv4() Тогда
		Возврат Адрес.IPv4();
	КонецЕсли;

	// «::» и «::1» лежат в совместимом «::/96», но IPv4 не заворачивают: незаданный адрес
	// и петля значат сами себя, а не 0.0.0.0 и 0.0.0.1. Спрашивающий вправе звать этот метод
	// первым, и порядок его проверок нас защищать не обязан
	Если Адрес.ЭтоНезаданный() ИЛИ Адрес.ЭтоПетлевой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ПрефиксNAT64.Содержит(Адрес) ИЛИ ПрефиксСовместимый.Содержит(Адрес) Тогда
		Возврат ХвостовойIPv4(Адрес);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Запись адреса без обрамляющих скобок IPv6-литерала и без порта: «192.0.2.1:8080»
// и «[2001:db8::1]:4711» — записи одного адреса.
//
// Параметры:
//  Запись - Строка - адрес, возможно со скобками и портом.
//
// Возвращаемое значение:
//  Строка - запись без скобок и порта.
//
Функция БезСкобокИПорта(Знач Запись) Экспорт

	Текст = Текстом(Запись);

	Если Лев(Текст, 1) = "[" Тогда
		Скобка = Найти(Текст, "]");
		Возврат ?(Скобка = 0, Текст, Сред(Текст, 2, Скобка - 2));
	КонецЕсли;

	// двоеточий внутри голого IPv6 много, и по одному только двоеточию порт не отличить
	Двоеточие = Найти(Текст, ":");
	Если Двоеточие > 0 И Найти(Сред(Текст, Двоеточие + 1), ":") = 0 Тогда
		Возврат Лев(Текст, Двоеточие - 1);
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Каноническая строка адреса: строчные буквы, сжатый IPv6, развёрнутый отображённый IPv4.
//
// Параметры:
//  Запись - Строка - адрес в любой записи.
//
// Возвращаемое значение:
//  Строка - канон адреса; пустая строка — запись адресом не является.
//
Функция Строкой(Знач Запись) Экспорт

	Разобранный = Адрес(Запись);
	Возврат ?(Разобранный = Неопределено, "", Разобранный.ВСтроку());

КонецФункции

// Сеть из записи CIDR. Неканоническая база принимается и обнуляется («10.1.2.3/8» —
// это «10.0.0.0/8»): оператор пишет сеть от знакомого ему адреса, а не от нулей.
//
// Параметры:
//  Запись - Строка - сеть в записи CIDR.
//
// Возвращаемое значение:
//  IPПрефикс - сеть; Неопределено — запись сетью не является.
//
Функция Сеть(Знач Запись) Экспорт

	Текст = Текстом(Запись);
	Черта = Найти(Текст, "/");
	Если Черта = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Основание = Адрес(Лев(Текст, Черта - 1));
	Если Основание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Длина = Число(СокрЛП(Сред(Текст, Черта + 1)));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Попытка
		Возврат Основание.СоздатьПрефикс(Длина);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Входит ли адрес в сеть. Семейства сверяются после разворота отображённого IPv4,
// иначе «::ffff:10.1.2.3» не попал бы в «10.0.0.0/8».
//
// Параметры:
//  Диапазон - IPПрефикс - сеть.
//  Запись - Строка - адрес в любой записи.
//
// Возвращаемое значение:
//  Булево - входит ли адрес в сеть.
//
Функция ВСети(Знач Диапазон, Знач Запись) Экспорт

	Проверяемый = Адрес(Запись);
	Возврат Диапазон <> Неопределено И Проверяемый <> Неопределено
		И Диапазон.Содержит(Проверяемый);

КонецФункции

// Разбор списка сетей через запятую — один разбор на валидатор настройки и на того,
// кто списком пользуется: две копии правила разошлись бы на первой же опечатке.
//
// Параметры:
//  Запись - Строка - сети в записи CIDR через запятую; пустая строка — пустой список.
//
// Возвращаемое значение:
//  Структура - Сети (Массив из IPПрефикс — годные записи), Негодная (Строка — первая
//              запись, которую не удалось прочитать; пустая строка, если все годны).
//
Функция Список(Знач Запись) Экспорт

	Результат = Новый Структура("Сети, Негодная", Новый Массив(), "");

	Для Каждого Часть Из СтрРазделить(Текстом(Запись), ",", Ложь) Цикл
		Кусок = СокрЛП(Часть);
		Если НЕ ЗначениеЗаполнено(Кусок) Тогда
			Продолжить;
		КонецЕсли;
		Разобранная = Сеть(Кусок);
		Если Разобранная = Неопределено Тогда
			Результат.Негодная = Кусок;
			Возврат Результат;
		КонецЕсли;
		Результат.Сети.Добавить(Разобранная);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ХвостовойIPv4(Знач Адрес)

	Октеты = Адрес.Октеты();
	Четыре = Новый Массив();
	Для Индекс = 12 По 15 Цикл
		Четыре.Добавить(Октеты[Индекс]);
	КонецЦикла;

	Возврат Новый IPАдрес(Четыре);

КонецФункции

Функция Текстом(Знач Значение)
	Возврат СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт

	ПрефиксNAT64 = Новый IPПрефикс("64:ff9b::/96");
	ПрефиксСовместимый = Новый IPПрефикс("::/96");

КонецПроцедуры
