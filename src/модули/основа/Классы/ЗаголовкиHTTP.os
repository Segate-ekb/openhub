// Чтение заголовка HTTP по имени без учёта регистра: и winow, и клиент отдают коллекцию
// такой, какой её прислала другая сторона, поэтому точным ключом искать нечего.

// Значение заголовка как есть.
//
// Параметры:
//  Заголовки - Соответствие, Неопределено - заголовки запроса либо ответа.
//  Имя - Строка - имя заголовка; регистр не значим.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - значение заголовка либо Неопределено, если его нет.
//
Функция Значение(Знач Заголовки, Знач Имя) Экспорт

	Если Заголовки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИскомыйКлюч = ВРег(Имя);
	Для Каждого КиЗ Из Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = ИскомыйКлюч Тогда
			Возврат КиЗ.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Значение заголовка строкой — там, где отсутствующий заголовок и пустой равнозначны.
//
// Параметры:
//  Заголовки - Соответствие, Неопределено - заголовки запроса либо ответа.
//  Имя - Строка - имя заголовка; регистр не значим.
//
// Возвращаемое значение:
//  Строка - значение заголовка либо пустая строка.
//
Функция Текст(Знач Заголовки, Знач Имя) Экспорт
	Найденное = Значение(Заголовки, Имя);
	Возврат ?(Найденное = Неопределено, "", Строка(Найденное));
КонецФункции

// Ключ заголовка в том написании, в каком он лежит в коллекции. Нужен тому, кто
// заголовок ПРАВИТ: Соответствие различает регистр, и запись по «Cache-Control» рядом
// с чужим «cache-control» дала бы в ответе два заголовка вместо одного.
//
// Параметры:
//  Заголовки - Соответствие, Неопределено - заголовки запроса либо ответа.
//  Имя - Строка - имя заголовка; регистр не значим.
//
// Возвращаемое значение:
//  Строка - ключ как он записан; само Имя, если такого заголовка нет.
//
Функция КлючПоИмени(Знач Заголовки, Знач Имя) Экспорт

	Если Заголовки = Неопределено Тогда
		Возврат Имя;
	КонецЕсли;

	ИскомыйКлюч = ВРег(Имя);
	Для Каждого КиЗ Из Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = ИскомыйКлюч Тогда
			Возврат КиЗ.Ключ;
		КонецЕсли;
	КонецЦикла;

	Возврат Имя;

КонецФункции

// Копия заголовков без названного заголовка, в каком бы регистре он ни был записан.
//
// Параметры:
//  Заголовки - Соответствие, Неопределено - исходные заголовки.
//  Имя - Строка - имя снимаемого заголовка; регистр не значим.
//
// Возвращаемое значение:
//  Соответствие - копия без этого заголовка.
//
Функция Без(Знач Заголовки, Знач Имя) Экспорт

	Результат = Новый Соответствие();
	Если Заголовки = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ИскомыйКлюч = ВРег(Имя);
	Для Каждого КиЗ Из Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) <> ИскомыйКлюч Тогда
			Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
