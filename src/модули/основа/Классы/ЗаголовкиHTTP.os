// Чтение заголовка HTTP по имени без учёта регистра: и winow, и клиент отдают коллекцию
// такой, какой её прислала другая сторона, поэтому точным ключом искать нечего.

// Значение заголовка как есть.
//
// Параметры:
//  Заголовки - Соответствие, Неопределено - заголовки запроса либо ответа.
//  Имя - Строка - имя заголовка; регистр не значим.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - значение заголовка либо Неопределено, если его нет.
//
Функция Значение(Знач Заголовки, Знач Имя) Экспорт

	Если Заголовки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИскомыйКлюч = ВРег(Имя);
	Для Каждого КиЗ Из Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = ИскомыйКлюч Тогда
			Возврат КиЗ.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Значение заголовка строкой — там, где отсутствующий заголовок и пустой равнозначны.
//
// Параметры:
//  Заголовки - Соответствие, Неопределено - заголовки запроса либо ответа.
//  Имя - Строка - имя заголовка; регистр не значим.
//
// Возвращаемое значение:
//  Строка - значение заголовка либо пустая строка.
//
Функция Текст(Знач Заголовки, Знач Имя) Экспорт
	Найденное = Значение(Заголовки, Имя);
	Возврат ?(Найденное = Неопределено, "", Строка(Найденное));
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
