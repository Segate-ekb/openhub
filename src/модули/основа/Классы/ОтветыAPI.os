// HTTP-ответы машинных дверей хаба: единый JSON-формат ошибок
// {error:{code,message,details}} и разбор тела из json / x-www-form-urlencoded.
// Зовут отсюда все двери — API, вход, статика, пробы, — поэтому класс живёт в основе.

#Использовать url

Перем Заголовки;     // ЗаголовкиHTTP (основа)
Перем ЧтениеПолей;   // ЧтениеПолей (основа)
Перем Тексты;        // ТекстJSON (основа) — одно написание JSON
Перем Ошибки;        // ТекстОшибки (основа) — причина строкой журнала и полный отчёт
&Лог
Перем Лог;

// Отправляет JSON-ответ, выставляя Content-Type и Content-Length.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//  Код - Число - HTTP-статус.
//  Данные - Структура, Соответствие - тело ответа.
//
Процедура JSON(Ответ, Знач Код, Знач Данные) Экспорт

	Тело = Тексты.СПереносами(Данные);

	Ответ.УстановитьСостояние(Код);
	Ответ.Заголовки["Content-Type"] = "application/json; charset=utf-8";
	Ответ.Заголовки["Content-Length"] = Формат(ПолучитьДвоичныеДанныеИзСтроки(Тело).Размер(), "ЧГ=0; ЧН=0");
	Ответ.ТелоТекст = Тело;

КонецПроцедуры

// Отправляет ошибку в едином формате {error:{code,message,details}}. Подробностей нет —
// поля details нет вовсе: клиент отличает «не сообщили» от «сообщили пустое».
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//  Код - Число - HTTP-статус.
//  КодОшибки - Строка - машиночитаемый код ошибки.
//  Сообщение - Строка - человекочитаемое сообщение.
//  Подробности - Структура, Соответствие, Неопределено - поля отказа: что за предел,
//                какое имя, какой машинный код (необязательный, по умолчанию
//                Неопределено — поля details в ответе не будет).
//
Процедура Ошибка(Ответ, Знач Код, Знач КодОшибки, Знач Сообщение,
	Знач Подробности = Неопределено) Экспорт

	Ошибка = Новый Структура();
	Ошибка.Вставить("code", КодОшибки);
	Ошибка.Вставить("message", Сообщение);
	Если ЕстьПодробности(Подробности) Тогда
		Ошибка.Вставить("details", Подробности);
	КонецЕсли;
	Обёртка = Новый Структура();
	Обёртка.Вставить("error", Ошибка);
	JSON(Ответ, Код, Обёртка);

КонецПроцедуры

// Отвечает на пойманное исключение: конверт наружу и отчёт в журнал одним гейтом.
// Наружу уходит формулировка вызывающего — текст исключения несёт пользовательский ввод
// и внутренности хаба, и в ответе ему не место. В журнал уходит причина строкой, а полный
// отчёт с цепочкой причин — только когда отладка включена: он стои́т разбора цепочки.
// Уровень выбирает статус: 5xx — поломка хаба, всё остальное — непринятый ввод.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//  Код - Число - HTTP-статус.
//  КодОшибки - Строка - машиночитаемый код ошибки.
//  Сообщение - Строка - человекочитаемое сообщение.
//  Инфо - ИнформацияОбОшибке - результат ИнформацияОбОшибке() вызывающего: достоверен
//         он только в кадре обработчика.
//  Подробности - Структура, Соответствие, Неопределено - поля отказа (необязательный,
//                по умолчанию Неопределено — поля details в ответе не будет).
//
Процедура Сбой(Ответ, Знач Код, Знач КодОшибки, Знач Сообщение, Знач Инфо,
	Знач Подробности = Неопределено) Экспорт

	ЗаписатьВЖурнал(Код, КодОшибки, Инфо);
	Ошибка(Ответ, Код, КодОшибки, Сообщение, Подробности);

КонецПроцедуры

// Уровень отчёта: поломка хаба — ОШИБКА, непринятый ввод — ОТЛАДКА.
Процедура ЗаписатьВЖурнал(Знач Код, Знач КодОшибки, Знач Инфо)

	Если Лог = Неопределено ИЛИ Инфо = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Код >= 500 Тогда
		Лог.Ошибка("API ""%1"": %2", КодОшибки, Ошибки.Причина(Инфо));
	Иначе
		Лог.Отладка("API ""%1"": %2", КодОшибки, Ошибки.Причина(Инфо));
	КонецЕсли;

	// отчёт стои́т разбора цепочки: собираем его только тогда, когда отладку включили
	Если Лог.Уровень() <= УровниЛога.Отладка Тогда
		Лог.Отладка("API ""%1"" целиком:%2%3", КодОшибки, Символы.ПС, Ошибки.ПодробныйОтчёт(Инфо));
	КонецЕсли;

КонецПроцедуры

// Пустой объект подробностей — это отсутствие подробностей, а не поле с нулём полей.
Функция ЕстьПодробности(Знач Подробности)

	Если Подробности = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Подробности) = Тип("Структура") ИЛИ ТипЗнч(Подробности) = Тип("Соответствие") Тогда
		Возврат Подробности.Количество() > 0;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Разбирает тело запроса в Соответствие полей (JSON-объект либо form-urlencoded).
//
// Параметры:
//  ТелоЗапроса - Строка - сырое тело запроса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса (Content-Type).
//
// Возвращаемое значение:
//  Соответствие - поля тела; пустое, если тело пустое или JSON некорректен.
//
Функция РазобратьТело(Знач ТелоЗапроса, Знач ЗаголовкиЗапроса) Экспорт

	Результат = Новый Соответствие();
	Если НЕ ЗначениеЗаполнено(ТелоЗапроса) Тогда
		Возврат Результат;
	КонецЕсли;

	ТипКонтента = НРег(Заголовки.Текст(ЗаголовкиЗапроса, "Content-Type"));

	Если СтрНайти(ТипКонтента, "application/json") > 0 Тогда
		Попытка
			Чтение = Новый ЧтениеJSON();
			Чтение.УстановитьСтроку(ТелоЗапроса);
			Разобрано = ПрочитатьJSON(Чтение, Истина);
			Чтение.Закрыть();
			Если ТипЗнч(Разобрано) = Тип("Соответствие") Тогда
				Возврат Разобрано;
			КонецЕсли;
		Исключение
			Возврат Результат;
		КонецПопытки;
		Возврат Результат;
	КонецЕсли;

	// x-www-form-urlencoded (и как fallback) — теми же правилами, что и форма экрана:
	// «+» это пробел, «=» внутри значения — часть значения, повтор имени берётся первым
	Для Каждого Пара Из Новый ПараметрыЗапросаURL(Строка(ТелоЗапроса)).ВМассив() Цикл
		Если ЗначениеЗаполнено(Пара.Имя) И Результат.Получить(Пара.Имя) = Неопределено Тогда
			Результат.Вставить(Пара.Имя, Пара.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Строковое значение поля тела.
//
// Параметры:
//  Тело - Соответствие - разобранное тело запроса.
//  Имя - Строка - имя поля.
//  ПоУмолчанию - Строка - значение при отсутствии поля (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Строка.
//
Функция Поле(Знач Тело, Знач Имя, Знач ПоУмолчанию = "") Экспорт
	Значение = ЧтениеПолей.Поле(Тело, Имя, Неопределено);
	Возврат ?(Значение = Неопределено, ПоУмолчанию, Строка(Значение));
КонецФункции

// Значения поля-списка тела: JSON-массив приезжает массивом, одиночное значение читается
// как список из одного — клиенту не обязательно знать, что поле умеет быть набором.
//
// Параметры:
//  Тело - Соответствие - разобранное тело запроса.
//  Имя - Строка - имя поля.
//
// Возвращаемое значение:
//  Массив - элементы как их прислал клиент; пустой, если поля нет.
//
Функция Список(Знач Тело, Знач Имя) Экспорт

	Значение = Тело.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;

	Одиночное = Новый Массив();
	Одиночное.Добавить(Значение);
	Возврат Одиночное;

КонецФункции

// Снимает сессионную куку winow с ответа: без Set-Cookie ответ остаётся кэшируемым.
//
// Параметры:
//  Ответ - Ответ - ответ winow.
//  ПустыеКуки - Куки - заранее подготовленная пустая коллекция кук.
//
Процедура БезСессионнойКуки(Ответ, Знач ПустыеКуки) Экспорт
	Ответ.Куки = ПустыеКуки;
КонецПроцедуры


&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ЗаголовкиHTTP") _Заголовки,
	&Пластилин(Значение = "ЧтениеПолей") _ЧтениеПолей = Неопределено,
	&Пластилин(Значение = "ТекстJSON") _Тексты = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено,
	&Лог _Лог = Неопределено)

	ЧтениеПолей = ?(_ЧтениеПолей = Неопределено, Новый ЧтениеПолей(), _ЧтениеПолей);
	Тексты = ?(_Тексты = Неопределено, Новый ТекстJSON(), _Тексты);
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Заголовки = _Заголовки;

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
