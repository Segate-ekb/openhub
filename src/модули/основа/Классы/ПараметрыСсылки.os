// Параметр запроса, поставленный на адрес: разделитель «?» или «&» выбирать не приходится,
// а значение кодируется процентами — пробел уезжает как «%20», а не как «+».
// Форма «+ вместо пробела» здесь не годится: параметры адреса каркас только раскодирует
// процентами и «+» пробелом не считает, поэтому поиск «два слова» вернулся бы как
// «два+слова».

#Использовать url

// Ставит параметр на адрес, заменяя одноимённые.
//
// Параметры:
//  Адрес - Строка - адрес хаба; может уже нести параметры запроса.
//  Имя - Строка - имя параметра.
//  Значение - Строка - сырое значение, как его набрал человек.
//
// Возвращаемое значение:
//  Строка - адрес с параметром.
//
Функция Установить(Знач Адрес, Знач Имя, Знач Значение) Экспорт
	Возврат СПарой(Адрес, Имя, Значение, Истина);
КонецФункции

// Добавляет параметр на адрес, не трогая одноимённые.
//
// Параметры:
//  Адрес - Строка - адрес хаба; может уже нести параметры запроса.
//  Имя - Строка - имя параметра.
//  Значение - Строка - сырое значение, как его набрал человек.
//
// Возвращаемое значение:
//  Строка - адрес с параметром.
//
Функция Добавить(Знач Адрес, Знач Имя, Знач Значение) Экспорт
	Возврат СПарой(Адрес, Имя, Значение, Ложь);
КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция СПарой(Знач Адрес, Знач Имя, Знач Значение, Знач Заменять)

	Ссылка = РазборURL.ПопытатьсяРазобрать(Строка(Адрес));
	Если Ссылка = Неопределено Тогда
		// адрес инсталляции задаёт администратор, и ссылкой он бывает не всегда; кривая
		// ссылка — не повод отдать человеку пятисотку вместо приглашения
		Возврат Склейкой(Адрес, Имя, Значение);
	КонецЕсли;

	Параметры = Ссылка.ПараметрыЗапроса();
	Если Заменять Тогда
		Параметры.Установить(Строка(Имя), Строка(Значение));
	Иначе
		Параметры.Добавить(Строка(Имя), Строка(Значение));
	КонецЕсли;

	Ссылка.УстановитьКодированнуюСтрокуЗапроса(ПроцентамиБезПлюса(Параметры.ВСтроку()));
	Возврат Ссылка.ВСтроку();

КонецФункции

// Запасной путь для адреса, который ссылкой не является: пара кодируется тем же правилом,
// разделитель выбирается по наличию «?». Прежние параметры разобрать нечем, поэтому пара
// здесь всегда ДОБАВЛЯЕТСЯ — «Установить» на негодном адресе одноимённую не заменит.
Функция Склейкой(Знач Адрес, Знач Имя, Знач Значение)

	Пара = Новый ПараметрыЗапросаURL();
	Пара.Добавить(Строка(Имя), Строка(Значение));
	Разделитель = ?(СтрНайти(Строка(Адрес), "?") > 0, "&", "?");
	Возврат Строка(Адрес) + Разделитель + ПроцентамиБезПлюса(Пара.ВСтроку());

КонецФункции

// В записи x-www-form-urlencoded «+» это ВСЕГДА пробел: свой плюс уехал бы как «%2B».
// Поэтому замена значения не меняет, а прочесть строку теперь может кто угодно, кто
// умеет процентное декодирование.
Функция ПроцентамиБезПлюса(Знач СтрокаЗапроса)
	Возврат СтрЗаменить(СтрокаЗапроса, "+", "%20");
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
