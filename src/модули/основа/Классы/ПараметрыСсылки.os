// Параметр запроса на адресе: разделитель выбирается сам, значение кодируется по RFC 3986
// (пробел — «%20»), прежние параметры читаются как веб-форма.

#Использовать url

// Ставит параметр на адрес, заменяя одноимённые.
//
// Параметры:
//  Адрес - Строка - адрес хаба; может уже нести параметры запроса.
//  Имя - Строка - имя параметра.
//  Значение - Строка - сырое значение, как его набрал человек.
//
// Возвращаемое значение:
//  Строка - адрес с параметром.
//
Функция Установить(Знач Адрес, Знач Имя, Знач Значение) Экспорт
	Возврат СПарой(Адрес, Имя, Значение, Истина);
КонецФункции

// Добавляет параметр на адрес, не трогая одноимённые.
//
// Параметры:
//  Адрес - Строка - адрес хаба; может уже нести параметры запроса.
//  Имя - Строка - имя параметра.
//  Значение - Строка - сырое значение, как его набрал человек.
//
// Возвращаемое значение:
//  Строка - адрес с параметром.
//
Функция Добавить(Знач Адрес, Знач Имя, Знач Значение) Экспорт
	Возврат СПарой(Адрес, Имя, Значение, Ложь);
КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция СПарой(Знач Адрес, Знач Имя, Знач Значение, Знач Заменять)

	Ссылка = РазборURL.ПопытатьсяРазобрать(Строка(Адрес));
	Если Ссылка = Неопределено Тогда
		// адрес инсталляции задаёт администратор, и ссылкой он бывает не всегда
		Возврат Склейкой(Адрес, Имя, Значение);
	КонецЕсли;

	Параметры = Новый ПараметрыЗапросаURL(Ссылка.КодированнаяСтрокаЗапроса(),
		ФорматыПараметровЗапросаURL.ВебФорма());
	Если Заменять Тогда
		Параметры.Установить(Имя, Значение);
	Иначе
		Параметры.Добавить(Имя, Значение);
	КонецЕсли;

	Ссылка.УстановитьКодированнуюСтрокуЗапроса(
		Параметры.ВСтроку(ФорматыПараметровЗапросаURL.RFC3986()));
	Возврат Ссылка.ВСтроку();

КонецФункции

// Пара на адресе, который ссылкой не является: прежние параметры не разобрать, пара всегда добавляется.
Функция Склейкой(Знач Адрес, Знач Имя, Знач Значение)

	Пара = Новый ПараметрыЗапросаURL();
	Пара.Добавить(Имя, Значение);
	Разделитель = ?(СтрНайти(Строка(Адрес), "?") > 0, "&", "?");
	Возврат Строка(Адрес) + Разделитель + Пара.ВСтроку();

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
