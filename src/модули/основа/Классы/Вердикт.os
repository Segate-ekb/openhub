// Один ответ на вопрос «получилось или нет и почему». Флаг всегда зовётся «Успех»,
// а вот «почему» бывает двух разных назначений, и они разведены по полям:
//
//  Причина  - машинный КОД отказа. Его сверяют с константой (`Коды.Просрочена()`,
//             `ПричинаПотолок()`), а не читают словами и не печатают человеку.
//  Сообщение - ТЕКСТ для человека: он едет на экран, в тело ответа и в журнал,
//             и константой не является никогда.
//  Код      - код ответа двери, за которой стоит клиент (opm, REST-API, форма кабинета).
//
// Отсюда три пары конструкторов, и дверь выбирает пару по тому, чем отвечает:
// «Успех/Отказ» — код причины, «УспехСловами/ОтказСловами» — текст без кода ответа,
// «УспехСКодом/ОтказСКодом» — код ответа с текстом. Пара названа парой не для симметрии:
// обе её половины несут ОДИН набор полей, и читатель отказа спрашивает те же имена,
// что читатель удачи, — отсутствующее поле упало бы исключением вместо ответа.
// То же правило распространяется на нагрузку: поле, которое дверь кладёт при удаче,
// она называет и в отказе (пустым), поэтому у производителей нагрузка собирается
// одним помощником на оба ответа.

#Область ПоПричине

// Получилось. Причина пустая: у удачи её нет.
//
// Параметры:
//  Поля - Структура, Неопределено - полезная нагрузка сверх Успех/Причина
//         (необязательный, по умолчанию Неопределено — нагрузки нет).
//
// Возвращаемое значение:
//  Структура - Успех (Истина), Причина ("") и поля нагрузки.
//
Функция Успех(Знач Поля = Неопределено) Экспорт
	Возврат Собрать(Поля, Новый Структура("Успех, Причина", Истина, ""));
КонецФункции

// Не получилось. Причина — машинный код, который вызывающий сверяет с константой,
// а не читает словами.
//
// Параметры:
//  Причина - Строка - код причины отказа.
//  Поля - Структура, Неопределено - полезная нагрузка сверх Успех/Причина
//         (необязательный, по умолчанию Неопределено — нагрузки нет).
//
// Возвращаемое значение:
//  Структура - Успех (Ложь), Причина и поля нагрузки.
//
Функция Отказ(Знач Причина, Знач Поля = Неопределено) Экспорт
	Возврат Собрать(Поля, Новый Структура("Успех, Причина", Ложь, Строка(Причина)));
КонецФункции

#КонецОбласти

#Область Словами

// Получилось, и ответ говорит словами, а не кодом: так отвечают проверки, у которых
// причина отказа пишется человеку целиком (форма адреса, разбор цели доставки).
//
// Параметры:
//  Поля - Структура, Неопределено - полезная нагрузка сверх Успех/Сообщение
//         (необязательный, по умолчанию Неопределено — нагрузки нет).
//
// Возвращаемое значение:
//  Структура - Успех (Истина), Сообщение ("") и поля нагрузки.
//
Функция УспехСловами(Знач Поля = Неопределено) Экспорт
	Возврат Собрать(Поля, Новый Структура("Успех, Сообщение", Истина, ""));
КонецФункции

// Не получилось, и причина написана человеку. Кода ответа у такой двери нет: она
// не отвечает клиенту сама, а докладывает вызывающему.
//
// Параметры:
//  Сообщение - Строка - текст отказа для человека.
//  Поля - Структура, Неопределено - полезная нагрузка сверх Успех/Сообщение
//         (необязательный, по умолчанию Неопределено — нагрузки нет).
//
// Возвращаемое значение:
//  Структура - Успех (Ложь), Сообщение и поля нагрузки.
//
Функция ОтказСловами(Знач Сообщение, Знач Поля = Неопределено) Экспорт
	Возврат Собрать(Поля, Новый Структура("Успех, Сообщение", Ложь, Строка(Сообщение)));
КонецФункции

#КонецОбласти

#Область СКодомОтвета

// Получилось, и ответ несёт код с текстом: так отвечают двери, за которыми стоит клиент
// (opm, REST-API, форма кабинета).
//
// Параметры:
//  Код - Число - код ответа.
//  Сообщение - Строка - текст для человека (необязательный, по умолчанию пустой).
//  Поля - Структура, Неопределено - полезная нагрузка сверх Успех/Код/Сообщение
//         (необязательный, по умолчанию Неопределено — нагрузки нет).
//
// Возвращаемое значение:
//  Структура - Успех (Истина), Код, Сообщение и поля нагрузки.
//
Функция УспехСКодом(Знач Код, Знач Сообщение = "", Знач Поля = Неопределено) Экспорт
	Возврат Собрать(Поля, Новый Структура("Успех, Код, Сообщение", Истина, Код, Сообщение));
КонецФункции

// Не получилось, и ответ несёт код с текстом.
//
// Параметры:
//  Код - Число - код ответа.
//  Сообщение - Строка - текст для человека.
//  Поля - Структура, Неопределено - полезная нагрузка сверх Успех/Код/Сообщение
//         (необязательный, по умолчанию Неопределено — нагрузки нет).
//
// Возвращаемое значение:
//  Структура - Успех (Ложь), Код, Сообщение и поля нагрузки.
//
Функция ОтказСКодом(Знач Код, Знач Сообщение, Знач Поля = Неопределено) Экспорт
	Возврат Собрать(Поля, Новый Структура("Успех, Код, Сообщение", Ложь, Код, Сообщение));
КонецФункции

#КонецОбласти

#Область СвоимСловом

// Нагрузка, поверх которой легли обязательные поля. Нужна тому, кто отвечает не словом
// «Успех», а своим: гвард говорит «Разрешено», и это слово читают контроллеры.
//
// Параметры:
//  Нагрузка - Структура, Неопределено - поля, которые несёт ответ.
//  Обязательные - Структура - поля формы ответа; они сильнее нагрузки.
//
// Возвращаемое значение:
//  Структура.
//
Функция Поверх(Знач Нагрузка, Знач Обязательные) Экспорт
	Возврат Собрать(Нагрузка, Обязательные);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Нагрузка ложится первой, обязательные поля — поверх неё: перебить «Успех» нагрузкой
// нельзя даже нарочно.
Функция Собрать(Знач Нагрузка, Знач Обязательные)

	Ответ = Новый Структура();

	Если ТипЗнч(Нагрузка) = Тип("Структура") Тогда
		Для Каждого КиЗ Из Нагрузка Цикл
			Ответ.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;

	Для Каждого КиЗ Из Обязательные Цикл
		Ответ.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;

	Возврат Ответ;

КонецФункции

#КонецОбласти
