// Список значений через запятую — то, чем хаб хранит наборы в одной колонке: типы событий
// подписки, скоупы токена. Обрамляющие пробелы элемента незначимы, пустые элементы
// в список не попадают. Канонизировать ли регистр — решает спрашивающий.

Перем Канон;   // КанонСтроки (основа)

// Элементы списка.
//
// Параметры:
//  Текст - Произвольный - список через запятую; Неопределено читается как пустой список.
//  Канонизировать - Булево - опускать ли регистр элементов (необязательный,
//                   по умолчанию Истина).
//
// Возвращаемое значение:
//  Массив из Строка - непустые элементы в порядке записи.
//
Функция Разобрать(Знач Текст, Знач Канонизировать = Истина) Экспорт

	Результат = Новый Массив();

	Для Каждого Часть Из СтрРазделить(Строка(?(Текст = Неопределено, "", Текст)), ",", Ложь) Цикл
		Элемент = ?(Канонизировать, Канон.Канон(Часть), СокрЛП(Строка(Часть)));
		Если ЗначениеЗаполнено(Элемент) Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Есть ли значение в списке. Сравнение каноничное: «Read» в колонке и «read» в вопросе —
// одно право.
//
// Параметры:
//  Текст - Произвольный - список через запятую.
//  Значение - Произвольный - искомый элемент.
//
// Возвращаемое значение:
//  Булево.
//
Функция Содержит(Знач Текст, Знач Значение) Экспорт

	Искомое = Канон.Канон(Значение);
	Для Каждого Элемент Из Разобрать(Текст) Цикл
		Если Элемент = Искомое Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
	// канон записи — такой же примитив основы, собирается «Новым» (см. ФормаАдреса)
	Канон = Новый КанонСтроки();
КонецПроцедуры
