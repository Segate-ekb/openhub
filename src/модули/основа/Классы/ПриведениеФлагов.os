// Чтение булева из внешнего значения. Дверей пять, и дверь выбирается по источнику
// значения, а не по вкусу:
//
//  ФлагИстина      - настройки хаба: одно и то же значение приходит из формы, JSON
//                    и окружения вперемешку, поэтому словарь у двери терпимый.
//  ФлагТолькоTrue  - флаги, которые кроме хаба читает чужой каркас (winow,
//                    autumn-opentelemetry): их словарь задан не нами.
//  ФлажокФормы     - поле HTML-формы: отмеченный флажок браузер присылает словом «on».
//  ФлагТрёхзначный - настройки, где «не сказано» отличается и от «да», и от «нет».
//  ФлагОкружения   - переменные окружения: там пишут сверх того английское «yes».
//
// Дефолт стоит в сигнатуре не у каждой двери, и это не недосмотр — у источников разное
// значит пустота. У ФлажокФормы дефолта нет: неотмеченный флажок браузер не присылает
// вовсе, поэтому «поля нет» — это уже готовый ответ «нет». У ФлагОкружения дефолт есть:
// пустая переменная окружения не говорит ничего, а чем её заменить, знает спросившая
// настройка, а не эта дверь. ФлагТрёхзначный дефолта не берёт потому, что сам умеет
// ответить «не сказано» — Неопределено.

// Приводит произвольное значение к булеву. Истиной считаются «истина», «true», «1» и «да»
// в любом регистре; заданный дефолт отдаётся только на ПУСТОМ значении, а непустое
// непонятное — это Ложь: «мусор» не значит «как по умолчанию».
//
// Параметры:
//  Значение - Произвольный - значение, пришедшее снаружи.
//  Дефолт - Булево - что вернуть на пустом значении.
//
// Возвращаемое значение:
//  Булево.
//
Функция ФлагИстина(Знач Значение, Знач Дефолт) Экспорт

	Если Значение = Неопределено Тогда
		Возврат Дефолт;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Написанное = НРег(СокрЛП(Строка(Значение)));
	Если НЕ ЗначениеЗаполнено(Написанное) Тогда
		Возврат Дефолт;
	КонецЕсли;

	Возврат Написанное = "истина" ИЛИ Написанное = "true"
		ИЛИ Написанное = "1" ИЛИ Написанное = "да";

КонецФункции

// Флаг по правилу OpenTelemetry: истиной считается ТОЛЬКО слово «true» в любом регистре.
// Читая иначе, хаб расходился бы с каркасом и телеметрия выходила бы наполовину.
//
// Параметры:
//  Значение - Произвольный - значение детальки, как его отдал configor.
//
// Возвращаемое значение:
//  Булево.
//
Функция ФлагТолькоTrue(Знач Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат НРег(СокрЛП(Строка(Значение))) = "true";

КонецФункции

// Флажок HTML-формы: сверх слов ФлагИстина принимается «on», которым браузер присылает
// отмеченный флажок. ФлагИстина о нём не знает намеренно: настройка хаба, пришедшая
// со словом «on», понятной от этого не становится.
//
// Параметры:
//  Значение - Произвольный - значение поля формы.
//
// Возвращаемое значение:
//  Булево.
//
Функция ФлажокФормы(Знач Значение) Экспорт

	Если НРег(СокрЛП(?(Значение = Неопределено, "", Строка(Значение)))) = "on" Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ФлагИстина(Значение, Ложь);

КонецФункции

// Трёхзначное чтение булева теми же словами: слово истины даёт Истина, слово лжи — Ложь,
// а всё прочее — Неопределено. Невнятное значение настройки объявляется испорченным,
// а не молча гасит функцию. Словами лжи считаются «ложь», «false», «0» и «нет»
// в любом регистре.
//
// Параметры:
//  Значение - Произвольный - значение, пришедшее снаружи.
//
// Возвращаемое значение:
//  Булево, Неопределено - прочитанный флаг либо Неопределено, если слово незнакомо.
//
Функция ФлагТрёхзначный(Знач Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	Написанное = НРег(СокрЛП(Строка(Значение)));
	Если Написанное = "ложь" ИЛИ Написанное = "false"
		ИЛИ Написанное = "0" ИЛИ Написанное = "нет" Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ?(ЗначениеЗаполнено(Написанное) И ФлагИстина(Написанное, Ложь), Истина, Неопределено);

КонецФункции

// Флаг из переменной окружения: к словам ФлагИстина добавлено английское «yes». Его пишут
// в env, и обе двери окружения — конфигурация хранилища и провайдеры входа — принимали
// его прежде, чем у чтения появился единственный владелец; отобрать слово значило бы
// погасить чужую боевую настройку молча.
//
// Параметры:
//  Значение - Произвольный - значение переменной окружения либо детальки.
//  Дефолт - Булево - что вернуть на пустом значении.
//
// Возвращаемое значение:
//  Булево.
//
Функция ФлагОкружения(Знач Значение, Знач Дефолт) Экспорт

	Если ТипЗнч(Значение) <> Тип("Булево")
		И НРег(СокрЛП(Строка(Значение))) = "yes" Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ФлагИстина(Значение, Дефолт);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
