// Единственное место, где содержимое становится sha256. Запись одна на всех — hex
// строчными буквами: ею хаб сверяет артефакт с манифестом, метит ответ ETag'ом и хранит
// необратимый отпечаток секрета. Источников содержимого три: строка, двоичные данные, файл.

// sha256 текста. Строка хешируется в UTF-8 — ровно так, как её отдаёт
// ПолучитьДвоичныеДанныеИзСтроки.
//
// Параметры:
//  Значение - Строка - хешируемый текст.
//
// Возвращаемое значение:
//  Строка - hex-строка в нижнем регистре.
//
Функция ОтСтроки(Знач Значение) Экспорт

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Строка(Значение));
	Возврат Hex(Хеширование);

КонецФункции

// sha256 двоичных данных.
//
// Параметры:
//  Данные - ДвоичныеДанные - хешируемое содержимое.
//
// Возвращаемое значение:
//  Строка - hex-строка в нижнем регистре.
//
Функция ОтДанных(Знач Данные) Экспорт

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат Hex(Хеширование);

КонецФункции

// sha256 файла на диске: содержимое читается потоком, в память целиком не поднимается.
//
// Параметры:
//  Путь - Строка - путь к файлу.
//
// Возвращаемое значение:
//  Строка - hex-строка в нижнем регистре.
//
Функция ОтФайла(Знач Путь) Экспорт

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.ДобавитьФайл(Путь);
	Возврат Hex(Хеширование);

КонецФункции

// Короткий отпечаток текста: столько первых символов sha256, сколько хаб печатает
// в адресе статики и хранит вместо секрета. Шестнадцать hex-символов — 64 бита:
// подобрать столкновение дороже, чем оно стоит, а адрес остаётся читаемым.
//
// Параметры:
//  Значение - Строка - отпечатываемый текст.
//
// Возвращаемое значение:
//  Строка - hex-строка в нижнем регистре длиной ДлинаОтпечатка().
//
Функция Отпечаток(Знач Значение) Экспорт
	Возврат Лев(ОтСтроки(Значение), ДлинаОтпечатка());
КонецФункции

// Длина короткого отпечатка в символах.
//
// Возвращаемое значение:
//  Число.
//
Функция ДлинаОтпечатка() Экспорт
	Возврат 16;
КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция Hex(Знач Хеширование)
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
