// Действующие коды стран ISO 3166-1 alpha-2 — данными, а не правилом. Пользовательские
// (ZZ, XX, AA-AZ, QM-QZ, XA-XZ) и исключённые коды сюда не входят: «страна» в хабе — это
// то, что называет сама ISO.

Перем Действующие;  // Соответствие: код (ВРег) -> Истина

// Каноничная форма кода: верхний регистр без окружающих пробелов. Одно преобразование
// и на проверке, и на записи — иначе «ru» хранится, а «RU» не находится.
//
// Параметры:
//  Значение - Произвольный - то, что набрал человек.
//
// Возвращаемое значение:
//  Строка.
//
Функция Канон(Знач Значение) Экспорт
	Возврат ВРег(СокрЛП(Строка(?(Значение = Неопределено, "", Значение))));
КонецФункции

// Действующий ли это код страны ISO 3166-1 alpha-2.
//
// Параметры:
//  Значение - Произвольный - код; регистр и окружающие пробелы не значимы.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоКод(Знач Значение) Экспорт
	Возврат Действующие.Получить(Канон(Значение)) = Истина;
КонецФункции

// Сколько кодов знает реестр — самотест набора: подпиленный список обязан быть виден.
//
// Возвращаемое значение:
//  Число.
//
Функция Количество() Экспорт
	Возврат Действующие.Количество();
КонецФункции

#Область СлужебныеПроцедурыИФункции

// Список ISO 3166-1 alpha-2 на 2026 год, 249 кодов, по алфавиту.
Функция СписокКодов()

	Возврат "AD AE AF AG AI AL AM AO AQ AR AS AT AU AW AX AZ"
		+ " BA BB BD BE BF BG BH BI BJ BL BM BN BO BQ BR BS BT BV BW BY BZ"
		+ " CA CC CD CF CG CH CI CK CL CM CN CO CR CU CV CW CX CY CZ"
		+ " DE DJ DK DM DO DZ EC EE EG EH ER ES ET FI FJ FK FM FO FR"
		+ " GA GB GD GE GF GG GH GI GL GM GN GP GQ GR GS GT GU GW GY"
		+ " HK HM HN HR HT HU ID IE IL IM IN IO IQ IR IS IT JE JM JO JP"
		+ " KE KG KH KI KM KN KP KR KW KY KZ LA LB LC LI LK LR LS LT LU LV LY"
		+ " MA MC MD ME MF MG MH MK ML MM MN MO MP MQ MR MS MT MU MV MW MX MY MZ"
		+ " NA NC NE NF NG NI NL NO NP NR NU NZ OM"
		+ " PA PE PF PG PH PK PL PM PN PR PS PT PW PY QA"
		+ " RE RO RS RU RW SA SB SC SD SE SG SH SI SJ SK SL SM SN SO SR SS ST SV SX SY SZ"
		+ " TC TD TF TG TH TJ TK TL TM TN TO TR TT TV TW TZ"
		+ " UA UG UM US UY UZ VA VC VE VG VI VN VU WF WS YE YT ZA ZM ZW";

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт

	Действующие = Новый Соответствие();
	Для Каждого Код Из СтрРазделить(СписокКодов(), " ", Ложь) Цикл
		Действующие.Вставить(Код, Истина);
	КонецЦикла;

КонецПроцедуры
