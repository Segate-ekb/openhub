// Одна форма из трёх, которыми ОСень отдаёт необязательную зависимость: ФиксированныйМассив
// контейнера, обычный Массив теста и сам объект. Единственное место, где эти три формы
// различаются: своих разборов внедрения в дереве не осталось.

// Первый желудь из того, что пришло во внедряемый параметр. Массив длиннее одного означает,
// что контейнер собрал несколько кандидатов: берётся первый, остальные не смотрим.
//
// Параметры:
//  Внедрение - Произвольный - значение параметра конструктора: массив желудей, сам желудь
//              либо Неопределено.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - желудь; Неопределено, если внедрять было нечего.
//
Функция ПервыйИз(Знач Внедрение) Экспорт

	Если Внедрение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗнч(Внедрение) = Тип("Массив")
		ИЛИ ТипЗнч(Внедрение) = Тип("ФиксированныйМассив") Тогда
		Возврат ?(Внедрение.Количество() = 0, Неопределено, Внедрение[0]);
	КонецЕсли;

	Возврат Внедрение;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
