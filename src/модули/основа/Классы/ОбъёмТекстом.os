// Объём в байтах человеку: единица выбирается по величине, дробная часть — одна цифра.

// Представление объёма для показа.
//
// Параметры:
//  Байты - Число, Неопределено - объём в байтах.
//
// Возвращаемое значение:
//  Строка - например «430,2 МБ»; ноль, пустое и отрицательное дают «0 Б».
//
Функция Представление(Знач Байты) Экспорт

	Значение = ?(Байты = Неопределено, 0, Цел(Число(Байты)));

	Если Значение < 1024 Тогда
		Возврат СтрШаблон("%1 Б", Формат(Макс(0, Значение), "ЧН=0; ЧГ=0"));
	КонецЕсли;
	Если Значение < 1048576 Тогда
		Возврат СтрШаблон("%1 КБ", Дробное(Значение / 1024));
	КонецЕсли;
	Если Значение < 1073741824 Тогда
		Возврат СтрШаблон("%1 МБ", Дробное(Значение / 1048576));
	КонецЕсли;
	Возврат СтрШаблон("%1 ГБ", Дробное(Значение / 1073741824));

КонецФункции

Функция Дробное(Знач Значение)
	Возврат Формат(Значение, "ЧДЦ=1; ЧН=0; ЧГ=0");
КонецФункции

&Прозвище("ОбъёмТекстом")
&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры
