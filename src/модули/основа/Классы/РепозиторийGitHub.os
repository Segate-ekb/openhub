// Репозиторий на github.com по его веб-адресу: владелец и имя, годные сегментом другого адреса.

Перем Адреса;   // РазборАдреса

#Область ПубличныйИнтерфейс

// Владелец и имя репозитория из веб-адреса на github.com. Хвост пути после имени
// («/tree/main», «/issues») и суффикс клона «.git» отбрасываются.
//
// Параметры:
//  Адрес - Строка - веб-адрес репозитория; недоверенное значение.
//
// Возвращаемое значение:
//  Структура, Неопределено - Владелец (Строка), Имя (Строка) — латиница, цифры, «-», «_», «.»;
//                            Неопределено, если адрес не ведёт в репозиторий на github.com.
//
Функция Координаты(Знач Адрес) Экспорт

	Значение = Адреса.БезЗапросаИЯкоря(СокрЛП(Строка(Адрес)));
	Части = Адреса.СхемаИУзел(Значение);
	Если НЕ ((Части.Схема = "https" ИЛИ Части.Схема = "http") И НЕ Части.СДаннымиПользователя
		И (Части.Хост = "github.com" ИЛИ Части.Хост = "www.github.com")) Тогда
		Возврат Неопределено;
	КонецЕсли;

	НачалоПути = Адреса.ПозицияПути(Значение);
	Если НачалоПути = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Сегменты = СтрРазделить(Сред(Значение, НачалоПути + 1), "/", Ложь);
	Если Сегменты.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Владелец = Сегменты[0];
	Имя = БезСуффиксаКлона(Сегменты[1]);
	Если НЕ (ЭтоИмя(Владелец) И ЭтоИмя(Имя)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Владелец, Имя", Владелец, Имя);

КонецФункции

// Годится ли строка сегментом адреса на GitHub: латиница, цифры, «-», «_» и «.», не «.» и не «..».
//
// Параметры:
//  Имя - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Булево - Истина, если строка непуста и состоит только из этих символов.
//
Функция ЭтоИмя(Знач Имя) Экспорт

	Если НЕ ЗначениеЗаполнено(Имя) ИЛИ Имя = "." ИЛИ Имя = ".." Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Имя) Цикл
		Если СтрНайти(СимволыИмени(), Сред(Имя, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// «acme/lib.git» — адрес клона, а репозиторий называется «lib».
Функция БезСуффиксаКлона(Знач Имя)
	Суффикс = ".git";
	Возврат ?(СтрЗаканчиваетсяНа(НРег(Имя), Суффикс), Лев(Имя, СтрДлина(Имя) - СтрДлина(Суффикс)), Имя);
КонецФункции

Функция СимволыИмени()
	Возврат "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.";
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "РазборАдреса") _Адреса) Экспорт
	Адреса = _Адреса;
КонецПроцедуры
