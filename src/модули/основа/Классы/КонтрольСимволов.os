// Что означает код символа и как обойти строку в его поисках. Здесь механика: имена
// диапазонов, обход строки и очистка. Какой диапазон в этом месте запрещён — решает
// спрашивающий: имени файла нельзя одно, заголовку авторизации другое, логину третье.

#Область ЗначенияКодов

// Управляющий символ C0: коды 0..31. Именно их не должно быть ни в имени файла,
// ни в ключе хранилища — там DEL безобиден, а перевод строки ломает путь.
//
// Параметры:
//  Код - Число - код символа.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоУправляющийC0(Знач Код) Экспорт
	Возврат Код < 32;
КонецФункции

// DEL: код 127. Печатным не является, но и C0 не считается.
//
// Параметры:
//  Код - Число - код символа.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоDEL(Знач Код) Экспорт
	Возврат Код = 127;
КонецФункции

// Разрыв строки или абзаца Юникода: NEL, неразрывный пробел, U+2028 и U+2029. Строку
// заголовка и адреса они делят наравне с CR/LF, но кодом больше 127 не ловятся.
//
// Параметры:
//  Код - Число - код символа.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоРазрывЮникода(Знач Код) Экспорт
	Возврат Код = 133 ИЛИ Код = 160 ИЛИ Код = 8232 ИЛИ Код = 8233;
КонецФункции

// Печатная латиница без пробела: коды 33..126. Ровно этим ограничено значение,
// уезжающее заголовком HTTP.
//
// Параметры:
//  Код - Число - код символа.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоПечатнаяЛатиница(Знач Код) Экспорт
	Возврат Код >= 33 И Код <= 126;
КонецФункции

// Имя символа для текста отказа. Возвращается именно имя: подставить CR/LF в сообщение
// значило бы повторить инъекцию, от которой защищаемся.
//
// Параметры:
//  Код - Число - код символа.
//
// Возвращаемое значение:
//  Строка - «пробел» либо «код N».
//
Функция ИмяКода(Знач Код) Экспорт
	Возврат ?(Код = 32, "пробел", СтрШаблон("код %1", Формат(Код, "ЧГ=0; ЧН=0")));
КонецФункции

#КонецОбласти

#Область ОбходСтроки

// Имя первого пробела либо управляющего символа в строке.
//
// Параметры:
//  Значение - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Строка - имя символа; пустая строка, если таких символов нет.
//
Функция ПервыйУправляющийИлиПробел(Знач Значение) Экспорт

	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Позиция);
		Если Код = 32 ИЛИ ЭтоУправляющийC0(Код) ИЛИ ЭтоDEL(Код) Тогда
			Возврат ИмяКода(Код);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Есть ли в строке управляющий символ: C0 либо DEL. Пробел управляющим не считается.
//
// Параметры:
//  Значение - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьУправляющий(Знач Значение) Экспорт

	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Позиция);
		Если ЭтоУправляющийC0(Код) ИЛИ ЭтоDEL(Код) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Есть ли в строке пробел, управляющий символ либо разрыв Юникода.
//
// Параметры:
//  Значение - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьУправляющийПробелИлиРазрыв(Знач Значение) Экспорт

	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Позиция);
		Если Код = 32 ИЛИ ЭтоУправляющийC0(Код) ИЛИ ЭтоDEL(Код) ИЛИ ЭтоРазрывЮникода(Код) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Имя первого символа, не являющегося печатной латиницей.
//
// Параметры:
//  Значение - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Строка - имя символа; пустая строка, если вся строка печатная латиница.
//
Функция ПервыйВнеПечатнойЛатиницы(Знач Значение) Экспорт

	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Позиция);
		Если НЕ ЭтоПечатнаяЛатиница(Код) Тогда
			Возврат ИмяКода(Код);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Короткая метка из недоверенного текста: управляющие C0 выброшены, обрамляющие пробелы
// сняты, длина ограничена пределом. Так имя, набранное человеком, становится строкой
// списка и не уносит с собой перевод строки.
//
// Параметры:
//  Текст - Произвольный - исходное значение; Неопределено читается как пустая строка.
//  Предел - Число - предельная длина результата в символах.
//
// Возвращаемое значение:
//  Строка.
//
Функция Очистить(Знач Текст, Знач Предел) Экспорт

	Исходное = Строка(?(Текст = Неопределено, "", Текст));
	Очищенное = "";
	Для Позиция = 1 По СтрДлина(Исходное) Цикл
		Символ = Сред(Исходное, Позиция, 1);
		Если НЕ ЭтоУправляющийC0(КодСимвола(Символ)) Тогда
			Очищенное = Очищенное + Символ;
		КонецЕсли;
	КонецЦикла;

	Очищенное = СокрЛП(Очищенное);
	Возврат ?(СтрДлина(Очищенное) > Предел, Лев(Очищенное, Предел), Очищенное);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
