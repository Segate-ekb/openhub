// Каркас проверки формы внешнего адреса. Порядок вопросов один на все двери хаба:
// пусто → управляющий символ → есть ли схема → та ли схема → userinfo → есть ли хост.
// Первый вопрос без ответа называется кодом; слова отказа и набор допустимых схем
// принадлежат спрашивающему — источнику можно http, провайдеру только https,
// а адрес возврата судит схему сам, после хоста. Куда адрес ведёт, здесь не решается.

Перем Адреса;        // РазборАдреса (основа)
Перем ЧерезЗапятую;  // СписокЧерезЗапятую (основа)

// Коды разбора: имена вопросов, на которые адрес не ответил.
//
// Возвращаемое значение:
//  Структура - Ок, Пусто, Управляющий, СхемыНет, ЧужаяСхема, ДанныеПользователя, ХостаНет.
//
Функция Коды() Экспорт
	Возврат Новый Структура("Ок, Пусто, Управляющий, СхемыНет, ЧужаяСхема, ДанныеПользователя, ХостаНет",
		"", "пусто", "управляющий", "нет-схемы", "чужая-схема", "userinfo", "нет-хоста");
КонецФункции

// Разбирает адрес и называет первый вопрос, на который он не ответил.
//
// Параметры:
//  Адрес - Строка - адрес из формы либо тела запроса.
//  ДопустимыеСхемы - Строка - схемы через запятую; пустая строка означает «схему
//                    не судить» (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Код (Строка из Коды()), Символ (Строка — имя управляющего символа,
//              когда Код = Коды().Управляющий), Схема (Строка, нижний регистр),
//              Хост (Строка, нижний регистр).
//
Функция Разобрать(Знач Адрес, Знач ДопустимыеСхемы = "") Экспорт

	Ответы = Коды();
	Значение = СокрЛП(Строка(Адрес));
	Разбор = Новый Структура("Код, Символ, Схема, Хост", Ответы.Ок, "", "", "");

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Разбор.Код = Ответы.Пусто;
		Возврат Разбор;
	КонецЕсли;

	Разбор.Символ = Адреса.НайтиУправляющий(Значение);
	Если ЗначениеЗаполнено(Разбор.Символ) Тогда
		Разбор.Код = Ответы.Управляющий;
		Возврат Разбор;
	КонецЕсли;

	Части = Адреса.СхемаИУзел(Значение);
	Разбор.Схема = Части.Схема;
	Разбор.Хост = Части.Хост;

	Если НЕ Части.СхемаЕсть Тогда
		Разбор.Код = Ответы.СхемыНет;
	ИначеЕсли ЗначениеЗаполнено(ДопустимыеСхемы)
		И НЕ ЧерезЗапятую.Содержит(ДопустимыеСхемы, Части.Схема) Тогда
		Разбор.Код = Ответы.ЧужаяСхема;
	ИначеЕсли Части.СДаннымиПользователя Тогда
		Разбор.Код = Ответы.ДанныеПользователя;
	ИначеЕсли НЕ ЗначениеЗаполнено(Части.Хост) Тогда
		Разбор.Код = Ответы.ХостаНет;
	КонецЕсли;

	Возврат Разбор;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
	// примитивы основы собираются оператором «Новый», а не пластилином: их самих
	// создают напрямую (сюда же — значения-объекты и обёртки напильника),
	// а желудь с внедрениями обязан приезжать из контейнера
	Адреса = Новый РазборАдреса();
	ЧерезЗапятую = Новый СписокЧерезЗапятую();
КонецПроцедуры
