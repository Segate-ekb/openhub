// Как длинное становится коротким там, где длинное читать не помогает: обрезанный текст
// и перечень со свёрнутым хвостом. Сколько оставить — решает спрашивающий.

// Текст, обрезанный до длины, с многоточием на месте отрезанного. Короткий текст
// возвращается как есть: многоточие означает «здесь ещё есть», а не украшение.
//
// Параметры:
//  Текст - Произвольный - исходный текст.
//  Длина - Число - сколько символов оставить.
//
// Возвращаемое значение:
//  Строка.
//
Функция СМноготочием(Знач Текст, Знач Длина) Экспорт

	Значение = Строка(?(Текст = Неопределено, "", Текст));
	Возврат ?(СтрДлина(Значение) > Длина, Лев(Значение, Длина) + "…", Значение);

КонецФункции

// Перечень значений через запятую со свёрнутым хвостом: первые Предел названы поимённо,
// об остальных сказано числом. Перечень короче предела печатается целиком.
//
// Параметры:
//  Значения - Массив - перечисляемые значения.
//  Предел - Число - сколько значений назвать поимённо.
//
// Возвращаемое значение:
//  Строка - «a, b» либо «a, b и ещё 7».
//
Функция ПереченьСОстатком(Знач Значения, Знач Предел) Экспорт

	Если Значения.Количество() <= Предел Тогда
		Возврат СтрСоединить(Значения, ", ");
	КонецЕсли;

	Начало = Новый Массив();
	Для Позиция = 0 По Предел - 1 Цикл
		Начало.Добавить(Значения[Позиция]);
	КонецЦикла;

	Возврат СтрШаблон("%1 и ещё %2",
		СтрСоединить(Начало, ", "), Формат(Значения.Количество() - Предел, "ЧГ=0; ЧН=0"));

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
