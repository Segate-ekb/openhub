// Чтение поля из недоверенного набора: событие приезжает Структурой, тело запроса —
// Соответствием, а спрашивающему нужен один ответ. Отсутствующее поле, поле со значением
// Неопределено и набор не того типа читаются одинаково — значением по умолчанию.

// Значение поля набора.
//
// Параметры:
//  Данные - Структура, Соответствие, Произвольный - набор полей; любой другой тип
//           читается как пустой набор.
//  Имя - Строка - имя поля.
//  ПоУмолчанию - Произвольный - что вернуть, когда поля нет либо оно Неопределено.
//
// Возвращаемое значение:
//  Произвольный - значение поля либо ПоУмолчанию.
//
Функция Поле(Знач Данные, Знач Имя, Знач ПоУмолчанию) Экспорт

	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если Данные.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
		Возврат ПоУмолчанию;
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Значение = Данные.Получить(Имя);
		Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);
	КонецЕсли;

	Возврат ПоУмолчанию;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
