// Заголовки ответов, которыми хаб говорит чужой стороне — кэшу и браузеру — что с
// ответом делать; желудь общего модуля: ими живут и экраны, и API.
// Правил четыре. Контент-адресуемый ответ (статика из поставки, активы бренда) неизменен
// по построению: адрес несёт отпечаток СОДЕРЖИМОГО. Ответ страницы по адресу без версии
// меняется с публикациями, поэтому переиспользуется коротким сроком, а приватное
// не попадает в общий кэш вовсе. Адрес, за которым стоит переезжающий указатель, отдаётся
// только со сверкой метки. Адрес страницы наружу не уходит: он несёт секреты —
// одноразовую ссылку, код входа CLI, — и Referer отдал бы их внешнему сайту.

Перем Заголовки;   // ЗаголовкиHTTP (основа)

// Значение Cache-Control. Содержимое по адресу неизменно по построению — это ровно
// тот случай, для которого придуман immutable.
//
// Возвращаемое значение:
//  Строка
//
Функция НеизменяемыйКэш() Экспорт
	Возврат "public, max-age=31536000, immutable";
КонецФункции

// Значение Cache-Control для адреса, содержимое которого меняется под тем же именем:
// тег переезжает на новую версию. Хранить ответ можно, отдавать без сверки метки — нет.
//
// Возвращаемое значение:
//  Строка
//
Функция КэшИзменяемогоАдреса() Экспорт
	Возврат "no-cache";
КонецФункции

// Сколько секунд ответ безверсионного адреса годен к повторной отдаче. Минута: новая
// публикация становится видна сама, без ручного сброса, и при этом всплеск читателей
// одной страницы не пересобирает README на каждый запрос.
//
// Возвращаемое значение:
//  Число - секунды.
//
Функция СрокСтраницы() Экспорт
	Возврат 60;
КонецФункции

// Значение Cache-Control для ответа страницы. Приватное не кладётся в общий кэш ни на
// секунду: no-store сильнее любого срока, и промежуточный кэш такой ответ не хранит.
//
// Параметры:
//  Публичная - Булево - виден ли ответ анониму.
//
// Возвращаемое значение:
//  Строка
//
Функция КэшСтраницы(Знач Публичная) Экспорт

	Если Публичная <> Истина Тогда
		Возврат ПриватныйКэш();
	КонецЕсли;
	Возврат СтрШаблон("public, max-age=%1", Формат(СрокСтраницы(), "ЧГ=0; ЧН=0"));

КонецФункции

// Значение Cache-Control для ответа, который виден не всем: в общий кэш он не кладётся
// ни на секунду. Годится и странице, и телу артефакта приватного пула.
//
// Возвращаемое значение:
//  Строка
//
Функция ПриватныйКэш() Экспорт
	Возврат "private, no-store";
КонецФункции

// Значение Referrer-Policy для ответов хаба. Адрес не уходит наружу ни целиком, ни
// origin'ом: секрет живёт именно в адресе, а не в теле, и «только origin» его не спасает.
//
// Возвращаемое значение:
//  Строка
//
Функция ПолитикаПерехода() Экспорт
	Возврат "no-referrer";
КонецФункции

// Ставит ответу заголовки страницы, которую нельзя оставлять чужой стороне: она не
// оседает ни в браузере, ни в промежуточном кэше, и её адрес не уезжает в Referer.
// Вызывается перед записью тела: заголовки не зависят от содержимого.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//
Процедура ЗакрытьСтраницу(Ответ) Экспорт
	Ответ.Заголовки["Cache-Control"] = КэшСтраницы(Ложь);
	Ответ.Заголовки["Referrer-Policy"] = ПолитикаПерехода();
КонецПроцедуры

// Метка ресурса по его содержимому: сильный валидатор поверх sha256 тела ответа.
//
// Параметры:
//  Содержимое - Строка - тело ответа.
//
// Возвращаемое значение:
//  Строка - значение ETag.
//
Функция МеткаСодержимого(Знач Содержимое) Экспорт

	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(Строка(Содержимое));
	Возврат Метка(НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма)));

КонецФункции

// Отдаёт HTML-страницу со сроком повторного использования и меткой ресурса; совпавший
// If-None-Match даёт 304 без тела. Метка считается по ТЕЛУ: страница меняется и от
// публикации, и от счётчиков, и вывести её из чего-то одного значило бы отдать 304
// на изменившийся ответ.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Тело - Строка - готовая страница.
//  Публичная - Булево - виден ли ответ анониму.
//  ЗаголовкиЗапроса - Соответствие, Неопределено - заголовки запроса.
//
Процедура ОтдатьСтраницу(Ответ, Знач Тело, Знач Публичная, Знач ЗаголовкиЗапроса) Экспорт

	Метка = МеткаСодержимого(Тело);
	Ответ.Заголовки["Cache-Control"] = КэшСтраницы(Публичная);
	Ответ.Заголовки["Referrer-Policy"] = ПолитикаПерехода();
	Ответ.Заголовки["ETag"] = Метка;
	Ответ.УстановитьТипКонтента("html");

	Если СовпадаетETag(ЗаголовкиЗапроса, Метка) Тогда
		Ответ.УстановитьСостояние(304);
		Ответ.ТелоТекст = "";
		Возврат;
	КонецЕсли;

	Ответ.УстановитьСостояниеОК();
	Ответ.ТелоТекст = Тело;

КонецПроцедуры

// Значение заголовка ETag для отпечатка: сильный валидатор в кавычках.
//
// Параметры:
//  Отпечаток - Строка - SHA-256 содержимого (hex).
//
// Возвращаемое значение:
//  Строка - значение ETag либо "" для пустого отпечатка.
//
Функция Метка(Знач Отпечаток) Экспорт

	Значение = СокрЛП(Строка(Отпечаток));
	Возврат ?(ЗначениеЗаполнено(Значение), """" + Значение + """", "");

КонецФункции

// Совпадает ли метка с любой из перечисленных в If-None-Match («*» тоже совпадает).
//
// Параметры:
//  ЗаголовкиЗапроса - Соответствие, Неопределено - заголовки запроса.
//  Метка - Строка - значение ETag ответа.
//
// Возвращаемое значение:
//  Булево - Истина, если клиенту можно ответить 304.
//
Функция СовпадаетETag(Знач ЗаголовкиЗапроса, Знач Метка) Экспорт

	Если НЕ ЗначениеЗаполнено(Метка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Значение = Заголовки.Текст(ЗаголовкиЗапроса, "If-None-Match");
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Часть Из СтрРазделить(Значение, ",", Ложь) Цикл
		Очищенная = СокрЛП(Часть);
		Если Лев(Очищенная, 2) = "W/" Тогда
			Очищенная = СокрЛП(Сред(Очищенная, 3));
		КонецЕсли;
		Если Очищенная = "*" ИЛИ Очищенная = Метка Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ЗаголовкиHTTP") _Заголовки) Экспорт
	Заголовки = _Заголовки;
КонецПроцедуры
