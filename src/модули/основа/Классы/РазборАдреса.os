// Разбор URL по частям без чужих библиотек: authority, хост, хвост пути — и каноничная форма
// адреса, собранная из них же. Правило одно на всех, кто судит адрес: гварды SSRF, корень
// апстрима, перечень версий источника, уникальность апстрима зеркала.

// Часть после "://" до первого '/', '?' или '#" — authority вида user@host:port.
//
// Параметры:
//  ОстатокПослеСхемы - Строка - адрес без схемы.
//
// Возвращаемое значение:
//  Строка - authority.
//
Функция Авторитет(Знач ОстатокПослеСхемы) Экспорт

	Результат = ОстатокПослеСхемы;
	Для Каждого Разделитель Из СтрРазделить("/,?,#", ",") Цикл
		П = Найти(Результат, Разделитель);
		Если П > 0 Тогда
			Результат = Лев(Результат, П - 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Хост из authority: отбрасывает userinfo и порт, снимает скобки IPv6-литерала.
//
// Параметры:
//  Авторитет - Строка - authority вида user@host:port.
//
// Возвращаемое значение:
//  Строка - имя узла либо адрес.
//
Функция Хост(Знач Авторитет) Экспорт

	Значение = Авторитет;
	П = Найти(Значение, "@");
	Если П > 0 Тогда
		Значение = Сред(Значение, П + 1);
	КонецЕсли;

	Если Лев(Значение, 1) = "[" Тогда
		Закрытие = Найти(Значение, "]");
		Если Закрытие > 0 Тогда
			Возврат Сред(Значение, 2, Закрытие - 2);
		КонецЕсли;
	КонецЕсли;

	ПортП = СтрНайти(Значение, ":", НаправлениеПоиска.СКонца);
	Если ПортП > 0 Тогда
		Значение = Лев(Значение, ПортП - 1);
	КонецЕсли;

	Возврат СокрЛП(Значение);

КонецФункции

// Каноничный адрес: схема и authority к нижнему регистру, путь и query как есть. На этом
// держится уникальность пары (пул, апстрим) у зеркала: иначе Example.com и example.com дали бы
// два зеркала на один апстрим. Адрес без схемы возвращается как есть — его всё равно отклонит
// валидатор.
//
// Параметры:
//  Адрес - Строка - адрес из формы либо тела запроса.
//
// Возвращаемое значение:
//  Строка.
//
Функция Каноничный(Знач Адрес) Экспорт

	Значение = СокрЛП(Строка(Адрес));
	Позиция = Найти(Значение, "://");
	Если Позиция = 0 Тогда
		Возврат Значение;
	КонецЕсли;

	Схема = НРег(Лев(Значение, Позиция + 2));
	Остаток = Сред(Значение, Позиция + 3);
	АвторитетАдреса = Авторитет(Остаток);

	Возврат Схема + НРег(АвторитетАдреса) + Сред(Остаток, СтрДлина(АвторитетАдреса) + 1);

КонецФункции

// Позиция первого слеша пути. Ноль, если пути нет вовсе: слеш внутри схемы и имя хоста
// путём не считаются.
//
// Параметры:
//  Адрес - Строка - полный адрес.
//
// Возвращаемое значение:
//  Число - позиция слеша пути либо 0.
//
Функция ПозицияПути(Знач Адрес) Экспорт

	Позиция = СтрНайти(Адрес, "://");
	НачалоХоста = ?(Позиция > 0, Позиция + 3, 1);
	Слеш = СтрНайти(Сред(Адрес, НачалоХоста), "/");
	Возврат ?(Слеш = 0, 0, НачалоХоста + Слеш - 1);

КонецФункции

// Адрес без хвостовых слешей.
//
// Параметры:
//  Адрес - Строка - адрес.
//
// Возвращаемое значение:
//  Строка.
//
Функция БезХвостовыхСлешей(Знач Адрес) Экспорт

	Результат = Адрес;
	Пока ЗаканчиваетсяНа(Результат, "/") Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Адрес без названного хвостового сегмента пути. Отрезается ровно он, остальной путь
// сохраняется: у хаба на подпути ("/api/v1/pools/{пул}/download/") корень сайта соседей
// выдачи не отдаёт. Адрес без пути и адрес не с тем хвостом возвращаются как есть —
// про чужой контракт не гадаем.
//
// Параметры:
//  Адрес - Строка - адрес, возможно с хвостовыми слешами.
//  Сегмент - Строка - отрезаемый сегмент вместе с ведущим слешем, например "/download".
//
// Возвращаемое значение:
//  Строка - адрес без сегмента.
//
Функция БезХвостовогоСегмента(Знач Адрес, Знач Сегмент) Экспорт

	Очищенный = БезХвостовыхСлешей(СокрЛП(Строка(Адрес)));
	Если ПозицияПути(Очищенный) = 0 Тогда
		Возврат Очищенный;
	КонецЕсли;

	Хвост = СтрДлина(Очищенный) - СтрДлина(Сегмент) + 1;
	Если НРег(Сред(Очищенный, Хвост)) <> НРег(Сегмент) Тогда
		Возврат Очищенный;
	КонецЕсли;

	Возврат Лев(Очищенный, Хвост - 1);

КонецФункции

// Имя первого управляющего символа или пробела в строке. Возвращается именно имя:
// подставить CR/LF в текст ошибки значило бы повторить инъекцию, от которой защищаемся.
//
// Параметры:
//  Значение - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Строка - имя символа; пустая строка, если таких символов нет.
//
Функция НайтиУправляющий(Знач Значение) Экспорт

	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Позиция);
		Если Код = 32 Тогда
			Возврат "пробел";
		КонецЕсли;
		Если Код < 32 ИЛИ Код = 127 Тогда
			Возврат СтрШаблон("код %1", Формат(Код, "ЧГ=0; ЧН=0"));
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Заканчивается ли строка суффиксом.
//
// Параметры:
//  Значение - Строка - проверяемая строка.
//  Суффикс - Строка - искомое окончание.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЗаканчиваетсяНа(Знач Значение, Знач Суффикс) Экспорт
	Возврат Прав(Значение, СтрДлина(Суффикс)) = Суффикс;
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
