// Разбор адреса по RFC 3986 на библиотеке url: составные части для гвардов SSRF,
// каноничная форма для сличения источников и хвост пути для корня апстрима.
// Правило одно на всех, кто судит адрес. Строковая арифметика по «://» осталась ровно
// там, где разбирать нечего: у адреса, ссылкой не являющегося, надо всё равно узнать
// схему с узлом (ДоПути), а у литерала IPv6 — снять скобки (БезСкобокIPv6).

#Использовать url

// Схема, признак userinfo и хост адреса одним разбором. Ничего не отвергает: спросивший
// судит сам и своими словами. Неразбираемый адрес отдаёт пустой хост — схема при этом
// названа, если она в строке есть: «https://» отличается от «просто текст».
//
// Параметры:
//  Адрес - Строка - адрес из формы либо тела запроса.
//
// Возвращаемое значение:
//  Структура - СхемаЕсть (Булево), Схема (Строка, нижний регистр),
//              СДаннымиПользователя (Булево, есть ли user@ перед хостом),
//              Хост (Строка, нижний регистр, IPv6 без скобок).
//
Функция СхемаИУзел(Знач Адрес) Экспорт

	Значение = СокрЛП(Строка(Адрес));
	Позиция = Найти(Значение, "://");

	Результат = Новый Структура("СхемаЕсть, Схема, СДаннымиПользователя, Хост",
		Позиция > 0, ?(Позиция > 0, НРег(Лев(Значение, Позиция - 1)), ""), Ложь, "");

	Разобранный = РазборURL.ПопытатьсяРазобрать(Значение);
	Если Разобранный = Неопределено Тогда
		// путь и запрос бывают какими угодно — «?a=<b>» ссылкой не является, но узел
		// в таком адресе читается, и судить его дверь вправе
		Разобранный = РазборURL.ПопытатьсяРазобрать(ДоПути(Значение));
	КонецЕсли;
	Если Разобранный = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.СДаннымиПользователя = Разобранный.ДанныеПользователя() <> Неопределено;
	Результат.Хост = НРег(БезСкобокIPv6(Разобранный.Хост()));
	Возврат Результат;

КонецФункции

// Каноничная запись адреса по RFC 3986 § 6.2: регистр схемы и хоста, порт по умолчанию,
// точечные сегменты пути и процентное кодирование приводятся к одному виду, хвостовые
// слеши остаются как набраны. На этом держится «один адрес — одна запись источника»:
// https://хаб:443/download/ и https://хаб/download/./ становятся одной строкой.
// Адрес, который не разбирается вовсе, возвращается как есть — его отклонит валидатор.
//
// Параметры:
//  Адрес - Строка - адрес из формы либо тела запроса.
//
// Возвращаемое значение:
//  Строка.
//
Функция Каноничный(Знач Адрес) Экспорт

	Значение = СокрЛП(Строка(Адрес));
	Разобранный = РазборURL.ПопытатьсяРазобрать(Значение);
	Если Разобранный = Неопределено Тогда
		Возврат СхемаИУзелВНижнемРегистре(Значение);
	КонецЕсли;

	Приведённый = Разобранный.НормализованныйДляСхемы();
	// нижний регистр хоста RFC требует только от ASCII; хаб распространяет его на весь
	// хост, иначе ХАБ.рф и хаб.рф дали бы два источника
	Если Приведённый.Хост() <> Неопределено Тогда
		Приведённый.УстановитьХост(НРег(Приведённый.Хост()));
	КонецЕсли;

	Возврат Приведённый.ВСтроку();

КонецФункции

// Адрес без хвостовых слешей.
//
// Параметры:
//  Адрес - Строка - адрес.
//
// Возвращаемое значение:
//  Строка.
//
Функция БезХвостовыхСлешей(Знач Адрес) Экспорт

	Результат = Адрес;
	Пока ЗаканчиваетсяНа(Результат, "/") Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Адрес без названного хвостового сегмента пути. Отрезается ровно он, остальной путь
// сохраняется: у хаба на подпути ("/api/v1/pools/{пул}/download/") корень сайта соседей
// выдачи не отдаёт. Адрес без пути и адрес не с тем хвостом возвращаются как есть —
// про чужой контракт не гадаем.
//
// Параметры:
//  Адрес - Строка - адрес, возможно с хвостовыми слешами.
//  Сегмент - Строка - отрезаемый сегмент вместе с ведущим слешем, например "/download".
//
// Возвращаемое значение:
//  Строка - адрес без сегмента.
//
Функция БезХвостовогоСегмента(Знач Адрес, Знач Сегмент) Экспорт

	Очищенный = БезХвостовыхСлешей(СокрЛП(Строка(Адрес)));
	Если ПозицияПути(Очищенный) = 0 Тогда
		Возврат Очищенный;
	КонецЕсли;

	Хвост = СтрДлина(Очищенный) - СтрДлина(Сегмент) + 1;
	Если НРег(Сред(Очищенный, Хвост)) <> НРег(Сегмент) Тогда
		Возврат Очищенный;
	КонецЕсли;

	Возврат Лев(Очищенный, Хвост - 1);

КонецФункции

// Имя первого управляющего символа или пробела в строке. Возвращается именно имя:
// подставить CR/LF в текст ошибки значило бы повторить инъекцию, от которой защищаемся.
//
// Параметры:
//  Значение - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Строка - имя символа; пустая строка, если таких символов нет.
//
Функция НайтиУправляющий(Знач Значение) Экспорт

	Для Позиция = 1 По СтрДлина(Значение) Цикл
		Код = КодСимвола(Значение, Позиция);
		Если Код = 32 Тогда
			Возврат "пробел";
		КонецЕсли;
		Если Код < 32 ИЛИ Код = 127 Тогда
			Возврат СтрШаблон("код %1", Формат(Код, "ЧГ=0; ЧН=0"));
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Заканчивается ли строка суффиксом.
//
// Параметры:
//  Значение - Строка - проверяемая строка.
//  Суффикс - Строка - искомое окончание.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЗаканчиваетсяНа(Знач Значение, Знач Суффикс) Экспорт
	Возврат Прав(Значение, СтрДлина(Суффикс)) = Суффикс;
КонецФункции

// Позиция первого слеша пути: с неё начинается всё, что идёт после схемы и узла.
// Ноль, если пути нет вовсе — слеш внутри схемы и имя хоста путём не считаются.
//
// Параметры:
//  Адрес - Строка - адрес.
//
// Возвращаемое значение:
//  Число - позиция первого слеша пути; 0 — пути нет.
//
Функция ПозицияПути(Знач Адрес) Экспорт

	Позиция = СтрНайти(Адрес, "://");
	НачалоХоста = ?(Позиция > 0, Позиция + 3, 1);
	Слеш = СтрНайти(Сред(Адрес, НачалоХоста), "/");
	Возврат ?(Слеш = 0, 0, НачалоХоста + Слеш - 1);

КонецФункции

#Область СлужебныеПроцедурыИФункции

// Адрес, который ссылкой не является, каноном всё же обзаводится: схему и узел опускаем
// в нижний регистр, остальное остаётся как набрано. Иначе HTTPS://ХАБ/?a=<b> и
// https://хаб/?a=<b> дали бы две записи — а раньше не давали.
Функция СхемаИУзелВНижнемРегистре(Знач Адрес)

	Голова = ДоПути(Адрес);
	Возврат НРег(Голова) + Сред(Адрес, СтрДлина(Голова) + 1);

КонецФункции

// Схема и узел без пути, запроса и якоря.
Функция ДоПути(Знач Адрес)

	Позиция = СтрНайти(Адрес, "://");
	Если Позиция = 0 Тогда
		Возврат Адрес;
	КонецЕсли;

	Конец = СтрДлина(Адрес);
	Для Каждого Разделитель Из СтрРазделить("/,?,#", ",") Цикл
		Найдено = СтрНайти(Сред(Адрес, Позиция + 3), Разделитель);
		Если Найдено > 0 И Позиция + 1 + Найдено < Конец Тогда
			Конец = Позиция + 1 + Найдено;
		КонецЕсли;
	КонецЦикла;

	Возврат Лев(Адрес, Конец);

КонецФункции

// Хост IPv6 библиотека отдаёт в скобках литерала; сети и журналу нужен сам адрес.
Функция БезСкобокIPv6(Знач Хост)

	Значение = Строка(?(Хост = Неопределено, "", Хост));
	Если Лев(Значение, 1) = "[" И Прав(Значение, 1) = "]" Тогда
		Возврат Сред(Значение, 2, СтрДлина(Значение) - 2);
	КонецЕсли;
	Возврат Значение;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
