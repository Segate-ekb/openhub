// Контроллер пакета — web-ui: страница пакета, разложенная на вкладки, каждая своим URL
// (описание, версии, зависимости), плюс legacy-редирект /package/{name}.

Перем СервисПулов;
Перем СервисПакетов;
Перем СервисВерсий;
Перем РезолверСпецификации; // РезолверСпецификации (реестр) — версия установки без спецификации
Перем Провенанс;          // СервисПроисхождения (реестр)
Перем ХранилищеЗависимостей;
Перем СлужбаREADME;       // СлужбаREADME (описания)
Перем Команды;            // КомандыOpm
Перем Подсказка;          // ПодсказкаУстановки
Перем Кит;                // Кит (oscript-ui) — фабрика элементов экрана
Перем Каркас;             // КаркасСтраницы (кит) — корень страницы
Перем НаборUI;            // НаборКомпонентов (кит)
Перем Экран;              // ЭкранированиеHTML (кит)
Перем Витрина;            // ВитринаПакетов
Перем ЗначкиВерсии;       // ЗначкиВерсии (web-ui)
Перем ВкладкаВерсий;      // ВкладкаВерсий (web-ui)
Перем СлужбаКабинета;     // СлужбаКабинета (кабинет)
Перем СлужбаСтатистики;   // СлужбаСтатистикиСкачиваний (статистика)
Перем Гвард;              // ГвардОнбординга
Перем Перехватчик;        // ПерехватчикАутентификации (auth)
Перем ЧтениеПула;         // ГвардДоступаКПулу (auth)
Перем Кэш;                // ЗаголовкиКэша (основа)
Перем АдресаКаталога;     // АдресаКаталога (web-ui) — дорога, под которой живёт пакет

#Область ТочкиМаршрута

// Отдаёт вкладку «Описание» — README пакета.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  pool             - Строка       - имя пула из пути.
//  name             - Строка       - имя пакета из пути.
//  ЗаголовкиЗапроса - Соответствие - для определения принципала.
//  КукиЗапроса      - Куки         - сессия и оформление читателя.
//
&ТочкаМаршрута("{pool}/{name}")
Процедура Показать(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса) Экспорт
	ОтдатьВкладку(Ответ, pool, name, "описание", ЗаголовкиЗапроса, КукиЗапроса);
КонецПроцедуры

// Отдаёт вкладку «Версии». По умолчанию версии сгруппированы по тегам; представление
// переключается параметром адреса, а не кукой, чтобы ссылку можно было отправить.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  pool             - Строка       - имя пула из пути.
//  name             - Строка       - имя пакета из пути.
//  ЗаголовкиЗапроса - Соответствие - для определения принципала.
//  КукиЗапроса      - Куки         - сессия и оформление читателя.
//  flat             - Строка       - (необязательный, по умолчанию "") непустое
//                     значение включает плоский список версий.
//
&ТочкаМаршрута("{pool}/{name}/versions")
Процедура Версии(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, flat = "") Экспорт
	ОтдатьВкладку(Ответ, pool, name, "версии", ЗаголовкиЗапроса, КукиЗапроса, ЗначениеЗаполнено(flat));
КонецПроцедуры

// Отдаёт вкладку «Зависимости» — связи в обе стороны.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  pool             - Строка       - имя пула из пути.
//  name             - Строка       - имя пакета из пути.
//  ЗаголовкиЗапроса - Соответствие - для определения принципала.
//  КукиЗапроса      - Куки         - сессия и оформление читателя.
//
&ТочкаМаршрута("{pool}/{name}/deps")
Процедура Зависимости(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса) Экспорт
	ОтдатьВкладку(Ответ, pool, name, "зависимости", ЗаголовкиЗапроса, КукиЗапроса);
КонецПроцедуры

// Legacy-адрес: перенаправляет на страницу пакета в найденном пуле.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  name             - Строка       - имя пакета из пути.
//  ЗаголовкиЗапроса - Соответствие - для определения принципала.
//  КукиЗапроса      - Куки         - оформление страницы 404.
//
&ТочкаМаршрута("package/{name}")
Процедура ЛегасиРедирект(Ответ, name, ЗаголовкиЗапроса, КукиЗапроса) Экспорт

	Если НЕ Гвард.Проверить(Ответ).Разрешено Тогда
		Возврат;
	КонецЕсли;

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);

	Найденный = НайтиПакетПоИмени(name, Принципал);

	Если Найденный = Неопределено Тогда
		ОтдатьНеНайдено(Ответ, СтрШаблон("Пакет «%1» не найден", name),
			Принципал.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Ответ.Перенаправить(СтрШаблон("/%1/%2", Найденный.Пул.Имя, Найденный.Пакет.Имя));

КонецПроцедуры

#КонецОбласти

#Область СборкаСтраницы

Процедура ОтдатьВкладку(Ответ, Знач pool, Знач name, Знач Вкладка, Знач ЗаголовкиЗапроса,
	Знач КукиЗапроса, Знач Плоско = Ложь)

	Если НЕ Гвард.Проверить(Ответ).Разрешено Тогда
		Возврат;
	КонецЕсли;

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);

	// приватный пул ⇒ приватны все его пакеты; нечитаемый и несуществующий дают один 404
	Пул = ЧтениеПула.ЧитаемыйПул(Принципал.Пользователь, pool, Принципал);
	Если Пул = Неопределено Тогда
		ОтдатьНеНайдено(Ответ, СтрШаблон("Пул «%1» не найден", pool),
			Принципал.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Пакет = СервисПакетов.НайтиПакет(Пул.Идентификатор, name);
	Если Пакет = Неопределено Тогда
		ОтдатьНеНайдено(Ответ, СтрШаблон("Пакет «%1» не найден в пуле «%2»", name, Пул.Имя),
			Принципал.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Контекст = КонтекстПакета(Пакет);

	// узел считается один раз на страницу: команд на вкладке версий столько же, сколько строк
	Узел = Команды.Узел(ЗаголовкиЗапроса);

	// подсказка установки стоит до вкладок: она отвечает на вопрос страницы, а не вкладки
	Контент = Шапка(Пул, Пакет, Контекст, Принципал.Пользователь, Узел)
		+ Подсказка.Карточка(Пул, Пакет.Имя, Узел)
		+ ПолосаВкладок(Пул, Пакет, Вкладка, Контекст.Версии.Количество())
		+ ТелоВкладки(Вкладка, Пул, Пакет, Контекст, Плоско, Принципал, Узел);

	// адрес страницы версии не называет, поэтому её ответ меняется с публикациями: он
	// переиспользуется коротким сроком, а приватный пул в общий кэш не попадает вовсе
	Кэш.ОтдатьСтраницу(Ответ, Каркас.Страница(Пакет.Имя, Контент,
		Каркас.КонтекстСтраницы(Принципал.Пользователь, КукиЗапроса, Ложь, Ложь, ДорогаЭкрана())),
		ГодитсяОбщемуКэшу(Пул, Принципал.Пользователь), ЗаголовкиЗапроса);

КонецПроцедуры

// Всё, что страница спрашивает у базы про сам пакет, — по одному разу на запрос: версии
// нужны шапке, счётчику вкладок и обеим таблицам, провенанс — плашке «с апстрима», значку
// шапки, кругу выбора версии по умолчанию и значкам каждой строки.
Функция КонтекстПакета(Знач Пакет)

	// имя «Версии» занято глобальным именем библиотеки semver: локальная переменная его не перебьёт
	СписокВерсий = СервисВерсий.ВерсииПакета(Пакет.Идентификатор);
	Происхождение = Провенанс.СнимокПакета(Пакет.Идентификатор);

	// страница говорит о версии, которую человек получит по `opm install <имя>`: отзыв
	// версии и смена канала по умолчанию меняют её без всякой публикации
	ПоУмолчанию = РезолверСпецификации.ВерсияПоУмолчанию(Пакет, СписокВерсий, Происхождение);

	Возврат Новый Структура("Версии, Происхождение, ПоУмолчанию",
		СписокВерсий, Происхождение, ПоУмолчанию);

КонецФункции

// В общий кэш годится только страница, одинаковая для ВСЕХ: публичный пул И зритель-гость.
// Вошедшему та же страница несёт его имя, роль и бейджи — отдай её общему кэшу, и соседний
// читатель получил бы её от прокси вместе с чужой учёткой в шапке.
Функция ГодитсяОбщемуКэшу(Знач Пул, Знач Пользователь)
	Возврат НЕ Команды.ТребуетКлюча(Пул) И Пользователь = Неопределено;
КонецФункции

Функция Шапка(Знач Пул, Знач Пакет, Знач Контекст, Знач Пользователь, Знач Узел)

	Модель = Витрина.ШапкаПакета(Пакет, АвторПакета(Пакет, Контекст.ПоУмолчанию),
		СкачиванийПакета(Пакет), Контекст.Происхождение.ЕстьСобственныеВерсии());
	// значок стоит у версии, которую человек получит по opm install без версии:
	// шапка говорит именно о ней
	ЗначкиВерсии.ДополнитьПлашки(Модель,
		Контекст.Происхождение.ЭтоДоверенныйКонвейер(Контекст.ПоУмолчанию));
	Модель.Вставить("Команда", Подсказка.КомандаШапки(Пул, Пакет.Имя, Узел));
	Модель.Вставить("Действия", ДействияШапки(Пул, Пакет, Пользователь));

	Возврат НаборUI.ШапкаОбъекта().Отрисовать(Модель);

КонецФункции

// Право берётся из модели прав, а не из авторства: кнопку видит и мейнтейнер с грантом.
Функция ДействияШапки(Знач Пул, Знач Пакет, Знач Пользователь)

	Если НЕ СлужбаКабинета.МожетУправлять(Пользователь, Пул, Пакет) Тогда
		Возврат "";
	КонецЕсли;

	Возврат НаборUI.Кнопка().Отрисовать(
		Новый Структура("Подпись, Адрес, Вариант, Иконка",
			"Настройки пакета", АдресВкладки(Пул, Пакет, "настройки"), "вторичная", "шестерёнка"));

КонецФункции

Функция ПолосаВкладок(Знач Пул, Знач Пакет, Знач Текущая, Знач ЧислоВерсий)

	Вкладки = Новый Массив();
	Вкладки.Добавить(Новый Структура("Подпись, Адрес, Активна, Иконка",
		"Описание", АдресВкладки(Пул, Пакет, "описание"), Текущая = "описание", "инфо"));
	Вкладки.Добавить(Новый Структура("Подпись, Адрес, Активна, Иконка, Счётчик",
		"Версии", АдресВкладки(Пул, Пакет, "версии"), Текущая = "версии", "тег",
		Формат(ЧислоВерсий, "ЧН=0; ЧГ=0")));
	Вкладки.Добавить(Новый Структура("Подпись, Адрес, Активна, Иконка",
		"Зависимости", АдресВкладки(Пул, Пакет, "зависимости"), Текущая = "зависимости", "ссылка"));

	Возврат НаборUI.Табы().Отрисовать(
		Новый Структура("Вкладки, Заголовок", Вкладки, "Разделы страницы пакета"));

КонецФункции

// Адрес вкладки — единственное место сборки: собранные на месте адреса разъезжаются.
//
// Параметры:
//  Пул     - Пул    - пул пакета.
//  Пакет   - Пакет  - пакет.
//  Вкладка - Строка - "описание" | "версии" | "зависимости" | "настройки".
//
// Возвращаемое значение:
//  Строка - относительный URL.
//
Функция АдресВкладки(Знач Пул, Знач Пакет, Знач Вкладка) Экспорт

	Основа = СтрШаблон("/%1/%2", Пул.Имя, Пакет.Имя);

	Если Вкладка = "версии" Тогда
		Возврат Основа + "/versions";
	ИначеЕсли Вкладка = "зависимости" Тогда
		Возврат Основа + "/deps";
	ИначеЕсли Вкладка = "настройки" Тогда
		Возврат Основа + "/settings";
	КонецЕсли;

	Возврат Основа;

КонецФункции

Функция ТелоВкладки(Знач Вкладка, Знач Пул, Знач Пакет, Знач Контекст,
	Знач Плоско, Знач Принципал, Знач Узел)

	Если Вкладка = "версии" Тогда
		Возврат ВкладкаВерсий.Отрисовать(Пул, Пакет, Контекст.Версии, Плоско, Узел,
			АдресВкладки(Пул, Пакет, "версии"), Контекст.Происхождение);
	ИначеЕсли Вкладка = "зависимости" Тогда
		Возврат ВкладкаЗависимостей(Пул, Пакет, Контекст.ПоУмолчанию, Принципал);
	КонецЕсли;

	Возврат ВкладкаОписания(Пул, Пакет, Контекст.ПоУмолчанию);

КонецФункции

#КонецОбласти

#Область Вкладки

Функция ВкладкаОписания(Знач Пул, Знач Пакет, Знач ВерсияПоУмолчанию)

	Если ВерсияПоУмолчанию = Неопределено Тогда
		Возврат ВерсииПоУмолчаниюНет();
	КонецЕсли;

	Представление = СлужбаREADME.ПредставлениеREADME(Пул, Пакет, ВерсияПоУмолчанию);

	Если НЕ Представление.ЕстьREADME Тогда
		Возврат НаборUI.ПустоеСостояние().Отрисовать(
			Новый Структура("Заголовок, Пояснение, Иконка",
				"У этой версии нет README",
				"Добавьте README.md в корень пакета — он появится здесь после публикации.",
				"инфо"));
	КонецЕсли;

	Возврат КарточкаОписания(Представление.HTML).Рендер();

КонецФункции

// «У этой версии нет README» назвало бы версию, которой нет, поэтому у случая свои слова.
Функция ВерсииПоУмолчаниюНет()

	Возврат НаборUI.ПустоеСостояние().Отрисовать(
		Новый Структура("Заголовок, Пояснение, Иконка",
			"У пакета нет версии по умолчанию",
			"Канал по умолчанию пуст: его версии отозваны либо в него ничего не добавляли."
			+ " Установка без версии сейчас тоже ничего не поставит — верните версию в канал"
			+ " или назначьте основным другой канал.",
			"инфо"));

КонецФункции

Функция КарточкаОписания(Знач ГотовыйREADME)

	Описание = Кит.Карточка(Новый Структура("Заголовок, Иконка", "Описание", "инфо"));
	Описание.Добавить(ЧужойДокумент(ГотовыйREADME));
	Возврат Описание;

КонецФункции

// README — чужой документ: деревом он не собирается никогда, доверенным его делает санитизация.
Функция ЧужойДокумент(Знач ГотоваяРазметка)

	Проза = Кит.Область("проза");
	Проза.Добавить(Кит.Готовое(ГотоваяРазметка));
	Возврат Проза;

КонецФункции

// Состав той же версии, о которой говорит вся страница: сменился канал — сменился и состав.
Функция ВкладкаЗависимостей(Знач Пул, Знач Пакет, Знач ВерсияПоУмолчанию, Знач Принципал)

	КтоЗависит = ХранилищеЗависимостей.КтоЗависитОт(Пакет.Имя);

	Компоненты = НаборUI;

	Ячейки = Новый Массив();
	Ячейки.Добавить(Компоненты.Карточка().Отрисовать(
		Новый Структура("Заголовок, Иконка, Тело", "Зависит от", "ссылка",
			ТелоЗависитОт(Пул, ВерсияПоУмолчанию))));
	Ячейки.Добавить(Компоненты.Карточка().Отрисовать(
		Новый Структура("Заголовок, Иконка, Тело", "Кто зависит", "ссылка",
			СписокКтоЗависит(КтоЗависит, Принципал))));

	Возврат Компоненты.Сетка().Отрисовать(
		Новый Структура("Ячейки, Колонки, Заголовок", Ячейки, 2, "Зависимости пакета"));

КонецФункции

// У пакета без версии по умолчанию «ни от чего не зависит» было бы неправдой.
Функция ТелоЗависитОт(Знач Пул, Знач ВерсияПоУмолчанию)

	Если ВерсияПоУмолчанию = Неопределено Тогда
		Возврат НаборUI.ПустоеСостояние().Отрисовать(
			Новый Структура("Пояснение, Компактное",
				"У пакета нет версии по умолчанию — показывать нечего", Истина));
	КонецЕсли;

	Возврат СписокЗависитОт(Пул,
		ХранилищеЗависимостей.ПоВерсии(ВерсияПоУмолчанию.Идентификатор));

КонецФункции

Функция СписокЗависитОт(Знач Пул, Знач Зависимости)

	Компоненты = НаборUI;

	Если Зависимости.Количество() = 0 Тогда
		Возврат Компоненты.ПустоеСостояние().Отрисовать(
			Новый Структура("Пояснение, Компактное", "Пакет ни от чего не зависит", Истина));
	КонецЕсли;

	Строки = Новый Массив();
	Для Каждого Зав Из Зависимости Цикл
		Ячейки = Новый Массив();
		Ячейки.Добавить(ЯчейкаЦели(Пул, Зав));
		Ячейки.Добавить(ДиапазонТекстом(Зав.ВерсияМин, Зав.ВерсияМакс));
		Ячейки.Добавить(Новый Структура("HTML", ?(Зав.ДляРазработки = Истина,
			Компоненты.Тег().Отрисовать("для разработки"), "")));
		Строки.Добавить(Ячейки);
	КонецЦикла;

	Колонки = Новый Массив();
	Колонки.Добавить("Пакет");
	Колонки.Добавить("Диапазон");
	Колонки.Добавить("");

	Возврат Компоненты.Таблица().Отрисовать(
		Новый Структура("Колонки, Строки", Колонки, Строки));

КонецФункции

// Кросс-пульный поиск не делается: имя зависимости адресует пакет в том же пуле.
Функция ЯчейкаЦели(Знач Пул, Знач Зав)

	Имя = ИмяЦели(Зав);

	Пакет = СервисПакетов.НайтиПакет(Пул.Идентификатор, Имя);
	Если Пакет = Неопределено Тогда
		Возврат Имя;
	КонецЕсли;

	Возврат Новый Структура("HTML",
		Экран.Ссылка(СтрШаблон("/%1/%2", Пул.Имя, Пакет.Имя), Пакет.Имя));

КонецФункции

// Каноническое имя цели зависимости. Вторая сеть под строки старых сборок: у них канон
// пуст, и без вывода из написания автора ячейка осталась бы безымянной. Данные чинит
// старт хаба, поэтому в боевой выдаче эта ветка не работает — она держит показ ровно
// тогда, когда починка не отработала.
//
// Параметры:
//  Зав - ЗависимостьВерсии - строка зависимости.
//
// Возвращаемое значение:
//  Строка - каноническое (нижнерегистровое) имя пакета-цели.
//
Функция ИмяЦели(Знач Зав) Экспорт

	Если ЗначениеЗаполнено(Зав.ИмяПакетаНижнийРегистр) Тогда
		Возврат Зав.ИмяПакетаНижнийРегистр;
	КонецЕсли;

	Возврат НРег(СокрЛП(Строка(Зав.ИмяПакета)));

КонецФункции

Функция СписокКтоЗависит(Знач Зависимости, Знач Принципал)

	Компоненты = НаборUI;

	Видимые = ВидимыеЗависящие(Зависимости, Принципал);

	// пустое состояние считается ПОСЛЕ отбора: таблица без строк сама говорила бы,
	// что зависящие есть, просто читателю их не показали
	Если Видимые.Количество() = 0 Тогда
		Возврат Компоненты.ПустоеСостояние().Отрисовать(
			Новый Структура("Пояснение, Компактное", "От пакета никто не зависит", Истина));
	КонецЕсли;

	// детерминированный порядок обязателен
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Ключ");
	Таблица.Колонки.Добавить("Пакет");
	Таблица.Колонки.Добавить("Пул");
	Для Каждого КиЗ Из Видимые Цикл
		Строка = Таблица.Добавить();
		Строка.Ключ = КиЗ.Ключ;
		Строка.Пакет = КиЗ.Значение.Пакет;
		Строка.Пул = КиЗ.Значение.Пул;
	КонецЦикла;
	Таблица.Сортировать("Ключ Возр");

	Строки = Новый Массив();
	Для Каждого Строка Из Таблица Цикл
		Ячейки = Новый Массив();
		Ячейки.Добавить(Новый Структура("HTML", Экран.Ссылка(
			СтрШаблон("/%1/%2", Строка.Пул.Имя, Строка.Пакет.Имя), Строка.Пакет.Имя)));
		Ячейки.Добавить(Строка.Пул.Имя);
		Строки.Добавить(Ячейки);
	КонецЦикла;

	Колонки = Новый Массив();
	Колонки.Добавить("Пакет");
	Колонки.Добавить("Пул");

	Возврат Компоненты.Таблица().Отрисовать(
		Новый Структура("Колонки, Строки", Колонки, Строки));

КонецФункции

// Отбор правом ЧИТАТЕЛЯ на пул зависящего: иначе страница называла бы приватные имена.
// Версии и пакеты читаются двумя разрезами на весь список: у популярного пакета зависящих
// сотни, и пара вопросов на строку сделала бы вкладку дороже во столько же раз.
Функция ВидимыеЗависящие(Знач Зависимости, Знач Принципал)

	// имя «Версии» занято глобальным именем библиотеки semver: локальная переменная его не перебьёт
	ПоВерсиям = ПоИдентификаторам(
		СервисВерсий.ВерсииПоИдентификаторам(Номера(Зависимости, "ВерсияИдентификатор")));
	ПоПакетам = ПоИдентификаторам(
		СервисПакетов.ПакетыПоИдентификаторам(НомераПакетовВерсий(ПоВерсиям)));

	Результат = Новый Соответствие();
	Решения = Новый Соответствие();

	Для Каждого Зав Из Зависимости Цикл

		Версия = ПоВерсиям.Получить(Цел(Зав.ВерсияИдентификатор));
		Если Версия = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Пакет = ПоПакетам.Получить(Цел(Версия.ПакетИдентификатор));
		Если Пакет = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Пул = ЧитаемыйПулПакета(Принципал, Пакет.ПулИдентификатор, Решения);
		Если Пул = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Результат.Вставить(Пакет.ИмяНижнийРегистр, Новый Структура("Пакет, Пул", Пакет, Пул));

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПоИдентификаторам(Знач Записи)

	Результат = Новый Соответствие();
	Для Каждого Запись Из Записи Цикл
		Результат.Вставить(Цел(Запись.Идентификатор), Запись);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Номера(Знач Записи, Знач ИмяПоля)

	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Результат.Добавить(Цел(Запись[ИмяПоля]));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НомераПакетовВерсий(Знач Версии)

	Результат = Новый Массив();
	Для Каждого Пара Из Версии Цикл
		Результат.Добавить(Цел(Пара.Значение.ПакетИдентификатор));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пакет нечитаемого пула не находится вовсе: адрес перенаправления назвал бы и пул.
// Имя спрашивается отбором, а не перебором всей таблицы: легаси-адрес открывают
// поисковики и старые ссылки, и цена у него не должна расти вместе с хабом.
Функция НайтиПакетПоИмени(Знач Имя, Знач Принципал)

	Решения = Новый Соответствие();

	Для Каждого Пакет Из СервисПакетов.ОдноимённыеПакеты(?(Имя = Неопределено, "", Имя)) Цикл
		Пул = ЧитаемыйПулПакета(Принципал, Пакет.ПулИдентификатор, Решения);
		Если Пул <> Неопределено Тогда
			Возврат Новый Структура("Пакет, Пул", Пакет, Пул);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Решение по пулу считается один раз на пул: строк одного пула в списке много.
Функция ЧитаемыйПулПакета(Знач Принципал, Знач ПулИдентификатор, Решения)

	Ключ = Цел(ПулИдентификатор);
	Решение = Решения.Получить(Ключ);

	Если Решение = Неопределено Тогда
		Пул = СервисПулов.ПулПоИдентификатору(Ключ);
		Если Пул <> Неопределено Тогда
			Пул = ЧтениеПула.ЧитаемыйПул(Принципал.Пользователь, Пул.Имя, Принципал);
		КонецЕсли;
		Решение = Новый Структура("Пул", Пул);
		Решения.Вставить(Ключ, Решение);
	КонецЕсли;

	Возврат Решение.Пул;

КонецФункции

// Витрина пакета не должна падать из-за сбоя stats — при ошибке показываем 0.
Функция СкачиванийПакета(Знач Пакет)
	Попытка
		Возврат СлужбаСтатистики.СкачиванийПакета(Пакет.Идентификатор);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция АвторПакета(Знач Пакет, Знач ВерсияПоУмолчанию)
	Если ВерсияПоУмолчанию <> Неопределено И ЗначениеЗаполнено(ВерсияПоУмолчанию.АвторМанифеста) Тогда
		Возврат ВерсияПоУмолчанию.АвторМанифеста;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ДиапазонТекстом(Знач Мин, Знач Макс)
	ЕстьМин = ЗначениеЗаполнено(Мин);
	ЕстьМакс = ЗначениеЗаполнено(Макс);
	Если ЕстьМин И ЕстьМакс Тогда
		Возврат СтрШаблон(">=%1, <=%2", Мин, Макс);
	ИначеЕсли ЕстьМин Тогда
		Возврат СтрШаблон(">=%1", Мин);
	ИначеЕсли ЕстьМакс Тогда
		Возврат СтрШаблон("<=%1", Макс);
	КонецЕсли;
	Возврат "любая";
КонецФункции

// Сообщение приходит СЫРЫМ, экранирует получатель — общий контракт одноимённых процедур слоя.
Процедура ОтдатьНеНайдено(Ответ, Знач Сообщение, Знач Пользователь, Знач КукиЗапроса)
	Ответ.УстановитьСостояниеНеНайдено();
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница("Не найдено",
		НаборUI.СтраницаОшибки().Отрисовать(
			Новый Структура("Код, Сообщение", 404, Сообщение))
			+ Экран.Ссылка(АдресаКаталога.Каталог(), "← К каталогу"),
		Каркас.КонтекстСтраницы(Пользователь, КукиЗапроса, Ложь, Ложь, ДорогаЭкрана()));
КонецПроцедуры

// Своей дороги в меню у страницы пакета нет: её адрес — «/<пул>/<пакет>», и заводить
// дорогу на каждый пакет бессмысленно. Пакет живёт ПОД КАТАЛОГОМ и открывается из него,
// поэтому экран называет каталог: иначе рейка гасла бы на самой посещаемой странице хаба.
Функция ДорогаЭкрана()
	Возврат АдресаКаталога.Каталог();
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "РезолверСпецификации") _РезолверСпецификации,
	&Пластилин(Значение = "СервисПроисхождения") _Провенанс,
	&Пластилин(Значение = "ХранилищеЗависимостей") _ХранилищеЗависимостей,
	&Пластилин(Значение = "СлужбаREADME") _СлужбаREADME,
	&Пластилин(Значение = "КомандыOpm") _Команды,
	&Пластилин(Значение = "ПодсказкаУстановки") _Подсказка,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "НаборКомпонентов") _НаборUI,
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ВитринаПакетов") _Витрина,
	&Пластилин(Значение = "ЗначкиВерсии") _ЗначкиВерсии,
	&Пластилин(Значение = "ВкладкаВерсий") _ВкладкаВерсий,
	&Пластилин(Значение = "СлужбаКабинета") _СлужбаКабинета,
	&Пластилин(Значение = "СлужбаСтатистикиСкачиваний") _СлужбаСтатистики,
	&Пластилин(Значение = "ГвардОнбординга") _Гвард,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "ГвардДоступаКПулу") _ЧтениеПула,
	&Пластилин(Значение = "ЗаголовкиКэша") _Кэш,
	&Пластилин(Значение = "АдресаКаталога") _АдресаКаталога)

	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;
	РезолверСпецификации = _РезолверСпецификации;
	Провенанс = _Провенанс;
	ХранилищеЗависимостей = _ХранилищеЗависимостей;
	СлужбаREADME = _СлужбаREADME;
	Команды = _Команды;
	Подсказка = _Подсказка;
	Кит = _Кит;
	Каркас = _Каркас;
	НаборUI = _НаборUI;
	Экран = _Экран;
	Витрина = _Витрина;
	ЗначкиВерсии = _ЗначкиВерсии;
	ВкладкаВерсий = _ВкладкаВерсий;
	СлужбаКабинета = _СлужбаКабинета;
	СлужбаСтатистики = _СлужбаСтатистики;
	Гвард = _Гвард;
	Перехватчик = _Перехватчик;
	ЧтениеПула = _ЧтениеПула;
	Кэш = _Кэш;
	АдресаКаталога = _АдресаКаталога;

КонецПроцедуры
