// Подсказка установки на странице пакета: адресная команда для шапки, памятка про установку
// из скачанного файла и карточка легаси-флоу для клиентов, которые адресовать пул не умеют.

Перем Команды;    // КомандыOpm
Перем Тексты;     // ТекстыИнтерфейса
Перем Кит;        // Кит (oscript-ui) — фабрика элементов экрана

// Модель команды установки для шапки объекта.
//
// Параметры:
//  Пул       - Пул, Неопределено - пул пакета.
//  ИмяПакета - Строка - имя пакета.
//  Узел      - Строка - узел хаба (КомандыOpm.Узел()).
//
// Возвращаемое значение:
//  Структура - модель компонента «Блок команды».
//
Функция КомандаШапки(Знач Пул, Знач ИмяПакета, Знач Узел) Экспорт

	Пояснение = ?(Команды.КороткаяФорма(Пул),
		Тексты.Текст("public.package.install.hint-short"),
		Тексты.Шаблон("public.package.install.hint-address", ВерсияКлиента()));

	Возврат Новый Структура("Команда, Пояснение",
		Команды.Установка(Пул, ИмяПакета, Узел), Пояснение);

КонецФункции

// Памятка рядом с кнопкой скачивания: чем поставить скачанный файл. Без неё кнопка
// выглядит украшением, а не способом установки без сети.
//
// Возвращаемое значение:
//  Строка - фрагмент примечания.
//
Функция ПамяткаПроСкачанныйФайл() Экспорт

	Фраза = Кит.Шаблон(Тексты.Текст("public.package.download.offline"));
	Фраза.Добавить(Кит.Код(Команды.УстановкаИзФайла()));

	Приписка = Кит.Примечание();
	Приписка.Добавить(Фраза);

	Возврат Приписка.Рендер();

КонецФункции

// Карточка со вторым способом установки — тем, который понимает штатный клиент.
//
// Параметры:
//  Пул       - Пул, Неопределено - пул пакета.
//  ИмяПакета - Строка - имя пакета.
//  Узел      - Строка - узел хаба (КомандыOpm.Узел()).
//
// Возвращаемое значение:
//  Строка - фрагмент карточки.
//
Функция Карточка(Знач Пул, Знач ИмяПакета, Знач Узел) Экспорт

	Способ = Кит.Карточка(Новый Структура("Заголовок, Иконка, Описание",
		Тексты.Шаблон("public.package.install.title", ВерсияКлиента()),
		"скачать",
		Тексты.Шаблон("public.package.install.lead", ВерсияКлиента())));

	Способ.Добавить(ПропискаПулаВКонфиге(Пул, Узел));
	Способ.Добавить(УстановкаИзПрописанногоПула(Пул, ИмяПакета));
	Способ.Добавить(ОговоркаПроКлюч(Пул));

	Возврат Способ.Рендер();

КонецФункции

#Область СоставКарточки

Функция ПропискаПулаВКонфиге(Знач Пул, Знач Узел)

	Возврат Кит.БлокКоманды(Новый Структура("Команда, Пояснение, БезКопирования",
		Команды.ОписаниеСервера(Пул, Узел),
		Тексты.Текст("public.package.install.config"), Истина));

КонецФункции

Функция УстановкаИзПрописанногоПула(Знач Пул, Знач ИмяПакета)

	Возврат Кит.БлокКоманды(Новый Структура("Команда, Пояснение",
		Команды.УстановкаЧерезСервер(Пул, ИмяПакета),
		Тексты.Текст("public.package.install.by-server")));

КонецФункции

// Оговорка стоит рядом с командой; у публичного пула её на экране нет вовсе.
Функция ОговоркаПроКлюч(Знач Пул)

	Если НЕ Команды.ТребуетКлюча(Пул) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Примечание(Тексты.Текст("public.package.install.private"));

КонецФункции

#КонецОбласти

// Версию клиента знает КомандыOpm: второго места, где она названа, быть не должно.
Функция ВерсияКлиента()
	Возврат Команды.ВерсияКлиентаСАдресациейПула();
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КомандыOpm") _Команды,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "Кит") _Кит)

	Команды = _Команды;
	Тексты = _Тексты;
	Кит = _Кит;

КонецПроцедуры
