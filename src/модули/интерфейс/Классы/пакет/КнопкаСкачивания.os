// Кнопка-значок «скачать .ospx» на странице пакета. Форм столько же, сколько у адреса
// выдачи; подпись и подсказка называют файл, который человек получит по клику.

Перем НаборUI;  // НаборКомпонентов (кит)
Перем Тексты;   // ТекстыИнтерфейса (кит)
Перем Адреса;   // АдресаВыдачи (api) — единственный сборщик пути артефакта

#Область ПубличныйИнтерфейс

// Кнопка шапки: отдаёт то же, что `opm install <имя>` без версии. Адрес версии не называет,
// поэтому имя файла берётся из версии, о которой говорит страница.
//
// Параметры:
//  Пул       - Пул - пул пакета.
//  ИмяПакета - Строка - имя пакета.
//  Версия    - ВерсияПакета, Неопределено - версия установки без координаты; Неопределено —
//              скачивать нечего, и кнопки нет.
//
// Возвращаемое значение:
//  Строка - фрагмент кнопки либо пустая строка.
//
Функция ВерсииПоУмолчанию(Знач Пул, Знач ИмяПакета, Знач Версия) Экспорт

	Если Версия = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Файл = ИмяАртефакта(ИмяПакета, Версия);

	Возврат Кнопка(Адреса.ОсновнойТег(Пул.Имя, ИмяПакета), Файл,
		Тексты.Шаблон("public.package.download.default.hint", Файл));

КонецФункции

// Кнопка строки канала: адрес называет тег, и версию под ним хаб выбирает в момент клика.
//
// Параметры:
//  Пул        - Пул - пул пакета.
//  ИмяПакета  - Строка - имя пакета.
//  ИмяТега    - Строка - имя канала.
//  Отдаваемая - ВерсияПакета, Неопределено - версия, которую канал отдаёт сейчас;
//               Неопределено — канал пуст, и кнопки нет.
//
// Возвращаемое значение:
//  Строка - фрагмент кнопки либо пустая строка.
//
Функция ВерсииКанала(Знач Пул, Знач ИмяПакета, Знач ИмяТега, Знач Отдаваемая) Экспорт

	Если Отдаваемая = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Файл = ИмяАртефакта(ИмяПакета, Отдаваемая);

	Возврат Кнопка(Адреса.ПоТегу(Пул.Имя, ИмяПакета, ИмяТега), Файл,
		Тексты.Шаблон("public.package.download.channel.hint", Файл, ИмяТега));

КонецФункции

// Кнопка строки версии: адрес называет версию, и по нему всегда лежит один и тот же файл.
// Отозванная версия исключением не является — точная координата достаётся всегда.
//
// Параметры:
//  Пул       - Пул - пул пакета.
//  ИмяПакета - Строка - имя пакета.
//  Версия    - ВерсияПакета - версия строки.
//
// Возвращаемое значение:
//  Строка - фрагмент кнопки.
//
Функция ТочнойВерсии(Знач Пул, Знач ИмяПакета, Знач Версия) Экспорт

	Файл = ИмяАртефакта(ИмяПакета, Версия);

	Возврат Кнопка(Адреса.ТочнаяВерсия(Пул.Имя, ИмяПакета, Версия.Версия), Файл, "");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Значок без видимой надписи: подпись читает скринридер, подсказку — курсор.
Функция Кнопка(Знач Адрес, Знач ИмяФайла, Знач Подсказка)

	Модель = Новый Структура("Подпись, Адрес, Иконка, Вариант, Размер, ТолькоИконка",
		Тексты.Шаблон("public.package.download.label", ИмяФайла),
		Адрес, "скачать", "вторичная", "малый", Истина);

	// подсказка ставится только там, где ей есть что добавить к подписи: пустая перебила бы
	// правило кита «у значка подсказка равна подписи»
	Если ЗначениеЗаполнено(Подсказка) Тогда
		Модель.Вставить("Подсказка", Подсказка);
	КонецЕсли;

	Возврат НаборUI.Кнопка().Отрисовать(Модель);

КонецФункции

Функция ИмяАртефакта(Знач ИмяПакета, Знач Версия)
	Возврат СтрШаблон("%1-%2.ospx", ИмяПакета, Версия.Версия);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "НаборКомпонентов") _НаборUI,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаВыдачи") _Адреса) Экспорт

	НаборUI = _НаборUI;
	Тексты = _Тексты;
	Адреса = _Адреса;

КонецПроцедуры
