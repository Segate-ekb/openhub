// Значки состояния версии — желудь модуля web-ui: происхождение, способ приёма и отзыв.
// Один источник значков на все экраны, где человек видит версию, и для шапки пакета.

Перем Кит;     // Кит (кит) — фабрика элементов экрана
Перем Тексты;  // ТекстыИнтерфейса (кит)

// Ключ доверенной публикации — иконка без текста: стоит в одной строке с номером версии.
// Вид нейтральный: значок называет механизм приёма, а не выдаёт версии оценку.
//
// Параметры:
//  Доверенная - Булево - версия принята доверенной публикацией.
//
// Возвращаемое значение:
//  ЭлементЭкрана - иконка с подписью; у версии без доверенной публикации — ничего.
//
Функция Ключ(Знач Доверенная) Экспорт

	Если Доверенная <> Истина Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Иконка(Новый Структура("Имя, Подпись", ГлифКлюча(),
		Тексты.Текст("public.package.version.trusted")));

КонецФункции

// Признаки шапки пакета — значки сразу за его именем. Шапка говорит о версии, которую
// получит установка без указания версии, поэтому ключ стоит, когда доверенная — она.
//
// Параметры:
//  Доверенная - Булево - версия, о которой говорит шапка, принята доверенной публикацией.
//
// Возвращаемое значение:
//  Массив из Структура - Иконка, Подпись; пустой у версии без доверенной публикации.
//
Функция ПризнакиШапки(Знач Доверенная) Экспорт

	Признаки = Новый Массив();
	Если Доверенная = Истина Тогда
		Признаки.Добавить(Новый Структура("Иконка, Подпись", ГлифКлюча(),
			Тексты.Текст("public.package.version.trusted")));
	КонецЕсли;
	Возврат Признаки;

КонецФункции

// Текстовые признаки версии плашками в порядке «откуда — в каком состоянии». Своей обёртки
// у них нет: в строку или под номер их ставит экран.
//
// Параметры:
//  Модель - Структура - САпстрима (Булево), Отозвана (Булево). Отсутствующее поле
//           считается Ложью.
//
// Возвращаемое значение:
//  ЭлементЭкрана - холст плашек; пустой, если ни один признак не поднят.
//
Функция Плашки(Знач Модель) Экспорт

	Признаки = Кит.Холст();

	Если Флаг(Модель, "САпстрима") Тогда
		Признаки.Добавить(Кит.Плашка(Новый Структура("Текст, Вид, Подсказка",
			Тексты.Текст("public.package.version.upstream"), "accent",
			Тексты.Текст("public.package.version.upstream.hint"))));
	КонецЕсли;

	Если Флаг(Модель, "Отозвана") Тогда
		Признаки.Добавить(Кит.Плашка(Новый Структура("Текст, Вид, Подсказка",
			Тексты.Текст("public.package.version.yanked"), "warn",
			Тексты.Текст("public.package.version.yanked.hint"))));
	КонецЕсли;

	Возврат Признаки;

КонецФункции

// Легенда ключа — строка под таблицей версий. Текста на экране у ключа нет, а смысл экрана
// не должен держаться на наведении, поэтому там, где ключ нарисован хоть раз, его называет
// легенда; где не нарисован — ей объяснять нечего.
//
// Параметры:
//  ПоказанныеВерсии - Массив из ВерсияПакета - версии, которые показывает таблица.
//  ДоверенныеВерсии - Соответствие - идентификатор версии в Истина: версии пакета,
//                     принятые доверенной публикацией.
//
// Возвращаемое значение:
//  ЭлементЭкрана - примечание «ключ — что он значит» либо ничего.
//
Функция Легенда(Знач ПоказанныеВерсии, Знач ДоверенныеВерсии) Экспорт

	Для Каждого Версия Из ПоказанныеВерсии Цикл
		Если ДоверенныеВерсии.Получить(Версия.Идентификатор) = Истина Тогда
			Возврат ЛегендаКлюча();
		КонецЕсли;
	КонецЦикла;

	Возврат Кит.Ничего();

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ЛегендаКлюча()

	Примечание = Кит.Примечание();
	Пояснение = Примечание.Добавить(Кит.Шаблон(Тексты.Текст("public.package.version.trusted.legend")));
	// значок здесь декоративный: его называет сама фраза, второй раз скринридеру он не нужен
	Пояснение.Добавить(Кит.Иконка(ГлифКлюча()));
	Возврат Примечание;

КонецФункции

// Глиф «ключ» — тот же, что у раздела «Доверенная публикация» в настройках. Шестерёнку
// не брать: на этих экранах она значит «настройки».
Функция ГлифКлюча()
	Возврат "ключ";
КонецФункции

Функция Флаг(Знач Модель, Знач Имя)
	Значение = Неопределено;
	Если ТипЗнч(Модель) <> Тип("Структура") ИЛИ НЕ Модель.Свойство(Имя, Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Значение = Истина;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;

КонецПроцедуры
