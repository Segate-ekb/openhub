// Значки состояния версии — желудь модуля web-ui: происхождение, способ приёма и отзыв.
// Один источник значков на все экраны, где человек видит версию.

Перем Плашки;  // Плашка (кит)
Перем Тексты;  // ТекстыИнтерфейса (кит)

// Модели значков версии в порядке «откуда — как принята — в каком состоянии».
//
// Параметры:
//  Модель - Структура - САпстрима (Булево), ДоверенныйКонвейер (Булево),
//           Отозвана (Булево). Отсутствующее поле считается Ложью.
//
// Возвращаемое значение:
//  Массив - модели компонента Плашка; пустой, если ни один признак не поднят.
//
Функция Модели(Знач Модель) Экспорт

	Результат = Новый Массив();

	Если Флаг(Модель, "САпстрима") Тогда
		Результат.Добавить(Новый Структура("Текст, Вид, Подсказка",
			Тексты.Текст("public.package.version.upstream"), "accent",
			Тексты.Текст("public.package.version.upstream.hint")));
	КонецЕсли;

	МодельДоверия = МодельДоверенногоКонвейера(Флаг(Модель, "ДоверенныйКонвейер"));
	Если МодельДоверия <> Неопределено Тогда
		Результат.Добавить(МодельДоверия);
	КонецЕсли;

	Если Флаг(Модель, "Отозвана") Тогда
		Результат.Добавить(Новый Структура("Текст, Вид, Подсказка",
			Тексты.Текст("public.package.version.yanked"), "warn",
			Тексты.Текст("public.package.version.yanked.hint")));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Значок доверенной публикации отдельной моделью — для шапок и списков, где остальные
// признаки печатаются своими средствами. Вид нейтральный: значок называет механизм
// приёма, а не выдаёт версии оценку — версия без него ничем не хуже.
//
// Параметры:
//  Доверенная - Булево - версия принята доверенной публикацией.
//
// Возвращаемое значение:
//  Структура, Неопределено - модель компонента Плашка; Неопределено — значка нет.
//
Функция МодельДоверенногоКонвейера(Знач Доверенная) Экспорт

	Если Доверенная <> Истина Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Текст, Вид, Иконка, Подсказка",
		Тексты.Текст("public.package.version.trusted"), "", "шестерёнка",
		Тексты.Текст("public.package.version.trusted.hint"));

КонецФункции

// Дописывает значок доверенной публикации к плашкам модели шапки объекта: шапка печатает
// признаки объекта одним рядом, отдельного поля под значок в ней нет.
//
// Параметры:
//  Модель - Структура - модель шапки; поле «Плашки» создаётся, если его не было.
//  Доверенная - Булево - версия принята доверенной публикацией.
//
Процедура ДополнитьПлашки(Модель, Знач Доверенная) Экспорт

	Значок = МодельДоверенногоКонвейера(Доверенная);
	Если Значок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Имеющиеся = Неопределено;
	Набор = Новый Массив();
	Если Модель.Свойство("Плашки", Имеющиеся) И ТипЗнч(Имеющиеся) = Тип("Массив") Тогда
		Для Каждого Элемент Из Имеющиеся Цикл
			Набор.Добавить(Элемент);
		КонецЦикла;
	КонецЕсли;
	Набор.Добавить(Значок);
	Модель.Вставить("Плашки", Набор);

КонецПроцедуры

// Готовый HTML значков версии — для ячейки таблицы.
//
// Параметры:
//  Модель - Структура - см. Модели.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент; "" — если ни один признак не поднят.
//
Функция Отрисовать(Знач Модель) Экспорт

	Результат = "";
	Для Каждого Значок Из Модели(Модель) Цикл
		Результат = Результат + Плашки.Отрисовать(Значок);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция Флаг(Знач Модель, Знач Имя)
	Значение = Неопределено;
	Если ТипЗнч(Модель) <> Тип("Структура") ИЛИ НЕ Модель.Свойство(Имя, Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Значение = Истина;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Плашка") _Плашки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Плашки = _Плашки;
	Тексты = _Тексты;

КонецПроцедуры
