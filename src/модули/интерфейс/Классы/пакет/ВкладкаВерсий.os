// Вкладка «Версии» страницы пакета: два представления состава — группировка по каналам
// и плоский список. Переключатель — обычная ссылка: состояние живёт в адресе, а не в куке.

Перем Кит;           // Кит (oscript-ui) — фабрика элементов экрана
Перем НаборUI;       // НаборКомпонентов (кит)
Перем Тексты;        // ТекстыИнтерфейса (кит)
Перем Экран;         // ЭкранированиеHTML (кит)
Перем СервисТегов;   // СервисТегов (реестр)
Перем Команды;       // КомандыOpm (web-ui)
Перем Плашки;        // ПлашкаТега (web-ui) — единственный рендер тега
Перем ЗначкиВерсии;  // ЗначкиВерсии (web-ui)

#Область ПубличныйИнтерфейс

// Два представления: группировка по каналам отвечает на «что поставится», плоский
// список — на «что вообще публиковалось и когда». Пакет без единого тега печатается
// плоским списком независимо от переключателя: группировать нечего.
//
// Параметры:
//  Пул - Пул - пул пакета.
//  Пакет - Пакет - пакет.
//  СписокВерсий - Массив из ВерсияПакета - версии пакета.
//  Плоско - Булево - Истина: плоский список вместо группировки по каналам.
//  Узел - Строка - узел хаба для команд установки.
//  АдресВкладки - Строка - адрес самой вкладки: основа переключателя представления.
//  Происхождение - СнимокПровенанса - провенанс пакета, снятый страницей один раз:
//                  значки каждой строки — ответы этого снимка.
//
// Возвращаемое значение:
//  Строка - фрагмент страницы.
//
Функция Отрисовать(Знач Пул, Знач Пакет, Знач СписокВерсий, Знач Плоско, Знач Узел,
	Знач АдресВкладки, Знач Происхождение) Экспорт

	Компоненты = НаборUI;

	Если СписокВерсий.Количество() = 0 Тогда
		Возврат Компоненты.ПустоеСостояние().Отрисовать(
			Новый Структура("Заголовок, Пояснение, Иконка",
				"Нет опубликованных версий",
				"Опубликуйте первую версию командой opm push.", "тег"));
	КонецЕсли;

	Если НЕ Плоско Тогда
		Каналы = СервисТегов.КаналыПакета(Пакет.Идентификатор, СписокВерсий).Каналы;
		Если Каналы.Количество() > 0 Тогда
			Возврат ТаблицаКаналов(Пул, Пакет, Каналы, Узел)
				+ ПереключательПредставления(АдресВкладки, Ложь);
		КонецЕсли;
	КонецЕсли;

	Возврат ПлоскийСписокВерсий(Пул, Пакет, СписокВерсий, Узел, Происхождение)
		+ ПереключательПредставления(АдресВкладки, Истина);

КонецФункции

Функция ТаблицаКаналов(Знач Пул, Знач Пакет, Знач Каналы, Знач Узел)

	Компоненты = НаборUI;

	Строки = Новый Массив();
	Для Каждого Канал Из Каналы Цикл

		Отдаваемая = Канал.Отдаваемая;
		КомандаКанала = Команды.Установка(Пул, Пакет.Имя, Узел, Канал.Тег.Имя);

		Ячейки = Новый Массив();
		Ячейки.Добавить(Новый Структура("HTML", Плашки.Канал(Канал.Тег,
			Новый Структура("Подсказка",
				Тексты.Шаблон("public.package.channel.hint", КомандаКанала))).Рендер()));
		Ячейки.Добавить(Новый Структура("HTML", ?(Отдаваемая = Неопределено,
			Прочерк(), МашинноеЗначение(Отдаваемая.Версия))));
		Ячейки.Добавить(Новый Структура("HTML", ?(Отдаваемая = Неопределено, "",
			Компоненты.БлокКоманды().Отрисовать(КомандаКанала))));
		Ячейки.Добавить(Новый Структура("HTML", ИсторияКанала(Канал)));
		Строки.Добавить(Ячейки);

	КонецЦикла;

	Колонки = Новый Массив();
	Колонки.Добавить("Канал");
	Колонки.Добавить("Актуальная версия");
	Колонки.Добавить("Установка");
	Колонки.Добавить("История");

	Возврат Компоненты.Таблица().Отрисовать(
		Новый Структура("Колонки, Строки, Подпись", Колонки, Строки, "Каналы пакета"));

КонецФункции

// Отозванные из состава не выпадают, а помечаются: иначе история врала бы о том, что можно поставить.
Функция ИсторияКанала(Знач Канал)

	Состав = Канал.Состав;
	Если Состав.Количество() = 0 Тогда
		Возврат Прочерк();
	КонецЕсли;

	Пункты = "";
	Для Каждого Версия Из УпорядочитьПоУбыванию(Состав) Цикл
		Пункты = Пункты + СтрШаблон("<li>%1 %2 %3</li>",
			МашинноеЗначение(Версия.Версия),
			?(Версия.Отозвана = Истина, НаборUI.Тег().Отрисовать(
				Новый Структура("Текст, Вид", "отозвана", "warn")), ""),
			ДатаТекстом(Версия.Опубликована));
	КонецЦикла;

	Возврат СтрШаблон("<details><summary>%1</summary><ul>%2</ul></details>",
		Экран.Экранировать(СтрШаблон("версий: %1",
			Формат(Состав.Количество(), "ЧГ=0; ЧН=0"))), Пункты);

КонецФункции

// Ссылка, а не тумблер: состояние живёт в адресе.
Функция ПереключательПредставления(Знач Основа, Знач СейчасПлоско)

	Приписка = Кит.Примечание();
	Приписка.Добавить(?(СейчасПлоско,
		Переход(Основа, "Сгруппировать версии по тегам"),
		Переход(Основа + "?flat=1", "Показать все версии списком")));

	Возврат Приписка.Рендер();

КонецФункции

Функция ПлоскийСписокВерсий(Знач Пул, Знач Пакет, Знач СписокВерсий, Знач Узел, Знач Происхождение)

	Компоненты = НаборUI;

	// раскладка одним проходом: перебор тегов на строку дал бы N×M
	ТегиВерсий = СервисТегов.ТегиПоВерсиям(Пакет.Идентификатор, СписокВерсий);
	Подсказки = ПодсказкиКаналов(Пул, Пакет, Узел, ТегиВерсий);

	Строки = Новый Массив();
	Для Каждого Версия Из УпорядочитьПоУбыванию(СписокВерсий) Цикл

		Ячейки = Новый Массив();
		Ячейки.Добавить(Новый Структура("HTML", ЯчейкаВерсии(Версия, Происхождение)));
		Ячейки.Добавить(Новый Структура("HTML",
			ЯчейкаКаналов(ТегиВерсий.Получить(Версия.Идентификатор), Подсказки)));
		Ячейки.Добавить(ДатаТекстом(Версия.Опубликована));
		Ячейки.Добавить(РазмерТекстом(Версия.Размер));
		Ячейки.Добавить(Новый Структура("HTML", МашинноеЗначение(КороткийХеш(Версия.Sha256))));
		Ячейки.Добавить(Новый Структура("HTML", Компоненты.БлокКоманды().Отрисовать(
			Команды.Установка(Пул, Пакет.Имя, Узел, Версия.Версия))));
		Строки.Добавить(Ячейки);

	КонецЦикла;

	Колонки = Новый Массив();
	Колонки.Добавить("Версия");
	Колонки.Добавить("Каналы");
	Колонки.Добавить("Дата");
	Колонки.Добавить("Размер");
	Колонки.Добавить("sha256");
	Колонки.Добавить("Установка");

	Возврат Компоненты.Таблица().Отрисовать(
		Новый Структура("Колонки, Строки, Подпись", Колонки, Строки, "Версии пакета"));

КонецФункции

// Оба значка — ответы одного снимка: вопрос «чья версия» на каждую строку стоил бы
// таблице ровно столько обращений, сколько у пакета версий.
Функция ЯчейкаВерсии(Знач Версия, Знач Происхождение)

	Возврат МашинноеЗначение(Версия.Версия)
		+ ЗначкиВерсии.Отрисовать(Новый Структура("САпстрима, ДоверенныйКонвейер, Отозвана",
			НЕ Происхождение.ЭтоСвоя(Версия),
			Происхождение.ЭтоДоверенныйКонвейер(Версия),
			Версия.Отозвана = Истина));

КонецФункции

Функция ЯчейкаКаналов(Знач Теги, Знач Подсказки)

	Если Теги = Неопределено ИЛИ Теги.Количество() = 0 Тогда
		Возврат Прочерк();
	КонецЕсли;

	Возврат Плашки.Ряд(Теги, Новый Структура("Заголовок, Подсказки",
		"Каналы версии", Подсказки)).Рендер();

КонецФункции

// Подсказка одна на тег: имя тега в команде установки — единственное их различие.
Функция ПодсказкиКаналов(Знач Пул, Знач Пакет, Знач Узел, Знач ТегиВерсий)

	Результат = Новый Соответствие();
	Для Каждого Пара Из ТегиВерсий Цикл
		Для Каждого Тег Из Пара.Значение Цикл
			Имя = Строка(Тег.Имя);
			Если Результат.Получить(Имя) = Неопределено Тогда
				Результат.Вставить(Имя, Тексты.Шаблон("public.package.channel.hint",
					Команды.Установка(Пул, Пакет.Имя, Узел, Имя)));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ЭлементыВкладки

// Прочерк вместо пустой ячейки: пустая читается как «данные не доехали».
Функция Прочерк()

	Отметка = Кит.Надпись("приглушённая");
	Отметка.Добавить(Кит.Текст("—"));
	Возврат Разметкой(Отметка);

КонецФункции

Функция МашинноеЗначение(Знач Значение)
	Возврат Разметкой(Кит.Код(Значение));
КонецФункции

Функция Переход(Знач Адрес, Знач Подпись)

	Ссылка = Кит.Ссылка(Адрес);
	Ссылка.Добавить(Кит.Текст(Подпись));
	Возврат Ссылка;

КонецФункции

// Граница перевода: таблицы этой вкладки собираются строками, и элемент попадает в них напечатанным.
Функция Разметкой(Знач Элемент)
	Возврат Элемент.Рендер();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УпорядочитьПоУбыванию(Знач СписокВерсий)

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Мажор", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Минор", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Патч", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Версия");

	Для Каждого В Из СписокВерсий Цикл
		Строка = Таблица.Добавить();
		Строка.Мажор = В.SemverМажор;
		Строка.Минор = В.SemverМинор;
		Строка.Патч = В.SemverПатч;
		Строка.Версия = В;
	КонецЦикла;

	Таблица.Сортировать("Мажор Убыв, Минор Убыв, Патч Убыв");

	Результат = Новый Массив();
	Для Каждого Строка Из Таблица Цикл
		Результат.Добавить(Строка.Версия);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ДатаТекстом(Знач Значение)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Формат(Значение, "ДЛФ=D");
КонецФункции

Функция РазмерТекстом(Знач Байты)
	Если НЕ ЗначениеЗаполнено(Байты) ИЛИ Байты <= 0 Тогда
		Возврат "—";
	КонецЕсли;
	Если Байты < 1024 Тогда
		Возврат СтрШаблон("%1 Б", Байты);
	КонецЕсли;
	Возврат СтрШаблон("%1 КБ", Формат(Байты / 1024, "ЧДЦ=1; ЧН=0"));
КонецФункции

Функция КороткийХеш(Знач Хеш)
	Если НЕ ЗначениеЗаполнено(Хеш) Тогда
		Возврат "—";
	КонецЕсли;
	Возврат Лев(Хеш, 12);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "НаборКомпонентов") _НаборUI,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "КомандыOpm") _Команды,
	&Пластилин(Значение = "ПлашкаТега") _Плашки,
	&Пластилин(Значение = "ЗначкиВерсии") _ЗначкиВерсии) Экспорт

	Кит = _Кит;
	НаборUI = _НаборUI;
	Тексты = _Тексты;
	Экран = _Экран;
	СервисТегов = _СервисТегов;
	Команды = _Команды;
	Плашки = _Плашки;
	ЗначкиВерсии = _ЗначкиВерсии;

КонецПроцедуры
