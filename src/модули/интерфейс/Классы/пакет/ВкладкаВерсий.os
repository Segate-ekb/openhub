// Вкладка «Версии» страницы пакета: два представления состава — группировка по каналам
// и плоский список. Переключатель — обычная ссылка: состояние живёт в адресе, а не в куке.

Перем Кит;           // Кит (oscript-ui) — фабрика элементов экрана
Перем Тексты;        // ТекстыИнтерфейса (кит)
Перем СервисТегов;   // СервисТегов (реестр)
Перем Статистика;    // СлужбаСтатистикиСкачиваний (статистика) — скачивания версий
Перем Команды;       // КомандыOpm (web-ui)
Перем Плашки;        // ПлашкаТега (web-ui) — единственный рендер тега
Перем ЗначкиВерсии;  // ЗначкиВерсии (web-ui)
Перем Скачивание;    // КнопкаСкачивания (web-ui) — кнопка-значок «взять .ospx»
Перем Даты;  // ДатаЧеловеку (web-ui) — одно написание момента на весь интерфейс
Перем Объёмы; // ОбъёмТекстом (основа) — байты человеческими единицами
Перем Обрезка; // ОбрезаниеТекста (основа) — длинное значение в узкой колонке
Перем НомерСборки; // НомерСборкиВерсии (реестр) — что манифест добавляет к координате
Перем Ссылки; // ПараметрыСсылки (основа) — параметр запроса на адресе

#Область ПубличныйИнтерфейс

// Два представления: группировка по каналам отвечает на «что поставится», плоский
// список — на «что вообще публиковалось и когда». Пакет без единого тега печатается
// плоским списком независимо от переключателя: группировать нечего.
//
// Параметры:
//  Пул - Пул - пул пакета.
//  Пакет - Пакет - пакет.
//  СписокВерсий - Массив из ВерсияПакета - версии пакета.
//  Плоско - Булево - Истина: плоский список вместо группировки по каналам.
//  Узел - Строка - узел хаба для команд установки.
//  АдресВкладки - Строка - адрес самой вкладки: основа переключателя представления.
//  Происхождение - СнимокПровенанса - провенанс пакета, снятый страницей один раз:
//                  значки каждой строки — ответы этого снимка.
//
// Возвращаемое значение:
//  Строка - фрагмент страницы.
//
Функция Отрисовать(Знач Пул, Знач Пакет, Знач СписокВерсий, Знач Плоско, Знач Узел,
	Знач АдресВкладки, Знач Происхождение) Экспорт

	Если СписокВерсий.Количество() = 0 Тогда
		Возврат НетВерсий().Рендер();
	КонецЕсли;

	Если НЕ Плоско Тогда
		Каналы = СервисТегов.КаналыПакета(Пакет.Идентификатор, СписокВерсий).Каналы;
		Если Каналы.Количество() > 0 Тогда
			Возврат ПоКаналам(Пул, Пакет, Каналы, Узел, АдресВкладки, Происхождение).Рендер();
		КонецЕсли;
	КонецЕсли;

	Возврат Списком(Пул, Пакет, СписокВерсий, Узел, АдресВкладки, Происхождение).Рендер();

КонецФункции

#КонецОбласти

#Область Представления

Функция НетВерсий()

	Возврат Кит.ПустоеСостояние(Новый Структура("Заголовок, Пояснение, Иконка",
		"Нет опубликованных версий", "Опубликуйте первую версию командой opm push.", "тег"));

КонецФункции

Функция ПоКаналам(Знач Пул, Знач Пакет, Знач Каналы, Знач Узел, Знач АдресВкладки,
	Знач Происхождение)

	Вкладка = Кит.Холст();
	Вкладка.Добавить(ТаблицаКаналов(Пул, Пакет, Каналы, Узел, Происхождение));
	Вкладка.Добавить(ЗначкиВерсии.Легенда(ВерсииКаналов(Каналы), Происхождение.ДоверенныеВерсии()));
	Вкладка.Добавить(ПереключательПредставления(АдресВкладки, Ложь));
	Возврат Вкладка;

КонецФункции

Функция Списком(Знач Пул, Знач Пакет, Знач СписокВерсий, Знач Узел, Знач АдресВкладки,
	Знач Происхождение)

	Вкладка = Кит.Холст();
	Вкладка.Добавить(ТаблицаВерсий(Пул, Пакет, СписокВерсий, Узел, Происхождение));
	Вкладка.Добавить(ЗначкиВерсии.Легенда(СписокВерсий, Происхождение.ДоверенныеВерсии()));
	Вкладка.Добавить(ПереключательПредставления(АдресВкладки, Истина));
	Возврат Вкладка;

КонецФункции

// Ссылка, а не тумблер: состояние живёт в адресе.
Функция ПереключательПредставления(Знач Основа, Знач СейчасПлоско)

	Приписка = Кит.Примечание();
	Приписка.Добавить(?(СейчасПлоско,
		Переход(Основа, "Сгруппировать версии по тегам"),
		Переход(Ссылки.Установить(Основа, "flat", "1"), "Показать все версии списком")));
	Возврат Приписка;

КонецФункции

#КонецОбласти

#Область ТаблицаКаналов

Функция ТаблицаКаналов(Знач Пул, Знач Пакет, Знач Каналы, Знач Узел, Знач Происхождение)

	Таблица = Кит.Таблица().Подпись("Каналы пакета");
	Таблица.Добавить(Кит.Колонка("Канал"));
	// подпись не переносится, а колонка не шире её и версии под ней
	Таблица.Добавить(Кит.Колонка("Актуальная версия", "узкая"));
	Таблица.Добавить(Кит.Колонка("Установка"));
	Таблица.Добавить(Кит.Колонка("Файл"));
	Таблица.Добавить(Кит.Колонка("История"));

	Для Каждого Канал Из Каналы Цикл
		Таблица.Добавить(ЗаписьКанала(Пул, Пакет, Канал, Узел, Происхождение));
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция ЗаписьКанала(Знач Пул, Знач Пакет, Знач Канал, Знач Узел, Знач Происхождение)

	КомандаКанала = Команды.Установка(Пул, Пакет.Имя, Узел, Канал.Тег.Имя);

	Запись = Кит.Запись();
	Запись.Добавить(Кит.Ячейка()).Добавить(Плашки.Канал(Канал.Тег, Новый Структура("Подсказка",
		Тексты.Шаблон("public.package.channel.hint", КомандаКанала))));
	Запись.Добавить(ЯчейкаАктуальнойВерсии(Канал, Происхождение));
	Запись.Добавить(Кит.Ячейка()).Добавить(УстановкаКанала(Канал, КомандаКанала));
	Запись.Добавить(Кит.Ячейка()).Добавить(
		Скачивание.ВерсииКанала(Пул, Пакет.Имя, Канал.Тег.Имя, Канал.Отдаваемая));
	Запись.Добавить(ЯчейкаИстории(Канал, Происхождение));
	Возврат Запись;

КонецФункции

Функция ЯчейкаАктуальнойВерсии(Знач Канал, Знач Происхождение)

	Если Канал.Отдаваемая = Неопределено Тогда
		Ячейка = Кит.Ячейка();
		Ячейка.Добавить(Прочерк());
		Возврат Ячейка;
	КонецЕсли;

	Возврат ЯчейкаВерсии(Канал.Отдаваемая, Происхождение);

КонецФункции

// Отдавать каналу нечего — команда установки по нему никуда не ведёт.
Функция УстановкаКанала(Знач Канал, Знач КомандаКанала)

	Если Канал.Отдаваемая = Неопределено Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.БлокКоманды(КомандаКанала);

КонецФункции

// Пункт истории — одна строка: узкая ячейка не переносит ни номер, ни признаки, ни дату.
Функция ЯчейкаИстории(Знач Канал, Знач Происхождение)

	Ячейка = Кит.Ячейка("узкая");
	Ячейка.Добавить(ИсторияКанала(Канал, Происхождение));
	Возврат Ячейка;

КонецФункции

// Отозванные из состава не выпадают, а помечаются: иначе история врала бы о том, что можно поставить.
Функция ИсторияКанала(Знач Канал, Знач Происхождение)

	Состав = Канал.Состав;
	Если Состав.Количество() = 0 Тогда
		Возврат Прочерк();
	КонецЕсли;

	История = Кит.Раскрывашка("простая");
	История.Шапка().Добавить(Кит.Текст(СтрШаблон("версий: %1",
		Формат(Состав.Количество(), "ЧГ=0; ЧН=0"))));

	Пункты = История.Добавить(Кит.Список());
	Для Каждого Версия Из УпорядочитьПоУбыванию(Состав) Цикл
		Пункты.Добавить(Кит.Пункт()).Добавить(ВерсияИстории(Версия, Происхождение));
	КонецЦикла;

	Возврат История;

КонецФункции

Функция ВерсияИстории(Знач Версия, Знач Происхождение)

	ВерсияСДатой = НомерСКлючом(Версия, Происхождение);
	ВерсияСДатой.Добавить(ЗначкиВерсии.Плашки(ПризнакиВерсии(Версия, Происхождение)));
	ВерсияСДатой.Добавить(Кит.Текст(Даты.ТолькоДата(Версия.Опубликована)));
	Возврат ВерсияСДатой;

КонецФункции

// Версии, которые таблица каналов показывает: отдаваемая и история каждого канала.
Функция ВерсииКаналов(Знач Каналы)

	Результат = Новый Массив();
	Для Каждого Канал Из Каналы Цикл
		Если Канал.Отдаваемая <> Неопределено Тогда
			Результат.Добавить(Канал.Отдаваемая);
		КонецЕсли;
		Для Каждого Версия Из Канал.Состав Цикл
			Результат.Добавить(Версия);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ТаблицаВерсий

// Скачивания стоят только в строке версии: канал меняет состав, и сумма по нему ничего не значит.
Функция ТаблицаВерсий(Знач Пул, Знач Пакет, Знач СписокВерсий, Знач Узел, Знач Происхождение)

	// раскладка одним проходом: перебор тегов на строку дал бы N×M
	ТегиВерсий = СервисТегов.ТегиПоВерсиям(Пакет.Идентификатор, СписокВерсий);
	Раскладка = Новый Структура("ТегиВерсий, Подсказки, Скачивания, Происхождение",
		ТегиВерсий, ПодсказкиКаналов(Пул, Пакет, Узел, ТегиВерсий), СкачиванияВерсий(Пакет),
		Происхождение);

	Таблица = Кит.Таблица().Подпись("Версии пакета");
	Таблица.Добавить(Кит.Колонка("Версия"));
	Таблица.Добавить(Кит.Колонка("Каналы"));
	Таблица.Добавить(Кит.Колонка("Дата"));
	// подпись короткая: шире своих чисел колонка раздвигала бы таблицу за рамку
	Таблица.Добавить(Кит.Колонка("Скачано"));
	Таблица.Добавить(Кит.Колонка("Размер"));
	Таблица.Добавить(Кит.Колонка("sha256"));
	Таблица.Добавить(Кит.Колонка("Установка"));
	Таблица.Добавить(Кит.Колонка("Файл"));

	Для Каждого Версия Из УпорядочитьПоУбыванию(СписокВерсий) Цикл
		Таблица.Добавить(ЗаписьВерсии(Пул, Пакет, Версия, Узел, Раскладка));
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция ЗаписьВерсии(Знач Пул, Знач Пакет, Знач Версия, Знач Узел, Знач Раскладка)

	Запись = Кит.Запись();
	Запись.Добавить(ЯчейкаВерсии(Версия, Раскладка.Происхождение));
	Запись.Добавить(Кит.Ячейка()).Добавить(
		КаналыВерсии(Раскладка.ТегиВерсий.Получить(Версия.Идентификатор), Раскладка.Подсказки));
	Запись.Добавить(Кит.Ячейка()).Добавить(Кит.Текст(Даты.ТолькоДата(Версия.Опубликована)));
	Запись.Добавить(Кит.Ячейка()).Добавить(Кит.Текст(СкачиванийТекстом(Раскладка.Скачивания, Версия)));
	Запись.Добавить(Кит.Ячейка()).Добавить(Кит.Текст(РазмерТекстом(Версия.Размер)));
	Запись.Добавить(Кит.Ячейка()).Добавить(Кит.Код(КороткийХеш(Версия.Sha256)));
	Запись.Добавить(Кит.Ячейка()).Добавить(
		Кит.БлокКоманды(Команды.Установка(Пул, Пакет.Имя, Узел, Версия.Версия)));
	Запись.Добавить(Кит.Ячейка()).Добавить(Скачивание.ТочнойВерсии(Пул, Пакет.Имя, Версия));
	Возврат Запись;

КонецФункции

// Строкой стоят только номер и ключ; текстовые признаки и номер сборки из манифеста —
// строками под ними, и они переносятся. Колонка поэтому не шире номера и самого длинного
// слова под ним: в одну строку с номером плашки выталкивали бы таблицу за рамку.
Функция ЯчейкаВерсии(Знач Версия, Знач Происхождение)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(НомерСКлючом(Версия, Происхождение));
	Ячейка.Добавить(ПризнакиПодНомером(Версия, Происхождение));
	Ячейка.Добавить(ОтметкаСборки(Версия));
	Возврат Ячейка;

КонецФункции

Функция ПризнакиПодНомером(Знач Версия, Знач Происхождение)

	ТекстовыеПризнаки = ЗначкиВерсии.Плашки(ПризнакиВерсии(Версия, Происхождение));
	Если ТекстовыеПризнаки.Состав().Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	ПодНомером = Кит.Надпись("приписка");
	ПодНомером.Добавить(ТекстовыеПризнаки);
	Возврат ПодНомером;

КонецФункции

// У слота SNAPSHOT координата не называет сборку, которая в нём лежит, — её называет
// манифест. Совпал с координатой — приписки нет.
Функция ОтметкаСборки(Знач Версия)

	НомерИзМанифеста = НомерСборки.ИзМанифеста(Версия);
	Если НЕ ЗначениеЗаполнено(НомерИзМанифеста) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Приписка = Кит.Надпись("приписка");
	Приписка.Добавить(Кит.Текст(Тексты.Шаблон("public.package.version.manifest", НомерИзМанифеста)));
	Возврат Приписка;

КонецФункции

Функция КаналыВерсии(Знач Теги, Знач Подсказки)

	Если Теги = Неопределено ИЛИ Теги.Количество() = 0 Тогда
		Возврат Прочерк();
	КонецЕсли;

	Возврат Плашки.Ряд(Теги, Новый Структура("Заголовок, Подсказки", "Каналы версии", Подсказки));

КонецФункции

// Подсказка одна на тег: имя тега в команде установки — единственное их различие.
Функция ПодсказкиКаналов(Знач Пул, Знач Пакет, Знач Узел, Знач ТегиВерсий)

	Результат = Новый Соответствие();
	Для Каждого Пара Из ТегиВерсий Цикл
		Для Каждого Тег Из Пара.Значение Цикл
			Имя = Строка(Тег.Имя);
			Если Результат.Получить(Имя) = Неопределено Тогда
				Результат.Вставить(Имя, Тексты.Шаблон("public.package.channel.hint",
					Команды.Установка(Пул, Пакет.Имя, Узел, Имя)));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СкачиванийТекстом(Знач Скачивания, Знач Версия)
	Возврат Тексты.ЧислоТекстом(Статистика.СкачиванийВерсииИзРазреза(Скачивания, Версия.Идентификатор));
КонецФункции

// Таблица версий не падает из-за сбоя статистики: как и шапка, при ошибке показывает ноль.
Функция СкачиванияВерсий(Знач Пакет)
	Попытка
		Возврат Статистика.СкачиванияВерсийПакета(Пакет.Идентификатор);
	Исключение
		Возврат Новый Соответствие();
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область ЭлементыВкладки

// Номер и ключ стоят одной строкой: разорванный номер читается как два, а ключ под номером
// теряет, к чему относится. Номер — название строки: оно не переносится.
Функция НомерСКлючом(Знач Версия, Знач Происхождение)

	Номер = Кит.Ряд("строкой");
	Номер.Добавить(Кит.Надпись("название")).Добавить(Кит.Код(Версия.Версия));
	Номер.Добавить(ЗначкиВерсии.Ключ(Происхождение.ЭтоДоверенныйКонвейер(Версия)));
	Возврат Номер;

КонецФункции

// Признаки — ответы одного снимка провенанса: вопрос «чья версия» на каждую строку стоил бы
// таблице столько обращений, сколько версий.
Функция ПризнакиВерсии(Знач Версия, Знач Происхождение)
	Возврат Новый Структура("САпстрима, Отозвана",
		НЕ Происхождение.ЭтоСвоя(Версия), Версия.Отозвана = Истина);
КонецФункции

// Прочерк вместо пустой ячейки: пустая читается как «данные не доехали».
Функция Прочерк()

	Отметка = Кит.Надпись("приглушённая");
	Отметка.Добавить(Кит.Текст("—"));
	Возврат Отметка;

КонецФункции

Функция Переход(Знач Адрес, Знач Подпись)

	Ссылка = Кит.Ссылка(Адрес);
	Ссылка.Добавить(Кит.Текст(Подпись));
	Возврат Ссылка;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УпорядочитьПоУбыванию(Знач СписокВерсий)

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Мажор", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Минор", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Патч", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Версия");

	Для Каждого В Из СписокВерсий Цикл
		Строка = Таблица.Добавить();
		Строка.Мажор = В.SemverМажор;
		Строка.Минор = В.SemverМинор;
		Строка.Патч = В.SemverПатч;
		Строка.Версия = В;
	КонецЦикла;

	Таблица.Сортировать("Мажор Убыв, Минор Убыв, Патч Убыв");

	Результат = Новый Массив();
	Для Каждого Строка Из Таблица Цикл
		Результат.Добавить(Строка.Версия);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Прочерк вместо «0 Б»: у версии без размера показывать нечего.
Функция РазмерТекстом(Знач Байты)
	Возврат ?(ЗначениеЗаполнено(Байты) И Байты > 0, Объёмы.Представление(Байты), "—");
КонецФункции

Функция КороткийХеш(Знач Хеш)
	Возврат ?(ЗначениеЗаполнено(Хеш), Обрезка.СМноготочием(Хеш, ЗнаковОтпечаткаВТаблице()), "—");
КонецФункции

Функция ЗнаковОтпечаткаВТаблице()
	Возврат 12;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "СлужбаСтатистикиСкачиваний") _Статистика,
	&Пластилин(Значение = "КомандыOpm") _Команды,
	&Пластилин(Значение = "ПлашкаТега") _Плашки,
	&Пластилин(Значение = "ЗначкиВерсии") _ЗначкиВерсии,
	&Пластилин(Значение = "КнопкаСкачивания") _Скачивание,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено,
	&Пластилин(Значение = "ОбъёмТекстом") _Объёмы = Неопределено,
	&Пластилин(Значение = "ОбрезаниеТекста") _Обрезка = Неопределено,
	&Пластилин(Значение = "НомерСборкиВерсии") _НомерСборки = Неопределено,
	&Пластилин(Значение = "ПараметрыСсылки") _Ссылки = Неопределено) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	СервисТегов = _СервисТегов;
	Статистика = _Статистика;
	Команды = _Команды;
	Плашки = _Плашки;
	ЗначкиВерсии = _ЗначкиВерсии;
	Скачивание = _Скачивание;
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);
	Объёмы = ?(_Объёмы = Неопределено, Новый ОбъёмТекстом(), _Объёмы);
	Обрезка = ?(_Обрезка = Неопределено, Новый ОбрезаниеТекста(), _Обрезка);
	НомерСборки = ?(_НомерСборки = Неопределено, Новый НомерСборкиВерсии(), _НомерСборки);
	Ссылки = ?(_Ссылки = Неопределено, Новый ПараметрыСсылки(), _Ссылки);

КонецПроцедуры
