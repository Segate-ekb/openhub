// Маршруты раздела «Апстримы» дома «Пул»: страница с окном по адресу, заведение источника,
// стрелки порядка, тумблер, снятие токена, удаление и тумблер публикации пула. Удача — 303
// на раздел, отказ — та же страница с окном, открытым на набранном и отказах.

Перем ГвардПула;
Перем Ответы;     // ОтветыНастроек
Перем Дом;        // ДомПула
Перем Витрина;    // ВитринаАпстримов
Перем Пульт;      // ПультАпстримовПула
Перем Защита;     // ЗащитаCSRF (вход)
Перем Окна;       // ОкноРаздела — окно по адресу и ответы форм окон

#Область ТочкиМаршрута

// Точка маршрута «pools/{pool}/settings/upstreams»: GET — страница раздела, POST — заведение
// источника.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: <вид>-<номер> (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/settings/upstreams")
Процедура Раздел(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	saved = "", окно = "") Экспорт

	Вердикт = ГвардПула.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Вердикт, КукиЗапроса, 200, Окна.ИзАдреса(окно, Витрина.ВидыОкон()),
			ЗначениеЗаполнено(saved));
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Вердикт, КукиЗапроса, Пульт.Создать(Вердикт.Пул, Форма, Вердикт.Пользователь),
		"новый", "", Форма);

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/upstreams/publication» — тумблер публикации пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/settings/upstreams/publication")
Процедура Публикация(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Вердикт, КукиЗапроса, Пульт.Публикация(Мутация.Вердикт.Пул, Мутация.Форма),
		"", "", Мутация.Форма);

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/upstreams/{id}/move» — стрелки порядка обхода.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - номер источника.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/settings/upstreams/{id}/move")
Процедура Сдвиг(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Вердикт, КукиЗапроса, Пульт.Сдвинуть(Мутация.Вердикт.Пул, id, Мутация.Форма),
		"", id, Мутация.Форма);

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/upstreams/{id}/toggle» — тумблер источника.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - номер источника.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/settings/upstreams/{id}/toggle")
Процедура Переключение(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Вердикт = Мутация.Вердикт;
	Завершить(Ответ, Вердикт, КукиЗапроса,
		Пульт.Переключить(Вердикт.Пул, id, Мутация.Форма, Вердикт.Пользователь), "", id, Мутация.Форма);

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/upstreams/{id}/token-off» — форма окна «Снять токен».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - номер источника.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/settings/upstreams/{id}/token-off")
Процедура СнятиеТокена(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Вердикт, КукиЗапроса, Пульт.СнятьТокен(Мутация.Вердикт.Пул, id),
		"токен", id, Мутация.Форма);

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/upstreams/{id}/delete». Без поля подтверждения (форма
// ушла без скрипта) источник не удаляется: ответ ведёт на страницу с открытым подтверждением.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - номер источника.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/settings/upstreams/{id}/delete")
Процедура Удаление(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Вердикт = Мутация.Вердикт;
	Если НЕ Окна.Подтверждено(Мутация.Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресРаздела(Вердикт), id);
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Вердикт, КукиЗапроса, Пульт.Удалить(Вердикт.Пул, id, Вердикт.Пользователь),
		"удалить", id, Мутация.Форма);

КонецПроцедуры

#КонецОбласти

#Область Действия

// Общий пролог мутирующих точек: гвард → только POST → форма с CSRF.
Функция Мутация(Ответ, Знач pool, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса,
	Знач ТелоЗапроса)

	Вердикт = ГвардПула.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "POST", Вердикт, КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Вердикт, Форма", Вердикт, Форма);

КонецФункции

// Исход пульта → ответ: удача — 303 на раздел; отказ — страница с окном этой формы, открытым
// на набранном и отказах. Окна нет (стрелки, тумблер, источник уже удалён) — отказ тостом
// над разделом: причина названа в любом случае.
Процедура Завершить(Ответ, Знач Вердикт, Знач КукиЗапроса, Знач Исход, Знач ВидОкна, Знач Номер,
	Знач Форма)

	Если Исход.Успех Тогда
		Окна.ВернутьВРаздел(Ответ, АдресРаздела(Вердикт));
		Возврат;
	КонецЕсли;

	// отказ у поля в окне уже назван — второй раз над полями его не повторяют
	Окно = Окна.Отбитое(ВидОкна, Номер, Форма, Исход.Отказы,
		?(Исход.Отказы.Количество() > 0, "", Исход.Сообщение));
	Если ЗначениеЗаполнено(ВидОкна) И Витрина.ЕстьОкно(Вердикт.Пул, Окно) Тогда
		ОтдатьРаздел(Ответ, Вердикт, КукиЗапроса, Исход.Код, Окно);
		Возврат;
	КонецЕсли;
	ОтдатьРаздел(Ответ, Вердикт, КукиЗапроса, Исход.Код, Неопределено, Ложь, Исход.Сообщение);

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач КукиЗапроса, Знач Статус, Знач Окно,
	Знач Сохранено = Ложь, Знач Ошибка = "")

	Пул = Вердикт.Пул;
	Параметры = Новый Структура("Пул, Адрес, Окно", Пул, АдресРаздела(Вердикт), Окно);

	Модель = Ответы.МодельДома(Дом, Пул.Имя,
		Дом.Разделы(Пул.Имя, "upstreams"),
		Ответы.УведомленияРаздела(Сохранено, Ошибка),
		Витрина.Секции(Параметры),
		Защита.ТокенСессии(Вердикт.Сессия),
		Дом.Крошки(Пул.Имя));

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт, КукиЗапроса, Статус);

КонецПроцедуры

Функция АдресРаздела(Знач Вердикт)
	Возврат Дом.АдресРаздела(Вердикт.Пул.Имя, "upstreams");
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардПула") _ГвардПула,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомПула") _Дом,
	&Пластилин(Значение = "ВитринаАпстримов") _Витрина,
	&Пластилин(Значение = "ПультАпстримовПула") _Пульт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ОкноРаздела") _Окна)

	ГвардПула = _ГвардПула;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	Пульт = _Пульт;
	Защита = _Защита;
	Окна = _Окна;

КонецПроцедуры
