// Операции раздела «Апстримы» дома «Пул»: заведение источника, порядок, тумблер, снятие токена,
// удаление и тумблер публикации пула. Исход каждой — домена плюс отказы у полей окна; источник
// называется номером из адреса, а не скрытым полем формы.

Перем Гейт;        // ГейтФормы — CSRF-токен формы
Перем РазборФормы;
Перем СервисПулов; // СервисПулов (реестр) — публикация пула
Перем Апстримы;    // СервисАпстримовПула (реестр) — состав и порядок источников
Перем Числа;       // ПриведениеЧисел (основа) — номер источника из адреса
Перем Адреса;      // РазборАдреса (основа) — канон адреса источника
Перем Сбои;        // ТекстСбоя — причина отказа домена человеку
Перем Тексты;      // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ИменаПолей

// Имя поля адреса источника.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляАдреса() Экспорт
	Возврат "url";
КонецФункции

// Имя поля токена доступа к источнику.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляТокена() Экспорт
	Возврат "токен";
КонецФункции

// Имя поля TTL кэша источника.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляВремениЖизни() Экспорт
	Возврат "ttl";
КонецФункции

// TTL кэша, с которым источник заводится, если поле оставили пустым.
//
// Возвращаемое значение:
//  Число.
//
Функция ВремяЖизниПоУмолчанию() Экспорт
	Возврат 900;
КонецФункции

// Имя поля тумблера источника.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляВключён() Экспорт
	Возврат "включить";
КонецФункции

// Имя поля тумблера публикации пула.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляПубликации() Экспорт
	Возврат "публикация";
КонецФункции

// Значение отмеченного тумблера.
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеОтмечено() Экспорт
	Возврат "1";
КонецФункции

// Имя поля стрелки порядка: его значение шлёт нажатая кнопка.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляСдвига() Экспорт
	Возврат "сдвиг";
КонецФункции

// Значение кнопки «Выше».
//
// Возвращаемое значение:
//  Строка.
//
Функция СдвигВверх() Экспорт
	Возврат "вверх";
КонецФункции

// Значение кнопки «Ниже».
//
// Возвращаемое значение:
//  Строка.
//
Функция СдвигВниз() Экспорт
	Возврат "вниз";
КонецФункции

#КонецОбласти

#Область ПубличныйИнтерфейс

// Разбирает тело запроса и проверяет CSRF.
//
// Параметры:
//  Ответ - ОтветСервера.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  ТелоЗапроса - Строка.
//  КукиЗапроса - Куки - куки запроса.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - разобранная форма; Неопределено — ответ уже сформирован.
//
Функция Форма(Ответ, Знач Контекст, Знач ТелоЗапроса, Знач КукиЗапроса) Экспорт
	Возврат Гейт.СПринятымТокеном(Ответ, Контекст, РазборФормы.Разобрать(ТелоЗапроса), КукиЗапроса);
КонецФункции

// Заводит источник по форме окна «Новый апстрим». Адрес, уже заведённый у пула (сравнивается
// канон), обновляет заведённый: TTL из формы, токен — набранный (пустое поле оставляет прежний),
// набор разрешённых имён — прежний. Форма с полем операции — страница до перевода раздела
// на окна: отказ без мутации.
//
// Параметры:
//  Пул - Пул - пул раздела.
//  Форма - Соответствие - разобранная форма.
//  Пользователь - Пользователь, Неопределено - кто правит источники.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка — причина отказа словами,
//              заполнена у любого отказа), Отказы (Соответствие — имя поля -> отказ под полем).
//
Функция Создать(Знач Пул, Знач Форма, Знач Пользователь) Экспорт

	Если Форма.Получить(ИмяПоляОперации()) <> Неопределено Тогда
		Возврат Отказ(Тексты.Текст("settings.pool.error.upstream.stale"), 400);
	КонецЕсли;

	Адрес = Текст(Форма, ИмяПоляАдреса());
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат ОтбитоПолем(ИмяПоляАдреса(), Тексты.Текст("settings.pool.error.upstream.url"));
	КонецЕсли;
	ВремяЖизни = РазборФормы.ЦелоеПоле(Форма, ИмяПоляВремениЖизни(), ВремяЖизниПоУмолчанию());
	Если ВремяЖизни = Неопределено Тогда
		Возврат ОтбитоПолем(ИмяПоляВремениЖизни(), Тексты.Текст("settings.pool.error.upstream.ttl"));
	КонецЕсли;

	// повтор адреса правит заведённый источник; набор имён в окне не задаётся и не теряется
	Заведённый = ЗаведённыйПоАдресу(Пул, Адрес);
	РазрешённыеИмена = ?(Заведённый = Неопределено, "", Строка(Заведённый.СписокРазрешенийJSON));

	// отказ домена — неразбираемый адрес или неудачная проба подключения — про адрес:
	// он ложится под поле адреса, к набранному
	Попытка
		Апстримы.Записать(Пул, Адрес, ВремяЖизни, РазрешённыеИмена, РазборФормы.Поле(Форма, ИмяПоляТокена()),
			Ложь, Пользователь);
	Исключение
		Возврат ОтбитоПолем(ИмяПоляАдреса(), Сбои.Человеку(ИнформацияОбОшибке()), 422);
	КонецПопытки;
	Возврат Удача();

КонецФункции

// Сдвигает источник на одно место в порядке обхода; за край сдвиг ничего не меняет.
//
// Параметры:
//  Пул - Пул - пул раздела.
//  Номер - Строка - номер источника из адреса.
//  Форма - Соответствие - разобранная форма: значение стрелки.
//
// Возвращаемое значение:
//  Структура - см. Создать.
//
Функция Сдвинуть(Знач Пул, Знач Номер, Знач Форма) Экспорт

	Сдвиг = НРег(Текст(Форма, ИмяПоляСдвига()));
	Если Сдвиг <> СдвигВверх() И Сдвиг <> СдвигВниз() Тогда
		Возврат Отказ(Тексты.Текст("settings.pool.error.upstream.move"), 400);
	КонецЕсли;

	Найденный = ИсточникПула(Пул, Номер);
	Если Найденный = Неопределено Тогда
		Возврат НетИсточника();
	КонецЕсли;

	// позиция считается сервером по текущему порядку, а не берётся из формы
	Попытка
		Апстримы.Переместить(Пул.Идентификатор, Найденный.Источник.Url,
			Найденный.Позиция + ?(Сдвиг = СдвигВверх(), -1, 1));
	Исключение
		Возврат Отказ(Сбои.Человеку(ИнформацияОбОшибке()), 422);
	КонецПопытки;
	Возврат Удача();

КонецФункции

// Включает или выключает источник тумблером записи.
//
// Параметры:
//  Пул - Пул - пул раздела.
//  Номер - Строка - номер источника из адреса.
//  Форма - Соответствие - разобранная форма.
//  Пользователь - Пользователь, Неопределено - кто правит источники.
//
// Возвращаемое значение:
//  Структура - см. Создать.
//
Функция Переключить(Знач Пул, Знач Номер, Знач Форма, Знач Пользователь) Экспорт

	Найденный = ИсточникПула(Пул, Номер);
	Если Найденный = Неопределено Тогда
		Возврат НетИсточника();
	КонецЕсли;

	Попытка
		Апстримы.Переключить(Пул.Идентификатор, Найденный.Источник.Url,
			РазборФормы.Флажок(Форма, ИмяПоляВключён(), ЗначениеОтмечено()), Пользователь);
	Исключение
		Возврат Отказ(Сбои.Человеку(ИнформацияОбОшибке()), 422);
	КонецПопытки;
	Возврат Удача();

КонецФункции

// Снимает с источника токен доступа: он снова читается анонимно.
//
// Параметры:
//  Пул - Пул - пул раздела.
//  Номер - Строка - номер источника из адреса.
//
// Возвращаемое значение:
//  Структура - см. Создать.
//
Функция СнятьТокен(Знач Пул, Знач Номер) Экспорт

	Найденный = ИсточникПула(Пул, Номер);
	Если Найденный = Неопределено Тогда
		Возврат НетИсточника();
	КонецЕсли;

	Попытка
		Апстримы.СнятьТокен(Пул.Идентификатор, Найденный.Источник.Url);
	Исключение
		Возврат Отказ(Сбои.Человеку(ИнформацияОбОшибке()), 422);
	КонецПопытки;
	Возврат Удача();

КонецФункции

// Удаляет источник; оставшиеся нумеруются заново, порядок обхода сохраняется.
//
// Параметры:
//  Пул - Пул - пул раздела.
//  Номер - Строка - номер источника из адреса.
//  Пользователь - Пользователь, Неопределено - кто правит источники.
//
// Возвращаемое значение:
//  Структура - см. Создать.
//
Функция Удалить(Знач Пул, Знач Номер, Знач Пользователь) Экспорт

	Найденный = ИсточникПула(Пул, Номер);
	Если Найденный = Неопределено Тогда
		Возврат НетИсточника();
	КонецЕсли;

	Попытка
		Апстримы.Удалить(Пул.Идентификатор, Найденный.Источник.Url, Пользователь);
	Исключение
		Возврат Отказ(Сбои.Человеку(ИнформацияОбОшибке()), 422);
	КонецПопытки;
	Возврат Удача();

КонецФункции

// Разрешает или запрещает пулу принимать собственные пакеты. Форма без поля тумблера — отказ.
//
// Параметры:
//  Пул - Пул - пул раздела.
//  Форма - Соответствие - разобранная форма тумблера.
//
// Возвращаемое значение:
//  Структура - см. Создать.
//
Функция Публикация(Знач Пул, Знач Форма) Экспорт

	// форма без поля тумблера — неполная или подделанная: отказ, а не «выключить»
	Если Форма.Получить(ИмяПоляПубликации()) = Неопределено Тогда
		Возврат Отказ(Тексты.Текст("settings.pool.error.publication"), 400);
	КонецЕсли;
	Попытка
		СервисПулов.УстановитьПубликациюРазрешена(Пул.Идентификатор,
			РазборФормы.Флажок(Форма, ИмяПоляПубликации(), ЗначениеОтмечено()));
	Исключение
		Возврат Отказ(Сбои.Человеку(ИнформацияОбОшибке()), 422);
	КонецПопытки;
	Возврат Удача();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Поле операции слала форма раздела до перевода на окна; новые формы его не шлют.
Функция ИмяПоляОперации()
	Возврат "операция";
КонецФункции

// Заведённый у пула источник с тем же адресом — по канону, как судит домен; нет — Неопределено.
Функция ЗаведённыйПоАдресу(Знач Пул, Знач Адрес)

	Искомый = Адреса.Каноничный(Адрес);
	Для Каждого Источник Из Апстримы.Все(Пул.Идентификатор) Цикл
		Если Адреса.Каноничный(Источник.Url) = Искомый Тогда
			Возврат Источник;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Источник пула по номеру из адреса и его место в порядке обхода; чужой номер — Неопределено.
Функция ИсточникПула(Знач Пул, Знач Номер)

	Искомый = Числа.ЧислоИлиНоль(Номер);
	Позиция = 0;
	Для Каждого Источник Из Апстримы.Все(Пул.Идентификатор) Цикл
		Если Источник.Идентификатор = Искомый Тогда
			Возврат Новый Структура("Источник, Позиция", Источник, Позиция);
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция НетИсточника()
	Возврат Отказ(Тексты.Текст("settings.pool.error.upstream.target"), 404);
КонецФункции

Функция Удача()
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы", Истина, 200, "", Новый Соответствие());
КонецФункции

Функция Отказ(Знач Сообщение, Знач Код)
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы", Ложь, Код, Строка(Сообщение),
		Новый Соответствие());
КонецФункции

Функция ОтбитоПолем(Знач ИмяПоля, Знач Текст, Знач Код = 400)

	Исход = Отказ(Текст, Код);
	Исход.Отказы.Вставить(ИмяПоля, Строка(Текст));
	Возврат Исход;

КонецФункции

Функция Текст(Знач Форма, Знач Имя)
	Возврат СокрЛП(Строка(РазборФормы.Поле(Форма, Имя)));
КонецФункции

#КонецОбласти

&Прозвище("ПультАпстримовПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисАпстримовПула") _Апстримы,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "РазборАдреса") _Адреса,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	СервисПулов = _СервисПулов;
	Апстримы = _Апстримы;
	Числа = _Числа;
	Адреса = _Адреса;
	Сбои = _Сбои;
	Тексты = _Тексты;

КонецПроцедуры
