// Дом настроек «Пул»: адреса, разделы по рубрикам и крошки настроек пула.

Перем Сборка;    // СборкаДомаНастроек — перечень разделов дома
Перем Страницы;  // АдресаСтраниц (реестр) — дом лежит под страницей своего пула
Перем Каталог;   // АдресаКаталога — страница всех пулов, первая крошка
Перем Тексты;    // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Перечень;  // ТаблицаЗначений — разделы дома по порядку колонки

// Ключ дома.
//
// Возвращаемое значение:
//  Строка - ключ дома.
//
Функция Ключ() Экспорт
	Возврат "pool";
КонецФункции

// Базовый адрес дома для пула с указанным именем.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Строка - "/pools/{pool}/settings".
//
Функция БазовыйАдрес(Знач ИмяПула) Экспорт
	Возврат Страницы.НастроекПула(ИмяПула);
КонецФункции

// Раздел по умолчанию.
//
// Возвращаемое значение:
//  Строка - раздел по умолчанию.
//
Функция РазделПоУмолчанию() Экспорт
	Возврат "general";
КонецФункции

// Адрес раздела дома.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Строка - адрес раздела дома.
//
Функция АдресРаздела(Знач ИмяПула, Знач Ключ) Экспорт
	Возврат БазовыйАдрес(ИмяПула) + "/" + Ключ;
КонецФункции

// Разделы дома для модели (ОтветыНастроек.МодельДома).
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  Активный - Строка - ключ активного раздела.
//
// Возвращаемое значение:
//  Структура - разделы дома (СборкаДомаНастроек.РазделыДома).
//
Функция Разделы(Знач ИмяПула, Знач Активный) Экспорт
	Возврат Сборка.РазделыДома(БазовыйАдрес(ИмяПула), Перечень, Активный, РубрикаОбъекта());
КонецФункции

// Есть ли раздел с таким ключом.
//
// Параметры:
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Булево - есть ли раздел с таким ключом.
//
Функция ЕстьРаздел(Знач Ключ) Экспорт
	Возврат Сборка.РазделПеречня(Перечень, Ключ) <> Неопределено;
КонецФункции

// Подпись раздела.
//
// Параметры:
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Строка - подпись раздела либо "".
//
Функция ПодписьРаздела(Знач Ключ) Экспорт
	Раздел = Сборка.РазделПеречня(Перечень, Ключ);
	Возврат ?(Раздел = Неопределено, "", Раздел.Подпись);
КонецФункции

// Путь к пулу крошками: «Пулы» — страница всех пулов, имя — страница пула.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Массив из Структура - крошки: Подпись, Адрес.
//
Функция КрошкиПула(Знач ИмяПула) Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Крошка(Тексты.Текст("chrome.crumbs.pools"), Каталог.Пулы()));
	Результат.Добавить(Крошка(ИмяПула, Страницы.Пула(ИмяПула)));
	Возврат Результат;

КонецФункции

// Крошки страниц дома: путь к пулу и последней — «настройки», текстом.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Массив из Структура - крошки: Подпись, Адрес (у последней пустой).
//
Функция Крошки(Знач ИмяПула) Экспорт

	Результат = КрошкиПула(ИмяПула);
	Результат.Добавить(Крошка(Тексты.Текст("settings.pool.crumb"), ""));
	Возврат Результат;

КонецФункции

// Объект дома, один на все его разделы: у этого дома его нет — объект (пул) называет раздел.
//
// Возвращаемое значение:
//  Строка - "".
//
Функция Объект() Экспорт
	Возврат "";
КонецФункции

// Заголовок дома.
//
// Возвращаемое значение:
//  Строка - заголовок дома.
//
Функция Заголовок() Экспорт
	Возврат Тексты.Текст("settings.pool.title");
КонецФункции

// Рубрика объекта дома (уходит в РазделыДома): под заголовком «Настройки пула» и в шторке она повторила бы
// имя — её разделы (общие, видимость, права, квота) идут первыми без рубрики.
//
// Возвращаемое значение:
//  Строка - подпись рубрики.
//
Функция РубрикаОбъекта() Экспорт
	Возврат Тексты.Текст("settings.pool.group.pool");
КонецФункции

// Пояснение дома: у пула его нет — разделы объясняют себя сами.
//
// Возвращаемое значение:
//  Строка - пустая строка.
//
Функция Пояснение() Экспорт
	Возврат "";
КонецФункции

Функция Крошка(Знач Подпись, Знач Адрес)
	Возврат Новый Структура("Подпись, Адрес", Подпись, Адрес);
КонецФункции

// Раздел перечня дома.
Процедура Раздел(Знач КлючРаздела, Знач Подпись, Знач Иконка, Знач Рубрика)
	Сборка.Раздел(Перечень, КлючРаздела, Подпись, Иконка, Рубрика);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СборкаДомаНастроек") _Сборка,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы,
	&Пластилин(Значение = "АдресаКаталога") _Каталог) Экспорт

	Сборка = _Сборка;
	Тексты = _Тексты;
	Страницы = _Страницы;
	Каталог = _Каталог;

	Перечень = Сборка.ПереченьРазделов();

	Пул = Тексты.Текст("settings.pool.group.pool");
	Раздел("general", Тексты.Текст("settings.pool.nav.general"), "шестерёнка", Пул);
	Раздел("visibility", Тексты.Текст("settings.pool.nav.visibility"), "замок", Пул);
	Раздел("access", Тексты.Текст("settings.pool.nav.access"), "аккаунт", Пул);
	Раздел("quota", Тексты.Текст("settings.pool.nav.quota"), "скачать", Пул);

	Пакеты = Тексты.Текст("settings.pool.group.packages");
	Раздел("inbox", Тексты.Текст("settings.pool.nav.inbox"), "конверт", Пакеты);
	Раздел("tags", Тексты.Текст("settings.pool.nav.tags"), "тег", Пакеты);

	Источники = Тексты.Текст("settings.pool.group.sources");
	Раздел("upstreams", Тексты.Текст("settings.pool.nav.upstreams"), "ссылка", Источники);
	Раздел("mirrors", Тексты.Текст("settings.pool.nav.mirrors"), "копировать", Источники);

	Раздел("webhooks", Тексты.Текст("settings.pool.nav.webhooks"), "стрелка", Тексты.Текст("settings.pool.group.notify"));

	Сборка.ОпасныйРаздел(Перечень, "danger", Тексты.Текст("settings.pool.nav.danger"), "предупреждение");

КонецПроцедуры
