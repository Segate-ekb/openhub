// Одобрение и отклонение заявок «входящих» формой окна решения. Порог права и порядок проверок
// держит РассмотрениеВходящих, здесь — разбор формы окна и вопрос, если форма пришла без
// подтверждения.

Перем РазборФормы;
Перем Рассмотрение;  // РассмотрениеВходящих (публикация) — видимость, одобрение, отклонение
Перем Поля;          // ВитринаЗаявокПула — имена полей и виды окон решения
Перем Окна;          // ОкноРаздела — подтверждена ли отправка
Перем Исходы;        // ИсходОкна — форма исхода
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Применяет решение по заявке.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса (порог права судит домен).
//  Форма - Соответствие - разобранная форма окна решения.
//  Пул - Пул, Неопределено - пул раздела: заявка чужого пула этой формой не решается
//        (необязательный, по умолчанию Неопределено — страница заявок по всем пулам).
//
// Возвращаемое значение:
//  Структура - исход (см. ИсходОкна.Удача): без подтверждения — вопрос окном решения по номеру
//              заявки; отказ домена в решении — в том же окне; заявка, которую смотрящий решать
//              не вправе, неотличима от несуществующей — 404 без имени пула.
//
Функция Применить(Знач Принципал, Знач Форма, Знач Пул = Неопределено) Экспорт

	// шаг подтверждения прежней страницы нёс номер в поле «подтверждение»: такая форма — старая
	// вкладка, решение по ней не принимается
	Если Форма.Получить(ИмяПоляПрежнегоПодтверждения()) <> Неопределено Тогда
		Возврат Исходы.Отбито(Тексты.Текст("settings.inbox.error.stale"));
	КонецЕсли;

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, Поля.ИмяПоляОперации())));
	Если Операция <> Поля.ВидОдобрения() И Операция <> Поля.ВидОтклонения() Тогда
		// белый список операций: неизвестная не должна попадать в чужую ветку
		Возврат Исходы.Отбито(Тексты.Текст("settings.inbox.error.operation"));
	КонецЕсли;

	Номер = РазборФормы.ЦелоеПоле(Форма, Поля.ИмяПоляЗаявки());
	Если Номер = Неопределено ИЛИ Номер <= 0 Тогда
		Возврат Исходы.Отбито(Тексты.Текст("settings.inbox.error.id"));
	КонецЕсли;
	Ключ = Формат(Номер, "ЧГ=0; ЧН=0");

	// заявка спрашивается у домена и до вопроса: чужую заявку экран не покажет даже окном
	Контекст = Рассмотрение.ЗаявкаКРассмотрению(Принципал, Номер);
	Если НЕ Контекст.Успех Тогда
		Возврат НедоступнаяЗаявка(Контекст);
	КонецЕсли;

	// раздел дома «Пул» решает только СВОИ заявки: подставленный номер соседнего пула
	// не должен обрабатываться формой этой страницы, даже когда права на него есть
	Если Пул <> Неопределено И Цел(Контекст.Пул.Идентификатор) <> Цел(Пул.Идентификатор) Тогда
		Возврат Исходы.Отбито(Тексты.Текст("settings.inbox.error.foreign"));
	КонецЕсли;

	// без скрипта форма уходит из меню без вопроса: решение не принимается, вопрос — окном
	Если НЕ Окна.Подтверждено(Форма) Тогда
		Возврат Исходы.Спросить(Операция, Ключ);
	КонецЕсли;

	Если Операция = Поля.ВидОдобрения() Тогда
		Решение = Рассмотрение.Одобрить(Принципал, Номер);
		Если НЕ Решение.Успех Тогда
			Возврат ОтказОкна(Решение.Код, Тексты.Шаблон("settings.inbox.error.approve", Решение.Сообщение),
				Операция, Ключ, Форма);
		КонецЕсли;
	Иначе
		Решение = Рассмотрение.Отклонить(Принципал, Номер,
			СокрЛП(РазборФормы.Поле(Форма, Поля.ИмяПоляПричины())));
		Если НЕ Решение.Успех Тогда
			Возврат ОтказОкна(Решение.Код, Тексты.Шаблон("settings.inbox.error.reject", Решение.Сообщение),
				Операция, Ключ, Форма);
		КонецЕсли;
	КонецЕсли;

	Возврат Исходы.Удача();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяПоляПрежнегоПодтверждения()
	Возврат "подтверждение";
КонецФункции

// Чужая заявка (403 домена называет её пул) и несуществующая (404) отвечают одинаково:
// перебором номеров нельзя узнать, какие заявки есть и в каких пулах. Прочие отказы домена —
// словами домена.
Функция НедоступнаяЗаявка(Знач Контекст)

	Если Контекст.Код = 403 ИЛИ Контекст.Код = 404 Тогда
		Возврат Исходы.Отбито(Тексты.Текст("settings.inbox.error.missing"), 404);
	КонецЕсли;
	Возврат Исходы.Отбито(Тексты.Шаблон("settings.inbox.error.decide", Контекст.Сообщение), КодОтказа(Контекст.Код));

КонецФункции

// Отказ домена по уже открытому окну: причина возвращается в то же окно.
Функция ОтказОкна(Знач Код, Знач Сообщение, Знач ВидОкна, Знач Ключ, Знач Форма)
	Возврат Исходы.ВОкне(Исходы.Отбито(Сообщение, КодОтказа(Код)), ВидОкна, Ключ, Форма);
КонецФункции

Функция КодОтказа(Знач Код)
	Возврат ?(ТипЗнч(Код) = Тип("Число") И Код >= 400, Код, 400);
КонецФункции

#КонецОбласти

&Прозвище("ПультЗаявок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "РассмотрениеВходящих") _Рассмотрение,
	&Пластилин(Значение = "ВитринаЗаявокПула") _Поля,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ИсходОкна") _Исходы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	Рассмотрение = _Рассмотрение;
	Поля = _Поля;
	Окна = _Окна;
	Исходы = _Исходы;
	Тексты = _Тексты;

КонецПроцедуры
