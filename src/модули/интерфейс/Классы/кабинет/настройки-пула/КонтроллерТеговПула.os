// Маршруты раздела «Теги» дома «Пул»: страница с окном по адресу, галка «теги пула для пакетов»,
// заведение, правка и удаление тега пула, проверка имени до отправки. Удача — 303 на раздел,
// отказ — та же страница с окном, открытым на набранном и отказах.

Перем ГвардПула;
Перем Ответы;     // ОтветыНастроек
Перем Дом;        // ДомПула
Перем Витрина;    // ВитринаТеговПула
Перем Пульт;      // ПультТеговПула
Перем Защита;     // ЗащитаCSRF (вход)
Перем Окна;       // ОкноРаздела — окно по адресу и ответы форм окон
Перем СервисПулов; // СервисПулов (реестр) — пул после мутации

#Область ТочкиМаршрута

// Точка маршрута «pools/{pool}/settings/tags»: GET — страница раздела (с «проверка=1» — ответ
// проверки имени до отправки), POST — галка либо заведение тега пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: <вид>-<тег> (необязательный, по умолчанию "").
//  проверка - Строка - непустое — запрос проверки поля до отправки (необязательный,
//             по умолчанию "").
//  имя - Строка - проверяемое имя нового тега (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/settings/tags")
Процедура Раздел(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	saved = "", окно = "", проверка = "", имя = "") Экспорт

	Вердикт = ГвардПула.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Если ЗначениеЗаполнено(проверка) Тогда
			ОтветитьПроверкой(Ответ, Пульт.ОтказИмени(Вердикт.Пул, имя));
		Иначе
			ОтдатьРаздел(Ответ, Вердикт, КукиЗапроса, 200, Окна.ИзАдреса(окно, Витрина.ВидыОкон()),
				ЗначениеЗаполнено(saved));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Пульт.ФормаУстарела(Форма, Пульт.ОперацииРаздела()) Тогда
		Завершить(Ответ, Вердикт, КукиЗапроса, Пульт.ОтказУстаревшей(), "", "", Форма);
		Возврат;
	КонецЕсли;
	Если Пульт.ЭтоГалка(Форма) Тогда
		Завершить(Ответ, Вердикт, КукиЗапроса, Пульт.ПереключитьНаследование(Вердикт.Пул, Кто(Вердикт), Форма),
			"", "", Форма);
		Возврат;
	КонецЕсли;
	Завершить(Ответ, Вердикт, КукиЗапроса, Пульт.Создать(Вердикт.Пул, Кто(Вердикт), Форма), "новый", "", Форма);

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/tags/{тег}/save» — форма окна «Изменить».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  тег - Строка - имя тега пула.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/settings/tags/{тег}/save")
Процедура Сохранение(Ответ, pool, тег, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Исход = ?(Пульт.ФормаУстарела(Мутация.Форма), Пульт.ОтказУстаревшей(),
		Пульт.Сохранить(Мутация.Вердикт.Пул, тег, Кто(Мутация.Вердикт), Мутация.Форма));
	Завершить(Ответ, Мутация.Вердикт, КукиЗапроса, Исход, "изменить", тег, Мутация.Форма);

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/tags/{тег}/delete». Без поля подтверждения (форма ушла
// без скрипта) тег не удаляется: ответ ведёт на страницу с открытым подтверждением.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  тег - Строка - имя тега пула.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/settings/tags/{тег}/delete")
Процедура Удаление(Ответ, pool, тег, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Окна.Подтверждено(Мутация.Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресРаздела(Мутация.Вердикт), тег);
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Вердикт, КукиЗапроса,
		Пульт.Удалить(Мутация.Вердикт.Пул, тег, Кто(Мутация.Вердикт), Мутация.Форма),
		"удалить", тег, Мутация.Форма);

КонецПроцедуры

#КонецОбласти

#Область Действия

// Общий пролог мутирующих точек: гвард → только POST → форма с CSRF.
Функция Мутация(Ответ, Знач pool, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса,
	Знач ТелоЗапроса)

	Вердикт = ГвардПула.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "POST", Вердикт, КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Вердикт, Форма", Вердикт, Форма);

КонецФункции

// Исход пульта → ответ: удача — 303 на раздел; отказ — страница с окном этой формы, открытым
// на набранном и отказах. Окна нет (галка; тег удалён) — отказ тостом над разделом.
Процедура Завершить(Ответ, Знач Вердикт, Знач КукиЗапроса, Знач Исход, Знач ВидОкна, Знач ИмяТега,
	Знач Форма)

	Если Исход.Успех Тогда
		Окна.ВернутьВРаздел(Ответ, АдресРаздела(Вердикт));
		Возврат;
	КонецЕсли;

	// отказ у поля в окне уже назван — второй раз над шагами его не повторяют
	Окно = Окна.Отбитое(ВидОкна, ИмяТега, Форма, Исход.Отказы,
		?(Исход.Отказы.Количество() > 0, "", Исход.Сообщение));
	Если ЗначениеЗаполнено(ВидОкна) И Витрина.ЕстьОкно(Вердикт.Пул, Окно) Тогда
		ОтдатьРаздел(Ответ, Вердикт, КукиЗапроса, Исход.Код, Окно, Ложь);
		Возврат;
	КонецЕсли;
	ОтдатьРаздел(Ответ, Вердикт, КукиЗапроса, Исход.Код, Неопределено, Ложь, Исход.Сообщение);

КонецПроцедуры

// Ответ проверки до отправки: 200 — годится, 409 с причиной — нет.
Процедура ОтветитьПроверкой(Ответ, Знач Отказ)

	Ответ.УстановитьТипКонтента("txt");
	Ответ.УстановитьСостояние(?(ЗначениеЗаполнено(Отказ), 409, 200));
	Ответ.ТелоТекст = Отказ;

КонецПроцедуры

Функция Кто(Знач Вердикт)
	Возврат ?(Вердикт.Пользователь = Неопределено, "", Строка(Вердикт.Пользователь.Логин));
КонецФункции

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач КукиЗапроса, Знач Статус, Знач Окно, Знач Сохранено,
	Знач Ошибка = "")

	Пул = СервисПулов.ПулПоИдентификатору(Вердикт.Пул.Идентификатор);
	Если Пул = Неопределено Тогда
		Пул = Вердикт.Пул;
	КонецЕсли;

	Параметры = Новый Структура("Пул, Адрес, Окно", Пул, АдресРаздела(Вердикт), Окно);
	Модель = Ответы.МодельДома(Дом, Пул.Имя,
		Дом.Разделы(Пул.Имя, Ключ()),
		Ответы.УведомленияРаздела(Сохранено, Ошибка),
		Витрина.Секции(Параметры),
		Защита.ТокенСессии(Вердикт.Сессия),
		Дом.Крошки(Пул.Имя));

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт, КукиЗапроса, Статус);

КонецПроцедуры

Функция АдресРаздела(Знач Вердикт)
	Возврат Дом.АдресРаздела(Вердикт.Пул.Имя, Ключ());
КонецФункции

Функция Ключ()
	Возврат "tags";
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардПула") _ГвардПула,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомПула") _Дом,
	&Пластилин(Значение = "ВитринаТеговПула") _Витрина,
	&Пластилин(Значение = "ПультТеговПула") _Пульт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "СервисПулов") _СервисПулов)

	ГвардПула = _ГвардПула;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	Пульт = _Пульт;
	Защита = _Защита;
	Окна = _Окна;
	СервисПулов = _СервисПулов;

КонецПроцедуры
