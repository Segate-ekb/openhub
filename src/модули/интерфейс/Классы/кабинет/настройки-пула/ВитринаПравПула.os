// Раздел «Права доступа» дома «Пул». Разметку действующих ролей и окна печатает общая
// ВитринаВыдачиРоли; здесь — объект раздела и его подписи.

Перем ВитринаВыдачи;  // ВитринаВыдачиРоли — секция действующих ролей
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секции раздела «права доступа» пула.
//
// Параметры:
//  Параметры - Структура:
//    * Пул - Пул - пул, права на который показываются;
//    * Адрес - Строка - адрес раздела без параметров;
//    * МожетВыдавать - Булево - вправе ли смотрящий выдавать и отзывать права на этом пуле;
//    * Окно - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - одна секция.
//
Функция Секции(Знач Параметры) Экспорт

	Результат = Новый Массив();
	Результат.Добавить(ВитринаВыдачи.Секция(Раздел(Параметры.Пул, Параметры.Адрес),
		(Параметры.МожетВыдавать = Истина), Параметры.Окно));
	Возврат Результат;

КонецФункции

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<ключ>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат ВитринаВыдачи.ВидыОкон();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Это всё, чем раздел прав пула отличается от раздела прав пакета.
Функция Раздел(Знач Пул, Знач Адрес)

	Возврат Новый Структура("Вид, Идентификатор, Адрес, Заголовок, Лид, Пусто, ТолькоЧтение,"
			+ " ЗаголовокОкна, ЛидОкна, Сноска",
		"пул", Пул.Идентификатор, Адрес,
		Тексты.Текст("settings.pool.access.title"),
		Тексты.Текст("settings.pool.access.lead"),
		Тексты.Текст("settings.pool.access.empty"),
		Тексты.Текст("settings.pool.access.readonly"),
		Тексты.Текст("settings.pool.access-new.title"),
		Тексты.Текст("settings.pool.access-new.lead"),
		Неопределено);

КонецФункции

#КонецОбласти

&Прозвище("ВитринаПравПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВитринаВыдачиРоли") _ВитринаВыдачи,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	ВитринаВыдачи = _ВитринаВыдачи;
	Тексты = _Тексты;

КонецПроцедуры
