// Операции раздела «Зеркала» дома «Пул»: заведение по окну, правка токена, тумблер, снятие
// токена, удаление с эхом и заявка на синхронизацию. Исход каждой — домена плюс отказы у полей
// окна; зеркало называется номером из адреса. Правило ввода формы — общее с кабинетом (ПультЗеркал).

Перем Гейт;          // ГейтФормы — CSRF-токен формы
Перем РазборФормы;
Перем СервисЗеркал;  // СервисЗеркал (зеркала)
Перем ПравилаЗеркал; // ПультЗеркал — правило ввода, заведение, заявка на синхронизацию
Перем Числа;         // ПриведениеЧисел (основа) — номер зеркала из адреса
Перем Адреса;        // РазборАдреса (основа) — узел адреса для эха удаления
Перем Сбои;          // ТекстСбоя — причина отказа домена человеку
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область Эхо

// Имя эхо-поля подтверждения удаления.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляЭха() Экспорт
	Возврат "зеркало";
КонецФункции

// Что набирают в эхо-поле, удаляя зеркало: узел его адреса — короче адреса и так же узнаваем.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - запись зеркала.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОбразецЭха(Знач Зеркало) Экспорт
	Узел = Адреса.Узел(Строка(Зеркало.АпстримURL));
	Возврат ?(ЗначениеЗаполнено(Узел), Узел, Строка(Зеркало.АпстримURL));
КонецФункции

#КонецОбласти

#Область ПубличныйИнтерфейс

// Разбирает тело запроса и проверяет CSRF.
//
// Параметры:
//  Ответ - ОтветСервера.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  ТелоЗапроса - Строка.
//  КукиЗапроса - Куки - куки запроса.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - разобранная форма; Неопределено — ответ уже сформирован.
//
Функция Форма(Ответ, Знач Контекст, Знач ТелоЗапроса, Знач КукиЗапроса) Экспорт
	Возврат Гейт.СПринятымТокеном(Ответ, Контекст, РазборФормы.Разобрать(ТелоЗапроса), КукиЗапроса);
КонецФункции

// Заводит зеркало по форме окна «Новое зеркало».
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект запроса (порог права судит домен).
//  Пул - Пул - пул назначения.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка — причина отказа словами,
//              заполнена у любого отказа), Отказы (Соответствие — имя поля -> отказ под полем).
//
Функция Создать(Знач Пользователь, Знач Пул, Знач Форма) Экспорт

	Отказы = ПравилаЗеркал.ОтказыВвода(Форма);
	Если Отказы.Количество() > 0 Тогда
		Возврат ОтбитоПолями(Отказы);
	КонецЕсли;

	// отказ домена — неразбираемый адрес, неудачная проба, дубль адреса, лимит — про адрес:
	// он ложится под поле адреса, к набранному
	Попытка
		СервисЗеркал.Создать(Пользователь, Пул,
			СокрЛП(РазборФормы.Поле(Форма, ПравилаЗеркал.ИмяПоляАдреса())),
			ПравилаЗеркал.ФильтрJSON(Форма),
			РазборФормы.ЦелоеПоле(Форма, ПравилаЗеркал.ИмяПоляИнтервала(), 0),
			РазборФормы.Поле(Форма, ПравилаЗеркал.ИмяПоляТокена()),
			ПравилаЗеркал.ПереносОтмечен(Форма));
	Исключение
		Возврат ОтбитоПолем(ПравилаЗеркал.ИмяПоляАдреса(), Сбои.Человеку(ИнформацияОбОшибке()), 422);
	КонецПопытки;
	Возврат Удача();

КонецФункции

// Сохраняет правку зеркала из окна «Изменить»: новый токен доступа. Пустое поле оставляет
// прежний токен.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//  Пул - Пул - пул назначения.
//  Номер - Строка - номер зеркала из адреса.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - см. Создать.
//
Функция Сохранить(Знач Пользователь, Знач Пул, Знач Номер, Знач Форма) Экспорт

	Зеркало = ЗеркалоПула(Пул, Номер);
	Если Зеркало = Неопределено Тогда
		Возврат НетЗеркала();
	КонецЕсли;

	Токен = СокрЛП(РазборФормы.Поле(Форма, ПравилаЗеркал.ИмяПоляТокена()));
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		Возврат Удача();
	КонецЕсли;
	Попытка
		СервисЗеркал.ЗадатьТокен(Пользователь, Пул, Зеркало.Идентификатор, Токен);
	Исключение
		Возврат ОтбитоПолем(ПравилаЗеркал.ИмяПоляТокена(), Сбои.Человеку(ИнформацияОбОшибке()), 422);
	КонецПопытки;
	Возврат Удача();

КонецФункции

// Включает и выключает зеркало тумблером записи.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//  Пул - Пул - пул назначения.
//  Номер - Строка - номер зеркала из адреса.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - см. Создать.
//
Функция Переключить(Знач Пользователь, Знач Пул, Знач Номер, Знач Форма) Экспорт

	Зеркало = ЗеркалоПула(Пул, Номер);
	Если Зеркало = Неопределено Тогда
		Возврат НетЗеркала();
	КонецЕсли;
	Попытка
		СервисЗеркал.Переключить(Пользователь, Пул, Зеркало.Идентификатор, ПравилаЗеркал.ВключитьОтмечено(Форма));
	Исключение
		Возврат Отказ(Сбои.Человеку(ИнформацияОбОшибке()), 422);
	КонецПопытки;
	Возврат Удача();

КонецФункции

// Снимает с зеркала токен доступа: апстрим снова читается анонимно.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//  Пул - Пул - пул назначения.
//  Номер - Строка - номер зеркала из адреса.
//
// Возвращаемое значение:
//  Структура - см. Создать.
//
Функция СнятьТокен(Знач Пользователь, Знач Пул, Знач Номер) Экспорт

	Зеркало = ЗеркалоПула(Пул, Номер);
	Если Зеркало = Неопределено Тогда
		Возврат НетЗеркала();
	КонецЕсли;
	Попытка
		СервисЗеркал.СнятьТокен(Пользователь, Пул, Зеркало.Идентификатор);
	Исключение
		Возврат Отказ(Сбои.Человеку(ИнформацияОбОшибке()), 422);
	КонецПопытки;
	Возврат Удача();

КонецФункции

// Удаляет зеркало, если в эхо-поле подтверждения набран образец.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//  Пул - Пул - пул назначения.
//  Номер - Строка - номер зеркала из адреса.
//  Форма - Соответствие - разобранная форма подтверждения.
//
// Возвращаемое значение:
//  Структура - см. Создать; несовпавшее эхо — отказ под эхо-полем, домен не зовётся.
//
Функция Удалить(Знач Пользователь, Знач Пул, Знач Номер, Знач Форма) Экспорт

	Зеркало = ЗеркалоПула(Пул, Номер);
	Если Зеркало = Неопределено Тогда
		Возврат НетЗеркала();
	КонецЕсли;

	Образец = ОбразецЭха(Зеркало);
	Если СокрЛП(РазборФормы.Поле(Форма, ИмяПоляЭха())) <> Образец Тогда
		Возврат ОтбитоПолем(ИмяПоляЭха(), Тексты.Шаблон("settings.pool.mirrors.delete.echo.mismatch", Образец));
	КонецЕсли;
	Попытка
		СервисЗеркал.Удалить(Пользователь, Пул, Зеркало.Идентификатор);
	Исключение
		Возврат ОтбитоПолем(ИмяПоляЭха(), Сбои.Человеку(ИнформацияОбОшибке()), 422);
	КонецПопытки;
	Возврат Удача();

КонецФункции

// Ставит зеркало в очередь синхронизации. Удача ведёт на экран состояния зеркала с итогом
// заявки; выключенная синхронизация — отказ: заявку некому разобрать.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - заявитель.
//  Пул - Пул - пул назначения.
//  Номер - Строка - номер зеркала из адреса.
//
// Возвращаемое значение:
//  Структура - см. Создать; у удачи ещё КодЗаявки (Строка — итог заявки для экрана состояния,
//              см. ПультЗеркал.КодПостановки) и Номер (Строка — ключ зеркала для адреса экрана).
//
Функция Синхронизировать(Знач Пользователь, Знач Пул, Знач Номер) Экспорт

	Зеркало = ЗеркалоПула(Пул, Номер);
	Если Зеркало = Неопределено Тогда
		Возврат НетЗеркала();
	КонецЕсли;

	Код = ПравилаЗеркал.КодПостановки(Зеркало, Пользователь);
	Если Код = ПравилаЗеркал.КодВыключено() Тогда
		Возврат Отказ(Тексты.Текст("settings.pool.mirrors.error.disabled"), 503);
	КонецЕсли;

	Исход = Удача();
	Исход.Вставить("КодЗаявки", Код);
	Исход.Вставить("Номер", Формат(Зеркало.Идентификатор, "ЧГ=0; ЧН=0"));
	Возврат Исход;

КонецФункции

// Зеркало пула по номеру из адреса; чужое и несуществующее — Неопределено.
//
// Параметры:
//  Пул - Пул - пул назначения.
//  Номер - Строка - номер зеркала из адреса.
//
// Возвращаемое значение:
//  ЗеркалоХаба, Неопределено.
//
Функция ЗеркалоПула(Знач Пул, Знач Номер) Экспорт
	Возврат СервисЗеркал.ЗеркалоПула(Пул, Числа.ЧислоИлиНоль(Номер));
КонецФункции

#КонецОбласти

#Область Исход

Функция НетЗеркала()
	Возврат Отказ(Тексты.Текст("settings.pool.mirrors.error.missing"), 404);
КонецФункции

Функция Удача()
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы", Истина, 200, "", Новый Соответствие());
КонецФункции

Функция Отказ(Знач Сообщение, Знач Код)
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы", Ложь, Код, Строка(Сообщение),
		Новый Соответствие());
КонецФункции

// Отказы у полей; Сообщение — первый из них: отказ назван, даже если окна для него не будет.
Функция ОтбитоПолями(Знач Отказы)

	Исход = Отказ("", 400);
	Для Каждого Отказ_ Из Отказы Цикл
		Если НЕ ЗначениеЗаполнено(Исход.Сообщение) Тогда
			Исход.Сообщение = Строка(Отказ_.Значение);
		КонецЕсли;
		Исход.Отказы.Вставить(Отказ_.Ключ, Отказ_.Значение);
	КонецЦикла;
	Возврат Исход;

КонецФункции

Функция ОтбитоПолем(Знач ИмяПоля, Знач Текст, Знач Код = 400)

	Исход = Отказ(Текст, Код);
	Исход.Отказы.Вставить(ИмяПоля, Строка(Текст));
	Возврат Исход;

КонецФункции

#КонецОбласти

&Прозвище("ПультЗеркалПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Пластилин(Значение = "ПультЗеркал") _ПравилаЗеркал,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "РазборАдреса") _Адреса,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	СервисЗеркал = _СервисЗеркал;
	ПравилаЗеркал = _ПравилаЗеркал;
	Числа = _Числа;
	Адреса = _Адреса;
	Сбои = _Сбои;
	Тексты = _Тексты;

КонецПроцедуры
