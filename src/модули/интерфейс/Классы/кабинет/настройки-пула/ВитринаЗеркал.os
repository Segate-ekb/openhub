// Раздел «Зеркала» дома «Пул»: реестр зеркал с тумблером и меню ⚙, окно нового зеркала
// на странице, окна «Изменить», «Снять токен» и подтверждение удаления — по адресу.

Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем СервисЗеркал;  // СервисЗеркал (зеркала) — список зеркал и протокол источника
Перем Прогоны;       // ПредставлениеПрогонаЗеркала — прогон в виде для экрана
Перем Окна;          // ОкноРаздела — окно по адресу и его состояние
Перем ИменаПолей;    // ПультЗеркал — имена полей формы зеркала
Перем ПоляЗеркала;   // ПоляЗеркала — протокол словами, общий с кабинетом
Перем Пульт;         // ПультЗеркалПула — эхо удаления
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Пробник;       // ПробникИсточника (прокси) — делается ли проба подключения
Перем Секрет;        // СекретИсточника (прокси) — задан ли токен у зеркала

#Область ПубличныйИнтерфейс

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<номер зеркала>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат "новый,изменить,токен,удалить";
КонецФункции

// Секции раздела.
//
// Параметры:
//  Параметры - Структура:
//    * Пул - Пул - пул назначения;
//    * Адрес - Строка - адрес раздела;
//    * Окно - Структура, Неопределено - состояние открытого окна (см. ОкноРаздела.Отбитое);
//    * Перенос - Булево - предвыбрать флажок переноса в окне заведения: с этим человек
//      приходит со страницы пустого пула.
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - одна секция: реестр зеркал и окна.
//
Функция Секции(Знач Параметры) Экспорт

	Зеркала = СервисЗеркал.СписокПула(Параметры.Пул.Идентификатор);
	Состояние = Параметры.Окно;
	ОкноЗаведения = ОкноЗаведения(Состояние, Параметры.Перенос, Параметры.Адрес);

	Секция = Кит.Секция(Тексты.Текст("settings.pool.mirrors.title"),
			Реестр(Зеркала, Параметры.Адрес),
			ОкноЗаведения,
			ОткрытоеОкно(Зеркала, Состояние, Параметры.Адрес))
		.Лид(Тексты.Текст("settings.pool.mirrors.lead")).Иконка("копировать")
		.Действия(Кит.Кнопка(Тексты.Текст("settings.pool.mirrors.add")).Основная().Иконка("плюс")
			.Открывает(ОкноЗаведения));

	Результат = Новый Массив();
	Результат.Добавить(Секция);
	Возврат Результат;

КонецФункции

// Напечатает ли раздел окно, которое называет состояние: окно заведения — всегда; окна
// зеркала — когда зеркало с таким номером у пула есть.
//
// Параметры:
//  Пул - Пул - пул назначения.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Пул, Знач Состояние) Экспорт

	Если Окна.Открыто(Состояние, "новый") Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ЗеркалоОкна(СервисЗеркал.СписокПула(Пул.Идентификатор), Состояние) <> Неопределено;

КонецФункции

#КонецОбласти

#Область Реестр

Функция Реестр(Знач Зеркала, Знач АдресРаздела)

	Реестр = Кит.Реестр().Подпись(Тексты.Текст("settings.pool.mirrors.title"))
		.Пусто(Тексты.Текст("settings.pool.mirrors.empty"));
	Для Каждого Зеркало Из Зеркала Цикл
		Реестр.Добавить(Запись(Зеркало, АдресРаздела));
	КонецЦикла;
	Возврат Реестр;

КонецФункции

// Свёрнутая запись — адрес, доступ, перенос, прогон и последний синк; справа тумблер,
// в ⚙ — синхронизация, правка, снятие токена и удаление.
Функция Запись(Знач Зеркало, Знач АдресРаздела)

	Прогон = Прогоны.Модель(Зеркало, СервисЗеркал.ПрогонБрошен(Зеркало));

	Запись = Кит.ЗаписьРеестра(Строка(Зеркало.АпстримURL), Подробности(Зеркало, Прогон, АдресРаздела))
		.Плашка(ПлашкаДоступа(Зеркало))
		.Факт(Тексты.Текст("settings.pool.mirrors.prop.sync"), ПоследнийСинк(Прогон))
		.Действия(Тумблер(Зеркало))
		.Кнопки(
			КнопкаСинхронизации(Зеркало),
			Кит.ОкноПоАдресу(Окна.Адрес(АдресРаздела, "изменить", Ключ(Зеркало)),
				Тексты.Текст("settings.pool.mirrors.button.edit")).Иконка("карандаш"),
			КнопкаСнятияТокена(Зеркало, АдресРаздела),
			Кит.ОкноПоАдресу(Окна.Адрес(АдресРаздела, "удалить", Ключ(Зеркало)),
				Тексты.Текст("settings.pool.mirrors.button.delete")).Опасная().Иконка("корзина"));

	Если Зеркало.Перенос = Истина Тогда
		Запись.Плашка(Кит.Плашка(Тексты.Текст("settings.pool.mirrors.protocol.migrate")).Вид("accent"));
	КонецЕсли;
	Если Зеркало.Включено = Истина Тогда
		Запись.Плашка(Кит.Плашка(Тексты.Шаблон("settings.pool.mirrors.badge.run", Прогон.Подпись))
			.Вид(Прогон.Вид));
	Иначе
		Запись.Плашка(Кит.Плашка(Тексты.Текст("settings.pool.mirrors.state.off")));
	КонецЕсли;

	Возврат Запись;

КонецФункции

// Токен виден только фактом: значение не показывается ни в списке, ни в окне.
Функция ПлашкаДоступа(Знач Зеркало)

	Если ТокенЗадан(Зеркало) Тогда
		Возврат Кит.Плашка(Тексты.Текст("settings.pool.mirrors.access.token"));
	КонецЕсли;
	Возврат Кит.Плашка(Тексты.Текст("settings.pool.mirrors.access.anonymous"));

КонецФункции

// Тумблер сохраняется сразу; без скрипта форму шлёт запасная кнопка кита.
Функция Тумблер(Знач Зеркало)

	Возврат Кит.Форма(Хвост(Зеркало, "toggle"),
			Кит.Тумблер("включить",
					Тексты.Шаблон("settings.pool.mirrors.toggle.label", Зеркало.АпстримURL))
				.Включено(Зеркало.Включено = Истина).Значения("1", "0").СохранятьСразу())
		.БезПерезагрузки();

КонецФункции

// «Синхронизировать» — заявка, а не окно: ответ ведёт на экран состояния зеркала.
Функция КнопкаСинхронизации(Знач Зеркало)

	Возврат Кит.Форма(Хвост(Зеркало, "sync"),
		Кит.Кнопка(Тексты.Текст("settings.pool.mirrors.button.sync")).Основная().Иконка("стрелка"));

КонецФункции

Функция КнопкаСнятияТокена(Знач Зеркало, Знач АдресРаздела)

	Если НЕ ТокенЗадан(Зеркало) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.ОкноПоАдресу(Окна.Адрес(АдресРаздела, "токен", Ключ(Зеркало)),
		Тексты.Текст("settings.pool.mirrors.button.token-off")).Иконка("ключ");

КонецФункции

#КонецОбласти

#Область Подробности

Функция Подробности(Знач Зеркало, Знач Прогон, Знач АдресРаздела)

	Возврат Кит.Свойства(
		Кит.Свойство(Тексты.Текст("settings.pool.mirrors.prop.filter"), Фильтр(Зеркало)),
		Кит.Свойство(Тексты.Текст("settings.pool.mirrors.prop.interval"),
			Тексты.Шаблон("settings.pool.mirrors.prop.interval.value",
				Тексты.ЧислоТекстом(Зеркало.ИнтервалСинкаСек))),
		Кит.Свойство(Тексты.Текст("settings.pool.mirrors.prop.protocol"),
			ПоляЗеркала.ПротоколСловами(СервисЗеркал.Протокол(Зеркало))),
		Кит.Свойство(Тексты.Текст("settings.pool.mirrors.prop.run"),
			Тексты.Шаблон("settings.pool.mirrors.prop.run.value", Прогон.Подпись,
				Тексты.ЧислоТекстом(Прогон.Скачано), Тексты.ЧислоТекстом(Прогон.Ошибок)),
			Кит.Текст(" · "),
			Кит.Ссылка(АдресРаздела + "/" + Ключ(Зеркало), Тексты.Текст("settings.pool.mirrors.prop.run.link"))),
		Кит.Свойство(Тексты.Текст("settings.pool.mirrors.prop.sync"), ПоследнийСинк(Прогон)));

КонецФункции

// Маски фильтра — каждая кодом; без фильтра зеркало забирает всё.
Функция Фильтр(Знач Зеркало)

	Маски = Маски(Зеркало);
	Если Маски.Количество() = 0 Тогда
		Возврат Кит.Текст(Тексты.Текст("settings.pool.mirrors.filter.all"));
	КонецЕсли;

	Результат = Кит.Холст();
	Для Каждого Маска Из Маски Цикл
		Если Результат.Дети().Количество() > 0 Тогда
			Результат.Добавить(Кит.Текст(", "));
		КонецЕсли;
		Результат.Добавить(Кит.Код(Маска));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Маски из JSON-массива зеркала; неразбираемый фильтр показывается строкой как есть.
Функция Маски(Знач Зеркало)

	Маски = Новый Массив();
	Текст = СокрЛП(Строка(Зеркало.ФильтрJSON));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Маски;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON();
		Чтение.УстановитьСтроку(Текст);
		Разобрано = ПрочитатьJSON(Чтение);
	Исключение
		Разобрано = Неопределено;
	КонецПопытки;
	Если ТипЗнч(Разобрано) <> Тип("Массив") Тогда
		Маски.Добавить(Текст);
		Возврат Маски;
	КонецЕсли;

	Для Каждого Маска Из Разобрано Цикл
		Маски.Добавить(Строка(Маска));
	КонецЦикла;
	Возврат Маски;

КонецФункции

Функция ПоследнийСинк(Знач Прогон)
	Возврат ?(ЗначениеЗаполнено(Прогон.ПоследнийСинк), Прогон.ПоследнийСинк,
		Тексты.Текст("settings.pool.mirrors.sync.never"));
КонецФункции

#КонецОбласти

#Область Окна

// Окно «Новое зеркало»: печатается на странице всегда, открытым — по адресу или с отбитой
// формой. Ошибка пробы подключения приходит к полю адреса.
Функция ОкноЗаведения(Знач Состояние, Знач ПредвыборПереноса, Знач АдресРаздела)

	Возврат Кит.Окно(Тексты.Текст("settings.pool.mirrors.window.new"),
			ОшибкаОкна(Состояние),
			Кит.Поле(ИменаПолей.ИмяПоляАдреса(), Тексты.Текст("settings.pool.mirrors.field.url"))
				.ТипЗначения("url").Обязательное()
				.Пример(Тексты.Текст("settings.pool.mirrors.field.url.example"))
				.Значение(Окна.Значение(Состояние, ИменаПолей.ИмяПоляАдреса()))
				.Ошибка(Окна.Отказ(Состояние, ИменаПолей.ИмяПоляАдреса())),
			ПолеТокена(Состояние, Ложь),
			Кит.Поле(ИменаПолей.ИмяПоляФильтра(), Тексты.Текст("settings.pool.mirrors.field.filter")).Список()
				.Значение(Окна.Значение(Состояние, ИменаПолей.ИмяПоляФильтра()))
				.Подсказка(Тексты.Текст("settings.pool.mirrors.field.filter.hint"))
				.Ошибка(Окна.Отказ(Состояние, ИменаПолей.ИмяПоляФильтра())),
			Кит.Поле(ИменаПолей.ИмяПоляИнтервала(), Тексты.Текст("settings.pool.mirrors.field.interval"))
				.ТипЗначения(Тип("Число")).Пример("3600")
				.Значение(Окна.Значение(Состояние, ИменаПолей.ИмяПоляИнтервала()))
				.Ошибка(Окна.Отказ(Состояние, ИменаПолей.ИмяПоляИнтервала())),
			Кит.Поле(ИменаПолей.ИмяПоляПереноса(), Тексты.Текст("settings.pool.mirror-new.migrate.label"))
				.ТипЗначения("флажок").Значение("1")
				.Отмечено(Окна.Отмечено(Состояние, ИменаПолей.ИмяПоляПереноса(), ПредвыборПереноса = Истина))
				.Подсказка(Тексты.Текст("settings.pool.mirrors.field.migrate.hint"))
				.Справка(Тексты.Текст("settings.pool.mirror-new.migrate.note")),
			Кит.Примечание(ОбещаниеПробы()))
		.Форма("").БезПерезагрузки().Якорь("zerkalo-novoe").Адрес(Окна.Адрес(АдресРаздела, "новый"))
		.Открыто(Окна.Открыто(Состояние, "новый") ИЛИ ПредвыборПереноса = Истина).АдресЗакрытия(АдресРаздела)
		.Действия(Кит.Кнопка(Тексты.Текст("settings.pool.mirror-new.button")).Основная().Иконка("плюс"));

КонецФункции

// Окно зеркала, названное адресом. Зеркала с таким номером нет — страница без окна.
Функция ОткрытоеОкно(Знач Зеркала, Знач Состояние, Знач АдресРаздела)

	Зеркало = ЗеркалоОкна(Зеркала, Состояние);
	Если Зеркало = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Окна.Открыто(Состояние, "изменить") Тогда
		Возврат ОкноПравки(Зеркало, Состояние, АдресРаздела);
	ИначеЕсли Окна.Открыто(Состояние, "токен") Тогда
		Возврат ОкноСнятияТокена(Зеркало, Состояние, АдресРаздела);
	КонецЕсли;
	Возврат ОкноУдаления(Зеркало, Состояние, АдресРаздела);

КонецФункции

// Окно токена — только у зеркала, у которого токен есть: снимать нечего — окна нет.
Функция ЗеркалоОкна(Знач Зеркала, Знач Состояние)

	Если Состояние = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Состояние.Ключ)
		ИЛИ Окна.Открыто(Состояние, "новый") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Зеркало Из Зеркала Цикл
		Если Ключ(Зеркало) = Состояние.Ключ Тогда
			Возврат ?(Окна.Открыто(Состояние, "токен") И НЕ ТокенЗадан(Зеркало), Неопределено, Зеркало);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Правка — то, что домен меняет у заведённого зеркала: токен доступа. Адрес, фильтр,
// интервал и перенос заданы при заведении и видны здесь же.
Функция ОкноПравки(Знач Зеркало, Знач Состояние, Знач АдресРаздела)

	Возврат Кит.Окно(Тексты.Текст("settings.pool.mirrors.window.edit"),
			ОшибкаОкна(Состояние),
			Кит.Свойства(
				Кит.Свойство(Тексты.Текст("settings.pool.mirrors.prop.url"),
					Кит.Код(Строка(Зеркало.АпстримURL))).Копируемое(Строка(Зеркало.АпстримURL)),
				Кит.Свойство(Тексты.Текст("settings.pool.mirrors.prop.filter"), Фильтр(Зеркало)),
				Кит.Свойство(Тексты.Текст("settings.pool.mirrors.prop.interval"),
					Тексты.Шаблон("settings.pool.mirrors.prop.interval.value",
						Тексты.ЧислоТекстом(Зеркало.ИнтервалСинкаСек))),
				Кит.Свойство(Тексты.Текст("settings.pool.mirrors.prop.migrate"),
					?(Зеркало.Перенос = Истина, Тексты.Текст("settings.pool.mirrors.migrate.yes"),
						Тексты.Текст("settings.pool.mirrors.migrate.no")))),
			Кит.Примечание(Тексты.Текст("settings.pool.mirrors.edit.note")),
			ПолеТокена(Состояние, ТокенЗадан(Зеркало)))
		.Форма(Хвост(Зеркало, "save")).БезПерезагрузки().Якорь("zerkalo-pravka").Открыто()
		.АдресЗакрытия(АдресРаздела)
		.Действия(Кит.Кнопка(Тексты.Текст("settings.pool.mirrors.button.save")).Основная().Иконка("сохранить"));

КонецФункции

// Сохранённый токен хаб не показывает: у правки пустое поле значит «оставить прежний».
Функция ПолеТокена(Знач Состояние, Знач ТокенЗадан)

	Поле = Кит.Поле(ИменаПолей.ИмяПоляТокена(), Тексты.Текст("settings.pool.mirrors.field.token")).Секрет()
		.Ошибка(Окна.Отказ(Состояние, ИменаПолей.ИмяПоляТокена()));
	Если ТокенЗадан Тогда
		Возврат Поле.Подсказка(Тексты.Текст("settings.pool.mirrors.field.token.keep"));
	КонецЕсли;
	Возврат Поле.Подсказка(Тексты.Текст("settings.pool.mirrors.field.token.hint"));

КонецФункции

// Снятие токена обратимо только новым токеном, которого у хозяина может уже не быть, —
// поэтому оно идёт малым окном, называющим следствие, а не сразу из меню.
Функция ОкноСнятияТокена(Знач Зеркало, Знач Состояние, Знач АдресРаздела)

	Возврат Кит.Окно(Тексты.Текст("settings.pool.mirrors.window.token"),
			ОшибкаОкна(Состояние),
			Кит.Свойства(Кит.Свойство(Тексты.Текст("settings.pool.mirrors.prop.url"),
				Кит.Код(Строка(Зеркало.АпстримURL)))),
			Кит.Примечание(Тексты.Текст("settings.pool.mirrors.token-off.note")))
		.Форма(Хвост(Зеркало, "token-off")).БезПерезагрузки().Якорь("zerkalo-token").Открыто()
		.АдресЗакрытия(АдресРаздела)
		.Действия(Кит.Кнопка(Тексты.Текст("settings.pool.mirrors.button.token-off")).Основная().Иконка("ключ"));

КонецФункции

// Удаление спрашивает узел адреса: настройки зеркала пропадут, привезённое остаётся в пуле.
Функция ОкноУдаления(Знач Зеркало, Знач Состояние, Знач АдресРаздела)

	Возврат Кит.Подтверждение(Тексты.Текст("settings.pool.mirrors.delete.title"),
			Тексты.Шаблон("settings.pool.mirrors.delete.consequence", Зеркало.АпстримURL))
		.Эхо(Пульт.ИмяПоляЭха(), Пульт.ОбразецЭха(Зеркало),
			Тексты.Шаблон("settings.pool.mirrors.delete.echo", Пульт.ОбразецЭха(Зеркало)))
		.Кнопка(Тексты.Текст("settings.pool.mirrors.button.delete"))
		.Ошибка(Окна.Отказ(Состояние, Пульт.ИмяПоляЭха()))
		.Форма(Хвост(Зеркало, "delete")).БезПерезагрузки().Якорь("zerkalo-udalit").Открыто()
		.АдресЗакрытия(АдресРаздела);

КонецФункции

// Отказ домена, который не относится к одному полю, — над полями.
Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

// Обещать пробу вправе только экран, на котором она делается: выключатель снимает её целиком.
Функция ОбещаниеПробы()

	Если Пробник <> Неопределено И Пробник.ПробаВключена() Тогда
		Возврат Тексты.Текст("settings.pool.mirror-new.probe.note");
	КонецЕсли;
	Возврат Тексты.Текст("settings.pool.mirror-new.probe.note.off");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТокенЗадан(Знач Зеркало)
	Возврат Секрет.Задан(Секрет.ИзИсточника(Зеркало));
КонецФункции

Функция Ключ(Знач Зеркало)
	Возврат Формат(Зеркало.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

// Адрес формы зеркала относительно раздела: «<номер>/<действие>».
Функция Хвост(Знач Зеркало, Знач Действие)
	Возврат Ключ(Зеркало) + "/" + Действие;
КонецФункции

#КонецОбласти

&Прозвище("ВитринаЗеркал")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Пластилин(Значение = "ПредставлениеПрогонаЗеркала") _Прогоны,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ПультЗеркал") _ИменаПолей,
	&Пластилин(Значение = "ПоляЗеркала") _ПоляЗеркала,
	&Пластилин(Значение = "ПультЗеркалПула") _Пульт,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПробникИсточника", Тип = "Массив") _Пробник,
	&Пластилин(Значение = "СекретИсточника") _Секрет = Неопределено) Экспорт

	Кит = _Кит;
	СервисЗеркал = _СервисЗеркал;
	Прогоны = _Прогоны;
	Окна = _Окна;
	ИменаПолей = _ИменаПолей;
	ПоляЗеркала = _ПоляЗеркала;
	Пульт = _Пульт;
	Тексты = _Тексты;
	// без модуля прокси пробы нет и у заведения зеркала (СервисЗеркал.ПроверитьПодключение)
	Пробник = ?(_Пробник = Неопределено ИЛИ _Пробник.Количество() = 0, Неопределено, _Пробник[0]);
	Секрет = ?(_Секрет = Неопределено, Новый СекретИсточника(), _Секрет);

КонецПроцедуры
