// Раздел «Апстримы» дома «Пул»: нумерованный реестр источников в порядке обхода со стрелками,
// тумблером и меню ⚙, окно нового источника на странице, окна «Снять токен» и подтверждение
// удаления — по адресу; ниже — тумблер публикации пула.

Перем Кит;        // Кит (кит) — фабрика элементов экрана
Перем Апстримы;   // СервисАпстримовПула (реестр) — источники пула в порядке обхода
Перем Окна;       // ОкноРаздела — окно по адресу и его состояние
Перем ИменаПолей; // ПультАпстримовПула — имена полей форм раздела
Перем Тексты;     // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Вердикты;   // СостояниеИсточников (прокси) — жив источник, лежит или молчал
                  // до перезапуска
Перем Пробник;    // ПробникИсточника (прокси) — делается ли проба подключения
Перем Секрет;     // СекретИсточника (прокси) — задан ли токен у источника
Перем Даты;       // ДатаЧеловеку — одно написание момента на весь интерфейс

#Область ПубличныйИнтерфейс

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<номер источника>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат "новый,токен,удалить";
КонецФункции

// Секции раздела: реестр источников с окнами и тумблер публикации пула.
//
// Параметры:
//  Параметры - Структура:
//    * Пул - Пул - пул раздела;
//    * Адрес - Строка - адрес раздела;
//    * Окно - Структура, Неопределено - состояние открытого окна (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - секции «Апстримы» и «Публикация».
//
Функция Секции(Знач Параметры) Экспорт

	Пул = Параметры.Пул;
	Адрес = Параметры.Адрес;
	Состояние = Параметры.Окно;
	Показания = Показания(Пул);
	ОкноЗаведения = ОкноЗаведения(Состояние, Адрес);

	Источники = Кит.Секция(Тексты.Текст("settings.pool.upstreams.title"),
			Реестр(Показания, Адрес),
			ОкноЗаведения,
			ОткрытоеОкно(Показания, Состояние, Адрес))
		.Лид(Тексты.Текст("settings.pool.upstreams.lead")).Иконка("ссылка")
		.Действия(Кит.Кнопка(Тексты.Текст("settings.pool.upstreams.add")).Основная().Иконка("плюс")
			.Открывает(ОкноЗаведения));

	Результат = Новый Массив();
	Результат.Добавить(Источники);
	Результат.Добавить(СекцияПубликации(Пул));
	Возврат Результат;

КонецФункции

// Напечатает ли раздел окно, которое называет состояние: окно заведения — всегда; окна
// источника — когда источник с таким номером у пула есть.
//
// Параметры:
//  Пул - Пул - пул раздела.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Пул, Знач Состояние) Экспорт

	Если Окна.Открыто(Состояние, "новый") Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ПоказаниеОкна(Показания(Пул), Состояние) <> Неопределено;

КонецФункции

#КонецОбласти

#Область Реестр

// Порядок обхода значим: реестр нумерованный, первый опрашивается первым.
Функция Реестр(Знач Показания, Знач АдресРаздела)

	Реестр = Кит.Реестр().Нумерованный().Подпись(Тексты.Текст("settings.pool.upstreams.title"))
		.Пусто(Тексты.Текст("settings.pool.upstreams.empty"));

	Всего = Показания.Количество();
	Номер = 0;
	Для Каждого Показание Из Показания Цикл
		Номер = Номер + 1;
		Реестр.Добавить(Запись(Показание, Номер = 1, Номер = Всего, АдресРаздела));
	КонецЦикла;
	Возврат Реестр;

КонецФункции

// Свёрнутая запись — адрес, доступ и живость; справа стрелки и тумблер, в ⚙ — снятие токена
// и удаление. Правки источника нет: домен меняет у источника только токен, тумблер и порядок.
Функция Запись(Знач Показание, Знач Первый, Знач Последний, Знач АдресРаздела)

	Источник = Показание.Источник;

	Возврат Кит.ЗаписьРеестра(Строка(Источник.Url), Подробности(Показание))
		.Плашка(ПлашкаДоступа(Источник))
		.Плашка(ПлашкаСостояния(Источник, Показание.Состояние))
		.Действия(Стрелки(Источник, Первый, Последний), Тумблер(Источник))
		.Кнопки(КнопкаСнятияТокена(Источник, АдресРаздела), КнопкаУдаления(Источник, АдресРаздела));

КонецФункции

// Токен виден только фактом: значение не показывается ни в списке, ни в окне.
Функция ПлашкаДоступа(Знач Источник)

	Если ТокенЗадан(Источник) Тогда
		Возврат Кит.Плашка(Тексты.Текст("settings.pool.upstreams.access.token"));
	КонецЕсли;
	Возврат Кит.Плашка(Тексты.Текст("settings.pool.upstreams.access.anonymous"));

КонецФункции

// «Лежит» никогда не выдаётся за «выключен»: это две независимые вещи.
Функция ПлашкаСостояния(Знач Источник, Знач Состояние)

	Если Состояние = Неопределено Тогда
		Возврат Кит.Плашка(Тексты.Текст(?(Источник.Включён = Истина,
			"settings.pool.upstreams.badge.unknown", "settings.pool.upstreams.badge.off")));
	ИначеЕсли Состояние.Код = Вердикты.Выключен() Тогда
		Возврат Кит.Плашка(Тексты.Текст("settings.pool.upstreams.badge.off"));
	ИначеЕсли Состояние.Код = Вердикты.НеПроверялся() Тогда
		Возврат Кит.Плашка(Тексты.Текст("settings.pool.upstreams.badge.unknown"));
	ИначеЕсли Состояние.Код = Вердикты.Лежит() Тогда
		Возврат Кит.Плашка(Тексты.Шаблон("settings.pool.upstreams.badge.down",
			Даты.ТолькоДата(Состояние.Проверено))).Вид("err");
	ИначеЕсли Состояние.Код = Вердикты.НеПустил() Тогда
		Возврат Кит.Плашка(Тексты.Текст("settings.pool.upstreams.badge.denied")).Вид("warn");
	КонецЕсли;
	Возврат Кит.Плашка(Тексты.Текст("settings.pool.upstreams.badge.alive")).Вид("ok");

КонецФункции

// Стрелки порядка — одна форма с двумя кнопками: сервер переставляет источник по текущему
// порядку и возвращает раздел. Крайним стрелка за край недоступна.
Функция Стрелки(Знач Источник, Знач Первый, Знач Последний)

	Ниже = Кит.Кнопка(Тексты.Текст("settings.pool.upstreams.button.down")).Иконка("вниз")
		.ТолькоИконка().Малая().Вторичная().Имя(ИменаПолей.ИмяПоляСдвига(), ИменаПолей.СдвигВниз());
	Выше = Кит.Кнопка(Тексты.Текст("settings.pool.upstreams.button.up")).Иконка("вверх")
		.ТолькоИконка().Малая().Вторичная().Имя(ИменаПолей.ИмяПоляСдвига(), ИменаПолей.СдвигВверх());
	Если Последний Тогда
		Ниже.Заблокирована();
	КонецЕсли;
	Если Первый Тогда
		Выше.Заблокирована();
	КонецЕсли;

	Возврат Кит.Форма(Хвост(Источник, "move"), Ниже, Выше).БезПерезагрузки();

КонецФункции

// Тумблер сохраняется сразу; без скрипта форму шлёт запасная кнопка кита.
Функция Тумблер(Знач Источник)

	Возврат Кит.Форма(Хвост(Источник, "toggle"),
			Кит.Тумблер(ИменаПолей.ИмяПоляВключён(),
					Тексты.Шаблон("settings.pool.upstreams.toggle.label", Источник.Url))
				.Включено(Источник.Включён = Истина).Значения(ИменаПолей.ЗначениеОтмечено(), "0")
				.СохранятьСразу())
		.БезПерезагрузки();

КонецФункции

// Снимать нечего у источника без токена — пункта у него нет.
Функция КнопкаСнятияТокена(Знач Источник, Знач АдресРаздела)

	Если НЕ ТокенЗадан(Источник) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.ОкноПоАдресу(Окна.Адрес(АдресРаздела, "токен", Ключ(Источник)),
		Тексты.Текст("settings.pool.upstreams.button.token-off")).Иконка("ключ");

КонецФункции

Функция КнопкаУдаления(Знач Источник, Знач АдресРаздела)

	Возврат Кит.ОкноПоАдресу(Окна.Адрес(АдресРаздела, "удалить", Ключ(Источник)),
		Тексты.Текст("settings.pool.upstreams.button.remove")).Опасная().Иконка("корзина");

КонецФункции

#КонецОбласти

#Область Подробности

Функция Подробности(Знач Показание)

	Источник = Показание.Источник;

	Возврат Кит.Свойства(
		Кит.Свойство(Тексты.Текст("settings.pool.upstreams.prop.ttl"),
			Тексты.Шаблон("settings.pool.upstreams.prop.ttl.value", Тексты.ЧислоТекстом(Источник.ВремяЖизниСек))),
		Кит.Свойство(Тексты.Текст("settings.pool.upstreams.prop.access"),
			?(ТокенЗадан(Источник), Тексты.Текст("settings.pool.upstreams.access.token"),
				Тексты.Текст("settings.pool.upstreams.access.anonymous"))),
		Кит.Свойство(Тексты.Текст("settings.pool.upstreams.prop.filter"),
			Кит.Код(Строка(Источник.СписокРазрешенийJSON)))
			.Когда(ЗначениеЗаполнено(Источник.СписокРазрешенийJSON)),
		Кит.Свойство(Тексты.Текст("settings.pool.upstreams.prop.state"),
			СостояниеСловами(Источник, Показание.Состояние)));

КонецФункции

Функция СостояниеСловами(Знач Источник, Знач Состояние)

	// модуль прокси не собрался: о живости сказать нечего, тумблер виден и без него
	Если Состояние = Неопределено Тогда
		Возврат Тексты.Текст(?(Источник.Включён = Истина,
			"settings.pool.upstreams.state.unknown", "settings.pool.upstreams.state.off"));
	КонецЕсли;

	Если Состояние.Код = Вердикты.Выключен() Тогда
		Возврат Тексты.Текст("settings.pool.upstreams.state.off")
			+ ПрошлаяНеудачаСловами(Состояние.ПрошлаяНеудача);
	КонецЕсли;

	Если Состояние.Код = Вердикты.НеПроверялся() Тогда
		Возврат НеПроверялсяСловами(Состояние.ПрошлаяНеудача);
	КонецЕсли;

	Когда = Даты.Метка(Состояние.Проверено);
	Если Состояние.Код = Вердикты.Лежит() Тогда
		Возврат Тексты.Шаблон("settings.pool.upstreams.state.down", Когда, Состояние.Причина);
	КонецЕсли;
	// «не пустил» не выдаётся ни за «жив», ни за «лежит»: человеку нужно чинить доступ,
	// а не адрес
	Если Состояние.Код = Вердикты.НеПустил() Тогда
		Возврат Тексты.Шаблон("settings.pool.upstreams.state.denied", Когда, Состояние.Причина);
	КонецЕсли;
	Возврат Тексты.Шаблон("settings.pool.upstreams.state.alive", Когда);

КонецФункции

// Перезапуск стёр вердикт, но не прошлую неудачу: она называется прошлой.
Функция НеПроверялсяСловами(Знач Прошлая)

	Если НЕ Прошлая.Есть Тогда
		Возврат Тексты.Текст("settings.pool.upstreams.state.unknown");
	КонецЕсли;

	Возврат Тексты.Текст("settings.pool.upstreams.state.unknown.restart")
		+ ПрошлаяНеудачаСловами(Прошлая);

КонецФункции

// Прошлая неудача — свойство адреса, а не тумблера: договаривается и у выключенного источника.
Функция ПрошлаяНеудачаСловами(Знач Прошлая)

	Если НЕ Прошлая.Есть Тогда
		Возврат "";
	КонецЕсли;

	Когда = Даты.Метка(Прошлая.Когда);
	Если Прошлая.Код = Вердикты.НеПустил() Тогда
		Возврат Тексты.Текст("settings.pool.upstreams.state.join")
			+ Тексты.Шаблон("settings.pool.upstreams.last-failure.denied", Когда, Прошлая.Причина);
	КонецЕсли;
	Возврат Тексты.Текст("settings.pool.upstreams.state.join")
		+ Тексты.Шаблон("settings.pool.upstreams.last-failure.down", Когда, Прошлая.Причина);

КонецФункции

#КонецОбласти

#Область Окна

// Окно «Новый апстрим»: печатается на странице всегда, открытым — по адресу или с отбитой
// формой. Ошибка пробы подключения приходит к полю адреса.
Функция ОкноЗаведения(Знач Состояние, Знач АдресРаздела)

	Возврат Кит.Окно(Тексты.Текст("settings.pool.upstreams.window.new"),
			ОшибкаОкна(Состояние),
			Кит.Поле(ИменаПолей.ИмяПоляАдреса(), Тексты.Текст("settings.pool.upstreams.field.url"))
				.ТипЗначения("url").Обязательное()
				.Пример(Тексты.Текст("settings.pool.upstreams.field.url.example"))
				.Значение(Окна.Значение(Состояние, ИменаПолей.ИмяПоляАдреса()))
				.Ошибка(Окна.Отказ(Состояние, ИменаПолей.ИмяПоляАдреса())),
			Кит.Поле(ИменаПолей.ИмяПоляТокена(), Тексты.Текст("settings.pool.upstreams.field.token"))
				.Секрет().Подсказка(Тексты.Текст("settings.pool.upstreams.field.token.hint"))
				.Ошибка(Окна.Отказ(Состояние, ИменаПолей.ИмяПоляТокена())),
			Кит.Поле(ИменаПолей.ИмяПоляВремениЖизни(), Тексты.Текст("settings.pool.upstreams.field.ttl"))
				.ТипЗначения(Тип("Число"))
				.Значение(Окна.Значение(Состояние, ИменаПолей.ИмяПоляВремениЖизни(), ИменаПолей.ВремяЖизниПоУмолчанию()))
				.Подсказка(Тексты.Текст("settings.pool.upstreams.field.ttl.hint"))
				.Ошибка(Окна.Отказ(Состояние, ИменаПолей.ИмяПоляВремениЖизни())),
			Кит.Примечание(ОбещаниеПробы()))
		.Форма("").БезПерезагрузки().Якорь(ЯкорьЗаведения())
		.Адрес(Окна.Адрес(АдресРаздела, "новый")).Открыто(Окна.Открыто(Состояние, "новый"))
		.АдресЗакрытия(АдресРаздела)
		.Действия(Кит.Кнопка(Тексты.Текст("settings.pool.upstreams.button.create")).Основная().Иконка("плюс"));

КонецФункции

// Окно источника, названное адресом. Источника с таким номером нет — страница без окна.
Функция ОткрытоеОкно(Знач Показания, Знач Состояние, Знач АдресРаздела)

	Показание = ПоказаниеОкна(Показания, Состояние);
	Если Показание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Окна.Открыто(Состояние, "токен") Тогда
		Возврат ОкноСнятияТокена(Показание.Источник, Состояние, АдресРаздела);
	КонецЕсли;
	Возврат ОкноУдаления(Показание.Источник, Состояние, АдресРаздела);

КонецФункции

// Окно токена — только у источника, у которого токен есть: снимать нечего — окна нет.
Функция ПоказаниеОкна(Знач Показания, Знач Состояние)

	Если Состояние = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Состояние.Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ Окна.Открыто(Состояние, "токен") И НЕ Окна.Открыто(Состояние, "удалить") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Показание Из Показания Цикл
		Если Ключ(Показание.Источник) = Состояние.Ключ Тогда
			Если Окна.Открыто(Состояние, "токен") И НЕ ТокенЗадан(Показание.Источник) Тогда
				Возврат Неопределено;
			КонецЕсли;
			Возврат Показание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Снятие токена обратимо только новым токеном, которого у хозяина может уже не быть, —
// поэтому оно идёт малым окном, называющим следствие, а не сразу из меню.
Функция ОкноСнятияТокена(Знач Источник, Знач Состояние, Знач АдресРаздела)

	Возврат Кит.Окно(Тексты.Текст("settings.pool.upstreams.window.token"),
			ОшибкаОкна(Состояние),
			Кит.Свойства(Кит.Свойство(Тексты.Текст("settings.pool.upstreams.prop.url"),
				Кит.Код(Строка(Источник.Url)))),
			Кит.Примечание(Тексты.Текст("settings.pool.upstreams.token-off.note")))
		.Форма(Хвост(Источник, "token-off")).БезПерезагрузки().Якорь("apstrim-token").Открыто()
		.АдресЗакрытия(АдресРаздела)
		.Действия(Кит.Кнопка(Тексты.Текст("settings.pool.upstreams.button.token-off")).Основная().Иконка("ключ"));

КонецФункции

// Удаление уносит адрес, токен и место в порядке обхода; кэш пула остаётся.
Функция ОкноУдаления(Знач Источник, Знач Состояние, Знач АдресРаздела)

	Возврат Кит.Подтверждение(Тексты.Текст("settings.pool.upstreams.delete.title"),
			Тексты.Шаблон("settings.pool.upstreams.delete.consequence", Источник.Url),
			ОшибкаОкна(Состояние))
		.Кнопка(Тексты.Текст("settings.pool.upstreams.button.remove"))
		.Форма(Хвост(Источник, "delete")).БезПерезагрузки().Якорь("apstrim-udalit").Открыто()
		.АдресЗакрытия(АдресРаздела);

КонецФункции

// Отказ домена, который не относится к одному полю, — над полями.
Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

// Обещать пробу вправе только экран, на котором она делается: выключатель снимает её целиком.
Функция ОбещаниеПробы()

	Если Пробник <> Неопределено И Пробник.ПробаВключена() Тогда
		Возврат Тексты.Текст("settings.pool.upstream-new.probe.note");
	КонецЕсли;
	Возврат Тексты.Текст("settings.pool.upstream-new.probe.note.off");

КонецФункции

Функция ЯкорьЗаведения()
	Возврат "apstrim-novyi";
КонецФункции

#КонецОбласти

#Область Публикация

// Публикация — свойство пула, а не источника: чистый прокси-кэш только раздаёт взятое
// с апстримов. Тумблер сохраняется сразу.
Функция СекцияПубликации(Знач Пул)

	Возврат Кит.Секция(Тексты.Текст("settings.pool.publication.title"),
			Кит.Форма("publication",
				Кит.Тумблер(ИменаПолей.ИмяПоляПубликации(), Тексты.Текст("settings.pool.publication.label"))
					.Включено(Пул.ПубликацияРазрешена = Истина).Значения(ИменаПолей.ЗначениеОтмечено(), "0")
					.Подписи(Тексты.Текст("settings.pool.publication.on"),
						Тексты.Текст("settings.pool.publication.off"))
					.СохранятьСразу())
				.БезПерезагрузки())
		.Лид(Тексты.Текст("settings.pool.publication.lead")).Иконка("отправить");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Источники пула с состоянием, прочитанным на весь список разом; без модуля прокси — без состояний.
Функция Показания(Знач Пул)

	Источники = Апстримы.Все(Пул.Идентификатор);

	Результат = Новый Массив();
	Если Вердикты = Неопределено Тогда
		Для Каждого Источник Из Источники Цикл
			Результат.Добавить(Новый Структура("Источник, Состояние", Источник, Неопределено));
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;

	Для Каждого Показание Из Вердикты.ПоИсточникам(Источники) Цикл
		Результат.Добавить(Новый Структура("Источник, Состояние", Показание.Источник,
			Вердикты.СУчётомТумблера(Показание.Состояние, Показание.Источник.Включён)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ТокенЗадан(Знач Источник)
	Возврат Секрет.Задан(Секрет.ИзИсточника(Источник));
КонецФункции

// Ключ записи в адресах — номер источника: адрес источника в адресе окна читать некому.
Функция Ключ(Знач Источник)
	Возврат Формат(Источник.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

// Адрес формы источника относительно раздела: «<номер>/<действие>».
Функция Хвост(Знач Источник, Знач Действие)
	Возврат Ключ(Источник) + "/" + Действие;
КонецФункции

#КонецОбласти

&Прозвище("ВитринаАпстримов")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисАпстримовПула") _Апстримы,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ПультАпстримовПула") _ИменаПолей,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СостояниеИсточников", Тип = "Массив") _Вердикты,
	&Пластилин(Значение = "ПробникИсточника", Тип = "Массив") _Пробник,
	&Пластилин(Значение = "СекретИсточника") _Секрет = Неопределено,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено)

	Кит = _Кит;
	Апстримы = _Апстримы;
	Окна = _Окна;
	ИменаПолей = _ИменаПолей;
	Тексты = _Тексты;
	// без модуля прокси состояние источника неизвестно, список показывается без него
	Вердикты = ?(_Вердикты = Неопределено ИЛИ _Вердикты.Количество() = 0,
		Неопределено, _Вердикты[0]);
	// без модуля прокси пробы нет и у заведения источника
	Пробник = ?(_Пробник = Неопределено ИЛИ _Пробник.Количество() = 0, Неопределено, _Пробник[0]);
	Секрет = ?(_Секрет = Неопределено, Новый СекретИсточника(), _Секрет);
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);

КонецПроцедуры
