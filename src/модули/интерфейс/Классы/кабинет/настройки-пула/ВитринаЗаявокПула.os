// Раздел «Входящие»: заявки на публикацию, ждущие решения, — в доме «Пул» и на странице заявок
// кабинета (там с колонкой пула); решение — окнами по адресу из меню ⚙ строки; секция заявок
// для сводки кабинета.

Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем Окна;           // ОкноРаздела — окно по адресу и его состояние
Перем Подтверждения;  // Подтверждение (кит) — имя поля подтверждённой отправки
Перем Страницы;       // АдресаСтраниц (реестр) — адрес пула для колонки пула
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Даты;           // ДатаЧеловеку — одно написание момента на весь интерфейс
Перем Обрезка;        // ОбрезаниеТекста (основа) — длинное значение в узкой колонке
Перем Адреса;         // РазборАдреса (основа) — видимый текст ссылки на репозиторий без схемы

#Область ПубличныйИнтерфейс

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<номер заявки>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат ВидОдобрения() + "," + ВидОтклонения();
КонецФункции

// Вид окна одобрения заявки; он же значение операции в форме окна.
//
// Возвращаемое значение:
//  Строка.
//
Функция ВидОдобрения() Экспорт
	Возврат "одобрить";
КонецФункции

// Вид окна отклонения заявки; он же значение операции в форме окна.
//
// Возвращаемое значение:
//  Строка.
//
Функция ВидОтклонения() Экспорт
	Возврат "отклонить";
КонецФункции

// Поле формы окна с операцией: одобрить либо отклонить.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Поле формы окна с номером заявки.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляЗаявки() Экспорт
	Возврат "заявка";
КонецФункции

// Поле формы окна отклонения с причиной, которую увидит заявитель.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляПричины() Экспорт
	Возврат "причина";
КонецФункции

// Секции экрана заявок.
//
// Параметры:
//  Параметры - Структура:
//    * Строки - Массив - строки заявок (Пул, Заявка, Заявитель, Манифест) от РассмотрениеВходящих;
//    * Адрес - Строка - адрес раздела: от него строятся адреса окон, на него уходят их формы;
//    * СПулом - Булево - показывать колонку «Пул» (страница заявок по всем пулам);
//    * Окно - Структура, Неопределено - состояние окна, открытого адресом либо отбитой формой
//             (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - одна секция: таблица заявок и открытое окно решения.
//
Функция Секции(Знач Параметры) Экспорт

	СПулом = Ложь;
	Параметры.Свойство("СПулом", СПулом);
	Состояние = Неопределено;
	Параметры.Свойство("Окно", Состояние);

	Секция = Кит.Секция(Тексты.Текст("settings.inbox.title"),
			ТаблицаЗаявок(Параметры.Строки, Параметры.Адрес, СПулом = Истина),
			ОкноРешения(Параметры.Строки, Состояние, Параметры.Адрес))
		.Лид(Тексты.Текст("settings.inbox.lead")).Иконка("пакет");

	Результат = Новый Массив();
	Результат.Добавить(Секция);
	Возврат Результат;

КонецФункции

// Напечатает ли раздел окно, которое называет состояние: заявка с этим номером есть среди
// показанных и вид окна — решение по ней.
//
// Параметры:
//  Состояние - Структура, Неопределено - состояние окна раздела.
//  Строки - Массив - строки заявок, которые видит смотрящий.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Состояние, Знач Строки) Экспорт
	Возврат СтрокаОкна(Состояние, Строки) <> Неопределено;
КонецФункции

// Секция «заявки ждут вашего решения» для сводки кабинета: несколько свежих строк и ход
// к полному списку; без заявок секции нет.
//
// Параметры:
//  Строки - Массив - строки заявок (Пул, Заявка, Заявитель).
//  Адрес - Строка - адрес полного списка.
//  Предел - Число - сколько строк показать (необязательный, по умолчанию 3).
//
// Возвращаемое значение:
//  ЭлементЭкрана, Неопределено - секция Кит.Секция либо Неопределено при отсутствии заявок.
//
Функция СекцияСводки(Знач Строки, Знач Адрес, Знач Предел = 3) Экспорт

	Если Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Секция(Тексты.Шаблон("settings.inbox.widget.title",
				Тексты.ЧислоТекстом(Строки.Количество())),
			ТаблицаСвежих(Свежайшие(Строки, Предел)))
		.Лид(Тексты.Текст("settings.inbox.widget.lead")).Иконка("пакет")
		.Действия(Кит.Кнопка(Тексты.Текст("settings.inbox.widget.open")).Вторичная().Иконка("вправо")
			.Адрес(Адрес));

КонецФункции

#КонецОбласти

#Область СписокЗаявок

// На узком экране — карточки с пакетом заглавием и ⚙ в углу; сведения манифеста — разворотом
// во всю ширину: в колонке описание ломалось бы по слову.
Функция ТаблицаЗаявок(Знач Строки, Знач Адрес, Знач СПулом)

	Таблица = Кит.Таблица(ЗаписиЗаявок(Строки, Адрес)).Вид("карточками").Пустое("—")
		.Пусто(Тексты.Текст("settings.inbox.empty"))
		.Разворот("manifest");
	Таблица.Колонка("package", Тексты.Текст("settings.inbox.col.package")).Заглавная();
	Таблица.Колонка("pool", Тексты.Текст("settings.inbox.col.pool")).Когда(СПулом);
	Таблица.Колонка("author", Тексты.Текст("settings.inbox.col.author"));
	Таблица.Колонка("filed", Тексты.Текст("settings.inbox.col.filed"));
	Таблица.Колонка("actions", "").Вид("узкая").БезПодписиВЗаписи();
	Возврат Таблица;

КонецФункции

Функция ЗаписиЗаявок(Знач Строки, Знач Адрес)

	Результат = Новый Массив();
	Для Каждого СтрокаВходящих Из Строки Цикл
		Заявка = СтрокаВходящих.Заявка;
		Результат.Добавить(Новый Структура("package, pool, author, filed, actions, manifest",
			ИмяИВерсия(Заявка),
			ПулЗаявки(СтрокаВходящих.Пул),
			ЛюдиЗаявки(СтрокаВходящих),
			МоментПодачи(Заявка),
			МенюЗаявки(Заявка, Адрес),
			СведенияПодЗаявкой(Заявка, МанифестСтроки(СтрокаВходящих))));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПулЗаявки(Знач Пул)
	Возврат Кит.Ссылка(Страницы.Пула(Пул.Имя), Кит.Текст(Строка(Пул.Имя)));
КонецФункции

Функция ИмяИВерсия(Знач Заявка)
	Возврат Кит.Холст(Кит.Код(Строка(Заявка.ИмяПакета)), Кит.Текст(" " + Строка(Заявка.Версия)));
КонецФункции

// Автор манифеста печатается, только когда он отличается от заявителя.
Функция ЛюдиЗаявки(Знач СтрокаВходящих)

	Логин = ЛогинЗаявителя(СтрокаВходящих.Заявитель);
	Возврат Кит.Холст(Кит.Текст(Логин), АвторМанифеста(СтрокаВходящих.Заявка, Логин));

КонецФункции

Функция АвторМанифеста(Знач Заявка, Знач Логин)

	Автор = СокрЛП(Строка(Заявка.АвторМанифеста));
	Если НЕ ЗначениеЗаполнено(Автор) ИЛИ НРег(Автор) = НРег(СокрЛП(Логин)) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Надпись(Кит.Текст(Тексты.Шаблон("settings.inbox.manifest.author", Автор)))
		.Вид("приглушённая");

КонецФункции

Функция МоментПодачи(Знач Заявка)
	Возврат Тексты.Шаблон("settings.inbox.filed.value", Даты.ДатаВремя(Заявка.Создана),
		Тексты.ЧислоТекстом(Цел(Заявка.Идентификатор)));
КонецФункции

// Оба решения — окнами по адресу списка: сотню подтверждений заранее не печатают, и без скрипта
// окно приходит страницей.
Функция МенюЗаявки(Знач Заявка, Знач Адрес)

	Номер = НомерЗаявки(Заявка);
	Возврат Кит.Меню(Тексты.Шаблон("settings.inbox.menu", Строка(Заявка.ИмяПакета), Строка(Заявка.Версия)),
		Кит.ОкноПоАдресу(Окна.Адрес(Адрес, ВидОдобрения(), Номер),
			Тексты.Текст("settings.inbox.button.approve")).Иконка("галочка"),
		Кит.ОкноПоАдресу(Окна.Адрес(Адрес, ВидОтклонения(), Номер),
			Тексты.Текст("settings.inbox.button.reject")).Опасная().Иконка("закрыть"));

КонецФункции

#КонецОбласти

#Область ОкнаРешения

// Окно, названное адресом. Заявки нет среди показанных — страница без окна.
Функция ОкноРешения(Знач Строки, Знач Состояние, Знач Адрес)

	СтрокаВходящих = СтрокаОкна(Состояние, Строки);
	Если СтрокаВходящих = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли Окна.Открыто(Состояние, ВидОдобрения()) Тогда
		Возврат ОкноОдобрения(СтрокаВходящих, Состояние, Адрес);
	КонецЕсли;
	Возврат ОкноОтклонения(СтрокаВходящих, Состояние, Адрес);

КонецФункции

// Одобрение обратного хода не имеет, но не стирает ничего: окно обычного вида, по карточке
// и раскрытым сведениям манифеста принимается решение.
Функция ОкноОдобрения(Знач СтрокаВходящих, Знач Состояние, Знач Адрес)

	Номер = НомерЗаявки(СтрокаВходящих.Заявка);

	Возврат Кит.Окно(Тексты.Шаблон("settings.inbox.approve.title", Номер),
			ОшибкаОкна(Состояние),
			КарточкаЗаявки(СтрокаВходящих),
			МанифестНаПодтверждении(СтрокаВходящих),
			ПоляРешения(ВидОдобрения(), Номер),
			Кит.СкрытоеПоле(Подтверждения.ИмяПоляПодтверждения(), "1"))
		.Лид(Тексты.Текст("settings.inbox.approve.lead"))
		.Форма("").БезПерезагрузки().Якорь("zayavka-odobrit").Открыто().АдресЗакрытия(Адрес)
		.Действия(Кит.Кнопка(Тексты.Текст("settings.inbox.approve.button")).Основная().Иконка("галочка"));

КонецФункции

// Отклонение стирает артефакт: подтверждение опасного вида; причину увидит заявитель,
// отказ — под полем причины либо над полями.
Функция ОкноОтклонения(Знач СтрокаВходящих, Знач Состояние, Знач Адрес)

	Номер = НомерЗаявки(СтрокаВходящих.Заявка);
	Причина = ИмяПоляПричины();

	Возврат Кит.Подтверждение(Тексты.Шаблон("settings.inbox.reject.title", Номер),
			Тексты.Текст("settings.inbox.reject.lead"),
			ОшибкаОкна(Состояние),
			КарточкаЗаявки(СтрокаВходящих),
			Кит.Поле(Причина, Тексты.Текст("settings.inbox.reason.label")).Многострочное()
				.Пример(Тексты.Текст("settings.inbox.reason.placeholder"))
				.Подсказка(Тексты.Текст("settings.inbox.reason.hint"))
				.Значение(Окна.Значение(Состояние, Причина))
				.Ошибка(Окна.Отказ(Состояние, Причина)),
			ПоляРешения(ВидОтклонения(), Номер))
		.Кнопка(Тексты.Текст("settings.inbox.reject.button"))
		.Форма("").БезПерезагрузки().Якорь("zayavka-otklonit").Открыто().АдресЗакрытия(Адрес);

КонецФункции

Функция ПоляРешения(Знач Операция, Знач Номер)
	Возврат Кит.Холст(Кит.СкрытоеПоле(ИмяПоляОперации(), Операция), Кит.СкрытоеПоле(ИмяПоляЗаявки(), Номер));
КонецФункции

// По карточке принимается решение, поэтому здесь sha256 целиком.
Функция КарточкаЗаявки(Знач СтрокаВходящих)

	Заявка = СтрокаВходящих.Заявка;
	Канал = СокрЛП(Строка(Заявка.Канал));
	Автор = СокрЛП(Строка(Заявка.АвторМанифеста));

	Возврат Кит.Свойства(
		Факт(Тексты.Текст("settings.inbox.card.pool"), Строка(СтрокаВходящих.Пул.Имя)),
		Факт(Тексты.Текст("settings.inbox.card.package"), СтрШаблон("%1 %2", Заявка.ИмяПакета, Заявка.Версия)),
		Факт(Тексты.Текст("settings.inbox.card.applicant"), ЛогинЗаявителя(СтрокаВходящих.Заявитель)),
		Факт(Тексты.Текст("settings.inbox.card.manifest-author"), Автор),
		Факт(Тексты.Текст("settings.inbox.card.filed"), Даты.ДатаВремя(Заявка.Создана)),
		Факт(Тексты.Текст("settings.inbox.card.size"),
			Тексты.Шаблон("settings.inbox.size.value", Тексты.ЧислоТекстом(Цел(Заявка.Размер)))),
		Факт(Тексты.Текст("settings.inbox.card.channel"), Канал),
		Факт(Тексты.Текст("settings.inbox.card.file"), Строка(Заявка.ИмяФайла)))
		.Добавить(Кит.Свойство(Тексты.Текст("settings.inbox.card.sha256"), Кит.Код(Строка(Заявка.Sha256))))
		.Родитель();

КонецФункции

Функция Факт(Знач Имя, Знач Значение)
	Возврат Кит.Свойство(Имя, Кит.Текст(?(ЗначениеЗаполнено(Значение), Значение, Прочерк())));
КонецФункции

// На шаге решения сведения из packagedef раскрыты сразу: по ним принимается решение.
Функция МанифестНаПодтверждении(Знач СтрокаВходящих)

	Манифест = МанифестСтроки(СтрокаВходящих);
	Если Манифест = Неопределено Тогда
		Возврат Кит.Примечание(Тексты.Текст("settings.inbox.manifest.missing"));
	КонецЕсли;
	Возврат СвойстваМанифеста(СтрокаВходящих.Заявка, Манифест);

КонецФункции

Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

// Строка заявки, чьё окно открыто: вид — решение, номер — среди показанных строк.
Функция СтрокаОкна(Знач Состояние, Знач Строки)

	Если Состояние = Неопределено
		ИЛИ НЕ (Окна.Открыто(Состояние, ВидОдобрения()) ИЛИ Окна.Открыто(Состояние, ВидОтклонения())) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого СтрокаВходящих Из Строки Цикл
		Если НомерЗаявки(СтрокаВходящих.Заявка) = СокрЛП(Состояние.Ключ) Тогда
			Возврат СтрокаВходящих;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область МанифестЗаявки

// Под строкой заявки: описание одной строкой, сводка и раскрывашка с подробностями;
// заявка без сведений разворота не получает.
Функция СведенияПодЗаявкой(Знач Заявка, Знач Манифест)

	Если Манифест = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// описание пишет автор пакета: узлом, а не строкой — совпав со словом вида, оно уронило бы экран
	Возврат Кит.Холст(
		Кит.Примечание(Кит.Текст(ОписаниеОднойСтрокой(Манифест.Описание))),
		СводкаМанифеста(Манифест),
		ПодробностиМанифеста(Заявка, Манифест));

КонецФункции

// «зависимостей: 3 · github.com/acme/lib»: сколько пакет тянет за собой и где его исходники.
Функция СводкаМанифеста(Знач Манифест)

	Результат = Кит.Примечание(Тексты.Шаблон("settings.inbox.manifest.deps",
		Тексты.ЧислоТекстом(ЗависимостиВида(Манифест.Зависимости, Ложь).Количество())));

	Если ЗначениеЗаполнено(Манифест.АдресРепозитория) Тогда
		Результат.Добавить(Кит.Текст(" · "));
		Результат.Добавить(Репозиторий(Манифест.АдресРепозитория));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Разворот называет заявку в доступном имени: двадцать «Подробнее» подряд звучат одинаково.
Функция ПодробностиМанифеста(Знач Заявка, Знач Манифест)

	Возврат Кит.Раскрывашка(СвойстваМанифеста(Заявка, Манифест)).Вид("подробность")
		.Подпись(Тексты.Шаблон("settings.inbox.manifest.details.about",
			Строка(Заявка.ИмяПакета), Строка(Заявка.Версия)))
		.Шапка(Кит.Текст(Тексты.Текст("settings.inbox.manifest.details")));

КонецФункции

// Всё, что пакет сказал о себе в packagedef; незаполненное печатается прочерком.
Функция СвойстваМанифеста(Знач Заявка, Знач Манифест)

	Возврат Кит.Свойства(
		Факт(Тексты.Текст("settings.inbox.manifest.field.description"), Манифест.Описание),
		СвойствоРепозитория(Манифест.АдресРепозитория),
		Факт(Тексты.Текст("settings.inbox.manifest.field.author"),
			АвторСПочтой(Заявка.АвторМанифеста, Манифест.АдресАвтора)),
		Факт(Тексты.Текст("settings.inbox.manifest.field.engine"), Манифест.ВерсияДвижка),
		Факт(Тексты.Текст("settings.inbox.manifest.field.deps"),
			ЗависимостиСтрокой(ЗависимостиВида(Манифест.Зависимости, Ложь))),
		Факт(Тексты.Текст("settings.inbox.manifest.field.dev-deps"),
			ЗависимостиСтрокой(ЗависимостиВида(Манифест.Зависимости, Истина))));

КонецФункции

Функция СвойствоРепозитория(Знач Адрес)

	Возврат Кит.Свойство(Тексты.Текст("settings.inbox.manifest.field.repository"),
		?(ЗначениеЗаполнено(Адрес), Репозиторий(Адрес), Кит.Текст(Прочерк())));

КонецФункции

// Веб-адрес отобрал домен; видимый текст ссылки — без схемы, как на карточке пакета.
Функция Репозиторий(Знач Адрес)
	Возврат Кит.Ссылка(Адрес, Кит.Текст(Адреса.БезСхемы(Адрес)));
КонецФункции

Функция АвторСПочтой(Знач Автор, Знач Почта)

	Имя = СокрЛП(Строка(Автор));
	Адрес = СокрЛП(Строка(Почта));
	Если ЗначениеЗаполнено(Имя) И ЗначениеЗаполнено(Адрес) Тогда
		Возврат СтрШаблон("%1 <%2>", Имя, Адрес);
	КонецЕсли;
	Возврат ?(ЗначениеЗаполнено(Имя), Имя, Адрес);

КонецФункции

// Описание в таблице — одной строкой: переносы из packagedef ломали бы высоту строки.
Функция ОписаниеОднойСтрокой(Знач Описание)

	Текст = СтрЗаменить(СтрЗаменить(СокрЛП(Строка(Описание)), Символы.ВК, " "), Символы.ПС, " ");
	Возврат Обрезка.СМноготочием(Текст, ЗнаковОписанияВТаблице());

КонецФункции

Функция ЗнаковОписанияВТаблице()
	Возврат 80;
КонецФункции

Функция ЗависимостиВида(Знач Зависимости, Знач ДляРазработки)

	Результат = Новый Массив();
	Для Каждого Зависимость Из Зависимости Цикл
		Если (Зависимость.ДляРазработки = Истина) = ДляРазработки Тогда
			Результат.Добавить(Зависимость);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// «logos 1.7.1, fs 1.0.0–2.0.0»: имя и требуемые версии, как их написал packagedef.
Функция ЗависимостиСтрокой(Знач Зависимости)

	Части = Новый Массив();
	Для Каждого Зависимость Из Зависимости Цикл
		Требование = СокрЛП(Зависимость.ВерсияМин);
		Если ЗначениеЗаполнено(Зависимость.ВерсияМакс) Тогда
			Требование = Требование + "–" + СокрЛП(Зависимость.ВерсияМакс);
		КонецЕсли;
		Части.Добавить(СокрЛП(Зависимость.Имя + " " + Требование));
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

Функция МанифестСтроки(Знач СтрокаВходящих)

	Манифест = Неопределено;
	СтрокаВходящих.Свойство("Манифест", Манифест);
	Возврат Манифест;

КонецФункции

Функция Прочерк()
	Возврат "—";
КонецФункции

#КонецОбласти

#Область СекцияКабинета

Функция Свежайшие(Знач Строки, Знач Предел)

	Результат = Новый Массив();
	Для Каждого СтрокаВходящих Из Строки Цикл
		Если Результат.Количество() >= Предел Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(СтрокаВходящих);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ТаблицаСвежих(Знач Свежие)

	Записи = Новый Массив();
	Для Каждого СтрокаВходящих Из Свежие Цикл
		Записи.Добавить(Новый Структура("package, pool, author",
			ИмяИВерсия(СтрокаВходящих.Заявка),
			Строка(СтрокаВходящих.Пул.Имя),
			ЛогинЗаявителя(СтрокаВходящих.Заявитель)));
	КонецЦикла;

	Таблица = Кит.Таблица(Записи).Вид("карточками");
	Таблица.Колонка("package", Тексты.Текст("settings.inbox.col.package")).Заглавная();
	Таблица.Колонка("pool", Тексты.Текст("settings.inbox.col.pool"));
	Таблица.Колонка("author", Тексты.Текст("settings.inbox.col.author"));
	Возврат Таблица;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НомерЗаявки(Знач Заявка)
	Возврат Формат(Цел(Заявка.Идентификатор), "ЧГ=0; ЧН=0");
КонецФункции

Функция ЛогинЗаявителя(Знач Заявитель)
	Если Заявитель = Неопределено Тогда
		Возврат Тексты.Текст("settings.inbox.applicant.gone");
	КонецЕсли;
	Возврат Строка(Заявитель.Логин);
КонецФункции

#КонецОбласти

&Прозвище("ВитринаЗаявокПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "Подтверждение") _Подтверждения,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено,
	&Пластилин(Значение = "ОбрезаниеТекста") _Обрезка = Неопределено,
	&Пластилин(Значение = "РазборАдреса") _Адреса = Неопределено) Экспорт

	Кит = _Кит;
	Окна = _Окна;
	Подтверждения = _Подтверждения;
	Страницы = _Страницы;
	Тексты = _Тексты;
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);
	Обрезка = ?(_Обрезка = Неопределено, Новый ОбрезаниеТекста(), _Обрезка);
	Адреса = ?(_Адреса = Неопределено, Новый РазборАдреса(), _Адреса);

КонецПроцедуры
