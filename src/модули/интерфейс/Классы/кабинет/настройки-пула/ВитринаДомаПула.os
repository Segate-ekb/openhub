// Секции разделов дома «Пул»: видимость, квота, опасная зона; общие сведения, права и заявки
// собирают свои витрины; апстримы, зеркала и теги — свои контроллеры.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем Дом;               // ДомПула — адреса разделов
Перем СервисПулов;       // СервисПулов (реестр) — занятое, действующая квота, запрет удаления
Перем ГвардКвоты;        // ГвардКвотыПула (права) — квоту назначает админ хаба
Перем Заполнение;        // ЗаполнениеПула (реестр) — процент занятого
Перем Объёмы;            // ОбъёмТекстом (основа) — байты человеку
Перем ВитринаПрав;       // ВитринаПравПула — раздел «Права доступа»
Перем ПультПрав;         // ПультПравПула — вправе ли смотрящий выдавать роли
Перем ВитринаЗаявок;     // ВитринаЗаявокПула — раздел «Входящие»
Перем ПультУдаления;     // ПультУдаленияПула — право удалять и поля опасной зоны
Перем Рассмотрение;      // РассмотрениеВходящих (публикация) — видимые заявки пула
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем ВитринаОбщих;      // ВитринаОбщихПула — раздел «Общие»
Перем Окна;              // ОкноРаздела — окно раздела по адресу и его состояние

#Область ПубличныйИнтерфейс

// Секции раздела дома «Пул».
//
// Параметры:
//  Параметры - Структура:
//    * Ключ - Строка - ключ раздела;
//    * Пул - Пул - пул раздела;
//    * Токен - Строка - CSRF-токен сессии;
//    * Пользователь - Пользователь, Неопределено - смотрящий;
//    * Принципал - Структура, Неопределено - принципал запроса;
//    * Окно - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое): открытое
//      адресом либо отбитая форма окна;
//    * Заголовки - Соответствие, Неопределено - заголовки запроса: узел хаба в адресе для opm.
//
// Возвращаемое значение:
//  Массив - секции: узлы Кит.Секция.
//
Функция Секции(Знач Параметры) Экспорт

	Ключ = Параметры.Ключ;
	Пул = Параметры.Пул;

	Результат = Новый Массив();

	Если Ключ = "general" Тогда
		Результат.Добавить(ВитринаОбщих.Секция(Параметры.Пул, Параметры.Пользователь, Параметры.Заголовки));
	ИначеЕсли Ключ = "visibility" Тогда
		Результат.Добавить(СекцияВидимости(Пул));
	ИначеЕсли Ключ = "access" Тогда
		Добавить(Результат, СекцииПрав(Параметры));
	ИначеЕсли Ключ = "inbox" Тогда
		Добавить(Результат, СекцииЗаявок(Параметры));
	ИначеЕсли Ключ = "quota" Тогда
		Результат.Добавить(СекцияКвоты(Пул, Параметры.Пользователь));
	ИначеЕсли Ключ = "danger" Тогда
		Результат.Добавить(СекцияОпасной(Пул, Параметры.Пользователь, Параметры.Окно));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<ключ>: каждый раздел знает свои.
//
// Параметры:
//  Ключ - Строка - ключ раздела дома.
//
// Возвращаемое значение:
//  Строка - виды через запятую; "" — у раздела окон по адресу нет.
//
Функция ВидыОкон(Знач Ключ) Экспорт
	Если Ключ = "danger" Тогда
		Возврат "удалить";
	ИначеЕсли Ключ = "access" Тогда
		Возврат ВитринаПрав.ВидыОкон();
	ИначеЕсли Ключ = "inbox" Тогда
		Возврат ВитринаЗаявок.ВидыОкон();
	КонецЕсли;
	Возврат "";
КонецФункции

// Напечатает ли раздел окно, которое называет состояние отбитой формы: окна нет (заявку уже
// решили) — отказ встаёт над разделом.
//
// Параметры:
//  Ключ - Строка - ключ раздела дома.
//  Пул - Пул - пул раздела.
//  Принципал - Структура, Неопределено - принципал запроса: заявки, которые он видит.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Ключ, Знач Пул, Знач Принципал, Знач Состояние) Экспорт
	Если Состояние = Неопределено Тогда
		Возврат Ложь;
	ИначеЕсли Ключ = "inbox" Тогда
		Возврат ВитринаЗаявок.ЕстьОкно(Состояние, Рассмотрение.СтрокиПула(Принципал, Пул));
	КонецЕсли;
	// окно выдачи роли и подтверждение удаления печатаются всегда, когда форма до них дошла
	Возврат Истина;
КонецФункции

#КонецОбласти

#Область РазделыДругихВитрин

Функция СекцииПрав(Знач Параметры)

	Пул = Параметры.Пул;

	Возврат ВитринаПрав.Секции(Новый Структура("Пул, Адрес, МожетВыдавать, Окно",
		Пул, Дом.АдресРаздела(Пул.Имя, "access"),
		ПультПрав.МожетВыдавать(Параметры.Пользователь, Пул), Параметры.Окно));

КонецФункции

// Заявки спрашиваются у домена, а не у хранилища очереди: порог и рамки ключа держит он.
// Решение — окнами по адресу раздела: открытым адресом либо отбитой формой окна.
Функция СекцииЗаявок(Знач Параметры)

	Пул = Параметры.Пул;

	Возврат ВитринаЗаявок.Секции(Новый Структура("Строки, Адрес, СПулом, Окно",
		Рассмотрение.СтрокиПула(Параметры.Принципал, Пул),
		Дом.АдресРаздела(Пул.Имя, "inbox"), Ложь, Параметры.Окно));

КонецФункции

#КонецОбласти

#Область Видимость

// Видимость — сегментами одной формы раздела; что значит каждая — строкой под ними.
Функция СекцияВидимости(Знач Пул)

	Подпись = Тексты.Текст("settings.pool.visibility.label");

	Возврат Кит.Секция(Тексты.Текст("settings.pool.visibility.title"),
			Кит.Группа(Подпись,
				Кит.Сегменты(ИмяПоляВидимости(),
					Кит.Сегмент("public", Тексты.Текст("settings.pool.visibility.option.public")),
					Кит.Сегмент("private", Тексты.Текст("settings.pool.visibility.option.private")))
				.Подпись(Подпись).Выбрано(НРег(СокрЛП(Строка(Пул.Видимость)))))
			.Вид("простая"),
			Кит.Примечание(Тексты.Текст("settings.pool.visibility.hint")))
		.Лид(Тексты.Текст("settings.pool.visibility.lead")).Иконка("замок").Форма();

КонецФункции

#КонецОбласти

#Область Квота

// Квота: полоса занятого, откуда действующая квота — строкой; число меняет только администратор
// хаба — у остальных секция без формы, квота свойством.
Функция СекцияКвоты(Знач Пул, Знач Пользователь)

	Если НЕ ГвардКвоты.МожетМенятьКвоту(Пользователь) Тогда
		Возврат ЗаготовкаКвоты(Пул,
			Кит.Свойства(
				Кит.Свойство(Тексты.Текст("settings.pool.quota.property"), ОткудаКвота(Пул))
					.Примечание(Тексты.Текст("settings.pool.quota.readonly"))));
	КонецЕсли;

	Возврат ЗаготовкаКвоты(Пул,
			Кит.Примечание(ОткудаКвота(Пул)),
			Кит.Поле(ИмяПоляКвоты(), Тексты.Текст("settings.pool.quota.label")).ТипЗначения(Тип("Число"))
				.Значение(Тексты.ЧислоТекстом(Пул.КвотаМб))
				.Подсказка(Тексты.Текст("settings.pool.quota.hint.short"))
				.Справка(Тексты.Текст("settings.pool.quota.hint")))
		.Форма();

КонецФункции

Функция ЗаготовкаКвоты(Знач Пул, Знач Значение, Знач Пояснение = Неопределено)

	Возврат Кит.Секция(Тексты.Текст("settings.pool.quota.title"), ШкалаЗанятого(Пул), Значение, Пояснение)
		.Лид(Тексты.Текст("settings.pool.quota.lead")).Иконка("скачать");

КонецФункции

// У пула без ограничения процента не существует, поэтому печатается одно занятое.
Функция ШкалаЗанятого(Знач Пул)

	Занято = СервисПулов.ЗанятоБайт(Пул);
	КвотаБайт = СервисПулов.ЭффективнаяКвотаБайт(Пул);

	Если КвотаБайт <= 0 Тогда
		Возврат Кит.Примечание(Тексты.Шаблон("settings.pool.quota.meter.unlimited",
			Объёмы.Представление(Занято)));
	КонецЕсли;

	Возврат Кит.ПолосаЗаполнения(Заполнение.Процент(Занято, КвотаБайт),
			Тексты.Текст("settings.pool.quota.meter.label"))
		.Подпись(Тексты.Шаблон("settings.pool.quota.meter.value",
			Объёмы.Представление(Занято), Объёмы.Представление(КвотаБайт)));

КонецФункции

// Откуда взялась действующая квота: своя, унаследованная у хаба или её нет вовсе.
Функция ОткудаКвота(Знач Пул)

	Действующая = СервисПулов.ЭффективнаяКвотаМб(Пул);
	КвотаТекстом = Тексты.ЧислоТекстом(Действующая);

	Если Действующая <= 0 Тогда
		Возврат Тексты.Текст("settings.pool.quota.none");
	ИначеЕсли Цел(Число(Пул.КвотаМб)) = СервисПулов.КвотаКакВХабе() Тогда
		Возврат Тексты.Шаблон("settings.pool.quota.inherited", КвотаТекстом);
	КонецЕсли;
	Возврат Тексты.Шаблон("settings.pool.quota.own", КвотаТекстом);

КонецФункции

#КонецОбласти

#Область ОпаснаяЗона

// Удаляет пул администратор хаба, и только пул, который домен не держит: остальным вместо кнопки —
// причина строкой. Подтверждение с эхом имени приходит по адресу ?окно=удалить.
Функция СекцияОпасной(Знач Пул, Знач Пользователь, Знач Состояние)

	Причина = ПричинаБезУдаления(Пул, Пользователь);
	Если ЗначениеЗаполнено(Причина) Тогда
		Возврат ЗаготовкаОпасной(Пул, Кит.Примечание(Причина), Кит.Примечание(ГдеОтзыватьВерсии()));
	КонецЕсли;

	Адрес = Дом.АдресРаздела(Пул.Имя, "danger");
	Возврат ЗаготовкаОпасной(Пул,
			Кит.Примечание(Тексты.Текст("settings.pool.danger.note.softer")),
			Кит.Примечание(ГдеОтзыватьВерсии()),
			ПодтверждениеУдаления(Пул, Состояние, Адрес))
		.Действия(Кит.ОкноПоАдресу(Окна.Адрес(Адрес, "удалить"), Тексты.Текст("settings.pool.danger.button"))
			.Опасная().Иконка("корзина"));

КонецФункции

// Домен держит пул (основной пул хаба, идущий прогон зеркала) или право уровня хаба не у смотрящего.
Функция ПричинаБезУдаления(Знач Пул, Знач Пользователь)

	Причина = СервисПулов.ПричинаЗапретаУдаления(Пул);
	Если ЗначениеЗаполнено(Причина) Тогда
		Возврат Причина;
	КонецЕсли;
	Если НЕ ПультУдаления.МожетУдалять(Пользователь) Тогда
		Возврат Тексты.Текст("settings.pool.danger.readonly");
	КонецЕсли;
	Возврат "";

КонецФункции

// Подтверждение печатается только открытым адресом: последствия, что станет с именем, эхо имени.
// Удача уводит со страницы удалённого пула, поэтому форма уходит обычной отправкой.
Функция ПодтверждениеУдаления(Знач Пул, Знач Состояние, Знач АдресРаздела)

	Если НЕ Окна.Открыто(Состояние, "удалить") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Имя = Строка(Пул.Имя);
	Возврат Кит.Подтверждение(Тексты.Шаблон("settings.pool.danger.delete.title", Имя),
			Тексты.Текст("settings.pool.danger.note"),
			Кит.Примечание(Тексты.Шаблон("settings.pool.danger.note.free", Имя)),
			ОшибкаОкна(Состояние),
			Кит.СкрытоеПоле(ПультУдаления.ИмяПоляОперации(), ПультУдаления.ЗначениеОперации()))
		.Эхо(ПультУдаления.ИмяПоляЭха(), Имя, Тексты.Текст("settings.pool.danger.echo.label"),
			Тексты.Шаблон("settings.pool.danger.echo.hint", Имя))
		.Кнопка(Тексты.Текст("settings.pool.danger.button"))
		.Ошибка(Окна.Отказ(Состояние, ПультУдаления.ИмяПоляЭха()))
		.Форма("").Якорь("pul-udalit").Открыто().АдресЗакрытия(АдресРаздела);

КонецФункции

Функция ЗаготовкаОпасной(Знач Пул, Знач Первое, Знач Второе, Знач Третье = Неопределено)

	Возврат Кит.Секция(Тексты.Текст("settings.pool.danger.title"), Первое, Второе, Третье)
		.Лид(Тексты.Шаблон("settings.pool.danger.lead", Пул.Имя)).Иконка("предупреждение").Опасная();

КонецФункции

// Подсказка про отзыв версий нужнее всех тому, у кого палец над кнопкой удаления.
Функция ГдеОтзыватьВерсии()
	Возврат Тексты.Текст("settings.pool.danger.note.yank");
КонецФункции

// Отказ домена, который не относится к эхо-полю, — над полем.
Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяПоляВидимости()
	Возврат "видимость";
КонецФункции

Функция ИмяПоляКвоты()
	Возврат "квота_мб";
КонецФункции

Процедура Добавить(Результат, Знач Секции)
	Для Каждого Секция Из Секции Цикл
		Результат.Добавить(Секция);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

&Прозвище("ВитринаДомаПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ДомПула") _Дом,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ГвардКвотыПула") _ГвардКвоты,
	&Пластилин(Значение = "ЗаполнениеПула") _Заполнение,
	&Пластилин(Значение = "ОбъёмТекстом") _Объёмы,
	&Пластилин(Значение = "ВитринаПравПула") _ВитринаПрав,
	&Пластилин(Значение = "ПультПравПула") _ПультПрав,
	&Пластилин(Значение = "ВитринаЗаявокПула") _ВитринаЗаявок,
	&Пластилин(Значение = "ПультУдаленияПула") _ПультУдаления,
	&Пластилин(Значение = "РассмотрениеВходящих") _Рассмотрение,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ВитринаОбщихПула") _ВитринаОбщих,
	&Пластилин(Значение = "ОкноРаздела") _Окна) Экспорт

	Кит = _Кит;
	Дом = _Дом;
	СервисПулов = _СервисПулов;
	ГвардКвоты = _ГвардКвоты;
	Заполнение = _Заполнение;
	Объёмы = _Объёмы;
	ВитринаПрав = _ВитринаПрав;
	ПультПрав = _ПультПрав;
	ВитринаЗаявок = _ВитринаЗаявок;
	ПультУдаления = _ПультУдаления;
	Рассмотрение = _Рассмотрение;
	Тексты = _Тексты;
	ВитринаОбщих = _ВитринаОбщих;
	Окна = _Окна;

КонецПроцедуры
