// Экран состояния зеркала «pools/{pool}/settings/mirrors/{id}» дома «Пул».

Перем ГвардПула;
Перем Защита;       // ЗащитаCSRF (вход) — токен формы запуска синхронизации
Перем СервисЗеркал; // СервисЗеркал (зеркала) — зеркало пула по идентификатору
Перем Прогоны;      // ПредставлениеПрогонаЗеркала — прогон в виде для экрана
Перем Происшествия; // ПредставлениеПроисшествийЗеркала — почему версии не приехали
Перем Витрина;      // ВитринаСостоянияЗеркала
Перем Ответы;       // ОтветыНастроек
Перем Дом;          // ДомПула
Перем Тексты;       // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Числа;        // ПриведениеЧисел (основа) — терпимое чтение числа
Перем Страницы; // АдресаСтраниц (реестр) — страница пула в хлебных крошках

#Область ПубличныйИнтерфейс

// Отдаёт экран состояния зеркала.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор зеркала из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  Синк - Строка - итог нажатия «синхронизировать сейчас»: "1" заявка принята,
//         "running" прогон уже идёт, "queued" зеркало уже ждёт очереди
//         (необязательный, по умолчанию "").
//
Процедура Показать(Ответ, Знач pool, Знач id, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач МетодЗапроса, Знач Синк = "") Экспорт

	Вердикт = ГвардПула.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Зеркало = СервисЗеркал.ЗеркалоПула(Вердикт.Пул, Числа.ЧислоИлиНоль(id));
	Если Зеркало = Неопределено Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт.Пользователь,
			Тексты.Текст("settings.pool.mirror-status.notfound"), КукиЗапроса);
		Возврат;
	КонецЕсли;

	Отдать(Ответ, Вердикт, Зеркало, КукиЗапроса, Синк);

КонецПроцедуры

#КонецОбласти

#Область Рендер

// Интервал авто-обновления экрана, секунд.
Функция ИнтервалОбновления()
	Возврат 5;
КонецФункции

Процедура Отдать(Ответ, Знач Вердикт, Знач Зеркало, Знач КукиЗапроса, Знач Синк)

	Пул = Вердикт.Пул;
	АдресСписка = Дом.АдресРаздела(Пул.Имя, "mirrors");
	АдресЭкрана = АдресСписка + "/" + Формат(Зеркало.Идентификатор, "ЧГ=0; ЧН=0");
	Прогон = Прогоны.Модель(Зеркало, СервисЗеркал.ПрогонБрошен(Зеркало));

	// незакрытый прогон перерисовывается заголовком Refresh и без JS; адрес обязателен,
	// иначе браузер перезагружал бы URL вместе с ?sync и повторял разовый баннер
	Если Прогон.Активен Тогда
		Ответ.Заголовки["Refresh"] = Формат(ИнтервалОбновления(), "ЧГ=0; ЧН=0")
			+ "; url=" + АдресЭкрана;
	КонецЕсли;

	Параметры = Новый Структура();
	Параметры.Вставить("Зеркало", Зеркало);
	Параметры.Вставить("Протокол", СервисЗеркал.Протокол(Зеркало));
	Параметры.Вставить("Прогон", Прогон);
	Параметры.Вставить("Происшествия", Происшествия.Модель(Зеркало));
	Параметры.Вставить("АдресЭкрана", АдресЭкрана);
	Параметры.Вставить("АдресСписка", АдресСписка);
	Параметры.Вставить("Токен", Защита.ТокенСессии(Вердикт.Сессия));
	Параметры.Вставить("Обновление", ИнтервалОбновления());

	Ответы.ОтдатьДом(Ответ, Модель(Пул, АдресСписка, Параметры, УведомленияСинка(Синк)),
		Вердикт.Пользователь, КукиЗапроса, Тексты.Текст("settings.pool.mirror-status.title"));

КонецПроцедуры

// Что стало с нажатой кнопкой «синхронизировать сейчас»: принята, отказ, идёт или ждёт.
Функция УведомленияСинка(Знач Синк)

	Результат = Новый Массив();
	Если Синк = "1" Тогда
		Результат.Добавить(Ответы.Уведомление(Тексты.Текст("settings.pool.mirrors.sync.queued"), "ok"));
	ИначеЕсли Синк = "running" Тогда
		Результат.Добавить(Ответы.Уведомление(Тексты.Текст("settings.pool.mirrors.sync.running"), "warn"));
	ИначеЕсли Синк = "queued" Тогда
		Результат.Добавить(Ответы.Уведомление(Тексты.Текст("settings.pool.mirrors.sync.waiting"), "warn"));
	ИначеЕсли Синк = "rejected" Тогда
		Результат.Добавить(Ответы.Уведомление(Тексты.Текст("settings.pool.mirrors.sync.rejected"), "err"));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция Модель(Знач Пул, Знач АдресСписка, Знач Параметры, Знач Уведомления)

	Хлебные = Новый Массив();
	Хлебные.Добавить(Новый Структура("Подпись, Адрес", Пул.Имя, Страницы.Пула(Пул.Имя)));
	Хлебные.Добавить(Новый Структура("Подпись, Адрес",
		Тексты.Текст("settings.pool.nav.mirrors"), АдресСписка));
	Хлебные.Добавить(Новый Структура("Подпись",
		Тексты.Текст("settings.pool.mirror-status.crumb")));

	Результат = Новый Структура();
	Результат.Вставить("Ключ", Дом.Ключ());
	Результат.Вставить("Заголовок", Тексты.Текст("settings.pool.mirror-status.title"));
	Результат.Вставить("Объект", Пул.Имя);
	Результат.Вставить("Пояснение", Тексты.Текст("settings.pool.mirror-status.lead"));
	Результат.Вставить("Разделы", Дом.Разделы(Пул.Имя, "mirrors"));
	Результат.Вставить("Уведомления", Уведомления);
	Результат.Вставить("Хлебные", Хлебные);
	Результат.Вставить("Секции", Витрина.Секции(Параметры));
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ПультСостоянияЗеркала")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардПула") _ГвардПула,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Пластилин(Значение = "ПредставлениеПрогонаЗеркала") _Прогоны,
	&Пластилин(Значение = "ПредставлениеПроисшествийЗеркала") _Происшествия,
	&Пластилин(Значение = "ВитринаСостоянияЗеркала") _Витрина,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомПула") _Дом,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы) Экспорт

	ГвардПула = _ГвардПула;
	Защита = _Защита;
	СервисЗеркал = _СервисЗеркал;
	Прогоны = _Прогоны;
	Происшествия = _Происшествия;
	Витрина = _Витрина;
	Ответы = _Ответы;
	Дом = _Дом;
	Тексты = _Тексты;
	Числа = _Числа;
	Страницы = _Страницы;

КонецПроцедуры
