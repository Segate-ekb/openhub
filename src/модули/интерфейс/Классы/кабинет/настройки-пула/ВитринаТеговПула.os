// Раздел «Теги» дома «Пул»: тумблер «теги пула для пакетов», а при включённом — реестр тегов
// пула с меню ⚙; окно нового тега на странице, окна правки и подтверждение удаления — по адресу.

Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем ТегиПула;      // СервисТеговПула (реестр) — набор пула и его галка
Перем Конструкторы;  // КонструкторТега — состояние окна по тегу пула
Перем Окна;          // ОкноРаздела — окно по адресу и его состояние
Перем ОкноТега;      // ОкноТега — окна «Новый тег» и «Изменить»
Перем Поля;          // ПоляТега — имена полей
Перем Плашки;        // ПлашкаТега — плашка тега в его оформлении
Перем Тексты;        // ТекстыИнтерфейса (кит)
Перем Ссылки;        // ПараметрыСсылки (основа) — адрес проверки имени до отправки

#Область ПубличныйИнтерфейс

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<тег>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат "новый,изменить,удалить";
КонецФункции

// Секции раздела «Теги» дома «Пул».
//
// Параметры:
//  Параметры - Структура:
//    * Пул - Пул - пул раздела;
//    * Адрес - Строка - адрес раздела;
//    * Окно - Структура, Неопределено - состояние открытого окна (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - тумблер наследования и, при включённом, набор тегов пула.
//
Функция Секции(Знач Параметры) Экспорт

	Пул = Параметры.Пул;
	Включено = ТегиПула.НаследованиеВключено(Пул);

	Результат = Новый Массив();
	Результат.Добавить(СекцияГалки(Включено));
	Если Включено Тогда
		Результат.Добавить(СекцияНабора(Пул, Параметры.Адрес, Параметры.Окно));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Напечатает ли раздел окно, которое называет состояние: при выключенной галке — никакого;
// окно заведения — всегда; окно тега — когда тег пула есть.
//
// Параметры:
//  Пул - Пул - пул раздела.
//  Состояние - Структура, Неопределено - состояние окна раздела.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Пул, Знач Состояние) Экспорт

	Если Состояние = Неопределено ИЛИ НЕ ТегиПула.НаследованиеВключено(Пул) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Окна.Открыто(Состояние, "новый") Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ТегОкна(Пул, Состояние) <> Неопределено;

КонецФункции

#КонецОбласти

#Область Галка

// Тумблер сохраняется сразу; без скрипта его форму отправляет запасная кнопка кита рядом с ним.
Функция СекцияГалки(Знач Включено)

	Возврат Кит.Секция(Тексты.Текст("settings.pool.tags.title"),
			Кит.Форма("",
				Кит.СкрытоеПоле(Поля.ИмяПоляОперации(), Поля.ОперацияГалки()),
				Кит.Тумблер(Поля.ОперацияГалки(), Тексты.Текст("settings.pool.tags.inherit.label"))
					.Включено(Включено)
					.Значения(Поля.ЗначениеОтмечено(), Поля.ЗначениеСнято())
					.Подписи(Тексты.Текст("settings.pool.tags.inherit.on"),
						Тексты.Текст("settings.pool.tags.inherit.off"))
					.Подсказка(Тексты.Текст("settings.pool.tags.inherit.hint"))
					.СохранятьСразу())
				.БезПерезагрузки())
		.Лид(Тексты.Текст("settings.pool.tags.lead")).Иконка("тег");

КонецФункции

#КонецОбласти

#Область Набор

Функция СекцияНабора(Знач Пул, Знач АдресРаздела, Знач Состояние)

	ТегиНабора = ТегиПула.ТегиПула(Пул.Идентификатор);
	ОкноНового = ОкноЗаведения(АдресРаздела, Состояние);

	Возврат Кит.Секция(Тексты.Текст("settings.pool.tags.set.title"),
			Реестр(ТегиНабора, АдресРаздела),
			ОкноНового,
			ОткрытоеОкно(Пул, АдресРаздела, Состояние))
		.Лид(Тексты.Текст("settings.pool.tags.set.lead")).Иконка("тег")
		.Действия(Кит.Кнопка(Тексты.Текст("settings.tags.button.new")).Основная().Иконка("плюс")
			.Открывает(ОкноНового));

КонецФункции

Функция Реестр(Знач ТегиНабора, Знач АдресРаздела)

	Список = Кит.Реестр().Подпись(Тексты.Текст("settings.pool.tags.set.title"))
		.Пусто(Тексты.Текст("settings.pool.tags.set.empty"));
	Для Каждого ТегПула Из ТегиНабора Цикл
		Список.Добавить(Запись(ТегПула, АдресРаздела));
	КонецЦикла;
	Возврат Список;

КонецФункции

// Свёрнутая запись — плашка тега в его оформлении и правило словами; раскрытая — подробности.
Функция Запись(Знач ТегПула, Знач АдресРаздела)

	Правило = ТегиПула.ПравилоТегаПула(ТегПула);

	ЗаписьТега = Кит.ЗаписьРеестра(ТегПула.Имя, Подробности(ТегПула, Правило))
		.Значок("тег")
		.Плашка(Плашки.ПоТегу(ТегПула))
		.Подпись(ПравилоСловами(Правило));
	Если ТегПула.ПоУмолчанию = Истина Тогда
		ЗаписьТега.Плашка(Кит.Плашка(Тексты.Текст("settings.tags.badge.default")).Вид("accent"));
	КонецЕсли;
	Если ТегиПула.ЗапретСнят(ТегПула) Тогда
		ЗаписьТега.Плашка(Кит.Плашка(Тексты.Текст("settings.tags.badge.repush")).Вид("warn"));
	КонецЕсли;

	Возврат ЗаписьТега.Кнопки(
			Кит.ОкноПоАдресу(Окна.Адрес(АдресРаздела, "изменить", ТегПула.Имя),
				Тексты.Текст("settings.tags.button.edit")).Основная().Иконка("карандаш"),
			Кит.ОкноПоАдресу(Окна.Адрес(АдресРаздела, "удалить", ТегПула.Имя),
				Тексты.Текст("settings.tags.button.remove")).Опасная().Иконка("корзина"));

КонецФункции

Функция Подробности(Знач ТегПула, Знач Правило)

	Возврат Кит.Свойства(
		СвойствоПравила(Правило),
		Кит.Свойство(Тексты.Текст("settings.tags.prop.repush"),
			?(ТегиПула.ЗапретСнят(ТегПула), Тексты.Текст("settings.tags.repush.allowed"),
				Тексты.Текст("settings.tags.repush.forbidden"))));

КонецФункции

// Правило, ничем не ограниченное с краёв, несёт предупреждение домена.
Функция СвойствоПравила(Знач Правило)

	Подпись = Тексты.Текст("settings.tags.prop.rule");
	Если Правило = Неопределено Тогда
		Возврат Кит.Свойство(Подпись, Тексты.Текст("settings.tags.rule.broken"));
	КонецЕсли;
	Свойство = Кит.Свойство(Подпись, Кит.Код(Правило.Выражение));
	Если ЗначениеЗаполнено(Правило.Предупреждение()) Тогда
		Свойство.Примечание(Правило.Предупреждение());
	КонецЕсли;
	Возврат Свойство;

КонецФункции

// «semver · ^1.0» — вид правила и выражение одной строкой.
Функция ПравилоСловами(Знач Правило)

	Если Правило = Неопределено Тогда
		Возврат Тексты.Текст("settings.tags.rule.broken");
	КонецЕсли;
	Возврат Тексты.Шаблон("settings.tags.rule.words", Правило.Тип, Правило.Выражение);

КонецФункции

#КонецОбласти

#Область Окна

Функция ОкноЗаведения(Знач АдресРаздела, Знач Состояние)

	Опции = ОпцииОкна(АдресРаздела);
	Опции.Заголовок = Тексты.Текст("settings.pool.tags.new.title");
	Опции.Лид = Тексты.Текст("settings.pool.tags.new.lead");
	Опции.Кнопка = Тексты.Текст("settings.tags.button.create");
	Опции.Якорь = "teg-pula-novyi";
	Опции.АдресОкна = Окна.Адрес(АдресРаздела, "новый");
	Возврат ОкноТега.Заведение(Конструкторы.ДляТегаПула(Неопределено), Состояние, Опции);

КонецФункции

// Окно тега, названное адресом. Тега с таким именем нет — страница без окна.
Функция ОткрытоеОкно(Знач Пул, Знач АдресРаздела, Знач Состояние)

	ТегПула = ТегОкна(Пул, Состояние);
	Если ТегПула = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Окна.Открыто(Состояние, "изменить") Тогда
		Опции = ОпцииОкна(АдресРаздела);
		Опции.Заголовок = Тексты.Шаблон("settings.pool.tags.edit.title", ТегПула.Имя);
		Опции.Лид = Тексты.Текст("settings.pool.tags.edit.lead");
		Опции.Кнопка = Тексты.Текст("settings.tags.button.save");
		Опции.Якорь = "teg-pula-pravka";
		Опции.Хвост = Хвост(ТегПула.Имя, "save");
		Возврат ОкноТега.Правка(Конструкторы.ДляТегаПула(ТегПула), Состояние, Опции);
	ИначеЕсли Окна.Открыто(Состояние, "удалить") Тогда
		Возврат ОкноУдаления(ТегПула, Состояние, АдресРаздела);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ОпцииОкна(Знач АдресРаздела)

	Опции = ОкноТега.ОпцииОкна();
	Опции.АдресПроверки = Ссылки.Установить(АдресРаздела, "проверка", "1");
	Опции.ПодписьОсновного = Тексты.Текст("settings.pool.tags.default.label");
	Опции.ПодсказкаОсновного = Тексты.Текст("settings.pool.tags.default.hint");
	Опции.АдресЗакрытия = АдресРаздела;
	Возврат Опции;

КонецФункции

// Удаление спрашивает имя тега: пакеты пула без своей копии перестанут его отдавать.
Функция ОкноУдаления(Знач ТегПула, Знач Состояние, Знач АдресРаздела)

	Возврат Кит.Подтверждение(Тексты.Шаблон("settings.pool.tags.delete.title", ТегПула.Имя),
			Тексты.Шаблон("settings.pool.tags.delete.consequence", ТегПула.Имя))
		.Эхо(Поля.ИмяПоляЭха(), ТегПула.Имя, Тексты.Текст("settings.tags.delete.echo"))
		.Кнопка(Тексты.Текст("settings.tags.button.remove"))
		.Ошибка(Окна.Отказ(Состояние, Поля.ИмяПоляЭха()))
		.Форма(Хвост(ТегПула.Имя, "delete")).БезПерезагрузки().Якорь("teg-pula-udalit").Открыто()
		.АдресЗакрытия(АдресРаздела);

КонецФункции

Функция ТегОкна(Знач Пул, Знач Состояние)

	Если Состояние = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Состояние.Ключ)
		ИЛИ Окна.Открыто(Состояние, "новый") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ТегиПула.НайтиТегПула(Пул.Идентификатор, Состояние.Ключ);

КонецФункции

// Адрес формы тега относительно раздела: «<тег>/<действие>».
Функция Хвост(Знач ИмяТега, Знач Действие)
	Возврат КодироватьСтроку(Строка(ИмяТега), СпособКодированияСтроки.КодировкаURL) + "/" + Действие;
КонецФункции

#КонецОбласти

&Прозвище("ВитринаТеговПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисТеговПула") _ТегиПула,
	&Пластилин(Значение = "КонструкторТега") _Конструкторы,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ОкноТега") _ОкноТега,
	&Пластилин(Значение = "ПоляТега") _Поля,
	&Пластилин(Значение = "ПлашкаТега") _Плашки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПараметрыСсылки") _Ссылки) Экспорт

	Кит = _Кит;
	ТегиПула = _ТегиПула;
	Конструкторы = _Конструкторы;
	Окна = _Окна;
	ОкноТега = _ОкноТега;
	Поля = _Поля;
	Плашки = _Плашки;
	Тексты = _Тексты;
	Ссылки = _Ссылки;

КонецПроцедуры
