// Раздел «Теги» дома «Пул»: галка «теги пула для пакетов», а при включённой галке — набор
// тегов-правил пула и конструктор тега пула.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем Ячейки;            // ЯчейкиТаблицы — заготовки ячеек таблиц
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем ТегиПула;          // СервисТеговПула (реестр) — набор пула и его галка
Перем Конструкторы;      // КонструкторТега — состояние конструктора и словарь видов
Перем Оформление;        // ВыборОформленияТега — поля стиля и значка
Перем Плашки;            // ПлашкаТега — плашка тега, студия и её живое превью
Перем Бланки;            // БланкРаздела — формы на адресе раздела
Перем Примечания;        // ПримечанияЭкрана — вид «показывать нечего»
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Ссылки;            // ПараметрыСсылки (основа) — параметр запроса на адресе

#Область ПубличныйИнтерфейс

// Секции раздела «Теги» дома «Пул».
//
// Параметры:
//  Параметры - Структура:
//    * Пул - Пул - пул раздела;
//    * Адрес - Строка - адрес раздела;
//    * Токен - Строка - CSRF-токен сессии;
//    * Правка - Структура, Неопределено - состояние конструктора отбитой формы;
//    * ТегИзАдреса - Строка - имя тега пула, открытого на правку; "" — заводится новый.
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Пул = Параметры.Пул;
	Бланк = Бланки.НаАдресе(Параметры.Адрес, Параметры.Токен);

	Результат = Новый Массив();
	Результат.Добавить(СекцияГалки(Пул, Бланк));
	Если НЕ ТегиПула.НаследованиеВключено(Пул) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Добавить(СекцияНабора(Пул, Бланк));
	Результат.Добавить(СекцияКонструктора(Бланк,
		Состояние(Пул, Параметры.Правка, Параметры.ТегИзАдреса)));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Галка

Функция СекцияГалки(Знач Пул, Знач Бланк)

	Настройка = Кит.Холст();
	// операция объявлена явно: форма без операции не значит «выключить наследование»
	Настройка.Добавить(Кит.СкрытоеПоле("операция", "теги_пула"));
	Настройка.Добавить(Кит.Тумблер(Новый Структура(
		"Имя, Метка, Включено, ПодписьВкл, ПодписьВыкл, Подсказка",
		"теги_пула", Тексты.Текст("settings.pool.tags.inherit.label"),
		ТегиПула.НаследованиеВключено(Пул),
		Тексты.Текст("settings.pool.tags.inherit.on"),
		Тексты.Текст("settings.pool.tags.inherit.off"),
		Тексты.Текст("settings.pool.tags.inherit.hint"))));
	Настройка.Добавить(Кит.Примечание(Тексты.Текст("settings.pool.tags.note")));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.pool.tags.title"),
		Тексты.Текст("settings.pool.tags.lead"), Настройка.Рендер());
	Секция.Иконка = "тег";
	Секция.Действие = Бланки.Адрес(Бланк);
	Секция.Токен = Бланк.Токен;
	Возврат Секция;

КонецФункции

#КонецОбласти

#Область Набор

Функция СекцияНабора(Знач Пул, Знач Бланк)

	Таблица = Кит.Таблица("карточками");
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.tags.col.tag")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.tags.col.rule")));
	Таблица.Добавить(Кит.Колонка());

	Для Каждого ТегПула Из ТегиПула.ТегиПула(Пул.Идентификатор) Цикл
		Таблица.Добавить(ЗаписьТега(ТегПула, Бланк));
	КонецЦикла;

	Таблица.Пусто().Добавить(Примечания.Пусто(Тексты.Текст("settings.pool.tags.set.empty")));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.pool.tags.set.title"),
		Тексты.Текст("settings.pool.tags.set.lead"), Таблица.Рендер());
	Секция.Иконка = "тег";
	Возврат Секция;

КонецФункции

Функция ЗаписьТега(Знач ТегПула, Знач Бланк)

	Запись = Кит.Запись(?(ТегПула.ПоУмолчанию = Истина, "выделенная", ""));
	Запись.Добавить(ЯчейкаТега(ТегПула));
	Запись.Добавить(ЯчейкаПравила(ТегПула));
	Запись.Добавить(ЯчейкаДействий(Бланк, ТегПула));
	Возврат Запись;

КонецФункции

Функция ЯчейкаДействий(Знач Бланк, Знач ТегПула)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(МенюТега(Бланк, ТегПула));
	Возврат Ячейка;

КонецФункции

// Плашка — та же, что у тега пакета: пакеты пула показывают его именно так.
Функция ЯчейкаТега(Знач ТегПула)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Плашки.Канал(ТегПула));
	Если ТегиПула.ЗапретСнят(ТегПула) Тогда
		Ячейка.Добавить(Кит.Плашка(Новый Структура("Текст, Вид",
			Тексты.Текст("settings.package.tags.repush.allowed"), "warn")));
	КонецЕсли;
	Возврат Ячейка;

КонецФункции

Функция ЯчейкаПравила(Знач ТегПула)

	Правило = ТегиПула.ПравилоТегаПула(ТегПула);
	Если Правило = Неопределено Тогда
		Возврат Ячейки.Текстовая(Тексты.Текст("settings.package.tags.none"));
	КонецЕсли;

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Код(Правило.Выражение));
	Если ЗначениеЗаполнено(Правило.Предупреждение()) Тогда
		Ячейка.Добавить(Кит.Уведомление(Новый Структура("Текст, Вид", Правило.Предупреждение(), "warn")));
	КонецЕсли;
	Возврат Ячейка;

КонецФункции

// Формы едут в панель готовыми фрагментами: слота у компонента «меню» в ките нет.
Функция МенюТега(Знач Бланк, Знач ТегПула)

	Пункты = Новый Массив();
	Пункты.Добавить(Новый Структура("Подпись, Адрес, Иконка",
		Тексты.Текст("settings.package.tags.button.edit"),
		Ссылки.Установить(Бланки.Адрес(Бланк), "tag", ТегПула.Имя), "тег"));
	Пункты.Добавить(Новый Структура("HTML", ФормаОперации(Бланк, "по_умолчанию", ТегПула.Имя,
		Тексты.Текст("settings.package.tags.button.default")).Рендер()));
	Пункты.Добавить(Новый Структура("HTML", ФормаОперации(Бланк, "удалить", ТегПула.Имя,
		Тексты.Текст("settings.package.tags.button.remove")).Рендер()));

	Возврат Кит.Меню(Новый Структура("Подпись, Пункты",
		Тексты.Шаблон("settings.package.tags.menu.title", Строка(ТегПула.Имя)), Пункты));

КонецФункции

Функция ФормаОперации(Знач Бланк, Знач Операция, Знач ИмяТега, Знач Подпись)

	Форма = Бланки.Форма(Бланк, "", "меню");
	Форма.Добавить(Кит.СкрытоеПоле("операция", Операция));
	Форма.Добавить(Кит.СкрытоеПоле("имя", ИмяТега));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Подпись, "вторичная", "малый")));
	Возврат Форма;

КонецФункции

#КонецОбласти

#Область Конструктор

// Отбитая форма возвращается с набранным, адрес правки — с тегом пула.
Функция Состояние(Знач Пул, Знач Правка, Знач ТегИзАдреса)

	Если Правка <> Неопределено И ТипЗнч(Правка) = Тип("Структура") И Правка.Свойство("Правило") Тогда
		Возврат Правка;
	КонецЕсли;
	Возврат Конструкторы.ДляТегаПула(?(ЗначениеЗаполнено(ТегИзАдреса),
		ТегиПула.НайтиТегПула(Пул.Идентификатор, ТегИзАдреса), Неопределено), ТегИзАдреса);

КонецФункции

Функция СекцияКонструктора(Знач Бланк, Знач Состояние)

	Студия = Плашки.Студия();
	Поля = Студия.Добавить(Кит.Область("работа"));
	Поля.Добавить(Кит.Поле(Новый Структура("Имя, Метка, Плейсхолдер, Значение",
		"имя", Тексты.Текст("settings.package.tag-new.name.label"), "lts", Состояние.Имя)));
	Поля.Добавить(ВыборВида(Состояние));
	Поля.Добавить(Кит.Поле(Новый Структура("Имя, Метка, Плейсхолдер, Подсказка, Значение",
		"правило", Тексты.Текст("settings.pool.tags.rule.label"), "^1.2",
		Тексты.Текст("settings.pool.tags.rule.hint"), Состояние.Правило)));
	Поля.Добавить(Оформление.Поля(Состояние));
	Поля.Добавить(Кит.Тумблер(Новый Структура("Имя, Метка, Включено, Заблокировано, Подсказка",
		"по_умолчанию", Тексты.Текст("settings.package.tag-new.default.label"),
		Состояние.ПоУмолчанию ИЛИ Состояние.БылоПоУмолчанию, Состояние.БылоПоУмолчанию,
		Тексты.Текст("settings.pool.tags.default.hint"))));
	Поля.Добавить(Кит.Тумблер(Новый Структура("Имя, Метка, Включено, Подсказка",
		"запрет_перезаписи", Тексты.Текст("settings.package.tag-new.repush.label"),
		Состояние.ЗапретПерезаписи, Тексты.Текст("settings.package.tag-new.repush.hint"))));
	Студия.Добавить(Плашки.Предпросмотр(Состояние));

	Тело = Кит.Холст();
	Тело.Добавить(Студия);
	Если ЗначениеЗаполнено(Состояние.Ошибка) Тогда
		Тело.Добавить(Кит.Уведомление(Новый Структура("Текст, Вид", Состояние.Ошибка, "error")));
	КонецЕсли;

	Секция = РендерерНастроек.Секция(?(Состояние.Правится,
		Тексты.Текст("settings.pool.tags.edit.title"), Тексты.Текст("settings.pool.tags.new.title")),
		Тексты.Текст("settings.pool.tags.new.lead"), Тело.Рендер());
	Секция.Иконка = "тег";
	Секция.Действие = Бланки.Адрес(Бланк);
	Секция.Токен = Бланк.Токен;
	Секция.Кнопка = Тексты.Текст("settings.pool.tags.new.button");
	Секция.ИконкаКнопки = "сохранить";
	Секция.ИмяКнопки = "операция";
	Секция.ЗначениеКнопки = "сохранить";
	Возврат Секция;

КонецФункции

// Ручного вида у тега пула нет: ручной состав ведут у пакета.
Функция ВыборВида(Знач Состояние)

	Варианты = Новый Массив();
	Варианты.Добавить(Новый Структура("Значение, Подпись", Конструкторы.ВидSemver(),
		Тексты.Текст("settings.package.tag-new.type.semver")));
	Варианты.Добавить(Новый Структура("Значение, Подпись", Конструкторы.ВидRegex(),
		Тексты.Текст("settings.package.tag-new.type.regex")));

	Возврат Кит.Поле(Новый Структура("Имя, Тип, Значение, Метка, Варианты",
		"вид", "выбор", Конструкторы.КодВида(Состояние.Режим, Состояние.Тип),
		Тексты.Текст("settings.package.tag-new.mode.label"), Варианты));

КонецФункции

#КонецОбласти

&Прозвище("ВитринаТеговПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ЯчейкиТаблицы") _Ячейки,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "СервисТеговПула") _ТегиПула,
	&Пластилин(Значение = "КонструкторТега") _Конструкторы,
	&Пластилин(Значение = "ВыборОформленияТега") _Оформление,
	&Пластилин(Значение = "ПлашкаТега") _Плашки,
	&Пластилин(Значение = "БланкРаздела") _Бланки,
	&Пластилин(Значение = "ПримечанияЭкрана") _Примечания,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПараметрыСсылки") _Ссылки = Неопределено) Экспорт

	Кит = _Кит;
	Ячейки = _Ячейки;
	РендерерНастроек = _РендерерНастроек;
	ТегиПула = _ТегиПула;
	Конструкторы = _Конструкторы;
	Оформление = _Оформление;
	Плашки = _Плашки;
	Бланки = _Бланки;
	Примечания = _Примечания;
	Тексты = _Тексты;
	Ссылки = ?(_Ссылки = Неопределено, Новый ПараметрыСсылки(), _Ссылки);

КонецПроцедуры
