&ТочкаМаршрута("pools/{pool}/settings/webhooks/preview")
Процедура ПредпросмотрЗаведения(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	fragment = "") Экспорт

	ПредпросмотрПравки(Ответ, pool, "", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, fragment);

КонецПроцедуры

