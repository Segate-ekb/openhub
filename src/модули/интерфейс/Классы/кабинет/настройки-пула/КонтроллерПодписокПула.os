Процедура Сохранение(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьДействие(Ответ, pool, id, "сохранить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/webhooks/{id}/recipients» — галки дерева получателей подписки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
