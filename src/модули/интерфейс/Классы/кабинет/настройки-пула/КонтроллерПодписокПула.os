//  fragment - Строка - непустое: ответ кусочком для скрипта страницы (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/settings/webhooks/{id}/preview")
Процедура ПредпросмотрПравки(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	fragment = "") Экспорт

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПредпросмотра(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id, fragment), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/webhooks/inherited/{id}/narrow» — поправка объекта к подписке сверху:
// окно «Сузить» и «Не присылать сюда».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/settings/webhooks/inherited/{id}/narrow")
Процедура Сужение(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПоправки(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, "сузить", id), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/webhooks/inherited/{id}/reset» — снятие поправки к подписке сверху.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/settings/webhooks/inherited/{id}/reset")
Процедура СнятиеПоправки(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПоправки(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, "снять", id), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/webhooks/inherited/{id}/recipients» — дверь окна «Пакеты
// пула» поправки пула к подписке хаба: GET — раздел с окном, POST — галки пакетов.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  найти - Строка - строка поиска окна (необязательный, по умолчанию "").
//  ветка - Строка - ключ ветки, чья страница показана (необязательный, по умолчанию "").
//  страница - Строка - номер страницы с единицы (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/settings/webhooks/inherited/{id}/recipients")
Процедура ПолучателиПоправки(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	найти = "", ветка = "", страница = "") Экспорт

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПакетовПула(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id, Ход.ВидДерева(найти, ветка, страница)), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбщаяЛогика

// Гвард + резолв пула + проверка права администрирования.
Функция Подготовить(Ответ, Знач pool, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Пользователь = Вердикт.Пользователь;

	Пул = СервисПулов.НайтиПул(pool);
	// несуществующий и чужой приватный пул дают одинаковый 404
	Если Пул = Неопределено ИЛИ НЕ СервисПрав.МожетЧитать(Пользователь, Пул) Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт, Тексты.Текст("subscriptions.pool.error.notfound"),
			КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	// подписками пула распоряжается только владелец/админ пула — на КАЖДОМ действии
	Если НЕ СервисПрав.МожетАдминистрировать(Пользователь, Пул) Тогда
		Ответы.ОтдатьЗапрещено(Ответ, Вердикт,
			Тексты.Текст("subscriptions.pool.error.forbidden"), КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Пользователь, Сессия, Пул", Пользователь, Вердикт.Сессия, Пул);

КонецФункции

// Чьи это подписки и по какому адресу живёт раздел — всё, что ход о доме знает.
Функция ОписаниеРаздела(Знач Контекст)
	Возврат Ход.ОписаниеРаздела(СервисПодписок.ОбъектПула(Контекст.Пул),
		Дом.АдресРаздела(Контекст.Пул.Имя, "webhooks"));
КонецФункции

#КонецОбласти

#Область Рендер

// Пустой показ — ход уже ответил сам: отбил форму, не нашёл подписку или увёл редиректом.
Процедура ОтдатьРаздел(Ответ, Знач Контекст, Знач Показ, Знач КукиЗапроса)

	Если Показ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Пул = Контекст.Пул;
	Токен = Защита.ТокенСессии(Контекст.Сессия);
	Модель = Ответы.МодельДома(Дом, Пул.Имя, Дом.Разделы(Пул.Имя, "webhooks"), Ход.Уведомления(Показ),
		Секции(Контекст, Показ, Токен), Токен, Дом.Крошки(Пул.Имя));
	Ответы.ОтдатьДом(Ответ, Модель, Контекст, КукиЗапроса, Показ.Статус);

КонецПроцедуры

// Раздел пула: свои подписки, затем подписки хаба, которые пул вправе сузить. Сюда пускает
// только гейт администрирования — менять разрешено всегда.
Функция Секции(Знач Контекст, Знач Показ, Знач Токен)

	Раздел = ОписаниеРаздела(Контекст);
	АдресТегов = Дом.АдресРаздела(Контекст.Пул.Имя, "tags");

	Результат = Витрина.Секции(Ход.ПараметрыВитрины(Показ, Раздел, Токен,
		Тексты.Текст("subscriptions.pool.lead"), Истина, АдресТегов));
	Для Каждого Секция Из ВитринаСверху.Секции(Ход.ПараметрыВитриныСверху(Показ, Раздел, Токен,
		Контекст.Пул.Имя, Истина, АдресТегов)) Цикл
		Результат.Добавить(Секция);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _Гвард,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомПула") _Дом,
	&Пластилин(Значение = "ВитринаПодписок") _Витрина,
	&Пластилин(Значение = "ВитринаПодписокСверху") _ВитринаСверху,
	&Пластилин(Значение = "ХодПодписок") _Ход,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	Гвард = _Гвард;
	Защита = _Защита;
	СервисПулов = _СервисПулов;
	СервисПодписок = _СервисПодписок;
	СервисПрав = _СервисПрав;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	ВитринаСверху = _ВитринаСверху;
	Ход = _Ход;
	Тексты = _Тексты;

КонецПроцедуры
