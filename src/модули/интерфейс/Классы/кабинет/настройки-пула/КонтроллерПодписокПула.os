&ТочкаМаршрута("pools/{pool}/settings/webhooks/{id}/recipients")
Процедура Получатели(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Показ = Ход.ПоказПоДереву(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
		МетодЗапроса, ТелоЗапроса, id);
	ОтдатьРаздел(Ответ, Контекст, Показ, КукиЗапроса);

КонецПроцедуры

