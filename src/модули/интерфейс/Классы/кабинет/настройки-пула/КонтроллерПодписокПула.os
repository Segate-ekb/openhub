// Маршруты подписок пула (pools/{pool}/settings/webhooks): свои подписки с окнами по адресу,
// их получатели, пробная отправка и предпросмотр, поправки к подпискам хаба и пакеты пула в них.
// Каждая дверь — за гвардом кабинета и правом администрировать пул.

Перем Гвард;          // ГвардКабинета
Перем Защита;         // ЗащитаCSRF (вход) — токен для форм страницы
Перем СервисПулов;    // СервисПулов (реестр)
Перем СервисПодписок; // СервисПодписок (подписки)
Перем СервисПрав;     // СервисПрав (права)
Перем Ответы;         // ОтветыНастроек
Перем Дом;            // ДомПула
Перем Витрина;        // ВитринаПодписок
Перем ВитринаСверху;  // ВитринаПодписокСверху — подписки хаба, которые пул вправе сузить
Перем Ход;            // ХодПодписок — общий ход раздела подписок
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ТочкиМаршрута

// Точка маршрута «pools/{pool}/settings/webhooks»: GET — страница раздела, POST — заведение подписки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: <вид>-<ключ> (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/settings/webhooks")
Процедура Раздел(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, saved = "", окно = "") Экспорт

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПоАдресу(Контекст, окно, saved), КукиЗапроса);
		Возврат;
	КонецЕсли;
	ОтдатьРаздел(Ответ, Контекст, Ход.ПоказЗаведения(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
		МетодЗапроса, ТелоЗапроса), КукиЗапроса);

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/webhooks/{id}/save» — форма окна «Изменить».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/settings/webhooks/{id}/save")
Процедура Сохранение(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПравки(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/webhooks/{id}/toggle» — тумблер записи.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/settings/webhooks/{id}/toggle")
Процедура Переключение(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПереключения(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/webhooks/{id}/delete». Без поля подтверждения подписка не удаляется:
// ответ ведёт на страницу с открытым подтверждением.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/settings/webhooks/{id}/delete")
Процедура Удаление(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказУдаления(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/webhooks/{id}/recipients» — дверь окна «Получатели»: GET —
// раздел с окном на всём дереве, странице ветки или найденном; POST — правки окна.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  найти - Строка - строка поиска окна (необязательный, по умолчанию "").
//  ветка - Строка - ключ ветки, чья страница показана (необязательный, по умолчанию "").
//  страница - Строка - номер страницы ветки с единицы (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/settings/webhooks/{id}/recipients")
Процедура Получатели(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, найти = "",
	ветка = "", страница = "") Экспорт

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПолучателей(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id, Ход.ВидДерева(найти, ветка, страница)), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/webhooks/{id}/test» — пробная отправка: полями окна правки, без
// сохранения, а без полей окна — сохранёнными настройками.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  fragment - Строка - непустое: ответ кусочком для скрипта страницы (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/settings/webhooks/{id}/test")
Процедура ПробнаяОтправка(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	fragment = "") Экспорт

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПробы(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id, fragment), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/webhooks/test» — пробная отправка полями окна «Новая подписка».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  fragment - Строка - непустое: ответ кусочком для скрипта страницы (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/settings/webhooks/test")
Процедура ПробаЗаведения(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	fragment = "") Экспорт

	ПробнаяОтправка(Ответ, pool, "", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, fragment);

КонецПроцедуры

