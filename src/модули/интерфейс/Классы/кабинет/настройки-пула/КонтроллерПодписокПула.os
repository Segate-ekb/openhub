#КонецОбласти

#Область Действия

Процедура ВыполнитьДействие(Ответ, Знач pool, Знач id, Знач Действие,
	Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Показ = Ход.ПоказПоДействию(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
		МетодЗапроса, ТелоЗапроса, Действие, id);
	ОтдатьРаздел(Ответ, Контекст, Показ, КукиЗапроса);

КонецПроцедуры

Процедура ВыполнитьПоправку(Ответ, Знач pool, Знач id, Знач Действие,
	Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Показ = Ход.ПоказПоПоправке(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
		МетодЗапроса, ТелоЗапроса, Действие, id);
