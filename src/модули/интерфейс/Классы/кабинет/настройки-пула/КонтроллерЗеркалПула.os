// Маршруты раздела «Зеркала» дома «Пул»: страница с окном по адресу, заведение, правка токена,
// тумблер, заявка на синхронизацию, снятие токена, удаление и экран состояния зеркала. Удача —
// 303 на раздел, отказ — та же страница с окном, открытым на набранном и отказах.

Перем ГвардПула;
Перем Защита;         // ЗащитаCSRF (вход) — токен сессии в форму
Перем Ответы;         // ОтветыНастроек
Перем Дом;            // ДомПула
Перем Витрина;        // ВитринаЗеркал
Перем ПультСостояния; // ПультСостоянияЗеркала — экран состояния синхронизации
Перем Пульт;          // ПультЗеркалПула — операции раздела
Перем Окна;           // ОкноРаздела — окно по адресу и ответы форм окон
Перем Ссылки;         // ПараметрыСсылки (основа) — параметр запроса на адресе

#Область ТочкиМаршрута

// Точка маршрута «pools/{pool}/settings/mirrors»: GET — страница раздела, POST — заведение
// зеркала.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного действия из адреса (необязательный, по умолчанию "").
//  migrate - Строка - непустое значение открывает окно заведения с отмеченным флажком
//            переноса: так сюда ведёт страница пустого пула, приглашая перевезти пакеты
//            (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: <вид>-<номер> (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/settings/mirrors")
Процедура Раздел(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	saved = "", migrate = "", окно = "") Экспорт

	Вердикт = ГвардПула.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Вердикт, КукиЗапроса, 200, Окна.ИзАдреса(окно, Витрина.ВидыОкон()),
			ЗначениеЗаполнено(saved), "", ЗначениеЗаполнено(migrate));
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Вердикт, КукиЗапроса, Пульт.Создать(Вердикт.Пользователь, Вердикт.Пул, Форма),
		"новый", "", Форма);

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/mirrors/{id}» (GET).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор зеркала из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  sync - Строка - итог нажатия «синхронизировать сейчас» из адреса: "1" заявка принята,
//         "running" прогон уже идёт, "queued" зеркало уже ждёт очереди
//         (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/settings/mirrors/{id}")
Процедура Состояние(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, sync = "") Экспорт

	ПультСостояния.Показать(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, sync);

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/mirrors/{id}/toggle» (POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор зеркала из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/settings/mirrors/{id}/toggle")
Процедура Переключение(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Вердикт = Мутация.Вердикт;
	Завершить(Ответ, Вердикт, КукиЗапроса,
		Пульт.Переключить(Вердикт.Пользователь, Вердикт.Пул, id, Мутация.Форма), "", id, Мутация.Форма);

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/mirrors/{id}/sync» (POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор зеркала из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/settings/mirrors/{id}/sync")
Процедура Синхронизация(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Вердикт = Мутация.Вердикт;
	Исход = Пульт.Синхронизировать(Вердикт.Пользователь, Вердикт.Пул, id);
	Если НЕ Исход.Успех Тогда
		Завершить(Ответ, Вердикт, КукиЗапроса, Исход, "", id, Мутация.Форма);
		Возврат;
	КонецЕсли;
	// итог заявки уходит параметром на экран состояния: тот говорит, что вышло
	Ответ.Перенаправить(Ссылки.Установить(АдресРаздела(Вердикт) + "/" + Исход.Номер, "sync", Исход.КодЗаявки));
	Ответ.УстановитьСостояние(303);

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/mirrors/{id}/token-off» (POST): снять токен доступа
// с апстрима зеркала — оно возвращается к анонимному чтению.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор зеркала из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/settings/mirrors/{id}/token-off")
Процедура СнятиеТокена(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Вердикт = Мутация.Вердикт;
	Завершить(Ответ, Вердикт, КукиЗапроса, Пульт.СнятьТокен(Вердикт.Пользователь, Вердикт.Пул, id),
		"токен", id, Мутация.Форма);

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/mirrors/{id}/save» — форма окна «Изменить».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор зеркала из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/settings/mirrors/{id}/save")
Процедура Сохранение(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Вердикт = Мутация.Вердикт;
	Завершить(Ответ, Вердикт, КукиЗапроса,
		Пульт.Сохранить(Вердикт.Пользователь, Вердикт.Пул, id, Мутация.Форма), "изменить", id, Мутация.Форма);

КонецПроцедуры

// Точка маршрута «pools/{pool}/settings/mirrors/{id}/delete». Без поля подтверждения (форма ушла
// без скрипта) зеркало не удаляется: ответ ведёт на страницу с открытым подтверждением.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор зеркала из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/settings/mirrors/{id}/delete")
Процедура Удаление(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Вердикт = Мутация.Вердикт;
	Если НЕ Окна.Подтверждено(Мутация.Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресРаздела(Вердикт), id);
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Вердикт, КукиЗапроса,
		Пульт.Удалить(Вердикт.Пользователь, Вердикт.Пул, id, Мутация.Форма), "удалить", id, Мутация.Форма);

КонецПроцедуры

#КонецОбласти

#Область Действия

// Общий пролог мутирующих точек: гвард → только POST → форма с CSRF.
Функция Мутация(Ответ, Знач pool, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса,
	Знач ТелоЗапроса)

	Вердикт = ГвардПула.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "POST", Вердикт, КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Вердикт, Форма", Вердикт, Форма);

КонецФункции

// Исход пульта → ответ: удача — 303 на раздел; отказ — страница с окном этой формы, открытым
// на набранном и отказах. Окна нет (тумблер, заявка, зеркало уже удалено) — отказ тостом
// над разделом: причина названа в любом случае.
Процедура Завершить(Ответ, Знач Вердикт, Знач КукиЗапроса, Знач Исход, Знач ВидОкна, Знач Номер,
	Знач Форма)

	Если Исход.Успех Тогда
		Окна.ВернутьВРаздел(Ответ, АдресРаздела(Вердикт));
		Возврат;
	КонецЕсли;

	// отказ у поля в окне уже назван — второй раз над полями его не повторяют
	Окно = Окна.Отбитое(ВидОкна, Номер, Форма, Исход.Отказы,
		?(Исход.Отказы.Количество() > 0, "", Исход.Сообщение));
	Если ЗначениеЗаполнено(ВидОкна) И Витрина.ЕстьОкно(Вердикт.Пул, Окно) Тогда
		ОтдатьРаздел(Ответ, Вердикт, КукиЗапроса, Исход.Код, Окно);
		Возврат;
	КонецЕсли;
	ОтдатьРаздел(Ответ, Вердикт, КукиЗапроса, Исход.Код, Неопределено, Ложь, Исход.Сообщение);

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач КукиЗапроса, Знач Статус, Знач Окно,
	Знач Сохранено = Ложь, Знач Ошибка = "", Знач ПредвыборПереноса = Ложь)

	Пул = Вердикт.Пул;
	Параметры = Новый Структура("Пул, Адрес, Окно, Перенос", Пул, АдресРаздела(Вердикт), Окно,
		ПредвыборПереноса);

	Модель = Ответы.МодельДома(Дом, Пул.Имя,
		Дом.Разделы(Пул.Имя, "mirrors"),
		Ответы.УведомленияРаздела(Сохранено, Ошибка),
		Витрина.Секции(Параметры),
		Защита.ТокенСессии(Вердикт.Сессия),
		Дом.Крошки(Пул.Имя));

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт, КукиЗапроса, Статус);

КонецПроцедуры

Функция АдресРаздела(Знач Вердикт)
	Возврат Дом.АдресРаздела(Вердикт.Пул.Имя, "mirrors");
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардПула") _ГвардПула,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомПула") _Дом,
	&Пластилин(Значение = "ВитринаЗеркал") _Витрина,
	&Пластилин(Значение = "ПультСостоянияЗеркала") _ПультСостояния,
	&Пластилин(Значение = "ПультЗеркалПула") _Пульт,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ПараметрыСсылки") _Ссылки = Неопределено)

	ГвардПула = _ГвардПула;
	Защита = _Защита;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	ПультСостояния = _ПультСостояния;
	Пульт = _Пульт;
	Окна = _Окна;
	Ссылки = ?(_Ссылки = Неопределено, Новый ПараметрыСсылки(), _Ссылки);

КонецПроцедуры
