// Гвард домена «Пул»: базовые гейты кабинета и права на пул, отказ — страницей хаба.

Перем ГвардКабинета;
Перем Ответы;         // ОтветыНастроек — страница отказа
Перем Тексты;         // ТекстыИнтерфейса (кит)
Перем СервисПрав;     // СервисПрав (права)
Перем СервисПулов;    // СервисПулов (реестр)
Перем Вердикты;       // ВердиктГварда (права) — форма ответа гварда

// Проверяет доступ к маршруту домена «Пул».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки (winow).
//  ИмяПула - Строка - имя пула из URL-сегмента {pool}.
//
// Возвращаемое значение:
//  Структура - вердикт гварда: Разрешено, Причина и поля формы —
//              Принципал, Пользователь, Сессия, Пул.
//
Функция Проверить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ИмяПула) Экспорт

	Вердикт = ГвардКабинета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Отказ(); // редирект уже записан базовым гвардом
	КонецЕсли;

	Пользователь = Вердикт.Пользователь;
	Пул = СервисПулов.НайтиПул(ИмяПула);

	// приватность: несуществующий ИЛИ нечитаемый приватный пул → 404 (не раскрываем)
	Если Пул = Неопределено ИЛИ НЕ СервисПрав.МожетЧитать(Пользователь, Пул) Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Пользователь, Тексты.Текст("settings.guard.pool.notfound"), КукиЗапроса);
		Возврат Отказ();
	КонецЕсли;

	Если НЕ СервисПрав.МожетАдминистрировать(Пользователь, Пул) Тогда
		Ответы.ОтдатьЗапрещено(Ответ, Пользователь,
			Тексты.Текст("settings.guard.pool.forbidden"), КукиЗапроса);
		Возврат Отказ();
	КонецЕсли;

	Возврат Вердикты.Пропуск(ПоляОтвета(Вердикт.Принципал, Пользователь, Вердикт.Сессия, Пул));

КонецФункции

// Поля, которые гвард отдаёт вызывающему: принципал целиком плюс пул маршрута.
Функция ПоляОтвета(Знач Принципал = Неопределено, Знач Пользователь = Неопределено,
	Знач Сессия = Неопределено, Знач Пул = Неопределено)

	Поля = Вердикты.ПоляПринципала(Принципал, Пользователь, Сессия);
	Поля.Вставить("Пул", Пул);
	Возврат Поля;

КонецФункции

Функция Отказ()
	Возврат Вердикты.Отказ("", ПоляОтвета());
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _ГвардКабинета,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ВердиктГварда") _Вердикты = Неопределено)

	Вердикты = ?(_Вердикты = Неопределено, Новый ВердиктГварда(), _Вердикты);
	ГвардКабинета = _ГвардКабинета;
	Ответы = _Ответы;
	Тексты = _Тексты;
	СервисПрав = _СервисПрав;
	СервисПулов = _СервисПулов;

КонецПроцедуры
