// Раздел «Общие» дома «Пул»: свойства пула словами — имя и адрес для opm с копированием, видимость
// плашкой, владелец, основной пул, число пакетов, место полосой — и ссылки туда, где они меняются.

Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем Дом;           // ДомПула — адреса разделов
Перем СервисПулов;   // СервисПулов (реестр) — занятое и действующая квота
Перем Заполнение;    // ЗаполнениеПула (реестр) — процент занятого
Перем Объёмы;        // ОбъёмТекстом (основа) — байты человеку
Перем Опм;           // КомандыOpm — адрес пула для opm install
Перем Плашки;        // ПлашкиПула — видимость плашкой, как на странице пула
Перем Пользователи;  // СервисПользователей (вход) — логин владельца
Перем Пакеты;        // СервисПакетов (реестр) — число нескрытых пакетов
Перем Права;         // СервисПрав (права) — видит ли смотрящий настройки хаба
Перем ДомХаба;       // ДомХаба — раздел, где назначают основной пул
Перем Страницы;      // АдресаСтраниц (реестр) — страница пула
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секция «Общие»: свойства пула, а не поля; рядом с каждым значением — ссылка туда, где оно меняется.
//
// Параметры:
//  Пул - Пул - пул раздела.
//  Пользователь - Пользователь, Неопределено - смотрящий: ссылку в настройки хаба видит администратор хаба.
//  ЗаголовкиЗапроса - Соответствие, Неопределено - заголовки запроса: узел хаба в адресе для opm.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.Секция.
//
Функция Секция(Знач Пул, Знач Пользователь, Знач ЗаголовкиЗапроса) Экспорт

	Возврат Кит.Секция(Тексты.Текст("settings.pool.general.title"),
			Кит.Свойства(
				СвойствоИмени(Пул),
				СвойствоАдресаOpm(Пул, ЗаголовкиЗапроса),
				СвойствоВидимости(Пул),
				СвойствоВладельца(Пул),
				СвойствоОсновного(Пул, Пользователь),
				СвойствоПакетов(Пул),
				СвойствоМеста(Пул)))
		.Иконка("шестерёнка");

КонецФункции

#КонецОбласти

#Область Свойства

// Имя входит в адреса пакетов и не меняется: его копируют, а не правят.
Функция СвойствоИмени(Знач Пул)

	Возврат Кит.Свойство(Тексты.Текст("settings.pool.general.name"), Кит.Код(Строка(Пул.Имя)))
		.Копируемое(Строка(Пул.Имя))
		.Примечание(Тексты.Текст("settings.pool.general.name.note"));

КонецФункции

Функция СвойствоАдресаOpm(Знач Пул, Знач ЗаголовкиЗапроса)

	Команда = Опм.Установка(Пул, Тексты.Текст("settings.pool.general.opm.package"),
		Опм.Узел(ЗаголовкиЗапроса));
	Возврат Кит.Свойство(Тексты.Текст("settings.pool.general.opm"), Кит.Код(Команда))
		.Копируемое(Команда);

КонецФункции

Функция СвойствоВидимости(Знач Пул)

	Модель = Плашки.ПлашкаВидимости(Пул);
	Возврат Кит.Свойство(Тексты.Текст("settings.pool.general.visibility"),
		Кит.Плашка(Модель.Текст).Вид(Модель.Вид),
		Кит.Ссылка(Дом.АдресРаздела(Пул.Имя, "visibility"),
			Тексты.Текст("settings.pool.general.visibility.link")));

КонецФункции

// Владельца у пула может не быть: пул заведён без учётки или учётка снята.
Функция СвойствоВладельца(Знач Пул)

	Владелец = Неопределено;
	Если ЗначениеЗаполнено(Пул.ВладелецИдентификатор) Тогда
		Владелец = Пользователи.ПоИдентификатору(Пул.ВладелецИдентификатор);
	КонецЕсли;
	Логин = ?(Владелец = Неопределено, Тексты.Текст("settings.pool.general.owner.none"),
		Строка(Владелец.Логин));

	Возврат Кит.Свойство(Тексты.Текст("settings.pool.general.owner"),
		Логин, Разделитель(),
		Кит.Ссылка(Дом.АдресРаздела(Пул.Имя, "access"),
			Тексты.Текст("settings.pool.general.owner.link")));

КонецФункции

// Основной пул назначают в настройках хаба: ссылку туда видит тот, кто туда войдёт.
Функция СвойствоОсновного(Знач Пул, Знач Пользователь)

	Значение = ?(Пул.ЭтоДефолтный(), Тексты.Текст("settings.pool.general.default.yes"),
		Тексты.Текст("settings.pool.general.default.no"));
	Где = Тексты.Текст("settings.pool.general.default.link");
	Если Права.ПользовательАдмин(Пользователь) Тогда
		Где = Кит.Ссылка(ДомХаба.АдресРаздела("pools"), Где);
	КонецЕсли;

	Возврат Кит.Свойство(Тексты.Текст("settings.pool.general.default"), Значение, Разделитель(), Где);

КонецФункции

// Число нескрытых пакетов — то, что видит посетитель на странице пула.
Функция СвойствоПакетов(Знач Пул)

	Идентификаторы = Новый Массив();
	Идентификаторы.Добавить(Пул.Идентификатор);
	Количество = Пакеты.КоличествоВидимыхПакетовПоПулам(Идентификаторы).Получить(Цел(Пул.Идентификатор));

	Возврат Кит.Свойство(Тексты.Текст("settings.pool.general.packages"),
		Тексты.ЧислоТекстом(?(Количество = Неопределено, 0, Количество)), Разделитель(),
		Кит.Ссылка(Страницы.Пула(Пул.Имя), Тексты.Текст("settings.pool.general.packages.link")));

КонецФункции

// Место полосой от действующей квоты; у пула без ограничения процента нет — одно занятое.
Функция СвойствоМеста(Знач Пул)

	Занято = СервисПулов.ЗанятоБайт(Пул);
	КвотаБайт = СервисПулов.ЭффективнаяКвотаБайт(Пул);
	Квота = Кит.Ссылка(Дом.АдресРаздела(Пул.Имя, "quota"), Тексты.Текст("settings.pool.general.space.link"));
	Подпись = Тексты.Текст("settings.pool.general.space");

	Если КвотаБайт <= 0 Тогда
		Возврат Кит.Свойство(Подпись,
			Тексты.Шаблон("settings.pool.quota.meter.unlimited", Объёмы.Представление(Занято)),
			Разделитель(), Квота);
	КонецЕсли;

	Сколько = Тексты.Шаблон("settings.pool.quota.meter.value",
		Объёмы.Представление(Занято), Объёмы.Представление(КвотаБайт));
	Возврат Кит.Свойство(Подпись,
		Кит.ПолосаЗаполнения(Заполнение.Процент(Занято, КвотаБайт),
			Тексты.Текст("settings.pool.quota.meter.label")),
		Сколько, Разделитель(), Квота);

КонецФункции

Функция Разделитель()
	Возврат Кит.Текст(" · ");
КонецФункции

#КонецОбласти

&Прозвище("ВитринаОбщихПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ДомПула") _Дом,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ЗаполнениеПула") _Заполнение,
	&Пластилин(Значение = "ОбъёмТекстом") _Объёмы,
	&Пластилин(Значение = "КомандыOpm") _Опм,
	&Пластилин(Значение = "ПлашкиПула") _Плашки,
	&Пластилин(Значение = "СервисПользователей") _Пользователи,
	&Пластилин(Значение = "СервисПакетов") _Пакеты,
	&Пластилин(Значение = "СервисПрав") _Права,
	&Пластилин(Значение = "ДомХаба") _ДомХаба,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Дом = _Дом;
	СервисПулов = _СервисПулов;
	Заполнение = _Заполнение;
	Объёмы = _Объёмы;
	Опм = _Опм;
	Плашки = _Плашки;
	Пользователи = _Пользователи;
	Пакеты = _Пакеты;
	Права = _Права;
	ДомХаба = _ДомХаба;
	Страницы = _Страницы;
	Тексты = _Тексты;

КонецПроцедуры
