// Операции раздела «Теги» дома «Пул»: галка «теги пула для пакетов», заведение, правка
// и удаление тега пула. Исход каждой — домена плюс отказы у полей окна.

Перем Гейт;           // ГейтФормы — CSRF-токен формы
Перем РазборФормы;
Перем ТегиПула;       // СервисТеговПула (реестр)
Перем СервисТегов;    // СервисТегов (реестр) — алфавит имени тега
Перем Конструкторы;   // КонструкторТега — набранное в окне и словарь видов
Перем Поля;           // ПоляТега — имена полей окна тега
Перем Сбои;           // ТекстСбоя — причина сбоя человеку и отчёт в журнал
Перем Тексты;         // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Разбирает тело запроса и проверяет CSRF.
//
// Параметры:
//  Ответ - ОтветСервера.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  ТелоЗапроса - Строка.
//  КукиЗапроса - Куки - куки запроса.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - разобранная форма; Неопределено — ответ уже сформирован.
//
Функция Форма(Ответ, Знач Контекст, Знач ТелоЗапроса, Знач КукиЗапроса) Экспорт
	Возврат Гейт.СПринятымТокеном(Ответ, Контекст, РазборФормы.Разобрать(ТелоЗапроса), КукиЗапроса);
КонецФункции

// Пришла ли форма галки «теги пула для пакетов»: у неё своя операция, у окна тега её нет.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоГалка(Знач Форма) Экспорт
	Возврат НРег(СокрЛП(РазборФормы.Поле(Форма, Поля.ИмяПоляОперации()))) = Поля.ОперацияГалки();
КонецФункции

// Пришла ли форма старой вкладки: её операция («сохранить», «удалить», «по_умолчанию») новой
// странице неизвестна. Такая форма отбивается, а не уходит молча в заведение тега.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//  Допустимые - Строка - операции, которые эта точка принимает, через запятую; "" — никаких.
//
// Возвращаемое значение:
//  Булево.
//
Функция ФормаУстарела(Знач Форма, Знач Допустимые = "") Экспорт

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, Поля.ИмяПоляОперации())));
	Возврат ЗначениеЗаполнено(Операция) И СтрРазделить(Допустимые, ",", Ложь).Найти(Операция) = Неопределено;

КонецФункции

// Операции, которые принимает форма раздела: тумблер «теги пула для пакетов».
//
// Возвращаемое значение:
//  Строка - через запятую.
//
Функция ОперацииРаздела() Экспорт
	Возврат Поля.ОперацияГалки();
КонецФункции

// Отказ формы старой вкладки: ничего не изменено.
//
// Возвращаемое значение:
//  Структура - исход (см. Создать), код 400.
//
Функция ОтказУстаревшей() Экспорт
	Возврат Отбито(Тексты.Текст("settings.tags.error.stale"));
КонецФункции

// Включает или выключает наследование тегов пула его пакетами.
//
// Параметры:
//  Пул - Пул - пул раздела.
//  Кто - Строка - логин действующего: попадает в летопись.
//  Форма - Соответствие - разобранная форма галки.
//
// Возвращаемое значение:
//  Структура - Успех, Код, Сообщение, Отказы (см. Создать).
//
Функция ПереключитьНаследование(Знач Пул, Знач Кто, Знач Форма) Экспорт

	ТегиПула.УстановитьНаследование(Пул.Идентификатор,
		РазборФормы.Флажок(Форма, Поля.ОперацияГалки(), Поля.ЗначениеОтмечено()), Кто);
	Возврат Удача();

КонецФункции

// Заводит тег пула по форме окна «Новый тег».
//
// Параметры:
//  Пул - Пул - пул раздела.
//  Кто - Строка - логин действующего.
//  Форма - Соответствие - разобранная форма окна.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка — причина отказа словами,
//              заполнена у любого отказа), Отказы (Соответствие — имя поля -> отказ под полем).
//
Функция Создать(Знач Пул, Знач Кто, Знач Форма) Экспорт

	Набранное = Конструкторы.ИзФормы(Форма, РазборФормы.Поле(Форма, Поля.ИмяПоляИмени()));

	ОтказИмени = ОтказИмени(Пул, Набранное.Имя);
	Если ЗначениеЗаполнено(ОтказИмени) Тогда
		Возврат ОтбитоПолем(Поля.ИмяПоляИмени(), ОтказИмени);
	КонецЕсли;
	Возврат Записать(Пул, Набранное, Кто);

КонецФункции

// Сохраняет правку тега пула из окна «Изменить»; имя — из адреса, а не из тела.
//
// Параметры:
//  Пул - Пул - пул раздела.
//  ИмяТега - Строка - имя тега из адреса маршрута.
//  Кто - Строка - логин действующего.
//  Форма - Соответствие - разобранная форма окна.
//
// Возвращаемое значение:
//  Структура - см. Создать.
//
Функция Сохранить(Знач Пул, Знач ИмяТега, Знач Кто, Знач Форма) Экспорт

	ТегПула = ТегиПула.НайтиТегПула(Пул.Идентификатор, ИмяТега);
	Если ТегПула = Неопределено Тогда
		Возврат Отбито(Тексты.Шаблон("settings.pool.tags.error.missing", ИмяТега), 404);
	КонецЕсли;
	Возврат Записать(Пул, Конструкторы.ИзФормы(Форма, ТегПула.Имя), Кто);

КонецФункции

// Удаляет тег пула, если в эхо-поле подтверждения набрано его имя.
//
// Параметры:
//  Пул - Пул - пул раздела.
//  ИмяТега - Строка - имя тега из адреса маршрута.
//  Кто - Строка - логин действующего.
//  Форма - Соответствие - разобранная форма подтверждения.
//
// Возвращаемое значение:
//  Структура - см. Создать; несовпавшее эхо — отказ под эхо-полем, домен не зовётся.
//
Функция Удалить(Знач Пул, Знач ИмяТега, Знач Кто, Знач Форма) Экспорт

	ТегПула = ТегиПула.НайтиТегПула(Пул.Идентификатор, ИмяТега);
	Если ТегПула = Неопределено Тогда
		Возврат Отбито(Тексты.Шаблон("settings.pool.tags.error.missing", ИмяТега), 404);
	КонецЕсли;
	Если СокрЛП(РазборФормы.Поле(Форма, Поля.ИмяПоляЭха())) <> Строка(ТегПула.Имя) Тогда
		Возврат ОтбитоПолем(Поля.ИмяПоляЭха(), Тексты.Шаблон("settings.tags.delete.echo.mismatch", ТегПула.Имя));
	КонецЕсли;

	ТегиПула.УдалитьТегПула(Пул.Идентификатор, ТегПула.Имя, Кто);
	Возврат Удача();

КонецФункции

// Отказ, который сервер даст имени нового тега пула, — для проверки до отправки.
//
// Параметры:
//  Пул - Пул - пул раздела.
//  ИмяТега - Строка - набранное имя.
//
// Возвращаемое значение:
//  Строка - текст отказа; "" — имя годится.
//
Функция ОтказИмени(Знач Пул, Знач ИмяТега) Экспорт

	Если НЕ СервисТегов.ИмяДопустимо(ИмяТега) Тогда
		Возврат Тексты.Текст("settings.tags.error.name");
	КонецЕсли;
	Если ТегиПула.НайтиТегПула(Пул.Идентификатор, ИмяТега) <> Неопределено Тогда
		Возврат Тексты.Шаблон("settings.tags.error.exists", НРег(СокрЛП(ИмяТега)));
	КонецЕсли;
	Если ТегиПула.ИмяДляТегаПулаЗанято(Пул.Идентификатор, ИмяТега) Тогда
		Возврат Тексты.Текст("settings.pool.tags.error.version");
	КонецЕсли;
	Возврат "";

КонецФункции

#КонецОбласти

#Область Запись

// Вид и оформление — ключи закрытых списков: подделанное значение отбивается над полями,
// выражение — под своим полем.
Функция Записать(Знач Пул, Знач Набранное, Знач Кто)

	// ручного вида у тега пула нет: подделанный вид отбивается так же, как незнакомый
	Если НЕ Конструкторы.ВидДопустим(Набранное.Вид) ИЛИ Конструкторы.ЭтоРучной(Набранное) Тогда
		Возврат Отбито(Тексты.Текст("settings.pool.tags.error.kind"));
	КонецЕсли;
	Если НЕ Конструкторы.ОформлениеДопустимо(Набранное.ОформлениеФормы) Тогда
		Возврат Отбито(Тексты.Текст("settings.tags.error.look"));
	КонецЕсли;

	ПолеПравила = Поля.ИмяПоляПравила(Конструкторы.КодВида(Набранное.Режим, Набранное.Тип));
	Если НЕ ЗначениеЗаполнено(Набранное.Правило) Тогда
		Возврат ОтбитоПолем(ПолеПравила, Тексты.Текст("form.error.required"));
	КонецЕсли;

	Попытка
		ТегиПула.ОпределитьТегПула(Пул.Идентификатор, Набранное.Имя, Набранное.Тип, Набранное.Правило, Кто,
			Конструкторы.ПараОформления(Набранное));
	Исключение
		Возврат ОтбитоПолем(ПолеПравила, Тексты.Шаблон("settings.pool.tags.error.save",
			Сбои.Человеку(ИнформацияОбОшибке())));
	КонецПопытки;

	// основной снимается назначением другого тега — поэтому тумблер только назначает
	Если Набранное.ПоУмолчанию Тогда
		ТегиПула.НазначитьОсновным(Пул.Идентификатор, Набранное.Имя);
	КонецЕсли;
	ТегиПула.УстановитьЗапретПерезаписи(Пул.Идентификатор, Набранное.Имя, Набранное.ЗапретПерезаписи, Кто);

	Возврат Удача();

КонецФункции

#КонецОбласти

#Область Исход

Функция Удача()
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы", Истина, 200, "", Новый Соответствие());
КонецФункции

Функция Отбито(Знач Сообщение, Знач Код = 400)
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы", Ложь, Код, Строка(Сообщение),
		Новый Соответствие());
КонецФункции

Функция ОтбитоПолем(Знач ИмяПоля, Знач Текст)

	Отказы = Новый Соответствие();
	Отказы.Вставить(ИмяПоля, Строка(Текст));
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы", Ложь, 400, Строка(Текст), Отказы);

КонецФункции

#КонецОбласти

&Прозвище("ПультТеговПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисТеговПула") _ТегиПула,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "КонструкторТега") _Конструкторы,
	&Пластилин(Значение = "ПоляТега") _Поля,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	ТегиПула = _ТегиПула;
	СервисТегов = _СервисТегов;
	Конструкторы = _Конструкторы;
	Поля = _Поля;
	Сбои = _Сбои;
	Тексты = _Тексты;

КонецПроцедуры
