// Экран «pools/{pool}/settings/mirrors/{id}» дома «Пул»: как идёт прогон зеркала, что он успел
// и на что настроено само зеркало.

Перем Кит;     // Кит (кит) — фабрика элементов экрана
Перем Тексты;  // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Поля;    // ПоляЗеркала — протокол источника словами, общий со списками

#Область ПубличныйИнтерфейс

// Секции экрана состояния зеркала.
//
// Параметры:
//  Параметры - Структура:
//    * Зеркало - ЗеркалоХаба - зеркало, чьё состояние показывается;
//    * Протокол - Строка - протокол, которым хаб читает источник; пустая строка — удачной
//                 пробы ещё не было;
//    * Прогон - Структура - модель прогона (ПредставлениеПрогонаЗеркала.Модель);
//    * Происшествия - Структура - модель причин обхода (ПредставлениеПроисшествийЗеркала.Модель);
//    * АдресЭкрана - Строка - адрес самого экрана (кнопка «Обновить»);
//    * АдресСписка - Строка - адрес раздела зеркал;
//    * Обновление - Число - интервал авто-обновления, секунд.
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - секции: прогон, счётчики, причины обхода (когда есть что объяснить)
//                            и само зеркало.
//
Функция Секции(Знач Параметры) Экспорт

	Результат = Новый Массив();
	Результат.Добавить(СекцияПрогона(Параметры));
	Результат.Добавить(СекцияСчётчиков(Параметры.Прогон));
	// причин нет — секции нет: пустая таблица «почему не приехало» читается как поломка
	Если ЕстьЧтоОбъяснить(Параметры.Происшествия) Тогда
		Результат.Добавить(СекцияПричин(Параметры.Происшествия));
	КонецЕсли;
	Результат.Добавить(СекцияЗеркала(Параметры));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Прогон

// Справа в шапке — заявка на синхронизацию формой из одной кнопки и «Обновить» ссылкой на экран.
Функция СекцияПрогона(Знач Параметры)

	Прогон = Параметры.Прогон;

	Возврат Кит.Секция(Тексты.Текст("settings.pool.mirror-status.run.title"),
			ШкалаОбхода(Прогон),
			Кит.Свойства(
				Кит.Свойство(Тексты.Текст("settings.pool.mirror-status.field.state"),
					Кит.Плашка(Прогон.Подпись).Вид(Прогон.Вид)),
				СвойствоСПрочерком(Тексты.Текст("settings.pool.mirror-status.field.crawl"), СпособОбхода(Прогон)),
				СвойствоСПрочерком(Тексты.Текст("settings.pool.mirror-status.field.started"), Прогон.Начат),
				СвойствоСПрочерком(Тексты.Текст("settings.pool.mirror-status.field.updated"), Прогон.Обновлён),
				СвойствоСПрочерком(Тексты.Текст("settings.pool.mirror-status.field.cursor"), Прогон.Курсор),
				СвойствоСПрочерком(Тексты.Текст("settings.pool.mirror-status.field.by"), ИнициаторПрогона(Прогон))),
			ОбещаниеСамообновления(Параметры))
		.Лид(Тексты.Текст("settings.pool.mirror-status.run.lead")).Иконка("часы")
		.Действия(
			Кит.Форма(Ключ(Параметры.Зеркало) + "/sync",
				Кит.Кнопка(Тексты.Текст("settings.pool.mirrors.button.sync")).Основная().Иконка("стрелка")),
			Кит.Кнопка(Тексты.Текст("settings.pool.mirror-status.refresh.button")).Вторичная().Иконка("история")
				.Адрес(Параметры.АдресЭкрана));

КонецФункции

// Печатается только у сосчитанного апстрима: без общего числа имён пустая шкала врала бы.
Функция ШкалаОбхода(Знач Прогон)

	Если Прогон.ИмёнВсего <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.ПолосаЗаполнения(Прогон.Процент, Тексты.Текст("settings.pool.mirror-status.progress.label"))
		.Подпись(Тексты.Шаблон("settings.pool.mirror-status.progress.caption",
			Тексты.ЧислоТекстом(Прогон.ИмёнПройдено), Тексты.ЧислоТекстом(Прогон.ИмёнВсего)))
		.Вид(?(Прогон.Код = "ошибка", "err", "ok"));

КонецФункции

// Чем этот проход отличается по цене от прошлого: инкремент против полного перечисления.
Функция СпособОбхода(Знач Прогон)

	Возврат ?(ЗначениеЗаполнено(Прогон.СрезС),
		Тексты.Шаблон("settings.pool.mirror-status.crawl.increment", Прогон.СрезС),
		Тексты.Текст("settings.pool.mirror-status.crawl.full"));

КонецФункции

Функция ИнициаторПрогона(Знач Прогон)
	Возврат ?(ЗначениеЗаполнено(Прогон.Запустил), Прогон.Запустил,
		Тексты.Текст("settings.pool.mirror-status.field.by-schedule"));
КонецФункции

// Только у незакрытого прогона: у остановленного зеркала обещание было бы неправдой.
Функция ОбещаниеСамообновления(Знач Параметры)

	Если НЕ Параметры.Прогон.Активен Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Примечание(Тексты.Шаблон("settings.pool.mirror-status.refresh.note",
		Тексты.ЧислоТекстом(Параметры.Обновление)));

КонецФункции

#КонецОбласти

#Область Счётчики

// Счётчики — колонкой чисел: по правому краю, цифры одной ширины.
Функция СекцияСчётчиков(Знач Прогон)

	Возврат Кит.Секция(Тексты.Текст("settings.pool.mirror-status.counters.title"),
			ТаблицаСчётчиков(Прогон))
		.Лид(Тексты.Текст("settings.pool.mirror-status.counters.lead")).Иконка("скачать");

КонецФункции

// Имена и версии — разные величины: у одного имени бывает много версий.
Функция ТаблицаСчётчиков(Знач Прогон)

	Строки = Новый Массив();
	Строки.Добавить(Счётчик(Тексты.Текст("settings.pool.mirror-status.count.names"), Прогон.ИмёнВсего));
	Строки.Добавить(Счётчик(Тексты.Текст("settings.pool.mirror-status.count.names-done"), Прогон.ИмёнПройдено));
	Строки.Добавить(Счётчик(Тексты.Текст("settings.pool.mirror-status.count.total"), Прогон.Всего));
	Строки.Добавить(Счётчик(Тексты.Текст("settings.pool.mirror-status.count.downloaded"), Прогон.Скачано));
	Строки.Добавить(Счётчик(Тексты.Текст("settings.pool.mirror-status.count.skipped"), Прогон.Пропущено));
	Строки.Добавить(Счётчик(Тексты.Текст("settings.pool.mirror-status.count.errors"), Прогон.Ошибок));
	Строки.Добавить(Счётчик(Тексты.Текст("settings.pool.mirror-status.count.unavailable"), Прогон.Недоступно));

	Таблица = Кит.Таблица(Строки);
	Таблица.Колонка("metric", Тексты.Текст("settings.pool.mirror-status.col.metric"));
	Таблица.Колонка("value", Тексты.Текст("settings.pool.mirror-status.col.value")).Вид("число");
	Возврат Таблица;

КонецФункции

Функция Счётчик(Знач Подпись, Знач Значение)
	Возврат Новый Структура("metric, value", Подпись, Тексты.ЧислоТекстом(Значение));
КонецФункции

#КонецОбласти

#Область Причины

// Нечитаемые причины — тоже новость: неизвестность не выдаётся за «всё в порядке».
Функция ЕстьЧтоОбъяснить(Знач Происшествия)
	Возврат НЕ Происшествия.Прочитано ИЛИ Происшествия.Строки.Количество() > 0;
КонецФункции

Функция СекцияПричин(Знач Происшествия)

	Если Происшествия.Прочитано Тогда
		Тело = ТаблицаПричин(Происшествия.Строки);
	Иначе
		Тело = Кит.Примечание(Тексты.Текст("settings.pool.mirror-status.reasons.unreadable"));
	КонецЕсли;

	Возврат Кит.Секция(Тексты.Текст("settings.pool.mirror-status.reasons.title"), Тело)
		.Лид(Тексты.Текст("settings.pool.mirror-status.reasons.lead")).Иконка("предупреждение");

КонецФункции

// На узком экране — карточки с пакетом заглавием; пустое — прочерком кита.
Функция ТаблицаПричин(Знач Происшествия)

	Строки = Новый Массив();
	Для Каждого Происшествие Из Происшествия Цикл
		Строки.Добавить(Новый Структура("subject, reason, outcome, count, last",
			Предмет(Происшествие), ПричинаСловами(Происшествие), Исход(Происшествие),
			Тексты.ЧислоТекстом(Происшествие.Повторов), Строка(Происшествие.Последний)));
	КонецЦикла;

	Таблица = Кит.Таблица(Строки).Вид("карточками").Пустое(Прочерк());
	Таблица.Колонка("subject", Тексты.Текст("settings.pool.mirror-status.reasons.col.subject")).Заглавная();
	Таблица.Колонка("reason", Тексты.Текст("settings.pool.mirror-status.reasons.col.reason"));
	Таблица.Колонка("outcome", Тексты.Текст("settings.pool.mirror-status.reasons.col.outcome"));
	Таблица.Колонка("count", Тексты.Текст("settings.pool.mirror-status.reasons.col.count")).Вид("число");
	Таблица.Колонка("last", Тексты.Текст("settings.pool.mirror-status.reasons.col.last"));
	Возврат Таблица;

КонецФункции

// У раннего выхода предмета нет: не взята не версия, а весь обход. У сводки — прочерк.
Функция Предмет(Знач Происшествие)

	Если Происшествие.Сводка Тогда
		Возврат "";
	КонецЕсли;
	Возврат ?(ЗначениеЗаполнено(Происшествие.Предмет), Строка(Происшествие.Предмет),
		Тексты.Текст("settings.pool.mirror-status.reasons.whole-run"));

КонецФункции

// Сводку переполнения человек читает счётчиком, а не фразой летописи про потолок.
Функция ПричинаСловами(Знач Происшествие)

	Если Происшествие.Сводка Тогда
		Возврат Тексты.Шаблон("settings.pool.mirror-status.reasons.more",
			Тексты.ЧислоТекстом(Происшествие.Повторов));
	КонецЕсли;
	Возврат Строка(Происшествие.Причина);

КонецФункции

// «Пройдёт следующим заходом», «пропущено насовсем» или «неясно»: незнание не печатается как «насовсем».
Функция Исход(Знач Происшествие)

	Если Происшествие.ИсходНеясен Тогда
		Возврат Кит.Плашка(Тексты.Текст("settings.pool.mirror-status.reasons.unclear"));
	ИначеЕсли Происшествие.Устранимо Тогда
		Возврат Кит.Плашка(Тексты.Текст("settings.pool.mirror-status.reasons.retry")).Вид("warn");
	КонецЕсли;
	Возврат Кит.Плашка(Тексты.Текст("settings.pool.mirror-status.reasons.final")).Вид("err");

КонецФункции

#КонецОбласти

#Область СамоЗеркало

Функция СекцияЗеркала(Знач Параметры)

	Зеркало = Параметры.Зеркало;
	Прогон = Параметры.Прогон;
	Адрес = Строка(Зеркало.АпстримURL);

	Возврат Кит.Секция(Тексты.Текст("settings.pool.mirror-status.mirror.title"),
			Кит.Свойства(
				Кит.Свойство(Тексты.Текст("settings.pool.mirror-status.field.upstream"), Кит.Код(Адрес))
					.Копируемое(Адрес),
				// протокола человек не выбирал: свойство называет наблюдение хаба — чем источник прочитан
				СвойствоСПрочерком(Тексты.Текст("settings.pool.mirror-status.field.protocol"), Поля.ПротоколСловами(Параметры.Протокол)),
				СвойствоСПрочерком(Тексты.Текст("settings.pool.mirror-status.field.interval"), Тексты.ЧислоТекстом(Зеркало.ИнтервалСинкаСек)),
				Кит.Свойство(Тексты.Текст("settings.pool.mirror-status.field.enabled"), Включённость(Зеркало)),
				СвойствоСПрочерком(Тексты.Текст("settings.pool.mirror-status.field.last-sync"), Прогон.ПоследнийСинк),
				СвойствоСПрочерком(Тексты.Текст("settings.pool.mirror-status.field.result"), Прогон.Итог)),
			Кит.Кнопка(Тексты.Текст("settings.pool.mirror-status.back")).Ссылкой().Иконка("влево")
				.Адрес(Параметры.АдресСписка))
		.Лид(Тексты.Текст("settings.pool.mirror-status.mirror.lead")).Иконка("ссылка");

КонецФункции

Функция Включённость(Знач Зеркало)

	Если Зеркало.Включено = Истина Тогда
		Возврат Кит.Плашка(Тексты.Текст("settings.pool.mirrors.state.on")).Вид("ok");
	КонецЕсли;
	Возврат Кит.Плашка(Тексты.Текст("settings.pool.mirrors.state.off")).Вид("warn");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Значение — данные прогона узлом текста; незаполненное печатается прочерком: пустое место
// читается как «показателя нет».
Функция СвойствоСПрочерком(Знач Подпись, Знач Значение)
	Возврат Кит.Свойство(Подпись,
		Кит.Текст(?(ЗначениеЗаполнено(Значение), Строка(Значение), Прочерк())));
КонецФункции

Функция Прочерк()
	Возврат Тексты.Текст("settings.pool.mirror-status.empty");
КонецФункции

Функция Ключ(Знач Зеркало)
	Возврат Формат(Зеркало.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

#КонецОбласти

&Прозвище("ВитринаСостоянияЗеркала")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПоляЗеркала") _Поля) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	Поля = _Поля;

КонецПроцедуры
