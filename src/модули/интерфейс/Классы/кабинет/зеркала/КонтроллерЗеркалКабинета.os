// Зеркала пулов в кабинете (/office/mirrors): обзор пулов назначения и зеркала пула — заведение
// окном, заявка на синхронизацию, выключение и включение, удаление с подтверждением по адресу.

Перем Гвард;         // ГвардКабинета
Перем Защита;        // ЗащитаCSRF (вход) — токен сессии в форму
Перем СервисПулов;   // СервисПулов (реестр)
Перем СервисПрав;    // СервисПрав (права)
Перем СлужбаКабинета;// СлужбаКабинета (кабинет) — пулы в распоряжении смотрящего
Перем Витрина;       // ВитринаЗеркалКабинета
Перем Ответы;        // ОтветыНастроек — страница и типовые отказы
Перем Пульт;         // ПультЗеркалПула — заведение, переключение, удаление с эхом и заявка на синк
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем HTTP;          // МетодыHTTP (основа) — сравнение метода запроса
Перем Ссылки;        // ПараметрыСсылки (основа) — параметр запроса на адресе
Перем Адреса;        // АдресаКабинета — адреса сводки зеркал
Перем Окна;          // ОкноРаздела — окно по адресу и ответы форм окон

#Область ТочкиМаршрута

// GET /office/mirrors — обзор зеркал пулов в распоряжении смотрящего.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//
&ТочкаМаршрута("mirrors")
Процедура Индекс(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Ответы.ОтдатьСтраницу(Ответ, Тексты.Текст("office.mirrors.title"),
		Витрина.Обзор(СлужбаКабинета.ПулыВРаспоряжении(Вердикт.Пользователь)),
		Вердикт, КукиЗапроса, 200, Неопределено, Адреса.Зеркала());

КонецПроцедуры

// GET /office/mirrors/{pool} — зеркала пула, POST — форма окна «Новое зеркало».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  sync - Строка - итог запуска синхронизации из адреса: "1" заявка принята, "running" прогон
//         уже идёт, "queued" зеркало уже ждёт очереди, "disabled" синхронизация выключена,
//         "rejected" заявка отклонена (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: <вид>-<номер зеркала> (необязательный, по умолчанию "").
//
&ТочкаМаршрута("mirrors/{pool}")
Процедура Пул(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, sync = "",
	окно = "") Экспорт

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьСписок(Ответ, Контекст, БаннерыСинка(sync), КукиЗапроса, 200,
			Окна.ИзАдреса(окно, Витрина.ВидыОкон()));
		Возврат;
	КонецЕсли;
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Контекст, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Контекст, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Завершить(Ответ, Контекст, КукиЗапроса, Пульт.Создать(Контекст.Пользователь, Контекст.Пул, Форма),
		"новый", "", Форма);

КонецПроцедуры

// POST /office/mirrors/{pool}/{id}/delete — удаление зеркала. Без поля подтверждения (форма ушла
// без скрипта) зеркало не удаляется: ответ ведёт на страницу с открытым подтверждением.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("mirrors/{pool}/{id}/delete")
Процедура Удаление(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = ПодготовитьМутацию(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Окна.Подтверждено(Контекст.Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, Адреса.ЗеркалаПула(Контекст.Пул.Имя), id);
		Возврат;
	КонецЕсли;
	Завершить(Ответ, Контекст, КукиЗапроса,
		Пульт.Удалить(Контекст.Пользователь, Контекст.Пул, id, Контекст.Форма), "удалить", id, Контекст.Форма);

КонецПроцедуры

// POST /office/mirrors/{pool}/{id}/toggle — выключение и включение зеркала: форма несёт желаемое
// состояние, повтор её не переворачивает.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("mirrors/{pool}/{id}/toggle")
Процедура Переключение(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = ПодготовитьМутацию(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Контекст, КукиЗапроса,
		Пульт.Переключить(Контекст.Пользователь, Контекст.Пул, id, Контекст.Форма), "", id, Контекст.Форма);

КонецПроцедуры

// POST /office/mirrors/{pool}/{id}/sync — заявка на синхронизацию; итог едет параметром sync.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("mirrors/{pool}/{id}/sync")
Процедура Синхронизация(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = ПодготовитьМутацию(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Зеркало = Пульт.ЗеркалоПула(Контекст.Пул, id);
	Если Зеркало = Неопределено Тогда
		Ответ.Перенаправить(Адреса.ЗеркалаПула(Контекст.Пул.Имя));
		Возврат;
	КонецЕсли;

	// выключенная синхронизация — тоже итог заявки словами страницы, а не отказ без адреса
	Исход = Пульт.Синхронизировать(Контекст.Пользователь, Контекст.Пул, id);
	Код = ?(Исход.Успех, Исход.КодЗаявки, "disabled");
	Ответ.Перенаправить(Ссылки.Установить(Адреса.ЗеркалаПула(Контекст.Пул.Имя), "sync", Код));

КонецПроцедуры

#КонецОбласти

#Область Действия

// Исход пульта → ответ: удача — на страницу пула; отказ — страница с окном этой формы, открытым
// на набранном и отказах; окна нет (зеркало уже удалили, переключение) — уведомлением над списком.
Процедура Завершить(Ответ, Знач Контекст, Знач КукиЗапроса, Знач Исход, Знач ВидОкна, Знач Номер,
	Знач Форма)

	Если Исход.Успех Тогда
		Окна.ВернутьВРаздел(Ответ, Адреса.ЗеркалаПула(Контекст.Пул.Имя));
		Возврат;
	КонецЕсли;

	Окно = Окна.Отбитое(ВидОкна, Номер, Форма, Исход.Отказы,
		?(Исход.Отказы.Количество() > 0, "", Исход.Сообщение));
	Если ЗначениеЗаполнено(ВидОкна) И Витрина.ЕстьОкно(Контекст.Пул, Окно) Тогда
		ОтдатьСписок(Ответ, Контекст, Новый Массив(), КукиЗапроса, Исход.Код, Окно);
		Возврат;
	КонецЕсли;
	ОтдатьСписок(Ответ, Контекст, Баннеры(Исход.Сообщение, "err"), КукиЗапроса, Исход.Код);

КонецПроцедуры

#КонецОбласти

#Область ОбщаяЛогика

// Гвард + резолв пула + проверка права администрирования.
Функция Подготовить(Ответ, Знач pool, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Пользователь = Вердикт.Пользователь;

	Пул = СервисПулов.НайтиПул(pool);
	// приватный пул, которого смотрящий не видит, неотличим от несуществующего
	Если Пул <> Неопределено И НЕ СервисПрав.МожетЧитать(Пользователь, Пул) Тогда
		Пул = Неопределено;
	КонецЕсли;
	Если Пул = Неопределено Тогда
		// pool идёт сырым: экранирует ОтдатьНеНайдено, иначе экранировали бы дважды
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт,
			Тексты.Шаблон("office.mirrors.error.pool-notfound", pool), КукиЗапроса,
			Новый Структура("Адрес, Подпись", Адреса.Зеркала(),
				Тексты.Текст("office.mirrors.back")));
		Возврат Неопределено;
	КонецЕсли;

	// зеркалами пула распоряжается только владелец/админ пула — на КАЖДОМ действии
	Если НЕ СервисПрав.МожетАдминистрировать(Пользователь, Пул) Тогда
		Ответы.ОтдатьЗапрещено(Ответ, Вердикт, Тексты.Текст("office.mirrors.error.forbidden"),
			КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("Пользователь", Пользователь);
	Результат.Вставить("Сессия", Вердикт.Сессия);
	Результат.Вставить("Пул", Пул);
	Возврат Результат;

КонецФункции

// Подготовка мутации: Подготовить + требование POST + проверка CSRF (+ поле Форма).
Функция ПодготовитьМутацию(Ответ, Знач pool, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "POST", Контекст, КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;
	Форма = Пульт.Форма(Ответ, Контекст, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Контекст.Вставить("Форма", Форма);
	Возврат Контекст;

КонецФункции

Функция БаннерыСинка(Знач sync)

	Если sync = "1" Тогда
		Возврат Баннеры(Тексты.Текст("office.mirrors.sync.started"), "ok");
	ИначеЕсли sync = "running" Тогда
		Возврат Баннеры(Тексты.Текст("office.mirrors.sync.running"), "warn");
	ИначеЕсли sync = "queued" Тогда
		Возврат Баннеры(Тексты.Текст("office.mirrors.sync.queued"), "warn");
	ИначеЕсли sync = "disabled" Тогда
		Возврат Баннеры(Тексты.Текст("office.mirrors.sync.disabled"), "err");
	ИначеЕсли sync = "rejected" Тогда
		Возврат Баннеры(Тексты.Текст("office.mirrors.sync.rejected"), "err");
	КонецЕсли;

	Возврат Новый Массив();

КонецФункции

Функция Баннеры(Знач Текст, Знач Вид)

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Текст, Вид", Текст, Вид));
	Возврат Результат;

КонецФункции

Процедура ОтдатьСписок(Ответ, Знач Контекст, Знач БаннерыСтраницы, Знач КукиЗапроса,
	Знач Статус = 200, Знач Окно = Неопределено)

	Параметры = Новый Структура("Пул, Токен, Баннеры, Окно", Контекст.Пул,
		Защита.ТокенСессии(Контекст.Сессия), БаннерыСтраницы, Окно);

	Ответы.ОтдатьСтраницу(Ответ, Тексты.Шаблон("office.mirrors.pool.title", Контекст.Пул.Имя),
		Витрина.Список(Параметры), Контекст, КукиЗапроса, Статус, Неопределено,
		Адреса.ЗеркалаПула(Контекст.Пул.Имя));

КонецПроцедуры

#КонецОбласти

&Контроллер("/office")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _Гвард,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СлужбаКабинета") _СлужбаКабинета,
	&Пластилин(Значение = "ВитринаЗеркалКабинета") _Витрина,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ПультЗеркалПула") _Пульт,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "АдресаКабинета") _Адреса,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ПараметрыСсылки") _Ссылки = Неопределено)

	Гвард = _Гвард;
	Защита = _Защита;
	СервисПулов = _СервисПулов;
	СервисПрав = _СервисПрав;
	СлужбаКабинета = _СлужбаКабинета;
	Витрина = _Витрина;
	Ответы = _Ответы;
	Пульт = _Пульт;
	Тексты = _Тексты;
	HTTP = _HTTP;
	Адреса = _Адреса;
	Окна = _Окна;
	Ссылки = ?(_Ссылки = Неопределено, Новый ПараметрыСсылки(), _Ссылки);

КонецПроцедуры
