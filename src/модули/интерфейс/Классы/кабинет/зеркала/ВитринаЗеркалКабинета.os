// Обзор зеркал /office/mirrors и зеркала одного пула /office/mirrors/{pool}: страницы вне дома
// настроек — свой заголовок, свои уведомления; зеркала пула — таблица с меню ⚙ строки, окно
// нового зеркала на странице, подтверждение удаления — по адресу ?окно=удалить-<номер>.

Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем СервисЗеркал;  // СервисЗеркал (зеркала) — список зеркал и протокол источника
Перем Прогоны;       // ПредставлениеПрогонаЗеркала — прогон в виде для экрана
Перем ДомПула;       // ДомПула — адрес экрана состояния зеркала и раздела зеркал пула
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Поля;          // ПоляЗеркала — флажок переноса и протокол словами, общие с домом пула
Перем ИменаПолей;    // ПультЗеркал — имена полей формы зеркала
Перем Пульт;         // ПультЗеркалПула — эхо удаления
Перем Окна;          // ОкноРаздела — окно по адресу и его состояние
Перем Адреса;        // АдресаКабинета — адреса сводки зеркал

#Область ПубличныйИнтерфейс

// Виды окон страницы зеркал пула, которые открывает адрес ?окно=<вид>-<номер зеркала>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат "новый,удалить";
КонецФункции

// Обзор пулов назначения.
//
// Параметры:
//  Пулы - Массив из Пул - пулы, зеркалами которых распоряжается пользователь.
//
// Возвращаемое значение:
//  ЭлементЭкрана - содержимое страницы обзора.
//
Функция Обзор(Знач Пулы) Экспорт

	Возврат Кит.Холст(
		Кит.ЗаголовокСтраницы(Тексты.Текст("office.mirrors.title"))
			.Пояснение(Тексты.Текст("office.mirrors.lead")),
		Кит.Секция(Тексты.Текст("office.mirrors.pools.title"), ТаблицаПулов(Пулы)).Иконка("куб"));

КонецФункции

// Зеркала одного пула: таблица, окно нового зеркала и окно, названное адресом.
//
// Параметры:
//  Параметры - Структура:
//    * Пул - Пул - пул назначения;
//    * Токен - Строка - CSRF-токен сессии;
//    * Баннеры - Массив из Структура - уведомления (Текст, Вид) над содержимым;
//    * Окно - Структура, Неопределено - состояние открытого окна (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  ЭлементЭкрана - содержимое страницы.
//
Функция Список(Знач Параметры) Экспорт

	Пул = Параметры.Пул;
	Адрес = Адреса.ЗеркалаПула(Пул.Имя);
	Состояние = Параметры.Окно;
	Зеркала = СервисЗеркал.СписокПула(Пул.Идентификатор);
	ОкноЗаведения = ОкноЗаведения(Адрес, Состояние);

	Страница = Кит.Холст(
		Кит.ЗаголовокСтраницы(Тексты.Шаблон("office.mirrors.pool.title", Пул.Имя))
			.Пояснение(Тексты.Текст("office.mirrors.pool.lead")),
		Уведомления(Параметры.Баннеры),
		Кит.Секция(Тексты.Текст("office.mirrors.list.title"),
				ТаблицаЗеркал(Пул, Зеркала, Адрес),
				ОкноЗаведения,
				ОткрытоеОкно(Зеркала, Состояние, Адрес))
			.Лид(Тексты.Текст("office.mirrors.list.lead")).Иконка("копировать")
			.Действия(Кит.Кнопка(Тексты.Текст("settings.pool.mirrors.add")).Основная().Иконка("плюс")
				.Открывает(ОкноЗаведения)));
	Возврат Страница.Токен(Параметры.Токен);

КонецФункции

// Напечатает ли страница окно, которое называет состояние: окно нового зеркала — всегда,
// подтверждение удаления — когда зеркало с таким номером у пула есть.
//
// Параметры:
//  Пул - Пул - пул назначения.
//  Состояние - Структура, Неопределено - состояние окна (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Пул, Знач Состояние) Экспорт
	Возврат Окна.Открыто(Состояние, "новый")
		ИЛИ ЗеркалоОкна(СервисЗеркал.СписокПула(Пул.Идентификатор), Состояние) <> Неопределено;
КонецФункции

#КонецОбласти

#Область ОбзорПулов

// Пул — ссылкой на его зеркала; ни одного пула — пустое состояние со словами, а не пустая таблица.
Функция ТаблицаПулов(Знач Пулы)

	Строки = Новый Массив();
	Для Каждого Пул Из Пулы Цикл
		Строки.Добавить(Новый Структура("name, home",
			Кит.Ссылка(Адреса.ЗеркалаПула(Пул.Имя), Кит.Текст(Строка(Пул.Имя))),
			Кит.Ссылка(ДомПула.АдресРаздела(Пул.Имя, "mirrors"), Тексты.Текст("office.mirrors.pools.home"))));
	КонецЦикла;

	Таблица = Кит.Таблица(Строки).Вид("карточками")
		.Пусто(Кит.ПустоеСостояние(Тексты.Текст("office.mirrors.pools.empty.lead"))
			.Заголовок(Тексты.Текст("office.mirrors.pools.empty.title")).Иконка("куб").Компактное());
	Таблица.Колонка("name", Тексты.Текст("office.mirrors.pools.col.name")).Заглавная();
	Таблица.Колонка("home", Тексты.Текст("office.mirrors.pools.col.home")).БезПодписиВЗаписи();
	Возврат Таблица;

КонецФункции

#КонецОбласти

#Область Таблица

// Итог нажатой «синхронизации» приезжает адресом и печатается над содержимым.
Функция Уведомления(Знач Баннеры)

	Полоса = Кит.Холст();
	Для Каждого Баннер Из Баннеры Цикл
		Полоса.Добавить(Кит.Уведомление(Баннер.Текст).Вид(Баннер.Вид));
	КонецЦикла;
	Возврат Полоса;

КонецФункции

// На узком экране — карточки с адресом апстрима заглавием и ⚙ в углу; ни одного зеркала —
// пустое состояние, как у списка пулов.
Функция ТаблицаЗеркал(Знач Пул, Знач Зеркала, Знач Адрес)

	Строки = Новый Массив();
	Для Каждого Зеркало Из Зеркала Цикл
		Строки.Добавить(СтрокаЗеркала(Пул, Зеркало, Адрес));
	КонецЦикла;

	Таблица = Кит.Таблица(Строки).Вид("карточками").Пустое("—")
		.Пусто(Кит.ПустоеСостояние(Тексты.Текст("office.mirrors.empty")).Иконка("копировать").Компактное());
	Таблица.Колонка("upstream", Тексты.Текст("office.mirrors.col.upstream")).Заглавная();
	Таблица.Колонка("protocol", Тексты.Текст("office.mirrors.col.protocol"));
	Таблица.Колонка("state", Тексты.Текст("office.mirrors.col.state"));
	Таблица.Колонка("run", Тексты.Текст("office.mirrors.col.run"));
	Таблица.Колонка("sync", Тексты.Текст("office.mirrors.col.sync"));
	Таблица.Колонка("actions", "").Вид("узкая").БезПодписиВЗаписи();
	Возврат Таблица;

КонецФункции

Функция СтрокаЗеркала(Знач Пул, Знач Зеркало, Знач Адрес)

	Прогон = Прогоны.Модель(Зеркало, СервисЗеркал.ПрогонБрошен(Зеркало));
	Возврат Новый Структура("upstream, protocol, state, run, sync, actions",
		Кит.Код(Строка(Зеркало.АпстримURL)),
		Протокол(Зеркало),
		Включённость(Зеркало),
		// детальный экран состояния живёт в доме пула: кабинет второго дома настроек не заводит
		Кит.Плашка(Прогон.Подпись).Вид(Прогон.Вид).Адрес(ДомПула.АдресРаздела(Пул.Имя, "mirrors") + "/" + Ключ(Зеркало)),
		// момент уже написан ДатаЧеловеку в модели прогона — одно написание на весь интерфейс
		?(ЗначениеЗаполнено(Прогон.ПоследнийСинк), Прогон.ПоследнийСинк, Тексты.Текст("office.mirrors.sync.never")),
		Меню(Зеркало, Адрес));

КонецФункции

// Чем хаб читает источник, а у переносящего зеркала — ещё и слово о переносе.
Функция Протокол(Знач Зеркало)

	Слова = Кит.Текст(Поля.ПротоколСловами(СервисЗеркал.Протокол(Зеркало)));
	Если Зеркало.Перенос <> Истина Тогда
		Возврат Слова;
	КонецЕсли;
	Возврат Кит.Холст(Слова, Кит.Текст(" "),
		Кит.Плашка(Тексты.Текст("settings.pool.mirrors.protocol.migrate")).Вид("ok"));

КонецФункции

Функция Включённость(Знач Зеркало)

	Если Зеркало.Включено = Истина Тогда
		Возврат Кит.Плашка(Тексты.Текст("office.mirrors.state.on")).Вид("ok");
	КонецЕсли;
	Возврат Кит.Плашка(Тексты.Текст("office.mirrors.state.off")).Вид("warn");

КонецФункции

// Синхронизация — заявка формой из одной кнопки; выключение и включение — форма с желаемым
// состоянием (повтор не переворачивает); удаление — подтверждение по адресу.
Функция Меню(Знач Зеркало, Знач Адрес)

	Включено = (Зеркало.Включено = Истина);
	Адресом = Строка(Зеркало.АпстримURL);

	Возврат Кит.Меню(Тексты.Шаблон("office.mirrors.menu", Адресом),
		Кит.Форма(Хвост(Адрес, Зеркало, "sync"),
			Кит.Кнопка(Тексты.Текст("office.mirrors.button.sync")).Иконка("стрелка")).Вид("меню"),
		Кит.Форма(Хвост(Адрес, Зеркало, "toggle"),
			Кит.СкрытоеПоле("включить", ?(Включено, "0", "1")),
			Кит.Кнопка(?(Включено, Тексты.Текст("office.mirrors.button.disable"),
				Тексты.Текст("office.mirrors.button.enable"))).Иконка(?(Включено, "закрыть", "галочка"))).Вид("меню"),
		Кит.ОкноПоАдресу(Окна.Адрес(Адрес, "удалить", Ключ(Зеркало)), Тексты.Текст("office.mirrors.button.delete"))
			.Опасная().Иконка("корзина"));

КонецФункции

#КонецОбласти

#Область Окна

// Окно «Новое зеркало»: на странице всегда, открытым — по адресу или с отбитой формой; ошибка
// пробы подключения приходит к полю адреса.
Функция ОкноЗаведения(Знач Адрес, Знач Состояние)

	Якорь = "zerkalo-novoe";
	Открыто = Окна.Открыто(Состояние, "новый");
	Возврат Кит.Окно(Тексты.Текст("settings.pool.mirrors.window.new"),
			ОшибкаОкна(Состояние),
			Кит.Поле(ИменаПолей.ИмяПоляАдреса(), Тексты.Текст("settings.pool.mirrors.field.url"))
				.ТипЗначения("url").Обязательное()
				.Пример(Тексты.Текст("settings.pool.mirrors.field.url.example"))
				.Значение(Окна.Значение(Состояние, ИменаПолей.ИмяПоляАдреса()))
				.Ошибка(Окна.Отказ(Состояние, ИменаПолей.ИмяПоляАдреса())),
			Кит.Поле(ИменаПолей.ИмяПоляТокена(), Тексты.Текст("settings.pool.mirrors.field.token")).Секрет()
				.Подсказка(Тексты.Текст("settings.pool.mirrors.field.token.hint"))
				.Ошибка(Окна.Отказ(Состояние, ИменаПолей.ИмяПоляТокена())),
			Кит.Поле(ИменаПолей.ИмяПоляФильтра(), Тексты.Текст("settings.pool.mirrors.field.filter")).Список()
				.Значение(Окна.Значение(Состояние, ИменаПолей.ИмяПоляФильтра()))
				.Подсказка(Тексты.Текст("settings.pool.mirrors.field.filter.hint"))
				.Ошибка(Окна.Отказ(Состояние, ИменаПолей.ИмяПоляФильтра())),
			Кит.Поле(ИменаПолей.ИмяПоляИнтервала(), Тексты.Текст("settings.pool.mirrors.field.interval"))
				.ТипЗначения(Тип("Число")).Пример("3600")
				.Значение(Окна.Значение(Состояние, ИменаПолей.ИмяПоляИнтервала()))
				.Ошибка(Окна.Отказ(Состояние, ИменаПолей.ИмяПоляИнтервала())),
			Поля.ФлажокПереноса(Окна.Отмечено(Состояние, ИменаПолей.ИмяПоляПереноса(), Ложь)))
		.Форма(Адрес).БезПерезагрузки().Якорь(Якорь).Адрес(Окна.Адрес(Адрес, "новый"))
		.Открыто(Открыто).АдресЗакрытия(Адрес)
		.Действия(Кит.Кнопка(Тексты.Текст("settings.pool.mirror-new.button")).Основная().Иконка("плюс"));

КонецФункции

// Подтверждение удаления, названное адресом. Зеркала с таким номером нет — страница без окна.
Функция ОткрытоеОкно(Знач Зеркала, Знач Состояние, Знач Адрес)

	Зеркало = ЗеркалоОкна(Зеркала, Состояние);
	Если Зеркало = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Образец = Пульт.ОбразецЭха(Зеркало);
	Возврат Кит.Подтверждение(Тексты.Текст("settings.pool.mirrors.delete.title"),
			Тексты.Шаблон("settings.pool.mirrors.delete.consequence", Зеркало.АпстримURL),
			ОшибкаОкна(Состояние))
		.Эхо(Пульт.ИмяПоляЭха(), Образец, Тексты.Шаблон("settings.pool.mirrors.delete.echo", Образец))
		.Кнопка(Тексты.Текст("office.mirrors.button.delete"))
		.Ошибка(Окна.Отказ(Состояние, Пульт.ИмяПоляЭха()))
		.Форма(Хвост(Адрес, Зеркало, "delete")).БезПерезагрузки().Якорь("zerkalo-udalit").Открыто()
		.АдресЗакрытия(Адрес);

КонецФункции

Функция ЗеркалоОкна(Знач Зеркала, Знач Состояние)

	Если НЕ Окна.Открыто(Состояние, "удалить") ИЛИ НЕ ЗначениеЗаполнено(Состояние.Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Зеркало Из Зеркала Цикл
		Если Ключ(Зеркало) = Состояние.Ключ Тогда
			Возврат Зеркало;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Отказ домена, который не относится к одному полю, — над полями.
Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Ключ(Знач Зеркало)
	Возврат Формат(Зеркало.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

// Адрес формы зеркала: «<страница пула>/<номер>/<действие>» — страница вне дома, адрес от корня.
Функция Хвост(Знач Адрес, Знач Зеркало, Знач Действие)
	Возврат Адрес + "/" + Ключ(Зеркало) + "/" + Действие;
КонецФункции

#КонецОбласти

&Прозвище("ВитринаЗеркалКабинета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Пластилин(Значение = "ПредставлениеПрогонаЗеркала") _Прогоны,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПоляЗеркала") _Поля,
	&Пластилин(Значение = "ПультЗеркал") _ИменаПолей,
	&Пластилин(Значение = "ПультЗеркалПула") _Пульт,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "АдресаКабинета") _Адреса) Экспорт

	Кит = _Кит;
	СервисЗеркал = _СервисЗеркал;
	Прогоны = _Прогоны;
	ДомПула = _ДомПула;
	Тексты = _Тексты;
	Поля = _Поля;
	ИменаПолей = _ИменаПолей;
	Пульт = _Пульт;
	Окна = _Окна;
	Адреса = _Адреса;

КонецПроцедуры
