// Путь первой публикации: шаги от администратора до первой версии и их состояние для пользователя.

Перем Онбординг;          // ОнбордингПервогоЗапуска (вход)
Перем СервисПулов;        // СервисПулов (реестр)
Перем СервисПрав;         // СервисПрав (права) — право записи в пул и право им управлять
Перем СервисТокенов;      // СервисТокенов (вход)
Перем СервисВерсий;       // СервисВерсий (реестр) — публиковал ли человек хоть что-то
Перем Страницы;           // АдресаСтраниц (реестр) — страница и настройки пула публикации
Перем ДомАккаунта;        // ДомАккаунта — адрес раздела токенов
Перем Команды;            // КомандыOpm — нужна ли клиенту прописка пула
Перем Тексты;             // ТекстыИнтерфейса (кит) — подписи кнопки шага «пул»

#Область ПубличныйИнтерфейс

// Ключ шага «создать пул».
//
// Возвращаемое значение:
//  Строка - ключ шага «создать пул».
//
Функция КлючШагаПула() Экспорт
	Возврат "пул";
КонецФункции

// Состояние пути для пользователя — единственный вход.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - текущий пользователь (аноним — Неопределено: тогда персональные шаги считаются невыполненными).
//
// Возвращаемое значение:
//  Структура:
//    * Шаги - Массив из Структура (Ключ, Заголовок, Пояснение, Выполнен, Текущий, Адрес, ПодписьСсылки) — в порядке прохождения; ровно у одного невыполненного шага Текущий = Истина;
//    * ПулПримера - Строка - имя пула, куда пользователь реально может публиковать (для примера настройки opm); "" — такого пула нет;
//    * ПропискаНужна - Булево - нужно ли прописать пул примера сервером в opm.cfg, чтобы opm push до него дошёл;
//    * Пройден - Булево - все шаги выполнены.
//
Функция Состояние(Знач Пользователь) Экспорт

	Шаги = Новый Массив();

	Шаги.Добавить(Шаг("админ", "Создать администратора",
		"Мастер первого запуска /setup закрывается, как только в хабе появляется первый пользователь.",
		НЕ Онбординг.НуженОнбординг(), "", ""));

	ПулПубликации = ПулДляПубликации(Пользователь);
	ПропискаНужна = Команды.ПропискаНужна(ПулПубликации);

	Шаги.Добавить(ШагПула(Пользователь, ПулПубликации));

	Шаги.Добавить(Шаг("токен", "Выпустить токен публикации",
		ПояснениеТокена(ПропискаНужна),
		ЕстьДействующийТокен(Пользователь), ДомАккаунта.АдресРаздела("tokens"), "Мои токены"));

	Шаги.Добавить(Шаг("публикация", "Опубликовать первую версию",
		ПояснениеПубликации(ПропискаНужна),
		ЕстьСвоюВерсию(Пользователь), "/me", "Мои пакеты"));

	ОтметитьТекущий(Шаги);

	Результат = Новый Структура();
	Результат.Вставить("Шаги", Шаги);
	Результат.Вставить("ПулПримера", ?(ПулПубликации = Неопределено, "", Строка(ПулПубликации.Имя)));
	Результат.Вставить("ПропискаНужна", ПропискаНужна);
	Результат.Вставить("Пройден", Пройден(Шаги));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Кнопка шага ведёт туда, куда пустят: в настройки пула — управляющего им, райтера — на страницу пула.
Функция ШагПула(Знач Пользователь, Знач Пул)

	Если Пул = Неопределено Тогда
		Адрес = "/packages";
		Подпись = Тексты.Текст("office.start.pool.catalog");
	ИначеЕсли СервисПрав.МожетАдминистрировать(Пользователь, Пул) Тогда
		Адрес = Страницы.НастроекПула(Пул.Имя);
		Подпись = Тексты.Текст("office.start.pool.settings");
	Иначе
		Адрес = Страницы.Пула(Пул.Имя);
		Подпись = Тексты.Текст("office.start.pool.page");
	КонецЕсли;

	Возврат Шаг(КлючШагаПула(), "Получить пул, куда публиковать",
		"Пакеты живут в пулах, а не в хабе целиком. Нужен пул с разрешённой публикацией,"
			+ " на который у вас есть право записи.",
		Пул <> Неопределено, Адрес, Подпись);

КонецФункции

// Первый пул, куда пользователь может публиковать: публикация разрешена И есть право записи.
Функция ПулДляПубликации(Знач Пользователь)

	Если Пользователь = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Пул Из СервисПулов.ВсеПулы() Цикл
		Если НЕ СервисПулов.ПубликацияРазрешена(Пул) Тогда
			Продолжить;
		КонецЕсли;
		Если СервисПрав.ПользовательАдмин(Пользователь) ИЛИ СервисПрав.МожетПисать(Пользователь, Пул) Тогда
			Возврат Пул;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Без opm.cfg поля «Авторизация» нет: токен opm push получает опцией.
Функция ПояснениеТокена(Знач ПропискаНужна)

	Если ПропискаНужна Тогда
		Возврат "opm ходит на хаб по токену (PAT), а не по паролю: пароль в opm.cfg класть нельзя.";
	КонецЕсли;

	Возврат "opm ходит на хаб по токену (PAT), а не по паролю: токен передаётся опцией --token команды opm push.";

КонецФункции

// Без opm.cfg opm push шлёт пакет на короткий адрес хаба, где канал обязателен.
Функция ПояснениеПубликации(Знач ПропискаНужна)

	Если ПропискаНужна Тогда
		Возврат "Пропишите пул сервером в opm.cfg и выполните opm push — версия появится в каталоге.";
	КонецЕсли;

	Возврат "Опубликуйте версию командой opm push --token <токен> -c stable <файл>.ospx —"
		+ " она появится в каталоге.";

КонецФункции

Функция ЕстьДействующийТокен(Знач Пользователь)

	Если Пользователь = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СервисТокенов.ЕстьДействующийКлюч(Пользователь.Идентификатор);

КонецФункции

Функция ЕстьСвоюВерсию(Знач Пользователь)

	Если Пользователь = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СервисВерсий.ПользовательПубликовалВХабе(Пользователь.Идентификатор);

КонецФункции

// Пройден ли путь целиком (по уже посчитанным шагам — без повторного обхода реестра).
Функция Пройден(Знач Шаги)
	Для Каждого Шаг Из Шаги Цикл
		Если НЕ Шаг.Выполнен Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Текущий шаг — первый невыполненный.
Процедура ОтметитьТекущий(Знач Шаги)
	Для Каждого Шаг Из Шаги Цикл
		Если НЕ Шаг.Выполнен Тогда
			Шаг.Текущий = Истина;
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция Шаг(Знач Ключ, Знач Заголовок, Знач Пояснение, Знач Выполнен, Знач Адрес, Знач ПодписьСсылки)
	Результат = Новый Структура();
	Результат.Вставить("Ключ", Ключ);
	Результат.Вставить("Заголовок", Заголовок);
	Результат.Вставить("Пояснение", Пояснение);
	Результат.Вставить("Выполнен", Выполнен);
	Результат.Вставить("Текущий", Ложь);
	Результат.Вставить("Адрес", Адрес);
	Результат.Вставить("ПодписьСсылки", ПодписьСсылки);
	Возврат Результат;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОнбордингПервогоЗапуска") _Онбординг,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисТокенов") _СервисТокенов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы,
	&Пластилин(Значение = "ДомАккаунта") _ДомАккаунта,
	&Пластилин(Значение = "КомандыOpm") _Команды,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Онбординг = _Онбординг;
	СервисПулов = _СервисПулов;
	СервисПрав = _СервисПрав;
	СервисТокенов = _СервисТокенов;
	СервисВерсий = _СервисВерсий;
	Страницы = _Страницы;
	ДомАккаунта = _ДомАккаунта;
	Команды = _Команды;
	Тексты = _Тексты;

КонецПроцедуры
