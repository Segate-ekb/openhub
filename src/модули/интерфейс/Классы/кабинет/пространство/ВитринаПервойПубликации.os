// «Первая публикация»: шаги пути на экране — карточкой на проводнике и секцией в кабинете
// новичка.

Перем Кит;      // Кит (кит) — фабрика элементов экрана
Перем Путь;     // ПутьПервойПубликации — состояние шагов
Перем Тексты;   // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Карточка шагов для самого проводника — по уже посчитанному состоянию пути; хода в проводник
// у неё нет: она и стоит на той странице.
//
// Параметры:
//  Состояние - Структура - состояние пути (ПутьПервойПубликации.Состояние).
//
// Возвращаемое значение:
//  ЭлементЭкрана - карточка со списком шагов.
//
Функция Карточка(Знач Состояние) Экспорт

	Возврат Кит.Карточка(Тексты.Текст("office.start.title"), Шаги(Состояние))
		.Описание(Тексты.Текст("office.start.lead")).Иконка("стрелка");

КонецФункции

// Секция кабинета для того, у кого ещё нет ни одного пакета: те же шаги плюс ход
// в проводник, где к ним можно вернуться с любой другой страницы.
//
// Параметры:
//  Пользователь - Пользователь - смотрящий.
//  АдресПроводника - Строка - адрес страницы проводника.
//
// Возвращаемое значение:
//  ЭлементЭкрана - секция Кит.Секция.
//
Функция СекцияСводки(Знач Пользователь, Знач АдресПроводника) Экспорт

	Возврат Кит.Секция(Тексты.Текст("office.start.title"), Шаги(Путь.Состояние(Пользователь)))
		.Лид(Тексты.Текст("office.start.lead")).Иконка("стрелка")
		.Действия(ХодВПроводник(АдресПроводника));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Шаги(Знач Состояние)
	Возврат Кит.Проводник(Новый Структура("Шаги", Состояние.Шаги));
КонецФункции

Функция ХодВПроводник(Знач Адрес)

	Возврат Кит.Кнопка(Тексты.Текст("office.start.open")).Вторичная().Иконка("вправо").Адрес(Адрес);

КонецФункции

#КонецОбласти

&Прозвище("ВитринаПервойПубликации")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ПутьПервойПубликации") _Путь,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Путь = _Путь;
	Тексты = _Тексты;

КонецПроцедуры
