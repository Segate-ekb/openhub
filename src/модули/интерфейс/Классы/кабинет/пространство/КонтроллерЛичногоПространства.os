// Кабинет /me — первый раздел дома «Аккаунт» со сводкой дел вошедшего — и страница заявок
// по всем пулам, где он вправе решать, с окнами решения по адресу.

Перем Гвард;         // ГвардКабинета
Перем Ответы;        // ОтветыНастроек
Перем Защита;        // ЗащитаCSRF (вход) — токен сессии в форму
Перем Гейт;          // ГейтФормы — токен формы
Перем РазборФормы;
Перем Окна;          // ОкноРаздела — окно решения по адресу и ответы его формы
Перем Рассмотрение;  // РассмотрениеВходящих (публикация) — заявки, доступные принципалу
Перем ВитринаЗаявок; // ВитринаЗаявокПула — разметка «входящих»
Перем ПультЗаявок;   // ПультЗаявок — одобрение и отклонение заявок
Перем ВитринаСводки; // ВитринаСводкиКабинета — секции кабинета
Перем СводкаДел;     // СводкаДелВошедшего — непрочитанное и очередь одним снимком
Перем Дом;           // ДомАккаунта — кабинет живёт первым разделом этого дома
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем АдресаЭкранов; // АдресаКабинета — адреса экранов кабинета

#Область ТочкиМаршрута

// GET /me — кабинет: раздел дома «Аккаунт» со сводкой состояния дел вошедшего.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//
&ТочкаМаршрута("")
Процедура Кабинет(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	ОтдатьКабинет(Ответ, Вердикт, КукиЗапроса);

КонецПроцедуры

// GET /me/inbox — заявки по всем пулам, где пользователь вправе решать, POST — решение формой
// окна. Без подтверждения решение не принимается: ответ ведёт на окно решения по адресу.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак принятого решения из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно решения, открытое по адресу: <вид>-<номер заявки> (необязательный,
//         по умолчанию "").
//
&ТочкаМаршрута("inbox")
Процедура ВходящиеЗаявки(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	saved = "", окно = "") Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьВходящие(Ответ, Вердикт, КукиЗапроса, 200, Окна.ИзАдреса(окно, ВитринаЗаявок.ВидыОкон()),
			ЗначениеЗаполнено(saved));
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Гейт.СПринятымТокеном(Ответ, Вердикт, РазборФормы.Разобрать(ТелоЗапроса),
		КукиЗапроса, Тексты.Текст("settings.inbox.error.csrf"));
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// пул не ограничивается: страница ведёт все пулы принципала, а порог по каждой заявке
	// проверяет РассмотрениеВходящих
	Исход = ПультЗаявок.Применить(Вердикт.Принципал, Форма);
	Если Исход.Спросить Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресВходящих(), Исход.Ключ, Исход.ВидОкна);
	ИначеЕсли Исход.Успех Тогда
		Окна.ВернутьВРаздел(Ответ, АдресВходящих());
	Иначе
		ОтдатьОтказ(Ответ, Вердикт, КукиЗапроса, Исход);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Рендер

// Дела снимаются один раз на запрос и доезжают и до секций кабинета, и до шапки.
Процедура ОтдатьКабинет(Ответ, Знач Вердикт, Знач КукиЗапроса)

	Дела = СводкаДел.Снять(Вердикт.Пользователь, Вердикт.Принципал);
	Раздел = Дом.РазделКабинета();

	Модель = Ответы.МодельДома(Дом, "", Дом.Разделы(Раздел),
		Новый Массив(), ВитринаСводки.Секции(Вердикт, Дела), Защита.ТокенСессии(Вердикт.Сессия));
	Модель.Заголовок = Дом.ЗаголовокУчётки(Вердикт.Пользователь.Логин);

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт, КукиЗапроса, 200, "", Дела);

КонецПроцедуры

// Отказ (см. ИсходОкна) остаётся в окне решения, пока заявку видно; иначе — тостом над списком.
Процедура ОтдатьОтказ(Ответ, Знач Вердикт, Знач КукиЗапроса, Знач Исход)

	Строки = Рассмотрение.ОжидающиеПринципала(Вердикт.Принципал);
	Если Исход.Окно <> Неопределено И ВитринаЗаявок.ЕстьОкно(Исход.Окно, Строки) Тогда
		ОтдатьВходящие(Ответ, Вердикт, КукиЗапроса, Исход.Код, Исход.Окно, Ложь, "", Строки);
		Возврат;
	КонецЕсли;
	ОтдатьВходящие(Ответ, Вердикт, КукиЗапроса, Исход.Код, Неопределено, Ложь, Исход.Сообщение, Строки);

КонецПроцедуры

Процедура ОтдатьВходящие(Ответ, Знач Вердикт, Знач КукиЗапроса, Знач Статус, Знач Окно,
	Знач Сохранено, Знач Ошибка = "", Знач Строки = Неопределено)

	Хлебные = Новый Массив();
	Хлебные.Добавить(Новый Структура("Подпись, Адрес",
		Вердикт.Пользователь.Логин, АдресаЭкранов.Личное()));
	Хлебные.Добавить(Новый Структура("Подпись", Тексты.Текст("settings.inbox.crumb")));

	Если Строки = Неопределено Тогда
		Строки = Рассмотрение.ОжидающиеПринципала(Вердикт.Принципал);
	КонецЕсли;

	Модель = Новый Структура();
	Модель.Вставить("Ключ", "inbox");
	Модель.Вставить("Заголовок", Тексты.Текст("settings.inbox.page.title"));
	Модель.Вставить("Объект", "");
	Модель.Вставить("Пояснение", Тексты.Текст("settings.inbox.page.lead"));
	// дерева разделов у страницы нет: она сама себе раздел, каркас без разделов их не рисует
	Модель.Вставить("Разделы", Новый Массив());
	Модель.Вставить("Уведомления", Ответы.УведомленияРаздела(Сохранено, Ошибка));
	Модель.Вставить("Хлебные", Хлебные);
	Модель.Вставить("Токен", Защита.ТокенСессии(Вердикт.Сессия));
	Модель.Вставить("Секции", ВитринаЗаявок.Секции(
		Новый Структура("Строки, Адрес, СПулом, Окно", Строки, АдресВходящих(), Истина, Окно)));

	// свой адрес страница называет сама: разделов у неё нет, и взять его каркасу неоткуда;
	// на него же уходят формы окон решения
	Ответы.ОтдатьДом(Ответ, Модель, Вердикт, КукиЗапроса, Статус, АдресВходящих());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АдресВходящих()
	Возврат АдресаЭкранов.Входящие();
КонецФункции

#КонецОбласти

&Контроллер("/me")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _Гвард,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "РассмотрениеВходящих") _Рассмотрение,
	&Пластилин(Значение = "ВитринаЗаявокПула") _ВитринаЗаявок,
	&Пластилин(Значение = "ПультЗаявок") _ПультЗаявок,
	&Пластилин(Значение = "ВитринаСводкиКабинета") _ВитринаСводки,
	&Пластилин(Значение = "СводкаДелВошедшего") _СводкаДел,
	&Пластилин(Значение = "ДомАккаунта") _Дом,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаКабинета") _АдресаЭкранов)

	Гвард = _Гвард;
	Ответы = _Ответы;
	Защита = _Защита;
	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	Окна = _Окна;
	Рассмотрение = _Рассмотрение;
	ВитринаЗаявок = _ВитринаЗаявок;
	ПультЗаявок = _ПультЗаявок;
	ВитринаСводки = _ВитринаСводки;
	СводкаДел = _СводкаДел;
	Дом = _Дом;
	Тексты = _Тексты;
	АдресаЭкранов = _АдресаЭкранов;

КонецПроцедуры
