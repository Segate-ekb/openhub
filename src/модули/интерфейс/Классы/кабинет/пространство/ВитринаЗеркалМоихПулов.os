// Секция кабинета «Зеркала ваших пулов»: по строке на зеркало — апстрим, состояние прогона
// и последний синк.

Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек; // РендерерНастроек (кит) — заготовка секции
Перем Ячейки;         // ЯчейкиТаблицы — заготовки ячеек таблиц
Перем СлужбаКабинета; // СлужбаКабинета (кабинет) — пулы в распоряжении смотрящего
Перем СервисЗеркал;   // СервисЗеркал (зеркала) — зеркала пула и вердикт «прогон брошен»
Перем Прогоны;        // ПредставлениеПрогонаЗеркала — прогон в виде для экрана
Перем ДомПула;        // ДомПула — адрес экрана состояния зеркала
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Страницы; // АдресаСтраниц (реестр) — страница пула в строке зеркала

#Область ПубличныйИнтерфейс

// Секция «Зеркала ваших пулов». Ни одного зеркала — секции нет вовсе: пустая таблица
// обещала бы, что репликация настроена.
//
// Параметры:
//  Пользователь - Пользователь - смотрящий.
//
// Возвращаемое значение:
//  Структура, Неопределено - секция для РендерерНастроек либо Неопределено при отсутствии зеркал.
//
Функция СекцияСводки(Знач Пользователь) Экспорт

	Строки = ЗеркалаПулов(Пользователь);
	Если Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Секция = РендерерНастроек.Секция(Тексты.Текст("office.home.mirrors.title"),
		Тексты.Текст("office.home.mirrors.lead"), ТаблицаЗеркал(Строки).Рендер());
	Секция.Иконка = "ссылка";
	Возврат Секция;

КонецФункции

#КонецОбласти

#Область ОтборЗеркал

// Порог «мейнтейнер и выше» — договор службы кабинета, а не правило этого экрана.
Функция ЗеркалаПулов(Знач Пользователь)

	Результат = Новый Массив();

	Для Каждого Пул Из СлужбаКабинета.ПулыВРаспоряжении(Пользователь) Цикл

		Для Каждого Зеркало Из СервисЗеркал.СписокПула(Пул.Идентификатор) Цикл
			Результат.Добавить(Новый Структура("Пул, Зеркало, Прогон", Пул, Зеркало,
				Прогоны.Модель(Зеркало, СервисЗеркал.ПрогонБрошен(Зеркало))));
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Разметка

Функция ТаблицаЗеркал(Знач Строки)

	Результат = Кит.Таблица();
	Результат.Добавить(Кит.Колонка(Тексты.Текст("office.home.mirrors.col.pool")));
	Результат.Добавить(Кит.Колонка(Тексты.Текст("office.home.mirrors.col.upstream")));
	Результат.Добавить(Кит.Колонка(Тексты.Текст("office.home.mirrors.col.state")));
	Результат.Добавить(Кит.Колонка(Тексты.Текст("office.home.mirrors.col.sync")));

	Для Каждого ЗеркалоПула Из Строки Цикл
		Результат.Добавить(СтрокаЗеркала(ЗеркалоПула));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СтрокаЗеркала(Знач ЗеркалоПула)

	Результат = Кит.Запись();
	Результат.Добавить(ИмяПула(ЗеркалоПула.Пул));
	Результат.Добавить(АдресАпстрима(ЗеркалоПула.Зеркало));
	Результат.Добавить(СостояниеПрогона(ЗеркалоПула));
	Результат.Добавить(Ячейки.Текстовая(МоментСинка(ЗеркалоПула.Прогон)));
	Возврат Результат;

КонецФункции

Функция ИмяПула(Знач Пул)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Ссылка(Страницы.Пула(Строка(Пул.Имя)))).Добавить(Кит.Текст(Строка(Пул.Имя)));
	Возврат Ячейка;

КонецФункции

Функция АдресАпстрима(Знач Зеркало)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Код(Строка(Зеркало.АпстримURL)));
	Возврат Ячейка;

КонецФункции

// Неудача объясняется словами прямо здесь: иначе про сломанную репликацию узнают, зайдя внутрь.
Функция СостояниеПрогона(Знач ЗеркалоПула)

	Прогон = ЗеркалоПула.Прогон;

	Ячейка = Кит.Ячейка("столбиком");
	Ячейка.Добавить(Кит.Плашка(Новый Структура("Текст, Вид, Адрес",
		Прогон.Подпись, Прогон.Вид, АдресПрогона(ЗеркалоПула))));
	Ячейка.Добавить(ПричинаНеудачи(Прогон));
	Возврат Ячейка;

КонецФункции

Функция ПричинаНеудачи(Знач Прогон)

	Если НЕ ЗначениеЗаполнено(Прогон.Итог) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Приписка = Кит.Надпись("приписка");
	Приписка.Добавить(Кит.Текст(Строка(Прогон.Итог)));
	Возврат Приписка;

КонецФункции

Функция АдресПрогона(Знач ЗеркалоПула)

	Возврат ДомПула.АдресРаздела(ЗеркалоПула.Пул.Имя, "mirrors")
		+ "/" + Формат(ЗеркалоПула.Зеркало.Идентификатор, "ЧГ=0; ЧН=0");

КонецФункции

Функция МоментСинка(Знач Прогон)

	Возврат ?(ЗначениеЗаполнено(Прогон.ПоследнийСинк), Прогон.ПоследнийСинк,
		Тексты.Текст("office.home.mirrors.never"));

КонецФункции

#КонецОбласти

&Прозвище("ВитринаЗеркалМоихПулов")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ЯчейкиТаблицы") _Ячейки,
	&Пластилин(Значение = "СлужбаКабинета") _СлужбаКабинета,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Пластилин(Значение = "ПредставлениеПрогонаЗеркала") _Прогоны,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Ячейки = _Ячейки;
	СлужбаКабинета = _СлужбаКабинета;
	СервисЗеркал = _СервисЗеркал;
	Прогоны = _Прогоны;
	ДомПула = _ДомПула;
	Тексты = _Тексты;
	Страницы = _Страницы;

КонецПроцедуры
