// Секция кабинета «Зеркала ваших пулов»: по строке на зеркало — апстрим, состояние прогона
// и последний синк.

Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем СлужбаКабинета; // СлужбаКабинета (кабинет) — пулы в распоряжении смотрящего
Перем СервисЗеркал;   // СервисЗеркал (зеркала) — зеркала пула и вердикт «прогон брошен»
Перем Прогоны;        // ПредставлениеПрогонаЗеркала — прогон в виде для экрана
Перем ДомПула;        // ДомПула — адрес экрана состояния зеркала
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Страницы; // АдресаСтраниц (реестр) — страница пула в строке зеркала

#Область ПубличныйИнтерфейс

// Секция «Зеркала ваших пулов». Ни одного зеркала — секции нет вовсе: пустая таблица
// обещала бы, что репликация настроена.
//
// Параметры:
//  Пользователь - Пользователь - смотрящий.
//
// Возвращаемое значение:
//  ЭлементЭкрана, Неопределено - секция Кит.Секция либо Неопределено при отсутствии зеркал.
//
Функция СекцияСводки(Знач Пользователь) Экспорт

	Строки = ЗеркалаПулов(Пользователь);
	Если Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Секция(Тексты.Текст("office.home.mirrors.title"), ТаблицаЗеркал(Строки))
		.Лид(Тексты.Текст("office.home.mirrors.lead")).Иконка("ссылка");

КонецФункции

#КонецОбласти

#Область ОтборЗеркал

// Порог «мейнтейнер и выше» — договор службы кабинета, а не правило этого экрана.
Функция ЗеркалаПулов(Знач Пользователь)

	Результат = Новый Массив();

	Для Каждого Пул Из СлужбаКабинета.ПулыВРаспоряжении(Пользователь) Цикл

		Для Каждого Зеркало Из СервисЗеркал.СписокПула(Пул.Идентификатор) Цикл
			Результат.Добавить(Новый Структура("Пул, Зеркало, Прогон", Пул, Зеркало,
				Прогоны.Модель(Зеркало, СервисЗеркал.ПрогонБрошен(Зеркало))));
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Разметка

// На узком экране — карточки с пулом заглавием; неудача прогона объясняется словами прямо
// здесь: иначе про сломанную репликацию узнают, зайдя внутрь.
Функция ТаблицаЗеркал(Знач Строки)

	Записи = Новый Массив();
	Для Каждого ЗеркалоПула Из Строки Цикл
		Записи.Добавить(Новый Структура("pool, upstream, state, sync",
			Кит.Ссылка(Страницы.Пула(Строка(ЗеркалоПула.Пул.Имя)), Кит.Текст(Строка(ЗеркалоПула.Пул.Имя))),
			Кит.Код(Строка(ЗеркалоПула.Зеркало.АпстримURL)),
			СостояниеПрогона(ЗеркалоПула),
			МоментСинка(ЗеркалоПула.Прогон)));
	КонецЦикла;

	Таблица = Кит.Таблица(Записи).Вид("карточками");
	Таблица.Колонка("pool", Тексты.Текст("office.home.mirrors.col.pool")).Заглавная();
	Таблица.Колонка("upstream", Тексты.Текст("office.home.mirrors.col.upstream"));
	Таблица.Колонка("state", Тексты.Текст("office.home.mirrors.col.state"));
	Таблица.Колонка("sync", Тексты.Текст("office.home.mirrors.col.sync"));
	Возврат Таблица;

КонецФункции

// Плашка прогона ведёт на экран состояния зеркала; итог прогона — припиской под ней.
Функция СостояниеПрогона(Знач ЗеркалоПула)

	Прогон = ЗеркалоПула.Прогон;
	Плашка = Кит.Плашка(Прогон.Подпись).Адрес(АдресПрогона(ЗеркалоПула));
	Если ЗначениеЗаполнено(Прогон.Вид) Тогда
		Плашка.Вид(Прогон.Вид);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Прогон.Итог) Тогда
		Возврат Плашка;
	КонецЕсли;
	Возврат Кит.Холст(Плашка, Кит.Надпись(Кит.Текст(Строка(Прогон.Итог))).Вид("приписка"));

КонецФункции

Функция АдресПрогона(Знач ЗеркалоПула)

	Возврат ДомПула.АдресРаздела(ЗеркалоПула.Пул.Имя, "mirrors")
		+ "/" + Формат(ЗеркалоПула.Зеркало.Идентификатор, "ЧГ=0; ЧН=0");

КонецФункции

Функция МоментСинка(Знач Прогон)

	Возврат ?(ЗначениеЗаполнено(Прогон.ПоследнийСинк), Строка(Прогон.ПоследнийСинк),
		Тексты.Текст("office.home.mirrors.never"));

КонецФункции

#КонецОбласти

&Прозвище("ВитринаЗеркалМоихПулов")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СлужбаКабинета") _СлужбаКабинета,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Пластилин(Значение = "ПредставлениеПрогонаЗеркала") _Прогоны,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы) Экспорт

	Кит = _Кит;
	СлужбаКабинета = _СлужбаКабинета;
	СервисЗеркал = _СервисЗеркал;
	Прогоны = _Прогоны;
	ДомПула = _ДомПула;
	Тексты = _Тексты;
	Страницы = _Страницы;

КонецПроцедуры
