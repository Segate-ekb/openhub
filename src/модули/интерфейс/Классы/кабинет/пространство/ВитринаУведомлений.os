// Лента личных уведомлений: секция экрана `/me/notifications` и секция «вам пришло» в кабинете.

Перем Кит;     // Кит (кит) — фабрика элементов экрана
Перем Тексты;  // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Даты;    // ДатаЧеловеку — одно написание момента на весь интерфейс

#Область ПубличныйИнтерфейс

// Секции экрана ленты.
//
// Параметры:
//  Параметры - Структура:
//    * Записи - Массив из ЛичноеУведомление - лента, свежие первыми;
//    * Непрочитано - Число - сколько записей человек ещё не читал.
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - одна секция: лента таблицей и «отметить всё прочитанным» в шапке.
//
Функция Секции(Знач Параметры) Экспорт

	Результат = Новый Массив();
	Результат.Добавить(СекцияЛенты(Параметры.Записи, Цел(Параметры.Непрочитано)));
	Возврат Результат;

КонецФункции

// Сколько строк показывает секция кабинета; столько записей и берут из ленты.
//
// Возвращаемое значение:
//  Число - предел строк секции кабинета.
//
Функция ПределСводки() Экспорт
	Возврат 3;
КонецФункции

// Секция «вам пришло» для кабинета: счётчик непрочитанного в заголовке, несколько свежих строк
// и ход к ленте в шапке секции. Непрочитанного нет — секции нет вовсе.
//
// Параметры:
//  Свежие - Массив из ЛичноеУведомление - свежайшие непрочитанные, не больше ПределСводки().
//  Непрочитано - Число - сколько записей человек ещё не читал всего.
//  Адрес - Строка - адрес полной ленты.
//
// Возвращаемое значение:
//  ЭлементЭкрана, Неопределено - секция Кит.Секция либо Неопределено при отсутствии
//                                непрочитанного.
//
Функция СекцияСводки(Знач Свежие, Знач Непрочитано, Знач Адрес) Экспорт

	Если Цел(Непрочитано) = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Секция(Тексты.Шаблон("office.notifications.widget.title",
				Тексты.ЧислоТекстом(Цел(Непрочитано))),
			ТаблицаСвежих(Свежие))
		.Лид(Тексты.Текст("office.notifications.widget.lead")).Иконка("конверт")
		.Действия(Кит.Кнопка(Тексты.Текст("office.notifications.widget.open")).Вторичная().Иконка("вправо")
			.Адрес(Адрес));

КонецФункции

#КонецОбласти

#Область СекцияЛенты

// Отметка — обратимое по смыслу действие без окна: форма из одной кнопки в шапке секции, на адрес
// ленты. Отмечать нечего — кнопки нет: кнопка без работы выглядит сломанной.
Функция СекцияЛенты(Знач Записи, Знач Непрочитано)

	Секция = Кит.Секция(Тексты.Текст("office.notifications.title"), ТаблицаЛенты(Записи))
		.Лид(Тексты.Текст("office.notifications.lead")).Иконка("конверт");
	Если Непрочитано > 0 Тогда
		Секция.Действия(Кит.Форма("",
			Кит.Кнопка(Тексты.Текст("office.notifications.read.button")).Вторичная().Иконка("галочка")));
	КонецЕсли;
	Возврат Секция;

КонецФункции

// На узком экране — карточки с событием заглавием.
Функция ТаблицаЛенты(Знач Записи)

	Строки = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Строки.Добавить(Новый Структура("event, when, state",
			Событие(Запись), Момент(Запись), ПризнакПрочтения(Запись)));
	КонецЦикла;

	Таблица = Кит.Таблица(Строки).Вид("карточками").Пусто(Тексты.Текст("office.notifications.empty"));
	Таблица.Колонка("event", Тексты.Текст("office.notifications.col.event")).Заглавная();
	Таблица.Колонка("when", Тексты.Текст("office.notifications.col.when"));
	Таблица.Колонка("state", Тексты.Текст("office.notifications.col.state")).БезПодписиВЗаписи();
	Возврат Таблица;

КонецФункции

// Непрочитанное отличимо от прочитанного плашкой: у прочитанной записи ячейка пуста.
Функция ПризнакПрочтения(Знач Запись)
	Если Запись.Прочитано = Истина Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Плашка(Тексты.Текст("office.notifications.new")).Вид("accent");
КонецФункции

#КонецОбласти

#Область Событие

// Событие одинаково в ленте и в кабинете: заголовок (ссылкой, когда ему есть куда вести)
// и подробности припиской. Тексты событий пишет хаб из данных заявок — узлами текста.
Функция Событие(Знач Запись)
	Возврат Кит.Холст(ЗаголовокСобытия(Запись),
		Кит.Надпись(Кит.Текст(Строка(Запись.Текст))).Вид("приписка"));
КонецФункции

Функция ЗаголовокСобытия(Знач Запись)
	Если НЕ ЗначениеЗаполнено(Запись.Ссылка) Тогда
		Возврат Кит.Надпись(Кит.Текст(Строка(Запись.Заголовок)));
	КонецЕсли;
	Возврат Кит.Ссылка(Строка(Запись.Ссылка), Кит.Текст(Строка(Запись.Заголовок)));
КонецФункции

Функция Момент(Знач Запись)
	Возврат Даты.ДатаВремя(Запись.Создано);
КонецФункции

#КонецОбласти

#Область СекцияКабинета

Функция ТаблицаСвежих(Знач Свежие)

	Строки = Новый Массив();
	Для Каждого Запись Из Свежие Цикл
		Строки.Добавить(Новый Структура("event, when", Событие(Запись), Момент(Запись)));
	КонецЦикла;

	Таблица = Кит.Таблица(Строки).Вид("карточками");
	Таблица.Колонка("event", Тексты.Текст("office.notifications.col.event")).Заглавная();
	Таблица.Колонка("when", Тексты.Текст("office.notifications.col.when"));
	Возврат Таблица;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено)

	Кит = _Кит;
	Тексты = _Тексты;
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);

КонецПроцедуры
