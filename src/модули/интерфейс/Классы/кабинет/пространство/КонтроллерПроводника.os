// Страница /tour — проводник «первая публикация»: шаги пути и публикация из opm.

Перем Гвард;         // ГвардКабинета
Перем Страницы;      // РендерерКабинета — страница приватной части
Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Путь;          // ПутьПервойПубликации
Перем Ответы;        // ОтветыНастроек
Перем СервисПрав;    // СервисПрав (права)
Перем ВитринаШагов;  // ВитринаПервойПубликации — карточка шагов

// GET /tour — страница проводника первой публикации.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ПутьЗапроса - Строка - путь текущего запроса: по нему меню подсвечивает дорогу.
//
&ТочкаМаршрута("/tour")
Процедура Проводник(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ПутьЗапроса) Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Ответ.УстановитьСостояние(200);
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Страница(Вердикт, КукиЗапроса, ПутьЗапроса);

КонецПроцедуры

#Область Рендер

Функция Страница(Знач Вердикт, Знач КукиЗапроса, Знач ПутьЭкрана)

	Пользователь = Вердикт.Пользователь;
	// состояние пути считается один раз за показ: шаги и карточка opm говорят одно и то же
	Состояние = Путь.Состояние(Пользователь);

	// те же шаги, что в секции кабинета новичка: путь один, и шаги у него одни
	Содержимое = Кит.Холст(ВитринаШагов.Карточка(Состояние), КарточкаOpm(Состояние));

	Возврат Страницы.Страница(Тексты.Текст("office.start.title"), Содержимое,
		Страницы.КонтекстСтраницы(Пользователь, КукиЗапроса,
			СервисПрав.ПользовательАдмин(Пользователь), ПутьЭкрана, Вердикт.Сессия));

КонецФункции

// Основной пул хаба, известного opm, клиент находит сам: прописывать его в opm.cfg незачем.
Функция КарточкаOpm(Знач Состояние)

	Если Состояние.ПропискаНужна Тогда
		Возврат Кит.Карточка(Тексты.Текст("office.start.opm.title"), НастройкаOpm(Состояние.ПулПримера))
			.Описание(Тексты.Текст("office.start.opm.pool")).Иконка("пакет");
	КонецЕсли;
	Возврат Кит.Карточка(Тексты.Текст("office.start.opm.title"), ПубликацияСТокеном())
		.Описание(Тексты.Шаблон("office.start.opm.default", Состояние.ПулПримера)).Иконка("пакет");

КонецФункции

// Образец записи сервера в opm.cfg на пул примера и команда публикации через неё.
Функция НастройкаOpm(Знач ПулПримера)

	ИмяПула = ?(ЗначениеЗаполнено(ПулПримера), ПулПримера, Тексты.Текст("office.start.opm.pool.placeholder"));
	Возврат Кит.Холст(
		Кит.Код(Тексты.Шаблон("office.start.opm.config", ИмяПула)).Вид("блочный"),
		Кит.Примечание(Тексты.Текст("office.start.opm.config.token")),
		Кит.БлокКоманды("opm push mylib-1.0.0.ospx"));

КонецФункции

// Без opm.cfg цель публикации — короткий адрес хаба: токен и обязательный канал едут опциями.
Функция ПубликацияСТокеном()
	Возврат Кит.Холст(
		Кит.БлокКоманды(Тексты.Текст("office.start.opm.command")),
		Кит.Примечание(Тексты.Текст("office.start.opm.command.hint")));
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _Гвард,
	&Пластилин(Значение = "РендерерКабинета") _Страницы,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ПутьПервойПубликации") _Путь,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ВитринаПервойПубликации") _ВитринаШагов,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	Гвард = _Гвард;
	Страницы = _Страницы;
	Кит = _Кит;
	Путь = _Путь;
	Ответы = _Ответы;
	СервисПрав = _СервисПрав;
	ВитринаШагов = _ВитринаШагов;
	Тексты = _Тексты;

КонецПроцедуры
