// Кабинет «/me»: из каких секций собрана сводка дел и в каком порядке они стоят.

Перем ВитринаЗаявок;      // ВитринаЗаявокПула — заявки на решение
Перем ВитринаЛенты;       // ВитринаУведомлений — непрочитанное
Перем СлужбаКабинета;     // СлужбаКабинета (кабинет) — пакеты в управлении
Перем ВитринаПакетов;     // ВитринаМоихПакетов
Перем ВитринаШагов;       // ВитринаПервойПубликации — шаги новичка
Перем ВитринаПространства;// ВитринаМоегоПространства
Перем ВитринаТокенов;     // ВитринаСрокаТокенов
Перем ВитринаЗеркал;      // ВитринаЗеркалМоихПулов
Перем Адреса;             // АдресаКабинета — адреса экранов кабинета

#Область ПубличныйИнтерфейс

// Секции кабинета сверху вниз: что ждёт решения и прочтения, что вот-вот сломается,
// затем хозяйство — пакеты, место и репликация. Секции без данных нет.
//
// Параметры:
//  Вердикт - Структура - вердикт гварда кабинета: Пользователь и Принципал.
//  Дела - Структура - снимок дел вошедшего (СводкаДелВошедшего.Снять), тот же, что в шапке.
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Вердикт, Знач Дела) Экспорт

	Пользователь = Вердикт.Пользователь;

	Результат = Новый Массив();
	ДобавитьНепустую(Результат, ЗаявкиНаРешение(Дела));
	ДобавитьНепустую(Результат, НепрочитанныеУведомления(Дела));
	ДобавитьНепустую(Результат, ТокеныНаИсходе(Пользователь));
	ДобавитьНепустую(Результат, МоиПакеты(Пользователь));
	ДобавитьНепустую(Результат, МоёПространство(Пользователь));
	ДобавитьНепустую(Результат, ЗеркалаМоихПулов(Пользователь));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СекцииСводки

// Заявок нет — секции нет вовсе: блок с нулём означал бы, что рядом что-то происходит.
Функция ЗаявкиНаРешение(Знач Дела)
	Возврат ВитринаЗаявок.СекцияСводки(Дела.Заявки, Адреса.Входящие());
КонецФункции

// Непрочитанного нет — секции нет.
Функция НепрочитанныеУведомления(Знач Дела)
	Возврат ВитринаЛенты.СекцияСводки(Дела.Свежие, Дела.Непрочитано, Адреса.Уведомления());
КонецФункции

Функция ТокеныНаИсходе(Знач Пользователь)
	Возврат ВитринаТокенов.СекцияСводки(Пользователь);
КонецФункции

// Пакетов нет — вместо пустой сетки первые шаги: новичку показывают, что делать.
Функция МоиПакеты(Знач Пользователь)

	Пакеты = СлужбаКабинета.ПакетыВУправлении(Пользователь);
	Если Пакеты.Количество() = 0 Тогда
		Возврат ВитринаШагов.СекцияСводки(Пользователь, Адреса.Проводник());
	КонецЕсли;

	Возврат ВитринаПакетов.СекцияСводки(Пакеты);

КонецФункции

Функция МоёПространство(Знач Пользователь)
	Возврат ВитринаПространства.СекцияСводки(Пользователь);
КонецФункции

Функция ЗеркалаМоихПулов(Знач Пользователь)
	Возврат ВитринаЗеркал.СекцияСводки(Пользователь);
КонецФункции

// Витрина без данных отдаёт Неопределено: такой секции в кабинете нет.
Процедура ДобавитьНепустую(Секции, Знач Секция)

	Если Секция <> Неопределено Тогда
		Секции.Добавить(Секция);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

&Прозвище("ВитринаСводкиКабинета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВитринаЗаявокПула") _ВитринаЗаявок,
	&Пластилин(Значение = "ВитринаУведомлений") _ВитринаЛенты,
	&Пластилин(Значение = "СлужбаКабинета") _СлужбаКабинета,
	&Пластилин(Значение = "ВитринаМоихПакетов") _ВитринаПакетов,
	&Пластилин(Значение = "ВитринаПервойПубликации") _ВитринаШагов,
	&Пластилин(Значение = "ВитринаМоегоПространства") _ВитринаПространства,
	&Пластилин(Значение = "ВитринаСрокаТокенов") _ВитринаТокенов,
	&Пластилин(Значение = "ВитринаЗеркалМоихПулов") _ВитринаЗеркал,
	&Пластилин(Значение = "АдресаКабинета") _Адреса) Экспорт

	ВитринаЗаявок = _ВитринаЗаявок;
	ВитринаЛенты = _ВитринаЛенты;
	СлужбаКабинета = _СлужбаКабинета;
	ВитринаПакетов = _ВитринаПакетов;
	ВитринаШагов = _ВитринаШагов;
	ВитринаПространства = _ВитринаПространства;
	ВитринаТокенов = _ВитринаТокенов;
	ВитринаЗеркал = _ВитринаЗеркал;
	Адреса = _Адреса;

КонецПроцедуры
