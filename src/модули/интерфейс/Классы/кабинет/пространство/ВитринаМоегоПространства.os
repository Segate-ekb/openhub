// Секция кабинета «Личное пространство»: сколько места занято в пуле, названном логином,
// и дорога в сам пул.

Перем Кит;            // Кит (кит) - фабрика элементов экрана
Перем СервисПулов;    // СервисПулов (реестр) - занятое и действующая квота
Перем СервисПакетов;  // СервисПакетов (реестр) - сколько имён лежит в пуле
Перем Заполнение;     // ЗаполнениеПула (реестр) - процент занятого
Перем Объемы;         // ОбъемТекстом (основа) - байты человеку
Перем Тексты;         // ТекстыИнтерфейса (кит) - пользовательские строки по ключам
Перем Страницы; // АдресаСтраниц (реестр) - страница личного пространства

#Область ПубличныйИнтерфейс

// Секция «Личное пространство»; без личного пространства секции нет вовсе.
//
// Параметры:
//  Пользователь - Пользователь - смотрящий.
//
// Возвращаемое значение:
//  ЭлементЭкрана, Неопределено - секция Кит.Секция либо Неопределено при отсутствии
//                                личного пространства.
//
Функция СекцияСводки(Знач Пользователь) Экспорт

	Пул = ЛичныйПул(Пользователь);
	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Секция(Тексты.Шаблон("office.home.space.title", Пул.Имя), Место(Пул), СколькоПакетов(Пул))
		.Лид(Тексты.Текст("office.home.space.lead")).Иконка("куб")
		.Действия(ХодВПул(Пул));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off

// Имя логина может носить и чужой пул: такой личным пространством не считается.
Функция ЛичныйПул(Знач Пользователь)

	Если Пользователь = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пул = СервисПулов.НайтиПул(Пользователь.Логин);
	Если Пул = Неопределено ИЛИ НЕ Пул.ЭтоЛичный()
		ИЛИ Цел(Пул.ВладелецИдентификатор) <> Цел(Пользователь.Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Пул;

КонецФункции

// У пула без ограничения процента не существует, поэтому печатается одно занятое.
Функция Место(Знач Пул)

	Занято = СервисПулов.ЗанятоБайт(Пул);
	КвотаБайт = СервисПулов.ЭффективнаяКвотаБайт(Пул);

	Если КвотаБайт <= 0 Тогда
		Возврат Кит.Примечание(Тексты.Шаблон("office.home.space.meter.unlimited",
			Объемы.Представление(Занято)));
	КонецЕсли;

	Возврат Кит.ПолосаЗаполнения(Заполнение.Процент(Занято, КвотаБайт),
			Тексты.Текст("office.home.space.meter.label"))
		.Подпись(Тексты.Шаблон("office.home.space.meter.value",
			Объемы.Представление(Занято), Объемы.Представление(КвотаБайт)));

КонецФункции

Функция СколькоПакетов(Знач Пул)

	Возврат Кит.Примечание(Тексты.Шаблон("office.home.space.packages",
		Тексты.ЧислоТекстом(СервисПакетов.КоличествоПакетовПула(Пул.Идентификатор))));

КонецФункции

Функция ХодВПул(Знач Пул)

	Возврат Кит.Кнопка(Тексты.Текст("office.home.space.open")).Вторичная().Иконка("вправо")
		.Адрес(Страницы.Пула(Строка(Пул.Имя)));

КонецФункции

// BSLLS:MissingParameterDescription-on
// BSLLS:MissingReturnedValueDescription-on
#КонецОбласти

&Прозвище("ВитринаМоегоПространства")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "ЗаполнениеПула") _Заполнение,
	&Пластилин(Значение = "ОбъемТекстом") _Объемы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы) Экспорт

	Кит = _Кит;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	Заполнение = _Заполнение;
	Объемы = _Объемы;
	Тексты = _Тексты;
	Страницы = _Страницы;

КонецПроцедуры
