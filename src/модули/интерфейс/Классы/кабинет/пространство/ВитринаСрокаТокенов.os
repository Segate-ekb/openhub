// Секция кабинета «Токены на исходе»: ключи, которые уже истекли либо истекут на днях.

Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем СервисТокенов;  // СервисТокенов (вход) — ключи владельца
Перем Дом;            // ДомАккаунта — адрес раздела токенов
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Даты;  // ДатаЧеловеку — одно написание момента на весь интерфейс

#Область ПубличныйИнтерфейс

// Секция «Токены на исходе». Ни одного такого ключа — секции нет вовсе: предупреждение
// без повода приучает его не читать.
//
// Параметры:
//  Пользователь - Пользователь - смотрящий.
//
// Возвращаемое значение:
//  ЭлементЭкрана, Неопределено - секция Кит.Секция либо Неопределено при отсутствии
//                                истёкших и истекающих ключей.
//
Функция СекцияСводки(Знач Пользователь) Экспорт

	Строки = НаИсходе(Пользователь);
	Если Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Секция(Тексты.Шаблон("office.home.keys.title", Тексты.ЧислоТекстом(Строки.Количество())),
			ТаблицаКлючей(Строки))
		.Лид(Тексты.Текст("office.home.keys.lead")).Иконка("ключ")
		.Действия(Кит.Кнопка(Тексты.Текст("office.home.keys.open")).Вторичная().Иконка("вправо")
			.Адрес(Дом.АдресРаздела("tokens")));

КонецФункции

#КонецОбласти

#Область ОтборКлючей

// Две недели — столько, чтобы успеть выпустить новый ключ и переставить его в CI.
Функция ПорогДней()
	Возврат 14;
КонецФункции

// Ключ без срока в отбор не идёт: он не истекает, и предупреждать не о чем.
Функция НаИсходе(Знач Пользователь)

	Если Пользователь = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Сейчас = ТекущаяУниверсальнаяДата();
	Граница = Сейчас + ПорогДней() * 24 * 60 * 60;

	Результат = Новый Массив();

	Для Каждого Ключ Из СервисТокенов.ТокеныПользователя(Пользователь.Идентификатор) Цикл

		Если НЕ ЗначениеЗаполнено(Ключ.Истекает) ИЛИ Ключ.Истекает > Граница Тогда
			Продолжить;
		КонецЕсли;

		ВставитьПоСроку(Результат, Новый Структура("Имя, Префикс, Истекает, Истёк",
			Ключ.Имя, Ключ.Префикс, Ключ.Истекает, Ключ.Истекает <= Сейчас));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Самый горящий ключ сверху; ключей единицы, поэтому место находится вставкой.
Процедура ВставитьПоСроку(Строки, Знач Новая)

	Для Индекс = 0 По Строки.ВГраница() Цикл
		Если Новая.Истекает < Строки[Индекс].Истекает Тогда
			Строки.Вставить(Индекс, Новая);
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Строки.Добавить(Новая);

КонецПроцедуры

#КонецОбласти

#Область Разметка

// На узком экране — карточки с именем ключа заглавием; срок и состояние — плашкой цвета,
// как в разделе «Токены доступа».
Функция ТаблицаКлючей(Знач Строки)

	Записи = Новый Массив();
	Для Каждого Ключ Из Строки Цикл
		Записи.Добавить(Новый Структура("name, prefix, until, state",
			?(ЗначениеЗаполнено(Ключ.Имя), Строка(Ключ.Имя), Тексты.Текст("office.home.keys.noname")),
			Кит.Код(Строка(Ключ.Префикс)),
			Даты.ТолькоДата(Ключ.Истекает),
			Состояние(Ключ)));
	КонецЦикла;

	Таблица = Кит.Таблица(Записи).Вид("карточками");
	Таблица.Колонка("name", Тексты.Текст("office.home.keys.col.name")).Заглавная();
	Таблица.Колонка("prefix", Тексты.Текст("office.home.keys.col.prefix"));
	Таблица.Колонка("until", Тексты.Текст("office.home.keys.col.until"));
	Таблица.Колонка("state", Тексты.Текст("office.home.keys.col.state")).БезПодписиВЗаписи();
	Возврат Таблица;

КонецФункции

Функция Состояние(Знач Ключ)
	Если Ключ.Истёк Тогда
		Возврат Кит.Плашка(Тексты.Текст("office.home.keys.state.expired")).Вид("err");
	КонецЕсли;
	Возврат Кит.Плашка(Тексты.Текст("office.home.keys.state.soon")).Вид("warn");
КонецФункции

#КонецОбласти

&Прозвище("ВитринаСрокаТокенов")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисТокенов") _СервисТокенов,
	&Пластилин(Значение = "ДомАккаунта") _Дом,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено) Экспорт

	Кит = _Кит;
	СервисТокенов = _СервисТокенов;
	Дом = _Дом;
	Тексты = _Тексты;
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);

КонецПроцедуры
