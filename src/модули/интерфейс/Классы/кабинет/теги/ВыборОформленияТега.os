// Поля стиля и значка в окне тега вместе с их подписями.

Перем Кит;         // Кит (кит) — фабрика элементов экрана
Перем Стили;       // СтильТега (реестр) — единственный словарь стилей плашки
Перем Значки;      // ЗначокТега (реестр) — единственный словарь значков плашки
Перем Тексты;      // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Поля;        // ПоляТега — имена полей окна тега

#Область ПубличныйИнтерфейс

// Поля оформления: стиль сегментами и значок сеткой кита. Оформление — свойство ТЕГА, а не вида
// правила, поэтому поля стоят при любом виде.
//
// Параметры:
//  Выбранное - Структура - Стиль и Значок, которые поля показывают выбранными.
//
// Возвращаемое значение:
//  ЭлементЭкрана - холст с двумя полями.
//
Функция Поля(Знач Выбранное) Экспорт
	Возврат Кит.Холст(ВыборСтиля(Выбранное), ВыборЗначка(Выбранное));
КонецФункции

#КонецОбласти

#Область ПоляОформления

// Стиль называет смысл канала, а не краску: цвет даёт тема, вид плашки — ОформлениеТега.
Функция ВыборСтиля(Знач Выбранное)

	Выбор = Кит.Сегменты(Поля.ИмяПоляСтиля()).Подпись(Тексты.Текст("settings.package.tag-new.style.label"))
		.Выбрано(Стили.Нормализовать(Выбранное.Стиль));
	Для Каждого Ключ Из Стили.Все() Цикл
		Выбор.Добавить(Кит.Сегмент(Ключ, ПодписьСтиля(Ключ)));
	КонецЦикла;
	Возврат Выбор;

КонецФункции

// Значок — из коллекции кита сеткой: глиф берёт цвет стиля, логотип бренда — свой цвет.
Функция ВыборЗначка(Знач Выбранное)

	Возврат Кит.Поле(Поля.ИмяПоляЗначка(), Тексты.Текст("settings.package.tag-new.icon.label"))
		.ВыборЗначка().Пусто(Тексты.Текст("settings.package.tag-new.icon.none"))
		.Значение(Значки.ИмяКита(Выбранное.Значок))
		.Подсказка(Тексты.Текст("settings.package.tag-new.icon.hint"));

КонецФункции

#КонецОбласти

#Область Подписи

// Подписи перечислены поимённо: скан ключей видит литералы, и вычисленный ключ для него дыра.
Функция ПодписьСтиля(Знач Ключ)

	Если Ключ = Стили.Стабильный() Тогда
		Возврат Тексты.Текст("settings.package.tag-new.style.stable");
	ИначеЕсли Ключ = Стили.Предварительный() Тогда
		Возврат Тексты.Текст("settings.package.tag-new.style.prerelease");
	ИначеЕсли Ключ = Стили.Устаревший() Тогда
		Возврат Тексты.Текст("settings.package.tag-new.style.deprecated");
	ИначеЕсли Ключ = Стили.Особый() Тогда
		Возврат Тексты.Текст("settings.package.tag-new.style.special");
	КонецЕсли;

	Возврат Тексты.Текст("settings.package.tag-new.style.plain");

КонецФункции

#КонецОбласти

&Прозвище("ВыборОформленияТега")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СтильТега") _Стили,
	&Пластилин(Значение = "ЗначокТега") _Значки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПоляТега") _Поля) Экспорт

	Кит = _Кит;
	Стили = _Стили;
	Значки = _Значки;
	Тексты = _Тексты;
	Поля = _Поля;

КонецПроцедуры
