// Окно тега пула и пакета: «Новый тег» двумя шагами — «Правило» и «Оформление», — «Изменить» —
// те же шаги вкладками. Поля выражения стоят в наборе своего вида; набранное и отказы отбитой
// формы окно берёт у состояния окна раздела, состав канала — у пробы правила.

Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем Окна;          // ОкноРаздела — набранное и отказы окна
Перем Поля;          // ПоляТега — имена полей
Перем Конструкторы;  // КонструкторТега — коды видов тега
Перем Оформление;    // ВыборОформленияТега — поля стиля и значка
Перем Плашки;        // ПлашкаТега — студия тега и живое превью плашки
Перем Тексты;        // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Окно «Новый тег»: печатается на странице всегда, открытым — по адресу ?окно=новый или
// с отбитой формой; кнопка к нему без скрипта ведёт на этот адрес.
//
// Параметры:
//  Исходное - Структура - состояние конструктора нового тега (КонструкторТега.ДляТегаПакета или ДляТегаПула без тега).
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//  Опции - Структура - см. ОпцииОкна; АдресОкна — адрес страницы с этим окном открытым.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел окна.
//
Функция Заведение(Знач Исходное, Знач Состояние, Знач Опции) Экспорт

	Возврат Кит.Окно(Опции.Заголовок,
			ОшибкаОкна(Состояние),
			Кит.Шаги(
				ШагПравила(Исходное, Состояние, Опции, ПолеИмени(Состояние, Опции)),
				ШагОформления(Исходное, Состояние))
				.Кнопка(Опции.Кнопка))
		.Лид(Опции.Лид)
		.Форма("").БезПерезагрузки().Якорь(Опции.Якорь)
		.Адрес(Опции.АдресОкна).Открыто(Окна.Открыто(Состояние, "новый")).АдресЗакрытия(Опции.АдресЗакрытия);

КонецФункции

// Окно «Изменить» тега: те же шаги вкладками; имя тега — его ключ, оно не меняется.
//
// Параметры:
//  Исходное - Структура - состояние конструктора тега (КонструкторТега.ДляТегаПакета/ДляТегаПула).
//  Состояние - Структура, Неопределено - состояние окна раздела.
//  Опции - Структура - см. ОпцииОкна; Хвост — адрес формы «<тег>/save».
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел окна, напечатанный открытым.
//
Функция Правка(Знач Исходное, Знач Состояние, Знач Опции) Экспорт

	// имя едет скрытым полем только ради живой плашки: пульт берёт его из адреса
	Возврат Кит.Окно(Опции.Заголовок,
			ОшибкаОкна(Состояние),
			Кит.СкрытоеПоле(Поля.ИмяПоляИмени(), Исходное.Имя),
			Кит.Шаги(
				ШагПравила(Исходное, Состояние, Опции, Неопределено),
				ШагОформления(Исходное, Состояние))
				.Вид("вкладки").Кнопка(Опции.Кнопка))
		.Лид(Опции.Лид)
		.Форма(Опции.Хвост).БезПерезагрузки().Якорь(Опции.Якорь).Открыто().АдресЗакрытия(Опции.АдресЗакрытия);

КонецФункции

// Пустые опции окна тега: вызывающий заполняет то, что у его дома своё.
//
// Возвращаемое значение:
//  Структура - Заголовок, Лид, Кнопка (подпись отправки), Якорь, АдресОкна (адрес страницы
//              с окном нового тега открытым), АдресЗакрытия (раздел без окна: туда окно
//              закрывается), Хвост (адрес формы правки),
//              Ручной (Булево — есть ли вид «ручной», у пула его нет), АдресПроверки (адрес
//              проверки имени на сервере; "" — не спрашивать), АдресПроверкиПравила (то же
//              для выражения), Проба (Булево —
//              есть ли кнопка «Проверить состав»), Предпросмотр (Структура, Неопределено —
//              итог пробы правила, СервисТегов.ПредпросмотрПравила), ПодписьОсновного,
//              ПодсказкаОсновного.
//
Функция ОпцииОкна() Экспорт

	Возврат Новый Структура("Заголовок, Лид, Кнопка, Якорь, АдресОкна, АдресЗакрытия, Хвост, Ручной,
		|АдресПроверки, АдресПроверкиПравила, Проба, Предпросмотр, ПодписьОсновного, ПодсказкаОсновного",
		"", "", "", "", "", "", "", Ложь, "", "", Ложь, Неопределено,
		Тексты.Текст("settings.tags.field.default.label"),
		Тексты.Текст("settings.tags.field.default.hint"));

КонецФункции

// Состав канала словами: какую версию отдаст тег и какие версии под ним, отозванные с пометкой.
//
// Параметры:
//  Предпросмотр - Структура - итог пробы правила (СервисТегов.ПредпросмотрПравила).
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел состава.
//
Функция Состав(Знач Предпросмотр) Экспорт

	Если Предпросмотр.Совпадения.Количество() = 0 Тогда
		Возврат Кит.Уведомление(Тексты.Текст("settings.package.tag-new.preview.empty")).Вид("warn");
	КонецЕсли;

	Возврат Кит.Холст(
		Кит.Свойства(
			Кит.Свойство(Тексты.Текст("settings.package.tag-new.preview.serves"),
				Отдаваемая(Предпросмотр.Версия)),
			Кит.Свойство(Тексты.Текст("settings.package.tag-new.preview.under"),
				СовпавшиеВерсии(Предпросмотр))),
		Кит.Уведомление(Предпросмотр.Предупреждение).Вид("warn")
			.Когда(ЗначениеЗаполнено(Предпросмотр.Предупреждение)));

КонецФункции

// Выражение правила для строки списка: длинное распирало бы колонку — в строке начало,
// целиком — в подсказке и в окне правки.
//
// Параметры:
//  Выражение - Строка - выражение правила.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел кода.
//
Функция ПравилоКоротко(Знач Выражение) Экспорт

	Предел = 32;
	Если СтрДлина(Выражение) <= Предел Тогда
		Возврат Кит.Код(Выражение);
	КонецЕсли;
	Возврат Кит.Код(Лев(Выражение, Предел - 1) + "…").Подсказка(Выражение);

КонецФункции

#КонецОбласти

#Область ШагПравила

Функция ШагПравила(Знач Исходное, Знач Состояние, Знач Опции, Знач ПолеИмени)

	Шаг = Кит.Шаг(Тексты.Текст("settings.tags.step.rule"),
		ПолеИмени,
		ВыборВида(Исходное, Состояние, Опции),
		ТумблерОсновного(Исходное, Состояние, Опции),
		ТумблерЗапрета(Исходное, Состояние));

	// окно с итогом пробы открывается там, где его просили
	Если Опции.Предпросмотр <> Неопределено Тогда
		Шаг.Текущий();
	КонецЕсли;
	Возврат Шаг;

КонецФункции

// Имя тега — только у нового: у заведённого оно ключ и стоит в заголовке окна.
Функция ПолеИмени(Знач Состояние, Знач Опции)

	Имя = Поля.ИмяПоляИмени();
	Поле = Кит.Поле(Имя, Тексты.Текст("settings.package.tag-new.name.label"))
		.Значение(Окна.Значение(Состояние, Имя))
		.Обязательное().Длина(1, Поля.ДлинаИмени()).Шаблон(Поля.ОбразецИмени())
		.Пример("lts")
		.Подсказка(Тексты.Текст("settings.tags.field.name.hint"))
		.Ошибка(Окна.Отказ(Состояние, Имя));
	Если ЗначениеЗаполнено(Опции.АдресПроверки) Тогда
		Поле.ПроверкаНаСервере(Опции.АдресПроверки);
	КонецЕсли;
	Возврат Поле;

КонецФункции

// Поля выражения и состав канала — в наборе своего вида: на экране остаётся набор выбранного,
// и без скрипта тоже, а смена сегмента прячет состав чужого вида вместе с его полем.
Функция ВыборВида(Знач Исходное, Знач Состояние, Знач Опции)

	ИмяВида = Поля.ИмяПоляВида();
	Выбранный = Окна.Значение(Состояние, ИмяВида, Конструкторы.КодВида(Исходное.Режим, Исходное.Тип));
	Выбор = Кит.Сегменты(ИмяВида,
			Кит.Сегмент(Конструкторы.ВидSemver(), Тексты.Текст("settings.tags.kind.semver"),
				ПолеПравила(Исходное, Состояние, Опции, Конструкторы.ВидSemver(), "^1.2",
					Тексты.Текст("settings.package.tag-new.rule.semver.hint")),
				ПредупреждениеСменыРежима(Исходное, Конструкторы.ВидSemver()),
				КнопкаПробы(Опции),
				СоставПробы(Опции, Конструкторы.ВидSemver(), Выбранный)),
			Кит.Сегмент(Конструкторы.ВидRegex(), Тексты.Текст("settings.tags.kind.regex"),
				ПолеПравила(Исходное, Состояние, Опции, Конструкторы.ВидRegex(), "^1\.2\..*$",
					Тексты.Текст("settings.package.tag-new.rule.regex.hint")),
				ПредупреждениеСменыРежима(Исходное, Конструкторы.ВидRegex()),
				КнопкаПробы(Опции),
				СоставПробы(Опции, Конструкторы.ВидRegex(), Выбранный)))
		.Подпись(Тексты.Текст("settings.tags.kind.label"))
		.Выбрано(Выбранный);

	Если Опции.Ручной Тогда
		Выбор.Добавить(Кит.Сегмент(Конструкторы.ВидРучной(), Тексты.Текст("settings.tags.kind.manual"),
			Кит.Примечание(Тексты.Текст("settings.tags.kind.manual.note")),
			ПредупреждениеСменыРежима(Исходное, Конструкторы.ВидРучной())));
	КонецЕсли;
	Возврат Выбор;

КонецФункции

// Выражение не обязательное словом поля: спрятанное в чужом наборе, оно не пустило бы форму.
// Пустое выражение выбранного вида отбивает сервер.
Функция ПолеПравила(Знач Исходное, Знач Состояние, Знач Опции, Знач Вид, Знач Пример, Знач Справка)

	Имя = Поля.ИмяПоляПравила(Вид);
	Действующее = ?(Конструкторы.КодВида(Исходное.Режим, Исходное.Тип) = Вид, Исходное.Правило, "");
	Поле = Кит.Поле(Имя, Тексты.Текст("settings.tags.field.rule"))
		.Значение(Окна.Значение(Состояние, Имя, Действующее))
		.Длина(1, 200).Пример(Пример).Справка(Справка)
		.Ошибка(Окна.Отказ(Состояние, Имя));
	Если ЗначениеЗаполнено(Опции.АдресПроверкиПравила) Тогда
		Поле.ПроверкаНаСервере(Опции.АдресПроверкиПравила);
	КонецЕсли;
	Возврат Поле;

КонецФункции

// Проба идёт той же формой, но правило не пишет: окно возвращается с составом канала.
Функция КнопкаПробы(Знач Опции)

	Если НЕ Опции.Проба Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Кнопка(Тексты.Текст("settings.package.tag-new.check.button")).Вторичная().Малая()
		.Иконка("поиск").Имя(Поля.ИмяПоляОперации(), Поля.ОперацияПроверки()).БезВалидации();

КонецФункции

// Состав принадлежит виду, для которого его считали: он стоит в наборе этого вида и только
// тогда, когда этот вид выбран. У ручного тега состава нет — его набор состава не несёт.
Функция СоставПробы(Знач Опции, Знач Вид, Знач Выбранный)

	Предпросмотр = Опции.Предпросмотр;
	Если Предпросмотр = Неопределено
		ИЛИ Конструкторы.ВидСостава(Предпросмотр) <> Вид
		ИЛИ НРег(СокрЛП(Выбранный)) <> Вид Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Состав(Предпросмотр);

КонецФункции

// Смена вида у заведённого тега меняет состав канала: говорится об этом в наборе того вида,
// на который её меняют, — до сохранения.
Функция ПредупреждениеСменыРежима(Знач Исходное, Знач Вид)

	Если НЕ Исходное.Правится ИЛИ НЕ ЗначениеЗаполнено(Исходное.РежимДо) Тогда
		Возврат Неопределено;
	КонецЕсли;

	КРучному = Вид = Конструкторы.ВидРучной();
	БылРучным = Исходное.РежимДо = Конструкторы.ПараИзВида(Конструкторы.ВидРучной()).Режим;
	Если КРучному И НЕ БылРучным Тогда
		Возврат Кит.Уведомление(Тексты.Шаблон("settings.package.tag-new.save.switch.manual",
			Исходное.Имя)).Вид("warn");
	ИначеЕсли НЕ КРучному И БылРучным Тогда
		Возврат Кит.Уведомление(Тексты.Шаблон("settings.package.tag-new.save.switch.rule",
			Исходное.Имя)).Вид("warn");
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Основной снимается только назначением другого тега: у основного тумблер включён и закрыт.
Функция ТумблерОсновного(Знач Исходное, Знач Состояние, Знач Опции)

	Имя = Поля.ИмяПоляОсновного();
	Тумблер = Кит.Тумблер(Имя, Опции.ПодписьОсновного)
		.Включено(Окна.Отмечено(Состояние, Имя, Исходное.ПоУмолчанию ИЛИ Исходное.БылоПоУмолчанию,
			Поля.ЗначениеОтмечено()))
		.Значения(Поля.ЗначениеОтмечено(), Поля.ЗначениеСнято())
		.Подписи(Тексты.Текст("settings.value.on"), Тексты.Текст("settings.value.off"));
	Если Исходное.БылоПоУмолчанию Тогда
		Тумблер.Включено().Заблокировано()
			.Подсказка(Опции.ПодсказкаОсновного + " " + Тексты.Текст("settings.tags.field.default.locked"));
	Иначе
		Тумблер.Подсказка(Опции.ПодсказкаОсновного);
	КонецЕсли;
	Возврат Тумблер;

КонецФункции

Функция ТумблерЗапрета(Знач Исходное, Знач Состояние)

	Имя = Поля.ИмяПоляЗапрета();
	Возврат Кит.Тумблер(Имя, Тексты.Текст("settings.package.tag-new.repush.label"))
		.Включено(Окна.Отмечено(Состояние, Имя, Исходное.ЗапретПерезаписи, Поля.ЗначениеОтмечено()))
		.Значения(Поля.ЗначениеОтмечено(), Поля.ЗначениеСнято())
		.Подписи(Тексты.Текст("settings.value.on"), Тексты.Текст("settings.value.off"))
		.Подсказка(Тексты.Текст("settings.tags.field.repush.hint"));

КонецФункции

#КонецОбласти

#Область ШагОформления

// Поля стиля и значка — в студии рядом с образцом плашки, который зеркалит их выбор.
Функция ШагОформления(Знач Исходное, Знач Состояние)

	Выбранное = Новый Структура("Имя, Стиль, Значок",
		Окна.Значение(Состояние, Поля.ИмяПоляИмени(), Исходное.Имя),
		Окна.Значение(Состояние, Поля.ИмяПоляСтиля(), Исходное.Стиль),
		Окна.Значение(Состояние, Поля.ИмяПоляЗначка(), Исходное.Значок));

	Студия = Плашки.Студия();
	Студия.Добавить(Кит.Область(Оформление.Поля(Выбранное)).Вид("работа"));
	Студия.Добавить(Плашки.Предпросмотр(Выбранное, Новый Структура("Имя, Стиль, Значок",
		Поля.ИмяПоляИмени(), Поля.ИмяПоляСтиля(), Поля.ИмяПоляЗначка())));

	Возврат Кит.Шаг(Тексты.Текст("settings.tags.step.look"), Студия);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отказ, который не относится к одному полю, — над шагами.
Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

Функция Отдаваемая(Знач Версия)

	Если НЕ ЗначениеЗаполнено(Версия) Тогда
		Возврат Кит.Текст(Тексты.Текст("settings.package.tag-new.preview.nothing"));
	КонецЕсли;
	Возврат Кит.Код(Строка(Версия));

КонецФункции

// Отозванная несёт свою плашку: правило её захватило, а установка её не выбирает.
Функция СовпавшиеВерсии(Знач Предпросмотр)

	Отозванные = Новый Соответствие();
	Для Каждого СтрокаОтозванной Из Предпросмотр.Отозванные Цикл
		Отозванные.Вставить(Строка(СтрокаОтозванной), Истина);
	КонецЦикла;

	Результат = Кит.Холст();
	Для Каждого СтрокаВерсии Из Предпросмотр.Совпадения Цикл
		Если Результат.Дети().Количество() > 0 Тогда
			Результат.Добавить(Кит.Текст(", "));
		КонецЕсли;
		Результат.Добавить(Кит.Код(Строка(СтрокаВерсии)));
		Если Отозванные.Получить(Строка(СтрокаВерсии)) = Истина Тогда
			Результат.Добавить(Кит.Плашка(Тексты.Текст("settings.package.versions.yanked")).Вид("warn"));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ОкноТега")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ПоляТега") _Поля,
	&Пластилин(Значение = "КонструкторТега") _Конструкторы,
	&Пластилин(Значение = "ВыборОформленияТега") _Оформление,
	&Пластилин(Значение = "ПлашкаТега") _Плашки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Окна = _Окна;
	Поля = _Поля;
	Конструкторы = _Конструкторы;
	Оформление = _Оформление;
	Плашки = _Плашки;
	Тексты = _Тексты;

КонецПроцедуры
