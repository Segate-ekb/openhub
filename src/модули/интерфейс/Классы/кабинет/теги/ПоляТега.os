// Имена и значения полей окон тега пула и пакета: одни на печать, на проверку до отправки и на разбор.

#Область ПубличныйИнтерфейс

// Имя поля формы «имя» — имя нового тега.
//
// Возвращаемое значение:
//  Строка - имя поля.
//
Функция ИмяПоляИмени() Экспорт
	Возврат "имя";
КонецФункции

// Имя поля сегментов «вид»: правило semver, правило regex или ручной тег.
//
// Возвращаемое значение:
//  Строка - имя поля.
//
Функция ИмяПоляВида() Экспорт
	Возврат "вид";
КонецФункции

// Имя поля выражения в наборе своего вида: у semver и regex выражение разное, и поле —
// своё в каждом наборе.
//
// Параметры:
//  Вид - Строка - код вида правила: semver или regex.
//
// Возвращаемое значение:
//  Строка - имя поля.
//
Функция ИмяПоляПравила(Знач Вид) Экспорт
	Возврат "правило_" + НРег(СокрЛП(Вид));
КонецФункции

// Имя поля сегментов «стиль».
//
// Возвращаемое значение:
//  Строка - имя поля.
//
Функция ИмяПоляСтиля() Экспорт
	Возврат "стиль";
КонецФункции

// Имя поля выбора «значок».
//
// Возвращаемое значение:
//  Строка - имя поля.
//
Функция ИмяПоляЗначка() Экспорт
	Возврат "значок";
КонецФункции

// Имя тумблера «тег по умолчанию» (у пула — «основной тег пула»).
//
// Возвращаемое значение:
//  Строка - имя поля.
//
Функция ИмяПоляОсновного() Экспорт
	Возврат "по_умолчанию";
КонецФункции

// Имя тумблера «запрет повторной публикации».
//
// Возвращаемое значение:
//  Строка - имя поля.
//
Функция ИмяПоляЗапрета() Экспорт
	Возврат "запрет_перезаписи";
КонецФункции

// Имя эхо-поля подтверждения удаления: в него набирают имя тега.
//
// Возвращаемое значение:
//  Строка - имя поля.
//
Функция ИмяПоляЭха() Экспорт
	Возврат "тег";
КонецФункции

// Имя поля, которым кнопка называет операцию формы раздела.
//
// Возвращаемое значение:
//  Строка - имя поля.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Операция формы тумблера «теги пула для пакетов»; это же имя у самого тумблера.
//
// Возвращаемое значение:
//  Строка - значение поля операции.
//
Функция ОперацияГалки() Экспорт
	Возврат "теги_пула";
КонецФункции

// Операция «проверить состав»: правило не записывается, окно возвращается с составом канала.
//
// Возвращаемое значение:
//  Строка - значение поля операции.
//
Функция ОперацияПроверки() Экспорт
	Возврат "проверить";
КонецФункции

// Значение отмеченного тумблера; снятый шлёт «0» — по нему снятое отличают от неприсланного.
//
// Возвращаемое значение:
//  Строка - значение.
//
Функция ЗначениеОтмечено() Экспорт
	Возврат "1";
КонецФункции

// Значение снятого тумблера.
//
// Возвращаемое значение:
//  Строка - значение.
//
Функция ЗначениеСнято() Экспорт
	Возврат "0";
КонецФункции

// Образец имени тега для проверки до отправки — тот же алфавит, что у домена; регистр домен
// сводит сам, поэтому браузер заглавных не отбивает.
//
// Возвращаемое значение:
//  Строка - образец для атрибута pattern.
//
Функция ОбразецИмени() Экспорт
	Возврат "[A-Za-z0-9_.\-]+";
КонецФункции

// Предел длины имени тега у домена.
//
// Возвращаемое значение:
//  Число - символов.
//
Функция ДлинаИмени() Экспорт
	Возврат 64;
КонецФункции

#КонецОбласти

&Прозвище("ПоляТега")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
