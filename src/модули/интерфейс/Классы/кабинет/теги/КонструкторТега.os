// Состояние окна тега пула и пакета: режим, тип правила, введённое, оформление и словарь
// видов тега.

Перем СервисТегов;  // СервисТегов (реестр) — существующий тег с таким именем
Перем Режимы;       // РежимТега (реестр) — единственный словарь режимов
Перем Типы;         // ТипПравилаТега (реестр) — единственный словарь типов правил
Перем Стили;        // СтильТега (реестр) — единственный словарь стилей плашки
Перем Значки;       // ЗначокТега (реестр) — единственный словарь значков плашки
Перем Разбор;       // РазборФормы — поля разобранной формы
Перем Поля;         // ПоляТега — имена полей окна тега

#Область ПубличныйИнтерфейс

// Состояние окна тега пакета: тег с таким именем уже есть — правка, поля заполнены его
// значениями; унаследованный от пула правится так же — сохранение заведёт у пакета копию.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  ИмяТега - Строка - имя тега; "" — заводится новый.
//
// Возвращаемое значение:
//  Структура - состояние конструктора: Режим, Тип, Имя, Правило, Стиль, Значок, ПоУмолчанию,
//              ЗапретПерезаписи, Правится, РежимДо, БылоПоУмолчанию.
//
Функция ДляТегаПакета(Знач ПакетИдентификатор, Знач ИмяТега) Экспорт

	Тег = ?(ЗначениеЗаполнено(ИмяТега),
		СервисТегов.НайтиДействующийТег(ПакетИдентификатор, ИмяТега), Неопределено);
	Если Тег = Неопределено Тогда
		Возврат Новое(Режимы.Правило(), Типы.Semver(), ИмяТега, "", Неопределено);
	КонецЕсли;

	Режим = ?(Режимы.ЭтоПравило(Тег.Режим), Режимы.Правило(), Режимы.Ручной());
	Тип = Типы.ДляПоказа(?(ЗначениеЗаполнено(Тег.ТипПравила), Тег.ТипПравила, Типы.Semver()));

	Состояние = Новое(Режим, Тип, Тег.Имя, Строка(Тег.Правило),
		Новый Структура("Стиль, Значок", Тег.Стиль, Тег.Значок));
	Состояние.Правится = Истина;
	Состояние.РежимДо = Строка(Тег.Режим);
	Состояние.ПоУмолчанию = (Тег.ПоУмолчанию = Истина);
	Состояние.БылоПоУмолчанию = (Тег.ПоУмолчанию = Истина);
	Состояние.ЗапретПерезаписи = НЕ СервисТегов.ЗапретСнят(Тег);
	Возврат Состояние;

КонецФункции

// Состояние окна тега пула: тег пула уже есть — правка, поля заполнены его значениями.
// Ручного вида у тега пула нет.
//
// Параметры:
//  ТегПула - ТегПула, Неопределено - существующий тег пула; Неопределено — заводится новый.
//
// Возвращаемое значение:
//  Структура - состояние конструктора (см. ДляТегаПакета).
//
Функция ДляТегаПула(Знач ТегПула) Экспорт

	Если ТегПула = Неопределено Тогда
		Возврат Новое(Режимы.Правило(), Типы.Semver(), "", "", Неопределено);
	КонецЕсли;

	Состояние = Новое(Режимы.Правило(), ТегПула.ТипПравила, ТегПула.Имя, ТегПула.Правило,
		Новый Структура("Стиль, Значок", ТегПула.Стиль, ТегПула.Значок));
	Состояние.Правится = Истина;
	Состояние.ПоУмолчанию = (ТегПула.ПоУмолчанию = Истина);
	Состояние.БылоПоУмолчанию = (ТегПула.ПоУмолчанию = Истина);
	Состояние.ЗапретПерезаписи = НЕ (ТегПула.ПерезаписьРазрешена = Истина);
	Возврат Состояние;

КонецФункции

// Состояние, набранное в окне тега: вид, выражение пришедшего вида, оформление и тумблеры.
// Поля чужих наборов не читаются: они уходят с формой со своими умолчаниями.
//
// Параметры:
//  Форма - Соответствие - разобранная форма окна.
//  ИмяТега - Строка - имя тега: у нового — из формы, у правки — из адреса.
//
// Возвращаемое значение:
//  Структура - состояние конструктора (см. ДляТегаПакета) и Вид (Строка — код вида, как пришёл).
//
Функция ИзФормы(Знач Форма, Знач ИмяТега) Экспорт

	Вид = НРег(СокрЛП(Разбор.Поле(Форма, Поля.ИмяПоляВида())));
	Пара = ПараИзВида(Вид);
	Выражение = ?(Пара.Режим = Режимы.Ручной(), "",
		СокрЛП(Разбор.Поле(Форма, Поля.ИмяПоляПравила(КодВида(Пара.Режим, Пара.Тип)))));
	Оформление = Новый Структура("Стиль, Значок",
		Разбор.Поле(Форма, Поля.ИмяПоляСтиля()), Разбор.Поле(Форма, Поля.ИмяПоляЗначка()));

	Состояние = Новое(Пара.Режим, Пара.Тип, СокрЛП(ИмяТега), Выражение,
		?(ОформлениеДопустимо(Оформление), Оформление, Неопределено));
	Состояние.ПоУмолчанию = Разбор.Флажок(Форма, Поля.ИмяПоляОсновного(), Поля.ЗначениеОтмечено());
	Состояние.ЗапретПерезаписи = ЗапретИзФормы(Форма);
	Состояние.Вставить("Вид", Вид);
	Состояние.Вставить("ОформлениеФормы", Оформление);
	Возврат Состояние;

КонецФункции

// Единственное место, где ОДИН выбор формы раскладывается в доменную пару «режим + тип
// правила»: в базе и в API это два разных поля. Неизвестное значение сводится
// к semver-правилу, а не роняет экран.
//
// Параметры:
//  Значение - Строка - код вида тега.
//
// Возвращаемое значение:
//  Структура - Режим, Тип.
//
Функция ПараИзВида(Знач Значение) Экспорт

	Норм = НРег(СокрЛП(Строка(Значение)));

	Если Норм = ВидРучной() ИЛИ Норм = Режимы.Ручной() Тогда
		Возврат Новый Структура("Режим, Тип", Режимы.Ручной(), Типы.Semver());
	КонецЕсли;

	Возврат Новый Структура("Режим, Тип", Режимы.Правило(), Типы.ДляПоказа(Норм));

КонецФункции

// Обратный перевод пары в код вида: он же значение варианта в списке и в адресе.
//
// Параметры:
//  Режим - Строка - режим тега.
//  Тип - Строка - тип правила.
//
// Возвращаемое значение:
//  Строка - код вида тега.
//
Функция КодВида(Знач Режим, Знач Тип) Экспорт
	Возврат ?(Режим = Режимы.Ручной(), ВидРучной(), Типы.ДляПоказа(Тип));
КонецФункции

// Допустим ли код вида из формы. Пустое значение — «поле не прислали», оно сводится
// к semver-правилу; незнакомое непустое — подделка формы, и её судит сервер.
//
// Параметры:
//  Значение - Строка - код вида тега из формы.
//
// Возвращаемое значение:
//  Булево - допустим ли вид.
//
Функция ВидДопустим(Знач Значение) Экспорт
	Норм = НРег(СокрЛП(Строка(Значение)));
	Возврат ПустаяСтрока(Норм) ИЛИ Норм = ВидРучной() ИЛИ Норм = ВидSemver() ИЛИ Норм = ВидRegex();
КонецФункции

// Стиль и значок — ключи закрытых списков: подделанное поле формы отбивается сервером.
//
// Параметры:
//  ОформлениеФормы - Структура - Стиль и Значок из формы.
//
// Возвращаемое значение:
//  Булево - допустимы ли оба ключа.
//
Функция ОформлениеДопустимо(Знач ОформлениеФормы) Экспорт
	Возврат Стили.Допустим(ОформлениеФормы.Стиль) И Значки.Допустим(ОформлениеФормы.Значок);
КонецФункции

// Оформление состояния парой «стиль + значок» — так его принимает СервисТегов.
//
// Параметры:
//  Конструктор - Структура - состояние конструктора.
//
// Возвращаемое значение:
//  Структура - Стиль, Значок.
//
Функция ПараОформления(Знач Конструктор) Экспорт
	Возврат Новый Структура("Стиль, Значок", Конструктор.Стиль, Конструктор.Значок);
КонецФункции

// Код вида, для которого посчитан состав канала: состав считает только правило, и вид — его тип.
//
// Параметры:
//  Предпросмотр - Структура - итог пробы правила (СервисТегов.ПредпросмотрПравила).
//
// Возвращаемое значение:
//  Строка - код вида тега: semver или regex.
//
Функция ВидСостава(Знач Предпросмотр) Экспорт
	Возврат КодВида(Режимы.Правило(), Предпросмотр.Тип);
КонецФункции

// Ручной ли тег в этом состоянии.
//
// Параметры:
//  Конструктор - Структура - состояние конструктора.
//
// Возвращаемое значение:
//  Булево - ручной ли тег.
//
Функция ЭтоРучной(Знач Конструктор) Экспорт
	Возврат Конструктор.Режим = Режимы.Ручной();
КонецФункции

// Код вида «ручной тег».
//
// Возвращаемое значение:
//  Строка - код вида.
//
Функция ВидРучной() Экспорт
	Возврат "manual";
КонецФункции

// Код вида «правило semver».
//
// Возвращаемое значение:
//  Строка - код вида.
//
Функция ВидSemver() Экспорт
	Возврат Типы.Semver();
КонецФункции

// Код вида «правило regex».
//
// Возвращаемое значение:
//  Строка - код вида.
//
Функция ВидRegex() Экспорт
	Возврат Типы.Regex();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Состояние окна с полями по умолчанию; оформление хранится КЛЮЧАМИ: цвет даёт тема.
Функция Новое(Знач Режим, Знач ТипПравила, Знач ИмяТега, Знач ВыражениеПравила,
	Знач ОформлениеФормы)

	Стиль = Стили.Обычный();
	Значок = Значки.Нет();
	Если ОформлениеФормы <> Неопределено Тогда
		Стиль = Стили.Нормализовать(ОформлениеФормы.Стиль);
		Значок = Значки.Нормализовать(ОформлениеФормы.Значок);
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("Режим", ?(Режим = Режимы.Ручной(), Режимы.Ручной(), Режимы.Правило()));
	Результат.Вставить("Тип", Типы.ДляПоказа(ТипПравила));
	Результат.Вставить("Имя", Строка(ИмяТега));
	Результат.Вставить("Правило", Строка(ВыражениеПравила));
	Результат.Вставить("Стиль", Стиль);
	Результат.Вставить("Значок", Значок);
	Результат.Вставить("ПоУмолчанию", Ложь);
	// у нового тега запрет повторной публикации включён — таким его и предлагает экран
	Результат.Вставить("ЗапретПерезаписи", Истина);
	Результат.Вставить("Правится", Ложь);
	Результат.Вставить("РежимДо", "");
	Результат.Вставить("БылоПоУмолчанию", Ложь);
	Возврат Результат;

КонецФункции

// Запрет держится и когда поля нет вовсе: умолчавший о тумблере запрос защиту не снимает.
Функция ЗапретИзФормы(Знач Форма)
	Прислано = Разбор.Поле(Форма, Поля.ИмяПоляЗапрета());
	Возврат Прислано = "" ИЛИ Разбор.Флажок(Форма, Поля.ИмяПоляЗапрета(), Поля.ЗначениеОтмечено());
КонецФункции

#КонецОбласти

&Прозвище("КонструкторТега")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "РежимТега") _Режимы,
	&Пластилин(Значение = "ТипПравилаТега") _Типы,
	&Пластилин(Значение = "СтильТега") _Стили,
	&Пластилин(Значение = "ЗначокТега") _Значки,
	&Пластилин(Значение = "РазборФормы") _Разбор,
	&Пластилин(Значение = "ПоляТега") _Поля) Экспорт

	СервисТегов = _СервисТегов;
	Режимы = _Режимы;
	Типы = _Типы;
	Стили = _Стили;
	Значки = _Значки;
	Разбор = _Разбор;
	Поля = _Поля;

КонецПроцедуры
