// Личное пространство — контроллер модуля web-ui: главная кабинета и сводка «входящих»
// по всем пулам, где пользователь вправе решать.

Перем Гвард;             // ГвардКабинета (кабинет)
Перем Ответы;            // ОтветыНастроек (web-ui)
Перем Дом;               // ДомАккаунта (web-ui)
Перем Рендерер;          // РендерерКабинета (web-ui)
Перем Защита;            // ЗащитаCSRF (auth)
Перем РазборФормы;       // РазборФормы (web-ui)
Перем Рассмотрение;      // РассмотрениеВходящих (публикация) — заявки, доступные принципалу
Перем ВитринаЗаявок;     // ВитринаЗаявокПула (web-ui) — разметка «входящих»
Перем ПультЗаявок;       // ПультЗаявок (web-ui) — одобрение и отклонение заявок
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем АдресаКаталога;    // АдресаКаталога (web-ui) — адрес каталога с отбором «мои»
Перем Лента;             // ЛентаУведомлений (связь) — личные события вошедшего
Перем ВитринаЛенты;      // ВитринаУведомлений (web-ui) — разметка ленты
Перем АдресаЭкранов;     // АдресаКабинета (web-ui) — адреса экранов кабинета

#Область ТочкиМаршрута

// Точка маршрута «» — корень личного пространства: карточки-входы в контексты пользователя.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//
&ТочкаМаршрута("")
Процедура ЛичноеПространство(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Пользователь = Вердикт.Пользователь;

	Контент = Рендерер.Заголовок(Пользователь.Логин, 1, "Всё, что принадлежит вам на этом хабе.")
		+ ВиджетУведомлений(Пользователь)
		+ ВиджетЗаявок(Вердикт)
		+ Входы(Пользователь);

	Ответы.ОтдатьСтраницу(Ответ, "Личное пространство", Контент, Пользователь, КукиЗапроса);

КонецПроцедуры

// Точка маршрута «inbox» — сводка заявок по всем пулам, где пользователь вправе решать.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак принятого решения из адреса (необязательный, по умолчанию "").
//
&ТочкаМаршрута("inbox")
Процедура ВходящиеЗаявки(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	saved = "") Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьСводку(Ответ, Вердикт, "", КукиЗапроса, 200, Неопределено,
			ЗначениеЗаполнено(saved));
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = РазборФормы.Разобрать(ТелоЗапроса);
	Если НЕ Защита.Проверить(Вердикт.Сессия, РазборФормы.Поле(Форма, "_csrf")) Тогда
		Ответы.ОтдатьЗапрещено(Ответ, Вердикт.Пользователь,
			Тексты.Текст("settings.inbox.error.csrf"), КукиЗапроса);
		Возврат;
	КонецЕсли;

	// пул не ограничивается: сводка ведёт все пулы принципала, а порог по каждой заявке
	// проверяет РассмотрениеВходящих
	Итог = ПультЗаявок.Применить(Вердикт.Принципал, Форма);

	Если Итог.Подтвердить <> Неопределено Тогда
		ОтдатьСводку(Ответ, Вердикт, "", КукиЗапроса, 200, Итог.Подтвердить);
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		ОтдатьСводку(Ответ, Вердикт, Итог.Ошибка, КукиЗапроса, 400);
		Возврат;
	КонецЕсли;

	Ответ.Перенаправить(АдресВходящих() + "?saved=1");

КонецПроцедуры

#КонецОбласти

#Область ПубличныйИнтерфейс

// Каталог с отбором «которыми я могу управлять» — единственное представление «моих пакетов».
//
// Возвращаемое значение:
//  Строка - каталог с отбором «которыми я могу управлять».
//
Функция АдресУправляемых() Экспорт
	Возврат АдресаКаталога.Управляемые();
КонецФункции

// Адрес сводки заявок кабинета.
//
// Возвращаемое значение:
//  Строка - адрес сводки заявок.
//
Функция АдресВходящих() Экспорт
	Возврат АдресаЭкранов.Входящие();
КонецФункции

#КонецОбласти

#Область Рендер

Процедура ОтдатьСводку(Ответ, Знач Вердикт, Знач Ошибка, Знач КукиЗапроса,
	Знач Статус = 200, Знач Решение = Неопределено, Знач Сохранено = Ложь)

	Токен = Защита.ТокенСессии(Вердикт.Сессия);

	Хлебные = Новый Массив();
	Хлебные.Добавить(Новый Структура("Подпись, Адрес",
		Вердикт.Пользователь.Логин, АдресаЭкранов.Личное()));
	Хлебные.Добавить(Новый Структура("Подпись", Тексты.Текст("settings.inbox.crumb")));

	Модель = Новый Структура();
	Модель.Вставить("Ключ", "inbox");
	Модель.Вставить("Заголовок", Тексты.Текст("settings.inbox.page.title"));
	Модель.Вставить("Объект", "");
	Модель.Вставить("Пояснение", Тексты.Текст("settings.inbox.page.lead"));
	// дерева разделов у сводки нет: она сама себе раздел, каркас без разделов их не рисует
	Модель.Вставить("Разделы", Новый Массив());
	Модель.Вставить("Уведомления", Ответы.УведомленияРаздела(Сохранено, Ошибка));
	Модель.Вставить("Хлебные", Хлебные);
	Модель.Вставить("Секции", ВитринаЗаявок.Секции(
		Новый Структура("Строки, Адрес, Токен, СПулом, Решение",
			Рассмотрение.ОжидающиеПринципала(Вердикт.Принципал),
			АдресВходящих(), Токен, Истина, Решение)));

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт.Пользователь, КукиЗапроса,
		Тексты.Текст("settings.inbox.page.title"), Статус);

КонецПроцедуры

// Виджет главной: заявок нет — разметки нет вовсе. Блок с нулём означал бы, что рядом
// что-то происходит, а происходить там нечему.
Функция ВиджетЗаявок(Знач Вердикт)

	Возврат ВитринаЗаявок.Виджет(
		Рассмотрение.ОжидающиеПринципала(Вердикт.Принципал), АдресВходящих());

КонецФункции

// То же правило: непрочитанного нет — виджета нет. Вход в ленту при этом остаётся
// карточкой личного контекста и пунктом навигации кабинета. Лента целиком не читается:
// виджету нужны единицы строк, и ровно столько у неё и спрашивают.
Функция ВиджетУведомлений(Знач Пользователь)

	Возврат ВитринаЛенты.Виджет(
		Лента.Свежие(Пользователь, ВитринаЛенты.ПределВиджета()),
		Лента.Непрочитано(Пользователь), АдресаЭкранов.Уведомления());

КонецФункции

// Карточки-входы в контексты пользователя.
Функция Входы(Знач Пользователь)

	Компоненты = Рендерер.Компоненты();

	Ячейки = Новый Массив();
	Ячейки.Добавить(Компоненты.Карточка().Отрисовать(Новый Структура(
		"Заголовок, Иконка, Описание, Действия",
		"Мои пакеты", "пакет",
		"Пакеты, которыми вы можете управлять как автор, владелец пула или мейнтейнер.",
		Компоненты.Кнопка().Отрисовать(Новый Структура("Подпись, Адрес, Иконка",
			"Открыть каталог", АдресУправляемых(), "вправо")))));

	Ячейки.Добавить(Компоненты.Карточка().Отрисовать(Новый Структура(
		"Заголовок, Иконка, Описание, Действия",
		"Личное пространство", "куб",
		"Ваш собственный пул: пакеты, опубликованные под вашим логином.",
		Компоненты.Кнопка().Отрисовать(Новый Структура("Подпись, Адрес, Вариант, Иконка",
			"Открыть пул", "/" + Строка(Пользователь.Логин), "вторичная", "вправо")))));

	Ячейки.Добавить(Компоненты.Карточка().Отрисовать(Новый Структура(
		"Заголовок, Иконка, Описание, Действия",
		Тексты.Текст("office.notifications.card.title"), "конверт",
		Тексты.Текст("office.notifications.card.lead"),
		Компоненты.Кнопка().Отрисовать(Новый Структура("Подпись, Адрес, Вариант, Иконка",
			Тексты.Текст("office.notifications.card.open"),
			АдресаЭкранов.Уведомления(), "вторичная", "вправо")))));

	Ячейки.Добавить(Компоненты.Карточка().Отрисовать(Новый Структура(
		"Заголовок, Иконка, Описание, Действия",
		"Настройки аккаунта", "шестерёнка",
		"Профиль, безопасность, токены, ключи подписи, привязки OIDC, вид и язык.",
		Компоненты.Кнопка().Отрисовать(Новый Структура("Подпись, Адрес, Вариант, Иконка",
			"Открыть настройки", Дом.БазовыйАдрес(), "вторичная", "вправо")))));

	Возврат Компоненты.Сетка().Отрисовать(
		Новый Структура("Ячейки, Колонки, Заголовок", Ячейки, 3, "Личный контекст"));

КонецФункции

#КонецОбласти

&Контроллер("/me")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _Гвард,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомАккаунта") _Дом,
	&Пластилин(Значение = "РендерерКабинета") _Рендерер,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "РассмотрениеВходящих") _Рассмотрение,
	&Пластилин(Значение = "ВитринаЗаявокПула") _ВитринаЗаявок,
	&Пластилин(Значение = "ПультЗаявок") _ПультЗаявок,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаКаталога") _АдресаКаталога,
	&Пластилин(Значение = "ЛентаУведомлений") _Лента,
	&Пластилин(Значение = "ВитринаУведомлений") _ВитринаЛенты,
	&Пластилин(Значение = "АдресаКабинета") _АдресаЭкранов)

	Гвард = _Гвард;
	Ответы = _Ответы;
	Дом = _Дом;
	Рендерер = _Рендерер;
	Защита = _Защита;
	РазборФормы = _РазборФормы;
	Рассмотрение = _Рассмотрение;
	ВитринаЗаявок = _ВитринаЗаявок;
	ПультЗаявок = _ПультЗаявок;
	Тексты = _Тексты;
	АдресаКаталога = _АдресаКаталога;
	Лента = _Лента;
	ВитринаЛенты = _ВитринаЛенты;
	АдресаЭкранов = _АдресаЭкранов;

КонецПроцедуры
