// Блок кабинета «Зеркала ваших пулов» — желудь модуля web-ui: по строке на зеркало,
// апстрим, состояние прогона и последний синк. Настраиваются зеркала в доме пула.

Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем СлужбаКабинета; // СлужбаКабинета (кабинет) — пулы в распоряжении смотрящего
Перем СервисЗеркал;   // СервисЗеркал (зеркала) — зеркала пула и вердикт «прогон брошен»
Перем Прогоны;        // ПредставлениеПрогонаЗеркала (web-ui) — прогон в виде для экрана
Перем ДомПула;        // ДомПула (web-ui) — адрес экрана состояния зеркала
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Блок «Зеркала ваших пулов». Ни одного зеркала — блока нет вовсе: пустая таблица
// обещала бы, что репликация настроена.
//
// Параметры:
//  Пользователь - Пользователь - смотрящий.
//
// Возвращаемое значение:
//  Строка - разметка блока либо "" при отсутствии зеркал.
//
Функция Блок(Знач Пользователь) Экспорт

	Строки = ЗеркалаПулов(Пользователь);
	Если Строки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Результат = Кит.Карточка(Новый Структура("Заголовок, Описание, Иконка",
		Тексты.Текст("office.home.mirrors.title"),
		Тексты.Текст("office.home.mirrors.lead"), "ссылка"));

	Результат.Добавить(ТаблицаЗеркал(Строки));
	Возврат Результат.Рендер();

КонецФункции

#КонецОбласти

#Область ОтборЗеркал

// Пулы спрашиваются у службы кабинета: порог «мейнтейнер и выше» — её договор, а не
// правило этого экрана. Райтеру, который в пул только публикует, зеркал не показывают.
Функция ЗеркалаПулов(Знач Пользователь)

	Результат = Новый Массив();

	Для Каждого Пул Из СлужбаКабинета.ПулыВРаспоряжении(Пользователь) Цикл

		Для Каждого Зеркало Из СервисЗеркал.СписокПула(Пул.Идентификатор) Цикл
			Результат.Добавить(Новый Структура("Пул, Зеркало, Прогон", Пул, Зеркало,
				Прогоны.Модель(Зеркало, СервисЗеркал.ПрогонБрошен(Зеркало))));
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Разметка

Функция ТаблицаЗеркал(Знач Строки)

	Результат = Кит.Таблица();
	Результат.Добавить(Кит.Колонка(Тексты.Текст("office.home.mirrors.col.pool")));
	Результат.Добавить(Кит.Колонка(Тексты.Текст("office.home.mirrors.col.upstream")));
	Результат.Добавить(Кит.Колонка(Тексты.Текст("office.home.mirrors.col.state")));
	Результат.Добавить(Кит.Колонка(Тексты.Текст("office.home.mirrors.col.sync")));

	Для Каждого Строка_ Из Строки Цикл
		Результат.Добавить(СтрокаЗеркала(Строка_));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СтрокаЗеркала(Знач Строка_)

	Результат = Кит.Запись();
	Результат.Добавить(ИмяПула(Строка_.Пул));
	Результат.Добавить(АдресАпстрима(Строка_.Зеркало));
	Результат.Добавить(СостояниеПрогона(Строка_));
	Результат.Добавить(Значением(МоментСинка(Строка_.Прогон)));
	Возврат Результат;

КонецФункции

Функция ИмяПула(Знач Пул)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Ссылка("/" + Строка(Пул.Имя))).Добавить(Кит.Текст(Строка(Пул.Имя)));
	Возврат Ячейка;

КонецФункции

Функция АдресАпстрима(Знач Зеркало)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Код(Строка(Зеркало.АпстримURL)));
	Возврат Ячейка;

КонецФункции

// Состояние — плашка с ходом на экран прогона в доме пула; неудача объясняется словами
// прямо здесь: иначе про сломанную репликацию человек узнаёт, только зайдя внутрь.
Функция СостояниеПрогона(Знач Строка_)

	Прогон = Строка_.Прогон;

	Ячейка = Кит.Ячейка("столбиком");
	Ячейка.Добавить(Кит.Плашка(Новый Структура("Текст, Вид, Адрес",
		Прогон.Подпись, Прогон.Вид, АдресПрогона(Строка_))));
	Ячейка.Добавить(ПричинаНеудачи(Прогон));
	Возврат Ячейка;

КонецФункции

Функция ПричинаНеудачи(Знач Прогон)

	Если НЕ ЗначениеЗаполнено(Прогон.Итог) Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Приписка = Кит.Надпись("приписка");
	Приписка.Добавить(Кит.Текст(Строка(Прогон.Итог)));
	Возврат Приписка;

КонецФункции

Функция АдресПрогона(Знач Строка_)

	Возврат ДомПула.АдресРаздела(Строка_.Пул.Имя, "mirrors")
		+ "/" + Формат(Строка_.Зеркало.Идентификатор, "ЧГ=0; ЧН=0");

КонецФункции

Функция МоментСинка(Знач Прогон)

	Возврат ?(ЗначениеЗаполнено(Прогон.ПоследнийСинк), Прогон.ПоследнийСинк,
		Тексты.Текст("office.home.mirrors.never"));

КонецФункции

Функция Значением(Знач Текст)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Текст(Текст));
	Возврат Ячейка;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаЗеркалМоихПулов")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СлужбаКабинета") _СлужбаКабинета,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Пластилин(Значение = "ПредставлениеПрогонаЗеркала") _Прогоны,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	СлужбаКабинета = _СлужбаКабинета;
	СервисЗеркал = _СервисЗеркал;
	Прогоны = _Прогоны;
	ДомПула = _ДомПула;
	Тексты = _Тексты;

КонецПроцедуры
