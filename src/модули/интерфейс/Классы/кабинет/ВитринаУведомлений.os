// Лента личных уведомлений: секция экрана `/me/notifications` и виджет главной кабинета.
// Экран собирается элементами кита.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секции экрана ленты.
//
// Параметры:
//  Параметры - Структура:
//    * Записи - Массив из ЛичноеУведомление - лента, свежие первыми;
//    * Адрес - Строка - адрес экрана (он же action формы);
//    * Токен - Строка - CSRF-токен сессии;
//    * Непрочитано - Число - сколько записей человек ещё не читал.
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Результат = Новый Массив();
	Результат.Добавить(СекцияЛенты(Параметры));
	Возврат Результат;

КонецФункции

// Сколько строк показывает виджет главной. Спрашивают до чтения ленты: столько записей
// у неё и берут, а не всю ленту ради трёх строк.
//
// Возвращаемое значение:
//  Число - предел строк виджета.
//
Функция ПределВиджета() Экспорт
	Возврат 3;
КонецФункции

// Виджет «вам пришло» для главной кабинета: счётчик непрочитанного, несколько свежих
// строк и ссылка на ленту. Непрочитанного нет — разметки нет вовсе: блок с нулём означал
// бы, что рядом что-то происходит.
//
// Параметры:
//  Свежие - Массив из ЛичноеУведомление - свежайшие непрочитанные, не больше ПределВиджета().
//  Непрочитано - Число - сколько записей человек ещё не читал всего.
//  Адрес - Строка - адрес полной ленты.
//
// Возвращаемое значение:
//  Строка - HTML виджета либо "" при отсутствии непрочитанного.
//
Функция Виджет(Знач Свежие, Знач Непрочитано, Знач Адрес) Экспорт

	Если Цел(Непрочитано) = 0 Тогда
		Возврат "";
	КонецЕсли;

	Карточка = Кит.Карточка(Новый Структура("Заголовок, Иконка, Описание, Действия",
		Тексты.Шаблон("office.notifications.widget.title",
			Тексты.ЧислоТекстом(Цел(Непрочитано))),
		"конверт", Тексты.Текст("office.notifications.widget.lead"),
		КнопкаЛенты(Адрес).Рендер()));

	Карточка.Добавить(ТаблицаСвежих(Свежие));
	Карточка.Добавить(ХвостЛенты(Цел(Непрочитано), Свежие.Количество()));
	Возврат Карточка.Рендер();

КонецФункции

#КонецОбласти

#Область СекцияЛенты

Функция СекцияЛенты(Знач Параметры)

	Тело = Кит.Холст();
	Тело.Добавить(ТаблицаЛенты(Параметры.Записи));

	Секция = РендерерНастроек.Секция(Тексты.Текст("office.notifications.title"),
		Тексты.Текст("office.notifications.lead"), Тело.Рендер());
	Секция.Иконка = "конверт";

	// формы нет, пока нечего отмечать: кнопка без работы выглядит сломанной
	Если Цел(Параметры.Непрочитано) > 0 Тогда
		Секция.Действие = Параметры.Адрес;
		Секция.Токен = Параметры.Токен;
		Секция.Кнопка = Тексты.Текст("office.notifications.read.button");
		Секция.ИконкаКнопки = "галочка";
	Иначе
		Секция.БезПанели = Истина;
	КонецЕсли;

	Возврат Секция;

КонецФункции

Функция ТаблицаЛенты(Знач Записи)

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("office.notifications.col.state")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("office.notifications.col.event")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("office.notifications.col.when")));

	Для Каждого Запись Из Записи Цикл
		Таблица.Добавить(СтрокаЛенты(Запись));
	КонецЦикла;

	Таблица.Пусто().Добавить(
		Кит.Примечание(Тексты.Текст("office.notifications.empty"), "пусто"));
	Возврат Таблица;

КонецФункции

Функция СтрокаЛенты(Знач Запись)

	Строка_ = Кит.Запись();
	Строка_.Добавить(ПризнакПрочтения(Запись));
	Строка_.Добавить(Событие(Запись));
	Строка_.Добавить(Момент(Запись));
	Возврат Строка_;

КонецФункции

// Непрочитанное отличимо от прочитанного плашкой: у прочитанной записи ячейка пуста.
Функция ПризнакПрочтения(Знач Запись)

	Ячейка = Кит.Ячейка();
	Если НЕ Запись.Прочитано = Истина Тогда
		Ячейка.Добавить(Кит.Плашка(Новый Структура("Текст, Вид",
			Тексты.Текст("office.notifications.new"), "accent")));
	КонецЕсли;
	Возврат Ячейка;

КонецФункции

#КонецОбласти

#Область ЯчейкиСобытия

// Ячейка одинакова в ленте и в виджете, поэтому живёт отдельно от обоих.
Функция Событие(Знач Запись)

	Ячейка = Кит.Ячейка("столбиком");
	Ячейка.Добавить(ЗаголовокСобытия(Запись));
	Ячейка.Добавить(ПодробностиСобытия(Запись));
	Возврат Ячейка;

КонецФункции

Функция ЗаголовокСобытия(Знач Запись)

	Если НЕ ЗначениеЗаполнено(Запись.Ссылка) Тогда
		Возврат Кит.Текст(Строка(Запись.Заголовок));
	КонецЕсли;

	Ссылка = Кит.Ссылка(Строка(Запись.Ссылка));
	Ссылка.Добавить(Кит.Текст(Строка(Запись.Заголовок)));
	Возврат Ссылка;

КонецФункции

Функция ПодробностиСобытия(Знач Запись)

	Приписка = Кит.Надпись("приписка");
	Приписка.Добавить(Кит.Текст(Строка(Запись.Текст)));
	Возврат Приписка;

КонецФункции

Функция Момент(Знач Запись)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Текст(Формат(Запись.Создано, "ДФ=""dd.MM.yyyy HH:mm""")));
	Возврат Ячейка;

КонецФункции

#КонецОбласти

#Область ВиджетГлавной

Функция ТаблицаСвежих(Знач Свежие)

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("office.notifications.col.event")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("office.notifications.col.when")));

	Для Каждого Запись Из Свежие Цикл
		Строка_ = Кит.Запись();
		Строка_.Добавить(Событие(Запись));
		Строка_.Добавить(Момент(Запись));
		Таблица.Добавить(Строка_);
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция КнопкаЛенты(Знач Адрес)

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Иконка",
		Тексты.Текст("office.notifications.widget.open"), Адрес, "вправо"));

КонецФункции

// Хвост печатается, только когда показано не всё: иначе он говорил бы «и ещё 0».
Функция ХвостЛенты(Знач Всего, Знач Показано)

	Если Всего <= Показано Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Возврат Кит.Примечание(Тексты.Шаблон("office.notifications.widget.rest",
		Тексты.ЧислоТекстом(Всего - Показано)));

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Тексты = _Тексты;

КонецПроцедуры
