// Блок кабинета «Токены на исходе» — желудь модуля web-ui: ключи, которые уже истекли
// либо истекут на днях. Всё остальное про токены живёт в доме аккаунта.

Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем СервисТокенов;  // СервисТокенов (auth) — ключи владельца
Перем Дом;            // ДомАккаунта (web-ui) — адрес раздела токенов
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Блок «Токены на исходе». Ни одного такого ключа — блока нет вовсе: предупреждение
// без повода приучает его не читать.
//
// Параметры:
//  Пользователь - Пользователь - смотрящий.
//
// Возвращаемое значение:
//  Строка - разметка блока либо "" при отсутствии истёкших и истекающих ключей.
//
Функция Блок(Знач Пользователь) Экспорт

	Строки = НаИсходе(Пользователь);
	Если Строки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Результат = Кит.Карточка(Новый Структура("Заголовок, Описание, Иконка, Действия",
		Тексты.Шаблон("office.home.keys.title", Тексты.ЧислоТекстом(Строки.Количество())),
		Тексты.Текст("office.home.keys.lead"), "ключ", ХодВРаздел().Рендер()));

	Результат.Добавить(ТаблицаКлючей(Строки));
	Возврат Результат.Рендер();

КонецФункции

#КонецОбласти

#Область ОтборКлючей

// Две недели — столько, чтобы успеть выпустить новый ключ и переставить его в CI.
Функция ПорогДней()
	Возврат 14;
КонецФункции

// Ключ без срока в отбор не идёт: он не истекает, и предупреждать не о чем.
Функция НаИсходе(Знач Пользователь)

	Если Пользователь = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Сейчас = ТекущаяУниверсальнаяДата();
	Граница = Сейчас + ПорогДней() * 24 * 60 * 60;

	Результат = Новый Массив();

	Для Каждого Ключ Из СервисТокенов.ТокеныПользователя(Пользователь.Идентификатор) Цикл

		Если НЕ ЗначениеЗаполнено(Ключ.Истекает) ИЛИ Ключ.Истекает > Граница Тогда
			Продолжить;
		КонецЕсли;

		ВставитьПоСроку(Результат, Новый Структура("Имя, Префикс, Истекает, Истёк",
			Ключ.Имя, Ключ.Префикс, Ключ.Истекает, Ключ.Истекает <= Сейчас));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Самый горящий ключ сверху; ключей единицы, поэтому место находится вставкой.
Процедура ВставитьПоСроку(Строки, Знач Новая)

	Для Индекс = 0 По Строки.ВГраница() Цикл
		Если Новая.Истекает < Строки[Индекс].Истекает Тогда
			Строки.Вставить(Индекс, Новая);
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Строки.Добавить(Новая);

КонецПроцедуры

#КонецОбласти

#Область Разметка

Функция ТаблицаКлючей(Знач Строки)

	Результат = Кит.Таблица();
	Результат.Добавить(Кит.Колонка(Тексты.Текст("office.home.keys.col.name")));
	Результат.Добавить(Кит.Колонка(Тексты.Текст("office.home.keys.col.prefix")));
	Результат.Добавить(Кит.Колонка(Тексты.Текст("office.home.keys.col.until")));
	Результат.Добавить(Кит.Колонка(Тексты.Текст("office.home.keys.col.state")));

	Для Каждого Ключ Из Строки Цикл
		Результат.Добавить(СтрокаКлюча(Ключ));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СтрокаКлюча(Знач Ключ)

	Результат = Кит.Запись();
	Результат.Добавить(ИмяКлюча(Ключ));
	Результат.Добавить(ПрефиксКлюча(Ключ));
	Результат.Добавить(Значением(Формат(Ключ.Истекает, "ДФ=dd.MM.yyyy")));
	Результат.Добавить(Состояние(Ключ));
	Возврат Результат;

КонецФункции

Функция ИмяКлюча(Знач Ключ)

	Возврат Значением(?(ЗначениеЗаполнено(Ключ.Имя), Строка(Ключ.Имя),
		Тексты.Текст("office.home.keys.noname")));

КонецФункции

Функция ПрефиксКлюча(Знач Ключ)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Код(Строка(Ключ.Префикс)));
	Возврат Ячейка;

КонецФункции

Функция Состояние(Знач Ключ)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Плашка(Новый Структура("Текст, Вид",
		?(Ключ.Истёк, Тексты.Текст("office.home.keys.state.expired"),
			Тексты.Текст("office.home.keys.state.soon")),
		?(Ключ.Истёк, "err", "warn"))));
	Возврат Ячейка;

КонецФункции

Функция Значением(Знач Текст)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Текст(Текст));
	Возврат Ячейка;

КонецФункции

Функция ХодВРаздел()

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Иконка",
		Тексты.Текст("office.home.keys.open"), Дом.АдресРаздела("tokens"), "вторичная", "вправо"));

КонецФункции

#КонецОбласти

&Прозвище("ВитринаСрокаТокенов")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисТокенов") _СервисТокенов,
	&Пластилин(Значение = "ДомАккаунта") _Дом,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	СервисТокенов = _СервисТокенов;
	Дом = _Дом;
	Тексты = _Тексты;

КонецПроцедуры
