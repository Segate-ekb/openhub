// Блок кабинета «Мои пакеты» — желудь модуля web-ui: карточки пакетов в управлении
// с последней версией, датой публикации и счётчиком скачиваний.

Перем Кит;         // Кит (кит) — фабрика элементов экрана
Перем Витрина;     // ВитринаПакетов (web-ui) — модель карточки пакета
Перем Карточки;    // КарточкаПакета (web-ui) — сама карточка
Перем СервисВерсий;// СервисВерсий (реестр) — последняя публикация разрезом по списку
Перем Скачивания;  // СлужбаСтатистикиСкачиваний (статистика) — счётчики разрезом
Перем Адреса;      // АдресаКаталога (web-ui) — каталог с отбором «мои»
Перем Тексты;      // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Блок «Мои пакеты».
//
// Параметры:
//  Пакеты - Массив из Структура (Пул, Пакет) - пакеты в управлении
//           (СлужбаКабинета.ПакетыВУправлении); пустой список блока не рисует.
//
// Возвращаемое значение:
//  Строка - разметка блока либо "" при пустом списке.
//
Функция Блок(Знач Пакеты) Экспорт

	Если Пакеты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Показанные = СвежиеПервыми(Пакеты);

	Результат = Кит.Карточка(Новый Структура("Заголовок, Описание, Иконка, Действия",
		Тексты.Текст("office.home.packages.title"),
		Тексты.Текст("office.home.packages.lead"), "пакет", ХодВКаталог().Рендер()));

	Результат.Добавить(СеткаКарточек(Показанные));
	Результат.Добавить(Хвост(Пакеты.Количество(), Показанные.Количество()));
	Возврат Результат.Рендер();

КонецФункции

#КонецОбласти

#Область ПорядокИМетрики

// Сводка, а не каталог: остальное живёт в каталоге с отбором «мои», и хвост туда уводит.
Функция Предел()
	Возврат 6;
КонецФункции

// Горстка карточек, а не весь список: порядок задаёт отметка последней публикации,
// которую пакет носит в себе, а версии и счётчики спрашиваются уже по отобранным шести.
Функция СвежиеПервыми(Знач Пакеты)

	Показанные = ПервыеПоСвежести(Пакеты);
	ДополнитьПубликациями(Показанные);
	ДополнитьСкачиваниями(Показанные);
	Возврат Показанные;

КонецФункции

// Свежесть пакета уже прочитана вместе с ним: спрашивать её у версий значило бы читать
// все версии хаба ради шести карточек. При равной дате порядок задаёт имя — без него
// две страницы подряд показывали бы разное; непубликовавшееся встаёт в самый низ.
Функция ПервыеПоСвежести(Знач Пакеты)

	// имена колонок латиницей: это внутренние идентификаторы сортировки, а не строки экрана
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("moment");
	Таблица.Колонки.Добавить("key");
	Таблица.Колонки.Добавить("item");

	Для Каждого Элемент Из Пакеты Цикл
		СтрокаПорядка = Таблица.Добавить();
		СтрокаПорядка.moment = Момент(Элемент.Пакет);
		СтрокаПорядка.key = Элемент.Пакет.ИмяНижнийРегистр;
		СтрокаПорядка.item = Элемент;
	КонецЦикла;

	Таблица.Сортировать("moment Убыв, key Возр");

	Результат = Новый Массив();
	Для Каждого СтрокаПорядка Из Таблица Цикл
		Если Результат.Количество() >= Предел() Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(ПустаяКарточка(СтрокаПорядка.item));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ни разу не публиковавшийся пакет встаёт в самый низ, а не в самый верх.
Функция Момент(Знач Пакет)
	Возврат ?(ЗначениеЗаполнено(Пакет.ПоследняяПубликация), Пакет.ПоследняяПубликация, '00010101');
КонецФункции

// Версия и дата — разрезом по показанным: карточке нужна строка версии, а отметка пакета
// строки не хранит.
Процедура ДополнитьПубликациями(Записи)

	Публикации = СервисВерсий.ПоследниеПубликацииПакетов(Идентификаторы(Записи));

	Для Каждого Карточка Из Записи Цикл
		Публикация = Публикации.Получить(Цел(Карточка.Пакет.Идентификатор));
		Если Публикация <> Неопределено Тогда
			Карточка.Версия = Публикация.Версия;
			Карточка.Опубликована = Публикация.Опубликована;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Счётчик спрашивается разрезом по показанным, а не по всей таблице агрегатов хаба.
Процедура ДополнитьСкачиваниями(Записи)

	ПоПакетам = Скачивания.СкачиванияПакетов(Идентификаторы(Записи));

	Для Каждого Карточка Из Записи Цикл
		Скачано = ПоПакетам.Получить(Цел(Карточка.Пакет.Идентификатор));
		Карточка.Скачиваний = ?(Скачано = Неопределено, 0, Скачано);
	КонецЦикла;

КонецПроцедуры

Функция Идентификаторы(Знач Записи)

	Результат = Новый Массив();
	Для Каждого Карточка Из Записи Цикл
		Результат.Добавить(Цел(Карточка.Пакет.Идентификатор));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Версию, дату и счётчик карточка получает следующими шагами: их спрашивают уже
// по отобранной горстке.
Функция ПустаяКарточка(Знач Элемент)

	Возврат Новый Структура("Пакет, Пул, Версия, Опубликована, Скачиваний",
		Элемент.Пакет, Элемент.Пул, "", Неопределено, 0);

КонецФункции

#КонецОбласти

#Область Разметка

// Шестерёнка стоит всегда: в этом блоке нет пакета, которым смотрящий не управлял бы.
// Модели приезжают разом на всю горстку: «своё ли имя» — вопрос провенанса, и на карточку
// он стоил бы отдельного чтения.
Функция СеткаКарточек(Знач Записи)

	Сетка = Кит.Сетка(Новый Структура("Колонки, Заголовок",
		3, Тексты.Текст("office.home.packages.title")));

	Модели = Витрина.КарточкиУправляемых(Записи);
	Для Индекс = 0 По Записи.ВГраница() Цикл
		ДополнитьМетриками(Модели[Индекс], Записи[Индекс]);
		Сетка.Добавить(Карточки.Карточка(Модели[Индекс]));
	КонецЦикла;
	Возврат Сетка;

КонецФункции

// Версия и мета — то, что этот блок знает о карточке сверх общей витрины. Модель правится
// на месте: она уже лежит в списке, и копия разошлась бы с ним.
Процедура ДополнитьМетриками(Модель, Знач Запись)

	Если ЗначениеЗаполнено(Запись.Версия) Тогда
		Модель.Вставить("Версия", Запись.Версия);
	КонецЕсли;
	Модель.Вставить("Мета", Мета(Запись));

КонецПроцедуры

Функция Мета(Знач Запись)

	Результат = Новый Массив();

	Если ЗначениеЗаполнено(Запись.Опубликована) Тогда
		Результат.Добавить(Новый Структура("Подпись, Значение",
			Тексты.Текст("office.home.packages.published"),
			Формат(Запись.Опубликована, "ДФ=dd.MM.yyyy")));
	КонецЕсли;

	Результат.Добавить(Новый Структура("Подпись, Значение",
		Тексты.Текст("office.home.packages.downloads"),
		Тексты.ЧислоТекстом(Запись.Скачиваний)));

	Возврат Результат;

КонецФункции

Функция ХодВКаталог()

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Иконка",
		Тексты.Текст("office.home.packages.open"), Адреса.Управляемые(), "вправо"));

КонецФункции

// Хвост печатается, только когда показано не всё: иначе он говорил бы «и ещё 0».
Функция Хвост(Знач Всего, Знач Показано)

	Если Всего <= Показано Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Примечание(Тексты.Шаблон("office.home.packages.rest",
		Тексты.ЧислоТекстом(Всего - Показано)));

КонецФункции

#КонецОбласти

&Прозвище("ВитринаМоихПакетов")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ВитринаПакетов") _Витрина,
	&Пластилин(Значение = "КарточкаПакета") _Карточки,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СлужбаСтатистикиСкачиваний") _Скачивания,
	&Пластилин(Значение = "АдресаКаталога") _Адреса,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Витрина = _Витрина;
	Карточки = _Карточки;
	СервисВерсий = _СервисВерсий;
	Скачивания = _Скачивания;
	Адреса = _Адреса;
	Тексты = _Тексты;

КонецПроцедуры
