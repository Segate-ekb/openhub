// Блок кабинета «Мои пакеты» — желудь модуля web-ui: карточки пакетов в управлении
// с последней версией, датой публикации и счётчиком скачиваний.

Перем Кит;         // Кит (кит) — фабрика элементов экрана
Перем Витрина;     // ВитринаПакетов (web-ui) — модель карточки пакета
Перем Карточки;    // КарточкаПакета (web-ui) — сама карточка
Перем СервисВерсий;// СервисВерсий (реестр) — последняя публикация разрезом по списку
Перем Скачивания;  // СлужбаСтатистикиСкачиваний (статистика) — счётчики разрезом
Перем Адреса;      // АдресаКаталога (web-ui) — каталог с отбором «мои»
Перем Тексты;      // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Блок «Мои пакеты».
//
// Параметры:
//  Пакеты - Массив из Структура (Пул, Пакет) - пакеты в управлении
//           (СлужбаКабинета.ПакетыВУправлении); пустой список блока не рисует.
//
// Возвращаемое значение:
//  Строка - разметка блока либо "" при пустом списке.
//
Функция Блок(Знач Пакеты) Экспорт

	Если Пакеты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Показанные = СвежиеПервыми(Пакеты);

	Результат = Кит.Карточка(Новый Структура("Заголовок, Описание, Иконка, Действия",
		Тексты.Текст("office.home.packages.title"),
		Тексты.Текст("office.home.packages.lead"), "пакет", ХодВКаталог().Рендер()));

	Результат.Добавить(СеткаКарточек(Показанные));
	Результат.Добавить(Хвост(Пакеты.Количество(), Показанные.Количество()));
	Возврат Результат.Рендер();

КонецФункции

#КонецОбласти

#Область ПорядокИМетрики

// Сводка, а не каталог: остальное живёт в каталоге с отбором «мои», и хвост туда уводит.
Функция Предел()
	Возврат 6;
КонецФункции

// Непубликовавшееся уходит в хвост по имени; первые Предел() берутся выборкой, а не сортировкой.
Функция СвежиеПервыми(Знач Пакеты)

	Кандидаты = Записи(Пакеты);

	Результат = Новый Массив();
	Взятые = Новый Соответствие();

	Пока Результат.Количество() < Предел() Цикл

		Лучший = -1;
		Для Индекс = 0 По Кандидаты.ВГраница() Цикл
			Если Взятые.Получить(Индекс) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Лучший < 0 ИЛИ Свежее(Кандидаты[Индекс], Кандидаты[Лучший]) Тогда
				Лучший = Индекс;
			КонецЕсли;
		КонецЦикла;

		Если Лучший < 0 Тогда
			Прервать;
		КонецЕсли;

		Взятые.Вставить(Лучший, Истина);
		Результат.Добавить(Кандидаты[Лучший]);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Публикация и счётчики берутся разрезами по всему списку: иначе блок превращается в N+1.
Функция Записи(Знач Пакеты)

	Идентификаторы = Новый Массив();
	Для Каждого Элемент Из Пакеты Цикл
		Идентификаторы.Добавить(Цел(Элемент.Пакет.Идентификатор));
	КонецЦикла;

	Публикации = СервисВерсий.ПоследниеПубликацииПакетов(Идентификаторы);
	ПоПакетам = Скачивания.СкачиванияПоПакетам();

	Результат = Новый Массив();
	Для Каждого Элемент Из Пакеты Цикл

		Ключ = Цел(Элемент.Пакет.Идентификатор);
		Публикация = Публикации.Получить(Ключ);
		Скачано = ПоПакетам.Получить(Ключ);

		Результат.Добавить(Новый Структура("Пакет, Пул, Версия, Опубликована, Скачиваний",
			Элемент.Пакет, Элемент.Пул,
			?(Публикация = Неопределено, "", Публикация.Версия),
			?(Публикация = Неопределено, Неопределено, Публикация.Опубликована),
			?(Скачано = Неопределено, 0, Скачано)));

	КонецЦикла;
	Возврат Результат;

КонецФункции

// При равной дате порядок задаёт имя: без него две страницы подряд показывали бы разное.
Функция Свежее(Знач Претендент, Знач Текущий)

	Если Претендент.Опубликована <> Текущий.Опубликована Тогда
		Возврат Момент(Претендент) > Момент(Текущий);
	КонецЕсли;
	Возврат Претендент.Пакет.ИмяНижнийРегистр < Текущий.Пакет.ИмяНижнийРегистр;

КонецФункции

// Ни разу не публиковавшийся пакет встаёт в самый низ, а не в самый верх.
Функция Момент(Знач Запись)
	Возврат ?(ЗначениеЗаполнено(Запись.Опубликована), Запись.Опубликована, '00010101');
КонецФункции

#КонецОбласти

#Область Разметка

Функция СеткаКарточек(Знач Записи)

	Сетка = Кит.Сетка(Новый Структура("Колонки, Заголовок",
		3, Тексты.Текст("office.home.packages.title")));

	Для Каждого Запись Из Записи Цикл
		Сетка.Добавить(Карточки.Карточка(Модель(Запись)));
	КонецЦикла;
	Возврат Сетка;

КонецФункции

// Шестерёнка стоит всегда: в этом блоке нет пакета, которым смотрящий не управлял бы.
Функция Модель(Знач Запись)

	Результат = Витрина.Модель(Запись.Пакет, Запись.Пул, Истина);
	Если ЗначениеЗаполнено(Запись.Версия) Тогда
		Результат.Вставить("Версия", Запись.Версия);
	КонецЕсли;
	Результат.Вставить("Мета", Мета(Запись));
	Возврат Результат;

КонецФункции

Функция Мета(Знач Запись)

	Результат = Новый Массив();

	Если ЗначениеЗаполнено(Запись.Опубликована) Тогда
		Результат.Добавить(Новый Структура("Подпись, Значение",
			Тексты.Текст("office.home.packages.published"),
			Формат(Запись.Опубликована, "ДФ=dd.MM.yyyy")));
	КонецЕсли;

	Результат.Добавить(Новый Структура("Подпись, Значение",
		Тексты.Текст("office.home.packages.downloads"),
		Тексты.ЧислоТекстом(Запись.Скачиваний)));

	Возврат Результат;

КонецФункции

Функция ХодВКаталог()

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Иконка",
		Тексты.Текст("office.home.packages.open"), Адреса.Управляемые(), "вправо"));

КонецФункции

// Хвост печатается, только когда показано не всё: иначе он говорил бы «и ещё 0».
Функция Хвост(Знач Всего, Знач Показано)

	Если Всего <= Показано Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Возврат Кит.Примечание(Тексты.Шаблон("office.home.packages.rest",
		Тексты.ЧислоТекстом(Всего - Показано)));

КонецФункции

#КонецОбласти

&Прозвище("ВитринаМоихПакетов")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ВитринаПакетов") _Витрина,
	&Пластилин(Значение = "КарточкаПакета") _Карточки,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СлужбаСтатистикиСкачиваний") _Скачивания,
	&Пластилин(Значение = "АдресаКаталога") _Адреса,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Витрина = _Витрина;
	Карточки = _Карточки;
	СервисВерсий = _СервисВерсий;
	Скачивания = _Скачивания;
	Адреса = _Адреса;
	Тексты = _Тексты;

КонецПроцедуры
