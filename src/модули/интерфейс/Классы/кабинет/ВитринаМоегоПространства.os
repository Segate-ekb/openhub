// Блок кабинета «Личное пространство» — желудь модуля web-ui: сколько места занято
// в пуле, названном логином, и дорога в сам пул.

Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем СервисПулов;    // СервисПулов (реестр) — занятое и действующая квота
Перем СервисПакетов;  // СервисПакетов (реестр) — сколько имён лежит в пуле
Перем Заполнение;     // ЗаполнениеПула (основа) — процент занятого
Перем Объёмы;         // ОбъёмТекстом (основа) — байты человеку
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Блок «Личное пространство». Пространства нет — блока нет вовсе: рассказывать
// о чужом пуле, случайно занявшем имя логина, кабинету нечего.
//
// Параметры:
//  Пользователь - Пользователь - смотрящий.
//
// Возвращаемое значение:
//  Строка - разметка блока либо "" при отсутствии личного пространства.
//
Функция Блок(Знач Пользователь) Экспорт

	Пул = ЛичныйПул(Пользователь);
	Если Пул = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Результат = Кит.Карточка(Новый Структура("Заголовок, Описание, Иконка, Действия",
		Тексты.Шаблон("office.home.space.title", Пул.Имя),
		Тексты.Текст("office.home.space.lead"), "куб", ХодВПул(Пул).Рендер()));

	Результат.Добавить(Место(Пул));
	Результат.Добавить(СколькоПакетов(Пул));
	Возврат Результат.Рендер();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Личное пространство — это пул типа «личный», принадлежащий смотрящему. Имя логина
// может носить и чужой пул: такой пространством не считается.
Функция ЛичныйПул(Знач Пользователь)

	Если Пользователь = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пул = СервисПулов.НайтиПул(Пользователь.Логин);
	Если Пул = Неопределено ИЛИ НЕ Пул.ЭтоЛичный()
		ИЛИ Цел(Пул.ВладелецИдентификатор) <> Цел(Пользователь.Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Пул;

КонецФункции

// У пула без ограничения процента не существует, поэтому вместо шкалы печатается
// одно занятое.
Функция Место(Знач Пул)

	Занято = СервисПулов.ЗанятоБайт(Пул);
	КвотаБайт = СервисПулов.ЭффективнаяКвотаБайт(Пул);

	Если КвотаБайт <= 0 Тогда
		Возврат Кит.Примечание(Тексты.Шаблон("office.home.space.meter.unlimited",
			Объёмы.Представление(Занято)));
	КонецЕсли;

	Возврат Кит.ПолосаЗаполнения(Новый Структура("Процент, Метка, Подпись",
		Заполнение.Процент(Занято, КвотаБайт),
		Тексты.Текст("office.home.space.meter.label"),
		Тексты.Шаблон("office.home.space.meter.value",
			Объёмы.Представление(Занято), Объёмы.Представление(КвотаБайт))));

КонецФункции

Функция СколькоПакетов(Знач Пул)

	Возврат Кит.Примечание(Тексты.Шаблон("office.home.space.packages",
		Тексты.ЧислоТекстом(СервисПакетов.ПакетыПула(Пул.Идентификатор).Количество())));

КонецФункции

Функция ХодВПул(Знач Пул)

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Иконка",
		Тексты.Текст("office.home.space.open"), "/" + Строка(Пул.Имя), "вторичная", "вправо"));

КонецФункции

#КонецОбласти

&Прозвище("ВитринаМоегоПространства")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "ЗаполнениеПула") _Заполнение,
	&Пластилин(Значение = "ОбъёмТекстом") _Объёмы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	Заполнение = _Заполнение;
	Объёмы = _Объёмы;
	Тексты = _Тексты;

КонецПроцедуры
