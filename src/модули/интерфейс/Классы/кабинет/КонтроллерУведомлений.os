// Лента личных уведомлений — контроллер модуля web-ui: экран `/me/notifications`
// и отметка ленты прочитанной.

Перем Гвард;         // ГвардКабинета (кабинет)
Перем Ответы;        // ОтветыНастроек (web-ui)
Перем Защита;        // ЗащитаCSRF (auth)
Перем РазборФормы;   // РазборФормы (web-ui)
Перем Лента;         // ЛентаУведомлений (уведомления) — своя лента и счёт непрочитанного
Перем Витрина;       // ВитринаУведомлений (web-ui) — разметка ленты
Перем Адреса;        // АдресаКабинета (web-ui) — адреса экранов кабинета
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ТочкиМаршрута

// Точка маршрута «notifications» — лента событий, адресованных вошедшему.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак отметки прочтения из адреса (необязательный, по умолчанию "").
//
&ТочкаМаршрута("notifications")
Процедура Уведомления(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	saved = "") Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьЛенту(Ответ, Вердикт, КукиЗапроса, ЗначениеЗаполнено(saved));
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = РазборФормы.Разобрать(ТелоЗапроса);
	Если НЕ Защита.Проверить(Вердикт.Сессия, РазборФормы.Поле(Форма, Защита.ИмяПоля())) Тогда
		Ответы.ОтдатьНеверныйCSRF(Ответ, Вердикт.Пользователь, КукиЗапроса,
			Тексты.Текст("office.notifications.error.csrf"));
		Возврат;
	КонецЕсли;

	// отмечается ЛЕНТА ВОШЕДШЕГО, а не то, что назвали в форме: чужие записи этой формой
	// не достаются
	Лента.ОтметитьВсеПрочитанными(Вердикт.Пользователь);
	Ответ.Перенаправить(Адреса.Уведомления() + "?saved=1");

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьЛенту(Ответ, Знач Вердикт, Знач КукиЗапроса, Знач Отмечено)

	Пользователь = Вердикт.Пользователь;
	Записи = Лента.Мои(Пользователь);

	Уведомления = Новый Массив();
	Если Отмечено Тогда
		Уведомления.Добавить(Ответы.Уведомление(
			Тексты.Текст("office.notifications.read.done"), "ok"));
	КонецЕсли;

	Модель = Новый Структура();
	Модель.Вставить("Ключ", "notifications");
	Модель.Вставить("Заголовок", Тексты.Текст("office.notifications.page.title"));
	Модель.Вставить("Объект", "");
	Модель.Вставить("Пояснение", Тексты.Текст("office.notifications.page.lead"));
	// дерева разделов у ленты нет: она сама себе раздел
	Модель.Вставить("Разделы", Новый Массив());
	Модель.Вставить("Уведомления", Уведомления);
	Модель.Вставить("Хлебные", Хлебные(Пользователь));
	Модель.Вставить("Секции", Витрина.Секции(
		Новый Структура("Записи, Адрес, Токен, Непрочитано",
			Записи, Адреса.Уведомления(), Защита.ТокенСессии(Вердикт.Сессия),
			Лента.Непрочитано(Пользователь))));

	Ответы.ОтдатьДом(Ответ, Модель, Пользователь, КукиЗапроса,
		Тексты.Текст("office.notifications.page.title"));

КонецПроцедуры

Функция Хлебные(Знач Пользователь)

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Подпись, Адрес",
		Пользователь.Логин, Адреса.Личное()));
	Результат.Добавить(Новый Структура("Подпись",
		Тексты.Текст("office.notifications.crumb")));
	Возврат Результат;

КонецФункции

#КонецОбласти

&Контроллер("/me")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _Гвард,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ЛентаУведомлений") _Лента,
	&Пластилин(Значение = "ВитринаУведомлений") _Витрина,
	&Пластилин(Значение = "АдресаКабинета") _Адреса,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	Гвард = _Гвард;
	Ответы = _Ответы;
	Защита = _Защита;
	РазборФормы = _РазборФормы;
	Лента = _Лента;
	Витрина = _Витрина;
	Адреса = _Адреса;
	Тексты = _Тексты;

КонецПроцедуры
