// Операция раздела «Опасная зона» дома «Пакет»: удаление пакета без версий той же дверью
// домена, что снимает пустой пакет пула. Здесь — право на раздел, контракт формы и эхо имени.

Перем РазборФормы;
Перем Резерв;       // СервисРезервированияИмён (публикация) — дверь удаления пакета без версий
Перем Сбои;         // ТекстСбоя — причина сбоя человеку и отчёт в журнал
Перем СервисПулов;  // СервисПулов (реестр) — пул пакета
Перем Тексты;       // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Имя скрытого поля операции опасной зоны.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Значение операции «удалить пакет».
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеОперации() Экспорт
	Возврат "пакет-удалить";
КонецФункции

// Имя поля, в которое человек вводит эхо — имя удаляемого пакета.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляЭха() Экспорт
	Возврат "подтверждение";
КонецФункции

// Есть ли у смотрящего необратимое действие над пакетом: удаляется пакет без единой версии
// (отозванная — тоже версия), удаляет мейнтейнер пула и выше.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - смотрящий.
//  Пакет - Пакет - пакет раздела.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетУдалять(Знач Пользователь, Знач Пакет) Экспорт

	Если Пользователь = Неопределено ИЛИ Пакет = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	// порог и «пакет без версий» судит домен — тот же, что потом удаляет
	Пул = СервисПулов.ПулПоИдентификатору(Пакет.ПулИдентификатор);
	Возврат Резерв.ВправеРезервировать(Пользователь, Пул)
		И Резерв.НайтиРезерв(Пул, Пакет.Имя) <> Неопределено;

КонецФункции

// Удаляет пакет по форме опасной зоны. Право и запрет на пакет с версиями судит домен.
//
// Параметры:
//  Принципал - Структура - принципал запроса.
//  Пул - Пул - пул пакета.
//  Пакет - Пакет - пакет раздела.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Строка - текст отказа; "" — пакет удалён.
//
Функция Применить(Знач Принципал, Знач Пул, Знач Пакет, Знач Форма) Экспорт

	Имя = Строка(Пакет.Имя);
	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, ИмяПоляОперации())));
	Если Операция <> ЗначениеОперации() Тогда
		// белый список операций: форма без операции не значит «удалить пакет»
		Лог.Отладка("Опасная зона пакета ""%1"": операция ""%2"" не объявлена, пакет не тронут",
			Имя, Операция);
		Возврат Тексты.Текст("settings.package.danger.error.operation");
	КонецЕсли;

	// эхо повторяет имя пакета с точностью до регистра — так его и печатает экран
	Если СокрЛП(РазборФормы.Поле(Форма, ИмяПоляЭха())) <> Имя Тогда
		Лог.Отладка("Опасная зона пакета ""%1"": подтверждение не совпало, пакет не тронут", Имя);
		Возврат Тексты.Шаблон("settings.package.danger.error.echo", Имя);
	КонецЕсли;

	Попытка
		Решение = Резерв.СнятьРезерв(Принципал, Пул, Имя);
	Исключение
		Возврат Тексты.Шаблон("settings.package.danger.error.delete",
			Сбои.Человеку(ИнформацияОбОшибке()));
	КонецПопытки;
	Если НЕ Решение.Успех Тогда
		Возврат Тексты.Шаблон("settings.package.danger.error.delete", Решение.Сообщение);
	КонецЕсли;

	Лог.Информация("Пакет ""%1"" пула ""%2"" удалён из опасной зоны", Имя, Пул.Имя);
	Возврат "";

КонецФункции

#КонецОбласти

&Прозвище("ПультУдаленияПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисРезервированияИмён") _Резерв,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Лог _Лог = Неопределено) Экспорт

	РазборФормы = _РазборФормы;
	Резерв = _Резерв;
	Сбои = _Сбои;
	СервисПулов = _СервисПулов;
	Тексты = _Тексты;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
