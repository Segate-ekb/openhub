// Маршруты раздела «Доверенная публикация» (ci) дома «Пакет»: страница с окном по адресу,
// заведение и разбор ссылки формой окна «Доверить конвейеру», отзыв доверия записи. Удача —
// 303 на раздел, отказ — та же страница с окном, открытым на набранном и отказах.

Перем ГвардПакета;
Перем Ответы;         // ОтветыНастроек
Перем Дом;            // ДомПакета
Перем Витрина;        // ВитринаДоверияCI
Перем Пульт;          // ПультДоверияCI
Перем Гейт;           // ГейтФормы — метод запроса и токен формы
Перем Защита;         // ЗащитаCSRF (вход) — токен для форм страницы
Перем Окна;           // ОкноРаздела — окно по адресу и ответы форм окон
Перем СервисДоверия;  // СервисДоверияCI (публикация) — порог «мейнтейнер пакета и выше»
Перем Сниппеты;       // СниппетыКонвейеров — внешний адрес хаба
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ТочкиМаршрута

// Точка маршрута «pools/{pool}/packages/{name}/settings/ci»: GET — страница раздела, POST — форма
// окна «Доверить конвейеру» (заведение или разбор ссылки).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: «новый» или «удалить-<номер записи>»
//         (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/ci")
Процедура Раздел(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	saved = "", окно = "") Экспорт

	Вердикт = Допустить(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Вердикт = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Структура("Вердикт, Заголовки, Куки", Вердикт, ЗаголовкиЗапроса, КукиЗапроса);

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Запрос, 200, Окна.ИзАдреса(окно, Витрина.ВидыОкон()), ЗначениеЗаполнено(saved));
		Возврат;
	КонецЕсли;

	Форма = Гейт.ПринятаяФорма(Ответ, Вердикт, "GET, POST", МетодЗапроса, ТелоЗапроса,
		КукиЗапроса, Тексты.Текст("settings.package.ci.error.csrf"));
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Запрос, Пульт.Применить(Вердикт.Принципал, Вердикт.Пакет, Форма));

КонецПроцедуры

// Точка маршрута «pools/{pool}/packages/{name}/settings/ci/{доверие}/delete» — отзыв доверия
// записи. Без поля подтверждения (форма ушла без скрипта) запись не трогается: ответ ведёт на
// страницу с открытым подтверждением.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  доверие - Строка - номер записи доверия.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/ci/{доверие}/delete")
Процедура Удаление(Ответ, pool, name, доверие, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Вердикт = Допустить(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Вердикт = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Форма = Гейт.ПринятаяФорма(Ответ, Вердикт, "POST", МетодЗапроса, ТелоЗапроса, КукиЗапроса,
		Тексты.Текст("settings.package.ci.error.csrf"));
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Структура("Вердикт, Заголовки, Куки", Вердикт, ЗаголовкиЗапроса, КукиЗапроса);

	Если НЕ Окна.Подтверждено(Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресРаздела(Вердикт), доверие);
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Запрос, Пульт.Отозвать(Вердикт.Принципал, Вердикт.Пакет, доверие));

КонецПроцедуры

#КонецОбласти

#Область Действия

// Порядок тот же, что у соседних админских разделов: 404 на невидимое, затем 403 по порогу.
Функция Допустить(Ответ, Знач pool, Знач name, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Вердикт = ГвардПакета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool, name);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ СервисДоверия.МожетНастраивать(Вердикт.Пользователь, Вердикт.Пакет) Тогда
		Ответы.ОтдатьЗапрещено(Ответ, Вердикт,
			Тексты.Текст("settings.package.ci.error.forbidden"), КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Вердикт;

КонецФункции

// Исход пульта (см. ИсходОкна) → ответ: удача — 303 на раздел; отказ — страница с окном этой
// формы, открытым на набранном и отказах, пока окно на странице есть, иначе причиной над разделом.
// Чужая запись неотличима от несуществующей — 404.
Процедура Завершить(Ответ, Знач Запрос, Знач Исход)

	Если Исход.Успех Тогда
		Окна.ВернутьВРаздел(Ответ, АдресРаздела(Запрос.Вердикт));
		Возврат;
	КонецЕсли;
	Если Исход.Код = 404 Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Запрос.Вердикт, Исход.Сообщение, Запрос.Куки);
		Возврат;
	КонецЕсли;

	Код = ?(Исход.Код = 403 ИЛИ Исход.Код = 422, Исход.Код, 400);
	Если Исход.Окно <> Неопределено И Витрина.ЕстьОкно(Запрос.Вердикт.Пакет, Исход.Окно) Тогда
		ОтдатьРаздел(Ответ, Запрос, Код, Исход.Окно, Ложь);
		Возврат;
	КонецЕсли;
	ОтдатьРаздел(Ответ, Запрос, Код, Неопределено, Ложь, Исход.Сообщение);

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Запрос, Знач Статус, Знач Окно, Знач Сохранено, Знач Ошибка = "")

	Вердикт = Запрос.Вердикт;
	Пул = Вердикт.Пул;
	Пакет = Вердикт.Пакет;

	Параметры = Новый Структура("Пул, Пакет, Адрес, АдресХаба, Окно", Пул, Пакет, АдресРаздела(Вердикт),
		Сниппеты.БазовыйАдрес(Запрос.Заголовки), Окно);

	Модель = Ответы.МодельДома(Дом, Пакет.Имя,
		Дом.Разделы(Пул.Имя, Пакет.Имя, "ci", Вердикт.Пользователь, Пакет),
		Ответы.УведомленияРаздела(Сохранено, Ошибка),
		Витрина.Секции(Параметры),
		Защита.ТокенСессии(Вердикт.Сессия),
		Дом.Крошки(Пул.Имя, Пакет.Имя));

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт, Запрос.Куки, Статус);

КонецПроцедуры

Функция АдресРаздела(Знач Вердикт)
	Возврат Дом.АдресРаздела(Вердикт.Пул.Имя, Вердикт.Пакет.Имя, "ci");
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардПакета") _ГвардПакета,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомПакета") _Дом,
	&Пластилин(Значение = "ВитринаДоверияCI") _Витрина,
	&Пластилин(Значение = "ПультДоверияCI") _Пульт,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "СервисДоверияCI") _СервисДоверия,
	&Пластилин(Значение = "СниппетыКонвейеров") _Сниппеты,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	ГвардПакета = _ГвардПакета;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	Пульт = _Пульт;
	Гейт = _Гейт;
	Защита = _Защита;
	Окна = _Окна;
	СервисДоверия = _СервисДоверия;
	Сниппеты = _Сниппеты;
	Тексты = _Тексты;

КонецПроцедуры
