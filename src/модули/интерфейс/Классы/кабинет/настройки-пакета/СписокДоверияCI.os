// Раздел «Доверенная публикация»: реестр доверенных конвейеров пакета с меню ⚙ записи
// и подтверждение отзыва доверия по адресу ?окно=удалить-<номер записи>.

Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем СервисДоверия;  // СервисДоверияCI (публикация) — записи пакета и их имена
Перем Маски;          // МаскаРефа (публикация) — слишком широкая маска рефа
Перем Провайдеры;     // ПредставлениеПровайдераCI — значок, тип и издатель записи
Перем КороткаяФорма;  // КороткаяФормаДоверия (публикация) — адреса записи в вебе
Перем Окна;           // ОкноРаздела — окно по адресу и его состояние
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Даты;           // ДатаЧеловеку — одно написание момента на весь интерфейс

#Область ПубличныйИнтерфейс

// Секция со списком доверенных конвейеров пакета.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  АдресРаздела - Строка - адрес раздела: адреса окон записей.
//  ОкноЗаведения - ЭлементЭкрана - окно «Доверить конвейеру»: его открывает кнопка в шапке секции.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.Секция.
//
Функция Секция(Знач Пакет, Знач АдресРаздела, Знач ОкноЗаведения, Знач Состояние) Экспорт

	Строки = СервисДоверия.СтрокиПакета(Пакет);

	Возврат Кит.Секция(Тексты.Текст("settings.package.ci.title"),
			Реестр(Строки, АдресРаздела),
			Кит.Примечание(Тексты.Текст("settings.package.ci.note")),
			ОкноЗаведения,
			ОкноУдаления(Строки, Состояние, АдресРаздела))
		.Лид(Тексты.Текст("settings.package.ci.lead")).Иконка("ключ")
		.Действия(Кит.Кнопка(Тексты.Текст("settings.package.ci-new.button")).Основная().Иконка("плюс")
			.Открывает(ОкноЗаведения));

КонецФункции

// Есть ли у пакета запись, чьё подтверждение отзыва называет состояние.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Состояние - Структура, Неопределено - состояние окна раздела.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьЗаписьОкна(Знач Пакет, Знач Состояние) Экспорт
	Возврат Окна.Открыто(Состояние, ВидУдаления())
		И ЗаписьОкна(СервисДоверия.СтрокиПакета(Пакет), Состояние) <> Неопределено;
КонецФункции

// Вид окна подтверждения отзыва доверия.
//
// Возвращаемое значение:
//  Строка.
//
Функция ВидУдаления() Экспорт
	Возврат "удалить";
КонецФункции

#КонецОбласти

#Область Реестр

Функция Реестр(Знач Строки, Знач АдресРаздела)

	Реестр = Кит.Реестр().Подпись(Тексты.Текст("settings.package.ci.title"))
		.Пусто(Тексты.Текст("settings.package.ci.empty"));
	Для Каждого СтрокаДоверия Из Строки Цикл
		Реестр.Добавить(Запись(СтрокаДоверия, АдресРаздела));
	КонецЦикла;
	Возврат Реестр;

КонецФункции

// Свёрнутая запись — репозиторий, тип и главное: конвейер и реф; раскрытая — свойства
// со ссылками. Издатель назван только там, где он не выводится из типа репозитория.
Функция Запись(Знач СтрокаДоверия, Знач АдресРаздела)

	Доверие = СтрокаДоверия.Доверие;
	Адреса = АдресаЗаписи(Доверие);

	Запись = Кит.ЗаписьРеестра(Строка(Доверие.Репозиторий), Свойства(СтрокаДоверия, Адреса))
		.Плашка(Провайдеры.ИмяТипа(Доверие.Провайдер))
		.Подпись(Провайдеры.УточнениеИздателя(Доверие.Провайдер, Доверие.Издатель))
		.Факт(Тексты.Текст("settings.package.ci.col.workflow"), ИмяКонвейера(Адреса))
		.Факт(Тексты.Текст("settings.package.ci.col.ref"), Строка(Доверие.Реф))
		.Кнопки(Кит.ОкноПоАдресу(Окна.Адрес(АдресРаздела, ВидУдаления(), Номер(Доверие)),
			Тексты.Текст("settings.package.ci.button.revoke")).Опасная().Иконка("корзина"));

	АдресЗначка = Провайдеры.АдресЗначка(Доверие.Провайдер);
	Если ЗначениеЗаполнено(АдресЗначка) Тогда
		Запись.Картинка(АдресЗначка);
	Иначе
		Запись.Значок("ключ");
	КонецЕсли;
	Если Маски.СлишкомШирокая(Доверие.Реф) Тогда
		Запись.Плашка(Кит.Плашка(Тексты.Текст("settings.package.ci.ref.wide")).Вид("warn"));
	КонецЕсли;
	Возврат Запись;

КонецФункции

Функция Свойства(Знач СтрокаДоверия, Знач Адреса)

	Доверие = СтрокаДоверия.Доверие;
	Возврат Кит.Свойства(
		Кит.Свойство(Тексты.Текст("settings.package.ci.col.repo"),
			Машинное(Адреса.Репозиторий, Строка(Доверие.Репозиторий))).Копируемое(Строка(Доверие.Репозиторий)),
		Кит.Свойство(Тексты.Текст("settings.package.ci.col.workflow"), Конвейер(Адреса)),
		Кит.Свойство(Тексты.Текст("settings.package.ci.col.ref"), Кит.Код(Доверие.Реф))
			.Копируемое(Строка(Доверие.Реф)),
		Кит.Свойство(Тексты.Текст("settings.package.ci.col.author"), Кит.Текст(Автор(СтрокаДоверия))));

КонецФункции

// Пустой конвейер значит «любой конвейер репозитория» — так и написано: пустое значение врёт.
Функция Конвейер(Знач Адреса)
	Если ЗначениеЗаполнено(Адреса.Имя) Тогда
		Возврат Машинное(Адреса.Конвейер, Адреса.Имя);
	КонецЕсли;
	Возврат Кит.Текст(Тексты.Текст("settings.package.ci.any"));
КонецФункции

Функция ИмяКонвейера(Знач Адреса)
	Возврат ?(ЗначениеЗаполнено(Адреса.Имя), Адреса.Имя, Тексты.Текст("settings.package.ci.any"));
КонецФункции

// Ссылка живёт ВНУТРИ значения: подчёркивание тянется по пути, а не по всей строке.
Функция Машинное(Знач Адрес, Знач Значение)

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат Кит.Код(Значение);
	КонецЕсли;
	Результат = Кит.Код("");
	Результат.Добавить(Кит.Ссылка(Адрес, Кит.Текст(Значение)));
	Возврат Результат;

КонецФункции

// «Кем и когда»: логин исчезнувшей учётки не выдумывается — остаётся только дата.
Функция Автор(Знач СтрокаДоверия)

	Когда = Даты.ТолькоДата(СтрокаДоверия.Доверие.Создано);
	Если СтрокаДоверия.Автор = Неопределено Тогда
		Возврат Когда;
	КонецЕсли;
	Возврат Строка(СтрокаДоверия.Автор.Логин) + ", " + Когда;

КонецФункции

#КонецОбласти

#Область ПодтверждениеОтзыва

// Отзыв доверия называет запись так, чтобы её нельзя было спутать с соседней: репозиторий,
// конвейер и реф, у своей инсталляции — и издатель. Эха нет: запись заводится снова.
Функция ОкноУдаления(Знач Строки, Знач Состояние, Знач АдресРаздела)

	Если НЕ Окна.Открыто(Состояние, ВидУдаления()) Тогда
		Возврат Неопределено;
	КонецЕсли;
	СтрокаДоверия = ЗаписьОкна(Строки, Состояние);
	Если СтрокаДоверия = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Доверие = СтрокаДоверия.Доверие;

	Возврат Кит.Подтверждение(
			Тексты.Шаблон("settings.package.ci.revoke.title", СервисДоверия.ОписаниеЗаписи(Доверие)),
			Тексты.Текст("settings.package.ci.revoke.lead"),
			ОшибкаОкна(Состояние))
		.Кнопка(Тексты.Текст("settings.package.ci.revoke.button"))
		.Форма(Номер(Доверие) + "/delete").БезПерезагрузки().Якорь("doverie-otozvat").Открыто()
		.АдресЗакрытия(АдресРаздела);

КонецФункции

Функция ЗаписьОкна(Знач Строки, Знач Состояние)

	Если Состояние = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Состояние.Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого СтрокаДоверия Из Строки Цикл
		Если Номер(СтрокаДоверия.Доверие) = Состояние.Ключ Тогда
			Возврат СтрокаДоверия;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АдресаЗаписи(Знач Доверие)
	Возврат КороткаяФорма.АдресаЗаписи(Доверие.Провайдер, Доверие.Издатель, Доверие.Репозиторий,
		Доверие.Конвейер, Доверие.Реф);
КонецФункции

Функция Номер(Знач Доверие)
	Возврат Формат(Цел(Доверие.Идентификатор), "ЧГ=0; ЧН=0");
КонецФункции

#КонецОбласти

&Прозвище("СписокДоверияCI")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисДоверияCI") _СервисДоверия,
	&Пластилин(Значение = "МаскаРефа") _Маски,
	&Пластилин(Значение = "ПредставлениеПровайдераCI") _Провайдеры,
	&Пластилин(Значение = "КороткаяФормаДоверия") _КороткаяФорма,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено) Экспорт

	Кит = _Кит;
	СервисДоверия = _СервисДоверия;
	Маски = _Маски;
	Провайдеры = _Провайдеры;
	КороткаяФорма = _КороткаяФорма;
	Окна = _Окна;
	Тексты = _Тексты;
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);

КонецПроцедуры
