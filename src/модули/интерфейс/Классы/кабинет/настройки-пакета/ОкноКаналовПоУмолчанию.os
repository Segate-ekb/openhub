// Окно визарда «Каналы по умолчанию»: что будет заведено, по какому правилу, и одна кнопка,
// которая это делает. Полей у формы нет — окно показывает составы и спрашивает согласие.

Перем Кит;      // Кит (кит) — окно и таблица
Перем Каналы;   // КаналыПоУмолчанию (реестр) — что предлагается и по какому правилу
Перем Поля;     // ПоляТега — имя поля операции
Перем Тексты;   // ТекстыИнтерфейса (кит)
Перем ОкноТега; // ОкноТега — выражение правила в строке списка

#Область ПубличныйИнтерфейс

// Значение поля операции, по которому раздел узнаёт отправку визарда.
//
// Возвращаемое значение:
//  Строка - значение операции.
//
Функция Операция() Экспорт
	Возврат "каналы_по_умолчанию";
КонецФункции

// Окно визарда: печатается на странице пакета без каналов, открытым — по адресу ?окно=каналы
// или с отказом прежней отправки.
//
// Параметры:
//  Адрес - Строка - адрес страницы с этим окном открытым.
//  АдресРаздела - Строка - раздел без окна: туда окно закрывается.
//  Открыто - Булево - напечатать окно открытым.
//  Ошибка - Строка - отказ прежней отправки; "" — отказа нет (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел окна.
//
Функция Окно(Знач Адрес, Знач АдресРаздела, Знач Открыто, Знач Ошибка = "") Экспорт

	Возврат Кит.Окно(Тексты.Текст("settings.package.tags.wizard.title"),
			Кит.Уведомление(Ошибка).Вид("err").Когда(ЗначениеЗаполнено(Ошибка)),
			Кит.СкрытоеПоле(Поля.ИмяПоляОперации(), Операция()),
			ТаблицаПредложения())
		.Лид(Тексты.Текст("settings.package.tags.wizard.lead"))
		.Действия(Кит.Кнопка(Тексты.Текст("settings.package.tags.wizard.submit")).Основная().Иконка("куб"))
		.Вид("широкое").Форма("").БезПерезагрузки().Якорь("kanaly-po-umolchaniyu")
		.Адрес(Адрес).Открыто(Открыто).АдресЗакрытия(АдресРаздела);

КонецФункции

#КонецОбласти

#Область СоставПредложения

Функция ТаблицаПредложения()

	Строки = Новый Массив();
	Для Каждого Предложение Из Каналы.Предложения() Цикл
		Строки.Добавить(Новый Структура("channel, content, rule",
			Кит.Код(Предложение.Имя), Состав(Предложение), ОкноТега.ПравилоКоротко(Предложение.Правило)));
	КонецЦикла;

	Таблица = Кит.Таблица(Строки).Вид("карточками");
	Таблица.Колонка("channel", Тексты.Текст("settings.package.tags.wizard.col.channel"));
	Таблица.Колонка("content", Тексты.Текст("settings.package.tags.wizard.col.content"));
	Таблица.Колонка("rule", Тексты.Текст("settings.package.tags.wizard.col.rule"));
	Возврат Таблица;

КонецФункции

// Канал с разрешённым переизданием называет это здесь же: молчание читалось бы как «везде так».
Функция Состав(Знач Предложение)

	Возврат Кит.Холст(
		Кит.Текст(СоставСловами(Предложение.Имя)),
		Кит.Плашка(Тексты.Текст("settings.tags.badge.repush")).Вид("warn")
			.Когда(Предложение.ПерезаписьРазрешена));

КонецФункции

// Ключ собирается перечислением, а не склейкой: склеенного не видно ни в словаре, ни грепом.
Функция СоставСловами(Знач Имя)

	Если Имя = "stable" Тогда
		Возврат Тексты.Текст("settings.package.tags.wizard.stable");
	ИначеЕсли Имя = "prerelease" Тогда
		Возврат Тексты.Текст("settings.package.tags.wizard.prerelease");
	ИначеЕсли Имя = "develop" Тогда
		Возврат Тексты.Текст("settings.package.tags.wizard.develop");
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти

&Прозвище("ОкноКаналовПоУмолчанию")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "КаналыПоУмолчанию") _Каналы,
	&Пластилин(Значение = "ПоляТега") _Поля,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ОкноТега") _ОкноТега) Экспорт

	Кит = _Кит;
	Каналы = _Каналы;
	Поля = _Поля;
	Тексты = _Тексты;
	ОкноТега = _ОкноТега;

КонецПроцедуры
