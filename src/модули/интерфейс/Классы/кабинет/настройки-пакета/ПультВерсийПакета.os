// Операции раздела «Версии» дома «Пакет»: отзыв и возврат версии, ручной тег на версию и его
// снятие с подтверждением. Операции — закрытый список: всякая другая отбивается.

Перем РазборФормы;
Перем СервисВерсий;  // СервисВерсий (реестр)
Перем СервисТегов;   // СервисТегов (реестр)
Перем Окна;          // ОкноРаздела — подтверждена ли отправка
Перем Исходы;        // ИсходОкна — форма исхода
Перем Сбои;          // ТекстСбоя — причина отказа домена человеку
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ИменаПолей

// Имя поля операции.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Имя поля строки версии.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляВерсии() Экспорт
	Возврат "версия";
КонецФункции

// Имя поля ручного тега.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляТега() Экспорт
	Возврат "имя";
КонецФункции

// Операция «отозвать версию» — желаемое состояние, а не переключатель.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияОтзыва() Экспорт
	Возврат "yank";
КонецФункции

// Операция «вернуть отозванную версию».
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияВозврата() Экспорт
	Возврат "unyank";
КонецФункции

// Операция «поставить ручной тег на версию».
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияТега() Экспорт
	Возврат "тег_добавить";
КонецФункции

// Операция «снять ручной тег с версии».
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияСнятия() Экспорт
	Возврат "тег_снять";
КонецФункции

// Ключ окна снятия ручного тега с версии: имя тега не содержит «@», поэтому ключ делится
// на тег и версию однозначно, хотя дефисы бывают у обоих.
//
// Параметры:
//  ИмяТега - Строка - имя ручного тега.
//  Версия - Строка - строка версии.
//
// Возвращаемое значение:
//  Строка - «<тег>@<версия>».
//
Функция КлючСнятия(Знач ИмяТега, Знач Версия) Экспорт
	Возврат Строка(ИмяТега) + "@" + Строка(Версия);
КонецФункции

#КонецОбласти

#Область ПубличныйИнтерфейс

// Применяет операцию раздела «Версии» дома «Пакет».
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Пользователь - Пользователь, Неопределено - кто действует; попадает в событие.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - исход (см. ИсходОкна.Удача): отказ тега — в окне «тег» версии, снятие без
//              подтверждения — вопрос окном «снять», прочие отказы — над разделом.
//
Функция Применить(Знач Пакет, Знач Пользователь, Знач Форма) Экспорт

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, ИмяПоляОперации())));
	Версия = СокрЛП(РазборФормы.Поле(Форма, ИмяПоляВерсии()));
	ИмяТега = СокрЛП(РазборФормы.Поле(Форма, ИмяПоляТега()));
	Кто = ?(Пользователь = Неопределено, "", Строка(Пользователь.Логин));

	Если Операция = ОперацияОтзыва() ИЛИ Операция = ОперацияВозврата() Тогда
		Возврат Отозвать(Пакет, Версия, Операция = ОперацияОтзыва(), Кто);
	ИначеЕсли Операция = ОперацияТега() Тогда
		Возврат ПоставитьТег(Пакет, Версия, ИмяТега, Кто, Форма);
	ИначеЕсли Операция = ОперацияСнятия() Тогда
		Возврат СнятьТег(Пакет, Версия, ИмяТега, Кто, Форма);
	КонецЕсли;

	// белый список операций: неизвестная не должна восстанавливать отозванную версию
	Возврат Исходы.Отбито(Тексты.Текст("settings.package.versions.error.operation"));

КонецФункции

#КонецОбласти

#Область Операции

// Событие отзыва и возврата публикует сам СервисВерсий — одна точка на оба пути отзыва.
Функция Отозвать(Знач Пакет, Знач Версия, Знач Отозвана, Знач Кто)

	Попытка
		СервисВерсий.ОтозватьВерсию(Пакет.Идентификатор, Версия, Отозвана, Кто);
	Исключение
		Возврат ОтказДомена(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Исходы.Удача();

КонецФункции

// Отказ — под выбором тега в том же окне; имя, присланное формой, в ответ не уходит.
Функция ПоставитьТег(Знач Пакет, Знач Версия, Знач ИмяТега, Знач Кто, Знач Форма)

	Если НЕ ЗначениеЗаполнено(ИмяТега) Тогда
		Возврат ОтбитоВОкнеТега(Версия, Форма, Тексты.Текст("form.error.required"));
	КонецЕсли;
	Если НЕ ЭтоРучнойТег(Пакет, ИмяТега) Тогда
		Возврат ОтбитоВОкнеТега(Версия, Форма, Тексты.Текст("settings.package.versions.menu.tag.unknown"));
	КонецЕсли;

	Попытка
		СервисТегов.ПометитьВерсию(Пакет.Идентификатор, ИмяТега, Версия, Кто);
	Исключение
		Возврат ОтказДомена(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Исходы.Удача();

КонецФункции

// Без поля подтверждения (форма ушла без скрипта) метка не снимается: ответ ведёт на окно
// подтверждения. Форма старой вкладки с её прежним полем «подтверждение» — устарела.
Функция СнятьТег(Знач Пакет, Знач Версия, Знач ИмяТега, Знач Кто, Знач Форма)

	Если Форма.Получить(ИмяСнятогоПоляПодтверждения()) <> Неопределено Тогда
		Возврат Исходы.Отбито(Тексты.Текст("settings.package.versions.error.stale"));
	КонецЕсли;
	Если НЕ ЭтоРучнойТег(Пакет, ИмяТега) Тогда
		Возврат Исходы.Отбито(Тексты.Текст("settings.package.versions.menu.tag.unknown"));
	КонецЕсли;
	Если НЕ Окна.Подтверждено(Форма) Тогда
		Возврат Исходы.Спросить("снять", КлючСнятия(ИмяТега, Версия));
	КонецЕсли;

	Попытка
		СервисТегов.СнятьМетку(Пакет.Идентификатор, ИмяТега, Версия, Кто);
	Исключение
		Возврат ОтказДомена(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Исходы.Удача();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сервер судит сам: ставить и снимать можно только ручной тег пакета.
Функция ЭтоРучнойТег(Знач Пакет, Знач ИмяТега)

	Искомое = НРег(ИмяТега);
	Для Каждого Тег Из СервисТегов.РучныеТегиПакета(Пакет.Идентификатор) Цикл
		Если НРег(СокрЛП(Строка(Тег.Имя))) = Искомое Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Прежняя форма снятия несла это поле вместо подтверждения кита.
Функция ИмяСнятогоПоляПодтверждения()
	Возврат "подтверждение";
КонецФункции

// Отказ — под выбором тега в окне «тег» этой версии.
Функция ОтбитоВОкнеТега(Знач Версия, Знач Форма, Знач Текст)
	Возврат Исходы.ВОкне(Исходы.ОтбитоПолем(ИмяПоляТега(), Текст), "тег", Версия, Форма);
КонецФункции

Функция ОтказДомена(Знач Информация)
	Возврат Исходы.Отбито(Тексты.Шаблон("settings.package.versions.error.save", Сбои.Человеку(Информация)));
КонецФункции

#КонецОбласти

&Прозвище("ПультВерсийПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ИсходОкна") _Исходы,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	СервисВерсий = _СервисВерсий;
	СервисТегов = _СервисТегов;
	Окна = _Окна;
	Исходы = _Исходы;
	Сбои = _Сбои;
	Тексты = _Тексты;

КонецПроцедуры
