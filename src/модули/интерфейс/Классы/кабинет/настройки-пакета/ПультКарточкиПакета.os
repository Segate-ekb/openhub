// Сохранение раздела «Карточка» дома «Пакет»: поля карточки формой с панелью и пометки
// каталога — каждая своей формой.

Перем РазборФормы;
Перем Правка;  // ПравкаКарточкиПакета (реестр) — проверка, запись и след в журнале
Перем Пометки; // ПометкиКаталогаПакета — хвосты адресов, поля и свойства карточки пометок

#Область ПубличныйИнтерфейс

// Сохраняет поля карточки пакета значениями формы; пометок каталога не касается. Негодный
// адрес репозитория — исключение со словами отказа.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Пользователь - Пользователь, Неопределено - кто правит; попадает в журнал аудита.
//  Форма - Соответствие - разобранная форма.
//
Процедура Сохранить(Знач Пакет, Знач Пользователь, Знач Форма) Экспорт

	Свойства = Новый Структура();
	Свойства.Вставить("Описание", РазборФормы.Поле(Форма, "описание"));
	Свойства.Вставить("КлючевыеСлова", РазборФормы.Поле(Форма, "ключевые_слова"));
	Свойства.Вставить("Лицензия", РазборФормы.Поле(Форма, "лицензия"));
	Свойства.Вставить("АдресРепозитория", РазборФормы.Поле(Форма, "репозиторий"));

	Править(Пакет, Пользователь, Свойства);

КонецПроцедуры

// Пометка каталога, чья форма уходит на этот хвост адреса раздела «Карточка».
//
// Параметры:
//  Хвост - Строка - хвост адреса формы из маршрута.
//
// Возвращаемое значение:
//  Структура, Неопределено - пометка (ПометкиКаталогаПакета); Неопределено — такой нет.
//
Функция Пометка(Знач Хвост) Экспорт
	Возврат Пометки.ПоХвосту(Хвост);
КонецФункции

// Ставит или снимает одну пометку каталога значением её тумблера. Форма без поля пометки
// ничего не меняет.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Пользователь - Пользователь, Неопределено - кто правит; попадает в журнал аудита.
//  Пометка - Структура - пометка (см. Пометка).
//  Форма - Соответствие - разобранная форма.
//
Процедура Пометить(Знач Пакет, Знач Пользователь, Знач Пометка, Знач Форма) Экспорт

	// выключенный тумблер присылает явное «0», поэтому «нет поля» — не «выключено»
	Если Форма.Получить(Пометка.Поле) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Править(Пакет, Пользователь, Пометки.СвойстваКарточки(Пометка, РазборФормы.Флажок(Форма, Пометка.Поле)));

КонецПроцедуры

#КонецОбласти

Процедура Править(Знач Пакет, Знач Пользователь, Знач Свойства)
	Правка.Править(Пакет.Идентификатор, Свойства,
		?(Пользователь = Неопределено, "", Строка(Пользователь.Логин)));
КонецПроцедуры

&Прозвище("ПультКарточкиПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ПравкаКарточкиПакета") _Правка,
	&Пластилин(Значение = "ПометкиКаталогаПакета") _Пометки) Экспорт

	РазборФормы = _РазборФормы;
	Правка = _Правка;
	Пометки = _Пометки;

КонецПроцедуры
