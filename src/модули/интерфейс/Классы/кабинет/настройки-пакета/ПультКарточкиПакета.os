// Сохранение метаданных пакета из раздела «Карточка» дома «Пакет».

Перем РазборФормы;
Перем Правка;  // ПравкаКарточкиПакета (реестр) — проверка, запись и след в журнале

#Область ПубличныйИнтерфейс

// Сохраняет карточку пакета значениями формы. Негодный адрес репозитория — исключение
// со словами отказа.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Пользователь - Пользователь, Неопределено - кто правит; попадает в журнал аудита.
//  Форма - Соответствие - разобранная форма.
//
Процедура Сохранить(Знач Пакет, Знач Пользователь, Знач Форма) Экспорт

	Свойства = Новый Структура();
	Свойства.Вставить("Описание", РазборФормы.Поле(Форма, "описание"));
	Свойства.Вставить("КлючевыеСлова", РазборФормы.Поле(Форма, "ключевые_слова"));
	Свойства.Вставить("Лицензия", РазборФормы.Поле(Форма, "лицензия"));
	Свойства.Вставить("АдресРепозитория", РазборФормы.Поле(Форма, "репозиторий"));
	// флажки читаются сравнением: тумблер присылает поле всегда (см. РазборФормы.Флажок)
	Свойства.Вставить("Устарел", РазборФормы.Флажок(Форма, "устарел"));
	Свойства.Вставить("Скрыт", РазборФормы.Флажок(Форма, "скрыт"));

	Правка.Править(Пакет.Идентификатор, Свойства,
		?(Пользователь = Неопределено, "", Строка(Пользователь.Логин)));

КонецПроцедуры

#КонецОбласти

&Прозвище("ПультКарточкиПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ПравкаКарточкиПакета") _Правка) Экспорт

	РазборФормы = _РазборФормы;
	Правка = _Правка;

КонецПроцедуры
