// Окно «Доверить конвейеру»: ссылка на workflow и её разбор, тип репозитория сегментами — поле
// конвейера в наборе своего типа, репозиторий, реф и его вид, издатель под катом. Имена полей —
// здесь же: по ним пульт читает форму окна.

Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем СервисДоверия;  // СервисДоверияCI (публикация) — словарь провайдеров
Перем Стража;         // СтражИздателейCI (публикация) — список издателей хаба
Перем Провайдеры;     // ПредставлениеПровайдераCI — подписи типов
Перем Сниппеты;       // СниппетыКонвейеров — чем запускается готовый конвейер
Перем Виды;           // ВидРефаДоверия (публикация) — виды рефа
Перем Окна;           // ОкноРаздела — адрес окна, набранное и отказы
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ИменаПолей

// Имя поля операции: её несёт нажатая кнопка окна — «доверить» или «разобрать».
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Имя поля ссылки на файл workflow.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляСсылки() Экспорт
	Возврат "ссылка";
КонецФункции

// Имя поля типа репозитория (сегменты).
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляПровайдера() Экспорт
	Возврат "провайдер";
КонецФункции

// Имя поля репозитория.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляРепозитория() Экспорт
	Возврат "репозиторий";
КонецФункции

// Имя поля конвейера в наборе типа репозитория: у каждого типа своё — у одноимённых полей
// разбор взял бы первое.
//
// Параметры:
//  Провайдер - Строка - тип репозитория.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляКонвейера(Знач Провайдер) Экспорт
	Возврат ?(ЭтоGitLab(Провайдер), "конвейер_gitlab", "конвейер");
КонецФункции

// Имя поля рефа.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляРефа() Экспорт
	Возврат "реф";
КонецФункции

// Имя поля вида рефа.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляВидаРефа() Экспорт
	Возврат "вид_рефа";
КонецФункции

// Имя поля издателя.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляИздателя() Экспорт
	Возврат "издатель";
КонецФункции

#КонецОбласти

#Область ПубличныйИнтерфейс

// Окно «Доверить конвейеру»: печатается на странице всегда, открытым — по адресу ?окно=новый
// или с отбитой либо разобранной формой.
//
// Параметры:
//  АдресРаздела - Строка - адрес раздела: серверная дорога к окну.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел окна.
//
Функция Окно(Знач АдресРаздела, Знач Состояние) Экспорт

	Якорь = "doverie-novoe";
	Открыто = Окна.Открыто(Состояние, ВидОкна());
	Возврат Кит.Окно(Тексты.Текст("settings.package.ci-new.title"),
			ОшибкаОкна(Состояние),
			Кит.Холст(ПолеСсылки(Состояние), КнопкаРазбора()),
			ВыборТипа(Состояние),
			ПолеРепозитория(Состояние),
			ПолеРефа(Состояние),
			ВыборВидаРефа(Состояние),
			Кит.Уведомление(Тексты.Текст("settings.package.ci-new.ref.warning")).Вид("warn"),
			Кит.Раскрывашка(ВыборИздателя(Состояние))
				.Шапка(Тексты.Текст("settings.package.ci-new.advanced")))
		.Лид(Тексты.Текст("settings.package.ci-new.lead"))
		.Форма("").Адрес(Окна.Адрес(АдресРаздела, ВидОкна())).БезПерезагрузки().Якорь(Якорь)
		.Открыто(Открыто).АдресЗакрытия(АдресРаздела)
		.Действия(Кит.Кнопка(Тексты.Текст("settings.package.ci-new.button")).Основная().Иконка("ключ")
			.Имя(ИмяПоляОперации(), ОперацияДоверить()));

КонецФункции

// Вид окна заведения в адресе ?окно=…
//
// Возвращаемое значение:
//  Строка.
//
Функция ВидОкна() Экспорт
	Возврат "новый";
КонецФункции

// Операция кнопки «Доверить конвейеру».
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияДоверить() Экспорт
	Возврат "доверить";
КонецФункции

// Операция кнопки «Разобрать ссылку».
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияРазобрать() Экспорт
	Возврат "разобрать";
КонецФункции

#КонецОбласти

#Область Поля

// Запись по ссылке НЕ создаётся: разобранное встаёт в поля окна и сверяется глазами.
Функция ПолеСсылки(Знач Состояние)

	Имя = ИмяПоляСсылки();
	Возврат Кит.Поле(Имя, Тексты.Текст("settings.package.ci-link.label"))
		.Значение(Окна.Значение(Состояние, Имя))
		.Пример("https://github.com/acme/lib/blob/main/.github/workflows/release.yml")
		.Подсказка(Тексты.Текст("settings.package.ci-link.lead"))
		.Справка(Тексты.Текст("settings.package.ci-link.hint"))
		.Ошибка(Окна.Отказ(Состояние, Имя));

КонецФункции

// Разбор заполняет обязательные поля, поэтому браузер их не проверяет: кнопка без валидации.
Функция КнопкаРазбора()
	Возврат Кит.Ряд("справа",
		Кит.Кнопка(Тексты.Текст("settings.package.ci-link.button")).Вторичная().Малая().Иконка("палочка")
			.Имя(ИмяПоляОперации(), ОперацияРазобрать()).БезВалидации());
КонецФункции

// У GitHub файлов workflow много — имя файла спрашивается прямо; у GitLab путь к конфигу почти
// всегда стандартный, и поле стоит с готовым .gitlab-ci.yml.
Функция ВыборТипа(Знач Состояние)

	Выбор = Кит.Сегменты(ИмяПоляПровайдера())
		.Подпись(Тексты.Текст("settings.package.ci-new.provider.label"))
		.Выбрано(Окна.Значение(Состояние, ИмяПоляПровайдера(), СервисДоверия.ДопустимыеПровайдеры()[0]));
	Для Каждого Ключ Из СервисДоверия.ДопустимыеПровайдеры() Цикл
		Выбор.Добавить(Кит.Сегмент(Ключ, Провайдеры.Подпись(Ключ), ПолеКонвейера(Состояние, Ключ)));
	КонецЦикла;
	Возврат Выбор;

КонецФункции

Функция ПолеКонвейера(Знач Состояние, Знач Провайдер)

	Имя = ИмяПоляКонвейера(Провайдер);
	Возврат Кит.Поле(Имя, Тексты.Текст("settings.package.ci-new.workflow.label"))
		.Значение(Окна.Значение(Состояние, Имя, ?(ЭтоGitLab(Провайдер), ".gitlab-ci.yml", "")))
		.Пример(?(ЭтоGitLab(Провайдер), ".gitlab-ci.yml", "e2e.yml"))
		.Подсказка(?(ЭтоGitLab(Провайдер), Тексты.Текст("settings.package.ci-new.workflow.hint.gitlab"),
			Тексты.Текст("settings.package.ci-new.workflow.hint")))
		.Ошибка(Окна.Отказ(Состояние, Имя));

КонецФункции

Функция ПолеРепозитория(Знач Состояние)

	Имя = ИмяПоляРепозитория();
	Возврат Кит.Поле(Имя, Тексты.Текст("settings.package.ci-new.repo.label")).Обязательное()
		.Значение(Окна.Значение(Состояние, Имя))
		.Пример("acme/lib")
		.Подсказка(Тексты.Текст("settings.package.ci-new.repo.hint"))
		.Ошибка(Окна.Отказ(Состояние, Имя));

КонецФункции

// Маска и вид рефа приходят от готового конвейера этой же страницы: маска «v*», записанная
// веткой, не совпала бы ни с одним запуском по тегу.
Функция ПолеРефа(Знач Состояние)

	Имя = ИмяПоляРефа();
	Возврат Кит.Поле(Имя, Тексты.Текст("settings.package.ci-new.ref.label")).Обязательное()
		.Значение(Окна.Значение(Состояние, Имя))
		.Пример(Сниппеты.МаскаТеговРелиза())
		.Справка(Тексты.Текст("settings.package.ci-new.ref.hint"))
		.Ошибка(Окна.Отказ(Состояние, Имя));

КонецФункции

// Пока вида не выбирали, стоит вид ЗАПУСКА готового конвейера: догадок по строке здесь нет.
Функция ВыборВидаРефа(Знач Состояние)

	Имя = ИмяПоляВидаРефа();
	Возврат Кит.Поле(Имя, Тексты.Текст("settings.package.ci-new.ref-kind.label"))
		.Вариант(Виды.Ветка(), Тексты.Текст("settings.package.ci-new.ref-kind.branch"))
		.Вариант(Виды.Тег(), Тексты.Текст("settings.package.ci-new.ref-kind.tag"))
		.Значение(Окна.Значение(Состояние, Имя, Сниппеты.ВидРефаЗапуска()))
		.Справка(Тексты.Текст("settings.package.ci-new.ref-kind.hint"))
		.Ошибка(Окна.Отказ(Состояние, Имя));

КонецФункции

// Издатель выводится из типа репозитория, а выбирают его только на инсталляции, где издателей
// одного типа несколько; пустой вариант — «по типу репозитория».
Функция ВыборИздателя(Знач Состояние)

	Имя = ИмяПоляИздателя();
	Поле = Кит.Поле(Имя, Тексты.Текст("settings.package.ci-new.issuer.label"))
		.Вариант("", Тексты.Текст("settings.package.ci-new.issuer.auto"));
	Для Каждого Издатель Из Стража.РазрешённыеИздатели() Цикл
		Поле.Вариант(Издатель, Издатель);
	КонецЦикла;
	Возврат Поле.Значение(Окна.Значение(Состояние, Имя))
		.Справка(Тексты.Текст("settings.package.ci-new.issuer.hint"))
		.Ошибка(Окна.Отказ(Состояние, Имя));

КонецФункции

Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

Функция ЭтоGitLab(Знач Провайдер)
	Возврат Провайдер = СервисДоверия.ПровайдерGitLab();
КонецФункции

#КонецОбласти

&Прозвище("ФормаДоверияCI")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисДоверияCI") _СервисДоверия,
	&Пластилин(Значение = "СтражИздателейCI") _Стража,
	&Пластилин(Значение = "ПредставлениеПровайдераCI") _Провайдеры,
	&Пластилин(Значение = "СниппетыКонвейеров") _Сниппеты,
	&Пластилин(Значение = "ВидРефаДоверия") _Виды,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	СервисДоверия = _СервисДоверия;
	Стража = _Стража;
	Провайдеры = _Провайдеры;
	Сниппеты = _Сниппеты;
	Виды = _Виды;
	Окна = _Окна;
	Тексты = _Тексты;

КонецПроцедуры
