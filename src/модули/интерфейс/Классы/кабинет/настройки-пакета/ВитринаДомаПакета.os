// Секции разделов дома «Пакет».

Перем Дом;             // ДомПакета — адреса разделов
Перем ДомПула;         // ДомПула — адрес раздела доступа пула
Перем Карточка;        // ВитринаКарточкиПакета
Перем Версии;          // ВитринаВерсийПакета
Перем Права;           // ВитринаПравПакета
Перем ПультПрав;       // ПультПравПакета — вправе ли смотрящий выдавать права
Перем ОпаснаяЗона;     // ВитринаОпаснойЗоныПакета

#Область ПубличныйИнтерфейс

// Секции раздела дома «Пакет».
//
// Параметры:
//  Параметры - Структура:
//    * Ключ - Строка - ключ раздела;
//    * Пул - Пул - пул пакета;
//    * Пакет - Пакет - пакет раздела;
//    * Пользователь - Пользователь, Неопределено - смотрящий;
//    * Токен - Строка - CSRF-токен сессии;
//    * Окно - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Массив - секции раздела, которые печатает дом.
//
Функция Секции(Знач Параметры) Экспорт

	Ключ = Параметры.Ключ;
	Пул = Параметры.Пул;
	Пакет = Параметры.Пакет;
	АдресРаздела = Дом.АдресРаздела(Пул.Имя, Пакет.Имя, Ключ);

	Результат = Новый Массив();

	Если Ключ = "card" Тогда
		Для Каждого Секция Из Карточка.Секции(Пакет) Цикл
			Результат.Добавить(Секция);
		КонецЦикла;
	ИначеЕсли Ключ = "access" Тогда
		Для Каждого Секция Из Права.Секции(Новый Структура("Пакет, Адрес, МожетВыдавать, АдресДоступаПула, Окно",
			Пакет, АдресРаздела,
			ПультПрав.МожетВыдавать(Параметры.Пользователь, Пакет),
			ДомПула.АдресРаздела(Пул.Имя, "access"), Параметры.Окно)) Цикл
			Результат.Добавить(Секция);
		КонецЦикла;
	ИначеЕсли Ключ = "versions" Тогда
		Результат.Добавить(Версии.Секция(Новый Структура("Пакет, Адрес, АдресТегов, Окно", Пакет,
			АдресРаздела, Дом.АдресРаздела(Пул.Имя, Пакет.Имя, "tags"), Параметры.Окно)));
	ИначеЕсли Ключ = "danger" Тогда
		Результат.Добавить(ОпаснаяЗона.Секция(Пакет, АдресРаздела, Параметры.Окно));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<ключ>: каждый раздел знает свои.
//
// Параметры:
//  Ключ - Строка - ключ раздела дома.
//
// Возвращаемое значение:
//  Строка - виды через запятую; "" — у раздела окон по адресу нет.
//
Функция ВидыОкон(Знач Ключ) Экспорт
	Если Ключ = "access" Тогда
		Возврат Права.ВидыОкон();
	ИначеЕсли Ключ = "versions" Тогда
		Возврат Версии.ВидыОкон();
	ИначеЕсли Ключ = "danger" Тогда
		Возврат ОпаснаяЗона.ВидыОкон();
	КонецЕсли;
	Возврат "";

КонецФункции

// Напечатает ли раздел окно, которое называет состояние отбитой формы: окна нет — отказ
// встаёт тостом над разделом.
//
// Параметры:
//  Ключ - Строка - ключ раздела дома.
//  Пакет - Пакет - пакет раздела.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Ключ, Знач Пакет, Знач Состояние) Экспорт

	Если Ключ = "versions" Тогда
		Возврат Версии.ЕстьОкно(Пакет, Состояние);
	ИначеЕсли Ключ = "danger" ИЛИ Ключ = "access" Тогда
		// окно выдачи и подтверждение удаления печатаются всегда, когда форма до них дошла
		Возврат Состояние <> Неопределено;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаДомаПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ДомПакета") _Дом,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ВитринаКарточкиПакета") _Карточка,
	&Пластилин(Значение = "ВитринаВерсийПакета") _Версии,
	&Пластилин(Значение = "ВитринаПравПакета") _Права,
	&Пластилин(Значение = "ПультПравПакета") _ПультПрав,
	&Пластилин(Значение = "ВитринаОпаснойЗоныПакета") _ОпаснаяЗона) Экспорт

	Дом = _Дом;
	ДомПула = _ДомПула;
	Карточка = _Карточка;
	Версии = _Версии;
	Права = _Права;
	ПультПрав = _ПультПрав;
	ОпаснаяЗона = _ОпаснаяЗона;

КонецПроцедуры
