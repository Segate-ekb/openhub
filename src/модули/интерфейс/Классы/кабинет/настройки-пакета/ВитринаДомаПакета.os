// Секции разделов дома «Пакет» и уведомление о составе канала сохранённого тега.

Перем Дом;             // ДомПакета — адреса разделов
Перем ДомПула;         // ДомПула — адрес раздела доступа пула
Перем Карточка;        // ВитринаКарточкиПакета
Перем Теги;            // ВитринаТеговПакета
Перем Конструктор;     // ВитринаКонструктораТега
Перем Версии;          // ВитринаВерсийПакета
Перем Права;           // ВитринаПравПакета
Перем ПультПрав;       // ПультПравПакета — вправе ли смотрящий выдавать права
Перем Конструкторы;    // КонструкторТега — состояние конструктора по адресу
Перем СоставКанала;    // СоставКаналаТега — уведомление о составе канала
Перем Бланки;          // БланкРаздела — адрес и токен раздела дома
Перем Страницы; // АдресаСтраниц (реестр) — страница пакета в опасной зоне

#Область ПубличныйИнтерфейс

// Секции раздела дома «Пакет».
//
// Параметры:
//  Параметры - Структура:
//    * Ключ - Строка - ключ раздела;
//    * Пул - Пул - пул пакета;
//    * Пакет - Пакет - пакет раздела;
//    * Пользователь - Пользователь, Неопределено - смотрящий;
//    * Токен - Строка - CSRF-токен сессии;
//    * Конструктор - Структура, Неопределено - состояние конструктора тега; Неопределено — собрать по адресу;
//    * ВидИзАдреса - Строка - код вида тега из адреса;
//    * ТегИзАдреса - Строка - имя тега из адреса;
//    * Снятие - Структура, Неопределено - Тег и Версия, снятие метки с которой ждёт подтверждения;
//    * Заведение - Структура, Неопределено - состояние окна раздела: выдачи роли в «Доступе» (Открыта, Заполнение, Отказы), визарда каналов в «Тегах» (Открыта).
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Ключ = Параметры.Ключ;
	Пул = Параметры.Пул;
	Пакет = Параметры.Пакет;
	Бланк = Бланки.НаАдресе(Дом.АдресРаздела(Пул.Имя, Пакет.Имя, Ключ), Параметры.Токен);

	Результат = Новый Массив();

	Если Ключ = "card" Тогда
		Результат.Добавить(Карточка.СекцияКарточки(Пакет, Бланк));
	ИначеЕсли Ключ = "access" Тогда
		Для Каждого Секция Из Права.Секции(Новый Структура(
			"Пакет, Адрес, Токен, МожетВыдавать, АдресДоступаПула, Заведение",
			Пакет, Бланки.Адрес(Бланк), Бланк.Токен,
			ПультПрав.МожетВыдавать(Параметры.Пользователь, Пакет),
			ДомПула.АдресРаздела(Пул.Имя, "access"), Параметры.Заведение)) Цикл
			Результат.Добавить(Секция);
		КонецЦикла;
	ИначеЕсли Ключ = "tags" Тогда
		Результат.Добавить(Теги.Секция(Пакет, Бланк, Параметры.Заведение));
		Результат.Добавить(Конструктор.Секция(Бланк, СостояниеКонструктора(Параметры)));
	ИначеЕсли Ключ = "versions" Тогда
		Если Параметры.Снятие <> Неопределено Тогда
			Результат.Добавить(Версии.СекцияПодтвержденияСнятия(Бланк, Параметры.Снятие));
		КонецЕсли;
		Результат.Добавить(Версии.Секция(Пакет, Бланк,
			Дом.АдресРаздела(Пул.Имя, Пакет.Имя, "tags")));
	ИначеЕсли Ключ = "danger" Тогда
		Результат.Добавить(Карточка.СекцияОпасной(Пул.Имя + "/" + Пакет.Имя,
			Страницы.Пакета(Пул.Имя, Пакет.Имя)));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Уведомление о составе канала только что сохранённого тега.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  ИмяТега - Строка - имя сохранённого тега; "" — сохранения не было.
//
// Возвращаемое значение:
//  Структура, Неопределено - уведомление раздела; Неопределено — говорить не о чем.
//
Функция УведомлениеОСоставеКанала(Знач ПакетИдентификатор, Знач ИмяТега) Экспорт
	Возврат СоставКанала.Уведомление(ПакетИдентификатор, ИмяТега);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// После операции приезжает готовым: пульт уже сложил в него введённое и причину отказа.
Функция СостояниеКонструктора(Знач Параметры)

	Если Параметры.Конструктор <> Неопределено Тогда
		Возврат Параметры.Конструктор;
	КонецЕсли;

	Возврат Конструкторы.ПоАдресу(Параметры.Пакет.Идентификатор,
		Параметры.ВидИзАдреса, Параметры.ТегИзАдреса);

КонецФункции

#КонецОбласти

&Прозвище("ВитринаДомаПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ДомПакета") _Дом,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ВитринаКарточкиПакета") _Карточка,
	&Пластилин(Значение = "ВитринаТеговПакета") _Теги,
	&Пластилин(Значение = "ВитринаКонструктораТега") _Конструктор,
	&Пластилин(Значение = "ВитринаВерсийПакета") _Версии,
	&Пластилин(Значение = "ВитринаПравПакета") _Права,
	&Пластилин(Значение = "ПультПравПакета") _ПультПрав,
	&Пластилин(Значение = "КонструкторТега") _Конструкторы,
	&Пластилин(Значение = "СоставКаналаТега") _СоставКанала,
	&Пластилин(Значение = "БланкРаздела") _Бланки,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы) Экспорт

	Дом = _Дом;
	ДомПула = _ДомПула;
	Карточка = _Карточка;
	Теги = _Теги;
	Конструктор = _Конструктор;
	Версии = _Версии;
	Права = _Права;
	ПультПрав = _ПультПрав;
	Конструкторы = _Конструкторы;
	СоставКанала = _СоставКанала;
	Бланки = _Бланки;
	Страницы = _Страницы;

КонецПроцедуры
