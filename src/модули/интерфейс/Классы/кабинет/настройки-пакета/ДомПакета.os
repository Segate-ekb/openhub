// Дом настроек «Пакет»: адреса, разделы и крошки настроек пакета.

Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Сборка;         // СборкаДомаНастроек — перечень разделов дома
Перем Страницы;       // АдресаСтраниц (реестр) — дом лежит под страницей своего пакета
Перем ДомПула;        // ДомПула — путь к пулу пакета крошками
Перем СервисДоверия;  // СервисДоверияCI (публикация) — порог раздела «Доверенная публикация»
Перем Удаление;       // ПультУдаленияПакета — есть ли у смотрящего необратимое действие
Перем Перечень;       // ТаблицаЗначений — разделы дома по порядку колонки

// Ключ дома.
//
// Возвращаемое значение:
//  Строка - ключ дома.
//
Функция Ключ() Экспорт
	Возврат "package";
КонецФункции

// Базовый адрес дома.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Строка - "/pools/{pool}/packages/{pkg}/settings".
//
Функция БазовыйАдрес(Знач ИмяПула, Знач ИмяПакета) Экспорт
	Возврат Страницы.НастроекПакета(ИмяПула, ИмяПакета);
КонецФункции

// Раздел по умолчанию.
//
// Возвращаемое значение:
//  Строка - раздел по умолчанию.
//
Функция РазделПоУмолчанию() Экспорт
	Возврат КлючКарточки();
КонецФункции

// Ключ раздела «Карточка»: в нём живут и пометки каталога.
//
// Возвращаемое значение:
//  Строка - ключ раздела.
//
Функция КлючКарточки() Экспорт
	Возврат "card";
КонецФункции

// Ключ раздела «Опасная зона».
//
// Возвращаемое значение:
//  Строка - ключ раздела.
//
Функция КлючОпасной() Экспорт
	Возврат "danger";
КонецФункции

// Адрес раздела дома.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Строка - адрес раздела дома.
//
Функция АдресРаздела(Знач ИмяПула, Знач ИмяПакета, Знач Ключ) Экспорт
	Возврат БазовыйАдрес(ИмяПула, ИмяПакета) + "/" + Ключ;
КонецФункции

// Разделы дома для модели (ОтветыНастроек.МодельДома).
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//  Активный - Строка - ключ активного раздела.
//  Пользователь - Пользователь, Неопределено - смотрящий; от него зависит состав разделов
//                 с порогом выше домового (необязательный, по умолчанию Неопределено).
//  Пакет - Пакет, Неопределено - пакет раздела (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - разделы дома (СборкаДомаНастроек.РазделыДома).
//
Функция Разделы(Знач ИмяПула, Знач ИмяПакета, Знач Активный, Знач Пользователь = Неопределено,
	Знач Пакет = Неопределено) Экспорт

	Возврат Сборка.РазделыДома(БазовыйАдрес(ИмяПула, ИмяПакета), Доступные(Пользователь, Пакет), Активный);

КонецФункции

// Есть ли раздел с таким ключом.
//
// Параметры:
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Булево - есть ли раздел с таким ключом.
//
Функция ЕстьРаздел(Знач Ключ) Экспорт
	Возврат Сборка.РазделПеречня(Перечень, Ключ) <> Неопределено;
КонецФункции

// Открыт ли раздел смотрящему: раздел с порогом выше домового или без единого действия
// для этой роли отвечает как несуществующий.
//
// Параметры:
//  Ключ - Строка - ключ раздела.
//  Пользователь - Пользователь, Неопределено - смотрящий.
//  Пакет - Пакет - пакет раздела.
//
// Возвращаемое значение:
//  Булево - открыт ли раздел.
//
Функция РазделОткрыт(Знач Ключ, Знач Пользователь, Знач Пакет) Экспорт
	Возврат Сборка.РазделПеречня(Доступные(Пользователь, Пакет), Ключ) <> Неопределено;
КонецФункции

// Подпись раздела.
//
// Параметры:
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Строка - подпись раздела либо "".
//
Функция ПодписьРаздела(Знач Ключ) Экспорт
	Раздел = Сборка.РазделПеречня(Перечень, Ключ);
	Возврат ?(Раздел = Неопределено, "", Раздел.Подпись);
КонецФункции

// Крошки страниц дома: путь к пулу, пакет — его страницей, последней — «настройки», текстом.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Массив из Структура - крошки: Подпись, Адрес (у последней пустой).
//
Функция Крошки(Знач ИмяПула, Знач ИмяПакета) Экспорт

	Результат = ДомПула.КрошкиПула(ИмяПула);
	Результат.Добавить(Новый Структура("Подпись, Адрес", ИмяПакета, Страницы.Пакета(ИмяПула, ИмяПакета)));
	Результат.Добавить(Новый Структура("Подпись, Адрес", Тексты.Текст("settings.package.crumb"), ""));
	Возврат Результат;

КонецФункции

// Объект дома, один на все его разделы: у этого дома его нет — объект (пакет) называет раздел.
//
// Возвращаемое значение:
//  Строка - "".
//
Функция Объект() Экспорт
	Возврат "";
КонецФункции

// Заголовок дома.
//
// Возвращаемое значение:
//  Строка - заголовок дома.
//
Функция Заголовок() Экспорт
	Возврат Тексты.Текст("settings.package.title");
КонецФункции

// Пояснение дома: у пакета его нет — разделы объясняют себя сами.
//
// Возвращаемое значение:
//  Строка - пустая строка.
//
Функция Пояснение() Экспорт
	Возврат "";
КонецФункции

// Доверие — порог ВЫШЕ домового, опасная зона — только когда в ней есть что делать: пустой
// её не бывает. Порог спрашивается у домена, а не считается здесь.
Функция Доступные(Знач Пользователь, Знач Пакет)

	Если Пакет = Неопределено Тогда
		Возврат Перечень;
	КонецЕсли;

	Скрытые = Новый Массив();
	Если НЕ СервисДоверия.МожетНастраивать(Пользователь, Пакет) Тогда
		Скрытые.Добавить(КлючДоверия());
	КонецЕсли;
	Если НЕ Удаление.МожетУдалять(Пользователь, Пакет) Тогда
		Скрытые.Добавить(КлючОпасной());
	КонецЕсли;

	Результат = Перечень.Скопировать();
	Для Каждого Ключ Из Скрытые Цикл
		Результат.Удалить(Сборка.РазделПеречня(Результат, Ключ));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КлючДоверия()
	Возврат "ci";
КонецФункции

// Раздел перечня дома.
Процедура Раздел(Знач КлючРаздела, Знач Подпись, Знач Иконка)
	Сборка.Раздел(Перечень, КлючРаздела, Подпись, Иконка);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СборкаДомаНастроек") _Сборка,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "СервисДоверияCI") _СервисДоверия,
	&Пластилин(Значение = "ПультУдаленияПакета") _Удаление,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы) Экспорт

	Сборка = _Сборка;
	ДомПула = _ДомПула;
	СервисДоверия = _СервисДоверия;
	Удаление = _Удаление;
	Тексты = _Тексты;
	Страницы = _Страницы;

	// без рубрик: разделов шесть, порядок — от карточки к публикации и оповещениям
	Перечень = Сборка.ПереченьРазделов();
	Раздел(КлючКарточки(), Тексты.Текст("settings.package.nav.card"), "пакет");
	Раздел("tags", Тексты.Текст("settings.package.nav.tags"), "тег");
	Раздел("versions", Тексты.Текст("settings.package.nav.versions"), "закладка");
	Раздел("access", Тексты.Текст("settings.package.nav.access"), "замок");
	Раздел(КлючДоверия(), Тексты.Текст("settings.package.nav.ci"), "подпись");
	Раздел("webhooks", Тексты.Текст("settings.package.nav.webhooks"), "стрелка");
	Сборка.ОпасныйРаздел(Перечень, КлючОпасной(), Тексты.Текст("settings.package.nav.danger"), "предупреждение");

КонецПроцедуры
