// Пометки пакета в каталоге — «устарел» и «скрыт»: у каждой свой хвост адреса формы от раздела
// «Карточка», своё поле тумблера и своё свойство карточки.

Перем Устарел_; // Структура - пометка «устарел» (см. Устарел)
Перем Скрыт_;   // Структура - пометка «скрыт» (см. Скрыт)

#Область ПубличныйИнтерфейс

// Пометка «устарел»: пакет доступен, но помечен устаревшим.
//
// Возвращаемое значение:
//  Структура - пометка:
//    * Хвост - Строка - хвост адреса формы от адреса раздела «Карточка»;
//    * Поле - Строка - имя поля тумблера.
//
Функция Устарел() Экспорт
	Возврат Устарел_;
КонецФункции

// Пометка «скрыт»: пакета нет в каталоге и поиске.
//
// Возвращаемое значение:
//  Структура - пометка (см. Устарел).
//
Функция Скрыт() Экспорт
	Возврат Скрыт_;
КонецФункции

// Пометка по хвосту адреса формы.
//
// Параметры:
//  Хвост - Строка - хвост адреса из маршрута.
//
// Возвращаемое значение:
//  Структура, Неопределено - пометка (см. Устарел); Неопределено — такой пометки нет.
//
Функция ПоХвосту(Знач Хвост) Экспорт

	Если Хвост = Устарел_.Хвост Тогда
		Возврат Устарел_;
	ИначеЕсли Хвост = Скрыт_.Хвост Тогда
		Возврат Скрыт_;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Свойства карточки, которые пометка ставит или снимает.
//
// Параметры:
//  Пометка - Структура - пометка (см. Устарел).
//  Включено - Булево - состояние тумблера.
//
// Возвращаемое значение:
//  Структура - поля карточки, как у СервисПакетов.ОбновитьМетаданные.
//
Функция СвойстваКарточки(Знач Пометка, Знач Включено) Экспорт

	Результат = Новый Структура();
	Если Пометка = Устарел_ Тогда
		Результат.Вставить("Устарел", Включено);
	ИначеЕсли Пометка = Скрыт_ Тогда
		Результат.Вставить("Скрыт", Включено);
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

Функция Пометка(Знач Хвост, Знач Поле)
	Возврат Новый Структура("Хвост, Поле", Хвост, Поле);
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт

	Устарел_ = Пометка("deprecated", "устарел");
	Скрыт_ = Пометка("hidden", "скрыт");

КонецПроцедуры
