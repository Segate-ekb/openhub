// Тип репозитория доверенного конвейера на экране: выбранный тип, подпись, адрес значка
// и уточнение об издателе.

Перем СервисДоверия;  // СервисДоверияCI (публикация) — словарь провайдеров
Перем Стража;         // СтражИздателейCI (публикация) — издатель по умолчанию у типа
Перем Активы;         // АдресаСтатики — адреса значков провайдеров
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Тип репозитория, поля которого показывает форма: значение вне словаря сводится
// к первому типу, а не роняет экран.
//
// Параметры:
//  Значение - Строка, Неопределено - тип репозитория из адреса либо формы.
//
// Возвращаемое значение:
//  Строка - ключ типа репозитория из словаря.
//
Функция Нормализовать(Знач Значение) Экспорт

	Норм = НРег(СокрЛП(Строка(?(Значение = Неопределено, "", Значение))));
	Если СервисДоверия.ДопустимыеПровайдеры().Найти(Норм) <> Неопределено Тогда
		Возврат Норм;
	КонецЕсли;
	Возврат СервисДоверия.ДопустимыеПровайдеры()[0];

КонецФункции

// Подпись типа репозитория. Ключи подписей перечислены литералами: сверка ключей кода
// и словаря вычисленного ключа не видит.
//
// Параметры:
//  Ключ - Строка - ключ типа репозитория.
//
// Возвращаемое значение:
//  Строка - подпись для человека.
//
Функция Подпись(Знач Ключ) Экспорт

	Если Ключ = СервисДоверия.ПровайдерGitLab() Тогда
		Возврат Тексты.Текст("settings.package.ci-new.provider.gitlab");
	КонецЕсли;
	Возврат Тексты.Текст("settings.package.ci-new.provider.github");

КонецФункции

// Адрес значка типа репозитория из закрытого списка активов; провайдер вне словаря значка
// не получает.
//
// Параметры:
//  Провайдер - Строка, Неопределено - тип репозитория записи.
//
// Возвращаемое значение:
//  Строка - адрес значка; "" — значка нет.
//
Функция АдресЗначка(Знач Провайдер) Экспорт

	Ключ = Ключ(Провайдер);
	Если СервисДоверия.ДопустимыеПровайдеры().Найти(Ключ) = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Активы.АдресЗначка(Ключ);

КонецФункции

// Имя типа репозитория записи: подпись известного типа, а провайдер вне словаря остаётся своим
// ключом — знание о нём терять нельзя.
//
// Параметры:
//  Провайдер - Строка, Неопределено - тип репозитория записи.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяТипа(Знач Провайдер) Экспорт

	Ключ = Ключ(Провайдер);
	Если СервисДоверия.ДопустимыеПровайдеры().Найти(Ключ) = Неопределено Тогда
		Возврат Ключ;
	КонецЕсли;
	Возврат Подпись(Ключ);

КонецФункции

// Издатель виден ТОЛЬКО там, где он не выводится из типа репозитория: у github.com и
// gitlab.com он один и на экране не сообщает ничего, а на инсталляции из настройки хаба
// без него две записи стали бы неотличимы — репозитории у них называются одинаково.
//
// Параметры:
//  Провайдер - Строка - тип репозитория записи.
//  Издатель - Строка, Неопределено - издатель записи.
//
// Возвращаемое значение:
//  Строка - «издатель …»; "" — издатель выводится из типа репозитория и на экране не появляется.
//
Функция УточнениеИздателя(Знач Провайдер, Знач Издатель) Экспорт

	Значение = СокрЛП(Строка(?(Издатель = Неопределено, "", Издатель)));
	Если НЕ ЗначениеЗаполнено(Значение)
		ИЛИ Стража.Нормализовать(Значение) = Стража.ИздательПоУмолчанию(Провайдер) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Тексты.Шаблон("settings.package.ci.issuer", Значение);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Ключ(Знач Провайдер)
	Возврат НРег(СокрЛП(Строка(?(Провайдер = Неопределено, "", Провайдер))));
КонецФункции

#КонецОбласти

&Прозвище("ПредставлениеПровайдераCI")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисДоверияCI") _СервисДоверия,
	&Пластилин(Значение = "СтражИздателейCI") _Стража,
	&Пластилин(Значение = "АдресаСтатики") _Активы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	СервисДоверия = _СервисДоверия;
	Стража = _Стража;
	Активы = _Активы;
	Тексты = _Тексты;

КонецПроцедуры
