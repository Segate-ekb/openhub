// Раздел «Теги» дома «Пакет»: таблица каналов пакета — своих и унаследованных от пула, с тем,
// откуда каждый, — с меню ⚙ в строке; окно нового тега и визард «Каналы по умолчанию» —
// на странице, окна правки, удаления и возврата тега пула — по адресу.

Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем СервисТегов;   // СервисТегов (реестр) — каналы пакета и правила тегов
Перем Происхождения; // ПроисхождениеТега (реестр) — свой тег, от пула, копия или выключен
Перем СервисПрав;    // СервисПрав (права) — правит ли смотрящий теги пула
Перем ДомПула;       // ДомПула — адрес раздела тегов пула
Перем Конструкторы;  // КонструкторТега — состояние окна по тегу пакета
Перем Окна;          // ОкноРаздела — окно по адресу и его состояние
Перем ОкноТега;      // ОкноТега — окна «Новый тег» и «Изменить»
Перем ОкноКаналов;   // ОкноКаналовПоУмолчанию — визард трёх каналов
Перем Поля;          // ПоляТега — имена полей
Перем Плашки;        // ПлашкаТега — плашка тега в его оформлении
Перем Ссылки;        // ПараметрыСсылки (основа) — адреса проверки до отправки
Перем Тексты;        // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<тег>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат "новый,изменить,удалить,вернуть,каналы";
КонецФункции

// Секция раздела «Теги» дома «Пакет».
//
// Параметры:
//  Параметры - Структура:
//    * Пул - Пул - пул пакета;
//    * Пакет - Пакет - пакет раздела;
//    * Адрес - Строка - адрес раздела;
//    * Пользователь - Пользователь, Неопределено - смотрящий;
//    * Окно - Структура, Неопределено - состояние открытого окна (см. ОкноРаздела.Отбитое);
//    * Предпросмотр - Структура, Неопределено - состав канала из пробы правила в окне.
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - одна секция: таблица каналов и окна.
//
Функция Секции(Знач Параметры) Экспорт

	// каналы с отдаваемыми версиями — одним проходом, без запроса на каждый тег
	Раскладка = СервисТегов.КаналыПакета(Параметры.Пакет.Идентификатор);
	БезКаналов = Раскладка.Каналы.Количество() = 0;
	АдресТеговПула = ?(СервисПрав.МожетАдминистрировать(Параметры.Пользователь, Параметры.Пул),
		ДомПула.АдресРаздела(Параметры.Пул.Имя, "tags"), "");

	ОкноНового = ОкноЗаведения(Параметры);
	Визард = ОкноВизарда(Параметры, БезКаналов);

	Секция = Кит.Секция(Тексты.Текст("settings.package.tags.title"),
			ТаблицаКаналов(Раскладка, Параметры, АдресТеговПула),
			ОкноНового,
			Визард,
			ОткрытоеОкно(Параметры))
		.Лид(Тексты.Текст("settings.package.tags.lead")).Иконка("тег")
		.Действия(
			Кит.Кнопка(Тексты.Текст("settings.tags.button.new")).Основная().Иконка("плюс").Открывает(ОкноНового),
			КнопкаВизарда(Визард));

	Результат = Новый Массив();
	Результат.Добавить(Секция);
	Возврат Результат;

КонецФункции

// Напечатает ли раздел окно, которое называет состояние: заведение — всегда; визард — пакету
// без каналов; правка — любому действующему тегу; удаление — своему; возврат — копии тега пула.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Состояние - Структура, Неопределено - состояние окна раздела.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Пакет, Знач Состояние) Экспорт

	Если Состояние = Неопределено Тогда
		Возврат Ложь;
	ИначеЕсли Окна.Открыто(Состояние, "новый") Тогда
		Возврат Истина;
	ИначеЕсли Окна.Открыто(Состояние, "каналы") Тогда
		Возврат СервисТегов.КаналыПакета(Пакет.Идентификатор).Каналы.Количество() = 0;
	КонецЕсли;
	Возврат ВидОкнаТега(Пакет, Состояние) <> "";

КонецФункции

#КонецОбласти

#Область ТаблицаКаналов

// Выключенные у пакета теги пула стоят в той же таблице последними: их возвращают отсюда же.
Функция ТаблицаКаналов(Знач Раскладка, Знач Параметры, Знач АдресТеговПула)

	Строки = Новый Массив();
	Для Каждого Канал Из Раскладка.Каналы Цикл
		Строки.Добавить(СтрокаКанала(Канал.Тег, Раскладка.Происхождение.Получить(Строка(Канал.Тег.Имя)),
			Канал.Отдаваемая, Параметры, АдресТеговПула));
	КонецЦикла;
	Для Каждого Тег Из Раскладка.Выключенные Цикл
		Строки.Добавить(СтрокаКанала(Тег, Происхождения.Выключен(), Неопределено, Параметры, АдресТеговПула));
	КонецЦикла;

	Таблица = Кит.Таблица(Строки).Вид("карточками").Пустое("—")
		.Пусто(Тексты.Текст("settings.package.tags.empty"));
	Таблица.Колонка("tag", Тексты.Текст("settings.package.tags.col.tag")).Заглавная();
	Таблица.Колонка("origin", Тексты.Текст("settings.package.tags.col.origin"));
	Таблица.Колонка("rule", Тексты.Текст("settings.package.tags.col.rule"));
	Таблица.Колонка("serves", Тексты.Текст("settings.package.tags.col.version"));
	Таблица.Колонка("actions", "").БезПодписиВЗаписи();
	Возврат Таблица;

КонецФункции

Функция СтрокаКанала(Знач Тег, Знач Происхождение, Знач Отдаваемая, Знач Параметры, Знач АдресТеговПула)

	Возврат Новый Структура("tag, origin, rule, serves, actions",
		ПлашкаКанала(Тег),
		ПлашкаПроисхождения(Происхождение, Параметры.Пул, АдресТеговПула),
		ПравилоКанала(Тег),
		?(Отдаваемая = Неопределено, Неопределено, Строка(Отдаваемая.Версия)),
		МенюКанала(Тег, Происхождение, Параметры.Адрес, АдресТеговПула));

КонецФункции

// Пометка основного едет вместе с тегом (Плашки.Канал); разрешённое переиздание — редкое
// и опасное состояние, поэтому отмечается оно, а не запрет.
Функция ПлашкаКанала(Знач Тег)

	Возврат Кит.Холст(Плашки.Канал(Тег),
		Кит.Плашка(Тексты.Текст("settings.tags.badge.repush")).Вид("warn")
			.Когда(СервисТегов.ЗапретСнят(Тег)));

КонецФункции

// Тег пула ведёт туда, где его правят, — тому, кто вправе править теги пула.
Функция ПлашкаПроисхождения(Знач Происхождение, Знач Пул, Знач АдресТеговПула)

	Если Происхождение = Происхождения.ОтПула() Тогда
		Плашка = Кит.Плашка(Тексты.Шаблон("settings.package.tags.origin.pool", Пул.Имя)).Вид("accent");
	ИначеЕсли Происхождение = Происхождения.Перекрывает() Тогда
		Плашка = Кит.Плашка(Тексты.Шаблон("settings.package.tags.origin.override", Пул.Имя)).Вид("warn");
	ИначеЕсли Происхождение = Происхождения.Выключен() Тогда
		Возврат Кит.Плашка(Тексты.Текст("settings.package.tags.origin.disabled")).Вид("err");
	Иначе
		Возврат Кит.Плашка(Тексты.Текст("settings.package.tags.origin.own"));
	КонецЕсли;

	Если ЗначениеЗаполнено(АдресТеговПула) Тогда
		Плашка.Адрес(АдресТеговПула);
	КонецЕсли;
	Возврат Плашка;

КонецФункции

// Правило, ничем не ограниченное с краёв, сопровождается предупреждением домена.
Функция ПравилоКанала(Знач Тег)

	Правило = СервисТегов.ПравилоИзТега(Тег);
	Если Правило = Неопределено Тогда
		Возврат Тексты.Текст("settings.tags.rule.manual");
	КонецЕсли;

	Возврат Кит.Холст(ОкноТега.ПравилоКоротко(Правило.Выражение),
		Кит.Плашка(Тексты.Текст("settings.tags.rule.unbounded")).Вид("warn")
			.Подсказка(Правило.Предупреждение()).Когда(ЗначениеЗаполнено(Правило.Предупреждение())));

КонецФункции

#КонецОбласти

#Область ДействияСтроки

// Правка тега пула заводит копию, возврат снимает копию, выключенный тег только включается.
Функция МенюКанала(Знач Тег, Знач Происхождение, Знач АдресРаздела, Знач АдресТеговПула)

	Имя = Строка(Тег.Имя);
	Меню = Кит.Меню(Тексты.Шаблон("settings.package.tags.menu.title", Имя));

	Если Происхождение = Происхождения.Выключен() Тогда
		Меню.Добавить(ФормаТега(Имя, "enable", Тексты.Текст("settings.package.tags.button.enable"), "галочка"));
		Возврат Меню;
	КонецЕсли;

	ОтПула = Происхождение = Происхождения.ОтПула();
	Меню.Добавить(Кит.ОкноПоАдресу(Окна.Адрес(АдресРаздела, "изменить", Имя),
		?(ОтПула, Тексты.Текст("settings.package.tags.button.edit.copy"),
			Тексты.Текст("settings.tags.button.edit"))).Иконка("карандаш"));

	Если Происхождение = Происхождения.Перекрывает() Тогда
		Меню.Добавить(Кит.ОкноПоАдресу(Окна.Адрес(АдресРаздела, "вернуть", Имя),
			Тексты.Текст("settings.package.tags.button.restore")).Иконка("история"));
	КонецЕсли;
	Если ОтПула ИЛИ Происхождение = Происхождения.Перекрывает() Тогда
		Меню.Добавить(ФормаТега(Имя, "disable", Тексты.Текст("settings.package.tags.button.disable"), "стоп"));
		Если ЗначениеЗаполнено(АдресТеговПула) Тогда
			Меню.Добавить(Кит.ПунктМеню(Тексты.Текст("settings.package.tags.button.pool"),
				Окна.Адрес(АдресТеговПула, "изменить", Имя)).Иконка("шестерёнка"));
		КонецЕсли;
	Иначе
		Меню.Добавить(Кит.ОкноПоАдресу(Окна.Адрес(АдресРаздела, "удалить", Имя),
			Тексты.Текст("settings.tags.button.remove")).Опасная().Иконка("корзина"));
	КонецЕсли;

	Возврат Меню;

КонецФункции

// Обратимое действие без подтверждения: форма из одной кнопки на адресе тега.
Функция ФормаТега(Знач ИмяТега, Знач Действие, Знач Подпись, Знач Иконка)
	Возврат Кит.Форма(Хвост(ИмяТега, Действие), Кит.Кнопка(Подпись).Вторичная().Иконка(Иконка)).Вид("меню");
КонецФункции

// Визард предлагается только пакету без каналов: там, где мейнтейнер вёл их сам, он — шум.
Функция КнопкаВизарда(Знач Визард)

	Если Визард = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Кнопка(Тексты.Текст("settings.package.tags.wizard.button")).Вторичная().Иконка("тег")
		.Открывает(Визард);

КонецФункции

#КонецОбласти

#Область Окна

Функция ОкноЗаведения(Знач Параметры)

	Опции = ОпцииОкна(Параметры);
	Опции.Заголовок = Тексты.Текст("settings.package.tag-new.title");
	Опции.Лид = Тексты.Текст("settings.package.tag-new.lead");
	Опции.Кнопка = Тексты.Текст("settings.tags.button.create");
	Опции.Якорь = "teg-paketa-novyi";
	Опции.АдресОкна = Окна.Адрес(Параметры.Адрес, "новый");
	Возврат ОкноТега.Заведение(Конструкторы.ДляТегаПакета(Параметры.Пакет.Идентификатор, ""),
		Параметры.Окно, Опции);

КонецФункции

// Визард печатается только пакету без каналов; отказ прежней отправки — в нём же.
Функция ОкноВизарда(Знач Параметры, Знач БезКаналов)

	Если НЕ БезКаналов Тогда
		Возврат Неопределено;
	КонецЕсли;
	Открыто = Окна.Открыто(Параметры.Окно, "каналы");
	Возврат ОкноКаналов.Окно(Окна.Адрес(Параметры.Адрес, "каналы"), Параметры.Адрес, Открыто,
		?(Открыто, Окна.Ошибка(Параметры.Окно), ""));

КонецФункции

// Окно тега, названное адресом. Тега с таким именем нет либо окно ему не положено — без окна.
Функция ОткрытоеОкно(Знач Параметры)

	Состояние = Параметры.Окно;
	Вид = ВидОкнаТега(Параметры.Пакет, Состояние);
	Если Вид = "изменить" Тогда
		Возврат ОкноПравки(Параметры);
	ИначеЕсли Вид = "удалить" Тогда
		Возврат ОкноУдаления(Параметры.Пакет, Состояние, Параметры.Адрес);
	ИначеЕсли Вид = "вернуть" Тогда
		Возврат ОкноВозврата(Параметры.Пул, Состояние, Параметры.Адрес);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Правка тега пула заводит у пакета копию: окно говорит об этом в лиде. Состав канала виден
// сразу — по действующему правилу, а после пробы — по набранному.
Функция ОкноПравки(Знач Параметры)

	Пакет = Параметры.Пакет;
	Исходное = Конструкторы.ДляТегаПакета(Пакет.Идентификатор, Параметры.Окно.Ключ);
	ОтПула = СервисТегов.ПроисхождениеТега(Пакет.Идентификатор, Исходное.Имя) = Происхождения.ОтПула();

	Опции = ОпцииОкна(Параметры);
	Опции.Заголовок = Тексты.Шаблон("settings.package.tag-new.edit.title", Исходное.Имя);
	Опции.Лид = ?(ОтПула, Тексты.Шаблон("settings.package.tag-new.edit.lead.copy", Параметры.Пул.Имя),
		Тексты.Текст("settings.package.tag-new.edit.lead"));
	Опции.Кнопка = Тексты.Текст("settings.tags.button.save");
	Опции.Якорь = "teg-paketa-pravka";
	Опции.Хвост = Хвост(Исходное.Имя, "save");
	Если Опции.Предпросмотр = Неопределено И НЕ Конструкторы.ЭтоРучной(Исходное) Тогда
		Опции.Предпросмотр = ДействующийСостав(Пакет, Исходное);
	КонецЕсли;
	Возврат ОкноТега.Правка(Исходное, Параметры.Окно, Опции);

КонецФункции

// Свой тег удаляется с эхом имени: версии остаются, «пакет@тег» перестаёт отвечать.
Функция ОкноУдаления(Знач Пакет, Знач Состояние, Знач АдресРаздела)

	Тег = СервисТегов.НайтиСвойТег(Пакет.Идентификатор, Состояние.Ключ);
	Возврат Кит.Подтверждение(Тексты.Шаблон("settings.package.tags.delete.title", Тег.Имя),
			Тексты.Шаблон("settings.package.tags.delete.consequence", Тег.Имя, Пакет.Имя))
		.Эхо(Поля.ИмяПоляЭха(), Строка(Тег.Имя), Тексты.Текст("settings.tags.delete.echo"))
		.Кнопка(Тексты.Текст("settings.tags.button.remove"))
		.Ошибка(Окна.Отказ(Состояние, Поля.ИмяПоляЭха()))
		.Форма(Хвост(Тег.Имя, "delete")).БезПерезагрузки().Якорь("teg-paketa-udalit").Открыто()
		.АдресЗакрытия(АдресРаздела);

КонецФункции

// Копия тега пула снимается без эха: пакет снова получает тег пула с его правилом.
Функция ОкноВозврата(Знач Пул, Знач Состояние, Знач АдресРаздела)

	ИмяТега = НРег(СокрЛП(Состояние.Ключ));
	Ошибка = Окна.Ошибка(Состояние);
	Возврат Кит.Подтверждение(Тексты.Шаблон("settings.package.tags.restore.title", ИмяТега),
			Тексты.Шаблон("settings.package.tags.restore.consequence", ИмяТега, Пул.Имя),
			Кит.Уведомление(Ошибка).Вид("err").Когда(ЗначениеЗаполнено(Ошибка)))
		.Кнопка(Тексты.Текст("settings.package.tags.button.restore"))
		.Форма(Хвост(ИмяТега, "delete")).БезПерезагрузки().Якорь("teg-paketa-vernut").Открыто()
		.АдресЗакрытия(АдресРаздела);

КонецФункции

Функция ОпцииОкна(Знач Параметры)

	Опции = ОкноТега.ОпцииОкна();
	Опции.Ручной = Истина;
	Опции.Проба = Истина;
	Опции.Предпросмотр = Параметры.Предпросмотр;
	Опции.АдресПроверки = Ссылки.Установить(Параметры.Адрес, "проверка", "имя");
	Опции.АдресПроверкиПравила = Ссылки.Установить(Параметры.Адрес, "проверка", "правило");
	Опции.АдресЗакрытия = Параметры.Адрес;
	Возврат Опции;

КонецФункции

// Вид окна записи, если оно ей положено: правка — любому действующему тегу, удаление — своему,
// возврат — копии тега пула; иначе "".
Функция ВидОкнаТега(Знач Пакет, Знач Состояние)

	Если Состояние = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Состояние.Ключ) Тогда
		Возврат "";
	КонецЕсли;

	Происхождение = СервисТегов.ПроисхождениеТега(Пакет.Идентификатор, Состояние.Ключ);
	Если Окна.Открыто(Состояние, "изменить") Тогда
		Подходит = ЗначениеЗаполнено(Происхождение) И Происхождение <> Происхождения.Выключен();
	ИначеЕсли Окна.Открыто(Состояние, "удалить") Тогда
		Подходит = Происхождение = Происхождения.Свой();
	ИначеЕсли Окна.Открыто(Состояние, "вернуть") Тогда
		Подходит = Происхождение = Происхождения.Перекрывает();
	Иначе
		Подходит = Ложь;
	КонецЕсли;
	Возврат ?(Подходит, Состояние.Вид, "");

КонецФункции

// Состав по действующему правилу; неприменимое правило в окне — не повод ронять страницу.
Функция ДействующийСостав(Знач Пакет, Знач Исходное)

	Попытка
		Возврат СервисТегов.ПредпросмотрПравила(Пакет.Идентификатор, Исходное.Тип, Исходное.Правило);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Адрес формы тега относительно раздела: «<тег>/<действие>».
Функция Хвост(Знач ИмяТега, Знач Действие)
	Возврат КодироватьСтроку(Строка(ИмяТега), СпособКодированияСтроки.КодировкаURL) + "/" + Действие;
КонецФункции

#КонецОбласти

&Прозвище("ВитринаТеговПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "ПроисхождениеТега") _Происхождения,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "КонструкторТега") _Конструкторы,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ОкноТега") _ОкноТега,
	&Пластилин(Значение = "ОкноКаналовПоУмолчанию") _ОкноКаналов,
	&Пластилин(Значение = "ПоляТега") _Поля,
	&Пластилин(Значение = "ПлашкаТега") _Плашки,
	&Пластилин(Значение = "ПараметрыСсылки") _Ссылки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	СервисТегов = _СервисТегов;
	Происхождения = _Происхождения;
	СервисПрав = _СервисПрав;
	ДомПула = _ДомПула;
	Конструкторы = _Конструкторы;
	Окна = _Окна;
	ОкноТега = _ОкноТега;
	ОкноКаналов = _ОкноКаналов;
	Поля = _Поля;
	Плашки = _Плашки;
	Ссылки = _Ссылки;
	Тексты = _Тексты;

КонецПроцедуры
