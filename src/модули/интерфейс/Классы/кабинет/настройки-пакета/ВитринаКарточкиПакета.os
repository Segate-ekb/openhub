// Раздел «Карточка» дома «Пакет»: поля карточки одной формой с панелью сохранения и секция
// «В каталоге» — пометки тумблерами, каждая сохраняется сразу своей формой.

Перем Кит;      // Кит (кит) — фабрика элементов экрана
Перем Тексты;   // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Пометки;  // ПометкиКаталогаПакета — хвосты адресов и поля пометок

#Область ПубличныйИнтерфейс

// Секции раздела «Карточка».
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - секции «Карточка» и «В каталоге».
//
Функция Секции(Знач Пакет) Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Карточка(Пакет));
	Результат.Добавить(ВКаталоге(Пакет));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Карточка

Функция Карточка(Знач Пакет)

	Возврат Кит.Секция(Тексты.Текст("settings.package.card.title"),
			ПолеОписания(Пакет),
			ПолеКлючевыхСлов(Пакет),
			ПолеЛицензии(Пакет),
			ПолеРепозитория(Пакет))
		.Лид(Тексты.Текст("settings.package.card.lead")).Иконка("пакет")
		.Форма();

КонецФункции

Функция ПолеОписания(Знач Пакет)
	Возврат Кит.Поле("описание", Тексты.Текст("settings.package.card.description.label"))
		.Значение(Строка(Пакет.Описание))
		.Подсказка(Тексты.Текст("settings.package.card.description.hint"));
КонецФункции

Функция ПолеКлючевыхСлов(Знач Пакет)
	Возврат Кит.Поле("ключевые_слова", Тексты.Текст("settings.package.card.keywords.label")).Список()
		.Значение(Строка(Пакет.КлючевыеСлова))
		.Подсказка(Тексты.Текст("settings.package.card.keywords.hint"));
КонецФункции

Функция ПолеЛицензии(Знач Пакет)
	Возврат Кит.Поле("лицензия", Тексты.Текст("settings.package.card.license.label"))
		.Значение(Строка(Пакет.Лицензия));
КонецФункции

Функция ПолеРепозитория(Знач Пакет)
	Возврат Кит.Поле("репозиторий", Тексты.Текст("settings.package.card.repo.label")).ТипЗначения("url")
		.Значение(Строка(Пакет.АдресРепозитория))
		.Пример(Тексты.Текст("settings.package.card.repo.placeholder"))
		.Подсказка(Тексты.Текст("settings.package.card.repo.hint"));
КонецФункции

#КонецОбласти

#Область ВКаталоге

Функция ВКаталоге(Знач Пакет)

	Возврат Кит.Секция(Тексты.Текст("settings.package.catalog.title"),
			ФормаПометки(Пометки.Устарел(), Пакет.Устарел = Истина,
				Тексты.Текст("settings.package.catalog.deprecated.label"),
				Тексты.Текст("settings.package.catalog.deprecated.hint")),
			ФормаПометки(Пометки.Скрыт(), Пакет.Скрыт = Истина,
				Тексты.Текст("settings.package.catalog.hidden.label"),
				Тексты.Текст("settings.package.catalog.hidden.hint")))
		.Лид(Тексты.Текст("settings.package.catalog.lead")).Иконка("поиск");

КонецФункции

// Тумблер отправляет форму сам; без скрипта её отправляет запасная кнопка кита рядом с тумблером.
Функция ФормаПометки(Знач Пометка, Знач Включено, Знач Метка, Знач Подсказка)

	Возврат Кит.Форма(Пометка.Хвост,
			Кит.Тумблер(Пометка.Поле, Метка).Включено(Включено).Подсказка(Подсказка)
				.Подписи(Тексты.Текст("settings.package.catalog.on"), Тексты.Текст("settings.package.catalog.off"))
				.СохранятьСразу())
		.БезПерезагрузки();

КонецФункции

#КонецОбласти

&Прозвище("ВитринаКарточкиПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПометкиКаталогаПакета") _Пометки) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	Пометки = _Пометки;

КонецПроцедуры
