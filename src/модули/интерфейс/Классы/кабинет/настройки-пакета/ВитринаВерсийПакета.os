// Раздел «Версии и метки» дома «Пакет»: таблица версий с меню ⚙ строки — отзыв и возврат формой
// из одной кнопки, «Поставить тег» окном по адресу, снятие ручного тега подтверждением по адресу.

Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем СервисВерсий;  // СервисВерсий (реестр) — версии пакета
Перем СервисТегов;   // СервисТегов (реестр) — метки версий и ручные теги
Перем Режимы;        // РежимТега (реестр) — ручной тег или правило
Перем Плашки;        // ПлашкаТега — плашка тега в его оформлении
Перем Провенанс;     // СервисПроисхождения (реестр) — версии, принятые доверенной публикацией
Перем Скачивания;    // СлужбаСтатистикиСкачиваний (статистика) — скачивания версий пакета разом
Перем ЗначкиВерсии;  // ЗначкиВерсии — ключ доверенной и плашка «отозвана»
Перем Объёмы;        // ОбъёмТекстом (основа) — размер версии человеку
Перем Окна;          // ОкноРаздела — окно по адресу и его состояние
Перем Пульт;         // ПультВерсийПакета — операции и имена полей форм
Перем Даты;          // ДатаЧеловеку — одно написание момента на весь интерфейс
Перем Тексты;        // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<ключ>: «тег-<версия>» и
// «снять-<тег>@<версия>».
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат "тег,снять";
КонецФункции

// Секция раздела: таблица версий и окно, названное адресом.
//
// Параметры:
//  Параметры - Структура:
//    * Пакет - Пакет - пакет раздела;
//    * Адрес - Строка - адрес раздела;
//    * АдресТегов - Строка - адрес раздела «Теги»: там заводят ручной тег;
//    * Окно - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.Секция.
//
Функция Секция(Знач Параметры) Экспорт

	Пакет = Параметры.Пакет;
	СписокВерсий = УпорядочитьПоУбыванию(СервисВерсий.ВерсииПакета(Пакет.Идентификатор));
	Разрез = РазрезТаблицы(Пакет, СписокВерсий, Параметры.АдресТегов);

	Возврат Кит.Секция(Тексты.Текст("settings.package.versions.title"),
			ТаблицаВерсий(СписокВерсий, Разрез, Параметры.Адрес),
			ЗначкиВерсии.Легенда(СписокВерсий, Разрез.Доверенные),
			Кит.Примечание(Тексты.Текст("settings.package.versions.note")),
			ОткрытоеОкно(СписокВерсий, Разрез, Параметры.Окно, Параметры.Адрес))
		.Лид(Тексты.Текст("settings.package.versions.lead")).Иконка("история");

КонецФункции

// Напечатает ли раздел окно, которое называет состояние: окно тега — у версии, которой есть
// какой тег поставить; подтверждение снятия — у ручного тега, что стоит на версии.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Состояние - Структура, Неопределено - состояние окна раздела.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Пакет, Знач Состояние) Экспорт

	Если Состояние = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	СписокВерсий = СервисВерсий.ВерсииПакета(Пакет.Идентификатор);
	Возврат ОткрытоеОкно(СписокВерсий, РазрезТаблицы(Пакет, СписокВерсий, ""), Состояние) <> Неопределено;

КонецФункции

#КонецОбласти

#Область Таблица

// Ответы домена, общие всем строкам, — одним разрезом на страницу: теги по версиям, ручные теги,
// доверенные версии и скачивания. Вопрос на строку дал бы N×M.
Функция РазрезТаблицы(Знач Пакет, Знач СписокВерсий, Знач АдресТегов)

	Возврат Новый Структура("ТегиВерсий, РучныеТеги, Доверенные, Скачивания, АдресТегов",
		СервисТегов.ТегиПоВерсиям(Пакет.Идентификатор, СписокВерсий),
		СервисТегов.РучныеТегиПакета(Пакет.Идентификатор),
		Провенанс.ДоверенныеВерсииПакета(Пакет.Идентификатор),
		СкачиванияВерсий(Пакет),
		АдресТегов);

КонецФункции

// На узком экране — карточки с номером версии заглавием и ⚙ в углу; состояния нет — прочерк.
Функция ТаблицаВерсий(Знач СписокВерсий, Знач Разрез, Знач АдресРаздела)

	Таблица = Кит.Таблица(Строки(СписокВерсий, Разрез, АдресРаздела)).Вид("карточками").Пустое("—")
		.Пусто(Тексты.Текст("settings.package.versions.empty"));
	Таблица.Колонка("version", Тексты.Текст("settings.package.versions.col.version")).Заглавная();
	Таблица.Колонка("state", Тексты.Текст("settings.package.versions.col.state"));
	Таблица.Колонка("published", Тексты.Текст("settings.package.versions.col.published"));
	Таблица.Колонка("downloads", Тексты.Текст("settings.package.versions.col.downloads")).Вид("число");
	Таблица.Колонка("size", Тексты.Текст("settings.package.versions.col.size")).Вид("число");
	Таблица.Колонка("tags", Тексты.Текст("settings.package.versions.col.tags"));
	Таблица.Колонка("actions", "").Вид("узкая").БезПодписиВЗаписи().Пустое("");
	Возврат Таблица;

КонецФункции

Функция Строки(Знач СписокВерсий, Знач Разрез, Знач АдресРаздела)

	Результат = Новый Массив();
	Для Каждого Версия Из СписокВерсий Цикл
		Результат.Добавить(Новый Структура("version, state, published, downloads, size, tags, actions",
			Кит.Код(Версия.Версия),
			Состояние(Версия, Разрез),
			?(ЗначениеЗаполнено(Версия.Опубликована), Даты.ТолькоДата(Версия.Опубликована), ""),
			Скачивания.СкачиванийВерсииИзРазреза(Разрез.Скачивания, Версия.Идентификатор),
			?(ЗначениеЗаполнено(Версия.Размер), Объёмы.Представление(Версия.Размер), ""),
			ТегиВерсии(Версия, Разрез),
			Меню(Версия, Разрез, АдресРаздела)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ключ доверенной и плашка «отозвана» — одним рядом; без признаков ячейка пуста.
Функция Состояние(Знач Версия, Знач Разрез)

	Доверенная = Разрез.Доверенные.Получить(Версия.Идентификатор) = Истина;
	Отозвана = ВерсияОтозвана(Версия);
	Если НЕ Доверенная И НЕ Отозвана Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Ряд("строкой",
		ЗначкиВерсии.Ключ(Доверенная),
		ЗначкиВерсии.Плашки(Новый Структура("Отозвана", Отозвана)));

КонецФункции

Функция ТегиВерсии(Знач Версия, Знач Разрез)

	Теги = ТегиНаВерсии(Версия, Разрез);
	Если Теги.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ряд = Кит.Ряд("признаки");
	Для Каждого Тег Из Теги Цикл
		Ряд.Добавить(Плашки.ПоТегу(Тег));
	КонецЦикла;
	Возврат Ряд;

КонецФункции

#КонецОбласти

#Область МенюСтроки

// Отзыв обратим и спрашивать его незачем: форма из одной кнопки несёт желаемое состояние, повтор
// отправки его не переворачивает. Тег ставит окно по адресу; снятие ручного тега — подтверждение
// по адресу. Окон на каждую строку заранее не печатают.
Функция Меню(Знач Версия, Знач Разрез, Знач АдресРаздела)

	СтрокаВерсии = Строка(Версия.Версия);
	Меню = Кит.Меню(Тексты.Шаблон("settings.package.versions.menu.title", СтрокаВерсии),
		ФормаОтзыва(Версия),
		ПунктТега(Версия, Разрез, АдресРаздела));
	Для Каждого Тег Из ТегиНаВерсии(Версия, Разрез) Цикл
		Если НЕ Режимы.ЭтоПравило(Тег.Режим) Тогда
			Меню.Добавить(ПунктСнятия(Тег, СтрокаВерсии, АдресРаздела));
		КонецЕсли;
	КонецЦикла;
	Возврат Меню;

КонецФункции

Функция ФормаОтзыва(Знач Версия)

	Снята = ВерсияОтозвана(Версия);
	Возврат Кит.Форма("",
			Кит.СкрытоеПоле(Пульт.ИмяПоляОперации(), ?(Снята, Пульт.ОперацияВозврата(), Пульт.ОперацияОтзыва())),
			Кит.СкрытоеПоле(Пульт.ИмяПоляВерсии(), Версия.Версия),
			Кит.Кнопка(?(Снята, Тексты.Текст("settings.package.versions.button.unyank"),
				Тексты.Текст("settings.package.versions.button.yank"))).Иконка(?(Снята, "вверх", "вниз")))
		.Вид("меню").БезПерезагрузки();

КонецФункции

Функция ПунктСнятия(Знач Тег, Знач СтрокаВерсии, Знач АдресРаздела)
	Ключ = Пульт.КлючСнятия(Тег.Имя, СтрокаВерсии);
	Возврат Кит.ОкноПоАдресу(Окна.Адрес(АдресРаздела, "снять", Ключ),
		Тексты.Шаблон("settings.package.versions.menu.unset", Строка(Тег.Имя))).Опасная().Иконка("закрыть");
КонецФункции

// Ручных тегов у пакета нет — пункт ведёт туда, где их заводят; все уже стоят — пункта нет.
Функция ПунктТега(Знач Версия, Знач Разрез, Знач АдресРаздела)

	Если Разрез.РучныеТеги.Количество() = 0 Тогда
		Возврат Кит.ПунктМеню(Тексты.Текст("settings.package.versions.menu.tag.create"), Разрез.АдресТегов)
			.Иконка("тег");
	КонецЕсли;
	Если СвободныеТеги(Версия, Разрез).Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.ОкноПоАдресу(Окна.Адрес(АдресРаздела, "тег", Строка(Версия.Версия)),
		Тексты.Текст("settings.package.versions.menu.tag")).Иконка("тег");

КонецФункции

#КонецОбласти

#Область ОкнаПоАдресу

// Окно, названное адресом. Версии или тега нет либо действие им не положено — страница без окна.
Функция ОткрытоеОкно(Знач СписокВерсий, Знач Разрез, Знач Состояние, Знач Адрес = "")

	Если Окна.Открыто(Состояние, "тег") Тогда
		Версия = НайтиВерсию(СписокВерсий, Состояние.Ключ);
		Если Версия = Неопределено ИЛИ СвободныеТеги(Версия, Разрез).Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ОкноТега(Версия, СвободныеТеги(Версия, Разрез), Состояние, Адрес);
	КонецЕсли;

	Если Окна.Открыто(Состояние, "снять") Тогда
		Позиция = СтрНайти(Состояние.Ключ, "@");
		Если Позиция = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Версия = НайтиВерсию(СписокВерсий, Сред(Состояние.Ключ, Позиция + 1));
		Тег = ?(Версия = Неопределено, Неопределено,
			РучнойТегНаВерсии(Версия, Разрез, Лев(Состояние.Ключ, Позиция - 1)));
		Если Тег = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ОкноСнятия(Версия, Тег, Состояние, Адрес);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Выбор только из ручных тегов, которых на версии ещё нет: тег-правило метку не принимает.
Функция ОкноТега(Знач Версия, Знач Теги, Знач Состояние, Знач Адрес)

	Якорь = "versiya-teg";
	ИмяПоля = Пульт.ИмяПоляТега();
	Выбор = Кит.Поле(ИмяПоля, Тексты.Текст("settings.package.versions.menu.tag.label"))
		.Значение(Окна.Значение(Состояние, ИмяПоля))
		.Ошибка(Окна.Отказ(Состояние, ИмяПоля));
	Для Каждого Тег Из Теги Цикл
		Выбор.Вариант(Строка(Тег.Имя), Строка(Тег.Имя));
	КонецЦикла;

	Возврат Кит.Окно(Тексты.Шаблон("settings.package.versions.tag.title", Строка(Версия.Версия)),
			ОшибкаОкна(Состояние),
			Кит.СкрытоеПоле(Пульт.ИмяПоляОперации(), Пульт.ОперацияТега()),
			Кит.СкрытоеПоле(Пульт.ИмяПоляВерсии(), Версия.Версия),
			Выбор)
		.Лид(Тексты.Текст("settings.package.versions.tag.lead"))
		.Форма("").БезПерезагрузки().Якорь(Якорь).Открыто().АдресЗакрытия(Адрес)
		.Действия(Кит.Кнопка(Тексты.Текст("settings.package.versions.menu.tag.add")).Основная().Иконка("тег"));

КонецФункции

// Снятие обратимо — эха нет: окно называет тег и версию, кнопка шлёт confirmed=1.
Функция ОкноСнятия(Знач Версия, Знач Тег, Знач Состояние, Знач Адрес)

	Возврат Кит.Подтверждение(
			Тексты.Шаблон("settings.package.versions.unset.title", Строка(Тег.Имя), Строка(Версия.Версия)),
			Тексты.Шаблон("settings.package.versions.unset.consequence", Строка(Тег.Имя)),
			ОшибкаОкна(Состояние),
			Кит.СкрытоеПоле(Пульт.ИмяПоляОперации(), Пульт.ОперацияСнятия()),
			Кит.СкрытоеПоле(Пульт.ИмяПоляВерсии(), Версия.Версия),
			Кит.СкрытоеПоле(Пульт.ИмяПоляТега(), Тег.Имя))
		.Кнопка(Тексты.Текст("settings.package.versions.unset.button"))
		.Форма("").БезПерезагрузки().Якорь("versiya-snyat").Открыто().АдресЗакрытия(Адрес);

КонецФункции

Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТегиНаВерсии(Знач Версия, Знач Разрез)
	Теги = Разрез.ТегиВерсий.Получить(Версия.Идентификатор);
	Возврат ?(Теги = Неопределено, Новый Массив(), Теги);
КонецФункции

Функция СвободныеТеги(Знач Версия, Знач Разрез)

	Стоят = Новый Соответствие();
	Для Каждого Тег Из ТегиНаВерсии(Версия, Разрез) Цикл
		Стоят.Вставить(Строка(Тег.Имя), Истина);
	КонецЦикла;

	Результат = Новый Массив();
	Для Каждого Тег Из Разрез.РучныеТеги Цикл
		Если Стоят.Получить(Строка(Тег.Имя)) <> Истина Тогда
			Результат.Добавить(Тег);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РучнойТегНаВерсии(Знач Версия, Знач Разрез, Знач ИмяТега)

	Для Каждого Тег Из ТегиНаВерсии(Версия, Разрез) Цикл
		Если НРег(Строка(Тег.Имя)) = НРег(ИмяТега) И НЕ Режимы.ЭтоПравило(Тег.Режим) Тогда
			Возврат Тег;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция НайтиВерсию(Знач СписокВерсий, Знач СтрокаВерсии)

	Для Каждого Версия Из СписокВерсий Цикл
		Если Строка(Версия.Версия) = СтрокаВерсии Тогда
			Возврат Версия;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Таблица версий не падает из-за сбоя статистики: как и страница пакета, показывает ноль.
Функция СкачиванияВерсий(Знач Пакет)
	Попытка
		Возврат Скачивания.СкачиванияВерсийПакета(Пакет.Идентификатор);
	Исключение
		Возврат Новый Соответствие();
	КонецПопытки;
КонецФункции

Функция ВерсияОтозвана(Знач Версия)
	Возврат Версия.Отозвана = Истина;
КонецФункции

// Сортировка версий по убыванию semver-компонент (новые сверху).
Функция УпорядочитьПоУбыванию(Знач СписокВерсий)

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("major", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("minor", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("patch", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("item");
	Для Каждого Элемент Из СписокВерсий Цикл
		СтрокаСортировки = Таблица.Добавить();
		СтрокаСортировки.major = Элемент.SemverМажор;
		СтрокаСортировки.minor = Элемент.SemverМинор;
		СтрокаСортировки.patch = Элемент.SemverПатч;
		СтрокаСортировки.item = Элемент;
	КонецЦикла;
	Таблица.Сортировать("major Убыв, minor Убыв, patch Убыв");

	Результат = Новый Массив();
	Для Каждого СтрокаСортировки Из Таблица Цикл
		Результат.Добавить(СтрокаСортировки.item);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаВерсийПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "РежимТега") _Режимы,
	&Пластилин(Значение = "ПлашкаТега") _Плашки,
	&Пластилин(Значение = "СервисПроисхождения") _Провенанс,
	&Пластилин(Значение = "СлужбаСтатистикиСкачиваний") _Скачивания,
	&Пластилин(Значение = "ЗначкиВерсии") _ЗначкиВерсии,
	&Пластилин(Значение = "ОбъёмТекстом") _Объёмы,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ПультВерсийПакета") _Пульт,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено) Экспорт

	Кит = _Кит;
	СервисВерсий = _СервисВерсий;
	СервисТегов = _СервисТегов;
	Режимы = _Режимы;
	Плашки = _Плашки;
	Провенанс = _Провенанс;
	Скачивания = _Скачивания;
	ЗначкиВерсии = _ЗначкиВерсии;
	Объёмы = _Объёмы;
	Окна = _Окна;
	Пульт = _Пульт;
	Тексты = _Тексты;
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);

КонецПроцедуры
