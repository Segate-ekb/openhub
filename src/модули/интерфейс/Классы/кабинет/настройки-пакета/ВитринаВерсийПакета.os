// Раздел «Версии» дома «Пакет»: таблица версий с тегами и действиями, шаг подтверждения
// снятия метки.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем СервисВерсий;      // СервисВерсий (реестр) — версии пакета
Перем СервисТегов;       // СервисТегов (реестр) — метки версий и ручные теги
Перем Режимы;            // РежимТега (реестр) — единственный словарь режимов
Перем Плашки;            // ПлашкаТега — плашка тега в его оформлении
Перем Пульт;             // ПультВерсийПакета — значение подтверждения снятия
Перем Провенанс;         // СервисПроисхождения (реестр) — как принята версия
Перем ЗначкиВерсии;      // ЗначкиВерсии — значки состояния версии
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Бланки;            // БланкРаздела — адрес и токен раздела, формы на них
Перем Даты;  // ДатаЧеловеку — одно написание момента на весь интерфейс
Перем Примечания;  // ПримечанияЭкрана — вид «показывать нечего»

#Область ПубличныйИнтерфейс

// Секция версий: отзыв/восстановление и навешивание тега у самой версии.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Бланк - Структура - бланк раздела (БланкРаздела): адрес форм строк и токен сессии.
//  АдресКонструктора - Строка - адрес раздела тегов: там заводят ручной тег.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция Секция(Знач Пакет, Знач Бланк, Знач АдресКонструктора) Экспорт

	СписокВерсий = УпорядочитьПоУбыванию(СервисВерсий.ВерсииПакета(Пакет.Идентификатор));
	Раскладка = РаскладкаТаблицы(Пакет, АдресКонструктора);

	История = Кит.Холст();
	История.Добавить(ТаблицаВерсий(СписокВерсий, Бланк, Раскладка));
	История.Добавить(ЗначкиВерсии.Легенда(СписокВерсий, Раскладка.Доверенные));
	История.Добавить(Кит.Примечание(Тексты.Текст("settings.package.versions.note")));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.package.versions.title"),
		Тексты.Текст("settings.package.versions.lead"), История.Рендер());
	Секция.Иконка = "история";
	Возврат Секция;

КонецФункции

// Шаг подтверждения снятия тега: та же страница, отдельной секцией-формой над таблицей.
// Тяжёлой «опасной зоны» с вводом имени здесь нет — снятие обратимо.
//
// Параметры:
//  Бланк - Структура - бланк раздела (БланкРаздела): адрес формы и токен сессии.
//  Снятие - Структура - Тег и Версия, снятие метки с которой ждёт подтверждения.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция СекцияПодтвержденияСнятия(Знач Бланк, Знач Снятие) Экспорт

	Вопрос = Кит.Холст();
	Вопрос.Добавить(Кит.СкрытоеПоле("операция", "тег_снять"));
	Вопрос.Добавить(Кит.СкрытоеПоле("версия", Снятие.Версия));
	Вопрос.Добавить(Кит.СкрытоеПоле("имя", Снятие.Тег));
	Вопрос.Добавить(Кит.СкрытоеПоле("подтверждение", Пульт.ЗначениеПодтверждения()));
	Вопрос.Добавить(ВопросОСнятии(Снятие));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.package.versions.unset.title"),
		Тексты.Текст("settings.package.versions.unset.lead"), Вопрос.Рендер());
	Секция.Иконка = "тег";
	Секция.Действие = Бланки.Адрес(Бланк);
	Секция.Токен = Бланк.Токен;
	Секция.Кнопка = Тексты.Текст("settings.package.versions.unset.button");
	// «Отмена» — обычная ссылка на тот же раздел: возврат ничего не меняет
	Секция.АдресОтмены = Бланки.Адрес(Бланк);
	Возврат Секция;

КонецФункции

// И тег, и версия — машинные значения, поэтому в вопросе они стоят местами шаблона.
Функция ВопросОСнятии(Знач Снятие)

	Примечание = Кит.Примечание();
	Фраза = Примечание.Добавить(Кит.Шаблон(Тексты.Текст("settings.package.versions.unset.note")));
	Фраза.Добавить(Кит.Код(Снятие.Тег));
	Фраза.Добавить(Кит.Код(Снятие.Версия));
	Возврат Примечание;

КонецФункции

#КонецОбласти

#Область ТаблицаВерсий

// Вид «карточками»: на узком экране шестерёнка строки видна в каждой карточке.
Функция ТаблицаВерсий(Знач СписокВерсий, Знач Бланк, Знач Раскладка)

	Таблица = Кит.Таблица("карточками");
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.versions.col.version")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.versions.col.state")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.versions.col.published")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.versions.col.tags")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.versions.col.action")));

	Для Каждого Версия Из СписокВерсий Цикл
		Таблица.Добавить(ЗаписьВерсии(Версия, Бланк, Раскладка));
	КонецЦикла;

	Таблица.Пусто().Добавить(
		Примечания.Пусто(Тексты.Текст("settings.package.versions.empty")));
	Возврат Таблица;

КонецФункции

// Ответы домена, одинаковые для всех строк: перебор тегов на строку дал бы N×M.
Функция РаскладкаТаблицы(Знач Пакет, Знач АдресКонструктора)

	Возврат Новый Структура("ТегиВерсий, РучныеТеги, Доверенные, АдресКонструктора",
		СервисТегов.ТегиПоВерсиям(Пакет.Идентификатор),
		СервисТегов.РучныеТегиПакета(Пакет.Идентификатор),
		Провенанс.ДоверенныеВерсииПакета(Пакет.Идентификатор),
		АдресКонструктора);

КонецФункции

Функция ЗаписьВерсии(Знач Версия, Знач Бланк, Знач Раскладка)

	Запись = Кит.Запись();
	Запись.Добавить(ЯчейкаНомера(Версия));
	Запись.Добавить(ЯчейкаСостояния(Версия, Раскладка));
	Запись.Добавить(ЯчейкаДатыПубликации(Версия));
	Запись.Добавить(ЯчейкаТегов(Версия, Бланк, Раскладка));
	Запись.Добавить(ЯчейкаДействий(Версия, Бланк, Раскладка));
	Возврат Запись;

КонецФункции

#КонецОбласти

#Область ЯчейкиВерсии

// Узкая ячейка не переносит номер: «1.3.0-rc.1», разорванный по дефису, читается как два.
Функция ЯчейкаНомера(Знач Версия)

	Ячейка = Кит.Ячейка("узкая");
	Ячейка.Добавить(Кит.Код(Версия.Версия));
	Возврат Ячейка;

КонецФункции

// Ключ и плашка «отозвана» — одним рядом; без признаков ячейка пуста и не печатает подписи.
Функция ЯчейкаСостояния(Знач Версия, Знач Раскладка)

	Доверенная = Раскладка.Доверенные.Получить(Версия.Идентификатор) = Истина;
	Отозвана = ВерсияОтозвана(Версия);

	Ячейка = Кит.Ячейка();
	Если НЕ Доверенная И НЕ Отозвана Тогда
		Возврат Ячейка;
	КонецЕсли;

	Состояние = Ячейка.Добавить(Кит.Ряд("строкой"));
	Состояние.Добавить(ЗначкиВерсии.Ключ(Доверенная));
	Состояние.Добавить(ЗначкиВерсии.Плашки(Новый Структура("Отозвана", Отозвана)));
	Возврат Ячейка;

КонецФункции

Функция ЯчейкаДатыПубликации(Знач Версия)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Текст(?(ЗначениеЗаполнено(Версия.Опубликована),
		Даты.ТолькоДата(Версия.Опубликована), "")));
	Возврат Ячейка;

КонецФункции

// У ручного тега рядом крестик снятия; у тега-правила его нет — снять метку с правила нельзя.
Функция ЯчейкаТегов(Знач Версия, Знач Бланк, Знач Раскладка)

	Ячейка = Кит.Ячейка();

	Теги = Раскладка.ТегиВерсий.Получить(Версия.Идентификатор);
	Если Теги = Неопределено Тогда
		Возврат Ячейка;
	КонецЕсли;

	Для Каждого Тег Из Теги Цикл
		Ячейка.Добавить(Плашки.ПоТегу(Тег, Новый Структура("Действие",
			КрестикСнятия(Бланк, Тег, Версия))));
	КонецЦикла;
	Возврат Ячейка;

КонецФункции

Функция ЯчейкаДействий(Знач Версия, Знач Бланк, Знач Раскладка)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(ФормаОтзыва(Бланк, Версия));
	Ячейка.Добавить(МенюВерсии(Версия, Бланк, Раскладка));
	Возврат Ячейка;

КонецФункции

#КонецОбласти

#Область СнятиеМетки

// Без скрипта крестик ведёт на ШАГ ПОДТВЕРЖДЕНИЯ; серверная сверка остаётся в обоих путях.
Функция КрестикСнятия(Знач Бланк, Знач Тег, Знач Версия)

	Если Режимы.ЭтоПравило(Тег.Режим) Тогда
		Возврат "";
	КонецЕсли;

	ИмяТега = Строка(Тег.Имя);
	СтрокаВерсии = Строка(Версия.Версия);

	Форма = Бланки.Форма(Бланк);
	Форма.Признак("confirm", Тексты.Шаблон("settings.package.versions.unset.confirm",
			ИмяТега, СтрокаВерсии))
		.Признак("confirm-field", "подтверждение")
		// значение подтверждения — общее для раздела: сверяет его сервер
		.Признак("confirm-value", Пульт.ЗначениеПодтверждения());

	Форма.Добавить(Кит.СкрытоеПоле("операция", "тег_снять"));
	Форма.Добавить(Кит.СкрытоеПоле("версия", СтрокаВерсии));
	Форма.Добавить(Кит.СкрытоеПоле("имя", ИмяТега));
	Форма.Добавить(КнопкаКрестика(ИмяТега, СтрокаВерсии));

	Возврат Форма.Рендер();

КонецФункции

Функция КнопкаКрестика(Знач ИмяТега, Знач СтрокаВерсии)

	Возврат Кит.Кнопка(Новый Структура(
		"Подпись, Вариант, Размер, Иконка, ТолькоИконка",
		Тексты.Шаблон("settings.package.versions.unset.hint", ИмяТега, СтрокаВерсии),
		"ссылка", "малый", "закрыть", Истина));

КонецФункции

#КонецОбласти

#Область ДействияВерсии

Функция ФормаОтзыва(Знач Бланк, Знач Версия)

	Снята = ВерсияОтозвана(Версия);

	Форма = Бланки.Форма(Бланк);
	Форма.Добавить(Кит.СкрытоеПоле("операция", ?(Снята, "unyank", "yank")));
	Форма.Добавить(Кит.СкрытоеПоле("версия", Версия.Версия));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		?(Снята, Тексты.Текст("settings.package.versions.button.unyank"),
			Тексты.Текст("settings.package.versions.button.yank")),
		"вторичная", "малый")));
	Возврат Форма;

КонецФункции

// Панель едет полем модели, а не ребёнком узла: слота у компонента «меню» в ките нет.
Функция МенюВерсии(Знач Версия, Знач Бланк, Знач Раскладка)

	Варианты = ВариантыТегов(Раскладка.РучныеТеги,
		Раскладка.ТегиВерсий.Получить(Версия.Идентификатор));

	Пункты = Новый Массив();
	Пункты.Добавить(Новый Структура("HTML",
		ПанельМеню(Версия, Бланк, Варианты, Раскладка.АдресКонструктора).Рендер()));

	Возврат Кит.Меню(Новый Структура("Подпись, Пункты",
		Тексты.Шаблон("settings.package.versions.menu.title", Строка(Версия.Версия)), Пункты));

КонецФункции

// Пустой список — не сломанная форма, а подсказка, где тег завести.
Функция ПанельМеню(Знач Версия, Знач Бланк, Знач Варианты, Знач АдресКонструктора)

	Если Варианты.Количество() = 0 Тогда
		Возврат ГдеЗавестиТег(АдресКонструктора);
	КонецЕсли;

	Возврат ФормаНавешиванияТега(Бланк, Версия, Варианты);

КонецФункции

Функция ГдеЗавестиТег(Знач АдресКонструктора)

	Примечание = Кит.Примечание();
	Фраза = Примечание.Добавить(
		Кит.Шаблон(Тексты.Текст("settings.package.versions.menu.tag.none")));
	Фраза.Добавить(Кит.Ссылка(АдресКонструктора))
		.Добавить(Кит.Текст(Тексты.Текст("settings.package.versions.menu.tag.link")));
	Возврат Примечание;

КонецФункции

Функция ФормаНавешиванияТега(Знач Бланк, Знач Версия, Знач Варианты)

	Форма = Бланки.Форма(Бланк, "", "меню");
	Форма.Добавить(Кит.СкрытоеПоле("операция", "тег_добавить"));
	Форма.Добавить(Кит.СкрытоеПоле("версия", Версия.Версия));
	Форма.Добавить(Кит.Поле(Новый Структура("Имя, Метка, Тип, Варианты",
		"имя", Тексты.Текст("settings.package.versions.menu.tag.label"), "выбор", Варианты)));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Тексты.Текст("settings.package.versions.menu.tag.add"), "основная", "малый")));
	Возврат Форма;

КонецФункции

// Только ручные теги, которых на этой версии ещё нет: тег-правило метку игнорирует.
Функция ВариантыТегов(Знач РучныеТеги, Знач ТегиВерсии)

	Стоят = Новый Соответствие();
	Если ТегиВерсии <> Неопределено Тогда
		Для Каждого Тег Из ТегиВерсии Цикл
			Стоят.Вставить(Строка(Тег.Имя), Истина);
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Массив();
	Для Каждого Тег Из РучныеТеги Цикл
		Если Стоят.Получить(Строка(Тег.Имя)) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура("Значение, Подпись", Строка(Тег.Имя), Строка(Тег.Имя)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВерсияОтозвана(Знач Версия)
	Возврат Версия.Отозвана = Истина;
КонецФункции

// Сортировка версий по убыванию semver-компонент (новые сверху).
Функция УпорядочитьПоУбыванию(Знач СписокВерсий)

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("major", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("minor", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("patch", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("item");
	Для Каждого Элемент Из СписокВерсий Цикл
		СтрокаСортировки = Таблица.Добавить();
		СтрокаСортировки.major = Элемент.SemverМажор;
		СтрокаСортировки.minor = Элемент.SemverМинор;
		СтрокаСортировки.patch = Элемент.SemverПатч;
		СтрокаСортировки.item = Элемент;
	КонецЦикла;
	Таблица.Сортировать("major Убыв, minor Убыв, patch Убыв");

	Результат = Новый Массив();
	Для Каждого СтрокаСортировки Из Таблица Цикл
		Результат.Добавить(СтрокаСортировки.item);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаВерсийПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "РежимТега") _Режимы,
	&Пластилин(Значение = "ПлашкаТега") _Плашки,
	&Пластилин(Значение = "ПультВерсийПакета") _Пульт,
	&Пластилин(Значение = "СервисПроисхождения") _Провенанс,
	&Пластилин(Значение = "ЗначкиВерсии") _ЗначкиВерсии,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "БланкРаздела") _Бланки,
	&Пластилин(Значение = "ПримечанияЭкрана") _Примечания,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
