// Секция «Опасная зона» дома «Пакет»: удаление пакета без версий с эхом имени.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Бланки;            // БланкРаздела — адрес и токен раздела
Перем Удаление;          // ПультУдаленияПакета — поля формы удаления

#Область ПубличныйИнтерфейс

// Секция опасной зоны. Печатается, только когда у смотрящего есть необратимое действие
// (ПультУдаленияПакета.МожетУдалять): раздел без него в дом не попадает.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Бланк - Структура - бланк раздела (БланкРаздела): адрес формы и токен сессии.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция Секция(Знач Пакет, Знач Бланк) Экспорт

	Тело = Кит.Холст();
	Тело.Добавить(Кит.СкрытоеПоле(Удаление.ИмяПоляОперации(), Удаление.ЗначениеОперации()));
	Тело.Добавить(ЗонаУдаления(Пакет));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.package.danger.title"),
		Тексты.Шаблон("settings.package.danger.lead", Пакет.Имя), Тело.Рендер());
	Секция.Иконка = "предупреждение";
	Секция.Класс = "section--danger";
	Секция.Действие = Бланки.Адрес(Бланк);
	Секция.Токен = Бланк.Токен;
	Секция.Опасная = Истина;
	// кнопка живёт внутри опасной зоны — общая панель сохранения секции не нужна
	Секция.БезПанели = Истина;
	Возврат Секция;

КонецФункции

#КонецОбласти

#Область Разметка

// Удаление начинается только после того, как человек своей рукой повторил имя пакета.
Функция ЗонаУдаления(Знач Пакет)

	Зона = Кит.ОпаснаяЗона(Новый Структура("Заголовок, Кнопка, Подтверждение",
		Тексты.Текст("settings.package.danger.delete.title"),
		Новый Структура("Подпись", Тексты.Текст("settings.package.danger.button")),
		ЭхоИмени(Пакет)));

	Зона.Добавить(Кит.Примечание(Тексты.Шаблон("settings.package.danger.note", Пакет.Имя)));
	Возврат Зона;

КонецФункции

Функция ЭхоИмени(Знач Пакет)

	Возврат Новый Структура("Имя, Метка, Образец, Подсказка",
		Удаление.ИмяПоляЭха(),
		Тексты.Текст("settings.package.danger.echo.label"),
		Строка(Пакет.Имя),
		Тексты.Шаблон("settings.package.danger.echo.hint", Пакет.Имя));

КонецФункции

#КонецОбласти

&Прозвище("ВитринаОпаснойЗоныПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "БланкРаздела") _Бланки,
	&Пластилин(Значение = "ПультУдаленияПакета") _Удаление) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Тексты = _Тексты;
	Бланки = _Бланки;
	Удаление = _Удаление;

КонецПроцедуры
