// Секция «Опасная зона» дома «Пакет»: одна кнопка «Удалить пакет» и подтверждение с эхом имени —
// со скриптом окно открывается на месте, без скрипта — страницей по адресу ?окно=удалить.

Перем Кит;       // Кит (кит) — фабрика элементов экрана
Перем Окна;      // ОкноРаздела — адрес окна и его состояние
Перем Удаление;  // ПультУдаленияПакета — поля формы удаления
Перем Тексты;    // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Виды окон раздела, которые открывает адрес ?окно=<вид>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат ВидОкна();
КонецФункции

// Секция опасной зоны. Печатается, только когда у смотрящего есть необратимое действие
// (ПультУдаленияПакета.МожетУдалять): раздел без него в дом не попадает.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  АдресРаздела - Строка - адрес раздела: серверная дорога к подтверждению.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.Секция.
//
Функция Секция(Знач Пакет, Знач АдресРаздела, Знач Состояние) Экспорт

	Окно = ОкноУдаления(Пакет, Состояние, АдресРаздела);

	Возврат Кит.Секция(Тексты.Текст("settings.package.danger.title"),
			Кит.Примечание(Тексты.Шаблон("settings.package.danger.note", Пакет.Имя)),
			Кит.Кнопка(Тексты.Текст("settings.package.danger.button")).Опасная().Иконка("корзина")
				.Адрес(Окна.Адрес(АдресРаздела, ВидОкна())).Открывает(Окно),
			Окно)
		.Лид(Тексты.Шаблон("settings.package.danger.lead", Пакет.Имя)).Иконка("предупреждение").Опасная();

КонецФункции

#КонецОбласти

#Область Подтверждение

// Удаление начинается, только когда человек своей рукой повторил имя пакета. Окно стоит на
// странице всегда: открытым — по адресу или с отбитым эхом. Удача уводит со страницы пакета,
// которого больше нет, поэтому форма уходит обычной отправкой.
Функция ОкноУдаления(Знач Пакет, Знач Состояние, Знач АдресРаздела)

	Имя = Строка(Пакет.Имя);
	Возврат Кит.Подтверждение(Тексты.Шаблон("settings.package.danger.confirm.title", Имя),
			Тексты.Шаблон("settings.package.danger.confirm.consequence", Имя),
			ОшибкаОкна(Состояние),
			Кит.СкрытоеПоле(Удаление.ИмяПоляОперации(), Удаление.ЗначениеОперации()))
		.Эхо(Удаление.ИмяПоляЭха(), Имя, Тексты.Текст("settings.package.danger.echo.label"))
		.Кнопка(Тексты.Текст("settings.package.danger.button"))
		.Ошибка(Окна.Отказ(Состояние, Удаление.ИмяПоляЭха()))
		.Форма("").Якорь("paket-udalit").Открыто(Окна.Открыто(Состояние, ВидОкна()))
		.АдресЗакрытия(АдресРаздела);

КонецФункции

Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

Функция ВидОкна()
	Возврат "удалить";
КонецФункции

#КонецОбласти

&Прозвище("ВитринаОпаснойЗоныПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ПультУдаленияПакета") _Удаление,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Окна = _Окна;
	Удаление = _Удаление;
	Тексты = _Тексты;

КонецПроцедуры
