// Операции дома «Пакет»: какая мутация принадлежит какому разделу.

Перем Карточка;  // ПультКарточкиПакета
Перем Версии;    // ПультВерсийПакета
Перем Права;     // ПультПравПакета
Перем Исходы;    // ИсходОкна — форма исхода

#Область ПубличныйИнтерфейс

// Есть ли у раздела мутация вовсе: разделу без неё POST не разрешён. Раздел «Права доступа»
// отвечает окнами раздела и идёт своей дверью — Право.
//
// Параметры:
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Булево - принимает ли раздел мутацию.
//
Функция ПринимаетМутацию(Знач Ключ) Экспорт
	Возврат Ключ = "card" ИЛИ Ключ = "versions";
КонецФункции

// Применяет мутацию раздела дома «Пакет». Ключ раздела обязан принимать мутацию.
//
// Параметры:
//  Ключ - Строка - ключ раздела.
//  Пакет - Пакет - пакет раздела.
//  Пользователь - Пользователь, Неопределено - кто действует.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - исход (см. ИсходОкна.Удача).
//
Функция Применить(Знач Ключ, Знач Пакет, Знач Пользователь, Знач Форма) Экспорт

	Если Ключ = "card" Тогда
		Карточка.Сохранить(Пакет, Пользователь, Форма);
		Возврат Исходы.Удача();
	ИначеЕсли Ключ = "versions" Тогда
		Возврат Версии.Применить(Пакет, Пользователь, Форма);
	КонецЕсли;

	// белый список разделов держит ПринимаетМутацию; разошлись — форма ушла бы в чужую
	// ветку молча, поэтому здесь отказ, а не последняя ветка «всё остальное»
	ВызватьИсключение СтрШаблон("Раздел ""%1"" мутации не принимает", Ключ);

КонецФункции

// Выдача и отзыв роли раздела «Права доступа».
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Пользователь - Пользователь, Неопределено - кто действует.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - исход (см. ИсходОкна.Удача).
//
Функция Право(Знач Пакет, Знач Пользователь, Знач Форма) Экспорт
	Возврат Права.Применить(Пользователь, Пакет, Форма);
КонецФункции

// Пометка каталога, чья форма в разделе «Карточка» уходит на этот хвост адреса.
//
// Параметры:
//  Хвост - Строка - хвост адреса формы из маршрута.
//
// Возвращаемое значение:
//  Структура, Неопределено - пометка (ПометкиКаталогаПакета); Неопределено — такой нет.
//
Функция ПометкаКаталога(Знач Хвост) Экспорт
	Возврат Карточка.Пометка(Хвост);
КонецФункции

// Ставит или снимает пометку каталога значением её тумблера.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Пользователь - Пользователь, Неопределено - кто действует.
//  Пометка - Структура - пометка (см. ПометкаКаталога).
//  Форма - Соответствие - разобранная форма.
//
Процедура ПометитьВКаталоге(Знач Пакет, Знач Пользователь, Знач Пометка, Знач Форма) Экспорт
	Карточка.Пометить(Пакет, Пользователь, Пометка, Форма);
КонецПроцедуры

#КонецОбласти

&Прозвище("ПультПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПультКарточкиПакета") _Карточка,
	&Пластилин(Значение = "ПультВерсийПакета") _Версии,
	&Пластилин(Значение = "ПультПравПакета") _Права,
	&Пластилин(Значение = "ИсходОкна") _Исходы) Экспорт

	Карточка = _Карточка;
	Версии = _Версии;
	Права = _Права;
	Исходы = _Исходы;

КонецПроцедуры
