// Операции раздела «Теги» дома «Пакет»: заведение и правка тега (у тега пула — копией), проба
// правила, удаление, выключение тега пула и его возвращение, каналы по умолчанию. Исход каждой —
// домена плюс отказы у полей окна.

Перем Гейт;           // ГейтФормы — CSRF-токен формы
Перем РазборФормы;
Перем СервисТегов;    // СервисТегов (реестр)
Перем Происхождения;  // ПроисхождениеТега (реестр) — свой, от пула, копия или выключен
Перем Каналы;         // КаналыПоУмолчанию (реестр) — заведение трёх каналов визардом
Перем ОкноКаналов;    // ОкноКаналовПоУмолчанию — операция визарда
Перем Конструкторы;   // КонструкторТега — набранное в окне и словарь видов
Перем Поля;           // ПоляТега — имена полей окна тега
Перем Сбои;           // ТекстСбоя — причина сбоя человеку и отчёт в журнал
Перем Тексты;         // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Разбирает тело запроса и проверяет CSRF.
//
// Параметры:
//  Ответ - ОтветСервера.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  ТелоЗапроса - Строка.
//  КукиЗапроса - Куки - куки запроса.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - разобранная форма; Неопределено — ответ уже сформирован.
//
Функция Форма(Ответ, Знач Контекст, Знач ТелоЗапроса, Знач КукиЗапроса) Экспорт
	Возврат Гейт.СПринятымТокеном(Ответ, Контекст, РазборФормы.Разобрать(ТелоЗапроса), КукиЗапроса);
КонецФункции

// Пришла ли отправка окна «Каналы по умолчанию».
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоВизард(Знач Форма) Экспорт
	Возврат Операция(Форма) = ОкноКаналов.Операция();
КонецФункции

// Нажата ли в окне тега «Проверить состав»: правило не пишется, окно возвращается с составом.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоПроба(Знач Форма) Экспорт
	Возврат Операция(Форма) = Поля.ОперацияПроверки();
КонецФункции

// Пришла ли форма старой вкладки: её операция («сохранить», «удалить», «выключить») новой
// странице неизвестна. Такая форма отбивается, а не уходит молча в заведение тега.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//  Допустимые - Строка - операции, которые эта точка принимает, через запятую; "" — никаких.
//
// Возвращаемое значение:
//  Булево.
//
Функция ФормаУстарела(Знач Форма, Знач Допустимые = "") Экспорт
	Значение = Операция(Форма);
	Возврат ЗначениеЗаполнено(Значение) И СтрРазделить(Допустимые, ",", Ложь).Найти(Значение) = Неопределено;
КонецФункции

// Отказ формы старой вкладки: ничего не изменено.
//
// Возвращаемое значение:
//  Структура - исход (см. Создать), код 400.
//
Функция ОтказУстаревшей() Экспорт
	Возврат Отбито(Тексты.Текст("settings.tags.error.stale"));
КонецФункции

// Операции, которые принимает форма раздела: проба окна тега и визард каналов.
//
// Возвращаемое значение:
//  Строка - через запятую.
//
Функция ОперацииРаздела() Экспорт
	Возврат Поля.ОперацияПроверки() + "," + ОкноКаналов.Операция();
КонецФункции

// Заводит тег по форме окна «Новый тег».
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Кто - Строка - логин действующего: попадает в событие.
//  Форма - Соответствие - разобранная форма окна.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка — причина отказа словами,
//              заполнена у любого отказа), Отказы (Соответствие — имя поля -> отказ под полем),
//              ИмяТега (Строка — записанный тег), Предпросмотр (Структура, Неопределено —
//              состав канала пробы), Предупреждение (Строка — удалось, но есть что знать).
//
Функция Создать(Знач Пакет, Знач Кто, Знач Форма) Экспорт

	Набранное = Конструкторы.ИзФормы(Форма, РазборФормы.Поле(Форма, Поля.ИмяПоляИмени()));
	ОтказИмени = ОтказИмени(Пакет, Набранное.Имя);
	Если ЗначениеЗаполнено(ОтказИмени) Тогда
		Возврат ОтбитоПолем(Поля.ИмяПоляИмени(), ОтказИмени);
	КонецЕсли;
	Возврат Записать(Пакет, Набранное, Кто);

КонецФункции

// Сохраняет правку тега из окна «Изменить»: имя — из адреса; тег пула получает у пакета копию.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  ИмяТега - Строка - имя тега из адреса маршрута.
//  Кто - Строка - логин действующего.
//  Форма - Соответствие - разобранная форма окна.
//
// Возвращаемое значение:
//  Структура - см. Создать.
//
Функция Сохранить(Знач Пакет, Знач ИмяТега, Знач Кто, Знач Форма) Экспорт

	Тег = СервисТегов.НайтиДействующийТег(Пакет.Идентификатор, ИмяТега);
	Если Тег = Неопределено Тогда
		Возврат Отбито(Тексты.Шаблон("settings.package.tags.error.missing", ИмяТега), 404);
	КонецЕсли;
	Возврат Записать(Пакет, Конструкторы.ИзФормы(Форма, Тег.Имя), Кто);

КонецФункции

// Проба правила без записи: окно возвращается с составом канала. Ответ — отказ (422): тег
// не записан, а скрипт кита кладёт в открытое окно только отказ.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  ИмяТега - Строка - имя тега из адреса; "" — проба в окне нового тега.
//  Форма - Соответствие - разобранная форма окна.
//
// Возвращаемое значение:
//  Структура - см. Создать; Предпросмотр заполнен, если правило применилось.
//
Функция Проба(Знач Пакет, Знач ИмяТега, Знач Форма) Экспорт

	Набранное = Конструкторы.ИзФормы(Форма, ?(ЗначениеЗаполнено(ИмяТега), ИмяТега,
		РазборФормы.Поле(Форма, Поля.ИмяПоляИмени())));
	ПолеПравила = Поля.ИмяПоляПравила(Конструкторы.КодВида(Набранное.Режим, Набранное.Тип));

	Если Конструкторы.ЭтоРучной(Набранное) Тогда
		Возврат Исход(Ложь, 422, "", Новый Соответствие());
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Набранное.Правило) Тогда
		Возврат ОтбитоПолем(ПолеПравила, Тексты.Текст("form.error.required"), 422);
	КонецЕсли;

	Попытка
		Предпросмотр = СервисТегов.ПредпросмотрПравила(Пакет.Идентификатор, Набранное.Тип, Набранное.Правило);
	Исключение
		Возврат ОтбитоПолем(ПолеПравила, Тексты.Шаблон("settings.package.tag-new.preview.error",
			Сбои.Человеку(ИнформацияОбОшибке())), 422);
	КонецПопытки;

	Итог = Исход(Ложь, 422, "", Новый Соответствие());
	Итог.Предпросмотр = Предпросмотр;
	Возврат Итог;

КонецФункции

// Вид подтверждения, которым спрашивают снятие тега: свой удаляется с эхом имени, копия
// тега пула — без эха, она возвращает тег пула; прочие не снимаются вовсе.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  ИмяТега - Строка - имя тега.
//
// Возвращаемое значение:
//  Строка - «удалить», «вернуть» или "" — снимать нечего.
//
Функция ВидСнятия(Знач Пакет, Знач ИмяТега) Экспорт

	Происхождение = СервисТегов.ПроисхождениеТега(Пакет.Идентификатор, ИмяТега);
	Если Происхождение = Происхождения.Свой() Тогда
		Возврат "удалить";
	ИначеЕсли Происхождение = Происхождения.Перекрывает() Тогда
		Возврат "вернуть";
	КонецЕсли;
	Возврат "";

КонецФункции

// Снимает свой тег (по эху имени) либо копию тега пула: версии остаются, канала у пакета нет.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  ИмяТега - Строка - имя тега из адреса маршрута.
//  Кто - Строка - логин действующего.
//  Форма - Соответствие - разобранная форма подтверждения.
//
// Возвращаемое значение:
//  Структура - см. Создать; несовпавшее эхо — отказ под эхо-полем; тег пула без копии — 422.
//
Функция Удалить(Знач Пакет, Знач ИмяТега, Знач Кто, Знач Форма) Экспорт

	Вид = ВидСнятия(Пакет, ИмяТега);
	Если НЕ ЗначениеЗаполнено(Вид) Тогда
		Тег = СервисТегов.НайтиДействующийТег(Пакет.Идентификатор, ИмяТега);
		Возврат ?(Тег = Неопределено,
			Отбито(Тексты.Шаблон("settings.package.tags.error.missing", ИмяТега), 404),
			Отбито(Тексты.Шаблон("settings.package.tags.error.inherited", Тег.Имя), 422));
	КонецЕсли;

	Тег = СервисТегов.НайтиСвойТег(Пакет.Идентификатор, ИмяТега);
	Если Вид = "удалить" И СокрЛП(РазборФормы.Поле(Форма, Поля.ИмяПоляЭха())) <> Строка(Тег.Имя) Тогда
		Возврат ОтбитоПолем(Поля.ИмяПоляЭха(), Тексты.Шаблон("settings.tags.delete.echo.mismatch", Тег.Имя));
	КонецЕсли;

	СервисТегов.УдалитьТег(Пакет.Идентификатор, Тег.Имя, Кто);
	Возврат Удача();

КонецФункции

// Выключает у пакета тег, унаследованный от пула.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  ИмяТега - Строка - имя тега пула.
//  Кто - Строка - логин действующего.
//
// Возвращаемое значение:
//  Структура - см. Создать.
//
Функция Выключить(Знач Пакет, Знач ИмяТега, Знач Кто) Экспорт

	Если НЕ СервисТегов.ВыключитьТегПула(Пакет.Идентификатор, ИмяТега, Кто) Тогда
		Возврат Отбито(Тексты.Шаблон("settings.package.tags.error.notpool", ИмяТега), 422);
	КонецЕсли;
	Возврат Удача();

КонецФункции

// Возвращает пакету выключенный у него тег пула.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  ИмяТега - Строка - имя тега пула.
//  Кто - Строка - логин действующего.
//
// Возвращаемое значение:
//  Структура - см. Создать.
//
Функция Включить(Знач Пакет, Знач ИмяТега, Знач Кто) Экспорт

	Если НЕ СервисТегов.ВключитьТегПула(Пакет.Идентификатор, ИмяТега, Кто) Тогда
		Возврат Отбито(Тексты.Шаблон("settings.package.tags.error.notdisabled", ИмяТега), 422);
	КонецЕсли;
	Возврат Удача();

КонецФункции

// Заводит каналы по умолчанию. Имена, занятые номерами версий, пропускаются и называются.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Кто - Строка - логин действующего.
//
// Возвращаемое значение:
//  Структура - см. Создать; Пропущено (Булево — визард обошёл имена, занятые версиями).
//
Функция ЗавестиКаналы(Знач Пакет, Знач Кто) Экспорт

	Итог = Каналы.Создать(Пакет.Идентификатор, Кто);
	Занятые = СтрСоединить(Итог.Занято, ", ");

	// имена заняты номерами версий — тупик: пока их не переименуют, заводить нечего
	Если Итог.Создано.Количество() = 0 И Итог.Занято.Количество() > 0 Тогда
		Возврат Отбито(Тексты.Шаблон("settings.package.tags.wizard.busy", Занятые));
	КонецЕсли;

	// «всё уже заведено» отказом не является: ничего не сломалось, добавить просто нечего
	Если Итог.Создано.Количество() = 0 Тогда
		Исход = Отбито(Тексты.Текст("settings.package.tags.wizard.nothing"), 409);
		Исход.Предупреждение = Исход.Сообщение;
		Возврат Исход;
	КонецЕсли;

	Исход = Удача();
	Исход.Вставить("Пропущено", Итог.Занято.Количество() > 0);
	Возврат Исход;

КонецФункции

// Предупреждение после визарда, который пропустил занятые имена. Имена называет домен, а не
// адрес: каналы визарда, которых у пакета нет, потому что имя занято версией. Без основного
// тега установка идёт фолбэком «последняя версия», а не каналом мейнтейнера.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//
// Возвращаемое значение:
//  Строка - текст; "" — пропусков нет.
//
Функция ПредупреждениеПропуска(Знач Пакет) Экспорт

	Занятые = Новый Массив();
	Для Каждого Предложение Из Каналы.Предложения() Цикл
		Если СервисТегов.ИмяДляНовогоТегаЗанято(Пакет.Идентификатор, Предложение.Имя) Тогда
			Занятые.Добавить(Предложение.Имя);
		КонецЕсли;
	КонецЦикла;
	Если Занятые.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Пропущено = СтрСоединить(Занятые, ", ");
	ЕстьОсновной = Ложь;
	Для Каждого Тег Из СервисТегов.ДействующиеТеги(Пакет.Идентификатор) Цикл
		ЕстьОсновной = ЕстьОсновной ИЛИ Тег.ПоУмолчанию = Истина;
	КонецЦикла;
	Возврат ?(ЕстьОсновной, Тексты.Шаблон("settings.package.tags.wizard.skipped", Пропущено),
		Тексты.Шаблон("settings.package.tags.wizard.skipped.nodefault", Пропущено));

КонецФункции

// Отказ, который сервер даст имени нового тега, — для проверки до отправки.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  ИмяТега - Строка - набранное имя.
//
// Возвращаемое значение:
//  Строка - текст отказа; "" — имя годится.
//
Функция ОтказИмени(Знач Пакет, Знач ИмяТега) Экспорт

	Если НЕ СервисТегов.ИмяДопустимо(ИмяТега) Тогда
		Возврат Тексты.Текст("settings.tags.error.name");
	КонецЕсли;
	Если СервисТегов.НайтиДействующийТег(Пакет.Идентификатор, ИмяТега) <> Неопределено Тогда
		Возврат Тексты.Шаблон("settings.tags.error.exists", НРег(СокрЛП(ИмяТега)));
	КонецЕсли;
	Если СервисТегов.ИмяДляНовогоТегаЗанято(Пакет.Идентификатор, ИмяТега) Тогда
		Возврат Тексты.Текст("settings.package.tag-new.name.version.error");
	КонецЕсли;
	Возврат "";

КонецФункции

// Отказ, который сервер даст выражению правила, — для проверки до отправки.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Вид - Строка - код вида правила: semver или regex.
//  Выражение - Строка - набранное выражение.
//
// Возвращаемое значение:
//  Строка - текст отказа; "" — правило применимо.
//
Функция ОтказПравила(Знач Пакет, Знач Вид, Знач Выражение) Экспорт

	Попытка
		СервисТегов.ПредпросмотрПравила(Пакет.Идентификатор, Конструкторы.ПараИзВида(Вид).Тип, Выражение);
	Исключение
		Возврат Тексты.Шаблон("settings.package.tag-new.preview.error", Сбои.Человеку(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат "";

КонецФункции

#КонецОбласти

#Область Запись

// Вид и оформление — ключи закрытых списков: подделанное значение отбивается над полями,
// выражение — под своим полем.
Функция Записать(Знач Пакет, Знач Набранное, Знач Кто)

	Если НЕ Конструкторы.ВидДопустим(Набранное.Вид) Тогда
		Возврат Отбито(Тексты.Текст("settings.package.tag-new.kind.error"));
	КонецЕсли;
	Если НЕ Конструкторы.ОформлениеДопустимо(Набранное.ОформлениеФормы) Тогда
		Возврат Отбито(Тексты.Текст("settings.tags.error.look"));
	КонецЕсли;

	ПолеПравила = Поля.ИмяПоляПравила(Конструкторы.КодВида(Набранное.Режим, Набранное.Тип));
	Если НЕ Конструкторы.ЭтоРучной(Набранное) И НЕ ЗначениеЗаполнено(Набранное.Правило) Тогда
		Возврат ОтбитоПолем(ПолеПравила, Тексты.Текст("form.error.required"));
	КонецЕсли;

	Попытка
		ЗаписатьТег(Пакет, Набранное, Кто);
	Исключение
		Возврат ОтбитоПолем(ПолеПравила, Тексты.Шаблон("settings.package.error.save",
			Сбои.Человеку(ИнформацияОбОшибке())));
	КонецПопытки;

	Исход = Удача();
	Исход.ИмяТега = НРег(Набранное.Имя);
	Возврат Исход;

КонецФункции

Процедура ЗаписатьТег(Знач Пакет, Знач Набранное, Знач Кто)

	Если Конструкторы.ЭтоРучной(Набранное) Тогда
		СервисТегов.ОпределитьРучнойТег(Пакет.Идентификатор, Набранное.Имя, Кто,
			Конструкторы.ПараОформления(Набранное));
	Иначе
		СервисТегов.ОпределитьТегПравила(Пакет.Идентификатор, Набранное.Имя,
			Набранное.Тип, Набранное.Правило, Кто, Конструкторы.ПараОформления(Набранное));
	КонецЕсли;

	// снять признак «по умолчанию» отдельно нельзя: у пакета он всегда ровно один,
	// и снимается он назначением другого тега — поэтому тумблер только назначает
	Если Набранное.ПоУмолчанию Тогда
		СервисТегов.НазначитьПоУмолчанию(Пакет.Идентификатор, Набранное.Имя);
	КонецЕсли;

	// а этот тумблер работает в обе стороны: снятый запрет так же возвращается формой
	СервисТегов.УстановитьЗапретПерезаписи(Пакет.Идентификатор, Набранное.Имя,
		Набранное.ЗапретПерезаписи, Кто);

КонецПроцедуры

#КонецОбласти

#Область Исход

Функция Удача()
	Возврат Исход(Истина, 200, "", Новый Соответствие());
КонецФункции

Функция Отбито(Знач Сообщение, Знач Код = 400)
	Возврат Исход(Ложь, Код, Сообщение, Новый Соответствие());
КонецФункции

Функция ОтбитоПолем(Знач ИмяПоля, Знач Текст, Знач Код = 400)

	Отказы = Новый Соответствие();
	Отказы.Вставить(ИмяПоля, Строка(Текст));
	Возврат Исход(Ложь, Код, Текст, Отказы);

КонецФункции

Функция Исход(Знач Успех, Знач Код, Знач Сообщение, Знач Отказы)
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы, ИмяТега, Предпросмотр, Предупреждение",
		Успех, Код, Строка(Сообщение), Отказы, "", Неопределено, "");
КонецФункции

Функция Операция(Знач Форма)
	Возврат НРег(СокрЛП(РазборФормы.Поле(Форма, Поля.ИмяПоляОперации())));
КонецФункции

#КонецОбласти

&Прозвище("ПультТеговПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "ПроисхождениеТега") _Происхождения,
	&Пластилин(Значение = "КаналыПоУмолчанию") _Каналы,
	&Пластилин(Значение = "ОкноКаналовПоУмолчанию") _ОкноКаналов,
	&Пластилин(Значение = "КонструкторТега") _Конструкторы,
	&Пластилин(Значение = "ПоляТега") _Поля,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	СервисТегов = _СервисТегов;
	Происхождения = _Происхождения;
	Каналы = _Каналы;
	ОкноКаналов = _ОкноКаналов;
	Конструкторы = _Конструкторы;
	Поля = _Поля;
	Сбои = _Сбои;
	Тексты = _Тексты;

КонецПроцедуры
