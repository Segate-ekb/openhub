// Заведение и отзыв доверенного конвейера из дома «Пакет»: форма окна «Доверить конвейеру»,
// разбор ссылки на workflow в поля окна, отзыв записи. Порог операций — в СервисДоверияCI.

Перем РазборФормы;
Перем Поля;          // ФормаДоверияCI — имена полей, операции и вид окна «Доверить конвейеру»
Перем Список;        // СписокДоверияCI — вид окна подтверждения отзыва
Перем Исходы;        // ИсходОкна — форма исхода
Перем СервисДоверия; // СервисДоверияCI (публикация) — доверить, отозвать, порог права
Перем Провайдеры;    // ПредставлениеПровайдераCI — тип репозитория из словаря
Перем Числа;         // ПриведениеЧисел (основа) — строгое чтение номера записи
Перем КороткаяФорма; // КороткаяФормаДоверия (публикация) — разбор ссылки и короткие поля
Перем Виды;          // ВидРефаДоверия (публикация) — вид рефа, предлагаемый по значению
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Применяет форму окна «Доверить конвейеру»: заведение записи либо разбор ссылки в поля окна.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса (порог права судит сервис).
//  Пакет - Пакет - пакет раздела.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - исход (см. ИсходОкна.Удача): отказ и разобранная ссылка (422) — в окне «Доверить
//              конвейеру» на набранном либо на разобранном, форма старой вкладки — над разделом.
//
Функция Применить(Знач Принципал, Знач Пакет, Знач Форма) Экспорт

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, Поля.ИмяПоляОперации())));

	Если Операция = Поля.ОперацияДоверить() Тогда
		Возврат Доверить(Принципал, Пакет, Форма);
	ИначеЕсли Операция = Поля.ОперацияРазобрать() Тогда
		Возврат Разобрать(Форма);
	КонецЕсли;

	// снятая операция «отозвать» (отзыв теперь — подтверждение записи) и всякая незнакомая:
	// форма старой вкладки, ничего не изменено; окна этой формы на странице нет — причина над разделом
	Возврат Исходы.Отбито(Тексты.Текст("settings.package.ci.error.stale"));

КонецФункции

// Отзывает доверие записи пакета по подтверждённой форме.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса.
//  Пакет - Пакет - пакет раздела.
//  Номер - Строка - номер записи из адреса формы.
//
// Возвращаемое значение:
//  Структура - исход (см. ИсходОкна.Удача): номер, не называющий запись, — 404; отказ домена —
//              в подтверждении отзыва этой записи.
//
Функция Отозвать(Знач Принципал, Знач Пакет, Знач Номер) Экспорт

	// строгое чтение: «5.7» не должно молча превращаться в запись 5
	Идентификатор = Числа.ЦелоеИлиНеопределено(СокрЛП(Строка(Номер)));
	Если Идентификатор = Неопределено ИЛИ Идентификатор <= 0 Тогда
		Возврат Исходы.Отбито(Тексты.Текст("settings.package.ci.error.id"), 404);
	КонецЕсли;

	Итог = СервисДоверия.ОтозватьДоверие(Принципал, Пакет, Идентификатор);
	Если Итог.Успех Тогда
		Возврат Исходы.Удача();
	КонецЕсли;
	Возврат Исходы.ВОкне(Исходы.Отбито(Тексты.Шаблон("settings.package.ci.error.revoke", Итог.Сообщение), Итог.Код),
		Список.ВидУдаления(), Формат(Идентификатор, "ЧГ=0; ЧН=0"), Неопределено);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Тип репозитория — из сегментов окна, как пришёл: незнакомый отбивает домен, а не подменяет
// экран. Поле конвейера читается только из набора пришедшего типа.
// Форма заведения без поля конвейера GitLab — со старой вкладки: в ней конвейер GitLab ехал
// общим полем, и прочитать его новым именем значило бы молча доверить любому конвейеру.
Функция Доверить(Знач Принципал, Знач Пакет, Знач Форма)

	Если Форма.Получить(Поля.ИмяПоляКонвейера(СервисДоверия.ПровайдерGitLab())) = Неопределено Тогда
		Возврат Исходы.Отбито(Тексты.Текст("settings.package.ci.error.stale"));
	КонецЕсли;

	Провайдер = НРег(Значение(Форма, Поля.ИмяПоляПровайдера()));
	Репозиторий = Значение(Форма, Поля.ИмяПоляРепозитория());
	Реф = Значение(Форма, Поля.ИмяПоляРефа());

	Отказы = Новый Соответствие();
	Если НЕ ЗначениеЗаполнено(Репозиторий) Тогда
		Отказы.Вставить(Поля.ИмяПоляРепозитория(), Тексты.Текст("form.error.required"));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Реф) Тогда
		Отказы.Вставить(Поля.ИмяПоляРефа(), Тексты.Текст("form.error.required"));
	КонецЕсли;
	Если Отказы.Количество() > 0 Тогда
		Возврат ВОкне(Исходы.ОтбитоПолями(Отказы), Форма);
	КонецЕсли;

	// издатель в форме не спрашивается: пустой выводится из типа репозитория,
	// а выбранный в «дополнительно» едет как есть
	Итог = СервисДоверия.Доверить(Принципал, Пакет, Провайдер,
		Значение(Форма, Поля.ИмяПоляИздателя()),
		Репозиторий,
		Значение(Форма, Поля.ИмяПоляКонвейера(Провайдер)),
		Реф,
		Значение(Форма, Поля.ИмяПоляВидаРефа()));

	Если Итог.Успех Тогда
		Возврат Исходы.Удача();
	КонецЕсли;
	Возврат ВОкне(Исходы.Отбито(Тексты.Шаблон("settings.package.ci.error.trust", Итог.Сообщение), Итог.Код),
		Форма);

КонецФункции

// Разбор ссылки НЕ создаёт записи: из ссылки нельзя отличить ветку от тега и от коммита.
// Разобранное возвращается в поля того же окна ответом 422 — окно остаётся открытым.
Функция Разобрать(Знач Форма)

	ИмяСсылки = Поля.ИмяПоляСсылки();
	Ссылка = Значение(Форма, ИмяСсылки);

	// пустая ссылка — обычный исход неявной отправки формы по Enter, и говорить о ней
	// «не разобрана» значит объяснять не то
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат ВОкне(Исходы.ОтбитоПолем(ИмяСсылки, Тексты.Текст("settings.package.ci.error.link.empty")),
			Форма);
	КонецЕсли;

	Разбор = КороткаяФорма.РазобратьСсылку(Ссылка);
	Если НЕ Разбор.Успех Тогда
		Возврат ВОкне(Исходы.ОтбитоПолем(ИмяСсылки, Тексты.Текст("settings.package.ci.error.link")), Форма);
	КонецЕсли;

	Провайдер = Провайдеры.Нормализовать(Разбор.Провайдер);
	Набранное = Новый Соответствие();
	Набранное.Вставить(ИмяСсылки, Ссылка);
	Набранное.Вставить(Поля.ИмяПоляПровайдера(), Провайдер);
	Набранное.Вставить(Поля.ИмяПоляРепозитория(), Разбор.Репозиторий);
	Набранное.Вставить(Поля.ИмяПоляКонвейера(Провайдер),
		КороткаяФорма.ЗначениеДляФормы(Разбор.Провайдер, Разбор.Конвейер));
	Набранное.Вставить(Поля.ИмяПоляРефа(), Разбор.Реф);
	// ссылка ветку от тега не отличает, поэтому вид предлагается по самому значению
	// («v1.2.0» — тег, «develop» — ветка) и остаётся на глазах у человека
	Набранное.Вставить(Поля.ИмяПоляВидаРефа(), Виды.ПоЗначению(Разбор.Реф));
	// издатель приезжает из самого разбора: хост ссылки уже сверен со списком хаба
	Набранное.Вставить(Поля.ИмяПоляИздателя(), Разбор.Издатель);

	Возврат ВОкне(Исходы.Отбито("", 422), Набранное);

КонецФункции

Функция Значение(Знач Форма, Знач Имя)
	Возврат СокрЛП(Строка(РазборФормы.Поле(Форма, Имя)));
КонецФункции

// Отказ формы окна «Доверить конвейеру» остаётся в этом окне.
Функция ВОкне(Знач Отказ, Знач Набранное)
	Возврат Исходы.ВОкне(Отказ, Поля.ВидОкна(), "", Набранное);
КонецФункции

#КонецОбласти

&Прозвище("ПультДоверияCI")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ФормаДоверияCI") _Поля,
	&Пластилин(Значение = "СписокДоверияCI") _Список,
	&Пластилин(Значение = "ИсходОкна") _Исходы,
	&Пластилин(Значение = "СервисДоверияCI") _СервисДоверия,
	&Пластилин(Значение = "ПредставлениеПровайдераCI") _Провайдеры,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "КороткаяФормаДоверия") _КороткаяФорма,
	&Пластилин(Значение = "ВидРефаДоверия") _Виды,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	Поля = _Поля;
	Список = _Список;
	Исходы = _Исходы;
	СервисДоверия = _СервисДоверия;
	Провайдеры = _Провайдеры;
	Числа = _Числа;
	КороткаяФорма = _КороткаяФорма;
	Виды = _Виды;
	Тексты = _Тексты;

КонецПроцедуры
