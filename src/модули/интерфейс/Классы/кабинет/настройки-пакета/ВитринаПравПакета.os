// Раздел «Права доступа» дома «Пакет». Разметку действующих ролей и окна печатает общая
// ВитринаВыдачиРоли; здесь — объект раздела, подписи и строка о наследовании от пула.

Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем ВитринаВыдачи;  // ВитринаВыдачиРоли — секция действующих ролей
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секции раздела «права доступа» пакета.
//
// Параметры:
//  Параметры - Структура:
//    * Пакет - Пакет - пакет, права на который показываются;
//    * Адрес - Строка - адрес раздела без параметров;
//    * МожетВыдавать - Булево - вправе ли смотрящий выдавать и отзывать права на этом пакете;
//    * АдресДоступаПула - Строка - адрес раздела пула, где правятся роли на весь пул;
//    * Окно - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - одна секция.
//
Функция Секции(Знач Параметры) Экспорт

	Результат = Новый Массив();
	Результат.Добавить(ВитринаВыдачи.Секция(
		Раздел(Параметры.Пакет, Параметры.Адрес, Параметры.АдресДоступаПула),
		(Параметры.МожетВыдавать = Истина), Параметры.Окно));
	Возврат Результат;

КонецФункции

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<ключ>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат ВитринаВыдачи.ВидыОкон();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Это всё, чем раздел прав пакета отличается от раздела прав пула.
Функция Раздел(Знач Пакет, Знач Адрес, Знач АдресДоступаПула)

	Возврат Новый Структура("Вид, Идентификатор, Адрес, Заголовок, Лид, Пусто, ТолькоЧтение,"
			+ " ЗаголовокОкна, ЛидОкна, Сноска",
		"пакет", Пакет.Идентификатор, Адрес,
		Тексты.Текст("settings.package.access.title"),
		Тексты.Текст("settings.package.access.lead"),
		Тексты.Текст("settings.package.access.empty"),
		Тексты.Текст("settings.package.access.readonly"),
		Тексты.Текст("settings.package.access-new.title"),
		Тексты.Текст("settings.package.access-new.lead"),
		Наследование(АдресДоступаПула));

КонецФункции

// Таблица выше — роли на самом пакете: без строки о пуле распорядитель выглядит взявшимся
// ниоткуда. Кто ещё распоряжается пакетом — справкой «?», а не абзацем.
Функция Наследование(Знач АдресДоступаПула)

	Если НЕ ЗначениеЗаполнено(АдресДоступаПула) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Примечание(
		Кит.Шаблон(Тексты.Текст("settings.package.access.inherited.pool"),
			Кит.Ссылка(АдресДоступаПула, Тексты.Текст("settings.package.access.inherited.link"))),
		Кит.Подсказка(Тексты.Текст("settings.package.access.inherited.note"))
			.Подпись(Тексты.Текст("settings.package.access.inherited.help")));

КонецФункции

#КонецОбласти

&Прозвище("ВитринаПравПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ВитринаВыдачиРоли") _ВитринаВыдачи,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	ВитринаВыдачи = _ВитринаВыдачи;
	Тексты = _Тексты;

КонецПроцедуры
