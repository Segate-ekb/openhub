// Раздел «Доверенная публикация» дома «Пакет»: реестр доверенных конвейеров с окном «Доверить
// конвейеру» и подтверждением отзыва по адресу, под ним — готовый конвейер.

Перем Список;   // СписокДоверияCI — реестр записей и подтверждение отзыва
Перем Форма;    // ФормаДоверияCI — окно «Доверить конвейеру»
Перем Готовый;  // ГотовыйКонвейерCI — справочные сниппеты
Перем Окна;     // ОкноРаздела — какое окно открыто

#Область ПубличныйИнтерфейс

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<ключ>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат Форма.ВидОкна() + "," + Список.ВидУдаления();
КонецФункции

// Секции раздела «Доверенная публикация» дома «Пакет».
//
// Параметры:
//  Параметры - Структура:
//    * Пул - Пул - пул пакета;
//    * Пакет - Пакет - пакет раздела;
//    * Адрес - Строка - адрес раздела;
//    * АдресХаба - Строка - внешний адрес хаба для сниппетов ("" — не определён);
//    * Окно - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - секция записей и секция готового конвейера.
//
Функция Секции(Знач Параметры) Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Список.Секция(Параметры.Пакет, Параметры.Адрес,
		Форма.Окно(Параметры.Адрес, Параметры.Окно), Параметры.Окно));
	Результат.Добавить(Готовый.Секция(Параметры.Пул, Параметры.Пакет, Параметры.АдресХаба));
	Возврат Результат;

КонецФункции

// Напечатает ли раздел окно, которое называет состояние: окно заведения — всегда, подтверждение
// отзыва — когда запись есть.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Состояние - Структура, Неопределено - состояние окна раздела.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Пакет, Знач Состояние) Экспорт
	Возврат Окна.Открыто(Состояние, Форма.ВидОкна()) ИЛИ Список.ЕстьЗаписьОкна(Пакет, Состояние);
КонецФункции

#КонецОбласти

&Прозвище("ВитринаДоверияCI")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СписокДоверияCI") _Список,
	&Пластилин(Значение = "ФормаДоверияCI") _Форма,
	&Пластилин(Значение = "ГотовыйКонвейерCI") _Готовый,
	&Пластилин(Значение = "ОкноРаздела") _Окна) Экспорт

	Список = _Список;
	Форма = _Форма;
	Готовый = _Готовый;
	Окна = _Окна;

КонецПроцедуры
