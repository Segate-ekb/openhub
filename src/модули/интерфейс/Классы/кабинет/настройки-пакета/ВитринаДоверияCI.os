// Раздел «Доверенная публикация» дома «Пакет»: из каких секций и в каком порядке он состоит.

Перем Список;      // СписокДоверияCI — таблица записей и шаг подтверждения
Перем Форма;       // ФормаДоверияCI — заведение записи
Перем Готовый;     // ГотовыйКонвейерCI — справочные сниппеты
Перем Провайдеры;  // ПредставлениеПровайдераCI — выбранный тип репозитория
Перем Бланки;      // БланкРаздела — адрес и токен раздела

#Область ПубличныйИнтерфейс

// Секции раздела «доверенная публикация» дома «Пакет».
//
// Параметры:
//  Параметры - Структура:
//    * Пул - Пул - пул пакета;
//    * Пакет - Пакет - пакет раздела;
//    * Адрес - Строка - адрес раздела (он же action форм);
//    * Токен - Строка - CSRF-токен сессии;
//    * АдресХаба - Строка - внешний адрес хаба для сниппетов ("" — не определён);
//    * Снятие - Строка - идентификатор записи, снятие которой ждёт подтверждения ("" — шага подтверждения нет);
//    * Провайдер - Строка - выбранный тип репозитория, от него зависит набор полей формы;
//    * Заполнение - Структура, Соответствие, Неопределено - значения, которыми форма предзаполнена;
//    * Открыта - Булево - окно заведения печатается открытым;
//    * Отказы - Соответствие - ключ поля -> текст отказа домена.
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Пакет = Параметры.Пакет;
	Бланк = Бланки.Раздела(Параметры);

	Снятие = "";
	Параметры.Свойство("Снятие", Снятие);
	АдресХаба = "";
	Параметры.Свойство("АдресХаба", АдресХаба);
	Провайдер = "";
	Параметры.Свойство("Провайдер", Провайдер);
	Заполнение = Неопределено;
	Параметры.Свойство("Заполнение", Заполнение);
	Открыта = Ложь;
	Параметры.Свойство("Открыта", Открыта);
	Отказы = Неопределено;
	Параметры.Свойство("Отказы", Отказы);

	// заведение — кнопка над таблицей и окно поверх экрана; список получает готовый узел окна
	Окно = Форма.Окно(Новый Структура("Адрес, Токен, Провайдер, Заполнение, Открыта, Отказы",
		Бланки.Адрес(Бланк), Бланк.Токен, Провайдеры.Нормализовать(Провайдер),
		Заполнение, Открыта, Отказы));

	Результат = Новый Массив();
	Если ЗначениеЗаполнено(Снятие) Тогда
		Результат.Добавить(Список.СекцияПодтвержденияСнятия(Пакет, Бланк, Снятие));
	КонецЕсли;
	Результат.Добавить(Список.Секция(Пакет, Бланк, Окно));
	Результат.Добавить(Готовый.Секция(Параметры.Пул, Пакет, АдресХаба));
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаДоверияCI")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СписокДоверияCI") _Список,
	&Пластилин(Значение = "ФормаДоверияCI") _Форма,
	&Пластилин(Значение = "ГотовыйКонвейерCI") _Готовый,
	&Пластилин(Значение = "ПредставлениеПровайдераCI") _Провайдеры,
	&Пластилин(Значение = "БланкРаздела") _Бланки) Экспорт

	Список = _Список;
	Форма = _Форма;
	Готовый = _Готовый;
	Провайдеры = _Провайдеры;
	Бланки = _Бланки;

КонецПроцедуры
