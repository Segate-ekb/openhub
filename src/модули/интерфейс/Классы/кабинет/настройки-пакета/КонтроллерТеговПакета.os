// Маршруты раздела «Теги» дома «Пакет»: страница с окном по адресу, заведение и правка тега,
// проба правила, удаление, выключение и включение тега пула, каналы по умолчанию, проверка
// имени и выражения до отправки. Удача — 303 на раздел, отказ — та же страница с окном,
// открытым на набранном и отказах.

Перем ГвардПакета;
Перем Ответы;        // ОтветыНастроек
Перем Дом;           // ДомПакета
Перем Витрина;       // ВитринаТеговПакета
Перем Пульт;         // ПультТеговПакета
Перем СоставКанала;  // СоставКаналаТега — тост о составе записанного тега
Перем Защита;        // ЗащитаCSRF (вход)
Перем Окна;          // ОкноРаздела — окно по адресу и ответы форм окон
Перем СервисПакетов; // СервисПакетов (реестр) — пакет после мутации
Перем Тексты;        // ТекстыИнтерфейса (кит)
Перем Поля;          // ПоляТега — операция пробы

#Область ТочкиМаршрута

// Точка маршрута «pools/{pool}/packages/{name}/settings/tags»: GET — страница раздела
// (с «проверка» — ответ проверки поля до отправки), POST — заведение тега, его проба
// или каналы по умолчанию.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: <вид>-<тег> (необязательный, по умолчанию "").
//  saved_tag - Строка - имя только что записанного тега: тост о составе его канала
//              (необязательный, по умолчанию "").
//  skipped - Строка - непустое — визард обошёл имена, занятые версиями: раздел их назовёт
//            (необязательный, по умолчанию "").
//  проверка - Строка - «имя» или «правило» — запрос проверки поля до отправки
//             (необязательный, по умолчанию "").
//  имя - Строка - проверяемое имя нового тега (необязательный, по умолчанию "").
//  правило_semver - Строка - проверяемое выражение semver (необязательный, по умолчанию "").
//  правило_regex - Строка - проверяемое выражение regex (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/tags")
Процедура Раздел(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	saved = "", окно = "", saved_tag = "", skipped = "", проверка = "", имя = "",
	правило_semver = "", правило_regex = "") Экспорт

	Вердикт = Пропуск(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Вердикт = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Если ЗначениеЗаполнено(проверка) Тогда
			ОтветитьПроверкой(Ответ, ОтказПроверки(Вердикт.Пакет, проверка, имя, правило_semver,
				правило_regex));
			Возврат;
		КонецЕсли;
		Показ = Показ(Окна.ИзАдреса(окно, Витрина.ВидыОкон()));
		Показ.Сохранено = ЗначениеЗаполнено(saved);
		Показ.СохранённыйТег = saved_tag;
		Если ЗначениеЗаполнено(skipped) Тогда
			Показ.Предупреждение = Пульт.ПредупреждениеПропуска(Вердикт.Пакет);
		КонецЕсли;
		ОтдатьРаздел(Ответ, Вердикт, КукиЗапроса, 200, Показ);
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Пульт.ФормаУстарела(Форма, Пульт.ОперацииРаздела()) Тогда
		Завершить(Ответ, Вердикт, КукиЗапроса, Пульт.ОтказУстаревшей(), "", "", Форма);
	ИначеЕсли Пульт.ЭтоВизард(Форма) Тогда
		Завершить(Ответ, Вердикт, КукиЗапроса, Пульт.ЗавестиКаналы(Вердикт.Пакет, Кто(Вердикт)),
			"каналы", "", Форма);
	ИначеЕсли Пульт.ЭтоПроба(Форма) Тогда
		Завершить(Ответ, Вердикт, КукиЗапроса, Пульт.Проба(Вердикт.Пакет, "", Форма), "новый", "", Форма);
	Иначе
		Завершить(Ответ, Вердикт, КукиЗапроса, Пульт.Создать(Вердикт.Пакет, Кто(Вердикт), Форма),
			"новый", "", Форма);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «pools/{pool}/packages/{name}/settings/tags/{тег}/save» — форма окна «Изменить»
// и её проба.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  тег - Строка - имя тега.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/tags/{тег}/save")
Процедура Сохранение(Ответ, pool, name, тег, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Пакет = Мутация.Вердикт.Пакет;
	Если Пульт.ФормаУстарела(Мутация.Форма, Поля.ОперацияПроверки()) Тогда
		Исход = Пульт.ОтказУстаревшей();
	ИначеЕсли Пульт.ЭтоПроба(Мутация.Форма) Тогда
		Исход = Пульт.Проба(Пакет, тег, Мутация.Форма);
	Иначе
		Исход = Пульт.Сохранить(Пакет, тег, Кто(Мутация.Вердикт), Мутация.Форма);
	КонецЕсли;
	Завершить(Ответ, Мутация.Вердикт, КукиЗапроса, Исход, "изменить", тег, Мутация.Форма);

КонецПроцедуры

// Точка маршрута «pools/{pool}/packages/{name}/settings/tags/{тег}/delete» — удаление своего
// тега и снятие копии тега пула. Без поля подтверждения (форма ушла без скрипта) ничего
// не снимается: ответ ведёт на страницу с открытым подтверждением.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  тег - Строка - имя тега.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/tags/{тег}/delete")
Процедура Удаление(Ответ, pool, name, тег, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Пакет = Мутация.Вердикт.Пакет;
	Вид = Пульт.ВидСнятия(Пакет, тег);
	Если ЗначениеЗаполнено(Вид) И НЕ Окна.Подтверждено(Мутация.Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресРаздела(Мутация.Вердикт), тег, Вид);
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Вердикт, КукиЗапроса, Пульт.Удалить(Пакет, тег, Кто(Мутация.Вердикт),
		Мутация.Форма), Вид, тег, Мутация.Форма);

КонецПроцедуры

// Точка маршрута «pools/{pool}/packages/{name}/settings/tags/{тег}/disable» — выключить
// у пакета тег, унаследованный от пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  тег - Строка - имя тега пула.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/tags/{тег}/disable")
Процедура Выключение(Ответ, pool, name, тег, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Вердикт, КукиЗапроса, ?(Пульт.ФормаУстарела(Мутация.Форма),
		Пульт.ОтказУстаревшей(), Пульт.Выключить(Мутация.Вердикт.Пакет, тег, Кто(Мутация.Вердикт))), "", тег, Мутация.Форма);

КонецПроцедуры

// Точка маршрута «pools/{pool}/packages/{name}/settings/tags/{тег}/enable» — вернуть пакету
// выключенный тег пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  тег - Строка - имя тега пула.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/tags/{тег}/enable")
Процедура Включение(Ответ, pool, name, тег, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Вердикт, КукиЗапроса, ?(Пульт.ФормаУстарела(Мутация.Форма),
		Пульт.ОтказУстаревшей(), Пульт.Включить(Мутация.Вердикт.Пакет, тег, Кто(Мутация.Вердикт))), "", тег, Мутация.Форма);

КонецПроцедуры

#КонецОбласти

#Область Действия

// Гвард дома и порог раздела: раздел, закрытый смотрящему, отвечает как несуществующий.
Функция Пропуск(Ответ, Знач pool, Знач name, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Вердикт = ГвардПакета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool, name);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ Дом.РазделОткрыт(Ключ(), Вердикт.Пользователь, Вердикт.Пакет) Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт,
			Тексты.Текст("settings.package.error.section"), КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;
	Возврат Вердикт;

КонецФункции

// Общий пролог мутирующих точек: гвард и порог → только POST → форма с CSRF.
Функция Мутация(Ответ, Знач pool, Знач name, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач МетодЗапроса, Знач ТелоЗапроса)

	Вердикт = Пропуск(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Вердикт = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "POST", Вердикт, КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Вердикт, Форма", Вердикт, Форма);

КонецФункции

// Исход пульта → ответ: удача — 303 на раздел (записанный тег и пропуски визарда — парами
// адреса); отказ и проба — страница с окном этой формы, открытым на набранном; окна нет —
// причина тостом над разделом.
Процедура Завершить(Ответ, Знач Вердикт, Знач КукиЗапроса, Знач Исход, Знач ВидОкна, Знач ИмяТега,
	Знач Форма)

	Если Исход.Успех Тогда
		Окна.ВернутьВРазделСПарами(Ответ, АдресРаздела(Вердикт), ПарыУдачи(Исход));
		Возврат;
	КонецЕсли;

	// отказ у поля в окне уже назван — второй раз над шагами его не повторяют
	Окно = Окна.Отбитое(ВидОкна, ИмяТега, Форма, Исход.Отказы,
		?(Исход.Отказы.Количество() > 0, "", Исход.Сообщение));
	Если ЗначениеЗаполнено(ВидОкна) И Витрина.ЕстьОкно(Вердикт.Пакет, Окно) Тогда
		Показ = Показ(Окно);
		Показ.Предпросмотр = Исход.Предпросмотр;
		ОтдатьРаздел(Ответ, Вердикт, КукиЗапроса, Исход.Код, Показ);
		Возврат;
	КонецЕсли;

	Показ = Показ(Неопределено);
	Если ЗначениеЗаполнено(Исход.Предупреждение) Тогда
		Показ.Предупреждение = Исход.Предупреждение;
	Иначе
		Показ.Ошибка = Исход.Сообщение;
	КонецЕсли;
	ОтдатьРаздел(Ответ, Вердикт, КукиЗапроса, Исход.Код, Показ);

КонецПроцедуры

Функция ПарыУдачи(Знач Исход)

	Пары = Новый Соответствие();
	Если ЗначениеЗаполнено(Исход.ИмяТега) Тогда
		Пары.Вставить("saved_tag", Исход.ИмяТега);
	КонецЕсли;
	Пропущено = Ложь;
	Если Исход.Свойство("Пропущено", Пропущено) И Пропущено = Истина Тогда
		Пары.Вставить("skipped", "1");
	КонецЕсли;
	Возврат Пары;

КонецФункции

Функция ОтказПроверки(Знач Пакет, Знач Поле, Знач Имя, Знач ПравилоSemver, Знач ПравилоRegex)

	Если НРег(Поле) = "имя" Тогда
		Возврат Пульт.ОтказИмени(Пакет, Имя);
	ИначеЕсли ЗначениеЗаполнено(ПравилоRegex) Тогда
		Возврат Пульт.ОтказПравила(Пакет, "regex", ПравилоRegex);
	КонецЕсли;
	Возврат Пульт.ОтказПравила(Пакет, "semver", ПравилоSemver);

КонецФункции

// Ответ проверки до отправки: 200 — годится, 409 с причиной — нет.
Процедура ОтветитьПроверкой(Ответ, Знач Отказ)

	Ответ.УстановитьТипКонтента("txt");
	Ответ.УстановитьСостояние(?(ЗначениеЗаполнено(Отказ), 409, 200));
	Ответ.ТелоТекст = Отказ;

КонецПроцедуры

Функция Кто(Знач Вердикт)
	Возврат ?(Вердикт.Пользователь = Неопределено, "", Строка(Вердикт.Пользователь.Логин));
КонецФункции

#КонецОбласти

#Область Рендер

// Что показать на странице раздела, кроме самого раздела.
Функция Показ(Знач Окно)
	Возврат Новый Структура("Окно, Предпросмотр, Сохранено, СохранённыйТег, Ошибка, Предупреждение",
		Окно, Неопределено, Ложь, "", "", "");
КонецФункции

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач КукиЗапроса, Знач Статус, Знач Показ)

	Пул = Вердикт.Пул;
	Пакет = СервисПакетов.ПакетПоИдентификатору(Вердикт.Пакет.Идентификатор);
	Если Пакет = Неопределено Тогда
		Пакет = Вердикт.Пакет;
	КонецЕсли;

	Уведомления = Ответы.УведомленияРаздела(Показ.Сохранено, Показ.Ошибка, Показ.Предупреждение);
	Состав = СоставКанала.Уведомление(Пакет.Идентификатор, Показ.СохранённыйТег);
	Если Состав <> Неопределено Тогда
		Уведомления.Добавить(Состав);
	КонецЕсли;

	Параметры = Новый Структура("Пул, Пакет, Адрес, Пользователь, Окно, Предпросмотр",
		Пул, Пакет, АдресРаздела(Вердикт), Вердикт.Пользователь, Показ.Окно, Показ.Предпросмотр);
	Модель = Ответы.МодельДома(Дом, Пакет.Имя,
		Дом.Разделы(Пул.Имя, Пакет.Имя, Ключ(), Вердикт.Пользователь, Пакет),
		Уведомления,
		Витрина.Секции(Параметры),
		Защита.ТокенСессии(Вердикт.Сессия),
		Дом.Крошки(Пул.Имя, Пакет.Имя));

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт, КукиЗапроса, Статус);

КонецПроцедуры

Функция АдресРаздела(Знач Вердикт)
	Возврат Дом.АдресРаздела(Вердикт.Пул.Имя, Вердикт.Пакет.Имя, Ключ());
КонецФункции

Функция Ключ()
	Возврат "tags";
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардПакета") _ГвардПакета,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомПакета") _Дом,
	&Пластилин(Значение = "ВитринаТеговПакета") _Витрина,
	&Пластилин(Значение = "ПультТеговПакета") _Пульт,
	&Пластилин(Значение = "СоставКаналаТега") _СоставКанала,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПоляТега") _Поля)

	ГвардПакета = _ГвардПакета;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	Пульт = _Пульт;
	СоставКанала = _СоставКанала;
	Защита = _Защита;
	Окна = _Окна;
	СервисПакетов = _СервисПакетов;
	Тексты = _Тексты;
	Поля = _Поля;

КонецПроцедуры
