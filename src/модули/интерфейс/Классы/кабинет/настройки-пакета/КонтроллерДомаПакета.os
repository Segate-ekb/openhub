// Маршруты дома настроек «Пакет»: показ разделов pools/{pool}/packages/{name}/settings
// и передача их формы пульту.

Перем ГвардПакета;
Перем Ответы;        // ОтветыНастроек
Перем Сбои;        // ТекстСбоя — причина сбоя человеку и отчёт в журнал
Перем Дом;           // ДомПакета
Перем Витрина;       // ВитринаДомаПакета — секции разделов
Перем Пульт;         // ПультПакета — мутации разделов
Перем Удаление;      // ПультУдаленияПакета — операция опасной зоны
Перем Гейт;          // ГейтФормы — метод запроса и токен формы
Перем Защита;        // ЗащитаCSRF (вход)
Перем СервисПакетов; // СервисПакетов (реестр) — пакет после мутации
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Страницы; // АдресаСтраниц (реестр) — страницы пула и пакета в хлебных крошках
Перем Окна;     // ОкноРаздела — окно раздела, открытое адресом ?окно=<вид>-<ключ>

#Область ТочкиМаршрута

// Точка маршрута «pools/{pool}/packages/{name}/settings» (GET).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings")
Процедура Обзор(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Вердикт = ГвардПакета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool, name);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	ОтдатьРаздел(Ответ, Вердикт, Дом.РазделПоУмолчанию(), Ложь, "", КукиЗапроса);

КонецПроцедуры

// Точка маршрута «pools/{pool}/packages/{name}/settings/{раздел}» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  раздел - Строка - ключ раздела.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно раздела, открытое по адресу: <вид>-<ключ>; виды знает витрина раздела
//         (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/{раздел}")
Процедура Раздел(Ответ, pool, name, раздел, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	saved = "", окно = "") Экспорт

	Вердикт = ГвардПакета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool, name);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Ключ = НРег(СокрЛП(Строка(раздел)));
	// раздел, закрытый смотрящему, отвечает как несуществующий
	Если НЕ Дом.РазделОткрыт(Ключ, Вердикт.Пользователь, Вердикт.Пакет) Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт,
			Тексты.Текст("settings.package.error.section"), КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Вердикт, Ключ, ЗначениеЗаполнено(saved), "", КукиЗапроса, 200,
			Окна.ИзАдреса(окно, Витрина.ВидыОкон(Ключ)));
		Возврат;
	КонецЕсли;

	Форма = Гейт.ПринятаяФорма(Ответ, Вердикт, "GET, POST", МетодЗапроса, ТелоЗапроса,
		КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Сохранить(Ответ, Вердикт, Ключ, Форма, КукиЗапроса);

КонецПроцедуры

// Точка маршрута «pools/{pool}/packages/{name}/settings/{раздел}/{пометка}» (POST): тумблер
// секции «В каталоге» раздела «Карточка» сохраняет свою пометку сразу и возвращает в раздел.
// Пометки есть только у «Карточки»; у литеральных разделов (ci, webhooks) свои маршруты.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  раздел - Строка - ключ раздела: пометки принимает только card.
//  пометка - Строка - хвост адреса формы пометки: deprecated либо hidden.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/{раздел}/{пометка}")
Процедура ПометкаКаталога(Ответ, pool, name, раздел, пометка, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	ТелоЗапроса) Экспорт

	Вердикт = ГвардПакета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool, name);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Ключ = Дом.КлючКарточки();
	Пометка = ?(НРег(СокрЛП(Строка(раздел))) = Ключ, Пульт.ПометкаКаталога(НРег(СокрЛП(Строка(пометка)))),
		Неопределено);
	Если Пометка = Неопределено Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт,
			Тексты.Текст("settings.package.error.section"), КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Гейт.ПринятаяФорма(Ответ, Вердикт, "POST", МетодЗапроса, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Пульт.ПометитьВКаталоге(Вердикт.Пакет, Вердикт.Пользователь, Пометка, Форма);
	Исключение
		ОтдатьРаздел(Ответ, Вердикт, Ключ, Ложь,
			Тексты.Шаблон("settings.package.error.save", Сбои.Человеку(ИнформацияОбОшибке())),
			КукиЗапроса, 400);
		Возврат;
	КонецПопытки;

	Окна.ВернутьВРаздел(Ответ, Дом.АдресРаздела(Вердикт.Пул.Имя, Вердикт.Пакет.Имя, Ключ));

КонецПроцедуры

#КонецОбласти

#Область Сохранение

Процедура Сохранить(Ответ, Знач Вердикт, Знач Ключ, Знач Форма, Знач КукиЗапроса)

	// удавшееся удаление уводит со страницы пакета, которого больше нет, — своя ветка
	Если Ключ = Дом.КлючОпасной() Тогда
		Удалить(Ответ, Вердикт, Форма, КукиЗапроса);
		Возврат;
	КонецЕсли;

	// права отвечают окнами раздела и идут своей дверью пульта
	Если Ключ = "access" Тогда
		ОтдатьИсходОкна(Ответ, Вердикт, Ключ, Пульт.Право(Вердикт.Пакет, Вердикт.Пользователь, Форма),
			КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если НЕ Пульт.ПринимаетМутацию(Ключ) Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Попытка
		Исход = Пульт.Применить(Ключ, Вердикт.Пакет, Вердикт.Пользователь, Форма);
	Исключение
		ОтдатьРаздел(Ответ, Вердикт, Ключ, Ложь,
			Тексты.Шаблон("settings.package.error.save", Сбои.Человеку(ИнформацияОбОшибке())),
			КукиЗапроса, 400);
		Возврат;
	КонецПопытки;

	ОтдатьИсходОкна(Ответ, Вердикт, Ключ, Исход, КукиЗапроса);

КонецПроцедуры

// Исход формы раздела (см. ИсходОкна): удача — 303 на раздел; неподтверждённая отправка — 303
// на окно подтверждения; отказ — раздел с окном этой формы, открытым на набранном и отказах под
// полями, а когда окна на странице нет — причиной над разделом.
Процедура ОтдатьИсходОкна(Ответ, Знач Вердикт, Знач Ключ, Знач Исход, Знач КукиЗапроса)

	АдресРаздела = Дом.АдресРаздела(Вердикт.Пул.Имя, Вердикт.Пакет.Имя, Ключ);
	Если Исход.Успех Тогда
		Окна.ВернутьВРаздел(Ответ, АдресРаздела);
		Возврат;
	ИначеЕсли Исход.Спросить Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресРаздела, Исход.Ключ, Исход.ВидОкна);
		Возврат;
	КонецЕсли;

	Если Исход.Окно <> Неопределено И Витрина.ЕстьОкно(Ключ, Вердикт.Пакет, Исход.Окно) Тогда
		ОтдатьРаздел(Ответ, Вердикт, Ключ, Ложь, "", КукиЗапроса, Исход.Код, Исход.Окно);
	Иначе
		ОтдатьРаздел(Ответ, Вердикт, Ключ, Ложь, Исход.Сообщение, КукиЗапроса, Исход.Код);
	КонецЕсли;

КонецПроцедуры

// Раздел жил внутри пакета, а пакета больше нет: удавшееся удаление уводит 303 на страницу пула.
// Без поля подтверждения (форма ушла без скрипта) пакет не трогается: ответ ведёт на окно
// подтверждения; несовпавшее эхо — 400 с открытым подтверждением и отказом под полем.
Процедура Удалить(Ответ, Знач Вердикт, Знач Форма, Знач КукиЗапроса)

	Ключ = Дом.КлючОпасной();
	Если НЕ Окна.Подтверждено(Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, Дом.АдресРаздела(Вердикт.Пул.Имя, Вердикт.Пакет.Имя, Ключ), "",
			"удалить");
		Возврат;
	КонецЕсли;

	Исход = Удаление.Применить(Вердикт.Принципал, Вердикт.Пул, Вердикт.Пакет, Форма);
	Если НЕ Исход.Успех Тогда
		ОтдатьИсходОкна(Ответ, Вердикт, Ключ, Исход, КукиЗапроса);
		Возврат;
	КонецЕсли;

	// 303, а не 302: браузер идёт за ответом GET-ом и не повторяет удаление
	Ответ.Перенаправить(Страницы.Пула(Вердикт.Пул.Имя));
	Ответ.УстановитьСостояние(303);

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач Ключ, Знач Сохранено, Знач Ошибка, Знач КукиЗапроса,
	Знач Статус = 200, Знач Окно = Неопределено)

	Пул = Вердикт.Пул;
	Пакет = СервисПакетов.ПакетПоИдентификатору(Вердикт.Пакет.Идентификатор);
	Если Пакет = Неопределено Тогда
		Пакет = Вердикт.Пакет;
	КонецЕсли;

	Уведомления = Ответы.УведомленияРаздела(Сохранено, Ошибка);

	Токен = Защита.ТокенСессии(Вердикт.Сессия);
	Модель = Ответы.МодельДома(Дом, Пакет.Имя,
		Дом.Разделы(Пул.Имя, Пакет.Имя, Ключ, Вердикт.Пользователь, Пакет),
		Уведомления,
		Витрина.Секции(ПараметрыСекций(Вердикт, Пакет, Ключ, Токен, Окно)),
		Токен,
		Дом.Крошки(Пул.Имя, Пакет.Имя));

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт, КукиЗапроса, Статус);

КонецПроцедуры

Функция ПараметрыСекций(Знач Вердикт, Знач Пакет, Знач Ключ, Знач Токен, Знач Окно)

	Результат = Новый Структура();
	Результат.Вставить("Ключ", Ключ);
	Результат.Вставить("Пул", Вердикт.Пул);
	Результат.Вставить("Пакет", Пакет);
	Результат.Вставить("Пользователь", Вердикт.Пользователь);
	Результат.Вставить("Токен", Токен);
	// состояние окна раздела (ОкноРаздела): открытое адресом либо отбитая форма окна
	Результат.Вставить("Окно", Окно);
	Возврат Результат;

КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардПакета") _ГвардПакета,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ДомПакета") _Дом,
	&Пластилин(Значение = "ВитринаДомаПакета") _Витрина,
	&Пластилин(Значение = "ПультПакета") _Пульт,
	&Пластилин(Значение = "ПультУдаленияПакета") _Удаление,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы,
	&Пластилин(Значение = "ОкноРаздела") _Окна)

	ГвардПакета = _ГвардПакета;
	Ответы = _Ответы;
	Сбои = _Сбои;
	Дом = _Дом;
	Витрина = _Витрина;
	Пульт = _Пульт;
	Удаление = _Удаление;
	Гейт = _Гейт;
	Защита = _Защита;
	СервисПакетов = _СервисПакетов;
	Тексты = _Тексты;
	Страницы = _Страницы;
	Окна = _Окна;

КонецПроцедуры
