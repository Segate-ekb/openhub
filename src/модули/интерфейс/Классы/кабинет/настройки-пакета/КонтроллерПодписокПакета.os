Процедура Удаление(Ответ, pool, name, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьДействие(Ответ, pool, name, id, "удалить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

