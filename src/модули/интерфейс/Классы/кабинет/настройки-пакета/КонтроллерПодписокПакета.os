// Маршруты подписок пакета (pools/{pool}/packages/{name}/settings/webhooks): свои подписки
// с окнами по адресу, пробная отправка и предпросмотр, поправки к подпискам пула и хаба.
// Каждая дверь — за гвардом дома пакета; распоряжается подписками тот, кому это разрешает домен.

Перем ГвардПакета;    // ГвардПакета
Перем Ответы;         // ОтветыНастроек
Перем Дом;            // ДомПакета
Перем Витрина;        // ВитринаПодписок
Перем ВитринаСверху;  // ВитринаПодписокСверху — подписки пула и хаба, которые пакет вправе сузить
Перем Ход;            // ХодПодписок — общий ход раздела подписок
Перем Защита;         // ЗащитаCSRF (вход) — токен для форм страницы
Перем СервисПодписок; // СервисПодписок (подписки)
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ТочкиМаршрута

// Точка маршрута «pools/{pool}/packages/{name}/settings/webhooks»: GET — страница раздела, POST — заведение подписки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: <вид>-<ключ> (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/webhooks")
Процедура Раздел(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, saved = "", окно = "") Экспорт

	Контекст = Подготовить(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПоАдресу(Контекст, окно, saved), КукиЗапроса);
		Возврат;
	КонецЕсли;
	ОтдатьРаздел(Ответ, Контекст, Ход.ПоказЗаведения(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
		МетодЗапроса, ТелоЗапроса), КукиЗапроса);

КонецПроцедуры

// Точка маршрута «pools/{pool}/packages/{name}/settings/webhooks/{id}/save» — форма окна «Изменить».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/webhooks/{id}/save")
Процедура Сохранение(Ответ, pool, name, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = Подготовить(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПравки(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «pools/{pool}/packages/{name}/settings/webhooks/{id}/toggle» — тумблер записи.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/webhooks/{id}/toggle")
Процедура Переключение(Ответ, pool, name, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = Подготовить(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПереключения(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «pools/{pool}/packages/{name}/settings/webhooks/{id}/delete». Без поля подтверждения подписка не удаляется:
// ответ ведёт на страницу с открытым подтверждением.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/webhooks/{id}/delete")
Процедура Удаление(Ответ, pool, name, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = Подготовить(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказУдаления(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «pools/{pool}/packages/{name}/settings/webhooks/{id}/test» — пробная отправка: полями окна правки, без
// сохранения, а без полей окна — сохранёнными настройками.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  fragment - Строка - непустое: ответ кусочком для скрипта страницы (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/webhooks/{id}/test")
Процедура ПробнаяОтправка(Ответ, pool, name, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	fragment = "") Экспорт

	Контекст = Подготовить(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПробы(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id, fragment), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «pools/{pool}/packages/{name}/settings/webhooks/test» — пробная отправка полями окна «Новая подписка».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  fragment - Строка - непустое: ответ кусочком для скрипта страницы (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/webhooks/test")
Процедура ПробаЗаведения(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	fragment = "") Экспорт

	ПробнаяОтправка(Ответ, pool, name, "", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, fragment);

КонецПроцедуры

// Точка маршрута «pools/{pool}/packages/{name}/settings/webhooks/preview» — уведомление по полям окна «Новая подписка».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  fragment - Строка - непустое: ответ кусочком для скрипта страницы (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/webhooks/preview")
Процедура ПредпросмотрЗаведения(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	fragment = "") Экспорт

	ПредпросмотрПравки(Ответ, pool, name, "", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, fragment);

КонецПроцедуры

// Точка маршрута «pools/{pool}/packages/{name}/settings/webhooks/{id}/preview» — уведомление по полям окна правки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  fragment - Строка - непустое: ответ кусочком для скрипта страницы (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/webhooks/{id}/preview")
Процедура ПредпросмотрПравки(Ответ, pool, name, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	fragment = "") Экспорт

	Контекст = Подготовить(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПредпросмотра(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id, fragment), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «pools/{pool}/packages/{name}/settings/webhooks/inherited/{id}/narrow» — поправка объекта к подписке сверху:
// окно «Сузить» и «Не присылать сюда».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/webhooks/inherited/{id}/narrow")
Процедура Сужение(Ответ, pool, name, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = Подготовить(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПоправки(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, "сузить", id), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «pools/{pool}/packages/{name}/settings/webhooks/inherited/{id}/reset» — снятие поправки к подписке сверху.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/settings/webhooks/inherited/{id}/reset")
Процедура СнятиеПоправки(Ответ, pool, name, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = Подготовить(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПоправки(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, "снять", id), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбщаяЛогика

Функция Подготовить(Ответ, Знач pool, Знач name, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)
	Вердикт = ГвардПакета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool, name);
	Возврат ?(Вердикт.Разрешено, Вердикт, Неопределено);
КонецФункции

// Чьи это подписки и по какому адресу живёт раздел — всё, что ход о доме знает.
Функция ОписаниеРаздела(Знач Контекст)
	Возврат Ход.ОписаниеРаздела(СервисПодписок.ОбъектПакета(Контекст.Пакет),
		Дом.АдресРаздела(Контекст.Пул.Имя, Контекст.Пакет.Имя, "webhooks"));
КонецФункции

#КонецОбласти

#Область Рендер

// Пустой показ — ход уже ответил сам: отбил форму, не нашёл подписку или увёл редиректом.
Процедура ОтдатьРаздел(Ответ, Знач Контекст, Знач Показ, Знач КукиЗапроса)

	Если Показ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Пул = Контекст.Пул;
	Пакет = Контекст.Пакет;
	Токен = Защита.ТокенСессии(Контекст.Сессия);
	Модель = Ответы.МодельДома(Дом, Пакет.Имя,
		Дом.Разделы(Пул.Имя, Пакет.Имя, "webhooks", Контекст.Пользователь, Пакет),
		Ход.Уведомления(Показ), Секции(Контекст, Показ, Токен), Токен, Дом.Крошки(Пул.Имя, Пакет.Имя));
	Ответы.ОтдатьДом(Ответ, Модель, Контекст, КукиЗапроса, Показ.Статус);

КонецПроцедуры

// Раздел пакета: свои подписки, затем подписки пула и хаба, которые пакет вправе сузить.
Функция Секции(Знач Контекст, Знач Показ, Знач Токен)

	Раздел = ОписаниеРаздела(Контекст);
	МожноМенять = СервисПодписок.МожетУправлять(Контекст.Пользователь, Раздел.Владелец);
	АдресТегов = Дом.АдресРаздела(Контекст.Пул.Имя, Контекст.Пакет.Имя, "tags");

	Результат = Витрина.Секции(Ход.ПараметрыВитрины(Показ, Раздел, Токен,
		Тексты.Текст("subscriptions.package.lead"), МожноМенять, АдресТегов));
	Для Каждого Секция Из ВитринаСверху.Секции(Ход.ПараметрыВитриныСверху(Показ, Раздел, Токен,
		Контекст.Пул.Имя, МожноМенять, АдресТегов)) Цикл
		Результат.Добавить(Секция);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардПакета") _ГвардПакета,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомПакета") _Дом,
	&Пластилин(Значение = "ВитринаПодписок") _Витрина,
	&Пластилин(Значение = "ВитринаПодписокСверху") _ВитринаСверху,
	&Пластилин(Значение = "ХодПодписок") _Ход,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	ГвардПакета = _ГвардПакета;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	ВитринаСверху = _ВитринаСверху;
	Ход = _Ход;
	Защита = _Защита;
	СервисПодписок = _СервисПодписок;
	Тексты = _Тексты;

КонецПроцедуры
