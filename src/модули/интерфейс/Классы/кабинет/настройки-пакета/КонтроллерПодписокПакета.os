#КонецОбласти

#Область Действия

Процедура ВыполнитьДействие(Ответ, Знач pool, Знач name, Знач id, Знач Действие,
	Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)

	Контекст = Подготовить(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Показ = Ход.ПоказПоДействию(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
		МетодЗапроса, ТелоЗапроса, Действие, id);
	ОтдатьРаздел(Ответ, Контекст, Показ, КукиЗапроса);

КонецПроцедуры

Процедура ВыполнитьПредпросмотр(Ответ, Знач pool, Знач name, Знач id, Знач Кусочком,
	Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)

	Контекст = Подготовить(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Показ = Ход.ПоказПредпросмотра(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
		МетодЗапроса, ТелоЗапроса, id, Кусочком);
	ОтдатьРаздел(Ответ, Контекст, Показ, КукиЗапроса);

КонецПроцедуры

Процедура ВыполнитьПробу(Ответ, Знач pool, Знач name, Знач id, Знач Кусочком,
	Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)

	Контекст = Подготовить(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Показ = Ход.ПоказПробы(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
		МетодЗапроса, ТелоЗапроса, id, Кусочком);
	ОтдатьРаздел(Ответ, Контекст, Показ, КукиЗапроса);

КонецПроцедуры

Процедура ВыполнитьПоправку(Ответ, Знач pool, Знач name, Знач id, Знач Действие,
	Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)

	Контекст = Подготовить(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Показ = Ход.ПоказПоПоправке(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
		МетодЗапроса, ТелоЗапроса, Действие, id);
	ОтдатьРаздел(Ответ, Контекст, Показ, КукиЗапроса);

КонецПроцедуры

#КонецОбласти

#Область ОбщаяЛогика

Функция Подготовить(Ответ, Знач pool, Знач name, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)
	Вердикт = ГвардПакета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool, name);
	Возврат ?(Вердикт.Разрешено, Вердикт, Неопределено);
КонецФункции

// Чьи это подписки и по какому адресу живёт раздел — всё, что ход о доме знает.
Функция ОписаниеРаздела(Знач Контекст)
	Возврат Ход.ОписаниеРаздела(СервисПодписок.ОбъектПакета(Контекст.Пакет),
		Дом.АдресРаздела(Контекст.Пул.Имя, Контекст.Пакет.Имя, "webhooks"));
КонецФункции

#КонецОбласти

#Область Рендер

// Пустой показ — ход уже ответил сам: отбил форму, не нашёл подписку или увёл редиректом.
Процедура ОтдатьРаздел(Ответ, Знач Контекст, Знач Показ, Знач КукиЗапроса)

	Если Показ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Пул = Контекст.Пул;
	Пакет = Контекст.Пакет;

	Модель = Ответы.МодельДома(Дом, Пакет.Имя,
		Дом.Разделы(Пул.Имя, Пакет.Имя, "webhooks", Контекст.Пользователь, Пакет),
		Ход.Уведомления(Показ),
		?(Ход.ЭтоПредпросмотр(Показ), Проверка.СекцииПредпросмотра(Показ.Предпросмотр), Секции(Контекст, Показ)),
		Хлебные(Пул, Пакет));

	Ответы.ОтдатьДом(Ответ, Модель, Контекст.Пользователь, КукиЗапроса,
		Тексты.Шаблон("subscriptions.package.tab", Пакет.Имя), Показ.Статус);

КонецПроцедуры

// Раздел пакета: свои подписки, затем подписки пула и хаба, которые пакет вправе сузить.
Функция Секции(Знач Контекст, Знач Показ)

	Раздел = ОписаниеРаздела(Контекст);
	Токен = Защита.ТокенСессии(Контекст.Сессия);
	МожноМенять = СервисПодписок.МожетУправлять(Контекст.Пользователь, Раздел.Владелец);

	Результат = Витрина.Секции(Ход.ПараметрыВитрины(Показ, Раздел, Токен,
		Тексты.Текст("subscriptions.package.lead"), МожноМенять));
	Для Каждого Секция Из ВитринаСверху.Секции(Ход.ПараметрыВитриныСверху(Показ, Раздел, Токен,
		Контекст.Пул.Имя, МожноМенять)) Цикл
		Результат.Добавить(Секция);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Хлебные(Знач Пул, Знач Пакет)

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Подпись, Адрес", Пул.Имя, Страницы.Пула(Пул.Имя)));
	Результат.Добавить(Новый Структура("Подпись, Адрес", Пакет.Имя,
		Страницы.Пакета(Пул.Имя, Пакет.Имя)));
	Результат.Добавить(Новый Структура("Подпись", Тексты.Текст("settings.package.crumb")));
	Возврат Результат;

КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардПакета") _ГвардПакета,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомПакета") _Дом,
	&Пластилин(Значение = "ВитринаПодписок") _Витрина,
	&Пластилин(Значение = "ВитринаПодписокСверху") _ВитринаСверху,
	&Пластилин(Значение = "ХодПодписок") _Ход,
	&Пластилин(Значение = "ПроверкаПодпискиДоСохранения") _Проверка,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы)

	ГвардПакета = _ГвардПакета;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	ВитринаСверху = _ВитринаСверху;
	Ход = _Ход;
	Проверка = _Проверка;
	Защита = _Защита;
	СервисПодписок = _СервисПодписок;
	Тексты = _Тексты;
	Страницы = _Страницы;

КонецПроцедуры
