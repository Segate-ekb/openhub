// Карточка «Первая публикация» — желудь модуля web-ui: шаги пути на экране. Одна и та же
// карточка стоит на проводнике и в кабинете новичка, поэтому живёт отдельно от обоих.

Перем Кит;      // Кит (кит) — фабрика элементов экрана
Перем Путь;     // ПутьПервойПубликации (web-ui) — состояние шагов
Перем Тексты;   // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Карточка шагов по уже посчитанному состоянию пути.
//
// Параметры:
//  Состояние - Структура - состояние пути (ПутьПервойПубликации.Состояние).
//  АдресПроводника - Строка - ход на страницу проводника; пустой кнопку не рисует
//                    (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  ЭлементЭкрана - карточка со списком шагов.
//
Функция Карточка(Знач Состояние, Знач АдресПроводника = "") Экспорт

	Результат = Кит.Карточка(Новый Структура("Заголовок, Описание, Иконка, Действия",
		Тексты.Текст("office.start.title"), Тексты.Текст("office.start.lead"), "стрелка",
		ХодВПроводник(АдресПроводника)));

	Результат.Добавить(Кит.Проводник(Новый Структура("Шаги", Состояние.Шаги)));
	Возврат Результат;

КонецФункции

// Блок кабинета для того, у кого ещё нет ни одного пакета: те же шаги плюс ход
// в проводник, где к ним можно вернуться с любой другой страницы.
//
// Параметры:
//  Пользователь - Пользователь - смотрящий.
//  АдресПроводника - Строка - адрес страницы проводника.
//
// Возвращаемое значение:
//  Строка - разметка блока.
//
Функция Блок(Знач Пользователь, Знач АдресПроводника) Экспорт

	Возврат Карточка(Путь.Состояние(Пользователь), АдресПроводника).Рендер();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проводник знает про opm больше, чем помещается в карточку: на него и уводит кнопка.
// Сам проводник её не рисует — он и есть та страница.
Функция ХодВПроводник(Знач Адрес)

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Иконка",
		Тексты.Текст("office.start.open"), Адрес, "вторичная", "вправо")).Рендер();

КонецФункции

#КонецОбласти

&Прозвище("ВитринаПервойПубликации")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ПутьПервойПубликации") _Путь,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Путь = _Путь;
	Тексты = _Тексты;

КонецПроцедуры
