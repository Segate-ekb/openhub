// Сводка состояния дел на главной кабинета — желудь модуля web-ui: из каких блоков
// собрана страница «/me» и в каком порядке они стоят. Сами блоки печатают свои витрины.

Перем Рендерер;           // РендерерКабинета (web-ui) — заголовок страницы
Перем Рассмотрение;       // РассмотрениеВходящих (публикация) — заявки принципала
Перем ВитринаЗаявок;      // ВитринаЗаявокПула (web-ui) — виджет «входящих»
Перем Лента;              // ЛентаУведомлений (уведомления) — личные события вошедшего
Перем ВитринаЛенты;       // ВитринаУведомлений (web-ui) — виджет ленты
Перем СлужбаКабинета;     // СлужбаКабинета (кабинет) — пакеты в управлении
Перем ВитринаПакетов;     // ВитринаМоихПакетов (web-ui)
Перем ВитринаШагов;       // ВитринаПервойПубликации (web-ui) — блок новичка
Перем ВитринаПространства;// ВитринаМоегоПространства (web-ui)
Перем ВитринаТокенов;     // ВитринаСрокаТокенов (web-ui)
Перем ВитринаЗеркал;      // ВитринаЗеркалМоихПулов (web-ui)
Перем Адреса;             // АдресаКабинета (web-ui) — адреса экранов кабинета
Перем Тексты;             // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Разметка главной кабинета сверху вниз: сначала то, что ждёт решения и прочтения,
// затем то, что вот-вот сломается, и только потом хозяйство — пакеты, место
// и репликация. Блоку, которому нечего сказать, места не отводится: он возвращает
// пустую строку и не печатается.
//
// Параметры:
//  Вердикт - Структура - вердикт гварда кабинета: Пользователь и Принципал.
//
// Возвращаемое значение:
//  Строка - разметка страницы.
//
Функция Разметка(Знач Вердикт) Экспорт

	Пользователь = Вердикт.Пользователь;

	Возврат Приветствие(Пользователь)
		+ ЗаявкиНаРешение(Вердикт)
		+ НепрочитанныеУведомления(Пользователь)
		+ ТокеныНаИсходе(Пользователь)
		+ МоиПакеты(Пользователь)
		+ МоёПространство(Пользователь)
		+ ЗеркалаМоихПулов(Пользователь);

КонецФункции

#КонецОбласти

#Область БлокиСводки

Функция Приветствие(Знач Пользователь)

	Возврат Рендерер.Заголовок(Пользователь.Логин, 1, Тексты.Текст("office.home.lead"));

КонецФункции

// Заявок нет — разметки нет вовсе: блок с нулём означал бы, что рядом что-то происходит.
Функция ЗаявкиНаРешение(Знач Вердикт)

	Возврат ВитринаЗаявок.Виджет(
		Рассмотрение.ОжидающиеПринципала(Вердикт.Принципал), Адреса.Входящие());

КонецФункции

// Непрочитанного нет — виджета нет; лента целиком не читается, спрашиваются единицы строк.
Функция НепрочитанныеУведомления(Знач Пользователь)

	Возврат ВитринаЛенты.Виджет(
		Лента.Свежие(Пользователь, ВитринаЛенты.ПределВиджета()),
		Лента.Непрочитано(Пользователь), Адреса.Уведомления());

КонецФункции

Функция ТокеныНаИсходе(Знач Пользователь)
	Возврат ВитринаТокенов.Блок(Пользователь);
КонецФункции

// Пакетов нет — вместо пустой сетки первые шаги: новичку показывают, что делать.
Функция МоиПакеты(Знач Пользователь)

	Пакеты = СлужбаКабинета.ПакетыВУправлении(Пользователь);
	Если Пакеты.Количество() = 0 Тогда
		Возврат ВитринаШагов.Блок(Пользователь, Адреса.Проводник());
	КонецЕсли;

	Возврат ВитринаПакетов.Блок(Пакеты);

КонецФункции

Функция МоёПространство(Знач Пользователь)
	Возврат ВитринаПространства.Блок(Пользователь);
КонецФункции

Функция ЗеркалаМоихПулов(Знач Пользователь)
	Возврат ВитринаЗеркал.Блок(Пользователь);
КонецФункции

#КонецОбласти

&Прозвище("ВитринаСводкиКабинета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РендерерКабинета") _Рендерер,
	&Пластилин(Значение = "РассмотрениеВходящих") _Рассмотрение,
	&Пластилин(Значение = "ВитринаЗаявокПула") _ВитринаЗаявок,
	&Пластилин(Значение = "ЛентаУведомлений") _Лента,
	&Пластилин(Значение = "ВитринаУведомлений") _ВитринаЛенты,
	&Пластилин(Значение = "СлужбаКабинета") _СлужбаКабинета,
	&Пластилин(Значение = "ВитринаМоихПакетов") _ВитринаПакетов,
	&Пластилин(Значение = "ВитринаПервойПубликации") _ВитринаШагов,
	&Пластилин(Значение = "ВитринаМоегоПространства") _ВитринаПространства,
	&Пластилин(Значение = "ВитринаСрокаТокенов") _ВитринаТокенов,
	&Пластилин(Значение = "ВитринаЗеркалМоихПулов") _ВитринаЗеркал,
	&Пластилин(Значение = "АдресаКабинета") _Адреса,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Рендерер = _Рендерер;
	Рассмотрение = _Рассмотрение;
	ВитринаЗаявок = _ВитринаЗаявок;
	Лента = _Лента;
	ВитринаЛенты = _ВитринаЛенты;
	СлужбаКабинета = _СлужбаКабинета;
	ВитринаПакетов = _ВитринаПакетов;
	ВитринаШагов = _ВитринаШагов;
	ВитринаПространства = _ВитринаПространства;
	ВитринаТокенов = _ВитринаТокенов;
	ВитринаЗеркал = _ВитринаЗеркал;
	Адреса = _Адреса;
	Тексты = _Тексты;

КонецПроцедуры
