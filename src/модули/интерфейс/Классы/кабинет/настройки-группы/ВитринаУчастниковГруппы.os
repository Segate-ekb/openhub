// Раздел «Участники» дома «Группа»: состав таблицей с меню ⚙ строки и страницами, окно «Добавить
// участника» с подбором кандидатов поиском на странице, подтверждение «Убрать из группы» — по адресу.

Перем Кит;                  // Кит (кит) — фабрика элементов экрана
Перем СервисГрупп;          // СервисГрупп (права) — состав группы
Перем СервисПользователей;  // СервисПользователей (вход) — логины участников одним разрезом
Перем СервисСопоставлений;  // СервисСопоставленийГрупп (права) — время сверки с клеймами
Перем СписокУчёток;         // СписокУчёток (вход) — кандидаты в участники с отбором по подстроке
Перем Окна;                 // ОкноРаздела — окно по адресу и его состояние
Перем Поля;                 // ПультДомаГруппы — имена полей окон
Перем Тексты;               // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Даты;                 // ДатаЧеловеку — одно написание момента на весь интерфейс

#Область ПубличныйИнтерфейс

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<логин>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат "новый,убрать";
КонецФункции

// Сколько участников на странице состава.
//
// Возвращаемое значение:
//  Число.
//
Функция РазмерСтраницы() Экспорт
	Возврат 20;
КонецФункции

// Секции раздела «Участники».
//
// Параметры:
//  Параметры - Структура:
//    * Группа - Группа - группа;
//    * Адрес - Строка - адрес раздела;
//    * МожетПравить - Булево - вправе ли смотрящий менять состав;
//    * Запрос - Строка - подстрока подбора кандидатов в окне «Добавить участника»;
//    * Страница - Число - номер страницы состава;
//    * Окно - Структура, Неопределено - состояние открытого окна (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - одна секция: состав, страницы и окна.
//
Функция Секции(Знач Параметры) Экспорт

	Группа = Параметры.Группа;
	Адрес = Параметры.Адрес;
	МожетПравить = (Параметры.МожетПравить = Истина);
	Состояние = Параметры.Окно;

	Состав = СервисГрупп.СоставГруппы(Группа.Идентификатор);
	Страница = Страница(Состав, Параметры.Страница);
	ОкноДобавления = ?(МожетПравить, ОкноДобавления(Состав, Адрес, Параметры.Запрос, Состояние), Неопределено);

	Секция = Кит.Секция(Тексты.Текст("settings.group.members.title"),
			ТаблицаСостава(НазванныйСостав(Страница.Записи), Адрес, МожетПравить),
			Кит.Пагинация(Адрес, Страница.Номер).Всего(Состав.Количество()).НаСтранице(РазмерСтраницы())
				.БезПерезагрузки(),
			Кит.Примечание(Тексты.Шаблон("settings.group.members.synced", ВремяСинхронизации(Группа))),
			ОкноДобавления,
			?(МожетПравить, ОкноУдаления(Состав, Состояние, Адрес), Неопределено))
		.Лид(Тексты.Текст("settings.group.members.lead")).Иконка("аккаунт");
	Если МожетПравить Тогда
		Секция.Действия(Кит.Кнопка(Тексты.Текст("settings.group.member-new.title")).Основная().Иконка("плюс")
			.Открывает(ОкноДобавления));
	КонецЕсли;

	Результат = Новый Массив();
	Результат.Добавить(Секция);
	Возврат Результат;

КонецФункции

// Напечатает ли раздел окно, которое называет состояние: окно добавления — всегда, подтверждение —
// когда учётка с таким логином в группе есть.
//
// Параметры:
//  Группа - Группа - группа.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Группа, Знач Состояние) Экспорт
	Возврат Окна.Открыто(Состояние, "новый")
		ИЛИ УчастникОкна(СервисГрупп.СоставГруппы(Группа.Идентификатор), Состояние) <> Неопределено;
КонецФункции

#КонецОбласти

#Область Состав

// На узком экране — карточки с логином заглавием и ⚙ в углу; откуда членство — словами.
Функция ТаблицаСостава(Знач Участники, Знач Адрес, Знач МожетПравить)

	Строки = Новый Массив();
	Для Каждого Участник Из Участники Цикл
		Строки.Добавить(Новый Структура("login, source, actions",
			Участник.Логин, ИсточникЧленства(Участник.Источник),
			?(МожетПравить, Меню(Участник, Адрес), Неопределено)));
	КонецЦикла;

	Таблица = Кит.Таблица(Строки).Вид("карточками").Пустое("—")
		.Пусто(Тексты.Текст("settings.group.members.empty"));
	Таблица.Колонка("login", Тексты.Текст("settings.group.members.col.login")).Заглавная();
	Таблица.Колонка("source", Тексты.Текст("settings.group.members.col.source"));
	Таблица.Колонка("actions", "").Вид("узкая").БезПодписиВЗаписи()
		.Пустое("").Когда(МожетПравить);
	Возврат Таблица;

КонецФункции

Функция Меню(Знач Участник, Знач Адрес)

	Возврат Кит.Меню(Тексты.Шаблон("settings.group.members.menu", Участник.Логин),
		Кит.ОкноПоАдресу(Окна.Адрес(Адрес, "убрать", Участник.Логин),
			Тексты.Текст("settings.group.members.button.remove")).Опасная().Иконка("выход"));

КонецФункции

// «Вручную» — членство, заведённое человеком; «провайдер» — пришедшее с клеймом при входе.
Функция ИсточникЧленства(Знач Источник)

	Если ЭтоИзПровайдера(Источник) Тогда
		Возврат Кит.Плашка(Тексты.Текст("settings.group.members.source.oidc")).Вид("accent");
	КонецЕсли;
	Возврат Кит.Плашка(Тексты.Текст("settings.group.members.source.local"));

КонецФункции

// Логины страницы состава одним разрезом; учётка, снесённая мимо членства, — номером.
Функция НазванныйСостав(Знач Состав)

	Учётки = СервисПользователей.ПоИдентификаторам(НомераУчастников(Состав));

	Результат = Новый Массив();
	Для Каждого Членство Из Состав Цикл
		Номер = Цел(Членство.ПользовательИдентификатор);
		Учётка = Учётки.Получить(Номер);
		Результат.Добавить(Новый Структура("Логин, Источник",
			?(Учётка = Неопределено, "#" + Тексты.ЧислоТекстом(Номер), Строка(Учётка.Логин)),
			Членство.Источник));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Страница состава: номер за концом — последняя, мусорный — первая.
Функция Страница(Знач Состав, Знач Номер)

	Размер = РазмерСтраницы();
	Последняя = Макс(1, Цел((Состав.Количество() + Размер - 1) / Размер));
	Номер = Мин(Макс(1, Номер), Последняя);

	Записи = Новый Массив();
	Для Индекс = (Номер - 1) * Размер По Мин(Номер * Размер, Состав.Количество()) - 1 Цикл
		Записи.Добавить(Состав[Индекс]);
	КонецЦикла;
	Возврат Новый Структура("Записи, Номер", Записи, Номер);

КонецФункции

// Человекочитаемое время последней сверки состава с клеймами.
Функция ВремяСинхронизации(Знач Группа)
	Момент = СервисСопоставлений.СинхронизированаВ(Группа.Идентификатор);
	Возврат ?(Момент = Неопределено, Тексты.Текст("settings.group.policy.never"), Даты.ДатаВремя(Момент));
КонецФункции

#КонецОбласти

#Область Окна

// Сколько кандидатов показывать за раз: список остаётся пригодным и на сотнях учёток.
Функция ПределКандидатов()
	Возврат 20;
КонецФункции

// Окно «Добавить участника»: поиск кандидатов — своей формой GET, выбор — выпадающим списком
// формы окна; окно на странице всегда, открытым — по адресу, после поиска и с отбитой формой.
Функция ОкноДобавления(Знач Состав, Знач Адрес, Знач Запрос, Знач Состояние)

	Якорь = "uchastnik-novyi";
	ЯкорьФормы = "uchastnik-novyi-forma";
	Запрос = СокрЛП(Строка(Запрос));
	Кандидаты = СписокУчёток.ОтобранныеВнеСостава(Запрос, НомераУчастников(Состав));
	Показано = Мин(Кандидаты.Количество(), ПределКандидатов());
	Открыто = Окна.Открыто(Состояние, "новый") ИЛИ ЗначениеЗаполнено(Запрос);

	Возврат Кит.Окно(Тексты.Текст("settings.group.member-new.title"),
			Кит.СтрокаПоиска(Адрес).Метка(Тексты.Текст("settings.group.member-new.filter.label"))
				.Значение(Запрос).Пример(Тексты.Текст("settings.group.member-new.filter.placeholder"))
				.СкрытоеПоле(Окна.ИмяПараметра(), "новый"),
			Кит.Форма("", ВыборУчётки(Кандидаты, Показано, Запрос, Состояние)).Якорь(ЯкорьФормы)
				.БезПерезагрузки(),
			УсечениеКандидатов(Кандидаты.Количество(), Показано))
		.Лид(Тексты.Текст("settings.group.member-new.lead"))
		.Адрес(Окна.Адрес(Адрес, "новый")).Якорь(Якорь)
		.Открыто(Открыто).АдресЗакрытия(Адрес)
		.Действия(Кит.Кнопка(Тексты.Текст("settings.group.member-new.button")).Основная().Иконка("плюс")
			.ВФорме(ЯкорьФормы).Заблокирована(Показано = 0));

КонецФункции

// Кандидатов нет — словами, а не пустым списком.
Функция ВыборУчётки(Знач Кандидаты, Знач Показано, Знач Запрос, Знач Состояние)

	Если Показано = 0 Тогда
		Возврат Кит.Примечание(?(ЗначениеЗаполнено(Запрос),
			Тексты.Шаблон("settings.group.member-new.notfound", Запрос),
			Тексты.Текст("settings.group.member-new.empty")));
	КонецЕсли;

	Выбранная = Окна.Значение(Состояние, Поля.ИмяПоляЛогина());
	Поле = Кит.Поле(Поля.ИмяПоляЛогина(), Тексты.Текст("settings.group.member-new.login")).Обязательное()
		.Вариант("", Тексты.Текст("settings.group.member-new.choose"))
		.Значение(Выбранная)
		.Ошибка(Окна.Отказ(Состояние, Поля.ИмяПоляЛогина()));
	Для Позиция = 0 По Показано - 1 Цикл
		Кандидат = Кандидаты[Позиция];
		Поле.Вариант(Строка(Кандидат.Логин), ПодписьКандидата(Кандидат));
	КонецЦикла;
	Возврат Поле;

КонецФункции

Функция ПодписьКандидата(Знач Кандидат)
	Если ЗначениеЗаполнено(Кандидат.Email) Тогда
		Возврат Тексты.Шаблон("settings.group.member-new.option", Кандидат.Логин, Кандидат.Email);
	КонецЕсли;
	Возврат Строка(Кандидат.Логин);
КонецФункции

// Честная строка «показаны не все»: молчаливое усечение выглядит как «таких больше нет».
Функция УсечениеКандидатов(Знач Всего, Знач Показано)

	Если Всего <= Показано Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Примечание(Тексты.Шаблон("settings.group.member-new.truncated",
		Тексты.ЧислоТекстом(Показано), Тексты.ЧислоТекстом(Всего)));

КонецФункции

// Подтверждение «Убрать из группы», названное адресом. Членство из клейма вернётся при входе,
// если клейм остался, — подтверждение говорит это прямо.
Функция ОкноУдаления(Знач Состав, Знач Состояние, Знач Адрес)

	Участник = УчастникОкна(Состав, Состояние);
	Если Участник = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Последствия = ?(ЭтоИзПровайдера(Участник.Источник),
		Тексты.Текст("settings.group.members.remove.oidc"),
		Тексты.Текст("settings.group.members.remove.consequence"));
	Возврат Кит.Подтверждение(Тексты.Шаблон("settings.group.members.remove.title", Участник.Логин),
			Последствия, ОшибкаОкна(Состояние))
		.Кнопка(Тексты.Текст("settings.group.members.button.remove"))
		.Форма(КодироватьСтроку(Участник.Логин, СпособКодированияСтроки.КодировкаURL) + "/delete")
		.БезПерезагрузки().Якорь("uchastnik-ubrat").Открыто().АдресЗакрытия(Адрес);

КонецФункции

// Участник, названный адресом окна: логина нет в составе — окна нет.
Функция УчастникОкна(Знач Состав, Знач Состояние)

	Если НЕ Окна.Открыто(Состояние, "убрать") ИЛИ НЕ ЗначениеЗаполнено(Состояние.Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Участник Из НазванныйСостав(Состав) Цикл
		Если НРег(Участник.Логин) = НРег(Состояние.Ключ) Тогда
			Возврат Участник;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Отказ, который не относится к одному полю, — над полями.
Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоИзПровайдера(Знач Источник)
	Возврат НРег(Строка(Источник)) = "oidc";
КонецФункции

// Идентификаторы учёток состава группы.
Функция НомераУчастников(Знач Состав)

	Результат = Новый Массив();
	Для Каждого Членство Из Состав Цикл
		Результат.Добавить(Цел(Членство.ПользовательИдентификатор));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаУчастниковГруппы")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "СервисСопоставленийГрупп") _СервисСопоставлений,
	&Пластилин(Значение = "СписокУчёток") _СписокУчёток,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ПультДомаГруппы") _Поля,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено) Экспорт

	Кит = _Кит;
	СервисГрупп = _СервисГрупп;
	СервисПользователей = _СервисПользователей;
	СервисСопоставлений = _СервисСопоставлений;
	СписокУчёток = _СписокУчёток;
	Окна = _Окна;
	Поля = _Поля;
	Тексты = _Тексты;
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);

КонецПроцедуры
