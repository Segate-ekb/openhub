// Раздел «Связка с OIDC» дома «Группа»: сопоставления клеймов провайдера таблицей с меню ⚙ строки,
// окно «Добавить сопоставление» на странице, подтверждение удаления по адресу; политика выпавших —
// тумблером «сохранять сразу», последняя сверка — свойством.

Перем Кит;                  // Кит (кит) — фабрика элементов экрана
Перем СервисСопоставлений;  // СервисСопоставленийГрупп (права) — политика и время сверки
Перем Пульт;                // ПультДомаГруппы — сопоставления группы и имена полей окон
Перем Окна;                 // ОкноРаздела — окно по адресу и его состояние
Перем Тексты;               // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Даты;                 // ДатаЧеловеку — одно написание момента на весь интерфейс

#Область ПубличныйИнтерфейс

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<номер сопоставления>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат "новый,удалить";
КонецФункции

// Секции раздела «Связка с OIDC».
//
// Параметры:
//  Параметры - Структура:
//    * Группа - Группа - группа;
//    * Адрес - Строка - адрес раздела;
//    * МожетПравить - Булево - вправе ли смотрящий менять связку;
//    * Окно - Структура, Неопределено - состояние открытого окна (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - сопоставления и политика выпавших.
//
Функция Секции(Знач Параметры) Экспорт

	Результат = Новый Массив();
	Результат.Добавить(СекцияСопоставлений(Параметры));
	Результат.Добавить(СекцияПолитики(Параметры.Группа, Параметры.МожетПравить = Истина));
	Возврат Результат;

КонецФункции

// Напечатает ли раздел окно, которое называет состояние: окно нового сопоставления — всегда,
// подтверждение удаления — когда у группы есть сопоставление с таким номером.
//
// Параметры:
//  Группа - Группа - группа.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Группа, Знач Состояние) Экспорт
	Возврат Окна.Открыто(Состояние, "новый") ИЛИ СопоставлениеОкна(Группа, Состояние) <> Неопределено;
КонецФункции

#КонецОбласти

#Область Сопоставления

Функция СекцияСопоставлений(Знач Параметры)

	Группа = Параметры.Группа;
	Адрес = Параметры.Адрес;
	МожетПравить = (Параметры.МожетПравить = Истина);
	Состояние = Параметры.Окно;
	ОкноНового = ?(МожетПравить, ОкноНового(Адрес, Состояние), Неопределено);

	Секция = Кит.Секция(Тексты.Текст("settings.group.oidc.title"),
			Таблица(Пульт.СопоставленияГруппы(Группа), Адрес, МожетПравить),
			ОкноНового,
			?(МожетПравить, ОкноУдаления(Группа, Состояние, Адрес), Неопределено))
		.Лид(Тексты.Текст("settings.group.oidc.lead")).Иконка("ссылка");
	Если МожетПравить Тогда
		Секция.Действия(Кит.Кнопка(Тексты.Текст("settings.group.mapping-new.title")).Основная().Иконка("плюс")
			.Открывает(ОкноНового));
	КонецЕсли;
	Возврат Секция;

КонецФункции

// На узком экране — карточки со значением клейма заглавием и ⚙ в углу.
Функция Таблица(Знач Сопоставления, Знач Адрес, Знач МожетПравить)

	Строки = Новый Массив();
	Для Каждого Сопоставление Из Сопоставления Цикл
		Строки.Добавить(Новый Структура("value, claim, issuer, actions",
			Кит.Код(Строка(Сопоставление.Значение)), Строка(Сопоставление.ИмяКлейма),
			Кит.Код(Строка(Сопоставление.Издатель)),
			?(МожетПравить, Меню(Сопоставление, Адрес), Неопределено)));
	КонецЦикла;

	Таблица = Кит.Таблица(Строки).Вид("карточками").Пустое("—").Пусто(Тексты.Текст("settings.group.oidc.empty"));
	Таблица.Колонка("value", Тексты.Текст("settings.group.oidc.col.value")).Заглавная();
	Таблица.Колонка("claim", Тексты.Текст("settings.group.oidc.col.claim"));
	Таблица.Колонка("issuer", Тексты.Текст("settings.group.oidc.col.issuer"));
	Таблица.Колонка("actions", "").Вид("узкая").БезПодписиВЗаписи()
		.Пустое("").Когда(МожетПравить);
	Возврат Таблица;

КонецФункции

Функция Меню(Знач Сопоставление, Знач Адрес)

	Возврат Кит.Меню(Тексты.Шаблон("settings.group.oidc.menu", Сопоставление.Значение),
		Кит.ОкноПоАдресу(Окна.Адрес(Адрес, "удалить", Номер(Сопоставление)),
			Тексты.Текст("settings.group.oidc.button.remove")).Опасная().Иконка("корзина"));

КонецФункции

// Окно «Добавить сопоставление»: издатель, клейм и значение, отказ — под полем.
Функция ОкноНового(Знач Адрес, Знач Состояние)

	Якорь = "sopostavlenie-novoe";
	Открыто = Окна.Открыто(Состояние, "новый");
	Возврат Кит.Окно(Тексты.Текст("settings.group.mapping-new.title"),
			ОшибкаОкна(Состояние),
			Кит.Поле(Пульт.ИмяПоляИздателя(), Тексты.Текст("settings.group.mapping-new.issuer.label"))
				.ТипЗначения("url").Обязательное().Пример("https://idp.example.com")
				.Значение(Окна.Значение(Состояние, Пульт.ИмяПоляИздателя()))
				.Подсказка(Тексты.Текст("settings.group.mapping-new.issuer.hint"))
				.Ошибка(Окна.Отказ(Состояние, Пульт.ИмяПоляИздателя())),
			Кит.Поле(Пульт.ИмяПоляКлейма(), Тексты.Текст("settings.group.mapping-new.claim.label"))
				.Значение(Окна.Значение(Состояние, Пульт.ИмяПоляКлейма(), "groups"))
				.Подсказка(Тексты.Текст("settings.group.mapping-new.claim.hint"))
				.Ошибка(Окна.Отказ(Состояние, Пульт.ИмяПоляКлейма())),
			Кит.Поле(Пульт.ИмяПоляЗначения(), Тексты.Текст("settings.group.mapping-new.value.label"))
				.Обязательное().Пример("platform-team")
				.Значение(Окна.Значение(Состояние, Пульт.ИмяПоляЗначения()))
				.Ошибка(Окна.Отказ(Состояние, Пульт.ИмяПоляЗначения())))
		.Лид(Тексты.Текст("settings.group.oidc.note"))
		.Форма("").БезПерезагрузки().Якорь(Якорь).Адрес(Окна.Адрес(Адрес, "новый"))
		.Открыто(Открыто).АдресЗакрытия(Адрес)
		.Действия(Кит.Кнопка(Тексты.Текст("settings.group.mapping-new.button")).Основная().Иконка("плюс"));

КонецФункции

// Подтверждение удаления, названное адресом. Сопоставления с таким номером у группы нет — окна нет.
Функция ОкноУдаления(Знач Группа, Знач Состояние, Знач Адрес)

	Сопоставление = СопоставлениеОкна(Группа, Состояние);
	Если Сопоставление = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Подтверждение(Тексты.Шаблон("settings.group.oidc.delete.title", Сопоставление.Значение),
			Тексты.Шаблон("settings.group.oidc.delete.consequence", Сопоставление.ИмяКлейма,
				Сопоставление.Значение),
			ОшибкаОкна(Состояние))
		.Кнопка(Тексты.Текст("settings.group.oidc.button.remove"))
		.Форма(Номер(Сопоставление) + "/delete").БезПерезагрузки().Якорь("sopostavlenie-udalit").Открыто()
		.АдресЗакрытия(Адрес);

КонецФункции

Функция СопоставлениеОкна(Знач Группа, Знач Состояние)

	Если НЕ Окна.Открыто(Состояние, "удалить") ИЛИ НЕ ЗначениеЗаполнено(Состояние.Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Пульт.СопоставлениеГруппы(Группа, Состояние.Ключ);

КонецФункции

#КонецОбласти

#Область Политика

// Тумблер сохраняется сразу, без скрипта форму отправляет запасная кнопка кита; без права правки
// тумблер заблокирован.
Функция СекцияПолитики(Знач Группа, Знач МожетПравить)

	Оставлять = СервисСопоставлений.ПолитикаВыпавших(Группа.Идентификатор)
		= СервисСопоставлений.ПолитикаОставлять();
	Подпись = Тексты.Текст("settings.group.policy.label");

	Если МожетПравить Тогда
		Политика = Кит.Форма("policy",
				Кит.Тумблер(Пульт.ИмяПоляПолитики(), Подпись).Включено(Оставлять)
					.Значения(СервисСопоставлений.ПолитикаОставлять(), СервисСопоставлений.ПолитикаИсключать())
					.Подписи(Тексты.Текст("settings.group.policy.on"), Тексты.Текст("settings.group.policy.off"))
					.Подсказка(Тексты.Текст("settings.group.policy.hint")).СохранятьСразу())
			.БезПерезагрузки();
	Иначе
		Политика = Кит.Тумблер("", Подпись).Включено(Оставлять)
			.Подписи(Тексты.Текст("settings.group.policy.on"), Тексты.Текст("settings.group.policy.off"))
			.Подсказка(Тексты.Текст("settings.group.policy.hint")).Заблокировано();
	КонецЕсли;

	Возврат Кит.Секция(Тексты.Текст("settings.group.policy.title"),
			Политика,
			Кит.Свойства(Кит.Свойство(Тексты.Текст("settings.group.policy.synced.label"),
				Кит.Текст(ВремяСинхронизации(Группа)))))
		.Лид(Тексты.Текст("settings.group.policy.lead")).Иконка("история");

КонецФункции

// Человекочитаемое время последней сверки состава с клеймами.
Функция ВремяСинхронизации(Знач Группа)
	Момент = СервисСопоставлений.СинхронизированаВ(Группа.Идентификатор);
	Возврат ?(Момент = Неопределено, Тексты.Текст("settings.group.policy.never"), Даты.ДатаВремя(Момент));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Номер(Знач Сопоставление)
	Возврат Формат(Сопоставление.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

// Отказ, который не относится к одному полю, — над полями.
Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

#КонецОбласти

&Прозвище("ВитринаСвязкиГруппы")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисСопоставленийГрупп") _СервисСопоставлений,
	&Пластилин(Значение = "ПультДомаГруппы") _Пульт,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено) Экспорт

	Кит = _Кит;
	СервисСопоставлений = _СервисСопоставлений;
	Пульт = _Пульт;
	Окна = _Окна;
	Тексты = _Тексты;
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);

КонецПроцедуры
