// Дом настроек «Группа» (/groups/{группа}/settings): участники, сопоставления OIDC и права группы.
// Разделы «Участники» и «Связка с OIDC» — экраны списка: литерал раздела, окна по адресу ?окно=…,
// формы окон и записей на своих адресах; удача — 303 на раздел, отказ — та же страница с окном.

Перем ГвардГруппы;
Перем Ответы;             // ОтветыНастроек
Перем Дом;                // ДомГруппы
Перем ВитринаУчастников;  // ВитринаУчастниковГруппы — состав и окно подбора
Перем ВитринаСвязки;      // ВитринаСвязкиГруппы — сопоставления и политика выпавших
Перем ВитринаПрав;        // ВитринаПравГруппы — права группы по объектам
Перем Пульт;              // ПультДомаГруппы — операции разделов
Перем Защита;             // ЗащитаCSRF (вход)
Перем Окна;               // ОкноРаздела — окно по адресу и ответы форм окон
Перем Тексты;             // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Числа;              // ПриведениеЧисел (основа) — номер страницы из адреса

#Область ТочкиМаршрута

// GET /groups/{группа}/settings — раздел дома по умолчанию.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  группа - Строка - имя группы из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//
&ТочкаМаршрута("{группа}/settings")
Процедура Обзор(Ответ, группа, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Вердикт = ГвардГруппы.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, группа);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	ОтдатьРаздел(Ответ, Запрос(Вердикт, КукиЗапроса, Дом.РазделПоУмолчанию()), 200);

КонецПроцедуры

// GET /groups/{группа}/settings/{раздел} — раздел дома без своих форм (права группы).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  группа - Строка - имя группы из адреса.
//  раздел - Строка - ключ раздела.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//
&ТочкаМаршрута("{группа}/settings/{раздел}")
Процедура Раздел(Ответ, группа, раздел, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Вердикт = ГвардГруппы.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, группа);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Ключ = НРег(СокрЛП(Строка(раздел)));
	Если НЕ Дом.ЕстьРаздел(Ключ) Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт, Тексты.Текст("settings.group.error.section"),
			КукиЗапроса);
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	ОтдатьРаздел(Ответ, Запрос(Вердикт, КукиЗапроса, Ключ), 200);

КонецПроцедуры

// GET /groups/{группа}/settings/members — состав группы; POST — форма окна «Добавить участника».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  группа - Строка - имя группы из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  q - Строка - подстрока подбора кандидатов в окне добавления (необязательный, по умолчанию "").
//  page - Строка - номер страницы состава (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: <вид>-<логин> (необязательный, по умолчанию "").
//
&ТочкаМаршрута("{группа}/settings/members")
Процедура Участники(Ответ, группа, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	saved = "", q = "", page = "", окно = "") Экспорт

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Вердикт = ГвардГруппы.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, группа);
		Если НЕ Вердикт.Разрешено Тогда
			Возврат;
		КонецЕсли;
		Запрос = Запрос(Вердикт, КукиЗапроса, "members", q, page);
		ОтдатьРаздел(Ответ, Запрос, 200, Окна.ИзАдреса(окно, ВитринаУчастников.ВидыОкон()), ЗначениеЗаполнено(saved));
		Возврат;
	КонецЕсли;

	Мутация = Мутация(Ответ, группа, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, "members");
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Завершить(Ответ, Мутация.Запрос, Пульт.ДобавитьУчастника(Мутация.Запрос.Вердикт.Группа, Мутация.Форма));

КонецПроцедуры

// POST /groups/{группа}/settings/members/{логин}/delete — убрать участника. Без поля подтверждения
// участник не убирается: ответ ведёт на страницу с открытым подтверждением.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  группа - Строка - имя группы из адреса.
//  логин - Строка - логин участника.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{группа}/settings/members/{логин}/delete")
Процедура УдалениеУчастника(Ответ, группа, логин, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, группа, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, "members", "POST");
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Окна.Подтверждено(Мутация.Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресРаздела(Мутация.Запрос), логин, "убрать");
		Возврат;
	КонецЕсли;
	Завершить(Ответ, Мутация.Запрос, Пульт.УбратьУчастника(Мутация.Запрос.Вердикт.Группа, логин));

КонецПроцедуры

// GET /groups/{группа}/settings/oidc — сопоставления и политика; POST — форма окна «Добавить
// сопоставление».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  группа - Строка - имя группы из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: <вид>-<номер> (необязательный, по умолчанию "").
//
&ТочкаМаршрута("{группа}/settings/oidc")
Процедура Связка(Ответ, группа, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	saved = "", окно = "") Экспорт

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Вердикт = ГвардГруппы.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, группа);
		Если НЕ Вердикт.Разрешено Тогда
			Возврат;
		КонецЕсли;
		ОтдатьРаздел(Ответ, Запрос(Вердикт, КукиЗапроса, "oidc"), 200,
			Окна.ИзАдреса(окно, ВитринаСвязки.ВидыОкон()), ЗначениеЗаполнено(saved));
		Возврат;
	КонецЕсли;

	Мутация = Мутация(Ответ, группа, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, "oidc");
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Завершить(Ответ, Мутация.Запрос, Пульт.ДобавитьСопоставление(Мутация.Запрос.Вердикт.Группа, Мутация.Форма));

КонецПроцедуры

// POST /groups/{группа}/settings/oidc/{номер}/delete — удалить сопоставление. Без поля
// подтверждения — страница с открытым подтверждением.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  группа - Строка - имя группы из адреса.
//  номер - Строка - номер сопоставления.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{группа}/settings/oidc/{номер}/delete")
Процедура УдалениеСопоставления(Ответ, группа, номер, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, группа, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, "oidc", "POST");
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Окна.Подтверждено(Мутация.Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресРаздела(Мутация.Запрос), номер);
		Возврат;
	КонецЕсли;
	Завершить(Ответ, Мутация.Запрос, Пульт.УдалитьСопоставление(Мутация.Запрос.Вердикт.Группа, номер));

КонецПроцедуры

// POST /groups/{группа}/settings/oidc/policy — тумблер политики выпавших из клейма.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  группа - Строка - имя группы из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{группа}/settings/oidc/policy")
Процедура Политика(Ответ, группа, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, группа, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, "oidc", "POST");
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Завершить(Ответ, Мутация.Запрос, Пульт.ЗадатьПолитику(Мутация.Запрос.Вердикт.Группа, Мутация.Форма));

КонецПроцедуры

#КонецОбласти

#Область Действия

// Пролог мутации: гвард правки → только POST → форма с принятым токеном → форма не старой вкладки.
Функция Мутация(Ответ, Знач группа, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса,
	Знач ТелоЗапроса, Знач Ключ, Знач Разрешённые = "GET, POST")

	Вердикт = ГвардГруппы.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, группа, Истина);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, Разрешённые, Вердикт, КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Запрос(Вердикт, КукиЗапроса, Ключ);
	// форма старой вкладки несла операцию в теле: нынешние двери её не знают, ничего не меняется
	Устаревшая = Пульт.ОтказСтаройВкладки(Форма);
	Если Устаревшая <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Запрос, Устаревшая.Код, Неопределено, Ложь, Устаревшая.Сообщение);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Запрос, Форма", Запрос, Форма);

КонецФункции

// Исход пульта (см. ИсходОкна) → ответ: удача — 303 на раздел; отказ — страница с окном этой
// формы, открытым на набранном и отказах; окна нет (запись уже удалили, тумблер) — над разделом.
Процедура Завершить(Ответ, Знач Запрос, Знач Исход)

	Если Исход.Успех Тогда
		Окна.ВернутьВРаздел(Ответ, АдресРаздела(Запрос));
		Возврат;
	КонецЕсли;

	Если Исход.Окно <> Неопределено И ЕстьОкно(Запрос, Исход.Окно) Тогда
		ОтдатьРаздел(Ответ, Запрос, Исход.Код, Исход.Окно);
		Возврат;
	КонецЕсли;
	ОтдатьРаздел(Ответ, Запрос, Исход.Код, Неопределено, Ложь, Исход.Сообщение);

КонецПроцедуры

Функция ЕстьОкно(Знач Запрос, Знач Окно)
	Если Запрос.Ключ = "members" Тогда
		Возврат ВитринаУчастников.ЕстьОкно(Запрос.Вердикт.Группа, Окно);
	КонецЕсли;
	Возврат ВитринаСвязки.ЕстьОкно(Запрос.Вердикт.Группа, Окно);
КонецФункции

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Запрос, Знач Статус, Знач Окно = Неопределено, Знач Сохранено = Ложь,
	Знач Ошибка = "")

	Вердикт = Запрос.Вердикт;
	Группа = Вердикт.Группа;

	Уведомления = Ответы.УведомленияРаздела(Сохранено, Ошибка);
	Если НЕ Вердикт.МожетПравить Тогда
		Уведомления.Добавить(Ответы.Уведомление(Тексты.Текст("settings.group.readonly"), "info"));
	КонецЕсли;

	Хлебные = Новый Массив();
	Хлебные.Добавить(Новый Структура("Подпись", Тексты.Текст("settings.group.crumb")));
	Хлебные.Добавить(Новый Структура("Подпись", Группа.Имя));

	Модель = Ответы.МодельДома(Дом, Группа.Имя,
		Дом.Разделы(Группа.Имя, Запрос.Ключ),
		Уведомления,
		Секции(Запрос, Окно),
		Защита.ТокенСессии(Вердикт.Сессия),
		Хлебные);

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт, Запрос.Куки, Статус);

КонецПроцедуры

Функция Секции(Знач Запрос, Знач Окно)

	Вердикт = Запрос.Вердикт;
	Группа = Вердикт.Группа;

	Если Запрос.Ключ = "members" Тогда
		Возврат ВитринаУчастников.Секции(Новый Структура("Группа, Адрес, МожетПравить, Запрос, Страница, Окно",
			Группа, АдресРаздела(Запрос), Вердикт.МожетПравить, Запрос.Подбор, Запрос.Страница, Окно));
	ИначеЕсли Запрос.Ключ = "oidc" Тогда
		Возврат ВитринаСвязки.Секции(Новый Структура("Группа, Адрес, МожетПравить, Окно",
			Группа, АдресРаздела(Запрос), Вердикт.МожетПравить, Окно));
	КонецЕсли;

	Результат = Новый Массив();
	Результат.Добавить(ВитринаПрав.Секция(Новый Структура("Группа, Пользователь, Принципал",
		Группа, Вердикт.Пользователь, Вердикт.Принципал)));
	Возврат Результат;

КонецФункции

Функция Запрос(Знач Вердикт, Знач КукиЗапроса, Знач Ключ, Знач Подбор = "", Знач Страница = "")
	Возврат Новый Структура("Вердикт, Куки, Ключ, Подбор, Страница", Вердикт, КукиЗапроса, Ключ,
		СокрЛП(Строка(Подбор)), Макс(1, Числа.ЧислоИлиНоль(Страница)));
КонецФункции

Функция АдресРаздела(Знач Запрос)
	Возврат Дом.АдресРаздела(Запрос.Вердикт.Группа.Имя, Запрос.Ключ);
КонецФункции

#КонецОбласти

&Контроллер("/groups")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардГруппы") _ГвардГруппы,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомГруппы") _Дом,
	&Пластилин(Значение = "ВитринаУчастниковГруппы") _ВитринаУчастников,
	&Пластилин(Значение = "ВитринаСвязкиГруппы") _ВитринаСвязки,
	&Пластилин(Значение = "ВитринаПравГруппы") _ВитринаПрав,
	&Пластилин(Значение = "ПультДомаГруппы") _Пульт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа)

	ГвардГруппы = _ГвардГруппы;
	Ответы = _Ответы;
	Дом = _Дом;
