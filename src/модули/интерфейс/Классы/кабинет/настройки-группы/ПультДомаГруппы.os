// Операции дома «Группа»: состав (добавить участника окном, убрать подтверждением), сопоставления
// с клеймами провайдера (добавить окном, удалить подтверждением) и политика выпавших тумблером.
// Исход каждой — ИсходОкна: отказ формы окна «новый» возвращается в это окно.

Перем Гейт;                 // ГейтФормы — CSRF-токен формы
Перем РазборФормы;
Перем СервисГрупп;          // СервисГрупп (права) — состав группы
Перем СервисСопоставлений;  // СервисСопоставленийГрупп (права) — правила клеймов и политика
Перем СервисПользователей;  // СервисПользователей (вход) — учётка по логину
Перем Сбои;                 // ТекстСбоя — отказ домена словами человека
Перем Исходы;               // ИсходОкна — форма исхода
Перем Тексты;               // ТекстыИнтерфейса (кит)

#Область ИменаПолей

// Поле учётки в окне «Добавить участника».
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляЛогина() Экспорт
	Возврат "логин";
КонецФункции

// Поле издателя (issuer) в окне нового сопоставления.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляИздателя() Экспорт
	Возврат "издатель";
КонецФункции

// Поле имени клейма в окне нового сопоставления.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляКлейма() Экспорт
	Возврат "клейм";
КонецФункции

// Поле значения клейма в окне нового сопоставления.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляЗначения() Экспорт
	Возврат "значение";
КонецФункции

// Поле тумблера политики выпавших.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляПолитики() Экспорт
	Возврат "политика";
КонецФункции

#КонецОбласти

#Область ПубличныйИнтерфейс

// Разбирает тело запроса и проверяет CSRF.
//
// Параметры:
//  Ответ - ОтветСервера.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  ТелоЗапроса - Строка.
//  КукиЗапроса - Куки - куки запроса.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - разобранная форма; Неопределено — ответ уже сформирован.
//
Функция Форма(Ответ, Знач Контекст, Знач ТелоЗапроса, Знач КукиЗапроса) Экспорт
	Возврат Гейт.СПринятымТокеном(Ответ, Контекст, РазборФормы.Разобрать(ТелоЗапроса), КукиЗапроса);
КонецФункции

// Пришла ли форма старой вкладки: прежние формы дома несли поле «операция», нынешние — нет.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура, Неопределено - отказ «Страница устарела» над разделом (см. ИсходОкна.Отбито);
//                            Неопределено — форма нынешняя.
//
Функция ОтказСтаройВкладки(Знач Форма) Экспорт

	Если Форма.Получить("операция") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Исходы.Отбито(Тексты.Текст("settings.group.error.stale"));

КонецФункции

// Добавляет в группу учётку, выбранную в окне; членство заводится с источником local.
//
// Параметры:
//  Группа - Группа - группа дома.
//  Форма - Соответствие - разобранная форма окна.
//
// Возвращаемое значение:
//  Структура - исход (см. ИсходОкна.Удача): отказ — под полем учётки в окне «новый».
//
Функция ДобавитьУчастника(Знач Группа, Знач Форма) Экспорт

	Логин = Текст(Форма, ИмяПоляЛогина());
	Если НЕ ЗначениеЗаполнено(Логин) Тогда
		Возврат ВОкне(Исходы.ОтбитоПолем(ИмяПоляЛогина(), Тексты.Текст("settings.group.member-new.required")), Форма);
	КонецЕсли;
	Учётка = СервисПользователей.НайтиПоЛогину(Логин);
	Если Учётка = Неопределено Тогда
		Возврат ВОкне(Исходы.ОтбитоПолем(ИмяПоляЛогина(), Тексты.Шаблон("settings.group.member-new.missing", Логин)),
			Форма);
	КонецЕсли;
	// повтор означает устаревший список кандидатов: молчаливое «ок» показало бы, что
	// действие сработало, хотя состав не менялся
	Если ВГруппе(Группа, Учётка) Тогда
		Возврат ВОкне(Исходы.ОтбитоПолем(ИмяПоляЛогина(), Тексты.Шаблон("settings.group.member-new.duplicate", Логин)),
			Форма);
	КонецЕсли;

	СервисГрупп.ДобавитьУчастника(Группа.Идентификатор, Учётка.Идентификатор, "local");
	Возврат Исходы.Удача();

КонецФункции

// Убирает участника из группы.
//
// Параметры:
//  Группа - Группа - группа дома.
//  Логин - Строка - логин из адреса формы.
//
// Возвращаемое значение:
//  Структура - исход (см. ИсходОкна.Удача); не участник — 404 над разделом.
//
Функция УбратьУчастника(Знач Группа, Знач Логин) Экспорт

	Учётка = СервисПользователей.НайтиПоЛогину(Логин);
	Если Учётка = Неопределено ИЛИ НЕ ВГруппе(Группа, Учётка) Тогда
		Возврат Исходы.Отбито(Тексты.Шаблон("settings.group.member.missing", Логин), 404);
	КонецЕсли;

	СервисГрупп.УдалитьУчастника(Группа.Идентификатор, Учётка.Идентификатор);
	Возврат Исходы.Удача();

КонецФункции

// Заводит сопоставление клейма с группой; пустые издатель и значение — отказ под полем.
//
// Параметры:
//  Группа - Группа - группа дома.
//  Форма - Соответствие - разобранная форма окна.
//
// Возвращаемое значение:
//  Структура - исход (см. ИсходОкна.Удача): отказ — под полями окна «новый».
//
Функция ДобавитьСопоставление(Знач Группа, Знач Форма) Экспорт

	Отказы = Новый Соответствие();
	Издатель = Текст(Форма, ИмяПоляИздателя());
	Значение = Текст(Форма, ИмяПоляЗначения());
	Если НЕ ЗначениеЗаполнено(Издатель) Тогда
		Отказы.Вставить(ИмяПоляИздателя(), Тексты.Текст("settings.group.mapping-new.issuer.required"));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Отказы.Вставить(ИмяПоляЗначения(), Тексты.Текст("settings.group.mapping-new.value.required"));
	КонецЕсли;
	Если Отказы.Количество() > 0 Тогда
		Возврат ВОкне(Исходы.ОтбитоПолями(Отказы), Форма);
	КонецЕсли;

	Попытка
		СервисСопоставлений.ДобавитьСопоставление(Группа.Идентификатор, Издатель, Значение,
			РазборФормы.Поле(Форма, ИмяПоляКлейма(), "groups"));
	Исключение
		Возврат ВОкне(Исходы.ОтбитоПолем(ИмяПоляИздателя(), Сбои.Человеку(ИнформацияОбОшибке())), Форма);
	КонецПопытки;
	Возврат Исходы.Удача();

КонецФункции

// Удаляет сопоставление группы по его номеру.
//
// Параметры:
//  Группа - Группа - группа дома.
//  Номер - Строка - номер сопоставления из адреса формы.
//
// Возвращаемое значение:
//  Структура - исход (см. ИсходОкна.Удача); чужое или удалённое — 404 над разделом.
//
Функция УдалитьСопоставление(Знач Группа, Знач Номер) Экспорт

	Сопоставление = СопоставлениеГруппы(Группа, Номер);
	Если Сопоставление = Неопределено Тогда
		Возврат Исходы.Отбито(Тексты.Текст("settings.group.oidc.missing"), 404);
	КонецЕсли;

	СервисСопоставлений.УдалитьСопоставление(Группа.Идентификатор, Сопоставление.Издатель,
		Сопоставление.Значение, Сопоставление.ИмяКлейма);
	Возврат Исходы.Удача();

КонецФункции

// Ставит политику выпавших из формы тумблера: значение вне двух политик — отказ без записи.
//
// Параметры:
//  Группа - Группа - группа дома.
//  Форма - Соответствие - разобранная форма тумблера.
//
// Возвращаемое значение:
//  Структура - исход (см. ИсходОкна.Удача): у тумблера окна нет — отказ над разделом.
//
Функция ЗадатьПолитику(Знач Группа, Знач Форма) Экспорт

	Политика = Текст(Форма, ИмяПоляПолитики());
	Если Политика <> СервисСопоставлений.ПолитикаОставлять()
		И Политика <> СервисСопоставлений.ПолитикаИсключать() Тогда
		Возврат Исходы.Отбито(Тексты.Текст("settings.group.policy.unknown"));
	КонецЕсли;

	СервисСопоставлений.УстановитьПолитикуВыпавших(Группа.Идентификатор, Политика);
	Возврат Исходы.Удача();

КонецФункции

// Сопоставления группы — из правил хаба: их единицы и десятки на весь хаб.
//
// Параметры:
//  Группа - Группа - группа дома.
//
// Возвращаемое значение:
//  Массив из СопоставлениеГруппыOIDC.
//
Функция СопоставленияГруппы(Знач Группа) Экспорт

	Результат = Новый Массив();
	Для Каждого Сопоставление Из СервисСопоставлений.ВсеСопоставления() Цикл
		Если Цел(Сопоставление.ГруппаИдентификатор) = Цел(Группа.Идентификатор) Тогда
			Результат.Добавить(Сопоставление);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Сопоставление группы по номеру.
//
// Параметры:
//  Группа - Группа - группа дома.
//  Номер - Строка, Число - номер сопоставления.
//
// Возвращаемое значение:
//  СопоставлениеГруппыOIDC, Неопределено.
//
Функция СопоставлениеГруппы(Знач Группа, Знач Номер) Экспорт

	Для Каждого Сопоставление Из СопоставленияГруппы(Группа) Цикл
		Если Формат(Сопоставление.Идентификатор, "ЧГ=0; ЧН=0") = СокрЛП(Строка(Номер)) Тогда
			Возврат Сопоставление;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отказ формы окна заведения (участника, сопоставления) остаётся в этом окне на набранном.
Функция ВОкне(Знач Отказ, Знач Форма)
	Возврат Исходы.ВОкне(Отказ, "новый", "", Форма);
КонецФункции

Функция Текст(Знач Форма, Знач Имя)
	Возврат СокрЛП(РазборФормы.Поле(Форма, Имя));
КонецФункции

Функция ВГруппе(Знач Группа, Знач Учётка)

	Для Каждого Идентификатор Из СервисГрупп.УчастникиГруппы(Группа.Идентификатор) Цикл
		Если Цел(Идентификатор) = Цел(Учётка.Идентификатор) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

&Прозвище("ПультДомаГруппы")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп,
	&Пластилин(Значение = "СервисСопоставленийГрупп") _СервисСопоставлений,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ИсходОкна") _Исходы) Экспорт

	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	СервисГрупп = _СервисГрупп;
	СервисСопоставлений = _СервисСопоставлений;
	СервисПользователей = _СервисПользователей;
	Сбои = _Сбои;
	Тексты = _Тексты;
	Исходы = _Исходы;

КонецПроцедуры
