// Дом настроек «Группа»: адреса, разделы и заголовки настроек группы.

Перем Тексты;    // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Сборка;    // СборкаДомаНастроек — перечень разделов дома
Перем Перечень;  // ТаблицаЗначений — разделы дома по порядку колонки

// Ключ дома.
//
// Возвращаемое значение:
//  Строка - ключ дома.
//
Функция Ключ() Экспорт
	Возврат "group";
КонецФункции

// Базовый адрес дома.
//
// Параметры:
//  ИмяГруппы - Строка - имя группы.
//
// Возвращаемое значение:
//  Строка - "/groups/{g}/settings".
//
Функция БазовыйАдрес(Знач ИмяГруппы) Экспорт
	// имя приходит из адреса до разбора в группу — в сегмент оно ложится кодированным
	Возврат "/groups/" + КодироватьСтроку(Строка(ИмяГруппы), СпособКодированияСтроки.КодировкаURL) + "/settings";
КонецФункции

// Раздел по умолчанию.
//
// Возвращаемое значение:
//  Строка - раздел по умолчанию.
//
Функция РазделПоУмолчанию() Экспорт
	Возврат "members";
КонецФункции

// Адрес раздела дома.
//
// Параметры:
//  ИмяГруппы - Строка - имя группы.
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - адрес раздела дома.
//
Функция АдресРаздела(Знач ИмяГруппы, Знач Ключ) Экспорт
	Возврат БазовыйАдрес(ИмяГруппы) + "/" + Ключ;
КонецФункции

// Разделы дома для модели (ОтветыНастроек.МодельДома).
//
// Параметры:
//  ИмяГруппы - Строка - имя группы.
//  Активный - Строка - ключ активного раздела.
//
// Возвращаемое значение:
//  Структура - разделы дома (СборкаДомаНастроек.РазделыДома).
//
Функция Разделы(Знач ИмяГруппы, Знач Активный) Экспорт
	Возврат Сборка.РазделыДома(БазовыйАдрес(ИмяГруппы), Перечень, Активный);
КонецФункции

// Есть ли раздел с таким ключом.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Булево - есть ли раздел с таким ключом.
//
Функция ЕстьРаздел(Знач Ключ) Экспорт
	Возврат Сборка.РазделПеречня(Перечень, Ключ) <> Неопределено;
КонецФункции

// Подпись раздела.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - подпись раздела либо "".
//
Функция ПодписьРаздела(Знач Ключ) Экспорт
	Раздел = Сборка.РазделПеречня(Перечень, Ключ);
	Возврат ?(Раздел = Неопределено, "", Раздел.Подпись);
КонецФункции

// Объект дома, один на все его разделы: у этого дома его нет — объект (группа) называет раздел.
//
// Возвращаемое значение:
//  Строка - "".
//
Функция Объект() Экспорт
	Возврат "";
КонецФункции

// Заголовок дома.
//
// Возвращаемое значение:
//  Строка - заголовок дома.
//
Функция Заголовок() Экспорт
	Возврат Тексты.Текст("settings.group.title");
КонецФункции

// Пояснение дома.
//
// Возвращаемое значение:
//  Строка - пояснение дома.
//
Функция Пояснение() Экспорт
	Возврат Тексты.Текст("settings.group.lead");
КонецФункции

// Раздел перечня дома.
Процедура Раздел(Знач КлючРаздела, Знач Подпись, Знач Иконка)
	Сборка.Раздел(Перечень, КлючРаздела, Подпись, Иконка);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СборкаДомаНастроек") _Сборка,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Сборка = _Сборка;
	Тексты = _Тексты;

	Перечень = Сборка.ПереченьРазделов();
	Раздел("members", Тексты.Текст("settings.group.nav.members"), "аккаунт");
	Раздел("oidc", Тексты.Текст("settings.group.nav.oidc"), "ссылка");
	Раздел("grants", Тексты.Текст("settings.group.nav.grants"), "галочка");

КонецПроцедуры
