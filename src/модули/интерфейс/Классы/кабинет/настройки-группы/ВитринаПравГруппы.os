// Раздел «Права доступа группы» дома «Группа»: показывает все объекты — хаб, пулы и пакеты —
// и только те из них, которые вправе видеть смотрящий.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем ТаблицыПрав;       // ТаблицаПрав — единая таблица выдачи прав
Перем СервисПравДоступа; // СервисПравДоступа (права) — записи прав субъекта
Перем Видимость;         // ВидимостьОбъектовПрав (права) — что смотрящему вообще видно
Перем ДомПула;           // ДомПула — адреса пула и его разделов
Перем ДомПакета;         // ДомПакета — адреса пакета и его разделов
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Страницы; // АдресаСтраниц (реестр) — страницы пула и пакета в строке права

#Область ПубличныйИнтерфейс

// Секция раздела «права доступа» группы.
//
// Параметры:
//  Параметры - Структура:
//    * Группа - Группа - группа;
//    * Пользователь - Пользователь, Неопределено - смотрящий;
//    * Принципал - Структура, Неопределено - принципал запроса для гейта ключа.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.Секция.
//
Функция Секция(Знач Параметры) Экспорт

	Возврат Кит.Секция(Тексты.Текст("settings.group.grants.title"),
			ТаблицаОбъектов(Параметры),
			Кит.Примечание(Тексты.Текст("settings.group.grants.note")))
		.Лид(Тексты.Текст("settings.group.grants.lead")).Иконка("галочка");

КонецФункции

#КонецОбласти

#Область Раскладка

// Ось «объекты»: на что у группы есть права; хвост — ссылка «где править».
Функция ТаблицаОбъектов(Знач Параметры)

	Возврат ТаблицыПрав.Таблица(Новый Структура("Строки, Ось, ХвостЗаголовок, Пусто",
		Строки(Параметры), "объекты",
		Тексты.Текст("settings.group.grants.col.where"),
		Тексты.Текст("settings.group.grants.empty")));

КонецФункции

Функция Строки(Знач Параметры)

	Гранты = СервисПравДоступа.ГрантыСубъекта("группа", Параметры.Группа.Идентификатор);
	Снимок = Видимость.Описания(Параметры.Пользователь, Гранты, Параметры.Принципал);

	Результат = Новый Массив();
	Для Каждого Право Из Гранты Цикл
		Объект = Видимость.Описание(Параметры.Пользователь, Право.ТипОбъекта,
			Право.ОбъектИдентификатор, Параметры.Принципал, Снимок);
		Если НЕ Объект.Виден Тогда
			Продолжить; // объект удалён либо не виден смотрящему
		КонецЕсли;
		Результат.Добавить(Новый Структура("Грант, Роль, Объект, Хвост", Право,
			СервисПравДоступа.РольЗаписи(Право), ИмяОбъекта(Объект), ХодКПравке(Объект)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИмяОбъекта(Знач Объект)

	Если Объект.Тип = "пул" Тогда
		Возврат ХодПоАдресу(Страницы.Пула(Объект.Пул.Имя), Объект.Пул.Имя);
	ИначеЕсли Объект.Тип = "пакет" Тогда
		Возврат ХодПоАдресу(Страницы.Пакета(Объект.Пул.Имя, Объект.Пакет.Имя),
			Объект.Пул.Имя + "/" + Объект.Пакет.Имя);
	КонецЕсли;

	Возврат Кит.Текст(Тексты.Текст("settings.group.grants.object.hub"));

КонецФункции

// У объекта «хаб» раздела правки нет: роли уровня хаба раздаёт только администратор хаба.
Функция ХодКПравке(Знач Объект)

	Если Объект.Тип = "пул" Тогда
		Возврат ХодПоАдресу(ДомПула.АдресРаздела(Объект.Пул.Имя, "access"),
			Тексты.Текст("settings.group.grants.link.pool"));
	ИначеЕсли Объект.Тип = "пакет" Тогда
		Возврат ХодПоАдресу(ДомПакета.АдресРаздела(Объект.Пул.Имя, Объект.Пакет.Имя, "access"),
			Тексты.Текст("settings.group.grants.link.package"));
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ХодПоАдресу(Знач Адрес, Знач Подпись)
	Возврат Кит.Ссылка(Адрес, Кит.Текст(Подпись));
КонецФункции

#КонецОбласти

&Прозвище("ВитринаПравГруппы")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТаблицаПрав") _ТаблицыПрав,
	&Пластилин(Значение = "СервисПравДоступа") _СервисПравДоступа,
	&Пластилин(Значение = "ВидимостьОбъектовПрав") _Видимость,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ДомПакета") _ДомПакета,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы) Экспорт

	Кит = _Кит;
	ТаблицыПрав = _ТаблицыПрав;
	СервисПравДоступа = _СервисПравДоступа;
	Видимость = _Видимость;
	ДомПула = _ДомПула;
	ДомПакета = _ДомПакета;
	Тексты = _Тексты;
	Страницы = _Страницы;

КонецПроцедуры
