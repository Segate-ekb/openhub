// Адреса экранов кабинета — по одному литералу маршрута на весь хаб: их печатают и тот
// экран, которому они принадлежат, и соседний, который на него ссылается.

// Корень личного пространства.
//
// Возвращаемое значение:
//  Строка - адрес экрана.
//
Функция Личное() Экспорт
	Возврат "/me";
КонецФункции

// Сводка заявок, ждущих решения вошедшего.
//
// Возвращаемое значение:
//  Строка - адрес экрана.
//
Функция Входящие() Экспорт
	Возврат Личное() + "/inbox";
КонецФункции

// Корень дома настроек аккаунта. Разделы дома собирает ДомАккаунта — он же единственный,
// кто знает их ключи; сюда вынесен только корень, потому что на него ссылается шапка.
//
// Возвращаемое значение:
//  Строка - адрес дома.
//
Функция Настройки() Экспорт
	Возврат Личное() + "/settings";
КонецФункции

// Лента личных уведомлений вошедшего.
//
// Возвращаемое значение:
//  Строка - адрес экрана.
//
Функция Уведомления() Экспорт
	Возврат Личное() + "/notifications";
КонецФункции

// Личное пространство человека — пул, названный его логином.
//
// Параметры:
//  Логин - Строка - логин владельца пространства.
//
// Возвращаемое значение:
//  Строка - адрес пула.
//
Функция Пространство(Знач Логин) Экспорт
	Возврат "/" + Строка(Логин);
КонецФункции

// Проводник первой публикации. Живёт в корне, а не под /me: на него уводит и пустая
// главная хаба, куда приходят ещё до кабинета.
//
// Возвращаемое значение:
//  Строка - адрес экрана.
//
Функция Проводник() Экспорт
	Возврат "/tour";
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
