// Контроллер задачи-проводника «первая публикация» — модуль web-ui.

Перем Гвард;         // ГвардКабинета (кабинет)
Перем Страницы;      // РендерерКабинета (web-ui) — страница приватной части
Перем Экран;         // ЭкранированиеHTML (кит)
Перем НаборUI;       // НаборКомпонентов (кит)
Перем Путь;          // ПутьПервойПубликации (web-ui)
Перем Ответы;        // ОтветыНастроек (web-ui)
Перем СервисПрав;    // СервисПрав (auth)
Перем ВитринаШагов;  // ВитринаПервойПубликации (web-ui) — карточка шагов

// Точка маршрута «/tour» (GET).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ПутьЗапроса - Строка - путь текущего запроса: по нему меню подсвечивает дорогу.
//
&ТочкаМаршрута("/tour")
Процедура Проводник(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ПутьЗапроса) Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Ответ.УстановитьСостояние(200);
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Страница(Вердикт.Пользователь, КукиЗапроса, ПутьЗапроса);

КонецПроцедуры

#Область Рендер

Функция Страница(Знач Пользователь, Знач КукиЗапроса, Знач ПутьЭкрана)

	// один вход в службу за показ: шаги, пул примера и нужна ли его прописка считаются одним
	// проходом, и шаг «Опубликовать» с карточкой публикации говорят одно и то же
	Состояние = Путь.Состояние(Пользователь);

	// та же карточка шагов, что стоит в кабинете новичка: путь один, и выглядит он одинаково
	Содержимое = ВитринаШагов.Карточка(Состояние).Рендер() + КарточкаOpm(Состояние);

	Возврат Страницы.Страница("Первая публикация", Содержимое,
		Страницы.КонтекстСтраницы(Пользователь, КукиЗапроса,
			СервисПрав.ПользовательАдмин(Пользователь), ПутьЭкрана));

КонецФункции

// Основной пул хаба, известного opm, клиент находит сам: прописывать его в opm.cfg незачем.
Функция КарточкаOpm(Знач Состояние)

	Если Состояние.ПропискаНужна Тогда
		Пояснение = "opm ходит в ПУЛ, а не в хаб целиком: пул прописывается сервером в opm.cfg.";
		Тело = БлокНастройкиOpm(Состояние.ПулПримера);
	Иначе
		Пояснение = СтрШаблон("opm знает этот хаб по умолчанию: прописывать его в opm.cfg не нужно,"
			+ " пакет уйдёт в основной пул %1.", Состояние.ПулПримера);
		Тело = БлокПубликацииСТокеном();
	КонецЕсли;

	Возврат НаборUI.Карточка().Отрисовать(Новый Структура("Заголовок, Описание, Иконка, Тело",
		"Публикация из opm", Пояснение, "пакет", Тело));

КонецФункции

Функция БлокНастройкиOpm(Знач ПулПримера)

	ИмяПула = ?(ЗначениеЗаполнено(ПулПримера), ПулПримера, "<пул>");

	Конфиг = "{ ""СервераПакетов"": [" + Символы.ПС
		+ "  { ""Имя"": ""openhub"", ""Сервер"": ""https://<адрес-хаба>"", ""Порт"": 443," + Символы.ПС
		+ СтрШаблон("    ""ПутьНаСервере"": ""/api/v1/pools/%1/download/"",", ИмяПула) + Символы.ПС
		+ СтрШаблон("    ""РесурсПубликацииПакетов"": ""/api/v1/pools/%1/push"",", ИмяПула) + Символы.ПС
		+ "    ""Авторизация"": ""Bearer ${OSHUB_TOKEN}"", ""Приоритет"": 0 }" + Символы.ПС
		+ "] }";

	Возврат СтрШаблон("<pre class=""code""><code>%1</code></pre>", Экран.Экранировать(Конфиг))
		+ НаборUI.ЗаголовокСтраницы().Примечание(Экран.Экранировать(
			"Токен из шага «Выпустить токен публикации» кладите в переменную "
			+ "окружения, а не в файл конфигурации."), Истина)
		+ НаборUI.БлокКоманды().Отрисовать("opm push mylib-1.0.0.ospx");

КонецФункции

// Без opm.cfg цель публикации — короткий адрес хаба: токен и обязательный канал едут опциями.
Функция БлокПубликацииСТокеном()

	Возврат НаборUI.БлокКоманды().Отрисовать("opm push --token <токен> -c stable <файл>.ospx")
		+ НаборUI.ЗаголовокСтраницы().Примечание(Экран.Экранировать(
			"Вместо <токен> подставьте токен из шага «Выпустить токен публикации», вместо <файл> —"
			+ " имя собранного пакета. Канал -c stable указывайте явно: сам opm определяет его"
			+ " только в git-репозитории на ветке master. Предупреждение opm 1.8 о том, что опция -c"
			+ " устарела, ожидаемо и публикации не мешает."), Истина);

КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _Гвард,
	&Пластилин(Значение = "РендерерКабинета") _Страницы,
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "НаборКомпонентов") _НаборUI,
	&Пластилин(Значение = "ПутьПервойПубликации") _Путь,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ВитринаПервойПубликации") _ВитринаШагов)

	Гвард = _Гвард;
	Страницы = _Страницы;
	Экран = _Экран;
	НаборUI = _НаборUI;
	Путь = _Путь;
	Ответы = _Ответы;
	СервисПрав = _СервисПрав;
	ВитринаШагов = _ВитринаШагов;

КонецПроцедуры
