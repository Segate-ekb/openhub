// Тексты панели зеркал: форма зеркала и состояния прогона.

// Кладёт тексты в словарь интерфейса.
//
// Параметры:
//  Словарь - СловарьТекстов - словарь, который собирается из частей.
//
Процедура Наполнить(Знач Словарь) Экспорт

	КлючиФормыЗеркала(Словарь);
	КлючиПрогонаЗеркала(Словарь);

КонецПроцедуры

// Форма зеркала: протокол, перенос из другого хаба и отказы полей.
Процедура КлючиФормыЗеркала(Словарь)

	Словарь.Добавить("settings.pool.mirrors.error.url", "Не задан адрес апстрима зеркала.");
	Словарь.Добавить("settings.pool.mirrors.error.interval",
		"Интервал синхронизации должен быть целым числом секунд (пусто — значение по умолчанию).");
	Словарь.Добавить("settings.pool.mirrors.protocol.migrate", "перенос");
	Словарь.Добавить("settings.pool.mirrors.protocol.openhub", "OpenHub");
	Словарь.Добавить("settings.pool.mirrors.protocol.legacy", "opm");
	Словарь.Добавить("settings.pool.mirrors.protocol.unknown", "ещё не определён");
	Словарь.Добавить("settings.pool.mirror-new.migrate.label", "Перенести пакеты из другого хаба");
	Словарь.Добавить("settings.pool.mirror-new.migrate.hint",
		"Для переезда: привезённое станет здесь своим, как опубликованное в этом хабе");
	Словарь.Добавить("settings.pool.mirror-new.migrate.note",
		"Перенесённые версии ведут себя как свои: последняя выбирается среди них, плашки"
		+ " «с апстрима» у них нет, уборка места их не вытесняет. Даты у них — момент"
		+ " переноса, автор неизвестен: чужой хаб этих сведений не отдаёт. Признак задаётся"
		+ " только при заведении — у наполненного зеркала перенос задним числом"
		+ " не появляется.");

КонецПроцедуры

// Состояния прогона зеркала.
Процедура КлючиПрогонаЗеркала(Словарь)

	Словарь.Добавить("mirror.run.state.idle", "простаивает");
	Словарь.Добавить("mirror.run.state.queued", "в очереди");
	Словарь.Добавить("mirror.run.state.running", "идёт");
	Словарь.Добавить("mirror.run.state.stale", "брошен: рабочий не отвечает");
	Словарь.Добавить("mirror.run.state.done", "завершён");
	Словарь.Добавить("mirror.run.state.failed", "ошибка");

КонецПроцедуры

&Прозвище("ЧастьСловаряТекстов")
&Порядок(60)
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
