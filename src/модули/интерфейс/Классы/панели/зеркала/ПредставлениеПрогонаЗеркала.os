// Состояние синхронизации зеркала в виде, готовом для экрана: подпись состояния, моменты,
// счётчики, доля обхода. Сам прогон - доменный класс модуля зеркала.

Перем Тексты;    // ТекстыИнтерфейса (кит) - пользовательские строки по ключам
Перем Счетчики;  // СчетчикиОбхода (зеркала) - «обработано» и долю обхода считает домен
Перем Срез;      // СрезОбхода (зеркала) - способ обхода судит домен, экран его показывает
Перем Даты;  // ДатаЧеловеку - одно написание момента на весь интерфейс

#Область ПубличныйИнтерфейс

// Модель прогона зеркала для экрана.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - конфигурация зеркала.
//  Брошен - Булево - вердикт домена «прогон занят, но молчит дольше порога»
//           (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура - Код (Строка - код состояния: хранения либо "брошен"), Подпись (Строка -
//              состояние словами), Вид (Строка - вид плашки), Активен (Булево - прогон
//              идёт либо ждёт очереди), Начат, Обновлён, ПоследнийСинк (Строка - момент
//              либо ""), Всего, Скачано, Пропущено, Ошибок, Недоступно, Обработано,
//              ИменВсего, ИменПройдено, Процент (Число, доля обхода по именам),
//              Курсор (Строка), Запустил (Строка - "" для планового запуска),
//              Итог (Строка - текст последнего результата), Способ (Строка - способ обхода),
//              СрезС (Строка - момент, с которого спрошены изменения, либо "").
//
Функция Модель(Знач Зеркало, Знач Брошен = Ложь) Экспорт

	Результат = ПоЗаписи(Зеркало);
	// запись говорит «идёт» и после смерти рабочего: брошенный прогон судит домен
	Если Брошен = Истина И (Результат.Код = "идёт" ИЛИ Результат.Код = "поставлено") Тогда
		Результат.Код = "брошен";
	КонецЕсли;
	Досчитать(Результат);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off

Функция ПоЗаписи(Знач Зеркало)

	Результат = Новый Структура();
	Результат.Вставить("Код", Код(Зеркало.СостояниеПрогона));
	Результат.Вставить("Подпись", "");
	Результат.Вставить("Вид", "");
	Результат.Вставить("Активен", Ложь);
	Результат.Вставить("Начат", Момент(Зеркало.ПрогонНачат));
	Результат.Вставить("Обновлен", Момент(Зеркало.ПрогонОбновлен));
	Результат.Вставить("ПоследнийСинк", Момент(Зеркало.ПоследнийСинк));
	Результат.Вставить("Всего", Счетчик(Зеркало.ПрогонВсего));
	Результат.Вставить("Скачано", Счетчик(Зеркало.ПрогонСкачано));
	Результат.Вставить("Пропущено", Счетчик(Зеркало.ПрогонПропущено));
	Результат.Вставить("Ошибок", Счетчик(Зеркало.ПрогонОшибок));
	Результат.Вставить("Недоступно", Счетчик(Зеркало.ПрогонНедоступно));
	// «обработано» и доля обхода - счёт ДОМЕНА, а не своя копия формулы
	Результат.Вставить("Обработано", Счетчики.ОбработаноПоЗаписи(Зеркало));
	Результат.Вставить("ИменВсего", Счетчик(Зеркало.ПрогонИменВсего));
	Результат.Вставить("ИменПройдено", Счетчик(Зеркало.ПрогонИменПройдено));
	Результат.Вставить("Процент", Счетчики.ДоляОбходаПоЗаписи(Зеркало));
	Результат.Вставить("Курсор", Текст(Зеркало.ПрогонКурсор));
	Результат.Вставить("Запустил", Текст(Зеркало.ПрогонЗапустил));
	Результат.Вставить("Итог", Текст(Зеркало.Статус));
	// способ обхода судит ДОМЕН тем же кодом, что и движок: экран только показывает
	Результат.Вставить("Способ", Срез.ПоМоменту(Зеркало.ПрогонСрезС));
	Результат.Вставить("СрезС", Момент(Зеркало.ПрогонСрезС));
	Возврат Результат;

КонецФункции

Процедура Досчитать(Модель)

	Модель.Подпись = Подпись(Модель.Код);
	Модель.Вид = Вид(Модель.Код);
	Модель.Активен = (Модель.Код = "поставлено" ИЛИ Модель.Код = "идёт");

КонецПроцедуры

// Код хранения приводится к известному набору: незнакомое и пустое значение - «простаивает».
Функция Код(Знач Значение)

	Норма = НРег(Текст(Значение));
	Если ИзвестныйКод(Норма) Тогда
		Возврат Норма;
	КонецЕсли;

	Возврат "простаивает";

КонецФункции

Функция ИзвестныйКод(Знач Норма)
	Если Норма = "поставлено" ИЛИ Норма = "идёт" Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Норма = "завершён" ИЛИ Норма = "ошибка";
КонецФункции

// Ключи перечислены литералами: скан мёртвых ключей словаря читает код, а не значения.
Функция Подпись(Знач Код)

	Если Код = "поставлено" Тогда
		Возврат Тексты.Текст("mirror.run.state.queued");
	ИначеЕсли Код = "идёт" Тогда
		Возврат Тексты.Текст("mirror.run.state.running");
	ИначеЕсли Код = "брошен" Тогда
		Возврат Тексты.Текст("mirror.run.state.stale");
	ИначеЕсли Код = "завершён" Тогда
		Возврат Тексты.Текст("mirror.run.state.done");
	ИначеЕсли Код = "ошибка" Тогда
		Возврат Тексты.Текст("mirror.run.state.failed");
	КонецЕсли;

	Возврат Тексты.Текст("mirror.run.state.idle");

КонецФункции

Функция Вид(Знач Код)

	Если Код = "поставлено" ИЛИ Код = "идёт" Тогда
		Возврат "accent";
	ИначеЕсли Код = "завершён" Тогда
		Возврат "ok";
	ИначеЕсли Код = "ошибка" ИЛИ Код = "брошен" Тогда
		Возврат "err";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция Текст(Знач Значение)
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
КонецФункции

Функция Счетчик(Знач Значение)
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Макс(0, Цел(Значение)), 0);
КонецФункции

Функция Момент(Знач Значение)

	Если ТипЗнч(Значение) <> Тип("Дата") ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Даты.ДатаВремя(Значение);

КонецФункции

// BSLLS:MissingParameterDescription-on
// BSLLS:MissingReturnedValueDescription-on
#КонецОбласти

&Прозвище("ПредставлениеПрогонаЗеркала")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СчетчикиОбхода") _Счетчики,
	&Пластилин(Значение = "СрезОбхода") _Срез = Неопределено,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено) Экспорт

	Тексты = _Тексты;
	Счетчики = _Счетчики;
	Срез = ?(_Срез = Неопределено, Новый СрезОбхода(), _Срез);
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);

КонецПроцедуры
