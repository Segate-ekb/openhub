// Операции над зеркалами пула, общие разделу «Зеркала» дома «Пул» и обзору зеркал кабинета:
// правило ввода формы зеркала, заведение, переключение и заявка на синхронизацию.

Перем РазборФормы;
Перем СервисЗеркал;  // СервисЗеркал (зеркала)
Перем Очередь;       // ОчередьСинхронизацииЗеркал (зеркала)
Перем Канон;         // РазборНастроекЗеркала (зеркала) — фильтр имён судит домен
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Сбои;          // ТекстСбоя — отказ разбора фильтра словами человека
Перем Итоги;         // ИтогПульта — единая форма итога операции

#Область ИменаПолей

// Имя поля адреса апстрима зеркала.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляАдреса() Экспорт
	Возврат "url";
КонецФункции

// Имя поля токена доступа к апстриму.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляТокена() Экспорт
	Возврат "токен";
КонецФункции

// Имя поля фильтра имён.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляФильтра() Экспорт
	Возврат "фильтр";
КонецФункции

// Имя поля интервала синхронизации.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляИнтервала() Экспорт
	Возврат "интервал";
КонецФункции

// Имя флажка переноса.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляПереноса() Экспорт
	Возврат "перенос";
КонецФункции

#КонецОбласти

#Область ПубличныйИнтерфейс

// Заводит зеркало по форме экрана. Ввод проверяется ДО обращения к домену: адрес обязателен,
// интервал — целое число секунд. Отмеченный флажок «перенос» заводит зеркало переноса:
// привезённое им становится в пуле своим.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект запроса (порог права судит домен).
//  Пул - Пул - пул, которому заводится зеркало.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - итог пульта (см. ИтогПульта).
//
Функция Завести(Знач Пользователь, Знач Пул, Знач Форма) Экспорт

	// баннер называет первый отказ в порядке полей формы
	Отказы = ОтказыВвода(Форма);
	Для Каждого Имя Из СтрРазделить(ИмяПоляАдреса() + "," + ИмяПоляФильтра() + "," + ИмяПоляИнтервала(), ",") Цикл
		Если Отказы.Получить(Имя) <> Неопределено Тогда
			Возврат Итоги.Отказ(Отказы.Получить(Имя));
		КонецЕсли;
	КонецЦикла;

	СервисЗеркал.Создать(Пользователь, Пул,
		СокрЛП(РазборФормы.Поле(Форма, ИмяПоляАдреса())),
		ФильтрJSON(Форма),
		РазборФормы.ЦелоеПоле(Форма, ИмяПоляИнтервала(), 0),
		РазборФормы.Поле(Форма, ИмяПоляТокена()),
		ПереносОтмечен(Форма));

	Возврат Итоги.Успех();

КонецФункции

// Отмечен ли в форме заведения флажок переноса. Экран спрашивает, чтобы не потерять
// решение человека на отказе: пересобранная форма обязана вернуться отмеченной.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПереносОтмечен(Знач Форма) Экспорт
	Возврат РазборФормы.Флажок(Форма, ИмяПоляПереноса());
КонецФункции

// Отказы формы зеркала, которые экран называет у поля до домена: адрес обязателен, интервал —
// целое число секунд, фильтр, набранный JSON-массивом, разбирается как массив.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Соответствие - имя поля -> отказ под полем; пустое — ввод принят.
//
Функция ОтказыВвода(Знач Форма) Экспорт

	Отказы = Новый Соответствие();
	Если НЕ ЗначениеЗаполнено(СокрЛП(РазборФормы.Поле(Форма, ИмяПоляАдреса()))) Тогда
		Отказы.Вставить(ИмяПоляАдреса(), Тексты.Текст("settings.pool.mirrors.error.url"));
	КонецЕсли;
	Если РазборФормы.ЦелоеПоле(Форма, ИмяПоляИнтервала(), 0) = Неопределено Тогда
		Отказы.Вставить(ИмяПоляИнтервала(), Тексты.Текст("settings.pool.mirrors.error.interval"));
	КонецЕсли;
	Попытка
		Канон.ПроверитьФильтр(ФильтрJSON(Форма));
	Исключение
		Отказы.Вставить(ИмяПоляФильтра(), Сбои.Человеку(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Отказы;

КонецФункции

// Фильтр имён из формы в виде, который принимает домен: JSON-массив масок. Окно шлёт маски
// списком через запятую, прежняя форма — JSON-массивом: набранное с «[» уходит как есть.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Строка - JSON-массив масок; "" — фильтра нет.
//
Функция ФильтрJSON(Знач Форма) Экспорт

	Набранное = СокрЛП(РазборФормы.Поле(Форма, ИмяПоляФильтра()));
	Если НЕ ЗначениеЗаполнено(Набранное) ИЛИ СтрНачинаетсяС(Набранное, "[") Тогда
		Возврат Набранное;
	КонецЕсли;

	Маски = Новый Массив();
	Для Каждого Маска Из СтрРазделить(Набранное, ",", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Маска)) И Маски.Найти(СокрЛП(Маска)) = Неопределено Тогда
			Маски.Добавить(СокрЛП(Маска));
		КонецЕсли;
	КонецЦикла;
	Если Маски.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Маски);
	Возврат Запись.Закрыть();

КонецФункции

// Включает и выключает зеркало по флажку формы.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//  Пул - Пул - пул зеркала.
//  Идентификатор - Число - номер зеркала.
//  Форма - Соответствие - разобранная форма.
//
Процедура Переключить(Знач Пользователь, Знач Пул, Знач Идентификатор, Знач Форма) Экспорт
	СервисЗеркал.Переключить(Пользователь, Пул, Идентификатор, ВключитьОтмечено(Форма));
КонецПроцедуры

// Отмечен ли в форме тумблер «включено». Включённый тумблер шлёт пару «1» и «0»: решает первое.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Булево.
//
Функция ВключитьОтмечено(Знач Форма) Экспорт
	Возврат РазборФормы.Флажок(Форма, "включить");
КонецФункции

// Ставит зеркало в очередь синхронизации и называет исход одним словом. Слово латиницей:
// оно уезжает в query-строку редиректа, и оба экрана читают его одинаково.
//
// Параметры:
//  Зеркало - Зеркало - запись зеркала.
//  Пользователь - Пользователь, Неопределено - заявитель.
//
// Возвращаемое значение:
//  Строка - "1" заявка принята, "running" прогон уже идёт, "queued" зеркало уже ждёт
//           очереди, "disabled" синхронизация выключена, "rejected" — иное.
//
Функция КодПостановки(Знач Зеркало, Знач Пользователь) Экспорт

	Принято = Очередь.Поставить(Зеркало.Идентификатор, ЛогинЗаявителя(Пользователь));
	Если Принято Тогда
		Возврат "1";
	КонецЕсли;

	Состояние = Очередь.Состояние(Зеркало.Идентификатор);
	Если Состояние = "идёт" Тогда
		Возврат "running";
	ИначеЕсли Состояние = "поставлено" Тогда
		Возврат "queued";
	КонецЕсли;

	Возврат ?(Состояние = "выключено", КодВыключено(), "rejected");

КонецФункции

// Исход «синхронизация выключена»: заявку никто не разберёт, и экран говорит это прямо.
//
// Возвращаемое значение:
//  Строка.
//
Функция КодВыключено() Экспорт
	Возврат "disabled";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Инициатор заявки называется логином: субъект в хабе — логин, а не число.
Функция ЛогинЗаявителя(Знач Пользователь)
	Возврат ?(Пользователь = Неопределено, "", СокрЛП(Строка(Пользователь.Логин)));
КонецФункции

#КонецОбласти

&Прозвище("ПультЗеркал")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Пластилин(Значение = "ОчередьСинхронизацииЗеркал") _Очередь,
	&Пластилин(Значение = "РазборНастроекЗеркала") _Канон,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ИтогПульта") _Итоги) Экспорт

	РазборФормы = _РазборФормы;
	СервисЗеркал = _СервисЗеркал;
	Очередь = _Очередь;
	Канон = _Канон;
	Тексты = _Тексты;
	Сбои = _Сбои;
	Итоги = _Итоги;

КонецПроцедуры
