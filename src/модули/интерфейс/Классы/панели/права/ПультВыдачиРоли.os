// Выдача и отзыв роли на объект раздела «Права доступа». Ход операции у пула и у пакета
// один; вид объекта, идентификатор и слова отказов приносит вызов.

Перем РазборФормы;
Перем Формы;          // ФормаВыдачиРоли — имена полей, типы субъекта и роли окон выдачи и отзыва
Перем СлужбаДоступа;  // СлужбаДоступа (кабинет) — доменная выдача и отзыв
Перем Субъекты;       // СубъектыПрав (вход) — логин/имя группы → идентификатор
Перем Окна;           // ОкноРаздела — подтверждена ли отправка опасной формы
Перем Исходы;         // ИсходОкна — форма исхода
Перем Числа;          // ПриведениеЧисел (основа) — терпимое чтение числа
Перем Сбои;         // ТекстСбоя — причина сбоя человеку и отчёт в журнал
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Вправе ли пользователь выдавать и отзывать роли на объекте раздела. Порог — мейнтейнер
// самого объекта и выше; управления объектом (порог дома настроек) для этого мало.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - инициатор.
//  Раздел - Структура: * Вид - Строка - вид объекта («пакет», «пул»); * Идентификатор - Число - объект раздела.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетВыдавать(Знач Пользователь, Знач Раздел) Экспорт
	Возврат СлужбаДоступа.МожетВыдаватьГрант(Пользователь, Раздел.Вид, Раздел.Идентификатор);
КонецФункции

// Применяет операцию раздела «права доступа». Объект — только объект раздела: поле формы,
// назвавшее другой объект, обязано отбить запрос, а не выполнить его «на том, что нашлось».
// Право выдавать проверяется первым: кто роли не раздаёт, тот получает 403 на любую форму,
// и до домена не доходит.
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Раздел - Структура:
//    * Вид - Строка - вид объекта («пакет», «пул»);
//    * Идентификатор - Число - объект раздела;
//    * ЧужойОбъект - Строка - отказ «объект не этого раздела»;
//    * НеизвестныйСубъект - Строка - отказ «субъекта нет»;
//    * НеСохранено - Строка - шаблон отказа домена с «%1» под причину;
//    * Запрет - Строка - отказ тому, кто роли не раздаёт.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - исход (см. ИсходОкна.Удача): отказ выдачи — в окне выдачи на набранном, отзыв без
//              подтверждения — вопрос окном отзыва, прочие отказы — над разделом.
//
Функция Применить(Знач Пользователь, Знач Раздел, Знач Форма) Экспорт

	// гвард права стоит ДО белого списка и домена: отказ домена пишет попытку в журнал безопасности
	Если НЕ МожетВыдавать(Пользователь, Раздел) Тогда
		Возврат Исходы.Отбито(Раздел.Запрет, 403);
	КонецЕсли;

	Операция = Операция(Форма);
	Если НЕ ЗначениеЗаполнено(Операция) Тогда
		// белый список: неназванная операция — форма старой вкладки, а не выдача роли по умолчанию
		Возврат Исходы.Отбито(Тексты.Текст("access.rights.error.stale"));
	КонецЕсли;

	Если НЕ ОбъектСвой(Форма, Раздел) Тогда
		Возврат Исходы.Отбито(Раздел.ЧужойОбъект);
	КонецЕсли;

	// выдача и отзыв разбираются ОДНИМ разбором: форма подтверждения шлёт те же поля скрытыми
	Разбор = РазборПолей(Форма);
	Если Разбор.Отказы.Количество() > 0 Тогда
		Возврат ОтбитоВОкне(Операция, Исходы.ОтбитоПолями(Разбор.Отказы), Форма);
	КонецЕсли;

	Если Операция = Формы.ОперацияОтзыва() И НЕ Окна.Подтверждено(Форма) Тогда
		// без скрипта форма уходит сразу: сначала вопрос, отзыв — только подтверждённый
		Возврат Исходы.Спросить(Формы.ОперацияОтзыва(), Формы.КлючОтзыва(Разбор.ТипСубъекта, Разбор.Субъект));
	КонецЕсли;

	СубъектИд = Субъекты.Идентификатор(Разбор.ТипСубъекта, Разбор.Субъект);
	Если СубъектИд = 0 Тогда
		Возврат ОтбитоВОкне(Операция,
			Исходы.ОтбитоПолем(Формы.ИмяПоляСубъекта(), Раздел.НеизвестныйСубъект), Форма);
	КонецЕсли;

	Возврат ?(Операция = Формы.ОперацияВыдачи(),
		Выдать(Пользователь, Раздел, Разбор.ТипСубъекта, СубъектИд, Разбор.Роль, Форма),
		Отозвать(Пользователь, Раздел, Разбор.ТипСубъекта, СубъектИд));

КонецФункции

#КонецОбласти

#Область ГраницаОбъекта

// Поля формы — предмет сверки, а не источник данных: подделка обязана дать отказ.
Функция ОбъектСвой(Знач Форма, Знач Раздел)

	Если НРег(СокрЛП(РазборФормы.Поле(Форма, "объект", Раздел.Вид))) <> Раздел.Вид Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НазванЧужойВид(Форма, Раздел.Вид) Тогда
		Возврат Ложь;
	КонецЕсли;

	// у идентификатора два имени — общее «объект_ид» и имя вида; сверка видит оба
	Возврат СвойИдентификатор(Форма, "объект_ид", Раздел.Идентификатор)
		И СвойИдентификатор(Форма, Раздел.Вид, Раздел.Идентификатор);

КонецФункции

// Вид чужой — назван объект, которым раздел не распоряжается: разбирать форму дальше нечего.
Функция НазванЧужойВид(Знач Форма, Знач ВидРаздела)

	Если ТипЗнч(Форма) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Поле Из Форма Цикл
		Имя = НРег(СокрЛП(Строка(Поле.Ключ)));
		Если Имя <> ВидРаздела И СлужбаДоступа.ТипОбъектаПоддерживается(Имя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СвойИдентификатор(Знач Форма, Знач Имя, Знач Идентификатор)

	Присланный = СокрЛП(РазборФормы.Поле(Форма, Имя));
	Возврат НЕ (ЗначениеЗаполнено(Присланный)
		И Числа.ЧислоИлиНоль(Присланный) <> Цел(Идентификатор));

КонецФункции

#КонецОбласти

#Область Разбор

// Поля окна выдачи и подтверждения отзыва: тип субъекта и роль — из белых списков формы (пустое —
// первое в списке, самое слабое), субъект обязателен. Роль отзыву не нужна, но и не мешает.
Функция РазборПолей(Знач Форма)

	Отказы = Новый Соответствие();
	ТипСубъекта = Выбранное(Форма, Формы.ИмяПоляТипа(), Формы.ТипыСубъекта(), Отказы);
	Субъект = СокрЛП(РазборФормы.Поле(Форма, Формы.ИмяПоляСубъекта()));
	Если НЕ ЗначениеЗаполнено(Субъект) Тогда
		Отказы.Вставить(Формы.ИмяПоляСубъекта(), Тексты.Текст("form.error.required"));
	КонецЕсли;
	Роль = Выбранное(Форма, Формы.ИмяПоляРоли(), Формы.Роли(), Отказы);

	Возврат Новый Структура("ТипСубъекта, Субъект, Роль, Отказы", ТипСубъекта, Субъект, Роль, Отказы);

КонецФункции

// Значение вне белого списка — отказ под полем, а не ближайший вариант.
Функция Выбранное(Знач Форма, Знач Имя, Знач Варианты, Отказы)

	Значение = НРег(СокрЛП(РазборФормы.Поле(Форма, Имя)));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Варианты[0];
	КонецЕсли;
	Если Варианты.Найти(Значение) = Неопределено Тогда
		Отказы.Вставить(Имя, Тексты.Текст("form.error.choice"));
		Возврат "";
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Умолчание раздела — ОТКАЗ: подделанное поле и опечатка не попадают в ветку выдачи права.
Функция Операция(Знач Форма)

	Значение = НРег(СокрЛП(РазборФормы.Поле(Форма, Формы.ИмяПоляОперации())));
	Возврат ?(Значение = Формы.ОперацияВыдачи() ИЛИ Значение = Формы.ОперацияОтзыва(),
		Значение, "");

КонецФункции

#КонецОбласти

#Область Операции

// Форма присылает РОЛЬ; потолок («выше собственной нельзя») держит служба доступа.
Функция Выдать(Знач Пользователь, Знач Раздел, Знач ТипСубъекта, Знач СубъектИд, Знач Роль, Знач Форма)

	Попытка
		СлужбаДоступа.ВыдатьРоль(Пользователь, ТипСубъекта, СубъектИд, Раздел.Вид,
			Раздел.Идентификатор, Роль);
	Исключение
		// отказ домена метит РОЛЬ: «выше собственной нельзя» — это про неё
		Текст = СтрШаблон(Раздел.НеСохранено, Сбои.Человеку(ИнформацияОбОшибке()));
		Возврат ОтбитоВОкне(Формы.ОперацияВыдачи(), Исходы.ОтбитоПолем(Формы.ИмяПоляРоли(), Текст), Форма);
	КонецПопытки;

	Возврат Исходы.Удача();

КонецФункции

Функция Отозвать(Знач Пользователь, Знач Раздел, Знач ТипСубъекта, Знач СубъектИд)

	Попытка
		СлужбаДоступа.ОтозватьГрант(Пользователь, ТипСубъекта, СубъектИд, Раздел.Вид,
			Раздел.Идентификатор);
	Исключение
		Возврат Исходы.Отбито(СтрШаблон(Раздел.НеСохранено, Сбои.Человеку(ИнформацияОбОшибке())));
	КонецПопытки;

	Возврат Исходы.Удача();

КонецФункции

// Окно возвращается открытым только форме ВЫДАЧИ: подтверждение отзыва без роли не печатается.
Функция ОтбитоВОкне(Знач Операция, Знач Отказ, Знач Форма)
	Если Операция <> Формы.ОперацияВыдачи() Тогда
		Возврат Отказ;
	КонецЕсли;
	Возврат Исходы.ВОкне(Отказ, Операция, "", Форма);
КонецФункции

#КонецОбласти

&Прозвище("ПультВыдачиРоли")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ФормаВыдачиРоли") _Формы,
	&Пластилин(Значение = "СлужбаДоступа") _СлужбаДоступа,
	&Пластилин(Значение = "СубъектыПрав") _Субъекты,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ИсходОкна") _Исходы,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	Формы = _Формы;
	СлужбаДоступа = _СлужбаДоступа;
	Субъекты = _Субъекты;
	Окна = _Окна;
	Исходы = _Исходы;
	Числа = _Числа;
	Сбои = _Сбои;
	Тексты = _Тексты;

КонецПроцедуры
