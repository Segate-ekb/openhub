// Секция «Права доступа» на объект: таблица действующих ролей с меню ⚙ строки, «Выдать роль» в шапке
// секции, окно выдачи и подтверждение отзыва по адресу. Разметка у пула и у пакета одна, различия
// приносит вызов.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем Форма;             // ФормаВыдачиРоли — окна раздела
Перем ТаблицыПрав;       // ТаблицаПрав — единая таблица прав
Перем СлужбаДоступа;     // СлужбаДоступа (кабинет) — действующие права на объект
Перем Окна;              // ОкноРаздела — адрес окна и его состояние
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секция действующих ролей на объекте раздела.
//
// Параметры:
//  Раздел - Структура:
//    * Вид - Строка - вид объекта («пакет», «пул»);
//    * Идентификатор - Число - объект раздела;
//    * Адрес - Строка - адрес раздела без параметров: от него строятся адреса окон;
//    * Заголовок, Лид, Пусто, ТолькоЧтение, ЗаголовокОкна, ЛидОкна - Строка - подписи раздела;
//    * Сноска - ЭлементЭкрана, Неопределено - строка под таблицей, которую приносит вызов.
//  МожетВыдавать - Булево - вправе ли смотрящий выдавать и отзывать роли на этом объекте.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.Секция.
//
Функция Секция(Знач Раздел, Знач МожетВыдавать, Знач Состояние) Экспорт

	Гранты = СлужбаДоступа.ГрантыНаОбъект(Раздел.Вид, Раздел.Идентификатор);
	Имена = ТаблицыПрав.ИменаСубъектов(Гранты);

	ОкноВыдачи = ?(МожетВыдавать,
		Форма.Окно(Окна.Адрес(Раздел.Адрес, Форма.ОперацияВыдачи()), Раздел.ЗаголовокОкна, Раздел.ЛидОкна,
			Состояние, Раздел.Адрес),
		Неопределено);

	Секция = Кит.Секция(Раздел.Заголовок,
			ТаблицаРолей(Раздел, Гранты, Имена, МожетВыдавать),
			Раздел.Сноска,
			ОговоркаБезПрава(Раздел, МожетВыдавать),
			ОкноВыдачи,
			ОткрытыйОтзыв(Гранты, Имена, МожетВыдавать, Состояние, Раздел.Адрес))
		.Лид(Раздел.Лид).Иконка("замок");
	Если ОкноВыдачи <> Неопределено Тогда
		// у окна выдачи есть адрес: без скрипта кнопка — ссылка на страницу с открытым окном
		Секция.Действия(Кит.Кнопка(Тексты.Текст("access.rights.form.submit")).Основная().Иконка("плюс")
			.Открывает(ОкноВыдачи));
	КонецЕсли;
	Возврат Секция;

КонецФункции

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<ключ>: окно выдачи и подтверждение отзыва.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат Форма.ВидыОкон();
КонецФункции

#КонецОбласти

#Область Таблица

// Меню строки — тому, кто вправе отзывать; остальным таблица без колонки действий.
Функция ТаблицаРолей(Знач Раздел, Знач Гранты, Знач Имена, Знач МожетВыдавать)

	Возврат ТаблицыПрав.Таблица(Новый Структура("Строки, СХвостом, Пусто",
		Строки(Раздел, Гранты, Имена, МожетВыдавать), МожетВыдавать, Раздел.Пусто));

КонецФункции

Функция Строки(Знач Раздел, Знач Гранты, Знач Имена, Знач МожетВыдавать)

	Результат = Новый Массив();
	Для Каждого Право Из Гранты Цикл
		Субъект = ТаблицыПрав.ИмяСубъекта(Право.ТипСубъекта, Право.СубъектИдентификатор, Имена);
		Результат.Добавить(Новый Структура("Грант, Роль, Субъект, Хвост", Право,
			СлужбаДоступа.РольЗаписи(Право), Субъект,
			?(МожетВыдавать, Меню(Раздел, Право.ТипСубъекта, Субъект), Неопределено)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Отзыв спрашивает подтверждение по адресу строки: сотню окон заранее не печатают.
Функция Меню(Знач Раздел, Знач ТипСубъекта, Знач Субъект)

	Возврат Кит.Меню(Тексты.Шаблон("access.rights.menu", Субъект),
		Кит.ОкноПоАдресу(Окна.Адрес(Раздел.Адрес, Форма.ОперацияОтзыва(), Форма.КлючОтзыва(ТипСубъекта, Субъект)),
			Тексты.Текст("access.rights.revoke")).Опасная().Иконка("корзина"));

КонецФункции

// Тому, кто роли не раздаёт, экран одной строкой говорит, почему действий нет.
Функция ОговоркаБезПрава(Знач Раздел, Знач МожетВыдавать)

	Если МожетВыдавать Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Примечание(Раздел.ТолькоЧтение);

КонецФункции

#КонецОбласти

#Область Окна

// Подтверждение отзыва, названное адресом. Роли у субъекта нет — страница без окна.
Функция ОткрытыйОтзыв(Знач Гранты, Знач Имена, Знач МожетВыдавать, Знач Состояние, Знач АдресРаздела)

	Если НЕ МожетВыдавать Тогда
		Возврат Неопределено;
	КонецЕсли;
	Право = ГрантОтзыва(Гранты, Имена, Состояние);
	Если Право = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Форма.Отзыв(Право.ТипСубъекта,
		ТаблицыПрав.ИмяСубъекта(Право.ТипСубъекта, Право.СубъектИдентификатор, Имена),
		СлужбаДоступа.РольЗаписи(Право), АдресРаздела);

КонецФункции

// Запись права субъекта, которого называет ключ окна отзыва, среди прав на объект.
Функция ГрантОтзыва(Знач Гранты, Знач Имена, Знач Состояние)

	Если НЕ Окна.Открыто(Состояние, Форма.ОперацияОтзыва()) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Названный = Форма.СубъектОтзыва(Состояние.Ключ);
	Если Названный = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Право Из Гранты Цикл
		Если НРег(СокрЛП(Строка(Право.ТипСубъекта))) = Названный.ТипСубъекта
			И ТаблицыПрав.ИмяСубъекта(Право.ТипСубъекта, Право.СубъектИдентификатор, Имена) = Названный.Субъект Тогда
			Возврат Право;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаВыдачиРоли")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ФормаВыдачиРоли") _Форма,
	&Пластилин(Значение = "ТаблицаПрав") _ТаблицыПрав,
	&Пластилин(Значение = "СлужбаДоступа") _СлужбаДоступа,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Форма = _Форма;
	ТаблицыПрав = _ТаблицыПрав;
	СлужбаДоступа = _СлужбаДоступа;
	Окна = _Окна;
	Тексты = _Тексты;

КонецПроцедуры
