// Тексты панели прав: таблица прав и выдача роли.

// Кладёт тексты в словарь интерфейса.
//
// Параметры:
//  Словарь - СловарьТекстов - словарь, который собирается из частей.
//
Процедура Наполнить(Знач Словарь) Экспорт

	КлючиПрав(Словарь);

КонецПроцедуры

// Таблица прав и выдача роли.
Процедура КлючиПрав(Словарь)

	Словарь.Добавить("settings.reply.grant.none", "—");
	Словарь.Добавить("settings.reply.grant.read", "чтение");
	Словарь.Добавить("settings.reply.grant.create", "создание");
	Словарь.Добавить("settings.reply.grant.update", "изменение");
	Словарь.Добавить("settings.reply.grant.delete", "удаление");

	// колонки таблицы прав одни на все экраны
	Словарь.Добавить("access.grants.col.subject-type", "Тип субъекта");
	Словарь.Добавить("access.grants.col.subject", "Субъект");
	Словарь.Добавить("access.grants.col.actions", "Действия");
	Словарь.Добавить("access.grants.col.role", "Роль");
	Словарь.Добавить("access.grants.col.object", "Объект");

	Словарь.Добавить("access.rights.revoke", "Отозвать");
	Словарь.Добавить("access.rights.error.operation", "Неизвестная операция раздела «Права доступа»");
	Словарь.Добавить("access.rights.form.subject-type", "Тип субъекта");
	Словарь.Добавить("access.rights.form.subject-type.user", "пользователь");
	Словарь.Добавить("access.rights.form.subject-type.group", "группа пользователей");
	Словарь.Добавить("access.rights.form.subject", "Субъект (логин или имя группы)");
	Словарь.Добавить("access.rights.form.role", "Роль");
	Словарь.Добавить("access.rights.form.role.hint", "Каждая роль включает предыдущую: читатель"
		+ " видит приватный пул, райтер публикует пакеты, мейнтейнер правит настройки"
		+ " и раздаёт роли.");
	Словарь.Добавить("access.rights.form.submit", "Выдать роль");
	Словарь.Добавить("access.rights.role.reader", "читатель");
	Словарь.Добавить("access.rights.role.writer", "райтер");
	Словарь.Добавить("access.rights.role.maintainer", "мейнтейнер");
	Словарь.Добавить("access.rights.role.owner", "владелец");
	Словарь.Добавить("access.rights.role.admin", "админ хаба");

КонецПроцедуры

&Прозвище("ЧастьСловаряТекстов")
&Порядок(70)
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
