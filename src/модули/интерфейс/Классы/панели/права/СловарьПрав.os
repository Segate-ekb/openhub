// Тексты панели прав: таблица прав, окно выдачи роли и подтверждение отзыва.

// Кладёт тексты в словарь интерфейса.
//
// Параметры:
//  Словарь - СловарьТекстов - словарь, который собирается из частей.
//
Процедура Наполнить(Знач Словарь) Экспорт

	КлючиТаблицы(Словарь);
	КлючиВыдачи(Словарь);
	КлючиОтзыва(Словарь);

КонецПроцедуры

// Колонки таблицы прав одни на все экраны; тип субъекта и роль — словами.
Процедура КлючиТаблицы(Словарь)

	Словарь.Добавить("access.grants.col.subject", "Кому");
	Словарь.Добавить("access.grants.col.subject-type", "Тип");
	Словарь.Добавить("access.grants.col.role", "Роль");
	Словарь.Добавить("access.grants.col.object", "Объект");
	Словарь.Добавить("access.grants.subject-type.user", "пользователь");
	Словарь.Добавить("access.grants.subject-type.group", "группа");

	Словарь.Добавить("access.rights.role.reader", "читатель");
	Словарь.Добавить("access.rights.role.writer", "райтер");
	Словарь.Добавить("access.rights.role.maintainer", "мейнтейнер");
	Словарь.Добавить("access.rights.role.owner", "владелец");
	Словарь.Добавить("access.rights.role.admin", "админ хаба");

КонецПроцедуры

// Окно «Выдать роль»: кому, кто и какая роль.
Процедура КлючиВыдачи(Словарь)

	Словарь.Добавить("access.rights.form.subject-type", "Кому");
	Словарь.Добавить("access.rights.form.subject", "Логин или имя группы");
	Словарь.Добавить("access.rights.form.role", "Роль");
	Словарь.Добавить("access.rights.form.role.hint", "Каждая роль включает предыдущую: читатель"
		+ " видит приватный пул, райтер публикует пакеты, мейнтейнер правит настройки"
		+ " и раздаёт роли.");
	Словарь.Добавить("access.rights.form.submit", "Выдать роль");
	Словарь.Добавить("access.rights.error.stale", "Страница устарела: ничего не изменено."
		+ " Обновите её и повторите.");

КонецПроцедуры

// Меню строки и подтверждение отзыва.
Процедура КлючиОтзыва(Словарь)

	Словарь.Добавить("access.rights.menu", "Действия: %1");
	Словарь.Добавить("access.rights.revoke", "Отозвать");
	Словарь.Добавить("access.rights.revoke.title", "Отозвать роль «%1» у %2?");
	Словарь.Добавить("access.rights.revoke.consequence", "Доступ, который давала эта роль,"
		+ " пропадёт сразу. Выдать роль снова можно в любой момент.");

КонецПроцедуры

&Прозвище("ЧастьСловаряТекстов")
&Порядок(70)
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
