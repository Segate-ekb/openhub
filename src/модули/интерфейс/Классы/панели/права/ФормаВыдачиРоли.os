// Окна раздела «Права доступа»: «Выдать роль» и подтверждение отзыва. Поля у пула и у пакета одни
// и те же, поэтому их имена и варианты называет этот класс — по ним окно печатается, а пульт прав
// разбирает и выдачу, и отзыв; заголовок окна приносит вызов.

Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем ТаблицыПрав;   // ТаблицаПрав — подписи ролей и типов субъекта
Перем СервисПрав;    // СервисПрав (права) — имена ролей
Перем Окна;          // ОкноРаздела — набранное и отказы окна
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ИменаПолей

// Поле операции: выдача и отзыв уходят на один адрес раздела.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Поле типа субъекта: пользователь либо группа.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляТипа() Экспорт
	Возврат "тип_субъекта";
КонецФункции

// Поле субъекта: логин пользователя либо имя группы.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляСубъекта() Экспорт
	Возврат "субъект";
КонецФункции

// Поле роли окна выдачи.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляРоли() Экспорт
	Возврат "роль";
КонецФункции

// Значение поля «операция» для выдачи роли.
//
// Возвращаемое значение:
//  Строка
//
Функция ОперацияВыдачи() Экспорт
	Возврат "выдать";
КонецФункции

// Значение поля «операция» для отзыва роли.
//
// Возвращаемое значение:
//  Строка
//
Функция ОперацияОтзыва() Экспорт
	Возврат "отозвать";
КонецФункции

// Типы субъекта, которым выдаётся роль: первым — тип по умолчанию.
//
// Возвращаемое значение:
//  Массив из Строка - значения поля типа субъекта.
//
Функция ТипыСубъекта() Экспорт
	Возврат СтрРазделить("пользователь,группа", ",");
КонецФункции

// Роли, которые выдаёт окно: первой — самая слабая, она же выбрана по умолчанию. Потолок
// («выше собственной нельзя») держит служба доступа, а не форма.
//
// Возвращаемое значение:
//  Массив из Строка - машинные имена ролей.
//
Функция Роли() Экспорт
	Возврат СтрРазделить(СервисПрав.РольЧитатель() + "," + СервисПрав.РольРайтер() + ","
		+ СервисПрав.РольМейнтейнер(), ",");
КонецФункции

#КонецОбласти

#Область Окна

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<ключ>: окно выдачи и подтверждение отзыва.
//
// Возвращаемое значение:
//  Строка - виды через запятую; вид окна совпадает со значением поля «операция» его формы.
//
Функция ВидыОкон() Экспорт
	Возврат ОперацияВыдачи() + "," + ОперацияОтзыва();
КонецФункции

// Ключ окна отзыва: тип субъекта и его имя через дефис (у типа дефиса нет, у имени — бывает).
//
// Параметры:
//  ТипСубъекта - Строка - пользователь | группа.
//  Субъект - Строка - логин либо имя группы.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючОтзыва(Знач ТипСубъекта, Знач Субъект) Экспорт
	Возврат НРег(СокрЛП(Строка(ТипСубъекта))) + "-" + СокрЛП(Строка(Субъект));
КонецФункции

// Субъект, названный ключом окна отзыва.
//
// Параметры:
//  Ключ - Строка - ключ окна (см. КлючОтзыва).
//
// Возвращаемое значение:
//  Структура, Неопределено - ТипСубъекта, Субъект; Неопределено — ключ ничего не называет.
//
Функция СубъектОтзыва(Знач Ключ) Экспорт

	Дефис = СтрНайти(Ключ, "-");
	Если Дефис < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипСубъекта = НРег(Лев(Ключ, Дефис - 1));
	Субъект = Сред(Ключ, Дефис + 1);
	Если НЕ ЗначениеЗаполнено(Субъект) ИЛИ ТипыСубъекта().Найти(ТипСубъекта) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("ТипСубъекта, Субъект", ТипСубъекта, Субъект);

КонецФункции

// Окно «Выдать роль»: на странице всегда, открытым — по адресу или с отбитой формой.
// Первой и выбранной идёт самая слабая роль: промах мышью не должен раздавать мейнтейнеров.
//
// Параметры:
//  АдресОкна - Строка - страница, где окно напечатано открытым: на неё ведёт кнопка «Выдать роль»
//              без скрипта.
//  Заголовок - Строка - имя окна.
//  Лид - Строка - одна строка о том, что делает роль на объекте раздела.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//  АдресРаздела - Строка - адрес раздела без окна: на него ведёт отмена открытого окна.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Окно(Знач АдресОкна, Знач Заголовок, Знач Лид, Знач Состояние, Знач АдресРаздела) Экспорт

	Якорь = "prava-vydat";
	Открыто = Окна.Открыто(Состояние, ОперацияВыдачи());

	Возврат Кит.Окно(Заголовок,
			ОшибкаОкна(Состояние),
			ВыборТипа(Состояние),
			Кит.Поле(ИмяПоляСубъекта(), Тексты.Текст("access.rights.form.subject")).Обязательное()
				.Значение(Окна.Значение(Состояние, ИмяПоляСубъекта())).Пример("alice")
				.Ошибка(Окна.Отказ(Состояние, ИмяПоляСубъекта())),
			ВыборРоли(Состояние),
			Кит.СкрытоеПоле(ИмяПоляОперации(), ОперацияВыдачи()))
		.Лид(Лид)
		.Форма("").БезПерезагрузки().Якорь(Якорь).Адрес(АдресОкна)
		.Открыто(Открыто).АдресЗакрытия(АдресРаздела)
		.Действия(Кит.Кнопка(Тексты.Текст("access.rights.form.submit")).Основная().Иконка("плюс"));

КонецФункции

// Подтверждение отзыва роли: кому и какую роль отзываем. Роль выдаётся снова одним окном,
// поэтому эха имени нет.
//
// Параметры:
//  ТипСубъекта - Строка - пользователь | группа.
//  Субъект - Строка - логин либо имя группы.
//  Роль - Строка - машинное имя отзываемой роли.
//  АдресРаздела - Строка - раздел без окна: туда закрывается подтверждение.
//
// Возвращаемое значение:
//  ЭлементЭкрана - подтверждение, напечатанное открытым.
//
Функция Отзыв(Знач ТипСубъекта, Знач Субъект, Знач Роль, Знач АдресРаздела) Экспорт

	Подпись = ТаблицыПрав.ПодписьРоли(Роль);

	Возврат Кит.Подтверждение(Тексты.Шаблон("access.rights.revoke.title",
				?(ЗначениеЗаполнено(Подпись), Подпись, "—"), Субъект),
			Тексты.Текст("access.rights.revoke.consequence"),
			Кит.СкрытоеПоле(ИмяПоляОперации(), ОперацияОтзыва()),
			Кит.СкрытоеПоле(ИмяПоляТипа(), ТипСубъекта),
			Кит.СкрытоеПоле(ИмяПоляСубъекта(), Субъект))
		.Кнопка(Тексты.Текст("access.rights.revoke"))
		.Форма("").БезПерезагрузки().Якорь("prava-otozvat").Открыто().АдресЗакрытия(АдресРаздела);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыборТипа(Знач Состояние)

	Типы = ТипыСубъекта();
	Подпись = Тексты.Текст("access.rights.form.subject-type");
	Выбор = Кит.Сегменты(ИмяПоляТипа()).Подпись(Подпись)
		.Выбрано(Окна.Значение(Состояние, ИмяПоляТипа(), Типы[0]));
	Для Каждого Тип Из Типы Цикл
		Выбор.Добавить(Кит.Сегмент(Тип, ТаблицыПрав.ПодписьТипа(Тип)));
	КонецЦикла;
	Возврат Кит.Группа(Подпись, Выбор).Вид("простая");

КонецФункции

Функция ВыборРоли(Знач Состояние)

	Роли = Роли();
	Поле = Кит.Поле(ИмяПоляРоли(), Тексты.Текст("access.rights.form.role"));
	Для Каждого Роль Из Роли Цикл
		Поле.Вариант(Роль, ТаблицыПрав.ПодписьРоли(Роль));
	КонецЦикла;
	Возврат Поле.Значение(Окна.Значение(Состояние, ИмяПоляРоли(), Роли[0]))
		.Справка(Тексты.Текст("access.rights.form.role.hint"))
		.Ошибка(Окна.Отказ(Состояние, ИмяПоляРоли()));

КонецФункции

// У сегментов типа своего места для отказа нет — их отказ встаёт над полями окна.
Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Текст = Окна.Отказ(Состояние, ИмяПоляТипа());
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

#КонецОбласти

&Прозвище("ФормаВыдачиРоли")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТаблицаПрав") _ТаблицыПрав,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	ТаблицыПрав = _ТаблицыПрав;
	СервисПрав = _СервисПрав;
	Окна = _Окна;
	Тексты = _Тексты;

КонецПроцедуры
