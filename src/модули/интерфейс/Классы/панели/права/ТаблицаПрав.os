// Таблица прав доступа: одна раскладка на все экраны прав, две оси выдачи («кому дано»
// и «на что дано»), роль и тип субъекта словами, на телефоне — карточки.

Перем Кит;       // Кит (кит) — фабрика элементов экрана
Перем Модели;    // ЧтениеМодели (кит)
Перем Субъекты;  // СубъектыПрав (вход) — логин/имя группы по идентификатору
Перем Тексты;    // ТекстыИнтерфейса (кит) — заголовки колонок, роли и типы словами

#Область ПубличныйИнтерфейс

// Таблица прав из данных.
//
// Параметры:
//  Модель - Структура:
//    * Строки - Массив из Структура:
//      - Грант - запись права (ТипСубъекта, СубъектИдентификатор); на оси «субъекты» по ней
//        печатается тип и резолвится имя субъекта;
//      - Субъект - Строка - имя субъекта, если вызывающий его уже назвал; пустое — «резолвить самим»;
//      - Объект - ЭлементЭкрана - первая ячейка оси «объекты» (имя объекта либо ссылка на него);
//      - Роль - Строка - машинное имя роли записи;
//      - Хвост - ЭлементЭкрана, Неопределено - последняя ячейка: меню строки, ссылка «где править»;
//    * Ось - Строка - "субъекты" (по умолчанию) | "объекты";
//    * ХвостЗаголовок - Строка - заголовок колонки хвоста; пусто — колонки хвоста нет, если её
//      не просит СХвостом;
//    * СХвостом - Булево - колонка хвоста без заголовка: узкая колонка меню ⚙ строки;
//    * Пусто - Строка - текст пустой таблицы.
//
// Возвращаемое значение:
//  ЭлементЭкрана - таблица.
//
Функция Таблица(Знач Модель) Экспорт

	ОсьОбъектов = (НРег(СокрЛП(Модели.Текст(Модель, "Ось", "субъекты"))) = "объекты");
	ХвостЗаголовок = Модели.Текст(Модель, "ХвостЗаголовок");

	Описания = Модели.Список(Модель, "Строки");
	// имена резолвятся только на оси субъектов и только у строк без названного субъекта
	Безымянные = ?(ОсьОбъектов, Новый Массив(), ГрантыБезИмени(Описания));
	Имена = ?(Безымянные.Количество() = 0, Неопределено, ИменаСубъектов(Безымянные));

	Строки = Новый Массив();
	Для Каждого Описание Из Описания Цикл
		Строки.Добавить(?(ОсьОбъектов, СтрокаОбъекта(Описание), СтрокаСубъекта(Описание, Имена)));
	КонецЦикла;

	Таблица = Кит.Таблица(Строки).Вид("карточками").Пустое("—").Пусто(Модели.Текст(Модель, "Пусто"));
	Если ОсьОбъектов Тогда
		Таблица.Колонка("object", Тексты.Текст("access.grants.col.object")).Заглавная();
	Иначе
		Таблица.Колонка("subject", Тексты.Текст("access.grants.col.subject")).Заглавная();
		Таблица.Колонка("type", Тексты.Текст("access.grants.col.subject-type"));
	КонецЕсли;
	Таблица.Колонка("role", Тексты.Текст("access.grants.col.role"));
	// меню ⚙ — узкая колонка без заголовка, как у всех таблиц с меню строки
	Хвост = Таблица.Колонка("tail", ХвостЗаголовок).БезПодписиВЗаписи()
		.Когда(ЗначениеЗаполнено(ХвостЗаголовок) ИЛИ Модели.Флаг(Модель, "СХвостом"));
	Если НЕ ЗначениеЗаполнено(ХвостЗаголовок) Тогда
		Хвост.Вид("узкая");
	КонецЕсли;

	Возврат Таблица;

КонецФункции

// Подпись роли — одна на все экраны прав.
//
// Параметры:
//  Роль - Строка - машинное имя роли (читатель | райтер | мейнтейнер | владелец | админ).
//
// Возвращаемое значение:
//  Строка - роль словами; "" — набор, не совпавший ни с одной ролью (в таблице — прочерк).
//
Функция ПодписьРоли(Знач Роль) Экспорт

	Норм = НРег(СокрЛП(Строка(Роль)));
	Если Норм = "читатель" Тогда
		Возврат Тексты.Текст("access.rights.role.reader");
	ИначеЕсли Норм = "райтер" Тогда
		Возврат Тексты.Текст("access.rights.role.writer");
	ИначеЕсли Норм = "мейнтейнер" Тогда
		Возврат Тексты.Текст("access.rights.role.maintainer");
	ИначеЕсли Норм = "владелец" Тогда
		Возврат Тексты.Текст("access.rights.role.owner");
	ИначеЕсли Норм = "админ" Тогда
		Возврат Тексты.Текст("access.rights.role.admin");
	КонецЕсли;
	Возврат "";

КонецФункции

// Тип субъекта права словами.
//
// Параметры:
//  ТипСубъекта - Строка - пользователь | группа.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПодписьТипа(Знач ТипСубъекта) Экспорт
	Возврат ?(НРег(СокрЛП(Строка(ТипСубъекта))) = "группа",
		Тексты.Текст("access.grants.subject-type.group"), Тексты.Текст("access.grants.subject-type.user"));
КонецФункции

// Имя субъекта права — резолв пары «тип + идентификатор» в логин/имя группы.
//
// Параметры:
//  ТипСубъекта - Строка.
//  СубъектИд - Число.
//  Имена - Соответствие, Неопределено - готовые имена списка, снятые ИменаСубъектов;
//          Неопределено — спросить базу об этом субъекте (необязательный, по умолчанию
//          Неопределено).
//
// Возвращаемое значение:
//  Строка - человеческое имя субъекта.
//
Функция ИмяСубъекта(Знач ТипСубъекта, Знач СубъектИд, Знач Имена = Неопределено) Экспорт
	Возврат Субъекты.Имя(ТипСубъекта, СубъектИд, Имена);
КонецФункции

// Имена субъектов целого списка записей прав — один разрез на тип субъекта вместо
// вопроса на строку.
//
// Параметры:
//  Записи - Массив - записи прав (ТипСубъекта, СубъектИдентификатор).
//
// Возвращаемое значение:
//  Соответствие - готовые имена для формы ИмяСубъекта(ТипСубъекта, СубъектИд, Имена).
//
Функция ИменаСубъектов(Знач Записи) Экспорт
	Возврат Субъекты.Имена(Записи);
КонецФункции

#КонецОбласти

#Область Строки

Функция СтрокаСубъекта(Знач Описание, Знач Имена)

	Грант = Модели.Значение(Описание, "Грант");
	Возврат Новый Структура("subject, type, role, tail",
		ИмяСубъектаСтроки(Описание, Грант, Имена),
		ПодписьТипа(Грант.ТипСубъекта),
		ПодписьРоли(Модели.Текст(Описание, "Роль")),
		Модели.Значение(Описание, "Хвост"));

КонецФункции

Функция СтрокаОбъекта(Знач Описание)

	Возврат Новый Структура("object, role, tail",
		Модели.Значение(Описание, "Объект"),
		ПодписьРоли(Модели.Текст(Описание, "Роль")),
		Модели.Значение(Описание, "Хвост"));

КонецФункции

// Имя, названное вызывающим, печатается как есть, без повторного резолва.
Функция ИмяСубъектаСтроки(Знач Описание, Знач Грант, Знач Имена)

	Названное = Модели.Текст(Описание, "Субъект");

	Возврат ?(ЗначениеЗаполнено(Названное), Названное,
		ИмяСубъекта(Грант.ТипСубъекта, Грант.СубъектИдентификатор, Имена));

КонецФункции

// Записи прав, чьё имя субъекта вызывающий не назвал.
Функция ГрантыБезИмени(Знач Описания)

	Гранты = Новый Массив();
	Для Каждого Описание Из Описания Цикл
		Грант = Модели.Значение(Описание, "Грант");
		Если Грант <> Неопределено И НЕ ЗначениеЗаполнено(Модели.Текст(Описание, "Субъект")) Тогда
			Гранты.Добавить(Грант);
		КонецЕсли;
	КонецЦикла;
	Возврат Гранты;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "СубъектыПрав") _Субъекты,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Модели = _Модели;
	Субъекты = _Субъекты;
	Тексты = _Тексты;

КонецПроцедуры
