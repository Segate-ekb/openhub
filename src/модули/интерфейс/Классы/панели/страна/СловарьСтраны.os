// Тексты панели страны: отказ по стране и атрибуция базы стран.

// Кладёт тексты в словарь интерфейса.
//
// Параметры:
//  Словарь - СловарьТекстов - словарь, который собирается из частей.
//
Процедура Наполнить(Знач Словарь) Экспорт

	КлючиОтказаПоСтране(Словарь);

КонецПроцедуры

// Отказ по стране и атрибуция базы стран.
Процедура КлючиОтказаПоСтране(Словарь)

	// отказ посетителю: ни кода страны, ни «вы из такой-то страны» — только чем войти вместо
	Словарь.Добавить("login.geo.denied",
		"Этот способ входа недоступен из вашего региона.");
	Словарь.Добавить("login.geo.fallback.password",
		"Войдите по логину и паролю — форма на этой странице.");
	Словарь.Добавить("login.geo.fallback.recovery",
		"Пароля нет — нажмите «Забыли пароль?»: ссылка для входа придёт на подтверждённый"
		+ " адрес вашей почты.");
	Словарь.Добавить("login.geo.fallback.other",
		"Либо войдите через другого провайдера из списка ниже.");
	Словарь.Добавить("login.geo.fallback.none",
		"Других способов входа на этом хабе нет — напишите администратору хаба.");

	// тот же отказ в кабинете: человек уже вошёл, и звать его к форме входа незачем
	Словарь.Добавить("login.geo.denied.link",
		"Из вашего региона этого провайдера привязать нельзя.");
	Словарь.Добавить("login.geo.link.fallback.other",
		"Привязать можно другого провайдера из списка ниже.");
	Словарь.Добавить("login.geo.link.fallback.none",
		"Других провайдеров, доступных из вашего региона, нет.");

	// условие лицензии встроенной базы стран
	Словарь.Добавить("geo.attribution.dbip", "IP Geolocation by DB-IP");

КонецПроцедуры

&Прозвище("ЧастьСловаряТекстов")
&Порядок(90)
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
