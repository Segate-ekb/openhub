// Что сказать посетителю, которому провайдер закрыт правилом по стране: без кода страны,
// только чем войти вместо из того, что на этом хабе действительно открыто.

Перем ПарольныйВход;   // ПолитикаПарольногоВхода (вход)
Перем Восстановление;  // ВосстановлениеПароля (вход) — есть ли дорога «забыли пароль»
Перем Тексты;          // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Текст отказа на странице входа: причина и запасной путь одной фразой. Пароль и почта
// названы только здесь — человек ещё не вошёл, и войти ему нужно хоть чем-нибудь.
//
// Параметры:
//  ОткрытыхПровайдеров - Число - сколько провайдеров этому посетителю ещё предлагается.
//
// Возвращаемое значение:
//  Строка.
//
Функция Текст(Знач ОткрытыхПровайдеров) Экспорт

	Части = Новый Массив();
	Части.Добавить(Тексты.Текст("login.geo.denied"));

	Если ПарольДействует() Тогда
		Части.Добавить(Тексты.Текст("login.geo.fallback.password"));
		Если ВосстановлениеДоступно() Тогда
			Части.Добавить(Тексты.Текст("login.geo.fallback.recovery"));
		КонецЕсли;
	КонецЕсли;

	Если ОткрытыхПровайдеров > 0 Тогда
		Части.Добавить(Тексты.Текст("login.geo.fallback.other"));
	КонецЕсли;

	Если Части.Количество() = 1 Тогда
		Части.Добавить(Тексты.Текст("login.geo.fallback.none"));
	КонецЕсли;

	Возврат СтрСоединить(Части, " ");

КонецФункции

// Текст отказа в привязке провайдера из кабинета: запасной путь у неё один — другой провайдер.
//
// Параметры:
//  ОткрытыхПровайдеров - Число - сколько провайдеров этому посетителю ещё предлагается.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстПривязки(Знач ОткрытыхПровайдеров) Экспорт

	Если ОткрытыхПровайдеров > 0 Тогда
		Запасной = Тексты.Текст("login.geo.link.fallback.other");
	Иначе
		Запасной = Тексты.Текст("login.geo.link.fallback.none");
	КонецЕсли;

	Возврат Тексты.Текст("login.geo.denied.link") + " " + Запасной;

КонецФункции

// Код ответа на отказ по правилу.
//
// Возвращаемое значение:
//  Число.
//
Функция Код() Экспорт
	Возврат 403;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Включён ли вход по паролю; нечитаемая политика — не обещаем, но и не падаем.
Функция ПарольДействует()

	Попытка
		Возврат ПарольныйВход.Включён();
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ВосстановлениеДоступно()

	Если Восстановление = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Возврат Восстановление.Доступно();
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

#КонецОбласти

&Прозвище("ОтказПоСтране")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _ПарольныйВход,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ВосстановлениеПароля") _Восстановление = Неопределено) Экспорт

	ПарольныйВход = _ПарольныйВход;
	Тексты = _Тексты;
	Восстановление = _Восстановление;

КонецПроцедуры
