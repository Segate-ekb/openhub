// Блок «Получатели» карточки подписки хаба или пула: свёрнутым — сводка исключений и ссылка,
// открытым — поиск пакета и галки по пулам и пакетам. Открыто дерево одной подписки за раз.

Перем Кит;         // Кит (кит) — фабрика элементов экрана
Перем Исключения;  // СервисИсключенийПодписок (подписки) — дерево получателей и исключения
Перем Имена;       // ИменаПолейПодписки — имена полей и параметров раздела
Перем Бланки;      // БланкРаздела — форма на адресе подписки
Перем Ссылки;      // ПараметрыСсылки (основа) — параметр запроса на адресе
Перем Тексты;      // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Блок «Получатели» подписки. У подписки пакета дерева нет — блока тоже.
//
// Параметры:
//  Параметры - Структура - параметры ВитриныПодписок: Объект, Адрес, Зритель, ДеревоИд, Поиск.
//  Подписка - Вебхук - подписка объекта.
//  Бланк - Структура - бланк подписки: её формы постят на её адрес.
//
// Возвращаемое значение:
//  Произвольный - узел разметки.
//
Функция Блок(Знач Параметры, Знач Подписка, Знач Бланк) Экспорт

	Если НЕ Исключения.ЕстьДерево(Подписка) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Блок = Кит.Группа(Тексты.Текст("subscriptions.recipients.legend"));
	Если Открыто(Параметры, Подписка) Тогда
		Блок.Добавить(Кит.Примечание(Тексты.Текст("subscriptions.recipients.lead")));
		Блок.Добавить(ПоискПакета(Параметры, Подписка));
		Блок.Добавить(Галки(Параметры, Подписка, Бланк));
		Блок.Добавить(КнопкаСвернуть(Параметры));
	Иначе
		Блок.Добавить(Сводка(Параметры, Подписка));
		Блок.Добавить(КнопкаОткрыть(Параметры, Подписка));
	КонецЕсли;
	Возврат Блок;

КонецФункции

// Открыто ли дерево этой подписки: карточку с открытым деревом витрина показывает раскрытой.
//
// Параметры:
//  Параметры - Структура - параметры ВитриныПодписок (ДеревоИд).
//  Подписка - Вебхук - подписка объекта.
//
// Возвращаемое значение:
//  Булево.
//
Функция Открыто(Знач Параметры, Знач Подписка) Экспорт
	Возврат Исключения.ЕстьДерево(Подписка) И ОткрытоеДерево(Параметры) = Идентификатор(Подписка);
КонецФункции

#КонецОбласти

#Область СвёрнутоеДерево

Функция Сводка(Знач Параметры, Знач Подписка)

	Исключено = Исключения.СводкаИсключений(Параметры.Зритель, Параметры.Объект, Подписка.Идентификатор);
	Пулов = Исключено.Пулов;
	Пакетов = Исключено.Пакетов;
	Если Пулов + Пакетов = 0 Тогда
		Возврат Кит.Примечание(Тексты.Текст("subscriptions.recipients.all"));
	КонецЕсли;

	Части = Новый Массив();
	Если Пулов > 0 Тогда
		Части.Добавить(Тексты.Шаблон("subscriptions.recipients.excluded.pools", Пулов));
	КонецЕсли;
	Если Пакетов > 0 Тогда
		Части.Добавить(Тексты.Шаблон("subscriptions.recipients.excluded.packages", Пакетов));
	КонецЕсли;
	Возврат Кит.Примечание(Тексты.Шаблон("subscriptions.recipients.excluded", СтрСоединить(Части, ", ")));

КонецФункции

Функция КнопкаОткрыть(Знач Параметры, Знач Подписка)

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Размер",
		Тексты.Текст("subscriptions.recipients.button.open"),
		Ссылки.Установить(Параметры.Адрес, Имена.ИмяПараметраДерева(), Идентификатор(Подписка)),
		"вторичная", "малый"));

КонецФункции

#КонецОбласти

#Область ОткрытоеДерево

// Поиск — GET на адрес раздела: дерево остаётся открытым, пулы с найденными пакетами раскрыты.
Функция ПоискПакета(Знач Параметры, Знач Подписка)

	Сохраняемые = Новый Массив();
	Сохраняемые.Добавить(Новый Структура("Имя, Значение", Имена.ИмяПараметраДерева(), Идентификатор(Подписка)));

	Возврат Кит.СтрокаПоиска(Новый Структура("Действие, Имя, Метка, Значение, Плейсхолдер, Кнопка, СкрытыеПоля",
		Параметры.Адрес, Имена.ИмяПараметраПоиска(), Тексты.Текст("subscriptions.recipients.find.label"),
		ЗапросПоиска(Параметры), Тексты.Текст("subscriptions.recipients.find.placeholder"),
		Тексты.Текст("subscriptions.recipients.find.button"), Сохраняемые));

КонецФункции

// Форма касается только показанных узлов: их перечень уходит скрытым полем, и пакет,
// появившийся после отрисовки, снятой галкой не считается.
Функция Галки(Знач Параметры, Знач Подписка, Знач Бланк)

	Дерево = Исключения.ДеревоПолучателей(Параметры.Зритель, Параметры.Объект, Подписка.Идентификатор);
	Поиск = НРег(ЗапросПоиска(Параметры));
	Видимое = ВидимаяЧасть(Дерево, Поиск);

	Форма = Бланки.Форма(Бланк, "recipients", "столбик");
	// поиск едет с формой: после сохранения человек возвращается к тому, что нашёл
	Форма.Добавить(Кит.СкрытоеПоле(Имена.ИмяПараметраПоиска(), ЗапросПоиска(Параметры)));
	Для Каждого Ветка Из Видимое Цикл
		Форма.Добавить(?(Дерево.ПодпискаХаба, ВеткаПула(Ветка, ЗначениеЗаполнено(Поиск)), ПакетыПула(Ветка)));
	КонецЦикла;
	Если Видимое.Количество() = 0 Тогда
		Форма.Добавить(ПустоеДерево(ЗапросПоиска(Параметры)));
	КонецЕсли;
	Форма.Добавить(Кит.СкрытоеПоле(Имена.ИмяПоляПоказанныхУзлов(), ПоказанныеУзлы(Видимое, Дерево.ПодпискаХаба)));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Тексты.Текст("subscriptions.recipients.button.save"), "основная", "обычный")));
	Возврат Форма;

КонецФункции

// Пул у подписки хаба — свёрнутая ветка: в шапке имя пула и его признаки, галка пула — первой
// строкой раскрытой ветки. Свёрнутая строка — кнопка раскрытия, управление внутри неё
// вкладывало бы галку в кнопку: скринридер её не назовёт, а щелчок по подписи спорит с раскрытием.
Функция ВеткаПула(Знач Ветка, Знач ПоискЗадан)

	Пул = Ветка.Пул;
	Раскрывашка = Кит.Раскрывашка();
	Если ПоискЗадан Тогда
		Раскрывашка.Открыть();
	КонецЕсли;

	Шапка = Раскрывашка.Шапка();
	Шапка.Добавить(ИмяПула(Пул));
	Шапка.Добавить(ПризнакиПула(Пул));

	Раскрывашка.Добавить(ГалкаУзла("пул", Пул.Идентификатор,
		Тексты.Текст("subscriptions.recipients.pool.check"), НЕ Пул.Исключён));
	Раскрывашка.Добавить(ЛистьяПула(Ветка));
	Возврат Раскрывашка;

КонецФункции

Функция ИмяПула(Знач Пул)

	Надпись = Кит.Надпись("название");
	Надпись.Добавить(Кит.Текст(Пул.Имя));
	Возврат Надпись;

КонецФункции

// У подписки пула ветка одна — её пакеты идут сразу, под счётом пакетов.
Функция ПакетыПула(Знач Ветка)

	Пакеты = Кит.Холст();
	Пакеты.Добавить(ПризнакиПула(Ветка.Пул));
	Пакеты.Добавить(ЛистьяПула(Ветка));
	Возврат Пакеты;

КонецФункции

Функция ПризнакиПула(Знач Пул)

	Плашки = Новый Массив();
	Если Пул.Исключён Тогда
		Плашки.Добавить(Новый Структура("Текст, Вид", Тексты.Текст("subscriptions.recipients.pool.excluded"), "warn"));
	КонецЕсли;
	Если Пул.Приватный Тогда
		Плашки.Добавить(Новый Структура("Текст", Тексты.Текст("subscriptions.recipients.private")));
	КонецЕсли;
	Плашки.Добавить(Новый Структура("Текст", Тексты.Шаблон("subscriptions.recipients.packages",
		Пул.Пакеты.Количество())));
	Если Пул.ИсключеноПакетов > 0 Тогда
		Плашки.Добавить(Новый Структура("Текст, Вид", Тексты.Шаблон("subscriptions.recipients.packages.excluded",
			Пул.ИсключеноПакетов), "warn"));
	КонецЕсли;
	Возврат Кит.РядПлашек(Плашки);

КонецФункции

Функция ЛистьяПула(Знач Ветка)

	Если Ветка.Пул.Пакеты.Количество() = 0 Тогда
		Возврат Кит.Примечание(Тексты.Текст("subscriptions.recipients.pool.empty"));
	КонецЕсли;

	Листья = Кит.Холст();
	Сетка = Листья.Добавить(Кит.Сетка(Новый Структура("Колонки, Плотная", 3, Истина)));
	Для Каждого Пакет Из Ветка.Пакеты Цикл
		Сетка.Добавить(ГалкаУзла("пакет", Пакет.Идентификатор, Пакет.Имя, НЕ Пакет.Исключён));
	КонецЦикла;
	Если Ветка.Пакеты.Количество() < Ветка.Подходящих Тогда
		Листья.Добавить(Кит.Примечание(Тексты.Шаблон("subscriptions.recipients.more",
			Ветка.Пакеты.Количество(), Ветка.Подходящих)));
	КонецЕсли;
	Возврат Листья;

КонецФункции

Функция ПустоеДерево(Знач Поиск)

	Если ЗначениеЗаполнено(Поиск) Тогда
		Возврат Кит.Примечание(Тексты.Шаблон("subscriptions.recipients.notfound", Поиск));
	КонецЕсли;
	Возврат Кит.Примечание(Тексты.Текст("subscriptions.recipients.empty"));

КонецФункции

Функция ГалкаУзла(Знач ТипУзла, Знач Идентификатор, Знач Подпись, Знач Включён)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Отмечено",
		Имена.ИмяПоляУзла(ТипУзла, Идентификатор), Подпись, "флажок", Имена.ЗначениеОтмечено(), Включён));

КонецФункции

Функция КнопкаСвернуть(Знач Параметры)

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Размер",
		Тексты.Текст("subscriptions.recipients.button.close"), Параметры.Адрес, "тихая", "малый"));

КонецФункции

#КонецОбласти

#Область ВидимаяЧасть

// Что из дерева попадает на экран: пулы, где есть подходящие под поиск пакеты (или само имя
// пула подходит); исключённые пакеты первыми и все, включённых — не больше предела на пул.
Функция ВидимаяЧасть(Знач Дерево, Знач Поиск)

	Результат = Новый Массив();
	Для Каждого Пул Из Дерево.Пулы Цикл
		ПулПодходит = НЕ ЗначениеЗаполнено(Поиск) ИЛИ СтрНайти(НРег(Пул.Имя), Поиск) > 0;
		Подходящие = Новый Массив();
		Для Каждого Пакет Из Пул.Пакеты Цикл
			Если ПулПодходит ИЛИ СтрНайти(НРег(Пакет.Имя), Поиск) > 0 Тогда
				Подходящие.Добавить(Пакет);
			КонецЕсли;
		КонецЦикла;
		Если ПулПодходит ИЛИ Подходящие.Количество() > 0 Тогда
			Результат.Добавить(Новый Структура("Пул, Пакеты, Подходящих",
				Пул, ПервыеПакеты(Подходящие), Подходящие.Количество()));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПервыеПакеты(Знач Подходящие)

	Результат = Новый Массив();
	Для Каждого Пакет Из Подходящие Цикл
		Если Пакет.Исключён Тогда
			Результат.Добавить(Пакет);
		КонецЕсли;
	КонецЦикла;
	Включённых = 0;
	Для Каждого Пакет Из Подходящие Цикл
		Если НЕ Пакет.Исключён И Включённых < ПределПакетов() Тогда
			Результат.Добавить(Пакет);
			Включённых = Включённых + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПоказанныеУзлы(Знач Видимое, Знач ПодпискаХаба)

	Ключи = Новый Массив();
	Для Каждого Ветка Из Видимое Цикл
		Если ПодпискаХаба Тогда
			Ключи.Добавить(Имена.КлючУзла("пул", Ветка.Пул.Идентификатор));
		КонецЕсли;
		Для Каждого Пакет Из Ветка.Пакеты Цикл
			Ключи.Добавить(Имена.КлючУзла("пакет", Пакет.Идентификатор));
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Ключи, ",");

КонецФункции

// Сколько пакетов пула показывать без поиска: сотни галок превратили бы карточку в простыню.
Функция ПределПакетов()
	Возврат 100;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОткрытоеДерево(Знач Параметры)
	Значение = Неопределено;
	Параметры.Свойство("ДеревоИд", Значение);
	Возврат СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
КонецФункции

Функция ЗапросПоиска(Знач Параметры)
	Значение = Неопределено;
	Параметры.Свойство("Поиск", Значение);
	Возврат СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
КонецФункции

Функция Идентификатор(Знач Подписка)
	Возврат Формат(Подписка.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

#КонецОбласти

&Прозвище("ДеревоПолучателей")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисИсключенийПодписок") _Исключения,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "БланкРаздела") _Бланки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПараметрыСсылки") _Ссылки = Неопределено) Экспорт

	Кит = _Кит;
	Исключения = _Исключения;
	Имена = _Имена;
	Бланки = _Бланки;
	Тексты = _Тексты;
	Ссылки = ?(_Ссылки = Неопределено, Новый ПараметрыСсылки(), _Ссылки);

КонецПроцедуры
