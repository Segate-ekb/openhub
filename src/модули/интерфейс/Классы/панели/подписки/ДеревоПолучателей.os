// Блок «Получатели» карточки подписки хаба или пула и блок «Получатели в пуле» поправки пула
// к подписке хаба: свёрнутым — сводка исключений и ссылка, открытым — поиск пакета и дерево
// галок; у пула галка «включён / снят / частично» по его пакетам. Открыто дерево одной подписки за раз.

Перем Кит;         // Кит (кит) — фабрика элементов экрана
Перем Исключения;  // СервисИсключенийПодписок (подписки) — дерево получателей и исключения
Перем Поправки;    // СервисПоправокПодписок (подписки) — дерево пакетов пула в его поправке
Перем Имена;       // ИменаПолейПодписки — имена полей и параметров раздела
Перем Бланки;      // БланкРаздела — форма на адресе подписки
Перем Ссылки;      // ПараметрыСсылки (основа) — параметр запроса на адресе
Перем Тексты;      // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Правило;     // ПравилоДереваПолучателей — состояние галки пула
Перем Счёт;        // СчётСловами — число с существительным в нужной форме

#Область ПубличныйИнтерфейс

// Блок «Получатели» подписки. У подписки пакета дерева нет — блока тоже.
//
// Параметры:
//  Параметры - Структура - параметры ВитриныПодписок: Объект, Адрес, Зритель, ДеревоИд, Поиск.
//  Подписка - Вебхук - подписка объекта.
//  Бланк - Структура - бланк подписки: её формы постят на её адрес.
//
// Возвращаемое значение:
//  Произвольный - узел разметки.
//
Функция Блок(Знач Параметры, Знач Подписка, Знач Бланк) Экспорт

	Если НЕ Исключения.ЕстьДерево(Подписка) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Блок = Кит.Группа(Тексты.Текст("subscriptions.recipients.legend"), "раздел");
	Если Открыто(Параметры, Подписка) Тогда
		Дерево = Исключения.ДеревоПолучателей(Параметры.Зритель, Параметры.Объект, Подписка.Идентификатор);
		Блок.Добавить(Кит.Примечание(Тексты.Текст("subscriptions.recipients.lead")));
		Блок.Добавить(ПоискПакета(Параметры, Подписка, Дерево <> Неопределено И Дерево.ГалкиПулов));
		Если Дерево <> Неопределено Тогда
			Блок.Добавить(ФормаГалок(Дерево, Бланк, "recipients", ЗапросПоиска(Параметры), Параметры.Адрес));
		КонецЕсли;
	Иначе
		Блок.Добавить(Кит.Примечание(Сводка(Параметры, Подписка)));
		Блок.Добавить(КнопкаОткрыть(Параметры, Подписка));
	КонецЕсли;
	Возврат Блок;

КонецФункции

// Блок «Получатели в пуле» карточки подписки хаба у пула: какие пакеты пула поправка снимает.
// Пакет, снятый хозяином подписки, в дереве снят и закрыт. У подписки, которую пул пакетами
// не сужает, блока нет.
//
// Параметры:
//  Параметры - Структура - параметры ВитриныПодписокСверху: Объект, Адрес, Зритель, ДеревоИд, Поиск.
//  Подписка - Вебхук - подписка хаба сверху.
//  Бланк - Структура - бланк подписки сверху: её формы постят на её адрес.
//
// Возвращаемое значение:
//  Произвольный - узел разметки.
//
Функция БлокПоправки(Знач Параметры, Знач Подписка, Знач Бланк) Экспорт

	Сводка = Поправки.СводкаПоправки(Параметры.Зритель, Параметры.Объект, Подписка.Идентификатор);
	Если Сводка = Неопределено Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Блок = Кит.Группа(Тексты.Текст("subscriptions.recipients.amendment.legend"), "раздел");
	Если Открыто(Параметры, Подписка) Тогда
		Дерево = Поправки.ДеревоПоправки(Параметры.Зритель, Параметры.Объект, Подписка.Идентификатор);
		Блок.Добавить(Кит.Примечание(Тексты.Текст("subscriptions.recipients.amendment.lead")));
		Блок.Добавить(ПоискПакета(Параметры, Подписка, Ложь));
		Если Дерево <> Неопределено Тогда
			Блок.Добавить(ФормаГалок(Дерево, Бланк, "recipients", ЗапросПоиска(Параметры), Параметры.Адрес));
		КонецЕсли;
	Иначе
		Блок.Добавить(Кит.Примечание(СводкаПоправки(Сводка)));
		Блок.Добавить(КнопкаОткрыть(Параметры, Подписка));
	КонецЕсли;
	Возврат Блок;

КонецФункции

// Открыто ли дерево этой подписки: карточку с открытым деревом витрина показывает раскрытой.
//
// Параметры:
//  Параметры - Структура - параметры ВитриныПодписок (ДеревоИд).
//  Подписка - Вебхук - подписка объекта.
//
// Возвращаемое значение:
//  Булево.
//
Функция Открыто(Знач Параметры, Знач Подписка) Экспорт
	Возврат Исключения.ЕстьДерево(Подписка) И ОткрытоеДерево(Параметры) = Идентификатор(Подписка);
КонецФункции

// Кому подписка сообщает — одной строкой для сводки карточки: «все» или кто исключён.
//
// Параметры:
//  Параметры - Структура - параметры ВитриныПодписок: Объект, Зритель.
//  Подписка - Вебхук - подписка объекта.
//
// Возвращаемое значение:
//  Строка - пустая у подписки пакета: дерева у неё нет.
//
Функция КомуСообщает(Знач Параметры, Знач Подписка) Экспорт

	Если НЕ Исключения.ЕстьДерево(Подписка) Тогда
		Возврат "";
	КонецЕсли;
	Исключено = Исключения.СводкаИсключений(Параметры.Зритель, Параметры.Объект, Подписка.Идентификатор);
	Если Исключено.Пулов + Исключено.Пакетов = 0 Тогда
		Возврат Тексты.Текст("subscriptions.recipients.brief.all");
	КонецЕсли;
	Возврат Тексты.Шаблон("subscriptions.recipients.brief.except", ЧтоИсключено(Исключено, Истина));

КонецФункции

// Форма галок дерева получателей: галки узлов, перечень показанных узлов, поиск и кнопки
// «Сохранить» и «Свернуть». Источник узлов и адрес формы — у вызывающего: форма годится
// любому дереву той же формы.
//
// Параметры:
//  Дерево - Структура - ГалкиПулов (Булево — пулы со своими галками; Ложь — один уровень
//           пакетов) и Пулы (СервисИсключенийПодписок.ДеревоПолучателей,
//           СервисПоправокПодписок.ДеревоПоправки).
//  Бланк - Структура - бланк, на чей адрес постит форма.
//  Действие - Строка - хвост адреса формы в бланке.
//  Поиск - Строка - строка поиска: показаны пулы и пакеты под неё.
//  АдресСвернуть - Строка - куда ведёт «Свернуть».
//
// Возвращаемое значение:
//  ЭлементЭкрана - форма.
//
Функция ФормаГалок(Знач Дерево, Знач Бланк, Знач Действие, Знач Поиск, Знач АдресСвернуть) Экспорт

	Видимое = ВидимаяЧасть(Дерево, НРег(Поиск));

	Форма = Бланки.Форма(Бланк, Действие, "столбик");
	// поиск едет с формой: после сохранения человек возвращается к тому, что нашёл
	Форма.Добавить(Кит.СкрытоеПоле(Имена.ИмяПараметраПоиска(), Поиск));
	Если Видимое.Количество() = 0 Тогда
		Форма.Добавить(ПустоеДерево(Поиск));
	ИначеЕсли Дерево.ГалкиПулов Тогда
		Форма.Добавить(Кит.ДеревоГалок(Новый Структура("Подпись, Узлы",
			Тексты.Текст("subscriptions.recipients.legend"), ПулыДерева(Видимое, ЗначениеЗаполнено(Поиск)))));
	Иначе
		Форма.Добавить(ПакетыПула(Видимое[0]));
	КонецЕсли;
	Форма.Добавить(Кит.СкрытоеПоле(Имена.ИмяПоляПоказанныхУзлов(), ПоказанныеУзлы(Видимое, Дерево.ГалкиПулов)));
	Форма.Добавить(ДействияДерева(АдресСвернуть));
	Возврат Форма;

КонецФункции

#КонецОбласти

#Область СвёрнутоеДерево

Функция Сводка(Знач Параметры, Знач Подписка)

	Исключено = Исключения.СводкаИсключений(Параметры.Зритель, Параметры.Объект, Подписка.Идентификатор);
	Если Исключено.Пулов + Исключено.Пакетов = 0 Тогда
		Возврат Тексты.Текст("subscriptions.recipients.all");
	КонецЕсли;
	Возврат Тексты.Шаблон("subscriptions.recipients.excluded", ЧтоИсключено(Исключено, Ложь));

КонецФункции

// «1 пул и 2 пакета» — в падеже, которого просит фраза: именительном или родительном («кроме»).
Функция ЧтоИсключено(Знач Исключено, Знач ПослеКроме)

	Части = Новый Массив();
	Если Исключено.Пулов > 0 Тогда
		Части.Добавить(?(ПослеКроме, ПуловКроме(Исключено.Пулов), Пулов(Исключено.Пулов)));
	КонецЕсли;
	Если Исключено.Пакетов > 0 Тогда
		Части.Добавить(?(ПослеКроме, ПакетовКроме(Исключено.Пакетов), Пакетов(Исключено.Пакетов)));
	КонецЕсли;
	Возврат СтрСоединить(Части, Тексты.Текст("subscriptions.count.and"));

КонецФункции

// Итог — мимо скольких пакетов идёт подписка; снятые хозяином подписки названы отдельно от снятых пулом.
Функция СводкаПоправки(Знач Сводка)

	Всего = Сводка.СнялПул + Сводка.СнялХозяин;
	Если Всего = 0 Тогда
		Возврат Тексты.Текст("subscriptions.recipients.amendment.all");
	ИначеЕсли Сводка.СнялХозяин = 0 Тогда
		Возврат Тексты.Шаблон("subscriptions.recipients.amendment.except", ПакетовКроме(Всего));
	ИначеЕсли Сводка.СнялПул = 0 Тогда
		Возврат Тексты.Шаблон("subscriptions.recipients.amendment.except.above", Пакетов(Всего));
	КонецЕсли;
	Возврат Тексты.Шаблон("subscriptions.recipients.amendment.except.split", ПакетовКроме(Всего),
		Тексты.ЧислоТекстом(Сводка.СнялПул), Тексты.ЧислоТекстом(Сводка.СнялХозяин));

КонецФункции

Функция Пулов(Знач Число)
	Возврат Счёт.Счёт(Число, Тексты.Текст("subscriptions.count.pools"));
КонецФункции

Функция Пакетов(Знач Число)
	Возврат Счёт.Счёт(Число, Тексты.Текст("subscriptions.count.packages"));
КонецФункции

// После «кроме» — родительный падеж: «кроме 1 пула», «кроме 2 пулов».
Функция ПуловКроме(Знач Число)
	Возврат Счёт.Счёт(Число, Тексты.Текст("subscriptions.count.pools.except"));
КонецФункции

Функция ПакетовКроме(Знач Число)
	Возврат Счёт.Счёт(Число, Тексты.Текст("subscriptions.count.packages.except"));
КонецФункции

Функция КнопкаОткрыть(Знач Параметры, Знач Подписка)

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Размер",
		Тексты.Текст("subscriptions.recipients.button.open"),
		Ссылки.Установить(Параметры.Адрес, Имена.ИмяПараметраДерева(), Идентификатор(Подписка)),
		"вторичная", "малый"));

КонецФункции

#КонецОбласти

#Область ОткрытоеДерево

// Поиск — GET на адрес раздела: дерево остаётся открытым, пулы с найденными пакетами раскрыты.
// В дереве одного пула искать можно только пакет.
Функция ПоискПакета(Знач Параметры, Знач Подписка, Знач ГалкиПулов)

	Сохраняемые = Новый Массив();
	Сохраняемые.Добавить(Новый Структура("Имя, Значение", Имена.ИмяПараметраДерева(), Идентификатор(Подписка)));

	Возврат Кит.СтрокаПоиска(Новый Структура("Действие, Имя, Метка, Значение, Плейсхолдер, Кнопка, СкрытыеПоля",
		Параметры.Адрес, Имена.ИмяПараметраПоиска(), Тексты.Текст("subscriptions.recipients.find.label"),
		ЗапросПоиска(Параметры), ?(ГалкиПулов, Тексты.Текст("subscriptions.recipients.find.placeholder"),
			Тексты.Текст("subscriptions.recipients.find.placeholder.package")),
		Тексты.Текст("subscriptions.recipients.find.button"), Сохраняемые));

КонецФункции

Функция ПулыДерева(Знач Видимое, Знач ПоискЗадан)

	Узлы = Новый Массив();
	Для Каждого Ветка Из Видимое Цикл
		Узлы.Добавить(УзелПула(Ветка, ПоискЗадан));
	КонецЦикла;
	Возврат Узлы;

КонецФункции

// Пул — ветка со своей галкой: «снят» — исключён целиком или сняты все пакеты, «частично» —
// снята часть. Пакеты снятого пула сняты вместе с ним. Скрипту страницы пул сообщает, сколько
// его пакетов не показано и сколько из них снято: по ним галка пула пересчитывается на лету.
Функция УзелПула(Знач Ветка, Знач ПоискЗадан)

	Пул = Ветка.Пул;
	Состояние = Правило.СостояниеПула(Пул);
	Дети = Новый Массив();
	Для Каждого Пакет Из Ветка.Пакеты Цикл
		Дети.Добавить(УзелПакета(Пакет, Состояние = "выкл"));
	КонецЦикла;

	Узел = Новый Структура("Имя, Подпись, Пояснение, Признаки, Состояние, Дети, Открыт, Примечание, Данные");
	Узел.Имя = Имена.ИмяПоляУзла("пул", Пул.Идентификатор);
	Узел.Подпись = Пул.Имя;
	Узел.Пояснение = ПояснениеПула(Пул);
	Узел.Признаки = ПризнакиПула(Пул);
	Узел.Состояние = Состояние;
	Узел.Дети = ?(Пул.Пакеты.Количество() = 0, Неопределено, Дети); // пустой пул — лист: раскрывать нечего
	Узел.Открыт = ПоискЗадан;
	Узел.Примечание = ЕщёПакеты(Ветка);
	Узел.Данные = ДанныеПула(Ветка, Состояние = "выкл");
	Возврат Узел;

КонецФункции

// Пакет, снятый хозяином подписки, снизу не вернуть: галка снята и закрыта.
Функция УзелПакета(Знач Пакет, Знач ПулСнят)

	Узел = Новый Структура("Имя, Подпись, Состояние",
		Имена.ИмяПоляУзла("пакет", Пакет.Идентификатор), Пакет.Имя,
		?(ПулСнят ИЛИ Пакет.Исключён, "выкл", "вкл"));
	Если Пакет.ИсключёнСверху Тогда
		Узел.Вставить("Отключён", Истина);
		Узел.Вставить("Пояснение", Тексты.Текст("subscriptions.recipients.package.above"));
	КонецЕсли;
	Возврат Узел;

КонецФункции

Функция ПояснениеПула(Знач Пул)

	Части = Новый Массив();
	Части.Добавить(Пакетов(Пул.Пакеты.Количество()));
	Если Правило.СостояниеПула(Пул) = "выкл" Тогда
		Части.Добавить(Тексты.Текст("subscriptions.recipients.pool.excluded"));
	ИначеЕсли Пул.ИсключеноПакетов > 0 Тогда
		Части.Добавить(Тексты.Шаблон("subscriptions.recipients.packages.excluded", Пул.ИсключеноПакетов));
	КонецЕсли;
	Возврат СтрСоединить(Части, " · ");

КонецФункции

Функция ПризнакиПула(Знач Пул)

	Признаки = Новый Массив();
	Если Пул.Приватный Тогда
		Признаки.Добавить(Тексты.Текст("subscriptions.recipients.private"));
	КонецЕсли;
	Возврат Признаки;

КонецФункции

// Счёт непоказанных пакетов для скрипта: у снятого пула сняты они все.
Функция ДанныеПула(Знач Ветка, Знач ПулСнят)

	Непоказанных = Ветка.Пул.Пакеты.Количество() - Ветка.Пакеты.Количество();
	СнятоНепоказанных = ?(ПулСнят, Непоказанных, Ветка.Пул.ИсключеноПакетов - ИсключённыхСреди(Ветка.Пакеты));

	Данные = Новый Соответствие();
	Данные.Вставить("tree-rest-on", Формат(Непоказанных - СнятоНепоказанных, "ЧН=0; ЧГ=0"));
	Данные.Вставить("tree-rest-off", Формат(СнятоНепоказанных, "ЧН=0; ЧГ=0"));
	Возврат Данные;

КонецФункции

// У подписки пула уровень один — пакеты её пула.
Функция ПакетыПула(Знач Ветка)

	Узлы = Новый Массив();
	Для Каждого Пакет Из Ветка.Пакеты Цикл
		Узлы.Добавить(УзелПакета(Пакет, Ложь));
	КонецЦикла;

	Пакеты = Кит.Холст();
	Если Узлы.Количество() = 0 Тогда
		Пакеты.Добавить(Кит.Примечание(Тексты.Текст("subscriptions.recipients.pool.empty")));
		Возврат Пакеты;
	КонецЕсли;
	Пакеты.Добавить(Кит.ДеревоГалок(Новый Структура("Подпись, Узлы",
		Тексты.Текст("subscriptions.recipients.legend"), Узлы)));
	Ещё = ЕщёПакеты(Ветка);
	Если ЗначениеЗаполнено(Ещё) Тогда
		Пакеты.Добавить(Кит.Примечание(Ещё));
	КонецЕсли;
	Возврат Пакеты;

КонецФункции

Функция ЕщёПакеты(Знач Ветка)

	Если Ветка.Пакеты.Количество() < Ветка.Подходящих Тогда
		Возврат Тексты.Шаблон("subscriptions.recipients.more", Ветка.Пакеты.Количество(), Ветка.Подходящих);
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ПустоеДерево(Знач Поиск)

	Если ЗначениеЗаполнено(Поиск) Тогда
		Возврат Кит.Примечание(Тексты.Шаблон("subscriptions.recipients.notfound", Поиск));
	КонецЕсли;
	Возврат Кит.Примечание(Тексты.Текст("subscriptions.recipients.empty"));

КонецФункции

Функция ДействияДерева(Знач АдресСвернуть)

	Действия = Кит.Ряд("действия");
	Действия.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Тексты.Текст("subscriptions.recipients.button.save"), "основная", "обычный")));
	Действия.Добавить(Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Размер",
		Тексты.Текст("subscriptions.recipients.button.close"), АдресСвернуть, "вторичная", "малый")));
	Возврат Действия;

КонецФункции

#КонецОбласти

#Область ВидимаяЧасть

// Что из дерева попадает на экран: пулы, где есть подходящие под поиск пакеты (или само имя
// пула подходит); исключённые пакеты первыми и все, включённых — не больше предела на пул.
Функция ВидимаяЧасть(Знач Дерево, Знач Поиск)

	Результат = Новый Массив();
	Для Каждого Пул Из Дерево.Пулы Цикл
		ПулПодходит = НЕ ЗначениеЗаполнено(Поиск) ИЛИ СтрНайти(НРег(Пул.Имя), Поиск) > 0;
		Подходящие = Новый Массив();
		Для Каждого Пакет Из Пул.Пакеты Цикл
			Если ПулПодходит ИЛИ СтрНайти(НРег(Пакет.Имя), Поиск) > 0 Тогда
				Подходящие.Добавить(Пакет);
			КонецЕсли;
		КонецЦикла;
		Если ПулПодходит ИЛИ Подходящие.Количество() > 0 Тогда
			Результат.Добавить(Новый Структура("Пул, Пакеты, Подходящих",
				Пул, ПервыеПакеты(Подходящие), Подходящие.Количество()));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПервыеПакеты(Знач Подходящие)

	Результат = Новый Массив();
	Для Каждого Пакет Из Подходящие Цикл
		Если Пакет.Исключён Тогда
			Результат.Добавить(Пакет);
		КонецЕсли;
	КонецЦикла;
	Включённых = 0;
	Для Каждого Пакет Из Подходящие Цикл
		Если НЕ Пакет.Исключён И Включённых < ПределПакетов() Тогда
			Результат.Добавить(Пакет);
			Включённых = Включённых + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИсключённыхСреди(Знач Пакеты)

	Исключено = 0;
	Для Каждого Пакет Из Пакеты Цикл
		Исключено = Исключено + ?(Пакет.Исключён, 1, 0);
	КонецЦикла;
	Возврат Исключено;

КонецФункции

Функция ПоказанныеУзлы(Знач Видимое, Знач ГалкиПулов)

	Ключи = Новый Массив();
	Для Каждого Ветка Из Видимое Цикл
		Если ГалкиПулов Тогда
			Ключи.Добавить(Имена.КлючУзла("пул", Ветка.Пул.Идентификатор));
		КонецЕсли;
		Для Каждого Пакет Из Ветка.Пакеты Цикл
			Ключи.Добавить(Имена.КлючУзла("пакет", Пакет.Идентификатор));
		КонецЦикла;
	КонецЦикла;
	Возврат СтрСоединить(Ключи, ",");

КонецФункции

// Сколько пакетов пула показывать без поиска: сотни галок превратили бы карточку в простыню.
Функция ПределПакетов()
	Возврат 100;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОткрытоеДерево(Знач Параметры)
	Значение = Неопределено;
	Параметры.Свойство("ДеревоИд", Значение);
	Возврат СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
КонецФункции

Функция ЗапросПоиска(Знач Параметры)
	Значение = Неопределено;
	Параметры.Свойство("Поиск", Значение);
	Возврат СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
КонецФункции

Функция Идентификатор(Знач Подписка)
	Возврат Формат(Подписка.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

#КонецОбласти

&Прозвище("ДеревоПолучателей")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисИсключенийПодписок") _Исключения,
	&Пластилин(Значение = "СервисПоправокПодписок") _Поправки,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "БланкРаздела") _Бланки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПравилоДереваПолучателей") _Правило,
	&Пластилин(Значение = "СчётСловами") _Счёт,
	&Пластилин(Значение = "ПараметрыСсылки") _Ссылки = Неопределено) Экспорт

	Кит = _Кит;
	Исключения = _Исключения;
	Поправки = _Поправки;
	Имена = _Имена;
	Бланки = _Бланки;
	Тексты = _Тексты;
	Правило = _Правило;
	Счёт = _Счёт;
	Ссылки = ?(_Ссылки = Неопределено, Новый ПараметрыСсылки(), _Ссылки);

КонецПроцедуры
