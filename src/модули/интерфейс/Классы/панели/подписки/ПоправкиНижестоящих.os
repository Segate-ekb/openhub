// Блок записи подписки хаба или пула у её хозяина: какие нижестоящие объекты её сузили
// или отключили для себя и действуют ли их поправки сейчас. Всё о поправках — из среза
// страницы (СрезПодписок): блок домен не спрашивает.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем Срезы;             // СрезПодписок — поправки, имена и исключённые пакеты страницы
Перем ПараметрыПодписки; // ПараметрыПодписки (подписки) — разрешение сужать
Перем ПоляСобытий;       // ПоляСобытийПодписки — подписи событий
Перем ОтборТегов;        // ОтборПоТегам (подписки) — действующий отбор поправки
Перем Счёт;              // СчётСловами — число пакетов, исключённых поправкой пула
Перем ЧерезЗапятую;      // СписокЧерезЗапятую (основа)
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Кто сузил подписку снизу. Подписку никто не сужал — блока нет.
//
// Параметры:
//  Подписка - Вебхук - подписка хаба или пула.
//  Срез - Структура - срез своих подписок страницы (СрезПодписок.Своих).
//
// Возвращаемое значение:
//  Произвольный - узел разметки.
//
Функция Блок(Знач Подписка, Знач Срез) Экспорт

	Найденные = Срезы.ПоправкиПодписки(Срез, Подписка);
	Если Найденные.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Блок = Кит.Группа(Тексты.Текст("subscriptions.narrowed.legend")).Вид("раздел");
	Сузившие = Блок.Добавить(Кит.Свойства());
	Для Каждого Поправка Из Найденные Цикл
		Сузившие.Добавить(Кит.Свойство(ИмяОбъекта(Поправка, Срез))).Добавить(Кит.Текст(ЧтоСузил(Поправка, Срез)));
	КонецЦикла;
	Если НЕ ПараметрыПодписки.Свойства(Подписка).СужениеРазрешено Тогда
		Блок.Добавить(Кит.Примечание(Тексты.Текст("subscriptions.narrowed.dormant")));
	КонецЕсли;
	Возврат Блок;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяОбъекта(Знач Поправка, Знач Срез)

	Пул = Срез.Пулы.Получить(Цел(Поправка.ПулИдентификатор));
	ИмяПула = ?(Пул = Неопределено, Номером(Поправка.ПулИдентификатор), Пул.Имя);
	Если НРег(Поправка.ТипОбъекта) = "пул" Тогда
		Возврат Тексты.Шаблон("subscriptions.narrowed.pool", ИмяПула);
	КонецЕсли;

	Пакет = Срез.Пакеты.Получить(Цел(Поправка.ОбъектИдентификатор));
	Возврат Тексты.Шаблон("subscriptions.narrowed.package", ИмяПула,
		?(Пакет = Неопределено, Номером(Поправка.ОбъектИдентификатор), Пакет.Имя));

КонецФункции

Функция Номером(Знач Идентификатор)
	Возврат "#" + Формат(Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

Функция ЧтоСузил(Знач Поправка, Знач Срез)

	Если Поправка.НеПрисылать = Истина Тогда
		Возврат Тексты.Текст("subscriptions.narrowed.muted");
	КонецЕсли;

	Части = Новый Массив();
	Снятые = Новый Массив();
	Для Каждого Тип Из ЧерезЗапятую.Разобрать(Поправка.СнятыеСобытия) Цикл
		Снятые.Добавить(ПоляСобытий.ПодписьТипа(Тип));
	КонецЦикла;
	Если Снятые.Количество() > 0 Тогда
		Части.Добавить(Тексты.Шаблон("subscriptions.narrowed.events", СтрСоединить(Снятые, ", ")));
	КонецЕсли;
	Теги = ОтборТегов.Действующий(Поправка, Поправка.ОтборТегов, Срез.ТегиОбъектов);
	Если Теги.Количество() > 0 Тогда
		Части.Добавить(Тексты.Шаблон("subscriptions.narrowed.tags", СтрСоединить(Теги, ", ")));
	КонецЕсли;
	Исключено = Срезы.ИсключеноПакетов(Срез, Поправка);
	Если Исключено > 0 Тогда
		Части.Добавить(Тексты.Шаблон("subscriptions.narrowed.packages",
			Счёт.Счёт(Исключено, Тексты.Текст("subscriptions.count.packages"))));
	КонецЕсли;
	Возврат СтрСоединить(Части, "; ");

КонецФункции

#КонецОбласти

&Прозвище("ПоправкиНижестоящих")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СрезПодписок") _Срезы,
	&Пластилин(Значение = "ПараметрыПодписки") _ПараметрыПодписки,
	&Пластилин(Значение = "ПоляСобытийПодписки") _ПоляСобытий,
	&Пластилин(Значение = "ОтборПоТегам") _ОтборТегов,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СчётСловами") _Счёт,
	&Пластилин(Значение = "СписокЧерезЗапятую") _ЧерезЗапятую = Неопределено) Экспорт

	Кит = _Кит;
	Срезы = _Срезы;
	ПараметрыПодписки = _ПараметрыПодписки;
	ПоляСобытий = _ПоляСобытий;
	ОтборТегов = _ОтборТегов;
	Тексты = _Тексты;
	Счёт = _Счёт;
	ЧерезЗапятую = ?(_ЧерезЗапятую = Неопределено, Новый СписокЧерезЗапятую(), _ЧерезЗапятую);

КонецПроцедуры
