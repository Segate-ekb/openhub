// Блок карточки подписки хаба или пула у её хозяина: какие нижестоящие объекты её сузили
// или отключили для себя и действуют ли их поправки сейчас.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем Поправки;          // СервисПоправокПодписок (подписки)
Перем ПараметрыПодписки; // ПараметрыПодписки (подписки) — разрешение сужать
Перем СервисПулов;       // СервисПулов (реестр) — имя пула поправки
Перем СервисПакетов;     // СервисПакетов (реестр) — имя пакета поправки
Перем ПоляСобытий;       // ПоляСобытийПодписки — подписи событий
Перем ОтборТегов;        // ОтборПоТегам (подписки) — действующий отбор поправки
Перем ЧерезЗапятую;      // СписокЧерезЗапятую (основа)
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Кто сузил подписку снизу. Подписку никто не сужал — блока нет.
//
// Параметры:
//  Подписка - Вебхук - подписка хаба или пула.
//
// Возвращаемое значение:
//  Произвольный - узел разметки.
//
Функция Блок(Знач Подписка) Экспорт

	Найденные = Поправки.ПоправкиПодписки(Подписка);
	Если Найденные.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Блок = Кит.Группа(Тексты.Текст("subscriptions.narrowed.legend"), "раздел");
	Сузившие = Блок.Добавить(Кит.Свойства());
	Для Каждого Поправка Из Найденные Цикл
		Сузившие.Добавить(Кит.Свойство(ИмяОбъекта(Поправка))).Добавить(Кит.Текст(ЧтоСузил(Поправка)));
	КонецЦикла;
	Если НЕ ПараметрыПодписки.Свойства(Подписка).СужениеРазрешено Тогда
		Блок.Добавить(Кит.Примечание(Тексты.Текст("subscriptions.narrowed.dormant")));
	КонецЕсли;
	Возврат Блок;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Объект, которого больше нет, называет себя номером: поправку снимет его удаление.
Функция ИмяОбъекта(Знач Поправка)

	ИмяПула = ИмяПула(Поправка.ПулИдентификатор);
	Если НРег(Поправка.ТипОбъекта) = "пул" Тогда
		Возврат Тексты.Шаблон("subscriptions.narrowed.pool", ИмяПула);
	КонецЕсли;

	Пакет = СервисПакетов.ПакетПоИдентификатору(Поправка.ОбъектИдентификатор);
	Возврат Тексты.Шаблон("subscriptions.narrowed.package", ИмяПула,
		?(Пакет = Неопределено, Номером(Поправка.ОбъектИдентификатор), Пакет.Имя));

КонецФункции

Функция ИмяПула(Знач Идентификатор)
	Пул = СервисПулов.ПулПоИдентификатору(Идентификатор);
	Возврат ?(Пул = Неопределено, Номером(Идентификатор), Пул.Имя);
КонецФункции

Функция Номером(Знач Идентификатор)
	Возврат "#" + Формат(Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

Функция ЧтоСузил(Знач Поправка)

	Если Поправка.НеПрисылать = Истина Тогда
		Возврат Тексты.Текст("subscriptions.narrowed.muted");
	КонецЕсли;

	Части = Новый Массив();
	Снятые = Новый Массив();
	Для Каждого Тип Из ЧерезЗапятую.Разобрать(Поправка.СнятыеСобытия) Цикл
		Снятые.Добавить(ПоляСобытий.ПодписьТипа(Тип));
	КонецЦикла;
	Если Снятые.Количество() > 0 Тогда
		Части.Добавить(Тексты.Шаблон("subscriptions.narrowed.events", СтрСоединить(Снятые, ", ")));
	КонецЕсли;
	Теги = ОтборТегов.Действующий(Поправка, Поправка.ОтборТегов);
	Если Теги.Количество() > 0 Тогда
		Части.Добавить(Тексты.Шаблон("subscriptions.narrowed.tags", СтрСоединить(Теги, ", ")));
	КонецЕсли;
	Возврат СтрСоединить(Части, "; ");

КонецФункции

#КонецОбласти

&Прозвище("ПоправкиНижестоящих")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисПоправокПодписок") _Поправки,
	&Пластилин(Значение = "ПараметрыПодписки") _ПараметрыПодписки,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "ПоляСобытийПодписки") _ПоляСобытий,
	&Пластилин(Значение = "ОтборПоТегам") _ОтборТегов,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СписокЧерезЗапятую") _ЧерезЗапятую = Неопределено) Экспорт

	ЧерезЗапятую = ?(_ЧерезЗапятую = Неопределено, Новый СписокЧерезЗапятую(), _ЧерезЗапятую);

	Кит = _Кит;
	Поправки = _Поправки;
	ПараметрыПодписки = _ПараметрыПодписки;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	ПоляСобытий = _ПоляСобытий;
	ОтборТегов = _ОтборТегов;
	Тексты = _Тексты;

КонецПроцедуры
