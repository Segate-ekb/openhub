// Окно «Получатели» подписки хаба или пула и окно «Пакеты пула» поправки пула к подписке хаба —
// по адресу ?окно=получатели-<ключ> | пакеты-<ключ>. Итог сверху, ниже — дерево галок кита: над ним
// выбранное вне показанного (видно и снимается и без скрипта), под ним — сводка правок. Пул — строка
// с сегментами режима «Все / Выбранные / Никто»: «все» — пакеты отмечены и заперты, «никакие» — сняты
// и заперты, «выбранные» — правятся и начинаются с того, что было видно (массовая отметка кита). У
// подписки хаба пулы свёрнуты, пакеты приезжают страницами по адресу окна; у подписки пула её пул
// раскрыт и «никакие» не печатается; у поправки — плоский список пакетов. Поиск — по серверу, на сервер —
// только правки, со скриптом и без (поле показанного кита). Тот же адрес отвечает страницей ветки
// и найденным — их берёт скрипт кита, без скрипта страница ветки печатается в окне целиком: строка
// пула с сегментами, запертые или правимые пакеты и ряд выбранного.

Перем Кит;            // Кит (кит) — фабрика элементов экрана и размер страницы дерева галок
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Исключения;     // СервисИсключенийПодписок (подписки) — дерево получателей подписки, режимы
Перем Поправки;       // СервисПоправокПодписок (подписки) — дерево пакетов пула в поправке
Перем Правило;        // ПравилоДереваПолучателей — найденные, длина поиска
Перем Окна;           // ОкноРаздела — отказ окна и адрес раздела с окном
Перем Имена;          // ИменаПолейПодписки — имена галок, ключи узлов
Перем ИменаПодписок;  // ИменаПодписок — имя и ключ подписки
Перем Счёт;           // СчётСловами — число с существительным

#Область ПубличныйИнтерфейс

// Окно «Получатели» своей подписки.
//
// Параметры:
//  Параметры - Структура - параметры ВитриныПодписок: Объект, Адрес, Зритель, Окно, ВидДерева.
//  Подписка - Вебхук - подписка хаба или пула.
//
// Возвращаемое значение:
//  ЭлементЭкрана, Неопределено - окно, напечатанное открытым; Неопределено — дерева у подписки нет.
//
Функция Окно(Знач Параметры, Знач Подписка) Экспорт

	Дерево = Исключения.ДеревоПолучателей(Параметры.Зритель, Параметры.Объект, Подписка.Идентификатор);
	Если Дерево = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовоеОкно(Параметры, Подписка, Дерево, ВидОкна(Ложь), Ложь)
		.Лид(ИтогПолучателей(Дерево))
		.Якорь("podpiska-poluchateli");

КонецФункции

// Окно «Пакеты пула» поправки пула к подписке хаба: пакеты пула галками, снятые хозяином подписки
// закрыты.
//
// Параметры:
//  Параметры - Структура - параметры ВитриныПодписокСверху: Объект, Адрес, Зритель, Окно, ВидДерева.
//  Подписка - Вебхук - подписка хаба сверху.
//
// Возвращаемое значение:
//  ЭлементЭкрана, Неопределено - окно, напечатанное открытым; Неопределено — подписки сверху нет.
//
Функция ОкноПоправки(Знач Параметры, Знач Подписка) Экспорт

	Дерево = Поправки.ДеревоПоправки(Параметры.Зритель, Параметры.Объект, Подписка.Идентификатор);
	Если Дерево = Неопределено ИЛИ Дерево.Пулы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат НовоеОкно(Параметры, Подписка, Дерево, ВидОкна(Истина), Истина)
		.Лид(ИтогПоправки(Дерево.Пулы[0]))
		.Якорь("podpiska-pakety");

КонецФункции

// Адрес двери окна: на него уходит форма, по нему же кит берёт страницы веток и найденное. Дверь
// собирается только здесь — окно, плашки записи и возврат после сохранения берут её отсюда.
//
// Параметры:
//  АдресРаздела - Строка - адрес раздела подписок; пустой — хвост внутри раздела (для формы).
//  Подписка - Вебхук, Строка, Число - подписка или её ключ.
//  Поправка - Булево - окно поправки пула к подписке сверху.
//
// Возвращаемое значение:
//  Строка - «<раздел>/<ключ>/recipients» или «<раздел>/inherited/<ключ>/recipients».
//
Функция АдресДвери(Знач АдресРаздела, Знач Подписка, Знач Поправка) Экспорт
	Если ТипЗнч(Подписка) = Тип("Строка") Тогда
		Ключ = СокрЛП(Подписка);
	ИначеЕсли ТипЗнч(Подписка) = Тип("Число") Тогда
		Ключ = Формат(Подписка, "ЧГ=0; ЧН=0");
	Иначе
		Ключ = ИменаПодписок.Ключ(Подписка);
	КонецЕсли;
	Хвост = ?(Поправка, "inherited/", "") + Ключ + "/recipients";
	Возврат ?(ЗначениеЗаполнено(АдресРаздела), АдресРаздела + "/" + Хвост, Хвост);
КонецФункции

// Вид окна в параметре ?окно: «получатели» у своей подписки, «пакеты» у поправки.
//
// Параметры:
//  Поправка - Булево - окно поправки пула к подписке сверху.
//
// Возвращаемое значение:
//  Строка.
//
Функция ВидОкна(Знач Поправка) Экспорт
	Возврат ?(Поправка, "пакеты", "получатели");
КонецФункции

#КонецОбласти

#Область Окно

// Окно по виду: всё дерево, страница одной ветки или найденное по строке. Без скрипта форма отдаёт
// правки против того, что дерево показало (ПравкиБезСкрипта кита); отмеченное вручную вне показанного
// стоит над деревом рядом плашек с крестиком.
Функция НовоеОкно(Знач Параметры, Знач Подписка, Знач Дерево, Знач Вид, Знач Поправка)

	Ключ = ИменаПодписок.Ключ(Подписка);
	ВидДерева = ВидДерева(Параметры);
	Показ = Новый Структура("Адрес, Раздел, Вид, Ключ, Поправка, ГалкиПулов, Показанные",
		АдресДвери(Параметры.Адрес, Подписка, Поправка), Параметры.Адрес, Вид, Ключ, Поправка,
		Дерево.ГалкиПулов, Новый Соответствие());

	Состояние = Параметры.Окно;
	Если Окна.Открыто(Состояние, Вид, Ключ) И ЗначениеЗаполнено(Окна.Ошибка(Состояние)) Тогда
		Ошибка = Кит.Уведомление(Окна.Ошибка(Состояние)).Вид("err");
	Иначе
		Ошибка = Неопределено;
	КонецЕсли;

	Возврат Кит.Окно(ЗаголовокОкна(Подписка, Поправка), Ошибка, ДеревоОкна(Дерево, ВидДерева, Показ))
		.Действия(Кит.Кнопка(Тексты.Текст("subscriptions.button.save")).Основная().Иконка("сохранить"))
		.АдресЗакрытия(Параметры.Адрес)
		.Форма(АдресДвери("", Подписка, Поправка)).БезПерезагрузки()
		.ВоВесьЭкран().Широкое().Открыто();

КонецФункции

Функция ЗаголовокОкна(Знач Подписка, Знач Поправка)
	Если Поправка Тогда
		Возврат Тексты.Шаблон("subscriptions.recipients.window.amendment", ИменаПодписок.Своей(Подписка));
	КонецЕсли;
	Возврат Тексты.Шаблон("subscriptions.recipients.window", ИменаПодписок.Своей(Подписка));
КонецФункции

Функция ДеревоОкна(Знач Дерево, Знач ВидДерева, Знач Показ)

	Если ЗначениеЗаполнено(ВидДерева.Найти) Тогда
		Возврат Найденное(Дерево, ВидДерева.Найти, Показ);
	ИначеЕсли ЗначениеЗаполнено(ВидДерева.Ветка) Тогда
		Возврат СтраницаВетки(Дерево, ВидДерева.Ветка, ВидДерева.Страница, Показ);
	КонецЕсли;
	Возврат ВсёДерево(Дерево, Показ);

КонецФункции

// Всё дерево: у подписки хаба — пулы строками с режимом, пакеты приезжают при раскрытии; у подписки
// пула — её пул раскрытой веткой с режимом и пакетами; у поправки — пакеты пула списком.
Функция ВсёДерево(Знач Дерево, Знач Показ)

	Если Дерево.Пулы.Количество() = 0 Тогда
		Возврат Кит.Примечание(Тексты.Текст("subscriptions.recipients.empty"));
	ИначеЕсли Показ.Поправка Тогда
		Ветка = Дерево.Пулы[0];
		Узлы = УзлыПакетов(Ветка, Показ, Истина);
		Возврат ДеревоПравок(Кит.ДеревоГалок(Узлы).Подпись(Ветка.Имя).Адрес(Показ.Адрес).Поиск(Показ.Адрес),
			Дерево, Показ);
	КонецЕсли;

	Узлы = Новый Массив();
	Для Каждого Ветка Из Дерево.Пулы Цикл
		Узел = УзелПула(Ветка);
		Если НЕ Показ.ГалкиПулов Тогда
			Узел.Вставить("Дети", УзлыПакетов(Ветка, Показ, Истина));
			Узел.Вставить("Открыт", Истина);
		КонецЕсли;
		Узлы.Добавить(Узел);
	КонецЦикла;
	Возврат ДеревоПравок(Кит.ДеревоГалок(Узлы).Подпись(Тексты.Текст("subscriptions.recipients.tree"))
		.Адрес(Показ.Адрес).Поиск(Показ.Адрес).Режимы(Правило.РежимыОкна(Показ.ГалкиПулов)), Дерево, Показ);

КонецФункции

// Дерево окна отдаёт правки со скриптом и без, считает их у кнопок формы и ставит над собой
// отмеченное, которого на странице нет, — первые ПределРяда плашек и хвост «ещё N». Зовётся, когда
// узлы дерева уже собраны: что показано, ряд берёт из Показ.Показанные; Ветка — ряд одной ветки
// (страница ветки Номер), Неопределено — всех.
Функция ДеревоПравок(Знач ДеревоГалок, Знач Дерево, Знач Показ, Знач Ветка = Неопределено, Знач Номер = 1)

	Отмеченные = ОтмеченныеВнеПоказанного(Дерево, Показ, Ветка);
	Возврат ДеревоГалок.ТолькоПравки().ПравкиБезСкрипта().СводкаПравок()
		.Отмеченные(Отмеченные, ?(Показ.Поправка, Тексты.Текст("subscriptions.recipients.marked.amendment"),
			Тексты.Текст("subscriptions.recipients.marked")))
		.ПределОтмеченных(ПределРяда(), Отмеченные.Количество(), АдресОтмеченных(Дерево, Показ, Ветка, Номер));

КонецФункции

// Страница одной ветки — то, что кит дописывает по «Показать ещё»; без скрипта она стоит в окне вместо
// дерева целиком: строка пула с сегментами режима, пакеты этой страницы (у «все» и «никакие» заперты),
// ряд выбранного вне страницы. У поправки страницы — страницы корня, без режима.
Функция СтраницаВетки(Знач Дерево, Знач КлючВетки, Знач Страница, Знач Показ)

	Если Дерево.Пулы.Количество() = 0 Тогда
		Возврат ВсёДерево(Дерево, Показ);
	КонецЕсли;
	Номер = Макс(1, Страница);
	Разобранный = Имена.РазобратьКлючУзла(КлючВетки);
	Если Показ.Поправка Тогда
		Ветка = Дерево.Пулы[0];
	ИначеЕсли Разобранный = Неопределено ИЛИ Разобранный.ТипУзла <> "пул" Тогда
		Возврат ВсёДерево(Дерево, Показ);
	Иначе
		Ветка = ВеткаПула(Дерево, Разобранный.Идентификатор);
		Если Ветка = Неопределено Тогда
			Возврат ВсёДерево(Дерево, Показ);
		КонецЕсли;
	КонецЕсли;

	Узлы = УзлыПакетов(Ветка, Показ, Ложь);
	Кусок = Новый Массив();
	Для Позиция = (Номер - 1) * РазмерСтраницы() По Мин(Номер * РазмерСтраницы(), Узлы.Количество()) - 1 Цикл
		Кусок.Добавить(Узлы[Позиция]);
		Показ.Показанные.Вставить(Узлы[Позиция].Значение, Истина);
	КонецЦикла;

	Если Показ.Поправка Тогда
		Страница = Кит.ДеревоГалок(Кусок).Подпись(Ветка.Имя).Адрес(Показ.Адрес).ПравкиБезСкрипта()
			.Ветка("", Номер, Узлы.Количество());
	Иначе
		Страница = ДеревоПравок(Кит.ДеревоГалок(Кусок).Подпись(Ветка.Имя).Адрес(Показ.Адрес)
			.Режимы(Правило.РежимыОкна(Показ.ГалкиПулов))
			.Ветка(КлючВетки, Номер, Узлы.Количество(), Ветка.Режим), Дерево, Показ, Ветка, Номер);
	КонецЕсли;
	Возврат Кит.Холст(
		Кит.Кнопка(Тексты.Текст("subscriptions.recipients.back")).Ссылкой().Иконка("влево")
			.Адрес(Окна.Адрес(Показ.Раздел, Показ.Вид, Показ.Ключ)),
		Страница);

КонецФункции

// Найденное по строке: пакеты, чьё имя или имя пула содержит её, — по пулам и именам; у пакета
// подписки хаба подпись «пул/пакет». Сегментов у найденного нет: пакет пула «все» и «никакие» заперт
// с пояснением — его правят в «Выбранных».
Функция Найденное(Знач Дерево, Знач Строка, Знач Показ)

	Найденные = Правило.Найденные(Дерево, Строка);
	Узлы = Новый Массив();
	Для Каждого Найденный Из Найденные Цикл
		Узел = УзелПакета(Найденный.Пакет);
		Если НЕ Найденный.Пакет.ИсключёнСверху И НЕ Правило.ГалкаПравится(Найденный, НЕ Показ.Поправка) Тогда
			Узел.Вставить("Отключён", Истина);
			Узел.Вставить("Пояснение", ?(Найденный.Ветка.Режим = Исключения.РежимВсе(),
				Тексты.Текст("subscriptions.recipients.package.pool.all"),
				Тексты.Текст("subscriptions.recipients.package.pool.none")));
		КонецЕсли;
		Если Показ.ГалкиПулов Тогда
			Узел.Подпись = Найденный.Ветка.Имя + "/" + Найденный.Пакет.Имя;
		КонецЕсли;
		Узлы.Добавить(Узел);
	КонецЦикла;
	Для Позиция = 0 По Мин(РазмерСтраницы(), Узлы.Количество()) - 1 Цикл
		Показ.Показанные.Вставить(Узлы[Позиция].Значение, Истина);
	КонецЦикла;
	Возврат ДеревоПравок(Кит.ДеревоГалок(Узлы).Подпись(Тексты.Текст("subscriptions.recipients.tree"))
		.Поиск(Показ.Адрес).Найдено(Строка, Узлы.Количество()), Дерево, Показ);

КонецФункции

#КонецОбласти

#Область Узлы

// Пул — ветка с сегментами своего режима и плашкой режима; у подписки хаба пакеты приезжают
// страницами при раскрытии. Пул без пакетов — пустая ветка: сегменты режима есть и у него.
Функция УзелПула(Знач Ветка)

	Признаки = Новый Массив();
	Признаки.Добавить(Новый Структура("Текст, Вид", ПодписьРежима(Ветка),
		?(Ветка.Режим = Исключения.РежимВсе(), "", "accent")));
	Если Ветка.Приватный Тогда
		Признаки.Добавить(Тексты.Текст("subscriptions.recipients.private"));
	КонецЕсли;

	Узел = Новый Структура("Имя, Значение, Подпись, Пояснение, Признаки, Режим, Всего",
		Имена.ИмяПоляГалки(), Имена.КлючУзла("пул", Ветка.Идентификатор), Ветка.Имя,
		Пакетов(Ветка.Пакеты.Количество()), Признаки, Ветка.Режим, Ветка.Пакеты.Количество());
	Если Ветка.Пакеты.Количество() = 0 Тогда
		Узел.Вставить("Дети", Новый Массив());
	КонецЕсли;
	Возврат Узел;

КонецФункции

// Пакеты ветки по имени; с Запомнить — первая страница идёт в перечень показанного.
Функция УзлыПакетов(Знач Ветка, Знач Показ, Знач Запомнить)

	Узлы = Новый Массив();
	Для Каждого Пакет Из Ветка.Пакеты Цикл
		Узлы.Добавить(УзелПакета(Пакет));
	КонецЦикла;
	Если Запомнить Тогда
		Для Позиция = 0 По Мин(РазмерСтраницы(), Узлы.Количество()) - 1 Цикл
			Показ.Показанные.Вставить(Узлы[Позиция].Значение, Истина);
		КонецЦикла;
	КонецЕсли;
	Возврат Узлы;

КонецФункции

// Пакет — галка: отмечен, если событие ему достаётся (в «все» — всегда, в «выбранные» — выбран,
// в «никакие» — никогда). Снятый хозяином подписки (в поправке) закрыт.
Функция УзелПакета(Знач Пакет)

	Узел = Новый Структура("Имя, Значение, Подпись, Состояние", Имена.ИмяПоляГалки(),
		Имена.КлючУзла("пакет", Пакет.Идентификатор), Пакет.Имя, ?(Пакет.Исключён, "выкл", "вкл"));
	Если Пакет.ИсключёнСверху Тогда
		Узел.Вставить("Отключён", Истина);
		Узел.Вставить("Пояснение", Тексты.Текст("subscriptions.recipients.package.above"));
	КонецЕсли;
	Возврат Узел;

КонецФункции

// Отмеченное вручную, которого на странице нет: выбранные пакеты пулов «выбранные» (крестик снимает
// выбор), у поправки — снятые пулом (снятыми, крестик возвращает); у пулов «все» и «никакие» всё решает
// режим. У подписки хаба пакет назван «пул/пакет». Ветка — только её пакеты, Неопределено — всех пулов.
Функция ОтмеченныеВнеПоказанного(Знач Дерево, Знач Показ, Знач Ветка = Неопределено)

	Результат = Новый Массив();
	Для Каждого Пул Из Дерево.Пулы Цикл
		Если (НЕ Показ.Поправка И Пул.Режим <> Исключения.РежимВыбранные())
			ИЛИ (Ветка <> Неопределено И Пул.Идентификатор <> Ветка.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Пакет Из Пул.Пакеты Цикл
			Узел = УзелПакета(Пакет);
			Если Пакет.ИсключёнСверху ИЛИ Пакет.Исключён <> Показ.Поправка
				ИЛИ Показ.Показанные.Получить(Узел.Значение) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Показ.ГалкиПулов Тогда
				Узел.Подпись = Пул.Имя + "/" + Пакет.Имя;
			КонецЕсли;
			Результат.Добавить(Узел);
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Куда ведёт хвост «ещё N» ряда отмеченного: отмеченное одной ветки лежит на её страницах — на первую
// страницу ветки, кроме текущей (у поправки — корня); у подписки хаба хвост называет пакеты разных
// пулов — текстом, без адреса.
Функция АдресОтмеченных(Знач Дерево, Знач Показ, Знач Ветка, Знач Номер)

	Если Ветка = Неопределено И (Показ.ГалкиПулов ИЛИ Дерево.Пулы.Количество() <> 1) Тогда
		Возврат "";
	КонецЕсли;
	Другая = ?(Номер = 1, 2, 1);
	Если Показ.Поправка Тогда
		Возврат Кит.АдресСтраницы(Показ.Адрес, Другая, "страница");
	КонецЕсли;
	Пул = ?(Ветка = Неопределено, Дерево.Пулы[0], Ветка);
	Параметры = Новый Массив();
	Параметры.Добавить(Новый Структура("Имя, Значение", "ветка", Имена.КлючУзла("пул", Пул.Идентификатор)));
	Возврат Кит.АдресСтраницы(Показ.Адрес, Другая, "страница", Параметры);

КонецФункции

#КонецОбласти

#Область Итог

// «Получают 3 пула · 212 пакетов» у подписки хаба, «Получают 198 пакетов из 200» у подписки пула;
// дальше — попадают ли новые пакеты сами: у подписки пула — по её режиму.
Функция ИтогПолучателей(Знач Дерево)

	Пулов = 0;
	Получают = 0;
	ВсегоПакетов = 0;
	Для Каждого Ветка Из Дерево.Пулы Цикл
		ВсегоПакетов = ВсегоПакетов + Ветка.Пакеты.Количество();
		Если Ветка.Режим = Исключения.РежимНикакие() Тогда
			Продолжить;
		КонецЕсли;
		Пулов = Пулов + 1;
		Получают = Получают + Ветка.Пакеты.Количество() - Ветка.ИсключеноПакетов;
	КонецЦикла;

	Если Дерево.ГалкиПулов Тогда
		Возврат Тексты.Шаблон("subscriptions.recipients.lead.hub", Счёт.Счёт(Пулов,
			Тексты.Текст("subscriptions.count.pools")), Пакетов(Получают));
	ИначеЕсли Дерево.Пулы.Количество() > 0 И Дерево.Пулы[0].Режим = Исключения.РежимВыбранные() Тогда
		Возврат Тексты.Шаблон("subscriptions.recipients.lead.pool.picked", Пакетов(Получают),
			Формат(ВсегоПакетов, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	Возврат Тексты.Шаблон("subscriptions.recipients.lead.pool", Пакетов(Получают), Формат(ВсегоПакетов, "ЧН=0; ЧГ=0"));

КонецФункции

// Сколько пакетов пула подписка хаба обходит: снятых пулом и хозяином подписки.
Функция ИтогПоправки(Знач Ветка)

	СнялПул = 0;
	СнялХозяин = 0;
	Для Каждого Пакет Из Ветка.Пакеты Цикл
		Если Пакет.ИсключёнСверху Тогда
			СнялХозяин = СнялХозяин + 1;
		ИначеЕсли Пакет.Исключён Тогда
			СнялПул = СнялПул + 1;
		КонецЕсли;
	КонецЦикла;

	Всего = СнялПул + СнялХозяин;
	Если Всего = 0 Тогда
		Возврат Тексты.Текст("subscriptions.recipients.amendment.all");
	ИначеЕсли СнялХозяин = 0 Тогда
		Возврат Тексты.Шаблон("subscriptions.recipients.amendment.except", ПакетовКроме(Всего));
	ИначеЕсли СнялПул = 0 Тогда
		Возврат Тексты.Шаблон("subscriptions.recipients.amendment.except.above", Пакетов(Всего));
	КонецЕсли;
	Возврат Тексты.Шаблон("subscriptions.recipients.amendment.except.split", ПакетовКроме(Всего),
		Тексты.ЧислоТекстом(СнялПул), Тексты.ЧислоТекстом(СнялХозяин));

КонецФункции

// Плашка режима пула: «все», «выбранные: 12», «никто».
Функция ПодписьРежима(Знач Ветка)

	Если Ветка.Режим = Исключения.РежимНикакие() Тогда
		Возврат Тексты.Текст("subscriptions.recipients.mode.none");
	ИначеЕсли Ветка.Режим = Исключения.РежимВыбранные() Тогда
		Возврат Тексты.Шаблон("subscriptions.recipients.mode.picked",
			Формат(Ветка.Пакеты.Количество() - Ветка.ИсключеноПакетов, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	Возврат Тексты.Текст("subscriptions.recipients.mode.all");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВидДерева(Знач Параметры)

	Вид = Неопределено;
	Параметры.Свойство("ВидДерева", Вид);
	Результат = Новый Структура("Найти, Ветка, Страница", "", "", 1);
	Если Вид <> Неопределено Тогда
		Если СтрДлина(СокрЛП(Вид.Найти)) >= Правило.ДлинаПоиска() Тогда
			Результат.Найти = СокрЛП(Вид.Найти);
		КонецЕсли;
		Результат.Ветка = СокрЛП(Вид.Ветка);
		Результат.Страница = Вид.Страница;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ВеткаПула(Знач Дерево, Знач ПулИдентификатор)
	Для Каждого Ветка Из Дерево.Пулы Цикл
		Если Ветка.Идентификатор = Цел(ПулИдентификатор) Тогда
			Возврат Ветка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция Пакетов(Знач Число)
	Возврат Счёт.Счёт(Число, Тексты.Текст("subscriptions.count.packages"));
КонецФункции

Функция ПакетовКроме(Знач Число)
	Возврат Счёт.Счёт(Число, Тексты.Текст("subscriptions.count.packages.except"));
КонецФункции

// Сколько пакетов ветка печатает за раз — столько же кит берёт одной страницей.
Функция РазмерСтраницы()
	Возврат Кит.РазмерСтраницыДерева();
КонецФункции

// Сколько плашек ряда отмеченного окно печатает до хвоста «ещё N»: ряд — сводка того, чего на странице
// нет, а не второй список; полностью отмеченное видно на страницах веток. Двадцать — как первые узлы
// окна выпуска токена.
Функция ПределРяда()
	Возврат 20;
КонецФункции

#КонецОбласти

&Прозвище("ОкноПолучателей")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисИсключенийПодписок") _Исключения,
	&Пластилин(Значение = "СервисПоправокПодписок") _Поправки,
	&Пластилин(Значение = "ПравилоДереваПолучателей") _Правило,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "ИменаПодписок") _ИменаПодписок,
	&Пластилин(Значение = "СчётСловами") _Счёт) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	Исключения = _Исключения;
	Поправки = _Поправки;
	Правило = _Правило;
	Окна = _Окна;
	Имена = _Имена;
	ИменаПодписок = _ИменаПодписок;
	Счёт = _Счёт;

КонецПроцедуры
