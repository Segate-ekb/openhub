// Окна подписки: «Новая подписка» шагами «Куда», «О чём», «Текст», правка — те же шаги вкладками,
// подтверждение удаления с именем подписки и окно секрета подписи, показанного один раз. Набранное
// и отказы отбитой формы окно берёт у состояния окна раздела, итог пробы и сообщение предпросмотра —
// у параметров раздела.

Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем Окна;           // ОкноРаздела — набранное и отказы окна, адрес окна
Перем СервисПодписок; // СервисПодписок (подписки) — тип, значения правки и проба подписки
Перем Поправки;       // СервисПоправокПодписок (подписки) — что пропадёт с подпиской
Перем ПараметрыПодписки; // ПараметрыПодписки (подписки) — сохранённый отбор по тегам
Перем ПоляКанала;     // ПоляПодписки — поля канала и текста по декларации
Перем ПоляСобытий;    // ПоляСобытийПодписки — флажки событий и пороги
Перем ПоляСвойств;    // ПоляСвойствПодписки — название и сужение снизу
Перем ОтборТегов;     // ОтборТеговПодписки — галки тегов
Перем Проверка;       // ПроверкаПодпискиДоСохранения — предпросмотр и проба до сохранения
Перем Каталог;        // КаталогДействийПодписки — типы с текстом
Перем Имена;          // ИменаПолейПодписки — имя поля подтверждения
Перем ИменаПодписок;  // ИменаПодписок — имя подписки в заголовке и эхе
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Окно «Новая подписка»: печатается на странице всегда, открытым — по адресу ?окно=новая, с отбитой
// формой, итогом пробы или сообщением предпросмотра.
//
// Параметры:
//  Параметры - Структура - параметры ВитриныПодписок: Объект, Адрес, АдресТегов, Окно, Проба,
//              Предпросмотр.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел окна.
//
Функция Заведение(Знач Параметры) Экспорт

	Состояние = СвоёСостояние(Параметры, "новая", "");
	Возврат Кит.Окно(Тексты.Текст("subscriptions.form.title"),
			ОшибкаОкна(Состояние),
			Кит.Шаги(
				Кит.Шаг(Тексты.Текст("subscriptions.step.where"),
					ПоляСвойств.Название(Неопределено, Состояние),
					ПоляКанала.ВыборКанала(Состояние)),
				Кит.Шаг(Тексты.Текст("subscriptions.step.what"),
					ПоляСобытий.Набор(Параметры.Объект, Неопределено, Состояние),
					ОтборТегов.Галки(Параметры.Объект, Неопределено, Новый Массив(), Состояние,
						Параметры.АдресТегов),
					ПоляСвойств.СужениеСнизу(Параметры.Объект, Неопределено, Состояние),
					ОКомСообщает(Параметры.Объект)),
				ШагТекста(Параметры, Состояние, ТекстыЗаведения(Параметры, Состояние),
					Проверка.КнопкаПробы(АдресДействия(Параметры, "", "test"))))
				.Кнопка(Кит.Кнопка(Тексты.Текст("subscriptions.button.create")).Основная().Иконка("плюс")))
		.Форма("").Якорь("podpiska-novaya")
		.Адрес(Окна.Адрес(Параметры.Адрес, "новая"))
		.Открыто(Окна.Открыто(Состояние, "новая")).АдресЗакрытия(Параметры.Адрес);

КонецФункции

// Окно «Изменить»: те же шаги вкладками; способ доставки не меняется, секреты в поля не выходят.
//
// Параметры:
//  Параметры - Структура - параметры ВитриныПодписок.
//  Подписка - Вебхук - правимая подписка.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел окна, напечатанный открытым.
//
Функция Правка(Знач Параметры, Знач Подписка) Экспорт

	Ключ = ИменаПодписок.Ключ(Подписка);
	Состояние = СвоёСостояние(Параметры, "изменить", Ключ);
	Тип = СервисПодписок.ТипДействияПодписки(Подписка);
	Значения = СервисПодписок.ЗначенияПравки(Подписка);

	Текст = Кит.Холст(
		ПоляКанала.ПоляТекста(Тип, Состояние, Значения),
		Проверка.МестоПредпросмотра(АдресДействия(Параметры, Ключ, "preview"), Тип,
			СвойИтог(Состояние, Параметры.Предпросмотр)),
		Проверка.КнопкаПредпросмотра(АдресДействия(Параметры, Ключ, "preview"), Тип));
	Проба = ?(Проверка.ПробаПоддержана(Тип), Проверка.КнопкаПробы(АдресДействия(Параметры, Ключ, "test")),
		Неопределено);

	Возврат Кит.Окно(Тексты.Шаблон("subscriptions.window.edit", ИменаПодписок.Своей(Подписка)),
			ОшибкаОкна(Состояние),
			Кит.Шаги(
				Кит.Шаг(Тексты.Текст("subscriptions.step.where"),
					ПоляСвойств.Название(Подписка, Состояние),
					ПоляКанала.КаналПравки(Тип, Значения, Состояние)),
				Кит.Шаг(Тексты.Текст("subscriptions.step.what"),
					ПоляСобытий.Набор(Параметры.Объект, Подписка, Состояние),
					ОтборТегов.Галки(Параметры.Объект, Подписка, ПараметрыПодписки.Свойства(Подписка).ОтборТегов,
						Состояние, Параметры.АдресТегов),
					ПоляСвойств.СужениеСнизу(Параметры.Объект, Подписка, Состояние)),
				ШагТекста(Параметры, Состояние, Текст, Проба)
					.Когда(ПоляКанала.ЕстьТекст(Тип) ИЛИ Проба <> Неопределено))
				.Вид("вкладки")
				.Кнопка(Кит.Кнопка(Тексты.Текст("subscriptions.button.save")).Основная().Иконка("сохранить")))
		.Форма(Ключ + "/save").Якорь("podpiska-pravka").Открыто().АдресЗакрытия(Параметры.Адрес);

КонецФункции

// Подтверждение удаления: называет подписку и то, что пропадёт с ней, спрашивает её имя.
//
// Параметры:
//  Параметры - Структура - параметры ВитриныПодписок.
//  Подписка - Вебхук - удаляемая подписка.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел подтверждения, напечатанный открытым.
//
Функция Удаление(Знач Параметры, Знач Подписка) Экспорт

	Ключ = ИменаПодписок.Ключ(Подписка);
	Имя = ИменаПодписок.Своей(Подписка);
	Состояние = СвоёСостояние(Параметры, "удалить", Ключ);
	Возврат Кит.Подтверждение(Тексты.Шаблон("subscriptions.delete.title", Имя), Последствия(Подписка))
		.Эхо(Имена.ИмяПоляЭха(), Имя, Тексты.Текст("subscriptions.delete.echo"))
		.Кнопка(Тексты.Текст("subscriptions.button.delete"))
		.Ошибка(Окна.Отказ(Состояние, Имена.ИмяПоляЭха()))
		.Форма(Ключ + "/delete").БезПерезагрузки().Якорь("podpiska-udalit").Открыто()
		.АдресЗакрытия(Параметры.Адрес);

КонецФункции

// Окно секрета подписи: показан один раз, здесь, с копированием. Окно — ответ формы: крестик,
// «Закрыть» и Esc уводят переходом на раздел — страницу без секрета — и со скриптом.
//
// Параметры:
//  Секрет - Строка - секрет подписи.
//  Адрес - Строка - адрес раздела подписок.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел окна, напечатанный открытым.
//
Функция Секрет(Знач Секрет, Знач Адрес) Экспорт

	Возврат Кит.Окно(Тексты.Текст("subscriptions.secret.title"),
			Кит.Свойства(
				Кит.Свойство(Тексты.Текст("subscriptions.secret.label"), Кит.Код(Секрет)).Копируемое(Секрет)))
		.Лид(Тексты.Текст("subscriptions.notice.created"))
		.Якорь("podpiska-sekret").Открыто()
		.АдресЗакрытия(Адрес).Переходом();

КонецФункции

#КонецОбласти

#Область ШагТекста

// Текст уведомления, его предпросмотр и проба — последним шагом: открыт сам, когда окно вернулось
// с итогом пробы или сообщением предпросмотра.
Функция ШагТекста(Знач Параметры, Знач Состояние, Знач Текст, Знач Проба)

	ИтогПробы = СвойИтог(Состояние, Параметры.Проба);
	Шаг = Кит.Шаг(Тексты.Текст("subscriptions.step.text"),
		Текст,
		?(ИтогПробы = Неопределено, Неопределено, Проверка.ИтогПробы(ИтогПробы)),
		Проба);
	Если ИтогПробы <> Неопределено ИЛИ СвойИтог(Состояние, Параметры.Предпросмотр) <> Неопределено Тогда
		Шаг.Текущий();
	КонецЕсли;
	Возврат Шаг;

КонецФункции

// Итог пробы и сообщение предпросмотра принадлежат открытому окну: в чужое окно они не ложатся.
Функция СвойИтог(Знач Состояние, Знач Итог)
	Возврат ?(Состояние = Неопределено, Неопределено, Итог);
КонецФункции

// У нового окна канал ещё не выбран: текст каждого канала с текстом — панелью его сегмента на шаге
// «Текст», видна панель отмеченного канала (и без скрипта). Новый способ доставки с текстом встаёт
// сам (НФТ-ПОДП-007). Поля спрятанных панелей уходят пустыми и не читаются.
Функция ТекстыЗаведения(Знач Параметры, Знач Состояние)

	Панели = Кит.Холст();
	Адрес = АдресДействия(Параметры, "", "preview");
	Для Каждого Описание Из Каталог.Все() Цикл
		Если ПоляКанала.ЕстьТекст(Описание.Тип) Тогда
			Панели.Добавить(Кит.ПанельСегмента(Имена.ИмяПоляТипа(), Описание.Тип,
				ПоляКанала.ПоляТекста(Описание.Тип, Состояние),
				Проверка.МестоПредпросмотра(Адрес, Описание.Тип, ПредпросмотрТипа(Параметры, Состояние, Описание.Тип)),
				Проверка.КнопкаПредпросмотра(Адрес, Описание.Тип)));
		КонецЕсли;
	КонецЦикла;
	Возврат Панели;

КонецФункции

// Сообщение предпросмотра — у области того канала, которым его собирали.
Функция ПредпросмотрТипа(Знач Параметры, Знач Состояние, Знач Тип)

	Если СвойИтог(Состояние, Параметры.Предпросмотр) = Неопределено
		ИЛИ Каталог.КлючТипа(Окна.Значение(Состояние, Имена.ИмяПоляТипа())) <> Каталог.КлючТипа(Тип) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Параметры.Предпросмотр;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Состояние окна — только своё: отбитая форма другого окна в это не возвращается.
Функция СвоёСостояние(Знач Параметры, Знач Вид, Знач Ключ)
	Состояние = Параметры.Окно;
	Возврат ?(Окна.Открыто(Состояние, Вид, Ключ), Состояние, Неопределено);
КонецФункции

// Кого касается новая подписка — одной строкой: исключить лишних можно после создания.
Функция ОКомСообщает(Знач Объект)

	ТипОбъекта = НРег(СокрЛП(Строка(Объект.ТипОбъекта)));
	Если ТипОбъекта = "пакет" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Примечание(?(ТипОбъекта = "пул", Тексты.Текст("subscriptions.form.whom.recipients.pool.new"),
		Тексты.Текст("subscriptions.form.whom.recipients.new")));

КонецФункции

// Удаление уносит уведомления и поправки нижестоящих: о них сказано до подтверждения.
Функция Последствия(Знач Подписка)

	Сузили = ?(НРег(Подписка.ТипОбъекта) = "пакет", 0, Поправки.ПоправкиПодписки(Подписка).Количество());
	Если Сузили = 0 Тогда
		Возврат Тексты.Текст("subscriptions.delete.consequence");
	КонецЕсли;
	Возврат Тексты.Шаблон("subscriptions.delete.consequence.narrowed", Формат(Сузили, "ЧГ=0"));

КонецФункции

// Адрес действия окна: «<раздел>/test», «<раздел>/<ключ>/preview».
Функция АдресДействия(Знач Параметры, Знач Ключ, Знач Действие)
	Возврат Параметры.Адрес + "/" + ?(ЗначениеЗаполнено(Ключ), Ключ + "/", "") + Действие;
КонецФункции

// Отказ домена, который не относится к одному полю, — над шагами.
Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

#КонецОбласти

&Прозвище("ОкноПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "СервисПоправокПодписок") _Поправки,
	&Пластилин(Значение = "ПараметрыПодписки") _ПараметрыПодписки,
	&Пластилин(Значение = "ПоляПодписки") _ПоляКанала,
	&Пластилин(Значение = "ПоляСобытийПодписки") _ПоляСобытий,
	&Пластилин(Значение = "ПоляСвойствПодписки") _ПоляСвойств,
	&Пластилин(Значение = "ОтборТеговПодписки") _ОтборТегов,
	&Пластилин(Значение = "ПроверкаПодпискиДоСохранения") _Проверка,
	&Пластилин(Значение = "КаталогДействийПодписки") _Каталог,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "ИменаПодписок") _ИменаПодписок,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Окна = _Окна;
	СервисПодписок = _СервисПодписок;
	Поправки = _Поправки;
	ПараметрыПодписки = _ПараметрыПодписки;
	ПоляКанала = _ПоляКанала;
	ПоляСобытий = _ПоляСобытий;
	ПоляСвойств = _ПоляСвойств;
	ОтборТегов = _ОтборТегов;
	Проверка = _Проверка;
	Каталог = _Каталог;
	Имена = _Имена;
	ИменаПодписок = _ИменаПодписок;
	Тексты = _Тексты;

КонецПроцедуры
