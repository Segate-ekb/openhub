// Операции раздела «Подписки»: создание, правка, переключение, проба и удаление подписки,
// предпросмотр уведомления, галки её дерева получателей, поправка к подписке сверху и галки
// пакетов пула в ней.

Перем РазборФормы;
Перем Сбои;         // ТекстСбоя — причина сбоя человеку и отчёт в журнал
Перем СервисПодписок; // СервисПодписок (подписки)
Перем Разбор;         // РазборФормыПодписки — форма ⇄ доменный ввод
Перем Имена;          // ИменаПолейПодписки — имена полей раздела
Перем Числа;       // ПриведениеЧисел (основа) — терпимое чтение числа
Перем Поправки;    // СервисПоправокПодписок (подписки) — поправки к подпискам сверху
Перем Исключения;  // СервисИсключенийПодписок (подписки) — галки дерева получателей
Перем ОтборТегов;  // ОтборТеговПодписки — отмеченные галки тегов
Перем Предпросмотр; // ПредпросмотрУведомления (подписки) — уведомление до сохранения
Перем ПравилоДерева; // ПравилоДереваПолучателей — галки формы дерева в исключаемые и возвращаемые узлы

#Область ПубличныйИнтерфейс

// Создаёт подписку по форме раздела.
//
// Параметры:
//  Пользователь - Пользователь.
//  Объект - Структура - описание объекта (СервисПодписок.Объект*).
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура: Успех - Булево; Секрет - Строка (показывается один раз); Ошибка - Строка.
//
Функция Создать(Знач Пользователь, Знач Объект, Знач Форма) Экспорт

	Попытка
		Действие = Разбор.Заведение(Форма); // тип и ввод — из декларации обработчика
		Подписка = СервисПодписок.СоздатьПодписку(Пользователь, Объект,
			Действие.ТипДействия, Действие.Ввод, ТипыИзФормы(Форма), ПараметрыИзФормы(Форма),
			СвойстваИзФормы(Форма));
	Исключение
		// причину берём внутри обработчика: только здесь ИнформацияОбОшибке достоверна
		Возврат Исход(Ложь, "", Сбои.Человеку(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Исход(Истина, Строка(Подписка.Секрет), "");

КонецФункции

// Выполняет удаление, переключение или сохранение подписки объекта.
//
// Параметры:
//  Пользователь - Пользователь.
//  Объект - Структура.
//  Действие - Строка - "удалить" | "переключить" | "сохранить".
//  Идентификатор - Строка, Число - id подписки из адреса.
//  Форма - Соответствие - поля действия («включить» либо форма правки).
//
// Возвращаемое значение:
//  Структура: Успех - Булево; Секрет - Строка (новый секрет подписи, показывается один
//  раз); Ошибка - Строка; НеНайдено - Булево (подписки нет у этого объекта);
//  Сообщение и ВидСообщения - Строка (всегда пустые).
//
Функция Применить(Знач Пользователь, Знач Объект, Знач Действие, Знач Идентификатор, Знач Форма) Экспорт

	Что = НРег(СокрЛП(Строка(Действие)));
	Попытка
		Если Что = "удалить" Тогда
			Найдена = СервисПодписок.Удалить(Пользователь, Объект, Числа.ЧислоИлиНоль(Идентификатор));
		ИначеЕсли Что = "сохранить" Тогда
			Возврат Сохранение(Пользователь, Объект, Идентификатор, Форма);
		Иначе
			Найдена = СервисПодписок.Переключить(Пользователь, Объект, Числа.ЧислоИлиНоль(Идентификатор),
				РазборФормы.Флажок(Форма, Имена.ИмяПоляВключить()));
		КонецЕсли;
	Исключение
		// причину берём внутри обработчика: только здесь ИнформацияОбОшибке достоверна
		Возврат Исход(Ложь, "", Сбои.Человеку(ИнформацияОбОшибке()));
	КонецПопытки;

	// чужая подписка, в том числе подписка сверху под адресом своего объекта, — 404 адреса
	Результат = Исход(Найдена, "", "");
	Результат.НеНайдено = НЕ Найдена;
	Возврат Результат;

КонецФункции

// Пробная отправка подписки: настройками, которые прислала форма заведения или правки, ничего
// не сохраняя, а без формы — сохранёнными настройками подписки. Форма правки принадлежит своей
// подписке: подписки с таким идентификатором у объекта нет — «не найдено».
//
// Параметры:
//  Пользователь - Пользователь.
//  Объект - Структура - описание объекта подписок.
//  Идентификатор - Строка - id подписки из адреса; у формы заведения — "". Не целое
//                  положительное — «не найдено».
//  Форма - Соответствие - поля формы; без поля типа действия — проба сохранённых настроек.
//
// Возвращаемое значение:
//  Структура: Успех - Булево (Ложь — проба не отправлена, причина в Ошибке); Секрет - Строка
//  (всегда пустая); Ошибка - Строка; НеНайдено - Булево; Сообщение и ВидСообщения - Строка
//  (ответ цели и «ok» | «err»).
//
Функция Проба(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Форма) Экспорт

	Ид = ИдФормы(Идентификатор);
	Если Ид = Неопределено Тогда
		Возврат НеНайдено();
	КонецЕсли;
	Попытка
		Если НЕ ЗначениеЗаполнено(ТипДействия(Форма)) Тогда
			Итог = СервисПодписок.Проверить(Пользователь, Объект, Ид);
		Иначе
			Настройки = ?(Ид = 0, Разбор.Заведение(Форма), Разбор.Правка(Форма));
			Итог = СервисПодписок.ПроверитьНастройки(Пользователь, Объект, Ид, Настройки.ТипДействия,
				Настройки.Ввод, ТипыИзФормы(Форма));
		КонецЕсли;
	Исключение
		Возврат Исход(Ложь, "", Сбои.Человеку(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Итог = Неопределено Тогда
		Возврат НеНайдено();
	КонецЕсли;

	Результат = Исход(Истина, "", "");
	// и успех, и отказ цели — нормальный ответ: ради него кнопку и нажимали
	Результат.Сообщение = Строка(Итог.Сообщение);
	Результат.ВидСообщения = ?(Итог.Успех = Истина, "ok", "err");
	Возврат Результат;

КонецФункции

// Уведомление по форме заведения или правки — ничего не сохраняет. Форма правки
// принадлежит своей подписке: подписки с таким идентификатором у объекта нет — «не найдено».
//
// Параметры:
//  Пользователь - Пользователь.
//  Объект - Структура - описание объекта подписок.
//  Идентификатор - Строка - id подписки из адреса; у формы заведения — "". Не целое
//                  положительное — «не найдено».
//  Форма - Соответствие - поля формы.
//
// Возвращаемое значение:
//  Структура: Текст - Строка (текст уведомления; "" — отказ); АдресПревью - Строка (карточка
//  ссылки под текстом; "" — без карточки); Ошибка - Строка; НеНайдено - Булево.
//
Функция Уведомление(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Форма) Экспорт

	Результат = Новый Структура("Текст, АдресПревью, Ошибка, НеНайдено", "", "", "", Ложь);
	Ид = ИдФормы(Идентификатор);
	Если Ид = Неопределено ИЛИ (Ид <> 0 И СервисПодписок.ПодпискаОбъекта(Объект, Ид) = Неопределено) Тогда
		Результат.НеНайдено = Истина;
		Возврат Результат;
	КонецЕсли;

	Попытка
		Действие = Разбор.Предпросмотр(Форма);
		Сообщение = Предпросмотр.Сообщение(Пользователь, Объект, Действие.ТипДействия, Действие.Ввод,
			ТипыИзФормы(Форма));
	Исключение
		Результат.Ошибка = Сбои.Человеку(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Результат.Текст = Сообщение.Текст;
	Результат.АдресПревью = Сообщение.АдресПревью;
	Возврат Результат;

КонецФункции

// Ставит или снимает поправку объекта к подписке сверху.
//
// Параметры:
//  Пользователь - Пользователь.
//  Объект - Структура - описание нижестоящего объекта.
//  Действие - Строка - "сузить" | "снять".
//  Идентификатор - Строка, Число - id подписки сверху из адреса.
//  Форма - Соответствие - поля формы поправки.
//
// Возвращаемое значение:
//  Структура: Успех - Булево; Секрет - Строка (всегда пустая); Ошибка - Строка;
//  НеНайдено - Булево (такой подписки сверху у объекта нет); Сообщение и ВидСообщения - Строка.
//
Функция ПрименитьПоправку(Знач Пользователь, Знач Объект, Знач Действие, Знач Идентификатор,
	Знач Форма) Экспорт

	Ид = Числа.ЧислоИлиНоль(Идентификатор);
	Попытка
		Если НРег(СокрЛП(Строка(Действие))) = "снять" Тогда
			Найдена = Поправки.Снять(Пользователь, Объект, Ид);
		Иначе
			Найдена = Поправки.Поставить(Пользователь, Объект, Ид, СужениеИзФормы(Форма)) <> Неопределено;
		КонецЕсли;
	Исключение
		Возврат Исход(Ложь, "", Сбои.Человеку(ИнформацияОбОшибке()));
	КонецПопытки;

	Результат = Исход(Найдена, "", "");
	Результат.НеНайдено = НЕ Найдена;
	Возврат Результат;

КонецФункции

// Ставит и снимает галки дерева получателей подписки по форме: касается узлов, которые форма
// показала, а галка пула — всех пакетов пула (ПравилоДереваПолучателей).
//
// Параметры:
//  Пользователь - Пользователь.
//  Объект - Структура - описание объекта подписок.
//  Идентификатор - Строка, Число - id подписки из адреса.
//  Форма - Соответствие - поля формы дерева.
//
// Возвращаемое значение:
//  Структура: Успех - Булево; Секрет - Строка (всегда пустая); Ошибка - Строка;
//  НеНайдено - Булево (подписки с деревом у объекта нет); Сообщение и ВидСообщения - Строка.
//
Функция ПрименитьДерево(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Форма) Экспорт

	Подписка = Числа.ЧислоИлиНоль(Идентификатор);
	Попытка
		Дерево = Исключения.ДеревоПолучателей(Пользователь, Объект, Подписка);
		Найдена = (Дерево <> Неопределено);
		Если Найдена Тогда
			Галки = ПравилоДерева.Отметки(Форма, Дерево);
			Найдена = Исключения.Отметить(Пользователь, Объект, Подписка, Галки.Исключаемые, Галки.Включаемые);
		КонецЕсли;
	Исключение
		Возврат Исход(Ложь, "", Сбои.Человеку(ИнформацияОбОшибке()));
	КонецПопытки;

	Результат = Исход(Найдена, "", "");
	Результат.НеНайдено = НЕ Найдена;
	Возврат Результат;

КонецФункции

// Ставит и снимает галки пакетов пула в его поправке к подписке хаба по форме дерева: касается
// пакетов, которые форма показала; пакет, снятый хозяином подписки, своей отметки не меняет.
//
// Параметры:
//  Пользователь - Пользователь.
//  Объект - Структура - описание пула.
//  Идентификатор - Строка, Число - id подписки хаба сверху из адреса.
//  Форма - Соответствие - поля формы дерева.
//
// Возвращаемое значение:
//  Структура: Успех - Булево; Секрет - Строка (всегда пустая); Ошибка - Строка;
//  НеНайдено - Булево (такой подписки сверху у пула нет); Сообщение и ВидСообщения - Строка.
//
Функция ПрименитьДеревоПоправки(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Форма) Экспорт

	Подписка = Числа.ЧислоИлиНоль(Идентификатор);
	Попытка
		Дерево = Поправки.ДеревоПоправки(Пользователь, Объект, Подписка);
		Найдена = (Дерево <> Неопределено);
		Если Найдена Тогда
			Галки = ПравилоДерева.Отметки(Форма, Дерево);
			Найдена = Поправки.ОтметитьПакеты(Пользователь, Объект, Подписка,
				ПакетыУзлов(Галки.Исключаемые), ПакетыУзлов(Галки.Включаемые));
		КонецЕсли;
	Исключение
		Возврат Исход(Ложь, "", Сбои.Человеку(ИнформацияОбОшибке()));
	КонецПопытки;

	Результат = Исход(Найдена, "", "");
	Результат.НеНайдено = НЕ Найдена;
	Возврат Результат;

КонецФункции

// Поиск, с которым была открыта форма дерева получателей.
//
// Параметры:
//  Форма - Соответствие - поля формы дерева.
//
// Возвращаемое значение:
//  Строка - строка поиска; пустая, если дерево открывали без поиска.
//
Функция ПоискВДереве(Знач Форма) Экспорт
	Возврат СокрЛП(Строка(РазборФормы.Поле(Форма, Имена.ИмяПараметраПоиска())));
КонецФункции

// Тип действия, который прислала форма: страница отказа показывает тот же набор полей,
// что и отправленная форма, а не первый попавшийся.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Строка - тип действия; пустая строка, если поля в форме не было.
//
Функция ТипДействия(Знач Форма) Экспорт
	Возврат СокрЛП(Строка(РазборФормы.Поле(Форма, Имена.ИмяПоляТипа())));
КонецФункции

// Выбранные типы событий из флажков витрины в CSV (значение "1", читается сравнением).
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Строка - типы через запятую.
//
Функция ТипыИзФормы(Знач Форма) Экспорт

	Известные = СервисПодписок.ИзвестныеТипы();
	Выбранные = Новый Массив();
	Для Индекс = 0 По Известные.Количество() - 1 Цикл
		Если РазборФормы.Флажок(Форма, Имена.ИмяПоляСобытия(Индекс),
			Имена.ЗначениеОтмечено()) Тогда
			Выбранные.Добавить(Известные[Индекс]);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Выбранные, ",");

КонецФункции

// Параметры событий из формы: тип события -> сырое значение его параметра; у поля
// параметра тот же индекс, что и у флажка события.
//
// Параметры:
//  Форма - Соответствие - поля формы.
//
// Возвращаемое значение:
//  Соответствие - тип события (Строка) -> сырое значение (Строка).
//
Функция ПараметрыИзФормы(Знач Форма) Экспорт

	Известные = СервисПодписок.ИзвестныеТипы();
	Результат = Новый Соответствие();
	Для Индекс = 0 По Известные.Количество() - 1 Цикл
		Значение = РазборФормы.Поле(Форма, Имена.ИмяПоляПараметраСобытия(Индекс), "");
		Если ЗначениеЗаполнено(Значение) Тогда
			Результат.Вставить(НРег(СокрЛП(Известные[Индекс])), Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Общие свойства подписки из формы: название, отмеченные галки тегов и флажок «нижестоящие могут
// сузить»; у подписки пакета флажка в форме нет, и сервис его не примет.
//
// Параметры:
//  Форма - Соответствие - поля формы.
//
// Возвращаемое значение:
//  Структура - Название, ОтборТегов, СужениеРазрешено для СервисПодписок.
//
Функция СвойстваИзФормы(Знач Форма) Экспорт

	Возврат Новый Структура("Название, ОтборТегов, СужениеРазрешено",
		РазборФормы.Поле(Форма, Имена.ИмяПоляНазвания(), ""),
		ОтборТегов.ИзФормы(Форма),
		РазборФормы.Флажок(Форма, Имена.ИмяПоляСужения(), Имена.ЗначениеОтмечено()));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отмеченные флажки событий — то, что объект оставляет себе из событий подписки.
Функция СужениеИзФормы(Знач Форма)

	Возврат Новый Структура("НеПрисылать, ОставленныеСобытия, ОтборТегов",
		РазборФормы.Флажок(Форма, Имена.ИмяПоляНеПрисылать(), Имена.ЗначениеОтмечено()),
		ТипыИзФормы(Форма),
		ОтборТегов.ИзФормы(Форма));

КонецФункции

// Вынесено из общей Попытки: «подписки нет» — это 404 адреса, а не отказ формы.
Функция Сохранение(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Форма)

	Попытка
		Правка = Разбор.Правка(Форма);
		Итог = СервисПодписок.ОбновитьПодписку(Пользователь, Объект,
			Числа.ЧислоИлиНоль(Идентификатор), Правка.ТипДействия, Правка.Ввод,
			ТипыИзФормы(Форма), Правка.Активен, ПараметрыИзФормы(Форма), СвойстваИзФормы(Форма));
	Исключение
		Возврат Исход(Ложь, "", Сбои.Человеку(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Итог = Неопределено Тогда
		Результат = Исход(Ложь, "", "");
		Результат.НеНайдено = Истина;
		Возврат Результат;
	КонецЕсли;

	Возврат Исход(Истина, Строка(Итог.Секрет), "");

КонецФункции

// Подписка формы по адресу: "" — форма заведения (0); иначе только целое положительное,
// прочее — Неопределено: адрес правки с «abc» или «0» — несуществующая подписка, а не заведение.
Функция ИдФормы(Знач Идентификатор)

	Текст = СокрЛП(Строка(Идентификатор));
	Если Текст = "" Тогда
		Возврат 0;
	КонецЕсли;
	Для Номер = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Номер, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Ид = Число(Текст);
	Возврат ?(Ид > 0, Ид, Неопределено);

КонецФункции

// В дереве поправки только пакеты: узел пула из подделанной формы не значит ничего.
Функция ПакетыУзлов(Знач Узлы)
	Результат = Новый Массив();
	Для Каждого Узел Из Узлы Цикл
		Если Узел.ТипОбъекта = "пакет" Тогда
			Результат.Добавить(Узел.Идентификатор);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НеНайдено()
	Результат = Исход(Ложь, "", "");
	Результат.НеНайдено = Истина;
	Возврат Результат;
КонецФункции

Функция Исход(Знач Успех, Знач Секрет, Знач Ошибка)
	Возврат Новый Структура("Успех, Секрет, Ошибка, НеНайдено, Сообщение, ВидСообщения",
		Успех, Секрет, Ошибка, Ложь, "", "");
КонецФункции

#КонецОбласти

&Прозвище("ПультПодписок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "РазборФормыПодписки") _Разбор,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "СервисПоправокПодписок") _Поправки,
	&Пластилин(Значение = "СервисИсключенийПодписок") _Исключения,
	&Пластилин(Значение = "ОтборТеговПодписки") _ОтборТегов,
	&Пластилин(Значение = "ПредпросмотрУведомления") _Предпросмотр,
	&Пластилин(Значение = "ПравилоДереваПолучателей") _ПравилоДерева) Экспорт

	Числа = _Числа;
	Поправки = _Поправки;
	Исключения = _Исключения;
	ОтборТегов = _ОтборТегов;
	Предпросмотр = _Предпросмотр;
	ПравилоДерева = _ПравилоДерева;

	РазборФормы = _РазборФормы;
	Сбои = _Сбои;
	СервисПодписок = _СервисПодписок;
	Разбор = _Разбор;
	Имена = _Имена;

КонецПроцедуры
