// Операции раздела «Подписки»: создание, правка, переключение, проба и удаление подписки,
// предпросмотр уведомления, правки окна «Получатели», поправка к подписке сверху и галки окна
// «Пакеты пула». Исход каждой — один вид (см. Исход): удача, отказ словами и у полей, 404.

Перем РазборФормы;    // РазборФормы (общий) — поля и флажки присланной формы
Перем Сбои;         // ТекстСбоя — причина сбоя человеку и отчёт в журнал
Перем СервисПодписок; // СервисПодписок (подписки)
Перем РазборПодписки; // РазборФормыПодписки — форма подписки ⇄ доменный ввод
Перем Имена;          // ИменаПолейПодписки — имена полей раздела
Перем Числа;       // ПриведениеЧисел (основа) — терпимое чтение числа
Перем Поправки;    // СервисПоправокПодписок (подписки) — поправки к подпискам сверху
Перем Исключения;  // СервисИсключенийПодписок (подписки) — галки дерева получателей
Перем ОтборТегов;  // ОтборТеговПодписки — отмеченные галки тегов
Перем Предпросмотр; // ПредпросмотрУведомления (подписки) — уведомление до сохранения
Перем ПравилоДерева; // ПравилоДереваПолучателей — форма окна «Получатели» в правки домена
Перем ИменаПодписок; // ИменаПодписок — имя подписки в поле подтверждения удаления
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Создаёт подписку по форме окна «Новая подписка».
//
// Параметры:
//  Пользователь - Пользователь.
//  Объект - Структура - описание объекта (СервисПодписок.Объект*).
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - исход (см. Исход): Секрет — секрет подписи, показывается один раз.
//
Функция Создать(Знач Пользователь, Знач Объект, Знач Форма) Экспорт

	Попытка
		Действие = РазборПодписки.Заведение(Форма); // тип и ввод — из декларации обработчика
		Если Действие.Отказы.Количество() > 0 Тогда
			Возврат ОтбитоПолями(Действие.Отказы);
		КонецЕсли;
		Подписка = СервисПодписок.СоздатьПодписку(Пользователь, Объект,
			Действие.ТипДействия, Действие.Ввод, ТипыИзФормы(Форма), ПараметрыИзФормы(Форма),
			СвойстваИзФормы(Форма));
	Исключение
		// причину берём внутри обработчика: только здесь ИнформацияОбОшибке достоверна
		Возврат Отказ(Сбои.Человеку(ИнформацияОбОшибке()));
	КонецПопытки;

	Результат = Удача();
	Результат.Секрет = Строка(Подписка.Секрет);
	Возврат Результат;

КонецФункции

// Сохраняет правку подписки из окна «Изменить». Включённость правка не трогает — её меняет
// тумблер записи.
//
// Параметры:
//  Пользователь - Пользователь.
//  Объект - Структура - описание объекта.
//  Идентификатор - Строка, Число - id подписки из адреса.
//  Форма - Соответствие - разобранная форма окна.
//
// Возвращаемое значение:
//  Структура - исход (см. Исход): Секрет — новый секрет подписи, если его выпустили;
//  НеНайдено — подписки у объекта нет; Устарела — форма старой вкладки, ничего не изменено.
//
Функция Сохранить(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Форма) Экспорт

	Подписка = СервисПодписок.ПодпискаОбъекта(Объект, Числа.ЧислоИлиНоль(Идентификатор));
	Если Подписка = Неопределено Тогда
		Возврат НеНайдено();
	ИначеЕсли ФормаУстарела(Форма) Тогда
		Возврат ОтказУстаревшей();
	КонецЕсли;

	Попытка
		Правка = РазборПодписки.Правка(Форма);
		Если Правка.Отказы.Количество() > 0 Тогда
			Возврат ОтбитоПолями(Правка.Отказы);
		КонецЕсли;
		Итог = СервисПодписок.ОбновитьПодписку(Пользователь, Объект, Подписка.Идентификатор,
			Правка.ТипДействия, Правка.Ввод, ТипыИзФормы(Форма), Подписка.Активен = Истина,
			ПараметрыИзФормы(Форма), СвойстваИзФормы(Форма));
	Исключение
		Возврат Отказ(Сбои.Человеку(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Итог = Неопределено Тогда
		Возврат НеНайдено();
	КонецЕсли;
	Результат = Удача();
	Результат.Секрет = Строка(Итог.Секрет);
	Возврат Результат;

КонецФункции

// Включает или выключает подписку тумблером записи.
//
// Параметры:
//  Пользователь - Пользователь.
//  Объект - Структура - описание объекта.
//  Идентификатор - Строка, Число - id подписки из адреса.
//  Форма - Соответствие - форма тумблера: желаемое состояние в поле «включить».
//
// Возвращаемое значение:
//  Структура - исход (см. Исход).
//
Функция Переключить(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Форма) Экспорт

	Попытка
		Найдена = СервисПодписок.Переключить(Пользователь, Объект, Числа.ЧислоИлиНоль(Идентификатор),
			РазборФормы.Флажок(Форма, Имена.ИмяПоляВключить(), Имена.ЗначениеОтмечено()));
	Исключение
		Возврат Отказ(Сбои.Человеку(ИнформацияОбОшибке()));
	КонецПопытки;
	// чужая подписка, в том числе подписка сверху под адресом своего объекта, — 404 адреса
	Возврат ?(Найдена, Удача(), НеНайдено());

КонецФункции

// Удаляет подписку, если в поле подтверждения набрано её имя.
//
// Параметры:
//  Пользователь - Пользователь.
//  Объект - Структура - описание объекта.
//  Идентификатор - Строка, Число - id подписки из адреса.
//  Форма - Соответствие - форма подтверждения.
//
// Возвращаемое значение:
//  Структура - исход (см. Исход); несовпавшее эхо — отказ под полем, подписка цела.
//
Функция Удалить(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Форма) Экспорт

	Подписка = СервисПодписок.ПодпискаОбъекта(Объект, Числа.ЧислоИлиНоль(Идентификатор));
	Если Подписка = Неопределено Тогда
		Возврат НеНайдено();
	КонецЕсли;

	Имя = ИменаПодписок.Своей(Подписка);
	Если СокрЛП(Строка(РазборФормы.Поле(Форма, Имена.ИмяПоляЭха()))) <> Имя Тогда
		Отказы = Новый Соответствие();
		Отказы.Вставить(Имена.ИмяПоляЭха(), Тексты.Шаблон("subscriptions.delete.echo.mismatch", Имя));
		Возврат ОтбитоПолями(Отказы);
	КонецЕсли;

	Попытка
		Найдена = СервисПодписок.Удалить(Пользователь, Объект, Подписка.Идентификатор);
	Исключение
		Отказы = Новый Соответствие();
		Отказы.Вставить(Имена.ИмяПоляЭха(), Сбои.Человеку(ИнформацияОбОшибке()));
		Возврат ОтбитоПолями(Отказы);
	КонецПопытки;
	Возврат ?(Найдена, Удача(), НеНайдено());

КонецФункции

// Пробная отправка подписки: настройками, которые прислало окно заведения или правки, ничего
// не сохраняя, а без полей окна — сохранёнными настройками подписки. Форма правки принадлежит
// своей подписке: подписки с таким идентификатором у объекта нет — «не найдено».
//
// Параметры:
//  Пользователь - Пользователь.
//  Объект - Структура - описание объекта подписок.
//  Идентификатор - Строка - id подписки из адреса; у окна заведения — "". Не целое
//                  положительное — «не найдено».
//  Форма - Соответствие - поля формы; без поля типа действия — проба сохранённых настроек.
//
// Возвращаемое значение:
//  Структура - исход (см. Исход): Успех — проба ушла, Сообщение — ответ цели, ВидСообщения —
//  «ok» | «err»; не ушла — Успех Ложь и причина в Сообщении.
//
Функция Проба(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Форма) Экспорт

	Ид = ИдФормы(Идентификатор);
	Если Ид = Неопределено Тогда
		Возврат НеНайдено();
	КонецЕсли;
	Попытка
		Если НЕ ЗначениеЗаполнено(ТипДействия(Форма)) Тогда
			Итог = СервисПодписок.Проверить(Пользователь, Объект, Ид);
		Иначе
			Настройки = ?(Ид = 0, РазборПодписки.Заведение(Форма), РазборПодписки.Правка(Форма));
			Если Настройки.Отказы.Количество() > 0 Тогда
				Возврат ОтбитоПолями(Настройки.Отказы);
			КонецЕсли;
			Итог = СервисПодписок.ПроверитьНастройки(Пользователь, Объект, Ид, Настройки.ТипДействия,
				Настройки.Ввод, ТипыИзФормы(Форма));
		КонецЕсли;
	Исключение
		Возврат Отказ(Сбои.Человеку(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Итог = Неопределено Тогда
		Возврат НеНайдено();
	КонецЕсли;

	Результат = Удача();
	// и успех, и отказ цели — нормальный ответ: ради него кнопку и нажимали
	Результат.Сообщение = Строка(Итог.Сообщение);
	Результат.ВидСообщения = ?(Итог.Успех = Истина, "ok", "err");
	Возврат Результат;

КонецФункции

// Уведомление по форме заведения или правки — ничего не сохраняет. Форма правки
// принадлежит своей подписке: подписки с таким идентификатором у объекта нет — «не найдено».
//
// Параметры:
//  Пользователь - Пользователь.
//  Объект - Структура - описание объекта подписок.
//  Идентификатор - Строка - id подписки из адреса; у формы заведения — "". Не целое
//                  положительное — «не найдено».
//  Форма - Соответствие - поля формы.
//
// Возвращаемое значение:
//  Структура: Текст - Строка (текст уведомления; "" — отказ); АдресПревью - Строка (карточка
//  ссылки под текстом; "" — без карточки); Ошибка - Строка; НеНайдено - Булево.
//
Функция Уведомление(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Форма) Экспорт

	Результат = Новый Структура("Текст, АдресПревью, Ошибка, НеНайдено", "", "", "", Ложь);
	Ид = ИдФормы(Идентификатор);
	Если Ид = Неопределено ИЛИ (Ид <> 0 И СервисПодписок.ПодпискаОбъекта(Объект, Ид) = Неопределено) Тогда
		Результат.НеНайдено = Истина;
		Возврат Результат;
	КонецЕсли;

	Попытка
		Действие = РазборПодписки.Предпросмотр(Форма);
		Сообщение = Предпросмотр.Сообщение(Пользователь, Объект, Действие.ТипДействия, Действие.Ввод,
			ТипыИзФормы(Форма));
	Исключение
		Результат.Ошибка = Сбои.Человеку(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Результат.Текст = Сообщение.Текст;
	Результат.АдресПревью = Сообщение.АдресПревью;
	Возврат Результат;

КонецФункции

// Ставит или снимает поправку объекта к подписке сверху.
//
// Параметры:
//  Пользователь - Пользователь.
//  Объект - Структура - описание нижестоящего объекта.
//  Действие - Строка - "сузить" | "снять".
//  Идентификатор - Строка, Число - id подписки сверху из адреса.
//  Форма - Соответствие - поля формы поправки.
//
// Возвращаемое значение:
//  Структура - исход (см. Исход): НеНайдено — такой подписки сверху у объекта нет.
//
Функция ПрименитьПоправку(Знач Пользователь, Знач Объект, Знач Действие, Знач Идентификатор,
	Знач Форма) Экспорт

	Ид = ИдФормы(Идентификатор);
	Если Ид = Неопределено ИЛИ Ид = 0 Тогда
		Возврат НеНайдено();
	КонецЕсли;
	Попытка
		Если НРег(СокрЛП(Строка(Действие))) = "снять" Тогда
			Найдена = Поправки.Снять(Пользователь, Объект, Ид);
		Иначе
			Найдена = Поправки.Поставить(Пользователь, Объект, Ид, СужениеИзФормы(Форма)) <> Неопределено;
		КонецЕсли;
	Исключение
		Возврат Отказ(Сбои.Человеку(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат ?(Найдена, Удача(), НеНайдено());

КонецФункции

// Правки окна «Получатели» подписки: режимы пулов, основы массовой отметки и галки пакетов — правками
// кита со скриптом или полем показанного без него (ПравилоДереваПолучателей). Форма старой вкладки
// ничего не меняет.
//
// Параметры:
//  Пользователь - Пользователь.
//  Объект - Структура - описание объекта подписок.
//  Идентификатор - Строка, Число - id подписки из адреса.
//  Тело - Строка - сырое тело формы: правок одного имени приходит несколько.
//
// Возвращаемое значение:
//  Структура - исход (см. Исход): НеНайдено — подписки с деревом у объекта нет; Устарела — форма
//  старой вкладки.
//
Функция ПрименитьДерево(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Тело) Экспорт

	Подписка = Числа.ЧислоИлиНоль(Идентификатор);
	Попытка
		Дерево = Исключения.ДеревоПолучателей(Пользователь, Объект, Подписка);
		Если Дерево = Неопределено Тогда
			Возврат НеНайдено();
		КонецЕсли;
		Правки = ПравилоДерева.Правки(Тело, Дерево);
		Если Правки.Устарела Тогда
			Возврат ОтказУстаревшей();
		КонецЕсли;
		Найдена = Исключения.Применить(Пользователь, Объект, Подписка, Правки.Режимы, Правки.Включаемые,
			Правки.Снимаемые, Правки.Основы);
	Исключение
		Возврат Отказ(Сбои.Человеку(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат ?(Найдена, Удача(), НеНайдено());

КонецФункции

// Галки окна «Пакеты пула»: пакеты пула в его поправке к подписке хаба; пакет, снятый хозяином
// подписки, своей отметки не меняет. Форма старой вкладки ничего не меняет.
//
// Параметры:
//  Пользователь - Пользователь.
//  Объект - Структура - описание пула.
//  Идентификатор - Строка, Число - id подписки хаба сверху из адреса.
//  Тело - Строка - сырое тело формы.
//
// Возвращаемое значение:
//  Структура - исход (см. Исход): НеНайдено — такой подписки сверху у пула нет; Устарела — форма
//  старой вкладки.
//
Функция ПрименитьДеревоПоправки(Знач Пользователь, Знач Объект, Знач Идентификатор, Знач Тело) Экспорт

	Подписка = Числа.ЧислоИлиНоль(Идентификатор);
	Попытка
		Дерево = Поправки.ДеревоПоправки(Пользователь, Объект, Подписка);
		Если Дерево = Неопределено Тогда
			Возврат НеНайдено();
		КонецЕсли;
		Правки = ПравилоДерева.ПравкиПоправки(Тело, Дерево);
		Если Правки.Устарела Тогда
			Возврат ОтказУстаревшей();
		КонецЕсли;
		Найдена = Поправки.ОтметитьПакеты(Пользователь, Объект, Подписка, Правки.Снимаемые, Правки.Включаемые);
	Исключение
		Возврат Отказ(Сбои.Человеку(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат ?(Найдена, Удача(), НеНайдено());

КонецФункции

// Строка поиска, с которой ушла форма окна «Получатели» или «Пакеты пула».
//
// Параметры:
//  Тело - Строка - сырое тело формы.
//
// Возвращаемое значение:
//  Строка - пустая, если окно искало не по строке или строка короче, чем ищет окно.
//
Функция ПоискВДереве(Знач Тело) Экспорт
	Поиск = ПравилоДерева.Поиск(Тело);
	Возврат ?(СтрДлина(Поиск) < ПравилоДерева.ДлинаПоиска(), "", Поиск);
КонецФункции

// Тип действия, который прислала форма: страница отказа показывает тот же набор полей,
// что и отправленная форма, а не первый попавшийся.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Строка - тип действия; пустая строка, если поля в форме не было.
//
Функция ТипДействия(Знач Форма) Экспорт
	Возврат СокрЛП(Строка(РазборФормы.Поле(Форма, Имена.ИмяПоляТипа())));
КонецФункции

// Выбранные типы событий из флажков витрины в CSV (значение "1", читается сравнением).
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Строка - типы через запятую.
//
Функция ТипыИзФормы(Знач Форма) Экспорт

	Известные = СервисПодписок.ИзвестныеТипы();
	Выбранные = Новый Массив();
	Для Индекс = 0 По Известные.Количество() - 1 Цикл
		Если РазборФормы.Флажок(Форма, Имена.ИмяПоляСобытия(Индекс),
			Имена.ЗначениеОтмечено()) Тогда
			Выбранные.Добавить(Известные[Индекс]);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Выбранные, ",");

КонецФункции

// Параметры событий из формы: тип события -> сырое значение его параметра; у поля
// параметра тот же индекс, что и у флажка события.
//
// Параметры:
//  Форма - Соответствие - поля формы.
//
// Возвращаемое значение:
//  Соответствие - тип события (Строка) -> сырое значение (Строка).
//
Функция ПараметрыИзФормы(Знач Форма) Экспорт

	Известные = СервисПодписок.ИзвестныеТипы();
	Результат = Новый Соответствие();
	Для Индекс = 0 По Известные.Количество() - 1 Цикл
		Значение = РазборФормы.Поле(Форма, Имена.ИмяПоляПараметраСобытия(Индекс), "");
		Если ЗначениеЗаполнено(Значение) Тогда
			Результат.Вставить(НРег(СокрЛП(Известные[Индекс])), Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Общие свойства подписки из формы: название, отмеченные галки тегов и флажок «нижестоящие могут
// сузить»; у подписки пакета флажка в форме нет, и сервис его не примет.
//
// Параметры:
//  Форма - Соответствие - поля формы.
//
// Возвращаемое значение:
//  Структура - Название, ОтборТегов, СужениеРазрешено для СервисПодписок.
//
Функция СвойстваИзФормы(Знач Форма) Экспорт

	Возврат Новый Структура("Название, ОтборТегов, СужениеРазрешено",
		РазборФормы.Поле(Форма, Имена.ИмяПоляНазвания(), ""),
		ОтборТегов.ИзФормы(Форма),
		РазборФормы.Флажок(Форма, Имена.ИмяПоляСужения(), Имена.ЗначениеОтмечено()));

КонецФункции

// Форма правки старой вкладки: окно правки поля включённости не несёт, его меняет тумблер записи.
// Такую форму не применяют — её ввод собран под другой экран.
//
// Параметры:
//  Форма - Соответствие - разобранная форма правки.
//
// Возвращаемое значение:
//  Булево.
//
Функция ФормаУстарела(Знач Форма) Экспорт
	Возврат Форма.Получить(Имена.ИмяПоляВключить()) <> Неопределено;
КонецФункции

// Отказ формы старой вкладки: ничего не изменено.
//
// Возвращаемое значение:
//  Структура - исход (см. Исход), код 400.
//
Функция ОтказУстаревшей() Экспорт
	Результат = Отказ(Тексты.Текст("subscriptions.error.stale"));
	Результат.Устарела = Истина;
	Возврат Результат;
КонецФункции

// Исход операции раздела.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число — код ответа отказа), Сообщение (Строка — причина
//  отказа словами, у пробы — ответ цели), Отказы (Соответствие — имя поля -> отказ под полем),
//  Секрет (Строка — секрет подписи, который показывается один раз), НеНайдено (Булево — подписки
//  у объекта нет: 404 адреса), ВидСообщения (Строка — «ok» | «err» у пробы), Устарела (Булево —
//  форма старой вкладки, ничего не изменено).
//
Функция Исход() Экспорт
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы, Секрет, НеНайдено, ВидСообщения, Устарела",
		Ложь, 400, "", Новый Соответствие(), "", Ложь, "", Ложь);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отмеченные флажки событий — то, что объект оставляет себе из событий подписки.
Функция СужениеИзФормы(Знач Форма)

	Возврат Новый Структура("НеПрисылать, ОставленныеСобытия, ОтборТегов",
		РазборФормы.Флажок(Форма, Имена.ИмяПоляНеПрисылать(), Имена.ЗначениеОтмечено()),
		ТипыИзФормы(Форма),
		ОтборТегов.ИзФормы(Форма));

КонецФункции

// Подписка формы по адресу: "" — форма заведения (0); иначе только целое положительное,
// прочее — Неопределено: адрес правки с «abc» или «0» — несуществующая подписка, а не заведение.
Функция ИдФормы(Знач Идентификатор)

	Текст = СокрЛП(Строка(Идентификатор));
	Если Текст = "" Тогда
		Возврат 0;
	КонецЕсли;
	Для Номер = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Номер, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Ид = Число(Текст);
	Возврат ?(Ид > 0, Ид, Неопределено);

КонецФункции

// В дереве поправки только пакеты: узел пула из подделанной формы не значит ничего.

Функция Удача()
	Результат = Исход();
	Результат.Успех = Истина;
	Результат.Код = 200;
	Возврат Результат;
КонецФункции

Функция Отказ(Знач Причина)
	Результат = Исход();
	Результат.Сообщение = Причина;
	Возврат Результат;
КонецФункции

// Отказ у полей окна: причину говорит поле, а не окно.
Функция ОтбитоПолями(Знач Отказы)
	Результат = Исход();
	Результат.Отказы = Отказы;
	Для Каждого Отказ Из Отказы Цикл
		Результат.Сообщение = Отказ.Значение;
		Прервать;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НеНайдено()
	Результат = Исход();
	Результат.Код = 404;
	Результат.НеНайдено = Истина;
	Возврат Результат;
КонецФункции

#КонецОбласти

&Прозвище("ПультПодписок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "РазборФормыПодписки") _Разбор,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "СервисПоправокПодписок") _Поправки,
	&Пластилин(Значение = "СервисИсключенийПодписок") _Исключения,
	&Пластилин(Значение = "ОтборТеговПодписки") _ОтборТегов,
	&Пластилин(Значение = "ПредпросмотрУведомления") _Предпросмотр,
	&Пластилин(Значение = "ПравилоДереваПолучателей") _ПравилоДерева,
	&Пластилин(Значение = "ИменаПодписок") _ИменаПодписок,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	Сбои = _Сбои;
	СервисПодписок = _СервисПодписок;
	РазборПодписки = _Разбор;
	Имена = _Имена;
	Числа = _Числа;
	Поправки = _Поправки;
	Исключения = _Исключения;
	ОтборТегов = _ОтборТегов;
	Предпросмотр = _Предпросмотр;
	ПравилоДерева = _ПравилоДерева;
	ИменаПодписок = _ИменаПодписок;
	Тексты = _Тексты;

КонецПроцедуры
