// Поля канала подписки, собранные по декларации его обработчика: выбор канала сегментами с полями
// каждого типа в его наборе, поля канала правимой подписки и поля текста уведомления. Набранное
// и отказы отбитой формы поля берут у состояния окна; секрет обратно не печатается никогда.

Перем Кит;      // Кит (кит) — фабрика элементов экрана
Перем Тексты;   // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Окна;     // ОкноРаздела — набранное и отказы окна
Перем Имена;    // ИменаПолейПодписки — имена полей раздела
Перем Каталог;  // КаталогДействийПодписки — типы и их декларации

#Область ПубличныйИнтерфейс

// Выбор канала окна «Новая подписка»: сегмент на каждый тип с формой настроек, в наборе
// сегмента — однострочные поля его декларации. Выбранный — присланный отбитой формой, иначе первый.
//
// Параметры:
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  ЭлементЭкрана - сегменты; примечание, если ни один тип формы не заявил.
//
Функция ВыборКанала(Знач Состояние) Экспорт

	Если Каталог.Пусто() Тогда
		// ни одного типа с формой: рисовать пустую форму создания нечестно
		Возврат Кит.Примечание(Тексты.Текст("subscriptions.form.types.empty"));
	КонецЕсли;

	Выбор = Кит.Сегменты(Имена.ИмяПоляТипа())
		.Подпись(Тексты.Текст("subscriptions.form.type.legend"))
		.Выбрано(Каталог.ВыбранныйТип(Окна.Значение(Состояние, Имена.ИмяПоляТипа())));
	Для Каждого Описание Из Каталог.Все() Цикл
		Выбор.Добавить(НаборТипа(Описание, Состояние));
	КонецЦикла;
	Возврат Выбор;

КонецФункции

// Канал правимой подписки: способ доставки — свойством, тип — скрытым полем (сервер сверяет его
// с записью и подмену отбивает), однострочные поля — значениями подписки.
//
// Параметры:
//  Тип - Строка - тип действия подписки.
//  Значения - Структура - значения по именам ввода (СервисПодписок.ЗначенияПравки).
//  Состояние - Структура, Неопределено - состояние окна раздела.
//
// Возвращаемое значение:
//  ЭлементЭкрана - холст полей канала.
//
Функция КаналПравки(Знач Тип, Знач Значения, Знач Состояние) Экспорт

	Описание = Каталог.Описание(Тип);
	Поля = Кит.Холст(
		Кит.СкрытоеПоле(Имена.ИмяПоляТипа(), Описание.Тип),
		Кит.Свойства(Кит.Свойство(Тексты.Текст("subscriptions.form.type.legend"), Описание.Подпись)
			.Примечание(Тексты.Текст("subscriptions.edit.type.locked"))));
	Для Каждого ОписаниеПоля Из Описание.Поля Цикл
		Если Каталог.Секретное(ОписаниеПоля) Тогда
			Поля.Добавить(СекретПравки(ОписаниеПоля, Свой(Значения, ОписаниеПоля), Состояние));
		ИначеЕсли НЕ Многострочное(ОписаниеПоля) Тогда
			Поля.Добавить(ПолеПравки(ОписаниеПоля, Состояние, Значение(Значения, ОписаниеПоля)));
		КонецЕсли;
	КонецЦикла;
	Возврат Поля;

КонецФункции

// Поля текста уведомления типа (его многострочные поля): пустое поле показывает текст
// по умолчанию, под полем свёрнут перечень того, что можно вставить.
//
// Параметры:
//  Тип - Строка - тип действия.
//  Состояние - Структура, Неопределено - состояние окна раздела.
//  Значения - Структура, Неопределено - значения правимой подписки; Неопределено — новая.
//
// Возвращаемое значение:
//  ЭлементЭкрана - холст полей; пустой, если текста у типа нет.
//
Функция ПоляТекста(Знач Тип, Знач Состояние, Знач Значения = Неопределено) Экспорт

	Поля = Кит.Холст();
	Для Каждого ОписаниеПоля Из ПоляТекстаТипа(Тип) Цикл
		Поля.Добавить(Кит.Холст(
			ПолеТекста(ОписаниеПоля, Состояние, Значение(Значения, ОписаниеПоля)),
			ПереченьВставок(ОписаниеПоля)));
	КонецЦикла;
	Возврат Поля;

КонецФункции

// Есть ли у типа поля текста уведомления.
//
// Параметры:
//  Тип - Строка - тип действия.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьТекст(Знач Тип) Экспорт
	Возврат ПоляТекстаТипа(Тип).Количество() > 0;
КонецФункции

#КонецОбласти

#Область ВыборКанала

// Набор сегмента — поля только этого типа: на экране остаются поля выбранного, и без скрипта тоже.
// Обязательность наборов проверяет сервер: спрятанное обязательное поле не пустило бы форму.
// Значок канала тот же, что у записи подписки: логотип бренда или глиф способа.
Функция НаборТипа(Знач Описание, Знач Состояние)

	Сегмент = Кит.Сегмент(Описание.Тип, Описание.Подпись, ОСпособе(Описание))
		.Иконка(Каталог.ЗначокТипа(Описание.Тип));
	Для Каждого ОписаниеПоля Из Описание.Поля Цикл
		Если Каталог.Секретное(ОписаниеПоля) Тогда
			Сегмент.Добавить(СекретЗаведения(ОписаниеПоля, Состояние));
		ИначеЕсли НЕ Многострочное(ОписаниеПоля) Тогда
			Сегмент.Добавить(ПолеКанала(ОписаниеПоля, Состояние, ""));
		КонецЕсли;
	КонецЦикла;
	Возврат Сегмент;

КонецФункции

// Как устроен способ доставки — за «?»: на экране остаются поля.
Функция ОСпособе(Знач Описание)

	Если НЕ ЗначениеЗаполнено(Описание.Пояснение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Примечание(Тексты.Текст("subscriptions.form.type.about"),
		Кит.Подсказка(Описание.Пояснение).Подпись(Описание.Подпись));

КонецФункции

// Секрет новой подписки после отказа не возвращается: его вводят заново, и поле об этом говорит.
Функция СекретЗаведения(Знач ОписаниеПоля, Знач Состояние)

	Возврат Кит.Поле(ОписаниеПоля.ИмяПоля, Тексты.Текст(ОписаниеПоля.КлючПодписи)).Секрет()
		.Пример(ТекстНеобязательный(ОписаниеПоля.КлючПлейсхолдера))
		.Справка(ТекстНеобязательный(ОписаниеПоля.КлючПодсказки))
		.Подсказка(?(Набрано(Состояние), Тексты.Текст("subscriptions.form.secret.again"),
			Тексты.Текст("subscriptions.form.secret.once")))
		.Ошибка(Окна.Отказ(Состояние, ОписаниеПоля.ИмяПоля));

КонецФункции

#КонецОбласти

#Область КаналПравки

// У правимой подписки тип известен: обязательное поле объявлено, браузер проверит его сам.
Функция ПолеПравки(Знач ОписаниеПоля, Знач Состояние, Знач Действующее)

	Поле = ПолеКанала(ОписаниеПоля, Состояние, Действующее);
	Если ОписаниеПоля.Обязательное = Истина Тогда
		Поле.Обязательное();
	КонецЕсли;
	Возврат Поле;

КонецФункции

// Сохранённый секрет в поле не выходит: пустое поле — «оставить прежний», маска лишь говорит,
// что он есть. Флажок «секрет свой» — у типа, где его можно сбросить к выпуску нового.
Функция СекретПравки(Знач ОписаниеПоля, Знач Свой, Знач Состояние)

	Поле = Кит.Поле(ОписаниеПоля.ИмяПоля, Тексты.Текст(ОписаниеПоля.КлючПодписи)).Секрет()
		.Пример(?(Свой, Имена.МаскаСекрета(), ТекстНеобязательный(ОписаниеПоля.КлючПлейсхолдера)))
		.Справка(ТекстНеобязательный(ОписаниеПоля.КлючПодсказки))
		.Подсказка(Тексты.Текст("subscriptions.form.secret.keep"))
		.Ошибка(Окна.Отказ(Состояние, ОписаниеПоля.ИмяПоля));

	Если НЕ Каталог.ЕстьСбросСекрета(ОписаниеПоля) Тогда
		Возврат Поле;
	КонецЕсли;

	ИмяСвоего = Имена.ИмяПоляСвоегоСекрета(ОписаниеПоля.ИмяПоля);
	Возврат Кит.Холст(
		Кит.Поле(ИмяСвоего, ПодписьСвоего(ОписаниеПоля)).ТипЗначения("флажок")
			.Значение(Имена.ЗначениеОтмечено())
			.Отмечено(Окна.Отмечено(Состояние, ИмяСвоего, Свой, Имена.ЗначениеОтмечено()))
			.Подсказка(Тексты.Текст("subscriptions.form.secret.own.hint")),
		Поле);

КонецФункции

// «Секрет у подписки свой» — часть значений правки: их отдаёт описание хранения типа.
Функция Свой(Знач Значения, Знач ОписаниеПоля)
	Найденное = Неопределено;
	Возврат Значения.Свойство(ОписаниеПоля.Имя + "Свой", Найденное) И Найденное = Истина;
КонецФункции

Функция ПодписьСвоего(Знач ОписаниеПоля)
	КлючТекста = Неопределено;
	ОписаниеПоля.Свойство("КлючСвоего", КлючТекста);
	Возврат Тексты.Текст(Строка(КлючТекста));
КонецФункции

#КонецОбласти

#Область ТекстУведомления

// Многострочные поля типа; у типа без декларации их нет.
Функция ПоляТекстаТипа(Знач Тип)

	Результат = Новый Массив();
	Описание = Каталог.Описание(Тип);
	Если Описание = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ОписаниеПоля Из Описание.Поля Цикл
		Если Многострочное(ОписаниеПоля) Тогда
			Результат.Добавить(ОписаниеПоля);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пустое поле показывает текст по умолчанию, если тип его объявил.
Функция ПолеТекста(Знач ОписаниеПоля, Знач Состояние, Знач Действующее)

	Возврат Кит.Поле(ОписаниеПоля.ИмяПоля, Тексты.Текст(ОписаниеПоля.КлючПодписи)).Многострочное()
		.Значение(Окна.Значение(Состояние, ОписаниеПоля.ИмяПоля, Действующее))
		.Пример(ПримерТекста(ОписаниеПоля))
		.Подсказка(ТекстНеобязательный(ОписаниеПоля.КлючПодсказки))
		.Ошибка(Окна.Отказ(Состояние, ОписаниеПоля.ИмяПоля));

КонецФункции

// Что можно вставить в текст — свёрнутым перечнем «{имя} — что подставится» под полем.
Функция ПереченьВставок(Знач ОписаниеПоля)

	Вставки = Неопределено;
	Если НЕ ОписаниеПоля.Свойство("Вставки", Вставки) ИЛИ НЕ ЗначениеЗаполнено(Вставки) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Перечень = Кит.Список().Вид("сноска");
	Для Каждого Вставка Из Вставки Цикл
		Перечень.Добавить(Кит.Пункт(Кит.Код("{" + Вставка.Имя + "}"), " — " + Вставка.Описание));
	КонецЦикла;
	Возврат Кит.Раскрывашка(Перечень, Кит.Примечание(Тексты.Текст("subscriptions.form.text.inserts.rules")))
		.Шапка(Тексты.Текст("subscriptions.form.text.hint.more")).Вид("подробность");

КонецФункции

// Готовый текст декларации берёт верх над ключом словаря.
Функция ПримерТекста(Знач ОписаниеПоля)
	Готовый = Неопределено;
	Если ОписаниеПоля.Свойство("Плейсхолдер", Готовый) И ЗначениеЗаполнено(Готовый) Тогда
		Возврат Строка(Готовый);
	КонецЕсли;
	Возврат ТекстНеобязательный(ОписаниеПоля.КлючПлейсхолдера);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Однострочное поле канала: длинное пояснение декларации — справкой «?» у подписи.
Функция ПолеКанала(Знач ОписаниеПоля, Знач Состояние, Знач Действующее)

	Возврат Кит.Поле(ОписаниеПоля.ИмяПоля, Тексты.Текст(ОписаниеПоля.КлючПодписи))
		.Значение(Окна.Значение(Состояние, ОписаниеПоля.ИмяПоля, Действующее))
		.Пример(ТекстНеобязательный(ОписаниеПоля.КлючПлейсхолдера))
		.Справка(ТекстНеобязательный(ОписаниеПоля.КлючПодсказки))
		.Ошибка(Окна.Отказ(Состояние, ОписаниеПоля.ИмяПоля));

КонецФункции

// Окно вернулось с отбитой формой: набранное приехало, секреты — нет.
Функция Набрано(Знач Состояние)
	Возврат Состояние <> Неопределено И Состояние.Набранное.Количество() > 0;
КонецФункции

// Текст по необязательному ключу: пустой ключ означает «текста нет».
Функция ТекстНеобязательный(Знач Ключ)
	Возврат ?(ЗначениеЗаполнено(Ключ), Тексты.Текст(Ключ), "");
КонецФункции

Функция Значение(Знач Значения, Знач ОписаниеПоля)
	Найденное = Неопределено;
	Если Значения <> Неопределено И Значения.Свойство(ОписаниеПоля.Имя, Найденное)
		И Найденное <> Неопределено Тогда
		Возврат Строка(Найденное);
	КонецЕсли;
	Возврат "";
КонецФункции

// Секретное поле многострочным не считается: секрет вводится в пароль и живёт с адресом.
Функция Многострочное(Знач ОписаниеПоля)
	Значение = Неопределено;
	Возврат ОписаниеПоля.Свойство("Многострочное", Значение) И Значение = Истина
		И НЕ Каталог.Секретное(ОписаниеПоля);
КонецФункции

#КонецОбласти

&Прозвище("ПоляПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "КаталогДействийПодписки") _Каталог) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	Окна = _Окна;
	Имена = _Имена;
	Каталог = _Каталог;

КонецПроцедуры
