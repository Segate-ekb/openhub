// Правило окна «Получатели»: как форма окна ложится правками в домен. Пул печатается своим режимом
// («все», «выбранные», «никакие»), пакеты — галками: в «все» отмечены и заперты, в «никакие» сняты
// и заперты, в «выбранные» правятся. Правки каждой ветки отдаёт кит одинаково со скриптом и без
// (Кит.ПравкиВеткиДерева — режим, основа массовой отметки, включённые и снятые): «выбранные» после
// «все» — весь пул минус снятые, после «никакие» — только отмеченные, без основы — хранимый выбор
// с правками; галки пакетов пула, который остаётся «все» или «никакие», ничего не правят. Форма
// старой вкладки — чужое поле или режим «все, кроме» — правок не даёт.

Перем Кит;       // Кит (кит) — разбор правок дерева галок
Перем Разбор;    // РазборФормы — поля формы, в том числе повторяющиеся
Перем Имена;     // ИменаПолейПодписки — имена галок, ключи узлов, служебные поля
Перем Режимы_;   // СервисИсключенийПодписок (подписки) — имена режимов пула

#Область ПубличныйИнтерфейс

// Правки формы окна «Получатели» — для СервисИсключенийПодписок.Применить. Форма старой вкладки
// правок не даёт.
//
// Параметры:
//  Тело - Строка - сырое тело формы.
//  Дерево - Структура - дерево получателей, как его видит сервер сейчас.
//
// Возвращаемое значение:
//  Структура:
//    * Устарела - Булево - форма старой вкладки: правок нет;
//    * Режимы - Соответствие - пул (Число) -> режим, который сменили;
//    * Основы - Соответствие - пул (Число) -> "все" | "никакие": пул стал «выбранные» массовой отметкой,
//      выбор начинается с неё;
//    * Включаемые - Массив из Число - пакеты, на которые галка ставится;
//    * Снимаемые - Массив из Число - пакеты, с которых галка снимается.
//
Функция Правки(Знач Тело, Знач Дерево) Экспорт

	Результат = Новый Структура("Устарела, Режимы, Основы, Включаемые, Снимаемые", Ложь, Новый Соответствие(),
		Новый Соответствие(), Новый Массив(), Новый Массив());
	Если НЕ ФормаОкна(Тело) Тогда
		Результат.Устарела = Истина;
		Возврат Результат;
	КонецЕсли;

	Разобранное = РазобранныеПравки(Тело, Дерево, Истина);
	Для Каждого Ветка Из Дерево.Пулы Цикл
		ВеткаВДомен(Результат, Ветка, Разобранное);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Правки формы окна «Пакеты пула» поправки пула к подписке хаба: только галки пакетов; пакет,
// снятый хозяином подписки, своей отметки не меняет.
//
// Параметры:
//  Тело - Строка - сырое тело формы.
//  Дерево - Структура - дерево поправки (СервисПоправокПодписок.ДеревоПоправки).
//
// Возвращаемое значение:
//  Структура - Устарела, Включаемые, Снимаемые (см. Правки).
//
Функция ПравкиПоправки(Знач Тело, Знач Дерево) Экспорт

	Результат = Новый Структура("Устарела, Включаемые, Снимаемые", Ложь, Новый Массив(), Новый Массив());
	Если НЕ ФормаОкна(Тело) Тогда
		Результат.Устарела = Истина;
		Возврат Результат;
	КонецЕсли;

	Разобранное = РазобранныеПравки(Тело, Дерево, Ложь);
	Для Каждого Ветка Из Дерево.Пулы Цикл
		Правка = Кит.ПравкиВеткиДерева(Разобранное, "", КлючиПакетов(Ветка));
		ПакетыВДомен(Результат, Ветка, Правка.Включённые, Правка.Снятые);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Строка поиска, с которой форма ушла: после сохранения окно возвращается к найденному.
//
// Параметры:
//  Тело - Строка - сырое тело формы.
//
// Возвращаемое значение:
//  Строка.
//
Функция Поиск(Знач Тело) Экспорт
	Значения = Разбор.Значения(Тело, Кит.ИменаПолейДерева().Найти);
	Возврат ?(Значения.Количество() = 0, "", СокрЛП(Значения[0]));
КонецФункции

// Совпадения поиска: пакеты дерева, чьё имя или имя пула содержит строку, — по пулам и именам.
// Строка короче двух знаков не ищет ничего.
//
// Параметры:
//  Дерево - Структура - дерево получателей или поправки.
//  Строка - Строка - строка поиска.
//
// Возвращаемое значение:
//  Массив из Структура - Ветка (пул), Пакет.
//
Функция Найденные(Знач Дерево, Знач Строка) Экспорт

	Результат = Новый Массив();
	Запрос = НРег(СокрЛП(Строка));
	Если СтрДлина(Запрос) < ДлинаПоиска() Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Ветка Из Дерево.Пулы Цикл
		ПулПодходит = СтрНайти(НРег(Ветка.Имя), Запрос) > 0;
		Для Каждого Пакет Из Ветка.Пакеты Цикл
			Если ПулПодходит ИЛИ СтрНайти(НРег(Пакет.Имя), Запрос) > 0 Тогда
				Результат.Добавить(Новый Структура("Ветка, Пакет", Ветка, Пакет));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Правится ли галка пакета в найденном: не снятый выше, а в окне «Получатели» — ещё и пакет пула
// «выбранные». Пакеты пула «все» и «никакие» решены режимом пула — в найденном, где сегментов нет,
// они заперты.
//
// Параметры:
//  Найденный - Структура - совпадение поиска (см. Найденные).
//  СРежимами - Булево - окно «Получатели» (у пулов режимы); Ложь — окно «Пакеты пула».
//
// Возвращаемое значение:
//  Булево.
//
Функция ГалкаПравится(Знач Найденный, Знач СРежимами) Экспорт
	Возврат НЕ Найденный.Пакет.ИсключёнСверху
		И (НЕ СРежимами ИЛИ Найденный.Ветка.Режим = Режимы_.РежимВыбранные());
КонецФункции

// Режимы пула в окне в порядке сегментов: у подписки хаба — «все / выбранные / никакие», у подписки
// пула — без «никакие» (свой пул она не исключает).
//
// Параметры:
//  ГалкиПулов - Булево - дерево подписки хаба.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция РежимыОкна(Знач ГалкиПулов) Экспорт
	Результат = Новый Массив();
	Результат.Добавить(Режимы_.РежимВсе());
	Результат.Добавить(Режимы_.РежимВыбранные());
	Если ГалкиПулов Тогда
		Результат.Добавить(Режимы_.РежимНикакие());
	КонецЕсли;
	Возврат Результат;
КонецФункции

// С какой длины строки поиск спрашивает сервер.
//
// Возвращаемое значение:
//  Число.
//
Функция ДлинаПоиска() Экспорт
	Возврат 2;
КонецФункции

#КонецОбласти

#Область ПравкиВДомен

// Правки одной ветки — в правки домена. Режим, равный напечатанному, правкой не считается (плашка
// записи шлёт режим без поля показанного); «выбранные», начатые массовой отметкой, — основа домена.
// Галки пакетов правят только пул, который остаётся или стал «выбранные».
Процедура ВеткаВДомен(Результат, Знач Ветка, Знач Разобранное)

	Правка = Кит.ПравкиВеткиДерева(Разобранное, Имена.КлючУзла("пул", Ветка.Идентификатор), КлючиПакетов(Ветка));
	Было = Ветка.Режим;
	Стало = ?(ЗначениеЗаполнено(Правка.Режим), Правка.Режим, Было);
	Если Стало = Режимы_.РежимВыбранные() И ЗначениеЗаполнено(Правка.БылРежим) Тогда
		Результат.Основы.Вставить(Ветка.Идентификатор, Правка.БылРежим);
	ИначеЕсли Стало <> Было Тогда
		Результат.Режимы.Вставить(Ветка.Идентификатор, Стало);
	КонецЕсли;
	Если Стало = Режимы_.РежимВыбранные() Тогда
		ПакетыВДомен(Результат, Ветка, Правка.Включённые, Правка.Снятые);
	КонецЕсли;

КонецПроцедуры

// Галки пакетов ветки — в правки домена: пакет, снятый хозяином подписки, своей отметки не меняет;
// названный в обоих перечнях снимается.
Процедура ПакетыВДомен(Результат, Знач Ветка, Знач Включённые, Знач Снятые)

	Включить = Перечнем(Включённые);
	Снять = Перечнем(Снятые);
	Для Каждого Пакет Из Ветка.Пакеты Цикл
		Ключ = Имена.КлючУзла("пакет", Пакет.Идентификатор);
		Если Пакет.ИсключёнСверху Тогда
			Продолжить;
		ИначеЕсли Снять.Получить(Ключ) <> Неопределено Тогда
			Результат.Снимаемые.Добавить(Пакет.Идентификатор);
		ИначеЕсли Включить.Получить(Ключ) <> Неопределено Тогда
			Результат.Включаемые.Добавить(Пакет.Идентификатор);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Разбор

// Правки кита — со скриптом правками скрипта, без скрипта сравнением с полем показанного; крестик
// ряда отмеченного приходит правкой сам. Без скрипта «Включить / снять найденные» сервер толкует по
// строке поиска.
Функция РазобранныеПравки(Знач Тело, Знач Дерево, Знач СРежимами)

	Разобранное = Кит.РазобратьПравкиДерева(Тело);
	Если НЕ Разобранное.Правки Тогда
		НайденныеБезСкрипта(Разобранное, Тело, Дерево, СРежимами);
	КонецЕсли;
	Возврат Разобранное;

КонецФункции

// «Включить / снять найденные» без скрипта: что отметить, сервер знает по строке поиска; галки, что
// не правятся (см. ГалкаПравится), не трогает.
Процедура НайденныеБезСкрипта(Разобранное, Знач Тело, Знач Дерево, Знач СРежимами)

	Значения = Разбор.Значения(Тело, Кит.ИменаПолейДерева().Найденные);
	Если Значения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Включить = НРег(СокрЛП(Значения[0])) = "вкл";
	Для Каждого Найденный Из Найденные(Дерево, Поиск(Тело)) Цикл
		Если НЕ ГалкаПравится(Найденный, СРежимами) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Имена.КлючУзла("пакет", Найденный.Пакет.Идентификатор);
		Убрать(Разобранное.Включить, Ключ);
		Убрать(Разобранное.Снять, Ключ);
		Если Включить И Найденный.Пакет.Исключён Тогда
			Разобранное.Включить.Добавить(Ключ);
		ИначеЕсли НЕ Включить И НЕ Найденный.Пакет.Исключён Тогда
			Разобранное.Снять.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Форма окна несёт только свои поля — токен, правки и поля дерева кита, галки — и только три режима
// пула. Чужое имя или режим «все, кроме» — форма старой вкладки или чужая.
Функция ФормаОкна(Знач Тело)

	Известные = Новый Соответствие();
	Для Каждого Имя Из Имена.ПоляДереваПолучателей() Цикл
		Известные.Вставить(Имена.Ключ(Имя), Истина);
	КонецЦикла;
	Поля = Кит.ИменаПолейДерева();
	Приставка = Имена.Ключ(Поля.ПриставкаРежима);
	Для Каждого Пара Из СтрРазделить(Строка(Тело), "&", Ложь) Цикл
		Позиция = СтрНайти(Пара, "=");
		Имя = Имена.Ключ(Раскодированное(?(Позиция = 0, Пара, Лев(Пара, Позиция - 1))));
		Значение = ?(Позиция = 0, "", Раскодированное(Сред(Пара, Позиция + 1)));
		Если СтрНачинаетсяС(Имя, Приставка) Тогда
			Режим = Значение;
		ИначеЕсли Известные.Получить(Имя) = Неопределено Тогда
			Возврат Ложь;
		ИначеЕсли Имя = Имена.Ключ(Поля.Режим) Тогда
			Режим = Сред(Значение, СтрНайти(Значение, ":", НаправлениеПоиска.СКонца) + 1);
		Иначе
			Продолжить;
		КонецЕсли;
		Если Режимы_.Режимы().Найти(НРег(СокрЛП(Режим))) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КлючиПакетов(Знач Ветка)
	Результат = Новый Массив();
	Для Каждого Пакет Из Ветка.Пакеты Цикл
		Результат.Добавить(Имена.КлючУзла("пакет", Пакет.Идентификатор));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Перечнем(Знач Ключи)
	Результат = Новый Соответствие();
	Для Каждого Ключ Из Ключи Цикл
		Результат.Вставить(Ключ, Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура Убрать(Ключи, Знач Ключ)
	Индекс = Ключи.Найти(Ключ);
	Пока Индекс <> Неопределено Цикл
		Ключи.Удалить(Индекс);
		Индекс = Ключи.Найти(Ключ);
	КонецЦикла;
КонецПроцедуры

Функция Раскодированное(Знач Текст)
	Возврат РаскодироватьСтроку(СтрЗаменить(Текст, "+", " "), СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти

&Прозвище("ПравилоДереваПолучателей")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РазборФормы") _Разбор,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "СервисИсключенийПодписок") _Режимы) Экспорт

	Кит = _Кит;
	Разбор = _Разбор;
	Имена = _Имена;
	Режимы_ = _Режимы;

КонецПроцедуры
