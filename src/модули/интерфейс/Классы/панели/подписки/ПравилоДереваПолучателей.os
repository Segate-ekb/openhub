// Правило дерева получателей: состояние галки пула по его пакетам и перевод галок формы
// в исключаемые и возвращаемые узлы. Состояние пула выводится из пакетов — сняты все, значит
// снят пул целиком, — и форма с одним и тем же видом экрана сохраняется одинаково, отправил
// её скрипт страницы или браузер без него.

Перем РазборФормы; // РазборФормы — чтение полей формы
Перем Имена;       // ИменаПолейПодписки — имена галок и перечня показанных узлов
Перем Исключения;  // СервисИсключенийПодписок (подписки) — узел дерева

#Область ПубличныйИнтерфейс

// Состояние галки пула, как его печатает экран: пул исключён целиком или исключены все его
// пакеты — «выкл», исключена часть пакетов — «частично», иначе «вкл».
//
// Параметры:
//  Пул - Структура - пул дерева получателей (Исключён, ИсключеноПакетов, Пакеты).
//
// Возвращаемое значение:
//  Строка - "вкл" | "выкл" | "частично".
//
Функция СостояниеПула(Знач Пул) Экспорт

	Пакетов = Пул.Пакеты.Количество();
	Если Пул.Исключён ИЛИ (Пакетов > 0 И Пул.ИсключеноПакетов = Пакетов) Тогда
		Возврат "выкл";
	ИначеЕсли Пул.ИсключеноПакетов > 0 Тогда
		Возврат "частично";
	КонецЕсли;
	Возврат "вкл";

КонецФункции

// Узлы, которые форма дерева снимает и возвращает. Форма касается только показанных узлов,
// кроме одного случая: галка пула отвечает за все его пакеты, показанные и нет.
//
// Параметры:
//  Форма - Соответствие - поля формы дерева.
//  Дерево - Структура - дерево получателей подписки как сейчас (СервисИсключенийПодписок.ДеревоПолучателей):
//           ПодпискаХаба и Пулы с пакетами и отметками исключения.
//
// Возвращаемое значение:
//  Структура:
//    * Исключаемые - Массив из Структура - узлы (СервисИсключенийПодписок.Узел), с которых галка снимается;
//    * Включаемые - Массив из Структура - узлы, на которые галка ставится.
//
Функция Отметки(Знач Форма, Знач Дерево) Экспорт

	Результат = Новый Структура("Исключаемые, Включаемые", Новый Массив(), Новый Массив());
	Показанные = ПоказанныеУзлы(Форма);
	Решённые = Новый Соответствие(); // узлы, за которые уже решила галка их пула

	Если Дерево.ПодпискаХаба Тогда
		Для Каждого Пул Из Дерево.Пулы Цикл
			Если Показанные.Получить(Имена.КлючУзла("пул", Пул.Идентификатор)) <> Неопределено Тогда
				ОтметитьПул(Результат, Форма, Пул, Показанные, Решённые);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// пакеты подписки пула и узлы вне дерева: удалённый после показа, чужой — домен пропустит их одинаково
	Для Каждого КиЗ Из Показанные Цикл
		Если Решённые.Получить(КиЗ.Ключ) = Неопределено Тогда
			Отметить(Результат, Узел(КиЗ.Значение.ТипУзла, КиЗ.Значение.Идентификатор), Отмечен(Форма, КиЗ.Значение));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ГалкаПула

// Пул решается целиком по тому, что видно на экране: его галке, галкам показанных пакетов
// и состоянию, с которым он был напечатан. Снят на экране — снят целиком. Был снят, а теперь
// отмечен вместе со всеми показанными пакетами (или без единого — так возвращают пул без
// скрипта) — включён целиком. Иначе пул включён, показанные пакеты — по своим галкам,
// непоказанные у снятого пула сняты, у остальных — как были.
Процедура ОтметитьПул(Знач Результат, Знач Форма, Знач Пул, Знач Показанные, Знач Решённые)

	Решённые.Вставить(Имена.КлючУзла("пул", Пул.Идентификатор), Истина);
	Для Каждого Пакет Из Пул.Пакеты Цикл
		Решённые.Вставить(Имена.КлючУзла("пакет", Пакет.Идентификатор), Истина);
	КонецЦикла;

	Экран = ЭкранПула(Форма, Пул, Показанные);
	БылСнят = (СостояниеПула(Пул) = "выкл");

	Если ПулСнятНаЭкране(Экран, БылСнят, Пул) Тогда
		СнятьПулЦеликом(Результат, Пул);
	ИначеЕсли БылСнят И (Экран.ОтмеченоПоказанных = 0 ИЛИ Экран.ОтмеченоПоказанных = Экран.Показано) Тогда
		ВключитьПулЦеликом(Результат, Пул);
	Иначе
		ВключитьПулПоГалкам(Результат, Форма, Пул, Показанные, БылСнят);
	КонецЕсли;

КонецПроцедуры

// Снят ли пул на экране так, как его покажет скрипт. Напечатанный снятым остаётся снятым, пока
// не отмечены ни его галка, ни один показанный пакет: без скрипта галку пула под отмеченным
// пакетом человек не трогает — скрипт поднял бы её сам. Включённый снят, если снята его галка
// или сняты все пакеты, а включённых непоказанных нет.
Функция ПулСнятНаЭкране(Знач Экран, Знач БылСнят, Знач Пул)

	Если БылСнят Тогда
		Возврат НЕ Экран.ГалкаПула И Экран.ОтмеченоПоказанных = 0;
	КонецЕсли;
	Возврат НЕ Экран.ГалкаПула ИЛИ (Экран.ПакетовВключено = 0 И Пул.Пакеты.Количество() > 0);

КонецФункции

// Что видно на экране по пулу: его галка, сколько пакетов показано и отмечено и сколько
// пакетов пула включено с учётом непоказанных, какими они были напечатаны.
Функция ЭкранПула(Знач Форма, Знач Пул, Знач Показанные)

	Экран = Новый Структура("ГалкаПула, Показано, ОтмеченоПоказанных, ПакетовВключено",
		Отмечен(Форма, Новый Структура("ТипУзла, Идентификатор", "пул", Пул.Идентификатор)), 0, 0, 0);
	Для Каждого Пакет Из Пул.Пакеты Цикл
		Показанный = Показанные.Получить(Имена.КлючУзла("пакет", Пакет.Идентификатор));
		Если Показанный = Неопределено Тогда
			Экран.ПакетовВключено = Экран.ПакетовВключено + ?(Пакет.Исключён, 0, 1);
			Продолжить;
		КонецЕсли;
		Экран.Показано = Экран.Показано + 1;
		Если Отмечен(Форма, Показанный) Тогда
			Экран.ОтмеченоПоказанных = Экран.ОтмеченоПоказанных + 1;
			Экран.ПакетовВключено = Экран.ПакетовВключено + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Экран;

КонецФункции

// Строка «пул» перекрывает строки его пакетов: они снимаются, и включённый снова пул
// вернётся со всеми пакетами.
Процедура СнятьПулЦеликом(Знач Результат, Знач Пул)

	Результат.Исключаемые.Добавить(Узел("пул", Пул.Идентификатор));
	Для Каждого Пакет Из Пул.Пакеты Цикл
		Если Пакет.Исключён Тогда
			Результат.Включаемые.Добавить(Узел("пакет", Пакет.Идентификатор));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ВключитьПулЦеликом(Знач Результат, Знач Пул)

	Результат.Включаемые.Добавить(Узел("пул", Пул.Идентификатор));
	Для Каждого Пакет Из Пул.Пакеты Цикл
		Если Пакет.Исключён Тогда
			Результат.Включаемые.Добавить(Узел("пакет", Пакет.Идентификатор));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Пул в подписке, будущие пакеты попадут сами; пакет меняется, только если его вид разошёлся
// с сохранённым.
Процедура ВключитьПулПоГалкам(Знач Результат, Знач Форма, Знач Пул, Знач Показанные, Знач БылСнят)

	Результат.Включаемые.Добавить(Узел("пул", Пул.Идентификатор));
	Для Каждого Пакет Из Пул.Пакеты Цикл
		Показанный = Показанные.Получить(Имена.КлючУзла("пакет", Пакет.Идентификатор));
		Включён = ?(Показанный = Неопределено, НЕ БылСнят И НЕ Пакет.Исключён, Отмечен(Форма, Показанный));
		Если Включён И Пакет.Исключён Тогда
			Результат.Включаемые.Добавить(Узел("пакет", Пакет.Идентификатор));
		ИначеЕсли НЕ Включён И НЕ Пакет.Исключён Тогда
			Результат.Исключаемые.Добавить(Узел("пакет", Пакет.Идентификатор));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Показанные узлы по ключу «<тип>_<идентификатор>»; строки, не называющие узла, пропускаются.
Функция ПоказанныеУзлы(Знач Форма)

	Результат = Новый Соответствие();
	Для Каждого Запись Из СтрРазделить(РазборФормы.Поле(Форма, Имена.ИмяПоляПоказанныхУзлов()), ",", Ложь) Цикл
		Показанный = Имена.РазобратьКлючУзла(Запись);
		Если Показанный <> Неопределено Тогда
			Результат.Вставить(Имена.КлючУзла(Показанный.ТипУзла, Показанный.Идентификатор), Показанный);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Галка отмечена — значит, отправлена: значение её не читается, подделать им ничего нельзя.
Функция Отмечен(Знач Форма, Знач Показанный)
	Возврат ЗначениеЗаполнено(СокрЛП(РазборФормы.Поле(Форма,
		Имена.ИмяПоляУзла(Показанный.ТипУзла, Показанный.Идентификатор))));
КонецФункции

Процедура Отметить(Знач Результат, Знач Узел, Знач Включён)
	Если Включён Тогда
		Результат.Включаемые.Добавить(Узел);
	Иначе
		Результат.Исключаемые.Добавить(Узел);
	КонецЕсли;
КонецПроцедуры

Функция Узел(Знач ТипУзла, Знач Идентификатор)
	Возврат Исключения.Узел(ТипУзла, Идентификатор);
КонецФункции

#КонецОбласти

&Прозвище("ПравилоДереваПолучателей")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "СервисИсключенийПодписок") _Исключения) Экспорт

	РазборФормы = _РазборФормы;
	Имена = _Имена;
	Исключения = _Исключения;

КонецПроцедуры
