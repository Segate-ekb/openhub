// Блок событий окна подписки: флажок «на что подписаться» и поле порога на каждый тип
// события; пара связана ИНДЕКСОМ в перечне известных типов, обратно её читает ПультПодписок.

Перем Кит;              // Кит (кит) — фабрика элементов экрана
Перем СервисПодписок;   // СервисПодписок (подписки) — перечень известных типов
Перем СобытияХаба;      // КаталогСобытий (подписки) — подпись, пояснение и параметр типа
Перем ПараметрыСобытий; // ПараметрыПодписки (подписки) — значение параметра у подписки
Перем Имена;            // ИменаПолейПодписки — имена полей раздела
Перем Окна;             // ОкноРаздела — набранное отбитой формы
Перем Тексты;           // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Флажки событий объекта с полями их порогов: событие самого хаба — только у подписки хаба. У новой
// подписки отмечены все события, кроме событий самого хаба (их выбирают по желанию), у правимой —
// её набор, после отказа — присланное.
//
// Параметры:
//  Объект - Структура - описание объекта подписки (СервисПодписок.Объект*).
//  Подписка - Вебхук, Неопределено - правимая подписка; Неопределено — новая.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  ЭлементЭкрана - группа флажков.
//
Функция Набор(Знач Объект, Знач Подписка, Знач Состояние) Экспорт

	Отмеченные = ОтмеченныеПодписки(Подписка);

	Набор = Кит.Группа(Тексты.Текст("subscriptions.form.events.legend"));
	Известные = СервисПодписок.ИзвестныеТипы();
	Для Индекс = 0 По Известные.Количество() - 1 Цикл
		ТипСобытия = Известные[Индекс];
		Если НЕ ДоступноОбъекту(ТипСобытия, Объект) Тогда
			Продолжить;
		КонецЕсли;
		Набор.Добавить(Кит.Холст(
			Флажок(Индекс, ТипСобытия, Состояние, ОтмеченоСразу(ТипСобытия, Подписка, Отмеченные)),
			ПолеПорога(Индекс, ТипСобытия, Подписка, Состояние)));
	КонецЦикла;
	Возврат Набор;

КонецФункции

// Человеческое имя типа события из перечня.
//
// Параметры:
//  Тип - Строка - машинный тип события.
//
// Возвращаемое значение:
//  Строка - подпись типа; неизвестный тип называет себя сам.
//
Функция ПодписьТипа(Знач Тип) Экспорт
	Запись = СобытияХаба.Запись(Тип);
	Возврат ?(Запись = Неопределено, Тип, Запись.Подпись);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// У новой подписки отмечено всё, кроме событий самого хаба: весть о новой версии хаба в чат релизов
// без спроса не уходит; у правимой — её набор.
Функция ОтмеченоСразу(Знач ТипСобытия, Знач Подписка, Знач Отмеченные)
	Если Подписка = Неопределено Тогда
		Возврат НЕ СобытияХаба.ТолькоХаба(ТипСобытия);
	КонецЕсли;
	Возврат Отмеченные.Получить(НРег(СокрЛП(Строка(ТипСобытия)))) = Истина;
КонецФункции

// Событие самого хаба подписке пула и пакета не предлагается.
Функция ДоступноОбъекту(Знач Тип, Знач Объект)
	Возврат СобытияХаба.ДоступноОбъекту(Тип, Строка(Объект.ТипОбъекта));
КонецФункции

// Когда возникает событие — строкой под флажком.
Функция КогдаВозникает(Знач Тип)
	Запись = СобытияХаба.Запись(Тип);
	Возврат ?(Запись = Неопределено, Тип, Строка(Запись.Пояснение));
КонецФункции

Функция ОтмеченныеПодписки(Знач Подписка)

	Результат = Новый Соответствие();
	Если Подписка = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из СтрРазделить(Строка(Подписка.ТипыСобытий), ",") Цикл
		Результат.Вставить(НРег(СокрЛП(Элемент)), Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Флажок(Знач Индекс, Знач ТипСобытия, Знач Состояние, Знач Отмечен)

	Имя = Имена.ИмяПоляСобытия(Индекс);
	Возврат Кит.Поле(Имя, ПодписьТипа(ТипСобытия)).ТипЗначения("флажок")
		.Значение(Имена.ЗначениеОтмечено())
		.Отмечено(Окна.Отмечено(Состояние, Имя, Отмечен, Имена.ЗначениеОтмечено()))
		.Подсказка(КогдаВозникает(ТипСобытия));

КонецФункции

// Значение после отказа берётся из формы, иначе из подписки, иначе из умолчания каталога.
Функция ПолеПорога(Знач Индекс, Знач ТипСобытия, Знач Подписка, Знач Состояние)

	Описание = СобытияХаба.ПараметрПодписки(ТипСобытия);
	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Действующее = ?(Подписка = Неопределено, "", Строка(ПараметрыСобытий.Значение(Подписка, ТипСобытия)));
	Если НЕ ЗначениеЗаполнено(Действующее) Тогда
		Действующее = Формат(Описание.ПоУмолчанию, "ЧГ=0; ЧН=0");
	КонецЕсли;

	Имя = Имена.ИмяПоляПараметраСобытия(Индекс);
	Возврат Кит.Поле(Имя, Тексты.Текст("subscriptions.form.threshold.label"))
		.ТипЗначения(Тип("Число"))
		.Значение(Окна.Значение(Состояние, Имя, Действующее))
		.Справка(Тексты.Текст("subscriptions.form.threshold.hint"))
		.Ошибка(Окна.Отказ(Состояние, Имя));

КонецФункции

#КонецОбласти

&Прозвище("ПоляСобытийПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "КаталогСобытий") _СобытияХаба,
	&Пластилин(Значение = "ПараметрыПодписки") _ПараметрыСобытий,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	СервисПодписок = _СервисПодписок;
	СобытияХаба = _СобытияХаба;
	ПараметрыСобытий = _ПараметрыСобытий;
	Имена = _Имена;
	Окна = _Окна;
	Тексты = _Тексты;

КонецПроцедуры
