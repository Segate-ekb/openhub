// Раздел «Подписки» объекта: список подписок на события с правкой и форма заведения новой.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем СервисПодписок;    // СервисПодписок (подписки)
Перем ТипыДействий;      // КаталогДействийПодписки — типы с формой настроек
Перем ПоляДействия;      // ПоляПодписки — набор ввода выбранного типа
Перем Имена;             // ИменаПолейПодписки — имена полей раздела
Перем Бланки;            // БланкРаздела — адрес и токен раздела, формы на них
Перем РазборФормы;       // РазборФормы — чтение отклонённой формы
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем ПоляСобытий;       // ПоляСобытийПодписки — блок «на что подписаться»
Перем ПоляСвойств;       // ПоляСвойствПодписки — название и сужение снизу
Перем ОтборТегов;        // ОтборТеговПодписки — галки отбора по тегам
Перем Сводки;            // СводкаПодписки — название, состояние и сведения в свёрнутой карточке
Перем Сузившие;          // ПоправкиНижестоящих — кто сузил подписку снизу
Перем Получатели;        // ДеревоПолучателей — у подписки хаба и пула: о ком она сообщает
Перем ПараметрыПодписки; // ПараметрыПодписки (подписки) — сохранённый отбор подписки
Перем Проверка;          // ПроверкаПодпискиДоСохранения — предпросмотр и проба формы до сохранения
Перем Предпросмотр;      // ПредпросмотрУведомления (подписки) — есть ли у типа текст до сохранения
Перем Ссылки;            // ПараметрыСсылки (основа) — параметр запроса на адресе

#Область ПубличныйИнтерфейс

// Секции раздела «подписки» объекта.
//
// Параметры:
//  Параметры - Структура:
//    * Объект - Структура - описание объекта (СервисПодписок.Объект*);
//    * Адрес - Строка - адрес раздела (он же action всех форм);
//    * Токен - Строка - CSRF-токен сессии;
//    * НовыйСекрет - Строка - секрет только что созданной подписки ("" — нет);
//    * Пояснение - Строка - что именно получает подписчик этого объекта;
//    * МожноМенять - Булево - есть ли у зрителя право управлять подписками объекта;
//    * Тип - Строка - тип действия, поля которого показывает форма заведения;
//    * Форма - Соответствие - отклонённая форма, значениями которой заполняется разметка ("" и Неопределено — чистая форма);
//    * ПравкаИд - Строка, Число - подписка, чью форму правки отклонили (0 — отклонена форма заведения);
//    * Зритель - Пользователь - кто смотрит раздел: дерево получателей открывается от его имени;
//    * ДеревоИд - Строка - подписка, чьё дерево получателей открыто ("" — ничьё);
//    * Поиск - Строка - поиск пакета в открытом дереве.
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Бланк = Бланки.Раздела(Параметры);
	МожноМенять = (Параметры.МожноМенять = Истина);
	Тип = ТипыДействий.ВыбранныйТип(ЗапрошенныйТип(Параметры));
	Отклонённая = ОтклонённаяФорма(Параметры);
	ПравкаИд = ИдПравимой(Параметры);

	Содержимое = Кит.Холст();
	Содержимое.Добавить(ПоказСекрета(Параметры));
	Содержимое.Добавить(СписокПодписок(Параметры, Бланк, МожноМенять, Отклонённая, ПравкаИд));
	Содержимое.Добавить(Заведение(Параметры.Объект, Бланк, Тип, МожноМенять,
		ОтказЗаведения(Отклонённая, ПравкаИд)));

	Основная = РендерерНастроек.Секция(Тексты.Текст("subscriptions.section.title"),
		Параметры.Пояснение, Содержимое.Рендер());
	Основная.Иконка = "стрелка";

	Результат = Новый Массив();
	Результат.Добавить(Основная);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СписокПодписок

// Секрет показывается ровно один раз — сразу после создания подписки.
Функция ПоказСекрета(Знач Параметры)

	Секрет = "";
	Если Параметры.Свойство("НовыйСекрет") Тогда
		Секрет = Строка(Параметры.НовыйСекрет);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Секрет) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.БлокКоманды(Секрет);

КонецФункции

// Карточка с отклонённой правкой открыта: иначе причина отказа висит над свёрнутым списком.
Функция СписокПодписок(Знач Параметры, Знач Бланк, Знач МожноМенять,
	Знач Отклонённая, Знач ПравкаИд)

	Подписки = СервисПодписок.Список(Параметры.Объект);
	Если Подписки.Количество() = 0 Тогда
		Возврат Кит.Примечание(Тексты.Текст("subscriptions.list.empty"));
	КонецЕсли;

	Список = Кит.Холст();
	Для Каждого Подписка Из Подписки Цикл
		Правится = (Идентификатор(Подписка) = ПравкаИд);
		Список.Добавить(КарточкаПодписки(Параметры, Подписка, Бланк, МожноМенять,
			?(Правится, Отклонённая, Неопределено), Правится));
	КонецЦикла;
	Список.Добавить(Кит.Примечание(Тексты.Текст("subscriptions.list.note")));

	Возврат Список;

КонецФункции

// Отбитая правка и открытое дерево получателей приезжают раскрытыми: человек видит то, за чем
// пришёл, а не свёрнутую строку.
Функция КарточкаПодписки(Знач Параметры, Знач Подписка, Знач Бланк, Знач МожноМенять,
	Знач Отклонённая, Знач Правится)

	Карточка = Кит.Раскрывашка();
	Если Правится ИЛИ (МожноМенять И Получатели.Открыто(Параметры, Подписка)) Тогда
		Карточка.Открыть();
	КонецЕсли;

	Карточка.Шапка().Добавить(Сводки.Своя(Параметры, Подписка));
	Карточка.Добавить(ТелоКарточки(Параметры, Подписка, БланкПодписки(Бланк, Подписка),
		МожноМенять, Отклонённая));
	Возврат Карточка;

КонецФункции

// Получатели и сузившие — сверху: это о том, кому подписка сообщает; ниже форма правки
// разделами и все действия подписки одним рядом.
Функция ТелоКарточки(Знач Параметры, Знач Подписка, Знач Бланк, Знач МожноМенять, Знач Отклонённая)

	Если НЕ МожноМенять Тогда
		Возврат Кит.Примечание(Тексты.Текст("subscriptions.readonly.note"));
	КонецЕсли;

	Тело = Кит.Холст();
	Тело.Добавить(Получатели.Блок(Параметры, Подписка, Бланк));
	Тело.Добавить(Сузившие.Блок(Подписка));
	Тело.Добавить(ФормаПравки(Параметры.Объект, Подписка, Бланк, Отклонённая));
	Тело.Добавить(ДействияПодписки(Бланк, Подписка));
	Возврат Тело;

КонецФункции

#КонецОбласти

#Область ФормаПравки

// Тип не меняется: форма говорит об этом словами, а сервер отбивает подмену типа в теле.
// Кнопка «Сохранить» стоит в ряду действий подписки и отправляет форму по её якорю; включает
// и выключает подписку кнопка того же ряда, а правка сохраняет её как есть.
Функция ФормаПравки(Знач Объект, Знач Подписка, Знач Бланк, Знач Отклонённая)

	Тип = СервисПодписок.ТипДействияПодписки(Подписка);
	Если НЕ СервисПодписок.МожноПравить(Подписка) Тогда
		Возврат Кит.Примечание(Тексты.Текст("subscriptions.edit.unsupported"));
	КонецЕсли;
	Значения = ЗначенияФормы(СервисПодписок.ЗначенияПравки(Подписка), Отклонённая, Тип);

	Правка = Бланки.Форма(Бланк, "save", "столбик").Якорь(ЯкорьПравки(Подписка));
	Правка.Добавить(ВключённостьКакЕсть(Подписка));
	Правка.Добавить(ПоляСвойств.Название(Подписка, Отклонённая));

	Куда = Правка.Добавить(Раздел(Тексты.Текст("subscriptions.form.section.where")));
	Куда.Добавить(ПоляДействия.Правки(Тип, Значения));
	Куда.Добавить(Кит.Примечание(Тексты.Текст("subscriptions.edit.type.locked")));

	Правка.Добавить(РазделОЧём(Объект, Подписка, Отклонённая));
	Правка.Добавить(РазделКому(Объект, Подписка, Отклонённая));
	Правка.Добавить(РазделТекста(Бланк, Тип, ПоляДействия.ТекстПравки(Тип, Значения)));
	Возврат Правка;

КонецФункции

Функция ВключённостьКакЕсть(Знач Подписка)
	Возврат Кит.СкрытоеПоле(Имена.ИмяПоляВключить(), ?(Подписка.Активен = Истина, Имена.ЗначениеОтмечено(), ""));
КонецФункции

// Секретов ни в сохранённом, ни в присланном наборе нет: в разметку они не возвращаются.
Функция ЗначенияФормы(Знач Сохранённые, Знач Отклонённая, Знач Тип)

	Если Отклонённая = Неопределено Тогда
		Возврат Сохранённые;
	КонецЕсли;

	Результат = Новый Структура();
	Для Каждого КиЗ Из Сохранённые Цикл
		Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Для Каждого ОписаниеПоля Из ТипыДействий.ПоляТипа(Тип) Цикл
		Если ТипыДействий.Секретное(ОписаниеПоля) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(ОписаниеПоля.Имя, РазборФормы.Поле(Отклонённая, ОписаниеПоля.ИмяПоля));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область КнопкиПодписки

// Все действия подписки одним рядом: сохранить правку, проверить доставку, выключить, удалить.
// «Сохранить» и проба настройками формы стоят вне формы правки и отправляют её по якорю.
Функция ДействияПодписки(Знач Бланк, Знач Подписка)

	Действия = Кит.Ряд("действия");
	Если СервисПодписок.МожноПравить(Подписка) Тогда
		Действия.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер, Форма",
			Тексты.Текст("subscriptions.button.save"), "основная", "малый", ЯкорьПравки(Подписка))));
		Действия.Добавить(Проверка.КнопкаПробы(Бланк, СервисПодписок.ТипДействияПодписки(Подписка),
			ЯкорьПравки(Подписка)));
	КонецЕсли;
	Действия.Добавить(КнопкаПробыСохранённой(Бланк, Подписка));
	Действия.Добавить(КнопкаПереключения(Бланк, Подписка));
	Действия.Добавить(КнопкаУдаления(Бланк));
	Возврат Действия;

КонецФункции

Функция КнопкаПереключения(Знач Бланк, Знач Подписка)

	Включён = (Подписка.Активен = Истина);

	Форма = Бланки.Форма(Бланк, "toggle");
	Форма.Добавить(Кит.СкрытоеПоле(Имена.ИмяПоляВключить(), ?(Включён, "0", "1")));
	Форма.Добавить(КнопкаФормы(?(Включён, Тексты.Текст("subscriptions.button.disable"),
		Тексты.Текст("subscriptions.button.enable"))));
	Возврат Форма;

КонецФункции

// Проба СОХРАНЁННЫМИ настройками — у подписки без формы правки; в форме правки проба своя.
Функция КнопкаПробыСохранённой(Знач Бланк, Знач Подписка)

	Если НЕ СервисПодписок.МожноПробовать(Подписка) ИЛИ СервисПодписок.МожноПравить(Подписка) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Бланки.КнопкаДействия(Бланк, "test", Тексты.Текст("subscriptions.button.test"));

КонецФункции

Функция КнопкаУдаления(Знач Бланк)

	Возврат Бланки.КнопкаДействия(Бланк, "delete",
		Тексты.Текст("subscriptions.button.delete"), "опасная");

КонецФункции

#КонецОбласти

#Область Заведение

// У распорядителя — заголовок и форма, у зрителя — пояснение, почему форм нет.
Функция Заведение(Знач Объект, Знач Бланк, Знач Тип, Знач МожноМенять, Знач Отклонённая)

	Если НЕ МожноМенять Тогда
		Возврат Кит.Примечание(Тексты.Текст("subscriptions.readonly.note"));
	КонецЕсли;

	Блок = Кит.Холст();
	Блок.Добавить(ЗаголовокЗаведения());
	Блок.Добавить(ФормаЗаведения(Объект, Бланк, Тип, Отклонённая));
	Возврат Блок;

КонецФункции

Функция ЗаголовокЗаведения()

	Заголовок = Кит.Заголовок(3);
	Заголовок.Добавить(Кит.Текст(Тексты.Текст("subscriptions.form.title")));
	Возврат Заголовок;

КонецФункции

// Форма заведения: настройки действия — из деклараций обработчиков (КаталогДействийПодписки).
Функция ФормаЗаведения(Знач Объект, Знач Бланк, Знач Тип, Знач Отклонённая)

	Форма = Бланки.Форма(Бланк, "", "столбик");
	Форма.Добавить(ПоляСвойств.Название(Неопределено, Отклонённая));

	Куда = Форма.Добавить(Раздел(Тексты.Текст("subscriptions.form.section.where")));
	Куда.Добавить(ПереключательТипа(Бланк, Тип));
	Куда.Добавить(ПоляДействия.Заведения(Тип, Отклонённая));

	Форма.Добавить(РазделОЧём(Объект, Неопределено, Отклонённая));
	Форма.Добавить(РазделКому(Объект, Неопределено, Отклонённая));
	Форма.Добавить(РазделТекста(Бланк, Тип, ПоляДействия.ТекстЗаведения(Тип, Отклонённая)));
	Форма.Добавить(ДействияЗаведения(Бланк, Тип));
	Возврат Форма;

КонецФункции

// «Создать» и проба настройками формы — одним рядом в конце формы.
Функция ДействияЗаведения(Знач Бланк, Знач Тип)

	Действия = Кит.Ряд("действия");
	Действия.Добавить(КнопкаФормы(Тексты.Текст("subscriptions.button.create"), "основная"));
	Действия.Добавить(Проверка.КнопкаПробы(Бланк, Тип));
	Возврат Действия;

КонецФункции

// Ссылки, а не поле выбора: у каждого набора полей свой адрес, и страница живёт без JS.
Функция ПереключательТипа(Знач Бланк, Знач Тип)

	Типы = ТипыДействий.Типы();
	Если Типы.Количество() < 2 Тогда
		Возврат Кит.Ничего(); // выбирать не из чего — переключатель был бы декорацией
	КонецЕсли;

	Ряд = Кит.Ряд("выбор").Подпись(Тексты.Текст("subscriptions.form.type.legend"));
	Для Каждого Вариант Из Типы Цикл
		Ряд.Добавить(КнопкаТипа(Бланк, Вариант, Тип));
	КонецЦикла;
	Возврат Ряд;

КонецФункции

Функция КнопкаТипа(Знач Бланк, Знач Вариант, Знач Тип)

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Текущая",
		Вариант.Подпись,
		Ссылки.Установить(Бланки.Адрес(Бланк), Имена.ИмяПараметраТипа(), Вариант.Тип),
		?(Вариант.Тип = Тип, "основная", "вторичная"),
		Вариант.Тип = Тип));

КонецФункции

#КонецОбласти

#Область РазделыФормы

// Раздел формы подписки после названия: куда шлём, о чём, кому, текст.
Функция Раздел(Знач Подпись)
	Возврат Кит.Группа(Подпись, "раздел");
КонецФункции

// О чём сообщаем: события с порогами и отбор версий по тегам.
Функция РазделОЧём(Знач Объект, Знач Подписка, Знач Отклонённая)

	ОЧём = Раздел(Тексты.Текст("subscriptions.form.section.what"));
	ОЧём.Добавить(ПоляСобытий.Набор(Подписка, Отклонённая));
	ОЧём.Добавить(ОтборТегов.Галки(Объект, Подписка, СохранённыйОтбор(Подписка), Отклонённая));
	Возврат ОЧём;

КонецФункции

// Кому: нижестоящие пулы и пакеты. У подписки пакета ниже никого — раздела нет.
Функция РазделКому(Знач Объект, Знач Подписка, Знач Отклонённая)

	ТипОбъекта = НРег(СокрЛП(Строка(Объект.ТипОбъекта)));
	Если ТипОбъекта = "пакет" Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Кому = Раздел(Тексты.Текст("subscriptions.form.section.whom"));
	Кому.Добавить(Кит.Примечание(ОКомСообщает(ТипОбъекта = "пул", Подписка = Неопределено)));
	Кому.Добавить(ПоляСвойств.СужениеСнизу(Объект, Подписка, Отклонённая));
	Возврат Кому;

КонецФункции

// У подписки пула получатели — только её пакеты; у новой подписки дерева ещё нет.
Функция ОКомСообщает(Знач ПодпискаПула, Знач Новая)

	Если ПодпискаПула Тогда
		Возврат ?(Новая, Тексты.Текст("subscriptions.form.whom.recipients.pool.new"),
			Тексты.Текст("subscriptions.form.whom.recipients.pool"));
	КонецЕсли;
	Возврат ?(Новая, Тексты.Текст("subscriptions.form.whom.recipients.new"),
		Тексты.Текст("subscriptions.form.whom.recipients"));

КонецФункции

// Текст уведомления, под ним — как он придёт (на лету) и кнопка предпросмотра без скрипта;
// у типа без своего текста и без предпросмотра раздела нет.
Функция РазделТекста(Знач Бланк, Знач Тип, Знач Поля)

	Если НЕ ПоляДействия.ЕстьТекст(Тип) И НЕ Предпросмотр.Поддержан(Тип) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Текст = Раздел(Тексты.Текст("subscriptions.form.section.text"));
	Текст.Добавить(Поля);
	Текст.Добавить(Проверка.МестоПредпросмотра(Бланк, Тип));
	Текст.Добавить(Проверка.КнопкаПредпросмотра(Бланк, Тип));
	Возврат Текст;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КнопкаФормы(Знач Подпись, Знач Вариант = "вторичная", Знач Размер = "малый")
	Возврат Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер", Подпись, Вариант, Размер));
КонецФункции

// Якорь формы правки: по нему кнопка «Сохранить» из ряда действий отправляет форму.
Функция ЯкорьПравки(Знач Подписка)
	Возврат "подписка-" + Идентификатор(Подписка);
КонецФункции

Функция СохранённыйОтбор(Знач Подписка)
	Возврат ?(Подписка = Неопределено, Новый Массив(), ПараметрыПодписки.Свойства(Подписка).ОтборТегов);
КонецФункции

// Формы одной подписки постят на её собственный адрес внутри раздела.
Функция БланкПодписки(Знач Бланк, Знач Подписка)
	Возврат Бланки.Вложенный(Бланк, Идентификатор(Подписка));
КонецФункции

Функция Идентификатор(Знач Подписка)
	Возврат Формат(Подписка.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

// Отбили форму правки — форма заведения остаётся чистой: отказ показывается в карточке.
Функция ОтказЗаведения(Знач Отклонённая, Знач ПравкаИд)
	Возврат ?(ЗначениеЗаполнено(ПравкаИд) И ПравкаИд <> "0", Неопределено, Отклонённая);
КонецФункции

// Тип из параметров раздела: его отсутствие — обычное «зашли по прямой ссылке».
Функция ЗапрошенныйТип(Знач Параметры)
	Значение = Неопределено;
	Если НЕ Параметры.Свойство("Тип", Значение) ИЛИ Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

// Отклонённая форма приходит только со страницы отказа; на обычной её нет.
Функция ОтклонённаяФорма(Знач Параметры)
	Значение = Неопределено;
	Если НЕ Параметры.Свойство("Форма", Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ?(ТипЗнч(Значение) = Тип("Соответствие"), Значение, Неопределено);
КонецФункции

// Подписка, чью форму правки отбили: «0» означает, что отбили форму заведения.
Функция ИдПравимой(Знач Параметры)
	Значение = Неопределено;
	Параметры.Свойство("ПравкаИд", Значение);
	Возврат СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
КонецФункции

#КонецОбласти

&Прозвище("ВитринаПодписок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "ПоляСобытийПодписки") _ПоляСобытий,
	&Пластилин(Значение = "ПоляСвойствПодписки") _ПоляСвойств,
	&Пластилин(Значение = "ОтборТеговПодписки") _ОтборТегов,
	&Пластилин(Значение = "ПоправкиНижестоящих") _Сузившие,
	&Пластилин(Значение = "ДеревоПолучателей") _Получатели,
	&Пластилин(Значение = "ПараметрыПодписки") _ПараметрыПодписки,
	&Пластилин(Значение = "КаталогДействийПодписки") _ТипыДействий,
	&Пластилин(Значение = "ПоляПодписки") _ПоляДействия,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "БланкРаздела") _Бланки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ПроверкаПодпискиДоСохранения") _Проверка,
	&Пластилин(Значение = "СводкаПодписки") _Сводки,
	&Пластилин(Значение = "ПредпросмотрУведомления") _Предпросмотр,
	&Пластилин(Значение = "ПараметрыСсылки") _Ссылки = Неопределено) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	СервисПодписок = _СервисПодписок;
	ПоляСобытий = _ПоляСобытий;
	ПоляСвойств = _ПоляСвойств;
	ОтборТегов = _ОтборТегов;
	Сузившие = _Сузившие;
	Получатели = _Получатели;
	ПараметрыПодписки = _ПараметрыПодписки;
	ТипыДействий = _ТипыДействий;
	ПоляДействия = _ПоляДействия;
	Имена = _Имена;
	Бланки = _Бланки;
	Тексты = _Тексты;
	РазборФормы = _РазборФормы;
	Проверка = _Проверка;
	Сводки = _Сводки;
	Предпросмотр = _Предпросмотр;
	Ссылки = ?(_Ссылки = Неопределено, Новый ПараметрыСсылки(), _Ссылки);

КонецПроцедуры
