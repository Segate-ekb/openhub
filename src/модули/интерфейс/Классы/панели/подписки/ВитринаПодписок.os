// Раздел «Подписки на события» объекта — один на хаб, пул и пакет: реестр подписок с тумблером
// и меню ⚙, окно «Новая подписка» на странице, окна правки и получателей и подтверждение удаления —
// по адресу.
// Дом даёт только объект, адрес раздела и то, что кладёт в секцию после списка.

Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем СервисПодписок; // СервисПодписок (подписки) — подписки объекта
Перем Записи;         // ЗаписьПодписки — запись реестра
Перем Срезы;          // СрезПодписок — что записи спрашивают о подписках, разом на страницу
Перем ОкноПодписки;   // ОкноПодписки — окна раздела
Перем ОкноПолучателей; // ОкноПолучателей — окно «Получатели» подписки хаба и пула
Перем Окна;           // ОкноРаздела — открытое окно по состоянию
Перем Получатели;     // СервисИсключенийПодписок (подписки) — есть ли у подписки дерево получателей
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<ключ>; «сузить» и «пакеты» — окна
// подписки сверху.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат "новая,изменить,удалить,получатели,сузить,пакеты";
КонецФункции

// Секции раздела.
//
// Параметры:
//  Параметры - Структура:
//    * Объект - Структура - описание объекта (СервисПодписок.Объект*);
//    * Адрес - Строка - адрес раздела;
//    * Токен - Строка - CSRF-токен сессии;
//    * Пояснение - Строка - что получает подписчик этого объекта;
//    * МожноМенять - Булево - вправе ли зритель распоряжаться подписками объекта;
//    * Окно - Структура, Неопределено - состояние открытого окна (см. ОкноРаздела.Отбитое);
//    * НовыйСекрет - Строка - секрет подписи, показываемый один раз ("" — нет);
//    * Проба, Предпросмотр - Структура, Неопределено - итог пробы и сообщение предпросмотра,
//      вернувшиеся в открытое окно;
//    * Зритель - Пользователь - кто смотрит: дерево получателей открывается от его имени;
//    * ВидДерева - Структура, Неопределено - что окно «Получатели» показывает: Найти, Ветка, Страница;
//    * АдресТегов - Строка - раздел «Теги» объекта ("" — у хаба);
//    * ПослеСписка - ЭлементЭкрана, Неопределено - что дом кладёт в секцию под реестром.
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - одна секция.
//
Функция Секции(Знач Параметры) Экспорт

	МожноМенять = (Параметры.МожноМенять = Истина);
	Подписки = СервисПодписок.Список(Параметры.Объект);
	ОкноНовой = ?(МожноМенять, ОкноПодписки.Заведение(Параметры), Неопределено);

	Секция = Кит.Секция(Тексты.Текст("subscriptions.section.title"),
			Кит.Примечание(Тексты.Текст("subscriptions.readonly.note")).Когда(НЕ МожноМенять),
			Реестр(Параметры, Подписки),
			Параметры.ПослеСписка,
			ОкноНовой,
			?(МожноМенять, ОткрытоеОкно(Параметры, Подписки), Неопределено),
			ОкноСекрета(Параметры))
		.Лид(Параметры.Пояснение).Иконка("стрелка");
	Если МожноМенять Тогда
		Секция.Действия(Кит.Кнопка(Тексты.Текст("subscriptions.section.add")).Основная().Иконка("плюс")
			.Открывает(ОкноНовой));
	КонецЕсли;

	Результат = Новый Массив();
	Результат.Добавить(Секция);
	Возврат Результат;

КонецФункции

// Напечатает ли раздел окно, которое называет состояние: окно новой подписки — всегда; правка —
// у подписки объекта, чей тип её поддерживает; получатели — у подписки хаба и пула; удаление —
// у подписки объекта.
//
// Параметры:
//  Объект - Структура - описание объекта подписок.
//  Состояние - Структура, Неопределено - состояние окна раздела.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Объект, Знач Состояние) Экспорт
	Возврат Окна.Открыто(Состояние, "новая")
		ИЛИ ОкноПодпискиПоСостоянию(СервисПодписок.Список(Объект), Состояние) <> Неопределено;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Реестр(Знач Параметры, Знач Подписки)

	Реестр = Кит.Реестр().Подпись(Тексты.Текст("subscriptions.section.title"))
		.Пусто(Тексты.Текст("subscriptions.list.empty"));
	Срез = Срезы.Своих(Параметры, Подписки);
	Для Каждого Подписка Из Подписки Цикл
		Реестр.Добавить(Записи.Своя(Параметры, Подписка, Срез));
	КонецЦикла;
	Возврат Реестр;

КонецФункции

// Окно записи, названное адресом. Подписки с таким ключом у объекта нет — окна нет.
Функция ОткрытоеОкно(Знач Параметры, Знач Подписки)

	Окно = ОкноПодпискиПоСостоянию(Подписки, Параметры.Окно);
	Если Окно = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли Окно.Вид = "изменить" Тогда
		Возврат ОкноПодписки.Правка(Параметры, Окно.Подписка);
	ИначеЕсли Окно.Вид = "получатели" Тогда
		Возврат ОкноПолучателей.Окно(Параметры, Окно.Подписка);
	КонецЕсли;
	Возврат ОкноПодписки.Удаление(Параметры, Окно.Подписка);

КонецФункции

// Одно правило, какое окно записи печатается: правка — у подписки объекта, чей тип её
// поддерживает; получатели — у подписки с деревом; удаление — у подписки объекта. Его держат
// и ЕстьОкно, и печать окна.
Функция ОкноПодпискиПоСостоянию(Знач Подписки, Знач Состояние)

	Подписка = ПодпискаИзСписка(Подписки, Состояние);
	Если Подписка = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли Окна.Открыто(Состояние, "изменить") И СервисПодписок.МожноПравить(Подписка) Тогда
		Возврат Новый Структура("Вид, Подписка", "изменить", Подписка);
	ИначеЕсли Окна.Открыто(Состояние, "получатели") И Получатели.ЕстьДерево(Подписка) Тогда
		Возврат Новый Структура("Вид, Подписка", "получатели", Подписка);
	ИначеЕсли Окна.Открыто(Состояние, "удалить") Тогда
		Возврат Новый Структура("Вид, Подписка", "удалить", Подписка);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Секрет подписи — один раз, окном поверх раздела; в адрес он не попадает.
Функция ОкноСекрета(Знач Параметры)

	Секрет = Строка(Параметры.НовыйСекрет);
	Если НЕ ЗначениеЗаполнено(Секрет) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ОкноПодписки.Секрет(Секрет, Параметры.Адрес);

КонецФункции

Функция ПодпискаИзСписка(Знач Подписки, Знач Состояние)

	Если Состояние = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Состояние.Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Подписка Из Подписки Цикл
		Если Формат(Подписка.Идентификатор, "ЧГ=0; ЧН=0") = СокрЛП(Состояние.Ключ) Тогда
			Возврат Подписка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаПодписок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "ЗаписьПодписки") _Записи,
	&Пластилин(Значение = "СрезПодписок") _Срезы,
	&Пластилин(Значение = "ОкноПодписки") _ОкноПодписки,
	&Пластилин(Значение = "ОкноПолучателей") _ОкноПолучателей,
	&Пластилин(Значение = "СервисИсключенийПодписок") _Получатели,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	СервисПодписок = _СервисПодписок;
	Записи = _Записи;
	Срезы = _Срезы;
	ОкноПодписки = _ОкноПодписки;
	ОкноПолучателей = _ОкноПолучателей;
	Получатели = _Получатели;
	Окна = _Окна;
	Тексты = _Тексты;

КонецПроцедуры
