// Число с существительным в нужной по-русски форме: «1 пакет», «3 пакета», «5 пакетов».

Перем Тексты; // ТекстыИнтерфейса (кит) - пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Текст счёта: форма по числу из трёх, записанных через «|».
//
// Параметры:
//  Число - Число - сколько.
//  Формы - Строка - «для 1, 21…|для 2-4, 22-24…|для 0, 5-20…» с %1 на месте числа
//          («%1 пакет|%1 пакета|%1 пакетов»).
//
// Возвращаемое значение:
//  Строка
//
Функция Счет(Знач Число, Знач Формы) Экспорт

	Варианты = СтрРазделить(Формы, "|");
	Номер = ?(Варианты.Количество() < 3, 2, НомерФормы(Число));
	Вариант = Варианты[Мин(Номер, Варианты.ВГраница())];
	Возврат СтрЗаменить(Вариант, "%1", Тексты.ЧислоТекстом(Число));

КонецФункции

#КонецОбласти

// BSLLS:MissingParameterDescription-off
// BSLLS:MissingReturnedValueDescription-off
// 0 - «пакет», 1 - «пакета», 2 - «пакетов».
Функция НомерФормы(Знач Число)

	ДваПоследних = Число % 100;
	Последняя = Число % 10;
	Если ДваПоследних >= 11 И ДваПоследних <= 14 Тогда
		Возврат 2;
	КонецЕсли;
	Если Последняя = 1 Тогда
		Возврат 0;
	КонецЕсли;
	Если Последняя >= 2 И Последняя <= 4 Тогда
		Возврат 1;
	КонецЕсли;
	Возврат 2;

КонецФункции
// BSLLS:MissingParameterDescription-on
// BSLLS:MissingReturnedValueDescription-on

&Прозвище("СчетСловами")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт
	Тексты = _Тексты;
КонецПроцедуры
