// Разбор формы окна подписки в доменный ввод: читаются поля пришедшего типа, поля чужих наборов
// окна уходят со своими умолчаниями и не читаются вовсе. Пустое обязательное поле — отказ под ним.

Перем РазборФормы; // РазборФормы — чтение полей тела запроса
Перем Тексты;      // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Имена;       // ИменаПолейПодписки — имена полей раздела
Перем Каталог;     // КаталогДействийПодписки — типы и их декларации

#Область ПубличныйИнтерфейс

// Разбирает форму окна «Новая подписка» в доменный ввод.
//
// Параметры:
//  Форма - Соответствие - разобранное тело запроса.
//
// Возвращаемое значение:
//  Структура - ТипДействия (Строка), Ввод (Структура — для СервисПодписок.СоздатьПодписку),
//              Отказы (Соответствие — имя поля -> отказ под полем; пустое — ввод годен).
//  Бросает исключение, если тип не назван или каталогу неизвестен.
//
Функция Заведение(Знач Форма) Экспорт

	Описание = ОписаниеИзФормы(Форма);
	Ввод = Новый Структура();
	Отказы = Новый Соответствие();
	Для Каждого ОписаниеПоля Из Описание.Поля Цикл
		Значение = Присланное(Форма, ОписаниеПоля);
		ПроверитьОбязательное(Отказы, ОписаниеПоля, Значение);
		Ввод.Вставить(ОписаниеПоля.Имя, Значение);
	КонецЦикла;

	Возврат Разобранное(Описание, Ввод, Отказы);

КонецФункции

// Разбирает форму окна правки. Секретное поле приезжает парой: само значение и флажок «секрет
// свой» — пустое значение при включённом флажке означает «оставить прежний», выключенный
// флажок — «очистить», и решает это описание хранения типа.
//
// Параметры:
//  Форма - Соответствие - разобранное тело запроса.
//
// Возвращаемое значение:
//  Структура - ТипДействия, Ввод (для СервисПодписок.ОбновитьПодписку), Отказы (см. Заведение).
//
Функция Правка(Знач Форма) Экспорт

	Описание = ОписаниеИзФормы(Форма);
	Ввод = Новый Структура();
	Отказы = Новый Соответствие();
	Для Каждого ОписаниеПоля Из Описание.Поля Цикл
		Значение = Присланное(Форма, ОписаниеПоля);
		Если Каталог.Секретное(ОписаниеПоля) Тогда
			// пустой секрет на правке — «оставить прежний»: обязательность проверена
			// на заведении
			Если Каталог.ЕстьСбросСекрета(ОписаниеПоля) Тогда
				Ввод.Вставить(ОписаниеПоля.Имя + "Свой", РазборФормы.Флажок(Форма,
					Имена.ИмяПоляСвоегоСекрета(ОписаниеПоля.ИмяПоля), Имена.ЗначениеОтмечено()));
			КонецЕсли;
		Иначе
			ПроверитьОбязательное(Отказы, ОписаниеПоля, Значение);
		КонецЕсли;
		Ввод.Вставить(ОписаниеПоля.Имя, Значение);
	КонецЦикла;

	Возврат Разобранное(Описание, Ввод, Отказы);

КонецФункции

// Разбирает форму окна для предпросмотра текста: обязательность полей не проверяется,
// секретные поля в ввод не попадают.
//
// Параметры:
//  Форма - Соответствие - разобранное тело запроса.
//
// Возвращаемое значение:
//  Структура - ТипДействия, Ввод (для ПредпросмотрУведомления.Сообщение), Отказы (всегда пустое).
//
Функция Предпросмотр(Знач Форма) Экспорт

	Описание = ОписаниеИзФормы(Форма);
	Ввод = Новый Структура();
	Для Каждого ОписаниеПоля Из Описание.Поля Цикл
		Если НЕ Каталог.Секретное(ОписаниеПоля) Тогда
			Ввод.Вставить(ОписаниеПоля.Имя, Присланное(Форма, ОписаниеПоля));
		КонецЕсли;
	КонецЦикла;

	Возврат Разобранное(Описание, Ввод, Новый Соответствие());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписаниеИзФормы(Знач Форма)

	Тип = Каталог.КлючТипа(РазборФормы.Поле(Форма, Имена.ИмяПоляТипа()));
	Если НЕ ЗначениеЗаполнено(Тип) Тогда
		ВызватьИсключение Тексты.Текст("subscriptions.form.error.no-type");
	КонецЕсли;

	Описание = Каталог.Описание(Тип);
	Если Описание = Неопределено Тогда
		ВызватьИсключение Тексты.Шаблон("subscriptions.form.error.unknown-type", Тип);
	КонецЕсли;
	Возврат Описание;

КонецФункции

Функция Разобранное(Знач Описание, Знач Ввод, Знач Отказы)
	Возврат Новый Структура("ТипДействия, Ввод, Отказы", Каталог.КлючТипа(Описание.Тип), Ввод, Отказы);
КонецФункции

Функция Присланное(Знач Форма, Знач ОписаниеПоля)
	Возврат СокрЛП(Строка(РазборФормы.Поле(Форма, ОписаниеПоля.ИмяПоля)));
КонецФункции

Процедура ПроверитьОбязательное(Отказы, Знач ОписаниеПоля, Знач Значение)

	Если ОписаниеПоля.Обязательное И НЕ ЗначениеЗаполнено(Значение) Тогда
		Отказы.Вставить(ОписаниеПоля.ИмяПоля, Тексты.Шаблон("subscriptions.form.error.required",
			Тексты.Текст(ОписаниеПоля.КлючПодписи)));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

&Прозвище("РазборФормыПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "КаталогДействийПодписки") _Каталог) Экспорт

	РазборФормы = _РазборФормы;
	Тексты = _Тексты;
	Имена = _Имена;
	Каталог = _Каталог;

КонецПроцедуры
