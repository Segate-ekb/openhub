// Имя подписки на экране: им названа запись списка, окно правки и подтверждение удаления, его же
// набирают в поле подтверждения. У подписки без названия имя — её адрес, у подписки сверху — хозяин.

Перем ПараметрыПодписки; // ПараметрыПодписки (подписки) — название подписки
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Имя своей подписки объекта: название, а без него — адрес доставки.
//
// Параметры:
//  Подписка - Вебхук - подписка объекта.
//
// Возвращаемое значение:
//  Строка.
//
Функция Своей(Знач Подписка) Экспорт

	Название = СокрЛП(Строка(ПараметрыПодписки.Свойства(Подписка).Название));
	Возврат ?(ЗначениеЗаполнено(Название), Название, СокрЛП(Строка(Подписка.URL)));

КонецФункции

// Имя подписки сверху у нижестоящего: название, а без него — «Подписка хаба» или «Подписка пула X»;
// адреса её нижестоящий не видит.
//
// Параметры:
//  Подписка - Вебхук - подписка хаба или пула.
//  ИмяПула - Строка - пул нижестоящего объекта.
//
// Возвращаемое значение:
//  Строка.
//
Функция Сверху(Знач Подписка, Знач ИмяПула) Экспорт

	Название = СокрЛП(Строка(ПараметрыПодписки.Свойства(Подписка).Название));
	Если ЗначениеЗаполнено(Название) Тогда
		Возврат Название;
	КонецЕсли;
	Возврат ?(ОтХаба(Подписка), Тексты.Текст("subscriptions.brief.name.hub"),
		Тексты.Шаблон("subscriptions.brief.name.pool", ИмяПула));

КонецФункции

// Чья подписка сверху — одним словом для строки записи: «подписка хаба», «подписка пула corp».
//
// Параметры:
//  Подписка - Вебхук - подписка хаба или пула.
//  ИмяПула - Строка - пул нижестоящего объекта.
//
// Возвращаемое значение:
//  Строка.
//
Функция Хозяин(Знач Подписка, Знач ИмяПула) Экспорт
	Возврат ?(ОтХаба(Подписка), Тексты.Текст("subscriptions.brief.owner.hub"),
		Тексты.Шаблон("subscriptions.brief.owner.pool", ИмяПула));
КонецФункции

// Ключ подписки в адресе окна и формы: идентификатор без разделителей.
//
// Параметры:
//  Подписка - Вебхук - подписка.
//
// Возвращаемое значение:
//  Строка.
//
Функция Ключ(Знач Подписка) Экспорт
	Возврат Формат(Подписка.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОтХаба(Знач Подписка)
	Возврат НРег(СокрЛП(Строка(Подписка.ТипОбъекта))) = "хаб";
КонецФункции

#КонецОбласти

&Прозвище("ИменаПодписок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПараметрыПодписки") _ПараметрыПодписки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	ПараметрыПодписки = _ПараметрыПодписки;
	Тексты = _Тексты;

КонецПроцедуры
