// Срез раздела подписок: всё, что записи реестра спрашивают у домена о каждой подписке, —
// разом на страницу. Поправки, сводки отметок дерева получателей, пакеты, снятые поправками пулов,
// имена пулов и пакетов, сузивших подписку или названных плашками получателей, — по одному чтению,
// сколько бы подписок ни было в разделе; теги
// объектов отбора читаются один раз на объект (кэш ТегиОбъектов). Запись берёт своё из среза
// по идентификатору подписки и домен сама не спрашивает.

Перем Поправки;     // СервисПоправокПодписок (подписки) — поправки и сводки поправок разом
Перем Исключения;   // СервисИсключенийПодписок (подписки) — сводки исключений разом
Перем СервисПулов;  // СервисПулов (реестр) — имена пулов, сузивших подписку
Перем СервисПакетов; // СервисПакетов (реестр) — имена пакетов, сузивших подписку
Перем Получатели;   // ПолучателиЗаписи — какие отметки запись называет плашками

#Область ПубличныйИнтерфейс

// Срез своих подписок объекта.
//
// Параметры:
//  Параметры - Структура - параметры ВитриныПодписок: Объект, Зритель, МожноМенять.
//  Подписки - Массив из Вебхук - подписки объекта.
//
// Возвращаемое значение:
//  Структура - срез:
//    * Поправки - Соответствие - идентификатор подписки -> Массив из ПоправкаПодписки;
//    * Исключено - Соответствие, Неопределено - идентификатор подписки -> сводка отметок дерева
//                  (СервисИсключенийПодписок.СводкиИсключений); Неопределено — зритель не вправе
//                  менять, сводки «кому сообщает» нет;
//    * ИсключённыеПакеты - Соответствие - поправка -> Массив из Число;
//    * Пулы - Соответствие - идентификатор пула -> пул (сузившие и названные плашками получателей);
//    * Пакеты - Соответствие - идентификатор пакета -> пакет (так же);
//    * ТегиОбъектов - Соответствие - теги объектов отбора, прочитанные на этой странице;
//    * Сводки - Неопределено - у своих подписок сводок поправки нет.
//
Функция Своих(Знач Параметры, Знач Подписки) Экспорт

	Срез = Пустой();
	Сужаемые = Новый Массив();
	Для Каждого Подписка Из Подписки Цикл
		Если НРег(СокрЛП(Строка(Подписка.ТипОбъекта))) <> "пакет" Тогда
			Сужаемые.Добавить(Подписка);
		КонецЕсли;
	КонецЦикла;

	Срез.Поправки = ?(Сужаемые.Количество() = 0, Новый Соответствие(), Поправки.ПоправкиПодписок(Сужаемые));
	Если Параметры.МожноМенять = Истина Тогда
		Срез.Исключено = Исключения.СводкиИсключений(Параметры.Зритель, Параметры.Объект, Подписки);
	КонецЕсли;

	Все = Новый Массив();
	Для Каждого КиЗ Из Срез.Поправки Цикл
		Для Каждого Поправка Из КиЗ.Значение Цикл
			Все.Добавить(Поправка);
		КонецЦикла;
	КонецЦикла;
	Если Все.Количество() > 0 Тогда
		Срез.ИсключённыеПакеты = Поправки.ИсключённыеПакетыПоправок(Все);
	КонецЕсли;
	ПрочитатьИмена(Срез, Все);
	Возврат Срез;

КонецФункции

// Срез подписок сверху у нижестоящего объекта.
//
// Параметры:
//  Параметры - Структура - параметры ВитриныПодписокСверху: Объект, Зритель, МожноМенять.
//  Подписки - Массив из Вебхук - подписки сверху (СервисПоправокПодписок.ПодпискиСверху).
//
// Возвращаемое значение:
//  Структура - срез (см. Своих), где Поправки — идентификатор подписки -> ПоправкаПодписки объекта
//  (несуженной нет), а Сводки — идентификатор подписки хаба -> Структура (СнялПул, СнялХозяин)
//  у пула, который вправе менять; иначе пустое.
//
Функция Сверху(Знач Параметры, Знач Подписки) Экспорт

	Срез = Пустой();
	Срез.Поправки = Поправки.ПоправкиОбъекта(Параметры.Объект);
	Все = Новый Массив();
	Для Каждого КиЗ Из Срез.Поправки Цикл
		Все.Добавить(КиЗ.Значение);
	КонецЦикла;
	Если Все.Количество() > 0 Тогда
		Срез.ИсключённыеПакеты = Поправки.ИсключённыеПакетыПоправок(Все);
	КонецЕсли;
	Если Параметры.МожноМенять = Истина Тогда
		Срез.Сводки = Поправки.СводкиПоправок(Параметры.Зритель, Параметры.Объект, Подписки);
	КонецЕсли;
	Возврат Срез;

КонецФункции

// Поправки своей подписки в срезе.
//
// Параметры:
//  Срез - Структура - срез (см. Своих).
//  Подписка - Вебхук - подписка.
//
// Возвращаемое значение:
//  Массив из ПоправкаПодписки - у подписки пакета и несуженной пустой.
//
Функция ПоправкиПодписки(Знач Срез, Знач Подписка) Экспорт
	Найденные = Срез.Поправки.Получить(Цел(Подписка.Идентификатор));
	Возврат ?(Найденные = Неопределено, Новый Массив(), Найденные);
КонецФункции

// Поправка объекта к подписке сверху в срезе.
//
// Параметры:
//  Срез - Структура - срез (см. Сверху).
//  Подписка - Вебхук - подписка сверху.
//
// Возвращаемое значение:
//  ПоправкаПодписки, Неопределено - Неопределено, если объект подписку не сужал.
//
Функция ПоправкаОбъекта(Знач Срез, Знач Подписка) Экспорт
	Возврат Срез.Поправки.Получить(Цел(Подписка.Идентификатор));
КонецФункции

// Сколько пакетов исключила поправка пула.
//
// Параметры:
//  Срез - Структура - срез.
//  Поправка - ПоправкаПодписки - поправка из этого же среза.
//
// Возвращаемое значение:
//  Число.
//
Функция ИсключеноПакетов(Знач Срез, Знач Поправка) Экспорт
	Пакеты = Срез.ИсключённыеПакеты.Получить(Поправка);
	Возврат ?(Пакеты = Неопределено, 0, Пакеты.Количество());
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Пустой()
	Возврат Новый Структура("Поправки, Исключено, ИсключённыеПакеты, Пулы, Пакеты, ТегиОбъектов, Сводки",
		Новый Соответствие(), Неопределено, Новый Соответствие(), Новый Соответствие(), Новый Соответствие(),
		Новый Соответствие(), Неопределено);
КонецФункции

// Имена пулов и пакетов, сузивших подписки и названных плашками получателей, — по чтению на род.
Процедура ПрочитатьИмена(Срез, Знач Все)

	ИдПулов = Новый Массив();
	ИдПакетов = Новый Массив();
	Для Каждого Поправка Из Все Цикл
		Добавить(ИдПулов, Поправка.ПулИдентификатор);
		Если НРег(СокрЛП(Строка(Поправка.ТипОбъекта))) = "пакет" Тогда
			Добавить(ИдПакетов, Поправка.ОбъектИдентификатор);
		КонецЕсли;
	КонецЦикла;
	Если Срез.Исключено <> Неопределено Тогда
		Для Каждого КиЗ Из Срез.Исключено Цикл
			Для Каждого Узел Из Получатели.НазываемыеОтметки(КиЗ.Значение) Цикл
				Добавить(ИдПулов, Узел.ПулИдентификатор);
				Если Узел.ПакетИдентификатор <> 0 Тогда
					Добавить(ИдПакетов, Узел.ПакетИдентификатор);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Если ИдПулов.Количество() > 0 Тогда
		Срез.Пулы = СервисПулов.ПулыПоИдентификаторам(ИдПулов);
	КонецЕсли;
	Если ИдПакетов.Количество() > 0 Тогда
		Для Каждого Пакет Из СервисПакетов.ПакетыПоИдентификаторам(ИдПакетов) Цикл
			Срез.Пакеты.Вставить(Цел(Пакет.Идентификатор), Пакет);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура Добавить(Перечень, Знач Идентификатор)
	Если Перечень.Найти(Цел(Идентификатор)) = Неопределено Тогда
		Перечень.Добавить(Цел(Идентификатор));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

&Прозвище("СрезПодписок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПоправокПодписок") _Поправки,
	&Пластилин(Значение = "СервисИсключенийПодписок") _Исключения,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "ПолучателиЗаписи") _Получатели) Экспорт

	Получатели = _Получатели;
	Поправки = _Поправки;
	Исключения = _Исключения;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;

КонецПроцедуры
