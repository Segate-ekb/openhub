// Проверка подписки до сохранения: предпросмотр уведомления у поля текста и пробная отправка
// настройками окна. Скрипт страницы берёт их по data-признакам и вставляет ответ без перезагрузки;
// без скрипта обе кнопки шлют форму окна на свой адрес, и страница возвращает окно открытым с итогом.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Имена;             // ИменаПолейПодписки — параметр адреса ответа кусочком
Перем ТипыДействий;      // КаталогДействийПодписки — секретные поля типа
Перем Предпросмотр;      // ПредпросмотрУведомления (подписки) — есть ли у типа текст до сохранения
Перем Реестр;            // РеестрДействийПодписок (подписки) — умеет ли тип пробную отправку
Перем Ссылки;            // ПараметрыСсылки (основа) — параметр запроса на адресе
Перем Адреса;            // РазборАдреса (основа) — узел адреса карточки ссылки

#Область ОкноПодписки

// Место предпросмотра у поля текста: скрипт показывает в нём сообщение по вводу окна и обновляет
// его по мере набора. Без скрипта место показано, только когда сервер сам собрал сообщение
// (кнопкой предпросмотра); иначе за ним ходит кнопка.
//
// Параметры:
//  Адрес - Строка - адрес предпросмотра формы (…/webhooks/preview, …/webhooks/{id}/preview).
//  Тип - Строка - тип действия формы.
//  Исход - Структура, Неопределено - собранное сервером сообщение (см. ОтветПредпросмотра);
//          Неопределено — место ждёт скрипта (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  ЭлементЭкрана, Неопределено - место; у типа без предпросмотра — Неопределено.
//
Функция МестоПредпросмотра(Знач Адрес, Знач Тип, Знач Исход = Неопределено) Экспорт

	Если НЕ Предпросмотр.Поддержан(Тип) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Место = Кит.Область(
			Кит.Надпись(Тексты.Текст("subscriptions.preview.title")).Вид("приглушённая"),
			Кит.Область(?(Исход = Неопределено, Неопределено, ОтветПредпросмотра(Исход)))
				.Признак("sub-preview-target", "").Роль("состояние"))
		.Признак("sub-preview", АдресКусочком(Адрес))
		.Признак("sub-omit", СекретныеПоля(Тип))
		.Признак("sub-failed", Тексты.Текст("subscriptions.live.failed"));
	Если Исход = Неопределено Тогда
		Место.Скрыть();
	КонецЕсли;
	Возврат Место;

КонецФункции

// Кнопка предпросмотра без скрипта: шлёт форму окна на адрес предпросмотра, и страница возвращает
// окно открытым с сообщением у поля. Скрипт её прячет — сообщение у него на лету.
//
// Параметры:
//  Адрес - Строка - адрес предпросмотра формы.
//  Тип - Строка - тип действия формы.
//
// Возвращаемое значение:
//  ЭлементЭкрана, Неопределено - кнопка; у типа без предпросмотра — Неопределено.
//
Функция КнопкаПредпросмотра(Знач Адрес, Знач Тип) Экспорт

	Если НЕ Предпросмотр.Поддержан(Тип) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Надпись(
			Кит.Кнопка(Тексты.Текст("subscriptions.button.preview")).Вторичная().Малая()
				.АдресОтправки(Адрес).БезВалидации())
		.Признак("sub-preview-button", "");

КонецФункции

// Кнопка пробной отправки настройками окна, ещё не сохранёнными, и место её итога. Скрипт
// показывает итог у кнопки; без скрипта форма уходит на адрес пробы, и итог приходит в окне.
//
// Параметры:
//  Адрес - Строка - адрес пробы формы (…/webhooks/test, …/webhooks/{id}/test).
//
// Возвращаемое значение:
//  ЭлементЭкрана - кнопка с местом итога.
//
Функция КнопкаПробы(Знач Адрес) Экспорт

	Возврат Кит.Надпись(
			Кит.Кнопка(Тексты.Текст("subscriptions.button.test")).Вторичная().Иконка("конверт")
				.АдресОтправки(Адрес),
			Кит.Надпись().Признак("sub-trial-result", "").Роль("состояние"))
		.Признак("sub-trial", АдресКусочком(Адрес))
		.Признак("sub-busy", Тексты.Текст("subscriptions.trial.busy"))
		.Признак("sub-failed", Тексты.Текст("subscriptions.live.failed"));

КонецФункции

// Умеет ли тип пробную отправку: у правимой подписки кнопка пробы есть только тогда.
//
// Параметры:
//  Тип - Строка - тип действия.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПробаПоддержана(Знач Тип) Экспорт
	Возврат Реестр.ПробаПоддержана(Тип);
КонецФункции

// Итог пробы в окне, вернувшемся без скрипта: дошла ли проба и что ответила цель, либо почему
// хаб её не отправил.
//
// Параметры:
//  Исход - Структура - исход пробы (ПультПодписок.Проба).
//
// Возвращаемое значение:
//  ЭлементЭкрана - уведомление.
//
Функция ИтогПробы(Знач Исход) Экспорт

	Если НЕ Исход.Успех Тогда
		Возврат Кит.Уведомление(Исход.Сообщение).Вид("err");
	ИначеЕсли Исход.ВидСообщения = "ok" Тогда
		Возврат Кит.Уведомление(Тексты.Шаблон("subscriptions.trial.ok", Исход.Сообщение)).Вид("ok");
	КонецЕсли;
	Возврат Кит.Уведомление(Тексты.Шаблон("subscriptions.trial.failed", Исход.Сообщение)).Вид("err");

КонецФункции

#КонецОбласти

#Область ОтветыПроверки

// Сообщение предпросмотра так, как его покажет Telegram: простой текст с переносами строк
// и под ним карточка ссылки; отклонённый шаблон — причина с перечнем допустимых имён.
//
// Параметры:
//  Исход - Структура - Текст (Строка), АдресПревью (Строка), Ошибка (Строка; заполнена — отказ).
//
// Возвращаемое значение:
//  ЭлементЭкрана - ответ, который скрипт вставляет в место предпросмотра.
//
Функция ОтветПредпросмотра(Знач Исход) Экспорт

	Если ЗначениеЗаполнено(Исход.Ошибка) Тогда
		Возврат Отказ(Исход.Ошибка);
	КонецЕсли;

	Возврат Кит.Область(
			Кит.Область(
					Кит.Надпись(Кит.Текст(Исход.Текст)).Признак("sub-text", ""),
					КарточкаСсылки(Исход.АдресПревью))
				.Признак("sub-bubble", ""),
			Кит.Примечание(Тексты.Текст("subscriptions.preview.sample")))
		.Признак("sub-result", "ok");

КонецФункции

// Итог пробной отправки одной строкой: дошла ли проба и что ответила цель, либо почему хаб
// её не отправил.
//
// Параметры:
//  Исход - Структура - исход пробы (ПультПодписок.Проба).
//
// Возвращаемое значение:
//  ЭлементЭкрана - ответ, который скрипт вставляет у кнопки пробы.
//
Функция ОтветПробы(Знач Исход) Экспорт

	Если НЕ Исход.Успех Тогда
		Возврат Отказ(Исход.Сообщение);
	ИначеЕсли Исход.ВидСообщения = "ok" Тогда
		Возврат Кит.Надпись(Кит.Текст(Тексты.Шаблон("subscriptions.trial.ok", Исход.Сообщение))).Признак("sub-result", "ok");
	КонецЕсли;
	Возврат Кит.Надпись(Кит.Текст(Тексты.Шаблон("subscriptions.trial.failed", Исход.Сообщение))).Признак("sub-result", "err");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Отказ(Знач Причина)
	Возврат Кит.Надпись(Кит.Текст(Причина)).Признак("sub-result", "err");
КонецФункции

// Карточку Telegram строит по og:* страницы сам, сетью; здесь — то, что известно без сети:
// узел и адрес. Без адреса сообщение уходит без карточки — и здесь её нет.
Функция КарточкаСсылки(Знач Адрес)

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Область(
			Кит.Надпись(Кит.Текст(Адреса.СхемаИУзел(Адрес).Хост)).Вид("название"),
			Кит.Ссылка(Адрес, Адрес))
		.Признак("sub-card", "");

КонецФункции

// Адрес действия, который отвечает кусочком для скрипта, а не страницей.
Функция АдресКусочком(Знач Адрес)
	Возврат Ссылки.Установить(Адрес, Имена.ИмяПараметраКусочка(), "1");
КонецФункции

// Секреты в предпросмотр не уходят: скрипт пропускает эти поля, сервер их и не читает.
Функция СекретныеПоля(Знач Тип)

	Секретные = Новый Массив();
	Для Каждого ОписаниеПоля Из ТипыДействий.ПоляТипа(Тип) Цикл
		Если ТипыДействий.Секретное(ОписаниеПоля) Тогда
			Секретные.Добавить(ОписаниеПоля.ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Секретные, " ");

КонецФункции

#КонецОбласти

&Прозвище("ПроверкаПодпискиДоСохранения")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "КаталогДействийПодписки") _ТипыДействий,
	&Пластилин(Значение = "ПредпросмотрУведомления") _Предпросмотр,
	&Пластилин(Значение = "РеестрДействийПодписок") _Реестр,
	&Пластилин(Значение = "ПараметрыСсылки") _Ссылки = Неопределено,
	&Пластилин(Значение = "РазборАдреса") _Адреса = Неопределено) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	Имена = _Имена;
	ТипыДействий = _ТипыДействий;
	Предпросмотр = _Предпросмотр;
	Реестр = _Реестр;
	Ссылки = ?(_Ссылки = Неопределено, Новый ПараметрыСсылки(), _Ссылки);
	Адреса = ?(_Адреса = Неопределено, Новый РазборАдреса(), _Адреса);

КонецПроцедуры
