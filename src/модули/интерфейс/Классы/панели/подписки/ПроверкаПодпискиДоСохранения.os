// Проверка подписки до сохранения: предпросмотр уведомления рядом с полем шаблона и пробная
// отправка настройками формы. Скрипт страницы берёт их по data-признакам и вставляет ответ
// без перезагрузки; без скрипта обе кнопки шлют форму обычной отправкой в новую вкладку.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции страницы предпросмотра
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Бланки;            // БланкРаздела — адреса действий формы
Перем Имена;             // ИменаПолейПодписки — параметр адреса ответа кусочком
Перем ТипыДействий;      // КаталогДействийПодписки — секретные поля типа
Перем Предпросмотр;      // ПредпросмотрУведомления (подписки) — есть ли у типа текст до сохранения
Перем Реестр;            // РеестрДействийПодписок (подписки) — умеет ли тип пробную отправку
Перем Ссылки;            // ПараметрыСсылки (основа) — параметр запроса на адресе
Перем Адреса;            // РазборАдреса (основа) — узел адреса карточки ссылки

#Область ФормаПодписки

// Место предпросмотра рядом с полем шаблона: скрипт показывает в нём сообщение по вводу формы
// и обновляет его по мере набора. Без скрипта место скрыто — за предпросмотром ходит кнопка.
//
// Параметры:
//  Бланк - Структура - бланк формы (заведения или правки подписки).
//  Тип - Строка - тип действия формы.
//
// Возвращаемое значение:
//  ЭлементЭкрана - место; у типа без предпросмотра — пусто.
//
Функция МестоПредпросмотра(Знач Бланк, Знач Тип) Экспорт

	Если НЕ Предпросмотр.Поддержан(Тип) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Место = Кит.Область()
		.Признак("sub-preview", АдресКусочком(Бланк, "preview"))
		.Признак("sub-omit", СекретныеПоля(Тип))
		.Признак("sub-failed", Тексты.Текст("subscriptions.live.failed"))
		.Скрыть();
	Место.Добавить(Кит.Надпись("приглушённая")).Добавить(Кит.Текст(Тексты.Текст("subscriptions.preview.title")));
	Место.Добавить(Кит.Область().Признак("sub-preview-target", "").Роль("состояние"));
	Возврат Место;

КонецФункции

// Кнопка предпросмотра без скрипта: шлёт ту же форму на свой адрес и открывает ответ в новой
// вкладке — форма с введённым, включая токен, остаётся на своей странице. Скрипт её прячет.
//
// Параметры:
//  Бланк - Структура - бланк формы.
//  Тип - Строка - тип действия формы.
//
// Возвращаемое значение:
//  ЭлементЭкрана - кнопка; у типа без предпросмотра — пусто.
//
Функция КнопкаПредпросмотра(Знач Бланк, Знач Тип) Экспорт

	Если НЕ Предпросмотр.Поддержан(Тип) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	БезСкрипта = Кит.Надпись().Признак("sub-preview-button", "");
	БезСкрипта.Добавить(Кит.Кнопка(Новый Структура(
		"Подпись, Вариант, Размер, АдресОтправки, ВНовойВкладке, БезВалидации",
		Тексты.Текст("subscriptions.button.preview"), "вторичная", "обычный",
		Бланки.Адрес(Бланк, "preview"), Истина, Истина)));
	Возврат БезСкрипта;

КонецФункции

// Кнопка пробной отправки настройками формы, ещё не сохранёнными, и место её итога. Скрипт
// показывает итог у кнопки; без скрипта форма уходит в новую вкладку, и итог там — уведомлением.
//
// Параметры:
//  Бланк - Структура - бланк формы (заведения или правки подписки).
//  Тип - Строка - тип действия формы.
//
// Возвращаемое значение:
//  ЭлементЭкрана - кнопка с местом итога; у типа без пробы — пусто.
//
Функция КнопкаПробы(Знач Бланк, Знач Тип) Экспорт

	Если НЕ Реестр.ПробаПоддержана(Тип) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Проба = Кит.Надпись()
		.Признак("sub-trial", АдресКусочком(Бланк, "test"))
		.Признак("sub-busy", Тексты.Текст("subscriptions.trial.busy"))
		.Признак("sub-failed", Тексты.Текст("subscriptions.live.failed"));
	Проба.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер, АдресОтправки, ВНовойВкладке",
		Тексты.Текст("subscriptions.button.test"), "вторичная", "обычный",
		Бланки.Адрес(Бланк, "test"), Истина)));
	Проба.Добавить(Кит.Надпись().Признак("sub-trial-result", "").Роль("состояние"));
	Возврат Проба;

КонецФункции

#КонецОбласти

#Область ОтветыПроверки

// Сообщение предпросмотра так, как его покажет Telegram: простой текст с переносами строк
// и под ним карточка ссылки; отклонённый шаблон — причина с перечнем допустимых имён.
//
// Параметры:
//  Исход - Структура - Текст (Строка), АдресПревью (Строка), Ошибка (Строка; заполнена — отказ).
//
// Возвращаемое значение:
//  ЭлементЭкрана - ответ, который скрипт вставляет в место предпросмотра.
//
Функция ОтветПредпросмотра(Знач Исход) Экспорт

	Если ЗначениеЗаполнено(Исход.Ошибка) Тогда
		Возврат Отказ(Исход.Ошибка);
	КонецЕсли;

	Ответ = Кит.Область().Признак("sub-result", "ok");
	Пузырь = Ответ.Добавить(Кит.Область().Признак("sub-bubble", ""));
	Пузырь.Добавить(Кит.Надпись().Признак("sub-text", "")).Добавить(Кит.Текст(Исход.Текст));
	Пузырь.Добавить(КарточкаСсылки(Исход.АдресПревью));
	Ответ.Добавить(Кит.Примечание(Тексты.Текст("subscriptions.preview.sample")));
	Возврат Ответ;

КонецФункции

// Итог пробной отправки одной строкой: дошла ли проба и что ответила цель, либо почему хаб
// её не отправил.
//
// Параметры:
//  Исход - Структура - Успех (Булево; Ложь — проба не отправлена), Ошибка (Строка),
//          Сообщение (Строка — ответ цели) и ВидСообщения («ok» | «err»).
//
// Возвращаемое значение:
//  ЭлементЭкрана - ответ, который скрипт вставляет у кнопки пробы.
//
Функция ОтветПробы(Знач Исход) Экспорт

	Если НЕ Исход.Успех Тогда
		Возврат Отказ(Исход.Ошибка);
	КонецЕсли;

	Если Исход.ВидСообщения = "ok" Тогда
		Ответ = Кит.Надпись().Признак("sub-result", "ok");
		Ответ.Добавить(Кит.Текст(Тексты.Шаблон("subscriptions.trial.ok", Исход.Сообщение)));
	Иначе
		Ответ = Кит.Надпись().Признак("sub-result", "err");
		Ответ.Добавить(Кит.Текст(Тексты.Шаблон("subscriptions.trial.failed", Исход.Сообщение)));
	КонецЕсли;
	Возврат Ответ;

КонецФункции

// Страница предпросмотра без скрипта: то же сообщение, что в форме, и куда вернуться.
//
// Параметры:
//  Исход - Структура - как у ОтветПредпросмотра.
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция СекцииПредпросмотра(Знач Исход) Экспорт

	Содержимое = Кит.Холст();
	Содержимое.Добавить(ОтветПредпросмотра(Исход));
	Если ЗначениеЗаполнено(Исход.Ошибка) Тогда
		Содержимое.Добавить(Кит.Примечание(Тексты.Текст("subscriptions.preview.rejected")));
	Иначе
		Содержимое.Добавить(Кит.Примечание(Тексты.Текст("subscriptions.preview.note")));
	КонецЕсли;

	Секция = РендерерНастроек.Секция(Тексты.Текст("subscriptions.preview.title"), "", Содержимое.Рендер());
	Секция.Иконка = "стрелка";

	Результат = Новый Массив();
	Результат.Добавить(Секция);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Отказ(Знач Причина)
	Ответ = Кит.Надпись().Признак("sub-result", "err");
	Ответ.Добавить(Кит.Текст(Причина));
	Возврат Ответ;
КонецФункции

// Карточку Telegram строит по og:* страницы сам, сетью; здесь — то, что известно без сети:
// узел и адрес. Без адреса сообщение уходит без карточки — и здесь её нет.
Функция КарточкаСсылки(Знач Адрес)

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Карточка = Кит.Область().Признак("sub-card", "");
	Карточка.Добавить(Кит.Надпись("название")).Добавить(Кит.Текст(Адреса.СхемаИУзел(Адрес).Хост));
	Карточка.Добавить(Кит.Ссылка(Адрес)).Добавить(Кит.Текст(Адрес));
	Возврат Карточка;

КонецФункции

// Адрес действия, который отвечает кусочком для скрипта, а не страницей.
Функция АдресКусочком(Знач Бланк, Знач Действие)
	Возврат Ссылки.Установить(Бланки.Адрес(Бланк, Действие), Имена.ИмяПараметраКусочка(), "1");
КонецФункции

// Секреты в предпросмотр не уходят: скрипт пропускает эти поля, сервер их и не читает.
Функция СекретныеПоля(Знач Тип)

	Секретные = Новый Массив();
	Для Каждого ОписаниеПоля Из ТипыДействий.ПоляТипа(Тип) Цикл
		Если ТипыДействий.Секретное(ОписаниеПоля) Тогда
			Секретные.Добавить(ОписаниеПоля.ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Секретные, " ");

КонецФункции

#КонецОбласти

&Прозвище("ПроверкаПодпискиДоСохранения")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "БланкРаздела") _Бланки,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "КаталогДействийПодписки") _ТипыДействий,
	&Пластилин(Значение = "ПредпросмотрУведомления") _Предпросмотр,
	&Пластилин(Значение = "РеестрДействийПодписок") _Реестр,
	&Пластилин(Значение = "ПараметрыСсылки") _Ссылки = Неопределено,
	&Пластилин(Значение = "РазборАдреса") _Адреса = Неопределено) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Тексты = _Тексты;
	Бланки = _Бланки;
	Имена = _Имена;
	ТипыДействий = _ТипыДействий;
	Предпросмотр = _Предпросмотр;
	Реестр = _Реестр;
	Ссылки = ?(_Ссылки = Неопределено, Новый ПараметрыСсылки(), _Ссылки);
	Адреса = ?(_Адреса = Неопределено, Новый РазборАдреса(), _Адреса);

КонецПроцедуры
