// Сводка карточки подписки — своей и сверху: название первым, состояние знаком у него,
// хозяин и способ доставки подписью, события, теги, получатели и сужение — подписанными строками.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем СервисПодписок;    // СервисПодписок (подписки) — тип действия подписки
Перем ПараметрыПодписки; // ПараметрыПодписки (подписки) — название, отбор и разрешение сужать
Перем Поправки;          // СервисПоправокПодписок (подписки) — поправки снизу и оставленные события
Перем ТипыДействий;      // КаталогДействийПодписки — подпись способа доставки
Перем ПоляСобытий;       // ПоляСобытийПодписки — подписи событий
Перем ОтборТегов;        // ОтборТеговПодписки — действующий отбор и выпавшие теги
Перем Получатели;        // ДеревоПолучателей — кому подписка сообщает
Перем Счёт;              // СчётСловами — число с существительным
Перем ЧерезЗапятую;      // СписокЧерезЗапятую (основа)

#Область ПубличныйИнтерфейс

// Сводка своей подписки объекта.
//
// Параметры:
//  Параметры - Структура - параметры ВитриныПодписок: Объект, Зритель, МожноМенять.
//  Подписка - Вебхук - подписка объекта.
//
// Возвращаемое значение:
//  ЭлементЭкрана - сводка для свёрнутой строки карточки.
//
Функция Своя(Знач Параметры, Знач Подписка) Экспорт

	Свойства = ПараметрыПодписки.Свойства(Подписка);
	Названа = ЗначениеЗаполнено(Свойства.Название);
	Сузили = ?(НРег(Подписка.ТипОбъекта) = "пакет", 0, Поправки.ПоправкиПодписки(Подписка).Количество());

	Сведения = СведенияПодписки(Подписка, Свойства.ОтборТегов);
	Если Параметры.МожноМенять = Истина Тогда
		Сведение(Сведения, Тексты.Текст("subscriptions.brief.recipients"), Получатели.КомуСообщает(Параметры, Подписка));
	КонецЕсли;
	Сведение(Сведения, Тексты.Текст("subscriptions.brief.below"), СужениеСнизу(Подписка, Свойства.СужениеРазрешено, Сузили));

	Возврат Кит.Сводка(Новый Структура("Название, Знаки, Подпись, Сведения",
		?(Названа, Свойства.Название, Строка(Подписка.URL)),
		ЗнакиСвоей(Подписка, Свойства.СужениеРазрешено, Сузили),
		ПодписьСвоей(Подписка, Названа),
		Сведения));

КонецФункции

// Сводка подписки сверху у нижестоящего объекта: адреса и секретов в ней нет.
//
// Параметры:
//  Подписка - Вебхук - подписка хаба или пула.
//  Поправка - ПоправкаПодписки, Неопределено - поправка объекта; Неопределено — не сужал.
//  ИмяПула - Строка - пул объекта: им называется подписка пула.
//
// Возвращаемое значение:
//  ЭлементЭкрана - сводка для свёрнутой строки карточки.
//
Функция Сверху(Знач Подписка, Знач Поправка, Знач ИмяПула) Экспорт

	Свойства = ПараметрыПодписки.Свойства(Подписка);
	Хозяин = Хозяин(Подписка, ИмяПула);
	Названа = ЗначениеЗаполнено(Свойства.Название);

	Подпись = Новый Массив();
	Подпись.Добавить(?(Названа, Хозяин, ""));
	Подпись.Добавить(ТипыДействий.ПодписьТипа(СервисПодписок.ТипДействияПодписки(Подписка)));

	Сведения = СведенияПодписки(Подписка, Свойства.ОтборТегов);
	ДобавитьПоправку(Сведения, Подписка, Поправка);

	Возврат Кит.Сводка(Новый Структура("Название, Знаки, Подпись, Сведения",
		?(Названа, Свойства.Название, НазваниеПоХозяину(Подписка, ИмяПула)),
		ЗнакиСверху(Подписка, Поправка),
		Подпись,
		Сведения));

КонецФункции

#КонецОбласти

#Область Своя

// Выключена — знак; поправки снизу есть, а сужение запрещено — тоже: они хранятся, но не действуют.
Функция ЗнакиСвоей(Знач Подписка, Знач СужениеРазрешено, Знач Сузили)

	Знаки = Новый Массив();
	Если Подписка.Активен <> Истина Тогда
		Знаки.Добавить(Знак(Тексты.Текст("subscriptions.state.off")));
	КонецЕсли;
	Если Сузили > 0 И НЕ СужениеРазрешено Тогда
		Знаки.Добавить(Знак(Тексты.Текст("subscriptions.brief.sign.dormant")));
	КонецЕсли;
	Возврат Знаки;

КонецФункции

// Способ доставки, адрес (если карточку назвало название) и признаки своего бота и текста.
Функция ПодписьСвоей(Знач Подписка, Знач Названа)

	Подпись = Новый Массив();
	Подпись.Добавить(ТипыДействий.ПодписьТипа(СервисПодписок.ТипДействияПодписки(Подписка)));
	Если Названа Тогда
		Подпись.Добавить(Строка(Подписка.URL));
	КонецЕсли;
	Если ЗначениеЗаполнено(Строка(Подписка.ТокенДействия)) Тогда
		Подпись.Добавить(Тексты.Текст("subscriptions.list.tag.own-bot"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Строка(Подписка.ШаблонТекста)) Тогда
		Подпись.Добавить(Тексты.Текст("subscriptions.list.tag.own-text"));
	КонецЕсли;
	Возврат Подпись;

КонецФункции

// Сужение снизу одной строкой: можно ли и сколько объектов сузили; без разрешения и поправок — пусто.
Функция СужениеСнизу(Знач Подписка, Знач Разрешено, Знач Сузили)

	Если НРег(Подписка.ТипОбъекта) = "пакет" ИЛИ (Сузили = 0 И НЕ Разрешено) Тогда
		Возврат "";
	ИначеЕсли Сузили = 0 Тогда
		Возврат Тексты.Текст("subscriptions.brief.below.allowed");
	КонецЕсли;
	Возврат Тексты.Шаблон("subscriptions.brief.below.narrowed", Счёт.Счёт(Сузили, Тексты.Текст("subscriptions.count.objects")));

КонецФункции

#КонецОбласти

#Область Сверху

// Подписку без названия зовут по хозяину — заголовком карточки.
Функция НазваниеПоХозяину(Знач Подписка, Знач ИмяПула)
	Возврат ?(НРег(Подписка.ТипОбъекта) = "хаб", Тексты.Текст("subscriptions.brief.name.hub"),
		Тексты.Шаблон("subscriptions.brief.name.pool", ИмяПула));
КонецФункции

Функция Хозяин(Знач Подписка, Знач ИмяПула)
	Возврат ?(НРег(Подписка.ТипОбъекта) = "хаб", Тексты.Текст("subscriptions.brief.owner.hub"),
		Тексты.Шаблон("subscriptions.brief.owner.pool", ИмяПула));
КонецФункции

Функция ЗнакиСверху(Знач Подписка, Знач Поправка)

	Знаки = Новый Массив();
	Если Подписка.Активен <> Истина Тогда
		Знаки.Добавить(Знак(Тексты.Текст("subscriptions.state.off")));
	КонецЕсли;
	Если Поправка = Неопределено Тогда
		Возврат Знаки;
	КонецЕсли;
	Знаки.Добавить(Знак(?(Поправка.НеПрисылать = Истина,
		Тексты.Текст("subscriptions.above.state.muted"), Тексты.Текст("subscriptions.above.state.narrowed"))));
	Возврат Знаки;

КонецФункции

// Что поправка оставила объекту: события, если сняты не все, свой отбор по тегам и у пула —
// сколько своих пакетов он снял.
Процедура ДобавитьПоправку(Знач Сведения, Знач Подписка, Знач Поправка)

	Если Поправка = Неопределено ИЛИ Поправка.НеПрисылать = Истина Тогда
		Возврат;
	КонецЕсли;

	Части = Новый Массив();
	Оставленные = Поправки.ОставленныеСобытия(Подписка, Поправка);
	Если Оставленные.Количество() < ЧерезЗапятую.Разобрать(Подписка.ТипыСобытий).Количество() Тогда
		Части.Добавить(Тексты.Шаблон("subscriptions.brief.here.events", СобытияВКавычках(Оставленные)));
	КонецЕсли;
	Теги = ОтборТегов.Отбор(Поправка, Поправка.ОтборТегов).Действующие;
	Если ЗначениеЗаполнено(Теги) Тогда
		Части.Добавить(Тексты.Шаблон("subscriptions.brief.here.tags", Теги));
	КонецЕсли;
	Исключено = Поправки.ИсключённыеПакеты(Поправка).Количество();
	Если Исключено > 0 Тогда
		Части.Добавить(Тексты.Шаблон("subscriptions.brief.here.packages",
			Счёт.Счёт(Исключено, Тексты.Текст("subscriptions.count.packages"))));
	КонецЕсли;
	Сведение(Сведения, Тексты.Текст("subscriptions.brief.here"), СтрСоединить(Части, "; "));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// События и отбор по тегам — общие строки своей подписки и подписки сверху.
Функция СведенияПодписки(Знач Подписка, Знач СохранённыйОтбор)

	Сведения = Новый Массив();
	Сведение(Сведения, Тексты.Текст("subscriptions.brief.events"),
		ПодписиСобытий(ЧерезЗапятую.Разобрать(Подписка.ТипыСобытий)));
	Отбор = ОтборТегов.Отбор(Подписка, СохранённыйОтбор);
	Сведение(Сведения, Тексты.Текст("subscriptions.brief.tags"), Отбор.Действующие);
	Сведение(Сведения, Тексты.Текст("subscriptions.brief.tags.dropped"), Отбор.Выпавшие, "warn");
	Возврат Сведения;

КонецФункции

Функция ПодписиСобытий(Знач Типы)

	Подписи = Новый Массив();
	Для Каждого Тип Из Типы Цикл
		Подписи.Добавить(ПоляСобытий.ПодписьТипа(Тип));
	КонецЦикла;
	Возврат СтрСоединить(Подписи, ", ");

КонецФункции

// Внутри фразы подпись события — в кавычках: «только «Версия опубликована»».
Функция СобытияВКавычках(Знач Типы)

	Подписи = Новый Массив();
	Для Каждого Тип Из Типы Цикл
		Подписи.Добавить(Тексты.Шаблон("subscriptions.brief.quoted", ПоляСобытий.ПодписьТипа(Тип)));
	КонецЦикла;
	Возврат СтрСоединить(Подписи, ", ");

КонецФункции

// Пустое значение строку не печатает — это делает сама сводка.
Процедура Сведение(Знач Сведения, Знач Подпись, Знач Значение, Знач Вид = "")
	Сведения.Добавить(Новый Структура("Подпись, Значение, Вид", Подпись, Значение, Вид));
КонецПроцедуры

Функция Знак(Знач Текст)
	Возврат Новый Структура("Текст, Вид", Текст, "warn");
КонецФункции

#КонецОбласти

&Прозвище("СводкаПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "ПараметрыПодписки") _ПараметрыПодписки,
	&Пластилин(Значение = "СервисПоправокПодписок") _Поправки,
	&Пластилин(Значение = "КаталогДействийПодписки") _ТипыДействий,
	&Пластилин(Значение = "ПоляСобытийПодписки") _ПоляСобытий,
	&Пластилин(Значение = "ОтборТеговПодписки") _ОтборТегов,
	&Пластилин(Значение = "ДеревоПолучателей") _Получатели,
	&Пластилин(Значение = "СчётСловами") _Счёт,
	&Пластилин(Значение = "СписокЧерезЗапятую") _ЧерезЗапятую = Неопределено) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	СервисПодписок = _СервисПодписок;
	ПараметрыПодписки = _ПараметрыПодписки;
	Поправки = _Поправки;
	ТипыДействий = _ТипыДействий;
	ПоляСобытий = _ПоляСобытий;
	ОтборТегов = _ОтборТегов;
	Получатели = _Получатели;
	Счёт = _Счёт;
	ЧерезЗапятую = ?(_ЧерезЗапятую = Неопределено, Новый СписокЧерезЗапятую(), _ЧерезЗапятую);

КонецПроцедуры
