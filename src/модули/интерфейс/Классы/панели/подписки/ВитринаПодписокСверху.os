// Раздел «Подписки сверху» нижестоящего объекта: подписки хаба и пула, которые их хозяин разрешил
// сужать, записями реестра с меню ⚙ «Не присылать сюда», «Сузить события», «Пакеты пула»,
// «Снять поправку»; окна сужения и пакетов пула — по адресу ?окно=сузить-<ключ> | пакеты-<ключ>.
// Адреса, чата, токена и шаблона здесь нет.

Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем Поправки;       // СервисПоправокПодписок (подписки) — подписки сверху и поправки к ним
Перем СервисПодписок; // СервисПодписок (подписки) — известные события и доходящие до нижестоящих
Перем Записи;         // ЗаписьПодписки — запись реестра
Перем Срезы;          // СрезПодписок — поправки объекта и сводки, разом на страницу
Перем ПоляСобытий;    // ПоляСобытийПодписки — подписи событий
Перем ОтборТегов;     // ОтборТеговПодписки — галки отбора по тегам
Перем Окна;           // ОкноРаздела — открытое окно и набранное в нём
Перем ОкноПакетов;    // ОкноПолучателей — окно «Пакеты пула» поправки к подписке хаба
Перем Имена;          // ИменаПолейПодписки — имена полей раздела
Перем ИменаПодписок;  // ИменаПодписок — имя и ключ подписки сверху
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секции раздела «Подписки сверху». Объекту без видимых подписок сверху раздела нет.
//
// Параметры:
//  Параметры - Структура:
//    * Объект - Структура - описание нижестоящего объекта (СервисПодписок.ОбъектПула, ОбъектПакета);
//    * Адрес - Строка - адрес раздела подписок объекта;
//    * Токен - Строка - CSRF-токен сессии;
//    * ИмяПула - Строка - пул объекта: им называется подписка пула без названия;
//    * МожноМенять - Булево - вправе ли зритель распоряжаться подписками объекта;
//    * Окно - Структура, Неопределено - состояние открытого окна (см. ОкноРаздела.Отбитое);
//    * Зритель - Пользователь - кто смотрит раздел;
//    * ВидДерева - Структура, Неопределено - что окно пакетов пула показывает: Найти, Ветка, Страница;
//    * АдресТегов - Строка - раздел «Теги» объекта.
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - одна секция либо ни одной.
//
Функция Секции(Знач Параметры) Экспорт

	Результат = Новый Массив();
	ПодпискиСверху = Поправки.ПодпискиСверху(Параметры.Объект);
	Если ПодпискиСверху.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Реестр = Кит.Реестр().Подпись(Тексты.Текст("subscriptions.above.title"));
	Срез = Срезы.Сверху(Параметры, ПодпискиСверху);
	Для Каждого Подписка Из ПодпискиСверху Цикл
		Реестр.Добавить(Записи.Сверху(Параметры, Подписка, Срез));
	КонецЦикла;

	Результат.Добавить(Кит.Секция(Тексты.Текст("subscriptions.above.title"),
			Кит.Примечание(Тексты.Текст("subscriptions.above.readonly")).Когда(Параметры.МожноМенять <> Истина),
			Реестр,
			?(Параметры.МожноМенять = Истина, ОкноСужения(Параметры, ПодпискиСверху, Срез), Неопределено),
			?(Параметры.МожноМенять = Истина, ОкноПакетовПула(Параметры, ПодпискиСверху), Неопределено))
		.Лид(Тексты.Текст("subscriptions.above.lead")).Иконка("вниз"));
	Возврат Результат;

КонецФункции

// Напечатает ли раздел окно, которое называет состояние: сужения — у подписки сверху этого объекта,
// пакетов пула — у подписки хаба сверху пула.
//
// Параметры:
//  Объект - Структура - описание нижестоящего объекта.
//  Состояние - Структура, Неопределено - состояние окна раздела.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Объект, Знач Состояние) Экспорт
	Если Окна.Открыто(Состояние, "пакеты") Тогда
		Подписка = ПодпискаОкна(Поправки.ПодпискиСверху(Объект), Состояние);
		Возврат Подписка <> Неопределено И ПакетыПула(Объект, Подписка);
	КонецЕсли;
	Возврат Окна.Открыто(Состояние, "сузить")
		И ПодпискаОкна(Поправки.ПодпискиСверху(Объект), Состояние) <> Неопределено;
КонецФункции

#КонецОбласти

#Область ОкноПакетовПула

// Окно «Пакеты пула»: какие пакеты своего пула он снимает с подписки хаба.
Функция ОкноПакетовПула(Знач Параметры, Знач ПодпискиСверху)

	Подписка = ПодпискаОкна(ПодпискиСверху, Параметры.Окно);
	Если Подписка = Неопределено ИЛИ НЕ Окна.Открыто(Параметры.Окно, "пакеты")
		ИЛИ НЕ ПакетыПула(Параметры.Объект, Подписка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ОкноПакетов.ОкноПоправки(Параметры, Подписка);

КонецФункции

// Пакетами сужает только пул и только подписку хаба.
Функция ПакетыПула(Знач Объект, Знач Подписка)
	Возврат НРег(СокрЛП(Строка(Объект.ТипОбъекта))) = "пул" И НРег(СокрЛП(Строка(Подписка.ТипОбъекта))) = "хаб";
КонецФункции

#КонецОбласти

#Область ОкноСужения

// Окно «Сузить»: какие события подписки оставить себе и свой отбор по тегам. Флажки — только
// события самой подписки: поправка сужает, а не добавляет. «Не присылать» едет с окном как есть.
Функция ОкноСужения(Знач Параметры, Знач ПодпискиСверху, Знач Срез)

	Подписка = ПодпискаОкна(ПодпискиСверху, Параметры.Окно);
	Если Подписка = Неопределено ИЛИ НЕ Окна.Открыто(Параметры.Окно, "сузить") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Состояние = Параметры.Окно;
	Поправка = Срезы.ПоправкаОбъекта(Срез, Подписка);
	Заглушена = Поправка <> Неопределено И Поправка.НеПрисылать = Истина;

	Возврат Кит.Окно(Тексты.Шаблон("subscriptions.above.window.narrow",
				ИменаПодписок.Сверху(Подписка, Параметры.ИмяПула)),
			ОшибкаОкна(Состояние),
			?(Заглушена, Кит.СкрытоеПоле(Имена.ИмяПоляНеПрисылать(), Имена.ЗначениеОтмечено()), Неопределено),
			ОставленныеСобытия(Подписка, Поправка, Состояние),
			ОтборТегов.Галки(Параметры.Объект, Поправка, ?(Поправка = Неопределено, "", Поправка.ОтборТегов),
				Состояние, Параметры.АдресТегов))
		.Лид(Тексты.Текст("subscriptions.above.window.lead"))
		.Действия(Кит.Кнопка(Тексты.Текст("subscriptions.above.button.save")).Основная().Иконка("сохранить"))
		.Форма("inherited/" + ИменаПодписок.Ключ(Подписка) + "/narrow").БезПерезагрузки()
		.Якорь("podpiska-suzit").Открыто().АдресЗакрытия(Параметры.Адрес);

КонецФункции

// Имя флажка события — по индексу в перечне известных типов, как у окна подписки; событие самого
// хаба до объекта не доходит, и сужать его нечем.
Функция ОставленныеСобытия(Знач Подписка, Знач Поправка, Знач Состояние)

	Оставленные = Поправки.ОставленныеСобытия(Подписка, Поправка);
	Известные = СервисПодписок.ИзвестныеТипы();
	Набор = Кит.Группа(Тексты.Текст("subscriptions.above.events.legend"));
	Для Каждого Тип Из СервисПодписок.СобытияДляНижестоящих(Подписка) Цикл
		Индекс = Известные.Найти(Тип);
		Если Индекс = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Имя = Имена.ИмяПоляСобытия(Индекс);
		Набор.Добавить(Кит.Поле(Имя, ПоляСобытий.ПодписьТипа(Тип)).ТипЗначения("флажок")
			.Значение(Имена.ЗначениеОтмечено())
			.Отмечено(Окна.Отмечено(Состояние, Имя, Оставленные.Найти(Тип) <> Неопределено,
				Имена.ЗначениеОтмечено())));
	КонецЦикла;
	Возврат Набор;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПодпискаОкна(Знач ПодпискиСверху, Знач Состояние)

	Если Состояние = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Состояние.Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Подписка Из ПодпискиСверху Цикл
		Если ИменаПодписок.Ключ(Подписка) = СокрЛП(Состояние.Ключ) Тогда
			Возврат Подписка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Отказ поправки, который не относится к одному полю, — над флажками.
Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

#КонецОбласти

&Прозвище("ВитринаПодписокСверху")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисПоправокПодписок") _Поправки,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "ЗаписьПодписки") _Записи,
	&Пластилин(Значение = "СрезПодписок") _Срезы,
	&Пластилин(Значение = "ПоляСобытийПодписки") _ПоляСобытий,
	&Пластилин(Значение = "ОтборТеговПодписки") _ОтборТегов,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ОкноПолучателей") _ОкноПакетов,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "ИменаПодписок") _ИменаПодписок,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Поправки = _Поправки;
	СервисПодписок = _СервисПодписок;
	Записи = _Записи;
	Срезы = _Срезы;
	ПоляСобытий = _ПоляСобытий;
	ОтборТегов = _ОтборТегов;
	Окна = _Окна;
	ОкноПакетов = _ОкноПакетов;
	Имена = _Имена;
	ИменаПодписок = _ИменаПодписок;
	Тексты = _Тексты;

КонецПроцедуры
