// Раздел «Подписки сверху» нижестоящего объекта: подписки хаба и пула, которые их хозяин
// разрешил сужать, и поправка объекта к каждой, у пула — с деревом его пакетов. Адреса, чата,
// токена и шаблона здесь нет.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем Поправки;          // СервисПоправокПодписок (подписки) — подписки сверху и поправки к ним
Перем СервисПодписок;    // СервисПодписок (подписки) — перечень известных событий
Перем Сводки;            // СводкаПодписки — название, хозяин, состояние и сведения в свёрнутой карточке
Перем Получатели;        // ДеревоПолучателей — пакеты пула в его поправке к подписке хаба
Перем ПоляСобытий;       // ПоляСобытийПодписки — подписи событий
Перем ОтборТегов;        // ОтборТеговПодписки — галки отбора по тегам
Перем Имена;             // ИменаПолейПодписки — имена полей раздела
Перем Бланки;            // БланкРаздела — адрес и токен раздела, формы на них
Перем РазборФормы;       // РазборФормы — чтение отклонённой формы
Перем ЧерезЗапятую;      // СписокЧерезЗапятую (основа)
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секции раздела «Подписки сверху». Объекту без видимых подписок сверху раздела нет.
//
// Параметры:
//  Параметры - Структура:
//    * Объект - Структура - описание нижестоящего объекта (СервисПодписок.ОбъектПула, ОбъектПакета);
//    * Адрес - Строка - адрес раздела подписок объекта;
//    * Токен - Строка - CSRF-токен сессии;
//    * ИмяПула - Строка - пул объекта: им называется подписка пула без названия;
//    * МожноМенять - Булево - вправе ли зритель распоряжаться подписками объекта;
//    * Форма - Соответствие, Неопределено - отклонённая форма поправки;
//    * ПоправкаИд - Строка, Число - подписка, чью поправку отклонили (0 — не отклоняли);
//    * Зритель - Пользователь - кто смотрит раздел;
//    * ДеревоИд - Строка - подписка, чьё дерево пакетов пула открыто ("" — ни одной);
//    * Поиск - Строка - поиск пакета в открытом дереве.
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Результат = Новый Массив();
	ПодпискиСверху = Поправки.ПодпискиСверху(Параметры.Объект);
	Если ПодпискиСверху.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Содержимое = Кит.Холст();
	Для Каждого Подписка Из ПодпискиСверху Цикл
		Содержимое.Добавить(КарточкаСверху(Подписка, Параметры));
	КонецЦикла;
	Содержимое.Добавить(Кит.Примечание(Тексты.Текст("subscriptions.above.note")));

	Секция = РендерерНастроек.Секция(Тексты.Текст("subscriptions.above.title"),
		Тексты.Текст("subscriptions.above.lead"), Содержимое.Рендер());
	Секция.Иконка = "стрелка";
	Результат.Добавить(Секция);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область КарточкаСверху

// Отбитая поправка и открытое дерево пакетов приезжают раскрытыми: человек видит то, что правил.
Функция КарточкаСверху(Знач Подписка, Знач Параметры)

	Поправка = Поправки.ПоправкаОбъекта(Параметры.Объект, Подписка);
	Отклонённая = ОтклонённаяПоправка(Параметры, Подписка);

	Карточка = Кит.Раскрывашка();
	Если Отклонённая <> Неопределено ИЛИ Получатели.Открыто(Параметры, Подписка) Тогда
		Карточка.Открыть();
	КонецЕсли;
	Карточка.Шапка().Добавить(Сводки.Сверху(Подписка, Поправка, Параметры.ИмяПула));
	Карточка.Добавить(ТелоКарточки(Подписка, Поправка, Параметры, Отклонённая));
	Возврат Карточка;

КонецФункции

// Ниже свёрнутой строки — форма поправки и её действия одним рядом, у пула — его пакеты.
Функция ТелоКарточки(Знач Подписка, Знач Поправка, Знач Параметры, Знач Отклонённая)

	Если Параметры.МожноМенять <> Истина Тогда
		Возврат Кит.Примечание(Тексты.Текст("subscriptions.above.readonly"));
	КонецЕсли;

	Бланк = Бланки.Вложенный(Бланки.Раздела(Параметры), АдресПодпискиСверху(Подписка));
	Тело = Кит.Холст();
	Тело.Добавить(ФормаПоправки(Параметры.Объект, Подписка, Поправка, Бланк, Отклонённая));
	Тело.Добавить(ДействияПоправки(Подписка, Поправка, Бланк));
	Если НРег(СокрЛП(Строка(Параметры.Объект.ТипОбъекта))) = "пул" Тогда
		Тело.Добавить(Получатели.БлокПоправки(Параметры, Подписка, Бланк));
	КонецЕсли;
	Возврат Тело;

КонецФункции

#КонецОбласти

#Область ФормаПоправки

// Флажки — только события самой подписки: поправка сужает, а не добавляет; галки тегов — из тегов
// своего объекта.
Функция ФормаПоправки(Знач Объект, Знач Подписка, Знач Поправка, Знач Бланк, Знач Отклонённая)

	Форма = Бланки.Форма(Бланк, "narrow", "столбик").Якорь(ЯкорьПоправки(Подписка));
	Форма.Добавить(ФлажокНеПрисылать(Поправка, Отклонённая));
	Форма.Добавить(ОставленныеСобытия(Подписка, Поправка, Отклонённая));
	Форма.Добавить(ОтборТегов.Галки(Объект, Поправка, ?(Поправка = Неопределено, "", Поправка.ОтборТегов),
		Отклонённая));
	Возврат Форма;

КонецФункции

Функция ФлажокНеПрисылать(Знач Поправка, Знач Отклонённая)

	Отмечено = ?(Отклонённая = Неопределено, Поправка <> Неопределено И Поправка.НеПрисылать = Истина,
		РазборФормы.Флажок(Отклонённая, Имена.ИмяПоляНеПрисылать(), Имена.ЗначениеОтмечено()));

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Отмечено, Подсказка",
		Имена.ИмяПоляНеПрисылать(), Тексты.Текст("subscriptions.above.mute.label"), "флажок",
		Имена.ЗначениеОтмечено(), Отмечено, Тексты.Текст("subscriptions.above.mute.hint")));

КонецФункции

// Имя флажка события — по индексу в перечне известных типов, как у формы подписки.
Функция ОставленныеСобытия(Знач Подписка, Знач Поправка, Знач Отклонённая)

	Оставленные = Поправки.ОставленныеСобытия(Подписка, Поправка);
	Известные = СервисПодписок.ИзвестныеТипы();
	Набор = Кит.Группа(Тексты.Текст("subscriptions.above.events.legend"));
	Для Каждого Тип Из ЧерезЗапятую.Разобрать(Подписка.ТипыСобытий) Цикл
		Индекс = Известные.Найти(Тип);
		Если Индекс = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Отмечено = ?(Отклонённая = Неопределено, Оставленные.Найти(Тип) <> Неопределено,
			РазборФормы.Флажок(Отклонённая, Имена.ИмяПоляСобытия(Индекс), Имена.ЗначениеОтмечено()));
		Набор.Добавить(Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Отмечено",
			Имена.ИмяПоляСобытия(Индекс), ПоляСобытий.ПодписьТипа(Тип), "флажок",
			Имена.ЗначениеОтмечено(), Отмечено)));
	КонецЦикла;
	Возврат Набор;

КонецФункции

// «Сохранить» стоит рядом со «Снять поправку» и отправляет форму поправки по её якорю.
Функция ДействияПоправки(Знач Подписка, Знач Поправка, Знач Бланк)

	Действия = Кит.Ряд("действия");
	Действия.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер, Форма",
		Тексты.Текст("subscriptions.above.button.save"), "основная", "малый", ЯкорьПоправки(Подписка))));
	Действия.Добавить(КнопкаСнятия(Поправка, Бланк));
	Возврат Действия;

КонецФункции

Функция КнопкаСнятия(Знач Поправка, Знач Бланк)

	Если Поправка = Неопределено Тогда
		Возврат Кит.Ничего();
	КонецЕсли;
	Возврат Бланки.КнопкаДействия(Бланк, "reset", Тексты.Текст("subscriptions.above.button.reset"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЯкорьПоправки(Знач Подписка)
	Возврат "поправка-" + Формат(Подписка.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

// Формы поправки постят на адрес подписки сверху внутри раздела объекта.
Функция АдресПодпискиСверху(Знач Подписка)
	Возврат "inherited/" + Формат(Подписка.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

Функция ОтклонённаяПоправка(Знач Параметры, Знач Подписка)

	Форма = Неопределено;
	ПоправкаИд = Неопределено;
	Параметры.Свойство("Форма", Форма);
	Параметры.Свойство("ПоправкаИд", ПоправкаИд);
	Если ТипЗнч(Форма) <> Тип("Соответствие")
		ИЛИ СокрЛП(Строка(ПоправкаИд)) <> Формат(Подписка.Идентификатор, "ЧГ=0; ЧН=0") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Форма;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаПодписокСверху")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "СервисПоправокПодписок") _Поправки,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "СводкаПодписки") _Сводки,
	&Пластилин(Значение = "ДеревоПолучателей") _Получатели,
	&Пластилин(Значение = "ПоляСобытийПодписки") _ПоляСобытий,
	&Пластилин(Значение = "ОтборТеговПодписки") _ОтборТегов,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "БланкРаздела") _Бланки,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СписокЧерезЗапятую") _ЧерезЗапятую = Неопределено) Экспорт

	ЧерезЗапятую = ?(_ЧерезЗапятую = Неопределено, Новый СписокЧерезЗапятую(), _ЧерезЗапятую);

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Поправки = _Поправки;
	СервисПодписок = _СервисПодписок;
	Сводки = _Сводки;
	Получатели = _Получатели;
	ПоляСобытий = _ПоляСобытий;
	ОтборТегов = _ОтборТегов;
	Имена = _Имена;
	Бланки = _Бланки;
	РазборФормы = _РазборФормы;
	Тексты = _Тексты;

КонецПроцедуры
