// Число с существительным в нужной по-русски форме: «1 пакет», «3 пакета», «5 пакетов».

Перем Тексты; // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Текст счёта: форма по числу из трёх, записанных через «|».
//
// Параметры:
//  Число - Число - сколько.
//  Формы - Строка - «для 1, 21…|для 2–4, 22–24…|для 0, 5–20…» с %1 на месте числа
//          («%1 пакет|%1 пакета|%1 пакетов»).
//
// Возвращаемое значение:
//  Строка.
//
Функция Счёт(Знач Число, Знач Формы) Экспорт

	Варианты = СтрРазделить(Формы, "|");
	ДваПоследних = Число % 100;
	Последняя = Число % 10;
	Если Варианты.Количество() < 3 ИЛИ (ДваПоследних >= 11 И ДваПоследних <= 14) Тогда
		Номер = 2;
	ИначеЕсли Последняя = 1 Тогда
		Номер = 0;
	ИначеЕсли Последняя >= 2 И Последняя <= 4 Тогда
		Номер = 1;
	Иначе
		Номер = 2;
	КонецЕсли;
	Вариант = Варианты[Мин(Номер, Варианты.ВГраница())];
	Возврат СтрЗаменить(Вариант, "%1", Тексты.ЧислоТекстом(Число));

КонецФункции

#КонецОбласти

&Прозвище("СчётСловами")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт
	Тексты = _Тексты;
КонецПроцедуры
