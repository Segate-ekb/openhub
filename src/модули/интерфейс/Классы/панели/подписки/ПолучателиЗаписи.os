// Получатели в записи подписки хаба или пула: кому она сообщает одной строкой счётом («пулы: 3 из 4;
// выбранные: 12 пакетов в 1 пуле», «выбранные: 4 из 6») и отметки рядом плашек кита с крестиком — крестик
// тихой формой двери окна «Получатели» возвращает пул «Никто» или снимает один выбор, не перезагружая
// страницу.
// Сводки и имена — из среза страницы: запись домен не спрашивает.

Перем Кит;         // Кит (кит) — фабрика элементов экрана
Перем Тексты;      // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Исключения;  // СервисИсключенийПодписок (подписки) — есть ли дерево, режимы пула
Перем Имена;       // ИменаПолейПодписки — ключи узлов и поля правок
Перем Счёт;        // СчётСловами — число с существительным в нужной форме
Перем Окно;        // ОкноПолучателей — дверь окна «Получатели», куда постят плашки

#Область ПубличныйИнтерфейс

// Кому подписка сообщает — одной строкой для факта и свойства записи.
//
// Параметры:
//  Подписка - Вебхук - подписка объекта.
//  Сводка - Структура, Неопределено - сводка отметок (СервисИсключенийПодписок.СводкиИсключений);
//           Неопределено — сводки нет (зритель не вправе менять).
//
// Возвращаемое значение:
//  Строка - пустая у подписки пакета и без сводки.
//
Функция КомуСообщает(Знач Подписка, Знач Сводка) Экспорт

	Если НЕ Исключения.ЕстьДерево(Подписка) ИЛИ Сводка = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если НЕ ПодпискаХаба(Подписка) И Сводка.Выбранных > 0 Тогда
		Возврат Тексты.Шаблон("subscriptions.recipients.brief.picked.of", Число_(Сводка.Выбрано),
			Число_(Сводка.ВсегоПакетов));
	ИначеЕсли НЕ ПодпискаХаба(Подписка) ИЛИ Сводка.Пулов + Сводка.Выбранных = 0 Тогда
		Возврат Тексты.Текст("subscriptions.recipients.brief.all");
	КонецЕсли;

	Пулы = Тексты.Шаблон("subscriptions.recipients.brief.pools", Число_(Сводка.ВсегоПулов - Сводка.Пулов),
		Число_(Сводка.ВсегоПулов));
	Если Сводка.Выбранных = 0 Тогда
		Возврат Пулы;
	КонецЕсли;
	Возврат Тексты.Шаблон("subscriptions.recipients.brief.picked.pools", Пулы, Пакетов(Сводка.Выбрано),
		Счёт.Счёт(Сводка.Выбранных, Тексты.Текст("subscriptions.count.pools.in")));

КонецФункции

// Отметки, которые запись называет по имени плашками: первые по порядку сводки, остальное —
// числом «ещё N». Срез страницы читает имена только их.
//
// Параметры:
//  Сводка - Структура, Неопределено - сводка отметок подписки.
//
// Возвращаемое значение:
//  Массив из Структура - узлы сводки (Вид, ПулИдентификатор, ПакетИдентификатор).
//
Функция НазываемыеОтметки(Знач Сводка) Экспорт

	Результат = Новый Массив();
	Если Сводка = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Узел Из Сводка.Узлы Цикл
		Если Узел.Вид = "выбранные" ИЛИ Узел.Вид = "исключён" Тогда
			// режим пула назван плашками его выбранных пакетов; исключённый пакет — прежняя запись до
			// перевода на старте, плашки у неё нет
			Продолжить;
		ИначеЕсли Результат.Количество() = ПределПлашек() Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(Узел);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Отметки подписки рядом плашек с крестиком: пул «Никто» крестик возвращает, выбранный пакет —
// убирает из выбранных. Крестик каждой плашки — тихая форма двери окна «Получатели»
// с правкой кита (Плашка.Снять).
//
// Параметры:
//  Подписка - Вебхук - подписка объекта.
//  Сводка - Структура, Неопределено - сводка отметок подписки.
//  Пулы - Соответствие - идентификатор пула -> пул (имена из среза страницы).
//  Пакеты - Соответствие - идентификатор пакета -> пакет.
//
// Возвращаемое значение:
//  ЭлементЭкрана, Неопределено - ряд плашек; Неопределено — отметок нет.
//
Функция Плашки(Знач Подписка, Знач Сводка, Знач Пулы, Знач Пакеты) Экспорт

	Названные = НазываемыеОтметки(Сводка);
	Если Названные.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Плашки = Новый Массив();
	Для Каждого Узел Из Названные Цикл
		Плашки.Добавить(ПлашкаОтметки(Подписка, Узел, Пулы, Пакеты));
	КонецЦикла;
	Ещё = ВсегоОтметок(Сводка) - Названные.Количество();
	Если Ещё > 0 Тогда
		Плашки.Добавить(Кит.Плашка(Тексты.Шаблон("subscriptions.recipients.chip.more", Формат(Ещё, "ЧГ=0"))));
	КонецЕсли;
	Возврат Кит.РядПлашек(Плашки);

КонецФункции

#КонецОбласти

#Область Плашки

// Плашка отметки — правка кита одним крестиком: «режим=пул_N:все» у пула «Никто», «снять=пакет_N»
// у выбранного пакета.
Функция ПлашкаОтметки(Знач Подписка, Знач Узел, Знач Пулы, Знач Пакеты)

	Имя = ИмяОтметки(Подписка, Узел, Пулы, Пакеты);
	Если Узел.Вид = "никакие" Тогда
		Правка = Новый Структура("правки, режим", "1",
			Имена.КлючУзла("пул", Узел.ПулИдентификатор) + ":" + Исключения.РежимВсе());
		Подпись = Тексты.Шаблон("subscriptions.recipients.chip.pool", Имя);
	Иначе
		Правка = Новый Структура("правки, снять", "1", Имена.КлючУзла("пакет", Узел.ПакетИдентификатор));
		Подпись = Тексты.Шаблон("subscriptions.recipients.chip.drop", Имя);
	КонецЕсли;

	Если Узел.Вид = "выбран" Тогда
		Плашка = Кит.Плашка("+ " + Имя).Вид("accent");
	Иначе
		Плашка = Кит.Плашка("− " + Имя);
	КонецЕсли;
	Возврат Плашка.Снять(Окно.АдресДвери("", Подписка, Ложь), Правка, , Подпись);

КонецФункции

// Пул — своим именем, пакет у подписки хаба — «пул/пакет», у подписки пула — именем пакета.
// Исчезнувший к печати узел называется номером: имя подставить неоткуда.
Функция ИмяОтметки(Знач Подписка, Знач Узел, Знач Пулы, Знач Пакеты)

	Пул = Пулы.Получить(Узел.ПулИдентификатор);
	ИмяПула = ?(Пул = Неопределено, "#" + Формат(Узел.ПулИдентификатор, "ЧГ=0"), Пул.Имя);
	Если Узел.ПакетИдентификатор = 0 Тогда
		Возврат ИмяПула;
	КонецЕсли;
	Пакет = Пакеты.Получить(Узел.ПакетИдентификатор);
	ИмяПакета = ?(Пакет = Неопределено, "#" + Формат(Узел.ПакетИдентификатор, "ЧГ=0"), Пакет.Имя);
	Возврат ?(ПодпискаХаба(Подписка), ИмяПула + "/" + ИмяПакета, ИмяПакета);

КонецФункции

Функция ВсегоОтметок(Знач Сводка)
	Возврат Сводка.Пулов + Сводка.Выбрано;
КонецФункции

// Сколько отметок запись называет плашками: остальное — в окне.
Функция ПределПлашек()
	Возврат 6;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Число_(Знач Число)
	Возврат Формат(Число, "ЧГ=0; ЧН=0");
КонецФункции

Функция Пакетов(Знач Число)
	Возврат Счёт.Счёт(Число, Тексты.Текст("subscriptions.count.packages"));
КонецФункции

Функция ПодпискаХаба(Знач Подписка)
	Возврат НРег(СокрЛП(Строка(Подписка.ТипОбъекта))) = "хаб";
КонецФункции

#КонецОбласти

&Прозвище("ПолучателиЗаписи")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисИсключенийПодписок") _Исключения,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "СчётСловами") _Счёт,
	&Пластилин(Значение = "ОкноПолучателей") _Окно) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	Исключения = _Исключения;
	Имена = _Имена;
	Счёт = _Счёт;
	Окно = _Окно;

КонецПроцедуры
