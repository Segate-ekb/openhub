// Общий ход раздела «Подписки» трёх домов: гейт формы, пульт и ответ на его исход — 303 на раздел,
// страница с открытым окном и отказами, окно секрета, 404 чужой подписки, ответ скрипту кусочком;
// уведомления и параметры витрин своих подписок и подписок сверху. Страницу рисует дом.

Перем Ответы;     // ОтветыНастроек
Перем Тексты;     // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Гейт;       // ГейтФормы — метод запроса и токен формы
Перем Пульт;      // ПультПодписок — мутации подписок
Перем Окна;       // ОкноРаздела — окно по адресу и ответы форм окон
Перем Витрина;    // ВитринаПодписок — виды окон и есть ли окно у записи
Перем ВитринаСверху; // ВитринаПодписокСверху — окно сужения подписки сверху
Перем СервисПодписок; // СервисПодписок (подписки) — вправе ли смотрящий распоряжаться подписками
Перем Имена;      // ИменаПолейПодписки — параметр поиска окна «Получатели»
Перем Числа_;     // ПриведениеЧисел (основа) — номер страницы ветки из адреса
Перем Проверка;   // ПроверкаПодпискиДоСохранения — ответы предпросмотра и пробы кусочком
Перем Заголовки;  // ЗаголовкиКэша (основа) — ответ кусочком не оседает в кэшах
Перем ОкноПолучателей; // ОкноПолучателей — дверь окна «Получатели» и «Пакеты пула»

#Область ПубличныйИнтерфейс

// Описание раздела подписок: чьи это подписки и где раздел живёт.
//
// Параметры:
//  Владелец - Структура - описание объекта подписок (СервисПодписок.Объект*).
//  Адрес - Строка - адрес раздела: на него постятся формы и на него же уводит редирект.
//
// Возвращаемое значение:
//  Структура - Владелец, Адрес.
//
Функция ОписаниеРаздела(Знач Владелец, Знач Адрес) Экспорт
	Возврат Новый Структура("Владелец, Адрес", Владелец, Адрес);
КонецФункции

// Показ раздела на GET: окно, названное адресом, и отметка «сохранено».
//
// Параметры:
//  Контекст - Структура - Пользователь и Сессия запроса.
//  Окно - Строка - значение параметра адреса «окно».
//  Сохранено - Строка - отметка сохранения из адреса.
//
// Возвращаемое значение:
//  Структура - показ раздела (см. Показ).
//
Функция ПоказПоАдресу(Знач Контекст, Знач Окно, Знач Сохранено) Экспорт

	Показ = Показ(Контекст);
	Показ.Окно = Окна.ИзАдреса(Окно, Витрина.ВидыОкон());
	Показ.Сохранено = ЗначениеЗаполнено(Сохранено);
	Возврат Показ;

КонецФункции

// Заведение подписки окном «Новая подписка».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  Раздел - Структура - описание раздела (см. ОписаниеРаздела).
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
// Возвращаемое значение:
//  Структура, Неопределено - показ раздела; Неопределено — ответ уже записан: гейт отбил форму
//  либо заведение удалось и ответ — 303 на раздел.
//
Функция ПоказЗаведения(Ответ, Знач Контекст, Знач Раздел, Знач КукиЗапроса,
	Знач МетодЗапроса, Знач ТелоЗапроса) Экспорт

	// GET адреса раздела — показ, сюда он не доходит; «GET, POST» — то, что отказ 405 назовёт в Allow:
	// адрес раздела принимает оба метода, а двери записей — только POST (ФормаМутации)
	Форма = Гейт.ПринятаяФорма(Ответ, Контекст, "GET, POST", МетодЗапроса, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Завершить(Ответ, Контекст, Раздел, КукиЗапроса,
		Пульт.Создать(Контекст.Пользователь, Раздел.Владелец, Форма), "новая", "", Форма);

КонецФункции

// Правка подписки окном «Изменить». Форма старой вкладки с полем включённости — отказ без
// изменений тостом раздела.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  Раздел - Структура - описание раздела (см. ОписаниеРаздела).
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  Идентификатор - Строка - идентификатор подписки из адреса.
//
// Возвращаемое значение:
//  Структура, Неопределено - показ раздела; Неопределено — ответ уже записан.
//
Функция ПоказПравки(Ответ, Знач Контекст, Знач Раздел, Знач КукиЗапроса,
	Знач МетодЗапроса, Знач ТелоЗапроса, Знач Идентификатор) Экспорт

	Форма = ФормаМутации(Ответ, Контекст, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Исход = Пульт.Сохранить(Контекст.Пользователь, Раздел.Владелец, Идентификатор, Форма);
	// форма старой вкладки в окно правки не возвращается: её поля собраны под другой экран
	Возврат Завершить(Ответ, Контекст, Раздел, КукиЗапроса, Исход,
		?(Исход.Устарела, "", "изменить"), Идентификатор, Форма);

КонецФункции

// Тумблер записи: включение и выключение подписки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  Раздел - Структура - описание раздела (см. ОписаниеРаздела).
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  Идентификатор - Строка - идентификатор подписки из адреса.
//
// Возвращаемое значение:
//  Структура, Неопределено - показ раздела с отказом; Неопределено — ответ уже записан.
//
Функция ПоказПереключения(Ответ, Знач Контекст, Знач Раздел, Знач КукиЗапроса,
	Знач МетодЗапроса, Знач ТелоЗапроса, Знач Идентификатор) Экспорт

	Форма = ФормаМутации(Ответ, Контекст, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Завершить(Ответ, Контекст, Раздел, КукиЗапроса,
		Пульт.Переключить(Контекст.Пользователь, Раздел.Владелец, Идентификатор, Форма), "", Идентификатор, Форма);

КонецФункции

// Удаление подписки. Без поля подтверждения (форма ушла без скрипта) подписка не удаляется:
// ответ ведёт на страницу с открытым подтверждением.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  Раздел - Структура - описание раздела (см. ОписаниеРаздела).
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  Идентификатор - Строка - идентификатор подписки из адреса.
//
// Возвращаемое значение:
//  Структура, Неопределено - показ раздела; Неопределено — ответ уже записан.
//
Функция ПоказУдаления(Ответ, Знач Контекст, Знач Раздел, Знач КукиЗапроса,
	Знач МетодЗапроса, Знач ТелоЗапроса, Знач Идентификатор) Экспорт

	Форма = ФормаМутации(Ответ, Контекст, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли НЕ Окна.Подтверждено(Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, Раздел.Адрес, СокрЛП(Строка(Идентификатор)));
		Возврат Неопределено;
	КонецЕсли;
	Возврат Завершить(Ответ, Контекст, Раздел, КукиЗапроса,
		Пульт.Удалить(Контекст.Пользователь, Раздел.Владелец, Идентификатор, Форма),
		"удалить", Идентификатор, Форма);

КонецФункции

// Пробная отправка. Окно прислало свои поля — проба ими, без сохранения, и окно возвращается
// открытым с итогом; без полей окна (меню записи) — проба сохранёнными настройками, итог —
// уведомлением раздела. Скрипту страницы итог уходит кусочком.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  Раздел - Структура - описание раздела (см. ОписаниеРаздела).
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  Идентификатор - Строка - подписка из адреса; "" — окно новой подписки.
//  Кусочком - Строка - непустое: ответ кусочком для скрипта (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура, Неопределено - показ раздела; Неопределено — ответ уже записан.
//
Функция ПоказПробы(Ответ, Знач Контекст, Знач Раздел, Знач КукиЗапроса,
	Знач МетодЗапроса, Знач ТелоЗапроса, Знач Идентификатор, Знач Кусочком = "") Экспорт

	Форма = ФормаМутации(Ответ, Контекст, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Исход = Пульт.Проба(Контекст.Пользователь, Раздел.Владелец, Идентификатор, Форма);
	Если Исход.НеНайдено Тогда
		ОтдатьНеНайдено(Ответ, Контекст, КукиЗапроса);
		Возврат Неопределено;
	ИначеЕсли ЗначениеЗаполнено(Кусочком) Тогда
		ОтдатьКусочек(Ответ, Проверка.ОтветПробы(Исход), ?(Исход.Успех, 200, 400));
		Возврат Неопределено;
	КонецЕсли;

	Показ = Показ(Контекст);
	Показ.Статус = ?(Исход.Успех, 200, Исход.Код);
	Если НЕ ЗначениеЗаполнено(Пульт.ТипДействия(Форма)) Тогда
		// проба из меню записи: итог — тостом раздела
		Если Исход.Успех Тогда
			Показ.Сообщение = Тексты.Шаблон(?(Исход.ВидСообщения = "ok", "subscriptions.trial.ok",
				"subscriptions.trial.failed"), Исход.Сообщение);
			Показ.ВидСообщения = Исход.ВидСообщения;
		Иначе
			Показ.Ошибка = Исход.Сообщение;
		КонецЕсли;
		Возврат Показ;
	КонецЕсли;

	Показ.Окно = Окна.Отбитое(ВидОкнаФормы(Идентификатор), КлючОкна(Идентификатор), Форма, Исход.Отказы);
	Показ.Проба = Исход;
	Возврат Показ;

КонецФункции

// Предпросмотр уведомления по полям окна — ничего не сохраняет. Скрипту — кусочком; без скрипта —
// страница с тем же окном, открытым на шаге текста, и сообщением у поля.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  Раздел - Структура - описание раздела (см. ОписаниеРаздела).
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  Идентификатор - Строка - подписка формы правки из адреса; "" — окно новой подписки.
//  Кусочком - Строка - непустое: ответ кусочком для скрипта (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура, Неопределено - показ раздела; Неопределено — ответ уже записан.
//
Функция ПоказПредпросмотра(Ответ, Знач Контекст, Знач Раздел, Знач КукиЗапроса,
	Знач МетодЗапроса, Знач ТелоЗапроса, Знач Идентификатор, Знач Кусочком = "") Экспорт

	Форма = ФормаМутации(Ответ, Контекст, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Исход = Пульт.Уведомление(Контекст.Пользователь, Раздел.Владелец, Идентификатор, Форма);
	Если Исход.НеНайдено Тогда
		ОтдатьНеНайдено(Ответ, Контекст, КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Статус = ?(ЗначениеЗаполнено(Исход.Ошибка), 400, 200);
	Если ЗначениеЗаполнено(Кусочком) Тогда
		ОтдатьКусочек(Ответ, Проверка.ОтветПредпросмотра(Исход), Статус);
		Возврат Неопределено;
	КонецЕсли;

	Показ = Показ(Контекст);
	Показ.Окно = Окна.Отбитое(ВидОкнаФормы(Идентификатор), КлючОкна(Идентификатор), Форма);
	Показ.Предпросмотр = Исход;
	Показ.Статус = Статус;
	Возврат Показ;

КонецФункции

// Поправка к подписке сверху: сужение (окно «Сузить», «Не присылать сюда») или снятие.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  Раздел - Структура - описание раздела (см. ОписаниеРаздела).
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  Действие - Строка - "сузить" | "снять".
//  Идентификатор - Строка - идентификатор подписки сверху из адреса.
//
// Возвращаемое значение:
//  Структура, Неопределено - показ раздела; Неопределено — ответ уже записан.
//
Функция ПоказПоправки(Ответ, Знач Контекст, Знач Раздел, Знач КукиЗапроса,
	Знач МетодЗапроса, Знач ТелоЗапроса, Знач Действие, Знач Идентификатор) Экспорт

	Форма = ФормаМутации(Ответ, Контекст, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Завершить(Ответ, Контекст, Раздел, КукиЗапроса,
		Пульт.ПрименитьПоправку(Контекст.Пользователь, Раздел.Владелец, Действие, Идентификатор, Форма),
		?(НРег(Действие) = "сузить", "сузить", ""), Идентификатор, Форма);

КонецФункции

// Дверь окна «Получатели» подписки: GET — раздел с окном на всём дереве, на странице ветки или
// на найденном (их же берёт скрипт кита); POST — правки окна, удача — 303 обратно в окно.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  Раздел - Структура - описание раздела (см. ОписаниеРаздела).
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  Идентификатор - Строка - идентификатор подписки из адреса.
//  ВидДерева - Структура - что показать на GET (см. ВидДерева).
//
// Возвращаемое значение:
//  Структура, Неопределено - показ раздела с окном; Неопределено — ответ уже записан.
//
Функция ПоказПолучателей(Ответ, Знач Контекст, Знач Раздел, Знач КукиЗапроса, Знач МетодЗапроса,
	Знач ТелоЗапроса, Знач Идентификатор, Знач ВидДерева) Экспорт

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Возврат ОкноДерева(Ответ, Контекст, Раздел, КукиЗапроса, "получатели", Идентификатор, ВидДерева);
	КонецЕсли;
	Форма = Гейт.ПринятаяФорма(Ответ, Контекст, "GET, POST", МетодЗапроса, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ПослеГалок(Ответ, Контекст, Раздел, КукиЗапроса, ТелоЗапроса, "получатели", Идентификатор,
		Пульт.ПрименитьДерево(Контекст.Пользователь, Раздел.Владелец, Идентификатор, ТелоЗапроса));

КонецФункции

// Дверь окна «Пакеты пула» поправки пула к подписке хаба — так же, как ПоказПолучателей.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  Раздел - Структура - описание раздела пула (см. ОписаниеРаздела).
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  Идентификатор - Строка - идентификатор подписки хаба сверху из адреса.
//  ВидДерева - Структура - что показать на GET (см. ВидДерева).
//
// Возвращаемое значение:
//  Структура, Неопределено - показ раздела с окном; Неопределено — ответ уже записан.
//
Функция ПоказПакетовПула(Ответ, Знач Контекст, Знач Раздел, Знач КукиЗапроса, Знач МетодЗапроса,
	Знач ТелоЗапроса, Знач Идентификатор, Знач ВидДерева) Экспорт

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Возврат ОкноДерева(Ответ, Контекст, Раздел, КукиЗапроса, "пакеты", Идентификатор, ВидДерева);
	КонецЕсли;
	Форма = Гейт.ПринятаяФорма(Ответ, Контекст, "GET, POST", МетодЗапроса, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ПослеГалок(Ответ, Контекст, Раздел, КукиЗапроса, ТелоЗапроса, "пакеты", Идентификатор,
		Пульт.ПрименитьДеревоПоправки(Контекст.Пользователь, Раздел.Владелец, Идентификатор, ТелоЗапроса));

КонецФункции

// Что окно дерева показывает: всё дерево, страницу ветки (её ключ и номер с единицы) или найденное.
//
// Параметры:
//  Найти - Строка - строка поиска; короче двух знаков — не ищет.
//  Ветка - Строка - ключ ветки, чья страница показана; "" — всё дерево.
//  Страница - Строка, Число - номер страницы ветки.
//
// Возвращаемое значение:
//  Структура - Найти, Ветка, Страница (Число, не меньше 1).
//
Функция ВидДерева(Знач Найти, Знач Ветка, Знач Страница) Экспорт
	Номер = Числа_.ЦелоеИлиНеопределено(Строка(Страница));
	Возврат Новый Структура("Найти, Ветка, Страница", СокрЛП(Строка(Найти)), СокрЛП(Строка(Ветка)),
		?(Номер = Неопределено ИЛИ Номер < 1, 1, Номер));
КонецФункции

// Пустой показ раздела: с чем страница выводится, когда ничего не происходило.
//
// Параметры:
//  Контекст - Структура - Пользователь и Сессия запроса.
//
// Возвращаемое значение:
//  Структура - Зритель, Окно, Сохранено, Ошибка, Сообщение, ВидСообщения, НовыйСекрет, ВидДерева
//              (что показывает окно дерева, см. ВидДерева), Проба, Предпросмотр, ДоставкаРаскрыта, Статус.
//
Функция Показ(Знач Контекст) Экспорт
	Возврат Новый Структура("Зритель, Окно, Сохранено, Ошибка, Сообщение, ВидСообщения, НовыйСекрет,
		|ВидДерева, Проба, Предпросмотр, ДоставкаРаскрыта, Статус",
		Контекст.Пользователь, Неопределено, Ложь, "", "", "", "", ВидДерева("", "", 1), Неопределено,
		Неопределено, Ложь, 200);
КонецФункции

// Уведомления страницы раздела подписок.
//
// Параметры:
//  Показ - Структура - показ раздела.
//
// Возвращаемое значение:
//  Массив - уведомления для модели дома.
//
Функция Уведомления(Знач Показ) Экспорт

	Результат = Ответы.УведомленияРаздела(Показ.Сохранено, Показ.Ошибка);
	Если ЗначениеЗаполнено(Показ.Сообщение) Тогда
		Результат.Добавить(Ответы.Уведомление(Показ.Сообщение, Показ.ВидСообщения));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Параметры ВитриныПодписок: что показывает раздел и что ему разрешено.
//
// Параметры:
//  Показ - Структура - показ раздела.
//  Раздел - Структура - описание раздела (см. ОписаниеРаздела).
//  Токен - Строка - CSRF-токен сессии.
//  Пояснение - Строка - что настраивает раздел у этого дома.
//  МожноМенять - Булево - показывать ли органы правки.
//  АдресТегов - Строка - раздел «Теги» объекта; "" — у хаба (необязательный, по умолчанию "").
//  ПослеСписка - ЭлементЭкрана, Неопределено - что дом кладёт в секцию под реестром
//                (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - параметры ВитриныПодписок.
//
Функция ПараметрыВитрины(Знач Показ, Знач Раздел, Знач Токен, Знач Пояснение, Знач МожноМенять,
	Знач АдресТегов = "", Знач ПослеСписка = Неопределено) Экспорт

	Результат = ОбщиеПараметры(Показ, Раздел, Токен, МожноМенять, АдресТегов);
	Результат.Вставить("Пояснение", Пояснение);
	Результат.Вставить("НовыйСекрет", Показ.НовыйСекрет);
	Результат.Вставить("Проба", Показ.Проба);
	Результат.Вставить("Предпросмотр", Показ.Предпросмотр);
	Результат.Вставить("ПослеСписка", ПослеСписка);
	Возврат Результат;

КонецФункции

// Параметры ВитриныПодписокСверху: подписки хаба и пула, которые объект вправе сузить.
//
// Параметры:
//  Показ - Структура - показ раздела.
//  Раздел - Структура - описание раздела (см. ОписаниеРаздела).
//  Токен - Строка - CSRF-токен сессии.
//  ИмяПула - Строка - пул объекта: им называется подписка пула без названия.
//  МожноМенять - Булево - показывать ли органы поправки.
//  АдресТегов - Строка - раздел «Теги» объекта.
//
// Возвращаемое значение:
//  Структура - параметры ВитриныПодписокСверху.
//
Функция ПараметрыВитриныСверху(Знач Показ, Знач Раздел, Знач Токен, Знач ИмяПула, Знач МожноМенять,
	Знач АдресТегов) Экспорт

	Результат = ОбщиеПараметры(Показ, Раздел, Токен, МожноМенять, АдресТегов);
	Результат.Вставить("ИмяПула", ИмяПула);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Исход пульта → ответ: удача — 303 на раздел (секрет — страница с его окном: в адрес он не
// попадает); отказ — страница с окном этой формы, открытым на набранном и отказах; окна нет
// (тумблер, снятие поправки, запись удалена) — отказ тостом раздела; чужая подписка — 404.
Функция Завершить(Ответ, Знач Контекст, Знач Раздел, Знач КукиЗапроса, Знач Исход, Знач ВидОкна,
	Знач Идентификатор, Знач Форма)

	Если Исход.НеНайдено Тогда
		ОтдатьНеНайдено(Ответ, Контекст, КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Показ = Показ(Контекст);
	Если Исход.Успех Тогда
		Если НЕ ЗначениеЗаполнено(Исход.Секрет) Тогда
			Окна.ВернутьВРаздел(Ответ, Раздел.Адрес);
			Возврат Неопределено;
		КонецЕсли;
		Показ.НовыйСекрет = Исход.Секрет;
		Возврат Показ;
	КонецЕсли;

	Показ.Статус = Исход.Код;
	// отказ у поля в окне уже назван — второй раз над шагами его не повторяют
	Окно = Окна.Отбитое(ВидОкна, КлючОкна(Идентификатор), Форма, Исход.Отказы,
		?(Исход.Отказы.Количество() > 0, "", Исход.Сообщение));
	Если ЗначениеЗаполнено(ВидОкна) И ЕстьОкно(Контекст, Раздел, Окно) Тогда
		Показ.Окно = Окно;
	Иначе
		Показ.Ошибка = Исход.Сообщение;
	КонецЕсли;
	Возврат Показ;

КонецФункции

// Окно печатается тому, кто вправе распоряжаться подписками объекта, и только у записи, что есть.
Функция ЕстьОкно(Знач Контекст, Знач Раздел, Знач Окно)

	Если НЕ СервисПодписок.МожетУправлять(Контекст.Пользователь, Раздел.Владелец) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Витрина.ЕстьОкно(Раздел.Владелец, Окно) ИЛИ ВитринаСверху.ЕстьОкно(Раздел.Владелец, Окно);

КонецФункции

// Пролог мутирующих точек записи: только POST и только с токеном сессии.
Функция ФормаМутации(Ответ, Знач Контекст, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)
	Возврат Гейт.ПринятаяФорма(Ответ, Контекст, "POST", МетодЗапроса, ТелоЗапроса, КукиЗапроса);
КонецФункции

// Окно дерева на GET: есть только у подписки, чьё окно раздел печатает; иначе — 404.
Функция ОкноДерева(Ответ, Знач Контекст, Знач Раздел, Знач КукиЗапроса, Знач Вид, Знач Идентификатор,
	Знач ВидДерева)

	Показ = Показ(Контекст);
	Показ.Окно = Окна.Открытое(Вид, КлючОкна(Идентификатор));
	Показ.ВидДерева = ВидДерева;
	Если НЕ ЕстьОкно(Контекст, Раздел, Показ.Окно) Тогда
		ОтдатьНеНайдено(Ответ, Контекст, КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;
	Возврат Показ;

КонецФункции

// После правок окна дерева — 303 обратно в окно (с тем же поиском — на дверь окна с ним): повтор
// страницы правку не повторит, а тихая отправка кладёт ответ на место. Форма старой вкладки —
// отказ тостом раздела без окна; отказ домена — окно с причиной.
Функция ПослеГалок(Ответ, Знач Контекст, Знач Раздел, Знач КукиЗапроса, Знач ТелоЗапроса, Знач Вид,
	Знач Идентификатор, Знач Исход)

	Если Исход.НеНайдено Тогда
		ОтдатьНеНайдено(Ответ, Контекст, КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Поиск = Пульт.ПоискВДереве(ТелоЗапроса);
	Если Исход.Успех Тогда
		ВернутьВОкноДерева(Ответ, Раздел, Вид, Идентификатор, Поиск);
		Возврат Неопределено;
	КонецЕсли;

	Показ = Показ(Контекст);
	Показ.Статус = Исход.Код;
	Если Исход.Устарела Тогда
		Показ.Ошибка = Исход.Сообщение;
		Возврат Показ;
	КонецЕсли;
	Показ.Окно = Окна.Отбитое(Вид, КлючОкна(Идентификатор), Неопределено, Неопределено, Исход.Сообщение);
	Показ.ВидДерева = ВидДерева(Поиск, "", 1);
	Возврат Показ;

КонецФункции

// 303 в окно дерева с отметкой «сохранено»: без поиска — раздел с ?окно=…, с поиском — дверь окна
// с ?найти=….
Процедура ВернутьВОкноДерева(Ответ, Знач Раздел, Знач Вид, Знач Идентификатор, Знач Поиск)

	Ключ = КлючОкна(Идентификатор);
	Пары = Новый Соответствие();
	Если НЕ ЗначениеЗаполнено(Поиск) Тогда
		Пары.Вставить(Окна.ИмяПараметра(), Вид + "-" + Ключ);
		Окна.ВернутьВРазделСПарами(Ответ, Раздел.Адрес, Пары);
		Возврат;
	КонецЕсли;
	Пары.Вставить(Имена.ИмяПоляПоиска(), Поиск);
	Окна.ВернутьВРазделСПарами(Ответ,
		ОкноПолучателей.АдресДвери(Раздел.Адрес, Ключ, Вид = ОкноПолучателей.ВидОкна(Истина)), Пары);

КонецПроцедуры

// Окно формы, пришедшей на адрес пробы или предпросмотра: у подписки — её правка, без неё — новая.
Функция ВидОкнаФормы(Знач Идентификатор)
	Возврат ?(ЗначениеЗаполнено(КлючОкна(Идентификатор)), "изменить", "новая");
КонецФункции

Функция КлючОкна(Знач Идентификатор)
	Возврат СокрЛП(Строка(Идентификатор));
КонецФункции

Процедура ОтдатьНеНайдено(Ответ, Знач Контекст, Знач КукиЗапроса)
	Ответы.ОтдатьНеНайдено(Ответ, Контекст, Тексты.Текст("subscriptions.error.notfound"),
		КукиЗапроса);
КонецПроцедуры

// Ответ скрипту страницы: только кусок разметки, который он вставит на место.
Процедура ОтдатьКусочек(Ответ, Знач Кусочек, Знач Статус)
	Заголовки.ЗакрытьСтраницу(Ответ);
	Ответ.УстановитьСостояние(Статус);
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Кусочек.Рендер();
КонецПроцедуры

Функция ОбщиеПараметры(Знач Показ, Знач Раздел, Знач Токен, Знач МожноМенять, Знач АдресТегов)

	Результат = Новый Структура();
	Результат.Вставить("Объект", Раздел.Владелец);
	Результат.Вставить("Адрес", Раздел.Адрес);
	Результат.Вставить("Токен", Токен);
	Результат.Вставить("МожноМенять", МожноМенять);
	Результат.Вставить("АдресТегов", АдресТегов);
	Результат.Вставить("Окно", Показ.Окно);
	Результат.Вставить("Зритель", Показ.Зритель);
	Результат.Вставить("ВидДерева", Показ.ВидДерева);
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ХодПодписок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "ПультПодписок") _Пульт,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ВитринаПодписок") _Витрина,
	&Пластилин(Значение = "ВитринаПодписокСверху") _ВитринаСверху,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "ПроверкаПодпискиДоСохранения") _Проверка,
	&Пластилин(Значение = "ЗаголовкиКэша") _Заголовки,
	&Пластилин(Значение = "ОкноПолучателей") _ОкноПолучателей,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа = Неопределено) Экспорт

	Ответы = _Ответы;
	Тексты = _Тексты;
	Гейт = _Гейт;
	Пульт = _Пульт;
	Окна = _Окна;
	Витрина = _Витрина;
	ВитринаСверху = _ВитринаСверху;
	СервисПодписок = _СервисПодписок;
	Имена = _Имена;
	Проверка = _Проверка;
	Заголовки = _Заголовки;
	ОкноПолучателей = _ОкноПолучателей;
	Числа_ = ?(_Числа = Неопределено, Новый ПриведениеЧисел(), _Числа);

КонецПроцедуры
