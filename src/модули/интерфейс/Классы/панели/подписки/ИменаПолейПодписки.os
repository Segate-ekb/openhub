// Имена HTML-полей раздела «Подписки»: разметка печатает эти имена, разбор формы читает их же.

Перем Защита;  // ЗащитаCSRF (вход) — владелец имени поля токена
Перем Числа;   // ПриведениеЧисел (основа) — номер узла дерева из строки формы

#Область ПубличныйИнтерфейс

// Имя поля-селектора типа действия.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляТипа() Экспорт
	Возврат "тип_действия";
КонецФункции

// Имя параметра адреса, которым выбирается тип действия в форме заведения.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПараметраТипа() Экспорт
	Возврат "kind";
КонецФункции

// Имя поля-флажка для типа события по его индексу в СервисПодписок.ИзвестныеТипы().
//
// Параметры:
//  Индекс - Число - позиция типа в перечне.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляСобытия(Знач Индекс) Экспорт
	Возврат ПрефиксСобытия() + Формат(Индекс, "ЧГ=0; ЧН=0");
КонецФункции

// Имя поля-параметра типа события по его индексу в СервисПодписок.ИзвестныеТипы().
// Параметр показывается рядом со своим флажком, поэтому индекс у них общий.
//
// Параметры:
//  Индекс - Число - позиция типа в перечне.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляПараметраСобытия(Знач Индекс) Экспорт
	Возврат ПрефиксПараметраСобытия() + Формат(Индекс, "ЧГ=0; ЧН=0");
КонецФункции

// Значение отмеченного флажка события (РазборФормы.Флажок читает сравнением).
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеОтмечено() Экспорт
	Возврат "1";
КонецФункции

// Имя поля-тумблера «включить/выключить подписку» (скрытое поле кнопки в списке
// и флажок «активна» в форме правки).
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляВключить() Экспорт
	Возврат "включить";
КонецФункции

// Имя поля названия подписки.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляНазвания() Экспорт
	Возврат "название";
КонецФункции

// Имя галки тега в отборе — у подписки и у поправки к подписке сверху.
//
// Параметры:
//  ИмяТега - Строка - имя тега.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляТега(Знач ИмяТега) Экспорт
	Возврат ПрефиксТега() + НРег(СокрЛП(ИмяТега));
КонецФункции

// Имя тега по имени его галки: обратное к ИмяПоляТега.
//
// Параметры:
//  ИмяПоля - Строка - имя поля формы.
//
// Возвращаемое значение:
//  Строка - имя тега; пустая, если поле — не галка тега.
//
Функция ИмяТегаИзПоля(Знач ИмяПоля) Экспорт
	Поле = Ключ(ИмяПоля);
	Возврат ?(СтрНачинаетсяС(Поле, ПрефиксТега()), Сред(Поле, СтрДлина(ПрефиксТега()) + 1), "");
КонецФункции

// Имя флажка «нижестоящие могут сузить».
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляСужения() Экспорт
	Возврат "сужение_снизу";
КонецФункции

// Имя флажка поправки «не присылать для меня».
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляНеПрисылать() Экспорт
	Возврат "не_присылать";
КонецФункции

// Имя параметра адреса, которым карточка подписки открывает дерево получателей.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПараметраДерева() Экспорт
	Возврат "recipients";
КонецФункции

// Имя параметра адреса с поиском пакета в дереве получателей.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПараметраПоиска() Экспорт
	Возврат "find";
КонецФункции

// Имя параметра адреса, с которым предпросмотр и проба отвечают кусочком для скрипта страницы,
// а не страницей. Совпадает с именем параметра точек маршрута.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПараметраКусочка() Экспорт
	Возврат "fragment";
КонецФункции

// Имя скрытого поля формы дерева: узлы, которые форма показала, — галки только их и касаются.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляПоказанныхУзлов() Экспорт
	Возврат "показанные_узлы";
КонецФункции

// Имя флажка узла дерева получателей.
//
// Параметры:
//  ТипУзла - Строка - "пул" | "пакет".
//  Идентификатор - Число - идентификатор пула или пакета.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляУзла(Знач ТипУзла, Знач Идентификатор) Экспорт
	Возврат ПрефиксУзла() + КлючУзла(ТипУзла, Идентификатор);
КонецФункции

// Узел дерева получателей одной строкой — так он лежит в перечне показанных узлов.
//
// Параметры:
//  ТипУзла - Строка - "пул" | "пакет".
//  Идентификатор - Число - идентификатор пула или пакета.
//
// Возвращаемое значение:
//  Строка - «<тип>_<идентификатор>».
//
Функция КлючУзла(Знач ТипУзла, Знач Идентификатор) Экспорт
	Возврат Ключ(ТипУзла) + "_" + Формат(Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

// Узел из строки перечня показанных узлов: обратное к КлючУзла.
//
// Параметры:
//  Запись - Строка - «<тип>_<идентификатор>».
//
// Возвращаемое значение:
//  Структура, Неопределено - ТипУзла (Строка), Идентификатор (Число); Неопределено, если строка
//  узла не называет.
//
Функция РазобратьКлючУзла(Знач Запись) Экспорт

	Текст = Ключ(Запись);
	Позиция = СтрНайти(Текст, "_", НаправлениеПоиска.СКонца);
	Номер = ?(Позиция < 2, Неопределено, Числа.ЦелоеИлиНеопределено(Сред(Текст, Позиция + 1)));
	Если Номер = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("ТипУзла, Идентификатор", Лев(Текст, Позиция - 1), Номер);

КонецФункции

// Имя флажка «секрет у подписки свой» для секретного поля типа: он отличает «очистить»
// от «оставить прежний».
//
// Параметры:
//  ИмяПоля - Строка - имя поля формы секрета (ОписаниеПолей.ИмяПоля).
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляСвоегоСекрета(Знач ИмяПоля) Экспорт
	Возврат Строка(ИмяПоля) + СуффиксСвоего();
КонецФункции

// Маска сохранённого секрета в форме правки: значение секрета в разметку не выходит,
// а поле обязано отличаться от пустого «секрета нет».
//
// Возвращаемое значение:
//  Строка.
//
Функция МаскаСекрета() Экспорт
	Возврат "•••";
КонецФункции

// Занято ли имя самим разделом: такое имя тип действия объявить не вправе.
//
// Параметры:
//  Имя - Строка - имя поля формы.
//
// Возвращаемое значение:
//  Булево.
//
Функция Служебное(Знач Имя) Экспорт

	Ключ = Ключ(Имя);
	Возврат Ключ = Ключ(Защита.ИмяПоля())
		ИЛИ Ключ = Ключ(ИмяПоляВключить())
		ИЛИ Ключ = Ключ(ИмяПоляТипа())
		ИЛИ Ключ = Ключ(ИмяПоляНазвания())
		ИЛИ Ключ = Ключ(ИмяПоляСужения())
		ИЛИ Ключ = Ключ(ИмяПоляНеПрисылать())
		ИЛИ Ключ = Ключ(ИмяПоляПоказанныхУзлов())
		ИЛИ Ключ = Ключ(ИмяПараметраПоиска())
		ИЛИ СтрНачинаетсяС(Ключ, Ключ(ПрефиксУзла()))
		ИЛИ СтрНачинаетсяС(Ключ, Ключ(ПрефиксТега()))
		ИЛИ СтрНачинаетсяС(Ключ, Ключ(ПрефиксСобытия()))
		ИЛИ СтрНачинаетсяС(Ключ, Ключ(ПрефиксПараметраСобытия()));

КонецФункции

// Имя поля в сравнимом виде: регистр и пробелы значения не несут.
//
// Параметры:
//  Значение - Строка - имя поля.
//
// Возвращаемое значение:
//  Строка.
//
Функция Ключ(Знач Значение) Экспорт
	Возврат НРег(СокрЛП(Строка(Значение)));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Префикс имён флажков событий: служебной считается вся группа, а не отдельный индекс.
Функция ПрефиксСобытия()
	Возврат "событие_";
КонецФункции

// Префикс имён параметров событий — та же причина, что и у флажков.
Функция ПрефиксПараметраСобытия()
	Возврат "параметр_события_";
КонецФункции

// Префикс имён галок тегов отбора — служебная вся группа.
Функция ПрефиксТега()
	Возврат "отбор_тега_";
КонецФункции

// Префикс имён флажков узлов дерева получателей — служебная вся группа.
Функция ПрефиксУзла()
	Возврат "получатель_";
КонецФункции

// Суффикс имени поля формы для флажка «секрет свой»; во вводе ему отвечает «<Имя>Свой».
Функция СуффиксСвоего()
	Возврат "-свой";
КонецФункции

#КонецОбласти

&Прозвище("ИменаПолейПодписки")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа = Неопределено) Экспорт

	Защита = _Защита;
	Числа = ?(_Числа = Неопределено, Новый ПриведениеЧисел(), _Числа);

КонецПроцедуры
