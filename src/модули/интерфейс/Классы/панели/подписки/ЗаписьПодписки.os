// Запись подписки в реестре раздела — своей и сверху. Свёрнутая: значок канала, имя, плашки
// состояния, сколько событий и кому; раскрытая — свойствами. Справа тумблер, все действия — одним
// набором: кит печатает из него и меню ⚙, и кнопки внизу раскрытой записи.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем СервисПодписок;    // СервисПодписок (подписки) — тип, правка и проба подписки
Перем ПараметрыПодписки; // ПараметрыПодписки (подписки) — название, отбор и разрешение сужать
Перем Поправки;          // СервисПоправокПодписок (подписки) — поправки снизу и оставленные события
Перем Исключения;        // СервисИсключенийПодписок (подписки) — есть ли у подписки получатели
Перем Каталог;           // КаталогДействийПодписки — подпись и значок канала
Перем ПоляСобытий;       // ПоляСобытийПодписки — подписи событий
Перем ОтборТегов;        // ОтборТеговПодписки — действующий отбор и выпавшие теги
Перем Получатели;        // ПолучателиЗаписи — кому подписка сообщает и отметки плашками
Перем Сузившие;          // ПоправкиНижестоящих — кто сузил подписку снизу
Перем Срезы;             // СрезПодписок — что запись берёт из среза страницы
Перем Окна;              // ОкноРаздела — адреса окон записи
Перем Имена;             // ИменаПолейПодписки — имена полей форм записи
Перем ИменаПодписок;     // ИменаПодписок — имя и ключ подписки
Перем Счёт;              // СчётСловами — число с существительным
Перем ЧерезЗапятую;      // СписокЧерезЗапятую (основа)

#Область ПубличныйИнтерфейс

// Запись своей подписки объекта.
//
// Параметры:
//  Параметры - Структура - параметры ВитриныПодписок: Объект, Адрес, МожноМенять.
//  Подписка - Вебхук - подписка объекта.
//  Срез - Структура - срез своих подписок страницы (СрезПодписок.Своих): запись домен не спрашивает.
//
// Возвращаемое значение:
//  ЭлементЭкрана - запись реестра.
//
Функция Своя(Знач Параметры, Знач Подписка, Знач Срез) Экспорт

	Свойства = ПараметрыПодписки.Свойства(Подписка);
	Тип = СервисПодписок.ТипДействияПодписки(Подписка);
	МожноМенять = (Параметры.МожноМенять = Истина);
	Сузили = Срезы.ПоправкиПодписки(Срез, Подписка).Количество();
	Сводка = ?(МожноМенять И Срез.Исключено <> Неопределено, Срез.Исключено.Получить(Цел(Подписка.Идентификатор)),
		Неопределено);
	КомуСообщает = Получатели.КомуСообщает(Подписка, Сводка);

	Запись = Кит.ЗаписьРеестра(ИменаПодписок.Своей(Подписка),
			ПодробностиСвоей(Подписка, Тип, Свойства, Сузили, КомуСообщает, Срез, Сводка),
			Сузившие.Блок(Подписка, Срез))
		.Значок(Каталог.ЗначокТипа(Тип))
		.Подпись(ПодписьСвоей(Подписка, Тип, Свойства))
		.Факт(Тексты.Текст("subscriptions.fact.events"), Формат(ЧислоСобытий(Подписка), "ЧГ=0"))
		.Действия(Тумблер(Подписка, МожноМенять));

	Если Подписка.Активен <> Истина Тогда
		Запись.Плашка(Тексты.Текст("subscriptions.state.off"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Строка(Подписка.ШаблонТекста)) Тогда
		Запись.Плашка(Тексты.Текст("subscriptions.list.tag.own-text"));
	КонецЕсли;
	Если Сузили > 0 И НЕ Свойства.СужениеРазрешено Тогда
		Запись.Плашка(Кит.Плашка(Тексты.Текст("subscriptions.brief.sign.dormant")).Вид("warn"));
	КонецЕсли;
	Если ЗначениеЗаполнено(КомуСообщает) Тогда
		Запись.Факт(Тексты.Текст("subscriptions.fact.recipients"), КомуСообщает);
	КонецЕсли;
	Если МожноМенять Тогда
		Запись.Кнопки(
			КнопкаПравки(Параметры, Подписка),
			КнопкаПолучателей(Параметры, Подписка),
			ФормаПробы(Подписка),
			Кит.ОкноПоАдресу(Окна.Адрес(Параметры.Адрес, "удалить", ИменаПодписок.Ключ(Подписка)),
				Тексты.Текст("subscriptions.button.delete")).Опасная().Иконка("корзина"));
	КонецЕсли;
	Возврат Запись;

КонецФункции

// Запись подписки сверху у нижестоящего объекта: адреса, чата, токена и шаблона в ней нет.
//
// Параметры:
//  Параметры - Структура - параметры ВитриныПодписокСверху: Объект, Адрес, ИмяПула, МожноМенять.
//  Подписка - Вебхук - подписка хаба или пула.
//  Срез - Структура - срез подписок сверху страницы (СрезПодписок.Сверху): поправка объекта, пакеты,
//         снятые ею, и сводка получателей в пуле — оттуда.
//
// Возвращаемое значение:
//  ЭлементЭкрана - запись реестра.
//
Функция Сверху(Знач Параметры, Знач Подписка, Знач Срез) Экспорт

	Поправка = Срезы.ПоправкаОбъекта(Срез, Подписка);
	Тип = СервисПодписок.ТипДействияПодписки(Подписка);
	МожноМенять = (Параметры.МожноМенять = Истина);
	Оставленные = Поправки.ОставленныеСобытия(Подписка, Поправка);
	ПакетыПула = МожноМенять И НРег(СокрЛП(Строка(Параметры.Объект.ТипОбъекта))) = "пул"
		И НРег(СокрЛП(Строка(Подписка.ТипОбъекта))) = "хаб";

	Запись = Кит.ЗаписьРеестра(ИменаПодписок.Сверху(Подписка, Параметры.ИмяПула),
			ПодробностиСверху(Подписка, Тип, Поправка, Оставленные, Срез))
		.Значок(Каталог.ЗначокТипа(Тип))
		.Плашка(Кит.Плашка(Тексты.Текст("subscriptions.above.badge")).Вид("accent"))
		.Подпись(Тексты.Шаблон("subscriptions.above.caption",
			ИменаПодписок.Хозяин(Подписка, Параметры.ИмяПула), ПодписиСобытий(Оставленные)));

	Если Подписка.Активен <> Истина Тогда
		Запись.Плашка(Тексты.Текст("subscriptions.state.off"));
	КонецЕсли;
	Если Поправка <> Неопределено Тогда
		Запись.Плашка(Кит.Плашка(?(Поправка.НеПрисылать = Истина, Тексты.Текст("subscriptions.above.state.muted"),
			Тексты.Текст("subscriptions.above.state.narrowed"))).Вид("warn"));
	КонецЕсли;
	Если МожноМенять Тогда
		Запись.Кнопки(
			ФормаПрисылать(Подписка, Поправка, Оставленные),
			Кит.ОкноПоАдресу(Окна.Адрес(Параметры.Адрес, "сузить", ИменаПодписок.Ключ(Подписка)),
				Тексты.Текст("subscriptions.above.button.narrow")).Основная().Иконка("карандаш"),
			?(ПакетыПула, Кит.ОкноПоАдресу(Окна.Адрес(Параметры.Адрес, "пакеты", ИменаПодписок.Ключ(Подписка)),
				Тексты.Текст("subscriptions.above.button.packages")).Вторичная().Иконка("стопка"), Неопределено),
			ФормаСнятия(Подписка, Поправка));
	КонецЕсли;
	Возврат Запись;

КонецФункции

// Подписи событий через запятую: «опубликована, отозвана».
//
// Параметры:
//  Типы - Массив из Строка - типы событий.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПодписиСобытий(Знач Типы) Экспорт

	Подписи = Новый Массив();
	Для Каждого Тип Из Типы Цикл
		Подписи.Добавить(ПоляСобытий.ПодписьТипа(Тип));
	КонецЦикла;
	Возврат СтрСоединить(Подписи, ", ");

КонецФункции

#КонецОбласти

#Область Своя

// Способ доставки, а у подписки с названием — ещё и адрес: без названия адрес уже стоит именем.
Функция ПодписьСвоей(Знач Подписка, Знач Тип, Знач Свойства)

	Способ = Каталог.ПодписьТипа(Тип);
	Если НЕ ЗначениеЗаполнено(Свойства.Название) Тогда
		Возврат Способ;
	КонецЕсли;
	Возврат Тексты.Шаблон("subscriptions.caption.where", Способ, Строка(Подписка.URL));

КонецФункции

Функция ПодробностиСвоей(Знач Подписка, Знач Тип, Знач Свойства, Знач Сузили, Знач КомуСообщает, Знач Срез,
	Знач Сводка)

	Отбор = ОтборТегов.Отбор(Подписка, Свойства.ОтборТегов, Срез.ТегиОбъектов);
	Возврат Кит.Свойства(
		Кит.Свойство(Тексты.Текст("subscriptions.prop.where"),
			Каталог.ПодписьТипа(Тип) + " · ", Кит.Код(Строка(Подписка.URL))),
		Кит.Свойство(Тексты.Текст("subscriptions.prop.events"),
			ПлашкиСобытий(ЧерезЗапятую.Разобрать(Подписка.ТипыСобытий))),
		СвойствоТегов(Подписка, Отбор),
		Кит.Свойство(Тексты.Текст("subscriptions.prop.recipients"), КомуСообщает,
				Получатели.Плашки(Подписка, Сводка, Срез.Пулы, Срез.Пакеты))
			.Когда(ЗначениеЗаполнено(КомуСообщает)),
		СвойствоСнизу(Подписка, Свойства.СужениеРазрешено, Сузили));

КонецФункции

// Сужение снизу одной строкой: можно ли и сколько объектов сузили; у пакета нижестоящих нет.
Функция СвойствоСнизу(Знач Подписка, Знач Разрешено, Знач Сузили)

	Если ЭтоПакет(Подписка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Сузили > 0 Тогда
		Значение = Тексты.Шаблон("subscriptions.brief.below.narrowed",
			Счёт.Счёт(Сузили, Тексты.Текст("subscriptions.count.objects")));
	ИначеЕсли Разрешено Тогда
		Значение = Тексты.Текст("subscriptions.brief.below.allowed");
	Иначе
		Значение = Тексты.Текст("subscriptions.prop.below.closed");
	КонецЕсли;
	Возврат Кит.Свойство(Тексты.Текст("subscriptions.prop.below"), Значение);

КонецФункции

// Тумблер сохраняется сразу (без скрипта форму шлёт запасная кнопка кита); без права
// распоряжаться он показан, но не переключается.
Функция Тумблер(Знач Подписка, Знач МожноМенять)

	Подпись = Тексты.Шаблон("subscriptions.toggle.label", ИменаПодписок.Своей(Подписка));
	Если НЕ МожноМенять Тогда
		Возврат Кит.Тумблер("", Подпись).Включено(Подписка.Активен = Истина).Заблокировано();
	КонецЕсли;

	Возврат Кит.Форма(ИменаПодписок.Ключ(Подписка) + "/toggle",
			Кит.Тумблер(Имена.ИмяПоляВключить(), Подпись).Включено(Подписка.Активен = Истина)
				.Значения(Имена.ЗначениеОтмечено(), "0").СохранятьСразу())
		.БезПерезагрузки();

КонецФункции

// Тип, который правку не поддерживает, окна правки не получает: подписку можно только выключить
// или удалить.
Функция КнопкаПравки(Знач Параметры, Знач Подписка)

	Если НЕ СервисПодписок.МожноПравить(Подписка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.ОкноПоАдресу(Окна.Адрес(Параметры.Адрес, "изменить", ИменаПодписок.Ключ(Подписка)),
		Тексты.Текст("subscriptions.button.edit")).Основная().Иконка("карандаш");

КонецФункции

// Получатели — окно по адресу: пулы с режимом и пакеты галками, правки без перезагрузки.
Функция КнопкаПолучателей(Знач Параметры, Знач Подписка)

	Если НЕ Исключения.ЕстьДерево(Подписка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.ОкноПоАдресу(Окна.Адрес(Параметры.Адрес, "получатели", ИменаПодписок.Ключ(Подписка)),
		Тексты.Текст("subscriptions.button.recipients")).Вторичная().Иконка("стопка");

КонецФункции

// Проба сохранёнными настройками — форма из одной кнопки: итог ложится тостом в раздел.
Функция ФормаПробы(Знач Подписка)

	Если НЕ СервисПодписок.МожноПробовать(Подписка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Форма(ИменаПодписок.Ключ(Подписка) + "/test",
			Кит.Кнопка(Тексты.Текст("subscriptions.button.test")).Вторичная().Иконка("конверт"))
		.БезПерезагрузки();

КонецФункции

Функция ЧислоСобытий(Знач Подписка)
	Возврат ЧерезЗапятую.Разобрать(Подписка.ТипыСобытий).Количество();
КонецФункции

#КонецОбласти

#Область Сверху

Функция ПодробностиСверху(Знач Подписка, Знач Тип, Знач Поправка, Знач Оставленные, Знач Срез)

	Свойства = ПараметрыПодписки.Свойства(Подписка);
	Возврат Кит.Свойства(
		Кит.Свойство(Тексты.Текст("subscriptions.prop.channel"), Каталог.ПодписьТипа(Тип)),
		Кит.Свойство(Тексты.Текст("subscriptions.prop.events"), ПлашкиСобытий(Оставленные)),
		СвойствоТегов(Подписка, ОтборТегов.Отбор(Подписка, Свойства.ОтборТегов, Срез.ТегиОбъектов)),
		СвойствоЗдесь(Подписка, Поправка, Оставленные, Срез));

КонецФункции

// Что поправка оставила объекту: не присылать вовсе, свой отбор по тегам и у пула — сколько своих
// пакетов он снял. Поправки нет — и строки нет.
Функция СвойствоЗдесь(Знач Подписка, Знач Поправка, Знач Оставленные, Знач Срез)

	Если Поправка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Поправка.НеПрисылать = Истина Тогда
		Возврат Кит.Свойство(Тексты.Текст("subscriptions.brief.here"), Тексты.Текст("subscriptions.narrowed.muted"));
	КонецЕсли;

	Части = Новый Массив();
	Если Оставленные.Количество() < СервисПодписок.СобытияДляНижестоящих(Подписка).Количество() Тогда
		Части.Добавить(Тексты.Шаблон("subscriptions.brief.here.events", ПодписиСобытий(Оставленные)));
	КонецЕсли;
	Теги = ОтборТегов.Отбор(Поправка, Поправка.ОтборТегов, Срез.ТегиОбъектов).Действующие;
	Если ЗначениеЗаполнено(Теги) Тогда
		Части.Добавить(Тексты.Шаблон("subscriptions.brief.here.tags", Теги));
	КонецЕсли;
	Исключено = Срезы.ИсключеноПакетов(Срез, Поправка);
	Если Исключено > 0 Тогда
		Части.Добавить(Тексты.Шаблон("subscriptions.brief.here.packages",
			Счёт.Счёт(Исключено, Тексты.Текст("subscriptions.count.packages"))));
	КонецЕсли;
	Если Части.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Свойство(Тексты.Текст("subscriptions.brief.here"), СтрСоединить(Части, "; "));

КонецФункции

// «Не присылать сюда» и обратно — форма из одной кнопки с желаемым состоянием: события и теги
// поправки едут с ней скрытыми полями и не теряются, повтор отправки состояние не переворачивает.
Функция ФормаПрисылать(Знач Подписка, Знач Поправка, Знач Оставленные)

	Заглушена = Поправка <> Неопределено И Поправка.НеПрисылать = Истина;
	Форма = Кит.Форма(АдресСверху(Подписка, "narrow"),
		?(Заглушена, Неопределено, Кит.СкрытоеПоле(Имена.ИмяПоляНеПрисылать(), Имена.ЗначениеОтмечено())));
	Известные = СервисПодписок.ИзвестныеТипы();
	Для Каждого Тип Из Оставленные Цикл
		Индекс = Известные.Найти(Тип);
		Если Индекс <> Неопределено Тогда
			Форма.Добавить(Кит.СкрытоеПоле(Имена.ИмяПоляСобытия(Индекс), Имена.ЗначениеОтмечено()));
		КонецЕсли;
	КонецЦикла;
	Если Поправка <> Неопределено Тогда
		Для Каждого Тег Из ЧерезЗапятую.Разобрать(Поправка.ОтборТегов) Цикл
			Форма.Добавить(Кит.СкрытоеПоле(Имена.ИмяПоляТега(Тег), Имена.ЗначениеОтмечено()));
		КонецЦикла;
	КонецЕсли;
	Форма.Добавить(Кит.Кнопка(?(Заглушена, Тексты.Текст("subscriptions.above.button.unmute"),
		Тексты.Текст("subscriptions.above.button.mute"))).Вторичная().Иконка(?(Заглушена, "галочка", "закрыть")));
	Возврат Форма.БезПерезагрузки();

КонецФункции

Функция ФормаСнятия(Знач Подписка, Знач Поправка)

	Если Поправка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Форма(АдресСверху(Подписка, "reset"),
			Кит.Кнопка(Тексты.Текст("subscriptions.above.button.reset")).Вторичная().Иконка("история"))
		.БезПерезагрузки();

КонецФункции

// Формы поправки постят на адрес подписки сверху внутри раздела: «inherited/<ключ>/<действие>».
Функция АдресСверху(Знач Подписка, Знач Действие)
	Возврат "inherited/" + ИменаПодписок.Ключ(Подписка) + "/" + Действие;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отбор по тегам: «все версии» или имена тегов; выпавшие из отбора — предупреждением.
Функция СвойствоТегов(Знач Запись, Знач Отбор)

	Если НРег(СокрЛП(Строка(Запись.ТипОбъекта))) = "хаб" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Свойство = Кит.Свойство(Тексты.Текст("subscriptions.prop.tags"),
		?(ЗначениеЗаполнено(Отбор.Действующие), Отбор.Действующие, Тексты.Текст("subscriptions.prop.tags.all")));
	Если ЗначениеЗаполнено(Отбор.Выпавшие) Тогда
		Свойство.Примечание(Тексты.Шаблон("subscriptions.prop.tags.dropped", Отбор.Выпавшие));
	КонецЕсли;
	Возврат Свойство;

КонецФункции

Функция ПлашкиСобытий(Знач Типы)

	Плашки = Кит.Холст();
	Для Каждого Тип Из Типы Цикл
		Плашки.Добавить(Кит.Плашка(ПоляСобытий.ПодписьТипа(Тип)));
	КонецЦикла;
	Возврат Плашки;

КонецФункции

Функция ЭтоПакет(Знач Подписка)
	Возврат НРег(СокрЛП(Строка(Подписка.ТипОбъекта))) = "пакет";
КонецФункции

#КонецОбласти

&Прозвище("ЗаписьПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "ПараметрыПодписки") _ПараметрыПодписки,
	&Пластилин(Значение = "СервисПоправокПодписок") _Поправки,
	&Пластилин(Значение = "СервисИсключенийПодписок") _Исключения,
	&Пластилин(Значение = "КаталогДействийПодписки") _Каталог,
	&Пластилин(Значение = "ПоляСобытийПодписки") _ПоляСобытий,
	&Пластилин(Значение = "ОтборТеговПодписки") _ОтборТегов,
	&Пластилин(Значение = "ПолучателиЗаписи") _Получатели,
	&Пластилин(Значение = "ПоправкиНижестоящих") _Сузившие,
	&Пластилин(Значение = "СрезПодписок") _Срезы,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "ИменаПодписок") _ИменаПодписок,
	&Пластилин(Значение = "СчётСловами") _Счёт,
	&Пластилин(Значение = "СписокЧерезЗапятую") _ЧерезЗапятую = Неопределено) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	СервисПодписок = _СервисПодписок;
	ПараметрыПодписки = _ПараметрыПодписки;
	Поправки = _Поправки;
	Исключения = _Исключения;
	Каталог = _Каталог;
	ПоляСобытий = _ПоляСобытий;
	ОтборТегов = _ОтборТегов;
	Получатели = _Получатели;
	Сузившие = _Сузившие;
	Срезы = _Срезы;
	Окна = _Окна;
	Имена = _Имена;
	ИменаПодписок = _ИменаПодписок;
	Счёт = _Счёт;
	ЧерезЗапятую = ?(_ЧерезЗапятую = Неопределено, Новый СписокЧерезЗапятую(), _ЧерезЗапятую);

КонецПроцедуры
