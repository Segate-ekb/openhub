// Поля общих свойств окна подписки: название и разрешение нижестоящим сузить подписку. Значение
// после отказа — присланное, иначе сохранённое у подписки.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем ПараметрыПодписки; // ПараметрыПодписки (подписки) — сохранённые свойства подписки
Перем Имена;             // ИменаПолейПодписки — имена полей раздела
Перем Окна;              // ОкноРаздела — набранное отбитой формы
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Поле названия подписки.
//
// Параметры:
//  Подписка - Вебхук, Неопределено - правимая подписка; Неопределено — новая.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  ЭлементЭкрана - поле.
//
Функция Название(Знач Подписка, Знач Состояние) Экспорт

	Имя = Имена.ИмяПоляНазвания();
	Возврат Кит.Поле(Имя, Тексты.Текст("subscriptions.form.name.label"))
		.Значение(Окна.Значение(Состояние, Имя, Сохранённые(Подписка).Название))
		.Пример(Тексты.Текст("subscriptions.form.name.placeholder"))
		.Подсказка(Тексты.Текст("subscriptions.form.name.optional"))
		.Справка(Тексты.Текст("subscriptions.form.name.hint"))
		.Ошибка(Окна.Отказ(Состояние, Имя));

КонецФункции

// Флажок «нижестоящие могут сузить». У подписки пакета нижестоящих нет — флажка тоже; у подписки
// пула нижестоящие — её пакеты.
//
// Параметры:
//  Объект - Структура - описание объекта подписки.
//  Подписка - Вебхук, Неопределено - правимая подписка; Неопределено — новая.
//  Состояние - Структура, Неопределено - состояние окна раздела.
//
// Возвращаемое значение:
//  ЭлементЭкрана, Неопределено - флажок; Неопределено у подписки пакета.
//
Функция СужениеСнизу(Знач Объект, Знач Подписка, Знач Состояние) Экспорт

	ТипОбъекта = НРег(СокрЛП(Строка(Объект.ТипОбъекта)));
	Если ТипОбъекта = "пакет" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Имя = Имена.ИмяПоляСужения();
	Возврат Кит.Поле(Имя, Тексты.Текст("subscriptions.form.narrowing.label")).ТипЗначения("флажок")
		.Значение(Имена.ЗначениеОтмечено())
		.Отмечено(Окна.Отмечено(Состояние, Имя, Сохранённые(Подписка).СужениеРазрешено,
			Имена.ЗначениеОтмечено()))
		.Подсказка(?(ТипОбъекта = "пул", Тексты.Текст("subscriptions.form.narrowing.hint.pool"),
			Тексты.Текст("subscriptions.form.narrowing.hint")));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Сохранённые(Знач Подписка)
	Возврат ?(Подписка = Неопределено, ПараметрыПодписки.ПустыеСвойства(), ПараметрыПодписки.Свойства(Подписка));
КонецФункции

#КонецОбласти

&Прозвище("ПоляСвойствПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ПараметрыПодписки") _ПараметрыПодписки,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	ПараметрыПодписки = _ПараметрыПодписки;
	Имена = _Имена;
	Окна = _Окна;
	Тексты = _Тексты;

КонецПроцедуры
