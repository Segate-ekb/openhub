// Поля общих свойств формы подписки: название и разрешение нижестоящим сузить подписку. Значение
// после отказа — присланное, иначе сохранённое у подписки.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем ПараметрыПодписки; // ПараметрыПодписки (подписки) — сохранённые свойства подписки
Перем Имена;             // ИменаПолейПодписки — имена полей раздела
Перем РазборФормы;       // РазборФормы — чтение отклонённой формы
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Поле названия подписки.
//
// Параметры:
//  Подписка - Вебхук, Неопределено - правимая подписка; Неопределено — форма заведения.
//  Отклонённая - Соответствие, Неопределено - отбитая форма, в которую возвращается ввод.
//
// Возвращаемое значение:
//  Произвольный - узел разметки.
//
Функция Название(Знач Подписка, Знач Отклонённая) Экспорт

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Плейсхолдер, Подсказка",
		Имена.ИмяПоляНазвания(), Тексты.Текст("subscriptions.form.name.label"), "текст",
		Значение(Отклонённая, Имена.ИмяПоляНазвания(), Сохранённые(Подписка).Название),
		Тексты.Текст("subscriptions.form.name.placeholder"),
		Тексты.Текст("subscriptions.form.name.hint")));

КонецФункции

// Флажок «нижестоящие могут сузить». У подписки пакета нижестоящих нет — флажка тоже.
//
// Параметры:
//  Объект - Структура - описание объекта подписки.
//  Подписка - Вебхук, Неопределено - правимая подписка; Неопределено — форма заведения.
//  Отклонённая - Соответствие, Неопределено - отбитая форма, в которую возвращается ввод.
//
// Возвращаемое значение:
//  Произвольный - узел разметки.
//
Функция СужениеСнизу(Знач Объект, Знач Подписка, Знач Отклонённая) Экспорт

	Если НРег(СокрЛП(Строка(Объект.ТипОбъекта))) = "пакет" Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Отмечено = ?(Отклонённая = Неопределено, Сохранённые(Подписка).СужениеРазрешено,
		РазборФормы.Флажок(Отклонённая, Имена.ИмяПоляСужения(), Имена.ЗначениеОтмечено()));

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Отмечено, Подсказка",
		Имена.ИмяПоляСужения(), Тексты.Текст("subscriptions.form.narrowing.label"), "флажок",
		Имена.ЗначениеОтмечено(), Отмечено, Тексты.Текст("subscriptions.form.narrowing.hint")));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Сохранённые(Знач Подписка)
	Возврат ?(Подписка = Неопределено, ПараметрыПодписки.ПустыеСвойства(), ПараметрыПодписки.Свойства(Подписка));
КонецФункции

Функция Значение(Знач Отклонённая, Знач ИмяПоля, Знач Сохранённое)
	Возврат ?(Отклонённая = Неопределено, Сохранённое, РазборФормы.Поле(Отклонённая, ИмяПоля, ""));
КонецФункции

#КонецОбласти

&Прозвище("ПоляСвойствПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ПараметрыПодписки") _ПараметрыПодписки,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	ПараметрыПодписки = _ПараметрыПодписки;
	Имена = _Имена;
	РазборФормы = _РазборФормы;
	Тексты = _Тексты;

КонецПроцедуры
