// Отбор по тегам на экране подписок: галки из тегов пула или пакета в формах подписки и поправки,
// действующий отбор и теги, которых у объекта больше нет, — для сводки. У хаба отбора нет.

Перем Кит;          // Кит (кит) — фабрика элементов экрана
Перем ОтборТегов;   // ОтборПоТегам (подписки) — теги объекта и действующий отбор
Перем Имена;        // ИменаПолейПодписки — имена галок тегов
Перем РазборФормы;  // РазборФормы — чтение отклонённой формы
Перем Тексты;       // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Галки отбора в форме подписки или поправки: по одной на тег объекта. Отмечены сохранённые,
// после отказа — присланные. Сохранённый тег, которого у объекта больше нет, галки не получает,
// а форма о нём предупреждает.
//
// Параметры:
//  Объект - Структура - описание объекта формы (ТипОбъекта, Идентификатор): чьи теги предлагать.
//  Запись - Вебхук, ПоправкаПодписки, Неопределено - правимая подписка или поправка;
//           Неопределено — их ещё нет.
//  Сохранённый - Массив из Строка, Строка - сохранённый отбор записи; строкой — через запятую.
//  Отклонённая - Соответствие, Неопределено - отбитая форма, в которую возвращается ввод.
//
// Возвращаемое значение:
//  Произвольный - узел разметки; у хаба — ничего.
//
Функция Галки(Знач Объект, Знач Запись, Знач Сохранённый, Знач Отклонённая) Экспорт

	Если ЭтоХаб(Объект.ТипОбъекта) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Доступные = ОтборТегов.Доступные(Объект.ТипОбъекта, Объект.Идентификатор);
	Отмеченные = ?(Запись = Неопределено, Новый Массив(), ОтборТегов.Действующий(Запись, Сохранённый));

	Группа = Кит.Группа(Тексты.Текст("subscriptions.form.tags.label"));
	Для Каждого Имя Из Доступные Цикл
		Группа.Добавить(Галка(Имя, ?(Отклонённая = Неопределено, Отмеченные.Найти(Имя) <> Неопределено,
			РазборФормы.Флажок(Отклонённая, Имена.ИмяПоляТега(Имя), Имена.ЗначениеОтмечено()))));
	КонецЦикла;
	Группа.Добавить(Пояснение(Объект.ТипОбъекта, Доступные));
	Если Отклонённая = Неопределено И Запись <> Неопределено Тогда
		Группа.Добавить(ПредупреждениеОВыпавших(ОтборТегов.Выпавшие(Запись, Сохранённый)));
	КонецЕсли;
	Возврат Группа;

КонецФункции

// Отбор в сводке подписки или поправки: действующие теги и выпавшие из отбора — строками.
//
// Параметры:
//  Запись - Вебхук, ПоправкаПодписки - подписка или поправка: её ТипОбъекта и ОбъектИдентификатор
//           называют, чьими тегами она отбирает.
//  Сохранённый - Массив из Строка, Строка - сохранённый отбор; строкой — через запятую.
//
// Возвращаемое значение:
//  Структура - Действующие и Выпавшие (Строка — имена через запятую); у хаба и без отбора пустые.
//
Функция Отбор(Знач Запись, Знач Сохранённый) Экспорт

	Результат = Новый Структура("Действующие, Выпавшие", "", "");
	Если ЭтоХаб(Запись.ТипОбъекта) ИЛИ НЕ ЗначениеЗаполнено(Сохранённый) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Действующие = СтрСоединить(ОтборТегов.Действующий(Запись, Сохранённый), ", ");
	Результат.Выпавшие = СтрСоединить(ОтборТегов.Выпавшие(Запись, Сохранённый), ", ");
	Возврат Результат;

КонецФункции

// Отмеченные галки тегов из формы.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Массив из Строка - имена отмеченных тегов.
//
Функция ИзФормы(Знач Форма) Экспорт

	Результат = Новый Массив();
	Для Каждого Поле Из Форма Цикл
		Имя = Имена.ИмяТегаИзПоля(Поле.Ключ);
		Если ЗначениеЗаполнено(Имя) И РазборФормы.Флажок(Форма, Поле.Ключ, Имена.ЗначениеОтмечено()) Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Галка(Знач Имя, Знач Отмечена)
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Отмечено",
		Имена.ИмяПоляТега(Имя), Имя, "флажок", Имена.ЗначениеОтмечено(), Отмечена));
КонецФункции

// Нет тегов — сказать, откуда они берутся; есть — как отбор судит версию.
Функция Пояснение(Знач ТипОбъекта, Знач Доступные)

	Если Доступные.Количество() > 0 Тогда
		Возврат Кит.Примечание(Тексты.Текст("subscriptions.form.tags.hint"));
	КонецЕсли;
	Если НРег(СокрЛП(ТипОбъекта)) = "пул" Тогда
		Возврат Кит.Примечание(Тексты.Текст("subscriptions.form.tags.empty.pool"));
	КонецЕсли;
	Возврат Кит.Примечание(Тексты.Текст("subscriptions.form.tags.empty.package"));

КонецФункции

Функция ПредупреждениеОВыпавших(Знач Выпавшие)

	Если Выпавшие.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;
	Возврат Кит.Уведомление(Новый Структура("Текст, Вид",
		Тексты.Шаблон("subscriptions.form.tags.dropped", СтрСоединить(Выпавшие, ", ")), "warn"));

КонецФункции

Функция ЭтоХаб(Знач ТипОбъекта)
	Возврат НРег(СокрЛП(Строка(ТипОбъекта))) = "хаб";
КонецФункции

#КонецОбласти

&Прозвище("ОтборТеговПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОтборПоТегам") _ОтборТегов,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	ОтборТегов = _ОтборТегов;
	Имена = _Имена;
	РазборФормы = _РазборФормы;
	Тексты = _Тексты;

КонецПроцедуры
