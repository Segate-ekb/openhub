// Отбор по тегам на экране подписок: галки из тегов пула или пакета в окнах подписки и поправки,
// действующий отбор и теги, которых у объекта больше нет, — для сводки. У хаба отбора нет.

Перем Кит;          // Кит (кит) — фабрика элементов экрана
Перем ОтборТегов;   // ОтборПоТегам (подписки) — теги объекта и действующий отбор
Перем Имена;        // ИменаПолейПодписки — имена галок тегов
Перем РазборФормы;  // РазборФормы — чтение галок пришедшей формы
Перем Окна;         // ОкноРаздела — набранное отбитой формы
Перем Тексты;       // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Галки отбора в окне подписки или поправки: по одной на тег объекта. Отмечены сохранённые,
// после отказа — присланные. Сохранённый тег, которого у объекта больше нет, галки не получает,
// а окно о нём предупреждает. Тегов нет — одна строка со ссылкой туда, где их заводят.
//
// Параметры:
//  Объект - Структура - описание объекта окна (ТипОбъекта, Идентификатор): чьи теги предлагать.
//  Запись - Вебхук, ПоправкаПодписки, Неопределено - правимая подписка или поправка;
//           Неопределено — их ещё нет.
//  Сохранённый - Массив из Строка, Строка - сохранённый отбор записи; строкой — через запятую.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//  АдресТегов - Строка - раздел «Теги» объекта; "" — ссылки нет (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  ЭлементЭкрана, Неопределено - группа галок либо строка без тегов; у хаба — Неопределено.
//
Функция Галки(Знач Объект, Знач Запись, Знач Сохранённый, Знач Состояние, Знач АдресТегов = "") Экспорт

	Если ЭтоХаб(Объект.ТипОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Доступные = ОтборТегов.Доступные(Объект.ТипОбъекта, Объект.Идентификатор);
	Если Доступные.Количество() = 0 Тогда
		Возврат БезТегов(Объект.ТипОбъекта, АдресТегов);
	КонецЕсли;

	Отмеченные = ?(Запись = Неопределено, Новый Массив(), ОтборТегов.Действующий(Запись, Сохранённый));
	Группа = Кит.Группа(Тексты.Текст("subscriptions.form.tags.label"));
	Для Каждого Имя Из Доступные Цикл
		Группа.Добавить(Галка(Имя, Окна.Отмечено(Состояние, Имена.ИмяПоляТега(Имя),
			Отмеченные.Найти(Имя) <> Неопределено, Имена.ЗначениеОтмечено())));
	КонецЦикла;
	Группа.Добавить(Кит.Примечание(Тексты.Текст("subscriptions.form.tags.none"),
		Кит.Подсказка(Тексты.Текст("subscriptions.form.tags.hint"))));
	Если Запись <> Неопределено И НЕ Набрано(Состояние) Тогда
		Группа.Добавить(ПредупреждениеОВыпавших(ОтборТегов.Выпавшие(Запись, Сохранённый)));
	КонецЕсли;
	Возврат Группа;

КонецФункции

// Отбор в сводке подписки или поправки: действующие теги и выпавшие из отбора — строками.
//
// Параметры:
//  Запись - Вебхук, ПоправкаПодписки - подписка или поправка: её ТипОбъекта и ОбъектИдентификатор
//           называют, чьими тегами она отбирает.
//  Сохранённый - Массив из Строка, Строка - сохранённый отбор; строкой — через запятую.
//  ТегиОбъектов - Соответствие, Неопределено - теги объектов, уже прочитанные на странице
//                 (СрезПодписок): теги одного объекта читаются один раз на много записей
//                 (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - Действующие и Выпавшие (Строка — имена через запятую); у хаба и без отбора пустые.
//
Функция Отбор(Знач Запись, Знач Сохранённый, ТегиОбъектов = Неопределено) Экспорт

	Результат = Новый Структура("Действующие, Выпавшие", "", "");
	Если ЭтоХаб(Запись.ТипОбъекта) ИЛИ НЕ ЗначениеЗаполнено(Сохранённый) Тогда
		Возврат Результат;
	КонецЕсли;

	Теги = ?(ТегиОбъектов = Неопределено, Новый Соответствие(), ТегиОбъектов);
	Результат.Действующие = СтрСоединить(ОтборТегов.Действующий(Запись, Сохранённый, Теги), ", ");
	Результат.Выпавшие = СтрСоединить(ОтборТегов.Выпавшие(Запись, Сохранённый, Теги), ", ");
	Возврат Результат;

КонецФункции

// Отмеченные галки тегов из формы.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Массив из Строка - имена отмеченных тегов.
//
Функция ИзФормы(Знач Форма) Экспорт

	Результат = Новый Массив();
	Для Каждого Поле Из Форма Цикл
		Имя = Имена.ИмяТегаИзПоля(Поле.Ключ);
		Если ЗначениеЗаполнено(Имя) И РазборФормы.Флажок(Форма, Поле.Ключ, Имена.ЗначениеОтмечено()) Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Галка(Знач Имя, Знач Отмечена)
	Возврат Кит.Поле(Имена.ИмяПоляТега(Имя), Имя).ТипЗначения("флажок")
		.Значение(Имена.ЗначениеОтмечено()).Отмечено(Отмечена);
КонецФункции

// Тегов нет — одной строкой: откуда они берутся и ссылка туда, где их заводят.
Функция БезТегов(Знач ТипОбъекта, Знач АдресТегов)

	Текст = ?(НРег(СокрЛП(ТипОбъекта)) = "пул", Тексты.Текст("subscriptions.form.tags.empty.pool"),
		Тексты.Текст("subscriptions.form.tags.empty.package"));
	Если НЕ ЗначениеЗаполнено(АдресТегов) Тогда
		Возврат Кит.Примечание(Текст);
	КонецЕсли;
	Возврат Кит.Примечание(Текст, " ", Кит.Ссылка(АдресТегов, Тексты.Текст("subscriptions.form.tags.link")));

КонецФункции

Функция ПредупреждениеОВыпавших(Знач Выпавшие)

	Если Выпавшие.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Тексты.Шаблон("subscriptions.form.tags.dropped", СтрСоединить(Выпавшие, ", ")))
		.Вид("warn");

КонецФункции

// Окно вернулось с отбитой формой: её галки — присланные, о выпавших тегах уже сказано.
Функция Набрано(Знач Состояние)
	Возврат Состояние <> Неопределено И Состояние.Набранное.Количество() > 0;
КонецФункции

Функция ЭтоХаб(Знач ТипОбъекта)
	Возврат НРег(СокрЛП(Строка(ТипОбъекта))) = "хаб";
КонецФункции

#КонецОбласти

&Прозвище("ОтборТеговПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОтборПоТегам") _ОтборТегов,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	ОтборТегов = _ОтборТегов;
	Имена = _Имена;
	РазборФормы = _РазборФормы;
	Окна = _Окна;
	Тексты = _Тексты;

КонецПроцедуры
