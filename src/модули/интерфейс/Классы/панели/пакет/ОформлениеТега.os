// Переводит ХРАНИМЫЕ ключи тега (стиль, значок) в модель компонента «Плашка». Цвета здесь нет
// вовсе: вид плашки — это CSS-класс, а цвет берётся из переменной темы.

Перем Стили;  // СтильТега (реестр) — единственный словарь стилей
Перем Значки; // ЗначокТега (реестр) — единственный словарь значков

#Область ПубличныйИнтерфейс

// Возвращает вид плашки кита по ключу стиля.
//
// Параметры:
//  КлючСтиля - Произвольный - ключ из СтильТега; незнакомый даёт вид по умолчанию.
//
// Возвращаемое значение:
//  Строка - "" | "ok" | "warn" | "err" | "accent" — значения allowlist компонента «Плашка».
//
Функция ВидПлашки(Знач КлючСтиля) Экспорт

	Ключ = Стили.Нормализовать(КлючСтиля);

	Если Ключ = Стили.Стабильный() Тогда
		Возврат "ok";
	ИначеЕсли Ключ = Стили.Предварительный() Тогда
		Возврат "warn";
	ИначеЕсли Ключ = Стили.Устаревший() Тогда
		Возврат "err";
	ИначеЕсли Ключ = Стили.Особый() Тогда
		Возврат "accent";
	КонецЕсли;

	Возврат "";

КонецФункции

// Возвращает ключ стиля из закрытого списка: незнакомое и пустое значение — «обычный».
//
// Параметры:
//  КлючСтиля - Произвольный - ключ стиля, сохранённый или набранный в форме.
//
// Возвращаемое значение:
//  Строка - ключ из СтильТега.
//
Функция КлючСтиля(Знач КлючСтиля) Экспорт
	Возврат Стили.Нормализовать(КлючСтиля);
КонецФункции

// Возвращает имя иконки кита по хранимому значку: значок тега — имя значка кита, прежний ключ
// тега домен переводит по своей таблице.
//
// Параметры:
//  КлючЗначка - Произвольный - значок из ЗначокТега.
//
// Возвращаемое значение:
//  Строка - имя иконки либо "" — тогда плашка печатается без значка.
//
Функция ИмяИконки(Знач КлючЗначка) Экспорт
	Возврат Значки.ИмяКита(КлючЗначка);
КонецФункции

// Собирает модель компонента «Плашка» для тега.
//
// Параметры:
//  Имя - Произвольный - надпись плашки.
//  КлючСтиля - Произвольный - ключ стиля.
//  КлючЗначка - Произвольный - ключ значка.
//
// Возвращаемое значение:
//  Структура - Текст, Вид, Иконка — модель плашки кита (Кит.Плашка).
//
Функция МодельПлашки(Знач Имя, Знач КлючСтиля, Знач КлючЗначка) Экспорт

	Возврат Новый Структура("Текст, Вид, Иконка",
		Строка(Имя), ВидПлашки(КлючСтиля), ИмяИконки(КлючЗначка));

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СтильТега") _Стили,
	&Пластилин(Значение = "ЗначокТега") _Значки) Экспорт

	Стили = _Стили;
	Значки = _Значки;

КонецПроцедуры
