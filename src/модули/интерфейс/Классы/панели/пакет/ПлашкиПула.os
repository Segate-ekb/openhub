// Переводит технические колонки пула (тип, видимость, апстримы, чем наполняется) в модели
// компонента «Плашка» с человеческой подписью. Разметки здесь нет — только модели.

Перем СервисПулов;   // СервисПулов (реестр)
Перем Источники;     // СервисАпстримовПула (реестр) — источники пула в порядке обхода
Перем СервисЗеркал;  // СервисЗеркал (зеркала) — чем наполняется пул, закрытый для публикации
Перем Тексты;        // ТекстыИнтерфейса
Перем Реестр;        // ЗначкиМеты

// Плашки пула для шапки объекта.
//
// Параметры:
//  Пул - Пул, Неопределено - пул.
//
// Возвращаемое значение:
//  Массив из Структура - модели компонента «Плашка».
//
Функция Плашки(Знач Пул) Экспорт

	Результат = Новый Массив();
	Если Пул = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ДобавитьПризнак(Результат, ПлашкаОсновного(Пул));
	ДобавитьПризнак(Результат, ПлашкаТипа(Пул));
	ДобавитьПризнак(Результат, ПлашкаВидимости(Пул));
	ДобавитьПризнак(Результат, ПлашкаПрокси(Пул));

	// пул, закрытый для людей, называет своё наполнение сам — «зеркало» тогда повтор
	Наполнение = ПлашкаНаполнения(Пул);
	ДобавитьПризнак(Результат, ?(Наполнение = Неопределено, ПлашкаЗеркала(Пул), Наполнение));

	Возврат Результат;

КонецФункции

// Неопределено — признака у пула нет, и места в списке он не занимает.
Процедура ДобавитьПризнак(Результат, Знач Модель)
	Если Модель <> Неопределено Тогда
		Результат.Добавить(Модель);
	КонецЕсли;
КонецПроцедуры

// Плашка типа пула; Неопределено — тип ничего не сообщает и не показывается.
//
// Параметры:
//  Пул - Пул - пул.
//
// Возвращаемое значение:
//  Структура, Неопределено - модель «Плашки»; неизвестный тип показывается как есть
//                            с пометкой, проектный не показывается вовсе.
//
Функция ПлашкаТипа(Знач Пул) Экспорт

	Значение = НРег(СокрЛП(Строка(Пул.Тип)));

	Если Значение = "user" Тогда
		Возврат Плашка(Тексты.Текст("public.pools.kind.personal"), "", Тексты.Текст("public.pool.badge.personal.hint"));
	ИначеЕсли Значение = "custom" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Плашка(Тексты.Шаблон("public.pool.badge.kind.unknown", Строка(Пул.Тип)), "warn",
		Тексты.Текст("public.pool.badge.kind.unknown.hint"));

КонецФункции

// Плашка «основной пул хаба»; Неопределено — пул не основной.
//
// Параметры:
//  Пул - Пул - пул.
//
// Возвращаемое значение:
//  Структура, Неопределено - модель «Плашки».
//
Функция ПлашкаОсновного(Знач Пул) Экспорт

	Если Пул = Неопределено ИЛИ НЕ Пул.ЭтоДефолтный() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Плашка(Тексты.Текст("public.pool.badge.primary"), "accent",
		Тексты.Текст("public.pool.badge.primary.hint"));

КонецФункции

// Плашка видимости пула.
//
// Параметры:
//  Пул - Пул - пул.
//
// Возвращаемое значение:
//  Структура - модель «Плашки».
//
Функция ПлашкаВидимости(Знач Пул) Экспорт

	Если НРег(СокрЛП(Строка(Пул.Видимость))) = "public" Тогда
		Возврат Плашка(Тексты.Текст("public.pool.badge.public"), "ok", Тексты.Текст("public.pool.badge.public.hint"));
	КонецЕсли;

	Возврат Плашка(Тексты.Текст("public.pool.badge.private"), "warn", Тексты.Текст("public.pool.badge.private.hint"));

КонецФункции

// Плашка «прокси» шапки пула: подсказка называет число апстримов.
//
// Параметры:
//  Пул - Пул - пул.
//
// Возвращаемое значение:
//  Структура, Неопределено - модель «Плашки» либо Неопределено, если апстримов нет.
//
Функция ПлашкаПрокси(Знач Пул) Экспорт

	Если Пул.Идентификатор = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Апстримов = Источники.Все(Пул.Идентификатор).Количество();
	Если Апстримов = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// «чем пул наполняется» говорит своя плашка: связывать это с апстримами значило бы
	// подписывать «только прокси» пул, который наполняет зеркало
	Возврат Плашка(Тексты.Текст("public.pool.badge.proxy"), "accent",
		Тексты.Шаблон("public.pool.badge.proxy.hint.count", Тексты.ЧислоТекстом(Апстримов)));

КонецФункции

// Плашки источников для списка пулов: «Прокси» у пула с апстримами, «Зеркало» у пула
// с включённым зеркалом. Два вопроса на весь список, а не по два на пул.
//
// Параметры:
//  Пулы - Массив из Пул - пулы списка.
//
// Возвращаемое значение:
//  Соответствие - идентификатор пула (Число) в Массив моделей «Плашки»; пула без источников
//                 в нём нет.
//
Функция ИсточникиПулов(Знач Пулы) Экспорт

	САпстримами = Новый Соответствие();
	Для Каждого Идентификатор Из Источники.ПулыСИсточниками() Цикл
		САпстримами.Вставить(Цел(Идентификатор), Истина);
	КонецЦикла;
	СЗеркалом = ПулыСВключённымЗеркалом();

	Результат = Новый Соответствие();
	Для Каждого Пул Из Пулы Цикл
		Ключ = Цел(Пул.Идентификатор);
		Плашки = Новый Массив();
		Если САпстримами.Получить(Ключ) = Истина Тогда
			Плашки.Добавить(ПлашкаПроксиПоФакту());
		КонецЕсли;
		Если СЗеркалом.Получить(Ключ) = Истина Тогда
			Плашки.Добавить(ПлашкаЗеркалаПоФакту());
		КонецЕсли;
		Если Плашки.Количество() > 0 Тогда
			Результат.Вставить(Ключ, Плашки);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Плашка «зеркало»: пул наполняет включённое зеркало, принимает ли он публикации или нет.
//
// Параметры:
//  Пул - Пул - пул.
//
// Возвращаемое значение:
//  Структура, Неопределено - модель «Плашки» либо Неопределено, если включённых зеркал нет.
//
Функция ПлашкаЗеркала(Знач Пул) Экспорт

	Если Пул.Идентификатор = Неопределено ИЛИ НЕ НаполняетсяЗеркалом(Пул) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПлашкаЗеркалаПоФакту();

КонецФункции

Функция ПлашкаПроксиПоФакту()
	Возврат Плашка(Тексты.Текст("public.pool.badge.proxy"), "accent", Тексты.Текст("public.pool.badge.proxy.hint"));
КонецФункции

Функция ПлашкаЗеркалаПоФакту()
	Возврат Плашка(Тексты.Текст("public.pool.badge.mirror"), "accent", Тексты.Текст("public.pool.badge.mirror.hint"));
КонецФункции

// Плашка наполнения пула, закрытого для публикации.
//
// Параметры:
//  Пул - Пул - пул.
//
// Возвращаемое значение:
//  Структура, Неопределено - модель «Плашки»; Неопределено, если публикация разрешена
//                            и наполнение пула вопросов не вызывает.
//
Функция ПлашкаНаполнения(Знач Пул) Экспорт

	Если Пул.Идентификатор = Неопределено ИЛИ СервисПулов.ПубликацияРазрешена(Пул) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НаполняетсяЗеркалом(Пул) Тогда
		Возврат Плашка(Тексты.Текст("public.pool.badge.mirrored"), "accent",
			Тексты.Текст("public.pool.badge.mirrored.hint"));
	КонецЕсли;

	Возврат Плашка(Тексты.Текст("public.pool.badge.closed"), "warn", Тексты.Текст("public.pool.badge.closed.hint"));

КонецФункции

// Пулы, которые наполняет хоть одно включённое зеркало; спросить некого — пусто.
Функция ПулыСВключённымЗеркалом()

	Результат = Новый Соответствие();
	Если СервисЗеркал = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Зеркало Из СервисЗеркал.ВключённыеЗеркала() Цикл
		Результат.Вставить(Цел(Зеркало.ПулНазначенияИдентификатор), Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ложь и там, где зеркал нет, и там, где спросить о них некого.
Функция НаполняетсяЗеркалом(Знач Пул)

	Если СервисЗеркал = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Зеркало Из СервисЗеркал.СписокПула(Пул.Идентификатор) Цикл
		Если Зеркало.Включено = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция Плашка(Знач Текст, Знач Вид, Знач Подсказка)
	Возврат Новый Структура("Текст, Вид, Подсказка", Текст, Вид, Подсказка);
КонецФункции

// Модель шапки страницы пула: слаг вида, иконка, подпись вида, плашки и мета со значками.
//
// Параметры:
//  Пул           - Пул - пул.
//  ВсегоПакетов  - Число - сколько пакетов показано.
//
// Возвращаемое значение:
//  Структура - модель компонента «Шапка объекта» без Действий: их знает контроллер.
//
Функция ШапкаПула(Знач Пул, Знач ВсегоПакетов) Экспорт

	Мета = Новый Массив();
	Мета.Добавить(Новый Структура("Подпись, Значение",
		Тексты.Текст("public.pool.head.packages"), Тексты.ЧислоТекстом(ВсегоПакетов)));

	Результат = Новый Структура();
	Результат.Вставить("Имя", Пул.Имя);
	Результат.Вставить("Вид", "pool");
	Результат.Вставить("Иконка", "куб");
	Результат.Вставить("Подпись", Тексты.Текст("public.pool.head.kind"));
	Результат.Вставить("Плашки", Плашки(Пул));
	Результат.Вставить("Мета", Реестр.Оснастить(Мета));
	Возврат Результат;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисАпстримовПула") _Источники,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ЗначкиМеты") _Реестр,
	&Пластилин(Значение = "СервисЗеркал", Тип = "Массив") _СервисЗеркал = Неопределено)

	СервисПулов = _СервисПулов;
	Источники = _Источники;
	Тексты = _Тексты;
	Реестр = _Реестр;
	СервисЗеркал = ?(_СервисЗеркал = Неопределено ИЛИ _СервисЗеркал.Количество() = 0,
		Неопределено, _СервисЗеркал[0]);

КонецПроцедуры
