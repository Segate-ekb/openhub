// Тексты панели пакета: плашка тега, витрина пакетов, значки версии.

// Кладёт тексты в словарь интерфейса.
//
// Параметры:
//  Словарь - СловарьТекстов - словарь, который собирается из частей.
//
Процедура Наполнить(Знач Словарь) Экспорт

	КлючиПлашкиТега(Словарь);
	КлючиВитриныПакетов(Словарь);
	КлючиЗначковВерсии(Словарь);

КонецПроцедуры

// Плашка тега и её пометки.
Процедура КлючиПлашкиТега(Словарь)

	// пометки плашки тега звучат и в настройках, и на публичных страницах
	Словарь.Добавить("package.tags.default", "Канал по умолчанию");
	Словарь.Добавить("package.tags.more", "ещё %1");
	Словарь.Добавить("settings.package.tag-new.preview.chip", "Так будет выглядеть плашка");
	Словарь.Добавить("settings.package.tag-new.preview.sample", "тег");

КонецПроцедуры

// Витрина пакетов.
Процедура КлючиВитриныПакетов(Словарь)

	Словарь.Добавить("public.showcase.upstream.tag", "с апстрима");
	Словарь.Добавить("public.showcase.upstream.hint",
		"Ни одна версия этого имени не опубликована здесь — все получены с апстрима");
	Словарь.Добавить("public.showcase.reserve.tag", "резерв");
	Словарь.Добавить("public.showcase.reserve.hint",
		"Имя занято, версий ещё нет: первая публикация придёт в этот пакет");
	Словарь.Добавить("public.showcase.reserve.release", "Снять резерв");
	Словарь.Добавить("public.showcase.reserve.release.hint",
		"Удалить пакет без версий вместе с ролями на него и освободить имя");
	Словарь.Добавить("public.showcase.settings.label", "Настройки");
	Словарь.Добавить("public.showcase.settings.hint", "Изменить настройки пакета");

КонецПроцедуры

// Значки версии: с апстрима, доверенный конвейер, отозвана.
Процедура КлючиЗначковВерсии(Словарь)

	Словарь.Добавить("public.package.version.upstream", "с апстрима");
	Словарь.Добавить("public.package.version.upstream.hint",
		"Версия получена с апстрима, а не опубликована здесь");

	// подпись иконки, она же подсказка; что это за механизм, объясняет легенда под таблицей
	Словарь.Добавить("public.package.version.trusted", "Опубликовано доверенным конвейером");
	Словарь.Добавить("public.package.version.trusted.legend",
		"%1 — опубликовано доверенным конвейером: версию принёс конвейер сборки, предъявивший"
		+ " короткоживущий токен своего провайдера, а не долгоживущий токен доступа.");
	Словарь.Добавить("public.package.version.yanked", "отозвана");
	Словарь.Добавить("public.package.version.yanked.hint",
		"Версия не отдаётся резолвом, но скачивается по точной координате");

КонецПроцедуры

&Прозвище("ЧастьСловаряТекстов")
&Порядок(80)
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
