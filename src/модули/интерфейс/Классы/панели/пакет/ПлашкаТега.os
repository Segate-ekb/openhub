// ЕДИНСТВЕННОЕ место, где тег превращается в плашку; здесь же ряд каналов у версии и образец
// плашки в окне тега. Вид тега нигде больше не считается.

Перем Кит;         // Кит (кит) — фабрика элементов экрана
Перем Оформление;  // ОформлениеТега — ключи тега в модель плашки
Перем Тексты;      // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Модели;      // ЧтениеМодели (кит) — мягкое чтение опций

#Область ПубличныйИнтерфейс

// Плашка тега в его оформлении: цвет даёт переменная темы по ключу стиля, поэтому
// одна и та же строка БД читается и в светлой теме, и в тёмной.
//
// Параметры:
//  Тег - Тег - тег, чью плашку рисуем; годится и структура с полями Имя, Стиль, Значок,
//        ПоУмолчанию.
//  Опции - Структура - (необязательный) Подсказка (атрибут title), Адрес (плашка
//          становится ссылкой), Действие (доверенная разметка управления ВНУТРИ плашки).
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел компонента «плашка».
//
Функция ПоТегу(Знач Тег, Знач Опции = Неопределено) Экспорт

	ПроверитьИмя(Тег);

	Модель = Оформление.МодельПлашки(Тег.Имя, Тег.Стиль, Тег.Значок);
	Модель.Вставить("Подсказка", Модели.Текст(Опции, "Подсказка"));
	Модель.Вставить("Адрес", Модели.Текст(Опции, "Адрес"));
	Модель.Вставить("Действие", Модели.Текст(Опции, "Действие"));
	Возврат Кит.Плашка(Модель);

КонецФункции

// Тег как канал обновления: плашка и — у основного тега пакета — приглушённая пометка
// рядом с ней, а не внутри.
//
// Параметры:
//  Тег - Тег - тег пакета.
//  Опции - Структура - (необязательный) те же, что у ПоТегу.
//
// Возвращаемое значение:
//  ЭлементЭкрана - плашка с пометкой основного канала.
//
Функция Канал(Знач Тег, Знач Опции = Неопределено) Экспорт

	Результат = Кит.Холст();
	Результат.Добавить(ПоТегу(Тег, Опции));
	Результат.Добавить(ОтбитаяПометка(Тег));
	Возврат Результат;

КонецФункции

// Пометка основного канала сама по себе — значок с подписью. Нужна экрану, который метит
// канал своим местом в строке, а не соседством с именем тега.
//
// Параметры:
//  Тег - Тег - тег пакета.
//
// Возвращаемое значение:
//  ЭлементЭкрана - значок пометки; у неосновного тега — ничего.
//
Функция ПометкаОсновного(Знач Тег) Экспорт

	Если Тег.ПоУмолчанию <> Истина Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Пометка = Кит.Надпись().Вид("приглушённая");
	Пометка.Добавить(Кит.Иконка(Новый Структура("Имя, Подпись",
		"закладка", Тексты.Текст("package.tags.default"))));
	Возврат Пометка;

КонецФункции

// Ряд каналов версии: основной тег первым, остальные до предела, хвост — в раскрывашке
// «ещё N», без JS.
//
// Параметры:
//  Теги - Массив из Тег - теги, стоящие на версии.
//  Опции - Структура - (необязательный) Предел (сколько неосновных показывать,
//          по умолчанию 3), Заголовок (имя ряда для скринридера), Подсказки
//          (Соответствие «имя тега → подсказка плашки»).
//
// Возвращаемое значение:
//  ЭлементЭкрана - ряд свёрнутых плашек либо ничего.
//
Функция Ряд(Знач Теги, Знач Опции = Неопределено) Экспорт

	Если Теги.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Разложенные = Разложить(Теги, Предел(Опции));
	Подсказки = ПодсказкиКаналов(Опции);

	Каналы = Кит.Ряд("свёрнутые").Подпись(Модели.Текст(Опции, "Заголовок"));
	Для Каждого Тег Из Разложенные.Видимые Цикл
		Каналы.Добавить(Канал(Тег, ОпцииТега(Тег, Подсказки)));
	КонецЦикла;
	Каналы.Добавить(Хвост(Разложенные.Скрытые, Подсказки));

	Возврат Каналы;

КонецФункции

// Двухколоночная студия тега: слева поля, справа образец плашки.
//
// Возвращаемое значение:
//  ЭлементЭкрана - холст студии; поля и образец кладут внутрь.
//
Функция Студия() Экспорт
	Возврат Кит.Область().Вид("студия");
КонецФункции

// Правая колонка студии: образец плашки в рамке со сменой темы — стиль даёт цвет темы,
// и видно, как плашка читается в светлой и в тёмной. Плашка из тех же родов и иконок кита,
// что у версии. Имя, стиль и значок плашка зеркалит из полей окна: имя — текстом подписи,
// стиль — признаком (вид по нему задаёт лист хаба), значок — признаком и самим значком,
// выбранным в сетке (его кладёт скрипт кита).
//
// Параметры:
//  Конструктор - Структура - Имя, Стиль, Значок тега.
//  ИменаПолей - Структура - Имя, Стиль, Значок: имена полей окна, которые зеркалит образец.
//
// Возвращаемое значение:
//  ЭлементЭкрана - образец плашки.
//
Функция Предпросмотр(Знач Конструктор, Знач ИменаПолей) Экспорт
	Возврат Кит.Образец(Тексты.Текст("settings.package.tag-new.preview.chip"), Образец(Конструктор, ИменаПолей));
КонецФункции

#КонецОбласти

#Область РядКаналов

// Основной канал стоит первым и предел не расходует: с него начинается ответ про opm install.
Функция Разложить(Знач Теги, Знач Предел)

	Видимые = Новый Массив();
	Прочие = Новый Массив();
	Для Каждого Тег Из Теги Цикл
		Если Тег.ПоУмолчанию = Истина Тогда
			Видимые.Добавить(Тег);
		Иначе
			Прочие.Добавить(Тег);
		КонецЕсли;
	КонецЦикла;

	Скрытые = Новый Массив();
	Остаток = Предел;
	Для Каждого Тег Из Прочие Цикл
		Если Остаток > 0 Тогда
			Видимые.Добавить(Тег);
			Остаток = Остаток - 1;
		Иначе
			Скрытые.Добавить(Тег);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Видимые, Скрытые", Видимые, Скрытые);

КонецФункции

// Остаток ряда живёт в раскрывашке; прятать нечего — раскрывашки нет вовсе.
Функция Хвост(Знач Скрытые, Знач Подсказки)

	Если Скрытые.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Остаток = Кит.Раскрывашка().Вид("хвост");
	Остаток.Шапка().Добавить(Кит.Текст(Тексты.Шаблон("package.tags.more",
		Формат(Скрытые.Количество(), "ЧН=0; ЧГ=0"))));
	Для Каждого Тег Из Скрытые Цикл
		Остаток.Добавить(Канал(Тег, ОпцииТега(Тег, Подсказки)));
	КонецЦикла;
	Возврат Остаток;

КонецФункции

Функция ОпцииТега(Знач Тег, Знач Подсказки)
	Возврат Новый Структура("Подсказка", Подсказки.Получить(Строка(Тег.Имя)));
КонецФункции

Функция ПодсказкиКаналов(Знач Опции)
	Значение = Модели.Значение(Опции, "Подсказки");
	Возврат ?(ТипЗнч(Значение) = Тип("Соответствие"), Значение, Новый Соответствие());
КонецФункции

Функция Предел(Знач Опции)

	Значение = Модели.Значение(Опции, "Предел");
	Если Значение = Неопределено Тогда
		Возврат 3;
	КонецЕсли;

	Попытка
		Возврат Макс(0, Цел(Число(Значение)));
	Исключение
		Возврат 3;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// «По умолчанию» — свойство канала, а не часть имени тега, и внутрь плашки не входит.
Функция ОтбитаяПометка(Знач Тег)

	Если Тег.ПоУмолчанию <> Истина Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Отбитая = Кит.Холст();
	Отбитая.Добавить(Кит.Текст(" "));
	Отбитая.Добавить(ПометкаОсновного(Тег));
	Возврат Отбитая;

КонецФункции

// Сохранённый значок плашка печатает сама; выбранный в сетке скрипт кита кладёт на его место —
// плашка зеркалит поле значка признаком. В плашке рядом с именем значок декоративен.
Функция Образец(Знач Конструктор, Знач ИменаПолей)

	Возврат Кит.Плашка(Новый Структура("Вид", Оформление.ВидПлашки(Конструктор.Стиль)),
			Кит.Иконка(Новый Структура("Имя", Оформление.ИмяИконки(Конструктор.Значок))),
			Кит.Надпись(Кит.Текст(ОбразецИмени(Конструктор))).Зеркало(ИменаПолей.Имя))
		.ЗеркалоПризнаком(ИменаПолей.Стиль, Оформление.КлючСтиля(Конструктор.Стиль))
		.ЗеркалоПризнаком(ИменаПолей.Значок, Оформление.ИмяИконки(Конструктор.Значок));

КонецФункции

Функция ОбразецИмени(Знач Конструктор)
	Возврат ?(ЗначениеЗаполнено(Конструктор.Имя), Конструктор.Имя,
		Тексты.Текст("settings.package.tag-new.preview.sample"));
КонецФункции

Процедура ПроверитьИмя(Знач Тег)

	Если ЗначениеЗаполнено(Тег.Имя) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение "Плашка тега: у тега не задано Имя — рядом с версией появилась бы"
		+ " безымянная плашка, по которой канал не опознать.";

КонецПроцедуры

#КонецОбласти

&Прозвище("ПлашкаТега")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОформлениеТега") _Оформление,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ЧтениеМодели") _Модели) Экспорт

	Кит = _Кит;
	Оформление = _Оформление;
	Тексты = _Тексты;
	Модели = _Модели;

КонецПроцедуры
