// Элемент списка каталога, поиска, пула и личного пространства — карточка объекта: пакета, а на
// главной и пула. Собирается родами кита; пустой список заглушкой не подменяет — это дело ПустоеСостояние.

Перем Кит;     // Кит (кит) — фабрика элементов экрана
Перем Модели;  // ЧтениеМодели
Перем Реестр;  // ЗначкиМеты

// Карточка одного объекта — пакета или пула.
//
// Параметры:
//  Модель - Структура - Имя (обязательно), Адрес, Иконка (значок перед именем, по умолчанию
//           «пакет»; у пула — «куб»), Описание, Пул, АдресПула, Версия,
//           Плашки (массив моделей компонента «Плашка»), Мета (массив структур Подпись,
//           Значение, Адрес — с адресом значение становится ссылкой),
//           Действия (массив моделей компонента «Кнопка»; Окно = Истина — кнопка окна по адресу),
//           МенюДействий (подпись меню ⚙: задана — действия собраны в меню, а не стоят кнопками).
//
// Возвращаемое значение:
//  ЭлементЭкрана - статья-карточка. Кидается исключением, если Имя пусто.
//
Функция Карточка(Знач Модель) Экспорт

	Имя = Модели.Текст(Модель, "Имя");
	ПроверитьИмя(Имя);

	Пакет = Кит.Статья().Вид("карточка");
	Пакет.Добавить(ШапкаКарточки(Модель, Имя));
	Пакет.Добавить(ОписаниеПакета(Модель));
	Пакет.Добавить(МетаданныеПакета(Модель));
	Возврат Пакет;

КонецФункции

// Колонка карточек. Пустой список места на экране не занимает.
//
// Параметры:
//  Карточки - Массив - модели карточек, см. Карточка.
//
// Возвращаемое значение:
//  ЭлементЭкрана - колонка карточек либо ничего.
//
Функция Список(Знач Карточки) Экспорт

	Если ТипЗнч(Карточки) <> Тип("Массив") ИЛИ Карточки.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Колонка = Кит.Область().Вид("карточки");
	Для Каждого Модель Из Карточки Цикл
		Колонка.Добавить(Карточка(Модель));
	КонецЦикла;
	Возврат Колонка;

КонецФункции

#Область СоставКарточки

// Шапка карточки: имя пакета, его признаки и действия над ним — в одну строку.
Функция ШапкаКарточки(Знач Модель, Знач Имя)

	Шапка = Кит.Область().Вид("шапка");
	Шапка.Добавить(ИмяПакета(Модель, Имя));
	Шапка.Добавить(ПризнакиПакета(Модель));
	Шапка.Добавить(ДействияНадПакетом(Модель));
	Возврат Шапка;

КонецФункции

// Имя — заголовок третьего уровня: карточка стоит внутри раздела страницы.
Функция ИмяПакета(Знач Модель, Знач Имя)

	Заголовок = Кит.Заголовок(3).Вид("имя");
	Заголовок.Добавить(Кит.Иконка(Модели.Текст(Модель, "Иконка", "пакет")));
	Заголовок.Добавить(ОткрывающееИмя(Модели.Текст(Модель, "Адрес"), Имя));
	Возврат Заголовок;

КонецФункции

// Без адреса имя остаётся текстом: карточка без ссылки бывает у пакета, которого некуда открыть.
Функция ОткрывающееИмя(Знач Адрес, Знач Имя)

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат Кит.Текст(Имя);
	КонецЕсли;

	Ссылка = Кит.Ссылка(Адрес);
	Ссылка.Добавить(Кит.Текст(Имя));
	Возврат Ссылка;

КонецФункции

Функция ПризнакиПакета(Знач Модель)

	Набор = Модели.Список(Модель, "Плашки");
	Если Набор.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Признаки = Кит.Область().Вид("плашки");
	Для Каждого Признак Из Набор Цикл
		Признаки.Добавить(Кит.Плашка(Признак));
	КонецЦикла;
	Возврат Признаки;

КонецФункции

Функция ДействияНадПакетом(Знач Модель)

	Кнопки = Модели.Список(Модель, "Действия");
	Если Кнопки.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Действия = Кит.Область().Вид("действия");
	ПодписьМеню = Модели.Текст(Модель, "МенюДействий");
	Если ЗначениеЗаполнено(ПодписьМеню) Тогда
		Действия.Добавить(МенюДействий(ПодписьМеню, Кнопки));
		Возврат Действия;
	КонецЕсли;

	Для Каждого Кнопка Из Кнопки Цикл
		Действия.Добавить(Кит.Кнопка(Кнопка));
	КонецЦикла;
	Возврат Действия;

КонецФункции

// Меню ⚙: пункт окна открывает окно по адресу, остальные — ссылки.
Функция МенюДействий(Знач Подпись, Знач Кнопки)

	Меню = Кит.Меню(Подпись);
	Для Каждого Кнопка Из Кнопки Цикл
		Меню.Добавить(ПунктДействия(Кнопка));
	КонецЦикла;
	Возврат Меню;

КонецФункции

Функция ПунктДействия(Знач Кнопка)

	Подпись = Модели.Текст(Кнопка, "Подпись");
	Адрес = Модели.Текст(Кнопка, "Адрес");
	Иконка = Модели.Текст(Кнопка, "Иконка");

	Если Модели.Флаг(Кнопка, "Окно") Тогда
		Окно = Кит.ОкноПоАдресу(Адрес, Подпись).Иконка(Иконка);
		Возврат ?(Модели.Текст(Кнопка, "Вариант") = "опасная", Окно.Опасная(), Окно);
	КонецЕсли;

	Возврат Кит.ПунктМеню(Подпись, Адрес).Иконка(Иконка);

КонецФункции

Функция ОписаниеПакета(Знач Модель)
	Возврат Кит.Примечание(Кит.Текст(Модели.Текст(Модель, "Описание"))).Вид("описание");
КонецФункции

// Пул и версия впереди, дальше — что положил экран; значки подписям подставляет реестр.
Функция МетаданныеПакета(Знач Модель)

	Элементы = Новый Массив();

	Пул = Модели.Текст(Модель, "Пул");
	Если ЗначениеЗаполнено(Пул) Тогда
		Элементы.Добавить(Новый Структура("Подпись, Значение, Адрес",
			"пул", Пул, Модели.Текст(Модель, "АдресПула")));
	КонецЕсли;

	Версия = Модели.Текст(Модель, "Версия");
	Если ЗначениеЗаполнено(Версия) Тогда
		Элементы.Добавить(Новый Структура("Подпись, Значение", "версия", Версия));
	КонецЕсли;

	Для Каждого Запись Из Модели.Список(Модель, "Мета") Цикл
		Элементы.Добавить(Запись);
	КонецЦикла;

	Возврат Кит.РядМеты(Реестр.Оснастить(Элементы), "карточка");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьИмя(Знач Имя)

	Если ЗначениеЗаполнено(Имя) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение "Компонент «Карточка пакета»: не задано Имя — в списке появилась бы"
		+ " безымянная строка, по которой пакет не открыть.";

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "ЗначкиМеты") _Реестр) Экспорт

	Кит = _Кит;
	Модели = _Модели;
	Реестр = _Реестр;

КонецПроцедуры
