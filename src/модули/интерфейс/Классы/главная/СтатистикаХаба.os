// Статистика хаба — желудь модуля web-ui: числа лендинга. Считаются по доступному
// смотрящему срезу: анонимный наблюдатель не должен узнавать о приватном пуле по тому,
// что счётчик подрос.

Перем Содержимое;  // ВидимоеСодержимое

// Сводка для лендинга по срезу субъекта.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - (необязательный, по умолчанию
//                 Неопределено) субъект запроса; Неопределено — аноним.
//
// Возвращаемое значение:
//  Структура - см. СводкаПоСрезу.
//
Функция Сводка(Знач Пользователь = Неопределено) Экспорт
	Возврат СводкаПоСрезу(Содержимое.Срез(Пользователь));
КонецФункции

// Сводка по уже посчитанному срезу — там, где страница считает срез один раз на весь
// свой состав.
//
// Параметры:
//  Срез - Структура - результат ВидимоеСодержимое.Срез.
//
// Возвращаемое значение:
//  Структура - ВсегоПакетов, ВсегоПулов, ПуловЛичных (тип user), ПуловКоманд
//              (default и custom).
//
Функция СводкаПоСрезу(Знач Срез) Экспорт

	Личных = 0;
	Для Каждого Пул Из Срез.Пулы Цикл
		Если Пул.ЭтоЛичный() Тогда
			Личных = Личных + 1;
		КонецЕсли;
	КонецЦикла;

	Всего = Срез.Пулы.Количество();

	Результат = Новый Структура();
	Результат.Вставить("ВсегоПакетов", Срез.Пакеты.Количество());
	Результат.Вставить("ВсегоПулов", Всего);
	Результат.Вставить("ПуловЛичных", Личных);
	Результат.Вставить("ПуловКоманд", Всего - Личных);
	Возврат Результат;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидимоеСодержимое") _Содержимое)

	Содержимое = _Содержимое;

КонецПроцедуры
