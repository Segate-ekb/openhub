// Витрина главной — желудь модуля web-ui: что показать на лендинге тому, кто смотрит.
// Разметки здесь нет — только данные; списки ограничены пределами, а не всей базой.

Перем Содержимое;    // ВидимоеСодержимое
Перем Статистика;    // СтатистикаХаба
Перем СервисВерсий;  // СервисВерсий (реестр)
Перем Скачивания;    // СлужбаСтатистикиСкачиваний (статистика)

#Область Пределы

// Сколько пулов помещается в обзор на главной.
//
// Возвращаемое значение:
//  Число
//
Функция ПределПулов() Экспорт
	Возврат 8;
КонецФункции

// Сколько карточек показывает один блок главной — новинки либо популярное.
// Витрина, а не лента: карточек 4–6, остальное живёт в каталоге.
//
// Возвращаемое значение:
//  Число
//
Функция ПределСписка() Экспорт
	Возврат 6;
КонецФункции

// Сколько последних версий поднимается из базы под отбор по видимости. Окно шире
// показываемого списка, потому что часть свежих версий смотрящему недоступна; всю
// таблицу версий главная не читает никогда.
//
// Возвращаемое значение:
//  Число
//
Функция ОкноВерсий() Экспорт
	Возврат 60;
КонецФункции

#КонецОбласти

// Модель главной страницы для запроса. Каждый список проходит тот же отбор видимости,
// что и числа: имя приватного пула и его пакета в модель не попадает.
//
// Параметры:
//  Принципал - Структура, Неопределено - (необязательный, по умолчанию Неопределено)
//              принципал запроса; Неопределено — аноним.
//
// Возвращаемое значение:
//  Структура - Сводка (см. СтатистикаХаба), Пулы (Массив из Структура Пул, Пакетов —
//              не больше ПределПулов, личные пространства в обзор не идут),
//              Новинки (Массив из Структура Пакет, Пул, Версия, Опубликована),
//              Популярные (Массив из Структура Пакет, Пул, Скачиваний, Версия, Обновлена),
//              Пусто (Булево — доступных пакетов нет вовсе).
//
Функция Обзор(Знач Принципал = Неопределено) Экспорт

	Срез = Содержимое.Срез(Принципал);
	ПулыПоИдентификатору = ПоИдентификатору(Срез.Пулы);

	Результат = Новый Структура();
	Результат.Вставить("Сводка", Статистика.СводкаПоСрезу(Срез));
	Результат.Вставить("Пулы", ОбзорПулов(Срез));
	Результат.Вставить("Новинки", Новинки(ПоИдентификатору(Срез.Пакеты), ПулыПоИдентификатору));
	Результат.Вставить("Популярные", Популярные(Срез, ПулыПоИдентификатору));
	Результат.Вставить("Пусто", Срез.Пакеты.Количество() = 0);
	Возврат Результат;

КонецФункции

#Область СлужебныеПроцедурыИФункции

// Личные пространства в обзор не идут: их столько же, сколько учёток, и они вытеснили бы
// пулы, ради которых на главную и приходят.
Функция ОбзорПулов(Знач Срез)

	Кандидаты = Новый Массив();

	Для Каждого Пул Из Срез.Пулы Цикл
		Если Пул.ЭтоЛичный() Тогда
			Продолжить;
		КонецЕсли;
		Пакетов = Срез.ПакетовВПуле.Получить(Цел(Пул.Идентификатор));
		Пакетов = ?(Пакетов = Неопределено, 0, Пакетов);
		Кандидаты.Добавить(Новый Структура("Элемент, Вес, Ключ",
			Новый Структура("Пул, Пакетов", Пул, Пакетов), Пакетов, НРег(Строка(Пул.Имя))));
	КонецЦикла;

	Возврат ПервыеПоВесу(Кандидаты, ПределПулов());

КонецФункции

// Версии приходят из базы уже упорядоченными по дате публикации, поэтому сортировать
// нечего: идём по окну и берём по одной свежей версии на пакет.
Функция Новинки(Знач ПакетыПоИдентификатору, Знач ПулыПоИдентификатору)

	Результат = Новый Массив();
	Показанные = Новый Соответствие();

	Для Каждого Версия Из СервисВерсий.ПоследниеВерсии(ОкноВерсий()) Цикл

		Если Результат.Количество() >= ПределСписка() Тогда
			Прервать;
		КонецЕсли;

		Если Версия.Отозвана = Истина Тогда
			Продолжить;
		КонецЕсли;

		Ключ = Цел(Версия.ПакетИдентификатор);
		Если Показанные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Пакет = ПакетыПоИдентификатору.Получить(Ключ);
		Если Пакет = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Показанные.Вставить(Ключ, Истина);
		Результат.Добавить(Новый Структура("Пакет, Пул, Версия, Опубликована",
			Пакет, ПулыПоИдентификатору.Получить(Цел(Пакет.ПулИдентификатор)),
			Строка(Версия.Версия), Версия.Опубликована));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Пакет без единого скачивания в список не идёт: строка с нулём популярностью не является.
Функция Популярные(Знач Срез, Знач ПулыПоИдентификатору)

	ПоПакетам = Скачивания.СкачиванияПоПакетам();
	Кандидаты = Новый Массив();

	Для Каждого Пакет Из Срез.Пакеты Цикл

		Всего = ПоПакетам.Получить(Цел(Пакет.Идентификатор));
		Если Всего = Неопределено ИЛИ Всего <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Элемент = Новый Структура("Пакет, Пул, Скачиваний",
			Пакет, ПулыПоИдентификатору.Получить(Цел(Пакет.ПулИдентификатор)), Всего);
		Кандидаты.Добавить(Новый Структура("Элемент, Вес, Ключ",
			Элемент, Всего, НРег(Строка(Пакет.Имя))));

	КонецЦикла;

	Отобранные = ПервыеПоВесу(Кандидаты, ПределСписка());
	ДополнитьПоследнейПубликацией(Отобранные);
	Возврат Отобранные;

КонецФункции

// Версия и дата последней публикации берутся разрезом по уже отобранной горстке пакетов,
// а не вопросом на карточку: главную открывают все и всегда. Версия нужна затем же, зачем
// она у новинок: ряд метрик у обоих блоков один и тот же.
Процедура ДополнитьПоследнейПубликацией(Записи)

	Идентификаторы = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Идентификаторы.Добавить(Цел(Запись.Пакет.Идентификатор));
	КонецЦикла;

	Публикации = СервисВерсий.ПоследниеПубликацииПакетов(Идентификаторы);

	Для Каждого Запись Из Записи Цикл
		Публикация = Публикации.Получить(Цел(Запись.Пакет.Идентификатор));
		Запись.Вставить("Версия", ?(Публикация = Неопределено, "", Публикация.Версия));
		Запись.Вставить("Обновлена", ?(Публикация = Неопределено, Неопределено, Публикация.Опубликована));
	КонецЦикла;

КонецПроцедуры

// Первые Предел элементов по убыванию веса — выборкой, а не сортировкой всего множества:
// список короткий, а кандидатов столько, сколько у смотрящего видимых пакетов.
Функция ПервыеПоВесу(Знач Кандидаты, Знач Предел)

	Результат = Новый Массив();
	Взятые = Новый Соответствие();

	Пока Результат.Количество() < Предел Цикл

		Лучший = -1;
		Для Индекс = 0 По Кандидаты.ВГраница() Цикл
			Если Взятые.Получить(Индекс) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Лучший < 0 ИЛИ Предпочтительнее(Кандидаты[Индекс], Кандидаты[Лучший]) Тогда
				Лучший = Индекс;
			КонецЕсли;
		КонецЦикла;

		Если Лучший < 0 Тогда
			Прервать;
		КонецЕсли;

		Взятые.Вставить(Лучший, Истина);
		Результат.Добавить(Кандидаты[Лучший].Элемент);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// При равном весе порядок задаёт ключ: без него две страницы подряд показывали бы разное.
Функция Предпочтительнее(Знач Претендент, Знач Текущий)
	Если Претендент.Вес <> Текущий.Вес Тогда
		Возврат Претендент.Вес > Текущий.Вес;
	КонецЕсли;
	Возврат Претендент.Ключ < Текущий.Ключ;
КонецФункции

Функция ПоИдентификатору(Знач Записи)

	Результат = Новый Соответствие();
	Для Каждого Запись Из Записи Цикл
		Результат.Вставить(Цел(Запись.Идентификатор), Запись);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидимоеСодержимое") _Содержимое,
	&Пластилин(Значение = "СтатистикаХаба") _Статистика,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СлужбаСтатистикиСкачиваний") _Скачивания)

	Содержимое = _Содержимое;
	Статистика = _Статистика;
	СервисВерсий = _СервисВерсий;
	Скачивания = _Скачивания;

КонецПроцедуры
