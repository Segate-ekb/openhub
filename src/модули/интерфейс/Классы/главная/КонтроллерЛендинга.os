// Контроллер лендинга — web-ui: GET / — поиск, обзор пулов, свежее и популярное,
// быстрый старт. Всё серверным рендером и обычными формами; оформление контроллер
// не трогает: тему из кук достаёт сам каркас страницы.

Перем Витрина;      // ВитринаГлавной
Перем Карточки;     // ВитринаПакетов
Перем КарточкиUI;   // КарточкаПакета
Перем ПлашкиПулов;  // ПлашкиПула
Перем Кит;          // Кит (oscript-ui) — фабрика элементов экрана
Перем Каркас;       // КаркасСтраницы (кит) — корень страницы
Перем НаборUI;      // НаборКомпонентов (кит)
Перем Тексты;       // ТекстыИнтерфейса (кит)
Перем Экран;        // ЭкранированиеHTML (кит)
Перем Бренд;        // Брендирование (web-ui) — знак и подпись инсталляции
Перем Гвард;        // ГвардОнбординга
Перем Перехватчик;  // ПерехватчикАутентификации (auth)
Перем Команды;      // КомандыOpm
Перем СервисПулов;  // СервисПулов (реестр)

// Отдаёт главную страницу.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - для определения принципала.
//  КукиЗапроса      - Куки         - сессия и оформление читателя.
//
&ТочкаМаршрута("/")
Процедура Показать(Ответ, ЗаголовкиЗапроса, КукиЗапроса) Экспорт

	Если НЕ Гвард.Проверить(Ответ).Разрешено Тогда
		Возврат;
	КонецЕсли;

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);
	Обзор = Витрина.Обзор(Принципал.Пользователь);

	Если Обзор.Пусто Тогда
		Витрины = ПустойХаб(Принципал.Пользователь);
	Иначе
		Витрины = БлокПулов(Обзор)
			+ БлокКарточек(Обзор.Новинки, Тексты.Текст("public.landing.fresh.title"),
				Тексты.Текст("public.landing.fresh.lead"), "история")
			+ БлокКарточек(Обзор.Популярные, Тексты.Текст("public.landing.popular.title"),
				Тексты.Текст("public.landing.popular.lead"), "скачать");
	КонецЕсли;

	Контент = Приветствие() + Витрины + БлокБыстрогоСтарта(ЗаголовкиЗапроса);

	// заголовок вкладки — подпись инсталляции: со знаком главная неотличима от любой
	// внутренней страницы хаба в закладках
	ОтдатьHTML(Ответ, Бренд.Подпись(), Контент, Принципал.Пользователь, КукиЗапроса);

КонецПроцедуры

#Область Рендер

// Первый экран — поиск: обычная GET-форма в существующий каталог, поэтому он работает
// без единой строки скрипта и у каждого запроса свой адрес.
Функция Приветствие()

	Компоненты = НаборUI;

	Поиск = Компоненты.ФормаОтбора().Отрисовать(
		Новый Структура("Действие, Метка, Плейсхолдер, Кнопка, Иконка",
			"/packages",
			Тексты.Текст("public.landing.search.label"),
			Тексты.Текст("public.landing.search.placeholder"),
			Тексты.Текст("public.landing.search.button"),
			"поиск"));

	Возврат Компоненты.Карточка().Отрисовать(
		Новый Структура("Заголовок, Уровень, Описание, Иконка, Тело, Действия",
			Бренд.Знак(), 1, Тексты.Текст("public.landing.lead"), "куб", Поиск,
			Компоненты.Кнопка().Отрисовать(Новый Структура("Подпись, Адрес, Иконка",
				Тексты.Текст("public.landing.catalog"), "/packages", "вправо"))));

КонецФункции

Функция БлокПулов(Знач Обзор)

	Компоненты = НаборUI;
	Ячейки = Новый Массив();

	Для Каждого Запись Из Обзор.Пулы Цикл
		Ячейки.Добавить(КарточкаПула(Запись));
	КонецЦикла;

	Если Ячейки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Тело = Компоненты.Сетка().Отрисовать(
		Новый Структура("Ячейки, Колонки, Заголовок", Ячейки, 4,
			Тексты.Текст("public.landing.pools.title")));

	// «показаны не все» говорим прямо: обзор ограничен пределом витрины
	Если Обзор.Сводка.ПуловКоманд > Ячейки.Количество() Тогда
		Тело = Тело + НаборUI.ЗаголовокСтраницы().Примечание(Экран.Экранировать(
			Тексты.Шаблон("public.landing.pools.more",
				Показатель(Ячейки.Количество()), Показатель(Обзор.Сводка.ПуловКоманд))), Истина);
	КонецЕсли;

	Возврат Компоненты.Карточка().Отрисовать(
		Новый Структура("Заголовок, Описание, Иконка, Тело",
			Тексты.Текст("public.landing.pools.title"),
			Тексты.Текст("public.landing.pools.lead"),
			"куб", Тело));

КонецФункции

// Роль пула на карточке — только содержательная: «Основной» (короткие адреса ведут сюда).
// Проектный тип не печатается: он у всех, кроме личных пространств, а их в обзоре нет.
Функция КарточкаПула(Знач Запись)

	Компоненты = НаборUI;
	Пул = Запись.Пул;

	Плашки = Новый Массив();
	Плашки.Добавить(ПлашкиПулов.ПлашкаОсновного(Пул));
	Плашки.Добавить(ПлашкиПулов.ПлашкаВидимости(Пул));

	Возврат Компоненты.Карточка().Отрисовать(
		Новый Структура("Заголовок, Уровень, Адрес, Описание, Иконка, Тело",
			Пул.Имя, 3, "/" + Пул.Имя,
			Тексты.Шаблон("public.landing.pools.packages", Показатель(Запись.Пакетов)),
			"куб", Компоненты.Тег().Ряд(Плашки)));

КонецФункции

// Витрина, а не лента: карточки идут сеткой, поэтому их видно все сразу и ни одна не
// требует прокрутки.
Функция БлокКарточек(Знач Записи, Знач Заголовок, Знач Пояснение, Знач ИмяИконки)

	Если Записи.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Компоненты = НаборUI;
	Ячейки = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Ячейки.Добавить(КарточкиUI.Карточка(МодельКарточки(Запись)).Рендер());
	КонецЦикла;

	// имя НЕ «Сетка»: так зовётся класс кита, а имена типов в OneScript глобальны
	Раскладка = Компоненты.Сетка().Отрисовать(
		Новый Структура("Ячейки, Колонки, Заголовок", Ячейки, 3, Заголовок));

	Возврат Компоненты.Карточка().Отрисовать(
		Новый Структура("Заголовок, Описание, Иконка, Тело",
			Заголовок, Пояснение, ИмяИконки, Раскладка));

КонецФункции

// Шестерёнку настроек лендинг не показывает: управление пакетом живёт в каталоге и на
// странице пакета, а витрина отвечает на вопрос «что тут вообще есть».
//
// Ряд метрик у обоих блоков ОДИН И ТОТ ЖЕ и в одном порядке: пул, версия, скачивания,
// дата. Блоки отличаются составом значений, а не порядком и оформлением, — иначе
// карточки соседних рядов читаются как разные сущности.
Функция МодельКарточки(Знач Запись)

	Модель = Карточки.Модель(Запись.Пакет, Запись.Пул);
	Мета = Новый Массив();
	Значение = Неопределено;

	Если Запись.Свойство("Версия", Значение) И ЗначениеЗаполнено(Значение) Тогда
		Модель.Вставить("Версия", Значение);
	КонецЕсли;

	Если Запись.Свойство("Скачиваний", Значение) Тогда
		Мета.Добавить(Новый Структура("Подпись, Значение",
			Тексты.Текст("public.landing.popular.downloads"), Показатель(Значение)));
	КонецЕсли;

	Если Запись.Свойство("Опубликована", Значение) Тогда
		ДобавитьДату(Мета, Значение, Тексты.Текст("public.landing.fresh.published"));
	КонецЕсли;

	Если Запись.Свойство("Обновлена", Значение) Тогда
		ДобавитьДату(Мета, Значение, Тексты.Текст("public.landing.popular.updated"));
	КонецЕсли;

	Модель.Вставить("Мета", Мета);
	Возврат Модель;

КонецФункции

// Подпись приходит уже текстом: ключ словаря обязан остаться литералом в вызове
// резолвера, иначе сборщик ключей его не увидит.
Процедура ДобавитьДату(Мета, Знач Значение, Знач Подпись)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;

	Мета.Добавить(Новый Структура("Подпись, Значение",
		Подпись, Формат(Значение, "ДФ=dd.MM.yyyy")));

КонецПроцедуры

// Свежий хаб не показывает нули в рамочках, а объясняет, что делать дальше. Вошедшему
// это проводник первой публикации, анониму — вход: проводник живёт за гвардом кабинета.
Функция ПустойХаб(Знач Пользователь)

	Если Пользователь = Неопределено Тогда
		Действие = Новый Структура("Подпись, Адрес, Вариант",
			Тексты.Текст("public.landing.empty.login"), "/login", "вторичная");
	Иначе
		Действие = Новый Структура("Подпись, Адрес, Вариант",
			Тексты.Текст("public.landing.empty.tour"), "/tour", "вторичная");
	КонецЕсли;

	Возврат НаборUI.ПустоеСостояние().Отрисовать(
		Новый Структура("Заголовок, Пояснение, Иконка, Действие",
			Тексты.Текст("public.landing.empty.title"),
			Тексты.Текст("public.landing.empty.lead"), "пакет", Действие));

КонецФункции

// Образец не сочиняется: узел берётся из настройки «URL инстанса», а при незаданной —
// из заголовка Host, пул — основной пул хаба. Неоткуда взять узел или основного пула нет —
// вместо образца стоит объяснение: конфигурация с чужим адресом не заработает ни у кого.
Функция БлокБыстрогоСтарта(Знач ЗаголовкиЗапроса)

	Старт = Кит.Карточка(Новый Структура("Заголовок, Иконка",
		Тексты.Текст("public.landing.start.title"), "скачать"));

	Узел = Команды.Узел(ЗаголовкиЗапроса);
	Основной = СервисПулов.ДефолтныйПул();

	Если НЕ ЗначениеЗаполнено(Узел) ИЛИ Основной = Неопределено Тогда
		Старт.Добавить(Кит.Примечание(Тексты.Текст("public.landing.start.unknown")));
		Возврат Старт.Рендер();
	КонецЕсли;

	Старт.Добавить(ОбразецНастройки(Основной, Узел));
	Старт.Добавить(ОбразецУстановки(Основной, Узел));

	Возврат Старт.Рендер();

КонецФункции

Функция ОбразецНастройки(Знач Пул, Знач Узел)

	Возврат Кит.БлокКоманды(Новый Структура("Команда, Пояснение, БезКопирования",
		Команды.ОписаниеСервера(Пул, Узел),
		Тексты.Текст("public.landing.start.config"), Истина));

КонецФункции

Функция ОбразецУстановки(Знач Пул, Знач Узел)

	Возврат Кит.БлокКоманды(Новый Структура("Команда, Пояснение",
		Команды.Установка(Пул, ОбразецИмениПакета(), Узел),
		Тексты.Текст("public.landing.start.install")));

КонецФункции

// Место имени пакета в образце команды: это часть команды, а не подпись экрана.
Функция ОбразецИмениПакета()
	Возврат "<имя-пакета>";
КонецФункции

#КонецОбласти

#Область Служебное

// Имя не «Число»: так называется встроенная функция платформы.
Функция Показатель(Знач Значение)
	Возврат Формат(?(ЗначениеЗаполнено(Значение), Значение, 0), "ЧН=0; ЧГ=0");
КонецФункции

Процедура ОтдатьHTML(Ответ, Знач Заголовок, Знач Контент, Знач Пользователь, Знач КукиЗапроса)
	Ответ.УстановитьСостояниеОК();
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Заголовок, Контент,
		Каркас.КонтекстСтраницы(Пользователь, КукиЗапроса));
КонецПроцедуры

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВитринаГлавной") _Витрина,
	&Пластилин(Значение = "ВитринаПакетов") _Карточки,
	&Пластилин(Значение = "КарточкаПакета") _КарточкиUI,
	&Пластилин(Значение = "ПлашкиПула") _ПлашкиПулов,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "НаборКомпонентов") _НаборUI,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "Брендирование") _Бренд,
	&Пластилин(Значение = "ГвардОнбординга") _Гвард,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "КомандыOpm") _Команды,
	&Пластилин(Значение = "СервисПулов") _СервисПулов)

	Витрина = _Витрина;
	Карточки = _Карточки;
	КарточкиUI = _КарточкиUI;
	ПлашкиПулов = _ПлашкиПулов;
	Кит = _Кит;
	Каркас = _Каркас;
	НаборUI = _НаборUI;
	Тексты = _Тексты;
	Экран = _Экран;
	Бренд = _Бренд;
	Гвард = _Гвард;
	Перехватчик = _Перехватчик;
	Команды = _Команды;
	СервисПулов = _СервисПулов;

КонецПроцедуры
