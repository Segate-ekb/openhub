// Переезды кабинета: редиректы со старых адресов — контроллер модуля web-ui.

Перем ДомАккаунта; // ДомАккаунта (web-ui)
Перем ДомХаба;     // ДомХаба (web-ui)
Перем ДомПула;     // ДомПула (web-ui)
Перем ДомПакета;   // ДомПакета (web-ui)
Перем ГвардКабинета; // ГвардКабинета (кабинет) — вход для редиректа, собираемого из данных
Перем СервисПулов;   // СервисПулов (реестр) — пул по идентификатору из закладки
Перем СервисПрав;    // СервисПрав (auth) — видно ли смотрящему этот пул
Перем Числа;         // ПриведениеЧисел (основа) — терпимое чтение числа

#Область ЛичныеРазделы

// Точка маршрута «office» — редирект на актуальный адрес.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//
&ТочкаМаршрута("office")
Процедура Кабинет(Ответ) Экспорт
	Ответ.Перенаправить(ДомАккаунта.АдресКабинета());
КонецПроцедуры

// Точка маршрута «office/settings» — редирект на актуальный адрес.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//
&ТочкаМаршрута("office/settings")
Процедура Настройки(Ответ) Экспорт
	Ответ.Перенаправить(ДомАккаунта.БазовыйАдрес());
КонецПроцедуры

// Точка маршрута «office/settings/profile» — редирект на актуальный адрес.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//
&ТочкаМаршрута("office/settings/profile")
Процедура Профиль(Ответ) Экспорт
	Ответ.Перенаправить(ДомАккаунта.АдресРаздела("profile"));
КонецПроцедуры

// Точка маршрута «office/password» — редирект на актуальный адрес.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//
&ТочкаМаршрута("office/password")
Процедура Пароль(Ответ) Экспорт
	Ответ.Перенаправить(ДомАккаунта.АдресРаздела("security"));
КонецПроцедуры

// Точка маршрута «office/tokens» — редирект на актуальный адрес.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//
&ТочкаМаршрута("office/tokens")
Процедура Токены(Ответ) Экспорт
	Ответ.Перенаправить(ДомАккаунта.АдресРаздела("tokens"));
КонецПроцедуры

// Точка маршрута «office/identities» — редирект на актуальный адрес.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//
&ТочкаМаршрута("office/identities")
Процедура Личности(Ответ) Экспорт
	Ответ.Перенаправить(ДомАккаунта.АдресРаздела("oidc"));
КонецПроцедуры

// Раздел «уведомления» снят: подписка — настройка объекта, ведём в личное пространство.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//
&ТочкаМаршрута("me/settings/notifications")
Процедура Уведомления(Ответ) Экспорт
	Ответ.Перенаправить(ДомАккаунта.АдресКабинета());
КонецПроцедуры

#КонецОбласти

#Область РазделыХаба

// Точка маршрута «office/admin» — редирект на актуальный адрес.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//
&ТочкаМаршрута("office/admin")
Процедура Пульт(Ответ) Экспорт
	Ответ.Перенаправить(ДомХаба.БазовыйАдрес());
КонецПроцедуры

// Точка маршрута «office/admin/users» — редирект на актуальный адрес.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//
&ТочкаМаршрута("office/admin/users")
Процедура Пользователи(Ответ) Экспорт
	Ответ.Перенаправить(ДомХаба.АдресРаздела("users"));
КонецПроцедуры

// Точка маршрута «office/admin/quotas» — редирект на актуальный адрес.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//
&ТочкаМаршрута("office/admin/quotas")
Процедура Квоты(Ответ) Экспорт
	Ответ.Перенаправить(АдресПулов());
КонецПроцедуры

// Точка маршрута «office/pools» — редирект на актуальный адрес.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//
&ТочкаМаршрута("office/pools")
Процедура УправлениеПулами(Ответ) Экспорт
	Ответ.Перенаправить(АдресПулов());
КонецПроцедуры

// Точка маршрута «office/access» — редирект на актуальный адрес.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//
&ТочкаМаршрута("office/access")
Процедура Доступ(Ответ) Экспорт
	Ответ.Перенаправить(АдресПулов());
КонецПроцедуры

// Точка маршрута «office/pools/grants» — редирект на права доступа пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  pool - Строка - идентификатор пула из адреса (необязательный, по умолчанию "").
//
&ТочкаМаршрута("office/pools/grants")
Процедура ПраваПула(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool = "") Экспорт
	ВестиНаПраваПула(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool);
КонецПроцедуры

// Точка маршрута «office/access/grants» — редирект на права доступа пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  pool - Строка - идентификатор пула из адреса (необязательный, по умолчанию "").
//
&ТочкаМаршрута("office/access/grants")
Процедура ЛегасиПраваПула(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool = "") Экспорт
	ВестиНаПраваПула(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool);
КонецПроцедуры

// Точка маршрута «office/access/groups» — редирект на права доступа пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  pool - Строка - идентификатор пула из адреса (необязательный, по умолчанию "").
//
&ТочкаМаршрута("office/access/groups")
Процедура ЛегасиГруппыПула(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool = "") Экспорт
	ВестиНаПраваПула(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool);
КонецПроцедуры

// Закладка на упразднённый экран прав ведёт туда, где эти права живут теперь. Единственный
// редирект кабинета, которому НУЖЕН вход: адрес назначения собирается из данных, и имя
// приватного пула, подставленное в Location, утекло бы анониму по перебору идентификаторов.
// Мейнтейнер попадает на свой раздел, остальные — в «Мои права», где виден их список пулов;
// 403 в ответ на чужой переезд человек прочитал бы как «у меня отняли доступ».
Процедура ВестиНаПраваПула(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач Идентификатор)

	Вердикт = ГвардКабинета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат; // аноним уже уведён на вход
	КонецЕсли;

	Пул = СервисПулов.ПулПоИдентификатору(Числа.ЧислоИлиНоль(Идентификатор));
	Если Пул = Неопределено ИЛИ НЕ СервисПрав.МожетЧитать(Вердикт.Пользователь, Пул) Тогда
		Ответ.Перенаправить(ДомАккаунта.АдресРаздела("permissions"));
		Возврат;
	КонецЕсли;

	Ответ.Перенаправить(ДомПула.АдресРаздела(Пул.Имя, "access"));

КонецПроцедуры

// Прочие старые адреса управления пулами ведут в один раздел: список, создание и квоты
// живут теперь там. Подадреса без своей точки приходят сюда же.
Функция АдресПулов()
	Возврат ДомХаба.АдресРаздела("pools");
КонецФункции

#КонецОбласти

#Область РазделыОбъектов

// Точка маршрута «office/pools/{pool}/settings» — редирект на актуальный адрес.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//
&ТочкаМаршрута("office/pools/{pool}/settings")
Процедура НастройкиПула(Ответ, pool) Экспорт
	Ответ.Перенаправить(ДомПула.БазовыйАдрес(pool));
КонецПроцедуры

// Точка маршрута «office/webhooks» — редирект на актуальный адрес.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//
&ТочкаМаршрута("office/webhooks")
Процедура ВебхукиОбзор(Ответ) Экспорт
	// общий обзор вебхуков снят — ведём в личное пространство
	Ответ.Перенаправить(ДомАккаунта.АдресКабинета());
КонецПроцедуры

// Точка маршрута «office/webhooks/{pool}» — редирект на актуальный адрес.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//
&ТочкаМаршрута("office/webhooks/{pool}")
Процедура ВебхукиПула(Ответ, pool) Экспорт
	Ответ.Перенаправить(ДомПула.АдресРаздела(pool, "webhooks"));
КонецПроцедуры

// Точка маршрута «office/package/{pool}/{name}» — редирект на актуальный адрес.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя из адреса.
//
&ТочкаМаршрута("office/package/{pool}/{name}")
Процедура НастройкиПакета(Ответ, pool, name) Экспорт
	Ответ.Перенаправить(ДомПакета.БазовыйАдрес(pool, name));
КонецПроцедуры

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ДомАккаунта") _ДомАккаунта,
	&Пластилин(Значение = "ДомХаба") _ДомХаба,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ДомПакета") _ДомПакета,
	&Пластилин(Значение = "ГвардКабинета") _ГвардКабинета,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа)

	ДомАккаунта = _ДомАккаунта;
	ДомХаба = _ДомХаба;
	ДомПула = _ДомПула;
	ДомПакета = _ДомПакета;
	ГвардКабинета = _ГвардКабинета;
	СервисПулов = _СервисПулов;
	СервисПрав = _СервисПрав;
	Числа = _Числа;

КонецПроцедуры
