// Контроллер пула — web-ui: GET /{pool} — шапка объекта и пакеты пула. Список пакетов —
// тот же каталог с отбором по пулу, не собственное представление.

Перем Каталог;       // КаталогПакетов
Перем Витрина;       // ВитринаПакетов
Перем КарточкиUI;    // КарточкаПакета
Перем Плашки;        // ПлашкиПула
Перем Каркас;        // КаркасСтраницы (кит) — корень страницы
Перем НаборUI;       // НаборКомпонентов (кит)
Перем Тексты;        // ТекстыИнтерфейса (кит)
Перем Экран;         // ЭкранированиеHTML (кит)
Перем Гвард;         // ГвардОнбординга
Перем Перехватчик;   // ПерехватчикАутентификации (auth)
Перем ЧтениеПула;    // ГвардДоступаКПулу (auth)
Перем СервисПрав;    // СервисПрав (auth) — порог входа в дом настроек пула

// Отдаёт страницу пула. Приватный пул означает, что приватны все его пакеты, поэтому
// несуществующий и нечитаемый пул дают ОДИНАКОВЫЙ 404: иначе перебором имён аноним
// выяснял бы, какие приватные пулы существуют.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  pool             - Строка       - имя пула из пути.
//  ЗаголовкиЗапроса - Соответствие - для определения принципала.
//  КукиЗапроса      - Куки         - сессия и оформление читателя.
//  ПутьЗапроса      - Строка       - путь текущего запроса: по нему меню подсвечивает
//                     дорогу (личное пространство человека — это тоже страница пула).
//
&ТочкаМаршрута("{pool}")
Процедура Показать(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, ПутьЗапроса) Экспорт

	Если НЕ Гвард.Проверить(Ответ).Разрешено Тогда
		Возврат;
	КонецЕсли;

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);

	Пул = ЧтениеПула.ЧитаемыйПул(Принципал.Пользователь, pool, Принципал);
	Если Пул = Неопределено Тогда
		ОтдатьНеНайдено(Ответ, Тексты.Шаблон("public.pool.notfound", pool),
			Принципал.Пользователь, КукиЗапроса, ПутьЗапроса);
		Возврат;
	КонецЕсли;

	Выдача = Каталог.НайтиПакеты("", 1, 0, Принципал,
		Новый Структура("Пул, ТолькоУправляемые", Пул.Имя, Ложь));

	Контент = Шапка(Пул, Выдача.Всего, Принципал.Пользователь)
		+ НаборUI.ЗаголовокСтраницы().Отрисовать(Новый Структура("Заголовок, Уровень",
			Тексты.Текст("public.pool.packages.title"), 2))
		+ СписокПакетов(Выдача, Принципал.Пользователь);

	Ответ.УстановитьСостояниеОК();
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Пул.Имя, Контент,
		Каркас.КонтекстСтраницы(Принципал.Пользователь, КукиЗапроса, Ложь, Ложь, ПутьЗапроса));

КонецПроцедуры

#Область Рендер

Функция Шапка(Знач Пул, Знач ВсегоПакетов, Знач Пользователь)

	Модель = Плашки.ШапкаПула(Пул, ВсегоПакетов);
	Модель.Вставить("Действия", ДействияШапки(Пул, Пользователь));

	Возврат НаборUI.ШапкаОбъекта().Отрисовать(Модель);

КонецФункции

// Кнопка видна только тому, кого дом настроек пула действительно пустит.
Функция ДействияШапки(Знач Пул, Знач Пользователь)

	Если НЕ СервисПрав.МожетАдминистрировать(Пользователь, Пул) Тогда
		Возврат "";
	КонецЕсли;

	Возврат НаборUI.Кнопка().Отрисовать(
		Новый Структура("Подпись, Адрес, Вариант, Иконка",
			Тексты.Текст("public.pool.settings"), АдресНастроек(Пул), "вторичная", "шестерёнка"));

КонецФункции

// Адрес дома настроек пула — единственное место сборки: собранные на месте разъезжаются.
Функция АдресНастроек(Знач Пул)
	Возврат "/" + Пул.Имя + "/settings";
КонецФункции

Функция СписокПакетов(Знач Выдача, Знач Пользователь)

	Компоненты = НаборUI;

	Если Выдача.Элементы.Количество() = 0 Тогда
		Возврат Компоненты.ПустоеСостояние().Отрисовать(
			Новый Структура("Заголовок, Пояснение, Иконка",
				Тексты.Текст("public.pool.empty.title"),
				Тексты.Текст("public.pool.empty.lead"), "куб"));
	КонецЕсли;

	Список = КарточкиUI.Список(Витрина.Карточки(Выдача.Элементы, Пользователь)).Рендер();

	Если Выдача.ВсегоСтраниц > 1 Тогда
		Список = Список + Компоненты.Кнопка().Отрисовать(
			Новый Структура("Подпись, Адрес, Вариант, Иконка",
				Тексты.Текст("public.pool.all-packages"), АдресКаталога(Выдача.Отбор.Пул), "вторичная", "вправо"));
	КонецЕсли;

	Возврат Список;

КонецФункции

Функция АдресКаталога(Знач ИмяПула)
	Возврат "/packages?pool=" + КодироватьСтроку(Строка(ИмяПула), СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Сообщение приходит СЫРЫМ, экранирует получатель — общий контракт одноимённых процедур слоя.
Процедура ОтдатьНеНайдено(Ответ, Знач Сообщение, Знач Пользователь, Знач КукиЗапроса,
	Знач ПутьЭкрана)
	Ответ.УстановитьСостояниеНеНайдено();
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Тексты.Текст("settings.reply.notfound.title"),
		НаборUI.СтраницаОшибки().Отрисовать(
			Новый Структура("Код, Сообщение", 404, Сообщение))
			+ Экран.Ссылка("/packages", Тексты.Текст("public.catalog.back")),
		Каркас.КонтекстСтраницы(Пользователь, КукиЗапроса, Ложь, Ложь, ПутьЭкрана));
КонецПроцедуры

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаталогПакетов") _Каталог,
	&Пластилин(Значение = "ВитринаПакетов") _Витрина,
	&Пластилин(Значение = "КарточкаПакета") _КарточкиUI,
	&Пластилин(Значение = "ПлашкиПула") _Плашки,
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "НаборКомпонентов") _НаборUI,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ГвардОнбординга") _Гвард,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "ГвардДоступаКПулу") _ЧтениеПула,
	&Пластилин(Значение = "СервисПрав") _СервисПрав)

	Каталог = _Каталог;
	Витрина = _Витрина;
	КарточкиUI = _КарточкиUI;
	Плашки = _Плашки;
	Каркас = _Каркас;
	НаборUI = _НаборUI;
	Тексты = _Тексты;
	Экран = _Экран;
	Гвард = _Гвард;
	Перехватчик = _Перехватчик;
	ЧтениеПула = _ЧтениеПула;
	СервисПрав = _СервисПрав;

КонецПроцедуры
