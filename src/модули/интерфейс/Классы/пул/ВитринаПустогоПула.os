// Пустой пул на экране — желудь модуля web-ui. Читателю он объясняет пустоту, а
// администратору предлагает путь из неё: первая публикация либо перенос из другого хаба.

Перем Кит;             // Кит (кит) — фабрика элементов экрана
Перем Тексты;          // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем СервисПрав;      // СервисПрав (auth) — порог «администратор пула»
Перем АдресаКабинета;  // АдресаКабинета (web-ui) — проводник первой публикации
Перем ДомПула;         // ДомПула (web-ui) — адрес раздела зеркал
Перем Параметры;       // ПараметрыСсылки (основа) — параметр запроса на адресе

#Область ПубличныйИнтерфейс

// Разметка пула, в котором нет ни одного пакета.
//
// Параметры:
//  Пул - Пул - открытый пул.
//  Пользователь - Пользователь, Неопределено - смотрящий; гость — Неопределено.
//
// Возвращаемое значение:
//  Строка - разметка.
//
Функция Разметка(Знач Пул, Знач Пользователь) Экспорт

	Если НЕ СервисПрав.МожетАдминистрировать(Пользователь, Пул) Тогда
		Возврат Пустота();
	КонецЕсли;

	Возврат Пустота() + ПредложениеПутей(Пул);

КонецФункции

#КонецОбласти

#Область Рендер

// Пустота глазами читателя: пакетов нет, и делать ему здесь нечего.
Функция Пустота()

	Возврат Кит.ПустоеСостояние(Новый Структура("Заголовок, Пояснение, Иконка",
		Тексты.Текст("public.pool.empty.title"),
		Тексты.Текст("public.pool.empty.lead"), "куб")).Рендер();

КонецФункции

// Пустота глазами того, кто пулом распоряжается: из неё есть выход, и вот он.
Функция ПредложениеПутей(Знач Пул)

	Возврат Кит.Карточка(Новый Структура("Заголовок, Иконка, Действия",
		Тексты.Текст("public.pool.start.title"), "стрелка",
		ПутьКПубликации() + ПутьКПереносу(Пул))).Рендер();

КонецФункции

// Путь к публикации один на весь хаб — тот же проводник, что в кабинете.
Функция ПутьКПубликации()

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Иконка",
		Тексты.Текст("public.pool.start.publish"),
		АдресаКабинета.Проводник(), "основная", "плюс")).Рендер();

КонецФункции

// Пулу, которому внешние источники недопустимы по типу, переносить нечем: зеркала
// личному пространству не заводятся.
Функция ПутьКПереносу(Знач Пул)

	Если НЕ Пул.АпстримыДопустимы() Тогда
		Возврат "";
	КонецЕсли;

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Иконка",
		Тексты.Текст("public.pool.start.migrate"),
		АдресПереноса(Пул), "вторичная", "копировать")).Рендер();

КонецФункции

// Заведение зеркала с предвыбранным режимом переноса: привезённое становится своим.
Функция АдресПереноса(Знач Пул)

	Возврат Параметры.Установить(
		ДомПула.АдресРаздела(Пул.Имя, "mirrors"), "migrate", "1");

КонецФункции

#КонецОбласти

&Прозвище("ВитринаПустогоПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "АдресаКабинета") _АдресаКабинета,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ПараметрыСсылки") _Параметры) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	СервисПрав = _СервисПрав;
	АдресаКабинета = _АдресаКабинета;
	ДомПула = _ДомПула;
	Параметры = _Параметры;

КонецПроцедуры
