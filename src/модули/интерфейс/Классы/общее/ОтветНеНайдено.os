// Отказ по адресу актива — один на статику и на брендовые картинки: их адреса
// объявлены неизменяемыми, поэтому отказ обязан унести кэш-заголовки с собой.

Перем Кэш;     // ЗаголовкиКэша (основа)
Перем Тексты;  // ТекстыИнтерфейса

// Отдаёт 404 текстом. Зовётся и до, и после того, как на ответ встали заголовки
// неизменяемого содержимого: годовой срок жизни и метка снимаются здесь, иначе общий
// кэш запомнил бы отказ на год и вернувшийся файл не доехал бы до посетителя.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//
Процедура Отдать(Ответ) Экспорт

	Кэш.НеКэшировать(Ответ);
	Ответ.УстановитьСостояниеНеНайдено();
	Ответ.Заголовки["Content-Type"] = "text/plain; charset=utf-8";
	Ответ.ТелоТекст = Тексты.Текст("public.static.notfound");

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЗаголовкиКэша") _Кэш,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кэш = _Кэш;
	Тексты = _Тексты;

КонецПроцедуры
