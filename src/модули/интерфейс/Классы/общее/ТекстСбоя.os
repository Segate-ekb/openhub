// Сбой операции экрана словами человека — желудь модуля web-ui. Гейт один на все экраны:
// наружу уходит понятная фраза без служебной обёртки OneScript и без внутренностей хаба,
// полный отчёт с цепочкой причин остаётся в журнале. Отказ без слов подменяется запасным
// объяснением: пустая красная плашка не сообщает ничего.
//
// Класс лёгкий нарочно. Живёт он в интерфейсе, а не в основе, потому что запасное
// объяснение — строка словаря кита, а основа о ките не знает; и отдельно от ОтветыНастроек,
// потому что пульту, которому нужна одна фраза, незачем брать зависимость на каркас страниц.

Перем Ошибки;  // ТекстОшибки (основа) — причина строкой и полный отчёт по цепочке
Перем Тексты;  // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Причина пойманного сбоя, как её читает человек. Информация приезжает параметром:
// достоверна она только в кадре обработчика исключения.
//
// Параметры:
//  Инфо - ИнформацияОбОшибке - результат ИнформацияОбОшибке() вызывающего.
//
// Возвращаемое значение:
//  Строка - причина отказа человеку; сбой без текста называет себя общей фразой.
//
Функция Человеку(Знач Инфо) Экспорт

	Если Лог <> Неопределено Тогда
		Лог.Отладка("Экран: операция отклонена сбоем:%1%2", Символы.ПС, Ошибки.ПодробныйОтчёт(Инфо));
	КонецЕсли;

	Возврат ПонятныйТекст(Ошибки.ДляЧеловека(Инфо));

КонецФункции

// Причина, уже названная доменом словами: остаётся проверить, что человеку есть что читать.
//
// Параметры:
//  Текст - Строка - причина отказа, как её назвал домен.
//
// Возвращаемое значение:
//  Строка - тот же текст либо запасное объяснение.
//
Функция ПонятныйТекст(Знач Текст) Экспорт
	Возврат ?(ЗначениеЗаполнено(Текст), Текст, Тексты.Текст("settings.reply.error.internal"));
КонецФункции

#КонецОбласти

&Прозвище("ТекстСбоя")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Лог _Лог = Неопределено) Экспорт

	Ошибки = _Ошибки;
	Тексты = _Тексты;

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
