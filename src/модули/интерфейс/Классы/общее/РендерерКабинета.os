// Рендерер кабинета — желудь модуля web-ui: старый путь сборки экрана приватной части.
// Каркас страницы даёт кит, здесь остались формы, кнопки и делегаты.

Перем Каркас;     // КаркасСтраницы (кит) — корень страницы
Перем Экран;      // ЭкранированиеHTML (кит)
Перем Защита;     // ЗащитаCSRF (auth) - только для имени CSRF-поля
Перем НаборUI;    // НаборКомпонентов (кит)
Перем Тексты;     // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

// Экранирует произвольный текст.
//
// Параметры:
//  Текст - Строка - текст.
//
// Возвращаемое значение:
//  Строка - экранированный текст.
//
Функция Экранировать(Знач Текст) Экспорт
	Возврат Экран.Экранировать(Текст);
КонецФункции

// Безопасная ссылка с фильтрацией схемы URL.
//
// Параметры:
//  Адрес - Строка - адрес.
//  Текст - Строка - текст.
//  Класс - Строка - CSS-класс (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Строка - безопасная ссылка с фильтрацией схемы URL.
//
Функция Ссылка(Знач Адрес, Знач Текст, Знач Класс = "") Экспорт
	Возврат Экран.Ссылка(Адрес, Текст, Класс);
КонецФункции

// Набор компонентов слоя рендера — для контроллеров кабинета (Карточка, Поле, Таблица…).
//
// Возвращаемое значение:
//  НаборКомпонентов - набор.
//
Функция Компоненты() Экспорт
	Возврат НаборUI;
КонецФункции

// Контекст запроса для сборки страницы приватной части: она помечается приватной,
// и каркас отличает её от публичной.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - принципал запроса.
//  КукиЗапроса - Куки, Неопределено - куки запроса winow (передаются ЯВНО).
//  ПоказатьАдмин - Булево - показывать ли админские дороги там, где спросить о правах некого (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура - контекст запроса для Страница().
//
Функция КонтекстСтраницы(Знач Пользователь, Знач КукиЗапроса, Знач ПоказатьАдмин = Ложь) Экспорт
	Возврат Каркас.КонтекстСтраницы(Пользователь, КукиЗапроса, ПоказатьАдмин, Истина);
КонецФункции

// Полная HTML-страница кабинета вокруг готового (безопасного) содержимого.
//
// Параметры:
//  Заголовок - Строка - заголовок вкладки.
//  Содержимое - Строка - доверенный HTML (собран через Экранировать/компоненты/формы).
//  Контекст - Структура - контекст запроса (КонтекстСтраницы): пользователь для шапки, куки запроса (оформление достаёт каркас сам) и флаг ПоказатьАдмин для навигации кабинета. Кабинет всегда за гвардом, поэтому пользователь в норме заполнен.
//
// Возвращаемое значение:
//  Строка - HTML-документ.
//
Функция Страница(Знач Заголовок, Знач Содержимое, Знач Контекст) Экспорт
	Возврат Каркас.Страница(Заголовок, Содержимое, Контекст);
КонецФункции

// Кнопка отправки формы — компонент кита.
//
// Параметры:
//  Подпись - Строка - надпись кнопки.
//  Вариант - Строка - вид: "вторичная" (по умолчанию) | "основная" | "опасная" (необязательный, по умолчанию "вторичная").
//  Размер - Строка - "малый" (по умолчанию) | "обычный" | "большой" (необязательный, по умолчанию "малый").
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент кнопки.
//
Функция КнопкаФормы(Знач Подпись, Знач Вариант = "вторичная", Знач Размер = "малый") Экспорт
	Возврат НаборUI.Кнопка().Отрисовать(
		Новый Структура("Подпись, Вариант, Размер", Подпись, Вариант, Размер));
КонецФункции

// Скрытое CSRF-поле для мутирующей формы.
//
// Параметры:
//  Токен - Строка - CSRF-токен сессии (ЗащитаCSRF.ТокенСессии).
//
// Возвращаемое значение:
//  Строка - скрытое поле ввода (input type=hidden).
//
Функция ПолеCSRF(Знач Токен) Экспорт
	Возврат СкрытоеПоле(Защита.ИмяПоля(), Токен);
КонецФункции

// Скрытое поле формы — компонент кита «СкрытоеПоле».
//
// Параметры:
//  Имя - Строка - имя поля формы.
//  Значение - Строка - значение (экранируется компонентом).
//
// Возвращаемое значение:
//  Строка - скрытое поле ввода (input type=hidden).
//
Функция СкрытоеПоле(Знач Имя, Знач Значение) Экспорт
	Возврат НаборUI.СкрытоеПоле().Отрисовать(
		Новый Структура("Имя, Значение", Имя, Значение));
КонецФункции

// Абзац-примечание мелким шрифтом — компонент «ЗаголовокСтраницы».
//
// Параметры:
//  Содержимое - Строка - ДОВЕРЕННЫЙ HTML: текст из словаря (СловарьТекстов) и ссылки, собранные методом Ссылка. Пользовательский ввод сюда не кладут — для него есть Экранировать.
//
// Возвращаемое значение:
//  Строка - <p class="muted">…</p>.
//
Функция Примечание(Знач Содержимое) Экспорт
	Возврат НаборUI.ЗаголовокСтраницы().Примечание(Содержимое, Истина);
КонецФункции

// Пользовательская строка по ключу словаря (делегат ТекстыИнтерфейса).
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - пользовательская строка по ключу словаря (делегат ТекстыИнтерфейса).
//
Функция Текст(Знач Ключ) Экспорт
	Возврат Тексты.Текст(Ключ);
КонецФункции

// Пользовательская строка по ключу с подстановками (делегат ТекстыИнтерфейса).
//
// Параметры:
//  Ключ - Строка - ключ.
//  П1 - Произвольный - подстановка шаблона (необязательный, по умолчанию Неопределено).
//  П2 - Произвольный - подстановка шаблона (необязательный, по умолчанию Неопределено).
//  П3 - Произвольный - подстановка шаблона (необязательный, по умолчанию Неопределено).
//  П4 - Произвольный - подстановка шаблона (необязательный, по умолчанию Неопределено).
//  П5 - Произвольный - подстановка шаблона (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Строка - пользовательская строка по ключу с подстановками (делегат ТекстыИнтерфейса).
//
Функция Шаблон(Знач Ключ, Знач П1 = Неопределено, Знач П2 = Неопределено,
	Знач П3 = Неопределено, Знач П4 = Неопределено, Знач П5 = Неопределено) Экспорт
	Возврат Тексты.Шаблон(Ключ, П1, П2, П3, П4, П5);
КонецФункции

// Заголовок страницы или блока — компонент кита «ЗаголовокСтраницы».
//
// Параметры:
//  Текст - Строка - текст заголовка (экранируется компонентом).
//  Уровень - Число - 1 (страница, по умолчанию) либо 2 (блок) (необязательный, по умолчанию 1).
//  Пояснение - Строка - сырой текст пояснения «мелким шрифтом» (экранируется) (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент.
//
Функция Заголовок(Знач Текст, Знач Уровень = 1, Знач Пояснение = "") Экспорт
	Возврат НаборUI.ЗаголовокСтраницы().Отрисовать(
		Новый Структура("Заголовок, Уровень, Пояснение", Текст, Уровень, Пояснение));
КонецФункции

// Мутирующая форма POST с CSRF-полем.
//
// Параметры:
//  Действие - Строка - URL действия (внутренний путь).
//  Токен - Строка - CSRF-токен сессии.
//  Внутренности - Строка - HTML полей и кнопок формы (доверенный).
//  Класс - Строка - необязательный CSS-класс формы.
//  Подтверждение - Структура, Неопределено - вопрос, который задаёт браузер перед отправкой:
//                  Вопрос (текст диалога), Поле (имя поля подтверждения), Значение
//                  (значение, которого ждёт сервер). Поле формой НЕ печатается: без скрипта
//                  форма уходит без подтверждения, и вопрос задаёт сервер отдельным шагом.
//
// Возвращаемое значение:
//  Строка - HTML-форма.
//
Функция Форма(Знач Действие, Знач Токен, Знач Внутренности, Знач Класс = "",
	Знач Подтверждение = Неопределено) Экспорт

	АтрибутКласса = ?(ЗначениеЗаполнено(Класс), СтрШаблон(" class=""%1""", Экранировать(Класс)), "");
	Возврат СтрШаблон("<form method=""post"" action=""%1""%2%3>",
			Экранировать(Действие), АтрибутКласса, АтрибутыПодтверждения(Подтверждение))
		+ ПолеCSRF(Токен)
		+ Внутренности
		+ "</form>";

КонецФункции

Функция АтрибутыПодтверждения(Знач Подтверждение)

	Если ТипЗнч(Подтверждение) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(" data-confirm=""%1"" data-confirm-field=""%2"" data-confirm-value=""%3""",
		Экранировать(Подтверждение.Вопрос),
		Экранировать(Подтверждение.Поле),
		Экранировать(Подтверждение.Значение));

КонецФункции

// Сообщение-уведомление — компонент «Тост».
//
// Параметры:
//  Текст - Строка - текст (экранируется).
//  Вид - Строка - "ok" | "warn" | "err" (необязательный, по умолчанию "ok").
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент уведомления.
//
Функция Баннер(Знач Текст, Знач Вид = "ok") Экспорт
	Возврат НаборUI.Тост().Отрисовать(Новый Структура("Текст, Вид", Текст, Вид));
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "НаборКомпонентов") _Компоненты,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	Каркас = _Каркас;
	Экран = _Экран;
	Защита = _Защита;
	НаборUI = _Компоненты;
	Тексты = _Тексты;

КонецПроцедуры
