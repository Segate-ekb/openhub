// Дела вошедшего одним снимком: непрочитанное ленты и очередь заявок на решение.
// Шапка и главная кабинета спрашивают одно и то же, и снимок снимается ОДИН раз на запрос:
// без него страница «/me» читала бы ленту дважды — на счётчик меню и на виджет.

Перем Лента;         // ЛентаУведомлений (уведомления) — личные события вошедшего
Перем Рассмотрение;  // РассмотрениеВходящих (публикация) — заявки, доступные принципалу
Перем ВитринаЛенты;  // ВитринаУведомлений (web-ui) — сколько строк показывает виджет

// Снимок дел вошедшего. Живёт в пределах одного запроса: изменения ленты и очереди
// он не видит, и переживший страницу снимок показывал бы вчерашние числа.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - вошедший; гостю дел не бывает.
//  Принципал - Структура, Неопределено - принципал запроса: по нему отбирается очередь.
//
// Возвращаемое значение:
//  Структура - Непрочитано (Число), Свежие (Массив из ЛичноеУведомление — верхние строки
//              виджета), НаРешение (Число), Заявки (Массив из Структура — строки очереди).
//
Функция Снять(Знач Пользователь, Знач Принципал) Экспорт

	Если Пользователь = Неопределено Тогда
		Возврат Снимок(0, Новый Массив(), Новый Массив());
	КонецЕсли;

	Непрочитанное = Лента.СводкаНепрочитанного(Пользователь, ВитринаЛенты.ПределВиджета());
	Возврат Снимок(Непрочитанное.Непрочитано, Непрочитанное.Свежие,
		Рассмотрение.ОжидающиеПринципала(Принципал));

КонецФункции

#Область СлужебныеПроцедурыИФункции

// Число ждущих решения — длина очереди: и шапка, и виджет говорят об одних и тех же
// строках, поэтому считать их вторым запросом незачем.
Функция Снимок(Знач Непрочитано, Знач Свежие, Знач Заявки)

	Возврат Новый Структура("Непрочитано, Свежие, НаРешение, Заявки",
		Цел(Непрочитано), Свежие, Заявки.Количество(), Заявки);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЛентаУведомлений") _Лента,
	&Пластилин(Значение = "РассмотрениеВходящих") _Рассмотрение,
	&Пластилин(Значение = "ВитринаУведомлений") _ВитринаЛенты) Экспорт

	Лента = _Лента;
	Рассмотрение = _Рассмотрение;
	ВитринаЛенты = _ВитринаЛенты;

КонецПроцедуры
