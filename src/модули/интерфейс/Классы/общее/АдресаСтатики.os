// Под каким адресом отдаётся каждый файл поставки. Имена своих файлов знает СтатикаХаба,
// китовых — РаскладкаСтатики, отпечаток и правило адреса — АктивыСтатики; здесь они сходятся.

Перем Активы;   // АктивыСтатики (кит) — адрес по имени файла
Перем Статика;  // СтатикаХаба (основа) — имена файлов инсталляции
Перем Место;    // РаскладкаСтатики (кит) — имена файлов, которые везёт библиотека

#Область ПубличныйИнтерфейс

// Адрес таблицы стилей.
//
// Возвращаемое значение:
//  Строка
//
Функция АдресСтилей() Экспорт
	Возврат Активы.Адрес(Статика.ФайлСтилей());
КонецФункции

// Адрес прогрессивного скрипта.
//
// Возвращаемое значение:
//  Строка
//
Функция АдресСкрипта() Экспорт
	Возврат Активы.Адрес(Статика.ФайлСкрипта());
КонецФункции

// Адрес иконки сайта.
//
// Возвращаемое значение:
//  Строка
//
Функция АдресИконки() Экспорт
	Возврат Активы.Адрес(Статика.ФайлИконки());
КонецФункции

// Тип контента иконки сайта — нужен разметке <link type="…">, чтобы тип не разъехался
// с белым списком отдачи.
//
// Возвращаемое значение:
//  Строка
//
Функция ТипИконки() Экспорт
	Возврат Статика.ТипИконки();
КонецФункции

// Адрес запасной иконки сайта — многоразмерного .ico для тех, кто не берёт SVG.
//
// Возвращаемое значение:
//  Строка
//
Функция АдресЗапаснойИконки() Экспорт
	Возврат Активы.Адрес(Статика.ФайлЗапаснойИконки());
КонецФункции

// Адрес знака бренда — того, что стоит в шапке сайта рядом с названием.
//
// Возвращаемое значение:
//  Строка
//
Функция АдресЗнака() Экспорт
	Возврат Активы.Адрес(Статика.ФайлЗнака());
КонецФункции

// Адрес иконки для домашнего экрана мобильного устройства.
//
// Возвращаемое значение:
//  Строка
//
Функция АдресИконкиДомашнегоЭкрана() Экспорт
	Возврат Активы.Адрес(Статика.ФайлИконкиДомашнегоЭкрана());
КонецФункции

// Ключи значков провайдеров входа. Список закрытый и принадлежит киту: всё, чего в нём
// нет, значка не получает.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция КлючиЗначков() Экспорт
	Возврат Место.КлючиЗначков();
КонецФункции

// Адрес значка провайдера входа.
//
// Параметры:
//  Ключ - Строка - ключ значка.
//
// Возвращаемое значение:
//  Строка - адрес с отпечатком содержимого либо "" для ключа вне списка.
//
Функция АдресЗначка(Знач Ключ) Экспорт
	Возврат Активы.Адрес(Место.ФайлЗначка(Ключ));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "АктивыСтатики") _Активы,
	&Пластилин(Значение = "СтатикаХаба") _Статика,
	&Пластилин(Значение = "РаскладкаСтатики") _Место) Экспорт

	Активы = _Активы;
	Статика = _Статика;
	Место = _Место;

КонецПроцедуры
