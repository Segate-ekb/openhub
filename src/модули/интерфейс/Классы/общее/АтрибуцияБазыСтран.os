// Строка атрибуции встроенной базы стран — требование её лицензии (DB-IP Lite, CC BY 4.0).
// Стоит на страницах, которые пользуются результатом, и только пока правило по стране есть,
// а построенный по базе индекс жив: ссылка на пустом месте обещала бы работу, которой не было.

Перем Кит;          // Кит (кит) — фабрика элементов экрана
Перем Геоправило;   // ГеоправилоПровайдера (вход) — есть ли на хабе хоть одно правило
Перем Определитель; // ОпределительСтраны (гео) — жив ли индекс, построенный по базе
Перем Тексты;       // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Узел атрибуции для страницы: примечание со ссылкой либо пустой узел.
//
// Возвращаемое значение:
//  ЭлементЭкрана.
//
Функция Примечание() Экспорт

	Если НЕ Печатается() Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Ссылка = Кит.Ссылка(Адрес());
	Ссылка.Добавить(Кит.Текст(Тексты.Текст("geo.attribution.dbip")));

	Результат = Кит.Примечание();
	Результат.Добавить(Ссылка);
	Возврат Результат;

КонецФункции

// Адрес, на который ведёт атрибуция.
//
// Возвращаемое значение:
//  Строка.
//
Функция Адрес() Экспорт
	Возврат "https://db-ip.com";
КонецФункции

// Обязана ли страница нести атрибуцию прямо сейчас. Лицензия требует назвать источник,
// пока хаб пользуется производным от базы, — то есть пока жив ПОСТРОЕННЫЙ по ней индекс.
// Файл на диске тут ни при чём: унесённый файл индекс в памяти не отменяет.
//
// Атрибуция — украшение страницы, и сорваться на ней страница не вправе: не смогли
// узнать состояние — не печатаем.
//
// Возвращаемое значение:
//  Булево.
//
Функция Печатается() Экспорт

	Попытка
		Возврат Геоправило.ЕстьПравила() И Определитель.НаблюдаемыеСтраны().Количество() > 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

#КонецОбласти

&Прозвище("АтрибуцияБазыСтран")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ГеоправилоПровайдера") _Геоправило,
	&Пластилин(Значение = "ОпределительСтраны") _Определитель,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Геоправило = _Геоправило;
	Определитель = _Определитель;
	Тексты = _Тексты;

КонецПроцедуры
