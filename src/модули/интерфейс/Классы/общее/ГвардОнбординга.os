// Пока в хабе нет ни одного пользователя, любой заход на публичную страницу уводит на мастер
// первого запуска. Не подключается к /setup, /login и /register — они обязаны быть достижимы.

Перем Онбординг;   // ОнбордингПервогоЗапуска (auth)
Перем Вердикты;    // ВердиктГварда (права) — форма ответа гварда

// Путь редиректа на мастер первого запуска.
//
// Возвращаемое значение:
//  Строка
//
Функция ПутьНастройки() Экспорт
	Возврат "/setup";
КонецФункции

// Проверяет, доступна ли публичная страница. Если нужен онбординг — сам записывает
// редирект в Ответ, и контроллер обязан сразу выйти.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow, для редиректа.
//
// Возвращаемое значение:
//  Структура - вердикт гварда: Разрешено (Булево) и Причина (Строка).
//
Функция Проверить(Ответ) Экспорт

	Если Онбординг.НуженОнбординг() Тогда
		Ответ.Перенаправить(ПутьНастройки());
		Возврат Вердикты.Отказ("онбординг");
	КонецЕсли;

	Возврат Вердикты.Пропуск();

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОнбордингПервогоЗапуска") _Онбординг,
	&Пластилин(Значение = "ВердиктГварда") _Вердикты = Неопределено)

	Онбординг = _Онбординг;
	Вердикты = ?(_Вердикты = Неопределено, Новый ВердиктГварда(), _Вердикты);

КонецПроцедуры
