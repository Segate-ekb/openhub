// Реализация контракта «НеизвестныйАдресСловами»: страница «адрес не найден», которую хаб
// отдаёт по адресу, не объявленному ни одним маршрутом, — в обрамлении хаба и с навигацией.

Перем Каркас;          // КаркасСтраницы (кит) — корень страницы и навигация смотрящего
Перем Кит;             // Кит (кит) — элементы страницы
Перем Тексты;          // ТекстыИнтерфейса (кит) — строки по ключам
Перем Перехватчик;     // ПерехватчикАутентификации (вход) — кто смотрит: от этого зависит меню
Перем АдресаКаталога;  // АдресаКаталога — куда вернуться

#Область ПубличныйИнтерфейс

// Фраза посетителю.
//
// Возвращаемое значение:
//  Строка - фраза для человека.
//
Функция Фраза() Экспорт
	Возврат Тексты.Текст("public.notfound.address");
КонецФункции

// Страница «адрес не найден» целиком.
//
// Параметры:
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса: по ним узнаётся смотрящий.
//  КукиЗапроса - Куки, Неопределено - куки запроса: сессия и выбор оформления.
//  ПутьЗапроса - Строка - путь запроса: по нему меню подсвечивает дорогу.
//
// Возвращаемое значение:
//  Строка - HTML-документ.
//
Функция Страница(Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ПутьЗапроса) Экспорт

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);

	Возврат Каркас.Страница(Тексты.Текст("settings.reply.notfound.title"), Содержимое(),
		Каркас.КонтекстСтраницы(Принципал.Пользователь, КукиЗапроса, Ложь, Ложь, ПутьЗапроса));

КонецФункции

#КонецОбласти

// Что стоит на странице: код 404 с фразой и ход обратно в каталог.
Функция Содержимое()

	Тело = Кит.Холст();
	Тело.Добавить(Кит.СтраницаОшибки(Новый Структура("Код, Сообщение", 404, Фраза())));
	Тело.Добавить(ХодВКаталог());
	Возврат Тело;

КонецФункции

Функция ХодВКаталог()
	Возврат Кит.Ссылка(АдресаКаталога.Каталог())
		.Добавить(Кит.Текст(Тексты.Текст("public.catalog.back"))).Родитель();
КонецФункции

&Прозвище("НеизвестныйАдресСловами")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "АдресаКаталога") _АдресаКаталога) Экспорт

	Каркас = _Каркас;
	Кит = _Кит;
	Тексты = _Тексты;
	Перехватчик = _Перехватчик;
	АдресаКаталога = _АдресаКаталога;

КонецПроцедуры
