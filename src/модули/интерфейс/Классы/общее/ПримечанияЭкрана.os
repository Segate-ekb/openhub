// Примечания под содержимым — желудь модуля web-ui. Пустая таблица и пустой список
// выглядят одинаково на всех экранах, и вариант этого вида назван здесь один раз.

Перем Кит;  // Кит (кит) — узлы экрана

// Примечание вместо содержимого: показывать нечего.
//
// Параметры:
//  Текст - Строка - что сказать человеку вместо списка или таблицы.
//
// Возвращаемое значение:
//  ЭлементЭкрана - примечание в виде «пусто».
//
Функция Пусто(Знач Текст) Экспорт
	Возврат Кит.Примечание(Текст, ВидПустоты());
КонецФункции

// Вид примечания, которым кит рисует пустоту.
//
// Возвращаемое значение:
//  Строка.
//
Функция ВидПустоты() Экспорт
	Возврат "пусто";
КонецФункции

&Прозвище("ПримечанияЭкрана")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "Кит") _Кит) Экспорт
	Кит = _Кит;
КонецПроцедуры
