// Значки меты — желудь модуля web-ui: реестр «подпись метаданных → имя иконки».
// Подписи здесь — словарь предметной области ХАБА (пул, версия, лицензия, скачиваний),
// поэтому реестр живёт в web-ui, а не в ките: ряд меты значки только печатает.
// Незнакомая подпись значка не получает: решение, что с ней делать, принимает компонент.

Перем Значки;

// Имя иконки для подписи элемента метаданных.
//
// Параметры:
//  Подпись - Строка - подпись элемента, например "скачиваний"; регистр и пробелы по краям
//            значения не имеют.
//
// Возвращаемое значение:
//  Строка - имя иконки из НаборИконок либо "" для незнакомой подписи.
//
Функция Значок(Знач Подпись) Экспорт

	Если НЕ ЗначениеЗаполнено(Подпись) Тогда
		Возврат "";
	КонецЕсли;

	Имя = Значки.Получить(НРег(СокрЛП(Строка(Подпись))));
	Возврат ?(Имя = Неопределено, "", Имя);

КонецФункции

// Подписи, у которых значок есть.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция Подписи() Экспорт

	Результат = Новый Массив();
	Для Каждого КиЗ Из Значки Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Проставляет элементам ряда меты имя значка по их подписи. Уже проставленный значок
// не трогает: явное указание вызывающего сильнее реестра.
//
// Параметры:
//  Элементы - Массив из Структура - элементы ряда меты; дополняются на месте.
//
// Возвращаемое значение:
//  Массив из Структура - те же элементы.
//
Функция Оснастить(Знач Элементы) Экспорт

	Если ТипЗнч(Элементы) <> Тип("Массив") Тогда
		Возврат Элементы;
	КонецЕсли;

	Для Каждого Элемент Из Элементы Цикл

		Если ТипЗнч(Элемент) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Имеющийся = "";
		Если Элемент.Свойство("Значок", Имеющийся) И ЗначениеЗаполнено(Имеющийся) Тогда
			Продолжить;
		КонецЕсли;

		Подпись = "";
		Если НЕ Элемент.Свойство("Подпись", Подпись) Тогда
			Продолжить;
		КонецЕсли;

		Элемент.Вставить("Значок", Значок(Подпись));

	КонецЦикла;

	Возврат Элементы;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт

	Значки = Новый Соответствие();

	Значки.Вставить("пул", "стопка");
	Значки.Вставить("версия", "закладка");
	Значки.Вставить("автор", "аккаунт");
	Значки.Вставить("скачиваний", "скачать");
	Значки.Вставить("лицензия", "весы");
	Значки.Вставить("пакетов", "пакет");
	Значки.Вставить("опубликована", "часы");
	Значки.Вставить("обновлён", "история");

КонецПроцедуры
