// Urlencoded-тело и разобранная winow составная форма (multipart) сводятся к одному виду:
// Соответствие имя→значение плюс отдельная коллекция файлов.

#Использовать url

// Разбирает тело формы в Соответствие имя→значение.
//
// Параметры:
//  ТелоЗапроса - Строка, Неопределено - сырое тело (a=1&b=2), уже как строка.
//
// Возвращаемое значение:
//  Соответствие - поля формы (ключи и значения URL-декодированы).
//
Функция Разобрать(Знач ТелоЗапроса) Экспорт

	Результат = Новый Соответствие();
	Для Каждого Пара Из Пары(ТелоЗапроса) Цикл
		Если Результат.Получить(Пара.Имя) = Неопределено Тогда
			Результат.Вставить(Пара.Имя, Пара.Значение); // первое значение поля
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Все значения повторяющегося поля: группа флажков с одним именем приезжает столькими
// парами, сколько отмечено, и в Соответствие имя→значение помещается только первая.
//
// Параметры:
//  ТелоЗапроса - Строка, Неопределено - сырое тело (a=1&a=2), уже как строка.
//  Имя - Строка - имя поля.
//
// Возвращаемое значение:
//  Массив из Строка - значения в порядке отправки; пустой, если поля в теле нет.
//
Функция Значения(Знач ТелоЗапроса, Знач Имя) Экспорт

	Найденные = Новый Массив();
	Для Каждого Пара Из Пары(ТелоЗапроса) Цикл
		Если Пара.Имя = Имя Тогда
			Найденные.Добавить(Пара.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Найденные;

КонецФункции

// Значение поля формы по имени с приведением к строке и значением по умолчанию.
//
// Параметры:
//  Форма - Соответствие - результат Разобрать.
//  Имя - Строка - имя поля.
//  ПоУмолчанию - Строка - значение при отсутствии поля (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Строка - значение поля.
//
Функция Поле(Знач Форма, Знач Имя, Знач ПоУмолчанию = "") Экспорт

	Если Форма = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Значение = Форма.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

// Состояние поля-флажка (checkbox или тумблер) из формы.
//
// Параметры:
//  Форма - Соответствие - результат Разобрать.
//  Имя - Строка - имя поля.
//  ЗначениеВключено - Строка - значение, означающее «включено» (по умолчанию "1" — его печатают и ПолеФормы(тип «флажок»), и Тумблер) (необязательный, по умолчанию "1").
//
// Возвращаемое значение:
//  Булево.
//
Функция Флажок(Знач Форма, Знач Имя, Знач ЗначениеВключено = "1") Экспорт
	Возврат СокрЛП(Поле(Форма, Имя)) = СокрЛП(Строка(ЗначениеВключено));
КонецФункции

// Целое неотрицательное поле: пустое → ПоУмолчанию, не целое → Неопределено (ноль значим).
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//  Имя - Строка - имя поля.
//  ПоУмолчанию - Произвольный - значение для пустого поля (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Число, Неопределено, Произвольный - см. выше.
//
Функция ЦелоеПоле(Знач Форма, Знач Имя, Знач ПоУмолчанию = Неопределено) Экспорт

	Значение = СокрЛП(Поле(Форма, Имя, ""));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Для Поз = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, Поз, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	Возврат Число(Значение);

КонецФункции

// Прислана ли форма составной (multipart): winow разбирает её сам и кладёт части
// в магический параметр точки маршрута «ДанныеФормы».
//
// Параметры:
//  ДанныеФормы - ДанныеСоставнойФормы, Неопределено - части разобранной формы.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоСоставная(Знач ДанныеФормы) Экспорт
	Возврат ДанныеФормы <> Неопределено И Частей(ДанныеФормы) > 0;
КонецФункции

// Текстовые части составной формы в том же виде, что и urlencoded-тело: части с именем
// файла сюда не попадают — их отдаёт Файлы.
//
// Параметры:
//  ДанныеФормы - ДанныеСоставнойФормы, Неопределено - части разобранной формы.
//
// Возвращаемое значение:
//  Соответствие - имя поля -> значение (Строка).
//
Функция РазобратьСоставную(Знач ДанныеФормы) Экспорт

	Результат = Новый Соответствие();
	Если НЕ ЭтоСоставная(ДанныеФормы) Тогда
		Возврат Результат;
	КонецЕсли;

	Для Индекс = 0 По Частей(ДанныеФормы) - 1 Цикл
		Часть = ДанныеФормы.ПолучитьПоИндексу(Индекс);
		Имя = ПараметрЧасти(Часть, "name");
		Если НЕ ЗначениеЗаполнено(Имя) ИЛИ ЗначениеЗаполнено(ПараметрЧасти(Часть, "filename")) Тогда
			Продолжить;
		КонецЕсли;
		Если Результат.Получить(Имя) = Неопределено Тогда
			Результат.Вставить(Имя, ТекстЧасти(Часть)); // первое значение поля
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Файловые части составной формы.
//
// Параметры:
//  ДанныеФормы - ДанныеСоставнойФормы, Неопределено - части разобранной формы.
//
// Возвращаемое значение:
//  Соответствие - имя поля -> Структура(ИмяФайла, ТипКонтента, Данные).
//
Функция Файлы(Знач ДанныеФормы) Экспорт

	Результат = Новый Соответствие();
	Если НЕ ЭтоСоставная(ДанныеФормы) Тогда
		Возврат Результат;
	КонецЕсли;

	Для Индекс = 0 По Частей(ДанныеФормы) - 1 Цикл
		Часть = ДанныеФормы.ПолучитьПоИндексу(Индекс);
		Имя = ПараметрЧасти(Часть, "name");
		ИмяФайла = ПараметрЧасти(Часть, "filename");
		Если НЕ ЗначениеЗаполнено(Имя) ИЛИ НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
			Продолжить;
		КонецЕсли;
		Если Результат.Получить(Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(Имя, Новый Структура("ИмяФайла, ТипКонтента, Данные",
			ИмяФайла, ТипЧасти(Часть), Часть.Значение));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Файл по имени поля.
//
// Параметры:
//  Коллекция - Соответствие - результат Файлы.
//  Имя - Строка - имя поля.
//
// Возвращаемое значение:
//  Структура, Неопределено - см. Файлы.
//
Функция Файл(Знач Коллекция, Знач Имя) Экспорт
	Возврат ?(Коллекция = Неопределено, Неопределено, Коллекция.Получить(Имя));
КонецФункции

#Область СоставнаяФорма

Функция Частей(Знач ДанныеФормы)
	Попытка
		Возврат ДанныеФормы.Количество();
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

// Один и тот же параметр приезжает от разных источников в разных серверах winow.
Функция ПараметрЧасти(Знач Часть, Знач Параметр)

	Метаданные = Неопределено;
	Если ТипЗнч(Часть) = Тип("Структура") Тогда
		Часть.Свойство("Метаданные", Метаданные);
	КонецЕсли;
	Если ТипЗнч(Метаданные) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого КиЗ Из Метаданные Цикл
		Если ТипЗнч(КиЗ.Значение) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;
		Найдено = КиЗ.Значение.Получить(Параметр);
		// вложенное соответствие — это не значение параметра, а следующий уровень метаданных
		Если ТипЗнч(Найдено) = Тип("Строка") И ЗначениеЗаполнено(СокрЛП(Найдено)) Тогда
			Возврат СокрЛП(Найдено);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ТипЧасти(Знач Часть)

	Значение = ПараметрЧасти(Часть, "ТипКонтента");
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ПараметрЧасти(Часть, "Content-Type"));

КонецФункции

Функция ТекстЧасти(Знач Часть)

	Если Часть.Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат СокрЛП(ПолучитьСтрокуИзДвоичныхДанных(Часть.Значение));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

#КонецОбласти

// И Разобрать, и Значения читают тело отсюда: разбор один — библиотечный, по правилам
// application/x-www-form-urlencoded. Безымянная пара полем формы не считается.
Функция Пары(Знач ТелоЗапроса)

	Найденные = Новый Массив();
	Если НЕ ЗначениеЗаполнено(ТелоЗапроса) Тогда
		Возврат Найденные;
	КонецЕсли;

	Для Каждого Пара Из Новый ПараметрыЗапросаURL(Строка(ТелоЗапроса)).ВМассив() Цикл
		Если ЗначениеЗаполнено(Пара.Имя) Тогда
			Найденные.Добавить(Пара);
		КонецЕсли;
	КонецЦикла;

	Возврат Найденные;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
