// Контроллер загруженных картинок оформления — web-ui: GET /brand/{файл}. Сегмент {файл}
// сравнивается ЦЕЛИКОМ с публичными именами активов из базы; диска здесь нет вовсе.

Перем Активы;      // СервисБрендовыхАктивов (настройки)
Перем ПустыеКуки;  // Куки (winow) — пустая коллекция для снятия Set-Cookie
Перем Ответы;      // ОтветыAPI (auth)
Перем Заголовки;   // ЗаголовкиКэша (основа) — ETag и разбор If-None-Match
Перем НеНайдено;   // ОтветНеНайдено — общий отказ по адресу актива

// Отдаёт загруженную картинку: 200 с телом, 304 по If-None-Match либо 404 для адреса,
// которому в базе ничего не соответствует.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  файл             - Строка       - имя файла с отпечатком из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса (If-None-Match).
//
&ТочкаМаршрута("{файл}")
Процедура Отдать(Ответ, файл, ЗаголовкиЗапроса) Экспорт

	// куку снимаем ПЕРВЫМ делом: она не нужна ни на 200, ни на 304, ни на 404
	Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);

	Ключ = Активы.КлючПоПубличномуИмени(Строка(файл));
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		НеНайдено.Отдать(Ответ);
		Возврат;
	КонецЕсли;

	Сведения = Активы.Сведения(Ключ);
	Метка = Заголовки.Метка(Сведения.Отпечаток);

	Ответ.Заголовки["Cache-Control"] = Заголовки.НеизменяемыйКэш();
	Если ЗначениеЗаполнено(Метка) Тогда
		Ответ.Заголовки["ETag"] = Метка;
		Если Заголовки.СовпадаетETag(ЗаголовкиЗапроса, Метка) Тогда
			Ответ.УстановитьСостояние(304);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Содержимое = Активы.Содержимое(Ключ);
	Если Содержимое = Неопределено Тогда
		// гонка со сбросом между чтением сведений и чтением байтов
		НеНайдено.Отдать(Ответ);
		Возврат;
	КонецЕсли;

	Ответ.УстановитьСостояниеОК();
	Ответ.Заголовки["Content-Type"] = Сведения.ТипКонтента;
	Ответ.ТелоДвоичныеДанные = Содержимое;

КонецПроцедуры

&Контроллер("/brand")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисБрендовыхАктивов") _Активы,
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ЗаголовкиКэша") _Заголовки,
	&Пластилин(Значение = "Куки") _ПустыеКуки,
	&Пластилин(Значение = "ОтветНеНайдено") _НеНайдено)

	Активы = _Активы;
	Ответы = _Ответы;
	Заголовки = _Заголовки;
	ПустыеКуки = _ПустыеКуки; // никогда не мутируется: подменяет Ответ.Куки
	НеНайдено = _НеНайдено;

КонецПроцедуры
