// Напильник обработчика запросов winow: обёртка ОбработчикСКэшемСтраниц. &Порядок(800) ставит её
// снаружи обёрток адреса клиента и отметки токена, но внутри перевода сбоя в слова.

// BSLLS:MissingVariablesDescription-off
Перем Поделка;
// BSLLS:MissingVariablesDescription-on

// Подменяет обработчик запросов winow обёрткой с кэшем страниц гостя.
//
// Параметры:
//  Желудь - ОбработчикЗапросов - собранный желудь winow.
//  ОпределениеЖелудя - ОпределениеЖелудя - определение подменяемого желудя.
//
// Возвращаемое значение:
//  ОбработчикСКэшемСтраниц
//
Функция ОбработатьЖелудь(Желудь, ОпределениеЖелудя) Экспорт
	Возврат Новый ОбработчикСКэшемСтраниц(Желудь, Поделка.НайтиЖелудь("КэшСтраницАнонима"));
КонецФункции

&Напильник(ПрименяетсяТолькоНа = "ОбработчикЗапросов")
&Порядок(800)
Процедура ПриСозданииОбъекта(&Пластилин("Поделка") _Поделка)
	Поделка = _Поделка;
КонецПроцедуры
