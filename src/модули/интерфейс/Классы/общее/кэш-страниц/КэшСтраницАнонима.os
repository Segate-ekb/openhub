// Готовые страницы каталога для гостя: отдача из памяти, пересборка устаревшей в фоне, сброс
// по изменениям. Вошедший и запрос с ключом доступа мимо кэша.

Перем Кэши;           // Табакерка МенеджерКэшей (autumn-cache)
Перем Фон;            // ЗапускВФоне (фоновыеЗадания); Неопределено — устаревшая собирается в запросе
Перем Перехватчик;    // ПерехватчикАутентификации (вход)
Перем Заголовки;      // ЗаголовкиHTTP (основа)
Перем ПравилаКэша;    // ЗаголовкиКэша (основа) — сверка If-None-Match
Перем ВыборВида;      // ВыборОформления (кит) — имя и разбор куки оформления
Перем Токены;         // ТокеныТемы (кит) — как страница читает поля оформления
Перем СвоиПресеты;    // ФиксированноеСоответствие — ключи пресетов кита, кроме пресета по умолчанию
Перем Команды;        // КомандыOpm — узел хаба, который страница печатает в командах opm
Перем Настройки;      // СервисНастроек (настройки) — выключатель; Неопределено — кэш включён
Перем Поделка;
Перем Лог;
Перем Замок;          // БлокировкаРесурса — поколение и реестр пересборок
Перем Поколение;      // Число — растёт с каждым сбросом; запись чужого поколения не отдаётся
Перем Пересборки;     // ФиксированноеСоответствие — ключи страниц, которые сейчас собираются в фоне
Перем ПределПересборок; // Число — сколько страниц собирается в фоне одновременно
Перем СессияПересборки; // СессияПользователя (winow) — одна на все фоновые сборки
Перем Страницы;       // ФиксированноеСоответствие — шаблон маршрута → параметры адреса, которые читает страница
Перем ИзмененияГостя; // ФиксированноеСоответствие — шаблоны маршрутов, где гость меняет видимое гостям
Перем СвежестьМс;     // Число — до этого возраста запись отдаётся как есть
Перем ПределМс;       // Число — старше этого запись не отдаётся вовсе

#Область ПубличныйИнтерфейс

// Ответ на запрос: страница гостю — из кэша, остальное — обёрнутым обработчиком.
//
// Параметры:
//  Запрос - ВходящийЗапрос - запрос winow.
//  Обработчик - ОбработчикЗапросов - обработчик, который собирает ответ без кэша.
//
// Возвращаемое значение:
//  Ответ - ответ winow.
//
Функция СформироватьОтвет(Запрос, Обработчик) Экспорт

	Если НЕ ЗапросГостяНаЧтение(Запрос) ИЛИ НЕ Включён() Тогда
		Ответ = Обработчик.СформироватьОтвет(Запрос);
		СброситьПослеИзменения(Запрос, Ответ);
		Возврат Ответ;
	КонецЕсли;

	Ключ = КлючСтраницы(Запрос.Путь, Запрос.ПараметрыИменные, Узел(Запрос.Заголовки), Оформление(Запрос.Куки));
	Запись = Прочитать(Ключ);
	Если Запись <> Неопределено Тогда
		Если Возраст(Запись) >= СвежестьМс Тогда
			ОбновитьУстаревшую(Ключ, Запись, Обработчик);
		КонецЕсли;
		Возврат ОтветИзЗаписи(Запись, Запрос);
	КонецЕсли;

	ПоколениеСборки = Поколение;
	Ответ = Обработчик.СформироватьОтвет(Запрос);
	СброситьПослеИзменения(Запрос, Ответ);
	Запомнить(Ключ, Ответ, Запрос.ШаблонМаршрута, ОбразецЗапроса(Запрос), ПоколениеСборки);
	Возврат Ответ;

КонецФункции

// Забывает все страницы: следующий гость получит собранную заново.
//
Процедура Сбросить() Экспорт

	Замок.Заблокировать();
	Поколение = Поколение + 1;
	Замок.Разблокировать();

	Попытка
		Кэш().Очистить();
	Исключение
		// записи прошлого поколения не отдаются и без очистки
		Лог.Предупреждение("Кэш страниц гостя не очищен: %1", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Подписчик событий: изменение, видимое гостю, сбрасывает кэш.
//
// Параметры:
//  Событие - Структура - Тип, Когда, Данные.
//
Процедура ОбработатьСобытие(Знач Событие) Экспорт // BSLLS:UnusedParameters-off
	Сбросить();
КонецПроцедуры

// Пересобирает страницу по образцу запроса и кладёт её в кэш. Зовёт фоновое задание.
//
// Параметры:
//  Ключ - Строка - ключ страницы.
//  Образец - ФиксированнаяСтруктура - то, от чего страница зависит, см. ОбразецЗапроса.
//  Обработчик - ОбработчикЗапросов - обработчик, который собирает ответ без кэша.
//  ПоколениеСборки - Число - поколение на момент запуска.
//
Процедура Пересобрать(Знач Ключ, Знач Образец, Знач Обработчик, Знач ПоколениеСборки) Экспорт

	Попытка
		Запрос = ЗапросПоОбразцу(Образец);
		Ответ = Обработчик.СформироватьОтвет(Запрос);
		Если ГодитсяВКэш(Ответ, Запрос.ШаблонМаршрута) Тогда
			Запомнить(Ключ, Ответ, Запрос.ШаблонМаршрута, Образец, ПоколениеСборки);
		Иначе
			// страница перестала быть годной (пакет удалён, пул закрыт): старую не отдаём
			Кэш().Удалить(Ключ);
		КонецЕсли;
	Исключение
		Лог.Ошибка("Страница гостя %1 не пересобрана: %2", Образец.ПолныйПуть, ОписаниеОшибки());
	КонецПопытки;

	СнятьПересборку(Ключ);

КонецПроцедуры

#КонецОбласти

#Область Годность

// Гость: ни куки сессии, ни ключа доступа — без них перехватчик пользователя не найдёт.
Функция ЗапросГостяНаЧтение(Знач Запрос)

	Если ВРег(Запрос.Метод) <> "GET" ИЛИ НЕ ПутьКаталога(Запрос.Путь) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат НЕ ЕстьУчётныеДанные(Запрос);

КонецФункции

// Дешёвый отсев до принципала, настроек и ключа: API, скачивание и статика страницами каталога не бывают.
Функция ПутьКаталога(Знач Путь)
	Путь = Строка(Путь);
	Возврат Путь = "/" ИЛИ СтрНачинаетсяС(Путь, "/packages") ИЛИ СтрНачинаетсяС(Путь, "/pools");
КонецФункции

Функция ЕстьУчётныеДанные(Знач Запрос)

	Если Запрос.Куки <> Неопределено
		И Запрос.Куки.ПолучитьЗначениеПоИмени(Перехватчик.ИмяКукиСессии()) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ЗначениеЗаполнено(Перехватчик.ИзвлечьТокен(Запрос.Заголовки));

КонецФункции

// Страницу кладём, только если она одна на всех гостей: 200, HTML, без своих кук и без запрета хранить.
Функция ГодитсяВКэш(Знач Ответ, Знач ШаблонМаршрута)

	Если Страницы.Получить(ШаблонСтраницы(ШаблонМаршрута)) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Строка(Ответ.СостояниеКод) <> "200" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ СтрНачинаетсяС(НРег(Заголовки.Текст(Ответ.Заголовки, "Content-Type")), "text/html") Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Ответ.ТелоТекст) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(Ответ.ТелоТекст)
		ИЛИ Ответ.ТелоПоток <> Неопределено ИЛИ Ответ.ТелоФайл <> Неопределено
		ИЛИ Ответ.ТелоДвоичныеДанные <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрНайти(НРег(Заголовки.Текст(Ответ.Заголовки, "Cache-Control")), "no-store") > 0
		ИЛИ СтрНайти(НРег(Заголовки.Текст(Ответ.Заголовки, "Cache-Control")), "private") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат НЕ ЕстьСвоиКуки(Ответ);

КонецФункции

// Куку сессии winow ставит каждому ответу, хаб её не читает; любая другая — признак ответа одному.
Функция ЕстьСвоиКуки(Знач Ответ)

	Если Ответ.Куки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ИмяСессииWinow = Поделка.НайтиЖелудь("МенеджерСессий").ИмяКукаСессии();
	Для Каждого Кука Из Ответ.Куки.Получить() Цикл
		Если Кука.Ключ <> ИмяСессииWinow Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// winow склеивает адрес контроллера и точки маршрута; «/packages/» и «/packages» — один шаблон.
Функция ШаблонСтраницы(Знач ШаблонМаршрута)

	Шаблон = СтрЗаменить(Строка(ШаблонМаршрута), "\", "/");
	Пока СтрДлина(Шаблон) > 1 И СтрЗаканчиваетсяНа(Шаблон, "/") Цикл
		Шаблон = Лев(Шаблон, СтрДлина(Шаблон) - 1);
	КонецЦикла;
	Возврат Шаблон;

КонецФункции

// Изменение через хаб сбрасывает кэш: запрос не на чтение без отказа (код < 400) от вошедшего или
// с ключом доступа, кроме запросов к страницам каталога; гостевой запрос, меняющий видимое гостям
// (регистрация заводит личный пул, а события у этого нет); ответ, выдающий куку сессии (вход, первичная
// настройка, возврат OIDC — он GET), но не гасящий её (выход).
// Прочие запросы не на чтение кэш не трогают: иначе любой гость или учётка держали бы его пустым.
// Фоновые изменения сбрасывают его событиями.
Процедура СброситьПослеИзменения(Знач Запрос, Знач Ответ)

	Код = 0;
	Попытка
		Код = Число(Ответ.СостояниеКод);
	Исключение
		Возврат;
	КонецПопытки;
	Если Код >= 400 Тогда
		Возврат;
	КонецЕсли;

	Если ВыдаётСессию(Ответ) Тогда
		Сбросить();
		Возврат;
	КонецЕсли;

	Метод = ВРег(Запрос.Метод);
	Если Метод = "GET" ИЛИ Метод = "HEAD" ИЛИ Метод = "OPTIONS" Тогда
		Возврат;
	КонецЕсли;
	Шаблон = ШаблонСтраницы(Запрос.ШаблонМаршрута);
	Если ИзмененияГостя.Получить(Шаблон) <> Неопределено Тогда
		Сбросить();
	ИначеЕсли Страницы.Получить(Шаблон) = Неопределено И ОтВошедшего(Запрос) Тогда
		Сбросить();
	КонецЕсли;

КонецПроцедуры

// Кука сессии сама по себе ничего не доказывает: поддельная вернула бы сброс любому гостю.
Функция ОтВошедшего(Знач Запрос)
	Если НЕ ЕстьУчётныеДанные(Запрос) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Перехватчик.ОпределитьПринципала(Запрос.Заголовки, Запрос.Куки).Пользователь <> Неопределено;
КонецФункции

Функция ВыдаётСессию(Знач Ответ)
	Если Ответ.Куки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ЗначениеЗаполнено(Ответ.Куки.ПолучитьЗначениеПоИмени(Перехватчик.ИмяКукиСессии()));
КонецФункции

// Выключатель читается на каждом запросе: СервисНастроек держит значение в памяти, а правка
// действует без перезапуска.
Функция Включён()
	Если Настройки = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Настройки.Флаг(КлючВыключателя(), Истина);
КонецФункции

Функция КлючВыключателя()
	Возврат "oshub.cache.guest_pages";
КонецФункции

#КонецОбласти

#Область КлючИОбразец

// Всё, от чего у гостя зависит разметка страницы, кроме состояния хаба: путь, параметры адреса
// в порядке имён, узел команд opm и оформление.
Функция КлючСтраницы(Знач Путь, Знач ПараметрыАдреса, Знач УзелЗапроса, Знач ЗначениеОформления)
	// перевод строки не встречается ни в пути, ни в заголовке, а параметры и оформление закодированы
	Возврат СтрШаблон("%1%2%3%2%4%2%5", Путь, Символы.ПС, ПараметрыКлюча(ПараметрыАдреса), УзелЗапроса,
		ЗначениеОформления);
КонецФункции

// Порядок параметров страницу не меняет: «?q=a&page=2» и «?page=2&q=a» — одна запись.
Функция ПараметрыКлюча(Знач ПараметрыАдреса)

	Если ПараметрыАдреса = Неопределено ИЛИ ПараметрыАдреса.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Пары = Новый СписокЗначений();
	Для Каждого КиЗ Из ПараметрыАдреса Цикл
		Пары.Добавить(Закодировать(КиЗ.Ключ) + "=" + Закодировать(КиЗ.Значение));
	КонецЦикла;
	Пары.СортироватьПоЗначению();
	Возврат СтрСоединить(Пары.ВыгрузитьЗначения(), "&");

КонецФункции

Функция Закодировать(Знач Значение)
	Возврат КодироватьСтроку(Строка(Значение), СпособКодированияСтроки.КодировкаURL);
КонецФункции

// Страница с параметром, которого она не читает, в кэш не идёт: иначе перебор «?x=1..N» множил бы записи.
Функция ПараметрыИзвестны(Знач ПараметрыАдреса, Знач ШаблонМаршрута)

	Известные = Страницы.Получить(ШаблонСтраницы(ШаблонМаршрута));
	Если Известные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ПараметрыАдреса = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого КиЗ Из ПараметрыАдреса Цикл
		Если Известные.Получить(КиЗ.Ключ) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Узел — тот же, что печатают команды opm: адрес инсталляции, если задан, иначе очищенный Host.
// С заданным адресом Host в ключ не попадает, и подбором узлов кэш не раздуть.
Функция Узел(Знач ЗаголовкиЗапроса)
	Возврат Команды.Узел(ЗаголовкиЗапроса);
КонецФункции

Функция ЗначениеКукиОформления(Знач КукиЗапроса)

	Если КукиЗапроса = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение = КукиЗапроса.ПолучитьЗначениеПоИмени(ВыборВида.ИмяCookie());
	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции

// Оформление в ключе — так, как его прочтёт страница: мусорная тема — тёмная, негодный акцент — пустой,
// множитель вне диапазона — 1, неизвестный пресет — пресет по умолчанию. Поле, которого нет в куке,
// берётся у инсталляции и помечено «*».
Функция Оформление(Знач КукиЗапроса)

	Поля = ВыборВида.РазобратьЗначение(ЗначениеКукиОформления(КукиЗапроса));
	Тема = Неопределено;
	Акцент = Неопределено;
	Плотность = Неопределено;
	Радиус = Неопределено;
	Пресет = Неопределено;
	Поля.Свойство("Тема", Тема);
	Поля.Свойство("Акцент", Акцент);
	Поля.Свойство("Плотность", Плотность);
	Поля.Свойство("Радиус", Радиус);
	Поля.Свойство("Пресет", Пресет);

	Возврат СтрШаблон("т=%1;а=%2;п=%3;р=%4;пр=%5",
		?(ЗначениеЗаполнено(Тема), Токены.АтрибутТемы(Новый Структура("Тема", Тема)), "*"),
		?(ЗначениеЗаполнено(Акцент), Закодировать(Токены.БезопасныйЦвет(Акцент)), "*"),
		Множитель(Плотность), Множитель(Радиус),
		?(ЗначениеЗаполнено(Пресет), КлючПресета(Пресет), "*"));

КонецФункции

// Множителя инсталляция не задаёт: без поля в куке он 1.
Функция Множитель(Знач Значение)
	Значение = ?(ЗначениеЗаполнено(Значение), Значение, 1);
	Возврат Формат(Токены.БезопасныйМножитель(Значение), "ЧРД=.; ЧН=0; ЧГ=0");
КонецФункции

Функция КлючПресета(Знач Значение)
	Ключ = НРег(СокрЛП(Значение));
	Возврат ?(СвоиПресеты.Получить(Ключ) = Неопределено, "", Ключ);
КонецФункции

// Пресеты кита, кроме пресета по умолчанию: их ключ меняет страницу.
Функция ПресетыКромеУмолчания()
	Результат = Новый Соответствие();
	Для Каждого Описание Из Токены.Пресеты() Цикл
		Если НЕ Описание.ПоУмолчанию Тогда
			Результат.Вставить(Описание.Ключ, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый ФиксированноеСоответствие(Результат);
КонецФункции

// Образец — только части ключа и параметры адреса: фоновая сборка не видит ни заголовков,
// ни кук, ни адреса посетителя.
Функция ОбразецЗапроса(Знач Запрос)

	Параметры = Новый Соответствие();
	Если Запрос.ПараметрыИменные <> Неопределено Тогда
		Для Каждого КиЗ Из Запрос.ПараметрыИменные Цикл
			Параметры.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат Новый ФиксированнаяСтруктура("Путь, ПолныйПуть, Параметры, Узел, Оформление",
		Строка(Запрос.Путь), Строка(Запрос.ПолныйПуть), Новый ФиксированноеСоответствие(Параметры),
		Узел(Запрос.Заголовки), ЗначениеКукиОформления(Запрос.Куки));

КонецФункции

// Новый запрос гостя по образцу: хаб спрашивает сам себя, как гость с тем же узлом и оформлением.
Функция ЗапросПоОбразцу(Знач Образец)

	Запрос = Поделка.НайтиЖелудь("ВходящийЗапрос");
	Запрос.Метод = "GET";
	Запрос.Путь = Образец.Путь;
	Запрос.ПолныйПуть = Образец.ПолныйПуть;
	Запрос.АдресУдаленногоУзла = "127.0.0.1";
	Если ЗначениеЗаполнено(Образец.Узел) Тогда
		Запрос.Заголовки.Вставить("Host", Образец.Узел);
	КонецЕсли;
	Для Каждого КиЗ Из Образец.Параметры Цикл
		Запрос.ПараметрыИменные.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Если ЗначениеЗаполнено(Образец.Оформление) Тогда
		Запрос.Куки.Добавить(ВыборВида.ИмяCookie(), Образец.Оформление);
	КонецЕсли;
	Запрос.Сессия = ОбщаяСессияПересборки(Запрос.Куки);
	Возврат Запрос;

КонецФункции

// Без куки winow заводит новую сессию и хранит её вечно; хаб сессию winow не читает — хватает одной.
Функция ОбщаяСессияПересборки(Знач КукиЗапроса)

	Если СессияПересборки = Неопределено Тогда
		СессияПересборки = Поделка.НайтиЖелудь("МенеджерСессий").ПолучитьСессиюПоКукам(КукиЗапроса);
	КонецЕсли;
	Возврат СессияПересборки;

КонецФункции

#КонецОбласти

#Область Хранение

// Предел и срок жизни у кэша свои (cache.страницыАнонима.*): страницы не вытесняют доменные кэши.
Функция Кэш()
	Возврат Кэши.Достать().Кэш("страницыАнонима");
КонецФункции

// Запись прошлого поколения или старше предела — промах: её не отдают даже устаревшей.
Функция Прочитать(Знач Ключ)

	Попытка
		Запись = Кэш().Получить(Ключ);
	Исключение
		Лог.Предупреждение("Кэш страниц гостя не прочитан: %1", ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Запись) <> Тип("ФиксированнаяСтруктура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Запись.Поколение <> Поколение ИЛИ Возраст(Запись) >= ПределМс Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Запись;

КонецФункции

// Истина — страница положена; Ложь — она не годится в кэш или сброс случился во время сборки.
Функция Запомнить(Знач Ключ, Знач Ответ, Знач ШаблонМаршрута, Знач Образец, Знач ПоколениеСборки)

	Если НЕ ГодитсяВКэш(Ответ, ШаблонМаршрута) ИЛИ НЕ ПараметрыИзвестны(Образец.Параметры, ШаблонМаршрута) Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗаголовкиОтвета = Новый Соответствие();
	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		ЗаголовкиОтвета.Вставить(Строка(КиЗ.Ключ), Строка(КиЗ.Значение));
	КонецЦикла;
	Запись = Новый ФиксированнаяСтруктура("Тело, Заголовки, Собрана, Поколение, Образец",
		Ответ.ТелоТекст, Новый ФиксированноеСоответствие(ЗаголовкиОтвета),
		ТекущаяУниверсальнаяДатаВМиллисекундах(), ПоколениеСборки, Образец);

	Положена = Ложь;
	Замок.Заблокировать();
	Попытка
		// сброс во время сборки: страница могла собраться из прежнего состояния
		Если ПоколениеСборки = Поколение Тогда
			Кэш().Положить(Ключ, Запись);
			Положена = Истина;
		КонецЕсли;
	Исключение
		Лог.Предупреждение("Страница гостя %1 не положена в кэш: %2", Образец.ПолныйПуть, ОписаниеОшибки());
	КонецПопытки;
	Замок.Разблокировать();

	Возврат Положена;

КонецФункции

Функция Возраст(Знач Запись)
	Возврат ТекущаяУниверсальнаяДатаВМиллисекундах() - Запись.Собрана;
КонецФункции

Функция ОтветИзЗаписи(Знач Запись, Знач Запрос)

	Ответ = Поделка.НайтиЖелудь("ФабрикаОтветов").НовыйОтвет();
	Ответ.ИдентификаторЗапроса = Запрос.Идентификатор;
	Для Каждого КиЗ Из Запись.Заголовки Цикл
		Ответ.Заголовки.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	// браузер и прокси вычитают Age из max-age: вместе с памятью хаба страница живёт не дольше своего срока
	Ответ.Заголовки.Вставить("Age", Формат(Цел(Возраст(Запись) / 1000), "ЧН=0; ЧГ=0"));

	Если ПравилаКэша.СовпадаетETag(Запрос.Заголовки, Заголовки.Текст(Запись.Заголовки, "ETag")) Тогда
		Ответ.УстановитьСостояние(304);
		Ответ.ТелоТекст = "";
		Возврат Ответ;
	КонецЕсли;

	Ответ.УстановитьСостояниеОК();
	Ответ.ТелоТекст = Запись.Тело;
	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область Пересборка

// Одна пересборка на ключ и не больше ПределПересборок разом: гость получает устаревшую страницу
// сразу, новая ложится из фона. Сверх предела устаревшая отдаётся без пересборки — всплеск адресов
// не становится всплеском потоков, а старше 60 с страница соберётся в запросе.
Процедура ОбновитьУстаревшую(Знач Ключ, Знач Запись, Знач Обработчик)

	Если Фон = Неопределено ИЛИ НЕ ВзятьПересборку(Ключ) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Фон.Запустить(Новый ПересборкаСтраницыГостя(ЭтотОбъект, Ключ, Запись.Образец, Обработчик, Поколение));
	Исключение
		СнятьПересборку(Ключ);
		Лог.Предупреждение("Пересборка страницы гостя %1 не запущена: %2", Запись.Образец.ПолныйПуть,
			ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Функция ВзятьПересборку(Знач Ключ)

	Взята = Ложь;
	Замок.Заблокировать();
	Попытка
		Если Пересборки.Получить(Ключ) = Неопределено И Пересборки.Количество() < ПределПересборок Тогда
			Копия = КопияПересборок();
			Копия.Вставить(Ключ, Истина);
			Пересборки = Новый ФиксированноеСоответствие(Копия);
			Взята = Истина;
		КонецЕсли;
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();
	Возврат Взята;

КонецФункции

Процедура СнятьПересборку(Знач Ключ)

	Замок.Заблокировать();
	Попытка
		Копия = КопияПересборок();
		Копия.Удалить(Ключ);
		Пересборки = Новый ФиксированноеСоответствие(Копия);
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

КонецПроцедуры

Функция КопияПересборок()
	Копия = Новый Соответствие();
	Для Каждого КиЗ Из Пересборки Цикл
		Копия.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Возврат Копия;
КонецФункции

#КонецОбласти

#Область Начало

// Страницы каталога, одинаковые для всех гостей, и параметры адреса, которые читают их контроллеры;
// кабинет, настройки, вход и API сюда не входят.
Функция ШаблоныСтраниц()

	Шаблоны = Новый Соответствие();
	Шаблоны.Вставить("/", ИменаПараметров(""));
	Шаблоны.Вставить("/packages", ИменаПараметров("q,page,pool,mine"));
	Шаблоны.Вставить("/packages/search", ИменаПараметров("q,page,pool,mine"));
	Шаблоны.Вставить("/pools", ИменаПараметров("page"));
	Шаблоны.Вставить("/pools/{pool}", ИменаПараметров("окно"));
	Шаблоны.Вставить("/pools/{pool}/packages/{name}", ИменаПараметров("version"));
	Шаблоны.Вставить("/pools/{pool}/packages/{name}/versions", ИменаПараметров("flat"));
	Шаблоны.Вставить("/pools/{pool}/packages/{name}/deps", ИменаПараметров(""));
	Возврат Новый ФиксированноеСоответствие(Шаблоны);

КонецФункции

Функция ИменаПараметров(Знач Имена)
	Результат = Новый Соответствие();
	Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
		Результат.Вставить(Имя, Истина);
	КонецЦикла;
	Возврат Новый ФиксированноеСоответствие(Результат);
КонецФункции

// Запросы гостя, после которых гости видят другое: регистрация в интерфейсе, через API и по
// приглашению заводит учётку и личный пул без события, а иногда и без куки сессии.
Функция ШаблоныИзмененийГостя()
	Шаблоны = Новый Соответствие();
	Шаблоны.Вставить("/register", Истина);
	Шаблоны.Вставить("/api/v1/register", Истина);
	Шаблоны.Вставить("/api/v1/users", Истина);
	Шаблоны.Вставить("/invite", Истина);
	Возврат Новый ФиксированноеСоответствие(Шаблоны);
КонецФункции

// Изменения, видимые гостю, которые случаются и без запроса к хабу: фон зеркал и планировщика.
Процедура ПодписатьНаИзменения(Знач Издатель)

	Если Издатель = Неопределено Тогда
		Лог.Предупреждение("Кэш страниц гостя не подписан на события: издатель недоступен");
		Возврат;
	КонецЕсли;

	Типы = Новый Массив();
	Типы.Добавить(Издатель.ТипВерсияОпубликована());
	Типы.Добавить(Издатель.ТипВерсияОтозвана());
	Типы.Добавить(Издатель.ТипВерсияВосстановлена());
	Типы.Добавить(Издатель.ТипТегПеремещён());
	Типы.Добавить(Издатель.ТипТегУдалён());
	Типы.Добавить(Издатель.ТипЗеркалоСинхронизировано());
	Типы.Добавить(Издатель.ТипНастройкаИзменена());
	Типы.Добавить(Издатель.ТипОсновнойПулНазначен());
	Типы.Добавить(Издатель.ТипПулУдалён());
	Типы.Добавить(Издатель.ТипПакетУдалён());
	Типы.Добавить(Издатель.ТипКарточкаПакетаИзменена());
	Типы.Добавить(Издатель.ТипПраваИзменены());
	Типы.Добавить(Издатель.ТипДовериеИзменено());
	Типы.Добавить(Издатель.ТипЛичныеПространстваИзменены());
	Для Каждого Тип Из Типы Цикл
		Издатель.Подписать(Тип, ЭтотОбъект);
	КонецЦикла;

КонецПроцедуры

// Подписка — при создании: пока желудя нет, нет и записей, которые нужно сбрасывать.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "ЗаголовкиHTTP") _Заголовки,
	&Пластилин(Значение = "ЗаголовкиКэша") _ПравилаКэша,
	&Пластилин(Значение = "ВыборОформления") _ВыборВида,
	&Пластилин(Значение = "ТокеныТемы") _Токены,
	&Пластилин(Значение = "КомандыOpm") _Команды,
	&Пластилин(Значение = "Поделка") _Поделка,
	&Табакерка &Пластилин(Значение = "МенеджерКэшей") _Кэши,
	&Лог _Лог,
	&Пластилин(Значение = "ЗапускВФоне") _Фон = Неопределено,
	&Пластилин(Значение = "ИздательСобытий") _Издатель = Неопределено,
	&Пластилин(Значение = "СервисНастроек") _Настройки = Неопределено)

	Перехватчик = _Перехватчик;
	Заголовки = _Заголовки;
	ПравилаКэша = _ПравилаКэша;
	ВыборВида = _ВыборВида;
	Токены = _Токены;
	СвоиПресеты = ПресетыКромеУмолчания();
	Команды = _Команды;
	Настройки = _Настройки;
	Поделка = _Поделка;
	Кэши = _Кэши;
	Лог = _Лог;
	Фон = _Фон;

	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
	Поколение = 0;
	Пересборки = Новый ФиксированноеСоответствие(Новый Соответствие());
	ПределПересборок = 4;
	Страницы = ШаблоныСтраниц();
	ИзмененияГостя = ШаблоныИзмененийГостя();
	// предел — срок страницы в Cache-Control (60 с); с заголовком Age браузер и прокси его не продлевают
	СвежестьМс = 40000;
	ПределМс = 60000;

	ПодписатьНаИзменения(_Издатель);

КонецПроцедуры

#КонецОбласти
