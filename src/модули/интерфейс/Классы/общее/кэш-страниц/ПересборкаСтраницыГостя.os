// Одна фоновая пересборка устаревшей страницы гостя: задание несёт кэшу ключ и образец запроса.

Перем Кэш;              // КэшСтраницАнонима
Перем Ключ;             // Строка
Перем Образец;          // ФиксированнаяСтруктура
Перем Обработчик;       // ОбработчикЗапросов
Перем ПоколениеСборки;  // Число

// Точка входа фонового задания: исход задания не смотрит никто, исключение ловит кэш.
//
Процедура Исполнить() Экспорт
	Кэш.Пересобрать(Ключ, Образец, Обработчик, ПоколениеСборки);
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач _Кэш, Знач _Ключ, Знач _Образец, Знач _Обработчик, Знач _Поколение)
	Кэш = _Кэш;
	Ключ = _Ключ;
	Образец = _Образец;
	Обработчик = _Обработчик;
	ПоколениеСборки = _Поколение;
КонецПроцедуры
