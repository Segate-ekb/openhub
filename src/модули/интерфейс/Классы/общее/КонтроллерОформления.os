// Контроллер оформления — web-ui: POST /ui/theme переключает тему и возвращает посетителя
// туда, откуда он пришёл. Работает без JS; скрипт — улучшение поверх.

Перем ВыборВида;   // ВыборОформления
Перем Токены;      // ТокеныТемы

// Переключает тему на противоположную и перенаправляет на путь возврата.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса (Referer для возврата).
//  КукиЗапроса      - Куки         - куки запроса (текущее оформление).
//  МетодЗапроса     - Строка       - HTTP-метод; winow его не различает, не-POST
//                     отвечает редиректом.
//
&ТочкаМаршрута("theme")
Процедура Переключить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	АдресВозврата = ПутьВозврата(ЗаголовкиЗапроса);

	// редирект, а не 405: открытая из истории ссылка не должна показывать ошибку
	Если ВРег(Строка(МетодЗапроса)) <> "POST" Тогда
		Ответ.Перенаправить(АдресВозврата);
		Возврат;
	КонецЕсли;

	Оформление = ВыборВида.ПоКукам(КукиЗапроса);
	Новая = ВыборВида.ПротивоположнаяТема(Токены.АтрибутТемы(Оформление));

	Текущее = "";
	Если КукиЗапроса <> Неопределено Тогда
		Текущее = КукиЗапроса.ПолучитьЗначениеПоИмени(ВыборВида.ИмяCookie());
	КонецЕсли;

	ВыборВида.ЗаписатьКуку(Ответ, ВыборВида.ЗначениеCookieСТемой(Текущее, Новая));

	Ответ.Перенаправить(АдресВозврата);

КонецПроцедуры

// Куда вернуть посетителя: путь из Referer, если он есть и безопасен, иначе «/».
// Хост из Referer не используется никак, поэтому open redirect невозможен.
//
// Отбиваются: «//evil.tld» (protocol-relative), «/\evil.tld» (по WHATWG URL обратный
// слэш после первого — тот же второй слэш, поэтому разделителем считаются оба символа)
// и управляющие символы (значение уходит в Location, контракт обязан держаться сам).
//
// Параметры:
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//
// Возвращаемое значение:
//  Строка - относительный путь, всегда начинается с одного «/».
//
Функция ПутьВозврата(Знач ЗаголовкиЗапроса) Экспорт

	Источник = Заголовок(ЗаголовкиЗапроса, "Referer");
	Если НЕ ЗначениеЗаполнено(Источник) Тогда
		Возврат "/";
	КонецЕсли;

	Значение = СокрЛП(Строка(Источник));
	Если СодержитУправляющие(Значение) Тогда
		Возврат "/";
	КонецЕсли;

	// абсолютный адрес: отрезаем схему и хост, оставляя путь
	Позиция = СтрНайти(Значение, "://");
	Если Позиция > 0 Тогда
		Хвост = Сред(Значение, Позиция + 3);
		Значение = ХвостОтРазделителя(Хвост);
	КонецЕсли;

	Если НЕ ЭтоРазделитель(Лев(Значение, 1)) Тогда
		Возврат "/"; // не путь вовсе (относительный «foo/bar», «mailto:…», мусор)
	КонецЕсли;
	Если ЭтоРазделитель(Сред(Значение, 2, 1)) Тогда
		Возврат "/"; // «//host» и «/\host» — адрес чужого хоста, а не путь
	КонецЕсли;

	Возврат "/" + Сред(Значение, 2);

КонецФункции

// Обратный слэш — тоже разделитель: см. шапку ПутьВозврата.
Функция ЭтоРазделитель(Знач Символ)
	Возврат Символ = "/" ИЛИ Символ = "\";
КонецФункции

Функция ХвостОтРазделителя(Знач Значение)

	Для Поз = 1 По СтрДлина(Значение) Цикл
		Если ЭтоРазделитель(Сред(Значение, Поз, 1)) Тогда
			Возврат Сред(Значение, Поз);
		КонецЕсли;
	КонецЦикла;

	Возврат "/";

КонецФункции

Функция СодержитУправляющие(Знач Значение)

	Для Поз = 1 По СтрДлина(Значение) Цикл
		Если КодСимвола(Сред(Значение, Поз, 1)) < 32 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция Заголовок(Знач Заголовки, Знач Имя)

	Если Заголовки = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого КиЗ Из Заголовки Цикл
		Если НРег(Строка(КиЗ.Ключ)) = НРег(Имя) Тогда
			Возврат ?(КиЗ.Значение = Неопределено, "", Строка(КиЗ.Значение));
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

&Контроллер("/ui")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВыборОформления") _ВыборВида,
	&Пластилин(Значение = "ТокеныТемы") _Токены)

	ВыборВида = _ВыборВида;
	Токены = _Токены;

КонецПроцедуры
