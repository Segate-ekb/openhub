// Контроллер оформления — web-ui: POST /ui/theme переключает тему и возвращает посетителя
// туда, откуда он пришёл. Работает без JS; скрипт — улучшение поверх.

Перем ВыборВида;   // ВыборОформления
Перем Токены;      // ТокеныТемы
Перем ВозвратВхода; // ВозвратПослеВхода (вход) — правило «это путь этого хаба»
Перем Адреса;      // РазборАдреса (основа) — схема и узел источника
Перем Заголовки;   // ЗаголовкиHTTP (основа) — заголовок по имени без учёта регистра

// Переключает тему на противоположную и перенаправляет на путь возврата.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса (Referer для возврата).
//  КукиЗапроса      - Куки         - куки запроса (текущее оформление).
//  МетодЗапроса     - Строка       - HTTP-метод; winow его не различает, не-POST
//                     отвечает редиректом.
//
&ТочкаМаршрута("theme")
Процедура Переключить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	АдресВозврата = ПутьВозврата(ЗаголовкиЗапроса);

	// редирект, а не 405: открытая из истории ссылка не должна показывать ошибку
	Если ВРег(Строка(МетодЗапроса)) <> "POST" Тогда
		Ответ.Перенаправить(АдресВозврата);
		Возврат;
	КонецЕсли;

	Оформление = ВыборВида.ПоКукам(КукиЗапроса);
	Новая = ВыборВида.ПротивоположнаяТема(Токены.АтрибутТемы(Оформление));

	Текущее = "";
	Если КукиЗапроса <> Неопределено Тогда
		Текущее = КукиЗапроса.ПолучитьЗначениеПоИмени(ВыборВида.ИмяCookie());
	КонецЕсли;

	ВыборВида.ЗаписатьКуку(Ответ, ВыборВида.ЗначениеCookieСТемой(Текущее, Новая));

	Ответ.Перенаправить(АдресВозврата);

КонецПроцедуры

// Куда вернуть посетителя после смены темы: путь из Referer, если он ведёт на этот же
// хаб, иначе корень. В Location уезжает только путь — узел источника туда не попадает
// никогда, ни свой, ни чужой.
//
// Принимает ли путь сам хаб, решает ОДНО правило — ВозвратПослеВхода.Путь: им же судятся
// «//evil.tld», обратный слэш, управляющие символы и длина. Здесь остаётся только вопрос
// «чей это адрес»: по ссылке с чужого узла возвращать некуда.
//
// Параметры:
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//
// Возвращаемое значение:
//  Строка - путь этого хаба либо ПутьПоУмолчанию().
//
Функция ПутьВозврата(Знач ЗаголовкиЗапроса) Экспорт

	Источник = СокрЛП(Заголовки.Текст(ЗаголовкиЗапроса, "Referer"));
	Если НЕ ЗначениеЗаполнено(Источник) Тогда
		Возврат ПутьПоУмолчанию();
	КонецЕсли;

	Возврат ВозвратВхода.Путь(ОтносительнаяЧасть(Источник, ЗаголовкиЗапроса),
		ПутьПоУмолчанию());

КонецФункции

// Куда уводит смена темы, когда возвращаться некуда.
Функция ПутьПоУмолчанию()
	Возврат "/";
КонецФункции

// Относительная часть источника. У адреса с чужим узлом её нет вовсе: путь чужой страницы
// этому хабу ничего не говорит, и брать из него нечего.
Функция ОтносительнаяЧасть(Знач Источник, Знач ЗаголовкиЗапроса)

	Разбор = Адреса.СхемаИУзел(Источник);
	Если НЕ Разбор.СхемаЕсть Тогда
		Возврат Источник;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Разбор.Хост) ИЛИ Разбор.Хост <> СвойУзел(ЗаголовкиЗапроса) Тогда
		Возврат "";
	КонецЕсли;

	// «всё после узла» знает разбор адреса; своей строковой арифметики здесь не заводим
	Начало = Адреса.ПозицияПути(Источник);
	Возврат ?(Начало = 0, "", Сред(Источник, Начало));

КонецФункции

// Узел этой инсталляции — тот, которым запрос сюда пришёл. Читается тем же разбором,
// что и Referer: порт и скобки IPv6 снимает он, а не строковая арифметика.
Функция СвойУзел(Знач ЗаголовкиЗапроса)
	Возврат Адреса.СхемаИУзел("http://" + СокрЛП(Заголовки.Текст(ЗаголовкиЗапроса, "Host"))).Хост;
КонецФункции

&Контроллер("/ui")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВыборОформления") _ВыборВида,
	&Пластилин(Значение = "ТокеныТемы") _Токены,
	&Пластилин(Значение = "ВозвратПослеВхода") _ВозвратВхода,
	&Пластилин(Значение = "РазборАдреса") _Адреса,
	&Пластилин(Значение = "ЗаголовкиHTTP") _Заголовки)

	ВыборВида = _ВыборВида;
	Токены = _Токены;
	ВозвратВхода = _ВозвратВхода;
	Адреса = _Адреса;
	Заголовки = _Заголовки;

КонецПроцедуры
