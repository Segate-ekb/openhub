// Значок провайдера входа именем из набора кита: тот, что задал администратор, иначе логотип
// бренда по приметам провайдера (хост издателя и базового адреса, пресет, тип), иначе глиф «ключ».

Перем Иконки; // Иконка (кит) — какие глифы и бренды набор знает

#Область ПубличныйИнтерфейс

// Имя значка провайдера для Кит.Иконка и слова Иконка у кнопки.
//
// Параметры:
//  Провайдер - Структура - описание провайдера: Значок (имя значка кита — «бренд:<ключ>» или
//              глиф; прежний ключ значка домен вход уже привёл к имени бренда), Издатель, БазовыйАдрес
//              (бренд узнаётся по слову хоста, путь не в счёт), Пресет, Тип (бренд — точным
//              значением); отсутствующее поле — пустое.
//
// Возвращаемое значение:
//  Строка - «бренд:<ключ>», который набор знает, либо имя глифа набора.
//
Функция Имя(Знач Провайдер) Экспорт

	Заданный = Заданный(ПолеСтруктуры(Провайдер, "Значок"));
	Если ЗначениеЗаполнено(Заданный) Тогда
		Возврат Заданный;
	КонецЕсли;

	Угаданный = БрендПоПриметам(Провайдер);
	Если ЗначениеЗаполнено(Угаданный) Тогда
		Возврат Угаданный;
	КонецЕсли;

	Возврат ЗначокБезБренда();

КонецФункции

// Бренды, которые угадываются по приметам провайдера.
//
// Возвращаемое значение:
//  Массив из Строка - ключи брендов без приставки.
//
Функция УгадываемыеБренды() Экспорт
	Возврат СтрРазделить("github,gitlab,google,authentik,keycloak,gitea,okta,discord,mattermost", ",");
КонецФункции

// Значок провайдера, бренд которого не угадан.
//
// Возвращаемое значение:
//  Строка - имя глифа.
//
Функция ЗначокБезБренда() Экспорт
	Возврат "ключ";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Значение поля — имя значка кита: прежний ключ значка (github, key) домен вход приводит сам
// (ЗначокПровайдераВхода), здесь незнакомое имя — не задано.
Функция Заданный(Знач Значение)

	Имя = НРег(СокрЛП(Значение));
	// общий ключ у кита — служебный значок, а не бренд: выбранный прежде, он печатается глифом
	Если Имя = ПриставкаБренда() + "key" Тогда
		Возврат ЗначокБезБренда();
	КонецЕсли;
	Если СтрНачинаетсяС(Имя, ПриставкаБренда()) Тогда
		Возврат ?(ЕстьБренд(Имя), Имя, "");
	КонецЕсли;
	Возврат ?(ЗначениеЗаполнено(Имя) И ЕстьГлиф(Имя), Имя, "");

КонецФункции

// Примета — слово хоста издателя или базового адреса (keycloak.example.org, sso-gitlab.corp)
// либо точное значение пресета или типа. Путь адреса не в счёт: realm «github-sso» Keycloak
// логотипом GitHub не становится.
Функция БрендПоПриметам(Знач Провайдер)

	Приметы = Новый Соответствие();
	ДобавитьСловаХоста(Приметы, ПолеСтруктуры(Провайдер, "Издатель"));
	ДобавитьСловаХоста(Приметы, ПолеСтруктуры(Провайдер, "БазовыйАдрес"));
	Приметы.Вставить(НРег(СокрЛП(ПолеСтруктуры(Провайдер, "Пресет"))), Истина);
	Приметы.Вставить(НРег(СокрЛП(ПолеСтруктуры(Провайдер, "Тип"))), Истина);

	Для Каждого Ключ Из УгадываемыеБренды() Цикл
		Если Приметы.Получить(Ключ) <> Неопределено И ЕстьБренд(ПриставкаБренда() + Ключ) Тогда
			Возврат ПриставкаБренда() + Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Процедура ДобавитьСловаХоста(Приметы, Знач Адрес)

	Хост = НРег(СокрЛП(Адрес));
	Схема = СтрНайти(Хост, "://");
	Если Схема > 0 Тогда
		Хост = Сред(Хост, Схема + 3);
	КонецЕсли;
	Для Каждого Граница Из СтрРазделить("/,?,#,:", ",") Цикл
		Позиция = СтрНайти(Хост, Граница);
		Если Позиция > 0 Тогда
			Хост = Лев(Хост, Позиция - 1);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Слово Из СтрРазделить(СтрЗаменить(Хост, "-", "."), ".", Ложь) Цикл
		Приметы.Вставить(Слово, Истина);
	КонецЦикла;

КонецПроцедуры

Функция ЕстьБренд(Знач Имя)
	Возврат ЗначениеЗаполнено(Иконки.НазваниеБренда(Имя));
КонецФункции

Функция ЕстьГлиф(Знач Имя)
	Возврат ЗначениеЗаполнено(Иконки.Отрисовать(Имя));
КонецФункции

Функция ПриставкаБренда()
	Возврат "бренд:";
КонецФункции

Функция ПолеСтруктуры(Знач Провайдер, Знач Имя)

	Значение = "";
	Если ТипЗнч(Провайдер) = Тип("Структура") Тогда
		Провайдер.Свойство(Имя, Значение);
	КонецЕсли;
	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "Иконка") _Иконки) Экспорт
	Иконки = _Иконки;
КонецПроцедуры
