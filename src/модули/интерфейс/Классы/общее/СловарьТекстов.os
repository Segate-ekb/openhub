// Словарь текстов интерфейса: строки, которые видит человек, по ключам вида
// <область>.<экран>.<узел>[.<узел>…]. Здесь тексты каркаса, остальные — в частях (ЧастьСловаряТекстов).

Перем Тексты; // Соответствие: ключ (Строка) -> текст (Строка)

// Текст по ключу. Что делать с отсутствующим ключом, решает резолвер ТекстыИнтерфейса.
//
// Параметры:
//  Ключ - Строка - ключ текста.
//
// Возвращаемое значение:
//  Строка, Неопределено - текст либо Неопределено, если ключа нет.
//
Функция НайтиТекст(Знач Ключ) Экспорт
	Возврат Тексты.Получить(Ключ);
КонецФункции

// Все ключи словаря.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция Ключи() Экспорт

	Результат = Новый Массив();
	Для Каждого КиЗ Из Тексты Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Кладёт текст в словарь; повторный ключ — исключение, а не тихая перезапись.
//
// Параметры:
//  Ключ - Строка - ключ текста.
//  Текст - Строка - текст.
//
Процедура Добавить(Знач Ключ, Знач Текст) Экспорт

	Если Тексты.Получить(Ключ) <> Неопределено Тогда
		ВызватьИсключение "СловарьТекстов: ключ «" + Ключ + "» объявлен дважды";
	КонецЕсли;

	Тексты.Вставить(Ключ, Текст);

КонецПроцедуры

// Каркас разделов настроек и отказы полей формы.
Процедура КлючиКаркасаНастроек()

	Добавить("settings.frame.crumbs.label", "Путь");
	Добавить("settings.frame.nav.title", "Разделы настроек");
	Добавить("settings.frame.empty", "В этом разделе пока нечего настраивать.");
	Добавить("settings.frame.save", "Сохранить");
	Добавить("settings.frame.cancel", "Отмена");

	// отказы полей формы: текст говорит, что поправить в поле
	Добавить("form.error.required", "Заполните это поле");
	Добавить("form.error.number", "Введите целое число");
	Добавить("form.error.min", "Не меньше %1");
	Добавить("form.error.max", "Не больше %1");
	Добавить("form.error.choice", "Выберите значение из списка");

КонецПроцедуры

// Ответы разделов настроек: отказы, сохранение, CSRF.
Процедура КлючиОтветовНастроек()

	Добавить("settings.reply.forbidden.title", "Отказано");
	Добавить("settings.reply.notfound.title", "Не найдено");
	Добавить("settings.reply.method.title", "Метод не разрешён");
	Добавить("settings.reply.method.body", "Разрешено: %1");
	Добавить("settings.reply.error.internal", "внутренняя ошибка");
	Добавить("settings.reply.saved", "Изменения сохранены");

	Добавить("settings.reply.csrf.invalid", "Неверный или отсутствующий CSRF-токен");

КонецПроцедуры

// Страницы сбоя и «адрес не найден».
Процедура КлючиСтраницОшибок()

	Добавить("public.static.notfound", "Не найдено");

	// фраза сбоя одна для страницы и для конверта ошибки машинной двери
	Добавить("public.failure.title", "Сбой хаба");
	Добавить("public.failure.database",
		"База данных хаба не отвечает. Попробуйте ещё раз через минуту.");
	Добавить("public.failure.internal",
		"Хаб не смог ответить на этот запрос. Попробуйте ещё раз чуть позже.");
	Добавить("public.failure.request", "Код запроса");
	Добавить("public.failure.hint",
		"Если сбой повторяется, назовите администратору хаба код запроса —"
		+ " по нему он найдёт причину в журнале.");

	// фраза «адрес не найден» та же и в конверте ошибки машинной двери
	Добавить("public.notfound.address", "По этому адресу у хаба ничего нет");

	Добавить("public.catalog.back", "← К каталогу");

КонецПроцедуры

// Шапка, единое меню и подвал страницы.
Процедура КлючиШапки()

	Добавить("chrome.top.nav.title", "Основная навигация");
	Добавить("chrome.top.nav.catalog", "Каталог");
	Добавить("chrome.top.login", "Войти");
	Добавить("chrome.top.logout", "Выйти");
	Добавить("chrome.top.theme.toggle", "Переключить тему");
	Добавить("chrome.top.theme.to-dark", "Включить тёмную тему");
	Добавить("chrome.top.theme.to-light", "Включить светлую тему");

	// эти два ключа спрашивает сам кит
	Добавить("chrome.top.office", "Кабинет");
	Добавить("chrome.office.nav.title", "Разделы кабинета");

	// единое меню: бургер, рейка и панель; первые пять ключей спрашивает сам кит
	Добавить("chrome.menu.open", "Меню");
	Добавить("chrome.menu.close", "Закрыть меню");
	Добавить("chrome.menu.section.deeds", "Мои дела");
	Добавить("chrome.menu.section.nav", "Хаб");
	Добавить("chrome.menu.section.screen", "Разделы экрана");

	Добавить("chrome.menu.role.admin", "администратор хаба");
	Добавить("chrome.menu.deed.notifications.count", "Непрочитанных уведомлений: %1");
	Добавить("chrome.menu.deed.inbox.count", "Заявок ждут решения: %1");

	Добавить("chrome.menu.badge.waiting", "Ждут вашего внимания: %1");
	Добавить("chrome.menu.deed.office", "Кабинет");
	Добавить("chrome.menu.deed.space", "Личное пространство");
	Добавить("chrome.menu.deed.packages", "Мои пакеты");
	Добавить("chrome.menu.deed.notifications", "Уведомления");
	Добавить("chrome.menu.deed.inbox", "Входящие заявки");
	Добавить("chrome.menu.deed.account", "Настройки аккаунта");
	Добавить("chrome.menu.deed.hub", "Настройки хаба");

КонецПроцедуры

&Верховный
&Прозвище("СловарьИнтерфейса")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЧастьСловаряТекстов", Тип = "Массив") _Части) Экспорт

	// без словарей районов и панелей на экранах остались бы маркеры вместо текста
	Если _Части = Неопределено ИЛИ _Части.Количество() = 0 Тогда
		ВызватьИсключение "СловарьТекстов: не собрано ни одной части словаря (контракт ЧастьСловаряТекстов)";
	КонецЕсли;

	Тексты = Новый Соответствие();

	КлючиКаркасаНастроек();
	КлючиОтветовНастроек();
	КлючиСтраницОшибок();
	КлючиШапки();

	Для Каждого Часть Из _Части Цикл
		Часть.Наполнить(ЭтотОбъект);
	КонецЦикла;

КонецПроцедуры
