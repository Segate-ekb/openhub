// Страницы сбоя и «адрес не найден».
Процедура КлючиСтраницОшибок()

	Добавить("public.static.notfound", "Не найдено");

	// фраза сбоя одна для страницы и для конверта ошибки машинной двери
	Добавить("public.failure.title", "Сбой хаба");
	Добавить("public.failure.database",
		"База данных хаба не отвечает. Попробуйте ещё раз через минуту.");
