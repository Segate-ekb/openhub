// Гейт формы, меняющей данные: метод запроса и CSRF-токен одним шагом; отказ отвечает сам,
// а раздел узнаёт о нём по Неопределено.

Перем Ответы;      // ОтветыНастроек
Перем Защита;      // ЗащитаCSRF (вход)
Перем РазборФормы;

// Разобранная форма POST-запроса с принятым токеном.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  Разрешённые - Строка - разрешённые методы для заголовка Allow.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ОтказТокена - Строка - своя формулировка отказа по токену (необязательный, по умолчанию ""
//                — общий текст про неверный токен).
//
// Возвращаемое значение:
//  Соответствие, Неопределено - разобранная форма; Неопределено — ответ уже сформирован.
//
Функция ПринятаяФорма(Ответ, Знач Контекст, Знач Разрешённые, Знач МетодЗапроса,
	Знач ТелоЗапроса, Знач КукиЗапроса, Знач ОтказТокена = "") Экспорт

	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, Разрешённые, Контекст.Пользователь, КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Возврат СПринятымТокеном(Ответ, Контекст, РазборФормы.Разобрать(ТелоЗапроса), КукиЗапроса,
		ОтказТокена);

КонецФункции

// Уже разобранная форма с принятым токеном — для составной формы с файлом, где токен
// живёт в частях, а не в теле запроса.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  Форма - Соответствие - разобранная форма запроса.
//  КукиЗапроса - Куки - куки запроса.
//  ОтказТокена - Строка - своя формулировка отказа по токену (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Соответствие, Неопределено - та же форма; Неопределено — токен не принят, ответ отдан.
//
Функция СПринятымТокеном(Ответ, Знач Контекст, Знач Форма, Знач КукиЗапроса,
	Знач ОтказТокена = "") Экспорт

	Если НЕ ТокенПринят(Контекст.Сессия, Форма) Тогда
		Ответы.ОтдатьНеверныйCSRF(Ответ, Контекст.Пользователь, КукиЗапроса, ОтказТокена);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Форма;

КонецФункции

// Несёт ли форма токен этой сессии — для экранов, которые печатают отказ по-своему.
//
// Параметры:
//  Сессия - Произвольный - сессия запроса.
//  Форма - Соответствие - разобранная форма запроса.
//
// Возвращаемое значение:
//  Булево - принят ли токен формы.
//
Функция ТокенПринят(Знач Сессия, Знач Форма) Экспорт
	Возврат Защита.Проверить(Сессия, РазборФормы.Поле(Форма, Защита.ИмяПоля()));
КонецФункции

&Прозвище("ГейтФормы")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "РазборФормы") _РазборФормы) Экспорт

	Ответы = _Ответы;
	Защита = _Защита;
	РазборФормы = _РазборФормы;

КонецПроцедуры
