// Реализация контракта кита «ОбрамлениеИнсталляции»: чем этот хаб обрамляет содержимое
// страницы. Всё читается на запросе, поэтому правка брендирования видна сразу.

Перем Бренд;        // Брендирование — знак, подпись, загруженные картинки
Перем Активы;       // АдресаСтатики — адреса файлов поставки
Перем Заголовки;    // ЗаголовкиКэша (основа) — политика перехода одна на заголовок и на <meta>
Перем Тексты;       // ТекстыИнтерфейса (кит) — подписи дел, настроек и дорог меню
Перем Каталог;      // АдресаКаталога — адреса каталога, отбора «мои» и пулов
Перем ВходВХаб;     // ВозвратПослеВхода (вход) — адрес страницы входа
Перем АдресаМеня;   // АдресаКабинета — адреса экранов приватной части
Перем Кит;          // Кит (кит) — форма выхода едет в меню узлом
Перем Подсветка;    // ПодсветкаТекущейДороги — какой пункт меню отвечает адресу
Перем Лента;        // ЛентаУведомлений (уведомления) — непрочитанное; Неопределено — без счёта
Перем Рассмотрение; // РассмотрениеВходящих (публикация) — заявки; Неопределено — без счёта
Перем Права;        // СервисПрав (права) — кто админ хаба; Неопределено — спросить не у кого
Перем СменаТемы;    // АдресСменыТемы — форма темы с путём возврата на эту же страницу
Перем Защита;       // ЗащитаCSRF (вход) — токен сессии в форме выхода; Неопределено — без токена

// Чем хаб обрамляет содержимое страницы для этого запроса.
//
// Параметры:
//  Контекст - Структура - контекст запроса: Пользователь, КукиЗапроса, ПоказатьАдмин,
//             Приватная, Путь, Сессия (прочитанная стражем запроса — её токен несёт «Выйти»).
//
// Возвращаемое значение:
//  Структура - обрамление, см. контракт ОбрамлениеИнсталляции.
//
Функция Обрамление(Знач Контекст) Экспорт

	Результат = Новый Структура();
	Результат.Вставить("Язык", "ru");
	Результат.Вставить("Знак", Бренд.Знак());
	Результат.Вставить("Подпись", Бренд.Подпись());
	Результат.Вставить("ПолитикаПерехода", Заголовки.ПолитикаПерехода());
	Результат.Вставить("АдресСтилей", Активы.АдресСтилей());
	Результат.Вставить("АдресСкрипта", Активы.АдресСкрипта());
	Результат.Вставить("Иконки", Иконки());
	Результат.Вставить("Знамя", Знамя());
	Результат.Вставить("МенюХаба", ЕдиноеМеню(Контекст));
	Результат.Вставить("Действия", Действия(Контекст));
	Результат.Вставить("Адреса", Адреса(Контекст));
	Возврат Результат;

КонецФункции

#Область Знак

// Адрес знака хаба: загруженный администратором, иначе знак поставки. Одно правило для шапки
// и для шапки колонки страниц-ворот.
//
// Возвращаемое значение:
//  Строка
//
Функция АдресЗнака() Экспорт

	Свой = Бренд.АдресЗагруженногоЗнака();
	Возврат ?(ЗначениеЗаполнено(Свой), Свой, Активы.АдресЗнака());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Тихая форма POST /logout с одной кнопкой «Выйти» — узлом в подвал единого меню. Несёт токен
// сессии: дверь выхода без него сессию не гасит. Без сессии выходить не из чего — форма без
// токена (дверь без сессии только стирает куку). Выход остаётся формой: ход по ссылке уводил бы
// из учётки предзагрузкой соседней вкладки.
Функция ФормаВыхода(Знач Сессия)

	Кнопка = Кит.Кнопка(Тексты.Текст("chrome.top.logout")).Ссылкой().Малая().Иконка("выход");
	Токен = ?(Защита = Неопределено ИЛИ Сессия = Неопределено, "", Защита.ТокенСессии(Сессия));
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		Возврат Кит.ФормаБезТокена(АдресВыхода(), Кнопка).Вид("меню");
	КонецЕсли;
	Возврат Кит.Форма(АдресВыхода(), Кнопка).Токен(Токен).Вид("меню");

КонецФункции

// Загруженная администратором вытесняет фирменные ЦЕЛИКОМ: браузер выбирает из набора сам.
Функция Иконки()

	Результат = Новый Массив();

	Своя = Бренд.АдресЗагруженнойИконки();
	Если ЗначениеЗаполнено(Своя) Тогда
		Результат.Добавить(Иконка("icon", Своя, Бренд.ТипЗагруженнойИконки()));
		Результат.Добавить(Иконка("apple-touch-icon", Своя, ""));
		Возврат Результат;
	КонецЕсли;

	Результат.Добавить(ИконкаЛюбогоРазмера(Активы.АдресЗапаснойИконки()));
	Результат.Добавить(Иконка("icon", Активы.АдресИконки(), Активы.ТипИконки()));
	Результат.Добавить(Иконка("apple-touch-icon", Активы.АдресИконкиДомашнегоЭкрана(), ""));
	Возврат Результат;

КонецФункции

Функция Иконка(Знач Отношение, Знач Адрес, Знач Тип)
	Возврат Новый Структура("Отношение, Адрес, Тип, Размеры", Отношение, Адрес, Тип, "");
КонецФункции

// Размеры объявлены «любые», иначе браузер выберет по заявленному и промахнётся на ретине.
Функция ИконкаЛюбогоРазмера(Знач Адрес)
	Возврат Новый Структура("Отношение, Адрес, Тип, Размеры", "icon", Адрес, "", "any");
КонецФункции

// Ширина известна только у знака ИЗ ПОСТАВКИ: он квадратный, у загруженного пропорции свои.
Функция Знамя()

	Свой = Бренд.АдресЗагруженногоЗнака();
	Возврат Новый Структура("Адрес, Ширина, Название",
		АдресЗнака(),
		?(ЗначениеЗаполнено(Свой), 0, 28),
		Бренд.ПоказыватьНазвание());

КонецФункции

#КонецОбласти

#Область Действия

// Справа от дорог гостю — вход; вошедший открывает свою учётку кнопкой единого меню.
// Модель кнопки, а не узел: в панели меню кит растягивает её во всю ширину.
Функция Действия(Знач Контекст)

	Результат = Новый Массив();
	Если Вошедший(Контекст) = Неопределено Тогда
		Результат.Добавить(Новый Структура("Подпись, Адрес, Иконка, Вариант",
			Тексты.Текст("chrome.top.login"), ВходВХаб.ПутьВхода(), "аккаунт", "вторичная"));
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ЕдиноеМеню

// Одно меню на все страницы: учётка, дела, настройки, дороги хаба и выход; гостю — только дороги.
Функция ЕдиноеМеню(Знач Контекст)

	Путь = ПутьЗапроса(Контекст);

	Человек = Вошедший(Контекст);
	Если Человек = Неопределено Тогда
		Дороги = ДорогиХаба();
		Подсветка.ОтметитьТекущую(Путь, Дороги);
		Возврат Новый Структура("Навигация", Дороги);
	КонецЕсли;

	Числа = ЧислаДел(Контекст, Человек);
	Ждёт = Числа.Непрочитано + Числа.НаРешение;
	Админ = ЭтоАдминХаба(Контекст, Человек);

	Дела = Дела(Человек, Числа.Непрочитано, Числа.НаРешение);
	Настройки = Настройки(Админ);
	Дороги = ДорогиХаба();
	Подсветка.ОтметитьТекущую(Путь, Дороги, Дела, Настройки);

	Возврат Новый Структура("Счётчик, ПодписьСчётчика, Учётка, Дела, Настройки, Навигация, Выход",
		Ждёт, ПодписьЖдущих(Ждёт), Учётка(Человек, Админ),
		Дела, Настройки, Дороги, ФормаВыхода(СессияЗапроса(Контекст)));

КонецФункции

// Блок вошедшего; роль подписывается только администратору хаба.
Функция Учётка(Знач Человек, Знач Админ)

	Возврат Новый Структура("Логин, Роль, Адрес",
		Человек.Логин, ?(Админ, Тексты.Текст("chrome.menu.role.admin"), ""),
		АдресаМеня.Личное());

КонецФункции

// «Входящие заявки» стоят постоянно: дорога, появляющаяся только вместе с работой, не запоминается.
Функция Дела(Знач Человек, Знач Непрочитано, Знач НаРешение)

	Результат = Новый Массив();
	Результат.Добавить(Пункт(Тексты.Текст("chrome.menu.deed.space"),
		АдресаМеня.Пространство(Человек.Логин), "куб"));
	Результат.Добавить(Пункт(Тексты.Текст("chrome.menu.deed.packages"),
		Каталог.Управляемые(), "пакет"));
	Результат.Добавить(ДелоСоСчётом(Тексты.Текст("chrome.menu.deed.notifications"),
		АдресаМеня.Уведомления(), "конверт", Непрочитано, РечьНепрочитанного(Непрочитано)));
	Результат.Добавить(ДелоСоСчётом(Тексты.Текст("chrome.menu.deed.inbox"),
		АдресаМеня.Входящие(), "весы", НаРешение, РечьЗаявок(НаРешение)));

	Возврат Результат;

КонецФункции

// «Аккаунт» открывает кабинет — первый раздел своего дома; «Хаб» — только администратору хаба.
Функция Настройки(Знач Админ)

	Результат = Новый Массив();
	Результат.Добавить(Пункт(Тексты.Текст("chrome.menu.settings.account"), АдресаМеня.Личное(), "аккаунт"));

	Если Админ Тогда
		Результат.Добавить(Пункт(Тексты.Текст("chrome.menu.settings.hub"), АдресНастроекХаба(), "шестерёнка"));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Пункт меню одной формы для дел, настроек и дорог.
Функция Пункт(Знач Подпись, Знач Адрес, Знач ИмяИконки)
	Возврат Новый Структура("Подпись, Адрес, Иконка", Подпись, Адрес, ИмяИконки);
КонецФункции

// Дело со своим числом и его прочтением словами для скринридера.
Функция ДелоСоСчётом(Знач Подпись, Знач Адрес, Знач ИмяИконки, Знач Счётчик, Знач Речь)

	Результат = Пункт(Подпись, Адрес, ИмяИконки);
	Результат.Вставить("Счётчик", Счётчик);
	Результат.Вставить("ПодписьСчётчика", Речь);
	Возврат Результат;

КонецФункции

Функция РечьНепрочитанного(Знач Непрочитано)

	Если Непрочитано = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Тексты.Шаблон("chrome.menu.deed.notifications.count",
		Тексты.ЧислоТекстом(Непрочитано));

КонецФункции

Функция РечьЗаявок(Знач НаРешение)

	Если НаРешение = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Тексты.Шаблон("chrome.menu.deed.inbox.count", Тексты.ЧислоТекстом(НаРешение));

КонецФункции

// Дороги самого хаба; на широком экране они же — значки рейки.
Функция ДорогиХаба()

	Результат = Новый Массив();
	Результат.Добавить(Пункт(Тексты.Текст("chrome.top.nav.catalog"), Каталог.Каталог(), "пакет"));
	Результат.Добавить(Пункт(Тексты.Текст("chrome.top.nav.pools"), Каталог.Пулы(), "стопка"));
	Возврат Результат;

КонецФункции

// Число уходит в речь словами: голое «4» скринридеру не значит ничего.
Функция ПодписьЖдущих(Знач Ждёт)

	Если Ждёт = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Тексты.Шаблон("chrome.menu.badge.waiting", Тексты.ЧислоТекстом(Ждёт));

КонецФункции

// «Кто ты» спрашивается у прав, а не у экрана: на каталоге админ терял бы свои дела.
Функция ЭтоАдминХаба(Знач Контекст, Знач Человек)

	Если Права = Неопределено Тогда
		Возврат Флаг(Контекст, "ПоказатьАдмин");
	КонецЕсли;

	Возврат Права.ПользовательАдмин(Человек);

КонецФункции

// Числа на делах вошедшего; экран, уже снявший их для содержимого, приносит СводкаДел.
Функция ЧислаДел(Знач Контекст, Знач Человек)

	Снимок = СнимокДел(Контекст);
	Если Снимок <> Неопределено Тогда
		Возврат Новый Структура("Непрочитано, НаРешение",
			Цел(Снимок.Непрочитано), Цел(Снимок.НаРешение));
	КонецЕсли;

	Возврат Новый Структура("Непрочитано, НаРешение",
		СчётНепрочитанного(Человек), СчётЗаявокНаРешение(Человек));

КонецФункции

Функция СнимокДел(Знач Контекст)

	Значение = Неопределено;
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Контекст.Свойство("СводкаДел", Значение);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Лента и рассмотрение могут быть не собраны: тогда дело остаётся, а счёта у него нет.
Функция СчётНепрочитанного(Знач Человек)
	Возврат ?(Лента = Неопределено, 0, Цел(Лента.Непрочитано(Человек)));
КонецФункции

Функция СчётЗаявокНаРешение(Знач Человек)
	Возврат ?(Рассмотрение = Неопределено, 0, Цел(Рассмотрение.СколькоЖдётРешения(Человек)));
КонецФункции

#КонецОбласти

#Область КонтекстЗапроса

// Форма темы несёт адрес этой страницы: Referer наружу не уходит, и вернуть иначе некуда.
Функция Адреса(Знач Контекст)

	Возврат Новый Структура("Корень, Оформление", "/", СменаТемы.Адрес(СменаТемы.АдресСтраницы(Контекст)));

КонецФункции

Функция АдресВыхода()
	Возврат "/logout";
КонецФункции

Функция АдресНастроекХаба()
	Возврат "/hub/settings";
КонецФункции

Функция Вошедший(Знач Контекст)

	Пользователь = Неопределено;
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Контекст.Свойство("Пользователь", Пользователь);
	КонецЕсли;

	Возврат Пользователь;

КонецФункции

// Сессию вошедшего читает страж запроса и довозит контекст страницы: второй раз по куке её не
// читают (чтение сессии — ещё и запись скользящего срока).
Функция СессияЗапроса(Знач Контекст)

	Сессия = Неопределено;
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Контекст.Свойство("Сессия", Сессия);
	КонецЕсли;

	Возврат Сессия;

КонецФункции

Функция Флаг(Знач Контекст, Знач Ключ)

	Значение = Ложь;
	Если ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Контекст.Свойство(Ключ, Значение);
	Возврат Значение = Истина;

КонецФункции

// Путь текущего запроса от каркаса; при пустом в меню не горит ничего.
Функция ПутьЗапроса(Знач Контекст)

	Значение = "";
	Если ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Контекст.Свойство("Путь", Значение);
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));

КонецФункции

#КонецОбласти

&Верховный
&Прозвище("ОбрамлениеИнсталляции")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Брендирование") _Бренд,
	&Пластилин(Значение = "АдресаСтатики") _Активы,
	&Пластилин(Значение = "ЗаголовкиКэша") _Заголовки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаКаталога") _Каталог,
	&Пластилин(Значение = "ВозвратПослеВхода") _ВходВХаб,
	&Пластилин(Значение = "АдресаКабинета") _АдресаМеня,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ПодсветкаТекущейДороги") _Подсветка,
	&Пластилин(Значение = "ЛентаУведомлений") _Лента = Неопределено,
	&Пластилин(Значение = "РассмотрениеВходящих") _Рассмотрение = Неопределено,
	&Пластилин(Значение = "СервисПрав") _Права = Неопределено,
	&Пластилин(Значение = "АдресСменыТемы") _СменаТемы = Неопределено,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита = Неопределено) Экспорт

	Бренд = _Бренд;
	Активы = _Активы;
	Заголовки = _Заголовки;
	Тексты = _Тексты;
	Каталог = _Каталог;
	ВходВХаб = _ВходВХаб;
	АдресаМеня = _АдресаМеня;
	Кит = _Кит;
	Подсветка = _Подсветка;
	Лента = _Лента;
	Рассмотрение = _Рассмотрение;
