// Обрамление хаба — реализация контракта кита «ОбрамлениеИнсталляции»: чем этот хаб
// обрамляет содержимое страницы. Всё читается НА ЗАПРОСЕ, поэтому правка брендирования
// видна сразу. Разметку печатает каркас кита; своей здесь ровно один фрагмент — форма
// выхода, которую меню принимает готовой, и собрана она тем же китом.

Перем Бренд;        // Брендирование (web-ui) — знак, подпись, загруженные картинки
Перем Активы;       // АдресаСтатики (web-ui) — адреса файлов поставки
Перем Заголовки;    // ЗаголовкиКэша (основа) — политика перехода одна на заголовок и на <meta>
Перем Тексты;       // ТекстыИнтерфейса (кит) — подписи разделов навигации
Перем Каталог;      // АдресаКаталога (web-ui) — адрес каталога с отбором «мои»
Перем ВходВХаб;     // ВозвратПослеВхода (основа) — адрес страницы входа
Перем АдресаМеня;   // АдресаКабинета (web-ui) — адреса экранов приватной части
Перем Кит;          // Кит (кит) — форма выхода едет в меню готовым фрагментом
Перем Лента;        // ЛентаУведомлений (связь) — непрочитанное; Неопределено — без счёта
Перем Рассмотрение; // РассмотрениеВходящих (публикация) — заявки; Неопределено — без счёта
Перем Права;        // СервисПрав (права) — кто админ хаба; Неопределено — спросить не у кого

// Чем хаб обрамляет содержимое страницы для этого запроса.
//
// Параметры:
//  Контекст - Структура - контекст запроса: Пользователь, КукиЗапроса, ПоказатьАдмин,
//             Приватная.
//
// Возвращаемое значение:
//  Структура - обрамление, см. контракт ОбрамлениеИнсталляции.
//
Функция Обрамление(Знач Контекст) Экспорт

	Результат = Новый Структура();
	Результат.Вставить("Язык", "ru");
	Результат.Вставить("Знак", Бренд.Знак());
	Результат.Вставить("Подпись", Бренд.Подпись());
	Результат.Вставить("ПолитикаПерехода", Заголовки.ПолитикаПерехода());
	Результат.Вставить("АдресСтилей", Активы.АдресСтилей());
	Результат.Вставить("АдресСкрипта", Активы.АдресСкрипта());
	Результат.Вставить("Иконки", Иконки());
	Результат.Вставить("Знамя", Знамя());
	Результат.Вставить("Разделы", ВерхняяНавигация());
	Результат.Вставить("Аккаунт", ИмяВошедшего(Контекст));
	Результат.Вставить("МенюУчётки", МенюУчётки(Контекст));
	Результат.Вставить("Адреса", Адреса());
	Возврат Результат;

КонецФункции

#Область СлужебныеПроцедурыИФункции

// Иконки сайта: загруженная администратором вытесняет фирменные ЦЕЛИКОМ — из набора
// объявлений браузер выбирает сам, и рядом со своей картинкой стоковых быть не должно.
Функция Иконки()

	Результат = Новый Массив();

	Своя = Бренд.АдресЗагруженнойИконки();
	Если ЗначениеЗаполнено(Своя) Тогда
		Результат.Добавить(Иконка("icon", Своя, Бренд.ТипЗагруженнойИконки()));
		Результат.Добавить(Иконка("apple-touch-icon", Своя, ""));
		Возврат Результат;
	КонецЕсли;

	Результат.Добавить(ИконкаЛюбогоРазмера(Активы.АдресЗапаснойИконки()));
	Результат.Добавить(Иконка("icon", Активы.АдресИконки(), Активы.ТипИконки()));
	Результат.Добавить(Иконка("apple-touch-icon", Активы.АдресИконкиДомашнегоЭкрана(), ""));
	Возврат Результат;

КонецФункции

Функция Иконка(Знач Отношение, Знач Адрес, Знач Тип)
	Возврат Новый Структура("Отношение, Адрес, Тип, Размеры", Отношение, Адрес, Тип, "");
КонецФункции

// Многоразмерный .ico для тех, кто не берёт SVG: размеры объявлены «любые», иначе
// браузер выберет по одному заявленному и промахнётся на ретине.
Функция ИконкаЛюбогоРазмера(Знач Адрес)
	Возврат Новый Структура("Отношение, Адрес, Тип, Размеры", "icon", Адрес, "", "any");
КонецФункции

// Ширина знака известна только у знака ИЗ ПОСТАВКИ: он квадратный. У загруженного
// пропорции произвольные — горизонтальный логотип обычное дело, — и ширину считает
// браузер по самой картинке.
Функция Знамя()

	Свой = Бренд.АдресЗагруженногоЗнака();
	Возврат Новый Структура("Адрес, Ширина, Название",
		?(ЗначениеЗаполнено(Свой), Свой, Активы.АдресЗнака()),
		?(ЗначениеЗаполнено(Свой), 0, 28),
		Бренд.ПоказыватьНазвание());

КонецФункции

Функция ВерхняяНавигация()

	Результат = Новый Массив();
	Результат.Добавить(Раздел(Тексты.Текст("chrome.top.nav.catalog"), Каталог.Каталог(), "пакет"));
	Возврат Результат;

КонецФункции

// Элемент слота «Разделы» — верхняя навигация, которую кит печатает деревом разделов.
Функция Раздел(Знач Подпись, Знач Адрес, Знач ИмяИконки)
	Возврат Новый Структура("Подпись, Адрес, Иконка", Подпись, Адрес, ИмяИконки);
КонецФункции

#КонецОбласти

#Область МенюУчётки

// Меню под именем вошедшего: все его дороги собраны в одном месте и потому одинаковы
// на ЛЮБОЙ странице, включая публичные. Гостю меню не собирается — ему шапка даёт вход.
Функция МенюУчётки(Знач Контекст)

	Человек = Вошедший(Контекст);
	Если Человек = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Непрочитано = СчётНепрочитанного(Человек);
	НаРешение = СчётЗаявокНаРешение(Человек);
	Ждёт = Непрочитано + НаРешение;
	ПоказатьНастройкиХаба = ЭтоАдминХаба(Контекст, Человек);

	Возврат Новый Структура("Подпись, Счётчик, ПодписьСчётчика, Пункты",
		Тексты.Текст("chrome.account.menu.title"), Ждёт, ПодписьСчётчика(Ждёт),
		Пункты(Человек, Непрочитано, НаРешение, ПоказатьНастройкиХаба));

КонецФункции

// Меню одно и то же на любой странице, поэтому «кто ты» спрашивается у прав, а не у экрана:
// флаг контекста ставят только контроллеры приватной части, и на каталоге админ терял бы
// свой пункт. Прав в графе нет (сборка рендера без доменных желудей) — остаётся флаг.
Функция ЭтоАдминХаба(Знач Контекст, Знач Человек)

	Если Права = Неопределено Тогда
		Возврат Флаг(Контекст, "ПоказатьАдмин");
	КонецЕсли;

	Возврат Права.ПользовательАдмин(Человек);

КонецФункции

// Порядок пунктов — от того, зачем в меню заходят чаще: сначала свои дела, затем своё
// хозяйство, затем настройки и выход. «Входящие заявки» стоят ПОСТОЯННО, а не при
// непустой очереди: дорога, появляющаяся только вместе с работой, не запоминается.
Функция Пункты(Знач Человек, Знач Непрочитано, Знач НаРешение, Знач ПоказатьНастройкиХаба)

	Результат = Новый Массив();
	Результат.Добавить(Пункт(Тексты.Текст("chrome.account.menu.office"),
		АдресаМеня.Личное(), "аккаунт"));
	Результат.Добавить(Пункт(Тексты.Текст("chrome.account.menu.space"),
		АдресаМеня.Пространство(Человек.Логин), "куб"));
	Результат.Добавить(Пункт(Тексты.Текст("chrome.account.menu.packages"),
		Каталог.Управляемые(), "пакет"));
	Результат.Добавить(Пункт(ПодписьУведомлений(Непрочитано),
		АдресаМеня.Уведомления(), "конверт"));
	Результат.Добавить(Пункт(ПодписьВходящих(НаРешение),
		АдресаМеня.Входящие(), "весы"));
	Результат.Добавить(Пункт(Тексты.Текст("chrome.account.menu.account"),
		АдресаМеня.Настройки(), "шестерёнка"));

	Если ПоказатьНастройкиХаба Тогда
		Результат.Добавить(Пункт(Тексты.Текст("chrome.account.menu.hub"),
			АдресНастроекХаба(), "замок"));
	КонецЕсли;

	Результат.Добавить(Выход());
	Возврат Результат;

КонецФункции

// Элемент слота «МенюУчётки.Пункты» — строка выпадающей панели, которую кит печатает
// кнопкой-ссылкой. Форма записи совпадает с разделом, а слоты контракта разные, и
// разъехаться они вправе: у раздела появится «текущий», у пункта — свои признаки.
Функция Пункт(Знач Подпись, Знач Адрес, Знач ИмяИконки)
	Возврат Новый Структура("Подпись, Адрес, Иконка", Подпись, Адрес, ИмяИконки);
КонецФункции

// Выход остаётся формой: ход по ссылке уводил бы человека из учётки предзагрузкой
// соседней вкладки. Кнопку в пункте меню кит не собирает — он берёт готовый фрагмент.
Функция Выход()

	Форма = Кит.ФормаБезТокена(АдресВыхода(), "меню");
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер, Иконка",
		Тексты.Текст("chrome.top.logout"), "ссылка", "малый", "выход")));

	Возврат Новый Структура("HTML", Форма.Рендер());

КонецФункции

// Число на кнопке — одно на всё меню, поэтому в речь оно уходит словами: голое «4»
// скринридеру не значит ничего. Ждать нечего — нет ни бейджа, ни его подписи.
Функция ПодписьСчётчика(Знач Ждёт)

	Если Ждёт = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Тексты.Шаблон("chrome.account.menu.waiting", Тексты.ЧислоТекстом(Ждёт));

КонецФункции

// Слагаемые суммы называет сам пункт: иначе человек видит на кнопке «4» и не знает,
// куда идти. Числа в подписи нет, пока считать нечего.
Функция ПодписьУведомлений(Знач Непрочитано)

	Если Непрочитано = 0 Тогда
		Возврат Тексты.Текст("chrome.account.menu.notifications");
	КонецЕсли;

	Возврат Тексты.Шаблон("chrome.account.menu.notifications.unread",
		Тексты.ЧислоТекстом(Непрочитано));

КонецФункции

Функция ПодписьВходящих(Знач НаРешение)

	Если НаРешение = 0 Тогда
		Возврат Тексты.Текст("chrome.account.menu.inbox");
	КонецЕсли;

	Возврат Тексты.Шаблон("chrome.account.menu.inbox.waiting",
		Тексты.ЧислоТекстом(НаРешение));

КонецФункции

// Лента и рассмотрение к обрамлению могут быть не собраны (граф рендера без доменных
// желудей): тогда пункт остаётся, а счёта у него нет.
Функция СчётНепрочитанного(Знач Человек)
	Возврат ?(Лента = Неопределено, 0, Цел(Лента.Непрочитано(Человек)));
КонецФункции

Функция СчётЗаявокНаРешение(Знач Человек)
	Возврат ?(Рассмотрение = Неопределено, 0, Цел(Рассмотрение.СколькоЖдётРешения(Человек)));
КонецФункции

#КонецОбласти

#Область КонтекстЗапроса

Функция Адреса()

	Возврат Новый Структура("Корень, Вход, Кабинет, Выход, Оформление",
		"/", ВходВХаб.ПутьВхода(), АдресаМеня.Личное(), АдресВыхода(), "/ui/theme");

КонецФункции

Функция АдресВыхода()
	Возврат "/logout";
КонецФункции

Функция АдресНастроекХаба()
	Возврат "/hub/settings";
КонецФункции

Функция ИмяВошедшего(Знач Контекст)

	Человек = Вошедший(Контекст);
	Возврат ?(Человек = Неопределено, "", Человек.Логин);

КонецФункции

Функция Вошедший(Знач Контекст)

	Пользователь = Неопределено;
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Контекст.Свойство("Пользователь", Пользователь);
	КонецЕсли;

	Возврат Пользователь;

КонецФункции

Функция Флаг(Знач Контекст, Знач Ключ)

	Значение = Ложь;
	Если ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Контекст.Свойство(Ключ, Значение);
	Возврат Значение = Истина;

КонецФункции

#КонецОбласти

&Верховный
&Прозвище("ОбрамлениеИнсталляции")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Брендирование") _Бренд,
	&Пластилин(Значение = "АдресаСтатики") _Активы,
	&Пластилин(Значение = "ЗаголовкиКэша") _Заголовки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаКаталога") _Каталог,
	&Пластилин(Значение = "ВозвратПослеВхода") _ВходВХаб,
	&Пластилин(Значение = "АдресаКабинета") _АдресаМеня,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ЛентаУведомлений") _Лента = Неопределено,
	&Пластилин(Значение = "РассмотрениеВходящих") _Рассмотрение = Неопределено,
	&Пластилин(Значение = "СервисПрав") _Права = Неопределено) Экспорт

	Бренд = _Бренд;
	Активы = _Активы;
	Заголовки = _Заголовки;
	Тексты = _Тексты;
	Каталог = _Каталог;
	ВходВХаб = _ВходВХаб;
	АдресаМеня = _АдресаМеня;
	Кит = _Кит;
	Лента = _Лента;
	Рассмотрение = _Рассмотрение;
	Права = _Права;

КонецПроцедуры
