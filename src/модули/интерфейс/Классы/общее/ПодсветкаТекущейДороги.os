// Какой пункт единого меню соответствует текущему адресу. Вся арифметика над адресами
// живёт здесь: обрамление знает, из чего меню собрано, а не как оно считает совпадения.

#Использовать url

#Область ПубличныйИнтерфейс

// Отмечает признаком «Активен» тот пункт, чей адрес накрывает текущий путь точнее прочих.
// Горит РОВНО ОДИН: без этого «Кабинет» (/me) светился бы на каждом экране кабинета заодно
// с «Уведомлениями» (/me/notifications), а «Каталог» — рядом с «Моими пакетами».
//
// Параметры:
//  Путь   - Строка - путь текущего запроса; пустой не подсвечивает ничего.
//  Дела   - Массив из Структура - дела вошедшего: Подпись, Адрес, Иконка.
//  Дороги - Массив из Структура - дороги хаба: Подпись, Адрес, Иконка.
//
Процедура ОтметитьТекущую(Знач Путь, Дела, Дороги) Экспорт

	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат;
	КонецЕсли;

	Текущий = Неопределено;
	Лучший = Неопределено;

	Для Каждого Пункт Из ОдинСписок(Дела, Дороги) Цикл

		Вес = ВесСовпадения(Пункт.Адрес, Путь);
		Если Вес = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Лучший = Неопределено ИЛИ Специфичнее(Вес, Лучший) Тогда
			Лучший = Вес;
			Текущий = Пункт;
		КонецЕсли;

	КонецЦикла;

	Если Текущий <> Неопределено Тогда
		Текущий.Вставить("Активен", Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Дела и дороги состязаются вместе: экран принадлежит одному месту хаба, и гореть на нём
// должен один пункт — в каком бы из двух списков он ни стоял.
Функция ОдинСписок(Знач Дела, Знач Дороги)

	Результат = Новый Массив();
	Для Каждого Пункт Из Дела Цикл
		Результат.Добавить(Пункт);
	КонецЦикла;
	Для Каждого Пункт Из Дороги Цикл
		Результат.Добавить(Пункт);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Насколько адрес пункта накрывает текущий путь; Неопределено — не накрывает вовсе.
Функция ВесСовпадения(Знач Адрес, Знач Путь)

	Цель = РазобратьАдрес(Адрес);
	Текущий = РазобратьАдрес(Путь);

	Если НЕ НакрываетПуть(Цель.Путь, Текущий.Путь) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ ПараметрыСтоятВЗапросе(Цель.Параметры, Текущий.Параметры) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("СПараметрами, ДлинаПути",
		Цель.Параметры.Количество() > 0, СтрДлина(Цель.Путь));

КонецФункции

// Кто точнее: сперва тот, чей путь длиннее («/me/settings/tokens» — это «Настройки
// аккаунта», а не «Кабинет»), и лишь при равных путях решают параметры запроса
// (на «/packages?mine=1» «Мои пакеты» обязаны победить «Каталог»).
Функция Специфичнее(Знач Претендент, Знач Лучший)

	Если Претендент.ДлинаПути <> Лучший.ДлинаПути Тогда
		Возврат Претендент.ДлинаПути > Лучший.ДлинаПути;
	КонецЕсли;

	Возврат Претендент.СПараметрами И НЕ Лучший.СПараметрами;

КонецФункции

// Накрытие считается по СЕГМЕНТАМ: иначе «/me» накрыл бы «/menu», а «/hub/settings» —
// «/hub/settings-backup». Раздел дома под своей дорогой лежит («/hub/settings/люди»),
// поэтому дорога накрывает и его.
Функция НакрываетПуть(Знач Адрес, Знач Текущий)

	Если Адрес = Текущий Тогда
		Возврат Истина;
	КонецЕсли;

	// корень накрыл бы весь хаб разом, поэтому он совпадает только сам с собой
	Если НЕ ЗначениеЗаполнено(Адрес) ИЛИ Адрес = "/" Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНачинаетсяС(Текущий, Адрес + "/");

КонецФункции

// Параметры адреса — требование, а не украшение: «Мои пакеты» это /packages именно
// с mine=1, и на голом /packages они гореть не должны. Лишние параметры запроса
// (страница, поиск) требованию не мешают.
Функция ПараметрыСтоятВЗапросе(Знач Требуемые, Знач Запрос)

	Для Каждого Требование Из Требуемые Цикл
		Если Запрос.Получить(Требование.Ключ) <> Требование.Значение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Адрес пункта и путь запроса разбираются одинаково: путь без хвостовой косой и параметры
// запроса соответствием. Значения декодируются теми же правилами, что и форма экрана, —
// иначе «Мои пакеты» не загорелись бы на ссылке, которую сам же хаб и собрал.
Функция РазобратьАдрес(Знач Адрес)

	Части = СтрРазделить(Строка(Адрес), "?", Истина);
	Параметры = Новый Соответствие();

	Если Части.Количество() > 1 Тогда
		Для Каждого Пара Из Новый ПараметрыЗапросаURL(Части[1]).ВМассив() Цикл
			Если Параметры.Получить(Пара.Имя) = Неопределено Тогда
				Параметры.Вставить(Пара.Имя, Пара.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Новый Структура("Путь, Параметры",
		БезХвостовойКосой(СокрЛП(Части[0])), Параметры);

КонецФункции

Функция БезХвостовойКосой(Знач Путь)

	Если СтрДлина(Путь) > 1 И Прав(Путь, 1) = "/" Тогда
		Возврат Лев(Путь, СтрДлина(Путь) - 1);
	КонецЕсли;

	Возврат Путь;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
