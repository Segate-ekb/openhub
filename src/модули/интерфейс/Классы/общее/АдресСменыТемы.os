// Адрес формы смены темы с путём возврата: форма стоит на каждой странице и сама несёт путь
// той страницы, куда вернуть посетителя, — Referer хаб наружу не отдаёт.

// Адрес формы смены темы.
//
// Параметры:
//  ПутьВозврата - Строка - путь текущей страницы с параметрами запроса; пустой — адрес без возврата.
//
// Возвращаемое значение:
//  Строка - путь формы, с возвратом — параметром ИмяПараметра().
//
Функция Адрес(Знач ПутьВозврата) Экспорт

	Если НЕ ЗначениеЗаполнено(ПутьВозврата) Тогда
		Возврат Путь();
	КонецЕсли;

	// у пути формы своих параметров нет, поэтому пара встаёт первой и единственной
	Возврат Путь() + "?" + ИмяПараметра() + "="
		+ КодироватьСтроку(ПутьВозврата, СпособКодированияСтроки.КодировкаURL);

КонецФункции

// Запоминает в контексте страницы её собственный адрес — для экрана, у которого путь
// контекста называет не его самого, а дорогу меню (страница пакета живёт под каталогом).
//
// Параметры:
//  Контекст - Структура - контекст страницы (КаркасСтраницы.КонтекстСтраницы); иное не трогается.
//  АдресСтраницы - Строка - путь страницы с параметрами запроса; пустой не запоминается.
//
Процедура ЗапомнитьАдресСтраницы(Контекст, Знач АдресСтраницы) Экспорт

	Если ТипЗнч(Контекст) <> Тип("Структура") ИЛИ НЕ ЗначениеЗаполнено(АдресСтраницы) Тогда
		Возврат;
	КонецЕсли;

	Контекст.Вставить("АдресСтраницы", Строка(АдресСтраницы));

КонецПроцедуры

// Куда вернуть посетителя со страницы: её запомненный адрес, а без него — путь контекста.
//
// Параметры:
//  Контекст - Структура, Неопределено - контекст страницы.
//
// Возвращаемое значение:
//  Строка - путь страницы; пустой — страница его не назвала.
//
Функция АдресСтраницы(Знач Контекст) Экспорт

	Если ТипЗнч(Контекст) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Значение = Неопределено;
	Если НЕ Контекст.Свойство("АдресСтраницы", Значение) Тогда
		Контекст.Свойство("Путь", Значение);
	КонецЕсли;

	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));

КонецФункции

// Путь формы смены темы без параметров.
//
// Возвращаемое значение:
//  Строка.
//
Функция Путь() Экспорт
	Возврат "/ui/theme";
КонецФункции

// Имя параметра, в котором форма несёт путь возврата.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПараметра() Экспорт
	Возврат "back";
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
