// Подсказка требований к паролю под полем ввода: что требуется и что уже выполнено.
// Список требований спрашивается у ПолитикаПароля — своей копии в разметке нет.

Перем Кит;       // Кит (кит) — фабрика элементов экрана
Перем Тексты;    // ТекстыИнтерфейса (кит)
Перем Политика;  // ПолитикаПароля (auth)

#Область ПубличныйИнтерфейс

// Действующие требования словами, каждое — со своим машинным кодом, по которому браузер
// судит набираемый пароль, не отправляя его.
//
// Параметры:
//  ИмяПоля - Строка - имя (атрибут name) поля ввода, значение которого проверяется.
//
// Возвращаемое значение:
//  ЭлементЭкрана - блок требований; ничего для поля без имени либо политики
//                  без единого требования.
//
Функция Требования(Знач ИмяПоля) Экспорт

	Поле = СокрЛП(Строка(ИмяПоля));
	Правила = Политика.ТребованияПодробно();

	Если НЕ ЗначениеЗаполнено(Поле) ИЛИ Правила.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Блок = Кит.Область().Признак("pwreq", Поле);
	Блок.Добавить(Кит.Примечание(Тексты.Текст("password.requirements.title")));

	Список = Блок.Добавить(Кит.Список());
	Для Каждого Требование Из Правила Цикл
		Список.Добавить(Пункт(Требование));
	КонецЦикла;

	Возврат Блок;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Пункт(Знач Требование)

	Результат = Кит.Пункт();

	// требование, которого хаб судить не умеет, кода не несёт вовсе: помечать выполненным
	// то, что никто не проверял, нельзя
	Если ЗначениеЗаполнено(Требование.Код) Тогда
		Результат.Признак("pwrule", Требование.Код);
	КонецЕсли;

	// границы длины несёт то требование, которое их и задаёт: остальным о длине сказать нечего
	Если Требование.Код = "length" Тогда
		Результат.Признак("pwmin", Формат(Требование.Минимум, "ЧГ=0; ЧН=0"));
		Результат.Признак("pwmax", Формат(Требование.Максимум, "ЧГ=0; ЧН=0"));
	КонецЕсли;

	Результат.Добавить(Отметка());
	Результат.Добавить(Кит.Текст(Требование.Текст));

	Возврат Результат;

КонецФункции

// Состояние требования — символ, а не только цвет: отметка читается и без скрипта.
Функция Отметка()

	Результат = Кит.Надпись().Признак("pwmark", "");
	Результат.Добавить(Кит.Текст(НейтральныйЗнак()));
	Возврат Результат;

КонецФункции

Функция НейтральныйЗнак()
	Возврат "•";
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПолитикаПароля") _Политика) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	Политика = _Политика;

КонецПроцедуры
