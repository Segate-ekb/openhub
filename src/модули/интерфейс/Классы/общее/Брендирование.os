// Брендирование инсталляции — желудь модуля web-ui: знак, подпись, признак показа
// названия и адреса ЗАГРУЖЕННЫХ картинок оформления. Читается на запросе. Ни цветов,
// ни разметки, ни фирменных умолчаний картинок: пустой адрес означает «рисуй поставку»,
// и выбор делает рендерер, у которого поставка и так под рукой.

Перем Настройки; // СервисНастроек (настройки); Неопределено — граф рендера без настроек
Перем Активы;    // СервисБрендовыхАктивов (настройки); Неопределено — граф без хранилища
&Лог
Перем Лог;

// Знак инсталляции — текст в шапке, в <title> и в подвале.
//
// Возвращаемое значение:
//  Строка
//
Функция Знак() Экспорт
	Возврат ЛибоПоУмолчанию("oshub.ui.brand", ЗнакПоУмолчанию());
КонецФункции

// Строка подвала: что это за сайт одним предложением.
//
// Возвращаемое значение:
//  Строка
//
Функция Подпись() Экспорт
	Возврат ЛибоПоУмолчанию("oshub.ui.tagline", ПодписьПоУмолчанию());
КонецФункции

// Знак по умолчанию. Живёт здесь, рядом с подписью: подпись — пользовательская проза,
// её место в слое интерфейса, а разносить два умолчания одной группы по разным слоям
// хуже, чем держать их вместе.
//
// Возвращаемое значение:
//  Строка
//
Функция ЗнакПоУмолчанию() Экспорт
	Возврат "OpenHub";
КонецФункции

// Подпись подвала по умолчанию.
//
// Возвращаемое значение:
//  Строка
//
Функция ПодписьПоУмолчанию() Экспорт
	Возврат "Открытый хаб пакетов OneScript · совместим с opm";
КонецФункции

// Печатать ли название рядом со знаком: администратор с горизонтальным логотипом,
// на котором название уже нарисовано, выключает подпись, чтобы она не дублировалась.
//
// Возвращаемое значение:
//  Булево
//
Функция ПоказыватьНазвание() Экспорт

	Если Настройки = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Попытка
		Возврат Настройки.Значение("oshub.ui.show_name") = Истина;
	Исключение
		Предупредить("oshub.ui.show_name", ИнформацияОбОшибке());
		Возврат Истина;
	КонецПопытки;

КонецФункции

// Префикс, под которым отдаются загруженные картинки оформления.
//
// Возвращаемое значение:
//  Строка
//
Функция БазовыйПутьАктивов() Экспорт
	Возврат "/brand";
КонецФункции

// Адрес загруженного знака шапки.
//
// Возвращаемое значение:
//  Строка - адрес с отпечатком содержимого либо "" — знак не загружали.
//
Функция АдресЗагруженногоЗнака() Экспорт
	Возврат АдресАктива(КлючЗнака());
КонецФункции

// Адрес загруженной иконки сайта.
//
// Возвращаемое значение:
//  Строка - адрес с отпечатком содержимого либо "" — иконку не загружали.
//
Функция АдресЗагруженнойИконки() Экспорт
	Возврат АдресАктива(КлючИконки());
КонецФункции

// Тип контента загруженной иконки сайта — его печатают в <link type>.
//
// Возвращаемое значение:
//  Строка - Content-Type либо "" — иконку не загружали.
//
Функция ТипЗагруженнойИконки() Экспорт

	Ключ_ = КлючИконки();
	Если НЕ ЗначениеЗаполнено(АдресАктива(Ключ_)) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат Активы.Сведения(Ключ_).ТипКонтента;
	Исключение
		Предупредить("brand asset " + Ключ_, ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция КлючЗнака()
	Возврат ?(Активы = Неопределено, "", Активы.КлючЗнака());
КонецФункции

Функция КлючИконки()
	Возврат ?(Активы = Неопределено, "", Активы.КлючИконки());
КонецФункции

// Недоступная база не роняет страницу: оформление откатывается к фирменному, но молчать
// об этом нельзя — оператор обязан увидеть отказ в журнале.
Функция АдресАктива(Знач Ключ_)

	Если Активы = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Ключ_) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Имя = Активы.ПубличноеИмя(Ключ_);
	Исключение
		Предупредить("brand asset " + Ключ_, ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

	Адрес = ?(ЗначениеЗаполнено(Имя), БазовыйПутьАктивов() + "/" + Имя, "");
	// «в шапке не тот знак» разбирается здесь: видно, чем ключ актива обернулся
	Если Лог <> Неопределено Тогда
		Лог.Отладка("branding: asset %1 resolved to %2",
			Ключ_, ?(ЗначениеЗаполнено(Адрес), Адрес, "none"));
	КонецЕсли;
	Возврат Адрес;

КонецФункции

// Пустое значение схлопывается к умолчанию: страница без знака выглядит сломанной.
// Недоступная база — тот же случай: шапка и подвал рисуются, а не роняют ответ.
Функция ЛибоПоУмолчанию(Знач Ключ_, Знач ПоУмолчанию)

	Значение = "";
	Если Настройки <> Неопределено Тогда
		Попытка
			Значение = СокрЛП(Строка(Настройки.Значение(Ключ_)));
		Исключение
			Значение = "";
			Предупредить(Ключ_, ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	Возврат ?(ЗначениеЗаполнено(Значение), Значение, ПоУмолчанию);

КонецФункции

// Текст лога — диагностика оператору, без кириллицы: страж «строки живут в СловареТекстов».
Процедура Предупредить(Знач Ключ_, Знач Ошибка)
	Если Лог <> Неопределено Тогда
		Лог.Предупреждение("branding: setting %1 unreadable (%2), falling back to default",
			Ключ_, КраткоеПредставлениеОшибки(Ошибка));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

// Лог берётся инъекцией ОСени в поле (&Лог выше) — боевой путь.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "СервисБрендовыхАктивов") _Активы = Неопределено,
	&Лог _Лог = Неопределено) Экспорт

	Настройки = _Настройки;
	Активы = _Активы;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
