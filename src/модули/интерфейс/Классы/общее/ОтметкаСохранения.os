// Отметка «сохранено» параметром на адресе: по ней страница после удавшейся записи
// показывает плашку «изменения сохранены».

Перем Ссылки;  // ПараметрыСсылки (основа) — параметр запроса на адресе

// Имя параметра, которым страница узнаёт об удавшейся записи.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяОтметки() Экспорт
	Возврат "saved";
КонецФункции

// Адрес с отметкой «сохранено».
//
// Параметры:
//  Адрес - Строка - адрес раздела.
//
// Возвращаемое значение:
//  Строка - адрес с отметкой.
//
Функция НаАдресе(Знач Адрес) Экспорт
	Возврат Ссылки.Установить(Адрес, ИмяОтметки(), "1");
КонецФункции

// Адрес с отметкой «сохранено» и парами раздела, которые должны пережить редирект.
//
// Параметры:
//  Адрес - Строка - адрес раздела.
//  Пары - Соответствие, Неопределено - имя параметра -> значение.
//
// Возвращаемое значение:
//  Строка - адрес с отметкой и парами.
//
Функция НаАдресеСПарами(Знач Адрес, Знач Пары) Экспорт

	Результат = НаАдресе(Адрес);
	Если Пары = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Пара Из Пары Цикл
		Результат = Ссылки.Установить(Результат, Пара.Ключ, Пара.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&Прозвище("ОтметкаСохранения")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПараметрыСсылки") _Ссылки = Неопределено) Экспорт

	Ссылки = ?(_Ссылки = Неопределено, Новый ПараметрыСсылки(), _Ссылки);

КонецПроцедуры
