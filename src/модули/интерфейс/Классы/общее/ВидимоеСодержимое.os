// Срез хаба глазами запроса: читаемые ему пулы и их нескрытые пакеты. Одна выборка
// пулов и одна выборка пакетов на запрос — витрины публичной части считают по срезу.
// Пакеты читаются разрезом по читаемым пулам: приватная половина хаба лендинг анониму
// не удорожает.

Перем СервисПулов;    // СервисПулов (реестр)
Перем СервисПакетов;  // СервисПакетов (реестр)
Перем Видимость;      // ВидимостьПулов (поиск)

// Возвращает доступный запросу срез хаба. Пакет невидимого пула и пакет-сирота в срез
// не попадают — fail-closed.
//
// Параметры:
//  Принципал - Структура, Неопределено - (необязательный, по умолчанию Неопределено)
//              принципал запроса; Неопределено — аноним.
//
// Возвращаемое значение:
//  Структура - Пулы (Массив из Пул), Пакеты (Массив из Пакет, без скрытых),
//              ПакетовВПуле (Соответствие: идентификатор пула -> число пакетов).
//
Функция Срез(Знач Принципал = Неопределено) Экспорт

	Решение = Видимость.Решение(Принципал);

	Пулы = Новый Массив();
	ПакетовВПуле = Новый Соответствие();

	Для Каждого Пул Из СервисПулов.ВсеПулы() Цикл
		Если НЕ Видимость.ПулВиден(Решение, Пул.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;
		Пулы.Добавить(Пул);
		ПакетовВПуле.Вставить(Цел(Пул.Идентификатор), 0);
	КонецЦикла;

	Пакеты = Новый Массив();

	Для Каждого Пакет Из СервисПакетов.ПакетыПулов(Идентификаторы(Пулы)) Цикл
		Если Пакет.Скрыт = Истина Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Цел(Пакет.ПулИдентификатор);
		Учтено = ПакетовВПуле.Получить(Ключ);
		Если Учтено = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПакетовВПуле.Вставить(Ключ, Учтено + 1);
		Пакеты.Добавить(Пакет);
	КонецЦикла;

	Возврат Новый Структура("Пулы, Пакеты, ПакетовВПуле", Пулы, Пакеты, ПакетовВПуле);

КонецФункции

Функция Идентификаторы(Знач Пулы)

	Результат = Новый Массив();
	Для Каждого Пул Из Пулы Цикл
		Результат.Добавить(Цел(Пул.Идентификатор));
	КонецЦикла;
	Возврат Результат;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "ВидимостьПулов") _Видимость)

	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	Видимость = _Видимость;

КонецПроцедуры
