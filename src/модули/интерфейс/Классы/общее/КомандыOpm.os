// Команды opm для пакета хаба: адресная форма установки (узел, пул, имя), описание
// сервера для opm.cfg и установка через -m. Разметки здесь нет — только текст команд.

Перем АдресХаба;  // АдресИнстанса (основа)
Перем Заголовки;  // ЗаголовкиHTTP (основа)
Перем Тексты;     // ТекстJSON (основа) — образец конфигурации с отступами
Перем Адреса;     // РазборАдреса (основа) — узел адреса читает он

#Область ПрограммныйИнтерфейс

// Узел хаба для команд установки: берётся из настройки «URL инстанса», а при незаданной —
// из заголовка Host текущего запроса.
//
// Параметры:
//  ЗаголовкиЗапроса - Соответствие, Неопределено - заголовки запроса.
//
// Возвращаемое значение:
//  Строка - «example.org:3380» либо «», если узел не определяется.
//
Функция Узел(Знач ЗаголовкиЗапроса) Экспорт

	База = АдресХаба.Базовый();
	Если ЗначениеЗаполнено(База) Тогда
		Возврат БезопасныйУзел(Адреса.Узел(База));
	КонецЕсли;

	Возврат БезопасныйУзел(Заголовки.Текст(ЗаголовкиЗапроса, "Host"));

КонецФункции

// Схема внешнего адреса хаба: https только тогда, когда её назвала настройка «URL
// инстанса»; заголовку Host про схему верить нечего.
//
// Возвращаемое значение:
//  Строка - «https» либо «http».
//
Функция СхемаАдреса() Экспорт
	Возврат ?(СтрНачинаетсяС(НРег(АдресХаба.Базовый()), "https://"), "https", "http");
КонецФункции

// Версия клиента, начиная с которой пул адресуется прямо в имени пакета и запись сервера
// в настройках не нужна. Единственное место, где это число названо: подсказка установки
// говорит им и о команде шапки, и о легаси-флоу.
//
// Возвращаемое значение:
//  Строка - semver-версия opm.
//
Функция ВерсияКлиентаСАдресациейПула() Экспорт
	Возврат "1.7.0";
КонецФункции

// Достаточно ли короткой формы «opm install <пакет>»: пакет лежит в дефолтном пуле хаба,
// и адрес с пулом в команде только мешал бы читать.
//
// Параметры:
//  Пул - Пул, Неопределено - пул пакета.
//
// Возвращаемое значение:
//  Булево.
//
Функция КороткаяФорма(Знач Пул) Экспорт
	Возврат Пул <> Неопределено И Пул.ЭтоДефолтный();
КонецФункции

// Команда установки пакета одной строкой.
//
// Параметры:
//  Пул        - Пул, Неопределено - пул пакета.
//  ИмяПакета  - Строка - имя пакета.
//  Узел       - Строка - узел хаба (см. Узел()).
//  Координата - Строка - (необязательный, по умолчанию "") тег или версия.
//
// Возвращаемое значение:
//  Строка - «opm install example.org:3380/contrib/mylib@stable».
//
Функция Установка(Знач Пул, Знач ИмяПакета, Знач Узел, Знач Координата = "") Экспорт
	Возврат "opm install " + Цель(Пул, ИмяПакета, Узел) + Уточнение(Координата);
КонецФункции

// Имя, под которым пул прописывается сервером пакетов в opm.cfg.
//
// Параметры:
//  Пул - Пул, Неопределено - пул пакета.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяСервера(Знач Пул) Экспорт
	Возврат ИмяПула(Пул);
КонецФункции

// Команда установки через сервер из opm.cfg — форма, которую понимает штатный opm.
//
// Параметры:
//  Пул        - Пул, Неопределено - пул пакета.
//  ИмяПакета  - Строка - имя пакета.
//  Координата - Строка - (необязательный, по умолчанию "") тег или версия.
//
// Возвращаемое значение:
//  Строка - «opm install -m contrib mylib@stable».
//
Функция УстановкаЧерезСервер(Знач Пул, Знач ИмяПакета, Знач Координата = "") Экспорт

	Возврат СтрШаблон("opm install -m %1 %2%3",
		ИмяСервера(Пул), Строка(ИмяПакета), Уточнение(Координата));

КонецФункции

// Описание пула сервером пакетов для opm.cfg. Порт продублирован в «Сервер»: поле «Порт»
// opm push не читает и без порта в адресе стучится на 80.
//
// Параметры:
//  Пул  - Пул, Неопределено - пул пакета.
//  Узел - Строка - узел хаба (см. Узел()).
//
// Возвращаемое значение:
//  Строка - фрагмент opm.cfg с одним сервером пакетов.
//
Функция ОписаниеСервера(Знач Пул, Знач Узел) Экспорт

	Путь = "/api/v1/pools/" + ИмяПула(Пул);

	Сервер = Новый Структура();
	Сервер.Вставить("Имя", ИмяСервера(Пул));
	Сервер.Вставить("Сервер", Схема() + "://" + Узел);
	Сервер.Вставить("Порт", ПортУзла(Узел));
	Сервер.Вставить("ПутьНаСервере", Путь + "/download/");
	Сервер.Вставить("РесурсПубликацииПакетов", Путь + "/push");
	Если ТребуетКлюча(Пул) Тогда
		Сервер.Вставить("Авторизация", "Bearer " + ОбразецТокена());
	КонецЕсли;
	Сервер.Вставить("Приоритет", 1);

	Список = Новый Массив();
	Список.Добавить(Сервер);

	Возврат Тексты.СОтступами(Новый Структура("СервераПакетов", Список));

КонецФункции

// Нужен ли для установки из пула ключ доступа: приватный пул без токена отвечает
// «не найдено» на любую команду.
//
// Параметры:
//  Пул - Пул, Неопределено - пул пакета.
//
// Возвращаемое значение:
//  Булево.
//
Функция ТребуетКлюча(Знач Пул) Экспорт
	Возврат Пул <> Неопределено И НРег(СокрЛП(Строка(Пул.Видимость))) = "private";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Цель(Знач Пул, Знач ИмяПакета, Знач Узел)

	Если КороткаяФорма(Пул) Тогда
		Возврат Строка(ИмяПакета);
	КонецЕсли;

	Префикс = ?(ЗначениеЗаполнено(Узел), Узел + "/", "");
	Возврат Префикс + ИмяПула(Пул) + "/" + Строка(ИмяПакета);

КонецФункции

Функция Уточнение(Знач Координата)
	Возврат ?(ЗначениеЗаполнено(Координата), "@" + Строка(Координата), "");
КонецФункции

Функция ИмяПула(Знач Пул)
	Возврат ?(Пул = Неопределено, "", СокрЛП(Строка(Пул.Имя)));
КонецФункции

Функция Схема()
	Возврат СхемаАдреса();
КонецФункции

// Место токена в образце конфигурации: настоящий PAT человек подставляет сам.
Функция ОбразецТокена()
	Возврат "oshub_…";
КонецФункции

Функция ПортУзла(Знач Узел)

	Позиция = СтрНайти(Узел, ":", НаправлениеПоиска.СКонца);
	Если Позиция > СтрНайти(Узел, "]", НаправлениеПоиска.СКонца) Тогда
		Попытка
			Возврат Число(Сред(Узел, Позиция + 1));
		Исключение
			Возврат ПортСхемы();
		КонецПопытки;
	КонецЕсли;

	Возврат ПортСхемы();

КонецФункции

Функция ПортСхемы()
	Возврат ?(Схема() = "https", 443, 80);
КонецФункции

// Host приходит от клиента: берётся начальный отрезок, который может быть узлом, остаток режется.
Функция БезопасныйУзел(Знач Сырое)

	Значение = СокрЛП(Строка(Сырое));

	Разделитель = СтрНайти(Значение, "@", НаправлениеПоиска.СКонца);
	Если Разделитель > 0 Тогда
		Значение = Сред(Значение, Разделитель + 1);
	КонецЕсли;

	Результат = "";
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Символ = НРег(Сред(Значение, Индекс, 1));
		Если СтрНайти(СимволыУзла(), Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		Результат = Результат + Символ;
	КонецЦикла;

	Если СтрДлина(Результат) = 0 ИЛИ СтрДлина(Результат) > 255 Тогда
		Возврат "";
	КонецЕсли;

	Возврат ?(СтрНайти(НачальныеСимволыУзла(), Лев(Результат, 1)) = 0, "", Результат);

КонецФункции

Функция СимволыУзла()
	Возврат "abcdefghijklmnopqrstuvwxyz0123456789.-:[]";
КонецФункции

Функция НачальныеСимволыУзла()
	Возврат "abcdefghijklmnopqrstuvwxyz0123456789[";
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "АдресИнстанса") _АдресХаба,
	&Пластилин(Значение = "ЗаголовкиHTTP") _Заголовки,
	&Пластилин(Значение = "ТекстJSON") _Тексты = Неопределено,
	&Пластилин(Значение = "РазборАдреса") _Адреса = Неопределено)

	АдресХаба = _АдресХаба;
	Заголовки = _Заголовки;
	Тексты = ?(_Тексты = Неопределено, Новый ТекстJSON(), _Тексты);
	Адреса = ?(_Адреса = Неопределено, Новый РазборАдреса(), _Адреса);

КонецПроцедуры
