// Принципал запроса глазами страницы: учётка — шапке и меню, сессия, прочитанная гвардом или
// стражем, — токену «Выйти». Один разбор для всех дверей, отдающих страницу.

#Область ПубличныйИнтерфейс

// Учётка принципала.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал гварда или стража: вердикт, контекст пульта,
//              принципал перехватчика — структура с полями Пользователь и Сессия; гость — Неопределено.
//
// Возвращаемое значение:
//  Произвольный - пользователь; Неопределено — гость.
//
Функция Пользователь(Знач Принципал) Экспорт
	Возврат ПолеСтруктуры(Принципал, "Пользователь");
КонецФункции

// Сессия принципала: её уже прочитал гвард или страж, второй раз по куке её не читают.
//
// Параметры:
//  Принципал - Структура, Неопределено - см. Пользователь().
//
// Возвращаемое значение:
//  Произвольный - сессия; Неопределено — гость или ключ (PAT).
//
Функция Сессия(Знач Принципал) Экспорт
	Возврат ПолеСтруктуры(Принципал, "Сессия");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пользователь вместо принципала — ошибка сборки двери: молча она отдала бы гостевую страницу.
Функция ПолеСтруктуры(Знач Принципал, Знач Имя)

	Если Принципал = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = Неопределено;
	Если ТипЗнч(Принципал) <> Тип("Структура") ИЛИ НЕ Принципал.Свойство("Пользователь") Тогда
		ВызватьИсключение СтрШаблон("Страница ждёт принципала — структуру с полями Пользователь и Сессия"
			+ " (вердикт гварда, контекст пульта, принципал стража), а получила %1: передайте вердикт"
			+ " целиком, а не его пользователя.", ТипЗнч(Принципал));
	КонецЕсли;
	Принципал.Свойство(Имя, Значение);
	Возврат Значение;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
