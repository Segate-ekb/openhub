// Адреса экранов кабинета: маршрут каждого экрана записан здесь один раз.

Перем Страницы; // АдресаСтраниц (реестр) — личное пространство живёт страницей пула

// Корень личного пространства.
//
// Возвращаемое значение:
//  Строка - адрес экрана.
//
Функция Личное() Экспорт
	Возврат "/me";
КонецФункции

// Сводка заявок, ждущих решения вошедшего.
//
// Возвращаемое значение:
//  Строка - адрес экрана.
//
Функция Входящие() Экспорт
	Возврат Личное() + "/inbox";
КонецФункции

// Корень дома настроек аккаунта; адреса его разделов собирает ДомАккаунта.
//
// Возвращаемое значение:
//  Строка - адрес дома.
//
Функция Настройки() Экспорт
	Возврат Личное() + "/settings";
КонецФункции

// Лента личных уведомлений вошедшего.
//
// Возвращаемое значение:
//  Строка - адрес экрана.
//
Функция Уведомления() Экспорт
	Возврат Личное() + "/notifications";
КонецФункции

// Личное пространство человека — пул, названный его логином.
//
// Параметры:
//  Логин - Строка - логин владельца пространства.
//
// Возвращаемое значение:
//  Строка - адрес пула.
//
Функция Пространство(Знач Логин) Экспорт
	Возврат Страницы.Пула(Строка(Логин));
КонецФункции

// Сводка зеркал пулов, которыми распоряжается вошедший.
//
// Возвращаемое значение:
//  Строка - адрес экрана.
//
Функция Зеркала() Экспорт
	Возврат "/office/mirrors";
КонецФункции

// Зеркала одного пула в сводке кабинета.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Строка - адрес экрана.
//
Функция ЗеркалаПула(Знач ИмяПула) Экспорт
	Возврат Зеркала() + "/" + ИмяПула;
КонецФункции

// Проводник первой публикации — вне /me: на него ведёт и пустая главная хаба.
//
// Возвращаемое значение:
//  Строка - адрес экрана.
//
Функция Проводник() Экспорт
	Возврат "/tour";
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "АдресаСтраниц") _Страницы) Экспорт
	Страницы = _Страницы;
КонецПроцедуры
