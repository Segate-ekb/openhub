// Контроллер статики — web-ui: GET /static/{файл} с заголовками кэширования. Сегмент {файл}
// целиком ищется в белом списке АктивыСтатики.Файлы(); с путём склеивается только имя оттуда.

Перем Активы;      // АктивыСтатики
Перем ПустыеКуки;  // Куки (winow) — пустая коллекция для снятия Set-Cookie
Перем Ответы;      // ОтветыAPI (основа)
Перем Заголовки;   // ЗаголовкиКэша (основа) — Cache-Control, ETag и сверка If-None-Match
Перем НеНайдено;   // ОтветНеНайдено — общий отказ по адресу актива

// Отдаёт файл статики: 200 с телом, 304 по If-None-Match либо 404 для имени вне
// белого списка.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  файл             - Строка       - имя файла с отпечатком из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса (If-None-Match).
//
&ТочкаМаршрута("{файл}")
Процедура Отдать(Ответ, файл, ЗаголовкиЗапроса) Экспорт

	// куку снимаем ПЕРВЫМ делом: она не нужна ни на 200, ни на 304, ни на 404
	Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);

	Имя = Строка(файл);
	ТипКонтента = Активы.ТипКонтента(Имя);

	Если ТипКонтента = Неопределено Тогда
		НеНайдено.Отдать(Ответ);
		Возврат;
	КонецЕсли;

	Метка = Активы.ETag(Имя);
	Ответ.Заголовки["Cache-Control"] = Заголовки.НеизменяемыйКэш();
	Если ЗначениеЗаполнено(Метка) Тогда
		Ответ.Заголовки["ETag"] = Метка;
		Если Заголовки.СовпадаетETag(ЗаголовкиЗапроса, Метка) Тогда
			Ответ.УстановитьСостояние(304);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// путь берётся ИЗ ТАБЛИЦЫ целиком, присланное имя в него не попадает
	Путь = Активы.ПутьНаДиске(Имя);
	Если Путь = Неопределено ИЛИ НЕ Новый Файл(Путь).Существует() Тогда
		НеНайдено.Отдать(Ответ);
		Возврат;
	КонецЕсли;

	Ответ.УстановитьСостояниеОК();
	Ответ.Заголовки["Content-Type"] = ТипКонтента;
	Ответ.ТелоДвоичныеДанные = Новый ДвоичныеДанные(Путь);

КонецПроцедуры

&Контроллер("/static")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "АктивыСтатики") _Активы,
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "ЗаголовкиКэша") _Заголовки,
	&Пластилин(Значение = "Куки") _ПустыеКуки,
	&Пластилин(Значение = "ОтветНеНайдено") _НеНайдено)

	Активы = _Активы;
	Ответы = _Ответы;
	Заголовки = _Заголовки;
	ПустыеКуки = _ПустыеКуки; // никогда не мутируется: подменяет Ответ.Куки
	НеНайдено = _НеНайдено;

КонецПроцедуры
