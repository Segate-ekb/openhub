// Плашка тега — желудь модуля web-ui: ЕДИНСТВЕННОЕ место, где тег превращается в плашку.
// Здесь же ряд каналов у версии и живое превью тега в конструкторе: вид тега нигде больше
// не считается, поэтому на всех страницах хаба он одинаков.

Перем Кит;         // Кит (oscript-ui) — фабрика элементов экрана
Перем Оформление;  // ОформлениеТега (web-ui) — ключи тега в модель плашки
Перем Значки;      // ЗначокТега (реестр) — единственный словарь значков плашки
Перем Тексты;      // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Модели;      // ЧтениеМодели (кит) — мягкое чтение опций

#Область ПубличныйИнтерфейс

// Плашка тега в его оформлении: цвет даёт переменная темы по ключу стиля, поэтому
// одна и та же строка БД читается и в светлой теме, и в тёмной.
//
// Параметры:
//  Тег - Тег - тег, чью плашку рисуем; годится и структура с полями Имя, Стиль, Значок,
//        ПоУмолчанию.
//  Опции - Структура - (необязательный) Подсказка (атрибут title), Адрес (плашка
//          становится ссылкой), Действие (доверенная разметка управления ВНУТРИ плашки).
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел компонента «плашка».
//
Функция ПоТегу(Знач Тег, Знач Опции = Неопределено) Экспорт

	ПроверитьИмя(Тег);

	Модель = Оформление.МодельПлашки(Тег.Имя, Тег.Стиль, Тег.Значок);
	Модель.Вставить("Подсказка", Модели.Текст(Опции, "Подсказка"));
	Модель.Вставить("Адрес", Модели.Текст(Опции, "Адрес"));
	Модель.Вставить("Действие", Модели.Текст(Опции, "Действие"));
	Возврат Кит.Плашка(Модель);

КонецФункции

// Тег как канал обновления: плашка и — у основного тега пакета — приглушённая пометка
// рядом с ней. Внутрь плашки пометка не входит: «основной» — свойство канала, а не часть
// имени тега, и способ пометить его на всех экранах один.
//
// Параметры:
//  Тег - Тег - тег пакета.
//  Опции - Структура - (необязательный) те же, что у ПоТегу.
//
// Возвращаемое значение:
//  ЭлементЭкрана - плашка с пометкой основного канала.
//
Функция Канал(Знач Тег, Знач Опции = Неопределено) Экспорт

	Результат = Кит.Холст();
	Результат.Добавить(ПоТегу(Тег, Опции));
	Результат.Добавить(ПометкаОсновного(Тег));
	Возврат Результат;

КонецФункции

// Ряд каналов версии: основной тег первым, остальные до предела, хвост — в раскрывашке
// «ещё N», без JS.
//
// Параметры:
//  Теги - Массив из Тег - теги, стоящие на версии.
//  Опции - Структура - (необязательный) Предел (сколько неосновных показывать,
//          по умолчанию 3), Заголовок (имя ряда для скринридера), Подсказки
//          (Соответствие «имя тега → подсказка плашки»).
//
// Возвращаемое значение:
//  ЭлементЭкрана - ряд свёрнутых плашек либо пустой холст.
//
Функция Ряд(Знач Теги, Знач Опции = Неопределено) Экспорт

	Если Теги.Количество() = 0 Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Разложенные = Разложить(Теги, Предел(Опции));
	Подсказки = ПодсказкиКаналов(Опции);

	Каналы = Кит.Ряд("свёрнутые").Подпись(Модели.Текст(Опции, "Заголовок"));
	Для Каждого Тег Из Разложенные.Видимые Цикл
		Каналы.Добавить(Канал(Тег, ОпцииТега(Тег, Подсказки)));
	КонецЦикла;
	Каналы.Добавить(Хвост(Разложенные.Скрытые, Подсказки));

	Возврат Каналы;

КонецФункции

// Двухколоночная студия тега: слева поля, справа живое превью плашки. Признаки на ней —
// имена полей, по которым скрипт перерисовывает превью: их знает сервер, и второй копии
// имён в статике быть не должно.
//
// Возвращаемое значение:
//  ЭлементЭкрана - холст студии; поля и превью кладут внутрь.
//
Функция Студия() Экспорт

	Возврат Кит.Область("студия")
		.Признак("chip", "")
		.Признак("chip-name", "имя")
		.Признак("chip-style", "стиль")
		.Признак("chip-icon", "значок")
		.Признак("chip-sample", Тексты.Текст("settings.package.tag-new.preview.sample"));

КонецФункции

// Правая колонка студии. Плашка собрана из тех же родов и тех же иконок кита, что и плашка
// у версии, но с крючками прогрессивного улучшения: подпись отдельным узлом, а ВСЕ
// допустимые глифы напечатаны сразу и скрыты, кроме выбранного. Синтезировать svg кита
// в браузере нечем, поэтому скрипт лишь переставляет ту же пометку, что ставит сервер.
//
// Параметры:
//  Конструктор - Структура - состояние конструктора тега.
//
// Возвращаемое значение:
//  ЭлементЭкрана - колонка образца.
//
Функция Предпросмотр(Знач Конструктор) Экспорт

	Результат = Кит.Область("образец");
	Результат.Добавить(Кит.Надпись("приглушённая"))
		.Добавить(Кит.Текст(Тексты.Текст("settings.package.tag-new.preview.chip")));

	Результат.Добавить(Кит.Надпись().Признак("chip-target", ""))
		.Добавить(Образец(Конструктор));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область РядКаналов

// Основной канал стоит первым и предел не расходует: с него начинается ответ на вопрос
// «что приедет по opm install <пакет>».
Функция Разложить(Знач Теги, Знач Предел)

	Видимые = Новый Массив();
	Прочие = Новый Массив();
	Для Каждого Тег Из Теги Цикл
		Если Тег.ПоУмолчанию = Истина Тогда
			Видимые.Добавить(Тег);
		Иначе
			Прочие.Добавить(Тег);
		КонецЕсли;
	КонецЦикла;

	Скрытые = Новый Массив();
	Остаток = Предел;
	Для Каждого Тег Из Прочие Цикл
		Если Остаток > 0 Тогда
			Видимые.Добавить(Тег);
			Остаток = Остаток - 1;
		Иначе
			Скрытые.Добавить(Тег);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Видимые, Скрытые", Видимые, Скрытые);

КонецФункции

// Остаток ряда живёт в раскрывашке: свёрнутая строка считает спрятанное, развёрнутая
// отдаёт сами плашки. Прятать нечего — раскрывашки нет вовсе.
Функция Хвост(Знач Скрытые, Знач Подсказки)

	Если Скрытые.Количество() = 0 Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Остаток = Кит.Раскрывашка("хвост");
	Остаток.Шапка().Добавить(Кит.Текст(Тексты.Шаблон("package.tags.more",
		Формат(Скрытые.Количество(), "ЧН=0; ЧГ=0"))));
	Для Каждого Тег Из Скрытые Цикл
		Остаток.Добавить(Канал(Тег, ОпцииТега(Тег, Подсказки)));
	КонецЦикла;
	Возврат Остаток;

КонецФункции

Функция ОпцииТега(Знач Тег, Знач Подсказки)
	Возврат Новый Структура("Подсказка", Подсказки.Получить(Строка(Тег.Имя)));
КонецФункции

Функция ПодсказкиКаналов(Знач Опции)
	Значение = Модели.Значение(Опции, "Подсказки");
	Возврат ?(ТипЗнч(Значение) = Тип("Соответствие"), Значение, Новый Соответствие());
КонецФункции

Функция Предел(Знач Опции)

	Значение = Модели.Значение(Опции, "Предел");
	Если Значение = Неопределено Тогда
		Возврат 3;
	КонецЕсли;

	Попытка
		Возврат Макс(0, Цел(Число(Значение)));
	Исключение
		Возврат 3;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пометка отбита от плашки пробелом: «по умолчанию» — свойство канала, а не часть
// имени тега, и внутрь плашки она не входит. Пометка — ЗНАЧОК: слова растягивали строку
// таблицы и ряд каналов у версии. Подпись значка остаётся: браузер печатает её подсказкой,
// скринридер читает её словами.
Функция ПометкаОсновного(Знач Тег)

	Если Тег.ПоУмолчанию <> Истина Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Пометка = Кит.Холст();
	Пометка.Добавить(Кит.Текст(" "));
	Пометка.Добавить(Кит.Надпись("приглушённая"))
		.Добавить(Кит.Иконка(Новый Структура("Имя, Подпись",
			"закладка", Тексты.Текст("package.tags.default"))));
	Возврат Пометка;

КонецФункции

// Все глифы печатаются сразу и прячутся, кроме выбранного: скрипт лишь переставляет
// пометку, а рисует их сервер.
Функция Образец(Знач Конструктор)

	Результат = Кит.Плашка(Новый Структура("Вид", Оформление.ВидПлашки(Конструктор.Стиль)));

	Для Каждого Ключ Из Значки.Все() Цикл
		Глиф = Результат.Добавить(Кит.Надпись().Признак("chip-glyph", Ключ));
		Если Ключ <> Конструктор.Значок Тогда
			Глиф.Скрыть();
		КонецЕсли;
		Глиф.Добавить(Кит.Иконка(Оформление.ИмяИконки(Ключ)));
	КонецЦикла;

	Результат.Добавить(Кит.Надпись().Признак("chip-caption", ""))
		.Добавить(Кит.Текст(ОбразецИмени(Конструктор)));
	Возврат Результат;

КонецФункции

Функция ОбразецИмени(Знач Конструктор)
	Возврат ?(ЗначениеЗаполнено(Конструктор.Имя), Конструктор.Имя,
		Тексты.Текст("settings.package.tag-new.preview.sample"));
КонецФункции

Процедура ПроверитьИмя(Знач Тег)

	Если ЗначениеЗаполнено(Тег.Имя) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение "Плашка тега: у тега не задано Имя — рядом с версией появилась бы"
		+ " безымянная плашка, по которой канал не опознать.";

КонецПроцедуры

#КонецОбласти

&Прозвище("ПлашкаТега")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОформлениеТега") _Оформление,
	&Пластилин(Значение = "ЗначокТега") _Значки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ЧтениеМодели") _Модели) Экспорт

	Кит = _Кит;
	Оформление = _Оформление;
	Значки = _Значки;
	Тексты = _Тексты;
	Модели = _Модели;

КонецПроцедуры
