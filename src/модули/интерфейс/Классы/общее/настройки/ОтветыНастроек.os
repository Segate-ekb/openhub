// Ответы домов настроек и приватных страниц: страница дома, отказы 403/404/405, уведомления.

Перем Каркас;           // КаркасСтраницы (кит) — корень страницы
Перем Кит;              // Кит (кит) — тело страниц отказа
Перем СборкаДома;       // СборкаДомаНастроек — дом узлом кита из модели дома
Перем СервисПрав;       // СервисПрав (права) — показывать ли вход в настройки хаба
Перем Тексты;           // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем HTTP;        // МетодыHTTP (основа) — сравнение метода запроса
Перем Заголовки;   // ЗаголовкиКэша (основа) — приватная страница не остаётся у чужой стороны
Перем Принципалы;  // ПринципалСтраницы — учётка и сессия из принципала двери

// Отдаёт страницу дома настроек. Разделы дома каркас берёт у дома сам колонкой на широком
// экране и первой группой единого меню — под общим именем дома (ГруппаМеню). Вкладку
// браузера дом называет сам — «Раздел · Заголовок · Объект»: подпись текущего раздела
// и заголовок дома с объектом; у дома без текущего раздела — «Заголовок · Объект».
//
// Параметры:
//  Ответ - ОтветСервера.
//  Модель - Структура - модель дома (см. МодельДома).
//  Принципал - Структура, Неопределено - принципал запроса с полями Пользователь (учётка и меню
//              в шапке) и Сессия (токен «Выйти»): вердикт гварда или контекст пульта; гость — Неопределено.
//  КукиЗапроса - Куки - куки запроса (оформление достаёт рендерер сам).
//  Статус - Число - код ответа: 200 по умолчанию, 400 — когда страница перерисована
//           из-за непринятого ввода (необязательный, по умолчанию 200).
//  Путь - Строка - адрес текущей страницы для подсветки в меню; пусто — адрес текущего
//         раздела дома (необязательный, по умолчанию "").
//  Дела - Структура, Неопределено - снимок дел вошедшего (СводкаДелВошедшего.Снять), уже снятый
//         для содержимого: шапка берёт числа меню из него, а не считает их второй раз
//         (необязательный, по умолчанию Неопределено — шапка считает сама).
//
Процедура ОтдатьДом(Ответ, Знач Модель, Знач Принципал, Знач КукиЗапроса,
	Знач Статус = 200, Знач Путь = "", Знач Дела = Неопределено) Экспорт

	Дом = СборкаДома.Дом(Модель, Путь);
	Подсветка = ?(ЗначениеЗаполнено(Путь), Путь, СборкаДома.АдресТекущегоРаздела(Дом));
	ОтдатьВКаркас(Ответ, ИмяВкладки(Модель, Дом), Дом,
		Контекст(Принципал, КукиЗапроса, Подсветка, Дела), Статус, ГруппаМеню(Модель, Дом));

КонецПроцедуры

// Группа разделов дома в шторке единого меню подписана общим именем дома (ЗаголовокМеню
// модели — Дом.Заголовок()), а не заголовком страницы: контроллер аккаунта вписывает
// в заголовок логин («Аккаунт · root»), а логин в шторке уже стоит блоком учётки. Разделы
// и рубрики каркас берёт у узла дома — те же, что в колонке (рубрику объекта дом снял
// там сам, см. СборкаДомаНастроек.РазделыДома).
Функция ГруппаМеню(Знач Модель, Знач Дом)

	Заголовок = ПолеСтруктуры(Модель, "ЗаголовокМеню");
	Если НЕ ЗначениеЗаполнено(Заголовок) Тогда
		Заголовок = Кит.ЗаголовокДома(Дом);
	КонецЕсли;
	Возврат Новый Структура("Заголовок, Разделы", Заголовок, Неопределено);

КонецФункции

// «Раздел · Заголовок · Объект»: две вкладки разных разделов и объектов различимы.
Функция ИмяВкладки(Знач Модель, Знач Дом)

	ИмяДома = СоединитьИмена(ПолеСтруктуры(Модель, "Заголовок"), ПолеСтруктуры(Модель, "Объект"));
	Возврат СоединитьИмена(СборкаДома.ПодписьТекущегоРаздела(Дом), ИмяДома);

КонецФункции

// Модель страницы без разделов собирают руками — поля может не быть.
Функция ПолеСтруктуры(Знач Модель, Знач Имя)

	Значение = "";
	Модель.Свойство(Имя, Значение);
	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции

Функция СоединитьИмена(Знач Первое, Знач Второе)

	Если НЕ ЗначениеЗаполнено(Первое) Тогда
		Возврат Второе;
	ИначеЕсли НЕ ЗначениеЗаполнено(Второе) Тогда
		Возврат Первое;
	КонецЕсли;
	Возврат Тексты.Шаблон("settings.house.tab", Первое, Второе);

КонецФункции

// Модель дома настроек: шапку дом знает о себе сам, остальное приносит раздел.
//
// Параметры:
//  Дом - Произвольный - дом настроек: Ключ, Заголовок, Пояснение и Объект — объект, один на все
//        разделы дома (инсталляция у дома «Хаб»), либо "" — объект называет раздел.
//  Объект - Строка - имя настраиваемого объекта в шапке; "" — дом без объекта. У дома,
//           который знает свой объект сам, не используется.
//  Разделы - Структура - разделы дома и текущий из них (СборкаДомаНастроек.РазделыДома).
//  Уведомления - Массив - тосты страницы.
//  Секции - Массив - секции показываемого раздела: узлы Кит.Секция.
//  Токен - Строка - CSRF-токен сессии: его берут формы, окна и подтверждения внутри дома
//          (необязательный, по умолчанию "" — дом без форм; форма в доме без токена
//          останавливает сборку с причиной).
//  Хлебные - Массив - путь к разделу: Подпись и Адрес, у последней — только Подпись;
//            Неопределено — дом без крошек (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - модель дома для ОтдатьДом.
//
Функция МодельДома(Знач Дом, Знач Объект, Знач Разделы, Знач Уведомления, Знач Секции, Знач Токен = "",
	Знач Хлебные = Неопределено) Экспорт

	Модель = Новый Структура();
	Модель.Вставить("Ключ", Дом.Ключ());
	Модель.Вставить("Заголовок", Дом.Заголовок());
	Модель.Вставить("ЗаголовокМеню", Дом.Заголовок());
	Модель.Вставить("Объект", ОбъектДома(Дом, Объект));
	Модель.Вставить("Пояснение", Дом.Пояснение());
	Модель.Вставить("Разделы", Разделы);
	Модель.Вставить("Уведомления", Уведомления);
	Модель.Вставить("Хлебные", ?(Хлебные = Неопределено, Новый Массив(), Хлебные));
	Модель.Вставить("Секции", Секции);
	Модель.Вставить("Токен", Токен);
	Возврат Модель;

КонецФункции

// Объект один у всех разделов дома, когда его знает сам дом: иначе шапка и вкладка «моргали» бы
// между разделами, чьи контроллеры назвали объект по-разному.
Функция ОбъектДома(Знач Дом, Знач Объект)

	Свой = Дом.Объект();
	Возврат ?(ЗначениеЗаполнено(Свой), Свой, Объект);

КонецФункции

// Отдаёт произвольную страницу приватной части.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Заголовок - Строка - заголовок страницы.
//  Контент - Строка - готовая разметка страницы.
//  Принципал - Структура, Неопределено - принципал запроса с полями Пользователь (учётка и меню
//              в шапке) и Сессия (токен «Выйти»): вердикт гварда или контекст пульта; гость — Неопределено.
//  КукиЗапроса - Куки - куки запроса.
//  Статус - Число - код состояния HTTP (необязательный, по умолчанию 200).
//  РазделыЭкрана - Массив, Неопределено - разделы текущего экрана для единого меню;
//                  Неопределено — у страницы своих разделов нет (необязательный,
//                  по умолчанию Неопределено).
//  Путь - Строка - адрес текущей страницы: по нему меню подсвечивает дорогу, на него
//         возвращает смена темы (необязательный, по умолчанию "" — не подсвечивать,
//         смена темы возвращает на главную).
//
Процедура ОтдатьСтраницу(Ответ, Знач Заголовок, Знач Контент, Знач Принципал, Знач КукиЗапроса,
	Знач Статус = 200, Знач РазделыЭкрана = Неопределено, Знач Путь = "") Экспорт
	ОтдатьВКаркас(Ответ, Заголовок, Контент, Контекст(Принципал, КукиЗапроса, Путь), Статус,
		РазделыЭкрана);
КонецПроцедуры

Процедура ОтдатьВКаркас(Ответ, Знач Заголовок, Знач Контент, Знач Контекст, Знач Статус,
	Знач РазделыЭкрана)
	Заголовки.ЗакрытьСтраницу(Ответ);
	Ответ.УстановитьСостояние(Статус);
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Заголовок, Контент, Контекст, РазделыЭкрана);
КонецПроцедуры

// 403: доступ есть к разделу, но не к действию (CSRF, чужой объект).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Принципал - Структура, Неопределено - принципал запроса с полями Пользователь (учётка и меню
//              в шапке) и Сессия (токен «Выйти»): вердикт гварда или контекст пульта; гость — Неопределено.
//  Сообщение - Строка - текст сообщения.
//  КукиЗапроса - Куки - куки запроса.
//
Процедура ОтдатьЗапрещено(Ответ, Знач Принципал, Знач Сообщение, Знач КукиЗапроса) Экспорт
	Заголовки.ЗакрытьСтраницу(Ответ);
	Ответ.УстановитьСостояние(403);
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Тексты.Текст("settings.reply.forbidden.title"),
		Кит.СтраницаОшибки(Новый Структура("Код, Сообщение", 403, Сообщение)),
		Контекст(Принципал, КукиЗапроса));
КонецПроцедуры

// 404: объекта нет ЛИБО его существование не раскрывается (приватный чужой пул).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Принципал - Структура, Неопределено - принципал запроса с полями Пользователь (учётка и меню
//              в шапке) и Сессия (токен «Выйти»): вердикт гварда или контекст пульта; гость — Неопределено.
//  Сообщение - Строка - текст сообщения.
//  КукиЗапроса - Куки - куки запроса.
//  Назад - Структура, Неопределено - ссылка «куда вернуться»: Адрес и Подпись; Неопределено — страница отказа без ссылки (необязательный, по умолчанию Неопределено).
//
Процедура ОтдатьНеНайдено(Ответ, Знач Принципал, Знач Сообщение, Знач КукиЗапроса,
	Знач Назад = Неопределено) Экспорт
	Заголовки.ЗакрытьСтраницу(Ответ);
	Ответ.УстановитьСостояниеНеНайдено();
	Ответ.УстановитьТипКонтента("html");
	Тело = Кит.Холст();
	Тело.Добавить(Кит.СтраницаОшибки(Новый Структура("Код, Сообщение", 404, Сообщение)));
	Тело.Добавить(СсылкаНазад(Назад));

	Ответ.ТелоТекст = Каркас.Страница(Тексты.Текст("settings.reply.notfound.title"),
		Тело, Контекст(Принципал, КукиЗапроса));
КонецПроцедуры

// Условие внутри сборщика: на вызове ссылка добавляется без «Если».
Функция СсылкаНазад(Знач Назад)

	Если ТипЗнч(Назад) <> Тип("Структура") Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Ссылка(Назад.Адрес).Добавить(Кит.Текст(Назад.Подпись)).Родитель();

КонецФункции

// 405: winow не различает метод — маршрут один, метод разбирает контроллер.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Разрешённые - Строка - разрешённые методы для заголовка Allow.
//  Принципал - Структура, Неопределено - принципал запроса с полями Пользователь (учётка и меню
//              в шапке) и Сессия (токен «Выйти»): вердикт гварда или контекст пульта; гость — Неопределено.
//  КукиЗапроса - Куки - куки запроса.
//
Процедура ОтдатьМетодНеРазрешён(Ответ, Знач Разрешённые, Знач Принципал, Знач КукиЗапроса) Экспорт
	Заголовки.ЗакрытьСтраницу(Ответ);
	Ответ.Заголовки["Allow"] = Разрешённые;
	Ответ.УстановитьСостояние(405);
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Тексты.Текст("settings.reply.method.title"),
		Кит.СтраницаОшибки(Новый Структура("Код, Сообщение",
			405, Тексты.Шаблон("settings.reply.method.body", Разрешённые))),
		Контекст(Принципал, КукиЗапроса));
КонецПроцедуры

// 403 на неверном CSRF-токене — одним методом на все контроллеры кабинета.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Принципал - Структура, Неопределено - принципал запроса с полями Пользователь (учётка и меню
//              в шапке) и Сессия (токен «Выйти»): вердикт гварда или контекст пульта; гость — Неопределено.
//  КукиЗапроса - Куки - куки запроса.
//  Сообщение - Строка - своя формулировка отказа (необязательный, по умолчанию ""
//              — общий текст про неверный токен).
//
Процедура ОтдатьНеверныйCSRF(Ответ, Знач Принципал, Знач КукиЗапроса, Знач Сообщение = "") Экспорт
	ОтдатьЗапрещено(Ответ, Принципал,
		?(ЗначениеЗаполнено(Сообщение), Сообщение, Тексты.Текст("settings.reply.csrf.invalid")),
		КукиЗапроса);
КонецПроцедуры

// Совпадает ли метод запроса с ожидаемым — делегат МетодыHTTP.
//
// Параметры:
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  Ожидаемый - Строка - ожидаемый метод запроса.
//
// Возвращаемое значение:
//  Булево - совпадает ли метод запроса с ожидаемым.
//
Функция ЭтоМетод(Знач МетодЗапроса, Знач Ожидаемый) Экспорт
	Возврат HTTP.ЭтоМетод(МетодЗапроса, Ожидаемый);
КонецФункции

// Стандартный набор уведомлений раздела: «сохранено», предупреждение и/или текст ошибки.
//
// Параметры:
//  Сохранено - Булево - показать «Изменения сохранены».
//  Ошибка - Строка - текст ошибки (пусто — не показывать).
//  Предупреждение - Строка - текст предупреждения: действие удалось, но человеку есть что
//                   знать (необязательный, по умолчанию "" — не показывать).
//
// Возвращаемое значение:
//  Массив - уведомления для модели дома.
//
Функция УведомленияРаздела(Знач Сохранено, Знач Ошибка, Знач Предупреждение = "") Экспорт

	Результат = Новый Массив();
	Если Сохранено Тогда
		Результат.Добавить(Уведомление(Тексты.Текст("settings.reply.saved"), "ok"));
	КонецЕсли;
	// предупреждение — не отказ: работа сделана, но человеку есть что знать
	Если ЗначениеЗаполнено(Предупреждение) Тогда
		Результат.Добавить(Уведомление(Предупреждение, "warn"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Результат.Добавить(Уведомление(Ошибка, "err"));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Уведомление для модели дома.
//
// Параметры:
//  Текст - Строка - текст уведомления.
//  Вид - Строка - "ok" | "warn" | "err" (необязательный, по умолчанию "ok").
//
// Возвращаемое значение:
//  Структура - уведомление для модели дома.
//
Функция Уведомление(Знач Текст, Знач Вид = "ok") Экспорт
	Возврат Новый Структура("Текст, Вид", Текст, Вид);
КонецФункции

// Над содержимым встаёт навигация кабинета, а её состав зависит от того, админ ли смотрит;
// сессию гвард уже прочитал — меню берёт токен «Выйти» у неё; снимок дел едет обрамлению
// отдельным ключом.
Функция Контекст(Знач Принципал, Знач КукиЗапроса, Знач Путь = "", Знач Дела = Неопределено)

	Пользователь = Принципалы.Пользователь(Принципал);
	Результат = Каркас.КонтекстСтраницы(Пользователь, КукиЗапроса, Админ(Пользователь), Истина, Путь,
		Принципалы.Сессия(Принципал));
	Если Дела <> Неопределено Тогда
		Результат.Вставить("СводкаДел", Дела);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция Админ(Знач Пользователь)
	Возврат ?(Пользователь = Неопределено, Ложь, СервисПрав.ПользовательАдмин(Пользователь));
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СборкаДомаНастроек") _СборкаДома,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "ЗаголовкиКэша") _Заголовки,
	&Пластилин(Значение = "ПринципалСтраницы") _Принципалы = Неопределено) Экспорт

	HTTP = _HTTP;
	Заголовки = _Заголовки;

	Каркас = _Каркас;
	Кит = _Кит;
	СборкаДома = _СборкаДома;
	СервисПрав = _СервисПрав;
	Тексты = _Тексты;
	Принципалы = ?(_Принципалы = Неопределено, Новый ПринципалСтраницы(), _Принципалы);

КонецПроцедуры
