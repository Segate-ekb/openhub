// Исход формы окна раздела: одна форма на все пульты окон — удача, отказ над разделом, отказ
// в открытом окне на набранном и вопрос подтверждения по адресу.

Перем Окна; // ОкноРаздела — состояние окна, в которое возвращается отбитая форма

#Область ПубличныйИнтерфейс

// Удача: форма принята, ответ — 303 на раздел.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число — статус ответа), Сообщение (Строка — причина отказа
//              словами; "" — отказа нет), Отказы (Соответствие — имя поля -> отказ под полем),
//              ВидОкна (Строка — окно, в которое ведёт вопрос либо вернулась форма; "" — окна нет),
//              Ключ (Строка — ключ записи этого окна), Спросить (Булево — форма пришла без
//              подтверждения: ответ ведёт на окно ВидОкна-Ключ по адресу), Окно (Структура,
//              Неопределено — состояние окна, открытого на отбитой форме, см. ОкноРаздела.Отбитое;
//              Неопределено — отказ показывается над разделом).
//
Функция Удача() Экспорт
	Возврат Исход(Истина, 303, "");
КонецФункции

// Отказ над разделом: окна для него нет (форма старой вкладки, право, записи уже нет).
//
// Параметры:
//  Сообщение - Строка - причина отказа словами.
//  Код - Число - статус ответа (необязательный, по умолчанию 400).
//
// Возвращаемое значение:
//  Структура - см. Удача.
//
Функция Отбито(Знач Сообщение, Знач Код = 400) Экспорт
	Возврат Исход(Ложь, Код, Сообщение);
КонецФункции

// Отказ под одним полем; сообщение — тот же текст.
//
// Параметры:
//  Имя - Строка - имя поля формы.
//  Текст - Строка - текст отказа под полем.
//  Код - Число - статус ответа (необязательный, по умолчанию 400).
//
// Возвращаемое значение:
//  Структура - см. Удача.
//
Функция ОтбитоПолем(Знач Имя, Знач Текст, Знач Код = 400) Экспорт
	Отказы = Новый Соответствие();
	Отказы.Вставить(Имя, Текст);
	Возврат ОтбитоПолями(Отказы, Код);
КонецФункции

// Отказ под несколькими полями; сообщение — первый отказ: он назван, даже если окна для него не будет.
//
// Параметры:
//  Отказы - Соответствие - имя поля -> текст отказа под полем.
//  Код - Число - статус ответа (необязательный, по умолчанию 400).
//
// Возвращаемое значение:
//  Структура - см. Удача.
//
Функция ОтбитоПолями(Знач Отказы, Знач Код = 400) Экспорт

	Результат = Отбито("", Код);
	Для Каждого Отказ Из Отказы Цикл
		Если НЕ ЗначениеЗаполнено(Результат.Сообщение) Тогда
			Результат.Сообщение = Строка(Отказ.Значение);
		КонецЕсли;
		Результат.Отказы.Вставить(Отказ.Ключ, Отказ.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Вопрос: опасная форма пришла без подтверждения (без скрипта она уходит сразу) — ничего не
// изменено, ответ ведёт на окно подтверждения по адресу.
//
// Параметры:
//  Вид - Строка - вид окна подтверждения.
//  Ключ - Строка - ключ записи (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - см. Удача.
//
Функция Спросить(Знач Вид, Знач Ключ = "") Экспорт
	Результат = Исход(Ложь, 303, "");
	Результат.Спросить = Истина;
	Результат.ВидОкна = Строка(Вид);
	Результат.Ключ = Строка(Ключ);
	Возврат Результат;
КонецФункции

// Отказ, который возвращается в окно своей формы: окно печатается открытым на набранном,
// с отказами под полями; причина без поля — в самом окне, отказ у поля второй раз не повторяется.
//
// Параметры:
//  Отказ - Структура - отказ (см. Отбито, ОтбитоПолем, ОтбитоПолями).
//  Вид - Строка - вид окна.
//  Ключ - Строка - ключ записи окна.
//  Набранное - Соответствие, Неопределено - чем заполнить поля окна: присланная форма либо
//              подставленное пультом.
//
// Возвращаемое значение:
//  Структура - тот же отказ с окном (см. Удача).
//
Функция ВОкне(Знач Отказ, Знач Вид, Знач Ключ, Знач Набранное) Экспорт

	Отказ.ВидОкна = Строка(Вид);
	Отказ.Ключ = Строка(Ключ);
	Отказ.Окно = Окна.Отбитое(Вид, Ключ, Набранное, Отказ.Отказы,
		?(Отказ.Отказы.Количество() > 0, "", Отказ.Сообщение));
	Возврат Отказ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Исход(Знач Успех, Знач Код, Знач Сообщение)
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы, ВидОкна, Ключ, Спросить, Окно",
		Успех, Код, Сообщение, Новый Соответствие(), "", "", Ложь, Неопределено);
КонецФункции

#КонецОбласти

&Прозвище("ИсходОкна")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ОкноРаздела") _Окна) Экспорт
	Окна = _Окна;
КонецПроцедуры
