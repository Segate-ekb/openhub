// Дом настроек узлом кита из модели дома (ОтветыНастроек.МодельДома): разделы — словами дома
// по перечню разделов, секции витрины — узлы Кит.Секция.

Перем Кит;      // Кит (кит) — узлы дома, разделов и секций
Перем Модели;   // ЧтениеМодели (кит) — мягкое чтение модели: нет поля — пусто

#Область ПереченьРазделов

// Пустой перечень разделов дома: дом объявляет в нём свои разделы по порядку колонки
// и отвечает по нему, есть ли раздел и как он подписан.
//
// Возвращаемое значение:
//  ТаблицаЗначений - строки разделов: Ключ, Подпись, Иконка, Рубрика, Опасный, СвойАдрес.
//
Функция ПереченьРазделов() Экспорт

	Перечень = Новый ТаблицаЗначений();
	Для Каждого Колонка Из Новый Структура("Ключ, Подпись, Иконка, Рубрика, Опасный, СвойАдрес") Цикл
		Перечень.Колонки.Добавить(Колонка.Ключ);
	КонецЦикла;
	Возврат Перечень;

КонецФункции

// Раздел перечня по ключу.
//
// Параметры:
//  Перечень - ТаблицаЗначений - перечень разделов дома (см. ПереченьРазделов).
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений, Неопределено - строка раздела; Неопределено — такого раздела нет.
//
Функция РазделПеречня(Знач Перечень, Знач Ключ) Экспорт

	Для Каждого Запись Из Перечень Цикл
		Если Запись.Ключ = Ключ Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Раздел в перечне дома: встаёт в колонку следом за объявленными раньше.
//
// Параметры:
//  Перечень - ТаблицаЗначений - перечень разделов дома (см. ПереченьРазделов).
//  Ключ - Строка - сегмент адреса раздела под адресом дома ("tokens").
//  Подпись - Строка - название раздела.
//  Иконка - Строка - имя иконки кита.
//  Рубрика - Строка - подпись группы разделов над ним (необязательный, по умолчанию "" — без рубрики).
//  СвойАдрес - Строка - адрес раздела, живущего вне адреса дома (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений - строка раздела.
//
Функция Раздел(Перечень, Знач Ключ, Знач Подпись, Знач Иконка, Знач Рубрика = "",
	Знач СвойАдрес = "") Экспорт

	Запись = Перечень.Добавить();
	Запись.Ключ = Ключ;
	Запись.Подпись = Подпись;
	Запись.Иконка = Иконка;
	Запись.Рубрика = Рубрика;
	Запись.Опасный = Ложь;
	Запись.СвойАдрес = СвойАдрес;
	Возврат Запись;

КонецФункции

// Раздел необратимого (удаление, передача): в колонке он последний, без рубрики и цветом ошибки.
//
// Параметры:
//  Перечень - ТаблицаЗначений - перечень разделов дома (см. ПереченьРазделов).
//  Ключ - Строка - сегмент адреса раздела под адресом дома.
//  Подпись - Строка - название раздела.
//  Иконка - Строка - имя иконки кита.
//
// Возвращаемое значение:
//  СтрокаТаблицыЗначений - строка раздела.
//
Функция ОпасныйРаздел(Перечень, Знач Ключ, Знач Подпись, Знач Иконка) Экспорт

	Запись = Раздел(Перечень, Ключ, Подпись, Иконка);
	Запись.Опасный = Истина;
	Возврат Запись;

КонецФункции

// Разделы дома для модели: что показать колонкой и что в ней текущее.
//
// Параметры:
//  Адрес - Строка - адрес дома: под ним живут разделы перечня.
//  Перечень - ТаблицаЗначений - перечень разделов (см. ПереченьРазделов).
//  Текущий - Строка - ключ открытого раздела; ключа нет в перечне — текущего нет.
//  РубрикаОбъекта - Строка - рубрика, которая называет сам объект дома («Аккаунт» у «Настроек
//                   аккаунта»): её разделы встают без рубрики — и в колонке, и в шторке, иначе
//                   под заголовком дома имя объекта шло бы второй строкой (необязательный,
//                   по умолчанию "" — все рубрики печатаются).
//
// Возвращаемое значение:
//  Структура - Адрес, Перечень, Текущий, РубрикаОбъекта.
//
Функция РазделыДома(Знач Адрес, Знач Перечень, Знач Текущий, Знач РубрикаОбъекта = "") Экспорт
	Возврат Новый Структура("Адрес, Перечень, Текущий, РубрикаОбъекта", Адрес, Перечень, Текущий, РубрикаОбъекта);
КонецФункции

#КонецОбласти

#Область Дом

// Узел дома настроек по модели дома.
//
// Параметры:
//  Модель - Структура - модель дома: Ключ, Заголовок, Объект, Пояснение, Разделы (см. РазделыДома),
//           Уведомления, Хлебные, Секции, Токен (см. ОтветыНастроек.МодельДома); недостающее
//           поле — пусто.
//  Адрес - Строка - адрес страницы дома у модели без разделов: на него уходит форма
//          с относительным адресом.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.ДомНастроек.
//
Функция Дом(Знач Модель, Знач Адрес) Экспорт

	Разделы = Модели.Значение(Модель, "Разделы");
	ЕстьРазделы = ТипЗнч(Разделы) = Тип("Структура");

	Дом = Кит.ДомНастроек(Модели.Текст(Модель, "Заголовок"), ?(ЕстьРазделы, Разделы.Адрес, Адрес),
			Модели.Текст(Модель, "Токен"))
		.Ключ(Модели.Текст(Модель, "Ключ"))
		.Объект(Модели.Текст(Модель, "Объект"))
		.Пояснение(Модели.Текст(Модель, "Пояснение"));

	Для Каждого Крошка Из Модели.Список(Модель, "Хлебные") Цикл
		Дом.Крошка(Модели.Текст(Крошка, "Подпись"), Модели.Текст(Крошка, "Адрес"));
	КонецЦикла;

	Для Каждого Уведомление Из Модели.Список(Модель, "Уведомления") Цикл
		Дом.Уведомление(Кит.Уведомление(Уведомление));
	КонецЦикла;

	Если ЕстьРазделы Тогда
		ОбъявитьРазделы(Дом, Разделы);
	КонецЕсли;

	Для Каждого Секция Из Модели.Список(Модель, "Секции") Цикл
		Дом.Добавить(УзелСекции(Секция));
	КонецЦикла;

	Возврат Дом;

КонецФункции

// Адрес открытого раздела дома — по нему меню подсвечивает дорогу.
//
// Параметры:
//  Дом - ЭлементЭкрана - узел дома (см. Дом).
//
// Возвращаемое значение:
//  Строка - адрес текущего раздела; у дома без текущего раздела — "".
//
Функция АдресТекущегоРаздела(Знач Дом) Экспорт

	Для Каждого Раздел Из Кит.РазделыДома(Дом) Цикл
		Если Раздел.Активен = Истина Тогда
			Возврат Раздел.Адрес;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Подпись открытого раздела дома — ею вкладка браузера называет раздел.
//
// Параметры:
//  Дом - ЭлементЭкрана - узел дома (см. Дом).
//
// Возвращаемое значение:
//  Строка - подпись текущего раздела; у дома без текущего раздела — "".
//
Функция ПодписьТекущегоРаздела(Знач Дом) Экспорт

	Для Каждого Раздел Из Кит.РазделыДома(Дом) Цикл
		Если Раздел.Активен = Истина Тогда
			Возврат Раздел.Подпись;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Перечень словами дома: рубрика объявляется, когда сменилась; адрес раздела собирает кит.
// Разделы рубрики объекта встают без рубрики — и в колонке, и в шторке: под заголовком дома
// она повторила бы имя объекта.
Процедура ОбъявитьРазделы(Знач Дом, Знач Разделы)

	РубрикаОбъекта = Разделы.РубрикаОбъекта;
	Рубрика = "";
	Для Каждого Запись Из Разделы.Перечень Цикл

		Если Запись.Рубрика <> Рубрика И НЕ Запись.Опасный Тогда
			Рубрика = Запись.Рубрика;
			Дом.Рубрика(?(ЗначениеЗаполнено(РубрикаОбъекта) И Рубрика = РубрикаОбъекта, "", Рубрика));
		КонецЕсли;

		Пункт = Дом.Раздел(Запись.Подпись, ?(ЗначениеЗаполнено(Запись.СвойАдрес), Запись.СвойАдрес, Запись.Ключ),
			Запись.Иконка);
		Пункт.Опасный(Запись.Опасный);
		Если Запись.Ключ = Разделы.Текущий Тогда
			Пункт.Текущий();
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Секция витрины — только узел кита: другое на месте секции останавливает сборку с причиной,
// а не пропадает с экрана молча.
Функция УзелСекции(Знач Секция)

	Если ТипЗнч(Секция) = Тип("ЭлементЭкрана") Тогда
		Возврат Секция;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Дом настроек: секция витрины — «%1». Секция — узел Кит.Секция.",
		ТипЗнч(Секция));

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ЧтениеМодели") _Модели) Экспорт

	Кит = _Кит;
	Модели = _Модели;

КонецПроцедуры
