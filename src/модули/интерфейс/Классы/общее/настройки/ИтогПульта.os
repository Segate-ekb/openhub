// Итог операции пульта дома настроек: одна форма итога на все пульты.

#Область ПубличныйИнтерфейс

// Итог «операция не моя»: дом обрабатывает POST общим путём.
//
// Возвращаемое значение:
//  Структура - Перехвачено (Булево), Ошибка (Строка), Спросить (Произвольный),
//              Уведомление (Строка), Окно (Произвольный), Адрес (Строка), Статус (Число),
//              Заведение (Структура, Неопределено: состояние окна заведения, в которое
//              возвращается отбитая форма), Сохранено (Булево: показать плашку «изменения
//              сохранены»).
//
Функция Мимо() Экспорт
	Возврат Новый Структура("Перехвачено, Ошибка, Спросить, Уведомление, Окно, Адрес, Статус,"
			+ " Заведение, Сохранено",
		Ложь, "", Неопределено, "", Неопределено, "", 0, Неопределено, Ложь);
КонецФункции

// Итог перехваченной операции без отказа.
//
// Возвращаемое значение:
//  Структура - см. Мимо.
//
Функция Успех() Экспорт
	Итог = Мимо();
	Итог.Перехвачено = Истина;
	Возврат Итог;
КонецФункции

// Итог удавшейся мутации, после которой дом уводит редиректом: перезагрузка страницы
// не должна повторять её.
//
// Параметры:
//  Адрес - Строка - куда перенаправить.
//
// Возвращаемое значение:
//  Структура - см. Мимо.
//
Функция Переход(Знач Адрес) Экспорт
	Итог = Успех();
	Итог.Адрес = Адрес;
	Возврат Итог;
КонецФункции

// Итог «сначала спроси»: вопрос печатается на самой странице, потому что редирект
// потерял бы то, о чём спрашивают.
//
// Параметры:
//  Что - Произвольный - о чём спросить: имя снимаемого, решение по заявке либо готовая
//        модель окна подтверждения.
//
// Возвращаемое значение:
//  Структура - см. Мимо.
//
Функция Подтверждение(Знач Что) Экспорт
	Итог = Успех();
	Итог.Спросить = Что;
	Возврат Итог;
КонецФункции

// Отказ по вводу: 400 — форму есть что поправить.
//
// Параметры:
//  Сообщение - Строка - причина отказа человеку.
//
// Возвращаемое значение:
//  Структура - см. Мимо.
//
Функция Отказ(Знач Сообщение) Экспорт
	Итог = Успех();
	Итог.Ошибка = Сообщение;
	Возврат Итог;
КонецФункции

// Итог операции, которая либо прошла, либо отказала; пустой текст — операция удалась.
//
// Параметры:
//  Сообщение - Строка - причина отказа человеку; "" — отказа нет.
//
// Возвращаемое значение:
//  Структура - см. Мимо.
//
Функция ПоОтказу(Знач Сообщение) Экспорт
	Возврат ?(ЗначениеЗаполнено(Сообщение), Отказ(Сообщение), Успех());
КонецФункции

// Итог пульта в цепочке: свою операцию он заканчивает (с отказом или без), чужую
// пропускает дальше «мимо».
//
// Параметры:
//  Перехвачено - Булево - признал ли пульт операцию своей.
//  Сообщение - Строка - причина отказа человеку; "" — операция удалась.
//
// Возвращаемое значение:
//  Структура - см. Мимо.
//
Функция Перехват(Знач Перехвачено, Знач Сообщение) Экспорт
	Возврат ?(Перехвачено, ПоОтказу(Сообщение), Мимо());
КонецФункции

// Отказ по праву со своим кодом: править в форме нечего, поэтому не 400.
//
// Параметры:
//  Сообщение - Строка - причина отказа человеку.
//  Статус - Число - код ответа (необязательный, по умолчанию 403).
//
// Возвращаемое значение:
//  Структура - см. Мимо.
//
Функция Запрещено(Знач Сообщение, Знач Статус = 403) Экспорт
	Итог = Отказ(Сообщение);
	Итог.Статус = Статус;
	Возврат Итог;
КонецФункции

// Отказ формы заведения: страница возвращается с ОТКРЫТЫМ окном, набранным и помеченным
// полем.
//
// Параметры:
//  Сообщение  - Строка - причина отказа человеку.
//  Заполнение - Соответствие, Структура - что вернуть в поля формы.
//  Отказы     - Соответствие - ключ поля -> текст отказа; Неопределено — отказ не по полю.
//
// Возвращаемое значение:
//  Структура - см. Мимо.
//
Функция ОтказЗаведения(Знач Сообщение, Знач Заполнение, Знач Отказы = Неопределено) Экспорт

	Итог = Отказ(Сообщение);
	Итог.Заведение = ОкноЗаведения(Заполнение, Отказы);
	Возврат Итог;

КонецФункции

// Открытое окно заведения: страница печатает форму развёрнутой, с набранным
// и помеченным полем.
//
// Параметры:
//  Заполнение - Соответствие, Структура - что вернуть в поля формы; Неопределено — пусто.
//  Отказы     - Соответствие - ключ поля -> текст отказа; Неопределено — отказ не по полю.
//
// Возвращаемое значение:
//  Структура - Открыта (Булево), Заполнение, Отказы (Соответствие).
//
Функция ОкноЗаведения(Знач Заполнение = Неопределено, Знач Отказы = Неопределено) Экспорт
	Возврат Новый Структура("Открыта, Заполнение, Отказы", Истина, Заполнение,
		?(Отказы = Неопределено, Новый Соответствие(), Отказы));
КонецФункции

// Окно заведения, открытое параметром адреса «form=1»; любой другой признак оставляет
// страницу без окна.
//
// Параметры:
//  ПризнакФормы - Строка - значение параметра адреса.
//
// Возвращаемое значение:
//  Структура, Неопределено - см. ОкноЗаведения; Неопределено — окно закрыто.
//
Функция ОкноПоАдресу(Знач ПризнакФормы) Экспорт
	Возврат ?(Строка(ПризнакФормы) <> "1", Неопределено, ОкноЗаведения());
КонецФункции

#КонецОбласти

&Прозвище("ИтогПульта")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
