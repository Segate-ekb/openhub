// Итог операции пульта дома настроек: одна форма итога на разделы-значения и цепочку пультов дома;
// формы окон раздела отвечают исходом ИсходОкна.

#Область ПубличныйИнтерфейс

// Итог «операция не моя»: дом обрабатывает POST общим путём.
//
// Возвращаемое значение:
//  Структура - Перехвачено (Булево), Ошибка (Строка), Спросить (Произвольный),
//              Уведомление (Строка), Окно (Произвольный), Адрес (Строка), Статус (Число),
//              Сохранено (Булево: показать плашку «изменения сохранены»).
//
Функция Мимо() Экспорт
	Возврат Новый Структура("Перехвачено, Ошибка, Спросить, Уведомление, Окно, Адрес, Статус, Сохранено",
		Ложь, "", Неопределено, "", Неопределено, "", 0, Ложь);
КонецФункции

// Итог перехваченной операции без отказа.
//
// Возвращаемое значение:
//  Структура - см. Мимо.
//
Функция Успех() Экспорт
	Итог = Мимо();
	Итог.Перехвачено = Истина;
	Возврат Итог;
КонецФункции

// Итог удавшейся мутации, после которой дом уводит редиректом: перезагрузка страницы
// не должна повторять её.
//
// Параметры:
//  Адрес - Строка - куда перенаправить.
//
// Возвращаемое значение:
//  Структура - см. Мимо.
//
Функция Переход(Знач Адрес) Экспорт
	Итог = Успех();
	Итог.Адрес = Адрес;
	Возврат Итог;
КонецФункции

// Отказ по вводу: 400 — форму есть что поправить.
//
// Параметры:
//  Сообщение - Строка - причина отказа человеку.
//
// Возвращаемое значение:
//  Структура - см. Мимо.
//
Функция Отказ(Знач Сообщение) Экспорт
	Итог = Успех();
	Итог.Ошибка = Сообщение;
	Возврат Итог;
КонецФункции

// Итог операции, которая либо прошла, либо отказала; пустой текст — операция удалась.
//
// Параметры:
//  Сообщение - Строка - причина отказа человеку; "" — отказа нет.
//
// Возвращаемое значение:
//  Структура - см. Мимо.
//
Функция ПоОтказу(Знач Сообщение) Экспорт
	Возврат ?(ЗначениеЗаполнено(Сообщение), Отказ(Сообщение), Успех());
КонецФункции

// Итог пульта в цепочке: свою операцию он заканчивает (с отказом или без), чужую
// пропускает дальше «мимо».
//
// Параметры:
//  Перехвачено - Булево - признал ли пульт операцию своей.
//  Сообщение - Строка - причина отказа человеку; "" — операция удалась.
//
// Возвращаемое значение:
//  Структура - см. Мимо.
//
Функция Перехват(Знач Перехвачено, Знач Сообщение) Экспорт
	Возврат ?(Перехвачено, ПоОтказу(Сообщение), Мимо());
КонецФункции

// Отказ по праву со своим кодом: править в форме нечего, поэтому не 400.
//
// Параметры:
//  Сообщение - Строка - причина отказа человеку.
//  Статус - Число - код ответа (необязательный, по умолчанию 403).
//
// Возвращаемое значение:
//  Структура - см. Мимо.
//
Функция Запрещено(Знач Сообщение, Знач Статус = 403) Экспорт
	Итог = Отказ(Сообщение);
	Итог.Статус = Статус;
	Возврат Итог;
КонецФункции

#КонецОбласти

&Прозвище("ИтогПульта")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
