// Окно раздела настроек по адресу: параметр ?окно=<вид>-<ключ> называет окно, которое страница
// печатает открытым, состояние окна несёт набранное и отказы отбитой формы, ответы форм окон —
// перенаправления 303 на раздел.

Перем Ссылки;        // ПараметрыСсылки (основа) — параметр запроса на адресе
Перем Отметка;       // ОтметкаСохранения — «сохранено» на адресе раздела
Перем Подтверждения; // Подтверждение (кит) — имя поля подтверждённой отправки

#Область Адрес

// Имя параметра адреса, которым названо открытое окно.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПараметра() Экспорт
	Возврат "окно";
КонецФункции

// Адрес раздела, по которому страница приходит с открытым окном.
//
// Параметры:
//  АдресРаздела - Строка - адрес раздела.
//  Вид - Строка - вид окна: «новый», «изменить», «удалить» или свой вид раздела.
//  Ключ - Строка - ключ записи, чьё это окно; "" — окно без записи (необязательный,
//         по умолчанию "").
//
// Возвращаемое значение:
//  Строка - адрес с параметром окна.
//
Функция Адрес(Знач АдресРаздела, Знач Вид, Знач Ключ = "") Экспорт

	Значение = ?(ЗначениеЗаполнено(Ключ), Вид + "-" + Ключ, Вид);
	Возврат Ссылки.Установить(АдресРаздела, ИмяПараметра(), Значение);

КонецФункции

// Окно, названное параметром адреса: вид — до первого дефиса, ключ — всё после него.
//
// Параметры:
//  Значение - Строка, Неопределено - значение параметра «окно».
//  Виды - Строка - виды окон, которые раздел умеет открыть, через запятую.
//
// Возвращаемое значение:
//  Структура, Неопределено - состояние открытого окна (см. Отбитое); Неопределено — окна нет
//                            или такого вида раздел не знает.
//
Функция ИзАдреса(Знач Значение, Знач Виды) Экспорт

	Текст = СокрЛП(Строка(Значение));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Дефис = СтрНайти(Текст, "-");
	Вид = НРег(?(Дефис = 0, Текст, Лев(Текст, Дефис - 1)));
	Ключ = ?(Дефис = 0, "", Сред(Текст, Дефис + 1));

	Если СтрРазделить(НРег(Виды), ",", Ложь).Найти(Вид) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Открытое(Вид, Ключ);

КонецФункции

#КонецОбласти

#Область Состояние

// Состояние окна, открытого без формы: по адресу или кнопкой.
//
// Параметры:
//  Вид - Строка - вид окна.
//  Ключ - Строка - ключ записи (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - см. Отбитое.
//
Функция Открытое(Знач Вид, Знач Ключ = "") Экспорт
	Возврат Отбитое(Вид, Ключ, Неопределено);
КонецФункции

// Состояние окна, в которое вернулась отбитая форма.
//
// Параметры:
//  Вид - Строка - вид окна.
//  Ключ - Строка - ключ записи.
//  Набранное - Соответствие, Неопределено - разобранная форма: имя поля -> набранное.
//  Отказы - Соответствие, Неопределено - имя поля -> текст отказа под полем
//           (необязательный, по умолчанию Неопределено).
//  Ошибка - Строка - отказ, который не относится к одному полю (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Вид, Ключ, Набранное (Соответствие), Отказы (Соответствие), Ошибка (Строка).
//
Функция Отбитое(Знач Вид, Знач Ключ, Знач Набранное, Знач Отказы = Неопределено,
	Знач Ошибка = "") Экспорт

	Возврат Новый Структура("Вид, Ключ, Набранное, Отказы, Ошибка",
		НРег(Строка(Вид)), Строка(Ключ),
		?(Набранное = Неопределено, Новый Соответствие(), Набранное),
		?(Отказы = Неопределено, Новый Соответствие(), Отказы),
		Строка(Ошибка));

КонецФункции

// Открыто ли окно этого вида (и этой записи).
//
// Параметры:
//  Состояние - Структура, Неопределено - состояние окна раздела.
//  Вид - Строка - вид окна.
//  Ключ - Строка, Неопределено - ключ записи; Неопределено — любой (необязательный,
//         по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Булево.
//
Функция Открыто(Знач Состояние, Знач Вид, Знач Ключ = Неопределено) Экспорт

	Если Состояние = Неопределено ИЛИ Состояние.Вид <> НРег(Вид) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Ключ = Неопределено ИЛИ НРег(Состояние.Ключ) = НРег(Строка(Ключ));

КонецФункции

// Значение поля в окне: у отбитой формы — набранное (поля, которого не прислали, — пусто),
// иначе действующее.
//
// Параметры:
//  Состояние - Структура, Неопределено - состояние окна раздела.
//  Имя - Строка - имя поля формы.
//  Действующее - Строка - значение записи (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Строка.
//
Функция Значение(Знач Состояние, Знач Имя, Знач Действующее = "") Экспорт

	Если Отбито(Состояние) Тогда
		Набранное = Состояние.Набранное.Получить(Имя);
		Возврат ?(Набранное = Неопределено, "", Строка(Набранное));
	КонецЕсли;
	Возврат Строка(Действующее);

КонецФункции

// Отмечен ли флажок в окне: у отбитой формы — как его прислали (снятый флажок не приходит
// вовсе), иначе как у записи.
//
// Параметры:
//  Состояние - Структура, Неопределено - состояние окна раздела.
//  Имя - Строка - имя поля-флажка.
//  Действующее - Булево - состояние записи.
//  ЗначениеВключено - Строка - значение отмеченного флажка (необязательный, по умолчанию "1").
//
// Возвращаемое значение:
//  Булево.
//
Функция Отмечено(Знач Состояние, Знач Имя, Знач Действующее, Знач ЗначениеВключено = "1") Экспорт

	Если Отбито(Состояние) Тогда
		Возврат Строка(Состояние.Набранное.Получить(Имя)) = ЗначениеВключено;
	КонецЕсли;
	Возврат Действующее = Истина;

КонецФункции

// Отказ под полем окна.
//
// Параметры:
//  Состояние - Структура, Неопределено - состояние окна раздела.
//  Имя - Строка - имя поля формы.
//
// Возвращаемое значение:
//  Строка - текст отказа; "" — поле принято.
//
Функция Отказ(Знач Состояние, Знач Имя) Экспорт

	Если Состояние = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Текст = Состояние.Отказы.Получить(Имя);
	Возврат ?(Текст = Неопределено, "", Строка(Текст));

КонецФункции

// Отказ окна, который не относится к одному полю.
//
// Параметры:
//  Состояние - Структура, Неопределено - состояние окна раздела.
//
// Возвращаемое значение:
//  Строка.
//
Функция Ошибка(Знач Состояние) Экспорт
	Возврат ?(Состояние = Неопределено, "", Состояние.Ошибка);
КонецФункции

#КонецОбласти

#Область Ответы

// Пришла ли отправка из окна подтверждения: его кнопка шлёт поле подтверждения со значением «1».
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Булево.
//
Функция Подтверждено(Знач Форма) Экспорт
	Возврат Строка(Форма.Получить(Подтверждения.ИмяПоляПодтверждения())) = "1";
КонецФункции

// Удача формы окна: 303 на раздел с отметкой «сохранено». Со скриптом окно закрывается,
// список встаёт на место по ответу; без скрипта приходит страница раздела целиком.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется перенаправление.
//  АдресРаздела - Строка - адрес раздела.
//
Процедура ВернутьВРаздел(Ответ, Знач АдресРаздела) Экспорт
	Перенаправить(Ответ, Отметка.НаАдресе(АдресРаздела));
КонецПроцедуры

// Удача формы окна, после которой раздел должен знать больше, чем «сохранено»: 303 на раздел
// с отметкой и парами параметров (например, имя записанной записи для тоста о ней).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется перенаправление.
//  АдресРаздела - Строка - адрес раздела.
//  Пары - Соответствие - имя параметра -> значение.
//
Процедура ВернутьВРазделСПарами(Ответ, Знач АдресРаздела, Знач Пары) Экспорт
	Перенаправить(Ответ, Отметка.НаАдресеСПарами(АдресРаздела, Пары));
КонецПроцедуры

// Первая отправка опасной формы без подтверждения (без скрипта она уходит сразу): 303 на раздел
// с открытым окном подтверждения этой записи.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется перенаправление.
//  АдресРаздела - Строка - адрес раздела.
//  Ключ - Строка - ключ записи.
//  Вид - Строка - вид окна подтверждения (необязательный, по умолчанию «удалить»).
//
Процедура СпроситьПодтверждение(Ответ, Знач АдресРаздела, Знач Ключ, Знач Вид = "удалить") Экспорт
	Перенаправить(Ответ, Адрес(АдресРаздела, Вид, Ключ));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Окно вернулось с формой: есть набранное, отказ у поля или отказ окна.
Функция Отбито(Знач Состояние)
	Возврат Состояние <> Неопределено И (Состояние.Набранное.Количество() > 0
		ИЛИ Состояние.Отказы.Количество() > 0 ИЛИ ЗначениеЗаполнено(Состояние.Ошибка));
КонецФункции

// 303, а не 302: браузер идёт за ответом GET-ом и не повторяет отправку.
Процедура Перенаправить(Ответ, Знач Адрес)
	Ответ.Перенаправить(Адрес);
	Ответ.УстановитьСостояние(303);
КонецПроцедуры

#КонецОбласти

&Прозвище("ОкноРаздела")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПараметрыСсылки") _Ссылки,
	&Пластилин(Значение = "ОтметкаСохранения") _Отметка,
	&Пластилин(Значение = "Подтверждение") _Подтверждения) Экспорт

	Ссылки = _Ссылки;
	Отметка = _Отметка;
	Подтверждения = _Подтверждения;

КонецПроцедуры
