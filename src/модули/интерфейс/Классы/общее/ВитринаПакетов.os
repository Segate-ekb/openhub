// Витрина пакетов — желудь модуля web-ui: превращает пару {Пакет, Пул} в модель
// компонента «Карточка пакета». Разметки здесь нет — её печатает компонент.

Перем Провенанс;       // СервисПроисхождения (реестр)
Перем СлужбаКабинета;  // СлужбаКабинета (кабинет)
Перем Тексты;          // ТекстыИнтерфейса
Перем Реестр;          // ЗначкиМеты

// Модели карточек для списка пакетов. И множество управляемых пакетов, и множество своих
// имён берутся один раз на список, а не по разу на строку.
//
// Параметры:
//  Элементы     - Массив из Структура - строки списка: Пакет, Пул.
//  Пользователь - Пользователь, Неопределено - (необязательный, по умолчанию
//                 Неопределено) субъект запроса, определяет показ шестерёнки настроек.
//
// Возвращаемое значение:
//  Массив из Структура - модели компонента «Карточка пакета».
//
Функция Карточки(Знач Элементы, Знач Пользователь = Неопределено) Экспорт
	Возврат Модели(Элементы, МножествоУправляемых(Пользователь));
КонецФункции

// Модели карточек списка, каждым пакетом которого смотрящий заведомо управляет: кабинет
// отобрал их по праву управления, и спрашивать модель прав второй раз незачем.
//
// Параметры:
//  Элементы - Массив из Структура - строки списка: Пакет, Пул.
//
// Возвращаемое значение:
//  Массив из Структура - модели компонента «Карточка пакета» с шестерёнкой настроек.
//
Функция КарточкиУправляемых(Знач Элементы) Экспорт
	Возврат Модели(Элементы, ВсеУправляемые(Элементы));
КонецФункции

// Модель одной карточки.
//
// Параметры:
//  Пакет       - Пакет - пакет.
//  Пул         - Пул, Неопределено - пул пакета.
//  Управляемый - Булево - (необязательный, по умолчанию Ложь) показывать ли
//                шестерёнку «настройки».
//  СвоёИмя     - Булево, Неопределено - есть ли у имени собственные версии, если вызывающий
//                уже спросил это на весь список (необязательный, по умолчанию
//                Неопределено — спросить здесь).
//
// Возвращаемое значение:
//  Структура - модель компонента «Карточка пакета».
//
Функция Модель(Знач Пакет, Знач Пул, Знач Управляемый = Ложь, Знач СвоёИмя = Неопределено) Экспорт

	ИмяПула = ?(Пул = Неопределено, "", Строка(Пул.Имя));
	Адрес = СтрШаблон("/%1/%2", ИмяПула, Пакет.Имя);

	Модель = Новый Структура();
	Модель.Вставить("Имя", Пакет.Имя);
	Модель.Вставить("Адрес", Адрес);
	Модель.Вставить("Описание", ?(ЗначениеЗаполнено(Пакет.Описание), Пакет.Описание, ""));
	Модель.Вставить("Пул", ИмяПула);
	Модель.Вставить("АдресПула", ?(ЗначениеЗаполнено(ИмяПула), "/" + ИмяПула, ""));
	Модель.Вставить("Плашки", Плашки(Пакет, СвоёИмя));
	Модель.Вставить("Действия", Действия(Управляемый, Адрес));
	Возврат Модель;

КонецФункции

// Модель шапки страницы пакета. Живёт здесь, а не в контроллере, по той же причине,
// что и модель карточки: «как пакет выглядит на экране» — вопрос витрины, а контроллер
// отвечает за маршрут и права. Здесь же кит узнаёт, чем пакет отличается от пула:
// слаг вида, иконка и подпись — словарь ХАБА, и придумать их за него компоненту нечем.
//
// Параметры:
//  Пакет       - Пакет - пакет.
//  Автор       - Строка - автор из манифеста последней версии; пустой не показывается.
//  Скачиваний  - Число - счётчик скачиваний.
//  СвоёИмя     - Булево, Неопределено - есть ли у имени собственные версии, если вызывающий
//                уже снял провенанс пакета (необязательный, по умолчанию Неопределено —
//                спросить здесь).
//
// Возвращаемое значение:
//  Структура - модель компонента «Шапка объекта» без Команды и Действий: их знает
//              только контроллер.
//
Функция ШапкаПакета(Знач Пакет, Знач Автор, Знач Скачиваний, Знач СвоёИмя = Неопределено) Экспорт

	Результат = Новый Структура();
	Результат.Вставить("Имя", Пакет.Имя);
	Результат.Вставить("Вид", "package");
	Результат.Вставить("Иконка", "пакет");
	Результат.Вставить("Подпись", "пакет");
	Результат.Вставить("Описание", ?(ЗначениеЗаполнено(Пакет.Описание), Пакет.Описание, ""));
	Результат.Вставить("Плашки", Плашки(Пакет, СвоёИмя));
	Результат.Вставить("Мета", МетаШапки(Пакет, Автор, Скачиваний));
	Возврат Результат;

КонецФункции

// Мета шапки: автор, скачивания, лицензия, репозиторий.
Функция МетаШапки(Знач Пакет, Знач Автор, Знач Скачиваний)

	Результат = Новый Массив();

	Если ЗначениеЗаполнено(Автор) Тогда
		Результат.Добавить(Новый Структура("Подпись, Значение", "автор", Автор));
	КонецЕсли;
	Результат.Добавить(Новый Структура("Подпись, Значение", "скачиваний",
		Тексты.ЧислоТекстом(Скачиваний)));
	Если ЗначениеЗаполнено(Пакет.Лицензия) Тогда
		Результат.Добавить(Новый Структура("Подпись, Значение", "лицензия", Пакет.Лицензия));
	КонецЕсли;
	Если ЗначениеЗаполнено(Пакет.АдресРепозитория) Тогда
		Результат.Добавить(Репозиторий(Пакет.АдресРепозитория));
	КонецЕсли;

	Возврат Реестр.Оснастить(Результат);

КонецФункции

// Ссылкой адрес становится, только если ведёт в веб: «javascript:…» не попадает даже текстом.
Функция Репозиторий(Знач Адрес)

	АдресСтрокой = СокрЛП(Строка(Адрес));
	Схема = ВебСхема(АдресСтрокой);

	Если НЕ ЗначениеЗаполнено(Схема) Тогда
		Возврат Новый Структура("Подпись, Значение", "репозиторий", "");
	КонецЕсли;

	Возврат Новый Структура("Подпись, Значение, Адрес",
		"репозиторий", БезСхемы(АдресСтрокой, Схема), АдресСтрокой);

КонецФункции

// Вторая сеть слоя вывода; доменное правило — ПравилаИменования.АдресРепозиторияБезопасен.
Функция ВебСхема(Знач Адрес)

	Для Каждого Схема Из СтрРазделить("https://,http://", ",") Цикл
		Если СтрНачинаетсяС(НРег(Адрес), Схема) Тогда
			Возврат Схема;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Видимый текст ссылки: «github.com/автор/пакет» вместо всей строки адреса.
Функция БезСхемы(Знач Адрес, Знач Схема)

	Результат = Сред(Адрес, СтрДлина(Схема) + 1);
	Возврат ?(СтрЗаканчиваетсяНа(Результат, "/"), Лев(Результат, СтрДлина(Результат) - 1), Результат);

КонецФункции

// Плашки пакета: провенанс, устаревание, скрытость. «С апстрима» ставится по отсутствию
// СОБСТВЕННЫХ версий у имени, а не по наличию апстрима у пула: в проксирующем пуле часть
// имён своя, часть чужая.
//
// Параметры:
//  Пакет   - Пакет - пакет.
//  СвоёИмя - Булево, Неопределено - есть ли у имени собственные версии, если вызывающий
//            уже спросил это разом на весь список (необязательный, по умолчанию
//            Неопределено — спросить здесь).
//
// Возвращаемое значение:
//  Массив из Структура - модели компонента «Плашка».
//
Функция Плашки(Знач Пакет, Знач СвоёИмя = Неопределено) Экспорт

	Результат = Новый Массив();

	Если НЕ СобственноеИмя(Пакет, СвоёИмя) Тогда
		Результат.Добавить(Новый Структура("Текст, Вид, Иконка, Подсказка",
			Тексты.Текст("public.showcase.upstream.tag"), "accent", "ссылка",
			Тексты.Текст("public.showcase.upstream.hint")));
	КонецЕсли;

	Если Пакет.Устарел = Истина Тогда
		Результат.Добавить(Новый Структура("Текст, Вид", "устаревший", "warn"));
	КонецЕсли;

	Если Пакет.Скрыт = Истина Тогда
		Результат.Добавить(Новый Структура("Текст", "скрыт"));
	КонецЕсли;

	Возврат Результат;

КонецФункции

#Область СлужебныеПроцедурыИФункции

// Провенанс спрашивается ОДИН раз на список: вопрос на карточку делал бы страницу N+1.
Функция Модели(Знач Элементы, Знач Управляемые)

	Свои = Провенанс.СвоиИменаСреди(НомераПакетов(Элементы));

	Результат = Новый Массив();
	Для Каждого Элемент Из Элементы Цикл
		Результат.Добавить(Модель(Элемент.Пакет, Элемент.Пул,
			Управляемые.Получить(Элемент.Пакет.Идентификатор) = Истина,
			Свои.Получить(Цел(Элемент.Пакет.Идентификатор)) = Истина));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ВсеУправляемые(Знач Элементы)

	Результат = Новый Соответствие();
	Для Каждого Элемент Из Элементы Цикл
		Результат.Вставить(Элемент.Пакет.Идентификатор, Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ответ пришёл со списком — берём готовый; пришла одиночная карточка — спрашиваем сами.
Функция СобственноеИмя(Знач Пакет, Знач СвоёИмя)

	Если СвоёИмя <> Неопределено Тогда
		Возврат СвоёИмя = Истина;
	КонецЕсли;
	Возврат Провенанс.ЕстьСобственныеВерсии(Пакет.Идентификатор);

КонецФункции

Функция НомераПакетов(Знач Элементы)

	Результат = Новый Массив();
	Для Каждого Элемент Из Элементы Цикл
		Результат.Добавить(Цел(Элемент.Пакет.Идентификатор));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Право спрашивается у модели прав, а не у авторства: мейнтейнер с грантом тоже управляет.
Функция МножествоУправляемых(Знач Пользователь)

	Результат = Новый Соответствие();
	Если Пользователь = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Элемент Из СлужбаКабинета.ПакетыВУправлении(Пользователь) Цикл
		Результат.Вставить(Элемент.Пакет.Идентификатор, Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Модели кнопок, а не разметка: печатает их карточка.
Функция Действия(Знач Управляемый, Знач АдресПакета)

	Результат = Новый Массив();
	Если НЕ Управляемый Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Добавить(Новый Структура("Подпись, Адрес, Вариант, Размер, Иконка, Подсказка",
		Тексты.Текст("public.showcase.settings.label"), АдресПакета + "/settings", "вторичная", "малый", "шестерёнка",
		Тексты.Текст("public.showcase.settings.hint")));
	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПроисхождения") _Провенанс,
	&Пластилин(Значение = "СлужбаКабинета") _СлужбаКабинета,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ЗначкиМеты") _Реестр)

	Провенанс = _Провенанс;
	СлужбаКабинета = _СлужбаКабинета;
	Тексты = _Тексты;
	Реестр = _Реестр;

КонецПроцедуры
