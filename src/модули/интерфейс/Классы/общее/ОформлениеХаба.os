// Оформление инсталляции хаба — реализация контракта кита «ОформлениеИнсталляции»:
// тема и акцент читаются НА ЗАПРОСЕ из прикладных настроек, поэтому правка в разделе
// «Брендирование» видна сразу и без перезапуска процесса.

Перем Настройки; // СервисНастроек (настройки)
&Лог
Перем Лог;

// Действующее оформление инсталляции.
//
// Возвращаемое значение:
//  Структура - Тема ("тёмная"|"светлая"|""), Акцент (#rrggbb либо "").
//
Функция Оформление() Экспорт

	Возврат Новый Структура("Тема, Акцент",
		Значение("oshub.ui.theme"), Значение("oshub.ui.accent"));

КонецФункции

// Имя cookie, в которой хаб хранит выбор посетителя. Кука живёт в домене инсталляции,
// поэтому имя даёт она, а не кит.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяCookieОформления() Экспорт
	Возврат "oshub_ui";
КонецФункции

// Значение конфигурации резолвер отдаёт не заглядывая в базу, поэтому недоступной она
// бывает только для значения из базы. Страница обязана нарисоваться и тогда: пустое
// оформление — это оформление кита, а не отказ отдать страницу; отказ идёт в журнал.
Функция Значение(Знач Ключ)

	Попытка
		Возврат СокрЛП(Строка(Настройки.Значение(Ключ)));
	Исключение
		Предупредить(Ключ, ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

// Текст лога — диагностика оператору, без кириллицы: страж «строки живут в СловареТекстов».
Процедура Предупредить(Знач Ключ, Знач Ошибка)
	Если Лог <> Неопределено Тогда
		Лог.Предупреждение("appearance: setting %1 unreadable (%2), falling back to kit defaults",
			Ключ, КраткоеПредставлениеОшибки(Ошибка));
	КонецЕсли;
КонецПроцедуры

// Лог берётся инъекцией ОСени в поле (&Лог выше) — боевой путь.
&Верховный
&Прозвище("ОформлениеИнсталляции")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Лог _Лог = Неопределено) Экспорт

	Настройки = _Настройки;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
