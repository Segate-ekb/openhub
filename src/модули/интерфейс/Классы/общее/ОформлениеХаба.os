// Реализация контракта кита «ОформлениеИнсталляции»: тема, пресет и акцент читаются НА ЗАПРОСЕ
// из прикладных настроек, поэтому правка в разделе «Брендирование» видна сразу.

Перем Настройки; // СервисНастроек (настройки)
&Лог
Перем Лог;
Перем Ошибки;  // ТекстОшибки (основа) — текст сбоя в журнал

// Действующее оформление инсталляции.
//
// Возвращаемое значение:
//  Структура - Тема ("тёмная"|"светлая"|""), Пресет (ключ пресета темы кита либо ""),
//   Акцент (#rrggbb либо "").
//
Функция Оформление() Экспорт

	Тема = Значение("oshub.ui.theme");
	Пресет = Значение("oshub.ui.preset");
	Акцент = Значение("oshub.ui.accent");
	// «правка в брендировании не видна» разбирается здесь: печатается то, с чем страница
	// нарисуется прямо сейчас, а пустое значение означает оформление кита
	Если Лог <> Неопределено Тогда
		Лог.Отладка("appearance: theme=%1 preset=%2 accent=%3",
			?(ЗначениеЗаполнено(Тема), Тема, "kit"), ?(ЗначениеЗаполнено(Пресет), Пресет, "kit"),
			?(ЗначениеЗаполнено(Акцент), Акцент, "kit"));
	КонецЕсли;

	Возврат Новый Структура("Тема, Пресет, Акцент", Тема, Пресет, Акцент);

КонецФункции

// Имя cookie, в которой хаб хранит выбор оформления посетителя.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяCookieОформления() Экспорт
	Возврат "oshub_ui";
КонецФункции

// Страница обязана нарисоваться и при недоступной базе: пустое оформление — это оформление кита.
Функция Значение(Знач Ключ)

	Попытка
		Возврат СокрЛП(Строка(Настройки.Значение(Ключ)));
	Исключение
		Предупредить(Ключ, ИнформацияОбОшибке());
		Возврат "";
	КонецПопытки;

КонецФункции

// Текст журнала — диагностика оператору, без кириллицы.
Процедура Предупредить(Знач Ключ, Знач Ошибка)
	Если Лог <> Неопределено Тогда
		Лог.Предупреждение("appearance: setting %1 unreadable (%2), falling back to kit defaults",
			Ключ, Ошибки.ДляЧеловека(Ошибка));
	КонецЕсли;
КонецПроцедуры

&Верховный
&Прозвище("ОформлениеИнсталляции")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено) Экспорт

	Настройки = _Настройки;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);

КонецПроцедуры
