// Ключи настроек интерфейса: хаб по умолчанию в командах opm, оформление и знак инсталляции,
// размер страницы журнала аудита. Здесь же — правка личных пространств своим пультом.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей интерфейса в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи интерфейса.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(130)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "oshub.instance.opm_default_hub", ЗначениеПоУмолчанию = "") _ХабПоУмолчаниюOpm = "",
	&Деталька(Значение = "oshub.ui.theme", ЗначениеПоУмолчанию = "") _Тема = "",
	&Деталька(Значение = "oshub.ui.accent", ЗначениеПоУмолчанию = "") _Акцент = "",
	&Деталька(Значение = "oshub.ui.brand", ЗначениеПоУмолчанию = "") _Знак = "",
	&Деталька(Значение = "oshub.ui.tagline", ЗначениеПоУмолчанию = "") _Подпись = "",
	&Деталька(Значение = "oshub.ui.show_name", ЗначениеПоУмолчанию = "") _ПоказыватьНазвание = "",
	&Деталька(Значение = "oshub.ui.audit_page_size", ЗначениеПоУмолчанию = "") _СтраницаАудита = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	// Хаб, которым opm пользуется без настройки: основной публичный пул прописывать незачем.
	Ключи.Объявить("oshub.instance.opm_default_hub", "булево", Ложь, Неопределено, "прикладная",
		_ХабПоУмолчаниюOpm);

	// Оформление и знак инсталляции читаются на запросе, рестарта правка не требует.
	Ключи.Объявить("oshub.ui.theme", "строка", "тёмная", _Правила.Перечисление("тёмная,светлая"),
		"прикладная", _Тема);
	// пусто — акцент темы (ТокеныТемы), поэтому валидатор цвета пустое значение пропускает
	Ключи.Объявить("oshub.ui.accent", "строка", "", _Правила.Цвет(), "прикладная", _Акцент);
	// пусто — знак и подпись по умолчанию из Брендирование
	Ключи.Объявить("oshub.ui.brand", "строка", "", Неопределено, "прикладная", _Знак);
	Ключи.Объявить("oshub.ui.tagline", "строка", "", Неопределено, "прикладная", _Подпись);
	// выключается, когда загруженный знак уже несёт название хаба рисунком
	Ключи.Объявить("oshub.ui.show_name", "булево", Истина, Неопределено, "прикладная", _ПоказыватьНазвание);

	Ключи.Объявить("oshub.ui.audit_page_size", "целое", 20, _Правила.Минимум(1), "прикладная",
		_СтраницаАудита);

	// Правка личных пространств — переход: включение раздаёт пулы всем, выключение сносит их,
	// поэтому значение пишет только пульт, который ведёт этот переход.
	Ключи.ПравитМеханизм("oshub.pools.personal_enabled", "ПультЛичныхПространств");

КонецПроцедуры
