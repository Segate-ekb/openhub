// Контроллер страницы описания API — web-ui: GET /swagger-ui.html. Адреса, параметры
// и ответы рисует вендоренный Swagger UI, читая ТО ЖЕ описание, которое хаб отдаёт машине, —
// копии описания на странице нет.

Перем Кит;          // Кит (кит) — фабрика элементов экрана
Перем Каркас;       // КаркасСтраницы (кит) — корень страницы
Перем Тексты;       // ТекстыИнтерфейса (кит) — строки по ключам
Перем Активы;       // АдресаСтатики (web-ui) — адреса движка с отпечатком содержимого
Перем ОписаниеAPI;  // АдресаОписанияAPI (api) — адрес машиночитаемого документа
Перем Гвард;        // ГвардОнбординга (web-ui)
Перем Перехватчик;  // ПерехватчикАутентификации (вход)
Перем HTTP;         // МетодыHTTP (основа) — сравнение метода запроса
Перем Кэш;          // ЗаголовкиКэша (основа) — отказ не остаётся в кэше

// Отдаёт страницу описания API.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - для определения принципала.
//  КукиЗапроса      - Куки         - сессия и оформление читателя.
//  МетодЗапроса     - Строка       - метод запроса; допустим только GET.
//  ПутьЗапроса      - Строка       - путь текущего запроса: по нему меню подсвечивает
//                     текущую дорогу.
//
&ТочкаМаршрута("swagger-ui.html")
Процедура Показать(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ПутьЗапроса) Экспорт

	Если НЕ Гвард.Проверить(Ответ).Разрешено Тогда
		Возврат;
	КонецЕсли;

	Пользователь = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса).Пользователь;

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьМетодНеРазрешён(Ответ, Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Ответ.УстановитьСостояниеОК();
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Тексты.Текст("public.api.title"), Экран(),
		Каркас.КонтекстСтраницы(Пользователь, КукиЗапроса, Ложь, Ложь, ПутьЗапроса));

КонецПроцедуры

#Область Рендер

Функция Экран()

	Холст = Кит.Холст();

	Холст.Добавить(Заглавие());
	Холст.Добавить(ЛистДвижка());
	Холст.Добавить(ФонПодДвижком());
	Холст.Добавить(МестоДвижка());
	Холст.Добавить(РазрешенияДвижка());
	Холст.Добавить(Движок());
	Холст.Добавить(ЗапускДвижка());

	Возврат Холст;

КонецФункции

Функция Заглавие()

	Холст = Кит.Холст();
	Холст.Добавить(Кит.ЗаголовокСтраницы(Новый Структура("Заголовок, Пояснение",
		Тексты.Текст("public.api.title"), Тексты.Текст("public.api.lead"))));
	Холст.Добавить(ХодКОписанию());
	Холст.Добавить(Кит.Примечание(Тексты.Текст("public.api.probe")));
	Холст.Добавить(СледствияПробногоЗапроса());
	Возврат Холст;

КонецФункции

// Пробный запрос со страницы уходит с сессией читателя, и из этого следуют три вещи,
// о которых легко забыть. Списком, а не абзацем: одним куском они не читаются.
Функция СледствияПробногоЗапроса()

	Список = Кит.Список("сноска");

	Список.Добавить(Следствие(Тексты.Текст("public.api.probe.read")));
	Список.Добавить(Следствие(Тексты.Текст("public.api.probe.write")));
	Список.Добавить(Следствие(Тексты.Текст("public.api.probe.token")));

	Возврат Список;

КонецФункции

Функция Следствие(Знач Текст)
	Пункт = Кит.Пункт();
	Пункт.Добавить(Кит.Текст(Текст));
	Возврат Пункт;
КонецФункции

// Тот же документ, что читает страница, — файлом: клиента пишут по описанию, а не по
// снимку экрана.
Функция ХодКОписанию()

	Примечание = Кит.Примечание();
	Фраза = Примечание.Добавить(Кит.Шаблон(Тексты.Текст("public.api.machine")));
	Ссылка = Фраза.Добавить(Кит.Ссылка(ОписаниеAPI.Документ()));
	Ссылка.Добавить(Кит.Код(ОписаниеAPI.Документ()));
	Возврат Примечание;

КонецФункции

// Лист движка едет в теле страницы, а не в голове: голову собирает каркас, и оформление
// одного экрана в общий каркас не просится.
Функция ЛистДвижка()
	Возврат Кит.Ресурс("stylesheet", Активы.АдресЛистаОписанияAPI());
КонецФункции

// Единственное правило листа движка, не запертое под классом «swagger-ui», красит КОРЕНЬ
// документа своим тёмным — а фон хаба живёт на теле. Два разных тёмных делят экран везде,
// где тело короче окна: полоса отскока, низ страницы, пока описание едет.
// Перебивается порядком, а не весом: правило стоит ПОСЛЕ листа движка при той же
// специфичности. Соседнее «color-scheme: dark» оставлено движку: оно красит не страницу,
// а собственные примитивы браузера, и на тёмной теме хаба говорит правду.
Функция ФонПодДвижком()
	Возврат Кит.Стиль("канва-движка", "html.dark-mode{background:var(--color-bg)}");
КонецФункции

// Место, куда движок рисует себя сам, и единственная дорога адреса описания в браузер.
Функция МестоДвижка()
	Возврат Кит.Область().Признак("swagger-ui", "").Признак("openapi", ОписаниеAPI.Документ());
КонецФункции

// Разрешение на вендоренный движок и уведомления об авторстве — ходами со страницы,
// на которой он работает: иначе файлы отдаются по адресам, которых никто не знает.
Функция РазрешенияДвижка()

	Примечание = Кит.Примечание();
	Фраза = Примечание.Добавить(Кит.Шаблон(Тексты.Текст("public.api.notice")));

	Фраза.Добавить(ХодКФайлу(Активы.АдресЛицензииДвижка(), "LICENSE"));
	Фраза.Добавить(ХодКФайлу(Активы.АдресАвторстваДвижка(), "NOTICE"));
	Фраза.Добавить(ХодКФайлу(Активы.АдресЛицензийЗависимостейДвижка(),
		Тексты.Текст("public.api.notice.deps")));

	Возврат Примечание;

КонецФункции

Функция ХодКФайлу(Знач Адрес, Знач Подпись)
	Ссылка = Кит.Ссылка(Адрес);
	Ссылка.Добавить(Кит.Текст(Подпись));
	Возврат Ссылка;
КонецФункции

Функция Движок()
	Возврат Кит.Скрипт(Активы.АдресДвижкаОписанияAPI());
КонецФункции

Функция ЗапускДвижка()
	Возврат Кит.Скрипт(Активы.АдресЗапускаОписанияAPI());
КонецФункции

#КонецОбласти

#Область Отказы

// winow метод не различает: маршрут один, метод разбирает контроллер. Отказ уносит
// кэш-заголовки с собой — 405 кэшируется по умолчанию, и осевший ответ пережил бы причину.
Процедура ОтдатьМетодНеРазрешён(Ответ, Знач Пользователь, Знач КукиЗапроса)

	Кэш.ЗакрытьСтраницу(Ответ);
	Ответ.Заголовки["Allow"] = "GET";
	Ответ.УстановитьСостояние(405);
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Тексты.Текст("public.api.method.title"),
		Кит.СтраницаОшибки(Новый Структура("Код, Сообщение",
			405, Тексты.Шаблон("public.api.method.body", "GET"))),
		Каркас.КонтекстСтраницы(Пользователь, КукиЗапроса));

КонецПроцедуры

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаСтатики") _Активы,
	&Пластилин(Значение = "АдресаОписанияAPI") _ОписаниеAPI,
	&Пластилин(Значение = "ГвардОнбординга") _Гвард,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "ЗаголовкиКэша") _Кэш)

	Кит = _Кит;
	Каркас = _Каркас;
	Тексты = _Тексты;
	Активы = _Активы;
	ОписаниеAPI = _ОписаниеAPI;
	Гвард = _Гвард;
	Перехватчик = _Перехватчик;
	HTTP = _HTTP;
	Кэш = _Кэш;

КонецПроцедуры
