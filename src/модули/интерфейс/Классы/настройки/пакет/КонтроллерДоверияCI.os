// Доверенная публикация из CI — контроллер модуля web-ui: раздел «ci» дома «Пакет».

Перем ГвардПакета;    // ГвардПакета (web-ui)
Перем Ответы;         // ОтветыНастроек (web-ui)
Перем Дом;            // ДомПакета (web-ui)
Перем ДомПула;        // ДомПула (web-ui) — хлебные крошки
Перем Витрина;        // ВитринаДоверияCI (web-ui)
Перем Пульт;          // ПультДоверияCI (web-ui)
Перем Гейт;           // ГейтФормы (web-ui) — метод запроса и токен формы
Перем Защита;         // ЗащитаCSRF (auth) — токен для форм страницы
Перем РазборФормы;    // РазборФормы (web-ui)
Перем СервисДоверия;  // СервисДоверияCI (публикация) — порог «мейнтейнер пакета и выше»
Перем Сниппеты;       // СниппетыКонвейеров (web-ui) — внешний адрес хаба
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ТочкиМаршрута

// Точка маршрута «{pool}/{name}/settings/ci» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя пакета из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  ci - Строка - тип репозитория, поля которого показывает форма заведения
//       (необязательный, по умолчанию "").
//  form - Строка - "1" открывает окно заведения сразу: это серверная дорога к форме
//         для движка, который не умеет команд кнопки (необязательный, по умолчанию "").
//
&ТочкаМаршрута("{pool}/{name}/settings/ci")
Процедура Раздел(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	ci = "", form = "") Экспорт

	Вердикт = Допустить(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Вердикт = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		// тип репозитория приезжает ССЫЛКОЙ-переключателем: от него зависит набор полей,
		// а перерисовать набор без перезагрузки нечем
		ОтдатьРаздел(Ответ, Вердикт, ЗаголовкиЗапроса, КукиЗапроса, "", 200, "", ci,
			Неопределено, Строка(form) = "1");
		Возврат;
	КонецЕсли;

	Форма = Гейт.ПринятаяФорма(Ответ, Вердикт, "GET, POST", МетодЗапроса, ТелоЗапроса,
		КукиЗапроса, Тексты.Текст("settings.package.ci.error.csrf"));
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Применить(Ответ, Вердикт, Форма, ЗаголовкиЗапроса, КукиЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Действия

// Порядок проверок тот же, что у соседних админских разделов: видимость пула и наличие
// пакета — 404 (невидимый неотличим от несуществующего), затем порог мейнтейнера — 403.
// Неопределено означает, что ответ уже записан.
Функция Допустить(Ответ, Знач pool, Знач name, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Вердикт = ГвардПакета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool, name);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ СервисДоверия.МожетНастраивать(Вердикт.Пользователь, Вердикт.Пакет) Тогда
		Ответы.ОтдатьЗапрещено(Ответ, Вердикт.Пользователь,
			Тексты.Текст("settings.package.ci.error.forbidden"), КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Вердикт;

КонецФункции

Процедура Применить(Ответ, Знач Вердикт, Знач Форма, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Итог = Пульт.Применить(Вердикт.Принципал, Вердикт.Пакет, Форма);
	ТипРепозитория = ?(ЗначениеЗаполнено(Итог.Провайдер), Итог.Провайдер,
		РазборФормы.Поле(Форма, "провайдер"));

	Если ЗначениеЗаполнено(Итог.Подтвердить) Тогда
		ОтдатьРаздел(Ответ, Вердикт, ЗаголовкиЗапроса, КукиЗапроса, "", 200, Итог.Подтвердить,
			ТипРепозитория);
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		Если Итог.Код = 404 Тогда
			// чужая запись неотличима от несуществующей — как и чужой пул
			Ответы.ОтдатьНеНайдено(Ответ, Вердикт.Пользователь, Итог.Ошибка, КукиЗапроса);
			Возврат;
		КонецЕсли;
		// отбитая форма возвращается ТЕМ ЖЕ окном: с набранным и помеченным полем,
		// а не пустой страницей, съевшей ввод
		ОтдатьРаздел(Ответ, Вердикт, ЗаголовкиЗапроса, КукиЗапроса, Итог.Ошибка,
			?(Итог.Код = 403, 403, 400), "", ТипРепозитория, Итог.Заполнение,
			Итог.Заведение, Итог.Отказы);
		Возврат;
	КонецЕсли;

	// разбор ссылки НЕ создаёт записи: страница возвращается с заполненной формой
	Если Итог.Заполнение <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Вердикт, ЗаголовкиЗапроса, КукиЗапроса, "", 200, "",
			ТипРепозитория, Итог.Заполнение, Итог.Заведение);
		Возврат;
	КонецЕсли;

	// вкладка переживает PRG: иначе после сохранения GitLab-форма молча возвращается
	// к GitHub, и следующая запись заводится не тем набором полей
	Ответ.Перенаправить(Адрес(Вердикт)
		+ ?(ЗначениеЗаполнено(ТипРепозитория), "?ci=" + ТипРепозитория, ""));

КонецПроцедуры

Функция Адрес(Знач Вердикт)
	Возврат Дом.АдресРаздела(Вердикт.Пул.Имя, Вердикт.Пакет.Имя, "ci");
КонецФункции

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач Ошибка = "", Знач Статус = 200, Знач Снятие = "", Знач ТипРепозитория = "",
	Знач Заполнение = Неопределено, Знач Открыта = Ложь, Знач Отказы = Неопределено)

	Пул = Вердикт.Пул;
	Пакет = Вердикт.Пакет;

	Параметры = Новый Структура();
	Параметры.Вставить("Пул", Пул);
	Параметры.Вставить("Пакет", Пакет);
	Параметры.Вставить("Адрес", Адрес(Вердикт));
	Параметры.Вставить("Токен", Защита.ТокенСессии(Вердикт.Сессия));
	Параметры.Вставить("АдресХаба", Сниппеты.БазовыйАдрес(ЗаголовкиЗапроса));
	Параметры.Вставить("Снятие", Снятие);
	Параметры.Вставить("Провайдер", ТипРепозитория);
	Параметры.Вставить("Заполнение", Заполнение);
	Параметры.Вставить("Открыта", Открыта);
	Параметры.Вставить("Отказы", Отказы);

	Хлебные = Новый Массив();
	Хлебные.Добавить(Новый Структура("Подпись, Адрес", Пул.Имя, ДомПула.АдресПула(Пул.Имя)));
	Хлебные.Добавить(Новый Структура("Подпись, Адрес", Пакет.Имя, Дом.АдресПакета(Пул.Имя, Пакет.Имя)));
	Хлебные.Добавить(Новый Структура("Подпись", Тексты.Текст("settings.package.crumb")));

	Модель = Ответы.МодельДома(Дом, Пакет.Имя,
		Дом.Разделы(Пул.Имя, Пакет.Имя, "ci", Вердикт.Пользователь, Пакет),
		Ответы.УведомленияРаздела(Ложь, Ошибка),
		Витрина.Секции(Параметры),
		Хлебные);

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт.Пользователь, КукиЗапроса,
		Тексты.Шаблон("settings.package.tab", Пакет.Имя), Статус);

КонецПроцедуры

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардПакета") _ГвардПакета,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомПакета") _Дом,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ВитринаДоверияCI") _Витрина,
	&Пластилин(Значение = "ПультДоверияCI") _Пульт,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисДоверияCI") _СервисДоверия,
	&Пластилин(Значение = "СниппетыКонвейеров") _Сниппеты,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	ГвардПакета = _ГвардПакета;
	Ответы = _Ответы;
	Дом = _Дом;
	ДомПула = _ДомПула;
	Витрина = _Витрина;
	Пульт = _Пульт;
	Гейт = _Гейт;
	Защита = _Защита;
	РазборФормы = _РазборФормы;
	СервисДоверия = _СервисДоверия;
	Сниппеты = _Сниппеты;
	Тексты = _Тексты;

КонецПроцедуры
