// Пульт версий пакета — желудь модуля web-ui: отзыв и восстановление версии, метка
// ручного тега прямо у версии.

Перем РазборФормы;   // РазборФормы (web-ui)
Перем СервисВерсий;  // СервисВерсий (реестр)
Перем СервисТегов;   // СервисТегов (реестр)
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Применяет операцию раздела «Версии» дома «Пакет».
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Пользователь - Пользователь, Неопределено - кто действует; попадает в событие.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - Записано (Булево: Ложь — снятие ждёт подтверждения),
//              Снятие (Структура Тег, Версия либо Неопределено).
//
Функция Применить(Знач Пакет, Знач Пользователь, Знач Форма) Экспорт

	Версия = РазборФормы.Поле(Форма, "версия");
	Если НЕ ЗначениеЗаполнено(Версия) Тогда
		Возврат Записано();
	КонецЕсли;

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, "операция")));
	ИмяТега = РазборФормы.Поле(Форма, "имя");
	Кто = ?(Пользователь = Неопределено, "", Строка(Пользователь.Логин));

	Если Операция = "тег_добавить" Тогда
		Если ЗначениеЗаполнено(ИмяТега) Тогда
			ТребоватьРучнойТег(Пакет.Идентификатор, ИмяТега);
			СервисТегов.ПометитьВерсию(Пакет.Идентификатор, ИмяТега, Версия, Кто);
		КонецЕсли;
		Возврат Записано();
	КонецЕсли;

	Если Операция = "тег_снять" Тогда
		Если НЕ ЗначениеЗаполнено(ИмяТега) Тогда
			Возврат Записано();
		КонецЕсли;
		ТребоватьРучнойТег(Пакет.Идентификатор, ИмяТега);
		Если РазборФормы.Поле(Форма, "подтверждение") <> ЗначениеПодтверждения() Тогда
			// первый POST только спрашивает: снятие обратимо, но молча случаться не должно
			Возврат Спросить(Новый Структура("Тег, Версия", ИмяТега, Версия));
		КонецЕсли;
		СервисТегов.СнятьМетку(Пакет.Идентификатор, ИмяТега, Версия, Кто);
		Возврат Записано();
	КонецЕсли;

	Если Операция <> "yank" И Операция <> "unyank" Тогда
		// белый список операций: неизвестная не должна восстанавливать отозванную версию
		ВызватьИсключение Тексты.Текст("settings.package.versions.error.operation");
	КонецЕсли;

	// событие отзыва/восстановления публикует сам СервисВерсий — одна точка на оба пути отзыва
	СервисВерсий.ОтозватьВерсию(Пакет.Идентификатор, Версия, Операция = "yank", Кто);
	Возврат Записано();

КонецФункции

// Значение поля подтверждения снятия метки: его же печатает форма шага подтверждения.
//
// Возвращаемое значение:
//  Строка - ожидаемое значение подтверждения.
//
Функция ЗначениеПодтверждения() Экспорт
	Возврат "да";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сервер судит сам и не эхом ввода: присланное имя в ответ не уходит.
Процедура ТребоватьРучнойТег(Знач ПакетИдентификатор, Знач ИмяТега)

	Искомое = НРег(СокрЛП(Строка(ИмяТега)));
	Для Каждого Тег Из СервисТегов.РучныеТегиПакета(ПакетИдентификатор) Цикл
		Если НРег(СокрЛП(Строка(Тег.Имя))) = Искомое Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение Тексты.Текст("settings.package.versions.menu.tag.unknown");

КонецПроцедуры

Функция Записано()
	Возврат Новый Структура("Записано, Снятие", Истина, Неопределено);
КонецФункции

Функция Спросить(Знач Снятие)
	Возврат Новый Структура("Записано, Снятие", Ложь, Снятие);
КонецФункции

#КонецОбласти

&Прозвище("ПультВерсийПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	СервисВерсий = _СервисВерсий;
	СервисТегов = _СервисТегов;
	Тексты = _Тексты;

КонецПроцедуры
