// Готовые конвейеры с реальным адресом хаба — желудь модуля web-ui: справочная секция
// раздела «Доверенная публикация». Экран собирается элементами кита.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем СервисДоверия;     // СервисДоверияCI (публикация) — ожидаемая аудитория клейма aud
Перем Сниппеты;          // СниппетыКонвейеров (web-ui) — YAML конвейеров
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секция с готовыми конвейерами. Без известного адреса инсталляции секция объясняет,
// чего не хватает: сниппет с выдуманным адресом не заработает ни у кого.
//
// Параметры:
//  Пул - Пул - пул пакета.
//  Пакет - Пакет - пакет раздела.
//  АдресХаба - Строка - внешний адрес хаба; "" — не определён.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция Секция(Знач Пул, Знач Пакет, Знач АдресХаба) Экспорт

	// аудиторию спрашиваем у того же сервиса, который сверяет клейм aud: напечатать
	// вместо неё адрес хаба значило бы выдать пайплайн с гарантированным отказом
	Аудитория = СервисДоверия.ОжидаемаяАудитория();

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.package.ci-snippet.title"),
		Тексты.Текст("settings.package.ci-snippet.lead"),
		Образцы(Пул, Пакет, АдресХаба, Аудитория).Рендер());
	Секция.Иконка = "куб";
	// секция справочная: без «Действия» каркас не оборачивает её в форму
	Возврат Секция;

КонецФункции

#КонецОбласти

#Область Образцы

// Сниппет с выдуманным адресом не заработает ни у кого, поэтому вместо него секция
// честно называет, чего инсталляции не хватает.
Функция Образцы(Знач Пул, Знач Пакет, Знач АдресХаба, Знач Аудитория)

	Если НЕ ЗначениеЗаполнено(АдресХаба) Тогда
		Возврат Кит.Примечание(Тексты.Текст("settings.package.ci-snippet.unknown-host"));
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Аудитория) Тогда
		Возврат Кит.Примечание(Тексты.Текст("settings.package.ci-snippet.unknown-audience"));
	КонецЕсли;

	Результат = Кит.Холст();
	Результат.Добавить(ОбразецGitHub(Пул, Пакет, АдресХаба, Аудитория));
	Результат.Добавить(ОбразецGitLab(Пул, Пакет, АдресХаба, Аудитория));
	Возврат Результат;

КонецФункции

Функция ОбразецGitHub(Знач Пул, Знач Пакет, Знач АдресХаба, Знач Аудитория)
	Возврат Образец(Сниппеты.GitHubActions(АдресХаба, Пул.Имя, Пакет.Имя, Аудитория),
		Тексты.Текст("settings.package.ci-snippet.github"));
КонецФункции

Функция ОбразецGitLab(Знач Пул, Знач Пакет, Знач АдресХаба, Знач Аудитория)
	Возврат Образец(Сниппеты.GitLabCI(АдресХаба, Пул.Имя, Пакет.Имя, Аудитория),
		Тексты.Текст("settings.package.ci-snippet.gitlab"));
КонецФункции

// Кнопки копирования у образца нет: конвейер вставляют в файл репозитория целиком,
// а не выполняют строкой.
Функция Образец(Знач YAML, Знач Пояснение)
	Возврат Кит.БлокКоманды(Новый Структура("Команда, Пояснение, БезКопирования",
		YAML, Пояснение, Истина));
КонецФункции

#КонецОбласти

&Прозвище("ГотовыйКонвейерCI")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "СервисДоверияCI") _СервисДоверия,
	&Пластилин(Значение = "СниппетыКонвейеров") _Сниппеты,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	СервисДоверия = _СервисДоверия;
	Сниппеты = _Сниппеты;
	Тексты = _Тексты;

КонецПроцедуры
