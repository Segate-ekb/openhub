// Дом настроек «Пакет» — контроллер модуля web-ui: маршруты разделов, порог доступа
// и передача формы пульту.

Перем ГвардПакета;   // ГвардПакета (web-ui)
Перем Ответы;        // ОтветыНастроек (web-ui)
Перем Дом;           // ДомПакета (web-ui)
Перем ДомПула;       // ДомПула (web-ui) — хлебные крошки
Перем Витрина;       // ВитринаДомаПакета (web-ui) — секции разделов
Перем Пульт;         // ПультПакета (web-ui) — мутации разделов
Перем Гейт;          // ГейтФормы (web-ui) — метод запроса и токен формы
Перем Защита;        // ЗащитаCSRF (auth)
Перем СервисПакетов; // СервисПакетов (реестр) — пакет после мутации
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ТочкиМаршрута

// Точка маршрута «{pool}/{name}/settings» (GET).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//
&ТочкаМаршрута("{pool}/{name}/settings")
Процедура Обзор(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Вердикт = ГвардПакета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool, name);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	ОтдатьРаздел(Ответ, Вердикт, Дом.РазделПоУмолчанию(), Ложь, "", КукиЗапроса);

КонецПроцедуры

// Точка маршрута «{pool}/{name}/settings/{раздел}» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя из адреса.
//  раздел - Строка - ключ раздела.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  tag - Строка - имя тега из адреса (необязательный, по умолчанию "").
//  kind - Строка - вид тега из адреса: semver, regex либо manual (необязательный,
//         по умолчанию "").
//  saved_tag - Строка - имя только что сохранённого тега (необязательный, по умолчанию "").
//  form - Строка - "1" открывает окно выдачи роли сразу: это серверная дорога к форме
//         для движка, который не умеет команд кнопки (необязательный, по умолчанию "").
//
&ТочкаМаршрута("{pool}/{name}/settings/{раздел}")
Процедура Раздел(Ответ, pool, name, раздел, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	saved = "", tag = "", kind = "", saved_tag = "", form = "") Экспорт

	Вердикт = ГвардПакета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool, name);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Ключ = НРег(СокрЛП(Строка(раздел)));
	Если НЕ Дом.ЕстьРаздел(Ключ) Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт.Пользователь,
			Тексты.Текст("settings.package.error.section"), КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Вердикт, Ключ, ЗначениеЗаполнено(saved), "", КукиЗапроса, 200,
			Неопределено, Неопределено, saved_tag, kind, tag, ОкноПоАдресу(form));
		Возврат;
	КонецЕсли;

	Форма = Гейт.ПринятаяФорма(Ответ, Вердикт, "GET, POST", МетодЗапроса, ТелоЗапроса,
		КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Сохранить(Ответ, Вердикт, Ключ, Форма, КукиЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Сохранение

Процедура Сохранить(Ответ, Знач Вердикт, Знач Ключ, Знач Форма, Знач КукиЗапроса)

	Если НЕ Пульт.ПринимаетМутацию(Ключ) Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Попытка
		Итог = Пульт.Применить(Ключ, Вердикт.Пакет, Вердикт.Пользователь, Форма);
	Исключение
		ОтдатьРаздел(Ответ, Вердикт, Ключ, Ложь,
			Тексты.Шаблон("settings.package.error.save", Ответы.КраткоОшибка(ОписаниеОшибки())),
			КукиЗапроса, 400);
		Возврат;
	КонецПопытки;

	Если НЕ Итог.Записано Тогда
		// ответ вместо перенаправления: шаг подтверждения, проверка правила либо отказ;
		// отбитая форма выдачи возвращается ТЕМ ЖЕ окном — с набранным и помеченным полем
		ОтдатьРаздел(Ответ, Вердикт, Ключ, Ложь, Итог.Ошибка, КукиЗапроса, Итог.Код,
			Итог.Состояние, Итог.Снятие, "", "", "", Итог.Заведение, Итог.Предупреждение);
		Возврат;
	КонецЕсли;

	Ответ.Перенаправить(Дом.АдресРаздела(Вердикт.Пул.Имя, Вердикт.Пакет.Имя, Ключ)
		+ "?saved=1" + Итог.Хвост);

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач Ключ, Знач Сохранено, Знач Ошибка, Знач КукиЗапроса,
	Знач Статус = 200, Знач Конструктор = Неопределено, Знач Снятие = Неопределено,
	Знач СохранённыйТег = "", Знач ВидИзАдреса = "", Знач ТегИзАдреса = "",
	Знач Заведение = Неопределено, Знач Предупреждение = "")

	Пул = Вердикт.Пул;
	Пакет = СервисПакетов.ПакетПоИдентификатору(Вердикт.Пакет.Идентификатор);
	Если Пакет = Неопределено Тогда
		Пакет = Вердикт.Пакет;
	КонецЕсли;

	Уведомления = Ответы.УведомленияРаздела(Сохранено, Ошибка, Предупреждение);
	СоставКанала = Витрина.УведомлениеОСоставеКанала(Пакет.Идентификатор, СохранённыйТег);
	Если СоставКанала <> Неопределено Тогда
		Уведомления.Добавить(СоставКанала);
	КонецЕсли;

	Хлебные = Новый Массив();
	Хлебные.Добавить(Новый Структура("Подпись, Адрес", Пул.Имя, ДомПула.АдресПула(Пул.Имя)));
	Хлебные.Добавить(Новый Структура("Подпись, Адрес", Пакет.Имя, Дом.АдресПакета(Пул.Имя, Пакет.Имя)));
	Хлебные.Добавить(Новый Структура("Подпись", Тексты.Текст("settings.package.crumb")));

	Модель = Ответы.МодельДома(Дом, Пакет.Имя,
		Дом.Разделы(Пул.Имя, Пакет.Имя, Ключ, Вердикт.Пользователь, Пакет),
		Уведомления,
		Витрина.Секции(ПараметрыСекций(Вердикт, Пакет, Ключ,
			Защита.ТокенСессии(Вердикт.Сессия), Конструктор, Снятие, ВидИзАдреса, ТегИзАдреса,
			Заведение)),
		Хлебные);

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт.Пользователь, КукиЗапроса,
		Тексты.Шаблон("settings.package.tab", Пакет.Имя), Статус);

КонецПроцедуры

// Серверная дорога к форме для движка, который не умеет команд кнопки.
Функция ОкноПоАдресу(Знач ПризнакФормы)
	Возврат ?(Строка(ПризнакФормы) <> "1", Неопределено,
		Новый Структура("Открыта, Заполнение, Отказы", Истина, Неопределено, Новый Соответствие()));
КонецФункции

Функция ПараметрыСекций(Знач Вердикт, Знач Пакет, Знач Ключ, Знач Токен, Знач Конструктор,
	Знач Снятие, Знач ВидИзАдреса, Знач ТегИзАдреса, Знач Заведение)

	Результат = Новый Структура();
	Результат.Вставить("Ключ", Ключ);
	Результат.Вставить("Пул", Вердикт.Пул);
	Результат.Вставить("Пакет", Пакет);
	Результат.Вставить("Пользователь", Вердикт.Пользователь);
	Результат.Вставить("Токен", Токен);
	Результат.Вставить("Конструктор", Конструктор);
	Результат.Вставить("Снятие", Снятие);
	Результат.Вставить("ВидИзАдреса", ВидИзАдреса);
	Результат.Вставить("ТегИзАдреса", ТегИзАдреса);
	Результат.Вставить("Заведение", Заведение);
	Возврат Результат;

КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардПакета") _ГвардПакета,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомПакета") _Дом,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ВитринаДомаПакета") _Витрина,
	&Пластилин(Значение = "ПультПакета") _Пульт,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	ГвардПакета = _ГвардПакета;
	Ответы = _Ответы;
	Дом = _Дом;
	ДомПула = _ДомПула;
	Витрина = _Витрина;
	Пульт = _Пульт;
	Гейт = _Гейт;
	Защита = _Защита;
	СервисПакетов = _СервисПакетов;
	Тексты = _Тексты;

КонецПроцедуры
