// Список тегов пакета — желудь модуля web-ui: таблица каналов раздела «Теги»
// дома «Пакет». Экран собирается элементами кита.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем СервисТегов;       // СервисТегов (реестр) — каналы пакета и правила тегов
Перем Плашки;            // ПлашкаТега (web-ui) — плашка тега в его оформлении
Перем ФормаВизарда;      // ФормаКаналовПоУмолчанию (web-ui) — окно заведения трёх каналов
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секция со списком тегов пакета.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Адрес - Строка - адрес раздела (он же action форм строк).
//  Токен - Строка - CSRF-токен сессии.
//  Визард - Структура, Неопределено - состояние окна визарда (Открыта); Неопределено —
//           окно закрыто (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция Секция(Знач Пакет, Знач Адрес, Знач Токен, Знач Визард = Неопределено) Экспорт

	// раскладка одним проходом (СервисТегов.КаналыПакета): вызов ВерсияТега в цикле давал N+1
	Каналы = СервисТегов.КаналыПакета(Пакет.Идентификатор).Каналы;

	Тело = Кит.Холст();
	Тело.Добавить(ОкноВизарда(Каналы, Адрес, Токен, Визард));
	Тело.Добавить(ТаблицаКаналов(Каналы, Адрес, Токен));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.package.tags.title"),
		Тексты.Текст("settings.package.tags.lead"), Тело.Рендер());
	Секция.Иконка = "тег";
	Возврат Секция;

КонецФункции

#КонецОбласти

#Область ЗаведениеКаналовПоУмолчанию

// Визард предлагается только пакету, у которого каналов ещё нет: там, где мейнтейнер
// уже вёл каналы сам, предложение из коробки — не помощь, а шум.
Функция ОкноВизарда(Знач Каналы, Знач Адрес, Знач Токен, Знач Визард)

	Если Каналы.Количество() > 0 Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Модель = Новый Структура("Адрес, Токен", Адрес, Токен);
	Если Визард <> Неопределено Тогда
		Модель.Вставить("Открыта", Визард.Открыта);
	КонецЕсли;

	Возврат ФормаВизарда.Окно(Модель);

КонецФункции

#КонецОбласти

#Область ТаблицаКаналов

Функция ТаблицаКаналов(Знач Каналы, Знач Адрес, Знач Токен)

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.tags.col.tag")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.tags.col.mode")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.tags.col.rule")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.tags.col.version")));
	Таблица.Добавить(Кит.Колонка());

	Для Каждого Канал Из Каналы Цикл
		Таблица.Добавить(ЗаписьКанала(Канал, Адрес, Токен));
	КонецЦикла;

	Таблица.Пусто().Добавить(Кит.Примечание(Тексты.Текст("settings.package.tags.empty"), "пусто"));
	Возврат Таблица;

КонецФункции

Функция ЗаписьКанала(Знач Канал, Знач Адрес, Знач Токен)

	Тег = Канал.Тег;

	Запись = Кит.Запись();
	Запись.Добавить(ЯчейкаТега(Тег));
	Запись.Добавить(ЯчейкаРежима(Тег));
	Запись.Добавить(ЯчейкаПравила(СервисТегов.ПравилоИзТега(Тег)));
	Запись.Добавить(ЯчейкаОтдаваемойВерсии(Канал.Отдаваемая));
	Запись.Добавить(ЯчейкаДействий(Адрес, Токен, Тег));
	Возврат Запись;

КонецФункции

#КонецОбласти

#Область ЯчейкиКанала

Функция ЯчейкаТега(Знач Тег)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Плашки.Канал(Тег));
	Ячейка.Добавить(ОтметкаСнятогоЗапрета(Тег));
	Возврат Ячейка;

КонецФункции

// Запрет повторной публикации включён у всех тегов, поэтому в строке отмечается обратное:
// канал, номера которого разрешено переиздавать, — редкое и опасное состояние, и видеть
// его надо не заходя в конструктор.
Функция ОтметкаСнятогоЗапрета(Знач Тег)

	Если НЕ СервисТегов.ЗапретСнят(Тег) Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Возврат Кит.Плашка(Новый Структура("Текст, Вид",
		Тексты.Текст("settings.package.tags.repush.allowed"), "warn"));

КонецФункции

Функция ЯчейкаРежима(Знач Тег)
	Возврат ЯчейкаЗначения(Строка(Тег.Режим));
КонецФункции

Функция ЯчейкаПравила(Знач Правило)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Код(ВыражениеПравила(Правило)));
	Ячейка.Добавить(ПредупреждениеПравила(Правило));
	Возврат Ячейка;

КонецФункции

Функция ВыражениеПравила(Знач Правило)
	Возврат ?(Правило = Неопределено, Тексты.Текст("settings.package.tags.none"),
		Правило.Выражение);
КонецФункции

// Правило, у которого домен нашёл подвох, объясняется прямо в строке: без этого канал
// выглядит настроенным, а отдаёт не то.
Функция ПредупреждениеПравила(Знач Правило)

	Если Правило = Неопределено ИЛИ ПустаяСтрока(Правило.Предупреждение()) Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Возврат Кит.Уведомление(Новый Структура("Текст, Вид", Правило.Предупреждение(), "warn"));

КонецФункции

Функция ЯчейкаОтдаваемойВерсии(Знач Версия)
	Возврат ЯчейкаЗначения(?(Версия = Неопределено,
		Тексты.Текст("settings.package.tags.none"), Строка(Версия.Версия)));
КонецФункции

Функция ЯчейкаДействий(Знач Адрес, Знач Токен, Знач Тег)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(КнопкаПравки(Адрес, Тег));
	Ячейка.Добавить(ФормаТегаПоУмолчанию(Адрес, Токен, Тег));
	Ячейка.Добавить(ФормаУдаления(Адрес, Токен, Тег));
	Возврат Ячейка;

КонецФункции

Функция ЯчейкаЗначения(Знач Текст)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Текст(Текст));
	Возврат Ячейка;

КонецФункции

#КонецОбласти

#Область ДействияСтроки

// Правка — обычная ссылка: она открывает тот же конструктор, заполненный тегом.
Функция КнопкаПравки(Знач Адрес, Знач Тег)

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Размер",
		Тексты.Текст("settings.package.tags.button.edit"), АдресПравки(Адрес, Тег),
		"вторичная", "малый"));

КонецФункции

// Адрес правки тега: тот же конструктор, но с именем существующего тега. Отдельного
// экрана у правки нет — заводить и править один и тот же тег должно быть одним действием.
// Вид в адресе не нужен: у существующего тега он свой, и конструктор берёт его из тега.
Функция АдресПравки(Знач Адрес, Знач Тег)

	Возврат Адрес + "?tag="
		+ КодироватьСтроку(Строка(Тег.Имя), СпособКодированияСтроки.КодировкаURL);

КонецФункции

Функция ФормаТегаПоУмолчанию(Знач Адрес, Знач Токен, Знач Тег)
	Возврат ФормаОперации(Адрес, Токен, "по_умолчанию", Тег.Имя,
		Тексты.Текст("settings.package.tags.button.default"));
КонецФункции

Функция ФормаУдаления(Знач Адрес, Знач Токен, Знач Тег)
	Возврат ФормаОперации(Адрес, Токен, "удалить", Тег.Имя,
		Тексты.Текст("settings.package.tags.button.remove"));
КонецФункции

Функция ФормаОперации(Знач Адрес, Знач Токен, Знач Операция, Знач ИмяТега, Знач Подпись)

	Форма = Кит.Форма(Адрес, Токен, "строкой");
	Форма.Добавить(Кит.СкрытоеПоле("операция", Операция));
	Форма.Добавить(Кит.СкрытоеПоле("имя", ИмяТега));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Подпись, "вторичная", "малый")));
	Возврат Форма;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаТеговПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "ПлашкаТега") _Плашки,
	&Пластилин(Значение = "ФормаКаналовПоУмолчанию") _ФормаВизарда,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	СервисТегов = _СервисТегов;
	Плашки = _Плашки;
	ФормаВизарда = _ФормаВизарда;
	Тексты = _Тексты;

КонецПроцедуры
