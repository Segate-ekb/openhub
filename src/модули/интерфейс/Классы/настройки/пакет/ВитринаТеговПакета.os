// Список тегов пакета — желудь модуля web-ui: таблица каналов раздела «Теги»
// дома «Пакет». Экран собирается элементами кита.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем СервисТегов;       // СервисТегов (реестр) — каналы пакета и правила тегов
Перем Плашки;            // ПлашкаТега (web-ui) — плашка тега в его оформлении
Перем ФормаВизарда;      // ФормаКаналовПоУмолчанию (web-ui) — окно заведения трёх каналов
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Бланки;            // БланкРаздела (web-ui) — адрес и токен раздела, формы на них

#Область ПубличныйИнтерфейс

// Секция со списком тегов пакета.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Бланк - Структура - бланк раздела (БланкРаздела): адрес форм и токен сессии.
//  Визард - Структура, Неопределено - состояние окна визарда (Открыта); Неопределено —
//           окно закрыто (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция Секция(Знач Пакет, Знач Бланк, Знач Визард = Неопределено) Экспорт

	// раскладка одним проходом (СервисТегов.КаналыПакета): вызов ВерсияТега в цикле давал N+1
	Каналы = СервисТегов.КаналыПакета(Пакет.Идентификатор).Каналы;

	Тело = Кит.Холст();
	Тело.Добавить(ОкноВизарда(Каналы, Бланк, Визард));
	Тело.Добавить(ТаблицаКаналов(Каналы, Бланк));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.package.tags.title"),
		Тексты.Текст("settings.package.tags.lead"), Тело.Рендер());
	Секция.Иконка = "тег";
	Возврат Секция;

КонецФункции

#КонецОбласти

#Область ЗаведениеКаналовПоУмолчанию

// Только пакету без каналов: там, где мейнтейнер вёл их сам, предложение — шум.
Функция ОкноВизарда(Знач Каналы, Знач Бланк, Знач Визард)

	Если Каналы.Количество() > 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Модель = Новый Структура("Адрес, Токен", Бланки.Адрес(Бланк), Бланк.Токен);
	Если Визард <> Неопределено Тогда
		Модель.Вставить("Открыта", Визард.Открыта);
	КонецЕсли;

	Возврат ФормаВизарда.Окно(Модель);

КонецФункции

#КонецОбласти

#Область ТаблицаКаналов

Функция ТаблицаКаналов(Знач Каналы, Знач Бланк)

	// «карточками»: на узком экране запись перестаёт быть рядом ячеек и становится
	// карточкой — иначе шесть столбцов уезжают за край и таблица получает прокрутку
	Таблица = Кит.Таблица("карточками");
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.tags.col.tag")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.tags.col.mode")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.tags.col.rule")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.tags.col.version")));
	Таблица.Добавить(Кит.Колонка());

	Для Каждого Канал Из Каналы Цикл
		Таблица.Добавить(ЗаписьКанала(Канал, Бланк));
	КонецЦикла;

	Таблица.Пусто().Добавить(Кит.Примечание(Тексты.Текст("settings.package.tags.empty"), "пусто"));
	Возврат Таблица;

КонецФункции

Функция ЗаписьКанала(Знач Канал, Знач Бланк)

	Тег = Канал.Тег;

	Запись = Кит.Запись(ВидЗаписи(Тег));
	Запись.Добавить(ЯчейкаТега(Тег));
	Запись.Добавить(ЯчейкаРежима(Тег));
	Запись.Добавить(ЯчейкаПравила(Тег));
	Запись.Добавить(ЯчейкаОтдаваемойВерсии(Канал.Отдаваемая));
	Запись.Добавить(ЯчейкаДействий(Бланк, Тег));
	Возврат Запись;

КонецФункции

Функция ВидЗаписи(Знач Тег)
	Возврат ?(Тег.ПоУмолчанию = Истина, "выделенная", "");
КонецФункции

#КонецОбласти

#Область ЯчейкиКанала

Функция ЯчейкаТега(Знач Тег)

	// пометка основного едет ВМЕСТЕ с тегом (Плашки.Канал) — так канал помечен на всех
	// экранах хаба. Своего столбца у неё больше нет: в карточке он оставался бы строкой
	// из одного значка, объясняющего сам себя только на широком экране
	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Плашки.Канал(Тег));
	Ячейка.Добавить(ОтметкаСнятогоЗапрета(Тег));
	Возврат Ячейка;

КонецФункции

// Отмечается обратное: разрешённое переиздание — редкое и опасное состояние.
Функция ОтметкаСнятогоЗапрета(Знач Тег)

	Если НЕ СервисТегов.ЗапретСнят(Тег) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Плашка(Новый Структура("Текст, Вид",
		Тексты.Текст("settings.package.tags.repush.allowed"), "warn"));

КонецФункции

Функция ЯчейкаРежима(Знач Тег)
	Возврат ЯчейкаЗначения(Строка(Тег.Режим));
КонецФункции

Функция ЯчейкаПравила(Знач Тег)

	Правило = СервисТегов.ПравилоИзТега(Тег);

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(ПравилоКанала(Тег, Правило));
	Ячейка.Добавить(ПредупреждениеПравила(Правило));
	Возврат Ячейка;

КонецФункции

// Выражение свёрнуто <details>: развёрнутая регулярка распирала колонку и ломала таблицу.
Функция ПравилоКанала(Знач Тег, Знач Правило)

	Если Правило = Неопределено Тогда
		Возврат Кит.Код(Тексты.Текст("settings.package.tags.none"));
	КонецЕсли;

	Свёрнутое = Кит.Раскрывашка("подробность");
	Свёрнутое.Подпись(Тексты.Шаблон("settings.package.tags.rule.about", Строка(Тег.Имя)));
	Свёрнутое.Шапка().Добавить(Кит.Текст(Тексты.Текст("settings.package.tags.rule.show")));
	Свёрнутое.Добавить(Кит.Код(Правило.Выражение));
	Возврат Свёрнутое;

КонецФункции

// Без объяснения в строке канал выглядит настроенным, а отдаёт не то.
Функция ПредупреждениеПравила(Знач Правило)

	Если Правило = Неопределено ИЛИ ПустаяСтрока(Правило.Предупреждение()) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Уведомление(Новый Структура("Текст, Вид", Правило.Предупреждение(), "warn"));

КонецФункции

Функция ЯчейкаОтдаваемойВерсии(Знач Версия)
	Возврат ЯчейкаЗначения(?(Версия = Неопределено,
		Тексты.Текст("settings.package.tags.none"), Строка(Версия.Версия)));
КонецФункции

Функция ЯчейкаДействий(Знач Бланк, Знач Тег)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(МенюКанала(Бланк, Тег));
	Возврат Ячейка;

КонецФункции

Функция ЯчейкаЗначения(Знач Текст)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Текст(Текст));
	Возврат Ячейка;

КонецФункции

#КонецОбласти

#Область ДействияСтроки

// Формы едут в панель готовыми фрагментами: слота у компонента «меню» в ките пока нет.
Функция МенюКанала(Знач Бланк, Знач Тег)

	Пункты = Новый Массив();
	Пункты.Добавить(ПунктПравки(Бланк, Тег));
	Пункты.Добавить(Новый Структура("HTML", ФормаТегаПоУмолчанию(Бланк, Тег).Рендер()));
	Пункты.Добавить(Новый Структура("HTML", ФормаУдаления(Бланк, Тег).Рендер()));

	Возврат Кит.Меню(Новый Структура("Подпись, Пункты",
		Тексты.Шаблон("settings.package.tags.menu.title", Строка(Тег.Имя)), Пункты));

КонецФункции

// Правка — обычная ссылка: она открывает тот же конструктор, заполненный тегом.
Функция ПунктПравки(Знач Бланк, Знач Тег)

	Возврат Новый Структура("Подпись, Адрес, Иконка",
		Тексты.Текст("settings.package.tags.button.edit"), АдресПравки(Бланк, Тег), "тег");

КонецФункции

// Тот же конструктор с именем существующего тега; вид он берёт из самого тега.
Функция АдресПравки(Знач Бланк, Знач Тег)

	Возврат Бланки.Адрес(Бланк) + "?tag="
		+ КодироватьСтроку(Строка(Тег.Имя), СпособКодированияСтроки.КодировкаURL);

КонецФункции

Функция ФормаТегаПоУмолчанию(Знач Бланк, Знач Тег)
	Возврат ФормаОперации(Бланк, "по_умолчанию", Тег.Имя,
		Тексты.Текст("settings.package.tags.button.default"));
КонецФункции

Функция ФормаУдаления(Знач Бланк, Знач Тег)
	Возврат ФормаОперации(Бланк, "удалить", Тег.Имя,
		Тексты.Текст("settings.package.tags.button.remove"));
КонецФункции

Функция ФормаОперации(Знач Бланк, Знач Операция, Знач ИмяТега, Знач Подпись)

	Форма = Бланки.Форма(Бланк, "", "меню");
	Форма.Добавить(Кит.СкрытоеПоле("операция", Операция));
	Форма.Добавить(Кит.СкрытоеПоле("имя", ИмяТега));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Подпись, "вторичная", "малый")));
	Возврат Форма;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаТеговПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "ПлашкаТега") _Плашки,
	&Пластилин(Значение = "ФормаКаналовПоУмолчанию") _ФормаВизарда,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "БланкРаздела") _Бланки) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	СервисТегов = _СервисТегов;
	Плашки = _Плашки;
	ФормаВизарда = _ФормаВизарда;
	Тексты = _Тексты;
	Бланки = _Бланки;

КонецПроцедуры
