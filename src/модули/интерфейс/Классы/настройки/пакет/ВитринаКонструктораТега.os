// Конструктор тега — желудь модуля web-ui: секция заведения, правки и проверки правила
// раздела «Теги» дома «Пакет».

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем Конструкторы;      // КонструкторТега (web-ui) — словарь видов и разбор состояния
Перем Оформление;        // ВыборОформленияТега (web-ui) — списки стиля и значка
Перем Плашки;            // ПлашкаТега (web-ui) — холст студии и её живое превью
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Заведение, правка и проверка правила — ОДНА секция с одной основной кнопкой: плашка
// рисуется в реальном времени, поэтому отдельного шага «сначала посмотрите» больше нет.
//
// Параметры:
//  Адрес - Строка - адрес раздела (он же action формы).
//  Токен - Строка - CSRF-токен сессии.
//  Конструктор - Структура - состояние конструктора тега.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция Секция(Знач Адрес, Знач Токен, Знач Конструктор) Экспорт

	Тело = Кит.Холст();
	Тело.Добавить(Студия(Конструктор));
	Тело.Добавить(КнопкаПроверкиПравила(Конструктор));
	Тело.Добавить(ИтогПроверки(Конструктор));
	Тело.Добавить(Кит.Примечание(Тексты.Текст("settings.package.tag-new.save.lead")));
	// смена режима у СУЩЕСТВУЮЩЕГО тега меняет состав канала — говорим об этом ДО записи
	Тело.Добавить(ПредупреждениеОСменеРежима(Конструктор));

	Секция = РендерерНастроек.Секция(ЗаголовокКонструктора(Конструктор),
		Тексты.Текст("settings.package.tag-new.lead"), Тело.Рендер());
	Секция.Иконка = "тег";
	Секция.Действие = Адрес;
	Секция.Токен = Токен;
	Секция.Кнопка = Тексты.Текст("settings.package.tag-new.button");
	Секция.ИконкаКнопки = "сохранить";
	Секция.ИмяКнопки = "операция";
	Секция.ЗначениеКнопки = "сохранить";
	Секция.Опасная = Конструкторы.СменаРежима(Конструктор);
	Возврат Секция;

КонецФункции

#КонецОбласти

#Область Разметка

// Заведение и правка — один экран, но называются по-разному: имя тега участвует в адресе.
Функция ЗаголовокКонструктора(Знач Конструктор)

	Если Конструктор.Правится Тогда
		Возврат Тексты.Текст("settings.package.tag-new.edit.title");
	КонецЕсли;

	Возврат Тексты.Текст("settings.package.tag-new.title");

КонецФункции

// Признак `sets` называет скрипту поле, чьё значение переключает наборы правила.
Функция Студия(Знач Конструктор)

	Результат = Плашки.Студия();

	Работа = Результат.Добавить(Кит.Область("работа").Признак("sets", "вид"));
	СобратьПоля(Работа, Конструктор);

	Результат.Добавить(Плашки.Предпросмотр(Конструктор));
	Возврат Результат;

КонецФункции

// Стоит в дереве ПЕРЕД основной: отправка по Enter обязана попасть в проверку, а не в запись.
Функция КнопкаПроверкиПравила(Знач Конструктор)

	Если Конструкторы.ЭтоРучной(Конструктор) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Результат = Кит.Ряд("справа");
	Результат.Добавить(Кит.Кнопка(Новый Структура(
		"Подпись, Вариант, Размер, Иконка, Имя, Значение, БезВалидации",
		Тексты.Текст("settings.package.tag-new.check.button"), "вторичная", "малый", "поиск",
		"операция", "проверить", Истина)));
	Возврат Результат;

КонецФункции

// Левая колонка студии: имя, вид, наборы полей правила и оформление плашки.
Процедура СобратьПоля(Знач Поля, Знач Конструктор)

	Поля.Добавить(Кит.Поле(Новый Структура("Имя, Метка, Плейсхолдер, Значение",
		"имя", Тексты.Текст("settings.package.tag-new.name.label"), "lts", Конструктор.Имя)));
	Поля.Добавить(ВыборВида(Конструктор));
	Поля.Добавить(НаборПравила(Конструктор, Конструкторы.ВидSemver(), "^1.2",
		Тексты.Текст("settings.package.tag-new.rule.semver.label"),
		Тексты.Текст("settings.package.tag-new.rule.semver.hint")));
	Поля.Добавить(НаборПравила(Конструктор, Конструкторы.ВидRegex(), "^1\\.2\\..*$",
		Тексты.Текст("settings.package.tag-new.rule.regex.label"),
		Тексты.Текст("settings.package.tag-new.rule.regex.hint")));

	// оформление — свойство ТЕГА, а не вида, поэтому стоит при любом виде
	Поля.Добавить(Оформление.Поля(Конструктор));
	Поля.Добавить(ТумблерТегаПоУмолчанию(Конструктор));
	Поля.Добавить(ТумблерЗапретаПерезаписи(Конструктор));

КонецПроцедуры

// У тега, который уже является основным, тумблер включён и заблокирован: снять его здесь нечем.
Функция ТумблерТегаПоУмолчанию(Знач Конструктор)

	Возврат Кит.Тумблер(Новый Структура(
		"Имя, Метка, Включено, Заблокировано, Подсказка",
		"по_умолчанию", Тексты.Текст("settings.package.tag-new.default.label"),
		Конструктор.ПоУмолчанию ИЛИ Конструктор.БылоПоУмолчанию,
		Конструктор.БылоПоУмолчанию,
		Тексты.Текст("settings.package.tag-new.default.hint")));

КонецФункции

// Снятый запрет — решение с последствиями для чужих установок, и тумблер объясняет цену.
Функция ТумблерЗапретаПерезаписи(Знач Конструктор)

	Возврат Кит.Тумблер(Новый Структура(
		"Имя, Метка, Включено, Подсказка",
		"запрет_перезаписи", Тексты.Текст("settings.package.tag-new.repush.label"),
		Конструктор.ЗапретПерезаписи,
		Тексты.Текст("settings.package.tag-new.repush.hint")));

КонецФункции

// Невыбранные наборы стоят `disabled hidden`: браузер их не отправляет, а скрипт переключает.
Функция НаборПравила(Знач Конструктор, Знач Тип, Знач Плейсхолдер, Знач Метка, Знач Подсказка)

	Выбран = ?(Конструкторы.ЭтоРучной(Конструктор), "", Конструктор.Тип) = Тип;

	Результат = Кит.Группа("", "простая").Признак("set", Тип);
	Если НЕ Выбран Тогда
		Результат.Отключить().Скрыть();
	КонецЕсли;

	// введённое возвращается только СВОЕМУ типу: у regex и semver выражение разное
	Результат.Добавить(Кит.Поле(Новый Структура(
		"Имя, Метка, Плейсхолдер, Подсказка, Значение",
		"правило", Метка, Плейсхолдер, Подсказка, ?(Выбран, Конструктор.Правило, ""))));
	Возврат Результат;

КонецФункции

// Один выбор вместо пары «режим + тип правила»: человек принимает одно решение, а не два.
Функция ВыборВида(Знач Конструктор)

	Варианты = Новый Массив();
	Варианты.Добавить(Новый Структура("Значение, Подпись", Конструкторы.ВидSemver(),
		Тексты.Текст("settings.package.tag-new.type.semver")));
	Варианты.Добавить(Новый Структура("Значение, Подпись", Конструкторы.ВидRegex(),
		Тексты.Текст("settings.package.tag-new.type.regex")));
	Варианты.Добавить(Новый Структура("Значение, Подпись", Конструкторы.ВидРучной(),
		Тексты.Текст("settings.package.tag-new.mode.manual")));

	Возврат Кит.Поле(Новый Структура(
		"Имя, Тип, Значение, Метка, Подсказка, Варианты",
		"вид", "выбор", Конструкторы.КодВида(Конструктор.Режим, Конструктор.Тип),
		Тексты.Текст("settings.package.tag-new.mode.label"),
		Тексты.Текст("settings.package.tag-new.mode.hint"), Варианты));

КонецФункции

// В Ошибке лежит готовый пользовательский текст: общей приставки у причин отказа нет.
Функция ИтогПроверки(Знач Конструктор)

	Если ЗначениеЗаполнено(Конструктор.Ошибка) Тогда
		Возврат Кит.Уведомление(Новый Структура("Текст, Вид", Конструктор.Ошибка, "error"));
	КонецЕсли;

	Если Конструктор.Предпросмотр = Неопределено Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Предпросмотр = Конструктор.Предпросмотр;
	Если Предпросмотр.Совпадения.Количество() = 0 Тогда
		Возврат Кит.Примечание(Тексты.Текст("settings.package.tag-new.preview.empty"));
	КонецЕсли;

	Итог = Кит.Холст();
	Итог.Добавить(Кит.Примечание())
		.Добавить(Кит.Шаблон(Тексты.Текст("settings.package.tag-new.preview.version")))
		.Добавить(Кит.Код(Строка(Предпросмотр.Версия)));

	Итог.Добавить(Кит.Примечание())
		.Добавить(Кит.Шаблон(Тексты.Текст("settings.package.tag-new.preview.matches")))
		.Добавить(СовпавшиеВерсии(Предпросмотр));

	Если ЗначениеЗаполнено(Предпросмотр.Предупреждение) Тогда
		Итог.Добавить(Кит.Уведомление(
			Новый Структура("Текст, Вид", Предпросмотр.Предупреждение, "warn")));
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Отозванная несёт свою плашку: правило её захватило, а публиковаться по ней уже нельзя.
Функция СовпавшиеВерсии(Знач Предпросмотр)

	Отозванные = Новый Соответствие();
	Для Каждого СтрокаОтозванной Из Предпросмотр.Отозванные Цикл
		Отозванные.Вставить(Строка(СтрокаОтозванной), Истина);
	КонецЦикла;

	Результат = Кит.Холст();
	Для Каждого СтрокаВерсии Из Предпросмотр.Совпадения Цикл
		Если Результат.Дети().Количество() > 0 Тогда
			Результат.Добавить(Кит.Текст(", "));
		КонецЕсли;
		Результат.Добавить(Кит.Код(Строка(СтрокаВерсии)));
		Если Отозванные.Получить(Строка(СтрокаВерсии)) = Истина Тогда
			Результат.Добавить(Кит.Плашка(Новый Структура("Текст, Вид",
				Тексты.Текст("settings.package.versions.yanked"), "warn")));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПредупреждениеОСменеРежима(Знач Конструктор)

	Если НЕ Конструкторы.СменаРежима(Конструктор) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Если Конструкторы.ЭтоРучной(Конструктор) Тогда
		Текст = Тексты.Шаблон("settings.package.tag-new.save.switch.manual", Конструктор.Имя);
	Иначе
		Текст = Тексты.Шаблон("settings.package.tag-new.save.switch.rule", Конструктор.Имя);
	КонецЕсли;

	Возврат Кит.Уведомление(Новый Структура("Текст, Вид", Текст, "warn"));

КонецФункции

#КонецОбласти

&Прозвище("ВитринаКонструктораТега")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "КонструкторТега") _Конструкторы,
	&Пластилин(Значение = "ВыборОформленияТега") _Оформление,
	&Пластилин(Значение = "ПлашкаТега") _Плашки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Конструкторы = _Конструкторы;
	Оформление = _Оформление;
	Плашки = _Плашки;
	Тексты = _Тексты;

КонецПроцедуры
