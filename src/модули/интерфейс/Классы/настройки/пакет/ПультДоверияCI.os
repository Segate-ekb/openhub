// Пульт доверенных конвейеров — желудь модуля web-ui: заведение и снятие доверия
// из дома «Пакет». Поля заведения не перечисляются здесь: их называет ОБЪЯВЛЕНИЕ формы,
// оно же приводит значения и формулирует отказ по полю. Порог операций — в СервисДоверияCI.

Перем РазборФормы;   // РазборФормы (web-ui)
Перем Объявления;    // ФормаДоверияCI (web-ui) — объявление полей формы заведения
Перем СервисДоверия; // СервисДоверияCI (публикация) — доверить, отозвать, порог права
Перем Числа;         // ПриведениеЧисел (основа) — терпимое чтение идентификатора
Перем КороткаяФорма; // КороткаяФормаДоверия (публикация) — разбор ссылки и короткие поля
Перем Виды;          // ВидРефаДоверия (публикация) — вид рефа, предлагаемый по значению
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Применяет операцию раздела «доверенная публикация» дома «Пакет».
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса (порог права судит сервис).
//  Пакет - Пакет - пакет раздела.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - Ошибка (Строка: "" — операция выполнена, иначе текст отказа для экрана),
//              Код (Число: код отказа домена, 0 при успехе),
//              Подтвердить (Строка: идентификатор записи, снятие которой нужно
//              подтвердить, "" — не нужно), Провайдер (Строка: тип репозитория, на который
//              переключить форму), Заполнение (Структура, Соответствие, Неопределено:
//              чем заполнить поля формы заново), Отказы (Соответствие: ключ поля -> текст
//              отказа), Заведение (Булево: операция относится к форме заведения, значит
//              страницу надо вернуть с ОТКРЫТЫМ окном).
//
Функция Применить(Знач Принципал, Знач Пакет, Знач Форма) Экспорт

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, "операция")));

	Если Операция = "доверить" Тогда
		Возврат Доверить(Принципал, Пакет, Форма);
	ИначеЕсли Операция = "отозвать" Тогда
		Возврат Отозвать(Принципал, Пакет, Форма);
	ИначеЕсли Операция = "разобрать" Тогда
		Возврат Разобрать(Форма);
	КонецЕсли;

	// белый список операций: неизвестная не должна попадать в чужую ветку
	Возврат Отказ(Тексты.Текст("settings.package.ci.error.operation"), 400);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Тип репозитория читается СЫРЫМ: от него зависит, какое объявление строить, поэтому
// он старше объявления и в него не входит.
Функция Доверить(Знач Принципал, Знач Пакет, Знач Форма)

	Провайдер = РазборФормы.Поле(Форма, "провайдер");

	Разбор = Объявления.Объявление(Провайдер).Разобрать(Форма);
	Если НЕ Разбор.Принято Тогда
		Итог = Отказ(Разбор.Отказ, 400);
		Итог.Отказы = Разбор.Отказы;
		Итог.Заполнение = Разбор.Показ;
		Итог.Заведение = Истина;
		Возврат Итог;
	КонецЕсли;

	Значения = Разбор.Значения;
	Итог = СервисДоверия.Доверить(Принципал, Пакет,
		Провайдер,
		// издатель в форме не спрашивается: пустой выводится из типа репозитория,
		// а выбранный в «дополнительно» едет как есть
		Значением(Значения, "издатель"),
		Значением(Значения, "репозиторий"),
		Значением(Значения, "конвейер"),
		Значением(Значения, "реф"),
		Значением(Значения, "вид_рефа"));

	Если Итог.Успех Тогда
		Возврат Успех();
	КонецЕсли;

	Отбито = Отказ(Тексты.Шаблон("settings.package.ci.error.trust", Итог.Сообщение), Итог.Код);
	Отбито.Заполнение = Разбор.Показ;
	Отбито.Заведение = Истина;
	Возврат Отбито;

КонецФункции

// Разбор ссылки формы НЕ создаёт записи: он только заполняет поля, а решение принимает
// человек — из ссылки нельзя надёжно отличить ветку от тега и от коммита.
Функция Разобрать(Знач Форма)

	Ссылка = СокрЛП(РазборФормы.Поле(Форма,
		Объявления.Объявление("").ИмяПоля("ссылка")));

	// пустая ссылка — обычный исход неявной отправки формы по Enter, и говорить о ней
	// «не разобрана» значит объяснять не то
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Отбито = Отказ(Тексты.Текст("settings.package.ci.error.link.empty"), 400);
		Отбито.Заведение = Истина;
		Возврат Отбито;
	КонецЕсли;

	Разбор = КороткаяФорма.РазобратьСсылку(Ссылка);
	Если НЕ Разбор.Успех Тогда
		Отбито = Отказ(Тексты.Текст("settings.package.ci.error.link"), 400);
		Отбито.Заведение = Истина;
		Возврат Отбито;
	КонецЕсли;

	Заполнение = Новый Структура();
	Заполнение.Вставить("репозиторий", Разбор.Репозиторий);
	Заполнение.Вставить("конвейер", КороткаяФорма.ЗначениеДляФормы(Разбор.Провайдер, Разбор.Конвейер));
	Заполнение.Вставить("реф", Разбор.Реф);
	// ссылка ветку от тега не отличает, поэтому вид предлагается по самому значению
	// («v1.2.0» — тег, «develop» — ветка) и остаётся на глазах у человека
	Заполнение.Вставить("вид_рефа", Виды.ПоЗначению(Разбор.Реф));
	// издатель приезжает из самого разбора: хост ссылки уже сверен со списком хаба
	Заполнение.Вставить("издатель", Разбор.Издатель);

	Результат = Успех();
	Результат.Провайдер = Разбор.Провайдер;
	Результат.Заполнение = Заполнение;
	Результат.Заведение = Истина;
	Возврат Результат;

КонецФункции

// Первый POST только спрашивает: снятие возвращает конвейеру отказ на следующем же push.
// Подтверждение эхом повторяет идентификатор, поэтому форма одной записи не снимает соседнюю.
Функция Отозвать(Знач Принципал, Знач Пакет, Знач Форма)

	// строгое чтение: «5.7» не должно молча превращаться в запись 5, а подтверждение —
	// спрашивать про запись, которой нет
	Присланный = СокрЛП(РазборФормы.Поле(Форма, "доверие"));
	Идентификатор = Числа.ЦелоеИлиНеопределено(Присланный);
	Если Идентификатор = Неопределено ИЛИ Идентификатор <= 0 Тогда
		Возврат Отказ(Тексты.Текст("settings.package.ci.error.id"), 400);
	КонецЕсли;

	Если СокрЛП(РазборФормы.Поле(Форма, "подтверждение")) <> Присланный Тогда
		Результат = Успех();
		Результат.Подтвердить = Присланный;
		Возврат Результат;
	КонецЕсли;

	Итог = СервисДоверия.ОтозватьДоверие(Принципал, Пакет, Идентификатор);
	Возврат ?(Итог.Успех, Успех(),
		Отказ(Тексты.Шаблон("settings.package.ci.error.revoke", Итог.Сообщение), Итог.Код));

КонецФункции

Функция Значением(Знач Значения, Знач Ключ)
	Найденное = Значения.Получить(Ключ);
	Возврат ?(Найденное = Неопределено, "", Строка(Найденное));
КонецФункции

Функция Успех()
	Возврат Итог("", 0);
КонецФункции

Функция Отказ(Знач Сообщение, Знач Код)
	Возврат Итог(Сообщение, Код);
КонецФункции

Функция Итог(Знач Сообщение, Знач Код)

	Результат = Новый Структура();
	Результат.Вставить("Ошибка", Сообщение);
	Результат.Вставить("Код", Код);
	Результат.Вставить("Подтвердить", "");
	Результат.Вставить("Провайдер", "");
	Результат.Вставить("Заполнение", Неопределено);
	Результат.Вставить("Отказы", Новый Соответствие());
	Результат.Вставить("Заведение", Ложь);
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ПультДоверияCI")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ФормаДоверияCI") _Объявления,
	&Пластилин(Значение = "СервисДоверияCI") _СервисДоверия,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "КороткаяФормаДоверия") _КороткаяФорма,
	&Пластилин(Значение = "ВидРефаДоверия") _Виды,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	Объявления = _Объявления;
	СервисДоверия = _СервисДоверия;
	Числа = _Числа;
	КороткаяФорма = _КороткаяФорма;
	Виды = _Виды;
	Тексты = _Тексты;

КонецПроцедуры
