// Подписки пакета — контроллер модуля web-ui.

Перем ГвардПакета;    // ГвардПакета (web-ui)
Перем Ответы;         // ОтветыНастроек (web-ui)
Перем Дом;            // ДомПакета (web-ui)
Перем ДомПула;        // ДомПула (web-ui) — хлебные крошки
Перем Витрина;        // ВитринаПодписок (web-ui)
Перем Пульт;          // ПультПодписок (web-ui)
Перем Защита;         // ЗащитаCSRF (auth) — токен для форм страницы
Перем СервисПодписок; // СервисПодписок (подписки)
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ТочкиМаршрута

// Точка маршрута «{pool}/{name}/settings/webhooks» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  kind - Строка - тип действия, поля которого показывает форма заведения
//         (необязательный, по умолчанию "").
//
&ТочкаМаршрута("{pool}/{name}/settings/webhooks")
Процедура Раздел(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	kind = "") Экспорт

	Вердикт = ГвардПакета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool, name);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Вердикт, "", "", КукиЗапроса, 200, kind);
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт.Сессия, Вердикт.Пользователь, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗавершитьДействие(Ответ, Вердикт,
		Пульт.Создать(Вердикт.Пользователь, Объект(Вердикт), Форма), КукиЗапроса,
		Пульт.ТипДействия(Форма), Форма);

КонецПроцедуры

// Точка маршрута «{pool}/{name}/settings/webhooks/{id}/delete».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{pool}/{name}/settings/webhooks/{id}/delete")
Процедура Удаление(Ответ, pool, name, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Выполнить_(Ответ, pool, name, id, "удалить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «{pool}/{name}/settings/webhooks/{id}/save» — сохранение правки подписки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{pool}/{name}/settings/webhooks/{id}/save")
Процедура Сохранение(Ответ, pool, name, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Выполнить_(Ответ, pool, name, id, "сохранить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «{pool}/{name}/settings/webhooks/{id}/test» — пробная отправка сохранёнными настройками.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{pool}/{name}/settings/webhooks/{id}/test")
Процедура ПробнаяОтправка(Ответ, pool, name, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Выполнить_(Ответ, pool, name, id, "проба", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «{pool}/{name}/settings/webhooks/{id}/toggle».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{pool}/{name}/settings/webhooks/{id}/toggle")
Процедура Переключение(Ответ, pool, name, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Выполнить_(Ответ, pool, name, id, "переключить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура Выполнить_(Ответ, Знач pool, Знач name, Знач id, Знач Действие,
	Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)

	Вердикт = ГвардПакета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool, name);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "POST", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт.Сессия, Вердикт.Пользователь, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗавершитьДействие(Ответ, Вердикт,
		Пульт.Применить(Вердикт.Пользователь, Объект(Вердикт), Действие, id, Форма), КукиЗапроса,
		Пульт.ТипДействия(Форма), Форма, id);

КонецПроцедуры

// Успех создания показывает секрет один раз, прочие действия — PRG, отказ — та же страница, 400.
Процедура ЗавершитьДействие(Ответ, Знач Вердикт, Знач Исход, Знач КукиЗапроса, Знач Тип = "",
	Знач Форма = Неопределено, Знач ПравкаИд = 0)

	Если Исход.НеНайдено Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт.Пользователь,
			Тексты.Текст("subscriptions.error.notfound"), КукиЗапроса);
		Возврат;
	КонецЕсли;
	Если НЕ Исход.Успех Тогда
		ОтдатьРаздел(Ответ, Вердикт, "", Исход.Ошибка, КукиЗапроса, 400, Тип, Форма, ПравкаИд);
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Исход.Сообщение) Тогда
		ОтдатьРаздел(Ответ, Вердикт, "", "", КукиЗапроса, 200, Тип, Неопределено, 0,
			Исход.Сообщение, Исход.ВидСообщения);
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Исход.Секрет) Тогда
		ОтдатьРаздел(Ответ, Вердикт, Исход.Секрет, "", КукиЗапроса);
		Возврат;
	КонецЕсли;
	Ответ.Перенаправить(Адрес(Вердикт));

КонецПроцедуры

Функция Объект(Знач Вердикт)
	Возврат СервисПодписок.ОбъектПакета(Вердикт.Пакет);
КонецФункции

Функция Адрес(Знач Вердикт)
	Возврат Дом.АдресРаздела(Вердикт.Пул.Имя, Вердикт.Пакет.Имя, "webhooks");
КонецФункции

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач НовыйСекрет, Знач Ошибка, Знач КукиЗапроса,
	Знач Статус = 200, Знач Тип = "", Знач Форма = Неопределено, Знач ПравкаИд = 0,
	Знач Сообщение = "", Знач ВидСообщения = "")

	Пул = Вердикт.Пул;
	Пакет = Вердикт.Пакет;

	Уведомления = Новый Массив();
	Если ЗначениеЗаполнено(НовыйСекрет) Тогда
		Уведомления.Добавить(Ответы.Уведомление(Тексты.Текст("subscriptions.notice.created"), "ok"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Уведомления.Добавить(Ответы.Уведомление(Ошибка, "err"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Сообщение) Тогда
		Уведомления.Добавить(Ответы.Уведомление(Сообщение, ВидСообщения));
	КонецЕсли;

	Параметры = Новый Структура();
	Параметры.Вставить("Объект", Объект(Вердикт));
	Параметры.Вставить("Адрес", Адрес(Вердикт));
	Параметры.Вставить("Токен", Защита.ТокенСессии(Вердикт.Сессия));
	Параметры.Вставить("НовыйСекрет", НовыйСекрет);
	Параметры.Вставить("Пояснение", Тексты.Текст("subscriptions.package.lead"));
	Параметры.Вставить("МожноМенять",
		СервисПодписок.МожетУправлять(Вердикт.Пользователь, Объект(Вердикт)));
	Параметры.Вставить("Тип", Тип);
	// отказ возвращает форму заполненной ровно тем, что прислали (секреты — исключение)
	Параметры.Вставить("Форма", Форма);
	Параметры.Вставить("ПравкаИд", ПравкаИд);

	Хлебные = Новый Массив();
	Хлебные.Добавить(Новый Структура("Подпись, Адрес", Пул.Имя, ДомПула.АдресПула(Пул.Имя)));
	Хлебные.Добавить(Новый Структура("Подпись, Адрес", Пакет.Имя, Дом.АдресПакета(Пул.Имя, Пакет.Имя)));
	Хлебные.Добавить(Новый Структура("Подпись", Тексты.Текст("settings.package.crumb")));

	Модель = Новый Структура();
	Модель.Вставить("Ключ", Дом.Ключ());
	Модель.Вставить("Заголовок", Дом.Заголовок());
	Модель.Вставить("Объект", Пакет.Имя);
	Модель.Вставить("Пояснение", Дом.Пояснение());
	Модель.Вставить("Разделы", Дом.Разделы(Пул.Имя, Пакет.Имя, "webhooks",
		Вердикт.Пользователь, Пакет));
	Модель.Вставить("Уведомления", Уведомления);
	Модель.Вставить("Хлебные", Хлебные);
	Модель.Вставить("Секции", Витрина.Секции(Параметры));

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт.Пользователь, КукиЗапроса,
		Тексты.Шаблон("subscriptions.package.tab", Пакет.Имя), Статус);

КонецПроцедуры

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардПакета") _ГвардПакета,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомПакета") _Дом,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ВитринаПодписок") _Витрина,
	&Пластилин(Значение = "ПультПодписок") _Пульт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	ГвардПакета = _ГвардПакета;
	Ответы = _Ответы;
	Дом = _Дом;
	ДомПула = _ДомПула;
	Витрина = _Витрина;
	Пульт = _Пульт;
	Защита = _Защита;
	СервисПодписок = _СервисПодписок;
	Тексты = _Тексты;

КонецПроцедуры
