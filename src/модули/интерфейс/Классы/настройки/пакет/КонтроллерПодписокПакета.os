// Подписки пакета — контроллер модуля web-ui.

Перем ГвардПакета;    // ГвардПакета (web-ui)
Перем Ответы;         // ОтветыНастроек (web-ui)
Перем Дом;            // ДомПакета (web-ui)
Перем ДомПула;        // ДомПула (web-ui) — хлебные крошки
Перем Витрина;        // ВитринаПодписок (web-ui)
Перем Ход;            // ХодПодписок (web-ui) — общий ход раздела подписок
Перем Защита;         // ЗащитаCSRF (auth) — токен для форм страницы
Перем СервисПодписок; // СервисПодписок (подписки)
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ТочкиМаршрута

// Точка маршрута «{pool}/{name}/settings/webhooks» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  kind - Строка - тип действия, поля которого показывает форма заведения
//         (необязательный, по умолчанию "").
//
&ТочкаМаршрута("{pool}/{name}/settings/webhooks")
Процедура Раздел(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	kind = "") Экспорт

	Контекст = Подготовить(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Показ = Ход.ПоказПоЗапросу(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
		МетодЗапроса, ТелоЗапроса, kind);
	ОтдатьРаздел(Ответ, Контекст, Показ, КукиЗапроса);

КонецПроцедуры

// Точка маршрута «{pool}/{name}/settings/webhooks/{id}/delete».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{pool}/{name}/settings/webhooks/{id}/delete")
Процедура Удаление(Ответ, pool, name, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьДействие(Ответ, pool, name, id, "удалить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «{pool}/{name}/settings/webhooks/{id}/save» — сохранение правки подписки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{pool}/{name}/settings/webhooks/{id}/save")
Процедура Сохранение(Ответ, pool, name, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьДействие(Ответ, pool, name, id, "сохранить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «{pool}/{name}/settings/webhooks/{id}/test» — пробная отправка сохранёнными настройками.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{pool}/{name}/settings/webhooks/{id}/test")
Процедура ПробнаяОтправка(Ответ, pool, name, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьДействие(Ответ, pool, name, id, "проба", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «{pool}/{name}/settings/webhooks/{id}/toggle».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  name - Строка - имя из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{pool}/{name}/settings/webhooks/{id}/toggle")
Процедура Переключение(Ответ, pool, name, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьДействие(Ответ, pool, name, id, "переключить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура ВыполнитьДействие(Ответ, Знач pool, Знач name, Знач id, Знач Действие,
	Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)

	Контекст = Подготовить(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Показ = Ход.ПоказПоДействию(Ответ, Контекст, ОписаниеРаздела(Контекст), КукиЗапроса,
		МетодЗапроса, ТелоЗапроса, Действие, id);
	ОтдатьРаздел(Ответ, Контекст, Показ, КукиЗапроса);

КонецПроцедуры

#КонецОбласти

#Область ОбщаяЛогика

Функция Подготовить(Ответ, Знач pool, Знач name, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)
	Вердикт = ГвардПакета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool, name);
	Возврат ?(Вердикт.Разрешено, Вердикт, Неопределено);
КонецФункции

// Чьи это подписки и по какому адресу живёт раздел — всё, что ход о доме знает.
Функция ОписаниеРаздела(Знач Контекст)
	Возврат Ход.ОписаниеРаздела(СервисПодписок.ОбъектПакета(Контекст.Пакет),
		Дом.АдресРаздела(Контекст.Пул.Имя, Контекст.Пакет.Имя, "webhooks"));
КонецФункции

#КонецОбласти

#Область Рендер

// Пустой показ рисовать нечего: ход уже ответил сам — отбил форму гейтом, не нашёл
// подписку либо увёл редиректом.
Процедура ОтдатьРаздел(Ответ, Знач Контекст, Знач Показ, Знач КукиЗапроса)

	Если Показ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Пул = Контекст.Пул;
	Пакет = Контекст.Пакет;

	Модель = Ответы.МодельДома(Дом, Пакет.Имя,
		Дом.Разделы(Пул.Имя, Пакет.Имя, "webhooks", Контекст.Пользователь, Пакет),
		Ход.Уведомления(Показ),
		Витрина.Секции(ПараметрыВитрины(Контекст, Показ)),
		Хлебные(Пул, Пакет));

	Ответы.ОтдатьДом(Ответ, Модель, Контекст.Пользователь, КукиЗапроса,
		Тексты.Шаблон("subscriptions.package.tab", Пакет.Имя), Показ.Статус);

КонецПроцедуры

Функция ПараметрыВитрины(Знач Контекст, Знач Показ)

	Раздел = ОписаниеРаздела(Контекст);

	Возврат Ход.ПараметрыВитрины(Показ, Раздел,
		Защита.ТокенСессии(Контекст.Сессия), Тексты.Текст("subscriptions.package.lead"),
		СервисПодписок.МожетУправлять(Контекст.Пользователь, Раздел.Владелец));

КонецФункции

Функция Хлебные(Знач Пул, Знач Пакет)

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Подпись, Адрес", Пул.Имя, ДомПула.АдресПула(Пул.Имя)));
	Результат.Добавить(Новый Структура("Подпись, Адрес", Пакет.Имя,
		Дом.АдресПакета(Пул.Имя, Пакет.Имя)));
	Результат.Добавить(Новый Структура("Подпись", Тексты.Текст("settings.package.crumb")));
	Возврат Результат;

КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардПакета") _ГвардПакета,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомПакета") _Дом,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ВитринаПодписок") _Витрина,
	&Пластилин(Значение = "ХодПодписок") _Ход,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	ГвардПакета = _ГвардПакета;
	Ответы = _Ответы;
	Дом = _Дом;
	ДомПула = _ДомПула;
	Витрина = _Витрина;
	Ход = _Ход;
	Защита = _Защита;
	СервисПодписок = _СервисПодписок;
	Тексты = _Тексты;

КонецПроцедуры
