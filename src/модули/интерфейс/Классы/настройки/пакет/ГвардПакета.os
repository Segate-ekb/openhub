// Гвард дома «Пакет» — желудь модуля web-ui.

Перем ГвардКабинета;  // ГвардКабинета (кабинет) — онбординг/аноним/форс-смена пароля
Перем Ответы;         // ОтветыНастроек (web-ui)
Перем СервисПрав;     // СервисПрав (auth)
Перем СервисПулов;    // СервисПулов (реестр)
Перем СервисПакетов;  // СервисПакетов (реестр)
Перем СлужбаКабинета; // СлужбаКабинета (кабинет) — «может ли управлять пакетом»
Перем Тексты;         // ТекстыИнтерфейса (кит) — строки по ключам
Перем Вердикты;       // ВердиктГварда (права) — форма ответа гварда

// Проверяет доступ к маршруту дома «Пакет».
//
// Параметры:
//  Ответ - ОтветСервера.
//  ЗаголовкиЗапроса - Соответствие.
//  КукиЗапроса - Куки.
//  ИмяПула - Строка - сегмент {pool}.
//  ИмяПакета - Строка - сегмент {pkg}.
//
// Возвращаемое значение:
//  Структура - вердикт гварда: Разрешено, Причина и поля формы —
//              Принципал, Пользователь, Сессия, Пул, Пакет.
//
Функция Проверить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ИмяПула, Знач ИмяПакета) Экспорт

	Вердикт = ГвардКабинета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Отказ();
	КонецЕсли;

	Пользователь = Вердикт.Пользователь;
	Пул = СервисПулов.НайтиПул(ИмяПула);

	Если Пул = Неопределено ИЛИ НЕ СервисПрав.МожетЧитать(Пользователь, Пул) Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Пользователь, Тексты.Текст("settings.guard.package.notfound"), КукиЗапроса);
		Возврат Отказ();
	КонецЕсли;

	Пакет = СервисПакетов.НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Если Пакет = Неопределено Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Пользователь, Тексты.Текст("settings.guard.package.notfound"), КукиЗапроса);
		Возврат Отказ();
	КонецЕсли;

	Если НЕ СлужбаКабинета.МожетУправлять(Пользователь, Пул, Пакет) Тогда
		Ответы.ОтдатьЗапрещено(Ответ, Пользователь,
			Тексты.Текст("settings.guard.package.forbidden"), КукиЗапроса);
		Возврат Отказ();
	КонецЕсли;

	Возврат Вердикты.Пропуск(ПоляОтвета(Вердикт.Принципал, Пользователь, Вердикт.Сессия,
		Пул, Пакет));

КонецФункции

// Отказ уже отвечен страницей: причина гварда дома — та самая страница, а не код.
Функция Отказ()
	Возврат Вердикты.Отказ("", ПоляОтвета());
КонецФункции

Функция ПоляОтвета(Знач Принципал = Неопределено, Знач Пользователь = Неопределено,
	Знач Сессия = Неопределено, Знач Пул = Неопределено, Знач Пакет = Неопределено)

	Поля = Вердикты.ПоляПринципала(Принципал, Пользователь, Сессия);
	Поля.Вставить("Пул", Пул);
	Поля.Вставить("Пакет", Пакет);
	Возврат Поля;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _ГвардКабинета,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СлужбаКабинета") _СлужбаКабинета,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ВердиктГварда") _Вердикты = Неопределено) Экспорт

	ГвардКабинета = _ГвардКабинета;
	Ответы = _Ответы;
	СервисПрав = _СервисПрав;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	СлужбаКабинета = _СлужбаКабинета;
	Тексты = _Тексты;
	Вердикты = ?(_Вердикты = Неопределено, Новый ВердиктГварда(), _Вердикты);

КонецПроцедуры
