// Пульт тегов пакета — желудь модуля web-ui: заведение, правка, проверка правила,
// удаление тега и назначение тега по умолчанию из раздела «Теги» дома «Пакет».

Перем РазборФормы;    // РазборФормы (web-ui)
Перем СервисТегов;    // СервисТегов (реестр)
Перем Каналы;         // КаналыПоУмолчанию (реестр) — заведение трёх каналов визардом
Перем ФормаВизарда;   // ФормаКаналовПоУмолчанию (web-ui) — имя операции визарда
Перем Конструкторы;   // КонструкторТега (web-ui) — состояние конструктора и словарь видов
Перем Ответы;         // ОтветыНастроек (web-ui) — краткий текст исключения
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Применяет операцию раздела «Теги» дома «Пакет».
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Пользователь - Пользователь, Неопределено - кто действует; попадает в событие.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - Записано (Булево: Ложь — раздел перерисовывается),
//              Ошибка (Строка: текст уведомления, "" — уведомления нет),
//              Код (Число: статус перерисовки), Состояние (Структура, Неопределено:
//              состояние конструктора для перерисовки), Хвост (Строка: хвост адреса
//              перенаправления), Визард (Структура, Неопределено: состояние окна визарда,
//              в которое возвращается отбитая отправка), Предупреждение (Строка: текст
//              жёлтой плашки — действие удалось, но человеку есть что знать).
//
Функция Применить(Знач Пакет, Знач Пользователь, Знач Форма) Экспорт

	// операцию называет НАЖАТАЯ кнопка, скрытым полем она не едет: форма без операции —
	// это не «сохранить по умолчанию», а отказ
	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, "операция")));
	Кто = ?(Пользователь = Неопределено, "", Строка(Пользователь.Логин));

	Если Операция = ФормаВизарда.Операция() Тогда
		Возврат ЗаведениеКаналов(Пакет, Кто);
	ИначеЕсли Операция = "удалить" Тогда
		Возврат Удаление(Пакет, Форма, Кто);
	ИначеЕсли Операция = "по_умолчанию" Тогда
		Возврат НазначениеПоУмолчанию(Пакет, Форма);
	ИначеЕсли Операция = "проверить" ИЛИ Операция = "сохранить" Тогда
		// проба идёт той же дорогой, что и запись, но до записи не доходит
		Возврат ПравкаТега(Пакет, Форма, Кто, Операция = "проверить");
	КонецЕсли;

	Возврат Отказ(Тексты.Текст("settings.package.tags.error.operation"), 400);

КонецФункции

#КонецОбласти

#Область ОперацииРаздела

// Пустое имя — форма без выбора: удалять нечего.
Функция Удаление(Знач Пакет, Знач Форма, Знач Кто)

	ИмяТега = РазборФормы.Поле(Форма, "имя");
	Если ЗначениеЗаполнено(ИмяТега) Тогда
		СервисТегов.УдалитьТег(Пакет.Идентификатор, ИмяТега, Кто);
	КонецЕсли;

	Возврат Записано();

КонецФункции

Функция НазначениеПоУмолчанию(Знач Пакет, Знач Форма)

	ИмяТега = РазборФормы.Поле(Форма, "имя");
	Если ЗначениеЗаполнено(ИмяТега) Тогда
		СервисТегов.НазначитьПоУмолчанию(Пакет.Идентификатор, ИмяТега);
	КонецЕсли;

	Возврат Записано();

КонецФункции

// Заведение и правка тега. Проба судит те же поля тем же сервером, но вместо записи
// показывает состав канала, поэтому отказ по имени для неё — ответ на вопрос (200),
// а для записи — отказ от записи (400).
Функция ПравкаТега(Знач Пакет, Знач Форма, Знач Кто, Знач Проба)

	ИмяТега = РазборФормы.Поле(Форма, "имя");
	ВидФормы = РазборФормы.Поле(Форма, "вид", "");
	Пара = Конструкторы.ПараИзВида(ВидФормы);
	ВыражениеПравила = РазборФормы.Поле(Форма, "правило");
	ОформлениеФормы = ОформлениеИзФормы(Форма);

	// вид, стиль и значок — ключи закрытых списков: подделанное поле формы отбивается
	// сервером одинаково, потому что все три стоят на пути ЗАПИСИ
	Если НЕ Конструкторы.ВидДопустим(ВидФормы) Тогда
		Возврат СОшибкой(Конструкторы.Новое(Пара.Режим, Пара.Тип, ИмяТега, ВыражениеПравила,
			ОформлениеФормы), Тексты.Текст("settings.package.tag-new.kind.error"), 400);
	КонецЕсли;

	Если НЕ Конструкторы.ОформлениеДопустимо(ОформлениеФормы) Тогда
		Возврат СОшибкой(Конструкторы.Новое(Пара.Режим, Пара.Тип, ИмяТега, ВыражениеПравила,
			Неопределено), Тексты.Текст("settings.package.tag-new.look.error"), 400);
	КонецЕсли;

	Состояние = Конструкторы.Новое(Пара.Режим, Пара.Тип, ИмяТега, ВыражениеПравила,
		ОформлениеФормы);
	Состояние.ПоУмолчанию = РазборФормы.Флажок(Форма, "по_умолчанию");
	Состояние.ЗапретПерезаписи = ЗапретИзФормы(Форма);
	Конструкторы.ДополнитьПравкой(Пакет.Идентификатор, Состояние);

	Претензия = ПретензияКИмени(Пакет, Состояние);
	Если ЗначениеЗаполнено(Претензия) Тогда
		Возврат СОшибкой(Состояние, Претензия, ?(Проба, 200, 400));
	КонецЕсли;

	Если Проба Тогда
		Возврат Перерисовать(СПредпросмотром(Пакет, Состояние), 200);
	КонецЕсли;

	Записать(Пакет, Состояние, ИмяТега, Кто, Пара);
	Возврат Записано(ХвостПеренаправления(Состояние, Пара));

КонецФункции

// Чем сервер недоволен в имени тега; пустая строка — имя годится.
Функция ПретензияКИмени(Знач Пакет, Знач Состояние)

	Если НЕ СервисТегов.ИмяДопустимо(Состояние.Имя) Тогда
		Возврат Тексты.Текст("settings.package.tag-new.name.error");
	КонецЕсли;
	Если СервисТегов.ИмяДляНовогоТегаЗанято(Пакет.Идентификатор, Состояние.Имя) Тогда
		Возврат Тексты.Текст("settings.package.tag-new.name.version.error");
	КонецЕсли;

	Возврат "";

КонецФункции

// Отказ печатается в самом конструкторе: набранное остаётся в его полях.
Функция СОшибкой(Состояние, Знач Сообщение, Знач Код)

	Состояние.Ошибка = Сообщение;
	Возврат Перерисовать(Состояние, Код);

КонецФункции

// Визард заводит каналы одним действием; что появилось, человек видит в таблице под окном.
// Пропущенное молчанием не остаётся: имя, занятое номером версии, названо, — и названо
// отдельно, если из-за него у пакета не оказалось основного тега. Не заведено ничего —
// отправка возвращается в то же окно.
Функция ЗаведениеКаналов(Знач Пакет, Знач Кто)

	Итог = Каналы.Создать(Пакет.Идентификатор, Кто);
	Занятые = СтрСоединить(Итог.Занято, ", ");

	Если Итог.Создано.Количество() > 0 Тогда
		Возврат ?(Итог.Занято.Количество() = 0, Записано(),
			Предупредить(ТекстПропущенного(Занятые, Итог.Основной)));
	КонецЕсли;

	// имена заняты номерами версий — это тупик: пока их не переименуют, заводить нечего,
	// и отправка возвращается в окно отказом
	Если Итог.Занято.Количество() > 0 Тогда
		Возврат ВернутьВОкно(Тексты.Шаблон("settings.package.tags.wizard.busy", Занятые));
	КонецЕсли;

	// а «всё уже заведено» отказом не является: ничего не сломалось, человеку просто
	// нечего добавить — это предупреждение
	Возврат Предупредить(Тексты.Текст("settings.package.tags.wizard.nothing"));

КонецФункции

// Пакету без основного тега сказать надо больше: пока его не назначили, установка без
// тега идёт фолбэком «последняя версия», а не каналом мейнтейнера.
Функция ТекстПропущенного(Знач Занятые, Знач ОсновнойТег)

	Возврат ?(ЗначениеЗаполнено(ОсновнойТег),
		Тексты.Шаблон("settings.package.tags.wizard.skipped", Занятые),
		Тексты.Шаблон("settings.package.tags.wizard.skipped.nodefault", Занятые));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Записать(Знач Пакет, Знач Состояние, Знач ИмяТега, Знач Кто, Знач Пара)

	Если Конструкторы.ЭтоРучной(Состояние) Тогда
		СервисТегов.ОпределитьРучнойТег(Пакет.Идентификатор, ИмяТега, Кто,
			Конструкторы.ПараОформления(Состояние));
	Иначе
		СервисТегов.ОпределитьТегПравила(Пакет.Идентификатор, ИмяТега,
			Пара.Тип, Состояние.Правило, Кто, Конструкторы.ПараОформления(Состояние));
	КонецЕсли;

	// снять признак «по умолчанию» отдельно нельзя: у пакета он всегда ровно один,
	// и снимается он назначением другого тега — поэтому тумблер только назначает
	Если Состояние.ПоУмолчанию Тогда
		СервисТегов.НазначитьПоУмолчанию(Пакет.Идентификатор, ИмяТега);
	КонецЕсли;

	// а этот тумблер работает в обе стороны: снятый запрет так же возвращается формой
	СервисТегов.УстановитьЗапретПерезаписи(Пакет.Идентификатор, ИмяТега,
		Состояние.ЗапретПерезаписи, Кто);

КонецПроцедуры

// Тумблер кита читается сравнением со ЗНАЧЕНИЕМ, а не заполненностью: включённый шлёт
// «1», выключенный — «0» парным скрытым полем. Запрет держится и тогда, когда поля нет
// вовсе: запрос, о тумблере умолчавший, защиту не снимает — на снятой перезапись чужой
// версии становится молчаливой.
Функция ЗапретИзФормы(Знач Форма)
	Прислано = РазборФормы.Поле(Форма, "запрет_перезаписи");
	Возврат Прислано = "" ИЛИ РазборФормы.Флажок(Форма, "запрет_перезаписи");
КонецФункции

// Проверка правила — чтение: тот же конструктор с составом канала под ним. Неприменимое
// правило печатается в конструкторе, а не роняет запись: сохранять ещё никто не просил.
Функция СПредпросмотром(Знач Пакет, Состояние)

	Если НЕ Конструкторы.ЭтоРучной(Состояние) Тогда
		Попытка
			Состояние.Предпросмотр = СервисТегов.ПредпросмотрПравила(
				Пакет.Идентификатор, Состояние.Тип, Состояние.Правило);
		Исключение
			Состояние.Ошибка = Тексты.Шаблон("settings.package.tag-new.preview.error",
				Ответы.КраткоОшибка(ОписаниеОшибки()));
		КонецПопытки;
	КонецЕсли;

	Возврат Состояние;

КонецФункции

// Хвост возврата после записи тега: вид переживает PRG (иначе конструктор молча
// возвращается к semver-правилу), а имя сохранённого тега нужно, чтобы показать состав
// его канала тому, кто правило не проверял.
Функция ХвостПеренаправления(Знач Состояние, Знач Пара)

	Возврат "&kind=" + Конструкторы.КодВида(Пара.Режим, Пара.Тип)
		+ "&saved_tag=" + КодироватьСтроку(СокрЛП(Состояние.Имя),
			СпособКодированияСтроки.КодировкаURL);

КонецФункции

Функция ОформлениеИзФормы(Знач Форма)
	Возврат Новый Структура("Стиль, Значок",
		РазборФормы.Поле(Форма, "стиль"), РазборФормы.Поле(Форма, "значок"));
КонецФункции

Функция Записано(Знач Хвост = "")
	Возврат Итог(Истина, "", 200, Неопределено, Хвост, Неопределено);
КонецФункции

Функция Отказ(Знач Сообщение, Знач Код)
	Возврат Итог(Ложь, Сообщение, Код, Неопределено, "", Неопределено);
КонецФункции

Функция Перерисовать(Знач Состояние, Знач Код)
	Возврат Итог(Ложь, "", Код, Состояние, "", Неопределено);
КонецФункции

// Отбитая отправка визарда возвращается ТЕМ ЖЕ окном — открытым, с объяснением над ним.
Функция ВернутьВОкно(Знач Сообщение)
	Возврат Итог(Ложь, Сообщение, 400, Неопределено, "", Новый Структура("Открыта", Истина));
КонецФункции

// Работа сделана, но человеку есть что знать: раздел перерисовывается с ПРЕДУПРЕЖДЕНИЕМ
// вместо перенаправления — иначе слова потерялись бы на редиректе. Красная плашка здесь
// солгала бы: каналы заведены.
Функция Предупредить(Знач Сообщение)
	Возврат Итог(Ложь, "", 200, Неопределено, "", Неопределено, Сообщение);
КонецФункции

Функция Итог(Знач Записано_, Знач Ошибка, Знач Код, Знач Состояние, Знач Хвост, Знач Визард,
	Знач Предупреждение = "")

	Возврат Новый Структура("Записано, Ошибка, Код, Состояние, Хвост, Визард, Предупреждение",
		Записано_, Ошибка, Код, Состояние, Хвост, Визард, Предупреждение);

КонецФункции

#КонецОбласти

&Прозвище("ПультТеговПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "КаналыПоУмолчанию") _Каналы,
	&Пластилин(Значение = "ФормаКаналовПоУмолчанию") _ФормаВизарда,
	&Пластилин(Значение = "КонструкторТега") _Конструкторы,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	СервисТегов = _СервисТегов;
	Каналы = _Каналы;
	ФормаВизарда = _ФормаВизарда;
	Конструкторы = _Конструкторы;
	Ответы = _Ответы;
	Тексты = _Тексты;

КонецПроцедуры
