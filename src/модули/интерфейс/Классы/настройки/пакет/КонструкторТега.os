// Состояние конструктора тега дома «Пакет» — желудь модуля web-ui: режим, тип правила,
// введённое, оформление и словарь видов тега.

Перем СервисТегов;  // СервисТегов (реестр) — существующий тег с таким именем
Перем Режимы;       // РежимТега (реестр) — единственный словарь режимов
Перем Типы;         // ТипПравилаТега (реестр) — единственный словарь типов правил
Перем Стили;        // СтильТега (реестр) — единственный словарь стилей плашки
Перем Значки;       // ЗначокТега (реестр) — единственный словарь значков плашки

#Область ПубличныйИнтерфейс

// Состояние конструктора тега: режим, тип правила, введённое, оформление и состав канала,
// отобранный проверкой, — одной структурой. Оформление хранится КЛЮЧАМИ: цвет даёт тема.
//
// Параметры:
//  Режим - Строка - режим тега.
//  ТипПравила - Строка - тип правила.
//  ИмяТега - Строка - имя тега.
//  ВыражениеПравила - Строка - выражение правила.
//  ОформлениеФормы - Структура, Неопределено - Стиль и Значок из формы; Неопределено —
//                    оформление по умолчанию.
//
// Возвращаемое значение:
//  Структура - Режим, Тип, Имя, Правило, Стиль, Значок, ПоУмолчанию, Правится, РежимДо,
//              БылоПоУмолчанию, Предпросмотр, Ошибка.
//
Функция Новое(Знач Режим, Знач ТипПравила, Знач ИмяТега, Знач ВыражениеПравила,
	Знач ОформлениеФормы) Экспорт

	Стиль = Стили.Обычный();
	Значок = Значки.Нет();
	Если ОформлениеФормы <> Неопределено Тогда
		Стиль = Стили.Нормализовать(ОформлениеФормы.Стиль);
		Значок = Значки.Нормализовать(ОформлениеФормы.Значок);
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("Режим", ?(Режим = Режимы.Ручной(), Режимы.Ручной(), Режимы.Правило()));
	Результат.Вставить("Тип", Типы.ДляПоказа(ТипПравила));
	Результат.Вставить("Имя", Строка(ИмяТега));
	Результат.Вставить("Правило", Строка(ВыражениеПравила));
	Результат.Вставить("Стиль", Стиль);
	Результат.Вставить("Значок", Значок);
	Результат.Вставить("ПоУмолчанию", Ложь);
	Результат.Вставить("Правится", Ложь);
	Результат.Вставить("РежимДо", "");
	Результат.Вставить("БылоПоУмолчанию", Ложь);
	Результат.Вставить("Предпросмотр", Неопределено);
	Результат.Вставить("Ошибка", "");
	Возврат Результат;

КонецФункции

// Состояние конструктора по адресу. Если тег с таким именем УЖЕ ЕСТЬ — это правка, и
// поля заполняются его значениями; явный вид из адреса всё равно главнее, иначе возврат
// после сохранения ронял бы выбор автора.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  ВидИзАдреса - Строка - код вида тега из адреса; "" — вид не назван.
//  ИмяТега - Строка - имя тега из адреса; "" — заводится новый.
//
// Возвращаемое значение:
//  Структура - состояние конструктора.
//
Функция ПоАдресу(Знач ПакетИдентификатор, Знач ВидИзАдреса, Знач ИмяТега) Экспорт

	Тег = ?(ЗначениеЗаполнено(ИмяТега),
		СервисТегов.НайтиТег(ПакетИдентификатор, ИмяТега), Неопределено);
	Пара = ПараИзВида(ВидИзАдреса);

	Если Тег = Неопределено Тогда
		Возврат Новое(Пара.Режим, Пара.Тип, ИмяТега, "", Неопределено);
	КонецЕсли;

	РежимТега = ?(Режимы.ЭтоПравило(Тег.Режим), Режимы.Правило(), Режимы.Ручной());
	Режим = ?(ЗначениеЗаполнено(ВидИзАдреса), Пара.Режим, РежимТега);
	Тип = ?(ЗначениеЗаполнено(ВидИзАдреса), Пара.Тип,
		Типы.ДляПоказа(?(ЗначениеЗаполнено(Тег.ТипПравила), Тег.ТипПравила, Типы.Semver())));

	// выражение подставляется только СВОЕМУ типу: у regex и semver оно разное
	Выражение = ?(Тип = Типы.ДляПоказа(Тег.ТипПравила), Строка(Тег.Правило), "");

	Состояние = Новое(Режим, Тип, Тег.Имя, Выражение,
		Новый Структура("Стиль, Значок", Тег.Стиль, Тег.Значок));
	Состояние.Правится = Истина;
	Состояние.РежимДо = Строка(Тег.Режим);
	Состояние.БылоПоУмолчанию = (Тег.ПоУмолчанию = Истина);
	Возврат Состояние;

КонецФункции

// Дополняет состояние знанием о СУЩЕСТВУЮЩЕМ теге с таким именем: конструктор и правка —
// один экран, и разница только в том, что тег уже есть. Смена режима у существующего тега
// меняет состав канала, поэтому она называется отдельно и показывается до сохранения.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Состояние - Структура - состояние конструктора, дополняется на месте.
//
Процедура ДополнитьПравкой(Знач ПакетИдентификатор, Состояние) Экспорт

	Тег = СервисТегов.НайтиТег(ПакетИдентификатор, Состояние.Имя);
	Если Тег = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Состояние.Правится = Истина;
	Состояние.РежимДо = Строка(Тег.Режим);
	Состояние.БылоПоУмолчанию = (Тег.ПоУмолчанию = Истина);

КонецПроцедуры

// Единственное место, где ОДИН выбор формы раскладывается в доменную пару «режим + тип
// правила»: в базе и в API это по-прежнему два разных поля. Неизвестное значение сводится
// к semver-правилу, а не роняет экран.
//
// Параметры:
//  Значение - Строка - код вида тега.
//
// Возвращаемое значение:
//  Структура - Режим, Тип.
//
Функция ПараИзВида(Знач Значение) Экспорт

	Норм = НРег(СокрЛП(Строка(Значение)));

	Если Норм = ВидРучной() ИЛИ Норм = Режимы.Ручной() Тогда
		Возврат Новый Структура("Режим, Тип", Режимы.Ручной(), Типы.Semver());
	КонецЕсли;

	Возврат Новый Структура("Режим, Тип", Режимы.Правило(), Типы.ДляПоказа(Норм));

КонецФункции

// Обратный перевод пары в код вида: он же значение варианта в списке и в адресе.
//
// Параметры:
//  Режим - Строка - режим тега.
//  Тип - Строка - тип правила.
//
// Возвращаемое значение:
//  Строка - код вида тега.
//
Функция КодВида(Знач Режим, Знач Тип) Экспорт
	Возврат ?(Режим = Режимы.Ручной(), ВидРучной(), Типы.ДляПоказа(Тип));
КонецФункции

// Пустое значение — «поле не прислали», оно сводится к semver-правилу как и раньше;
// незнакомое непустое — подделка формы, и её судит сервер.
//
// Параметры:
//  Значение - Строка - код вида тега из формы.
//
// Возвращаемое значение:
//  Булево - допустим ли вид.
//
Функция ВидДопустим(Знач Значение) Экспорт
	Норм = НРег(СокрЛП(Строка(Значение)));
	Возврат ПустаяСтрока(Норм) ИЛИ Норм = ВидРучной() ИЛИ Норм = ВидSemver() ИЛИ Норм = ВидRegex();
КонецФункции

// Стиль и значок — ключи закрытых списков: подделанное поле формы отбивается сервером.
//
// Параметры:
//  ОформлениеФормы - Структура - Стиль и Значок из формы.
//
// Возвращаемое значение:
//  Булево - допустимы ли оба ключа.
//
Функция ОформлениеДопустимо(Знач ОформлениеФормы) Экспорт
	Возврат Стили.Допустим(ОформлениеФормы.Стиль) И Значки.Допустим(ОформлениеФормы.Значок);
КонецФункции

// Оформление состояния парой «стиль + значок» — так его принимает СервисТегов.
//
// Параметры:
//  Конструктор - Структура - состояние конструктора.
//
// Возвращаемое значение:
//  Структура - Стиль, Значок.
//
Функция ПараОформления(Знач Конструктор) Экспорт
	Возврат Новый Структура("Стиль, Значок", Конструктор.Стиль, Конструктор.Значок);
КонецФункции

// Ручной ли тег в этом состоянии.
//
// Параметры:
//  Конструктор - Структура - состояние конструктора.
//
// Возвращаемое значение:
//  Булево - ручной ли тег.
//
Функция ЭтоРучной(Знач Конструктор) Экспорт
	Возврат Конструктор.Режим = Режимы.Ручной();
КонецФункции

// Истина, если правится существующий тег И режим меняется: это единственная правка,
// которая трогает не оформление, а СОСТАВ канала.
//
// Параметры:
//  Конструктор - Структура - состояние конструктора.
//
// Возвращаемое значение:
//  Булево - меняется ли режим существующего тега.
//
Функция СменаРежима(Знач Конструктор) Экспорт
	Возврат Конструктор.Правится И ЗначениеЗаполнено(Конструктор.РежимДо)
		И Конструктор.РежимДо <> Конструктор.Режим;
КонецФункции

// Код вида «ручной тег».
//
// Возвращаемое значение:
//  Строка - код вида.
//
Функция ВидРучной() Экспорт
	Возврат "manual";
КонецФункции

// Код вида «правило semver».
//
// Возвращаемое значение:
//  Строка - код вида.
//
Функция ВидSemver() Экспорт
	Возврат Типы.Semver();
КонецФункции

// Код вида «правило regex».
//
// Возвращаемое значение:
//  Строка - код вида.
//
Функция ВидRegex() Экспорт
	Возврат Типы.Regex();
КонецФункции

#КонецОбласти

&Прозвище("КонструкторТега")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисТегов") _СервисТегов,
	&Пластилин(Значение = "РежимТега") _Режимы,
	&Пластилин(Значение = "ТипПравилаТега") _Типы,
	&Пластилин(Значение = "СтильТега") _Стили,
	&Пластилин(Значение = "ЗначокТега") _Значки) Экспорт

	СервисТегов = _СервисТегов;
	Режимы = _Режимы;
	Типы = _Типы;
	Стили = _Стили;
	Значки = _Значки;

КонецПроцедуры
