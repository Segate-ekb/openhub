// Дом настроек «Пакет» — желудь модуля web-ui.

Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Каталог;        // КаталогРазделов (web-ui)
Перем СервисДоверия;  // СервисДоверияCI (публикация) — порог раздела «Доверенная публикация»
Перем Описания;       // Массив описаний разделов

// Ключ дома.
//
// Возвращаемое значение:
//  Строка - ключ дома.
//
Функция Ключ() Экспорт
	Возврат "package";
КонецФункции

// Базовый адрес дома.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Строка - "/{pool}/{pkg}/settings".
//
Функция БазовыйАдрес(Знач ИмяПула, Знач ИмяПакета) Экспорт
	Возврат "/" + Каталог.Сегмент(ИмяПула) + "/" + Каталог.Сегмент(ИмяПакета) + "/settings";
КонецФункции

// Адрес публичной страницы пакета.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Строка - адрес публичной страницы пакета.
//
Функция АдресПакета(Знач ИмяПула, Знач ИмяПакета) Экспорт
	Возврат "/" + Каталог.Сегмент(ИмяПула) + "/" + Каталог.Сегмент(ИмяПакета);
КонецФункции

// Раздел по умолчанию.
//
// Возвращаемое значение:
//  Строка - раздел по умолчанию.
//
Функция РазделПоУмолчанию() Экспорт
	Возврат "card";
КонецФункции

// Адрес раздела дома.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - адрес раздела дома.
//
Функция АдресРаздела(Знач ИмяПула, Знач ИмяПакета, Знач Ключ) Экспорт
	Возврат Каталог.Адрес(БазовыйАдрес(ИмяПула, ИмяПакета), Ключ);
КонецФункции

// Разделы дома для дерева навигации.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//  Активный - Строка - ключ активного раздела.
//  Пользователь - Пользователь, Неопределено - смотрящий; от него зависит состав разделов
//                 с порогом выше домового (необязательный, по умолчанию Неопределено).
//  Пакет - Пакет, Неопределено - пакет раздела (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Массив - разделы дома для дерева навигации.
//
Функция Разделы(Знач ИмяПула, Знач ИмяПакета, Знач Активный, Знач Пользователь = Неопределено,
	Знач Пакет = Неопределено) Экспорт

	Возврат Каталог.Разделы(БазовыйАдрес(ИмяПула, ИмяПакета),
		Доступные(Пользователь, Пакет), Активный);

КонецФункции

// Есть ли раздел с таким ключом.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Булево - есть ли раздел с таким ключом.
//
Функция ЕстьРаздел(Знач Ключ) Экспорт
	Возврат Каталог.Содержит(Описания, Ключ);
КонецФункции

// Подпись раздела.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - подпись раздела.
//
Функция ПодписьРаздела(Знач Ключ) Экспорт
	Возврат Каталог.Подпись(Описания, Ключ);
КонецФункции

// Заголовок дома.
//
// Возвращаемое значение:
//  Строка - заголовок дома.
//
Функция Заголовок() Экспорт
	Возврат Тексты.Текст("settings.package.title");
КонецФункции

// Пояснение дома.
//
// Возвращаемое значение:
//  Строка - пояснение дома.
//
Функция Пояснение() Экспорт
	Возврат Тексты.Текст("settings.package.lead");
КонецФункции

// «Доверенная публикация» — единственный раздел дома с порогом ВЫШЕ домового, и пункт
// меню, ведущий в 403, был бы тупиком. Порог спрашивается у домена, а не считается здесь.
Функция Доступные(Знач Пользователь, Знач Пакет)

	Если Пакет = Неопределено ИЛИ СервисДоверия.МожетНастраивать(Пользователь, Пакет) Тогда
		Возврат Описания;
	КонецЕсли;

	Результат = Новый Массив();
	Для Каждого Описание Из Описания Цикл
		Если Описание.Ключ <> КлючДоверия() Тогда
			Результат.Добавить(Описание);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КлючДоверия()
	Возврат "ci";
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаталогРазделов") _Каталог,
	&Пластилин(Значение = "СервисДоверияCI") _СервисДоверия,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Каталог = _Каталог;
	СервисДоверия = _СервисДоверия;
	Тексты = _Тексты;

	Описания = Новый Массив();
	Описания.Добавить(Каталог.Описание("card", Тексты.Текст("settings.package.nav.card"), "пакет"));
	Описания.Добавить(Каталог.Описание("access", Тексты.Текст("settings.package.nav.access"), "замок"));
	Описания.Добавить(Каталог.Описание("tags", Тексты.Текст("settings.package.nav.tags"), "тег"));
	Описания.Добавить(Каталог.Описание("versions", Тексты.Текст("settings.package.nav.versions"), "история"));
	Описания.Добавить(Каталог.Описание("webhooks", Тексты.Текст("settings.package.nav.webhooks"), "стрелка"));
	Описания.Добавить(Каталог.Описание(КлючДоверия(), Тексты.Текст("settings.package.nav.ci"), "ключ"));
	Описания.Добавить(Каталог.Описание("danger", Тексты.Текст("settings.package.nav.danger"), "предупреждение"));

КонецПроцедуры
