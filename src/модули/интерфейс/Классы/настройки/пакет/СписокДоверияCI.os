// Список доверенных конвейеров пакета — желудь модуля web-ui: таблица записей и шаг
// подтверждения снятия.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем СервисДоверия;     // СервисДоверияCI (публикация) — записи пакета и их имена
Перем Маски;             // МаскаРефа (публикация) — слишком широкая маска рефа
Перем Провайдеры;        // ПредставлениеПровайдераCI (web-ui) — значок и издатель записи
Перем КороткаяФорма;     // КороткаяФормаДоверия (публикация) — адреса записи в вебе
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Бланки;            // БланкРаздела (web-ui) — адрес и токен раздела, формы на них
Перем Даты;  // ДатаЧеловеку (web-ui) — одно написание момента на весь интерфейс
Перем Примечания;  // ПримечанияЭкрана (web-ui) — вид «показывать нечего»

#Область ПубличныйИнтерфейс

// Секция со списком доверенных конвейеров пакета.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Бланк - Структура - бланк раздела (БланкРаздела): адрес форм строк и токен сессии.
//  Действия - ЭлементЭкрана - (необязательный, по умолчанию Неопределено) то, что стоит
//             над таблицей: кнопка заведения и её окно. Как оно устроено, список не знает.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция Секция(Знач Пакет, Знач Бланк, Знач Действия = Неопределено) Экспорт

	Тело = Кит.Холст();
	Если Действия <> Неопределено Тогда
		Тело.Добавить(Действия);
	КонецЕсли;
	Тело.Добавить(ТаблицаЗаписей(Пакет, Бланк));
	Тело.Добавить(Кит.Примечание(Тексты.Текст("settings.package.ci.note")));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.package.ci.title"),
		Тексты.Текст("settings.package.ci.lead"), Тело.Рендер());
	Секция.Иконка = "ключ";
	// секция без «Действия»: кнопка снятия каждой строки — своя маленькая форма
	Возврат Секция;

КонецФункции

// Шаг подтверждения снятия: та же страница, отдельной секцией-формой над списком.
// Это путь без скрипта; со скриптом до него не доходит — вопрос задаёт диалог.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Бланк - Структура - бланк раздела (БланкРаздела): адрес формы и токен сессии.
//  Идентификатор - Строка - идентификатор записи, снятие которой ждёт подтверждения.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция СекцияПодтвержденияСнятия(Знач Пакет, Знач Бланк, Знач Идентификатор) Экспорт

	Тело = Кит.Холст();
	Тело.Добавить(Кит.СкрытоеПоле("операция", "отозвать"));
	Тело.Добавить(Кит.СкрытоеПоле("доверие", Идентификатор));
	Тело.Добавить(Кит.СкрытоеПоле("подтверждение", Идентификатор));

	Фраза = Тело.Добавить(Кит.Примечание())
		.Добавить(Кит.Шаблон(Тексты.Текст("settings.package.ci.revoke.note")));
	Фраза.Добавить(Кит.Код(ОписаниеПоИдентификатору(Пакет, Идентификатор)));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.package.ci.revoke.title"),
		Тексты.Текст("settings.package.ci.revoke.lead"), Тело.Рендер());
	Секция.Иконка = "предупреждение";
	Секция.Действие = Бланки.Адрес(Бланк);
	Секция.Токен = Бланк.Токен;
	Секция.Кнопка = Тексты.Текст("settings.package.ci.revoke.button");
	Секция.Опасная = Истина;
	// «Отмена» — обычная ссылка на тот же раздел: возврат ничего не меняет
	Секция.АдресОтмены = Бланки.Адрес(Бланк);
	Возврат Секция;

КонецФункции

#КонецОбласти

#Область Разметка

// На узком экране строка становится карточкой: значения называют себя сами, шапка не нужна.
Функция ТаблицаЗаписей(Знач Пакет, Знач Бланк)

	Таблица = Кит.Таблица("карточками");
	Таблица.Пусто().Добавить(Примечания.Пусто(Тексты.Текст("settings.package.ci.empty")));

	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.ci.col.repo")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.ci.col.workflow")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.ci.col.ref")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.ci.col.author")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.ci.col.action")));

	Для Каждого СтрокаДоверия Из СервисДоверия.СтрокиПакета(Пакет) Цикл
		Таблица.Добавить(ЗаписьТаблицы(СтрокаДоверия, Бланк));
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция ЗаписьТаблицы(Знач СтрокаДоверия, Знач Бланк)

	Запись = СтрокаДоверия.Доверие;
	Идентификатор = Формат(Цел(Запись.Идентификатор), "ЧГ=0; ЧН=0");
	Адреса = КороткаяФорма.АдресаЗаписи(Запись.Провайдер, Запись.Издатель, Запись.Репозиторий,
		Запись.Конвейер, Запись.Реф);

	Результат = Кит.Запись();
	Результат.Добавить(ЯчейкаРепозитория(Запись, Адреса));
	Результат.Добавить(ЯчейкаКонвейера(Адреса));
	Результат.Добавить(ЯчейкаРефа(Запись.Реф));
	Результат.Добавить(ЯчейкаАвтора(СтрокаДоверия));
	Результат.Добавить(ЯчейкаСнятия(Бланк, Идентификатор,
		СервисДоверия.ОписаниеЗаписи(Запись)));
	Возврат Результат;

КонецФункции

// Тип показан значком: значений всего два, и колонка съедала ширину у самих данных.
Функция ЯчейкаРепозитория(Знач Запись, Знач Адреса)

	Результат = Кит.Ячейка("столбиком");

	Верх = Результат.Добавить(Кит.Ряд("строкой"));
	Верх.Добавить(Провайдеры.Значок(Запись.Провайдер));
	Верх.Добавить(Машинное(Адреса.Репозиторий, Строка(Запись.Репозиторий)));

	Результат.Добавить(Провайдеры.УточнениеИздателя(Запись.Провайдер, Запись.Издатель));
	Возврат Результат;

КонецФункции

// Пустой конвейер значит «любой конвейер репозитория» — так и написано: пустая ячейка врёт.
Функция ЯчейкаКонвейера(Знач Адреса)

	Результат = Кит.Ячейка();
	Если ЗначениеЗаполнено(Адреса.Имя) Тогда
		Результат.Добавить(Машинное(Адреса.Конвейер, Адреса.Имя));
	Иначе
		Результат.Добавить(Кит.Текст(Тексты.Текст("settings.package.ci.any")));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Ссылка живёт ВНУТРИ значения: подчёркивание тянется по пути, а не по всей ячейке.
Функция Машинное(Знач Адрес, Знач Значение)

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат Кит.Код(Значение);
	КонецЕсли;

	Результат = Кит.Код("");
	Результат.Добавить(Кит.Ссылка(Адрес)).Добавить(Кит.Текст(Значение));
	Возврат Результат;

КонецФункции

Функция ЯчейкаАвтора(Знач СтрокаДоверия)

	Результат = Кит.Ячейка("величина");
	Результат.Добавить(Кит.Текст(Автор(СтрокаДоверия)));
	Возврат Результат;

КонецФункции

// «Кем и когда»: логин исчезнувшей учётки не выдумывается — остаётся только дата.
Функция Автор(Знач СтрокаДоверия)

	Когда = Даты.ТолькоДата(СтрокаДоверия.Доверие.Создано);
	Если СтрокаДоверия.Автор = Неопределено Тогда
		Возврат Когда;
	КонецЕсли;
	Возврат Строка(СтрокаДоверия.Автор.Логин) + ", " + Когда;

КонецФункции

// Значение подтверждения — идентификатор записи: форма одной строки не снимает соседнюю.
Функция ЯчейкаСнятия(Знач Бланк, Знач Идентификатор, Знач Описание)

	Форма = Бланки.Форма(Бланк)
		.Признак("confirm", Тексты.Шаблон("settings.package.ci.revoke.confirm", Описание))
		.Признак("confirm-field", "подтверждение")
		.Признак("confirm-value", Идентификатор);

	Форма.Добавить(Кит.СкрытоеПоле("операция", "отозвать"));
	Форма.Добавить(Кит.СкрытоеПоле("доверие", Идентификатор));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Тексты.Текст("settings.package.ci.button.revoke"), "опасная", "малый")));

	Результат = Кит.Ячейка();
	Результат.Добавить(Форма);
	Возврат Результат;

КонецФункции

Функция ОписаниеПоИдентификатору(Знач Пакет, Знач Идентификатор)

	Для Каждого Запись Из СервисДоверия.КонвейерыПакета(Пакет) Цикл
		Если Формат(Цел(Запись.Идентификатор), "ЧГ=0; ЧН=0") = Идентификатор Тогда
			Возврат СервисДоверия.ОписаниеЗаписи(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Идентификатор;

КонецФункции

// Маску, которая имени не ограничивает, список помечает: это «любая ветка репозитория».
Функция ЯчейкаРефа(Знач Маска)

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Код(Маска));

	Если Маски.СлишкомШирокая(Маска) Тогда
		Результат.Добавить(Кит.Текст(" "));
		Результат.Добавить(Кит.Плашка(Новый Структура("Текст, Вид",
			Тексты.Текст("settings.package.ci.ref.wide"), "warn")));
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("СписокДоверияCI")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "СервисДоверияCI") _СервисДоверия,
	&Пластилин(Значение = "МаскаРефа") _Маски,
	&Пластилин(Значение = "ПредставлениеПровайдераCI") _Провайдеры,
	&Пластилин(Значение = "КороткаяФормаДоверия") _КороткаяФорма,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "БланкРаздела") _Бланки,
	&Пластилин(Значение = "ПримечанияЭкрана") _Примечания,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	СервисДоверия = _СервисДоверия;
	Маски = _Маски;
	Провайдеры = _Провайдеры;
	КороткаяФорма = _КороткаяФорма;
	Тексты = _Тексты;
	Бланки = _Бланки;
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);
	Примечания = _Примечания;

КонецПроцедуры
