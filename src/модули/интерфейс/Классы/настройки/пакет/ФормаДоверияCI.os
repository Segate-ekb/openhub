// Форма заведения доверенного конвейера. ОДНО объявление полей питает и отрисовку окна,
// и разбор POST; набор полей задаёт выбранный тип репозитория.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем Фабрика;           // Формы (кит) — фабрика объявлений форм
Перем СервисДоверия;     // СервисДоверияCI (публикация) — словарь провайдеров
Перем Стража;            // СтражИздателейCI (публикация) — список издателей хаба
Перем Провайдеры;        // ПредставлениеПровайдераCI (web-ui) — подписи типов
Перем Сниппеты;          // СниппетыКонвейеров (web-ui) — чем запускается готовый конвейер
Перем Виды;              // ВидРефаДоверия (публикация) — виды рефа и предложение по значению
Перем Окна;              // ОкноФормы (web-ui) — каркас окна заведения
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Объявление формы заведения: какие поля, в каком порядке, с какими ограничениями
// и какие готовые блоки между ними. Читается сверху вниз, и по нему видно, что нарисуется.
// Репозиторий и реф обязательны, издателя хаб выводит из типа репозитория.
//
// Параметры:
//  Провайдер - Строка - выбранный тип репозитория: от него зависит, где стоит поле конвейера.
//  Адрес     - Строка - (необязательный, по умолчанию "") адрес раздела для блоков-ссылок;
//              разбору он не нужен — блоки в разбор не входят.
//
// Возвращаемое значение:
//  ОбъявлениеФормы - объявление, готовое и печатать, и разбирать.
//
Функция Объявление(Знач Провайдер, Знач Адрес = "") Экспорт

	Ф = Фабрика.Новая();
	Рамка = Новый Структура("Рамка", "вставка");

	// разбор ссылки — не отдельное действие, а ПЕРВЫЙ ШАГ формы: своя кнопка с операцией
	// «разобрать» и formnovalidate, потому что обязательные поля она как раз и заполняет
	Ф.Блок(ЗаголовокСсылки().Рендер(), Рамка)
		.Поле("ссылка", Тексты.Текст("settings.package.ci-link.label"), "строка",
			Новый Структура("Плейсхолдер, Подсказка, Рамка",
				"https://github.com/acme/lib/blob/main/.github/workflows/release.yml",
				Тексты.Текст("settings.package.ci-link.hint"), "вставка"))
		.Блок(КнопкаРазбора().Рендер(), Рамка)
		.Блок(ПереключательПровайдера(Адрес, Провайдер).Рендер())
		.Блок(Кит.СкрытоеПоле("провайдер", Провайдер).Рендер())
		.Поле("репозиторий", Тексты.Текст("settings.package.ci-new.repo.label"), "строка",
			Новый Структура("Обязательное, Плейсхолдер, Подсказка", Истина,
				ОбразецРепозитория(Провайдер), Тексты.Текст("settings.package.ci-new.repo.hint")));

	// у GitHub каталог workflow один и файлов в нём много — имя файла спрашивается прямо;
	// у GitLab путь к конфигу задаётся настройкой проекта, почти всегда дефолтный,
	// поэтому поле уезжает в «дополнительно» с готовым .gitlab-ci.yml
	Если НЕ ЭтоGitLab(Провайдер) Тогда
		Ф.Поле("конвейер", Тексты.Текст("settings.package.ci-new.workflow.label"), "строка",
			СвойстваКонвейера(Провайдер, ""));
	КонецЕсли;

	// и маска, и вид рефа приходят от готового конвейера этой же страницы: маска «v*»,
	// записанная веткой, дала бы refs/heads/v* — запись, которая не совпадёт ни с одним
	// запуском по тегу
	Ф.Поле("реф", Тексты.Текст("settings.package.ci-new.ref.label"), "строка",
			Новый Структура("Обязательное, Плейсхолдер, Подсказка", Истина,
				Сниппеты.МаскаТеговРелиза(), Тексты.Текст("settings.package.ci-new.ref.hint")))
		// умолчания у вида рефа нет сознательно: предвыбор объявлен флагом варианта,
		// а пустое значение остаётся пустым — распознать его дело сервиса
		.Поле("вид_рефа", Тексты.Текст("settings.package.ci-new.ref-kind.label"), "выбор",
			Новый Структура("Варианты, Подсказка", ВариантыВидаРефа(),
				Тексты.Текст("settings.package.ci-new.ref-kind.hint")))
		.Блок(Кит.Уведомление(Новый Структура("Текст, Вид",
			Тексты.Текст("settings.package.ci-new.ref.warning"), "warn")).Рендер());

	Если ЭтоGitLab(Провайдер) Тогда
		Ф.Поле("конвейер", Тексты.Текст("settings.package.ci-new.workflow.label"), "строка",
			СвойстваКонвейера(Провайдер, Тексты.Текст("settings.package.ci-new.advanced")));
	КонецЕсли;

	// издатель выводится из типа репозитория и в форме не нужен; он остаётся видимым
	// и правимым ради инсталляций, где издателей одного типа несколько
	Ф.Поле("издатель", Тексты.Текст("settings.package.ci-new.issuer.label"), "выбор",
		Новый Структура("Варианты, Подсказка, Кат", ВариантыИздателя(),
			Тексты.Текст("settings.package.ci-new.issuer.hint"),
			Тексты.Текст("settings.package.ci-new.advanced")));

	Возврат Ф;

КонецФункции

// Кнопка «Доверить конвейеру» и модальное окно с формой. Пока не нажали, форма места
// на экране не занимает; отбитая форма возвращается тем же окном — с набранным
// и помеченным полем. Скрипта здесь нет: открывает и закрывает окно движок браузера,
// а у экрана есть серверная дорога — тот же адрес с «form=1».
//
// Параметры:
//  Параметры - Структура:
//    * Адрес - Строка - адрес раздела (он же action формы);
//    * Токен - Строка - CSRF-токен сессии;
//    * Провайдер - Строка - выбранный тип репозитория;
//    * Заполнение - Структура, Соответствие, Неопределено - чем заполнить поля;
//    * Открыта - Булево - печатать окно открытым;
//    * Отказы - Соответствие - ключ поля -> текст отказа домена.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел-окно: кнопка открытия и <dialog> с формой.
//
Функция Окно(Знач Параметры) Экспорт

	Адрес = Параметры.Адрес;
	Состояние = Окна.Состояние(Параметры);

	Оформление = Окна.Оформление(Состояние, Тексты.Текст("settings.package.ci-new.title"),
		Тексты.Текст("settings.package.ci-new.lead"),
		Тексты.Текст("settings.package.ci-new.button"), "ключ");
	// операцию несёт САМА кнопка: у окна их две, и отправку от отмены отличает значение
	Оформление.Вставить("ИмяКнопки", "операция");
	Оформление.Вставить("ЗначениеКнопки", "доверить");

	Возврат Окна.Окно(Объявление(Параметры.Провайдер, Адрес), Состояние, Адрес,
		Параметры.Токен, Оформление);

КонецФункции

// Адрес раздела, по которому страница приходит с уже ОТКРЫТЫМ окном заведения. Кнопку
// команды старый движок не сработает, поэтому дорога к форме обязана быть серверной.
//
// Параметры:
//  Адрес     - Строка - адрес раздела.
//  Провайдер - Строка - тип репозитория, поля которого показать.
//
// Возвращаемое значение:
//  Строка
//
Функция АдресОткрытого(Знач Адрес, Знач Провайдер) Экспорт
	Возврат Адрес + ?(ЗначениеЗаполнено(Провайдер), "?ci=" + Провайдер + "&form=1", "?form=1");
КонецФункции

#КонецОбласти

#Область Разметка

// Запись по ссылке НЕ создаётся: разобранное показывается в форме и сверяется глазами.
Функция ЗаголовокСсылки()

	Результат = Кит.Холст();

	Заголовок = Результат.Добавить(Кит.Надпись("заголовок"));
	Заголовок.Добавить(Кит.Иконка("ссылка"));
	Заголовок.Добавить(Кит.Текст(Тексты.Текст("settings.package.ci-link.title")));

	Результат.Добавить(Кит.Надпись("лид"))
		.Добавить(Кит.Текст(Тексты.Текст("settings.package.ci-link.lead")));
	Возврат Результат;

КонецФункции

Функция КнопкаРазбора()

	Результат = Кит.Ряд("справа");
	Результат.Добавить(Кит.Кнопка(Новый Структура(
		"Подпись, Вариант, Размер, Иконка, Имя, Значение, БезВалидации",
		Тексты.Текст("settings.package.ci-link.button"), "вторичная", "малый", "палочка",
		"операция", "разобрать", Истина)));
	Возврат Результат;

КонецФункции

// Ссылки, а не <select>: от типа зависит НАБОР полей, а перерисовать его без перезагрузки нечем.
Функция ПереключательПровайдера(Знач Адрес, Знач Провайдер)

	Результат = Кит.Область("поле");
	Результат.Добавить(Кит.Надпись("метка"))
		.Добавить(Кит.Текст(Тексты.Текст("settings.package.ci-new.provider.label")));

	Пилюли = Результат.Добавить(Кит.Ряд("признаки"));
	Для Каждого Ключ Из СервисДоверия.ДопустимыеПровайдеры() Цикл
		Пилюли.Добавить(ПилюляПровайдера(Адрес, Ключ, Ключ = Провайдер));
	КонецЦикла;

	Результат.Добавить(Кит.Надпись("пояснение"))
		.Добавить(Кит.Текст(Тексты.Текст("settings.package.ci-new.provider.hint")));
	Возврат Результат;

КонецФункции

Функция ПилюляПровайдера(Знач Адрес, Знач Ключ, Знач Выбран)

	Результат = Кит.Ссылка(АдресОткрытого(Адрес, Ключ),
		?(Выбран, "пилюля-текущая", "пилюля"));
	Результат.Добавить(Кит.Текст(Провайдеры.Подпись(Ключ)));
	Возврат Результат;

КонецФункции

Функция СвойстваКонвейера(Знач Провайдер, Знач Кат)

	Возврат Новый Структура("Плейсхолдер, Подсказка, Умолчание, Кат",
		?(ЭтоGitLab(Провайдер), ".gitlab-ci.yml", "e2e.yml"),
		?(ЭтоGitLab(Провайдер), Тексты.Текст("settings.package.ci-new.workflow.hint.gitlab"),
			Тексты.Текст("settings.package.ci-new.workflow.hint")),
		?(ЭтоGitLab(Провайдер), ".gitlab-ci.yml", ""),
		Кат);

КонецФункции

// Пустой вариант первым: без выбора издателя его назначает тип репозитория.
Функция ВариантыИздателя()

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Значение, Подпись, Выбрано", "",
		Тексты.Текст("settings.package.ci-new.issuer.auto"), Истина));

	Для Каждого Издатель Из Стража.РазрешённыеИздатели() Цикл
		Результат.Добавить(Новый Структура("Значение, Подпись", Издатель, Издатель));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Пока вида не выбирали, стоит вид ЗАПУСКА готового конвейера: догадок по строке здесь нет.
Функция ВариантыВидаРефа()

	Вид = Сниппеты.ВидРефаЗапуска();

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Значение, Подпись, Выбрано", Виды.Ветка(),
		Тексты.Текст("settings.package.ci-new.ref-kind.branch"), Вид = Виды.Ветка()));
	Результат.Добавить(Новый Структура("Значение, Подпись, Выбрано", Виды.Тег(),
		Тексты.Текст("settings.package.ci-new.ref-kind.tag"), Вид = Виды.Тег()));
	Возврат Результат;

КонецФункции

Функция ЭтоGitLab(Знач Провайдер)
	Возврат Провайдер = СервисДоверия.ПровайдерGitLab();
КонецФункции

Функция ОбразецРепозитория(Знач Провайдер)
	Возврат ?(ЭтоGitLab(Провайдер), "acme/team/lib", "acme/lib");
КонецФункции

#КонецОбласти

&Прозвище("ФормаДоверияCI")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "Формы") _Фабрика,
	&Пластилин(Значение = "СервисДоверияCI") _СервисДоверия,
	&Пластилин(Значение = "СтражИздателейCI") _Стража,
	&Пластилин(Значение = "ПредставлениеПровайдераCI") _Провайдеры,
	&Пластилин(Значение = "СниппетыКонвейеров") _Сниппеты,
	&Пластилин(Значение = "ВидРефаДоверия") _Виды,
	&Пластилин(Значение = "ОкноФормы") _Окна,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Фабрика = _Фабрика;
	СервисДоверия = _СервисДоверия;
	Стража = _Стража;
	Провайдеры = _Провайдеры;
	Сниппеты = _Сниппеты;
	Виды = _Виды;
	Окна = _Окна;
	Тексты = _Тексты;

КонецПроцедуры
