// Готовые конвейеры публикации для GitHub Actions и GitLab CI: текст YAML с реальным
// адресом хаба, пулом и именем пакета. Разметки здесь нет — только текст сниппетов.

Перем Команды;    // КомандыOpm (web-ui) — безопасный разбор узла и схема внешнего адреса
Перем Виды;       // ВидРефаДоверия (публикация) — словарь видов рефа

#Область ПрограммныйИнтерфейс

// Внешний адрес хаба для сниппета: настройка «URL инстанса», а при незаданной — узел
// из заголовка Host. Оба источника проходят через КомандыOpm.Узел, поэтому в YAML
// уезжает только то, что вообще может быть узлом: адрес попадает внутрь чужого
// конвейера. Пустая строка означает, что адрес не определяется и показывать нечего:
// захардкоженный localhost в чужом конвейере не заработает.
//
// Параметры:
//  ЗаголовкиЗапроса - Соответствие, Неопределено - заголовки запроса.
//
// Возвращаемое значение:
//  Строка - «https://hub.example.org» либо «».
//
Функция БазовыйАдрес(Знач ЗаголовкиЗапроса) Экспорт

	Узел = Команды.Узел(ЗаголовкиЗапроса);
	Возврат ?(ЗначениеЗаполнено(Узел), Команды.СхемаАдреса() + "://" + Узел, "");

КонецФункции

// Конвейер GitHub Actions, публикующий пакет доверенным конвейером.
//
// Параметры:
//  Адрес - Строка - внешний адрес хаба (см. БазовыйАдрес).
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//  Аудитория - Строка - значение, которое хаб ждёт в клейме aud
//              (СервисДоверияCI.ОжидаемаяАудитория).
//
// Возвращаемое значение:
//  Строка - текст .github/workflows/publish.yml.
//
Функция GitHubActions(Знач Адрес, Знач ИмяПула, Знач ИмяПакета, Знач Аудитория) Экспорт

	Строки = Новый Массив();
	Строки.Добавить("name: publish");
	Строки.Добавить("on:");
	Строки.Добавить("  push:");
	Строки.Добавить("    tags: ['" + МаскаТеговРелиза() + "']");
	// без id-token: write заказать OIDC-токен нельзя — запрос вернёт 403
	Строки.Добавить("permissions:");
	Строки.Добавить("  contents: read");
	Строки.Добавить("  id-token: write");
	Строки.Добавить("jobs:");
	Строки.Добавить("  publish:");
	Строки.Добавить("    runs-on: ubuntu-latest");
	Строки.Добавить("    env:");
	// aud — не адрес хаба, а то, с чем хаб СВЕРЯЕТ клейм: администратор вправе задать
	// свою аудиторию, и напечатанный вместо неё адрес дал бы отказ на первой же публикации
	Строки.Добавить("      audience: " + Строка(Аудитория));
	Строки.Добавить("      hub: " + Строка(Адрес));
	Строки.Добавить("      pool: " + Строка(ИмяПула));
	Строки.Добавить("      package: " + Строка(ИмяПакета));
	Строки.Добавить("    steps:");
	Строки.Добавить("      - uses: actions/checkout@v4");
	// version у setup-onescript — обязательный вход
	Строки.Добавить("      - uses: otymko/setup-onescript@v1.5.1");
	Строки.Добавить("        with:");
	Строки.Добавить("          version: stable");
	Строки.Добавить("      - run: opm install " + ПакетOpm());
	Строки.Добавить("      - run: opm install -l && opm build .");
	Строки.Добавить("      - name: push");
	Строки.Добавить("        run: |");
	Строки.Добавить("          id_token=$(curl -sSf"
		+ " -H ""Authorization: bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN"" \");
	Строки.Добавить("            ""$ACTIONS_ID_TOKEN_REQUEST_URL&audience=$audience"""
		+ " | jq -r .value)");
	// имя файла собирается из ТЕГА, а не выбирается из каталога: `ls | head -n 1` брал первый
	// по алфавиту, и лишняя сборка рядом («0.10.0» раньше «0.9.0») публиковалась бы вместо
	// нужной. Заодно тег и версия пакета связаны: разойдясь, они падают здесь, в CI, а не
	// публикуют молча не ту версию, что помечена тегом
	Строки.Добавить("          version=""${GITHUB_REF_NAME#v}""");
	Строки.Добавить("          file=""${package}-${version}.ospx""");
	Строки.Добавить("          test -f ""$file"" || { echo ""tag $GITHUB_REF_NAME does not match"
		+ " the package version in packagedef""; exit 1; }");
	Строки.Добавить("          curl -sSf -X POST ""$hub/api/v1/pools/$pool/push"" \");
	Строки.Добавить("            -H ""OAUTH-TOKEN: $id_token"" \");
	Строки.Добавить("            -H ""FILE-NAME: $(basename $file)"" \");
	Строки.Добавить("            --data-binary ""@$file""");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Конвейер GitLab CI, публикующий пакет доверенным конвейером.
//
// Параметры:
//  Адрес - Строка - внешний адрес хаба (см. БазовыйАдрес).
//  ИмяПула - Строка - имя пула.
//  ИмяПакета - Строка - имя пакета.
//  Аудитория - Строка - значение, которое хаб ждёт в клейме aud
//              (СервисДоверияCI.ОжидаемаяАудитория).
//
// Возвращаемое значение:
//  Строка - текст .gitlab-ci.yml.
//
Функция GitLabCI(Знач Адрес, Знач ИмяПула, Знач ИмяПакета, Знач Аудитория) Экспорт

	Строки = Новый Массив();
	Строки.Добавить("publish:");
	Строки.Добавить("  stage: deploy");
	// без правила job идёт на КАЖДЫЙ пуш, а доверие выдано тегу релиза: каждая ветка
	// получала бы отказ 403 и красный пайплайн на ровном месте
	Строки.Добавить("  rules:");
	Строки.Добавить("    - if: $CI_COMMIT_TAG =~ " + РегвыражениеТеговРелиза());
	// на голом раннере OneScript нет — без образа script падает «opm: command not found»
	Строки.Добавить("  image: " + ОбразOneScript());
	Строки.Добавить("  variables:");
	Строки.Добавить("    hub: " + Строка(Адрес));
	Строки.Добавить("    pool: " + Строка(ИмяПула));
	Строки.Добавить("    package: " + Строка(ИмяПакета));
	// aud — не адрес хаба, а то, с чем хаб СВЕРЯЕТ клейм
	Строки.Добавить("  id_tokens:");
	Строки.Добавить("    OPENHUB_TOKEN:");
	Строки.Добавить("      aud: " + Строка(Аудитория));
	Строки.Добавить("  script:");
	Строки.Добавить("    - opm install " + ПакетOpm());
	Строки.Добавить("    - opm install -l && opm build .");
	// имя файла — из тега, см. GitHubActions
	Строки.Добавить("    - version=""${CI_COMMIT_TAG#v}""");
	Строки.Добавить("    - file=""${package}-${version}.ospx""");
	Строки.Добавить("    - test -f ""$file"" || { echo ""tag $CI_COMMIT_TAG does not match"
		+ " the package version in packagedef""; exit 1; }");
	Строки.Добавить("    - >");
	Строки.Добавить("      curl -sSf -X POST ""$hub/api/v1/pools/$pool/push""");
	Строки.Добавить("      -H ""OAUTH-TOKEN: $OPENHUB_TOKEN""");
	Строки.Добавить("      -H ""FILE-NAME: $(basename $file)""");
	Строки.Добавить("      --data-binary ""@$file""");

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Маска тегов, по которым запускается готовый конвейер. Её же предлагает поле «реф» формы
// заведения доверия: разойдясь, экран печатал бы конвейер, которому сам не доверяет —
// запись по ветке против клейма refs/tags/… не совпадёт никогда. Маска, а не «любой тег»:
// посторонний тег («test», «ci-check») иначе давал бы запуск и отказ 403.
//
// Возвращаемое значение:
//  Строка - глоб-маска короткого имени тега.
//
Функция МаскаТеговРелиза() Экспорт
	Возврат "v*";
КонецФункции

// Вид рефа, которым запускается готовый конвейер, — значение поля «вид рефа» формы
// заведения. Едет рядом с маской и меняется вместе с триггером конвейера: догадка по виду
// самой маски разъезжалась бы с ним на первом же «release-*».
//
// Возвращаемое значение:
//  Строка - «тег» либо «ветка».
//
Функция ВидРефаЗапуска() Экспорт
	Возврат Виды.Тег();
КонецФункции

// Версия opm, которую готовый конвейер ставит отдельным шагом. Шаг обязателен: на Linux
// setup-onescript принудительно ставит поверх дистрибутива opm 0.16.2, и без него сборка
// шла бы им. Одно значение на оба конвейера — иначе GitHub и GitLab соберут пакет по-разному.
//
// Возвращаемое значение:
//  Строка.
//
Функция ВерсияOpm() Экспорт
	Возврат "1.6.5";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПакетOpm()
	Возврат "opm@" + ВерсияOpm();
КонецФункции

// Та же маска для правила GitLab: там условие — регулярное выражение, и глоб-звезда
// в нём означала бы «сколько угодно предыдущих букв», то есть любой тег.
Функция РегвыражениеТеговРелиза()
	Возврат "/^" + СтрЗаменить(МаскаТеговРелиза(), "*", ".*") + "$/";
КонецФункции

// Официальный образ OneScript: тег latest — текущая стабильная версия, тот же смысл,
// что у `version: stable` экшена GitHub.
Функция ОбразOneScript()
	Возврат "evilbeaver/onescript:latest";
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КомандыOpm") _Команды,
	&Пластилин(Значение = "ВидРефаДоверия") _Виды)

	Команды = _Команды;
	Виды = _Виды;

КонецПроцедуры
