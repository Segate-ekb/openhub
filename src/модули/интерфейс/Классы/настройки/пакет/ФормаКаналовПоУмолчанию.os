// Окно визарда «Каналы по умолчанию» — желудь модуля web-ui: что будет заведено, по какому
// правилу и одна кнопка, которая это делает. Полей у формы нет: выбирать человеку нечего,
// поэтому окно показывает состав каждого канала и спрашивает согласие.

Перем Кит;      // Кит (oscript-ui) — окно, таблица и скрытые поля
Перем Фабрика;  // Формы (кит) — фабрика объявлений форм
Перем Каналы;   // КаналыПоУмолчанию (реестр) — что предлагается и по какому правилу
Перем Тексты;   // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Имя скрытого поля операции и её значение — ими пульт узнаёт отправку визарда.
//
// Возвращаемое значение:
//  Строка - значение операции.
//
Функция Операция() Экспорт
	Возврат "каналы_по_умолчанию";
КонецФункции

// Кнопка «Создать каналы по умолчанию» и модальное окно с предложением. Пока не нажали,
// окно места на экране не занимает; серверная дорога к нему — тот же адрес с «form=1».
//
// Параметры:
//  Параметры - Структура: * Адрес - Строка - адрес раздела (он же action формы); * Токен - Строка - CSRF-токен сессии; * Открыта - Булево - печатать окно открытым.
//
// Возвращаемое значение:
//  ЭлементЭкрана - кнопка открытия и <dialog> с предложением.
//
Функция Окно(Знач Параметры) Экспорт

	Открыта = Ложь;
	Параметры.Свойство("Открыта", Открыта);

	Объявление = Фабрика.Новая()
		.Блок(ТаблицаПредложения().Рендер())
		.Блок(Кит.СкрытоеПоле("операция", Операция()).Рендер());

	Возврат Кит.Окно(Объявление, Неопределено, Параметры.Адрес, Параметры.Токен,
		Оформление(Открыта = Истина));

КонецФункции

#КонецОбласти

#Область СоставПредложения

Функция ТаблицаПредложения()

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.tags.wizard.col.channel")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.tags.wizard.col.content")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.package.tags.wizard.col.rule")));

	Для Каждого Предложение Из Каналы.Предложения() Цикл
		Таблица.Добавить(ЗаписьПредложения(Предложение));
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция ЗаписьПредложения(Знач Предложение)

	Запись = Кит.Запись();
	Запись.Добавить(ЯчейкаИмени(Предложение));
	Запись.Добавить(ЯчейкаСостава(Предложение));
	Запись.Добавить(ЯчейкаПравила(Предложение));
	Возврат Запись;

КонецФункции

Функция ЯчейкаИмени(Знач Предложение)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Код(Предложение.Имя));
	Возврат Ячейка;

КонецФункции

// Состав канала — обещание словами; правило рядом с ним говорит то же машинным языком.
// Канал, номера которого разрешено переиздавать, называет это здесь же: у остальных
// каналов запрет на месте, и молчание об этом читалось бы как «везде одинаково».
Функция ЯчейкаСостава(Знач Предложение)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Текст(СоставСловами(Предложение.Имя)));

	Если Предложение.ПерезаписьРазрешена Тогда
		Ячейка.Добавить(Кит.Плашка(Новый Структура("Текст, Вид",
			Тексты.Текст("settings.package.tags.repush.allowed"), "warn")));
	КонецЕсли;

	Возврат Ячейка;

КонецФункции

// Список предлагаемых каналов ЗАКРЫТ, и у каждого здесь свои слова: ключ собирается
// перечислением, а не склейкой с именем канала, — склеенного ключа не видно ни в словаре,
// ни грепом.
Функция СоставСловами(Знач Имя)

	Если Имя = "stable" Тогда
		Возврат Тексты.Текст("settings.package.tags.wizard.stable");
	ИначеЕсли Имя = "prerelease" Тогда
		Возврат Тексты.Текст("settings.package.tags.wizard.prerelease");
	ИначеЕсли Имя = "develop" Тогда
		Возврат Тексты.Текст("settings.package.tags.wizard.develop");
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ЯчейкаПравила(Знач Предложение)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Код(Предложение.Правило));
	Возврат Ячейка;

КонецФункции

Функция Оформление(Знач Открыта)

	Результат = Новый Структура();
	Результат.Вставить("Заголовок", Тексты.Текст("settings.package.tags.wizard.title"));
	Результат.Вставить("Лид", Тексты.Текст("settings.package.tags.wizard.lead"));
	Результат.Вставить("Открывашка", Тексты.Текст("settings.package.tags.wizard.button"));
	Результат.Вставить("ИконкаОткрывашки", "тег");
	Результат.Вставить("Отмена", Тексты.Текст("settings.frame.cancel"));
	Результат.Вставить("Отправка", Тексты.Текст("settings.package.tags.wizard.submit"));
	Результат.Вставить("ИконкаОтправки", "куб");
	Результат.Вставить("Открыта", Открыта);
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ФормаКаналовПоУмолчанию")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "Формы") _Фабрика,
	&Пластилин(Значение = "КаналыПоУмолчанию") _Каналы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Фабрика = _Фабрика;
	Каналы = _Каналы;
	Тексты = _Тексты;

КонецПроцедуры
