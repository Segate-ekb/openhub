// Пульт дома «Пакет» — желудь модуля web-ui: какая мутация принадлежит какому разделу.

Перем Карточка;  // ПультКарточкиПакета (web-ui)
Перем Теги;      // ПультТеговПакета (web-ui)
Перем Версии;    // ПультВерсийПакета (web-ui)
Перем Права;     // ПультПравПакета (web-ui)

#Область ПубличныйИнтерфейс

// Есть ли у раздела мутация вовсе: разделу без неё POST не разрешён.
//
// Параметры:
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Булево - принимает ли раздел мутацию.
//
Функция ПринимаетМутацию(Знач Ключ) Экспорт
	Возврат Ключ = "card" ИЛИ Ключ = "versions" ИЛИ Ключ = "tags" ИЛИ Ключ = "access";
КонецФункции

// Применяет мутацию раздела дома «Пакет». Ключ раздела обязан принимать мутацию.
//
// Параметры:
//  Ключ - Строка - ключ раздела.
//  Пакет - Пакет - пакет раздела.
//  Пользователь - Пользователь, Неопределено - кто действует.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - Записано (Булево: Ложь — раздел перерисовывается вместо перенаправления),
//              Ошибка (Строка: текст уведомления, "" — уведомления нет),
//              Код (Число: статус перерисовки), Состояние (Структура, Неопределено:
//              состояние конструктора тега), Снятие (Структура, Неопределено: Тег и Версия,
//              снятие метки с которой ждёт подтверждения), Хвост (Строка: хвост адреса
//              перенаправления), Заведение (Структура, Неопределено: состояние окна раздела,
//              в которое возвращается отбитая форма: выдача роли в «Доступе», визард
//              каналов в «Тегах»), Предупреждение (Строка: текст жёлтой плашки — действие
//              удалось, но человеку есть что знать).
//
Функция Применить(Знач Ключ, Знач Пакет, Знач Пользователь, Знач Форма) Экспорт

	Если Ключ = "card" Тогда
		Карточка.Сохранить(Пакет, Форма);
		Возврат Записано();
	КонецЕсли;

	Если Ключ = "access" Тогда
		Итог = Права.Применить(Пользователь, Пакет, Форма);
		Возврат ?(НЕ ЗначениеЗаполнено(Итог.Ошибка), Записано(),
			ОтбитоеПраво(Итог.Ошибка, Итог.Заведение));
	КонецЕсли;

	Если Ключ = "versions" Тогда
		Итог = Версии.Применить(Пакет, Пользователь, Форма);
		Возврат ?(Итог.Записано, Записано(), Подтвердить(Итог.Снятие));
	КонецЕсли;

	Если Ключ = "tags" Тогда
		Итог = Теги.Применить(Пакет, Пользователь, Форма);
		Возврат Итог(Итог.Записано, Итог.Ошибка, Итог.Код, Итог.Состояние, Неопределено,
			Итог.Хвост, Итог.Визард, Итог.Предупреждение);
	КонецЕсли;

	// белый список разделов держит ПринимаетМутацию; разошлись — форма ушла бы в чужую
	// ветку молча, поэтому здесь отказ, а не последняя ветка «всё остальное»
	ВызватьИсключение СтрШаблон("Раздел ""%1"" мутации не принимает", Ключ);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Записано(Знач Хвост = "")
	Возврат Итог(Истина, "", 200, Неопределено, Неопределено, Хвост, Неопределено);
КонецФункции

Функция Подтвердить(Знач Снятие)
	Возврат Итог(Ложь, "", 200, Неопределено, Снятие, "", Неопределено);
КонецФункции

// Раздел перерисовывается, а не уводит редиректом: окно приходит открытым и помеченным.
Функция ОтбитоеПраво(Знач Ошибка, Знач Заведение)
	Возврат Итог(Ложь, Ошибка, 400, Неопределено, Неопределено, "", Заведение);
КонецФункции

Функция Итог(Знач Записано_, Знач Ошибка, Знач Код, Знач Состояние, Знач Снятие, Знач Хвост,
	Знач Заведение, Знач Предупреждение = "")

	Возврат Новый Структура(
		"Записано, Ошибка, Код, Состояние, Снятие, Хвост, Заведение, Предупреждение",
		Записано_, Ошибка, Код, Состояние, Снятие, Хвост, Заведение, Предупреждение);

КонецФункции

#КонецОбласти

&Прозвище("ПультПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПультКарточкиПакета") _Карточка,
	&Пластилин(Значение = "ПультТеговПакета") _Теги,
	&Пластилин(Значение = "ПультВерсийПакета") _Версии,
	&Пластилин(Значение = "ПультПравПакета") _Права) Экспорт

	Карточка = _Карточка;
	Теги = _Теги;
	Версии = _Версии;
	Права = _Права;

КонецПроцедуры
