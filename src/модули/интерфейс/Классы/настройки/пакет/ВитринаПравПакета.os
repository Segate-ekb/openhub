// Раздел «Права доступа» дома «Пакет». Разметку действующих ролей печатает общая
// ВитринаВыдачиРоли; здесь — объект раздела, подписи и справка о наследовании от пула.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем ВитринаВыдачи;     // ВитринаВыдачиРоли (web-ui) — секция действующих ролей
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секции раздела «права доступа» пакета.
//
// Параметры:
//  Параметры - Структура:
//    * Пакет - Пакет - пакет, права на который показываются;
//    * Адрес - Строка - адрес раздела (он же action форм);
//    * Токен - Строка - CSRF-токен сессии;
//    * МожетВыдавать - Булево - вправе ли смотрящий выдавать и отзывать права на этом пакете;
//    * АдресДоступаПула - Строка - адрес раздела пула, где правятся роли на весь пул;
//    * Заведение - Структура, Неопределено - состояние окна выдачи (Открыта, Заполнение, Отказы).
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	АдресПула = "";
	Параметры.Свойство("АдресДоступаПула", АдресПула);
	Заведение = Неопределено;
	Параметры.Свойство("Заведение", Заведение);

	Результат = Новый Массив();
	Результат.Добавить(ВитринаВыдачи.Секция(Раздел(Параметры.Пакет), Параметры.Адрес,
		Параметры.Токен, (Параметры.МожетВыдавать = Истина), Заведение));
	Результат.Добавить(СекцияНаследования(АдресПула));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СекцияНаследования

// Список выше показывает роли НА ПАКЕТЕ: без секции распорядитель выглядит взявшимся ниоткуда.
Функция СекцияНаследования(Знач АдресДоступаПула)

	Справка = Кит.Холст();
	Справка.Добавить(Кит.Примечание(Тексты.Текст("settings.package.access.inherited.note")));
	Справка.Добавить(СтрокаДоступаПула(АдресДоступаПула));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.package.access.inherited.title"),
		Тексты.Текст("settings.package.access.inherited.lead"), Справка.Рендер());
	Секция.Иконка = "аккаунт";
	// секция справочная: без «Действия» каркас не оборачивает её в форму
	Возврат Секция;

КонецФункции

// Адреса нет — нет и строки: пустой холст печатается пустой строкой.
Функция СтрокаДоступаПула(Знач АдресДоступаПула)

	Если НЕ ЗначениеЗаполнено(АдресДоступаПула) Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Строка_ = Кит.Примечание();
	Фраза = Строка_.Добавить(Кит.Шаблон(Тексты.Текст("settings.package.access.inherited.pool")));
	Фраза.Добавить(Кит.Ссылка(АдресДоступаПула))
		.Добавить(Кит.Текст(Тексты.Текст("settings.package.access.inherited.link")));
	Возврат Строка_;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Это всё, чем раздел прав пакета отличается от раздела прав пула.
Функция Раздел(Знач Пакет)

	Возврат Новый Структура("Вид, Идентификатор, Заголовок, Лид, Пусто, КолонкаДействия,"
			+ " Примечание, ТолькоЧтение, ЗаголовокОкна, ЛидОкна",
		"пакет", Пакет.Идентификатор,
		Тексты.Текст("settings.package.access.title"),
		Тексты.Текст("settings.package.access.lead"),
		Тексты.Текст("settings.package.access.empty"),
		Тексты.Текст("settings.package.access.col.action"),
		Тексты.Текст("settings.package.access.note"),
		Тексты.Текст("settings.package.access.readonly"),
		Тексты.Текст("settings.package.access-new.title"),
		Тексты.Текст("settings.package.access-new.lead"));

КонецФункции

#КонецОбласти

&Прозвище("ВитринаПравПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ВитринаВыдачиРоли") _ВитринаВыдачи,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	ВитринаВыдачи = _ВитринаВыдачи;
	Тексты = _Тексты;

КонецПроцедуры
