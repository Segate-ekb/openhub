// Карточка пакета и его опасная зона — желудь модуля web-ui: секции разделов «Карточка»
// и «Опасная зона» дома «Пакет». Экран собирается элементами кита.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секция карточки пакета.
//
// Параметры:
//  Пакет - Пакет - пакет раздела.
//  Адрес - Строка - адрес раздела (он же action формы).
//  Токен - Строка - CSRF-токен сессии.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция СекцияКарточки(Знач Пакет, Знач Адрес, Знач Токен) Экспорт

	Карточка = Кит.Холст();
	Карточка.Добавить(ПолеОписания(Пакет));
	Карточка.Добавить(ПолеКлючевыхСлов(Пакет));
	Карточка.Добавить(ПолеЛицензии(Пакет));
	Карточка.Добавить(ПолеРепозитория(Пакет));
	Карточка.Добавить(ТумблерУстаревшего(Пакет));
	Карточка.Добавить(ТумблерСкрытого(Пакет));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.package.card.title"),
		Тексты.Текст("settings.package.card.lead"), Карточка.Рендер());
	Секция.Иконка = "пакет";
	Секция.Действие = Адрес;
	Секция.Токен = Токен;
	Возврат Секция;

КонецФункции

// Секция опасной зоны: удалять пакет из дома нечем, поэтому она объясняет и ведёт
// на публичную страницу.
//
// Параметры:
//  Подпись - Строка - подпись ссылки на публичную страницу («пул/пакет»).
//  АдресПакета - Строка - адрес публичной страницы пакета.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция СекцияОпасной(Знач Подпись, Знач АдресПакета) Экспорт

	Зона = Кит.Холст();
	Зона.Добавить(Кит.Примечание(Тексты.Текст("settings.package.danger.note")));
	Зона.Добавить(СтрокаПубличнойСтраницы(Подпись, АдресПакета));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.package.danger.title"),
		Тексты.Текст("settings.package.danger.lead"), Зона.Рендер());
	Секция.Иконка = "предупреждение";
	Секция.Класс = "section--danger";
	Возврат Секция;

КонецФункции

#КонецОбласти

#Область ПоляКарточки

Функция ПолеОписания(Знач Пакет)
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Значение",
		"описание", Тексты.Текст("settings.package.card.description.label"), Пакет.Описание));
КонецФункции

Функция ПолеКлючевыхСлов(Знач Пакет)
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Значение, Подсказка",
		"ключевые_слова", Тексты.Текст("settings.package.card.keywords.label"),
		Пакет.КлючевыеСлова, Тексты.Текст("settings.package.card.keywords.hint")));
КонецФункции

Функция ПолеЛицензии(Знач Пакет)
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Значение",
		"лицензия", Тексты.Текст("settings.package.card.license.label"), Пакет.Лицензия));
КонецФункции

Функция ПолеРепозитория(Знач Пакет)
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Значение, Подсказка",
		"репозиторий", Тексты.Текст("settings.package.card.repo.label"), Пакет.АдресРепозитория,
		Тексты.Текст("settings.package.card.repo.hint")));
КонецФункции

// «Выключено» доезжает парным скрытым полем, поэтому чтение формы уже сравнивающее.
Функция ТумблерУстаревшего(Знач Пакет)
	Возврат Кит.Тумблер(Новый Структура("Имя, Метка, Включено, Подсказка",
		"устарел", Тексты.Текст("settings.package.card.deprecated.label"),
		Пакет.Устарел = Истина, Тексты.Текст("settings.package.card.deprecated.hint")));
КонецФункции

Функция ТумблерСкрытого(Знач Пакет)
	Возврат Кит.Тумблер(Новый Структура("Имя, Метка, Включено, Подсказка",
		"скрыт", Тексты.Текст("settings.package.card.hidden.label"),
		Пакет.Скрыт = Истина, Тексты.Текст("settings.package.card.hidden.hint")));
КонецФункции

#КонецОбласти

#Область ОпаснаяЗона

// Ссылка занимает место в фразе словаря, а не приклеивается к ней.
Функция СтрокаПубличнойСтраницы(Знач Подпись, Знач АдресПакета)

	Примечание = Кит.Примечание();
	Фраза = Примечание.Добавить(Кит.Шаблон(Тексты.Текст("settings.package.danger.public")));
	Фраза.Добавить(Кит.Ссылка(АдресПакета)).Добавить(Кит.Текст(Подпись));
	Возврат Примечание;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаКарточкиПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Тексты = _Тексты;

КонецПроцедуры
