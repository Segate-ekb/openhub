// Выдача и отзыв ролей на ОДИН пакет, заданный маршрутом. Ход операции общий с пулом
// и живёт в ПультВыдачиРоли; здесь — объект раздела и слова, которыми он отказывает.

Перем Выдача;  // ПультВыдачиРоли (web-ui) — выдача и отзыв роли на объект раздела
Перем Тексты;  // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Вправе ли пользователь выдавать и отзывать права на этом пакете. Порог — мейнтейнер
// самого пакета и выше; управления пакетом (порог дома настроек) для этого мало.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - инициатор.
//  Пакет - Пакет - пакет раздела.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетВыдавать(Знач Пользователь, Знач Пакет) Экспорт
	Возврат Выдача.МожетВыдавать(Пользователь, Раздел(Пакет));
КонецФункции

// Применяет операцию раздела «права доступа» дома «Пакет».
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Пакет - Пакет - пакет раздела.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - итог операции; состав полей — см. ПультВыдачиРоли.Применить.
//
Функция Применить(Знач Пользователь, Знач Пакет, Знач Форма) Экспорт
	Возврат Выдача.Применить(Пользователь, Раздел(Пакет), Форма);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Это всё, чем выдача роли на пакет отличается от выдачи роли на пул.
Функция Раздел(Знач Пакет)

	Возврат Новый Структура("Вид, Идентификатор, ЧужойОбъект, НеизвестныйСубъект, НеСохранено",
		"пакет", Пакет.Идентификатор,
		Тексты.Текст("settings.package.access.error.object"),
		Тексты.Текст("settings.package.access.error.subject"),
		Тексты.Текст("settings.package.error.save"));

КонецФункции

#КонецОбласти

&Прозвище("ПультПравПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПультВыдачиРоли") _Выдача,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Выдача = _Выдача;
	Тексты = _Тексты;

КонецПроцедуры
