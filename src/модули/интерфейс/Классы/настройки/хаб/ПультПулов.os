// Пульт пулов — желудь модуля web-ui: операции раздела «Пулы» дома «Хаб» —
// заведение пула, назначение основного и правка квоты с видимостью.

Перем РазборФормы;    // РазборФормы (web-ui)
Перем СлужбаДоступа;  // СлужбаДоступа (кабинет) — доменные создание пула и назначение основного
Перем СервисПулов;    // СервисПулов (реестр) — вердикт по квоте, запись квоты и видимости
Перем ГвардКвоты;     // ГвардКвотыПула (auth) — квоту назначает администратор хаба
Перем Витрина;        // ВитринаПулов (web-ui) — имена полей, значения операций, хвост отбора
Перем Формы;          // ФормаСозданияПула (web-ui) — объявление полей формы заведения
Перем Дом;            // ДомХаба (web-ui) — адрес раздела для возврата
Перем ФабрикаИтога;   // ИтогПульта (web-ui) — единая форма итога операции
Перем Числа;          // ПриведениеЧисел (основа) — терпимое чтение числа
Перем Ошибки;         // ТекстОшибки (основа) — краткая причина без служебной обёртки
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Разбирает POST раздела и, если он касается пулов, выполняет операцию сам.
//
// Параметры:
//  Раздел - Строка - ключ раздела дома «Хаб».
//  Форма - Соответствие - разобранная форма.
//  Пользователь - Пользователь - инициатор (его правами судит домен).
//
// Возвращаемое значение:
//  Структура - Перехвачено (Булево: Ложь — раздел обрабатывается общим путём),
//              Ошибка (Строка: "" — отказа нет), Спросить (Неопределено — окна нет),
//              Уведомление (Строка), Окно (Неопределено), Адрес (Строка: куда
//              перенаправить после удачной операции; "" — перерисовать раздел),
//              Статус (Число: код ответа при отказе; 0 — обычный 400),
//              Заведение (Структура, Неопределено: Открыта, Заполнение и Отказы окна
//              заведения, в которое возвращается отбитая форма).
//
Функция Применить(Знач Раздел, Знач Форма, Знач Пользователь) Экспорт

	Если Раздел <> "pools" Тогда
		Возврат Мимо();
	КонецЕсли;

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, Витрина.ИмяПоляОперации())));
	Отбор = РазборФормы.Поле(Форма, "q");

	Если Операция = Витрина.ОперацияСоздания() Тогда
		Возврат Создать(Форма, Пользователь, Отбор);
	ИначеЕсли Операция = Витрина.ОперацияОсновного() Тогда
		Возврат НазначитьОсновным(Форма, Пользователь, Отбор);
	ИначеЕсли Операция = Витрина.ОперацияКвоты() Тогда
		Возврат ПрименитьКвоту(Форма, Пользователь, Отбор);
	КонецЕсли;

	Возврат Мимо();

КонецФункции

#КонецОбласти

#Область Операции

// Право создания судит служба доступа: у раздела свой порог (админ хаба), у операции — свой.
// Поля здесь не перечисляются: их называет ОБЪЯВЛЕНИЕ формы, которое печатает те же поля
// в окне, оно же приводит значения и возвращает набранное.
Функция Создать(Знач Форма, Знач Пользователь, Знач Отбор)

	Разбор = Формы.Объявление().Разобрать(Форма);
	Если НЕ Разбор.Принято Тогда
		Возврат ФабрикаИтога.ОтказЗаведения(Разбор.Отказ, Разбор.Показ, Разбор.Отказы);
	КонецЕсли;

	Вердикт = СервисПулов.РассудитьКвоту(Значением(Разбор.Значения, "квота_мб"));
	Если НЕ Вердикт.Ок Тогда
		Возврат ОтказПоля("квота_мб", ПроблемаКвоты(Вердикт), Разбор.Показ);
	КонецЕсли;

	Попытка
		СлужбаДоступа.СоздатьПул(Пользователь,
			Значением(Разбор.Значения, "имя"),
			Значением(Разбор.Значения, "тип"),
			Значением(Разбор.Значения, "видимость"),
			Вердикт.Квота);
	Исключение
		// имя — единственное поле, которым отказ домена правится: занятое имя, системный
		// сегмент, запрещённый символ
		Возврат ОтказПоля("имя", Тексты.Шаблон("access.pools.create.failed",
			Ошибки.Кратко(ОписаниеОшибки())), Разбор.Показ);
	КонецПопытки;

	Возврат Готово(Отбор);

КонецФункции

Функция НазначитьОсновным(Знач Форма, Знач Пользователь, Знач Отбор)

	Попытка
		СлужбаДоступа.НазначитьОсновнойПул(Пользователь, ИдентификаторПула(Форма));
	Исключение
		Возврат Отказ(Тексты.Шаблон("access.pools.default.failed",
			Ошибки.Кратко(ОписаниеОшибки())));
	КонецПопытки;

	Возврат Готово(Отбор);

КонецФункции

// Сначала право, потом вердикт по ВСЕМУ вводу, и только потом записи: обе они правят
// один пул, и отказ второй оставил бы применённой первую. Право на квоту спрашивается
// у СВОЕГО гварда — разойдутся предикаты, разойдётся и этот экран.
Функция ПрименитьКвоту(Знач Форма, Знач Пользователь, Знач Отбор)

	Если НЕ ГвардКвоты.МожетМенятьКвоту(Пользователь) Тогда
		Возврат Запрещено(ГвардКвоты.ПричинаОтказа());
	КонецЕсли;

	ИдПула = ИдентификаторПула(Форма);
	Если ИдПула = 0 Тогда
		Возврат Отказ(Тексты.Текст("settings.hub.pools.quota.error.pool"));
	КонецЕсли;

	Вердикт = СервисПулов.РассудитьКвоту(РазборФормы.Поле(Форма, "квота_мб"));
	Если НЕ Вердикт.Ок Тогда
		Возврат Отказ(ПроблемаКвоты(Вердикт));
	КонецЕсли;

	Видимость = РазборФормы.Поле(Форма, "видимость", "public");
	Проблема = СервисПулов.ПроблемаВидимости(ИдПула, Видимость);
	Если ЗначениеЗаполнено(Проблема) Тогда
		Возврат Отказ(Тексты.Шаблон("settings.hub.pools.quota.error.apply",
			Ошибки.Кратко(Проблема)));
	КонецЕсли;

	Попытка
		СервисПулов.УстановитьКвоту(ИдПула, Вердикт.Квота);
		СервисПулов.УстановитьВидимость(ИдПула, Видимость);
	Исключение
		Возврат Отказ(Тексты.Шаблон("settings.hub.pools.quota.error.apply",
			Ошибки.Кратко(ОписаниеОшибки())));
	КонецПопытки;

	Возврат Готово(Отбор);

КонецФункции

// Отказ вердикта — словами. Сам вердикт выносит СервисПулов: и правка, и создание,
// и дом настроек пула, и PATCH API судят ввод им одним, третьего источника правила нет.
Функция ПроблемаКвоты(Знач Вердикт)

	Если Вердикт.Причина = СервисПулов.ПричинаКвотаПотолок() Тогда
		Возврат Тексты.Шаблон("settings.hub.pools.quota.error.cap",
			Формат(СервисПулов.ПредельнаяКвотаМб(), "ЧГ=' '"));
	КонецЕсли;
	Возврат Тексты.Текст("settings.hub.pools.quota.error.number");

КонецФункции

Функция Значением(Знач Значения, Знач Ключ)
	Найденное = Значения.Получить(Ключ);
	Возврат ?(Найденное = Неопределено, "", Строка(Найденное));
КонецФункции

Функция ИдентификаторПула(Знач Форма)
	Возврат Числа.ЧислоИлиНоль(РазборФормы.Поле(Форма, Витрина.ИмяПоляПула()));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Удача уходит редиректом, а отбор обязан пережить мутацию — иначе администратор
// возвращается к полному списку.
Функция Готово(Знач Отбор)
	Возврат ФабрикаИтога.Переход(
		Дом.АдресРаздела("pools") + "?saved=1" + Витрина.ХвостОтбора(Отбор));
КонецФункции

Функция Отказ(Знач Текст)
	Возврат ФабрикаИтога.Отказ(Текст);
КонецФункции

// Отказ домена приходит в поле тем же путём, что и отказ проверки: помеченным полем
// в открытом окне, а не одним баннером над съеденной формой.
Функция ОтказПоля(Знач Ключ, Знач Текст, Знач Набранное)
	Отказы = Новый Соответствие();
	Отказы.Вставить(Ключ, Текст);
	Возврат ФабрикаИтога.ОтказЗаведения(Текст, Набранное, Отказы);
КонецФункции

Функция Запрещено(Знач Текст)
	Возврат ФабрикаИтога.Запрещено(Текст);
КонецФункции

Функция Мимо()
	Возврат ФабрикаИтога.Мимо();
КонецФункции

#КонецОбласти

&Прозвище("ПультПулов")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СлужбаДоступа") _СлужбаДоступа,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ГвардКвотыПула") _ГвардКвоты,
	&Пластилин(Значение = "ВитринаПулов") _Витрина,
	&Пластилин(Значение = "ФормаСозданияПула") _Формы,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ИтогПульта") _ФабрикаИтога,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	СлужбаДоступа = _СлужбаДоступа;
	СервисПулов = _СервисПулов;
	ГвардКвоты = _ГвардКвоты;
	Витрина = _Витрина;
	Формы = _Формы;
	Дом = _Дом;
	ФабрикаИтога = _ФабрикаИтога;
	Числа = _Числа;
	Ошибки = _Ошибки;
	Тексты = _Тексты;

КонецПроцедуры
