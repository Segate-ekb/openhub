// Поля настроек — желудь модуля web-ui: одна карточка реестра элементами экрана
// (управление, витрина, метка, подсказка, строка источника значения).

Перем Реестр;  // РеестрНастроек (настройки) — допустимые значения перечислений и имя переменной
Перем Кит;     // Кит (oscript-ui) — фабрика элементов экрана
Перем Тексты;  // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Имя поля формы для настройки — одна точка на рендер и на разбор.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - имя поля формы для настройки.
//
Функция ИмяПоля(Знач Ключ) Экспорт
	Возврат НРег(СокрЛП(Строка(Ключ)));
КонецФункции

// Значение тумблера «включено» (его же читает РазборФормы.Флажок).
//
// Возвращаемое значение:
//  Строка - значение тумблера «включено».
//
Функция ЗначениеВключено() Экспорт
	Возврат "1";
КонецФункции

// Имя скрытого поля с операцией раздела («» — сохранение, «сбросить» — уборка записи).
//
// Возвращаемое значение:
//  Строка - имя скрытого поля с операцией раздела.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Имя скрытого поля с ключом настройки (операция «сбросить»).
//
// Возвращаемое значение:
//  Строка - имя скрытого поля с ключом настройки.
//
Функция ИмяПоляКлюча() Экспорт
	Возврат "ключ";
КонецФункции

// Значение операции «сбросить введённое руками значение».
//
// Возвращаемое значение:
//  Строка - значение операции «сбросить введённое руками значение».
//
Функция ОперацияСброса() Экспорт
	Возврат "сбросить";
КонецФункции

// Ключ словаря для метки/подсказки настройки.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//  Роль - Строка - «label» либо «hint».
//
// Возвращаемое значение:
//  Строка - ключ словаря вида «settings.key.oshub-storage-root.label».
//
Функция КлючТекста(Знач Ключ, Знач Роль) Экспорт

	Переменная = Реестр.ПеременнаяОкружения(Ключ);
	// «__» — экранированное подчёркивание сегмента (конвенция configor), поэтому оно первым
	Основа = НРег(СтрЗаменить(СтрЗаменить(Строка(Переменная), "__", "-"), "_", "-"));
	Возврат "settings.key." + Основа + "." + Роль;

КонецФункции

// Человеческая метка настройки из словаря.
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//
// Возвращаемое значение:
//  Строка - человеческая метка настройки из словаря.
//
Функция Метка(Знач Карточка) Экспорт
	Возврат Тексты.Текст(КлючТекста(Карточка.Ключ, "label"));
КонецФункции

// Действующее значение в форме, пригодной для сравнения с вводом: неизменённое не пишется.
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//
// Возвращаемое значение:
//  Строка - действующее значение в форме, пригодной для сравнения с вводом.
//
Функция ЗначениеДляСравнения(Знач Карточка) Экспорт

	Если Карточка.Тип = "булево" Тогда
		Возврат ?(Карточка.Значение = Истина, ЗначениеВключено(), "0");
	КонецЕсли;
	Если Карточка.Тип = "целое" Тогда
		// тем же форматом, что печатается в поле (ЧислоТекстом): Строка() локалезависима
		Возврат Тексты.ЧислоТекстом(Карточка.Значение);
	КонецЕсли;
	Возврат СокрЛП(Строка(Карточка.Значение));

КонецФункции

// Редактируемое поле: вид управления выбирается ТИПОМ настройки из реестра.
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//
// Возвращаемое значение:
//  ЭлементЭкрана - поле правки.
//
Функция ПолеПравки(Знач Карточка) Экспорт

	ТекстПодсказки = Подсказка(Карточка);

	Если Карточка.Тип = "булево" Тогда
		Возврат Кит.Тумблер(Новый Структура("Имя, Метка, Включено, Подсказка",
			ИмяПоля(Карточка.Ключ), Метка(Карточка), Карточка.Значение = Истина, ТекстПодсказки));
	КонецЕсли;

	Если Карточка.Секрет Тогда
		// поле секрета ВСЕГДА пустое: право задать значение не есть право прочитать его.
		// Пустое поле означает «оставить как есть» — стирает значение действие сброса
		Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Подсказка",
			ИмяПоля(Карточка.Ключ), Метка(Карточка), "пароль", "", ПодсказкаСекрета(Карточка)));
	КонецЕсли;

	// значение поля — ровно то, что контроллер считает прежним (не ЗначениеТекстом: «не задано»)
	Значение = ЗначениеДляСравнения(Карточка);

	Допустимые = ДопустимыеЗначения(Карточка.Ключ);
	Если Допустимые.Количество() > 0 Тогда
		Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Варианты, Значение, Подсказка",
			ИмяПоля(Карточка.Ключ), Метка(Карточка), "выбор", Допустимые, Значение, ТекстПодсказки));
	КонецЕсли;

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Подсказка",
		ИмяПоля(Карточка.Ключ), Метка(Карточка), ?(Карточка.Тип = "целое", "число", "текст"),
		Значение, ТекстПодсказки));

КонецФункции

// Поле занятой ручки: настройка правится из интерфейса, но сейчас её перебила
// конфигурация — то же место и та же подпись, действующее значение, объяснение вместо ввода.
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//
// Возвращаемое значение:
//  ЭлементЭкрана - непрáвимое поле.
//
Функция ПолеЗанятое(Знач Карточка) Экспорт

	Если Карточка.Тип = "булево" Тогда
		// тумблер вместо запертой строки: занятая ручка выглядит той же ручкой
		Возврат Кит.Тумблер(Новый Структура("Метка, Включено, Подсказка, Заблокировано",
			Метка(Карточка), Карточка.Значение = Истина, Подсказка(Карточка), Истина));
	КонецЕсли;

	Возврат Кит.ПолеИзКонфига(
		Новый Структура("Метка, Значение, Деталька, Переменная, Подсказка, Секрет",
			Метка(Карточка), ЗначениеТекстом(Карточка), Карточка.Ключ, Карточка.Переменная,
			?(Карточка.Секрет, ПодсказкаСекрета(Карточка), Подсказка(Карточка)),
			Карточка.Секрет));

КонецФункции

// Строка «откуда взято действующее значение»: плашка источника и имя настройки.
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//
// Возвращаемое значение:
//  ЭлементЭкрана - строка источника.
//
Функция СтрокаИсточника(Знач Карточка) Экспорт

	// ключ и источник — в соседних признаках одного узла, иначе сторож зеленеет не на той настройке
	Источник = Кит.Примечание("", "источник");
	Источник.Признак("setting", Карточка.Ключ);
	Источник.Признак("source", ЛатинскийИсточник(Карточка.Источник));

	Источник.Добавить(ПлашкаИсточника(Карточка.Источник));
	Источник.Добавить(ИмяНастройки(Карточка.Ключ));
	Возврат Источник;

КонецФункции

// Значение карточки для показа: булево — словами, пустая строка — «не задано».
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//
// Возвращаемое значение:
//  Строка - значение карточки для показа.
//
Функция ЗначениеТекстом(Знач Карточка) Экспорт

	Если Карточка.Секрет Тогда
		// в карточке уже маска, настоящего значения здесь не бывает
		Возврат ?(ЗначениеЗаполнено(Карточка.Значение), Строка(Карточка.Значение),
			Тексты.Текст("settings.value.empty"));
	КонецЕсли;

	Если Карточка.Тип = "булево" Тогда
		Возврат ?(Карточка.Значение = Истина,
			Тексты.Текст("settings.value.yes"), Тексты.Текст("settings.value.no"));
	КонецЕсли;

	Если Карточка.Тип = "целое" Тогда
		Возврат Тексты.ЧислоТекстом(Карточка.Значение);
	КонецЕсли;

	Значение = СокрЛП(Строка(Карточка.Значение));
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, Тексты.Текст("settings.value.empty"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Плашка «конфигурация / база / умолчание»: тремя словами о том, почему значение такое.
Функция ПлашкаИсточника(Знач Источник)

	Если Источник = "конфиг" Тогда
		Подпись = Тексты.Текст("settings.source.config");
		Вид = "accent";
	ИначеЕсли Источник = "база" Тогда
		Подпись = Тексты.Текст("settings.source.db");
		Вид = "ok";
	Иначе
		Подпись = Тексты.Текст("settings.source.default");
		Вид = "";
	КонецЕсли;

	Возврат Кит.Плашка(Новый Структура("Текст, Вид, Иконка", Подпись, Вид, "инфо"));

КонецФункции

// Машинным значением: имя набирают в переменной окружения, и оно читается посимвольно.
Функция ИмяНастройки(Знач Ключ)

	Имя = Кит.Надпись("ключ");
	Имя.Добавить(Кит.Код(Ключ));
	Возврат Имя;

КонецФункции

// Значение инсталляции сюда не доходит: на экран настроек оно не выходит вовсе.
Функция Подсказка(Знач Карточка)

	Назначение = Тексты.Текст(КлючТекста(Карточка.Ключ, "hint"));
	Если НЕ Карточка.Форсирована Тогда
		Возврат Назначение;
	КонецЕсли;

	Возврат Назначение + " " + Тексты.Шаблон("settings.value.locked.forced",
		Карточка.Ключ, Карточка.Переменная);

КонецФункции

// Подсказка поля секрета: назначение плюс состояние «задано / не задано» — но не значение.
Функция ПодсказкаСекрета(Знач Карточка)

	Состояние = ?(ЗначениеЗаполнено(Карточка.Значение),
		Тексты.Текст("settings.value.secret.set"), Тексты.Текст("settings.value.secret.empty"));

	Возврат Подсказка(Карточка) + " " + Состояние;

КонецФункции

// Допустимые значения перечисления из реестра (пусто — свободный ввод).
Функция ДопустимыеЗначения(Знач Ключ)

	Результат = Новый Массив();

	Валидатор = Реестр.Описание(Ключ).Валидатор;
	Если Валидатор = Неопределено ИЛИ Валидатор.Вид <> "перечисление" Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Допустимое Из Валидатор.Значения Цикл
		Результат.Добавить(Новый Структура("Значение, Подпись",
			СокрЛП(Допустимое), СокрЛП(Допустимое)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Значение источника для атрибута разметки — латиницей (ЭкранированиеHTML режет остальное).
Функция ЛатинскийИсточник(Знач Источник)

	Если Источник = "конфиг" Тогда
		Возврат "config";
	ИначеЕсли Источник = "база" Тогда
		Возврат "database";
	КонецЕсли;
	Возврат "default";

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РеестрНастроек") _Реестр,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Реестр = _Реестр;
	Кит = _Кит;
	Тексты = _Тексты;

КонецПроцедуры
