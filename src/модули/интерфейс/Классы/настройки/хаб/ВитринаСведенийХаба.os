// Секции разделов дома «Хаб», править в которых нечего: версия сборки, основной пул,
// требования к паролю, счётчики обслуживания и дороги к экранам на своих адресах.

Перем Кит;                 // Кит (кит) — фабрика элементов экрана
Перем Каркас;              // РендерерНастроек (кит) — заготовка секции
Перем ОписаниеПриложения;  // ОписаниеПриложения (запуск)
Перем СервисПулов;         // СервисПулов (реестр)
Перем ПолитикаПароля;      // ПолитикаПароля (auth)
Перем Пользователи;        // ХранилищеПользователей (данные)
Перем ЗеркалаКабинета;     // ВитринаЗеркалКабинета (web-ui) — адрес обзора зеркал
Перем Тексты;              // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Секция версии сборки.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция СекцияВерсии() Экспорт

	Возврат Оформить(Тексты.Текст("settings.hub.version.title"),
		Тексты.Текст("settings.hub.version.lead"), ВерсияСборки(), "куб");

КонецФункции

// Секция основного пула. Основной пул — не запись реестра, а признак на самом пуле;
// здесь он только показывается, чтобы администратор видел действующее значение рядом
// с прочими правилами пулов.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция СекцияОсновногоПула() Экспорт

	Возврат Оформить(Тексты.Текст("settings.hub.pools.main.title"),
		Тексты.Текст("settings.hub.pools.main.lead"), ОсновнойПул(), "куб");

КонецФункции

// Секция требований к паролю.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция СекцияПароля() Экспорт

	Политика = Кит.Холст();
	Политика.Добавить(ТребованияКПаролю());
	Политика.Добавить(Кит.Примечание(Тексты.Текст("settings.hub.password.note")));

	Возврат Оформить(Тексты.Текст("settings.hub.password.title"),
		Тексты.Текст("settings.hub.password.lead"), Политика, "замок");

КонецФункции

// Секция со ссылками на экраны, которые пока живут на прежних адресах.
//
// Параметры:
//  Экраны - Массив - описания экранов (Подпись, Адрес).
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция СекцияПрежнихЭкранов(Знач Экраны) Экспорт

	Возврат Оформить(Тексты.Текст("settings.hub.screens.title"),
		Тексты.Текст("settings.hub.screens.lead"), ДорогиКЭкранам(Экраны), "ссылка");

КонецФункции

// Секция-дорога к обзору зеркал всех пулов. Обзор живёт на своём адресе, пункта в дереве
// разделов у него нет, а ищут его здесь — в разделе, где настроено зеркалирование.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция СекцияОбзораЗеркал() Экспорт

	Возврат Оформить(Тексты.Текст("settings.hub.mirrors.overview.title"),
		Тексты.Текст("settings.hub.mirrors.overview.lead"), КнопкаОбзораЗеркал(), "копировать");

КонецФункции

// Секция счётчиков обслуживания.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция СекцияОбслуживания() Экспорт

	Возврат Оформить(Тексты.Текст("settings.hub.metrics.title"),
		Тексты.Текст("settings.hub.metrics.lead"), ТаблицаСчётчиков(), "шестерёнка");

КонецФункции

#КонецОбласти

#Область ЗапертыеЗначения

Функция ВерсияСборки()

	Возврат ЗапертоеПоле(Тексты.Текст("settings.hub.identity.version.label"),
		ОписаниеПриложения.Версия(), Тексты.Текст("settings.hub.identity.version.hint"));

КонецФункции

Функция ОсновнойПул()

	Возврат ЗапертоеПоле(Тексты.Текст("settings.hub.pools.main.label"), ИмяОсновногоПула(),
		Тексты.Текст("settings.hub.pools.main.hint"));

КонецФункции

// Пул, в который попадает пакет, не назвавший пула. Его может не быть вовсе.
Функция ИмяОсновногоПула()

	Основной = СервисПулов.ДефолтныйПул();
	Возврат ?(Основной = Неопределено, Тексты.Текст("settings.hub.pools.main.none"),
		Строка(Основной.Имя));

КонецФункции

Функция ЗапертоеПоле(Знач Метка, Знач Значение, Знач Подсказка)

	Возврат Кит.Поле(Новый Структура("Метка, Значение, Заблокировано, Подсказка",
		Метка, Значение, Истина, Подсказка));

КонецФункции

#КонецОбласти

#Область Списки

Функция ТребованияКПаролю()

	Пункты = Новый Массив();
	Для Каждого Требование Из ПолитикаПароля.Требования() Цикл
		Пункты.Добавить(Кит.Текст(Требование));
	КонецЦикла;
	Возврат Перечень(Пункты);

КонецФункции

Функция ДорогиКЭкранам(Знач Экраны)

	Пункты = Новый Массив();
	Для Каждого Экран Из Экраны Цикл
		Пункты.Добавить(ДорогаКЭкрану(Экран));
	КонецЦикла;
	Возврат Перечень(Пункты);

КонецФункции

Функция ДорогаКЭкрану(Знач Экран)

	Результат = Кит.Ссылка(Экран.Адрес);
	Результат.Добавить(Кит.Текст(Экран.Подпись));
	Возврат Результат;

КонецФункции

// Мелкий приглушённый список под полем: строка требования либо ссылка на экран.
Функция Перечень(Знач Содержимое)

	Список = Кит.Список("сноска");
	Для Каждого Элемент Из Содержимое Цикл
		Пункт = Список.Добавить(Кит.Пункт());
		Пункт.Добавить(Элемент);
	КонецЦикла;
	Возврат Список;

КонецФункции

#КонецОбласти

#Область Показ

Функция КнопкаОбзораЗеркал()

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Иконка",
		Тексты.Текст("settings.hub.mirrors.overview.button"), ЗеркалаКабинета.АдресОбзора(),
		"вторичная", "копировать"));

КонецФункции

// Счётчики хаба двумя строками: сколько заведено людей и сколько пулов.
Функция ТаблицаСчётчиков()

	Счётчики = Кит.Таблица();
	Счётчики.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.maintenance.col.metric")));
	Счётчики.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.maintenance.col.value")));

	Счётчики.Добавить(Счётчик(Тексты.Текст("settings.hub.maintenance.row.users"),
		Пользователи.Количество()));
	Счётчики.Добавить(Счётчик(Тексты.Текст("settings.hub.maintenance.row.pools"),
		СервисПулов.ВсеПулы().Количество()));

	Возврат Счётчики;

КонецФункции

Функция Счётчик(Знач Метка, Знач Число)

	Запись = Кит.Запись();
	Запись.Добавить(Ячейка(Метка));
	Запись.Добавить(Ячейка(Тексты.ЧислоТекстом(Число)));
	Возврат Запись;

КонецФункции

Функция Ячейка(Знач Значение)

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Текст(Значение));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Оформить(Знач Заголовок, Знач Пояснение, Знач Тело, Знач Иконка)

	Секция = Каркас.Секция(Заголовок, Пояснение, Тело.Рендер());
	Секция.Иконка = Иконка;
	Возврат Секция;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаСведенийХаба")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _Каркас,
	&Пластилин(Значение = "ОписаниеПриложения") _ОписаниеПриложения,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ПолитикаПароля") _ПолитикаПароля,
	&Пластилин(Значение = "ХранилищеПользователей") _Пользователи,
	&Пластилин(Значение = "ВитринаЗеркалКабинета") _ЗеркалаКабинета,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Каркас = _Каркас;
	ОписаниеПриложения = _ОписаниеПриложения;
	СервисПулов = _СервисПулов;
	ПолитикаПароля = _ПолитикаПароля;
	Пользователи = _Пользователи;
	ЗеркалаКабинета = _ЗеркалаКабинета;
	Тексты = _Тексты;

КонецПроцедуры
