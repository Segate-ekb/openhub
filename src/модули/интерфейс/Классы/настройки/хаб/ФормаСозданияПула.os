// Форма заведения пула — желудь модуля web-ui. ОДНО объявление полей питает и отрисовку
// окна, и разбор POST: имя поля считает один и тот же код.

Перем Кит;          // Кит (oscript-ui) — окно формы и скрытые поля
Перем Фабрика;      // Формы (кит) — фабрика объявлений форм
Перем СервисПулов;  // СервисПулов (реестр) — квота хаба по умолчанию
Перем Окна;         // ОкноФормы (web-ui) — каркас окна заведения
Перем Тексты;       // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Объявление формы заведения: какие поля, в каком порядке и с какими ограничениями.
// Читается сверху вниз, и по нему видно, что нарисуется.
//
// Возвращаемое значение:
//  ОбъявлениеФормы - объявление, готовое и печатать, и разбирать.
//
Функция Объявление() Экспорт

	Возврат Фабрика.Новая()
		.Поле("имя", Тексты.Текст("access.pools.create.name"), "строка",
			Новый Структура("Обязательное, Плейсхолдер", Истина, "platform"))
		.Поле("тип", Тексты.Текст("access.pools.create.type"), "выбор",
			Новый Структура("Варианты, Подсказка, Умолчание", ВариантыТипа(),
				Тексты.Текст("access.pools.create.type.hint"), "custom"))
		.Поле("видимость", Тексты.Текст("access.pools.create.visibility"), "выбор",
			Новый Структура("Варианты, Умолчание", ВариантыВидимости(), "public"))
		// умолчание — «как в хабе»: старая закладка без поля не должна снимать с нового
		// пула предел, который хаб задаёт по умолчанию
		.Поле("квота_мб", Тексты.Текст("settings.pool.quota.label"), "число",
			Новый Структура("Подсказка, Умолчание", Тексты.Текст("settings.pool.quota.hint"),
				Тексты.ЧислоТекстом(СервисПулов.КвотаКакВХабе())));

КонецФункции

// Кнопка «Создать пул» и модальное окно с формой. Пока не нажали, форма места на экране
// не занимает; отбитая форма возвращается тем же окном — с набранным и помеченным полем.
// Скрипта здесь нет: открывает и закрывает окно движок браузера, а у экрана есть серверная
// дорога — тот же адрес с «form=1».
//
// Параметры:
//  Параметры - Структура:
//    * Адрес - Строка - адрес раздела (он же action формы);
//    * Токен - Строка - CSRF-токен сессии;
//    * ПолеОперации - Строка - имя скрытого поля операции;
//    * Операция - Строка - значение операции заведения;
//    * Отбор - Строка - подстрока отбора списка, переживающая мутацию;
//    * Заполнение - Структура, Соответствие, Неопределено - чем заполнить поля;
//    * Открыта - Булево - печатать окно открытым;
//    * Отказы - Соответствие - ключ поля -> текст отказа домена.
//
// Возвращаемое значение:
//  ЭлементЭкрана - кнопка открытия и <dialog> с формой.
//
Функция Окно(Знач Параметры) Экспорт

	Состояние = Окна.Состояние(Параметры);

	Оформление = Окна.Оформление(Состояние, Тексты.Текст("access.pools.create.title"),
		Тексты.Текст("access.pools.create.lead"), Тексты.Текст("access.pools.create.submit"),
		"куб");

	Отбор = "";
	Параметры.Свойство("Отбор", Отбор);

	// операция и отбор едут СКРЫТЫМИ ПОЛЯМИ, а не именем кнопки: отправка по Enter
	// обязана нести их так же, как нажатие кнопки
	Ф = Объявление()
		.Блок(Кит.СкрытоеПоле(Параметры.ПолеОперации, Параметры.Операция).Рендер())
		.Блок(Кит.СкрытоеПоле("q", Отбор).Рендер());

	Возврат Окна.Окно(Ф, Состояние, Параметры.Адрес, Параметры.Токен, Оформление);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Руками заводится только проектный пул: личный заводит регистрация.
Функция ВариантыТипа()
	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Значение, Подпись, Выбрано", "custom",
		Тексты.Текст("access.pools.create.type.custom"), Истина));
	Возврат Результат;
КонецФункции

Функция ВариантыВидимости()

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Значение, Подпись, Выбрано", "public",
		Тексты.Текст("access.pools.create.visibility.on"), Истина));
	Результат.Добавить(Новый Структура("Значение, Подпись", "private",
		Тексты.Текст("access.pools.create.visibility.off")));
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ФормаСозданияПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "Формы") _Фабрика,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ОкноФормы") _Окна,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Фабрика = _Фабрика;
	СервисПулов = _СервисПулов;
	Окна = _Окна;
	Тексты = _Тексты;

КонецПроцедуры
