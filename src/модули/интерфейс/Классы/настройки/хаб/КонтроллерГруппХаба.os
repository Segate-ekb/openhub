// Группы хаба — контроллер модуля web-ui: раздел «Группы» дома «Хаб».

Перем ГвардХаб;  // ГвардХабАдмина (кабинет)
Перем Ответы;    // ОтветыНастроек (web-ui)
Перем Дом;       // ДомХаба (web-ui)
Перем Витрина;   // ВитринаГруппХаба (web-ui)
Перем Пульт;     // ПультГруппХаба (web-ui)
Перем Защита;    // ЗащитаCSRF (auth)
Перем РазборФормы; // РазборФормы (web-ui)

#Область ТочкиМаршрута

// Точка маршрута «groups» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  form - Строка - "1" открывает окно заведения сразу: это серверная дорога к форме
//         для движка, который не умеет команд кнопки (необязательный, по умолчанию "").
//
&ТочкаМаршрута("groups")
Процедура Раздел(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, saved = "",
	form = "") Экспорт

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Вердикт, ЗначениеЗаполнено(saved), "", КукиЗапроса, 200,
			ОкноПоАдресу(form));
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = РазборФормы.Разобрать(ТелоЗапроса);
	Если НЕ Защита.Проверить(Вердикт.Сессия, РазборФормы.Поле(Форма, Защита.ИмяПоля())) Тогда
		Ответы.ОтдатьНеверныйCSRF(Ответ, Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Итог = Пульт.Применить(Форма, Принципал(Вердикт));
	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		// отбитая форма заведения возвращается ТЕМ ЖЕ окном: открытым, с набранным
		// и помеченным полем
		ОтдатьРаздел(Ответ, Вердикт, Ложь, Итог.Ошибка, КукиЗапроса, 400, Итог.Заведение);
		Возврат;
	КонецЕсли;

	Ответ.Перенаправить(Дом.АдресРаздела("groups") + "?saved=1");

КонецПроцедуры

// Состояние окна заведения, пришедшее адресом: серверная дорога к форме для движка,
// который не умеет команд кнопки.
Функция ОкноПоАдресу(Знач Форма_)
	Возврат ?(Строка(Форма_) <> "1", Неопределено,
		Новый Структура("Открыта, Заполнение, Отказы", Истина, Неопределено, Новый Соответствие()));
КонецФункции

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач Сохранено, Знач Ошибка, Знач КукиЗапроса,
	Знач Статус = 200, Знач Заведение = Неопределено)

	Параметры = Новый Структура();
	Параметры.Вставить("Адрес", Дом.АдресРаздела("groups"));
	Параметры.Вставить("Токен", Защита.ТокенСессии(Вердикт.Сессия));
	Параметры.Вставить("Заведение", Заведение);

	Модель = Ответы.МодельДома(Дом, "",
		Дом.Разделы("groups"),
		Ответы.УведомленияРаздела(Сохранено, Ошибка),
		Витрина.Секции(Параметры));

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт.Пользователь, КукиЗапроса,
		Дом.ПодписьРаздела("groups"), Статус);

КонецПроцедуры

Функция Принципал(Знач Вердикт)
	Возврат ?(Вердикт.Пользователь = Неопределено, "", Строка(Вердикт.Пользователь.Логин));
КонецФункции

#КонецОбласти

&Контроллер("/hub/settings")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардХабАдмина") _ГвардХаб,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ВитринаГруппХаба") _Витрина,
	&Пластилин(Значение = "ПультГруппХаба") _Пульт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "РазборФормы") _РазборФормы)

	ГвардХаб = _ГвардХаб;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	Пульт = _Пульт;
	Защита = _Защита;
	РазборФормы = _РазборФормы;

КонецПроцедуры
