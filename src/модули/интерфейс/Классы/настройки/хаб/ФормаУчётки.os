// Форма заведения учётной записи — желудь модуля web-ui. ОДНО объявление полей питает
// и отрисовку окна, и разбор POST: имя поля считает один и тот же код.

Перем Кит;                  // Кит (oscript-ui) — окно формы и скрытые поля
Перем Фабрика;              // Формы (кит) — фабрика объявлений форм
Перем СервисПользователей;  // СервисПользователей (auth) — имена ролей хаба
Перем Тексты;               // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Объявление формы заведения: какие поля, в каком порядке и с какими ограничениями.
//
// Возвращаемое значение:
//  ОбъявлениеФормы - объявление, готовое и печатать, и разбирать.
//
Функция Объявление() Экспорт

	Возврат Фабрика.Новая()
		.Поле("логин", Тексты.Текст("settings.hub.user-new.login.label"), "строка",
			Новый Структура("Обязательное, Подсказка", Истина,
				Тексты.Текст("settings.hub.user-new.login.hint")))
		.Поле("email", Тексты.Текст("settings.hub.user-new.email.label"), "строка",
			Новый Структура("Подсказка", Тексты.Текст("settings.hub.user-new.email.hint")))
		// умолчание объявлено значением, а не порядком вариантов: иначе выбранная роль
		// зависела бы от того, кого в список добавили первым
		.Поле("роль", Тексты.Текст("settings.hub.user-new.role.label"), "выбор",
			Новый Структура("Варианты, Умолчание", ВариантыРоли(),
				СервисПользователей.РольПользователь()));

КонецФункции

// Кнопка «Создать пользователя» и модальное окно с формой. Пока не нажали, форма места
// на экране не занимает; отбитая форма возвращается тем же окном — с набранным
// и помеченным полем.
//
// Параметры:
//  Параметры - Структура: * Адрес - Строка - адрес раздела (он же action формы); * Токен - Строка - CSRF-токен сессии; * Отбор - Строка - подстрока отбора списка, переживающая мутацию; * Заполнение - Структура, Соответствие, Неопределено - чем заполнить поля; * Открыта - Булево - печатать окно открытым; * Отказы - Соответствие - ключ поля -> текст отказа домена.
//
// Возвращаемое значение:
//  ЭлементЭкрана - кнопка открытия и <dialog> с формой.
//
Функция Окно(Знач Параметры) Экспорт

	Заполнение = Неопределено;
	Параметры.Свойство("Заполнение", Заполнение);
	Открыта = Ложь;
	Параметры.Свойство("Открыта", Открыта);
	Отказы = Неопределено;
	Параметры.Свойство("Отказы", Отказы);
	Отбор = "";
	Параметры.Свойство("Отбор", Отбор);

	Оформление = Новый Структура();
	Оформление.Вставить("Заголовок", Тексты.Текст("settings.hub.user-new.title"));
	Оформление.Вставить("Лид", Тексты.Текст("settings.hub.user-new.lead"));
	Оформление.Вставить("Открывашка", Тексты.Текст("settings.hub.user-new.title"));
	Оформление.Вставить("ИконкаОткрывашки", "плюс");
	Оформление.Вставить("Отмена", Тексты.Текст("settings.frame.cancel"));
	Оформление.Вставить("Отправка", Тексты.Текст("settings.hub.user-new.button"));
	Оформление.Вставить("ИконкаОтправки", "ключ");
	Оформление.Вставить("Открыта", Открыта = Истина);

	// операция и отбор едут СКРЫТЫМИ ПОЛЯМИ, а не именем кнопки: отправка по Enter
	// обязана нести их так же, как нажатие кнопки
	Ф = Объявление()
		.Блок(Кит.СкрытоеПоле("операция", ОперацияСоздания()).Рендер())
		.Блок(Кит.СкрытоеПоле("q", Отбор).Рендер());

	Если ТипЗнч(Отказы) = Тип("Соответствие") Тогда
		Для Каждого КиЗ Из Отказы Цикл
			Ф.Отбить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат Кит.Окно(Ф, Заполнение, Параметры.Адрес, Параметры.Токен, Оформление);

КонецФункции

// Значение поля «операция» для заведения учётной записи.
//
// Возвращаемое значение:
//  Строка
//
Функция ОперацияСоздания() Экспорт
	Возврат "создать";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВариантыРоли()

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Значение, Подпись", СервисПользователей.РольПользователь(),
		Тексты.Текст("settings.hub.user-new.role.user")));
	Результат.Добавить(Новый Структура("Значение, Подпись", СервисПользователей.РольАдмин(),
		Тексты.Текст("settings.hub.user-new.role.admin")));
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ФормаУчётки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "Формы") _Фабрика,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Фабрика = _Фабрика;
	СервисПользователей = _СервисПользователей;
	Тексты = _Тексты;

КонецПроцедуры
