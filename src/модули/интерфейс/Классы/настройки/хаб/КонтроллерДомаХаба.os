// Дом настроек «Хаб» — контроллер модуля web-ui.

Перем ГвардХаб;            // ГвардХабАдмина (кабинет)
Перем Ответы;              // ОтветыНастроек (web-ui)
Перем Дом;                 // ДомХаба (web-ui)
Перем Витрина;             // ВитринаНастроек (web-ui) — принимает ли раздел значения
Перем ВитринаДома;         // ВитринаДомаХаба (web-ui) — секции разделов
Перем ПультЗначений;       // ПультЗначенийНастроек (web-ui) — запись и уборка значений реестра
Перем ПультЛичных;         // ПультЛичныхПространств (web-ui) — оба перехода настройки
Перем ПультПароля;         // ПультПарольногоВхода (web-ui) — оба перехода настройки
Перем ПультПулов;          // ПультПулов (web-ui) — создание, основной пул, квота
Перем ПультБренда;         // ПультБрендирования (web-ui) — картинки оформления
Перем ПультПробыПочты;     // ПультПробыПочты (web-ui) — проверочное письмо себе
Перем Гейт;                // ГейтФормы (web-ui) — метод запроса и токен формы
Перем Защита;              // ЗащитаCSRF (auth)
Перем РазборФормы;         // РазборФормы (web-ui)
Перем ОписаниеПриложения;  // ОписаниеПриложения (запуск)
Перем Тексты;              // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ТочкиМаршрута

// Точка маршрута «settings» (GET).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//
&ТочкаМаршрута("settings")
Процедура Обзор(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	// Заголовок дома нужен и на входной странице: тесты границ и человек ищут именно его
	ОтдатьРаздел(Ответ, Вердикт, Дом.РазделПоУмолчанию(), Ложь, "", КукиЗапроса);

КонецПроцедуры

// Точка маршрута «settings/{раздел}» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  раздел - Строка - ключ раздела.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  ДанныеФормы - ДанныеСоставнойФормы - разобранная winow составная форма (файлы).
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  q - Строка - подстрока имени пула для отбора списка раздела «Пулы» (необязательный, по умолчанию "").
//  pool - Строка - идентификатор пула, для которого раскрыта панель правки квоты (необязательный, по умолчанию "").
//  form - Строка - "1" открывает окно заведения сразу: это серверная дорога к форме
//         для движка, который не умеет команд кнопки (необязательный, по умолчанию "").
//
&ТочкаМаршрута("settings/{раздел}")
Процедура Раздел(Ответ, раздел, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	ДанныеФормы, saved = "", q = "", pool = "", form = "") Экспорт

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Ключ = НРег(СокрЛП(Строка(раздел)));
	Если НЕ Дом.ЕстьРаздел(Ключ) Тогда
		ЗакрытьПрежнийАдрес(Ответ, Вердикт, Ключ, МетодЗапроса, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Обзор = Обстановка(q, pool, form);

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		// вложенный блок печатается на экране хозяина: свой адрес у него только для формы
		Если ЗначениеЗаполнено(Дом.Хозяин(Ключ)) Тогда
			Ответ.Перенаправить(Дом.АдресРаздела(Дом.Хозяин(Ключ))
				+ ?(ЗначениеЗаполнено(saved), "?saved=1", ""));
			Возврат;
		КонецЕсли;
		ОтдатьРаздел(Ответ, Вердикт, Ключ, ЗначениеЗаполнено(saved), "", КукиЗапроса, 200, Обзор);
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	// форма с файлом приезжает составной, и её поля — включая CSRF — живут в частях,
	// а не в теле: гейт токена один на оба вида, потому что второго ему не пережить
	Составная = РазборФормы.ЭтоСоставная(ДанныеФормы);
	Форма = Гейт.СПринятымТокеном(Ответ, Вердикт,
		?(Составная, РазборФормы.РазобратьСоставную(ДанныеФормы),
			РазборФормы.Разобрать(ТелоЗапроса)),
		КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Сохранить(Ответ, Вердикт, Ключ, Форма, РазборФормы.Файлы(ДанныеФормы), КукиЗапроса, Обзор);

КонецПроцедуры

// У POST своего запроса нет: своё он несёт скрытыми полями, и отказ не теряет ни отбор, ни панель.
Функция Обстановка(Знач Отбор, Знач Пул, Знач Форма = "")
	Возврат Новый Структура("Отбор, Пул, Заведение", СокрЛП(Строка(Отбор)), СокрЛП(Строка(Пул)),
		ОкноЗаведения(Строка(Форма) = "1", Неопределено, Неопределено));
КонецФункции

// Закрыто по умолчанию, открыто дорогой «form=1» и отказом формы — с набранным полем.
Функция ОкноЗаведения(Знач Открыта, Знач Заполнение, Знач Отказы)
	Возврат ?(НЕ Открыта, Неопределено,
		Новый Структура("Открыта, Заполнение, Отказы", Истина, Заполнение,
			?(Отказы = Неопределено, Новый Соответствие(), Отказы)));
КонецФункции

// Чтение ведёт в раздел-преемник, мутация получает честный отказ: редирект POST хуже 405.
Процедура ЗакрытьПрежнийАдрес(Ответ, Знач Вердикт, Знач Ключ, Знач МетодЗапроса, Знач КукиЗапроса)

	Преемник = Дом.Преемник(Ключ);

	Если НЕ ЗначениеЗаполнено(Преемник) Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт.Пользователь,
			Тексты.Текст("settings.hub.error.section"), КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Ответ.Заголовки["Location"] = Дом.АдресРаздела(Преемник);
	Ответ.УстановитьСостояние(301);

КонецПроцедуры

#КонецОбласти

#Область Сохранение

Процедура Сохранить(Ответ, Знач Вердикт, Знач Ключ, Знач Форма, Знач Файлы, Знач КукиЗапроса,
	Знач Обзор)

	Перем Проблема;

	Кто = ПринципалСессии(Вердикт);

	// Пульты спрашиваются ДО гейта «раздел принимает значения»: у раздела бывает форма,
	// не правящая ни одной записи реестра (картинки оформления), и такую 405 убил бы.
	// Настройки с последствиями правятся не как значение: свой пульт спрашивает
	// подтверждение, считает числа и отвечает за переход целиком.
	ИтогПульта = ПрименитьПульты(Ключ, Форма, Файлы, Кто, Вердикт.Пользователь);
	Если ИтогПульта.Перехвачено Тогда
		Если ЗначениеЗаполнено(ИтогПульта.Адрес) Тогда
			// операция удалась и у неё нет чисел для показа: обычный POST-редирект-GET
			Ответ.Перенаправить(ИтогПульта.Адрес);
			Возврат;
		КонецЕсли;
		Если ИтогПульта.Заведение <> Неопределено И Обзор <> Неопределено Тогда
			// отбитая форма заведения возвращается ТЕМ ЖЕ окном: открытым, с набранным
			// и помеченным полем
			Обзор.Заведение = ИтогПульта.Заведение;
		КонецЕсли;
		ОтдатьИтогПульта(Ответ, Вердикт, Ключ, ИтогПульта, КукиЗапроса, Обзор);
		Возврат;
	КонецЕсли;

	Если НЕ Витрина.ПринимаетИзменения(Ключ) Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, Витрина.ИмяПоляОперации())));

	Если Операция = Витрина.ОперацияСброса() Тогда
		Проблема = ПультЗначений.Сбросить(Ключ, Форма, Кто);
	ИначеЕсли НЕ ЗначениеЗаполнено(Операция) Тогда
		Проблема = ПультЗначений.Применить(Ключ, Форма, Кто);
	Иначе
		// белый список операций: устаревшая вкладка не должна попадать в ветку «сохранить всё»
		Проблема = Тексты.Текст("settings.hub.error.operation");
	КонецЕсли;

	Если ЗначениеЗаполнено(Проблема) Тогда
		ОтдатьРаздел(Ответ, Вердикт, Ключ, Ложь, Проблема, КукиЗапроса, 400, Обзор);
		Возврат;
	КонецЕсли;

	Ответ.Перенаправить(Дом.АдресРаздела(ЭкранРаздела(Ключ)) + "?saved=1");

КонецПроцедуры

// Экран, на который человек возвращается после записи: у вложенного блока это хозяин.
Функция ЭкранРаздела(Знач Ключ)
	Хозяин = Дом.Хозяин(Ключ);
	Возврат ?(ЗначениеЗаполнено(Хозяин), Хозяин, Ключ);
КонецФункции

// Пульты спрашиваются по очереди: каждый сам решает, его ли это раздел и его ли поле.
Функция ПрименитьПульты(Знач Раздел, Знач Форма, Знач Файлы, Знач Кто, Знач Пользователь)

	Итог = ПультПулов.Применить(Раздел, Форма, Пользователь);
	Если Итог.Перехвачено Тогда
		Возврат Итог;
	КонецЕсли;
	Итог = ПультБренда.Применить(Раздел, Форма, Файлы, Кто,
		Дом.АдресРаздела(Раздел) + "?saved=1");
	Если Итог.Перехвачено Тогда
		Возврат Итог;
	КонецЕсли;
	Итог = ПультЛичных.Применить(Раздел, Форма, Кто);
	Если Итог.Перехвачено Тогда
		Возврат Итог;
	КонецЕсли;
	Итог = ПультПробыПочты.Применить(Раздел, Форма, Пользователь);
	Если Итог.Перехвачено Тогда
		Возврат Итог;
	КонецЕсли;
	Возврат ПультПароля.Применить(Раздел, Форма, Кто);

КонецФункции

// Автор изменения — из сессии.
Функция ПринципалСессии(Знач Вердикт)

	Логин = ?(Вердикт.Пользователь = Неопределено, "", СокрЛП(Строка(Вердикт.Пользователь.Логин)));

	Если НЕ ЗначениеЗаполнено(Логин) Тогда
		// падаем громко: тихий "" дал бы анонимную строку в журнале аудита
		ВызватьИсключение "Дом «Хаб»: мутация настройки без принципала сессии —"
			+ " гвард пропустил запрос без пользователя. Автор изменения обязателен.";
	КонецЕсли;

	Возврат Логин;

КонецФункции

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач Ключ, Знач Сохранено, Знач Ошибка, Знач КукиЗапроса,
	Знач Статус = 200, Знач Обзор = Неопределено)

	Модель = МодельРаздела(Вердикт, Ключ, Ответы.УведомленияРаздела(Сохранено, Ошибка),
		Неопределено, Неопределено, Обзор);
	Ответы.ОтдатьДом(Ответ, Модель, Вердикт.Пользователь, КукиЗапроса, Дом.Заголовок(), Статус);

КонецПроцедуры

// Вопрос, отказ по эху и итог массовой операции печатаются на странице: редирект потерял бы числа.
Процедура ОтдатьИтогПульта(Ответ, Знач Вердикт, Знач Ключ, Знач Итог, Знач КукиЗапроса,
	Знач Обзор = Неопределено)

	Уведомления = Ответы.УведомленияРаздела(Ложь, Итог.Ошибка);
	Если ЗначениеЗаполнено(Итог.Уведомление) Тогда
		Уведомления.Добавить(Ответы.Уведомление(Итог.Уведомление, "ok"));
	КонецЕсли;

	Модель = МодельРаздела(Вердикт, Ключ, Уведомления, Итог.Спросить, Итог.Окно, Обзор);

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт.Пользователь, КукиЗапроса, Дом.Заголовок(),
		?(ЗначениеЗаполнено(Итог.Ошибка), КодОтказаПульта(Итог), 200));

КонецПроцедуры

// Отказ по праву называет себя своим кодом: 400 сказал бы «поправьте форму», хотя править нечего.
Функция КодОтказаПульта(Знач Итог)
	Возврат ?(Итог.Статус > 0, Итог.Статус, 400);
КонецФункции

Функция МодельРаздела(Знач Вердикт, Знач Ключ, Знач Уведомления, Знач Спросить, Знач Окно,
	Знач Обзор = Неопределено)

	Возврат Ответы.МодельДома(Дом, ОписаниеПриложения.Имя(),
		Дом.Разделы(Ключ),
		Уведомления,
		ВитринаДома.Секции(Новый Структура(
			"Ключ, Токен, Пользователь, Спросить, Окно, Обзор",
			Ключ, Защита.ТокенСессии(Вердикт.Сессия), Вердикт.Пользователь, Спросить, Окно,
			Обзор)));

КонецФункции

#КонецОбласти

&Контроллер("/hub")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардХабАдмина") _ГвардХаб,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ВитринаНастроек") _Витрина,
	&Пластилин(Значение = "ВитринаДомаХаба") _ВитринаДома,
	&Пластилин(Значение = "ПультЗначенийНастроек") _ПультЗначений,
	&Пластилин(Значение = "ПультЛичныхПространств") _ПультЛичных,
	&Пластилин(Значение = "ПультПарольногоВхода") _ПультПароля,
	&Пластилин(Значение = "ПультПулов") _ПультПулов,
	&Пластилин(Значение = "ПультБрендирования") _ПультБренда,
	&Пластилин(Значение = "ПультПробыПочты") _ПультПробыПочты,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ОписаниеПриложения") _ОписаниеПриложения,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	ГвардХаб = _ГвардХаб;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	ВитринаДома = _ВитринаДома;
	ПультЗначений = _ПультЗначений;
	ПультЛичных = _ПультЛичных;
	ПультПароля = _ПультПароля;
	ПультПулов = _ПультПулов;
	ПультБренда = _ПультБренда;
	ПультПробыПочты = _ПультПробыПочты;
	Гейт = _Гейт;
	Защита = _Защита;
	РазборФормы = _РазборФормы;
	ОписаниеПриложения = _ОписаниеПриложения;
	Тексты = _Тексты;

КонецПроцедуры
