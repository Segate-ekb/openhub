// Контроллер администрирования — модуль web-ui, домен «Хаб». Маршрут и разбор формы;
// разметку строит ВитринаУчёток, решения принимают доменные службы.

Перем ГвардХаб;            // ГвардХабАдмина (кабинет) — единый гейт домена «Хаб»
Перем Витрина;             // ВитринаУчёток (web-ui)
Перем ФормаЗаведения;      // ФормаУчётки (web-ui) — объявление полей формы заведения
Перем Отказы;              // ОтказыУчёток (web-ui) — коды домена человеческим текстом
Перем Защита;              // ЗащитаCSRF (auth) — токен сессии в форму
Перем Гейт;                // ГейтФормы (web-ui) — токен формы
Перем Итоги;               // ИтогПульта (web-ui) — окно заведения на странице
Перем РазборФормы;         // РазборФормы (web-ui)
Перем ХранилищеПользователей; // ХранилищеПользователей (данные)
Перем СервисПользователей; // СервисПользователей (auth) — смена роли хаба
Перем Активность;          // СервисАктивностиУчёток (auth) — блокировка и разблокировка
Перем Удаление;            // УдалениеУчётки (auth) — снос учётки со всем связанным
Перем Приглашения;         // СлужбаПриглашений (auth) — заведение учёток и ссылки
Перем Ответы;              // ОтветыНастроек (web-ui)
Перем Сбои;              // ТекстСбоя (web-ui) — причина сбоя человеку и отчёт в журнал
Перем Дом;                 // ДомХаба (web-ui)
Перем Числа;               // ПриведениеЧисел (основа) — терпимое чтение числа
Перем Отметка;  // ОтметкаСохранения (web-ui) — «сохранено» параметром на адресе

#Область ТочкиМаршрута

// Точка маршрута «users» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента, попадает в журнал аудита.
//  q - Строка - подстрока логина или email для отбора списка (необязательный, по умолчанию "").
//  saved - Строка - признак применённой смены роли из адреса (необязательный, по умолчанию "").
//  form - Строка - "1" открывает окно заведения сразу: это серверная дорога к форме
//         для движка, который не умеет команд кнопки (необязательный, по умолчанию "").
//
&ТочкаМаршрута("users")
Процедура Пользователи(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	АдресУдаленногоУзла, q = "", saved = "", form = "") Экспорт

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Обзор = Состояние(q);
		Обзор.Форма = Итоги.ОкноПоАдресу(form);
		ОтдатьПользователей(Ответ, Вердикт, "", КукиЗапроса, Обзор, ЗначениеЗаполнено(saved));
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Гейт.СПринятымТокеном(Ответ, Вердикт, РазборФормы.Разобрать(ТелоЗапроса),
		КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Операция = РазборФормы.Поле(Форма, "операция");
	Если Операция = Витрина.ОперацияРоли() Тогда
		СменитьРоль(Ответ, Вердикт, Форма, КукиЗапроса, Строка(АдресУдаленногоУзла));
	ИначеЕсли Операция = ФормаЗаведения.ОперацияСоздания() Тогда
		ЗавестиУчётку(Ответ, Вердикт, Форма, КукиЗапроса, Строка(АдресУдаленногоУзла));
	ИначеЕсли Операция = Витрина.ОперацияСброса() Тогда
		ВыпуститьСсылку(Ответ, Вердикт, Форма, КукиЗапроса, Строка(АдресУдаленногоУзла));
	ИначеЕсли Операция = Витрина.ОперацияАктивности() Тогда
		СменитьАктивность(Ответ, Вердикт, Форма, КукиЗапроса);
	ИначеЕсли Операция = Витрина.ОперацияУдаления() Тогда
		УдалитьУчётку(Ответ, Вердикт, Форма, КукиЗапроса, Строка(АдресУдаленногоУзла));
	Иначе
		// Неизвестная операция — отказ, а не «что-нибудь»: при четырёх ветках молчаливый
		// откат в последнюю однажды переключил бы активность вместо запрошенного действия.
		ОтдатьОтказ(Ответ, Вердикт, Отказы.НеизвестнаяОперация(), КукиЗапроса,
			Состояние(РазборФормы.Поле(Форма, "q")));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Операции

// Порог судится дважды — до вопроса и на применении: между ними учётку могли снести.
Процедура СменитьРоль(Ответ, Знач Вердикт, Знач Форма, Знач КукиЗапроса, Знач АдресКлиента)

	Состояние = Состояние(РазборФормы.Поле(Форма, "q"));
	Присланный = СокрЛП(РазборФормы.Поле(Форма, "пользователь"));
	Роль = РазборФормы.Поле(Форма, "роль");

	Идентификатор = Числа.ЦелоеИлиНеопределено(Присланный);
	Цель = ?(Идентификатор = Неопределено, Неопределено,
		ХранилищеПользователей.ПолучитьОдноПоИдентификаторРавно(Идентификатор));

	Проверка = СервисПользователей.ПроверитьСменуРоли(Вердикт.Пользователь, Цель, Роль);
	Если НЕ Проверка.Успех Тогда
		ОтдатьОтказ(Ответ, Вердикт, Отказы.СменаРоли(Проверка.Причина),
			КукиЗапроса, Состояние);
		Возврат;
	КонецЕсли;

	Если СокрЛП(РазборФормы.Поле(Форма, "подтверждение")) <> Присланный Тогда
		Состояние.Подтверждение = Новый Структура("Цель, Роль", Цель, Роль);
		ОтдатьПользователей(Ответ, Вердикт, "", КукиЗапроса, Состояние, Ложь);
		Возврат;
	КонецЕсли;

	Попытка
		СервисПользователей.НазначитьРольХаба(Вердикт.Пользователь, Цель, Роль, АдресКлиента);
	Исключение
		// Гонка: между вопросом и подтверждением учётку могли снести. Причину называет ТА ЖЕ
		// проверка по ПЕРЕЧИТАННОЙ цели — текст доменного исключения на экран не выносится,
		// он написан для журнала разработчика, а не для администратора.
		Повтор = СервисПользователей.ПроверитьСменуРоли(Вердикт.Пользователь,
			ХранилищеПользователей.ПолучитьОдноПоИдентификаторРавно(Идентификатор), Роль);
		ОтдатьОтказ(Ответ, Вердикт, Отказы.СменаРоли(Повтор.Причина),
			КукиЗапроса, Состояние);
		Возврат;
	КонецПопытки;

	// отбор переживает мутацию; перезагрузка страницы после редиректа не повторяет выдачу прав
	Ответ.Перенаправить(
		Витрина.АдресСПоиском(Отметка.НаАдресе(Дом.АдресРаздела("users")), Состояние.Запрос));

КонецПроцедуры

// Ссылка показывается на той же странице один раз: редиректа нет, иначе значение уехало бы в адрес.
Процедура ЗавестиУчётку(Ответ, Знач Вердикт, Знач Форма, Знач КукиЗапроса, Знач АдресКлиента)

	Состояние = Состояние(РазборФормы.Поле(Форма, "q"));

	Разбор = ФормаЗаведения.Объявление().Разобрать(Форма);
	Если НЕ Разбор.Принято Тогда
		Состояние.Форма = Итоги.ОкноЗаведения(Разбор.Показ, Разбор.Отказы);
		ОтдатьПользователей(Ответ, Вердикт, Разбор.Отказ, КукиЗапроса, Состояние, Ложь, 400);
		Возврат;
	КонецЕсли;

	Исход = Приглашения.Пригласить(Вердикт.Принципал, Значением(Разбор.Значения, "логин"),
		Значением(Разбор.Значения, "email"), Значением(Разбор.Значения, "роль"), АдресКлиента);

	// отбитая форма возвращается ТЕМ ЖЕ окном: отказ домена метит логин — занятое имя,
	// системный сегмент, запрещённый символ живут именно в нём
	Состояние.Форма = Итоги.ОкноЗаведения(Разбор.Показ,
		?(Исход.Успех, Неопределено, ОтказЛогина(Отказы.ВыпускСсылки(Исход))));

	ОтдатьВыпуск(Ответ, Вердикт, Исход, КукиЗапроса, Состояние);

КонецПроцедуры

Процедура ВыпуститьСсылку(Ответ, Знач Вердикт, Знач Форма, Знач КукиЗапроса, Знач АдресКлиента)

	Состояние = Состояние(РазборФормы.Поле(Форма, "q"));
	Исход = Приглашения.СброситьПароль(Вердикт.Принципал,
		Числа.ЧислоИлиНоль(РазборФормы.Поле(Форма, "пользователь")), АдресКлиента);

	ОтдатьВыпуск(Ответ, Вердикт, Исход, КукиЗапроса, Состояние);

КонецПроцедуры

// Инвариант «нет способа входа — нет активности» держит домен, контроллер переводит код в текст.
Процедура СменитьАктивность(Ответ, Знач Вердикт, Знач Форма, Знач КукиЗапроса)

	Состояние = Состояние(РазборФормы.Поле(Форма, "q"));
	Цель = ХранилищеПользователей.ПолучитьОдноПоИдентификаторРавно(
		Числа.ЧислоИлиНоль(РазборФормы.Поле(Форма, "пользователь")));

	Желаемая = НЕ (Цель <> Неопределено И Цель.Активен = Истина);
	Проверка = Активность.ПроверитьСменуАктивности(Вердикт.Пользователь, Цель, Желаемая);
	Если НЕ Проверка.Успех Тогда
		ОтдатьОтказ(Ответ, Вердикт,
			Отказы.СменаАктивности(Проверка.Причина, Желаемая), КукиЗапроса, Состояние);
		Возврат;
	КонецЕсли;

	Активность.УстановитьАктивность(Вердикт.Пользователь, Цель, Желаемая);
	// отбор переживает мутацию: иначе после блокировки админ возвращается к полному списку
	Ответ.Перенаправить(
		Витрина.АдресСПоиском(Дом.АдресРаздела("users"), Состояние.Запрос));

КонецПроцедуры

// Подтверждение сверяет СЕРВЕР: поле формы обязано нести логин удаляемого.
Процедура УдалитьУчётку(Ответ, Знач Вердикт, Знач Форма, Знач КукиЗапроса, Знач АдресКлиента)

	Состояние = Состояние(РазборФормы.Поле(Форма, "q"));
	Цель = ХранилищеПользователей.ПолучитьОдноПоИдентификаторРавно(
		Числа.ЧислоИлиНоль(РазборФормы.Поле(Форма, "пользователь")));

	Проверка = Удаление.ПроверитьУдаление(Вердикт.Пользователь, Цель);
	Если НЕ Проверка.Успех Тогда
		ОтдатьОтказ(Ответ, Вердикт, Отказы.Удаление(Проверка.Причина), КукиЗапроса, Состояние);
		Возврат;
	КонецЕсли;

	// эхо сверяется ПОСЛЕ права: неподтверждённое удаление чужой учётки и отказ по праву —
	// разные ответы, и первым человек обязан увидеть тот, который про него
	Если СокрЛП(РазборФормы.Поле(Форма, "подтверждение")) <> Строка(Цель.Логин) Тогда
		ОтдатьОтказ(Ответ, Вердикт, Отказы.УдалениеБезПодтверждения(), КукиЗапроса, Состояние);
		Возврат;
	КонецЕсли;

	// хранилище живёт снаружи и вправе отказать: администратор обязан увидеть отказ формой
	Попытка
		Удаление.Удалить(Вердикт.Пользователь, Цель, АдресКлиента);
	Исключение
		ОтдатьОтказ(Ответ, Вердикт, Отказы.УдалениеСорвалось(
			Сбои.Человеку(ИнформацияОбОшибке())), КукиЗапроса, Состояние);
		Возврат;
	КонецПопытки;

	Ответ.Перенаправить(
		Витрина.АдресСПоиском(Дом.АдресРаздела("users"), Состояние.Запрос));

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьВыпуск(Ответ, Знач Вердикт, Знач Исход, Знач КукиЗапроса, Состояние)

	Если НЕ Исход.Успех Тогда
		ОтдатьПользователей(Ответ, Вердикт,
			Отказы.ВыпускСсылки(Исход), КукиЗапроса, Состояние,
			Ложь, Исход.Код);
		Возврат;
	КонецЕсли;

	Состояние.Выпуск = Новый Структура("Логин, Ссылка", Исход.Логин, Исход.Ссылка);
	// удача закрывает окно и очищает форму: следующая учётка заводится с чистого листа
	Состояние.Форма = Неопределено;
	ОтдатьПользователей(Ответ, Вердикт, "", КукиЗапроса, Состояние, Ложь);

КонецПроцедуры

Процедура ОтдатьОтказ(Ответ, Знач Вердикт, Знач Ошибка, Знач КукиЗапроса, Знач Состояние)
	ОтдатьПользователей(Ответ, Вердикт, Ошибка, КукиЗапроса, Состояние, Ложь, 400);
КонецПроцедуры

Процедура ОтдатьПользователей(Ответ, Знач Вердикт, Знач Ошибка, Знач КукиЗапроса,
	Знач Состояние, Знач Сохранено = Ложь, Знач Статус = 200)

	Модель = Ответы.МодельДома(Дом, "",
		Дом.Разделы("users"),
		Уведомления(Сохранено, Ошибка),
		Витрина.Секции(Защита.ТокенСессии(Вердикт.Сессия), Вердикт.Пользователь, Состояние));

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт.Пользователь, КукиЗапроса,
		Дом.ПодписьРаздела("users"), Статус);

КонецПроцедуры

Функция Уведомления(Знач Сохранено, Знач Ошибка)
	Результат = Новый Массив();
	Если Сохранено Тогда
		Результат.Добавить(Ответы.Уведомление("Изменения сохранены", "ok"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Результат.Добавить(Ответы.Уведомление(Ошибка, "err"));
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// То, что витрина не может вывести из базы: отбор, вопрос, показанная ссылка и окно заведения.
Функция Состояние(Знач Запрос)
	Возврат Новый Структура("Запрос, Подтверждение, Выпуск, Форма",
		СокрЛП(Строка(Запрос)), Неопределено, Неопределено, Неопределено);
КонецФункции

Функция ОтказЛогина(Знач Текст)
	Результат = Новый Соответствие();
	Результат.Вставить("логин", Текст);
	Возврат Результат;
КонецФункции

Функция Значением(Знач Значения, Знач Ключ)
	Найденное = Значения.Получить(Ключ);
	Возврат ?(Найденное = Неопределено, "", Строка(Найденное));
КонецФункции

#КонецОбласти

&Контроллер("/hub/settings")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардХабАдмина") _ГвардХаб,
	&Пластилин(Значение = "ВитринаУчёток") _Витрина,
	&Пластилин(Значение = "ФормаУчётки") _ФормаЗаведения,
	&Пластилин(Значение = "ОтказыУчёток") _Отказы,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "ИтогПульта") _Итоги,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ХранилищеПользователей") _ХранилищеПользователей,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "СервисАктивностиУчёток") _Активность,
	&Пластилин(Значение = "УдалениеУчётки") _Удаление,
	&Пластилин(Значение = "СлужбаПриглашений") _Приглашения,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "ОтметкаСохранения") _Отметка)

	ГвардХаб = _ГвардХаб;
	Витрина = _Витрина;
	ФормаЗаведения = _ФормаЗаведения;
	Отказы = _Отказы;
	Защита = _Защита;
	Гейт = _Гейт;
	Итоги = _Итоги;
	РазборФормы = _РазборФормы;
