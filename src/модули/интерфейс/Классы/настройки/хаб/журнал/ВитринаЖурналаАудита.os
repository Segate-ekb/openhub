// Витрина журнала аудита — раздел «Журнал» дома «Хаб»: форма отбора, таблица записей
// с раскрытием деталей и постраничная навигация. Экран собирается элементами кита.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем Ячейки;            // ЯчейкиТаблицы (web-ui) — заготовки ячеек таблиц
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем Компоненты;        // НаборКомпонентов (кит) — адрес первой страницы у пагинации
Перем Служба;            // СлужбаАудита (аудит) — страница журнала
Перем Отборы;            // ОтборЖурналаАудита (web-ui) — имена параметров адреса
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

Перем Настройки;         // СервисНастроек (настройки) — размер страницы журнала
Перем Даты;  // ДатаЧеловеку (web-ui) — одно написание момента на весь интерфейс
Перем Примечания;  // ПримечанияЭкрана (web-ui) — вид «показывать нечего»
Перем Формат;      // ФорматЖурналаАудита (аудит) — единственный разбор подробностей события

#Область ПубличныйИнтерфейс

// Секции раздела «журнал» дома «Хаб».
//
// Параметры:
//  Параметры - Структура: * Адрес - Строка - адрес раздела (он же action формы отбора); * Отбор - Структура - результат ОтборЖурналаАудита.Разобрать; * Страница - Число - номер страницы с единицы.
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Выдача = Служба.ЗаписиСтраницей(Параметры.Отбор, Параметры.Страница,
		Настройки.Значение("oshub.ui.audit_page_size"));

	Журнал = Кит.Холст();
	Журнал.Добавить(ЧтоПрочитано(Выдача));
	Журнал.Добавить(ФормаОтбора(Параметры.Адрес, Параметры.Отбор, Выдача.Записи));
	Если Параметры.Отбор.АдресНеПрочитан Тогда
		Журнал.Добавить(АдресНеПрочитан(Параметры.Отбор.ТекстАдреса));
	КонецЕсли;
	Журнал.Добавить(ТаблицаЗаписей(Выдача));
	Журнал.Добавить(Навигация(Параметры.Адрес, Параметры.Отбор, Выдача));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.hub.audit.title"),
		Тексты.Текст("settings.hub.audit.lead"), Журнал.Рендер());
	Секция.Иконка = "история";

	Результат = Новый Массив();
	Результат.Добавить(Секция);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ОтборЗаписей

// Экран читает хвост файла: без этой строки пустая выдача читалась бы как «таких операций не было».
Функция ЧтоПрочитано(Знач Выдача)

	Если НЕ Выдача.ИсточникДоступен Тогда
		Возврат Кит.Примечание(Тексты.Текст("settings.hub.audit.source.missing"));
	КонецЕсли;

	Если Выдача.ХвостУсечён Тогда
		Возврат Кит.Примечание(Тексты.Текст("settings.hub.audit.tail.truncated"));
	КонецЕсли;

	Возврат Кит.Примечание(Тексты.Текст("settings.hub.audit.tail.note"));

КонецФункции

// Пустой журнал под непрочитанным адресом читался бы как «таких операций не было»:
// отбор по адресу не применяется вовсе, а экран называет причину.
Функция АдресНеПрочитан(Знач Введённое)
	Возврат Кит.Примечание(Тексты.Шаблон("settings.hub.audit.filter.ip.unread", Введённое));
КонецФункции

// Отбор — GET-форма: состояние списка живёт в адресе, страница работает без JS.
Функция ФормаОтбора(Знач Адрес, Знач Отбор, Знач Записи)

	Поля = Новый Массив();
	Поля.Добавить(Новый Структура("Имя, Метка, Тип, Значение, Варианты",
		Отборы.ИмяТипа(), Тексты.Текст("settings.hub.audit.filter.type"), "выбор",
		Отбор.Действие, ВариантыСобытий(Отбор.Действие, Записи)));
	Поля.Добавить(Новый Структура("Имя, Метка, Значение, Плейсхолдер",
		Отборы.ИмяСубъекта(), Тексты.Текст("settings.hub.audit.filter.who"), Отбор.Кто,
		Тексты.Текст("settings.hub.audit.filter.who.placeholder")));
	Поля.Добавить(Новый Структура("Имя, Метка, Тип, Значение",
		Отборы.ИмяНачала(), Тексты.Текст("settings.hub.audit.filter.from"), "date", Отбор.ТекстНачала));
	Поля.Добавить(Новый Структура("Имя, Метка, Тип, Значение",
		Отборы.ИмяКонца(), Тексты.Текст("settings.hub.audit.filter.to"), "date", Отбор.ТекстКонца));
	Поля.Добавить(Новый Структура("Имя, Метка, Значение, Плейсхолдер",
		Отборы.ИмяАдреса(), Тексты.Текст("settings.hub.audit.filter.ip"), Отбор.ТекстАдреса,
		Тексты.Текст("settings.hub.audit.filter.ip.placeholder")));

	Возврат Кит.СтрокаПоиска(Новый Структура("Действие, Поля, Кнопка, Иконка",
		Адрес, Поля, Тексты.Текст("settings.hub.audit.filter.button"), "поиск"));

КонецФункции

// Вариант отбора — действие, которое ВИДНО в прочитанном хвосте.
Функция ВариантыСобытий(Знач Выбранное, Знач Записи)

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Значение, Подпись",
		"", Тексты.Текст("settings.hub.audit.filter.type.all")));

	Известные = Новый Соответствие();
	Для Каждого Запись Из Записи Цикл
		Добавить(Результат, Известные, Строка(Запись.Действие), Строка(Запись.Действие));
	КонецЦикла;

	// действующий отбор обязан быть в списке: иначе экран показывал бы «все события»
	// при работающем отборе — например по действию, которого на этой странице уже нет
	Добавить(Результат, Известные, Строка(Выбранное), Строка(Выбранное));

	Возврат Результат;

КонецФункции

Процедура Добавить(Результат, Известные, Знач Значение, Знач Подпись)

	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ Известные.Получить(Значение) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Известные.Вставить(Значение, Истина);
	Результат.Добавить(Новый Структура("Значение, Подпись", Значение, Подпись));

КонецПроцедуры

#КонецОбласти

#Область ТаблицаЗаписей

Функция ТаблицаЗаписей(Знач Выдача)

	// ключи словаря пишутся целиком, а не собираются из кусков: собранный ключ не найти
	// поиском по дереву, и сторож словаря перестаёт видеть, чем экран пользуется
	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.audit.col.when")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.audit.col.who")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.audit.col.action")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.audit.col.object")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.audit.col.subject")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.audit.col.ip")));

	Для Каждого Запись Из Выдача.Записи Цикл
		Таблица.Добавить(ЗаписьЖурнала(Запись));
	КонецЦикла;

	Таблица.Пусто().Добавить(Примечания.Пусто(?(Выдача.ИсточникДоступен,
		Тексты.Текст("settings.hub.audit.empty"),
		Тексты.Текст("settings.hub.audit.source.missing"))));

	Возврат Таблица;

КонецФункции

Функция ЗаписьЖурнала(Знач Запись)

	Когда = Даты.ДатаВремя(Запись.Когда);

	СтрокаТаблицы = Кит.Запись();
	СтрокаТаблицы.Добавить(Ячейка(Когда));
	СтрокаТаблицы.Добавить(Ячейка(Запись.Кто));
	СтрокаТаблицы.Добавить(Ячейка(Запись.Действие));
	СтрокаТаблицы.Добавить(Ячейка(Запись.Объект));
	СтрокаТаблицы.Добавить(Ячейка(ПолеСтруктуры(Запись, "Субъект")));
	СтрокаТаблицы.Добавить(Ячейка(Запись.АдресIP));

	// детали идут разворотом под записью: в ячейке ряда из шести колонок им доставалось
	// несколько пикселей, и значение печаталось по букве в строке
	Подробности = Детали(ПолеСтруктуры(Запись, "Детали"), Когда, Запись.Кто);
	Если Подробности <> Неопределено Тогда
		СтрокаТаблицы.Разворот().Добавить(Подробности);
	КонецЕсли;

	Возврат СтрокаТаблицы;

КонецФункции

// Поля записи, которого может не быть: старые строки файла его не несут.
Функция ПолеСтруктуры(Знач Запись, Знач Имя)
	Попытка
		Возврат Запись[Имя];
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

// Пустая ячейка читается как поломка экрана: вместо пустоты печатается прочерк.
Функция Ячейка(Знач Значение)

	Возврат Ячейки.ТекстИлиПрочерк(Значение, Тексты.Текст("settings.hub.audit.cell.empty"));

КонецФункции

#КонецОбласти

#Область ДеталиЗаписи

// Разворот — отдельная строка с именем записи: двадцать «Подробнее» звучат одинаково.
Функция Детали(Знач ДеталиJSON, Знач Когда, Знач Кто)

	Список = Пары(ДеталиJSON);
	Если Список.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Подробность = Кит.Раскрывашка("подробность");
	Подробность.Подпись(Тексты.Шаблон("settings.hub.audit.details.about",
		ИмяЗаписи(Когда, Кто)));
	Подробность.Шапка().Добавить(Кит.Текст(Тексты.Текст("settings.hub.audit.details.summary")));

	Свойства = Подробность.Добавить(Кит.Свойства());
	Для Каждого Пара Из Список Цикл
		Свойства.Добавить(Кит.Свойство(Пара.Имя)).Добавить(Кит.Текст(Пара.Значение));
	КонецЦикла;

	Возврат Подробность;

КонецФункции

// Пустые части выпадают: «Подробнее: , root» читается хуже, чем «Подробнее: root».
Функция ИмяЗаписи(Знач Когда, Знач Кто)

	Части = Новый Массив();
	Если ЗначениеЗаполнено(Когда) Тогда
		Части.Добавить(СокрЛП(Строка(Когда)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Кто) Тогда
		Части.Добавить(СокрЛП(Строка(Кто)));
	КонецЕсли;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

Функция Пары(Знач ДеталиJSON)

	Результат = Новый Массив();

	Текст = СокрЛП(Строка(?(ДеталиJSON = Неопределено, "", ДеталиJSON)));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	// разбор берётся у формата журнала: ЧтениеJSON платформы подменяет ISO-подобное
	// значение Датой, и «2026-09-05T10:00:00Z» показывалось бы местным написанием даты
	Разобрано = Формат.ДеталиПолями(Текст);
	Если Разобрано = Неопределено Тогда
		// нечитаемые детали — не повод ронять весь журнал: показываем как есть
		Результат.Добавить(Пара(Тексты.Текст("settings.hub.audit.details.raw"), Текст));
		Возврат Результат;
	КонецЕсли;

	Для Каждого КиЗ Из Разобрано Цикл
		Значение = Представление(КиЗ.Значение);
		Если ЗначениеЗаполнено(Значение) Тогда
			Результат.Добавить(Пара(Подпись(КиЗ.Ключ), Значение));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Пара(Знач Имя, Знач Значение)
	Возврат Новый Структура("Имя, Значение", Имя, Значение);
КонецФункции

// Ключи деталей пишет производитель события машинно, а читает их человек.
Функция Подпись(Знач Ключ)
	Возврат СтрЗаменить(СокрЛП(Строка(Ключ)), "_", " ");
КонецФункции

Функция Представление(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, Тексты.Текст("settings.value.yes"), Тексты.Текст("settings.value.no"));
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Части = Новый Массив();
		Для Каждого Элемент Из Значение Цикл
			Части.Добавить(Представление(Элемент));
		КонецЦикла;
		Возврат СтрСоединить(Части, ", ");
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Части = Новый Массив();
		Для Каждого КиЗ Из Значение Цикл
			Части.Добавить(Подпись(КиЗ.Ключ) + ": " + Представление(КиЗ.Значение));
		КонецЦикла;
		Возврат СтрСоединить(Части, ", ");
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

#КонецОбласти

#Область Навигация

Функция Навигация(Знач Адрес, Знач Отбор, Знач Выдача)

	Модель = Новый Структура("Страница, ЕстьСледующая, Основа, Параметр, Параметры",
		Выдача.Страница, Выдача.ЕстьСледующая, Адрес, Отборы.ИмяСтраницы(),
		Отборы.Параметры(Отбор));

	// за краем журнала «назад» ведёт вглубь пустоты — из тупика нужен выход в один клик
	Если Выдача.Записи.Количество() = 0 И Выдача.Страница > 1 Тогда
		Возврат ВыходИзПустоты(АдресПервойСтраницы(Модель));
	КонецЕсли;

	Возврат Кит.Пагинация(Модель);

КонецФункции

// Адрес считает сама пагинация: вторая формула адреса разошлась бы с первой.
Функция АдресПервойСтраницы(Знач Модель)
	Возврат Компоненты.Пагинация().АдресСтраницы(Модель, 1);
КонецФункции

Функция ВыходИзПустоты(Знач АдресПервой)

	Сноска = Кит.Примечание();
	Сноска.Добавить(Кит.Ссылка(АдресПервой))
		.Добавить(Кит.Текст(Тексты.Текст("settings.hub.audit.page.first")));
	Возврат Сноска;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти

&Прозвище("ВитринаЖурналаАудита")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ЯчейкиТаблицы") _Ячейки,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "НаборКомпонентов") _Компоненты,
	&Пластилин(Значение = "СлужбаАудита") _Служба,
	&Пластилин(Значение = "ОтборЖурналаАудита") _Отборы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ПримечанияЭкрана") _Примечания,
	&Пластилин(Значение = "ФорматЖурналаАудита") _Формат,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено) Экспорт

	Кит = _Кит;
	Ячейки = _Ячейки;
	РендерерНастроек = _РендерерНастроек;
	Компоненты = _Компоненты;
	Служба = _Служба;
	Отборы = _Отборы;
	Тексты = _Тексты;
	Настройки = _Настройки;
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);
	Примечания = _Примечания;
	Формат = _Формат;

КонецПроцедуры
