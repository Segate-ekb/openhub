// Журнал аудита — контроллер раздела «Журнал» дома «Хаб»: отбор и страница живут
// в адресе, поэтому каждое состояние экрана можно дать ссылкой и открыть без JS.

Перем ГвардХаб;  // ГвардХабАдмина (кабинет)
Перем Ответы;    // ОтветыНастроек (web-ui)
Перем Дом;       // ДомХаба (web-ui)
Перем Витрина;   // ВитринаЖурналаАудита (web-ui)
Перем Отборы;    // ОтборЖурналаАудита (web-ui)

#Область ТочкиМаршрута

// Точка маршрута «audit» (GET).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  type - Строка - отбор по типу события (необязательный, по умолчанию "").
//  who - Строка - отбор по субъекту операции (необязательный, по умолчанию "").
//  since - Строка - начало периода «ГГГГ-ММ-ДД» (необязательный, по умолчанию "").
//  until - Строка - конец периода «ГГГГ-ММ-ДД», включительно (необязательный, по умолчанию "").
//  page - Строка - номер страницы (необязательный, по умолчанию "").
//
&ТочкаМаршрута("audit")
Процедура Раздел(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	type = "", who = "", since = "", until = "", page = "") Экспорт

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Параметры = Новый Структура();
	Параметры.Вставить("Адрес", Дом.АдресРаздела("audit"));
	Параметры.Вставить("Отбор", Отборы.Разобрать(type, who, since, until));
	Параметры.Вставить("Страница", Отборы.НомерСтраницы(page));

	Модель = Ответы.МодельДома(Дом, "",
		Дом.Разделы("audit"),
		Ответы.УведомленияРаздела(Ложь, ""),
		Витрина.Секции(Параметры));

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт.Пользователь, КукиЗапроса,
		Дом.ПодписьРаздела("audit"));

КонецПроцедуры

#КонецОбласти

&Контроллер("/hub/settings")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардХабАдмина") _ГвардХаб,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ВитринаЖурналаАудита") _Витрина,
	&Пластилин(Значение = "ОтборЖурналаАудита") _Отборы)

	ГвардХаб = _ГвардХаб;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	Отборы = _Отборы;

КонецПроцедуры
