// Перевод кодов отказа доменных служб раздела «Пользователи» в текст для администратора.
// Каждый известный код — своя ветка; нераспознанный (в том числе пустой, когда домен
// отказал не проверкой) получает общий текст, а НЕ текст соседней причины: назвать отказ
// чужим именем хуже, чем не назвать его вовсе.

Перем СервисПользователей; // СервисПользователей (auth) — коды отказа смены роли
Перем Активность;          // СервисАктивностиУчёток (auth) — коды отказа смены активности
Перем Приглашения;         // СлужбаПриглашений (auth) — коды отказа выпуска ссылки
Перем УдалениеУчёток;      // УдалениеУчётки (auth) — коды отказа удаления

// Текст отказа в смене роли хаба.
//
// Параметры:
//  Причина - Строка - код отказа СервисаПользователей.
//
// Возвращаемое значение:
//  Строка.
//
Функция СменаРоли(Знач Причина) Экспорт

	Если Причина = СервисПользователей.ПричинаСебе() Тогда
		Чего = "свою роль изменить нельзя — это мгновенный само-локаут";
	ИначеЕсли Причина = СервисПользователей.ПричинаНетУчётки() Тогда
		Чего = "учётная запись не найдена, возможно, её уже удалили";
	ИначеЕсли Причина = СервисПользователей.ПричинаНеизвестнаяРоль() Тогда
		Чего = "такой роли на хабе нет";
	ИначеЕсли Причина = СервисПользователей.ПричинаНеАдмин() Тогда
		Чего = "роль хаба меняет только администратор";
	Иначе
		Чего = "операция не выполнена, попробуйте ещё раз";
	КонецЕсли;

	Возврат "Роль НЕ изменена: " + Чего + ".";

КонецФункции

// Текст отказа в блокировке либо разблокировке учётной записи.
//
// Параметры:
//  Причина - Строка - код отказа СервисаАктивностиУчёток.
//  Открываем - Булево - Истина, если пытались разблокировать.
//
// Возвращаемое значение:
//  Строка.
//
Функция СменаАктивности(Знач Причина, Знач Открываем) Экспорт

	Если Причина = Активность.ПричинаСебе() Тогда
		Чего = "себя заблокировать нельзя — это мгновенный само-локаут";
	ИначеЕсли Причина = Активность.ПричинаНетУчётки() Тогда
		Чего = "учётная запись не найдена, возможно, её уже удалили";
	ИначеЕсли Причина = Активность.ПричинаНетСпособаВхода() Тогда
		Чего = "в эту учётку нечем войти: ни пароля, ни привязанного провайдера."
			+ " Выпустите ссылку установки пароля";
	ИначеЕсли Причина = Активность.ПричинаНеАдмин() Тогда
		Чего = "активность учёток меняет только администратор";
	Иначе
		Чего = "операция не выполнена, попробуйте ещё раз";
	КонецЕсли;

	Возврат ?(Открываем, "Учётная запись НЕ разблокирована: ",
		"Учётная запись НЕ заблокирована: ") + Чего + ".";

КонецФункции

// Текст отказа в заведении учётки либо выпуске ссылки установки пароля.
//
// Параметры:
//  Исход - Структура - отказ СлужбыПриглашений (Причина, Сообщение).
//
// Возвращаемое значение:
//  Строка.
//
Функция ВыпускСсылки(Знач Исход) Экспорт

	Если Исход.Причина = Приглашения.ПричинаСоздание() Тогда
		// доменный текст уже написан для человека: занятый логин, чужое имя, неизвестная роль
		Чего = Строка(Исход.Сообщение);
	ИначеЕсли Исход.Причина = Приглашения.ПричинаНетУчётки() Тогда
		Чего = "учётная запись не найдена, возможно, её уже удалили";
	ИначеЕсли Исход.Причина = Приглашения.ПричинаНеАдмин()
		ИЛИ Исход.Причина = Приглашения.ПричинаАноним() Тогда
		Чего = "учётки заводит и ссылки выпускает только администратор хаба";
	ИначеЕсли Исход.Причина = Приглашения.ПричинаКлючЗапрещён()
		ИЛИ Исход.Причина = Приглашения.ПричинаКлючОтклонён()
		ИЛИ Исход.Причина = Приглашения.ПричинаГейтКлюча() Тогда
		Чего = "ключом доступа учётки не заводят — только из браузера по сессии";
	ИначеЕсли Исход.Причина = Приглашения.ПричинаОнбординг() Тогда
		Чего = "хаб ещё не настроен: сначала мастер первого запуска";
	ИначеЕсли Исход.Причина = Приглашения.ПричинаПарольныйВходВыключен() Тогда
		Чего = "вход по логину и паролю на хабе выключен, и заданный по ссылке пароль"
			+ " никого не пустит. Заводите людей через провайдера входа либо включите"
			+ " парольный вход";
	Иначе
		Чего = "операция не выполнена, попробуйте ещё раз";
	КонецЕсли;

	Возврат "Ссылка НЕ выпущена: " + Чего + ".";

КонецФункции

// Объяснение отказа удаления. Каждый код — своя ветка: нераспознанный получает общий
// текст, а не текст соседней причины.
//
// Параметры:
//  Причина - Строка - код исхода УдалениеУчётки.ПроверитьУдаление.
//
// Возвращаемое значение:
//  Строка.
//
Функция Удаление(Знач Причина) Экспорт

	Если Причина = УдалениеУчёток.ПричинаСебе() Тогда
		Чего = "себя удалить нельзя — вернуть учётку будет нечем";
	ИначеЕсли Причина = УдалениеУчёток.ПричинаНетУчётки() Тогда
		Чего = "учётная запись не найдена, возможно, её уже удалили";
	ИначеЕсли Причина = УдалениеУчёток.ПричинаПоследнийАдмин() Тогда
		Чего = "это последний администратор хаба: сначала назначьте другого";
	ИначеЕсли Причина = УдалениеУчёток.ПричинаНеАдмин() Тогда
		Чего = "учётные записи удаляет только администратор";
	Иначе
		Чего = "операция не выполнена, попробуйте ещё раз";
	КонецЕсли;

	Возврат "Учётная запись НЕ удалена: " + Чего + ".";

КонецФункции

// Отказ по неподтверждённому удалению: логин набран неверно либо не набран вовсе.
//
// Возвращаемое значение:
//  Строка.
//
// Отказ по сорвавшемуся удалению: порог пройден, но операция не доехала — чаще всего
// отказало внешнее хранилище. Учётка при этом цела: личное пространство сносится первым
// и до него ничего не тронуто.
//
// Параметры:
//  Подробность - Строка - краткое представление ошибки для администратора.
//
// Возвращаемое значение:
//  Строка.
//
Функция УдалениеСорвалось(Знач Подробность) Экспорт
	Возврат "Учётная запись НЕ удалена: операция сорвалась, и ничего не тронуто."
		+ " Чаще всего отказывает файловое хранилище пула. Подробность: "
		+ СтрЗаменить(Строка(Подробность), Символы.ПС, " ");
КонецФункции

Функция УдалениеБезПодтверждения() Экспорт
	Возврат "Учётная запись НЕ удалена: подтверждение не совпало."
		+ " Наберите логин удаляемой учётной записи точно так, как он написан.";
КонецФункции

// Текст отказа на нераспознанной операции формы раздела.
//
// Возвращаемое значение:
//  Строка.
//
Функция НеизвестнаяОперация() Экспорт
	Возврат "Форма прислала неизвестное действие — операция не выполнена.";
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "СервисАктивностиУчёток") _Активность,
	&Пластилин(Значение = "СлужбаПриглашений") _Приглашения,
	&Пластилин(Значение = "УдалениеУчётки") _УдалениеУчёток)

	СервисПользователей = _СервисПользователей;
	Активность = _Активность;
	Приглашения = _Приглашения;
	УдалениеУчёток = _УдалениеУчёток;

КонецПроцедуры
