// Подписки хаба — контроллер модуля web-ui.

Перем ГвардХаб;        // ГвардХабАдмина (кабинет)
Перем Ответы;          // ОтветыНастроек (web-ui)
Перем Дом;             // ДомХаба (web-ui)
Перем Витрина;         // ВитринаПодписок (web-ui)
Перем ВитринаЗначений; // ВитринаНастроек (web-ui) — блок «Доставка» на этом же экране
Перем Ход;             // ХодПодписок (web-ui) — общий ход раздела подписок
Перем Защита;          // ЗащитаCSRF (auth) — токен для форм страницы
Перем СервисПодписок;  // СервисПодписок (подписки)
Перем Тексты;          // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Бланки;          // БланкРаздела (web-ui) — адрес и токен блока «Доставка»

#Область ТочкиМаршрута

// Точка маршрута «webhooks» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  kind - Строка - тип действия, поля которого показывает форма заведения
//         (необязательный, по умолчанию "").
//
&ТочкаМаршрута("webhooks")
Процедура Раздел(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, kind = "") Экспорт

	Контекст = Подготовить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Показ = Ход.ПоказПоЗапросу(Ответ, Контекст, ОписаниеРаздела(), КукиЗапроса,
		МетодЗапроса, ТелоЗапроса, kind);
	ОтдатьРаздел(Ответ, Контекст, Показ, КукиЗапроса);

КонецПроцедуры

// Точка маршрута «webhooks/{id}/delete».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("webhooks/{id}/delete")
Процедура Удаление(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьДействие(Ответ, id, "удалить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «webhooks/{id}/save» — сохранение правки подписки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("webhooks/{id}/save")
Процедура Сохранение(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьДействие(Ответ, id, "сохранить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «webhooks/{id}/test» — пробная отправка сохранёнными настройками.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("webhooks/{id}/test")
Процедура ПробнаяОтправка(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьДействие(Ответ, id, "проба", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «webhooks/{id}/toggle».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("webhooks/{id}/toggle")
Процедура Переключение(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьДействие(Ответ, id, "переключить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура ВыполнитьДействие(Ответ, Знач id, Знач Действие,
	Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)

	Контекст = Подготовить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Показ = Ход.ПоказПоДействию(Ответ, Контекст, ОписаниеРаздела(), КукиЗапроса,
		МетодЗапроса, ТелоЗапроса, Действие, id);
	ОтдатьРаздел(Ответ, Контекст, Показ, КукиЗапроса);

КонецПроцедуры

#КонецОбласти

#Область ОбщаяЛогика

Функция Подготовить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)
	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Возврат ?(Вердикт.Разрешено, Вердикт, Неопределено);
КонецФункции

// Чьи это подписки и по какому адресу живёт раздел — всё, что ход о доме знает.
Функция ОписаниеРаздела()
	Возврат Ход.ОписаниеРаздела(СервисПодписок.ОбъектХаба(), Дом.АдресРаздела("webhooks"));
КонецФункции

#КонецОбласти

#Область Рендер

// Пустой показ рисовать нечего: ход уже ответил сам — отбил форму гейтом, не нашёл
// подписку либо увёл редиректом.
Процедура ОтдатьРаздел(Ответ, Знач Контекст, Знач Показ, Знач КукиЗапроса)

	Если Показ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Токен = Защита.ТокенСессии(Контекст.Сессия);

	Модель = Ответы.МодельДома(Дом, "",
		Дом.Разделы("webhooks"),
		Ход.Уведомления(Показ),
		Секции(ПараметрыВитрины(Показ, Токен), Токен));

	Ответы.ОтдатьДом(Ответ, Модель, Контекст.Пользователь, КукиЗапроса, Дом.Заголовок(),
		Показ.Статус);

КонецПроцедуры

Функция ПараметрыВитрины(Знач Показ, Знач Токен)
	// за гвардом хаб-админа иначе не бывает
	Возврат Ход.ПараметрыВитрины(Показ, ОписаниеРаздела(), Токен,
		Тексты.Текст("subscriptions.hub.lead"), Истина);
КонецФункции

// Форма блока постится на СВОЙ адрес: подписка и доставка не делят одну точку маршрута.
Функция Секции(Знач Параметры, Знач Токен)

	Результат = Витрина.Секции(Параметры);

	Блок = "delivery";
	Для Каждого Секция Из ВитринаЗначений.Секции(Блок, Дом.ПодписьРаздела(Блок),
		Дом.ЛидРаздела(Блок), Бланки.НаАдресе(Дом.АдресРаздела(Блок), Токен)) Цикл
		Результат.Добавить(Секция);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

&Контроллер("/hub/settings")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардХабАдмина") _ГвардХаб,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ВитринаПодписок") _Витрина,
	&Пластилин(Значение = "ВитринаНастроек") _ВитринаЗначений,
	&Пластилин(Значение = "ХодПодписок") _Ход,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "БланкРаздела") _Бланки)

	ГвардХаб = _ГвардХаб;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	ВитринаЗначений = _ВитринаЗначений;
	Ход = _Ход;
	Защита = _Защита;
	СервисПодписок = _СервисПодписок;
	Тексты = _Тексты;
	Бланки = _Бланки;

КонецПроцедуры
