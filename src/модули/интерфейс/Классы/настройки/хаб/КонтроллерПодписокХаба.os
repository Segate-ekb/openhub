// Подписки хаба — контроллер модуля web-ui.

Перем ГвардХаб;       // ГвардХабАдмина (кабинет)
Перем Ответы;         // ОтветыНастроек (web-ui)
Перем Дом;            // ДомХаба (web-ui)
Перем Витрина;        // ВитринаПодписок (web-ui)
Перем ВитринаЗначений; // ВитринаНастроек (web-ui) — блок «Доставка» на этом же экране
Перем Пульт;          // ПультПодписок (web-ui)
Перем Защита;         // ЗащитаCSRF (auth) — токен для форм страницы
Перем СервисПодписок; // СервисПодписок (подписки)
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ТочкиМаршрута

// Точка маршрута «webhooks» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  kind - Строка - тип действия, поля которого показывает форма заведения
//         (необязательный, по умолчанию "").
//
&ТочкаМаршрута("webhooks")
Процедура Раздел(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, kind = "") Экспорт

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Вердикт, "", "", КукиЗапроса, 200, kind);
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт.Сессия, Вердикт.Пользователь, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗавершитьДействие(Ответ, Вердикт,
		Пульт.Создать(Вердикт.Пользователь, СервисПодписок.ОбъектХаба(), Форма), КукиЗапроса,
		Пульт.ТипДействия(Форма), Форма);

КонецПроцедуры

// Точка маршрута «webhooks/{id}/delete».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("webhooks/{id}/delete")
Процедура Удаление(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Выполнить_(Ответ, id, "удалить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «webhooks/{id}/save» — сохранение правки подписки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("webhooks/{id}/save")
Процедура Сохранение(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Выполнить_(Ответ, id, "сохранить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «webhooks/{id}/test» — пробная отправка сохранёнными настройками.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("webhooks/{id}/test")
Процедура ПробнаяОтправка(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Выполнить_(Ответ, id, "проба", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «webhooks/{id}/toggle».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("webhooks/{id}/toggle")
Процедура Переключение(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Выполнить_(Ответ, id, "переключить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура Выполнить_(Ответ, Знач id, Знач Действие,
	Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "POST", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт.Сессия, Вердикт.Пользователь, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗавершитьДействие(Ответ, Вердикт,
		Пульт.Применить(Вердикт.Пользователь, СервисПодписок.ОбъектХаба(), Действие, id, Форма),
		КукиЗапроса, Пульт.ТипДействия(Форма), Форма, id);

КонецПроцедуры

Процедура ЗавершитьДействие(Ответ, Знач Вердикт, Знач Исход, Знач КукиЗапроса, Знач Тип = "",
	Знач Форма = Неопределено, Знач ПравкаИд = 0)

	Если Исход.НеНайдено Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт.Пользователь,
			Тексты.Текст("subscriptions.error.notfound"), КукиЗапроса);
		Возврат;
	КонецЕсли;
	Если НЕ Исход.Успех Тогда
		ОтдатьРаздел(Ответ, Вердикт, "", Исход.Ошибка, КукиЗапроса, 400, Тип, Форма, ПравкаИд);
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Исход.Сообщение) Тогда
		ОтдатьРаздел(Ответ, Вердикт, "", "", КукиЗапроса, 200, Тип, Неопределено, 0,
			Исход.Сообщение, Исход.ВидСообщения);
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Исход.Секрет) Тогда
		ОтдатьРаздел(Ответ, Вердикт, Исход.Секрет, "", КукиЗапроса);
		Возврат;
	КонецЕсли;
	Ответ.Перенаправить(Дом.АдресРаздела("webhooks"));

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач НовыйСекрет, Знач Ошибка, Знач КукиЗапроса,
	Знач Статус = 200, Знач Тип = "", Знач Форма = Неопределено, Знач ПравкаИд = 0,
	Знач Сообщение = "", Знач ВидСообщения = "")

	Уведомления = Новый Массив();
	Если ЗначениеЗаполнено(НовыйСекрет) Тогда
		Уведомления.Добавить(Ответы.Уведомление(Тексты.Текст("subscriptions.notice.created"), "ok"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Уведомления.Добавить(Ответы.Уведомление(Ошибка, "err"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Сообщение) Тогда
		Уведомления.Добавить(Ответы.Уведомление(Сообщение, ВидСообщения));
	КонецЕсли;

	Параметры = Новый Структура();
	Параметры.Вставить("Объект", СервисПодписок.ОбъектХаба());
	Параметры.Вставить("Адрес", Дом.АдресРаздела("webhooks"));
	Параметры.Вставить("Токен", Защита.ТокенСессии(Вердикт.Сессия));
	Параметры.Вставить("НовыйСекрет", НовыйСекрет);
	Параметры.Вставить("Пояснение", Тексты.Текст("subscriptions.hub.lead"));
	Параметры.Вставить("МожноМенять", Истина); // за гвардом хаб-админа иначе не бывает
	Параметры.Вставить("Тип", Тип);
	// отказ возвращает форму заполненной ровно тем, что прислали (секреты — исключение)
	Параметры.Вставить("Форма", Форма);
	Параметры.Вставить("ПравкаИд", ПравкаИд);

	Модель = Новый Структура();
	Модель.Вставить("Ключ", Дом.Ключ());
	Модель.Вставить("Заголовок", Дом.Заголовок());
	Модель.Вставить("Пояснение", Дом.Пояснение());
	Модель.Вставить("Разделы", Дом.Разделы("webhooks"));
	Модель.Вставить("Уведомления", Уведомления);
	Модель.Вставить("Секции", Секции(Параметры, Защита.ТокенСессии(Вердикт.Сессия)));

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт.Пользователь, КукиЗапроса, Дом.Заголовок(), Статус);

КонецПроцедуры

// Подписки и их доставка — один экран: сначала сами подписки, следом настройки доставки.
// Форма блока постится на СВОЙ адрес, а возвращает сюда — так подписка и доставка
// не делят одну точку маршрута.
Функция Секции(Знач Параметры, Знач Токен)

	Результат = Витрина.Секции(Параметры);

	Блок = "delivery";
	Для Каждого Секция Из ВитринаЗначений.Секции(Блок, Дом.ПодписьРаздела(Блок),
		Дом.ЛидРаздела(Блок), Дом.АдресРаздела(Блок), Токен) Цикл
		Результат.Добавить(Секция);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

&Контроллер("/hub/settings")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардХабАдмина") _ГвардХаб,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ВитринаПодписок") _Витрина,
	&Пластилин(Значение = "ВитринаНастроек") _ВитринаЗначений,
	&Пластилин(Значение = "ПультПодписок") _Пульт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	ГвардХаб = _ГвардХаб;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	ВитринаЗначений = _ВитринаЗначений;
	Пульт = _Пульт;
	Защита = _Защита;
	СервисПодписок = _СервисПодписок;
	Тексты = _Тексты;

КонецПроцедуры
