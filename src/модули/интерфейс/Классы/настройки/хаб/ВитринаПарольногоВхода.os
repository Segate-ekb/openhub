// Витрина парольного входа — желудь модуля web-ui: опасная зона подтверждения перед
// выключением настройки «Вход по логину и паролю» в разделе «Аутентификация» дома «Хаб».
// Экран собирается элементами кита.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — заготовка секции
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секция-подтверждение: опасная зона с числами вердикта и полем эха.
//
// Параметры:
//  Вердикт - Структура - результат СтражПарольногоВхода.ПроверитьВыключение.
//  Адрес - Строка - адрес раздела (он же action формы).
//  Токен - Строка - CSRF-токен сессии.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция СекцияПодтверждения(Знач Вердикт, Знач Адрес, Знач Токен) Экспорт

	Подтверждение = Кит.Холст();
	Подтверждение.Добавить(ПолеОперации());
	Подтверждение.Добавить(ЗонаВыключения(Вердикт));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.hub.passwordlogin.confirm.title"),
		Тексты.Текст("settings.hub.passwordlogin.confirm.lead"), Подтверждение.Рендер());
	Секция.Иконка = "предупреждение";
	Секция.Действие = Адрес;
	Секция.Токен = Токен;
	Секция.Опасная = Истина;
	// кнопка живёт внутри опасной зоны — общая панель сохранения секции не нужна
	Секция.БезПанели = Истина;
	Возврат Секция;

КонецФункции

// Имя скрытого поля операции подтверждения.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Значение операции «выключить вход по логину и паролю».
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеОперации() Экспорт
	Возврат "парольный-вход";
КонецФункции

// Имя поля, в которое человек вводит эхо подтверждения.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляЭха() Экспорт
	Возврат "подтверждение";
КонецФункции

// Слово, которое человек повторяет, чтобы подтвердить выключение. Одна точка на печать
// поля и на серверную сверку.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОбразецЭха() Экспорт
	Возврат Тексты.Текст("settings.hub.passwordlogin.confirm.echo.sample");
КонецФункции

#КонецОбласти

#Область СодержимоеПодтверждения

Функция ПолеОперации()
	Возврат Кит.СкрытоеПоле(ИмяПоляОперации(), ЗначениеОперации());
КонецФункции

// Опасная зона со своей кнопкой и своим вопросом браузера; её тело — три честных абзаца.
Функция ЗонаВыключения(Знач Вердикт)

	Зона = Кит.ОпаснаяЗона(Новый Структура("Кнопка, Подтверждение",
		Новый Структура("Подпись", Тексты.Текст("settings.hub.passwordlogin.confirm.button")),
		ЭхоВыключения()));

	// что гаснет — в пояснении секции; здесь честно перечислено, что НЕ гаснет,
	// и чем именно возвращается форма, если провайдер сломается
	Зона.Добавить(ЧислоВходящих(Вердикт));
	Зона.Добавить(ЧтоОстаётся());
	Зона.Добавить(ЗапаснаяДорога());

	Возврат Зона;

КонецФункции

Функция ЭхоВыключения()

	Возврат Новый Структура("Имя, Метка, Образец, Подсказка",
		ИмяПоляЭха(),
		Тексты.Текст("settings.hub.passwordlogin.confirm.echo.label"),
		ОбразецЭха(),
		Тексты.Шаблон("settings.hub.passwordlogin.confirm.echo.hint", ОбразецЭха()));

КонецФункции

Функция ЧислоВходящих(Знач Вердикт)

	Возврат Кит.Примечание(Тексты.Шаблон("settings.hub.passwordlogin.confirm.counts",
		Тексты.ЧислоТекстом(Вердикт.Админов), Тексты.ЧислоТекстом(Вердикт.Провайдеров)));

КонецФункции

Функция ЧтоОстаётся()
	Возврат Кит.Примечание(Тексты.Текст("settings.hub.passwordlogin.confirm.stays"));
КонецФункции

Функция ЗапаснаяДорога()
	Возврат Кит.Примечание(Тексты.Текст("settings.hub.passwordlogin.confirm.rescue"));
КонецФункции

#КонецОбласти

&Прозвище("ВитринаПарольногоВхода")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Тексты = _Тексты;

КонецПроцедуры
