// Операция «отправить проверочное письмо» в разделе «Почта» дома «Хаб». Получателя форма
// не называет: письмо уходит на адрес учётной записи того, кто нажал кнопку.

Перем РазборФормы;   // РазборФормы (web-ui)
Перем Почта;         // СлужбаПочты (почта)
Перем Окно;          // ВитринаПробыПочты (web-ui) — имя и значение поля операции
Перем ФабрикаИтога;  // ИтогПульта (web-ui) — единая форма итога операции
Перем Адрес;         // АдресИнстанса (основа) — чем хаб называет себя в письме
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Ключ раздела дома «Хаб», в котором живёт проверка.
//
// Возвращаемое значение:
//  Строка.
//
Функция Раздел() Экспорт
	Возврат "mail";
КонецФункции

// Разбирает POST раздела и, если он касается проверки почты, распоряжается им сам.
//
// Параметры:
//  Раздел - Строка - ключ раздела дома «Хаб».
//  Форма - Соответствие - разобранная форма.
//  Пользователь - Пользователь, Неопределено - учётная запись администратора.
//
// Возвращаемое значение:
//  Структура - как у прочих пультов: Перехвачено, Ошибка, Спросить, Уведомление, Окно,
//              Адрес, Статус.
//
Функция Применить(Знач Раздел, Знач Форма, Знач Пользователь) Экспорт

	Если Раздел <> Раздел() Тогда
		Возврат Мимо();
	КонецЕсли;

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, Окно.ИмяПоляОперации())));
	Если Операция <> Окно.ЗначениеОперации() Тогда
		Возврат Мимо();
	КонецЕсли;

	Если НЕ Почта.Настроена() Тогда
		Возврат Отказ(Тексты.Текст("settings.hub.mail.test.error.off"));
	КонецЕсли;

	Получатель = ?(Пользователь = Неопределено, "", СокрЛП(Строка(Пользователь.Email)));
	Если НЕ ЗначениеЗаполнено(Получатель) Тогда
		Возврат Отказ(Тексты.Текст("settings.hub.mail.test.error.noemail"));
	КонецЕсли;

	Итог = Почта.Отправить(Получатель, Тексты.Текст("settings.hub.mail.test.subject"),
		Тексты.Шаблон("settings.hub.mail.test.body", Адрес.Базовый()));

	Если НЕ Итог.Успех Тогда
		Возврат Отказ(?(Итог.Причина = Почта.ПричинаАдрес(),
			Тексты.Текст("settings.hub.mail.test.error.address"),
			Тексты.Текст("settings.hub.mail.test.error.send")));
	КонецЕсли;

	Результат = Успех();
	Результат.Уведомление = Тексты.Шаблон("settings.hub.mail.test.done", Получатель);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Мимо()
	Возврат Итог(Ложь, "");
КонецФункции

Функция Успех()
	Возврат Итог(Истина, "");
КонецФункции

Функция Отказ(Знач Сообщение)
	Возврат Итог(Истина, Сообщение);
КонецФункции

// Окно пульт не заполняет: вопросов он не задаёт.
Функция Итог(Знач Перехвачено, Знач Ошибка)
	Возврат ФабрикаИтога.Перехват(Перехвачено, Ошибка);
КонецФункции

#КонецОбласти

&Прозвище("ПультПробыПочты")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СлужбаПочты") _Почта,
	&Пластилин(Значение = "ВитринаПробыПочты") _Окно,
	&Пластилин(Значение = "ИтогПульта") _ФабрикаИтога,
	&Пластилин(Значение = "АдресИнстанса") _Адрес,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	Почта = _Почта;
	Окно = _Окно;
	ФабрикаИтога = _ФабрикаИтога;
	Адрес = _Адрес;
	Тексты = _Тексты;

КонецПроцедуры
