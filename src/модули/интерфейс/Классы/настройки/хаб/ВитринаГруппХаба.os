// Витрина групп хаба — желудь модуля web-ui: раздел «Группы» дома «Хаб».
// Экран собирается элементами кита.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем Ячейки;            // ЯчейкиТаблицы (web-ui) — заготовки ячеек таблиц
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем Форма;             // ФормаСозданияГруппы (web-ui) — окно заведения группы
Перем СервисГрупп;       // СервисГрупп (auth) — список групп и их состав
Перем ДомГруппы;         // ДомГруппы (web-ui) — адрес дома настроек группы
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Бланки;            // БланкРаздела (web-ui) — адрес и токен раздела, формы на них
Перем Примечания;  // ПримечанияЭкрана (web-ui) — вид «показывать нечего»

#Область ПубличныйИнтерфейс

// Секции раздела «группы» дома «Хаб».
//
// Параметры:
//  Параметры - Структура:
//    * Адрес - Строка - адрес раздела (он же action форм);
//    * Токен - Строка - CSRF-токен сессии;
//    * Заведение - Структура, Неопределено - состояние окна заведения (Открыта, Заполнение, Отказы); Неопределено — окно закрыто и пусто.
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Бланк = Бланки.Раздела(Параметры);
	Группы = СервисГрупп.ВсеГруппы();

	Заведение = Неопределено;
	Параметры.Свойство("Заведение", Заведение);

	Результат = Новый Массив();
	Результат.Добавить(СекцияСписка(Группы, Бланк, Заведение));
	Если Группы.Количество() > 0 Тогда
		Результат.Добавить(СекцияУдаления(Группы, Бланк));
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СписокГрупп

Функция СекцияСписка(Знач Группы, Знач Бланк, Знач Заведение)

	// заведение живёт кнопкой над таблицей и окном поверх экрана: пока не нажали,
	// форма места не занимает. Как окно устроено, витрина не знает
	Список = Кит.Холст();
	Список.Добавить(ОкноЗаведения(Бланк, Заведение));
	Список.Добавить(ТаблицаГрупп(Группы));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.hub.groups.title"),
		Тексты.Текст("settings.hub.groups.lead"), Список.Рендер());
	Секция.Иконка = "аккаунт";
	// секция без «Действия»: заведение и удаление — свои самостоятельные формы
	Возврат Секция;

КонецФункции

Функция ТаблицаГрупп(Знач Группы)

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.groups.col.name")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.groups.col.description")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.groups.col.members")));

	Для Каждого Группа Из Группы Цикл
		Таблица.Добавить(ЗаписьГруппы(Группа));
	КонецЦикла;

	Таблица.Пусто().Добавить(Примечания.Пусто(Тексты.Текст("settings.hub.groups.empty")));
	Возврат Таблица;

КонецФункции

Функция ЗаписьГруппы(Знач Группа)

	Запись = Кит.Запись();
	Запись.Добавить(ИмяГруппы(Группа));
	Запись.Добавить(Ячейки.Текстовая(?(ЗначениеЗаполнено(Группа.Описание), Строка(Группа.Описание), "")));
	Запись.Добавить(Ячейки.Текстовая(ЧислоУчастников(Группа)));
	Возврат Запись;

КонецФункции

// Имя ведёт в дом настроек самой группы: отсюда правят состав и права.
Функция ИмяГруппы(Знач Группа)

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Ссылка(ДомГруппы.БазовыйАдрес(Группа.Имя)))
		.Добавить(Кит.Текст(Группа.Имя));
	Возврат Результат;

КонецФункции

Функция ЧислоУчастников(Знач Группа)

	Возврат Тексты.ЧислоТекстом(
		СервисГрупп.УчастникиГруппы(Группа.Идентификатор).Количество());

КонецФункции

Функция ОкноЗаведения(Знач Бланк, Знач Заведение)

	Модель = Новый Структура("Адрес, Токен", Бланки.Адрес(Бланк), Бланк.Токен);
	Если Заведение <> Неопределено Тогда
		// отбитая форма возвращается ТЕМ ЖЕ окном: с набранным и помеченным полем
		Модель.Вставить("Открыта", Заведение.Открыта);
		Модель.Вставить("Заполнение", Заведение.Заполнение);
		Модель.Вставить("Отказы", Заведение.Отказы);
	КонецЕсли;

	Возврат Форма.Окно(Модель);

КонецФункции

#КонецОбласти

#Область УдалениеГруппы

// Подтверждается вводом имени: сверяет его сервер, экран только показывает поле.
Функция СекцияУдаления(Знач Группы, Знач Бланк)

	Удаление = Кит.Холст();
	Удаление.Добавить(Кит.СкрытоеПоле("операция", "удалить"));
	Удаление.Добавить(ЗонаУдаления(Группы));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.hub.group-delete.title"),
		Тексты.Текст("settings.hub.group-delete.lead"), Удаление.Рендер());
	Секция.Иконка = "предупреждение";
	Секция.Класс = "section--danger";
	Секция.Действие = Бланки.Адрес(Бланк);
	Секция.Токен = Бланк.Токен;
	// кнопка живёт внутри опасной зоны — общая панель сохранения секции не нужна
	Секция.БезПанели = Истина;
	Возврат Секция;

КонецФункции

Функция ЗонаУдаления(Знач Группы)

	Зона = Кит.ОпаснаяЗона(Новый Структура("Кнопка, Подтверждение",
		Новый Структура("Подпись", Тексты.Текст("settings.hub.group-delete.button")),
		ЭхоИмени()));

	Зона.Добавить(ВыборГруппы(Группы));
	Возврат Зона;

КонецФункции

Функция ВыборГруппы(Знач Группы)

	Варианты = Новый Массив();
	Для Каждого Группа Из Группы Цикл
		Варианты.Добавить(Новый Структура("Значение, Подпись", Группа.Имя, Группа.Имя));
	КонецЦикла;

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Варианты",
		"группа", Тексты.Текст("settings.hub.group-delete.select.label"), "выбор", Варианты));

КонецФункции

Функция ЭхоИмени()

	Возврат Новый Структура("Имя, Метка, Подсказка", "подтверждение",
		Тексты.Текст("settings.hub.group-delete.confirm.label"),
		Тексты.Текст("settings.hub.group-delete.confirm.hint"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти

&Прозвище("ВитринаГруппХаба")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ЯчейкиТаблицы") _Ячейки,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ФормаСозданияГруппы") _Форма,
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп,
	&Пластилин(Значение = "ДомГруппы") _ДомГруппы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "БланкРаздела") _Бланки,
	&Пластилин(Значение = "ПримечанияЭкрана") _Примечания) Экспорт

	Кит = _Кит;
	Ячейки = _Ячейки;
	РендерерНастроек = _РендерерНастроек;
	Форма = _Форма;
	СервисГрупп = _СервисГрупп;
	ДомГруппы = _ДомГруппы;
	Тексты = _Тексты;
	Бланки = _Бланки;
	Примечания = _Примечания;

КонецПроцедуры
