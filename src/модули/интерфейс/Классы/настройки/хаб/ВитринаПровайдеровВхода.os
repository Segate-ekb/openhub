// Витрина провайдеров входа — желудь модуля web-ui. Экран собирается элементами кита:
// холст наполняется вложенными, а разметку печатает кит.

Перем Кит;              // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек; // РендерерНастроек (кит) — описание секции
Перем Сервис;           // СервисПровайдеровВхода (oidc)
Перем Пресеты;          // ПресетыВхода (oidc)
Перем Поля;             // ФормаПровайдераВхода (web-ui) — владелец имён полей
Перем Активы;           // АдресаСтатики — адреса значков
Перем АдресХаба;        // АдресИнстанса (основа) — redirect_uri по умолчанию
Перем Тексты;           // ТекстыИнтерфейса (кит)
Перем Бланки;           // БланкРаздела (web-ui) — адрес и токен раздела, формы на них

#Область ПубличныйИнтерфейс

// Секции раздела.
//
// Параметры:
//  Параметры - Структура: * Адрес - Строка - базовый адрес раздела (он же action форм); * Токен - Строка - CSRF-токен сессии; * Пресет - Строка - пресет, поля которого показывает форма заведения.
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Бланк = Бланки.Раздела(Параметры);
	Пресет = ВыбранныйПресет(Параметры);
	Протокол = ВыбранныйПротокол(Параметры);

	СекцияСписка = РендерерНастроек.Секция(Тексты.Текст("providers.section.title"),
		Тексты.Текст("providers.section.lead"),
		СписокИнсталляций(Сервис.Инсталляции(), Бланк).Рендер());
	СекцияСписка.Иконка = "замок";

	Заведение = Кит.Холст();
	Заведение.Добавить(ВыборПресета(Бланк, Пресет));
	Заведение.Добавить(ФормаЗаведения(Бланк, Пресет, Протокол));

	СекцияЗаведения = РендерерНастроек.Секция(Тексты.Текст("providers.create.title"),
		Тексты.Текст("providers.create.lead"), Заведение.Рендер());
	СекцияЗаведения.Иконка = "плюс";

	Результат = Новый Массив();
	Результат.Добавить(СекцияСписка);
	Результат.Добавить(СекцияЗаведения);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СписокИнсталляций

// Одна раскрывашка на провайдера: свёрнутая — кто это и откуда, развёрнутая — поля.
Функция СписокИнсталляций(Знач Карточки, Знач Бланк)

	Список = Кит.Холст();

	Если Карточки.Количество() = 0 Тогда
		Список.Добавить(Кит.Примечание(Тексты.Текст("providers.list.empty")));
		Возврат Список;
	КонецЕсли;

	Для Каждого Карточка Из Карточки Цикл
		Инсталляция = Список.Добавить(Кит.Раскрывашка());
		СобратьШапкуИнсталляции(Инсталляция.Шапка(), Карточка);
		СобратьТелоИнсталляции(Инсталляция, Карточка, Бланк);
	КонецЦикла;

	Список.Добавить(Кит.Примечание(Тексты.Текст("providers.list.note")));
	Возврат Список;

КонецФункции

#КонецОбласти

#Область ШапкаИнсталляции

Процедура СобратьШапкуИнсталляции(Знач Шапка, Знач Карточка)

	Шапка.Добавить(ЗначокПровайдера(Карточка));
	Шапка.Добавить(ИмяПровайдера(Карточка));
	Шапка.Добавить(ПодписьПровайдера(Карточка));
	Шапка.Добавить(ПлашкаПресета(Карточка));
	Шапка.Добавить(ПлашкаПротокола(Карточка));
	Шапка.Добавить(ИздательТокенов(Карточка));
	Шапка.Добавить(ПлашкаСостояния(Карточка));
	Шапка.Добавить(ПлашкаИсточника(Карточка));

КонецПроцедуры

Функция ЗначокПровайдера(Знач Карточка)
	Возврат Кит.Картинка(Активы.АдресЗначка(Карточка.Значок), "значок");
КонецФункции

Функция ИмяПровайдера(Знач Карточка)
	Возврат Кодом(Кит.Надпись("название"), Карточка.Имя);
КонецФункции

Функция ПодписьПровайдера(Знач Карточка)
	Возврат Текстом(Кит.Надпись("пояснение"), Карточка.Метка);
КонецФункции

Функция ПлашкаПресета(Знач Карточка)
	Возврат Плашка(Пресеты.Подпись(Карточка.Пресет), "");
КонецФункции

Функция ПлашкаПротокола(Знач Карточка)
	Возврат Плашка(Карточка.ВидПротокола, "");
КонецФункции

Функция ИздательТокенов(Знач Карточка)
	Возврат Кодом(Кит.Надпись("сноска"), Карточка.Издатель);
КонецФункции

Функция ПлашкаСостояния(Знач Карточка)

	Состояние = ?(Карточка.Включён, Тексты.Текст("providers.state.on"),
		Тексты.Текст("providers.state.off"));

	Возврат Плашка(Состояние, ?(Карточка.Включён, "ok", ""));

КонецФункции

// Провайдер, заданный переменными окружения, помечен отдельно: правку сервер не примет.
Функция ПлашкаИсточника(Знач Карточка)

	Если Карточка.Источник = "конфиг" Тогда
		Возврат Плашка(Тексты.Текст("providers.state.overridden"), "warn");
	КонецЕсли;

	Возврат Плашка(Тексты.Текст("settings.source.db"), "");

КонецФункции

#КонецОбласти

#Область ТелоИнсталляции

Процедура СобратьТелоИнсталляции(Знач Тело, Знач Карточка, Знач Бланк)

	Если НЕ Карточка.Редактируемая Тогда
		СобратьТелоБезПравки(Тело, Карточка);
		Возврат;
	КонецЕсли;

	БланкКарточки = Бланки.Вложенный(Бланк, КодированиеИмени(Карточка.Имя));

	Тело.Добавить(ФормаПравкиИнсталляции(Карточка, БланкКарточки));
	Тело.Добавить(ФормаПереключения(Карточка, БланкКарточки));
	Тело.Добавить(ФормаУдаления(БланкКарточки));

КонецПроцедуры

// Провайдер из конфигурации: сервер такую правку не примет, экран об этом честно говорит.
Процедура СобратьТелоБезПравки(Знач Тело, Знач Карточка)

	Тело.Добавить(Кит.Примечание(Тексты.Текст("providers.locked.hint")));
	Тело.Добавить(ГотовыйАдресВозврата(Карточка.АдресВозврата));
	Тело.Добавить(ЗапертаяПодписьКнопки(Карточка));
	Тело.Добавить(ЗапертыйИздатель(Карточка));
	Тело.Добавить(ЗапертыйКлиент(Карточка));
	Тело.Добавить(ЗапертыйСекрет(Карточка));
	Тело.Добавить(ЗапертыеОбласти(Карточка));

КонецПроцедуры

Функция ЗапертаяПодписьКнопки(Знач Карточка)
	Возврат ЗапертоеПоле(Тексты.Текст("providers.field.label"), Карточка.Метка);
КонецФункции

Функция ЗапертыйИздатель(Знач Карточка)
	Возврат ЗапертоеПоле(Тексты.Текст("providers.field.issuer"), Карточка.Издатель);
КонецФункции

Функция ЗапертыйКлиент(Знач Карточка)
	Возврат ЗапертоеПоле(Тексты.Текст("providers.field.client"),
		Карточка.ИдентификаторКлиента);
КонецФункции

Функция ЗапертыйСекрет(Знач Карточка)
	Возврат ЗапертоеПоле(Тексты.Текст("providers.field.secret"), МаскаСекрета(Карточка));
КонецФункции

Функция ЗапертыеОбласти(Знач Карточка)
	Возврат ЗапертоеПоле(Тексты.Текст("providers.field.scope"), Карточка.Область);
КонецФункции

// Форма правки: учётные данные, политики и — только у своего провайдера — подпись и значок.
Функция ФормаПравкиИнсталляции(Знач Карточка, Знач Бланк)

	Правка = Бланки.Форма(Бланк, "save", "столбик");

	Правка.Добавить(ГотовыйАдресВозврата(Карточка.АдресВозврата));
	Правка.Добавить(ПравкаПодписиКнопки(Карточка));
	Правка.Добавить(ПравкаЗначка(Карточка));
	Правка.Добавить(ПравкаКлиента(Карточка));
	Правка.Добавить(ПолеСекрета(Карточка.СекретЗадан));
	Правка.Добавить(ПолеАдресаВозврата(Карточка.АдресВозврата));
	Правка.Добавить(ПолеОбластей(Карточка.Область));
	Правка.Добавить(ПолитикиГрупп(Карточка));
	Правка.Добавить(ФлажокВключения(Карточка.Включён));
	Правка.Добавить(КнопкаСохранения());

	Возврат Правка;

КонецФункции

// Подпись кнопки и значок правятся только у того провайдера, которому их не задал пресет.
Функция ПравкаПодписиКнопки(Знач Карточка)

	Если НЕ Пресеты.ПолеРазрешено(Карточка.Пресет, "Метка") Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат ПолеТекста(Поля.ИмяПоляМетки(), Тексты.Текст("providers.field.label"),
		Карточка.Метка, Ложь);

КонецФункции

Функция ПравкаЗначка(Знач Карточка)

	Если НЕ Пресеты.ПолеРазрешено(Карточка.Пресет, "Значок") Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат ПолеЗначка(Карточка.Значок);

КонецФункции

Функция ПравкаКлиента(Знач Карточка)
	Возврат ПолеТекста(Поля.ИмяПоляКлиента(), Тексты.Текст("providers.field.client"),
		Карточка.ИдентификаторКлиента, Истина);
КонецФункции

// Включение и выключение — своя форма: у неё своё действие и своя подпись кнопки.
Функция ФормаПереключения(Знач Карточка, Знач Бланк)

	Форма = Бланки.Форма(Бланк, "toggle");

	Форма.Добавить(Кит.СкрытоеПоле(Поля.ИмяПоляВключён(), ?(Карточка.Включён, "0", "1")));
	Форма.Добавить(КнопкаФормы(?(Карточка.Включён,
		Тексты.Текст("providers.button.disable"), Тексты.Текст("providers.button.enable"))));

	Возврат Форма;

КонецФункции

Функция ФормаУдаления(Знач Бланк)

	Возврат Бланки.КнопкаДействия(Бланк, "delete",
		Тексты.Текст("providers.button.delete"), "опасная");

КонецФункции

#КонецОбласти

#Область ФормаЗаведения

// Переключатель — ссылки: у каждого набора полей свой адрес, и страница живёт без скрипта.
Функция ВыборПресета(Знач Бланк, Знач Пресет)

	Выбор = Кит.Холст();

	Ряд = Выбор.Добавить(Кит.Ряд("выбор"));
	Ряд.Роль("группа").Подпись(Тексты.Текст("providers.field.preset.label"));
	Ряд.Признак("sets", Поля.ИмяПараметраПресета());

	Для Каждого Ключ Из КлючиПресетов() Цикл
		Ряд.Добавить(КнопкаВыбора(Пресеты.Подпись(Ключ),
			Бланки.Адрес(Бланк) + "?" + Поля.ИмяПараметраПресета() + "=" + КодированиеИмени(Ключ),
			Ключ = Пресет));
	КонецЦикла;

	Выбор.Добавить(Кит.Примечание(Тексты.Текст("providers.field.preset.hint")));
	Возврат Выбор;

КонецФункции

Функция КлючиПресетов()

	Результат = Новый Массив();
	Результат.Добавить(Пресеты.БезПресета());
	Для Каждого Ключ Из Пресеты.Ключи() Цикл
		Результат.Добавить(Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ФормаЗаведения(Знач Бланк, Знач Пресет, Знач Протокол)

	Заведение = Бланки.Форма(Бланк, "", "столбик");

	Заведение.Добавить(ПолеИмени());
	Для Каждого Ключ Из КлючиПресетов() Цикл
		Заведение.Добавить(НаборПресета(Ключ, Ключ = Пресет, Бланк, Протокол));
	КонецЦикла;
	Заведение.Добавить(ПолеНовогоКлиента());
	Заведение.Добавить(ПолеНовогоСекрета());
	Заведение.Добавить(ГотовыйАдресВозврата(АдресХаба.АдресВозврата()));
	Заведение.Добавить(ПолеАдресаВозврата(""));
	Заведение.Добавить(ПолитикиГрупп(Неопределено));
	Заведение.Добавить(ФлажокВключения(Истина));
	Заведение.Добавить(КнопкаЗаведения());

	Возврат Заведение;

КонецФункции

Функция ПолеИмени()
	Возврат ПолеТекста(Поля.ИмяПоляИмени(), Тексты.Текст("providers.field.name"), "", Истина);
КонецФункции

Функция ПолеНовогоКлиента()
	Возврат ПолеТекста(Поля.ИмяПоляКлиента(), Тексты.Текст("providers.field.client"),
		"", Истина);
КонецФункции

Функция ПолеНовогоСекрета()
	Возврат ПолеТекста(Поля.ИмяПоляСекрета(), Тексты.Текст("providers.field.secret"),
		"", Истина);
КонецФункции

// Невыбранный набор отключён и скрыт: браузер его не отправляет, и `required` в нём не мешает.
Функция НаборПресета(Знач Ключ, Знач Выбран, Знач Бланк, Знач Протокол)

	Набор = Кит.Группа("", "набор").Признак("set", Ключ);
	Если НЕ Выбран Тогда
		Набор.Отключить().Скрыть();
	КонецЕсли;

	Набор.Добавить(Кит.СкрытоеПоле(Поля.ИмяПоляПресета(), Ключ));
	Набор.Добавить(ПодписьКнопкиПресета(Ключ));
	Набор.Добавить(ЗначокПресета(Ключ));
	Набор.Добавить(БазовыйАдресПресета(Ключ));
	Набор.Добавить(ОбластиПресета(Ключ));
	Набор.Добавить(НастройкаВручную(Ключ, Бланк, Протокол));

	Возврат Набор;

КонецФункции

// Поле показывается, только если пресет его не задаёт сам; умолчание тоже от пресета.
Функция ПодписьКнопкиПресета(Знач Ключ)

	Если НЕ Пресеты.ПолеРазрешено(Ключ, "Метка") Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат ПолеТекста(Поля.ИмяПоляМетки(), Тексты.Текст("providers.field.label"), "", Ложь);

КонецФункции

Функция ЗначокПресета(Знач Ключ)

	Если НЕ Пресеты.ПолеРазрешено(Ключ, "Значок") Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат ПолеЗначка(Пресеты.УмолчаниеПоля(Ключ, "Значок"));

КонецФункции

Функция БазовыйАдресПресета(Знач Ключ)

	Если НЕ Пресеты.ПолеРазрешено(Ключ, "БазовыйАдрес") Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат ПолеТекста(Поля.ИмяПоляБазовогоАдреса(), Тексты.Текст("providers.field.base"),
		Пресеты.УмолчаниеПоля(Ключ, "БазовыйАдрес"), Ложь);

КонецФункции

Функция ОбластиПресета(Знач Ключ)

	Если НЕ Пресеты.ПолеРазрешено(Ключ, "Область") Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат ПолеОбластей(Пресеты.УмолчаниеПоля(Ключ, "Область"));

КонецФункции

#КонецОбласти

#Область НастройкаВручную

// Механика та же, что у пресетов: невыбранный набор до сервера не доезжает ни с JS, ни без него.
Функция НастройкаВручную(Знач Пресет, Знач Бланк, Знач Протокол)

	Если НЕ Пресеты.ПолеРазрешено(Пресет, "ВидПротокола") Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Действующий = Пресеты.ДействующийПротокол(Пресет, Протокол);

	Рамка = Кит.Группа(Тексты.Текст("providers.manual.legend"));
	Рамка.Добавить(Кит.Примечание(Тексты.Текст("providers.manual.note")));
	Рамка.Добавить(ВыборПротокола(Бланк, Пресет, Действующий));
	Для Каждого Вид Из ВидыПротокола() Цикл
		Рамка.Добавить(НаборПротокола(Пресет, Вид, Вид = Действующий));
	КонецЦикла;

	Возврат Рамка;

КонецФункции

Функция ВидыПротокола()

	Результат = Новый Массив();
	Результат.Добавить("oidc");
	Результат.Добавить("oauth2");
	Возврат Результат;

КонецФункции

// Подсказка стоит ПОД переключателем: она нужна до выбора, чтобы понять разницу наборов.
Функция ВыборПротокола(Знач Бланк, Знач Пресет, Знач Протокол)

	Выбор = Кит.Холст();

	Ряд = Выбор.Добавить(Кит.Ряд("выбор"));
	Ряд.Роль("группа").Подпись(Тексты.Текст("providers.field.protocol"));
	Ряд.Признак("sets", Поля.ИмяПараметраПротокола());

	Для Каждого Вид Из ВидыПротокола() Цикл
		Ряд.Добавить(КнопкаВыбора(Пресеты.ПодписьПротокола(Вид),
			Бланки.Адрес(Бланк) + "?" + Поля.ИмяПараметраПресета() + "=" + КодированиеИмени(Пресет)
				+ "&" + Поля.ИмяПараметраПротокола() + "=" + Вид,
			Вид = Протокол));
	КонецЦикла;

	Выбор.Добавить(Кит.Примечание(Тексты.Текст("providers.protocol.hint")));
	Возврат Выбор;

КонецФункции

// Вид протокола едет скрытым полем ВНУТРИ набора: второму источнику взяться неоткуда.
Функция НаборПротокола(Знач Пресет, Знач Вид, Знач Выбран)

	Набор = Кит.Группа("", "набор").Признак("set", Вид);
	Если НЕ Выбран Тогда
		Набор.Отключить().Скрыть();
	КонецЕсли;

	Набор.Добавить(Кит.СкрытоеПоле(Поля.ИмяПоляПротокола(), Вид));
	Набор.Добавить(ПолеИздателя(Пресет, Вид));
	Набор.Добавить(ПолеАдресаАвторизации(Пресет, Вид));
	Набор.Добавить(ПолеАдресаТокена(Пресет, Вид));
	Набор.Добавить(ПолеАдресаПрофиля(Пресет, Вид));
	Набор.Добавить(ПолеАдресаПисем(Пресет, Вид));

	Возврат Набор;

КонецФункции

Функция ПолеИздателя(Знач Пресет, Знач Вид)
	Возврат ПолеВручную(Поля.ИмяПоляИздателя(), "providers.field.issuer",
		Пресеты.ПолеРазрешено(Пресет, "Издатель", Вид),
		Пресеты.ПолеОбязательно(Пресет, "Издатель", Вид));
КонецФункции

Функция ПолеАдресаАвторизации(Знач Пресет, Знач Вид)
	Возврат ПолеВручную(Поля.ИмяПоляАвторизации(), "providers.field.authorize",
		Пресеты.ПолеРазрешено(Пресет, "АдресАвторизации", Вид),
		Пресеты.ПолеОбязательно(Пресет, "АдресАвторизации", Вид));
КонецФункции

Функция ПолеАдресаТокена(Знач Пресет, Знач Вид)
	Возврат ПолеВручную(Поля.ИмяПоляТокена(), "providers.field.token",
		Пресеты.ПолеРазрешено(Пресет, "АдресТокена", Вид),
		Пресеты.ПолеОбязательно(Пресет, "АдресТокена", Вид));
КонецФункции

Функция ПолеАдресаПрофиля(Знач Пресет, Знач Вид)
	Возврат ПолеВручную(Поля.ИмяПоляПрофиля(), "providers.field.profile",
		Пресеты.ПолеРазрешено(Пресет, "АдресПрофиля", Вид),
		Пресеты.ПолеОбязательно(Пресет, "АдресПрофиля", Вид));
КонецФункции

Функция ПолеАдресаПисем(Знач Пресет, Знач Вид)
	Возврат ПолеВручную(Поля.ИмяПоляПисем(), "providers.field.emails",
		Пресеты.ПолеРазрешено(Пресет, "АдресEmails", Вид),
		Пресеты.ПолеОбязательно(Пресет, "АдресEmails", Вид));
КонецФункции

// Разметка обязана говорить то же, что проверяет сервер: обязательность приходит от набора.
Функция ПолеВручную(Знач ИмяПоля, Знач КлючМетки, Знач Разрешено, Знач Обязательно)

	Если НЕ Разрешено Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат ПолеТекста(ИмяПоля, Тексты.Текст(КлючМетки), "", Обязательно);

КонецФункции

#КонецОбласти

#Область ПолитикиГрупп

Функция ПолитикиГрупп(Знач Карточка)

	Политики = Кит.Группа(Тексты.Текст("providers.policies.legend"));

	Политики.Добавить(Кит.Примечание(Тексты.Текст("providers.policies.note")));
	Политики.Добавить(ФлажокАвтоСоздания(Карточка));
	Политики.Добавить(ФлажокПровижининга(Карточка));
	Политики.Добавить(ФлажокСвязкиПоИмени(Карточка));
	Политики.Добавить(ПолеКлеймаГрупп(Карточка));
	Политики.Добавить(ПолеПрефиксаГрупп(Карточка));

	Возврат Политики;

КонецФункции

// В форме заведения карточки ещё нет: политики показываются выключенными и пустыми.
Функция ФлажокАвтоСоздания(Знач Карточка)
	Возврат Флажок(Поля.ИмяПоляАвтоСоздания(), Тексты.Текст("providers.field.autoprovision"),
		?(Карточка = Неопределено, Ложь, Карточка.АвтоСоздание));
КонецФункции

Функция ФлажокПровижининга(Знач Карточка)
	Возврат Флажок(Поля.ИмяПоляПровижининга(), Тексты.Текст("providers.field.groups.jit"),
		?(Карточка = Неопределено, Ложь, Карточка.ПровижинингГрупп));
КонецФункции

Функция ФлажокСвязкиПоИмени(Знач Карточка)
	Возврат Флажок(Поля.ИмяПоляСвязкиПоИмени(), Тексты.Текст("providers.field.groups.link"),
		?(Карточка = Неопределено, Ложь, Карточка.СвязкаГруппПоИмени));
КонецФункции

Функция ПолеКлеймаГрупп(Знач Карточка)
	Возврат ПолеТекста(Поля.ИмяПоляКлеймаГрупп(), Тексты.Текст("providers.field.groups.claim"),
		?(Карточка = Неопределено, "", Карточка.ИмяКлеймаГрупп), Ложь);
КонецФункции

Функция ПолеПрефиксаГрупп(Знач Карточка)
	Возврат ПолеТекста(Поля.ИмяПоляПрефиксаГрупп(),
		Тексты.Текст("providers.field.groups.prefix"),
		?(Карточка = Неопределено, "", Карточка.ПрефиксГрупп), Ложь);
КонецФункции

#КонецОбласти

#Область Поля

// Готовый к копированию redirect_uri. Пустой — честная строка о том, почему его нет.
Функция ГотовыйАдресВозврата(Знач Адрес)

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат Кит.Примечание(Тексты.Текст("providers.redirect.unset"));
	КонецЕсли;

	Возврат Кит.БлокКоманды(Новый Структура("Команда, Пояснение, Подпись",
		Адрес, Тексты.Текст("providers.redirect.note"),
		Тексты.Текст("providers.redirect.copy")));

КонецФункции

Функция ПолеАдресаВозврата(Знач Значение)
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Значение, Плейсхолдер, Подсказка",
		Поля.ИмяПоляВозврата(), Тексты.Текст("providers.field.redirect"), Строка(Значение),
		АдресХаба.АдресВозврата(), Тексты.Текст("providers.field.redirect.hint")));
КонецФункции

Функция ПолеЗначка(Знач Значение)

	Варианты = Новый Массив();
	Для Каждого Ключ Из Активы.КлючиЗначков() Цикл
		Варианты.Добавить(Новый Структура("Значение, Подпись", Ключ, ПодписьЗначка(Ключ)));
	КонецЦикла;

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Варианты, Значение, Подсказка",
		Поля.ИмяПоляЗначка(), Тексты.Текст("providers.field.icon"), "выбор", Варианты,
		Строка(Значение), Тексты.Текст("providers.field.icon.hint")));

КонецФункции

Функция ПолеСекрета(Знач СекретЗадан)
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Значение, Плейсхолдер, Подсказка",
		Поля.ИмяПоляСекрета(), Тексты.Текст("providers.field.secret"), "",
		?(СекретЗадан, Сервис.МаскаСекрета(), ""),
		Тексты.Текст("providers.field.secret.hint")));
КонецФункции

Функция ПолеТекста(Знач Имя, Знач Метка, Знач Значение, Знач Обязательное, Знач Подсказка = "")
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Значение, Обязательное, Подсказка",
		Имя, Метка, Строка(Значение), Обязательное = Истина, Подсказка));
КонецФункции

// Области меняют то, что провайдер спросит у КАЖДОГО входящего: подсказка про цену везде.
Функция ПолеОбластей(Знач Значение)
	Возврат ПолеТекста(Поля.ИмяПоляОбласти(), Тексты.Текст("providers.field.scope"),
		Значение, Ложь, Тексты.Текст("providers.field.scope.hint"));
КонецФункции

Функция ЗапертоеПоле(Знач Метка, Знач Значение)
	Возврат Кит.Поле(Новый Структура("Метка, Значение, Заблокировано",
		Метка, Строка(Значение), Истина));
КонецФункции

Функция Флажок(Знач Имя, Знач Метка, Знач Отмечено)
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Отмечено",
		Имя, Метка, "флажок", Поля.ЗначениеОтмечено(), Отмечено = Истина));
КонецФункции

Функция ФлажокВключения(Знач Отмечено)
	Возврат Флажок(Поля.ИмяПоляВключён(), Тексты.Текст("providers.field.enabled"), Отмечено);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Кодом(Знач Надпись, Знач Значение)

	Текст = Строка(Значение);
	Если ЗначениеЗаполнено(Текст) Тогда
		Надпись.Добавить(Кит.Код(Текст));
	КонецЕсли;

	Возврат Надпись;

КонецФункции

Функция Текстом(Знач Надпись, Знач Значение)
	Надпись.Добавить(Кит.Текст(Значение));
	Возврат Надпись;
КонецФункции

Функция Плашка(Знач Подпись, Знач Вид)

	Если НЕ ЗначениеЗаполнено(Подпись) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Плашка(Новый Структура("Текст, Вид", Подпись, Вид));

КонецФункции

Функция КнопкаФормы(Знач Подпись, Знач Вариант = "вторичная", Знач Размер = "малый")
	Возврат Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер", Подпись, Вариант, Размер));
КонецФункции

Функция КнопкаСохранения()
	Возврат КнопкаФормы(Тексты.Текст("providers.button.save"), "основная", "обычный");
КонецФункции

Функция КнопкаЗаведения()
	Возврат КнопкаФормы(Тексты.Текст("providers.button.create"), "основная", "обычный");
КонецФункции

Функция КнопкаВыбора(Знач Подпись, Знач Адрес, Знач Текущая)
	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Текущая",
		Подпись, Адрес, "вторичная", Текущая));
КонецФункции

Функция МаскаСекрета(Знач Карточка)
	Возврат ?(Карточка.СекретЗадан, Сервис.МаскаСекрета(), "");
КонецФункции

// Значок пресета подписан именем пресета, всё остальное — обобщённым ключом.
Функция ПодписьЗначка(Знач Ключ)
	Возврат ?(Пресеты.Ключи().Найти(Ключ) = Неопределено,
		Тексты.Текст("providers.icon.key"), Пресеты.Подпись(Ключ));
КонецФункции

// Пресет из адреса: неизвестный ключ — это «свой провайдер», а не пустой экран.
Функция ВыбранныйПресет(Знач Параметры)

	Значение = "";
	Если НЕ Параметры.Свойство("Пресет", Значение) ИЛИ Значение = Неопределено Тогда
		Возврат Пресеты.БезПресета();
	КонецЕсли;

	Норм = НРег(СокрЛП(Строка(Значение)));
	Возврат ?(Пресеты.Известен(Норм), Норм, Пресеты.БезПресета());

КонецФункции

// Протокол из адреса; неизвестное значение — тот, что действует по умолчанию.
Функция ВыбранныйПротокол(Знач Параметры)

	Значение = "";
	Если НЕ Параметры.Свойство("Протокол", Значение) ИЛИ Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат НРег(СокрЛП(Строка(Значение)));

КонецФункции

Функция КодированиеИмени(Знач Имя)
	Возврат КодироватьСтроку(Строка(Имя), СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти

&Прозвище("ВитринаПровайдеровВхода")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "СервисПровайдеровВхода") _Сервис,
	&Пластилин(Значение = "ПресетыВхода") _Пресеты,
	&Пластилин(Значение = "ФормаПровайдераВхода") _Поля,
	&Пластилин(Значение = "АдресаСтатики") _Активы,
	&Пластилин(Значение = "АдресИнстанса") _АдресХаба,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "БланкРаздела") _Бланки) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Сервис = _Сервис;
	Пресеты = _Пресеты;
	Поля = _Поля;
	Активы = _Активы;
	АдресХаба = _АдресХаба;
	Тексты = _Тексты;
	Бланки = _Бланки;

КонецПроцедуры
