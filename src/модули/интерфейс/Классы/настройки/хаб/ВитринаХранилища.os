// Состояние хранилища артефактов человеческим языком: отвечает ли оно, на чём хранится,
// где лежит, сколько занято и каков потолок. Имена ключей — подпись мелким шрифтом.

Перем Кит;         // Кит (кит) — фабрика элементов экрана
Перем Ячейки;      // ЯчейкиТаблицы (web-ui) — заготовки ячеек таблиц
Перем Каркас;      // РендерерНастроек (кит) — заготовка секции
Перем Настройки;   // СервисНастроек (настройки) — действующие значения
Перем Потолок;     // ПотолокХранилища (хранилище) — живой лимит суммарного объёма
Перем Объёмы;      // ОбъёмТекстом (основа) — байты человеческими единицами
Перем Заполнение;  // ЗаполнениеПула (основа) — доля занятого
Перем Тексты;      // ТекстыИнтерфейса (кит)
Перем Даты;        // ДатаЧеловеку (основа) — момент словами
Перем Страж;       // СтражХранилища (хранилище) — отвечает ли хранилище
Перем УчётОбъёма;  // УчётОбъёмаПула (реестр) — занятое место по счётчикам хаба

#Область ПубличныйИнтерфейс

// Секция состояния хранилища.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция Секция() Экспорт

	// вердикт снимается один раз на отрисовку: фоновая проба вправе сменить его между
	// вызовами, и тогда полоса и плашка рассказывали бы про разные хранилища
	Отметка = Страж.Состояние();

	Состояние = Кит.Холст();
	Состояние.Добавить(СводкаСостояния(Отметка));
	Состояние.Добавить(ПолосаЗанятого(Отметка));
	Состояние.Добавить(ТаблицаСостояния(Отметка));
	Состояние.Добавить(ПодписьКлючей());

	Секция = Каркас.Секция(Тексты.Текст("settings.hub.storage.state.title"),
		Тексты.Текст("settings.hub.storage.state.lead"), Состояние.Рендер());
	Секция.Иконка = "скачать";
	Возврат Секция;

КонецФункции

#КонецОбласти

#Область СодержимоеСекции

// Отвечает хранилище или нет — первое, что видно на экране. Вердикт берётся у стража:
// открытый экран проверку не заказывает и ответом хранилища не задерживается.
// Разметка, а не проверка: спрашивать хранилище отсюда нечем и незачем.
Функция СводкаСостояния(Знач Отметка)

	Блок = Кит.Холст();
	Блок.Добавить(Кит.Плашка(Новый Структура("Текст, Вид",
		СостояниеСловами(Отметка), ВидСостояния(Отметка))));
	Блок.Добавить(Кит.Примечание(ПодробностиСостояния(Отметка)));
	Блок.Добавить(Кит.Примечание(Тексты.Шаблон("settings.hub.storage.health.lead",
		Тексты.ЧислоТекстом(ПериодПробыСек()))));
	Возврат Блок;

КонецФункции

// Не отвечающее хранилище полосы не получает вовсе: счётчики хаба нечем сверить с диском,
// и «занято 0 Б» на лежащем S3 — ровно та ложь, ради которой экран и переписан.
Функция ПолосаЗанятого(Знач Отметка)

	Если НЕ ЗанятоеИзвестно(Отметка) Тогда
		Возврат Кит.Примечание(Тексты.Текст("settings.hub.storage.meter.unknown"));
	КонецЕсли;

	Блок = Кит.Холст();
	Блок.Добавить(МераЗанятого());
	// откуда взялось число, сказано рядом с ним: учётное и замеренное расходятся
	Блок.Добавить(Кит.Примечание(Тексты.Текст("settings.hub.storage.meter.counted")));
	Возврат Блок;

КонецФункции

// Потолок ноль означает «объём не ограничен»: полоса не рисуется, пустая соврала бы про запас.
Функция МераЗанятого()

	Занято = ЗанятоБайт();
	ПотолокБайт = Цел(Потолок.ПотолокБайт());

	Если ПотолокБайт <= 0 Тогда
		Возврат Кит.Примечание(Тексты.Шаблон("settings.hub.storage.meter.free",
			Объёмы.Представление(Занято)));
	КонецЕсли;

	Возврат Кит.ПолосаЗаполнения(Новый Структура("Процент, Метка, Подпись",
		Заполнение.Процент(Занято, ПотолокБайт),
		Тексты.Текст("settings.hub.storage.meter.label"),
		Тексты.Шаблон("settings.hub.storage.meter.caption",
			Объёмы.Представление(Занято), Объёмы.Представление(ПотолокБайт))));

КонецФункции

// Строками «что — как настроено»: значения человеческие, имён ключей в ячейках нет.
Функция ТаблицаСостояния(Знач Отметка)

	Состояние = Кит.Таблица();
	Состояние.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.storage.col.what")));
	Состояние.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.storage.col.how")));

	Состояние.Добавить(Свойство(Тексты.Текст("settings.hub.storage.row.backend"),
		НазваниеБэкенда()));
	Состояние.Добавить(Свойство(Тексты.Текст("settings.hub.storage.row.where"), ГдеЛежит()));
	Состояние.Добавить(Свойство(Тексты.Текст("settings.hub.storage.row.occupied"),
		ЗанятоСловами(Отметка)));
	Состояние.Добавить(Свойство(Тексты.Текст("settings.hub.storage.row.quota"),
		ПотолокСловами()));
	Состояние.Добавить(Свойство(Тексты.Текст("settings.hub.storage.row.upload"),
		Объёмы.Представление(Целое("oshub.publish.max_upload_bytes"))));

	Возврат Состояние;

КонецФункции

// Имена переменных окружения содержанием экрана не являются: одна строка в самом низу.
Функция ПодписьКлючей()

	Сноска = Кит.Примечание();
	Сноска.Добавить(Кит.Шаблон(Тексты.Текст("settings.hub.storage.env.note")))
		.Добавить(Кит.Код(ПеременныеОкружения()));
	Возврат Сноска;

КонецФункции

Функция ПеременныеОкружения()

	Результат = "OSHUB_STORAGE_BACKEND, OSHUB_STORAGE_ROOT, OSHUB_STORAGE_QUOTA_BYTES";
	Если ЭтоS3() Тогда
		Результат = Результат + ", OSHUB_STORAGE_S3_BUCKET, OSHUB_STORAGE_S3_ENDPOINT";
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СостояниеХранилища

Функция СостояниеСловами(Знач Отметка)

	Если НЕ Отметка.Известно Тогда
		Возврат Тексты.Текст("settings.hub.storage.health.unknown");
	КонецЕсли;
	Если Отметка.ОтказДоступа Тогда
		Возврат Тексты.Текст("settings.hub.storage.health.denied");
	КонецЕсли;
	Если Отметка.Отвечает Тогда
		Возврат Тексты.Текст("settings.hub.storage.health.alive");
	КонецЕсли;
	Возврат Тексты.Текст("settings.hub.storage.health.down");

КонецФункции

Функция ВидСостояния(Знач Отметка)

	Если НЕ Отметка.Известно Тогда
		Возврат "";
	КонецЕсли;
	Если Отметка.ОтказДоступа Тогда
		Возврат "warn";
	КонецЕсли;
	Возврат ?(Отметка.Отвечает, "ok", "err");

КонецФункции

// С какого момента хранилище такое и чем оно ответило: без причины «не отвечает»
// не отличить от «сегодня решили не показывать».
Функция ПодробностиСостояния(Знач Отметка)

	Если НЕ Отметка.Известно Тогда
		Возврат Тексты.Текст("settings.hub.storage.health.never");
	КонецЕсли;

	Когда = Даты.Метка(Отметка.Изменилось);
	Если Отметка.ОтказДоступа Тогда
		Возврат Тексты.Шаблон("settings.hub.storage.health.since.denied", Когда, Отметка.Причина);
	КонецЕсли;
	Если НЕ Отметка.Отвечает Тогда
		Возврат Тексты.Шаблон("settings.hub.storage.health.since.down", Когда, Отметка.Причина);
	КонецЕсли;

	Возврат Тексты.Шаблон("settings.hub.storage.health.checked", Даты.Метка(Отметка.Проверено));

КонецФункции

// Занятое показывается, только пока хранилищу можно верить: молчащее и не пустившее
// оставляют счётчики хаба без сверки с диском. Непроверенное — не молчащее: до первого
// отказа экран показывает то, что знает хаб.
Функция ЗанятоеИзвестно(Знач Отметка)
	Возврат НЕ Отметка.Известно ИЛИ (Отметка.Отвечает И НЕ Отметка.ОтказДоступа);
КонецФункции

Функция ПериодПробыСек()
	Возврат Настройки.Целое("oshub.jobs.storage_health_interval_sec", 60, 1);
КонецФункции

#КонецОбласти

#Область ЗначенияСостояния

// Бэкенд — названием, а не значением ключа.
Функция НазваниеБэкенда()

	Если ЭтоS3() Тогда
		Возврат Тексты.Текст("settings.hub.storage.backend.s3");
	КонецЕсли;
	Возврат Тексты.Текст("settings.hub.storage.backend.fs");

КонецФункции

// Где лежат артефакты: каталог у файлового бэкенда, корзина и адрес у объектного.
Функция ГдеЛежит()

	Если НЕ ЭтоS3() Тогда
		Возврат Строкой("oshub.storage.root");
	КонецЕсли;

	Корзина = Строкой("oshub.storage.s3.bucket");
	Адрес = Строкой("oshub.storage.s3.endpoint");
	Префикс = Строкой("oshub.storage.s3.prefix");

	Место = Тексты.Шаблон("settings.hub.storage.where.s3", Корзина, Адрес);
	Если ЗначениеЗаполнено(Префикс) Тогда
		Место = Место + " " + Тексты.Шаблон("settings.hub.storage.where.prefix", Префикс);
	КонецЕсли;
	Возврат Место;

КонецФункции

// Занятое место лежачего хранилища называется неизвестным: счётчики хаба остались
// от последней удачной публикации, и выдавать их за замер диска нельзя.
Функция ЗанятоСловами(Знач Отметка)
	Возврат ?(ЗанятоеИзвестно(Отметка), Объёмы.Представление(ЗанятоБайт()),
		Тексты.Текст("settings.hub.storage.occupied.unknown"));
КонецФункции

Функция ПотолокСловами()

	ПотолокБайт = Цел(Потолок.ПотолокБайт());
	Если ПотолокБайт <= 0 Тогда
		Возврат Тексты.Текст("settings.hub.storage.quota.none");
	КонецЕсли;
	Возврат Объёмы.Представление(ПотолокБайт);

КонецФункции

// Занятое — по счётчикам пулов, которые хаб ведёт сам и приводит к замеру плановой
// сверкой: спрашивать бэкенд на отрисовке значило бы обходить каталог или листать
// корзину на каждое открытие экрана.
Функция ЗанятоБайт()
	Возврат Цел(УчётОбъёма.ЗанятоВсегоБайт());
КонецФункции

Функция ЭтоS3()
	Возврат НРег(Строкой("oshub.storage.backend")) = "s3";
КонецФункции

Функция Строкой(Знач Ключ)
	Возврат СокрЛП(Строка(Настройки.Значение(Ключ)));
КонецФункции

Функция Целое(Знач Ключ)
	Возврат Цел(Настройки.Значение(Ключ));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Незаполненное значение честно называет себя пустым, а не оставляет ячейку немой.
Функция Свойство(Знач Метка, Знач Значение)

	Запись = Кит.Запись();
	Запись.Добавить(Ячейки.Текстовая(Метка));
	Запись.Добавить(Ячейки.Текстовая(?(ЗначениеЗаполнено(Значение), Значение,
		Тексты.Текст("settings.value.empty"))));
	Возврат Запись;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ЯчейкиТаблицы") _Ячейки,
	&Пластилин(Значение = "РендерерНастроек") _Каркас,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ПотолокХранилища") _Потолок,
	&Пластилин(Значение = "ОбъёмТекстом") _Объёмы,
	&Пластилин(Значение = "ЗаполнениеПула") _Заполнение,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СтражХранилища") _Страж,
	&Пластилин(Значение = "УчётОбъёмаПула") _УчётОбъёма,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено) Экспорт

	Кит = _Кит;
	Ячейки = _Ячейки;
	Каркас = _Каркас;
	Настройки = _Настройки;
	Потолок = _Потолок;
	Объёмы = _Объёмы;
	Заполнение = _Заполнение;
	Тексты = _Тексты;
	Страж = _Страж;
	УчётОбъёма = _УчётОбъёма;
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);

КонецПроцедуры
