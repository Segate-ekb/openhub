// Витрина проверки почты — желудь модуля web-ui: секция раздела «Почта» дома «Хаб»
// с кнопкой «отправить проверочное письмо». Экран собирается элементами кита.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — заготовка секции
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секция проверки: одна кнопка и честное объяснение, куда уйдёт письмо.
//
// Параметры:
//  Адрес - Строка - адрес раздела (он же action формы).
//  Токен - Строка - CSRF-токен сессии.
//  АдресПолучателя - Строка - адрес учётной записи администратора ("" — адреса нет).
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция Секция(Знач Адрес, Знач Токен, Знач АдресПолучателя) Экспорт

	ЕстьКуда = ЗначениеЗаполнено(АдресПолучателя);

	Проба = Кит.Холст();
	Проба.Добавить(ПолеОперации());
	Проба.Добавить(КудаУйдётПисьмо(АдресПолучателя));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.hub.mail.test.title"),
		Тексты.Текст("settings.hub.mail.test.lead"), Проба.Рендер());
	Секция.Иконка = "конверт";
	Секция.Действие = Адрес;
	Секция.Токен = Токен;
	Секция.Кнопка = Тексты.Текст("settings.hub.mail.test.button");
	Секция.Заблокирована = НЕ ЕстьКуда;
	Возврат Секция;

КонецФункции

// Имя скрытого поля операции.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Значение операции «отправить проверочное письмо».
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеОперации() Экспорт
	Возврат "проба-почты";
КонецФункции

#КонецОбласти

#Область СодержимоеСекции

Функция ПолеОперации()
	Возврат Кит.СкрытоеПоле(ИмяПоляОперации(), ЗначениеОперации());
КонецФункции

// Получателя называет учётка нажавшего, поля «кому» на форме нет — значит адрес обязан
// быть виден до нажатия. Учётка без адреса честно говорит, что слать некуда.
Функция КудаУйдётПисьмо(Знач АдресПолучателя)

	Если НЕ ЗначениеЗаполнено(АдресПолучателя) Тогда
		Возврат Кит.Примечание(Тексты.Текст("settings.hub.mail.test.error.noemail"));
	КонецЕсли;

	Возврат Кит.Примечание(Тексты.Шаблон("settings.hub.mail.test.note", АдресПолучателя));

КонецФункции

#КонецОбласти

&Прозвище("ВитринаПробыПочты")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Тексты = _Тексты;

КонецПроцедуры
