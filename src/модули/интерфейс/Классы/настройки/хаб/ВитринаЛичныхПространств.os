// Окно предупреждения перед выключением настройки «Личные пространства» в разделе «Пулы»
// дома «Хаб».

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — заготовка секции
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секция-окно предупреждения: печатает посчитанные на месте числа и просит повторить
// эхом число удаляемых пространств.
//
// Параметры:
//  Сводка - Структура - Пулов, ПуловСПакетами, Пакетов, Версий.
//  Адрес - Строка - адрес раздела (он же action формы).
//  Токен - Строка - CSRF-токен сессии.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция СекцияПодтверждения(Знач Сводка, Знач Адрес, Знач Токен) Экспорт

	Окно = Кит.Холст();
	Окно.Добавить(ПолеОперации());
	Окно.Добавить(ЧтоИсчезнет(Сводка));
	Окно.Добавить(ПолеЭха(Сводка));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.hub.pools.personal.confirm.title"),
		Тексты.Текст("settings.hub.pools.personal.confirm.lead"), Окно.Рендер());
	Секция.Иконка = "предупреждение";
	Секция.Действие = Адрес;
	Секция.Токен = Токен;
	Секция.Кнопка = Тексты.Текст("settings.hub.pools.personal.confirm.button");
	// «Опасная» красит и саму секцию, и кнопку подтверждения
	Секция.Опасная = Истина;
	// «Отмена» — обычная ссылка на тот же раздел: возврат ничего не меняет
	Секция.АдресОтмены = Адрес;
	Возврат Секция;

КонецФункции

// Имя скрытого поля операции окна предупреждения.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Значение операции «выключить личные пространства».
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеОперации() Экспорт
	Возврат "личные-пространства";
КонецФункции

// Имя поля, в которое человек вводит эхо — число удаляемых пространств.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляЭха() Экспорт
	Возврат "подтверждение";
КонецФункции

#КонецОбласти

#Область СодержимоеОкна

Функция ПолеОперации()
	Возврат Кит.СкрытоеПоле(ИмяПоляОперации(), ЗначениеОперации());
КонецФункции

// Цена выключения числами: сколько пулов, сколько из них с пакетами и что в них лежит.
Функция ЧтоИсчезнет(Знач Сводка)

	Возврат Кит.Примечание(Тексты.Шаблон("settings.hub.pools.personal.confirm.counts",
		ЧислоПулов(Сводка), Тексты.ЧислоТекстом(Сводка.ПуловСПакетами),
		Тексты.ЧислоТекстом(Сводка.Пакетов), Тексты.ЧислоТекстом(Сводка.Версий)));

КонецФункции

// Эхо — то же число пулов: человек повторяет его руками, и случайное нажатие не проходит.
Функция ПолеЭха(Знач Сводка)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Значение, Подсказка",
		ИмяПоляЭха(), Тексты.Текст("settings.hub.pools.personal.confirm.echo.label"), "",
		Тексты.Шаблон("settings.hub.pools.personal.confirm.echo.hint", ЧислоПулов(Сводка))));

КонецФункции

Функция ЧислоПулов(Знач Сводка)
	Возврат Тексты.ЧислоТекстом(Сводка.Пулов);
КонецФункции

#КонецОбласти

&Прозвище("ВитринаЛичныхПространств")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Тексты = _Тексты;

КонецПроцедуры
