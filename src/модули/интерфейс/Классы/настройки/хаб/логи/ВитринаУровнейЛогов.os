// Экран «Логи» дома «Хаб», половина «Уровни»: как действует правка, пути оператора, поиск,
// правка всем под отбором, возврат к старту и под ними секция-форма дерева логов.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Пульт;             // ПультЖурнала (наблюдаемость) — коллектор, уровни, строки для закрепления
Перем Дерево;            // ДеревоЛогов (web-ui) — корень, ветки и логи под отбором
Перем ВитринаДерева;     // ВитринаДереваЛогов (web-ui) — секция-форма дерева
Перем ВитринаВозврата;   // ВитринаВозвратаЛогов (web-ui) — вопрос «Вернуть всё как при старте?»
Перем Черновики;         // ЧерновикДереваЛогов (web-ui) — что из выбранного страница покажет
Перем Форма;             // ФормаДереваЛогов (web-ui) — имена полей и операций, скрытые поля форм
Перем Отборы;            // ОтборЛогов (web-ui) — имена параметров адреса
Перем Дороги;            // НавигацияЛогов (web-ui) — адреса и вкладки экрана
Перем ПодписиПутей;      // ПодписиПутей (web-ui) — путь словами оператора

#Область Экран

// Секции половины «Уровни».
//
// Параметры:
//  Параметры - Структура - Токен (CSRF-токен сессии), Отбор (ОтборЛогов.ОтборУровней),
//              Применённые (Массив из Строка — логи, которые только что изменила правка),
//              Черновик (Структура — ФормаДереваЛогов.Правки: выбранное, но ещё не применённое;
//              Неопределено — черновика нет), ВопросОВозврате (Булево — спросить, вернуть ли всё
//              как при старте), Кто (Строка — логин смотрящего).
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Срез = Дерево.Собрать(ОтборСВеткамиЧерновика(Параметры), Отмеченные(Параметры));
	Черновик = Черновики.Показанный(Параметры.Черновик, Срез);

	Результат = Новый Массив();
	Если Параметры.ВопросОВозврате Тогда
		Результат.Добавить(ВитринаВозврата.Секция(Параметры.Отбор, Параметры.Токен, Параметры.Кто));
	КонецЕсли;
	Результат.Добавить(СекцияОбзора(Срез, Параметры, Черновик));
	Результат.Добавить(ВитринаДерева.Секция(Срез, Новый Структура("Токен, Отбор, Черновик",
		Параметры.Токен, Параметры.Отбор, Черновик.Поля)));
	Возврат Результат;

КонецФункции

// Отбор страницы, где раскрыты и ветки, чей выбор уровня есть в черновике.
Функция ОтборСВеткамиЧерновика(Знач Параметры)
	Раскрытые = Новый Массив();
	Для Каждого Путь Из Параметры.Отбор.Раскрытые Цикл
		Раскрытые.Добавить(Путь);
	КонецЦикла;
	Для Каждого Путь Из Черновики.ВеткиЧерновика(Параметры.Черновик) Цикл
		Раскрытые.Добавить(Путь);
	КонецЦикла;
	Возврат Отборы.ОтборСРаскрытыми(Параметры.Отбор, Раскрытые);
КонецФункции

// Только что применённое и выбранное, но не применённое, — на виду: их ветки раскрыты.
Функция Отмеченные(Знач Параметры)
	Результат = Новый Массив();
	Для Каждого Имя Из Параметры.Применённые Цикл
		Результат.Добавить(Имя);
	КонецЦикла;
	Для Каждого Имя Из Черновики.Отмеченные(Параметры.Черновик) Цикл
		Результат.Добавить(Имя);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СекцияОбзора(Знач Срез, Знач Параметры, Знач Черновик)

	Обзор = Кит.Холст();
	Обзор.Добавить(Дороги.Вкладки("уровни"));
	Обзор.Добавить(КакДействуетПравка());
	Обзор.Добавить(ТолькоЧтоПрименённые(Параметры.Применённые, Параметры.Отбор));
	Обзор.Добавить(НеПрименённое(Черновик, Параметры.Отбор));
	Обзор.Добавить(ПутиОператора(Срез.Пути, Параметры.Отбор));
	Обзор.Добавить(ПоискЛога(Параметры.Отбор));
	Обзор.Добавить(ИтогОтбора(Срез, Параметры));
	Обзор.Добавить(ВозвратКСтарту(Срез, Параметры));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.hub.logs.title"),
		Тексты.Текст("settings.hub.logs.lead"), Обзор.Рендер());
	Секция.Иконка = "инфо";
	Возврат Секция;

КонецФункции

#КонецОбласти

#Область Обзор

// Правка действует сразу и до перезапуска, уходит ли журнал в коллектор и чем закрепить заданное.
Функция КакДействуетПравка()

	Свойства = Кит.Свойства();
	Свойства.Добавить(Свойство(Тексты.Текст("settings.hub.logs.state.term"),
		Тексты.Текст("settings.hub.logs.term.runtime")));
	Свойства.Добавить(Свойство(Тексты.Текст("settings.hub.logs.state.otel"),
		?(Пульт.ЖурналУходитВКоллектор(), Тексты.Текст("settings.hub.logs.otel.on"),
			Тексты.Текст("settings.hub.logs.otel.off"))));
	Закрепить = Пульт.СтрокиДляЗакрепления();
	Если Закрепить.Количество() > 0 Тогда
		Свойства.Добавить(Закрепление(Закрепить));
	КонецЕсли;
	Возврат Свойства;

КонецФункции

Функция Закрепление(Знач Строки)

	Закрепить = Кит.Свойство(Тексты.Текст("settings.hub.logs.state.pin"));
	Закрепить.Добавить(Кит.Примечание(Тексты.Текст("settings.hub.logs.pin.lead")));
	Закрепить.Добавить(Кит.Область().Признак("logs-pin", "")
		.Добавить(Кит.Код(СтрСоединить(Строки, Символы.ПС), "блочный")).Родитель());
	Возврат Закрепить;

КонецФункции

// После «Применить» — ход к строкам тех логов, которые только что тронули.
Функция ТолькоЧтоПрименённые(Знач Имена, Знач Отбор)

	Если Имена.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Адрес = ?(ЗначениеЗаполнено(Отбор.Путь), Дороги.СтрокиПути(Отбор.Путь), Дороги.СтрокиЛогов(Имена));
	Сноска = Кит.Примечание();
	Сноска.Добавить(Кит.Текст(Тексты.Шаблон("settings.hub.logs.applied", ПервыеИмена(Имена)) + " "));
	Сноска.Добавить(Ссылка(Адрес, Тексты.Текст("settings.hub.logs.applied.lines")));
	Возврат Сноска;

КонецФункции

// Число выбранного равно числу пометок «не применено»; чего на странице нет, то названо.
Функция НеПрименённое(Знач Черновик, Знач Отбор)

	Заметки = Кит.Холст();
	Если Черновик.Поля.Количество() > 0 Тогда
		Заметки.Добавить(Кит.Примечание(Тексты.Шаблон("settings.hub.logs.draft.note", Черновик.Поля.Количество())));
	КонецЕсли;
	Если Черновик.Отброшено.Количество() > 0 Тогда
		Заметки.Добавить(Кит.Примечание(Тексты.Шаблон("settings.hub.logs.draft.dropped",
			СтрСоединить(Черновик.Отброшено, ", "))));
	КонецЕсли;
	Если Черновик.НеПоказано.Количество() > 0 Тогда
		Заметки.Добавить(Кит.Примечание(НеПоказанное(Черновик.НеПоказано, Отбор)));
	КонецЕсли;
	Возврат Заметки;

КонецФункции

// Совет «снимите отбор» — только там, где отбор есть: без него выбранное не видно разве что в свёрнутой ветке.
Функция НеПоказанное(Знач Имена, Знач Отбор)
	Если Отбор.Активен Тогда
		Возврат Тексты.Шаблон("settings.hub.logs.draft.hidden", СтрСоединить(Имена, ", "));
	КонецЕсли;
	Возврат Тексты.Шаблон("settings.hub.logs.draft.hidden.plain", СтрСоединить(Имена, ", "));
КонецФункции

// Путь называет отказ словами оператора; выбранный сужает дерево, повторный щелчок снимает отбор.
Функция ПутиОператора(Знач Пути, Знач Отбор)

	Если Пути.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Ряд = Кит.Ряд("выбор");
	Ряд.Добавить(Надпись("пояснение", Тексты.Текст("settings.hub.logs.paths.label")));
	Для Каждого Путь Из Пути Цикл
		Ряд.Добавить(ПилюляПути(Путь.Ключ, Путь.Ключ = Отбор.Путь));
	КонецЦикла;
	Возврат Ряд;

КонецФункции

Функция ПилюляПути(Знач Ключ, Знач Выбран)

	Адрес = ?(Выбран, Дороги.Уровни(), Дороги.УровниСОтбором(Отборы.ПараметрыУровней(
		Отборы.ОтборУровней("", "", Ключ))));
	Возврат Кит.Ссылка(Адрес, ?(Выбран, "пилюля-текущая", "пилюля"))
		.Добавить(Кит.Текст(ПодписиПутей.Подпись(Ключ))).Родитель();

КонецФункции

// GET-форма: отбор живёт в адресе, страница работает без скрипта.
Функция ПоискЛога(Знач Отбор)

	Поля = Новый Массив();
	Поля.Добавить(Новый Структура("Имя, Метка, Значение, Плейсхолдер", Отборы.ИмяПоиска(),
		Тексты.Текст("settings.hub.logs.search.label"), Отбор.Запрос,
		Тексты.Текст("settings.hub.logs.search.placeholder")));
	Поля.Добавить(Новый Структура("Имя, Метка, Тип, Значение, Варианты", Отборы.ИмяТолькоИзменённых(),
		Тексты.Текст("settings.hub.logs.search.scope"), "выбор",
		?(Отбор.ТолькоИзменённые, Отборы.ЗначениеТолькоИзменённых(), ""), ВариантыОхвата()));
	Скрытые = Новый Массив();
	Если ЗначениеЗаполнено(Отбор.Путь) Тогда
		Скрытые.Добавить(Новый Структура("Имя, Значение", Отборы.ИмяПути(), Отбор.Путь));
	КонецЕсли;

	Возврат Кит.Область().Признак("logs-filters", "")
		.Добавить(Кит.СтрокаПоиска(Новый Структура("Действие, Поля, СкрытыеПоля, Кнопка, Иконка",
			Дороги.Уровни(), Поля, Скрытые, Тексты.Текст("settings.hub.logs.search.button"), "поиск"))).Родитель();

КонецФункции

Функция ВариантыОхвата()

	Результат = Новый Массив();
	Результат.Добавить(Вариант("", Тексты.Текст("settings.hub.logs.search.scope.all")));
	Результат.Добавить(Вариант(Отборы.ЗначениеТолькоИзменённых(),
		Тексты.Текст("settings.hub.logs.search.scope.changed")));
	Возврат Результат;

КонецФункции

// Под отбором — сколько нашлось и один уровень всем найденным: путь проходит несколько веток.
Функция ИтогОтбора(Знач Срез, Знач Параметры)

	Если НЕ Параметры.Отбор.Активен Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Итог = Кит.Ряд("признаки").Признак("logs-inline", "");
	Итог.Добавить(СколькоНайдено(Срез.Найдено));
	Если Срез.ИменаНайденных.Количество() > 0 Тогда
		Итог.Добавить(ВсемПодОтбором(Срез, Параметры));
	КонецЕсли;
	Возврат Итог;

КонецФункции

Функция СколькоНайдено(Знач Найдено)

	Сноска = Кит.Надпись();
	Сноска.Добавить(Кит.Текст(Тексты.Шаблон("settings.hub.logs.found", Найдено) + " "));
	Сноска.Добавить(Ссылка(Дороги.Уровни(), Тексты.Текст("settings.hub.logs.found.reset")));
	Возврат Сноска;

КонецФункции

// Отбор ставят, чтобы поднять отладку: DEBUG первым, «как при старте» последним — нажатие наугад не откатывает.
Функция ВсемПодОтбором(Знач Срез, Знач Параметры)

	Правка = Кит.Форма(Дороги.Уровни(), Параметры.Токен, "строкой").Признак("logs-inline", "");
	Правка.Добавить(Форма.ОперацияИОтбор(Форма.ОперацияНайденным(), Параметры.Отбор));
	Правка.Добавить(Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Варианты",
		Форма.ИмяУровняНайденным(), Тексты.Текст("settings.hub.logs.found.level"), "выбор", "DEBUG",
		ВариантыВсемПодОтбором(Срез.Уровни))));
	Правка.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Тексты.Шаблон("settings.hub.logs.found.apply", Срез.ИменаНайденных.Количество()), "основная", "малый")));
	Возврат Правка;

КонецФункции

Функция ВариантыВсемПодОтбором(Знач Уровни)

	Результат = Новый Массив();
	Для Каждого Уровень Из Уровни Цикл
		Результат.Добавить(Вариант(Уровень, Уровень));
	КонецЦикла;
	Результат.Добавить(Вариант(Форма.ВариантСтарта(), Тексты.Текст("settings.hub.logs.level.back")));
	Возврат Результат;

КонецФункции

// «Вернуть всё» после разбора отказа; что снимется и кем задано, сервер покажет отдельным шагом.
Функция ВозвратКСтарту(Знач Срез, Знач Параметры)

	Если Срез.СЭкрана = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Сноска = Кит.Надпись();
	Сноска.Добавить(Кит.Текст(Тексты.Шаблон("settings.hub.logs.back.note", Срез.СЭкрана) + " "));
	Сноска.Добавить(Ссылка(Дороги.УровниСОтбором(Отборы.ПараметрыУровней(
		Отборы.ОтборУровней("", Отборы.ЗначениеТолькоИзменённых()))),
		Тексты.Текст("settings.hub.logs.back.show")));

	Возврат Кит.Ряд("признаки").Признак("logs-inline", "")
		.Добавить(Сноска).Родитель()
		.Добавить(ФормаВозврата(Параметры)).Родитель();

КонецФункции

Функция ФормаВозврата(Знач Параметры)

	Возврат Кит.Форма(Дороги.Уровни(), Параметры.Токен, "строкой")
		.Добавить(Форма.ОперацияИОтбор(Форма.ОперацияВозврата(), Параметры.Отбор)).Родитель()
		.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер, Иконка",
			Тексты.Текст("settings.hub.logs.back.button"), "вторичная", "малый", "история"))).Родитель();

КонецФункции

#КонецОбласти

#Область Сборщики

// Длинный список имён на экране обрезается: полный — в адресе строк по ссылке рядом.
Функция ПервыеИмена(Знач Имена)

	Показ = 5;
	Если Имена.Количество() <= Показ Тогда
		Возврат СтрСоединить(Имена, ", ");
	КонецЕсли;

	Первые = Новый Массив();
	Для Номер = 0 По Показ - 1 Цикл
		Первые.Добавить(Имена[Номер]);
	КонецЦикла;
	Возврат Тексты.Шаблон("settings.hub.logs.applied.more", СтрСоединить(Первые, ", "),
		Имена.Количество() - Показ);

КонецФункции

Функция Свойство(Знач Имя, Знач Текст)
	Возврат Кит.Свойство(Имя).Добавить(Кит.Текст(Текст)).Родитель();
КонецФункции

Функция Надпись(Знач Вид, Знач Текст)
	Возврат Кит.Надпись(Вид).Добавить(Кит.Текст(Текст)).Родитель();
КонецФункции

Функция Вариант(Знач Значение, Знач Подпись)
	Возврат Новый Структура("Значение, Подпись", Значение, Подпись);
КонецФункции

Функция Ссылка(Знач Адрес, Знач Текст)
	Возврат Кит.Ссылка(Адрес).Добавить(Кит.Текст(Текст)).Родитель();
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПультЖурнала") _Пульт,
	&Пластилин(Значение = "ДеревоЛогов") _Дерево,
	&Пластилин(Значение = "ВитринаДереваЛогов") _ВитринаДерева,
	&Пластилин(Значение = "ВитринаВозвратаЛогов") _ВитринаВозврата,
	&Пластилин(Значение = "ЧерновикДереваЛогов") _Черновики,
	&Пластилин(Значение = "ФормаДереваЛогов") _Форма,
	&Пластилин(Значение = "ОтборЛогов") _Отборы,
	&Пластилин(Значение = "НавигацияЛогов") _Дороги,
	&Пластилин(Значение = "ПодписиПутей") _ПодписиПутей) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Тексты = _Тексты;
	Пульт = _Пульт;
	Дерево = _Дерево;
	ВитринаДерева = _ВитринаДерева;
	ВитринаВозврата = _ВитринаВозврата;
	Черновики = _Черновики;
	Форма = _Форма;
	Отборы = _Отборы;
	Дороги = _Дороги;
	ПодписиПутей = _ПодписиПутей;

