// Дерево логов экрана: корень, ветки по сегментам пути группы и логи, суженные отбором,
// с итогами свёрнутой ветки. Разметки здесь нет.

Перем Пульт;  // ПультЖурнала (наблюдаемость) — логи, корень, уровни и пути

#Область ПубличныйИнтерфейс

// Собирает дерево под отбор.
//
// Параметры:
//  Отбор - Структура - результат ОтборЛогов.ОтборУровней.
//  Отмеченные - Массив из Строка - логи, которые должны быть видны: только что применённые
//               и выбранные, но ещё не применённые (необязательный, по умолчанию пустой).
//
// Возвращаемое значение:
//  Структура - Корень (узел пульта), Ярусы (Массив из Структура — верхние ветки, см.
//              НоваяВетка), Всего (Число — логов у пульта), Найдено (Число — логов под
//              отбором), ИменаНайденных (Массив из Строка — правимые логи под отбором),
//              ПропущенныеНайденные (Массив из Строка — логи под отбором, которые с экрана
//              не правятся), СЭкрана (Число — корень и логи, у которых что-то задано
//              с экрана), Уровни (Массив из Строка), Пути (см. ПультЖурнала.Пути), ПутьИзвестен
//              (Булево — выбранный путь есть у пульта либо путь не выбран), ВеткиПоПути
//              (Соответствие: путь группы -> ветка), ВеткиЛогов (Соответствие: имя лога ->
//              путь его ветки), УзлыПоИмени (Соответствие: имя лога -> узел пульта),
//              Открытые (Массив из Строка — пути самых глубоких раскрытых веток: отбор с ними
//              раскрывает дерево так же, как сейчас).
//
Функция Собрать(Знач Отбор, Знач Отмеченные = Неопределено) Экспорт

	Корень = Пульт.Корень();
	Пути = Пульт.Пути();
	НаПути = ИменаПути(Пути, Отбор.Путь);
	Видимые = Множество(Отмеченные);
	Подстрока = НРег(Отбор.Запрос);

	Срез = Новый Структура();
	Срез.Вставить("Корень", Корень);
	Срез.Вставить("Ярусы", Новый Массив());
	Срез.Вставить("Всего", 0);
	Срез.Вставить("Найдено", 0);
	Срез.Вставить("ИменаНайденных", Новый Массив());
	Срез.Вставить("ПропущенныеНайденные", Новый Массив());
	Срез.Вставить("СЭкрана", ?(ЗаданСЭкрана(Корень), 1, 0));
	Срез.Вставить("Уровни", Пульт.Уровни());
	Срез.Вставить("Пути", Пути);
	Срез.Вставить("ПутьИзвестен", НЕ ЗначениеЗаполнено(Отбор.Путь) ИЛИ НаПути <> Неопределено);
	Срез.Вставить("ВеткиПоПути", Новый Соответствие());
	Срез.Вставить("ВеткиЛогов", Новый Соответствие());
	Срез.Вставить("УзлыПоИмени", Новый Соответствие());
	Срез.Вставить("Открытые", Новый Массив());

	Для Каждого Узел Из Пульт.Логи() Цикл

		Цепочка = ЦепочкаВеток(Срез, Узел.Группа);
		ПодОтбором = Подходит(Узел, Подстрока, Отбор.ТолькоИзменённые)
			И (НЕ ЗначениеЗаполнено(Отбор.Путь) ИЛИ НаПути <> Неопределено И НаПути.Получить(Узел.Имя) <> Неопределено);
		Виден = Видимые.Получить(Узел.Имя) <> Неопределено;

		Для Каждого Ветка Из Цепочка Цикл
			Учесть(Ветка, Узел, ПодОтбором, Виден);
		КонецЦикла;
		Срез.Всего = Срез.Всего + 1;
		Срез.СЭкрана = Срез.СЭкрана + ?(ЗаданСЭкрана(Узел), 1, 0);
		Срез.ВеткиЛогов.Вставить(Узел.Имя, Цепочка[Цепочка.ВГраница()].Путь);
		Срез.УзлыПоИмени.Вставить(Узел.Имя, Узел);

		Если ПодОтбором Тогда
			Цепочка[Цепочка.ВГраница()].Логи.Добавить(Узел);
			Срез.Найдено = Срез.Найдено + 1;
			Если Узел.ТолькоЧтение Тогда
				Срез.ПропущенныеНайденные.Добавить(Узел.Имя);
			Иначе
				Срез.ИменаНайденных.Добавить(Узел.Имя);
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Раскрытые = Множество(Отбор.Раскрытые);
	Для Каждого Ярус Из Срез.Ярусы Цикл
		Упорядочить(Ярус, Отбор.Активен, Раскрытые, Ложь, Срез.Открытые);
	КонецЦикла;
	Срез.Ярусы = ЯрусыПоПорядку(Срез.Ярусы);

	Возврат Срез;

КонецФункции

// Ветка дерева по пути группы.
//
// Параметры:
//  Срез - Структура - результат Собрать.
//  Путь - Строка - путь группы ветки.
//
// Возвращаемое значение:
//  Структура, Неопределено - ветка (см. Собрать); Неопределено — такой ветки нет.
//
Функция ВеткаПоПути(Знач Срез, Знач Путь) Экспорт
	Возврат Срез.ВеткиПоПути.Получить(Путь);
КонецФункции

// Путь ветки, где живёт лог.
//
// Параметры:
//  Срез - Структура - результат Собрать.
//  ИмяЛога - Строка - имя лога.
//
// Возвращаемое значение:
//  Строка - путь группы ветки; "" — такого лога в дереве нет.
//
Функция ВеткаЛога(Знач Срез, Знач ИмяЛога) Экспорт
	Путь = Срез.ВеткиЛогов.Получить(ИмяЛога);
	Возврат ?(Путь = Неопределено, "", Путь);
КонецФункции

// Напечатана ли строка лога на странице: лог под отбором, и его ветка раскрыта либо это ярус.
//
// Параметры:
//  Срез - Структура - результат Собрать.
//  ИмяЛога - Строка - имя лога.
//
// Возвращаемое значение:
//  Булево
//
Функция ЛогНаСтранице(Знач Срез, Знач ИмяЛога) Экспорт

	Ветка = ВеткаПоПути(Срез, ВеткаЛога(Срез, ИмяЛога));
	Если Ветка = Неопределено ИЛИ НЕ ЛогиВеткиНаСтранице(Ветка) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Узел Из Ветка.Логи Цикл
		Если Узел.Имя = ИмяЛога Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Напечатан ли выбор уровня ветки по пути: см. ВыборВеткиНаСтранице.
//
// Параметры:
//  Срез - Структура - результат Собрать.
//  Путь - Строка - путь группы ветки.
//
// Возвращаемое значение:
//  Булево
//
Функция ВеткаНаСтранице(Знач Срез, Знач Путь) Экспорт
	Ветка = ВеткаПоПути(Срез, Путь);
	Возврат Ветка <> Неопределено И ВыборВеткиНаСтранице(Ветка);
КонецФункции

// Печатает ли страница логи ветки под отбором: ярус — всегда, ветка — только раскрытая.
// Этим правилом печатает дерево и им же черновик считает, что из выбранного видно.
//
// Параметры:
//  Ветка - Структура - ветка среза (см. Собрать).
//
// Возвращаемое значение:
//  Булево
//
Функция ЛогиВеткиНаСтранице(Знач Ветка) Экспорт
	Возврат Ветка.Открыта ИЛИ СтрНайти(Ветка.Путь, "/") = 0;
КонецФункции

// Печатает ли страница выбор уровня ветки: у раскрытой ветки, не у яруса, и только когда
// под отбором в ветке есть правимые логи.
//
// Параметры:
//  Ветка - Структура - ветка среза (см. Собрать).
//
// Возвращаемое значение:
//  Булево
//
Функция ВыборВеткиНаСтранице(Знач Ветка) Экспорт
	Возврат Ветка.Открыта И ВыборВеткиРаскрытой(Ветка);
КонецФункции

// Напечатает ли страница выбор уровня ветки, когда ветку раскроют: свёрнутая ветка знает это
// заранее, и кнопка раскрытия ведёт к её выбору, если он будет.
//
// Параметры:
//  Ветка - Структура - ветка среза (см. Собрать).
//
// Возвращаемое значение:
//  Булево
//
Функция ВыборВеткиРаскрытой(Знач Ветка) Экспорт
	Возврат СтрНайти(Ветка.Путь, "/") > 0 И Ветка.ИменаПравимых.Количество() > 0;
КонецФункции

// Корень и логи, у которых что-то задано с экрана, — то, что снимет «Вернуть всё».
//
// Возвращаемое значение:
//  Массив из Структура - узлы пульта, корень первым.
//
Функция ЗаданныеСЭкрана() Экспорт

	Результат = Новый Массив();
	Корень = Пульт.Корень();
	Если ЗаданСЭкрана(Корень) Тогда
		Результат.Добавить(Корень);
	КонецЕсли;
	Для Каждого Узел Из Пульт.Логи() Цикл
		Если ЗаданСЭкрана(Узел) Тогда
			Результат.Добавить(Узел);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пути всех веток — и модуля целиком, и его раздела — по алфавиту.
//
// Параметры:
//  Логи - Массив из Структура - узлы пульта.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ПутиВеток(Знач Логи) Экспорт

	Пути = Новый СписокЗначений();
	Для Каждого Узел Из Логи Цикл
		Путь = "";
		Для Каждого Сегмент Из СегментыГруппы(Узел.Группа) Цикл
			Путь = ?(ЗначениеЗаполнено(Путь), Путь + "/", "") + Сегмент;
			Если Пути.НайтиПоЗначению(Путь) = Неопределено Тогда
				Пути.Добавить(Путь);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Пути.СортироватьПоЗначению();
	Возврат Пути.ВыгрузитьЗначения();

КонецФункции

// Имена, которые есть у пульта: адрес не пропускает на экран имён, которых нет.
//
// Параметры:
//  Имена - Массив из Строка - имена логов.
//
// Возвращаемое значение:
//  Массив из Строка - известные пульту, в том же порядке.
//
Функция Известные(Знач Имена) Экспорт

	Результат = Новый Массив();
	Если Имена.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Все = Новый Соответствие();
	Для Каждого Узел Из Пульт.Логи() Цикл
		Все.Вставить(Узел.Имя, Истина);
	КонецЦикла;
	Для Каждого Имя Из Имена Цикл
		Если Все.Получить(Имя) <> Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Задано ли у лога либо корня что-то с экрана: уровень или отправка в коллектор.
//
// Параметры:
//  Узел - Структура - узел пульта: описание одного лога.
//
// Возвращаемое значение:
//  Булево
//
Функция ЗаданСЭкрана(Знач Узел) Экспорт
	Возврат Узел.УровеньСЭкрана <> Неопределено ИЛИ Узел.OTelСЭкрана = Истина;
КонецФункции

// Имя яруса логов, которым пульт не назвал группы.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяБезГруппы() Экспорт
	Возврат "?";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ветки от верхней до той, где живёт лог: итоги копятся на каждой из них.
Функция ЦепочкаВеток(Знач Срез, Знач Группа)

	Цепочка = Новый Массив();
	Путь = "";
	Родитель = Неопределено;
	Для Каждого Сегмент Из СегментыГруппы(Группа) Цикл
		Путь = ?(ЗначениеЗаполнено(Путь), Путь + "/", "") + Сегмент;
		Ветка = Срез.ВеткиПоПути.Получить(Путь);
		Если Ветка = Неопределено Тогда
			Ветка = НоваяВетка(Путь, Сегмент);
			Срез.ВеткиПоПути.Вставить(Путь, Ветка);
			Если Родитель = Неопределено Тогда
				Срез.Ярусы.Добавить(Ветка);
			Иначе
				Родитель.Ветки.Добавить(Ветка);
			КонецЕсли;
		КонецЕсли;
		Цепочка.Добавить(Ветка);
		Родитель = Ветка;
	КонецЦикла;

	Возврат Цепочка;

КонецФункции

Функция СегментыГруппы(Знач Группа)
	Сегменты = СтрРазделить(Группа, "/", Ложь);
	Если Сегменты.Количество() = 0 Тогда
		Сегменты.Добавить(ИмяБезГруппы());
	КонецЕсли;
	Возврат Сегменты;
КонецФункции

// Итоги ветки считаются по всем её логам, найденное — только по логам под отбором.
Функция НоваяВетка(Знач Путь, Знач Имя)

	Ветка = Новый Структура();
	Ветка.Вставить("Путь", Путь);
	Ветка.Вставить("Имя", Имя);
	Ветка.Вставить("Ветки", Новый Массив());
	Ветка.Вставить("Логи", Новый Массив());
	Ветка.Вставить("Всего", 0);
	Ветка.Вставить("Подробных", 0);
	Ветка.Вставить("СЭкрана", 0);
	Ветка.Вставить("НеВOTel", 0);
	Ветка.Вставить("СтрокЗаМинуту", 0);
	Ветка.Вставить("Найдено", 0);
	Ветка.Вставить("ИменаПравимых", Новый Массив());
	Ветка.Вставить("ТолькоЧтения", Новый Массив());
	Ветка.Вставить("Видимых", 0);
	Ветка.Вставить("Открыта", Ложь);
	Возврат Ветка;

КонецФункции

Процедура Учесть(Ветка, Знач Узел, Знач ПодОтбором, Знач Виден)

	Ветка.Всего = Ветка.Всего + 1;
	Ветка.Подробных = Ветка.Подробных + ?(Узел.УровеньДействующий = "DEBUG", 1, 0);
	Ветка.СЭкрана = Ветка.СЭкрана + ?(ЗаданСЭкрана(Узел), 1, 0);
	Ветка.НеВOTel = Ветка.НеВOTel + ?(Узел.ВOTel, 0, 1);
	Ветка.СтрокЗаМинуту = Ветка.СтрокЗаМинуту + Узел.СтрокЗаМинуту;
	Ветка.Видимых = Ветка.Видимых + ?(Виден, 1, 0);

	Если НЕ ПодОтбором Тогда
		Возврат;
	КонецЕсли;
	Ветка.Найдено = Ветка.Найдено + 1;
	Если Узел.ТолькоЧтение Тогда
		Ветка.ТолькоЧтения.Добавить(Узел.Имя);
	Иначе
		Ветка.ИменаПравимых.Добавить(Узел.Имя);
	КонецЕсли;

КонецПроцедуры

// Раскрыта ветка с находками отбора, заданным с экрана, отмеченным, раскрытая человеком либо над такой.
Процедура Упорядочить(Ветка, Знач ОтборАктивен, Знач Раскрытые, Знач РаскрытаВыше, Открытые)

	Ветка.Логи = ПоИмени(Ветка.Логи);
	Ветка.Ветки = ПоИмени(Ветка.Ветки);

	Раскрыта = РаскрытаВыше ИЛИ Раскрытые.Получить(Ветка.Путь) <> Неопределено;
	// раскрытая ветка без своих логов показывает вложенные раскрытыми, со своими — свёрнутыми
	РаскрытьВложенные = Раскрыта И Ветка.Логи.Количество() = 0;
	ОткрытаНиже = Ложь;
	Для Каждого Вложенная Из Ветка.Ветки Цикл
		Упорядочить(Вложенная, ОтборАктивен, Раскрытые, РаскрытьВложенные, Открытые);
		ОткрытаНиже = ОткрытаНиже ИЛИ Вложенная.Открыта;
	КонецЦикла;

	Ветка.Открыта = Ветка.Найдено > 0 И (ОтборАктивен ИЛИ Ветка.СЭкрана > 0 ИЛИ Ветка.Видимых > 0
		ИЛИ Раскрыта ИЛИ ОткрытаНиже);
	// предков раскрывают вложенные, поэтому в адрес идут только самые глубокие раскрытые
	Если Ветка.Открыта И НЕ ОткрытаНиже Тогда
		Открытые.Добавить(Ветка.Путь);
	КонецЕсли;

КонецПроцедуры

Функция ПоИмени(Знач Элементы)

	Список = Новый СписокЗначений();
	Для Каждого Элемент Из Элементы Цикл
		Список.Добавить(Элемент, НРег(Элемент.Имя));
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	Возврат Список.ВыгрузитьЗначения();

КонецФункции

// Сначала модули хаба, за ними библиотеки, потом всё прочее по алфавиту.
Функция ЯрусыПоПорядку(Знач Ярусы)

	Список = Новый СписокЗначений();
	Для Каждого Ярус Из Ярусы Цикл
		Место = ?(Ярус.Имя = "хаб", "0", ?(Ярус.Имя = "библиотеки", "1", "2"));
		Список.Добавить(Ярус, Место + НРег(Ярус.Имя));
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	Возврат Список.ВыгрузитьЗначения();

КонецФункции

// Неопределено — такого пути у пульта нет.
Функция ИменаПути(Знач Пути, Знач Ключ)

	Для Каждого Путь Из Пути Цикл
		Если Путь.Ключ = Ключ Тогда
			Возврат Множество(Путь.Логи);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Подстрока ищется и в имени лога, и в пути группы: «прокси» находит всю ветку.
Функция Подходит(Знач Узел, Знач Подстрока, Знач ТолькоИзменённые)

	Если ТолькоИзменённые И НЕ ЗаданСЭкрана(Узел) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Подстрока) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат СтрНайти(НРег(Узел.Имя), Подстрока) > 0 ИЛИ СтрНайти(НРег(Узел.Группа), Подстрока) > 0;

КонецФункции

Функция Множество(Знач Имена)

	Результат = Новый Соответствие();
	Если Имена = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Имя Из Имена Цикл
		Результат.Вставить(Имя, Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ПультЖурнала") _Пульт) Экспорт
	Пульт = _Пульт;
КонецПроцедуры
