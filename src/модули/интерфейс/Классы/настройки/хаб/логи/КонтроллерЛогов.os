// Логи хаба — контроллер раздела «Логи» дома «Хаб»: половина «Уровни» (GET и правка POST)
// и половина «Строки» (GET). Отбор обеих живёт в адресе; разметку строят витрины.

Перем ГвардХаб;        // ГвардХабАдмина (кабинет)
Перем Ответы;          // ОтветыНастроек (web-ui)
Перем Гейт;            // ГейтФормы (web-ui) — токен формы
Перем РазборФормы;     // РазборФормы (web-ui)
Перем Защита;          // ЗащитаCSRF (вход) — токен сессии в форму
Перем Дом;             // ДомХаба (web-ui)
Перем Дороги;          // НавигацияЛогов (web-ui)
Перем Отборы;          // ОтборЛогов (web-ui)
Перем Форма;           // ФормаДереваЛогов (web-ui)
Перем Дерево;          // ДеревоЛогов (web-ui) — какие имена из адреса пульт знает
Перем Правка;          // ПравкаЛогов (web-ui) — выбранное на экране в вызовы пульта
Перем ВитринаУровней;  // ВитринаУровнейЛогов (web-ui) — половина «Уровни»
Перем ВитринаСтрок;    // ВитринаСтрокЛогов (web-ui) — половина «Строки»
Перем Тексты;          // ТекстыИнтерфейса (кит)

#Область ТочкиМаршрута

// Точка маршрута «logs» (GET, POST): половина «Уровни» — дерево логов и правка уровней.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента, попадает в журнал аудита правки.
//  q - Строка - подстрока имени лога либо ветки (необязательный, по умолчанию "").
//  only - Строка - "changed" показывает только заданное с экрана (необязательный, по умолчанию "").
//  path - Строка - ключ пути, до логов которого сужено дерево (необязательный, по умолчанию "").
//  open - Строка - пути раскрытых веток через запятую (необязательный, по умолчанию "").
//  saved - Строка - логи, которые изменила последняя правка, через запятую (необязательный,
//          по умолчанию "").
//  kept - Строка - логи, которые правка пропустила, через запятую (необязательный,
//         по умолчанию "").
//  done - Строка - сколько логов изменила последняя правка (необязательный, по умолчанию "").
//  back - Строка - сколько логов последняя правка вернула к старту (необязательный,
//         по умолчанию "").
//
&ТочкаМаршрута("logs")
Процедура Уровни(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, АдресУдаленногоУзла,
	q = "", only = "", path = "", open = "", saved = "", kept = "", done = "", back = "") Экспорт

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьУровни(Ответ, Вердикт, КукиЗапроса, Отборы.ОтборУровней(q, only, path, open),
			ИсходИзАдреса(saved, kept, done, back));
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Присланное = Гейт.СПринятымТокеном(Ответ, Вердикт, РазборФормы.Разобрать(ТелоЗапроса),
		КукиЗапроса);
	Если Присланное = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Отбор = ОтборФормы(Присланное);
	Операция = РазборФормы.Поле(Присланное, Форма.ИмяОперации());
	Раскрыть = РазборФормы.Поле(Присланное, Форма.ИмяРаскрытия());

	// раскрытие ветки и вопрос о возврате ничего не применяют: страница отдаётся сразу, выбранное в адрес не попадает
	Если Операция = Форма.ОперацияДерева() И ЗначениеЗаполнено(Раскрыть) Тогда
		ОтдатьУровни(Ответ, Вердикт, КукиЗапроса, Отборы.ОтборСВеткой(Отбор, Раскрыть),
			ИсходРаскрытия(Форма.Правки(Присланное)));
		Возврат;
	ИначеЕсли Операция = Форма.ОперацияВозврата() Тогда
		ОтдатьУровни(Ответ, Вердикт, КукиЗапроса, Отбор, ИсходВопроса());
		Возврат;
	КонецЕсли;

	Итог = ИтогПравки(Операция, Присланное, Отбор,
		Правка.АвторПравки(Вердикт.Пользователь.Логин, АдресУдаленногоУзла));
	Если Итог = Неопределено Тогда
		ОтдатьУровни(Ответ, Вердикт, КукиЗапроса, Отбор,
			Отказ(Тексты.Текст("settings.hub.logs.reply.unknown")), 400);
		Возврат;
	ИначеЕсли ЗначениеЗаполнено(Итог.Отказ) Тогда
		ОтдатьУровни(Ответ, Вердикт, КукиЗапроса, Отбор, ИсходПравки(Итог), 400);
		Возврат;
	КонецЕсли;

	// перезагрузка страницы после перенаправления правку не повторяет
	Если Операция = Форма.ОперацияВозвратаЛогов() Тогда
		Ответ.Перенаправить(СтрокиПослеВозврата(ИменаВозврата(Присланное), Итог));
	ИначеЕсли Операция = Форма.ОперацияПодтверждённогоВозврата() Тогда
		Ответ.Перенаправить(УровниПослеВозврата(Отбор, Итог));
	Иначе
		Ответ.Перенаправить(УровниПослеПравки(Отбор, Итог));
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «logs/lines» (GET): половина «Строки» — последние строки журнала.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  log - Строка - имена логов через запятую (необязательный, по умолчанию "").
//  branch - Строка - начало пути группы (необязательный, по умолчанию "").
//  level - Строка - уровень, ниже которого строки не показываются (необязательный, по умолчанию "").
//  text - Строка - подстрока текста строки (необязательный, по умолчанию "").
//  path - Строка - ключ пути, до логов которого сужены строки (необязательный, по умолчанию "").
//  ring - Строка - "important" читает память важного (необязательный, по умолчанию "").
//  back - Строка - сколько логов только что вернули к старту (необязательный, по умолчанию "").
//
&ТочкаМаршрута("logs/lines")
Процедура Строки(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	log = "", branch = "", level = "", text = "", path = "", ring = "", back = "") Экспорт

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Отбор = Отборы.ОтборСтрок(log, branch, level, text, path, ring);
	Модель = Ответы.МодельДома(Дом, "", Дом.Разделы(Дороги.КлючРаздела()),
		Уведомления(ИсходИзАдреса("", "", "", back)),
		ВитринаСтрок.Секции(Отбор, Защита.ТокенСессии(Вердикт.Сессия)));

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт.Пользователь, КукиЗапроса,
		Дом.ПодписьРаздела(Дороги.КлючРаздела()));

КонецПроцедуры

#КонецОбласти

#Область Правка

// Итог операции правки; Неопределено — такой операции экран не знает.
Функция ИтогПравки(Знач Операция, Знач Присланное, Знач Отбор, Знач Автор)

	Если Операция = Форма.ОперацияДерева() Тогда
		Возврат Правка.ПрименитьДерево(Присланное, Отбор, Автор);
	ИначеЕсли Операция = Форма.ОперацияНайденным() Тогда
		Возврат Правка.ЗадатьНайденным(РазборФормы.Поле(Присланное, Форма.ИмяУровняНайденным()),
			Отбор, Автор);
	ИначеЕсли Операция = Форма.ОперацияПодтверждённогоВозврата()
		ИЛИ Операция = Форма.ОперацияВозвратаЛогов() Тогда
		Возврат Правка.ВернутьЛоги(ИменаВозврата(Присланное), Автор);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ОтборФормы(Знач Присланное)
	Возврат Отборы.ОтборУровней(РазборФормы.Поле(Присланное, Отборы.ИмяПоиска()),
		РазборФормы.Поле(Присланное, Отборы.ИмяТолькоИзменённых()),
		РазборФормы.Поле(Присланное, Отборы.ИмяПути()),
		РазборФормы.Поле(Присланное, Отборы.ИмяРаскрытых()));
КонецФункции

Функция ИменаВозврата(Знач Присланное)
	Возврат Отборы.Имена(РазборФормы.Поле(Присланное, Форма.ИмяЛогов()));
КонецФункции

#КонецОбласти

#Область Исход

// Исход последней правки из адреса: числа — только числа, имена — только известные пульту.
Функция ИсходИзАдреса(Знач Применённые, Знач Пропущенные, Знач Изменено, Знач Возвращено)

	Исход = НовыйИсход();
	Исход.Применённые = Дерево.Известные(Отборы.Имена(Применённые));
	Исход.Пропущенные = Дерево.Известные(Отборы.Имена(Пропущенные));
	Исход.Изменено = Отборы.ЧислоИзАдреса(Изменено);
	Исход.Возвращено = Отборы.ЧислоИзАдреса(Возвращено);
	Возврат Исход;

КонецФункции

// Исход правки, которую пульт прервал отказом: страница рисуется сразу, без перенаправления.
Функция ИсходПравки(Знач Итог)

	Исход = НовыйИсход();
	Исход.Применённые = Итог.Логи;
	Исход.Пропущенные = Итог.Пропущены;
	Исход.Изменено = ?(Итог.Логи.Количество() > 0, Итог.Логи.Количество(), Неопределено);
	Исход.Отказ = Итог.Отказ;
	Возврат Исход;

КонецФункции

Функция ИсходРаскрытия(Знач Выбранное)
	Исход = НовыйИсход();
	Исход.Черновик = Выбранное;
	Возврат Исход;
КонецФункции

Функция ИсходВопроса()
	Исход = НовыйИсход();
	Исход.ВопросОВозврате = Истина;
	Возврат Исход;
КонецФункции

Функция Отказ(Знач Текст)
	Исход = НовыйИсход();
	Исход.Отказ = Текст;
	Возврат Исход;
КонецФункции

Функция НовыйИсход()
	Возврат Новый Структура("Применённые, Пропущенные, Изменено, Возвращено, Отказ, Черновик, ВопросОВозврате",
		Новый Массив(), Новый Массив(), Неопределено, Неопределено, "", Неопределено, Ложь);
КонецФункции

Функция УровниПослеПравки(Знач Отбор, Знач Итог)

	Пары = Отборы.ПараметрыУровней(Отбор);
	Пары.Добавить(Отборы.Пара(Отборы.ИмяПрименённых(), СтрСоединить(Итог.Логи, ",")));
	Пары.Добавить(Отборы.Пара(Отборы.ИмяПропущенных(), СтрСоединить(Итог.Пропущены, ",")));
	Пары.Добавить(Отборы.Пара(Отборы.ИмяЧислаПравок(), ЧислоСтрокой(Итог.Логи.Количество())));
	Возврат Дороги.УровниУВетки(Пары, Итог.Ветка);

КонецФункции

// Вернули ничего — «ничего не изменилось», а не «вернули 0».
Функция УровниПослеВозврата(Знач Отбор, Знач Итог)

	Пары = Отборы.ПараметрыУровней(Отбор);
	Если Итог.Логи.Количество() > 0 Тогда
		Пары.Добавить(Отборы.Пара(Отборы.ИмяЧислаВозвращённых(), ЧислоСтрокой(Итог.Логи.Количество())));
	Иначе
		Пары.Добавить(Отборы.Пара(Отборы.ИмяЧислаПравок(), "0"));
	КонецЕсли;
	Возврат Дороги.УровниСОтбором(Пары);

КонецФункции

Функция СтрокиПослеВозврата(Знач Имена, Знач Итог)

	Пары = Новый Массив();
	Пары.Добавить(Отборы.Пара(Отборы.ИмяЛогов(), СтрСоединить(Имена, ",")));
	Пары.Добавить(Отборы.Пара(Отборы.ИмяЧислаВозвращённых(), ЧислоСтрокой(Итог.Логи.Количество())));
	Возврат Дороги.СтрокиСОтбором(Пары);

КонецФункции

// «Сохранено» здесь неверное слово: правка действует сразу и до перезапуска.
Функция Уведомления(Знач Исход)

	Результат = Новый Массив();
	Если Исход.Изменено = 0 Тогда
		Результат.Добавить(Ответы.Уведомление(Тексты.Текст("settings.hub.logs.reply.nothing"), "warn"));
	ИначеЕсли Исход.Изменено <> Неопределено Тогда
		Результат.Добавить(Ответы.Уведомление(
			Тексты.Шаблон("settings.hub.logs.reply.applied", ЧислоСтрокой(Исход.Изменено)), "ok"));
	КонецЕсли;
	Если Исход.Возвращено <> Неопределено Тогда
		Результат.Добавить(Ответы.Уведомление(
			Тексты.Шаблон("settings.hub.logs.reply.returned", ЧислоСтрокой(Исход.Возвращено)), "ok"));
	КонецЕсли;
	Если Исход.Пропущенные.Количество() > 0 Тогда
		Результат.Добавить(Ответы.Уведомление(Тексты.Шаблон("settings.hub.logs.reply.kept",
			СтрСоединить(Исход.Пропущенные, ", ")), "warn"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Исход.Отказ) Тогда
		Результат.Добавить(Ответы.Уведомление(Исход.Отказ, "err"));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ЧислоСтрокой(Знач Число)
	Возврат Формат(Число, "ЧН=0; ЧГ=0");
КонецФункции

#КонецОбласти

#Область Рендер

Процедура ОтдатьУровни(Ответ, Знач Вердикт, Знач КукиЗапроса, Знач Отбор, Знач Исход, Знач Статус = 200)

	Параметры = Новый Структура();
	Параметры.Вставить("Токен", Защита.ТокенСессии(Вердикт.Сессия));
	Параметры.Вставить("Отбор", Отбор);
	Параметры.Вставить("Применённые", Исход.Применённые);
	Параметры.Вставить("Черновик", Исход.Черновик);
	Параметры.Вставить("ВопросОВозврате", Исход.ВопросОВозврате);
	Параметры.Вставить("Кто", Строка(Вердикт.Пользователь.Логин));

	Модель = Ответы.МодельДома(Дом, "", Дом.Разделы(Дороги.КлючРаздела()),
		Уведомления(Исход), ВитринаУровней.Секции(Параметры));

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт.Пользователь, КукиЗапроса,
		Дом.ПодписьРаздела(Дороги.КлючРаздела()), Статус);

КонецПроцедуры

#КонецОбласти

&Контроллер("/hub/settings")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардХабАдмина") _ГвардХаб,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "НавигацияЛогов") _Дороги,
	&Пластилин(Значение = "ОтборЛогов") _Отборы,
	&Пластилин(Значение = "ФормаДереваЛогов") _Форма,
	&Пластилин(Значение = "ДеревоЛогов") _Дерево,
	&Пластилин(Значение = "ПравкаЛогов") _Правка,
	&Пластилин(Значение = "ВитринаУровнейЛогов") _ВитринаУровней,
	&Пластилин(Значение = "ВитринаСтрокЛогов") _ВитринаСтрок,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	ГвардХаб = _ГвардХаб;
	Ответы = _Ответы;
	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	Защита = _Защита;
	Дом = _Дом;
	Дороги = _Дороги;
	Отборы = _Отборы;
	Форма = _Форма;
	Дерево = _Дерево;
	Правка = _Правка;
	ВитринаУровней = _ВитринаУровней;
	ВитринаСтрок = _ВитринаСтрок;
	Тексты = _Тексты;

КонецПроцедуры
