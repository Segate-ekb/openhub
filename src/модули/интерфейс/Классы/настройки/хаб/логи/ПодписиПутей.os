// Подписи путей оператора словами экрана: состав пути знает пульт журнала, а как путь
// назвать человеку — словарь интерфейса.

Перем Подписи;  // Соответствие: ключ пути -> подпись

// Подпись пути; незнакомый ключ показывается как есть, чтобы новый путь пульта не пропал.
//
// Параметры:
//  Ключ - Строка - ключ пути из ПультЖурнала.Пути.
//
// Возвращаемое значение:
//  Строка
//
Функция Подпись(Знач Ключ) Экспорт
	Найдено = Подписи.Получить(Ключ);
	Возврат ?(Найдено = Неопределено, Ключ, Найдено);
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Подписи = Новый Соответствие();
	Подписи.Вставить("delivery", _Тексты.Текст("settings.hub.logs.path.delivery"));
	Подписи.Вставить("upstream", _Тексты.Текст("settings.hub.logs.path.upstream"));
	Подписи.Вставить("intake", _Тексты.Текст("settings.hub.logs.path.intake"));
	Подписи.Вставить("publish", _Тексты.Текст("settings.hub.logs.path.publish"));
	Подписи.Вставить("login", _Тексты.Текст("settings.hub.logs.path.login"));
	Подписи.Вставить("notifications", _Тексты.Текст("settings.hub.logs.path.notifications"));
	Подписи.Вставить("storage", _Тексты.Текст("settings.hub.logs.path.storage"));

КонецПроцедуры
