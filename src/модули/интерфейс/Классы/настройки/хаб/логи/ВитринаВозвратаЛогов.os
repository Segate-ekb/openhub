// Экран «Логи», вопрос «Вернуть всё как при старте?»: что снимется, кем и когда задано, и обычная
// кнопка; чужие правки среди снимаемого делают вопрос предупреждением.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Дерево;            // ДеревоЛогов (web-ui) — что задано с экрана
Перем Форма;             // ФормаДереваЛогов (web-ui) — операция и отбор формы ответа
Перем Дороги;            // НавигацияЛогов (web-ui) — адрес половины «Уровни»
Перем Отборы;            // ОтборЛогов (web-ui) — отбор ссылки обратно к дереву
Перем Переносимый;       // ПереносимыйКод (web-ui, кандидат в кит) — имя лога с переносами
Перем Даты;              // ДатаЧеловеку (web-ui) — одно написание момента на весь интерфейс

// Секция вопроса о возврате к старту.
//
// Параметры:
//  Отбор - Структура - результат ОтборЛогов.ОтборУровней: после возврата он сохраняется.
//  Токен - Строка - CSRF-токен сессии.
//  Кто - Строка - логин спрашивающего: чужими считаются правки других логинов.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция Секция(Знач Отбор, Знач Токен, Знач Кто) Экспорт

	Заданное = Дерево.ЗаданныеСЭкрана();
	Чужие = ЧужиеАвторы(Заданное, Кто);

	Вопрос = Кит.Холст();
	Вопрос.Добавить(Форма.ОперацияИОтбор(Форма.ОперацияПодтверждённогоВозврата(), Отбор));
	Вопрос.Добавить(ПоказанныеИмена(Заданное));
	Вопрос.Добавить(ЧтоСнимется(Заданное));
	Вопрос.Добавить(ЧужиеПравки(Чужие));
	Вопрос.Добавить(Решение(Заданное.Количество(), Отбор));

	Описание = РендерерНастроек.Секция(Тексты.Текст("settings.hub.logs.back.confirm.title"),
		ПояснениеВопроса(Заданное.Количество()), Вопрос.Рендер());
	Описание.Иконка = ?(Чужие.Количество() > 0, "предупреждение", "история");
	Описание.Опасная = Чужие.Количество() > 0;
	Описание.Действие = Дороги.Уровни();
	Описание.Токен = Токен;
	Описание.БезПанели = Истина;
	Возврат Описание;

КонецФункции

#Область Сборщики

Функция ПояснениеВопроса(Знач Задано)
	Если Задано = 0 Тогда
		Возврат Тексты.Текст("settings.hub.logs.back.confirm.none");
	КонецЕсли;
	Возврат Тексты.Шаблон("settings.hub.logs.back.confirm.lead", ЧислоСтрокой(Задано));
КонецФункции

// Кнопка возвращает ровно показанное: заданное после показа останется.
Функция ПоказанныеИмена(Знач Заданное)
	Имена = Новый Массив();
	Для Каждого Узел Из Заданное Цикл
		Имена.Добавить(Узел.Имя);
	КонецЦикла;
	Возврат Кит.СкрытоеПоле(Форма.ИмяЛогов(), СтрСоединить(Имена, ","));
КонецФункции

Функция ЧтоСнимется(Знач Заданное)

	Если Заданное.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Таблица = Кит.Таблица("карточками");
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.logs.back.col.log")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.logs.back.col.what")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.logs.back.col.by")));
	Для Каждого Узел Из Заданное Цикл
		Таблица.Добавить(СтрокаСнимаемого(Узел));
	КонецЦикла;
	Возврат Таблица;

КонецФункции

Функция СтрокаСнимаемого(Знач Узел)
	Запись = Кит.Запись();
	Запись.Добавить(Кит.Ячейка().Добавить(ИмяУзла(Узел)).Родитель());
	Запись.Добавить(Ячейка(ЧтоЗадано(Узел)));
	Запись.Добавить(Ячейка(КемИКогда(Узел)));
	Возврат Запись;
КонецФункции

Функция ЧужиеПравки(Знач Чужие)
	Если Чужие.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;
	Возврат Кит.Примечание(Тексты.Шаблон("settings.hub.logs.back.confirm.others", СтрСоединить(Чужие, ", ")));
КонецФункции

// Кнопка возврата — только когда есть что возвращать; дорога назад к дереву — всегда.
Функция Решение(Знач Задано, Знач Отбор)

	Кнопки = Кит.Ряд("признаки").Признак("logs-inline", "");
	Если Задано > 0 Тогда
		Кнопки.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Иконка",
			Тексты.Шаблон("settings.hub.logs.back.confirm.button", ЧислоСтрокой(Задано)), "основная", "история")));
	КонецЕсли;
	Кнопки.Добавить(СсылкаКДереву(Отбор));
	Возврат Кнопки;

КонецФункции

Функция СсылкаКДереву(Знач Отбор)
	Возврат Кит.Ссылка(Дороги.УровниСОтбором(Отборы.ПараметрыУровней(Отбор)))
		.Добавить(Кит.Текст(Тексты.Текст("settings.hub.logs.back.confirm.cancel"))).Родитель();
КонецФункции

Функция ИмяУзла(Знач Узел)
	Если НЕ ЗначениеЗаполнено(Узел.Группа) Тогда
		Возврат Кит.Текст(Тексты.Текст("settings.hub.logs.root.title"));
	КонецЕсли;
	Возврат Переносимый.Код(Узел.Имя);
КонецФункции

Функция ЧтоЗадано(Знач Узел)
	Части = Новый Массив();
	Если Узел.УровеньСЭкрана <> Неопределено Тогда
		Части.Добавить(Тексты.Шаблон("settings.hub.logs.back.what.level", Узел.УровеньСЭкрана));
	КонецЕсли;
	Если Узел.OTelСЭкрана = Истина Тогда
		Части.Добавить(Тексты.Шаблон("settings.hub.logs.back.what.otel", ?(Узел.ВOTel,
			Тексты.Текст("settings.hub.logs.row.otel.on"), Тексты.Текст("settings.hub.logs.row.otel.off"))));
	КонецЕсли;
	Возврат СтрСоединить(Части, " · ");
КонецФункции

// Уровень и отправку могли задать разные люди в разное время — названы оба.
Функция КемИКогда(Знач Узел)
	Части = Новый Массив();
	Если Узел.УровеньСЭкрана <> Неопределено Тогда
		Части.Добавить(Тексты.Шаблон("settings.hub.logs.back.by", Узел.ЗаданоКем, Даты.ДатаВремя(Узел.ЗаданоКогда)));
	КонецЕсли;
	Если Узел.OTelСЭкрана = Истина Тогда
		Автор = Тексты.Шаблон("settings.hub.logs.back.by", Узел.OTelЗаданКем, Даты.ДатаВремя(Узел.OTelЗаданКогда));
		Если Части.Найти(Автор) = Неопределено Тогда
			Части.Добавить(Автор);
		КонецЕсли;
	КонецЕсли;
	Возврат СтрСоединить(Части, " · ");
КонецФункции

Функция ЧужиеАвторы(Знач Заданное, Знач Кто)
	Чужие = Новый Массив();
	Для Каждого Узел Из Заданное Цикл
		Для Каждого Автор Из АвторыУзла(Узел) Цикл
			Если ЗначениеЗаполнено(Автор) И Автор <> Кто И Чужие.Найти(Автор) = Неопределено Тогда
				Чужие.Добавить(Автор);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Чужие;
КонецФункции

Функция АвторыУзла(Знач Узел)
	Авторы = Новый Массив();
	Если Узел.УровеньСЭкрана <> Неопределено Тогда
		Авторы.Добавить(Строка(Узел.ЗаданоКем));
	КонецЕсли;
	Если Узел.OTelСЭкрана = Истина Тогда
		Авторы.Добавить(Строка(Узел.OTelЗаданКем));
	КонецЕсли;
	Возврат Авторы;
КонецФункции

Функция Ячейка(Знач Текст)
	Возврат Кит.Ячейка().Добавить(Кит.Текст(Текст)).Родитель();
КонецФункции

Функция ЧислоСтрокой(Знач Число)
	Возврат Формат(Число, "ЧН=0; ЧГ=0");
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ДеревоЛогов") _Дерево,
	&Пластилин(Значение = "ФормаДереваЛогов") _Форма,
	&Пластилин(Значение = "НавигацияЛогов") _Дороги,
	&Пластилин(Значение = "ОтборЛогов") _Отборы,
	&Пластилин(Значение = "ПереносимыйКод") _Переносимый,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Тексты = _Тексты;
	Дерево = _Дерево;
	Форма = _Форма;
	Дороги = _Дороги;
	Отборы = _Отборы;
	Переносимый = _Переносимый;
	Даты = _Даты;

КонецПроцедуры
