// ⚠ Кандидат в кит: машинное имя, которое переносится после точки и на горбах CamelCase, а не
// посреди слова; куски — неразрывные блоки строки (`[data-wrap-part]` в листе хаба).

Перем Кит;  // Кит (кит) — фабрика элементов экрана

// Машинное имя моноширинным шрифтом с точками переноса.
//
// Параметры:
//  Значение - Строка - имя: класс, ключ, имя через точки.
//
// Возвращаемое значение:
//  ЭлементЭкрана - код, собранный из кусков имени.
//
Функция Код(Знач Значение) Экспорт

	Имя = Кит.Код("").Признак("wrap", "");
	Для Каждого Кусок Из Куски(Строка(Значение)) Цикл
		Имя.Добавить(Кит.Надпись().Признак("wrap-part", "").Добавить(Кит.Текст(Кусок)).Родитель());
	КонецЦикла;
	Возврат Имя;

КонецФункции

// Куски имени: разрез после точки, подчёркивания и дефиса и перед заглавной, которая
// идёт за строчной буквой либо цифрой.
//
// Параметры:
//  Значение - Строка - имя.
//
// Возвращаемое значение:
//  Массив из Строка - куски, которые вместе дают имя без потерь.
//
Функция Куски(Знач Значение) Экспорт

	Результат = Новый Массив();
	Кусок = "";
	Прежний = "";
	Для Номер = 1 По СтрДлина(Значение) Цикл
		Знак = Сред(Значение, Номер, 1);
		Если ЗначениеЗаполнено(Кусок) И Заглавная(Знак) И (Строчная(Прежний) ИЛИ Цифра(Прежний)) Тогда
			Результат.Добавить(Кусок);
			Кусок = "";
		КонецЕсли;
		Кусок = Кусок + Знак;
		Если Знак = "." ИЛИ Знак = "_" ИЛИ Знак = "-" Тогда
			Результат.Добавить(Кусок);
			Кусок = "";
		КонецЕсли;
		Прежний = Знак;
	КонецЦикла;
	Если ЗначениеЗаполнено(Кусок) Тогда
		Результат.Добавить(Кусок);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция Заглавная(Знач Знак)
	Возврат ВРег(Знак) = Знак И НРег(Знак) <> Знак;
КонецФункции

Функция Строчная(Знач Знак)
	Возврат НРег(Знак) = Знак И ВРег(Знак) <> Знак;
КонецФункции

Функция Цифра(Знач Знак)
	Возврат СтрНайти("0123456789", Знак) > 0 И ЗначениеЗаполнено(Знак);
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "Кит") _Кит) Экспорт
	Кит = _Кит;
КонецПроцедуры
