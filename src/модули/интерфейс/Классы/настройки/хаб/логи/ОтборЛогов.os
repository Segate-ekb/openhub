// Отбор экрана «Логи»: имена параметров адреса обеих половин — «Уровни» и «Строки» — и разбор
// их сырых значений. Состояние экрана живёт в адресе и даётся ссылкой.

#Область ИменаПараметров

// Имя параметра с подстрокой имени лога либо ветки.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПоиска() Экспорт
	Возврат "q";
КонецФункции

// Имя параметра с ключом пути, на котором отказ дорог (выдача пакета, вход…).
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПути() Экспорт
	Возврат "path";
КонецФункции

// Имя параметра «показать только заданное с экрана».
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяТолькоИзменённых() Экспорт
	Возврат "only";
КонецФункции

// Имя параметра с ветками, раскрытыми в дереве, через запятую.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяРаскрытых() Экспорт
	Возврат "open";
КонецФункции

// Имя параметра с именами логов половины «Строки» через запятую.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяЛогов() Экспорт
	Возврат "log";
КонецФункции

// Имя параметра с веткой половины «Строки» — началом пути группы.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяВетки() Экспорт
	Возврат "branch";
КонецФункции

// Имя параметра «уровень строки не ниже».
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяУровня() Экспорт
	Возврат "level";
КонецФункции

// Имя параметра с подстрокой текста строки.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяТекста() Экспорт
	Возврат "text";
КонецФункции

// Имя параметра «читать только память важного».
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяВажного() Экспорт
	Возврат "ring";
КонецФункции

// Имя параметра с логами, которых только что коснулась правка.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПрименённых() Экспорт
	Возврат "saved";
КонецФункции

// Имя параметра с логами, которые групповая правка пропустила: с экрана их не правят.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПропущенных() Экспорт
	Возврат "kept";
КонецФункции

// Имя параметра с числом логов, которых коснулась последняя правка.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяЧислаПравок() Экспорт
	Возврат "done";
КонецФункции

// Имя параметра с числом логов, которые последняя правка вернула к старту.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяЧислаВозвращённых() Экспорт
	Возврат "back";
КонецФункции

// Значение параметра «только изменённые», которое его включает.
//
// Возвращаемое значение:
//  Строка
//
Функция ЗначениеТолькоИзменённых() Экспорт
	Возврат "changed";
КонецФункции

// Значение параметра «память важного», которое её выбирает.
//
// Возвращаемое значение:
//  Строка
//
Функция ЗначениеВажного() Экспорт
	Возврат "important";
КонецФункции

#КонецОбласти

#Область Разбор

// Отбор половины «Уровни» из сырых значений адреса.
//
// Параметры:
//  Запрос - Строка - подстрока имени лога либо ветки.
//  Только - Строка - значение параметра «только изменённые».
//  Путь - Строка - ключ пути (необязательный, по умолчанию "").
//  Раскрытые - Строка - пути веток, раскрытых в дереве, через запятую (необязательный,
//              по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Запрос (Строка), ТолькоИзменённые (Булево), Путь (Строка), Раскрытые (Массив
//              из Строка), Активен (Булево — список сужен; раскрытие веток его не сужает).
//
Функция ОтборУровней(Знач Запрос, Знач Только, Знач Путь = "", Знач Раскрытые = "") Экспорт

	Отбор = Новый Структура();
	Отбор.Вставить("Запрос", Текст(Запрос));
	Отбор.Вставить("ТолькоИзменённые", Текст(Только) = ЗначениеТолькоИзменённых());
	Отбор.Вставить("Путь", Текст(Путь));
	Отбор.Вставить("Раскрытые", Имена(Раскрытые));
	Отбор.Вставить("Активен", ЗначениеЗаполнено(Отбор.Запрос) ИЛИ Отбор.ТолькоИзменённые
		ИЛИ ЗначениеЗаполнено(Отбор.Путь));
	Возврат Отбор;

КонецФункции

// Тот же отбор половины «Уровни» с другим набором раскрытых веток.
//
// Параметры:
//  Отбор - Структура - результат ОтборУровней.
//  Раскрытые - Массив из Строка - пути раскрытых веток.
//
// Возвращаемое значение:
//  Структура - см. ОтборУровней.
//
Функция ОтборСРаскрытыми(Знач Отбор, Знач Раскрытые) Экспорт
	Возврат ОтборУровней(Отбор.Запрос, ?(Отбор.ТолькоИзменённые, ЗначениеТолькоИзменённых(), ""),
		Отбор.Путь, СтрСоединить(Раскрытые, ","));
КонецФункции

// Тот же отбор половины «Уровни», где раскрыта ещё одна ветка.
//
// Параметры:
//  Отбор - Структура - результат ОтборУровней.
//  Ветка - Строка - путь группы ветки.
//
// Возвращаемое значение:
//  Структура - см. ОтборУровней.
//
Функция ОтборСВеткой(Знач Отбор, Знач Ветка) Экспорт
	Раскрытые = Новый Массив();
	Для Каждого Путь Из Отбор.Раскрытые Цикл
		Раскрытые.Добавить(Путь);
	КонецЦикла;
	Раскрытые.Добавить(Ветка);
	Возврат ОтборСРаскрытыми(Отбор, Раскрытые);
КонецФункции

// Отбор половины «Строки» из сырых значений адреса.
//
// Параметры:
//  Логи - Строка - имена логов через запятую.
//  Ветка - Строка - начало пути группы.
//  Уровень - Строка - уровень, ниже которого строки не показываются.
//  Подстрока - Строка - подстрока текста строки.
//  Путь - Строка - ключ пути (необязательный, по умолчанию "").
//  Важное - Строка - значение параметра «память важного» (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Логи (Массив из Строка), Путь, Ветка, Уровень, Текст (Строка),
//              ТолькоВажное (Булево), Активен (Булево).
//
Функция ОтборСтрок(Знач Логи, Знач Ветка, Знач Уровень, Знач Подстрока, Знач Путь = "",
	Знач Важное = "") Экспорт

	Отбор = Новый Структура();
	Отбор.Вставить("Логи", Имена(Логи));
	Отбор.Вставить("Ветка", Текст(Ветка));
	Отбор.Вставить("Уровень", ВРег(Текст(Уровень)));
	Отбор.Вставить("Текст", Текст(Подстрока));
	Отбор.Вставить("Путь", Текст(Путь));
	Отбор.Вставить("ТолькоВажное", Текст(Важное) = ЗначениеВажного());
	Отбор.Вставить("Активен", Отбор.Логи.Количество() > 0 ИЛИ ЗначениеЗаполнено(Отбор.Ветка)
		ИЛИ ЗначениеЗаполнено(Отбор.Путь) ИЛИ ЗначениеЗаполнено(Отбор.Уровень)
		ИЛИ ЗначениеЗаполнено(Отбор.Текст) ИЛИ Отбор.ТолькоВажное);
	Возврат Отбор;

КонецФункции

// Тот же отбор половины «Строки», где уровень заменён: слово, которого нет среди уровней,
// отбором не становится.
//
// Параметры:
//  Отбор - Структура - результат ОтборСтрок.
//  Уровень - Строка - уровень отбора либо "".
//
// Возвращаемое значение:
//  Структура - см. ОтборСтрок.
//
Функция ОтборСтрокСУровнем(Знач Отбор, Знач Уровень) Экспорт
	Возврат ОтборСтрок(СтрСоединить(Отбор.Логи, ","), Отбор.Ветка, Уровень, Отбор.Текст, Отбор.Путь,
		?(Отбор.ТолькоВажное, ЗначениеВажного(), ""));
КонецФункции

// Имена из значения через запятую: пустые и повторы выпадают.
//
// Параметры:
//  Значение - Строка - имена через запятую.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция Имена(Знач Значение) Экспорт

	Результат = Новый Массив();
	Для Каждого Имя Из СтрРазделить(Текст(Значение), ",", Ложь) Цикл
		Чистое = СокрЛП(Имя);
		Если ЗначениеЗаполнено(Чистое) И Результат.Найти(Чистое) = Неопределено Тогда
			Результат.Добавить(Чистое);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Число из значения адреса: только неотрицательное целое цифрами.
//
// Параметры:
//  Значение - Строка - сырое значение.
//
// Возвращаемое значение:
//  Число, Неопределено - число; Неопределено — в адресе не число.
//
Функция ЧислоИзАдреса(Знач Значение) Экспорт

	Цифры = Текст(Значение);
	Если НЕ ЗначениеЗаполнено(Цифры) ИЛИ СтрДлина(Цифры) > 9 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Номер = 1 По СтрДлина(Цифры) Цикл
		Если СтрНайти("0123456789", Сред(Цифры, Номер, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Возврат Число(Цифры);

КонецФункции

// Заполненные параметры половины «Уровни»: для скрытых полей форм и адресов.
//
// Параметры:
//  Отбор - Структура - результат ОтборУровней.
//
// Возвращаемое значение:
//  Массив из Структура - Имя, Значение.
//
Функция ПараметрыУровней(Знач Отбор) Экспорт

	Результат = Новый Массив();
	Если ЗначениеЗаполнено(Отбор.Запрос) Тогда
		Результат.Добавить(Пара(ИмяПоиска(), Отбор.Запрос));
	КонецЕсли;
	Если Отбор.ТолькоИзменённые Тогда
		Результат.Добавить(Пара(ИмяТолькоИзменённых(), ЗначениеТолькоИзменённых()));
	КонецЕсли;
	Если ЗначениеЗаполнено(Отбор.Путь) Тогда
		Результат.Добавить(Пара(ИмяПути(), Отбор.Путь));
	КонецЕсли;
	Если Отбор.Раскрытые.Количество() > 0 Тогда
		Результат.Добавить(Пара(ИмяРаскрытых(), СтрСоединить(Отбор.Раскрытые, ",")));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Заполненные параметры половины «Строки»: адрес «Обновить» повторяет тот же отбор.
//
// Параметры:
//  Отбор - Структура - результат ОтборСтрок.
//
// Возвращаемое значение:
//  Массив из Структура - Имя, Значение.
//
Функция ПараметрыСтрок(Знач Отбор) Экспорт

	Результат = Новый Массив();
	Если Отбор.Логи.Количество() > 0 Тогда
		Результат.Добавить(Пара(ИмяЛогов(), СтрСоединить(Отбор.Логи, ",")));
	КонецЕсли;
	Результат.Добавить(Пара(ИмяПути(), Отбор.Путь));
	Результат.Добавить(Пара(ИмяВетки(), Отбор.Ветка));
	Результат.Добавить(Пара(ИмяУровня(), Отбор.Уровень));
	Результат.Добавить(Пара(ИмяТекста(), Отбор.Текст));
	Если Отбор.ТолькоВажное Тогда
		Результат.Добавить(Пара(ИмяВажного(), ЗначениеВажного()));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Пара «имя параметра — значение» для адреса.
//
// Параметры:
//  Имя - Строка - имя параметра.
//  Значение - Строка - значение.
//
// Возвращаемое значение:
//  Структура - Имя, Значение.
//
Функция Пара(Знач Имя, Знач Значение) Экспорт
	Возврат Новый Структура("Имя, Значение", Имя, Значение);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Текст(Знач Значение)
	Возврат СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
