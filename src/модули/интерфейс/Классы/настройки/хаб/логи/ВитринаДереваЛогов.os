// Экран «Логи», секция-форма «Дерево логов»: корень, ярусы, ветки по пути группы и логи —
// у каждого уровень и отправка в коллектор, одно «Применить» на всё.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Дерево;            // ДеревоЛогов (web-ui) — задан ли лог с экрана, имя яруса без группы
Перем Форма;             // ФормаДереваЛогов (web-ui) — имена полей формы дерева
Перем Отборы;            // ОтборЛогов (web-ui) — отбор едет формой обратно
Перем Дороги;            // НавигацияЛогов (web-ui) — адреса, якорь ветки
Перем Переносимый;       // ПереносимыйКод (web-ui, кандидат в кит) — имя лога с переносами
Перем Даты;              // ДатаЧеловеку (web-ui) — одно написание момента на весь интерфейс
Перем Примечания;        // ПримечанияЭкрана (web-ui) — вид «показывать нечего»

#Область Секция

// Секция-форма дерева логов.
//
// Параметры:
//  Срез - Структура - результат ДеревоЛогов.Собрать.
//  Параметры - Структура - Токен (CSRF-токен сессии), Отбор (ОтборЛогов.ОтборУровней),
//              Черновик (Соответствие: имя поля -> выбранное, но не применённое значение).
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция Секция(Знач Срез, Знач Параметры) Экспорт

	Отбор = Отборы.ОтборСРаскрытыми(Параметры.Отбор, Срез.Открытые);

	ДеревоНаЭкране = Кит.Холст();
	ДеревоНаЭкране.Добавить(КнопкаПоУмолчанию());
	ДеревоНаЭкране.Добавить(Форма.ОперацияИОтбор(Форма.ОперацияДерева(), Отбор));
	ДеревоНаЭкране.Добавить(УзелКорня(Срез, Параметры.Черновик));
	Для Каждого Ярус Из Срез.Ярусы Цикл
		ДеревоНаЭкране.Добавить(ЯрусДерева(Ярус, Срез, Отбор, Параметры.Черновик));
	КонецЦикла;
	ДеревоНаЭкране.Добавить(ПустоеДерево(Срез));
	ДеревоНаЭкране.Добавить(НичегоНеНайдено(Срез, Параметры.Отбор));

	Описание = РендерерНастроек.Секция(Тексты.Текст("settings.hub.logs.tree.title"),
		Тексты.Текст("settings.hub.logs.tree.lead"), ДеревоНаЭкране.Рендер());
	Описание.Иконка = "стопка";
	Описание.Якорь = Дороги.ЯкорьДерева();
	Описание.Действие = Дороги.УровниУДерева();
	Описание.Токен = Параметры.Токен;
	Описание.Кнопка = Тексты.Текст("settings.hub.logs.tree.apply");
	Описание.ИконкаКнопки = "галочка";
	Описание.ПояснениеПанели = Тексты.Текст("settings.hub.logs.tree.apply.term");
	Описание.АдресОтмены = Дороги.УровниСОтбором(Отборы.ПараметрыУровней(Отбор));
	Возврат Описание;

КонецФункции

#КонецОбласти

#Область Узлы

// Её жмёт Enter: невидимая «Применить» без имени стоит в форме раньше кнопок свёрнутых веток.
Функция КнопкаПоУмолчанию()
	Возврат Кит.Область().Признак("logs-enter", "")
		.Добавить(Кит.Кнопка(Тексты.Текст("settings.hub.logs.tree.apply"))).Родитель();
КонецФункции

Функция УзелКорня(Знач Срез, Знач Черновик)

	Корень = Срез.Корень;
	Узел = Кит.Область("вставка");
	Узел.Добавить(Ряд(Надпись("заголовок", Тексты.Текст("settings.hub.logs.root.title")),
		ПроисхождениеУзла(Корень, Истина)));
	Узел.Добавить(Надпись("лид", Тексты.Текст("settings.hub.logs.root.lead")));
	Узел.Добавить(Ряд(УровеньУзла(Форма.ПолеУровняКорня(), Форма.ПолеПрежнегоУровняКорня(),
		Тексты.Текст("settings.hub.logs.root.level"), Корень, КакПриСтарте(Корень), Срез.Уровни, Черновик),
		ОтправкаУзла(Корень, Тексты.Текст("settings.hub.logs.root.otel"), Черновик)));
	Возврат Узел;

КонецФункции

// Ярус — модули хаба либо библиотеки; под отбором остаются только ветки с находками.
Функция ЯрусДерева(Знач Ярус, Знач Срез, Знач Отбор, Знач Черновик)

	Если Ярус.Найдено = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Результат = Кит.Холст();
	Результат.Добавить(Кит.Заголовок(3).Добавить(Кит.Текст(ПодписьЯруса(Ярус.Имя))).Родитель());
	Результат.Добавить(ТаблицаЛогов(Ярус.Логи, Срез, Черновик));
	Для Каждого Ветка Из Ярус.Ветки Цикл
		Результат.Добавить(ВеткаДерева(Ветка, Срез, Отбор, Черновик));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Свёрнутая ветка — одна строка с итогами, её логи страница не печатает.
Функция ВеткаДерева(Знач Ветка, Знач Срез, Знач Отбор, Знач Черновик)

	Если Ветка.Найдено = 0 Тогда
		Возврат Кит.Ничего();
	ИначеЕсли НЕ Дерево.ЛогиВеткиНаСтранице(Ветка) Тогда
		Возврат СвёрнутаяВетка(Ветка, Отбор);
	КонецЕсли;

	Ветвь = Кит.Раскрывашка().Признак("logs-branch", Ветка.Путь).Открыть();
	Ветвь.Шапка().Добавить(ИмяВетки(Ветка));
	Ветвь.Шапка().Добавить(ИтогиВетки(Ветка));

	Ветвь.Добавить(ПравкаВетки(Ветка, Срез.Уровни, Черновик));
	Ветвь.Добавить(ТаблицаЛогов(Ветка.Логи, Срез, Черновик));
	Для Каждого Вложенная Из Ветка.Ветки Цикл
		Ветвь.Добавить(ВеткаДерева(Вложенная, Срез, Отбор, Черновик));
	КонецЦикла;
	Возврат Ветвь;

КонецФункции

// Кнопка той же формы: выбранное едет телом формы, а в адресе — дерево с этой веткой, открытое у неё.
Функция СвёрнутаяВетка(Знач Ветка, Знач Отбор)

	Возврат Кит.Ряд("признаки").Признак("logs-closed", Ветка.Путь)
		.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Имя, Значение, Подсказка, АдресОтправки",
			Ветка.Имя, "ссылка", Форма.ИмяРаскрытия(), Ветка.Путь,
			Тексты.Шаблон("settings.hub.logs.branch.open", Ветка.Путь),
			АдресРаскрытой(Ветка, Отбор)))).Родитель()
		.Добавить(ИтогиВетки(Ветка)).Родитель();

КонецФункции

// Якорь ветки стоит на её выборе уровня; у ветки без правимых логов выбора нет — тогда к дереву.
Функция АдресРаскрытой(Знач Ветка, Знач Отбор)
	Пары = Отборы.ПараметрыУровней(Отборы.ОтборСВеткой(Отбор, Ветка.Путь));
	Если Дерево.ВыборВеткиРаскрытой(Ветка) Тогда
		Возврат Дороги.УровниУВетки(Пары, Ветка.Путь);
	КонецЕсли;
	Возврат Дороги.УровниУДерева(Пары);
КонецФункции

Функция ИмяВетки(Знач Ветка)
	Возврат Кит.Надпись("название").Добавить(Кит.Код(Ветка.Имя)).Родитель();
КонецФункции

Функция ИтогиВетки(Знач Ветка)

	Итоги = Кит.Ряд("признаки").Признак("logs-inline", "");
	Если Ветка.Найдено < Ветка.Всего Тогда
		Итоги.Добавить(Надпись("пояснение",
			Тексты.Шаблон("settings.hub.logs.branch.found", Ветка.Найдено, Ветка.Всего)));
	Иначе
		Итоги.Добавить(Надпись("пояснение", Тексты.Шаблон("settings.hub.logs.branch.logs", Ветка.Всего)));
	КонецЕсли;
	Если Ветка.СтрокЗаМинуту > 0 Тогда
		Итоги.Добавить(Надпись("пояснение", Тексты.Шаблон("settings.hub.logs.branch.rate", Ветка.СтрокЗаМинуту)));
	КонецЕсли;
	Если Ветка.Подробных > 0 Тогда
		Итоги.Добавить(Плашка(Тексты.Шаблон("settings.hub.logs.branch.debug", Ветка.Подробных), "warn"));
	КонецЕсли;
	Если Ветка.СЭкрана > 0 Тогда
		Итоги.Добавить(Плашка(Тексты.Шаблон("settings.hub.logs.branch.screen", Ветка.СЭкрана), "accent"));
	КонецЕсли;
	Если Ветка.НеВOTel > 0 Тогда
		Итоги.Добавить(Плашка(Тексты.Шаблон("settings.hub.logs.branch.nootel", Ветка.НеВOTel), ""));
	КонецЕсли;
	Возврат Итоги;

КонецФункции

// Выбор ветки ничего не хранит: «не менять» стоит всегда, форма шлёт его только поменянным.
Функция ПравкаВетки(Знач Ветка, Знач Уровни, Знач Черновик)

	Правка = Кит.Ряд("признаки").Признак("logs-inline", "");
	Если Дерево.ВыборВеткиНаСтранице(Ветка) Тогда
		ИмяПоля = Форма.ПолеВетки(Ветка.Путь);
		Выбранное = Черновик.Получить(ИмяПоля);
		Правка.Добавить(Кит.Поле(Новый Структура("Имя, Ид, Метка, Тип, Значение, Варианты",
			ИмяПоля, Дороги.ЯкорьВетки(Ветка.Путь),
			Тексты.Шаблон("settings.hub.logs.branch.level", Ветка.ИменаПравимых.Количество()), "выбор",
			?(Выбранное = Неопределено, "", Выбранное), ВариантыВетки(Уровни))));
		Правка.Добавить(НеПрименено(Выбранное));
	КонецЕсли;
	Если Ветка.ТолькоЧтения.Количество() > 0 Тогда
		Правка.Добавить(Надпись("пояснение", Тексты.Шаблон("settings.hub.logs.branch.readonly",
			СтрСоединить(Ветка.ТолькоЧтения, ", "))));
	КонецЕсли;
	Правка.Добавить(Ссылка(Дороги.СтрокиВетки(Ветка.Путь), Тексты.Текст("settings.hub.logs.branch.lines")));
	Возврат Правка;

КонецФункции

Функция ПустоеДерево(Знач Срез)

	Если Срез.Всего > 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;
	Возврат Примечания.Пусто(Тексты.Текст("settings.hub.logs.tree.none"));

КонецФункции

Функция НичегоНеНайдено(Знач Срез, Знач Отбор)

	Если НЕ Отбор.Активен ИЛИ Срез.Найдено > 0 ИЛИ Срез.Всего = 0 Тогда
		Возврат Кит.Ничего();
	ИначеЕсли НЕ Срез.ПутьИзвестен Тогда
		Возврат Примечания.Пусто(Тексты.Шаблон("settings.hub.logs.path.unknown", Отбор.Путь));
	КонецЕсли;
	Возврат Примечания.Пусто(Тексты.Текст("settings.hub.logs.tree.empty"));

КонецФункции

#КонецОбласти

#Область Логи

Функция ТаблицаЛогов(Знач Логи, Знач Срез, Знач Черновик)

	Если Логи.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Таблица = Кит.Таблица("карточками").Признак("logs-table", "");
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.logs.col.log")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.logs.col.level")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.logs.col.origin")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.logs.col.otel")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.logs.col.lines"), "узкая").БезПодписиВЗаписи());

	Для Каждого Узел Из Логи Цикл
		Таблица.Добавить(СтрокаЛога(Узел, Срез, Черновик));
	КонецЦикла;
	Возврат Таблица;

КонецФункции

// Строка, где что-то задано с экрана, залита цветом: её и придётся вернуть после разбора.
Функция СтрокаЛога(Знач Узел, Знач Срез, Знач Черновик)

	Запись = Кит.Запись(?(Дерево.ЗаданСЭкрана(Узел), "выделенная", ""));
	Запись.Добавить(ИмяЛога(Узел));
	Запись.Добавить(УровеньЛога(Узел, Срез, Черновик));
	Запись.Добавить(Кит.Ячейка().Признак("logs-origin", "").Добавить(ПроисхождениеУзла(Узел)).Родитель());
	Запись.Добавить(Кит.Ячейка().Признак("logs-otel", "").Добавить(ОтправкаУзла(Узел,
		Тексты.Шаблон("settings.hub.logs.row.otel", Узел.Имя), Черновик)).Родитель());
	Запись.Добавить(СтрокиЛога(Узел));
	Возврат Запись;

КонецФункции

Функция ИмяЛога(Знач Узел)

	Ячейка = Кит.Ячейка().Признак("logs-name", "");
	Ячейка.Добавить(Переносимый.Код(Узел.Имя));
	Ячейка.Добавить(ВыходыЛога(Узел));
	Возврат Ячейка;

КонецФункции

// Чем лог отличается от обычного: не правится с экрана, пишет не в консоль и память либо ещё куда-то.
Функция ВыходыЛога(Знач Узел)

	Особые = Новый Массив();
	Если Узел.ТолькоЧтение Тогда
		Особые.Добавить(ПочемуТолькоЧтение(Узел.ПочемуТолькоЧтение));
	КонецЕсли;
	Если НЕ Узел.ВКонсоль Тогда
		Особые.Добавить(Тексты.Текст("settings.hub.logs.row.noconsole"));
	КонецЕсли;
	Если НЕ Узел.ВПамять Тогда
		Особые.Добавить(Тексты.Текст("settings.hub.logs.row.nomemory"));
	КонецЕсли;
	Если Узел.ПрочиеВыходы.Количество() > 0 Тогда
		Особые.Добавить(Тексты.Шаблон("settings.hub.logs.row.outputs", СтрСоединить(Узел.ПрочиеВыходы, ", ")));
	КонецЕсли;

	Если Особые.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;
	Возврат Надпись("приписка", СтрСоединить(Особые, " · "));

КонецФункции

// Причина словами оператора; код, которого экран не знает, — общими словами «только чтение».
Функция ПочемуТолькоЧтение(Знач Код)

	Если Код = "audit" Тогда
		Возврат Тексты.Текст("settings.hub.logs.row.readonly.audit");
	ИначеЕсли Код = "before_wiring" Тогда
		Возврат Тексты.Текст("settings.hub.logs.row.readonly.early");
	КонецЕсли;
	Возврат Тексты.Текст("settings.hub.logs.row.readonly");

КонецФункции

Функция УровеньЛога(Знач Узел, Знач Срез, Знач Черновик)

	Ячейка = Кит.Ячейка().Признак("logs-level", "");
	Если Узел.ТолькоЧтение Тогда
		Возврат Ячейка.Добавить(Кит.Код(Узел.УровеньДействующий)).Родитель();
	КонецЕсли;
	Возврат Ячейка.Добавить(УровеньУзла(Форма.ПолеУровня(Узел.Имя), Форма.ПолеПрежнегоУровня(Узел.Имя),
		Тексты.Шаблон("settings.hub.logs.row.level", Узел.Имя), Узел, КакПриСтарте(Узел, Срез.Корень),
		Срез.Уровни, Черновик)).Родитель();

КонецФункции

// Выбор уровня с «было»: правкой считается только то, что поменяли относительно показанного.
Функция УровеньУзла(Знач Имя, Знач ИмяПрежнего, Знач Метка, Знач Узел, Знач ПодписьСтарта, Знач Уровни,
	Знач Черновик)

	Показанное = ?(Узел.УровеньСЭкрана = Неопределено, Форма.ВариантСтарта(), Узел.УровеньСЭкрана);
	Выбранное = Черновик.Получить(Имя);

	Выбор = Кит.Холст();
	Выбор.Добавить(ВыборУровня(Имя, Метка, ?(Выбранное = Неопределено, Показанное, Выбранное),
		ПодписьСтарта, Уровни));
	Выбор.Добавить(Кит.СкрытоеПоле(ИмяПрежнего, Показанное));
	Выбор.Добавить(НеПрименено(Выбранное));
	Возврат Выбор;

КонецФункции

// Лог, до коллектора не доходящий, и лог только для чтения показывают тумблер запертым и говорят почему.
Функция ОтправкаУзла(Знач Узел, Знач Метка, Знач Черновик)

	Если НЕ Узел.МожноВOTel Тогда
		Возврат ЗапертыйТумблер(Метка, Ложь, Тексты.Текст("settings.hub.logs.row.otel.unreachable"));
	ИначеЕсли Узел.ТолькоЧтение Тогда
		Возврат ЗапертыйТумблер(Метка, Узел.ВOTel, Тексты.Текст("settings.hub.logs.row.otel.readonly"));
	КонецЕсли;

	Показанное = ?(Узел.ВOTel, Форма.ЗначениеВключено(), "0");
	Выбранное = Черновик.Получить(Форма.ПолеOTel(Узел.Имя));
	Включено = ?(Выбранное = Неопределено, Показанное, Выбранное) = Форма.ЗначениеВключено();

	Отправка = Кит.Холст();
	Отправка.Добавить(Кит.Тумблер(Новый Структура("Имя, Метка, Включено, ЗначениеВкл, ПодписьВкл, ПодписьВыкл",
		Форма.ПолеOTel(Узел.Имя), Метка, Включено, Форма.ЗначениеВключено(),
		Тексты.Текст("settings.hub.logs.row.otel.on"), Тексты.Текст("settings.hub.logs.row.otel.off"))));
	Отправка.Добавить(Кит.СкрытоеПоле(Форма.ПолеПрежнегоOTel(Узел.Имя), Показанное));
	Отправка.Добавить(ПорогИАвторОтправки(Узел));
	Отправка.Добавить(НеПрименено(Выбранное));
	Возврат Отправка;

КонецФункции

Функция ЗапертыйТумблер(Знач Метка, Знач Включено, Знач Почему)

	Возврат Кит.Тумблер(Новый Структура("Метка, Включено, Заблокировано, Подсказка, ПодписьВкл, ПодписьВыкл",
		Метка, Включено, Истина, Почему,
		Тексты.Текст("settings.hub.logs.row.otel.on"), Тексты.Текст("settings.hub.logs.row.otel.off")));

КонецФункции

Функция ПорогИАвторОтправки(Знач Узел)

	Сноски = Новый Массив();
	Если ЗначениеЗаполнено(Узел.ПорогOTel) Тогда
		Сноски.Добавить(Тексты.Шаблон("settings.hub.logs.row.otel.threshold", Узел.ПорогOTel));
	КонецЕсли;
	Если Узел.OTelСЭкрана = Истина И ЗначениеЗаполнено(Узел.OTelЗаданКогда) Тогда
		Сноски.Добавить(Тексты.Шаблон("settings.hub.logs.row.otel.byat", Узел.OTelЗаданКем,
			Даты.ДатаВремя(Узел.OTelЗаданКогда)));
	ИначеЕсли Узел.OTelСЭкрана = Истина Тогда
		Сноски.Добавить(Тексты.Шаблон("settings.hub.logs.row.otel.by", Узел.OTelЗаданКем));
	КонецЕсли;

	Если Сноски.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;
	Возврат Надпись("приписка", СтрСоединить(Сноски, " · "));

КонецФункции

// Ход к строкам лога; шумный лог виден сразу — числом строк за последнюю минуту.
Функция СтрокиЛога(Знач Узел)

	Подпись = ?(Узел.СтрокЗаМинуту > 0,
		Тексты.Шаблон("settings.hub.logs.row.lines.rate", Узел.СтрокЗаМинуту),
		Тексты.Текст("settings.hub.logs.row.lines"));

	Имена = Новый Массив();
	Имена.Добавить(Узел.Имя);
	Возврат Кит.Ячейка("узкая").Добавить(Ссылка(Дороги.СтрокиЛогов(Имена), Подпись)).Родитель();

КонецФункции

#КонецОбласти

#Область Сборщики

// Откуда уровень: с экрана — кем и когда; со старта — окружением, файлом, умолчанием либо корнем.
Функция ПроисхождениеУзла(Знач Узел, Знач ЭтоКорень = Ложь)

	Если Узел.УровеньСЭкрана <> Неопределено Тогда
		Возврат Кит.Холст()
			.Добавить(Плашка(Тексты.Текст("settings.hub.logs.origin.screen"), "accent")).Родитель()
			.Добавить(Надпись("приписка", Тексты.Шаблон("settings.hub.logs.origin.screen.by",
				Узел.ЗаданоКем, Даты.ДатаВремя(Узел.ЗаданоКогда)))).Родитель();
	КонецЕсли;

	Если НЕ Узел.СвойПриСтарте И НЕ ЭтоКорень Тогда
		Возврат Надпись("приглушённая", Тексты.Текст("settings.hub.logs.origin.root"));
	КонецЕсли;

	Источник = Кит.Плашка(Новый Структура("Текст, Подсказка", ПодписьИсточника(Узел.ОткудаПриСтарте),
		Узел.ИмяНастройки));
	Если НЕ ЗначениеЗаполнено(Узел.ИмяНастройки) Тогда
		Возврат Источник;
	КонецЕсли;
	Возврат Кит.Холст()
		.Добавить(Источник).Родитель()
		.Добавить(Кит.Надпись("приписка").Добавить(Кит.Код(Узел.ИмяНастройки)).Родитель()).Родитель();

КонецФункции

// Подпись «как при старте»: лог без своего уровня при старте следует корню.
Функция КакПриСтарте(Знач Узел, Знач Корень = Неопределено)

	Если Корень <> Неопределено И НЕ Узел.СвойПриСтарте Тогда
		Возврат Тексты.Шаблон("settings.hub.logs.level.root", Корень.УровеньДействующий);
	КонецЕсли;
	Возврат Тексты.Шаблон("settings.hub.logs.level.start", Узел.УровеньПриСтарте,
		ПодписьИсточника(Узел.ОткудаПриСтарте));

КонецФункции

Функция ПодписьИсточника(Знач Откуда)

	Если Откуда = "окружение" Тогда
		Возврат Тексты.Текст("settings.hub.logs.origin.env");
	ИначеЕсли Откуда = "файл" Тогда
		Возврат Тексты.Текст("settings.hub.logs.origin.file");
	КонецЕсли;
	Возврат Тексты.Текст("settings.hub.logs.origin.default");

КонецФункции

Функция ПодписьЯруса(Знач Имя)

	Если Имя = "хаб" Тогда
		Возврат Тексты.Текст("settings.hub.logs.tree.hub");
	ИначеЕсли Имя = "библиотеки" Тогда
		Возврат Тексты.Текст("settings.hub.logs.tree.libraries");
	ИначеЕсли Имя = Дерево.ИмяБезГруппы() Тогда
		Возврат Тексты.Текст("settings.hub.logs.tree.nogroup");
	КонецЕсли;
	Возврат Имя;

КонецФункции

// Первый вариант снимает заданное с экрана, его подпись называет, что тогда будет.
Функция ВыборУровня(Знач Имя, Знач Метка, Знач Значение, Знач ПодписьСтарта, Знач Уровни)

	Варианты = Новый Массив();
	Варианты.Добавить(Вариант(Форма.ВариантСтарта(), ПодписьСтарта));
	Для Каждого Уровень Из Уровни Цикл
		Варианты.Добавить(Вариант(Уровень, Уровень));
	КонецЦикла;

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Варианты", Имя, Метка, "выбор",
		Значение, Варианты));

КонецФункции

// «Не менять» стоит первым, «как при старте» — последним: нажатие наугад не откатывает.
Функция ВариантыВетки(Знач Уровни)

	Результат = Новый Массив();
	Результат.Добавить(Вариант("", Тексты.Текст("settings.hub.logs.branch.keep")));
	Для Каждого Уровень Из Уровни Цикл
		Результат.Добавить(Вариант(Уровень, Уровень));
	КонецЦикла;
	Результат.Добавить(Вариант(Форма.ВариантСтарта(), Тексты.Текст("settings.hub.logs.level.back")));
	Возврат Результат;

КонецФункции

Функция НеПрименено(Знач Выбранное)
	Если Выбранное = Неопределено Тогда
		Возврат Кит.Ничего();
	КонецЕсли;
	Возврат Плашка(Тексты.Текст("settings.hub.logs.draft.mark"), "warn");
КонецФункции

Функция Ряд(Знач Первый, Знач Второй)
	Возврат Кит.Ряд("признаки").Признак("logs-inline", "")
		.Добавить(Первый).Родитель()
		.Добавить(Второй).Родитель();
КонецФункции

Функция Вариант(Знач Значение, Знач Подпись)
	Возврат Новый Структура("Значение, Подпись", Значение, Подпись);
КонецФункции

Функция Надпись(Знач Вид, Знач Текст)
	Возврат Кит.Надпись(Вид).Добавить(Кит.Текст(Текст)).Родитель();
КонецФункции

Функция Плашка(Знач Текст, Знач Вид)
	Возврат Кит.Плашка(Новый Структура("Текст, Вид", Текст, Вид));
КонецФункции

Функция Ссылка(Знач Адрес, Знач Текст)
	Возврат Кит.Ссылка(Адрес).Добавить(Кит.Текст(Текст)).Родитель();
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ДеревоЛогов") _Дерево,
	&Пластилин(Значение = "ФормаДереваЛогов") _Форма,
	&Пластилин(Значение = "ОтборЛогов") _Отборы,
	&Пластилин(Значение = "НавигацияЛогов") _Дороги,
	&Пластилин(Значение = "ПереносимыйКод") _Переносимый,
	&Пластилин(Значение = "ПримечанияЭкрана") _Примечания,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Тексты = _Тексты;
	Дерево = _Дерево;
	Форма = _Форма;
	Отборы = _Отборы;
	Дороги = _Дороги;
	Переносимый = _Переносимый;
	Примечания = _Примечания;
	Даты = _Даты;

КонецПроцедуры
