// Черновик дерева логов — выбранное в форме, но ещё не применённое: какие его поля страница
// напечатает, а что из него отброшено либо на странице не показано.

Перем Форма;   // ФормаДереваЛогов (web-ui) — имена полей формы дерева, допустимые значения
Перем Дерево;  // ДеревоЛогов (web-ui) — что из дерева напечатано на странице

#Область ПубличныйИнтерфейс

// Логи черновика: страница раскрывает их ветки, чтобы выбранное осталось на виду.
//
// Параметры:
//  Выбранное - Структура, Неопределено - результат ФормаДереваЛогов.Правки; Неопределено —
//              черновика нет.
//
// Возвращаемое значение:
//  Массив из Строка - имена логов.
//
Функция Отмеченные(Знач Выбранное) Экспорт

	Результат = Новый Массив();
	Если Выбранное = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Правка Из Выбранное.Логи Цикл
		Результат.Добавить(Правка.Имя);
	КонецЦикла;
	Для Каждого Правка Из Выбранное.Отправка Цикл
		Результат.Добавить(Правка.Имя);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ветки черновика: выбор уровня ветки виден только у раскрытой, поэтому страница раскрывает их.
//
// Параметры:
//  Выбранное - Структура, Неопределено - результат ФормаДереваЛогов.Правки; Неопределено —
//              черновика нет.
//
// Возвращаемое значение:
//  Массив из Строка - пути веток.
//
Функция ВеткиЧерновика(Знач Выбранное) Экспорт

	Результат = Новый Массив();
	Если Выбранное = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Правка Из Выбранное.Ветки Цикл
		Результат.Добавить(Правка.Путь);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Черновик так, как его покажет страница: только поля, которые она напечатает, со значениями,
// которые можно выбрать. Число полей равно числу пометок «не применено» на странице.
//
// Параметры:
//  Выбранное - Структура, Неопределено - результат ФормаДереваЛогов.Правки.
//  Срез - Структура - результат ДеревоЛогов.Собрать.
//
// Возвращаемое значение:
//  Структура - Поля (Соответствие: имя поля формы -> выбранное значение), Отброшено (Массив
//              из Строка — логи и ветки, которых нет, которые с экрана не правятся либо
//              с недопустимым значением), НеПоказано (Массив из Строка — логи и ветки, которых
//              на этой странице не видно: вне отбора либо в свёрнутой ветке).
//
Функция Показанный(Знач Выбранное, Знач Срез) Экспорт

	Черновик = Новый Структура("Поля, Отброшено, НеПоказано", Новый Соответствие(), Новый Массив(),
		Новый Массив());
	Если Выбранное = Неопределено Тогда
		Возврат Черновик;
	КонецЕсли;

	Если ЗначениеЗаполнено(Выбранное.Корень) Тогда
		Учесть(Черновик, Срез.Корень.Имя, Форма.ПолеУровняКорня(), Выбранное.Корень,
			Форма.ДопустимыйУровень(Выбранное.Корень, Срез.Уровни), Истина);
	КонецЕсли;
	Для Каждого Правка Из Выбранное.Ветки Цикл
		Учесть(Черновик, Правка.Путь, Форма.ПолеВетки(Правка.Путь), Правка.Значение,
			ВеткаПравится(Срез, Правка), Дерево.ВеткаНаСтранице(Срез, Правка.Путь));
	КонецЦикла;
	Для Каждого Правка Из Выбранное.Логи Цикл
		Учесть(Черновик, Правка.Имя, Форма.ПолеУровня(Правка.Имя), Правка.Значение,
			ЛогПравится(Срез, Правка), Дерево.ЛогНаСтранице(Срез, Правка.Имя));
	КонецЦикла;
	Для Каждого Правка Из Выбранное.Отправка Цикл
		Учесть(Черновик, Правка.Имя, Форма.ПолеOTel(Правка.Имя),
			?(Правка.Признак, Форма.ЗначениеВключено(), "0"), ОтправкаПравится(Срез, Правка.Имя),
			Правка.Имя = Срез.Корень.Имя ИЛИ Дерево.ЛогНаСтранице(Срез, Правка.Имя));
	КонецЦикла;

	Возврат Черновик;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Учесть(Черновик, Знач Имя, Знач Поле, Знач Значение, Знач Правится, Знач НаСтранице)
	Если НЕ Правится Тогда
		Черновик.Отброшено.Добавить(Имя);
	ИначеЕсли НЕ НаСтранице Тогда
		Черновик.НеПоказано.Добавить(Имя);
	Иначе
		Черновик.Поля.Вставить(Поле, Значение);
	КонецЕсли;
КонецПроцедуры

Функция ВеткаПравится(Знач Срез, Знач Правка)
	Возврат Дерево.ВеткаПоПути(Срез, Правка.Путь) <> Неопределено
		И Форма.ДопустимыйУровень(Правка.Значение, Срез.Уровни);
КонецФункции

Функция ЛогПравится(Знач Срез, Знач Правка)
	Узел = Срез.УзлыПоИмени.Получить(Правка.Имя);
	Возврат Узел <> Неопределено И НЕ Узел.ТолькоЧтение И Форма.ДопустимыйУровень(Правка.Значение, Срез.Уровни);
КонецФункции

Функция ОтправкаПравится(Знач Срез, Знач Имя)
	Узел = ?(Имя = Срез.Корень.Имя, Срез.Корень, Срез.УзлыПоИмени.Получить(Имя));
	Возврат Узел <> Неопределено И НЕ Узел.ТолькоЧтение И Узел.МожноВOTel;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ФормаДереваЛогов") _Форма,
	&Пластилин(Значение = "ДеревоЛогов") _Дерево) Экспорт

	Форма = _Форма;
	Дерево = _Дерево;

КонецПроцедуры
