// Экран «Логи» дома «Хаб», половина «Строки»: последние строки журнала из памяти хаба
// с отбором по логу, пути, ветке, уровню и тексту; из строки — ход к её логу.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Пульт;             // ПультЖурнала (наблюдаемость) — строки, логи, пути, память
Перем Дерево;            // ДеревоЛогов (web-ui) — пути веток, задан ли лог с экрана
Перем Отборы;            // ОтборЛогов (web-ui) — имена параметров адреса
Перем Дороги;            // НавигацияЛогов (web-ui) — адреса и вкладки экрана
Перем Лента;             // ЛентаЗаписей (web-ui, кандидат в кит) — плотный список строк
Перем Форма;             // ФормаДереваЛогов (web-ui) — имена полей формы возврата
Перем ПодписиПутей;      // ПодписиПутей (web-ui) — путь словами оператора
Перем Даты;              // ДатаЧеловеку (web-ui) — одно написание момента на весь интерфейс
Перем Примечания;        // ПримечанияЭкрана (web-ui) — вид «показывать нечего»

#Область Экран

// Секции половины «Строки».
//
// Параметры:
//  Запрошенное - Структура - результат ОтборЛогов.ОтборСтрок, как его прислал адрес.
//  Токен - Строка - CSRF-токен сессии: отсюда заданное с экрана возвращается к старту.
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Запрошенное, Знач Токен) Экспорт

	Отбор = ОтборСИзвестнымУровнем(Запрошенное);
	Состав = СоставПоловины(Отбор);

	Экран = Кит.Холст();
	Экран.Добавить(Дороги.Вкладки("строки"));
	Экран.Добавить(ФормаОтбора(Отбор, Состав.Ветки, Состав.Пути));
	Экран.Добавить(УровниОтобранных(Состав.Отобранные, Токен));
	Экран.Добавить(ТихийЛог(Состав.Отобранные));
	Экран.Добавить(ЧтоПоказано(Состав.Строки.Количество(), Отбор));
	Экран.Добавить(Лента.Список(ЗаписиЛенты(Состав.Строки)));
	Экран.Добавить(ПустойСписок(Состав.Строки, Состав.Неизвестное));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.hub.logs.lines.title"),
		ЁмкостьПамяти(), Экран.Рендер());
	Секция.Иконка = "история";

	Результат = Новый Массив();
	Результат.Добавить(Секция);
	Возврат Результат;

КонецФункции

// Сколько держит память и сколько записано с запуска: пустой список не читается как «хаб молчал».
Функция ЁмкостьПамяти()

	Счёт = Пульт.СчётПамяти();
	Возврат Тексты.Шаблон("settings.hub.logs.lines.lead", ЧислоСтрокой(Счёт.Ёмкость),
		ЧислоСтрокой(Счёт.ЁмкостьВажного), ЧислоСтрокой(Счёт.Всего));

КонецФункции

#КонецОбласти

#Область Отбор

// GET-форма: отбор живёт в адресе, страницу со строками одного лога можно дать ссылкой.
Функция ФормаОтбора(Знач Отбор, Знач Ветки, Знач Пути)

	Поля = Новый Массив();
	Поля.Добавить(Новый Структура("Имя, Метка, Значение, Плейсхолдер", Отборы.ИмяЛогов(),
		Тексты.Текст("settings.hub.logs.lines.filter.log"), СтрСоединить(Отбор.Логи, ", "),
		Тексты.Текст("settings.hub.logs.lines.filter.log.placeholder")));
	Поля.Добавить(Новый Структура("Имя, Метка, Тип, Значение, Варианты", Отборы.ИмяПути(),
		Тексты.Текст("settings.hub.logs.lines.filter.path"), "выбор", Отбор.Путь, ВариантыПути(Пути)));
	Поля.Добавить(Новый Структура("Имя, Метка, Тип, Значение, Варианты", Отборы.ИмяВетки(),
		Тексты.Текст("settings.hub.logs.lines.filter.branch"), "выбор", Отбор.Ветка, ВариантыВетки(Ветки)));
	Поля.Добавить(Новый Структура("Имя, Метка, Тип, Значение, Варианты", Отборы.ИмяУровня(),
		Тексты.Текст("settings.hub.logs.lines.filter.level"), "выбор", Отбор.Уровень, ВариантыУровня()));
	Поля.Добавить(Новый Структура("Имя, Метка, Тип, Значение, Варианты", Отборы.ИмяВажного(),
		Тексты.Текст("settings.hub.logs.lines.filter.ring"), "выбор",
		?(Отбор.ТолькоВажное, Отборы.ЗначениеВажного(), ""), ВариантыПамяти()));
	Поля.Добавить(Новый Структура("Имя, Метка, Значение, Плейсхолдер", Отборы.ИмяТекста(),
		Тексты.Текст("settings.hub.logs.lines.filter.text"), Отбор.Текст,
		Тексты.Текст("settings.hub.logs.lines.filter.text.placeholder")));

	Возврат Кит.Область().Признак("logs-filters", "")
		.Добавить(Кит.СтрокаПоиска(Новый Структура("Действие, Поля, Кнопка, Иконка", Дороги.Строки(), Поля,
			Тексты.Текст("settings.hub.logs.lines.filter.button"), "поиск"))).Родитель();

КонецФункции

Функция ВариантыПути(Знач Пути)

	Результат = Новый Массив();
	Результат.Добавить(Вариант("", Тексты.Текст("settings.hub.logs.lines.filter.path.all")));
	Для Каждого Путь Из Пути Цикл
		Результат.Добавить(Вариант(Путь.Ключ, ПодписиПутей.Подпись(Путь.Ключ)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ВариантыВетки(Знач Ветки)

	Результат = Новый Массив();
	Результат.Добавить(Вариант("", Тексты.Текст("settings.hub.logs.lines.filter.branch.all")));
	Для Каждого Ветка Из Ветки Цикл
		Результат.Добавить(Вариант(Ветка, Ветка));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// «Не ниже» читается как «и серьёзнее»: вариант «DEBUG» показывает и INFO, и WARN.
Функция ВариантыУровня()

	Результат = Новый Массив();
	Результат.Добавить(Вариант("", Тексты.Текст("settings.hub.logs.lines.filter.level.all")));
	Для Каждого Уровень Из Пульт.Уровни() Цикл
		Если Уровень <> "DISABLE" Тогда
			Результат.Добавить(Вариант(Уровень, Тексты.Шаблон("settings.hub.logs.lines.filter.level.from", Уровень)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ВариантыПамяти()

	Результат = Новый Массив();
	Результат.Добавить(Вариант("", Тексты.Текст("settings.hub.logs.lines.filter.ring.all")));
	Результат.Добавить(Вариант(Отборы.ЗначениеВажного(), Тексты.Текст("settings.hub.logs.lines.filter.ring.important")));
	Возврат Результат;

КонецФункции

// Строки объясняют себя: какой у каждого лога уровень сейчас; заданное с экрана здесь же и возвращается.
Функция УровниОтобранных(Знач Отобранные, Знач Токен)

	Если Отобранные.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Сводка = Кит.Ряд("признаки").Признак("logs-inline", "");
	Сводка.Добавить(Кит.Надпись("пояснение")
		.Добавить(Кит.Текст(Тексты.Текст("settings.hub.logs.lines.now"))).Родитель());
	СЭкрана = Новый Массив();
	Для Каждого Узел Из Отобранные Цикл
		Сводка.Добавить(ПлашкаУровня(Узел));
		Если Дерево.ЗаданСЭкрана(Узел) Тогда
			СЭкрана.Добавить(Узел.Имя);
		КонецЕсли;
	КонецЦикла;
	Сводка.Добавить(ВозвратКСтарту(СЭкрана, Токен));
	Возврат Сводка;

КонецФункции

// Плашка ведёт к логу на половине «Уровни»: уровень правится там.
Функция ПлашкаУровня(Знач Узел)

	Возврат Кит.Плашка(Новый Структура("Текст, Вид, Адрес",
		Тексты.Шаблон("settings.hub.logs.lines.now.item", Узел.Имя, Узел.УровеньДействующий),
		?(Узел.УровеньСЭкрана <> Неопределено, "accent", ""), Дороги.УровниЛога(Узел.Имя)));

КонецФункции

Функция ВозвратКСтарту(Знач Имена, Знач Токен)

	Если Имена.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Форма(Дороги.Уровни(), Токен, "строкой")
		.Добавить(Кит.СкрытоеПоле(Форма.ИмяОперации(), Форма.ОперацияВозвратаЛогов())).Родитель()
		.Добавить(Кит.СкрытоеПоле(Форма.ИмяЛогов(), СтрСоединить(Имена, ","))).Родитель()
		.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер, Иконка",
			Тексты.Шаблон("settings.hub.logs.lines.back", Имена.Количество()), "вторичная", "малый",
			"история"))).Родитель();

КонецФункции

// Пустой список одного лога чаще значит «уровень не пускает» или «мимо памяти», а не «ничего не было».
Функция ТихийЛог(Знач Отобранные)

	Если Отобранные.Количество() <> 1 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;
	Узел = Отобранные[0];

	Если НЕ Узел.ВПамять Тогда
		Текст = Тексты.Шаблон("settings.hub.logs.lines.nomemory", Узел.Имя);
	ИначеЕсли Узел.УровеньДействующий <> "DEBUG" Тогда
		Текст = Тексты.Шаблон("settings.hub.logs.lines.quiet", Узел.Имя, Узел.УровеньДействующий);
	Иначе
		Возврат Кит.Ничего();
	КонецЕсли;

	Сноска = Кит.Примечание();
	Сноска.Добавить(Кит.Текст(Текст + " "));
	Сноска.Добавить(Ссылка(Дороги.УровниЛога(Узел.Имя), Тексты.Текст("settings.hub.logs.lines.quiet.link")));
	Возврат Сноска;

КонецФункции

// Строки не обновляются сами: момент снимка назван, а «Обновить» — обычная ссылка на тот же адрес.
Функция ЧтоПоказано(Знач Показано, Знач Отбор)

	Сноска = Кит.Примечание();
	Сноска.Добавить(Кит.Текст(Тексты.Шаблон("settings.hub.logs.lines.shown", Показано,
		Даты.Метка(ТекущаяУниверсальнаяДата())) + " "));
	Сноска.Добавить(Ссылка(Дороги.СтрокиСОтбором(Отборы.ПараметрыСтрок(Отбор)),
		Тексты.Текст("settings.hub.logs.lines.refresh")));
	Если Отбор.Активен Тогда
		Сноска.Добавить(Кит.Текст(" · "));
		Сноска.Добавить(Ссылка(Дороги.Строки(), Тексты.Текст("settings.hub.logs.lines.filter.reset")));
	КонецЕсли;
	Возврат Сноска;

КонецФункции

Функция ПустойСписок(Знач Строки, Знач Неизвестное)

	Если ЗначениеЗаполнено(Неизвестное) Тогда
		Возврат Примечания.Пусто(Неизвестное);
	ИначеЕсли Строки.Количество() > 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;
	Возврат Примечания.Пусто(Тексты.Текст("settings.hub.logs.lines.empty"));

КонецФункции

#КонецОбласти

#Область Лента

Функция ЗаписиЛенты(Знач Строки)

	Результат = Новый Массив();
	Для Каждого СтрокаЖурнала Из Строки Цикл
		Результат.Добавить(ЗаписьЛенты(СтрокаЖурнала));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Текст — ровно тот, что отдал пульт: экран не прячет и не раскрывает; имя лога ведёт к его уровню.
Функция ЗаписьЛенты(Знач СтрокаЖурнала)

	Запись = Новый Структура();
	Запись.Вставить("Время", Формат(СтрокаЖурнала.Время, "ДФ=HH:mm:ss") + "."
		+ Формат(СтрокаЖурнала.Миллисекунды, "ЧЦ=3; ЧВН=; ЧГ=0"));
	Запись.Вставить("Важность", Важность(СтрокаЖурнала.Уровень));
	Запись.Вставить("ПодписьВажности", СтрокаЖурнала.Уровень);
	Запись.Вставить("Источник", СтрокаЖурнала.Лог);
	Запись.Вставить("АдресИсточника", Дороги.УровниЛога(СтрокаЖурнала.Лог));
	Запись.Вставить("Текст", СтрокаЖурнала.Текст);
	Запись.Вставить("Метка", Лев(СтрокаЖурнала.Трасса, 8));
	Запись.Вставить("ПодсказкаМетки", ?(ЗначениеЗаполнено(СтрокаЖурнала.Трасса),
		Тексты.Шаблон("settings.hub.logs.lines.trace", СтрокаЖурнала.Трасса), ""));
	Возврат Запись;

КонецФункции

Функция Важность(Знач Уровень)

	Если Уровень = "DEBUG" Тогда
		Возврат "подробная";
	ИначеЕсли Уровень = "WARN" Тогда
		Возврат "предупреждение";
	ИначеЕсли Уровень = "ERROR" ИЛИ Уровень = "CRITICALERROR" Тогда
		Возврат "ошибка";
	КонецЕсли;
	Возврат "обычная";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Уровень, которого нет среди уровней пульта, отбором не становится.
Функция ОтборСИзвестнымУровнем(Знач Отбор)
	Если Пульт.Уровни().Найти(Отбор.Уровень) <> Неопределено Тогда
		Возврат Отбор;
	КонецЕсли;
	Возврат Отборы.ОтборСтрокСУровнем(Отбор, "");
КонецФункции

// Что показывает половина: пути и ветки для выбора, логи отбора, строки пульта либо почему их нет.
Функция СоставПоловины(Знач Отбор)

	Логи = Пульт.Логи();
	Пути = Пульт.Пути();
	Имена = ИменаОтбора(Отбор, Пути);

	Результат = Новый Структура();
	Результат.Вставить("Пути", Пути);
	Результат.Вставить("Ветки", Дерево.ПутиВеток(Логи));
	Результат.Вставить("Неизвестное", НеизвестноеВОтборе(Отбор, Имена, Результат.Ветки));
	Результат.Вставить("Отобранные", ЛогиПоИменам(Логи, ?(Имена = Неопределено, Новый Массив(), Имена)));
	Результат.Вставить("Строки", ?(ЗначениеЗаполнено(Результат.Неизвестное), Новый Массив(),
		Пульт.Хвост(ОтборПульта(Отбор, Имена))));
	Возврат Результат;

КонецФункции

// Заданы только поля, которые человек заполнил: незаданное пульт не сужает.
Функция ОтборПульта(Знач Отбор, Знач Имена)

	Результат = Новый Структура("Количество", 200);
	Если Имена.Количество() > 0 Тогда
		Результат.Вставить("Логи", Имена);
	КонецЕсли;
	Если ЗначениеЗаполнено(Отбор.Ветка) Тогда
		Результат.Вставить("Группа", Отбор.Ветка);
	КонецЕсли;
	Если ЗначениеЗаполнено(Отбор.Уровень) Тогда
		Результат.Вставить("УровеньНеНиже", Отбор.Уровень);
	КонецЕсли;
	Если ЗначениеЗаполнено(Отбор.Текст) Тогда
		Результат.Вставить("Содержит", Отбор.Текст);
	КонецЕсли;
	Если Отбор.ТолькоВажное Тогда
		Результат.Вставить("ТолькоВажное", Истина);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Путь без названных логов разворачивается в свои логи; незнакомый путь — Неопределено.
Функция ИменаОтбора(Знач Отбор, Знач Пути)

	Если Отбор.Логи.Количество() > 0 ИЛИ НЕ ЗначениеЗаполнено(Отбор.Путь) Тогда
		Возврат Отбор.Логи;
	КонецЕсли;

	Для Каждого Путь Из Пути Цикл
		Если Путь.Ключ = Отбор.Путь Тогда
			Возврат Путь.Логи;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Незнакомый путь либо ветка — это пустой список с объяснением, а не весь поток под видом отбора.
Функция НеизвестноеВОтборе(Знач Отбор, Знач Имена, Знач Ветки)

	Если Имена = Неопределено Тогда
		Возврат Тексты.Шаблон("settings.hub.logs.path.unknown", Отбор.Путь);
	ИначеЕсли ЗначениеЗаполнено(Отбор.Ветка) И Ветки.Найти(Отбор.Ветка) = Неопределено Тогда
		Возврат Тексты.Шаблон("settings.hub.logs.branch.unknown", Отбор.Ветка);
	КонецЕсли;
	Возврат "";

КонецФункции

// Описания отобранных логов в порядке отбора; незнакомое имя выпадает.
Функция ЛогиПоИменам(Знач Логи, Знач Имена)

	Результат = Новый Массив();
	Если Имена.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Известные = Новый Соответствие();
	Для Каждого Узел Из Логи Цикл
		Известные.Вставить(НРег(Узел.Имя), Узел);
	КонецЦикла;
	Для Каждого Имя Из Имена Цикл
		Узел = Известные.Получить(НРег(Имя));
		Если Узел <> Неопределено Тогда
			Результат.Добавить(Узел);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Вариант(Знач Значение, Знач Подпись)
	Возврат Новый Структура("Значение, Подпись", Значение, Подпись);
КонецФункции

Функция Ссылка(Знач Адрес, Знач Текст)
	Возврат Кит.Ссылка(Адрес).Добавить(Кит.Текст(Текст)).Родитель();
КонецФункции

Функция ЧислоСтрокой(Знач Число)
	Возврат Формат(Число, "ЧН=0; ЧГ=0");
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПультЖурнала") _Пульт,
	&Пластилин(Значение = "ДеревоЛогов") _Дерево,
	&Пластилин(Значение = "ОтборЛогов") _Отборы,
	&Пластилин(Значение = "НавигацияЛогов") _Дороги,
	&Пластилин(Значение = "ЛентаЗаписей") _Лента,
	&Пластилин(Значение = "ФормаДереваЛогов") _Форма,
	&Пластилин(Значение = "ПодписиПутей") _ПодписиПутей,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты,
	&Пластилин(Значение = "ПримечанияЭкрана") _Примечания) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Тексты = _Тексты;
	Пульт = _Пульт;
	Дерево = _Дерево;
	Отборы = _Отборы;
	Дороги = _Дороги;
	Лента = _Лента;
	Форма = _Форма;
	ПодписиПутей = _ПодписиПутей;
	Даты = _Даты;
	Примечания = _Примечания;

КонецПроцедуры
