// Правка логов с экрана: выбранное на экране «Логи» — в вызовы пульта журнала, сначала сужающие,
// потом расширяющие; о применённом и пропущенном экран говорит словами пульта, а не своим расчётом.

Перем Пульт;   // ПультЖурнала (наблюдаемость) — правки уровней и отправки
Перем Дерево;  // ДеревоЛогов (web-ui) — логи ветки, логи под отбором и их нынешнее состояние
Перем Форма;   // ФормаДереваЛогов (web-ui) — разбор формы дерева в правки
Перем Отказы;  // ОтказыПультаЖурнала (web-ui) — отказ пульта словами

#Область ПубличныйИнтерфейс

// Автор правки для журнала аудита: кто правит и с какого адреса.
//
// Параметры:
//  Логин - Строка - логин вошедшего администратора.
//  АдресКлиента - Строка - адрес клиента запроса.
//
// Возвращаемое значение:
//  Структура - Кто (Строка), АдресIP (Строка).
//
Функция АвторПравки(Знач Логин, Знач АдресКлиента) Экспорт
	Возврат Новый Структура("Кто, АдресIP", Строка(Логин), Строка(АдресКлиента));
КонецФункции

// Применяет правки формы дерева: уровни корня, веток и логов и отправку в коллектор.
// Ветка — это правка всех её логов под отбором; лог, названный в той же отправке отдельно,
// получает своё. Вызовы идут в порядке «сначала сужаем»: возврат к старту, выключение
// отправки и понижение уровней — раньше подъёма уровней и включения отправки.
//
// Параметры:
//  Присланное - Соответствие - разобранная форма дерева.
//  Отбор - Структура - результат ОтборЛогов.ОтборУровней: под ним ветка отдаёт свои логи.
//  Автор - Структура - см. АвторПравки.
//
// Возвращаемое значение:
//  Структура - Логи (Массив из Строка — логи, которые правка изменила, как их назвал пульт),
//              Пропущены (Массив из Строка — логи только для чтения, которых правка не коснулась),
//              Ветка (Строка — путь ветки, у которой открыть страницу), Отказ (Строка — отказ
//              пульта словами; "" — отказа не было). Сбой, который не отказ пульта, не прячется:
//              его увидит страница сбоя.
//
Функция ПрименитьДерево(Знач Присланное, Знач Отбор, Знач Автор) Экспорт

	Правки = Форма.Правки(Присланное);
	Срез = Дерево.Собрать(Отбор);
	Итог = НовыйИтог();
	Итог.Ветка = ВеткаПравки(Правки, Срез);

	ПрименитьПлан(ПланПравки(Правки, ЖеланияЛогов(Правки, Срез), Срез), Срез, Автор, Итог);
	Возврат Итог;

КонецФункции

// Один уровень всем логам под отбором одним вызовом; «как при старте» снимает с них заданное
// с экрана. Логи только для чтения уходят в тот же вызов: их пропускает и называет пульт.
//
// Параметры:
//  Уровень - Строка - уровень либо ФормаДереваЛогов.ВариантСтарта.
//  Отбор - Структура - результат ОтборЛогов.ОтборУровней.
//  Автор - Структура - см. АвторПравки.
//
// Возвращаемое значение:
//  Структура - см. ПрименитьДерево.
//
Функция ЗадатьНайденным(Знач Уровень, Знач Отбор, Знач Автор) Экспорт

	Срез = Дерево.Собрать(Отбор);
	Итог = НовыйИтог();
	Если НЕ ЗначениеЗаполнено(Уровень) Тогда
		Возврат Итог;
	КонецЕсли;

	Имена = Новый Массив();
	ДобавитьНовые(Имена, Срез.ИменаНайденных);
	ДобавитьНовые(Имена, Срез.ПропущенныеНайденные);

	План = Новый Массив();
	Если Уровень = Форма.ВариантСтарта() Тогда
		ДобавитьШаг(План, ВидВозврата(), Имена);
	Иначе
		ДобавитьШаг(План, ВидУровня(), Имена, Уровень);
	КонецЕсли;
	ПрименитьПлан(План, Срез, Автор, Итог);
	Возврат Итог;

КонецФункции

// Возвращает к старту названные логи: те, что смотрели на половине «Строки», либо те, что показал
// вопрос «Вернуть всё» (корень — его именем). Названное после показа не трогается.
//
// Параметры:
//  Имена - Массив из Строка - имена логов.
//  Автор - Структура - см. АвторПравки.
//
// Возвращаемое значение:
//  Структура - см. ПрименитьДерево.
//
Функция ВернутьЛоги(Знач Имена, Знач Автор) Экспорт

	Итог = НовыйИтог();
	Если Имена.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;

	Попытка
		Учесть(Итог, Пульт.ВернутьКСтарту(Имена, Автор.Кто, Автор.АдресIP));
	Исключение
		ОтказСловами(Итог, ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область План

// Уровень каждого лога: ветки сверху вниз, лог, названный отдельно, сильнее своей ветки.
Функция ЖеланияЛогов(Знач Правки, Знач Срез)

	Желания = Новый Соответствие();
	Для Каждого Правка Из ВеткиСверхуВниз(Правки.Ветки) Цикл
		Ветка = Дерево.ВеткаПоПути(Срез, Правка.Путь);
		Если Ветка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Имя Из Ветка.ИменаПравимых Цикл
			Желания.Вставить(Имя, Правка.Значение);
		КонецЦикла;
		Для Каждого Имя Из Ветка.ТолькоЧтения Цикл
			Желания.Вставить(Имя, Правка.Значение);
		КонецЦикла;
	КонецЦикла;
	Для Каждого Правка Из Правки.Логи Цикл
		Желания.Вставить(Правка.Имя, Правка.Значение);
	КонецЦикла;
	Возврат Желания;

КонецФункции

// Где откроется страница: первая правленая ветка, иначе ветка первого лога; "" — только корень.
Функция ВеткаПравки(Знач Правки, Знач Срез)

	Если Правки.Ветки.Количество() > 0 Тогда
		Возврат ВеткиСверхуВниз(Правки.Ветки)[0].Путь;
	ИначеЕсли Правки.Логи.Количество() > 0 Тогда
		Возврат Дерево.ВеткаЛога(Срез, Правки.Логи[0].Имя);
	ИначеЕсли Правки.Отправка.Количество() > 0 Тогда
		Возврат Дерево.ВеткаЛога(Срез, Правки.Отправка[0].Имя);
	КонецЕсли;
	Возврат "";

КонецФункции

// Возврат к старту первым: выбранное в той же отправке сильнее «как при старте» ветки.
Функция ПланПравки(Знач Правки, Знач Желания, Знач Срез)

	План = Новый Массив();

	КСтарту = ИменаСоЗначением(Желания, Форма.ВариантСтарта());
	Если Правки.Корень = Форма.ВариантСтарта() Тогда
		КСтарту.Добавить(Срез.Корень.Имя);
	КонецЕсли;
	ДобавитьШаг(План, ВидВозврата(), КСтарту);

	ДобавитьШаг(План, ВидОтправки(), ИменаОтправки(Правки.Отправка, Ложь), Ложь);
	ДобавитьСужающиеУровни(План, Правки.Корень, Желания, Срез);
	ДобавитьРасширяющиеУровни(План, Правки.Корень, Желания, Срез);
	ДобавитьШаг(План, ВидОтправки(), ИменаОтправки(Правки.Отправка, Истина), Истина);

	Возврат План;

КонецФункции

// Сужающие — уровни не подробнее того, с которым лог пишет сейчас.
Процедура ДобавитьСужающиеУровни(План, Знач Корень, Знач Желания, Знач Срез)
	ДобавитьУровни(План, Корень, Желания, Срез, Истина);
КонецПроцедуры

// Расширяющие — уровни подробнее того, с которым лог пишет сейчас.
Процедура ДобавитьРасширяющиеУровни(План, Знач Корень, Знач Желания, Знач Срез)
	ДобавитьУровни(План, Корень, Желания, Срез, Ложь);
КонецПроцедуры

Процедура ДобавитьУровни(План, Знач Корень, Знач Желания, Знач Срез, Знач Сужающие)

	Если ЗначениеЗаполнено(Корень) И Корень <> Форма.ВариантСтарта()
		И Сужает(Корень, Срез.Корень, Срез.Уровни) = Сужающие Тогда
		ДобавитьШаг(План, ВидУровняКорня(), ОдноИмя(Срез.Корень.Имя), Корень);
	КонецЕсли;

	Для Каждого Уровень Из ЗначенияУровней(Желания, Срез.Уровни) Цикл
		Имена = Новый Массив();
		Для Каждого Имя Из ИменаСоЗначением(Желания, Уровень) Цикл
			Если Сужает(Уровень, Срез.УзлыПоИмени.Получить(Имя), Срез.Уровни) = Сужающие Тогда
				Имена.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
		ДобавитьШаг(План, ВидУровня(), Имена, Уровень);
	КонецЦикла;

КонецПроцедуры

// Уровни желаний по порядку пульта; слово не из уровней — последним: его назовёт отказ пульта.
Функция ЗначенияУровней(Знач Желания, Знач Уровни)

	Результат = Новый Массив();
	Для Каждого Уровень Из Уровни Цикл
		Результат.Добавить(Уровень);
	КонецЦикла;
	Для Каждого КиЗ Из Желания Цикл
		Если КиЗ.Значение <> Форма.ВариантСтарта() И Результат.Найти(КиЗ.Значение) = Неопределено Тогда
			Результат.Добавить(КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Незнакомое пульту слово считается сужающим: вызов с ним уйдёт раньше расширяющих и получит отказ.
Функция Сужает(Знач Уровень, Знач Узел, Знач Уровни)
	Если Узел = Неопределено ИЛИ Уровни.Найти(Уровень) = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Уровни.Найти(Уровень) >= Уровни.Найти(Узел.УровеньДействующий);
КонецФункции

Функция ИменаОтправки(Знач Отправка, Знач Признак)
	Имена = Новый Массив();
	Для Каждого Правка Из Отправка Цикл
		Если Правка.Признак = Признак Тогда
			Имена.Добавить(Правка.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;
КонецФункции

Функция ИменаСоЗначением(Знач Желания, Знач Значение)
	Имена = Новый Массив();
	Для Каждого КиЗ Из Желания Цикл
		Если КиЗ.Значение = Значение Тогда
			Имена.Добавить(КиЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;
КонецФункции

Процедура ДобавитьШаг(План, Знач Вид, Знач Имена, Знач Значение = Неопределено)
	Если Имена.Количество() > 0 Тогда
		План.Добавить(Новый Структура("Вид, Имена, Значение", Вид, Имена, Значение));
	КонецЕсли;
КонецПроцедуры

Функция ВидВозврата()
	Возврат "возврат";
КонецФункции

Функция ВидОтправки()
	Возврат "отправка";
КонецФункции

Функция ВидУровня()
	Возврат "уровень";
КонецФункции

Функция ВидУровняКорня()
	Возврат "уровень-корня";
КонецФункции

#КонецОбласти

#Область Вызовы

// Шаг из одних логов только для чтения пульт не зовёт: он бы отказал, а пропущенное названо и так.
Процедура ПрименитьПлан(Знач План, Знач Срез, Знач Автор, Итог)

	Попытка
		Для Каждого Шаг Из План Цикл
			Если ТолькоЧтения(Шаг.Имена, Срез) Тогда
				ДобавитьНовые(Итог.Пропущены, Шаг.Имена);
			Иначе
				Учесть(Итог, Вызов(Шаг, Автор));
			КонецЕсли;
		КонецЦикла;
	Исключение
		ОтказСловами(Итог, ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Функция Вызов(Знач Шаг, Знач Автор)

	Если Шаг.Вид = ВидВозврата() Тогда
		Возврат Пульт.ВернутьКСтарту(Шаг.Имена, Автор.Кто, Автор.АдресIP);
	ИначеЕсли Шаг.Вид = ВидУровняКорня() Тогда
		Возврат Пульт.ЗадатьУровеньКорню(Шаг.Значение, Автор.Кто, Автор.АдресIP);
	ИначеЕсли Шаг.Вид = ВидУровня() Тогда
		Возврат Пульт.ЗадатьУровень(Шаг.Имена, Шаг.Значение, Автор.Кто, Автор.АдресIP);
	КонецЕсли;
	Возврат Пульт.ОтправлятьВOTel(Шаг.Имена, Шаг.Значение, Автор.Кто, Автор.АдресIP);

КонецФункции

Функция ТолькоЧтения(Знач Имена, Знач Срез)
	Для Каждого Имя Из Имена Цикл
		Узел = Срез.УзлыПоИмени.Получить(Имя);
		Если Узел = Неопределено ИЛИ НЕ Узел.ТолькоЧтение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Процедура Учесть(Итог, Знач Ответ)
	ДобавитьНовые(Итог.Логи, Ответ.Применено);
	ДобавитьНовые(Итог.Пропущены, Ответ.Пропущено);
КонецПроцедуры

Процедура ОтказСловами(Итог, Знач Ошибка)
	Итог.Отказ = Отказы.Словами(Ошибка.Описание);
	Если НЕ ЗначениеЗаполнено(Итог.Отказ) Тогда
		ВызватьИсключение Ошибка.Описание;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйИтог()
	Возврат Новый Структура("Логи, Пропущены, Ветка, Отказ", Новый Массив(), Новый Массив(), "", "");
КонецФункции

// Уровень ветки назначается раньше уровня вложенной: вложенная своих логов не отдаёт родителю.
Функция ВеткиСверхуВниз(Знач Ветки)

	Список = Новый СписокЗначений();
	Для Каждого Правка Из Ветки Цикл
		Список.Добавить(Правка, Формат(СтрЧислоВхождений(Правка.Путь, "/"), "ЧЦ=3; ЧВН=; ЧГ=0")
			+ Правка.Путь);
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	Возврат Список.ВыгрузитьЗначения();

КонецФункции

Процедура ДобавитьНовые(Куда, Знач Имена)
	Для Каждого Имя Из Имена Цикл
		Если Куда.Найти(Имя) = Неопределено Тогда
			Куда.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ОдноИмя(Знач Имя)
	Результат = Новый Массив();
	Результат.Добавить(Имя);
	Возврат Результат;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПультЖурнала") _Пульт,
	&Пластилин(Значение = "ДеревоЛогов") _Дерево,
	&Пластилин(Значение = "ФормаДереваЛогов") _Форма,
	&Пластилин(Значение = "ОтказыПультаЖурнала") _Отказы) Экспорт

	Пульт = _Пульт;
	Дерево = _Дерево;
	Форма = _Форма;
	Отказы = _Отказы;

КонецПроцедуры
