// Форма дерева логов: имена её полей и операций, скрытые поля «операция и отбор» и разбор
// присланного в правки. Правка — только поле, отличное от показанного («было»).

Перем РазборФормы;  // РазборФормы (web-ui) — поле формы
Перем Отборы;       // ОтборЛогов (web-ui) — параметры отбора, которые едут формой обратно
Перем Кит;          // Кит (кит) — скрытые поля формы

#Область Операции

// Имя поля операции.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяОперации() Экспорт
	Возврат "операция";
КонецФункции

// Применить уровни и отправку, выбранные в дереве.
//
// Возвращаемое значение:
//  Строка
//
Функция ОперацияДерева() Экспорт
	Возврат "дерево";
КонецФункции

// Один уровень всем логам под отбором.
//
// Возвращаемое значение:
//  Строка
//
Функция ОперацияНайденным() Экспорт
	Возврат "найденным";
КонецФункции

// Показать, что снимет «Вернуть всё как при старте», и спросить: сам вопрос ничего не снимает.
//
// Возвращаемое значение:
//  Строка
//
Функция ОперацияВозврата() Экспорт
	Возврат "к-старту";
КонецФункции

// Вернуть к старту то, что показал вопрос операции возврата, — ответ на него.
//
// Возвращаемое значение:
//  Строка
//
Функция ОперацияПодтверждённогоВозврата() Экспорт
	Возврат "вернуть-всё";
КонецФункции

// Вернуть к старту перечисленные логи — с половины «Строки», где их только что смотрели.
//
// Возвращаемое значение:
//  Строка
//
Функция ОперацияВозвратаЛогов() Экспорт
	Возврат "вернуть-логи";
КонецФункции

// Имя поля с именами логов через запятую в формах возврата: с половины «Строки» и в ответе
// на вопрос «Вернуть всё».
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяЛогов() Экспорт
	Возврат "логи";
КонецФункции

// Имя поля уровня в форме «всем под отбором».
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяУровняНайденным() Экспорт
	Возврат "уровень-найденным";
КонецФункции

// Имя кнопки формы дерева, которая раскрывает ветку, ничего не применяя; значение — путь
// ветки.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяРаскрытия() Экспорт
	Возврат "раскрыть";
КонецФункции

// Скрытые поля формы: операция и отбор, который правка сохраняет.
//
// Параметры:
//  Операция - Строка - значение поля операции.
//  Отбор - Структура - результат ОтборЛогов.ОтборУровней.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ОперацияИОтбор(Знач Операция, Знач Отбор) Экспорт

	Поля = Кит.Холст();
	Поля.Добавить(Кит.СкрытоеПоле(ИмяОперации(), Операция));
	Для Каждого Пара Из Отборы.ПараметрыУровней(Отбор) Цикл
		Поля.Добавить(Кит.СкрытоеПоле(Пара.Имя, Пара.Значение));
	КонецЦикла;
	Возврат Поля;

КонецФункции

#КонецОбласти

#Область ИменаПолей

// Имя поля уровня лога.
//
// Параметры:
//  ИмяЛога - Строка - имя лога.
//
// Возвращаемое значение:
//  Строка
//
Функция ПолеУровня(Знач ИмяЛога) Экспорт
	Возврат ПрефиксУровня() + ИмяЛога;
КонецФункции

// Имя поля с уровнем лога, каким его показал экран.
//
// Параметры:
//  ИмяЛога - Строка - имя лога.
//
// Возвращаемое значение:
//  Строка
//
Функция ПолеПрежнегоУровня(Знач ИмяЛога) Экспорт
	Возврат "было|" + ИмяЛога;
КонецФункции

// Имя поля уровня корня.
//
// Возвращаемое значение:
//  Строка
//
Функция ПолеУровняКорня() Экспорт
	Возврат "уровень-корня";
КонецФункции

// Имя поля с уровнем корня, каким его показал экран.
//
// Возвращаемое значение:
//  Строка
//
Функция ПолеПрежнегоУровняКорня() Экспорт
	Возврат "было-корня";
КонецФункции

// Имя поля уровня всем логам ветки. Своего уровня у ветки нет: выбор ничего не хранит
// и отправляется только тогда, когда его поменяли.
//
// Параметры:
//  Путь - Строка - путь группы ветки.
//
// Возвращаемое значение:
//  Строка
//
Функция ПолеВетки(Знач Путь) Экспорт
	Возврат ПрефиксВетки() + Путь;
КонецФункции

// Имя поля тумблера «в коллектор» лога либо корня.
//
// Параметры:
//  ИмяЛога - Строка - имя лога; у корня — его имя из пульта.
//
// Возвращаемое значение:
//  Строка
//
Функция ПолеOTel(Знач ИмяЛога) Экспорт
	Возврат ПрефиксOTel() + ИмяЛога;
КонецФункции

// Имя поля с тумблером «в коллектор», каким его показал экран.
//
// Параметры:
//  ИмяЛога - Строка - имя лога; у корня — его имя из пульта.
//
// Возвращаемое значение:
//  Строка
//
Функция ПолеПрежнегоOTel(Знач ИмяЛога) Экспорт
	Возврат "было-otel|" + ИмяЛога;
КонецФункции

// Значение тумблера «в коллектор», когда он включён.
//
// Возвращаемое значение:
//  Строка
//
Функция ЗначениеВключено() Экспорт
	Возврат "1";
КонецФункции

// Значение выбора уровня «как при старте»: снять заданное с экрана.
//
// Возвращаемое значение:
//  Строка
//
Функция ВариантСтарта() Экспорт
	Возврат "start";
КонецФункции

#КонецОбласти

#Область Разбор

// Правки, которые прислала форма дерева: только поля, чьё значение отличается от показанного.
//
// Параметры:
//  Форма - Соответствие - разобранная форма запроса.
//
// Возвращаемое значение:
//  Структура - Корень (Строка: уровень, ВариантСтарта либо "" — корень не трогали),
//              Ветки (Массив из Структура - Путь, Значение), Логи (Массив из Структура - Имя,
//              Значение), Отправка (Массив из Структура - Имя, Признак). Значение — уровень
//              либо ВариантСтарта.
//
Функция Правки(Знач Форма) Экспорт

	Результат = Новый Структура("Корень, Ветки, Логи, Отправка", "", Новый Массив(), Новый Массив(),
		Новый Массив());

	Корень = РазборФормы.Поле(Форма, ПолеУровняКорня());
	Если ЗначениеЗаполнено(Корень) И Корень <> РазборФормы.Поле(Форма, ПолеПрежнегоУровняКорня()) Тогда
		Результат.Корень = Корень;
	КонецЕсли;

	Для Каждого КиЗ Из Форма Цикл

		Имя = Строка(КиЗ.Ключ);
		Значение = РазборФормы.Поле(Форма, Имя);

		Если СтрНачинаетсяС(Имя, ПрефиксВетки()) И ЗначениеЗаполнено(Значение) Тогда
			Результат.Ветки.Добавить(Новый Структура("Путь, Значение", Хвост(Имя, ПрефиксВетки()), Значение));
		ИначеЕсли СтрНачинаетсяС(Имя, ПрефиксУровня()) Тогда
			ИмяЛога = Хвост(Имя, ПрефиксУровня());
			Если ЗначениеЗаполнено(Значение) И Значение <> РазборФормы.Поле(Форма, ПолеПрежнегоУровня(ИмяЛога)) Тогда
				Результат.Логи.Добавить(Новый Структура("Имя, Значение", ИмяЛога, Значение));
			КонецЕсли;
		ИначеЕсли СтрНачинаетсяС(Имя, ПрефиксOTel()) Тогда
			ИмяЛога = Хвост(Имя, ПрефиксOTel());
			Если Значение <> РазборФормы.Поле(Форма, ПолеПрежнегоOTel(ИмяЛога)) Тогда
				Результат.Отправка.Добавить(Новый Структура("Имя, Признак", ИмяЛога,
					Значение = ЗначениеВключено()));
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Допустимо ли значение выбора уровня: уровень пульта либо «как при старте».
//
// Параметры:
//  Значение - Строка - присланное значение.
//  Уровни - Массив из Строка - уровни пульта.
//
// Возвращаемое значение:
//  Булево
//
Функция ДопустимыйУровень(Знач Значение, Знач Уровни) Экспорт
	Возврат Значение = ВариантСтарта() ИЛИ Уровни.Найти(Значение) <> Неопределено;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрефиксУровня()
	Возврат "уровень|";
КонецФункции

Функция ПрефиксВетки()
	Возврат "ветка|";
КонецФункции

Функция ПрефиксOTel()
	Возврат "otel|";
КонецФункции

Функция Хвост(Знач Имя, Знач Префикс)
	Возврат Сред(Имя, СтрДлина(Префикс) + 1);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ОтборЛогов") _Отборы,
	&Пластилин(Значение = "Кит") _Кит) Экспорт

	РазборФормы = _РазборФормы;
	Отборы = _Отборы;
	Кит = _Кит;

КонецПроцедуры
