// ⚠ Кандидат в кит: «лента записей» — плотный список событий со временем, важностью, источником
// и текстом; собрана элементами кита с признаками `[data-feed]`, которые оформляет лист хаба.

Перем Кит;  // Кит (кит) — фабрика элементов экрана

// Список записей ленты.
//
// Параметры:
//  Записи - Массив из Структура - Время (Строка), Важность («подробная» | «обычная»
//           | «предупреждение» | «ошибка»), ПодписьВажности (Строка), Источник (Строка),
//           АдресИсточника (Строка; пусто — источник без ссылки), Текст (Строка), Метка
//           (Строка — короткое машинное значение: трасса, номер; пусто — нет), ПодсказкаМетки.
//
// Возвращаемое значение:
//  ЭлементЭкрана - пустой холст, когда записей нет.
//
Функция Список(Знач Записи) Экспорт

	Если Записи.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Лента = Кит.Список().Признак("feed", "");
	Для Каждого Запись Из Записи Цикл
		Лента.Добавить(ЗаписьЛенты(Запись));
	КонецЦикла;
	Возврат Лента;

КонецФункции

Функция ЗаписьЛенты(Знач Запись)

	Пункт = Кит.Пункт().Признак("feed-severity", ВидВажности(Запись.Важность));
	Пункт.Добавить(Кит.Код(Запись.Время, "приглушённый").Признак("feed-time", ""));
	Пункт.Добавить(Кит.Надпись().Признак("feed-level", "").Добавить(Кит.Текст(Запись.ПодписьВажности)).Родитель());
	Пункт.Добавить(Источник(Запись));
	Пункт.Добавить(Кит.Надпись().Признак("feed-text", "").Добавить(Кит.Текст(Запись.Текст)).Родитель());
	Пункт.Добавить(Метка(Запись));
	Возврат Пункт;

КонецФункции

Функция Источник(Знач Запись)

	Если НЕ ЗначениеЗаполнено(Запись.АдресИсточника) Тогда
		Возврат Кит.Надпись().Признак("feed-source", "").Добавить(Кит.Текст(Запись.Источник)).Родитель();
	КонецЕсли;

	Возврат Кит.Ссылка(Запись.АдресИсточника).Признак("feed-source", "")
		.Добавить(Кит.Текст(Запись.Источник)).Родитель();

КонецФункции

Функция Метка(Знач Запись)

	Если НЕ ЗначениеЗаполнено(Запись.Метка) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Код(Запись.Метка, "приглушённый").Признак("feed-mark", "")
		.Подсказка(Запись.ПодсказкаМетки);

КонецФункции

// Признак латиницей выбирает цвет полосы; слово важности на экране от него не зависит.
Функция ВидВажности(Знач Важность)

	Если Важность = "подробная" Тогда
		Возврат "detail";
	ИначеЕсли Важность = "предупреждение" Тогда
		Возврат "warn";
	ИначеЕсли Важность = "ошибка" Тогда
		Возврат "error";
	КонецЕсли;
	Возврат "normal";

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "Кит") _Кит) Экспорт
	Кит = _Кит;
КонецПроцедуры
