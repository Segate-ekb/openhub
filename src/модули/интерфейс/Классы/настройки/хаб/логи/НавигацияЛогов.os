// Дороги экрана «Логи»: адреса половин «Уровни» и «Строки», переходы «лог → его строки»
// и «строка → её лог», якорь ветки и вкладки между половинами.

Перем Дом;        // ДомХаба (web-ui) — адрес раздела
Перем Отборы;     // ОтборЛогов (web-ui) — имена параметров адреса
Перем Кит;        // Кит (кит) — фабрика элементов экрана
Перем Тексты;     // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область Адреса

// Ключ раздела в доме «Хаб».
//
// Возвращаемое значение:
//  Строка
//
Функция КлючРаздела() Экспорт
	Возврат "logs";
КонецФункции

// Адрес половины «Уровни».
//
// Возвращаемое значение:
//  Строка
//
Функция Уровни() Экспорт
	Возврат Дом.АдресРаздела(КлючРаздела());
КонецФункции

// Адрес половины «Строки».
//
// Возвращаемое значение:
//  Строка
//
Функция Строки() Экспорт
	Возврат Уровни() + "/lines";
КонецФункции

// Половина «Уровни», суженная до одного лога: из строки журнала — к её логу.
//
// Параметры:
//  ИмяЛога - Строка - имя лога.
//
// Возвращаемое значение:
//  Строка
//
Функция УровниЛога(Знач ИмяЛога) Экспорт
	Возврат СПарами(Уровни(), ОднаПара(Отборы.ИмяПоиска(), ИмяЛога));
КонецФункции

// Половина «Уровни» с отбором.
//
// Параметры:
//  Пары - Массив из Структура - Имя, Значение: параметры отбора; пустые в адрес не попадают.
//
// Возвращаемое значение:
//  Строка
//
Функция УровниСОтбором(Знач Пары) Экспорт
	Возврат СПарами(Уровни(), Пары);
КонецФункции

// Половина «Уровни» с отбором, открытая у ветки: после правки человек видит то место,
// где правил.
//
// Параметры:
//  Пары - Массив из Структура - Имя, Значение: параметры отбора.
//  Ветка - Строка - путь группы ветки; пусто — страница открывается сверху.
//
// Возвращаемое значение:
//  Строка
//
Функция УровниУВетки(Знач Пары, Знач Ветка) Экспорт

	Адрес = УровниСОтбором(Пары);
	Если НЕ ЗначениеЗаполнено(Ветка) Тогда
		Возврат Адрес;
	КонецЕсли;
	Возврат Адрес + "#" + КодироватьСтроку(ЯкорьВетки(Ветка), СпособКодированияСтроки.КодировкаURL);

КонецФункции

// Половина «Строки» с отбором: пустые параметры в адрес не попадают.
//
// Параметры:
//  Пары - Массив из Структура - Имя, Значение: параметры отбора.
//
// Возвращаемое значение:
//  Строка
//
Функция СтрокиСОтбором(Знач Пары) Экспорт
	Возврат СПарами(Строки(), Пары);
КонецФункции

// Половина «Строки» нескольких логов: из дерева — к их строкам.
//
// Параметры:
//  Имена - Массив из Строка - имена логов.
//
// Возвращаемое значение:
//  Строка
//
Функция СтрокиЛогов(Знач Имена) Экспорт
	Возврат СПарами(Строки(), ОднаПара(Отборы.ИмяЛогов(), СтрСоединить(Имена, ",")));
КонецФункции

// Строки одного пути.
//
// Параметры:
//  Ключ - Строка - ключ пути.
//
// Возвращаемое значение:
//  Строка
//
Функция СтрокиПути(Знач Ключ) Экспорт
	Возврат СПарами(Строки(), ОднаПара(Отборы.ИмяПути(), Ключ));
КонецФункции

// Строки одной ветки.
//
// Параметры:
//  Ветка - Строка - путь группы ветки.
//
// Возвращаемое значение:
//  Строка
//
Функция СтрокиВетки(Знач Ветка) Экспорт
	Возврат СПарами(Строки(), ОднаПара(Отборы.ИмяВетки(), Ветка));
КонецФункции

// Якорь секции дерева логов: на него открывается страница, которую форма дерева отдаёт сразу,
// без перенаправления, — после раскрытия ветки и после отказа.
//
// Возвращаемое значение:
//  Строка - значение атрибута id.
//
Функция ЯкорьДерева() Экспорт
	Возврат "logs-tree";
КонецФункции

// Половина «Уровни», открытая у дерева: адрес формы дерева и адрес раскрытия ветки,
// у которой нет своего выбора уровня.
//
// Параметры:
//  Пары - Массив из Структура - Имя, Значение: параметры отбора (необязательный: без них —
//         адрес формы дерева).
//
// Возвращаемое значение:
//  Строка
//
Функция УровниУДерева(Знач Пары = Неопределено) Экспорт
	Если Пары = Неопределено Тогда
		Возврат Уровни() + "#" + ЯкорьДерева();
	КонецЕсли;
	Возврат УровниСОтбором(Пары) + "#" + ЯкорьДерева();
КонецФункции

// Якорь ветки в дереве: им помечен выбор уровня ветки, и на него открывается страница
// после правки.
//
// Параметры:
//  Ветка - Строка - путь группы ветки.
//
// Возвращаемое значение:
//  Строка - значение атрибута id.
//
Функция ЯкорьВетки(Знач Ветка) Экспорт
	Возврат "logs-" + СтрЗаменить(Ветка, "/", "-");
КонецФункции

#КонецОбласти

#Область Вкладки

// Вкладки экрана: у каждой половины свой адрес, и «назад» в браузере возвращает к ней.
//
// Параметры:
//  Активная - Строка - «уровни» | «строки».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Вкладки(Знач Активная) Экспорт

	Список = Новый Массив();
	Список.Добавить(Вкладка(Тексты.Текст("settings.hub.logs.tab.levels"), Уровни(),
		Активная = "уровни", "стопка"));
	Список.Добавить(Вкладка(Тексты.Текст("settings.hub.logs.tab.lines"), Строки(),
		Активная = "строки", "история"));

	Возврат Кит.Табы(Новый Структура("Вкладки, Заголовок", Список,
		Тексты.Текст("settings.hub.logs.tab.label")));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Вкладка(Знач Подпись, Знач Адрес, Знач Активна, Знач Иконка)
	Возврат Новый Структура("Подпись, Адрес, Активна, Иконка", Подпись, Адрес, Активна, Иконка);
КонецФункции

// Адрес раздела параметров не несёт, поэтому пары ставятся склейкой, а не разбором адреса.
Функция СПарами(Знач Адрес, Знач Пары)

	Части = Новый Массив();
	Для Каждого Пара Из Пары Цикл
		Если ЗначениеЗаполнено(Пара.Значение) Тогда
			Части.Добавить(КодироватьСтроку(Пара.Имя, СпособКодированияСтроки.КодировкаURL) + "="
				+ КодироватьСтроку(Пара.Значение, СпособКодированияСтроки.КодировкаURL));
		КонецЕсли;
	КонецЦикла;
	Возврат ?(Части.Количество() = 0, Адрес, Адрес + "?" + СтрСоединить(Части, "&"));

КонецФункции

Функция ОднаПара(Знач Имя, Знач Значение)
	Результат = Новый Массив();
	Результат.Добавить(Отборы.Пара(Имя, Значение));
	Возврат Результат;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ОтборЛогов") _Отборы,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Дом = _Дом;
	Отборы = _Отборы;
	Кит = _Кит;
	Тексты = _Тексты;

КонецПроцедуры
