// Витрина настроек хаба — желудь модуля web-ui: секции раздела дома «Хаб» из карточек реестра.

Перем Настройки;         // СервисНастроек (настройки) — карточки и источники значений
Перем Разделы;           // РазделыНастроекХаба (настройки) — раздел ключа
Перем Раскладка;         // РаскладкаНастроекХаба (web-ui) — ярус настройки и кат раздела
Перем Поля;              // ПоляНастроек (web-ui) — карточка в разметке
Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — заготовка секции
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Бланки;            // БланкРаздела (web-ui) — адрес и токен раздела, формы на них

#Область ПубличныйИнтерфейс

// Раздел дома «Хаб», в котором показывается настройка.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - ключ раздела дома («identity», «login», …).
//
Функция РазделКлюча(Знач Ключ) Экспорт
	Возврат Разделы.РазделКлюча(Ключ);
КонецФункции

// Ключ словаря для метки/подсказки настройки.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//  Роль - Строка - «label» либо «hint».
//
// Возвращаемое значение:
//  Строка - ключ словаря вида «settings.key.oshub-storage-root.label».
//
Функция КлючТекста(Знач Ключ, Знач Роль) Экспорт
	Возврат Поля.КлючТекста(Ключ, Роль);
КонецФункции

// Карточки настроек раздела в порядке реестра.
//
// Параметры:
//  Раздел - Строка - ключ раздела дома.
//
// Возвращаемое значение:
//  Массив из Структура - карточки СервисНастроек.
//
Функция КарточкиРаздела(Знач Раздел) Экспорт

	Результат = Новый Массив();
	Для Каждого Настройка Из Настройки.Карточки() Цикл
		Если РазделКлюча(Настройка.Ключ) = Раздел Тогда
			Результат.Добавить(Настройка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Редактируемые карточки раздела (прикладные и не форсированные конфигом).
//
// Параметры:
//  Раздел - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Массив - карточки, доступные правке из UI.
//
Функция РедактируемыеРаздела(Знач Раздел) Экспорт

	Результат = Новый Массив();
	Для Каждого Настройка Из КарточкиРаздела(Раздел) Цикл
		Если Настройка.Редактируемая Тогда
			Результат.Добавить(Настройка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Карточки раздела, которым место на экране: прикладные — и правимые, и занятые
// конфигурацией. Значение инсталляции сюда не попадает: чужая ручка не показывается.
//
// Параметры:
//  Раздел - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Массив - карточки, которые печатает экран раздела.
//
Функция ПоказываемыеРаздела(Знач Раздел) Экспорт

	Результат = Новый Массив();
	Для Каждого Настройка Из КарточкиРаздела(Раздел) Цикл
		Если Настройка.Редактируемая ИЛИ Настройка.Форсирована Тогда
			Результат.Добавить(Настройка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Принимает ли раздел POST: только если в нём есть хоть одно редактируемое значение.
//
// Параметры:
//  Раздел - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Булево - принимает ли раздел POST.
//
Функция ПринимаетИзменения(Знач Раздел) Экспорт
	Возврат РедактируемыеРаздела(Раздел).Количество() > 0;
КонецФункции

// Имя поля формы для настройки — одна точка на рендер и на разбор.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - имя поля формы для настройки.
//
Функция ИмяПоля(Знач Ключ) Экспорт
	Возврат Поля.ИмяПоля(Ключ);
КонецФункции

// Имя скрытого поля с операцией раздела («» — сохранение, «сбросить» — уборка записи).
//
// Возвращаемое значение:
//  Строка - имя скрытого поля с операцией раздела.
//
Функция ИмяПоляОперации() Экспорт
	Возврат Поля.ИмяПоляОперации();
КонецФункции

// Имя скрытого поля с ключом настройки (операция «сбросить»).
//
// Возвращаемое значение:
//  Строка - имя скрытого поля с ключом настройки.
//
Функция ИмяПоляКлюча() Экспорт
	Возврат Поля.ИмяПоляКлюча();
КонецФункции

// Значение операции «сбросить введённое руками значение».
//
// Возвращаемое значение:
//  Строка - значение операции «сбросить введённое руками значение».
//
Функция ОперацияСброса() Экспорт
	Возврат Поля.ОперацияСброса();
КонецФункции

// Значение тумблера «включено» (его же читает РазборФормы.Флажок).
//
// Возвращаемое значение:
//  Строка - значение тумблера «включено».
//
Функция ЗначениеВключено() Экспорт
	Возврат Поля.ЗначениеВключено();
КонецФункции

// Действующее значение в форме, пригодной для сравнения с вводом: неизменённое не пишется.
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//
// Возвращаемое значение:
//  Строка - действующее значение в форме, пригодной для сравнения с вводом.
//
Функция ЗначениеДляСравнения(Знач Карточка) Экспорт
	Возврат Поля.ЗначениеДляСравнения(Карточка);
КонецФункции

// Человеческая метка настройки из словаря.
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//
// Возвращаемое значение:
//  Строка - человеческая метка настройки из словаря.
//
Функция Метка(Знач Карточка) Экспорт
	Возврат Поля.Метка(Карточка);
КонецФункции

// Секции раздела над катом: правка политик и порогов.
//
// Параметры:
//  Раздел - Строка - ключ раздела дома.
//  Бланк - Структура - бланк раздела (БланкРаздела): адрес форм и токен сессии.
//
// Возвращаемое значение:
//  Массив - описания секций.
//
Функция СекцииПолитики(Знач Раздел, Знач Бланк) Экспорт

	Результат = Новый Массив();

	Голова = Раскладка.Разложить(ПоказываемыеРаздела(Раздел)).Голова;
	Если Голова.Количество() > 0 Тогда
		Результат.Добавить(СекцияПравки(Голова, Бланк));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Секции раздела под катом: тонкие крутилки и уборка введённого руками.
//
// Параметры:
//  Раздел - Строка - ключ раздела дома.
//  Бланк - Структура - бланк раздела (БланкРаздела): адрес форм и токен сессии.
//
// Возвращаемое значение:
//  Массив - описания секций.
//
Функция СекцииХвоста(Знач Раздел, Знач Бланк) Экспорт

	Результат = Новый Массив();

	Хвост = Раскладка.Разложить(ПоказываемыеРаздела(Раздел)).Хвост;
	Если Хвост.Количество() > 0 Тогда
		Результат.Добавить(СекцияТонких(Хвост, Бланк));
	КонецЕсли;

	ИзБазы = Новый Массив();
	Для Каждого Настройка Из КарточкиРаздела(Раздел) Цикл
		Если Настройка.Редактируемая И Настройка.Источник = "база" Тогда
			ИзБазы.Добавить(Настройка);
		КонецЕсли;
	КонецЦикла;

	Если ИзБазы.Количество() > 0 Тогда
		Результат.Добавить(СекцияСброса(ИзБазы, Бланк));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Секции раздела целиком: над катом, затем под катом; первой дано имя раздела.
//
// Параметры:
//  Раздел - Строка - ключ раздела дома.
//  Подпись - Строка - название раздела (из дерева навигации дома).
//  Лид - Строка - пояснение раздела ("" — оставить пояснение секции).
//  Бланк - Структура - бланк раздела (БланкРаздела): адрес форм и токен сессии.
//
// Возвращаемое значение:
//  Массив - описания секций.
//
Функция Секции(Знач Раздел, Знач Подпись, Знач Лид, Знач Бланк) Экспорт

	Результат = СекцииПолитики(Раздел, Бланк);
	Для Каждого Секция Из СекцииХвоста(Раздел, Бланк) Цикл
		Результат.Добавить(Секция);
	КонецЦикла;

	Озаглавить(Результат, Подпись, Лид);

	Возврат Результат;

КонецФункции

// Даёт первой секции экрана его собственное имя и пояснение.
//
// Параметры:
//  Секции - Массив - описания секций (изменяется).
//  Подпись - Строка - название раздела.
//  Лид - Строка - пояснение раздела ("" — оставить пояснение секции).
//
Процедура Озаглавить(Секции, Знач Подпись, Знач Лид) Экспорт

	Если Секции.Количество() = 0 ИЛИ НЕ ЗначениеЗаполнено(Подпись) Тогда
		Возврат;
	КонецЕсли;

	Первая = Секции[0];
	Первая.Заголовок = Подпись;
	Если ЗначениеЗаполнено(Лид) Тогда
		// прежнее пояснение секции не пропадает: оно уходит первой строкой её тела
		Первая.Тело = Кит.Примечание(Первая.Пояснение).Рендер() + Первая.Тело;
		Первая.Пояснение = Лид;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Секции

// Своя <form>, свой CSRF, своя панель — если править в секции есть что.
Функция СекцияПравки(Знач Карточки, Знач Бланк)

	// заголовок пуст намеренно: имя секции даёт сам раздел (Озаглавить)
	Возврат ФормаЗначений("", Тексты.Текст("settings.values.editable.lead"),
		Карточки, Бланк, "шестерёнка");

КонецФункции

// Тонкие крутилки раздела: те же поля, но отдельной секцией — её и прячет кат.
Функция СекцияТонких(Знач Карточки, Знач Бланк)

	Возврат ФормаЗначений(Тексты.Текст("settings.hub.fine.title"),
		Тексты.Текст("settings.hub.fine.lead"), Карточки, Бланк, "палочка");

КонецФункции

Функция ФормаЗначений(Знач Заголовок, Знач Пояснение, Знач Карточки, Знач Бланк,
	Знач Иконка)

	Значения = Кит.Холст();
	ЕстьПравка = Ложь;
	Для Каждого Настройка Из Карточки Цикл
		Значения.Добавить(?(Настройка.Редактируемая,
			Поля.ПолеПравки(Настройка), Поля.ПолеЗанятое(Настройка)));
		Значения.Добавить(Поля.СтрокаИсточника(Настройка));
		ЕстьПравка = ЕстьПравка ИЛИ Настройка.Редактируемая;
	КонецЦикла;

	Секция = РендерерНастроек.Секция(Заголовок,
		?(ЕстьПравка, Пояснение, Тексты.Текст("settings.values.occupied.lead")), Значения.Рендер());
	Секция.Иконка = Иконка;
	// секция, где править нечего, формой не притворяется: слать ей нечего и кнопка солгала бы
	Если ЕстьПравка Тогда
		Секция.Действие = Бланки.Адрес(Бланк);
		Секция.Токен = Бланк.Токен;
		Секция.ПояснениеПанели = Тексты.Текст("settings.values.editable.note");
	КонецЕсли;
	Возврат Секция;

КонецФункции

// Сброс введённых руками значений: у каждого своя форма — вложенных форм в HTML не бывает.
Функция СекцияСброса(Знач Карточки, Знач Бланк)

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.values.reset.title"),
		Тексты.Текст("settings.values.reset.lead"),
		ТаблицаВведённого(Карточки, Бланк).Рендер());
	Секция.Иконка = "история";
	Возврат Секция;

КонецФункции

Функция ТаблицаВведённого(Знач Карточки, Знач Бланк)

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.values.reset.col.setting")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.values.reset.col.value")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.values.reset.col.action")));

	Для Каждого Настройка Из Карточки Цикл
		Таблица.Добавить(ЗаписьВведённого(Настройка, Бланк));
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция ЗаписьВведённого(Знач Настройка, Знач Бланк)

	Запись = Кит.Запись();
	Запись.Добавить(Ячейка(Кит.Текст(Поля.Метка(Настройка))));
	Запись.Добавить(Ячейка(Кит.Код(Поля.ЗначениеТекстом(Настройка))));
	Запись.Добавить(Ячейка(ФормаСброса(Бланк, Настройка.Ключ)));
	Возврат Запись;

КонецФункции

Функция ФормаСброса(Знач Бланк, Знач Ключ)

	Форма = Бланки.Форма(Бланк);
	Форма.Добавить(Кит.СкрытоеПоле(ИмяПоляОперации(), ОперацияСброса()));
	Форма.Добавить(Кит.СкрытоеПоле(ИмяПоляКлюча(), Ключ));
	Форма.Добавить(КнопкаСброса());
	Возврат Форма;

КонецФункции

Функция КнопкаСброса()

	Возврат Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Тексты.Текст("settings.values.reset.button"), "вторичная", "малый"));

КонецФункции

Функция Ячейка(Знач Элемент)

	Результат = Кит.Ячейка();
	Результат.Добавить(Элемент);
	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "РазделыНастроекХаба") _Разделы,
	&Пластилин(Значение = "РаскладкаНастроекХаба") _Раскладка,
	&Пластилин(Значение = "ПоляНастроек") _Поля,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "БланкРаздела") _Бланки) Экспорт

	Настройки = _Настройки;
	Разделы = _Разделы;
	Раскладка = _Раскладка;
	Поля = _Поля;
	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Тексты = _Тексты;
	Бланки = _Бланки;

КонецПроцедуры
