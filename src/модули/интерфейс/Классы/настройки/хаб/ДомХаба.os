// Дом настроек «Хаб» — желудь модуля web-ui.

Перем Тексты;     // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Каталог;    // КаталогРазделов (web-ui)
Перем Описания;   // Массив описаний разделов
Перем Лиды;       // Соответствие: ключ раздела -> его пояснение
Перем Преемники;  // Соответствие: упразднённый ключ раздела -> ключ, в который он влился
Перем Живые;      // Соответствие: упразднённый ключ -> подпись экрана, пока живущего на прежнем адресе
Перем Вложенные;  // Соответствие: ключ блока без своего пункта дерева -> ключ хозяйского раздела
Перем ОписанияВложенных; // Массив описаний таких блоков — их подписи

// Ключ дома.
//
// Возвращаемое значение:
//  Строка - ключ дома.
//
Функция Ключ() Экспорт
	Возврат "hub";
КонецФункции

// Базовый адрес дома.
//
// Возвращаемое значение:
//  Строка - базовый адрес дома.
//
Функция БазовыйАдрес() Экспорт
	Возврат "/hub/settings";
КонецФункции

// Раздел по умолчанию.
//
// Возвращаемое значение:
//  Строка - раздел по умолчанию.
//
Функция РазделПоУмолчанию() Экспорт
	Возврат "identity";
КонецФункции

// Адрес раздела дома.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - адрес раздела дома.
//
Функция АдресРаздела(Знач Ключ) Экспорт
	Возврат Каталог.Адрес(БазовыйАдрес(), Ключ);
КонецФункции

// Разделы дома для дерева навигации.
//
// Параметры:
//  Активный - Строка - ключ активного раздела.
//
// Возвращаемое значение:
//  Массив - разделы дома для дерева навигации.
//
Функция Разделы(Знач Активный) Экспорт
	Возврат Каталог.Разделы(БазовыйАдрес(), Описания, Действующий(Активный));
КонецФункции

// Есть ли раздел с таким ключом.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Булево - есть ли раздел с таким ключом.
//
Функция ЕстьРаздел(Знач Ключ) Экспорт
	Возврат Каталог.Содержит(Описания, Ключ) ИЛИ ЗначениеЗаполнено(Хозяин(Ключ));
КонецФункции

// Раздел, чьи настройки живут на чужом экране: свой адрес у него есть (форма постится
// на него), а пункта в дереве нет — чтение его адреса уводит к хозяину.
//
// Параметры:
//  Ключ - Строка - ключ блока.
//
// Возвращаемое значение:
//  Строка - ключ хозяйского раздела либо "" — блок самостоятельный.
//
Функция Хозяин(Знач Ключ) Экспорт

	Найдено = Вложенные.Получить(НРег(СокрЛП(Строка(Ключ))));
	Возврат ?(Найдено = Неопределено, "", Найдено);

КонецФункции

// Подпись раздела.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - подпись раздела.
//
Функция ПодписьРаздела(Знач Ключ) Экспорт

	Норм = НРег(СокрЛП(Строка(Ключ)));
	Своя = Живые.Получить(Норм);
	Если Своя <> Неопределено Тогда
		Возврат Своя;
	КонецЕсли;
	Если ЗначениеЗаполнено(Хозяин(Норм)) Тогда
		Возврат Каталог.Подпись(ОписанияВложенных, Норм);
	КонецЕсли;
	Возврат Каталог.Подпись(Описания, Ключ);

КонецФункции

// Пояснение раздела под его заголовком.
//
// Параметры:
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Строка - пояснение раздела либо "" — раздел объясняет себя сам.
//
Функция ЛидРаздела(Знач Ключ) Экспорт

	Найдено = Лиды.Получить(НРег(СокрЛП(Строка(Ключ))));
	Возврат ?(Найдено = Неопределено, "", Найдено);

КонецФункции

// Раздел, в который влился упразднённый: адрес прежнего раздела не исчезает молча.
//
// Параметры:
//  Ключ - Строка - ключ упразднённого раздела.
//
// Возвращаемое значение:
//  Строка - ключ раздела-преемника либо "" — такого переезда нет.
//
Функция Преемник(Знач Ключ) Экспорт

	Найдено = Преемники.Получить(НРег(СокрЛП(Строка(Ключ))));
	Возврат ?(Найдено = Неопределено, "", Найдено);

КонецФункции

// Место слитого раздела в дереве — у его преемника: экран, который ещё живёт на прежнем
// адресе, обязан подсвечивать тот пункт, в который он влился, иначе возврата из него нет.
// Так же и у вложенного блока: его пункт — пункт хозяина.
Функция Действующий(Знач Ключ)

	Влился = Преемник(Ключ);
	Если ЗначениеЗаполнено(Влился) Тогда
		Возврат Влился;
	КонецЕсли;

	Хозяйский = Хозяин(Ключ);
	Возврат ?(ЗначениеЗаполнено(Хозяйский), Хозяйский, Ключ);

КонецФункции

// Экраны, которые пока живут на прежних адресах и ждут переезда в этот раздел.
//
// Параметры:
//  Ключ - Строка - ключ раздела-преемника.
//
// Возвращаемое значение:
//  Массив из Структура - Ключ, Подпись, Иконка описаний разделов, а также Адрес.
//
Функция ПрежниеЭкраны(Знач Ключ) Экспорт

	Результат = Новый Массив();

	Для Каждого КиЗ Из Живые Цикл
		Если Преемник(КиЗ.Ключ) <> НРег(СокрЛП(Строка(Ключ))) Тогда
			Продолжить;
		КонецЕсли;
		Экран = Каталог.Описание(КиЗ.Ключ, КиЗ.Значение, "ссылка");
		Экран.Вставить("Адрес", АдресРаздела(КиЗ.Ключ));
		Результат.Добавить(Экран);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ключи блоков, у которых нет своего пункта дерева: их настройки печатает хозяйский экран.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ВложенныеБлоки() Экспорт

	Результат = Новый Массив();
	Для Каждого КиЗ Из Вложенные Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Заголовок дома.
//
// Возвращаемое значение:
//  Строка - заголовок дома.
//
Функция Заголовок() Экспорт
	Возврат Тексты.Текст("settings.hub.title");
КонецФункции

// Пояснение дома.
//
// Возвращаемое значение:
//  Строка - пояснение дома.
//
Функция Пояснение() Экспорт
	Возврат Тексты.Текст("settings.hub.lead");
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаталогРазделов") _Каталог,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Каталог = _Каталог;
	Тексты = _Тексты;

	// Порядок разделов: кто мы → кто внутри → что внутри → как хаб говорит наружу →
	// что было и как живёт.
	Описания = Новый Массив();
	Описания.Добавить(Каталог.Описание("identity", Тексты.Текст("settings.hub.nav.identity"), "куб"));
	Описания.Добавить(Каталог.Описание("branding", Тексты.Текст("settings.hub.nav.branding"), "солнце"));
	Описания.Добавить(Каталог.Описание("login", Тексты.Текст("settings.hub.nav.login"), "замок"));
	Описания.Добавить(Каталог.Описание("providers", Тексты.Текст("settings.hub.nav.providers"), "ссылка"));
	Описания.Добавить(Каталог.Описание("password", Тексты.Текст("settings.hub.nav.password"), "подпись"));
	Описания.Добавить(Каталог.Описание("people", Тексты.Текст("settings.hub.nav.people"), "аккаунт"));
	Описания.Добавить(Каталог.Описание("pools", Тексты.Текст("settings.hub.nav.pools"), "куб"));
	Описания.Добавить(Каталог.Описание("legacy", Тексты.Текст("settings.hub.nav.legacy"), "история"));
	Описания.Добавить(Каталог.Описание("storage", Тексты.Текст("settings.hub.nav.storage"), "скачать"));
	Описания.Добавить(Каталог.Описание("trusted", Тексты.Текст("settings.hub.nav.trusted"), "ключ"));
	Описания.Добавить(Каталог.Описание("mail", Тексты.Текст("settings.hub.nav.mail"), "ссылка"));
	Описания.Добавить(Каталог.Описание("mirrors", Тексты.Текст("settings.hub.nav.mirrors"), "копировать"));
	Описания.Добавить(Каталог.Описание("webhooks", Тексты.Текст("settings.hub.nav.webhooks"), "стрелка"));
	Описания.Добавить(Каталог.Описание("proxy", Тексты.Текст("settings.hub.nav.proxy"), "стопка"));
	Описания.Добавить(Каталог.Описание("audit", Тексты.Текст("settings.hub.nav.audit"), "история"));
	Описания.Добавить(Каталог.Описание("maintenance", Тексты.Текст("settings.hub.nav.maintenance"), "шестерёнка"));

	// Пояснение раздела: раздел без записи объясняет себя пояснением своих секций.
	Лиды = Новый Соответствие();
	Лиды.Вставить("identity", Тексты.Текст("settings.hub.identity.lead"));
	Лиды.Вставить("branding", Тексты.Текст("settings.hub.branding.lead"));
	Лиды.Вставить("login", Тексты.Текст("settings.hub.login.lead"));
	Лиды.Вставить("password", Тексты.Текст("settings.hub.password.section.lead"));
	Лиды.Вставить("delivery", Тексты.Текст("settings.hub.delivery.lead"));
	Лиды.Вставить("legacy", Тексты.Текст("settings.hub.legacy.lead"));
	Лиды.Вставить("proxy", Тексты.Текст("settings.hub.proxy.lead"));
	Лиды.Вставить("people", Тексты.Текст("settings.hub.people.lead"));
	Лиды.Вставить("pools", Тексты.Текст("settings.hub.pools.lead"));
	Лиды.Вставить("trusted", Тексты.Текст("settings.hub.trusted.lead"));
	Лиды.Вставить("mail", Тексты.Текст("settings.hub.mail.lead"));
	Лиды.Вставить("mirrors", Тексты.Текст("settings.hub.mirrors.lead"));
	Лиды.Вставить("maintenance", Тексты.Текст("settings.hub.maintenance.lead"));

	// Слитые разделы: адрес прежнего ведёт в тот, который его вобрал.
	Преемники = Новый Соответствие();
	Преемники.Вставить("registration", "login");
	Преемники.Вставить("auth", "login");
	Преемники.Вставить("users", "people");
	Преемники.Вставить("groups", "people");

	// Экраны, которые ещё держат СВОИ точки маршрута: у них своё имя, а раздел-преемник
	// даёт на них ссылку — иначе в дереве на них не выйти.
	Живые = Новый Соответствие();
	Живые.Вставить("users", Тексты.Текст("settings.hub.screen.users"));
	Живые.Вставить("groups", Тексты.Текст("settings.hub.screen.groups"));

	// Блоки без своего пункта дерева: настройки доставки печатаются на экране подписок —
	// одна тема, один экран.
	Вложенные = Новый Соответствие();
	Вложенные.Вставить("delivery", "webhooks");

	ОписанияВложенных = Новый Массив();
	ОписанияВложенных.Добавить(Каталог.Описание("delivery",
		Тексты.Текст("settings.hub.block.delivery")));

КонецПроцедуры
