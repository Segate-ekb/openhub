// Пульт провайдеров входа — желудь модуля web-ui.

Перем Гейт;        // ГейтФормы (web-ui) — CSRF-токен формы
Перем РазборФормы; // РазборФормы (web-ui)
Перем Сервис;      // СервисПровайдеровВхода (oidc)
Перем Поля;        // ФормаПровайдераВхода (web-ui) — владелец имён полей
Перем АдресХаба;      // АдресИнстанса (основа) — redirect_uri по умолчанию

#Область ПубличныйИнтерфейс

// Разбирает тело запроса и проверяет CSRF.
//
// Параметры:
//  Ответ - ОтветСервера.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  ТелоЗапроса - Строка.
//  КукиЗапроса - Куки - куки запроса.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - разобранная форма; Неопределено — ответ уже сформирован.
//
Функция Форма(Ответ, Знач Контекст, Знач ТелоЗапроса, Знач КукиЗапроса) Экспорт
	Возврат Гейт.СПринятымТокеном(Ответ, Контекст, РазборФормы.Разобрать(ТелоЗапроса), КукиЗапроса);
КонецФункции

// Пресет, выбранный в теле формы: экран перерисовывает форму заведения тем же набором
// полей, с которым пришёл отвергнутый ввод.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Строка.
//
Функция Пресет(Знач Форма) Экспорт
	Возврат НРег(Текст(Форма, Поля.ИмяПоляПресета()));
КонецФункции

// Протокол, выбранный в теле формы: экран перерисовывает набор полей тем же протоколом,
// с которым пришёл отвергнутый ввод.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Строка.
//
Функция Протокол(Знач Форма) Экспорт
	Возврат НРег(Текст(Форма, Поля.ИмяПоляПротокола()));
КонецФункции

// Заводит провайдера по форме создания.
//
// Параметры:
//  Принципал - Структура.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - исход СервисаПровайдеровВхода (Успех, Код, Сообщение, Имя).
//
Функция Создать(Знач Принципал, Знач Форма) Экспорт
	Возврат Сервис.Завести(Принципал, Ввод(Форма));
КонецФункции

// Сохраняет правку существующего провайдера.
//
// Параметры:
//  Принципал - Структура.
//  Имя - Строка - имя из адреса маршрута.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - исход СервисаПровайдеровВхода.
//
Функция Сохранить(Знач Принципал, Знач Имя, Знач Форма) Экспорт

	Данные = Ввод(Форма);
	// имя берётся из адреса, а не из тела: иначе скрытым полем правился бы чужой провайдер
	Данные.Вставить("Имя", Строка(Имя));
	Возврат Сервис.Изменить(Принципал, Имя, Данные);

КонецФункции

// Включает/выключает либо удаляет провайдера.
//
// Параметры:
//  Принципал - Структура.
//  Действие - Строка - "переключить" | "удалить".
//  Имя - Строка - имя из адреса маршрута.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - исход СервисаПровайдеровВхода.
//
Функция Применить(Знач Принципал, Знач Действие, Знач Имя, Знач Форма) Экспорт

	Если НРег(СокрЛП(Строка(Действие))) = "удалить" Тогда
		Возврат Сервис.Удалить(Принципал, Имя);
	КонецЕсли;
	Возврат Сервис.Переключить(Принципал, Имя,
		РазборФормы.Флажок(Форма, Поля.ИмяПоляВключён(), Поля.ЗначениеОтмечено()));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Поля формы → доменный ввод.
Функция Ввод(Знач Форма)

	Данные = Новый Структура();
	Данные.Вставить("Имя", Текст(Форма, Поля.ИмяПоляИмени()));
	Данные.Вставить("Метка", Текст(Форма, Поля.ИмяПоляМетки()));
	Данные.Вставить("Значок", Текст(Форма, Поля.ИмяПоляЗначка()));
	Данные.Вставить("Пресет", Текст(Форма, Поля.ИмяПоляПресета()));
	Данные.Вставить("ВидПротокола", Текст(Форма, Поля.ИмяПоляПротокола()));
	Данные.Вставить("Издатель", Текст(Форма, Поля.ИмяПоляИздателя()));
	Данные.Вставить("ИдентификаторКлиента", Текст(Форма, Поля.ИмяПоляКлиента()));
	Данные.Вставить("СекретКлиента", Текст(Форма, Поля.ИмяПоляСекрета()));
	Данные.Вставить("АдресВозврата", АдресВозврата(Форма));
	Данные.Вставить("Область", Текст(Форма, Поля.ИмяПоляОбласти()));
	Данные.Вставить("БазовыйАдрес", Текст(Форма, Поля.ИмяПоляБазовогоАдреса()));
	Данные.Вставить("АдресАвторизации", Текст(Форма, Поля.ИмяПоляАвторизации()));
	Данные.Вставить("АдресТокена", Текст(Форма, Поля.ИмяПоляТокена()));
	Данные.Вставить("АдресПрофиля", Текст(Форма, Поля.ИмяПоляПрофиля()));
	Данные.Вставить("АдресEmails", Текст(Форма, Поля.ИмяПоляПисем()));
	Данные.Вставить("ИмяКлеймаГрупп", Текст(Форма, Поля.ИмяПоляКлеймаГрупп()));
	Данные.Вставить("ПрефиксГрупп", Текст(Форма, Поля.ИмяПоляПрефиксаГрупп()));
	Данные.Вставить("АвтоСоздание", Флажок(Форма, Поля.ИмяПоляАвтоСоздания()));
	Данные.Вставить("ПровижинингГрупп", Флажок(Форма, Поля.ИмяПоляПровижининга()));
	Данные.Вставить("СвязкаГруппПоИмени", Флажок(Форма, Поля.ИмяПоляСвязкиПоИмени()));
	Данные.Вставить("Включён", Флажок(Форма, Поля.ИмяПоляВключён()));
	Возврат Данные;

КонецФункции

// Пустое поле означает «считать из URL инстанса»; заполненное используется как есть.
Функция АдресВозврата(Знач Форма)

	Введённый = Текст(Форма, Поля.ИмяПоляВозврата());
	Возврат ?(ЗначениеЗаполнено(Введённый), Введённый, АдресХаба.АдресВозврата());

КонецФункции

Функция Текст(Знач Форма, Знач Имя)
	Возврат СокрЛП(Строка(РазборФормы.Поле(Форма, Имя)));
КонецФункции

Функция Флажок(Знач Форма, Знач Имя)
	Возврат РазборФормы.Флажок(Форма, Имя, Поля.ЗначениеОтмечено());
КонецФункции

#КонецОбласти

&Прозвище("ПультПровайдеровВхода")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисПровайдеровВхода") _Сервис,
	&Пластилин(Значение = "ФормаПровайдераВхода") _Поля,
	&Пластилин(Значение = "АдресИнстанса") _Адрес) Экспорт

	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	Сервис = _Сервис;
	Поля = _Поля;
	АдресХаба = _Адрес;

КонецПроцедуры
