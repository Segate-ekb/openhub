// Пульт групп хаба — желудь модуля web-ui: заведение и удаление групп из дома «Хаб».

Перем РазборФормы;   // РазборФормы (web-ui)
Перем Формы;         // ФормаСозданияГруппы (web-ui) — объявление полей формы заведения
Перем СлужбаГрупп;   // СлужбаГрупп (auth) — жизненный цикл группы со всей её обвязкой
Перем СервисГрупп;   // СервисГрупп (auth) — поиск группы по имени
Перем ФабрикаИтога;  // ИтогПульта (web-ui) — единая форма итога операции
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Применяет операцию раздела «группы» дома «Хаб».
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//  Кто - Строка - принципал для журнала аудита.
//
// Возвращаемое значение:
//  Структура - Ошибка (Строка: "" — операция выполнена, иначе текст отказа для экрана),
//              Заведение (Структура, Неопределено: Открыта, Заполнение и Отказы окна
//              заведения, в которое возвращается отбитая форма); прочие поля — см.
//              ИтогПульта.
//
Функция Применить(Знач Форма, Знач Кто) Экспорт

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, "операция")));

	Если Операция = Формы.ОперацияСоздания() Тогда
		Возврат Создать(Форма);
	ИначеЕсли Операция = "удалить" Тогда
		Возврат Удалить(Форма, Кто);
	КонецЕсли;

	// белый список операций: устаревшая вкладка не должна попадать в чужую ветку
	Возврат ФабрикаИтога.Отказ(Тексты.Текст("settings.hub.groups.error.operation"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Поля называет ОБЪЯВЛЕНИЕ формы; уникальность имени держит сервисный слой.
Функция Создать(Знач Форма)

	Разбор = Формы.Объявление().Разобрать(Форма);
	Если НЕ Разбор.Принято Тогда
		Возврат ФабрикаИтога.ОтказЗаведения(Разбор.Отказ, Разбор.Показ, Разбор.Отказы);
	КонецЕсли;

	Имя = Значением(Разбор.Значения, "имя");
	Если СервисГрупп.НайтиГруппу(Имя) <> Неопределено Тогда
		Возврат ЗанятоеИмя(Имя, Разбор.Показ);
	КонецЕсли;

	Попытка
		СлужбаГрупп.Создать(Имя, Значением(Разбор.Значения, "описание"));
	Исключение
		Возврат ЗанятоеИмя(Имя, Разбор.Показ);
	КонецПопытки;

	Возврат ФабрикаИтога.Успех();

КонецФункции

// Отказ домена приходит помеченным полем в открытом окне, а не баннером над съеденной формой.
Функция ЗанятоеИмя(Знач Имя, Знач Набранное)

	Текст = Тексты.Шаблон("settings.hub.groups.error.exists", Имя);
	Отказы = Новый Соответствие();
	Отказы.Вставить("имя", Текст);
	Возврат ФабрикаИтога.ОтказЗаведения(Текст, Набранное, Отказы);

КонецФункции

// Подтверждение сверяется с ИМЕНЕМ ВЫБРАННОЙ группы, а не с любым существующим.
Функция Удалить(Знач Форма, Знач Кто)

	Группа = СервисГрупп.НайтиГруппу(СокрЛП(РазборФормы.Поле(Форма, "группа")));
	Если Группа = Неопределено Тогда
		Возврат ФабрикаИтога.Отказ(Тексты.Текст("settings.hub.groups.error.notfound"));
	КонецЕсли;

	Подтверждение = СервисГрупп.НайтиГруппу(СокрЛП(РазборФормы.Поле(Форма, "подтверждение")));
	Если Подтверждение = Неопределено ИЛИ Подтверждение.Идентификатор <> Группа.Идентификатор Тогда
		Возврат ФабрикаИтога.Отказ(Тексты.Текст("settings.hub.groups.error.confirm"));
	КонецЕсли;

	СлужбаГрупп.Удалить(Группа.Идентификатор, Кто);
	Возврат ФабрикаИтога.Успех();

КонецФункции

Функция Значением(Знач Значения, Знач Ключ)
	Найденное = Значения.Получить(Ключ);
	Возврат ?(Найденное = Неопределено, "", Строка(Найденное));
КонецФункции

#КонецОбласти

&Прозвище("ПультГруппХаба")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ФормаСозданияГруппы") _Формы,
	&Пластилин(Значение = "СлужбаГрупп") _СлужбаГрупп,
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп,
	&Пластилин(Значение = "ИтогПульта") _ФабрикаИтога,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	Формы = _Формы;
	СлужбаГрупп = _СлужбаГрупп;
	СервисГрупп = _СервисГрупп;
	ФабрикаИтога = _ФабрикаИтога;
	Тексты = _Тексты;

КонецПроцедуры
