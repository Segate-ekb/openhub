// Форма правила «закрыт в странах» — желудь модуля web-ui. ОДНО объявление поля питает
// и отрисовку окна, и разбор POST: имя поля считает один и тот же код.

Перем Кит;             // Кит (кит) — предупреждение внутри окна
Перем Фабрика;         // Формы (кит) — фабрика объявлений форм
Перем Окна;            // ОкноФормы (web-ui) — каркас окна
Перем Тексты;          // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем СостояниеБазы;   // СостояниеБазыСтран (web-ui) — чем хаб различает страны
Перем ПараметрыСсылки; // ПараметрыСсылки (основа) — параметр запроса на адресе

#Область ПубличныйИнтерфейс

// Объявление формы: одно поле — список кодов стран через запятую. Проверку кода делает
// сервер: браузерной маской её не заменить, список действующих кодов знает только хаб.
// Блоки в разбор не входят, поэтому объявление одно и на печать, и на разбор.
//
// Возвращаемое значение:
//  ОбъявлениеФормы - объявление, готовое и печатать, и разбирать.
//
Функция Объявление() Экспорт

	Возврат Фабрика.Новая()
		.Поле("страны", Тексты.Текст("providers.geo.field"), "строка",
			Новый Структура("Плейсхолдер, Подсказка", "RU, BY",
				Тексты.Текст("providers.geo.field.hint")));

КонецФункции

// Модальное окно с формой правила. Отбитая форма возвращается тем же окном — с набранным
// и помеченным полем. Скрипта здесь нет: окно держит движок браузера, а открывает его
// серверная дорога — адрес раздела с именем провайдера в параметре.
//
// Параметры:
//  Параметры - Структура:
//    * Адрес - Строка - адрес, куда уходит POST правила;
//    * Токен - Строка - CSRF-токен сессии;
//    * Провайдер - Строка - чьё правило правится: окно стоит отдельно от карточки
//      и обязано называть провайдера само;
//    * Обстановка - Структура - Учёток, ПарольныйВход, ВосстановлениеПароля;
//    * Посетитель - Структура, Неопределено - посетитель запроса (его кладёт витрина):
//      окно говорит администратору, какой страной хаб видит его собственный запрос;
//    * Заполнение - Структура, Соответствие, Неопределено - чем заполнить поле;
//    * Открыта - Булево - печатать окно открытым;
//    * Отказы - Соответствие - ключ поля -> текст отказа домена.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел-окно: <dialog> с формой.
//
Функция Окно(Знач Параметры) Экспорт

	Состояние = Окна.Состояние(Параметры);

	Возврат Окна.Окно(Наполненное(Параметры), Состояние, Параметры.Адрес,
		Параметры.Токен, Оформление(Состояние, ИмяПровайдера(Параметры)));

КонецФункции

// Адрес раздела, по которому страница приходит с уже ОТКРЫТЫМ окном этого провайдера.
//
// Параметры:
//  АдресРаздела - Строка - адрес раздела провайдеров.
//  ИмяПровайдера - Строка - чьё правило показать.
//
// Возвращаемое значение:
//  Строка.
//
Функция АдресОткрытого(Знач АдресРаздела, Знач ИмяПровайдера) Экспорт

	Возврат ПараметрыСсылки.Установить(Строка(АдресРаздела), ИмяПараметра(),
		Строка(ИмяПровайдера));

КонецФункции

// Имя параметра адреса, которым названо открытое окно.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПараметра() Экспорт
	Возврат "countries";
КонецФункции

// Ключ поля со странами: им пульт достаёт набранное из разобранной формы.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючПоляСтран() Экспорт
	Возврат "страны";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Под объявленной формой — цена правила: администратор читает сверху вниз и видит её
// до того, как нажмёт «Сохранить». Сначала самое тяжёлое следствие (правило закроет
// провайдера всем, пока база молчит), затем учётки без другого входа, затем состояние
// базы и страна СВОЕГО запроса — ею проверяется, что хаб вообще видит посетителей,
// а не адрес обратного прокси. Строка атрибуции на этом экране одна и стоит под списком.
Функция Наполненное(Знач Параметры)

	Возврат Объявление()
		.Блок(СостояниеБазы.ПредупреждениеПроВсех().Рендер())
		.Блок(Предупреждение(Параметры.Обстановка).Рендер())
		.Блок(СостояниеБазы.Сводка().Рендер())
		.Блок(СостояниеБазы.СтранаЗапроса(Параметры.Посетитель).Рендер());

КонецФункции

// Открывашки у окна нет: дорога к нему серверная — ссылка на карточке провайдера.
// Заголовок называет провайдера: окно стоит над списком, и карточка рядом с ним не стоит.
Функция Оформление(Знач Состояние, Знач Провайдер)

	Результат = Окна.Оформление(Состояние, Тексты.Шаблон("providers.geo.title", Провайдер),
		Тексты.Текст("providers.geo.lead"), Тексты.Текст("providers.button.save"), "замок");
	Результат.Вставить("Открывашка", "");
	Возврат Результат;

КонецФункции

Функция ИмяПровайдера(Знач Параметры)

	Значение = "";
	Параметры.Свойство("Провайдер", Значение);
	Возврат СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));

КонецФункции

// Сколько учётных записей останется без другого входа и чем хаб им поможет.
Функция Предупреждение(Знач Обстановка)

	Если Обстановка.Учёток = 0 Тогда
		Возврат Кит.Примечание(Тексты.Текст("providers.geo.accounts.none"));
	КонецЕсли;

	Возврат Кит.Уведомление(Новый Структура("Текст, Вид",
		Тексты.Шаблон("providers.geo.accounts.some", Формат(Обстановка.Учёток, "ЧГ="))
			+ " " + ЗапаснойВход(Обстановка),
		?(Обстановка.ПарольныйВход = Истина, "warn", "err")));

КонецФункции

// Восстановление пароля само требует включённого парольного входа, поэтому «пароля нет,
// а восстановление есть» на хабе не встречается: вариантов ровно три.
Функция ЗапаснойВход(Знач Обстановка)

	Если НЕ Обстановка.ПарольныйВход Тогда
		Возврат Тексты.Текст("providers.geo.fallback.none");
	КонецЕсли;
	Если НЕ Обстановка.ВосстановлениеПароля Тогда
		Возврат Тексты.Текст("providers.geo.fallback.password");
	КонецЕсли;

	Возврат Тексты.Текст("providers.geo.fallback.password") + " "
		+ Тексты.Текст("providers.geo.fallback.recovery");

КонецФункции

#КонецОбласти

&Прозвище("ФормаГеоправилаПровайдера")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "Формы") _Фабрика,
	&Пластилин(Значение = "ОкноФормы") _Окна,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СостояниеБазыСтран") _СостояниеБазы,
	&Пластилин(Значение = "ПараметрыСсылки") _Параметры = Неопределено) Экспорт

	Кит = _Кит;
	Фабрика = _Фабрика;
	Окна = _Окна;
	Тексты = _Тексты;
	СостояниеБазы = _СостояниеБазы;
	ПараметрыСсылки = ?(_Параметры = Неопределено, Новый ПараметрыСсылки(), _Параметры);

КонецПроцедуры
