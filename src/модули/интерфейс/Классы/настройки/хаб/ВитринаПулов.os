// Витрина пулов — желудь модуля web-ui: раздел «Пулы» дома «Хаб» элементами экрана —
// список пулов, кнопка заведения с окном и панель правки квоты.

Перем Кит;               // Кит (oscript-ui) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем Форма;             // ФормаСозданияПула (web-ui) — окно заведения пула
Перем ДомПула;           // ДомПула (web-ui) — адреса разделов дома пула
Перем Плашки;            // ПлашкиПула (web-ui) — читаемые признаки пула
Перем СервисПулов;       // СервисПулов (реестр) — занятое и действующая квота
Перем Заполнение;        // ЗаполнениеПула (основа) — процент занятого
Перем Объёмы;            // ОбъёмТекстом (основа) — байты человеку
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Имя скрытого поля операции раздела.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Операция «создать пул».
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияСоздания() Экспорт
	Возврат "пул-создать";
КонецФункции

// Операция «сделать пул основным пулом хаба».
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияОсновного() Экспорт
	Возврат "пул-основной";
КонецФункции

// Операция «применить квоту и видимость пула».
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияКвоты() Экспорт
	Возврат "пул-квота";
КонецФункции

// Имя поля с идентификатором пула — оно же имя параметра адреса, открывающего панель правки.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляПула() Экспорт
	Возврат "pool";
КонецФункции

// Хвост адреса, доносящий отбор списка до следующего экрана. Отбор — часть адреса
// раздела, поэтому его форму знает витрина: и ссылки списка, и возврат после мутации
// собираются ею одной.
//
// Параметры:
//  Отбор - Строка - подстрока имени, которой сужен список; пустая — хвоста нет.
//  Разделитель - Строка - "?" либо "&" в зависимости от того, есть ли уже запрос
//                (необязательный, по умолчанию "&").
//
// Возвращаемое значение:
//  Строка - хвост адреса либо "".
//
Функция ХвостОтбора(Знач Отбор, Знач Разделитель = "&") Экспорт

	Значение = СокрЛП(Строка(Отбор));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Разделитель + "q=" + КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);

КонецФункции

// Секции раздела «Пулы» дома «Хаб».
//
// Параметры:
//  Параметры - Структура:
//    * Пулы - Массив из Пул - все пулы инсталляции;
//    * Адрес - Строка - адрес раздела (он же action форм);
//    * Токен - Строка - CSRF-токен сессии;
//    * Отбор - Строка - подстрока имени, которой сужен список;
//    * Правка - Пул, Неопределено - пул, для которого раскрыта панель правки квоты;
//    * МожетСоздавать - Булево - вправе ли смотрящий заводить пулы;
//    * МожетНазначать - Булево - вправе ли смотрящий назначать основной пул хаба;
//    * Заведение - Структура, Неопределено - состояние окна заведения (Открыта, Заполнение, Отказы); Неопределено — окно закрыто и пусто.
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Результат = Новый Массив();

	Если Параметры.Правка <> Неопределено Тогда
		Результат.Добавить(СекцияПравки(Параметры.Правка, Параметры.Адрес, Параметры.Токен,
			Параметры.Отбор));
	КонецЕсли;

	Результат.Добавить(СекцияСписка(Параметры));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СписокПулов

Функция СекцияСписка(Знач Параметры)

	Отбор = СокрЛП(Строка(Параметры.Отбор));
	Отобранные = ОтобранныеПулы(Параметры.Пулы, Отбор);

	// заведение живёт кнопкой над таблицей и окном поверх экрана: пока не нажали,
	// форма места не занимает
	Тело = Кит.Холст();
	Тело.Добавить(ПоискПоИмени(Параметры.Адрес, Отбор));
	Тело.Добавить(Заведение(Параметры));
	Тело.Добавить(ТаблицаПулов(Отобранные.Рабочие, Параметры));
	Тело.Добавить(СвёрнутыеЛичные(Отобранные.Личные, Параметры));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.hub.pools.list.title"),
		Тексты.Текст("settings.hub.pools.list.lead"), Тело.Рендер());
	Секция.Иконка = "куб";
	// секция без «Действия»: отбор, создание и действия строк — свои самостоятельные формы
	Возврат Секция;

КонецФункции

// Личные пространства идут отдельным списком: их столько же, сколько учёток.
Функция ОтобранныеПулы(Знач Пулы, Знач Отбор)

	Рабочие = Новый Массив();
	Личные = Новый Массив();

	Для Каждого Пул Из Пулы Цикл
		Если ЗначениеЗаполнено(Отбор) И СтрНайти(НРег(Строка(Пул.Имя)), НРег(Отбор)) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Пул.ЭтоЛичный() Тогда
			Личные.Добавить(Пул);
		Иначе
			Рабочие.Добавить(Пул);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Рабочие, Личные", Рабочие, Личные);

КонецФункции

Функция ПоискПоИмени(Знач Адрес, Знач Отбор)

	Возврат Кит.СтрокаПоиска(
		Новый Структура("Действие, Метка, Значение, Плейсхолдер, Кнопка, Иконка",
			Адрес, Тексты.Текст("access.pools.filter.label"), Отбор,
			Тексты.Текст("access.pools.filter.placeholder"),
			Тексты.Текст("access.pools.filter.submit"), "поиск"));

КонецФункции

// Вид «карточками»: на узком экране запись становится карточкой.
Функция ТаблицаПулов(Знач Пулы, Знач Параметры)

	Таблица = Кит.Таблица("карточками");
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("access.pools.col.pool")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("access.pools.col.props")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.pools.col.usage")));
	Таблица.Добавить(Кит.Колонка(""));

	Для Каждого Пул Из Пулы Цикл
		Таблица.Добавить(ЗаписьПула(Пул, Параметры));
	КонецЦикла;

	Таблица.Пусто().Добавить(Кит.Примечание(ПустаяВыдача(Параметры.Отбор), "пусто"));
	Возврат Таблица;

КонецФункции

Функция ЗаписьПула(Знач Пул, Знач Параметры)

	Запись = Кит.Запись();
	Запись.Добавить(ЯчейкаИмени(Пул));
	Запись.Добавить(ЯчейкаПризнаков(Пул));
	Запись.Добавить(ЯчейкаЗанятого(Пул));
	Запись.Добавить(ЯчейкаДействий(Пул, Параметры));
	Возврат Запись;

КонецФункции

Функция ЯчейкаИмени(Знач Пул)

	Ячейка = Кит.Ячейка();
	Имя = Ячейка.Добавить(Кит.Ссылка("/" + Пул.Имя));
	Имя.Добавить(Кит.Текст(Пул.Имя));
	Возврат Ячейка;

КонецФункции

Функция ЯчейкаПризнаков(Знач Пул)

	Ряд = Новый Массив();
	Ряд.Добавить(Плашки.ПлашкаОсновного(Пул));
	Ряд.Добавить(Плашки.ПлашкаТипа(Пул));
	Ряд.Добавить(Плашки.ПлашкаВидимости(Пул));

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.РядПлашек(Ряд));
	Возврат Ячейка;

КонецФункции

// Колонка ТРЁХЗНАЧНА, поэтому печатается ДЕЙСТВУЮЩАЯ квота, а не записанная.
Функция ЯчейкаЗанятого(Знач Пул)

	Занято = СервисПулов.ЗанятоБайт(Пул);
	КвотаБайт = СервисПулов.ЭффективнаяКвотаБайт(Пул);

	Ячейка = Кит.Ячейка("величина");

	Если КвотаБайт <= 0 Тогда
		Ячейка.Добавить(Кит.Текст(Тексты.Шаблон("settings.pool.quota.meter.unlimited",
			Объёмы.Представление(Занято))));
		Возврат Ячейка;
	КонецЕсли;

	Ячейка.Добавить(ПолосаКвоты(Занято, КвотаБайт));
	Ячейка.Добавить(ПрипискаОКвотеХаба(Пул));
	Возврат Ячейка;

КонецФункции

Функция ПолосаКвоты(Знач Занято, Знач КвотаБайт)

	Возврат Кит.ПолосаЗаполнения(Новый Структура("Процент, Метка, Подпись, Компактная",
		Заполнение.Процент(Занято, КвотаБайт),
		Тексты.Текст("settings.pool.quota.meter.label"),
		Тексты.Шаблон("settings.pool.quota.meter.value",
			Объёмы.Представление(Занято), Объёмы.Представление(КвотаБайт)), Истина));

КонецФункции

// «Как в хабе» названо прямо: иначе админ не понимает, что правит дефолт хаба, а не пул.
Функция ПрипискаОКвотеХаба(Знач Пул)

	Если СервисПулов.КвотаКакВХабе() <> Цел(Число(Пул.КвотаМб)) Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Приписка = Кит.Надпись("приписка");
	Приписка.Добавить(Кит.Текст(Тексты.Текст("settings.hub.pools.quota.inherited")));
	Возврат Приписка;

КонецФункции

Функция ЯчейкаДействий(Знач Пул, Знач Параметры)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(МенюПула(Пул, Параметры));
	Возврат Ячейка;

КонецФункции

// Панель кита рисуется в верхнем слое: строка не растёт, а обёртка прокрутки её не обрезает.
Функция МенюПула(Знач Пул, Знач Параметры)

	Пункты = Новый Массив();
	Пункты.Добавить(Новый Структура("Подпись, Адрес, Иконка",
		Тексты.Текст("access.pools.action.settings"), ДомПула.БазовыйАдрес(Пул.Имя), "шестерёнка"));
	Пункты.Добавить(Новый Структура("Подпись, Адрес, Иконка",
		Тексты.Текст("access.pools.action.access"), ДомПула.АдресРаздела(Пул.Имя, "access"), "замок"));
	Пункты.Добавить(Новый Структура("Подпись, Адрес, Иконка",
		Тексты.Текст("settings.hub.pools.action.quota"),
		АдресПравки(Параметры.Адрес, Пул, Параметры.Отбор), "скачать"));

	Основной = ФормаОсновного(Пул, Параметры);
	Если ЗначениеЗаполнено(Основной) Тогда
		Пункты.Добавить(Новый Структура("HTML", Основной));
	КонецЕсли;

	Возврат Кит.Меню(Новый Структура("Подпись, Пункты",
		Тексты.Шаблон("settings.hub.pools.menu.title", Строка(Пул.Имя)), Пункты));

КонецФункции

// Короткие адреса /download и /push принадлежат хабу, а не администратору отдельного пула.
Функция ФормаОсновного(Знач Пул, Знач Параметры)

	Если НЕ Параметры.МожетНазначать ИЛИ Пул.ЭтоДефолтный() ИЛИ Пул.ЭтоЛичный() Тогда
		Возврат "";
	КонецЕсли;

	// имя локальной не «Форма»: так зовётся поле модуля (ФормаСозданияПула), и присвоение
	// затёрло бы его — окно заведения перестало бы собираться посреди страницы
	ФормаМеню = Кит.Форма(Параметры.Адрес, Параметры.Токен, "меню");
	ФормаМеню.Добавить(Кит.СкрытоеПоле(ИмяПоляОперации(), ОперацияОсновного()));
	ФормаМеню.Добавить(Кит.СкрытоеПоле(ИмяПоляПула(), Пул.Идентификатор));
	ФормаМеню.Добавить(Кит.СкрытоеПоле("q", Параметры.Отбор));
	ФормаМеню.Добавить(КнопкаОсновного());
	Возврат ФормаМеню.Рендер();

КонецФункции

Функция КнопкаОсновного()

	Возврат Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Тексты.Текст("access.pools.default.action"), "вторичная", "малый"));

КонецФункции

// Личных пространств столько же, сколько учёток: развёрнутый список прятал бы рабочие пулы.
Функция СвёрнутыеЛичные(Знач Личные, Знач Параметры)

	Если Личные.Количество() = 0 Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Свёрнутые = Кит.Раскрывашка("врезка");
	Свёрнутые.Шапка().Добавить(Кит.Текст(Тексты.Шаблон("access.pools.personal",
		Формат(Личные.Количество(), "ЧН=0; ЧГ=0"))));
	Свёрнутые.Добавить(ТаблицаПулов(Личные, Параметры));
	Возврат Свёрнутые;

КонецФункции

// Пока не нажали, форма места не занимает; как окно устроено, знает форма пула.
Функция Заведение(Знач Параметры)

	Если НЕ Параметры.МожетСоздавать Тогда
		Возврат Кит.Примечание(Тексты.Текст("access.pools.create.denied"));
	КонецЕсли;

	Модель = Новый Структура();
	Модель.Вставить("Адрес", Параметры.Адрес);
	Модель.Вставить("Токен", Параметры.Токен);
	Модель.Вставить("ПолеОперации", ИмяПоляОперации());
	Модель.Вставить("Операция", ОперацияСоздания());
	Модель.Вставить("Отбор", Параметры.Отбор);

	Состояние = Неопределено;
	Параметры.Свойство("Заведение", Состояние);
	Если Состояние <> Неопределено Тогда
		// отбитая форма возвращается ТЕМ ЖЕ окном: с набранным и помеченным полем,
		// а не пустой страницей, съевшей ввод
		Модель.Вставить("Открыта", Состояние.Открыта);
		Модель.Вставить("Заполнение", Состояние.Заполнение);
		Модель.Вставить("Отказы", Состояние.Отказы);
	КонецЕсли;

	Возврат Форма.Окно(Модель);

КонецФункции

#КонецОбласти

#Область ПравкаКвоты

// Отдельной секцией, а не формой внутри меню: два поля и свой отказ в ячейку не помещаются.
Функция СекцияПравки(Знач Пул, Знач Адрес, Знач Токен, Знач Отбор)

	Правка = Кит.Холст();
	Правка.Добавить(Кит.СкрытоеПоле(ИмяПоляОперации(), ОперацияКвоты()));
	Правка.Добавить(Кит.СкрытоеПоле(ИмяПоляПула(), Пул.Идентификатор));
	Правка.Добавить(Кит.СкрытоеПоле("q", Отбор));
	Правка.Добавить(ПолеКвоты(Пул));
	Правка.Добавить(ТумблерВидимости(Пул));

	Секция = РендерерНастроек.Секция(
		Тексты.Шаблон("settings.hub.pools.quota.title", Строка(Пул.Имя)),
		Тексты.Текст("settings.hub.pools.quota.lead"), Правка.Рендер());
	Секция.Иконка = "скачать";
	Секция.Действие = Адрес;
	Секция.Токен = Токен;
	Секция.Кнопка = Тексты.Текст("settings.hub.pools.quota.button");
	// «Отмена» — обычная ссылка на тот же список: возврат ничего не меняет
	Секция.АдресОтмены = Адрес + ХвостОтбора(Отбор, "?");
	Возврат Секция;

КонецФункции

Функция ПолеКвоты(Знач Пул)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Подсказка",
		"квота_мб", Тексты.Текст("settings.pool.quota.label"), "число",
		Формат(Цел(Число(Пул.КвотаМб)), "ЧГ=0"), Тексты.Текст("settings.pool.quota.hint")));

КонецФункции

Функция ТумблерВидимости(Знач Пул)

	Возврат Кит.Тумблер(Новый Структура(
		"Имя, Метка, Включено, ЗначениеВкл, ЗначениеВыкл, ПодписьВкл, ПодписьВыкл",
		"видимость", Тексты.Текст("access.pools.create.visibility"),
		НРег(Строка(Пул.Видимость)) = "public", "public", "private",
		Тексты.Текст("access.pools.create.visibility.on"),
		Тексты.Текст("access.pools.create.visibility.off")));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АдресПравки(Знач Адрес, Знач Пул, Знач Отбор)
	Возврат Адрес + "?" + ИмяПоляПула() + "=" + Формат(Цел(Пул.Идентификатор), "ЧН=0; ЧГ=0")
		+ ХвостОтбора(Отбор, "&");
КонецФункции

Функция ПустаяВыдача(Знач Отбор)
	Если ЗначениеЗаполнено(Отбор) Тогда
		Возврат Тексты.Текст("access.pools.empty.filtered.lead");
	КонецЕсли;
	Возврат Тексты.Текст("access.pools.table.empty");
КонецФункции

#КонецОбласти

&Прозвище("ВитринаПулов")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ФормаСозданияПула") _Форма,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ПлашкиПула") _Плашки,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ЗаполнениеПула") _Заполнение,
	&Пластилин(Значение = "ОбъёмТекстом") _Объёмы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Форма = _Форма;
	ДомПула = _ДомПула;
	Плашки = _Плашки;
	СервисПулов = _СервисПулов;
	Заполнение = _Заполнение;
	Объёмы = _Объёмы;
	Тексты = _Тексты;

КонецПроцедуры
