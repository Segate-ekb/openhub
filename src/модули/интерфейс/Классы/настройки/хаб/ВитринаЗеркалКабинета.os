// Админский обзор зеркал «/office/mirrors» и список зеркал одного пула. В отличие
// от разделов дома настроек это страницы целиком: свои заголовки и свои баннеры.
// Экран собирается элементами кита.

Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем СервисЗеркал;  // СервисЗеркал (зеркала) — список зеркал и известные режимы
Перем Прогоны;       // ПредставлениеПрогонаЗеркала (web-ui) — прогон в виде для экрана
Перем ДомПула;       // ДомПула (web-ui) — адрес экрана состояния зеркала
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Обзор пулов назначения.
//
// Параметры:
//  Пулы - Массив из Пул - пулы, зеркалами которых распоряжается пользователь.
//
// Возвращаемое значение:
//  Строка - разметка страницы обзора.
//
Функция Обзор(Знач Пулы) Экспорт

	Страница = Кит.Холст();
	Страница.Добавить(ЗаглавиеОбзора());
	Страница.Добавить(ВходыВПулы(Пулы));
	Возврат Страница.Рендер();

КонецФункции

// Список зеркал одного пула вместе с формой создания.
//
// Параметры:
//  Параметры - Структура: * Пул - Пул - пул назначения; * Токен - Строка - CSRF-токен сессии; * Баннеры - Массив из Структура - уведомления (Текст, Вид) над содержимым.
//
// Возвращаемое значение:
//  Строка - разметка страницы списка.
//
Функция Список(Знач Параметры) Экспорт

	Пул = Параметры.Пул;
	Токен = Параметры.Токен;

	Страница = Кит.Холст();
	Страница.Добавить(ЗаглавиеПула(Пул));
	Страница.Добавить(Уведомления(Параметры.Баннеры));
	Страница.Добавить(БлокЗаведения(Пул, Токен));
	Страница.Добавить(БлокСписка(Пул, Токен));
	Возврат Страница.Рендер();

КонецФункции

// Адрес обзора зеркал по всем пулам — вход на экран.
//
// Возвращаемое значение:
//  Строка - адрес обзора.
//
Функция АдресОбзора() Экспорт
	Возврат "/office/mirrors";
КонецФункции

// Адрес списка зеркал пула в кабинете.
//
// Параметры:
//  Пул - Пул - пул назначения.
//
// Возвращаемое значение:
//  Строка - адрес списка зеркал пула в кабинете.
//
Функция АдресПула(Знач Пул) Экспорт
	Возврат СтрШаблон("%1/%2", АдресОбзора(), Пул.Имя);
КонецФункции

#КонецОбласти

#Область ОбзорПулов

Функция ЗаглавиеОбзора()

	Возврат Заглавие(Тексты.Текст("office.mirrors.title"),
		Тексты.Текст("office.mirrors.lead"));

КонецФункции

// Пул, которым человек не распоряжается, в обзор не попадает; не попал ни один —
// вместо пустой сетки печатается объяснение.
Функция ВходыВПулы(Знач Пулы)

	Если Пулы.Количество() = 0 Тогда
		Возврат ПустоБезПулов();
	КонецЕсли;

	Сетка = Кит.Сетка(Новый Структура("Плотная, Заголовок",
		Истина, Тексты.Текст("office.mirrors.pools.title")));

	Для Каждого Пул Из Пулы Цикл
		Сетка.Добавить(ВходВПул(Пул));
	КонецЦикла;
	Возврат Сетка;

КонецФункции

Функция ВходВПул(Знач Пул)

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Иконка",
		Пул.Имя, АдресПула(Пул), "вторичная", "куб"));

КонецФункции

Функция ПустоБезПулов()

	Возврат Кит.ПустоеСостояние(Новый Структура("Заголовок, Пояснение, Иконка",
		Тексты.Текст("office.mirrors.pools.empty.title"),
		Тексты.Текст("office.mirrors.pools.empty.lead"), "куб"));

КонецФункции

#КонецОбласти

#Область СтраницаПула

Функция ЗаглавиеПула(Знач Пул)

	Возврат Заглавие(Тексты.Шаблон("office.mirrors.pool.title", Пул.Имя),
		Тексты.Текст("office.mirrors.pool.lead"));

КонецФункции

// Итог нажатой «синхронизации» приезжает адресом и печатается над содержимым.
Функция Уведомления(Знач Баннеры)

	Полоса = Кит.Холст();
	Для Каждого Баннер Из Баннеры Цикл
		Полоса.Добавить(Кит.Уведомление(Новый Структура("Текст, Вид", Баннер.Текст, Баннер.Вид)));
	КонецЦикла;
	Возврат Полоса;

КонецФункции

Функция БлокЗаведения(Знач Пул, Знач Токен)

	Блок = Кит.Холст();
	Блок.Добавить(Подзаголовок(Тексты.Текст("office.mirrors.new.title")));
	Блок.Добавить(ФормаЗаведения(Пул, Токен));
	Возврат Блок;

КонецФункции

Функция ФормаЗаведения(Знач Пул, Знач Токен)

	Форма = Кит.Форма(АдресПула(Пул), Токен, "столбик");
	Форма.Добавить(ПолеАпстрима());
	Форма.Добавить(ПолеРежима());
	Форма.Добавить(ПолеФильтра());
	Форма.Добавить(ПолеИнтервала());
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Тексты.Текст("office.mirrors.new.button"), "основная", "обычный")));
	Возврат Форма;

КонецФункции

Функция ПолеАпстрима()

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Плейсхолдер",
		"url", Тексты.Текст("office.mirrors.new.url"), "http://hub.oscript.io/download/"));

КонецФункции

Функция ПолеРежима()

	Варианты = Новый Массив();
	Для Каждого Режим Из СервисЗеркал.ИзвестныеРежимы() Цикл
		Варианты.Добавить(Новый Структура("Значение, Подпись", Режим, Режим));
	КонецЦикла;

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Варианты",
		"режим", Тексты.Текст("office.mirrors.new.mode"), "выбор", Варианты));

КонецФункции

Функция ПолеФильтра()

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Плейсхолдер",
		"фильтр", Тексты.Текст("office.mirrors.new.filter"), "[""corp-*"",""mylib""]"));

КонецФункции

Функция ПолеИнтервала()

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Плейсхолдер",
		"интервал", Тексты.Текст("office.mirrors.new.interval"), "3600"));

КонецФункции

#КонецОбласти

#Область СписокЗеркал

Функция БлокСписка(Знач Пул, Знач Токен)

	Блок = Кит.Холст();
	Блок.Добавить(Подзаголовок(Тексты.Текст("office.mirrors.list.title")));
	Блок.Добавить(ТаблицаЗеркал(Пул, Токен));
	Возврат Блок;

КонецФункции

Функция ТаблицаЗеркал(Знач Пул, Знач Токен)

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("office.mirrors.col.upstream")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("office.mirrors.col.mode")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("office.mirrors.col.state")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("office.mirrors.col.run")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("office.mirrors.col.sync")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("office.mirrors.col.actions")));

	Для Каждого Зеркало Из СервисЗеркал.СписокПула(Пул.Идентификатор) Цикл
		Таблица.Добавить(ЗаписьЗеркала(Пул, Зеркало, Токен));
	КонецЦикла;

	Таблица.Пусто().Добавить(Кит.Примечание(Тексты.Текст("office.mirrors.empty"), "пусто"));
	Возврат Таблица;

КонецФункции

Функция ЗаписьЗеркала(Знач Пул, Знач Зеркало, Знач Токен)

	Прогон = Прогоны.Модель(Зеркало, СервисЗеркал.ПрогонБрошен(Зеркало));

	Запись = Кит.Запись();
	Запись.Добавить(АдресАпстрима(Зеркало));
	Запись.Добавить(РежимСинхронизации(Зеркало));
	Запись.Добавить(Включённость(Зеркало));
	Запись.Добавить(СостояниеПрогона(Пул, Зеркало, Прогон));
	Запись.Добавить(МоментПоследнегоСинка(Прогон));
	Запись.Добавить(ДействияНадЗеркалом(Пул, Токен, Зеркало));
	Возврат Запись;

КонецФункции

Функция АдресАпстрима(Знач Зеркало)

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Код(Зеркало.АпстримURL));
	Возврат Результат;

КонецФункции

Функция РежимСинхронизации(Знач Зеркало)
	Возврат Значением(Строка(Зеркало.Режим));
КонецФункции

Функция Включённость(Знач Зеркало)

	Включено = (Зеркало.Включено = Истина);

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Плашка(Новый Структура("Текст, Вид",
		?(Включено, Тексты.Текст("office.mirrors.state.on"),
			Тексты.Текст("office.mirrors.state.off")),
		?(Включено, "ok", "warn"))));
	Возврат Результат;

КонецФункции

// Детальный экран состояния живёт в доме пула: кабинет — кросс-пуловый обзор, второго
// дома настроек он не заводит.
Функция СостояниеПрогона(Знач Пул, Знач Зеркало, Знач Прогон)

	Адрес = ДомПула.АдресРаздела(Пул.Имя, "mirrors") + "/" + Идентификатор(Зеркало);

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Плашка(Новый Структура("Текст, Вид, Адрес",
		Прогон.Подпись, Прогон.Вид, Адрес)));
	Возврат Результат;

КонецФункции

Функция МоментПоследнегоСинка(Знач Прогон)

	Возврат Значением(?(ЗначениеЗаполнено(Прогон.ПоследнийСинк), Прогон.ПоследнийСинк,
		Тексты.Текст("office.mirrors.sync.never")));

КонецФункции

Функция ДействияНадЗеркалом(Знач Пул, Знач Токен, Знач Зеркало)

	Результат = Кит.Ячейка();
	Результат.Добавить(ФормаСинхронизации(Пул, Токен, Зеркало));
	Результат.Добавить(ФормаПереключения(Пул, Токен, Зеркало));
	Результат.Добавить(ФормаУдаления(Пул, Токен, Зеркало));
	Возврат Результат;

КонецФункции

Функция ФормаСинхронизации(Знач Пул, Знач Токен, Знач Зеркало)

	Форма = Кит.Форма(Действие(Пул, Зеркало, "sync"), Токен, "строкой");
	Форма.Добавить(Кнопка(Тексты.Текст("office.mirrors.button.sync")));
	Возврат Форма;

КонецФункции

Функция ФормаПереключения(Знач Пул, Знач Токен, Знач Зеркало)

	Включено = (Зеркало.Включено = Истина);

	Форма = Кит.Форма(Действие(Пул, Зеркало, "toggle"), Токен, "строкой");
	Форма.Добавить(Кит.СкрытоеПоле("включить", ?(Включено, "0", "1")));
	Форма.Добавить(Кнопка(?(Включено, Тексты.Текст("office.mirrors.button.disable"),
		Тексты.Текст("office.mirrors.button.enable"))));
	Возврат Форма;

КонецФункции

Функция ФормаУдаления(Знач Пул, Знач Токен, Знач Зеркало)

	Форма = Кит.Форма(Действие(Пул, Зеркало, "delete"), Токен, "строкой");
	Форма.Добавить(Кнопка(Тексты.Текст("office.mirrors.button.delete"), "опасная"));
	Возврат Форма;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заглавие страницы: имя экрана и строка о том, зачем он.
Функция Заглавие(Знач Имя, Знач Пояснение)

	Результат = Кит.Холст();
	Результат.Добавить(Заголовок(1, Имя));
	Результат.Добавить(Кит.Примечание(Пояснение));
	Возврат Результат;

КонецФункции

// Имя блока внутри страницы: уровнем ниже заглавия, без пояснения под ним.
Функция Подзаголовок(Знач Имя)
	Возврат Заголовок(2, Имя);
КонецФункции

Функция Заголовок(Знач Уровень, Знач Имя)

	Результат = Кит.Заголовок(Уровень);
	Результат.Добавить(Кит.Текст(Имя));
	Возврат Результат;

КонецФункции

Функция Значением(Знач Текст)

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Текст(Текст));
	Возврат Результат;

КонецФункции

Функция Кнопка(Знач Подпись, Знач Вариант = "вторичная")

	Возврат Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Подпись, Вариант, "малый"));

КонецФункции

Функция Действие(Знач Пул, Знач Зеркало, Знач Операция)
	Возврат АдресПула(Пул) + "/" + Идентификатор(Зеркало) + "/" + Операция;
КонецФункции

Функция Идентификатор(Знач Зеркало)
	Возврат Формат(Зеркало.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

#КонецОбласти

&Прозвище("ВитринаЗеркалКабинета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Пластилин(Значение = "ПредставлениеПрогонаЗеркала") _Прогоны,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	СервисЗеркал = _СервисЗеркал;
	Прогоны = _Прогоны;
	ДомПула = _ДомПула;
	Тексты = _Тексты;

КонецПроцедуры
