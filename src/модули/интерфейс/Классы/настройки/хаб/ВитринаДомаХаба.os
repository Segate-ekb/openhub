// Витрина дома «Хаб» — желудь модуля web-ui: из каких секций и в каком порядке состоит
// каждый его раздел. Контроллер решает, ЧТО показать, витрина — КАК.

Перем Дом;               // ДомХаба (web-ui) — адреса и подписи разделов
Перем Витрина;           // ВитринаНастроек (web-ui) — карточки и формы из реестра
Перем ВитринаПулов;      // ВитринаПулов (web-ui) — раздел «Пулы»
Перем ВитринаБренда;     // ВитринаБрендирования (web-ui) — секция картинок оформления
Перем Сведения;          // ВитринаСведенийХаба (web-ui) — секции вне реестра
Перем ВитринаХранилища;  // ВитринаХранилища (web-ui) — состояние хранилища словами
Перем ВитринаПробы;      // ВитринаПробыПочты (web-ui) — секция «отправить проверочное письмо»
Перем СервисПрав;        // СервисПрав (auth) — права на создание пула и на основной пул
Перем СервисПулов;       // СервисПулов (реестр) — пулы инсталляции
Перем Числа;             // ПриведениеЧисел (основа) — терпимое чтение числа

#Область ПубличныйИнтерфейс

// Секции раздела дома «Хаб»: настройки из реестра, затем витрины, у которых записи
// в реестре нет.
//
// Параметры:
//  Параметры - Структура: * Ключ - Строка - ключ раздела; * Токен - Строка - CSRF-токен сессии; * Пользователь - Пользователь, Неопределено - смотрящий; * Спросить - Произвольный, Неопределено - предмет вопроса, заданного пультом; * Окно - Произвольный, Неопределено - витрина пульта, задавшего вопрос; * Обзор - Структура, Неопределено - обстановка раздела «Пулы» (Отбор, Пул, Заведение).
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Ключ = Параметры.Ключ;
	Токен = Параметры.Токен;
	Обзор = Параметры.Обзор;

	Результат = Новый Массив();

	// окно подтверждения — первой секцией: оно и есть то, чего ждут от страницы;
	// печатает его витрина того пульта, который задал вопрос
	Если Параметры.Спросить <> Неопределено И Параметры.Окно <> Неопределено Тогда
		Результат.Добавить(Параметры.Окно.СекцияПодтверждения(Параметры.Спросить,
			Дом.АдресРаздела(Ключ), Токен));
	КонецЕсли;

	Для Каждого Секция Из Витрина.Секции(Ключ, Дом.ПодписьРаздела(Ключ), Дом.ЛидРаздела(Ключ),
		Дом.АдресРаздела(Ключ), Токен) Цикл
		Результат.Добавить(Секция);
	КонецЦикла;

	// экран, ещё живущий на прежнем адресе, достижим только отсюда: в дереве его пункта нет
	Прежние = Дом.ПрежниеЭкраны(Ключ);
	Если Прежние.Количество() > 0 Тогда
		Результат.Добавить(Сведения.СекцияПрежнихЭкранов(Прежние));
	КонецЕсли;

	Если Ключ = "identity" Тогда
		Результат.Добавить(Сведения.СекцияВерсии());
	ИначеЕсли Ключ = "storage" Тогда
		Результат.Добавить(ВитринаХранилища.Секция());
	ИначеЕсли Ключ = "branding" Тогда
		Результат.Добавить(ВитринаБренда.Секция(Дом.АдресРаздела(Ключ), Токен,
			Витрина.ИмяПоляОперации()));
	ИначеЕсли Ключ = "mail" Тогда
		Результат.Добавить(ВитринаПробы.Секция(Дом.АдресРаздела(Ключ), Токен,
			АдресУчётки(Параметры.Пользователь)));
	ИначеЕсли Ключ = "mirrors" Тогда
		// числа репликации настраиваются здесь — отсюда же и вход в список самих зеркал
		Результат.Добавить(Сведения.СекцияОбзораЗеркал());
	ИначеЕсли Ключ = "password" Тогда
		// действующая политика словами — под её же полями: человек видит, что получилось
		Результат.Добавить(Сведения.СекцияПароля());
	ИначеЕсли Ключ = "pools" Тогда
		Результат.Добавить(Сведения.СекцияОсновногоПула());
		Для Каждого Секция Из СекцииПулов(Токен, Параметры.Пользователь, Обзор) Цикл
			Результат.Добавить(Секция);
		КонецЦикла;
	ИначеЕсли Ключ = "maintenance" Тогда
		Результат.Добавить(Сведения.СекцияОбслуживания());
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Куда уйдёт проверочное письмо: получателя называет учётка нажавшего, поля «кому» нет.
Функция АдресУчётки(Знач Пользователь)
	Возврат ?(Пользователь = Неопределено, "", СокрЛП(Строка(Пользователь.Email)));
КонецФункции

// Список пулов, кнопка заведения с окном и панель правки квоты. Порог раздела — админ
// хаба (гвард дома), но каждая операция сверх того судится своим правом: суперправо
// не отменяет модель.
Функция СекцииПулов(Знач Токен, Знач Пользователь, Знач Обзор)

	Отбор = ?(Обзор = Неопределено, "", Обзор.Отбор);

	Правка = Неопределено;
	Если Обзор <> Неопределено И ЗначениеЗаполнено(Обзор.Пул) Тогда
		Правка = СервисПулов.ПулПоИдентификатору(Числа.ЧислоИлиНоль(Обзор.Пул));
	КонецЕсли;

	Возврат ВитринаПулов.Секции(Новый Структура(
		"Пулы, Адрес, Токен, Отбор, Правка, МожетСоздавать, МожетНазначать, Заведение",
		СервисПулов.ВсеПулы(), Дом.АдресРаздела("pools"), Токен, Отбор, Правка,
		СервисПрав.МожетСоздаватьПул(Пользователь),
		СервисПрав.МожетНазначатьОсновнойПул(Пользователь),
		?(Обзор = Неопределено, Неопределено, Обзор.Заведение)));

КонецФункции

#КонецОбласти

&Прозвище("ВитринаДомаХаба")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ВитринаНастроек") _Витрина,
	&Пластилин(Значение = "ВитринаПулов") _ВитринаПулов,
	&Пластилин(Значение = "ВитринаБрендирования") _ВитринаБренда,
	&Пластилин(Значение = "ВитринаСведенийХаба") _Сведения,
	&Пластилин(Значение = "ВитринаХранилища") _ВитринаХранилища,
	&Пластилин(Значение = "ВитринаПробыПочты") _ВитринаПробы,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа) Экспорт

	Дом = _Дом;
	Витрина = _Витрина;
	ВитринаПулов = _ВитринаПулов;
	ВитринаБренда = _ВитринаБренда;
	Сведения = _Сведения;
	ВитринаХранилища = _ВитринаХранилища;
	ВитринаПробы = _ВитринаПробы;
	СервисПрав = _СервисПрав;
	СервисПулов = _СервисПулов;
	Числа = _Числа;

КонецПроцедуры
