// Витрина дома «Хаб» — желудь модуля web-ui: из каких секций и в каком порядке состоит
// каждый его раздел. Контроллер решает, ЧТО показать, витрина — КАК.

Перем Дом;               // ДомХаба (web-ui) — адреса и подписи разделов
Перем Витрина;           // ВитринаНастроек (web-ui) — карточки и формы из реестра
Перем ВитринаПулов;      // ВитринаПулов (web-ui) — раздел «Пулы»
Перем ВитринаБренда;     // ВитринаБрендирования (web-ui) — секция картинок оформления
Перем Сведения;          // ВитринаСведенийХаба (web-ui) — секции вне реестра
Перем ВитринаХранилища;  // ВитринаХранилища (web-ui) — состояние хранилища словами
Перем ВитринаПробы;      // ВитринаПробыПочты (web-ui) — секция «отправить проверочное письмо»
Перем СервисПрав;        // СервисПрав (auth) — права на создание пула и на основной пул
Перем СервисПулов;       // СервисПулов (реестр) — пулы инсталляции
Перем Числа;             // ПриведениеЧисел (основа) — терпимое чтение числа
Перем Состав;            // ключи разделов, которым есть что показать сверх реестра

#Область ПубличныйИнтерфейс

// Секции раздела дома «Хаб»: настройки из реестра, затем витрины, у которых записи
// в реестре нет.
//
// Параметры:
//  Параметры - Структура:
//    * Ключ - Строка - ключ раздела;
//    * Токен - Строка - CSRF-токен сессии;
//    * Пользователь - Пользователь, Неопределено - смотрящий;
//    * Спросить - Произвольный, Неопределено - предмет вопроса, заданного пультом;
//    * Окно - Произвольный, Неопределено - витрина пульта, задавшего вопрос;
//    * Обзор - Структура, Неопределено - обстановка раздела «Пулы» (Отбор, Пул, Заведение).
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Результат = Новый Массив();

	Добавить(Результат, ВопросПульта(Параметры));
	Добавить(Результат, ЗначенияРеестра(Параметры));
	Добавить(Результат, ПрежниеЭкраны(Параметры.Ключ));
	Добавить(Результат, СекцииВнеРеестра(Параметры));

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СекцииРаздела

// Окно подтверждения первой секцией: печатает его витрина того пульта, который задал вопрос.
Функция ВопросПульта(Знач Параметры)

	Если Параметры.Спросить = Неопределено ИЛИ Параметры.Окно = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Возврат Одна(Параметры.Окно.СекцияПодтверждения(Параметры.Спросить,
		Дом.АдресРаздела(Параметры.Ключ), Параметры.Токен));

КонецФункции

Функция ЗначенияРеестра(Знач Параметры)

	Ключ = Параметры.Ключ;

	Возврат Витрина.Секции(Ключ, Дом.ПодписьРаздела(Ключ), Дом.ЛидРаздела(Ключ),
		Дом.АдресРаздела(Ключ), Параметры.Токен);

КонецФункции

// Экран, ещё живущий на прежнем адресе, достижим только отсюда: в дереве его пункта нет.
Функция ПрежниеЭкраны(Знач Ключ)

	Прежние = Дом.ПрежниеЭкраны(Ключ);

	Возврат ?(Прежние.Количество() = 0, Новый Массив(),
		Одна(Сведения.СекцияПрежнихЭкранов(Прежние)));

КонецФункции

// Состав дома и СвоиСекции разошлись — падаем: тихое расхождение снимает секцию с экрана.
Функция СекцииВнеРеестра(Знач Параметры)

	Ключ = Параметры.Ключ;
	Объявлен = (Состав.Найти(Ключ) <> Неопределено);
	Свои = СвоиСекции(Ключ, Параметры);

	Если Объявлен И Свои = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Витрина дома «Хаб»: раздел «%1» объявлен в составе,"
			+ " но печатать сверх реестра ему нечего.", Ключ);
	КонецЕсли;
	Если НЕ Объявлен И Свои <> Неопределено Тогда
		ВызватьИсключение СтрШаблон("Витрина дома «Хаб»: раздел «%1» печатает свои секции,"
			+ " но в составе дома не объявлен.", Ключ);
	КонецЕсли;

	Возврат ?(Свои = Неопределено, Новый Массив(), Свои);

КонецФункции

// Что раздел показывает сверх значений реестра; Неопределено — ничего.
Функция СвоиСекции(Знач Ключ, Знач Параметры)

	Если Ключ = "identity" Тогда
		Возврат Одна(Сведения.СекцияВерсии());
	ИначеЕсли Ключ = "storage" Тогда
		Возврат Одна(ВитринаХранилища.Секция());
	ИначеЕсли Ключ = "branding" Тогда
		Возврат Одна(ВитринаБренда.Секция(Дом.АдресРаздела(Ключ), Параметры.Токен,
			Витрина.ИмяПоляОперации()));
	ИначеЕсли Ключ = "mail" Тогда
		Возврат Одна(ВитринаПробы.Секция(Дом.АдресРаздела(Ключ), Параметры.Токен,
			АдресУчётки(Параметры.Пользователь)));
	ИначеЕсли Ключ = "mirrors" Тогда
		Возврат Одна(Сведения.СекцияОбзораЗеркал());
	ИначеЕсли Ключ = "password" Тогда
		Возврат Одна(Сведения.СекцияПароля());
	ИначеЕсли Ключ = "pools" Тогда
		Возврат СекцииПулов(Параметры);
	ИначеЕсли Ключ = "maintenance" Тогда
		Возврат Одна(Сведения.СекцияОбслуживания());
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Порог раздела — админ хаба, но каждая операция сверх того судится своим правом.
Функция СекцииПулов(Знач Параметры)

	Обзор = Параметры.Обзор;
	Отбор = ?(Обзор = Неопределено, "", Обзор.Отбор);

	Правка = Неопределено;
	Если Обзор <> Неопределено И ЗначениеЗаполнено(Обзор.Пул) Тогда
		Правка = СервисПулов.ПулПоИдентификатору(Числа.ЧислоИлиНоль(Обзор.Пул));
	КонецЕсли;

	Результат = Одна(Сведения.СекцияОсновногоПула());
	Добавить(Результат, ВитринаПулов.Секции(Новый Структура(
		"Пулы, Адрес, Токен, Отбор, Правка, МожетСоздавать, МожетНазначать, Заведение",
		СервисПулов.ВсеПулы(), Дом.АдресРаздела("pools"), Параметры.Токен, Отбор, Правка,
		СервисПрав.МожетСоздаватьПул(Параметры.Пользователь),
		СервисПрав.МожетНазначатьОсновнойПул(Параметры.Пользователь),
		?(Обзор = Неопределено, Неопределено, Обзор.Заведение))));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Куда уйдёт проверочное письмо: получателя называет учётка нажавшего, поля «кому» нет.
Функция АдресУчётки(Знач Пользователь)
	Возврат ?(Пользователь = Неопределено, "", СокрЛП(Строка(Пользователь.Email)));
КонецФункции

Функция Одна(Знач Секция)

	Результат = Новый Массив();
	Результат.Добавить(Секция);
	Возврат Результат;

КонецФункции

Процедура Добавить(Результат, Знач Части)

	Для Каждого Часть Из Части Цикл
		Результат.Добавить(Часть);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

&Прозвище("ВитринаДомаХаба")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ВитринаНастроек") _Витрина,
	&Пластилин(Значение = "ВитринаПулов") _ВитринаПулов,
	&Пластилин(Значение = "ВитринаБрендирования") _ВитринаБренда,
	&Пластилин(Значение = "ВитринаСведенийХаба") _Сведения,
	&Пластилин(Значение = "ВитринаХранилища") _ВитринаХранилища,
	&Пластилин(Значение = "ВитринаПробыПочты") _ВитринаПробы,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа) Экспорт

	Дом = _Дом;
	Витрина = _Витрина;
	ВитринаПулов = _ВитринаПулов;
	ВитринаБренда = _ВитринаБренда;
	Сведения = _Сведения;
	ВитринаХранилища = _ВитринаХранилища;
	ВитринаПробы = _ВитринаПробы;
	СервисПрав = _СервисПрав;
	СервисПулов = _СервисПулов;
	Числа = _Числа;

	Состав = Новый Массив();
	Состав.Добавить("identity");
	Состав.Добавить("storage");
	Состав.Добавить("branding");
	Состав.Добавить("mail");
	// числа репликации настраиваются здесь — отсюда же и вход в список самих зеркал
	Состав.Добавить("mirrors");
	// действующая политика словами — под её же полями: человек видит, что получилось
	Состав.Добавить("password");
	Состав.Добавить("pools");
	Состав.Добавить("maintenance");

КонецПроцедуры
