// Провайдеры входа — контроллер модуля web-ui.

Перем ГвардХаб; // ГвардХабАдмина (кабинет)
Перем Ответы;   // ОтветыНастроек (web-ui)
Перем Дом;      // ДомХаба (web-ui)
Перем Витрина;  // ВитринаПровайдеровВхода (web-ui)
Перем Пульт;    // ПультПровайдеровВхода (web-ui)
Перем Защита;   // ЗащитаCSRF (auth)
Перем Отметка;  // ОтметкаСохранения (web-ui) — «сохранено» параметром на адресе

#Область ТочкиМаршрута

// Точка маршрута «providers» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  preset - Строка - пресет, поля которого показывает форма заведения (необязательный, по умолчанию "").
//  protocol - Строка - протокол «своего провайдера»: от него зависит его набор полей (необязательный, по умолчанию "").
//  countries - Строка - имя провайдера, чьё окно правила по стране открыто (необязательный, по умолчанию "").
//
&ТочкаМаршрута("providers")
Процедура Раздел(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	saved = "", preset = "", protocol = "", countries = "") Экспорт

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Вердикт, ЗначениеЗаполнено(saved), "", КукиЗапроса, 200,
			СостояниеРаздела(preset, protocol, ОкноПоАдресу(countries)));
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Вердикт, Пульт.Создать(Вердикт.Принципал, Форма), КукиЗапроса,
		СостояниеРаздела(Пульт.Пресет(Форма), Пульт.Протокол(Форма), Неопределено));

КонецПроцедуры

// Точка маршрута «providers/{имя}/save».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  имя - Строка - имя.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("providers/{имя}/save")
Процедура Сохранение(Ответ, имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Вердикт = ПодготовитьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Вердикт = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Вердикт.Вердикт,
		Пульт.Сохранить(Вердикт.Вердикт.Принципал, имя, Вердикт.Форма), КукиЗапроса,
		СостояниеРаздела("", "", Неопределено));

КонецПроцедуры

// Точка маршрута «providers/{имя}/toggle».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  имя - Строка - имя.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("providers/{имя}/toggle")
Процедура Переключение(Ответ, имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьДействие(Ответ, имя, "переключить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «providers/{имя}/delete».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  имя - Строка - имя.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("providers/{имя}/delete")
Процедура Удаление(Ответ, имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьДействие(Ответ, имя, "удалить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «providers/{имя}/countries».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  имя - Строка - имя.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("providers/{имя}/countries")
Процедура ЗакрытыеСтраны(Ответ, имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Вердикт = ПодготовитьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Вердикт = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Исход = Пульт.ЗакрытьПоСтранам(Вердикт.Вердикт.Принципал, имя, Вердикт.Форма);
	Завершить(Ответ, Вердикт.Вердикт, Исход, КукиЗапроса, СостояниеРаздела("", "", Исход.Окно));

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура ВыполнитьДействие(Ответ, Знач Имя, Знач Действие,
	Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)

	Вердикт = ПодготовитьМутацию(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Вердикт = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Вердикт.Вердикт,
		Пульт.Применить(Вердикт.Вердикт.Принципал, Действие, Имя, Вердикт.Форма), КукиЗапроса,
		СостояниеРаздела("", "", Неопределено));

КонецПроцедуры

// Общий пролог мутирующих точек: гвард → только POST → форма с CSRF.
Функция ПодготовитьМутацию(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач МетодЗапроса, Знач ТелоЗапроса)

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "POST", Вердикт.Пользователь, КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Вердикт, Форма", Вердикт, Форма);

КонецФункции

// Исход домена → ответ.
Процедура Завершить(Ответ, Знач Вердикт, Знач Исход, Знач КукиЗапроса, Знач Состояние)

	Если НЕ Исход.Успех Тогда
		// отказ, уже помеченный в поле открытого окна, баннером над разделом не повторяется:
		// одну и ту же причину человек читает один раз, и там, где он набирал
		ОтдатьРаздел(Ответ, Вердикт, Ложь, ?(Состояние.Геоокно = Неопределено, Исход.Сообщение, ""),
			КукиЗапроса, Исход.Код, Состояние);
		Возврат;
	КонецЕсли;
	Ответ.Перенаправить(Отметка.НаАдресе(Дом.АдресРаздела("providers")));

КонецПроцедуры

// Чем раздел отличается от своего умолчания: выбранный пресет, выбранный протокол
// и открытое окно правила по стране. Ездят одним значением — три хвостовых аргумента
// у каждой точки маршрута помнить некому.
Функция СостояниеРаздела(Знач Пресет, Знач Протокол, Знач Геоокно)

	Возврат Новый Структура("Пресет, Протокол, Геоокно",
		Строка(Пресет), Строка(Протокол), Геоокно);

КонецФункции

// Имя провайдера в адресе означает «покажи страницу с уже открытым окном его правила»:
// кнопку-команду старый движок не сработает, поэтому дорога к окну серверная.
Функция ОкноПоАдресу(Знач ИмяПровайдера)

	Если НЕ ЗначениеЗаполнено(СокрЛП(Строка(ИмяПровайдера))) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Имя, Открыта, Заполнение, Отказы",
		СокрЛП(Строка(ИмяПровайдера)), Истина, Неопределено, Неопределено);

КонецФункции

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач Сохранено, Знач Ошибка, Знач КукиЗапроса,
	Знач Статус, Знач Состояние)

	Уведомления = Ответы.УведомленияРаздела(Сохранено, Ошибка);

	Параметры = Новый Структура();
	Параметры.Вставить("Адрес", Дом.АдресРаздела("providers"));
	Параметры.Вставить("Токен", Защита.ТокенСессии(Вердикт.Сессия));
	Параметры.Вставить("Пресет", Состояние.Пресет);
	Параметры.Вставить("Протокол", Состояние.Протокол);
	Параметры.Вставить("Геоокно", Состояние.Геоокно);

	Модель = Ответы.МодельДома(Дом, "",
		Дом.Разделы("providers"),
		Уведомления,
		Витрина.Секции(Параметры));

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт.Пользователь, КукиЗапроса, Дом.Заголовок(), Статус);

КонецПроцедуры

#КонецОбласти

&Контроллер("/hub/settings")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардХабАдмина") _ГвардХаб,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ВитринаПровайдеровВхода") _Витрина,
	&Пластилин(Значение = "ПультПровайдеровВхода") _Пульт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ОтметкаСохранения") _Отметка)

	ГвардХаб = _ГвардХаб;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	Пульт = _Пульт;
	Защита = _Защита;
	Отметка = _Отметка;

КонецПроцедуры
