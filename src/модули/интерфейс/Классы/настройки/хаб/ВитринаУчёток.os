// Раздел «Пользователи» дома «Хаб»: список учёток, заведение со ссылкой установки пароля,
// смена роли, блокировка и показ выпущенной ссылки. Контроллер решает ЧТО, витрина — КАК.

Перем Кит;                 // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;    // РендерерНастроек (кит)
Перем ФормаЗаведения;      // ФормаУчётки (web-ui) — окно заведения учётной записи
Перем Фабрика;             // Формы (кит) — объявление формы окна удаления
Перем Дом;                 // ДомХаба (web-ui)
Перем Учётки;              // СписокУчёток (auth) — отобранные учётки и способ входа у каждой
Перем СервисПользователей; // СервисПользователей (auth) — имена ролей
Перем Права;               // СервисПрав (auth) — кто из списка администратор

#Область Операции

// Значение поля «операция» для смены роли хаба.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияРоли() Экспорт
	Возврат "роль";
КонецФункции

// Значение поля «операция» для выпуска новой ссылки установки пароля.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияСброса() Экспорт
	Возврат "сброс";
КонецФункции

// Значение поля «операция» для блокировки и разблокировки учётной записи.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияАктивности() Экспорт
	Возврат "активность";
КонецФункции

// Имя операции «удалить учётную запись со всем связанным».
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияУдаления() Экспорт
	Возврат "удаление";
КонецФункции

#КонецОбласти

#Область Секции

// Секции раздела в порядке показа.
//
// Параметры:
//  Токен - Строка - CSRF-токен сессии.
//  Смотрящий - Пользователь - администратор, открывший раздел.
//  Состояние - Структура - Запрос (Строка — подстрока отбора), Подтверждение (Структура
//              Цель, Роль либо Неопределено), Выпуск (Структура Логин, Ссылка либо
//              Неопределено), Форма (Структура Открыта, Заполнение, Отказы — состояние
//              окна заведения; Неопределено — окно закрыто и пусто).
//
// Возвращаемое значение:
//  Массив - описания секций РендерераНастроек.
//
Функция Секции(Знач Токен, Знач Смотрящий, Знач Состояние) Экспорт

	Подстрока = СокрЛП(Строка(Состояние.Запрос));
	Секции = Новый Массив();

	Если Состояние.Выпуск <> Неопределено Тогда
		Секции.Добавить(СекцияСсылки(Состояние.Выпуск));
	КонецЕсли;
	Если Состояние.Подтверждение <> Неопределено Тогда
		Секции.Добавить(СекцияПодтвержденияРоли(Токен, Состояние.Подтверждение, Подстрока));
	КонецЕсли;

	Секции.Добавить(СекцияСписка(Токен, Смотрящий, Состояние.Форма, Подстрока));

	Возврат Секции;

КонецФункции

// Пока не нажали, форма заведения места не занимает; как окно устроено, витрина не знает.
Функция СекцияСписка(Знач Токен, Знач Смотрящий, Знач Форма, Знач Подстрока)

	Список = Кит.Холст();
	Список.Добавить(ОкноЗаведения(Токен, Форма, Подстрока));
	Список.Добавить(ФормаПоиска(Подстрока));
	Список.Добавить(ТаблицаУчёток(Токен, Смотрящий, Подстрока));

	Возврат РендерерНастроек.Секция("Пользователи хаба",
		"Учётные записи инсталляции. Себя заблокировать и снять с себя роль администратора"
		+ " нельзя — защита от само-локаута.", Список.Рендер());

КонецФункции

// Ссылку показывают ровно один раз: в базе её нет, восстановить нечем.
Функция СекцияСсылки(Знач Выпуск)

	Показ = Кит.Холст();
	Показ.Добавить(ВыпущеннаяСсылка(Выпуск));
	Показ.Добавить(Кит.Примечание("Второй раз эта ссылка не покажется: хаб хранит только её"
		+ " отпечаток. Если ссылка потеряется, выпустите новую кнопкой «Сбросить пароль»."));

	Секция = РендерерНастроек.Секция("Ссылка установки пароля выпущена", "", Показ.Рендер());
	Секция.Иконка = "ключ";
	Возврат Секция;

КонецФункции

Функция ВыпущеннаяСсылка(Знач Выпуск)

	Возврат Кит.БлокКоманды(Новый Структура("Команда, Пояснение", Строка(Выпуск.Ссылка),
		СтрШаблон("Ссылка для «%1». Передайте её человеку любым способом:"
			+ " почты хаб не отправляет.", Строка(Выпуск.Логин))));

КонецФункции

// Путь без скрипта; со скриптом до него не доходит — вопрос задаёт диалог.
Функция СекцияПодтвержденияРоли(Знач Токен, Знач Подтверждение, Знач Подстрока)

	Пользователь = Подтверждение.Цель;
	Роль = Подтверждение.Роль;
	Идентификатор = Идентификатором(Пользователь);

	Вопрос = Кит.Холст();
	Вопрос.Добавить(Кит.СкрытоеПоле("операция", ОперацияРоли()));
	Вопрос.Добавить(Кит.СкрытоеПоле("пользователь", Идентификатор));
	Вопрос.Добавить(Кит.СкрытоеПоле("роль", Роль));
	Вопрос.Добавить(Кит.СкрытоеПоле("q", Подстрока));
	Вопрос.Добавить(Кит.СкрытоеПоле("подтверждение", Идентификатор));
	Вопрос.Добавить(Кит.Примечание(ВопросРоли(Роль, Пользователь.Логин)));

	Секция = РендерерНастроек.Секция("Подтвердите смену роли",
		"Роль администратора даёт полные права на всю инсталляцию: все пулы, все пакеты"
		+ " и все учётные записи.", Вопрос.Рендер());
	Секция.Иконка = "предупреждение";
	Секция.Действие = Дом.АдресРаздела("users");
	Секция.Токен = Токен;
	Секция.Кнопка = ПодписьРоли(Роль);
	Секция.Опасная = ЭтоВыдачаРоли(Роль);
	// «Отмена» — обычная ссылка на тот же список: возврат ничего не меняет
	Секция.АдресОтмены = Дом.АдресРаздела("users") + ХвостПоиска(Подстрока, "");
	Возврат Секция;

КонецФункции

Функция ОкноЗаведения(Знач Токен, Знач Форма, Знач Подстрока)

	Модель = Новый Структура("Адрес, Токен, Отбор", Дом.АдресРаздела("users"), Токен, Подстрока);
	Если Форма <> Неопределено Тогда
		// отбитая форма возвращается ТЕМ ЖЕ окном: с набранным и помеченным полем
		Модель.Вставить("Открыта", Форма.Открыта);
		Модель.Вставить("Заполнение", Форма.Заполнение);
		Модель.Вставить("Отказы", Форма.Отказы);
	КонецЕсли;

	Возврат ФормаЗаведения.Окно(Модель);

КонецФункции

// GET-форма отбора: состояние списка живёт в адресе, страница работает без JS.
Функция ФормаПоиска(Знач Подстрока)

	Возврат Кит.СтрокаПоиска(
		Новый Структура("Действие, Имя, Метка, Значение, Плейсхолдер, Кнопка, Иконка",
			Дом.АдресРаздела("users"), "q", "Поиск", Подстрока, "Логин или email",
			"Найти", "поиск"));

КонецФункции

#КонецОбласти

#Область ТаблицаУчёток

Функция ТаблицаУчёток(Знач Токен, Знач Смотрящий, Знач Подстрока)

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка("Логин"));
	Таблица.Добавить(Кит.Колонка("Email"));
	Таблица.Добавить(Кит.Колонка("Роль"));
	Таблица.Добавить(Кит.Колонка("Статус"));
	Таблица.Добавить(Кит.Колонка("Действие"));

	Для Каждого Учётка Из Учётки.Отобранные(Подстрока) Цикл
		Таблица.Добавить(ЗаписьУчётки(Токен, Смотрящий, Учётка, Подстрока));
	КонецЦикла;

	Таблица.Пусто().Добавить(НичегоНет(ПустаяВыдача(Подстрока)));
	Возврат Таблица;

КонецФункции

// Учётку и ответ «есть чем войти» приносит домен одной строкой: ответ нужен и плашке,
// и кнопке, а спрошенный на строку он стоил бы запроса на строку.
Функция ЗаписьУчётки(Знач Токен, Знач Смотрящий, Знач Учётка, Знач Подстрока)

	Пользователь = Учётка.Пользователь;
	ЕстьВход = Учётка.ЕстьВход;

	Запись = Кит.Запись();
	Запись.Добавить(Ячейка(Пользователь.Логин));
	Запись.Добавить(Ячейка(Пользователь.Email));
	Запись.Добавить(Ячейка(Пользователь.РольХаба));
	Запись.Добавить(Состояние(Пользователь, ЕстьВход));
	Запись.Добавить(Действия(Токен, Смотрящий, Пользователь, Подстрока, ЕстьВход));
	Возврат Запись;

КонецФункции

Функция Состояние(Знач Пользователь, Знач ЕстьВход)

	Активен = (Пользователь.Активен = Истина);

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Плашка(Новый Структура("Текст, Вид",
		?(Активен, "активен", "заблокирован"), ?(Активен, "ok", "warn"))));

	Если Пользователь.ТребуетсяСменаПароля = Истина Тогда
		Результат.Добавить(Кит.Плашка("смена пароля"));
	КонецЕсли;
	Если НЕ ЕстьВход Тогда
		Результат.Добавить(Кит.Плашка("нечем войти"));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Своя строка действий не получает вовсе: и блокировка, и снятие роли себе — само-локаут.
Функция Действия(Знач Токен, Знач Смотрящий, Знач Пользователь, Знач Подстрока, Знач ЕстьВход)

	Результат = Кит.Ячейка();
	Если Цел(Пользователь.Идентификатор) = Цел(Смотрящий.Идентификатор) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Добавить(Кит.Меню(Новый Структура("Подпись, Иконка, Пункты",
		СтрШаблон("Действия над «%1»", Строка(Пользователь.Логин)), "шестерёнка",
		ПунктыДействий(Токен, Пользователь, Подстрока, ЕстьВход))));

	Возврат Результат;

КонецФункции

// Пункт меню — целая форма: каждое действие несёт свой токен и своё подтверждение.
Функция ПунктыДействий(Знач Токен, Знач Пользователь, Знач Подстрока, Знач ЕстьВход)

	Результат = Новый Массив();
	Добавить(Результат, ФормаАктивности(Токен, Пользователь, Подстрока, ЕстьВход));
	Добавить(Результат, ФормаРоли(Токен, Пользователь, Подстрока));
	Добавить(Результат, ФормаСброса(Токен, Пользователь, Подстрока));
	Добавить(Результат, ФормаУдаления(Токен, Пользователь, Подстрока));
	Возврат Результат;

КонецФункции

// Пустой холст пунктом не становится: меню с пустым пунктом рисовало бы разделитель в никуда.
Процедура Добавить(Пункты, Знач Форма)

	Разметка = Форма.Рендер();
	Если НЕ ЗначениеЗаполнено(Разметка) Тогда
		Возврат;
	КонецЕсли;

	Пункты.Добавить(Новый Структура("HTML", Разметка));

КонецПроцедуры

// Логин НАБИРАЮТ РУКАМИ в окне поверх экрана; набранное сверяет сервер, а не браузер.
Функция ФормаУдаления(Знач Токен, Знач Пользователь, Знач Подстрока)

	Логин = Строка(Пользователь.Логин);

	Объявление = Фабрика.Новая()
		.Блок(Кит.Примечание(ПредупреждениеУдаления(Логин)).Рендер())
		.Блок(Кит.СкрытоеПоле("операция", ОперацияУдаления()).Рендер())
		.Блок(Кит.СкрытоеПоле("пользователь", Идентификатором(Пользователь)).Рендер())
		.Блок(Кит.СкрытоеПоле("q", Подстрока).Рендер())
		.Поле("подтверждение", "Логин удаляемой учётной записи", "строка",
			Новый Структура("Обязательное, Подсказка", Истина,
				СтрШаблон("Наберите «%1», чтобы подтвердить удаление", Логин)));

	Возврат Кит.Окно(Объявление, Неопределено, Дом.АдресРаздела("users"), Токен,
		ОформлениеУдаления(Логин));

КонецФункции

Функция ОформлениеУдаления(Знач Логин)

	Результат = Новый Структура();
	Результат.Вставить("Заголовок", СтрШаблон("Удалить «%1»?", Логин));
	Результат.Вставить("Лид", "Действие необратимо.");
	Результат.Вставить("Открывашка", "Удалить");
	Результат.Вставить("ИконкаОткрывашки", "корзина");
	Результат.Вставить("Отмена", "Отмена");
	Результат.Вставить("Отправка", СтрШаблон("Удалить «%1»", Логин));
	Результат.Вставить("Опасная", Истина);
	Возврат Результат;

КонецФункции

Функция ПредупреждениеУдаления(Знач Логин)

	Возврат СтрШаблон("Уйдёт всё, что привязано к «%1»: сессии, ключи доступа, привязанные"
		+ " провайдеры и личное пространство с пакетами. Опубликованное в общих пулах"
		+ " останется, но станет безымянным. Вернуть удалённое будет нечем.", Логин);

КонецФункции

// У учётки без способа входа кнопки разблокировки нет: домен такую активацию не примет.
Функция ФормаАктивности(Знач Токен, Знач Пользователь, Знач Подстрока, Знач ЕстьВход)

	Активен = (Пользователь.Активен = Истина);
	Если НЕ Активен И НЕ ЕстьВход Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Форма = СтрокаФормы(Токен);
	Форма.Добавить(Кит.СкрытоеПоле("операция", ОперацияАктивности()));
	Форма.Добавить(Кит.СкрытоеПоле("пользователь", Идентификатором(Пользователь)));
	Форма.Добавить(Кит.СкрытоеПоле("q", Подстрока));
	Форма.Добавить(Кнопка(?(Активен, "Заблокировать", "Разблокировать"),
		?(Активен, "опасная", "вторичная")));

	Возврат Форма;

КонецФункции

Функция ФормаСброса(Знач Токен, Знач Пользователь, Знач Подстрока)

	// поля подтверждения у выпуска нет: сервер сверяет не эхо, а право и саму учётку
	Форма = ФормаСВопросом(Токен,
		СтрШаблон("Выпустить «%1» новую ссылку установки пароля? Прежняя перестанет работать.",
			Строка(Пользователь.Логин)), "", "");

	Форма.Добавить(Кит.СкрытоеПоле("операция", ОперацияСброса()));
	Форма.Добавить(Кит.СкрытоеПоле("пользователь", Идентификатором(Пользователь)));
	Форма.Добавить(Кит.СкрытоеПоле("q", Подстрока));
	Форма.Добавить(Кнопка("Сбросить пароль", "вторичная"));

	Возврат Форма;

КонецФункции

// Роль двусторонняя, иначе выдача администратора была бы необратима через интерфейс.
Функция ФормаРоли(Знач Токен, Знач Пользователь, Знач Подстрока)

	Желаемая = ЖелаемаяРоль(Права.ПользовательАдмин(Пользователь));
	Идентификатор = Идентификатором(Пользователь);

	// значение подтверждения — идентификатор учётки: форма одной строки не меняет соседнюю
	Форма = ФормаСВопросом(Токен, ВопросРоли(Желаемая, Пользователь.Логин),
		"подтверждение", Идентификатор);

	Форма.Добавить(Кит.СкрытоеПоле("операция", ОперацияРоли()));
	Форма.Добавить(Кит.СкрытоеПоле("пользователь", Идентификатор));
	Форма.Добавить(Кит.СкрытоеПоле("роль", Желаемая));
	Форма.Добавить(Кит.СкрытоеПоле("q", Подстрока));
	Форма.Добавить(Кнопка(ПодписьРоли(Желаемая),
		?(ЭтоВыдачаРоли(Желаемая), "опасная", "вторичная")));

	Возврат Форма;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Хвост адреса с текущим отбором: перенаправление после мутации возвращает админа
// к тому же списку, что он видел.
//
// Параметры:
//  Подстрока - Строка - подстрока отбора.
//  Разделитель - Строка - "&", если в адресе уже есть параметры, иначе "".
//
// Возвращаемое значение:
//  Строка.
//
Функция ХвостПоиска(Знач Подстрока, Знач Разделитель) Экспорт

	Значение = СокрЛП(Строка(Подстрока));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат ?(ЗначениеЗаполнено(Разделитель), Разделитель, "?")
		+ "q=" + КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);

КонецФункции

// Роль, в которую переведёт кнопка: у администратора — обычный пользователь, и наоборот.
//
// Параметры:
//  Админ - Булево - администратор ли учётка сейчас.
//
// Возвращаемое значение:
//  Строка.
//
Функция ЖелаемаяРоль(Знач Админ) Экспорт
	Возврат ?(Админ, СервисПользователей.РольПользователь(), СервисПользователей.РольАдмин());
КонецФункции

Функция СтрокаФормы(Знач Токен)
	Возврат Кит.Форма(Дом.АдресРаздела("users"), Токен, "строкой");
КонецФункции

// Без скрипта форма уходит как есть, и тот же вопрос задаёт сервер отдельным шагом.
Функция ФормаСВопросом(Знач Токен, Знач Вопрос, Знач Поле, Знач Значение)

	Возврат СтрокаФормы(Токен)
		.Признак("confirm", Вопрос)
		.Признак("confirm-field", Поле)
		.Признак("confirm-value", Значение);

КонецФункции

Функция Кнопка(Знач Подпись, Знач Вариант)

	Возврат Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Подпись, Вариант, "малый"));

КонецФункции

Функция Ячейка(Знач Значение)

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Текст(Значение));
	Возврат Результат;

КонецФункции

Функция НичегоНет(Знач Текст)
	Возврат Кит.Примечание(Текст, "пусто");
КонецФункции

Функция ПустаяВыдача(Знач Подстрока)
	Если ЗначениеЗаполнено(Подстрока) Тогда
		Возврат СтрШаблон("По запросу «%1» ничего не найдено.", Подстрока);
	КонецЕсли;
	Возврат "Учётных записей нет.";
КонецФункции

// Подпись и вопрос описывают ЗАПРОШЕННУЮ роль: подтверждают то, что произойдёт.
Функция ЭтоВыдачаРоли(Знач Роль)
	Возврат Роль = СервисПользователей.РольАдмин();
КонецФункции

Функция ПодписьРоли(Знач Роль)
	Возврат ?(ЭтоВыдачаРоли(Роль), "Сделать администратором", "Снять администратора");
КонецФункции

Функция ВопросРоли(Знач Роль, Знач Логин)
	Если ЭтоВыдачаРоли(Роль) Тогда
		Возврат СтрШаблон("Выдать «%1» права администратора хаба?", Строка(Логин));
	КонецЕсли;
	Возврат СтрШаблон("Снять права администратора с «%1»?", Строка(Логин));
КонецФункции

Функция Идентификатором(Знач Пользователь)
	Возврат Формат(Цел(Пользователь.Идентификатор), "ЧГ=0; ЧН=0");
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ФормаУчётки") _ФормаЗаведения,
	&Пластилин(Значение = "Формы") _Фабрика,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "СписокУчёток") _Учётки,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "СервисПрав") _Права)

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	ФормаЗаведения = _ФормаЗаведения;
	Фабрика = _Фабрика;
	Дом = _Дом;
	Учётки = _Учётки;
	СервисПользователей = _СервисПользователей;
	Права = _Права;

КонецПроцедуры
