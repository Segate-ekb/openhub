// Пульт парольного входа — желудь модуля web-ui: тумблер oshub.auth.password.enabled
// в разделе «Аутентификация» дома «Хаб», выключение — через опасную зону с эхом.

Перем РазборФормы;   // РазборФормы (web-ui)
Перем Политика;      // ПолитикаПарольногоВхода (auth) — действующее состояние
Перем Страж;         // СтражПарольногоВхода (auth) — предохранитель и запись значения
Перем Раскладка;     // РаскладкаНастроекХаба (web-ui) — раздел ключа
Перем Поля;          // ПоляНастроек (web-ui) — имя поля тумблера и значение «включено»
Перем Окно;          // ВитринаПарольногоВхода (web-ui) — имена полей подтверждения
Перем ФабрикаИтога;  // ИтогПульта (web-ui) — единая форма итога операции
Перем Ошибки;        // ТекстОшибки (основа) — описание исключения одной строкой
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Ключ настройки, которой распоряжается пульт.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючНастройки() Экспорт
	Возврат Политика.КлючНастройки();
КонецФункции

// Разбирает POST раздела и, если он касается парольного входа, распоряжается им сам.
//
// Параметры:
//  Раздел - Строка - ключ раздела дома «Хаб».
//  Форма - Соответствие - разобранная форма.
//  Кто - Строка - принципал сессии.
//
// Возвращаемое значение:
//  Структура - Перехвачено (Булево: Ложь — раздел обрабатывается общим путём),
//              Ошибка (Строка: "" — отказа нет), Спросить (Структура вердикта
//              предохранителя либо Неопределено — подтверждение не нужно),
//              Уведомление (Строка: итог выполненной операции, "" — операции не было),
//              Окно (объект, печатающий секцию подтверждения).
//
Функция Применить(Знач Раздел, Знач Форма, Знач Кто) Экспорт

	Если Раздел <> Раскладка.РазделКлюча(КлючНастройки()) Тогда
		Возврат Мимо();
	КонецЕсли;

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, Окно.ИмяПоляОперации())));

	Если Операция = Окно.ЗначениеОперации() Тогда
		Возврат Выключить(Форма, Кто);
	КонецЕсли;

	Если ЗначениеЗаполнено(Операция) Тогда
		// прочие операции раздела (сброс, белый список) — не наше дело
		Возврат Мимо();
	КонецЕсли;

	Возврат ПоТумблеру(Форма, Кто);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обычная форма раздела: тумблер всегда присылает значение (парное скрытое поле),
// поэтому «поля нет» означает «настройка в форме не печаталась» — правит её не пульт.
Функция ПоТумблеру(Знач Форма, Знач Кто)

	ИмяПоля = Поля.ИмяПоля(КлючНастройки());
	Если Форма.Получить(ИмяПоля) = Неопределено Тогда
		Возврат Мимо();
	КонецЕсли;

	Желаемое = РазборФормы.Флажок(Форма, ИмяПоля, Поля.ЗначениеВключено());
	Если Желаемое = Политика.Включён() Тогда
		Возврат Мимо();
	КонецЕсли;

	Если Желаемое Тогда
		Возврат Включить(Кто);
	КонецЕсли;

	// предохранитель спрашивается ДО окна подтверждения: подтверждать нечего там,
	// где операция запрещена по существу
	Вердикт = Страж.ПроверитьВыключение();
	Если НЕ Вердикт.Можно Тогда
		Возврат Отказ(ТекстОтказаПредохранителя(Вердикт));
	КонецЕсли;

	Результат = Успех();
	Результат.Спросить = Вердикт;
	Возврат Результат;

КонецФункции

Функция Включить(Знач Кто)

	Попытка
		Страж.Включить(Кто);
	Исключение
		Возврат Отказ(Тексты.Шаблон("settings.hub.passwordlogin.error.apply",
			Ошибки.Кратко(ОписаниеОшибки())));
	КонецПопытки;

	Результат = Успех();
	Результат.Уведомление = Тексты.Текст("settings.hub.passwordlogin.on.done");
	Возврат Результат;

КонецФункции

// Вердикт пересчитывается ЗАНОВО: между вопросом и ответом администратор мог отвязать
// свою личность или выключить провайдера, а подтверждать надо то, что происходит сейчас.
Функция Выключить(Знач Форма, Знач Кто)

	// операция живёт только как ПЕРЕХОД: при выключенном входе гасить нечего,
	// а форма подтверждения превратилась бы в бессрочную кнопку
	Если НЕ Политика.Включён() Тогда
		Возврат Отказ(Тексты.Текст("settings.hub.passwordlogin.error.off"));
	КонецЕсли;

	Вердикт = Страж.ПроверитьВыключение();
	Если НЕ Вердикт.Можно Тогда
		Возврат Отказ(ТекстОтказаПредохранителя(Вердикт));
	КонецЕсли;

	Если НРег(СокрЛП(РазборФормы.Поле(Форма, Окно.ИмяПоляЭха()))) <> НРег(Окно.ОбразецЭха()) Тогда
		Результат = Отказ(Тексты.Шаблон("settings.hub.passwordlogin.error.echo", Окно.ОбразецЭха()));
		Результат.Спросить = Вердикт;
		Возврат Результат;
	КонецЕсли;

	Попытка
		Страж.Выключить(Кто);
	Исключение
		Возврат Отказ(Тексты.Шаблон("settings.hub.passwordlogin.error.apply",
			Ошибки.Кратко(ОписаниеОшибки())));
	КонецПопытки;

	Результат = Успех();
	Результат.Уведомление = Тексты.Текст("settings.hub.passwordlogin.off.done");
	Возврат Результат;

КонецФункции

// Домен отдаёт код причины, экранный текст «чего не хватает» собирается здесь.
Функция ТекстОтказаПредохранителя(Знач Вердикт)

	Если Вердикт.Причина = Страж.ПричинаНетПровайдеров() Тогда
		Чего = Тексты.Текст("settings.hub.passwordlogin.lockout.providers");
	Иначе
		Чего = Тексты.Текст("settings.hub.passwordlogin.lockout.identities");
	КонецЕсли;
	Возврат Тексты.Шаблон("settings.hub.passwordlogin.error.lockout", Чего);

КонецФункции

Функция Мимо()
	Возврат Итог(Ложь, "");
КонецФункции

Функция Успех()
	Возврат Итог(Истина, "");
КонецФункции

Функция Отказ(Знач Сообщение)
	Возврат Итог(Истина, Сообщение);
КонецФункции

Функция Итог(Знач Перехвачено, Знач Ошибка)
	Результат = ?(Перехвачено, ФабрикаИтога.Отказ(Ошибка), ФабрикаИтога.Мимо());
	Результат.Окно = Окно;
	Возврат Результат;
КонецФункции

#КонецОбласти

&Прозвище("ПультПарольногоВхода")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _Политика,
	&Пластилин(Значение = "СтражПарольногоВхода") _Страж,
	&Пластилин(Значение = "РаскладкаНастроекХаба") _Раскладка,
	&Пластилин(Значение = "ПоляНастроек") _Поля,
	&Пластилин(Значение = "ВитринаПарольногоВхода") _Окно,
	&Пластилин(Значение = "ИтогПульта") _ФабрикаИтога,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	Политика = _Политика;
	Страж = _Страж;
	Раскладка = _Раскладка;
	Поля = _Поля;
	Окно = _Окно;
	ФабрикаИтога = _ФабрикаИтога;
	Ошибки = _Ошибки;
	Тексты = _Тексты;

КонецПроцедуры
