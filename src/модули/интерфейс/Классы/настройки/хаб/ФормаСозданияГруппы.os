// Форма заведения группы — желудь модуля web-ui. ОДНО объявление полей питает и отрисовку
// окна, и разбор POST: имя поля считает один и тот же код.

Перем Кит;       // Кит (oscript-ui) — окно формы и скрытые поля
Перем Фабрика;   // Формы (кит) — фабрика объявлений форм
Перем Тексты;    // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Объявление формы заведения: какие поля, в каком порядке и с какими ограничениями.
//
// Возвращаемое значение:
//  ОбъявлениеФормы - объявление, готовое и печатать, и разбирать.
//
Функция Объявление() Экспорт

	Возврат Фабрика.Новая()
		.Поле("имя", Тексты.Текст("settings.hub.group-new.name.label"), "строка",
			Новый Структура("Обязательное, Плейсхолдер, Подсказка", Истина, "platform",
				Тексты.Текст("settings.hub.group-new.name.hint")))
		.Поле("описание", Тексты.Текст("settings.hub.group-new.description.label"), "строка");

КонецФункции

// Кнопка «Создать группу» и модальное окно с формой. Пока не нажали, форма места на экране
// не занимает; отбитая форма возвращается тем же окном — с набранным и помеченным полем.
//
// Параметры:
//  Параметры - Структура: * Адрес - Строка - адрес раздела (он же action формы); * Токен - Строка - CSRF-токен сессии; * Заполнение - Структура, Соответствие, Неопределено - чем заполнить поля; * Открыта - Булево - печатать окно открытым; * Отказы - Соответствие - ключ поля -> текст отказа домена.
//
// Возвращаемое значение:
//  ЭлементЭкрана - кнопка открытия и <dialog> с формой.
//
Функция Окно(Знач Параметры) Экспорт

	Заполнение = Неопределено;
	Параметры.Свойство("Заполнение", Заполнение);
	Открыта = Ложь;
	Параметры.Свойство("Открыта", Открыта);
	Отказы = Неопределено;
	Параметры.Свойство("Отказы", Отказы);

	Оформление = Новый Структура();
	Оформление.Вставить("Заголовок", Тексты.Текст("settings.hub.group-new.title"));
	Оформление.Вставить("Лид", Тексты.Текст("settings.hub.group-new.lead"));
	Оформление.Вставить("Открывашка", Тексты.Текст("settings.hub.group-new.title"));
	Оформление.Вставить("ИконкаОткрывашки", "плюс");
	Оформление.Вставить("Отмена", Тексты.Текст("settings.frame.cancel"));
	Оформление.Вставить("Отправка", Тексты.Текст("settings.hub.group-new.button"));
	Оформление.Вставить("ИконкаОтправки", "аккаунт");
	Оформление.Вставить("Открыта", Открыта = Истина);

	// операция едет СКРЫТЫМ ПОЛЕМ, а не именем кнопки: отправка по Enter обязана нести
	// её так же, как нажатие кнопки
	Ф = Объявление().Блок(Кит.СкрытоеПоле("операция", ОперацияСоздания()).Рендер());

	Если ТипЗнч(Отказы) = Тип("Соответствие") Тогда
		Для Каждого КиЗ Из Отказы Цикл
			Ф.Отбить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат Кит.Окно(Ф, Заполнение, Параметры.Адрес, Параметры.Токен, Оформление);

КонецФункции

// Значение поля «операция» для заведения группы.
//
// Возвращаемое значение:
//  Строка
//
Функция ОперацияСоздания() Экспорт
	Возврат "создать";
КонецФункции

#КонецОбласти

&Прозвище("ФормаСозданияГруппы")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "Формы") _Фабрика,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Фабрика = _Фабрика;
	Тексты = _Тексты;

КонецПроцедуры
