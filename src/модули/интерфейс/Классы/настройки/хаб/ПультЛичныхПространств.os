// Пульт личных пространств — желудь модуля web-ui: раздел «Пулы» дома «Хаб».
// Настройка oshub.pools.personal_enabled правится не как обычный тумблер: выключение
// уносит все личные пулы, поэтому проходит через окно предупреждения и эхо, а включение
// раздаёт пространства всем существующим учёткам. Порог операции держит гвард дома.

Перем РазборФормы;   // РазборФормы (web-ui)
Перем Настройки;     // СервисНастроек (настройки) — запись значения настройки
Перем Раскладка;     // РаскладкаНастроекХаба (web-ui) — раздел ключа
Перем Поля;          // ПоляНастроек (web-ui) — имя поля тумблера и значение «включено»
Перем ВитринаОкна;   // ВитринаЛичныхПространств (web-ui) — имена полей окна предупреждения
Перем Служба;        // СлужбаЛичныхПространств (кабинет) — оба перехода и их числа
Перем ФабрикаИтога;  // ИтогПульта (web-ui) — единая форма итога операции
Перем Ошибки;        // ТекстОшибки (основа) — описание исключения одной строкой
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Ключ настройки, которой распоряжается пульт.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючНастройки() Экспорт
	Возврат "oshub.pools.personal_enabled";
КонецФункции

// Разбирает POST раздела и, если он касается личных пространств, распоряжается ими сам.
//
// Параметры:
//  Раздел - Строка - ключ раздела дома «Хаб».
//  Форма - Соответствие - разобранная форма.
//  Кто - Строка - принципал сессии.
//
// Возвращаемое значение:
//  Структура - Перехвачено (Булево: Ложь — раздел обрабатывается общим путём),
//              Ошибка (Строка: "" — отказа нет), Спросить (Структура сводки удаления
//              либо Неопределено — окно предупреждения не нужно),
//              Уведомление (Строка: итог выполненной операции, "" — операции не было),
//              Окно (объект, печатающий секцию подтверждения).
//
Функция Применить(Знач Раздел, Знач Форма, Знач Кто) Экспорт

	Если Раздел <> Раскладка.РазделКлюча(КлючНастройки()) Тогда
		Возврат Мимо();
	КонецЕсли;

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, ВитринаОкна.ИмяПоляОперации())));

	Если Операция = ВитринаОкна.ЗначениеОперации() Тогда
		Возврат Выключить(Форма, Кто);
	КонецЕсли;

	Если ЗначениеЗаполнено(Операция) Тогда
		// прочие операции раздела (сброс, белый список) — не наше дело
		Возврат Мимо();
	КонецЕсли;

	Возврат ПоТумблеру(Форма, Кто);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обычная форма раздела: тумблер всегда присылает значение (парное скрытое поле),
// поэтому «поля нет» означает «настройка в форме не печаталась» — правит её не пульт.
Функция ПоТумблеру(Знач Форма, Знач Кто)

	ИмяПоля = Поля.ИмяПоля(КлючНастройки());
	Если Форма.Получить(ИмяПоля) = Неопределено Тогда
		Возврат Мимо();
	КонецЕсли;

	Желаемое = РазборФормы.Флажок(Форма, ИмяПоля, Поля.ЗначениеВключено());
	Если Желаемое = Действующее() Тогда
		Возврат Мимо();
	КонецЕсли;

	Если НЕ Желаемое Тогда
		// выключение не сохраняется сразу: сперва окно предупреждения с числами
		Результат = Успех();
		Результат.Спросить = Служба.СводкаУдаления();
		Возврат Результат;
	КонецЕсли;

	Возврат Включить(Кто);

КонецФункции

// Порядок «записать → раздать» обязателен: ОбеспечитьЛичныйПул спрашивает настройку,
// и при обратном порядке раздача пропустила бы всех до единого.
Функция Включить(Знач Кто)

	Проблема = Записать(Истина, Кто);
	Если ЗначениеЗаполнено(Проблема) Тогда
		Возврат Отказ(Проблема);
	КонецЕсли;

	Попытка
		Итог = Служба.РаздатьВсем(Кто);
	Исключение
		Возврат Отказ(Тексты.Шаблон("settings.hub.pools.personal.error.grant",
			Ошибки.Кратко(ОписаниеОшибки())));
	КонецПопытки;

	Результат = Успех();
	Результат.Уведомление = Тексты.Шаблон("settings.hub.pools.personal.on.done",
		Тексты.ЧислоТекстом(Итог.Создано), Тексты.ЧислоТекстом(Итог.Было),
		Тексты.ЧислоТекстом(Итог.Пропущено), Тексты.ЧислоТекстом(Итог.Ошибок));
	Возврат Результат;

КонецФункции

// Эхо сверяется с числом, посчитанным ЗАНОВО: между вопросом и ответом хаб живёт,
// и подтверждать надо ровно то, что уйдёт сейчас.
// Порядок обратный включению — «снести → записать»: настройка выключается ТОЛЬКО после
// полного сноса, иначе частичный сбой оставил бы выключенный тумблер, живые пространства
// и ни одного способа доделать операцию из интерфейса (перехода больше нет).
Функция Выключить(Знач Форма, Знач Кто)

	// операция живёт только как ПЕРЕХОД: при выключенной настройке сносить нечего,
	// а форма подтверждения превратилась бы в бессрочную кнопку сноса
	Если НЕ Действующее() Тогда
		Возврат Отказ(Тексты.Текст("settings.hub.pools.personal.error.off"));
	КонецЕсли;

	Сводка = Служба.СводкаУдаления();
	Ожидаемое = Тексты.ЧислоТекстом(Сводка.Пулов);

	Если СокрЛП(РазборФормы.Поле(Форма, ВитринаОкна.ИмяПоляЭха())) <> Ожидаемое Тогда
		Результат = Отказ(Тексты.Шаблон("settings.hub.pools.personal.error.echo", Ожидаемое));
		Результат.Спросить = Сводка;
		Возврат Результат;
	КонецЕсли;

	Попытка
		Итог = Служба.УдалитьВсе(Кто);
	Исключение
		Результат = Отказ(Тексты.Шаблон("settings.hub.pools.personal.error.wipe",
			Ошибки.Кратко(ОписаниеОшибки())));
		Результат.Спросить = Служба.СводкаУдаления();
		Возврат Результат;
	КонецПопытки;

	Если Итог.Ошибок > 0 Тогда
		// настройка остаётся включённой: тумблер на месте, и операцию можно повторить
		Результат = Отказ(Тексты.Шаблон("settings.hub.pools.personal.off.partial",
			Тексты.ЧислоТекстом(Итог.Пулов), Тексты.ЧислоТекстом(Итог.Ошибок)));
		Результат.Спросить = Служба.СводкаУдаления();
		Возврат Результат;
	КонецЕсли;

	Проблема = Записать(Ложь, Кто);
	Если ЗначениеЗаполнено(Проблема) Тогда
		Возврат Отказ(Проблема);
	КонецЕсли;

	Результат = Успех();
	Результат.Уведомление = Тексты.Шаблон("settings.hub.pools.personal.off.done",
		Тексты.ЧислоТекстом(Итог.Пулов), Тексты.ЧислоТекстом(Итог.Пакетов),
		Тексты.ЧислоТекстом(Итог.Версий));
	Возврат Результат;

КонецФункции

Функция Записать(Знач Значение, Знач Кто)

	Попытка
		Настройки.Установить(КлючНастройки(), Значение, Кто, "");
	Исключение
		Возврат Тексты.Шаблон("settings.hub.pools.personal.error.apply",
			Ошибки.Кратко(ОписаниеОшибки()));
	КонецПопытки;

	Возврат "";

КонецФункции

Функция Действующее()

	Попытка
		Возврат Настройки.Значение(КлючНастройки()) = Истина;
	Исключение
		Возврат Истина; // тот же дефолт, что у реестра: нечитаемая настройка не выключает хаб
	КонецПопытки;

КонецФункции

Функция Мимо()
	Возврат Итог(Ложь, "");
КонецФункции

Функция Успех()
	Возврат Итог(Истина, "");
КонецФункции

Функция Отказ(Знач Сообщение)
	Возврат Итог(Истина, Сообщение);
КонецФункции

// Окно едет в итоге: секцию подтверждения печатает та витрина, которая знает её поля,
// и дому «Хаб» не приходится узнавать, чей вопрос он показывает.
Функция Итог(Знач Перехвачено, Знач Ошибка)
	Результат = ?(Перехвачено, ФабрикаИтога.Отказ(Ошибка), ФабрикаИтога.Мимо());
	Результат.Окно = ВитринаОкна;
	Возврат Результат;
КонецФункции

#КонецОбласти

&Прозвище("ПультЛичныхПространств")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "РаскладкаНастроекХаба") _Раскладка,
	&Пластилин(Значение = "ПоляНастроек") _Поля,
	&Пластилин(Значение = "ВитринаЛичныхПространств") _ВитринаОкна,
	&Пластилин(Значение = "СлужбаЛичныхПространств") _Служба,
	&Пластилин(Значение = "ИтогПульта") _ФабрикаИтога,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	Настройки = _Настройки;
	Раскладка = _Раскладка;
	Поля = _Поля;
	ВитринаОкна = _ВитринаОкна;
	Служба = _Служба;
	ФабрикаИтога = _ФабрикаИтога;
	Ошибки = _Ошибки;
	Тексты = _Тексты;

КонецПроцедуры
