// Что администратор видит про встроенную базу стран там, где он правит правило: есть ли
// файл, когда он выпущен, не устарел ли, строится ли индекс и чем кончилась прошлая сборка.
//
// Здесь же одно место, где хаб решает главное следствие: пока опубликованный индекс
// не называет ни одной страны, правило закрывает провайдера ВСЕМ — неизвестная страна
// считается закрытой. Администратор обязан прочитать это ДО сохранения.

Перем Кит;          // Кит (кит) — фабрика элементов экрана
Перем Определитель; // ОпределительСтраны (гео)
Перем Тексты;       // ТекстыИнтерфейса (кит)
Перем Даты;         // ДатаЧеловеку (web-ui)

#Область ПубличныйИнтерфейс

// Закрывает ли правило сейчас провайдера всем посетителям: хаб не назовёт ни одной
// страны, а неизвестная страна при живом правиле — это отказ.
//
// Вопрос задаётся ОПУБЛИКОВАННОМУ индексу, а не файлу на диске: именно по индексу судит
// дверь. Файл, унесённый из-под работающего хаба, индекс не отменяет — и экран, сказавший
// бы про него «закрывает всем», врал бы ровно там, где вход ещё работает.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЗакрываетВсех() Экспорт

	Снимок = Снимок();
	Возврат Снимок = Неопределено ИЛИ Снимок.Страны.Количество() = 0;

КонецФункции

// Предупреждение «правило сейчас закрывает провайдера всем» — либо пустой узел.
//
// Возвращаемое значение:
//  ЭлементЭкрана.
//
Функция ПредупреждениеПроВсех() Экспорт

	Если НЕ ЗакрываетВсех() Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Уведомление(Новый Структура("Текст, Вид",
		Тексты.Текст("providers.geo.db.closes.everyone"), "err"));

КонецФункции

// Что хаб видит про ТЕКУЩИЙ запрос администратора: та же дверь определителя, что судит
// посетителей. Без этой строки «правило закрыло всех» разбирается вслепую — чаще всего
// потому, что хаб стоит за обратным прокси, а его сети не названы доверенными.
//
// Параметры:
//  Посетитель - Структура, Неопределено - посетитель запроса (Адрес, Заголовки).
//
// Возвращаемое значение:
//  ЭлементЭкрана.
//
Функция СтранаЗапроса(Знач Посетитель) Экспорт

	Вердикт = Вердикт(Посетитель);
	Если Вердикт = Неопределено Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Если Вердикт.Исход = Определитель.Исходы().Известна Тогда
		Возврат Кит.Примечание(Тексты.Шаблон("providers.geo.request.known",
			Вердикт.Страна, Вердикт.Источник));
	КонецЕсли;

	Если Вердикт.Исход = Определитель.Исходы().НеНаблюдаемая Тогда
		Возврат Кит.Примечание(Тексты.Текст("providers.geo.request.unwatched"));
	КонецЕсли;

	Возврат Кит.Уведомление(Новый Структура("Текст, Вид",
		Тексты.Шаблон("providers.geo.request.unknown", Вердикт.Причина), "warn"));

КонецФункции

// Состояние базы словами: путь и дата выпуска, возраст, сколько диапазонов, что строится
// и чем кончилась прошлая сборка. Файла нет — сказано, куда его положить.
//
// Возвращаемое значение:
//  ЭлементЭкрана - холст с примечаниями.
//
Функция Сводка() Экспорт

	Снимок = Снимок();
	Если Снимок = Неопределено Тогда
		Возврат Кит.Примечание(Тексты.Текст("providers.geo.db.unknown"));
	КонецЕсли;

	Сводка = Кит.Холст();
	Сводка.Добавить(?(Снимок.Есть, СтрокаФайла(Снимок), СтрокаБезФайла(Снимок)));
	Сводка.Добавить(СтрокаИндекса(Снимок));
	Сводка.Добавить(СтрокаСборки(Снимок));
	Сводка.Добавить(СтрокаНеудачи(Снимок));
	Возврат Сводка;

КонецФункции

#КонецОбласти

#Область Строки

Функция СтрокаФайла(Знач Снимок)

	Возраст = Тексты.Шаблон("providers.geo.db.file", Снимок.Путь,
		Даты.ТолькоДата(Снимок.Дата), Формат(Суток(Снимок.ВозрастСек), "ЧН=0; ЧГ="));

	Если НЕ Снимок.Устарела Тогда
		Возврат Кит.Примечание(Возраст);
	КонецЕсли;

	Возврат Кит.Уведомление(Новый Структура("Текст, Вид",
		Возраст + " " + Тексты.Текст("providers.geo.db.stale"), "warn"));

КонецФункции

Функция Суток(Знач Секунд)
	Возврат Цел(Макс(Число(Секунд), 0) / 86400);
КонецФункции

Функция СтрокаБезФайла(Знач Снимок)

	Возврат Кит.Уведомление(Новый Структура("Текст, Вид",
		Тексты.Шаблон("providers.geo.db.missing", Снимок.Путь), "err"));

КонецФункции

Функция СтрокаИндекса(Знач Снимок)

	Если Снимок.Страны.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Примечание(Тексты.Шаблон("providers.geo.db.index",
		СтрСоединить(Снимок.Страны, ", "), Формат(Снимок.Диапазонов, "ЧГ= ")));

КонецФункции

Функция СтрокаСборки(Знач Снимок)

	Если НЕ Снимок.Строится Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Примечание(Тексты.Шаблон("providers.geo.db.building",
		СтрСоединить(Снимок.Заказано, ", ")));

КонецФункции

Функция СтрокаНеудачи(Знач Снимок)

	Если НЕ ЗначениеЗаполнено(Снимок.Неудача) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Уведомление(Новый Структура("Текст, Вид",
		Тексты.Шаблон("providers.geo.db.failed", Снимок.Неудача), "warn"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Экран не вправе падать из-за геобазы. Неопределено значит «состояние неизвестно»,
// и это тот же случай, что «база ничего не назовёт»: правило закрывает всех.
Функция Снимок()

	Попытка
		Возврат Определитель.СостояниеБазы();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Посетителя может не быть вовсе (окно печатается и без запроса), а определитель —
// сорваться; строку про свой запрос тогда просто не печатаем.
Функция Вердикт(Знач Посетитель)

	Если Посетитель = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат Определитель.ОпределитьПоЗапросу(Посетитель.Адрес, Посетитель.Заголовки);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

&Прозвище("СостояниеБазыСтран")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОпределительСтраны") _Определитель,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты) Экспорт

	Кит = _Кит;
	Определитель = _Определитель;
	Тексты = _Тексты;
	Даты = _Даты;

КонецПроцедуры
