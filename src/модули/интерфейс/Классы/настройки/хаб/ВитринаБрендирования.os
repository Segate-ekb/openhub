// Секция раздела «Брендирование» дома «Хаб»: показ действующих знака и иконки, поля
// загрузки и возврат к фирменным. Имена полей объявлены здесь же — их читает ПультБрендирования.

Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем Каркас;        // РендерерНастроек (кит) — заготовка секции
Перем Активы;        // СервисБрендовыхАктивов (настройки) — ключи и сведения о загруженном
Перем Бренд;         // Брендирование (web-ui) — адрес действующей картинки
Перем Фирменные;     // АдресаСтатики — картинки из поставки
Перем Объёмы;        // ОбъёмТекстом (основа)
Перем Тексты;        // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Значение скрытого поля операции, которым форма картинок отличает себя от формы значений.
//
// Возвращаемое значение:
//  Строка
//
Функция ОперацияЗагрузки() Экспорт
	Возврат "актив-загрузка";
КонецФункции

// Имя кнопки возврата к фирменной картинке; её значение — ключ актива.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяКнопкиСброса() Экспорт
	Возврат "сброс-актива";
КонецФункции

// Имя файлового поля актива.
//
// Параметры:
//  Ключ - Строка - ключ актива.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПоляФайла(Знач Ключ) Экспорт
	Возврат "актив-" + НРег(СокрЛП(Строка(Ключ)));
КонецФункции

// Секция картинок оформления.
//
// Параметры:
//  Адрес - Строка - адрес раздела (action формы).
//  Токен - Строка - CSRF-токен сессии.
//  ИмяПоляОперации - Строка - имя скрытого поля операции раздела.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция Секция(Знач Адрес, Знач Токен, Знач ИмяПоляОперации) Экспорт

	Оформление = Кит.Холст();
	Оформление.Добавить(Кит.СкрытоеПоле(ИмяПоляОперации, ОперацияЗагрузки()));
	Оформление.Добавить(ТаблицаКартинок());
	Оформление.Добавить(ПоляЗагрузки());
	Оформление.Добавить(Кит.Примечание(Тексты.Текст("settings.hub.branding.assets.warning")));

	Результат = Каркас.Секция(Тексты.Текст("settings.hub.branding.assets.title"),
		Тексты.Текст("settings.hub.branding.assets.lead"), Оформление.Рендер());
	Результат.Иконка = "солнце";
	Результат.Действие = Адрес;
	Результат.Токен = Токен;
	Результат.СФайлами = Истина;
	Результат.Кнопка = Тексты.Текст("settings.hub.branding.assets.upload");
	Результат.ПояснениеПанели = Тексты.Шаблон("settings.hub.branding.assets.limit",
		Объёмы.Представление(Активы.ПотолокБайт()));
	Возврат Результат;

КонецФункции

// Метка актива для сообщений и подписей.
//
// Параметры:
//  Ключ - Строка - ключ актива.
//
// Возвращаемое значение:
//  Строка
//
Функция Метка(Знач Ключ) Экспорт

	Если Ключ = Активы.КлючИконки() Тогда
		Возврат Тексты.Текст("settings.hub.branding.assets.favicon.label");
	КонецЕсли;
	Возврат Тексты.Текст("settings.hub.branding.assets.logo.label");

КонецФункции

#КонецОбласти

#Область ДействующиеКартинки

// Строка на актив: метка, сама картинка со словами о ней и кнопка возврата к фирменной.
Функция ТаблицаКартинок()

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.branding.assets.col.asset")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.branding.assets.col.current")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.hub.branding.assets.col.action")));

	Для Каждого Ключ Из Активы.Ключи() Цикл
		Таблица.Добавить(ЗаписьАктива(Ключ));
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция ЗаписьАктива(Знач Ключ)

	Запись = Кит.Запись();
	Запись.Добавить(Ячейка(Метка(Ключ)));
	Запись.Добавить(ДействующаяКартинка(Ключ));
	Запись.Добавить(ЯчейкаС(КнопкаСброса(Ключ)));
	Возврат Запись;

КонецФункции

Функция ДействующаяКартинка(Знач Ключ)

	Результат = Кит.Ячейка();
	Результат.Добавить(Показ(Ключ));
	Результат.Добавить(Состояние(Ключ));
	Возврат Результат;

КонецФункции

// Адрес берётся у брендирования: иначе витрина показывала бы своё представление о теме.
Функция Показ(Знач Ключ)
	Возврат Кит.Картинка(ДействующийАдрес(Ключ), "превью").Высота(32);
КонецФункции

Функция ДействующийАдрес(Знач Ключ)

	Если Ключ = Активы.КлючИконки() Тогда
		Свой = Бренд.АдресЗагруженнойИконки();
		Возврат ?(ЗначениеЗаполнено(Свой), Свой, Фирменные.АдресИконки());
	КонецЕсли;

	Свой = Бренд.АдресЗагруженногоЗнака();
	Возврат ?(ЗначениеЗаполнено(Свой), Свой, Фирменные.АдресЗнака());

КонецФункции

// Своя картинка называет тип и вес, фирменная — просто говорит, что она из поставки.
Функция Состояние(Знач Ключ)

	Сведения = Активы.Сведения(Ключ);

	Если НЕ Сведения.Есть Тогда
		Возврат Надпись(Тексты.Текст("settings.hub.branding.assets.default"));
	КонецЕсли;

	Возврат Надпись(Тексты.Шаблон("settings.hub.branding.assets.uploaded",
		Сведения.ТипКонтента, Объёмы.Представление(Сведения.Размер)));

КонецФункции

// Submit ТОЙ ЖЕ формы: вложенных форм в HTML не бывает.
Функция КнопкаСброса(Знач Ключ)

	Возврат Кит.Кнопка(Новый Структура(
		"Подпись, Вариант, Размер, Имя, Значение, БезВалидации, Заблокирована",
		Тексты.Текст("settings.hub.branding.assets.reset"), "вторичная", "малый",
		ИмяКнопкиСброса(), Ключ, Истина, НЕ Активы.Сведения(Ключ).Есть));

КонецФункции

#КонецОбласти

#Область ЗагрузкаКартинок

Функция ПоляЗагрузки()

	Поля = Кит.Холст();
	Для Каждого Ключ Из Активы.Ключи() Цикл
		Поля.Добавить(ПолеФайла(Ключ));
	КонецЦикла;
	Возврат Поля;

КонецФункции

Функция ПолеФайла(Знач Ключ)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Подсказка",
		ИмяПоляФайла(Ключ), Метка(Ключ), "файл", Подсказка(Ключ)));

КонецФункции

Функция Подсказка(Знач Ключ)

	Если Ключ = Активы.КлючИконки() Тогда
		Возврат Тексты.Текст("settings.hub.branding.assets.favicon.hint");
	КонецЕсли;
	Возврат Тексты.Текст("settings.hub.branding.assets.logo.hint");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Ячейка(Знач Значение)

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Текст(Значение));
	Возврат Результат;

КонецФункции

Функция ЯчейкаС(Знач Элемент)

	Результат = Кит.Ячейка();
	Результат.Добавить(Элемент);
	Возврат Результат;

КонецФункции

Функция Надпись(Знач Значение)

	Результат = Кит.Надпись();
	Результат.Добавить(Кит.Текст(Значение));
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаБрендирования")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _Каркас,
	&Пластилин(Значение = "СервисБрендовыхАктивов") _Активы,
	&Пластилин(Значение = "Брендирование") _Бренд,
	&Пластилин(Значение = "АдресаСтатики") _Фирменные,
	&Пластилин(Значение = "ОбъёмТекстом") _Объёмы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Каркас = _Каркас;
	Активы = _Активы;
	Бренд = _Бренд;
	Фирменные = _Фирменные;
	Объёмы = _Объёмы;
	Тексты = _Тексты;

КонецПроцедуры
