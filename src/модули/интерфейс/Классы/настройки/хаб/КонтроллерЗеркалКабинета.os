// Контроллер зеркал кабинета — модуль web-ui: маршруты админского обзора зеркал.

Перем Гвард;         // ГвардКабинета (кабинет)
Перем Защита;        // ЗащитаCSRF (auth) — токен сессии в форму
Перем Гейт;          // ГейтФормы (web-ui) — метод запроса и токен формы
Перем РазборФормы;   // РазборФормы (web-ui)
Перем СервисПулов;   // СервисПулов (реестр)
Перем СервисЗеркал;  // СервисЗеркал (зеркала)
Перем СервисПрав;    // СервисПрав (auth)
Перем СлужбаКабинета;// СлужбаКабинета (кабинет) — пулы в распоряжении смотрящего
Перем Витрина;       // ВитринаЗеркалКабинета (web-ui)
Перем Ответы;        // ОтветыНастроек (web-ui) — страница и типовые отказы
Перем Сбои;        // ТекстСбоя (web-ui) — причина сбоя человеку и отчёт в журнал
Перем ПультЗеркал;   // ПультЗеркал (web-ui) — заведение, переключение и заявка на синк
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Числа;         // ПриведениеЧисел (основа) — терпимое чтение числа
Перем HTTP;          // МетодыHTTP (основа) — сравнение метода запроса

#Область ТочкиМаршрута

// Точка маршрута «mirrors» (GET).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//
&ТочкаМаршрута("mirrors")
Процедура Индекс(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Ответы.ОтдатьСтраницу(Ответ, Тексты.Текст("office.mirrors.title"),
		Витрина.Обзор(СлужбаКабинета.ПулыВРаспоряжении(Вердикт.Пользователь)),
		Вердикт.Пользователь, КукиЗапроса);

КонецПроцедуры

// Точка маршрута «mirrors/{pool}» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  sync - Строка - итог запуска синхронизации из адреса: "1" заявка принята, "running" прогон
//         уже идёт, "queued" зеркало уже ждёт очереди, "disabled" синхронизация выключена
//         (необязательный, по умолчанию "").
//
&ТочкаМаршрута("mirrors/{pool}")
Процедура Пул(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, sync = "") Экспорт

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьСписок(Ответ, Контекст, БаннерыСинка(sync), КукиЗапроса);
	ИначеЕсли HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Создать(Ответ, Контекст, ТелоЗапроса, КукиЗапроса);
	Иначе
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Контекст.Пользователь, КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «mirrors/{pool}/{id}/delete».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("mirrors/{pool}/{id}/delete")
Процедура Удаление(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = ПодготовитьМутацию(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СервисЗеркал.Удалить(Контекст.Пользователь, Контекст.Пул, Числа.ЧислоИлиНоль(id));
	Ответ.Перенаправить(Витрина.АдресПула(Контекст.Пул));

КонецПроцедуры

// Точка маршрута «mirrors/{pool}/{id}/toggle».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("mirrors/{pool}/{id}/toggle")
Процедура Переключение(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = ПодготовитьМутацию(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПультЗеркал.Переключить(Контекст.Пользователь, Контекст.Пул, Числа.ЧислоИлиНоль(id),
		Контекст.Форма);
	Ответ.Перенаправить(Витрина.АдресПула(Контекст.Пул));

КонецПроцедуры

// Точка маршрута «mirrors/{pool}/{id}/sync».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("mirrors/{pool}/{id}/sync")
Процедура Синхронизация(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = ПодготовитьМутацию(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Зеркало = СервисЗеркал.ЗеркалоПула(Контекст.Пул, Числа.ЧислоИлиНоль(id));
	Если Зеркало = Неопределено Тогда
		Ответ.Перенаправить(Витрина.АдресПула(Контекст.Пул));
		Возврат;
	КонецЕсли;

	Ответ.Перенаправить(Витрина.АдресПула(Контекст.Пул)
		+ "?sync=" + ПультЗеркал.КодПостановки(Зеркало, Контекст.Пользователь));

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура Создать(Ответ, Знач Контекст, Знач ТелоЗапроса, Знач КукиЗапроса)

	Форма = Гейт.СПринятымТокеном(Ответ, Контекст, РазборФормы.Разобрать(ТелоЗапроса),
		КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Итог = ПультЗеркал.Завести(Контекст.Пользователь, Контекст.Пул, Форма);
	Исключение
		// причину берём ЗДЕСЬ, внутри обработчика: снаружи ОписаниеОшибки() уже не о ней
		ОтдатьСписок(Ответ, Контекст, Баннеры(Сбои.Человеку(ИнформацияОбОшибке()), "err"),
			КукиЗапроса, 400);
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		ОтдатьСписок(Ответ, Контекст, Баннеры(Итог.Ошибка, "err"), КукиЗапроса, 400);
		Возврат;
	КонецЕсли;

	Ответ.Перенаправить(Витрина.АдресПула(Контекст.Пул));

КонецПроцедуры

#КонецОбласти

#Область ОбщаяЛогика

// Гвард + резолв пула + проверка права администрирования.
Функция Подготовить(Ответ, Знач pool, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Пользователь = Вердикт.Пользователь;

	Пул = СервисПулов.НайтиПул(pool);
	Если Пул = Неопределено Тогда
		// pool идёт сырым: экранирует ОтдатьНеНайдено, иначе экранировали бы дважды
		Ответы.ОтдатьНеНайдено(Ответ, Пользователь,
			Тексты.Шаблон("office.mirrors.error.pool-notfound", pool), КукиЗапроса,
			Новый Структура("Адрес, Подпись", Витрина.АдресОбзора(),
				Тексты.Текст("office.mirrors.back")));
		Возврат Неопределено;
	КонецЕсли;

	// зеркалами пула распоряжается только владелец/админ пула — на КАЖДОМ действии
	Если НЕ СервисПрав.МожетАдминистрировать(Пользователь, Пул) Тогда
		Ответы.ОтдатьЗапрещено(Ответ, Пользователь, Тексты.Текст("office.mirrors.error.forbidden"),
			КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("Пользователь", Пользователь);
	Результат.Вставить("Сессия", Вердикт.Сессия);
	Результат.Вставить("Пул", Пул);
	Возврат Результат;

КонецФункции

// Подготовка мутации: Подготовить + требование POST + проверка CSRF (+ поле Форма).
Функция ПодготовитьМутацию(Ответ, Знач pool, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Форма = Гейт.ПринятаяФорма(Ответ, Контекст, "POST", МетодЗапроса, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Контекст.Вставить("Форма", Форма);
	Возврат Контекст;

КонецФункции

Функция БаннерыСинка(Знач sync)

	Если sync = "1" Тогда
		Возврат Баннеры(Тексты.Текст("office.mirrors.sync.started"), "ok");
	ИначеЕсли sync = "running" Тогда
		Возврат Баннеры(Тексты.Текст("office.mirrors.sync.running"), "warn");
	ИначеЕсли sync = "queued" Тогда
		Возврат Баннеры(Тексты.Текст("office.mirrors.sync.queued"), "warn");
	ИначеЕсли sync = "disabled" Тогда
		Возврат Баннеры(Тексты.Текст("office.mirrors.sync.disabled"), "err");
	ИначеЕсли sync = "rejected" Тогда
		Возврат Баннеры(Тексты.Текст("office.mirrors.sync.rejected"), "err");
	КонецЕсли;

	Возврат Новый Массив();

КонецФункции

Функция Баннеры(Знач Текст, Знач Вид)

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Текст, Вид", Текст, Вид));
	Возврат Результат;

КонецФункции

Процедура ОтдатьСписок(Ответ, Знач Контекст, Знач БаннерыСтраницы, Знач КукиЗапроса,
	Знач Статус = 200)

	Параметры = Новый Структура("Пул, Токен, Баннеры", Контекст.Пул,
		Защита.ТокенСессии(Контекст.Сессия), БаннерыСтраницы);

	Ответы.ОтдатьСтраницу(Ответ, Тексты.Шаблон("office.mirrors.pool.title", Контекст.Пул.Имя),
		Витрина.Список(Параметры), Контекст.Пользователь, КукиЗапроса, Статус);

КонецПроцедуры

#КонецОбласти

&Контроллер("/office")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _Гвард,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СлужбаКабинета") _СлужбаКабинета,
	&Пластилин(Значение = "ВитринаЗеркалКабинета") _Витрина,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "ПультЗеркал") _ПультЗеркал)

	Гвард = _Гвард;
	Защита = _Защита;
	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	СервисПулов = _СервисПулов;
	СервисЗеркал = _СервисЗеркал;
	СервисПрав = _СервисПрав;
	СлужбаКабинета = _СлужбаКабинета;
	Витрина = _Витрина;
	Ответы = _Ответы;
	Сбои = _Сбои;
	Тексты = _Тексты;
	Числа = _Числа;
	HTTP = _HTTP;
	ПультЗеркал = _ПультЗеркал;

КонецПроцедуры
