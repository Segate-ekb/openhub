// Раскладка настроек дома «Хаб» — желудь модуля web-ui: ярус важности настройки,
// по которому экран делится на «над катом» и «под катом». В каком разделе живёт ключ,
// знает РазделыНастроекХаба (настройки): это спрашивают обе двери, а ярус — только экран.

Перем Ярусы;    // Соответствие: ключ (НРег) -> ярус (1|2|3)
Перем Порядок;  // Соответствие: ключ (НРег) -> номер объявления (порядок внутри яруса)

#Область ПубличныйИнтерфейс

// Ярус настройки: 1 — политика (противоположное значение меняет СОСТАВ доступного кому-то),
// 2 — порог (двигается граница уже разрешённого), 3 — тонкая крутилка (порог с рабочим
// умолчанием, повод сменить который приходит извне, а не из работы с хабом).
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Число - ярус настройки.
//
Функция ЯрусКлюча(Знач Ключ) Экспорт

	Найдено = Ярусы.Получить(НРег(СокрЛП(Строка(Ключ))));
	// неразмеченная настройка считается политикой: новый ключ обязан попасть на глаза,
	// а не спрятаться под катом
	Возврат ?(Найдено = Неопределено, 1, Найдено);

КонецФункции

// Ярус, который прячется под кат.
//
// Возвращаемое значение:
//  Число - ярус тонких крутилок.
//
Функция ЯрусТонкий() Экспорт
	Возврат 3;
КонецФункции

// Назван ли ярус настройки в таблице явно (а не взят умолчанием).
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Булево - назван ли ярус настройки в таблице явно.
//
Функция Размечен(Знач Ключ) Экспорт
	Возврат Ярусы.Получить(НРег(СокрЛП(Строка(Ключ)))) <> Неопределено;
КонецФункции

// Делит карточки раздела на то, что стоит над катом, и то, что уходит под кат.
//
// Параметры:
//  Карточки - Массив - карточки настроек раздела.
//
// Возвращаемое значение:
//  Структура - Голова (Массив), Хвост (Массив); обе упорядочены по ярусу.
//
Функция Разложить(Знач Карточки) Экспорт

	Голова = Новый Массив();
	Хвост = Новый Массив();

	Для Каждого Карточка Из Упорядочить(Карточки) Цикл
		Если ЯрусКлюча(Карточка.Ключ) = ЯрусТонкий() Тогда
			Хвост.Добавить(Карточка);
		Иначе
			Голова.Добавить(Карточка);
		КонецЕсли;
	КонецЦикла;

	// кат применяется, только если над ним что-то остаётся: раздел, спрятанный целиком,
	// выглядит пустым
	Если Голова.Количество() = 0 Тогда
		Возврат Новый Структура("Голова, Хвост", Хвост, Новый Массив());
	КонецЕсли;

	Возврат Новый Структура("Голова, Хвост", Голова, Хвост);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Устойчивая сортировка по ярусу: равные ярусы сохраняют порядок, в котором пришли.
Функция Упорядочить(Знач Карточки)

	Результат = Новый Массив();

	Для Каждого Карточка Из Карточки Цикл
		Вес = Вес(Карточка.Ключ);
		Место = Результат.Количество();
		Пока Место > 0 И Вес < Вес(Результат[Место - 1].Ключ) Цикл
			Место = Место - 1;
		КонецЦикла;
		Результат.Вставить(Место, Карточка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Ярус старше номера объявления: внутри яруса порядок задаёт таблица ниже, а
// неразмеченный ключ встаёт за всеми размеченными своего яруса.
Функция Вес(Знач Ключ)

	Норм = НРег(СокрЛП(Строка(Ключ)));
	Номер = Порядок.Получить(Норм);
	Возврат ЯрусКлюча(Норм) * 1000 + ?(Номер = Неопределено, 999, Номер);

КонецФункции

Процедура Ярус(Знач Ключ, Знач Значение)

	Норм = НРег(Ключ);
	Ярусы.Вставить(Норм, Значение);
	Порядок.Вставить(Норм, Порядок.Количество() + 1);

КонецПроцедуры

#КонецОбласти

// Порядок объявления внутри яруса — порядок на экране: вся инсталляция, затем класс
// объектов, затем один объект.
&Желудь
Процедура ПриСозданииОбъекта() Экспорт

	Ярусы = Новый Соответствие();
	Порядок = Новый Соответствие();

	// Размечаются только правимые настройки: числа инсталляции показываются карточкой,
	// а карточка яруса не спрашивает — её место в витрине, а не над катом или под ним.
	Ярус("oshub.instance.url", 1);

	Ярус("oshub.ui.brand", 1);
	Ярус("oshub.ui.tagline", 1);
	Ярус("oshub.ui.show_name", 1);
	Ярус("oshub.ui.theme", 1);
	Ярус("oshub.ui.accent", 1);

	Ярус("oshub.auth.password.enabled", 1);
	Ярус("oshub.auth.registration.mode", 1);
	Ярус("oshub.auth.token.cli_days", 3);

	// выключатель гасит ВЫПУСК ссылок (СервисПодтвержденияEmail.ПочемуНельзя): подтверждённым
	// адрес после него не станет уже ни у кого — это смена состава доступного
	Ярус("oshub.auth.email.confirm.enabled", 1);

	// гейт «почта настроена» — включена И задан хост И годен отправитель
	// (НастройкиПочты.Настроена): без любого из трёх хаб не шлёт ни одного письма
	Ярус("oshub.mail.enabled", 1);
	Ярус("oshub.mail.smtp.host", 1);
	// порт — вторая половина координаты сервера: отвечает на «куда», а не на «сколько»,
	// и порогом быть не может, хотя и число
	Ярус("oshub.mail.smtp.port", 1);
	// пусто — сервер без аутентификации, заполнено — хаб входит этой учёткой: переключатель
	// режима, а не граница
	Ярус("oshub.mail.smtp.user", 1);
	Ярус("oshub.mail.from", 1);

	Ярус("oshub.pools.personal_enabled", 1);
	// ноль в квоте пула означает «без ограничения», дверей он не закрывает
	Ярус("oshub.pools.default_quota_mb", 2);

	// рубильник подсистемы: выключенный не даёт зеркалам синхронизироваться вовсе
	Ярус("oshub.mirror.sync_enabled", 1);

	Ярус("oshub.publish.github_legacy", 1);
	Ярус("oshub.publish.github.org", 1);
	Ярус("oshub.publish.ci.issuers", 1);
	Ярус("oshub.publish.ci.audience", 1);

	// политика пароля показывается ОДНИМ блоком, поэтому под кат не уходит ни одна её
	// строка: разорванный кат сделал бы из дашборда россыпь
	Ярус("oshub.auth.password.min_length", 1);
	Ярус("oshub.auth.password.max_length", 1);
	Ярус("oshub.auth.password.require_lowercase", 1);
	Ярус("oshub.auth.password.require_uppercase", 1);
	Ярус("oshub.auth.password.require_digit", 1);
	Ярус("oshub.auth.password.require_special", 1);

	// пароль SMTP — вторая половина учётки сервера, и стоит рядом с пользователем
	Ярус("oshub.mail.smtp.password", 1);

	Ярус("oshub.webhooks.delivery_enabled", 1);
	Ярус("oshub.webhooks.allow_insecure", 1);

	// офлайн закрывает походы наружу целиком: включают его как раз тогда, когда рестарт некстати
	Ярус("oshub.proxy.offline", 1);
	Ярус("oshub.proxy.timeout.sec", 2);
	Ярус("oshub.proxy.negative.ttl.sec", 3);
	Ярус("oshub.proxy.upstream.recheck.ttl.sec", 3);
	// проба — политика («ходить наружу или нет»), а не порог: булеву настройку под кат не прячут
	Ярус("oshub.upstream.probe.enabled", 1);
	Ярус("oshub.proxy.max_redirects", 3);

	Ярус("oshub.ui.audit_page_size", 2);
	Ярус("oshub.stats.flush_interval_sec", 3);
	Ярус("oshub.stats.flush_threshold", 3);

КонецПроцедуры
