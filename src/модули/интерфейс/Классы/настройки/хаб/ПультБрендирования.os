// Пульт картинок оформления — желудь модуля web-ui: приём загруженных знака и иконки
// и возврат к фирменным в разделе «Брендирование» дома «Хаб».

Перем РазборФормы;   // РазборФормы (web-ui)
Перем Активы;        // СервисБрендовыхАктивов (настройки) — доменный API
Перем Витрина;       // ВитринаБрендирования (web-ui) — имена полей формы
Перем Разделы;       // РазделыНастроекХаба (настройки) — раздел ключа
Перем Поля;          // ПоляНастроек (web-ui) — имя поля операции
Перем ФабрикаИтога;  // ИтогПульта (web-ui)
Перем Объёмы;        // ОбъёмТекстом (основа)
Перем Тексты;        // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Разбирает POST раздела и, если он про картинки оформления, распоряжается им сам.
//
// Параметры:
//  Раздел - Строка - ключ раздела дома «Хаб».
//  Форма - Соответствие - текстовые поля формы.
//  Файлы - Соответствие - файловые части формы (см. РазборФормы.Файлы).
//  Кто - Строка - принципал сессии.
//  Адрес - Строка - куда возвращать после удавшейся операции.
//
// Возвращаемое значение:
//  Структура - итог пульта (см. ИтогПульта).
//
Функция Применить(Знач Раздел, Знач Форма, Знач Файлы, Знач Кто, Знач Адрес) Экспорт

	Если Раздел <> Разделы.РазделКлюча(Активы.КлючПотолка()) Тогда
		Возврат ФабрикаИтога.Мимо();
	КонецЕсли;

	// обе ветви — операции ОДНОЙ формы, поэтому обе судятся по одному признаку: скрытое
	// поле операции. Нажатая кнопка возврата приезжает вместе с ним и разбирается первой
	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, Поля.ИмяПоляОперации())));
	Если Операция <> Витрина.ОперацияЗагрузки() Тогда
		Возврат ФабрикаИтога.Мимо();
	КонецЕсли;

	КлючСброса = НРег(СокрЛП(РазборФормы.Поле(Форма, Витрина.ИмяКнопкиСброса())));
	Если ЗначениеЗаполнено(КлючСброса) Тогда
		Возврат Сбросить(КлючСброса, Кто, Адрес);
	КонецЕсли;

	Возврат Загрузить(Файлы, Кто, Адрес);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Сбросить(Знач Ключ, Знач Кто, Знач Адрес)

	Если Активы.Ключи().Найти(Ключ) = Неопределено Тогда
		Возврат ФабрикаИтога.Отказ(Тексты.Текст("settings.hub.branding.error.key"));
	КонецЕсли;

	Активы.Сбросить(Ключ, Кто, "");
	Возврат ФабрикаИтога.Переход(Адрес);

КонецФункции

// Пустое поле пропускается, а форма без единого файла — промах, а не «сохранено».
Функция Загрузить(Знач Файлы, Знач Кто, Знач Адрес)

	Принято = 0;

	Для Каждого Ключ Из Активы.Ключи() Цикл

		Часть = РазборФормы.Файл(Файлы, Витрина.ИмяПоляФайла(Ключ));
		Если Часть = Неопределено ИЛИ Часть.Данные = Неопределено
			ИЛИ Часть.Данные.Размер() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Вердикт = Активы.Загрузить(Ключ, Часть.Данные, Часть.ТипКонтента, Часть.ИмяФайла, Кто, "");
		Если НЕ Вердикт.Успех Тогда
			Возврат ОтказПоВердикту(Ключ, Вердикт);
		КонецЕсли;

		Принято = Принято + 1;

	КонецЦикла;

	Если Принято = 0 Тогда
		Возврат ФабрикаИтога.Отказ(Тексты.Текст("settings.hub.branding.error.empty"));
	КонецЕсли;

	Возврат ФабрикаИтога.Переход(Адрес);

КонецФункции

// Отказ по размеру называет себя 413: править нужно файл, а не форму.
Функция ОтказПоВердикту(Знач Ключ, Знач Вердикт)

	Если Вердикт.Причина = Активы.КодВелик() Тогда
		Возврат ФабрикаИтога.Запрещено(Тексты.Шаблон("settings.hub.branding.error.large",
			Витрина.Метка(Ключ), Объёмы.Представление(Вердикт.Размер),
			Объёмы.Представление(Вердикт.Потолок)), 413);
	КонецЕсли;

	Если Вердикт.Причина = Активы.КодТип() Тогда
		Возврат ФабрикаИтога.Отказ(Тексты.Шаблон("settings.hub.branding.error.type",
			Витрина.Метка(Ключ)));
	КонецЕсли;

	Возврат ФабрикаИтога.Отказ(Тексты.Текст("settings.hub.branding.error.empty"));

КонецФункции

#КонецОбласти

&Прозвище("ПультБрендирования")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисБрендовыхАктивов") _Активы,
	&Пластилин(Значение = "ВитринаБрендирования") _Витрина,
	&Пластилин(Значение = "РазделыНастроекХаба") _Разделы,
	&Пластилин(Значение = "ПоляНастроек") _Поля,
	&Пластилин(Значение = "ИтогПульта") _ФабрикаИтога,
	&Пластилин(Значение = "ОбъёмТекстом") _Объёмы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	Активы = _Активы;
	Витрина = _Витрина;
	Разделы = _Разделы;
	Поля = _Поля;
	ФабрикаИтога = _ФабрикаИтога;
	Объёмы = _Объёмы;
	Тексты = _Тексты;

КонецПроцедуры
