// Раздел «Апстримы» дома «Пул»: список источников в порядке обхода и форма заведения
// нового. Экран собирается элементами кита.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем СервисПулов;       // СервисПулов (реестр) — источники пула в порядке обхода
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Страж;             // СтражАпстримов (прокси) — жив источник или лежит
Перем Пробник;           // ПробникИсточника (прокси) — делается ли проба подключения

#Область ПубличныйИнтерфейс

// Секции раздела «апстримы» пула: список источников и форма заведения нового.
//
// Параметры:
//  Параметры - Структура: * Пул - Пул - пул; * Адрес - Строка - адрес раздела (он же action форм); * Токен - Строка - CSRF-токен сессии.
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Результат = Новый Массив();
	Результат.Добавить(СекцияСписка(Параметры.Пул, Параметры.Адрес, Параметры.Токен));
	Результат.Добавить(СекцияЗаведения(Параметры.Адрес, Параметры.Токен));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СписокИсточников

Функция СекцияСписка(Знач Пул, Знач Адрес, Знач Токен)

	Список = Кит.Холст();
	Список.Добавить(ТаблицаИсточников(Пул, Адрес, Токен));
	Список.Добавить(Кит.Примечание(Тексты.Текст("settings.pool.upstreams.note")));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.pool.upstreams.title"),
		Тексты.Текст("settings.pool.upstreams.lead"), Список.Рендер());
	Секция.Иконка = "ссылка";
	Возврат Секция;

КонецФункции

Функция ТаблицаИсточников(Знач Пул, Знач Адрес, Знач Токен)

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.upstreams.col.position")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.upstreams.col.url")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.upstreams.col.ttl")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.upstreams.col.state")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.upstreams.col.order")));

	Номер = 0;
	Для Каждого Источник Из СервисПулов.АпстримыПула(Пул.Идентификатор) Цикл
		Номер = Номер + 1;
		Таблица.Добавить(ЗаписьИсточника(Источник, Номер, Адрес, Токен));
	КонецЦикла;

	Таблица.Пусто().Добавить(Кит.Примечание(Тексты.Текст("settings.pool.upstreams.empty"), "пусто"));
	Возврат Таблица;

КонецФункции

Функция ЗаписьИсточника(Знач Источник, Знач Номер, Знач Адрес, Знач Токен)

	Запись = Кит.Запись();
	Запись.Добавить(МестоВОбходе(Номер));
	Запись.Добавить(АдресИсточника(Источник));
	Запись.Добавить(ВремяЖизниКэша(Источник));
	Запись.Добавить(СостояниеИсточника(Источник));
	Запись.Добавить(ДействияНадИсточником(Адрес, Токен, Источник));
	Возврат Запись;

КонецФункции

Функция МестоВОбходе(Знач Номер)
	Возврат Значением(Тексты.ЧислоТекстом(Номер));
КонецФункции

Функция АдресИсточника(Знач Источник)

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Код(Источник.Url));
	Возврат Результат;

КонецФункции

Функция ВремяЖизниКэша(Знач Источник)
	Возврат Значением(Тексты.ЧислоТекстом(Источник.ВремяЖизниСек));
КонецФункции

// Что показано в колонке состояния: выключен рукой, лежит, жив либо ещё не проверялся.
// «Лежит» никогда не выдаётся за «выключен»: это две независимые вещи.
Функция СостояниеИсточника(Знач Источник)
	Возврат Значением(СостояниеСловами(Источник));
КонецФункции

Функция СостояниеСловами(Знач Источник)

	Если НЕ (Источник.Включён = Истина) Тогда
		Возврат Тексты.Текст("settings.pool.upstreams.state.off");
	КонецЕсли;

	Если Страж = Неопределено Тогда
		Возврат Тексты.Текст("settings.pool.upstreams.state.unknown");
	КонецЕсли;

	Отметка = Страж.Состояние(Источник);
	Если НЕ Отметка.Известно Тогда
		Возврат Тексты.Текст("settings.pool.upstreams.state.unknown");
	КонецЕсли;

	Когда = Формат(Отметка.Проверено, "ДФ='yyyy-MM-dd HH:mm:ss'");
	Если Отметка.Живой Тогда
		Возврат Тексты.Шаблон("settings.pool.upstreams.state.alive", Когда);
	КонецЕсли;
	Возврат Тексты.Шаблон("settings.pool.upstreams.state.down", Когда, Отметка.Причина);

КонецФункции

// Каждая кнопка — своя маленькая форма с CSRF: без JS работают все операции.
// Выключение и удаление — разные кнопки: подменять одно другим не приходится.
Функция ДействияНадИсточником(Знач Адрес, Знач Токен, Знач Источник)

	Url = Строка(Источник.Url);

	Результат = Кит.Ячейка();
	Результат.Добавить(КнопкаПодъёма(Адрес, Токен, Url));
	Результат.Добавить(КнопкаОпускания(Адрес, Токен, Url));
	Результат.Добавить(КнопкаПереключения(Адрес, Токен, Источник));
	Результат.Добавить(КнопкаУдаления(Адрес, Токен, Url));
	Возврат Результат;

КонецФункции

Функция КнопкаПодъёма(Знач Адрес, Знач Токен, Знач Url)
	Возврат ФормаОперации(Адрес, Токен, "вверх", Url,
		Тексты.Текст("settings.pool.upstreams.button.up"));
КонецФункции

Функция КнопкаОпускания(Знач Адрес, Знач Токен, Знач Url)
	Возврат ФормаОперации(Адрес, Токен, "вниз", Url,
		Тексты.Текст("settings.pool.upstreams.button.down"));
КонецФункции

Функция КнопкаПереключения(Знач Адрес, Знач Токен, Знач Источник)

	Если Источник.Включён = Истина Тогда
		Возврат ФормаОперации(Адрес, Токен, "выключить", Строка(Источник.Url),
			Тексты.Текст("settings.pool.upstreams.button.off"));
	КонецЕсли;

	Возврат ФормаОперации(Адрес, Токен, "включить", Строка(Источник.Url),
		Тексты.Текст("settings.pool.upstreams.button.on"));

КонецФункции

Функция КнопкаУдаления(Знач Адрес, Знач Токен, Знач Url)
	Возврат ФормаОперации(Адрес, Токен, "удалить", Url,
		Тексты.Текст("settings.pool.upstreams.button.remove"));
КонецФункции

// Позиция в форме не передаётся: её считает сервер по текущему порядку.
Функция ФормаОперации(Знач Адрес, Знач Токен, Знач Операция, Знач Url, Знач Подпись)

	Форма = Кит.Форма(Адрес, Токен, "строкой");
	Форма.Добавить(Кит.СкрытоеПоле("операция", Операция));
	Форма.Добавить(Кит.СкрытоеПоле("url", Url));
	Форма.Добавить(Кнопка(Подпись));
	Возврат Форма;

КонецФункции

#КонецОбласти

#Область ЗаведениеИсточника

Функция СекцияЗаведения(Знач Адрес, Знач Токен)

	Заведение = Кит.Холст();
	Заведение.Добавить(Кит.СкрытоеПоле("операция", "добавить"));
	Заведение.Добавить(ПолеАдреса());
	Заведение.Добавить(ПолеВремениЖизни());
	Заведение.Добавить(Кит.Примечание(ОбещаниеПробы()));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.pool.upstream-new.title"),
		Тексты.Текст("settings.pool.upstream-new.lead"), Заведение.Рендер());
	Секция.Действие = Адрес;
	Секция.Токен = Токен;
	Секция.Кнопка = Тексты.Текст("settings.pool.upstream-new.button");
	Возврат Секция;

КонецФункции

Функция ПолеАдреса()

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Плейсхолдер, Подсказка",
		"url", Тексты.Текст("settings.pool.upstream-new.url.label"),
		"http://hub.oscript.io/download/",
		Тексты.Текст("settings.pool.upstream-new.url.hint")));

КонецФункции

Функция ПолеВремениЖизни()

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Значение, Тип, Подсказка",
		"ttl", Тексты.Текст("settings.pool.upstream-new.ttl.label"), "900", "число",
		Тексты.Текст("settings.pool.upstream-new.ttl.hint")));

КонецФункции

// Обещать пробу вправе только тот экран, на котором она делается: выключатель
// oshub.upstream.probe.enabled (и отсутствие модуля прокси) снимает пробу целиком,
// и тогда форма говорит, что адрес сохранится непроверенным.
Функция ОбещаниеПробы()

	Если ПробаДелается() Тогда
		Возврат Тексты.Текст("settings.pool.upstream-new.probe.note");
	КонецЕсли;
	Возврат Тексты.Текст("settings.pool.upstream-new.probe.note.off");

КонецФункции

Функция ПробаДелается()
	Возврат Пробник <> Неопределено И Пробник.ПробаВключена();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Значением(Знач Текст)

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Текст(Текст));
	Возврат Результат;

КонецФункции

Функция Кнопка(Знач Подпись)

	Возврат Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Подпись, "вторичная", "малый"));

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СтражАпстримов", Тип = "Массив") _Страж,
	&Пластилин(Значение = "ПробникИсточника", Тип = "Массив") _Пробник)

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	СервисПулов = _СервисПулов;
	Тексты = _Тексты;
	// без модуля прокси состояние источника неизвестно, а список показывается как прежде
	Страж = ?(_Страж = Неопределено ИЛИ _Страж.Количество() = 0, Неопределено, _Страж[0]);
	// без модуля прокси пробы нет и у заведения источника (СервисПулов.ПроверитьПодключение)
	Пробник = ?(_Пробник = Неопределено ИЛИ _Пробник.Количество() = 0, Неопределено, _Пробник[0]);

КонецПроцедуры
