// Раздел «Резерв имён» дома «Пул»: занятые заранее имена, заведение нового резерва
// и серверный шаг подтверждения снятия. Экран собирается элементами кита.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем СервисРезервов;    // СервисРезервированияИмён (публикация) — действующие резервы пула
Перем СервисПулов;       // СервисПулов (реестр) — принимает ли пул публикации
Перем ДомПакета;         // ДомПакета (web-ui) — адрес раздела прав плейсхолдера
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секции раздела «резерв имён» дома «Пул».
//
// Параметры:
//  Параметры - Структура:
//    * Пул - Пул - пул, чьи резервы показываются;
//    * Адрес - Строка - адрес раздела (он же action форм);
//    * Токен - Строка - CSRF-токен сессии;
//    * Снятие - Строка, Неопределено - имя, снятие которого ждёт подтверждения (пусто либо Неопределено — шага подтверждения нет).
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Пул = Параметры.Пул;
	Адрес = Параметры.Адрес;
	Токен = Параметры.Токен;

	Снятие = "";
	Параметры.Свойство("Снятие", Снятие);

	Результат = Новый Массив();
	Если ЗначениеЗаполнено(Снятие) Тогда
		Результат.Добавить(СекцияПодтвержденияСнятия(Адрес, Токен, Снятие));
	КонецЕсли;
	Результат.Добавить(СекцияСписка(Пул, Адрес, Токен));
	Результат.Добавить(СекцияЗаведения(Пул, Адрес, Токен));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СписокРезервов

Функция СекцияСписка(Знач Пул, Знач Адрес, Знач Токен)

	Список = Кит.Холст();
	Список.Добавить(ТаблицаРезервов(Пул, Адрес, Токен));
	Список.Добавить(Кит.Примечание(Тексты.Текст("settings.pool.reserved.note")));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.pool.reserved.title"),
		Тексты.Текст("settings.pool.reserved.lead"), Список.Рендер());
	Секция.Иконка = "пакет";
	// секция без «Действия»: кнопка снятия каждой строки — своя маленькая форма
	Возврат Секция;

КонецФункции

Функция ТаблицаРезервов(Знач Пул, Знач Адрес, Знач Токен)

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.reserved.col.name")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.reserved.col.rights")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.reserved.col.action")));

	Для Каждого Пакет Из СервисРезервов.Резервы(Пул) Цикл
		Таблица.Добавить(ЗаписьРезерва(Пул, Пакет, Адрес, Токен));
	КонецЦикла;

	Таблица.Пусто().Добавить(Кит.Примечание(Тексты.Текст("settings.pool.reserved.empty"), "пусто"));
	Возврат Таблица;

КонецФункции

Функция ЗаписьРезерва(Знач Пул, Знач Пакет, Знач Адрес, Знач Токен)

	Имя = Строка(Пакет.Имя);

	Запись = Кит.Запись();
	Запись.Добавить(ЗанятоеИмя(Имя));
	Запись.Добавить(ХодКПравам(Пул, Имя));
	Запись.Добавить(КнопкаСнятия(Адрес, Токен, Имя));
	Возврат Запись;

КонецФункции

Функция ЗанятоеИмя(Знач Имя)

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Код(Имя));
	Возврат Результат;

КонецФункции

Функция ХодКПравам(Знач Пул, Знач Имя)

	Ссылка = Кит.Ссылка(ДомПакета.АдресРаздела(Пул.Имя, Имя, "access"));
	Ссылка.Добавить(Кит.Текст(Тексты.Текст("settings.pool.reserved.grant")));

	Результат = Кит.Ячейка();
	Результат.Добавить(Ссылка);
	Возврат Результат;

КонецФункции

// Без скрипта кнопка ведёт на серверный шаг подтверждения; сверяет его в обоих путях сервер.
Функция КнопкаСнятия(Знач Адрес, Знач Токен, Знач Имя)

	// значение подтверждения — само имя: форма одного резерва не снимает соседний
	Форма = Кит.Форма(Адрес, Токен, "строкой")
		.Признак("confirm", Тексты.Шаблон("settings.pool.reserved.release.confirm", Имя))
		.Признак("confirm-field", "подтверждение")
		.Признак("confirm-value", Имя);

	Форма.Добавить(Кит.СкрытоеПоле("операция", "снять"));
	Форма.Добавить(Кит.СкрытоеПоле("имя", Имя));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Тексты.Текст("settings.pool.reserved.button.release"), "опасная", "малый")));

	Результат = Кит.Ячейка();
	Результат.Добавить(Форма);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ЗаведениеРезерва

// Роль на занятое имя выдаётся уже в доме плейсхолдера, поэтому спрашивать её здесь нечего.
Функция СекцияЗаведения(Знач Пул, Знач Адрес, Знач Токен)

	Если НЕ СервисПулов.ПубликацияРазрешена(Пул) Тогда
		Возврат СекцияОтказаОтЗаведения();
	КонецЕсли;

	Заведение = Кит.Холст();
	Заведение.Добавить(Кит.СкрытоеПоле("операция", "зарезервировать"));
	Заведение.Добавить(ПолеИмени());

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.pool.reserve-new.title"),
		Тексты.Текст("settings.pool.reserve-new.lead"), Заведение.Рендер());
	Секция.Иконка = "плюс";
	Секция.Действие = Адрес;
	Секция.Токен = Токен;
	Секция.Кнопка = Тексты.Текст("settings.pool.reserve-new.button");
	Возврат Секция;

КонецФункции

Функция СекцияОтказаОтЗаведения()

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.pool.reserve-new.title"),
		Тексты.Текст("settings.pool.reserve-new.lead"),
		Кит.Примечание(Тексты.Текст("settings.pool.reserve-new.blocked")).Рендер());
	Секция.Иконка = "замок";
	Возврат Секция;

КонецФункции

Функция ПолеИмени()

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Плейсхолдер, Подсказка",
		"имя", Тексты.Текст("settings.pool.reserve-new.name.label"), "my-package",
		Тексты.Текст("settings.pool.reserve-new.name.hint")));

КонецФункции

#КонецОбласти

#Область ПодтверждениеСнятия

// Путь без скрипта; со скриптом до него не доходит — вопрос задаётся диалогом.
Функция СекцияПодтвержденияСнятия(Знач Адрес, Знач Токен, Знач Имя)

	// подтверждение эхом повторяет ИМЯ: сверка с ним, а не с общей константой, оставляет
	// обе стороны независимыми и не даёт подтвердить снятие одного имени формой другого
	Вопрос = Кит.Холст();
	Вопрос.Добавить(Кит.СкрытоеПоле("операция", "снять"));
	Вопрос.Добавить(Кит.СкрытоеПоле("имя", Имя));
	Вопрос.Добавить(Кит.СкрытоеПоле("подтверждение", Имя));
	Вопрос.Добавить(ВопросОСнятии(Имя));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.pool.reserved.release.title"),
		Тексты.Текст("settings.pool.reserved.release.lead"), Вопрос.Рендер());
	Секция.Иконка = "предупреждение";
	Секция.Действие = Адрес;
	Секция.Токен = Токен;
	Секция.Кнопка = Тексты.Текст("settings.pool.reserved.release.button");
	// «Опасная» красит и саму секцию, и кнопку подтверждения
	Секция.Опасная = Истина;
	// «Отмена» — обычная ссылка на тот же раздел: возврат ничего не меняет
	Секция.АдресОтмены = Адрес;
	Возврат Секция;

КонецФункции

Функция ВопросОСнятии(Знач Имя)

	Образец = Кит.Шаблон(Тексты.Текст("settings.pool.reserved.release.note"));
	Образец.Добавить(Кит.Код(Имя));

	Вопрос = Кит.Примечание();
	Вопрос.Добавить(Образец);
	Возврат Вопрос;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаРезервовПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "СервисРезервированияИмён") _Резервы,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ДомПакета") _ДомПакета,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	СервисРезервов = _Резервы;
	СервисПулов = _СервисПулов;
	ДомПакета = _ДомПакета;
	Тексты = _Тексты;

КонецПроцедуры
