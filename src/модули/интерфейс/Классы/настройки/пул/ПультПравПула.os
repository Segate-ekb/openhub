// Пульт прав пула — желудь модуля web-ui: выдача и отзыв ролей на ОДИН пул, заданный
// маршрутом. Ход операции общий с пакетом и живёт в ПультВыдачиРоли; здесь — объект
// раздела и слова, которыми он отказывает.

Перем Выдача;  // ПультВыдачиРоли (web-ui) — выдача и отзыв роли на объект раздела
Перем Тексты;  // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Вправе ли пользователь выдавать и отзывать права на этом пуле.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - инициатор.
//  Пул - Пул - пул раздела.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетВыдавать(Знач Пользователь, Знач Пул) Экспорт
	Возврат Выдача.МожетВыдавать(Пользователь, Раздел(Пул));
КонецФункции

// Применяет операцию раздела «права доступа» дома «Пул».
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Пул - Пул - пул раздела.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - итог операции; состав полей — см. ПультВыдачиРоли.Применить.
//
Функция Применить(Знач Пользователь, Знач Пул, Знач Форма) Экспорт
	Возврат Выдача.Применить(Пользователь, Раздел(Пул), Форма);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Объект раздела и слова его отказов: это всё, чем выдача роли на пул отличается
// от выдачи роли на пакет.
Функция Раздел(Знач Пул)

	Возврат Новый Структура("Вид, Идентификатор, ЧужойОбъект, НеизвестныйСубъект, НеСохранено",
		"пул", Пул.Идентификатор,
		Тексты.Текст("settings.pool.access.error.object"),
		Тексты.Текст("settings.pool.access.error.subject"),
		Тексты.Текст("settings.pool.error.save"));

КонецФункции

#КонецОбласти

&Прозвище("ПультПравПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПультВыдачиРоли") _Выдача,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Выдача = _Выдача;
	Тексты = _Тексты;

КонецПроцедуры
