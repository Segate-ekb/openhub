// Пульт резервов пула — желудь модуля web-ui: заведение и снятие резервов имён
// из дома «Пул». Порог операций и валидация имени живут в СервисРезервированияИмён.

Перем РазборФормы;     // РазборФормы (web-ui)
Перем СервисРезервов;  // СервисРезервированияИмён (публикация) — резерв, снятие, порог права
Перем Тексты;          // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Применяет операцию раздела «резерв имён» дома «Пул».
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса (порог права судит сервис).
//  Пул - Пул - пул раздела.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - Ошибка (Строка: "" — операция выполнена, иначе текст отказа для экрана),
//              Подтвердить (Строка: имя, снятие которого нужно подтвердить, "" — не нужно).
//
Функция Применить(Знач Принципал, Знач Пул, Знач Форма) Экспорт

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, "операция")));

	Если Операция = "зарезервировать" Тогда
		Возврат Зарезервировать(Принципал, Пул, Форма);
	ИначеЕсли Операция = "снять" Тогда
		Возврат Снять(Принципал, Пул, Форма);
	КонецЕсли;

	// белый список операций: неизвестная не должна попадать в чужую ветку
	Возврат Отказ(Тексты.Текст("settings.pool.reserved.error.operation"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Зарезервировать(Знач Принципал, Знач Пул, Знач Форма)

	Имя = СокрЛП(РазборФормы.Поле(Форма, "имя"));
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Возврат Отказ(Тексты.Текст("settings.pool.reserved.error.name"));
	КонецЕсли;

	Итог = СервисРезервов.Зарезервировать(Принципал, Пул, Имя);
	Возврат ?(Итог.Успех, Успех(), Отказ(Тексты.Шаблон("settings.pool.reserved.error.reserve",
		Итог.Сообщение)));

КонецФункции

// Первый POST только спрашивает: снятие уносит вместе с именем и выданные на него роли.
// Подтверждение эхом повторяет имя, поэтому форма одного резерва не снимает соседний.
Функция Снять(Знач Принципал, Знач Пул, Знач Форма)

	Имя = СокрЛП(РазборФормы.Поле(Форма, "имя"));
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Возврат Отказ(Тексты.Текст("settings.pool.reserved.error.name"));
	КонецЕсли;

	Если СокрЛП(РазборФормы.Поле(Форма, "подтверждение")) <> Имя Тогда
		Результат = Успех();
		Результат.Подтвердить = Имя;
		Возврат Результат;
	КонецЕсли;

	Итог = СервисРезервов.СнятьРезерв(Принципал, Пул, Имя);
	Возврат ?(Итог.Успех, Успех(), Отказ(Тексты.Шаблон("settings.pool.reserved.error.release",
		Итог.Сообщение)));

КонецФункции

Функция Успех()
	Возврат Новый Структура("Ошибка, Подтвердить", "", "");
КонецФункции

Функция Отказ(Знач Сообщение)
	Возврат Новый Структура("Ошибка, Подтвердить", Сообщение, "");
КонецФункции

#КонецОбласти

&Прозвище("ПультРезервовПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисРезервированияИмён") _Резервы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	СервисРезервов = _Резервы;
	Тексты = _Тексты;

КонецПроцедуры
