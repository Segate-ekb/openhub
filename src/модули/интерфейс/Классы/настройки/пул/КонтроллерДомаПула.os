// Дом настроек «Пул» — контроллер модуля web-ui.

Перем ГвардПула;         // ГвардПула (кабинет)
Перем Ответы;            // ОтветыНастроек (web-ui)
Перем Дом;               // ДомПула (web-ui)
Перем ВитринаДома;       // ВитринаДомаПула (web-ui) — секции разделов
Перем Гейт;              // ГейтФормы (web-ui) — метод запроса и токен формы
Перем Защита;            // ЗащитаCSRF (auth)
Перем РазборФормы;       // РазборФормы (web-ui)
Перем СервисПулов;       // СервисПулов (реестр)
Перем Каналы;            // КаналыПоУмолчанию (реестр) — имя настройки «заводить каналы сам»
Перем ГвардКвоты;        // ГвардКвотыПула (auth) — квоту назначает админ хаба
Перем ПультПрав;         // ПультПравПула (web-ui) — выдача и отзыв ролей на пул
Перем ПультРезервов;     // ПультРезервовПула (web-ui) — заведение и снятие резервов
Перем ПультЗаявок;       // ПультЗаявок (web-ui) — одобрение и отклонение заявок
Перем ПультАпстримов;    // ПультАпстримовПула (web-ui) — состав и порядок апстримов
Перем ПультУдаления;     // ПультУдаленияПула (web-ui) — право удалять и само удаление
Перем ДомАккаунта;       // ДомАккаунта (web-ui) — куда уходить, когда пула больше нет
Перем Итоги;             // ИтогПульта (web-ui) — форма итога раздела
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ТочкиМаршрута

// Точка маршрута «{pool}/settings» (GET).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//
&ТочкаМаршрута("{pool}/settings")
Процедура Обзор(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Вердикт = ГвардПула.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	ОтдатьРаздел(Ответ, Вердикт, Дом.РазделПоУмолчанию(), Показ(), КукиЗапроса);

КонецПроцедуры

// Точка маршрута «{pool}/settings/{раздел}» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  раздел - Строка - ключ раздела.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  form - Строка - "1" открывает окно выдачи роли сразу: это серверная дорога к форме
//         для движка, который не умеет команд кнопки (необязательный, по умолчанию "").
//
&ТочкаМаршрута("{pool}/settings/{раздел}")
Процедура Раздел(Ответ, pool, раздел, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	saved = "", form = "") Экспорт

	Вердикт = ГвардПула.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Ключ = НРег(СокрЛП(Строка(раздел)));
	Если НЕ Дом.ЕстьРаздел(Ключ) Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт.Пользователь,
			Тексты.Текст("settings.pool.error.section"), КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Вердикт, Ключ, Показ(ЗначениеЗаполнено(saved), ОкноПоАдресу(form)),
			КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Гейт.ПринятаяФорма(Ответ, Вердикт, "GET, POST", МетодЗапроса, ТелоЗапроса,
		КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Сохранить(Ответ, Вердикт, Ключ, Форма, КукиЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Сохранение

// Два гейта, потом итог раздела: ответ на любую ветвь пишет ОтдатьИтог.
Процедура Сохранить(Ответ, Знач Вердикт, Знач Ключ, Знач Форма, Знач КукиЗапроса)

	Если НЕ РазделПринимаетPOST(Ключ) Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	// гвард стоит ДО валидации и мутации: подделанная форма не должна доходить до записи
	Запрет = ЗапретПоПраву(Вердикт, Ключ);
	Если ЗначениеЗаполнено(Запрет) Тогда
		Ответы.ОтдатьЗапрещено(Ответ, Вердикт.Пользователь, Запрет, КукиЗапроса);
		Возврат;
	КонецЕсли;

	ОтдатьИтог(Ответ, Вердикт, Ключ, ИтогРаздела(Вердикт, Ключ, Форма), КукиЗапроса);

КонецПроцедуры

// Разделы дома «Пул», у которых вообще есть мутация.
Функция РазделПринимаетPOST(Знач Ключ)
	Возврат Ключ = "general" ИЛИ Ключ = "visibility" ИЛИ Ключ = "quota"
		ИЛИ Ключ = "upstreams" ИЛИ Ключ = "reserved" ИЛИ Ключ = "inbox"
		ИЛИ Ключ = "access" ИЛИ Ключ = "tags" ИЛИ Ключ = "danger";
КонецФункции

// Разделы, чьё право СТРОЖЕ порога дома: отказ по праву называет себя своим кодом, а не 400.
Функция ЗапретПоПраву(Знач Вердикт, Знач Ключ)

	Если Ключ = "quota" И НЕ ГвардКвоты.МожетМенятьКвоту(Вердикт.Пользователь) Тогда
		Возврат Тексты.Текст("settings.pool.error.quota.forbidden");
	КонецЕсли;
	Если Ключ = "danger" И НЕ ПультУдаления.МожетУдалять(Вердикт.Пользователь) Тогда
		Возврат Тексты.Текст("settings.pool.danger.error.forbidden");
	КонецЕсли;

	Возврат "";

КонецФункции

// Сначала валидация, потом мутация; форма итога — ИтогПульта, одна на все дома настроек.
Функция ИтогРаздела(Знач Вердикт, Знач Ключ, Знач Форма)

	Проблема = ПроблемаВвода(Ключ, Форма);
	Если ЗначениеЗаполнено(Проблема) Тогда
		Возврат Итоги.Отказ(Проблема);
	КонецЕсли;

	Попытка
		Возврат Применённое(Вердикт, Ключ, Форма);
	Исключение
		Возврат Итоги.Отказ(Тексты.Шаблон("settings.pool.error.save",
			Ответы.КраткоОшибка(ОписаниеОшибки())));
	КонецПопытки;

КонецФункции

// Ветви одного калибра: каждая возвращает итог, ответа не пишет ни одна.
Функция Применённое(Знач Вердикт, Знач Ключ, Знач Форма)

	Если Ключ = "general" Тогда
		// раздел справочный: всё, что в нём показано, меняется в других разделах и экранах
		Возврат Показ(Истина);
	ИначеЕсли Ключ = "reserved" Тогда
		Возврат Резерв(Вердикт, Форма);
	ИначеЕсли Ключ = "inbox" Тогда
		Возврат Заявка(Вердикт, Форма);
	ИначеЕсли Ключ = "access" Тогда
		Возврат Право(Вердикт, Форма);
	ИначеЕсли Ключ = "danger" Тогда
		Возврат Удаление(Вердикт, Форма);
	КонецЕсли;

	ЗаписатьЗначение(Вердикт.Пул, Ключ, Форма);
	Возврат Итоги.Переход(АдресСохранённого(Вердикт.Пул, Ключ));

КонецФункции

// Разделы-значения: одна запись в реестре пула, дальше общий редирект «сохранено».
Процедура ЗаписатьЗначение(Знач Пул, Знач Ключ, Знач Форма)

	Если Ключ = "visibility" Тогда
		СервисПулов.УстановитьВидимость(Пул.Идентификатор,
			РазборФормы.Поле(Форма, "видимость", "public"));
	ИначеЕсли Ключ = "quota" Тогда
		СервисПулов.УстановитьКвоту(Пул.Идентификатор, КвотаФормы(Форма).Квота);
	ИначеЕсли Ключ = "tags" Тогда
		СервисПулов.УстановитьФлаг(Пул.Идентификатор, Каналы.ИмяНастройкиПула(),
			РазборФормы.Флажок(Форма, "автоканалы"));
	ИначеЕсли Ключ = "upstreams" Тогда
		ПультАпстримов.Применить(Пул, Форма);
	КонецЕсли;

КонецПроцедуры

// Операции раздела резервов: снятие сначала спрашивает подтверждение.
Функция Резерв(Знач Вердикт, Знач Форма)

	Итог = ПультРезервов.Применить(Вердикт.Принципал, Вердикт.Пул, Форма);

	Если ЗначениеЗаполнено(Итог.Подтвердить) Тогда
		Возврат Итоги.Подтверждение(Итог.Подтвердить);
	КонецЕсли;
	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		Возврат Итоги.Отказ(Итог.Ошибка);
	КонецЕсли;

	Возврат Итоги.Переход(АдресСохранённого(Вердикт.Пул, "reserved"));

КонецФункции

// Решение по заявке: одобрение и отклонение сначала спрашивают подтверждение.
Функция Заявка(Знач Вердикт, Знач Форма)

	Итог = ПультЗаявок.Применить(Вердикт.Принципал, Форма, Вердикт.Пул);

	Если Итог.Подтвердить <> Неопределено Тогда
		Возврат Итоги.Подтверждение(Итог.Подтвердить);
	КонецЕсли;
	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		Возврат Итоги.Отказ(Итог.Ошибка);
	КонецЕсли;

	Возврат Итоги.Переход(АдресСохранённого(Вердикт.Пул, "inbox"));

КонецФункции

// Отбитая форма выдачи возвращается ТЕМ ЖЕ окном — открытым, с набранным и помеченным полем.
Функция Право(Знач Вердикт, Знач Форма)

	Итог = ПультПрав.Применить(Вердикт.Пользователь, Вердикт.Пул, Форма);

	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		Отказ = Итоги.Отказ(Итог.Ошибка);
		Отказ.Заведение = Итог.Заведение;
		Возврат Отказ;
	КонецЕсли;

	Возврат Итоги.Переход(АдресСохранённого(Вердикт.Пул, "access"));

КонецФункции

// Раздел жил внутри пула, а пула больше нет: удавшееся удаление уводит в личное пространство.
Функция Удаление(Знач Вердикт, Знач Форма)

	Итог = ПультУдаления.Применить(Вердикт.Пользователь, Вердикт.Пул, Форма);

	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		Возврат Итоги.Отказ(Итог.Ошибка);
	КонецЕсли;

	Возврат Итоги.Переход(ДомАккаунта.АдресКабинета());

КонецФункции

// Серверная дорога к форме для движка, который не умеет команд кнопки.
Функция ОкноПоАдресу(Знач ПризнакФормы)
	Возврат ?(Строка(ПризнакФормы) <> "1", Неопределено,
		Новый Структура("Открыта, Заполнение, Отказы", Истина, Неопределено, Новый Соответствие()));
КонецФункции

Функция АдресСохранённого(Знач Пул, Знач Ключ)
	Возврат Дом.АдресРаздела(Пул.Имя, Ключ) + "?saved=1";
КонецФункции

// «Сохранено» приезжает адресом после редиректа, окно выдачи — серверной дорогой к форме.
Функция Показ(Знач Сохранено = Ложь, Знач Заведение = Неопределено)

	Итог = Итоги.Успех();
	Итог.Сохранено = Сохранено;
	Итог.Заведение = Заведение;
	Возврат Итог;

КонецФункции

// Проверяет ввод раздела до мутации; пустая строка — ввод принят.
Функция ПроблемаВвода(Знач Ключ, Знач Форма)

	Если Ключ = "quota" Тогда
		Возврат ПроблемаКвоты(Форма);
	ИначеЕсли Ключ = "visibility" Тогда
		Видимость = НРег(СокрЛП(РазборФормы.Поле(Форма, "видимость")));
		Если Видимость <> "public" И Видимость <> "private" Тогда
			Возврат Тексты.Текст("settings.pool.error.visibility");
		КонецЕсли;
	ИначеЕсли Ключ = "upstreams" Тогда
		Возврат ПультАпстримов.Проблема(Форма);
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ПроблемаКвоты(Знач Форма)

	// судит сервис: форма и API обязаны отвечать на одинаковый ввод одинаково —
	// и читать значение тем же чтением, иначе «как в хабе» (-1) отвергал бы себя сам
	Вердикт = КвотаФормы(Форма);
	Если Вердикт.Ок Тогда
		Возврат "";
	КонецЕсли;

	Если Вердикт.Причина = СервисПулов.ПричинаКвотаПотолок() Тогда
		Возврат Тексты.Шаблон("settings.pool.error.quota.limit",
			Тексты.ЧислоТекстом(СервисПулов.ПредельнаяКвотаМб()));
	КонецЕсли;
	Возврат Тексты.Текст("settings.pool.error.quota.number");

КонецФункции

Функция КвотаФормы(Знач Форма)
	Возврат СервисПулов.РассудитьКвоту(РазборФормы.Поле(Форма, "квота_мб"));
КонецФункции

#КонецОбласти

#Область Рендер

// Удавшаяся мутация уводит редиректом, чтобы перезагрузка её не повторила.
Процедура ОтдатьИтог(Ответ, Знач Вердикт, Знач Ключ, Знач Итог, Знач КукиЗапроса)

	Если ЗначениеЗаполнено(Итог.Адрес) Тогда
		Ответ.Перенаправить(Итог.Адрес);
		Возврат;
	КонецЕсли;

	ОтдатьРаздел(Ответ, Вердикт, Ключ, Итог, КукиЗапроса);

КонецПроцедуры

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач Ключ, Знач Итог, Знач КукиЗапроса)

	Пул = СервисПулов.ПулПоИдентификатору(Вердикт.Пул.Идентификатор);
	Если Пул = Неопределено Тогда
		Пул = Вердикт.Пул;
	КонецЕсли;

	Хлебные = Новый Массив();
	Хлебные.Добавить(Новый Структура("Подпись, Адрес", Пул.Имя, Дом.АдресПула(Пул.Имя)));
	Хлебные.Добавить(Новый Структура("Подпись", Тексты.Текст("settings.pool.crumb")));

	Модель = Ответы.МодельДома(Дом, Пул.Имя,
		Дом.Разделы(Пул.Имя, Ключ),
		Ответы.УведомленияРаздела(Итог.Сохранено, Итог.Ошибка),
		ВитринаДома.Секции(ПараметрыСекций(Вердикт, Пул, Ключ, Итог)),
		Хлебные);

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт.Пользователь, КукиЗапроса, Дом.Заголовок(),
		СтатусИтога(Итог));

КонецПроцедуры

Функция ПараметрыСекций(Знач Вердикт, Знач Пул, Знач Ключ, Знач Итог)

	Результат = Новый Структура();
	Результат.Вставить("Ключ", Ключ);
	Результат.Вставить("Пул", Пул);
	Результат.Вставить("Токен", Защита.ТокенСессии(Вердикт.Сессия));
	Результат.Вставить("Пользователь", Вердикт.Пользователь);
	Результат.Вставить("Принципал", Вердикт.Принципал);
	Результат.Вставить("Спросить", Итог.Спросить);
	Результат.Вставить("Заведение", Итог.Заведение);
	Возврат Результат;

КонецФункции

Функция СтатусИтога(Знач Итог)

	Если НЕ ЗначениеЗаполнено(Итог.Ошибка) Тогда
		Возврат 200;
	КонецЕсли;
	Возврат ?(Итог.Статус > 0, Итог.Статус, 400);

КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардПула") _ГвардПула,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомПула") _Дом,
	&Пластилин(Значение = "ВитринаДомаПула") _ВитринаДома,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "КаналыПоУмолчанию") _Каналы,
	&Пластилин(Значение = "ГвардКвотыПула") _ГвардКвоты,
	&Пластилин(Значение = "ПультПравПула") _ПультПрав,
	&Пластилин(Значение = "ПультРезервовПула") _ПультРезервов,
	&Пластилин(Значение = "ПультЗаявок") _ПультЗаявок,
	&Пластилин(Значение = "ПультАпстримовПула") _ПультАпстримов,
	&Пластилин(Значение = "ПультУдаленияПула") _ПультУдаления,
	&Пластилин(Значение = "ДомАккаунта") _ДомАккаунта,
