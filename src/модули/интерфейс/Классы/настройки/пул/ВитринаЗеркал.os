// Раздел «Зеркала» дома «Пул»: список зеркал пула и форма заведения нового.
// Экран собирается элементами кита.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем СервисЗеркал;      // СервисЗеркал (зеркала) — список зеркал и известные режимы
Перем Прогоны;           // ПредставлениеПрогонаЗеркала (web-ui) — прогон в виде для экрана
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Пробник;           // ПробникИсточника (прокси) — делается ли проба подключения
Перем Секрет;            // СекретИсточника (прокси) — задан ли токен у зеркала

#Область ПубличныйИнтерфейс

// Секции раздела «зеркала» пула.
//
// Параметры:
//  Параметры - Структура: * Пул - Пул - пул назначения; * Адрес - Строка - адрес раздела (он же action форм); * Токен - Строка - CSRF-токен сессии.
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Результат = Новый Массив();
	Результат.Добавить(СекцияСписка(Параметры.Пул, Параметры.Адрес, Параметры.Токен));
	Результат.Добавить(СекцияЗаведения(Параметры.Адрес, Параметры.Токен));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СписокЗеркал

Функция СекцияСписка(Знач Пул, Знач Адрес, Знач Токен)

	Список = Кит.Холст();
	Список.Добавить(ТаблицаЗеркал(Пул, Адрес, Токен));
	Список.Добавить(Кит.Примечание(Тексты.Текст("settings.pool.mirrors.note")));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.pool.mirrors.title"),
		Тексты.Текст("settings.pool.mirrors.lead"), Список.Рендер());
	Секция.Иконка = "копировать";
	// секция без «Действия»: каждая кнопка строки — своя маленькая форма со своим адресом
	Возврат Секция;

КонецФункции

Функция ТаблицаЗеркал(Знач Пул, Знач Адрес, Знач Токен)

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.mirrors.col.upstream")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.mirrors.col.access")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.mirrors.col.mode")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.mirrors.col.interval")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.mirrors.col.state")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.mirrors.col.run")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.mirrors.col.sync")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.mirrors.col.actions")));

	Для Каждого Зеркало Из СервисЗеркал.СписокПула(Пул.Идентификатор) Цикл
		Таблица.Добавить(ЗаписьЗеркала(Зеркало, Адрес, Токен));
	КонецЦикла;

	Таблица.Пусто().Добавить(Кит.Примечание(Тексты.Текст("settings.pool.mirrors.empty"), "пусто"));
	Возврат Таблица;

КонецФункции

Функция ЗаписьЗеркала(Знач Зеркало, Знач Адрес, Знач Токен)

	Прогон = Прогоны.Модель(Зеркало, СервисЗеркал.ПрогонБрошен(Зеркало));

	Запись = Кит.Запись();
	Запись.Добавить(АдресАпстрима(Зеркало));
	Запись.Добавить(ДоступКАпстриму(Зеркало));
	Запись.Добавить(РежимСинхронизации(Зеркало));
	Запись.Добавить(ИнтервалСинхронизации(Зеркало));
	Запись.Добавить(Включённость(Зеркало));
	Запись.Добавить(СостояниеПрогона(Адрес, Зеркало, Прогон));
	Запись.Добавить(МоментПоследнегоСинка(Прогон));
	Запись.Добавить(ДействияНадЗеркалом(Адрес, Токен, Зеркало));
	Возврат Запись;

КонецФункции

Функция АдресАпстрима(Знач Зеркало)

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Код(Строка(Зеркало.АпстримURL)));
	Возврат Результат;

КонецФункции

// Токен виден только фактом: значение не показывается ни в списке, ни в форме.
Функция ДоступКАпстриму(Знач Зеркало)

	Приватный = ТокенЗадан(Зеркало);

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Плашка(Новый Структура("Текст, Вид",
		?(Приватный, Тексты.Текст("settings.pool.mirrors.access.token"),
			Тексты.Текст("settings.pool.mirrors.access.anonymous")),
		?(Приватный, "ok", ""))));
	Возврат Результат;

КонецФункции

Функция РежимСинхронизации(Знач Зеркало)
	Возврат Значением(Строка(Зеркало.Режим));
КонецФункции

Функция ИнтервалСинхронизации(Знач Зеркало)
	Возврат Значением(Тексты.ЧислоТекстом(Зеркало.ИнтервалСинкаСек));
КонецФункции

Функция Включённость(Знач Зеркало)

	Включено = (Зеркало.Включено = Истина);

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Плашка(Новый Структура("Текст, Вид",
		?(Включено, Тексты.Текст("settings.pool.mirrors.state.on"),
			Тексты.Текст("settings.pool.mirrors.state.off")),
		?(Включено, "ok", "warn"))));
	Возврат Результат;

КонецФункции

// Состояние прогона — ссылка на экран состояния: с него виден прогресс идущего обхода.
Функция СостояниеПрогона(Знач Адрес, Знач Зеркало, Знач Прогон)

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Плашка(Новый Структура("Текст, Вид, Адрес",
		Прогон.Подпись, Прогон.Вид, Адрес + "/" + Идентификатор(Зеркало))));
	Возврат Результат;

КонецФункции

Функция МоментПоследнегоСинка(Знач Прогон)

	Возврат Значением(?(ЗначениеЗаполнено(Прогон.ПоследнийСинк), Прогон.ПоследнийСинк,
		Тексты.Текст("settings.pool.mirrors.sync.never")));

КонецФункции

Функция ДействияНадЗеркалом(Знач Адрес, Знач Токен, Знач Зеркало)

	Результат = Кит.Ячейка();
	Результат.Добавить(ФормаСинхронизации(Адрес, Токен, Зеркало));
	Результат.Добавить(ФормаПереключения(Адрес, Токен, Зеркало));
	Если ТокенЗадан(Зеркало) Тогда
		Результат.Добавить(ФормаСнятияТокена(Адрес, Токен, Зеркало));
	КонецЕсли;
	Результат.Добавить(ФормаУдаления(Адрес, Токен, Зеркало));
	Возврат Результат;

КонецФункции

Функция ФормаСнятияТокена(Знач Адрес, Знач Токен, Знач Зеркало)

	Форма = Кит.Форма(Действие(Адрес, Зеркало, "token-off"), Токен, "строкой");
	Форма.Добавить(Кнопка(Тексты.Текст("settings.pool.mirrors.button.token-off")));
	Возврат Форма;

КонецФункции

Функция ФормаСинхронизации(Знач Адрес, Знач Токен, Знач Зеркало)

	Форма = Кит.Форма(Действие(Адрес, Зеркало, "sync"), Токен, "строкой");
	Форма.Добавить(Кнопка(Тексты.Текст("settings.pool.mirrors.button.sync")));
	Возврат Форма;

КонецФункции

Функция ФормаПереключения(Знач Адрес, Знач Токен, Знач Зеркало)

	Включено = (Зеркало.Включено = Истина);

	Форма = Кит.Форма(Действие(Адрес, Зеркало, "toggle"), Токен, "строкой");
	Форма.Добавить(Кит.СкрытоеПоле("включить", ?(Включено, "0", "1")));
	Форма.Добавить(Кнопка(?(Включено, Тексты.Текст("settings.pool.mirrors.button.disable"),
		Тексты.Текст("settings.pool.mirrors.button.enable"))));
	Возврат Форма;

КонецФункции

Функция ФормаУдаления(Знач Адрес, Знач Токен, Знач Зеркало)

	Форма = Кит.Форма(Действие(Адрес, Зеркало, "delete"), Токен, "строкой");
	Форма.Добавить(Кнопка(Тексты.Текст("settings.pool.mirrors.button.delete"), "опасная"));
	Возврат Форма;

КонецФункции

#КонецОбласти

#Область ЗаведениеЗеркала

Функция СекцияЗаведения(Знач Адрес, Знач Токен)

	Заведение = Кит.Холст();
	Заведение.Добавить(ПолеАпстрима());
	Заведение.Добавить(ПолеТокена());
	Заведение.Добавить(ПолеРежима());
	Заведение.Добавить(ПолеФильтра());
	Заведение.Добавить(ПолеИнтервала());
	Заведение.Добавить(Кит.Примечание(ОбещаниеПробы()));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.pool.mirror-new.title"),
		Тексты.Текст("settings.pool.mirror-new.lead"), Заведение.Рендер());
	Секция.Иконка = "плюс";
	Секция.Действие = Адрес;
	Секция.Токен = Токен;
	Секция.Кнопка = Тексты.Текст("settings.pool.mirror-new.button");
	Возврат Секция;

КонецФункции

Функция ПолеАпстрима()

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Плейсхолдер, Подсказка",
		"url", Тексты.Текст("settings.pool.mirror-new.url.label"),
		"http://hub.oscript.io/download/",
		Тексты.Текст("settings.pool.mirror-new.url.hint")));

КонецФункции

// Поле пустое всегда: заведённый токен обратно не показывается.
Функция ПолеТокена()

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Подсказка",
		"токен", Тексты.Текст("settings.pool.mirror-new.token.label"), "пароль", "",
		Тексты.Текст("settings.pool.mirror-new.token.hint")));

КонецФункции

Функция ПолеРежима()

	Варианты = Новый Массив();
	Для Каждого Режим Из СервисЗеркал.ИзвестныеРежимы() Цикл
		Варианты.Добавить(Новый Структура("Значение, Подпись", Режим, Режим));
	КонецЦикла;

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Варианты, Подсказка",
		"режим", Тексты.Текст("settings.pool.mirror-new.mode.label"), "выбор", Варианты,
		Тексты.Текст("settings.pool.mirror-new.mode.hint")));

КонецФункции

Функция ПолеФильтра()

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Плейсхолдер, Подсказка",
		"фильтр", Тексты.Текст("settings.pool.mirror-new.filter.label"),
		"[""corp-*"",""mylib""]",
		Тексты.Текст("settings.pool.mirror-new.filter.hint")));

КонецФункции

Функция ПолеИнтервала()

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Плейсхолдер, Подсказка",
		"интервал", Тексты.Текст("settings.pool.mirror-new.interval.label"), "число", "3600",
		Тексты.Текст("settings.pool.mirror-new.interval.hint")));

КонецФункции

// Обещать пробу вправе только экран, на котором она делается: выключатель снимает её целиком.
Функция ОбещаниеПробы()

	Если ПробаДелается() Тогда
		Возврат Тексты.Текст("settings.pool.mirror-new.probe.note");
	КонецЕсли;
	Возврат Тексты.Текст("settings.pool.mirror-new.probe.note.off");

КонецФункции

Функция ПробаДелается()
	Возврат Пробник <> Неопределено И Пробник.ПробаВключена();
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Значением(Знач Текст)

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Текст(Текст));
	Возврат Результат;

КонецФункции

Функция Кнопка(Знач Подпись, Знач Вариант = "вторичная")

	Возврат Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Подпись, Вариант, "малый"));

КонецФункции

Функция Действие(Знач Адрес, Знач Зеркало, Знач Операция)
	Возврат Адрес + "/" + Идентификатор(Зеркало) + "/" + Операция;
КонецФункции

Функция Идентификатор(Знач Зеркало)
	Возврат Формат(Зеркало.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

Функция ТокенЗадан(Знач Зеркало)
	Возврат Секрет.Задан(Секрет.ИзИсточника(Зеркало));
КонецФункции

#КонецОбласти

&Прозвище("ВитринаЗеркал")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Пластилин(Значение = "ПредставлениеПрогонаЗеркала") _Прогоны,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПробникИсточника", Тип = "Массив") _Пробник,
	&Пластилин(Значение = "СекретИсточника") _Секрет = Неопределено) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	СервисЗеркал = _СервисЗеркал;
	Прогоны = _Прогоны;
	Тексты = _Тексты;
	// без модуля прокси пробы нет и у заведения зеркала (СервисЗеркал.ПроверитьПодключение)
	Пробник = ?(_Пробник = Неопределено ИЛИ _Пробник.Количество() = 0, Неопределено, _Пробник[0]);
	Секрет = ?(_Секрет = Неопределено, Новый СекретИсточника(), _Секрет);

КонецПроцедуры
