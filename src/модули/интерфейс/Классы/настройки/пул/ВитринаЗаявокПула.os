// «Входящие» — заявки на публикацию, ждущие решения. Разметка одна и та же в разделе дома
// «Пул» и в сводке кабинета, отличается только колонкой пула. Плюс виджет главной.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем ДомПула;           // ДомПула (web-ui) — адрес пула для колонки сводки
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Бланки;            // БланкРаздела (web-ui) — адрес и токен раздела, формы на них
Перем Даты;  // ДатаЧеловеку (web-ui) — одно написание момента на весь интерфейс
Перем Обрезка; // ОбрезкаВЯчейке (web-ui) — длинное значение в узкой колонке
Перем Примечания;  // ПримечанияЭкрана (web-ui) — вид «показывать нечего»

#Область ПубличныйИнтерфейс

// Секции экрана «входящие».
//
// Параметры:
//  Параметры - Структура:
//    * Строки - Массив - строки заявок (Пул, Заявка, Заявитель) от РассмотрениеВходящих;
//    * Адрес - Строка - адрес раздела (он же action форм);
//    * Токен - Строка - CSRF-токен сессии;
//    * СПулом - Булево - показывать колонку «Пул» (сводка по всем пулам);
//    * Решение - Структура, Неопределено - заявка, решение по которой ждёт подтверждения (СтрокаВходящих, Операция).
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Бланк = Бланки.Раздела(Параметры);

	Решение = Неопределено;
	Параметры.Свойство("Решение", Решение);

	СПулом = Ложь;
	Параметры.Свойство("СПулом", СПулом);

	Результат = Новый Массив();
	Если Решение <> Неопределено Тогда
		Результат.Добавить(СекцияПодтверждения(Бланк, Решение));
	КонецЕсли;
	Результат.Добавить(СекцияСписка(Параметры.Строки, Бланк, СПулом));
	Возврат Результат;

КонецФункции

// Виджет «заявки ждут вашего решения» для главной кабинета: счётчик, несколько свежих
// строк и ссылка на полный список. Пустой строке заявок соответствует пустая разметка —
// блок с нулём на главной означал бы, что рядом что-то происходит.
//
// Параметры:
//  Строки - Массив - строки заявок (Пул, Заявка, Заявитель).
//  Адрес - Строка - адрес полного списка.
//  Предел - Число - сколько строк показать (необязательный, по умолчанию 3).
//
// Возвращаемое значение:
//  Строка - HTML виджета либо "" при отсутствии заявок.
//
Функция Виджет(Знач Строки, Знач Адрес, Знач Предел = 3) Экспорт

	Если Строки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Свежие = Свежайшие(Строки, Предел);

	Карточка = Кит.Карточка(Новый Структура("Заголовок, Иконка, Описание, Действия",
		Тексты.Шаблон("settings.inbox.widget.title", Тексты.ЧислоТекстом(Строки.Количество())),
		"пакет", Тексты.Текст("settings.inbox.widget.lead"), КнопкаПолногоСписка(Адрес).Рендер()));

	Карточка.Добавить(ТаблицаСвежих(Свежие));
	Карточка.Добавить(ХвостСписка(Строки.Количество(), Свежие.Количество()));
	Возврат Карточка.Рендер();

КонецФункции

#КонецОбласти

#Область СписокЗаявок

Функция СекцияСписка(Знач Строки, Знач Бланк, Знач СПулом)

	Список = Кит.Холст();
	Список.Добавить(ТаблицаЗаявок(Строки, Бланк, СПулом));
	Список.Добавить(Кит.Примечание(Тексты.Текст("settings.inbox.note")));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.inbox.title"),
		Тексты.Текст("settings.inbox.lead"), Список.Рендер());
	Секция.Иконка = "пакет";
	// секция без «Действия»: решение по каждой заявке — своя маленькая форма
	Возврат Секция;

КонецФункции

Функция ТаблицаЗаявок(Знач Строки, Знач Бланк, Знач СПулом)

	Таблица = Кит.Таблица();
	Если СПулом Тогда
		Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.inbox.col.pool")));
	КонецЕсли;
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.inbox.col.package")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.inbox.col.author")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.inbox.col.filed")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.inbox.col.artifact")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.inbox.col.action")));

	Для Каждого СтрокаВходящих Из Строки Цикл
		Таблица.Добавить(ЗаписьЗаявки(СтрокаВходящих, Бланк, СПулом));
	КонецЦикла;

	Таблица.Пусто().Добавить(Примечания.Пусто(Тексты.Текст("settings.inbox.empty")));
	Возврат Таблица;

КонецФункции

Функция ЗаписьЗаявки(Знач СтрокаВходящих, Знач Бланк, Знач СПулом)

	Заявка = СтрокаВходящих.Заявка;

	Запись = Кит.Запись();
	Если СПулом Тогда
		Запись.Добавить(ПулЗаявки(СтрокаВходящих.Пул));
	КонецЕсли;
	Запись.Добавить(ИмяИВерсия(Заявка));
	Запись.Добавить(ЛюдиЗаявки(СтрокаВходящих));
	Запись.Добавить(МоментПодачи(Заявка));
	Запись.Добавить(ОписаниеАртефакта(Заявка));
	Запись.Добавить(РешенияПоЗаявке(Бланк, Цел(Заявка.Идентификатор)));
	Возврат Запись;

КонецФункции

Функция ПулЗаявки(Знач Пул)

	Ссылка = Кит.Ссылка(ДомПула.АдресПула(Пул.Имя));
	Ссылка.Добавить(Кит.Текст(Строка(Пул.Имя)));

	Результат = Кит.Ячейка();
	Результат.Добавить(Ссылка);
	Возврат Результат;

КонецФункции

Функция ИмяИВерсия(Знач Заявка)

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Код(Строка(Заявка.ИмяПакета)));
	Результат.Добавить(Кит.Текст(" " + Строка(Заявка.Версия)));
	Возврат Результат;

КонецФункции

// Автор манифеста печатается, только когда он отличается от заявителя.
Функция ЛюдиЗаявки(Знач СтрокаВходящих)

	Логин = ЛогинЗаявителя(СтрокаВходящих.Заявитель);

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Текст(Логин));
	Результат.Добавить(АвторМанифеста(СтрокаВходящих.Заявка, Логин));
	Возврат Результат;

КонецФункции

Функция АвторМанифеста(Знач Заявка, Знач Логин)

	Автор = СокрЛП(Строка(Заявка.АвторМанифеста));
	Если НЕ ЗначениеЗаполнено(Автор) ИЛИ НРег(Автор) = НРег(СокрЛП(Логин)) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Результат = Кит.Надпись("приглушённая");
	Результат.Добавить(Кит.Текст(Тексты.Шаблон("settings.inbox.manifest.author", Автор)));
	Возврат Результат;

КонецФункции

Функция МоментПодачи(Знач Заявка)

	Возврат Значением(Тексты.Шаблон("settings.inbox.filed.value",
		Даты.ДатаВремя(Заявка.Создана),
		Тексты.ЧислоТекстом(Цел(Заявка.Идентификатор))));

КонецФункции

Функция ОписаниеАртефакта(Знач Заявка)

	Канал = СокрЛП(Строка(Заявка.Канал));

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Текст(Тексты.Шаблон("settings.inbox.artifact.value",
		Тексты.ЧислоТекстом(Цел(Заявка.Размер)), ?(ЗначениеЗаполнено(Канал), Канал, "—")) + " "));
	Результат.Добавить(ПриглушённыйОтпечаток(КороткийSha(Строка(Заявка.Sha256))));
	Возврат Результат;

КонецФункции

// Полный sha256 виден на шаге подтверждения; в таблице он ломал бы вёрстку.
Функция КороткийSha(Знач Значение)
	Возврат Обрезка.ДоЗнаков(Значение, ЗнаковОтпечаткаВТаблице());
КонецФункции

Функция ЗнаковОтпечаткаВТаблице()
	Возврат 12;
КонецФункции

// Каждое решение — своя маленькая форма с CSRF: без JS работают обе кнопки.
Функция РешенияПоЗаявке(Знач Бланк, Знач Номер)

	Результат = Кит.Ячейка();
	Результат.Добавить(ФормаРешения(Бланк, "одобрить", Номер,
		Тексты.Текст("settings.inbox.button.approve"), "основная"));
	Результат.Добавить(ФормаРешения(Бланк, "отклонить", Номер,
		Тексты.Текст("settings.inbox.button.reject"), "опасная"));
	Возврат Результат;

КонецФункции

Функция ФормаРешения(Знач Бланк, Знач Операция, Знач Номер, Знач Подпись, Знач Вариант)

	Форма = Бланки.Форма(Бланк);
	Форма.Добавить(Кит.СкрытоеПоле("операция", Операция));
	Форма.Добавить(Кит.СкрытоеПоле("заявка", Формат(Номер, "ЧГ=0; ЧН=0")));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Подпись, Вариант, "малый")));
	Возврат Форма;

КонецФункции

#КонецОбласти

#Область ПодтверждениеРешения

// Вопрос задаёт сервер, поэтому шаг работает без скрипта; эхо повторяет НОМЕР заявки.
Функция СекцияПодтверждения(Знач Бланк, Знач Решение)

	Отклонение = (Решение.Операция = "отклонить");
	Номер = Формат(Цел(Решение.СтрокаВходящих.Заявка.Идентификатор), "ЧГ=0; ЧН=0");

	Вопрос = Кит.Холст();
	Вопрос.Добавить(Кит.СкрытоеПоле("операция", Решение.Операция));
	Вопрос.Добавить(Кит.СкрытоеПоле("заявка", Номер));
	Вопрос.Добавить(Кит.СкрытоеПоле("подтверждение", Номер));
	Вопрос.Добавить(КарточкаЗаявки(Решение.СтрокаВходящих));
	Вопрос.Добавить(?(Отклонение, ПолеПричины(), Кит.Ничего()));

	// ключи выписаны литералами подряд, а не выбором внутри вызова: сборщик ключей ищет
	// строку сразу за «.Текст("» и «.Шаблон("», и тернарник спрятал бы их от него
	Если Отклонение Тогда
		Заголовок = Тексты.Шаблон("settings.inbox.reject.title", Номер);
		Пояснение = Тексты.Текст("settings.inbox.reject.lead");
		Подпись = Тексты.Текст("settings.inbox.reject.button");
	Иначе
		Заголовок = Тексты.Шаблон("settings.inbox.approve.title", Номер);
		Пояснение = Тексты.Текст("settings.inbox.approve.lead");
		Подпись = Тексты.Текст("settings.inbox.approve.button");
	КонецЕсли;

	Секция = РендерерНастроек.Секция(Заголовок, Пояснение, Вопрос.Рендер());
	Секция.Иконка = ?(Отклонение, "предупреждение", "пакет");
	Секция.Действие = Бланки.Адрес(Бланк);
	Секция.Токен = Бланк.Токен;
	Секция.Кнопка = Подпись;
	Секция.Опасная = Отклонение;
	// «Отмена» — обычная ссылка на тот же раздел: возврат ничего не меняет
	Секция.АдресОтмены = Бланки.Адрес(Бланк);
	Возврат Секция;

КонецФункции

Функция ПолеПричины()

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Плейсхолдер, Подсказка",
		"причина", Тексты.Текст("settings.inbox.reason.label"), "многострочное",
		Тексты.Текст("settings.inbox.reason.placeholder"),
		Тексты.Текст("settings.inbox.reason.hint")));

КонецФункции

// По карточке принимается решение, поэтому здесь sha256 целиком.
Функция КарточкаЗаявки(Знач СтрокаВходящих)

	Заявка = СтрокаВходящих.Заявка;
	Канал = СокрЛП(Строка(Заявка.Канал));
	Автор = СокрЛП(Строка(Заявка.АвторМанифеста));

	Карточка = Кит.Таблица();
	Карточка.Добавить(Факт(Тексты.Текст("settings.inbox.card.pool"), Строка(СтрокаВходящих.Пул.Имя)));
	Карточка.Добавить(Факт(Тексты.Текст("settings.inbox.card.package"),
		СтрШаблон("%1 %2", Заявка.ИмяПакета, Заявка.Версия)));
	Карточка.Добавить(Факт(Тексты.Текст("settings.inbox.card.applicant"),
		ЛогинЗаявителя(СтрокаВходящих.Заявитель)));
	Карточка.Добавить(Факт(Тексты.Текст("settings.inbox.card.manifest-author"),
		?(ЗначениеЗаполнено(Автор), Автор, "—")));
	Карточка.Добавить(Факт(Тексты.Текст("settings.inbox.card.filed"),
		Даты.ДатаВремя(Заявка.Создана)));
	Карточка.Добавить(Факт(Тексты.Текст("settings.inbox.card.size"),
		Тексты.Шаблон("settings.inbox.size.value", Тексты.ЧислоТекстом(Цел(Заявка.Размер)))));
	Карточка.Добавить(Факт(Тексты.Текст("settings.inbox.card.channel"),
		?(ЗначениеЗаполнено(Канал), Канал, "—")));
	Карточка.Добавить(Факт(Тексты.Текст("settings.inbox.card.file"), Строка(Заявка.ИмяФайла)));
	Карточка.Добавить(Факт(Тексты.Текст("settings.inbox.card.sha256"), Строка(Заявка.Sha256)));
	Возврат Карточка;

КонецФункции

Функция Факт(Знач Поле, Знач Значение)

	Результат = Кит.Запись();
	Результат.Добавить(Значением(Поле));
	Результат.Добавить(Значением(Значение));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ВиджетГлавной

Функция Свежайшие(Знач Строки, Знач Предел)

	Результат = Новый Массив();
	Для Каждого СтрокаВходящих Из Строки Цикл
		Если Результат.Количество() >= Предел Тогда
			Прервать;
		КонецЕсли;
		Результат.Добавить(СтрокаВходящих);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ТаблицаСвежих(Знач Свежие)

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.inbox.col.package")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.inbox.col.pool")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.inbox.col.author")));

	Для Каждого СтрокаВходящих Из Свежие Цикл
		Таблица.Добавить(ЗаписьВиджета(СтрокаВходящих));
	КонецЦикла;
	Возврат Таблица;

КонецФункции

Функция ЗаписьВиджета(Знач СтрокаВходящих)

	Запись = Кит.Запись();
	Запись.Добавить(ИмяИВерсия(СтрокаВходящих.Заявка));
	Запись.Добавить(Значением(Строка(СтрокаВходящих.Пул.Имя)));
	Запись.Добавить(Значением(ЛогинЗаявителя(СтрокаВходящих.Заявитель)));
	Возврат Запись;

КонецФункции

Функция ХвостСписка(Знач Всего, Знач Показано)

	Если Всего <= Показано Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Примечание(Тексты.Шаблон("settings.inbox.widget.rest",
		Тексты.ЧислоТекстом(Всего - Показано)));

КонецФункции

Функция КнопкаПолногоСписка(Знач Адрес)

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Иконка",
		Тексты.Текст("settings.inbox.widget.open"), Адрес, "вправо"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЛогинЗаявителя(Знач Заявитель)

	Возврат ?(Заявитель = Неопределено,
		Тексты.Текст("settings.inbox.applicant.gone"), Строка(Заявитель.Логин));

КонецФункции

Функция ПриглушённыйОтпечаток(Знач Значение)
	Возврат Кит.Код(Значение, "приглушённый");
КонецФункции

Функция Значением(Знач Текст)

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Текст(Текст));
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаЗаявокПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "БланкРаздела") _Бланки,
	&Пластилин(Значение = "ПримечанияЭкрана") _Примечания,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено,
	&Пластилин(Значение = "ОбрезкаВЯчейке") _Обрезка = Неопределено) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	ДомПула = _ДомПула;
	Тексты = _Тексты;
	Бланки = _Бланки;
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);
	Обрезка = ?(_Обрезка = Неопределено, Новый ОбрезкаВЯчейке(), _Обрезка);
	Примечания = _Примечания;

КонецПроцедуры
