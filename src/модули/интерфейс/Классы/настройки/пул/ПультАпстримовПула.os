// Пульт апстримов пула — желудь модуля web-ui: операции раздела «Апстримы» дома «Пул».
// Одна форма и один POST, операция приходит полем из белого списка.

Перем РазборФормы;  // РазборФормы (web-ui)
Перем СервисПулов;  // СервисПулов (реестр) — состав и порядок апстримов
Перем Тексты;       // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Проверяет ввод раздела ДО мутации.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Строка - текст отказа; "" — ввод принят.
//
Функция Проблема(Знач Форма) Экспорт

	Операция = Операция(Форма);
	Если НЕ ЗначениеЗаполнено(Операция) Тогда
		// белый список: любая неизвестная операция — отказ
		Возврат Тексты.Текст("settings.pool.error.upstream.operation");
	КонецЕсли;

	Если Операция = "добавить" Тогда
		Если НЕ ЗначениеЗаполнено(Адрес(Форма)) Тогда
			Возврат Тексты.Текст("settings.pool.error.upstream.url");
		КонецЕсли;
		Если РазборФормы.ЦелоеПоле(Форма, "ttl", 900) = Неопределено Тогда
			Возврат Тексты.Текст("settings.pool.error.upstream.ttl");
		КонецЕсли;
	ИначеЕсли Операция = "удалить" ИЛИ Операция = "вверх" ИЛИ Операция = "вниз"
		ИЛИ Операция = "включить" ИЛИ Операция = "выключить" ИЛИ Операция = "снять-токен" Тогда
		Если НЕ ЗначениеЗаполнено(Адрес(Форма)) Тогда
			Возврат Тексты.Текст("settings.pool.error.upstream.target");
		КонецЕсли;
	КонецЕсли;

	Возврат "";

КонецФункции

// Применяет операцию раздела «апстримы».
//
// Параметры:
//  Пул - Пул - пул раздела.
//  Форма - Соответствие - разобранная форма.
//
Процедура Применить(Знач Пул, Знач Форма) Экспорт

	Операция = Операция(Форма);
	Url = Адрес(Форма);

	Если Операция = "добавить" Тогда
		// пустое поле токена означает «оставить прежний»: правка TTL заведённого источника
		// вводить секрет заново не требует
		СервисПулов.ДобавитьАпстрим(Пул.Идентификатор, Url, РазборФормы.ЦелоеПоле(Форма, "ttl", 900),
			"", Ложь, РазборФормы.Поле(Форма, "токен"));
	ИначеЕсли Операция = "снять-токен" Тогда
		СервисПулов.СнятьТокенАпстрима(Пул.Идентификатор, Url);
	ИначеЕсли Операция = "включить" ИЛИ Операция = "выключить" Тогда
		СервисПулов.ПереключитьАпстрим(Пул.Идентификатор, Url, Операция = "включить");
	ИначеЕсли Операция = "удалить" Тогда
		СервисПулов.УдалитьАпстрим(Пул.Идентификатор, Url);
	ИначеЕсли Операция = "вверх" ИЛИ Операция = "вниз" Тогда
		// позиция считается сервером по текущему порядку, а не берётся из скрытого поля
		Текущая = Позиция(Пул, Url);
		Если Текущая >= 0 Тогда
			СервисПулов.ПереместитьАпстрим(Пул.Идентификатор, Url,
				Текущая + ?(Операция = "вверх", -1, 1));
		КонецЕсли;
	ИначеЕсли Операция = "флаги" Тогда
		// состояние флажка читается сравнением: ЗначениеЗаполнено("0") даёт Истину
		СервисПулов.УстановитьПубликациюРазрешена(Пул.Идентификатор,
			РазборФормы.Флажок(Форма, "публикация"));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Нормализованная операция раздела либо "" для неизвестной.
Функция Операция(Знач Форма)

	Значение = НРег(СокрЛП(РазборФормы.Поле(Форма, "операция")));
	Если Значение = "добавить" ИЛИ Значение = "удалить" ИЛИ Значение = "вверх"
		ИЛИ Значение = "вниз" ИЛИ Значение = "флаги" ИЛИ Значение = "снять-токен"
		ИЛИ Значение = "включить" ИЛИ Значение = "выключить" Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция Адрес(Знач Форма)
	Возврат СокрЛП(РазборФормы.Поле(Форма, "url"));
КонецФункции

// Текущий индекс апстрима в порядке опроса либо -1, если такого адреса в пуле нет.
Функция Позиция(Знач Пул, Знач Url)

	Индекс = 0;
	Для Каждого Апстрим Из СервисПулов.АпстримыПула(Пул.Идентификатор) Цикл
		Если СокрЛП(Строка(Апстрим.Url)) = Url Тогда
			Возврат Индекс;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат -1;

КонецФункции

#КонецОбласти

&Прозвище("ПультАпстримовПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	СервисПулов = _СервисПулов;
	Тексты = _Тексты;

КонецПроцедуры
