// Контроллер подписок ПУЛА — модуль web-ui.

Перем Гвард;          // ГвардКабинета (кабинет)
Перем Защита;         // ЗащитаCSRF (auth) — токен для форм страницы
Перем СервисПулов;    // СервисПулов (реестр)
Перем СервисПодписок; // СервисПодписок (подписки)
Перем СервисПрав;     // СервисПрав (auth)
Перем Ответы;         // ОтветыНастроек (web-ui)
Перем Дом;            // ДомПула (web-ui)
Перем Витрина;        // ВитринаПодписок (web-ui)
Перем Пульт;          // ПультПодписок (web-ui)
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ТочкиМаршрута

// Точка маршрута «{pool}/settings/webhooks» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  kind - Строка - тип действия, поля которого показывает форма заведения
//         (необязательный, по умолчанию "").
//
&ТочкаМаршрута("{pool}/settings/webhooks")
Процедура Пул(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	kind = "") Экспорт

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьСписок(Ответ, Контекст, "", "", КукиЗапроса, 200, kind);
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Контекст.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Контекст.Сессия, Контекст.Пользователь, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗавершитьДействие(Ответ, Контекст,
		Пульт.Создать(Контекст.Пользователь, Объект(Контекст), Форма), КукиЗапроса,
		Пульт.ТипДействия(Форма), Форма);

КонецПроцедуры

// Точка маршрута «{pool}/settings/webhooks/{id}/delete».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{pool}/settings/webhooks/{id}/delete")
Процедура Удаление(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Выполнить_(Ответ, pool, id, "удалить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «{pool}/settings/webhooks/{id}/save» — сохранение правки подписки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{pool}/settings/webhooks/{id}/save")
Процедура Сохранение(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Выполнить_(Ответ, pool, id, "сохранить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «{pool}/settings/webhooks/{id}/test» — пробная отправка сохранёнными настройками.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{pool}/settings/webhooks/{id}/test")
Процедура ПробнаяОтправка(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Выполнить_(Ответ, pool, id, "проба", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «{pool}/settings/webhooks/{id}/toggle».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{pool}/settings/webhooks/{id}/toggle")
Процедура Переключение(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Выполнить_(Ответ, pool, id, "переключить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура Выполнить_(Ответ, Знач pool, Знач id, Знач Действие,
	Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)

	Контекст = Подготовить(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "POST", Контекст.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Контекст.Сессия, Контекст.Пользователь, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗавершитьДействие(Ответ, Контекст,
		Пульт.Применить(Контекст.Пользователь, Объект(Контекст), Действие, id, Форма), КукиЗапроса,
		Пульт.ТипДействия(Форма), Форма, id);

КонецПроцедуры

Процедура ЗавершитьДействие(Ответ, Знач Контекст, Знач Исход, Знач КукиЗапроса, Знач Тип = "",
	Знач Форма = Неопределено, Знач ПравкаИд = 0)

	Если Исход.НеНайдено Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Контекст.Пользователь,
			Тексты.Текст("subscriptions.error.notfound"), КукиЗапроса);
		Возврат;
	КонецЕсли;
	Если НЕ Исход.Успех Тогда
		ОтдатьСписок(Ответ, Контекст, "", Исход.Ошибка, КукиЗапроса, 400, Тип, Форма, ПравкаИд);
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Исход.Сообщение) Тогда
		ОтдатьСписок(Ответ, Контекст, "", "", КукиЗапроса, 200, Тип, Неопределено, 0,
			Исход.Сообщение, Исход.ВидСообщения);
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Исход.Секрет) Тогда
		ОтдатьСписок(Ответ, Контекст, Исход.Секрет, "", КукиЗапроса);
		Возврат;
	КонецЕсли;
	Ответ.Перенаправить(Адрес(Контекст));

КонецПроцедуры

#КонецОбласти

#Область ОбщаяЛогика

// Гвард + резолв пула + проверка права администрирования.
Функция Подготовить(Ответ, Знач pool, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Пользователь = Вердикт.Пользователь;

	Пул = СервисПулов.НайтиПул(pool);
	// несуществующий и чужой приватный пул дают одинаковый 404
	Если Пул = Неопределено ИЛИ НЕ СервисПрав.МожетЧитать(Пользователь, Пул) Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Пользователь, Тексты.Текст("subscriptions.pool.error.notfound"),
			КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	// подписками пула распоряжается только владелец/админ пула — на КАЖДОМ действии
	Если НЕ СервисПрав.МожетАдминистрировать(Пользователь, Пул) Тогда
		Ответы.ОтдатьЗапрещено(Ответ, Пользователь,
			Тексты.Текст("subscriptions.pool.error.forbidden"), КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить("Пользователь", Пользователь);
	Результат.Вставить("Сессия", Вердикт.Сессия);
	Результат.Вставить("Пул", Пул);
	Возврат Результат;

КонецФункции

Функция Объект(Знач Контекст)
	Возврат СервисПодписок.ОбъектПула(Контекст.Пул);
КонецФункции

Функция Адрес(Знач Контекст)
	Возврат Дом.АдресРаздела(Контекст.Пул.Имя, "webhooks");
КонецФункции

#КонецОбласти

#Область Рендер

Процедура ОтдатьСписок(Ответ, Знач Контекст, Знач НовыйСекрет, Знач Ошибка, Знач КукиЗапроса,
	Знач Статус = 200, Знач Тип = "", Знач Форма = Неопределено, Знач ПравкаИд = 0,
	Знач Сообщение = "", Знач ВидСообщения = "")

	Пул = Контекст.Пул;

	Уведомления = Новый Массив();
	Если ЗначениеЗаполнено(НовыйСекрет) Тогда
		Уведомления.Добавить(Ответы.Уведомление(Тексты.Текст("subscriptions.notice.created"), "ok"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Уведомления.Добавить(Ответы.Уведомление(Ошибка, "err"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Сообщение) Тогда
		Уведомления.Добавить(Ответы.Уведомление(Сообщение, ВидСообщения));
	КонецЕсли;

	Параметры = Новый Структура();
	Параметры.Вставить("Объект", Объект(Контекст));
	Параметры.Вставить("Адрес", Адрес(Контекст));
	Параметры.Вставить("Токен", Защита.ТокенСессии(Контекст.Сессия));
	Параметры.Вставить("НовыйСекрет", НовыйСекрет);
	Параметры.Вставить("Пояснение", Тексты.Текст("subscriptions.pool.lead"));
	Параметры.Вставить("МожноМенять", Истина); // сюда пускает только гейт администрирования
	Параметры.Вставить("Тип", Тип);
	// отказ возвращает форму заполненной ровно тем, что прислали (секреты — исключение)
	Параметры.Вставить("Форма", Форма);
	Параметры.Вставить("ПравкаИд", ПравкаИд);

	Хлебные = Новый Массив();
	Хлебные.Добавить(Новый Структура("Подпись, Адрес", Пул.Имя, Дом.АдресПула(Пул.Имя)));
	Хлебные.Добавить(Новый Структура("Подпись", Тексты.Текст("settings.pool.crumb")));

	Модель = Новый Структура();
	Модель.Вставить("Ключ", Дом.Ключ());
	Модель.Вставить("Заголовок", Дом.Заголовок());
	Модель.Вставить("Объект", Пул.Имя);
	Модель.Вставить("Пояснение", Дом.Пояснение());
	Модель.Вставить("Разделы", Дом.Разделы(Пул.Имя, "webhooks"));
	Модель.Вставить("Уведомления", Уведомления);
	Модель.Вставить("Хлебные", Хлебные);
	Модель.Вставить("Секции", Витрина.Секции(Параметры));

	Ответы.ОтдатьДом(Ответ, Модель, Контекст.Пользователь, КукиЗапроса, Дом.Заголовок(), Статус);

КонецПроцедуры

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _Гвард,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомПула") _Дом,
	&Пластилин(Значение = "ВитринаПодписок") _Витрина,
	&Пластилин(Значение = "ПультПодписок") _Пульт,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	Гвард = _Гвард;
	Защита = _Защита;
	СервисПулов = _СервисПулов;
	СервисПодписок = _СервисПодписок;
	СервисПрав = _СервисПрав;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	Пульт = _Пульт;
	Тексты = _Тексты;

КонецПроцедуры
