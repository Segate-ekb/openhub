// Дом настроек «Пул» — желудь модуля web-ui.

Перем Каталог;   // КаталогРазделов (web-ui)
Перем Тексты;    // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Описания;  // Массив описаний разделов

// Ключ дома.
//
// Возвращаемое значение:
//  Строка - ключ дома.
//
Функция Ключ() Экспорт
	Возврат "pool";
КонецФункции

// Базовый адрес дома для пула с указанным именем.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Строка - "/{pool}/settings".
//
Функция БазовыйАдрес(Знач ИмяПула) Экспорт
	Возврат "/" + Каталог.Сегмент(ИмяПула) + "/settings";
КонецФункции

// Адрес публичной страницы пула.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Строка - адрес публичной страницы пула.
//
Функция АдресПула(Знач ИмяПула) Экспорт
	Возврат "/" + Каталог.Сегмент(ИмяПула);
КонецФункции

// Раздел по умолчанию.
//
// Возвращаемое значение:
//  Строка - раздел по умолчанию.
//
Функция РазделПоУмолчанию() Экспорт
	Возврат "general";
КонецФункции

// Адрес раздела дома.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - адрес раздела дома.
//
Функция АдресРаздела(Знач ИмяПула, Знач Ключ) Экспорт
	Возврат Каталог.Адрес(БазовыйАдрес(ИмяПула), Ключ);
КонецФункции

// Разделы дома для дерева навигации.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  Активный - Строка - ключ активного раздела.
//
// Возвращаемое значение:
//  Массив - разделы дома для дерева навигации.
//
Функция Разделы(Знач ИмяПула, Знач Активный) Экспорт
	Возврат Каталог.Разделы(БазовыйАдрес(ИмяПула), Описания, Активный);
КонецФункции

// Есть ли раздел с таким ключом.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Булево - есть ли раздел с таким ключом.
//
Функция ЕстьРаздел(Знач Ключ) Экспорт
	Возврат Каталог.Содержит(Описания, Ключ);
КонецФункции

// Подпись раздела.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - подпись раздела.
//
Функция ПодписьРаздела(Знач Ключ) Экспорт
	Возврат Каталог.Подпись(Описания, Ключ);
КонецФункции

// Заголовок дома.
//
// Возвращаемое значение:
//  Строка - заголовок дома.
//
Функция Заголовок() Экспорт
	Возврат Тексты.Текст("settings.pool.title");
КонецФункции

// Пояснение дома.
//
// Возвращаемое значение:
//  Строка - пояснение дома.
//
Функция Пояснение() Экспорт
	Возврат Тексты.Текст("settings.pool.lead");
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаталогРазделов") _Каталог,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Каталог = _Каталог;
	Тексты = _Тексты;

	Описания = Новый Массив();
	Описания.Добавить(Каталог.Описание("general", Тексты.Текст("settings.pool.nav.general"), "шестерёнка"));
	Описания.Добавить(Каталог.Описание("visibility", Тексты.Текст("settings.pool.nav.visibility"), "замок"));
	Описания.Добавить(Каталог.Описание("access", Тексты.Текст("settings.pool.nav.access"), "аккаунт"));
	Описания.Добавить(Каталог.Описание("reserved", Тексты.Текст("settings.pool.nav.reserved"), "пакет"));
	Описания.Добавить(Каталог.Описание("inbox", Тексты.Текст("settings.pool.nav.inbox"), "плюс"));
	Описания.Добавить(Каталог.Описание("tags", Тексты.Текст("settings.pool.nav.tags"), "тег"));
	Описания.Добавить(Каталог.Описание("upstreams", Тексты.Текст("settings.pool.nav.upstreams"), "ссылка"));
	Описания.Добавить(Каталог.Описание("mirrors", Тексты.Текст("settings.pool.nav.mirrors"), "копировать"));
	Описания.Добавить(Каталог.Описание("webhooks", Тексты.Текст("settings.pool.nav.webhooks"), "стрелка"));
	Описания.Добавить(Каталог.Описание("quota", Тексты.Текст("settings.pool.nav.quota"), "скачать"));
	Описания.Добавить(Каталог.Описание("danger", Тексты.Текст("settings.pool.nav.danger"), "предупреждение"));

КонецПроцедуры
