// Операция раздела «Опасная зона» дома «Пул»: удаляет ту же дверь домена, что и DELETE
// /api/v1/pools/{pool}. Здесь — контракт формы, эхо-подтверждение и слова отказа.

Перем РазборФормы;  // РазборФормы (web-ui)
Перем Служба;       // СлужбаДоступа (кабинет) — единственная дверь удаления пула
Перем СервисПрав;   // СервисПрав (auth) — право удаления на уровне хаба
Перем Ошибки;       // ТекстОшибки (основа) — описание исключения одной строкой
Перем Тексты;       // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Имя скрытого поля операции опасной зоны.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Значение операции «удалить пул».
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеОперации() Экспорт
	Возврат "пул-удалить";
КонецФункции

// Имя поля, в которое человек вводит эхо — имя удаляемого пула.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляЭха() Экспорт
	Возврат "подтверждение";
КонецФункции

// Вправе ли смотрящий удалять пулы этого хаба. Право уровня ХАБА: роль администратора
// пула его не даёт, поэтому форма удаления показывается не всякому, кто открыл раздел.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - смотрящий.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетУдалять(Знач Пользователь) Экспорт
	Возврат СервисПрав.МожетУдалятьПул(Пользователь);
КонецФункции

// Применяет операцию раздела «Опасная зона» дома «Пул».
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - инициатор (право судит служба доступа).
//  Пул - Пул - пул раздела.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - Ошибка (Строка: "" — пул удалён, иначе текст отказа для экрана).
//
Функция Применить(Знач Пользователь, Знач Пул, Знач Форма) Экспорт

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, ИмяПоляОперации())));
	Если Операция <> ЗначениеОперации() Тогда
		// белый список операций: форма без операции не значит «удалить пул»
		Лог.Отладка("Опасная зона пула ""%1"": операция ""%2"" не объявлена, пул не тронут",
			Пул.Имя, Операция);
		Возврат Отказ(Тексты.Текст("settings.pool.danger.error.operation"));
	КонецЕсли;

	Возврат Удалить(Пользователь, Пул, Форма);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Эхо повторяет имя пула с точностью до регистра — так его и печатает экран.
Функция Удалить(Знач Пользователь, Знач Пул, Знач Форма)

	Имя = Строка(Пул.Имя);
	Если СокрЛП(РазборФормы.Поле(Форма, ИмяПоляЭха())) <> Имя Тогда
		Лог.Отладка("Опасная зона пула ""%1"": подтверждение не совпало, пул не тронут", Имя);
		Возврат Отказ(Тексты.Шаблон("settings.pool.danger.error.echo", Имя));
	КонецЕсли;

	Попытка
		Служба.УдалитьПул(Пользователь, Пул.Идентификатор);
	Исключение
		// сюда приходит и доменный запрет — основной пул хаба, идущий прогон зеркала:
		// его причину и совет человек читает словами домена. Числа удаления пишет в лог
		// сама служба, второй дорожки об одном событии не заводим
		Возврат Отказ(Тексты.Шаблон("settings.pool.danger.error.delete",
			Ошибки.Кратко(ОписаниеОшибки())));
	КонецПопытки;

	Возврат Успех();

КонецФункции

Функция Успех()
	Возврат Новый Структура("Ошибка", "");
КонецФункции

Функция Отказ(Знач Сообщение)
	Возврат Новый Структура("Ошибка", Сообщение);
КонецФункции

#КонецОбласти

&Прозвище("ПультУдаленияПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СлужбаДоступа") _Служба,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Лог _Лог = Неопределено) Экспорт

	РазборФормы = _РазборФормы;
	Служба = _Служба;
	СервисПрав = _СервисПрав;
	Ошибки = _Ошибки;
	Тексты = _Тексты;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
