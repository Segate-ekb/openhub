// Пульт заявок — желудь модуля web-ui: одобрение и отклонение «входящих» с экрана.
// Порог права и порядок проверок держит РассмотрениеВходящих, здесь только разбор формы
// и серверный шаг подтверждения.

Перем РазборФормы;   // РазборФормы (web-ui)
Перем Рассмотрение;  // РассмотрениеВходящих (публикация) — видимость, одобрение, отклонение
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Применяет решение по заявке.
//
// Параметры:
//  Принципал - Структура, Неопределено - принципал запроса (порог права судит домен).
//  Форма - Соответствие - разобранная форма.
//  Пул - Пул, Неопределено - пул раздела: заявка чужого пула этой формой не решается
//        (необязательный, по умолчанию Неопределено — сводка по всем пулам).
//
// Возвращаемое значение:
//  Структура - Ошибка (Строка: "" — решение принято, иначе текст отказа для экрана),
//              Подтвердить (Структура, Неопределено - Строка_ и Операция заявки, решение
//              по которой ждёт подтверждения).
//
Функция Применить(Знач Принципал, Знач Форма, Знач Пул = Неопределено) Экспорт

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, "операция")));
	Если Операция <> "одобрить" И Операция <> "отклонить" Тогда
		// белый список операций: неизвестная не должна попадать в чужую ветку
		Возврат Отказ(Тексты.Текст("settings.inbox.error.operation"));
	КонецЕсли;

	Номер = РазборФормы.ЦелоеПоле(Форма, "заявка");
	Если Номер = Неопределено ИЛИ Номер <= 0 Тогда
		Возврат Отказ(Тексты.Текст("settings.inbox.error.id"));
	КонецЕсли;

	// подтверждение сверяется ДО обращения к домену, но само обращение всё равно идёт
	// через РассмотрениеВходящих: экран не должен показывать карточку чужой заявки
	Контекст = Рассмотрение.ЗаявкаКРассмотрению(Принципал, Номер);
	Если НЕ Контекст.Успех Тогда
		Возврат Отказ(Тексты.Шаблон("settings.inbox.error.decide", Контекст.Сообщение));
	КонецЕсли;

	// раздел дома «Пул» решает только СВОИ заявки: подставленный номер соседнего пула
	// не должен обрабатываться формой этой страницы, даже когда права на него есть
	Если Пул <> Неопределено И Цел(Контекст.Пул.Идентификатор) <> Цел(Пул.Идентификатор) Тогда
		Возврат Отказ(Тексты.Текст("settings.inbox.error.foreign"));
	КонецЕсли;

	Если СокрЛП(РазборФормы.Поле(Форма, "подтверждение")) <> Формат(Номер, "ЧГ=0; ЧН=0") Тогда
		Результат = Успех();
		Результат.Подтвердить = Новый Структура("Строка_, Операция",
			Новый Структура("Пул, Заявка, Заявитель",
				Контекст.Пул, Контекст.Заявка, Контекст.Заявитель),
			Операция);
		Возврат Результат;
	КонецЕсли;

	Если Операция = "одобрить" Тогда
		Итог = Рассмотрение.Одобрить(Принципал, Номер);
		Возврат ?(Итог.Успех, Успех(),
			Отказ(Тексты.Шаблон("settings.inbox.error.approve", Итог.Сообщение)));
	КонецЕсли;

	Итог = Рассмотрение.Отклонить(Принципал, Номер, СокрЛП(РазборФормы.Поле(Форма, "причина")));
	Возврат ?(Итог.Успех, Успех(),
		Отказ(Тексты.Шаблон("settings.inbox.error.reject", Итог.Сообщение)));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Успех()
	Возврат Новый Структура("Ошибка, Подтвердить", "", Неопределено);
КонецФункции

Функция Отказ(Знач Сообщение)
	Возврат Новый Структура("Ошибка, Подтвердить", Сообщение, Неопределено);
КонецФункции

#КонецОбласти

&Прозвище("ПультЗаявок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "РассмотрениеВходящих") _Рассмотрение,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	Рассмотрение = _Рассмотрение;
	Тексты = _Тексты;

КонецПроцедуры
