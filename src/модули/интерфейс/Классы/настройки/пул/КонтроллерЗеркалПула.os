// Контроллер раздела «Зеркала» дома настроек «Пул» — модуль web-ui.

Перем ГвардПула;      // ГвардПула (кабинет)
Перем Защита;         // ЗащитаCSRF (auth) — токен сессии в форму
Перем Гейт;           // ГейтФормы (web-ui) — токен формы
Перем РазборФормы;    // РазборФормы (web-ui)
Перем СервисЗеркал;   // СервисЗеркал (зеркала)
Перем Ответы;         // ОтветыНастроек (web-ui)
Перем Сбои;         // ТекстСбоя (web-ui) — причина сбоя человеку и отчёт в журнал
Перем Дом;            // ДомПула (web-ui)
Перем Витрина;        // ВитринаЗеркал (web-ui)
Перем ПультСостояния; // ПультСостоянияЗеркала (web-ui) — экран состояния синхронизации
Перем ПультЗеркал;    // ПультЗеркал (web-ui) — заведение, переключение и заявка на синк
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Числа;          // ПриведениеЧисел (основа) — терпимое чтение числа
Перем Отметка;  // ОтметкаСохранения (web-ui) — «сохранено» параметром на адресе

#Область ТочкиМаршрута

// Точка маршрута «{pool}/settings/mirrors» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного действия из адреса (необязательный, по умолчанию "").
//
&ТочкаМаршрута("{pool}/settings/mirrors")
Процедура Раздел(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, saved = "") Экспорт

	Вердикт = ГвардПула.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Вердикт, ЗначениеЗаполнено(saved), "", КукиЗапроса);
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = ПроверенаяФорма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Создать(Ответ, Вердикт, Форма, КукиЗапроса);

КонецПроцедуры

// Точка маршрута «{pool}/settings/mirrors/{id}» (GET).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор зеркала из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  sync - Строка - итог нажатия «синхронизировать сейчас» из адреса: "1" заявка принята,
//         "running" прогон уже идёт, "queued" зеркало уже ждёт очереди
//         (необязательный, по умолчанию "").
//
&ТочкаМаршрута("{pool}/settings/mirrors/{id}")
Процедура Состояние(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, sync = "") Экспорт

	ПультСостояния.Показать(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, sync);

КонецПроцедуры

// Точка маршрута «{pool}/settings/mirrors/{id}/toggle» (POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор зеркала из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{pool}/settings/mirrors/{id}/toggle")
Процедура Переключение(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьОперацию(Ответ, pool, id, "переключить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «{pool}/settings/mirrors/{id}/sync» (POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор зеркала из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{pool}/settings/mirrors/{id}/sync")
Процедура Синхронизация(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьОперацию(Ответ, pool, id, "синхронизировать", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «{pool}/settings/mirrors/{id}/token-off» (POST): снять токен доступа
// с апстрима зеркала — оно возвращается к анонимному чтению.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор зеркала из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{pool}/settings/mirrors/{id}/token-off")
Процедура СнятиеТокена(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьОперацию(Ответ, pool, id, "снять-токен", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «{pool}/settings/mirrors/{id}/delete» (POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  pool - Строка - имя пула из адреса.
//  id - Строка - идентификатор зеркала из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("{pool}/settings/mirrors/{id}/delete")
Процедура Удаление(Ответ, pool, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьОперацию(Ответ, pool, id, "удалить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура Создать(Ответ, Знач Вердикт, Знач Форма, Знач КукиЗапроса)

	Попытка
		Итог = ПультЗеркал.Завести(Вердикт.Пользователь, Вердикт.Пул, Форма);
	Исключение
		// причину берём ЗДЕСЬ, внутри обработчика: снаружи ОписаниеОшибки() уже не о ней
		ОтдатьРаздел(Ответ, Вердикт, Ложь,
			Тексты.Шаблон("settings.pool.error.save", Сбои.Человеку(ИнформацияОбОшибке())),
			КукиЗапроса, 400);
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		ОтдатьРаздел(Ответ, Вердикт, Ложь, Итог.Ошибка, КукиЗапроса, 400);
		Возврат;
	КонецЕсли;

	ОтдатьРедирект(Ответ, Вердикт);

КонецПроцедуры

Процедура ВыполнитьОперацию(Ответ, Знач pool, Знач id, Знач Операция,
	Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)

	Вердикт = ГвардПула.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, pool);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "POST", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = ПроверенаяФорма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Исход = Применить(Вердикт, Операция, Числа.ЧислоИлиНоль(id), Форма);
	Исключение
		ОтдатьРаздел(Ответ, Вердикт, Ложь,
			Тексты.Шаблон("settings.pool.error.save", Сбои.Человеку(ИнформацияОбОшибке())),
			КукиЗапроса, 400);
		Возврат;
	КонецПопытки;

	Если ЗначениеЗаполнено(Исход.Ошибка) Тогда
		ОтдатьРаздел(Ответ, Вердикт, Ложь, Исход.Ошибка, КукиЗапроса, 503);
	ИначеЕсли ЗначениеЗаполнено(Исход.Адрес) Тогда
		Ответ.Перенаправить(Исход.Адрес);
	Иначе
		ОтдатьРедирект(Ответ, Вердикт);
	КонецЕсли;

КонецПроцедуры

// Доменные действия зеркала — в СервисеЗеркал; здесь только выбор операции по адресу.
Функция Применить(Знач Вердикт, Знач Операция, Знач Идентификатор, Знач Форма)

	Исход = Новый Структура("Адрес, Ошибка", "", "");

	Если Операция = "переключить" Тогда
		ПультЗеркал.Переключить(Вердикт.Пользователь, Вердикт.Пул, Идентификатор, Форма);
	ИначеЕсли Операция = "удалить" Тогда
		СервисЗеркал.Удалить(Вердикт.Пользователь, Вердикт.Пул, Идентификатор);
	ИначеЕсли Операция = "снять-токен" Тогда
		СервисЗеркал.СнятьТокен(Вердикт.Пользователь, Вердикт.Пул, Идентификатор);
	ИначеЕсли Операция = "синхронизировать" Тогда
		Поставить(Вердикт, Идентификатор, Исход);
	КонецЕсли;

	Возврат Исход;

КонецФункции

// «Синхронизировать сейчас» — только заявка: работу ведёт фоновый рабочий.
Процедура Поставить(Знач Вердикт, Знач Идентификатор, Исход)

	Зеркало = СервисЗеркал.ЗеркалоПула(Вердикт.Пул, Идентификатор);
	Если Зеркало = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Код = ПультЗеркал.КодПостановки(Зеркало, Вердикт.Пользователь);

	// Выключенная синхронизация — не успех: уводить на экран состояния нечего, человеку
	// говорим прямо, что заявку никто не разберёт.
	Если Код = ПультЗеркал.КодВыключено() Тогда
		Исход.Ошибка = Тексты.Текст("settings.pool.mirrors.error.disabled");
		Возврат;
	КонецЕсли;

	// Отказ и приём выглядели одинаково — тихий 302; теперь экран говорит, что вышло.
	Исход.Адрес = Адрес(Вердикт) + "/" + Формат(Цел(Зеркало.Идентификатор), "ЧГ=0")
		+ "?sync=" + Код;

КонецПроцедуры

#КонецОбласти

#Область ОбщаяЛогика

// Разбирает тело и проверяет CSRF; Неопределено — отказ уже записан в ответ.
Функция ПроверенаяФорма(Ответ, Знач Вердикт, Знач ТелоЗапроса, Знач КукиЗапроса)
	Возврат Гейт.СПринятымТокеном(Ответ, Вердикт, РазборФормы.Разобрать(ТелоЗапроса),
		КукиЗапроса);
КонецФункции

Функция Адрес(Знач Вердикт)
	Возврат Дом.АдресРаздела(Вердикт.Пул.Имя, "mirrors");
КонецФункции

Процедура ОтдатьРедирект(Ответ, Знач Вердикт)
	Ответ.Перенаправить(Отметка.НаАдресе(Адрес(Вердикт)));
КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач Сохранено, Знач Ошибка, Знач КукиЗапроса,
	Знач Статус = 200)

	Пул = Вердикт.Пул;

	Параметры = Новый Структура();
	Параметры.Вставить("Пул", Пул);
	Параметры.Вставить("Адрес", Адрес(Вердикт));
	Параметры.Вставить("Токен", Защита.ТокенСессии(Вердикт.Сессия));

	Хлебные = Новый Массив();
	Хлебные.Добавить(Новый Структура("Подпись, Адрес", Пул.Имя, Дом.АдресПула(Пул.Имя)));
	Хлебные.Добавить(Новый Структура("Подпись", Тексты.Текст("settings.pool.crumb")));

	Модель = Ответы.МодельДома(Дом, Пул.Имя,
		Дом.Разделы(Пул.Имя, "mirrors"),
		Ответы.УведомленияРаздела(Сохранено, Ошибка),
		Витрина.Секции(Параметры),
		Хлебные);

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт.Пользователь, КукиЗапроса, Дом.Заголовок(), Статус);

КонецПроцедуры

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардПула") _ГвардПула,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ДомПула") _Дом,
	&Пластилин(Значение = "ВитринаЗеркал") _Витрина,
	&Пластилин(Значение = "ПультСостоянияЗеркала") _ПультСостояния,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "ОтметкаСохранения") _Отметка,
	&Пластилин(Значение = "ПультЗеркал") _ПультЗеркал)

	ГвардПула = _ГвардПула;
	Защита = _Защита;
	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	СервисЗеркал = _СервисЗеркал;
	Ответы = _Ответы;
	Сбои = _Сбои;
	Дом = _Дом;
	Витрина = _Витрина;
	ПультСостояния = _ПультСостояния;
	Тексты = _Тексты;
	Числа = _Числа;
	Отметка = _Отметка;
	ПультЗеркал = _ПультЗеркал;

КонецПроцедуры
