// Раздел «Права доступа» дома «Пул». Разметку действующих ролей печатает общая
// ВитринаВыдачиРоли; здесь — объект раздела и его подписи.

Перем ВитринаВыдачи;  // ВитринаВыдачиРоли (web-ui) — секция действующих ролей
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Бланки;         // БланкРаздела (web-ui) — адрес и токен раздела

#Область ПубличныйИнтерфейс

// Секции раздела «права доступа» пула.
//
// Параметры:
//  Параметры - Структура:
//    * Пул - Пул - пул, права на который показываются;
//    * Адрес - Строка - адрес раздела (он же action форм);
//    * Токен - Строка - CSRF-токен сессии;
//    * МожетВыдавать - Булево - вправе ли смотрящий выдавать и отзывать права на этом пуле;
//    * Заведение - Структура, Неопределено - состояние окна выдачи (Открыта, Заполнение, Отказы).
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Заведение = Неопределено;
	Параметры.Свойство("Заведение", Заведение);

	Результат = Новый Массив();
	Результат.Добавить(ВитринаВыдачи.Секция(Раздел(Параметры.Пул), Бланки.Раздела(Параметры),
		(Параметры.МожетВыдавать = Истина), Заведение));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Это всё, чем раздел прав пула отличается от раздела прав пакета.
Функция Раздел(Знач Пул)

	Возврат Новый Структура("Вид, Идентификатор, Заголовок, Лид, Пусто, КолонкаДействия,"
			+ " Примечание, ТолькоЧтение, ЗаголовокОкна, ЛидОкна",
		"пул", Пул.Идентификатор,
		Тексты.Текст("settings.pool.access.title"),
		Тексты.Текст("settings.pool.access.lead"),
		Тексты.Текст("settings.pool.access.empty"),
		Тексты.Текст("settings.pool.access.col.action"),
		Тексты.Текст("settings.pool.access.note"),
		Тексты.Текст("settings.pool.access.readonly"),
		Тексты.Текст("settings.pool.access-new.title"),
		Тексты.Текст("settings.pool.access-new.lead"));

КонецФункции

#КонецОбласти

&Прозвище("ВитринаПравПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВитринаВыдачиРоли") _ВитринаВыдачи,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "БланкРаздела") _Бланки) Экспорт

	ВитринаВыдачи = _ВитринаВыдачи;
	Тексты = _Тексты;
	Бланки = _Бланки;

КонецПроцедуры
