// Экран «{pool}/settings/mirrors/{id}» дома «Пул»: как идёт прогон зеркала, что он успел
// и на что настроено само зеркало. Экран собирается элементами кита.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Бланки;            // БланкРаздела (web-ui) — адрес и токен раздела, формы на них
Перем Примечания;  // ПримечанияЭкрана (web-ui) — вид «показывать нечего»

#Область ПубличныйИнтерфейс

// Секции экрана состояния зеркала.
//
// Параметры:
//  Параметры - Структура:
//    * Зеркало - ЗеркалоХаба - зеркало, чьё состояние показывается;
//    * Прогон - Структура - модель прогона (ПредставлениеПрогонаЗеркала.Модель);
//    * АдресЭкрана - Строка - адрес самого экрана (кнопка «Обновить»);
//    * АдресСписка - Строка - адрес раздела зеркал;
//    * Токен - Строка - CSRF-токен сессии;
//    * Обновление - Число - интервал авто-обновления, секунд.
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Результат = Новый Массив();
	Результат.Добавить(СекцияПрогона(Параметры));
	Результат.Добавить(СекцияСчётчиков(Параметры.Прогон));
	Результат.Добавить(СекцияЗеркала(Параметры.Зеркало, Параметры.Прогон, Параметры.АдресСписка));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Прогон

Функция СекцияПрогона(Знач Параметры)

	Прогон = Параметры.Прогон;

	Ход = Кит.Холст();
	Ход.Добавить(ШкалаОбхода(Прогон));
	Ход.Добавить(ТаблицаПрогона(Прогон));
	Ход.Добавить(ОбещаниеСамообновления(Параметры));
	Ход.Добавить(ФормаСинхронизации(Параметры));
	Ход.Добавить(КнопкаОбновления(Параметры.АдресЭкрана));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.pool.mirror-status.run.title"),
		Тексты.Текст("settings.pool.mirror-status.run.lead"), Ход.Рендер());
	Секция.Иконка = "часы";
	Возврат Секция;

КонецФункции

// Печатается только у сосчитанного апстрима: без общего числа имён пустая шкала врала бы.
Функция ШкалаОбхода(Знач Прогон)

	Если Прогон.ИмёнВсего <= 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.ПолосаЗаполнения(Новый Структура("Процент, Метка, Подпись, Вид",
		Прогон.Процент,
		Тексты.Текст("settings.pool.mirror-status.progress.label"),
		Тексты.Шаблон("settings.pool.mirror-status.progress.caption",
			Тексты.ЧислоТекстом(Прогон.ИмёнПройдено), Тексты.ЧислоТекстом(Прогон.ИмёнВсего)),
		?(Прогон.Код = "ошибка", "err", "ok")));

КонецФункции

Функция ТаблицаПрогона(Знач Прогон)

	Таблица = ТаблицаПоказателей();
	Таблица.Добавить(СостояниеПрогона(Прогон));
	Таблица.Добавить(СпособОбхода(Прогон));
	Таблица.Добавить(МоментНачала(Прогон));
	Таблица.Добавить(МоментОбновления(Прогон));
	Таблица.Добавить(КурсорОбхода(Прогон));
	Таблица.Добавить(ИнициаторПрогона(Прогон));
	Возврат Таблица;

КонецФункции

// Чем этот проход отличается по цене от прошлого: инкремент против полного перечисления.
Функция СпособОбхода(Знач Прогон)

	Возврат ПоказательТекстом(Тексты.Текст("settings.pool.mirror-status.field.crawl"),
		?(ЗначениеЗаполнено(Прогон.СрезС),
			Тексты.Шаблон("settings.pool.mirror-status.crawl.increment", Прогон.СрезС),
			Тексты.Текст("settings.pool.mirror-status.crawl.full")));

КонецФункции

Функция СостояниеПрогона(Знач Прогон)

	Значение = Кит.Ячейка();
	Значение.Добавить(Кит.Плашка(Новый Структура("Текст, Вид", Прогон.Подпись, Прогон.Вид)));
	Возврат Показатель(Тексты.Текст("settings.pool.mirror-status.field.state"), Значение);

КонецФункции

Функция МоментНачала(Знач Прогон)
	Возврат ПоказательТекстом(Тексты.Текст("settings.pool.mirror-status.field.started"),
		Прогон.Начат);
КонецФункции

Функция МоментОбновления(Знач Прогон)
	Возврат ПоказательТекстом(Тексты.Текст("settings.pool.mirror-status.field.updated"),
		Прогон.Обновлён);
КонецФункции

Функция КурсорОбхода(Знач Прогон)
	Возврат ПоказательТекстом(Тексты.Текст("settings.pool.mirror-status.field.cursor"),
		Прогон.Курсор);
КонецФункции

Функция ИнициаторПрогона(Знач Прогон)

	Возврат ПоказательТекстом(Тексты.Текст("settings.pool.mirror-status.field.by"),
		?(ЗначениеЗаполнено(Прогон.Запустил), Прогон.Запустил,
			Тексты.Текст("settings.pool.mirror-status.field.by-schedule")));

КонецФункции

// Только у незакрытого прогона: у остановленного зеркала обещание было бы неправдой.
Функция ОбещаниеСамообновления(Знач Параметры)

	Если НЕ Параметры.Прогон.Активен Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Примечание(Тексты.Шаблон("settings.pool.mirror-status.refresh.note",
		Тексты.ЧислоТекстом(Параметры.Обновление)));

КонецФункции

// Тот же маршрут, что и у кнопки строки списка: экран состояния — место жать «синхронизировать».
Функция ФормаСинхронизации(Знач Параметры)

	Возврат Бланки.КнопкаДействия(
		Бланки.НаАдресе(Параметры.АдресЭкрана, Параметры.Токен), "sync",
		Тексты.Текст("settings.pool.mirrors.button.sync"), "основная");

КонецФункции

Функция КнопкаОбновления(Знач АдресЭкрана)

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Иконка",
		Тексты.Текст("settings.pool.mirror-status.refresh.button"), АдресЭкрана,
		"вторичная", "история"));

КонецФункции

#КонецОбласти

#Область Счётчики

Функция СекцияСчётчиков(Знач Прогон)

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.pool.mirror-status.counters.title"),
		Тексты.Текст("settings.pool.mirror-status.counters.lead"),
		ТаблицаСчётчиков(Прогон).Рендер());
	Секция.Иконка = "скачать";
	Возврат Секция;

КонецФункции

Функция ТаблицаСчётчиков(Знач Прогон)

	Таблица = ТаблицаПоказателей();
	// имена и версии — разные величины: 25 имён апстрима дали 194 версии, и подпись
	// «всего пакетов» на числе версий была неправдой дважды
	Таблица.Добавить(Счётчик(Тексты.Текст("settings.pool.mirror-status.count.names"),
		Прогон.ИмёнВсего));
	Таблица.Добавить(Счётчик(Тексты.Текст("settings.pool.mirror-status.count.names-done"),
		Прогон.ИмёнПройдено));
	Таблица.Добавить(Счётчик(Тексты.Текст("settings.pool.mirror-status.count.total"),
		Прогон.Всего));
	Таблица.Добавить(Счётчик(Тексты.Текст("settings.pool.mirror-status.count.downloaded"),
		Прогон.Скачано));
	Таблица.Добавить(Счётчик(Тексты.Текст("settings.pool.mirror-status.count.skipped"),
		Прогон.Пропущено));
	Таблица.Добавить(Счётчик(Тексты.Текст("settings.pool.mirror-status.count.errors"),
		Прогон.Ошибок));
	Таблица.Добавить(Счётчик(Тексты.Текст("settings.pool.mirror-status.count.unavailable"),
		Прогон.Недоступно));
	Возврат Таблица;

КонецФункции

Функция Счётчик(Знач Подпись, Знач Значение)
	Возврат ПоказательТекстом(Подпись, Тексты.ЧислоТекстом(Значение));
КонецФункции

#КонецОбласти

#Область СамоЗеркало

Функция СекцияЗеркала(Знач Зеркало, Знач Прогон, Знач АдресСписка)

	Настройка = Кит.Холст();
	Настройка.Добавить(ТаблицаЗеркала(Зеркало, Прогон));
	Настройка.Добавить(КнопкаВозврата(АдресСписка));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.pool.mirror-status.mirror.title"),
		Тексты.Текст("settings.pool.mirror-status.mirror.lead"), Настройка.Рендер());
	Секция.Иконка = "ссылка";
	Возврат Секция;

КонецФункции

Функция ТаблицаЗеркала(Знач Зеркало, Знач Прогон)

	Таблица = ТаблицаПоказателей();
	Таблица.Добавить(АдресАпстрима(Зеркало));
	Таблица.Добавить(РежимСинхронизации(Зеркало));
	Таблица.Добавить(ИнтервалСинхронизации(Зеркало));
	Таблица.Добавить(Включённость(Зеркало));
	Таблица.Добавить(МоментПоследнегоСинка(Прогон));
	Таблица.Добавить(ИтогПоследнегоПрогона(Прогон));
	Возврат Таблица;

КонецФункции

Функция АдресАпстрима(Знач Зеркало)

	Значение = Кит.Ячейка();
	Значение.Добавить(Кит.Код(Строка(Зеркало.АпстримURL)));
	Возврат Показатель(Тексты.Текст("settings.pool.mirror-status.field.upstream"), Значение);

КонецФункции

Функция РежимСинхронизации(Знач Зеркало)
	Возврат ПоказательТекстом(Тексты.Текст("settings.pool.mirror-status.field.mode"),
		Строка(Зеркало.Режим));
КонецФункции

Функция ИнтервалСинхронизации(Знач Зеркало)
	Возврат ПоказательТекстом(Тексты.Текст("settings.pool.mirror-status.field.interval"),
		Тексты.ЧислоТекстом(Зеркало.ИнтервалСинкаСек));
КонецФункции

Функция Включённость(Знач Зеркало)

	Включено = (Зеркало.Включено = Истина);

	Значение = Кит.Ячейка();
	Значение.Добавить(Кит.Плашка(Новый Структура("Текст, Вид",
		?(Включено, Тексты.Текст("settings.pool.mirrors.state.on"),
			Тексты.Текст("settings.pool.mirrors.state.off")),
		?(Включено, "ok", "warn"))));
	Возврат Показатель(Тексты.Текст("settings.pool.mirror-status.field.enabled"), Значение);

КонецФункции

Функция МоментПоследнегоСинка(Знач Прогон)
	Возврат ПоказательТекстом(Тексты.Текст("settings.pool.mirror-status.field.last-sync"),
		Прогон.ПоследнийСинк);
КонецФункции

Функция ИтогПоследнегоПрогона(Знач Прогон)
	Возврат ПоказательТекстом(Тексты.Текст("settings.pool.mirror-status.field.result"),
		Прогон.Итог);
КонецФункции

Функция КнопкаВозврата(Знач АдресСписка)

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Иконка",
		Тексты.Текст("settings.pool.mirror-status.back"), АдресСписка, "ссылка", "влево"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТаблицаПоказателей()

	Результат = Кит.Таблица();
	Результат.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.mirror-status.col.metric")));
	Результат.Добавить(Кит.Колонка(Тексты.Текст("settings.pool.mirror-status.col.value")));
	Результат.Пусто().Добавить(Примечания.Пусто(Прочерк()));
	Возврат Результат;

КонецФункции

Функция Показатель(Знач Подпись, Знач Значение)

	Результат = Кит.Запись();
	Результат.Добавить(Значением(Подпись));
	Результат.Добавить(Значение);
	Возврат Результат;

КонецФункции

// Незаполненное значение печатается прочерком: пустая ячейка читается как «показателя нет».
Функция ПоказательТекстом(Знач Подпись, Знач Значение)

	Возврат Показатель(Подпись,
		Значением(?(ЗначениеЗаполнено(Значение), Строка(Значение), Прочерк())));

КонецФункции

Функция Значением(Знач Текст)

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Текст(Текст));
	Возврат Результат;

КонецФункции

Функция Прочерк()
	Возврат Тексты.Текст("settings.pool.mirror-status.empty");
КонецФункции

#КонецОбласти

&Прозвище("ВитринаСостоянияЗеркала")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "БланкРаздела") _Бланки,
	&Пластилин(Значение = "ПримечанияЭкрана") _Примечания) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Тексты = _Тексты;
	Бланки = _Бланки;
	Примечания = _Примечания;

КонецПроцедуры
