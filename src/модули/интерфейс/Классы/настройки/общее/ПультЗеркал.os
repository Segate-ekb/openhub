// Операции над зеркалами пула, общие двум экранам — разделу «Зеркала» дома «Пул»
// и обзору зеркал кабинета. Разметку, адреса редиректа и слова баннеров знает каждый
// экран свой; что считать заведением, переключением и принятой заявкой на синхронизацию —
// знает пульт, и одинаково для обоих.

Перем РазборФормы;   // РазборФормы (web-ui)
Перем СервисЗеркал;  // СервисЗеркал (зеркала)
Перем Очередь;       // ОчередьСинхронизацииЗеркал (зеркала)
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Итоги;         // ИтогПульта (web-ui) — единая форма итога операции

#Область ПубличныйИнтерфейс

// Заводит зеркало по форме экрана. Ввод проверяется ДО обращения к домену: адрес обязателен,
// интервал — целое число секунд.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект запроса (порог права судит домен).
//  Пул - Пул - пул, которому заводится зеркало.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - итог пульта (см. ИтогПульта).
//
Функция Завести(Знач Пользователь, Знач Пул, Знач Форма) Экспорт

	Проблема = ПроблемаВвода(Форма);
	Если ЗначениеЗаполнено(Проблема) Тогда
		Возврат Итоги.Отказ(Проблема);
	КонецЕсли;

	СервисЗеркал.Создать(Пользователь, Пул,
		СокрЛП(РазборФормы.Поле(Форма, "url")),
		РазборФормы.Поле(Форма, "режим"),
		СокрЛП(РазборФормы.Поле(Форма, "фильтр")),
		РазборФормы.ЦелоеПоле(Форма, "интервал", 0),
		РазборФормы.Поле(Форма, "токен"));

	Возврат Итоги.Успех();

КонецФункции

// Включает и выключает зеркало по флажку формы.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - субъект запроса.
//  Пул - Пул - пул зеркала.
//  Идентификатор - Число - номер зеркала.
//  Форма - Соответствие - разобранная форма.
//
Процедура Переключить(Знач Пользователь, Знач Пул, Знач Идентификатор, Знач Форма) Экспорт
	СервисЗеркал.Переключить(Пользователь, Пул, Идентификатор,
		РазборФормы.Флажок(Форма, "включить"));
КонецПроцедуры

// Ставит зеркало в очередь синхронизации и называет исход одним словом. Слово латиницей:
// оно уезжает в query-строку редиректа, и оба экрана читают его одинаково.
//
// Параметры:
//  Зеркало - Зеркало - запись зеркала.
//  Пользователь - Пользователь, Неопределено - заявитель.
//
// Возвращаемое значение:
//  Строка - "1" заявка принята, "running" прогон уже идёт, "queued" зеркало уже ждёт
//           очереди, "disabled" синхронизация выключена, "rejected" — иное.
//
Функция КодПостановки(Знач Зеркало, Знач Пользователь) Экспорт

	Принято = Очередь.Поставить(Зеркало.Идентификатор, ЛогинЗаявителя(Пользователь));
	Если Принято Тогда
		Возврат "1";
	КонецЕсли;

	Состояние = Очередь.Состояние(Зеркало.Идентификатор);
	Если Состояние = "идёт" Тогда
		Возврат "running";
	ИначеЕсли Состояние = "поставлено" Тогда
		Возврат "queued";
	КонецЕсли;

	Возврат ?(Состояние = "выключено", КодВыключено(), "rejected");

КонецФункции

// Исход «синхронизация выключена»: заявку никто не разберёт, и экран говорит это прямо.
//
// Возвращаемое значение:
//  Строка.
//
Функция КодВыключено() Экспорт
	Возврат "disabled";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет ввод формы заведения до мутации; пустая строка — ввод принят.
Функция ПроблемаВвода(Знач Форма)

	Если НЕ ЗначениеЗаполнено(СокрЛП(РазборФормы.Поле(Форма, "url"))) Тогда
		Возврат Тексты.Текст("settings.pool.mirrors.error.url");
	КонецЕсли;
	Если РазборФормы.ЦелоеПоле(Форма, "интервал", 0) = Неопределено Тогда
		Возврат Тексты.Текст("settings.pool.mirrors.error.interval");
	КонецЕсли;

	Возврат "";

КонецФункции

// Инициатор заявки называется логином: субъект в хабе — логин, а не число.
Функция ЛогинЗаявителя(Знач Пользователь)
	Возврат ?(Пользователь = Неопределено, "", СокрЛП(Строка(Пользователь.Логин)));
КонецФункции

#КонецОбласти

&Прозвище("ПультЗеркал")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисЗеркал") _СервисЗеркал,
	&Пластилин(Значение = "ОчередьСинхронизацииЗеркал") _Очередь,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ИтогПульта") _Итоги) Экспорт

	РазборФормы = _РазборФормы;
	СервисЗеркал = _СервисЗеркал;
	Очередь = _Очередь;
	Тексты = _Тексты;
	Итоги = _Итоги;

КонецПроцедуры
