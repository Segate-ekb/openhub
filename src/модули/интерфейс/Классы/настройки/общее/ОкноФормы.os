// Каркас окна заведения — желудь модуля web-ui: состояние окна, пришедшее разделу,
// его оформление и возврат отбитой формы в её же поля. Что внутри окна — знает форма.

Перем Кит;     // Кит (кит) — узел окна
Перем Тексты;  // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

// Состояние окна, пришедшее разделу: чем заполнить поля, печатать ли окно открытым
// и что домен отбил по полям. Ни одного из трёх у обычного показа страницы нет.
//
// Параметры:
//  Параметры - Структура - параметры окна, собранные разделом.
//
// Возвращаемое значение:
//  Структура - Заполнение (Произвольный, Неопределено), Открыта (Булево),
//              Отказы (Соответствие, Неопределено).
//
Функция Состояние(Знач Параметры) Экспорт

	Заполнение = Неопределено;
	Параметры.Свойство("Заполнение", Заполнение);
	Открыта = Ложь;
	Параметры.Свойство("Открыта", Открыта);
	Отказы = Неопределено;
	Параметры.Свойство("Отказы", Отказы);

	Возврат Новый Структура("Заполнение, Открыта, Отказы", Заполнение, Открыта = Истина, Отказы);

КонецФункции

// Оформление окна заведения. Открывашка носит имя окна: кнопка и заголовок называют
// человеку одно и то же действие. Отмена — общая на все окна настроек.
//
// Параметры:
//  Состояние - Структура - состояние окна (см. Состояние).
//  Заголовок - Строка - имя окна для человека и скринридера.
//  Лид - Строка - что делает форма.
//  Отправка - Строка - подпись кнопки отправки.
//  ИконкаОтправки - Строка - имя значка кнопки отправки.
//
// Возвращаемое значение:
//  Структура - оформление для Окно; поля дозаполняются у результата — структура открытая.
//
Функция Оформление(Знач Состояние, Знач Заголовок, Знач Лид, Знач Отправка,
	Знач ИконкаОтправки) Экспорт

	Результат = Новый Структура();
	Результат.Вставить("Заголовок", Заголовок);
	Результат.Вставить("Лид", Лид);
	Результат.Вставить("Открывашка", Заголовок);
	Результат.Вставить("ИконкаОткрывашки", "плюс");
	Результат.Вставить("Отмена", Тексты.Текст("settings.frame.cancel"));
	Результат.Вставить("Отправка", Отправка);
	Результат.Вставить("ИконкаОтправки", ИконкаОтправки);
	Результат.Вставить("Открыта", Состояние.Открыта);
	Возврат Результат;

КонецФункции

// Кнопка открытия и окно с формой. Отказ домена приходит в поле тем же путём, что и отказ
// проверки: помеченным полем, а не одним баннером над формой.
//
// Параметры:
//  Объявленная - ОбъявлениеФормы - объявленные поля формы.
//  Состояние - Структура - состояние окна (см. Состояние).
//  Адрес - Строка - адрес раздела, он же action формы.
//  Токен - Строка - CSRF-токен сессии.
//  Оформление - Структура - оформление окна (см. Оформление).
//
// Возвращаемое значение:
//  ЭлементЭкрана - кнопка открытия и <dialog> с формой.
//
Функция Окно(Объявленная, Знач Состояние, Знач Адрес, Знач Токен, Знач Оформление) Экспорт

	Если ТипЗнч(Состояние.Отказы) = Тип("Соответствие") Тогда
		Для Каждого КиЗ Из Состояние.Отказы Цикл
			Объявленная.Отбить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;

	Возврат Кит.Окно(Объявленная, Состояние.Заполнение, Адрес, Токен, Оформление);

КонецФункции

&Прозвище("ОкноФормы")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;

КонецПроцедуры
