// Форма выдачи роли на объект — желудь модуля web-ui. Поля у пула и у пакета одни и те же,
// поэтому объявление одно; чем отличается экран — заголовком окна, и его приносит вызов.
// ОДНО объявление питает и отрисовку окна, и разбор POST.

Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем Фабрика;       // Формы (кит) — фабрика объявлений форм
Перем ТаблицыПрав;   // ТаблицаПрав (web-ui) — подписи ролей
Перем СервисПрав;    // СервисПрав (auth) — имена ролей
Перем Окна;          // ОкноФормы (web-ui) — каркас окна заведения
Перем Тексты;        // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Объявление формы выдачи: какие поля, в каком порядке и с какими ограничениями.
// Им же разбирают пришедшее пульты прав — имя поля считает один и тот же код,
// поэтому отрисовка и разбор разойтись не могут.
//
// Возвращаемое значение:
//  ОбъявлениеФормы - объявление, готовое и печатать, и разбирать.
//
Функция Объявление() Экспорт

	Возврат Фабрика.Новая()
		.Поле("тип_субъекта", Тексты.Текст("access.rights.form.subject-type"), "выбор",
			Новый Структура("Варианты, Умолчание", ВариантыСубъекта(), "пользователь"))
		.Поле("субъект", Тексты.Текст("access.rights.form.subject"), "строка",
			Новый Структура("Обязательное", Истина))
		// потолок («выше собственной нельзя») держит служба доступа, а не форма
		.Поле("роль", Тексты.Текст("access.rights.form.role"), "выбор",
			Новый Структура("Варианты, Подсказка, Умолчание", ВариантыРоли(),
				Тексты.Текст("access.rights.form.role.hint"), СервисПрав.РольЧитатель()));

КонецФункции

// Кнопка выдачи и модальное окно с формой. Пока не нажали, форма места на экране
// не занимает; отбитая форма возвращается тем же окном — с набранным и помеченным полем.
//
// Параметры:
//  Параметры - Структура: * Адрес - Строка - адрес раздела (он же action формы); * Токен - Строка - CSRF-токен сессии; * Заголовок - Строка - имя окна для человека и скринридера; * Лид - Строка - что делает форма; * Кнопка - Строка - подпись кнопки отправки; * Заполнение - Структура, Соответствие, Неопределено - чем заполнить поля; * Открыта - Булево - печатать окно открытым; * Отказы - Соответствие - ключ поля -> текст отказа домена.
//
// Возвращаемое значение:
//  ЭлементЭкрана - кнопка открытия и окно с формой.
//
Функция Окно(Знач Параметры) Экспорт

	Состояние = Окна.Состояние(Параметры);

	Оформление = Окна.Оформление(Состояние, Параметры.Заголовок, Параметры.Лид,
		Параметры.Кнопка, "замок");

	// операция едет СКРЫТЫМ ПОЛЕМ, а не именем кнопки: отправка по Enter обязана нести
	// её так же, как нажатие кнопки
	Объявленная = Объявление().Блок(
		Кит.СкрытоеПоле("операция", ОперацияВыдачи()).Рендер());

	Возврат Окна.Окно(Объявленная, Состояние, Параметры.Адрес, Параметры.Токен, Оформление);

КонецФункции

// Значение поля «операция» для выдачи роли.
//
// Возвращаемое значение:
//  Строка
//
Функция ОперацияВыдачи() Экспорт
	Возврат "выдать";
КонецФункции

// Значение поля «операция» для отзыва роли. Операций у раздела ровно две, и обе названы
// здесь: пульт разбирает форму тем же объявлением, которым она напечатана.
//
// Возвращаемое значение:
//  Строка
//
Функция ОперацияОтзыва() Экспорт
	Возврат "отозвать";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Имя переменной не «Субъекты»: присваивание затирало бы одноимённое поле экземпляра.
Функция ВариантыСубъекта()

	ТипыСубъекта = Новый Массив();
	ТипыСубъекта.Добавить(Новый Структура("Значение, Подпись, Выбрано", "пользователь",
		Тексты.Текст("access.rights.form.subject-type.user"), Истина));
	ТипыСубъекта.Добавить(Новый Структура("Значение, Подпись", "группа",
		Тексты.Текст("access.rights.form.subject-type.group")));
	Возврат ТипыСубъекта;

КонецФункции

// Первой и предвыбранной идёт самая слабая роль: промах мышью не должен раздавать
// мейнтейнеров.
Функция ВариантыРоли()

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Значение, Подпись, Выбрано",
		СервисПрав.РольЧитатель(), ТаблицыПрав.ПодписьРоли(СервисПрав.РольЧитатель()), Истина));
	Результат.Добавить(Новый Структура("Значение, Подпись",
		СервисПрав.РольРайтер(), ТаблицыПрав.ПодписьРоли(СервисПрав.РольРайтер())));
	Результат.Добавить(Новый Структура("Значение, Подпись",
		СервисПрав.РольМейнтейнер(), ТаблицыПрав.ПодписьРоли(СервисПрав.РольМейнтейнер())));
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("ФормаВыдачиРоли")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "Формы") _Фабрика,
	&Пластилин(Значение = "ТаблицаПрав") _ТаблицыПрав,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "ОкноФормы") _Окна,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Фабрика = _Фабрика;
	ТаблицыПрав = _ТаблицыПрав;
	СервисПрав = _СервисПрав;
	Окна = _Окна;
	Тексты = _Тексты;

КонецПроцедуры
