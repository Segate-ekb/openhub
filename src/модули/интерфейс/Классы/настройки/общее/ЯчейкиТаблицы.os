// Ячейки таблиц настроек — желудь модуля web-ui: заготовки, которые повторяет каждая
// витрина со списком.

Перем Кит;  // Кит (кит) — узлы таблицы

// Ячейка с одним текстом.
//
// Параметры:
//  Значение - Строка - что напечатать в ячейке.
//
// Возвращаемое значение:
//  ЭлементЭкрана - ячейка таблицы.
//
Функция Текстовая(Знач Значение) Экспорт

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Текст(Значение));
	Возврат Ячейка;

КонецФункции

&Прозвище("ЯчейкиТаблицы")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "Кит") _Кит) Экспорт
	Кит = _Кит;
КонецПроцедуры
