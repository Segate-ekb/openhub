// Ячейки таблиц настроек — желудь модуля web-ui: заготовки, которые повторяет каждая
// витрина со списком.

Перем Кит;  // Кит (кит) — узлы таблицы

// Ячейка с одним текстом.
//
// Параметры:
//  Значение - Строка - что напечатать в ячейке.
//
// Возвращаемое значение:
//  ЭлементЭкрана - ячейка таблицы.
//
Функция Текстовая(Знач Значение) Экспорт

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Текст(Значение));
	Возврат Ячейка;

КонецФункции

// Ячейка с машинным значением: имя учётки у провайдера, ключ группы, идентификатор.
//
// Параметры:
//  Значение - Строка - что напечатать в ячейке.
//
// Возвращаемое значение:
//  ЭлементЭкрана - ячейка таблицы.
//
Функция Кодовая(Знач Значение) Экспорт

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Код(Значение));
	Возврат Ячейка;

КонецФункции

// Ячейка с готовым элементом: кнопкой, плашкой, ссылкой.
//
// Параметры:
//  Элемент - ЭлементЭкрана - что положить в ячейку.
//
// Возвращаемое значение:
//  ЭлементЭкрана - ячейка таблицы.
//
Функция СЭлементом(Знач Элемент) Экспорт

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Элемент);
	Возврат Ячейка;

КонецФункции

// Ячейка с текстом, у которой пустота печатается прочерком: пустая ячейка читается
// как поломка экрана, а прочерк — как «здесь нечего показать».
//
// Параметры:
//  Значение - Произвольный - что напечатать в ячейке; Неопределено считается пустотой.
//  Прочерк - Строка - чем заменить пустоту.
//
// Возвращаемое значение:
//  ЭлементЭкрана - ячейка таблицы.
//
Функция ТекстИлиПрочерк(Знач Значение, Знач Прочерк) Экспорт

	Текст = СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
	Если ЗначениеЗаполнено(Текст) Тогда
		Возврат Текстовая(Текст);
	КонецЕсли;

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Надпись("приглушённая")).Добавить(Кит.Текст(Прочерк));
	Возврат Ячейка;

КонецФункции

&Прозвище("ЯчейкиТаблицы")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "Кит") _Кит) Экспорт
	Кит = _Кит;
КонецПроцедуры
