// Поля настроек действия подписки — желудь модуля web-ui: набор ввода выбранного типа,
// собранный по декларации его обработчика. Что за типы есть и что объявил каждый —
// знает КаталогДействийПодписки; здесь только печать.

Перем Кит;         // Кит (кит) — фабрика элементов экрана
Перем Тексты;      // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем РазборФормы; // РазборФормы (web-ui) — чтение полей отклонённой формы
Перем Имена;       // ИменаПолейПодписки (web-ui) — имена полей раздела
Перем Каталог;     // КаталогДействийПодписки (web-ui) — типы и их декларации

#Область ПубличныйИнтерфейс

// Настройки действия для формы заведения: скрытое поле типа и поля ТОЛЬКО этого типа.
// Переключатель типов рисует витрина ссылками — у каждого набора полей свой адрес.
//
// Параметры:
//  Тип - Строка - выбранный тип действия.
//  Отклонённая - Соответствие - отклонённая форма, значениями которой заполняются поля
//                (необязательный, по умолчанию Неопределено — пустая форма).
//
// Возвращаемое значение:
//  ЭлементЭкрана - поля для формы заведения подписки.
//
Функция Заведения(Знач Тип, Знач Отклонённая = Неопределено) Экспорт

	Если Каталог.Пусто() Тогда
		// ни одного типа с формой: рисовать пустую форму создания нечестно
		Возврат Кит.Примечание(Тексты.Текст("subscriptions.form.types.empty"));
	КонецЕсли;

	Описание = Каталог.Описание(Каталог.ВыбранныйТип(Тип));

	Настройки = Кит.Холст();
	Настройки.Добавить(Кит.СкрытоеПоле(Имена.ИмяПоляТипа(), Описание.Тип));
	Настройки.Добавить(ГруппаЗаведения(Описание, Отклонённая));
	Возврат Настройки;

КонецФункции

// Поля правки: набор ТОГО ЖЕ типа со значениями подписки. Тип едет скрытым полем
// и на правке — сервер сверяет его с записью и подмену отбивает.
//
// Параметры:
//  Тип - Строка - тип действия правимой подписки.
//  Значения - Структура - значения по именам ввода (СервисПодписок.ЗначенияПравки).
//
// Возвращаемое значение:
//  ЭлементЭкрана - поля правки; ничего, если тип формы настроек не заявил.
//
Функция Правки(Знач Тип, Знач Значения) Экспорт

	Описание = Каталог.Описание(Тип);
	Если Описание = Неопределено Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Настройки = Кит.Холст();
	Настройки.Добавить(Кит.СкрытоеПоле(Имена.ИмяПоляТипа(), Описание.Тип));
	Настройки.Добавить(ГруппаПравки(Описание, Значения));
	Возврат Настройки;

КонецФункции

#КонецОбласти

#Область ГруппаЗаведения

// Отклонённая форма возвращается заполненной; секрет — исключение, он не возвращается никогда.
Функция ГруппаЗаведения(Знач Описание, Знач Отклонённая)

	Группа = НаборТипа(Описание);
	Группа.Добавить(ПояснениеТипа(Описание.Пояснение));
	Для Каждого ОписаниеПоля Из Описание.Поля Цикл
		Группа.Добавить(ПолеЗаведения(ОписаниеПоля, Отклонённая));
	КонецЦикла;
	Возврат Группа;

КонецФункции

Функция ПолеЗаведения(Знач ОписаниеПоля, Знач Отклонённая)

	Секрет = Каталог.Секретное(ОписаниеПоля);

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Плейсхолдер, Подсказка",
		ОписаниеПоля.ИмяПоля,
		Тексты.Текст(ОписаниеПоля.КлючПодписи),
		ВидВвода(ОписаниеПоля),
		?(Секрет ИЛИ Отклонённая = Неопределено, "",
			РазборФормы.Поле(Отклонённая, ОписаниеПоля.ИмяПоля)),
		ТекстНеобязательный(ОписаниеПоля.КлючПлейсхолдера),
		ТекстНеобязательный(ОписаниеПоля.КлючПодсказки)
			+ ?(Секрет И Отклонённая <> Неопределено,
				" " + Тексты.Текст("subscriptions.form.secret.again"), "")));

КонецФункции

#КонецОбласти

#Область ГруппаПравки

// Секретное поле приезжает пустым: значение заменяется маской и флажком «секрет свой».
Функция ГруппаПравки(Знач Описание, Знач Значения)

	Группа = НаборТипа(Описание);
	Для Каждого ОписаниеПоля Из Описание.Поля Цикл
		Если Каталог.Секретное(ОписаниеПоля) Тогда
			СобратьСекрет(Группа, ОписаниеПоля, Свой(Значения, ОписаниеПоля));
		Иначе
			Группа.Добавить(ПолеПравки(ОписаниеПоля, Значения));
		КонецЕсли;
	КонецЦикла;
	Возврат Группа;

КонецФункции

Функция ПолеПравки(Знач ОписаниеПоля, Знач Значения)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Плейсхолдер, Подсказка",
		ОписаниеПоля.ИмяПоля,
		Тексты.Текст(ОписаниеПоля.КлючПодписи),
		ВидВвода(ОписаниеПоля),
		Значение(Значения, ОписаниеПоля),
		ТекстНеобязательный(ОписаниеПоля.КлючПлейсхолдера),
		ТекстНеобязательный(ОписаниеПоля.КлючПодсказки)));

КонецФункции

// Заполненное value вернуло бы секрет на страницу, а маска в value записалась бы как новый.
Процедура СобратьСекрет(Знач Набор, Знач ОписаниеПоля, Знач Свой)

	Если Каталог.ЕстьСбросСекрета(ОписаниеПоля) Тогда
		Набор.Добавить(ФлажокСвоегоСекрета(ОписаниеПоля, Свой));
	КонецЕсли;

	Набор.Добавить(Кит.Поле(Новый Структура("Имя, Метка, Тип, Плейсхолдер, Подсказка",
		ОписаниеПоля.ИмяПоля,
		Тексты.Текст(ОписаниеПоля.КлючПодписи),
		ВидВвода(ОписаниеПоля),
		?(Свой, Имена.МаскаСекрета(), ТекстНеобязательный(ОписаниеПоля.КлючПлейсхолдера)),
		ТекстНеобязательный(ОписаниеПоля.КлючПодсказки)
			+ " " + Тексты.Текст("subscriptions.form.secret.keep"))));

КонецПроцедуры

Функция ФлажокСвоегоСекрета(Знач ОписаниеПоля, Знач Свой)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Отмечено, Подсказка",
		Имена.ИмяПоляСвоегоСекрета(ОписаниеПоля.ИмяПоля),
		ПодписьСвоего(ОписаниеПоля), "флажок", Имена.ЗначениеОтмечено(), Свой,
		Тексты.Текст("subscriptions.form.secret.own.hint")));

КонецФункции

// «Секрет у подписки свой» — часть значений правки: их отдаёт описание хранения типа.
Функция Свой(Знач Значения, Знач ОписаниеПоля)
	Найденное = Неопределено;
	Возврат Значения.Свойство(ОписаниеПоля.Имя + "Свой", Найденное) И Найденное = Истина;
КонецФункции

Функция ПодписьСвоего(Знач ОписаниеПоля)
	КлючТекста = Неопределено;
	ОписаниеПоля.Свойство("КлючСвоего", КлючТекста);
	Возврат Тексты.Текст(Строка(КлючТекста));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Скрипт находит набор по имени типа: второй разметки для переключения не заводится.
Функция НаборТипа(Знач Описание)
	Возврат Кит.Группа(Описание.Подпись).Признак("action-type", Описание.Тип);
КонецФункции

Функция ПояснениеТипа(Знач Пояснение)
	Возврат ?(ЗначениеЗаполнено(Пояснение), Кит.Примечание(Пояснение), Кит.Ничего());
КонецФункции

// Текст по необязательному ключу: пустой ключ означает «узла нет».
Функция ТекстНеобязательный(Знач Ключ)
	Возврат ?(ЗначениеЗаполнено(Ключ), Тексты.Текст(Ключ), "");
КонецФункции

Функция Значение(Знач Значения, Знач ОписаниеПоля)
	Найденное = Неопределено;
	Если Значения.Свойство(ОписаниеПоля.Имя, Найденное) И Найденное <> Неопределено Тогда
		Возврат Строка(Найденное);
	КонецЕсли;
	Возврат "";
КонецФункции

// Признаки вида ввода необязательны: декларация стороннего типа могла их не объявить.
Функция ВидВвода(Знач ОписаниеПоля)

	Если Каталог.Секретное(ОписаниеПоля) Тогда
		Возврат "пароль";
	КонецЕсли;
	Значение = Неопределено;
	Если ОписаниеПоля.Свойство("Многострочное", Значение) И Значение = Истина Тогда
		Возврат "многострочное";
	КонецЕсли;
	Возврат "текст";

КонецФункции

#КонецОбласти

&Прозвище("ПоляПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "КаталогДействийПодписки") _Каталог) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	РазборФормы = _РазборФормы;
	Имена = _Имена;
	Каталог = _Каталог;

КонецПроцедуры
