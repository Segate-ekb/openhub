// Таблица прав доступа — желудь модуля web-ui: одна раскладка на все экраны прав,
// две оси выдачи («кому дано» и «на что дано») и единый порядок действий.

Перем Кит;       // Кит (кит) — фабрика элементов экрана
Перем Модели;    // ЧтениеМодели (кит)
Перем Субъекты;  // СубъектыПрав (auth) — логин/имя группы по идентификатору
Перем Тексты;    // ТекстыИнтерфейса (кит) — заголовки колонок и слова действий

#Область ПубличныйИнтерфейс

// Таблица прав.
//
// Параметры:
//  Модель - Структура: * Строки - Массив из Структура: - Грант - запись права (ТипСубъекта, СубъектИдентификатор, Чтение, Создание, Изменение, Удаление); для оси «субъекты» по ней же резолвится имя субъекта; - Объект - ЭлементЭкрана - содержимое первой ячейки оси «объекты» (имя пула либо ссылка на него); - Хвост - ЭлементЭкрана - содержимое последней ячейки (форма отзыва, ссылка «где править»); только при СХвостом; - Роль - Строка - роль записи, только при СРолью; * Ось - Строка - "субъекты" (по умолчанию) | "объекты"; * СРолью - Булево - печатать колонку РОЛЬ вместо колонки «Действия»; * СХвостом - Булево - рисовать ли последнюю колонку; * ХвостЗаголовок - Строка - заголовок колонки хвоста ("" по умолчанию); * Пусто - Строка - текст пустой таблицы.
//
// Возвращаемое значение:
//  ЭлементЭкрана - таблица.
//
Функция Таблица(Знач Модель) Экспорт

	ОсьОбъектов = (НРег(СокрЛП(Модели.Текст(Модель, "Ось", "субъекты"))) = "объекты");
	СХвостом = Модели.Флаг(Модель, "СХвостом");
	СРолью = Модели.Флаг(Модель, "СРолью");

	Таблица = Кит.Таблица();
	Таблица.Пусто().Добавить(Кит.Примечание(Модели.Текст(Модель, "Пусто"), "пусто"));

	СобратьКолонки(Таблица, ОсьОбъектов, СХвостом,
		Модели.Текст(Модель, "ХвостЗаголовок"), СРолью);

	Для Каждого Описание Из Модели.Список(Модель, "Строки") Цикл
		Таблица.Добавить(СтрокаТаблицы(Описание, ОсьОбъектов, СХвостом, СРолью));
	КонецЦикла;

	Возврат Таблица;

КонецФункции

// Действия права одной строкой в едином порядке: чтение, создание, изменение, удаление.
//
// Параметры:
//  Грант - запись права (Чтение, Создание, Изменение, Удаление).
//
// Возвращаемое значение:
//  Строка - перечисление действий либо «—».
//
Функция ДействияТекстом(Знач Грант) Экспорт

	Части = Новый Массив();
	Если Грант.Чтение = Истина Тогда
		Части.Добавить(Тексты.Текст("settings.reply.grant.read"));
	КонецЕсли;
	Если Грант.Создание = Истина Тогда
		Части.Добавить(Тексты.Текст("settings.reply.grant.create"));
	КонецЕсли;
	Если Грант.Изменение = Истина Тогда
		Части.Добавить(Тексты.Текст("settings.reply.grant.update"));
	КонецЕсли;
	Если Грант.Удаление = Истина Тогда
		Части.Добавить(Тексты.Текст("settings.reply.grant.delete"));
	КонецЕсли;
	Возврат ?(Части.Количество() = 0, Тексты.Текст("settings.reply.grant.none"), СтрСоединить(Части, ", "));

КонецФункции

// Подпись роли — одна на все экраны прав.
//
// Параметры:
//  Роль - Строка - машинное имя роли (читатель | райтер | мейнтейнер | владелец | админ).
//
// Возвращаемое значение:
//  Строка.
//
Функция ПодписьРоли(Знач Роль) Экспорт

	Норм = НРег(СокрЛП(Строка(Роль)));
	Если Норм = "читатель" Тогда
		Возврат Тексты.Текст("access.rights.role.reader");
	ИначеЕсли Норм = "райтер" Тогда
		Возврат Тексты.Текст("access.rights.role.writer");
	ИначеЕсли Норм = "мейнтейнер" Тогда
		Возврат Тексты.Текст("access.rights.role.maintainer");
	ИначеЕсли Норм = "владелец" Тогда
		Возврат Тексты.Текст("access.rights.role.owner");
	ИначеЕсли Норм = "админ" Тогда
		Возврат Тексты.Текст("access.rights.role.admin");
	КонецЕсли;
	Возврат Тексты.Текст("settings.reply.grant.none");

КонецФункции

// Имя субъекта права — резолв пары «тип + идентификатор» в логин/имя группы.
//
// Параметры:
//  ТипСубъекта - Строка.
//  СубъектИд - Число.
//
// Возвращаемое значение:
//  Строка - человеческое имя субъекта.
//
Функция ИмяСубъекта(Знач ТипСубъекта, Знач СубъектИд) Экспорт
	Возврат Субъекты.Имя(ТипСубъекта, СубъектИд);
КонецФункции

#КонецОбласти

#Область Раскладка

Процедура СобратьКолонки(Знач Таблица, Знач ОсьОбъектов, Знач СХвостом,
	Знач ХвостЗаголовок, Знач СРолью)

	Если ОсьОбъектов Тогда
		Таблица.Добавить(Кит.Колонка(Тексты.Текст("access.grants.col.object")));
	Иначе
		Таблица.Добавить(Кит.Колонка(Тексты.Текст("access.grants.col.subject-type")));
		Таблица.Добавить(Кит.Колонка(Тексты.Текст("access.grants.col.subject")));
	КонецЕсли;

	Таблица.Добавить(Кит.Колонка(?(СРолью, Тексты.Текст("access.grants.col.role"),
		Тексты.Текст("access.grants.col.actions"))));

	Если СХвостом Тогда
		Таблица.Добавить(Кит.Колонка(ХвостЗаголовок));
	КонецЕсли;

КонецПроцедуры

Функция СтрокаТаблицы(Знач Описание, Знач ОсьОбъектов, Знач СХвостом, Знач СРолью)

	Грант = Модели.Значение(Описание, "Грант");

	Строка_ = Кит.Запись();
	Если ОсьОбъектов Тогда
		Строка_.Добавить(ЯчейкаСодержимого(Модели.Значение(Описание, "Объект")));
	Иначе
		Строка_.Добавить(ЯчейкаТекста(Строка(Грант.ТипСубъекта)));
		Строка_.Добавить(ЯчейкаТекста(ИмяСубъекта(Грант.ТипСубъекта, Грант.СубъектИдентификатор)));
	КонецЕсли;

	Строка_.Добавить(ЧтоРазрешено(Описание, Грант, СРолью));

	Если СХвостом Тогда
		Строка_.Добавить(ЯчейкаСодержимого(Модели.Значение(Описание, "Хвост")));
	КонецЕсли;

	Возврат Строка_;

КонецФункции

// Пустая роль — набор, не совпавший ни с одним пресетом, а не «нет прав».
Функция ЧтоРазрешено(Знач Описание, Знач Грант, Знач СРолью)

	Возврат ЯчейкаТекста(?(СРолью, ПодписьРоли(Модели.Текст(Описание, "Роль")),
		ДействияТекстом(Грант)));

КонецФункции

// Ячейка, содержимое которой собрал вызывающий: имя объекта, ссылка, форма отзыва.
// Не заполненное им место остаётся пустой ячейкой.
Функция ЯчейкаСодержимого(Знач Содержимое)

	Ячейка = Кит.Ячейка();
	Если Содержимое <> Неопределено Тогда
		Ячейка.Добавить(Содержимое);
	КонецЕсли;
	Возврат Ячейка;

КонецФункции

Функция ЯчейкаТекста(Знач Значение)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Текст(Значение));
	Возврат Ячейка;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "СубъектыПрав") _Субъекты,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Модели = _Модели;
	Субъекты = _Субъекты;
	Тексты = _Тексты;

КонецПроцедуры
