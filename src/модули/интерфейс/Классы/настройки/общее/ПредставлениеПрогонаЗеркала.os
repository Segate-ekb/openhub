// Представление прогона зеркала — желудь модуля web-ui: состояние синхронизации в виде,
// готовом для экрана (подпись состояния, моменты, счётчики, доля обхода).
// Сам прогон — доменный класс модуля зеркала; здесь только то, как он выглядит.

Перем Тексты;    // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Счётчики;  // СчётчикиОбхода (зеркала) — «обработано» и долю обхода считает домен

#Область ПубличныйИнтерфейс

// Модель прогона зеркала для экрана.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - конфигурация зеркала.
//  Брошен - Булево - вердикт домена «прогон занят, но молчит дольше порога»
//           (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура - Код (Строка - код состояния: хранения либо "брошен"), Подпись (Строка -
//              состояние словами), Вид (Строка - вид плашки), Активен (Булево - прогон
//              идёт либо ждёт очереди), Начат, Обновлён, ПоследнийСинк (Строка - момент
//              либо ""), Всего, Скачано, Пропущено, Ошибок, Недоступно, Обработано,
//              ИмёнВсего, ИмёнПройдено, Процент (Число, доля обхода по именам),
//              Курсор (Строка), Запустил (Строка - "" для планового запуска),
//              Итог (Строка - текст последнего результата).
//
Функция Модель(Знач Зеркало, Знач Брошен = Ложь) Экспорт

	Результат = ПоЗаписи(Зеркало);
	// Запись говорит «идёт» и после смерти рабочего. Экран, поверивший ей на слово,
	// часами показывал живой прогон с застывшими счётчиками и обещанием само-обновления.
	Если Брошен = Истина И (Результат.Код = "идёт" ИЛИ Результат.Код = "поставлено") Тогда
		Результат.Код = "брошен";
	КонецЕсли;
	Досчитать(Результат);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПоЗаписи(Знач Зеркало)

	Результат = Новый Структура();
	Результат.Вставить("Код", Код(Зеркало.СостояниеПрогона));
	Результат.Вставить("Подпись", "");
	Результат.Вставить("Вид", "");
	Результат.Вставить("Активен", Ложь);
	Результат.Вставить("Начат", Момент(Зеркало.ПрогонНачат));
	Результат.Вставить("Обновлён", Момент(Зеркало.ПрогонОбновлён));
	Результат.Вставить("ПоследнийСинк", Момент(Зеркало.ПоследнийСинк));
	Результат.Вставить("Всего", Счётчик(Зеркало.ПрогонВсего));
	Результат.Вставить("Скачано", Счётчик(Зеркало.ПрогонСкачано));
	Результат.Вставить("Пропущено", Счётчик(Зеркало.ПрогонПропущено));
	Результат.Вставить("Ошибок", Счётчик(Зеркало.ПрогонОшибок));
	Результат.Вставить("Недоступно", Счётчик(Зеркало.ПрогонНедоступно));
	// «обработано» и доля обхода — счёт ДОМЕНА: экран считает их тем же кодом, которым
	// движок переносит знаменатель, а не второй копией формулы
	Результат.Вставить("Обработано", Счётчики.ОбработаноПоЗаписи(Зеркало));
	Результат.Вставить("ИмёнВсего", Счётчик(Зеркало.ПрогонИмёнВсего));
	Результат.Вставить("ИмёнПройдено", Счётчик(Зеркало.ПрогонИмёнПройдено));
	Результат.Вставить("Процент", Счётчики.ДоляОбходаПоЗаписи(Зеркало));
	Результат.Вставить("Курсор", Текст(Зеркало.ПрогонКурсор));
	Результат.Вставить("Запустил", Текст(Зеркало.ПрогонЗапустил));
	Результат.Вставить("Итог", Текст(Зеркало.Статус));
	Возврат Результат;

КонецФункции

Процедура Досчитать(Модель)

	Модель.Подпись = Подпись(Модель.Код);
	Модель.Вид = Вид(Модель.Код);
	Модель.Активен = (Модель.Код = "поставлено" ИЛИ Модель.Код = "идёт");

КонецПроцедуры

// Код хранения приводится к известному набору: незнакомое и пустое значение — «простаивает».
Функция Код(Знач Значение)

	Норма = НРег(Текст(Значение));
	Если Норма = "поставлено" ИЛИ Норма = "идёт" ИЛИ Норма = "завершён" ИЛИ Норма = "ошибка" Тогда
		Возврат Норма;
	КонецЕсли;

	Возврат "простаивает";

КонецФункции

// Ключи перечислены литералами: скан мёртвых ключей словаря читает код, а не значения.
Функция Подпись(Знач Код)

	Если Код = "поставлено" Тогда
		Возврат Тексты.Текст("mirror.run.state.queued");
	ИначеЕсли Код = "идёт" Тогда
		Возврат Тексты.Текст("mirror.run.state.running");
	ИначеЕсли Код = "брошен" Тогда
		Возврат Тексты.Текст("mirror.run.state.stale");
	ИначеЕсли Код = "завершён" Тогда
		Возврат Тексты.Текст("mirror.run.state.done");
	ИначеЕсли Код = "ошибка" Тогда
		Возврат Тексты.Текст("mirror.run.state.failed");
	КонецЕсли;

	Возврат Тексты.Текст("mirror.run.state.idle");

КонецФункции

Функция Вид(Знач Код)

	Если Код = "поставлено" ИЛИ Код = "идёт" Тогда
		Возврат "accent";
	ИначеЕсли Код = "завершён" Тогда
		Возврат "ok";
	ИначеЕсли Код = "ошибка" ИЛИ Код = "брошен" Тогда
		Возврат "err";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция Текст(Знач Значение)
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
КонецФункции

Функция Счётчик(Знач Значение)
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Макс(0, Цел(Значение)), 0);
КонецФункции

Функция Момент(Знач Значение)

	Если ТипЗнч(Значение) <> Тип("Дата") ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Формат(Значение, "ДЛФ=DT");

КонецФункции

#КонецОбласти

&Прозвище("ПредставлениеПрогонаЗеркала")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СчётчикиОбхода") _Счётчики) Экспорт

	Тексты = _Тексты;
	Счётчики = _Счётчики;

КонецПроцедуры
