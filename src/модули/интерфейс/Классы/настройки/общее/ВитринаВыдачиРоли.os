// Секция «Права доступа» на объект: окно выдачи над таблицей, действующие роли строками
// и кнопка отзыва в каждой. Разметка у пула и у пакета одна, различия приносит вызов.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем Форма;             // ФормаВыдачиРоли (web-ui) — окно выдачи роли
Перем ТаблицыПрав;       // ТаблицаПрав (web-ui) — единая таблица выдачи прав
Перем СлужбаДоступа;     // СлужбаДоступа (кабинет) — действующие права на объект
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Бланки;            // БланкРаздела (web-ui) — адрес и токен раздела, формы на них

#Область ПубличныйИнтерфейс

// Секция действующих ролей на объекте раздела.
//
// Параметры:
//  Раздел - Структура:
//    * Вид - Строка - вид объекта («пакет», «пул»);
//    * Идентификатор - Число - объект раздела;
//    * Заголовок, Лид, Пусто, КолонкаДействия, Примечание, ТолькоЧтение, ЗаголовокОкна, ЛидОкна - Строка - подписи раздела, готовые к печати.
//  Бланк - Структура - бланк раздела (БланкРаздела): адрес форм и токен сессии.
//  МожетВыдавать - Булево - вправе ли смотрящий выдавать и отзывать роли на этом объекте.
//  Заведение - Структура, Неопределено - состояние окна выдачи (Открыта, Заполнение, Отказы).
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция Секция(Знач Раздел, Знач Бланк, Знач МожетВыдавать, Знач Заведение) Экспорт

	Тело = Кит.Холст();
	Тело.Добавить(ОкноВыдачи(Раздел, Бланк, МожетВыдавать, Заведение));
	Тело.Добавить(ТаблицаРолей(Раздел, Бланк, МожетВыдавать));
	Тело.Добавить(Кит.Примечание(Раздел.Примечание));
	Тело.Добавить(ОговоркаБезПрава(Раздел, МожетВыдавать));

	Результат = РендерерНастроек.Секция(Раздел.Заголовок, Раздел.Лид, Тело.Рендер());
	Результат.Иконка = "замок";
	// секция без «Действия»: кнопка отзыва каждой строки — своя маленькая форма
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Раскладка

// Пока не нажали, форма места не занимает; тому, кто выдавать не вправе, окна нет вовсе.
Функция ОкноВыдачи(Знач Раздел, Знач Бланк, Знач МожетВыдавать, Знач Заведение)

	Если НЕ МожетВыдавать Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Модель = Новый Структура("Адрес, Токен, Заголовок, Лид, Кнопка",
		Бланки.Адрес(Бланк), Бланк.Токен,
		Раздел.ЗаголовокОкна, Раздел.ЛидОкна, Тексты.Текст("access.rights.form.submit"));

	Если Заведение <> Неопределено Тогда
		// отбитая форма возвращается ТЕМ ЖЕ окном: с набранным и помеченным полем
		Модель.Вставить("Открыта", Заведение.Открыта);
		Модель.Вставить("Заполнение", Заведение.Заполнение);
		Модель.Вставить("Отказы", Заведение.Отказы);
	КонецЕсли;

	Возврат Форма.Окно(Модель);

КонецФункции

Функция ТаблицаРолей(Знач Раздел, Знач Бланк, Знач МожетВыдавать)

	Возврат ТаблицыПрав.Таблица(Новый Структура(
		"Строки, СРолью, СХвостом, ХвостЗаголовок, Пусто",
		Строки(Раздел, Бланк, МожетВыдавать), Истина, МожетВыдавать,
		Раздел.КолонкаДействия, Раздел.Пусто));

КонецФункции

Функция Строки(Знач Раздел, Знач Бланк, Знач МожетВыдавать)

	Результат = Новый Массив();
	Для Каждого Право Из СлужбаДоступа.ГрантыНаОбъект(Раздел.Вид, Раздел.Идентификатор) Цикл
		Субъект = ТаблицыПрав.ИмяСубъекта(Право.ТипСубъекта, Право.СубъектИдентификатор);
		Результат.Добавить(Новый Структура("Грант, Роль, Хвост", Право,
			СлужбаДоступа.РольЗаписи(Право),
			КнопкаОтзыва(Бланк, Право.ТипСубъекта, Субъект, МожетВыдавать)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КнопкаОтзыва(Знач Бланк, Знач ТипСубъекта, Знач Субъект, Знач МожетВыдавать)

	Если НЕ МожетВыдавать Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Отзыв = Бланки.Форма(Бланк);
	Отзыв.Добавить(Кит.СкрытоеПоле("операция", Форма.ОперацияОтзыва()));
	Отзыв.Добавить(Кит.СкрытоеПоле("тип_субъекта", ТипСубъекта));
	Отзыв.Добавить(Кит.СкрытоеПоле("субъект", Субъект));
	Отзыв.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Тексты.Текст("access.rights.revoke"), "опасная", "малый")));

	Возврат Отзыв;

КонецФункции

// Тому, кто роли не раздаёт, экран честно говорит, почему кнопок нет.
Функция ОговоркаБезПрава(Знач Раздел, Знач МожетВыдавать)

	Если МожетВыдавать Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Примечание(Раздел.ТолькоЧтение);

КонецФункции

#КонецОбласти

&Прозвище("ВитринаВыдачиРоли")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ФормаВыдачиРоли") _Форма,
	&Пластилин(Значение = "ТаблицаПрав") _ТаблицыПрав,
	&Пластилин(Значение = "СлужбаДоступа") _СлужбаДоступа,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "БланкРаздела") _Бланки) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Форма = _Форма;
	ТаблицыПрав = _ТаблицыПрав;
	СлужбаДоступа = _СлужбаДоступа;
	Тексты = _Тексты;
	Бланки = _Бланки;

КонецПроцедуры
