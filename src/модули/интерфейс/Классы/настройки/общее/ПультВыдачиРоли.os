// Выдача и отзыв роли на объект раздела «Права доступа». Ход операции у пула и у пакета
// один; вид объекта, идентификатор и слова отказов приносит вызов.

Перем РазборФормы;    // РазборФормы (web-ui)
Перем Формы;          // ФормаВыдачиРоли (web-ui) — объявление полей формы выдачи
Перем СлужбаДоступа;  // СлужбаДоступа (кабинет) — доменная выдача и отзыв
Перем Субъекты;       // СубъектыПрав (auth) — логин/имя группы → идентификатор
Перем ФабрикаИтога;   // ИтогПульта (web-ui) — единая форма итога операции
Перем Числа;          // ПриведениеЧисел (основа) — терпимое чтение числа
Перем Ошибки;         // ТекстОшибки (основа) — краткая причина без служебной обёртки
Перем Тексты;         // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Вправе ли пользователь выдавать и отзывать роли на объекте раздела. Порог — мейнтейнер
// самого объекта и выше; управления объектом (порог дома настроек) для этого мало.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - инициатор.
//  Раздел - Структура: * Вид - Строка - вид объекта («пакет», «пул»); * Идентификатор - Число - объект раздела.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетВыдавать(Знач Пользователь, Знач Раздел) Экспорт
	Возврат СлужбаДоступа.МожетВыдаватьГрант(Пользователь, Раздел.Вид, Раздел.Идентификатор);
КонецФункции

// Применяет операцию раздела «права доступа». Объект — только объект раздела: поле формы,
// назвавшее другой объект, обязано отбить запрос, а не выполнить его «на том, что нашлось».
//
// Параметры:
//  Пользователь - Пользователь - инициатор.
//  Раздел - Структура:
//    * Вид - Строка - вид объекта («пакет», «пул»);
//    * Идентификатор - Число - объект раздела;
//    * ЧужойОбъект - Строка - отказ «объект не этого раздела»;
//    * НеизвестныйСубъект - Строка - отказ «субъекта нет»;
//    * НеСохранено - Строка - шаблон отказа домена с «%1» под причину.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - Ошибка (Строка: "" — операция выполнена, иначе текст отказа для экрана),
//              Заведение (Структура, Неопределено: Открыта, Заполнение и Отказы окна
//              выдачи, в которое возвращается отбитая форма); прочие поля — см. ИтогПульта.
//
Функция Применить(Знач Пользователь, Знач Раздел, Знач Форма) Экспорт

	Операция = Операция(Форма);
	Если НЕ ЗначениеЗаполнено(Операция) Тогда
		// белый список: неназванная операция — отказ, а не выдача роли по умолчанию
		Возврат ФабрикаИтога.Отказ(Тексты.Текст("access.rights.error.operation"));
	КонецЕсли;

	Если НЕ ОбъектСвой(Форма, Раздел) Тогда
		Возврат ФабрикаИтога.Отказ(Раздел.ЧужойОбъект);
	КонецЕсли;

	// и выдача, и отзыв разбираются ОДНИМ объявлением: маленькая форма строки шлёт те же
	// поля скрытыми, поэтому второго соглашения об именах здесь не заводится
	Разбор = Формы.Объявление().Разобрать(Форма);
	Если НЕ Разбор.Принято Тогда
		Возврат Отбито(Операция, Разбор.Отказ, Разбор.Отказы, Разбор.Показ);
	КонецЕсли;

	ТипСубъекта = НРег(Значением(Разбор.Значения, "тип_субъекта"));
	СубъектИд = Субъекты.Идентификатор(ТипСубъекта, Значением(Разбор.Значения, "субъект"));
	Если СубъектИд = 0 Тогда
		Возврат ПоПолю(Операция, Раздел.НеизвестныйСубъект, "субъект", Разбор.Показ);
	КонецЕсли;

	Возврат ?(Операция = Формы.ОперацияВыдачи(),
		Выдать(Пользователь, Раздел, ТипСубъекта, СубъектИд, Разбор, Операция),
		Отозвать(Пользователь, Раздел, ТипСубъекта, СубъектИд));

КонецФункции

#КонецОбласти

#Область ГраницаОбъекта

// Поля формы — предмет сверки, а не источник данных: подделка обязана дать отказ.
Функция ОбъектСвой(Знач Форма, Знач Раздел)

	Если НРег(СокрЛП(РазборФормы.Поле(Форма, "объект", Раздел.Вид))) <> Раздел.Вид Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НазванЧужойВид(Форма, Раздел.Вид) Тогда
		Возврат Ложь;
	КонецЕсли;

	// имён у идентификатора два: общее «объект_ид» и имя вида — у пакета и у пула эти
	// имена в своё время разъехались, и сверка обязана видеть оба
	Возврат СвойИдентификатор(Форма, "объект_ид", Раздел.Идентификатор)
		И СвойИдентификатор(Форма, Раздел.Вид, Раздел.Идентификатор);

КонецФункции

// Вид чужой — назван объект, которым раздел не распоряжается: разбирать форму дальше нечего.
Функция НазванЧужойВид(Знач Форма, Знач ВидРаздела)

	Если ТипЗнч(Форма) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Поле Из Форма Цикл
		Имя = НРег(СокрЛП(Строка(Поле.Ключ)));
		Если Имя <> ВидРаздела И СлужбаДоступа.ТипОбъектаПоддерживается(Имя) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция СвойИдентификатор(Знач Форма, Знач Имя, Знач Идентификатор)

	Присланный = СокрЛП(РазборФормы.Поле(Форма, Имя));
	Возврат НЕ (ЗначениеЗаполнено(Присланный)
		И Числа.ЧислоИлиНоль(Присланный) <> Цел(Идентификатор));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// форма присылает РОЛЬ; потолок («выше собственной нельзя») держит служба доступа
Функция Выдать(Знач Пользователь, Знач Раздел, Знач ТипСубъекта, Знач СубъектИд, Знач Разбор,
	Знач Операция)

	Попытка
		СлужбаДоступа.ВыдатьРоль(Пользователь, ТипСубъекта, СубъектИд, Раздел.Вид,
			Раздел.Идентификатор, Значением(Разбор.Значения, "роль"));
	Исключение
		// отказ домена метит РОЛЬ: «выше собственной нельзя» — это про неё
		Возврат ПоПолю(Операция, СтрШаблон(Раздел.НеСохранено, Ошибки.Кратко(ОписаниеОшибки())),
			"роль", Разбор.Показ);
	КонецПопытки;

	Возврат ФабрикаИтога.Успех();

КонецФункции

Функция Отозвать(Знач Пользователь, Знач Раздел, Знач ТипСубъекта, Знач СубъектИд)

	Попытка
		СлужбаДоступа.ОтозватьГрант(Пользователь, ТипСубъекта, СубъектИд, Раздел.Вид,
			Раздел.Идентификатор);
	Исключение
		Возврат ФабрикаИтога.Отказ(СтрШаблон(Раздел.НеСохранено,
			Ошибки.Кратко(ОписаниеОшибки())));
	КонецПопытки;

	Возврат ФабрикаИтога.Успех();

КонецФункции

// Окно возвращается открытым только форме ВЫДАЧИ: у отзыва своя форма в строке таблицы.
Функция Отбито(Знач Операция, Знач Текст, Знач ОтказыПолей, Знач Набранное)
	Возврат ?(Операция <> Формы.ОперацияВыдачи(), ФабрикаИтога.Отказ(Текст),
		ФабрикаИтога.ОтказЗаведения(Текст, Набранное, ОтказыПолей));
КонецФункции

Функция ПоПолю(Знач Операция, Знач Текст, Знач Ключ, Знач Набранное)

	Отказы = Новый Соответствие();
	Отказы.Вставить(Ключ, Текст);
	Возврат Отбито(Операция, Текст, Отказы, Набранное);

КонецФункции

// Умолчание раздела — ОТКАЗ: подделанное поле и опечатка не попадают в ветку выдачи права.
Функция Операция(Знач Форма)

	Значение = НРег(СокрЛП(РазборФормы.Поле(Форма, "операция")));
	Возврат ?(Значение = Формы.ОперацияВыдачи() ИЛИ Значение = Формы.ОперацияОтзыва(),
		Значение, "");

КонецФункции

Функция Значением(Знач Значения, Знач Ключ)
	Найденное = Значения.Получить(Ключ);
	Возврат ?(Найденное = Неопределено, "", Строка(Найденное));
КонецФункции

#КонецОбласти

&Прозвище("ПультВыдачиРоли")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ФормаВыдачиРоли") _Формы,
	&Пластилин(Значение = "СлужбаДоступа") _СлужбаДоступа,
	&Пластилин(Значение = "СубъектыПрав") _Субъекты,
	&Пластилин(Значение = "ИтогПульта") _ФабрикаИтога,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	Формы = _Формы;
	СлужбаДоступа = _СлужбаДоступа;
	Субъекты = _Субъекты;
	ФабрикаИтога = _ФабрикаИтога;
	Числа = _Числа;
	Ошибки = _Ошибки;
	Тексты = _Тексты;

КонецПроцедуры
