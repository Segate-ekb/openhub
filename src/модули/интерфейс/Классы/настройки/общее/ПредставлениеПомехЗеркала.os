// Причины текущего обхода зеркала в виде, готовом для экрана: над чем не получилось,
// почему, сколько раз и когда в последний раз. Читать их — одно обращение на отрисовку.

Перем Причины;  // ПричиныЗеркала (зеркала) — помехи текущего обхода
Перем Коды;     // КодыПомех (помехи) — сводку переполнения узнают по коду, а не по тексту
Перем Даты;     // ДатаЧеловеку (web-ui) — одно написание момента на весь интерфейс
Перем Ошибки;   // ТекстОшибки (основа)
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Модель причин для экрана состояния зеркала.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - прочитанная запись зеркала.
//
// Возвращаемое значение:
//  Структура - Прочитано (Булево — причины удалось прочитать), Строки (Массив из Структура:
//              Предмет, Причина (Строка), Повторов (Число), Последний (Строка — момент либо ""),
//              Устранимо (Булево — причина пройдёт следующим заходом), ИсходНеясен
//              (Булево — про причину неизвестно, повторится она или нет), Сводка (Булево —
//              строка со счётчиком остальных причин)).
//
Функция Модель(Знач Зеркало) Экспорт

	// читатель помех БРОСАЕТ на лежащей базе, и это верно: пустой список означал бы
	// «всё привезено». Решает экран — счётчики он покажет в любом случае
	Попытка
		Возврат Прочитанное(Причины.Обхода(Зеркало));
	Исключение
		Лог.Предупреждение("Экран зеркала #%1: причины обхода не прочитаны, показаны только"
			+ " счётчики: %2", Зеркало.Идентификатор, Ошибки.Причина(ИнформацияОбОшибке()));
		Возврат Непрочитанное();
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Прочитанное(Знач Снимки)

	// экран перерисовывает себя каждые пять секунд, и «последние сверху» перетасовывали бы
	// таблицу под рукой у читающего: порядок у неё — по моменту ПЕРВОГО появления причины
	Строки = Новый Массив();
	Для Каждого Снимок Из ПоПервомуПоявлению(Снимки) Цикл
		Строки.Добавить(Помеха(Снимок));
	КонецЦикла;
	Возврат Новый Структура("Прочитано, Строки", Истина, Строки);

КонецФункции

Функция Непрочитанное()
	Возврат Новый Структура("Прочитано, Строки", Ложь, Новый Массив());
КонецФункции

Функция Помеха(Знач Снимок)

	Результат = Новый Структура();
	Результат.Вставить("Предмет", Текст(Снимок.Предмет));
	Результат.Вставить("Причина", Текст(Снимок.Причина));
	Результат.Вставить("Повторов", Счётчик(Снимок.Количество));
	Результат.Вставить("Последний", Момент(Снимок.Последний));
	Результат.Вставить("Устранимо", Снимок.Устранимо = Истина);
	Результат.Вставить("ИсходНеясен", Снимок.ИсходНеясен = Истина);
	Результат.Вставить("Сводка", Текст(Снимок.Код) = Коды.Прочее());
	Возврат Результат;

КонецФункции

// Вставкой, а не таблицей значений: строк тут не больше потолка летописи, зато у сортировки
// нет ни одного строкового литерала — их в слое представления ищет линт словаря.
Функция ПоПервомуПоявлению(Знач Снимки)

	Результат = Новый Массив();
	Для Каждого Снимок Из Снимки Цикл
		Результат.Вставить(МестоПоМоменту(Результат, Снимок.Впервые), Снимок);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция МестоПоМоменту(Знач Отобранные, Знач Момент)

	Для Индекс = 0 По Отобранные.ВГраница() Цикл
		Если Отобранные[Индекс].Впервые > Момент Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат Отобранные.Количество();

КонецФункции

Функция Текст(Знач Значение)
	Возврат ?(Значение = Неопределено, "", СокрЛП(Строка(Значение)));
КонецФункции

Функция Счётчик(Знач Значение)
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Макс(0, Цел(Значение)), 0);
КонецФункции

Функция Момент(Знач Значение)

	Если ТипЗнч(Значение) <> Тип("Дата") ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Даты.ДатаВремя(Значение);

КонецФункции

#КонецОбласти

&Прозвище("ПредставлениеПомехЗеркала")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПричиныЗеркала") _Причины,
	&Пластилин(Значение = "КодыПомех") _Коды,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено) Экспорт

	Причины = _Причины;
	Коды = _Коды;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);
	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);

КонецПроцедуры
