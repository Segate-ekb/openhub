// Общий ход раздела подписок — желудь модуля web-ui: гейт формы, пульт, показ раздела,
// уведомления и модель витрины. Чьи это подписки и по какому адресу живёт раздел, ход
// узнаёт из описания раздела, а рисует страницу дом.

Перем Ответы;  // ОтветыНастроек (web-ui)
Перем Тексты;  // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Гейт;    // ГейтФормы (web-ui) — метод запроса и токен формы
Перем Пульт;   // ПультПодписок (web-ui) — мутации подписок

#Область ПубличныйИнтерфейс

// Описание раздела подписок: чьи это подписки и где раздел живёт.
//
// Параметры:
//  Владелец - Структура - описание объекта подписок (СервисПодписок.Объект*).
//  Адрес - Строка - адрес раздела: на него постятся формы и на него же уводит редирект.
//
// Возвращаемое значение:
//  Структура - Владелец, Адрес.
//
Функция ОписаниеРаздела(Знач Владелец, Знач Адрес) Экспорт
	Возврат Новый Структура("Владелец, Адрес", Владелец, Адрес);
КонецФункции

// Что показать в ответ на запрос раздела: GET показывает раздел как есть, POST заводит
// подписку.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  Раздел - Структура - описание раздела (см. ОписаниеРаздела).
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  ВидФормы - Строка - тип действия, поля которого показывает форма заведения.
//
// Возвращаемое значение:
//  Структура, Неопределено - показ раздела; Неопределено — ответ уже записан: гейт отбил
//  форму, либо заведение удалось и дом уводит редиректом.
//
Функция ПоказПоЗапросу(Ответ, Знач Контекст, Знач Раздел, Знач КукиЗапроса,
	Знач МетодЗапроса, Знач ТелоЗапроса, Знач ВидФормы) Экспорт

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Возврат ПоказРаздела(ВидФормы);
	КонецЕсли;

	Форма = Гейт.ПринятаяФорма(Ответ, Контекст, "GET, POST", МетодЗапроса, ТелоЗапроса,
		КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПослеИсхода(Ответ, Контекст, Раздел, КукиЗапроса,
		Пульт.Создать(Контекст.Пользователь, Раздел.Владелец, Форма), Форма, 0);

КонецФункции

// Что показать в ответ на действие над отдельной подпиской: удаление, сохранение правки,
// пробную отправку, переключение.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  Раздел - Структура - описание раздела (см. ОписаниеРаздела).
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  Действие - Строка - что сделать с подпиской.
//  Идентификатор - Строка - идентификатор подписки из адреса.
//
// Возвращаемое значение:
//  Структура, Неопределено - показ раздела; Неопределено — ответ уже записан: гейт отбил
//  форму, подписки нет, либо действие удалось и дом уводит редиректом.
//
Функция ПоказПоДействию(Ответ, Знач Контекст, Знач Раздел, Знач КукиЗапроса,
	Знач МетодЗапроса, Знач ТелоЗапроса, Знач Действие, Знач Идентификатор) Экспорт

	Форма = Гейт.ПринятаяФорма(Ответ, Контекст, "POST", МетодЗапроса, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ПослеИсхода(Ответ, Контекст, Раздел, КукиЗапроса,
		Пульт.Применить(Контекст.Пользователь, Раздел.Владелец, Действие, Идентификатор, Форма),
		Форма, Идентификатор);

КонецФункции

// Уведомления страницы раздела подписок.
//
// Параметры:
//  Показ - Структура - показ раздела.
//
// Возвращаемое значение:
//  Массив - уведомления для модели дома.
//
Функция Уведомления(Знач Показ) Экспорт

	Результат = Новый Массив();
	Если ЗначениеЗаполнено(Показ.НовыйСекрет) Тогда
		Результат.Добавить(Ответы.Уведомление(Тексты.Текст("subscriptions.notice.created"), "ok"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Показ.Ошибка) Тогда
		Результат.Добавить(Ответы.Уведомление(Показ.Ошибка, "err"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Показ.Сообщение) Тогда
		Результат.Добавить(Ответы.Уведомление(Показ.Сообщение, Показ.ВидСообщения));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Модель ВитриныПодписок: что показывает раздел и что ему разрешено.
//
// Параметры:
//  Показ - Структура - показ раздела.
//  Раздел - Структура - описание раздела (см. ОписаниеРаздела).
//  Токен - Строка - CSRF-токен сессии для форм страницы.
//  Пояснение - Строка - что настраивает раздел у этого дома.
//  МожноМенять - Булево - показывать ли органы правки.
//
// Возвращаемое значение:
//  Структура - параметры ВитриныПодписок.
//
Функция ПараметрыВитрины(Знач Показ, Знач Раздел, Знач Токен, Знач Пояснение,
	Знач МожноМенять) Экспорт

	Результат = Новый Структура();
	Результат.Вставить("Объект", Раздел.Владелец);
	Результат.Вставить("Адрес", Раздел.Адрес);
	Результат.Вставить("Токен", Токен);
	Результат.Вставить("НовыйСекрет", Показ.НовыйСекрет);
	Результат.Вставить("Пояснение", Пояснение);
	Результат.Вставить("МожноМенять", МожноМенять);
	Результат.Вставить("Тип", Показ.Тип);
	Результат.Вставить("Форма", Показ.Форма);
	Результат.Вставить("ПравкаИд", Показ.ПравкаИд);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Успех создания показывает секрет один раз, прочие действия — PRG, отказ — та же
// страница с 400.
Функция ПослеИсхода(Ответ, Знач Контекст, Знач Раздел, Знач КукиЗапроса, Знач Исход,
	Знач Форма, Знач ПравкаИд)

	Если Исход.НеНайдено Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Контекст.Пользователь,
			Тексты.Текст("subscriptions.error.notfound"), КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Показ = ПоказПослеДействия(Исход, Пульт.ТипДействия(Форма), Форма, ПравкаИд);
	Если Показ = Неопределено Тогда
		// перезагрузка страницы не должна повторить действие
		Ответ.Перенаправить(Раздел.Адрес);
	КонецЕсли;

	Возврат Показ;

КонецФункции

// Показ раздела: с чем страница выводится, когда ничего не происходило.
Функция ПоказРаздела(Знач Тип = "")
	Возврат Новый Структура(
		"НовыйСекрет, Ошибка, Сообщение, ВидСообщения, Тип, Форма, ПравкаИд, Статус",
		"", "", "", "", Тип, Неопределено, 0, 200);
КонецФункции

// Неопределено — показывать нечего: действие удалось и не оставило ни секрета, ни слова.
Функция ПоказПослеДействия(Знач Исход, Знач Тип, Знач Форма, Знач ПравкаИд)

	Если НЕ Исход.Успех Тогда
		// отказ возвращает форму заполненной ровно тем, что прислали (секреты — исключение)
		Отбитый = ПоказРаздела(Тип);
		Отбитый.Ошибка = Исход.Ошибка;
		Отбитый.Форма = Форма;
		Отбитый.ПравкаИд = ПравкаИд;
		Отбитый.Статус = 400;
		Возврат Отбитый;
	КонецЕсли;

	Если ЗначениеЗаполнено(Исход.Сообщение) Тогда
		СИтогом = ПоказРаздела(Тип);
		СИтогом.Сообщение = Исход.Сообщение;
		СИтогом.ВидСообщения = Исход.ВидСообщения;
		Возврат СИтогом;
	КонецЕсли;

	Если ЗначениеЗаполнено(Исход.Секрет) Тогда
		ССекретом = ПоказРаздела();
		ССекретом.НовыйСекрет = Исход.Секрет;
		Возврат ССекретом;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

&Прозвище("ХодПодписок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "ПультПодписок") _Пульт) Экспорт

	Ответы = _Ответы;
	Тексты = _Тексты;
	Гейт = _Гейт;
	Пульт = _Пульт;

КонецПроцедуры
