// Форма действия подписки — желудь модуля web-ui.

Перем Реестр;      // РеестрДействийПодписок (подписки) — рендеры настроек по типам
Перем Кит;         // Кит (кит) — фабрика элементов экрана
Перем Тексты;      // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем РазборФормы; // РазборФормы (web-ui) — чтение полей тела запроса
Перем Защита;      // ЗащитаCSRF (auth) — владелец имени поля токена

Перем Описания;    // Массив из Структура - {Тип, Рендер, Поля, Подпись, Пояснение}
Перем ПоТипу;      // Соответствие: тип -> описание (разрешение подписи без обхода)

#Область ИменаПолейРаздела

// Имя поля-селектора типа действия.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляТипа() Экспорт
	Возврат "тип_действия";
КонецФункции

// Имя параметра адреса, которым выбирается тип действия в форме заведения. Латиницей:
// параметр едет в строку запроса, и русское имя пришлось бы кодировать в каждой ссылке.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПараметраТипа() Экспорт
	Возврат "kind";
КонецФункции

// Имя поля-флажка для типа события по его индексу в СервисПодписок.ИзвестныеТипы().
//
// Параметры:
//  Индекс - Число - позиция типа в перечне.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляСобытия(Знач Индекс) Экспорт
	Возврат ПрефиксСобытия() + Формат(Индекс, "ЧГ=0; ЧН=0");
КонецФункции

// Имя поля-параметра типа события по его индексу в СервисПодписок.ИзвестныеТипы().
// Параметр показывается рядом со своим флажком, поэтому индекс у них общий.
//
// Параметры:
//  Индекс - Число - позиция типа в перечне.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляПараметраСобытия(Знач Индекс) Экспорт
	Возврат ПрефиксПараметраСобытия() + Формат(Индекс, "ЧГ=0; ЧН=0");
КонецФункции

// Значение отмеченного флажка события (РазборФормы.Флажок читает сравнением).
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеОтмечено() Экспорт
	Возврат "1";
КонецФункции

// Имя поля-тумблера «включить/выключить подписку» (скрытое поле кнопки в списке
// и флажок «активна» в форме правки).
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляВключить() Экспорт
	Возврат "включить";
КонецФункции

// Имя флажка «секрет у подписки свой» для секретного поля типа. Без него пустое поле
// означало бы и «оставить прежний», и «очистить» — и очистить было бы нечем.
//
// Параметры:
//  ИмяПоля - Строка - имя поля формы секрета (ОписаниеПолей.ИмяПоля).
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляСвоегоСекрета(Знач ИмяПоля) Экспорт
	Возврат Строка(ИмяПоля) + СуффиксСвоего();
КонецФункции

// Маска сохранённого секрета в форме правки: значение секрета в разметку не выходит,
// а поле обязано отличаться от пустого «секрета нет».
//
// Возвращаемое значение:
//  Строка.
//
Функция МаскаСекрета() Экспорт
	Возврат "•••";
КонецФункции

#КонецОбласти

#Область ПубличныйИнтерфейс

// Человеческая подпись типа действия.
//
// Параметры:
//  Тип - Строка - тип.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПодписьТипа(Знач Тип) Экспорт

	Описание = ПоТипу.Получить(Ключ(Тип));
	Возврат ?(Описание = Неопределено, Строка(Тип), Описание.Подпись);

КонецФункции

// Типы действий, у которых есть форма настроек, в порядке показа.
//
// Возвращаемое значение:
//  Массив - структуры {Тип - Строка; Подпись - Строка}.
//
Функция Типы() Экспорт

	Результат = Новый Массив();
	Для Каждого Описание Из Описания Цикл
		Результат.Добавить(Новый Структура("Тип, Подпись", Описание.Тип, Описание.Подпись));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Тип, поля которого показывает форма: заданный, если он известен, иначе первый.
//
// Параметры:
//  Значение - Строка - тип из адреса или формы; пустой и неизвестный дают первый тип.
//
// Возвращаемое значение:
//  Строка - тип действия; пустая строка, если ни один тип формы не заявил.
//
Функция ВыбранныйТип(Знач Значение) Экспорт

	Если Описания.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Описание = ПоТипу.Получить(Ключ(Значение));
	Возврат ?(Описание = Неопределено, Описания[0].Тип, Описание.Тип);

КонецФункции

// Поля типа по декларации его рендера настроек.
//
// Параметры:
//  Тип - Строка - тип действия.
//
// Возвращаемое значение:
//  Массив - описания полей; пустой, если тип формы настроек не заявил.
//
Функция ПоляТипа(Знач Тип) Экспорт

	Описание = ПоТипу.Получить(Ключ(Тип));
	Возврат ?(Описание = Неопределено, Новый Массив(), Описание.Поля);

КонецФункции

// Настройки действия: скрытое поле типа и поля ТОЛЬКО этого типа. Переключатель
// типов рисует витрина ссылками — у каждого набора полей свой адрес.
//
// Параметры:
//  Тип - Строка - выбранный тип действия.
//  Отклонённая - Соответствие - отклонённая форма, значениями которой заполняются поля
//                (необязательный, по умолчанию Неопределено — пустая форма).
//
// Возвращаемое значение:
//  ЭлементЭкрана - поля для формы заведения подписки.
//
Функция Поля(Знач Тип, Знач Отклонённая = Неопределено) Экспорт

	Если Описания.Количество() = 0 Тогда
		// ни одного типа с формой: рисовать пустую форму создания нечестно
		Возврат Кит.Примечание(Тексты.Текст("subscriptions.form.types.empty"));
	КонецЕсли;

	Описание = ПоТипу.Получить(Ключ(ВыбранныйТип(Тип)));

	Настройки = Кит.Холст();
	Настройки.Добавить(Кит.СкрытоеПоле(ИмяПоляТипа(), Описание.Тип));
	Настройки.Добавить(ГруппаТипа(Описание, Отклонённая));
	Возврат Настройки;

КонецФункции

// Поля правки: набор ТОГО ЖЕ типа со значениями подписки. Тип едет скрытым полем
// и на правке — сервер сверяет его с записью и подмену отбивает.
//
// Параметры:
//  Тип - Строка - тип действия правимой подписки.
//  Значения - Структура - значения по именам ввода (СервисПодписок.ЗначенияПравки).
//
// Возвращаемое значение:
//  ЭлементЭкрана - поля правки; пустой холст, если тип формы настроек не заявил.
//
Функция ПоляПравки(Знач Тип, Знач Значения) Экспорт

	Описание = ПоТипу.Получить(Ключ(Тип));
	Если Описание = Неопределено Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Настройки = Кит.Холст();
	Настройки.Добавить(Кит.СкрытоеПоле(ИмяПоляТипа(), Описание.Тип));
	Настройки.Добавить(ГруппаПравки(Описание, Значения));
	Возврат Настройки;

КонецФункции

// Разбирает форму раздела в ввод доменного создания подписки.
//
// Параметры:
//  Форма - Соответствие - разобранное тело запроса.
//
// Возвращаемое значение:
//  Структура - {ТипДействия - Строка; Ввод - Структура} для СервисПодписок.СоздатьПодписку.
//
Функция Разобрать(Знач Форма) Экспорт

	Описание = ОписаниеИзФормы(Форма);

	Ввод = Новый Структура();
	Для Каждого ОписаниеПоля Из Описание.Поля Цикл
		Значение = СокрЛП(Строка(РазборФормы.Поле(Форма, ОписаниеПоля.ИмяПоля)));
		ПроверитьОбязательное(ОписаниеПоля, Значение);
		Ввод.Вставить(ОписаниеПоля.Имя, Значение);
	КонецЦикла;

	Возврат Новый Структура("ТипДействия, Ввод", Ключ(Описание.Тип), Ввод);

КонецФункции

// Разбирает форму правки подписки. Секретное поле приезжает парой: само значение и
// флажок «секрет свой» — пустое значение при включённом флажке означает «оставить
// прежний», выключенный флажок — «очистить», и решает это описание хранения типа.
//
// Параметры:
//  Форма - Соответствие - разобранное тело запроса.
//
// Возвращаемое значение:
//  Структура - {ТипДействия - Строка; Ввод - Структура; Активен - Булево}
//  для СервисПодписок.ОбновитьПодписку.
//
Функция РазобратьПравку(Знач Форма) Экспорт

	Описание = ОписаниеИзФормы(Форма);

	Ввод = Новый Структура();
	Для Каждого ОписаниеПоля Из Описание.Поля Цикл
		Значение = СокрЛП(Строка(РазборФормы.Поле(Форма, ОписаниеПоля.ИмяПоля)));
		Если Секретное(ОписаниеПоля) Тогда
			// пустой секрет на правке означает «оставить прежний» — обязательность
			// проверена на заведении, и требовать его повторно значило бы требовать
			// вводить секрет при каждой правке соседнего поля
			Если ЕстьСбросСекрета(ОписаниеПоля) Тогда
				Ввод.Вставить(ОписаниеПоля.Имя + "Свой", РазборФормы.Флажок(Форма,
					ИмяПоляСвоегоСекрета(ОписаниеПоля.ИмяПоля), ЗначениеОтмечено()));
			КонецЕсли;
		Иначе
			ПроверитьОбязательное(ОписаниеПоля, Значение);
		КонецЕсли;
		Ввод.Вставить(ОписаниеПоля.Имя, Значение);
	КонецЦикла;

	Возврат Новый Структура("ТипДействия, Ввод, Активен",
		Ключ(Описание.Тип), Ввод, РазборФормы.Флажок(Форма, ИмяПоляВключить(), ЗначениеОтмечено()));

КонецФункции

#КонецОбласти

#Область РазборПолей

// Поле, которого форма выбранного типа не показывает, она и не принимает.
Функция ОписаниеИзФормы(Знач Форма)

	Тип = Ключ(РазборФормы.Поле(Форма, ИмяПоляТипа()));
	Если НЕ ЗначениеЗаполнено(Тип) Тогда
		ВызватьИсключение Тексты.Текст("subscriptions.form.error.no-type");
	КонецЕсли;

	Описание = ПоТипу.Получить(Тип);
	Если Описание = Неопределено Тогда
		ВызватьИсключение Тексты.Шаблон("subscriptions.form.error.unknown-type", Тип);
	КонецЕсли;

	Чужое = ПерваяЧужаяПодпись(Тип, Форма);
	Если ЗначениеЗаполнено(Чужое) Тогда
		ВызватьИсключение Тексты.Шаблон("subscriptions.form.error.foreign-field",
			Чужое, Описание.Подпись);
	КонецЕсли;

	Возврат Описание;

КонецФункции

Процедура ПроверитьОбязательное(Знач ОписаниеПоля, Знач Значение)

	Если ОписаниеПоля.Обязательное И НЕ ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение Тексты.Шаблон("subscriptions.form.error.required",
			Тексты.Текст(ОписаниеПоля.КлючПодписи));
	КонецЕсли;

КонецПроцедуры

// Подпись первого заполненного поля, принадлежащего не выбранному типу.
Функция ПерваяЧужаяПодпись(Знач Тип, Знач Форма)

	Для Каждого Описание Из Описания Цикл
		Если Ключ(Описание.Тип) = Тип Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ОписаниеПоля Из Описание.Поля Цикл
			Если ЗначениеЗаполнено(СокрЛП(Строка(РазборФормы.Поле(Форма, ОписаниеПоля.ИмяПоля)))) Тогда
				Возврат Тексты.Текст(ОписаниеПоля.КлючПодписи);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "";

КонецФункции

#КонецОбласти

#Область СборкаПолей

// Секретное поле приезжает пустым: значение заменяется маской и флажком «секрет свой».
Функция ГруппаПравки(Знач Описание, Знач Значения)

	Группа = НаборТипа(Описание);
	Для Каждого ОписаниеПоля Из Описание.Поля Цикл
		Если Секретное(ОписаниеПоля) Тогда
			СобратьСекрет(Группа, ОписаниеПоля, Свой(Значения, ОписаниеПоля));
		Иначе
			Группа.Добавить(ПолеПравки(ОписаниеПоля, Значения));
		КонецЕсли;
	КонецЦикла;
	Возврат Группа;

КонецФункции

Функция ПолеПравки(Знач ОписаниеПоля, Знач Значения)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Плейсхолдер, Подсказка",
		ОписаниеПоля.ИмяПоля,
		Тексты.Текст(ОписаниеПоля.КлючПодписи),
		ВидВвода(ОписаниеПоля),
		Значение(Значения, ОписаниеПоля),
		ТекстНеобязательный(ОписаниеПоля.КлючПлейсхолдера),
		ТекстНеобязательный(ОписаниеПоля.КлючПодсказки)));

КонецФункции

// Заполненное value вернуло бы секрет на страницу, а маска в value записалась бы как новый.
Процедура СобратьСекрет(Знач Набор, Знач ОписаниеПоля, Знач Свой)

	Если ЕстьСбросСекрета(ОписаниеПоля) Тогда
		Набор.Добавить(ФлажокСвоегоСекрета(ОписаниеПоля, Свой));
	КонецЕсли;

	Набор.Добавить(Кит.Поле(Новый Структура("Имя, Метка, Тип, Плейсхолдер, Подсказка",
		ОписаниеПоля.ИмяПоля,
		Тексты.Текст(ОписаниеПоля.КлючПодписи),
		ВидВвода(ОписаниеПоля),
		?(Свой, МаскаСекрета(), ТекстНеобязательный(ОписаниеПоля.КлючПлейсхолдера)),
		ТекстНеобязательный(ОписаниеПоля.КлючПодсказки)
			+ " " + Тексты.Текст("subscriptions.form.secret.keep"))));

КонецПроцедуры

Функция ФлажокСвоегоСекрета(Знач ОписаниеПоля, Знач Свой)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Отмечено, Подсказка",
		ИмяПоляСвоегоСекрета(ОписаниеПоля.ИмяПоля),
		ПодписьСвоего(ОписаниеПоля), "флажок", ЗначениеОтмечено(), Свой,
		Тексты.Текст("subscriptions.form.secret.own.hint")));

КонецФункции

// Отклонённая форма возвращается заполненной; секрет — исключение, он не возвращается никогда.
Функция ГруппаТипа(Знач Описание, Знач Отклонённая = Неопределено)

	Группа = НаборТипа(Описание);
	Группа.Добавить(ПояснениеТипа(Описание.Пояснение));
	Для Каждого ОписаниеПоля Из Описание.Поля Цикл
		Группа.Добавить(ПолеЗаведения(ОписаниеПоля, Отклонённая));
	КонецЦикла;
	Возврат Группа;

КонецФункции

Функция ПолеЗаведения(Знач ОписаниеПоля, Знач Отклонённая)

	Секрет = Секретное(ОписаниеПоля);

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Плейсхолдер, Подсказка",
		ОписаниеПоля.ИмяПоля,
		Тексты.Текст(ОписаниеПоля.КлючПодписи),
		ВидВвода(ОписаниеПоля),
		?(Секрет ИЛИ Отклонённая = Неопределено, "",
			РазборФормы.Поле(Отклонённая, ОписаниеПоля.ИмяПоля)),
		ТекстНеобязательный(ОписаниеПоля.КлючПлейсхолдера),
		ТекстНеобязательный(ОписаниеПоля.КлючПодсказки)
			+ ?(Секрет И Отклонённая <> Неопределено,
				" " + Тексты.Текст("subscriptions.form.secret.again"), "")));

КонецФункции

// Скрипт находит набор по имени типа: второй разметки для переключения не заводится.
Функция НаборТипа(Знач Описание)
	Возврат Кит.Группа(Описание.Подпись).Признак("action-type", Описание.Тип);
КонецФункции

Функция ПояснениеТипа(Знач Пояснение)
	Возврат ?(ЗначениеЗаполнено(Пояснение), Кит.Примечание(Пояснение), Кит.Холст());
КонецФункции

// Текст по необязательному ключу: пустой ключ означает «узла нет».
Функция ТекстНеобязательный(Знач Ключ)
	Возврат ?(ЗначениеЗаполнено(Ключ), Тексты.Текст(Ключ), "");
КонецФункции

Функция Значение(Знач Значения, Знач ОписаниеПоля)
	Найденное = Неопределено;
	Если Значения.Свойство(ОписаниеПоля.Имя, Найденное) И Найденное <> Неопределено Тогда
		Возврат Строка(Найденное);
	КонецЕсли;
	Возврат "";
КонецФункции

// «Секрет у подписки свой» — часть значений правки: их отдаёт описание хранения типа.
Функция Свой(Знач Значения, Знач ОписаниеПоля)
	Найденное = Неопределено;
	Возврат Значения.Свойство(ОписаниеПоля.Имя + "Свой", Найденное) И Найденное = Истина;
КонецФункции

// Объявленный ключ подписи флажка и означает «сброс возможен»: у telegram стирать токен не во что.
Функция ЕстьСбросСекрета(Знач ОписаниеПоля)
	Ключ_ = Неопределено;
	Возврат ОписаниеПоля.Свойство("КлючСвоего", Ключ_) И ЗначениеЗаполнено(Ключ_);
КонецФункции

Функция ПодписьСвоего(Знач ОписаниеПоля)
	Ключ_ = Неопределено;
	ОписаниеПоля.Свойство("КлючСвоего", Ключ_);
	Возврат Тексты.Текст(Строка(Ключ_));
КонецФункции

Функция Секретное(Знач ОписаниеПоля)
	Значение = Неопределено;
	Возврат ОписаниеПоля.Свойство("Секретное", Значение) И Значение = Истина;
КонецФункции

// Суффикс имени поля формы для флажка «секрет свой»; во вводе ему отвечает «<Имя>Свой».
Функция СуффиксСвоего()
	Возврат "-свой";
КонецФункции

// Признаки вида ввода необязательны: декларация стороннего типа могла их не объявить.
Функция ВидВвода(Знач ОписаниеПоля)

	Если Секретное(ОписаниеПоля) Тогда
		Возврат "пароль";
	КонецЕсли;
	Значение = Неопределено;
	Если ОписаниеПоля.Свойство("Многострочное", Значение) И Значение = Истина Тогда
		Возврат "многострочное";
	КонецЕсли;
	Возврат "текст";

КонецФункции

#КонецОбласти

#Область СборкаОписаний

// Описания типов с рендером в стабильном порядке (по имени типа): реестр порядка не даёт.
Функция СобратьОписания()

	Результат = Новый Массив();
	Занятые = Новый Соответствие();

	Для Каждого Тип Из ПоАлфавиту(Реестр.Типы()) Цикл
		Рендер = Реестр.РендерНастроек(Тип);
		Если Рендер = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Тексты_ = ТекстыКонтракта(Тип, Рендер);
		Поля = Рендер.ОписаниеПолей();
		ПроверитьПоля(Тип, Поля, Занятые);
		Результат.Добавить(Новый Структура("Тип, Рендер, Поля, Подпись, Пояснение",
			Тип, Рендер, Поля, Тексты_.Подпись, Тексты_.Пояснение));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Полнота контракта рендера проверяется на сборке желудя.
Функция ТекстыКонтракта(Знач Тип, Знач Рендер)

	Попытка
		Подпись = Тексты.Текст(Рендер.КлючПодписи());
		Пояснение = ТекстНеобязательный(Рендер.КлючПояснения());
	Исключение
		ВызватьИсключение СтрШаблон(
			"Форма действия подписки: рендер настроек типа «%1» не выполняет контракт"
			+ " «РендерНастроекПодписки» (нужны ТипДействия(), ОписаниеПолей(),"
			+ " КлючПодписи(), КлючПояснения()): %2", Тип, ОписаниеОшибки());
	КонецПопытки;

	Возврат Новый Структура("Подпись, Пояснение", Подпись, Пояснение);

КонецФункции

// Сторож имён полей.
Процедура ПроверитьПоля(Знач Тип, Знач Поля, Занятые)

	Для Каждого ОписаниеПоля Из Поля Цикл

		Имя = Ключ(ОписаниеПоля.ИмяПоля);
		Если НЕ ЗначениеЗаполнено(Имя) Тогда
			ВызватьИсключение СтрШаблон(
				"Форма действия подписки: у типа «%1» поле «%2» без имени поля формы",
				Тип, ОписаниеПоля.Имя);
		КонецЕсли;

		Если ИмяСлужебное(Имя) Тогда
			ВызватьИсключение СтрШаблон(
				"Форма действия подписки: тип «%1» занял служебное имя поля «%2»", Тип, Имя);
		КонецЕсли;

		Владелец = Занятые.Получить(Имя);
		Если Владелец <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				"Форма действия подписки: имя поля «%1» объявлено дважды (типы «%2» и «%3»)",
				Имя, Владелец, Тип);
		КонецЕсли;

		Занятые.Вставить(Имя, Тип);

		// у сбрасываемого секрета форма правки заводит парный флажок — его имя занято тоже
		Если ЕстьСбросСекрета(ОписаниеПоля) Тогда
			Спутник = Ключ(ИмяПоляСвоегоСекрета(Имя));
			Владелец = Занятые.Получить(Спутник);
			Если Владелец <> Неопределено Тогда
				ВызватьИсключение СтрШаблон(
					"Форма действия подписки: имя поля «%1» объявлено дважды (типы «%2» и «%3»)",
					Спутник, Владелец, Тип);
			КонецЕсли;
			Занятые.Вставить(Спутник, Тип);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Массив строк по алфавиту (собственная сортировка: у Массива её нет).
Функция ПоАлфавиту(Знач Значения)

	Результат = Новый Массив();
	Для Каждого Значение Из Значения Цикл
		Место = Результат.Количество();
		Для Индекс = 0 По Результат.Количество() - 1 Цикл
			Если Строка(Значение) < Строка(Результат[Индекс]) Тогда
				Место = Индекс;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Результат.Вставить(Место, Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Имена, которыми распоряжается сам раздел.
Функция ИмяСлужебное(Знач Имя)

	Возврат Имя = Ключ(Защита.ИмяПоля())
		ИЛИ Имя = Ключ(ИмяПоляВключить())
		ИЛИ Имя = Ключ(ИмяПоляТипа())
		ИЛИ СтрНачинаетсяС(Имя, Ключ(ПрефиксСобытия()))
		ИЛИ СтрНачинаетсяС(Имя, Ключ(ПрефиксПараметраСобытия()));

КонецФункции

// Префикс имён флажков событий — нужен сторожу: запрещать надо всю группу, а не индекс.
Функция ПрефиксСобытия()
	Возврат "событие_";
КонецФункции

// Префикс имён параметров событий — та же причина, что и у флажков.
Функция ПрефиксПараметраСобытия()
	Возврат "параметр_события_";
КонецФункции

Функция Ключ(Знач Значение)
	Возврат НРег(СокрЛП(Строка(Значение)));
КонецФункции

#КонецОбласти

&Прозвище("ФормаДействияПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РеестрДействийПодписок") _Реестр,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита) Экспорт

	Реестр = _Реестр;
	Кит = _Кит;
	Тексты = _Тексты;
	РазборФормы = _РазборФормы;
	Защита = _Защита;

	Описания = СобратьОписания();

	ПоТипу = Новый Соответствие();
	Для Каждого Описание Из Описания Цикл
		ПоТипу.Вставить(Ключ(Описание.Тип), Описание);
	КонецЦикла;

КонецПроцедуры
