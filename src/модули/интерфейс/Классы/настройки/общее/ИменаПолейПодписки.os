// Имена HTML-полей раздела «подписки» — желудь модуля web-ui. Одно место, где раздел
// называет свои поля: разметка печатает эти имена, разбор формы читает их же.

Перем Защита;  // ЗащитаCSRF (вход) — владелец имени поля токена

#Область ПубличныйИнтерфейс

// Имя поля-селектора типа действия.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляТипа() Экспорт
	Возврат "тип_действия";
КонецФункции

// Имя параметра адреса, которым выбирается тип действия в форме заведения. Латиницей:
// параметр едет в строку запроса, и русское имя пришлось бы кодировать в каждой ссылке.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПараметраТипа() Экспорт
	Возврат "kind";
КонецФункции

// Имя поля-флажка для типа события по его индексу в СервисПодписок.ИзвестныеТипы().
//
// Параметры:
//  Индекс - Число - позиция типа в перечне.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляСобытия(Знач Индекс) Экспорт
	Возврат ПрефиксСобытия() + Формат(Индекс, "ЧГ=0; ЧН=0");
КонецФункции

// Имя поля-параметра типа события по его индексу в СервисПодписок.ИзвестныеТипы().
// Параметр показывается рядом со своим флажком, поэтому индекс у них общий.
//
// Параметры:
//  Индекс - Число - позиция типа в перечне.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляПараметраСобытия(Знач Индекс) Экспорт
	Возврат ПрефиксПараметраСобытия() + Формат(Индекс, "ЧГ=0; ЧН=0");
КонецФункции

// Значение отмеченного флажка события (РазборФормы.Флажок читает сравнением).
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеОтмечено() Экспорт
	Возврат "1";
КонецФункции

// Имя поля-тумблера «включить/выключить подписку» (скрытое поле кнопки в списке
// и флажок «активна» в форме правки).
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляВключить() Экспорт
	Возврат "включить";
КонецФункции

// Имя флажка «секрет у подписки свой» для секретного поля типа. Без него пустое поле
// означало бы и «оставить прежний», и «очистить» — и очистить было бы нечем.
//
// Параметры:
//  ИмяПоля - Строка - имя поля формы секрета (ОписаниеПолей.ИмяПоля).
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляСвоегоСекрета(Знач ИмяПоля) Экспорт
	Возврат Строка(ИмяПоля) + СуффиксСвоего();
КонецФункции

// Маска сохранённого секрета в форме правки: значение секрета в разметку не выходит,
// а поле обязано отличаться от пустого «секрета нет».
//
// Возвращаемое значение:
//  Строка.
//
Функция МаскаСекрета() Экспорт
	Возврат "•••";
КонецФункции

// Занято ли имя самим разделом: такое имя тип действия объявить не вправе.
//
// Параметры:
//  Имя - Строка - имя поля формы.
//
// Возвращаемое значение:
//  Булево.
//
Функция Служебное(Знач Имя) Экспорт

	Ключ = Ключ(Имя);
	Возврат Ключ = Ключ(Защита.ИмяПоля())
		ИЛИ Ключ = Ключ(ИмяПоляВключить())
		ИЛИ Ключ = Ключ(ИмяПоляТипа())
		ИЛИ СтрНачинаетсяС(Ключ, Ключ(ПрефиксСобытия()))
		ИЛИ СтрНачинаетсяС(Ключ, Ключ(ПрефиксПараметраСобытия()));

КонецФункции

// Имя поля в сравнимом виде: регистр и пробелы значения не несут.
//
// Параметры:
//  Значение - Строка - имя поля.
//
// Возвращаемое значение:
//  Строка.
//
Функция Ключ(Знач Значение) Экспорт
	Возврат НРег(СокрЛП(Строка(Значение)));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Префикс имён флажков событий — нужен сторожу: запрещать надо всю группу, а не индекс.
Функция ПрефиксСобытия()
	Возврат "событие_";
КонецФункции

// Префикс имён параметров событий — та же причина, что и у флажков.
Функция ПрефиксПараметраСобытия()
	Возврат "параметр_события_";
КонецФункции

// Суффикс имени поля формы для флажка «секрет свой»; во вводе ему отвечает «<Имя>Свой».
Функция СуффиксСвоего()
	Возврат "-свой";
КонецФункции

#КонецОбласти

&Прозвище("ИменаПолейПодписки")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ЗащитаCSRF") _Защита) Экспорт

	Защита = _Защита;

КонецПроцедуры
