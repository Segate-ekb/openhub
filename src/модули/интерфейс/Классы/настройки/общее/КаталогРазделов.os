// Каталог разделов дома настроек — желудь модуля web-ui.

Перем Рендерер;   // РендерерНастроек (кит) — заготовка раздела

// Описание раздела для списка дома.
//
// Параметры:
//  Ключ - Строка - сегмент URL раздела ("tokens").
//  Подпись - Строка - название раздела.
//  Иконка - Строка - имя иконки из НаборИконок (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура (Ключ, Подпись, Иконка).
//
Функция Описание(Знач Ключ, Знач Подпись, Знач Иконка = "") Экспорт
	Возврат Новый Структура("Ключ, Подпись, Иконка", Ключ, Подпись, Иконка);
КонецФункции

// Адрес раздела: базовый адрес дома + ключ раздела.
//
// Параметры:
//  БазовыйАдрес - Строка - адрес дома ("/me/settings").
//  Ключ - Строка - ключ раздела; пустой — сам дом.
//
// Возвращаемое значение:
//  Строка - URL раздела.
//
Функция Адрес(Знач БазовыйАдрес, Знач Ключ) Экспорт
	Возврат ?(ЗначениеЗаполнено(Ключ), БазовыйАдрес + "/" + Ключ, БазовыйАдрес);
КонецФункции

// Дерево разделов дома для РендерерНастроек.
//
// Параметры:
//  БазовыйАдрес - Строка - адрес дома.
//  Описания - Массив - описания разделов (см. Описание).
//  Активный - Строка - ключ текущего раздела.
//
// Возвращаемое значение:
//  Массив - разделы для компонента «Дерево разделов».
//
Функция Разделы(Знач БазовыйАдрес, Знач Описания, Знач Активный) Экспорт

	Результат = Новый Массив();
	Для Каждого ОписаниеРаздела Из Описания Цикл
		Результат.Добавить(Рендерер.Раздел(
			ОписаниеРаздела.Подпись,
			Адрес(БазовыйАдрес, ОписаниеРаздела.Ключ),
			ОписаниеРаздела.Иконка,
			ОписаниеРаздела.Ключ = Активный));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Есть ли такой раздел в доме: гейт против мусорного сегмента URL — 404, а не пустое дерево.
//
// Параметры:
//  Описания - Массив - описания разделов.
//  Ключ - Строка - проверяемый ключ.
//
// Возвращаемое значение:
//  Булево.
//
Функция Содержит(Знач Описания, Знач Ключ) Экспорт

	Для Каждого ОписаниеРаздела Из Описания Цикл
		Если ОписаниеРаздела.Ключ = Ключ Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Подпись раздела по ключу (для заголовка вкладки браузера).
//
// Параметры:
//  Описания - Массив - описания разделов.
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Строка - подпись либо "".
//
Функция Подпись(Знач Описания, Знач Ключ) Экспорт

	Для Каждого ОписаниеРаздела Из Описания Цикл
		Если ОписаниеРаздела.Ключ = Ключ Тогда
			Возврат ОписаниеРаздела.Подпись;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Сегмент URL из имени объекта: кодируем — имя приходит из URL до резолва в сущность.
//
// Параметры:
//  Имя - Строка - имя объекта.
//
// Возвращаемое значение:
//  Строка - безопасный сегмент пути.
//
Функция Сегмент(Знач Имя) Экспорт
	Возврат КодироватьСтроку(?(ТипЗнч(Имя) = Тип("Строка"), Имя, Строка(Имя)),
		СпособКодированияСтроки.КодировкаURL);
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РендерерНастроек") _Рендерер) Экспорт

	Рендерер = _Рендерер;

КонецПроцедуры
