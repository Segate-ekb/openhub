// Бланк раздела настроек — желудь модуля web-ui: адрес, куда уходит POST раздела,
// токен сессии, которым он подписан, и формы, которые на этом бланке печатаются.
// Пара «адрес и токен» ездит одним значением: порядок двух аргументов помнить некому.

Перем Кит;  // Кит (кит) — фабрика элементов экрана

#Область Бланк

// Бланк раздела из параметров экрана.
//
// Параметры:
//  Параметры - Структура - параметры раздела; Адрес и Токен обязательны. Структура без
//              них — ошибка вызывающего: молчаливый бланк дал бы форму с пустым action
//              и без CSRF, то есть кнопку, которая ничего не делает.
//
// Возвращаемое значение:
//  Структура - Адрес (Строка), Токен (Строка).
//
Функция Раздела(Знач Параметры) Экспорт

	Возврат НаАдресе(Параметры.Адрес, Параметры.Токен);

КонецФункции

// Бланк по готовой паре.
//
// Параметры:
//  Адрес - Строка - адрес раздела, он же action его форм.
//  Токен - Строка - CSRF-токен сессии.
//
// Возвращаемое значение:
//  Структура - Адрес (Строка), Токен (Строка).
//
Функция НаАдресе(Знач Адрес, Знач Токен) Экспорт

	Возврат Новый Структура("Адрес, Токен", Текст(Адрес), Текст(Токен));

КонецФункции

// Бланк объекта внутри раздела: тот же токен, адрес — с приписанным хвостом.
//
// Параметры:
//  Бланк - Структура - бланк раздела.
//  Хвост - Строка - что дописать к адресу (идентификатор строки списка, имя карточки).
//
// Возвращаемое значение:
//  Структура - Адрес (Строка), Токен (Строка).
//
Функция Вложенный(Знач Бланк, Знач Хвост) Экспорт

	Возврат НаАдресе(Адрес(Бланк, Хвост), Бланк.Токен);

КонецФункции

// Адрес действия на этом бланке.
//
// Параметры:
//  Бланк - Структура - бланк раздела.
//  Действие - Строка - хвост адреса; пустой означает сам адрес бланка
//             (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Строка.
//
Функция Адрес(Знач Бланк, Знач Действие = "") Экспорт

	Хвост = Текст(Действие);
	Возврат ?(ЗначениеЗаполнено(Хвост), Бланк.Адрес + "/" + Хвост, Бланк.Адрес);

КонецФункции

#КонецОбласти

#Область Разметка

// Форма, которая постит на действие этого бланка.
//
// Параметры:
//  Бланк - Структура - бланк раздела.
//  Действие - Строка - хвост адреса; пустой означает сам адрес бланка
//             (необязательный, по умолчанию "").
//  Вид - Строка - раскладка формы: «строкой» | «столбик» | «меню» | ""
//        (необязательный, по умолчанию «строкой»).
//
// Возвращаемое значение:
//  ЭлементЭкрана - пустая форма с action и токеном.
//
Функция Форма(Знач Бланк, Знач Действие = "", Знач Вид = "строкой") Экспорт

	Возврат Кит.Форма(Адрес(Бланк, Действие), Бланк.Токен, Вид);

КонецФункции

// Кнопка-действие без JS: своя маленькая форма с одной кнопкой. Единственный способ
// нарисовать такую кнопку — иначе один и тот же POST пишется то скрытым полем,
// то склейкой адреса, и читателю приходится сверять их между собой.
//
// Параметры:
//  Бланк - Структура - бланк раздела.
//  Действие - Строка - хвост адреса; пустой означает сам адрес бланка.
//  Подпись - Строка - надпись на кнопке.
//  Вариант - Строка - «основная» | «вторичная» | «опасная» | «тихая»
//            (необязательный, по умолчанию «вторичная»).
//  Размер - Строка - «малый» | «обычный» (необязательный, по умолчанию «малый»).
//
// Возвращаемое значение:
//  ЭлементЭкрана - форма с единственной кнопкой.
//
Функция КнопкаДействия(Знач Бланк, Знач Действие, Знач Подпись,
	Знач Вариант = "вторичная", Знач Размер = "малый") Экспорт

	Результат = Форма(Бланк, Действие, "строкой");
	Результат.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Подпись, Вариант, Размер)));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Текст(Знач Значение)
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

#КонецОбласти

&Прозвище("БланкРаздела")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "Кит") _Кит) Экспорт

	Кит = _Кит;

КонецПроцедуры
