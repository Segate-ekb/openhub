// Разбор формы раздела «подписки» — желудь модуля web-ui: присланное тело запроса
// становится доменным вводом. Поле, которого форма выбранного типа не показывает,
// она и не принимает.

Перем РазборФормы; // РазборФормы (web-ui) — чтение полей тела запроса
Перем Тексты;      // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Имена;       // ИменаПолейПодписки (web-ui) — имена полей раздела
Перем Каталог;     // КаталогДействийПодписки (web-ui) — типы и их декларации

#Область ПубличныйИнтерфейс

// Разбирает форму заведения подписки в доменный ввод.
//
// Параметры:
//  Форма - Соответствие - разобранное тело запроса.
//
// Возвращаемое значение:
//  Структура - {ТипДействия - Строка; Ввод - Структура} для СервисПодписок.СоздатьПодписку.
//
Функция Заведение(Знач Форма) Экспорт

	Описание = ОписаниеИзФормы(Форма);

	Ввод = Новый Структура();
	Для Каждого ОписаниеПоля Из Описание.Поля Цикл
		Значение = Присланное(Форма, ОписаниеПоля);
		ПроверитьОбязательное(ОписаниеПоля, Значение);
		Ввод.Вставить(ОписаниеПоля.Имя, Значение);
	КонецЦикла;

	Возврат Новый Структура("ТипДействия, Ввод", Каталог.КлючТипа(Описание.Тип), Ввод);

КонецФункции

// Разбирает форму правки подписки. Секретное поле приезжает парой: само значение и
// флажок «секрет свой» — пустое значение при включённом флажке означает «оставить
// прежний», выключенный флажок — «очистить», и решает это описание хранения типа.
//
// Параметры:
//  Форма - Соответствие - разобранное тело запроса.
//
// Возвращаемое значение:
//  Структура - {ТипДействия - Строка; Ввод - Структура; Активен - Булево}
//  для СервисПодписок.ОбновитьПодписку.
//
Функция Правка(Знач Форма) Экспорт

	Описание = ОписаниеИзФормы(Форма);

	Ввод = Новый Структура();
	Для Каждого ОписаниеПоля Из Описание.Поля Цикл
		Значение = Присланное(Форма, ОписаниеПоля);
		Если Каталог.Секретное(ОписаниеПоля) Тогда
			// пустой секрет на правке означает «оставить прежний» — обязательность
			// проверена на заведении, и требовать его повторно значило бы требовать
			// вводить секрет при каждой правке соседнего поля
			Если Каталог.ЕстьСбросСекрета(ОписаниеПоля) Тогда
				Ввод.Вставить(ОписаниеПоля.Имя + "Свой", РазборФормы.Флажок(Форма,
					Имена.ИмяПоляСвоегоСекрета(ОписаниеПоля.ИмяПоля), Имена.ЗначениеОтмечено()));
			КонецЕсли;
		Иначе
			ПроверитьОбязательное(ОписаниеПоля, Значение);
		КонецЕсли;
		Ввод.Вставить(ОписаниеПоля.Имя, Значение);
	КонецЦикла;

	Возврат Новый Структура("ТипДействия, Ввод, Активен",
		Каталог.КлючТипа(Описание.Тип), Ввод,
		РазборФормы.Флажок(Форма, Имена.ИмяПоляВключить(), Имена.ЗначениеОтмечено()));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Поле, которого форма выбранного типа не показывает, она и не принимает.
Функция ОписаниеИзФормы(Знач Форма)

	Тип = Каталог.КлючТипа(РазборФормы.Поле(Форма, Имена.ИмяПоляТипа()));
	Если НЕ ЗначениеЗаполнено(Тип) Тогда
		ВызватьИсключение Тексты.Текст("subscriptions.form.error.no-type");
	КонецЕсли;

	Описание = Каталог.Описание(Тип);
	Если Описание = Неопределено Тогда
		ВызватьИсключение Тексты.Шаблон("subscriptions.form.error.unknown-type", Тип);
	КонецЕсли;

	Чужое = ПерваяЧужаяПодпись(Тип, Форма);
	Если ЗначениеЗаполнено(Чужое) Тогда
		ВызватьИсключение Тексты.Шаблон("subscriptions.form.error.foreign-field",
			Чужое, Описание.Подпись);
	КонецЕсли;

	Возврат Описание;

КонецФункции

// Подпись первого заполненного поля, принадлежащего не выбранному типу.
Функция ПерваяЧужаяПодпись(Знач Тип, Знач Форма)

	Для Каждого Описание Из Каталог.Все() Цикл
		Если Каталог.КлючТипа(Описание.Тип) = Тип Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ОписаниеПоля Из Описание.Поля Цикл
			Если ЗначениеЗаполнено(Присланное(Форма, ОписаниеПоля)) Тогда
				Возврат Тексты.Текст(ОписаниеПоля.КлючПодписи);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция Присланное(Знач Форма, Знач ОписаниеПоля)
	Возврат СокрЛП(Строка(РазборФормы.Поле(Форма, ОписаниеПоля.ИмяПоля)));
КонецФункции

Процедура ПроверитьОбязательное(Знач ОписаниеПоля, Знач Значение)

	Если ОписаниеПоля.Обязательное И НЕ ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение Тексты.Шаблон("subscriptions.form.error.required",
			Тексты.Текст(ОписаниеПоля.КлючПодписи));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

&Прозвище("РазборФормыПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "КаталогДействийПодписки") _Каталог) Экспорт

	РазборФормы = _РазборФормы;
	Тексты = _Тексты;
	Имена = _Имена;
	Каталог = _Каталог;

КонецПроцедуры
