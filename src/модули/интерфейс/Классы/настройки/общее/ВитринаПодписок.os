// Витрина подписок на события — желудь модуля web-ui.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем СервисПодписок;    // СервисПодписок (подписки)
Перем СобытияХаба;       // КаталогСобытий (события) — подпись и пояснение типа события
Перем ТипыДействий;      // КаталогДействийПодписки (web-ui) — типы с формой настроек
Перем ПоляДействия;      // ПоляПодписки (web-ui) — набор ввода выбранного типа
Перем Имена;             // ИменаПолейПодписки (web-ui) — имена полей раздела
Перем Бланки;            // БланкРаздела (web-ui) — адрес и токен раздела, формы на них
Перем РазборФормы;       // РазборФормы (web-ui) — чтение отклонённой формы
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем ПараметрыСобытий;  // ПараметрыПодписки (подписки) — пороги параметров событий

#Область ПубличныйИнтерфейс

// Секции раздела «подписки» объекта.
//
// Параметры:
//  Параметры - Структура:
//    * Объект - Структура - описание объекта (СервисПодписок.Объект*);
//    * Адрес - Строка - адрес раздела (он же action всех форм);
//    * Токен - Строка - CSRF-токен сессии;
//    * НовыйСекрет - Строка - секрет только что созданной подписки ("" — нет);
//    * Пояснение - Строка - что именно получает подписчик этого объекта (текст контроллер берёт из словаря: ключ у каждого дома свой);
//    * МожноМенять - Булево - есть ли у зрителя право управлять подписками объекта;
//    * Тип - Строка - тип действия, поля которого показывает форма заведения;
//    * Форма - Соответствие - отклонённая форма, значениями которой заполняется разметка ("" и Неопределено — чистая форма);
//    * ПравкаИд - Строка, Число - подписка, чью форму правки отклонили (0 — отклонена форма заведения).
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Бланк = Бланки.Раздела(Параметры);
	МожноМенять = (Параметры.МожноМенять = Истина);
	Тип = ТипыДействий.ВыбранныйТип(ЗапрошенныйТип(Параметры));
	Отклонённая = ОтклонённаяФорма(Параметры);
	ПравкаИд = ИдПравимой(Параметры);

	Содержимое = Кит.Холст();
	Содержимое.Добавить(ПоказСекрета(Параметры));
	Содержимое.Добавить(СписокПодписок(Параметры.Объект, Бланк, МожноМенять, Отклонённая, ПравкаИд));
	Содержимое.Добавить(Заведение(Бланк, Тип, МожноМенять, ОтказЗаведения(Отклонённая, ПравкаИд)));

	Основная = РендерерНастроек.Секция(Тексты.Текст("subscriptions.section.title"),
		Параметры.Пояснение, Содержимое.Рендер());
	Основная.Иконка = "стрелка";

	Результат = Новый Массив();
	Результат.Добавить(Основная);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СписокПодписок

// Секрет показывается ровно один раз — сразу после создания подписки.
Функция ПоказСекрета(Знач Параметры)

	Секрет = "";
	Если Параметры.Свойство("НовыйСекрет") Тогда
		Секрет = Строка(Параметры.НовыйСекрет);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Секрет) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.БлокКоманды(Секрет);

КонецФункции

// Карточка с отклонённой правкой открыта: иначе причина отказа висит над свёрнутым списком.
Функция СписокПодписок(Знач Объект, Знач Бланк, Знач МожноМенять,
	Знач Отклонённая, Знач ПравкаИд)

	Подписки = СервисПодписок.Список(Объект);
	Если Подписки.Количество() = 0 Тогда
		Возврат Кит.Примечание(Тексты.Текст("subscriptions.list.empty"));
	КонецЕсли;

	Список = Кит.Холст();
	Для Каждого Подписка Из Подписки Цикл
		Правится = (Идентификатор(Подписка) = ПравкаИд);
		Список.Добавить(КарточкаПодписки(Подписка, Бланк, МожноМенять,
			?(Правится, Отклонённая, Неопределено), Правится));
	КонецЦикла;
	Список.Добавить(Кит.Примечание(Тексты.Текст("subscriptions.list.note")));

	Возврат Список;

КонецФункции

// Отбитая правка приезжает раскрытой: человек видит своё поле с отказом, а не свёрнутую строку.
Функция КарточкаПодписки(Знач Подписка, Знач Бланк, Знач МожноМенять,
	Знач Отклонённая, Знач Правится)

	Карточка = Кит.Раскрывашка();
	Если Правится Тогда
		Карточка.Открыть();
	КонецЕсли;

	Карточка.Шапка().Добавить(ШапкаКарточки(Подписка));
	Карточка.Добавить(ТелоКарточки(Подписка, БланкПодписки(Бланк, Подписка),
		МожноМенять, Отклонённая));
	Возврат Карточка;

КонецФункции

Функция ШапкаКарточки(Знач Подписка)

	Шапка = Кит.Холст();
	Шапка.Добавить(ПлашкиТипа(Подписка));
	Шапка.Добавить(АдресДоставки(Подписка));
	Шапка.Добавить(ПлашкиСобытий(Подписка));
	Шапка.Добавить(ПлашкаСостояния(Подписка));
	Возврат Шапка;

КонецФункции

Функция ТелоКарточки(Знач Подписка, Знач Бланк, Знач МожноМенять, Знач Отклонённая)

	Если НЕ МожноМенять Тогда
		Возврат Кит.Примечание(Тексты.Текст("subscriptions.readonly.note"));
	КонецЕсли;

	Тело = Кит.Холст();
	Тело.Добавить(ФормаПравки(Подписка, Бланк, Отклонённая));
	Тело.Добавить(КнопкаПробы(Бланк, Подписка));
	Тело.Добавить(КнопкаПереключения(Бланк, Подписка));
	Тело.Добавить(КнопкаУдаления(Бланк));
	Возврат Тело;

КонецФункции

#КонецОбласти

#Область ШапкаПодписки

// Подписью из декларации обработчика; свой токен и шаблон видны только признаком.
Функция ПлашкиТипа(Знач Подписка)

	Тип = СервисПодписок.ТипДействияПодписки(Подписка);
	Плашки = Новый Массив();
	Плашки.Добавить(Новый Структура("Текст", ТипыДействий.ПодписьТипа(Тип)));

	Если ЗначениеЗаполнено(Строка(Подписка.ТокенДействия)) Тогда
		Плашки.Добавить(Новый Структура("Текст",
			Тексты.Текст("subscriptions.list.tag.own-bot")));
	КонецЕсли;
	Если ЗначениеЗаполнено(Строка(Подписка.ШаблонТекста)) Тогда
		Плашки.Добавить(Новый Структура("Текст",
			Тексты.Текст("subscriptions.list.tag.own-text")));
	КонецЕсли;

	Возврат Кит.РядПлашек(Плашки);

КонецФункции

Функция АдресДоставки(Знач Подписка)

	Название = Кит.Надпись("название");
	Название.Добавить(Кит.Код(Строка(Подписка.URL)));
	Возврат Название;

КонецФункции

Функция ПлашкиСобытий(Знач Подписка)

	Плашки = Новый Массив();
	Для Каждого Тип Из СтрРазделить(Строка(Подписка.ТипыСобытий), ",") Цикл
		Норм = СокрЛП(Тип);
		Если ЗначениеЗаполнено(Норм) Тогда
			Плашки.Добавить(Новый Структура("Текст", ПодписьТипа(Норм)));
		КонецЕсли;
	КонецЦикла;

	Если Плашки.Количество() = 0 Тогда
		Возврат Кит.Текст(Тексты.Текст("subscriptions.events.none"));
	КонецЕсли;

	Возврат Кит.РядПлашек(Плашки);

КонецФункции

Функция ПлашкаСостояния(Знач Подписка)

	Включён = (Подписка.Активен = Истина);
	Возврат Кит.Плашка(Новый Структура("Текст, Вид",
		?(Включён, Тексты.Текст("subscriptions.state.on"), Тексты.Текст("subscriptions.state.off")),
		?(Включён, "ok", "warn")));

КонецФункции

#КонецОбласти

#Область ФормаПравки

// Тип не меняется: форма говорит об этом словами, а сервер отбивает подмену типа в теле.
Функция ФормаПравки(Знач Подписка, Знач Бланк, Знач Отклонённая)

	Тип = СервисПодписок.ТипДействияПодписки(Подписка);
	Если НЕ СервисПодписок.МожноПравить(Подписка) Тогда
		Возврат Кит.Примечание(Тексты.Текст("subscriptions.edit.unsupported"));
	КонецЕсли;

	Правка = Бланки.Форма(Бланк, "save", "столбик");

	Правка.Добавить(ПоляДействия.Правки(Тип,
		ЗначенияФормы(СервисПодписок.ЗначенияПравки(Подписка), Отклонённая, Тип)));
	Правка.Добавить(НаборСобытий(Подписка, Отклонённая));
	Правка.Добавить(ФлажокВключённости(Подписка));
	Правка.Добавить(Кит.Примечание(Тексты.Текст("subscriptions.edit.type.locked")));
	Правка.Добавить(КнопкаФормы(Тексты.Текст("subscriptions.button.save"), "основная", "обычный"));

	Возврат Правка;

КонецФункции

Функция ФлажокВключённости(Знач Подписка)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Отмечено",
		Имена.ИмяПоляВключить(), Тексты.Текст("subscriptions.edit.active"),
		"флажок", Имена.ЗначениеОтмечено(), Подписка.Активен = Истина));

КонецФункции

// У заведения отмечены все, у правки — набор подписки, после отказа — присланное.
Функция НаборСобытий(Знач Подписка = Неопределено, Знач Отклонённая = Неопределено)

	Отмеченные = Новый Соответствие();
	Если Подписка <> Неопределено Тогда
		Для Каждого Элемент Из СтрРазделить(Строка(Подписка.ТипыСобытий), ",") Цикл
			Отмеченные.Вставить(НРег(СокрЛП(Элемент)), Истина);
		КонецЦикла;
	КонецЕсли;

	Набор = Кит.Группа(Тексты.Текст("subscriptions.form.events.legend"));
	Известные = СервисПодписок.ИзвестныеТипы();
	Для Индекс = 0 По Известные.Количество() - 1 Цикл
		ТипСобытия = Известные[Индекс];
		Набор.Добавить(ФлажокСобытия(Индекс, ТипСобытия,
			ОтмеченоЛи(Индекс, ТипСобытия, Отмеченные, Подписка, Отклонённая)));
		Набор.Добавить(ПолеПараметра(Индекс, ТипСобытия, Подписка, Отклонённая));
	КонецЦикла;
	Возврат Набор;

КонецФункции

Функция ОтмеченоЛи(Знач Индекс, Знач ТипСобытия, Знач Отмеченные, Знач Подписка, Знач Отклонённая)

	Если Отклонённая <> Неопределено Тогда
		Возврат РазборФормы.Флажок(Отклонённая, Имена.ИмяПоляСобытия(Индекс),
			Имена.ЗначениеОтмечено());
	ИначеЕсли Подписка = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат (Отмеченные.Получить(НРег(СокрЛП(Строка(ТипСобытия)))) = Истина);

КонецФункции

Функция ФлажокСобытия(Знач Индекс, Знач ТипСобытия, Знач Отмечен)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Отмечено, Подсказка",
		Имена.ИмяПоляСобытия(Индекс), ПодписьТипа(ТипСобытия), "флажок",
		Имена.ЗначениеОтмечено(), Отмечен, КогдаВозникает(ТипСобытия)));

КонецФункции

// Значение после отказа берётся из формы, иначе из подписки, иначе из умолчания каталога.
Функция ПолеПараметра(Знач Индекс, Знач ТипСобытия, Знач Подписка, Знач Отклонённая)

	Описание = СобытияХаба.ПараметрПодписки(ТипСобытия);
	Если Описание = Неопределено Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Если Отклонённая <> Неопределено Тогда
		Значение = РазборФормы.Поле(Отклонённая, Имена.ИмяПоляПараметраСобытия(Индекс), "");
	ИначеЕсли Подписка = Неопределено Тогда
		Значение = "";
	Иначе
		Значение = Строка(ПараметрыСобытий.Значение(Подписка, ТипСобытия));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Значение = Формат(Описание.ПоУмолчанию, "ЧГ=0; ЧН=0");
	КонецЕсли;

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Подсказка",
		Имена.ИмяПоляПараметраСобытия(Индекс),
		Тексты.Текст("subscriptions.form.threshold.label"), "число", Значение,
		Тексты.Текст("subscriptions.form.threshold.hint")));

КонецФункции

// Секретов ни в сохранённом, ни в присланном наборе нет: в разметку они не возвращаются.
Функция ЗначенияФормы(Знач Сохранённые, Знач Отклонённая, Знач Тип)

	Если Отклонённая = Неопределено Тогда
		Возврат Сохранённые;
	КонецЕсли;

	Результат = Новый Структура();
	Для Каждого КиЗ Из Сохранённые Цикл
		Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Для Каждого ОписаниеПоля Из ТипыДействий.ПоляТипа(Тип) Цикл
		Если ТипыДействий.Секретное(ОписаниеПоля) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(ОписаниеПоля.Имя, РазборФормы.Поле(Отклонённая, ОписаниеПоля.ИмяПоля));
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область КнопкиПодписки

Функция КнопкаПереключения(Знач Бланк, Знач Подписка)

	Включён = (Подписка.Активен = Истина);

	Форма = Бланки.Форма(Бланк, "toggle");
	Форма.Добавить(Кит.СкрытоеПоле(Имена.ИмяПоляВключить(), ?(Включён, "0", "1")));
	Форма.Добавить(КнопкаФормы(?(Включён, Тексты.Текст("subscriptions.button.disable"),
		Тексты.Текст("subscriptions.button.enable"))));
	Возврат Форма;

КонецФункции

// Проба ходит СОХРАНЁННЫМИ настройками: она проверяет то, что будет работать в бою.
Функция КнопкаПробы(Знач Бланк, Знач Подписка)

	Если НЕ СервисПодписок.МожноПробовать(Подписка) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Бланки.КнопкаДействия(Бланк, "test", Тексты.Текст("subscriptions.button.test"));

КонецФункции

Функция КнопкаУдаления(Знач Бланк)

	Возврат Бланки.КнопкаДействия(Бланк, "delete",
		Тексты.Текст("subscriptions.button.delete"), "опасная");

КонецФункции

#КонецОбласти

#Область Заведение

// У распорядителя — выбор типа и форма, у зрителя — пояснение, почему форм нет.
Функция Заведение(Знач Бланк, Знач Тип, Знач МожноМенять, Знач Отклонённая)

	Если НЕ МожноМенять Тогда
		Возврат Кит.Примечание(Тексты.Текст("subscriptions.readonly.note"));
	КонецЕсли;

	Блок = Кит.Холст();
	Блок.Добавить(ПереключательТипа(Бланк, Тип));
	Блок.Добавить(ФормаЗаведения(Бланк, Тип, Отклонённая));
	Возврат Блок;

КонецФункции

// Ссылки, а не форма: у каждого набора полей свой адрес, и страница живёт без JS.
Функция ПереключательТипа(Знач Бланк, Знач Тип)

	Выбор = Кит.Холст();
	Выбор.Добавить(ЗаголовокЗаведения());

	Типы = ТипыДействий.Типы();
	Если Типы.Количество() < 2 Тогда
		Возврат Выбор; // выбирать не из чего — переключатель был бы декорацией
	КонецЕсли;

	Ряд = Выбор.Добавить(Кит.Ряд("выбор"));
	Для Каждого Вариант Из Типы Цикл
		Ряд.Добавить(КнопкаТипа(Бланк, Вариант, Тип));
	КонецЦикла;

	Выбор.Добавить(Кит.Примечание(Тексты.Текст("subscriptions.form.type.hint")));
	Возврат Выбор;

КонецФункции

Функция ЗаголовокЗаведения()

	Заголовок = Кит.Заголовок(3);
	Заголовок.Добавить(Кит.Текст(Тексты.Текст("subscriptions.form.title")));
	Возврат Заголовок;

КонецФункции

Функция КнопкаТипа(Знач Бланк, Знач Вариант, Знач Тип)

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант",
		Вариант.Подпись,
		Бланки.Адрес(Бланк) + "?" + Имена.ИмяПараметраТипа() + "="
			+ КодированиеЗначения(Вариант.Тип),
		?(Вариант.Тип = Тип, "основная", "вторичная")));

КонецФункции

// Форма заведения: настройки действия — из деклараций обработчиков (КаталогДействийПодписки).
Функция ФормаЗаведения(Знач Бланк, Знач Тип, Знач Отклонённая)

	Форма = Бланки.Форма(Бланк, "", "столбик");

	Форма.Добавить(ПоляДействия.Заведения(Тип, Отклонённая));
	Форма.Добавить(НаборСобытий(Неопределено, Отклонённая));
	Форма.Добавить(КнопкаФормы(Тексты.Текст("subscriptions.button.create"),
		"основная", "обычный"));

	Возврат Форма;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КнопкаФормы(Знач Подпись, Знач Вариант = "вторичная", Знач Размер = "малый")
	Возврат Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер", Подпись, Вариант, Размер));
КонецФункции

// Человеческое имя типа из перечня.
Функция ПодписьТипа(Знач Тип)

	Запись = СобытияХаба.Запись(Тип);
	Возврат ?(Запись = Неопределено, Тип, Запись.Подпись);

КонецФункции

// Подсказкой у самого флажка: отдельная таблица предлагала бы то, на что подписаться нельзя.
Функция КогдаВозникает(Знач Тип)

	Запись = СобытияХаба.Запись(Тип);
	Возврат ?(Запись = Неопределено, Тип, Строка(Запись.Пояснение));

КонецФункции

// Формы одной подписки постят на её собственный адрес внутри раздела.
Функция БланкПодписки(Знач Бланк, Знач Подписка)
	Возврат Бланки.Вложенный(Бланк, Идентификатор(Подписка));
КонецФункции

Функция Идентификатор(Знач Подписка)
	Возврат Формат(Подписка.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

// Отбили форму правки — форма заведения остаётся чистой: отказ показывается в карточке.
Функция ОтказЗаведения(Знач Отклонённая, Знач ПравкаИд)
	Возврат ?(ЗначениеЗаполнено(ПравкаИд) И ПравкаИд <> "0", Неопределено, Отклонённая);
КонецФункции

// Тип из параметров раздела: его отсутствие — обычное «зашли по прямой ссылке».
Функция ЗапрошенныйТип(Знач Параметры)
	Значение = Неопределено;
	Если НЕ Параметры.Свойство("Тип", Значение) ИЛИ Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

// Отклонённая форма приходит только со страницы отказа; на обычной её нет.
Функция ОтклонённаяФорма(Знач Параметры)
	Значение = Неопределено;
	Если НЕ Параметры.Свойство("Форма", Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ?(ТипЗнч(Значение) = Тип("Соответствие"), Значение, Неопределено);
КонецФункции

// Подписка, чью форму правки отбили: «0» означает, что отбили форму заведения.
Функция ИдПравимой(Знач Параметры)
	Значение = Неопределено;
	Параметры.Свойство("ПравкаИд", Значение);
	Возврат СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
КонецФункции

Функция КодированиеЗначения(Знач Значение)
	Возврат КодироватьСтроку(Строка(Значение), СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти

&Прозвище("ВитринаПодписок")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "КаталогСобытий") _СобытияХаба,
	&Пластилин(Значение = "ПараметрыПодписки") _ПараметрыСобытий,
	&Пластилин(Значение = "КаталогДействийПодписки") _ТипыДействий,
	&Пластилин(Значение = "ПоляПодписки") _ПоляДействия,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "БланкРаздела") _Бланки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "РазборФормы") _РазборФормы) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	СервисПодписок = _СервисПодписок;
	СобытияХаба = _СобытияХаба;
	ПараметрыСобытий = _ПараметрыСобытий;
	ТипыДействий = _ТипыДействий;
	ПоляДействия = _ПоляДействия;
	Имена = _Имена;
	Бланки = _Бланки;
	Тексты = _Тексты;
	РазборФормы = _РазборФормы;

КонецПроцедуры
