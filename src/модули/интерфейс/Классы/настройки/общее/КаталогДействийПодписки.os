// Каталог типов действий подписки — желудь модуля web-ui: типы, у которых обработчик
// заявил форму настроек. Контракт рендера и имена его полей проверяются на сборке желудя:
// плагин, нарушивший контракт, роняет старт хаба, а не отдельный экран.

Перем Реестр;  // РеестрДействийПодписок (подписки) — рендеры настроек по типам
Перем Тексты;  // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Имена;   // ИменаПолейПодписки (web-ui) — имена, которыми распоряжается сам раздел

Перем Описания;  // Массив из Структура - {Тип, Рендер, Поля, Подпись, Пояснение}
Перем ПоТипу;    // Соответствие: ключ типа -> описание

#Область ПубличныйИнтерфейс

// Заявил ли форму настроек хоть один тип.
//
// Возвращаемое значение:
//  Булево.
//
Функция Пусто() Экспорт
	Возврат Описания.Количество() = 0;
КонецФункции

// Типы действий, у которых есть форма настроек, в порядке показа.
//
// Возвращаемое значение:
//  Массив - структуры {Тип - Строка; Подпись - Строка}.
//
Функция Типы() Экспорт

	Результат = Новый Массив();
	Для Каждого Описание Из Описания Цикл
		Результат.Добавить(Новый Структура("Тип, Подпись", Описание.Тип, Описание.Подпись));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Человеческая подпись типа действия.
//
// Параметры:
//  Тип - Строка - тип.
//
// Возвращаемое значение:
//  Строка - подпись из словаря; сам тип, если он каталогу неизвестен.
//
Функция ПодписьТипа(Знач Тип) Экспорт

	Описание = Описание(Тип);
	Возврат ?(Описание = Неопределено, Строка(Тип), Описание.Подпись);

КонецФункции

// Тип, поля которого показывает форма: заданный, если он известен, иначе первый.
//
// Параметры:
//  Значение - Строка - тип из адреса или формы; пустой и неизвестный дают первый тип.
//
// Возвращаемое значение:
//  Строка - тип действия; пустая строка, если ни один тип формы не заявил.
//
Функция ВыбранныйТип(Знач Значение) Экспорт

	Если Пусто() Тогда
		Возврат "";
	КонецЕсли;
	Описание = Описание(Значение);
	Возврат ?(Описание = Неопределено, Описания[0].Тип, Описание.Тип);

КонецФункции

// Поля типа по декларации его рендера настроек.
//
// Параметры:
//  Тип - Строка - тип действия.
//
// Возвращаемое значение:
//  Массив - описания полей; пустой, если тип формы настроек не заявил.
//
Функция ПоляТипа(Знач Тип) Экспорт

	Описание = Описание(Тип);
	Возврат ?(Описание = Неопределено, Новый Массив(), Описание.Поля);

КонецФункции

// Описание типа целиком.
//
// Параметры:
//  Тип - Строка - тип действия.
//
// Возвращаемое значение:
//  Структура, Неопределено - {Тип, Рендер, Поля, Подпись, Пояснение}; Неопределено —
//                            тип каталогу неизвестен.
//
Функция Описание(Знач Тип) Экспорт
	Возврат ПоТипу.Получить(КлючТипа(Тип));
КонецФункции

// Все описания в порядке показа.
//
// Возвращаемое значение:
//  Массив - структуры {Тип, Рендер, Поля, Подпись, Пояснение}.
//
Функция Все() Экспорт
	Возврат Описания;
КонецФункции

// Тип действия в сравнимом виде: регистр и пробелы значения не несут.
//
// Параметры:
//  Тип - Строка - тип действия.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючТипа(Знач Тип) Экспорт
	Возврат НРег(СокрЛП(Строка(Тип)));
КонецФункции

// Секретное ли поле по декларации обработчика: признак необязателен, сторонний тип
// мог его не объявить.
//
// Параметры:
//  ОписаниеПоля - Структура - описание поля из ОписаниеПолей() рендера.
//
// Возвращаемое значение:
//  Булево.
//
Функция Секретное(Знач ОписаниеПоля) Экспорт

	Значение = Неопределено;
	Возврат ОписаниеПоля.Свойство("Секретное", Значение) И Значение = Истина;

КонецФункции

// Объявленный ключ подписи флажка и означает «сброс возможен»: у telegram стирать
// токен не во что.
//
// Параметры:
//  ОписаниеПоля - Структура - описание поля из ОписаниеПолей() рендера.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьСбросСекрета(Знач ОписаниеПоля) Экспорт

	КлючТекста = Неопределено;
	Возврат ОписаниеПоля.Свойство("КлючСвоего", КлючТекста) И ЗначениеЗаполнено(КлючТекста);

КонецФункции

#КонецОбласти

#Область СборкаОписаний

// Описания типов с рендером в стабильном порядке (по имени типа): реестр порядка не даёт.
Функция СобратьОписания()

	Результат = Новый Массив();
	Занятые = Новый Соответствие();

	Для Каждого Тип Из ПоАлфавиту(Реестр.Типы()) Цикл
		Рендер = Реестр.РендерНастроек(Тип);
		Если Рендер = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПодписиКонтракта = ТекстыКонтракта(Тип, Рендер);
		Поля = Рендер.ОписаниеПолей();
		ПроверитьПоля(Тип, Поля, Занятые);
		Результат.Добавить(Новый Структура("Тип, Рендер, Поля, Подпись, Пояснение",
			Тип, Рендер, Поля, ПодписиКонтракта.Подпись, ПодписиКонтракта.Пояснение));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Полнота контракта рендера проверяется на сборке желудя.
Функция ТекстыКонтракта(Знач Тип, Знач Рендер)

	Попытка
		Подпись = Тексты.Текст(Рендер.КлючПодписи());
		КлючПояснения = Рендер.КлючПояснения();
		Пояснение = ?(ЗначениеЗаполнено(КлючПояснения), Тексты.Текст(КлючПояснения), "");
	Исключение
		ВызватьИсключение СтрШаблон(
			"Форма действия подписки: рендер настроек типа «%1» не выполняет контракт"
			+ " «РендерНастроекПодписки» (нужны ТипДействия(), ОписаниеПолей(),"
			+ " КлючПодписи(), КлючПояснения()): %2", Тип, ОписаниеОшибки());
	КонецПопытки;

	Возврат Новый Структура("Подпись, Пояснение", Подпись, Пояснение);

КонецФункции

// Сторож имён полей.
Процедура ПроверитьПоля(Знач Тип, Знач Поля, Занятые)

	Для Каждого ОписаниеПоля Из Поля Цикл

		Имя = Имена.Ключ(ОписаниеПоля.ИмяПоля);
		Если НЕ ЗначениеЗаполнено(Имя) Тогда
			ВызватьИсключение СтрШаблон(
				"Форма действия подписки: у типа «%1» поле «%2» без имени поля формы",
				Тип, ОписаниеПоля.Имя);
		КонецЕсли;

		Если Имена.Служебное(Имя) Тогда
			ВызватьИсключение СтрШаблон(
				"Форма действия подписки: тип «%1» занял служебное имя поля «%2»", Тип, Имя);
		КонецЕсли;

		ЗанятьИмя(Занятые, Имя, Тип);

		// у сбрасываемого секрета форма правки заводит парный флажок — его имя занято тоже
		Если ЕстьСбросСекрета(ОписаниеПоля) Тогда
			ЗанятьИмя(Занятые, Имена.Ключ(Имена.ИмяПоляСвоегоСекрета(Имя)), Тип);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ЗанятьИмя(Занятые, Знач Имя, Знач Тип)

	Владелец = Занятые.Получить(Имя);
	Если Владелец <> Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"Форма действия подписки: имя поля «%1» объявлено дважды (типы «%2» и «%3»)",
			Имя, Владелец, Тип);
	КонецЕсли;

	Занятые.Вставить(Имя, Тип);

КонецПроцедуры

// Порядок показа типов задаёт этот каталог: реестр отдаёт их в порядке регистрации.
Функция ПоАлфавиту(Знач Значения)

	Список = Новый СписокЗначений();
	Для Каждого Значение Из Значения Цикл
		Список.Добавить(Строка(Значение));
	КонецЦикла;
	Список.СортироватьПоЗначению();

	Результат = Новый Массив();
	Для Каждого Элемент Из Список Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Прозвище("КаталогДействийПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РеестрДействийПодписок") _Реестр,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена) Экспорт

	Реестр = _Реестр;
	Тексты = _Тексты;
	Имена = _Имена;

	Описания = СобратьОписания();

	ПоТипу = Новый Соответствие();
	Для Каждого Описание Из Описания Цикл
		ПоТипу.Вставить(КлючТипа(Описание.Тип), Описание);
	КонецЦикла;

КонецПроцедуры
