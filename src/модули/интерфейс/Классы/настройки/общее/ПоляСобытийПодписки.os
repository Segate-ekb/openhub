// Блок событий формы подписки — желудь модуля web-ui: флажок «на что подписаться» и поле
// его порога, по одной паре на тип события. Пара связана ИНДЕКСОМ в перечне известных типов,
// и связку эту читает обратно РазборФормыПодписки — поэтому печать пары живёт в одном месте,
// а не разбросана по витрине. Что за типы бывают и что объявил каждый — знает КаталогСобытий.

Перем Кит;              // Кит (кит) — фабрика элементов экрана
Перем СервисПодписок;   // СервисПодписок (подписки) — перечень известных типов
Перем СобытияХаба;      // КаталогСобытий (события) — подпись, пояснение и параметр типа
Перем ПараметрыСобытий; // ПараметрыПодписки (подписки) — значение параметра у подписки
Перем Имена;            // ИменаПолейПодписки (web-ui) — имена полей раздела
Перем РазборФормы;      // РазборФормы (web-ui) — чтение отклонённой формы
Перем Тексты;           // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Блок флажков событий с полями их порогов. У заведения отмечены все, у правки — набор
// подписки, после отказа — присланное.
//
// Параметры:
//  Подписка - Вебхук, Неопределено - правимая подписка; Неопределено — форма заведения.
//  Отклонённая - Соответствие, Неопределено - отбитая форма, в которую возвращается ввод.
//
// Возвращаемое значение:
//  Произвольный - узел разметки.
//
Функция Набор(Знач Подписка = Неопределено, Знач Отклонённая = Неопределено) Экспорт

	Отмеченные = ОтмеченныеПодписки(Подписка);

	Набор = Кит.Группа(Тексты.Текст("subscriptions.form.events.legend"));
	Известные = СервисПодписок.ИзвестныеТипы();
	Для Индекс = 0 По Известные.Количество() - 1 Цикл
		ТипСобытия = Известные[Индекс];
		Набор.Добавить(Флажок(Индекс, ТипСобытия,
			ОтмеченоЛи(Индекс, ТипСобытия, Отмеченные, Подписка, Отклонённая)));
		Набор.Добавить(ПолеПорога(Индекс, ТипСобытия, Подписка, Отклонённая));
	КонецЦикла;

	Возврат Набор;

КонецФункции

// Человеческое имя типа события из перечня.
//
// Параметры:
//  Тип - Строка - машинный тип события.
//
// Возвращаемое значение:
//  Строка - подпись типа; неизвестный тип называет себя сам.
//
Функция ПодписьТипа(Знач Тип) Экспорт
	Запись = СобытияХаба.Запись(Тип);
	Возврат ?(Запись = Неопределено, Тип, Запись.Подпись);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подсказкой у самого флажка: отдельная таблица предлагала бы то, на что подписаться нельзя.
Функция КогдаВозникает(Знач Тип)
	Запись = СобытияХаба.Запись(Тип);
	Возврат ?(Запись = Неопределено, Тип, Строка(Запись.Пояснение));
КонецФункции

Функция ОтмеченныеПодписки(Знач Подписка)

	Результат = Новый Соответствие();
	Если Подписка = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Элемент Из СтрРазделить(Строка(Подписка.ТипыСобытий), ",") Цикл
		Результат.Вставить(НРег(СокрЛП(Элемент)), Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОтмеченоЛи(Знач Индекс, Знач ТипСобытия, Знач Отмеченные, Знач Подписка, Знач Отклонённая)

	Если Отклонённая <> Неопределено Тогда
		Возврат РазборФормы.Флажок(Отклонённая, Имена.ИмяПоляСобытия(Индекс),
			Имена.ЗначениеОтмечено());
	ИначеЕсли Подписка = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат (Отмеченные.Получить(НРег(СокрЛП(Строка(ТипСобытия)))) = Истина);

КонецФункции

Функция Флажок(Знач Индекс, Знач ТипСобытия, Знач Отмечен)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Отмечено, Подсказка",
		Имена.ИмяПоляСобытия(Индекс), ПодписьТипа(ТипСобытия), "флажок",
		Имена.ЗначениеОтмечено(), Отмечен, КогдаВозникает(ТипСобытия)));

КонецФункции

// Значение после отказа берётся из формы, иначе из подписки, иначе из умолчания каталога.
Функция ПолеПорога(Знач Индекс, Знач ТипСобытия, Знач Подписка, Знач Отклонённая)

	Описание = СобытияХаба.ПараметрПодписки(ТипСобытия);
	Если Описание = Неопределено Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Если Отклонённая <> Неопределено Тогда
		Значение = РазборФормы.Поле(Отклонённая, Имена.ИмяПоляПараметраСобытия(Индекс), "");
	ИначеЕсли Подписка = Неопределено Тогда
		Значение = "";
	Иначе
		Значение = Строка(ПараметрыСобытий.Значение(Подписка, ТипСобытия));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Значение = Формат(Описание.ПоУмолчанию, "ЧГ=0; ЧН=0");
	КонецЕсли;

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Подсказка",
		Имена.ИмяПоляПараметраСобытия(Индекс),
		Тексты.Текст("subscriptions.form.threshold.label"), "число", Значение,
		Тексты.Текст("subscriptions.form.threshold.hint")));

КонецФункции

#КонецОбласти

&Прозвище("ПоляСобытийПодписки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисПодписок") _СервисПодписок,
	&Пластилин(Значение = "КаталогСобытий") _СобытияХаба,
	&Пластилин(Значение = "ПараметрыПодписки") _ПараметрыСобытий,
	&Пластилин(Значение = "ИменаПолейПодписки") _Имена,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	СервисПодписок = _СервисПодписок;
	СобытияХаба = _СобытияХаба;
	ПараметрыСобытий = _ПараметрыСобытий;
	Имена = _Имена;
	РазборФормы = _РазборФормы;
	Тексты = _Тексты;

КонецПроцедуры
