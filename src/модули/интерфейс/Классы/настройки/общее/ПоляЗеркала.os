// Поля зеркала, общие экранам зеркал — разделу «Зеркала» дома «Пул», обзору зеркал кабинета
// и экрану состояния: флажок переноса на форме заведения и протокол источника словами.

Перем Кит;     // Кит (кит) — фабрика элементов экрана
Перем Тексты;  // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Канон;   // РазборНастроекЗеркала (зеркала) — имена протоколов источника

#Область ПубличныйИнтерфейс

// Флажок «перенести пакеты из другого хаба» вместе со своим примечанием. Признак задаётся
// только при заведении, поэтому у заведённого зеркала этого поля нет ни на одном экране.
//
// Параметры:
//  Предвыбран - Булево - отметить флажок заранее: с таким решением человек приходит
//               со страницы пустого пула (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  ЭлементЭкрана - флажок и примечание под ним.
//
Функция ФлажокПереноса(Знач Предвыбран = Ложь) Экспорт

	// подсказка флажка печатается в одном ряду с подписью, поэтому в ней одна короткая
	// строка, а следствия переезда уходят примечанием ПОД поле — там ширина целая
	Результат = Кит.Холст();
	Результат.Добавить(Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Отмечено, Подсказка",
		"перенос", Тексты.Текст("settings.pool.mirror-new.migrate.label"), "флажок", "1",
		Предвыбран = Истина, Тексты.Текст("settings.pool.mirror-new.migrate.hint"))));
	Результат.Добавить(Кит.Примечание(Тексты.Текст("settings.pool.mirror-new.migrate.note")));
	Возврат Результат;

КонецФункции

// Ячейка «Протокол» строки списка зеркал: чем хаб читает источник, а у переносящего зеркала
// ещё и слово о переносе — два зеркала одного протокола делают с пулом разное.
//
// Параметры:
//  Протокол - Строка - протокол источника; пустая строка — удачной пробы ещё не было.
//  Перенос - Булево - зеркало переноса (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  ЭлементЭкрана - ячейка строки.
//
Функция ЯчейкаПротокола(Знач Протокол, Знач Перенос = Ложь) Экспорт

	Результат = Кит.Ячейка();
	Результат.Добавить(Кит.Текст(ПротоколСловами(Протокол)));
	Если Перенос = Истина Тогда
		Результат.Добавить(Кит.Плашка(Новый Структура("Текст, Вид",
			Тексты.Текст("settings.pool.mirrors.protocol.migrate"), "ok")));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Протокол источника словами человека. Выбора протокола у человека нет, поэтому и слова
// описывают наблюдение: чем хаб прочитал источник на последнем удачном обходе.
//
// Параметры:
//  Протокол - Строка - протокол источника; пустая строка — удачной пробы ещё не было.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПротоколСловами(Знач Протокол) Экспорт

	// имена протоколов спрашиваются у канона домена: своих кодов у экрана нет, и заведись
	// в каноне третий протокол — сторож покажет, что слова для него не хватает
	Канонный = Канон.Протокол(Протокол);
	Если Канонный = Канон.ПротоколOpenHub() Тогда
		Возврат Тексты.Текст("settings.pool.mirrors.protocol.openhub");
	ИначеЕсли Канонный = Канон.ПротоколЛегаси() Тогда
		Возврат Тексты.Текст("settings.pool.mirrors.protocol.legacy");
	КонецЕсли;
	Возврат Тексты.Текст("settings.pool.mirrors.protocol.unknown");

КонецФункции

#КонецОбласти

&Прозвище("ПоляЗеркала")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "РазборНастроекЗеркала") _Канон) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	Канон = _Канон;

КонецПроцедуры
