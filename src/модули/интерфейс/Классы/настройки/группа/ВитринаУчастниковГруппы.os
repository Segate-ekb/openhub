// Витрина участников группы — желудь модуля web-ui: раздел «Участники» дома «Группа».
// Состав группы и подбор новых участников из списка учётных записей с отбором по подстроке.

Перем Кит;                  // Кит (кит) — фабрика элементов экрана
Перем Ячейки;               // ЯчейкиТаблицы (web-ui) — заготовки ячеек таблиц
Перем РендерерНастроек;     // РендерерНастроек (кит) — описание секции
Перем СервисГрупп;          // СервисГрупп (auth) — состав группы
Перем СервисПользователей;  // СервисПользователей (auth) — логин по идентификатору
Перем СервисСопоставлений;  // СервисСопоставленийГрупп (auth) — время сверки с клеймами
Перем ХранилищеПользователей; // ХранилищеПользователей (данные) — учётные записи хаба
Перем Отбор;                // ПоискПоКоллекции (поиск) — общий отбор коллекций в памяти
Перем Тексты;               // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Бланки;            // БланкРаздела (web-ui) — адрес и токен раздела, формы на них
Перем Даты;  // ДатаЧеловеку (web-ui) — одно написание момента на весь интерфейс
Перем Примечания;  // ПримечанияЭкрана (web-ui) — вид «показывать нечего»

#Область ПубличныйИнтерфейс

// Секции раздела «участники» группы.
//
// Параметры:
//  Параметры - Структура:
//    * Группа - Группа - группа;
//    * Адрес - Строка - адрес раздела (он же action форм);
//    * Токен - Строка - CSRF-токен сессии;
//    * МожетПравить - Булево - вправе ли смотрящий менять состав;
//    * Запрос - Строка - подстрока отбора кандидатов.
//
// Возвращаемое значение:
//  Массив - описания секций для РендерерНастроек.
//
Функция Секции(Знач Параметры) Экспорт

	Группа = Параметры.Группа;
	Бланк = Бланки.Раздела(Параметры);
	МожетПравить = (Параметры.МожетПравить = Истина);
	Запрос = СокрЛП(Строка(Параметры.Запрос));

	Состав = СервисГрупп.СоставГруппы(Группа.Идентификатор);

	Результат = Новый Массив();
	Результат.Добавить(СекцияСостава(Состав, Группа, Бланк, МожетПравить));
	Если МожетПравить Тогда
		Результат.Добавить(СекцияПодбора(Состав, Бланк, Запрос));
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Состав

Функция СекцияСостава(Знач Состав, Знач Группа, Знач Бланк, Знач МожетПравить)

	Тело = Кит.Холст();
	Тело.Добавить(ТаблицаСостава(Состав, Бланк, МожетПравить));
	Тело.Добавить(ОговоркаПроИсточник());
	Тело.Добавить(СтрокаПоследнейСверки(Группа));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.group.members.title"),
		Тексты.Текст("settings.group.members.lead"), Тело.Рендер());
	Секция.Иконка = "аккаунт";
	Возврат Секция;

КонецФункции

Функция ТаблицаСостава(Знач Состав, Знач Бланк, Знач МожетПравить)

	Таблица = Кит.Таблица();
	Таблица.Пусто().Добавить(
		Примечания.Пусто(Тексты.Текст("settings.group.members.empty")));

	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.group.members.col.login")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.group.members.col.source")));
	Таблица.Добавить(Кит.Колонка());

	Для Каждого Членство Из Состав Цикл
		Таблица.Добавить(СтрокаУчастника(Членство, Бланк, МожетПравить));
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция СтрокаУчастника(Знач Членство, Знач Бланк, Знач МожетПравить)

	Логин = ЛогинУчастника(Членство);

	СтрокаТаблицы = Кит.Запись();
	СтрокаТаблицы.Добавить(Ячейки.Текстовая(Логин));
	СтрокаТаблицы.Добавить(ИсточникЧленства(Членство.Источник));
	СтрокаТаблицы.Добавить(КнопкаИсключения(Бланк, Логин, МожетПравить));
	Возврат СтрокаТаблицы;

КонецФункции

Функция ЛогинУчастника(Знач Членство)
	Пользователь = СервисПользователей.ПоИдентификатору(Членство.ПользовательИдентификатор);
	Возврат ?(Пользователь = Неопределено,
		"#" + Тексты.ЧислоТекстом(Членство.ПользовательИдентификатор), Пользователь.Логин);
КонецФункции

Функция ИсточникЧленства(Знач Источник)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Плашка(Новый Структура("Текст, Вид",
		Источник, ?(НРег(Строка(Источник)) = "oidc", "accent", ""))));
	Возврат Ячейка;

КонецФункции

Функция КнопкаИсключения(Знач Бланк, Знач Логин, Знач МожетПравить)

	Ячейка = Кит.Ячейка();
	Если НЕ МожетПравить Тогда
		Возврат Ячейка;
	КонецЕсли;

	Форма = Ячейка.Добавить(Бланки.Форма(Бланк));
	Форма.Добавить(Кит.СкрытоеПоле("операция", "удалить"));
	Форма.Добавить(Кит.СкрытоеПоле("логин", Логин));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Тексты.Текст("settings.group.members.button.remove"), "вторичная", "малый")));
	Возврат Ячейка;

КонецФункции

// Членство из клеймов провайдера вручную не снимается: экран говорит об этом именем источника.
Функция ОговоркаПроИсточник()

	Оговорка = Кит.Примечание();
	Оговорка.Добавить(Кит.Шаблон(Тексты.Текст("settings.group.members.note")))
		.Добавить(Кит.Код("oidc"));
	Возврат Оговорка;

КонецФункции

Функция СтрокаПоследнейСверки(Знач Группа)

	Примечание = Кит.Примечание();
	Примечание.Добавить(Кит.Шаблон(Тексты.Текст("settings.group.members.synced")))
		.Добавить(Кит.Текст(ВремяСинхронизации(Группа)));
	Возврат Примечание;

КонецФункции

// Человекочитаемое время последней сверки состава с клеймами.
Функция ВремяСинхронизации(Знач Группа)
	Момент = СервисСопоставлений.СинхронизированаВ(Группа.Идентификатор);
	Возврат ?(Момент = Неопределено, Тексты.Текст("settings.group.policy.never"),
		Даты.ДатаВремя(Момент));
КонецФункции

#КонецОбласти

#Область Подбор

// Список должен оставаться пригодным на сотнях учёток: «показать всё» даёт стену имён.
Функция ПределКандидатов()
	Возврат 20;
КонецФункции

// Подбор без JS: GET-форма кладёт подстроку в адрес, каждая строка — своя POST-форма.
Функция СекцияПодбора(Знач Состав, Знач Бланк, Знач Запрос)

	Кандидаты = Отбор.Отобрать(Свободные(Состав), Запрос, ХранилищеПользователей.ПоляОтбора());
	Показано = Мин(Кандидаты.Количество(), ПределКандидатов());

	Тело = ОбластьОтбора();
	Тело.Добавить(СтрокаПоиска(Бланки.Адрес(Бланк), Запрос));
	Тело.Добавить(ТаблицаКандидатов(Кандидаты, Показано, Бланк, Запрос));
	Тело.Добавить(ОговоркаЧастичногоОтбора());
	Тело.Добавить(ОговоркаПустогоОтбора());
	Тело.Добавить(СтрокаУсечения(Кандидаты.Количество(), Показано));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.group.member-new.title"),
		Тексты.Текст("settings.group.member-new.lead"), Тело.Рендер());
	Секция.Иконка = "плюс";
	// секция без «Действия»: отбор — форма GET, добавление — форма строки
	Возврат Секция;

КонецФункции

// Без скрипта это обычный блок: отбор делает GET-форма, строки приходят отобранными сервером.
Функция ОбластьОтбора()
	Возврат Кит.Область().Признак("filter", ИмяПоляОтбора());
КонецФункции

Функция ТаблицаКандидатов(Знач Кандидаты, Знач Показано, Знач Бланк, Знач Запрос)

	Таблица = Кит.Таблица();
	Таблица.Пусто().Добавить(Примечания.Пусто(ПустаяВыдача(Запрос)));

	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.group.member-new.col.login")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.group.member-new.col.email")));
	Таблица.Добавить(Кит.Колонка());

	Для Позиция = 0 По Показано - 1 Цикл
		Таблица.Добавить(СтрокаКандидата(Кандидаты[Позиция], Бланк, Запрос));
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция СтрокаКандидата(Знач Кандидат, Знач Бланк, Знач Запрос)

	СтрокаТаблицы = Кит.Запись();
	СтрокаТаблицы.Добавить(Ячейки.Текстовая(Строка(Кандидат.Логин)));
	СтрокаТаблицы.Добавить(Ячейки.Текстовая(Строка(Кандидат.Email)));
	СтрокаТаблицы.Добавить(КнопкаДобавления(Бланк, Кандидат.Логин, Запрос));
	Возврат СтрокаТаблицы;

КонецФункции

// Клиентский отбор сужает то, что УЖЕ на странице: без объявления это читалось бы как «пусто».
Функция ОговоркаЧастичногоОтбора()
	Возврат СпрятаннаяОговорка("filter-partial",
		Тексты.Текст("settings.group.member-new.client.partial"));
КонецФункции

Функция ОговоркаПустогоОтбора()
	Возврат СпрятаннаяОговорка("filter-empty",
		Тексты.Текст("settings.group.member-new.client.empty"));
КонецФункции

Функция СпрятаннаяОговорка(Знач ИмяПризнака, Знач Текст)

	Оговорка = Кит.Область().Роль("состояние").Признак(ИмяПризнака, ИмяПоляОтбора()).Скрыть();
	Оговорка.Добавить(Кит.Примечание(Текст));
	Возврат Оговорка;

КонецФункции

Функция ИмяПоляОтбора()
	Возврат "q";
КонецФункции

// Учётные записи, которых в группе ещё нет.
Функция Свободные(Знач Состав)

	ВГруппе = Новый Соответствие();
	Для Каждого Членство Из Состав Цикл
		ВГруппе.Вставить(Цел(Членство.ПользовательИдентификатор), Истина);
	КонецЦикла;

	Результат = Новый Массив();
	Для Каждого Пользователь Из ХранилищеПользователей.Все() Цикл
		Если ВГруппе.Получить(Цел(Пользователь.Идентификатор)) = Неопределено Тогда
			Результат.Добавить(Пользователь);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СтрокаПоиска(Знач Адрес, Знач Запрос)

	Возврат Кит.СтрокаПоиска(Новый Структура(
		"Действие, Имя, Метка, Значение, Плейсхолдер, Кнопка, Иконка",
		Адрес, ИмяПоляОтбора(), Тексты.Текст("settings.group.member-new.filter.label"), Запрос,
		Тексты.Текст("settings.group.member-new.filter.placeholder"),
		Тексты.Текст("settings.group.member-new.filter.button"), "поиск"));

КонецФункции

// Отбор переживает добавление: иначе после каждого участника подбор начинается заново.
Функция КнопкаДобавления(Знач Бланк, Знач Логин, Знач Запрос)

	Ячейка = Кит.Ячейка();
	Форма = Ячейка.Добавить(Бланки.Форма(Бланк));
	Форма.Добавить(Кит.СкрытоеПоле("операция", "добавить"));
	Форма.Добавить(Кит.СкрытоеПоле("логин", Логин));
	Форма.Добавить(Кит.СкрытоеПоле(ИмяПоляОтбора(), Запрос));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Тексты.Текст("settings.group.member-new.button"), "основная", "малый")));
	Возврат Ячейка;

КонецФункции

Функция ПустаяВыдача(Знач Запрос)
	Возврат ?(ЗначениеЗаполнено(Запрос),
		Тексты.Шаблон("settings.group.member-new.notfound", Запрос),
		Тексты.Текст("settings.group.member-new.empty"));
КонецФункции

// Честная строка «показаны не все»: молчаливое усечение выглядит как «таких больше нет».
Функция СтрокаУсечения(Знач Всего, Знач Показано)

	Если Всего <= Показано Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Примечание = Кит.Примечание();
	Фраза = Примечание.Добавить(Кит.Шаблон(Тексты.Текст("settings.group.member-new.truncated")));
	Фраза.Добавить(Кит.Текст(Тексты.ЧислоТекстом(Показано)));
	Фраза.Добавить(Кит.Текст(Тексты.ЧислоТекстом(Всего)));
	Возврат Примечание;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти

&Прозвище("ВитринаУчастниковГруппы")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ЯчейкиТаблицы") _Ячейки,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "СервисСопоставленийГрупп") _СервисСопоставлений,
	&Пластилин(Значение = "ХранилищеПользователей") _ХранилищеПользователей,
	&Пластилин(Значение = "ПоискПоКоллекции") _Отбор,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "БланкРаздела") _Бланки,
	&Пластилин(Значение = "ПримечанияЭкрана") _Примечания,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено) Экспорт

	Кит = _Кит;
	Ячейки = _Ячейки;
	РендерерНастроек = _РендерерНастроек;
	СервисГрупп = _СервисГрупп;
	СервисПользователей = _СервисПользователей;
	СервисСопоставлений = _СервисСопоставлений;
	ХранилищеПользователей = _ХранилищеПользователей;
	Отбор = _Отбор;
	Тексты = _Тексты;
	Бланки = _Бланки;
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);
	Примечания = _Примечания;

КонецПроцедуры
