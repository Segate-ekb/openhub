// Дом настроек «Группа» — контроллер модуля web-ui.

Перем ГвардГруппы;       // ГвардГруппы (web-ui)
Перем Ответы;            // ОтветыНастроек (web-ui)
Перем Дом;               // ДомГруппы (web-ui)
Перем РендерерНастроек;  // РендерерНастроек (кит)
Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем Ячейки;            // ЯчейкиТаблицы (web-ui) — заготовки ячеек таблиц
Перем Гейт;              // ГейтФормы (web-ui) — метод запроса и токен формы
Перем Защита;            // ЗащитаCSRF (auth)
Перем РазборФормы;       // РазборФормы (web-ui)
Перем СервисГрупп;       // СервисГрупп (auth)
Перем СервисСопоставлений; // СервисСопоставленийГрупп (auth)
Перем СервисПользователей; // СервисПользователей (auth)
Перем ВитринаУчастников; // ВитринаУчастниковГруппы (web-ui) — состав и подбор
Перем ВитринаПрав;       // ВитринаПравГруппы (web-ui) — права группы по объектам
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ТочкиМаршрута

// Точка маршрута «{группа}/settings» (GET).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  группа - СправочникСсылка - группа.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//
&ТочкаМаршрута("{группа}/settings")
Процедура Обзор(Ответ, группа, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Вердикт = ГвардГруппы.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, группа);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	ОтдатьРаздел(Ответ, Вердикт, Дом.РазделПоУмолчанию(), Ложь, "", КукиЗапроса);

КонецПроцедуры

// Точка маршрута «{группа}/settings/{раздел}» (POST, GET).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  группа - СправочникСсылка - группа.
//  раздел - Строка - ключ раздела.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  q - Строка - подстрока отбора кандидатов в участники (необязательный, по умолчанию "").
//
&ТочкаМаршрута("{группа}/settings/{раздел}")
Процедура Раздел(Ответ, группа, раздел, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	saved = "", q = "") Экспорт

	ЭтоМутация = Ответы.ЭтоМетод(МетодЗапроса, "POST");

	Вердикт = ГвардГруппы.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, группа, ЭтоМутация);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Ключ = НРег(СокрЛП(Строка(раздел)));
	Если НЕ Дом.ЕстьРаздел(Ключ) Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт.Пользователь,
			Тексты.Текст("settings.group.error.section"), КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Вердикт, Ключ, ЗначениеЗаполнено(saved), "", КукиЗапроса, 200, q);
		Возврат;
	КонецЕсли;

	Форма = Гейт.ПринятаяФорма(Ответ, Вердикт, "GET, POST", МетодЗапроса, ТелоЗапроса,
		КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Сохранить(Ответ, Вердикт, Ключ, Форма, КукиЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Сохранение

// Разделы дома «Группа», у которых есть мутация.
Функция РазделПринимаетPOST(Знач Ключ)
	Возврат Ключ = "members" ИЛИ Ключ = "oidc";
КонецФункции

Процедура Сохранить(Ответ, Знач Вердикт, Знач Ключ, Знач Форма, Знач КукиЗапроса)

	Если НЕ РазделПринимаетPOST(Ключ) Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Запрос = СокрЛП(РазборФормы.Поле(Форма, "q"));

	Попытка
		Если Ключ = "members" Тогда
			ИзменитьСостав(Вердикт, Форма);
		ИначеЕсли Ключ = "oidc" Тогда
			ИзменитьСопоставления(Вердикт, Форма);
		КонецЕсли;
	Исключение
		ОтдатьРаздел(Ответ, Вердикт, Ключ, Ложь,
			Тексты.Шаблон("settings.group.error.save", Ответы.КраткоОшибка(ОписаниеОшибки())),
			КукиЗапроса, 400, Запрос);
		Возврат;
	КонецПопытки;

	// отбор кандидатов переживает мутацию: иначе подбор начинается заново после каждого
	Ответ.Перенаправить(Дом.АдресРаздела(Вердикт.Группа.Имя, Ключ) + "?saved=1" + ХвостОтбора(Запрос));

КонецПроцедуры

Функция ХвостОтбора(Знач Запрос)
	Возврат ?(ЗначениеЗаполнено(Запрос),
		"&q=" + КодироватьСтроку(Запрос, СпособКодированияСтроки.КодировкаURL), "");
КонецФункции

Процедура ИзменитьСостав(Знач Вердикт, Знач Форма)

	Операция = ОперацияСостава(Форма);
	Логин = СокрЛП(РазборФормы.Поле(Форма, "логин"));

	Пользователь = СервисПользователей.НайтиПоЛогину(Логин);
	Если Пользователь = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Пользователь ""%1"" не найден", Логин);
	КонецЕсли;

	Если Операция = "удалить" Тогда
		СервисГрупп.УдалитьУчастника(Вердикт.Группа.Идентификатор, Пользователь.Идентификатор);
		Возврат;
	КонецЕсли;

	// повтор означает устаревший список кандидатов: молчаливое «ок» показало бы, что
	// действие сработало, хотя состав не менялся
	Если УжеВГруппе(Вердикт.Группа, Пользователь) Тогда
		ВызватьИсключение Тексты.Шаблон("settings.group.member-new.duplicate", Логин);
	КонецЕсли;

	СервисГрупп.ДобавитьУчастника(Вердикт.Группа.Идентификатор, Пользователь.Идентификатор, "local");

КонецПроцедуры

// Операция раздела «Состав» из закрытого перечня. Умолчание раздела — ОТКАЗ: подделанное
// поле не должно попадать в ветку «добавить участника».
Функция ОперацияСостава(Знач Форма)

	Значение = НРег(СокрЛП(РазборФормы.Поле(Форма, "операция")));
	Если Значение <> "добавить" И Значение <> "удалить" Тогда
		ВызватьИсключение Тексты.Текст("settings.group.error.operation");
	КонецЕсли;
	Возврат Значение;

КонецФункции

Функция УжеВГруппе(Знач Группа, Знач Пользователь)

	Для Каждого Идентификатор Из СервисГрупп.УчастникиГруппы(Группа.Идентификатор) Цикл
		Если Цел(Идентификатор) = Цел(Пользователь.Идентификатор) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура ИзменитьСопоставления(Знач Вердикт, Знач Форма)

	Операция = ОперацияСопоставлений(Форма);

	Если Операция = "политика" Тогда
		// тумблер: включён → "оставлять", выключен → "исключать" (парное скрытое поле)
		СервисСопоставлений.УстановитьПолитикуВыпавших(Вердикт.Группа.Идентификатор,
			РазборФормы.Поле(Форма, "политика", СервисСопоставлений.ПолитикаИсключать()));
		Возврат;
	КонецЕсли;

	Издатель = СокрЛП(РазборФормы.Поле(Форма, "издатель"));
	Значение = СокрЛП(РазборФормы.Поле(Форма, "значение"));
	Клейм = СокрЛП(РазборФормы.Поле(Форма, "клейм", "groups"));

	Если Операция = "удалить" Тогда
		СервисСопоставлений.УдалитьСопоставление(Вердикт.Группа.Идентификатор, Издатель, Значение, Клейм);
	Иначе
		СервисСопоставлений.ДобавитьСопоставление(Вердикт.Группа.Идентификатор, Издатель, Значение, Клейм);
	КонецЕсли;

КонецПроцедуры

// Операция раздела «Сопоставления» из закрытого перечня. Умолчание раздела — ОТКАЗ:
// подделанное поле не должно заводить связку, по которой провайдер раздаёт членство.
Функция ОперацияСопоставлений(Знач Форма)

	Значение = НРег(СокрЛП(РазборФормы.Поле(Форма, "операция")));
	Если Значение <> "добавить" И Значение <> "удалить" И Значение <> "политика" Тогда
		ВызватьИсключение Тексты.Текст("settings.group.error.operation");
	КонецЕсли;
	Возврат Значение;

КонецФункции

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач Ключ, Знач Сохранено, Знач Ошибка, Знач КукиЗапроса,
	Знач Статус = 200, Знач Запрос = "")

	Группа = Вердикт.Группа;
	Токен = Защита.ТокенСессии(Вердикт.Сессия);

	Уведомления = Ответы.УведомленияРаздела(Сохранено, Ошибка);
	Если НЕ Вердикт.МожетПравить Тогда
		Уведомления.Добавить(Ответы.Уведомление(
			Тексты.Текст("settings.group.readonly"), "info"));
	КонецЕсли;

	Хлебные = Новый Массив();
	Хлебные.Добавить(Новый Структура("Подпись", Тексты.Текст("settings.group.crumb")));
	Хлебные.Добавить(Новый Структура("Подпись", Группа.Имя));

	Модель = Ответы.МодельДома(Дом, Группа.Имя,
		Дом.Разделы(Группа.Имя, Ключ),
		Уведомления,
		Секции(Ключ, Вердикт, Токен, Запрос),
		Хлебные);

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт.Пользователь, КукиЗапроса, Дом.Заголовок(), Статус);

КонецПроцедуры

Функция Секции(Знач Ключ, Знач Вердикт, Знач Токен, Знач Запрос)

	Группа = Вердикт.Группа;
	МожетПравить = Вердикт.МожетПравить;
	Результат = Новый Массив();

	Если Ключ = "members" Тогда
		Для Каждого Секция Из ВитринаУчастников.Секции(
			Новый Структура("Группа, Адрес, Токен, МожетПравить, Запрос",
				Группа, Дом.АдресРаздела(Группа.Имя, "members"), Токен, МожетПравить, Запрос)) Цикл
			Результат.Добавить(Секция);
		КонецЦикла;
	ИначеЕсли Ключ = "oidc" Тогда
		Результат.Добавить(СекцияСопоставлений(Группа, Токен, МожетПравить));
		Результат.Добавить(СекцияПолитикиВыпавших(Группа, Токен, МожетПравить));
		Если МожетПравить Тогда
			Результат.Добавить(СекцияНовогоСопоставления(Группа, Токен));
		КонецЕсли;
	ИначеЕсли Ключ = "grants" Тогда
		Результат.Добавить(ВитринаПрав.Секция(Новый Структура("Группа, Пользователь, Принципал",
			Группа, Вердикт.Пользователь, Вердикт.Принципал)));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция СекцияСопоставлений(Знач Группа, Знач Токен, Знач МожетПравить)

	Тело = Кит.Холст();
	Тело.Добавить(ТаблицаСопоставлений(Группа, Токен, МожетПравить));
	Тело.Добавить(Кит.Примечание(Тексты.Текст("settings.group.oidc.note")));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.group.oidc.title"),
		Тексты.Текст("settings.group.oidc.lead"), Тело.Рендер());
	Секция.Иконка = "ссылка";
	Возврат Секция;

КонецФункции

Функция ТаблицаСопоставлений(Знач Группа, Знач Токен, Знач МожетПравить)

	Адрес = Дом.АдресРаздела(Группа.Имя, "oidc");

	Таблица = Кит.Таблица();
	Таблица.Пусто().Добавить(Кит.Примечание(Тексты.Текст("settings.group.oidc.empty"), "пусто"));

	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.group.oidc.col.issuer")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.group.oidc.col.claim")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.group.oidc.col.value")));
	Таблица.Добавить(Кит.Колонка());

	Для Каждого Сопоставление Из СервисСопоставлений.ВсеСопоставления() Цикл
		Если Сопоставление.ГруппаИдентификатор = Группа.Идентификатор Тогда
			Таблица.Добавить(СтрокаСопоставления(Сопоставление, Адрес, Токен, МожетПравить));
		КонецЕсли;
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция СтрокаСопоставления(Знач Сопоставление, Знач Адрес, Знач Токен, Знач МожетПравить)

	Строка_ = Кит.Запись();
	Строка_.Добавить(ЯчейкаКода(Сопоставление.Издатель));
	Строка_.Добавить(Ячейки.Текстовая(Сопоставление.ИмяКлейма));
	Строка_.Добавить(ЯчейкаКода(Сопоставление.Значение));
	Строка_.Добавить(КнопкаУдаленияСопоставления(Адрес, Токен, Сопоставление, МожетПравить));
	Возврат Строка_;

КонецФункции

// Политика выпавших из клейма — тумблер (два состояния); без права правки он заблокирован.
Функция СекцияПолитикиВыпавших(Знач Группа, Знач Токен, Знач МожетПравить)

	Оставлять = СервисСопоставлений.ПолитикаВыпавших(Группа.Идентификатор)
		= СервисСопоставлений.ПолитикаОставлять();

	Модель = Новый Структура();
	Модель.Вставить("Метка", Тексты.Текст("settings.group.policy.label"));
	Модель.Вставить("Включено", Оставлять);
	Модель.Вставить("ПодписьВкл", Тексты.Текст("settings.group.policy.on"));
	Модель.Вставить("ПодписьВыкл", Тексты.Текст("settings.group.policy.off"));
	Модель.Вставить("Подсказка", Тексты.Текст("settings.group.policy.hint"));
	Если МожетПравить Тогда
		Модель.Вставить("Имя", "политика");
		Модель.Вставить("ЗначениеВкл", СервисСопоставлений.ПолитикаОставлять());
		Модель.Вставить("ЗначениеВыкл", СервисСопоставлений.ПолитикаИсключать());
	Иначе
		Модель.Вставить("Заблокировано", Истина);
	КонецЕсли;

	Тело = Кит.Холст();
	Тело.Добавить(Кит.СкрытоеПоле("операция", "политика"));
	Тело.Добавить(Кит.Тумблер(Модель));
	Тело.Добавить(СтрокаПоследнейСверки(Группа));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.group.policy.title"),
		Тексты.Текст("settings.group.policy.lead"), Тело.Рендер());
	Секция.Иконка = "история";
	Если МожетПравить Тогда
		Секция.Действие = Дом.АдресРаздела(Группа.Имя, "oidc");
		Секция.Токен = Токен;
		Секция.Кнопка = Тексты.Текст("settings.frame.save");
	КонецЕсли;
	Возврат Секция;

КонецФункции

// Когда состав последний раз сверялся с клеймами провайдера.
Функция СтрокаПоследнейСверки(Знач Группа)

	Строка_ = Кит.Примечание();
	Строка_.Добавить(Кит.Шаблон(Тексты.Текст("settings.group.policy.synced")))
		.Добавить(Кит.Текст(ВремяСинхронизации(Группа)));
	Возврат Строка_;

КонецФункции

// Человекочитаемое время последней сверки состава с клеймами.
Функция ВремяСинхронизации(Знач Группа)
	Момент = СервисСопоставлений.СинхронизированаВ(Группа.Идентификатор);
	Возврат ?(Момент = Неопределено, Тексты.Текст("settings.group.policy.never"),
		Формат(Момент, "ДФ='dd.MM.yyyy HH:mm'") + " UTC");
КонецФункции

Функция КнопкаУдаленияСопоставления(Знач Адрес, Знач Токен, Знач Сопоставление, Знач МожетПравить)

	Ячейка = Кит.Ячейка();
	Если НЕ МожетПравить Тогда
		Возврат Ячейка;
	КонецЕсли;

	Форма = Ячейка.Добавить(Кит.Форма(Адрес, Токен, "строкой"));
	Форма.Добавить(Кит.СкрытоеПоле("операция", "удалить"));
	Форма.Добавить(Кит.СкрытоеПоле("издатель", Сопоставление.Издатель));
	Форма.Добавить(Кит.СкрытоеПоле("значение", Сопоставление.Значение));
	Форма.Добавить(Кит.СкрытоеПоле("клейм", Сопоставление.ИмяКлейма));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		Тексты.Текст("settings.group.oidc.button.remove"), "вторичная", "малый")));
	Возврат Ячейка;

КонецФункции

Функция СекцияНовогоСопоставления(Знач Группа, Знач Токен)

	Тело = Кит.Холст();
	Тело.Добавить(Кит.СкрытоеПоле("операция", "добавить"));
	Тело.Добавить(ПолеИздателя());
	Тело.Добавить(ПолеКлейма());
	Тело.Добавить(ПолеЗначенияКлейма());

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.group.mapping-new.title"), "",
		Тело.Рендер());
	Секция.Действие = Дом.АдресРаздела(Группа.Имя, "oidc");
	Секция.Токен = Токен;
	Секция.Кнопка = Тексты.Текст("settings.group.mapping-new.button");
	Возврат Секция;

КонецФункции

Функция ПолеИздателя()
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Плейсхолдер, Подсказка",
		"издатель", Тексты.Текст("settings.group.mapping-new.issuer.label"),
		"https://idp.example.com",
		Тексты.Текст("settings.group.mapping-new.issuer.hint")));
КонецФункции

Функция ПолеКлейма()
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Значение, Подсказка",
		"клейм", Тексты.Текст("settings.group.mapping-new.claim.label"), "groups",
		Тексты.Текст("settings.group.mapping-new.claim.hint")));
КонецФункции

Функция ПолеЗначенияКлейма()
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Плейсхолдер",
		"значение", Тексты.Текст("settings.group.mapping-new.value.label"), "platform-team"));
КонецФункции

Функция ЯчейкаКода(Знач Значение)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Код(Значение));
	Возврат Ячейка;

КонецФункции

#КонецОбласти

&Контроллер("/groups")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардГруппы") _ГвардГруппы,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомГруппы") _Дом,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ЯчейкиТаблицы") _Ячейки,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп,
	&Пластилин(Значение = "СервисСопоставленийГрупп") _СервисСопоставлений,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "ВитринаУчастниковГруппы") _ВитринаУчастников,
	&Пластилин(Значение = "ВитринаПравГруппы") _ВитринаПрав,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	ГвардГруппы = _ГвардГруппы;
	Ответы = _Ответы;
	Дом = _Дом;
	РендерерНастроек = _РендерерНастроек;
	Кит = _Кит;
	Ячейки = _Ячейки;
	Гейт = _Гейт;
	Защита = _Защита;
	РазборФормы = _РазборФормы;
	СервисГрупп = _СервисГрупп;
	СервисСопоставлений = _СервисСопоставлений;
	СервисПользователей = _СервисПользователей;
	ВитринаУчастников = _ВитринаУчастников;
	ВитринаПрав = _ВитринаПрав;
	Тексты = _Тексты;

КонецПроцедуры
