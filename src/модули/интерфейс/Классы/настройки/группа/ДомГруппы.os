// Дом настроек «Группа» — желудь модуля web-ui.

Перем Тексты;    // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Каталог;   // КаталогРазделов (web-ui)
Перем Описания;  // Массив описаний разделов

// Ключ дома.
//
// Возвращаемое значение:
//  Строка - ключ дома.
//
Функция Ключ() Экспорт
	Возврат "group";
КонецФункции

// Базовый адрес дома.
//
// Параметры:
//  ИмяГруппы - Строка - имя группы.
//
// Возвращаемое значение:
//  Строка - "/groups/{g}/settings".
//
Функция БазовыйАдрес(Знач ИмяГруппы) Экспорт
	Возврат "/groups/" + Каталог.Сегмент(ИмяГруппы) + "/settings";
КонецФункции

// Раздел по умолчанию.
//
// Возвращаемое значение:
//  Строка - раздел по умолчанию.
//
Функция РазделПоУмолчанию() Экспорт
	Возврат "members";
КонецФункции

// Адрес раздела дома.
//
// Параметры:
//  ИмяГруппы - Строка - имя группы.
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - адрес раздела дома.
//
Функция АдресРаздела(Знач ИмяГруппы, Знач Ключ) Экспорт
	Возврат Каталог.Адрес(БазовыйАдрес(ИмяГруппы), Ключ);
КонецФункции

// Разделы дома для дерева навигации.
//
// Параметры:
//  ИмяГруппы - Строка - имя группы.
//  Активный - Строка - ключ активного раздела.
//
// Возвращаемое значение:
//  Массив - разделы дома для дерева навигации.
//
Функция Разделы(Знач ИмяГруппы, Знач Активный) Экспорт
	Возврат Каталог.Разделы(БазовыйАдрес(ИмяГруппы), Описания, Активный);
КонецФункции

// Есть ли раздел с таким ключом.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Булево - есть ли раздел с таким ключом.
//
Функция ЕстьРаздел(Знач Ключ) Экспорт
	Возврат Каталог.Содержит(Описания, Ключ);
КонецФункции

// Подпись раздела.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - подпись раздела.
//
Функция ПодписьРаздела(Знач Ключ) Экспорт
	Возврат Каталог.Подпись(Описания, Ключ);
КонецФункции

// Заголовок дома.
//
// Возвращаемое значение:
//  Строка - заголовок дома.
//
Функция Заголовок() Экспорт
	Возврат Тексты.Текст("settings.group.title");
КонецФункции

// Пояснение дома.
//
// Возвращаемое значение:
//  Строка - пояснение дома.
//
Функция Пояснение() Экспорт
	Возврат Тексты.Текст("settings.group.lead");
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаталогРазделов") _Каталог,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Каталог = _Каталог;
	Тексты = _Тексты;

	Описания = Новый Массив();
	Описания.Добавить(Каталог.Описание("members", Тексты.Текст("settings.group.nav.members"), "аккаунт"));
	Описания.Добавить(Каталог.Описание("oidc", Тексты.Текст("settings.group.nav.oidc"), "ссылка"));
	Описания.Добавить(Каталог.Описание("grants", Тексты.Текст("settings.group.nav.grants"), "галочка"));

КонецПроцедуры
