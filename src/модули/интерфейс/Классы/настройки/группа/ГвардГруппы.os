// Гвард дома «Группа» — желудь модуля web-ui.

Перем ГвардКабинета;  // ГвардКабинета (кабинет)
Перем Ответы;         // ОтветыНастроек (web-ui)
Перем СервисПрав;     // СервисПрав (auth)
Перем СервисГрупп;
Перем Тексты;       // ТекстыИнтерфейса (кит) — строки по ключам
Перем Вердикты;     // ВердиктГварда (права) — форма ответа гварда

// Проверяет доступ к маршруту дома «Группа».
//
// Параметры:
//  Ответ - ОтветСервера.
//  ЗаголовкиЗапроса - Соответствие.
//  КукиЗапроса - Куки.
//  ИмяГруппы - Строка - сегмент {g}.
//  ТребуетсяПравка - Булево - Истина для мутаций (тогда чтения мало) (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура - вердикт гварда: Разрешено, Причина и поля формы —
//              Принципал, Пользователь, Сессия, Группа, МожетПравить.
//
Функция Проверить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ИмяГруппы,
	Знач ТребуетсяПравка = Ложь) Экспорт

	Вердикт = ГвардКабинета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Отказ();
	КонецЕсли;

	Пользователь = Вердикт.Пользователь;
	Группа = СервисГрупп.НайтиГруппу(ИмяГруппы);

	Если Группа = Неопределено Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Пользователь, Тексты.Текст("settings.guard.group.notfound"), КукиЗапроса);
		Возврат Отказ();
	КонецЕсли;

	МожетПравить = СервисПрав.ПользовательАдмин(Пользователь);
	Если НЕ МожетПравить И НЕ Участник(Группа, Пользователь) Тогда
		Ответы.ОтдатьЗапрещено(Ответ, Пользователь,
			Тексты.Текст("settings.guard.group.readonly"),
			КукиЗапроса);
		Возврат Отказ();
	КонецЕсли;

	Если ТребуетсяПравка И НЕ МожетПравить Тогда
		Ответы.ОтдатьЗапрещено(Ответ, Пользователь,
			Тексты.Текст("settings.guard.group.admin-only"), КукиЗапроса);
		Возврат Отказ();
	КонецЕсли;

	Возврат Вердикты.Пропуск(ПоляОтвета(Вердикт.Принципал, Пользователь, Вердикт.Сессия,
		Группа, МожетПравить));

КонецФункции

Функция Участник(Знач Группа, Знач Пользователь)

	Для Каждого Членство Из СервисГрупп.ГруппыПользователя(Пользователь.Идентификатор) Цикл
		Если Членство.Идентификатор = Группа.Идентификатор Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Отказ уже отвечен страницей: причина гварда дома — та самая страница, а не код.
Функция Отказ()
	Возврат Вердикты.Отказ("", ПоляОтвета());
КонецФункции

Функция ПоляОтвета(Знач Принципал = Неопределено, Знач Пользователь = Неопределено,
	Знач Сессия = Неопределено, Знач Группа = Неопределено, Знач МожетПравить = Ложь)

	Поля = Вердикты.ПоляПринципала(Принципал, Пользователь, Сессия);
	Поля.Вставить("Группа", Группа);
	Поля.Вставить("МожетПравить", МожетПравить);
	Возврат Поля;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _ГвардКабинета,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ВердиктГварда") _Вердикты = Неопределено) Экспорт

	ГвардКабинета = _ГвардКабинета;
	Ответы = _Ответы;
	СервисПрав = _СервисПрав;
	СервисГрупп = _СервисГрупп;
	Тексты = _Тексты;
	Вердикты = ?(_Вердикты = Неопределено, Новый ВердиктГварда(), _Вердикты);

КонецПроцедуры
