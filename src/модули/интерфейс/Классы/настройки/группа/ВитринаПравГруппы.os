// Раздел «Права доступа группы» дома «Группа»: показывает все объекты — хаб, пулы и пакеты —
// и только те из них, которые вправе видеть смотрящий.

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек;  // РендерерНастроек (кит) — описание секции
Перем ТаблицыПрав;       // ТаблицаПрав (web-ui) — единая таблица выдачи прав
Перем СервисПравДоступа; // СервисПравДоступа (auth) — записи прав субъекта
Перем Видимость;         // ВидимостьОбъектовПрав (auth) — что смотрящему вообще видно
Перем ДомПула;           // ДомПула (web-ui) — адреса пула и его разделов
Перем ДомПакета;         // ДомПакета (web-ui) — адреса пакета и его разделов
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секция раздела «права доступа» группы.
//
// Параметры:
//  Параметры - Структура: * Группа - Группа - группа; * Пользователь - Пользователь, Неопределено - смотрящий; * Принципал - Структура, Неопределено - принципал запроса для гейта ключа.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция Секция(Знач Параметры) Экспорт

	Тело = Кит.Холст();
	Тело.Добавить(ТаблицаОбъектов(Параметры));
	Тело.Добавить(Кит.Примечание(Тексты.Текст("settings.group.grants.note")));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.group.grants.title"),
		Тексты.Текст("settings.group.grants.lead"), Тело.Рендер());
	Секция.Иконка = "галочка";
	Возврат Секция;

КонецФункции

#КонецОбласти

#Область Раскладка

// Ось «объекты»: на что у группы есть права; хвост — ссылка «где править».
Функция ТаблицаОбъектов(Знач Параметры)

	Возврат ТаблицыПрав.Таблица(Новый Структура(
		"Строки, Ось, СХвостом, СРолью, ХвостЗаголовок, Пусто",
		Строки(Параметры), "объекты", Истина, Истина,
		Тексты.Текст("settings.group.grants.col.where"),
		Тексты.Текст("settings.group.grants.empty")));

КонецФункции

Функция Строки(Знач Параметры)

	Результат = Новый Массив();
	Для Каждого Право Из СервисПравДоступа.ГрантыСубъекта("группа", Параметры.Группа.Идентификатор) Цикл
		Объект = Видимость.Описание(Параметры.Пользователь, Право.ТипОбъекта,
			Право.ОбъектИдентификатор, Параметры.Принципал);
		Если НЕ Объект.Виден Тогда
			Продолжить; // объект удалён либо не виден смотрящему
		КонецЕсли;
		Результат.Добавить(Новый Структура("Грант, Роль, Объект, Хвост", Право,
			СервисПравДоступа.РольЗаписи(Право), ИмяОбъекта(Объект), ХодКПравке(Объект)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИмяОбъекта(Знач Объект)

	Если Объект.Тип = "пул" Тогда
		Возврат ХодПоАдресу(ДомПула.АдресПула(Объект.Пул.Имя), Объект.Пул.Имя);
	ИначеЕсли Объект.Тип = "пакет" Тогда
		Возврат ХодПоАдресу(ДомПакета.АдресПакета(Объект.Пул.Имя, Объект.Пакет.Имя),
			Объект.Пул.Имя + "/" + Объект.Пакет.Имя);
	КонецЕсли;

	Возврат Кит.Текст(Тексты.Текст("settings.group.grants.object.hub"));

КонецФункции

// У объекта «хаб» раздела правки нет: роли уровня хаба раздаёт только администратор хаба.
Функция ХодКПравке(Знач Объект)

	Если Объект.Тип = "пул" Тогда
		Возврат ХодПоАдресу(ДомПула.АдресРаздела(Объект.Пул.Имя, "visibility"),
			Тексты.Текст("settings.group.grants.link.pool"));
	ИначеЕсли Объект.Тип = "пакет" Тогда
		Возврат ХодПоАдресу(ДомПакета.АдресРаздела(Объект.Пул.Имя, Объект.Пакет.Имя, "access"),
			Тексты.Текст("settings.group.grants.link.package"));
	КонецЕсли;

	Возврат Кит.Холст();

КонецФункции

Функция ХодПоАдресу(Знач Адрес, Знач Подпись)

	Ссылка = Кит.Ссылка(Адрес);
	Ссылка.Добавить(Кит.Текст(Подпись));
	Возврат Ссылка;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаПравГруппы")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ТаблицаПрав") _ТаблицыПрав,
	&Пластилин(Значение = "СервисПравДоступа") _СервисПравДоступа,
	&Пластилин(Значение = "ВидимостьОбъектовПрав") _Видимость,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ДомПакета") _ДомПакета,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	ТаблицыПрав = _ТаблицыПрав;
	СервисПравДоступа = _СервисПравДоступа;
	Видимость = _Видимость;
	ДомПула = _ДомПула;
	ДомПакета = _ДомПакета;
	Тексты = _Тексты;

КонецПроцедуры
