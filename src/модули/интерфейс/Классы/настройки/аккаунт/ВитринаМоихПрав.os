// Витрина кабинета «мои права и мои группы»: две секции только на чтение. Грант правится
// на объекте, членство — в группе, поэтому форм здесь нет вовсе.

Перем Кит;              // Кит (кит) — фабрика элементов экрана
Перем Ячейки;           // ЯчейкиТаблицы (web-ui) — заготовки ячеек таблиц
Перем РендерерНастроек; // РендерерНастроек (кит)
Перем СервисПрав;       // СервисПрав (auth)
Перем СервисПулов;      // СервисПулов (реестр)
Перем СервисГрупп;      // СервисГрупп (auth)
Перем Тексты;           // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секция «Мои права» — витрина, только чтение: грант правится на объекте.
//
// Параметры:
//  Пользователь - Пользователь - смотрящий.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция СекцияПрав(Знач Пользователь) Экспорт

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.account.permissions.title"),
		Тексты.Текст("settings.account.permissions.lead"),
		ТаблицаПулов(Пользователь).Рендер());
	Секция.Иконка = "галочка";
	Возврат Секция;

КонецФункции

// Секция «Мои группы» — членство правится в самой группе.
//
// Параметры:
//  Пользователь - Пользователь - смотрящий.
//
// Возвращаемое значение:
//  Структура - описание секции для РендерерНастроек.
//
Функция СекцияГрупп(Знач Пользователь) Экспорт

	Возврат РендерерНастроек.Секция(Тексты.Текст("settings.account.groups.title"),
		Тексты.Текст("settings.account.groups.lead"),
		ТаблицаГрупп(Пользователь).Рендер());

КонецФункции

#КонецОбласти

#Область ТаблицаПулов

Функция ТаблицаПулов(Знач Пользователь)

	Таблица = Кит.Таблица();
	Таблица.Пусто().Добавить(
		Кит.Примечание(Тексты.Текст("settings.account.permissions.empty"), "пусто"));

	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.account.permissions.col.pool")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.account.permissions.col.role")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.account.permissions.col.admin")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.account.permissions.col.where")));

	Для Каждого Пул Из СервисПулов.ВсеПулы() Цикл
		Если ЕстьЧтоПоказать(Пользователь, Пул) Тогда
			Таблица.Добавить(СтрокаПула(Пользователь, Пул));
		КонецЕсли;
	КонецЦикла;

	Возврат Таблица;

КонецФункции

// Иначе строка сказала бы «читатель» каждому о каждом публичном пуле.
Функция ЕстьЧтоПоказать(Знач Пользователь, Знач Пул)

	Если НЕ СервисПрав.МожетЧитать(Пользователь, Пул) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ЗначениеЗаполнено(СервисПрав.РольНаПул(Пользователь, Пул.Идентификатор))
		ИЛИ СервисПрав.МожетПисать(Пользователь, Пул);

КонецФункции

Функция СтрокаПула(Знач Пользователь, Знач Пул)

	Строка_ = Кит.Запись();
	Строка_.Добавить(ИмяПула(Пул));
	Строка_.Добавить(РольНаПуле(Пользователь, Пул));
	Строка_.Добавить(ПравоАдминистрировать(Пользователь, Пул));
	Строка_.Добавить(ХодКНастройкамПула(Пул));
	Возврат Строка_;

КонецФункции

Функция ИмяПула(Знач Пул)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Ссылка("/" + Пул.Имя)).Добавить(Кит.Текст(Пул.Имя));
	Возврат Ячейка;

КонецФункции

// Роли может не быть вовсе: право пришло не ролью, а грантом на объект.
Функция РольНаПуле(Знач Пользователь, Знач Пул)

	Роль = СервисПрав.РольНаПул(Пользователь, Пул.Идентификатор);
	Возврат Ячейки.Текстовая(?(ЗначениеЗаполнено(Роль), Роль,
		Тексты.Текст("settings.account.permissions.role.grant")));

КонецФункции

Функция ПравоАдминистрировать(Знач Пользователь, Знач Пул)

	Возврат Ячейки.Текстовая(?(СервисПрав.МожетАдминистрировать(Пользователь, Пул),
		Тексты.Текст("settings.account.permissions.admin.yes"),
		Тексты.Текст("settings.account.permissions.admin.no")));

КонецФункции

Функция ХодКНастройкамПула(Знач Пул)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Ссылка("/" + Пул.Имя + "/settings"))
		.Добавить(Кит.Текст(Тексты.Текст("settings.account.permissions.link")));
	Возврат Ячейка;

КонецФункции

#КонецОбласти

#Область ТаблицаГрупп

Функция ТаблицаГрупп(Знач Пользователь)

	Таблица = Кит.Таблица();
	Таблица.Пусто().Добавить(
		Кит.Примечание(Тексты.Текст("settings.account.groups.empty"), "пусто"));

	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.account.groups.col.group")));
	Таблица.Добавить(Кит.Колонка(Тексты.Текст("settings.account.groups.col.description")));

	Для Каждого Группа Из СервисГрупп.ГруппыПользователя(Пользователь.Идентификатор) Цикл
		Таблица.Добавить(СтрокаГруппы(Группа));
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция СтрокаГруппы(Знач Группа)

	Строка_ = Кит.Запись();
	Строка_.Добавить(ИмяГруппы(Группа));
	Строка_.Добавить(Ячейки.Текстовая(?(ЗначениеЗаполнено(Группа.Описание), Группа.Описание, "")));
	Возврат Строка_;

КонецФункции

Функция ИмяГруппы(Знач Группа)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Ссылка("/groups/" + Группа.Имя + "/settings"))
		.Добавить(Кит.Текст(Группа.Имя));
	Возврат Ячейка;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ЯчейкиТаблицы") _Ячейки,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	Кит = _Кит;
	Ячейки = _Ячейки;
	РендерерНастроек = _РендерерНастроек;
	СервисПрав = _СервисПрав;
	СервисПулов = _СервисПулов;
	СервисГрупп = _СервисГрупп;
	Тексты = _Тексты;

КонецПроцедуры
