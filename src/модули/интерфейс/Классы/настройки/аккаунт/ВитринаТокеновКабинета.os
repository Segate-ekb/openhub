// Экран токенов кабинета — желудь модуля web-ui: список выпущенных ключей, форма выпуска
// и окно подбора пулов. Что показать, решает контроллер, витрина — как это выглядит.

Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем Ячейки;         // ЯчейкиТаблицы (web-ui) — заготовки ячеек таблиц
Перем Дом;            // ДомАккаунта (web-ui) — адрес раздела, он же action форм
Перем СервисТокенов;  // СервисТокенов (auth) — выпущенные ключи и потолок срока
Перем СервисПулов;    // СервисПулов (реестр) — имя пула для списка выпущенных токенов
Перем ЧтениеПулов;    // ГвардЧтенияПула (auth) — какие пулы смотрящему видны
Перем Подбор;         // ФормаПодбораПулов (web-ui) — окно подбора пулов и имена его полей
Перем ГейтТокена;     // ГейтТокена (auth) — словарь скоупов, которым живёт ключ

#Область ПубличныйИнтерфейс

// Раздел целиком: только что выпущенный секрет, список ключей, форма выпуска и окно
// подбора пулов. Окно — сосед формы, а не её часть: свою кнопку «Найти» оно отправляет
// само, и вложенных форм в HTML не бывает.
//
// Параметры:
//  Вердикт - Структура - Пользователь и Принципал запроса.
//  Токен - Строка - CSRF-токен сессии для форм раздела.
//  НовыйСекрет - Строка - только что выпущенный ключ; "" — показывать нечего.
//  Заявка - Структура - набранная форма выпуска (см. ЗаявкаИзФормы контроллера).
//
// Возвращаемое значение:
//  ЭлементЭкрана - тело секции «Токены доступа».
//
Функция Раздел(Знач Вердикт, Знач Токен, Знач НовыйСекрет, Знач Заявка) Экспорт

	ВидимыеПулы = ЧтениеПулов.ЧитаемыеПулы(Вердикт.Принципал);

	Холст = Кит.Холст();
	Холст.Добавить(ПоказСекрета(НовыйСекрет));
	Холст.Добавить(ЗаголовокСписка());
	Холст.Добавить(ТаблицаТокенов(Вердикт.Пользователь, Токен));
	Холст.Добавить(ФормаВыпуска(Токен, Заявка, ВидимыеПулы));
	Холст.Добавить(ОкноПодбора(Токен, Заявка, ВидимыеПулы));
	Возврат Холст;

КонецФункции

// Имя поля формы выпуска, в котором едет название токена.
//
// Возвращаемое значение:
//  Строка - имя поля.
//
Функция ИмяПоляИмени() Экспорт
	Возврат "имя";
КонецФункции

// Имя флажка формы выпуска, которым запрашивают область чтения.
//
// Возвращаемое значение:
//  Строка - имя поля.
//
Функция ИмяПоляЧтения() Экспорт
	Возврат "чтение";
КонецФункции

// Имя флажка формы выпуска, которым запрашивают область записи.
//
// Возвращаемое значение:
//  Строка - имя поля.
//
Функция ИмяПоляЗаписи() Экспорт
	Возврат "запись";
КонецФункции

// Имя поля формы выпуска, в котором едет срок действия в днях.
//
// Возвращаемое значение:
//  Строка - имя поля.
//
Функция ИмяПоляСрока() Экспорт
	Возврат "срок_дней";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Секрет виден ЕДИНСТВЕННЫЙ раз — сразу после выпуска; в остальное время его на экране нет.
Функция ПоказСекрета(Знач НовыйСекрет)

	Если НЕ ЗначениеЗаполнено(НовыйСекрет) Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Возврат Кит.БлокКоманды(НовыйСекрет);

КонецФункции

Функция ЗаголовокСписка()

	Заголовок = Кит.Заголовок(2);
	Заголовок.Добавить(Кит.Текст("Мои токены"));
	Возврат Заголовок;

КонецФункции

Функция ТаблицаТокенов(Знач Пользователь, Знач Токен)

	Таблица = Кит.Таблица();
	Таблица.Пусто().Добавить(Кит.Примечание("Токенов пока нет.", "пусто"));

	Таблица.Добавить(Кит.Колонка("Имя"));
	Таблица.Добавить(Кит.Колонка("Префикс"));
	Таблица.Добавить(Кит.Колонка("Области"));
	Таблица.Добавить(Кит.Колонка("Где действует"));
	Таблица.Добавить(Кит.Колонка("Создан"));
	Таблица.Добавить(Кит.Колонка("Истекает"));
	Таблица.Добавить(Кит.Колонка("Действие"));

	Для Каждого Запись Из СервисТокенов.ТокеныПользователя(Пользователь.Идентификатор) Цикл
		Таблица.Добавить(СтрокаТокена(Запись, Токен));
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция СтрокаТокена(Знач Запись, Знач Токен)

	Строка_ = Кит.Запись();
	Строка_.Добавить(Ячейки.Текстовая(?(ЗначениеЗаполнено(Запись.Имя),
		Строка(Запись.Имя), "(без имени)")));
	Строка_.Добавить(ПрефиксКлюча(Запись));
	Строка_.Добавить(Ячейки.Текстовая(ОбластиСловами(Запись.Права)));
	Строка_.Добавить(Ячейки.Текстовая(ПривязкаСловами(Запись)));
	Строка_.Добавить(Ячейки.Текстовая(ДатаТекстом(Запись.Создан)));
	Строка_.Добавить(Ячейки.Текстовая(СрокТекстом(Запись.Истекает)));
	Строка_.Добавить(КнопкаОтзыва(Запись, Токен));
	Возврат Строка_;

КонецФункции

Функция ПрефиксКлюча(Знач Запись)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Код(Запись.Префикс));
	Возврат Ячейка;

КонецФункции

// Незнакомый скоуп старой записи показывается как есть, а не прячется за прочерк.
Функция ОбластиСловами(Знач Права)

	Названия = Новый Массив();
	Для Каждого Скоуп Из СтрРазделить(Строка(Права), ",", Ложь) Цикл
		Значение = НРег(СокрЛП(Скоуп));
		Если Значение = ГейтТокена.СкоупЧтения() Тогда
			Названия.Добавить("чтение");
		ИначеЕсли Значение = ГейтТокена.СкоупЗаписи() Тогда
			Названия.Добавить("запись");
		ИначеЕсли ЗначениеЗаполнено(Значение) Тогда
			Названия.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат ?(Названия.Количество() > 0, СтрСоединить(Названия, ", "), "нет областей");

КонецФункции

// Пусто означает «весь хаб», и написать это надо буквами: пустая ячейка читается как «неизвестно».
Функция ПривязкаСловами(Знач Запись)

	Имена = Новый Массив();
	Для Каждого ПулИдентификатор Из СервисТокенов.ПулыТокена(Запись) Цикл
		Пул = СервисПулов.ПулПоИдентификатору(ПулИдентификатор);
		Имена.Добавить(?(Пул = Неопределено,
			СтрШаблон("пул %1", Формат(ПулИдентификатор, "ЧГ=0")), Строка(Пул.Имя)));
	КонецЦикла;

	Возврат ?(Имена.Количество() > 0, СтрСоединить(Имена, ", "), "весь хаб");

КонецФункции

Функция КнопкаОтзыва(Знач Запись, Знач Токен)

	Действие = Дом.АдресРаздела("tokens") + "/"
		+ Формат(Запись.Идентификатор, "ЧГ=0") + "/revoke";

	Ячейка = Кит.Ячейка();
	Форма = Ячейка.Добавить(Кит.Форма(Действие, Токен, "строкой"));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		"Отозвать", "опасная", "малый")));
	Возврат Ячейка;

КонецФункции

Функция ФормаВыпуска(Знач Токен, Знач Заявка, Знач ВидимыеПулы)

	Форма = Кит.Форма(Дом.АдресРаздела("tokens"), Токен, "столбик");

	Форма.Добавить(ПолеИмени(Заявка));
	Форма.Добавить(ОбластиДоступа(Заявка));
	Форма.Добавить(ГдеДействуетТокен(Заявка, ВидимыеПулы));
	Форма.Добавить(ПолеСрока(Заявка));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		"Выпустить токен", "основная", "обычный")));

	Возврат Форма;

КонецФункции

Функция ПолеИмени(Знач Заявка)
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Плейсхолдер, Значение",
		ИмяПоляИмени(), "Имя (зачем этот токен)", "например ноутбук", Заявка.Имя));
КонецФункции

// Флажки, а не строка: опечатка в вписанном скоупе выпускала токен, который молча ничего не может.
Функция ОбластиДоступа(Знач Заявка)

	Группа = Кит.Группа("Что можно делать этим токеном", "простая");
	Группа.Добавить(Флажок(ИмяПоляЧтения(), "чтение — скачивать пакеты и читать метаданные",
		"1", Заявка.Чтение));
	Группа.Добавить(Флажок(ИмяПоляЗаписи(), "запись — публиковать версии и менять настройки",
		"1", Заявка.Запись));
	Возврат Группа;

КонецФункции

// Списка пулов в форме нет: на сотнях пулов он был бы стеной флажков ради случая для единиц.
Функция ГдеДействуетТокен(Знач Заявка, Знач ВидимыеПулы)

	Группа = Кит.Группа("Где действует токен", "простая");

	Если ВидимыеПулы.Количество() = 0 Тогда
		Группа.Добавить(Кит.Примечание("Доступных пулов нет — токен будет действовать на весь хаб."));
		Возврат Группа;
	КонецЕсли;

	Отмеченные = ОтмеченныеПулы(Заявка, ВидимыеПулы);
	Если Отмеченные.Количество() = 0 Тогда
		Группа.Добавить(Кит.Примечание(
			"Весь хаб: токен будет работать во всех пулах, которые вам доступны."));
	Иначе
		Группа.Добавить(Кит.Примечание(
			"Токен будет работать только в этих пулах. Снимите отметку, чтобы убрать пул из набора."));
		Для Каждого Пул Из Отмеченные Цикл
			Группа.Добавить(Флажок(Подбор.ИмяПоляПулов(), Строка(Пул.Имя),
				Формат(Пул.Идентификатор, "ЧГ=0"), Истина));
		КонецЦикла;
	КонецЕсли;

	Группа.Добавить(КнопкаПодбора(Отмеченные.Количество() > 0));
	Возврат Группа;

КонецФункции

// Отправляет ТУ ЖЕ форму с операцией подбора, поэтому набранное доезжает до окна.
Функция КнопкаПодбора(Знач ЕстьНабор)

	Ряд = Кит.Ряд("справа");
	Ряд.Добавить(Кит.Кнопка(Новый Структура(
		"Подпись, Вариант, Размер, Иконка, Имя, Значение, БезВалидации",
		?(ЕстьНабор, "Изменить набор пулов", "Выбрать пулы"), "вторичная", "малый", "куб",
		Подбор.ИмяПоляОперации(), Подбор.ОперацияОткрытия(), Истина)));
	Возврат Ряд;

КонецФункции

// Набор — это пулы, а не идентификаторы: имя берётся из того же списка видимых.
Функция ОтмеченныеПулы(Знач Заявка, Знач ВидимыеПулы)

	Результат = Новый Массив();
	Для Каждого Пул Из ВидимыеПулы Цикл
		Если Заявка.Пулы.Найти(Формат(Пул.Идентификатор, "ЧГ=0")) <> Неопределено Тогда
			Результат.Добавить(Пул);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Окно живёт на экране только открытым: открывает его кнопка формы, то есть сервер.
Функция ОкноПодбора(Знач Токен, Знач Заявка, Знач ВидимыеПулы)

	Если НЕ Заявка.Подбор Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Параметры = Новый Структура();
	Параметры.Вставить("Адрес", Дом.АдресРаздела("tokens"));
	Параметры.Вставить("Токен", Токен);
	Параметры.Вставить("ВидимыеПулы", ВидимыеПулы);
	Параметры.Вставить("Отмеченные", Заявка.Пулы);
	Параметры.Вставить("Поиск", Заявка.Поиск);
	Параметры.Вставить("Черновик", ЧерновикЗаявки(Заявка));
	Возврат Подбор.Окно(Параметры);

КонецФункции

Функция Флажок(Знач Имя, Знач Метка, Знач Значение, Знач Отмечено)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Отмечено",
		Имя, Метка, "флажок", Значение, Отмечено));

КонецФункции

// Поле объявлено обязательным в разметке — сервер требует его так же строго.
Функция ПолеСрока(Знач Заявка)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Обязательное, Подсказка",
		ИмяПоляСрока(), "Срок действия, дней", "число", Заявка.Срок, Истина,
		СтрШаблон("От 1 до %1 дней. Бессрочных токенов хаб не выпускает.",
			Формат(СервисТокенов.ПотолокСрокаДней(), "ЧГ=0"))));

КонецФункции

Функция ДатаТекстом(Знач Значение)
	Возврат ?(ЗначениеЗаполнено(Значение), Формат(Значение, "ДЛФ=D"), "");
КонецФункции

// Пустая дата бывает только у ключей, выпущенных до запрета бессрочных.
Функция СрокТекстом(Знач Значение)
	Возврат ?(ЗначениеЗаполнено(Значение), Формат(Значение, "ДЛФ=D"),
		"бессрочно — выпущен до запрета, отзовите");
КонецФункции

// Снятый флажок скрытым полем не печатается: печать значила бы «отмечен».
Функция ЧерновикЗаявки(Знач Заявка)

	Черновик = Новый Соответствие();
	Черновик.Вставить(ИмяПоляИмени(), Заявка.Имя);
	Черновик.Вставить(ИмяПоляСрока(), Заявка.Срок);
	Если Заявка.Чтение Тогда
		Черновик.Вставить(ИмяПоляЧтения(), "1");
	КонецЕсли;
	Если Заявка.Запись Тогда
		Черновик.Вставить(ИмяПоляЗаписи(), "1");
	КонецЕсли;
	Возврат Черновик;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаТокеновКабинета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ЯчейкиТаблицы") _Ячейки,
	&Пластилин(Значение = "ДомАккаунта") _Дом,
	&Пластилин(Значение = "СервисТокенов") _СервисТокенов,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ГвардЧтенияПула") _ЧтениеПулов,
	&Пластилин(Значение = "ФормаПодбораПулов") _Подбор,
	&Пластилин(Значение = "ГейтТокена") _ГейтТокена) Экспорт

	Кит = _Кит;
	Ячейки = _Ячейки;
	Дом = _Дом;
	СервисТокенов = _СервисТокенов;
	СервисПулов = _СервисПулов;
	ЧтениеПулов = _ЧтениеПулов;
	Подбор = _Подбор;
	ГейтТокена = _ГейтТокена;

КонецПроцедуры
