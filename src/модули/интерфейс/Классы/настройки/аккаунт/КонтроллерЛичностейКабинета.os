// Контроллер привязок OIDC в кабинете — модуль web-ui.

Перем Гвард;              // ГвардКабинета (кабинет)
Перем Кит;                // Кит (кит) — фабрика элементов экрана
Перем Ячейки;             // ЯчейкиТаблицы (web-ui) — заготовки ячеек таблиц
Перем Защита;             // ЗащитаCSRF (auth) — токен сессии в форму
Перем Гейт;               // ГейтФормы (web-ui) — метод запроса и токен формы
Перем РазборФормы;        // РазборФормы (web-ui)
Перем СервисЛичностей;    // СервисЛичностей (auth)
Перем СервисВхода;        // СервисВходаOIDC (oidc)
Перем Транзакции;         // ХранительТранзакцийOIDC (oidc)
Перем КукаТранзакции;     // КукаТранзакцииOIDC (вход) — имя и атрибуты куки транзакции
Перем Конфигурация;       // КонфигурацияOIDC (oidc)
Перем Ответы;             // ОтветыНастроек (web-ui)
Перем Дом;                // ДомАккаунта (web-ui)
Перем РендерерНастроек;   // РендерерНастроек (кит)
Перем Числа;              // ПриведениеЧисел (основа) — терпимое чтение числа
Перем Бланки;             // БланкРаздела (web-ui) — адрес и токен раздела, формы на них
Перем Обрезка;            // ОбрезаниеТекста (основа) — длинное значение в узкой колонке
Перем Примечания;         // ПримечанияЭкрана (web-ui) — вид «показывать нечего»
Перем ГейтВходаПоСтране;  // ГейтВходаПоСтране (oidc) — закрыт ли провайдер посетителю
Перем Посетители;         // ПосетительЗапроса (гео) — адрес и заголовки одним значением
Перем ОтказСтраны;        // ОтказПоСтране (web-ui) — что сказать закрытому посетителю
Перем Атрибуция;          // АтрибуцияБазыСтран (web-ui) — условие лицензии базы стран

#Область ТочкиМаршрута

// Точка маршрута «oidc» (GET).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента; по нему судится правило о стране.
//
&ТочкаМаршрута("oidc")
Процедура Личности(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	АдресУдаленногоУзла) Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	ОтдатьСписок(Ответ, Вердикт, "", КукиЗапроса, 200,
		Посетители.Собрать(АдресУдаленногоУзла, ЗаголовкиЗапроса));

КонецПроцедуры

// Точка маршрута «oidc/unlink» (POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("oidc/unlink")
Процедура Отвязать(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Форма = Гейт.ПринятаяФорма(Ответ, Вердикт, "POST", МетодЗапроса, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЛичностьИд = Числа.ЧислоИлиНоль(РазборФормы.Поле(Форма, "личность"));
	// Отвязать вернёт Ложь для чужой личности — молча к списку, не раскрываем её существование
	СервисЛичностей.Отвязать(Вердикт.Пользователь.Идентификатор, ЛичностьИд);
	Ответ.Перенаправить(Дом.АдресРаздела("oidc"));

КонецПроцедуры

// Точка маршрута «oidc/link/{провайдер}» (GET).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  провайдер - Строка - имя провайдера из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента; по нему судится правило о стране.
//
&ТочкаМаршрута("oidc/link/{провайдер}")
Процедура НачатьПривязку(Ответ, провайдер, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	АдресУдаленногоУзла) Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Посетитель = Посетители.Собрать(АдресУдаленногоУзла, ЗаголовкиЗапроса);

	Если Конфигурация.Провайдер(провайдер) = Неопределено Тогда
		ОтдатьСписок(Ответ, Вердикт, "Неизвестный провайдер входа", КукиЗапроса, 200, Посетитель);
		Возврат;
	КонецЕсли;

	Попытка
		Начало = СервисВхода.Начать(провайдер, Посетитель);
	Исключение
		ОтдатьСписок(Ответ, Вердикт, "Не удалось начать привязку через провайдера", КукиЗапроса,
			200, Посетитель);
		Возврат;
	КонецПопытки;

	Если НЕ Начало.Успех Тогда
		ОтдатьСписок(Ответ, Вердикт,
			ОтказСтраны.ТекстПривязки(ОткрытыеПровайдеры(Посетитель).Количество()),
			КукиЗапроса, ОтказСтраны.Код(), Посетитель);
		Возврат;
	КонецЕсли;

	// признак ручной привязки: id текущего пользователя едет контекстом записи транзакции
	КукаТранзакции.Установить(Ответ,
		Транзакции.Сохранить(Начало.Транзакция, "", Вердикт.Пользователь.Идентификатор));
	Ответ.Перенаправить(Начало.URL);

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьСписок(Ответ, Знач Вердикт, Знач Ошибка, Знач КукиЗапроса,
	Знач Статус = 200, Знач Посетитель = Неопределено)

	Пользователь = Вердикт.Пользователь;
	Токен = Защита.ТокенСессии(Вердикт.Сессия);

	Уведомления = Новый Массив();
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Уведомления.Добавить(Ответы.Уведомление(Ошибка, "err"));
	КонецЕсли;

	Секции = Новый Массив();
	Секции.Добавить(РендерерНастроек.Секция("Привязки OIDC",
		"Входы через внешних провайдеров, связанные с вашей учётной записью.",
		РазделПривязок(Пользователь, Токен, ОткрытыеПровайдеры(Посетитель)).Рендер()));

	Модель = Ответы.МодельДома(Дом, Пользователь.Логин,
		Дом.Разделы("oidc"),
		Уведомления,
		Секции);

	Ответы.ОтдатьДом(Ответ, Модель, Пользователь, КукиЗапроса, Дом.ПодписьРаздела("oidc"),
		Статус);

КонецПроцедуры

// Кнопка и отказ спрашивают одно правило: закрытого провайдера человек не видит вовсе.
Функция ОткрытыеПровайдеры(Знач Посетитель)
	Возврат ГейтВходаПоСтране.ПровайдерыДляПосетителя(Конфигурация.Провайдеры(), Посетитель);
КонецФункции

// Раздел целиком: что уже привязано и чем привязать ещё.
Функция РазделПривязок(Знач Пользователь, Знач Токен, Знач Провайдеры)

	Раздел = Кит.Холст();
	Раздел.Добавить(ТаблицаЛичностей(Пользователь, Токен));
	Раздел.Добавить(БлокПривязки(Провайдеры));
	Раздел.Добавить(Атрибуция.Примечание());
	Возврат Раздел;

КонецФункции

Функция ТаблицаЛичностей(Знач Пользователь, Знач Токен)

	Таблица = Кит.Таблица();
	Таблица.Пусто().Добавить(Примечания.Пусто("Пока нет привязанных личностей."));

	Таблица.Добавить(Кит.Колонка("Провайдер (issuer)"));
	Таблица.Добавить(Кит.Колонка("Аккаунт у провайдера"));
	Таблица.Добавить(Кит.Колонка("Email"));
	Таблица.Добавить(Кит.Колонка());

	Для Каждого Личность Из СервисЛичностей.ЛичностиПользователя(Пользователь.Идентификатор) Цикл
		Таблица.Добавить(СтрокаЛичности(Личность, Токен));
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция СтрокаЛичности(Знач Личность, Знач Токен)

	СтрокаТаблицы = Кит.Запись();
	СтрокаТаблицы.Добавить(Ячейки.Текстовая(Строка(Личность.Издатель)));
	СтрокаТаблицы.Добавить(АккаунтУПровайдера(Личность));
	СтрокаТаблицы.Добавить(Ячейки.Текстовая(Строка(Личность.Email)));
	СтрокаТаблицы.Добавить(КнопкаОтвязки(Личность, Токен));
	Возврат СтрокаТаблицы;

КонецФункции

// Субъект — машинный ключ связки: он показывается, только когда логина нет.
Функция АккаунтУПровайдера(Знач Личность)

	Логин = СокрЛП(Строка(Личность.ПредпочтительныйЛогин));
	Если ЗначениеЗаполнено(Логин) Тогда
		Возврат ЯчейкаАккаунта(Логин);
	КонецЕсли;

	Субъект = СокрЛП(Строка(Личность.Субъект));
	Если ПустаяСтрока(Субъект) Тогда
		Возврат Кит.Ячейка();
	КонецЕсли;
	Возврат ЯчейкаАккаунта(Субъект);

КонецФункции

// Предел стоит на ТОМ, ЧТО ПОКАЗАНО; полное значение остаётся в подсказке.
Функция ЯчейкаАккаунта(Знач Значение)

	Показанное = Обрезка.СМноготочием(Значение, ПределАккаунтаВТаблице());

	Ячейка = Кит.Ячейка();
	Если Показанное = Значение Тогда
		Ячейка.Добавить(Кит.Код(Значение));
	Иначе
		Ячейка.Добавить(Кит.Код(Показанное).Подсказка(Значение));
	КонецЕсли;
	Возврат Ячейка;

КонецФункции

Функция ПределАккаунтаВТаблице()
	Возврат 24;
КонецФункции

Функция КнопкаОтвязки(Знач Личность, Знач Токен)

	Ячейка = Кит.Ячейка();
	Форма = Ячейка.Добавить(Бланки.Форма(
		Бланки.НаАдресе(Дом.АдресРаздела("oidc"), Токен), "unlink"));
	Форма.Добавить(Кит.СкрытоеПоле("личность", Личность.Идентификатор));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		"Отвязать", "опасная", "малый")));
	Возврат Ячейка;

КонецФункции

// Пока провайдеров нет, привязывать нечем — вместо сетки честная строка об этом.
// Все закрыты правилом по стране — строка другая: настройка тут ни при чём.
Функция БлокПривязки(Знач Провайдеры)

	Если Провайдеры.Количество() = 0 Тогда
		Возврат Кит.Примечание(?(Конфигурация.ЕстьПровайдеры(),
			ОтказСтраны.ТекстПривязки(0), "Провайдеры OIDC не настроены."));
	КонецЕсли;

	Блок = Кит.Холст();
	Блок.Добавить(ЗаголовокПривязки());
	Блок.Добавить(СеткаПровайдеров(Провайдеры));
	Возврат Блок;

КонецФункции

Функция ЗаголовокПривязки()

	Заголовок = Кит.Заголовок(2);
	Заголовок.Добавить(Кит.Текст("Привязать провайдера"));
	Возврат Заголовок;

КонецФункции

Функция СеткаПровайдеров(Знач Провайдеры)

	Сетка = Кит.Сетка(Новый Структура("Плотная, Заголовок", Истина, "Провайдеры OIDC"));
	Для Каждого Провайдер Из Провайдеры Цикл
		Сетка.Добавить(КнопкаПривязки(Провайдер));
	КонецЦикла;
	Возврат Сетка;

КонецФункции

Функция КнопкаПривязки(Знач Провайдер)

	Адрес = Дом.АдресРаздела("oidc") + "/link/"
		+ КодироватьСтроку(Провайдер.Имя, СпособКодированияСтроки.КодировкаURL);

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Иконка",
		"Привязать " + Строка(Провайдер.Метка), Адрес, "вторичная", "ссылка"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти

&Контроллер("/me/settings")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _Гвард,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ЯчейкиТаблицы") _Ячейки,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисЛичностей") _СервисЛичностей,
	&Пластилин(Значение = "СервисВходаOIDC") _СервисВхода,
	&Пластилин(Значение = "ХранительТранзакцийOIDC") _Транзакции,
	&Пластилин(Значение = "КукаТранзакцииOIDC") _КукаТранзакции,
	&Пластилин(Значение = "КонфигурацияOIDC") _Конфигурация,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомАккаунта") _Дом,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "БланкРаздела") _Бланки,
	&Пластилин(Значение = "ПримечанияЭкрана") _Примечания,
	&Пластилин(Значение = "ГейтВходаПоСтране") _ГейтВходаПоСтране,
	&Пластилин(Значение = "ПосетительЗапроса") _Посетители,
	&Пластилин(Значение = "ОтказПоСтране") _ОтказСтраны,
	&Пластилин(Значение = "АтрибуцияБазыСтран") _Атрибуция,
	&Пластилин(Значение = "ОбрезаниеТекста") _Обрезка = Неопределено)

	ГейтВходаПоСтране = _ГейтВходаПоСтране;
	Посетители = _Посетители;
	ОтказСтраны = _ОтказСтраны;
	Атрибуция = _Атрибуция;
	Числа = _Числа;
	Бланки = _Бланки;
	Обрезка = ?(_Обрезка = Неопределено, Новый ОбрезаниеТекста(), _Обрезка);

	Гвард = _Гвард;
	Кит = _Кит;
	Ячейки = _Ячейки;
	Защита = _Защита;
	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	СервисЛичностей = _СервисЛичностей;
	СервисВхода = _СервисВхода;
	Транзакции = _Транзакции;
	КукаТранзакции = _КукаТранзакции;
	Конфигурация = _Конфигурация;
	Ответы = _Ответы;
	Дом = _Дом;
	РендерерНастроек = _РендерерНастроек;
	Примечания = _Примечания;

КонецПроцедуры
