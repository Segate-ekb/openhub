// Окно подбора пулов для формы выпуска токена — желудь модуля web-ui: поиск по видимым
// пулам, отметки и возврат набранного в форму выпуска скрытыми полями.

Перем Кит;      // Кит (кит) — фабрика элементов экрана
Перем Фабрика;  // Формы (кит) — фабрика объявлений форм
Перем Плашки;   // ПлашкиПула (web-ui) — видимость пула словами

#Область ПубличныйИнтерфейс

// Имя скрытого поля операции: им форма выпуска и окно подбора называют нажатую кнопку.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Операция «открыть подбор»: кнопка формы выпуска.
//
// Возвращаемое значение:
//  Строка
//
Функция ОперацияОткрытия() Экспорт
	Возврат "подбор";
КонецФункции

// Операция «искать»: кнопка окна подбора.
//
// Возвращаемое значение:
//  Строка
//
Функция ОперацияПоиска() Экспорт
	Возврат "искать";
КонецФункции

// Операция «применить»: кнопка окна подбора, закрывающая его с набранным.
//
// Возвращаемое значение:
//  Строка
//
Функция ОперацияПрименения() Экспорт
	Возврат "применить";
КонецФункции

// Имя поля подстроки поиска.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПоляПоиска() Экспорт
	Возврат "поиск";
КонецФункции

// Имя поля отмеченного пула: одно и то же у флажков окна и у флажков формы выпуска.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПоляПулов() Экспорт
	Возврат "пулы";
КонецФункции

// Сколько пулов показывать за раз: подбор обязан оставаться читаемым и на сотнях пулов,
// а «показать все» превращает его в стену имён.
//
// Возвращаемое значение:
//  Число
//
Функция ПределПоказа() Экспорт
	Возврат 20;
КонецФункции

// Окно подбора: поиск, отметки и набранное формой выпуска. Окно печатается открытым —
// его показывает сервер в ответ на нажатую кнопку, а не скрипт.
//
// Параметры:
//  Параметры - Структура:
//    * Адрес - Строка - адрес раздела (он же action формы);
//    * Токен - Строка - CSRF-токен сессии;
//    * ВидимыеПулы - Массив из Пул - пулы, которые смотрящему видны;
//    * Отмеченные - Массив из Строка - идентификаторы отмеченных пулов;
//    * Поиск - Строка - подстрока имени;
//    * Черновик - Соответствие - имя поля формы выпуска -> значение.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел-окно с формой подбора.
//
Функция Окно(Знач Параметры) Экспорт

	Подходящие = ПулыПоПоиску(Параметры.ВидимыеПулы, Параметры.Поиск);
	Показанные = ПоказанныеПулы(Подходящие);

	Объявление = Фабрика.Новая()
		.Блок(НабранноеФормой(Параметры.Черновик).Рендер())
		.Блок(ОбластьПодбора(Показанные, Подходящие.Количество(),
			Параметры.Отмеченные, Параметры.Поиск).Рендер());

	Возврат Кит.Окно(Объявление, Неопределено, Параметры.Адрес, Параметры.Токен, Оформление());

КонецФункции

#КонецОбласти

#Область Отбор

// Пулы, чьё имя содержит подстроку: регистр не важен, пустая подстрока не сужает ничего.
Функция ПулыПоПоиску(Знач ВидимыеПулы, Знач Поиск)

	Подстрока = НРег(СокрЛП(Строка(Поиск)));
	Если НЕ ЗначениеЗаполнено(Подстрока) Тогда
		Возврат ВидимыеПулы;
	КонецЕсли;

	Результат = Новый Массив();
	Для Каждого Пул Из ВидимыеПулы Цикл
		Если СтрНайти(НРег(Строка(Пул.Имя)), Подстрока) > 0 Тогда
			Результат.Добавить(Пул);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПоказанныеПулы(Знач Подходящие)

	Результат = Новый Массив();
	Для Позиция = 0 По Мин(Подходящие.Количество(), ПределПоказа()) - 1 Цикл
		Результат.Добавить(Подходящие[Позиция]);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Без скрытых полей поиск и усечение теряли бы набранное молча.
Функция ОтмеченныеВнеПоказа(Знач Показанные, Знач Отмеченные)

	НаЭкране = Новый Соответствие();
	Для Каждого Пул Из Показанные Цикл
		НаЭкране.Вставить(Идентификатор(Пул), Истина);
	КонецЦикла;

	Результат = Новый Массив();
	Для Каждого Значение Из Отмеченные Цикл
		Если НаЭкране.Получить(Строка(Значение)) = Неопределено Тогда
			Результат.Добавить(Строка(Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Разметка

// Без скрипта это обычный блок: список сужает кнопка «Найти», пулы приходят отобранными.
Функция ОбластьПодбора(Знач Показанные, Знач Всего, Знач Отмеченные, Знач Поиск)

	Область = Кит.Область().Признак("filter", ИмяПоляПоиска());
	Область.Добавить(СтрокаПоиска(Поиск));
	Область.Добавить(ТаблицаПулов(Показанные, Отмеченные, Поиск));
	Область.Добавить(СкрытыеОтметки(ОтмеченныеВнеПоказа(Показанные, Отмеченные)));
	Область.Добавить(ОговоркаЧастичногоОтбора());
	Область.Добавить(ОговоркаПустогоОтбора());
	Область.Добавить(СтрокаУсечения(Всего, Показанные.Количество()));
	Возврат Область;

КонецФункции

Функция СтрокаПоиска(Знач Поиск)

	РядФормы = Кит.Ряд("строкой");
	РядФормы.Добавить(Кит.Поле(Новый Структура("Имя, Метка, Значение, Плейсхолдер",
		ИмяПоляПоиска(), "Поиск пула по имени", Строка(Поиск), "часть имени пула")));
	РядФормы.Добавить(Кит.Кнопка(Новый Структура(
		"Подпись, Вариант, Размер, Иконка, Имя, Значение, БезВалидации",
		"Найти", "вторичная", "малый", "поиск", ИмяПоляОперации(), ОперацияПоиска(), Истина)));
	Возврат РядФормы;

КонецФункции

Функция ТаблицаПулов(Знач Показанные, Знач Отмеченные, Знач Поиск)

	Таблица = Кит.Таблица();
	Таблица.Пусто().Добавить(Кит.Примечание(ПустаяВыдача(Поиск), "пусто"));

	Таблица.Добавить(Кит.Колонка("Пул"));
	Таблица.Добавить(Кит.Колонка("Видимость"));

	Для Каждого Пул Из Показанные Цикл
		Таблица.Добавить(ЗаписьПула(Пул, Отмеченные));
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция ЗаписьПула(Знач Пул, Знач Отмеченные)

	Запись = Кит.Запись();
	Запись.Добавить(ЯчейкаОтметки(Пул, Отмеченные));
	Запись.Добавить(ЯчейкаВидимости(Пул));
	Возврат Запись;

КонецФункции

Функция ЯчейкаОтметки(Знач Пул, Знач Отмеченные)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Отмечено",
		ИмяПоляПулов(), Строка(Пул.Имя), "флажок", Идентификатор(Пул),
		Отмеченные.Найти(Идентификатор(Пул)) <> Неопределено)));
	Возврат Ячейка;

КонецФункции

Функция ЯчейкаВидимости(Знач Пул)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Плашка(Плашки.ПлашкаВидимости(Пул)));
	Возврат Ячейка;

КонецФункции

// Отметка пула вне показанного куска переезжает скрытым полем: иначе поиск снимал бы отметки.
Функция СкрытыеОтметки(Знач ВнеПоказа)

	Холст = Кит.Холст();
	Для Каждого Значение Из ВнеПоказа Цикл
		Холст.Добавить(Кит.СкрытоеПоле(ИмяПоляПулов(), Значение));
	КонецЦикла;
	Возврат Холст;

КонецФункции

// Какие это поля, окно не знает — их называет форма выпуска.
Функция НабранноеФормой(Знач Поля)

	Холст = Кит.Холст();
	Для Каждого КиЗ Из Поля Цикл
		Холст.Добавить(Кит.СкрытоеПоле(КиЗ.Ключ, КиЗ.Значение));
	КонецЦикла;
	Возврат Холст;

КонецФункции

// Клиентский отбор сужает то, что УЖЕ в окне, и полнотой выдачи не является.
Функция ОговоркаЧастичногоОтбора()
	Возврат СпрятаннаяОговорка("filter-partial",
		"Список сужен прямо в окне. Чтобы искать среди всех пулов, нажмите «Найти».");
КонецФункции

Функция ОговоркаПустогоОтбора()
	Возврат СпрятаннаяОговорка("filter-empty",
		"Среди показанных пулов совпадений нет. Чтобы искать среди всех, нажмите «Найти».");
КонецФункции

Функция СпрятаннаяОговорка(Знач ИмяПризнака, Знач Текст)

	Оговорка = Кит.Область().Роль("состояние").Признак(ИмяПризнака, ИмяПоляПоиска()).Скрыть();
	Оговорка.Добавить(Кит.Примечание(Текст));
	Возврат Оговорка;

КонецФункции

// Честная строка «показаны не все»: молчаливое усечение выглядит как «таких больше нет».
Функция СтрокаУсечения(Знач Всего, Знач Показано)

	Если Всего <= Показано Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Примечание(СтрШаблон(
		"Показаны первые %1 пулов из %2 — уточните поиск, чтобы увидеть остальные.",
		Формат(Показано, "ЧГ=0"), Формат(Всего, "ЧГ=0")));

КонецФункции

Функция ПустаяВыдача(Знач Поиск)
	Возврат ?(ЗначениеЗаполнено(СокрЛП(Строка(Поиск))),
		СтрШаблон("Пулов с «%1» в имени не нашлось.", СокрЛП(Строка(Поиск))),
		"Доступных пулов нет.");
КонецФункции

Функция Оформление()

	Результат = Новый Структура();
	Результат.Вставить("Заголовок", "Где действует токен");
	Результат.Вставить("Лид", "Отметьте пулы, в которых должен работать токен."
		+ " Ничего не отмечено — токен действует на весь хаб.");
	Результат.Вставить("Отмена", "Отмена");
	Результат.Вставить("Отправка", "Применить");
	Результат.Вставить("ИконкаОтправки", "куб");
	Результат.Вставить("ИмяКнопки", ИмяПоляОперации());
	Результат.Вставить("ЗначениеКнопки", ОперацияПрименения());
	Результат.Вставить("Открыта", Истина);
	Возврат Результат;

КонецФункции

Функция Идентификатор(Знач Пул)
	Возврат Формат(Пул.Идентификатор, "ЧГ=0");
КонецФункции

#КонецОбласти

&Прозвище("ФормаПодбораПулов")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "Формы") _Фабрика,
	&Пластилин(Значение = "ПлашкиПула") _Плашки) Экспорт

	Кит = _Кит;
	Фабрика = _Фабрика;
	Плашки = _Плашки;

КонецПроцедуры
