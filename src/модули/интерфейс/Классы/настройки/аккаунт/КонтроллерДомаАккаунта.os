// Дом настроек «Аккаунт» — контроллер модуля web-ui.

Перем Гвард;               // ГвардКабинета (кабинет)
Перем Ответы;              // ОтветыНастроек (web-ui)
Перем Дом;                 // ДомАккаунта (web-ui)
Перем РендерерНастроек;    // РендерерНастроек (кит)
Перем Кит;                 // Кит (кит) — фабрика элементов экрана
Перем Гейт;                // ГейтФормы (web-ui) — метод запроса и токен формы
Перем Защита;              // ЗащитаCSRF (auth)
Перем РазборФормы;         // РазборФормы (web-ui)
Перем СервисПользователей; // СервисПользователей (auth)
Перем Адреса;              // АдресУчётки (auth) — смена адреса и код занятости
Перем ПолитикаПароля;      // ПолитикаПароля (auth)
Перем Подсказка;           // ПодсказкаПароля (web-ui) — требования под полем нового пароля
Перем ПарольныйВход;       // ПолитикаПарольногоВхода (auth)
Перем ВитринаПрав;         // ВитринаМоихПрав (web-ui) — секции «мои права» и «мои группы»
Перем ВыборВида;           // ВыборОформления (кит)
Перем Токены;              // ТокеныТемы (кит)
Перем Тексты;              // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ТочкиМаршрута

// GET /me/settings — вход в дом: раздел по умолчанию.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//
&ТочкаМаршрута("settings")
Процедура Обзор(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Ответ.Перенаправить(Дом.АдресРаздела(Дом.РазделПоУмолчанию()));

КонецПроцедуры

// GET/POST /me/settings/{раздел}
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  раздел - Строка - ключ раздела.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//
&ТочкаМаршрута("settings/{раздел}")
Процедура Раздел(Ответ, раздел, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, saved = "") Экспорт

	Ключ = НРег(СокрЛП(Строка(раздел)));

	// раздел «безопасность» = страница смены пароля: гвард не должен редиректить на неё саму
	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, Ключ = "security");
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Дом.ЕстьРаздел(Ключ) Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт.Пользователь,
			Тексты.Текст("settings.account.error.section"), КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Вердикт, Ключ, ЗначениеЗаполнено(saved), "", КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Гейт.ПринятаяФорма(Ответ, Вердикт, "GET, POST", МетодЗапроса, ТелоЗапроса,
		КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Сохранить(Ответ, Вердикт, Ключ, Форма, КукиЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Сохранение

// Общий предохранитель дома: исключение из служб не должно уходить пользователю голой 500-й.
Процедура Сохранить(Ответ, Знач Вердикт, Знач Ключ, Знач Форма, Знач КукиЗапроса)

	Если НЕ РазделПринимаетPOST(Ключ) Тогда
		// раздел только для чтения — POST на него не имеет смысла
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Попытка
		Если Ключ = "profile" Тогда
			СохранитьПрофиль(Ответ, Вердикт, Форма, КукиЗапроса);
		ИначеЕсли Ключ = "security" Тогда
			СменитьПароль(Ответ, Вердикт, Форма, КукиЗапроса);
		ИначеЕсли Ключ = "appearance" Тогда
			СохранитьОформление(Ответ, Вердикт, Форма, КукиЗапроса);
		КонецЕсли;
	Исключение
		Описание = ОписаниеОшибки();
		ОтдатьРаздел(Ответ, Вердикт, Ключ, Ложь, ТекстСбоя(Описание), КукиЗапроса,
			?(СтрНайти(Описание, Адреса.ПричинаЗанят()) > 0, 409, 400));
	КонецПопытки;

КонецПроцедуры

// Занятый адрес — названная человеку причина, а не «не удалось сохранить»: доменный код
// на экран не показывают.
Функция ТекстСбоя(Знач Описание)

	Если СтрНайти(Описание, Адреса.ПричинаЗанят()) > 0 Тогда
		Возврат Тексты.Текст("settings.account.error.email.taken");
	КонецЕсли;
	Возврат Тексты.Шаблон("settings.account.error.save", Ответы.КраткоОшибка(Описание));

КонецФункции

// Разделы дома «Аккаунт», у которых есть мутация. Витрина «мои права» POST не принимает.
Функция РазделПринимаетPOST(Знач Ключ)
	Возврат Ключ = "profile" ИЛИ Ключ = "security" ИЛИ Ключ = "appearance";
КонецФункции

Процедура СохранитьПрофиль(Ответ, Знач Вердикт, Знач Форма, Знач КукиЗапроса)

	// занятый и невалидный адрес — исключения; их ловит предохранитель Сохранить, и он же
	// подбирает текст. Отказ приходит ДО записи, то есть и до письма подтверждения
	Адреса.Сменить(Вердикт.Пользователь, РазборФормы.Поле(Форма, "email"));
	Ответ.Перенаправить(Дом.АдресРаздела("profile") + "?saved=1");

КонецПроцедуры

Процедура СменитьПароль(Ответ, Знач Вердикт, Знач Форма, Знач КукиЗапроса)

	Пользователь = Вердикт.Пользователь;
	Старый = РазборФормы.Поле(Форма, "старый");
	Новый_ = РазборФормы.Поле(Форма, "новый");
	Повтор = РазборФормы.Поле(Форма, "повтор");

	Если НЕ СервисПользователей.ПроверитьПароль(Пользователь, Старый) Тогда
		ОтдатьРаздел(Ответ, Вердикт, "security", Ложь,
			Тексты.Текст("settings.account.error.password.current"), КукиЗапроса, 400);
		Возврат;
	КонецЕсли;
	Если НЕ ПолитикаПароля.Допустим(Новый_) Тогда
		ОтдатьРаздел(Ответ, Вердикт, "security", Ложь,
			Тексты.Шаблон("settings.account.error.password.policy", ПолитикаПароля.ОписаниеОднойСтрокой()),
			КукиЗапроса, 400);
		Возврат;
	КонецЕсли;
	Если Новый_ <> Повтор Тогда
		ОтдатьРаздел(Ответ, Вердикт, "security", Ложь,
			Тексты.Текст("settings.account.error.password.repeat"), КукиЗапроса, 400);
		Возврат;
	КонецЕсли;

	// УстановитьПароль повторно провалидирует политикой и снимет ТребуетсяСменаПароля
	СервисПользователей.УстановитьПароль(Пользователь, Новый_);
	Ответ.Перенаправить(Дом.АдресРаздела("security") + "?saved=1");

КонецПроцедуры

// Оформление хранится в cookie целиком: пишем все четыре поля разом, частичная запись стирает.
Процедура СохранитьОформление(Ответ, Знач Вердикт, Знач Форма, Знач КукиЗапроса)

	Части = Новый Массив();
	Части.Добавить("тема=" + ?(НРег(РазборФормы.Поле(Форма, "тема", "тёмная")) = "светлая", "светлая", "тёмная"));
	Части.Добавить("акцент=" + Токены.БезопасныйЦвет(РазборФормы.Поле(Форма, "акцент")));
	Части.Добавить("плотность=" + Токены.ЧислоCSS(Токены.БезопасныйМножитель(РазборФормы.Поле(Форма, "плотность", "1"))));
	Части.Добавить("радиус=" + Токены.ЧислоCSS(Токены.БезопасныйМножитель(РазборФормы.Поле(Форма, "радиус", "1"))));

	// запись куки — в одном месте (ВыборОформления.ЗаписатьКуку)
	ВыборВида.ЗаписатьКуку(Ответ, СтрСоединить(Части, "&"));

	Ответ.Перенаправить(Дом.АдресРаздела("appearance") + "?saved=1");

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач Ключ, Знач Сохранено, Знач Ошибка, Знач КукиЗапроса,
	Знач Статус = 200)

	Пользователь = Вердикт.Пользователь;
	Токен = Защита.ТокенСессии(Вердикт.Сессия);

	Уведомления = Новый Массив();
	Если Ключ = "security" И ПарольныйВход.Выключен() Тогда
		// пароль остаётся страховкой на случай аварийного возврата формы конфигом,
		// поэтому смена работает — но обещать вход этим паролем сейчас нельзя
		Уведомления.Добавить(Ответы.Уведомление(
			Тексты.Текст("settings.account.security.passwordlogin.off"), "warn"));
	КонецЕсли;
	Если Пользователь.ТребуетсяСменаПароля = Истина И Ключ = "security" Тогда
		Уведомления.Добавить(Ответы.Уведомление(
			Тексты.Текст("settings.account.security.forced"), "warn"));
	КонецЕсли;
	Если Сохранено Тогда
		Уведомления.Добавить(Ответы.Уведомление(Тексты.Текст("settings.reply.saved"), "ok"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Уведомления.Добавить(Ответы.Уведомление(Ошибка, "err"));
	КонецЕсли;

	Модель = Ответы.МодельДома(Дом, Пользователь.Логин,
		Дом.Разделы(Ключ),
		Уведомления,
		Секции(Ключ, Пользователь, Токен, КукиЗапроса));

	Ответы.ОтдатьДом(Ответ, Модель, Пользователь, КукиЗапроса, Дом.ПодписьРаздела(Ключ), Статус);

КонецПроцедуры

Функция Секции(Знач Ключ, Знач Пользователь, Знач Токен, Знач КукиЗапроса)

	Результат = Новый Массив();

	Если Ключ = "profile" Тогда
		Результат.Добавить(СекцияПрофиля(Пользователь, Токен));
	ИначеЕсли Ключ = "security" Тогда
		Результат.Добавить(СекцияПароля(Токен));
	ИначеЕсли Ключ = "permissions" Тогда
		Результат.Добавить(ВитринаПрав.СекцияПрав(Пользователь));
		Результат.Добавить(ВитринаПрав.СекцияГрупп(Пользователь));
	ИначеЕсли Ключ = "appearance" Тогда
		Результат.Добавить(СекцияОформления(Токен, КукиЗапроса));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция СекцияПрофиля(Знач Пользователь, Знач Токен)

	Тело = Кит.Холст();
	Тело.Добавить(ПолеЛогина(Пользователь));
	Тело.Добавить(ПолеПочты(Пользователь));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.account.profile.title"),
		Тексты.Текст("settings.account.profile.lead"), Тело.Рендер());
	Секция.Иконка = "аккаунт";
	Секция.Действие = Дом.АдресРаздела("profile");
	Секция.Токен = Токен;
	Возврат Секция;

КонецФункции

// Логин не правится: он и есть имя учётной записи.
Функция ПолеЛогина(Знач Пользователь)

	Возврат Кит.Поле(Новый Структура("Метка, Значение, Заблокировано, Подсказка",
		Тексты.Текст("settings.account.profile.login.label"), Пользователь.Логин, Истина,
		Тексты.Текст("settings.account.profile.login.hint")));

КонецФункции

Функция ПолеПочты(Знач Пользователь)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Значение, Тип, Подсказка",
		"email", Тексты.Текст("settings.account.profile.email.label"),
		Пользователь.Email, "email", СтатусEmail(Пользователь)));

КонецФункции

Функция СтатусEmail(Знач Пользователь)

	Если НЕ ЗначениеЗаполнено(Пользователь.Email) Тогда
		Возврат Тексты.Текст("settings.account.profile.email.empty");
	КонецЕсли;
	Если Пользователь.EmailПодтверждён = Истина Тогда
		Возврат Тексты.Текст("settings.account.profile.email.confirmed");
	КонецЕсли;
	Возврат Тексты.Текст("settings.account.profile.email.unconfirmed");

КонецФункции

// Подсказка требований стоит СРАЗУ под новым паролем: она судит именно его, а не повтор.
Функция СекцияПароля(Знач Токен)

	Тело = Кит.Холст();
	Тело.Добавить(ПолеПароля("старый",
		Тексты.Текст("settings.account.password.current.label")));
	Тело.Добавить(ПолеПароля("новый", Тексты.Текст("settings.account.password.new.label")));
	Тело.Добавить(Подсказка.Требования("новый"));
	Тело.Добавить(ПолеПароля("повтор",
		Тексты.Текст("settings.account.password.repeat.label")));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.account.password.title"),
		Тексты.Текст("settings.account.password.lead"), Тело.Рендер());
	Секция.Иконка = "замок";
	Секция.Действие = Дом.АдресРаздела("security");
	Секция.Токен = Токен;
	Секция.Кнопка = Тексты.Текст("settings.account.password.button");
	Возврат Секция;

КонецФункции

Функция ПолеПароля(Знач Имя, Знач Метка)
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип", Имя, Метка, "пароль"));
КонецФункции

Функция СекцияОформления(Знач Токен, Знач КукиЗапроса)

	Оформление = ВыборВида.ПоКукам(КукиЗапроса);

	Тело = Кит.Холст();
	Тело.Добавить(ВыборТемы(Оформление));
	Тело.Добавить(ПолеАкцента(Оформление));
	Тело.Добавить(ПолеПлотности(Оформление));
	Тело.Добавить(ПолеРадиуса(Оформление));

	Секция = РендерерНастроек.Секция(Тексты.Текст("settings.account.appearance.title"),
		Тексты.Текст("settings.account.appearance.lead"), Тело.Рендер());
	Секция.Иконка = "солнце";
	Секция.Действие = Дом.АдресРаздела("appearance");
	Секция.Токен = Токен;
	Возврат Секция;

КонецФункции

Функция ВыборТемы(Знач Оформление)

	Варианты = Новый Массив();
	Варианты.Добавить(Новый Структура("Значение, Подпись", "тёмная",
		Тексты.Текст("settings.account.appearance.theme.dark")));
	Варианты.Добавить(Новый Структура("Значение, Подпись", "светлая",
		Тексты.Текст("settings.account.appearance.theme.light")));

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Варианты, Значение",
		"тема", Тексты.Текст("settings.account.appearance.theme.label"), "выбор", Варианты,
		?(Токены.АтрибутТемы(Оформление) = "light", "светлая", "тёмная")));

КонецФункции

// Плейсхолдер — базовый акцент из ТокеныТемы, а не второй литерал цвета.
Функция ПолеАкцента(Знач Оформление)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Значение, Плейсхолдер, Подсказка",
		"акцент", Тексты.Текст("settings.account.appearance.accent.label"),
		Токены.БезопасныйЦвет(Оформление.Акцент), Токены.АкцентПоУмолчанию(),
		Тексты.Текст("settings.account.appearance.accent.hint")));

КонецФункции

Функция ПолеПлотности(Знач Оформление)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Значение, Подсказка",
		"плотность", Тексты.Текст("settings.account.appearance.density.label"),
		Токены.ЧислоCSS(Токены.БезопасныйМножитель(Оформление.Плотность)),
		Тексты.Текст("settings.account.appearance.density.hint")));

КонецФункции

Функция ПолеРадиуса(Знач Оформление)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Значение, Подсказка",
		"радиус", Тексты.Текст("settings.account.appearance.radius.label"),
		Токены.ЧислоCSS(Токены.БезопасныйМножитель(Оформление.Радиус)),
		Тексты.Текст("settings.account.appearance.radius.hint")));

КонецФункции

#КонецОбласти

&Контроллер("/me")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _Гвард,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомАккаунта") _Дом,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "АдресУчётки") _Адреса,
	&Пластилин(Значение = "ПолитикаПароля") _ПолитикаПароля,
	&Пластилин(Значение = "ПодсказкаПароля") _Подсказка,
