// Контроллер токенов доступа кабинета — модуль web-ui.

Перем Гвард;             // ГвардКабинета (кабинет)
Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Защита;            // ЗащитаCSRF (auth)
Перем РазборФормы;       // РазборФормы (web-ui)
Перем СервисТокенов;     // СервисТокенов (auth)
Перем Ответы;            // ОтветыНастроек (web-ui)
Перем Дом;               // ДомАккаунта (web-ui) — карта дома «Аккаунт»
Перем РендерерНастроек;  // РендерерНастроек (кит) — единый каркас настроек
Перем Числа;       // ПриведениеЧисел (основа) — терпимое чтение числа
Перем Перехватчик; // ПерехватчикАутентификации (auth) — инвариант «ключ не размножается»
Перем ЧтениеПулов; // ГвардЧтенияПула (auth) — какие пулы смотрящему видны
Перем СервисПулов; // СервисПулов (реестр) — имя пула для списка выпущенных токенов
Перем Подбор;      // ФормаПодбораПулов (web-ui) — окно подбора пулов и имена его полей

#Область ТочкиМаршрута

// Точка маршрута «tokens» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("tokens")
Процедура Токены(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ КлючамиМожноУправлять(Ответ, Вердикт, КукиЗапроса) Тогда
		Возврат;
	КонецЕсли;
	Пользователь = Вердикт.Пользователь;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьСписок(Ответ, Вердикт, "", "", КукиЗапроса, ПустаяЗаявка());
	ИначеЕсли Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		ПринятьЗаявку(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Иначе
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Пользователь, КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «tokens/{id}/revoke» (POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("tokens/{id}/revoke")
Процедура Отзыв(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ КлючамиМожноУправлять(Ответ, Вердикт, КукиЗапроса) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "POST", Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = РазборФормы.Разобрать(ТелоЗапроса);
	Если НЕ Защита.Проверить(Вердикт.Сессия, РазборФормы.Поле(Форма, "_csrf")) Тогда
		Ответы.ОтдатьНеверныйCSRF(Ответ, Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	ТокенИд = Числа.ЧислоИлиНоль(id);
	Отозван = Ложь;
	Если ТокенИд > 0 Тогда
		// Отозвать возвращает Истина только если токен принадлежит текущему пользователю
		Отозван = СервисТокенов.Отозвать(Вердикт.Пользователь.Идентификатор, ТокенИд);
	КонецЕсли;
	Если Отозван Тогда
		Ответ.Перенаправить(Дом.АдресРаздела("tokens"));
	Иначе
		// чужой или несуществующий токен → одинаковый 404
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт.Пользователь, "Токен не найден", КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ДействияТокенов

// Одна дверь на все кнопки формы: подбор пулов — шаг той же заявки, поэтому его кнопки
// отправляют ту же форму с другой операцией, а не уводят человека на отдельный экран.
Процедура ПринятьЗаявку(Ответ, Знач Вердикт, Знач ТелоЗапроса, Знач КукиЗапроса)

	Форма = РазборФормы.Разобрать(ТелоЗапроса);
	Если НЕ Защита.Проверить(Вердикт.Сессия, РазборФормы.Поле(Форма, "_csrf")) Тогда
		Ответы.ОтдатьНеверныйCSRF(Ответ, Вердикт.Пользователь, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Заявка = ЗаявкаИзФормы(Форма, ТелоЗапроса);

	Названные = ЧтениеПулов.НазванныеПулы(Вердикт.Принципал, Заявка.Пулы);
	Если ЗначениеЗаполнено(Названные.Отвергнутый) Тогда
		// пул, которого смотрящий не видит, отвечает как несуществующий
		ОтдатьСписок(Ответ, Вердикт, "", СтрШаблон("Пул %1 не найден.", Названные.Отвергнутый),
			КукиЗапроса, Заявка);
		Возврат;
	КонецЕсли;
	// дальше набор живёт только сверенным: в разметку не попадёт пул, которого смотрящий не видит
	Заявка.Пулы = Идентификаторами(Названные.Пулы);

	Операция = РазборФормы.Поле(Форма, Подбор.ИмяПоляОперации());
	Если Операция = Подбор.ОперацияОткрытия() ИЛИ Операция = Подбор.ОперацияПоиска() Тогда
		Заявка.Подбор = Истина;
		ОтдатьСписок(Ответ, Вердикт, "", "", КукиЗапроса, Заявка);
	ИначеЕсли Операция = Подбор.ОперацияПрименения() Тогда
		ОтдатьСписок(Ответ, Вердикт, "", "", КукиЗапроса, Заявка);
	Иначе
		ВыпуститьТокен(Ответ, Вердикт, Заявка, Названные.Пулы, КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

Процедура ВыпуститьТокен(Ответ, Знач Вердикт, Знач Заявка, Знач Пулы, Знач КукиЗапроса)

	Если НЕ Заявка.Чтение И НЕ Заявка.Запись Тогда
		ОтдатьСписок(Ответ, Вердикт, "",
			"Отметьте хотя бы одну область: чтение или запись — токен без областей ничего не может.",
			КукиЗапроса, Заявка);
		Возврат;
	КонецЕсли;

	// поле объявлено обязательным в разметке — сервер требует его так же строго
	Потолок = СервисТокенов.ПотолокСрокаДней();
	СрокДней = Числа.ЦелоеИлиНеопределено(Заявка.Срок);
	Если СрокДней = Неопределено ИЛИ СрокДней < 1 ИЛИ СрокДней > Потолок Тогда
		ОтдатьСписок(Ответ, Вердикт, "", СтрШаблон(
			"Срок действия — целое число от 1 до %1 дней: бессрочных токенов хаб не выпускает.",
			Формат(Потолок, "ЧГ=0")), КукиЗапроса, Заявка);
		Возврат;
	КонецЕсли;

	Попытка
		Выпуск = СервисТокенов.ВыпуститьТокен(Вердикт.Пользователь.Идентификатор,
			ОбластиСтрокой(Заявка), СрокДней, 0, Заявка.Имя, Пулы);
	Исключение
		ОтдатьСписок(Ответ, Вердикт, "",
			"Не удалось выпустить токен: " + Ответы.КраткоОшибка(ОписаниеОшибки()),
			КукиЗапроса, Заявка);
		Возврат;
	КонецПопытки;

	// секрет показывается ЕДИНСТВЕННЫЙ раз здесь
	ОтдатьСписок(Ответ, Вердикт, Строка(Выпуск.ЗначениеТокена), "", КукиЗапроса, ПустаяЗаявка());

КонецПроцедуры

// Что человек отметил и вписал: отказ и подбор возвращают форму в этом же состоянии,
// чтобы не заставлять набирать всё заново. Пулы приходят группой флажков с одним именем,
// поэтому читаются из тела, а не из карты «имя → первое значение».
Функция ЗаявкаИзФормы(Знач Форма, Знач ТелоЗапроса)

	Заявка = Новый Структура();
	Заявка.Вставить("Имя", РазборФормы.Поле(Форма, ИмяПоляИмени()));
	Заявка.Вставить("Чтение", РазборФормы.Флажок(Форма, ИмяПоляЧтения()));
	Заявка.Вставить("Запись", РазборФормы.Флажок(Форма, ИмяПоляЗаписи()));
	Заявка.Вставить("Пулы", РазборФормы.Значения(ТелоЗапроса, Подбор.ИмяПоляПулов()));
	Заявка.Вставить("Срок", РазборФормы.Поле(Форма, ИмяПоляСрока()));
	Заявка.Вставить("Поиск", РазборФормы.Поле(Форма, Подбор.ИмяПоляПоиска()));
	// подбор открыт ровно тогда, когда его открыла нажатая кнопка: своего поля у окна нет
	Заявка.Вставить("Подбор", Ложь);
	Возврат Заявка;

КонецФункции

// Форма первого показа: обе области отмечены, пулы не выбраны — токен на весь хаб,
// и списка пулов на экране нет вовсе.
Функция ПустаяЗаявка()

	Заявка = Новый Структура();
	Заявка.Вставить("Имя", "");
	Заявка.Вставить("Чтение", Истина);
	Заявка.Вставить("Запись", Истина);
	Заявка.Вставить("Пулы", Новый Массив());
	Заявка.Вставить("Срок", Формат(СервисТокенов.СрокПоУмолчаниюДней(), "ЧГ=0"));
	Заявка.Вставить("Поиск", "");
	Заявка.Вставить("Подбор", Ложь);
	Возврат Заявка;

КонецФункции

// Набранное формой выпуска переезжает в окно подбора скрытыми полями: подбор — шаг той же
// заявки. Снятый флажок скрытым полем не печатается: печать значила бы «отмечен».
Функция ЧерновикЗаявки(Знач Заявка)

	Черновик = Новый Соответствие();
	Черновик.Вставить(ИмяПоляИмени(), Заявка.Имя);
	Черновик.Вставить(ИмяПоляСрока(), Заявка.Срок);
	Если Заявка.Чтение Тогда
		Черновик.Вставить(ИмяПоляЧтения(), "1");
	КонецЕсли;
	Если Заявка.Запись Тогда
		Черновик.Вставить(ИмяПоляЗаписи(), "1");
	КонецЕсли;
	Возврат Черновик;

КонецФункции

// Сверенные идентификаторы обратно строками: разметка сравнивает набор со значениями
// флажков, а они строки.
Функция Идентификаторами(Знач Пулы)

	Результат = Новый Массив();
	Для Каждого Идентификатор Из Пулы Цикл
		Результат.Добавить(Формат(Идентификатор, "ЧГ=0"));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИмяПоляИмени()
	Возврат "имя";
КонецФункции

Функция ИмяПоляЧтения()
	Возврат "чтение";
КонецФункции

Функция ИмяПоляЗаписи()
	Возврат "запись";
КонецФункции

Функция ИмяПоляСрока()
	Возврат "срок_дней";
КонецФункции

// Области экрана и скоупы хранилища — одно и то же, названное на двух языках.
Функция ОбластиСтрокой(Знач Заявка)

	Области = Новый Массив();
	Если Заявка.Чтение Тогда
		Области.Добавить(СкоупЧтения());
	КонецЕсли;
	Если Заявка.Запись Тогда
		Области.Добавить(СкоупЗаписи());
	КонецЕсли;
	Возврат СтрСоединить(Области, ",");

КонецФункции

Функция СкоупЧтения()
	Возврат "read";
КонецФункции

Функция СкоупЗаписи()
	Возврат "write";
КонецФункции

#КонецОбласти

#Область Рендер

Процедура ОтдатьСписок(Ответ, Знач Вердикт, Знач НовыйСекрет, Знач Ошибка, Знач КукиЗапроса,
	Знач Заявка)

	Пользователь = Вердикт.Пользователь;
	Токен = Защита.ТокенСессии(Вердикт.Сессия);

	Уведомления = Новый Массив();
	Если ЗначениеЗаполнено(НовыйСекрет) Тогда
		Уведомления.Добавить(Ответы.Уведомление(
			"Токен выпущен. Скопируйте его сейчас — он больше не будет показан.", "ok"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Уведомления.Добавить(Ответы.Уведомление(Ошибка, "err"));
	КонецЕсли;

	Секции = Новый Массив();
	Секции.Добавить(РендерерНастроек.Секция("Токены доступа",
		"Персональные токены для opm и CI. Секрет виден только при выпуске.",
		РазделТокенов(Вердикт, Токен, НовыйСекрет, Заявка).Рендер()));

	Модель = Новый Структура();
	Модель.Вставить("Ключ", Дом.Ключ());
	Модель.Вставить("Заголовок", Дом.Заголовок());
	Модель.Вставить("Объект", Пользователь.Логин);
	Модель.Вставить("Пояснение", Дом.Пояснение());
	Модель.Вставить("Разделы", Дом.Разделы("tokens"));
	Модель.Вставить("Уведомления", Уведомления);
	Модель.Вставить("Секции", Секции);

	Ответы.ОтдатьДом(Ответ, Модель, Пользователь, КукиЗапроса, Дом.ПодписьРаздела("tokens"));

КонецПроцедуры

// Раздел целиком: только что выпущенный секрет, список ключей, форма выпуска и окно
// подбора пулов. Окно — сосед формы, а не её часть: свою кнопку «Найти» оно отправляет
// само, и вложенных форм в HTML не бывает.
Функция РазделТокенов(Знач Вердикт, Знач Токен, Знач НовыйСекрет, Знач Заявка)

	ВидимыеПулы = ЧтениеПулов.ЧитаемыеПулы(Вердикт.Принципал);

	Раздел = Кит.Холст();
	Раздел.Добавить(ПоказСекрета(НовыйСекрет));
	Раздел.Добавить(ЗаголовокСписка());
	Раздел.Добавить(ТаблицаТокенов(Вердикт.Пользователь, Токен));
	Раздел.Добавить(ФормаВыпуска(Токен, Заявка, ВидимыеПулы));
	Раздел.Добавить(ОкноПодбора(Токен, Заявка, ВидимыеПулы));
	Возврат Раздел;

КонецФункции

// Секрет виден ЕДИНСТВЕННЫЙ раз — сразу после выпуска; в остальное время его на экране нет.
Функция ПоказСекрета(Знач НовыйСекрет)

	Если НЕ ЗначениеЗаполнено(НовыйСекрет) Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Возврат Кит.БлокКоманды(НовыйСекрет);

КонецФункции

Функция ЗаголовокСписка()

	Заголовок = Кит.Заголовок(2);
	Заголовок.Добавить(Кит.Текст("Мои токены"));
	Возврат Заголовок;

КонецФункции

Функция ТаблицаТокенов(Знач Пользователь, Знач Токен)

	Таблица = Кит.Таблица();
	Таблица.Пусто().Добавить(Кит.Примечание("Токенов пока нет.", "пусто"));

	Таблица.Добавить(Кит.Колонка("Имя"));
	Таблица.Добавить(Кит.Колонка("Префикс"));
	Таблица.Добавить(Кит.Колонка("Области"));
	Таблица.Добавить(Кит.Колонка("Где действует"));
	Таблица.Добавить(Кит.Колонка("Создан"));
	Таблица.Добавить(Кит.Колонка("Истекает"));
	Таблица.Добавить(Кит.Колонка("Действие"));

	Для Каждого Запись Из СервисТокенов.ТокеныПользователя(Пользователь.Идентификатор) Цикл
		Таблица.Добавить(СтрокаТокена(Запись, Токен));
	КонецЦикла;

	Возврат Таблица;

КонецФункции

Функция СтрокаТокена(Знач Запись, Знач Токен)

	Строка_ = Кит.Запись();
	Строка_.Добавить(ЯчейкаТекста(?(ЗначениеЗаполнено(Запись.Имя),
		Строка(Запись.Имя), "(без имени)")));
	Строка_.Добавить(ПрефиксКлюча(Запись));
	Строка_.Добавить(ЯчейкаТекста(ОбластиСловами(Запись.Права)));
	Строка_.Добавить(ЯчейкаТекста(ПривязкаСловами(Запись)));
	Строка_.Добавить(ЯчейкаТекста(ДатаТекстом(Запись.Создан)));
	Строка_.Добавить(ЯчейкаТекста(СрокТекстом(Запись.Истекает)));
	Строка_.Добавить(КнопкаОтзыва(Запись, Токен));
	Возврат Строка_;

КонецФункции

Функция ПрефиксКлюча(Знач Запись)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Код(Запись.Префикс));
	Возврат Ячейка;

КонецФункции

// Области названы теми же словами, что и флажки формы; незнакомый скоуп старой записи
// показывается как есть, а не прячется за прочерк.
Функция ОбластиСловами(Знач Права)

	Названия = Новый Массив();
	Для Каждого Скоуп Из СтрРазделить(Строка(Права), ",", Ложь) Цикл
		Значение = НРег(СокрЛП(Скоуп));
		Если Значение = СкоупЧтения() Тогда
			Названия.Добавить("чтение");
		ИначеЕсли Значение = СкоупЗаписи() Тогда
			Названия.Добавить("запись");
		ИначеЕсли ЗначениеЗаполнено(Значение) Тогда
			Названия.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат ?(Названия.Количество() > 0, СтрСоединить(Названия, ", "), "нет областей");

КонецФункции

// Рамки токена словами: пусто означает «весь хаб», и написать это надо буквами —
// иначе пустая ячейка читается как «неизвестно».
Функция ПривязкаСловами(Знач Запись)

	Имена = Новый Массив();
	Для Каждого ПулИдентификатор Из СервисТокенов.ПулыТокена(Запись) Цикл
		Пул = СервисПулов.ПулПоИдентификатору(ПулИдентификатор);
		Имена.Добавить(?(Пул = Неопределено,
			СтрШаблон("пул %1", Формат(ПулИдентификатор, "ЧГ=0")), Строка(Пул.Имя)));
	КонецЦикла;

	Возврат ?(Имена.Количество() > 0, СтрСоединить(Имена, ", "), "весь хаб");

КонецФункции

Функция КнопкаОтзыва(Знач Запись, Знач Токен)

	Действие = Дом.АдресРаздела("tokens") + "/"
		+ Формат(Запись.Идентификатор, "ЧГ=0") + "/revoke";

	Ячейка = Кит.Ячейка();
	Форма = Ячейка.Добавить(Кит.Форма(Действие, Токен, "строкой"));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		"Отозвать", "опасная", "малый")));
	Возврат Ячейка;

КонецФункции

Функция ФормаВыпуска(Знач Токен, Знач Заявка, Знач ВидимыеПулы)

	Форма = Кит.Форма(Дом.АдресРаздела("tokens"), Токен, "столбик");

	Форма.Добавить(ПолеИмени(Заявка));
	Форма.Добавить(ОбластиДоступа(Заявка));
	Форма.Добавить(ГдеДействуетТокен(Заявка, ВидимыеПулы));
	Форма.Добавить(ПолеСрока(Заявка));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер",
		"Выпустить токен", "основная", "обычный")));

	Возврат Форма;

КонецФункции

Функция ПолеИмени(Знач Заявка)
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Плейсхолдер, Значение",
		ИмяПоляИмени(), "Имя (зачем этот токен)", "например ноутбук", Заявка.Имя));
КонецФункции

// Области — флажки, а не строка: скоупы вписывали руками, и опечатка в них выпускала
// токен, который молча ничего не может.
Функция ОбластиДоступа(Знач Заявка)

	Группа = Кит.Группа("Что можно делать этим токеном", "простая");
	Группа.Добавить(Флажок(ИмяПоляЧтения(), "чтение — скачивать пакеты и читать метаданные",
		"1", Заявка.Чтение));
	Группа.Добавить(Флажок(ИмяПоляЗаписи(), "запись — публиковать версии и менять настройки",
		"1", Заявка.Запись));
	Возврат Группа;

КонецФункции

// По умолчанию токен действует на весь хаб, и списка пулов в форме нет: на инсталляции
// с сотнями пулов он был бы стеной флажков ради случая, который нужен единицам. Сужение —
// отдельное действие: кнопка открывает окно подбора, а выбранное возвращается сюда
// именами, каждое своим флажком.
Функция ГдеДействуетТокен(Знач Заявка, Знач ВидимыеПулы)

	Группа = Кит.Группа("Где действует токен", "простая");

	Если ВидимыеПулы.Количество() = 0 Тогда
		Группа.Добавить(Кит.Примечание("Доступных пулов нет — токен будет действовать на весь хаб."));
		Возврат Группа;
	КонецЕсли;

	Отмеченные = ОтмеченныеПулы(Заявка, ВидимыеПулы);
	Если Отмеченные.Количество() = 0 Тогда
		Группа.Добавить(Кит.Примечание(
			"Весь хаб: токен будет работать во всех пулах, которые вам доступны."));
	Иначе
		Группа.Добавить(Кит.Примечание(
			"Токен будет работать только в этих пулах. Снимите отметку, чтобы убрать пул из набора."));
		Для Каждого Пул Из Отмеченные Цикл
			Группа.Добавить(Флажок(Подбор.ИмяПоляПулов(), Строка(Пул.Имя),
				Формат(Пул.Идентификатор, "ЧГ=0"), Истина));
		КонецЦикла;
	КонецЕсли;

	Группа.Добавить(КнопкаПодбора(Отмеченные.Количество() > 0));
	Возврат Группа;

КонецФункции

// Кнопка отправляет ТУ ЖЕ форму с операцией подбора: так набранные имя и срок доезжают
// до окна вместе с набором. Без валидации — обязательный срок она как раз может ещё
// не спрашивать.
Функция КнопкаПодбора(Знач ЕстьНабор)

	Ряд = Кит.Ряд("справа");
	Ряд.Добавить(Кит.Кнопка(Новый Структура(
		"Подпись, Вариант, Размер, Иконка, Имя, Значение, БезВалидации",
		?(ЕстьНабор, "Изменить набор пулов", "Выбрать пулы"), "вторичная", "малый", "куб",
		Подбор.ИмяПоляОперации(), Подбор.ОперацияОткрытия(), Истина)));
	Возврат Ряд;

КонецФункции

// Набор — это пулы, а не идентификаторы: имя пула на экране берётся из того же списка
// видимых, по которому набор и сверен.
Функция ОтмеченныеПулы(Знач Заявка, Знач ВидимыеПулы)

	Результат = Новый Массив();
	Для Каждого Пул Из ВидимыеПулы Цикл
		Если Заявка.Пулы.Найти(Формат(Пул.Идентификатор, "ЧГ=0")) <> Неопределено Тогда
			Результат.Добавить(Пул);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Окно подбора живёт на экране только открытым: закрытое оно ничем не управляется —
// открывает его кнопка формы, то есть сервер.
Функция ОкноПодбора(Знач Токен, Знач Заявка, Знач ВидимыеПулы)

	Если НЕ Заявка.Подбор Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Параметры = Новый Структура();
	Параметры.Вставить("Адрес", Дом.АдресРаздела("tokens"));
	Параметры.Вставить("Токен", Токен);
	Параметры.Вставить("ВидимыеПулы", ВидимыеПулы);
	Параметры.Вставить("Отмеченные", Заявка.Пулы);
	Параметры.Вставить("Поиск", Заявка.Поиск);
	Параметры.Вставить("Черновик", ЧерновикЗаявки(Заявка));
	Возврат Подбор.Окно(Параметры);

КонецФункции

Функция Флажок(Знач Имя, Знач Метка, Знач Значение, Знач Отмечено)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Отмечено",
		Имя, Метка, "флажок", Значение, Отмечено));

КонецФункции

// Поле объявлено обязательным в разметке — сервер требует его так же строго.
Функция ПолеСрока(Знач Заявка)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Значение, Обязательное, Подсказка",
		ИмяПоляСрока(), "Срок действия, дней", "число", Заявка.Срок, Истина,
		СтрШаблон("От 1 до %1 дней. Бессрочных токенов хаб не выпускает.",
			Формат(СервисТокенов.ПотолокСрокаДней(), "ЧГ=0"))));

КонецФункции

Функция ЯчейкаТекста(Знач Значение)

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Текст(Значение));
	Возврат Ячейка;

КонецФункции

Функция ДатаТекстом(Знач Значение)
	Возврат ?(ЗначениеЗаполнено(Значение), Формат(Значение, "ДЛФ=D"), "");
КонецФункции

// Пустая дата бывает только у ключей, выпущенных до запрета бессрочных.
Функция СрокТекстом(Знач Значение)
	Возврат ?(ЗначениеЗаполнено(Значение), Формат(Значение, "ДЛФ=D"),
		"бессрочно — выпущен до запрета, отзовите");
КонецФункции

#КонецОбласти

// Гейт «ключ не размножается» — до разбора формы и до CSRF, чтобы отказ назывался своим именем.
Функция КлючамиМожноУправлять(Ответ, Знач Вердикт, Знач КукиЗапроса)

	Если Перехватчик.УправлениеКлючамиРазрешено(Вердикт.Принципал) Тогда
		Возврат Истина;
	КонецЕсли;
	Ответы.ОтдатьЗапрещено(Ответ, Вердикт.Пользователь,
		Тексты.Текст("office.tokens.key-cannot-manage-keys"), КукиЗапроса);
	Возврат Ложь;

КонецФункции

&Контроллер("/me/settings")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _Гвард,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисТокенов") _СервисТокенов,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомАккаунта") _Дом,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "ГвардЧтенияПула") _ЧтениеПулов,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ФормаПодбораПулов") _Подбор)

	Числа = _Числа;
	Перехватчик = _Перехватчик;

	Гвард = _Гвард;
	Кит = _Кит;
	Тексты = _Тексты;
	Защита = _Защита;
	РазборФормы = _РазборФормы;
	СервисТокенов = _СервисТокенов;
	Ответы = _Ответы;
	Дом = _Дом;
	РендерерНастроек = _РендерерНастроек;
	ЧтениеПулов = _ЧтениеПулов;
	СервисПулов = _СервисПулов;
	Подбор = _Подбор;

КонецПроцедуры
