// Тексты района «Хаб»: разделы настроек хаба, метки ключей настроек, провайдеры входа и почта.

// Кладёт тексты в словарь интерфейса.
//
// Параметры:
//  Словарь - СловарьТекстов - словарь, который собирается из частей.
//
Процедура Наполнить(Знач Словарь) Экспорт

	КлючиПулов(Словарь);
	КлючиДомаХаба(Словарь);
	КлючиЗначенийНастроек(Словарь);
	КлючиНастроекРеестра(Словарь);
	КлючиНастроекПодсистем(Словарь);
	КлючиПровайдеровВхода(Словарь);
	КлючиПочты(Словарь);

КонецПроцедуры

// Раздел «Пулы»: список пулов и заведение пула.
Процедура КлючиПулов(Словарь)

	Словарь.Добавить("access.pools.create.title", "Создать пул");
	Словарь.Добавить("access.pools.create.lead", "Пул заводится сразу и пустым: пакеты в него"
		+ " публикуются обычным opm push.");
	Словарь.Добавить("access.pools.create.denied", "Создание пулов доступно по праву на уровне хаба"
		+ " (обратитесь к администратору).");
	Словарь.Добавить("access.pools.create.name", "Имя пула");
	Словарь.Добавить("access.pools.create.type", "Тип");
	Словарь.Добавить("access.pools.create.type.hint", "Личное пространство заводится при регистрации,"
		+ " основной пул — один на хаб");
	Словарь.Добавить("access.pools.create.type.custom", "проектный");
	Словарь.Добавить("access.pools.create.visibility", "Видимость");
	Словарь.Добавить("access.pools.create.visibility.on", "публичный");
	Словарь.Добавить("access.pools.create.visibility.off", "приватный");
	Словарь.Добавить("access.pools.create.submit", "Создать пул");
	Словарь.Добавить("access.pools.create.failed", "Не удалось создать пул: %1");
	Словарь.Добавить("access.pools.filter.label", "Отбор по имени пула");
	Словарь.Добавить("access.pools.filter.placeholder", "часть имени");
	Словарь.Добавить("access.pools.filter.submit", "Отобрать");
	Словарь.Добавить("access.pools.empty.filtered.lead", "Попробуйте другую подстроку имени.");
	Словарь.Добавить("access.pools.personal", "Личные пространства (%1)");
	Словарь.Добавить("access.pools.col.pool", "Пул");
	Словарь.Добавить("access.pools.col.props", "Свойства");
	Словарь.Добавить("access.pools.action.settings", "Настройки пула");
	Словарь.Добавить("access.pools.action.access", "Права доступа");
	Словарь.Добавить("access.pools.table.empty", "Пулов нет");
	Словарь.Добавить("access.pools.default.action", "Сделать основным");
	Словарь.Добавить("access.pools.default.failed", "Не удалось назначить основной пул: %1");

КонецПроцедуры

// Дом «Хаб»: разделы настроек хаба.
Процедура КлючиДомаХаба(Словарь)

	Словарь.Добавить("settings.hub.title", "Настройки хаба");
	Словарь.Добавить("settings.hub.lead", "То, чем администратор хаба распоряжается: кто входит,"
		+ " как хаб выглядит, кому что позволено и чем он ходит наружу. У каждого значения"
		+ " виден источник — умолчание хаба или введённое здесь. Размеры, таймауты, интервалы"
		+ " и адреса хранилища задаёт тот, кто разворачивает инсталляцию.");
	Словарь.Добавить("settings.hub.nav.identity", "Базовые настройки");
	Словарь.Добавить("settings.hub.nav.branding", "Брендирование");
	Словарь.Добавить("settings.hub.nav.login", "Вход и регистрация");
	Словарь.Добавить("settings.hub.nav.people", "Люди");
	Словарь.Добавить("settings.hub.nav.pools", "Пулы");
	Словарь.Добавить("settings.hub.nav.storage", "Хранилище");
	Словарь.Добавить("settings.hub.nav.trusted", "Доверенная публикация");
	Словарь.Добавить("settings.hub.nav.mail", "Почта");
	Словарь.Добавить("settings.hub.nav.mirrors", "Зеркалирование");
	Словарь.Добавить("settings.hub.nav.webhooks", "Подписки на события");
	Словарь.Добавить("settings.hub.nav.password", "Политика пароля");
	Словарь.Добавить("settings.hub.nav.providers", "Провайдеры входа");
	Словарь.Добавить("settings.hub.nav.legacy", "Легаси-флоу");
	Словарь.Добавить("settings.hub.block.delivery", "Доставка уведомлений");
	Словарь.Добавить("settings.hub.nav.proxy", "Прокси апстрима");
	Словарь.Добавить("settings.hub.nav.audit", "Аудит");
	Словарь.Добавить("settings.hub.nav.maintenance", "Обслуживание");
	Словарь.Добавить("settings.hub.screen.users", "Пользователи");
	Словарь.Добавить("settings.hub.screen.groups", "Группы");
	Словарь.Добавить("settings.hub.screens.title", "Отдельные экраны раздела");
	Словарь.Добавить("settings.hub.screens.lead", "Эти экраны пока живут по своим адресам"
		+ " и переедут в этот раздел позже.");
	Словарь.Добавить("settings.hub.fine.title", "Тонкие настройки");
	Словарь.Добавить("settings.hub.fine.lead", "Значения с рабочими умолчаниями: их меняют,"
		+ " когда об этом просит нагрузка, регламент или чужая интеграция.");
	Словарь.Добавить("settings.hub.pools.lead", "Правила пулов на этом хабе.");
	Словарь.Добавить("settings.hub.pools.main.title", "Основной пул хаба");
	Словарь.Добавить("settings.hub.pools.main.lead", "Пул, в который ведут короткие адреса"
		+ " /download, /dev-channel и /push.");
	Словарь.Добавить("settings.hub.pools.main.label", "Основной пул");
	Словарь.Добавить("settings.hub.pools.main.hint", "Переключается в списке ниже:"
		+ " меню строки пула, «Сделать основным»");
	Словарь.Добавить("settings.hub.pools.main.none", "не назначен — короткие адреса отвечают отказом");

	Словарь.Добавить("settings.hub.pools.list.title", "Пулы хаба");
	Словарь.Добавить("settings.hub.pools.list.lead", "Все пулы инсталляции: видимость, занятое место,"
		+ " квота и признак основного. Остальные настройки пула живут в его доме.");
	Словарь.Добавить("settings.hub.pools.col.usage", "Занято и квота");
	Словарь.Добавить("settings.hub.pools.quota.inherited", "квота хаба");
	Словарь.Добавить("settings.hub.pools.menu.title", "Действия с пулом «%1»");
	Словарь.Добавить("settings.hub.pools.action.quota", "Изменить квоту");
	Словарь.Добавить("settings.hub.pools.quota.title", "Квота и видимость пула «%1»");
	Словарь.Добавить("settings.hub.pools.quota.lead", "Квоту пула назначает только администратор хаба;"
		+ " владелец пула видит её у себя, но не меняет.");
	Словарь.Добавить("settings.hub.pools.quota.button", "Применить");
	Словарь.Добавить("settings.hub.pools.quota.error.pool", "Квота НЕ изменена: пул не указан.");
	Словарь.Добавить("settings.hub.pools.quota.error.number",
		"Квота НЕ изменена: ожидается целое число мегабайт (0 — без лимита).");
	Словарь.Добавить("settings.hub.pools.quota.error.cap", "Квота НЕ изменена: не больше %1 МБ.");
	Словарь.Добавить("settings.hub.pools.quota.error.apply", "Квота НЕ изменена: %1");

	Словарь.Добавить("settings.hub.pools.personal.confirm.title", "Выключить личные пространства");
	Словарь.Добавить("settings.hub.pools.personal.confirm.lead", "Выключение сносит все личные пулы"
		+ " хаба вместе с содержимым. Восстановить их будет нечем.");
	Словарь.Добавить("settings.hub.pools.personal.confirm.counts", "Будет удалено безвозвратно:"
		+ " личных пространств — %1, из них с пакетами — %2; пакетов — %3, версий — %4.");
	Словарь.Добавить("settings.hub.pools.personal.confirm.echo.label", "Число удаляемых пространств");
	Словарь.Добавить("settings.hub.pools.personal.confirm.echo.hint", "Введите %1 — ровно столько"
		+ " личных пространств будет снесено.");
	Словарь.Добавить("settings.hub.pools.personal.confirm.button", "Снести личные пространства");
	Словарь.Добавить("settings.hub.pools.personal.error.echo", "Ничего не удалено: введено не то"
		+ " число. Чтобы снести личные пространства, повторите ровно %1.");
	Словарь.Добавить("settings.hub.pools.personal.error.apply",
		"Настройка «Личные пространства» не сохранена: %1");
	Словарь.Добавить("settings.hub.pools.personal.error.off", "Личные пространства уже выключены:"
		+ " сносить нечего. Обновите страницу.");
	Словарь.Добавить("settings.hub.pools.personal.error.wipe", "Снос личных пространств не выполнен:"
		+ " %1. Настройка осталась включённой, операцию можно повторить.");
	Словарь.Добавить("settings.hub.pools.personal.error.grant", "Раздача личных пространств"
		+ " не выполнена: %1");
	Словарь.Добавить("settings.hub.pools.personal.off.done", "Личные пространства выключены:"
		+ " снесено пространств — %1, пакетов — %2, версий — %3.");
	Словарь.Добавить("settings.hub.pools.personal.off.partial", "Снесено пространств — %1,"
		+ " но %2 снести не удалось: причина в журнале хаба. Настройка осталась включённой —"
		+ " повторите операцию, когда причина устранена.");
	Словарь.Добавить("settings.hub.pools.personal.on.done", "Личные пространства включены:"
		+ " создано — %1, уже было — %2, пропущено отключённых учёток — %3,"
		+ " осталось без пространства — %4.");

	Словарь.Добавить("settings.hub.passwordlogin.confirm.title", "Выключить вход по логину и паролю");
	Словарь.Добавить("settings.hub.passwordlogin.confirm.lead", "После выключения на странице входа"
		+ " не останется полей логина и пароля, а POST входа, вход в API и регистрация"
		+ " с паролем будут отвечать отказом. Войти можно будет только через провайдера.");
	Словарь.Добавить("settings.hub.passwordlogin.confirm.counts", "Администраторов, готовых войти"
		+ " через провайдера, — %1; включённых провайдеров входа — %2.");
	Словарь.Добавить("settings.hub.passwordlogin.confirm.stays", "Выключение НЕ гасит уже выданное:"
		+ " открытые сессии браузера продолжают работать, токены доступа (PAT) продолжают"
		+ " действовать, смена собственного пароля в кабинете остаётся доступной, а вход"
		+ " CLI и мастер первого запуска пароля и не спрашивают. Если причина выключения —"
		+ " утёкший пароль, отдельно завершите сессии и отзовите токены.");
	Словарь.Добавить("settings.hub.passwordlogin.confirm.rescue", "Если провайдер сломается, форму"
		+ " временно возвращает переменная окружения OSHUB_AUTH_PASSWORD_ENABLED=true:"
		+ " пока она задана, значение форсировано конфигурацией и этот тумблер не"
		+ " редактируется. Штатный возврат — войти провайдером и включить тумблер обратно,"
		+ " после чего переменную убрать.");
	Словарь.Добавить("settings.hub.passwordlogin.confirm.echo.label", "Подтверждение");
	Словарь.Добавить("settings.hub.passwordlogin.confirm.echo.hint", "Введите «%1» — иначе ничего"
		+ " не изменится.");
	Словарь.Добавить("settings.hub.passwordlogin.confirm.echo.sample", "выключить");
	Словарь.Добавить("settings.hub.passwordlogin.confirm.button", "Выключить парольный вход");
	Словарь.Добавить("settings.hub.passwordlogin.error.echo", "Ничего не изменилось: введено не то"
		+ " слово. Чтобы выключить парольный вход, повторите ровно «%1».");
	Словарь.Добавить("settings.hub.passwordlogin.error.apply",
		"Настройка «Вход по логину и паролю» не сохранена: %1");
	Словарь.Добавить("settings.hub.passwordlogin.error.off", "Вход по логину и паролю уже выключен:"
		+ " выключать нечего. Обновите страницу.");
	Словарь.Добавить("settings.hub.passwordlogin.error.lockout",
		"Вход по логину и паролю оставлен включённым: %1");
	Словарь.Добавить("settings.hub.passwordlogin.lockout.providers",
		"на хабе нет ни одного включённого провайдера входа, и после выключения формы"
		+ " войти будет нечем. Заведите провайдера в разделе «Провайдеры входа»"
		+ " (/hub/settings/providers) и войдите через него хотя бы одним администратором.");
	Словарь.Добавить("settings.hub.passwordlogin.lockout.identities",
		"ни у одного администратора хаба нет привязанной личности включённого провайдера,"
		+ " и после выключения формы войти будет некому. Привяжите провайдера в кабинете"
		+ " (/me/settings/oidc) хотя бы одному администратору.");
	Словарь.Добавить("settings.hub.passwordlogin.off.done", "Вход по логину и паролю выключен:"
		+ " на странице входа остались только провайдеры.");
	Словарь.Добавить("settings.hub.passwordlogin.on.done", "Вход по логину и паролю включён:"
		+ " форма логина и пароля снова на странице входа.");

	Словарь.Добавить("settings.hub.error.section", "Раздел настроек не найден");
	Словарь.Добавить("settings.hub.error.operation", "Неизвестная операция раздела:"
		+ " обновите страницу и повторите действие");
	Словарь.Добавить("settings.hub.error.key", "Эта настройка не редактируется в текущем разделе");
	Словарь.Добавить("settings.hub.error.field", "Настройка «%1» не сохранена: %2.");
	Словарь.Добавить("settings.hub.error.applied",
		"Остальная форма уже применена: %1 — эти значения действуют.");
	Словарь.Добавить("settings.hub.error.applied.none", "Ничего из формы не применено.");

	// пояснения разделов дома; заголовок раздела приходит из nav.*
	Словарь.Добавить("settings.hub.identity.lead",
		"Как хаб представляется клиентам opm и браузеру: внешний адрес и порт, а также знает"
		+ " ли opm этот хаб по умолчанию.");
	Словарь.Добавить("settings.hub.branding.lead",
		"Как хаб называет себя и как выглядит по умолчанию: название, подпись подвала,"
		+ " тема и акцент. Значения применяются сразу; тему и акцент посетитель может"
		+ " переопределить в своём аккаунте.");
	Словарь.Добавить("settings.hub.login.lead", "Как попадают в этот хаб: кто может завести учётную"
		+ " запись, чем можно войти и сколько живут выданные сессии и приглашения.");
	Словарь.Добавить("settings.hub.people.lead", "Учётные записи хаба и группы, через которые им"
		+ " выдаются права.");
	Словарь.Добавить("settings.hub.mail.lead", "Как хаб отправляет письма: приглашения, сброс пароля"
		+ " и подтверждение адреса.");
	Словарь.Добавить("settings.hub.trusted.lead", "На каком внешнем доказательстве хаб пускает"
		+ " публиковать без своей роли.");
	Словарь.Добавить("settings.hub.mirrors.lead",
		"Числа плановой репликации с чужих хабов: сколько зеркал разрешено пулу, как часто"
		+ " они ходят к источнику и через сколько молчания прогон считается брошенным."
		+ " Предела на размер привозимого пакета здесь нет — приезжающее судится теми же"
		+ " числами приёма, что и публикация снаружи, в разделе «Хранилище».");
	Словарь.Добавить("settings.hub.mirrors.overview.title", "Зеркала всех пулов");
	Словарь.Добавить("settings.hub.mirrors.overview.lead", "Список зеркал по всем пулам, которыми"
		+ " вы распоряжаетесь: состояние прогона и дата последней синхронизации в одном"
		+ " месте — без обхода настроек пулов по одному.");
	Словарь.Добавить("settings.hub.mirrors.overview.button", "Открыть обзор зеркал");
	Словарь.Добавить("settings.hub.password.section.lead", "Каким хаб считает годный пароль. Требования"
		+ " применяются к новым паролям — регистрации, смене, приглашению и восстановлению;"
		+ " уже заведённые пароли ужесточение не ломает, вход по ним продолжает работать.");
	Словарь.Добавить("settings.hub.delivery.lead", "Слать ли уведомления вообще и пускать ли их"
		+ " по http. Темп разбора очереди и повторы задаются конфигурацией инсталляции.");
	Словарь.Добавить("settings.hub.legacy.lead", "Старый путь публикации по токену GitHub: он"
		+ " остался ради пакетов, переехавших из oscript-library, и к доверенной публикации"
		+ " отношения не имеет.");
	Словарь.Добавить("settings.hub.proxy.lead", "Как хаб ходит в чужие хабы за пакетами, которых"
		+ " у него нет: таймауты, срок кэша отрицательных ответов и принудительный офлайн.");

	Словарь.Добавить("settings.hub.storage.state.title", "Хранилище");
	Словарь.Добавить("settings.hub.storage.state.lead",
		"Куда хаб складывает опубликованные пакеты и сколько там места. Всё это задаёт тот,"
		+ " кто разворачивает инсталляцию; из интерфейса состояние читают, а не меняют.");
	Словарь.Добавить("settings.hub.storage.meter.label", "Занято места в хранилище");
	Словарь.Добавить("settings.hub.storage.meter.caption", "%1 из %2");
	Словарь.Добавить("settings.hub.storage.meter.free",
		"Занято %1. Общего потолка объёма у хаба нет — место ограничивает только диск"
		+ " и квоты отдельных пулов.");
	Словарь.Добавить("settings.hub.storage.meter.counted",
		"Занятое — по учёту самого хаба: он складывает счётчики пулов и раз в час сверяет"
		+ " их с хранилищем. Диск при отрисовке экрана не опрашивается.");
	Словарь.Добавить("settings.hub.storage.meter.unknown",
		"Занято — неизвестно: хранилище не отвечает, и сверить с ним занятое место нечем.");
	Словарь.Добавить("settings.hub.storage.health.lead",
		"Состояние хаб снимает сам, каждые %1 с. Экран показывает последний ответ хранилища"
		+ " и своей проверки не заказывает.");
	Словарь.Добавить("settings.hub.storage.health.alive", "Отвечает");
