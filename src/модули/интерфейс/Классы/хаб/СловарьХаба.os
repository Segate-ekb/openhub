КонецПроцедуры

// Раздел «Провайдеры входа»: форма провайдера, адреса, правило по странам.
Процедура КлючиПровайдеровВхода(Словарь)

	Словарь.Добавить("providers.section.title", "Провайдеры входа");
	Словарь.Добавить("providers.section.lead",
		"Внешние поставщики личности: кнопки на странице входа и привязки учётных записей.");
	Словарь.Добавить("providers.create.title", "Завести провайдера");
	Словарь.Добавить("providers.create.lead",
		"Выберите пресет — форма покажет только те поля, которые он не подставляет сам."
		+ " Обычно остаётся внести client_id и client_secret из регистрации приложения"
		+ " у провайдера.");

	Словарь.Добавить("providers.list.empty", "Провайдеры входа не заведены.");
	Словарь.Добавить("providers.list.note",
		"Секрет клиента не показывается. Чтобы сменить его, введите новое значение в поле"
		+ " секрета — пустое поле оставляет прежний секрет.");

	Словарь.Добавить("providers.state.on", "Включён");
	Словарь.Добавить("providers.state.off", "Выключен");
	Словарь.Добавить("providers.state.overridden", "Задан конфигурацией");
	Словарь.Добавить("providers.locked.hint",
		"Провайдер с таким именем объявлен конфигурацией инсталляции — настройкой oshub.oidc"
		+ " (переменные OSHUB_OIDC_*), и конфигурация побеждает. Уберите его из конфигурации —"
		+ " строка снова станет управляемой.");

	Словарь.Добавить("providers.protocol.hint",
		"OpenID Connect: руками задаётся только издатель (issuer) — конечные точки хаб"
		+ " прочитает у него сам, по адресу /.well-known/openid-configuration; так устроено"
		+ " большинство провайдеров. OAuth 2.0: дискавери у провайдера нет (так устроен"
		+ " GitHub), поэтому конечные точки авторизации, токена и профиля вводятся руками"
		+ " (точка адресов почты — по желанию), а издателя хаб назначает сам.");

	Словарь.Добавить("providers.icon.key", "Обобщённый значок (ключ)");

	Словарь.Добавить("providers.field.name", "Имя");
	Словарь.Добавить("providers.field.label", "Подпись кнопки");
	Словарь.Добавить("providers.field.icon", "Значок");
	Словарь.Добавить("providers.field.icon.hint",
		"Картинка рядом с провайдером; выбирается из встроенного набора");
	Словарь.Добавить("providers.field.preset.label", "Пресет провайдера");
	Словарь.Добавить("providers.field.preset.hint",
		"Пресет подставляет конечные точки, области, разбор профиля, подпись кнопки"
		+ " и значок. Поля, которых пресет не показывает, он задаёт сам.");
	Словарь.Добавить("providers.field.protocol", "Протокол");
	Словарь.Добавить("providers.field.client", "Идентификатор клиента (client_id)");
	Словарь.Добавить("providers.field.secret", "Секрет клиента (client_secret)");
	Словарь.Добавить("providers.field.secret.hint",
		"Пустое поле оставляет прежний секрет; показать сохранённый секрет хаб не умеет");
	Словарь.Добавить("providers.field.redirect", "Адрес возврата (redirect_uri)");
	Словарь.Добавить("providers.field.redirect.hint",
		"Пусто — хаб подставит адрес из URL инстанса. Заполняется руками, только если хаб"
		+ " стоит за прокси с другим внешним адресом.");
	Словарь.Добавить("providers.redirect.note",
		"Этот адрес нужно указать в настройках приложения на стороне провайдера.");
	Словарь.Добавить("providers.redirect.copy", "Скопировать");
	Словарь.Добавить("providers.redirect.unset",
		"Адрес возврата не определён: URL инстанса не задан (настройки хаба, раздел"
		+ " «Базовые настройки»), а вручную адрес не введён. Пока это так, провайдер"
		+ " работать не будет.");
	Словарь.Добавить("providers.field.scope", "Области (scope)");
	Словарь.Добавить("providers.field.scope.hint",
		"Что хаб просит у провайдера при входе. В форме заведения пустая графа означает"
		+ " умолчание — оно уже подставлено в поле. В форме правки пустая графа означает"
		+ " «оставить как было»: очистка поля прежние области не сбрасывает, для замены"
		+ " впишите нужные. Просите ровно то, без чего не собрать личность (обычно"
		+ " openid profile email): каждая лишняя область — это разрешение, которое"
		+ " провайдер покажет на экране согласия КАЖДОМУ входящему, а у части провайдеров"
		+ " ещё и потребует одобрения администратора организации.");
	Словарь.Добавить("providers.field.base", "Адрес инсталляции (для self-hosted GitLab)");
	Словарь.Добавить("providers.field.issuer", "Издатель (issuer)");
	Словарь.Добавить("providers.field.authorize", "Конечная точка авторизации");
	Словарь.Добавить("providers.field.token", "Конечная точка токена");
	Словарь.Добавить("providers.field.profile", "Конечная точка профиля");
	Словарь.Добавить("providers.field.emails", "Конечная точка адресов почты");
	Словарь.Добавить("providers.field.enabled", "Показывать кнопку на странице входа");

	Словарь.Добавить("providers.manual.legend", "Свой провайдер");
	Словарь.Добавить("providers.manual.note",
		"Заполняется только при пресете «Свой провайдер». Адреса обязаны быть https и не"
		+ " вести во внутреннюю сеть. Издатель OAuth2-провайдера назначает хаб сам.");
	Словарь.Добавить("providers.policies.legend", "Учётные записи и группы");
	Словарь.Добавить("providers.policies.note",
		"Автосоздание пускает в хаб личность, которая ещё не привязана ни к одной учётной"
		+ " записи. Механизмы групп отдают состав групп хаба стороне провайдера — задайте"
		+ " префикс, чтобы отделить их от локальных групп с правами.");
	Словарь.Добавить("providers.field.autoprovision", "Создавать учётную запись при первом входе");
	Словарь.Добавить("providers.field.groups.jit", "Создавать группы из клейма");
	Словарь.Добавить("providers.field.groups.link", "Связывать клейм с существующей группой по имени");
	Словарь.Добавить("providers.field.groups.claim", "Имя клейма групп");
	Словарь.Добавить("providers.field.groups.prefix", "Префикс имён групп");

	Словарь.Добавить("providers.button.create", "Завести");
	Словарь.Добавить("providers.button.save", "Сохранить");
	Словарь.Добавить("providers.button.enable", "Включить");
	Словарь.Добавить("providers.button.disable", "Выключить");
	Словарь.Добавить("providers.button.delete", "Удалить");

	// правило «закрыт в странах»: окно на карточке провайдера
	Словарь.Добавить("providers.geo.title", "Страны и доступ: %1");
	Словарь.Добавить("providers.geo.lead",
		"Из перечисленных стран провайдер закрыт целиком: ни завести учётную запись,"
		+ " ни войти в существующую, ни привязать его в кабинете.");
	Словарь.Добавить("providers.geo.field", "Закрыт в странах");
	Словарь.Добавить("providers.geo.field.hint",
		"Коды стран ISO 3166-1 alpha-2 через запятую, например RU, BY. Пусто — правила нет,"
		+ " провайдер открыт всем. Посетитель, страну которого определить не удалось,"
		+ " считается пришедшим из закрытой страны.");
	Словарь.Добавить("providers.geo.closed", "Закрыт в странах: %1");
	Словарь.Добавить("providers.geo.closed.more", "Закрыт в странах: %1 и ещё %2");
	Словарь.Добавить("providers.geo.open", "Открыт посетителям из всех стран.");
	Словарь.Добавить("providers.geo.link", "Страны и доступ");
	Словарь.Добавить("providers.geo.accounts.none",
		"Учётных записей, для которых этот провайдер — единственный способ войти, нет.");
	Словарь.Добавить("providers.geo.accounts.some",
		"Учётных записей, для которых этот провайдер — единственный способ войти: %1.");
	Словарь.Добавить("providers.geo.fallback.password",
		"Вход по логину и паролю на хабе включён — им они и войдут.");
	Словарь.Добавить("providers.geo.fallback.recovery",
		"Восстановление пароля работает: ссылка уйдёт письмом на подтверждённый адрес.");
	Словарь.Добавить("providers.geo.fallback.none",
		"Вход по логину и паролю выключен, восстановление пароля недоступно: из закрытой"
		+ " страны этим учётным записям войти будет нечем, и помочь им сможет только"
		+ " администратор.");
	Словарь.Добавить("providers.geo.lockout",
		"каждый включённый провайдер закрыт правилом по стране, и после выключения формы"
		+ " посетителю из закрытой страны войти будет нечем. Снимите правило хотя бы"
		+ " с одного провайдера в разделе «Провайдеры входа» (/hub/settings/providers).");

	// встроенная база стран там, где администратор правит правило
	Словарь.Добавить("providers.geo.db.closes.everyone",
		"Пока хаб не может назвать страну ни одного посетителя, правило по стране закрывает"
		+ " провайдера ВСЕМ: посетитель с неопределённой страной считается пришедшим"
		+ " из закрытой. Положите файл базы стран и дождитесь построения индекса.");
	Словарь.Добавить("providers.geo.db.file",
		"База стран: %1, выпуск от %2 (%3 сут. назад).");
	Словарь.Добавить("providers.geo.db.stale",
		"Выпуск устарел: DB-IP обновляет базу раз в месяц. Положите свежий файл либо"
		+ " включите обновление из сети.");
	Словарь.Добавить("providers.geo.db.missing",
		"Файла базы стран нет: ожидается %1. Положите туда CSV-выпуск DB-IP Lite Country"
		+ " (как — в статье «Развёртывание», раздел «База стран посетителей») либо включите"
		+ " обновление из сети настройкой «Обновлять базу стран из сети».");
	Словарь.Добавить("providers.geo.db.index",
		"Хаб различает страны: %1 (диапазонов в памяти: %2).");
	Словарь.Добавить("providers.geo.db.building",
		"Индекс перестраивается под %1: правило вступит в силу, когда сборка закончится.");
	Словарь.Добавить("providers.geo.db.failed",
		"Прошлая сборка индекса не удалась: %1");
	Словарь.Добавить("providers.geo.db.unknown",
		"Состояние базы стран прочитать не удалось.");

	// какой страной хаб видит этот запрос: хаб видит посетителя, а не обратный прокси
	Словарь.Добавить("providers.geo.request.known",
		"Страна вашего запроса: %1 (источник: %2).");
	Словарь.Добавить("providers.geo.request.unwatched",
		"Ваш адрес публичный и ни в одну наблюдаемую страну не попадает — правило"
		+ " вашего запроса не касается.");
	Словарь.Добавить("providers.geo.request.unknown",
		"Страна вашего запроса не определена — %1. Если хаб стоит за обратным прокси,"
		+ " назовите его сети в oshub.instance.trusted_proxies — иначе хаб видит адрес"
		+ " прокси, а не посетителя, и правило закроет провайдера всем.");

КонецПроцедуры

// Раздел «Почта»: проверка отправки и метки ключей почты.
Процедура КлючиПочты(Словарь)

	Словарь.Добавить("settings.hub.mail.test.title", "Проверка отправки");
	Словарь.Добавить("settings.hub.mail.test.lead",
		"Хаб пошлёт проверочное письмо и покажет, чем закончилась попытка."
		+ " Помните: шифрование выбирает библиотека отправки, подлинность сертификата"
		+ " сервера не проверяется, и на порту без TLS пароль SMTP уходит открытым текстом.");
	Словарь.Добавить("settings.hub.mail.test.note", "Письмо уйдёт на адрес вашей учётной записи: %1.");
	Словарь.Добавить("settings.hub.mail.test.button", "Отправить проверочное письмо");
	Словарь.Добавить("settings.hub.mail.test.subject", "Проверка почты хаба");
	Словарь.Добавить("settings.hub.mail.test.body",
		"Это проверочное письмо. Если вы его читаете, отправка почты с хаба %1 настроена верно.");
	Словарь.Добавить("settings.hub.mail.test.done", "Письмо отправлено на %1. Проверьте почту.");
	Словарь.Добавить("settings.hub.mail.test.error.off",
		"Отправка почты не настроена: включите её, укажите сервер и адрес отправителя.");
	Словарь.Добавить("settings.hub.mail.test.error.noemail",
		"В вашей учётной записи не указан адрес — проверочное письмо слать некуда.");
	Словарь.Добавить("settings.hub.mail.test.error.address",
		"Адрес вашей учётной записи не годится для отправки: исправьте его в кабинете.");
	Словарь.Добавить("settings.hub.mail.test.error.send",
		"Письмо не отправлено: почтовый сервер не принял его. Причина — в журнале хаба.");

	Словарь.Добавить("settings.key.oshub-mail-enabled.label", "Отправка почты");
	Словарь.Добавить("settings.key.oshub-mail-enabled.hint",
		"Разрешает хабу слать письма. Выключено — хаб работает как обычно, просто без писем.");
	Словарь.Добавить("settings.key.oshub-mail-smtp-host.label", "Сервер SMTP");
	Словарь.Добавить("settings.key.oshub-mail-smtp-host.hint",
		"Имя или адрес почтового сервера, через который хаб отправляет письма.");
	Словарь.Добавить("settings.key.oshub-mail-smtp-port.label", "Порт SMTP");
	Словарь.Добавить("settings.key.oshub-mail-smtp-port.hint",
		"Порт решает и режим шифрования: 465 — TLS с первого байта, остальные порты —"
		+ " открытое соединение с переходом на TLS, только если сервер его предложит."
		+ " Отдельной настройки шифрования у хаба нет: библиотека отправки выбирает режим"
		+ " сама, и повлиять на выбор нечем.");
	Словарь.Добавить("settings.key.oshub-mail-smtp-user.label", "Пользователь SMTP");
	Словарь.Добавить("settings.key.oshub-mail-smtp-user.hint",
		"Имя пользователя для входа на почтовый сервер. Пусто — сервер без аутентификации.");
	Словарь.Добавить("settings.key.oshub-mail-smtp-password.label", "Пароль SMTP");
	Словарь.Добавить("settings.key.oshub-mail-smtp-password.hint",
		"Секрет: задаётся только конфигурацией или переменной окружения, в базе не хранится"
		+ " и на экране не показывается. ВНИМАНИЕ: библиотека отправки не проверяет"
		+ " подлинность сертификата сервера и не требует шифрования — на порту без TLS"
		+ " этот пароль уходит по проводу открытым текстом. Указывайте только свой сервер"
		+ " или сервер за доверенным каналом.");
	Словарь.Добавить("settings.key.oshub-mail-from.label", "Адрес отправителя");
	Словарь.Добавить("settings.key.oshub-mail-from.hint",
		"Адрес, от имени которого хаб шлёт письма. Пока он не задан или не похож на адрес,"
		+ " писем не будет вовсе — хаб считает почту ненастроенной.");

	Словарь.Добавить("settings.key.oshub-auth-email-confirm-enabled.label", "Подтверждение адреса письмом");
	Словарь.Добавить("settings.key.oshub-auth-email-confirm-enabled.hint",
		"Хаб шлёт письмо со ссылкой на адрес новой учётной записи. Права подтверждение"
		+ " не раздаёт: неподтверждённый адрес отличается только тем, что о нём сказано,"
		+ " и на него хаб не шлёт ничего, кроме самого письма подтверждения.");
	Словарь.Добавить("settings.key.oshub-auth-email-confirm-ttl-hours.label", "Срок ссылки подтверждения, ч");
	Словарь.Добавить("settings.key.oshub-auth-email-confirm-ttl-hours.hint",
		"Сколько часов живёт ссылка из письма. Сработает она один раз.");

КонецПроцедуры

&Прозвище("ЧастьСловаряТекстов")
&Порядок(40)
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
