// Операции раздела «Пулы» дома «Хаб»: заведение пула окном, назначение основного пула
// и удаление пула с эхом имени. Исход каждой — домена плюс отказы у полей окна; право судит
// служба доступа, пульт переводит её отказ в слова.

Перем Гейт;          // ГейтФормы — CSRF-токен формы
Перем РазборФормы;
Перем Поля;          // ОкноПула — имена полей окон
Перем Служба;        // СлужбаДоступа (кабинет) — создание, основной пул и удаление: право судит она
Перем СервисПулов;   // СервисПулов (реестр) — пул по имени, правило имени, вердикт по квоте
Перем ГвардКвоты;    // ГвардКвотыПула (права) — квоту нового пула задаёт тот, кто вправе её менять
Перем Значения;      // ВитринаНастроек — операция сброса значений раздела
Перем Личные;        // ВитринаЛичныхПространств — операция выключения личных пространств
Перем Сбои;          // ТекстСбоя — причина сбоя человеку и отчёт в журнал
Перем Тексты;        // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Разбирает тело запроса и проверяет CSRF.
//
// Параметры:
//  Ответ - ОтветСервера.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  ТелоЗапроса - Строка.
//  КукиЗапроса - Куки - куки запроса.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - разобранная форма; Неопределено — ответ уже сформирован.
//
Функция Форма(Ответ, Знач Контекст, Знач ТелоЗапроса, Знач КукиЗапроса) Экспорт
	Возврат Гейт.СПринятымТокеном(Ответ, Контекст, РазборФормы.Разобрать(ТелоЗапроса), КукиЗапроса);
КонецФункции

// Пришла ли форма окна «Новый пул».
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоЗаведение(Знач Форма) Экспорт
	Возврат Операция(Форма) = Поля.ОперацияЗаведения();
КонецФункции

// Пришла ли на адрес раздела форма старой вкладки: её операция («пул-создать», «пул-основной»,
// «пул-квота») новой странице неизвестна. Такая форма отбивается, а не уходит молча в сохранение
// раздела. Адрес раздела принимает окно нового пула и формы значений раздела: их сохранение, сброс
// и выключение личных пространств.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Булево.
//
Функция ФормаРазделаУстарела(Знач Форма) Экспорт

	Операция = Операция(Форма);
	Возврат ЗначениеЗаполнено(Операция) И Операция <> Поля.ОперацияЗаведения()
		И Операция <> НРег(Значения.ОперацияСброса()) И Операция <> НРег(Личные.ЗначениеОперации());

КонецФункции

// Пришла ли на адрес строки («основной», «удалить») форма старой вкладки: формы строк операции
// не несут вовсе, любая операция — чужая.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Булево.
//
Функция ФормаСтрокиУстарела(Знач Форма) Экспорт
	Возврат ЗначениеЗаполнено(Операция(Форма));
КонецФункции

// Отказ формы старой вкладки: ничего не изменено.
//
// Возвращаемое значение:
//  Структура - исход (см. Создать), код 400.
//
Функция ОтказУстаревшей() Экспорт
	Возврат Отбито(Тексты.Текст("settings.hub.pools.error.stale"));
КонецФункции

// Почему пулу нельзя дать имя — тем же правилом и той же занятостью, что ответит заведение.
//
// Параметры:
//  Имя - Строка - проверяемое имя.
//
// Возвращаемое значение:
//  Строка - причина словами; "" — имя свободно.
//
Функция ОтказИмени(Знач Имя) Экспорт
	Возврат СервисПулов.ПричинаОтказаИмени(Имя);
КонецФункции

// Заводит пул по окну «Новый пул»: владельцем становится заводящий.
//
// Параметры:
//  Пользователь - Пользователь - администратор, заводящий пул.
//  Форма - Соответствие - разобранная форма окна.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка — причина отказа словами,
//              заполнена у любого отказа), Отказы (Соответствие — имя поля -> отказ под полем).
//
Функция Создать(Знач Пользователь, Знач Форма) Экспорт

	Имя = Текст(Форма, Поля.ИмяПоляИмени());
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Возврат ОтбитоПолем(Поля.ИмяПоляИмени(), Тексты.Текст("settings.hub.pools.new.name.required"));
	КонецЕсли;
	Причина = СервисПулов.ПричинаОтказаИмени(Имя);
	Если ЗначениеЗаполнено(Причина) Тогда
		Возврат ОтбитоПолем(Поля.ИмяПоляИмени(), Причина);
	КонецЕсли;

	Видимость = НРег(Текст(Форма, Поля.ИмяПоляВидимости()));
	Если Видимость <> "public" И Видимость <> "private" Тогда
		Возврат ОтбитоПолем(Поля.ИмяПоляВидимости(), Тексты.Текст("settings.hub.pools.new.visibility.unknown"));
	КонецЕсли;

	// пустая квота — квота хаба: окно печатает её значением по умолчанию
	Квота = Текст(Форма, Поля.ИмяПоляКвоты());
	Вердикт = СервисПулов.РассудитьКвоту(?(ЗначениеЗаполнено(Квота), Квота, СервисПулов.КвотаКакВХабе()));
	Если НЕ Вердикт.Успех Тогда
		Возврат ОтбитоПолем(Поля.ИмяПоляКвоты(), ПроблемаКвоты(Вердикт));
	КонецЕсли;
	// квоту задаёт только тот, кто вправе её менять; остальным — квота хаба
	СвояКвота = ?(ГвардКвоты.МожетМенятьКвоту(Пользователь), Вердикт.Квота, Неопределено);

	Попытка
		Служба.СоздатьПул(Пользователь, Имя, "custom", Видимость, СвояКвота);
	Исключение
		// между проверкой и записью имя могли занять: отказ домена — под имя
		Возврат ОтбитоПолем(Поля.ИмяПоляИмени(), Тексты.Шаблон("settings.hub.pools.new.failed",
			Сбои.Человеку(ИнформацияОбОшибке())));
	КонецПопытки;

	Возврат Удача();

КонецФункции

// Назначает пул основным пулом хаба: короткие адреса начинают вести в него.
//
// Параметры:
//  Пользователь - Пользователь - администратор, подтвердивший назначение.
//  Имя - Строка - имя пула из адреса маршрута.
//
// Возвращаемое значение:
//  Структура - см. Создать.
//
Функция СделатьОсновным(Знач Пользователь, Знач Имя) Экспорт

	Пул = СервисПулов.НайтиПул(Имя);
	Если Пул = Неопределено Тогда
		Возврат Отбито(Тексты.Шаблон("settings.hub.pools.error.missing", Имя), 404);
	КонецЕсли;

	Попытка
		Служба.НазначитьОсновнойПул(Пользователь, Пул.Идентификатор);
	Исключение
		// приватный пул и личное пространство домен отбивает словами: их человек и читает
		Возврат Отбито(Тексты.Шаблон("settings.hub.pools.primary.failed", Сбои.Человеку(ИнформацияОбОшибке())));
	КонецПопытки;

	Возврат Удача();

КонецФункции

// Удаляет пул со всем содержимым, если в эхо-поле набрано его имя. Эхо судится раньше домена:
// неподтверждённое удаление пул не трогает. Личное пространство здесь не удаляется: оно уходит
// вместе с учёткой.
//
// Параметры:
//  Пользователь - Пользователь - администратор.
//  Имя - Строка - имя пула из адреса маршрута.
//  Форма - Соответствие - разобранная форма подтверждения.
//
// Возвращаемое значение:
//  Структура - см. Создать; несовпавшее эхо — отказ под эхо-полем, домен не зовётся.
//
Функция Удалить(Знач Пользователь, Знач Имя, Знач Форма) Экспорт

	Пул = СервисПулов.НайтиПул(Имя);
	Если Пул = Неопределено Тогда
		Возврат Отбито(Тексты.Шаблон("settings.hub.pools.error.missing", Имя), 404);
	КонецЕсли;

	Если Пул.ЭтоЛичный() Тогда
		Возврат Отбито(Тексты.Шаблон("settings.hub.pools.delete.personal", Строка(Пул.Имя)));
	КонецЕсли;

	Если Текст(Форма, Поля.ИмяПоляИмени()) <> Строка(Пул.Имя) Тогда
		Возврат ОтбитоПолем(Поля.ИмяПоляИмени(),
			Тексты.Шаблон("settings.hub.pools.delete.echo.mismatch", Строка(Пул.Имя)));
	КонецЕсли;

	Попытка
		Служба.УдалитьПул(Пользователь, Пул.Идентификатор);
	Исключение
		// основной пул и идущий прогон зеркала домен отбивает словами; в лог пишет служба
		Возврат Отбито(Тексты.Шаблон("settings.hub.pools.delete.failed", Сбои.Человеку(ИнформацияОбОшибке())));
	КонецПопытки;

	Возврат Удача();

КонецФункции

#КонецОбласти

#Область Исходы

Функция Исход(Знач Успех, Знач Код, Знач Сообщение, Знач Отказы_)
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы", Успех, Код, Сообщение, Отказы_);
КонецФункции

Функция Удача()
	Возврат Исход(Истина, 303, "", Новый Соответствие());
КонецФункции

Функция Отбито(Знач Сообщение, Знач Код = 400)
	Возврат Исход(Ложь, Код, Сообщение, Новый Соответствие());
КонецФункции

Функция ОтбитоПолем(Знач Имя, Знач Сообщение)

	Результат = Отбито(Сообщение);
	Результат.Отказы.Вставить(Имя, Сообщение);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вердикт выносит СервисПулов: третьего источника этого правила в хабе нет.
Функция ПроблемаКвоты(Знач Вердикт)

	Если Вердикт.Причина = СервисПулов.ПричинаКвотаПотолок() Тогда
		Возврат Тексты.Шаблон("settings.hub.pools.new.quota.cap",
			Формат(СервисПулов.ПредельнаяКвотаМб(), "ЧГ=' '"));
	КонецЕсли;
	Возврат Тексты.Текст("settings.hub.pools.new.quota.number");

КонецФункции

Функция Операция(Знач Форма)
	Возврат НРег(Текст(Форма, Поля.ИмяПоляОперации()));
КонецФункции

Функция Текст(Знач Форма, Знач Имя)
	Возврат СокрЛП(РазборФормы.Поле(Форма, Имя));
КонецФункции

#КонецОбласти

&Прозвище("ПультПулов")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ОкноПула") _Поля,
	&Пластилин(Значение = "СлужбаДоступа") _Служба,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ГвардКвотыПула") _ГвардКвоты,
	&Пластилин(Значение = "ВитринаНастроек") _Значения,
	&Пластилин(Значение = "ВитринаЛичныхПространств") _Личные,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	Поля = _Поля;
	Служба = _Служба;
	СервисПулов = _СервисПулов;
	ГвардКвоты = _ГвардКвоты;
	Значения = _Значения;
	Личные = _Личные;
	Сбои = _Сбои;
	Тексты = _Тексты;

КонецПроцедуры
