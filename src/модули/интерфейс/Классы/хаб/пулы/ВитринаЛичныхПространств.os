// Окно предупреждения перед выключением настройки «Личные пространства» в разделе «Пулы»
// дома «Хаб».

Перем Кит;     // Кит (кит) — фабрика элементов экрана
Перем Тексты;  // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секция предупреждения: печатает посчитанные на месте числа и просит повторить эхом число
// удаляемых пространств; «Отмена» — ссылка на тот же раздел, возврат ничего не меняет.
//
// Параметры:
//  Сводка - Структура - Пулов, ПуловСПакетами, Пакетов, Версий.
//  Адрес - Строка - адрес раздела, куда ведёт «Отмена»; адрес и токен формы берутся у дома.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.Секция, опасная.
//
Функция СекцияПодтверждения(Знач Сводка, Знач Адрес) Экспорт

	Возврат Кит.Секция(Тексты.Текст("settings.hub.pools.personal.confirm.title"),
			Кит.Форма("",
				ПолеОперации(),
				ЧтоИсчезнет(Сводка),
				ПолеЭха(Сводка),
				Кит.Кнопка(Тексты.Текст("settings.hub.pools.personal.confirm.cancel")).Вторичная().Адрес(Адрес),
				Кит.Кнопка(Тексты.Текст("settings.hub.pools.personal.confirm.button")).Опасная()))
		.Лид(Тексты.Текст("settings.hub.pools.personal.confirm.lead")).Иконка("предупреждение").Опасная();

КонецФункции

// Имя скрытого поля операции окна предупреждения.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Значение операции «выключить личные пространства».
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеОперации() Экспорт
	Возврат "личные-пространства";
КонецФункции

// Имя поля, в которое человек вводит эхо — число удаляемых пространств.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляЭха() Экспорт
	Возврат "подтверждение";
КонецФункции

#КонецОбласти

#Область СодержимоеОкна

Функция ПолеОперации()
	Возврат Кит.СкрытоеПоле(ИмяПоляОперации(), ЗначениеОперации());
КонецФункции

// Цена выключения числами: сколько пулов, сколько из них с пакетами и что в них лежит.
Функция ЧтоИсчезнет(Знач Сводка)

	Возврат Кит.Примечание(Тексты.Шаблон("settings.hub.pools.personal.confirm.counts",
		ЧислоПулов(Сводка), Тексты.ЧислоТекстом(Сводка.ПуловСПакетами),
		Тексты.ЧислоТекстом(Сводка.Пакетов), Тексты.ЧислоТекстом(Сводка.Версий)));

КонецФункции

// Эхо — то же число пулов: человек повторяет его руками, и случайное нажатие не проходит.
Функция ПолеЭха(Знач Сводка)

	Возврат Кит.Поле(ИмяПоляЭха(), Тексты.Текст("settings.hub.pools.personal.confirm.echo.label"))
		.Обязательное()
		.Подсказка(Тексты.Шаблон("settings.hub.pools.personal.confirm.echo.hint", ЧислоПулов(Сводка)));

КонецФункции

Функция ЧислоПулов(Знач Сводка)
	Возврат Тексты.ЧислоТекстом(Сводка.Пулов);
КонецФункции

#КонецОбласти

&Прозвище("ВитринаЛичныхПространств")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;

КонецПроцедуры
