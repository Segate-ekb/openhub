// Окна раздела «Пулы» дома «Хаб»: новый пул, подтверждения «Сделать основным» и удаления пула.
// Поля окон называет этот класс — по тем же именам их читает пульт пулов. Набранное и отказы
// отбитой формы окно берёт у состояния окна раздела.

Перем Кит;          // Кит (кит) — фабрика элементов экрана
Перем Окна;         // ОкноРаздела — набранное и отказы окна
Перем Отборы;       // ОтборПулов — отбор списка скрытыми полями формы
Перем Правила;      // ПравилаИменования (реестр) — правило имени пула для поля
Перем СервисПулов;  // СервисПулов (реестр) — квота «как в хабе» по умолчанию
Перем Тексты;       // ТекстыИнтерфейса (кит)

#Область ИменаПолей

// Поле имени: в окне нового пула и эхо подтверждения удаления.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляИмени() Экспорт
	Возврат "имя";
КонецФункции

// Поле видимости нового пула: public | private.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляВидимости() Экспорт
	Возврат "видимость";
КонецФункции

// Поле квоты нового пула в мегабайтах.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляКвоты() Экспорт
	Возврат "квота_мб";
КонецФункции

// Скрытое поле операции формы раздела.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Операция окна «Новый пул»: ею форма окна отличается от формы значений раздела, которая уходит
// на тот же адрес.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияЗаведения() Экспорт
	Возврат "новый-пул";
КонецФункции

#КонецОбласти

#Область Окна

// Окно «Новый пул»: на странице всегда, открытым — по адресу или с отбитой формой. Имя пула
// проверяется до отправки — правилом именования в браузере и занятостью на сервере.
//
// Параметры:
//  АдресСписка - Строка - адрес списка с отбором: от него — адрес, по которому сервер печатает это
//                окно открытым (туда ведёт кнопка «Добавить пул» без скрипта), и адрес закрытия.
//  АдресПроверки - Строка - адрес проверки имени до отправки.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//  Отбор - Структура - отбор списка (см. ОтборПулов.ИзАдреса).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Заведение(Знач АдресСписка, Знач АдресПроверки, Знач Состояние, Знач Отбор) Экспорт

	Якорь = "pul-novyi";

	Возврат Кит.Окно(Тексты.Текст("settings.hub.pools.new.title"),
			ОшибкаОкна(Состояние),
			Кит.СкрытоеПоле(ИмяПоляОперации(), ОперацияЗаведения()),
			ПолеИмени(АдресПроверки, Состояние),
			ВыборВидимости(Состояние),
			ПолеКвоты(Состояние),
			Отборы.Поля(Отбор))
		.Лид(Тексты.Текст("settings.hub.pools.new.lead"))
		.Форма("").БезПерезагрузки().Якорь(Якорь).Адрес(Окна.Адрес(АдресСписка, "новый"))
		.Открыто(Окна.Открыто(Состояние, "новый")).АдресЗакрытия(АдресСписка)
		.Действия(Кит.Кнопка(Тексты.Текст("settings.hub.pools.new.button")).Основная().Иконка("плюс"));

КонецФункции

// Подтверждение «Сделать основным»: что переедет в этот пул и что станет с прежним.
//
// Параметры:
//  Пул - Пул - пул, который станет основным.
//  Прежний - Строка - имя нынешнего основного пула; "" — основного нет.
//  Состояние - Структура, Неопределено - состояние окна раздела: отказ домена над кнопкой.
//  Отбор - Структура - отбор списка.
//  АдресСписка - Строка - адрес списка с отбором: туда закрывается подтверждение.
//  Хвост - Строка - адрес формы относительно раздела: «<имя>/primary».
//
// Возвращаемое значение:
//  ЭлементЭкрана - подтверждение, напечатанное открытым.
//
Функция Основной(Знач Пул, Знач Прежний, Знач Состояние, Знач Отбор, Знач АдресСписка, Знач Хвост) Экспорт

	Имя = Строка(Пул.Имя);
	Последствие = ?(ЗначениеЗаполнено(Прежний),
		Тексты.Шаблон("settings.hub.pools.primary.consequence", Имя, Прежний),
		Тексты.Шаблон("settings.hub.pools.primary.consequence.first", Имя));

	Возврат Кит.Подтверждение(Тексты.Шаблон("settings.hub.pools.primary.title", Имя), Последствие,
			ОшибкаОкна(Состояние),
			Отборы.Поля(Отбор))
		.Кнопка(Тексты.Текст("settings.hub.pools.action.primary"))
		.Форма(Хвост).БезПерезагрузки().Якорь("pul-osnovnoi").Открыто().АдресЗакрытия(АдресСписка);

КонецФункции

// Подтверждение удаления пула с эхом имени: что снимается вместе с пулом, названо числами;
// запрет домена (идёт прогон зеркала) — предупреждением над эхо-полем.
//
// Параметры:
//  Пул - Пул - удаляемый пул.
//  Сводка - Структура - Пакетов (все, со скрытыми), Скрытых, Апстримов, Зеркал (Число),
//           Запрет (Строка: "" — удалению ничто не мешает).
//  Состояние - Структура, Неопределено - состояние окна раздела: отказ под эхо-полем.
//  Отбор - Структура - отбор списка.
//  АдресСписка - Строка - адрес списка с отбором: туда закрывается подтверждение.
//  Хвост - Строка - адрес формы относительно раздела: «<имя>/delete».
//
// Возвращаемое значение:
//  ЭлементЭкрана - подтверждение, напечатанное открытым.
//
Функция Удаление(Знач Пул, Знач Сводка, Знач Состояние, Знач Отбор, Знач АдресСписка, Знач Хвост) Экспорт

	Имя = Строка(Пул.Имя);
	Возврат Кит.Подтверждение(Тексты.Шаблон("settings.hub.pools.delete.title", Имя),
			Тексты.Шаблон("settings.hub.pools.delete.consequence", Число_(Сводка.Пакетов),
				Число_(Сводка.Скрытых), Число_(Сводка.Апстримов), Число_(Сводка.Зеркал)),
			ЗапретУдаления(Сводка.Запрет),
			ОшибкаОкна(Состояние),
			Отборы.Поля(Отбор))
		.Эхо(ИмяПоляИмени(), Имя, Тексты.Текст("settings.hub.pools.delete.echo"))
		.Кнопка(Тексты.Текст("settings.hub.pools.action.delete"))
		.Ошибка(Окна.Отказ(Состояние, ИмяПоляИмени()))
		.Форма(Хвост).БезПерезагрузки().Якорь("pul-udalit").Открыто().АдресЗакрытия(АдресСписка);

КонецФункции

#КонецОбласти

#Область ПоляОкнаЗаведения

// Правило не строже домена: тот же образец, что судит ПравилаИменования.
Функция ПолеИмени(Знач АдресПроверки, Знач Состояние)

	Имя = ИмяПоляИмени();
	Возврат Кит.Поле(Имя, Тексты.Текст("settings.hub.pools.new.name")).Обязательное()
		.Шаблон(Правила.ОбразецИмени()).ПроверкаНаСервере(АдресПроверки)
		.Значение(Окна.Значение(Состояние, Имя)).Пример("platform")
		.Подсказка(Тексты.Текст("settings.hub.pools.new.name.hint"))
		.Ошибка(Окна.Отказ(Состояние, Имя));

КонецФункции

Функция ВыборВидимости(Знач Состояние)

	Имя = ИмяПоляВидимости();
	Возврат Кит.Поле(Имя, Тексты.Текст("settings.hub.pools.new.visibility"))
		.Вариант("public", Тексты.Текст("settings.hub.pools.visibility.public"))
		.Вариант("private", Тексты.Текст("settings.hub.pools.visibility.private"))
		.Значение(Окна.Значение(Состояние, Имя, "public"))
		.Ошибка(Окна.Отказ(Состояние, Имя));

КонецФункции

// Умолчание — квота хаба: новый пул не уходит без предела, который хаб задаёт всем.
Функция ПолеКвоты(Знач Состояние)

	Имя = ИмяПоляКвоты();
	Возврат Кит.Поле(Имя, Тексты.Текст("settings.pool.quota.label")).ТипЗначения(Тип("Число"))
		.Значение(Окна.Значение(Состояние, Имя, Тексты.ЧислоТекстом(СервисПулов.КвотаКакВХабе())))
		.Справка(Тексты.Текст("settings.pool.quota.hint"))
		.Ошибка(Окна.Отказ(Состояние, Имя));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗапретУдаления(Знач Запрет)
	Если НЕ ЗначениеЗаполнено(Запрет) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Запрет).Вид("warn");
КонецФункции

Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

Функция Число_(Знач Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

#КонецОбласти

&Прозвище("ОкноПула")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ОтборПулов") _Отборы,
	&Пластилин(Значение = "ПравилаИменования") _Правила,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Окна = _Окна;
	Отборы = _Отборы;
	Правила = _Правила;
	СервисПулов = _СервисПулов;
	Тексты = _Тексты;

КонецПроцедуры
