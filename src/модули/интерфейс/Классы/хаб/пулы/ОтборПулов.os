// Отбор раздела «Пулы» хаба: у таблицы пулов хаба — подстрока имени, видимость и страница, у секции
// личных пространств — своя подстрока и страница. Отбор живёт в адресе: ссылка показывает тот же
// список, а формы строк и окон несут его скрытыми полями, чтобы правка вернула человека к тому же списку.

Перем Кит;          // Кит (кит) — скрытые поля и пагинация
Перем Ссылки;       // ПараметрыСсылки (основа) — параметр запроса на адресе
Перем Числа;        // ПриведениеЧисел (основа) — терпимое чтение номера страницы
Перем РазборФормы;  // РазборФормы — поля формы строки

#Область Значения

// Значение отбора по видимости «публичный».
//
// Возвращаемое значение:
//  Строка.
//
Функция ВидимостьПубличный() Экспорт
	Возврат "public";
КонецФункции

// Значение отбора по видимости «приватный».
//
// Возвращаемое значение:
//  Строка.
//
Функция ВидимостьПриватный() Экспорт
	Возврат "private";
КонецФункции

// Сколько строк на странице таблицы — и пулов хаба, и личных пространств.
//
// Возвращаемое значение:
//  Число.
//
Функция РазмерСтраницы() Экспорт
	Возврат 20;
КонецФункции

#КонецОбласти

#Область Чтение

// Отбор из параметров адреса. Незнакомая видимость отбрасывается, а не применяется.
//
// Параметры:
//  Подстрока - Строка - параметр q: подстрока имени пула хаба.
//  Видимость - Строка - параметр visibility: public | private (необязательный, по умолчанию "").
//  Страница - Строка - параметр page: страница пулов хаба (необязательный, по умолчанию "").
//  ПодстрокаЛичных - Строка - параметр pq: подстрока имени личного пространства (необязательный,
//                    по умолчанию "").
//  СтраницаЛичных - Строка - параметр ppage: страница личных пространств (необязательный,
//                   по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Подстрока, Видимость, ПодстрокаЛичных (Строка), Страница, СтраницаЛичных (Число, с 1).
//
Функция ИзАдреса(Знач Подстрока, Знач Видимость = "", Знач Страница = "", Знач ПодстрокаЛичных = "",
	Знач СтраницаЛичных = "") Экспорт

	Видимость_ = НРег(СокрЛП(Строка(Видимость)));

	Возврат Новый Структура("Подстрока, Видимость, Страница, ПодстрокаЛичных, СтраницаЛичных",
		СокрЛП(Строка(Подстрока)),
		?(Видимости().Найти(Видимость_) = Неопределено, "", Видимость_),
		НомерСтраницы(Страница),
		СокрЛП(Строка(ПодстрокаЛичных)),
		НомерСтраницы(СтраницаЛичных));

КонецФункции

// Отбор, который принесла форма строки или окна скрытыми полями.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - см. ИзАдреса.
//
Функция ИзФормы(Знач Форма) Экспорт
	Возврат ИзАдреса(РазборФормы.Поле(Форма, "q"), РазборФормы.Поле(Форма, "visibility"),
		РазборФормы.Поле(Форма, "page"), РазборФормы.Поле(Форма, "pq"), РазборФормы.Поле(Форма, "ppage"));
КонецФункции

// Стоит ли пул в таблице пулов хаба: не личное пространство, подстрока имени без регистра
// и видимость.
//
// Параметры:
//  Пул - Пул - пул хаба.
//  Отбор - Структура - см. ИзАдреса.
//
// Возвращаемое значение:
//  Булево.
//
Функция Подходит(Знач Пул, Знач Отбор) Экспорт

	Если Пул.ЭтоЛичный() ИЛИ НЕ ИмяСодержит(Пул, Отбор.Подстрока) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат НЕ ЗначениеЗаполнено(Отбор.Видимость) ИЛИ Отбор.Видимость = НРег(Строка(Пул.Видимость));

КонецФункции

// Стоит ли пул в секции личных пространств: личное пространство с подстрокой имени.
//
// Параметры:
//  Пул - Пул - пул хаба.
//  Отбор - Структура - см. ИзАдреса.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПодходитЛичный(Знач Пул, Знач Отбор) Экспорт
	Возврат Пул.ЭтоЛичный() И ИмяСодержит(Пул, Отбор.ПодстрокаЛичных);
КонецФункции

// Отбор пулов хаба задан: пустая выдача тогда объясняется отбором, а не отсутствием пулов.
//
// Параметры:
//  Отбор - Структура - см. ИзАдреса.
//
// Возвращаемое значение:
//  Булево.
//
Функция Задан(Знач Отбор) Экспорт
	Возврат ЗначениеЗаполнено(Отбор.Подстрока) ИЛИ ЗначениеЗаполнено(Отбор.Видимость);
КонецФункции

// Человек работает внутри секции личных пространств: искал или листал её — кат открыт.
//
// Параметры:
//  Отбор - Структура - см. ИзАдреса.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЛичныеЗатронуты(Знач Отбор) Экспорт
	Возврат ЗначениеЗаполнено(Отбор.ПодстрокаЛичных) ИЛИ Отбор.СтраницаЛичных > 1;
КонецФункции

#КонецОбласти

#Область Печать

// Адрес раздела с отбором: пустые части и первые страницы в адрес не попадают.
//
// Параметры:
//  АдресРаздела - Строка - адрес раздела без параметров.
//  Отбор - Структура - см. ИзАдреса.
//
// Возвращаемое значение:
//  Строка.
//
Функция Адрес(Знач АдресРаздела, Знач Отбор) Экспорт

	Результат = Строка(АдресРаздела);
	Для Каждого Пара Из Пары(Отбор) Цикл
		Результат = Ссылки.Установить(Результат, Пара.Имя, Пара.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Скрытые поля отбора для формы строки или окна: после правки сервер вернёт к тому же списку.
//
// Параметры:
//  Отбор - Структура - см. ИзАдреса.
//
// Возвращаемое значение:
//  ЭлементЭкрана - холст скрытых полей; пустой отбор — пустой холст.
//
Функция Поля(Знач Отбор) Экспорт

	Результат = Кит.Холст();
	Для Каждого Пара Из Пары(Отбор) Цикл
		Результат.Добавить(Кит.СкрытоеПоле(Пара.Имя, Пара.Значение));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Строка поиска пулов хаба: подстрока и видимость; положение секции личных уходит скрытыми полями.
//
// Параметры:
//  Поиск - ЭлементЭкрана - строка поиска (Кит.СтрокаПоиска).
//  Отбор - Структура - см. ИзАдреса.
//
// Возвращаемое значение:
//  ЭлементЭкрана - та же строка поиска.
//
Функция СПоложениемЛичных(Знач Поиск, Знач Отбор) Экспорт
	Для Каждого Пара Из Пары(Отбор, "pq,ppage") Цикл
		Поиск.СкрытоеПоле(Пара.Имя, Пара.Значение);
	КонецЦикла;
	Возврат Поиск;
КонецФункции

// Строка поиска личных пространств: положение таблицы пулов хаба уходит скрытыми полями.
//
// Параметры:
//  Поиск - ЭлементЭкрана - строка поиска (Кит.СтрокаПоиска).
//  Отбор - Структура - см. ИзАдреса.
//
// Возвращаемое значение:
//  ЭлементЭкрана - та же строка поиска.
//
Функция СПоложениемПулов(Знач Поиск, Знач Отбор) Экспорт
	Для Каждого Пара Из Пары(Отбор, "q,visibility,page") Цикл
		Поиск.СкрытоеПоле(Пара.Имя, Пара.Значение);
	КонецЦикла;
	Возврат Поиск;
КонецФункции

// Страница пулов: номер больше последнего читается последним.
//
// Параметры:
//  Пулы - Массив - все отобранные пулы.
//  Номер - Число - запрошенный номер страницы, с 1.
//
// Возвращаемое значение:
//  Структура - Записи (Массив — пулы страницы), Страница (Число), Всего (Число).
//
Функция Страница(Знач Пулы, Знач Номер) Экспорт

	Всего = Пулы.Количество();
	Размер = РазмерСтраницы();
	Последняя = Макс(1, Цел((Всего + Размер - 1) / Размер));
	Номер_ = Мин(Номер, Последняя);

	Срез = Новый Массив();
	Для Индекс = (Номер_ - 1) * Размер По Мин(Номер_ * Размер, Всего) - 1 Цикл
		Срез.Добавить(Пулы[Индекс]);
	КонецЦикла;

	Возврат Новый Структура("Записи, Страница, Всего", Срез, Номер_, Всего);

КонецФункции

// Пагинация таблицы пулов хаба: «1–20 из 57», шаги несут весь отбор и уходят без перезагрузки.
//
// Параметры:
//  АдресРаздела - Строка - адрес раздела без параметров.
//  Отбор - Структура - см. ИзАдреса.
//  Страница - Структура - см. Страница.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Пагинация(Знач АдресРаздела, Знач Отбор, Знач Страница) Экспорт
	Возврат ПагинацияПо(АдресРаздела, Отбор, Страница, "page");
КонецФункции

// Пагинация личных пространств: своя страница в параметре ppage, отбор пулов хаба — с ней.
//
// Параметры:
//  АдресРаздела - Строка - адрес раздела без параметров.
//  Отбор - Структура - см. ИзАдреса.
//  Страница - Структура - см. Страница.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ПагинацияЛичных(Знач АдресРаздела, Знач Отбор, Знач Страница) Экспорт
	Возврат ПагинацияПо(АдресРаздела, Отбор, Страница, "ppage");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПагинацияПо(Знач АдресРаздела, Знач Отбор, Знач Страница, Знач Параметр)

	Результат = Кит.Пагинация(АдресРаздела, Страница.Страница).Всего(Страница.Всего)
		.НаСтранице(РазмерСтраницы()).Параметр(Параметр).БезПерезагрузки();
	Для Каждого Пара Из Пары(Отбор) Цикл
		Если Пара.Имя <> Параметр Тогда
			Результат.Параметры(Пара.Имя, Пара.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пары отбора в порядке адреса; Только — имена через запятую, "" — все.
Функция Пары(Знач Отбор, Знач Только = "")

	Результат = Новый Массив();
	ДобавитьПару(Результат, "q", Отбор.Подстрока);
	ДобавитьПару(Результат, "visibility", Отбор.Видимость);
	ДобавитьПару(Результат, "page", ?(Отбор.Страница > 1, Формат(Отбор.Страница, "ЧГ=0"), ""));
	ДобавитьПару(Результат, "pq", Отбор.ПодстрокаЛичных);
	ДобавитьПару(Результат, "ppage", ?(Отбор.СтраницаЛичных > 1, Формат(Отбор.СтраницаЛичных, "ЧГ=0"), ""));
	Если НЕ ЗначениеЗаполнено(Только) Тогда
		Возврат Результат;
	КонецЕсли;

	Имена = СтрРазделить(Только, ",");
	Отобранные = Новый Массив();
	Для Каждого Пара Из Результат Цикл
		Если Имена.Найти(Пара.Имя) <> Неопределено Тогда
			Отобранные.Добавить(Пара);
		КонецЕсли;
	КонецЦикла;
	Возврат Отобранные;

КонецФункции

Процедура ДобавитьПару(Пары, Знач Имя, Знач Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		Пары.Добавить(Новый Структура("Имя, Значение", Имя, Строка(Значение)));
	КонецЕсли;
КонецПроцедуры

Функция ИмяСодержит(Знач Пул, Знач Подстрока)
	Возврат НЕ ЗначениеЗаполнено(Подстрока) ИЛИ СтрНайти(НРег(Строка(Пул.Имя)), НРег(Подстрока)) > 0;
КонецФункции

Функция НомерСтраницы(Знач Значение)
	Номер = Числа.ЦелоеИлиНеопределено(СокрЛП(Строка(Значение)));
	Возврат ?(Номер = Неопределено, 1, Макс(1, Номер));
КонецФункции

Функция Видимости()
	Возврат СтрРазделить(ВидимостьПубличный() + "," + ВидимостьПриватный(), ",");
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ПараметрыСсылки") _Ссылки,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "РазборФормы") _РазборФормы)

	Кит = _Кит;
	Ссылки = _Ссылки;
	Числа = _Числа;
	РазборФормы = _РазборФормы;

КонецПроцедуры
