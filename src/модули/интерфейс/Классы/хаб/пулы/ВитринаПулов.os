// Раздел «Пулы» дома «Хаб»: таблица пулов хаба с отбором по имени и видимости, страницы, меню ⚙
// строки, окна нового пула, «Сделать основным» и удаления — по адресу; ниже — свёрнутая группа
// личных пространств со счётчиком, своим поиском и страницами.

Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем СервисПулов;   // СервисПулов (реестр) — пулы, занятое место, действующая квота, запрет удаления
Перем Пакеты;        // СервисПакетов (реестр) — число пакетов по пулам
Перем Учётки;        // СервисПользователей (вход) — владельцы пулов одним разрезом
Перем Источники;     // СервисАпстримовПула (реестр) — апстримы удаляемого пула
Перем Зеркала;       // СервисЗеркал (зеркала), необязателен — зеркала удаляемого пула
Перем Плашки;        // ПлашкиПула — плашка видимости, та же, что на странице пула
Перем Заполнение;    // ЗаполнениеПула (реестр) — процент занятого
Перем Объёмы;        // ОбъёмТекстом (основа) — байты человеку
Перем ДомПула;       // ДомПула — дом настроек пула, куда ведёт имя
Перем Окна;          // ОкноРаздела — окно по адресу и его состояние
Перем ОкноПула;      // ОкноПула — окна раздела
Перем Отборы;        // ОтборПулов — отбор, страница и их адрес
Перем Ссылки;        // ПараметрыСсылки (основа) — адрес проверки имени
Перем Тексты;        // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<имя пула>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат "новый,основной,удалить";
КонецФункции

// Секции раздела: таблица пулов хаба с отбором, страницами, окном нового пула и окном записи;
// за ней — личные пространства свёрнутой группой, если они есть.
//
// Параметры:
//  Параметры - Структура:
//    * Адрес - Строка - адрес раздела без параметров;
//    * Отбор - Структура - отбор списка (см. ОтборПулов.ИзАдреса);
//    * Окно - Структура, Неопределено - состояние открытого окна (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - секция пулов хаба и, если личные пространства есть, их секция.
//
Функция Секции(Знач Параметры) Экспорт

	Адрес = Параметры.Адрес;
	Отбор = Параметры.Отбор;
	АдресСписка = Отборы.Адрес(Адрес, Отбор);

	Пулы = СервисПулов.ВсеПулы();
	Страница = Отборы.Страница(ОтобранныеПулыХаба(Пулы, Отбор), Отбор.Страница);
	ЛичныеВсего = ЧислоЛичных(Пулы);
	Личные = Отборы.Страница(ОтобранныеЛичные(Пулы, Отбор), Отбор.СтраницаЛичных);
	Данные = ДанныеСтрок(Слить(Страница.Записи, Личные.Записи));

	Результат = Новый Массив();
	Результат.Добавить(СекцияПулов(Страница, Данные, Адрес, АдресСписка, Отбор, Параметры.Окно));
	Если ЛичныеВсего > 0 Тогда
		Результат.Добавить(СекцияЛичных(Личные, ЛичныеВсего, Данные, Адрес, АдресСписка, Отбор));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Напечатает ли раздел окно, которое называет состояние: окно нового пула — всегда; окно записи —
// когда пул есть и действие ему положено.
//
// Параметры:
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Состояние) Экспорт

	Если Окна.Открыто(Состояние, "новый") Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ПулОкна(Состояние) <> Неопределено;

КонецФункции

#КонецОбласти

#Область ПулыХаба

Функция СекцияПулов(Знач Страница, Знач Данные, Знач Адрес, Знач АдресСписка, Знач Отбор, Знач Состояние)

	// имя нового пула проверяет до отправки тот же адрес раздела с признаком проверки
	ОкноЗаведения = ОкноПула.Заведение(АдресСписка, Ссылки.Установить(Адрес, "проверка", "1"), Состояние, Отбор);

	Возврат Кит.Секция(Тексты.Текст("settings.hub.pools.list.title"),
			ФормаОтбора(Адрес, Отбор),
			ТаблицаПулов(Страница.Записи, Данные, АдресСписка, ПустаяВыдача(Отбор)),
			Отборы.Пагинация(Адрес, Отбор, Страница),
			ОкноЗаведения,
			ОткрытоеОкно(Состояние, Отбор, АдресСписка))
		.Лид(Тексты.Текст("settings.hub.pools.list.lead")).Иконка("стопка")
		.Действия(Кит.Кнопка(Тексты.Текст("settings.hub.pools.add")).Основная().Иконка("плюс")
			.Открывает(ОкноЗаведения));

КонецФункции

// GET-форма: отбор живёт в адресе, со скриптом уходит без перезагрузки по мере набора; положение
// группы личных пространств едет с ней скрытыми полями.
Функция ФормаОтбора(Знач Адрес, Знач Отбор)

	Возврат Отборы.СПоложениемЛичных(Кит.СтрокаПоиска(Адрес)
		.Поле(Кит.Поле("q", Тексты.Текст("settings.hub.pools.filter.search"))
			.Значение(Отбор.Подстрока).Пример(Тексты.Текст("settings.hub.pools.filter.search.example")))
		.Поле(Кит.Поле("visibility", Тексты.Текст("settings.hub.pools.filter.visibility"))
			.Вариант("", Тексты.Текст("settings.hub.pools.filter.visibility.any"))
			.Вариант(Отборы.ВидимостьПубличный(), Тексты.Текст("settings.hub.pools.visibility.public"))
			.Вариант(Отборы.ВидимостьПриватный(), Тексты.Текст("settings.hub.pools.visibility.private"))
			.Значение(Отбор.Видимость))
		.Кнопка(Тексты.Текст("settings.hub.pools.filter.button"), "поиск").БезПерезагрузки(), Отбор);

КонецФункции

#КонецОбласти

#Область ЛичныеПространства

// Личных пространств столько же, сколько учёток: развёрнутый список прятал бы рабочие пулы, поэтому
// они собраны свёрнутой группой со счётчиком. Группа открыта, когда человек в ней искал или листал.
Функция СекцияЛичных(Знач Страница, Знач Всего, Знач Данные, Знач Адрес, Знач АдресСписка, Знач Отбор)

	Группа = Кит.Раскрывашка(
			ПоискЛичных(Адрес, Отбор, Всего),
			ТаблицаЛичных(Страница.Записи, Данные, АдресСписка,
				Тексты.Текст("settings.hub.pools.personal.empty.filter")),
			Отборы.ПагинацияЛичных(Адрес, Отбор, Страница))
		.Шапка(Тексты.Текст("settings.hub.pools.personal.list.toggle")).Вид("врезка");
	Если Отборы.ЛичныеЗатронуты(Отбор) Тогда
		Группа.Открыть();
	КонецЕсли;

	Возврат Кит.Секция(Тексты.Шаблон("settings.hub.pools.personal.list.title", Тексты.ЧислоТекстом(Всего)),
			Группа)
		.Лид(Тексты.Текст("settings.hub.pools.personal.list.lead")).Иконка("аккаунт")
		.Якорь("lichnye-prostranstva");

КонецФункции

// Поиск нужен, когда личных больше страницы, — или когда по ним уже искали.
Функция ПоискЛичных(Знач Адрес, Знач Отбор, Знач Всего)

	Если Всего <= Отборы.РазмерСтраницы() И НЕ ЗначениеЗаполнено(Отбор.ПодстрокаЛичных) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Отборы.СПоложениемПулов(Кит.СтрокаПоиска(Адрес).Имя("pq")
		.Метка(Тексты.Текст("settings.hub.pools.filter.search")).СкрытаяМетка()
		.Значение(Отбор.ПодстрокаЛичных)
		.Пример(Тексты.Текст("settings.hub.pools.personal.search.example"))
		.БезПерезагрузки(), Отбор);

КонецФункции

#КонецОбласти

#Область Порядок

// Пулы хаба: основной первым, за ним по имени.
Функция ОтобранныеПулыХаба(Знач Пулы, Знач Отбор)

	Список = Новый СписокЗначений();
	Для Каждого Пул Из Пулы Цикл
		Если Отборы.Подходит(Пул, Отбор) Тогда
			Список.Добавить(Пул, ?(Пул.ЭтоДефолтный(), "0", "1") + НРег(Строка(Пул.Имя)));
		КонецЕсли;
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	Возврат Список.ВыгрузитьЗначения();

КонецФункции

// Личные пространства — по имени.
Функция ОтобранныеЛичные(Знач Пулы, Знач Отбор)

	Список = Новый СписокЗначений();
	Для Каждого Пул Из Пулы Цикл
		Если Отборы.ПодходитЛичный(Пул, Отбор) Тогда
			Список.Добавить(Пул, НРег(Строка(Пул.Имя)));
		КонецЕсли;
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	Возврат Список.ВыгрузитьЗначения();

КонецФункции

Функция ЧислоЛичных(Знач Пулы)
	Число = 0;
	Для Каждого Пул Из Пулы Цикл
		Если Пул.ЭтоЛичный() Тогда
			Число = Число + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Число;
КонецФункции

#КонецОбласти

#Область Таблица

// На узком экране — карточки с именем пула заглавием и ⚙ в углу. Владельца нет у системного
// пула — прочерк таблицы.
Функция ТаблицаПулов(Знач Пулы, Знач Данные, Знач АдресСписка, Знач Пусто)

	Таблица = Кит.Таблица(Строки(Пулы, Данные, АдресСписка)).Вид("карточками").Пустое("—").Пусто(Пусто);
	Таблица.Колонка("name", Тексты.Текст("settings.hub.pools.col.name")).Заглавная();
	Таблица.Колонка("kind", Тексты.Текст("settings.hub.pools.col.kind"));
	Таблица.Колонка("visibility", Тексты.Текст("settings.hub.pools.col.visibility")).БезПодписиВЗаписи();
	Таблица.Колонка("owner", Тексты.Текст("settings.hub.pools.col.owner"));
	КолонкиЗанятого(Таблица);
	Возврат Таблица;

КонецФункции

// У личного пространства тип и видимость одни на всех, а владелец — тот, чьим логином оно
// названо: этих колонок нет.
Функция ТаблицаЛичных(Знач Пулы, Знач Данные, Знач АдресСписка, Знач Пусто)

	Таблица = Кит.Таблица(Строки(Пулы, Данные, АдресСписка)).Вид("карточками").Пустое("—").Пусто(Пусто);
	Таблица.Колонка("name", Тексты.Текст("settings.hub.pools.col.name")).Заглавная();
	КолонкиЗанятого(Таблица);
	Возврат Таблица;

КонецФункции

Процедура КолонкиЗанятого(Знач Таблица)
	Таблица.Колонка("packages", Тексты.Текст("settings.hub.pools.col.packages")).Вид("число");
	Таблица.Колонка("space", Тексты.Текст("settings.hub.pools.col.space")).БезПодписиВЗаписи();
	Таблица.Колонка("actions", "").Вид("узкая");
КонецПроцедуры

// Занятое место, число пакетов и владельцы спрашиваются разом на обе страницы — пулов хаба
// и личных пространств, — а не на строку и не на таблицу.
Функция ДанныеСтрок(Знач Пулы)

	Возврат Новый Структура("Занято, Пакетов, Владельцы",
		СервисПулов.ЗанятоПулами(Пулы),
		Пакеты.КоличествоВидимыхПакетовПоПулам(Идентификаторы(Пулы)),
		Учётки.ПоИдентификаторам(ИдентификаторыВладельцев(Пулы)));

КонецФункции

Функция Строки(Знач Пулы, Знач Данные, Знач АдресСписка)

	Результат = Новый Массив();
	Для Каждого Пул Из Пулы Цикл
		Ключ = Цел(Пул.Идентификатор);
		Имя = Строка(Пул.Имя);
		Владелец = Данные.Владельцы.Получить(ВладелецПула(Пул));
		Результат.Добавить(Новый Структура("name, kind, visibility, owner, packages, space, actions",
			Кит.Ссылка(ДомПула.БазовыйАдрес(Имя), Кит.Текст(Имя)),
			ТипСловами(Пул),
			Кит.Плашка(Плашки.ПлашкаВидимости(Пул)),
			?(Владелец = Неопределено, Неопределено, Строка(Владелец.Логин)),
			ЧислоИлиНоль(Данные.Пакетов.Получить(Ключ)),
			Место(Пул, ЧислоИлиНоль(Данные.Занято.Получить(Ключ))),
			Меню(Пул, АдресСписка)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ТипСловами(Знач Пул)
	Возврат ?(Пул.ЭтоДефолтный(), Тексты.Текст("settings.hub.pools.kind.primary"),
		Тексты.Текст("settings.hub.pools.kind.pool"));
КонецФункции

// Квота ТРЁХЗНАЧНА, поэтому полоса меряет ДЕЙСТВУЮЩУЮ квоту, а не записанную; без предела — словами.
// Унаследованный предел назван прямо: иначе администратор не поймёт, что правит дефолт хаба, а не пул.
Функция Место(Знач Пул, Знач Занято)

	КвотаБайт = СервисПулов.ЭффективнаяКвотаБайт(Пул);
	Если КвотаБайт <= 0 Тогда
		Возврат Кит.Текст(Тексты.Шаблон("settings.pool.quota.meter.unlimited", Объёмы.Представление(Занято)));
	КонецЕсли;

	Сколько = Тексты.Шаблон("settings.pool.quota.meter.value", Объёмы.Представление(Занято),
		Объёмы.Представление(КвотаБайт));
	Если КвотаХаба(Пул) Тогда
		Сколько = Тексты.Шаблон("settings.hub.pools.space.inherited", Сколько);
	КонецЕсли;
	Возврат Кит.Холст(
		Кит.ПолосаЗаполнения(Заполнение.Процент(Занято, КвотаБайт),
			Тексты.Шаблон("settings.hub.pools.space.label", Строка(Пул.Имя))).Подпись(Сколько).Компактная(),
		Кит.Надпись(Кит.Текст(Сколько)).Вид("приписка"));

КонецФункции

// Личное пространство настраивается и удаляется вместе с учёткой: в меню у него только дом.
// Основной пул не удаляется и основным уже стоит; основным становится только публичный пул.
// Подтверждения — по адресу списка с тем же отбором: сотню окон заранее не печатают.
Функция Меню(Знач Пул, Знач АдресСписка)

	Имя = Строка(Пул.Имя);
	Возврат Кит.Меню(Тексты.Шаблон("settings.hub.pools.menu", Имя),
		Кит.ПунктМеню(Тексты.Текст("settings.hub.pools.action.settings"), ДомПула.БазовыйАдрес(Имя))
			.Иконка("шестерёнка"),
		?(МожноСделатьОсновным(Пул),
			Кит.ОкноПоАдресу(Окна.Адрес(АдресСписка, "основной", Имя),
				Тексты.Текст("settings.hub.pools.action.primary")).Иконка("закладка"),
			Неопределено),
		?(МожноУдалить(Пул),
			Кит.ОкноПоАдресу(Окна.Адрес(АдресСписка, "удалить", Имя),
				Тексты.Текст("settings.hub.pools.action.delete")).Опасная().Иконка("корзина"),
			Неопределено));

КонецФункции

Функция ПустаяВыдача(Знач Отбор)
	Если Отборы.Задан(Отбор) Тогда
		Возврат Тексты.Текст("settings.hub.pools.empty.filter");
	КонецЕсли;
	Возврат Тексты.Текст("settings.hub.pools.empty");
КонецФункции

#КонецОбласти

#Область Окна

// Окно записи, названное адресом. Пула нет или действие ему не положено — страница без окна.
Функция ОткрытоеОкно(Знач Состояние, Знач Отбор, Знач АдресСписка)

	Пул = ПулОкна(Состояние);
	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Имя = Строка(Пул.Имя);

	Если Окна.Открыто(Состояние, "основной") Тогда
		Возврат ОкноПула.Основной(Пул, СервисПулов.ИмяПулаПоУмолчанию(), Состояние, Отбор, АдресСписка,
			Хвост(Имя, "primary"));
	КонецЕсли;
	Возврат ОкноПула.Удаление(Пул, СводкаУдаления(Пул), Состояние, Отбор, АдресСписка, Хвост(Имя, "delete"));

КонецФункции

Функция ПулОкна(Знач Состояние)

	Если Состояние = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Состояние.Ключ)
		ИЛИ Окна.Открыто(Состояние, "новый") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пул = СервисПулов.НайтиПул(Состояние.Ключ);
	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли Окна.Открыто(Состояние, "основной") Тогда
		Возврат ?(МожноСделатьОсновным(Пул), Пул, Неопределено);
	ИначеЕсли Окна.Открыто(Состояние, "удалить") Тогда
		Возврат ?(МожноУдалить(Пул), Пул, Неопределено);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Что снимается вместе с пулом — числами, и что мешает удалению прямо сейчас — словами домена.
// Пакеты считаются все, со скрытыми: снимаются и они, а в строке таблицы видны только нескрытые.
Функция СводкаУдаления(Знач Пул)

	Ид = Цел(Пул.Идентификатор);
	Всего = Пакеты.КоличествоПакетовПула(Ид);
	Видимых = ЧислоИлиНоль(Пакеты.КоличествоВидимыхПакетовПоПулам(Идентификаторы(Одна(Пул))).Получить(Ид));
	Возврат Новый Структура("Пакетов, Скрытых, Апстримов, Зеркал, Запрет",
		Всего,
		Макс(0, Всего - Видимых),
		Источники.Все(Ид).Количество(),
		?(Зеркала = Неопределено, 0, Зеркала.СписокПула(Ид).Количество()),
		СервисПулов.ПричинаЗапретаУдаления(Пул));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МожноСделатьОсновным(Знач Пул)
	Возврат НЕ Пул.ЭтоДефолтный() И НЕ Пул.ЭтоЛичный()
		И НРег(Строка(Пул.Видимость)) = Отборы.ВидимостьПубличный();
КонецФункции

Функция МожноУдалить(Знач Пул)
	Возврат НЕ Пул.ЭтоДефолтный() И НЕ Пул.ЭтоЛичный();
КонецФункции

// Адрес формы записи относительно раздела: «<имя>/<действие>».
Функция Хвост(Знач Имя, Знач Действие)
	Возврат КодироватьСтроку(Строка(Имя), СпособКодированияСтроки.КодировкаURL) + "/" + Действие;
КонецФункции

Функция Слить(Знач Первые, Знач Вторые)
	Результат = Новый Массив();
	Для Каждого Пул Из Первые Цикл
		Результат.Добавить(Пул);
	КонецЦикла;
	Для Каждого Пул Из Вторые Цикл
		Результат.Добавить(Пул);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Одна(Знач Пул)
	Результат = Новый Массив();
	Результат.Добавить(Пул);
	Возврат Результат;
КонецФункции

Функция Идентификаторы(Знач Пулы)
	Результат = Новый Массив();
	Для Каждого Пул Из Пулы Цикл
		Результат.Добавить(Цел(Пул.Идентификатор));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Системный пул (владелец 0) владельца не называет.
Функция ИдентификаторыВладельцев(Знач Пулы)
	Результат = Новый Массив();
	Для Каждого Пул Из Пулы Цикл
		Владелец = ВладелецПула(Пул);
		Если Владелец > 0 И Результат.Найти(Владелец) = Неопределено Тогда
			Результат.Добавить(Владелец);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция КвотаХаба(Знач Пул)
	Возврат Пул.КвотаМб <> Неопределено И Цел(Пул.КвотаМб) = СервисПулов.КвотаКакВХабе();
КонецФункции

Функция ВладелецПула(Знач Пул)
	Возврат ?(Пул.ВладелецИдентификатор = Неопределено, 0, Цел(Пул.ВладелецИдентификатор));
КонецФункции

Функция ЧислоИлиНоль(Знач Значение)
	Возврат ?(Значение = Неопределено, 0, Значение);
КонецФункции

#КонецОбласти

&Прозвище("ВитринаПулов")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _Пакеты,
	&Пластилин(Значение = "СервисПользователей") _Учётки,
	&Пластилин(Значение = "СервисАпстримовПула") _Источники,
	&Пластилин(Значение = "ПлашкиПула") _Плашки,
	&Пластилин(Значение = "ЗаполнениеПула") _Заполнение,
	&Пластилин(Значение = "ОбъёмТекстом") _Объёмы,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ОкноПула") _ОкноПула,
	&Пластилин(Значение = "ОтборПулов") _Отборы,
	&Пластилин(Значение = "ПараметрыСсылки") _Ссылки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисЗеркал", Тип = "Массив") _Зеркала = Неопределено) Экспорт

	Кит = _Кит;
	СервисПулов = _СервисПулов;
	Пакеты = _Пакеты;
	Учётки = _Учётки;
	Источники = _Источники;
	Плашки = _Плашки;
	Заполнение = _Заполнение;
	Объёмы = _Объёмы;
	ДомПула = _ДомПула;
	Окна = _Окна;
	ОкноПула = _ОкноПула;
	Отборы = _Отборы;
	Ссылки = _Ссылки;
	Тексты = _Тексты;
	Зеркала = ?(_Зеркала = Неопределено ИЛИ _Зеркала.Количество() = 0, Неопределено, _Зеркала[0]);

КонецПроцедуры
