// Маршруты раздела «Пулы» дома «Хаб»: страница с отбором и окном по адресу, проверка имени нового
// пула до отправки, заведение пула, назначение основного и удаление. Удача — 303 на раздел с тем же
// отбором, отказ — та же страница с окном, открытым на набранном и отказах. Формы значений раздела
// (личные пространства, квота по умолчанию, заявки) уходят на тот же адрес — их принимает дом «Хаб».

Перем ГвардХаб;    // ГвардХабАдмина
Перем Ответы;      // ОтветыНастроек
Перем Дом;         // ДомХаба
Перем ДомНастроек; // КонтроллерДомаХаба — общая дверь раздела: значения реестра, их сброс, личные пространства
Перем ВитринаДома; // ВитринаДомаХаба — секции раздела вместе со значениями реестра
Перем Витрина;     // ВитринаПулов
Перем Пульт;       // ПультПулов
Перем Защита;      // ЗащитаCSRF (вход)
Перем Окна;        // ОкноРаздела — окно по адресу и ответы форм окон
Перем Отборы;      // ОтборПулов — отбор списка из адреса и из формы

#Область ТочкиМаршрута

// Точка маршрута «pools»: GET — страница раздела (с «проверка=1» — ответ проверки имени нового пула
// до отправки), POST — окно нового пула либо форма значений раздела.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  q - Строка - подстрока имени пула хаба (необязательный, по умолчанию "").
//  visibility - Строка - отбор по видимости: public | private (необязательный, по умолчанию "").
//  page - Строка - номер страницы пулов хаба (необязательный, по умолчанию "").
//  pq - Строка - подстрока имени личного пространства (необязательный, по умолчанию "").
//  ppage - Строка - номер страницы личных пространств (необязательный, по умолчанию "").
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: <вид>-<имя пула> (необязательный, по умолчанию "").
//  проверка - Строка - непустое — запрос проверки имени до отправки (необязательный,
//             по умолчанию "").
//  имя - Строка - проверяемое имя нового пула (необязательный, по умолчанию "").
//
&ТочкаМаршрута("pools")
Процедура Раздел(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	q = "", visibility = "", page = "", pq = "", ppage = "", saved = "", окно = "", проверка = "",
	имя = "") Экспорт

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Если ЗначениеЗаполнено(проверка) Тогда
			ОтветитьПроверкой(Ответ, Пульт.ОтказИмени(имя));
			Возврат;
		КонецЕсли;
		ОтдатьРаздел(Ответ, Запрос(Вердикт, КукиЗапроса, Отборы.ИзАдреса(q, visibility, page, pq, ppage)), 200,
			Окна.ИзАдреса(окно, Витрина.ВидыОкон()), ЗначениеЗаполнено(saved));
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Запрос = Запрос(Вердикт, КукиЗапроса, Отборы.ИзФормы(Форма));

	Если Пульт.ФормаРазделаУстарела(Форма) Тогда
		Завершить(Ответ, Запрос, Пульт.ОтказУстаревшей(), "", "", Форма);
	ИначеЕсли Пульт.ЭтоЗаведение(Форма) Тогда
		Завершить(Ответ, Запрос, Пульт.Создать(Вердикт.Пользователь, Форма), "новый", "", Форма);
	Иначе
		ДомНастроек.Раздел(Ответ, Ключ(), ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «pools/{имя}/primary» — подтверждение «Сделать основным».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  имя - Строка - имя пула.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{имя}/primary")
Процедура Основной(Ответ, имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// без скрипта форма ушла без вопроса: основной пул не меняется, сервер задаёт его окном
	Если НЕ Окна.Подтверждено(Мутация.Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресСписка(Мутация.Запрос), имя, "основной");
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Запрос, Пульт.СделатьОсновным(Мутация.Вердикт.Пользователь, имя),
		"основной", имя, Мутация.Форма);

КонецПроцедуры

// Точка маршрута «pools/{имя}/delete». Без поля подтверждения пул не удаляется: ответ ведёт
// на страницу с открытым подтверждением.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  имя - Строка - имя пула.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("pools/{имя}/delete")
Процедура Удаление(Ответ, имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Окна.Подтверждено(Мутация.Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресСписка(Мутация.Запрос), имя);
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Запрос, Пульт.Удалить(Мутация.Вердикт.Пользователь, имя, Мутация.Форма),
		"удалить", имя, Мутация.Форма);

КонецПроцедуры

#КонецОбласти

#Область Действия

// Общий пролог мутирующих точек: гвард → только POST → форма с CSRF → форма старой вкладки
// отбивается без мутации.
Функция Мутация(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "POST", Вердикт, КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Запрос(Вердикт, КукиЗапроса, Отборы.ИзФормы(Форма));

	Если Пульт.ФормаСтрокиУстарела(Форма) Тогда
		Завершить(Ответ, Запрос, Пульт.ОтказУстаревшей(), "", "", Форма);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Запрос, Вердикт, Форма", Запрос, Вердикт, Форма);

КонецФункции

// Исход пульта → ответ: удача — 303 на список с тем же отбором; отказ — страница с окном этой
// формы, открытым на набранном и отказах. Окна нет (пул уже удалён, форма старой вкладки) — отказ
// тостом над разделом: причина названа в любом случае.
Процедура Завершить(Ответ, Знач Запрос, Знач Исход, Знач ВидОкна, Знач Имя, Знач Форма)

	Если Исход.Успех Тогда
		Окна.ВернутьВРаздел(Ответ, АдресСписка(Запрос));
		Возврат;
	КонецЕсли;

	// отказ у поля в окне уже назван — второй раз над полями его не повторяют
	Окно = Окна.Отбитое(ВидОкна, Имя, Форма, Исход.Отказы,
		?(Исход.Отказы.Количество() > 0, "", Исход.Сообщение));
	Если ЗначениеЗаполнено(ВидОкна) И Витрина.ЕстьОкно(Окно) Тогда
		ОтдатьРаздел(Ответ, Запрос, Исход.Код, Окно, Ложь);
		Возврат;
	КонецЕсли;
	ОтдатьРаздел(Ответ, Запрос, Исход.Код, Неопределено, Ложь, Исход.Сообщение);

КонецПроцедуры

// Ответ проверки до отправки: 200 — имя свободно, 409 с причиной — нет.
Процедура ОтветитьПроверкой(Ответ, Знач Отказ)

	Ответ.УстановитьТипКонтента("txt");
	Ответ.УстановитьСостояние(?(ЗначениеЗаполнено(Отказ), 409, 200));
	Ответ.ТелоТекст = Отказ;

КонецПроцедуры

#КонецОбласти

#Область Рендер

// Раздел целиком — секциями дома: значения реестра раздела, основной пул и таблица пулов.
Процедура ОтдатьРаздел(Ответ, Знач Запрос, Знач Статус, Знач Окно, Знач Сохранено, Знач Ошибка = "")

	Токен = Защита.ТокенСессии(Запрос.Вердикт.Сессия);
	Обзор = Новый Структура("Адрес, Отбор, Окно", АдресРаздела(), Запрос.Отбор, Окно);

	Модель = Ответы.МодельДома(Дом, "",
		Дом.Разделы(Ключ()),
		Ответы.УведомленияРаздела(Сохранено, Ошибка),
		ВитринаДома.Секции(Новый Структура(
			"Ключ, Токен, Пользователь, Спросить, Окно, Обзор, ОткрытоеОкно, ТонкиеРаскрыты",
			Ключ(), Токен, Запрос.Вердикт.Пользователь, Неопределено, Неопределено, Обзор, Неопределено,
			Ложь)),
		Токен);

	Ответы.ОтдатьДом(Ответ, Модель, Запрос.Вердикт, Запрос.Куки, Статус);

КонецПроцедуры

Функция Запрос(Знач Вердикт, Знач КукиЗапроса, Знач Отбор)
	Возврат Новый Структура("Вердикт, Куки, Отбор", Вердикт, КукиЗапроса, Отбор);
КонецФункции

Функция Ключ()
	Возврат "pools";
КонецФункции

Функция АдресРаздела()
	Возврат Дом.АдресРаздела(Ключ());
КонецФункции

// Список, к которому вернуть человека: раздел с тем же отбором и страницей.
Функция АдресСписка(Знач Запрос)
	Возврат Отборы.Адрес(АдресРаздела(), Запрос.Отбор);
КонецФункции

#КонецОбласти

&Контроллер("/hub/settings")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардХабАдмина") _ГвардХаб,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "КонтроллерДомаХаба") _ДомНастроек,
	&Пластилин(Значение = "ВитринаДомаХаба") _ВитринаДома,
	&Пластилин(Значение = "ВитринаПулов") _Витрина,
	&Пластилин(Значение = "ПультПулов") _Пульт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ОтборПулов") _Отборы)

	ГвардХаб = _ГвардХаб;
	Ответы = _Ответы;
	Дом = _Дом;
	ДомНастроек = _ДомНастроек;
	ВитринаДома = _ВитринаДома;
	Витрина = _Витрина;
	Пульт = _Пульт;
	Защита = _Защита;
	Окна = _Окна;
	Отборы = _Отборы;

КонецПроцедуры
