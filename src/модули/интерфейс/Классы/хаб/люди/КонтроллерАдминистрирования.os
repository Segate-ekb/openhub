// Маршруты раздела «Пользователи» дома «Хаб»: страница с отбором и окном по адресу, заведение
// учётки, смена роли, блокировка, новая ссылка установки пароля и удаление. Удача — 303 на
// раздел с тем же отбором (выпущенная ссылка — страницей: в адрес она не попадает), отказ — та же
// страница с окном, открытым на набранном и отказах.

Перем ГвардХаб;   // ГвардХабАдмина
Перем Ответы;     // ОтветыНастроек
Перем Дом;        // ДомХаба
Перем Витрина;    // ВитринаУчёток
Перем Пульт;      // ПультУчёток
Перем Защита;     // ЗащитаCSRF (вход)
Перем Окна;       // ОкноРаздела — окно по адресу и ответы форм окон
Перем Отборы;     // ОтборЛюдей — отбор списка из адреса и из формы

#Область ТочкиМаршрута

// Точка маршрута «users»: GET — страница раздела, POST — заведение учётки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента, попадает в журнал аудита.
//  q - Строка - подстрока логина или email (необязательный, по умолчанию "").
//  role - Строка - отбор по роли: admin | user (необязательный, по умолчанию "").
//  status - Строка - отбор по статусу: active | blocked | nologin (необязательный, по умолчанию "").
//  page - Строка - номер страницы списка (необязательный, по умолчанию "").
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: <вид>-<логин> (необязательный, по умолчанию "").
//
&ТочкаМаршрута("users")
Процедура Пользователи(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	АдресУдаленногоУзла, q = "", role = "", status = "", page = "", saved = "", окно = "") Экспорт

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Запрос = Запрос(Вердикт, КукиЗапроса, Отборы.ИзАдреса(q, role, status, page));
		ОтдатьРаздел(Ответ, Запрос, 200, Окна.ИзАдреса(окно, Витрина.ВидыОкон()),
			ЗначениеЗаполнено(saved));
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Запрос(Вердикт, КукиЗапроса, Отборы.ИзФормы(Форма)),
		Пульт.Пригласить(Вердикт.Принципал, Форма, Строка(АдресУдаленногоУзла)), "новый", "", Форма);

КонецПроцедуры

// Точка маршрута «users/{логин}/role» — подтверждение смены роли хаба.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  логин - Строка - логин учётки.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента, попадает в журнал аудита.
//
&ТочкаМаршрута("users/{логин}/role")
Процедура СменаРоли(Ответ, логин, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	АдресУдаленногоУзла) Экспорт

	Мутация = Мутация(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// без скрипта форма ушла без вопроса: роль не меняется, сервер задаёт его окном
	Если НЕ Окна.Подтверждено(Мутация.Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресСписка(Мутация.Запрос), логин, "роль");
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Запрос,
		Пульт.СменитьРоль(Мутация.Инициатор, логин, Мутация.Форма, Строка(АдресУдаленногоУзла)),
		"", логин, Мутация.Форма);

КонецПроцедуры

// Точка маршрута «users/{логин}/toggle» — блокировка и разблокировка из меню строки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  логин - Строка - логин учётки.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("users/{логин}/toggle")
Процедура Блокировка(Ответ, логин, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Запрос, Пульт.Переключить(Мутация.Инициатор, логин, Мутация.Форма),
		"", логин, Мутация.Форма);

КонецПроцедуры

// Точка маршрута «users/{логин}/reset» — новая ссылка установки пароля. Удача отвечает страницей
// с ссылкой, без перенаправления: значение не должно попасть в адрес.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  логин - Строка - логин учётки.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента, попадает в журнал аудита.
//
&ТочкаМаршрута("users/{логин}/reset")
Процедура СбросПароля(Ответ, логин, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	АдресУдаленногоУзла) Экспорт

	Мутация = Мутация(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Окна.Подтверждено(Мутация.Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресСписка(Мутация.Запрос), логин, "сброс");
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Запрос,
		Пульт.СброситьПароль(Мутация.Принципал, логин, Строка(АдресУдаленногоУзла)),
		"", логин, Мутация.Форма);

КонецПроцедуры

// Точка маршрута «users/{логин}/delete». Без поля подтверждения учётка не удаляется: ответ ведёт
// на страницу с открытым подтверждением.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  логин - Строка - логин учётки.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента, попадает в журнал аудита.
//
&ТочкаМаршрута("users/{логин}/delete")
Процедура Удаление(Ответ, логин, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	АдресУдаленногоУзла) Экспорт

	Мутация = Мутация(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Окна.Подтверждено(Мутация.Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресСписка(Мутация.Запрос), логин);
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Запрос,
		Пульт.Удалить(Мутация.Инициатор, логин, Мутация.Форма, Строка(АдресУдаленногоУзла)),
		"удалить", логин, Мутация.Форма);

КонецПроцедуры

#КонецОбласти

#Область Действия

// Общий пролог мутирующих точек: гвард → только POST → форма с CSRF.
Функция Мутация(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса, Знач ТелоЗапроса)

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "POST", Вердикт, КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Запрос, Инициатор, Принципал, Форма",
		Запрос(Вердикт, КукиЗапроса, Отборы.ИзФормы(Форма)), Вердикт.Пользователь,
		Вердикт.Принципал, Форма);

КонецФункции

// Исход пульта → ответ: удача — 303 на список с тем же отбором, а выпущенная ссылка — страницей;
// отказ — страница с окном этой формы, открытым на набранном и отказах. Окна нет (блокировка,
// смена роли, учётки уже нет) — отказ тостом над разделом: причина названа в любом случае.
Процедура Завершить(Ответ, Знач Запрос, Знач Исход, Знач ВидОкна, Знач Логин, Знач Форма)

	Если Исход.Успех И Исход.Выпуск <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Запрос, 200, Неопределено, Ложь, "", Исход.Выпуск);
		Возврат;
	КонецЕсли;
	Если Исход.Успех Тогда
		Окна.ВернутьВРаздел(Ответ, АдресСписка(Запрос));
		Возврат;
	КонецЕсли;

	// отказ у поля в окне уже назван — второй раз над полями его не повторяют
	Окно = Окна.Отбитое(ВидОкна, Логин, Форма, Исход.Отказы,
		?(Исход.Отказы.Количество() > 0, "", Исход.Сообщение));
	Если ЗначениеЗаполнено(ВидОкна) И Витрина.ЕстьОкно(Окно, Запрос.Вердикт.Пользователь) Тогда
		ОтдатьРаздел(Ответ, Запрос, Исход.Код, Окно, Ложь);
		Возврат;
	КонецЕсли;
	ОтдатьРаздел(Ответ, Запрос, Исход.Код, Неопределено, Ложь, Исход.Сообщение);

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Запрос, Знач Статус, Знач Окно, Знач Сохранено, Знач Ошибка = "",
	Знач Выпуск = Неопределено)

	Параметры = Новый Структура("Адрес, Смотрящий, Отбор, Окно, Выпуск", АдресРаздела(),
		Запрос.Вердикт.Пользователь, Запрос.Отбор, Окно, Выпуск);

	Модель = Ответы.МодельДома(Дом, "",
		Дом.Разделы("users"),
		Ответы.УведомленияРаздела(Сохранено, Ошибка),
		Витрина.Секции(Параметры),
		Защита.ТокенСессии(Запрос.Вердикт.Сессия));

	Ответы.ОтдатьДом(Ответ, Модель, Запрос.Вердикт, Запрос.Куки, Статус);

КонецПроцедуры

Функция Запрос(Знач Вердикт, Знач КукиЗапроса, Знач Отбор)
	Возврат Новый Структура("Вердикт, Куки, Отбор", Вердикт, КукиЗапроса, Отбор);
КонецФункции

Функция АдресРаздела()
	Возврат Дом.АдресРаздела("users");
КонецФункции

// Список, к которому вернуть человека: раздел с тем же отбором и страницей.
Функция АдресСписка(Знач Запрос)
	Возврат Отборы.Адрес(АдресРаздела(), Запрос.Отбор);
КонецФункции

#КонецОбласти

&Контроллер("/hub/settings")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардХабАдмина") _ГвардХаб,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ВитринаУчёток") _Витрина,
	&Пластилин(Значение = "ПультУчёток") _Пульт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ОтборЛюдей") _Отборы)

	ГвардХаб = _ГвардХаб;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	Пульт = _Пульт;
	Защита = _Защита;
	Окна = _Окна;
	Отборы = _Отборы;

КонецПроцедуры
