// Маршруты раздела «Группы» дома «Хаб»: страница с поиском и окном по адресу, заведение группы
// и её удаление. Удача — 303 на раздел с тем же отбором, отказ — та же страница с окном,
// открытым на набранном и отказах.

Перем ГвардХаб;  // ГвардХабАдмина
Перем Ответы;    // ОтветыНастроек
Перем Дом;       // ДомХаба
Перем Витрина;   // ВитринаГруппХаба
Перем Пульт;     // ПультГруппХаба
Перем Защита;    // ЗащитаCSRF (вход) — токен сессии в форму
Перем Окна;      // ОкноРаздела — окно по адресу и ответы форм окон
Перем Отборы;    // ОтборЛюдей — отбор списка из адреса и из формы

#Область ТочкиМаршрута

// Точка маршрута «groups»: GET — страница раздела, POST — заведение группы.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  q - Строка - подстрока имени или описания группы (необязательный, по умолчанию "").
//  page - Строка - номер страницы списка (необязательный, по умолчанию "").
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: <вид>-<имя> (необязательный, по умолчанию "").
//
&ТочкаМаршрута("groups")
Процедура Раздел(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, q = "", page = "",
	saved = "", окно = "") Экспорт

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Запрос(Вердикт, КукиЗапроса, Отборы.ИзАдреса(q, "", "", page)), 200,
			Окна.ИзАдреса(окно, Витрина.ВидыОкон()), ЗначениеЗаполнено(saved));
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Запрос(Вердикт, КукиЗапроса, Отборы.ИзФормы(Форма)), Пульт.Создать(Форма),
		"новый", "", Форма);

КонецПроцедуры

// Точка маршрута «groups/{имя}/delete». Без поля подтверждения группа не удаляется: ответ ведёт
// на страницу с открытым подтверждением.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  имя - Строка - имя группы.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("groups/{имя}/delete")
Процедура Удаление(Ответ, имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "POST", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Запрос = Запрос(Вердикт, КукиЗапроса, Отборы.ИзФормы(Форма));

	Если НЕ Окна.Подтверждено(Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресСписка(Запрос), имя);
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Запрос, Пульт.Удалить(имя, Форма, ЛогинИнициатора(Вердикт)), "удалить", имя, Форма);

КонецПроцедуры

#КонецОбласти

#Область Действия

// Исход пульта → ответ: удача — 303 на список с тем же отбором; отказ — страница с окном этой
// формы, открытым на набранном и отказах; окна нет (группу уже удалили) — тостом над разделом.
Процедура Завершить(Ответ, Знач Запрос, Знач Исход, Знач ВидОкна, Знач Имя, Знач Форма)

	Если Исход.Успех Тогда
		Окна.ВернутьВРаздел(Ответ, АдресСписка(Запрос));
		Возврат;
	КонецЕсли;

	Окно = Окна.Отбитое(ВидОкна, Имя, Форма, Исход.Отказы,
		?(Исход.Отказы.Количество() > 0, "", Исход.Сообщение));
	Если Витрина.ЕстьОкно(Окно) Тогда
		ОтдатьРаздел(Ответ, Запрос, Исход.Код, Окно, Ложь);
		Возврат;
	КонецЕсли;
	ОтдатьРаздел(Ответ, Запрос, Исход.Код, Неопределено, Ложь, Исход.Сообщение);

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Запрос, Знач Статус, Знач Окно, Знач Сохранено, Знач Ошибка = "")

	Параметры = Новый Структура("Адрес, Отбор, Окно", АдресРаздела(), Запрос.Отбор, Окно);

	Модель = Ответы.МодельДома(Дом, "",
		Дом.Разделы("groups"),
		Ответы.УведомленияРаздела(Сохранено, Ошибка),
		Витрина.Секции(Параметры),
		Защита.ТокенСессии(Запрос.Вердикт.Сессия));

	Ответы.ОтдатьДом(Ответ, Модель, Запрос.Вердикт, Запрос.Куки, Статус);

КонецПроцедуры

Функция Запрос(Знач Вердикт, Знач КукиЗапроса, Знач Отбор)
	Возврат Новый Структура("Вердикт, Куки, Отбор", Вердикт, КукиЗапроса, Отбор);
КонецФункции

Функция АдресРаздела()
	Возврат Дом.АдресРаздела("groups");
КонецФункции

Функция АдресСписка(Знач Запрос)
	Возврат Отборы.Адрес(АдресРаздела(), Запрос.Отбор);
КонецФункции

// Кто удаляет — логином, для журнала аудита.
Функция ЛогинИнициатора(Знач Вердикт)
	Возврат ?(Вердикт.Пользователь = Неопределено, "", Строка(Вердикт.Пользователь.Логин));
КонецФункции

#КонецОбласти

&Контроллер("/hub/settings")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардХабАдмина") _ГвардХаб,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ВитринаГруппХаба") _Витрина,
	&Пластилин(Значение = "ПультГруппХаба") _Пульт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ОтборЛюдей") _Отборы)

	ГвардХаб = _ГвардХаб;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	Пульт = _Пульт;
	Защита = _Защита;
	Окна = _Окна;
	Отборы = _Отборы;

КонецПроцедуры
