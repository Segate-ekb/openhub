// Операции раздела «Пользователи» дома «Хаб»: заведение учётки со ссылкой установки пароля,
// смена роли хаба, блокировка, новая ссылка и удаление. Исход каждой — домена плюс отказы
// у полей окна; порог каждой операции судит домен, пульт переводит его код в слова.

Перем Гейт;                // ГейтФормы — CSRF-токен формы
Перем РазборФормы;
Перем Поля;                // ОкноУчётки — имена полей окон
Перем СервисПользователей; // СервисПользователей (вход) — учётка по логину, смена роли
Перем Активность;          // СервисАктивностиУчёток (вход) — блокировка и разблокировка
Перем Удаление;            // УдалениеУчётки (вход) — снос учётки со всем связанным
Перем Приглашения;         // СлужбаПриглашений (вход) — заведение учёток и ссылки
Перем Отказы;              // ОтказыУчёток — коды домена человеческим текстом
Перем Сбои;                // ТекстСбоя — причина сбоя человеку и отчёт в журнал
Перем Тексты;              // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Разбирает тело запроса и проверяет CSRF.
//
// Параметры:
//  Ответ - ОтветСервера.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  ТелоЗапроса - Строка.
//  КукиЗапроса - Куки - куки запроса.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - разобранная форма; Неопределено — ответ уже сформирован.
//
Функция Форма(Ответ, Знач Контекст, Знач ТелоЗапроса, Знач КукиЗапроса) Экспорт
	Возврат Гейт.СПринятымТокеном(Ответ, Контекст, РазборФормы.Разобрать(ТелоЗапроса), КукиЗапроса);
КонецФункции

// Заводит учётку по окну «Новый пользователь» и выпускает ей ссылку установки пароля.
//
// Параметры:
//  Принципал - Структура - принципал запроса.
//  Форма - Соответствие - разобранная форма.
//  АдресКлиента - Строка - адрес клиента для журнала.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка — причина отказа словами,
//              заполнена у любого отказа), Отказы (Соответствие — имя поля -> отказ под полем),
//              Выпуск (Структура, Неопределено — Логин и Ссылка, показать один раз).
//
Функция Пригласить(Знач Принципал, Знач Форма, Знач АдресКлиента) Экспорт

	Логин = Текст(Форма, Поля.ИмяПоляЛогина());
	Если НЕ ЗначениеЗаполнено(Логин) Тогда
		Возврат ОтбитоПолем(Поля.ИмяПоляЛогина(), Тексты.Текст("settings.hub.users.new.login.required"));
	КонецЕсли;

	Исход = Приглашения.Пригласить(Принципал, Логин, Текст(Форма, Поля.ИмяПоляПочты()),
		Текст(Форма, Поля.ИмяПоляРоли()), АдресКлиента);
	Если НЕ Исход.Успех Тогда
		// занятое имя и запрещённый символ живут именно в логине: отказ ложится под него
		Возврат ОтбитоПолем(Поля.ИмяПоляЛогина(), Отказы.ВыпускСсылки(Исход), Исход.Код);
	КонецЕсли;
	Возврат СВыпуском(Исход);

КонецФункции

// Меняет роль хаба на ту, что названа в подтверждении.
//
// Параметры:
//  Инициатор - Пользователь - администратор, подтвердивший смену.
//  Логин - Строка - логин из адреса маршрута.
//  Форма - Соответствие - разобранная форма подтверждения.
//  АдресКлиента - Строка - адрес клиента для журнала.
//
// Возвращаемое значение:
//  Структура - см. Пригласить.
//
Функция СменитьРоль(Знач Инициатор, Знач Логин, Знач Форма, Знач АдресКлиента) Экспорт

	Роль = Текст(Форма, Поля.ИмяПоляРоли());
	Цель = СервисПользователей.НайтиПоЛогину(Логин);

	Проверка = СервисПользователей.ПроверитьСменуРоли(Инициатор, Цель, Роль);
	Если НЕ Проверка.Успех Тогда
		Возврат Отбито(Отказы.СменаРоли(Проверка.Причина));
	КонецЕсли;

	Попытка
		СервисПользователей.НазначитьРольХаба(Инициатор, Цель, Роль, АдресКлиента);
	Исключение
		// между проверкой и применением учётку могли снести: причину называет та же проверка
		// по перечитанной цели, текст доменного исключения на экран не выносится
		Повтор = СервисПользователей.ПроверитьСменуРоли(Инициатор,
			СервисПользователей.НайтиПоЛогину(Логин), Роль);
		Возврат Отбито(Отказы.СменаРоли(Повтор.Причина));
	КонецПопытки;

	Возврат Удача();

КонецФункции

// Блокирует или разблокирует учётку: форма называет желаемое состояние, а не «переключить» —
// повтор отправки не переворачивает его обратно.
//
// Параметры:
//  Инициатор - Пользователь - администратор.
//  Логин - Строка - логин из адреса маршрута.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - см. Пригласить.
//
Функция Переключить(Знач Инициатор, Знач Логин, Знач Форма) Экспорт

	Цель = СервисПользователей.НайтиПоЛогину(Логин);
	Желаемая = (Текст(Форма, Поля.ИмяПоляАктивности()) = "1");

	Проверка = Активность.ПроверитьСменуАктивности(Инициатор, Цель, Желаемая);
	Если НЕ Проверка.Успех Тогда
		Возврат Отбито(Отказы.СменаАктивности(Проверка.Причина, Желаемая));
	КонецЕсли;

	Активность.УстановитьАктивность(Инициатор, Цель, Желаемая);
	Возврат Удача();

КонецФункции

// Выпускает учётке новую ссылку установки пароля; прежняя гаснет.
//
// Параметры:
//  Принципал - Структура - принципал запроса.
//  Логин - Строка - логин из адреса маршрута.
//  АдресКлиента - Строка - адрес клиента для журнала.
//
// Возвращаемое значение:
//  Структура - см. Пригласить.
//
Функция СброситьПароль(Знач Принципал, Знач Логин, Знач АдресКлиента) Экспорт

	Цель = СервисПользователей.НайтиПоЛогину(Логин);
	Исход = Приглашения.СброситьПароль(Принципал,
		?(Цель = Неопределено, 0, Цел(Цель.Идентификатор)), АдресКлиента);
	Если НЕ Исход.Успех Тогда
		Возврат Отбито(Отказы.ВыпускСсылки(Исход), Исход.Код);
	КонецЕсли;
	Возврат СВыпуском(Исход);

КонецФункции

// Удаляет учётку со всем связанным, если в эхо-поле набран её логин. Право судится раньше
// эха: отказ по праву и неподтверждённое удаление — разные ответы, и первым человек видит тот,
// что про него.
//
// Параметры:
//  Инициатор - Пользователь - администратор.
//  Логин - Строка - логин из адреса маршрута.
//  Форма - Соответствие - разобранная форма подтверждения.
//  АдресКлиента - Строка - адрес клиента для журнала.
//
// Возвращаемое значение:
//  Структура - см. Пригласить; несовпавшее эхо — отказ под эхо-полем, домен не зовётся.
//
Функция Удалить(Знач Инициатор, Знач Логин, Знач Форма, Знач АдресКлиента) Экспорт

	Цель = СервисПользователей.НайтиПоЛогину(Логин);

	Проверка = Удаление.ПроверитьУдаление(Инициатор, Цель);
	Если НЕ Проверка.Успех Тогда
		Возврат Отбито(Отказы.Удаление(Проверка.Причина));
	КонецЕсли;

	Если Текст(Форма, Поля.ИмяПоляЛогина()) <> Строка(Цель.Логин) Тогда
		Возврат ОтбитоПолем(Поля.ИмяПоляЛогина(),
			Тексты.Шаблон("settings.hub.users.delete.echo.mismatch", Строка(Цель.Логин)));
	КонецЕсли;

	// хранилище живёт снаружи и вправе отказать: администратор обязан увидеть отказ, учётка цела
	Попытка
		Удаление.Удалить(Инициатор, Цель, АдресКлиента);
	Исключение
		Возврат Отбито(Отказы.УдалениеСорвалось(Сбои.Человеку(ИнформацияОбОшибке())));
	КонецПопытки;

	Возврат Удача();

КонецФункции

#КонецОбласти

#Область Исходы

Функция Исход(Знач Успех, Знач Код, Знач Сообщение, Знач Отказы_, Знач Выпуск)
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы, Выпуск",
		Успех, Код, Сообщение, Отказы_, Выпуск);
КонецФункции

Функция Удача()
	Возврат Исход(Истина, 303, "", Новый Соответствие(), Неопределено);
КонецФункции

Функция СВыпуском(Знач ИсходДомена)
	Возврат Исход(Истина, 200, "", Новый Соответствие(),
		Новый Структура("Логин, Ссылка", ИсходДомена.Логин, ИсходДомена.Ссылка));
КонецФункции

Функция Отбито(Знач Сообщение, Знач Код = 400)
	Возврат Исход(Ложь, ?(Код >= 400, Код, 400), Сообщение, Новый Соответствие(), Неопределено);
КонецФункции

Функция ОтбитоПолем(Знач Имя, Знач Сообщение, Знач Код = 400)

	Результат = Отбито(Сообщение, Код);
	Результат.Отказы.Вставить(Имя, Сообщение);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Текст(Знач Форма, Знач Имя)
	Возврат СокрЛП(РазборФормы.Поле(Форма, Имя));
КонецФункции

#КонецОбласти

&Прозвище("ПультУчёток")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ОкноУчётки") _Поля,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "СервисАктивностиУчёток") _Активность,
	&Пластилин(Значение = "УдалениеУчётки") _Удаление,
	&Пластилин(Значение = "СлужбаПриглашений") _Приглашения,
	&Пластилин(Значение = "ОтказыУчёток") _Отказы,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	Поля = _Поля;
	СервисПользователей = _СервисПользователей;
	Активность = _Активность;
	Удаление = _Удаление;
	Приглашения = _Приглашения;
	Отказы = _Отказы;
	Сбои = _Сбои;
	Тексты = _Тексты;

КонецПроцедуры
