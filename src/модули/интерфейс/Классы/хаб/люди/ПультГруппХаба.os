// Операции раздела «Группы» дома «Хаб»: заведение группы и удаление со всей её обвязкой.
// Исход каждой — домена плюс отказы у полей окна.

Перем Гейт;          // ГейтФормы — CSRF-токен формы
Перем РазборФормы;
Перем Поля;          // ОкноГруппы — имена полей окон
Перем СлужбаГрупп;   // СлужбаГрупп (права) — жизненный цикл группы со всей её обвязкой
Перем СервисГрупп;   // СервисГрупп (права) — поиск группы по имени
Перем Тексты;        // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Разбирает тело запроса и проверяет CSRF.
//
// Параметры:
//  Ответ - ОтветСервера.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  ТелоЗапроса - Строка.
//  КукиЗапроса - Куки - куки запроса.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - разобранная форма; Неопределено — ответ уже сформирован.
//
Функция Форма(Ответ, Знач Контекст, Знач ТелоЗапроса, Знач КукиЗапроса) Экспорт
	Возврат Гейт.СПринятымТокеном(Ответ, Контекст, РазборФормы.Разобрать(ТелоЗапроса), КукиЗапроса);
КонецФункции

// Заводит группу по окну «Новая группа». Уникальность имени держит сервисный слой.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка — причина отказа словами,
//              заполнена у любого отказа), Отказы (Соответствие — имя поля -> отказ под полем).
//
Функция Создать(Знач Форма) Экспорт

	Имя = Текст(Форма, Поля.ИмяПоляИмени());
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Возврат ОтбитоПолем(Поля.ИмяПоляИмени(), Тексты.Текст("settings.hub.groups.new.name.required"));
	КонецЕсли;
	Если СервисГрупп.НайтиГруппу(Имя) <> Неопределено Тогда
		Возврат ОтбитоПолем(Поля.ИмяПоляИмени(), Тексты.Шаблон("settings.hub.groups.error.exists", Имя));
	КонецЕсли;

	Попытка
		СлужбаГрупп.Создать(Имя, Текст(Форма, Поля.ИмяПоляОписания()));
	Исключение
		// имя заняли между проверкой и записью либо оно непригодно: отказ ложится под имя
		Возврат ОтбитоПолем(Поля.ИмяПоляИмени(), Тексты.Шаблон("settings.hub.groups.error.exists", Имя));
	КонецПопытки;

	Возврат Удача();

КонецФункции

// Удаляет группу, если в эхо-поле набрано её имя.
//
// Параметры:
//  Имя - Строка - имя группы из адреса маршрута.
//  Форма - Соответствие - разобранная форма подтверждения.
//  Кто - Строка - принципал для журнала аудита.
//
// Возвращаемое значение:
//  Структура - см. Создать; несовпавшее эхо — отказ под эхо-полем, домен не зовётся.
//
Функция Удалить(Знач Имя, Знач Форма, Знач Кто) Экспорт

	Группа = СервисГрупп.НайтиГруппу(Имя);
	Если Группа = Неопределено Тогда
		Возврат Отбито(Тексты.Шаблон("settings.hub.groups.error.missing", Имя), 404);
	КонецЕсли;

	// эхо сверяется с именем группы из адреса, а не с любой существующей
	Если Текст(Форма, Поля.ИмяПоляИмени()) <> Строка(Группа.Имя) Тогда
		Возврат ОтбитоПолем(Поля.ИмяПоляИмени(),
			Тексты.Шаблон("settings.hub.groups.delete.echo.mismatch", Строка(Группа.Имя)));
	КонецЕсли;

	СлужбаГрупп.Удалить(Группа.Идентификатор, Кто);
	Возврат Удача();

КонецФункции

#КонецОбласти

#Область Исходы

Функция Исход(Знач Успех, Знач Код, Знач Сообщение)
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы", Успех, Код, Сообщение, Новый Соответствие());
КонецФункции

Функция Удача()
	Возврат Исход(Истина, 303, "");
КонецФункции

Функция Отбито(Знач Сообщение, Знач Код = 400)
	Возврат Исход(Ложь, Код, Сообщение);
КонецФункции

Функция ОтбитоПолем(Знач Имя, Знач Сообщение)

	Результат = Отбито(Сообщение);
	Результат.Отказы.Вставить(Имя, Сообщение);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Текст(Знач Форма, Знач Имя)
	Возврат СокрЛП(РазборФормы.Поле(Форма, Имя));
КонецФункции

#КонецОбласти

&Прозвище("ПультГруппХаба")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ОкноГруппы") _Поля,
	&Пластилин(Значение = "СлужбаГрупп") _СлужбаГрупп,
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	Поля = _Поля;
	СлужбаГрупп = _СлужбаГрупп;
	СервисГрупп = _СервисГрупп;
	Тексты = _Тексты;

КонецПроцедуры
