// Окна раздела «Группы»: новая группа и подтверждение удаления с эхом имени и тем, что снимается.
// Поля окон называет этот класс — по тем же именам их читает пульт групп.

Перем Кит;       // Кит (кит) — фабрика элементов экрана
Перем Окна;      // ОкноРаздела — набранное и отказы окна
Перем Отборы;    // ОтборЛюдей — отбор списка скрытыми полями формы
Перем Тексты;    // ТекстыИнтерфейса (кит)

#Область ИменаПолей

// Поле имени: в окне новой группы и эхо подтверждения удаления.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляИмени() Экспорт
	Возврат "имя";
КонецФункции

// Поле описания новой группы.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОписания() Экспорт
	Возврат "описание";
КонецФункции

#КонецОбласти

#Область Окна

// Окно «Новая группа»: на странице всегда, открытым — по адресу или с отбитой формой.
//
// Параметры:
//  АдресСписка - Строка - адрес списка с отбором: от него — адрес, по которому сервер печатает это
//                окно открытым (туда ведёт кнопка «Добавить …» без скрипта), и адрес закрытия.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//  Отбор - Структура - отбор списка (см. ОтборЛюдей.ИзАдреса).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Заведение(Знач АдресСписка, Знач Состояние, Знач Отбор) Экспорт

	Якорь = "gruppa-novaya";

	Возврат Кит.Окно(Тексты.Текст("settings.hub.groups.new.title"),
			ОшибкаОкна(Состояние),
			Кит.Поле(ИмяПоляИмени(), Тексты.Текст("settings.hub.groups.new.name")).Обязательное()
				.Значение(Окна.Значение(Состояние, ИмяПоляИмени())).Пример("platform")
				.Подсказка(Тексты.Текст("settings.hub.groups.new.name.hint"))
				.Ошибка(Окна.Отказ(Состояние, ИмяПоляИмени())),
			Кит.Поле(ИмяПоляОписания(), Тексты.Текст("settings.hub.groups.new.description"))
				.Значение(Окна.Значение(Состояние, ИмяПоляОписания()))
				.Ошибка(Окна.Отказ(Состояние, ИмяПоляОписания())),
			Отборы.Поля(Отбор))
		.Лид(Тексты.Текст("settings.hub.groups.new.lead"))
		.Форма("").БезПерезагрузки().Якорь(Якорь).Адрес(Окна.Адрес(АдресСписка, "новый"))
		.Открыто(Окна.Открыто(Состояние, "новый")).АдресЗакрытия(АдресСписка)
		.Действия(Кит.Кнопка(Тексты.Текст("settings.hub.groups.new.button")).Основная().Иконка("плюс"));

КонецФункции

// Подтверждение удаления группы: эхо имени и что снимается вместе с ней; участники остаются.
//
// Параметры:
//  Группа - Группа - удаляемая группа.
//  Участников - Число - сколько людей в группе.
//  Состояние - Структура, Неопределено - состояние окна раздела: отказ под эхо-полем.
//  Отбор - Структура - отбор списка.
//  АдресСписка - Строка - адрес списка с отбором: туда закрывается подтверждение.
//  Хвост - Строка - адрес формы относительно раздела: «<имя>/delete».
//
// Возвращаемое значение:
//  ЭлементЭкрана - подтверждение, напечатанное открытым.
//
Функция Удаление(Знач Группа, Знач Участников, Знач Состояние, Знач Отбор, Знач АдресСписка,
	Знач Хвост) Экспорт

	Имя = Строка(Группа.Имя);
	Возврат Кит.Подтверждение(Тексты.Шаблон("settings.hub.groups.delete.title", Имя),
			Тексты.Шаблон("settings.hub.groups.delete.consequence", ОстаютсяВХабе(Участников)),
			ОшибкаОкна(Состояние),
			Отборы.Поля(Отбор))
		.Эхо(ИмяПоляИмени(), Имя, Тексты.Текст("settings.hub.groups.delete.echo"))
		.Кнопка(Тексты.Текст("settings.hub.groups.action.delete"))
		.Ошибка(Окна.Отказ(Состояние, ИмяПоляИмени()))
		.Форма(Хвост).БезПерезагрузки().Якорь("gruppa-udalit").Открыто().АдресЗакрытия(АдресСписка);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// «1 участник останется», «2 участника останутся», «5 участников останутся».
Функция ОстаютсяВХабе(Знач Число_)

	Текст = Формат(Число_, "ЧГ=0; ЧН=0");
	Если Число_ = 0 Тогда
		Возврат Тексты.Текст("settings.hub.groups.delete.members.none");
	ИначеЕсли Число_ % 10 = 1 И Число_ % 100 <> 11 Тогда
		Возврат Тексты.Шаблон("settings.hub.groups.delete.members.one", Текст);
	ИначеЕсли Число_ % 10 >= 2 И Число_ % 10 <= 4 И (Число_ % 100 < 12 ИЛИ Число_ % 100 > 14) Тогда
		Возврат Тексты.Шаблон("settings.hub.groups.delete.members.few", Текст);
	КонецЕсли;
	Возврат Тексты.Шаблон("settings.hub.groups.delete.members.many", Текст);

КонецФункции

Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

#КонецОбласти

&Прозвище("ОкноГруппы")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ОтборЛюдей") _Отборы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Окна = _Окна;
	Отборы = _Отборы;
	Тексты = _Тексты;

КонецПроцедуры
