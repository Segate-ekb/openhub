// Окна раздела «Пользователи»: новый пользователь, подтверждения роли, сброса пароля и удаления,
// выпущенная ссылка установки пароля. Поля окон называет этот класс — по тем же именам их
// читает пульт. Набранное и отказы отбитой формы окно берёт у состояния окна раздела.

Перем Кит;       // Кит (кит) — фабрика элементов экрана
Перем Окна;      // ОкноРаздела — набранное и отказы окна
Перем Отборы;    // ОтборЛюдей — отбор списка скрытыми полями формы
Перем Роли;      // СервисПользователей (вход) — имена ролей хаба
Перем Тексты;    // ТекстыИнтерфейса (кит)

#Область ИменаПолей

// Поле логина: в окне нового пользователя и эхо подтверждения удаления.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляЛогина() Экспорт
	Возврат "логин";
КонецФункции

// Поле адреса почты нового пользователя.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляПочты() Экспорт
	Возврат "email";
КонецФункции

// Поле роли: выбор в окне нового пользователя и запрошенная роль в подтверждении смены.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляРоли() Экспорт
	Возврат "роль";
КонецФункции

// Поле желаемой активности в форме блокировки: «1» — разблокировать, «0» — заблокировать.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляАктивности() Экспорт
	Возврат "активна";
КонецФункции

#КонецОбласти

#Область Окна

// Окно «Новый пользователь»: на странице всегда, открытым — по адресу или с отбитой формой.
// Отправка обычная: удача отвечает страницей с выпущенной ссылкой, а не перенаправлением.
//
// Параметры:
//  АдресСписка - Строка - адрес списка с отбором: от него — адрес, по которому сервер печатает это
//                окно открытым (туда ведёт кнопка «Добавить …» без скрипта), и адрес закрытия.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//  Отбор - Структура - отбор списка (см. ОтборЛюдей.ИзАдреса).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Заведение(Знач АдресСписка, Знач Состояние, Знач Отбор) Экспорт

	Якорь = "polzovatel-novyi";

	Возврат Кит.Окно(Тексты.Текст("settings.hub.users.new.title"),
			ОшибкаОкна(Состояние),
			Кит.Поле(ИмяПоляЛогина(), Тексты.Текст("settings.hub.users.new.login")).Обязательное()
				.Значение(Окна.Значение(Состояние, ИмяПоляЛогина()))
				.Подсказка(Тексты.Текст("settings.hub.users.new.login.hint"))
				.Ошибка(Окна.Отказ(Состояние, ИмяПоляЛогина())),
			Кит.Поле(ИмяПоляПочты(), Тексты.Текст("settings.hub.users.new.email"))
				.Значение(Окна.Значение(Состояние, ИмяПоляПочты()))
				.Подсказка(Тексты.Текст("settings.hub.users.new.email.hint"))
				.Ошибка(Окна.Отказ(Состояние, ИмяПоляПочты())),
			ВыборРоли(Состояние),
			Отборы.Поля(Отбор))
		.Лид(Тексты.Текст("settings.hub.users.new.lead"))
		.Форма("").Якорь(Якорь).Адрес(Окна.Адрес(АдресСписка, "новый")).Открыто(Окна.Открыто(Состояние, "новый"))
		.АдресЗакрытия(АдресСписка)
		.Действия(Кит.Кнопка(Тексты.Текст("settings.hub.users.new.button")).Основная().Иконка("плюс"));

КонецФункции

// Подтверждение смены роли: называет запрошенную роль, и форма несёт её же — повтор отправки
// не переворачивает роль обратно.
//
// Параметры:
//  Пользователь - Пользователь - чья роль меняется.
//  Роль - Строка - запрошенная роль.
//  Отбор - Структура - отбор списка.
//  АдресСписка - Строка - адрес списка с отбором: туда закрывается подтверждение.
//  Хвост - Строка - адрес формы относительно раздела: «<логин>/role».
//
// Возвращаемое значение:
//  ЭлементЭкрана - подтверждение, напечатанное открытым.
//
Функция Роль(Знач Пользователь, Знач Роль, Знач Отбор, Знач АдресСписка, Знач Хвост) Экспорт

	Логин = Строка(Пользователь.Логин);
	Если Роль = Роли.РольАдмин() Тогда
		Подтверждение = Кит.Подтверждение(Тексты.Шаблон("settings.hub.users.grant.title", Логин),
				Тексты.Текст("settings.hub.users.grant.consequence"))
			.Кнопка(Тексты.Текст("settings.hub.users.action.grant"));
	Иначе
		Подтверждение = Кит.Подтверждение(Тексты.Шаблон("settings.hub.users.revoke.title", Логин),
				Тексты.Текст("settings.hub.users.revoke.consequence"))
			.Кнопка(Тексты.Текст("settings.hub.users.action.revoke"));
	КонецЕсли;

	Подтверждение.Добавить(Кит.СкрытоеПоле(ИмяПоляРоли(), Роль));
	Подтверждение.Добавить(Отборы.Поля(Отбор));
	Возврат Подтверждение.Форма(Хвост).БезПерезагрузки().Якорь("polzovatel-rol").Открыто()
		.АдресЗакрытия(АдресСписка);

КонецФункции

// Подтверждение сброса пароля. Отправка обычная: удача отвечает страницей с новой ссылкой.
//
// Параметры:
//  Пользователь - Пользователь - кому выпускается ссылка.
//  Отбор - Структура - отбор списка.
//  АдресСписка - Строка - адрес списка с отбором: туда закрывается подтверждение.
//  Хвост - Строка - адрес формы относительно раздела: «<логин>/reset».
//
// Возвращаемое значение:
//  ЭлементЭкрана - подтверждение, напечатанное открытым.
//
Функция Сброс(Знач Пользователь, Знач Отбор, Знач АдресСписка, Знач Хвост) Экспорт

	Возврат Кит.Подтверждение(Тексты.Шаблон("settings.hub.users.reset.title", Строка(Пользователь.Логин)),
			Тексты.Текст("settings.hub.users.reset.consequence"),
			Отборы.Поля(Отбор))
		.Кнопка(Тексты.Текст("settings.hub.users.action.reset"))
		.Форма(Хвост).Якорь("polzovatel-sbros").Открыто().АдресЗакрытия(АдресСписка);

КонецФункции

// Подтверждение удаления с эхом логина: что уходит вместе с учёткой, названо в последствиях;
// отказ домена, который не про эхо (удаление сорвалось), — над эхо-полем.
//
// Параметры:
//  Пользователь - Пользователь - удаляемая учётка.
//  Состояние - Структура, Неопределено - состояние окна раздела: отказ под эхо-полем.
//  Отбор - Структура - отбор списка.
//  АдресСписка - Строка - адрес списка с отбором: туда закрывается подтверждение.
//  Хвост - Строка - адрес формы относительно раздела: «<логин>/delete».
//
// Возвращаемое значение:
//  ЭлементЭкрана - подтверждение, напечатанное открытым.
//
Функция Удаление(Знач Пользователь, Знач Состояние, Знач Отбор, Знач АдресСписка, Знач Хвост) Экспорт

	Логин = Строка(Пользователь.Логин);
	Возврат Кит.Подтверждение(Тексты.Шаблон("settings.hub.users.delete.title", Логин),
			Тексты.Текст("settings.hub.users.delete.consequence"),
			ОшибкаОкна(Состояние),
			Отборы.Поля(Отбор))
		.Эхо(ИмяПоляЛогина(), Логин, Тексты.Текст("settings.hub.users.delete.echo"))
		.Кнопка(Тексты.Текст("settings.hub.users.action.delete"))
		.Ошибка(Окна.Отказ(Состояние, ИмяПоляЛогина()))
		.Форма(Хвост).БезПерезагрузки().Якорь("polzovatel-udalit").Открыто().АдресЗакрытия(АдресСписка);

КонецФункции

// Выпущенная ссылка установки пароля — один раз, открытым окном над списком: в базе её нет,
// показать её второй раз нечем. Окно — ответ формы: крестик, «Закрыть» и Esc уводят переходом на
// список без ссылки и со скриптом.
//
// Параметры:
//  Выпуск - Структура - Логин, Ссылка.
//  АдресСписка - Строка - куда уводит закрытие окна: раздел с тем же отбором.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Выпуск(Знач Выпуск, Знач АдресСписка) Экспорт

	Возврат Кит.Окно(Тексты.Шаблон("settings.hub.users.link.title", Строка(Выпуск.Логин)),
			Кит.Свойства(Кит.Свойство(Тексты.Текст("settings.hub.users.link.label"),
				Кит.Код(Строка(Выпуск.Ссылка))).Копируемое()))
		.Лид(Тексты.Текст("settings.hub.users.link.lead"))
		.Якорь("polzovatel-ssylka").Открыто()
		.АдресЗакрытия(АдресСписка).Переходом();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Умолчание — обычный пользователь: роль администратора выдают осознанно.
Функция ВыборРоли(Знач Состояние)

	Имя = ИмяПоляРоли();
	Возврат Кит.Поле(Имя, Тексты.Текст("settings.hub.users.new.role"))
		.Вариант(Роли.РольПользователь(), Тексты.Текст("settings.hub.users.role.user"))
		.Вариант(Роли.РольАдмин(), Тексты.Текст("settings.hub.users.role.admin"))
		.Значение(Окна.Значение(Состояние, Имя, Роли.РольПользователь()))
		.Ошибка(Окна.Отказ(Состояние, Имя));

КонецФункции

Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

#КонецОбласти

&Прозвище("ОкноУчётки")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ОтборЛюдей") _Отборы,
	&Пластилин(Значение = "СервисПользователей") _Роли,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Окна = _Окна;
	Отборы = _Отборы;
	Роли = _Роли;
	Тексты = _Тексты;

КонецПроцедуры
