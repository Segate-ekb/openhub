// Раздел «Группы» дома «Хаб»: таблица групп с поиском и страницами, меню ⚙ строки (настройки
// группы, удаление); окно новой группы и подтверждение удаления — по адресу.

Перем Кит;          // Кит (кит) — фабрика элементов экрана
Перем СервисГрупп;  // СервисГрупп (права) — список групп и размер их состава
Перем ДомГруппы;    // ДомГруппы — адрес дома настроек группы
Перем Окна;         // ОкноРаздела — окно по адресу и его состояние
Перем ОкноГруппы;   // ОкноГруппы — окна раздела
Перем Отборы;       // ОтборЛюдей — отбор, страница и их адрес
Перем Тексты;       // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<имя>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат "новый,удалить";
КонецФункции

// Секции раздела.
//
// Параметры:
//  Параметры - Структура:
//    * Адрес - Строка - адрес раздела без параметров;
//    * Отбор - Структура - отбор списка (см. ОтборЛюдей.ИзАдреса);
//    * Окно - Структура, Неопределено - состояние открытого окна (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - одна секция: поиск, таблица, страницы и окна.
//
Функция Секции(Знач Параметры) Экспорт

	Адрес = Параметры.Адрес;
	Отбор = Параметры.Отбор;
	Состояние = Параметры.Окно;
	АдресСписка = Отборы.Адрес(Адрес, Отбор);

	Страница = Отборы.Страница(Отобранные(Отбор.Подстрока), Отбор);

	ОкноЗаведения = ОкноГруппы.Заведение(АдресСписка, Состояние, Отбор);

	Секция = Кит.Секция(Тексты.Текст("settings.hub.groups.title"),
			ФормаПоиска(Адрес, Отбор),
			Таблица(Страница.Записи, Отбор, АдресСписка),
			Отборы.Пагинация(Адрес, Отбор, Страница),
			ОкноЗаведения,
			ОткрытоеОкно(Состояние, Отбор, АдресСписка))
		.Лид(Тексты.Текст("settings.hub.groups.lead")).Иконка("группа")
		.Действия(Кит.Кнопка(Тексты.Текст("settings.hub.groups.add")).Основная().Иконка("плюс")
			.Открывает(ОкноЗаведения));

	Результат = Новый Массив();
	Результат.Добавить(Секция);
	Возврат Результат;

КонецФункции

// Напечатает ли раздел окно, которое называет состояние: окно новой группы — всегда,
// подтверждение удаления — когда группа есть.
//
// Параметры:
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Состояние) Экспорт
	Возврат Окна.Открыто(Состояние, "новый") ИЛИ ГруппаОкна(Состояние) <> Неопределено;
КонецФункции

#КонецОбласти

#Область Таблица

// Групп на хабе единицы и десятки: подстрока ищется в имени и описании, без регистра.
Функция Отобранные(Знач Подстрока)

	Запрос = НРег(СокрЛП(Подстрока));
	Все = СервисГрупп.ВсеГруппы();
	Если НЕ ЗначениеЗаполнено(Запрос) Тогда
		Возврат Все;
	КонецЕсли;

	Результат = Новый Массив();
	Для Каждого Группа Из Все Цикл
		Если СтрНайти(НРег(Строка(Группа.Имя)), Запрос) > 0
			ИЛИ СтрНайти(НРег(Строка(Группа.Описание)), Запрос) > 0 Тогда
			Результат.Добавить(Группа);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ФормаПоиска(Знач Адрес, Знач Отбор)

	Возврат Кит.СтрокаПоиска(Адрес).Метка(Тексты.Текст("settings.hub.groups.filter.search"))
		.Значение(Отбор.Подстрока).Пример(Тексты.Текст("settings.hub.groups.filter.search.example"))
		.БезПерезагрузки();

КонецФункции

// На узком экране — карточки с именем группы заглавием и ⚙ в углу.
Функция Таблица(Знач Группы, Знач Отбор, Знач АдресСписка)

	Таблица = Кит.Таблица(Строки(Группы, АдресСписка)).Вид("карточками").Пустое("—")
		.Пусто(ПустаяВыдача(Отбор));
	Таблица.Колонка("name", Тексты.Текст("settings.hub.groups.col.name")).Заглавная();
	Таблица.Колонка("description", Тексты.Текст("settings.hub.groups.col.description"));
	Таблица.Колонка("members", Тексты.Текст("settings.hub.groups.col.members")).Вид("число");
	Таблица.Колонка("actions", Тексты.Текст("settings.hub.groups.col.actions")).БезПодписиВЗаписи();
	Возврат Таблица;

КонецФункции

// Состав всех групп страницы спрашивается одним разрезом, а не вопросом на строку.
Функция Строки(Знач Группы, Знач АдресСписка)

	Составы = СервисГрупп.ЧислоУчастниковГрупп(Идентификаторы(Группы));

	Результат = Новый Массив();
	Для Каждого Группа Из Группы Цикл
		Имя = Строка(Группа.Имя);
		Результат.Добавить(Новый Структура("name, description, members, actions",
			Кит.Ссылка(ДомГруппы.БазовыйАдрес(Имя), Имя),
			?(ЗначениеЗаполнено(Группа.Описание), Строка(Группа.Описание), ""),
			Участников(Группа, Составы),
			Меню(Имя, АдресСписка)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Состав и права группы правят в её доме; удаление спрашивает имя по адресу.
Функция Меню(Знач Имя, Знач АдресСписка)

	Возврат Кит.Меню(Тексты.Шаблон("settings.hub.groups.menu", Имя),
		Кит.ПунктМеню(Тексты.Текст("settings.hub.groups.action.settings"), ДомГруппы.БазовыйАдрес(Имя))
			.Иконка("шестерёнка"),
		Кит.ОкноПоАдресу(Окна.Адрес(АдресСписка, "удалить", Имя),
			Тексты.Текст("settings.hub.groups.action.delete")).Опасная().Иконка("корзина"));

КонецФункции

// Группы без участников в разрезе нет — у неё ноль.
Функция Участников(Знач Группа, Знач Составы)
	Сосчитано = Составы.Получить(Цел(Группа.Идентификатор));
	Возврат ?(Сосчитано = Неопределено, 0, Сосчитано);
КонецФункции

Функция Идентификаторы(Знач Группы)

	Результат = Новый Массив();
	Для Каждого Группа Из Группы Цикл
		Результат.Добавить(Цел(Группа.Идентификатор));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПустаяВыдача(Знач Отбор)
	Если ЗначениеЗаполнено(Отбор.Подстрока) Тогда
		Возврат Тексты.Шаблон("settings.hub.groups.empty.filter", Отбор.Подстрока);
	КонецЕсли;
	Возврат Тексты.Текст("settings.hub.groups.empty");
КонецФункции

#КонецОбласти

#Область Окна

// Подтверждение удаления, названное адресом. Группы нет — страница без окна.
Функция ОткрытоеОкно(Знач Состояние, Знач Отбор, Знач АдресСписка)

	Группа = ГруппаОкна(Состояние);
	Если Группа = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Состав = СервисГрупп.ЧислоУчастниковГрупп(Идентификаторы(Одна(Группа)));
	Возврат ОкноГруппы.Удаление(Группа, Участников(Группа, Состав), Состояние, Отбор, АдресСписка,
		КодироватьСтроку(Строка(Группа.Имя), СпособКодированияСтроки.КодировкаURL) + "/delete");

КонецФункции

Функция ГруппаОкна(Знач Состояние)

	Если НЕ Окна.Открыто(Состояние, "удалить") ИЛИ НЕ ЗначениеЗаполнено(Состояние.Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат СервисГрупп.НайтиГруппу(Состояние.Ключ);

КонецФункции

Функция Одна(Знач Группа)
	Результат = Новый Массив();
	Результат.Добавить(Группа);
	Возврат Результат;
КонецФункции

#КонецОбласти

&Прозвище("ВитринаГруппХаба")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп,
	&Пластилин(Значение = "ДомГруппы") _ДомГруппы,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ОкноГруппы") _ОкноГруппы,
	&Пластилин(Значение = "ОтборЛюдей") _Отборы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	СервисГрупп = _СервисГрупп;
	ДомГруппы = _ДомГруппы;
	Окна = _Окна;
	ОкноГруппы = _ОкноГруппы;
	Отборы = _Отборы;
	Тексты = _Тексты;

КонецПроцедуры
