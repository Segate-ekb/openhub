// Отбор таблиц пользователей и групп — подстрока, роль, статус и номер страницы. Отбор живёт в адресе:
// ссылка показывает тот же список, а формы строк несут его скрытыми полями, чтобы правка вернула
// человека к тому же списку.

Перем Кит;          // Кит (кит) — скрытые поля и пагинация
Перем Ссылки;       // ПараметрыСсылки (основа) — параметр запроса на адресе
Перем Числа;        // ПриведениеЧисел (основа) — терпимое чтение номера страницы
Перем РазборФормы;  // РазборФормы — поля формы строки
Перем Роли;         // СервисПользователей (вход) — роли хаба, по которым отбирают

#Область Значения

// Значение отбора по статусу «активен».
//
// Возвращаемое значение:
//  Строка.
//
Функция СтатусАктивен() Экспорт
	Возврат "active";
КонецФункции

// Значение отбора по статусу «заблокирован».
//
// Возвращаемое значение:
//  Строка.
//
Функция СтатусЗаблокирован() Экспорт
	Возврат "blocked";
КонецФункции

// Значение отбора по статусу «нечем войти».
//
// Возвращаемое значение:
//  Строка.
//
Функция СтатусНечемВойти() Экспорт
	Возврат "nologin";
КонецФункции

// Сколько записей на странице таблицы.
//
// Возвращаемое значение:
//  Число.
//
Функция РазмерСтраницы() Экспорт
	Возврат 20;
КонецФункции

#КонецОбласти

#Область Чтение

// Отбор из параметров адреса. Незнакомые роль и статус отбрасываются, а не применяются;
// роль отбора — роль хаба (admin, user).
//
// Параметры:
//  Подстрока - Строка - параметр q.
//  Роль - Строка - параметр role.
//  Статус - Строка - параметр status.
//  Страница - Строка - параметр page.
//
// Возвращаемое значение:
//  Структура - Подстрока, Роль, Статус (Строка), Страница (Число, с 1).
//
Функция ИзАдреса(Знач Подстрока, Знач Роль = "", Знач Статус = "", Знач Страница = "") Экспорт

	Роль_ = НРег(СокрЛП(Строка(Роль)));
	Статус_ = НРег(СокрЛП(Строка(Статус)));
	Номер = Числа.ЦелоеИлиНеопределено(СокрЛП(Строка(Страница)));

	Возврат Новый Структура("Подстрока, Роль, Статус, Страница",
		СокрЛП(Строка(Подстрока)),
		?(РолиОтбора().Найти(Роль_) = Неопределено, "", Роль_),
		?(Статусы().Найти(Статус_) = Неопределено, "", Статус_),
		?(Номер = Неопределено, 1, Макс(1, Номер)));

КонецФункции

// Отбор, который принесла форма строки скрытыми полями.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - см. ИзАдреса.
//
Функция ИзФормы(Знач Форма) Экспорт
	Возврат ИзАдреса(РазборФормы.Поле(Форма, "q"), РазборФормы.Поле(Форма, "role"),
		РазборФормы.Поле(Форма, "status"), РазборФормы.Поле(Форма, "page"));
КонецФункции

#КонецОбласти

#Область Печать

// Адрес раздела с отбором: пустые части и первая страница в адрес не попадают.
//
// Параметры:
//  АдресРаздела - Строка - адрес раздела без параметров.
//  Отбор - Структура - см. ИзАдреса.
//
// Возвращаемое значение:
//  Строка.
//
Функция Адрес(Знач АдресРаздела, Знач Отбор) Экспорт

	Результат = Строка(АдресРаздела);
	Для Каждого Пара Из Пары(Отбор) Цикл
		Результат = Ссылки.Установить(Результат, Пара.Имя, Пара.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Скрытые поля отбора для формы строки: после правки сервер вернёт к тому же списку.
//
// Параметры:
//  Отбор - Структура - см. ИзАдреса.
//
// Возвращаемое значение:
//  ЭлементЭкрана - холст скрытых полей; пустой отбор — пустой холст.
//
Функция Поля(Знач Отбор) Экспорт

	Результат = Кит.Холст();
	Для Каждого Пара Из Пары(Отбор) Цикл
		Результат.Добавить(Кит.СкрытоеПоле(Пара.Имя, Пара.Значение));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Страница записей по отбору: номер больше последнего читается последним.
//
// Параметры:
//  Записи - Массив - все отобранные записи.
//  Отбор - Структура - см. ИзАдреса.
//
// Возвращаемое значение:
//  Структура - Записи (Массив — записи страницы), Страница (Число), Всего (Число).
//
Функция Страница(Знач Записи, Знач Отбор) Экспорт

	Всего = Записи.Количество();
	Размер = РазмерСтраницы();
	Последняя = Макс(1, Цел((Всего + Размер - 1) / Размер));
	Номер = Мин(Отбор.Страница, Последняя);

	Срез = Новый Массив();
	Для Индекс = (Номер - 1) * Размер По Мин(Номер * Размер, Всего) - 1 Цикл
		Срез.Добавить(Записи[Индекс]);
	КонецЦикла;

	Возврат Новый Структура("Записи, Страница, Всего", Срез, Номер, Всего);

КонецФункции

// Пагинация таблицы: «1–20 из 37», шаги несут отбор и уходят без перезагрузки.
//
// Параметры:
//  АдресРаздела - Строка - адрес раздела без параметров.
//  Отбор - Структура - см. ИзАдреса.
//  Страница - Структура - см. Страница.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Пагинация(Знач АдресРаздела, Знач Отбор, Знач Страница) Экспорт

	Результат = Кит.Пагинация(АдресРаздела, Страница.Страница).Всего(Страница.Всего)
		.НаСтранице(РазмерСтраницы()).БезПерезагрузки();
	Для Каждого Пара Из Пары(Отбор, Ложь) Цикл
		Результат.Параметры(Пара.Имя, Пара.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Пары(Знач Отбор, Знач СоСтраницей = Истина)

	Результат = Новый Массив();
	ДобавитьПару(Результат, "q", Отбор.Подстрока);
	ДобавитьПару(Результат, "role", Отбор.Роль);
	ДобавитьПару(Результат, "status", Отбор.Статус);
	Если СоСтраницей И Отбор.Страница > 1 Тогда
		ДобавитьПару(Результат, "page", Формат(Отбор.Страница, "ЧГ=0"));
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура ДобавитьПару(Пары, Знач Имя, Знач Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		Пары.Добавить(Новый Структура("Имя, Значение", Имя, Строка(Значение)));
	КонецЕсли;
КонецПроцедуры

Функция РолиОтбора()
	Возврат СтрРазделить(Роли.РольАдмин() + "," + Роли.РольПользователь(), ",");
КонецФункции

Функция Статусы()
	Возврат СтрРазделить(СтатусАктивен() + "," + СтатусЗаблокирован() + "," + СтатусНечемВойти(), ",");
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ПараметрыСсылки") _Ссылки,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисПользователей") _Роли)

	Кит = _Кит;
	Ссылки = _Ссылки;
	Числа = _Числа;
	РазборФормы = _РазборФормы;
	Роли = _Роли;

КонецПроцедуры
