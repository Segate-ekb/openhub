// Раздел «Пользователи» дома «Хаб»: таблица учёток с отбором по подстроке, роли и статусу,
// страницы, меню ⚙ строки; окна нового пользователя, смены роли, сброса пароля и удаления —
// по адресу, выпущенная ссылка — открытым окном один раз.

Перем Кит;                 // Кит (кит) — фабрика элементов экрана
Перем Учётки;              // СписокУчёток (вход) — учётки и признак «есть чем войти» у каждой
Перем Права;               // СервисПрав (права) — кто из списка администратор
Перем Роли;                // СервисПользователей (вход) — имена ролей хаба
Перем Окна;                // ОкноРаздела — окно по адресу и его состояние
Перем ОкноУчётки;          // ОкноУчётки — окна раздела
Перем Отборы;              // ОтборЛюдей — отбор, страница и их адрес
Перем Тексты;              // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<логин>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат "новый,роль,сброс,удалить";
КонецФункции

// Секции раздела.
//
// Параметры:
//  Параметры - Структура:
//    * Адрес - Строка - адрес раздела без параметров;
//    * Смотрящий - Пользователь - администратор, открывший раздел;
//    * Отбор - Структура - отбор списка (см. ОтборЛюдей.ИзАдреса);
//    * Окно - Структура, Неопределено - состояние открытого окна (см. ОкноРаздела.Отбитое);
//    * Выпуск - Структура, Неопределено - выпущенная ссылка (Логин, Ссылка): показать один раз.
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - одна секция: отбор, таблица, страницы и окна.
//
Функция Секции(Знач Параметры) Экспорт

	Адрес = Параметры.Адрес;
	Отбор = Параметры.Отбор;
	Состояние = Параметры.Окно;
	АдресСписка = Отборы.Адрес(Адрес, Отбор);

	Страница = Отборы.Страница(Отобранные(Отбор), Отбор);

	ОкноЗаведения = ОкноУчётки.Заведение(АдресСписка, Состояние, Отбор);

	Секция = Кит.Секция(Тексты.Текст("settings.hub.users.title"),
			ФормаОтбора(Адрес, Отбор),
			Таблица(Страница.Записи, Параметры.Смотрящий, АдресСписка, Отбор),
			Отборы.Пагинация(Адрес, Отбор, Страница),
			ОкноЗаведения,
			ОткрытоеОкно(Параметры.Смотрящий, Состояние, Отбор, АдресСписка),
			ОкноВыпуска(Параметры, АдресСписка))
		.Лид(Тексты.Текст("settings.hub.users.lead")).Иконка("аккаунт")
		.Действия(Кит.Кнопка(Тексты.Текст("settings.hub.users.add")).Основная().Иконка("плюс")
			.Открывает(ОкноЗаведения));

	Результат = Новый Массив();
	Результат.Добавить(Секция);
	Возврат Результат;

КонецФункции

// Напечатает ли раздел окно, которое называет состояние: окно нового пользователя — всегда;
// окно записи — когда учётка есть и это не сам смотрящий (себе роль не меняют и себя не удаляют).
//
// Параметры:
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//  Смотрящий - Пользователь - администратор, открывший раздел.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Состояние, Знач Смотрящий) Экспорт

	Если Окна.Открыто(Состояние, "новый") Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат УчёткаОкна(Состояние, Смотрящий) <> Неопределено;

КонецФункции

#КонецОбласти

#Область Отбор

// GET-форма: отбор живёт в адресе, со скриптом уходит без перезагрузки по мере набора; на телефоне
// поля встают каждое во всю строку.
Функция ФормаОтбора(Знач Адрес, Знач Отбор)

	Возврат Кит.СтрокаПоиска(Адрес)
		.Поле(Кит.Поле("q", Тексты.Текст("settings.hub.users.filter.search"))
			.Значение(Отбор.Подстрока).Пример(Тексты.Текст("settings.hub.users.filter.search.example")))
		.Поле(Кит.Поле("role", Тексты.Текст("settings.hub.users.filter.role"))
			.Вариант("", Тексты.Текст("settings.hub.users.filter.role.any"))
			.Вариант(Роли.РольАдмин(), Тексты.Текст("settings.hub.users.role.admin"))
			.Вариант(Роли.РольПользователь(), Тексты.Текст("settings.hub.users.role.user"))
			.Значение(Отбор.Роль))
		.Поле(Кит.Поле("status", Тексты.Текст("settings.hub.users.filter.status"))
			.Вариант("", Тексты.Текст("settings.hub.users.filter.status.any"))
			.Вариант(Отборы.СтатусАктивен(), Тексты.Текст("settings.hub.users.status.active"))
			.Вариант(Отборы.СтатусЗаблокирован(), Тексты.Текст("settings.hub.users.status.blocked"))
			.Вариант(Отборы.СтатусНечемВойти(), Тексты.Текст("settings.hub.users.status.nologin"))
			.Значение(Отбор.Статус))
		.Кнопка(Тексты.Текст("settings.hub.users.filter.button"), "поиск").БезПерезагрузки();

КонецФункции

// Учётки по подстроке — у домена, роль и статус — по готовым строкам: признак «есть чем войти»
// домен отдаёт одним запросом на весь список.
Функция Отобранные(Знач Отбор)

	Результат = Новый Массив();
	Для Каждого Учётка Из Учётки.Отобранные(Отбор.Подстрока) Цикл
		Если ПодходитПодОтбор(Учётка, Отбор) Тогда
			Результат.Добавить(Учётка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПодходитПодОтбор(Знач Учётка, Знач Отбор)

	Если ЗначениеЗаполнено(Отбор.Роль) И Отбор.Роль <> РольОтбора(Учётка.Пользователь) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат НЕ ЗначениеЗаполнено(Отбор.Статус) ИЛИ Отбор.Статус = Статус(Учётка);

КонецФункции

Функция РольОтбора(Знач Пользователь)
	Возврат ?(Права.ПользовательАдмин(Пользователь), Роли.РольАдмин(), Роли.РольПользователь());
КонецФункции

// Нечем войти — главное: такую учётку и разблокировать нельзя, пока не выпущена ссылка.
Функция Статус(Знач Учётка)

	Если НЕ Учётка.ЕстьВход Тогда
		Возврат Отборы.СтатусНечемВойти();
	ИначеЕсли Учётка.Пользователь.Активен <> Истина Тогда
		Возврат Отборы.СтатусЗаблокирован();
	КонецЕсли;
	Возврат Отборы.СтатусАктивен();

КонецФункции

#КонецОбласти

#Область Таблица

// На узком экране — карточки с логином заглавием и ⚙ в углу.
// Пустое значение (учётка без адреса почты) — прочерком, а не пустой ячейкой.
Функция Таблица(Знач Записи, Знач Смотрящий, Знач АдресСписка, Знач Отбор)

	Таблица = Кит.Таблица(Строки(Записи, Смотрящий, АдресСписка, Отбор)).Вид("карточками").Пустое("—")
		.Пусто(ПустаяВыдача(Отбор));
	Таблица.Колонка("login", Тексты.Текст("settings.hub.users.col.login")).Заглавная();
	Таблица.Колонка("email", Тексты.Текст("settings.hub.users.col.email"));
	Таблица.Колонка("role", Тексты.Текст("settings.hub.users.col.role"));
	Таблица.Колонка("status", Тексты.Текст("settings.hub.users.col.status")).БезПодписиВЗаписи();
	Таблица.Колонка("actions", Тексты.Текст("settings.hub.users.col.actions")).БезПодписиВЗаписи();
	Возврат Таблица;

КонецФункции

Функция Строки(Знач Записи, Знач Смотрящий, Знач АдресСписка, Знач Отбор)

	Результат = Новый Массив();
	Для Каждого Учётка Из Записи Цикл
		Пользователь = Учётка.Пользователь;
		Результат.Добавить(Новый Структура("login, email, role, status, actions",
			Строка(Пользователь.Логин),
			Строка(Пользователь.Email),
			СловоРоли(Пользователь),
			Плашки(Учётка),
			Меню(Учётка, Смотрящий, АдресСписка, Отбор)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Роль хаба словами — той же, что в окне заведения, а не кодом.
Функция СловоРоли(Знач Пользователь)
	Если Права.ПользовательАдмин(Пользователь) Тогда
		Возврат Тексты.Текст("settings.hub.users.role.admin");
	КонецЕсли;
	Возврат Тексты.Текст("settings.hub.users.role.user");
КонецФункции

Функция Плашки(Знач Учётка)

	Статус = Статус(Учётка);
	Если Статус = Отборы.СтатусНечемВойти() Тогда
		Плашка = Кит.Плашка(Тексты.Текст("settings.hub.users.status.nologin")).Вид("warn");
	ИначеЕсли Статус = Отборы.СтатусЗаблокирован() Тогда
		Плашка = Кит.Плашка(Тексты.Текст("settings.hub.users.status.blocked")).Вид("err");
	Иначе
		Плашка = Кит.Плашка(Тексты.Текст("settings.hub.users.status.active")).Вид("ok");
	КонецЕсли;

	Если Учётка.Пользователь.ТребуетсяСменаПароля <> Истина Тогда
		Возврат Плашка;
	КонецЕсли;
	Возврат Кит.Холст(Плашка, Кит.Плашка(Тексты.Текст("settings.hub.users.status.password")));

КонецФункции

// Своя строка меню не получает: и блокировка, и смена роли, и удаление себя — само-локаут.
// Окна — по адресу списка с тем же отбором: сотню подтверждений заранее не печатают.
Функция Меню(Знач Учётка, Знач Смотрящий, Знач АдресСписка, Знач Отбор)

	Пользователь = Учётка.Пользователь;
	Если ЭтоСмотрящий(Пользователь, Смотрящий) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Логин = Строка(Пользователь.Логин);

	Возврат Кит.Меню(Тексты.Шаблон("settings.hub.users.menu", Логин),
		ФормаАктивности(Учётка, Отбор),
		Кит.ОкноПоАдресу(Окна.Адрес(АдресСписка, "роль", Логин), ПодписьРоли(Пользователь))
			.Иконка("аккаунт"),
		Кит.ОкноПоАдресу(Окна.Адрес(АдресСписка, "сброс", Логин),
			Тексты.Текст("settings.hub.users.action.reset")).Иконка("ключ"),
		Кит.ОкноПоАдресу(Окна.Адрес(АдресСписка, "удалить", Логин),
			Тексты.Текст("settings.hub.users.action.delete")).Опасная().Иконка("корзина"));

КонецФункции

// Блокировка обратима и спрашивать её незачем: форма из одной кнопки. Учётку без способа
// входа разблокировать нельзя — домен такую активацию не примет, кнопки нет.
Функция ФормаАктивности(Знач Учётка, Знач Отбор)

	Активна = (Учётка.Пользователь.Активен = Истина);
	Если НЕ Активна И НЕ Учётка.ЕстьВход Тогда
		Возврат Неопределено;
	КонецЕсли;

	Кнопка = ?(Активна,
		Кит.Кнопка(Тексты.Текст("settings.hub.users.action.block")).Иконка("замок"),
		Кит.Кнопка(Тексты.Текст("settings.hub.users.action.unblock")).Иконка("замок"));

	Возврат Кит.Форма(Хвост(Учётка.Пользователь.Логин, "toggle"),
			Кит.СкрытоеПоле(ОкноУчётки.ИмяПоляАктивности(), ?(Активна, "0", "1")),
			Отборы.Поля(Отбор),
			Кнопка)
		.Вид("меню").БезПерезагрузки();

КонецФункции

Функция ПодписьРоли(Знач Пользователь)
	Если Права.ПользовательАдмин(Пользователь) Тогда
		Возврат Тексты.Текст("settings.hub.users.action.revoke");
	КонецЕсли;
	Возврат Тексты.Текст("settings.hub.users.action.grant");
КонецФункции

Функция ПустаяВыдача(Знач Отбор)
	Если ЗначениеЗаполнено(Отбор.Подстрока) ИЛИ ЗначениеЗаполнено(Отбор.Роль)
		ИЛИ ЗначениеЗаполнено(Отбор.Статус) Тогда
		Возврат Тексты.Текст("settings.hub.users.empty.filter");
	КонецЕсли;
	Возврат Тексты.Текст("settings.hub.users.empty");
КонецФункции

#КонецОбласти

#Область Окна

// Окно записи, названное адресом. Учётки нет или это сам смотрящий — страница без окна.
Функция ОткрытоеОкно(Знач Смотрящий, Знач Состояние, Знач Отбор, Знач АдресСписка)

	Пользователь = УчёткаОкна(Состояние, Смотрящий);
	Если Пользователь = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Логин = Строка(Пользователь.Логин);

	Если Окна.Открыто(Состояние, "роль") Тогда
		Желаемая = ?(Права.ПользовательАдмин(Пользователь), Роли.РольПользователь(), Роли.РольАдмин());
		Возврат ОкноУчётки.Роль(Пользователь, Желаемая, Отбор, АдресСписка, Хвост(Логин, "role"));
	ИначеЕсли Окна.Открыто(Состояние, "сброс") Тогда
		Возврат ОкноУчётки.Сброс(Пользователь, Отбор, АдресСписка, Хвост(Логин, "reset"));
	ИначеЕсли Окна.Открыто(Состояние, "удалить") Тогда
		Возврат ОкноУчётки.Удаление(Пользователь, Состояние, Отбор, АдресСписка, Хвост(Логин, "delete"));
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ОкноВыпуска(Знач Параметры, Знач АдресСписка)

	Выпуск = Неопределено;
	Параметры.Свойство("Выпуск", Выпуск);
	Если Выпуск = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ОкноУчётки.Выпуск(Выпуск, АдресСписка);

КонецФункции

Функция УчёткаОкна(Знач Состояние, Знач Смотрящий)

	Если Состояние = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Состояние.Ключ)
		ИЛИ Окна.Открыто(Состояние, "новый") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пользователь = Роли.НайтиПоЛогину(Состояние.Ключ);
	Если Пользователь = Неопределено ИЛИ ЭтоСмотрящий(Пользователь, Смотрящий) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Пользователь;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭтоСмотрящий(Знач Пользователь, Знач Смотрящий)
	Возврат Смотрящий <> Неопределено
		И Цел(Пользователь.Идентификатор) = Цел(Смотрящий.Идентификатор);
КонецФункции

// Адрес формы записи относительно раздела: «<логин>/<действие>».
Функция Хвост(Знач Логин, Знач Действие)
	Возврат КодироватьСтроку(Строка(Логин), СпособКодированияСтроки.КодировкаURL) + "/" + Действие;
КонецФункции

#КонецОбласти

&Прозвище("ВитринаУчёток")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СписокУчёток") _Учётки,
	&Пластилин(Значение = "СервисПрав") _Права,
	&Пластилин(Значение = "СервисПользователей") _Роли,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ОкноУчётки") _ОкноУчётки,
	&Пластилин(Значение = "ОтборЛюдей") _Отборы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Учётки = _Учётки;
	Права = _Права;
	Роли = _Роли;
	Окна = _Окна;
	ОкноУчётки = _ОкноУчётки;
	Отборы = _Отборы;
	Тексты = _Тексты;

КонецПроцедуры
