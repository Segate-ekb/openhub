// Раздел «Провайдеры входа» дома «Хаб»: реестр провайдеров с тумблером и меню ⚙, окно нового
// провайдера на странице, окна правки, правила по странам и подтверждение удаления — по адресу.

Перем Кит;          // Кит (кит) — фабрика элементов экрана
Перем Сервис;       // СервисПровайдеровВхода (вход)
Перем Геоправило;   // ГеоправилоПровайдера (вход) — правило «закрыт в странах» и обстановка
Перем Атрибуция;    // АтрибуцияБазыСтран — условие лицензии базы стран
Перем СостояниеБазы; // СостояниеБазыСтран — закрывает ли правило всем, пока база пуста
Перем Окна;         // ОкноРаздела — окно по адресу и его состояние
Перем ОкноПровайдера; // ОкноПровайдера — окна «Новый провайдер», «Изменить», просмотр
Перем ОкноСтран;    // ОкноСтранПровайдера — окно «Страны и доступ»
Перем Поля;         // ФормаПровайдераВхода — имена полей
Перем ЗначкиПровайдеров; // ЗначокПровайдера — значок записи провайдера
Перем Тексты;       // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<имя>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат "новый,изменить,страны,удалить";
КонецФункции

// Секции раздела.
//
// Параметры:
//  Параметры - Структура:
//    * Адрес - Строка - адрес раздела;
//    * Окно - Структура, Неопределено - состояние открытого окна (см. ОкноРаздела.Отбитое);
//    * Посетитель - Структура, Неопределено - посетитель запроса (Адрес, Заголовки).
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - одна секция: реестр провайдеров и окна.
//
Функция Секции(Знач Параметры) Экспорт

	Карточки = Сервис.Инсталляции();
	Состояние = ПолеСтруктуры(Параметры, "Окно");
	ОкноЗаведения = ОкноПровайдера.Заведение(Состояние, Параметры.Адрес);

	Секция = Кит.Секция(Тексты.Текст("providers.section.title"),
			Реестр(Карточки, Параметры.Адрес),
			Атрибуция.Примечание().Когда(Карточки.Количество() > 0),
			ОкноЗаведения,
			ОткрытоеОкно(Карточки, Состояние, ПолеСтруктуры(Параметры, "Посетитель"), Параметры.Адрес))
		.Лид(Тексты.Текст("providers.section.lead")).Иконка("замок")
		.Действия(Кит.Кнопка(Тексты.Текст("providers.section.add")).Основная().Иконка("плюс")
			.Открывает(ОкноЗаведения));

	Результат = Новый Массив();
	Результат.Добавить(Секция);
	Возврат Результат;

КонецФункции

// Напечатает ли раздел окно, которое называет состояние, с отказом формы в нём: окно заведения —
// всегда; окно записи — когда запись есть, а правка и удаление — только у той, что правится.
//
// Параметры:
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Состояние) Экспорт

	Если Окна.Открыто(Состояние, "новый") Тогда
		Возврат Истина;
	КонецЕсли;
	Карточка = КарточкаОкна(Сервис.Инсталляции(), Состояние);
	Если Карточка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Окна.Открыто(Состояние, "страны") ИЛИ Карточка.Редактируемая;

КонецФункции

#КонецОбласти

#Область Реестр

Функция Реестр(Знач Карточки, Знач АдресРаздела)

	Реестр = Кит.Реестр().Подпись(Тексты.Текст("providers.section.title"))
		.Пусто(Тексты.Текст("providers.list.empty"));
	Для Каждого Карточка Из Карточки Цикл
		Реестр.Добавить(Запись(Карточка, АдресРаздела));
	КонецЦикла;
	Возврат Реестр;

КонецФункции

// Свёрнутая запись — что это и в каком оно состоянии; раскрытая — подробности. Все действия
// одним набором: меню ⚙ у свёрнутой и кнопки внизу раскрытой.
Функция Запись(Знач Карточка, Знач АдресРаздела)

	Правило = Геоправило.Правило(Карточка.Имя);

	Запись = Кит.ЗаписьРеестра(Карточка.Имя, Подробности(Карточка, Правило))
		.Значок(ЗначкиПровайдеров.Имя(Карточка))
		.Плашка(ОкноПровайдера.Вид(Карточка))
		.Плашка(ПлашкаСостояния(Карточка))
		.Подпись(Тексты.Шаблон("providers.entry.button", Карточка.Метка))
		.Действия(Тумблер(Карточка))
		.Кнопки(
			КнопкаПравки(Карточка, АдресРаздела),
			Кит.ОкноПоАдресу(Окна.Адрес(АдресРаздела, "страны", Карточка.Имя),
				Тексты.Текст("providers.geo.link")).Иконка("замок"),
			КнопкаУдаления(Карточка, АдресРаздела));

	Если НЕ Карточка.Редактируемая Тогда
		Запись.Плашка(Кит.Плашка(Тексты.Текст("providers.badge.config")).Вид("warn"));
	КонецЕсли;
	Если Правило.Есть Тогда
		Запись.Плашка(ПлашкаПравила(Правило));
	КонецЕсли;

	Возврат Запись;

КонецФункции

// Пока база стран пуста, правило закрывает провайдера всем, сколько бы стран в нём ни было.
Функция ПлашкаПравила(Знач Правило)

	Если СостояниеБазы.ЗакрываетВсех() Тогда
		Возврат Кит.Плашка(Тексты.Текст("providers.badge.closed.all")).Вид("err");
	КонецЕсли;
	Возврат Кит.Плашка(ЗакрытВСтранах(Правило.Страны.Количество())).Вид("warn");

КонецФункции

Функция ПлашкаСостояния(Знач Карточка)

	Если Карточка.Включён Тогда
		Возврат Кит.Плашка(Тексты.Текст("providers.state.on")).Вид("ok");
	КонецЕсли;
	Возврат Кит.Плашка(Тексты.Текст("providers.state.off"));

КонецФункции

// Тумблер сохраняется сразу; провайдер из конфигурации показан, но не переключается.
Функция Тумблер(Знач Карточка)

	Подпись = Тексты.Шаблон("providers.toggle.label", Карточка.Имя);
	Если НЕ Карточка.Редактируемая Тогда
		Возврат Кит.Тумблер("", Подпись).Включено(Карточка.Включён).Заблокировано();
	КонецЕсли;

	Возврат Кит.Форма(Хвост(Карточка, "toggle"),
			Кит.Тумблер(Поля.ИмяПоляВключён(), Подпись).Включено(Карточка.Включён)
				.Значения(Поля.ЗначениеОтмечено(), "0").СохранятьСразу())
		.БезПерезагрузки();

КонецФункции

// Провайдер из конфигурации открывается тем же окном, но только на чтение.
Функция КнопкаПравки(Знач Карточка, Знач АдресРаздела)

	Подпись = ?(Карточка.Редактируемая, Тексты.Текст("providers.button.edit"),
		Тексты.Текст("providers.button.view"));
	Возврат Кит.ОкноПоАдресу(Окна.Адрес(АдресРаздела, "изменить", Карточка.Имя), Подпись)
		.Основная().Иконка("карандаш");

КонецФункции

// Подтверждение удаления считает учётки, которые останутся без входа, — это обход всех учёток,
// поэтому оно приходит по адресу, когда его открыли, а не печатается на каждую запись.
Функция КнопкаУдаления(Знач Карточка, Знач АдресРаздела)

	Если НЕ Карточка.Редактируемая Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.ОкноПоАдресу(Окна.Адрес(АдресРаздела, "удалить", Карточка.Имя),
		Тексты.Текст("providers.button.delete")).Опасная().Иконка("корзина");

КонецФункции

#КонецОбласти

#Область Подробности

Функция Подробности(Знач Карточка, Знач Правило)

	Возврат Кит.Свойства(
		Кит.Свойство(Тексты.Текст("providers.prop.client"), Кит.Код(Карточка.ИдентификаторКлиента))
			.Копируемое(),
		СвойствоАдресаВозврата(Карточка),
		Кит.Свойство(Тексты.Текст("providers.prop.scope"), Кит.Код(Карточка.Область))
			.Когда(ЗначениеЗаполнено(Карточка.Область)),
		Кит.Свойство(Тексты.Текст("providers.prop.accounts"), ОкноПровайдера.Политика(Карточка)),
		СвойствоСтран(Правило));

КонецФункции

Функция СвойствоАдресаВозврата(Знач Карточка)

	Подпись = Тексты.Текст("providers.prop.redirect");
	Если НЕ ЗначениеЗаполнено(Карточка.АдресВозврата) Тогда
		Возврат Кит.Свойство(Подпись, Тексты.Текст("providers.redirect.unset.short"));
	КонецЕсли;
	Возврат Кит.Свойство(Подпись, Кит.Код(Карточка.АдресВозврата)).Копируемое();

КонецФункции

Функция СвойствоСтран(Знач Правило)

	Подпись = Тексты.Текст("providers.prop.countries");
	Если НЕ Правило.Есть Тогда
		Возврат Кит.Свойство(Подпись, Тексты.Текст("providers.geo.open"));
	КонецЕсли;

	Свойство = Кит.Свойство(Подпись,
		Кит.Плашка(Тексты.Шаблон("providers.geo.closed", СтрСоединить(Правило.Страны, ", "))).Вид("warn"));
	Если СостояниеБазы.ЗакрываетВсех() Тогда
		Свойство.Примечание(Тексты.Текст("providers.geo.closes.all"));
	КонецЕсли;
	Возврат Свойство;

КонецФункции

// «закрыт в 1 стране», «закрыт в 2 странах», «закрыт в 21 стране».
Функция ЗакрытВСтранах(Знач Число_)

	Число_Строкой = Формат(Число_, "ЧГ=");
	Если Число_ % 10 = 1 И Число_ % 100 <> 11 Тогда
		Возврат Тексты.Шаблон("providers.badge.closed.one", Число_Строкой);
	КонецЕсли;
	Возврат Тексты.Шаблон("providers.badge.closed.many", Число_Строкой);

КонецФункции

#КонецОбласти

#Область ОкнаПоАдресу

// Окно записи, названное адресом. Записи с таким именем нет — страница без окна.
Функция ОткрытоеОкно(Знач Карточки, Знач Состояние, Знач Посетитель, Знач АдресРаздела)

	Карточка = КарточкаОкна(Карточки, Состояние);
	Если Карточка = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Окна.Открыто(Состояние, "изменить") Тогда
		Возврат ?(Карточка.Редактируемая,
			ОкноПровайдера.Правка(Карточка, Состояние, Хвост(Карточка, "save"), АдресРаздела),
			ОкноПровайдера.Просмотр(Карточка, АдресРаздела));
	ИначеЕсли Окна.Открыто(Состояние, "страны") Тогда
		Возврат ОкноСтран.Окно(Карточка.Имя, Геоправило.Правило(Карточка.Имя).Страны, Состояние,
			Посетитель, Хвост(Карточка, "countries"), АдресРаздела);
	ИначеЕсли Окна.Открыто(Состояние, "удалить") И Карточка.Редактируемая Тогда
		Возврат ОкноУдаления(Карточка, Состояние, АдресРаздела);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция КарточкаОкна(Знач Карточки, Знач Состояние)

	Если Состояние = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Состояние.Ключ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Карточка Из Карточки Цикл
		Если НРег(Карточка.Имя) = НРег(Состояние.Ключ) Тогда
			Возврат Карточка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Удаление спрашивает имя провайдера и называет, скольким учёткам нечем станет войти.
Функция ОкноУдаления(Знач Карточка, Знач Состояние, Знач АдресРаздела)

	Возврат Кит.Подтверждение(Тексты.Шаблон("providers.delete.title", Карточка.Имя),
			Последствия(Карточка))
		.Эхо(Поля.ИмяПоляЭха(), Карточка.Имя, Тексты.Текст("providers.delete.echo"))
		.Кнопка(Тексты.Текст("providers.button.delete"))
		.Ошибка(Окна.Отказ(Состояние, Поля.ИмяПоляЭха()))
		.Форма(Хвост(Карточка, "delete")).БезПерезагрузки().Якорь("provaider-udalit").Открыто()
		.АдресЗакрытия(АдресРаздела);

КонецФункции

Функция Последствия(Знач Карточка)

	Учёток = Геоправило.Обстановка(Карточка.Имя).Учёток;
	Если Учёток = 0 Тогда
		Возврат Тексты.Шаблон("providers.delete.consequence.none", Карточка.Метка);
	КонецЕсли;
	Возврат Тексты.Шаблон("providers.delete.consequence.some", Карточка.Метка, Формат(Учёток, "ЧГ="));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Адрес формы записи относительно раздела: «<имя>/<действие>».
Функция Хвост(Знач Карточка, Знач Действие)
	Возврат КодироватьСтроку(Строка(Карточка.Имя), СпособКодированияСтроки.КодировкаURL) + "/" + Действие;
КонецФункции

Функция ПолеСтруктуры(Знач Параметры, Знач Имя)

	Значение = Неопределено;
	Параметры.Свойство(Имя, Значение);
	Возврат Значение;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаПровайдеровВхода")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисПровайдеровВхода") _Сервис,
	&Пластилин(Значение = "ГеоправилоПровайдера") _Геоправило,
	&Пластилин(Значение = "АтрибуцияБазыСтран") _Атрибуция,
	&Пластилин(Значение = "СостояниеБазыСтран") _СостояниеБазы,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ОкноПровайдера") _ОкноПровайдера,
	&Пластилин(Значение = "ОкноСтранПровайдера") _ОкноСтран,
	&Пластилин(Значение = "ФормаПровайдераВхода") _Поля,
	&Пластилин(Значение = "ЗначокПровайдера") _ЗначкиПровайдеров,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Сервис = _Сервис;
	Геоправило = _Геоправило;
	Атрибуция = _Атрибуция;
	СостояниеБазы = _СостояниеБазы;
	Окна = _Окна;
	ОкноПровайдера = _ОкноПровайдера;
	ОкноСтран = _ОкноСтран;
	Поля = _Поля;
	ЗначкиПровайдеров = _ЗначкиПровайдеров;
	Тексты = _Тексты;

КонецПроцедуры
