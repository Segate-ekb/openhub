// Окно «Страны и доступ» провайдера входа: коды закрытых стран списком и справка — база стран
// и страна запроса самого администратора.

Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем Окна;          // ОкноРаздела — набранное и отказы окна
Перем Поля;          // ФормаПровайдераВхода — имена и образцы полей
Перем СостояниеБазы; // СостояниеБазыСтран — чем хаб различает страны
Перем Тексты;        // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Окно правила провайдера, напечатанное открытым.
//
// Параметры:
//  Имя - Строка - имя провайдера.
//  Страны - Массив из Строка - действующее правило: закрытые страны.
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//  Посетитель - Структура, Неопределено - посетитель запроса (Адрес, Заголовки).
//  Хвост - Строка - адрес формы относительно раздела: «<имя>/countries».
//  АдресРаздела - Строка - раздел без окна: туда окно закрывается.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел окна.
//
Функция Окно(Знач Имя, Знач Страны, Знач Состояние, Знач Посетитель, Знач Хвост, Знач АдресРаздела) Экспорт

	Возврат Кит.Окно(Тексты.Шаблон("providers.geo.title", Имя),
			СостояниеБазы.ПредупреждениеПроВсех(),
			ПолеСтран(Состояние, Страны),
			Кит.Свойства(
				СостояниеБазы.СвойствоБазы(),
				СостояниеБазы.СвойствоСтраныЗапроса(Посетитель, Страны)))
		.Форма(Хвост).БезПерезагрузки().Якорь(Якорь()).Открыто().АдресЗакрытия(АдресРаздела)
		.Действия(Кит.Кнопка(Тексты.Текст("providers.button.save")).Основная().Иконка("сохранить"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пустой список снимает правило: провайдер открыт всем.
Функция ПолеСтран(Знач Состояние, Знач Страны)

	Имя = Поля.ИмяПоляСтран();
	Возврат Кит.Поле(Имя, Тексты.Текст("providers.geo.field")).Список()
		.Значение(Окна.Значение(Состояние, Имя, СтрСоединить(Страны, ", ")))
		.Шаблон(Поля.ОбразецСтран())
		.Пример(Тексты.Текст("providers.geo.field.example"))
		.Подсказка(Тексты.Текст("providers.geo.field.hint"))
		.Ошибка(Окна.Отказ(Состояние, Имя));

КонецФункции

Функция Якорь()
	Возврат "provaider-strany";
КонецФункции

#КонецОбласти

&Прозвище("ОкноСтранПровайдера")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ФормаПровайдераВхода") _Поля,
	&Пластилин(Значение = "СостояниеБазыСтран") _СостояниеБазы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Окна = _Окна;
	Поля = _Поля;
	СостояниеБазы = _СостояниеБазы;
	Тексты = _Тексты;

КонецПроцедуры
