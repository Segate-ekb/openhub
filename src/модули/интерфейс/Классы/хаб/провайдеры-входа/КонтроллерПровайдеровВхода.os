// Маршруты раздела «Провайдеры входа» дома «Хаб»: страница с окном по адресу, заведение, правка,
// включение, удаление провайдера и его правило по странам. Удача — 303 на раздел, отказ — та же
// страница с окном, открытым на набранном и отказах.

Перем ГвардХаб;   // ГвардХабАдмина
Перем Ответы;     // ОтветыНастроек
Перем Дом;        // ДомХаба
Перем Витрина;    // ВитринаПровайдеровВхода
Перем Пульт;      // ПультПровайдеровВхода
Перем Защита;     // ЗащитаCSRF (вход)
Перем Окна;       // ОкноРаздела — окно по адресу и ответы форм окон
Перем Посетители; // ПосетительЗапроса — адрес и заголовки одним значением

#Область ТочкиМаршрута

// Точка маршрута «providers»: GET — страница раздела, POST — заведение провайдера.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента: окно правила показывает администратору,
//                        какой страной хаб видит его собственный запрос.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: <вид>-<имя> (необязательный, по умолчанию "").
//
&ТочкаМаршрута("providers")
Процедура Раздел(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	АдресУдаленногоУзла, saved = "", окно = "") Экспорт

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Структура("Вердикт, Куки, Посетитель", Вердикт, КукиЗапроса,
		Посетители.Собрать(АдресУдаленногоУзла, ЗаголовкиЗапроса));

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Запрос, 200, Окна.ИзАдреса(окно, Витрина.ВидыОкон()),
			ЗначениеЗаполнено(saved));
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Запрос, Пульт.Создать(Вердикт.Принципал, Форма), "новый", "", Форма);

КонецПроцедуры

// Точка маршрута «providers/{имя}/save» — форма окна «Изменить».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  имя - Строка - имя провайдера.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента (страна запроса администратора в окне).
//
&ТочкаМаршрута("providers/{имя}/save")
Процедура Сохранение(Ответ, имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	АдресУдаленногоУзла) Экспорт

	Мутация = Мутация(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, АдресУдаленногоУзла);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Запрос, Пульт.Сохранить(Мутация.Принципал, имя, Мутация.Форма),
		"изменить", имя, Мутация.Форма);

КонецПроцедуры

// Точка маршрута «providers/{имя}/toggle» — тумблер записи.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  имя - Строка - имя провайдера.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента (страна запроса администратора в окне).
//
&ТочкаМаршрута("providers/{имя}/toggle")
Процедура Переключение(Ответ, имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	АдресУдаленногоУзла) Экспорт

	Мутация = Мутация(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, АдресУдаленногоУзла);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Запрос, Пульт.Переключить(Мутация.Принципал, имя, Мутация.Форма),
		"", имя, Мутация.Форма);

КонецПроцедуры

// Точка маршрута «providers/{имя}/delete». Без поля подтверждения (форма ушла без скрипта)
// провайдер не удаляется: ответ ведёт на страницу с открытым подтверждением.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  имя - Строка - имя провайдера.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента (страна запроса администратора в окне).
//
&ТочкаМаршрута("providers/{имя}/delete")
Процедура Удаление(Ответ, имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	АдресУдаленногоУзла) Экспорт

	Мутация = Мутация(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, АдресУдаленногоУзла);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Окна.Подтверждено(Мутация.Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресРаздела(), имя);
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Запрос, Пульт.Удалить(Мутация.Принципал, имя, Мутация.Форма),
		"удалить", имя, Мутация.Форма);

КонецПроцедуры

// Точка маршрута «providers/{имя}/countries» — форма окна «Страны и доступ».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  имя - Строка - имя провайдера.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента (страна запроса администратора в окне).
//
&ТочкаМаршрута("providers/{имя}/countries")
Процедура ЗакрытыеСтраны(Ответ, имя, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	АдресУдаленногоУзла) Экспорт

	Мутация = Мутация(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, АдресУдаленногоУзла);
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Запрос, Пульт.ЗакрытьПоСтранам(Мутация.Принципал, имя, Мутация.Форма),
		"страны", имя, Мутация.Форма);

КонецПроцедуры

#КонецОбласти

#Область Действия

// Общий пролог мутирующих точек: гвард → только POST → форма с CSRF.
Функция Мутация(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса,
	Знач ТелоЗапроса, Знач АдресУдаленногоУзла)

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "POST", Вердикт, КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Структура("Вердикт, Куки, Посетитель", Вердикт, КукиЗапроса,
		Посетители.Собрать(АдресУдаленногоУзла, ЗаголовкиЗапроса));
	Возврат Новый Структура("Запрос, Принципал, Форма", Запрос, Вердикт.Принципал, Форма);

КонецФункции

// Исход пульта → ответ: удача — 303 на раздел; отказ — страница с окном этой формы, открытым
// на набранном и отказах. Окна нет (тумблер; запись удалена или её не правят) — отказ тостом
// над разделом: причина названа в любом случае.
Процедура Завершить(Ответ, Знач Запрос, Знач Исход, Знач ВидОкна, Знач Имя, Знач Форма)

	Если Исход.Успех Тогда
		Окна.ВернутьВРаздел(Ответ, АдресРаздела());
		Возврат;
	КонецЕсли;

	// отказ у поля в окне уже назван — второй раз над шагами его не повторяют
	Окно = Окна.Отбитое(ВидОкна, Имя, Форма, Исход.Отказы,
		?(Исход.Отказы.Количество() > 0, "", Исход.Сообщение));
	Если ЗначениеЗаполнено(ВидОкна) И Витрина.ЕстьОкно(Окно) Тогда
		ОтдатьРаздел(Ответ, Запрос, Исход.Код, Окно, Ложь);
		Возврат;
	КонецЕсли;
	ОтдатьРаздел(Ответ, Запрос, Исход.Код, Неопределено, Ложь, Исход.Сообщение);

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Запрос, Знач Статус, Знач Окно, Знач Сохранено, Знач Ошибка = "")

	Параметры = Новый Структура("Адрес, Окно, Посетитель", АдресРаздела(), Окно, Запрос.Посетитель);

	Модель = Ответы.МодельДома(Дом, "",
		Дом.Разделы("providers"),
		Ответы.УведомленияРаздела(Сохранено, Ошибка),
		Витрина.Секции(Параметры),
		Защита.ТокенСессии(Запрос.Вердикт.Сессия));

	Ответы.ОтдатьДом(Ответ, Модель, Запрос.Вердикт, Запрос.Куки, Статус);

КонецПроцедуры

Функция АдресРаздела()
	Возврат Дом.АдресРаздела("providers");
КонецФункции

#КонецОбласти

&Контроллер("/hub/settings")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардХабАдмина") _ГвардХаб,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ВитринаПровайдеровВхода") _Витрина,
	&Пластилин(Значение = "ПультПровайдеровВхода") _Пульт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ПосетительЗапроса") _Посетители)

	ГвардХаб = _ГвардХаб;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	Пульт = _Пульт;
	Защита = _Защита;
	Окна = _Окна;
	Посетители = _Посетители;

КонецПроцедуры
