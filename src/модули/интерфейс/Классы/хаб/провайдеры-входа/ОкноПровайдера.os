// Окна провайдера входа: «Новый провайдер» двумя шагами, «Изменить» — те же шаги вкладками,
// провайдер из конфигурации — окно только для чтения. Поля, которые нужны одному пресету, стоят
// в наборе его сегмента: на экране — только поля выбранного. Набранное и отказы отбитой формы
// окно берёт у состояния окна раздела.

Перем Кит;        // Кит (кит) — фабрика элементов экрана
Перем Окна;       // ОкноРаздела — набранное и отказы окна
Перем Пресеты;    // ПресетыВхода (вход)
Перем Поля;       // ФормаПровайдераВхода — имена и образцы полей
Перем АдресХаба;  // АдресИнстанса (настройки) — redirect_uri по умолчанию
Перем Тексты;     // ТекстыИнтерфейса (кит)
Перем Сервис;     // СервисПровайдеровВхода (вход) — маска секрета
Перем Значки;     // ЗначокПровайдера — глиф провайдера, бренд которого не угадан

#Область ПубличныйИнтерфейс

// Окно «Новый провайдер»: печатается на странице всегда, открытым — по адресу или с отбитой формой.
//
// Параметры:
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//  АдресРаздела - Строка - раздел без окна: туда окно закрывается.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел окна.
//
Функция Заведение(Знач Состояние, Знач АдресРаздела) Экспорт

	Возврат Кит.Окно(Тексты.Текст("providers.window.new"),
			ОшибкаОкна(Состояние),
			Кит.Шаги(
				Кит.Шаг(Тексты.Текст("providers.step.provider"),
					ВыборПресета(Состояние),
					ПолеИмени(Состояние),
					ПолеКлиента(Состояние, ""),
					ПолеСекрета(Ложь),
					ГотовыйАдресВозврата(),
					СвойАдресВозврата(Состояние, "")),
				Кит.Шаг(Тексты.Текст("providers.step.accounts"),
					УчёткиИГруппы(Состояние, Неопределено)))
				.Кнопка(Тексты.Текст("providers.button.create")))
		.Форма("").БезПерезагрузки().Якорь("provaider-novyi")
		.Открыто(Окна.Открыто(Состояние, "новый")).АдресЗакрытия(АдресРаздела);

КонецФункции

// Окно «Изменить» провайдера базы: те же шаги вкладками; пресет и протокол не меняются.
//
// Параметры:
//  Карточка - Структура - карточка провайдера (СервисПровайдеровВхода.Инсталляции).
//  Состояние - Структура, Неопределено - состояние окна раздела.
//  Хвост - Строка - адрес формы относительно раздела: «<имя>/save».
//  АдресРаздела - Строка - раздел без окна: туда окно закрывается.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел окна, напечатанный открытым.
//
Функция Правка(Знач Карточка, Знач Состояние, Знач Хвост, Знач АдресРаздела) Экспорт

	Возврат Кит.Окно(Тексты.Шаблон("providers.window.edit", Карточка.Имя),
			ОшибкаОкна(Состояние),
			Кит.Шаги(
				Кит.Шаг(Тексты.Текст("providers.step.provider"),
					Подключение(Карточка),
					ПолеКлиента(Состояние, Карточка.ИдентификаторКлиента),
					ПолеСекрета(Карточка.СекретЗадан),
					ПолеОбластей(Состояние, Карточка),
					Дополнительно(Состояние, Карточка),
					СвойАдресВозврата(Состояние, Карточка.АдресВозврата)),
				Кит.Шаг(Тексты.Текст("providers.step.accounts"),
					УчёткиИГруппы(Состояние, Карточка)))
				.Вид("вкладки").Кнопка(Тексты.Текст("providers.button.save")))
		.Форма(Хвост).БезПерезагрузки().Якорь("provaider-pravka").Открыто().АдресЗакрытия(АдресРаздела);

КонецФункции

// Окно провайдера из конфигурации: всё на виду, править нечего — правит конфигурация.
//
// Параметры:
//  Карточка - Структура - карточка провайдера.
//  АдресРаздела - Строка - раздел без окна: туда окно закрывается.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел окна, напечатанный открытым.
//
Функция Просмотр(Знач Карточка, Знач АдресРаздела) Экспорт

	Возврат Кит.Окно(Тексты.Шаблон("providers.window.view", Карточка.Имя),
			Кит.Свойства(
				Кит.Свойство(Тексты.Текст("providers.prop.kind"), Вид(Карточка)),
				Кит.Свойство(Тексты.Текст("providers.prop.client"),
					Кит.Код(Карточка.ИдентификаторКлиента)).Копируемое(),
				Кит.Свойство(Тексты.Текст("providers.prop.redirect"),
					Кит.Код(Карточка.АдресВозврата)).Копируемое().Когда(ЗначениеЗаполнено(Карточка.АдресВозврата)),
				Кит.Свойство(Тексты.Текст("providers.prop.issuer"), Кит.Код(Карточка.Издатель))
					.Когда(ЗначениеЗаполнено(Карточка.Издатель)),
				Кит.Свойство(Тексты.Текст("providers.prop.scope"), Кит.Код(Карточка.Область))
					.Когда(ЗначениеЗаполнено(Карточка.Область)),
				Кит.Свойство(Тексты.Текст("providers.prop.accounts"), Политика(Карточка))))
		.Лид(Тексты.Текст("providers.locked.lead"))
		.Якорь("provaider-prosmotr").Открыто().АдресЗакрытия(АдресРаздела);

КонецФункции

// Вид провайдера одной строкой: «GitHub · OAuth2», «свой · OIDC».
//
// Параметры:
//  Карточка - Структура - карточка провайдера.
//
// Возвращаемое значение:
//  Строка.
//
Функция Вид(Знач Карточка) Экспорт

	Пресет = ?(ЗначениеЗаполнено(Карточка.Пресет), Пресеты.Подпись(Карточка.Пресет),
		Тексты.Текст("providers.preset.own"));
	Протокол = ?(НРег(Карточка.ВидПротокола) = "oauth2", Тексты.Текст("providers.badge.oauth2"),
		Тексты.Текст("providers.badge.oidc"));
	Возврат Тексты.Шаблон("providers.badge.kind", Пресет, Протокол);

КонецФункции

// Политика учёток и групп одной строкой: «создавать при первом входе · группы из клейма groups».
//
// Параметры:
//  Карточка - Структура - карточка провайдера.
//
// Возвращаемое значение:
//  Строка.
//
Функция Политика(Знач Карточка) Экспорт

	Части = Новый Массив();
	Части.Добавить(?(Карточка.АвтоСоздание, Тексты.Текст("providers.policy.autoprovision"),
		Тексты.Текст("providers.policy.linked")));
	Если Карточка.ПровижинингГрупп Тогда
		Части.Добавить(Тексты.Шаблон("providers.policy.groups", Клейм(Карточка)));
	КонецЕсли;
	Если Карточка.СвязкаГруппПоИмени Тогда
		Части.Добавить(Тексты.Шаблон("providers.policy.link", Клейм(Карточка)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Карточка.ПрефиксГрупп) Тогда
		Части.Добавить(Тексты.Шаблон("providers.policy.prefix", Карточка.ПрефиксГрупп));
	КонецЕсли;
	Возврат СтрСоединить(Части, " · ");

КонецФункции

Функция Клейм(Знач Карточка)
	Возврат ?(ЗначениеЗаполнено(Карточка.ИмяКлеймаГрупп), Карточка.ИмяКлеймаГрупп, "groups");
КонецФункции

#КонецОбласти

#Область ШагПровайдер

// Набор сегмента — поля, которые нужны только этому пресету: адрес своей инсталляции GitLab,
// области (их не задают у GitHub), протокол, точки, подпись и значок своего провайдера.
Функция ВыборПресета(Знач Состояние)

	Выбор = Кит.Сегменты(Поля.ИмяПоляПресета())
		.Подпись(Тексты.Текст("providers.field.preset"))
		.Выбрано(Окна.Значение(Состояние, Поля.ИмяПоляПресета(), "github"));
	Для Каждого Ключ Из Пресеты.Ключи() Цикл
		Выбор.Добавить(Кит.Сегмент(Ключ, Пресеты.Подпись(Ключ),
			ПолеБазовогоАдреса(Состояние).Когда(Пресеты.ПолеРазрешено(Ключ, "БазовыйАдрес")),
			ПолеОбластейПресета(Состояние, Ключ, Ключ).Когда(Пресеты.ПолеРазрешено(Ключ, "Область"))));
	КонецЦикла;
	Свой = Поля.ЗначениеСвоегоПресета();
	Выбор.Добавить(Кит.Сегмент(Свой, Тексты.Текст("providers.segment.own"),
		ВыборПротокола(Состояние),
		ПолеОбластейПресета(Состояние, Свой, Пресеты.БезПресета()),
		Дополнительно(Состояние, Неопределено)));
	Возврат Выбор;

КонецФункции

// Протокол и точки задаёт администратор только «своему» провайдеру; поля пресетного
// провайдера пусты, и сервер их не ждёт.
Функция ВыборПротокола(Знач Состояние)

	Возврат Кит.Сегменты(Поля.ИмяПоляПротокола(),
			Кит.Сегмент("oidc", Тексты.Текст("providers.segment.oidc"),
				ПолеАдреса(Состояние, Поля.ИмяПоляИздателя(), Тексты.Текст("providers.field.issuer"))
					.Справка(Тексты.Текст("providers.field.issuer.help"))),
			Кит.Сегмент("oauth2", Тексты.Текст("providers.segment.oauth2"),
				ПолеАдреса(Состояние, Поля.ИмяПоляАвторизации(), Тексты.Текст("providers.field.authorize")),
				ПолеАдреса(Состояние, Поля.ИмяПоляТокена(), Тексты.Текст("providers.field.token")),
				ПолеАдреса(Состояние, Поля.ИмяПоляПрофиля(), Тексты.Текст("providers.field.profile")),
				ПолеАдреса(Состояние, Поля.ИмяПоляПисем(), Тексты.Текст("providers.field.emails"))))
		.Подпись(Тексты.Текст("providers.field.protocol"))
		.Выбрано(Окна.Значение(Состояние, Поля.ИмяПоляПротокола(), "oidc"));

КонецФункции

Функция ПолеБазовогоАдреса(Знач Состояние)
	Возврат ПолеАдреса(Состояние, Поля.ИмяПоляБазовогоАдреса(), Тексты.Текст("providers.field.base"))
		.Подсказка(Тексты.Текст("providers.field.base.hint"));
КонецФункции

// Области в наборе пресета — своим именем, с умолчанием пресета: пульт берёт поле пришедшего.
Функция ПолеОбластейПресета(Знач Состояние, Знач Сегмент, Знач Пресет)

	Имя = Поля.ИмяПоляОбластиПресета(Сегмент);
	Возврат Кит.Поле(Имя, Тексты.Текст("providers.field.scope"))
		.Значение(Окна.Значение(Состояние, Имя, Пресеты.УмолчаниеПоля(Пресет, "Область")))
		.Справка(Тексты.Текст("providers.field.scope.help"));

КонецФункции

Функция ПолеИмени(Знач Состояние)

	Возврат Кит.Поле(Поля.ИмяПоляИмени(), Тексты.Текст("providers.field.name"))
		.Значение(Окна.Значение(Состояние, Поля.ИмяПоляИмени()))
		.Обязательное().Длина(2, 32).Шаблон(Поля.ОбразецИмени())
		.Подсказка(Тексты.Текст("providers.field.name.hint"))
		.Ошибка(Окна.Отказ(Состояние, Поля.ИмяПоляИмени()));

КонецФункции

Функция ПолеКлиента(Знач Состояние, Знач Действующее)

	Возврат Кит.Поле(Поля.ИмяПоляКлиента(), Тексты.Текст("providers.prop.client"))
		.Значение(Окна.Значение(Состояние, Поля.ИмяПоляКлиента(), Действующее))
		.Обязательное().ПроверкаДоОтправки()
		.Справка(Тексты.Текст("providers.field.client.help"))
		.Ошибка(Окна.Отказ(Состояние, Поля.ИмяПоляКлиента()));

КонецФункции

// Сохранённый секрет хаб не показывает: у правки пустое поле значит «оставить прежний».
Функция ПолеСекрета(Знач СекретЗадан)

	Поле = Кит.Поле(Поля.ИмяПоляСекрета(), Тексты.Текст("providers.field.secret"))
		.Секрет().Справка(Тексты.Текст("providers.field.secret.help"));
	Если СекретЗадан Тогда
		Поле.Пример(Сервис.МаскаСекрета()).Подсказка(Тексты.Текст("providers.field.secret.keep"));
	КонецЕсли;
	Возврат Поле;

КонецФункции

// Готовый redirect_uri для копирования; не определён — строка о том, почему его нет.
Функция ГотовыйАдресВозврата()

	Адрес = АдресХаба.АдресВозврата();
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат Кит.Примечание(Тексты.Текст("providers.redirect.unset"));
	КонецЕсли;
	Возврат Кит.БлокКоманды(Адрес).Пояснение(Тексты.Текст("providers.redirect.note"));

КонецФункции

// Подпись кнопки и значок задают редко и только своему провайдеру: под раскрывашкой-врезкой —
// у неё свой треугольник раскрытия, по нему видно, что строка раскрывается. Тело врезки ритма
// полям не даёт — два поля стоят столбиком.
Функция Дополнительно(Знач Состояние, Знач Карточка)

	Возврат Кит.Раскрывашка(
			Кит.Область(
				ПолеМетки(Состояние, Карточка),
				ПолеЗначка(Состояние, Карточка)).Вид("столбик"))
		.Шапка(Тексты.Текст("providers.window.more")).Вид("врезка")
		.Когда(ПолеРазрешено(Карточка, "Метка") ИЛИ ПолеРазрешено(Карточка, "Значок"));

КонецФункции

Функция ПолеМетки(Знач Состояние, Знач Карточка)

	Если НЕ ПолеРазрешено(Карточка, "Метка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Поле(Поля.ИмяПоляМетки(), Тексты.Текст("providers.field.label"))
		.Значение(Окна.Значение(Состояние, Поля.ИмяПоляМетки(), ПолеСтруктуры(Карточка, "Метка")))
		.Подсказка(?(Карточка = Неопределено, Тексты.Текст("providers.field.label.own"),
			Тексты.Текст("providers.field.label.hint")));

КонецФункции

// Значок — логотип бренда из коллекции кита; пустой — «по издателю»: экран берёт бренд по издателю
// и типу провайдера, а не угадав — глиф «ключ», им пустая ячейка и нарисована. У пресетного
// провайдера значок назначает пресет, поля нет.
Функция ПолеЗначка(Знач Состояние, Знач Карточка)

	Если НЕ ПолеРазрешено(Карточка, "Значок") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Поле(Поля.ИмяПоляЗначка(), Тексты.Текст("providers.field.icon"))
		.ВыборЗначка().Разделы("бренды").Пусто(Тексты.Текст("providers.icon.default"), Значки.ЗначокБезБренда())
		.Значение(Окна.Значение(Состояние, Поля.ИмяПоляЗначка(), ПолеСтруктуры(Карточка, "Значок")));

КонецФункции

// Области в окне правки — у любого провайдера, как их принимает домен; пустое поле — прежние.
Функция ПолеОбластей(Знач Состояние, Знач Карточка)

	Возврат Кит.Поле(Поля.ИмяПоляОбласти(), Тексты.Текст("providers.field.scope"))
		.Значение(Окна.Значение(Состояние, Поля.ИмяПоляОбласти(), ПолеСтруктуры(Карточка, "Область")))
		.Пример(Тексты.Текст("providers.field.scope.example"))
		.Справка(Тексты.Текст("providers.field.scope.help"));

КонецФункции

// Свой адрес возврата нужен редко — хабу за прокси с другим внешним адресом, — поэтому он под
// катом. Кат открыт, когда в нём есть что увидеть: отказ у поля или адрес, отличный от адреса хаба.
Функция СвойАдресВозврата(Знач Состояние, Знач Действующее)

	Имя = Поля.ИмяПоляВозврата();
	Отказ = Окна.Отказ(Состояние, Имя);
	Значение = Окна.Значение(Состояние, Имя, Действующее);

	Кат = Кит.Раскрывашка(ПолеАдресаВозврата(Имя, Значение, Отказ))
		.Шапка(Тексты.Текст("providers.redirect.own")).Вид("врезка");
	Если ЗначениеЗаполнено(Отказ) ИЛИ ЭтоСвойАдрес(Значение) Тогда
		Кат.Открыть();
	КонецЕсли;
	Возврат Кат;

КонецФункции

// Адрес возврата браузер судит только как адрес: http в петлю домен принимает, и поле не строже.
Функция ПолеАдресаВозврата(Знач Имя, Знач Значение, Знач Отказ)

	Возврат Кит.Поле(Имя, Тексты.Текст("providers.field.redirect"))
		.Значение(Значение)
		.ТипЗначения("url").ПроверкаДоОтправки()
		.Пример(АдресХаба.АдресВозврата())
		.Подсказка(Тексты.Текст("providers.field.redirect.hint"))
		.Ошибка(Отказ);

КонецФункции

// Пустое поле и адрес хаба — не свои: их хаб подставляет сам.
Функция ЭтоСвойАдрес(Знач Значение)
	Возврат ЗначениеЗаполнено(Значение) И СокрЛП(Значение) <> АдресХаба.АдресВозврата();
КонецФункции

// У заведённого провайдера протокол и точки только на виду: меняются они заведением заново.
Функция Подключение(Знач Карточка)

	Возврат Кит.Холст(
		Кит.Свойства(
			Кит.Свойство(Тексты.Текст("providers.prop.kind"), Вид(Карточка)),
			Кит.Свойство(Тексты.Текст("providers.prop.issuer"), Кит.Код(Карточка.Издатель))
				.Когда(ЗначениеЗаполнено(Карточка.Издатель))),
		Кит.Примечание(Тексты.Текст("providers.connection.fixed")));

КонецФункции

#КонецОбласти

#Область ШагУчёткиИГруппы

Функция УчёткиИГруппы(Знач Состояние, Знач Карточка)

	Возврат Кит.Холст(
		Флажок(Состояние, Поля.ИмяПоляАвтоСоздания(), Тексты.Текст("providers.field.autoprovision"),
			ПолеСтруктуры(Карточка, "АвтоСоздание", Ложь)),
		Флажок(Состояние, Поля.ИмяПоляПровижининга(), Тексты.Текст("providers.field.groups.jit"),
			ПолеСтруктуры(Карточка, "ПровижинингГрупп", Ложь)),
		Флажок(Состояние, Поля.ИмяПоляСвязкиПоИмени(), Тексты.Текст("providers.field.groups.link"),
			ПолеСтруктуры(Карточка, "СвязкаГруппПоИмени", Ложь)),
		Кит.Поле(Поля.ИмяПоляКлеймаГрупп(), Тексты.Текст("providers.field.groups.claim"))
			.Значение(Окна.Значение(Состояние, Поля.ИмяПоляКлеймаГрупп(), ПолеСтруктуры(Карточка, "ИмяКлеймаГрупп"))),
		Кит.Поле(Поля.ИмяПоляПрефиксаГрупп(), Тексты.Текст("providers.field.groups.prefix"))
			.Значение(Окна.Значение(Состояние, Поля.ИмяПоляПрефиксаГрупп(), ПолеСтруктуры(Карточка, "ПрефиксГрупп")))
			.Справка(Тексты.Текст("providers.field.groups.prefix.help")),
		Флажок(Состояние, Поля.ИмяПоляВключён(), Тексты.Текст("providers.field.enabled"),
			ПолеСтруктуры(Карточка, "Включён", Истина)));

КонецФункции

Функция Флажок(Знач Состояние, Знач Имя, Знач Метка, Знач Действующее)

	Возврат Кит.Поле(Имя, Метка).ТипЗначения("флажок")
		.Значение(Поля.ЗначениеОтмечено())
		.Отмечено(Окна.Отмечено(Состояние, Имя, Действующее, Поля.ЗначениеОтмечено()));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Адрес точки провайдера: https, как его принимает домен.
Функция ПолеАдреса(Знач Состояние, Знач Имя, Знач Метка, Знач Действующее = "")

	Возврат Кит.Поле(Имя, Метка)
		.Значение(Окна.Значение(Состояние, Имя, Действующее))
		.Шаблон(Поля.ОбразецАдреса())
		.Ошибка(Окна.Отказ(Состояние, Имя));

КонецФункции

// Отказ домена, который не относится к одному полю, — над шагами.
Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

// Новому провайдеру пресет ещё не выбран: показываются поля «своего», пресет отсеет лишнее.
Функция ПолеРазрешено(Знач Карточка, Знач ИмяПоля)

	Пресет = ?(Карточка = Неопределено, Пресеты.БезПресета(), Карточка.Пресет);
	Возврат Пресеты.ПолеРазрешено(Пресет, ИмяПоля, ПолеСтруктуры(Карточка, "ВидПротокола"));

КонецФункции

Функция ПолеСтруктуры(Знач Карточка, Знач Имя, Знач Умолчание = "")

	Значение = Умолчание;
	Если Карточка <> Неопределено Тогда
		Карточка.Свойство(Имя, Значение);
	КонецЕсли;
	Возврат Значение;

КонецФункции

#КонецОбласти

&Прозвище("ОкноПровайдера")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ПресетыВхода") _Пресеты,
	&Пластилин(Значение = "ФормаПровайдераВхода") _Поля,
	&Пластилин(Значение = "АдресИнстанса") _АдресХаба,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисПровайдеровВхода") _Сервис,
	&Пластилин(Значение = "ЗначокПровайдера") _Значки) Экспорт

	Кит = _Кит;
	Окна = _Окна;
	Пресеты = _Пресеты;
	Поля = _Поля;
	АдресХаба = _АдресХаба;
	Тексты = _Тексты;
	Сервис = _Сервис;
	Значки = _Значки;

КонецПроцедуры
