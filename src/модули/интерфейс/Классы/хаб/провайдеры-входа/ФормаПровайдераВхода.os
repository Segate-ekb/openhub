// Имя эхо-поля подтверждения удаления: в него набирают имя провайдера.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляЭха() Экспорт
	Возврат "провайдер";
КонецФункции

// Имя поля областей в наборе сегмента пресета окна заведения: у каждого набора своё — одноимённые
// поля разных наборов ушли бы с формой все, и разбор взял бы первое.
//
// Параметры:
//  Сегмент - Строка - значение сегмента пресета.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОбластиПресета(Знач Сегмент) Экспорт
	Возврат ИмяПоляОбласти() + "-" + Сегмент;
КонецФункции

// Значение сегмента «Свой» в выборе пресета: провайдер без пресета.
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеСвоегоПресета() Экспорт
	Возврат "own";
КонецФункции

// Образец имени провайдера (атрибут pattern): латиница, цифры и дефис не по краям.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОбразецИмени() Экспорт
	Возврат "[A-Za-z0-9]([A-Za-z0-9\-]*[A-Za-z0-9])?";
КонецФункции

// Образец адреса точки и издателя провайдера: только https, схема — без учёта регистра.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОбразецАдреса() Экспорт
	Возврат "[Hh][Tt][Tt][Pp][Ss]://.+";
КонецФункции

// Образец кодов стран: двухбуквенные коды через запятую.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОбразецСтран() Экспорт
	Возврат "[A-Za-z]{2}(\s*,\s*[A-Za-z]{2})*";
КонецФункции

#КонецОбласти

&Прозвище("ФормаПровайдераВхода")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
