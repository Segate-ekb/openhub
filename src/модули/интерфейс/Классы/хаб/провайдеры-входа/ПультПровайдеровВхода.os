// Операции раздела «Провайдеры входа» дома «Хаб»: заведение, правка, включение и удаление
// провайдера, его правило по странам. Исход каждой — домена плюс отказы у полей окна.

Перем Гейт;        // ГейтФормы — CSRF-токен формы
Перем РазборФормы;
Перем Сервис;      // СервисПровайдеровВхода (вход)
Перем Разбор;      // РазборПровайдераВхода (вход) — правило имени провайдера
Перем Поля;        // ФормаПровайдераВхода — владелец имён полей
Перем АдресХаба;   // АдресИнстанса (настройки) — redirect_uri по умолчанию
Перем ВалидаторАдреса; // ВалидаторАдресаПровайдера (вход) — правило своего адреса возврата
Перем Тексты;      // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Разбирает тело запроса и проверяет CSRF.
//
// Параметры:
//  Ответ - ОтветСервера.
//  Контекст - Структура - Пользователь и Сессия запроса.
//  ТелоЗапроса - Строка.
//  КукиЗапроса - Куки - куки запроса.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - разобранная форма; Неопределено — ответ уже сформирован.
//
Функция Форма(Ответ, Знач Контекст, Знач ТелоЗапроса, Знач КукиЗапроса) Экспорт
	Возврат Гейт.СПринятымТокеном(Ответ, Контекст, РазборФормы.Разобрать(ТелоЗапроса), КукиЗапроса);
КонецФункции

// Заводит провайдера по форме окна «Новый провайдер».
//
// Параметры:
//  Принципал - Структура.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка — причина отказа словами,
//              заполнена у любого отказа), Отказы (Соответствие — имя поля -> отказ под полем).
//
Функция Создать(Знач Принципал, Знач Форма) Экспорт

	Отказы = ОтказыЗаведения(Форма);
	Если Отказы.Количество() > 0 Тогда
		Возврат ОтбитоПолями(Отказы);
	КонецЕсли;
	Возврат ИсходДомена(Сервис.Завести(Принципал, Ввод(Форма)));

КонецФункции

// Сохраняет правку провайдера из окна «Изменить».
//
// Параметры:
//  Принципал - Структура.
//  Имя - Строка - имя из адреса маршрута.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - см. Создать.
//
Функция Сохранить(Знач Принципал, Знач Имя, Знач Форма) Экспорт

	ОтказВозврата = ОтказАдресаВозврата(Форма);
	Если ЗначениеЗаполнено(ОтказВозврата) Тогда
		Возврат ОтбитоПолем(Поля.ИмяПоляВозврата(), ОтказВозврата);
	КонецЕсли;

	Данные = Ввод(Форма);
	// имя берётся из адреса, а не из тела: иначе скрытым полем правился бы чужой провайдер
	Данные.Вставить("Имя", Строка(Имя));
	Возврат ИсходДомена(Сервис.Изменить(Принципал, Имя, Данные));

КонецФункции

// Включает или выключает провайдера тумблером записи.
//
// Параметры:
//  Принципал - Структура.
//  Имя - Строка - имя из адреса маршрута.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - см. Создать.
//
Функция Переключить(Знач Принципал, Знач Имя, Знач Форма) Экспорт

	Возврат ИсходДомена(Сервис.Переключить(Принципал, Имя,
		РазборФормы.Флажок(Форма, Поля.ИмяПоляВключён(), Поля.ЗначениеОтмечено())));

КонецФункции

// Удаляет провайдера, если в эхо-поле подтверждения набрано его имя.
//
// Параметры:
//  Принципал - Структура.
//  Имя - Строка - имя из адреса маршрута.
//  Форма - Соответствие - разобранная форма подтверждения.
//
// Возвращаемое значение:
//  Структура - см. Создать; несовпавшее эхо — отказ под эхо-полем, домен не зовётся.
//
Функция Удалить(Знач Принципал, Знач Имя, Знач Форма) Экспорт

	Если Текст(Форма, Поля.ИмяПоляЭха()) <> Строка(Имя) Тогда
		Возврат ОтбитоПолем(Поля.ИмяПоляЭха(), Тексты.Шаблон("providers.delete.echo.mismatch", Имя));
	КонецЕсли;

	Исход = Сервис.Удалить(Принципал, Имя);
	Если Исход.Успех Тогда
		Возврат ИсходДомена(Исход);
	КонецЕсли;
	// отказ домена ложится туда же, где человек подтверждал: под эхо-полем
	Возврат ОтбитоПолем(Поля.ИмяПоляЭха(), Исход.Сообщение, Исход.Код);

КонецФункции

// Закрывает провайдера для посетителей из набранных стран; пустое поле снимает правило.
//
// Параметры:
//  Принципал - Структура.
//  Имя - Строка - имя из адреса маршрута.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Структура - см. Создать; отказ домена — под полем стран.
//
Функция ЗакрытьПоСтранам(Знач Принципал, Знач Имя, Знач Форма) Экспорт

	Исход = Сервис.ЗакрытьПоСтранам(Принципал, Имя, Текст(Форма, Поля.ИмяПоляСтран()));
	Если Исход.Успех Тогда
		Возврат ИсходДомена(Исход);
	КонецЕсли;
	Возврат ОтбитоПолем(Поля.ИмяПоляСтран(), Исход.Сообщение, Исход.Код);

КонецФункции

#КонецОбласти

#Область Ввод

// Поля окна → доменный ввод. Сегмент «Свой» пресета — провайдер без пресета.
Функция Ввод(Знач Форма)

	Данные = Новый Структура();
	Данные.Вставить("Имя", Текст(Форма, Поля.ИмяПоляИмени()));
	Данные.Вставить("Метка", Текст(Форма, Поля.ИмяПоляМетки()));
	// значок — только присланный: пустой значит «по издателю», неприсланный — «как был»
	Значок = РазборФормы.Поле(Форма, Поля.ИмяПоляЗначка(), Неопределено);
	Если Значок <> Неопределено Тогда
		Данные.Вставить("Значок", СокрЛП(Строка(Значок)));
	КонецЕсли;
	Данные.Вставить("Пресет", Пресет(Форма));
	Данные.Вставить("ВидПротокола", Текст(Форма, Поля.ИмяПоляПротокола()));
	Данные.Вставить("Издатель", Текст(Форма, Поля.ИмяПоляИздателя()));
	Данные.Вставить("ИдентификаторКлиента", Текст(Форма, Поля.ИмяПоляКлиента()));
	Данные.Вставить("СекретКлиента", Текст(Форма, Поля.ИмяПоляСекрета()));
	Данные.Вставить("АдресВозврата", АдресВозврата(Форма));
	Данные.Вставить("Область", Области(Форма));
	Данные.Вставить("БазовыйАдрес", Текст(Форма, Поля.ИмяПоляБазовогоАдреса()));
	Данные.Вставить("АдресАвторизации", Текст(Форма, Поля.ИмяПоляАвторизации()));
	Данные.Вставить("АдресТокена", Текст(Форма, Поля.ИмяПоляТокена()));
	Данные.Вставить("АдресПрофиля", Текст(Форма, Поля.ИмяПоляПрофиля()));
	Данные.Вставить("АдресEmails", Текст(Форма, Поля.ИмяПоляПисем()));
	Данные.Вставить("ИмяКлеймаГрупп", Текст(Форма, Поля.ИмяПоляКлеймаГрупп()));
	Данные.Вставить("ПрефиксГрупп", Текст(Форма, Поля.ИмяПоляПрефиксаГрупп()));
	Данные.Вставить("АвтоСоздание", Флажок(Форма, Поля.ИмяПоляАвтоСоздания()));
	Данные.Вставить("ПровижинингГрупп", Флажок(Форма, Поля.ИмяПоляПровижининга()));
	Данные.Вставить("СвязкаГруппПоИмени", Флажок(Форма, Поля.ИмяПоляСвязкиПоИмени()));
	Данные.Вставить("Включён", Флажок(Форма, Поля.ИмяПоляВключён()));
	Возврат Данные;

КонецФункции

Функция Пресет(Знач Форма)

	Значение = НРег(Текст(Форма, Поля.ИмяПоляПресета()));
	Возврат ?(Значение = Поля.ЗначениеСвоегоПресета(), "", Значение);

КонецФункции

// Окно правки шлёт одно поле областей, окно заведения — поле в наборе каждого пресета: берётся
// поле пришедшего пресета.
Функция Области(Знач Форма)

	Если Форма.Получить(Поля.ИмяПоляОбласти()) <> Неопределено Тогда
		Возврат Текст(Форма, Поля.ИмяПоляОбласти());
	КонецЕсли;
	Возврат Текст(Форма, Поля.ИмяПоляОбластиПресета(НРег(Текст(Форма, Поля.ИмяПоляПресета()))));

КонецФункции

// Пустое поле означает «считать из адреса хаба»; заполненное используется как есть.
Функция АдресВозврата(Знач Форма)

	Введённый = Текст(Форма, Поля.ИмяПоляВозврата());
	Возврат ?(ЗначениеЗаполнено(Введённый), Введённый, АдресХаба.АдресВозврата());

КонецФункции

// Отказы, которые окно может назвать у поля до домена: имя по правилу домена, client_id, свой
// адрес возврата по правилу домена.
Функция ОтказыЗаведения(Знач Форма)

	Отказы = Новый Соответствие();

	ОтказИмени = Разбор.ПроверитьИмя(НРег(Текст(Форма, Поля.ИмяПоляИмени())));
	Если ЗначениеЗаполнено(ОтказИмени) Тогда
		Отказы.Вставить(Поля.ИмяПоляИмени(), ОтказИмени);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Текст(Форма, Поля.ИмяПоляКлиента())) Тогда
		Отказы.Вставить(Поля.ИмяПоляКлиента(), Тексты.Текст("form.error.required"));
	КонецЕсли;
	ОтказВозврата = ОтказАдресаВозврата(Форма);
	Если ЗначениеЗаполнено(ОтказВозврата) Тогда
		Отказы.Вставить(Поля.ИмяПоляВозврата(), ОтказВозврата);
	КонецЕсли;

	Возврат Отказы;

КонецФункции

#КонецОбласти

#Область Исход

Функция ИсходДомена(Знач Исход)

	Возврат Новый Структура("Успех, Код, Сообщение, Отказы",
		Исход.Успех, ?(Исход.Успех, 200, КодОтказа(Исход.Код)), ?(Исход.Успех, "", Строка(Исход.Сообщение)),
		Новый Соответствие());

КонецФункции

// Отказы у полей; Сообщение — первый из них: отказ назван, даже если окна для него не будет.
Функция ОтбитоПолями(Знач Отказы)

	Сообщение = "";
	Для Каждого Отказ Из Отказы Цикл
		Сообщение = Отказ.Значение;
		Прервать;
	КонецЦикла;
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы", Ложь, 400, Строка(Сообщение), Отказы);

КонецФункции

Функция ОтбитоПолем(Знач ИмяПоля, Знач Текст, Знач Код = 400)

	Отказы = Новый Соответствие();
	Отказы.Вставить(ИмяПоля, Строка(Текст));
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы", Ложь, КодОтказа(Код), Строка(Текст), Отказы);

КонецФункции

Функция КодОтказа(Знач Код)
	Возврат ?(ЗначениеЗаполнено(Код) И Код >= 400, Код, 400);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Свой адрес возврата судит то же правило, что домен при записи, — но до неё, чтобы отказ встал
// у поля; пустое поле — адрес хаба, его не судят.
Функция ОтказАдресаВозврата(Знач Форма)

	Введённый = Текст(Форма, Поля.ИмяПоляВозврата());
	Если НЕ ЗначениеЗаполнено(Введённый) Тогда
		Возврат "";
	КонецЕсли;
	Проверка = ВалидаторАдреса.ПроверитьАдресВозврата(Введённый);
	Возврат ?(Проверка.Успех, "", Строка(Проверка.Сообщение));

КонецФункции

Функция Текст(Знач Форма, Знач Имя)
	Возврат СокрЛП(Строка(РазборФормы.Поле(Форма, Имя)));
КонецФункции

Функция Флажок(Знач Форма, Знач Имя)
	Возврат РазборФормы.Флажок(Форма, Имя, Поля.ЗначениеОтмечено());
КонецФункции

#КонецОбласти

&Прозвище("ПультПровайдеровВхода")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисПровайдеровВхода") _Сервис,
	&Пластилин(Значение = "РазборПровайдераВхода") _Разбор,
	&Пластилин(Значение = "ФормаПровайдераВхода") _Поля,
	&Пластилин(Значение = "АдресИнстанса") _Адрес,
	&Пластилин(Значение = "ВалидаторАдресаПровайдера") _ВалидаторАдреса,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	Сервис = _Сервис;
	Разбор = _Разбор;
	Поля = _Поля;
	АдресХаба = _Адрес;
	ВалидаторАдреса = _ВалидаторАдреса;
	Тексты = _Тексты;

КонецПроцедуры
