// Встроенная база стран у правила провайдера: выпуск и индекс, страна запроса администратора
// и закрывает ли правило провайдера всем, пока индекс не называет ни одной страны.

Перем Кит;          // Кит (кит) — фабрика элементов экрана
Перем Определитель; // ОпределительСтраны (гео)
Перем Тексты;       // ТекстыИнтерфейса (кит)
Перем Даты;         // ДатаЧеловеку

#Область ПубличныйИнтерфейс

// Закрывает ли правило сейчас провайдера всем: опубликованный индекс, по которому судит
// дверь, не называет ни одной страны, а неизвестная страна при живом правиле — отказ.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЗакрываетВсех() Экспорт

	Снимок = Снимок();
	Возврат Снимок = Неопределено ИЛИ Снимок.Страны.Количество() = 0;

КонецФункции

// Предупреждение «правило сейчас закрывает провайдера всем» — либо пустой узел.
//
// Возвращаемое значение:
//  ЭлементЭкрана.
//
Функция ПредупреждениеПроВсех() Экспорт

	Если НЕ ЗакрываетВсех() Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Уведомление(Новый Структура("Текст, Вид",
		Тексты.Текст("providers.geo.db.closes.everyone"), "err"));

КонецФункции

// Свойство «база стран» окна правила: выпуск и индекс одной строкой, беда — примечанием.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел свойства.
//
Функция СвойствоБазы() Экспорт

	Подпись = Тексты.Текст("providers.geo.prop.db");
	Снимок = Снимок();
	Если Снимок = Неопределено Тогда
		Возврат Кит.Свойство(Подпись, Тексты.Текст("providers.geo.db.unknown"));
	КонецЕсли;
	Если НЕ Снимок.Есть Тогда
		Возврат Кит.Свойство(Подпись, Тексты.Текст("providers.geo.db.none"))
			.Примечание(Тексты.Шаблон("providers.geo.db.missing", Снимок.Путь));
	КонецЕсли;

	Свойство = Кит.Свойство(Подпись, Тексты.Шаблон("providers.geo.db.release",
		Даты.ТолькоДата(Снимок.Дата), Индекс(Снимок)));
	Беда = Беды(Снимок);
	Если ЗначениеЗаполнено(Беда) Тогда
		Свойство.Примечание(Беда);
	КонецЕсли;
	Возврат Свойство;

КонецФункции

// Свойство «ваша страна сейчас»: какой страной хаб видит ТЕКУЩИЙ запрос администратора — той же
// дверью определителя, что судит посетителей, — и ссылка на /whoami, где видно, как он её понял.
//
// Параметры:
//  Посетитель - Структура, Неопределено - посетитель запроса (Адрес, Заголовки).
//  ЗакрытыеСтраны - Массив из Строка - страны правила провайдера.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел свойства.
//
Функция СвойствоСтраныЗапроса(Знач Посетитель, Знач ЗакрытыеСтраны) Экспорт

	Подпись = Тексты.Текст("providers.geo.prop.request");
	Проверка = Кит.Ссылка("/whoami", Тексты.Текст("providers.geo.whoami"));
	Вердикт = Вердикт(Посетитель);

	Если Вердикт <> Неопределено И Вердикт.Исход = Определитель.Исходы().Известна Тогда
		Страна = ?(ЗакрытыеСтраны.Найти(ВРег(Вердикт.Страна)) = Неопределено, Вердикт.Страна,
			Тексты.Шаблон("providers.geo.request.closed", Вердикт.Страна));
		Возврат Кит.Свойство(Подпись, Кит.Холст(Страна, " · ", Проверка));
	КонецЕсли;

	Если Вердикт <> Неопределено И Вердикт.Исход = Определитель.Исходы().НеНаблюдаемая Тогда
		Возврат Кит.Свойство(Подпись,
			Кит.Холст(Тексты.Текст("providers.geo.request.unwatched"), " · ", Проверка));
	КонецЕсли;

	Свойство = Кит.Свойство(Подпись,
		Кит.Холст(Тексты.Текст("providers.geo.request.unknown.short"), " · ", Проверка));
	Если Вердикт <> Неопределено Тогда
		Свойство.Примечание(Тексты.Шаблон("providers.geo.request.unknown", Вердикт.Причина));
	КонецЕсли;
	Возврат Свойство;

КонецФункции

#КонецОбласти

#Область Строки

// Что хаб различает сейчас: страны индекса либо «индекс пуст».
Функция Индекс(Знач Снимок)

	Если Снимок.Страны.Количество() = 0 Тогда
		Возврат Тексты.Текст("providers.geo.db.empty");
	КонецЕсли;
	Возврат Тексты.Шаблон("providers.geo.db.index", СтрСоединить(Снимок.Страны, ", "));

КонецФункции

// Устаревший выпуск, сборка в пути и прошлая неудача — что администратору делать с базой.
Функция Беды(Знач Снимок)

	Части = Новый Массив();
	Если Снимок.Устарела Тогда
		Части.Добавить(Тексты.Текст("providers.geo.db.stale"));
	КонецЕсли;
	Если Снимок.Строится Тогда
		Части.Добавить(Тексты.Шаблон("providers.geo.db.building", СтрСоединить(Снимок.Заказано, ", ")));
	КонецЕсли;
	Если ЗначениеЗаполнено(Снимок.Неудача) Тогда
		Части.Добавить(Тексты.Шаблон("providers.geo.db.failed", Снимок.Неудача));
	КонецЕсли;
	Возврат СтрСоединить(Части, " ");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Экран не падает из-за геобазы: Неопределено — состояние неизвестно, правило закрывает всех.
Функция Снимок()

	Попытка
		Возврат Определитель.СостояниеБазы();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Посетителя может не быть, а определитель — сорваться: тогда строки про свой запрос нет.
Функция Вердикт(Знач Посетитель)

	Если Посетитель = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат Определитель.ОпределитьПоЗапросу(Посетитель.Адрес, Посетитель.Заголовки);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

#КонецОбласти

&Прозвище("СостояниеБазыСтран")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОпределительСтраны") _Определитель,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты) Экспорт

	Кит = _Кит;
	Определитель = _Определитель;
	Тексты = _Тексты;
	Даты = _Даты;

КонецПроцедуры
