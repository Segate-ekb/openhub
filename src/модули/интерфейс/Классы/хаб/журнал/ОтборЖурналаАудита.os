// Отбор журнала аудита: имена параметров адреса, разбор сырых значений в границы отбора
// и обратная сборка параметров для ссылок и скрытых полей формы.

Перем Адреса;  // ОтборПоАдресу (аудит) — условие «этот адрес» либо «эта сеть»

#Область ИменаПараметров

// Имя параметра адреса с типом события.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяТипа() Экспорт
	Возврат "type";
КонецФункции

// Имя параметра адреса с субъектом операции.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяСубъекта() Экспорт
	Возврат "who";
КонецФункции

// Имя параметра адреса с началом периода.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяНачала() Экспорт
	Возврат "since";
КонецФункции

// Имя параметра адреса с концом периода.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяКонца() Экспорт
	Возврат "until";
КонецФункции

// Имя параметра адреса с адресом клиента либо сетью.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяАдреса() Экспорт
	Возврат "ip";
КонецФункции

// Имя параметра адреса с номером страницы.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяСтраницы() Экспорт
	Возврат "page";
КонецФункции

#КонецОбласти

#Область ПубличныйИнтерфейс

// Разбирает сырые значения адреса в отбор журнала.
//
// Параметры:
//  Тип - Строка - тип события (действие записи).
//  Кто - Строка - субъект операции.
//  Начало - Строка - начало периода в формате «ГГГГ-ММ-ДД».
//  Конец - Строка - конец периода в формате «ГГГГ-ММ-ДД», включительно.
//  Адрес - Строка - адрес клиента либо сеть CIDR (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Действие, Кто, Начало (Дата либо Неопределено), Конец (Дата либо
//              Неопределено), Адрес (условие ОтборПоАдресу), ТекстНачала, ТекстКонца,
//              ТекстАдреса (как их показывать в форме), АдресНеПрочитан (Булево),
//              Пустой (Булево).
//
Функция Разобрать(Знач Тип, Знач Кто, Знач Начало, Знач Конец, Знач Адрес = "") Экспорт

	ДатаНачала = ДатаИзТекста(Начало, Ложь);
	ДатаКонца = ДатаИзТекста(Конец, Истина);
	УсловиеАдреса = Адреса.Условие(Адрес);

	Отбор = Новый Структура();
	Отбор.Вставить("Действие", Текст(Тип));
	Отбор.Вставить("Кто", Текст(Кто));
	Отбор.Вставить("Начало", ДатаНачала);
	Отбор.Вставить("Конец", ДатаКонца);
	Отбор.Вставить("Адрес", УсловиеАдреса);
	// в поля формы возвращается ТОЛЬКО понятая дата: непонятая тихо вернулась бы в поле
	// и выглядела бы действующим отбором
	Отбор.Вставить("ТекстНачала", ?(ДатаНачала = Неопределено, "", Текст(Начало)));
	Отбор.Вставить("ТекстКонца", ?(ДатаКонца = Неопределено, "", Текст(Конец)));
	// непрочитанный адрес возвращается в поле, хотя отбором и не становится: экран о нём
	// ГОВОРИТ, а вычищенное поле оставило бы человека без объяснения
	Отбор.Вставить("ТекстАдреса", Текст(Адрес));
	Отбор.Вставить("АдресНеПрочитан", УсловиеАдреса.Задано И НЕ УсловиеАдреса.Понято);
	Отбор.Вставить("Пустой", НЕ ЗначениеЗаполнено(Отбор.Действие) И НЕ ЗначениеЗаполнено(Отбор.Кто)
		И ДатаНачала = Неопределено И ДатаКонца = Неопределено И НЕ УсловиеАдреса.Понято);

	Возврат Отбор;

КонецФункции

// Пустой отбор — журнал целиком.
//
// Возвращаемое значение:
//  Структура - см. Разобрать.
//
Функция Пустой() Экспорт
	Возврат Разобрать("", "", "", "", "");
КонецФункции

// Заполненные параметры отбора для ссылок и скрытых полей формы.
//
// Параметры:
//  Отбор - Структура - результат Разобрать.
//
// Возвращаемое значение:
//  Массив из Структура - Имя, Значение.
//
Функция Параметры(Знач Отбор) Экспорт

	Результат = Новый Массив();
	Добавить(Результат, ИмяТипа(), Отбор.Действие);
	Добавить(Результат, ИмяСубъекта(), Отбор.Кто);
	Добавить(Результат, ИмяНачала(), Отбор.ТекстНачала);
	Добавить(Результат, ИмяКонца(), Отбор.ТекстКонца);
	Добавить(Результат, ИмяАдреса(), Отбор.ТекстАдреса);
	Возврат Результат;

КонецФункции

// Номер страницы из сырого значения адреса.
//
// Параметры:
//  Значение - Строка - сырое значение параметра страницы.
//
// Возвращаемое значение:
//  Число - номер страницы, не меньше единицы.
//
Функция НомерСтраницы(Знач Значение) Экспорт

	Попытка
		Возврат Макс(1, Цел(Число(Текст(Значение))));
	Исключение
		Возврат 1;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Текст(Знач Значение)
	Возврат СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
КонецФункции

Процедура Добавить(Параметры, Знач Имя, Знач Значение)
	Если ЗначениеЗаполнено(Значение) Тогда
		Параметры.Добавить(Новый Структура("Имя, Значение", Имя, Значение));
	КонецЕсли;
КонецПроцедуры

// Конец периода включителен, поэтому берётся последняя секунда суток.
Функция ДатаИзТекста(Знач Значение, Знач КонецСуток)

	ТекстДаты = Текст(Значение);
	Если СтрДлина(ТекстДаты) <> 10 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Части = СтрРазделить(ТекстДаты, "-", Истина);
	Если Части.Количество() <> 3 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Год = Число(Части[0]);
		Месяц = Число(Части[1]);
		День = Число(Части[2]);
		Момент = Дата(Год, Месяц, День);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат ?(КонецСуток, Момент + 86399, Момент);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ОтборПоАдресу") _Адреса) Экспорт
	Адреса = _Адреса;
КонецПроцедуры
