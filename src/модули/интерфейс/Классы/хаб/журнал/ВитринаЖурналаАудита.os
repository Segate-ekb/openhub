// Раздел «Аудит» дома «Хаб»: отбор по нескольким полям с кнопкой «Найти», таблица записей
// с подробностями разворотом и страницы по признаку «есть следующая».

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем Служба;            // СлужбаАудита (аудит) — страница журнала
Перем Отборы;            // ОтборЖурналаАудита — имена параметров адреса
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Настройки;         // СервисНастроек (настройки) — размер страницы журнала
Перем Даты;              // ДатаЧеловеку — одно написание момента на весь интерфейс
Перем Формат;            // ФорматЖурналаАудита (аудит) — единственный разбор подробностей события

#Область ПубличныйИнтерфейс

// Секции раздела «Аудит» дома «Хаб».
//
// Параметры:
//  Параметры - Структура:
//    * Адрес - Строка - адрес раздела (он же адрес формы отбора и страниц);
//    * Отбор - Структура - результат ОтборЖурналаАудита.Разобрать;
//    * Страница - Число - номер страницы с единицы.
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - одна секция: границы прочитанного, отбор, таблица и страницы.
//
Функция Секции(Знач Параметры) Экспорт

	Отбор = Параметры.Отбор;
	Выдача = Служба.ЗаписиСтраницей(Отбор, Параметры.Страница,
		Настройки.Значение("oshub.ui.audit_page_size"));

	Секция = Кит.Секция(Тексты.Текст("settings.hub.audit.title"),
			ЧтоПрочитано(Выдача),
			ФормаОтбора(Параметры.Адрес, Отбор, Выдача.Записи),
			АдресНеПрочитан(Отбор),
			Таблица(Выдача),
			Навигация(Параметры.Адрес, Отбор, Выдача))
		.Лид(Тексты.Текст("settings.hub.audit.lead")).Иконка("история");

	Результат = Новый Массив();
	Результат.Добавить(Секция);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Отбор

// Экран читает хвост файла: без этой строки пустая выдача читалась бы как «таких операций не было».
Функция ЧтоПрочитано(Знач Выдача)

	Если НЕ Выдача.ИсточникДоступен Тогда
		Возврат Кит.Примечание(Тексты.Текст("settings.hub.audit.source.missing"));
	ИначеЕсли Выдача.ХвостУсечён Тогда
		Возврат Кит.Примечание(Тексты.Текст("settings.hub.audit.tail.truncated"));
	КонецЕсли;
	Возврат Кит.Примечание(Тексты.Текст("settings.hub.audit.tail.note"));

КонецФункции

// Отбор по непрочитанному адресу не применяется: экран называет причину, а не пустоту.
// Введённое — данные администратора: узлом текста.
Функция АдресНеПрочитан(Знач Отбор)

	Если НЕ Отбор.АдресНеПрочитан Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Примечание(Кит.Текст(Тексты.Шаблон("settings.hub.audit.filter.ip.unread",
		Отбор.ТекстАдреса)));

КонецФункции

// GET-форма из нескольких полей с кнопкой «Найти»: состояние списка живёт в адресе, со скриптом
// уходит без перезагрузки, без скрипта — обычной ссылкой; на телефоне поля встают каждое в строку.
Функция ФормаОтбора(Знач Адрес, Знач Отбор, Знач Записи)

	Возврат Кит.СтрокаПоиска(Адрес)
		.Поле(ВыборСобытия(Отбор.Действие, Записи))
		.Поле(Кит.Поле(Отборы.ИмяСубъекта(), Тексты.Текст("settings.hub.audit.filter.who"))
			.Значение(Отбор.Кто).Пример(Тексты.Текст("settings.hub.audit.filter.who.placeholder")))
		.Поле(Кит.Поле(Отборы.ИмяНачала(), Тексты.Текст("settings.hub.audit.filter.from"))
			.ТипЗначения(Тип("Дата")).Значение(Отбор.ТекстНачала))
		.Поле(Кит.Поле(Отборы.ИмяКонца(), Тексты.Текст("settings.hub.audit.filter.to"))
			.ТипЗначения(Тип("Дата")).Значение(Отбор.ТекстКонца))
		.Поле(Кит.Поле(Отборы.ИмяАдреса(), Тексты.Текст("settings.hub.audit.filter.ip"))
			.Значение(Отбор.ТекстАдреса).Пример(Тексты.Текст("settings.hub.audit.filter.ip.placeholder")))
		.Кнопка(Тексты.Текст("settings.hub.audit.filter.find"), "поиск").БезПерезагрузки();

КонецФункции

// Вариант отбора — действие, которое ВИДНО в прочитанном хвосте; действующий отбор обязан быть
// в списке, иначе экран показывал бы «все события» при работающем отборе.
Функция ВыборСобытия(Знач Выбранное, Знач Записи)

	Поле = Кит.Поле(Отборы.ИмяТипа(), Тексты.Текст("settings.hub.audit.filter.type"))
		.Вариант("", Тексты.Текст("settings.hub.audit.filter.type.all"));

	Известные = Новый Соответствие();
	Для Каждого Запись Из Записи Цикл
		ДобавитьВариант(Поле, Известные, Строка(Запись.Действие));
	КонецЦикла;
	ДобавитьВариант(Поле, Известные, Строка(Выбранное));

	Возврат Поле.Значение(Строка(Выбранное));

КонецФункции

Процедура ДобавитьВариант(Поле, Известные, Знач Действие)

	Если НЕ ЗначениеЗаполнено(Действие) ИЛИ Известные.Получить(Действие) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Известные.Вставить(Действие, Истина);
	Поле.Вариант(Действие, Действие);

КонецПроцедуры

#КонецОбласти

#Область Таблица

// На узком экране — карточки с моментом заглавием; поле, которого у записи нет, — прочерком:
// пустая ячейка читается как поломка экрана. Подробности — разворотом под записью.
Функция Таблица(Знач Выдача)

	Таблица = Кит.Таблица(Строки(Выдача.Записи)).Вид("карточками")
		.Пустое(Тексты.Текст("settings.hub.audit.cell.empty"))
		.Пусто(ПустаяВыдача(Выдача))
		.Разворот("details");
	Таблица.Колонка("when", Тексты.Текст("settings.hub.audit.col.when")).Заглавная();
	Таблица.Колонка("who", Тексты.Текст("settings.hub.audit.col.who"));
	Таблица.Колонка("action", Тексты.Текст("settings.hub.audit.col.action"));
	Таблица.Колонка("object", Тексты.Текст("settings.hub.audit.col.object"));
	Таблица.Колонка("subject", Тексты.Текст("settings.hub.audit.col.subject"));
	Таблица.Колонка("ip", Тексты.Текст("settings.hub.audit.col.ip"));
	Возврат Таблица;

КонецФункции

Функция Строки(Знач Записи)

	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Когда = Даты.ДатаВремя(Запись.Когда);
		Результат.Добавить(Новый Структура("when, who, action, object, subject, ip, details",
			Когда,
			Текст(Запись.Кто),
			Текст(Запись.Действие),
			Текст(Запись.Объект),
			Текст(ПолеСтруктуры(Запись, "Субъект")),
			Текст(Запись.АдресIP),
			Детали(ПолеСтруктуры(Запись, "Детали"), Когда, Запись.Кто)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПустаяВыдача(Знач Выдача)
	Если Выдача.ИсточникДоступен Тогда
		Возврат Тексты.Текст("settings.hub.audit.empty");
	КонецЕсли;
	Возврат Тексты.Текст("settings.hub.audit.source.missing");
КонецФункции

// Поля записи, которого может не быть: старые строки файла его не несут.
Функция ПолеСтруктуры(Знач Запись, Знач Имя)
	Попытка
		Возврат Запись[Имя];
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция Текст(Знач Значение)
	Возврат СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
КонецФункции

#КонецОбласти

#Область Подробности

// Разворот называет запись в доступном имени: двадцать «Подробнее» звучат одинаково.
// Записи без подробностей разворота нет.
Функция Детали(Знач ДеталиJSON, Знач Когда, Знач Кто)

	Список = Пары(ДеталиJSON);
	Если Список.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Свойства = Кит.Свойства();
	Для Каждого Пара Из Список Цикл
		Свойства.Добавить(Кит.Свойство(Пара.Имя, Кит.Текст(Пара.Значение)));
	КонецЦикла;

	Возврат Кит.Раскрывашка(Свойства).Вид("подробность")
		.Подпись(Тексты.Шаблон("settings.hub.audit.details.about", ИмяЗаписи(Когда, Кто)))
		.Шапка(Кит.Текст(Тексты.Текст("settings.hub.audit.details.summary")));

КонецФункции

// Пустые части выпадают: «Подробнее: , root» читается хуже, чем «Подробнее: root».
Функция ИмяЗаписи(Знач Когда, Знач Кто)

	Части = Новый Массив();
	Если ЗначениеЗаполнено(Когда) Тогда
		Части.Добавить(СокрЛП(Строка(Когда)));
	КонецЕсли;
	Если ЗначениеЗаполнено(Кто) Тогда
		Части.Добавить(СокрЛП(Строка(Кто)));
	КонецЕсли;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

Функция Пары(Знач ДеталиJSON)

	Результат = Новый Массив();

	Текст = СокрЛП(Строка(?(ДеталиJSON = Неопределено, "", ДеталиJSON)));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	// разбор у формата журнала: подробности не JSON-объектом дают Неопределено, а не исключение
	Разобрано = Формат.ДеталиПолями(Текст);
	Если Разобрано = Неопределено Тогда
		// нечитаемые детали — не повод ронять весь журнал: показываем как есть
		Результат.Добавить(Пара(Тексты.Текст("settings.hub.audit.details.raw"), Текст));
		Возврат Результат;
	КонецЕсли;

	Для Каждого КиЗ Из Разобрано Цикл
		Значение = Представление(КиЗ.Значение);
		Если ЗначениеЗаполнено(Значение) Тогда
			Результат.Добавить(Пара(Подпись(КиЗ.Ключ), Значение));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Пара(Знач Имя, Знач Значение)
	Возврат Новый Структура("Имя, Значение", Имя, Значение);
КонецФункции

// Ключи деталей пишет производитель события машинно, а читает их человек.
Функция Подпись(Знач Ключ)
	Возврат СтрЗаменить(СокрЛП(Строка(Ключ)), "_", " ");
КонецФункции

Функция Представление(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, Тексты.Текст("settings.value.yes"), Тексты.Текст("settings.value.no"));
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Части = Новый Массив();
		Для Каждого Элемент Из Значение Цикл
			Части.Добавить(Представление(Элемент));
		КонецЦикла;
		Возврат СтрСоединить(Части, ", ");
	ИначеЕсли ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Части = Новый Массив();
		Для Каждого КиЗ Из Значение Цикл
			Части.Добавить(Подпись(КиЗ.Ключ) + ": " + Представление(КиЗ.Значение));
		КонецЦикла;
		Возврат СтрСоединить(Части, ", ");
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

#КонецОбласти

#Область Страницы

// Сколько страниц у журнала, неизвестно — шаги идут по признаку «есть следующая», отбор едет в адресе
// каждой страницы. За краем журнала «назад» ведёт вглубь пустоты — из тупика нужен выход в один клик.
Функция Навигация(Знач Адрес, Знач Отбор, Знач Выдача)

	Если Выдача.Записи.Количество() = 0 И Выдача.Страница > 1 Тогда
		Возврат ВыходИзПустоты(Адрес, Отбор);
	КонецЕсли;

	Пагинация = Кит.Пагинация(Адрес, Выдача.Страница).ЕстьСледующая(Выдача.ЕстьСледующая)
		.Параметр(Отборы.ИмяСтраницы()).БезПерезагрузки();
	Для Каждого Пара Из Отборы.Параметры(Отбор) Цикл
		Пагинация.Параметры(Пара.Имя, Пара.Значение);
	КонецЦикла;
	Возврат Пагинация;

КонецФункции

// Адрес считает правило пагинации кита: вторая формула адреса разошлась бы с первой.
Функция ВыходИзПустоты(Знач Адрес, Знач Отбор)

	Первая = Кит.АдресСтраницы(Адрес, 1, Отборы.ИмяСтраницы(), Отборы.Параметры(Отбор));
	Возврат Кит.Примечание(Кит.Ссылка(Первая, Тексты.Текст("settings.hub.audit.page.first")));

КонецФункции

#КонецОбласти

&Прозвище("ВитринаЖурналаАудита")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СлужбаАудита") _Служба,
	&Пластилин(Значение = "ОтборЖурналаАудита") _Отборы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ФорматЖурналаАудита") _Формат,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено) Экспорт

	Кит = _Кит;
	Служба = _Служба;
	Отборы = _Отборы;
	Тексты = _Тексты;
	Настройки = _Настройки;
	Формат = _Формат;
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);

КонецПроцедуры
