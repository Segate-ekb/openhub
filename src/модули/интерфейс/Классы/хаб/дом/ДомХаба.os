// Дом настроек «Хаб»: разделы, их адреса, подписи и пояснения, преемники упразднённых разделов.

Перем Тексты;     // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Описание;   // ОписаниеПриложения (настройки) — имя инсталляции, объект дома
Перем Сборка;     // СборкаДомаНастроек — перечень разделов дома
Перем Перечень;   // ТаблицаЗначений — разделы дома по порядку колонки
Перем Лиды;       // Соответствие: ключ раздела -> его пояснение
Перем Преемники;  // Соответствие: упразднённый ключ раздела -> ключ, в который он влился
Перем Вложенные;  // Соответствие: ключ блока без своего пункта дерева -> ключ хозяйского раздела
Перем ПодписиВложенных; // Соответствие: ключ такого блока -> его подпись

// Ключ дома.
//
// Возвращаемое значение:
//  Строка - ключ дома.
//
Функция Ключ() Экспорт
	Возврат "hub";
КонецФункции

// Базовый адрес дома.
//
// Возвращаемое значение:
//  Строка - базовый адрес дома.
//
Функция БазовыйАдрес() Экспорт
	Возврат "/hub/settings";
КонецФункции

// Раздел по умолчанию.
//
// Возвращаемое значение:
//  Строка - раздел по умолчанию.
//
Функция РазделПоУмолчанию() Экспорт
	Возврат "identity";
КонецФункции

// Адрес раздела дома.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - адрес раздела дома.
//
Функция АдресРаздела(Знач Ключ) Экспорт
	Возврат БазовыйАдрес() + "/" + Ключ;
КонецФункции

// Разделы дома для модели (ОтветыНастроек.МодельДома).
//
// Параметры:
//  Активный - Строка - ключ активного раздела.
//
// Возвращаемое значение:
//  Структура - разделы дома (СборкаДомаНастроек.РазделыДома).
//
Функция Разделы(Знач Активный) Экспорт
	Возврат Сборка.РазделыДома(БазовыйАдрес(), Перечень, Действующий(Активный), РубрикаОбъекта());
КонецФункции

// Есть ли раздел с таким ключом.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Булево - есть ли раздел с таким ключом.
//
Функция ЕстьРаздел(Знач Ключ) Экспорт
	Возврат Сборка.РазделПеречня(Перечень, Ключ) <> Неопределено ИЛИ ЗначениеЗаполнено(Хозяин(Ключ));
КонецФункции

// Раздел, чьи настройки живут на чужом экране: свой адрес у него есть (форма постится
// на него), а пункта в дереве нет — чтение его адреса уводит к хозяину.
//
// Параметры:
//  Ключ - Строка - ключ блока.
//
// Возвращаемое значение:
//  Строка - ключ хозяйского раздела либо "" — блок самостоятельный.
//
Функция Хозяин(Знач Ключ) Экспорт

	Найдено = Вложенные.Получить(НРег(СокрЛП(Строка(Ключ))));
	Возврат ?(Найдено = Неопределено, "", Найдено);

КонецФункции

// Подпись раздела.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - подпись раздела либо "".
//
Функция ПодписьРаздела(Знач Ключ) Экспорт

	Своя = ПодписиВложенных.Получить(НРег(СокрЛП(Строка(Ключ))));
	Если Своя <> Неопределено Тогда
		Возврат Своя;
	КонецЕсли;

	Раздел = Сборка.РазделПеречня(Перечень, Ключ);
	Возврат ?(Раздел = Неопределено, "", Раздел.Подпись);

КонецФункции

// Иконка раздела — та же у пункта колонки и у заголовка его секции.
//
// Параметры:
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Строка - имя иконки кита либо "" — раздела в колонке нет.
//
Функция ИконкаРаздела(Знач Ключ) Экспорт
	Раздел = Сборка.РазделПеречня(Перечень, НРег(СокрЛП(Строка(Ключ))));
	Возврат ?(Раздел = Неопределено, "", Раздел.Иконка);
КонецФункции

// Пояснение раздела под его заголовком.
//
// Параметры:
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Строка - пояснение раздела либо "" — раздел объясняет себя сам.
//
Функция ЛидРаздела(Знач Ключ) Экспорт

	Найдено = Лиды.Получить(НРег(СокрЛП(Строка(Ключ))));
	Возврат ?(Найдено = Неопределено, "", Найдено);

КонецФункции

// Раздел, в который влился упразднённый: адрес прежнего раздела не исчезает молча.
//
// Параметры:
//  Ключ - Строка - ключ упразднённого раздела.
//
// Возвращаемое значение:
//  Строка - ключ раздела-преемника либо "" — такого переезда нет.
//
Функция Преемник(Знач Ключ) Экспорт

	Найдено = Преемники.Получить(НРег(СокрЛП(Строка(Ключ))));
	Возврат ?(Найдено = Неопределено, "", Найдено);

КонецФункции

// Место слитого раздела в дереве — у его преемника: иначе из него нет возврата.
Функция Действующий(Знач Ключ)

	Влился = Преемник(Ключ);
	Если ЗначениеЗаполнено(Влился) Тогда
		Возврат Влился;
	КонецЕсли;

	Хозяйский = Хозяин(Ключ);
	Возврат ?(ЗначениеЗаполнено(Хозяйский), Хозяйский, Ключ);

КонецФункции

// Ключи блоков, у которых нет своего пункта дерева: их настройки печатает хозяйский экран.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ВложенныеБлоки() Экспорт

	Результат = Новый Массив();
	Для Каждого КиЗ Из Вложенные Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Заголовок дома.
//
// Возвращаемое значение:
//  Строка - заголовок дома.
//
Функция Заголовок() Экспорт
	Возврат Тексты.Текст("settings.hub.title");
КонецФункции

// Объект дома — инсталляция: он один у всех разделов, поэтому дом называет его сам.
//
// Возвращаемое значение:
//  Строка - имя приложения; "" — дом собран без описания приложения.
//
Функция Объект() Экспорт
	Возврат ?(Описание = Неопределено, "", Описание.Имя());
КонецФункции

// Рубрика объекта дома (уходит в РазделыДома): под «Настройками хаба» она повторила бы имя — основное и брендирование
// идут первыми без рубрики.
//
// Возвращаемое значение:
//  Строка - подпись рубрики.
//
Функция РубрикаОбъекта() Экспорт
	Возврат Тексты.Текст("settings.hub.group.hub");
КонецФункции

// Пояснение дома.
//
// Возвращаемое значение:
//  Строка - пояснение дома.
//
Функция Пояснение() Экспорт
	Возврат Тексты.Текст("settings.hub.lead");
КонецФункции

// Раздел перечня дома.
Процедура Раздел(Знач КлючРаздела, Знач Подпись, Знач Иконка, Знач Рубрика)
	Сборка.Раздел(Перечень, КлючРаздела, Подпись, Иконка, Рубрика);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СборкаДомаНастроек") _Сборка,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ОписаниеПриложения") _Описание = Неопределено) Экспорт

	Сборка = _Сборка;
	Тексты = _Тексты;
	Описание = _Описание;

	// Рубрики: кто мы → кто входит → кто внутри → что внутри → как хаб говорит наружу → служба.
	Перечень = Сборка.ПереченьРазделов();

	Хаб = Тексты.Текст("settings.hub.group.hub");
	Раздел("identity", Тексты.Текст("settings.hub.nav.identity"), "куб", Хаб);
	Раздел("branding", Тексты.Текст("settings.hub.nav.branding"), "палочка", Хаб);

	Вход = Тексты.Текст("settings.hub.group.login");
	Раздел("login", Тексты.Текст("settings.hub.nav.login"), "замок", Вход);
	Раздел("providers", Тексты.Текст("settings.hub.nav.providers"), "ссылка", Вход);
	Раздел("password", Тексты.Текст("settings.hub.nav.password"), "ключ", Вход);

	ЛюдиИПулы = Тексты.Текст("settings.hub.group.people");
	Раздел("users", Тексты.Текст("settings.hub.nav.people"), "аккаунт", ЛюдиИПулы);
	Раздел("groups", Тексты.Текст("settings.hub.nav.groups"), "группа", ЛюдиИПулы);
	Раздел("pools", Тексты.Текст("settings.hub.nav.pools"), "стопка", ЛюдиИПулы);

	Пакеты = Тексты.Текст("settings.hub.group.packages");
	Раздел("storage", Тексты.Текст("settings.hub.nav.storage"), "скачать", Пакеты);
	Раздел("trusted", Тексты.Текст("settings.hub.nav.trusted"), "подпись", Пакеты);
	Раздел("proxy", Тексты.Текст("settings.hub.nav.proxy"), "стрелка", Пакеты);
	Раздел("mirrors", Тексты.Текст("settings.hub.nav.mirrors"), "копировать", Пакеты);
	Раздел("legacy", Тексты.Текст("settings.hub.nav.legacy"), "история", Пакеты);

	Оповещения = Тексты.Текст("settings.hub.group.notify");
	Раздел("mail", Тексты.Текст("settings.hub.nav.mail"), "конверт", Оповещения);
	Раздел("webhooks", Тексты.Текст("settings.hub.nav.webhooks"), "стрелка", Оповещения);

	Служба = Тексты.Текст("settings.hub.group.service");
	Раздел("audit", Тексты.Текст("settings.hub.nav.audit"), "история", Служба);
	Раздел("maintenance", Тексты.Текст("settings.hub.nav.maintenance"), "шестерёнка", Служба);

	// Пояснение раздела: раздел без записи объясняет себя пояснением своих секций.
	Лиды = Новый Соответствие();
	Лиды.Вставить("identity", Тексты.Текст("settings.hub.identity.lead"));
	Лиды.Вставить("branding", Тексты.Текст("settings.hub.branding.lead"));
	Лиды.Вставить("login", Тексты.Текст("settings.hub.login.lead"));
	Лиды.Вставить("password", Тексты.Текст("settings.hub.password.section.lead"));
	Лиды.Вставить("delivery", Тексты.Текст("settings.hub.delivery.lead"));
	Лиды.Вставить("legacy", Тексты.Текст("settings.hub.legacy.lead"));
	Лиды.Вставить("proxy", Тексты.Текст("settings.hub.proxy.lead"));
	Лиды.Вставить("pools", Тексты.Текст("settings.hub.pools.lead"));
	Лиды.Вставить("trusted", Тексты.Текст("settings.hub.trusted.lead"));
	Лиды.Вставить("mail", Тексты.Текст("settings.hub.mail.lead"));
	Лиды.Вставить("mirrors", Тексты.Текст("settings.hub.mirrors.lead"));
	Лиды.Вставить("maintenance", Тексты.Текст("settings.hub.maintenance.lead"));

	// Слитые разделы: адрес прежнего ведёт в тот, который его вобрал.
	Преемники = Новый Соответствие();
	Преемники.Вставить("registration", "login");
	Преемники.Вставить("auth", "login");
	Преемники.Вставить("people", "users");

	// Блоки без своего пункта дерева: настройки доставки печатаются на экране подписок —
	// одна тема, один экран.
	Вложенные = Новый Соответствие();
	Вложенные.Вставить("delivery", "webhooks");

	ПодписиВложенных = Новый Соответствие();
	ПодписиВложенных.Вставить("delivery", Тексты.Текст("settings.hub.block.delivery"));

КонецПроцедуры
