// Запись и уборка значений реестра настроек, пришедших формой раздела дома «Хаб».

Перем Настройки;    // СервисНастроек (настройки) — доменный API правки
Перем Витрина;      // ВитринаНастроек — что раздел показывает и правит
Перем РазборФормы;
Перем Сбои;       // ТекстСбоя — причина сбоя человеку и отчёт в журнал
Перем Тексты;       // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Записывает изменившиеся значения раздела. Значения пишутся по очереди; первое отвергнутое
// останавливает запись — то, что записано до него, действует.
//
// Параметры:
//  Раздел - Строка - ключ раздела дома «Хаб».
//  Форма - Соответствие - разобранная форма запроса.
//  Кто - Строка - логин автора изменения.
//
// Возвращаемое значение:
//  Структура - исход записи:
//    * Сообщение - Строка - отказ целиком: какая настройка, почему и что из формы уже применено;
//                  "" при успехе;
//    * Поле - Строка - имя поля отвергнутой настройки ("" при успехе);
//    * ОтказПоля - Строка - причина отказа для строки под полем;
//    * Применено - Строка - что из формы уже применено (или что не применено ничего);
//    * Отказы - Соответствие - отказ под полем для отбитой формы (ОкноРаздела.Отбитое): имя
//               поля → причина; пусто при успехе и у сброса.
//
Функция Применить(Знач Раздел, Знач Форма, Знач Кто) Экспорт

	Применённые = Новый Массив();

	Для Каждого Настройка Из Витрина.РедактируемыеРаздела(Раздел) Цикл

		ИмяПоля = Витрина.ИмяПоля(Настройка.Ключ);
		Если Форма.Получить(ИмяПоля) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Введённое = СокрЛП(РазборФормы.Поле(Форма, ИмяПоля));
		Если Настройка.Секрет Тогда
			// поле секрета приходит пустым всегда: пустое — «оставить как есть», а не «стереть».
			// Сравнивать с карточкой нечего — в ней маска, а не значение
			Если НЕ ЗначениеЗаполнено(Введённое) Тогда
				Продолжить;
			КонецЕсли;
		ИначеЕсли Введённое = Витрина.ЗначениеДляСравнения(Настройка) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Настройки.Установить(Настройка.Ключ, ЗначениеПоля(Настройка, Форма, ИмяПоля), Кто, "");
		Исключение
			Возврат ОтказСоСписком(Настройка, ИмяПоля, ИнформацияОбОшибке(), Применённые);
		КонецПопытки;

		Применённые.Добавить(Витрина.Метка(Настройка));

	КонецЦикла;

	Возврат ИсходЗаписи("", "", "", "");

КонецФункции

// Убирает введённое руками значение (действующим снова становится конфиг либо дефолт).
//
// Параметры:
//  Раздел - Строка - ключ раздела дома «Хаб».
//  Форма - Соответствие - разобранная форма запроса.
//  Кто - Строка - логин автора изменения.
//
// Возвращаемое значение:
//  Структура - исход записи, как у Применить: у сброса отказ к полю не относится — Поле пусто.
//
Функция Сбросить(Знач Раздел, Знач Форма, Знач Кто) Экспорт

	Перем Найденная;

	КлючНастройки = НРег(СокрЛП(РазборФормы.Поле(Форма, Витрина.ИмяПоляКлюча())));

	Найденная = Неопределено;
	Для Каждого Настройка Из Витрина.РедактируемыеРаздела(Раздел) Цикл
		Если Настройка.Ключ = КлючНастройки Тогда
			Найденная = Настройка;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Найденная = Неопределено Тогда
		Отказ = Тексты.Текст("settings.hub.error.key");
		Возврат ИсходЗаписи(Отказ, "", "", Отказ);
	КонецЕсли;

	Попытка
		Настройки.Сбросить(Найденная.Ключ, Кто, "");
	Исключение
		Отказ = Тексты.Шаблон("settings.hub.error.field",
			Витрина.Метка(Найденная), Сбои.Человеку(ИнформацияОбОшибке()));
		Возврат ИсходЗаписи(Отказ, "", "", Отказ);
	КонецПопытки;

	Возврат ИсходЗаписи("", "", "", "");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Текст отказа называет фактическое состояние настройки.
Функция ОтказСоСписком(Знач Настройка, Знач ИмяПоля, Знач Инфо, Знач Применённые)

	Причина = Сбои.Человеку(Инфо);
	Отказ = Тексты.Шаблон("settings.hub.error.field", Витрина.Метка(Настройка), Причина);

	Если Применённые.Количество() = 0 Тогда
		Применено = Тексты.Текст("settings.hub.error.applied.none");
	Иначе
		Применено = Тексты.Шаблон("settings.hub.error.applied", СтрСоединить(Применённые, ", "));
	КонецЕсли;

	Возврат ИсходЗаписи(Отказ + " " + Применено, ИмяПоля, Причина, Применено);

КонецФункции

Функция ИсходЗаписи(Знач Сообщение, Знач Поле, Знач ОтказПоля, Знач Применено)

	Отказы = Новый Соответствие();
	Если ЗначениеЗаполнено(Поле) Тогда
		Отказы.Вставить(Поле, ОтказПоля);
	КонецЕсли;
	Возврат Новый Структура("Сообщение, Поле, ОтказПоля, Применено, Отказы",
		Сообщение, Поле, ОтказПоля, Применено, Отказы);

КонецФункции

// Значение поля в виде, принимаемом доменным API: булево — тумблером, остальное — строкой.
Функция ЗначениеПоля(Знач Настройка, Знач Форма, Знач ИмяПоля)

	Если Настройка.Тип = "булево" Тогда
		Возврат РазборФормы.Флажок(Форма, ИмяПоля, Витрина.ЗначениеВключено());
	КонецЕсли;
	Возврат СокрЛП(РазборФормы.Поле(Форма, ИмяПоля));

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ВитринаНастроек") _Витрина,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Настройки = _Настройки;
	Витрина = _Витрина;
	РазборФормы = _РазборФормы;
	Сбои = _Сбои;
	Тексты = _Тексты;

КонецПроцедуры
