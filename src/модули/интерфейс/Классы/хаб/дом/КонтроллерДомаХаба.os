// Маршруты дома настроек «Хаб»: показ разделов и применение их форм пультами.

Перем ГвардХаб;            // ГвардХабАдмина
Перем Ответы;              // ОтветыНастроек
Перем Дом;                 // ДомХаба
Перем Витрина;             // ВитринаНастроек — принимает ли раздел значения
Перем ВитринаДома;         // ВитринаДомаХаба — секции разделов
Перем ПультЗначений;       // ПультЗначенийНастроек — запись и уборка значений реестра
Перем ПультЛичных;         // ПультЛичныхПространств — оба перехода настройки
Перем ПультПароля;         // ПультПарольногоВхода — оба перехода настройки
Перем ПультПробыПочты;     // ПультПробыПочты — проверочное письмо себе
Перем Гейт;                // ГейтФормы — метод запроса и токен формы
Перем Защита;              // ЗащитаCSRF (вход)
Перем РазборФормы;
Перем Тексты;              // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Отметка;  // ОтметкаСохранения — «сохранено» параметром на адресе
Перем Окна;     // ОкноРаздела — окно раздела по адресу и отбитая форма в нём
Перем ОкноПароля; // ВитринаПарольногоВхода — вид окна выключения и поле его эха

#Область ТочкиМаршрута

// Точка маршрута «settings» (GET).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//
&ТочкаМаршрута("settings")
Процедура Обзор(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	// заголовок дома нужен и на входной странице: человек ищет именно его
	ОтдатьРаздел(Ответ, Вердикт, Дом.РазделПоУмолчанию(), Ложь, "", КукиЗапроса);

КонецПроцедуры

// Точка маршрута «settings/{раздел}» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  раздел - Строка - ключ раздела.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно раздела, которое страница печатает открытым: «выключить» — подтверждение
//         выключения парольного входа (необязательный, по умолчанию "").
//
&ТочкаМаршрута("settings/{раздел}")
Процедура Раздел(Ответ, раздел, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	saved = "", окно = "") Экспорт

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Ключ = НРег(СокрЛП(Строка(раздел)));
	Если НЕ Дом.ЕстьРаздел(Ключ) Тогда
		ЗакрытьПрежнийАдрес(Ответ, Вердикт, Ключ, МетодЗапроса, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		// вложенный блок печатается на экране хозяина: свой адрес у него только для формы
		Если ЗначениеЗаполнено(Дом.Хозяин(Ключ)) Тогда
			ЭкранХозяина = Дом.АдресРаздела(Дом.Хозяин(Ключ));
			Ответ.Перенаправить(?(ЗначениеЗаполнено(saved),
				Отметка.НаАдресе(ЭкранХозяина), ЭкранХозяина));
			Возврат;
		КонецЕсли;
		ОтдатьРаздел(Ответ, Вердикт, Ключ, ЗначениеЗаполнено(saved), "", КукиЗапроса, 200,
			Окна.ИзАдреса(окно, ОкноПароля.ВидОкна()));
		Возврат;
	КонецЕсли;
	// вложенный блок пишет своя дверь на экране хозяина (доставка — «webhooks/delivery»): дорога
	// записи у блока одна, адрес блока — только для чтения
	Если ЗначениеЗаполнено(Дом.Хозяин(Ключ)) Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Гейт.СПринятымТокеном(Ответ, Вердикт, РазборФормы.Разобрать(ТелоЗапроса), КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Сохранить(Ответ, Вердикт, Ключ, Форма, КукиЗапроса);

КонецПроцедуры

// Чтение ведёт в раздел-преемник, мутация получает честный отказ: редирект POST хуже 405.
Процедура ЗакрытьПрежнийАдрес(Ответ, Знач Вердикт, Знач Ключ, Знач МетодЗапроса, Знач КукиЗапроса)

	Преемник = Дом.Преемник(Ключ);

	Если НЕ ЗначениеЗаполнено(Преемник) Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт,
			Тексты.Текст("settings.hub.error.section"), КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Ответ.Заголовки["Location"] = Дом.АдресРаздела(Преемник);
	Ответ.УстановитьСостояние(301);

КонецПроцедуры

#КонецОбласти

#Область Сохранение

Процедура Сохранить(Ответ, Знач Вердикт, Знач Ключ, Знач Форма, Знач КукиЗапроса)

	Перем Проблема;

	Кто = ПринципалСессии(Вердикт);

	// пульты спрашиваются ДО гейта «раздел принимает значения»: форма пробы почты
	// не правит ни одной записи реестра, и гейт отбил бы её 405
	ИтогПульта = ПрименитьПульты(Ключ, Форма, Кто, Вердикт.Пользователь);
	Если ВопросПароля(ИтогПульта) Тогда
		СпроситьВыключениеПароля(Ответ, Вердикт, Ключ, ИтогПульта, Форма, КукиЗапроса);
		Возврат;
	КонецЕсли;
	Если ИтогПульта.Перехвачено Тогда
		Если ЗначениеЗаполнено(ИтогПульта.Адрес) Тогда
			// операция удалась и у неё нет чисел для показа: обычный POST-редирект-GET
			Ответ.Перенаправить(ИтогПульта.Адрес);
			Возврат;
		КонецЕсли;
		ОтдатьИтогПульта(Ответ, Вердикт, Ключ, ИтогПульта, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если НЕ Витрина.ПринимаетИзменения(Ключ) Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, Витрина.ИмяПоляОперации())));

	Если Операция = Витрина.ОперацияСброса() Тогда
		Проблема = ПультЗначений.Сбросить(Ключ, Форма, Кто).Сообщение;
	ИначеЕсли НЕ ЗначениеЗаполнено(Операция) Тогда
		ЗаписатьЗначения(Ответ, Вердикт, Ключ, Форма, Кто, КукиЗапроса);
		Возврат;
	Иначе
		// белый список операций: устаревшая вкладка не должна попадать в ветку «сохранить всё»
		Проблема = Тексты.Текст("settings.hub.error.operation");
	КонецЕсли;

	Если ЗначениеЗаполнено(Проблема) Тогда
		ОтдатьРаздел(Ответ, Вердикт, Ключ, Ложь, Проблема, КукиЗапроса, 400);
		Возврат;
	КонецЕсли;

	Ответ.Перенаправить(Отметка.НаАдресе(Дом.АдресРаздела(Ключ)));

КонецПроцедуры

// Отказ значения — под его полем, с набранным на месте; над разделом сказано, что из формы уже
// действует. Отбитая форма тонких крутилок возвращается в открытый кат, а не прячется под ним.
Процедура ЗаписатьЗначения(Ответ, Знач Вердикт, Знач Ключ, Знач Форма, Знач Кто, Знач КукиЗапроса)

	Исход = ПультЗначений.Применить(Ключ, Форма, Кто);
	Если НЕ ЗначениеЗаполнено(Исход.Сообщение) Тогда
		Ответ.Перенаправить(Отметка.НаАдресе(Дом.АдресРаздела(Ключ)));
		Возврат;
	КонецЕсли;

	ОтдатьРаздел(Ответ, Вердикт, Ключ, Ложь, Исход.Применено, КукиЗапроса, 400,
		Окна.Отбитое(Витрина.ВидОтбитыхЗначений(), Ключ, Форма, Исход.Отказы), Витрина.ФормаТонких(Ключ, Форма));

КонецПроцедуры

// Выключение парольного входа спрашивается окном по адресу: первая отправка уводит на страницу
// с открытым подтверждением, не то слово в эхе возвращает это окно с отказом под полем.
Процедура СпроситьВыключениеПароля(Ответ, Знач Вердикт, Знач Ключ, Знач Итог, Знач Форма,
	Знач КукиЗапроса)

	Если НЕ ЗначениеЗаполнено(Итог.Ошибка) Тогда
		Окна.СпроситьПодтверждение(Ответ, Дом.АдресРаздела(Ключ), "", ОкноПароля.ВидОкна());
		Возврат;
	КонецЕсли;

	Отказы = Новый Соответствие();
	Отказы.Вставить(ОкноПароля.ИмяПоляЭха(), Итог.Ошибка);
	ОтдатьРаздел(Ответ, Вердикт, Ключ, Ложь, "", КукиЗапроса, 400,
		Окна.Отбитое(ОкноПароля.ВидОкна(), "", Форма, Отказы));

КонецПроцедуры

Функция ВопросПароля(Знач Итог)
	Возврат Итог.Перехвачено И Итог.Спросить <> Неопределено И Итог.Окно = ОкноПароля;
КонецФункции

// Пульты спрашиваются по очереди: каждый сам решает, его ли это раздел и его ли поле.
Функция ПрименитьПульты(Знач Раздел, Знач Форма, Знач Кто, Знач Пользователь)

	Итог = ПультЛичных.Применить(Раздел, Форма, Кто);
	Если Итог.Перехвачено Тогда
		Возврат Итог;
	КонецЕсли;
	Итог = ПультПробыПочты.Применить(Раздел, Форма, Пользователь);
	Если Итог.Перехвачено Тогда
		Возврат Итог;
	КонецЕсли;
	Возврат ПультПароля.Применить(Раздел, Форма, Кто);

КонецФункции

// Автор изменения — из сессии.
Функция ПринципалСессии(Знач Вердикт)

	Логин = ?(Вердикт.Пользователь = Неопределено, "", СокрЛП(Строка(Вердикт.Пользователь.Логин)));

	Если НЕ ЗначениеЗаполнено(Логин) Тогда
		// падаем громко: тихий "" дал бы анонимную строку в журнале аудита
		ВызватьИсключение "Дом «Хаб»: мутация настройки без принципала сессии —"
			+ " гвард пропустил запрос без пользователя. Автор изменения обязателен.";
	КонецЕсли;

	Возврат Логин;

КонецФункции

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач Ключ, Знач Сохранено, Знач Ошибка, Знач КукиЗапроса,
	Знач Статус = 200, Знач ОткрытоеОкно = Неопределено, Знач ТонкиеРаскрыты = Ложь)

	Модель = МодельРаздела(Вердикт, Ключ, Ответы.УведомленияРаздела(Сохранено, Ошибка),
		Неопределено, Неопределено, ОткрытоеОкно, ТонкиеРаскрыты);
	Ответы.ОтдатьДом(Ответ, Модель, Вердикт, КукиЗапроса, Статус);

КонецПроцедуры

// Вопрос, отказ по эху и итог массовой операции печатаются на странице: редирект потерял бы числа.
Процедура ОтдатьИтогПульта(Ответ, Знач Вердикт, Знач Ключ, Знач Итог, Знач КукиЗапроса)

	Уведомления = Ответы.УведомленияРаздела(Ложь, Итог.Ошибка);
	Если ЗначениеЗаполнено(Итог.Уведомление) Тогда
		Уведомления.Добавить(Ответы.Уведомление(Итог.Уведомление, "ok"));
	КонецЕсли;

	Модель = МодельРаздела(Вердикт, Ключ, Уведомления, Итог.Спросить, Итог.Окно);

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт, КукиЗапроса,
		?(ЗначениеЗаполнено(Итог.Ошибка), КодОтказаПульта(Итог), 200));

КонецПроцедуры

// Отказ по праву называет себя своим кодом: 400 сказал бы «поправьте форму», хотя править нечего.
Функция КодОтказаПульта(Знач Итог)
	Возврат ?(Итог.Статус > 0, Итог.Статус, 400);
КонецФункции

Функция МодельРаздела(Знач Вердикт, Знач Ключ, Знач Уведомления, Знач Спросить, Знач Окно,
	Знач ОткрытоеОкно = Неопределено, Знач ТонкиеРаскрыты = Ложь)

	Токен = Защита.ТокенСессии(Вердикт.Сессия);
	Возврат Ответы.МодельДома(Дом, "",
		Дом.Разделы(Ключ),
		Уведомления,
		ВитринаДома.Секции(Новый Структура(
			"Ключ, Токен, Пользователь, Спросить, Окно, Обзор, ОткрытоеОкно, ТонкиеРаскрыты",
			Ключ, Токен, Вердикт.Пользователь, Спросить, Окно, Неопределено, ОткрытоеОкно, ТонкиеРаскрыты)),
		Токен);

КонецФункции

#КонецОбласти

&Контроллер("/hub")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардХабАдмина") _ГвардХаб,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ВитринаНастроек") _Витрина,
	&Пластилин(Значение = "ВитринаДомаХаба") _ВитринаДома,
	&Пластилин(Значение = "ПультЗначенийНастроек") _ПультЗначений,
	&Пластилин(Значение = "ПультЛичныхПространств") _ПультЛичных,
	&Пластилин(Значение = "ПультПарольногоВхода") _ПультПароля,
	&Пластилин(Значение = "ПультПробыПочты") _ПультПробыПочты,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ОтметкаСохранения") _Отметка,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ВитринаПарольногоВхода") _ОкноПароля)

	ГвардХаб = _ГвардХаб;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	ВитринаДома = _ВитринаДома;
	ПультЗначений = _ПультЗначений;
	ПультЛичных = _ПультЛичных;
	ПультПароля = _ПультПароля;
	ПультПробыПочты = _ПультПробыПочты;
	Гейт = _Гейт;
	Защита = _Защита;
	РазборФормы = _РазборФормы;
	Тексты = _Тексты;
	Отметка = _Отметка;
	Окна = _Окна;
	ОкноПароля = _ОкноПароля;

КонецПроцедуры
