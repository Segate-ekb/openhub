// «Настройки доставки» на экране подписок хаба: спойлер под списком с плашками «включена»
// и «прокси задан», внутри — тумблеры доставки и свёрнутый «Прокси Telegram». Поля — те же поля
// реестра настроек, что у остальных разделов дома: источник значения мелко, секрет не печатается.

Перем Кит;      // Кит (кит) — фабрика элементов экрана
Перем Витрина;  // ВитринаНастроек — карточки раздела «delivery»
Перем Поля;     // ПоляНастроек — поле настройки по её карточке
Перем Тексты;   // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Ключ раздела настроек, который собирает спойлер.
//
// Возвращаемое значение:
//  Строка.
//
Функция Раздел() Экспорт
	Возврат "delivery";
КонецФункции

// Спойлер «Настройки доставки» одной формой с панелью сохранения.
//
// Параметры:
//  Адрес - Строка - адрес формы спойлера.
//  Раскрыта - Булево - спойлер открыт: в него вернулась отбитая форма.
//  Отбитая - Структура, Неопределено - форма спойлера, вернувшаяся с отказом значения (см.
//            ОкноРаздела.Отбитое): поле печатает набранное и отказ под собой (необязательный).
//
// Возвращаемое значение:
//  ЭлементЭкрана, Неопределено - спойлер; Неопределено, если показывать нечего.
//
Функция Спойлер(Знач Адрес, Знач Раскрыта, Знач Отбитая = Неопределено) Экспорт

	Карточки = Витрина.ПоказываемыеРаздела(Раздел());
	Если Карточки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Тумблеры = Кит.Холст();
	Прокси = Кит.Холст();
	Сервер = "";
	Включена = Истина;
	Для Каждого Карточка Из Карточки Цикл
		Если СтрНачинаетсяС(Карточка.Ключ, ПрефиксПрокси()) Тогда
			Прокси.Добавить(Поле(Карточка, Отбитая));
		Иначе
			Тумблеры.Добавить(Поле(Карточка, Отбитая));
		КонецЕсли;
		Если Карточка.Ключ = КлючСервераПрокси() Тогда
			Сервер = СокрЛП(Строка(Карточка.Значение));
		ИначеЕсли Карточка.Ключ = КлючДоставки() Тогда
			Включена = (Карточка.Значение = Истина);
		КонецЕсли;
	КонецЦикла;

	// «Прокси Telegram» свёрнут, пока сервер не задан: заданный прокси видно сразу, отбитый — тоже
	СпойлерПрокси = Кит.Раскрывашка(Прокси)
		.Шапка(Тексты.Текст("subscriptions.delivery.proxy"), ПлашкаПрокси(Сервер, Истина))
		.Вид("врезка");
	Если ЗначениеЗаполнено(Сервер) ИЛИ ОтказВПрокси(Отбитая) Тогда
		СпойлерПрокси.Открыть();
	КонецЕсли;

	Спойлер = Кит.Раскрывашка(
			Кит.Форма(Адрес,
				Тумблеры,
				СпойлерПрокси,
				Кит.ПанельСохранения(Тексты.Текст("subscriptions.delivery.save"))
					.Пояснение(Тексты.Текст("settings.values.editable.note")))
				.БезПерезагрузки())
		.Шапка(Кит.Иконка("конверт"), Тексты.Текст("subscriptions.delivery.title"),
			Кит.Плашка(?(Включена, Тексты.Текст("subscriptions.delivery.on"),
				Тексты.Текст("subscriptions.delivery.off"))).Вид(?(Включена, "ok", "warn")),
			ПлашкаПрокси(Сервер, Ложь))
		.Вид("врезка");
	// формы сброса — рядом с формой спойлера, а не в ней: вложенной формы в HTML не бывает
	Для Каждого Карточка Из Карточки Цикл
		Спойлер.Добавить(Поля.ФормаСброса(Карточка, Адрес));
	КонецЦикла;
	Если Раскрыта Тогда
		Спойлер.Открыть();
	КонецЕсли;
	Возврат Спойлер;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Поле правимой настройки, а у занятой конфигурацией — её значение с объяснением вместо ввода.
Функция Поле(Знач Карточка, Знач Отбитая)
	Возврат ?(Карточка.Редактируемая, Поля.ПолеПравки(Карточка, Отбитая), Поля.ПолеЗанятое(Карточка));
КонецФункции

Функция ОтказВПрокси(Знач Отбитая)
	Если Отбитая = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Отказ Из Отбитая.Отказы Цикл
		Если СтрНачинаетсяС(Отказ.Ключ, ПрефиксПрокси()) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// «прокси задан» в строке спойлера, «задан» — в шапке самого прокси.
Функция ПлашкаПрокси(Знач Сервер, Знач Коротко)

	Если ЗначениеЗаполнено(Сервер) Тогда
		Возврат Кит.Плашка(?(Коротко, Тексты.Текст("subscriptions.delivery.proxy.set.short"),
			Тексты.Текст("subscriptions.delivery.proxy.set"))).Вид("ok");
	КонецЕсли;
	Возврат Кит.Плашка(?(Коротко, Тексты.Текст("subscriptions.delivery.proxy.unset.short"),
		Тексты.Текст("subscriptions.delivery.proxy.unset")));

КонецФункции

Функция ПрефиксПрокси()
	Возврат "oshub.webhooks.telegram.proxy.";
КонецФункции

Функция КлючСервераПрокси()
	Возврат "oshub.webhooks.telegram.proxy.host";
КонецФункции

Функция КлючДоставки()
	Возврат "oshub.webhooks.delivery_enabled";
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ВитринаНастроек") _Витрина,
	&Пластилин(Значение = "ПоляНастроек") _Поля,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Витрина = _Витрина;
	Поля = _Поля;
	Тексты = _Тексты;

КонецПроцедуры
