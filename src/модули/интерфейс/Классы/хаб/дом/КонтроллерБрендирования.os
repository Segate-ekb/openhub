// Маршруты раздела «Брендирование» дома «Хаб»: страница с образцом шапки, значения одной формой,
// логотип и иконка — каждая картинка своим адресом загрузки и возврата стандартной. Удача — 303
// на раздел, отказ — та же страница: у поля, под слотом или тостом.

Перем ГвардХаб;     // ГвардХабАдмина
Перем Ответы;       // ОтветыНастроек
Перем Дом;          // ДомХаба
Перем ВитринаДома;  // ВитринаДомаХаба — секции раздела в составе дома
Перем Витрина;      // ВитринаБрендирования — виды состояний раздела
Перем Пульт;        // ПультБрендирования
Перем Гейт;         // ГейтФормы — токен формы
Перем Защита;       // ЗащитаCSRF (вход)
Перем РазборФормы;
Перем Окна;         // ОкноРаздела — окно по адресу, подтверждение и ответы форм
Перем Тексты;       // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ТочкиМаршрута

// Точка маршрута «branding»: GET — страница раздела, POST — значения раздела либо уборка
// введённого руками.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  ДанныеФормы - ДанныеСоставнойФормы - разобранная winow составная форма.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: вернуть-<картинка> (необязательный, по умолчанию "").
//
&ТочкаМаршрута("branding")
Процедура Раздел(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, ДанныеФормы,
	saved = "", окно = "") Экспорт

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Структура("Вердикт, Куки", Вердикт, КукиЗапроса);

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Запрос, 200, Окна.ИзАдреса(окно, Витрина.ВидВозврата()),
			ЗначениеЗаполнено(saved));
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	// форма картинок старой вкладки уходила сюда же составной: её поля живут в частях
	Форма = Гейт.СПринятымТокеном(Ответ, Вердикт, ?(РазборФормы.ЭтоСоставная(ДанныеФормы),
		РазборФормы.РазобратьСоставную(ДанныеФормы), РазборФормы.Разобрать(ТелоЗапроса)), КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Кто = Принципал(Вердикт);
	Если Пульт.ФормаУстарела(Форма) Тогда
		Завершить(Ответ, Запрос, Пульт.ОтказУстаревшей());
	ИначеЕсли Пульт.ЭтоСбросВведённого(Форма) Тогда
		Завершить(Ответ, Запрос, Пульт.СброситьВведённое(Форма, Кто));
	Иначе
		Завершить(Ответ, Запрос, Пульт.СохранитьЗначения(Форма, Кто), Витрина.ВидЗначений(), "", Форма);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «branding/{слот}» — загрузка картинки: форма слота уходит сразу по выбору файла.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  слот - Строка - картинка: «logo» или «favicon».
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ДанныеФормы - ДанныеСоставнойФормы - разобранная winow составная форма: токен и файл.
//
&ТочкаМаршрута("branding/{слот}")
Процедура Загрузка(Ответ, слот, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ДанныеФормы) Экспорт

	Мутация = Мутация(Ответ, слот, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
		РазборФормы.РазобратьСоставную(ДанныеФормы));
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Запрос, Пульт.Загрузить(слот, РазборФормы.Файлы(ДанныеФормы), Мутация.Кто),
		Витрина.ВидЗагрузки(), слот);

КонецПроцедуры

// Точка маршрута «branding/{слот}/reset» — «Вернуть стандартную». Без поля подтверждения (форма
// ушла без скрипта) картинка не трогается: ответ ведёт на страницу с открытым подтверждением.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  слот - Строка - картинка: «logo» или «favicon».
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("branding/{слот}/reset")
Процедура ВозвратСтандартной(Ответ, слот, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Мутация = Мутация(Ответ, слот, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
		РазборФормы.Разобрать(ТелоЗапроса));
	Если Мутация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Окна.Подтверждено(Мутация.Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресРаздела(), слот, Витрина.ВидВозврата());
		Возврат;
	КонецЕсли;

	Завершить(Ответ, Мутация.Запрос, Пульт.Вернуть(слот, Мутация.Кто));

КонецПроцедуры

#КонецОбласти

#Область Действия

// Общий пролог картинок: гвард → только POST → форма с CSRF → картинка, которая у раздела есть.
Функция Мутация(Ответ, Знач Слот, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач МетодЗапроса,
	Знач Разобранная)

	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "POST", Вердикт, КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Форма = Гейт.СПринятымТокеном(Ответ, Вердикт, Разобранная, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ Пульт.ЕстьСлот(Слот) Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт, Тексты.Текст("settings.hub.branding.error.key"),
			КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Запрос, Кто, Форма", Новый Структура("Вердикт, Куки", Вердикт, КукиЗапроса),
		Принципал(Вердикт), Форма);

КонецФункции

// Исход пульта → ответ: удача — 303 на раздел; отказ — страница раздела с отказом там, где его
// причина: у поля формы значений, под слотом картинки, иначе тостом.
Процедура Завершить(Ответ, Знач Запрос, Знач Исход, Знач Вид = "", Знач Ключ = "",
	Знач Форма = Неопределено)

	Если Исход.Успех Тогда
		Окна.ВернутьВРаздел(Ответ, АдресРаздела());
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Вид) Тогда
		ОтдатьРаздел(Ответ, Запрос, Исход.Код, Неопределено, Ложь, Исход.Сообщение);
		Возврат;
	КонецЕсли;

	// отказ у поля уже назван — тостом раздел говорит только, что из формы уже применено
	УПоля = Исход.Отказы.Количество() > 0;
	Состояние = Окна.Отбитое(Вид, Ключ, Форма, Исход.Отказы, Исход.Сообщение);
	ОтдатьРаздел(Ответ, Запрос, Исход.Код, Состояние, Ложь,
		?(УПоля, Исход.Применено, ?(Вид = Витрина.ВидЗагрузки(), "", Исход.Сообщение)));

КонецПроцедуры

// Автор изменения — из сессии: тихий "" дал бы анонимную строку в журнале аудита.
Функция Принципал(Знач Вердикт)

	Логин = ?(Вердикт.Пользователь = Неопределено, "", СокрЛП(Строка(Вердикт.Пользователь.Логин)));
	Если НЕ ЗначениеЗаполнено(Логин) Тогда
		ВызватьИсключение "Брендирование: правка без принципала сессии — гвард пропустил запрос"
			+ " без пользователя. Автор изменения обязателен.";
	КонецЕсли;
	Возврат Логин;

КонецФункции

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Запрос, Знач Статус, Знач Состояние, Знач Сохранено,
	Знач Ошибка = "")

	Токен = Защита.ТокенСессии(Запрос.Вердикт.Сессия);
	Секции = ВитринаДома.Секции(Новый Структура(
		"Ключ, Токен, Пользователь, Спросить, Окно, Обзор, ОткрытоеОкно, ТонкиеРаскрыты",
		КлючРаздела(), Токен, Запрос.Вердикт.Пользователь, Неопределено, Неопределено, Неопределено,
		Состояние, Ложь));

	Модель = Ответы.МодельДома(Дом, "", Дом.Разделы(КлючРаздела()),
		Ответы.УведомленияРаздела(Сохранено, Ошибка), Секции, Токен);
	Ответы.ОтдатьДом(Ответ, Модель, Запрос.Вердикт, Запрос.Куки, Статус);

КонецПроцедуры

Функция АдресРаздела()
	Возврат Дом.АдресРаздела(КлючРаздела());
КонецФункции

Функция КлючРаздела()
	Возврат "branding";
КонецФункции

#КонецОбласти

&Контроллер("/hub/settings")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардХабАдмина") _ГвардХаб,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ВитринаДомаХаба") _ВитринаДома,
	&Пластилин(Значение = "ВитринаБрендирования") _Витрина,
	&Пластилин(Значение = "ПультБрендирования") _Пульт,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	ГвардХаб = _ГвардХаб;
	Ответы = _Ответы;
	Дом = _Дом;
	ВитринаДома = _ВитринаДома;
	Витрина = _Витрина;
	Пульт = _Пульт;
	Гейт = _Гейт;
	Защита = _Защита;
	РазборФормы = _РазборФормы;
	Окна = _Окна;
	Тексты = _Тексты;

КонецПроцедуры
