// Дом «Хаб»: из каких секций и в каком порядке состоит каждый его раздел.

Перем Дом;               // ДомХаба — адреса и подписи разделов
Перем Витрина;           // ВитринаНастроек — карточки и формы из реестра
Перем ВитринаПулов;      // ВитринаПулов — раздел «Пулы»
Перем ВитринаБренда;     // ВитринаБрендирования — образец шапки со значениями, логотип и иконка
Перем Сведения;          // ВитринаСведенийХаба — секции вне реестра
Перем ВитринаХранилища;  // ВитринаХранилища — состояние хранилища словами
Перем ВитринаПробы;      // ВитринаПробыПочты — секция «отправить проверочное письмо»
Перем ВитринаПароля;     // ВитринаПарольногоВхода — секция «Вход по паролю» и окно её выключения
Перем Отборы;            // ОтборПулов — отбор раздела «Пулы» по умолчанию
Перем Состав;            // ключи разделов, которым есть что показать сверх реестра

#Область ПубличныйИнтерфейс

// Секции раздела дома «Хаб» в порядке важности: у первого раздела — новая версия хаба, если она
// вышла; значения из реестра, своё правимое раздела, тонкие крутилки под катом и в самом конце —
// то, что только показывается.
//
// Параметры:
//  Параметры - Структура:
//    * Ключ - Строка - ключ раздела;
//    * Токен - Строка - CSRF-токен сессии;
//    * Пользователь - Пользователь, Неопределено - смотрящий;
//    * Спросить - Произвольный, Неопределено - предмет вопроса, заданного пультом;
//    * Окно - Произвольный, Неопределено - витрина пульта, задавшего вопрос;
//    * Обзор - Структура, Неопределено - обстановка раздела «Пулы» (Адрес, Отбор, Окно — см.
//      ВитринаПулов.Секции); Неопределено — первая страница без окна;
//    * ОткрытоеОкно - Структура, Неопределено - окно раздела, названное адресом или вернувшееся
//      с отбитой формой (см. ОкноРаздела.Отбитое);
//    * ТонкиеРаскрыты - Булево - отбитая форма тонких крутилок вернулась в открытый кат.
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - секции раздела, узлы Кит.Секция.
//
Функция Секции(Знач Параметры) Экспорт

	Результат = Новый Массив();

	Ключ = Параметры.Ключ;
	Адрес = Дом.АдресРаздела(Ключ);
	Свои = СекцииВнеРеестра(Параметры);

	Добавить(Результат, ВопросПульта(Параметры));
	Добавить(Результат, НоваяВерсия(Ключ));
	Добавить(Результат, ЗначенияРеестра(Параметры));
	Добавить(Результат, Свои.Правка);
	Добавить(Результат, Витрина.СекцииТонких(Ключ, Адрес, Параметры.ТонкиеРаскрыты, СвоиКлючи(Ключ),
		Параметры.ОткрытоеОкно));
	Добавить(Результат, Свои.Сведения);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СекцииРаздела

// Окно подтверждения первой секцией: печатает его витрина того пульта, который задал вопрос.
Функция ВопросПульта(Знач Параметры)

	Если Параметры.Спросить = Неопределено ИЛИ Параметры.Окно = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Возврат Одна(Параметры.Окно.СекцияПодтверждения(Параметры.Спросить, Дом.АдресРаздела(Параметры.Ключ)));

КонецФункции

// Новая версия хаба — над всем первым разделом: им открывается дом, и администратор видит её сразу.
Функция НоваяВерсия(Знач Ключ)

	Если Ключ <> Дом.РазделПоУмолчанию() Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Секция = Сведения.СекцияНовойВерсии();
	Возврат ?(Секция = Неопределено, Новый Массив(), Одна(Секция));

КонецФункции

Функция ЗначенияРеестра(Знач Параметры)

	Ключ = Параметры.Ключ;

	Возврат Витрина.Секции(Ключ, Дом.ПодписьРаздела(Ключ), Дом.ЛидРаздела(Ключ), Дом.АдресРаздела(Ключ),
		Дом.ИконкаРаздела(Ключ), СвоиКлючи(Ключ), Параметры.ОткрытоеОкно);

КонецФункции

// Настройки, которые раздел печатает своей секцией, в общую форму раздела не попадают.
Функция СвоиКлючи(Знач Ключ)

	Результат = Новый Массив();
	Если Ключ = "login" Тогда
		Результат.Добавить(ВитринаПароля.КлючНастройки());
	ИначеЕсли Ключ = "branding" Тогда
		Результат = ВитринаБренда.КлючиНастроек();
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Состав дома и СвоиСекции разошлись — падаем: тихое расхождение снимает секцию с экрана.
Функция СекцииВнеРеестра(Знач Параметры)

	Ключ = Параметры.Ключ;
	Объявлен = (Состав.Найти(Ключ) <> Неопределено);
	Свои = СвоиСекции(Ключ, Параметры);

	Если Объявлен И Свои = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Витрина дома «Хаб»: раздел «%1» объявлен в составе,"
			+ " но печатать сверх реестра ему нечего.", Ключ);
	КонецЕсли;
	Если НЕ Объявлен И Свои <> Неопределено Тогда
		ВызватьИсключение СтрШаблон("Витрина дома «Хаб»: раздел «%1» печатает свои секции,"
			+ " но в составе дома не объявлен.", Ключ);
	КонецЕсли;

	Возврат ?(Свои = Неопределено, Новый Структура("Правка, Сведения", Новый Массив(), Новый Массив()), Свои);

КонецФункции

// Что раздел печатает сверх значений реестра: правимое — следом за ними, только показанное —
// в самом конце раздела; Неопределено — ничего.
Функция СвоиСекции(Знач Ключ, Знач Параметры)

	Если Ключ = "identity" Тогда
		Возврат ТолькоПоказ(Сведения.СекцияВерсии());
	ИначеЕсли Ключ = "storage" Тогда
		Возврат ТолькоПоказ(ВитринаХранилища.Секция());
	ИначеЕсли Ключ = "branding" Тогда
		Возврат Правка(ВитринаБренда.Секции(Параметры.ОткрытоеОкно));
	ИначеЕсли Ключ = "mail" Тогда
		Возврат Правка(Одна(ВитринаПробы.Секция(Дом.АдресРаздела(Ключ), АдресУчётки(Параметры.Пользователь))));
	ИначеЕсли Ключ = "login" Тогда
		Возврат Правка(Одна(ВитринаПароля.Секция(Параметры.ОткрытоеОкно, Дом.АдресРаздела(Ключ))));
	ИначеЕсли Ключ = "mirrors" Тогда
		Возврат ТолькоПоказ(Сведения.СекцияОбзораЗеркал());
	ИначеЕсли Ключ = "password" Тогда
		Возврат ТолькоПоказ(Сведения.СекцияПароля());
	ИначеЕсли Ключ = "pools" Тогда
		Возврат Правка(СекцииПулов(Параметры));
	ИначеЕсли Ключ = "maintenance" Тогда
		Возврат ТолькоПоказ(Сведения.СекцияОбслуживания());
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция Правка(Знач Секции)
	Возврат Новый Структура("Правка, Сведения", Секции, Новый Массив());
КонецФункции

Функция ТолькоПоказ(Знач Секция)
	Возврат Новый Структура("Правка, Сведения", Новый Массив(), Одна(Секция));
КонецФункции

// Основной пул словами, за ним таблица пулов: её отбор и окно приносит контроллер раздела,
// после формы значений раздела — первая страница без окна.
Функция СекцииПулов(Знач Параметры)

	Обзор = Параметры.Обзор;
	Если Обзор = Неопределено Тогда
		Обзор = Новый Структура("Адрес, Отбор, Окно", Дом.АдресРаздела("pools"), Отборы.ИзАдреса(""),
			Неопределено);
	КонецЕсли;

	Результат = Одна(Сведения.СекцияОсновногоПула());
	Добавить(Результат, ВитринаПулов.Секции(Обзор));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Куда уйдёт проверочное письмо: получателя называет учётка нажавшего, поля «кому» нет.
Функция АдресУчётки(Знач Пользователь)
	Возврат ?(Пользователь = Неопределено, "", СокрЛП(Строка(Пользователь.Email)));
КонецФункции

Функция Одна(Знач Секция)

	Результат = Новый Массив();
	Результат.Добавить(Секция);
	Возврат Результат;

КонецФункции

Процедура Добавить(Результат, Знач Части)

	Для Каждого Часть Из Части Цикл
		Результат.Добавить(Часть);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

&Прозвище("ВитринаДомаХаба")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ВитринаНастроек") _Витрина,
	&Пластилин(Значение = "ВитринаПулов") _ВитринаПулов,
	&Пластилин(Значение = "ВитринаБрендирования") _ВитринаБренда,
	&Пластилин(Значение = "ВитринаСведенийХаба") _Сведения,
	&Пластилин(Значение = "ВитринаХранилища") _ВитринаХранилища,
	&Пластилин(Значение = "ВитринаПробыПочты") _ВитринаПробы,
	&Пластилин(Значение = "ВитринаПарольногоВхода") _ВитринаПароля,
	&Пластилин(Значение = "ОтборПулов") _Отборы) Экспорт

	Дом = _Дом;
	Витрина = _Витрина;
	ВитринаПулов = _ВитринаПулов;
	ВитринаБренда = _ВитринаБренда;
	Сведения = _Сведения;
	ВитринаХранилища = _ВитринаХранилища;
	ВитринаПробы = _ВитринаПробы;
	ВитринаПароля = _ВитринаПароля;
	Отборы = _Отборы;

	Состав = Новый Массив();
	Состав.Добавить("identity");
	Состав.Добавить("storage");
	Состав.Добавить("branding");
	Состав.Добавить("mail");
	// числа репликации настраиваются здесь — отсюда же и вход в список самих зеркал
	Состав.Добавить("mirrors");
	// действующая политика словами — под её же полями: человек видит, что получилось
	Состав.Добавить("password");
	Состав.Добавить("pools");
	Состав.Добавить("maintenance");
	// парольный вход — своей формой с тумблером «сохранять сразу» и окном выключения
	Состав.Добавить("login");

КонецПроцедуры
