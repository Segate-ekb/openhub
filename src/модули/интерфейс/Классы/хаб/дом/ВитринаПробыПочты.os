// Секция раздела «Почта» дома «Хаб» с кнопкой «отправить проверочное письмо».

Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секция проверки: кнопка, которая шлёт форму, и честная строка о том, куда уйдёт письмо.
//
// Параметры:
//  Адрес - Строка - адрес раздела: на него уходит форма проверки.
//  АдресПолучателя - Строка - адрес учётной записи администратора ("" — адреса нет).
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.Секция.
//
Функция Секция(Знач Адрес, Знач АдресПолучателя) Экспорт

	Возврат Кит.Секция(Тексты.Текст("settings.hub.mail.test.title"),
			КудаУйдётПисьмо(АдресПолучателя),
			Кит.Форма(Адрес, ПолеОперации(), КнопкаПробы(ЗначениеЗаполнено(АдресПолучателя))))
		.Лид(Тексты.Текст("settings.hub.mail.test.lead")).Иконка("конверт");

КонецФункции

// Имя скрытого поля операции.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Значение операции «отправить проверочное письмо».
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеОперации() Экспорт
	Возврат "проба-почты";
КонецФункции

#КонецОбласти

#Область СодержимоеСекции

Функция ПолеОперации()
	Возврат Кит.СкрытоеПоле(ИмяПоляОперации(), ЗначениеОперации());
КонецФункции

// Без адреса учётки слать некуда: кнопка видна, но не нажимается, а строка выше говорит почему.
Функция КнопкаПробы(Знач ЕстьКуда)

	Кнопка = Кит.Кнопка(Тексты.Текст("settings.hub.mail.test.button")).Вторичная().Иконка("конверт");
	Возврат ?(ЕстьКуда, Кнопка, Кнопка.Заблокирована());

КонецФункции

// Поля «кому» на форме нет, значит адрес обязан быть виден до нажатия.
Функция КудаУйдётПисьмо(Знач АдресПолучателя)

	Если НЕ ЗначениеЗаполнено(АдресПолучателя) Тогда
		Возврат Кит.Примечание(Тексты.Текст("settings.hub.mail.test.error.noemail"));
	КонецЕсли;

	Возврат Кит.Примечание(Тексты.Шаблон("settings.hub.mail.test.note", АдресПолучателя));

КонецФункции

#КонецОбласти

&Прозвище("ВитринаПробыПочты")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;

КонецПроцедуры
