&ТочкаМаршрута("webhooks/test")
Процедура ПробаЗаведения(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	fragment = "") Экспорт

	ВыполнитьПробу(Ответ, "", fragment, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

