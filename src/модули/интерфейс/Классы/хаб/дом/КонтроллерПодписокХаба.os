// Маршруты раздела «Подписки на события» дома «Хаб»: страница с окном по адресу, заведение,
// правка, получатели, пробная отправка, предпросмотр, включение и удаление подписок, спойлер
// «Настройки доставки» на том же экране. Каждая дверь — за гвардом администратора хаба.

Перем ГвардХаб;        // ГвардХабАдмина
Перем Ответы;          // ОтветыНастроек
Перем Дом;             // ДомХаба
Перем Витрина;         // ВитринаПодписок
Перем Доставка;        // ВитринаДоставки — спойлер «Настройки доставки»
Перем ВитринаЗначений; // ВитринаНастроек — введённое руками в настройках доставки
Перем ПультЗначений;   // ПультЗначенийНастроек — запись настроек доставки
Перем Ход;             // ХодПодписок — общий ход раздела подписок
Перем Гейт;            // ГейтФормы — метод запроса и токен формы спойлера
Перем Окна;            // ОкноРаздела — ответ удачной формы
Перем Защита;          // ЗащитаCSRF (вход) — токен для форм страницы
Перем СервисПодписок;  // СервисПодписок (подписки)
Перем Тексты;          // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ТочкиМаршрута

// Точка маршрута «webhooks»: GET — страница раздела, POST — заведение подписки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: <вид>-<ключ> (необязательный, по умолчанию "").
//
&ТочкаМаршрута("webhooks")
Процедура Раздел(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, saved = "", окно = "") Экспорт

	Контекст = Подготовить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПоАдресу(Контекст, окно, saved), КукиЗапроса);
		Возврат;
	КонецЕсли;
	ОтдатьРаздел(Ответ, Контекст, Ход.ПоказЗаведения(Ответ, Контекст, ОписаниеРаздела(), КукиЗапроса,
		МетодЗапроса, ТелоЗапроса), КукиЗапроса);

КонецПроцедуры

// Точка маршрута «webhooks/{id}/save» — форма окна «Изменить».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("webhooks/{id}/save")
Процедура Сохранение(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = Подготовить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПравки(Ответ, Контекст, ОписаниеРаздела(), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «webhooks/{id}/toggle» — тумблер записи.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("webhooks/{id}/toggle")
Процедура Переключение(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = Подготовить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПереключения(Ответ, Контекст, ОписаниеРаздела(), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «webhooks/{id}/delete». Без поля подтверждения подписка не удаляется: ответ ведёт
// на страницу с открытым подтверждением.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("webhooks/{id}/delete")
Процедура Удаление(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = Подготовить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказУдаления(Ответ, Контекст, ОписаниеРаздела(), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «webhooks/{id}/recipients» — дверь окна «Получатели»: GET — раздел с окном на всём
// дереве, странице ветки или найденном; POST — правки окна.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  найти - Строка - строка поиска окна (необязательный, по умолчанию "").
//  ветка - Строка - ключ ветки, чья страница показана (необязательный, по умолчанию "").
//  страница - Строка - номер страницы ветки с единицы (необязательный, по умолчанию "").
//
&ТочкаМаршрута("webhooks/{id}/recipients")
Процедура Получатели(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, найти = "",
	ветка = "", страница = "") Экспорт

	Контекст = Подготовить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПолучателей(Ответ, Контекст, ОписаниеРаздела(), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id, Ход.ВидДерева(найти, ветка, страница)), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «webhooks/{id}/test» — пробная отправка: полями окна правки, без сохранения,
// а без полей окна — сохранёнными настройками.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  fragment - Строка - непустое: ответ кусочком для скрипта страницы, а не страницей
//             (необязательный, по умолчанию "").
//
&ТочкаМаршрута("webhooks/{id}/test")
Процедура ПробнаяОтправка(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	fragment = "") Экспорт

	Контекст = Подготовить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПробы(Ответ, Контекст, ОписаниеРаздела(), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id, fragment), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «webhooks/test» — пробная отправка полями окна «Новая подписка», без сохранения.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  fragment - Строка - непустое: ответ кусочком для скрипта страницы (необязательный, по умолчанию "").
//
&ТочкаМаршрута("webhooks/test")
Процедура ПробаЗаведения(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	fragment = "") Экспорт

	ПробнаяОтправка(Ответ, "", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, fragment);

КонецПроцедуры

// Точка маршрута «webhooks/preview» — уведомление по полям окна «Новая подписка», без сохранения.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  fragment - Строка - непустое: ответ кусочком для скрипта страницы (необязательный, по умолчанию "").
//
&ТочкаМаршрута("webhooks/preview")
Процедура ПредпросмотрЗаведения(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	fragment = "") Экспорт

	ПредпросмотрПравки(Ответ, "", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, fragment);

КонецПроцедуры

// Точка маршрута «webhooks/{id}/preview» — уведомление по полям окна правки, без сохранения.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  fragment - Строка - непустое: ответ кусочком для скрипта страницы (необязательный, по умолчанию "").
//
&ТочкаМаршрута("webhooks/{id}/preview")
Процедура ПредпросмотрПравки(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	fragment = "") Экспорт

	Контекст = Подготовить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст <> Неопределено Тогда
		ОтдатьРаздел(Ответ, Контекст, Ход.ПоказПредпросмотра(Ответ, Контекст, ОписаниеРаздела(), КукиЗапроса,
			МетодЗапроса, ТелоЗапроса, id, fragment), КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

// Точка маршрута «webhooks/delivery» — единственная дорога записи настроек доставки: форма спойлера
// «Настройки доставки» и формы сброса введённого руками. Удача — 303 на раздел, отказ — тот же
// раздел с раскрытым спойлером и причиной; операция не из белого списка — «Страница устарела».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("webhooks/delivery")
Процедура НастройкиДоставки(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = Подготовить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Форма = Гейт.ПринятаяФорма(Ответ, Контекст, "POST", МетодЗапроса, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// белый список: форма спойлера операции не несёт, форма сброса несёт «сбросить»; прочее — чужая
	// форма или старая вкладка
	Операция = Форма.Получить(ВитринаЗначений.ИмяПоляОперации());
	Кто = Строка(Контекст.Пользователь.Логин);
	Отбитая = Неопределено;
	Если Операция = Неопределено Тогда
		// отказ значения — под его полем с набранным на месте; над разделом — что из формы применено
		Исход = ПультЗначений.Применить(Доставка.Раздел(), Форма, Кто);
		Проблема = Исход.Применено;
		Если ЗначениеЗаполнено(Исход.Сообщение) Тогда
			Отбитая = Окна.Отбитое(ВитринаЗначений.ВидОтбитыхЗначений(), Доставка.Раздел(), Форма, Исход.Отказы);
		Иначе
			Проблема = "";
		КонецЕсли;
	ИначеЕсли НРег(СокрЛП(Операция)) = ВитринаЗначений.ОперацияСброса() Тогда
		Проблема = ПультЗначений.Сбросить(Доставка.Раздел(), Форма, Кто).Сообщение;
	Иначе
		Проблема = Тексты.Текст("subscriptions.error.stale");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Проблема) Тогда
		Окна.ВернутьВРаздел(Ответ, АдресРаздела());
		Возврат;
	КонецЕсли;

	Показ = Ход.Показ(Контекст);
	Показ.Ошибка = Проблема;
	Показ.ДоставкаРаскрыта = Истина;
	Показ.Статус = 400;
	ОтдатьРаздел(Ответ, Контекст, Показ, КукиЗапроса, Отбитая);

КонецПроцедуры

#КонецОбласти

#Область ОбщаяЛогика

Функция Подготовить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)
	Вердикт = ГвардХаб.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Возврат ?(Вердикт.Разрешено, Вердикт, Неопределено);
КонецФункции

// Чьи это подписки и по какому адресу живёт раздел — всё, что ход о доме знает.
Функция ОписаниеРаздела()
	Возврат Ход.ОписаниеРаздела(СервисПодписок.ОбъектХаба(), АдресРаздела());
КонецФункции

Функция АдресРаздела()
	Возврат Дом.АдресРаздела("webhooks");
КонецФункции

#КонецОбласти

#Область Рендер

// Пустой показ: ход уже ответил сам — отбил форму, не нашёл подписку либо увёл редиректом.
// Отбитая — форма «Настроек доставки», вернувшаяся с отказом значения.
Процедура ОтдатьРаздел(Ответ, Знач Контекст, Знач Показ, Знач КукиЗапроса, Знач Отбитая = Неопределено)

	Если Показ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Токен = Защита.ТокенСессии(Контекст.Сессия);
	Модель = Ответы.МодельДома(Дом, "", Дом.Разделы("webhooks"), Ход.Уведомления(Показ),
		Секции(Показ, Токен, Отбитая), Токен);
	Ответы.ОтдатьДом(Ответ, Модель, Контекст, КукиЗапроса, Показ.Статус);

КонецПроцедуры

// Подписки хаба со спойлером доставки под списком; введённое руками в настройках доставки —
// своей секцией сброса, её формы уходят в ту же дверь «webhooks/delivery» и возвращают сюда.
Функция Секции(Знач Показ, Знач Токен, Знач Отбитая)

	// за гвардом хаб-админа иначе не бывает
	Результат = Витрина.Секции(Ход.ПараметрыВитрины(Показ, ОписаниеРаздела(), Токен,
		Тексты.Текст("subscriptions.hub.lead"), Истина, "",
		Доставка.Спойлер(АдресРаздела() + "/delivery", Показ.ДоставкаРаскрыта, Отбитая)));
	Для Каждого Секция Из ВитринаЗначений.СекцииСброса(Доставка.Раздел(), АдресРаздела() + "/delivery") Цикл
		Результат.Добавить(Секция);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Контроллер("/hub/settings")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардХабАдмина") _ГвардХаб,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "ВитринаПодписок") _Витрина,
	&Пластилин(Значение = "ВитринаДоставки") _Доставка,
	&Пластилин(Значение = "ВитринаНастроек") _ВитринаЗначений,
	&Пластилин(Значение = "ПультЗначенийНастроек") _ПультЗначений,
	&Пластилин(Значение = "ХодПодписок") _Ход,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
