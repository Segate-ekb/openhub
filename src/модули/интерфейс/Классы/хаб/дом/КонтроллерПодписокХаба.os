// Маршруты раздела «Подписки на события» дома «Хаб»: список, заведение, правка, получатели,
// пробная отправка, включение и удаление подписок, блок «Доставка» на том же экране.

Перем ГвардХаб;        // ГвардХабАдмина
Перем Ответы;          // ОтветыНастроек
Перем Дом;             // ДомХаба
Перем Витрина;         // ВитринаПодписок
Перем ВитринаЗначений; // ВитринаНастроек — блок «Доставка» на этом же экране
Перем Ход;             // ХодПодписок — общий ход раздела подписок
Перем Проверка;        // ПроверкаПодпискиДоСохранения — страница предпросмотра
Перем Защита;          // ЗащитаCSRF (вход) — токен для форм страницы
Перем СервисПодписок;  // СервисПодписок (подписки)
Перем Тексты;          // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Бланки;          // БланкРаздела — адрес и токен блока «Доставка»

#Область ТочкиМаршрута

// Точка маршрута «webhooks» (GET, POST).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  kind - Строка - тип действия, поля которого показывает форма заведения
//         (необязательный, по умолчанию "").
//  recipients - Строка - подписка, чьё дерево получателей открыто (необязательный, по умолчанию "").
//  find - Строка - поиск пакета в открытом дереве (необязательный, по умолчанию "").
//
&ТочкаМаршрута("webhooks")
Процедура Раздел(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, kind = "",
	recipients = "", find = "") Экспорт

	Контекст = Подготовить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Показ = Ход.ПоказПоЗапросу(Ответ, Контекст, ОписаниеРаздела(), КукиЗапроса,
		МетодЗапроса, ТелоЗапроса, kind, recipients, find);
	ОтдатьРаздел(Ответ, Контекст, Показ, КукиЗапроса);

КонецПроцедуры

// Точка маршрута «webhooks/{id}/delete».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("webhooks/{id}/delete")
Процедура Удаление(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьДействие(Ответ, id, "удалить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «webhooks/{id}/save» — сохранение правки подписки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("webhooks/{id}/save")
Процедура Сохранение(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьДействие(Ответ, id, "сохранить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «webhooks/{id}/recipients» — галки дерева получателей подписки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("webhooks/{id}/recipients")
Процедура Получатели(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Контекст = Подготовить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Контекст = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Показ = Ход.ПоказПоДереву(Ответ, Контекст, ОписаниеРаздела(), КукиЗапроса,
		МетодЗапроса, ТелоЗапроса, id);
	ОтдатьРаздел(Ответ, Контекст, Показ, КукиЗапроса);

КонецПроцедуры

// Точка маршрута «webhooks/{id}/test» — пробная отправка подписки:
// настройками формы правки, ничего не сохраняя, а без формы — сохранёнными.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  fragment - Строка - непустое: ответ кусочком для скрипта страницы, а не страницей
//             (необязательный, по умолчанию "").
//
&ТочкаМаршрута("webhooks/{id}/test")
Процедура ПробнаяОтправка(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	fragment = "") Экспорт

	ВыполнитьПробу(Ответ, id, fragment, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «webhooks/{id}/toggle».
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("webhooks/{id}/toggle")
Процедура Переключение(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	ВыполнитьДействие(Ответ, id, "переключить", ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса);

КонецПроцедуры

// Точка маршрута «webhooks/test» — пробная отправка настройками формы заведения, без сохранения.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
