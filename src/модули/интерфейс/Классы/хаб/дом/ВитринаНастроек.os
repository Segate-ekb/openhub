// Секции раздела дома «Хаб» из карточек реестра настроек: правка значений одной формой, тонкие
// крутилки — своей формой под катом, введённое руками — списком со сбросом.

Перем Настройки;         // СервисНастроек (настройки) — карточки и источники значений
Перем Разделы;           // РазделыНастроекХаба (настройки) — раздел ключа
Перем Раскладка;         // РаскладкаНастроекХаба — ярус настройки и кат раздела
Перем Поля;              // ПоляНастроек — карточка в разметке
Перем Кит;               // Кит (кит) — фабрика элементов экрана
Перем Тексты;            // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Раздел дома «Хаб», в котором показывается настройка.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - ключ раздела дома («identity», «login», …).
//
Функция РазделКлюча(Знач Ключ) Экспорт
	Возврат Разделы.РазделКлюча(Ключ);
КонецФункции

// Ключ словаря для метки/подсказки настройки.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//  Роль - Строка - «label» либо «hint».
//
// Возвращаемое значение:
//  Строка - ключ словаря вида «settings.key.oshub-storage-root.label».
//
Функция КлючТекста(Знач Ключ, Знач Роль) Экспорт
	Возврат Поля.КлючТекста(Ключ, Роль);
КонецФункции

// Карточки настроек раздела в порядке реестра.
//
// Параметры:
//  Раздел - Строка - ключ раздела дома.
//
// Возвращаемое значение:
//  Массив из Структура - карточки СервисНастроек.
//
Функция КарточкиРаздела(Знач Раздел) Экспорт

	Результат = Новый Массив();
	Для Каждого Настройка Из Настройки.Карточки() Цикл
		Если РазделКлюча(Настройка.Ключ) = Раздел Тогда
			Результат.Добавить(Настройка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Редактируемые карточки раздела (прикладные и не форсированные конфигом).
//
// Параметры:
//  Раздел - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Массив - карточки, доступные правке из UI.
//
Функция РедактируемыеРаздела(Знач Раздел) Экспорт

	Результат = Новый Массив();
	Для Каждого Настройка Из КарточкиРаздела(Раздел) Цикл
		Если Настройка.Редактируемая Тогда
			Результат.Добавить(Настройка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Карточки раздела, которым место на экране: прикладные — и правимые, и занятые
// конфигурацией. Значение инсталляции сюда не попадает: чужая ручка не показывается.
//
// Параметры:
//  Раздел - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Массив - карточки, которые печатает экран раздела.
//
Функция ПоказываемыеРаздела(Знач Раздел) Экспорт

	Результат = Новый Массив();
	Для Каждого Настройка Из КарточкиРаздела(Раздел) Цикл
		Если Настройка.Редактируемая ИЛИ Настройка.Форсирована Тогда
			Результат.Добавить(Настройка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Принимает ли раздел POST: только если в нём есть хоть одно редактируемое значение.
//
// Параметры:
//  Раздел - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Булево - принимает ли раздел POST.
//
Функция ПринимаетИзменения(Знач Раздел) Экспорт
	Возврат РедактируемыеРаздела(Раздел).Количество() > 0;
КонецФункции

// Имя поля формы для настройки — одна точка на рендер и на разбор.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - имя поля формы для настройки.
//
Функция ИмяПоля(Знач Ключ) Экспорт
	Возврат Поля.ИмяПоля(Ключ);
КонецФункции

// Имя скрытого поля с операцией раздела («» — сохранение, «сбросить» — уборка записи).
//
// Возвращаемое значение:
//  Строка - имя скрытого поля с операцией раздела.
//
Функция ИмяПоляОперации() Экспорт
	Возврат Поля.ИмяПоляОперации();
КонецФункции

// Имя скрытого поля с ключом настройки (операция «сбросить»).
//
// Возвращаемое значение:
//  Строка - имя скрытого поля с ключом настройки.
//
Функция ИмяПоляКлюча() Экспорт
	Возврат Поля.ИмяПоляКлюча();
КонецФункции

// Значение операции «сбросить введённое руками значение».
//
// Возвращаемое значение:
//  Строка - значение операции «сбросить введённое руками значение».
//
Функция ОперацияСброса() Экспорт
	Возврат Поля.ОперацияСброса();
КонецФункции

// Значение тумблера «включено» (его же читает РазборФормы.Флажок).
//
// Возвращаемое значение:
//  Строка - значение тумблера «включено».
//
Функция ЗначениеВключено() Экспорт
	Возврат Поля.ЗначениеВключено();
КонецФункции

// Действующее значение в форме, пригодной для сравнения с вводом: неизменённое не пишется.
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//
// Возвращаемое значение:
//  Строка - действующее значение в форме, пригодной для сравнения с вводом.
//
Функция ЗначениеДляСравнения(Знач Карточка) Экспорт
	Возврат Поля.ЗначениеДляСравнения(Карточка);
КонецФункции

// Человеческая метка настройки из словаря.
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//
// Возвращаемое значение:
//  Строка - человеческая метка настройки из словаря.
//
Функция Метка(Знач Карточка) Экспорт
	Возврат Поля.Метка(Карточка);
КонецФункции

// Значения раздела из реестра — одной формой с одной панелью сохранения под именем раздела.
//
// Параметры:
//  Раздел - Строка - ключ раздела дома.
//  Подпись - Строка - название раздела: им названа секция значений.
//  Лид - Строка - пояснение раздела одной строкой ("" — пояснения нет).
//  Адрес - Строка - адрес, на который уходит форма.
//  Иконка - Строка - иконка раздела у заголовка секции (необязательный, по умолчанию "шестерёнка").
//  Кроме - Массив из Строка - ключи, которые раздел печатает своей формой (необязательный,
//          по умолчанию Неопределено — все значения раздела в общей форме).
//  Отбитая - Структура, Неопределено - вернувшаяся с отказом форма значений раздела (см.
//            ОкноРаздела.Отбитое, вид ВидОтбитыхЗначений): набранное и отказ под полем; другое
//            состояние раздела полей не касается (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - одна секция либо ни одной, если раздел значений не показывает.
//
Функция Секции(Знач Раздел, Знач Подпись, Знач Лид, Знач Адрес, Знач Иконка = "шестерёнка",
	Знач Кроме = Неопределено, Знач Отбитая = Неопределено) Экспорт

	Результат = Новый Массив();
	Голова = Раскладка.Разложить(БезСвоих(ПоказываемыеРаздела(Раздел), Кроме)).Голова;
	Если Голова.Количество() > 0 Тогда
		Результат.Добавить(СекцияЗначений(Подпись, Лид, Иконка, Голова, Адрес,
			СвояОтбитая(Отбитая, Раздел, Ложь)));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Вид состояния раздела «форма значений вернулась с отказом».
//
// Возвращаемое значение:
//  Строка.
//
Функция ВидОтбитыхЗначений() Экспорт
	Возврат "значения";
КонецФункции

// Тонкие крутилки раздела — своей формой под катом; экран печатает их после всего, что правится
// в разделе, и перед тем, что только показывается.
//
// Параметры:
//  Раздел - Строка - ключ раздела дома.
//  Адрес - Строка - адрес, на который уходит форма.
//  Раскрыта - Булево - кат открыт: в него вернулась отбитая форма (необязательный, по умолчанию Ложь).
//  Кроме - Массив из Строка - ключи, которые раздел печатает своей формой (необязательный,
//          по умолчанию Неопределено).
//  Отбитая - Структура, Неопределено - вернувшаяся с отказом форма значений (см. Секции).
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - одна секция либо ни одной.
//
Функция СекцииТонких(Знач Раздел, Знач Адрес, Знач Раскрыта = Ложь, Знач Кроме = Неопределено,
	Знач Отбитая = Неопределено) Экспорт

	Результат = Новый Массив();
	Хвост = Раскладка.Разложить(БезСвоих(ПоказываемыеРаздела(Раздел), Кроме)).Хвост;
	Если Хвост.Количество() > 0 Тогда
		Результат.Добавить(СекцияТонких(Хвост, Адрес, Раскрыта, СвояОтбитая(Отбитая, Раздел, Истина)));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Пришло ли в форме значение тонкой крутилки раздела: отбитая форма тонких возвращается в открытый кат.
//
// Параметры:
//  Раздел - Строка - ключ раздела дома.
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Булево.
//
Функция ФормаТонких(Знач Раздел, Знач Форма) Экспорт

	Для Каждого Настройка Из Раскладка.Разложить(ПоказываемыеРаздела(Раздел)).Хвост Цикл
		Если Форма.Получить(ИмяПоля(Настройка.Ключ)) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Введённое руками в разделе — списком со сбросом каждого значения; печатается последним на экране
// раздела: нужно редко.
//
// Параметры:
//  Раздел - Строка - ключ раздела дома.
//  Адрес - Строка - адрес, на который уходят формы сброса.
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - одна секция либо ни одной, если руками ничего не введено.
//
Функция СекцииСброса(Знач Раздел, Знач Адрес) Экспорт

	Результат = Новый Массив();
	ИзБазы = ВведённыеВручную(Раздел);
	Если ИзБазы.Количество() > 0 Тогда
		Результат.Добавить(СекцияСброса(ИзБазы, Адрес));
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Секции

// Значения раздела — одна форма и одна панель сохранения; где править нечего, формы нет:
// слать ей нечего, и кнопка солгала бы.
Функция СекцияЗначений(Знач Подпись, Знач Лид, Знач Иконка, Знач Карточки, Знач Адрес, Знач Отбитая)

	Секция = Кит.Секция(Подпись).Иконка(Иконка)
		.Лид(?(ЕстьПравка(Карточки), Лид, Тексты.Текст("settings.values.occupied.lead")));
	Возврат Наполнить(Секция, Карточки, Адрес, Отбитая);

КонецФункции

// Тонкие крутилки раздела — те же поля, но под катом: их меняют, когда об этом просит нагрузка.
// Под кат уходит только форма; занятые конфигурацией крутилки прятать незачем — править их нечем.
Функция СекцияТонких(Знач Карточки, Знач Адрес, Знач Раскрыта, Знач Отбитая)

	Секция = Наполнить(Кит.Секция(Тексты.Текст("settings.hub.fine.title")).Иконка("палочка")
		.Лид(Тексты.Текст("settings.hub.fine.lead")), Карточки, Адрес, Отбитая);
	Если НЕ ЕстьПравка(Карточки) Тогда
		Возврат Секция;
	КонецЕсли;
	Возврат Секция.Свёрнута(Тексты.Текст("settings.hub.fine.toggle")).Раскрыта(Раскрыта);

КонецФункции

Функция Наполнить(Знач Секция, Знач Карточки, Знач Адрес, Знач Отбитая)

	Для Каждого Настройка Из Карточки Цикл
		Секция.Добавить(?(Настройка.Редактируемая,
			Поля.ПолеПравки(Настройка, Ложь, Отбитая), Поля.ПолеЗанятое(Настройка)));
	КонецЦикла;

	Если ЕстьПравка(Карточки) Тогда
		Секция.Форма(Адрес).ПояснениеПанели(Тексты.Текст("settings.values.editable.note"));
	КонецЕсли;
	Возврат Секция;

КонецФункции

// Отбитая форма значений достаётся той форме раздела, которая её прислала: значениям или тонким
// крутилкам. Окно раздела и форма другого вида полей не касаются.
Функция СвояОтбитая(Знач Отбитая, Знач Раздел, Знач Тонких)
	Если Отбитая = Неопределено ИЛИ Отбитая.Вид <> ВидОтбитыхЗначений()
		ИЛИ ФормаТонких(Раздел, Отбитая.Набранное) <> Тонких Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Отбитая;
КонецФункции

Функция БезСвоих(Знач Карточки, Знач Кроме)

	Если Кроме = Неопределено Тогда
		Возврат Карточки;
	КонецЕсли;

	Результат = Новый Массив();
	Для Каждого Настройка Из Карточки Цикл
		Если Кроме.Найти(Настройка.Ключ) = Неопределено Тогда
			Результат.Добавить(Настройка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЕстьПравка(Знач Карточки)

	Для Каждого Настройка Из Карточки Цикл
		Если Настройка.Редактируемая Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ВведённыеВручную(Знач Раздел)

	Результат = Новый Массив();
	Для Каждого Настройка Из КарточкиРаздела(Раздел) Цикл
		Если Настройка.Редактируемая И Настройка.Источник = "база" Тогда
			Результат.Добавить(Настройка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Сброс введённых руками значений: у каждого своя форма, вложенных форм в HTML не бывает.
Функция СекцияСброса(Знач Карточки, Знач Адрес)

	Строки = Новый Массив();
	Для Каждого Настройка Из Карточки Цикл
		Строки.Добавить(Новый Структура("setting, value, reset", Поля.Метка(Настройка),
			Кит.Код(Поля.ЗначениеТекстом(Настройка)), ФормаСброса(Адрес, Настройка.Ключ)));
	КонецЦикла;

	Таблица = Кит.Таблица(Строки).Вид("карточками");
	Таблица.Колонка("setting", Тексты.Текст("settings.values.reset.col.setting"));
	Таблица.Колонка("value", Тексты.Текст("settings.values.reset.col.value"));
	Таблица.Колонка("reset", Тексты.Текст("settings.values.reset.col.action")).БезПодписиВЗаписи();

	Возврат Кит.Секция(Тексты.Текст("settings.values.reset.title"), Таблица).Иконка("история")
		.Лид(Тексты.Текст("settings.values.reset.lead"));

КонецФункции

Функция ФормаСброса(Знач Адрес, Знач Ключ)

	Возврат Кит.Форма(Адрес,
		Кит.СкрытоеПоле(ИмяПоляОперации(), ОперацияСброса()),
		Кит.СкрытоеПоле(ИмяПоляКлюча(), Ключ),
		Кит.Кнопка(Тексты.Текст("settings.values.reset.button")).Вторичная().Малая().Иконка("история"));

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "РазделыНастроекХаба") _Разделы,
	&Пластилин(Значение = "РаскладкаНастроекХаба") _Раскладка,
	&Пластилин(Значение = "ПоляНастроек") _Поля,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Настройки = _Настройки;
	Разделы = _Разделы;
	Раскладка = _Раскладка;
	Поля = _Поля;
	Кит = _Кит;
	Тексты = _Тексты;

КонецПроцедуры
