// Секции разделов дома «Хаб», править в которых нечего: новая версия хаба, сборка, основной пул,
// требования к паролю, счётчики обслуживания и дорога к обзору зеркал.

Перем Кит;                 // Кит (кит) — фабрика элементов экрана
Перем ОписаниеПриложения;  // ОписаниеПриложения (настройки) — версии хаба и его библиотек
Перем СервисПулов;         // СервисПулов (реестр)
Перем ПолитикаПароля;      // ПолитикаПароля (вход)
Перем Пользователи;        // СервисПользователей (вход)
Перем АдресаКабинета;      // АдресаКабинета — адрес сводки зеркал
Перем Тексты;              // ТекстыИнтерфейса (кит)
Перем Выпуски;             // ВыпускиХаба (состояние) — что известно о новой версии

#Область ПубличныйИнтерфейс

// Секция «Новая версия хаба»: у источника выпусков вышла версия новее своей — какая, какая у этого
// хаба и где о ней прочесть. Берёт отметку последней проверки и в сеть не ходит.
//
// Возвращаемое значение:
//  ЭлементЭкрана, Неопределено - узел Кит.Секция; Неопределено — новой версии нет, проверка
//  выключена или последняя не удалась.
//
Функция СекцияНовойВерсии() Экспорт

	Сведения = Выпуски.Сведения();
	Если НЕ Сведения.Доступна Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Секция(Тексты.Текст("settings.hub.release.title"),
			Кит.Примечание(Кит.Шаблон(Тексты.Текст("settings.hub.release.available"),
				Кит.Плашка(Кит.Текст(Сведения.Новая)).Вид("accent"), Кит.Код(Сведения.Своя))))
		.Иконка("пакет")
		.Действия(Кит.Кнопка(Тексты.Текст("settings.hub.release.open")).Адрес(Сведения.Страница)
			.ВНовойВкладке().Вторичная().Иконка("ссылка"));

КонецФункции

// Секция «Сборка»: версия хаба с копированием и версии библиотек, на которых он собран.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.Секция.
//
Функция СекцияВерсии() Экспорт

	Возврат Кит.Секция(Тексты.Текст("settings.hub.version.title"),
			Кит.Свойства(
				Кит.Свойство(Тексты.Текст("settings.hub.version.hub"),
					Кит.Код(ОписаниеПриложения.Версия())).Копируемое(),
				Библиотека(Тексты.Текст("settings.hub.version.autumn"), "autumn"),
				Библиотека(Тексты.Текст("settings.hub.version.winow"), "winow"),
				Библиотека(Тексты.Текст("settings.hub.version.kit"), "oscript-ui")))
		.Иконка("инфо");

КонецФункции

// Секция основного пула: только показ, основной пул — признак на самом пуле, а не запись реестра.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.Секция.
//
Функция СекцияОсновногоПула() Экспорт

	Возврат Кит.Секция(Тексты.Текст("settings.hub.pools.main.title"),
			Кит.Свойства(Кит.Свойство(Тексты.Текст("settings.hub.pools.main.label"), ИмяОсновногоПула())
				.Примечание(Тексты.Текст("settings.hub.pools.main.hint"))))
		.Лид(Тексты.Текст("settings.hub.pools.main.lead")).Иконка("куб");

КонецФункции

// Секция действующих требований к паролю — под полями политики: видно, что получилось.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.Секция.
//
Функция СекцияПароля() Экспорт

	Возврат Кит.Секция(Тексты.Текст("settings.hub.password.title"), ТребованияКПаролю())
		.Лид(Тексты.Текст("settings.hub.password.lead")).Иконка("замок");

КонецФункции

// Секция-дорога к обзору зеркал всех пулов: у обзора свой адрес и нет пункта в дереве разделов.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.Секция.
//
Функция СекцияОбзораЗеркал() Экспорт

	Возврат Кит.Секция(Тексты.Текст("settings.hub.mirrors.overview.title"))
		.Лид(Тексты.Текст("settings.hub.mirrors.overview.lead")).Иконка("копировать")
		.Действия(Кит.Кнопка(Тексты.Текст("settings.hub.mirrors.overview.button"))
			.Адрес(АдресаКабинета.Зеркала()).Вторичная().Иконка("копировать"));

КонецФункции

// Секция счётчиков обслуживания.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.Секция.
//
Функция СекцияОбслуживания() Экспорт

	Возврат Кит.Секция(Тексты.Текст("settings.hub.metrics.title"),
			Кит.Свойства(
				Кит.Свойство(Тексты.Текст("settings.hub.maintenance.row.users"),
					Тексты.ЧислоТекстом(Пользователи.ВсегоПользователей())),
				Кит.Свойство(Тексты.Текст("settings.hub.maintenance.row.pools"),
					Тексты.ЧислоТекстом(СервисПулов.КоличествоПулов()))))
		.Иконка("шестерёнка");

КонецФункции

#КонецОбласти

#Область Значения

// Версия библиотеки — как её называет packagedef хаба; значением — узлом текста, как и прочие данные файла.
Функция Библиотека(Знач Подпись, Знач ИмяПакета)
	Возврат Кит.Свойство(Подпись, Кит.Текст(ОписаниеПриложения.ВерсияЗависимости(ИмяПакета)));
КонецФункции

// Пул, в который попадает пакет, не назвавший пула. Его может не быть вовсе.
Функция ИмяОсновногоПула()

	Основной = СервисПулов.ДефолтныйПул();
	// имя пула — данные человека: узлом текста, а не строкой, которую кит может принять за вид
	Возврат Кит.Текст(?(Основной = Неопределено, Тексты.Текст("settings.hub.pools.main.none"),
		Строка(Основной.Имя)));

КонецФункции

Функция ТребованияКПаролю()

	Список = Кит.Список().Вид("сноска");
	Для Каждого Требование Из ПолитикаПароля.Требования() Цикл
		Список.Добавить(Кит.Пункт(Кит.Текст(Требование)));
	КонецЦикла;
	Возврат Список;

КонецФункции

#КонецОбласти

&Прозвище("ВитринаСведенийХаба")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОписаниеПриложения") _ОписаниеПриложения,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ПолитикаПароля") _ПолитикаПароля,
	&Пластилин(Значение = "СервисПользователей") _Пользователи,
	&Пластилин(Значение = "АдресаКабинета") _АдресаКабинета,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ВыпускиХаба") _Выпуски) Экспорт

	Кит = _Кит;
	ОписаниеПриложения = _ОписаниеПриложения;
	СервисПулов = _СервисПулов;
	ПолитикаПароля = _ПолитикаПароля;
	Пользователи = _Пользователи;
	АдресаКабинета = _АдресаКабинета;
	Тексты = _Тексты;
	Выпуски = _Выпуски;

КонецПроцедуры
