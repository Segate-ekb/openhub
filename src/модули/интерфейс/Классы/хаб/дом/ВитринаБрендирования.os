// Раздел «Брендирование» дома «Хаб»: название, подпись, тема, пресет и акцент инсталляции одной
// формой с образцом шапки, который меняется по мере ввода; логотип и иконка сайта — слотами картинки,
// которые уходят сразу. Имена полей и виды состояний объявлены здесь — их читает ПультБрендирования.

Перем Кит;        // Кит (кит) — фабрика элементов экрана
Перем Тексты;     // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Дом;        // ДомХаба — подпись, значок и пояснение раздела
Перем Настройки;  // СервисНастроек (настройки) — карточки значений раздела
Перем Поля;       // ПоляНастроек — метка, плашка источника, сброс и занятое поле карточки
Перем Активы;     // СервисБрендовыхАктивов (настройки) — ключи, потолок и сведения о загруженном
Перем Бренд;      // Брендирование — действующие знак и подпись, адреса загруженных картинок
Перем Фирменные;  // АдресаСтатики — картинки из поставки
Перем Токены;     // ТокеныТемы (кит) — пресеты темы и цвет акцента, годный для образца
Перем Объёмы;     // ОбъёмТекстом (основа) — размер файла словами
Перем Даты;       // ДатаЧеловеку — дата загрузки
Перем Окна;       // ОкноРаздела — открытое подтверждение и отбитая форма
Перем Объявления; // Массив из Структура (Имя, Ключ, Вид, ПоУмолчанию) — поля формы значений в порядке экрана

#Область ПубличныйИнтерфейс

// Секции раздела: значения с образцом шапки одной формой, затем логотип и иконка.
//
// Параметры:
//  Состояние - Структура, Неопределено - состояние раздела (см. ОкноРаздела.Отбитое): отбитая
//              форма значений, отказ загрузки под слотом или открытое подтверждение возврата.
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - узлы Кит.Секция.
//
Функция Секции(Знач Состояние) Экспорт

	Результат = Новый Массив();
	Результат.Добавить(СекцияЗначений(Состояние));
	Результат.Добавить(СекцияКартинок(Состояние));
	Возврат Результат;

КонецФункции

// Поля формы значений: имя поля, ключ настройки и вид управления, в порядке экрана.
//
// Возвращаемое значение:
//  Массив из Структура - Имя (Строка), Ключ (Строка), Вид («текст» | «тумблер» | «тема» | «пресет»
//                       | «цвет»), ПоУмолчанию (Строка - что действует при пустом поле; "" — у нетекстовых).
//
Функция ПоляЗначений() Экспорт
	Возврат Объявления;
КонецФункции

// Ключи настроек, которые раздел печатает своей формой, а не общей формой дома.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция КлючиНастроек() Экспорт

	Результат = Новый Массив();
	Для Каждого Объявление Из Объявления Цикл
		Результат.Добавить(Объявление.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Вид состояния «форма значений вернулась с отказом».
//
// Возвращаемое значение:
//  Строка.
//
Функция ВидЗначений() Экспорт
	Возврат "значения";
КонецФункции

// Вид состояния «загрузка картинки отбита»: ключ состояния — ключ слота.
//
// Возвращаемое значение:
//  Строка.
//
Функция ВидЗагрузки() Экспорт
	Возврат "загрузка";
КонецФункции

// Вид окна подтверждения «Вернуть стандартную» в адресе раздела: ?окно=вернуть-<слот>.
//
// Возвращаемое значение:
//  Строка.
//
Функция ВидВозврата() Экспорт
	Возврат "вернуть";
КонецФункции

// Метка картинки для подписи слота и отказов.
//
// Параметры:
//  Слот - Строка - ключ картинки (СервисБрендовыхАктивов.Ключи).
//
// Возвращаемое значение:
//  Строка.
//
Функция Метка(Знач Слот) Экспорт

	Если Слот = Активы.КлючИконки() Тогда
		Возврат Тексты.Текст("settings.hub.branding.assets.favicon.label");
	КонецЕсли;
	Возврат Тексты.Текст("settings.hub.branding.assets.logo.label");

КонецФункции

#КонецОбласти

#Область Значения

// Где править нечего (всё задано конфигурацией), формы нет: слать ей нечего, и кнопка солгала бы.
Функция СекцияЗначений(Знач Состояние)

	Ключ = КлючРаздела();
	Карточки = Карточки();

	Секция = Кит.Секция(Дом.ПодписьРаздела(Ключ), Образец(Карточки, Состояние))
		.Иконка(Дом.ИконкаРаздела(Ключ));

	ЕстьПравка = Ложь;
	Показанные = Новый Массив();
	Для Каждого Объявление Из Объявления Цикл
		Карточка = Карточки.Получить(Объявление.Ключ);
		Секция.Добавить(ПолеЗначения(Объявление, Карточка, Состояние));
		Показанные.Добавить(Карточка);
		ЕстьПравка = ЕстьПравка ИЛИ Карточка.Редактируемая;
	КонецЦикла;
	Поля.СоСбросомВШапке(Секция, Показанные, "");

	Если НЕ ЕстьПравка Тогда
		Возврат Секция.Лид(Тексты.Текст("settings.values.occupied.lead"));
	КонецЕсли;

	Возврат Секция.Лид(Дом.ЛидРаздела(Ключ)).Форма("")
		.ПояснениеПанели(Тексты.Текст("settings.values.editable.note"));

КонецФункции

Функция ПолеЗначения(Знач Объявление, Знач Карточка, Знач Состояние)

	Если НЕ Карточка.Редактируемая Тогда
		Возврат Поля.ПолеЗанятое(Карточка);
	КонецЕсли;
	Возврат Поля.Настройка(Карточка, ПолеПравки(Объявление, Карточка, Состояние));

КонецФункции

Функция ПолеПравки(Знач Объявление, Знач Карточка, Знач Состояние)

	Если Объявление.Вид = "тумблер" Тогда
		Возврат Тумблер(Объявление.Имя, Карточка, Состояние);
	ИначеЕсли Объявление.Вид = "тема" Тогда
		Возврат ВыборТемы(Объявление.Имя, Карточка, Состояние);
	ИначеЕсли Объявление.Вид = "пресет" Тогда
		Возврат ВыборПресета(Объявление.Имя, Карточка, Состояние);
	ИначеЕсли Объявление.Вид = "цвет" Тогда
		Возврат ВыборАкцента(Объявление.Имя, Карточка, Состояние);
	КонецЕсли;
	Возврат ПолеТекста(Объявление, Карточка, Состояние);

КонецФункции

// Пустое поле означает «по умолчанию»: умолчание видно примером, а не значением — иначе первое
// же сохранение записало бы его в базу как введённое руками.
Функция ПолеТекста(Знач Объявление, Знач Карточка, Знач Состояние)

	Имя = Объявление.Имя;
	Поле = Кит.Поле(Имя, Поля.Метка(Карточка))
		.Значение(Набранное(Состояние, Имя, Поля.ЗначениеДляСравнения(Карточка)))
		.Пример(Объявление.ПоУмолчанию)
		.Подсказка(Текст(Карточка, "hint"));

	Справка = Текст(Карточка, "help");
	Если ЗначениеЗаполнено(Справка) Тогда
		Поле.Справка(Справка);
	КонецЕсли;
	Возврат СОтказом(Поле, Состояние, Имя);

КонецФункции

Функция Тумблер(Знач Имя, Знач Карточка, Знач Состояние)

	Узел = Кит.Тумблер(Имя, Поля.Метка(Карточка))
		.Включено(Отмечено(Состояние, Имя, Карточка.Значение = Истина))
		.Значения(Поля.ЗначениеВключено(), "0")
		.Подписи(Тексты.Текст("settings.value.on"), Тексты.Текст("settings.value.off"))
		.Подсказка(Текст(Карточка, "hint"));

	Справка = Текст(Карточка, "help");
	Если ЗначениеЗаполнено(Справка) Тогда
		Узел.Справка(Справка);
	КонецЕсли;
	Возврат Узел;

КонецФункции

// Порядок «светлая, тёмная» — тот же, что у переключателя образца и у выбора посетителя.
Функция ВыборТемы(Знач Имя, Знач Карточка, Знач Состояние)

	Подпись = Поля.Метка(Карточка);
	Сегменты = Кит.Сегменты(Имя,
			Кит.Сегмент("светлая", Тексты.Текст("settings.account.appearance.theme.light")),
			Кит.Сегмент("тёмная", Тексты.Текст("settings.account.appearance.theme.dark")))
		.Подпись(Подпись).Выбрано(Набранное(Состояние, Имя, Поля.ЗначениеДляСравнения(Карточка)));
	Возврат Кит.Группа(Подпись,
			СОтказом(Сегменты, Состояние, Имя),
			ПояснениеСегментов(Карточка))
		.Вид("простая");

КонецФункции

// Пресеты и их порядок — кита, имена — словаря по ключу кита. «Своя» отдельным пресетом не
// печатается: свой акцент ложится поверх любого пресета, и пометка у сегментов говорит об этом.
Функция ВыборПресета(Знач Имя, Знач Карточка, Знач Состояние)

	Подпись = Поля.Метка(Карточка);
	Сегменты = Кит.Сегменты(Имя);
	Для Каждого Пресет Из Токены.Пресеты() Цикл
		Сегменты.Добавить(Кит.Сегмент(Пресет.Ключ, Тексты.Текст(Пресет.КлючСловаряИмени)));
	КонецЦикла;

	Сегменты.Подпись(Подпись).Выбрано(Набранное(Состояние, Имя, Поля.ЗначениеДляСравнения(Карточка)));
	Возврат Кит.Группа(Подпись,
			СОтказом(Сегменты, Состояние, Имя),
			ПометкаСвоегоАкцента(),
			ПояснениеСегментов(Карточка))
		.Вид("простая");

КонецФункции

// Пометка «+ свой акцент» видна, пока поле акцента не пусто: лист прячет её по пустому полю
// (без скрипта и со скриптом одинаково), поэтому при правимом акценте она печатается всегда;
// у занятого конфигурацией акцента поля нет — пометка тогда по действующему значению.
Функция ПометкаСвоегоАкцента()

	Карточка = Настройки.Карточка(КлючАкцента());
	Нужна = Карточка.Редактируемая ИЛИ ЗначениеЗаполнено(Поля.ЗначениеДляСравнения(Карточка));
	// признак ставит область вокруг: у плашки, компонента кита, своего признака нет
	Возврат Кит.Область(Кит.Плашка(Тексты.Текст("settings.hub.branding.preset.accent")).Вид("accent"))
		.Признак("brand-preview", "own-accent").Когда(Нужна);

КонецФункции

// Пояснение настройки под сегментами: строки подсказки у сегментов кита нет.
Функция ПояснениеСегментов(Знач Карточка)

	Пояснение = Текст(Карточка, "hint");
	Если НЕ ЗначениеЗаполнено(Пояснение) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;
	Возврат Кит.Примечание(Пояснение);

КонецФункции

// Пустое значение — акцент пресета: у необязательного поля цвета для него свой кружок.
// Образцы — палитра кита, та же, что у выбора посетителя в «Вид и язык».
Функция ВыборАкцента(Знач Имя, Знач Карточка, Знач Состояние)

	Поле = Кит.Поле(Имя, Поля.Метка(Карточка)).ОбразцыТемы()
		.Значение(Набранное(Состояние, Имя, Поля.ЗначениеДляСравнения(Карточка)));
	Возврат СОтказом(Поле, Состояние, Имя);

КонецФункции

#КонецОбласти

#Область Образец

// Мини-шапка, ряд акцента и подвал так, как их увидит посетитель, в цветах пресета: название,
// подпись, пресет и акцент — зеркала полей формы; без скрипта образец показывает то, что
// напечатал сервер. Данные администратора — только узлом Кит.Текст: строка на месте ребёнка,
// совпавшая со словом вида, остановила бы сборку страницы.
Функция Образец(Знач Карточки, Знач Состояние)

	Возврат Кит.Образец(Тексты.Текст("settings.hub.branding.preview.title"),
			МиниШапка(Карточки, Состояние),
			РядАкцента(Карточки, Состояние),
			Подвал(Состояние))
		.Пресет(ПоказанныйПресет(Карточки, Состояние), ИмяПресета())
		.Якорь(ЯкорьОбразца());

КонецФункции

// Отбитая форма могла принести чужой ключ: образец тогда показывает пресет, который действует.
Функция ПоказанныйПресет(Знач Карточки, Знач Состояние)

	Действующий = Поля.ЗначениеДляСравнения(Карточки.Получить(КлючПресета()));
	Набрано = Набранное(Состояние, ИмяПресета(), Действующий);
	Для Каждого Пресет Из Токены.Пресеты() Цикл
		Если Пресет.Ключ = Набрано Тогда
			Возврат Набрано;
		КонецЕсли;
	КонецЦикла;
	Возврат Действующий;

КонецФункции

// Название, выключенное конфигурацией, в образце не печатается: тумблера, по которому его спрятал бы
// лист, на странице нет.
Функция МиниШапка(Знач Карточки, Знач Состояние)

	Показ = Карточки.Получить(КлючПоказаНазвания());
	Название = Кит.Надпись(Кит.Текст(НабранноеИлиДействующее(Состояние, ИмяНазвания(), Бренд.Знак())))
		.Вид("название").Зеркало(ИмяНазвания()).Признак("brand-preview", "name");

	Возврат Кит.Область(
			Кит.Картинка(АдресЗнака()).Вид("значок"),
			?(Показ.Редактируемая ИЛИ Показ.Значение = Истина, Название, Кит.Ничего()),
			Кит.Надпись(Тексты.Текст("chrome.top.nav.catalog")),
			Кит.Надпись(Тексты.Текст("chrome.top.nav.pools")))
		.Вид("полоса").Признак("brand-preview", "head");

КонецФункции

// Кнопка образца формы значений не отправляет; ссылка ведёт на сам образец.
Функция РядАкцента(Знач Карточки, Знач Состояние)

	Возврат Кит.Область(
			Кит.Кнопка(Тексты.Текст("settings.hub.branding.preview.button")).Основная().Иконка("плюс")
				.БезОтправки(),
			Кит.Ссылка("#" + ЯкорьОбразца(), Тексты.Текст("settings.hub.branding.preview.link")),
			Кит.Плашка(Тексты.Текст("settings.hub.branding.preview.badge")).Вид("accent"),
			Кит.Надпись(Тексты.Текст("settings.hub.branding.preview.text")))
		.Вид("полоса").Зеркало(ИмяАкцента(), Акцент(Карточки, Состояние)).Признак("brand-preview", "accent");

КонецФункции

Функция Акцент(Знач Карточки, Знач Состояние)
	Возврат Токены.БезопасныйЦвет(Набранное(Состояние, ИмяАкцента(),
		Поля.ЗначениеДляСравнения(Карточки.Получить(КлючАкцента()))));
КонецФункции

Функция Подвал(Знач Состояние)
	Возврат Кит.Примечание(Кит.Текст(НабранноеИлиДействующее(Состояние, ИмяПодписи(), Бренд.Подпись())))
		.Зеркало(ИмяПодписи()).Признак("brand-preview", "foot");
КонецФункции

Функция ЯкорьОбразца()
	Возврат "brendirovanie-obrazec";
КонецФункции

Функция АдресЗнака()
	Свой = Бренд.АдресЗагруженногоЗнака();
	Возврат ?(ЗначениеЗаполнено(Свой), Свой, Фирменные.АдресЗнака());
КонецФункции

#КонецОбласти

#Область Картинки

// Каждый слот — своя форма: файл уходит при выборе, отказ встаёт под тем слотом, который его получил.
Функция СекцияКартинок(Знач Состояние)

	Сетка = Кит.Сетка().Колонки(2);
	Для Каждого Слот Из Активы.Ключи() Цикл
		Сетка.Добавить(Кит.Область(СлотКартинки(Слот, Состояние)).Признак("brand-slot", Слот));
	КонецЦикла;

	Возврат Кит.Секция(Тексты.Текст("settings.hub.branding.assets.title"),
			Сетка,
			Кит.Примечание(Тексты.Текст("settings.hub.branding.assets.note")),
			Кит.Примечание(Кит.Иконка("предупреждение"), " ",
				Тексты.Текст("settings.hub.branding.assets.warning")))
		.Иконка("солнце")
		.Лид(Тексты.Шаблон("settings.hub.branding.assets.lead", ПотолокСловами()));

КонецФункции

// Потолок в целых мегабайтах — «1 МБ», как говорит о нём человек; иначе — размером с дробью.
Функция ПотолокСловами()

	Потолок = Активы.ПотолокБайт();
	Мегабайт = 1024 * 1024;
	Если Потолок % Мегабайт = 0 Тогда
		Возврат Тексты.Шаблон("settings.hub.branding.assets.megabytes", Тексты.ЧислоТекстом(Потолок / Мегабайт));
	КонецЕсли;
	Возврат Объёмы.Представление(Потолок);

КонецФункции

// «Вернуть стандартную» есть только у своей картинки: у стандартной пункт ничего бы не менял.
Функция СлотКартинки(Знач Слот, Знач Состояние)

	Сведения = Активы.Сведения(Слот);
	Узел = Кит.СлотКартинки(Слот, Метка(Слот)).Адрес(ДействующийАдрес(Слот)).Форма(Слот)
		.Якорь("brendirovanie-" + Слот);
	Если Окна.Открыто(Состояние, ВидЗагрузки(), Слот) Тогда
		Узел.Ошибка(Окна.Ошибка(Состояние));
	КонецЕсли;

	Если НЕ Сведения.Есть Тогда
		Возврат Узел.Состояние(СостояниеСтандартной(Слот));
	КонецЕсли;

	Возврат Узел.Состояние(СостояниеСвоей(Слот, Сведения)).Сброс(Слот + "/reset")
		.Открыто(Окна.Открыто(Состояние, ВидВозврата(), Слот))
		.АдресЗакрытия(Дом.АдресРаздела(КлючРаздела()));

КонецФункции

// Адрес берётся у брендирования: иначе раздел показывал бы своё представление о шапке.
Функция ДействующийАдрес(Знач Слот)

	Если Слот = Активы.КлючИконки() Тогда
		Свой = Бренд.АдресЗагруженнойИконки();
		Возврат ?(ЗначениеЗаполнено(Свой), Свой, Фирменные.АдресИконки());
	КонецЕсли;
	Возврат АдресЗнака();

КонецФункции

// Имя файла называет картинку так, как её отдаёт хаб: ключ и расширение типа — «favicon.svg».
Функция СостояниеСвоей(Знач Слот, Знач Сведения)

	Имя = Сведения.ПубличноеИмя;
	Точка = СтрНайти(Имя, ".", НаправлениеПоиска.СКонца);
	Файл = ?(Точка = 0, Слот, Слот + Сред(Имя, Точка));

	Размер = Объёмы.Представление(Сведения.Размер);
	Дата = Даты.ТолькоДата(Сведения.Загружен);
	Если Слот = Активы.КлючИконки() Тогда
		Возврат Тексты.Шаблон("settings.hub.branding.assets.favicon.uploaded", Файл, Размер, Дата);
	КонецЕсли;
	Возврат Тексты.Шаблон("settings.hub.branding.assets.logo.uploaded", Файл, Размер, Дата);

КонецФункции

Функция СостояниеСтандартной(Знач Слот)

	Если Слот = Активы.КлючИконки() Тогда
		Возврат Тексты.Текст("settings.hub.branding.assets.favicon.default");
	КонецЕсли;
	Возврат Тексты.Текст("settings.hub.branding.assets.logo.default");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Карточки()

	Результат = Новый Соответствие();
	Для Каждого Объявление Из Объявления Цикл
		Результат.Вставить(Объявление.Ключ, Настройки.Карточка(Объявление.Ключ));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Отбитая форма значений возвращает набранное; другое состояние раздела полей не касается.
Функция Набранное(Знач Состояние, Знач Имя, Знач Действующее)

	Если НЕ Окна.Открыто(Состояние, ВидЗначений()) Тогда
		Возврат Действующее;
	КонецЕсли;
	Возврат Окна.Значение(Состояние, Имя, Действующее);

КонецФункции

Функция НабранноеИлиДействующее(Знач Состояние, Знач Имя, Знач Действующее)

	Набрано = Набранное(Состояние, Имя, "");
	Возврат ?(ЗначениеЗаполнено(Набрано), Набрано, Действующее);

КонецФункции

Функция Отмечено(Знач Состояние, Знач Имя, Знач Действующее)

	Если НЕ Окна.Открыто(Состояние, ВидЗначений()) Тогда
		Возврат Действующее;
	КонецЕсли;
	Возврат Окна.Отмечено(Состояние, Имя, Действующее, Поля.ЗначениеВключено());

КонецФункции

Функция СОтказом(Знач Поле, Знач Состояние, Знач Имя)

	Если НЕ Окна.Открыто(Состояние, ВидЗначений()) Тогда
		Возврат Поле;
	КонецЕсли;

	Отказ = Окна.Отказ(Состояние, Имя);
	Возврат ?(ЗначениеЗаполнено(Отказ), Поле.Ошибка(Отказ), Поле);

КонецФункции

// Пояснение карточки из словаря; у настройки, которой хватает строки, справки нет.
Функция Текст(Знач Карточка, Знач Роль)

	Ключ = Поля.КлючТекста(Карточка.Ключ, Роль);
	Значение = Тексты.Текст(Ключ);
	Возврат ?(Значение = Тексты.Маркер(Ключ), "", Значение);

КонецФункции

Функция КлючРаздела()
	Возврат "branding";
КонецФункции

Функция КлючАкцента()
	Возврат "oshub.ui.accent";
КонецФункции

Функция КлючПресета()
	Возврат "oshub.ui.preset";
КонецФункции

// Имена полей — без точек: под этим же именем поле зеркалит образец (--mirror-<имя>).
Функция ИмяНазвания()
	Возврат "brand";
КонецФункции

Функция ИмяПодписи()
	Возврат "tagline";
КонецФункции

Функция ИмяАкцента()
	Возврат "accent";
КонецФункции

Функция ИмяПресета()
	Возврат "preset";
КонецФункции

Функция ИмяПоказаНазвания()
	Возврат "show_name";
КонецФункции

Функция КлючПоказаНазвания()
	Возврат "oshub.ui.show_name";
КонецФункции

Процедура ОбъявитьЗначение(Знач Имя, Знач Ключ, Знач Вид, Знач ПоУмолчанию = "")
	Объявления.Добавить(Новый Структура("Имя, Ключ, Вид, ПоУмолчанию", Имя, Ключ, Вид, ПоУмолчанию));
КонецПроцедуры

#КонецОбласти

&Прозвище("ВитринаБрендирования")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ДомХаба") _Дом,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ПоляНастроек") _Поля,
	&Пластилин(Значение = "СервисБрендовыхАктивов") _Активы,
	&Пластилин(Значение = "Брендирование") _Бренд,
	&Пластилин(Значение = "АдресаСтатики") _Фирменные,
	&Пластилин(Значение = "ТокеныТемы") _Токены,
	&Пластилин(Значение = "ОбъёмТекстом") _Объёмы,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты,
	&Пластилин(Значение = "ОкноРаздела") _Окна) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	Дом = _Дом;
	Настройки = _Настройки;
	Поля = _Поля;
	Активы = _Активы;
	Бренд = _Бренд;
	Фирменные = _Фирменные;
	Токены = _Токены;
	Объёмы = _Объёмы;
	Даты = _Даты;
	Окна = _Окна;

	Объявления = Новый Массив();
	ОбъявитьЗначение(ИмяНазвания(), "oshub.ui.brand", "текст", Бренд.ЗнакПоУмолчанию());
	ОбъявитьЗначение(ИмяПодписи(), "oshub.ui.tagline", "текст", Бренд.ПодписьПоУмолчанию());
	ОбъявитьЗначение(ИмяПоказаНазвания(), КлючПоказаНазвания(), "тумблер");
	ОбъявитьЗначение("theme", "oshub.ui.theme", "тема");
	ОбъявитьЗначение(ИмяПресета(), КлючПресета(), "пресет");
	ОбъявитьЗначение(ИмяАкцента(), КлючАкцента(), "цвет");

КонецПроцедуры
