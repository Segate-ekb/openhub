// Секция «Вход по паролю» раздела «Вход и регистрация» дома «Хаб»: тумблер настройки
// oshub.auth.password.enabled, сохраняемый сразу, и подтверждение его выключения — окном по адресу
// ?окно=выключить с эхом и числами предохранителя.

Перем Кит;        // Кит (кит) — фабрика элементов экрана
Перем Тексты;     // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Поля;       // ПоляНастроек — тумблер настройки с подсказкой и источником
Перем Настройки;  // СервисНастроек (настройки) — карточка настройки
Перем Политика;   // ПолитикаПарольногоВхода (вход) — ключ и действующее состояние
Перем Страж;      // СтражПарольногоВхода (вход) — предохранитель выключения
Перем Окна;       // ОкноРаздела — открыто ли окно подтверждения и отказ под эхом

#Область ПубличныйИнтерфейс

// Секция парольного входа: тумблер своей формой, при открытом окне — подтверждение выключения.
//
// Параметры:
//  Состояние - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//  АдресРаздела - Строка - раздел без окна: туда закрывается подтверждение.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.Секция.
//
Функция Секция(Знач Состояние, Знач АдресРаздела) Экспорт

	Карточка = Настройки.Карточка(КлючНастройки());

	Возврат Кит.Секция(Тексты.Текст("settings.hub.passwordlogin.title"),
			Переключатель(Карточка),
			Подтверждение(Состояние, Карточка, АдресРаздела))
		.Иконка("ключ");

КонецФункции

// Ключ настройки, которую секция печатает своей формой, а не общей формой раздела.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючНастройки() Экспорт
	Возврат Политика.КлючНастройки();
КонецФункции

// Вид окна подтверждения в адресе раздела.
//
// Возвращаемое значение:
//  Строка.
//
Функция ВидОкна() Экспорт
	Возврат "выключить";
КонецФункции

// Имя скрытого поля операции подтверждения.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Значение операции «выключить вход по логину и паролю».
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеОперации() Экспорт
	Возврат "парольный-вход";
КонецФункции

// Имя поля, в которое человек вводит эхо подтверждения.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляЭха() Экспорт
	Возврат "подтверждение";
КонецФункции

// Слово, которое человек повторяет, чтобы подтвердить выключение. Одна точка на печать
// поля и на серверную сверку.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОбразецЭха() Экспорт
	Возврат Тексты.Текст("settings.hub.passwordlogin.confirm.echo.sample");
КонецФункции

// Почему выключить нельзя — словами: домен отдаёт код причины, экранный текст собирается здесь.
//
// Параметры:
//  Вердикт - Структура - результат СтражПарольногоВхода.ПроверитьВыключение без успеха.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТекстОтказа(Знач Вердикт) Экспорт

	Если Вердикт.Причина = Страж.ПричинаНетПровайдеров() Тогда
		Чего = Тексты.Текст("settings.hub.passwordlogin.lockout.providers");
	ИначеЕсли Вердикт.Причина = Страж.ПричинаВсеПодГеоправилом() Тогда
		Чего = Тексты.Текст("providers.geo.lockout");
	Иначе
		Чего = Тексты.Текст("settings.hub.passwordlogin.lockout.identities");
	КонецЕсли;
	Возврат Тексты.Шаблон("settings.hub.passwordlogin.error.lockout", Чего);

КонецФункции

#КонецОбласти

#Область Тумблер

// Тумблер сохраняется сразу; без скрипта форму шлёт запасная кнопка кита. Настройка, занятая
// конфигурацией, показана той же ручкой, но не переключается.
Функция Переключатель(Знач Карточка)

	Если НЕ Карточка.Редактируемая Тогда
		Возврат Поля.ПолеЗанятое(Карточка);
	КонецЕсли;

	Возврат Кит.Форма("", Поля.ПолеПравки(Карточка, Истина));

КонецФункции

#КонецОбласти

#Область Подтверждение

// Окно печатается, только когда его назвал адрес и выключать есть что: при выключенном входе
// или сработавшем предохранителе подтверждать нечего — вместо окна сказана причина.
Функция Подтверждение(Знач Состояние, Знач Карточка, Знач АдресРаздела)

	Если НЕ Окна.Открыто(Состояние, ВидОкна()) ИЛИ НЕ Карточка.Редактируемая
		ИЛИ НЕ Политика.Включён() Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	// вердикт считается заново: подтверждать надо то, что происходит сейчас
	Вердикт = Страж.ПроверитьВыключение();
	Если НЕ Вердикт.Успех Тогда
		Возврат Кит.Уведомление(ТекстОтказа(Вердикт)).Вид("err");
	КонецЕсли;

	Возврат Кит.Подтверждение(Тексты.Текст("settings.hub.passwordlogin.confirm.title"),
			Тексты.Текст("settings.hub.passwordlogin.confirm.lead"),
			Кит.СкрытоеПоле(ИмяПоляОперации(), ЗначениеОперации()),
			Кит.Примечание(Тексты.Шаблон("settings.hub.passwordlogin.confirm.counts",
				Тексты.ЧислоТекстом(Вердикт.Админов), Тексты.ЧислоТекстом(Вердикт.Провайдеров))),
			Кит.Примечание(Тексты.Текст("settings.hub.passwordlogin.confirm.stays")),
			Кит.Примечание(Тексты.Текст("settings.hub.passwordlogin.confirm.rescue")))
		.Эхо(ИмяПоляЭха(), ОбразецЭха())
		.Кнопка(Тексты.Текст("settings.hub.passwordlogin.confirm.button"))
		.Ошибка(Окна.Отказ(Состояние, ИмяПоляЭха()))
		.Форма("").Якорь("parolnyi-vhod-vyklyuchit").Открыто().АдресЗакрытия(АдресРаздела);

КонецФункции

#КонецОбласти

&Прозвище("ВитринаПарольногоВхода")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПоляНастроек") _Поля,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _Политика,
	&Пластилин(Значение = "СтражПарольногоВхода") _Страж,
	&Пластилин(Значение = "ОкноРаздела") _Окна) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	Поля = _Поля;
	Настройки = _Настройки;
	Политика = _Политика;
	Страж = _Страж;
	Окна = _Окна;

КонецПроцедуры
