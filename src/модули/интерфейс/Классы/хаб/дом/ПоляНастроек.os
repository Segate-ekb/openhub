// Карточка реестра настроек элементами экрана: поле правки по типу значения, занятое поле, метка,
// подсказка строкой, справка и источник значения.

Перем Реестр;  // РеестрНастроек (настройки) — допустимые значения перечислений и имя переменной
Перем Кит;     // Кит (кит) — фабрика элементов экрана
Перем Тексты;  // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Имя поля формы для настройки — одна точка на рендер и на разбор.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - имя поля формы для настройки.
//
Функция ИмяПоля(Знач Ключ) Экспорт
	Возврат НРег(СокрЛП(Строка(Ключ)));
КонецФункции

// Значение тумблера «включено» (его же читает РазборФормы.Флажок).
//
// Возвращаемое значение:
//  Строка - значение тумблера «включено».
//
Функция ЗначениеВключено() Экспорт
	Возврат "1";
КонецФункции

// Имя скрытого поля с операцией раздела («» — сохранение, «сбросить» — уборка записи).
//
// Возвращаемое значение:
//  Строка - имя скрытого поля с операцией раздела.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Имя скрытого поля с ключом настройки (операция «сбросить»).
//
// Возвращаемое значение:
//  Строка - имя скрытого поля с ключом настройки.
//
Функция ИмяПоляКлюча() Экспорт
	Возврат "ключ";
КонецФункции

// Значение операции «сбросить введённое руками значение».
//
// Возвращаемое значение:
//  Строка - значение операции «сбросить введённое руками значение».
//
Функция ОперацияСброса() Экспорт
	Возврат "сбросить";
КонецФункции

// Ключ словаря для метки/подсказки настройки.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//  Роль - Строка - «label» либо «hint».
//
// Возвращаемое значение:
//  Строка - ключ словаря вида «settings.key.oshub-storage-root.label».
//
Функция КлючТекста(Знач Ключ, Знач Роль) Экспорт

	Переменная = Реестр.ПеременнаяОкружения(Ключ);
	// «__» — экранированное подчёркивание сегмента (конвенция configor), поэтому оно первым
	Основа = НРег(СтрЗаменить(СтрЗаменить(Строка(Переменная), "__", "-"), "_", "-"));
	Возврат "settings.key." + Основа + "." + Роль;

КонецФункции

// Человеческая метка настройки из словаря.
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//
// Возвращаемое значение:
//  Строка - человеческая метка настройки из словаря.
//
Функция Метка(Знач Карточка) Экспорт
	Возврат Тексты.Текст(КлючТекста(Карточка.Ключ, "label"));
КонецФункции

// Действующее значение в форме, пригодной для сравнения с вводом: неизменённое не пишется.
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//
// Возвращаемое значение:
//  Строка - действующее значение в форме, пригодной для сравнения с вводом.
//
Функция ЗначениеДляСравнения(Знач Карточка) Экспорт

	Если Карточка.Тип = "булево" Тогда
		Возврат ?(Карточка.Значение = Истина, ЗначениеВключено(), "0");
	КонецЕсли;
	Если Карточка.Тип = "целое" Тогда
		// тем же форматом, что печатается в поле (ЧислоТекстом): Строка() локалезависима
		Возврат Тексты.ЧислоТекстом(Карточка.Значение);
	КонецЕсли;
	Возврат СокрЛП(Строка(Карточка.Значение));

КонецФункции

// Редактируемое поле: вид управления выбирается ТИПОМ настройки из реестра. Пояснение —
// строкой под полем, длинное — справкой «?» у подписи, источник значения — справа в строке
// подсказки (у тумблера — так же, словом кита).
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//  СохранятьСразу - Булево - тумблер сам отправляет свою форму при переключении (необязательный,
//                   по умолчанию Ложь — значение уходит панелью сохранения секции).
//  Отбитая - Структура, Неопределено - форма раздела, вернувшаяся с отказом (см. ОкноРаздела.Отбитое):
//            поле печатает набранное (кроме секрета) и свой отказ под собой (необязательный,
//            по умолчанию Неопределено — действующее значение).
//
// Возвращаемое значение:
//  ЭлементЭкрана - поле правки (у булевой настройки — тумблер) в обёртке с признаками настройки
//                  и её источника.
//
Функция ПолеПравки(Знач Карточка, Знач СохранятьСразу = Ложь, Знач Отбитая = Неопределено) Экспорт

	Если Карточка.Тип = "булево" Тогда
		Возврат Настройка(Карточка, ТумблерПравки(Карточка, СохранятьСразу, Отбитая));
	КонецЕсли;

	Возврат Настройка(Карточка, ПолеВвода(Карточка, Отбитая));

КонецФункции

// Поле занятой ручки: настройка правится из интерфейса, но сейчас её перебила
// конфигурация — то же место и та же подпись, действующее значение, объяснение вместо ввода.
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//
// Возвращаемое значение:
//  ЭлементЭкрана - неправимое поле в обёртке с признаками настройки и её источника.
//
Функция ПолеЗанятое(Знач Карточка) Экспорт

	Если Карточка.Тип = "булево" Тогда
		// тумблер вместо запертой строки: занятая ручка выглядит той же ручкой
		Возврат Настройка(Карточка,
			Кит.Тумблер("", Метка(Карточка)).Включено(Карточка.Значение = Истина)
				.Подписи(Тексты.Текст("settings.value.on"), Тексты.Текст("settings.value.off"))
				.Подсказка(ПодсказкаЗанятой(Карточка)).Справка(Справка(Карточка))
				.Источник(Источник(Карточка)).Заблокировано());
	КонецЕсли;

	Возврат Настройка(Карточка, Кит.ПолеИзКонфига(
		Новый Структура("Метка, Значение, Деталька, Переменная, Подсказка, Секрет",
			Метка(Карточка), ЗначениеТекстом(Карточка), Карточка.Ключ, Карточка.Переменная,
			?(Карточка.Секрет, ПодсказкаСекрета(Карточка), ПодсказкаЗанятой(Карточка)),
			Карточка.Секрет)));

КонецФункции

// Откуда взято действующее значение — словом и ключом настройки: «по умолчанию · oshub.mail.from».
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//
// Возвращаемое значение:
//  Строка - источник значения.
//
Функция Источник(Знач Карточка) Экспорт
	Возврат Тексты.Шаблон("settings.source.line", СловоИсточника(Карточка.Источник), Карточка.Ключ);
КонецФункции

// Значение карточки для показа: булево — словами, пустая строка — «не задано».
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//
// Возвращаемое значение:
//  Строка - значение карточки для показа.
//
Функция ЗначениеТекстом(Знач Карточка) Экспорт

	Если Карточка.Секрет Тогда
		// в карточке уже маска, настоящего значения здесь не бывает
		Возврат ?(ЗначениеЗаполнено(Карточка.Значение), Строка(Карточка.Значение),
			Тексты.Текст("settings.value.empty"));
	КонецЕсли;

	Если Карточка.Тип = "булево" Тогда
		Возврат ?(Карточка.Значение = Истина,
			Тексты.Текст("settings.value.yes"), Тексты.Текст("settings.value.no"));
	КонецЕсли;

	Если Карточка.Тип = "целое" Тогда
		Возврат Тексты.ЧислоТекстом(Карточка.Значение);
	КонецЕсли;

	Значение = СокрЛП(Строка(Карточка.Значение));
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, Тексты.Текст("settings.value.empty"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Поле ввода по типу значения: число, выбор из перечисления, секрет или строка.
Функция ПолеВвода(Знач Карточка, Знач Отбитая)

	Имя = ИмяПоля(Карточка.Ключ);
	Поле = Кит.Поле(Имя, Метка(Карточка))
		.Подсказка(Подсказка(Карточка))
		.Справка(Справка(Карточка))
		.Источник(Источник(Карточка))
		.Ошибка(ОтказПоля(Отбитая, Имя));

	Если Карточка.Секрет Тогда
		// поле секрета ВСЕГДА пустое: право задать значение не есть право прочитать его.
		// Пустое поле означает «оставить как есть» — стирает значение действие сброса
		Возврат Поле.Секрет().Подсказка(ПодсказкаСекрета(Карточка));
	КонецЕсли;

	Если Карточка.Тип = "целое" Тогда
		Поле.ТипЗначения(Тип("Число"));
	КонецЕсли;
	Для Каждого Допустимое Из ДопустимыеЗначения(Карточка.Ключ) Цикл
		Поле.Вариант(Допустимое);
	КонецЦикла;

	// значение поля — ровно то, что контроллер считает прежним (не ЗначениеТекстом: «не задано»);
	// у отбитой формы — набранное
	Возврат Поле.Значение(Набранное(Отбитая, Имя, ЗначениеДляСравнения(Карточка)));

КонецФункции

// Набранное в отбитой форме; поля, которого форма не несла, — действующее значение.
Функция Набранное(Знач Отбитая, Знач Имя, Знач Действующее)

	Если Отбитая = Неопределено Тогда
		Возврат Действующее;
	КонецЕсли;
	Набрано = Отбитая.Набранное.Получить(Имя);
	Возврат ?(Набрано = Неопределено, Действующее, Строка(Набрано));

КонецФункции

Функция ОтказПоля(Знач Отбитая, Знач Имя)

	Если Отбитая = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Отказ = Отбитая.Отказы.Получить(Имя);
	Возврат ?(Отказ = Неопределено, "", Отказ);

КонецФункции

// Тремя словами о том, почему значение такое: конфигурация, база или умолчание.
Функция СловоИсточника(Знач Источник)

	Если Источник = "конфиг" Тогда
		Возврат Тексты.Текст("settings.source.config");
	ИначеЕсли Источник = "база" Тогда
		Возврат Тексты.Текст("settings.source.db");
	КонецЕсли;
	Возврат Тексты.Текст("settings.source.default");

КонецФункции

// Тумблер правки сохраняется панелью секции, как и поля рядом, либо сразу; подпись состояния — словами.
// В отбитой форме снятый тумблер не приходит вовсе — положение берётся из набранного целиком.
Функция ТумблерПравки(Знач Карточка, Знач СохранятьСразу, Знач Отбитая)

	Имя = ИмяПоля(Карточка.Ключ);
	Включено = ?(Отбитая = Неопределено, Карточка.Значение = Истина,
		Отбитая.Набранное.Получить(Имя) = ЗначениеВключено());
	Тумблер = Кит.Тумблер(Имя, Метка(Карточка)).Включено(Включено)
		.Значения(ЗначениеВключено(), "0")
		.Подписи(Тексты.Текст("settings.value.on"), Тексты.Текст("settings.value.off"))
		.Подсказка(Подсказка(Карточка))
		.Справка(Справка(Карточка))
		.Источник(Источник(Карточка));
	Если СохранятьСразу Тогда
		Тумблер.СохранятьСразу();
	КонецЕсли;

	Возврат Тумблер;

КонецФункции

// Обёртка поля настройки: ключ и источник — соседние признаки одного узла, источник не
// отрывается от своей настройки, и по ним скрипт и сторожа находят поле.
Функция Настройка(Знач Карточка, Знач Поле)

	Возврат Кит.Область(Поле)
		.Признак("setting", Карточка.Ключ)
		.Признак("source", ЛатинскийИсточник(Карточка.Источник));

КонецФункции

// Пояснение строкой под полем.
Функция Подсказка(Знач Карточка)
	Возврат Тексты.Текст(КлючТекста(Карточка.Ключ, "hint"));
КонецФункции

// Длинное пояснение — справкой «?» у подписи; у настройки, которой хватает строки, справки нет.
Функция Справка(Знач Карточка)

	Ключ = КлючТекста(Карточка.Ключ, "help");
	Текст = Тексты.Текст(Ключ);
	Возврат ?(Текст = Тексты.Маркер(Ключ), "", Текст);

КонецФункции

// Занятая ручка называет, чем она занята и что убрать, чтобы править её отсюда.
Функция ПодсказкаЗанятой(Знач Карточка)
	Возврат Подсказка(Карточка) + " "
		+ Тексты.Шаблон("settings.value.locked.forced", Карточка.Ключ, Карточка.Переменная);
КонецФункции

// Подсказка поля секрета: назначение и состояние «задано / не задано» — но не значение.
Функция ПодсказкаСекрета(Знач Карточка)

	Состояние = ?(ЗначениеЗаполнено(Карточка.Значение),
		Тексты.Текст("settings.value.secret.set"), Тексты.Текст("settings.value.secret.empty"));

	Возврат Подсказка(Карточка) + " " + Состояние;

КонецФункции

// Допустимые значения перечисления из реестра (пусто — свободный ввод).
Функция ДопустимыеЗначения(Знач Ключ)

	Результат = Новый Массив();

	Валидатор = Реестр.Описание(Ключ).Валидатор;
	Если Валидатор = Неопределено ИЛИ Валидатор.Вид <> "перечисление" Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Допустимое Из Валидатор.Значения Цикл
		Результат.Добавить(СокрЛП(Допустимое));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Значение источника для атрибута разметки — латиницей (ЭкранированиеHTML режет остальное).
Функция ЛатинскийИсточник(Знач Источник)

	Если Источник = "конфиг" Тогда
		Возврат "config";
	ИначеЕсли Источник = "база" Тогда
		Возврат "database";
	КонецЕсли;
	Возврат "default";

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РеестрНастроек") _Реестр,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Реестр = _Реестр;
	Кит = _Кит;
	Тексты = _Тексты;

КонецПроцедуры
