// Операции раздела «Брендирование» дома «Хаб»: запись значений формы, загрузка логотипа и иконки,
// возврат стандартной картинки. Исход — структура для контроллера: удача либо отказ с кодом,
// причиной словами и отказами у полей.

Перем РазборФормы;
Перем Настройки;  // СервисНастроек (настройки) — запись значений
Перем Уборка;     // ПультЗначенийНастроек — уборка введённого руками
Перем Активы;     // СервисБрендовыхАктивов (настройки) — загрузка и возврат картинок
Перем Витрина;    // ВитринаБрендирования — имена полей и метки картинок
Перем Поля;       // ПоляНастроек — сравнение с действующим, имена операции и ключа
Перем Объёмы;     // ОбъёмТекстом (основа) — вес файла и потолок словами
Перем Сбои;       // ТекстСбоя — причина отказа домена человеку
Перем Тексты;     // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Есть ли у раздела такая картинка.
//
// Параметры:
//  Слот - Строка - сегмент адреса.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьСлот(Знач Слот) Экспорт
	Возврат Активы.Ключи().Найти(Строка(Слот)) <> Неопределено;
КонецФункции

// Записывает изменившиеся значения формы раздела по одному. Выборы с проверкой формата (пресет,
// акцент, тема) — первыми; отказ называет и то, что из формы уже записано.
//
// Параметры:
//  Форма - Соответствие - разобранная форма значений.
//  Кто - Строка - логин автора изменения.
//
// Возвращаемое значение:
//  Структура - Успех, Код, Сообщение, Отказы, Применено (см. Удача).
//
Функция СохранитьЗначения(Знач Форма, Знач Кто) Экспорт

	Применённые = Новый Массив();

	Для Каждого Объявление Из ПорядокЗаписи() Цикл

		Карточка = Настройки.Карточка(Объявление.Ключ);
		Если Форма.Получить(Объявление.Имя) = Неопределено ИЛИ НЕ Карточка.Редактируемая Тогда
			// занятой ручке поле не печаталось: прислать её значение некому
			Продолжить;
		КонецЕсли;

		Введённое = ВведённоеЗначение(Объявление, Форма);
		Если Строка(ДляСравнения(Объявление, Введённое)) = Поля.ЗначениеДляСравнения(Карточка) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Настройки.Установить(Объявление.Ключ, Введённое, Кто, "");
		Исключение
			Возврат ОтбитоПолем(Объявление, Сбои.Человеку(ИнформацияОбОшибке()), Применённые);
		КонецПопытки;
		Применённые.Добавить(Поля.Метка(Карточка));

	КонецЦикла;

	Возврат Удача();

КонецФункции

// Убирает введённое руками значение раздела — форма «Введено вручную» под формой значений.
//
// Параметры:
//  Форма - Соответствие - разобранная форма с операцией сброса и ключом настройки.
//  Кто - Строка - логин автора изменения.
//
// Возвращаемое значение:
//  Структура - Успех, Код, Сообщение, Отказы (см. Удача).
//
Функция СброситьВведённое(Знач Форма, Знач Кто) Экспорт

	Проблема = Уборка.Сбросить("branding", Форма, Кто).Сообщение;
	Возврат ?(ЗначениеЗаполнено(Проблема), Отказ(Проблема, 400), Удача());

КонецФункции

// Пришла ли форма значений со старой вкладки: поле с ключом настройки вместо имени поля
// (форма до перевода раздела на образец) или операция, которой раздел не знает. Такая форма
// отбивается целиком, а не записывает часть полей.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Булево.
//
Функция ФормаУстарела(Знач Форма) Экспорт

	Для Каждого Поле Из Форма Цикл
		Если СтрНачинаетсяС(НРег(Поле.Ключ), "oshub.") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Операция = Операция(Форма);
	Если ЗначениеЗаполнено(Операция) Тогда
		Возврат Операция <> Поля.ОперацияСброса();
	КонецЕсли;

	Для Каждого Объявление Из Витрина.ПоляЗначений() Цикл
		Если Форма.Получить(Объявление.Имя) <> Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Сброс ли введённого руками пришёл формой раздела.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоСбросВведённого(Знач Форма) Экспорт
	Возврат Операция(Форма) = Поля.ОперацияСброса();
КонецФункции

// Отказ формы старой вкладки: ничего не изменено.
//
// Возвращаемое значение:
//  Структура - Успех, Код, Сообщение, Отказы (см. Удача), код 400.
//
Функция ОтказУстаревшей() Экспорт
	Возврат Отказ(Тексты.Текст("settings.hub.branding.error.stale"), 400);
КонецФункции

// Загружает картинку слота. Тип и размер судит домен; отказ по размеру называет себя 413:
// править нужно файл, а не форму.
//
// Параметры:
//  Слот - Строка - ключ картинки.
//  Файлы - Соответствие - файловые части формы (см. РазборФормы.Файлы).
//  Кто - Строка - логин автора изменения.
//
// Возвращаемое значение:
//  Структура - Успех, Код, Сообщение, Отказы (см. Удача).
//
Функция Загрузить(Знач Слот, Знач Файлы, Знач Кто) Экспорт

	Часть = РазборФормы.Файл(Файлы, Слот);
	Если Часть = Неопределено ИЛИ Часть.Данные = Неопределено ИЛИ Часть.Данные.Размер() = 0 Тогда
		Возврат Отказ(Тексты.Текст("settings.hub.branding.error.empty"), 400);
	КонецЕсли;

	Вердикт = Активы.Загрузить(Слот, Часть.Данные, Часть.ТипКонтента, Часть.ИмяФайла, Кто, "");
	Если Вердикт.Успех Тогда
		Возврат Удача();
	ИначеЕсли Вердикт.Причина = Активы.КодВелик() Тогда
		Возврат Отказ(Тексты.Шаблон("settings.hub.branding.error.large", Витрина.Метка(Слот),
			Объёмы.Представление(Вердикт.Размер), Объёмы.Представление(Вердикт.Потолок)), 413);
	ИначеЕсли Вердикт.Причина = Активы.КодТип() Тогда
		Возврат Отказ(Тексты.Шаблон("settings.hub.branding.error.type", Витрина.Метка(Слот)), 400);
	ИначеЕсли Вердикт.Причина = Активы.КодПусто() Тогда
		Возврат Отказ(Тексты.Текст("settings.hub.branding.error.empty"), 400);
	КонецЕсли;
	Возврат Отказ(Тексты.Шаблон("settings.hub.branding.error.upload", Витрина.Метка(Слот)), 400);

КонецФункции

// Возвращает стандартную картинку слота; идемпотентен.
//
// Параметры:
//  Слот - Строка - ключ картинки.
//  Кто - Строка - логин автора изменения.
//
// Возвращаемое значение:
//  Структура - Успех, Код, Сообщение, Отказы (см. Удача).
//
Функция Вернуть(Знач Слот, Знач Кто) Экспорт
	Активы.Сбросить(Слот, Кто, "");
	Возврат Удача();
КонецФункции

#КонецОбласти

#Область Исход

// Исход операции: Успех, Код (статус ответа отказа), Сообщение (причина словами у любого отказа),
// Отказы (имя поля -> отказ под полем), Применено (что из формы уже записано — у отказа поля).
Функция Удача()
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы, Применено", Истина, 0, "", Новый Соответствие(), "");
КонецФункции

Функция Отказ(Знач Сообщение, Знач Код)
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы, Применено", Ложь, Код, Сообщение,
		Новый Соответствие(), "");
КонецФункции

// Отказ поля: причина — строкой под полем (у сегментов темы и пресета — под группой), а что из
// формы уже записано — отдельно: запись идёт по полю, и раздел говорит, что применилось.
Функция ОтбитоПолем(Знач Объявление, Знач Причина, Знач Применённые)

	Итог = ?(Применённые.Количество() = 0, Тексты.Текст("settings.hub.error.applied.none"),
		Тексты.Шаблон("settings.hub.error.applied", СтрСоединить(Применённые, ", ")));

	Исход = Отказ(Причина + " " + Итог, 400);
	Исход.Отказы.Вставить(Объявление.Имя, Причина);
	Исход.Применено = Итог;
	Возврат Исход;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПорядокЗаписи()

	Результат = Новый Массив();
	Для Каждого Вид Из СтрРазделить("пресет,цвет,тема,текст,тумблер", ",") Цикл
		Для Каждого Объявление Из Витрина.ПоляЗначений() Цикл
			Если Объявление.Вид = Вид Тогда
				Результат.Добавить(Объявление);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Значение поля в виде, принимаемом доменным API: тумблер — булевым, остальное — строкой.
Функция ВведённоеЗначение(Знач Объявление, Знач Форма)

	Если Объявление.Вид = "тумблер" Тогда
		Возврат РазборФормы.Флажок(Форма, Объявление.Имя, Поля.ЗначениеВключено());
	КонецЕсли;
	Возврат СокрЛП(РазборФормы.Поле(Форма, Объявление.Имя));

КонецФункции

// Введённое в той же записи, что и действующее у карточки: неизменённое не пишется.
Функция ДляСравнения(Знач Объявление, Знач Введённое)

	Если Объявление.Вид = "тумблер" Тогда
		Возврат ?(Введённое = Истина, Поля.ЗначениеВключено(), "0");
	КонецЕсли;
	Возврат Введённое;

КонецФункции

Функция Операция(Знач Форма)
	Возврат НРег(СокрЛП(РазборФормы.Поле(Форма, Поля.ИмяПоляОперации())));
КонецФункции

#КонецОбласти

&Прозвище("ПультБрендирования")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ПультЗначенийНастроек") _Уборка,
	&Пластилин(Значение = "СервисБрендовыхАктивов") _Активы,
	&Пластилин(Значение = "ВитринаБрендирования") _Витрина,
	&Пластилин(Значение = "ПоляНастроек") _Поля,
	&Пластилин(Значение = "ОбъёмТекстом") _Объёмы,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	РазборФормы = _РазборФормы;
	Настройки = _Настройки;
	Уборка = _Уборка;
	Активы = _Активы;
	Витрина = _Витрина;
	Поля = _Поля;
	Объёмы = _Объёмы;
	Сбои = _Сбои;
	Тексты = _Тексты;

КонецПроцедуры
