// Витрина кабинета «подтверждение адреса»: секция у неподтверждённого адреса — кнопка
// повтора письма либо причина, по которой письма не будет, — и уведомление об исходе письма.

Перем Кит;              // Кит (кит) — фабрика элементов экрана
Перем РендерерНастроек; // РендерерНастроек (кит) — заготовка секции
Перем Тексты;           // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Ответы;           // ОтветыНастроек — форма уведомления
Перем Подтверждение;    // СервисПодтвержденияEmail (вход) — уйдёт ли письмо прямо сейчас
Перем Отказы;           // ТекстыОтказовПодтверждения — слова и код отказа письма

#Область ПубличныйИнтерфейс

// Секция «Подтверждение адреса». Кнопка повтора рисуется, только когда письмо
// действительно уйдёт; иначе на её месте названа причина.
//
// Параметры:
//  Пользователь - Пользователь - владелец кабинета.
//  Адрес - Строка - адрес раздела (он же action формы).
//  Токен - Строка - CSRF-токен сессии.
//
// Возвращаемое значение:
//  Структура, Неопределено - описание секции для РендерерНастроек; Неопределено — адреса
//                            нет либо он уже подтверждён, показывать нечего.
//
Функция СекцияПодтверждения(Знач Пользователь, Знач Адрес, Знач Токен) Экспорт

	Если НЕ АдресЖдётПодтверждения(Пользователь) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Причина = Подтверждение.ПочемуНельзяВыслать(Пользователь);
	Если ЗначениеЗаполнено(Причина) Тогда
		Возврат ПричинаБезПисьма(Причина);
	КонецЕсли;
	Возврат ПовторПисьма(Пользователь, Адрес, Токен);

КонецФункции

// Уведомление об исходе письма: куда оно ушло либо почему его нет. Причину, которую
// и так назовёт секция подтверждения, уведомление не повторяет.
//
// Параметры:
//  Итог - Структура - исход письма: Успех, Причина.
//  Пользователь - Пользователь - владелец кабинета.
//  ВидОтказа - Строка - вид уведомления об отказе: "warn" либо "err".
//
// Возвращаемое значение:
//  Структура, Неопределено - уведомление для ОтветыНастроек; Неопределено — сказать нечего
//                            сверх секции.
//
Функция УведомлениеОПисьме(Знач Итог, Знач Пользователь, Знач ВидОтказа) Экспорт

	Если Итог.Успех Тогда
		Возврат Ответы.Уведомление(
			Тексты.Шаблон("confirm.page.resend.done", Строка(Пользователь.Email)), "ok");
	КонецЕсли;
	Если ПричинаВСекции(Итог.Причина, Пользователь) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ответы.Уведомление(Отказы.Объяснение(Итог.Причина), ВидОтказа);

КонецФункции

// HTTP-код ответа на повтор письма: 200 при удаче, при отказе — тот же, что у /confirm-email.
//
// Параметры:
//  Итог - Структура - исход письма: Успех, Причина.
//
// Возвращаемое значение:
//  Число.
//
Функция КодОтвета(Знач Итог) Экспорт
	Возврат ?(Итог.Успех, 200, Отказы.КодОтвета(Итог.Причина));
КонецФункции

// Имя скрытого поля операции.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Значение операции «выслать письмо ещё раз».
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияПовтора() Экспорт
	Возврат "выслать";
КонецФункции

#КонецОбласти

#Область СодержимоеСекции

Функция ПричинаБезПисьма(Знач Причина)

	Секция = РендерерНастроек.Секция(Тексты.Текст("confirm.page.title"),
		Отказы.Объяснение(Причина));
	Секция.Иконка = "конверт";
	Возврат Секция;

КонецФункции

// Получателя форма не несёт: письмо уходит на адрес, который уже записан в учётке.
Функция ПовторПисьма(Знач Пользователь, Знач Адрес, Знач Токен)

	Тело = Кит.Холст();
	Тело.Добавить(Кит.СкрытоеПоле(ИмяПоляОперации(), ОперацияПовтора()));

	Секция = РендерерНастроек.Секция(Тексты.Текст("confirm.page.title"),
		Тексты.Шаблон("settings.account.confirm.lead", Строка(Пользователь.Email)),
		Тело.Рендер());
	Секция.Иконка = "конверт";
	Секция.Действие = Адрес;
	Секция.Токен = Токен;
	Секция.Кнопка = Тексты.Текст("confirm.page.resend.button");
	Возврат Секция;

КонецФункции

Функция АдресЖдётПодтверждения(Знач Пользователь)
	Возврат ЗначениеЗаполнено(Пользователь.Email) И НЕ Пользователь.EmailПодтверждён = Истина;
КонецФункции

// Секция называет причину сама, когда она рисуется и её причина та же.
Функция ПричинаВСекции(Знач Причина, Знач Пользователь)
	Возврат АдресЖдётПодтверждения(Пользователь)
		И Причина = Подтверждение.ПочемуНельзяВыслать(Пользователь);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "РендерерНастроек") _РендерерНастроек,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "СервисПодтвержденияEmail") _Подтверждение,
	&Пластилин(Значение = "ТекстыОтказовПодтверждения") _Отказы)

	Кит = _Кит;
	РендерерНастроек = _РендерерНастроек;
	Тексты = _Тексты;
	Ответы = _Ответы;
	Подтверждение = _Подтверждение;
	Отказы = _Отказы;

КонецПроцедуры
