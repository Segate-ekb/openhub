// Дом настроек «Аккаунт»: адреса, разделы и заголовки личных настроек; первый раздел —
// кабинет со сводкой дел.

Перем Тексты;    // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Сборка;    // СборкаДомаНастроек — перечень разделов дома
Перем Адреса;    // АдресаКабинета — адреса экранов кабинета
Перем Перечень;  // ТаблицаЗначений — разделы дома по порядку колонки

// Ключ дома; печатается в атрибут data-дом.
//
// Возвращаемое значение:
//  Строка - ключ дома.
//
Функция Ключ() Экспорт
	Возврат "account";
КонецФункции

// Адрес кабинета — первого раздела дома; он живёт на корне /me, а не под базовым адресом.
//
// Возвращаемое значение:
//  Строка - адрес кабинета.
//
Функция АдресКабинета() Экспорт
	Возврат Адреса.Личное();
КонецФункции

// Ключ раздела «Кабинет».
//
// Возвращаемое значение:
//  Строка - ключ раздела.
//
Функция РазделКабинета() Экспорт
	Возврат "office";
КонецФункции

// Базовый адрес дома настроек.
//
// Возвращаемое значение:
//  Строка - базовый адрес дома настроек.
//
Функция БазовыйАдрес() Экспорт
	Возврат Адреса.Настройки();
КонецФункции

// Раздел по умолчанию: на него ведёт базовый адрес дома.
//
// Возвращаемое значение:
//  Строка - ключ раздела.
//
Функция РазделПоУмолчанию() Экспорт
	Возврат РазделКабинета();
КонецФункции

// Адрес раздела дома.
//
// Параметры:
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Строка - URL.
//
Функция АдресРаздела(Знач Ключ) Экспорт
	Раздел = Сборка.РазделПеречня(Перечень, Ключ);
	Если Раздел <> Неопределено И ЗначениеЗаполнено(Раздел.СвойАдрес) Тогда
		Возврат Раздел.СвойАдрес;
	КонецЕсли;
	Возврат БазовыйАдрес() + "/" + Ключ;
КонецФункции

// Разделы дома для модели (ОтветыНастроек.МодельДома).
//
// Параметры:
//  Активный - Строка - ключ текущего раздела.
//
// Возвращаемое значение:
//  Структура - разделы дома (СборкаДомаНастроек.РазделыДома).
//
Функция Разделы(Знач Активный) Экспорт
	Возврат Сборка.РазделыДома(БазовыйАдрес(), Перечень, Активный, РубрикаОбъекта());
КонецФункции

// Есть ли раздел с таким ключом.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Булево - есть ли раздел с таким ключом.
//
Функция ЕстьРаздел(Знач Ключ) Экспорт
	Возврат Сборка.РазделПеречня(Перечень, Ключ) <> Неопределено;
КонецФункции

// Подпись раздела.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - подпись раздела либо "".
//
Функция ПодписьРаздела(Знач Ключ) Экспорт
	Раздел = Сборка.РазделПеречня(Перечень, Ключ);
	Возврат ?(Раздел = Неопределено, "", Раздел.Подпись);
КонецФункции

// Заголовок дома этой учётки на странице и во вкладке. Группу разделов в шторке меню
// подписывает общий Заголовок(): логин там уже стоит блоком учётки.
//
// Параметры:
//  Логин - Строка - логин владельца аккаунта.
//
// Возвращаемое значение:
//  Строка - «Аккаунт · логин».
//
Функция ЗаголовокУчётки(Знач Логин) Экспорт
	Возврат Тексты.Шаблон("settings.account.heading", Логин);
КонецФункции

// Объект дома, один на все его разделы: у этого дома его нет — объект (логин стоит в заголовке) называет раздел.
//
// Возвращаемое значение:
//  Строка - "".
//
Функция Объект() Экспорт
	Возврат "";
КонецФункции

// Общее имя дома, как у домов пула, пакета, хаба и группы: им подписана группа разделов
// в шторке меню. Страница и вкладка берут ЗаголовокУчётки — с логином.
//
// Возвращаемое значение:
//  Строка - «Настройки аккаунта».
//
Функция Заголовок() Экспорт
	Возврат Тексты.Текст("settings.account.title");
КонецФункции

// Рубрика объекта дома (уходит в РазделыДома): под заголовком «Аккаунт · логин» и в шторке под «Настройками аккаунта»
// она повторила бы имя — её разделы (кабинет, профиль, вид) идут первыми без рубрики.
//
// Возвращаемое значение:
//  Строка - подпись рубрики.
//
Функция РубрикаОбъекта() Экспорт
	Возврат Тексты.Текст("settings.account.group.account");
КонецФункции

// Пояснение дома.
//
// Возвращаемое значение:
//  Строка - пояснение дома.
//
Функция Пояснение() Экспорт
	Возврат Тексты.Текст("settings.account.lead");
КонецФункции

// Раздел перечня дома.
Процедура Раздел(Знач КлючРаздела, Знач Подпись, Знач Иконка, Знач Рубрика, Знач СвойАдрес = "")
	Сборка.Раздел(Перечень, КлючРаздела, Подпись, Иконка, Рубрика, СвойАдрес);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СборкаДомаНастроек") _Сборка,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаКабинета") _Адреса) Экспорт

	Сборка = _Сборка;
	Тексты = _Тексты;
	Адреса = _Адреса;

	Перечень = Сборка.ПереченьРазделов();

	Аккаунт = Тексты.Текст("settings.account.group.account");
	Раздел(РазделКабинета(), Тексты.Текст("settings.account.nav.office"), "стопка", Аккаунт, АдресКабинета());
	Раздел("profile", Тексты.Текст("settings.account.nav.profile"), "аккаунт", Аккаунт);
	Раздел("appearance", Тексты.Текст("settings.account.nav.appearance"), "солнце", Аккаунт);

	Доступ = Тексты.Текст("settings.account.group.access");
	Раздел("security", Тексты.Текст("settings.account.nav.security"), "замок", Доступ);
	Раздел("tokens", Тексты.Текст("settings.account.nav.tokens"), "ключ", Доступ);
	Раздел("oidc", Тексты.Текст("settings.account.nav.oidc"), "ссылка", Доступ);
	Раздел("permissions", Тексты.Текст("settings.account.nav.permissions"), "галочка", Доступ);

КонецПроцедуры
