// Дом настроек «Аккаунт»: адреса, разделы и заголовки личных настроек; первый раздел —
// кабинет со сводкой дел.

Перем Тексты;    // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Каталог;   // КаталогРазделов
Перем Адреса;    // АдресаКабинета — адреса экранов кабинета
Перем Описания;  // Массив описаний разделов

// Ключ дома; печатается в атрибут data-дом.
//
// Возвращаемое значение:
//  Строка - ключ дома.
//
Функция Ключ() Экспорт
	Возврат "account";
КонецФункции

// Адрес кабинета — первого раздела дома; он живёт на корне /me, а не под базовым адресом.
//
// Возвращаемое значение:
//  Строка - адрес кабинета.
//
Функция АдресКабинета() Экспорт
	Возврат Адреса.Личное();
КонецФункции

// Ключ раздела «Кабинет».
//
// Возвращаемое значение:
//  Строка - ключ раздела.
//
Функция РазделКабинета() Экспорт
	Возврат "office";
КонецФункции

// Базовый адрес дома настроек.
//
// Возвращаемое значение:
//  Строка - базовый адрес дома настроек.
//
Функция БазовыйАдрес() Экспорт
	Возврат Адреса.Настройки();
КонецФункции

// Раздел по умолчанию: на него ведёт базовый адрес дома.
//
// Возвращаемое значение:
//  Строка - ключ раздела.
//
Функция РазделПоУмолчанию() Экспорт
	Возврат РазделКабинета();
КонецФункции

// Адрес раздела дома.
//
// Параметры:
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Строка - URL.
//
Функция АдресРаздела(Знач Ключ) Экспорт
	Возврат Каталог.Адрес(БазовыйАдрес(), Описания, Ключ);
КонецФункции

// Разделы дома для дерева навигации.
//
// Параметры:
//  Активный - Строка - ключ текущего раздела.
//
// Возвращаемое значение:
//  Массив - разделы.
//
Функция Разделы(Знач Активный) Экспорт
	Возврат Каталог.Разделы(БазовыйАдрес(), Описания, Активный);
КонецФункции

// Есть ли раздел с таким ключом.
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Булево - есть ли раздел с таким ключом.
//
Функция ЕстьРаздел(Знач Ключ) Экспорт
	Возврат Каталог.Содержит(Описания, Ключ);
КонецФункции

// Подпись раздела (заголовок вкладки).
//
// Параметры:
//  Ключ - Строка - ключ.
//
// Возвращаемое значение:
//  Строка - подпись раздела (заголовок вкладки).
//
Функция ПодписьРаздела(Знач Ключ) Экспорт
	Возврат Каталог.Подпись(Описания, Ключ);
КонецФункции

// Заголовок дома.
//
// Возвращаемое значение:
//  Строка - заголовок дома.
//
Функция Заголовок() Экспорт
	Возврат Тексты.Текст("settings.account.title");
КонецФункции

// Пояснение дома.
//
// Возвращаемое значение:
//  Строка - пояснение дома.
//
Функция Пояснение() Экспорт
	Возврат Тексты.Текст("settings.account.lead");
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаталогРазделов") _Каталог,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаКабинета") _Адреса) Экспорт

	Каталог = _Каталог;
	Тексты = _Тексты;
	Адреса = _Адреса;

	Описания = Новый Массив();
	Описания.Добавить(Каталог.Описание(РазделКабинета(), Тексты.Текст("settings.account.nav.office"),
		"стопка", АдресКабинета()));
	Описания.Добавить(Каталог.Описание("profile", Тексты.Текст("settings.account.nav.profile"), "аккаунт"));
	Описания.Добавить(Каталог.Описание("security", Тексты.Текст("settings.account.nav.security"), "замок"));
	Описания.Добавить(Каталог.Описание("tokens", Тексты.Текст("settings.account.nav.tokens"), "ключ"));
	Описания.Добавить(Каталог.Описание("oidc", Тексты.Текст("settings.account.nav.oidc"), "ссылка"));
	Описания.Добавить(Каталог.Описание("permissions", Тексты.Текст("settings.account.nav.permissions"), "галочка"));
	Описания.Добавить(Каталог.Описание("appearance", Тексты.Текст("settings.account.nav.appearance"), "солнце"));

КонецПроцедуры
