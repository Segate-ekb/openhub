// Раздел «Токены доступа» дома «Аккаунт»: реестр личных токенов с плашками прав, области и срока,
// «Выпустить токен» в шапке секции; окно выпуска и подтверждение отзыва — по адресу.

Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем СервисТокенов;  // СервисТокенов (вход) — выпущенные ключи и потолок срока
Перем СервисПулов;    // СервисПулов (реестр) — имена пулов, которыми ограничены ключи
Перем ГейтТокена;     // ГейтТокена (вход) — словарь прав, которым живёт ключ
Перем Окна;           // ОкноРаздела — окно по адресу и его состояние
Перем ОкноВыпуска;    // ОкноВыпускаТокена — окна «Новый токен» и выпущенного токена
Перем Даты;           // ДатаЧеловеку — одно написание момента на весь интерфейс
Перем Тексты;         // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<ключ>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат "новый,отозвать";
КонецФункции

// Секции раздела.
//
// Параметры:
//  Параметры - Структура:
//    * Адрес - Строка - адрес раздела;
//    * Пользователь - Пользователь - владелец токенов;
//    * Окно - Структура, Неопределено - состояние открытого окна (см. ОкноРаздела.Отбитое);
//    * Выпуск - Структура - параметры окна «Новый токен» (см. ОкноВыпускаТокена.Выпуск);
//    * Секрет - Строка - значение только что выпущенного токена; "" — показывать нечего.
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - одна секция: реестр токенов и окна.
//
Функция Секции(Знач Параметры) Экспорт

	Записи = СервисТокенов.ТокеныПользователя(Параметры.Пользователь.Идентификатор);
	ОкноЗаведения = ОкноВыпуска.Выпуск(Параметры.Выпуск, Параметры.Адрес);

	Секция = Кит.Секция(Тексты.Текст("settings.account.tokens.title"),
			Реестр(Записи, Параметры.Адрес),
			ОкноЗаведения,
			ОкноСекрета(Параметры),
			Подтверждение(Записи, Параметры.Окно, Параметры.Адрес))
		.Лид(Тексты.Текст("settings.account.tokens.lead")).Иконка("ключ")
		.Действия(Кит.Кнопка(Тексты.Текст("settings.account.tokens.add")).Основная().Иконка("плюс")
			.Открывает(ОкноЗаведения));

	Результат = Новый Массив();
	Результат.Добавить(Секция);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Реестр

Функция Реестр(Знач Записи, Знач АдресРаздела)

	Рамки = РамкиТокенов(Записи);

	Реестр = Кит.Реестр().Подпись(Тексты.Текст("settings.account.tokens.title"))
		.Пусто(Тексты.Текст("settings.account.tokens.empty"));
	Для Каждого Запись Из Записи Цикл
		Реестр.Добавить(Запись(Запись, Рамки.Получить(Цел(Запись.Идентификатор)), АдресРаздела));
	КонецЦикла;
	Возврат Реестр;

КонецФункции

// Свёрнутая запись — права, где действует и срок плашками, префикс строкой; раскрытая — всё
// это свойствами. Единственное действие — «Отозвать» с подтверждением по адресу.
Функция Запись(Знач Запись, Знач Рамки, Знач АдресРаздела)

	Права = ПраваСловами(Запись.Права);

	Возврат Кит.ЗаписьРеестра(ИмяЗаписи(Запись),
			Кит.Свойства(
				Кит.Свойство(Тексты.Текст("settings.account.tokens.prop.prefix"), Кит.Код(Запись.Префикс))
					.Копируемое(Строка(Запись.Префикс)),
				Кит.Свойство(Тексты.Текст("settings.account.tokens.prop.scopes"), Права),
				Кит.Свойство(Тексты.Текст("settings.account.tokens.prop.where"), Кит.Текст(Рамки)),
				Кит.Свойство(Тексты.Текст("settings.account.tokens.prop.created"),
					Даты.ТолькоДата(Запись.Создан)),
				Кит.Свойство(Тексты.Текст("settings.account.tokens.prop.expires"), Срок(Запись.Истекает))))
		.Плашка(Кит.Плашка(Права))
		.Плашка(Кит.Плашка(Рамки))
		.Плашка(ПлашкаСрока(Запись.Истекает))
		.Подпись(Строка(Запись.Префикс))
		.Кнопки(Кит.ОкноПоАдресу(Окна.Адрес(АдресРаздела, "отозвать", Ключ(Запись)),
			Тексты.Текст("settings.account.tokens.revoke")).Опасная().Иконка("корзина"));

КонецФункции

// Срок цветом: истёк — красный, на исходе — жёлтый, впереди — зелёный. Пустой срок бывает
// только у ключей, выпущенных до запрета бессрочных.
Функция ПлашкаСрока(Знач Истекает)

	Если НЕ ЗначениеЗаполнено(Истекает) Тогда
		Возврат Кит.Плашка(Срок(Истекает)).Вид("warn");
	КонецЕсли;

	Сейчас = ТекущаяУниверсальнаяДата();
	Если Истекает <= Сейчас Тогда
		Возврат Кит.Плашка(Тексты.Шаблон("settings.account.tokens.term.expired", Даты.ТолькоДата(Истекает)))
			.Вид("err");
	КонецЕсли;

	Плашка = Кит.Плашка(Тексты.Шаблон("settings.account.tokens.term.until", Даты.ТолькоДата(Истекает)));
	Возврат Плашка.Вид(?(Истекает - Сейчас <= ДнейНаИсходе() * 86400, "warn", "ok"));

КонецФункции

// Две недели — столько, чтобы успеть выпустить новый ключ и переставить его в CI; тот же порог
// у секции кабинета «Токены на исходе».
Функция ДнейНаИсходе()
	Возврат 14;
КонецФункции

Функция Срок(Знач Истекает)
	Возврат ?(ЗначениеЗаполнено(Истекает), Даты.ТолькоДата(Истекает),
		Тексты.Текст("settings.account.tokens.term.never"));
КонецФункции

// Незнакомое право старой записи показывается как есть, а не прячется за прочерк.
Функция ПраваСловами(Знач Права)

	Названия = Новый Массив();
	Для Каждого Скоуп Из СтрРазделить(Строка(Права), ",", Ложь) Цикл
		Значение = НРег(СокрЛП(Скоуп));
		Если Значение = ГейтТокена.СкоупЧтения() Тогда
			Названия.Добавить(Тексты.Текст("settings.account.tokens.scope.read"));
		ИначеЕсли Значение = ГейтТокена.СкоупЗаписи() Тогда
			Названия.Добавить(Тексты.Текст("settings.account.tokens.scope.write"));
		ИначеЕсли ЗначениеЗаполнено(Значение) Тогда
			Названия.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат ?(Названия.Количество() > 0, СтрСоединить(Названия, ", "),
		Тексты.Текст("settings.account.tokens.scope.none"));

КонецФункции

// «Где действует» для всего списка сразу: наборы пулов — одним запросом, имена — вторым.
Функция РамкиТокенов(Знач Записи)

	НаборыПулов = СервисТокенов.НаборыПулов(Записи);
	Пулы = СервисПулов.ПулыПоИдентификаторам(НазванныеПулы(НаборыПулов));

	Результат = Новый Соответствие();
	Для Каждого Набор Из НаборыПулов Цикл
		Результат.Вставить(Набор.Ключ, РамкиСловами(Набор.Значение, Пулы));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НазванныеПулы(Знач НаборыПулов)

	Результат = Новый Массив();
	Для Каждого Набор Из НаборыПулов Цикл
		Для Каждого ПулИдентификатор Из Набор.Значение Цикл
			Если Результат.Найти(ПулИдентификатор) = Неопределено Тогда
				Результат.Добавить(ПулИдентификатор);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пусто означает «весь хаб», и написать это надо буквами: пустая плашка читается как «неизвестно».
Функция РамкиСловами(Знач НаборПулов, Знач Пулы)

	Если НаборПулов.Количество() = 0 Тогда
		Возврат Тексты.Текст("settings.account.tokens.where.hub");
	КонецЕсли;

	Имена = Новый Массив();
	Для Каждого ПулИдентификатор Из НаборПулов Цикл
		Пул = Пулы.Получить(Цел(ПулИдентификатор));
		Имена.Добавить(?(Пул = Неопределено,
			Тексты.Шаблон("settings.account.tokens.where.pool", Формат(ПулИдентификатор, "ЧГ=0")),
			Строка(Пул.Имя)));
	КонецЦикла;
	Возврат Тексты.Шаблон("settings.account.tokens.where.pools", СтрСоединить(Имена, ", "));

КонецФункции

#КонецОбласти

#Область Окна

// Секрет приходит только ответом на выпуск — по адресу это окно не открыть.
Функция ОкноСекрета(Знач Параметры)

	Если НЕ ЗначениеЗаполнено(Параметры.Секрет) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ОкноВыпуска.Выпущенный(Параметры.Секрет, Параметры.Адрес);

КонецФункции

// Отзыв своего токена, названного адресом; чужого и несуществующего на странице нет.
Функция Подтверждение(Знач Записи, Знач Состояние, Знач АдресРаздела)

	Если НЕ Окна.Открыто(Состояние, "отозвать") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Запись Из Записи Цикл
		Если Ключ(Запись) = Состояние.Ключ Тогда
			Возврат Кит.Подтверждение(
					Тексты.Шаблон("settings.account.tokens.revoke.title", ИмяЗаписи(Запись)),
					Тексты.Текст("settings.account.tokens.revoke.consequence"))
				.Кнопка(Тексты.Текст("settings.account.tokens.revoke"))
				.Форма(Ключ(Запись) + "/revoke").БезПерезагрузки().Якорь("token-otozvat").Открыто()
				.АдресЗакрытия(АдресРаздела);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Ключ(Знач Запись)
	Возврат Формат(Запись.Идентификатор, "ЧГ=0");
КонецФункции

Функция ИмяЗаписи(Знач Запись)
	Возврат ?(ЗначениеЗаполнено(Запись.Имя), Строка(Запись.Имя),
		Тексты.Текст("settings.account.tokens.unnamed"));
КонецФункции

#КонецОбласти

&Прозвище("ВитринаТокеновКабинета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "СервисТокенов") _СервисТокенов,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "ГейтТокена") _ГейтТокена,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ОкноВыпускаТокена") _ОкноВыпуска,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено) Экспорт

	Кит = _Кит;
	СервисТокенов = _СервисТокенов;
	СервисПулов = _СервисПулов;
	ГейтТокена = _ГейтТокена;
	Окна = _Окна;
	ОкноВыпуска = _ОкноВыпуска;
	Тексты = _Тексты;
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);

КонецПроцедуры
