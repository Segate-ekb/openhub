// Раздел «Привязки OIDC» дома «Аккаунт»: привязанные личности, отвязка с подтверждением по адресу
// и старт привязки. Последний способ входа не отвязывается.

Перем Гвард;              // ГвардКабинета
Перем Защита;             // ЗащитаCSRF (вход) — токен сессии дома
Перем Гейт;               // ГейтФормы — метод запроса и токен формы
Перем РазборФормы;
Перем СервисЛичностей;    // СервисЛичностей (вход)
Перем СервисВхода;        // СервисВходаOIDC (вход)
Перем СервисПользователей; // СервисПользователей (вход) — задан ли пароль
Перем ПарольныйВход;      // ПолитикаПарольногоВхода (вход) — открыт ли вход паролем
Перем Транзакции;         // ХранительТранзакцийOIDC (вход)
Перем КукаТранзакции;     // КукаТранзакцииOIDC (вход) — имя и атрибуты куки транзакции
Перем Конфигурация;       // КонфигурацияOIDC (вход)
Перем Ответы;             // ОтветыНастроек
Перем Дом;                // ДомАккаунта
Перем Витрина;            // ВитринаЛичностейКабинета — секции раздела
Перем Окна;               // ОкноРаздела — окно отвязки по адресу и ответы его формы
Перем ГейтВходаПоСтране;  // ГейтВходаПоСтране (вход) — закрыт ли провайдер посетителю
Перем Посетители;         // ПосетительЗапроса — адрес и заголовки одним значением
Перем ОтказСтраны;        // ОтказПоСтране — что сказать закрытому посетителю
Перем Тексты;             // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ТочкиМаршрута

// GET /me/settings/oidc — привязанные личности, окно отвязки по адресу и кнопки привязки.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента; по нему судится правило о стране.
//  saved - Строка - признак отвязки из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: отвязать-<номер личности> (необязательный,
//         по умолчанию "").
//
&ТочкаМаршрута("oidc")
Процедура Личности(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, АдресУдаленногоУзла,
	saved = "", окно = "") Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	ОтдатьРаздел(Ответ, Вердикт, КукиЗапроса, Посетители.Собрать(АдресУдаленногоУзла, ЗаголовкиЗапроса),
		200, Окна.ИзАдреса(окно, Витрина.ВидыОкон()), ЗначениеЗаполнено(saved));

КонецПроцедуры

// POST /me/settings/oidc/unlink — отвязка личности формой окна подтверждения. Без подтверждения
// ответ ведёт на окно; последний способ входа не отвязывается — отказ в окне.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента; по нему судится правило о стране
//                        (необязательный, по умолчанию "").
//
&ТочкаМаршрута("oidc/unlink")
Процедура Отвязать(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	АдресУдаленногоУзла = "") Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Форма = Гейт.ПринятаяФорма(Ответ, Вердикт, "POST", МетодЗапроса, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Номер = СокрЛП(РазборФормы.Поле(Форма, Витрина.ИмяПоляЛичности()));
	Личности = ЛичностиСмотрящего(Вердикт);
	Личность = Витрина.Личность(Личности, Номер);

	// чужая и несуществующая личность — молча к списку: её существование не раскрывается
	Если Личность = Неопределено Тогда
		Ответ.Перенаправить(АдресРаздела());
		Ответ.УстановитьСостояние(303);
		Возврат;
	КонецЕсли;

	// без скрипта форма уходит из меню без вопроса: личность не трогается, вопрос — окном
	Если НЕ Окна.Подтверждено(Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресРаздела(), Номер, Витрина.ВидОтвязки());
		Возврат;
	КонецЕсли;

	Если ПоследняяЛичность(Вердикт.Пользователь, Личности) Тогда
		Окно = Окна.Отбитое(Витрина.ВидОтвязки(), Номер, Форма, Неопределено,
			Тексты.Текст("settings.account.oidc.last"));
		ОтдатьРаздел(Ответ, Вердикт, КукиЗапроса, Посетители.Собрать(АдресУдаленногоУзла, ЗаголовкиЗапроса),
			409, Окно, Ложь);
		Возврат;
	КонецЕсли;

	СервисЛичностей.Отвязать(Вердикт.Пользователь.Идентификатор, Личность.Идентификатор);
	Окна.ВернутьВРаздел(Ответ, АдресРаздела());

КонецПроцедуры

// GET /me/settings/oidc/link/{провайдер} — старт привязки: браузер уходит на провайдера.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  провайдер - Строка - имя провайдера из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента; по нему судится правило о стране.
//
&ТочкаМаршрута("oidc/link/{провайдер}")
Процедура НачатьПривязку(Ответ, провайдер, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	АдресУдаленногоУзла) Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Посетитель = Посетители.Собрать(АдресУдаленногоУзла, ЗаголовкиЗапроса);

	Если Конфигурация.Провайдер(провайдер) = Неопределено Тогда
		ОтдатьРаздел(Ответ, Вердикт, КукиЗапроса, Посетитель, 200, Неопределено, Ложь,
			Тексты.Текст("settings.account.oidc.error.provider"));
		Возврат;
	КонецЕсли;

	Попытка
		Начало = СервисВхода.Начать(провайдер, Посетитель);
	Исключение
		ОтдатьРаздел(Ответ, Вердикт, КукиЗапроса, Посетитель, 200, Неопределено, Ложь,
			Тексты.Текст("settings.account.oidc.error.start"));
		Возврат;
	КонецПопытки;

	Если НЕ Начало.Успех Тогда
		ОтдатьРаздел(Ответ, Вердикт, КукиЗапроса, Посетитель, ОтказСтраны.Код(), Неопределено, Ложь,
			ОтказСтраны.ТекстПривязки(ОткрытыеПровайдеры(Посетитель).Количество()));
		Возврат;
	КонецЕсли;

	// признак ручной привязки: id текущего пользователя едет контекстом записи транзакции
	КукаТранзакции.Установить(Ответ,
		Транзакции.Сохранить(Начало.Транзакция, "", Вердикт.Пользователь.Идентификатор));
	Ответ.Перенаправить(Начало.URL);

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач КукиЗапроса, Знач Посетитель, Знач Статус, Знач Окно,
	Знач Сохранено, Знач Ошибка = "")

	Пользователь = Вердикт.Пользователь;
	Личности = ЛичностиСмотрящего(Вердикт);

	Параметры = Новый Структура();
	Параметры.Вставить("Адрес", АдресРаздела());
	Параметры.Вставить("Личности", Личности);
	Параметры.Вставить("ПоследняяЛичность", ПоследняяЛичность(Пользователь, Личности));
	Параметры.Вставить("АдресПароля", ?(ПарольныйВход.Выключен(), "", Дом.АдресРаздела("security")));
	Параметры.Вставить("Провайдеры", ОткрытыеПровайдеры(Посетитель));
	Параметры.Вставить("ПровайдерыЕсть", Конфигурация.ЕстьПровайдеры());
	Параметры.Вставить("Окно", Окно);

	Модель = Ответы.МодельДома(Дом, "",
		Дом.Разделы("oidc"),
		Ответы.УведомленияРаздела(Сохранено, Ошибка),
		Витрина.Секции(Параметры),
		Защита.ТокенСессии(Вердикт.Сессия));
	Модель.Заголовок = Дом.ЗаголовокУчётки(Пользователь.Логин);

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт, КукиЗапроса, Статус);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЛичностиСмотрящего(Знач Вердикт)
	Возврат СервисЛичностей.ЛичностиПользователя(Вердикт.Пользователь.Идентификатор);
КонецФункции

// Единственная личность — последний способ входа, когда пароля нет либо вход паролем выключен:
// без неё учётка осталась бы без входа.
Функция ПоследняяЛичность(Знач Пользователь, Знач Личности)
	Возврат Личности.Количество() <= 1
		И (НЕ СервисПользователей.ПарольЗадан(Пользователь) ИЛИ ПарольныйВход.Выключен());
КонецФункции

// Кнопка и отказ спрашивают одно правило: закрытого провайдера человек не видит вовсе.
Функция ОткрытыеПровайдеры(Знач Посетитель)
	Возврат ГейтВходаПоСтране.ПровайдерыДляПосетителя(Конфигурация.Провайдеры(), Посетитель);
КонецФункции

Функция АдресРаздела()
	Возврат Дом.АдресРаздела("oidc");
КонецФункции

#КонецОбласти

&Контроллер("/me/settings")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _Гвард,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисЛичностей") _СервисЛичностей,
	&Пластилин(Значение = "СервисВходаOIDC") _СервисВхода,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _ПарольныйВход,
	&Пластилин(Значение = "ХранительТранзакцийOIDC") _Транзакции,
	&Пластилин(Значение = "КукаТранзакцииOIDC") _КукаТранзакции,
	&Пластилин(Значение = "КонфигурацияOIDC") _Конфигурация,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомАккаунта") _Дом,
	&Пластилин(Значение = "ВитринаЛичностейКабинета") _Витрина,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ГейтВходаПоСтране") _ГейтВходаПоСтране,
	&Пластилин(Значение = "ПосетительЗапроса") _Посетители,
	&Пластилин(Значение = "ОтказПоСтране") _ОтказСтраны,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	Гвард = _Гвард;
	Защита = _Защита;
	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	СервисЛичностей = _СервисЛичностей;
	СервисВхода = _СервисВхода;
	СервисПользователей = _СервисПользователей;
	ПарольныйВход = _ПарольныйВход;
	Транзакции = _Транзакции;
	КукаТранзакции = _КукаТранзакции;
	Конфигурация = _Конфигурация;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	Окна = _Окна;
	ГейтВходаПоСтране = _ГейтВходаПоСтране;
	Посетители = _Посетители;
	ОтказСтраны = _ОтказСтраны;
	Тексты = _Тексты;

КонецПроцедуры
