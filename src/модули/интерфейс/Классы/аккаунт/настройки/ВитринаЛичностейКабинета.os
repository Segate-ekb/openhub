// Раздел «Привязки OIDC» дома «Аккаунт»: привязанные личности таблицей с ⚙ «Отвязать» (подтверждение
// по адресу; последний способ входа не отвязывается — окно называет причину) и кнопки привязки
// провайдеров, открытых посетителю.

Перем Кит;          // Кит (кит) — фабрика элементов экрана
Перем Окна;         // ОкноРаздела — окно по адресу и его состояние
Перем Обрезка;      // ОбрезаниеТекста (основа) — длинное значение в узкой колонке
Перем Атрибуция;    // АтрибуцияБазыСтран — условие лицензии базы стран
Перем ОтказСтраны;  // ОтказПоСтране — что сказать посетителю, которому закрыты все провайдеры
Перем ЗначкиПровайдеров; // ЗначокПровайдера — значок издателя и кнопки привязки
Перем Тексты;       // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Виды окон раздела, которые открывает адрес ?окно=<вид>-<номер личности>.
//
// Возвращаемое значение:
//  Строка - виды через запятую.
//
Функция ВидыОкон() Экспорт
	Возврат ВидОтвязки();
КонецФункции

// Вид окна отвязки личности.
//
// Возвращаемое значение:
//  Строка.
//
Функция ВидОтвязки() Экспорт
	Возврат "отвязать";
КонецФункции

// Поле формы отвязки с номером личности.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляЛичности() Экспорт
	Возврат "личность";
КонецФункции

// Секции раздела.
//
// Параметры:
//  Параметры - Структура:
//    * Адрес - Строка - адрес раздела: от него строятся адреса окон;
//    * Личности - Массив из ВнешняяЛичность - личности смотрящего;
//    * ПоследняяЛичность - Булево - отвязка единственной личности оставит учётку без способа входа;
//    * АдресПароля - Строка - куда вести, чтобы задать пароль; "" — вход паролем выключен;
//    * Провайдеры - Массив - провайдеры, открытые посетителю;
//    * ПровайдерыЕсть - Булево - настроен ли хоть один провайдер;
//    * Окно - Структура, Неопределено - состояние окна раздела (см. ОкноРаздела.Отбитое).
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - секция привязок с открытым окном и секция привязки провайдеров.
//
Функция Секции(Знач Параметры) Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Кит.Секция(Тексты.Текст("settings.account.oidc.title"),
			ТаблицаЛичностей(Параметры.Личности, Параметры.Провайдеры, Параметры.Адрес),
			ОкноОтвязки(Параметры))
		.Лид(Тексты.Текст("settings.account.oidc.lead")).Иконка("ссылка"));
	Результат.Добавить(СекцияПривязки(Параметры.Провайдеры, Параметры.ПровайдерыЕсть, Параметры.Адрес));
	Возврат Результат;

КонецФункции

// Напечатает ли раздел окно, которое называет состояние: личность с этим номером есть у смотрящего.
//
// Параметры:
//  Состояние - Структура, Неопределено - состояние окна раздела.
//  Личности - Массив из ВнешняяЛичность - личности смотрящего.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьОкно(Знач Состояние, Знач Личности) Экспорт
	Возврат ЛичностьОкна(Состояние, Личности) <> Неопределено;
КонецФункции

// Личность смотрящего по номеру.
//
// Параметры:
//  Личности - Массив из ВнешняяЛичность - личности смотрящего.
//  Номер - Строка - номер личности.
//
// Возвращаемое значение:
//  ВнешняяЛичность, Неопределено - личность; Неопределено — у смотрящего такой нет.
//
Функция Личность(Знач Личности, Знач Номер) Экспорт

	Для Каждого Личность Из Личности Цикл
		Если НомерЛичности(Личность) = СокрЛП(Строка(Номер)) Тогда
			Возврат Личность;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область Таблица

// На узком экране — карточки с провайдером заглавием и ⚙ в углу; адреса почты нет — прочерк.
Функция ТаблицаЛичностей(Знач Личности, Знач Провайдеры, Знач Адрес)

	Записи = Новый Массив();
	Для Каждого Личность Из Личности Цикл
		Записи.Добавить(Новый Структура("issuer, account, email, actions",
			ИздательСоЗначком(Личность, Провайдеры),
			АккаунтУПровайдера(Личность),
			Строка(Личность.Email),
			Меню(Личность, Адрес)));
	КонецЦикла;

	Таблица = Кит.Таблица(Записи).Вид("карточками").Пустое("—")
		.Пусто(Тексты.Текст("settings.account.oidc.empty"));
	Таблица.Колонка("issuer", Тексты.Текст("settings.account.oidc.col.issuer")).Заглавная();
	Таблица.Колонка("account", Тексты.Текст("settings.account.oidc.col.account"));
	Таблица.Колонка("email", Тексты.Текст("settings.account.oidc.col.email"));
	Таблица.Колонка("actions", "").Вид("узкая").БезПодписиВЗаписи();
	Возврат Таблица;

КонецФункции

// Значок издателя — значок его провайдера; провайдера уже нет или он закрыт — по издателю.
// Издатели сравниваются без регистра и хвостовой косой черты.
Функция ИздательСоЗначком(Знач Личность, Знач Провайдеры)

	Издатель = Строка(Личность.Издатель);
	Провайдер = Новый Структура("Издатель", Издатель);
	Для Каждого Открытый Из Провайдеры Цикл
		Если Открытый.Свойство("Издатель") И ОдинИздатель(Открытый.Издатель, Издатель) Тогда
			Провайдер = Открытый;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Кит.Холст(Кит.Иконка(Новый Структура("Имя", ЗначкиПровайдеров.Имя(Провайдер))),
		Кит.Текст(" " + Издатель));

КонецФункции

Функция ОдинИздатель(Знач Первый, Знач Второй)
	Возврат ИздательБезХвоста(Первый) = ИздательБезХвоста(Второй);
КонецФункции

Функция ИздательБезХвоста(Знач Издатель)
	Адрес = НРег(СокрЛП(Строка(Издатель)));
	Пока СтрЗаканчиваетсяНа(Адрес, "/") Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	Возврат Адрес;
КонецФункции

// Субъект — машинный ключ связки: он показывается, только когда логина нет; предел стоит
// на том, что показано, полное значение — в подсказке.
Функция АккаунтУПровайдера(Знач Личность)

	Значение = СокрЛП(Строка(Личность.ПредпочтительныйЛогин));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Значение = СокрЛП(Строка(Личность.Субъект));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Показанное = Обрезка.СМноготочием(Значение, ПределАккаунтаВТаблице());
	Возврат ?(Показанное = Значение, Кит.Код(Значение), Кит.Код(Показанное).Подсказка(Значение));

КонецФункции

Функция ПределАккаунтаВТаблице()
	Возврат 24;
КонецФункции

// Отвязка — окном по адресу: подтверждение либо причина, по которой отвязать нельзя.
Функция Меню(Знач Личность, Знач Адрес)
	Возврат Кит.Меню(Тексты.Шаблон("settings.account.oidc.menu", Строка(Личность.Издатель)),
		Кит.ОкноПоАдресу(Окна.Адрес(Адрес, ВидОтвязки(), НомерЛичности(Личность)),
			Тексты.Текст("settings.account.oidc.unlink")).Опасная().Иконка("закрыть"));
КонецФункции

#КонецОбласти

#Область Окно

// Последний способ входа отвязать нельзя: учётка осталась бы без входа. Окно называет причину
// и ведёт задать пароль; формы отвязки в нём нет.
Функция ОкноОтвязки(Знач Параметры)

	Состояние = Параметры.Окно;
	Личность = ЛичностьОкна(Состояние, Параметры.Личности);
	Если Личность = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли Параметры.ПоследняяЛичность Тогда
		Возврат ОкноПоследнегоСпособа(Личность, Параметры.АдресПароля, Параметры.Адрес);
	КонецЕсли;

	Возврат Кит.Подтверждение(Тексты.Шаблон("settings.account.oidc.unlink.title", Строка(Личность.Издатель)),
			Тексты.Текст("settings.account.oidc.unlink.consequence"),
			ОшибкаОкна(Состояние),
			Кит.СкрытоеПоле(ИмяПоляЛичности(), НомерЛичности(Личность)))
		.Кнопка(Тексты.Текст("settings.account.oidc.unlink"))
		.Форма("unlink").Якорь("lichnost-otvyazat").Открыто().АдресЗакрытия(Параметры.Адрес);

КонецФункции

Функция ОкноПоследнегоСпособа(Знач Личность, Знач АдресПароля, Знач АдресРаздела)

	Возврат Кит.Окно(Тексты.Шаблон("settings.account.oidc.unlink.title", Строка(Личность.Издатель)),
			Кит.Уведомление(Тексты.Текст("settings.account.oidc.last")).Вид("warn"))
		.Якорь("lichnost-poslednyaya").Открыто().АдресЗакрытия(АдресРаздела)
		.Действия(Кит.Кнопка(Тексты.Текст("settings.account.oidc.password")).Основная().Иконка("замок")
			.Адрес(АдресПароля).Когда(ЗначениеЗаполнено(АдресПароля)));

КонецФункции

Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

Функция ЛичностьОкна(Знач Состояние, Знач Личности)

	Если НЕ Окна.Открыто(Состояние, ВидОтвязки()) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Личность(Личности, Состояние.Ключ);

КонецФункции

#КонецОбласти

#Область Привязка

// Кнопки привязки провайдеров, открытых посетителю; без провайдеров — строка: «не настроены»
// либо отказ по стране, если закрыты все.
Функция СекцияПривязки(Знач Провайдеры, Знач ПровайдерыЕсть, Знач Адрес)

	Секция = Кит.Секция(Тексты.Текст("settings.account.oidc.link.title"))
		.Лид(Тексты.Текст("settings.account.oidc.link.lead")).Иконка("плюс");

	Если Провайдеры.Количество() = 0 Тогда
		Секция.Добавить(Кит.Примечание(?(ПровайдерыЕсть, ОтказСтраны.ТекстПривязки(0),
			Тексты.Текст("settings.account.oidc.link.none"))));
	Иначе
		Ряд = Кит.Ряд("действия");
		Для Каждого Провайдер Из Провайдеры Цикл
			Ряд.Добавить(КнопкаПривязки(Провайдер, Адрес));
		КонецЦикла;
		Секция.Добавить(Ряд);
	КонецЕсли;

	Секция.Добавить(Атрибуция.Примечание());
	Возврат Секция;

КонецФункции

// Привязка начинается переходом: браузер уйдёт на провайдера.
Функция КнопкаПривязки(Знач Провайдер, Знач АдресРаздела)
	Возврат Кит.Кнопка(Тексты.Шаблон("settings.account.oidc.link.button", Строка(Провайдер.Метка)))
		.Вторичная().Иконка(ЗначкиПровайдеров.Имя(Провайдер))
		.Адрес(АдресРаздела + "/link/" + КодироватьСтроку(Провайдер.Имя, СпособКодированияСтроки.КодировкаURL));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НомерЛичности(Знач Личность)
	Возврат Формат(Личность.Идентификатор, "ЧГ=0; ЧН=0");
КонецФункции

#КонецОбласти

&Прозвище("ВитринаЛичностейКабинета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "АтрибуцияБазыСтран") _Атрибуция,
	&Пластилин(Значение = "ОтказПоСтране") _ОтказСтраны,
	&Пластилин(Значение = "ЗначокПровайдера") _ЗначкиПровайдеров,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ОбрезаниеТекста") _Обрезка = Неопределено) Экспорт

	Кит = _Кит;
	Окна = _Окна;
	Атрибуция = _Атрибуция;
	ОтказСтраны = _ОтказСтраны;
	ЗначкиПровайдеров = _ЗначкиПровайдеров;
	Тексты = _Тексты;
	Обрезка = ?(_Обрезка = Неопределено, Новый ОбрезаниеТекста(), _Обрезка);

КонецПроцедуры
