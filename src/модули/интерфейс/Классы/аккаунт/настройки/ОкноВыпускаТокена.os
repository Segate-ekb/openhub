// Окна раздела «Токены доступа»: «Новый токен» тремя шагами — имя и права, где действует
// (дерево пулов с поиском через сервер), срок — и окно выпущенного токена, единственное место,
// где виден его секрет. Владелец имён полей формы выпуска.

Перем Кит;     // Кит (кит) — фабрика элементов экрана
Перем Окна;    // ОкноРаздела — значения и отказы отбитой формы
Перем Плашки;  // ПлашкиПула — видимость пула словами
Перем Тексты;  // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ИменаПолей

// Имя поля, в котором едет название токена.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПоляИмени() Экспорт
	Возврат "имя";
КонецФункции

// Имя флажка права чтения.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПоляЧтения() Экспорт
	Возврат "чтение";
КонецФункции

// Имя флажка права записи.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПоляЗаписи() Экспорт
	Возврат "запись";
КонецФункции

// Имя сегментов «где действует»: весь хаб или выбранные пулы.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПоляГде() Экспорт
	Возврат "где";
КонецФункции

// Значение сегмента «где действует» для выбранных пулов; любое другое — весь хаб.
//
// Возвращаемое значение:
//  Строка
//
Функция ГдеПулы() Экспорт
	Возврат "пулы";
КонецФункции

// Значение сегмента «где действует» для всего хаба.
//
// Возвращаемое значение:
//  Строка
//
Функция ГдеХаб() Экспорт
	Возврат "хаб";
КонецФункции

// Имя галки пула: у всех галок одно, значение — идентификатор пула.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПоляПулов() Экспорт
	Возврат "пулы";
КонецФункции

// Имя поля срока в днях.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПоляСрока() Экспорт
	Возврат "срок_дней";
КонецФункции

// Имя поля строки поиска над деревом пулов — его печатает кит.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПоляПоиска() Экспорт
	Возврат "найти";
КонецФункции

// Имя кнопок «Включить / Снять найденные» под ответом поиска — их печатает кит; без скрипта
// они отправляют форму выпуска со значением «вкл» или «выкл».
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПоляНайденных() Экспорт
	Возврат "найденные";
КонецФункции

#КонецОбласти

#Область Окна

// Окно «Новый токен» — на странице всегда, открытым — когда его назвал адрес, вернулась отбитая
// форма или ответил поиск пулов. Форма уходит обычной отправкой, а не в фоне: ответ выпуска несёт
// секрет, и он ложится свежей страницей с открытым окном, а не в адрес.
//
// Параметры:
//  Параметры - Структура:
//    * Состояние - Структура, Неопределено - состояние окна (см. ОкноРаздела.Отбитое);
//    * Открыто - Булево - окно печатается открытым;
//    * Адрес - Строка - адрес страницы с этим окном открытым (?окно=новый): без скрипта туда
//      ведёт кнопка окна;
//    * Заявка - Структура - набранная заявка (см. ПультТокеновКабинета.Заявка);
//    * Пулы - Массив из Пул - пулы, которые смотрящему видны;
//    * Найдено - Строка, Неопределено - строка поиска, если окно — ответ поиска пулов;
//    * АдресПоиска - Строка - адрес поиска пулов;
//    * Срок - Число - потолок срока в днях.
//  АдресРаздела - Строка - раздел без окна: туда окно закрывается.
//
// Возвращаемое значение:
//  ЭлементЭкрана - окно.
//
Функция Выпуск(Знач Параметры, Знач АдресРаздела) Экспорт

	Состояние = Параметры.Состояние;
	Заявка = Параметры.Заявка;

	Возврат Кит.Окно(Тексты.Текст("settings.account.tokens.window.new"),
			ОшибкаОкна(Состояние),
			Кит.Шаги(
				Кит.Шаг(Тексты.Текст("settings.account.tokens.step.name"),
					ПолеИмени(Заявка, Состояние),
					Права(Заявка, Состояние)),
				ШагГдеДействует(Параметры),
				Кит.Шаг(Тексты.Текст("settings.account.tokens.step.term"),
					ПолеСрока(Заявка, Состояние, Параметры.Срок)))
				.Кнопка(Тексты.Текст("settings.account.tokens.issue")))
		.Форма("").Якорь("token-novyi").Адрес(Параметры.Адрес).Открыто(Параметры.Открыто)
		.АдресЗакрытия(АдресРаздела);

КонецФункции

// Окно выпущенного токена: секрет — один раз, здесь, с кнопкой копирования. Окно — ответ формы
// выпуска, поэтому крестик, «Закрыть» и Esc уводят переходом на раздел без секрета и со скриптом:
// закрытие на месте оставило бы секрет на странице, а вкладку — на ответе формы.
//
// Параметры:
//  Секрет - Строка - значение токена.
//  АдресРаздела - Строка - адрес раздела токенов.
//
// Возвращаемое значение:
//  ЭлементЭкрана - окно, напечатанное открытым.
//
Функция Выпущенный(Знач Секрет, Знач АдресРаздела) Экспорт

	Возврат Кит.Окно(Тексты.Текст("settings.account.tokens.issued.title"),
			Кит.Свойства(
				Кит.Свойство(Тексты.Текст("settings.account.tokens.issued.token"), Кит.Код(Секрет))
					.Копируемое(Секрет)))
		.Лид(Тексты.Текст("settings.account.tokens.issued.lead"))
		.Якорь("token-vypushchen").Открыто()
		.АдресЗакрытия(АдресРаздела).Переходом();

КонецФункции

#КонецОбласти

#Область Шаги

Функция ОшибкаОкна(Знач Состояние)

	Текст = Окна.Ошибка(Состояние);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Уведомление(Текст).Вид("err");

КонецФункции

Функция ПолеИмени(Знач Заявка, Знач Состояние)

	Возврат Кит.Поле(ИмяПоляИмени(), Тексты.Текст("settings.account.tokens.field.name"))
		.Значение(Заявка.Имя)
		.Пример(Тексты.Текст("settings.account.tokens.field.name.example"))
		.Подсказка(Тексты.Текст("settings.account.tokens.field.name.hint"))
		.Ошибка(Окна.Отказ(Состояние, ИмяПоляИмени()));

КонецФункции

// Флажки, а не строка: опечатка во вписанном праве дала бы токен, который молча ничего не может.
Функция Права(Знач Заявка, Знач Состояние)

	Возврат Кит.Группа(Тексты.Текст("settings.account.tokens.field.rights"),
		Флажок(ИмяПоляЧтения(), Тексты.Текст("settings.account.tokens.field.read"), Заявка.Чтение)
			.Ошибка(Окна.Отказ(Состояние, ИмяПоляЧтения())),
		Флажок(ИмяПоляЗаписи(), Тексты.Текст("settings.account.tokens.field.write"), Заявка.Запись))
		.Вид("простая");

КонецФункции

Функция ШагГдеДействует(Знач Параметры)

	Шаг = Кит.Шаг(Тексты.Текст("settings.account.tokens.step.where"), ГдеДействует(Параметры));
	// ответ поиска пулов открывает окно там, где искали
	Если Параметры.Найдено <> Неопределено Тогда
		Шаг.Текущий();
	КонецЕсли;
	Возврат Шаг;

КонецФункции

// Пулов не видно — выбирать не из чего: токен действует на весь хаб, и окно так и говорит.
Функция ГдеДействует(Знач Параметры)

	Если Параметры.Пулы.Количество() = 0 Тогда
		Возврат Кит.Холст(
			Кит.Примечание(Тексты.Текст("settings.account.tokens.field.where.nopools")),
			Кит.СкрытоеПоле(ИмяПоляГде(), ГдеХаб()));
	КонецЕсли;

	Возврат Кит.Сегменты(ИмяПоляГде(),
			Кит.Сегмент(ГдеХаб(), Тексты.Текст("settings.account.tokens.field.where.hub")),
			Кит.Сегмент(ГдеПулы(), Тексты.Текст("settings.account.tokens.field.where.pools"),
				ВыборПулов(Параметры)))
		.Подпись(Тексты.Текст("settings.account.tokens.field.where"))
		.Выбрано(?(Параметры.Заявка.Где = ГдеПулы(), ГдеПулы(), ГдеХаб()));

КонецФункции

// Пулы — корень дерева галок без веток. На окне — первые ПределПоказа() и честная строка
// усечения: окно стоит на каждой странице раздела, а пулов у администратора сотни; остальные
// находит поиск через сервер, и его ответ печатает совпадения на месте пулов.
Функция ВыборПулов(Знач Параметры)

	Подходящие = ?(Параметры.Найдено = Неопределено, Параметры.Пулы,
		ПулыПоПоиску(Параметры.Пулы, Параметры.Найдено));
	Показанные = Первые(Подходящие);

	Дерево = Кит.ДеревоГалок(УзлыПулов(Показанные, Параметры.Заявка.Пулы))
		.Подпись(Тексты.Текст("settings.account.tokens.field.pools"))
		.Поиск(Параметры.АдресПоиска);
	Если Параметры.Найдено <> Неопределено Тогда
		Дерево.Найдено(Параметры.Найдено, Подходящие.Количество());
	КонецЕсли;

	Возврат Кит.Холст(Дерево,
		СтрокаУсечения(Параметры, Показанные.Количество(), Подходящие.Количество()),
		ОтмеченныеВнеПоказа(Параметры, Показанные));

КонецФункции

// Ответ поиска строку «показаны N из M» печатает кит; здесь — она же у стартового дерева.
Функция СтрокаУсечения(Знач Параметры, Знач Показано, Знач Всего)

	Если Параметры.Найдено <> Неопределено ИЛИ Показано >= Всего Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Примечание(Тексты.Шаблон("settings.account.tokens.field.pools.cut",
		Формат(Показано, "ЧГ=0"), Формат(Всего, "ЧГ=0")));

КонецФункции

Функция УзлыПулов(Знач Пулы, Знач Отмеченные)

	Результат = Новый Массив();
	Для Каждого Пул Из Пулы Цикл
		Признаки = Новый Массив();
		Признаки.Добавить(Плашки.ПлашкаВидимости(Пул));
		Результат.Добавить(Новый Структура("Имя, Значение, Подпись, Состояние, Признаки",
			ИмяПоляПулов(), Идентификатор(Пул), Строка(Пул.Имя),
			?(Отмеченные.Найти(Идентификатор(Пул)) = Неопределено, "выкл", "вкл"), Признаки));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Отмеченные пулы, которых на окне нет (за пределом показа или вне ответа поиска), едут скрытыми
// полями — иначе поиск снимал бы их молча — и названы словами. Едут только видимые смотрящему
// пулы: идентификатор, которого он не видит, обратно не печатается.
Функция ОтмеченныеВнеПоказа(Знач Параметры, Знач Показанные)

	НаОкне = Новый Соответствие();
	Для Каждого Пул Из Показанные Цикл
		НаОкне.Вставить(Идентификатор(Пул), Истина);
	КонецЦикла;

	Холст = Кит.Холст();
	Имена = Новый Массив();
	Для Каждого Пул Из Параметры.Пулы Цикл
		Значение = Идентификатор(Пул);
		Если НаОкне.Получить(Значение) = Неопределено И Параметры.Заявка.Пулы.Найти(Значение) <> Неопределено Тогда
			Холст.Добавить(Кит.СкрытоеПоле(ИмяПоляПулов(), Значение));
			Имена.Добавить(Строка(Пул.Имя));
		КонецЕсли;
	КонецЦикла;
	Если Имена.Количество() > 0 Тогда
		Холст.Добавить(Кит.Примечание(Тексты.Шаблон("settings.account.tokens.field.pools.marked",
			СтрСоединить(Имена, ", "))));
	КонецЕсли;
	Возврат Холст;

КонецФункции

// Поле объявлено обязательным, и сервер требует его так же строго.
Функция ПолеСрока(Знач Заявка, Знач Состояние, Знач Потолок)

	Возврат Кит.Поле(ИмяПоляСрока(), Тексты.Текст("settings.account.tokens.field.term"))
		.ТипЗначения(Тип("Число")).Значение(Заявка.Срок).Пределы(1, Потолок).Обязательное()
		.Подсказка(Тексты.Шаблон("settings.account.tokens.field.term.hint", Формат(Потолок, "ЧГ=0")))
		.Ошибка(Окна.Отказ(Состояние, ИмяПоляСрока()));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сколько пулов окно показывает до поиска: подбор остаётся читаемым и на сотнях пулов.
//
// Возвращаемое значение:
//  Число
//
Функция ПределПоказа() Экспорт
	Возврат 20;
КонецФункции

Функция Первые(Знач Пулы)

	Результат = Новый Массив();
	Для Позиция = 0 По Мин(Пулы.Количество(), ПределПоказа()) - 1 Цикл
		Результат.Добавить(Пулы[Позиция]);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пулы, чьё имя содержит подстроку: регистр не важен, пустая подстрока не сужает ничего.
//
// Параметры:
//  Пулы - Массив из Пул - где искать.
//  Поиск - Строка - подстрока имени.
//
// Возвращаемое значение:
//  Массив из Пул.
//
Функция ПулыПоПоиску(Знач Пулы, Знач Поиск) Экспорт

	Подстрока = НРег(СокрЛП(Строка(Поиск)));
	Если НЕ ЗначениеЗаполнено(Подстрока) Тогда
		Возврат Пулы;
	КонецЕсли;

	Результат = Новый Массив();
	Для Каждого Пул Из Пулы Цикл
		Если СтрНайти(НРег(Строка(Пул.Имя)), Подстрока) > 0 Тогда
			Результат.Добавить(Пул);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Идентификатор пула строкой — так его отправляет галка.
//
// Параметры:
//  Пул - Пул - пул.
//
// Возвращаемое значение:
//  Строка
//
Функция Идентификатор(Знач Пул) Экспорт
	Возврат Формат(Пул.Идентификатор, "ЧГ=0");
КонецФункции

Функция Флажок(Знач Имя, Знач Метка, Знач Отмечено)
	Возврат Кит.Поле(Имя, Метка).ТипЗначения(Тип("Булево")).Отмечено(Отмечено = Истина);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ПлашкиПула") _Плашки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	Окна = _Окна;
	Плашки = _Плашки;
	Тексты = _Тексты;

КонецПроцедуры
