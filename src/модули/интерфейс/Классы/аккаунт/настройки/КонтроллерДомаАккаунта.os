// Дом настроек «Аккаунт» (/me/settings): профиль, пароль, права и оформление. Отказ формы —
// под полем, к которому он относится.

Перем Гвард;               // ГвардКабинета
Перем Ответы;              // ОтветыНастроек
Перем Сбои;              // ТекстСбоя — причина сбоя человеку и отчёт в журнал
Перем Дом;                 // ДомАккаунта
Перем Кит;                 // Кит (кит) — фабрика элементов экрана
Перем Гейт;                // ГейтФормы — метод запроса и токен формы
Перем Защита;              // ЗащитаCSRF (вход)
Перем РазборФормы;
Перем СервисПользователей; // СервисПользователей (вход)
Перем СменаАдреса;         // СменаАдресаУчётки (вход) — смена адреса с письмом подтверждения
Перем ВитринаАдреса;       // ВитринаПодтвержденияАдреса — секция и исход письма
Перем Отказы;              // ОтказыУчётки (вход) — причина и статус отказа
Перем ПолитикаПароля;      // ПолитикаПароля (вход)
Перем Подсказка;           // ПодсказкаПароля — требования под полем нового пароля
Перем ПарольныйВход;       // ПолитикаПарольногоВхода (вход)
Перем ВитринаПрав;         // ВитринаМоихПрав — секции «мои права» и «мои группы»
Перем ВыборВида;           // ВыборОформления (кит) — запись cookie оформления
Перем ВитринаВида;         // ВитринаВидаИЯзыка — секция «Вид и язык» и значение её cookie
Перем Тексты;              // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Отметка;             // ОтметкаСохранения — «сохранено» параметром на адресе
Перем Окна;                // ОкноРаздела — отбитая форма раздела: набранное и отказы у полей

#Область ТочкиМаршрута

// GET /me/settings — вход в дом: раздел по умолчанию, кабинет.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//
&ТочкаМаршрута("settings")
Процедура Обзор(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Ответ.Перенаправить(Дом.АдресРаздела(Дом.РазделПоУмолчанию()));

КонецПроцедуры

// GET/POST /me/settings/{раздел}
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  раздел - Строка - ключ раздела.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  АдресУдаленногоУзла - Строка - адрес клиента, попадает в журнал аудита.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//
&ТочкаМаршрута("settings/{раздел}")
Процедура Раздел(Ответ, раздел, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	АдресУдаленногоУзла, saved = "") Экспорт

	Ключ = НРег(СокрЛП(Строка(раздел)));

	// раздел «безопасность» = страница смены пароля: гвард не должен редиректить на неё саму
	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса, Ключ = "security");
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Дом.ЕстьРаздел(Ключ) Тогда
		Ответы.ОтдатьНеНайдено(Ответ, Вердикт,
			Тексты.Текст("settings.account.error.section"), КукиЗапроса);
		Возврат;
	КонецЕсли;
	// кабинет живёт на своём адресе: здесь его секций нет
	Если Ключ = Дом.РазделКабинета() Тогда
		Ответ.Перенаправить(Дом.АдресКабинета());
		Возврат;
	КонецЕсли;

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьРаздел(Ответ, Вердикт, Ключ, ЗначениеЗаполнено(saved), "", КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Гейт.ПринятаяФорма(Ответ, Вердикт, "GET, POST", МетодЗапроса, ТелоЗапроса,
		КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Сохранить(Ответ, Вердикт, Ключ, Форма, КукиЗапроса, Строка(АдресУдаленногоУзла));

КонецПроцедуры

#КонецОбласти

#Область Сохранение

// Общий предохранитель дома: исключение из служб не должно уходить пользователю голой 500-й.
Процедура Сохранить(Ответ, Знач Вердикт, Знач Ключ, Знач Форма, Знач КукиЗапроса, Знач АдресКлиента)

	Если НЕ РазделПринимаетPOST(Ключ) Тогда
		// раздел только для чтения — POST на него не имеет смысла
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Попытка
		Если Ключ = "profile" Тогда
			ПравитьПрофиль(Ответ, Вердикт, Форма, КукиЗапроса, АдресКлиента);
		ИначеЕсли Ключ = "security" Тогда
			СменитьПароль(Ответ, Вердикт, Форма, КукиЗапроса);
		ИначеЕсли Ключ = "appearance" Тогда
			СохранитьОформление(Ответ, Форма);
		КонецЕсли;
	Исключение
		// причина и статус — из общей таблицы отказов: здесь отвечают так же, как в API;
		// отказ формы адреса ложится под поле почты, отказ повтора письма — уведомлением
		Отказ = Отказы.Разобрать(ИнформацияОбОшибке());
		Если Ключ = "profile" И РазборФормы.Поле(Форма, ПолеПочты(), Неопределено) <> Неопределено Тогда
			ОтдатьОтбитое(Ответ, Вердикт, Ключ, КукиЗапроса, Отказ.Статус, Форма,
				ОтказПоля(ПолеПочты(), ТекстСбоя(Отказ)));
		Иначе
			ОтдатьРаздел(Ответ, Вердикт, Ключ, Ложь, ТекстСбоя(Отказ), КукиЗапроса, Отказ.Статус);
		КонецЕсли;
	КонецПопытки;

КонецПроцедуры

// Занятый адрес — названная человеку причина: доменный код на экран не показывают.
Функция ТекстСбоя(Знач Отказ)

	Если Отказ.Причина = Отказы.АдресЗанят() Тогда
		Возврат Тексты.Текст("settings.account.error.email.taken");
	КонецЕсли;
	// исключение без текста бывает: пустую строку человеку не показывают, у ОтветыНастроек
	// для этого случая есть запасное объяснение
	Возврат Тексты.Шаблон("settings.account.error.save", Сбои.ПонятныйТекст(Отказ.Сообщение));

КонецФункции

// Разделы дома «Аккаунт», у которых есть мутация. Витрина «мои права» POST не принимает.
Функция РазделПринимаетPOST(Знач Ключ)
	Возврат Ключ = "profile" ИЛИ Ключ = "security" ИЛИ Ключ = "appearance";
КонецФункции

// Две формы раздела — адрес и повтор письма; прочее — отказ без записи: пустой адрес снял бы почту.
Процедура ПравитьПрофиль(Ответ, Знач Вердикт, Знач Форма, Знач КукиЗапроса, Знач АдресКлиента)

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, ВитринаАдреса.ИмяПоляОперации())));
	Адрес = РазборФормы.Поле(Форма, ПолеПочты(), Неопределено);

	Если Операция = ВитринаАдреса.ОперацияПовтора() Тогда
		ВыслатьПисьмо(Ответ, Вердикт, КукиЗапроса, АдресКлиента);
	ИначеЕсли НЕ ЗначениеЗаполнено(Операция) И Адрес <> Неопределено Тогда
		СохранитьПрофиль(Ответ, Вердикт, Адрес, КукиЗапроса, АдресКлиента);
	Иначе
		ОтдатьРаздел(Ответ, Вердикт, "profile", Ложь,
			Тексты.Текст("settings.account.error.form"), КукиЗапроса, 400);
	КонецЕсли;

КонецПроцедуры

// Без письма — POST-редирект-GET; исход письма печатается на странице: редирект потерял бы его.
Процедура СохранитьПрофиль(Ответ, Знач Вердикт, Знач Адрес, Знач КукиЗапроса, Знач АдресКлиента)

	// занятый и невалидный адрес — исключения; их ловит предохранитель Сохранить, и он же
	// подбирает текст. Отказ приходит ДО записи, то есть и до письма подтверждения
	Смена = СменаАдреса.Сменить(Вердикт.Пользователь, Адрес, АдресКлиента);

	Если Смена.Письмо = Неопределено Тогда
		Ответ.Перенаправить(Отметка.НаАдресе(Дом.АдресРаздела("profile")));
		Возврат;
	КонецЕсли;

	// адрес записан в любом случае, поэтому несостоявшееся письмо — предупреждение, а не ошибка
	ОПисьме = ВитринаАдреса.УведомлениеОПисьме(Смена.Письмо, Вердикт.Пользователь, "warn");
	ОтдатьПрофиль(Ответ, Вердикт, КукиЗапроса, Истина, 200, ОПисьме);

КонецПроцедуры

// Письмо уходит только на адрес самой учётки: получателя форма не называет.
Процедура ВыслатьПисьмо(Ответ, Знач Вердикт, Знач КукиЗапроса, Знач АдресКлиента)

	Итог = СменаАдреса.ВыслатьПисьмо(Вердикт.Пользователь, АдресКлиента);

	ОПисьме = ВитринаАдреса.УведомлениеОПисьме(Итог, Вердикт.Пользователь, "err");
	ОтдатьПрофиль(Ответ, Вердикт, КукиЗапроса, Ложь, ВитринаАдреса.КодОтвета(Итог), ОПисьме);

КонецПроцедуры

// Отказ — под полем, которое его вызвало; пароли обратно в поля не печатаются.
Процедура СменитьПароль(Ответ, Знач Вердикт, Знач Форма, Знач КукиЗапроса)

	Пользователь = Вердикт.Пользователь;
	НовыйПароль = РазборФормы.Поле(Форма, ПолеНовогоПароля());
	Повтор = РазборФормы.Поле(Форма, ПолеПовтора());

	Если НЕ ТекущийПарольПодтверждён(Пользователь, РазборФормы.Поле(Форма, ПолеТекущегоПароля())) Тогда
		ОтдатьОтбитое(Ответ, Вердикт, "security", КукиЗапроса, 400, Неопределено,
			ОтказПоля(ПолеТекущегоПароля(), Тексты.Текст("settings.account.error.password.current")));
		Возврат;
	КонецЕсли;
	Если НЕ ПолитикаПароля.Допустим(НовыйПароль) Тогда
		ОтдатьОтбитое(Ответ, Вердикт, "security", КукиЗапроса, 400, Неопределено,
			ОтказПоля(ПолеНовогоПароля(), Тексты.Шаблон("settings.account.error.password.policy",
				ПолитикаПароля.ОписаниеОднойСтрокой())));
		Возврат;
	КонецЕсли;
	Если НовыйПароль <> Повтор Тогда
		ОтдатьОтбитое(Ответ, Вердикт, "security", КукиЗапроса, 400, Неопределено,
			ОтказПоля(ПолеПовтора(), Тексты.Текст("settings.account.error.password.repeat")));
		Возврат;
	КонецЕсли;

	// УстановитьПароль повторно провалидирует политикой и снимет ТребуетсяСменаПароля
	СервисПользователей.УстановитьПароль(Пользователь, НовыйПароль);
	Ответ.Перенаправить(Отметка.НаАдресе(Дом.АдресРаздела("security")));

КонецПроцедуры

// Учётке без пароля подтверждать нечего: присланное в обход формы значение не сверяется.
Функция ТекущийПарольПодтверждён(Знач Пользователь, Знач Старый)

	Возврат НЕ СервисПользователей.ПарольЗадан(Пользователь)
		ИЛИ СервисПользователей.ПроверитьПароль(Пользователь, Старый);

КонецФункции

// Оформление хранится в cookie этого браузера, запись — в одном месте кита.
Процедура СохранитьОформление(Ответ, Знач Форма)

	ВыборВида.ЗаписатьКуку(Ответ, ВитринаВида.ЗначениеCookie(Форма, РазборФормы));
	Ответ.Перенаправить(Отметка.НаАдресе(Дом.АдресРаздела("appearance")));

КонецПроцедуры

#КонецОбласти

#Область Рендер

// Раздел «Профиль» с исходом действия — уведомлением, которое принесла операция.
Процедура ОтдатьПрофиль(Ответ, Знач Вердикт, Знач КукиЗапроса, Знач Сохранено, Знач Статус,
	Знач Уведомление)
	ОтдатьРаздел(Ответ, Вердикт, "profile", Сохранено, "", КукиЗапроса, Статус, Уведомление);
КонецПроцедуры

// Раздел с отбитой формой — тем же состоянием, что окна и дом «Хаб»: отказ под полем, набранное
// (кроме паролей) — на месте.
Процедура ОтдатьОтбитое(Ответ, Знач Вердикт, Знач Ключ, Знач КукиЗапроса, Знач Статус, Знач Набранное,
	Знач ОтказыПолей)
	ОтдатьРаздел(Ответ, Вердикт, Ключ, Ложь, "", КукиЗапроса, Статус, Неопределено,
		Окна.Отбитое(ВидОтбитойФормы(), Ключ, Набранное, ОтказыПолей));
КонецПроцедуры

Процедура ОтдатьРаздел(Ответ, Знач Вердикт, Знач Ключ, Знач Сохранено, Знач Ошибка, Знач КукиЗапроса,
	Знач Статус = 200, Знач Уведомление = Неопределено, Знач Отбитое = Неопределено)

	Пользователь = Вердикт.Пользователь;
	Токен = Защита.ТокенСессии(Вердикт.Сессия);

	Уведомления = Новый Массив();
	Если Ключ = "security" И ПарольныйВход.Выключен() Тогда
		// пароль остаётся страховкой на случай аварийного возврата формы конфигом,
		// поэтому смена работает — но обещать вход этим паролем сейчас нельзя
		Уведомления.Добавить(Ответы.Уведомление(
			Тексты.Текст("settings.account.security.passwordlogin.off"), "warn"));
	КонецЕсли;
	Если Пользователь.ТребуетсяСменаПароля = Истина И Ключ = "security" Тогда
		Уведомления.Добавить(Ответы.Уведомление(
			Тексты.Текст("settings.account.security.forced"), "warn"));
	КонецЕсли;
	Если Сохранено Тогда
		Уведомления.Добавить(Ответы.Уведомление(Тексты.Текст("settings.reply.saved"), "ok"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Уведомления.Добавить(Ответы.Уведомление(Ошибка, "err"));
	КонецЕсли;
	Если Уведомление <> Неопределено Тогда
		Уведомления.Добавить(Уведомление);
	КонецЕсли;

	Модель = Ответы.МодельДома(Дом, "",
		Дом.Разделы(Ключ),
		Уведомления,
		Секции(Ключ, Пользователь, КукиЗапроса, Отбитое),
		Токен);
	Модель.Заголовок = Дом.ЗаголовокУчётки(Пользователь.Логин);

	Ответы.ОтдатьДом(Ответ, Модель, Вердикт, КукиЗапроса, Статус);

КонецПроцедуры

Функция Секции(Знач Ключ, Знач Пользователь, Знач КукиЗапроса, Знач Отбитое)

	Результат = Новый Массив();

	Если Ключ = "profile" Тогда
		Результат.Добавить(СекцияПрофиля(Пользователь, Отбитое));
		СекцияАдреса = ВитринаАдреса.СекцияПодтверждения(Пользователь);
		Если СекцияАдреса <> Неопределено Тогда
			Результат.Добавить(СекцияАдреса);
		КонецЕсли;
	ИначеЕсли Ключ = "security" Тогда
		Результат.Добавить(СекцияПароля(Пользователь, Отбитое));
	ИначеЕсли Ключ = "permissions" Тогда
		Результат.Добавить(ВитринаПрав.СекцияПрав(Пользователь));
		Результат.Добавить(ВитринаПрав.СекцияГрупп(Пользователь));
	ИначеЕсли Ключ = "appearance" Тогда
		Результат.Добавить(ВитринаВида.Секция(КукиЗапроса));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Секция-форма на адрес раздела: адрес и токен — у дома.
Функция СекцияПрофиля(Знач Пользователь, Знач Отбитое)

	Возврат Кит.Секция(Тексты.Текст("settings.account.profile.title"),
			ПолеЛогина(Пользователь),
			ПолеАдреса(Пользователь, Отбитое))
		.Лид(Тексты.Текст("settings.account.profile.lead")).Иконка("аккаунт")
		.Форма("");

КонецФункции

// Логин не правится: он и есть имя учётной записи; заблокированное поле с формой не уходит.
Функция ПолеЛогина(Знач Пользователь)

	Возврат Кит.Поле("логин", Тексты.Текст("settings.account.profile.login.label"))
		.Значение(Строка(Пользователь.Логин)).Заблокировано()
		.Подсказка(Тексты.Текст("settings.account.profile.login.hint"));

КонецФункции

// Отбитый адрес возвращается в поле набранным, отказ — под ним.
Функция ПолеАдреса(Знач Пользователь, Знач Отбитое)

	Возврат Кит.Поле(ПолеПочты(), Тексты.Текст("settings.account.profile.email.label"))
		.ТипЗначения("email").Значение(Окна.Значение(Отбитое, ПолеПочты(), Пользователь.Email))
		.Подсказка(СтатусEmail(Пользователь))
		.Ошибка(Окна.Отказ(Отбитое, ПолеПочты()));

КонецФункции

Функция СтатусEmail(Знач Пользователь)

	Если НЕ ЗначениеЗаполнено(Пользователь.Email) Тогда
		Возврат Тексты.Текст("settings.account.profile.email.empty");
	КонецЕсли;
	Если Пользователь.EmailПодтверждён = Истина Тогда
		Возврат Тексты.Текст("settings.account.profile.email.confirmed");
	КонецЕсли;
	Возврат Тексты.Текст("settings.account.profile.email.unconfirmed");

КонецФункции

// Пароль в поле не печатается никогда — ни действующий, ни набранный: у отбитой формы — только отказ.
// Подсказка требований стоит СРАЗУ под новым паролем: она судит именно его, а не повтор.
// Учётке без пароля текущий не спрашивают.
Функция СекцияПароля(Знач Пользователь, Знач Отбитое)

	Текущий = Неопределено;
	Если СервисПользователей.ПарольЗадан(Пользователь) Тогда
		Текущий = ПолеПароля(ПолеТекущегоПароля(), Тексты.Текст("settings.account.password.current.label"),
			Отбитое);
	КонецЕсли;

	Возврат Кит.Секция(Тексты.Текст("settings.account.password.title"),
			Текущий,
			ПолеПароля(ПолеНовогоПароля(), Тексты.Текст("settings.account.password.new.label"), Отбитое),
			Подсказка.Требования(ПолеНовогоПароля()),
			ПолеПароля(ПолеПовтора(), Тексты.Текст("settings.account.password.repeat.label"), Отбитое))
		.Лид(Тексты.Текст("settings.account.password.lead")).Иконка("замок")
		.Форма("").Кнопка(Тексты.Текст("settings.account.password.button"));

КонецФункции

Функция ПолеПароля(Знач Имя, Знач Метка, Знач Отбитое)
	Возврат Кит.Поле(Имя, Метка).Секрет().Ошибка(Окна.Отказ(Отбитое, Имя));
КонецФункции

#КонецОбласти

#Область ИменаПолей

// Вид состояния раздела «форма вернулась с отказом».
Функция ВидОтбитойФормы()
	Возврат "форма";
КонецФункции

Функция ПолеПочты()
	Возврат "email";
КонецФункции

Функция ПолеТекущегоПароля()
	Возврат "старый";
КонецФункции

Функция ПолеНовогоПароля()
	Возврат "новый";
КонецФункции

Функция ПолеПовтора()
	Возврат "повтор";
КонецФункции

Функция ОтказПоля(Знач Имя, Знач Текст)
	Результат = Новый Соответствие();
	Результат.Вставить(Имя, Текст);
	Возврат Результат;
КонецФункции

#КонецОбласти

&Контроллер("/me")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _Гвард,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ДомАккаунта") _Дом,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисПользователей") _СервисПользователей,
	&Пластилин(Значение = "СменаАдресаУчётки") _СменаАдреса,
	&Пластилин(Значение = "ВитринаПодтвержденияАдреса") _ВитринаАдреса,
	&Пластилин(Значение = "ОтказыУчётки") _Отказы,
	&Пластилин(Значение = "ПолитикаПароля") _ПолитикаПароля,
	&Пластилин(Значение = "ПодсказкаПароля") _Подсказка,
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _ПарольныйВход,
	&Пластилин(Значение = "ВитринаМоихПрав") _ВитринаПрав,
	&Пластилин(Значение = "ВыборОформления") _ВыборВида,
	&Пластилин(Значение = "ВитринаВидаИЯзыка") _ВитринаВида,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ОтметкаСохранения") _Отметка,
	&Пластилин(Значение = "ОкноРаздела") _Окна)

	Гвард = _Гвард;
	Ответы = _Ответы;
	Сбои = _Сбои;
	Дом = _Дом;
	Кит = _Кит;
	Гейт = _Гейт;
	Защита = _Защита;
	РазборФормы = _РазборФормы;
	СервисПользователей = _СервисПользователей;
	СменаАдреса = _СменаАдреса;
	ВитринаАдреса = _ВитринаАдреса;
	Отказы = _Отказы;
	ПолитикаПароля = _ПолитикаПароля;
	Подсказка = _Подсказка;
	ПарольныйВход = _ПарольныйВход;
	ВитринаПрав = _ВитринаПрав;
	ВыборВида = _ВыборВида;
	ВитринаВида = _ВитринаВида;
	Тексты = _Тексты;
	Отметка = _Отметка;
	Окна = _Окна;

КонецПроцедуры
