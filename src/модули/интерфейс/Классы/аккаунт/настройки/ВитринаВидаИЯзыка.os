// Раздел «Вид и язык» дома «Аккаунт»: тема, акцент, плотность и скругления посетителя. Выбор
// хранится в cookie оформления этого браузера; сегменты сохраняются сразу.

Перем Кит;       // Кит (кит) — фабрика элементов экрана
Перем ВыборВида; // ВыборОформления (кит) — оформление посетителя из cookie
Перем Токены;    // ТокеныТемы (кит) — тема страницы и проверка цвета и множителей
Перем Тексты;    // ТекстыИнтерфейса (кит) — пользовательские строки по ключам

#Область ПубличныйИнтерфейс

// Секция раздела: одна форма, которая уходит целиком при каждом выборе.
//
// Параметры:
//  КукиЗапроса - Куки, Неопределено - куки запроса: из них берётся действующее оформление.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.Секция.
//
Функция Секция(Знач КукиЗапроса) Экспорт

	Оформление = ВыборВида.ПоКукам(КукиЗапроса);

	Возврат Кит.Секция(Тексты.Текст("settings.account.appearance.title"),
			Кит.Форма("",
				ВыборТемы(Оформление),
				ВыборАкцента(Оформление),
				ВыборШага(ИмяПоляПлотности(), Тексты.Текст("settings.account.appearance.density.label"),
					Оформление.Плотность, Плотности()),
				ВыборШага(ИмяПоляРадиуса(), Тексты.Текст("settings.account.appearance.radius.label"),
					Оформление.Радиус, Скругления()),
				Кит.Кнопка(Тексты.Текст("settings.account.appearance.save")).Основная()
					.Иконка("сохранить"))
				.Вид("столбик").БезПерезагрузки())
		.Лид(Тексты.Текст("settings.account.appearance.lead")).Иконка("солнце");

КонецФункции

// Значение cookie оформления из формы раздела: все четыре поля разом — cookie хранит
// оформление целиком, и частичная запись стёрла бы соседей. Чужое значение не проходит:
// тема — одна из двух, цвет и множители — через проверку кита.
//
// Параметры:
//  Форма - Соответствие - разобранная форма раздела.
//  РазборФормы - РазборФормы - чтение полей формы.
//
// Возвращаемое значение:
//  Строка - значение cookie без кодирования (см. ВыборОформления.ЗаписатьКуку).
//
Функция ЗначениеCookie(Знач Форма, Знач РазборФормы) Экспорт

	Тема = НРег(РазборФормы.Поле(Форма, ИмяПоляТемы(), ТёмнаяТема()));

	Части = Новый Массив();
	Части.Добавить("тема=" + ?(Тема = СветлаяТема(), СветлаяТема(), ТёмнаяТема()));
	Части.Добавить("акцент=" + Токены.БезопасныйЦвет(РазборФормы.Поле(Форма, ИмяПоляАкцента())));
	Части.Добавить("плотность=" + Множитель(РазборФормы.Поле(Форма, ИмяПоляПлотности(), "1")));
	Части.Добавить("радиус=" + Множитель(РазборФормы.Поле(Форма, ИмяПоляРадиуса(), "1")));
	Возврат СтрСоединить(Части, "&");

КонецФункции

#КонецОбласти

#Область Выбор

// «Как в системе» не печатается: кит ставит странице тему только светлую или тёмную.
Функция ВыборТемы(Знач Оформление)

	Текущая = ?(Токены.АтрибутТемы(Оформление) = "light", СветлаяТема(), ТёмнаяТема());
	Подпись = Тексты.Текст("settings.account.appearance.theme.label");

	Возврат Кит.Группа(Подпись,
			Кит.Сегменты(ИмяПоляТемы(),
				Кит.Сегмент(СветлаяТема(), Тексты.Текст("settings.account.appearance.theme.light")),
				Кит.Сегмент(ТёмнаяТема(), Тексты.Текст("settings.account.appearance.theme.dark")))
			.Подпись(Подпись).Выбрано(Текущая).СохранятьСразу())
		.Вид("простая");

КонецФункции

// Пустое значение — акцент хаба: у необязательного поля цвета для него свой кружок.
// Образцы — палитра кита, та же, что у акцента инсталляции в брендировании хаба.
Функция ВыборАкцента(Знач Оформление)

	Возврат Кит.Поле(ИмяПоляАкцента(), Тексты.Текст("settings.account.appearance.accent.label"))
		.ОбразцыТемы()
		.Значение(Токены.БезопасныйЦвет(Оформление.Акцент))
		.Подсказка(Тексты.Текст("settings.account.appearance.accent.hint"));

КонецФункции

// Множитель кит принимает от 0,5 до 2, на экране — три шага. Сохранённое между шагами
// отмечает крайний шаг по ту же сторону от обычного.
Функция ВыборШага(Знач Имя, Знач Подпись, Знач Сохранённый, Знач Шаги)

	Значение = Токены.БезопасныйМножитель(Сохранённый);
	Выбран = Шаги[1].Значение;
	Если Значение < 1 Тогда
		Выбран = Шаги[0].Значение;
	ИначеЕсли Значение > 1 Тогда
		Выбран = Шаги[2].Значение;
	КонецЕсли;

	Возврат Кит.Группа(Подпись,
			Кит.Сегменты(Имя,
				Кит.Сегмент(Шаги[0].Значение, Шаги[0].Подпись),
				Кит.Сегмент(Шаги[1].Значение, Шаги[1].Подпись),
				Кит.Сегмент(Шаги[2].Значение, Шаги[2].Подпись))
			.Подпись(Подпись).Выбрано(Выбран).СохранятьСразу())
		.Вид("простая");

КонецФункции

#КонецОбласти

#Область Значения

Функция ИмяПоляТемы()
	Возврат "тема";
КонецФункции

Функция ИмяПоляАкцента()
	Возврат "акцент";
КонецФункции

Функция ИмяПоляПлотности()
	Возврат "плотность";
КонецФункции

Функция ИмяПоляРадиуса()
	Возврат "радиус";
КонецФункции

Функция СветлаяТема()
	Возврат "светлая";
КонецФункции

Функция ТёмнаяТема()
	Возврат "тёмная";
КонецФункции

Функция Плотности()

	Результат = Новый Массив();
	Результат.Добавить(Шаг("0.75", Тексты.Текст("settings.account.appearance.density.compact")));
	Результат.Добавить(Шаг("1", Тексты.Текст("settings.account.appearance.density.normal")));
	Результат.Добавить(Шаг("1.25", Тексты.Текст("settings.account.appearance.density.roomy")));
	Возврат Результат;

КонецФункции

Функция Скругления()

	Результат = Новый Массив();
	Результат.Добавить(Шаг("0.5", Тексты.Текст("settings.account.appearance.radius.less")));
	Результат.Добавить(Шаг("1", Тексты.Текст("settings.account.appearance.radius.normal")));
	Результат.Добавить(Шаг("1.5", Тексты.Текст("settings.account.appearance.radius.more")));
	Возврат Результат;

КонецФункции

Функция Шаг(Знач Значение, Знач Подпись)
	Возврат Новый Структура("Значение, Подпись", Значение, Подпись);
КонецФункции

Функция Множитель(Знач Значение)
	Возврат Токены.ЧислоCSS(Токены.БезопасныйМножитель(Значение));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ВыборОформления") _ВыборВида,
	&Пластилин(Значение = "ТокеныТемы") _Токены,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Кит = _Кит;
	ВыборВида = _ВыборВида;
	Токены = _Токены;
	Тексты = _Тексты;

КонецПроцедуры
