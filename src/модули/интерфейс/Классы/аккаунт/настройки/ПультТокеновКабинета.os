// Операции раздела «Токены доступа» дома «Аккаунт»: заявка из формы окна «Новый токен», выпуск
// и отзыв личного токена. Исход каждой — домена плюс отказы у полей окна.

Перем Гейт;          // ГейтФормы — CSRF-токен формы
Перем РазборФормы;
Перем СервисТокенов; // СервисТокенов (вход)
Перем ЧтениеПулов;   // ГвардДоступаКПулу (права) — какие пулы смотрящему видны
Перем ГейтТокена;    // ГейтТокена (вход) — словарь прав, которым живёт ключ
Перем Числа;         // ПриведениеЧисел (основа) — терпимое чтение числа
Перем Поля;          // ОкноВыпускаТокена — владелец имён полей
Перем Сбои;          // ТекстСбоя — причина сбоя человеку
Перем Тексты;        // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Разбирает тело запроса и проверяет CSRF.
//
// Параметры:
//  Ответ - ОтветСервера.
//  Вердикт - Структура - Пользователь и Сессия запроса.
//  ТелоЗапроса - Строка.
//  КукиЗапроса - Куки - куки запроса.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - разобранная форма; Неопределено — ответ уже сформирован.
//
Функция Форма(Ответ, Знач Вердикт, Знач ТелоЗапроса, Знач КукиЗапроса) Экспорт
	Возврат Гейт.СПринятымТокеном(Ответ, Вердикт, РазборФормы.Разобрать(ТелоЗапроса), КукиЗапроса);
КонецФункции

// Заявка из формы окна «Новый токен». Пулы приходят галками с одним именем, поэтому
// читаются из тела, а не из карты имён.
//
// Параметры:
//  Форма - Соответствие - разобранная форма.
//  ТелоЗапроса - Строка - тело запроса.
//
// Возвращаемое значение:
//  Структура - Имя, Чтение, Запись (Булево), Где (Строка), Пулы (Массив из Строка — без повторов),
//              Срок (Строка), Поиск (Строка — строка поиска пулов), Найденные (Строка — «вкл»,
//              «выкл» или "" — кнопка под ответом поиска).
//
Функция Заявка(Знач Форма, Знач ТелоЗапроса) Экспорт

	Пулы = БезПовторов(РазборФормы.Значения(ТелоЗапроса, Поля.ИмяПоляПулов()));
	// форма без сегментов (запрос в обход окна) называет пулы самими галками
	Где = РазборФормы.Поле(Форма, Поля.ИмяПоляГде(), ?(Пулы.Количество() > 0, Поля.ГдеПулы(), Поля.ГдеХаб()));

	Заявка = Новый Структура();
	Заявка.Вставить("Имя", РазборФормы.Поле(Форма, Поля.ИмяПоляИмени()));
	Заявка.Вставить("Чтение", РазборФормы.Флажок(Форма, Поля.ИмяПоляЧтения()));
	Заявка.Вставить("Запись", РазборФормы.Флажок(Форма, Поля.ИмяПоляЗаписи()));
	Заявка.Вставить("Где", ?(Где = Поля.ГдеПулы(), Поля.ГдеПулы(), Поля.ГдеХаб()));
	Заявка.Вставить("Пулы", Пулы);
	Заявка.Вставить("Срок", РазборФормы.Поле(Форма, Поля.ИмяПоляСрока()));
	Заявка.Вставить("Поиск", РазборФормы.Поле(Форма, Поля.ИмяПоляПоиска()));
	Заявка.Вставить("Найденные", НРег(РазборФормы.Поле(Форма, Поля.ИмяПоляНайденных())));
	Возврат Заявка;

КонецФункции

// Заявка нового окна: оба права, весь хаб, срок по умолчанию.
//
// Возвращаемое значение:
//  Структура - см. Заявка.
//
Функция НоваяЗаявка() Экспорт

	Заявка = Новый Структура();
	Заявка.Вставить("Имя", "");
	Заявка.Вставить("Чтение", Истина);
	Заявка.Вставить("Запись", Истина);
	Заявка.Вставить("Где", Поля.ГдеХаб());
	Заявка.Вставить("Пулы", Новый Массив());
	Заявка.Вставить("Срок", Формат(СервисТокенов.СрокПоУмолчаниюДней(), "ЧГ=0"));
	Заявка.Вставить("Поиск", "");
	Заявка.Вставить("Найденные", "");
	Возврат Заявка;

КонецФункции

// Отмечает или снимает найденные пулы — так без скрипта работают кнопки под ответом поиска.
//
// Параметры:
//  Заявка - Структура - заявка (см. Заявка); её набор пулов меняется.
//  Найденные - Массив из Строка - идентификаторы найденных пулов.
//
Процедура ПрименитьНайденные(Заявка, Знач Найденные) Экспорт

	Для Каждого Идентификатор Из Найденные Цикл
		Позиция = Заявка.Пулы.Найти(Идентификатор);
		Если Заявка.Найденные = "вкл" И Позиция = Неопределено Тогда
			Заявка.Пулы.Добавить(Идентификатор);
		ИначеЕсли Заявка.Найденные = "выкл" И Позиция <> Неопределено Тогда
			Заявка.Пулы.Удалить(Позиция);
		КонецЕсли;
	КонецЦикла;
	Заявка.Где = Поля.ГдеПулы();

КонецПроцедуры

// Выпускает токен по заявке. Пул, которого смотрящий не видит, отвечает как несуществующий.
//
// Параметры:
//  Вердикт - Структура - Пользователь и Принципал запроса.
//  Заявка - Структура - заявка (см. Заявка).
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Код (Число), Сообщение (Строка — причина отказа словами,
//              заполнена у любого отказа), Отказы (Соответствие — имя поля -> отказ под полем),
//              Секрет (Строка — значение выпущенного токена; "" при отказе).
//
Функция Выпустить(Знач Вердикт, Знач Заявка) Экспорт

	Отказы = ОтказыЗаявки(Заявка);
	Если Отказы.Количество() > 0 Тогда
		Возврат Отбито(Отказы, "");
	КонецЕсли;

	Пулы = Новый Массив();
	Если Заявка.Где = Поля.ГдеПулы() Тогда
		Если Заявка.Пулы.Количество() = 0 Тогда
			Возврат Отбито(Отказы, Тексты.Текст("settings.account.tokens.error.pools"));
		КонецЕсли;
		Названные = ЧтениеПулов.НазванныеПулы(Вердикт.Принципал, Заявка.Пулы);
		Если ЗначениеЗаполнено(Названные.Отвергнутый) Тогда
			Возврат Отбито(Отказы, Тексты.Шаблон("settings.account.tokens.error.pool", Названные.Отвергнутый));
		КонецЕсли;
		Пулы = Названные.Пулы;
	КонецЕсли;

	Попытка
		Выпуск = СервисТокенов.ВыпуститьТокен(Вердикт.Пользователь.Идентификатор, ПраваСтрокой(Заявка),
			Числа.ЦелоеИлиНеопределено(Заявка.Срок), 0, Заявка.Имя, Пулы);
	Исключение
		Возврат Исход(Ложь, 500, Тексты.Шаблон("settings.account.tokens.error.issue",
			Сбои.Человеку(ИнформацияОбОшибке())), Отказы, "");
	КонецПопытки;

	Возврат Исход(Истина, 200, "", Отказы, Строка(Выпуск.ЗначениеТокена));

КонецФункции

// Отзывает свой токен; чужой и несуществующий неотличимы.
//
// Параметры:
//  Пользователь - Пользователь - владелец токена.
//  Идентификатор - Строка - идентификатор из адреса.
//
// Возвращаемое значение:
//  Структура - см. Выпустить.
//
Функция Отозвать(Знач Пользователь, Знач Идентификатор) Экспорт

	ТокенИд = Числа.ЧислоИлиНоль(Идентификатор);
	Если ТокенИд > 0 И СервисТокенов.Отозвать(Пользователь.Идентификатор, ТокенИд) Тогда
		Возврат Исход(Истина, 200, "", Новый Соответствие(), "");
	КонецЕсли;
	Возврат Исход(Ложь, 404, Тексты.Текст("settings.account.tokens.revoke.missing"),
		Новый Соответствие(), "");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Срок проверяется здесь, а не только службой: отказ должен встать под полем срока.
Функция ОтказыЗаявки(Знач Заявка)

	Отказы = Новый Соответствие();
	Если НЕ Заявка.Чтение И НЕ Заявка.Запись Тогда
		Отказы.Вставить(Поля.ИмяПоляЧтения(), Тексты.Текст("settings.account.tokens.error.scopes"));
	КонецЕсли;

	Потолок = СервисТокенов.ПотолокСрокаДней();
	Срок = Числа.ЦелоеИлиНеопределено(Заявка.Срок);
	Если Срок = Неопределено ИЛИ Срок < 1 ИЛИ Срок > Потолок Тогда
		Отказы.Вставить(Поля.ИмяПоляСрока(),
			Тексты.Шаблон("settings.account.tokens.error.term", Формат(Потолок, "ЧГ=0")));
	КонецЕсли;
	Возврат Отказы;

КонецФункции

// Права экрана и скоупы хранилища — одно и то же, названное на двух языках.
Функция ПраваСтрокой(Знач Заявка)

	Права = Новый Массив();
	Если Заявка.Чтение Тогда
		Права.Добавить(ГейтТокена.СкоупЧтения());
	КонецЕсли;
	Если Заявка.Запись Тогда
		Права.Добавить(ГейтТокена.СкоупЗаписи());
	КонецЕсли;
	Возврат СтрСоединить(Права, ",");

КонецФункции

// Отказ у поля называет и окно: Сообщение — первый отказ, если своего нет.
Функция Отбито(Знач Отказы, Знач Сообщение)

	Текст = Сообщение;
	Для Каждого Отказ Из Отказы Цикл
		Если НЕ ЗначениеЗаполнено(Текст) Тогда
			Текст = Отказ.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Исход(Ложь, 400, Текст, Отказы, "");

КонецФункции

Функция Исход(Знач Успех, Знач Код, Знач Сообщение, Знач Отказы, Знач Секрет)
	Возврат Новый Структура("Успех, Код, Сообщение, Отказы, Секрет", Успех, Код, Сообщение, Отказы, Секрет);
КонецФункции

Функция БезПовторов(Знач Значения)

	Результат = Новый Массив();
	Для Каждого Значение Из Значения Цикл
		Текст = СокрЛП(Строка(Значение));
		Если ЗначениеЗаполнено(Текст) И Результат.Найти(Текст) = Неопределено Тогда
			Результат.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисТокенов") _СервисТокенов,
	&Пластилин(Значение = "ГвардДоступаКПулу") _ЧтениеПулов,
	&Пластилин(Значение = "ГейтТокена") _ГейтТокена,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа,
	&Пластилин(Значение = "ОкноВыпускаТокена") _Поля,
	&Пластилин(Значение = "ТекстСбоя") _Сбои,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	СервисТокенов = _СервисТокенов;
	ЧтениеПулов = _ЧтениеПулов;
	ГейтТокена = _ГейтТокена;
	Числа = _Числа;
	Поля = _Поля;
	Сбои = _Сбои;
	Тексты = _Тексты;

КонецПроцедуры
