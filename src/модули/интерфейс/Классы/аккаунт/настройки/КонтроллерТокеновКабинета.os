// Маршруты раздела «Токены доступа» дома «Аккаунт»: страница с окном по адресу, выпуск, поиск
// пулов окна выпуска и отзыв личного токена. Выпуск отвечает страницей с окном секрета, отзыв —
// 303 на раздел; отказ — та же страница с окном, открытым на набранном.

Перем Гвард;        // ГвардКабинета
Перем Ответы;       // ОтветыНастроек
Перем Дом;          // ДомАккаунта
Перем Витрина;      // ВитринаТокеновКабинета
Перем Пульт;        // ПультТокеновКабинета
Перем Защита;       // ЗащитаCSRF (вход)
Перем Окна;         // ОкноРаздела — окно по адресу и ответы форм окон
Перем Перехватчик;  // ПерехватчикАутентификации (вход) — инвариант «ключ не размножается»
Перем ЧтениеПулов;  // ГвардДоступаКПулу (права) — какие пулы смотрящему видны
Перем СервисТокенов; // СервисТокенов (вход) — потолок срока
Перем ОкноВыпуска;  // ОкноВыпускаТокена — поиск пулов окна выпуска
Перем Тексты;       // ТекстыИнтерфейса (кит)

#Область ТочкиМаршрута

// Точка маршрута «tokens»: GET — страница раздела, POST — выпуск токена.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  saved - Строка - признак успешного сохранения из адреса (необязательный, по умолчанию "").
//  окно - Строка - окно, открытое по адресу: <вид>-<ключ> (необязательный, по умолчанию "").
//
&ТочкаМаршрута("tokens")
Процедура Токены(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса, saved = "",
	окно = "") Экспорт

	Вердикт = Допуск(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Вердикт = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Структура("Вердикт, Куки", Вердикт, КукиЗапроса);

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Состояние = Окна.ИзАдреса(окно, Витрина.ВидыОкон());
		ОтдатьРаздел(Ответ, Запрос, 200, Состояние, ПараметрыВыпуска(Запрос, Состояние), "",
			ЗначениеЗаполнено(saved));
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Заявка = Пульт.Заявка(Форма, ТелоЗапроса);

	// без скрипта «Включить / Снять найденные» отправляют форму выпуска: это шаг подбора
	Если ЗначениеЗаполнено(Заявка.Найденные) Тогда
		ОтдатьПоиск(Ответ, Запрос, Заявка);
		Возврат;
	КонецЕсли;

	Выпустить(Ответ, Запрос, Форма, Заявка);

КонецПроцедуры

// Точка маршрута «tokens/pools» — поиск пулов окна выпуска: GET ?найти= — со скриптом
// (кит берёт из ответа совпадения), POST — без скрипта (форма выпуска целиком).
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//  найти - Строка - строка поиска (необязательный, по умолчанию "").
//
&ТочкаМаршрута("tokens/pools")
Процедура ПоискПулов(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	найти = "") Экспорт

	Вердикт = Допуск(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Вердикт = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Структура("Вердикт, Куки", Вердикт, КукиЗапроса);

	Если Ответы.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Заявка = Пульт.НоваяЗаявка();
		Заявка.Где = ОкноВыпуска.ГдеПулы();
		Заявка.Поиск = Строка(найти);
		ОтдатьПоиск(Ответ, Запрос, Заявка);
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "GET, POST", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Заявка = Пульт.Заявка(Форма, ТелоЗапроса);
	Заявка.Где = ОкноВыпуска.ГдеПулы();
	ОтдатьПоиск(Ответ, Запрос, Заявка);

КонецПроцедуры

// Точка маршрута «tokens/{id}/revoke» — отзыв своего токена. Без поля подтверждения (форма ушла
// без скрипта) токен не отзывается: ответ ведёт на страницу с открытым подтверждением. Чужой
// и несуществующий токен — одинаковый 404.
//
// Параметры:
//  Ответ - ОтветСервера - ответ, в который пишется результат.
//  id - Строка - идентификатор токена из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса - Куки - куки запроса.
//  МетодЗапроса - Строка - метод HTTP-запроса.
//  ТелоЗапроса - Строка - тело POST-запроса.
//
&ТочкаМаршрута("tokens/{id}/revoke")
Процедура Отзыв(Ответ, id, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Вердикт = Допуск(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если Вердикт = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НЕ Ответы.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответы.ОтдатьМетодНеРазрешён(Ответ, "POST", Вердикт, КукиЗапроса);
		Возврат;
	КонецЕсли;
	Форма = Пульт.Форма(Ответ, Вердикт, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Окна.Подтверждено(Форма) Тогда
		Окна.СпроситьПодтверждение(Ответ, АдресРаздела(), id, "отозвать");
		Возврат;
	КонецЕсли;

	Исход = Пульт.Отозвать(Вердикт.Пользователь, id);
	Если Исход.Успех Тогда
		Окна.ВернутьВРаздел(Ответ, АдресРаздела());
		Возврат;
	КонецЕсли;
	Запрос = Новый Структура("Вердикт, Куки", Вердикт, КукиЗапроса);
	ОтдатьРаздел(Ответ, Запрос, Исход.Код, Неопределено, ПараметрыВыпуска(Запрос, Неопределено),
		Исход.Сообщение);

КонецПроцедуры

#КонецОбласти

#Область Действия

// Гвард кабинета и гейт «ключ не размножается» — до разбора формы и до CSRF, чтобы отказ
// назывался своим именем.
Функция Допуск(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса)

	Вердикт = Гвард.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ Перехватчик.УправлениеКлючамиРазрешено(Вердикт.Принципал) Тогда
		Ответы.ОтдатьЗапрещено(Ответ, Вердикт,
			Тексты.Текст("office.tokens.key-cannot-manage-keys"), КукиЗапроса);
		Возврат Неопределено;
	КонецЕсли;
	Возврат Вердикт;

КонецФункции

// Удача отвечает страницей, а не перенаправлением: секрет ложится в окно этой страницы и в адрес
// не попадает. Отказ — окно выпуска, открытое на набранном и отказах.
Процедура Выпустить(Ответ, Знач Запрос, Знач Форма, Знач Заявка)

	Исход = Пульт.Выпустить(Запрос.Вердикт, Заявка);
	Если Исход.Успех Тогда
		ОтдатьСекрет(Ответ, Запрос, Исход.Секрет);
		Возврат;
	КонецЕсли;

	// отказ у поля в окне уже назван — второй раз над шагами его не повторяют
	Состояние = Окна.Отбитое("новый", "", Форма, Исход.Отказы,
		?(Исход.Отказы.Количество() > 0, "", Исход.Сообщение));
	ОтдатьРаздел(Ответ, Запрос, Исход.Код, Состояние, ПараметрыВыпуска(Запрос, Состояние, Заявка));

КонецПроцедуры

// Ответ поиска пулов — страница раздела с открытым окном выпуска на шаге «Где действует»:
// со скриптом кит берёт из неё совпадения, без скрипта она и есть следующий шаг подбора.
Процедура ОтдатьПоиск(Ответ, Знач Запрос, Знач Заявка)

	Пулы = ВидимыеПулы(Запрос);
	Если ЗначениеЗаполнено(Заявка.Найденные) Тогда
		Найденные = Новый Массив();
		Для Каждого Пул Из ОкноВыпуска.ПулыПоПоиску(Пулы, Заявка.Поиск) Цикл
			Найденные.Добавить(ОкноВыпуска.Идентификатор(Пул));
		КонецЦикла;
		Пульт.ПрименитьНайденные(Заявка, Найденные);
	КонецЕсли;

	Состояние = Окна.Открытое("новый");
	Выпуск = ПараметрыВыпуска(Запрос, Состояние, Заявка, Пулы);
	Выпуск.Найдено = Заявка.Поиск;
	ОтдатьРаздел(Ответ, Запрос, 200, Состояние, Выпуск);

КонецПроцедуры

// Параметры окна «Новый токен» (см. ОкноВыпускаТокена.Выпуск).
Функция ПараметрыВыпуска(Знач Запрос, Знач Состояние, Знач Заявка = Неопределено, Знач Пулы = Неопределено)

	Параметры = Новый Структура();
	Параметры.Вставить("Состояние", Состояние);
	Параметры.Вставить("Открыто", Окна.Открыто(Состояние, "новый"));
	Параметры.Вставить("Адрес", Окна.Адрес(АдресРаздела(), "новый"));
	Параметры.Вставить("Заявка", ?(Заявка = Неопределено, Пульт.НоваяЗаявка(), Заявка));
	Параметры.Вставить("Пулы", ?(Пулы = Неопределено, ВидимыеПулы(Запрос), Пулы));
	Параметры.Вставить("Найдено", Неопределено);
	Параметры.Вставить("АдресПоиска", АдресРаздела() + "/pools");
	Параметры.Вставить("Срок", СервисТокенов.ПотолокСрокаДней());
	Возврат Параметры;

КонецФункции

Функция ВидимыеПулы(Знач Запрос)
	Возврат ЧтениеПулов.ЧитаемыеПулы(Запрос.Вердикт.Принципал);
КонецФункции

#КонецОбласти

#Область Рендер

// Страница раздела с окном выпущенного токена: секрет показан один раз, здесь.
Процедура ОтдатьСекрет(Ответ, Знач Запрос, Знач Секрет)
	ОтдатьРаздел(Ответ, Запрос, 200, Неопределено, ПараметрыВыпуска(Запрос, Неопределено), "", Ложь, Секрет);
КонецПроцедуры

Процедура ОтдатьРаздел(Ответ, Знач Запрос, Знач Статус, Знач Состояние, Знач Выпуск,
	Знач Ошибка = "", Знач Сохранено = Ложь, Знач Секрет = "")

	Пользователь = Запрос.Вердикт.Пользователь;

	Параметры = Новый Структура("Адрес, Пользователь, Окно, Выпуск, Секрет",
		АдресРаздела(), Пользователь, Состояние, Выпуск, Секрет);

	Модель = Ответы.МодельДома(Дом, "",
		Дом.Разделы("tokens"),
		Ответы.УведомленияРаздела(Сохранено, Ошибка),
		Витрина.Секции(Параметры),
		Защита.ТокенСессии(Запрос.Вердикт.Сессия));
	Модель.Заголовок = Дом.ЗаголовокУчётки(Пользователь.Логин);

	Ответы.ОтдатьДом(Ответ, Модель, Запрос.Вердикт, Запрос.Куки, Статус);

КонецПроцедуры

Функция АдресРаздела()
	Возврат Дом.АдресРаздела("tokens");
КонецФункции

#КонецОбласти

&Контроллер("/me/settings")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардКабинета") _Гвард,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "ДомАккаунта") _Дом,
	&Пластилин(Значение = "ВитринаТокеновКабинета") _Витрина,
	&Пластилин(Значение = "ПультТокеновКабинета") _Пульт,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ОкноРаздела") _Окна,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "ГвардДоступаКПулу") _ЧтениеПулов,
	&Пластилин(Значение = "СервисТокенов") _СервисТокенов,
	&Пластилин(Значение = "ОкноВыпускаТокена") _ОкноВыпуска,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	Гвард = _Гвард;
	Ответы = _Ответы;
	Дом = _Дом;
	Витрина = _Витрина;
	Пульт = _Пульт;
	Защита = _Защита;
	Окна = _Окна;
	Перехватчик = _Перехватчик;
	ЧтениеПулов = _ЧтениеПулов;
	СервисТокенов = _СервисТокенов;
	ОкноВыпуска = _ОкноВыпуска;
	Тексты = _Тексты;

КонецПроцедуры
