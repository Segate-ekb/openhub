// Витрина кабинета «мои права и мои группы»: две секции только на чтение. Грант правится
// на объекте, членство — в группе, поэтому форм здесь нет вовсе.

Перем Кит;              // Кит (кит) — фабрика элементов экрана
Перем ТаблицыПрав;      // ТаблицаПрав — роль словами
Перем СервисПрав;       // СервисПрав (права)
Перем СервисПулов;      // СервисПулов (реестр)
Перем СервисГрупп;      // СервисГрупп (права)
Перем Тексты;           // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Страницы; // АдресаСтраниц (реестр) — страница пула и её настройки в строке права

#Область ПубличныйИнтерфейс

// Секция «Мои права» — витрина, только чтение: грант правится на объекте.
//
// Параметры:
//  Пользователь - Пользователь - смотрящий.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.Секция.
//
Функция СекцияПрав(Знач Пользователь) Экспорт

	Возврат Кит.Секция(Тексты.Текст("settings.account.permissions.title"), ТаблицаПулов(Пользователь))
		.Лид(Тексты.Текст("settings.account.permissions.lead")).Иконка("галочка");

КонецФункции

// Секция «Мои группы» — членство правится в самой группе.
//
// Параметры:
//  Пользователь - Пользователь - смотрящий.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел Кит.Секция.
//
Функция СекцияГрупп(Знач Пользователь) Экспорт

	Возврат Кит.Секция(Тексты.Текст("settings.account.groups.title"), ТаблицаГрупп(Пользователь))
		.Лид(Тексты.Текст("settings.account.groups.lead")).Иконка("группа");

КонецФункции

#КонецОбласти

#Область ТаблицаПулов

// На узком экране — карточки с именем пула заглавием.
Функция ТаблицаПулов(Знач Пользователь)

	Таблица = Кит.Таблица(СтрокиПулов(Пользователь)).Вид("карточками").Пустое("—")
		.Пусто(Тексты.Текст("settings.account.permissions.empty"));
	Таблица.Колонка("pool", Тексты.Текст("settings.account.permissions.col.pool")).Заглавная();
	Таблица.Колонка("role", Тексты.Текст("settings.account.permissions.col.role"));
	Таблица.Колонка("admin", Тексты.Текст("settings.account.permissions.col.admin"));
	Таблица.Колонка("where", Тексты.Текст("settings.account.permissions.col.where")).БезПодписиВЗаписи();
	Возврат Таблица;

КонецФункции

// Смотрящий и его права — одно понятие на всю таблицу: снимок снимается один раз,
// и роль пула считается один раз на строку, иначе строка стоила бы пяти разрезов базы.
Функция СтрокиПулов(Знач Пользователь)

	Смотрящий = Новый Структура("Пользователь, Права",
		Пользователь, СервисПрав.СнимокПрав(Пользователь));

	Результат = Новый Массив();
	Для Каждого Пул Из СервисПулов.ВсеПулы() Цикл
		Роль = СервисПрав.РольНаПул(Пользователь, Пул.Идентификатор, Смотрящий.Права);
		Если ЕстьЧтоПоказать(Смотрящий, Пул, Роль) Тогда
			Результат.Добавить(СтрокаПула(Смотрящий, Пул, Роль));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пул без роли и без права записи строки не получает: иначе «читатель» стоял бы у каждого публичного.
Функция ЕстьЧтоПоказать(Знач Смотрящий, Знач Пул, Знач Роль)

	Если НЕ СервисПрав.МожетЧитать(Смотрящий.Пользователь, Пул, Смотрящий.Права) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ЗначениеЗаполнено(Роль)
		ИЛИ СервисПрав.МожетПисать(Смотрящий.Пользователь, Пул, Смотрящий.Права);

КонецФункции

Функция СтрокаПула(Знач Смотрящий, Знач Пул, Знач Роль)

	Имя = Строка(Пул.Имя);
	Возврат Новый Структура("pool, role, admin, where",
		Кит.Ссылка(Страницы.Пула(Имя), Кит.Текст(Имя)),
		РольНаПуле(Роль),
		ПравоАдминистрировать(Смотрящий, Пул),
		Кит.Ссылка(Страницы.НастроекПула(Имя), Кит.Текст(Тексты.Текст("settings.account.permissions.link"))));

КонецФункции

// Роли может не быть вовсе: право пришло не ролью, а грантом на объект.
Функция РольНаПуле(Знач Роль)

	Если НЕ ЗначениеЗаполнено(Роль) Тогда
		Возврат Тексты.Текст("settings.account.permissions.role.grant");
	КонецЕсли;
	Подпись = ТаблицыПрав.ПодписьРоли(Роль);
	Возврат ?(ЗначениеЗаполнено(Подпись), Подпись, Строка(Роль));

КонецФункции

Функция ПравоАдминистрировать(Знач Смотрящий, Знач Пул)

	Возврат ?(СервисПрав.МожетАдминистрировать(Смотрящий.Пользователь, Пул, Смотрящий.Права),
		Тексты.Текст("settings.account.permissions.admin.yes"),
		Тексты.Текст("settings.account.permissions.admin.no"));

КонецФункции

#КонецОбласти

#Область ТаблицаГрупп

Функция ТаблицаГрупп(Знач Пользователь)

	Строки = Новый Массив();
	Для Каждого Группа Из СервисГрупп.ГруппыПользователя(Пользователь.Идентификатор) Цикл
		Имя = Строка(Группа.Имя);
		Строки.Добавить(Новый Структура("group, description",
			Кит.Ссылка("/groups/" + Имя + "/settings", Кит.Текст(Имя)),
			?(ЗначениеЗаполнено(Группа.Описание), Строка(Группа.Описание), "")));
	КонецЦикла;

	Таблица = Кит.Таблица(Строки).Вид("карточками").Пустое("—")
		.Пусто(Тексты.Текст("settings.account.groups.empty"));
	Таблица.Колонка("group", Тексты.Текст("settings.account.groups.col.group")).Заглавная();
	Таблица.Колонка("description", Тексты.Текст("settings.account.groups.col.description"));
	Возврат Таблица;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТаблицаПрав") _ТаблицыПрав,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисГрупп") _СервисГрупп,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы)

	Кит = _Кит;
	ТаблицыПрав = _ТаблицыПрав;
	СервисПрав = _СервисПрав;
	СервисПулов = _СервисПулов;
	СервисГрупп = _СервисГрупп;
	Тексты = _Тексты;
	Страницы = _Страницы;

КонецПроцедуры
