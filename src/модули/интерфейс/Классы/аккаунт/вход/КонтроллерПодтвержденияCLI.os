// Страница /cli/login — человек разрешает или отклоняет вход клиента CLI по коду.
// Требует сессию браузера: ключом (PAT) подтвердить вход нельзя — ключ не выпускает ключи.

Перем СервисВхода;      // СервисВходаCLI (вход)
Перем Перехватчик;      // ПерехватчикАутентификации (вход)
Перем Ограничитель;     // ОграничительВхода (вход) — защита кода от подбора
Перем Ведра;            // ВедроОграничителяПоАдресу (вход) — ведро по адресу клиента
Перем Защита;           // ЗащитаCSRF (вход) — токен сессии в форму
Перем Гейт;             // ГейтФормы — токен формы
Перем РазборФормы;
Перем Страница;         // СтраницаДоступа — каркас публичного экрана
Перем Кит;              // Кит (кит) — фабрика элементов экрана
Перем HTTP;             // МетодыHTTP (основа)
Перем ВозвратВхода;     // ВозвратПослеВхода (вход)
Перем ПараметрыСсылки;  // ПараметрыСсылки (основа) — параметр запроса на адресе
Перем Даты;  // ДатаЧеловеку — одно написание момента на весь интерфейс

#Область ТочкиМаршрута

// GET /cli/login — страница подтверждения (код можно передать параметром user_code),
// POST /cli/login — проверка кода, разрешение либо отказ.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow: HTML-страница либо редирект на вход.
//  ТелоЗапроса - Строка - тело POST-формы: user_code, действие, _csrf.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса (сессия и оформление).
//  МетодЗапроса - Строка - HTTP-метод запроса; прочие методы → 405.
//  АдресУдаленногоУзла - Строка - адрес клиента, часть ключа ограничителя попыток.
//  user_code - Строка - код заявки из адреса (необязательный, по умолчанию "").
//
&ТочкаМаршрута("cli/login")
Процедура Подтверждение(Ответ, ТелоЗапроса, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	АдресУдаленногоУзла, user_code = "") Экспорт

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);

	Если Принципал.Пользователь = Неопределено Тогда
		Ответ.Перенаправить(АдресВхода(user_code));
		Возврат;
	КонецЕсли;

	Если НЕ Перехватчик.УправлениеКлючамиРазрешено(Принципал) Тогда
		ОтдатьОтказ(Ответ, 403, "Подтвердить вход CLI можно только из браузера по сессии:"
			+ " ключ не выпускает ключи.", Принципал, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ПоказатьПоКоду(Ответ, Строка(user_code), Принципал, КукиЗапроса, Строка(АдресУдаленногоУзла));
		Возврат;
	КонецЕсли;

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответ.Заголовки["Allow"] = "GET, POST";
		ОтдатьОтказ(Ответ, 405, "Разрешены методы GET, POST", Принципал, КукиЗапроса);
		Возврат;
	КонецЕсли;

	ОбработатьФорму(Ответ, ТелоЗапроса, Принципал, КукиЗапроса, Строка(АдресУдаленногоУзла));

КонецПроцедуры

#КонецОбласти

#Область Действия

Процедура ОбработатьФорму(Ответ, Знач ТелоЗапроса, Знач Принципал, Знач КукиЗапроса, Знач АдресКлиента)

	Форма = РазборФормы.Разобрать(ТелоЗапроса);
	Код = РазборФормы.Поле(Форма, ИмяПоляКода());
	Действие = НРег(СокрЛП(РазборФормы.Поле(Форма, ИмяПоляДействия())));

	Если НЕ Ограничитель.РазрешёнЛи(КлючОграничителя(Принципал, АдресКлиента)) Тогда
		ОтдатьОтказ(Ответ, 429, ТекстБлокировки(), Принципал, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Заявка = СервисВхода.ЖиваяЗаявкаПоКоду(Код);
	Если Заявка = Неопределено Тогда
		Ограничитель.ЗафиксироватьНеудачу(КлючОграничителя(Принципал, АдресКлиента));
		ОтдатьВводКода(Ответ, Код, "Код не найден или истёк. Проверьте его в терминале"
			+ " и попробуйте снова.", 404, Принципал, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если НЕ Гейт.ТокенПринят(Принципал.Сессия, Форма) Тогда
		СервисВхода.ЗафиксироватьНеудачу(Заявка);
		ОтдатьВводКода(Ответ, "", "Проверка формы не прошла — начните подтверждение заново.",
			403, Принципал, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Ограничитель.Сбросить(КлючОграничителя(Принципал, АдресКлиента));

	Если Действие = "проверить" Тогда
		ПоказатьЗаявку(Ответ, Заявка, "", 200, Принципал, КукиЗапроса);
	ИначеЕсли Действие = "разрешить" Тогда
		Завершить(Ответ, СервисВхода.Одобрить(Код, Принципал.Пользователь.Идентификатор),
			Заявка, Истина, Принципал, КукиЗапроса);
	ИначеЕсли Действие = "отклонить" Тогда
		Завершить(Ответ, СервисВхода.Отклонить(Код), Заявка, Ложь, Принципал, КукиЗапроса);
	Иначе
		СервисВхода.ЗафиксироватьНеудачу(Заявка);
		ПоказатьЗаявку(Ответ, Заявка, "Неизвестное действие формы.", 400, Принципал, КукиЗапроса);
	КонецЕсли;

КонецПроцедуры

Процедура Завершить(Ответ, Знач Исход, Знач Заявка, Знач Разрешено, Знач Принципал, Знач КукиЗапроса)

	Если НЕ Исход.Успех Тогда
		ПоказатьЗаявку(Ответ, Заявка, "Заявка уже обработана или истекла — вернитесь"
			+ " в терминал и повторите вход.", 409, Принципал, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Колонка = Страница.КолонкаСЛидом(?(Разрешено, "Вход разрешён", "Вход отклонён"),
		?(Разрешено, "Клиент получит ключ доступа в течение нескольких секунд. Окно можно закрыть.",
			"Клиент ключа не получит. Окно можно закрыть."),
		СвойстваЗаявки(Заявка));

	Отдать(Ответ, 200, Колонка, Принципал, КукиЗапроса);

КонецПроцедуры

Процедура ПоказатьПоКоду(Ответ, Знач Код, Знач Принципал, Знач КукиЗапроса, Знач АдресКлиента)

	Если НЕ ЗначениеЗаполнено(СокрЛП(Код)) Тогда
		ОтдатьВводКода(Ответ, "", "", 200, Принципал, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если НЕ Ограничитель.РазрешёнЛи(КлючОграничителя(Принципал, АдресКлиента)) Тогда
		ОтдатьОтказ(Ответ, 429, ТекстБлокировки(), Принципал, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Заявка = СервисВхода.ЖиваяЗаявкаПоКоду(Код);
	Если Заявка = Неопределено Тогда
		Ограничитель.ЗафиксироватьНеудачу(КлючОграничителя(Принципал, АдресКлиента));
		ОтдатьВводКода(Ответ, Код, "Код не найден или истёк. Проверьте его в терминале"
			+ " и попробуйте снова.", 404, Принципал, КукиЗапроса);
		Возврат;
	КонецЕсли;

	ПоказатьЗаявку(Ответ, Заявка, "", 200, Принципал, КукиЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ПоказатьЗаявку(Ответ, Знач Заявка, Знач Ошибка, Знач Статус, Знач Принципал, Знач КукиЗапроса)

	Если Заявка.Статус <> СервисВхода.СтатусОжидание() Тогда
		Колонка = Страница.КолонкаСЛидом("Заявка уже обработана",
			"Эта заявка больше не ждёт решения. Повторите вход в терминале.",
			СвойстваЗаявки(Заявка));

		Отдать(Ответ, 409, Колонка, Принципал, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Колонка = Страница.КолонкаСЛидом("Разрешить вход клиента?",
		"Клиент получит ключ доступа от вашего имени."
			+ " Разрешайте, только если код совпадает с показанным в вашем терминале.",
		Страница.Уведомление(Ошибка, "err"),
		СвойстваЗаявки(Заявка),
		ФормаРешения(Заявка, Принципал));

	Отдать(Ответ, Статус, Колонка, Принципал, КукиЗапроса);

КонецПроцедуры

Процедура ОтдатьВводКода(Ответ, Знач Код, Знач Ошибка, Знач Статус, Знач Принципал, Знач КукиЗапроса)

	Колонка = Страница.КолонкаСЛидом("Вход клиента CLI", "Введите код, который показал терминал.",
		Страница.Уведомление(Ошибка, "err"),
		ФормаКода(Код, Принципал));

	Отдать(Ответ, Статус, Колонка, Принципал, КукиЗапроса);

КонецПроцедуры

Процедура ОтдатьОтказ(Ответ, Знач Статус, Знач Сообщение, Знач Принципал, Знач КукиЗапроса)

	Колонка = Страница.Колонка("Вход клиента CLI", Страница.Уведомление(Сообщение, "err"));

	Отдать(Ответ, Статус, Колонка, Принципал, КукиЗапроса);

КонецПроцедуры

Процедура Отдать(Ответ, Знач Статус, Знач Колонка, Знач Принципал, Знач КукиЗапроса)
	// код входа в адрес возврата не попадает: смена темы ведёт на ввод кода; учётку и «Выйти»
	// вошедшему печатает каркас — человек видит, от чьего имени разрешает ключ
	Страница.Отдать(Ответ, Статус, Заголовок(), Колонка, КукиЗапроса, Принципал, Путь());
КонецПроцедуры

// Ввод кода: человек пришёл на страницу без кода в адресе либо ошибся в нём.
Функция ФормаКода(Знач Код, Знач Принципал)

	Возврат Кит.Форма(Путь(),
		Кит.Поле(ИмяПоляКода(), "Код из терминала").Значение(Код)
			.Подсказка("восемь знаков, например ABCD-EFGH"),
		Кит.СкрытоеПоле(ИмяПоляДействия(), "проверить"),
		Страница.КнопкаФормы("Продолжить")).Токен(ТокенФормы(Принципал)).Вид("столбик");

КонецФункции

// Решение по заявке: две кнопки одной формы, каждая со своим значением действия.
Функция ФормаРешения(Знач Заявка, Знач Принципал)

	Возврат Кит.Форма(Путь(),
		Кит.СкрытоеПоле(ИмяПоляКода(), Заявка.КодПользователя),
		Кит.Кнопка("Разрешить").Основная().Имя(ИмяПоляДействия(), "разрешить"),
		Кит.Кнопка("Отклонить").Опасная().Имя(ИмяПоляДействия(), "отклонить"))
		.Токен(ТокенФормы(Принципал)).Вид("столбик");

КонецФункции

Функция ТокенФормы(Знач Принципал)
	Возврат Защита.ТокенСессии(Принципал.Сессия);
КонецФункции

// Заявка в узкой колонке — свойствами «подпись — значение», а не таблицей в две колонки.
Функция СвойстваЗаявки(Знач Заявка)

	Возврат Кит.Свойства(
		Факт("Код", Заявка.КодПользователя),
		Факт("Клиент", ?(ЗначениеЗаполнено(Заявка.ИмяКлиента),
			Заявка.ИмяКлиента, "(клиент не представился)")),
		Факт("Запрошенные права", Заявка.Права),
		Факт("Действует до", Даты.ДатаВремя(Заявка.Истекает)));

КонецФункции

Функция Факт(Знач Подпись, Знач Значение)
	Возврат Кит.Свойство(Подпись, Кит.Текст(Строка(Значение)));
КонецФункции

Функция Заголовок()
	Возврат "Вход CLI";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Путь страницы подтверждения — один литерал на контроллер.
Функция Путь()
	Возврат "/cli/login";
КонецФункции

Функция ИмяПоляКода()
	Возврат "user_code";
КонецФункции

Функция ИмяПоляДействия()
	Возврат "действие";
КонецФункции

// Анонима уводим на вход с возвратом сюда же: иначе он окажется в кабинете без кода.
Функция АдресВхода(Знач Код)

	Возврат ВозвратВхода.АдресВхода(СюдаЖеСКодом(Код));

КонецФункции

Функция СюдаЖеСКодом(Знач Код)

	Значение = СокрЛП(Строка(Код));
	Возврат ?(ЗначениеЗаполнено(Значение),
		ПараметрыСсылки.Установить(Путь(), "user_code", Значение), Путь());

КонецФункции

// Ключ ограничителя — логин и ведро адреса: блокировка не задевает соседей и не обходится записью адреса.
Функция КлючОграничителя(Знач Принципал, Знач АдресКлиента)
	Возврат СтрШаблон("cli-код:%1|%2", Принципал.Пользователь.Логин, Ведра.Ведро(АдресКлиента));
КонецФункции

Функция ТекстБлокировки()
	Возврат "Слишком много неверных кодов подряд. Подождите и повторите попытку.";
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисВходаCLI") _СервисВхода,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "ОграничительВхода") _Ограничитель,
	&Пластилин(Значение = "ВедроОграничителяПоАдресу") _Ведра,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СтраницаДоступа") _Страница,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "ВозвратПослеВхода") _Возврат,
	&Пластилин(Значение = "ПараметрыСсылки") _Параметры = Неопределено,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено)

	СервисВхода = _СервисВхода;
	Перехватчик = _Перехватчик;
	Ограничитель = _Ограничитель;
	Ведра = _Ведра;
	Защита = _Защита;
	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	Страница = _Страница;
	Кит = _Кит;
	HTTP = _HTTP;
	ВозвратВхода = _Возврат;
	ПараметрыСсылки = ?(_Параметры = Неопределено, Новый ПараметрыСсылки(), _Параметры);
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);

КонецПроцедуры
