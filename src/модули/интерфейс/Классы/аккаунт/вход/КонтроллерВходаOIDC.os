// Публичная страница входа /login, выход и веб-поток OIDC (старт и callback). Транзиентное
// состояние OIDC живёт серверно, в отдельной сессии под своей кукой.

Перем Страница;              // СтраницаДоступа — каркас публичного экрана
Перем Кит;                   // Кит (кит) — фабрика элементов экрана
Перем Тексты;                // ТекстыИнтерфейса (кит)
Перем Конфигурация;          // КонфигурацияOIDC (вход)
Перем СервисВхода;           // СервисВходаOIDC (вход)
Перем СлужбаСессий;          // СлужбаСессий (вход)
Перем Транзакции;            // ХранительТранзакцийOIDC (вход)
Перем СервисАутентификации;  // СервисАутентификации (вход)
Перем ПарольныйВход;         // ПолитикаПарольногоВхода (вход)
Перем КукаСессии;            // КукиСессии (вход) — имя и атрибуты сессионной куки
Перем КукаТранзакции;        // КукаТранзакцииOIDC (вход) — имя и атрибуты куки транзакции
Перем РазборФормы;
Перем ЗначкиПровайдеров;     // ЗначокПровайдера — значок кнопки провайдера
Перем Восстановление;        // ВосстановлениеПароля (вход) — есть ли дорога «забыли пароль»
Перем Отказы;                // ТекстыОтказовВхода — объяснения отказов входа
Перем ОтказСтраны;           // ОтказПоСтране — что сказать закрытому посетителю
Перем ГейтВходаПоСтране;     // ГейтВходаПоСтране (вход) — закрыт ли провайдер посетителю
Перем Посетители;            // ПосетительЗапроса — адрес и заголовки одним значением
Перем Атрибуция;             // АтрибуцияБазыСтран — условие лицензии базы стран
Перем HTTP;                  // МетодыHTTP (основа)
Перем ВозвратВхода;          // ВозвратПослеВхода (вход)
Перем ГейтФормы;             // ГейтФормы — сверяет токен двери выхода
Перем Перехватчик;           // ПерехватчикАутентификации (вход) — вошедший, которому отказал выход

#Область ТочкиМаршрута

// GET /login — страница входа, POST /login — вход по паролю с установкой куки сессии.
//
// Параметры:
//  Ответ - Ответ - ответ winow: HTML-страница входа либо редирект в кабинет.
//  ТелоЗапроса - Строка - тело POST: логин, пароль, next.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса (контекст страницы).
//  МетодЗапроса - Строка - HTTP-метод запроса; прочие методы → 405.
//  АдресУдаленногоУзла - Строка - адрес клиента, ключ ограничителя попыток.
//  next - Строка - куда вернуть после входа; принимается только путь этого хаба
//         (необязательный, по умолчанию "").
//
&ТочкаМаршрута("login")
Процедура Логин(Ответ, ТелоЗапроса, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	АдресУдаленногоУзла, next = "") Экспорт

	Посетитель = Посетители.Собрать(АдресУдаленногоУзла, ЗаголовкиЗапроса);

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьСтраницуВхода(Ответ, "", 200, КукиЗапроса, Строка(next), Посетитель);
		Возврат;
	КонецЕсли;
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответ.Заголовки["Allow"] = "GET, POST";
		ОтдатьСтраницуВхода(Ответ, "Разрешены методы GET, POST", 405, КукиЗапроса, Строка(next),
			Посетитель);
		Возврат;
	КонецЕсли;

	Форма = РазборФормы.Разобрать(ТелоЗапроса);
	Логин = РазборФормы.Поле(Форма, "логин", РазборФормы.Поле(Форма, "login"));
	Пароль = РазборФормы.Поле(Форма, "пароль", РазборФормы.Поле(Форма, "password"));
	АдресВозврата = РазборФормы.Поле(Форма, ВозвратВхода.ИмяПараметра(), Строка(next));

	Результат = СервисАутентификации.ВойтиПоПаролю(Логин, Пароль, Строка(АдресУдаленногоУзла));
	Если НЕ Результат.Успех Тогда
		Письмо = Неопределено;
		Результат.Свойство("Письмо", Письмо);
		ОтдатьСтраницуВхода(Ответ, Отказы.ОтказПароля(Результат.Причина, Письмо),
			Отказы.КодОтказаПароля(Результат.Причина), КукиЗапроса, АдресВозврата, Посетитель);
		Возврат;
	КонецЕсли;

	УстановитьОсновнуюКуку(Ответ, Результат.Сессия.Идентификатор());
	Ответ.Перенаправить(ВозвратВхода.Путь(АдресВозврата));

КонецПроцедуры

// POST /logout — браузерный выход: гасит серверную сессию и стирает куку.
// Только POST и только с токеном сессии: чужая страница не выводит человека из учётки. Сессию
// выключенной учётки (вход ею закрыт) дверь гасит и без токена.
//
// Параметры:
//  Ответ - Ответ - ответ winow: редирект на главную, 403 без токена сессии либо 405.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса (страна от доверенного прокси).
//  КукиЗапроса - Куки - куки запроса (идентификатор сессии).
//  МетодЗапроса - Строка - HTTP-метод запроса.
//  ТелоЗапроса - Строка - тело формы выхода: токен сессии.
//  АдресУдаленногоУзла - Строка - адрес клиента; по нему судится правило о стране.
//
&ТочкаМаршрута("logout")
Процедура Выход(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса,
	АдресУдаленногоУзла) Экспорт

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответ.Заголовки["Allow"] = "POST";
		ОтдатьСтраницуВхода(Ответ, "Для выхода используйте кнопку «Выйти»", 405, КукиЗапроса, "",
			Посетители.Собрать(АдресУдаленногоУзла, ЗаголовкиЗапроса));
		Возврат;
	КонецЕсли;

	// выход — дело сессии браузера: принципал только по куке, ключ из заголовков здесь не в счёт
	Принципал = Перехватчик.ОпределитьПринципала(Новый Соответствие(), КукиЗапроса);
	Если Принципал.Сессия <> Неопределено
		И НЕ ГейтФормы.ТокенПринят(Принципал.Сессия, РазборФормы.Разобрать(ТелоЗапроса)) Тогда
		// сессия вошедшего гаснет только по форме выхода этой сессии: токен — как у любой мутации
		ОтдатьОтказВыхода(Ответ, Принципал, КукиЗапроса);
		Возврат;
	КонецЕсли;

	// сессия выключенной учётки ничего не открывает — подделывать её выход нечего: гаснет без токена
	ИдСессии = КукаСессии.ИзЗапроса(КукиЗапроса);
	Если ЗначениеЗаполнено(ИдСессии) Тогда
		СлужбаСессий.Завершить(ИдСессии);
	КонецЕсли;

	СброситьОсновнуюКуку(Ответ);
	Ответ.Перенаправить("/");

КонецПроцедуры

// GET /login/oidc/{провайдер} — старт входа через провайдера: PKCE, state и nonce
// сохраняются в серверной транзакции, браузер уходит на IdP.
//
// Параметры:
//  Ответ - Ответ - ответ winow: редирект на провайдера, 404, 403 по правилу о стране
//          либо 502 при отказе старта.
//  провайдер - Строка - имя провайдера из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса (страна от доверенного прокси).
//  КукиЗапроса - Куки - куки запроса (контекст страницы).
//  МетодЗапроса - Строка - HTTP-метод запроса; прочие методы → 405.
//  АдресУдаленногоУзла - Строка - адрес клиента; по нему судится правило о стране.
//  next - Строка - куда вернуть после входа; принимается только путь этого хаба
//         (необязательный, по умолчанию "").
//
&ТочкаМаршрута("login/oidc/{провайдер}")
Процедура СтартOIDC(Ответ, провайдер, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	АдресУдаленногоУзла, next = "") Экспорт

	Посетитель = Посетители.Собрать(АдресУдаленногоУзла, ЗаголовкиЗапроса);

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответ.Заголовки["Allow"] = "GET";
		ОтдатьСтраницуВхода(Ответ, "Разрешён только метод GET", 405, КукиЗапроса, Строка(next),
			Посетитель);
		Возврат;
	КонецЕсли;

	Если Конфигурация.Провайдер(провайдер) = Неопределено Тогда
		ОтдатьСтраницуВхода(Ответ, "Неизвестный провайдер входа", 404, КукиЗапроса, Строка(next),
			Посетитель);
		Возврат;
	КонецЕсли;

	Попытка
		Начало = СервисВхода.Начать(провайдер, Посетитель);
	Исключение
		ОтдатьСтраницуВхода(Ответ, "Не удалось начать вход через провайдера", 502, КукиЗапроса,
			Строка(next), Посетитель);
		Возврат;
	КонецПопытки;

	Если НЕ Начало.Успех Тогда
		ОтдатьОтказПоСтране(Ответ, КукиЗапроса, Строка(next), Посетитель);
		Возврат;
	КонецЕсли;

	// адрес возврата едет в серверной транзакции, а не через провайдера: у IdP ему делать
	// нечего, а обратно он вернулся бы уже как значение, пришедшее со стороны
	КукаТранзакции.Установить(Ответ,
		Транзакции.Сохранить(Начало.Транзакция, ВозвратВхода.Путь(next)));
	Ответ.Перенаправить(Начало.URL);

КонецПроцедуры

// GET /oidc/callback — возврат от провайдера: сверка state, обмен кода, вход или привязка.
// Транзакция одноразовая и гасится в любом исходе.
//
// Параметры:
//  Ответ - Ответ - ответ winow: редирект в кабинет либо страница входа с отказом.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса (страна от доверенного прокси).
//  КукиЗапроса - Куки - куки запроса (ключ транзакции).
//  МетодЗапроса - Строка - HTTP-метод запроса; прочие методы → 405.
//  АдресУдаленногоУзла - Строка - адрес клиента; по нему судится правило о стране.
//  code - Строка - код авторизации от провайдера (необязательный, по умолчанию "").
//  state - Строка - состояние от провайдера, сверяется с транзакцией
//          (необязательный, по умолчанию "").
//  error - Строка - код отказа провайдера (необязательный, по умолчанию "").
//
&ТочкаМаршрута("oidc/callback")
Процедура Обратно(Ответ, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, АдресУдаленногоУзла,
	code = "", state = "", error = "") Экспорт

	Посетитель = Посетители.Собрать(АдресУдаленногоУзла, ЗаголовкиЗапроса);

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответ.Заголовки["Allow"] = "GET";
		ОтдатьСтраницуВхода(Ответ, "Разрешён только метод GET", 405, КукиЗапроса, "", Посетитель);
		Возврат;
	КонецЕсли;

	КлючТранзакции = КукаТранзакции.ИзЗапроса(КукиЗапроса);
	// адрес возврата снимаем до гашения транзакции: он нужен и отказу, чтобы человек
	// повторил вход с той же страницы, а не начинал путь заново
	ПутьВозврата = ВозвратВхода.Путь(Транзакции.ПутьВозврата(КлючТранзакции));

	Если ЗначениеЗаполнено(error) Тогда
		Транзакции.Удалить(КлючТранзакции);
		КукаТранзакции.Сбросить(Ответ);
		ОтдатьСтраницуВхода(Ответ, "Провайдер отклонил вход", 400, КукиЗапроса, ПутьВозврата,
			Посетитель);
		Возврат;
	КонецЕсли;

	Транзакция = Транзакции.Прочитать(КлючТранзакции);
	Если Транзакция = Неопределено Тогда
		КукаТранзакции.Сбросить(Ответ);
		ОтдатьСтраницуВхода(Ответ, "Сессия входа истекла или недействительна, повторите вход",
			400, КукиЗапроса, "", Посетитель);
		Возврат;
	КонецЕсли;

	// контекст снимается до гашения транзакции: он живёт в записи хаба рядом с ней
	Привязка = Транзакции.Контекст(КлючТранзакции);
	Исход = СервисВхода.Завершить(Транзакция, Строка(code), Строка(state), Привязка, Посетитель);

	Транзакции.Удалить(КлючТранзакции);
	КукаТранзакции.Сбросить(Ответ);

	Если Исход.Причина = СервисВхода.ПричинаЗакрытаСтрана() Тогда
		ОтдатьОтказПоСтране(Ответ, КукиЗапроса, ПутьВозврата, Посетитель);
		Возврат;
	КонецЕсли;

	Если НЕ Исход.Успех Тогда
		ОтдатьСтраницуВхода(Ответ, Отказы.ОтказПровайдера(Исход.Причина), 400, КукиЗапроса,
			ПутьВозврата, Посетитель);
		Возврат;
	КонецЕсли;

	Если Привязка > 0 Тогда
		// ручная привязка из кабинета — основная сессия не меняется
		Ответ.Перенаправить("/me/settings/oidc");
		Возврат;
	КонецЕсли;

	// вход открывает новую сессию — защита от фиксации
	Сессия = СлужбаСессий.Создать(Исход.Пользователь.Идентификатор);
	УстановитьОсновнуюКуку(Ответ, Сессия.Идентификатор());
	Ответ.Перенаправить(ПутьВозврата);

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьСтраницуВхода(Ответ, Знач Ошибка, Знач Статус, Знач КукиЗапроса,
	Знач АдресВозврата = "", Знач Посетитель = Неопределено)

	ОтдатьСтраницу(Ответ, Ошибка, Статус, КукиЗапроса, АдресВозврата,
		ОткрытыеПровайдеры(Посетитель));

КонецПроцедуры

// Отказ по стране печатается на самой странице входа: запасные пути остаются под рукой.
Процедура ОтдатьОтказПоСтране(Ответ, Знач КукиЗапроса, Знач АдресВозврата, Знач Посетитель)

	Открытые = ОткрытыеПровайдеры(Посетитель);

	ОтдатьСтраницу(Ответ, ОтказСтраны.Текст(Открытые.Количество()), ОтказСтраны.Код(),
		КукиЗапроса, АдресВозврата, Открытые);

КонецПроцедуры

// Страница входа — одна колонка, как у GitHub: отказ над формой, форма пароля, «или»
// и кнопки провайдеров, строка регистрации рамкой, атрибуция базы стран внизу.
Процедура ОтдатьСтраницу(Ответ, Знач Ошибка, Знач Статус, Знач КукиЗапроса,
	Знач АдресВозврата, Знач Провайдеры)

	// пароль выключен — полей логина и пароля на странице нет вовсе: форма, которая
	// гарантированно получит отказ, читается как сломанный хаб
	Если ПарольныйВход.Выключен() Тогда
		Колонка = Страница.Колонка(Страница.ЗаголовокВхода(),
			Страница.Уведомление(Ошибка, "err"),
			КнопкиПровайдеров(Провайдеры, АдресВозврата),
			Страница.Уведомление(ВходитьНечем(Провайдеры), "warn"));
	Иначе
		Колонка = Страница.Колонка(Страница.ЗаголовокВхода(),
			Страница.Уведомление(Ошибка, "err"),
			ФормаПароля(АдресВозврата),
			Кит.Разделитель(Тексты.Текст("access.page.or")).Когда(Провайдеры.Количество() > 0),
			КнопкиПровайдеров(Провайдеры, АдресВозврата),
			СтрокаРегистрации(АдресВозврата));
	КонецЕсли;
	Колонка.Добавить(Атрибуция.Сноска());

	// вход — дорога гостевого меню; смена темы возвращает на вход с тем же возвратом
	Страница.Отдать(Ответ, Статус, Заголовок(), Колонка, КукиЗапроса, Неопределено,
		ВозвратВхода.АдресВхода(АдресВозврата));

КонецПроцедуры

// Кнопка и отказ спрашивают одно правило: закрытого провайдера человек не видит вовсе.
Функция ОткрытыеПровайдеры(Знач Посетитель)
	Возврат ГейтВходаПоСтране.ПровайдерыДляПосетителя(Конфигурация.Провайдеры(), Посетитель);
КонецФункции

Функция ФормаПароля(Знач АдресВозврата)

	Возврат Кит.ФормаБезСессии(ВозвратВхода.ПутьВхода(),
		Кит.Поле("логин", "Логин").Автозаполнение("username"),
		ПолеПароля(),
		ПолеВозврата(АдресВозврата),
		Страница.КнопкаФормы("Войти")).Вид("столбик");

КонецФункции

// «Забыли пароль?» стоит над полем пароля справа — там, где его ищут, ошибившись; дороги
// к восстановлению нет, пока хабу нечем слать письмо.
Функция ПолеПароля()

	Поле = Кит.Поле("пароль", "Пароль").Секрет().Автозаполнение("current-password");
	Если Восстановление <> Неопределено И Восстановление.Доступно() Тогда
		Поле.СсылкаРядом("/forgot-password", Тексты.Текст("recover.page.link"));
	КонецЕсли;
	Возврат Поле;

КонецФункции

// Возврата может не быть вовсе — тогда поля в форме нет.
Функция ПолеВозврата(Знач АдресВозврата)

	Если НЕ ВозвратВхода.Задан(АдресВозврата) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.СкрытоеПоле(ВозвратВхода.ИмяПараметра(), ВозвратВхода.Путь(АдресВозврата));

КонецФункции

Функция СтрокаРегистрации(Знач АдресВозврата)

	Ссылка = Кит.Ссылка(ВозвратВхода.СВозвратом("/register", АдресВозврата),
		Кит.Текст(Тексты.Текст("access.page.signup.link")));
	Возврат Кит.Примечание(Кит.Шаблон(Тексты.Текст("access.page.signup.prompt"), Ссылка)).Вид("рамка");

КонецФункции

// Способы входа — столбиком кнопок во всю ширину, у каждой значок своего бренда.
Функция КнопкиПровайдеров(Знач Провайдеры, Знач АдресВозврата)

	Если Провайдеры.Количество() = 0 Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Столбик = Кит.Область().Вид("столбик");
	Для Каждого Провайдер Из Провайдеры Цикл
		Столбик.Добавить(КнопкаПровайдера(Провайдер, АдресВозврата));
	КонецЦикла;
	Возврат Столбик;

КонецФункции

Функция КнопкаПровайдера(Знач Провайдер, Знач АдресВозврата)

	Адрес = ВозвратВхода.СВозвратом(
		"/login/oidc/" + КодироватьСтроку(Провайдер.Имя, СпособКодированияСтроки.КодировкаURL),
		АдресВозврата);

	Возврат Кит.Кнопка("Войти через " + Строка(Провайдер.Метка)).Вторичная()
		.Иконка(ЗначкиПровайдеров.Имя(Провайдер)).ВоВсюШирину().Адрес(Адрес);

КонецФункции

// Пустая страница входа выглядит поломкой, а не решением администратора.
Функция ВходитьНечем(Знач Провайдеры)

	Если Провайдеры.Количество() > 0 Тогда
		Возврат "";
	КонецЕсли;

	// провайдеры на хабе есть, а этому посетителю не предлагается ни один: это правило
	// по стране, и говорить ему «не настроены» было бы неправдой
	Если Конфигурация.ЕстьПровайдеры() Тогда
		Возврат ОтказСтраны.Текст(0);
	КонецЕсли;

	Возврат "Вход по логину и паролю выключен, а провайдеры входа не настроены."
		+ " Обратитесь к администратору хаба.";

КонецФункции

Функция Заголовок()
	Возврат "Вход";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьОсновнуюКуку(Ответ, Знач ИдСессии)
	КукаСессии.Установить(Ответ, ИдСессии);
КонецПроцедуры

// Отказ выхода по устаревшей странице (вкладка старой сессии): человек остаётся вошедшим — ворота
// с причиной, его учётка и свежая «Выйти» этой сессии в меню каркаса; страница — не ответ на повтор POST.
Процедура ОтдатьОтказВыхода(Ответ, Знач Принципал, Знач КукиЗапроса)

	Заголовок = Тексты.Текст("access.logout.title");
	Страница.Отдать(Ответ, 403, Заголовок,
		Страница.Колонка(Заголовок, Страница.Уведомление(Тексты.Текст("access.logout.stale"), "err")),
		КукиЗапроса, Принципал, "/");

КонецПроцедуры

Процедура СброситьОсновнуюКуку(Ответ)
	КукаСессии.Сбросить(Ответ);
КонецПроцедуры

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СтраницаДоступа") _Страница,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "КонфигурацияOIDC") _Конфигурация,
	&Пластилин(Значение = "СервисВходаOIDC") _СервисВхода,
	&Пластилин(Значение = "СлужбаСессий") _СлужбаСессий,
	&Пластилин(Значение = "ХранительТранзакцийOIDC") _Транзакции,
	&Пластилин(Значение = "СервисАутентификации") _СервисАутентификации,
	&Пластилин(Значение = "ПолитикаПарольногоВхода") _ПарольныйВход,
	&Пластилин(Значение = "КукиСессии") _КукаСессии,
	&Пластилин(Значение = "КукаТранзакцииOIDC") _КукаТранзакции,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "ЗначокПровайдера") _ЗначкиПровайдеров,
	&Пластилин(Значение = "ВосстановлениеПароля") _Восстановление,
	&Пластилин(Значение = "ТекстыОтказовВхода") _Отказы,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "ВозвратПослеВхода") _Возврат,
	&Пластилин(Значение = "ГейтВходаПоСтране") _ГейтВходаПоСтране,
	&Пластилин(Значение = "ПосетительЗапроса") _Посетители,
	&Пластилин(Значение = "ОтказПоСтране") _ОтказСтраны,
	&Пластилин(Значение = "АтрибуцияБазыСтран") _Атрибуция,
	&Пластилин(Значение = "ГейтФормы") _ГейтФормы,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик)

	HTTP = _HTTP;
	ЗначкиПровайдеров = _ЗначкиПровайдеров;
	Восстановление = _Восстановление;
	Отказы = _Отказы;
	ОтказСтраны = _ОтказСтраны;
	ГейтВходаПоСтране = _ГейтВходаПоСтране;
	Посетители = _Посетители;
	Атрибуция = _Атрибуция;
	ВозвратВхода = _Возврат;
	ГейтФормы = _ГейтФормы;
	Перехватчик = _Перехватчик;

	Страница = _Страница;
	Кит = _Кит;
	Тексты = _Тексты;
	Конфигурация = _Конфигурация;
	СервисВхода = _СервисВхода;
	СлужбаСессий = _СлужбаСессий;
	Транзакции = _Транзакции;
	СервисАутентификации = _СервисАутентификации;
	ПарольныйВход = _ПарольныйВход;
	КукаСессии = _КукаСессии;
	КукаТранзакции = _КукаТранзакции;
	РазборФормы = _РазборФормы;

КонецПроцедуры
