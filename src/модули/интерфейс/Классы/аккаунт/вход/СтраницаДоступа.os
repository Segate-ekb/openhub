// Общий каркас страниц-ворот (вход, регистрация, восстановление, подтверждения): узкая колонка
// по центру со знаком хаба и заголовком, уведомление, кнопка формы, ход ко входу и отправка
// ответа. Экраны отличаются содержимым колонки, каркас у них один.

Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем Каркас;        // КаркасСтраницы (кит) — корень страницы
Перем Тексты;        // ТекстыИнтерфейса (кит)
Перем ВозвратВхода;  // ВозвратПослеВхода (вход) — адрес страницы входа
Перем Бренд;         // Брендирование — название хаба
Перем Обрамление;    // ОбрамлениеХаба — знак хаба, тот же, что в шапке
Перем Принципалы;    // ПринципалСтраницы — учётка и сессия из принципала ворот

#Область ПубличныйИнтерфейс

// Колонка страницы-ворот: знак хаба и заголовок сверху, под ними — дети по порядку. Вокруг
// колонки каркас кита печатает только знак и переключатель темы — без дорог и «Войти»;
// вошедшему (подтверждение входа CLI, адреса) — ещё его учётку с единым меню, где есть «Выйти».
//
// Параметры:
//  Заголовок - Строка - имя страницы: заголовок первого уровня колонки.
//  Р1 - ЭлементЭкрана, Неопределено - (необязательный) содержимое колонки.
//  Р2 - ЭлементЭкрана, Неопределено - (необязательный)
//  Р3 - ЭлементЭкрана, Неопределено - (необязательный)
//  Р4 - ЭлементЭкрана, Неопределено - (необязательный)
//  Р5 - ЭлементЭкрана, Неопределено - (необязательный)
//  Р6 - ЭлементЭкрана, Неопределено - (необязательный)
//  Р7 - ЭлементЭкрана, Неопределено - (необязательный)
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел узкой страницы; дальнейшее содержимое — его Добавить.
//
Функция Колонка(Знач Заголовок, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено) Экспорт

	Возврат Кит.УзкаяСтраница(Р1, Р2, Р3, Р4, Р5, Р6, Р7).Шапка(Обрамление.АдресЗнака(), Заголовок);

КонецФункции

// Колонка ворот с вводным абзацем: лид стоит подписью шапки — по центру под заголовком, — а не
// примечанием во всю ширину колонки.
//
// Параметры:
//  Заголовок - Строка - имя страницы: заголовок первого уровня колонки.
//  Лид - Строка, ЭлементЭкрана - вводный абзац; узлом — когда в нём данные (Кит.Шаблон).
//  Р1 - ЭлементЭкрана, Неопределено - (необязательный) содержимое колонки.
//  Р2 - ЭлементЭкрана, Неопределено - (необязательный)
//  Р3 - ЭлементЭкрана, Неопределено - (необязательный)
//  Р4 - ЭлементЭкрана, Неопределено - (необязательный)
//  Р5 - ЭлементЭкрана, Неопределено - (необязательный)
//  Р6 - ЭлементЭкрана, Неопределено - (необязательный)
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел узкой страницы.
//
Функция КолонкаСЛидом(Знач Заголовок, Знач Лид, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено) Экспорт

	Возврат Кит.УзкаяСтраница(Р1, Р2, Р3, Р4, Р5, Р6).Шапка(Обрамление.АдресЗнака(), Заголовок, Лид);

КонецФункции

// Заголовок страницы входа: «Вход в <название хаба>» — то же название, что в шапке.
//
// Возвращаемое значение:
//  Строка
//
Функция ЗаголовокВхода() Экспорт

	Название = СокрЛП(Бренд.Знак());
	Если НЕ ЗначениеЗаполнено(Название) Тогда
		Возврат Тексты.Текст("access.page.signin");
	КонецЕсли;
	Возврат Тексты.Шаблон("access.page.signin.hub", Название);

КонецФункции

// Отдаёт собранную страницу: колонка печатается деревом, вокруг неё встаёт каркас хаба.
//
// Параметры:
//  Ответ        - ОтветСервера  - ответ winow.
//  Статус       - Число         - код состояния ответа.
//  Вкладка      - Строка        - заголовок вкладки браузера.
//  Колонка      - ЭлементЭкрана - колонка страницы, см. Колонка().
//  КукиЗапроса  - Куки, Неопределено - куки запроса: из них берётся оформление читателя.
//  Принципал    - Структура, Неопределено - принципал запроса: Пользователь (учётка и меню
//                 в шапке) и Сессия (токен «Выйти» в меню); гость — Неопределено
//                 (необязательный, по умолчанию Неопределено).
//  Путь         - Строка - адрес открытого экрана: на него возвращает смена темы. Секрет из
//                 адреса (ссылка, код) сюда не кладут — экран с секретом называет свой путь
//                 без него (необязательный, по умолчанию "" — смена темы возвращает на главную).
//
Процедура Отдать(Ответ, Знач Статус, Знач Вкладка, Знач Колонка, Знач КукиЗапроса,
	Знач Принципал = Неопределено, Знач Путь = "") Экспорт

	// сессию страж уже прочитал: меню вошедшего берёт токен «Выйти» у неё, а не второй раз по куке
	Ответ.УстановитьСостояние(Статус);
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Вкладка, Колонка,
		Каркас.КонтекстСтраницы(Принципалы.Пользователь(Принципал), КукиЗапроса, Ложь, Ложь, Путь,
			Принципалы.Сессия(Принципал)));

КонецПроцедуры

// Уведомление об исходе действия внутри колонки; пустой текст не печатается вовсе.
//
// Параметры:
//  Текст - Строка - сообщение человеку.
//  Вид   - Строка - «err» (отказ) | «warn» (предупреждение) | «ok» (получилось).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Уведомление(Знач Текст, Знач Вид) Экспорт

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Уведомление(Текст).Вид(Вид);

КонецФункции

// Кнопка отправки формы доступа: на такой форме она одна, основная и во всю ширину.
//
// Параметры:
//  Подпись - Строка - надпись на кнопке.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция КнопкаФормы(Знач Подпись) Экспорт
	Возврат Кит.Кнопка(Подпись).Основная().ВоВсюШирину();
КонецФункции

// Сноска со ссылкой на вход: ею кончаются экраны, с которых человеку дальше входить.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция СноскаВхода() Экспорт
	Возврат Кит.Примечание(СсылкаВхода());
КонецФункции

// Ссылка на страницу входа — её ставят и в середину своей фразы.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция СсылкаВхода() Экспорт
	Возврат Кит.Ссылка(ВозвратВхода.ПутьВхода(), Кит.Текст(Тексты.Текст("access.page.login")));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ВозвратПослеВхода") _ВозвратВхода,
	&Пластилин(Значение = "Брендирование") _Бренд,
	&Пластилин(Значение = "ОбрамлениеХаба") _Обрамление,
	&Пластилин(Значение = "ПринципалСтраницы") _Принципалы = Неопределено) Экспорт

	Кит = _Кит;
	Каркас = _Каркас;
	Тексты = _Тексты;
	ВозвратВхода = _ВозвратВхода;
	Бренд = _Бренд;
	Обрамление = _Обрамление;
	Принципалы = ?(_Принципалы = Неопределено, Новый ПринципалСтраницы(), _Принципалы);

КонецПроцедуры
