// Страница /register: форма регистрации поверх СервисРегистрации; пока регистрация закрыта,
// вместо формы — объяснение причины, статус и код отказа из таблицы ОтказыУчётки.

Перем СервисРегистрации;  // СервисРегистрации (вход)
Перем Отказы;             // ОтказыУчётки (вход) — код и статус причины отказа
Перем ТекстыОтказов;      // ТекстыОтказовВхода — объяснение отказа по коду
Перем ГейтАдреса;         // ГейтПодтвержденияАдреса (вход) — нужен ли подтверждённый адрес
Перем СлужбаСессий;       // СлужбаСессий (вход)
Перем КукаСессии;         // КукиСессии (вход) — имя и атрибуты сессионной куки
Перем Страница;           // СтраницаДоступа — каркас публичного экрана
Перем Кит;                // Кит (кит) — фабрика элементов экрана
Перем Подсказка;          // ПодсказкаПароля
Перем РазборФормы;
Перем HTTP;               // МетодыHTTP (основа)
Перем ВозвратВхода;       // ВозвратПослеВхода (вход)

// Отдаёт форму регистрации (GET) либо регистрирует пользователя и открывает сессию (POST).
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  ТелоЗапроса      - Строка       - тело POST-формы.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса      - Куки         - оформление читателя.
//  МетодЗапроса     - Строка       - HTTP-метод; кроме GET и POST — 405.
//  АдресУдаленногоУзла - Строка   - адрес клиента: по нему хаб считает суточный потолок
//                     писем подтверждения с одного источника.
//  next             - Строка       - куда вернуть после регистрации; принимается только
//                     путь этого хаба (необязательный, по умолчанию "").
//
&ТочкаМаршрута("register")
Процедура Регистрация(Ответ, ТелоЗапроса, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	АдресУдаленногоУзла, next = "") Экспорт

	ПричинаЗакрытия = ПричинаЗакрытойФормы();
	АдресВозврата = Строка(next);

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		// пока нет администратора, форму показывать незачем: человека ведут в мастер,
		// иначе аноним перехватил бы первый запуск
		Если СервисРегистрации.ЗаблокированаОнбордингом() Тогда
			Ответ.Перенаправить("/setup");
		Иначе
			ОтдатьСтраницу(Ответ, ПричинаЗакрытия, "", 200, КукиЗапроса, АдресВозврата);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответ.Заголовки["Allow"] = "GET, POST";
		ОтдатьСтраницу(Ответ, ПричинаЗакрытия, "Разрешены методы GET, POST", 405, КукиЗапроса,
			АдресВозврата);
		Возврат;
	КонецЕсли;

	Форма = РазборФормы.Разобрать(ТелоЗапроса);
	АдресВозврата = РазборФормы.Поле(Форма, ВозвратВхода.ИмяПараметра(), АдресВозврата);

	Логин = РазборФормы.Поле(Форма, "логин", РазборФормы.Поле(Форма, "login"));
	Email = РазборФормы.Поле(Форма, "email");
	Пароль = РазборФормы.Поле(Форма, "пароль", РазборФормы.Поле(Форма, "password"));

	// собственной проверки закрытых режимов здесь нет: запреты судит служба, и её отказ
	// одинаков во всех дверях — статус и код берутся из общей таблицы
	Попытка
		Пользователь = СервисРегистрации.Зарегистрировать(Логин, Email, Пароль,
			Строка(АдресУдаленногоУзла));
	Исключение
		ОтдатьСтраницуСОтказом(Ответ, ПричинаЗакрытия, Отказы.Разобрать(ИнформацияОбОшибке()),
			Логин, Email, КукиЗапроса, АдресВозврата);
		Возврат;
	КонецПопытки;

	Если ГейтАдреса.Закрыт(Пользователь) Тогда
		ОтдатьПриглашениеПодтвердить(Ответ, Пользователь, КукиЗапроса, АдресВозврата);
		Возврат;
	КонецЕсли;

	// подтверждать нечего — открываем сессию и уводим туда, откуда человек пришёл
	Сессия = СлужбаСессий.Создать(Пользователь.Идентификатор);
	КукаСессии.Установить(Ответ, Сессия.Идентификатор());
	Ответ.Перенаправить(ВозвратВхода.Путь(АдресВозврата));

КонецПроцедуры

#Область Рендер

// Учётная запись заведена, но до нажатия кнопки в письме вход закрыт.
Процедура ОтдатьПриглашениеПодтвердить(Ответ, Знач Пользователь, Знач КукиЗапроса, Знач АдресВозврата)

	Колонка = Страница.Колонка(ЗаголовокПодтверждения(),
		Страница.Уведомление(СтрШаблон(
			"Учётная запись «%1» создана. На адрес %2 отправлено письмо со ссылкой"
			+ " подтверждения — откройте её и нажмите кнопку: до этого вход закрыт.",
			Строка(Пользователь.Логин), Строка(Пользователь.Email)), "ok"),
		Кит.Примечание("Письмо не пришло — попробуйте войти: хаб вышлет ссылку заново."),
		СтрокаВхода("Адрес подтверждён? %1", АдресВозврата));

	Страница.Отдать(Ответ, 200, ЗаголовокПодтверждения(), Колонка, КукиЗапроса, Неопределено,
		АдресЭкрана(АдресВозврата));

КонецПроцедуры

Процедура ОтдатьСтраницу(Ответ, Знач ПричинаЗакрытия, Знач Ошибка, Знач Статус,
	Знач КукиЗапроса, Знач АдресВозврата)
	ОтдатьСтраницуПолная(Ответ, ПричинаЗакрытия, Ошибка, "", "", Статус, КукиЗапроса,
		АдресВозврата);
КонецПроцедуры

// Статус отказа — из общей таблицы, слова — свои, экранные, выбранные по той же причине.
Процедура ОтдатьСтраницуСОтказом(Ответ, Знач ПричинаЗакрытия, Знач Отказ, Знач Логин,
	Знач Email, Знач КукиЗапроса, Знач АдресВозврата)
	ОтдатьСтраницуПолная(Ответ, ПричинаЗакрытия,
		ТекстыОтказов.ОтказРегистрации(Отказ.Причина, Отказ.Сообщение),
		Логин, Email, Отказ.Статус, КукиЗапроса, АдресВозврата);
КонецПроцедуры

// Закрытая форма заменяется объяснением причины: форма, обречённая на отказ, — трата времени.
Процедура ОтдатьСтраницуПолная(Ответ, Знач ПричинаЗакрытия, Знач Ошибка, Знач Логин,
	Знач Email, Знач Статус, Знач КукиЗапроса, Знач АдресВозврата)

	Если ЗначениеЗаполнено(ПричинаЗакрытия) Тогда
		Колонка = Страница.Колонка(Заголовок(),
			Страница.Уведомление(ТекстыОтказов.ОтказРегистрации(ПричинаЗакрытия, ""), "warn"),
			СтрокаВхода("Уже есть аккаунт? %1", АдресВозврата));
	Иначе
		Колонка = Страница.Колонка(Заголовок(),
			Страница.Уведомление(Ошибка, "err"),
			ФормаРегистрации(Логин, Email, АдресВозврата),
			СтрокаВхода("Уже есть аккаунт? %1", АдресВозврата));
	КонецЕсли;

	Страница.Отдать(Ответ, Статус, Заголовок(), Колонка, КукиЗапроса, Неопределено,
		АдресЭкрана(АдресВозврата));

КонецПроцедуры

// Рамочная строка под формой со ссылкой на вход: «Уже есть аккаунт? Войти».
Функция СтрокаВхода(Знач Образец, Знач АдресВозврата)
	Возврат Кит.Примечание(Кит.Шаблон(Образец, СсылкаВхода(АдресВозврата))).Вид("рамка");
КонецФункции

// Вход зовётся с тем же возвратом, с каким пришли сюда: человек попадёт туда, куда шёл.
Функция СсылкаВхода(Знач АдресВозврата)
	Возврат Кит.Ссылка(ВозвратВхода.АдресВхода(АдресВозврата), Кит.Текст("Войти"));
КонецФункции

Функция ФормаРегистрации(Знач Логин, Знач Email, Знач АдресВозврата)

	Возврат Кит.ФормаБезСессии(Путь(),
		Кит.Поле("логин", "Логин").Значение(Логин).Автозаполнение("username"),
		Кит.Поле("email", "Email").Значение(Email).Автозаполнение("email"),
		Кит.Поле(ИмяПоляПароля(), "Пароль").Секрет().Автозаполнение("new-password"),
		Подсказка.Требования(ИмяПоляПароля()),
		ПолеВозврата(АдресВозврата),
		Страница.КнопкаФормы("Зарегистрироваться")).Вид("столбик");

КонецФункции

// Возврата может не быть вовсе — тогда поля в форме нет.
Функция ПолеВозврата(Знач АдресВозврата)

	Если НЕ ВозвратВхода.Задан(АдресВозврата) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.СкрытоеПоле(ВозвратВхода.ИмяПараметра(), ВозвратВхода.Путь(АдресВозврата));

КонецФункции

Функция Заголовок()
	Возврат "Регистрация";
КонецФункции

Функция ЗаголовокПодтверждения()
	Возврат "Подтвердите адрес";
КонецФункции

Функция ИмяПоляПароля()
	Возврат "пароль";
КонецФункции

Функция Путь()
	Возврат "/register";
КонецФункции

// Адрес страницы с тем же возвратом, с каким на неё пришли: на него возвращает смена темы.
Функция АдресЭкрана(Знач АдресВозврата)
	Возврат ВозвратВхода.СВозвратом(Путь(), АдресВозврата);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Причина закрытия формы от службы, кроме первого запуска (его ведёт мастер); "" — форма открыта.
Функция ПричинаЗакрытойФормы()

	Причина = СервисРегистрации.ПричинаОтказа();
	Возврат ?(Причина = Отказы.ОнбордингНеЗавершён(), "", Причина);

КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисРегистрации") _СервисРегистрации,
	&Пластилин(Значение = "ОтказыУчётки") _Отказы,
	&Пластилин(Значение = "ТекстыОтказовВхода") _ТекстыОтказов,
	&Пластилин(Значение = "ГейтПодтвержденияАдреса") _ГейтАдреса,
	&Пластилин(Значение = "СлужбаСессий") _СлужбаСессий,
	&Пластилин(Значение = "КукиСессии") _КукаСессии,
	&Пластилин(Значение = "СтраницаДоступа") _Страница,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ПодсказкаПароля") _Подсказка,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "ВозвратПослеВхода") _Возврат)

	HTTP = _HTTP;
	ВозвратВхода = _Возврат;

	СервисРегистрации = _СервисРегистрации;
	Отказы = _Отказы;
	ТекстыОтказов = _ТекстыОтказов;
	ГейтАдреса = _ГейтАдреса;
	СлужбаСессий = _СлужбаСессий;
	КукаСессии = _КукаСессии;
	Страница = _Страница;
	Кит = _Кит;
	Подсказка = _Подсказка;
	РазборФормы = _РазборФормы;

КонецПроцедуры
