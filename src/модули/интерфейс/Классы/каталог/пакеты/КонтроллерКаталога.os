// Единый каталог пакетов с поиском, страницами и двумя отборами — по пулу и «в моём управлении».
// Отбор и страница живут в адресе: строка поиска — GET-форма, вкладки отборов и шаги страниц —
// ссылки; со скриптом поиск и страницы меняют список без перезагрузки, без скрипта — обычной
// навигацией.

Перем Каталог;       // КаталогПакетов
Перем Витрина;       // ВитринаПакетов
Перем КарточкиUI;    // КарточкаОбъекта
Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем Каркас;        // КаркасСтраницы (кит) — корень страницы
Перем Тексты;        // ТекстыИнтерфейса (кит)
Перем Перехватчик;   // ПерехватчикАутентификации (вход)
Перем Гвард;         // ГвардОнбординга
Перем Адреса;        // АдресаКаталога — каждое состояние отбора своим адресом
Перем Числа;         // ПриведениеЧисел (основа) — терпимое чтение числа
Перем Флаги;         // ПриведениеФлагов (основа) — флажок формы
Перем Страницы;      // АдресаСтраниц (реестр) — страница пула в плашке отбора

// Отдаёт каталог пакетов.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - для определения принципала (PAT или сессия).
//  КукиЗапроса      - Куки         - сессия и оформление читателя.
//  ПолныйПутьЗапроса - Строка      - путь запроса с параметрами: по нему меню подсвечивает
//                     текущую дорогу.
//  q                - Строка       - (необязательный, по умолчанию "") подстрока имени.
//  page             - Строка       - (необязательный, по умолчанию "") номер страницы.
//  pool             - Строка       - (необязательный, по умолчанию "") отбор по пулу.
//  mine             - Строка       - (необязательный, по умолчанию "") отбор
//                     «в моём управлении», значение "1".
//
&ТочкаМаршрута("")
Процедура Список(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ПолныйПутьЗапроса,
	q = "", page = "", pool = "", mine = "") Экспорт
	ПоказатьКаталог(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ПолныйПутьЗапроса, q, page, pool, mine);
КонецПроцедуры

// Тот же каталог по адресу /packages/search — совместимость URL текущего хаба.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - для определения принципала.
//  КукиЗапроса      - Куки         - сессия и оформление читателя.
//  ПолныйПутьЗапроса - Строка      - путь запроса с параметрами, см. Список.
//  q, page, pool, mine - Строка - (необязательные, по умолчанию "") см. Список.
//
&ТочкаМаршрута("search")
Процедура Поиск(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ПолныйПутьЗапроса,
	q = "", page = "", pool = "", mine = "") Экспорт
	ПоказатьКаталог(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ПолныйПутьЗапроса, q, page, pool, mine);
КонецПроцедуры

Процедура ПоказатьКаталог(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ПутьСтраницы,
	Знач q, Знач page, Знач pool, Знач mine)

	Если НЕ Гвард.Проверить(Ответ).Разрешено Тогда
		Возврат;
	КонецЕсли;

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);
	Пользователь = Принципал.Пользователь;

	Отбор = Новый Структура("Пул, ТолькоУправляемые", СокрЛП(Строка(pool)), Флаги.ФлажокФормы(mine));
	Результат = Каталог.НайтиПакеты(q, НомерСтраницы(page), 0, Принципал, Отбор);
	Заголовок = ЗаголовокСтраницы(Результат.Отбор);

	Содержимое = Кит.Холст(
		Кит.ЗаголовокСтраницы(Заголовок),
		СтрокаПоиска(Результат),
		ВкладкиОтбора(Результат.Отбор, Пользователь),
		ПолосаПримененногоОтбора(Результат.Отбор),
		Итог(Результат),
		СписокПакетов(Результат, Пользователь),
		Пагинация(Результат));

	Ответ.УстановитьСостояниеОК();
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Заголовок, Содержимое,
		Каркас.КонтекстСтраницы(Пользователь, КукиЗапроса, Ложь, Ложь, ПутьСтраницы, Принципал.Сессия));

КонецПроцедуры

#Область Рендер

Функция ЗаголовокСтраницы(Знач Отбор)

	Если Отбор.ТолькоУправляемые Тогда
		Возврат Тексты.Текст("public.catalog.title.mine");
	ИначеЕсли ЗначениеЗаполнено(Отбор.Пул) Тогда
		Возврат Тексты.Шаблон("public.catalog.title.pool", Отбор.Пул);
	КонецЕсли;
	Возврат Тексты.Текст("public.catalog.title");

КонецФункции

// Строка поиска — как на главной: подсказка в поле, метка только для скринридера, значок поиска
// в самой строке. Отборы едут скрытыми полями: иначе поиск внутри отбора сбрасывал бы отбор;
// номер страницы не едет — новый поиск начинается с первой.
Функция СтрокаПоиска(Знач Результат)

	Поиск = Кит.СтрокаПоиска(Адреса.Каталог())
		.Метка(Тексты.Текст("public.catalog.search.label")).СкрытаяМетка()
		.Значение(Результат.Запрос)
		.Пример(Тексты.Текст("public.catalog.search.placeholder"))
		.БезПерезагрузки();
	Для Каждого Пара Из ПарыОтбора(Результат.Отбор) Цикл
		Поиск.СкрытоеПоле(Пара.Имя, Пара.Значение);
	КонецЦикла;
	Возврат Поиск;

КонецФункции

// Аноним отбора «в моём управлении» не видит: он ничем не управляет.
Функция ВкладкиОтбора(Знач Отбор, Знач Пользователь)

	Если Пользователь = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Табы(
		Кит.Вкладка(Тексты.Текст("public.catalog.tab.all"), АдресОтбора(Отбор, Ложь))
			.Активна(НЕ Отбор.ТолькоУправляемые).Иконка("пакет"),
		Кит.Вкладка(Тексты.Текст("public.catalog.tab.mine"), АдресОтбора(Отбор, Истина))
			.Активна(Отбор.ТолькоУправляемые).Иконка("шестерёнка"))
		.Заголовок(Тексты.Текст("public.catalog.tabs.title"));

КонецФункции

// Отбор пришёл из адреса: без напоминания выдача читается как весь каталог.
Функция ПолосаПримененногоОтбора(Знач Отбор)

	Если НЕ ЗначениеЗаполнено(Отбор.Пул) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Область(Кит.РядПлашек(
		Кит.Плашка(Тексты.Шаблон("public.catalog.filter.pool", Отбор.Пул))
			.Вид("accent").Иконка("куб").Адрес(Страницы.Пула(Отбор.Пул)))).Вид("отбор");

КонецФункции

// Отбор по пулу обязан переживать переключение «управляемые».
Функция АдресОтбора(Знач Отбор, Знач ТолькоУправляемые)
	Возврат Адреса.Каталог(Отбор.Пул, ТолькоУправляемые);
КонецФункции

Функция Итог(Знач Результат)

	Если Результат.Всего = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Кит.Примечание(Тексты.Шаблон("public.catalog.found", Формат(Результат.Всего, "ЧН=0; ЧГ=0")));

КонецФункции

Функция СписокПакетов(Знач Результат, Знач Пользователь)

	Если Результат.Элементы.Количество() = 0 Тогда
		Возврат ПустаяВыдача(Результат);
	КонецЕсли;

	Возврат КарточкиUI.Список(Витрина.Карточки(Результат.Элементы, Пользователь));

КонецФункции

// Пустая выдача объясняет, почему пусто, и ведёт туда, где не пусто.
Функция ПустаяВыдача(Знач Результат)

	Отбор = Результат.Отбор;

	Если ЗначениеЗаполнено(Результат.Запрос) Тогда
		Возврат Кит.ПустоеСостояние(Тексты.Текст("public.catalog.empty.query.lead"))
			.Заголовок(Тексты.Шаблон("public.catalog.empty.query.title", Результат.Запрос))
			.Иконка("поиск")
			.Действие(ПоказатьВсе(Адреса.Каталог()));
	КонецЕсли;

	Если Отбор.ТолькоУправляемые Тогда
		Возврат Кит.ПустоеСостояние(Тексты.Текст("public.catalog.empty.mine.lead"))
			.Заголовок(Тексты.Текст("public.catalog.empty.mine.title"))
			.Иконка("шестерёнка")
			.Действие(ПоказатьВсе(АдресОтбора(Отбор, Ложь)));
	КонецЕсли;

	Если ЗначениеЗаполнено(Отбор.Пул) Тогда
		Возврат Кит.ПустоеСостояние(Тексты.Текст("public.catalog.empty.pool.lead"))
			.Заголовок(Тексты.Текст("public.catalog.empty.pool.title"))
			.Иконка("куб");
	КонецЕсли;

	Возврат Кит.ПустоеСостояние(Тексты.Текст("public.catalog.empty.lead"))
		.Заголовок(Тексты.Текст("public.catalog.empty.title"))
		.Иконка("пакет");

КонецФункции

Функция ПоказатьВсе(Знач Адрес)
	Возврат Кит.Кнопка(Тексты.Текст("public.catalog.empty.all")).Вторичная().Адрес(Адрес);
КонецФункции

// Шаги страниц несут запрос и отборы, иначе вторая страница поиска показала бы весь каталог.
Функция Пагинация(Знач Результат)

	Шаги = Кит.Пагинация(Адреса.Каталог(), Результат.Страница, Результат.ВсегоСтраниц)
		.БезПерезагрузки();
	Если ЗначениеЗаполнено(Результат.Запрос) Тогда
		Шаги.Параметры("q", Результат.Запрос);
	КонецЕсли;
	Для Каждого Пара Из ПарыОтбора(Результат.Отбор) Цикл
		Шаги.Параметры(Пара.Имя, Пара.Значение);
	КонецЦикла;
	Возврат Шаги;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отбор параметрами адреса: пул и «в моём управлении».
Функция ПарыОтбора(Знач Отбор)

	Результат = Новый Массив();
	Если ЗначениеЗаполнено(Отбор.Пул) Тогда
		Результат.Добавить(Новый Структура("Имя, Значение", "pool", Отбор.Пул));
	КонецЕсли;
	Если Отбор.ТолькоУправляемые Тогда
		Результат.Добавить(Новый Структура("Имя, Значение", "mine", "1"));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Страниц с номером меньше первой не бывает: мусор и ноль читаются как первая.
Функция НомерСтраницы(Знач Значение)
	Возврат Макс(1, Цел(Числа.ЧислоИлиДефолт(Значение, 1)));
КонецФункции

#КонецОбласти

&Контроллер("/packages")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаталогПакетов") _Каталог,
	&Пластилин(Значение = "ВитринаПакетов") _Витрина,
	&Пластилин(Значение = "КарточкаОбъекта") _КарточкиUI,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "ГвардОнбординга") _Гвард,
	&Пластилин(Значение = "АдресаКаталога") _Адреса,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа = Неопределено,
	&Пластилин(Значение = "ПриведениеФлагов") _Флаги = Неопределено)

	Каталог = _Каталог;
	Витрина = _Витрина;
	КарточкиUI = _КарточкиUI;
	Кит = _Кит;
	Каркас = _Каркас;
	Тексты = _Тексты;
	Перехватчик = _Перехватчик;
	Гвард = _Гвард;
	Адреса = _Адреса;
	Числа = ?(_Числа = Неопределено, Новый ПриведениеЧисел(), _Числа);
	Флаги = ?(_Флаги = Неопределено, Новый ПриведениеФлагов(), _Флаги);
	Страницы = _Страницы;

КонецПроцедуры
