// Главная страница, GET /: поиск, обзор пулов, свежее и популярное, быстрый старт.
// Всё серверным рендером и обычными формами; тему из кук достаёт каркас страницы.

Перем Витрина;        // ВитринаГлавной
Перем МоделиКарточек; // ВитринаПакетов — модели карточек пакетов блока
Перем КарточкиUI;     // КарточкаОбъекта
Перем ПлашкиПулов;    // ПлашкиПула
Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем Каркас;         // КаркасСтраницы (кит) — корень страницы
Перем Тексты;         // ТекстыИнтерфейса (кит)
Перем Бренд;          // Брендирование — знак и подпись инсталляции
Перем Гвард;          // ГвардОнбординга
Перем Перехватчик;    // ПерехватчикАутентификации (вход)
Перем Команды;        // КомандыOpm
Перем СервисПулов;    // СервисПулов (реестр)
Перем АдресаКабинета; // АдресаКабинета — адрес проводника первой публикации
Перем Даты;           // ДатаЧеловеку — одно написание момента на весь интерфейс
Перем Страницы;       // АдресаСтраниц (реестр) — страница пула в карточке
Перем Каталог;        // АдресаКаталога — адрес, куда уходит поиск с главной

// Отдаёт главную страницу.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - для определения принципала.
//  КукиЗапроса      - Куки         - сессия и оформление читателя.
//
&ТочкаМаршрута("/")
Процедура Показать(Ответ, ЗаголовкиЗапроса, КукиЗапроса) Экспорт

	Если НЕ Гвард.Проверить(Ответ).Разрешено Тогда
		Возврат;
	КонецЕсли;

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);
	Обзор = Витрина.Обзор(Принципал);
	Основной = СервисПулов.ДефолтныйПул();
	ПропискаНужна = Команды.ПропискаНужна(Основной);

	Главная = Кит.Холст(
		ПолосаПоиска(),
		Витрины(Обзор, Принципал.Пользователь, ПропискаНужна),
		БлокБыстрогоСтарта(ЗаголовкиЗапроса, Основной, ПропискаНужна));

	// заголовок вкладки — подпись инсталляции: со знаком главная неотличима от любой
	// внутренней страницы хаба в закладках
	ОтдатьHTML(Ответ, Бренд.Подпись(), Главная, Принципал, КукиЗапроса);

КонецПроцедуры

#Область Рендер

// Первая полоса — строка поиска без карточки и заголовка: имя хаба и дорога «Каталог» уже
// в шапке. Обычная GET-форма в каталог: работает без скрипта, у каждого запроса свой адрес.
Функция ПолосаПоиска()

	Возврат Кит.Холст(
		Кит.СтрокаПоиска(Каталог.Каталог())
			.Пример(Тексты.Текст("public.landing.search.placeholder")),
		Кит.Примечание(Тексты.Текст("public.landing.lead")));

КонецФункции

// Свежий хаб не показывает нули в рамочках, а объясняет, что делать дальше.
Функция Витрины(Знач Обзор, Знач Пользователь, Знач ПропискаНужна)

	Если Обзор.Пусто Тогда
		Возврат ПустойХаб(Пользователь, ПропискаНужна);
	КонецЕсли;

	Возврат Кит.Холст(
		БлокПулов(Обзор),
		БлокКарточек(Обзор.Новинки, Тексты.Текст("public.landing.fresh.title"),
			Тексты.Текст("public.landing.fresh.lead"), "история"),
		БлокКарточек(Обзор.Популярные, Тексты.Текст("public.landing.popular.title"),
			Тексты.Текст("public.landing.popular.lead"), "скачать"));

КонецФункции

// Обзор пулов — перечень, а не выборка из ленты: полные ряды спрятали бы настоящие пулы.
Функция БлокПулов(Знач Обзор)

	Если Обзор.Пулы.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Заголовок = Тексты.Текст("public.landing.pools.title");
	Пулы = Кит.Сетка().Колонки(4).Заголовок(Заголовок);
	Для Каждого Запись Из Обзор.Пулы Цикл
		Пулы.Добавить(КарточкаПула(Запись));
	КонецЦикла;

	Возврат Кит.Карточка(Заголовок, Пулы, ПоказаныНеВсе(Обзор))
		.Описание(Тексты.Текст("public.landing.pools.lead")).Иконка("куб");

КонецФункции

// «Показаны не все» говорим прямо: обзор ограничен пределом витрины.
Функция ПоказаныНеВсе(Знач Обзор)

	Показано = Обзор.Пулы.Количество();
	Всего = Обзор.Сводка.ПуловКоманд;

	Возврат Кит.Примечание(Тексты.Шаблон("public.landing.pools.more", Показатель(Показано), Показатель(Всего)))
		.Когда(Всего > Показано);

КонецФункции

// Пул — той же карточкой объекта, что пакет рядом. Роль пула только содержательная: проектный тип
// есть у всех и ничего не сообщает.
Функция КарточкаПула(Знач Запись)

	Пул = Запись.Пул;
	Плашки = Новый Массив();
	Основной = ПлашкиПулов.ПлашкаОсновного(Пул);
	Если Основной <> Неопределено Тогда
		Плашки.Добавить(Основной);
	КонецЕсли;
	Плашки.Добавить(ПлашкиПулов.ПлашкаВидимости(Пул));

	Возврат КарточкиUI.Карточка(Новый Структура("Имя, Адрес, Иконка, Описание, Плашки",
		Пул.Имя, Страницы.Пула(Пул.Имя), "куб",
		Тексты.Шаблон("public.landing.pools.packages", Показатель(Запись.Пакетов)), Плашки));

КонецФункции

// Витрина, а не лента: карточки идут сеткой, и ни одна не требует прокрутки.
Функция БлокКарточек(Знач Записи, Знач Заголовок, Знач Пояснение, Знач ИмяИконки)

	Если Записи.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Карточка(Заголовок, ПолныеРядыПоЧетыре(КарточкиПакетов(Записи), Заголовок))
		.Описание(Пояснение).Иконка(ИмяИконки);

КонецФункции

// Ленты главной — новинки и популярное — по четыре в ряд и только полными рядами: неполный
// последний ряд на каждой ширине кит прячет сам, без скрипта; первый ряд не прячется никогда.
// Имя НЕ «Сетка»: так зовётся класс кита, а имена типов в OneScript глобальны.
Функция ПолныеРядыПоЧетыре(Знач КарточкиБлока, Знач Заголовок)

	Раскладка = Кит.Сетка().Колонки(4).ПолныеРяды().Заголовок(Заголовок);
	Для Каждого Карточка Из КарточкиБлока Цикл
		Раскладка.Добавить(Карточка);
	КонецЦикла;
	Возврат Раскладка;

КонецФункции

// Модели карточек собираются разом на весь блок: провенанс спрашивается один раз, а не на карточку.
Функция КарточкиПакетов(Знач Записи)

	Модели = МоделиКарточек.Карточки(Записи);

	Результат = Новый Массив();
	Для Индекс = 0 По Записи.ВГраница() Цикл
		ДополнитьМетриками(Модели[Индекс], Записи[Индекс]);
		Результат.Добавить(КарточкиUI.Карточка(Модели[Индекс]));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ряд метрик обоих блоков в одном порядке; модель правится на месте — она уже в списке.
Процедура ДополнитьМетриками(Модель, Знач Запись)

	Мета = Новый Массив();
	Значение = Неопределено;

	Если Запись.Свойство("Версия", Значение) И ЗначениеЗаполнено(Значение) Тогда
		Модель.Вставить("Версия", Значение);
	КонецЕсли;

	Если Запись.Свойство("Скачиваний", Значение) Тогда
		Мета.Добавить(Новый Структура("Подпись, Значение",
			Тексты.Текст("public.landing.popular.downloads"), Показатель(Значение)));
	КонецЕсли;

	Если Запись.Свойство("Опубликована", Значение) Тогда
		ДобавитьДату(Мета, Значение, Тексты.Текст("public.landing.fresh.published"));
	КонецЕсли;

	Если Запись.Свойство("Обновлена", Значение) Тогда
		ДобавитьДату(Мета, Значение, Тексты.Текст("public.landing.popular.updated"));
	КонецЕсли;

	Модель.Вставить("Мета", Мета);

КонецПроцедуры

// Ключ словаря обязан остаться литералом в вызове резолвера: иначе сборщик ключей его не увидит.
Процедура ДобавитьДату(Мета, Знач Значение, Знач Подпись)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;

	Мета.Добавить(Новый Структура("Подпись, Значение",
		Подпись, Даты.ТолькоДата(Значение)));

КонецПроцедуры

// Пустой хаб ведёт дальше: гостя — на вход, вошедшего — к первым шагам.
Функция ПустойХаб(Знач Пользователь, Знач ПропискаНужна)

	Возврат Кит.ПустоеСостояние(ПояснениеПустогоХаба(ПропискаНужна))
		.Заголовок(Тексты.Текст("public.landing.empty.title"))
		.Иконка("пакет")
		.Действие(ДальшеСПустогоХаба(Пользователь));

КонецФункции

Функция ДальшеСПустогоХаба(Знач Пользователь)

	Если Пользователь = Неопределено Тогда
		Возврат Кит.Кнопка(Тексты.Текст("public.landing.empty.login")).Вторичная().Адрес("/login");
	КонецЕсли;

	Возврат Кит.Кнопка(Тексты.Текст("public.landing.empty.tour")).Вторичная().Адрес(АдресаКабинета.Проводник());

КонецФункции

// Без opm.cfg opm push уходит в основной пул хаба по умолчанию, а токен и канал получает опциями.
Функция ПояснениеПустогоХаба(Знач ПропискаНужна)

	Если ПропискаНужна Тогда
		Возврат Тексты.Текст("public.landing.empty.lead");
	КонецЕсли;

	Возврат Тексты.Текст("public.landing.empty.lead.default-hub");

КонецФункции

// Образец не сочиняется: узел из настройки либо из Host, пул — основной; нет их — объяснение.
Функция БлокБыстрогоСтарта(Знач ЗаголовкиЗапроса, Знач Основной, Знач ПропискаНужна)

	Узел = Команды.Узел(ЗаголовкиЗапроса);

	Возврат Кит.Карточка(Тексты.Текст("public.landing.start.title"),
		ОбразецСтарта(Основной, Узел, ПропискаНужна)).Иконка("скачать");

КонецФункции

// Пояснение команды продолжает образец настройки, когда тот стоит выше.
Функция ОбразецСтарта(Знач Основной, Знач Узел, Знач ПропискаНужна)

	Если НЕ ЗначениеЗаполнено(Узел) ИЛИ Основной = Неопределено Тогда
		Возврат Кит.Примечание(Тексты.Текст("public.landing.start.unknown"));
	КонецЕсли;

	Если ПропискаНужна Тогда
		Возврат Кит.Холст(
			ОбразецНастройки(Основной, Узел),
			ОбразецУстановки(Основной, Узел, Тексты.Текст("public.landing.start.install")));
	КонецЕсли;

	Возврат ОбразецУстановки(Основной, Узел, Тексты.Текст("public.landing.start.install.default-hub"));

КонецФункции

Функция ОбразецНастройки(Знач Пул, Знач Узел)

	Возврат Кит.БлокКоманды(Команды.ОписаниеСервера(Пул, Узел))
		.Пояснение(Тексты.Текст("public.landing.start.config")).БезКопирования();

КонецФункции

Функция ОбразецУстановки(Знач Пул, Знач Узел, Знач Пояснение)
	Возврат Кит.БлокКоманды(Команды.Установка(Пул, ОбразецИмениПакета(), Узел)).Пояснение(Пояснение);
КонецФункции

// Место имени пакета в образце команды: это часть команды, а не подпись экрана.
Функция ОбразецИмениПакета()
	Возврат "<имя-пакета>";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Имя не «Число»: так называется встроенная функция платформы.
Функция Показатель(Знач Значение)
	Возврат Формат(?(ЗначениеЗаполнено(Значение), Значение, 0), "ЧН=0; ЧГ=0");
КонецФункции

Процедура ОтдатьHTML(Ответ, Знач Заголовок, Знач Содержимое, Знач Принципал, Знач КукиЗапроса)
	Ответ.УстановитьСостояниеОК();
	Ответ.УстановитьТипКонтента("html");
	// дороги на корне нет, и в рейке не горит ничего, но путь страница называет честно
	Ответ.ТелоТекст = Каркас.Страница(Заголовок, Содержимое,
		Каркас.КонтекстСтраницы(Принципал.Пользователь, КукиЗапроса, Ложь, Ложь, АдресЛендинга(),
			Принципал.Сессия));
КонецПроцедуры

Функция АдресЛендинга()
	Возврат "/";
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВитринаГлавной") _Витрина,
	&Пластилин(Значение = "ВитринаПакетов") _МоделиКарточек,
	&Пластилин(Значение = "КарточкаОбъекта") _КарточкиUI,
	&Пластилин(Значение = "ПлашкиПула") _ПлашкиПулов,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "Брендирование") _Бренд,
	&Пластилин(Значение = "ГвардОнбординга") _Гвард,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "КомандыOpm") _Команды,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "АдресаКабинета") _АдресаКабинета,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы,
	&Пластилин(Значение = "АдресаКаталога") _Каталог,
	&Пластилин(Значение = "ДатаЧеловеку") _Даты = Неопределено)

	Витрина = _Витрина;
	МоделиКарточек = _МоделиКарточек;
	КарточкиUI = _КарточкиUI;
	ПлашкиПулов = _ПлашкиПулов;
	Кит = _Кит;
	Каркас = _Каркас;
	Тексты = _Тексты;
	Бренд = _Бренд;
	Гвард = _Гвард;
	Перехватчик = _Перехватчик;
	Команды = _Команды;
	СервисПулов = _СервисПулов;
	АдресаКабинета = _АдресаКабинета;
	Даты = ?(_Даты = Неопределено, Новый ДатаЧеловеку(), _Даты);
	Страницы = _Страницы;
	Каталог = _Каталог;

КонецПроцедуры
