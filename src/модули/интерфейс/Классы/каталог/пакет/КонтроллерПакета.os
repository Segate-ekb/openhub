// Страница пакета /pools/{pool}/packages/{name}, разложенная на вкладки, каждая своим URL
// (описание, версии, зависимости).

#Использовать oscript-md

Перем СервисПакетов;
Перем СервисВерсий;
Перем РезолверСпецификации; // РезолверСпецификации (реестр) — версия установки без спецификации
Перем Провенанс;          // СервисПроисхождения (реестр)
Перем СлужбаREADME;       // СлужбаREADME (описания)
Перем Команды;            // КомандыOpm
Перем Подсказка;          // ПодсказкаУстановки
Перем Скачивание;         // КнопкаСкачивания — кнопки-значки «взять .ospx»
Перем Кит;                // Кит (кит) — фабрика элементов экрана
Перем Каркас;             // КаркасСтраницы (кит) — корень страницы
Перем Тексты;             // ТекстыИнтерфейса (кит)
Перем Витрина;            // ВитринаПакетов
Перем ЗначкиВерсии;
Перем ВкладкаВерсий;
Перем ВкладкаЗависимостей;
Перем СлужбаКабинета;     // СлужбаКабинета (кабинет)
Перем СлужбаСтатистики;   // СлужбаСтатистикиСкачиваний (статистика)
Перем Гвард;              // ГвардОнбординга
Перем Перехватчик;        // ПерехватчикАутентификации (вход)
Перем ЧтениеПула;         // ГвардДоступаКПулу (права)
Перем Кэш;                // ЗаголовкиКэша (основа)
Перем АдресаКаталога;     // АдресаКаталога — дорога, под которой живёт пакет
Перем Страницы;           // АдресаСтраниц (реестр) — адреса страницы пакета и его настроек
Перем КарточкаСсылки;     // КарточкаСсылкиПакета — свойства Open Graph страницы
Перем БезВерсий;          // ПакетБезВерсий — описание резерва: версий нет, как опубликовать первую
Перем СменаТемы;          // АдресСменыТемы — смена темы возвращает на эту страницу, а не на дорогу меню

#Область ТочкиМаршрута

// Отдаёт вкладку «Описание» — README пакета. Названная в адресе версия делает страницу
// страницей версии: показ тот же, а карточка ссылки — о ней.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  pool             - Строка       - имя пула из пути.
//  name             - Строка       - имя пакета из пути.
//  ЗаголовкиЗапроса - Соответствие - для определения принципала.
//  КукиЗапроса      - Куки         - сессия и оформление читателя.
//  version          - Строка       - (необязательный, по умолчанию "") номер версии;
//                     неизвестная версия оставляет карточку пакета.
//  ПолныйПутьЗапроса - Строка      - (необязательный, по умолчанию "") адрес страницы
//                     с параметрами: на него возвращает смена темы.
//
&ТочкаМаршрута("pools/{pool}/packages/{name}")
Процедура Показать(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, version = "",
	ПолныйПутьЗапроса = "") Экспорт
	ОтдатьВкладку(Ответ, pool, name, "описание", ЗаголовкиЗапроса, КукиЗапроса, Ложь, version,
		ПолныйПутьЗапроса);
КонецПроцедуры

// Отдаёт вкладку «Версии». По умолчанию версии сгруппированы по тегам; представление
// переключается параметром адреса, а не кукой, чтобы ссылку можно было отправить.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  pool             - Строка       - имя пула из пути.
//  name             - Строка       - имя пакета из пути.
//  ЗаголовкиЗапроса - Соответствие - для определения принципала.
//  КукиЗапроса      - Куки         - сессия и оформление читателя.
//  flat             - Строка       - (необязательный, по умолчанию "") непустое
//                     значение включает плоский список версий.
//  ПолныйПутьЗапроса - Строка      - (необязательный, по умолчанию "") адрес страницы
//                     с параметрами: на него возвращает смена темы.
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/versions")
Процедура Версии(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, flat = "",
	ПолныйПутьЗапроса = "") Экспорт
	ОтдатьВкладку(Ответ, pool, name, "версии", ЗаголовкиЗапроса, КукиЗапроса, ЗначениеЗаполнено(flat),
		"", ПолныйПутьЗапроса);
КонецПроцедуры

// Отдаёт вкладку «Зависимости» — связи в обе стороны.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  pool             - Строка       - имя пула из пути.
//  name             - Строка       - имя пакета из пути.
//  ЗаголовкиЗапроса - Соответствие - для определения принципала.
//  КукиЗапроса      - Куки         - сессия и оформление читателя.
//  ПолныйПутьЗапроса - Строка      - (необязательный, по умолчанию "") адрес страницы
//                     с параметрами: на него возвращает смена темы.
//
&ТочкаМаршрута("pools/{pool}/packages/{name}/deps")
Процедура Зависимости(Ответ, pool, name, ЗаголовкиЗапроса, КукиЗапроса, ПолныйПутьЗапроса = "") Экспорт
	ОтдатьВкладку(Ответ, pool, name, "зависимости", ЗаголовкиЗапроса, КукиЗапроса, Ложь, "",
		ПолныйПутьЗапроса);
КонецПроцедуры

#КонецОбласти

#Область СборкаСтраницы

Процедура ОтдатьВкладку(Ответ, Знач pool, Знач name, Знач Вкладка, Знач ЗаголовкиЗапроса,
	Знач КукиЗапроса, Знач Плоско = Ложь, Знач НомерВерсии = "", Знач АдресСтраницы = "")

	Если НЕ Гвард.Проверить(Ответ).Разрешено Тогда
		Возврат;
	КонецЕсли;

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);

	// приватный пул ⇒ приватны все его пакеты; нечитаемый и несуществующий дают один 404
	Пул = ЧтениеПула.ЧитаемыйПул(Принципал.Пользователь, pool, Принципал);
	Если Пул = Неопределено Тогда
		ОтдатьНеНайдено(Ответ, Тексты.Шаблон("public.pool.notfound", pool),
			Принципал, КукиЗапроса, АдресСтраницы);
		Возврат;
	КонецЕсли;

	Пакет = СервисПакетов.ПакетДляЧтения(Пул.Идентификатор, name);
	Если Пакет = Неопределено Тогда
		ОтдатьНеНайдено(Ответ, Тексты.Шаблон("public.package.notfound", name, Пул.Имя),
			Принципал, КукиЗапроса, АдресСтраницы);
		Возврат;
	КонецЕсли;

	Контекст = КонтекстПакета(Пакет);

	// узел считается один раз на страницу: команд на вкладке версий столько же, сколько строк
	Узел = Команды.Узел(ЗаголовкиЗапроса);
	ЕстьВерсии = Контекст.Версии.Количество() > 0;

	Страница = Кит.Холст(
		Шапка(Пул, Пакет, Контекст, Принципал.Пользователь, Узел),
		// памятка объясняет ЛЮБУЮ кнопку скачивания страницы; второй способ установки стоит
		// до вкладок свёрнутым: он отвечает на вопрос страницы, а не вкладки, и описание пакета
		// остаётся на первом экране; у пакета без версий ни того, ни другого нет
		Подсказка.ПамяткаПроСкачанныйФайл().Когда(ЕстьВерсии),
		Подсказка.СпособЧерезКонфиг(Пул, Пакет.Имя, Узел).Когда(ЕстьВерсии),
		ПолосаВкладок(Пул, Пакет, Вкладка, Контекст.Версии.Количество()),
		ТелоВкладки(Вкладка, Пул, Пакет, Контекст, Плоско, Принципал, Узел));

	// адрес страницы версии не называет, поэтому её ответ меняется с публикациями: он
	// переиспользуется коротким сроком, а приватный пул в общий кэш не попадает вовсе
	Кэш.ОтдатьСтраницу(Ответ, Каркас.Страница(Пакет.Имя, Страница,
		КонтекстСтраницы(Принципал, КукиЗапроса, АдресСтраницы), Неопределено,
		КарточкаСсылки.Свойства(Пул, Пакет, Контекст.ПоУмолчанию, НазваннаяВерсия(Контекст.Версии, НомерВерсии))),
		ГодитсяОбщемуКэшу(Пул, Принципал.Пользователь), ЗаголовкиЗапроса);

КонецПроцедуры

// Версии, провенанс и версия по умолчанию пакета — по одному разу на запрос.
Функция КонтекстПакета(Знач Пакет)

	// имя «Версии» занято глобальным именем библиотеки semver: локальная переменная его не перебьёт
	СписокВерсий = СервисВерсий.ВерсииПакетаДляЧтения(Пакет.Идентификатор);
	Происхождение = Провенанс.ПровенансПакетаДляЧтения(Пакет.Идентификатор);

	// страница говорит о версии, которую человек получит по `opm install <имя>`: отзыв
	// версии и смена канала по умолчанию меняют её без всякой публикации
	ПоУмолчанию = РезолверСпецификации.ВерсияПоУмолчанию(Пакет, СписокВерсий, Происхождение);

	Возврат Новый Структура("Версии, Происхождение, ПоУмолчанию",
		СписокВерсий, Происхождение, ПоУмолчанию);

КонецФункции

// Версия из адреса — только среди версий, которые страница и так показывает.
Функция НазваннаяВерсия(Знач СписокВерсий, Знач НомерВерсии)

	Номер = СокрЛП(Строка(НомерВерсии));
	Если НЕ ЗначениеЗаполнено(Номер) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Версия Из СписокВерсий Цикл
		Если Версия.Версия = Номер Тогда
			Возврат Версия;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// В общий кэш годится только страница, одинаковая для ВСЕХ: публичный пул И зритель-гость.
Функция ГодитсяОбщемуКэшу(Знач Пул, Знач Пользователь)
	Возврат НЕ Команды.ТребуетКлюча(Пул) И Пользователь = Неопределено;
КонецФункции

// Шапка говорит о версии, которую человек получит по opm install без версии: ключ доверенного
// конвейера и команда установки — о ней; у пакета без версий ставить нечего, и команды нет.
// Скачать пакет вправе всякий, кто видит страницу, а настраивать — только управляющий им.
Функция Шапка(Знач Пул, Знач Пакет, Знач Контекст, Знач Пользователь, Знач Узел)

	Модель = Витрина.ШапкаПакета(Пакет, АвторПакета(Пакет, Контекст.ПоУмолчанию),
		СкачиванийПакета(Пакет), Контекст.Происхождение.ЕстьСобственныеВерсии());
	Модель.Вставить("Признаки", ЗначкиВерсии.ПризнакиШапки(
		Контекст.Происхождение.ЭтоДоверенныйКонвейер(Контекст.ПоУмолчанию)));
	Модель.Вставить("Команда", ?(Контекст.Версии.Количество() = 0, Неопределено,
		Подсказка.КомандаШапки(Пул, Пакет.Имя, Узел)));

	Возврат Кит.ШапкаОбъекта(Модель,
		Скачивание.ВерсииПоУмолчанию(Пул, Пакет.Имя, Контекст.ПоУмолчанию),
		КнопкаНастроек(Пул, Пакет, Пользователь));

КонецФункции

// Право берётся из модели прав, а не из авторства: кнопку видит и мейнтейнер с грантом.
Функция КнопкаНастроек(Знач Пул, Знач Пакет, Знач Пользователь)

	Если НЕ СлужбаКабинета.МожетУправлять(Пользователь, Пул, Пакет) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Кнопка(Тексты.Текст("public.package.settings")).Вторичная().Иконка("шестерёнка")
		.Адрес(Страницы.НастроекПакета(Пул.Имя, Пакет.Имя));

КонецФункции

Функция ПолосаВкладок(Знач Пул, Знач Пакет, Знач Текущая, Знач ЧислоВерсий)

	Возврат Кит.Табы(
		Кит.Вкладка(Тексты.Текст("public.package.tab.readme"), АдресВкладки(Пул, Пакет, "описание"))
			.Активна(Текущая = "описание").Иконка("инфо"),
		Кит.Вкладка(Тексты.Текст("public.package.tab.versions"), АдресВкладки(Пул, Пакет, "версии"))
			.Активна(Текущая = "версии").Иконка("тег").Счётчик(Формат(ЧислоВерсий, "ЧН=0; ЧГ=0")),
		Кит.Вкладка(Тексты.Текст("public.package.tab.deps"), АдресВкладки(Пул, Пакет, "зависимости"))
			.Активна(Текущая = "зависимости").Иконка("ссылка"))
		.Заголовок(Тексты.Текст("public.package.tabs.title"));

КонецФункции

// Адрес вкладки страницы пакета.
//
// Параметры:
//  Пул     - Пул    - пул пакета.
//  Пакет   - Пакет  - пакет.
//  Вкладка - Строка - "описание" | "версии" | "зависимости".
//
// Возвращаемое значение:
//  Строка - относительный URL.
//
Функция АдресВкладки(Знач Пул, Знач Пакет, Знач Вкладка) Экспорт

	Основа = Страницы.Пакета(Пул.Имя, Пакет.Имя);

	Если Вкладка = "версии" Тогда
		Возврат Основа + "/versions";
	ИначеЕсли Вкладка = "зависимости" Тогда
		Возврат Основа + "/deps";
	КонецЕсли;

	Возврат Основа;

КонецФункции

Функция ТелоВкладки(Знач Вкладка, Знач Пул, Знач Пакет, Знач Контекст,
	Знач Плоско, Знач Принципал, Знач Узел)

	Если Вкладка = "версии" Тогда
		Возврат ВкладкаВерсий.Вкладка(Пул, Пакет, Контекст.Версии, Плоско, Узел,
			АдресВкладки(Пул, Пакет, "версии"), Контекст.Происхождение);
	ИначеЕсли Вкладка = "зависимости" Тогда
		Возврат ВкладкаЗависимостей.Вкладка(Пул, Пакет, Контекст.ПоУмолчанию, Принципал);
	ИначеЕсли Контекст.Версии.Количество() = 0 Тогда
		Возврат БезВерсий.Вкладка(Пул, Пакет, Принципал.Пользователь, Узел);
	КонецЕсли;

	Возврат ВкладкаОписания(Пул, Пакет, Контекст.ПоУмолчанию);

КонецФункции

#КонецОбласти

#Область ВкладкаОписания

Функция ВкладкаОписания(Знач Пул, Знач Пакет, Знач ВерсияПоУмолчанию)

	// «У этой версии нет README» назвало бы версию, которой нет, поэтому у случая свои слова
	Если ВерсияПоУмолчанию = Неопределено Тогда
		Возврат Кит.ПустоеСостояние(Тексты.Текст("public.package.default.empty.lead"))
			.Заголовок(Тексты.Текст("public.package.default.empty.title")).Иконка("инфо");
	КонецЕсли;

	Представление = СлужбаREADME.ПредставлениеREADME(Пул, Пакет, ВерсияПоУмолчанию);

	Если НЕ Представление.ЕстьREADME Тогда
		Возврат Кит.ПустоеСостояние(Тексты.Текст("public.package.readme.empty.lead"))
			.Заголовок(Тексты.Текст("public.package.readme.empty.title")).Иконка("инфо");
	КонецЕсли;

	Возврат КарточкаОписания(Представление);

КонецФункции

// Подсветка нужна только README с блоками кода на языке: без них страница её не грузит.
Функция КарточкаОписания(Знач Представление)

	Возврат Кит.Карточка(Тексты.Текст("public.package.readme.title"),
		ЧужойДокумент(Представление.HTML),
		ИсточникОписания(Представление.Источник),
		ПодсветкаКода().Когда(Представление.ЕстьКодСЯзыком)).Иконка("инфо");

КонецФункции

// README не из пакета называет, откуда он взят, — ссылкой на сам файл на GitHub.
Функция ИсточникОписания(Знач Источник)

	Если Источник = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Откуда = ?(Источник.Вид = "tag", Тексты.Шаблон("public.package.readme.source.tag", Источник.Реф),
		Тексты.Текст("public.package.readme.source.branch"));

	Возврат Кит.Примечание(Кит.Шаблон(Тексты.Текст("public.package.readme.source"),
		Кит.Ссылка(Источник.Ссылка, Кит.Текст(Откуда))));

КонецФункции

// Блоки кода раскрашивает в браузере встроенный модуль oscript-md: код собран библиотекой, а не
// из README.
Функция ПодсветкаКода()
	Возврат Кит.Скрипт().Модуль(MarkdownПодсветка.ТегСкрипта());
КонецФункции

// README — чужой документ: деревом он не собирается никогда; прозу кит санитизирует сам, уже
// чистый HTML описаний (ссылки в репозиторий пакета) печатается как есть.
Функция ЧужойДокумент(Знач Html)
	Возврат Кит.Проза(Html);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Витрина пакета не должна падать из-за сбоя stats — при ошибке показываем 0.
Функция СкачиванийПакета(Знач Пакет)
	Попытка
		Возврат СлужбаСтатистики.СкачиванийПакета(Пакет.Идентификатор);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция АвторПакета(Знач Пакет, Знач ВерсияПоУмолчанию)
	Если ВерсияПоУмолчанию <> Неопределено И ЗначениеЗаполнено(ВерсияПоУмолчанию.АвторМанифеста) Тогда
		Возврат ВерсияПоУмолчанию.АвторМанифеста;
	КонецЕсли;
	Возврат "";
КонецФункции

// Сообщение приходит СЫРЫМ, экранирует кит.
Процедура ОтдатьНеНайдено(Ответ, Знач Сообщение, Знач Принципал, Знач КукиЗапроса,
	Знач АдресСтраницы)
	Ответ.УстановитьСостояниеНеНайдено();
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Тексты.Текст("settings.reply.notfound.title"),
		Кит.Холст(
			Кит.СтраницаОшибки(Новый Структура("Код, Сообщение", 404, Сообщение)),
			Кит.Ссылка(АдресаКаталога.Каталог(), Тексты.Текст("public.catalog.back"))),
		КонтекстСтраницы(Принципал, КукиЗапроса, АдресСтраницы));
КонецПроцедуры

// В меню горит дорога каталога, а смена темы возвращает на саму страницу пакета.
Функция КонтекстСтраницы(Знач Принципал, Знач КукиЗапроса, Знач АдресСтраницы)

	Контекст = Каркас.КонтекстСтраницы(Принципал.Пользователь, КукиЗапроса, Ложь, Ложь, ДорогаЭкрана(),
		Принципал.Сессия);
	СменаТемы.ЗапомнитьАдресСтраницы(Контекст, АдресСтраницы);
	Возврат Контекст;

КонецФункции

// Своей дороги в меню у страницы пакета нет: пакет живёт ПОД КАТАЛОГОМ, и в меню горит каталог.
Функция ДорогаЭкрана()
	Возврат АдресаКаталога.Каталог();
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "СервисВерсий") _СервисВерсий,
	&Пластилин(Значение = "РезолверСпецификации") _РезолверСпецификации,
	&Пластилин(Значение = "СервисПроисхождения") _Провенанс,
	&Пластилин(Значение = "СлужбаREADME") _СлужбаREADME,
	&Пластилин(Значение = "КомандыOpm") _Команды,
	&Пластилин(Значение = "ПодсказкаУстановки") _Подсказка,
	&Пластилин(Значение = "КнопкаСкачивания") _Скачивание,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ВитринаПакетов") _Витрина,
	&Пластилин(Значение = "ЗначкиВерсии") _ЗначкиВерсии,
	&Пластилин(Значение = "ВкладкаВерсий") _ВкладкаВерсий,
	&Пластилин(Значение = "ВкладкаЗависимостей") _ВкладкаЗависимостей,
	&Пластилин(Значение = "СлужбаКабинета") _СлужбаКабинета,
	&Пластилин(Значение = "СлужбаСтатистикиСкачиваний") _СлужбаСтатистики,
	&Пластилин(Значение = "ГвардОнбординга") _Гвард,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "ГвардДоступаКПулу") _ЧтениеПула,
	&Пластилин(Значение = "ЗаголовкиКэша") _Кэш,
	&Пластилин(Значение = "АдресаКаталога") _АдресаКаталога,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы,
	&Пластилин(Значение = "КарточкаСсылкиПакета") _КарточкаСсылки,
	&Пластилин(Значение = "ПакетБезВерсий") _БезВерсий,
	&Пластилин(Значение = "АдресСменыТемы") _СменаТемы = Неопределено)

	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;
	РезолверСпецификации = _РезолверСпецификации;
	Провенанс = _Провенанс;
	СлужбаREADME = _СлужбаREADME;
	Команды = _Команды;
	Подсказка = _Подсказка;
	Скачивание = _Скачивание;
	Кит = _Кит;
	Каркас = _Каркас;
	Тексты = _Тексты;
	Витрина = _Витрина;
	ЗначкиВерсии = _ЗначкиВерсии;
	ВкладкаВерсий = _ВкладкаВерсий;
	ВкладкаЗависимостей = _ВкладкаЗависимостей;
	СлужбаКабинета = _СлужбаКабинета;
	СлужбаСтатистики = _СлужбаСтатистики;
	Гвард = _Гвард;
	Перехватчик = _Перехватчик;
	ЧтениеПула = _ЧтениеПула;
	Кэш = _Кэш;
	АдресаКаталога = _АдресаКаталога;
	Страницы = _Страницы;
	КарточкаСсылки = _КарточкаСсылки;
	БезВерсий = _БезВерсий;
	СменаТемы = ?(_СменаТемы = Неопределено, Новый АдресСменыТемы(), _СменаТемы);

КонецПроцедуры
