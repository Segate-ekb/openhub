	&Пластилин(Значение = "СлужбаREADME") _СлужбаREADME,
	&Пластилин(Значение = "КомандыOpm") _Команды,
	&Пластилин(Значение = "ПодсказкаУстановки") _Подсказка,
	&Пластилин(Значение = "КнопкаСкачивания") _Скачивание,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "НаборКомпонентов") _НаборUI,
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ВитринаПакетов") _Витрина,
	&Пластилин(Значение = "ЗначкиВерсии") _ЗначкиВерсии,
	&Пластилин(Значение = "ВкладкаВерсий") _ВкладкаВерсий,
	&Пластилин(Значение = "ВкладкаЗависимостей") _ВкладкаЗависимостей,
	&Пластилин(Значение = "СлужбаКабинета") _СлужбаКабинета,
	&Пластилин(Значение = "СлужбаСтатистикиСкачиваний") _СлужбаСтатистики,
	&Пластилин(Значение = "ГвардОнбординга") _Гвард,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "ГвардДоступаКПулу") _ЧтениеПула,
	&Пластилин(Значение = "ЗаголовкиКэша") _Кэш,
	&Пластилин(Значение = "АдресаКаталога") _АдресаКаталога,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы,
	&Пластилин(Значение = "КарточкаСсылкиПакета") _КарточкаСсылки,
	&Пластилин(Значение = "ПакетБезВерсий") _БезВерсий)

	СервисПакетов = _СервисПакетов;
	СервисВерсий = _СервисВерсий;
	РезолверСпецификации = _РезолверСпецификации;
	Провенанс = _Провенанс;
	СлужбаREADME = _СлужбаREADME;
	Команды = _Команды;
	Подсказка = _Подсказка;
	Скачивание = _Скачивание;
	Кит = _Кит;
	Каркас = _Каркас;
	НаборUI = _НаборUI;
	Экран = _Экран;
	Витрина = _Витрина;
	ЗначкиВерсии = _ЗначкиВерсии;
	ВкладкаВерсий = _ВкладкаВерсий;
	ВкладкаЗависимостей = _ВкладкаЗависимостей;
	СлужбаКабинета = _СлужбаКабинета;
	СлужбаСтатистики = _СлужбаСтатистики;
	Гвард = _Гвард;
	Перехватчик = _Перехватчик;
	ЧтениеПула = _ЧтениеПула;
	Кэш = _Кэш;
	АдресаКаталога = _АдресаКаталога;
	Страницы = _Страницы;
	КарточкаСсылки = _КарточкаСсылки;
	БезВерсий = _БезВерсий;

КонецПроцедуры
