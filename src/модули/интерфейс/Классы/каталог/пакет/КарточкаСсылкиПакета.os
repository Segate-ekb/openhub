// Карточка, которую мессенджер строит по ссылке на страницу пакета: свойства Open Graph.
// Картинка — социальная карточка репозитория на GitHub, иначе растровый знак хаба.

Перем Права;        // СервисПрав (права) — публичен ли пул
Перем АдресХаба;    // АдресИнстанса (настройки) — внешний адрес хаба
Перем Страницы;     // АдресаСтраниц (реестр) — путь страницы пакета
Перем Активы;       // АдресаСтатики — адрес растрового знака поставки
Перем Бренд;        // Брендирование — название хаба и загруженная иконка
Перем Репозиторий;  // РепозиторийGitHub (основа)

#Область ПубличныйИнтерфейс

// Свойства карточки ссылки на страницу пакета либо на страницу его версии.
//
// Параметры:
//  Пул - Пул - пул пакета.
//  Пакет - Пакет - пакет.
//  ВерсияПоУмолчанию - ВерсияПакета, Неопределено - версия, о которой говорит страница пакета.
//  НазваннаяВерсия - ВерсияПакета, Неопределено - версия, названная в адресе страницы
//                    (необязательный, по умолчанию Неопределено — карточка пакета).
//
// Возвращаемое значение:
//  Массив из Структура - Свойство (og:…) и Содержание. Пустой у приватного пула: его страницу
//                        краулер не получит. Без внешнего адреса хаба нет og:url и знака хаба
//                        картинкой — абсолютный адрес не из чего собрать.
//
Функция Свойства(Знач Пул, Знач Пакет, Знач ВерсияПоУмолчанию, Знач НазваннаяВерсия = Неопределено) Экспорт

	Карточка = Новый Массив();
	Если НЕ Права.ПулПубличный(Пул) Тогда
		Возврат Карточка;
	КонецЕсли;

	База = АдресХаба.Базовый();
	ВерсияКартинки = ?(НазваннаяВерсия = Неопределено, ВерсияПоУмолчанию, НазваннаяВерсия);

	Карточка.Добавить(Свойство("og:site_name", Бренд.Знак()));
	Карточка.Добавить(Свойство("og:title", Заглавие(Пакет, НазваннаяВерсия)));
	Карточка.Добавить(Свойство("og:description", Пакет.Описание));
	Карточка.Добавить(Свойство("og:url", Абсолютный(База, АдресСтраницы(Пул, Пакет, НазваннаяВерсия))));
	Карточка.Добавить(Свойство("og:image", Картинка(База, Пакет, ВерсияКартинки)));

	Возврат Карточка;

КонецФункции

#КонецОбласти

#Область СтраницаВерсии

Функция Заглавие(Знач Пакет, Знач НазваннаяВерсия)
	Возврат ?(НазваннаяВерсия = Неопределено, Пакет.Имя, Пакет.Имя + " " + НазваннаяВерсия.Версия);
КонецФункции

// У страницы версии адрес свой: мессенджер запоминает карточку по адресу, и новая версия
// получает новую карточку.
Функция АдресСтраницы(Знач Пул, Знач Пакет, Знач НазваннаяВерсия)
	Если НазваннаяВерсия = Неопределено Тогда
		Возврат Страницы.Пакета(Пул.Имя, Пакет.Имя);
	КонецЕсли;
	Возврат Страницы.Версии(Пул.Имя, Пакет.Имя, НазваннаяВерсия.Версия);
КонецФункции

#КонецОбласти

#Область Картинка

Функция Картинка(Знач База, Знач Пакет, Знач ВерсияКартинки)

	КарточкаGitHub = КарточкаРепозиторияGitHub(Пакет.АдресРепозитория, КлючКэша(ВерсияКартинки));
	Если ЗначениеЗаполнено(КарточкаGitHub) Тогда
		Возврат КарточкаGitHub;
	КонецЕсли;
	Возврат Абсолютный(База, РастровыйЗнак());

КонецФункции

// Социальная карточка репозитория — PNG 1200×600, который GitHub рисует сам. Первый сегмент
// адреса — ключ его кэша: с новой версией картинка перерисовывается.
Функция КарточкаРепозиторияGitHub(Знач АдресРепозитория, Знач Ключ)

	Координаты = Репозиторий.Координаты(АдресРепозитория);
	Если Координаты = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("https://opengraph.githubassets.com/%1/%2/%3", Ключ, Координаты.Владелец,
		Координаты.Имя);

КонецФункции

// Те же символы годятся и ключу кэша картинки: ключ — сегмент её адреса.
Функция СимволыИмениGitHub()
	Возврат "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.";
КонецФункции

Функция КлючКэша(Знач ВерсияКарточки)

	Если ВерсияКарточки = Неопределено Тогда
		Возврат "0";
	КонецЕсли;
	Номер = СокрЛП(Строка(ВерсияКарточки.Версия));
	Ключ = "";
	Для Позиция = 1 По СтрДлина(Номер) Цикл
		Символ = Сред(Номер, Позиция, 1);
		Ключ = Ключ + ?(СтрНайти(СимволыИмениGitHub(), Символ) > 0, Символ, "-");
	КонецЦикла;
	Возврат ?(ЗначениеЗаполнено(Ключ), Ключ, "0");

КонецФункции

// Карточку картинкой SVG не показывают: загруженная иконка годится, только если она растровая,
// а без загруженной в ходу растровый знак поставки.
Функция РастровыйЗнак()

	Своя = Бренд.АдресЗагруженнойИконки();
	Если НЕ ЗначениеЗаполнено(Своя) Тогда
		Возврат Активы.АдресИконкиДомашнегоЭкрана();
	КонецЕсли;
	Тип = НРег(Бренд.ТипЗагруженнойИконки());
	Возврат ?(Тип = "image/png" ИЛИ Тип = "image/jpeg", Своя, "");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Без внешнего адреса абсолютного нет: адрес из заголовка Host подделывает любой запрос,
// а страница публичного пула уходит в общий кэш.
Функция Абсолютный(Знач База, Знач Путь)
	Возврат ?(ЗначениеЗаполнено(База) И ЗначениеЗаполнено(Путь), База + Путь, "");
КонецФункции

Функция Свойство(Знач Имя, Знач Содержание)
	Возврат Новый Структура("Свойство, Содержание", Имя, СокрЛП(Строка(Содержание)));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПрав") _Права,
	&Пластилин(Значение = "АдресИнстанса") _АдресХаба,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы,
	&Пластилин(Значение = "АдресаСтатики") _Активы,
	&Пластилин(Значение = "Брендирование") _Бренд,
	&Пластилин(Значение = "РепозиторийGitHub") _Репозиторий)

	Права = _Права;
	АдресХаба = _АдресХаба;
	Страницы = _Страницы;
	Активы = _Активы;
	Бренд = _Бренд;
	Репозиторий = _Репозиторий;

КонецПроцедуры
