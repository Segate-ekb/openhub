// Вкладка «Описание» пакета без единой версии — резерва имени: читателю говорит, что версий
// нет, управляющему пакетом — как опубликовать первую.

Перем Кит;             // Кит (кит) — фабрика элементов экрана
Перем Тексты;          // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Команды;         // КомандыOpm — команда публикации в пул
Перем СлужбаКабинета;  // СлужбаКабинета (кабинет) — управляет ли смотрящий пакетом
Перем Доверие;         // СервисДоверияCI (публикация) — вправе ли он настраивать конвейеры
Перем ДомПакета;       // ДомПакета — разделы настроек пакета

#Область ПубличныйИнтерфейс

// Разметка вкладки.
//
// Параметры:
//  Пул - Пул - пул пакета.
//  Пакет - Пакет - пакет без версий.
//  Пользователь - Пользователь, Неопределено - смотрящий.
//  Узел - Строка - узел хаба (КомандыOpm.Узел()).
//
// Возвращаемое значение:
//  Строка - разметка.
//
Функция Разметка(Знач Пул, Знач Пакет, Знач Пользователь, Знач Узел) Экспорт

	Вкладка = Кит.Холст();
	Вкладка.Добавить(ВерсийНет());
	Если СлужбаКабинета.МожетУправлять(Пользователь, Пул, Пакет) Тогда
		Вкладка.Добавить(ПерваяПубликация(Пул, Пакет, Пользователь, Узел));
	КонецЕсли;
	Возврат Вкладка.Рендер();

КонецФункции

#КонецОбласти

#Область Сборка

Функция ВерсийНет()

	Возврат Кит.ПустоеСостояние(Новый Структура("Заголовок, Пояснение, Иконка",
		Тексты.Текст("public.package.empty.title"), Тексты.Текст("public.package.empty.lead"), "куб"));

КонецФункции

// Два пути первой версии: opm push и доверенный конвейер; права на пакет — рядом.
Функция ПерваяПубликация(Знач Пул, Знач Пакет, Знач Пользователь, Знач Узел)

	Путь = Кит.Карточка(Новый Структура("Заголовок, Иконка, Действия",
		Тексты.Текст("public.package.empty.publish.title"), "стрелка",
		ПереходыВНастройки(Пул, Пакет, Пользователь)));
	Путь.Добавить(Кит.Примечание(Тексты.Текст("public.package.empty.publish.push")));
	Путь.Добавить(Кит.БлокКоманды(Команды.Публикация(Пул, Узел)));
	Путь.Добавить(Кит.Примечание(Тексты.Текст("public.package.empty.publish.note")));
	Возврат Путь;

КонецФункции

Функция ПереходыВНастройки(Знач Пул, Знач Пакет, Знач Пользователь)

	Переходы = "";
	Если Доверие.МожетНастраивать(Пользователь, Пакет) Тогда
		Переходы = Переходы + Переход(Тексты.Текст("public.package.empty.publish.ci"),
			ДомПакета.АдресРаздела(Пул.Имя, Пакет.Имя, "ci"), "ключ", "основная");
	КонецЕсли;
	Возврат Переходы + Переход(Тексты.Текст("public.package.empty.publish.access"),
		ДомПакета.АдресРаздела(Пул.Имя, Пакет.Имя, "access"), "замок", "вторичная");

КонецФункции

Функция Переход(Знач Подпись, Знач Адрес, Знач Иконка, Знач Вариант)

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Иконка",
		Подпись, Адрес, Вариант, Иконка)).Рендер();

КонецФункции

#КонецОбласти

&Прозвище("ПакетБезВерсий")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "КомандыOpm") _Команды,
	&Пластилин(Значение = "СлужбаКабинета") _СлужбаКабинета,
	&Пластилин(Значение = "СервисДоверияCI") _Доверие,
	&Пластилин(Значение = "ДомПакета") _ДомПакета) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	Команды = _Команды;
	СлужбаКабинета = _СлужбаКабинета;
	Доверие = _Доверие;
	ДомПакета = _ДомПакета;

КонецПроцедуры
