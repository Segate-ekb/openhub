// Вкладка «Описание» пакета без единой версии — резерва имени: читателю говорит, что версий
// нет, управляющему пакетом — как опубликовать первую.

Перем Кит;             // Кит (кит) — фабрика элементов экрана
Перем Тексты;          // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Команды;         // КомандыOpm — команда публикации в пул
Перем СлужбаКабинета;  // СлужбаКабинета (кабинет) — управляет ли смотрящий пакетом
Перем Доверие;         // СервисДоверияCI (публикация) — вправе ли он настраивать конвейеры
Перем ДомПакета;       // ДомПакета — разделы настроек пакета

#Область ПубличныйИнтерфейс

// Вкладка узлом.
//
// Параметры:
//  Пул - Пул - пул пакета.
//  Пакет - Пакет - пакет без версий.
//  Пользователь - Пользователь, Неопределено - смотрящий.
//  Узел - Строка - узел хаба (КомандыOpm.Узел()).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Вкладка(Знач Пул, Знач Пакет, Знач Пользователь, Знач Узел) Экспорт

	// путь первой публикации спрашивает права на настройки — только у того, кто управляет пакетом
	Если НЕ СлужбаКабинета.МожетУправлять(Пользователь, Пул, Пакет) Тогда
		Возврат ВерсийНет();
	КонецЕсли;

	Возврат Кит.Холст(ВерсийНет(), ПерваяПубликация(Пул, Пакет, Пользователь, Узел));

КонецФункции

#КонецОбласти

#Область Сборка

Функция ВерсийНет()

	Возврат Кит.ПустоеСостояние(Тексты.Текст("public.package.empty.lead"))
		.Заголовок(Тексты.Текст("public.package.empty.title")).Иконка("куб");

КонецФункции

// Путь первой публикации: команда отправки в пул и переходы в настройки, без которых её не принять.
Функция ПерваяПубликация(Знач Пул, Знач Пакет, Знач Пользователь, Знач Узел)

	Возврат Кит.Карточка(Тексты.Текст("public.package.empty.publish.title"),
			Кит.Примечание(Тексты.Текст("public.package.empty.publish.push")),
			Кит.БлокКоманды(Команды.Публикация(Пул, Узел)),
			Кит.Примечание(Тексты.Текст("public.package.empty.publish.note")))
		.Иконка("стрелка")
		.Действия(
			ПереходКДоверию(Пул, Пакет, Пользователь),
			Кит.Кнопка(Тексты.Текст("public.package.empty.publish.access")).Вторичная().Иконка("замок")
				.Адрес(ДомПакета.АдресРаздела(Пул.Имя, Пакет.Имя, "access")));

КонецФункции

Функция ПереходКДоверию(Знач Пул, Знач Пакет, Знач Пользователь)

	Если НЕ Доверие.МожетНастраивать(Пользователь, Пакет) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Кнопка(Тексты.Текст("public.package.empty.publish.ci")).Основная().Иконка("ключ")
		.Адрес(ДомПакета.АдресРаздела(Пул.Имя, Пакет.Имя, "ci"));

КонецФункции

#КонецОбласти

&Прозвище("ПакетБезВерсий")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "КомандыOpm") _Команды,
	&Пластилин(Значение = "СлужбаКабинета") _СлужбаКабинета,
	&Пластилин(Значение = "СервисДоверияCI") _Доверие,
	&Пластилин(Значение = "ДомПакета") _ДомПакета) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	Команды = _Команды;
	СлужбаКабинета = _СлужбаКабинета;
	Доверие = _Доверие;
	ДомПакета = _ДомПакета;

КонецПроцедуры
