// Подсказка установки на странице пакета: адресная команда для шапки, памятка про установку
// из скачанного файла и карточка записи в opm.cfg — там, где клиенту нужна прописка пула.

Перем Команды;    // КомандыOpm
Перем Тексты;     // ТекстыИнтерфейса
Перем Кит;        // Кит (кит) — фабрика элементов экрана

// Модель команды установки для шапки объекта.
//
// Параметры:
//  Пул       - Пул, Неопределено - пул пакета.
//  ИмяПакета - Строка - имя пакета.
//  Узел      - Строка - узел хаба (КомандыOpm.Узел()).
//
// Возвращаемое значение:
//  Структура - модель компонента «Блок команды».
//
Функция КомандаШапки(Знач Пул, Знач ИмяПакета, Знач Узел) Экспорт

	Возврат Новый Структура("Команда, Пояснение",
		Команды.Установка(Пул, ИмяПакета, Узел), ПояснениеКоманды(Пул));

КонецФункции

// Памятка рядом с кнопкой скачивания: чем поставить скачанный файл без сети.
//
// Возвращаемое значение:
//  ЭлементЭкрана - примечание.
//
Функция ПамяткаПроСкачанныйФайл() Экспорт

	Возврат Кит.Примечание(Кит.Шаблон(Тексты.Текст("public.package.download.offline"),
		Кит.Код(Команды.УстановкаИзФайла())));

КонецФункции

// Второй способ установки — тот, который понимает штатный клиент, — свёрнутой строкой над
// вкладками: команда в шапке пакета отвечает на вопрос страницы, а запись в opm.cfg нужна не
// каждому и не отодвигает описание пакета ниже первого экрана.
//
// Параметры:
//  Пул       - Пул, Неопределено - пул пакета.
//  ИмяПакета - Строка - имя пакета.
//  Узел      - Строка - узел хаба (КомандыOpm.Узел()).
//
// Возвращаемое значение:
//  ЭлементЭкрана - раскрывашка; пустой узел, если прописка пула клиенту не нужна.
//
Функция СпособЧерезКонфиг(Знач Пул, Знач ИмяПакета, Знач Узел) Экспорт

	Если НЕ Команды.ПропискаНужна(Пул) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Раскрывашка(
			Кит.Примечание(Тексты.Текст("public.package.install.lead")),
			ПропискаПулаВКонфиге(Пул, Узел),
			УстановкаИзПрописанногоПула(Пул, ИмяПакета),
			ОговоркаПроКлюч(Пул))
		.Шапка(Кит.Иконка("скачать"), Тексты.Текст("public.package.install.title"))
		.Вид("врезка");

КонецФункции

#Область Пояснения

// Адресной форме нужен клиент, который её понимает, короткой — хаб, который клиент знает.
Функция ПояснениеКоманды(Знач Пул)

	Если НЕ Команды.КороткаяФорма(Пул) Тогда
		Возврат Тексты.Текст("public.package.install.hint-address");
	КонецЕсли;

	Возврат ?(Команды.ПропискаНужна(Пул),
		Тексты.Текст("public.package.install.hint-short"),
		Тексты.Текст("public.package.install.hint-short.default-hub"));

КонецФункции

#КонецОбласти

#Область СоставКарточки

Функция ПропискаПулаВКонфиге(Знач Пул, Знач Узел)

	Возврат Кит.БлокКоманды(Команды.ОписаниеСервера(Пул, Узел))
		.Пояснение(Тексты.Текст("public.package.install.config")).БезКопирования();

КонецФункции

Функция УстановкаИзПрописанногоПула(Знач Пул, Знач ИмяПакета)

	Возврат Кит.БлокКоманды(Команды.УстановкаЧерезСервер(Пул, ИмяПакета))
		.Пояснение(Тексты.Текст("public.package.install.by-server"));

КонецФункции

// Оговорка стоит рядом с командой; у публичного пула её на экране нет вовсе.
Функция ОговоркаПроКлюч(Знач Пул)

	Если НЕ Команды.ТребуетКлюча(Пул) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Примечание(Тексты.Текст("public.package.install.private"));

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КомандыOpm") _Команды,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "Кит") _Кит)

	Команды = _Команды;
	Тексты = _Тексты;
	Кит = _Кит;

КонецПроцедуры
