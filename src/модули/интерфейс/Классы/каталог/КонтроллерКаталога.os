// Контроллер каталога — web-ui: единый каталог пакетов с поиском, пагинацией и двумя отборами.
// Отборы — обычные ссылки и поля GET-формы, поэтому каталог работает без JS.

Перем Каталог;       // КаталогПакетов
Перем Витрина;       // ВитринаПакетов
Перем КарточкиUI;    // КарточкаПакета
Перем Кит;           // Кит (oscript-ui) — фабрика элементов экрана
Перем Каркас;        // КаркасСтраницы (кит) — корень страницы
Перем НаборUI;       // НаборКомпонентов (кит)
Перем Перехватчик;   // ПерехватчикАутентификации (auth)
Перем Гвард;         // ГвардОнбординга
Перем Адреса;        // АдресаКаталога — каждое состояние отбора своим адресом

// Отдаёт каталог пакетов.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - для определения принципала (PAT или сессия).
//  КукиЗапроса      - Куки         - сессия и оформление читателя.
//  q                - Строка       - (необязательный, по умолчанию "") подстрока имени.
//  page             - Строка       - (необязательный, по умолчанию "") номер страницы.
//  pool             - Строка       - (необязательный, по умолчанию "") отбор по пулу.
//  mine             - Строка       - (необязательный, по умолчанию "") отбор
//                     «в моём управлении», значение "1".
//
&ТочкаМаршрута("")
Процедура Список(Ответ, ЗаголовкиЗапроса, КукиЗапроса, q = "", page = "", pool = "", mine = "") Экспорт
	ПоказатьКаталог(Ответ, ЗаголовкиЗапроса, КукиЗапроса, q, page, pool, mine);
КонецПроцедуры

// Тот же каталог по адресу /packages/search — совместимость URL текущего хаба.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - для определения принципала.
//  КукиЗапроса      - Куки         - сессия и оформление читателя.
//  q, page, pool, mine - Строка - (необязательные, по умолчанию "") см. Список.
//
&ТочкаМаршрута("search")
Процедура Поиск(Ответ, ЗаголовкиЗапроса, КукиЗапроса, q = "", page = "", pool = "", mine = "") Экспорт
	ПоказатьКаталог(Ответ, ЗаголовкиЗапроса, КукиЗапроса, q, page, pool, mine);
КонецПроцедуры

Процедура ПоказатьКаталог(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач q, Знач page,
	Знач pool, Знач mine)

	Если НЕ Гвард.Проверить(Ответ).Разрешено Тогда
		Возврат;
	КонецЕсли;

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);
	Пользователь = Принципал.Пользователь;

	Отбор = Новый Структура("Пул, ТолькоУправляемые", СокрЛП(Строка(pool)), ЭтоДа(mine));
	Результат = Каталог.НайтиПакеты(q, ВЧисло(page), 0, Принципал, Отбор);

	Контент = ""
		+ НаборUI.ЗаголовокСтраницы().Отрисовать(ЗаголовокСтраницы(Результат.Отбор))
		+ ФормаПоиска(Результат)
		+ ПереключательОтбора(Результат, Пользователь)
		+ Итог(Результат)
		+ СписокПакетов(Результат, Пользователь)
		+ Пагинация(Результат);

	Ответ.УстановитьСостояниеОК();
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(ЗаголовокСтраницы(Результат.Отбор), Контент,
		Каркас.КонтекстСтраницы(Пользователь, КукиЗапроса));

КонецПроцедуры

#Область Рендер

Функция ЗаголовокСтраницы(Знач Отбор)
	Если Отбор.ТолькоУправляемые Тогда
		Возврат "Пакеты в моём управлении";
	ИначеЕсли ЗначениеЗаполнено(Отбор.Пул) Тогда
		Возврат СтрШаблон("Пакеты пула %1", Отбор.Пул);
	КонецЕсли;
	Возврат "Каталог пакетов";
КонецФункции

// Отборы переносятся скрытыми полями: иначе поиск внутри отбора сбрасывал бы отбор.
Функция ФормаПоиска(Знач Результат)

	Возврат НаборUI.ФормаОтбора().Отрисовать(
		Новый Структура("Действие, Метка, Значение, Плейсхолдер, Кнопка, Иконка, СкрытыеПоля",
			"/packages", "Поиск", Результат.Запрос, "Имя пакета или его часть",
			"Найти", "поиск", СкрытыеОтборы(Результат.Отбор)));

КонецФункции

Функция СкрытыеОтборы(Знач Отбор)

	Результат = Новый Массив();
	Если ЗначениеЗаполнено(Отбор.Пул) Тогда
		Результат.Добавить(Новый Структура("Имя, Значение", "pool", Отбор.Пул));
	КонецЕсли;
	Если Отбор.ТолькоУправляемые Тогда
		Результат.Добавить(Новый Структура("Имя, Значение", "mine", "1"));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Аноним отбора «в моём управлении» не видит: он ничем не управляет.
Функция ПереключательОтбора(Знач Результат, Знач Пользователь)

	Переключатель = Кит.Холст();
	Переключатель.Добавить(ВкладкиОтбора(Результат.Отбор, Пользователь));
	Переключатель.Добавить(ПолосаПримененногоОтбора(Результат.Отбор));

	Возврат Переключатель.Рендер();

КонецФункции

Функция ВкладкиОтбора(Знач Отбор, Знач Пользователь)

	Вкладки = Новый Массив();
	Если Пользователь <> Неопределено Тогда
		Вкладки.Добавить(Новый Структура("Подпись, Адрес, Активна, Иконка",
			"Все пакеты", АдресОтбора(Отбор, Ложь), НЕ Отбор.ТолькоУправляемые, "пакет"));
		Вкладки.Добавить(Новый Структура("Подпись, Адрес, Активна, Иконка",
			"В моём управлении", АдресОтбора(Отбор, Истина), Отбор.ТолькоУправляемые, "шестерёнка"));
	КонецЕсли;

	Возврат Кит.Табы(Новый Структура("Вкладки, Заголовок", Вкладки, "Отборы каталога"));

КонецФункции

// Отбор пришёл из адреса: без напоминания выдача читается как весь каталог.
Функция ПолосаПримененногоОтбора(Знач Отбор)

	Если НЕ ЗначениеЗаполнено(Отбор.Пул) Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Плашки = Новый Массив();
	Плашки.Добавить(Новый Структура("Текст, Вид, Иконка, Адрес",
		"пул: " + Отбор.Пул, "accent", "куб", "/" + Отбор.Пул));

	Полоса = Кит.Область("отбор");
	Полоса.Добавить(Кит.РядПлашек(Плашки));
	Возврат Полоса;

КонецФункции

// Отбор по пулу обязан переживать переключение «управляемые».
Функция АдресОтбора(Знач Отбор, Знач ТолькоУправляемые)
	Возврат Адреса.Каталог(Отбор.Пул, ТолькоУправляемые);
КонецФункции

Функция Итог(Знач Результат)
	Если Результат.Всего = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Кит.Примечание("Найдено пакетов: " + Результат.Всего).Рендер();
КонецФункции

Функция СписокПакетов(Знач Результат, Знач Пользователь)

	Компоненты = НаборUI;

	Если Результат.Элементы.Количество() = 0 Тогда
		Возврат Компоненты.ПустоеСостояние().Отрисовать(ПустаяВыдача(Результат));
	КонецЕсли;

	Возврат КарточкиUI.Список(
		Витрина.Карточки(Результат.Элементы, Пользователь)).Рендер();

КонецФункции

Функция ПустаяВыдача(Знач Результат)

	Модель = Новый Структура("Иконка", "поиск");

	Если ЗначениеЗаполнено(Результат.Запрос) Тогда
		Модель.Вставить("Заголовок", СтрШаблон("По запросу «%1» ничего не найдено", Результат.Запрос));
		Модель.Вставить("Пояснение", "Проверьте написание имени или снимите отборы.");
		Модель.Вставить("Действие", Новый Структура("Подпись, Адрес, Вариант",
			"Показать все пакеты", "/packages", "вторичная"));
		Возврат Модель;
	КонецЕсли;

	Если Результат.Отбор.ТолькоУправляемые Тогда
		Модель.Вставить("Иконка", "шестерёнка");
		Модель.Вставить("Заголовок", "Вы пока ничем не управляете");
		Модель.Вставить("Пояснение", "Опубликуйте пакет через opm push либо попросите"
			+ " мейнтейнера выдать вам права на пакет — он появится здесь.");
		Модель.Вставить("Действие", Новый Структура("Подпись, Адрес, Вариант",
			"Показать все пакеты", АдресОтбора(Результат.Отбор, Ложь), "вторичная"));
		Возврат Модель;
	КонецЕсли;

	Если ЗначениеЗаполнено(Результат.Отбор.Пул) Тогда
		Модель.Вставить("Иконка", "куб");
		Модель.Вставить("Заголовок", "В этом пуле пока нет пакетов");
		Модель.Вставить("Пояснение", "Опубликуйте первый пакет командой opm push.");
		Возврат Модель;
	КонецЕсли;

	Модель.Вставить("Иконка", "пакет");
	Модель.Вставить("Заголовок", "Пока нет ни одного пакета");
	Модель.Вставить("Пояснение", "Опубликуйте первый пакет командой opm push — он появится в каталоге.");
	Возврат Модель;

КонецФункции

Функция Пагинация(Знач Результат)

	Параметры = Новый Массив();
	Если ЗначениеЗаполнено(Результат.Запрос) Тогда
		Параметры.Добавить(Новый Структура("Имя, Значение", "q", Результат.Запрос));
	КонецЕсли;
	Если ЗначениеЗаполнено(Результат.Отбор.Пул) Тогда
		Параметры.Добавить(Новый Структура("Имя, Значение", "pool", Результат.Отбор.Пул));
	КонецЕсли;
	Если Результат.Отбор.ТолькоУправляемые Тогда
		Параметры.Добавить(Новый Структура("Имя, Значение", "mine", "1"));
	КонецЕсли;

	Возврат НаборUI.Пагинация().Отрисовать(
		Новый Структура("Страница, ВсегоСтраниц, Основа, Параметры",
			Результат.Страница, Результат.ВсегоСтраниц, "/packages", Параметры));

КонецФункции

#КонецОбласти

#Область Служебное

Функция ЭтоДа(Знач Значение)
	Норм = НРег(СокрЛП(?(Значение = Неопределено, "", Строка(Значение))));
	Возврат Норм = "1" ИЛИ Норм = "да" ИЛИ Норм = "true" ИЛИ Норм = "on";
КонецФункции

Функция ВЧисло(Знач Значение)
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат 1;
	КонецЕсли;
	Попытка
		Возврат Макс(1, Цел(Число(Значение)));
	Исключение
		Возврат 1;
	КонецПопытки;
КонецФункции

#КонецОбласти

&Контроллер("/packages")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаталогПакетов") _Каталог,
	&Пластилин(Значение = "ВитринаПакетов") _Витрина,
	&Пластилин(Значение = "КарточкаПакета") _КарточкиUI,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "НаборКомпонентов") _НаборUI,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "ГвардОнбординга") _Гвард,
	&Пластилин(Значение = "АдресаКаталога") _Адреса)

	Каталог = _Каталог;
	Витрина = _Витрина;
	КарточкиUI = _КарточкиUI;
	Кит = _Кит;
	Каркас = _Каркас;
	НаборUI = _НаборUI;
	Перехватчик = _Перехватчик;
	Гвард = _Гвард;
	Адреса = _Адреса;

КонецПроцедуры
