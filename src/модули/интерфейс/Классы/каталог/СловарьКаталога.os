// Тексты района «Каталог»: главная, каталог пакетов, список пулов, страницы пула и пакета.

// Кладёт тексты в словарь интерфейса.
//
// Параметры:
//  Словарь - СловарьТекстов - словарь, который собирается из частей.
//
Процедура Наполнить(Знач Словарь) Экспорт

	КлючиКаталогаПакетов(Словарь);
	КлючиСпискаПулов(Словарь);
	КлючиСтраницыПула(Словарь);
	КлючиСтраницыПакета(Словарь);
	КлючиГлавной(Словарь);

КонецПроцедуры

// Каталог пакетов /packages: поиск, отборы, пустая выдача.
Процедура КлючиКаталогаПакетов(Словарь)

	Словарь.Добавить("public.catalog.title", "Каталог пакетов");
	Словарь.Добавить("public.catalog.title.mine", "Пакеты в моём управлении");
	Словарь.Добавить("public.catalog.title.pool", "Пакеты пула %1");
	Словарь.Добавить("public.catalog.search.label", "Поиск");
	Словарь.Добавить("public.catalog.search.placeholder", "Имя пакета или его часть");
	Словарь.Добавить("public.catalog.tabs.title", "Отборы каталога");
	Словарь.Добавить("public.catalog.tab.all", "Все пакеты");
	Словарь.Добавить("public.catalog.tab.mine", "В моём управлении");
	Словарь.Добавить("public.catalog.filter.pool", "пул: %1");
	Словарь.Добавить("public.catalog.found", "Найдено пакетов: %1");

	Словарь.Добавить("public.catalog.empty.query.title", "По запросу «%1» ничего не найдено");
	Словарь.Добавить("public.catalog.empty.query.lead", "Проверьте написание имени или снимите отборы.");
	Словарь.Добавить("public.catalog.empty.all", "Показать все пакеты");
	Словарь.Добавить("public.catalog.empty.mine.title", "Вы пока ничем не управляете");
	Словарь.Добавить("public.catalog.empty.mine.lead", "Опубликуйте пакет через opm push либо попросите"
		+ " мейнтейнера выдать вам права на пакет — он появится здесь.");
	Словарь.Добавить("public.catalog.empty.pool.title", "В этом пуле пока нет пакетов");
	Словарь.Добавить("public.catalog.empty.pool.lead", "Опубликуйте первый пакет командой opm push.");
	Словарь.Добавить("public.catalog.empty.title", "Пока нет ни одного пакета");
	Словарь.Добавить("public.catalog.empty.lead",
		"Опубликуйте первый пакет командой opm push — он появится в каталоге.");

КонецПроцедуры

// Список пулов: какие пулы видны посетителю.
Процедура КлючиСпискаПулов(Словарь)

	Словарь.Добавить("public.pools.title", "Пулы");
	Словарь.Добавить("public.pools.lead", "Пространства имён хаба: у каждого пула свой адрес для opm.");
	Словарь.Добавить("public.pools.column.name", "Пул");
	Словарь.Добавить("public.pools.column.kind", "Тип");
	Словарь.Добавить("public.pools.column.visibility", "Видимость");
	Словарь.Добавить("public.pools.column.packages", "Пакетов");
	Словарь.Добавить("public.pools.column.sources", "Источники");
	Словарь.Добавить("public.pools.kind.project", "Проектный");
	Словарь.Добавить("public.pools.kind.personal", "Личное пространство");
	Словарь.Добавить("public.pools.menu.title", "Действия над пулом «%1»");
	Словарь.Добавить("public.pools.action.settings", "Настройки");
	Словарь.Добавить("public.pools.action.packages", "Пакеты");
	Словарь.Добавить("public.pools.empty.title", "Пулов, открытых вам, нет");
	Словарь.Добавить("public.pools.empty.lead", "Приватный пул появится здесь, когда вас добавят в его участники.");
	Словарь.Добавить("public.pools.empty.guest.title", "Пулов, открытых гостю, нет");
	Словарь.Добавить("public.pools.empty.guest.lead", "Приватные пулы видны их участникам после входа.");
	Словарь.Добавить("public.pools.empty.login", "Войти");

КонецПроцедуры

// Страница пула.
Процедура КлючиСтраницыПула(Словарь)

	Словарь.Добавить("public.pool.notfound", "Пул «%1» не найден");
	Словарь.Добавить("public.pool.packages.title", "Пакеты пула");
	Словарь.Добавить("public.pool.empty.title", "В пуле пока нет пакетов");
	Словарь.Добавить("public.pool.empty.lead",
		"Опубликуйте первый пакет командой opm push — он появится здесь.");
	Словарь.Добавить("public.pool.start.publish", "Опубликовать первый пакет");
	Словарь.Добавить("public.pool.start.migrate", "Перенести пакеты из другого хаба");
	Словарь.Добавить("public.pool.all-packages", "Все пакеты пула");
	Словарь.Добавить("public.pool.settings", "Настройки пула");

	Словарь.Добавить("public.pool.add.title", "Добавить пакет");
	Словарь.Добавить("public.pool.add.lead", "Имя займётся за пакетом; первую версию опубликуете вы"
		+ " или тот, кому дадите права.");
	Словарь.Добавить("public.pool.add.name.label", "Имя пакета");
	Словарь.Добавить("public.pool.add.name.hint", "Латиница, цифры, «-», «_», «.»");
	Словарь.Добавить("public.pool.add.button", "Добавить");
	Словарь.Добавить("public.pool.add.error.empty", "Укажите имя пакета.");
	Словарь.Добавить("public.pool.add.forbidden",
		"Добавлять пакеты в пул «%1» и снимать их резервы вправе его мейнтейнеры");
	Словарь.Добавить("public.pool.add.blocked",
		"Публикация в пул выключена, поэтому пакет не добавить: он остался бы пустым навсегда —"
		+ " опубликовать в него не смог бы никто. Включите публикацию в настройках пула.");

	Словарь.Добавить("public.pool.release.title", "Снять резерв имени «%1»?");
	Словарь.Добавить("public.pool.release.lead",
		"Пакет без версий удалится вместе с ролями на него, имя освободится. Следующий, кто займёт"
		+ " это имя, ничего не унаследует. Вернуть это нельзя.");
	Словарь.Добавить("public.pool.release.button", "Снять резерв");
	Словарь.Добавить("public.pool.release.error", "Резерв не снят: %1");
	Словарь.Добавить("public.pool.packages.error.operation",
		"Неизвестное действие со списком пакетов. Ничего не изменено — обновите страницу"
		+ " и повторите.");

КонецПроцедуры

// Страница пакета: вкладки, описание, зависимости, команда установки, скачивание, манифест версии.
Процедура КлючиСтраницыПакета(Словарь)

	Словарь.Добавить("public.package.notfound", "Пакет «%1» не найден в пуле «%2»");
	Словарь.Добавить("public.package.settings", "Настройки пакета");
	Словарь.Добавить("public.package.tabs.title", "Разделы страницы пакета");
	Словарь.Добавить("public.package.tab.readme", "Описание");
	Словарь.Добавить("public.package.tab.versions", "Версии");
	Словарь.Добавить("public.package.tab.deps", "Зависимости");

	Словарь.Добавить("public.package.readme.title", "Описание");
	Словарь.Добавить("public.package.readme.empty.title", "У этой версии нет README");
	Словарь.Добавить("public.package.readme.empty.lead",
		"Добавьте README.md в корень пакета — он появится здесь после публикации.");
	Словарь.Добавить("public.package.readme.source", "В пакете README нет — показан README из репозитория, %1.");
	Словарь.Добавить("public.package.readme.source.tag", "с тега %1");
	Словарь.Добавить("public.package.readme.source.branch", "из ветки по умолчанию");
	Словарь.Добавить("public.package.default.empty.title", "У пакета нет версии по умолчанию");
	Словарь.Добавить("public.package.default.empty.lead",
		"Канал по умолчанию пуст: его версии отозваны либо в него ничего не добавляли."
		+ " Установка без версии сейчас тоже ничего не поставит — верните версию в канал"
		+ " или назначьте основным другой канал.");

	Словарь.Добавить("public.package.deps.title", "Зависимости пакета");
	Словарь.Добавить("public.package.deps.uses", "Зависит от");
	Словарь.Добавить("public.package.deps.used-by", "Кто зависит");
	Словарь.Добавить("public.package.deps.column.package", "Пакет");
	Словарь.Добавить("public.package.deps.column.range", "Диапазон");
	Словарь.Добавить("public.package.deps.column.pool", "Пул");
	Словарь.Добавить("public.package.deps.dev", "для разработки");
	Словарь.Добавить("public.package.deps.any", "любая");
	Словарь.Добавить("public.package.deps.no-default", "У пакета нет версии по умолчанию — показывать нечего");
	Словарь.Добавить("public.package.deps.none", "Пакет ни от чего не зависит");
	Словарь.Добавить("public.package.deps.nobody", "От пакета никто не зависит");

	Словарь.Добавить("public.package.install.hint-address",
		"Адресную форму понимает opm с изменениями под новый хаб; в выпущенном opm её пока нет —"
		+ " он ответит «Пакет не найден», ему нужен способ ниже на странице.");
	Словарь.Добавить("public.package.install.hint-short",
		"Пакет лежит в основном пуле хаба: короткой формы достаточно, если хаб прописан"
		+ " сервером пакетов в opm.cfg.");

	// основной публичный пул хаба, который opm знает по умолчанию: прописывать нечего
	Словарь.Добавить("public.package.install.hint-short.default-hub",
		"Пакет лежит в основном пуле хаба, а opm знает этот хаб по умолчанию: короткой формы"
		+ " достаточно.");
	Словарь.Добавить("public.package.install.title", "Установка через запись в opm.cfg");
	Словарь.Добавить("public.package.install.lead",
		"Выпущенный opm адрес пула в аргументе не разбирает: пул сначала прописывают сервером"
		+ " пакетов, и только потом ставят через него. Клиенту, который понимает адресную форму,"
		+ " этот раздел не нужен — хватает команды из шапки страницы.");
	Словарь.Добавить("public.package.install.config",
		"Добавьте пул сервером пакетов в opm.cfg. Порт продублирован в «Сервер»:"
		+ " у opm push поле «Порт» не читается.");
	Словарь.Добавить("public.package.install.by-server", "И ставьте пакет, указывая сервер:");
	Словарь.Добавить("public.package.install.private",
		"Пул приватный: без токена доступа (PAT) хаб отвечает «не найдено». Заведите токен"
		+ " в кабинете и подставьте его значение в поле «Авторизация».");
	Словарь.Добавить("public.package.channel.hint", "Канал обновления: %1");

	// вкладка «Версии»: каналы и плоский список
	Словарь.Добавить("public.package.versions.empty.lead", "Опубликуйте первую версию командой opm push.");
	Словарь.Добавить("public.package.versions.empty.title", "Нет опубликованных версий");
	Словарь.Добавить("public.package.versions.by-channel", "Сгруппировать версии по тегам");
	Словарь.Добавить("public.package.versions.flat", "Показать все версии списком");
	Словарь.Добавить("public.package.channels.title", "Каналы пакета");
	Словарь.Добавить("public.package.channels.column.channel", "Канал");
	Словарь.Добавить("public.package.channels.column.current", "Актуальная версия");
	Словарь.Добавить("public.package.channels.column.history", "История");
	Словарь.Добавить("public.package.channels.history", "версий: %1");
	Словарь.Добавить("public.package.versions.title", "Версии пакета");
	Словарь.Добавить("public.package.versions.column.version", "Версия");
	Словарь.Добавить("public.package.versions.column.channels", "Каналы");
	Словарь.Добавить("public.package.versions.column.date", "Дата");
	Словарь.Добавить("public.package.versions.column.downloads", "Скачано");
	Словарь.Добавить("public.package.versions.column.size", "Размер");
	Словарь.Добавить("public.package.versions.channels", "Каналы версии");
	Словарь.Добавить("public.package.column.install", "Установка");
	Словарь.Добавить("public.package.column.file", "Файл");

	Словарь.Добавить("public.package.download.label", "Скачать %1");
	Словарь.Добавить("public.package.download.default.hint",
		"Скачать %1 — версию, которую ставит установка без указания версии");
	Словарь.Добавить("public.package.download.channel.hint", "Скачать %1 — версию канала «%2»");
	Словарь.Добавить("public.package.download.offline",
		"Скачанный файл ставится командой %1 — сеть для этого уже не нужна.");
	Словарь.Добавить("public.package.version.manifest", "в манифесте %1");

	Словарь.Добавить("public.package.empty.title", "Версий пока нет");
	Словарь.Добавить("public.package.empty.lead",
		"Имя занято, но ни одной версии этого пакета ещё не опубликовано.");
	Словарь.Добавить("public.package.empty.publish.title", "Как опубликовать первую версию");
	Словарь.Добавить("public.package.empty.publish.push", "Соберите пакет и отправьте его в пул:");
	Словарь.Добавить("public.package.empty.publish.note",
		"Первую версию принимают только с адресом репозитория в packagedef. Кто её опубликует,"
		+ " станет мейнтейнером пакета. Конвейеру CI секрет не нужен — доверьте публикацию ему.");
	Словарь.Добавить("public.package.empty.publish.ci", "Доверенная публикация");
	Словарь.Добавить("public.package.empty.publish.access", "Права на пакет");

КонецПроцедуры

// Главная: поиск, обзор пулов, свежее и популярное, первые шаги.
Процедура КлючиГлавной(Словарь)

	Словарь.Добавить("public.landing.lead",
		"Открытый хаб пакетов OneScript: пулы, кэширующий прокси, теги версий"
		+ " и semver — с полной совместимостью с opm.");
	Словарь.Добавить("public.landing.search.placeholder", "Имя пакета или его часть");

	Словарь.Добавить("public.landing.pools.title", "Пулы хаба");
	Словарь.Добавить("public.landing.pools.lead", "Пространства имён, из которых собран каталог.");
	Словарь.Добавить("public.landing.pools.packages", "пакетов: %1");
	Словарь.Добавить("public.landing.pools.more", "Показаны %1 из %2 — остальные ищите в каталоге.");

	Словарь.Добавить("public.landing.fresh.title", "Недавно опубликовано");
	Словарь.Добавить("public.landing.fresh.lead", "Свежие версии в доступных вам пулах.");
	Словарь.Добавить("public.landing.fresh.published", "опубликована");

	Словарь.Добавить("public.landing.popular.title", "Популярное");
	Словарь.Добавить("public.landing.popular.lead", "Пакеты, которые скачивают чаще прочих.");
	Словарь.Добавить("public.landing.popular.downloads", "скачиваний");
	Словарь.Добавить("public.landing.popular.updated", "обновлён");

	Словарь.Добавить("public.landing.empty.title", "На хабе пока нет пакетов");
	Словарь.Добавить("public.landing.empty.lead",
		"Пропишите хаб сервером пакетов в opm.cfg и выполните opm push —"
		+ " первый пакет появится здесь.");
	Словарь.Добавить("public.landing.empty.lead.default-hub",
		"Опубликуйте первый пакет командой opm push --token <токен> -c stable <файл>.ospx —"
		+ " он появится здесь.");
	Словарь.Добавить("public.landing.empty.login", "Войти");
	Словарь.Добавить("public.landing.empty.tour", "Как опубликовать первый пакет");

	Словарь.Добавить("public.landing.start.title", "Быстрый старт");
	Словарь.Добавить("public.landing.start.config", "Добавьте хаб в opm.cfg как сервер пакетов:");
	Словарь.Добавить("public.landing.start.install", "И устанавливайте пакеты как обычно:");

	// без образца opm.cfg выше пояснению продолжать нечего
	Словарь.Добавить("public.landing.start.install.default-hub", "Устанавливайте пакеты как обычно:");
	Словарь.Добавить("public.landing.start.unknown",
		"Образец настройки пока не собрать: не задан адрес хаба (настройки хаба,"
		+ " раздел «Основное») и не назначен основной пул хаба.");

КонецПроцедуры

&Прозвище("ЧастьСловаряТекстов")
&Порядок(20)
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
