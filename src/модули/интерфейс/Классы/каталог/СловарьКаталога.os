// Тексты района «Каталог»: главная, страницы пула и пакета.

// Кладёт тексты в словарь интерфейса.
//
// Параметры:
//  Словарь - СловарьТекстов - словарь, который собирается из частей.
//
Процедура Наполнить(Знач Словарь) Экспорт

	КлючиСтраницыПула(Словарь);
	КлючиСтраницыПакета(Словарь);
	КлючиГлавной(Словарь);

КонецПроцедуры

// Страница пула.
Процедура КлючиСтраницыПула(Словарь)

	Словарь.Добавить("public.pool.notfound", "Пул «%1» не найден");
	Словарь.Добавить("public.pool.packages.title", "Пакеты пула");
	Словарь.Добавить("public.pool.empty.title", "В пуле пока нет пакетов");
	Словарь.Добавить("public.pool.empty.lead",
		"Опубликуйте первый пакет командой opm push — он появится здесь.");
	Словарь.Добавить("public.pool.start.title", "С чего начать");
	Словарь.Добавить("public.pool.start.publish", "Опубликовать первый пакет");
	Словарь.Добавить("public.pool.start.migrate", "Перенести пакеты из другого хаба");
	Словарь.Добавить("public.pool.all-packages", "Все пакеты пула");
	Словарь.Добавить("public.pool.settings", "Настройки пула");

КонецПроцедуры

// Страница пакета: команда установки, скачивание, манифест версии.
Процедура КлючиСтраницыПакета(Словарь)

	Словарь.Добавить("public.package.install.hint-address",
		"Адресную форму понимает opm с изменениями под новый хаб; в выпущенном opm её пока нет —"
		+ " он ответит «Пакет не найден», ему нужен способ ниже на странице.");
	Словарь.Добавить("public.package.install.hint-short",
		"Пакет лежит в основном пуле хаба: короткой формы достаточно, если хаб прописан"
		+ " сервером пакетов в opm.cfg.");

	// основной публичный пул хаба, который opm знает по умолчанию: прописывать нечего
	Словарь.Добавить("public.package.install.hint-short.default-hub",
		"Пакет лежит в основном пуле хаба, а opm знает этот хаб по умолчанию: короткой формы"
		+ " достаточно.");
	Словарь.Добавить("public.package.install.title", "Установка через запись в opm.cfg");
	Словарь.Добавить("public.package.install.lead",
		"Выпущенный opm адрес пула в аргументе не разбирает: пул сначала прописывают сервером"
		+ " пакетов, и только потом ставят через него. Клиенту, который понимает адресную форму,"
		+ " этот раздел не нужен — хватает команды из шапки страницы.");
	Словарь.Добавить("public.package.install.config",
		"Добавьте пул сервером пакетов в opm.cfg. Порт продублирован в «Сервер»:"
		+ " у opm push поле «Порт» не читается.");
	Словарь.Добавить("public.package.install.by-server", "И ставьте пакет, указывая сервер:");
	Словарь.Добавить("public.package.install.private",
		"Пул приватный: без токена доступа (PAT) хаб отвечает «не найдено». Заведите токен"
		+ " в кабинете и подставьте его значение в поле «Авторизация».");
	Словарь.Добавить("public.package.channel.hint", "Канал обновления: %1");

	Словарь.Добавить("public.package.download.label", "Скачать %1");
	Словарь.Добавить("public.package.download.default.hint",
		"Скачать %1 — версию, которую ставит установка без указания версии");
	Словарь.Добавить("public.package.download.channel.hint", "Скачать %1 — версию канала «%2»");
	Словарь.Добавить("public.package.download.offline",
		"Скачанный файл ставится командой %1 — сеть для этого уже не нужна.");
	Словарь.Добавить("public.package.version.manifest", "в манифесте %1");

КонецПроцедуры

// Главная: поиск, обзор пулов, свежее и популярное, первые шаги.
Процедура КлючиГлавной(Словарь)

	Словарь.Добавить("public.landing.lead",
		"Открытый хаб пакетов OneScript: пулы, кэширующий прокси, теги версий"
		+ " и semver — с полной совместимостью с opm.");
	Словарь.Добавить("public.landing.search.label", "Поиск пакетов");
	Словарь.Добавить("public.landing.search.placeholder", "Имя пакета или его часть");
	Словарь.Добавить("public.landing.search.button", "Найти");
	Словарь.Добавить("public.landing.catalog", "Открыть каталог пакетов");

	Словарь.Добавить("public.landing.pools.title", "Пулы хаба");
	Словарь.Добавить("public.landing.pools.lead", "Пространства имён, из которых собран каталог.");
	Словарь.Добавить("public.landing.pools.packages", "пакетов: %1");
	Словарь.Добавить("public.landing.pools.more", "Показаны %1 из %2 — остальные ищите в каталоге.");

	Словарь.Добавить("public.landing.fresh.title", "Недавно опубликовано");
	Словарь.Добавить("public.landing.fresh.lead", "Свежие версии в доступных вам пулах.");
	Словарь.Добавить("public.landing.fresh.published", "опубликована");

	Словарь.Добавить("public.landing.popular.title", "Популярное");
	Словарь.Добавить("public.landing.popular.lead", "Пакеты, которые скачивают чаще прочих.");
	Словарь.Добавить("public.landing.popular.downloads", "скачиваний");
	Словарь.Добавить("public.landing.popular.updated", "обновлён");

	Словарь.Добавить("public.landing.empty.title", "На хабе пока нет пакетов");
	Словарь.Добавить("public.landing.empty.lead",
		"Пропишите хаб сервером пакетов в opm.cfg и выполните opm push —"
		+ " первый пакет появится здесь.");
	Словарь.Добавить("public.landing.empty.lead.default-hub",
		"Опубликуйте первый пакет командой opm push --token <токен> -c stable <файл>.ospx —"
		+ " он появится здесь.");
	Словарь.Добавить("public.landing.empty.login", "Войти");
	Словарь.Добавить("public.landing.empty.tour", "Как опубликовать первый пакет");

	Словарь.Добавить("public.landing.start.title", "Быстрый старт");
	Словарь.Добавить("public.landing.start.config", "Добавьте хаб в opm.cfg как сервер пакетов:");
	Словарь.Добавить("public.landing.start.install", "И устанавливайте пакеты как обычно:");

	// без образца opm.cfg выше пояснению продолжать нечего
	Словарь.Добавить("public.landing.start.install.default-hub", "Устанавливайте пакеты как обычно:");
	Словарь.Добавить("public.landing.start.unknown",
		"Образец настройки пока не собрать: не задан URL инстанса (настройки хаба,"
		+ " раздел «Базовые настройки») и не назначен основной пул хаба.");

КонецПроцедуры

&Прозвище("ЧастьСловаряТекстов")
&Порядок(20)
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
