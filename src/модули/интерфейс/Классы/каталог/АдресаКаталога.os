// Адреса каталога пакетов — желудь модуля web-ui. Каждое состояние отбора имеет свой
// адрес, и собирает его одно место: иначе «мои пакеты» из шапки кабинета и «мои пакеты»
// с плитки личного пространства разъезжаются с вкладкой самого каталога.

#Область ПубличныйИнтерфейс

// Адрес каталога с заданным отбором.
//
// Параметры:
//  Пул - Строка - отбор по пулу; пустой отбора не ставит (необязательный, по умолчанию "").
//  ТолькоУправляемые - Булево - отбор «в моём управлении» (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Строка - относительный адрес каталога.
//
Функция Каталог(Знач Пул = "", Знач ТолькоУправляемые = Ложь) Экспорт

	Пары = Новый Массив();
	Если ЗначениеЗаполнено(Пул) Тогда
		Пары.Добавить("pool=" + КодироватьСтроку(Пул, СпособКодированияСтроки.КодировкаURL));
	КонецЕсли;
	Если ТолькоУправляемые Тогда
		Пары.Добавить("mine=1");
	КонецЕсли;

	Возврат "/packages" + ?(Пары.Количество() > 0, "?" + СтрСоединить(Пары, "&"), "");

КонецФункции

// Адрес каталога с отбором «которыми я могу управлять» — единственное представление
// «моих пакетов».
//
// Возвращаемое значение:
//  Строка - относительный адрес каталога.
//
Функция Управляемые() Экспорт
	Возврат Каталог("", Истина);
КонецФункции

#КонецОбласти

&Прозвище("АдресаКаталога")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
