// Адреса каталога пакетов: каждое состояние отбора имеет свой адрес, и собирает его одно
// место — иначе «мои пакеты» из разных входов разъезжаются с вкладкой самого каталога.

Перем ПараметрыСсылки;  // ПараметрыСсылки (основа) — параметр запроса на адресе

#Область ПубличныйИнтерфейс

// Адрес каталога с заданным отбором.
//
// Параметры:
//  Пул - Строка - отбор по пулу; пустой отбора не ставит (необязательный, по умолчанию "").
//  ТолькоУправляемые - Булево - отбор «в моём управлении» (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Строка - относительный адрес каталога.
//
Функция Каталог(Знач Пул = "", Знач ТолькоУправляемые = Ложь) Экспорт

	Адрес = "/packages";
	Если ЗначениеЗаполнено(Пул) Тогда
		Адрес = ПараметрыСсылки.Добавить(Адрес, "pool", Строка(Пул));
	КонецЕсли;
	Если ТолькоУправляемые Тогда
		Адрес = ПараметрыСсылки.Добавить(Адрес, "mine", "1");
	КонецЕсли;

	Возврат Адрес;

КонецФункции

// Адрес каталога с отбором «которыми я могу управлять» — единственное представление
// «моих пакетов».
//
// Возвращаемое значение:
//  Строка - относительный адрес каталога.
//
Функция Управляемые() Экспорт
	Возврат Каталог("", Истина);
КонецФункции

#КонецОбласти

&Прозвище("АдресаКаталога")
&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ПараметрыСсылки") _Параметры = Неопределено) Экспорт
	ПараметрыСсылки = ?(_Параметры = Неопределено, Новый ПараметрыСсылки(), _Параметры);
КонецПроцедуры
