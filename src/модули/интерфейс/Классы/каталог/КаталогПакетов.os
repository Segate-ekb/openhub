// Презентационный адаптер каталога: ранжированный поиск и пагинацию выполняет СлужбаПоиска,
// каталог дополняет пакет его пулом и применяет отборы — по пулу и «в моём управлении».

Перем СлужбаПоиска;
Перем СервисПулов;
Перем СервисПакетов;
Перем ВидимостьПулов;  // ВидимостьПулов (поиск) — видимость выдачи про все пулы сразу
Перем ЧтениеПула;      // ГвардДоступаКПулу (права) — видимость одного названного пула
Перем СлужбаКабинета;  // СлужбаКабинета (кабинет)

// Описание пустого отбора — все пакеты хаба.
//
// Возвращаемое значение:
//  Структура - Пул, ТолькоУправляемые.
//
Функция ПустойОтбор() Экспорт
	Возврат Новый Структура("Пул, ТолькоУправляемые", "", Ложь);
КонецФункции

// Ищет пакеты по запросу с ранжированием, отборами и пагинацией.
//
// Параметры:
//  Запрос         - Строка - (необязательный, по умолчанию "") подстрока, регистр не
//                   важен; пусто — все пакеты.
//  Страница       - Число  - (необязательный, по умолчанию 1) номер страницы с 1,
//                   клампится к [1; ВсегоСтраниц].
//  РазмерСтраницы - Число  - (необязательный, по умолчанию 0) размер страницы;
//                   0 и меньше — значение по умолчанию.
//  Принципал      - Структура, Неопределено - (необязательный, по умолчанию
//                   Неопределено) принципал запроса; приватные пулы попадают в каталог
//                   только при праве чтения и в рамках ключа запроса.
//  Отбор          - Структура, Неопределено - (необязательный, по умолчанию
//                   Неопределено) отбор, см. ПустойОтбор.
//
// Возвращаемое значение:
//  Структура - Элементы (Массив структур Пакет, Пул), Всего (до пагинации), Страница,
//              ВсегоСтраниц, РазмерСтраницы, Запрос (нормализованный),
//              Отбор (применённый).
//
Функция НайтиПакеты(Знач Запрос = "", Знач Страница = 1, Знач РазмерСтраницы = 0,
	Знач Принципал = Неопределено, Знач Отбор = Неопределено) Экспорт

	Применённый = НормализованныйОтбор(Отбор);

	Если ЗначениеЗаполнено(Применённый.Пул) ИЛИ Применённый.ТолькоУправляемые Тогда
		Результат = ПоОтбору(Запрос, Страница, РазмерСтраницы, Принципал, Применённый);
	Иначе
		Результат = ПоПоиску(Запрос, Страница, РазмерСтраницы, Принципал);
	КонецЕсли;

	Результат.Вставить("Отбор", Применённый);
	Возврат Результат;

КонецФункции

// Нормализует отбор из произвольного значения, в том числе пришедшего из query.
//
// Параметры:
//  Отбор - Структура, Неопределено - сырой отбор.
//
// Возвращаемое значение:
//  Структура - Пул, ТолькоУправляемые.
//
Функция НормализованныйОтбор(Знач Отбор) Экспорт

	Результат = ПустойОтбор();
	Если ТипЗнч(Отбор) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;

	Значение = Неопределено;
	Если Отбор.Свойство("Пул", Значение) И Значение <> Неопределено Тогда
		Результат.Пул = СокрЛП(Строка(Значение));
	КонецЕсли;
	Если Отбор.Свойство("ТолькоУправляемые", Значение) Тогда
		Результат.ТолькоУправляемые = (Значение = Истина);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ПоПоиску(Знач Запрос, Знач Страница, Знач РазмерСтраницы, Знач Принципал)

	Найдено = СлужбаПоиска.НайтиПакеты(Запрос, Страница, РазмерСтраницы, Принципал);

	Элементы = Новый Массив();
	Для Каждого Пакет Из Найдено.Элементы Цикл
		Элементы.Добавить(Новый Структура("Пакет, Пул",
			Пакет, СервисПулов.ПулПоИдентификатору(Пакет.ПулИдентификатор)));
	КонецЦикла;

	Результат = Новый Структура();
	Результат.Вставить("Элементы", Элементы);
	Результат.Вставить("Всего", Найдено.Всего);
	Результат.Вставить("Страница", Найдено.Страница);
	Результат.Вставить("ВсегоСтраниц", Найдено.ВсегоСтраниц);
	Результат.Вставить("РазмерСтраницы", Найдено.РазмерСтраницы);
	Результат.Вставить("Запрос", Найдено.Запрос);
	Возврат Результат;

КонецФункции

// Сортировка по имени: без стабильного порядка вторая страница показывала бы то же, что первая.
Функция ПоОтбору(Знач Запрос, Знач Страница, Знач РазмерСтраницы, Знач Принципал, Знач Отбор)

	Подстрока = НРег(СокрЛП(?(Запрос = Неопределено, "", Строка(Запрос))));
	Размер = ?(Цел(РазмерСтраницы) > 0, Цел(РазмерСтраницы), РазмерПоУмолчанию());

	Отобранные = Новый Массив();

	Для Каждого Пара Из ЧитаемыеКандидаты(Принципал, Отбор) Цикл

		Пакет = Пара.Пакет;
		Если Пакет.Скрыт = Истина Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Подстрока) И СтрНайти(НРег(Строка(Пакет.Имя)), Подстрока) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Отбор.Пул) И НРег(Строка(Пара.Пул.Имя)) <> НРег(Отбор.Пул) Тогда
			Продолжить;
		КонецЕсли;

		Отобранные.Добавить(Пара);

	КонецЦикла;

	Отобранные = ПоИмени(Отобранные);

	Всего = Отобранные.Количество();
	ВсегоСтраниц = Макс(1, Цел((Всего + Размер - 1) / Размер));
	Текущая = Мин(Макс(1, Цел(?(ЗначениеЗаполнено(Страница), Страница, 1))), ВсегоСтраниц);

	Элементы = Новый Массив();
	Начало = (Текущая - 1) * Размер;
	Для Индекс = Начало По Мин(Начало + Размер, Всего) - 1 Цикл
		Элементы.Добавить(Отобранные[Индекс]);
	КонецЦикла;

	Результат = Новый Структура();
	Результат.Вставить("Элементы", Элементы);
	Результат.Вставить("Всего", Всего);
	Результат.Вставить("Страница", Текущая);
	Результат.Вставить("ВсегоСтраниц", ВсегоСтраниц);
	Результат.Вставить("РазмерСтраницы", Размер);
	Результат.Вставить("Запрос", СокрЛП(?(Запрос = Неопределено, "", Строка(Запрос))));
	Возврат Результат;

КонецФункции

// Обе ветки отдают пары, у которых пул есть: дальше он разыменовывается.
Функция ЧитаемыеКандидаты(Знач Принципал, Знач Отбор)

	Если Отбор.ТолькоУправляемые Тогда
		Возврат УправляемыеИзВидимыхПулов(Принципал);
	КонецЕсли;
	Возврат ПакетыЧитаемогоПула(Принципал, Отбор.Пул);

КонецФункции

// Судит тот же гвард, что страницу пула; прав на изменение отбор не спрашивает.
Функция ПакетыЧитаемогоПула(Знач Принципал, Знач ИмяПула)

	Результат = Новый Массив();

	Пул = ЧтениеПула.ЧитаемыйПул(ПользовательПринципала(Принципал), ИмяПула, Принципал);
	Если Пул = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Пакет Из СервисПакетов.ПакетыПула(Пул.Идентификатор) Цикл
		Результат.Добавить(Новый Структура("Пакет, Пул", Пакет, Пул));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Выдача про все пулы сразу: видимость спрашивается одним решением на запрос.
Функция УправляемыеИзВидимыхПулов(Знач Принципал)

	Решение = ВидимостьПулов.Решение(Принципал);

	Результат = Новый Массив();
	Для Каждого Пара Из СлужбаКабинета.ПакетыВУправлении(ПользовательПринципала(Принципал)) Цикл
		Если Пара.Пул <> Неопределено И ВидимостьПулов.ПулВиден(Решение, Пара.Пул.Идентификатор) Тогда
			Результат.Добавить(Пара);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПоИмени(Знач Список)

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Ключ");
	Таблица.Колонки.Добавить("Элемент");

	Для Каждого Элемент Из Список Цикл
		Строка = Таблица.Добавить();
		Строка.Ключ = НРег(Строка(Элемент.Пул.Имя)) + "/" + НРег(Строка(Элемент.Пакет.Имя));
		Строка.Элемент = Элемент;
	КонецЦикла;
	Таблица.Сортировать("Ключ Возр");

	Результат = Новый Массив();
	Для Каждого Строка Из Таблица Цикл
		Результат.Добавить(Строка.Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПользовательПринципала(Знач Принципал)
	Возврат ?(Принципал = Неопределено, Неопределено, Принципал.Пользователь);
КонецФункции

Функция РазмерПоУмолчанию()
	Возврат 20;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СлужбаПоиска") _СлужбаПоиска,
	&Пластилин(Значение = "СервисПулов") _СервисПулов,
	&Пластилин(Значение = "СервисПакетов") _СервисПакетов,
	&Пластилин(Значение = "ВидимостьПулов") _ВидимостьПулов,
	&Пластилин(Значение = "ГвардДоступаКПулу") _ЧтениеПула,
	&Пластилин(Значение = "СлужбаКабинета") _СлужбаКабинета)

	СлужбаПоиска = _СлужбаПоиска;
	СервисПулов = _СервисПулов;
	СервисПакетов = _СервисПакетов;
	ВидимостьПулов = _ВидимостьПулов;
	ЧтениеПула = _ЧтениеПула;
	СлужбаКабинета = _СлужбаКабинета;

КонецПроцедуры
