// Шаг подтверждения снятия резерва над списком пакетов пула и отказ, если снять не вышло.
// Подтверждение повторяет имя: форма одного резерва не снимает соседний.

Перем Кит;       // Кит (кит) — фабрика элементов экрана
Перем Тексты;    // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Страницы;  // АдресаСтраниц (реестр) — куда уходит форма и куда ведёт отмена

#Область ПубличныйИнтерфейс

// Вопрос «снять резерв?» с формой подтверждения и отменой.
//
// Параметры:
//  Пул - Пул - пул страницы.
//  ИмяПакета - Строка - имя снимаемого резерва.
//  Токен - Строка - CSRF-токен сессии.
//
// Возвращаемое значение:
//  Строка - разметка.
//
Функция Вопрос(Знач Пул, Знач ИмяПакета, Знач Токен) Экспорт

	Карточка = Кит.Карточка(Новый Структура("Заголовок, Описание, Иконка",
		Тексты.Текст("public.pool.release.title"), Тексты.Текст("public.pool.release.lead"),
		"предупреждение"));
	Карточка.Добавить(ЧтоСнимается(ИмяПакета));
	Карточка.Добавить(ФормаПодтверждения(Пул, ИмяПакета, Токен));
	Возврат Карточка.Рендер();

КонецФункции

// Отказ снятия: причина словами домена.
//
// Параметры:
//  Причина - Строка - почему резерв не снят.
//
// Возвращаемое значение:
//  Строка - разметка.
//
Функция Неудача(Знач Причина) Экспорт

	Возврат Кит.Уведомление(Новый Структура("Текст, Вид",
		Тексты.Шаблон("public.pool.release.error", Причина), "err")).Рендер();

КонецФункции

#КонецОбласти

#Область Сборка

// Имя стоит в месте шаблона кодом: фраза остаётся цельной, имя видно как имя.
Функция ЧтоСнимается(Знач ИмяПакета)

	Фраза = Кит.Шаблон(Тексты.Текст("public.pool.release.note"));
	Фраза.Добавить(Кит.Код(ИмяПакета));

	Примечание = Кит.Примечание();
	Примечание.Добавить(Фраза);
	Возврат Примечание;

КонецФункции

// «Отмена» — обычная ссылка на страницу пула: возврат ничего не меняет.
Функция ФормаПодтверждения(Знач Пул, Знач ИмяПакета, Знач Токен)

	Форма = Кит.Форма(Страницы.ПакетовПула(Пул.Имя), Токен, "строкой");
	Форма.Добавить(Кит.СкрытоеПоле("операция", "снять"));
	Форма.Добавить(Кит.СкрытоеПоле("имя", ИмяПакета));
	Форма.Добавить(Кит.СкрытоеПоле("подтверждение", ИмяПакета));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Тип, Иконка",
		Тексты.Текст("public.pool.release.button"), "опасная", "отправка", "корзина")));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Адрес",
		Тексты.Текст("public.pool.release.cancel"), "вторичная", Страницы.Пула(Пул.Имя))));
	Возврат Форма;

КонецФункции

#КонецОбласти

&Прозвище("СнятиеРезерва")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	Страницы = _Страницы;

КонецПроцедуры
