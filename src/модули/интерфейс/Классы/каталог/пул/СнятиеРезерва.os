// Окно подтверждения снятия резерва на странице пула и отказ, если снять не вышло.
// Окно называет снимаемое имя полем формы: подтверждение одного резерва не снимает соседний.

Перем Кит;       // Кит (кит) — фабрика элементов экрана
Перем Тексты;    // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Страницы;  // АдресаСтраниц (реестр) — куда уходит форма

#Область ПубличныйИнтерфейс

// Подтверждение «снять резерв?», напечатанное открытым: его открывает адрес окна, а кнопка
// окна по адресу из меню карточки берёт его оттуда. Закрывается на страницу пула без окна.
//
// Параметры:
//  Пул - Пул - пул страницы.
//  ИмяПакета - Строка - имя снимаемого резерва.
//
// Возвращаемое значение:
//  ЭлементЭкрана - окно подтверждения; токен формы оно берёт у предков.
//
Функция Подтверждение(Знач Пул, Знач ИмяПакета) Экспорт

	Возврат Кит.Подтверждение(Тексты.Шаблон("public.pool.release.title", ИмяПакета),
			Тексты.Текст("public.pool.release.lead"),
			Кит.СкрытоеПоле("операция", "снять"),
			Кит.СкрытоеПоле("имя", ИмяПакета))
		.Кнопка(Тексты.Текст("public.pool.release.button"))
		.Форма(Страницы.ПакетовПула(Пул.Имя)).БезПерезагрузки()
		.Якорь("release-package").Открыто().АдресЗакрытия(Страницы.Пула(Пул.Имя));

КонецФункции

// Отказ снятия: причина словами домена.
//
// Параметры:
//  Причина - Строка - почему резерв не снят.
//
// Возвращаемое значение:
//  ЭлементЭкрана - уведомление.
//
Функция Неудача(Знач Причина) Экспорт

	Возврат Кит.Уведомление(Новый Структура("Текст, Вид",
		Тексты.Шаблон("public.pool.release.error", Причина), "err"));

КонецФункции

#КонецОбласти

&Прозвище("СнятиеРезерва")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	Страницы = _Страницы;

КонецПроцедуры
