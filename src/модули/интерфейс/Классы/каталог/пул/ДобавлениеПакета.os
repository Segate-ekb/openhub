// «Добавить пакет» над списком пакетов пула: раскрывашка с полем имени, без скрипта — форма.
// Добавленный пакет пуст — это резерв имени до первой публикации.

Перем Кит;       // Кит (кит) — фабрика элементов экрана
Перем Тексты;    // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Пулы;      // СервисПулов (реестр) — принимает ли пул публикации
Перем Страницы;  // АдресаСтраниц (реестр) — куда уходит форма

#Область ПубличныйИнтерфейс

// Разметка «Добавить пакет». Отбитая форма приезжает раскрытой, с набранным именем
// и причиной у поля.
//
// Параметры:
//  Пул - Пул - пул страницы.
//  Токен - Строка - CSRF-токен сессии.
//  Набранное - Структура, Неопределено - отбитая форма: Имя, Ошибка; Неопределено — форму
//              ещё не отправляли.
//
// Возвращаемое значение:
//  Строка - разметка.
//
Функция Разметка(Знач Пул, Знач Токен, Знач Набранное) Экспорт

	Добавление = Кит.Раскрывашка();
	Если Набранное <> Неопределено Тогда
		Добавление.Открыть();
	КонецЕсли;

	Добавление.Шапка().Добавить(Кит.Иконка("плюс"));
	Добавление.Шапка().Добавить(Кит.Текст(Тексты.Текст("public.pool.add.title")));
	Добавление.Добавить(Тело(Пул, Токен, Набранное));
	Возврат Добавление.Рендер();

КонецФункции

#КонецОбласти

#Область Сборка

// В пул без публикации пакет не добавить: имя осталось бы пустым навсегда.
Функция Тело(Знач Пул, Знач Токен, Знач Набранное)

	Если НЕ Пулы.ПубликацияРазрешена(Пул) Тогда
		Возврат Кит.Примечание(Тексты.Текст("public.pool.add.blocked"));
	КонецЕсли;

	Тело = Кит.Холст();
	Тело.Добавить(Кит.Примечание(Тексты.Текст("public.pool.add.lead")));
	Тело.Добавить(ФормаИмени(Пул, Токен, Набранное));
	Возврат Тело;

КонецФункции

Функция ФормаИмени(Знач Пул, Знач Токен, Знач Набранное)

	Форма = Кит.Форма(Страницы.ПакетовПула(Пул.Имя), Токен, "столбик");
	Форма.Добавить(Кит.СкрытоеПоле("операция", "добавить"));
	Форма.Добавить(ПолеИмени(Набранное));
	Форма.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Тип, Иконка",
		Тексты.Текст("public.pool.add.button"), "основная", "отправка", "плюс")));
	Возврат Форма;

КонецФункции

Функция ПолеИмени(Знач Набранное)

	Модель = Новый Структура("Имя, Ид, Метка, Плейсхолдер, Подсказка, Обязательное, Автозаполнение",
		"имя", "add-package-name", Тексты.Текст("public.pool.add.name.label"), "my-package",
		Тексты.Текст("public.pool.add.name.hint"), Истина, "off");

	Если Набранное <> Неопределено Тогда
		Модель.Вставить("Значение", Набранное.Имя);
		Модель.Вставить("Ошибка", Набранное.Ошибка);
	КонецЕсли;

	Возврат Кит.Поле(Модель);

КонецФункции

#КонецОбласти

&Прозвище("ДобавлениеПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисПулов") _Пулы,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	Пулы = _Пулы;
	Страницы = _Страницы;

КонецПроцедуры
