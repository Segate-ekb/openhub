// Окно «Добавить пакет» страницы пула: одно поле имени, формат проверяется до отправки,
// занятость — запросом к списку пакетов пула. Добавленный пакет пуст — это резерв имени
// до первой публикации.

Перем Кит;       // Кит (кит) — фабрика элементов экрана
Перем Тексты;    // ТекстыИнтерфейса (кит) — пользовательские строки по ключам
Перем Пулы;      // СервисПулов (реестр) — принимает ли пул публикации
Перем Страницы;  // АдресаСтраниц (реестр) — куда уходит форма и где спросить занятость
Перем Правила;   // ПравилаИменования (реестр) — правило имени для проверки до отправки

#Область ПубличныйИнтерфейс

// Окно «Добавить пакет». Отбитая форма приезжает в открытом окне, с набранным именем
// и причиной у поля.
//
// Параметры:
//  Пул - Пул - пул страницы.
//  Набранное - Структура, Неопределено - отбитая форма: Имя, Ошибка; Неопределено — форму
//              ещё не отправляли.
//
// Возвращаемое значение:
//  ЭлементЭкрана - окно, напечатанное открытым; токен формы оно берёт у предков.
//
Функция Окно(Знач Пул, Знач Набранное) Экспорт

	// окно стоит по адресу страницы и печатается открытым: закрывается на страницу пула без окна
	Окно = Кит.Окно(Тексты.Текст("public.pool.add.title")).Якорь("add-package").Открыто()
		.АдресЗакрытия(Страницы.Пула(Пул.Имя));

	// в пул без публикации пакет не добавить: имя осталось бы пустым навсегда
	Если НЕ Пулы.ПубликацияРазрешена(Пул) Тогда
		Возврат Окно.Лид(Тексты.Текст("public.pool.add.blocked"));
	КонецЕсли;

	Окно.Добавить(Кит.СкрытоеПоле("операция", "добавить"));
	Окно.Добавить(ПолеИмени(Пул, Набранное));

	Возврат Окно.Лид(Тексты.Текст("public.pool.add.lead"))
		.Форма(Страницы.ПакетовПула(Пул.Имя)).БезПерезагрузки()
		.Действия(Кит.Кнопка(Тексты.Текст("public.pool.add.button")).Основная().Иконка("плюс"));

КонецФункции

#КонецОбласти

#Область Сборка

// Формат имени браузер проверяет до отправки; последнее слово за сервером.
Функция ПолеИмени(Знач Пул, Знач Набранное)

	Поле = Кит.Поле("имя", Тексты.Текст("public.pool.add.name.label")).Ид("add-package-name")
		.Обязательное().Шаблон(Правила.ОбразецИмени())
		.ПроверкаНаСервере(Страницы.ПакетовПула(Пул.Имя))
		.Подсказка(Тексты.Текст("public.pool.add.name.hint"))
		.Пример("my-package").Автозаполнение("off");

	Если Набранное <> Неопределено Тогда
		Поле.Значение(Набранное.Имя).Ошибка(Набранное.Ошибка);
	КонецЕсли;
	Возврат Поле;

КонецФункции

#КонецОбласти

&Прозвище("ДобавлениеПакета")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисПулов") _Пулы,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы,
	&Пластилин(Значение = "ПравилаИменования") _Правила) Экспорт

	Кит = _Кит;
	Тексты = _Тексты;
	Пулы = _Пулы;
	Страницы = _Страницы;
	Правила = _Правила;

КонецПроцедуры
