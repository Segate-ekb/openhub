// Страница пула, GET /pools/{pool}: шапка объекта и пакеты пула; с окном в запросе
// (?окно=добавить, ?окно=снять-<имя>) — страница с этим окном, напечатанным открытым.

Перем Страница;      // СтраницаПула
Перем Гвард;         // ГвардОнбординга
Перем Перехватчик;   // ПерехватчикАутентификации (вход)
Перем ЧтениеПула;    // ГвардДоступаКПулу (права)

// Отдаёт страницу пула. Приватный пул означает, что приватны все его пакеты, поэтому
// несуществующий и нечитаемый пул дают ОДИНАКОВЫЙ 404.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  pool             - Строка       - имя пула из пути.
//  ЗаголовкиЗапроса - Соответствие - для определения принципала.
//  КукиЗапроса      - Куки         - сессия и оформление читателя.
//  ПолныйПутьЗапроса - Строка      - путь текущего запроса с параметрами: по нему меню
//                     подсвечивает дорогу (личное пространство человека — это тоже страница
//                     пула), и на него же возвращает смена темы.
//  ПараметрыЗапросаИменные - Соответствие - параметры адреса; «окно» называет окно, которое
//                     страница печатает открытым; тому, кто не вправе им пользоваться,
//                     окно не печатается.
//
&ТочкаМаршрута("pools/{pool}")
Процедура Показать(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, ПолныйПутьЗапроса,
	ПараметрыЗапросаИменные) Экспорт

	Если НЕ Гвард.Проверить(Ответ).Разрешено Тогда
		Возврат;
	КонецЕсли;

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);

	Пул = ЧтениеПула.ЧитаемыйПул(Принципал.Пользователь, pool, Принципал);
	Если Пул = Неопределено Тогда
		Страница.ОтдатьПулНеНайден(Ответ, pool, Принципал, КукиЗапроса, ПолныйПутьЗапроса);
		Возврат;
	КонецЕсли;

	Окно = ?(ПараметрыЗапросаИменные = Неопределено, Неопределено,
		ПараметрыЗапросаИменные.Получить("окно"));
	Страница.Отдать(Ответ, Пул, Принципал, КукиЗапроса, ПолныйПутьЗапроса, Страница.ПоказСОкном(Окно));

КонецПроцедуры

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СтраницаПула") _Страница,
	&Пластилин(Значение = "ГвардОнбординга") _Гвард,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "ГвардДоступаКПулу") _ЧтениеПула)

	Страница = _Страница;
	Гвард = _Гвард;
	Перехватчик = _Перехватчик;
	ЧтениеПула = _ЧтениеПула;

КонецПроцедуры
