// Страница пула: шапка объекта и пакеты пула. Список пакетов — тот же каталог с отбором по пулу;
// мейнтейнеру пула — окно «Добавить пакет» из шапки и окно подтверждения снятия резерва.

Перем Каталог;       // КаталогПакетов
Перем Витрина;       // ВитринаПакетов
Перем КарточкиUI;    // КарточкаОбъекта
Перем Плашки;        // ПлашкиПула
Перем Каркас;        // КаркасСтраницы (кит) — корень страницы
Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем Тексты;        // ТекстыИнтерфейса (кит)
Перем СервисПрав;    // СервисПрав (права) — порог входа в дом настроек пула
Перем Резервы;       // СервисРезервированияИмён (публикация) — кто вправе добавлять пакеты
Перем Защита;        // ЗащитаCSRF (вход) — токен форм страницы
Перем Кэш;           // ЗаголовкиКэша (основа) — страница с формой не оседает в кэше
Перем АдресаПакетов; // АдресаКаталога — адрес каталога с отбором
Перем ПустойПул;     // ВитринаПустогоПула — пул, в котором нет пакетов
Перем ДомПула;       // ДомПула — адрес дома настроек пула
Перем Добавление;    // ДобавлениеПакета — окно «Добавить пакет»
Перем Снятие;        // СнятиеРезерва — окно подтверждения снятия резерва
Перем Страницы;      // АдресаСтраниц (реестр) — адреса окон страницы и их разбор

#Область ПубличныйИнтерфейс

// Состояние страницы без отправленной формы и без окна в адресе.
//
// Возвращаемое значение:
//  Структура - Набранное (Неопределено), Добавление (Ложь), Снятие (""), Неудача ("").
//
Функция ПервыйПоказ() Экспорт
	Возврат Новый Структура("Набранное, Добавление, Снятие, Неудача", Неопределено, Ложь, "", "");
КонецФункции

// Состояние страницы по окну, названному в адресе (разбор — АдресаСтраниц.ОкноСтраницыПула):
// окно «Добавить пакет» или подтверждение снятия резерва; незнакомое окна не открывает.
//
// Параметры:
//  Окно - Строка, Неопределено - значение параметра окна из запроса.
//
// Возвращаемое значение:
//  Структура - см. ПервыйПоказ.
//
Функция ПоказСОкном(Знач Окно) Экспорт

	Названное = Страницы.ОкноСтраницыПула(Окно);
	Состояние = ПервыйПоказ();
	Состояние.Добавление = Названное.Добавление;
	Состояние.Снятие = Названное.Снятие;
	Возврат Состояние;

КонецФункции

// Отдаёт страницу пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Пул - читаемый смотрящим пул.
//  Принципал - Структура - принципал запроса.
//  КукиЗапроса - Куки - сессия и оформление читателя.
//  ПутьЗапроса - Строка - путь страницы: по нему меню подсвечивает дорогу, на него
//                возвращает смена темы.
//  Состояние - Структура - см. ПервыйПоказ: Набранное — отбитая форма «Добавить пакет» (Имя,
//              Ошибка), Добавление — окно «Добавить пакет» названо в адресе, Снятие — имя
//              резерва, снятие которого ждёт подтверждения, Неудача — почему резерв не снят.
//  Статус - Число - код ответа (необязательный, по умолчанию 200).
//
Процедура Отдать(Ответ, Знач Пул, Знач Принципал, Знач КукиЗапроса, Знач ПутьЗапроса,
	Знач Состояние, Знач Статус = 200) Экспорт

	Пользователь = Принципал.Пользователь;
	Выдача = Каталог.НайтиПакеты("", 1, 0, Принципал,
		Новый Структура("Пул, ТолькоУправляемые", Пул.Имя, Ложь));
	Токен = ТокенФорм(Пул, Принципал);

	Содержимое = Кит.Холст(
		Шапка(Пул, Выдача.Всего, Пользователь, Токен),
		Кит.ЗаголовокСтраницы(Тексты.Текст("public.pool.packages.title")).Уровень(2),
		НеудачаСнятия(Токен, Состояние),
		СписокПакетов(Выдача, Пул, Пользователь),
		ОкноДобавления(Пул, Токен, Состояние),
		ПодтверждениеСнятия(Пул, Токен, Состояние));

	Если ЗначениеЗаполнено(Токен) Тогда
		Содержимое.Токен(Токен);
		Кэш.ЗакрытьСтраницу(Ответ);
	КонецЕсли;
	Ответ.УстановитьСостояние(Статус);
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Пул.Имя, Содержимое,
		Каркас.КонтекстСтраницы(Пользователь, КукиЗапроса, Ложь, Ложь, ПутьЗапроса, Принципал.Сессия));

КонецПроцедуры

// Отдаёт 404 пула. Несуществующий и нечитаемый пул звучат одинаково: иначе перебором имён
// аноним выяснял бы, какие приватные пулы существуют.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ИмяПула - Строка - имя пула из адреса.
//  Принципал - Структура - принципал запроса: Пользователь (Неопределено — гость) и Сессия.
//  КукиЗапроса - Куки - сессия и оформление читателя.
//  ПутьЗапроса - Строка - путь страницы: по нему меню подсвечивает дорогу, на него
//                возвращает смена темы.
//
Процедура ОтдатьПулНеНайден(Ответ, Знач ИмяПула, Знач Принципал, Знач КукиЗапроса,
	Знач ПутьЗапроса) Экспорт

	Ответ.УстановитьСостояниеНеНайдено();
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Тексты.Текст("settings.reply.notfound.title"),
		Кит.Холст(
			Кит.СтраницаОшибки(Новый Структура("Код, Сообщение", 404,
				Тексты.Шаблон("public.pool.notfound", ИмяПула))),
			Кит.Ссылка("/packages", Тексты.Текст("public.catalog.back"))),
		Каркас.КонтекстСтраницы(Принципал.Пользователь, КукиЗапроса, Ложь, Ложь, ПутьЗапроса,
			Принципал.Сессия));

КонецПроцедуры

#КонецОбласти

#Область Рендер

// Шапка пула: «Добавить пакет» мейнтейнеру, «Настройки пула» тому, кого пустит дом настроек.
Функция Шапка(Знач Пул, Знач ВсегоПакетов, Знач Пользователь, Знач Токен)

	Возврат Кит.ШапкаОбъекта(Плашки.ШапкаПула(Пул, ВсегоПакетов),
		КнопкаДобавления(Пул, Токен),
		КнопкаНастроек(Пул, Пользователь));

КонецФункции

// Окно приходит по адресу: без скрипта кнопка — ссылка на страницу с окном, открытым сервером.
Функция КнопкаДобавления(Знач Пул, Знач Токен)

	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.ОкноПоАдресу(Страницы.ДобавленияПакета(Пул.Имя), Тексты.Текст("public.pool.add.title"))
		.Основная().Иконка("плюс");

КонецФункции

Функция КнопкаНастроек(Знач Пул, Знач Пользователь)

	Если НЕ СервисПрав.МожетАдминистрировать(Пользователь, Пул) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Кнопка(Тексты.Текст("public.pool.settings")).Вторичная().Иконка("шестерёнка")
		.Адрес(ДомПула.БазовыйАдрес(Пул.Имя));

КонецФункции

// Окна печатаются тому, кто вправе добавлять пакеты, и только по сессии: без неё формы
// не отправить. Окно добавления стоит на странице, только когда его назвал адрес или
// вернулась отбитая форма.
Функция ОкноДобавления(Знач Пул, Знач Токен, Знач Состояние)

	Если НЕ ЗначениеЗаполнено(Токен)
		ИЛИ НЕ (Состояние.Добавление ИЛИ Состояние.Набранное <> Неопределено) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Добавление.Окно(Пул, Состояние.Набранное);

КонецФункции

// Спрашивают только о настоящем резерве: имя из адреса может быть чужим, занятым версиями
// или уже снятым.
Функция ПодтверждениеСнятия(Знач Пул, Знач Токен, Знач Состояние)

	Если НЕ ЗначениеЗаполнено(Токен) ИЛИ НЕ ЗначениеЗаполнено(Состояние.Снятие) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Резерв = Резервы.НайтиРезерв(Пул, Состояние.Снятие);
	Если Резерв = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Снятие.Подтверждение(Пул, Резерв.Имя);

КонецФункции

Функция НеудачаСнятия(Знач Токен, Знач Состояние)

	Если НЕ ЗначениеЗаполнено(Токен) ИЛИ НЕ ЗначениеЗаполнено(Состояние.Неудача) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Снятие.Неудача(Состояние.Неудача);

КонецФункции

Функция ТокенФорм(Знач Пул, Знач Принципал)

	Если Принципал.Сессия = Неопределено
		ИЛИ НЕ Резервы.ВправеРезервировать(Принципал.Пользователь, Пул) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Защита.ТокенСессии(Принципал.Сессия);

КонецФункции

Функция СписокПакетов(Знач Выдача, Знач Пул, Знач Пользователь)

	Если Выдача.Элементы.Количество() = 0 Тогда
		Возврат ПустойПул.Узел(Пул, Пользователь);
	КонецЕсли;

	Список = КарточкиUI.Список(Витрина.Карточки(Выдача.Элементы, Пользователь));
	Если Выдача.ВсегоСтраниц < 2 Тогда
		Возврат Список;
	КонецЕсли;

	Возврат Кит.Холст(Список,
		Кит.Кнопка(Тексты.Текст("public.pool.all-packages")).Вторичная().Иконка("вправо")
			.Адрес(АдресаПакетов.Каталог(Строка(Выдача.Отбор.Пул))));

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаталогПакетов") _Каталог,
	&Пластилин(Значение = "ВитринаПакетов") _Витрина,
	&Пластилин(Значение = "КарточкаОбъекта") _КарточкиUI,
	&Пластилин(Значение = "ПлашкиПула") _Плашки,
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисРезервированияИмён") _Резервы,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ЗаголовкиКэша") _Кэш,
	&Пластилин(Значение = "АдресаКаталога") _АдресаПакетов,
	&Пластилин(Значение = "ВитринаПустогоПула") _ПустойПул,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ДобавлениеПакета") _Добавление,
	&Пластилин(Значение = "СнятиеРезерва") _Снятие,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы)

	Каталог = _Каталог;
	Витрина = _Витрина;
	КарточкиUI = _КарточкиUI;
	Плашки = _Плашки;
	Каркас = _Каркас;
	Кит = _Кит;
	Тексты = _Тексты;
	СервисПрав = _СервисПрав;
	Резервы = _Резервы;
	Защита = _Защита;
	Кэш = _Кэш;
	АдресаПакетов = _АдресаПакетов;
	ПустойПул = _ПустойПул;
	ДомПула = _ДомПула;
	Добавление = _Добавление;
	Снятие = _Снятие;
	Страницы = _Страницы;

КонецПроцедуры
