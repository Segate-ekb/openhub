// Страница пула: шапка объекта и пакеты пула. Список пакетов — тот же каталог с отбором по пулу;
// над ним мейнтейнеру пула — «Добавить пакет» и шаг подтверждения снятия резерва.

Перем Каталог;       // КаталогПакетов
Перем Витрина;       // ВитринаПакетов
Перем КарточкиUI;    // КарточкаПакета
Перем Плашки;        // ПлашкиПула
Перем Каркас;        // КаркасСтраницы (кит) — корень страницы
Перем НаборUI;       // НаборКомпонентов (кит)
Перем Тексты;        // ТекстыИнтерфейса (кит)
Перем Экран;         // ЭкранированиеHTML (кит)
Перем СервисПрав;    // СервисПрав (права) — порог входа в дом настроек пула
Перем Резервы;       // СервисРезервированияИмён (публикация) — кто вправе добавлять пакеты
Перем Защита;        // ЗащитаCSRF (вход) — токен форм страницы
Перем Кэш;           // ЗаголовкиКэша (основа) — страница с формой не оседает в кэше
Перем АдресаПакетов; // АдресаКаталога — адрес каталога с отбором
Перем ПустойПул;     // ВитринаПустогоПула — пул, в котором нет пакетов
Перем ДомПула;       // ДомПула — адрес дома настроек пула
Перем Добавление;    // ДобавлениеПакета — форма «Добавить пакет»
Перем Снятие;        // СнятиеРезерва — шаг подтверждения снятия резерва

#Область ПубличныйИнтерфейс

// Состояние страницы без отправленной формы.
//
// Возвращаемое значение:
//  Структура - Набранное (Неопределено), Снятие (""), Неудача ("").
//
Функция ПервыйПоказ() Экспорт
	Возврат Новый Структура("Набранное, Снятие, Неудача", Неопределено, "", "");
КонецФункции

// Отдаёт страницу пула.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  Пул - Пул - читаемый смотрящим пул.
//  Принципал - Структура - принципал запроса.
//  КукиЗапроса - Куки - сессия и оформление читателя.
//  ПутьЗапроса - Строка - путь, по которому меню подсвечивает дорогу.
//  Состояние - Структура - см. ПервыйПоказ: Набранное — отбитая форма «Добавить пакет» (Имя,
//              Ошибка), Снятие — имя резерва, снятие которого ждёт подтверждения,
//              Неудача — почему резерв не снят.
//  Статус - Число - код ответа (необязательный, по умолчанию 200).
//
Процедура Отдать(Ответ, Знач Пул, Знач Принципал, Знач КукиЗапроса, Знач ПутьЗапроса,
	Знач Состояние, Знач Статус = 200) Экспорт

	Пользователь = Принципал.Пользователь;
	Выдача = Каталог.НайтиПакеты("", 1, 0, Принципал,
		Новый Структура("Пул, ТолькоУправляемые", Пул.Имя, Ложь));
	Токен = ТокенФорм(Пул, Принципал);

	Контент = Шапка(Пул, Выдача.Всего, Пользователь)
		+ НаборUI.ЗаголовокСтраницы().Отрисовать(Новый Структура("Заголовок, Уровень",
			Тексты.Текст("public.pool.packages.title"), 2))
		+ ДействияСписка(Пул, Токен, Состояние)
		+ СписокПакетов(Выдача, Пул, Пользователь);

	Если ЗначениеЗаполнено(Токен) Тогда
		Кэш.ЗакрытьСтраницу(Ответ);
	КонецЕсли;
	Ответ.УстановитьСостояние(Статус);
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Пул.Имя, Контент,
		Каркас.КонтекстСтраницы(Пользователь, КукиЗапроса, Ложь, Ложь, ПутьЗапроса));

КонецПроцедуры

// Отдаёт 404 пула. Несуществующий и нечитаемый пул звучат одинаково: иначе перебором имён
// аноним выяснял бы, какие приватные пулы существуют.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ИмяПула - Строка - имя пула из адреса.
//  Пользователь - Пользователь, Неопределено - смотрящий.
//  КукиЗапроса - Куки - сессия и оформление читателя.
//  ПутьЗапроса - Строка - путь, по которому меню подсвечивает дорогу.
//
Процедура ОтдатьПулНеНайден(Ответ, Знач ИмяПула, Знач Пользователь, Знач КукиЗапроса,
	Знач ПутьЗапроса) Экспорт

	ОтдатьНеНайдено(Ответ, Тексты.Шаблон("public.pool.notfound", ИмяПула), Пользователь,
		КукиЗапроса, ПутьЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Рендер

Функция Шапка(Знач Пул, Знач ВсегоПакетов, Знач Пользователь)

	Модель = Плашки.ШапкаПула(Пул, ВсегоПакетов);
	Модель.Вставить("Действия", ДействияШапки(Пул, Пользователь));

	Возврат НаборUI.ШапкаОбъекта().Отрисовать(Модель);

КонецФункции

// Кнопка видна только тому, кого дом настроек пула действительно пустит.
Функция ДействияШапки(Знач Пул, Знач Пользователь)

	Если НЕ СервисПрав.МожетАдминистрировать(Пользователь, Пул) Тогда
		Возврат "";
	КонецЕсли;

	Возврат НаборUI.Кнопка().Отрисовать(
		Новый Структура("Подпись, Адрес, Вариант, Иконка",
			Тексты.Текст("public.pool.settings"), ДомПула.БазовыйАдрес(Пул.Имя),
			"вторичная", "шестерёнка"));

КонецФункции

// Формы списка печатаются тому, кто вправе добавлять пакеты, и только по сессии: без неё
// формы не отправить.
Функция ДействияСписка(Знач Пул, Знач Токен, Знач Состояние)

	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		Возврат "";
	КонецЕсли;

	Действия = "";
	Если ЗначениеЗаполнено(Состояние.Неудача) Тогда
		Действия = Действия + Снятие.Неудача(Состояние.Неудача);
	КонецЕсли;
	Действия = Действия + ВопросОСнятии(Пул, Состояние.Снятие, Токен);
	Возврат Действия + Добавление.Разметка(Пул, Токен, Состояние.Набранное);

КонецФункции

// Спрашивают только о настоящем резерве: имя из адреса может быть чужим, занятым версиями
// или уже снятым.
Функция ВопросОСнятии(Знач Пул, Знач ИмяПакета, Знач Токен)

	Резерв = Резервы.НайтиРезерв(Пул, ИмяПакета);
	Если Резерв = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Снятие.Вопрос(Пул, Резерв.Имя, Токен);

КонецФункции

Функция ТокенФорм(Знач Пул, Знач Принципал)

	Если Принципал.Сессия = Неопределено
		ИЛИ НЕ Резервы.ВправеРезервировать(Принципал.Пользователь, Пул) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Защита.ТокенСессии(Принципал.Сессия);

КонецФункции

Функция СписокПакетов(Знач Выдача, Знач Пул, Знач Пользователь)

	Если Выдача.Элементы.Количество() = 0 Тогда
		Возврат ПустойПул.Разметка(Пул, Пользователь);
	КонецЕсли;

	Список = КарточкиUI.Список(Витрина.Карточки(Выдача.Элементы, Пользователь)).Рендер();

	Если Выдача.ВсегоСтраниц > 1 Тогда
		Список = Список + НаборUI.Кнопка().Отрисовать(
			Новый Структура("Подпись, Адрес, Вариант, Иконка",
				Тексты.Текст("public.pool.all-packages"),
				АдресаПакетов.Каталог(Строка(Выдача.Отбор.Пул)), "вторичная", "вправо"));
	КонецЕсли;

	Возврат Список;

КонецФункции

// Сообщение приходит СЫРЫМ, экранирует получатель — общий контракт одноимённых процедур слоя.
Процедура ОтдатьНеНайдено(Ответ, Знач Сообщение, Знач Пользователь, Знач КукиЗапроса,
	Знач ПутьЭкрана)
	Ответ.УстановитьСостояниеНеНайдено();
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Тексты.Текст("settings.reply.notfound.title"),
		НаборUI.СтраницаОшибки().Отрисовать(
			Новый Структура("Код, Сообщение", 404, Сообщение))
			+ Экран.Ссылка("/packages", Тексты.Текст("public.catalog.back")),
		Каркас.КонтекстСтраницы(Пользователь, КукиЗапроса, Ложь, Ложь, ПутьЭкрана));
КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаталогПакетов") _Каталог,
	&Пластилин(Значение = "ВитринаПакетов") _Витрина,
	&Пластилин(Значение = "КарточкаПакета") _КарточкиUI,
	&Пластилин(Значение = "ПлашкиПула") _Плашки,
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "НаборКомпонентов") _НаборUI,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "СервисПрав") _СервисПрав,
	&Пластилин(Значение = "СервисРезервированияИмён") _Резервы,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "ЗаголовкиКэша") _Кэш,
	&Пластилин(Значение = "АдресаКаталога") _АдресаПакетов,
	&Пластилин(Значение = "ВитринаПустогоПула") _ПустойПул,
	&Пластилин(Значение = "ДомПула") _ДомПула,
	&Пластилин(Значение = "ДобавлениеПакета") _Добавление,
	&Пластилин(Значение = "СнятиеРезерва") _Снятие)

	Каталог = _Каталог;
	Витрина = _Витрина;
	КарточкиUI = _КарточкиUI;
	Плашки = _Плашки;
	Каркас = _Каркас;
	НаборUI = _НаборUI;
	Тексты = _Тексты;
	Экран = _Экран;
	СервисПрав = _СервисПрав;
	Резервы = _Резервы;
	Защита = _Защита;
	Кэш = _Кэш;
	АдресаПакетов = _АдресаПакетов;
	ПустойПул = _ПустойПул;
	ДомПула = _ДомПула;
	Добавление = _Добавление;
	Снятие = _Снятие;

КонецПроцедуры
