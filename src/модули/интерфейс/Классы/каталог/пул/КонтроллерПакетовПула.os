// Формы списка пакетов пула, POST /pools/{pool}/packages: «Добавить пакет» заводит пакет без
// версий и ведёт на его страницу, «Снять резерв» удаляет пустой пакет после подтверждения.

Перем Страница;      // СтраницаПула — отбитая форма возвращается страницей пула
Перем ГвардКабинета; // ГвардКабинета — форма списка только для вошедшего
Перем ЧтениеПула;    // ГвардДоступаКПулу (права)
Перем Гейт;          // ГейтФормы — метод запроса и токен формы
Перем РазборФормы;   // РазборФормы — поля отправленной формы
Перем Резервы;       // СервисРезервированияИмён (публикация) — заведение и снятие, порог права
Перем Ответы;        // ОтветыНастроек — отказ по праву
Перем Страницы;      // АдресаСтраниц (реестр) — куда уводит удавшаяся форма
Перем Тексты;        // ТекстыИнтерфейса (кит)

// Принимает форму списка пакетов пула.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  pool             - Строка       - имя пула из пути.
//  ЗаголовкиЗапроса - Соответствие - заголовки HTTP-запроса.
//  КукиЗапроса      - Куки         - куки запроса.
//  МетодЗапроса     - Строка       - метод HTTP-запроса.
//  ТелоЗапроса      - Строка       - тело POST-запроса.
//
&ТочкаМаршрута("pools/{pool}/packages")
Процедура Принять(Ответ, pool, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса, ТелоЗапроса) Экспорт

	Вердикт = ГвардКабинета.Проверить(Ответ, ЗаголовкиЗапроса, КукиЗапроса);
	Если НЕ Вердикт.Разрешено Тогда
		Возврат;
	КонецЕсли;

	Путь = Страницы.Пула(pool);
	Пул = ЧтениеПула.ЧитаемыйПул(Вердикт.Пользователь, pool, Вердикт.Принципал);
	Если Пул = Неопределено Тогда
		Страница.ОтдатьПулНеНайден(Ответ, pool, Вердикт.Пользователь, КукиЗапроса, Путь);
		Возврат;
	КонецЕсли;

	Форма = Гейт.ПринятаяФорма(Ответ, Вердикт, "POST", МетодЗапроса, ТелоЗапроса, КукиЗапроса);
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// подделанная форма не доходит до разбора: решает тот же порог, что прячет кнопки
	Если НЕ Резервы.ВправеРезервировать(Вердикт.Пользователь, Пул) Тогда
		Ответы.ОтдатьЗапрещено(Ответ, Вердикт.Пользователь,
			Тексты.Шаблон("public.pool.add.forbidden", Пул.Имя), КукиЗапроса);
		Возврат;
	КонецЕсли;

	Операция = НРег(СокрЛП(РазборФормы.Поле(Форма, "операция")));
	Если Операция = "добавить" Тогда
		Добавить(Ответ, Вердикт, Пул, Форма, КукиЗапроса, Путь);
	ИначеЕсли Операция = "снять" Тогда
		Снять(Ответ, Вердикт, Пул, Форма, КукиЗапроса, Путь);
	Иначе
		// белый список операций: неизвестная не должна попадать в чужую ветку
		ОтдатьНеудачу(Ответ, Вердикт, Пул, КукиЗапроса, Путь,
			Тексты.Текст("public.pool.packages.error.operation"), 400);
	КонецЕсли;

КонецПроцедуры

#Область Операции

// Добавленный пакет пуст: дальше мейнтейнер работает на его странице.
Процедура Добавить(Ответ, Знач Вердикт, Знач Пул, Знач Форма, Знач КукиЗапроса, Знач Путь)

	Имя = СокрЛП(РазборФормы.Поле(Форма, "имя"));
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		ОтдатьНабранное(Ответ, Вердикт, Пул, КукиЗапроса, Путь, Имя,
			Тексты.Текст("public.pool.add.error.empty"), 400);
		Возврат;
	КонецЕсли;

	Итог = Резервы.Зарезервировать(Вердикт.Принципал, Пул, Имя);
	Если Итог.Успех Тогда
		Ответ.Перенаправить(Страницы.Пакета(Пул.Имя, Итог.Пакет.Имя));
	ИначеЕсли ОтказПоПраву(Итог) Тогда
		Ответы.ОтдатьЗапрещено(Ответ, Вердикт.Пользователь, Итог.Сообщение, КукиЗапроса);
	Иначе
		ОтдатьНабранное(Ответ, Вердикт, Пул, КукиЗапроса, Путь, Имя, Итог.Сообщение, Итог.Код);
	КонецЕсли;

КонецПроцедуры

// Первый POST только спрашивает; подтверждение повторяет имя, поэтому соседний резерв не снимается.
Процедура Снять(Ответ, Знач Вердикт, Знач Пул, Знач Форма, Знач КукиЗапроса, Знач Путь)

	Имя = СокрЛП(РазборФормы.Поле(Форма, "имя"));
	Если СокрЛП(РазборФормы.Поле(Форма, "подтверждение")) <> Имя ИЛИ НЕ ЗначениеЗаполнено(Имя) Тогда
		Состояние = Страница.ПервыйПоказ();
		Состояние.Снятие = Имя;
		Страница.Отдать(Ответ, Пул, Вердикт.Принципал, КукиЗапроса, Путь, Состояние);
		Возврат;
	КонецЕсли;

	Итог = Резервы.СнятьРезерв(Вердикт.Принципал, Пул, Имя);
	Если Итог.Успех Тогда
		Ответ.Перенаправить(Путь);
	ИначеЕсли ОтказПоПраву(Итог) Тогда
		Ответы.ОтдатьЗапрещено(Ответ, Вердикт.Пользователь, Итог.Сообщение, КукиЗапроса);
	Иначе
		ОтдатьНеудачу(Ответ, Вердикт, Пул, КукиЗапроса, Путь, Итог.Сообщение, Итог.Код);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Ответы

Функция ОтказПоПраву(Знач Итог)
	Возврат Итог.Код = 401 ИЛИ Итог.Код = 403;
КонецФункции

// Отбитая форма «Добавить пакет» возвращается раскрытой, с набранным и причиной у поля.
Процедура ОтдатьНабранное(Ответ, Знач Вердикт, Знач Пул, Знач КукиЗапроса, Знач Путь, Знач Имя,
	Знач Ошибка, Знач Статус)

	Состояние = Страница.ПервыйПоказ();
	Состояние.Набранное = Новый Структура("Имя, Ошибка", Имя, Ошибка);
	Страница.Отдать(Ответ, Пул, Вердикт.Принципал, КукиЗапроса, Путь, Состояние, Статус);

КонецПроцедуры

Процедура ОтдатьНеудачу(Ответ, Знач Вердикт, Знач Пул, Знач КукиЗапроса, Знач Путь, Знач Причина,
	Знач Статус)

	Состояние = Страница.ПервыйПоказ();
	Состояние.Неудача = Причина;
	Страница.Отдать(Ответ, Пул, Вердикт.Принципал, КукиЗапроса, Путь, Состояние, Статус);

КонецПроцедуры

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СтраницаПула") _Страница,
	&Пластилин(Значение = "ГвардКабинета") _ГвардКабинета,
	&Пластилин(Значение = "ГвардДоступаКПулу") _ЧтениеПула,
	&Пластилин(Значение = "ГейтФормы") _Гейт,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "СервисРезервированияИмён") _Резервы,
	&Пластилин(Значение = "ОтветыНастроек") _Ответы,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты)

	Страница = _Страница;
	ГвардКабинета = _ГвардКабинета;
	ЧтениеПула = _ЧтениеПула;
	Гейт = _Гейт;
	РазборФормы = _РазборФормы;
	Резервы = _Резервы;
	Ответы = _Ответы;
	Страницы = _Страницы;
	Тексты = _Тексты;

КонецПроцедуры
