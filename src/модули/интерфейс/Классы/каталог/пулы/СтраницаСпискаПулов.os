// Список пулов, видимых посетителю: таблица (на телефоне — карточки) с типом, видимостью,
// числом пакетов и источниками каждого пула. Пул, которого посетителю не видно, не упомянут;
// личное пространство перечислено тому, кто вправе его настраивать, — владельцу и
// администратору хаба. У пула, который посетитель вправе настраивать, — меню ⚙.

Перем ЧтениеПула;  // ГвардДоступаКПулу (права) — те же пулы, что видят каталог и API
Перем Права;       // СервисПрав (права) — кто вправе настраивать пул, тем же правилом, что дом пула
Перем Пакеты;      // СервисПакетов (реестр) — число нескрытых пакетов по пулам
Перем Плашки;      // ПлашкиПула — подписи пула, те же, что на его странице
Перем Страницы;    // АдресаСтраниц (реестр) — страница пула и его настройки
Перем ВходВХаб;    // ВозвратПослеВхода (вход) — вход с возвратом на список
Перем Кит;         // Кит (кит) — фабрика элементов экрана
Перем Тексты;      // ТекстыИнтерфейса (кит)

#Область ПубличныйИнтерфейс

// Содержимое страницы пулов.
//
// Параметры:
//  Принципал - Структура - принципал запроса; гость — без пользователя.
//  Страница - Число - номер страницы списка с 1; больше последней читается последней.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Содержимое(Знач Принципал, Знач Страница) Экспорт

	Читаемые = ЧтениеПула.ЧитаемыеПулы(Принципал);
	Настраиваемые = Настраиваемые(Читаемые, Принципал.Пользователь);

	Видимые = ПоПорядку(Перечисляемые(Читаемые, Настраиваемые));
	ВсегоСтраниц = Макс(1, Цел((Видимые.Количество() + РазмерСтраницы() - 1) / РазмерСтраницы()));
	Текущая = Мин(Макс(1, Страница), ВсегоСтраниц);

	Возврат Кит.Холст(
		Кит.ЗаголовокСтраницы(Тексты.Текст("public.pools.title"))
			.Пояснение(Тексты.Текст("public.pools.lead")),
		Таблица(Срез(Видимые, Текущая), Настраиваемые, Принципал.Пользователь = Неопределено),
		Кит.Пагинация(Адрес(), Текущая, ВсегоСтраниц).БезПерезагрузки());

КонецФункции

// Адрес списка пулов.
//
// Возвращаемое значение:
//  Строка - путь от корня хаба, без параметров.
//
Функция Адрес() Экспорт
	Возврат "/pools";
КонецФункции

#КонецОбласти

#Область Таблица

// Колонка меню стоит, только если на странице есть что настраивать: гостю и постороннему
// таблица прежняя.
Функция Таблица(Знач Пулы, Знач Настраиваемые, Знач Гость)

	Результат = Кит.Таблица(Строки(Пулы, Настраиваемые)).Вид("карточками").Пустое("—")
		.Пусто(Пустота(Гость));
	Результат.Колонка("name", Тексты.Текст("public.pools.column.name")).Заглавная();
	Результат.Колонка("kind", Тексты.Текст("public.pools.column.kind"));
	Результат.Колонка("visibility", Тексты.Текст("public.pools.column.visibility"));
	Результат.Колонка("packages", Тексты.Текст("public.pools.column.packages")).Вид("число");
	Результат.Колонка("sources", Тексты.Текст("public.pools.column.sources"));
	Если ЕстьНастраиваемый(Пулы, Настраиваемые) Тогда
		Результат.Колонка("menu", "").Вид("узкая");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Числа пакетов и источники спрашиваются разом на всю страницу, а не на строку. Ячейка меню
// без меню — пустой узел, а не пустое значение: прочерк таблицы встал бы в карточку лишней строкой.
Функция Строки(Знач Пулы, Знач Настраиваемые)

	ПакетовВПуле = Пакеты.КоличествоВидимыхПакетовПоПулам(Идентификаторы(Пулы));
	ИсточникиПулов = Плашки.ИсточникиПулов(Пулы);

	Результат = Новый Массив();
	Для Каждого Пул Из Пулы Цикл
		Ключ = Цел(Пул.Идентификатор);
		Результат.Добавить(Новый Структура("name, kind, visibility, packages, sources, menu",
			Кит.Ссылка(Страницы.Пула(Пул.Имя), Пул.Имя),
			ТипПула(Пул),
			Кит.Плашка(Плашки.ПлашкаВидимости(Пул)),
			?(ПакетовВПуле.Получить(Ключ) = Неопределено, 0, ПакетовВПуле.Получить(Ключ)),
			Источники(ИсточникиПулов.Получить(Ключ)),
			?(Настраиваемые.Получить(Ключ) = Неопределено, Кит.Ничего(), МенюПула(Пул))));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Основной и незнакомый тип названы плашками страницы пула; обычный пул и личное
// пространство — словом.
Функция ТипПула(Знач Пул)

	Если Пул.ЭтоЛичный() Тогда
		Возврат Тексты.Текст("public.pools.kind.personal");
	КонецЕсли;

	Плашка = Плашки.ПлашкаОсновного(Пул);
	Если Плашка = Неопределено Тогда
		Плашка = Плашки.ПлашкаТипа(Пул);
	КонецЕсли;
	Если Плашка = Неопределено Тогда
		Возврат Тексты.Текст("public.pools.kind.project");
	КонецЕсли;
	Возврат Кит.Плашка(Плашка);

КонецФункции

// Пул без источников остаётся с прочерком таблицы.
Функция Источники(Знач Модели)

	Если Модели = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Ряд = Кит.Холст();
	Для Каждого Модель Из Модели Цикл
		Ряд.Добавить(Кит.Плашка(Модель));
	КонецЦикла;
	Возврат Ряд;

КонецФункции

// Меню строки называет свой пул: скринридер не прочтёт двадцать одинаковых кнопок.
Функция МенюПула(Знач Пул)

	Возврат Кит.Меню(Тексты.Шаблон("public.pools.menu.title", Строка(Пул.Имя)),
		Кит.ПунктМеню(Тексты.Текст("public.pools.action.settings"), Страницы.НастроекПула(Пул.Имя))
			.Иконка("шестерёнка"),
		Кит.ПунктМеню(Тексты.Текст("public.pools.action.packages"), Страницы.Пула(Пул.Имя))
			.Иконка("пакет"));

КонецФункции

// Гостю пустота предлагает войти: приватные пулы видны участникам.
Функция Пустота(Знач Гость)

	Если НЕ Гость Тогда
		Возврат Кит.ПустоеСостояние(Тексты.Текст("public.pools.empty.lead"))
			.Заголовок(Тексты.Текст("public.pools.empty.title")).Иконка("куб");
	КонецЕсли;

	Возврат Кит.ПустоеСостояние(Тексты.Текст("public.pools.empty.guest.lead"))
		.Заголовок(Тексты.Текст("public.pools.empty.guest.title")).Иконка("куб")
		.Действие(Кит.Кнопка(Тексты.Текст("public.pools.empty.login")).Основная().Иконка("аккаунт")
			.Адрес(ВходВХаб.АдресВхода(Адрес())));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Пулы, которые посетитель вправе настраивать, — правилом дома пула, по одному снимку прав
// на страницу: идентификатор пула -> Истина. Гостю настраивать нечего.
Функция Настраиваемые(Знач Пулы, Знач Пользователь)

	Результат = Новый Соответствие();
	Если Пользователь = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Снимок = Права.СнимокПрав(Пользователь);
	Для Каждого Пул Из Пулы Цикл
		Если Права.МожетАдминистрировать(Пользователь, Пул, Снимок) Тогда
			Результат.Вставить(Цел(Пул.Идентификатор), Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Личных пространств столько же, сколько учёток: в списке только те, что посетитель настраивает.
Функция Перечисляемые(Знач Пулы, Знач Настраиваемые)

	Результат = Новый Массив();
	Для Каждого Пул Из Пулы Цикл
		Если НЕ Пул.ЭтоЛичный() ИЛИ Настраиваемые.Получить(Цел(Пул.Идентификатор)) <> Неопределено Тогда
			Результат.Добавить(Пул);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЕстьНастраиваемый(Знач Пулы, Знач Настраиваемые)

	Для Каждого Пул Из Пулы Цикл
		Если Настраиваемые.Получить(Цел(Пул.Идентификатор)) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Основной пул первым, за ним пулы хаба по имени, личные пространства — последними, по имени.
Функция ПоПорядку(Знач Пулы)

	Список = Новый СписокЗначений();
	Для Каждого Пул Из Пулы Цикл
		Список.Добавить(Пул, РазрядПорядка(Пул) + НРег(Строка(Пул.Имя)));
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	Возврат Список.ВыгрузитьЗначения();

КонецФункции

Функция РазрядПорядка(Знач Пул)

	Если Пул.ЭтоДефолтный() Тогда
		Возврат "0";
	ИначеЕсли Пул.ЭтоЛичный() Тогда
		Возврат "2";
	КонецЕсли;
	Возврат "1";

КонецФункции

Функция Срез(Знач Пулы, Знач Страница)

	Результат = Новый Массив();
	Начало = (Страница - 1) * РазмерСтраницы();
	Для Номер = Начало По Мин(Пулы.Количество(), Начало + РазмерСтраницы()) - 1 Цикл
		Результат.Добавить(Пулы[Номер]);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Идентификаторы(Знач Пулы)
	Результат = Новый Массив();
	Для Каждого Пул Из Пулы Цикл
		Результат.Добавить(Цел(Пул.Идентификатор));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Столько же, сколько у каталога пакетов на странице.
Функция РазмерСтраницы()
	Возврат 20;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ГвардДоступаКПулу") _ЧтениеПула,
	&Пластилин(Значение = "СервисПакетов") _Пакеты,
	&Пластилин(Значение = "ПлашкиПула") _Плашки,
	&Пластилин(Значение = "АдресаСтраниц") _Страницы,
	&Пластилин(Значение = "ВозвратПослеВхода") _ВходВХаб,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "СервисПрав") _Права)

	ЧтениеПула = _ЧтениеПула;
	Пакеты = _Пакеты;
	Плашки = _Плашки;
	Страницы = _Страницы;
	ВходВХаб = _ВходВХаб;
	Кит = _Кит;
	Тексты = _Тексты;
	Права = _Права;

КонецПроцедуры
