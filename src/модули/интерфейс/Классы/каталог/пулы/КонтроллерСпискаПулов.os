// Список пулов, GET /pools: пулы, которые видит посетитель, — гостю публичные, вошедшему ещё
// и приватные, в которых он участник, и личные пространства, которые он настраивает.

Перем Страница;     // СтраницаСпискаПулов
Перем Каркас;       // КаркасСтраницы (кит) — корень страницы
Перем Тексты;       // ТекстыИнтерфейса (кит)
Перем Гвард;        // ГвардОнбординга
Перем Перехватчик;  // ПерехватчикАутентификации (вход)
Перем Числа;        // ПриведениеЧисел (основа) — терпимое чтение номера страницы

// Отдаёт список пулов.
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  ЗаголовкиЗапроса - Соответствие - для определения принципала.
//  КукиЗапроса      - Куки         - сессия и оформление читателя.
//  ПолныйПутьЗапроса - Строка      - путь запроса с параметрами: по нему меню подсвечивает
//                     дорогу «Пулы», а смена темы возвращает на ту же страницу списка.
//  page             - Строка       - (необязательный, по умолчанию "") номер страницы списка.
//
&ТочкаМаршрута("pools")
Процедура Показать(Ответ, ЗаголовкиЗапроса, КукиЗапроса, ПолныйПутьЗапроса, page = "") Экспорт

	Если НЕ Гвард.Проверить(Ответ).Разрешено Тогда
		Возврат;
	КонецЕсли;

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);
	Содержимое = Страница.Содержимое(Принципал, Макс(1, Цел(Числа.ЧислоИлиДефолт(page, 1))));

	Ответ.УстановитьСостояниеОК();
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Тексты.Текст("public.pools.title"), Содержимое,
		Каркас.КонтекстСтраницы(Принципал.Пользователь, КукиЗапроса, Ложь, Ложь, ПолныйПутьЗапроса,
			Принципал.Сессия));

КонецПроцедуры

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СтраницаСпискаПулов") _Страница,
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ГвардОнбординга") _Гвард,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "ПриведениеЧисел") _Числа = Неопределено)

	Страница = _Страница;
	Каркас = _Каркас;
	Тексты = _Тексты;
	Гвард = _Гвард;
	Перехватчик = _Перехватчик;
	Числа = ?(_Числа = Неопределено, Новый ПриведениеЧисел(), _Числа);

КонецПроцедуры
