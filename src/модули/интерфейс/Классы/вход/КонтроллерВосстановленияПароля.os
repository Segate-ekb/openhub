// Публичная страница /forgot-password: человек называет логин или адрес, хаб шлёт письмо
// со ссылкой установки пароля. Ответ на POST один и тот же, нашлась учётка или нет.

Перем Восстановление; // ВосстановлениеПароля (auth)
Перем Ограничитель;   // ОграничительВхода (auth) — подбор ссылки и рассылка с одного узла
Перем Страница;       // СтраницаДоступа (web-ui) — каркас публичного экрана
Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем Тексты;         // ТекстыИнтерфейса (кит)
Перем РазборФормы;    // РазборФормы (web-ui)
Перем HTTP;           // МетодыHTTP (основа)

#Область ТочкиМаршрута

// GET /forgot-password — форма запроса ссылки, POST — сам запрос.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow: HTML-страница.
//  ТелоЗапроса - Строка - тело POST-формы: логин или адрес.
//  КукиЗапроса - Куки - куки запроса (оформление).
//  МетодЗапроса - Строка - HTTP-метод; кроме GET и POST — 405.
//  АдресУдаленногоУзла - Строка - адрес клиента: журнал, потолок писем и ограничитель.
//
&ТочкаМаршрута("forgot-password")
Процедура ЗабытыйПароль(Ответ, ТелоЗапроса, КукиЗапроса, МетодЗапроса,
	АдресУдаленногоУзла) Экспорт

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьФорму(Ответ, "", "", 200, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответ.Заголовки["Allow"] = "GET, POST";
		ОтдатьСообщение(Ответ, Тексты.Текст("recover.page.method"), "err", 405, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Источник = СокрЛП(Строка(АдресУдаленногоУзла));
	Ключ = КлючОграничителя(Источник);
	Если НЕ Ограничитель.РазрешёнЛи(Ключ) Тогда
		ОтдатьСообщение(Ответ, Тексты.Текст("recover.page.throttled"), "err", 429, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если НЕ Восстановление.Доступно() Тогда
		ОтдатьСообщение(Ответ, Тексты.Текст("recover.page.unavailable"), "warn", 503,
			КукиЗапроса);
		Возврат;
	КонецЕсли;

	Названное = РазборФормы.Поле(Форма(ТелоЗапроса), ИмяПоля());
	Восстановление.Запросить(Названное, Неопределено, Источник);

	// каждый запрос — попытка: счётчик один и тот же на весь узел, поэтому массовый
	// перебор логинов и адресов упирается в тот же замок, что и подбор пароля
	Ограничитель.ЗафиксироватьНеудачу(Ключ);

	ОтдатьСообщение(Ответ, Тексты.Текст("recover.page.done"), "ok", 200, КукиЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьФорму(Ответ, Знач Названное, Знач Ошибка, Знач Статус, Знач КукиЗапроса)

	Если НЕ Восстановление.Доступно() Тогда
		ОтдатьСообщение(Ответ, Тексты.Текст("recover.page.unavailable"), "warn", 503,
			КукиЗапроса);
		Возврат;
	КонецЕсли;

	Тело = ТелоСтраницы();
	Тело.Добавить(Кит.Примечание(Тексты.Текст("recover.page.lead")));
	Тело.Добавить(Страница.Уведомление(Ошибка, "err"));
	Тело.Добавить(ФормаЗапроса(Названное));
	Тело.Добавить(Страница.СноскаВхода());

	Страница.Отдать(Ответ, Статус, Заголовок(), Тело, КукиЗапроса);

КонецПроцедуры

Процедура ОтдатьСообщение(Ответ, Знач Сообщение, Знач Вид, Знач Статус, Знач КукиЗапроса)

	Тело = ТелоСтраницы();
	Тело.Добавить(Страница.Уведомление(Сообщение, Вид));
	Тело.Добавить(Страница.СноскаВхода());

	Страница.Отдать(Ответ, Статус, Заголовок(), Тело, КукиЗапроса);

КонецПроцедуры

// Заголовок стоит на каждой выдаче страницы, поэтому тело начинается с него.
Функция ТелоСтраницы()

	Результат = Кит.Холст();
	Результат.Добавить(Страница.Заголовок(Заголовок()));
	Возврат Результат;

КонецФункции

Функция ФормаЗапроса(Знач Названное)

	Результат = Кит.ФормаБезСессии(Путь(), "столбик");
	Результат.Добавить(ПолеУчётки(Названное));
	Результат.Добавить(Страница.КнопкаФормы(Тексты.Текст("recover.page.button")));

	Возврат Результат;

КонецФункции

Функция ПолеУчётки(Знач Названное)

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Значение, Автозаполнение",
		ИмяПоля(), Тексты.Текст("recover.page.field"), Названное, "username"));

КонецФункции

Функция Заголовок()
	Возврат Тексты.Текст("recover.page.title");
КонецФункции

#КонецОбласти

#Область Служебное

// Путь публичной страницы восстановления — один литерал маршрута на весь хаб.
//
// Возвращаемое значение:
//  Строка.
//
Функция Путь() Экспорт
	Возврат "/forgot-password";
КонецФункции

Функция ИмяПоля()
	Возврат "учётка";
КонецФункции

// Ключ свой, а не общий с входом: замок на восстановлении не запирает вход по паролю.
Функция КлючОграничителя(Знач Источник)
	Возврат "восстановление:" + ?(ЗначениеЗаполнено(Источник), Источник, "неизвестный");
КонецФункции

Функция Форма(Знач ТелоЗапроса)
	Возврат РазборФормы.Разобрать(ТелоЗапроса);
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВосстановлениеПароля") _Восстановление,
	&Пластилин(Значение = "ОграничительВхода") _Ограничитель,
	&Пластилин(Значение = "СтраницаДоступа") _Страница,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "МетодыHTTP") _HTTP)

	Восстановление = _Восстановление;
	Ограничитель = _Ограничитель;
	Страница = _Страница;
	Кит = _Кит;
	Тексты = _Тексты;
	РазборФормы = _РазборФормы;
	HTTP = _HTTP;

КонецПроцедуры
