// Контроллер веб-регистрации — web-ui: HTML-форма /register поверх СервисРегистрации.
// В закрытых режимах (invite, disabled) формы нет вовсе, чтобы не показывать ложную.

Перем СервисРегистрации;  // СервисРегистрации (auth)
Перем ГейтАдреса;         // ГейтПодтвержденияАдреса (auth) — нужен ли подтверждённый адрес
Перем СлужбаСессий;       // СлужбаСессий (auth)
Перем КукаСессии;         // КукиСессии (вход) — имя и атрибуты сессионной куки
Перем Страница;           // СтраницаДоступа (web-ui) — каркас публичного экрана
Перем Кит;                // Кит (кит) — фабрика элементов экрана
Перем Подсказка;          // ПодсказкаПароля (web-ui)
Перем РазборФормы;        // РазборФормы (web-ui)
Перем HTTP;               // МетодыHTTP (основа)
Перем ВозвратВхода;       // ВозвратПослеВхода (основа)

// Отдаёт форму регистрации (GET) либо регистрирует пользователя и открывает сессию (POST).
//
// Параметры:
//  Ответ            - ОтветСервера - ответ winow.
//  ТелоЗапроса      - Строка       - тело POST-формы.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса      - Куки         - оформление читателя.
//  МетодЗапроса     - Строка       - HTTP-метод; кроме GET и POST — 405.
//  АдресУдаленногоУзла - Строка   - адрес клиента: по нему хаб считает суточный потолок
//                     писем подтверждения с одного источника.
//  next             - Строка       - куда вернуть после регистрации; принимается только
//                     путь этого хаба (необязательный, по умолчанию "").
//
&ТочкаМаршрута("register")
Процедура Регистрация(Ответ, ТелоЗапроса, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	АдресУдаленногоУзла, next = "") Экспорт

	Режим = РежимЭкрана();
	Возврат_ = Строка(next);

	// пока нет администратора, регистрация закрыта: иначе аноним перехватил бы первый запуск
	Если СервисРегистрации.ЗаблокированаОнбордингом() Тогда
		Ответ.Перенаправить("/setup");
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьСтраницу(Ответ, Режим, "", 200, КукиЗапроса, Возврат_);
		Возврат;
	КонецЕсли;

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответ.Заголовки["Allow"] = "GET, POST";
		ОтдатьСтраницу(Ответ, Режим, "Разрешены методы GET, POST", 405, КукиЗапроса, Возврат_);
		Возврат;
	КонецЕсли;

	Форма = РазборФормы.Разобрать(ТелоЗапроса);
	Возврат_ = РазборФормы.Поле(Форма, ВозвратВхода.ИмяПараметра(), Возврат_);

	Если Режим <> "open" Тогда
		ОтдатьСтраницу(Ответ, Режим, "", 403, КукиЗапроса, Возврат_);
		Возврат;
	КонецЕсли;

	Логин = РазборФормы.Поле(Форма, "логин", РазборФормы.Поле(Форма, "login"));
	Email = РазборФормы.Поле(Форма, "email");
	Пароль = РазборФормы.Поле(Форма, "пароль", РазборФормы.Поле(Форма, "password"));

	Попытка
		Пользователь = СервисРегистрации.Зарегистрировать(Логин, Email, Пароль,
			Строка(АдресУдаленногоУзла));
	Исключение
		ОтдатьСтраницуСОшибкой(Ответ, Режим, СообщениеОбОшибке(ИнформацияОбОшибке()), Логин, Email,
			КукиЗапроса, Возврат_);
		Возврат;
	КонецПопытки;

	Если ГейтАдреса.Закрыт(Пользователь) Тогда
		ОтдатьПриглашениеПодтвердить(Ответ, Пользователь, КукиЗапроса, Возврат_);
		Возврат;
	КонецЕсли;

	// подтверждать нечего — открываем сессию и уводим туда, откуда человек пришёл
	Сессия = СлужбаСессий.Создать(Пользователь.Идентификатор);
	КукаСессии.Установить(Ответ, Сессия.Идентификатор());
	Ответ.Перенаправить(ВозвратВхода.Путь(Возврат_));

КонецПроцедуры

#Область Рендер

// Учётная запись заведена, но до нажатия кнопки в письме вход закрыт.
Процедура ОтдатьПриглашениеПодтвердить(Ответ, Знач Пользователь, Знач КукиЗапроса, Знач Возврат_)

	Тело = Кит.Холст();
	Тело.Добавить(Страница.Заголовок(ЗаголовокПодтверждения()));
	Тело.Добавить(Страница.Уведомление(СтрШаблон(
		"Учётная запись «%1» создана. На адрес %2 отправлено письмо со ссылкой"
		+ " подтверждения — откройте её и нажмите кнопку: до этого вход закрыт.",
		Строка(Пользователь.Логин), Строка(Пользователь.Email)), "ok"));
	Тело.Добавить(Кит.Примечание("Письмо не пришло — попробуйте войти: хаб вышлет"
		+ " ссылку заново."));
	Тело.Добавить(ПриглашениеВойти(Возврат_));

	Страница.Отдать(Ответ, 200, ЗаголовокПодтверждения(), Тело, КукиЗапроса);

КонецПроцедуры

Функция ПриглашениеВойти(Знач Возврат_)

	Фраза = Кит.Шаблон("Адрес подтверждён? %1.");
	Фраза.Добавить(СсылкаВхода(Возврат_));

	Результат = Кит.Примечание();
	Результат.Добавить(Фраза);
	Возврат Результат;

КонецФункции

Процедура ОтдатьСтраницу(Ответ, Знач Режим, Знач Ошибка, Знач Статус, Знач КукиЗапроса, Знач Возврат_)
	ОтдатьСтраницуПолная(Ответ, Режим, Ошибка, "", "", Статус, КукиЗапроса, Возврат_);
КонецПроцедуры

Процедура ОтдатьСтраницуСОшибкой(Ответ, Знач Режим, Знач Ошибка, Знач Логин, Знач Email,
	Знач КукиЗапроса, Знач Возврат_)
	ОтдатьСтраницуПолная(Ответ, Режим, Ошибка, Логин, Email, 400, КукиЗапроса, Возврат_);
КонецПроцедуры

// Закрытый режим показывает объяснение: форма, гарантированно получающая отказ, — трата времени.
Процедура ОтдатьСтраницуПолная(Ответ, Знач Режим, Знач Ошибка, Знач Логин, Знач Email, Знач Статус,
	Знач КукиЗапроса, Знач Возврат_)

	Тело = Кит.Холст();
	Тело.Добавить(Страница.Заголовок(Заголовок()));

	Объяснение = ОбъяснениеЗакрытия(Режим);
	Если ЗначениеЗаполнено(Объяснение) Тогда
		Тело.Добавить(Страница.Уведомление(Объяснение, "warn"));
	Иначе
		Тело.Добавить(ПриглашениеЗавестиУчётку(Возврат_));
		Тело.Добавить(Страница.Уведомление(Ошибка, "err"));
		Тело.Добавить(ФормаРегистрации(Логин, Email, Возврат_));
	КонецЕсли;

	Страница.Отдать(Ответ, Статус, Заголовок(), Тело, КукиЗапроса);

КонецПроцедуры

Функция ПриглашениеЗавестиУчётку(Знач Возврат_)

	Фраза = Кит.Шаблон("Создайте учётную запись пользователя хаба. Уже есть аккаунт? %1.");
	Фраза.Добавить(СсылкаВхода(Возврат_));

	Результат = Кит.Примечание();
	Результат.Добавить(Фраза);
	Возврат Результат;

КонецФункции

// Вход зовётся с тем же возвратом, с каким пришли сюда: человек попадёт туда, куда шёл.
Функция СсылкаВхода(Знач Возврат_)

	Результат = Кит.Ссылка(ВозвратВхода.АдресВхода(Возврат_));
	Результат.Добавить(Кит.Текст("Войти"));
	Возврат Результат;

КонецФункции

Функция ФормаРегистрации(Знач Логин, Знач Email, Знач Возврат_)

	Результат = Кит.ФормаБезСессии(Путь(), "столбик");

	Результат.Добавить(ПолеЛогина(Логин));
	Результат.Добавить(ПолеПочты(Email));
	Результат.Добавить(ПолеПароля());
	Результат.Добавить(Подсказка.Требования(ИмяПоляПароля()));
	Результат.Добавить(ПолеВозврата(Возврат_));
	Результат.Добавить(Страница.КнопкаФормы("Зарегистрироваться"));

	Возврат Результат;

КонецФункции

Функция ПолеЛогина(Знач Логин)
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Значение, Автозаполнение",
		"логин", "Логин", Логин, "username"));
КонецФункции

Функция ПолеПочты(Знач Email)
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Значение, Автозаполнение",
		"email", "Email", Email, "email"));
КонецФункции

Функция ПолеПароля()
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Автозаполнение",
		ИмяПоляПароля(), "Пароль", "пароль", "new-password"));
КонецФункции

// Возврата может не быть вовсе — тогда поля в форме нет: пустой холст ничего не печатает.
Функция ПолеВозврата(Знач Возврат_)

	Если НЕ ВозвратВхода.Задан(Возврат_) Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Возврат Кит.СкрытоеПоле(ВозвратВхода.ИмяПараметра(), ВозвратВхода.Путь(Возврат_));

КонецФункции

Функция Заголовок()
	Возврат "Регистрация";
КонецФункции

Функция ЗаголовокПодтверждения()
	Возврат "Подтвердите адрес";
КонецФункции

Функция ИмяПоляПароля()
	Возврат "пароль";
КонецФункции

Функция Путь()
	Возврат "/register";
КонецФункции

#КонецОбласти

#Область Служебное

// Выключенный парольный вход и ненастроенная почта закрывают форму так же, как режим disabled.
Функция РежимЭкрана()

	Если СервисРегистрации.ЗакрытаПарольнымВходом() Тогда
		Возврат РежимБезПароля();
	КонецЕсли;

	Режим = СервисРегистрации.РежимРегистрации();
	// решение администратора объясняет закрытую форму лучше состояния почты: на хабе
	// с выключенной регистрацией про почту рассказывать незачем
	Если Режим = "open" И СервисРегистрации.ЗакрытаНенастроеннойПочтой() Тогда
		Возврат РежимБезПочты();
	КонецЕсли;
	Возврат Режим;

КонецФункции

// Почему формы нет; пустая строка — форма показывается.
Функция ОбъяснениеЗакрытия(Знач Режим)

	Если Режим = РежимБезПароля() Тогда
		Возврат "Вход по логину и паролю на этом хабе выключен, поэтому регистрация с паролем"
			+ " закрыта. Войдите через провайдера на странице входа.";
	ИначеЕсли Режим = РежимБезПочты() Тогда
		Возврат "Регистрация закрыта: на хабе включено подтверждение адреса письмом,"
			+ " а отправка почты не настроена. Это настройка хаба, а не ваши данные —"
			+ " администратору нужно либо настроить почту, либо выключить подтверждение"
			+ " адреса в настройках хаба.";
	ИначеЕсли Режим = "disabled" Тогда
		Возврат "Регистрация на этом хабе отключена. Учётные записи создаёт администратор.";
	ИначеЕсли Режим = "invite" Тогда
		Возврат "Регистрация только по приглашению. Попросите администратора завести вам"
			+ " учётную запись: он выдаст одноразовую ссылку, по которой вы зададите"
			+ " пароль и войдёте.";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция РежимБезПароля()
	Возврат "password-off";
КонецФункции

Функция РежимБезПочты()
	Возврат "mail-off";
КонецФункции

// Доменные тексты уже на русском — показываем как есть; машинные коды режима маппим явно.
Функция СообщениеОбОшибке(Знач ИнфоОшибки)
	Текст = КраткоеПредставлениеОшибки(ИнфоОшибки);
	НижнийТекст = НРег(Строка(Текст));
	Если СтрНайти(НижнийТекст, "registration_locked_onboarding") > 0 Тогда
		Возврат "Сначала создайте администратора на странице первого запуска (/setup).";
	ИначеЕсли СтрНайти(НижнийТекст, "registration_password_login_disabled") > 0 Тогда
		Возврат "Вход по логину и паролю выключен: регистрация с паролем закрыта.";
	ИначеЕсли СтрНайти(НижнийТекст, "registration_disabled") > 0 Тогда
		Возврат "Регистрация на этом хабе отключена.";
	ИначеЕсли СтрНайти(НижнийТекст, "registration_invite_only") > 0 Тогда
		Возврат "Регистрация только по приглашению: учётную запись заводит администратор.";
	ИначеЕсли СтрНайти(НижнийТекст, "registration_mail_not_configured") > 0 Тогда
		Возврат "Регистрация закрыта: включено подтверждение адреса письмом, а отправка"
			+ " почты на хабе не настроена. Администратору нужно настроить почту либо"
			+ " выключить подтверждение адреса в настройках хаба.";
	ИначеЕсли СтрНайти(НижнийТекст, "email_taken") > 0 Тогда
		Возврат "Этот адрес электронной почты уже занят. Укажите другой или войдите"
			+ " в свою учётную запись.";
	КонецЕсли;
	Возврат Текст;
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисРегистрации") _СервисРегистрации,
	&Пластилин(Значение = "ГейтПодтвержденияАдреса") _ГейтАдреса,
	&Пластилин(Значение = "СлужбаСессий") _СлужбаСессий,
	&Пластилин(Значение = "КукиСессии") _КукаСессии,
	&Пластилин(Значение = "СтраницаДоступа") _Страница,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ПодсказкаПароля") _Подсказка,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "ВозвратПослеВхода") _Возврат)

	HTTP = _HTTP;
	ВозвратВхода = _Возврат;

	СервисРегистрации = _СервисРегистрации;
	ГейтАдреса = _ГейтАдреса;
	СлужбаСессий = _СлужбаСессий;
	КукаСессии = _КукаСессии;
	Страница = _Страница;
	Кит = _Кит;
	Подсказка = _Подсказка;
	РазборФормы = _РазборФормы;

КонецПроцедуры
