// Мастер /setup: доступен, только пока в хабе нет пользователей; после создания первого
// администратора закрывается навсегда (409). Два контракта ответа по Accept: HTML либо JSON.

Перем Онбординг;      // ОнбордингПервогоЗапуска (auth)
Перем СлужбаСессий;   // СлужбаСессий (auth)
Перем Перехватчик;    // ПерехватчикАутентификации (auth) — имя куки
Перем Ответы;         // ОтветыAPI (auth)
Перем ПустыеКуки;     // Куки (winow)
Перем Страница;       // СтраницаДоступа (web-ui) — каркас публичного экрана
Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем Подсказка;      // ПодсказкаПароля (web-ui)
Перем ВозвратВхода;   // ВозвратПослеВхода (основа) — адрес страницы входа
Перем АдресаКабинета; // АдресаКабинета (web-ui) — адрес проводника первой публикации

// GET /setup — состояние онбординга, POST /setup — создание первого администратора
// с открытием сессии. На инициализированном хабе POST отвечает 409.
//
// Параметры:
//  Ответ - Ответ - ответ winow: HTML при Accept: text/html, иначе JSON.
//  ТелоЗапроса - Строка - тело POST: логин, пароль.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса (Accept, Content-Type).
//  КукиЗапроса - Куки - куки запроса (контекст HTML-страницы).
//  МетодЗапроса - Строка - HTTP-метод запроса; прочие методы → 405.
//
&ТочкаМаршрута("/setup")
Процедура Мастер(Ответ, ТелоЗапроса, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса) Экспорт

	ХочетHTML = ХочетHTML(ЗаголовкиЗапроса);

	Если ВРег(Строка(МетодЗапроса)) = "GET" Тогда
		Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
		Если ХочетHTML Тогда
			Если Онбординг.НуженОнбординг() Тогда
				ОтдатьФормуHTML(Ответ, "", 200, КукиЗапроса);
			Иначе
				ОтдатьЗакрытыйМастерHTML(Ответ, 200, КукиЗапроса);
			КонецЕсли;
		Иначе
			Ответы.JSON(Ответ, 200, Новый Структура("onboarding_needed", Онбординг.НуженОнбординг()));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если ВРег(Строка(МетодЗапроса)) <> "POST" Тогда
		Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
		Ответ.Заголовки["Allow"] = "GET, POST";
		Ответы.Ошибка(Ответ, 405, "method_not_allowed", "Разрешены методы: GET, POST");
		Возврат;
	КонецЕсли;

	Если НЕ Онбординг.НуженОнбординг() Тогда
		Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
		Если ХочетHTML Тогда
			ОтдатьЗакрытыйМастерHTML(Ответ, 409, КукиЗапроса);
		Иначе
			Ответы.Ошибка(Ответ, 409, "already_initialized", "Хаб уже инициализирован, мастер /setup закрыт");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Тело = Ответы.РазобратьТело(ТелоЗапроса, ЗаголовкиЗапроса);
	Логин = Ответы.Поле(Тело, "логин", Ответы.Поле(Тело, "login"));
	Пароль = Ответы.Поле(Тело, "пароль", Ответы.Поле(Тело, "password"));

	Попытка
		Админ = Онбординг.СоздатьПервогоАдмина(Логин, Пароль, Ложь);
	Исключение
		Ответы.БезСессионнойКуки(Ответ, ПустыеКуки);
		Если ХочетHTML Тогда
			ОтдатьФормуHTML(Ответ, "Не удалось создать администратора: проверьте логин и пароль.", 400, КукиЗапроса);
		Иначе
			Ответы.Ошибка(Ответ, 400, "setup_failed", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецЕсли;
		Возврат;
	КонецПопытки;

	// сразу авторизуем созданного админа
	Сессия = СлужбаСессий.Создать(Админ.Идентификатор);
	Кука = Ответ.Куки.Добавить(Перехватчик.ИмяКукиСессии(), Сессия.Идентификатор());
	Кука.ТолькоХттп = Истина;
	Кука.Путь = "/";
	Кука.ТотжеСайт = "Lax";

	Если ХочетHTML Тогда
		// админ уже вошёл — уводим в проводник первой публикации, а не в пустой кабинет
		Ответ.Перенаправить(АдресаКабинета.Проводник());
		Возврат;
	КонецЕсли;

	Данные = Новый Структура();
	Данные.Вставить("id", Админ.Идентификатор);
	Данные.Вставить("login", Админ.Логин);
	Данные.Вставить("role", Админ.РольХаба);
	Ответы.JSON(Ответ, 201, Новый Структура("admin", Данные));

КонецПроцедуры

#Область Рендер

Процедура ОтдатьФормуHTML(Ответ, Знач Ошибка, Знач Статус, Знач КукиЗапроса)

	Карточка = КарточкаПервогоЗапуска();
	Карточка.Добавить(Страница.Уведомление(Ошибка, "err"));
	Карточка.Добавить(ФормаАдминистратора());

	Страница.Отдать(Ответ, Статус, ЗаголовокМастера(), Карточка, КукиЗапроса);

КонецПроцедуры

Процедура ОтдатьЗакрытыйМастерHTML(Ответ, Знач Статус, Знач КукиЗапроса)

	Карточка = Кит.Карточка(Новый Структура("Заголовок, Иконка, Уровень",
		ЗаголовокЗакрытого(), "инфо", 1));
	Карточка.Добавить(ХодКоВходу());

	Страница.Отдать(Ответ, Статус, ЗаголовокЗакрытого(), Карточка, КукиЗапроса);

КонецПроцедуры

Функция КарточкаПервогоЗапуска()

	Возврат Кит.Карточка(Новый Структура("Заголовок, Описание, Иконка, Уровень",
		ЗаголовокМастера(),
		"В хабе ещё нет пользователей. Создайте первого администратора — после этого"
			+ " мастер закроется навсегда, а вы попадёте в проводник первой публикации.",
		"замок", 1));

КонецФункции

Функция ФормаАдминистратора()

	Результат = Кит.ФормаБезСессии(Путь(), "столбик");

	Результат.Добавить(ПолеЛогина());
	Результат.Добавить(ПолеПароля());
	Результат.Добавить(Подсказка.Требования(ИмяПоляПароля()));
	Результат.Добавить(КнопкаСоздания());

	Возврат Результат;

КонецФункции

Функция ПолеЛогина()

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Подсказка, Обязательное, Автозаполнение",
		"логин", "Логин администратора",
		"Под этим именем вы будете входить в хаб; сменить его потом нельзя.",
		Истина, "username"));

КонецФункции

Функция ПолеПароля()

	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Обязательное, Автозаполнение",
		ИмяПоляПароля(), "Пароль", "пароль", Истина, "new-password"));

КонецФункции

// Кнопка мастера крупнее обычной: это единственное действие первого экрана хаба.
Функция КнопкаСоздания()

	Возврат Кит.Кнопка(Новый Структура("Подпись, Размер, ВоВсюШирину",
		"Создать администратора", "большой", Истина));

КонецФункции

Функция ХодКоВходу()

	Ссылка = Кит.Ссылка(ВозвратВхода.ПутьВхода());
	Ссылка.Добавить(Кит.Текст("Перейти ко входу"));

	Фраза = Кит.Шаблон("Администратор уже создан — мастер первого запуска закрыт. %1");
	Фраза.Добавить(Ссылка);

	Результат = Кит.Примечание();
	Результат.Добавить(Фраза);
	Возврат Результат;

КонецФункции

Функция ЗаголовокМастера()
	Возврат "Первый запуск";
КонецФункции

Функция ЗаголовокЗакрытого()
	Возврат "Хаб уже инициализирован";
КонецФункции

Функция ИмяПоляПароля()
	Возврат "пароль";
КонецФункции

Функция Путь()
	Возврат "/setup";
КонецФункции

// Предпочитает ли клиент HTML (браузер): заголовок Accept содержит text/html.
Функция ХочетHTML(Знач ЗаголовкиЗапроса)
	Возврат СтрНайти(НРег(Строка(ЗаголовокЗапроса(ЗаголовкиЗапроса, "Accept"))), "text/html") > 0;
КонецФункции

Функция ЗаголовокЗапроса(Знач ЗаголовкиЗапроса, Знач Имя)
	Если ЗаголовкиЗапроса = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ИскомыйКлюч = ВРег(Имя);
	Для Каждого КиЗ Из ЗаголовкиЗапроса Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = ИскомыйКлюч Тогда
			Возврат КиЗ.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОнбордингПервогоЗапуска") _Онбординг,
	&Пластилин(Значение = "СлужбаСессий") _СлужбаСессий,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "ОтветыAPI") _Ответы,
	&Пластилин(Значение = "Куки") _ПустыеКуки,
	&Пластилин(Значение = "СтраницаДоступа") _Страница,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ПодсказкаПароля") _Подсказка,
	&Пластилин(Значение = "ВозвратПослеВхода") _Возврат,
	&Пластилин(Значение = "АдресаКабинета") _АдресаКабинета)

	Онбординг = _Онбординг;
	СлужбаСессий = _СлужбаСессий;
	Перехватчик = _Перехватчик;
	Ответы = _Ответы;
	ПустыеКуки = _ПустыеКуки;
	Страница = _Страница;
	Кит = _Кит;
	Подсказка = _Подсказка;
	ВозвратВхода = _Возврат;
	АдресаКабинета = _АдресаКабинета;

КонецПроцедуры
