// Публичная страница /invite — человек задаёт пароль по одноразовой ссылке. GET рисует
// форму либо внятный отказ, POST ставит пароль, открывает вход и сессию.

Перем Приглашения;   // СервисПриглашений (auth)
Перем АдресСсылки;   // АдресПриглашения (auth) — путь страницы и имя параметра
Перем СлужбаСессий;  // СлужбаСессий (auth)
Перем КукаСессии;    // КукиСессии (вход) — имя и атрибуты сессионной куки
Перем Ограничитель;  // ОграничительВхода (auth) — подбор ссылки ограничен как подбор пароля
Перем Ведра;         // ВедроОграничителяПоАдресу (вход) — ключ ведра по адресу клиента
Перем Страница;      // СтраницаДоступа (web-ui) — каркас публичного экрана
Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем Подсказка;     // ПодсказкаПароля (web-ui)
Перем РазборФормы;   // РазборФормы (web-ui)
Перем HTTP;          // МетодыHTTP (основа)
Перем ВозвратВхода;  // ВозвратПослеВхода (основа)

#Область ТочкиМаршрута

// GET /invite — форма установки пароля по ссылке, POST /invite — установка пароля.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow: HTML-страница либо редирект в кабинет.
//  ТелоЗапроса - Строка - тело POST-формы: token, пароль, повтор.
//  КукиЗапроса - Куки - куки запроса (оформление).
//  МетодЗапроса - Строка - HTTP-метод запроса; прочие методы → 405.
//  АдресУдаленногоУзла - Строка - адрес клиента, попадает в журнал аудита.
//  token - Строка - значение ссылки из адреса (необязательный, по умолчанию "").
//
&ТочкаМаршрута("invite")
Процедура УстановкаПароля(Ответ, ТелоЗапроса, КукиЗапроса, МетодЗапроса,
	АдресУдаленногоУзла, token = "") Экспорт

	Ключ = Ведра.Ключ(НазначениеВедра(), АдресУдаленногоУзла);
	Если НЕ Ограничитель.РазрешёнЛи(Ключ) Тогда
		ОтдатьОтказ(Ответ, 429, "Слишком много попыток открыть ссылку. Попробуйте позже.",
			КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ПоказатьФорму(Ответ, Строка(token), "", 200, КукиЗапроса, Ключ);
		Возврат;
	КонецЕсли;

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответ.Заголовки["Allow"] = "GET, POST";
		ОтдатьОтказ(Ответ, 405, "Разрешены методы GET, POST", КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = РазборФормы.Разобрать(ТелоЗапроса);
	Значение = РазборФормы.Поле(Форма, АдресСсылки.ИмяПараметра(), Строка(token));
	Пароль = РазборФормы.Поле(Форма, ИмяПоляПароля());

	Если Пароль <> РазборФормы.Поле(Форма, ИмяПоляПовтора()) Тогда
		ПоказатьФорму(Ответ, Значение, "Пароли не совпали — наберите оба поля заново.",
			400, КукиЗапроса, Ключ);
		Возврат;
	КонецЕсли;

	// адрес клиента в журнале — самое интересное поле события «кто-то открыл вход»
	Исход = Приглашения.Погасить(Значение, Пароль, Неопределено, Строка(АдресУдаленногоУзла));
	Если НЕ Исход.Успех Тогда
		ЗачестьПопытку(Ключ, Исход.Причина);
		ПоказатьФорму(Ответ, Значение, ТекстОтказа(Исход.Причина, Исход.Требования),
			КодОтказа(Исход.Причина), КукиЗапроса, Ключ);
		Возврат;
	КонецЕсли;

	Ограничитель.Сбросить(Ключ);
	// вход уже открыт этой же операцией — сразу пускаем в кабинет, а не на форму логина
	Сессия = СлужбаСессий.Создать(Исход.Пользователь.Идентификатор);
	КукаСессии.Установить(Ответ, Сессия.Идентификатор());
	Ответ.Перенаправить(ВозвратВхода.ПутьПоУмолчанию());

КонецПроцедуры

#КонецОбласти

#Область Рендер

// Негодная ссылка не показывает формы вовсе: заполнять её было бы напрасным трудом.
Процедура ПоказатьФорму(Ответ, Знач Значение, Знач Ошибка, Знач Статус, Знач КукиЗапроса,
	Знач Ключ)

	Проверка = Приглашения.Проверить(Значение);
	Если НЕ Проверка.Успех Тогда
		ЗачестьПопытку(Ключ, Проверка.Причина);
		ОтдатьОтказ(Ответ, КодОтказа(Проверка.Причина), ТекстОтказа(Проверка.Причина, ""),
			КукиЗапроса);
		Возврат;
	КонецЕсли;

	Тело = Кит.Холст();
	Тело.Добавить(Страница.Заголовок(Заголовок()));
	Тело.Добавить(ЧьяУчётка(Проверка.Пользователь.Логин));
	Тело.Добавить(Страница.Уведомление(Ошибка, "err"));
	Тело.Добавить(ФормаПароля(Значение));

	Страница.Отдать(Ответ, Статус, Заголовок(), Тело, КукиЗапроса);

КонецПроцедуры

Процедура ОтдатьОтказ(Ответ, Знач Статус, Знач Сообщение, Знач КукиЗапроса)

	Тело = Кит.Холст();
	Тело.Добавить(Страница.Заголовок(Заголовок()));
	Тело.Добавить(Страница.Уведомление(Сообщение, "err"));
	Тело.Добавить(ГдеВзятьНовуюСсылку());

	Страница.Отдать(Ответ, Статус, Заголовок(), Тело, КукиЗапроса);

КонецПроцедуры

Функция ЧьяУчётка(Знач Логин)

	Фраза = Кит.Шаблон("Учётная запись «%1». Задайте пароль — после этого вход в неё"
		+ " откроется, а ссылка перестанет работать.");
	Фраза.Добавить(Кит.Текст(Логин));

	Результат = Кит.Примечание();
	Результат.Добавить(Фраза);
	Возврат Результат;

КонецФункции

Функция ГдеВзятьНовуюСсылку()

	Фраза = Кит.Шаблон("Новую ссылку выпускает администратор хаба: попросите его"
		+ " нажать «Сбросить пароль» в разделе «Пользователи». %1.");
	Фраза.Добавить(Страница.СсылкаВхода());

	Результат = Кит.Примечание();
	Результат.Добавить(Фраза);
	Возврат Результат;

КонецФункции

Функция ФормаПароля(Знач Значение)

	Результат = Кит.ФормаБезСессии(АдресСсылки.Путь(), "столбик");

	Результат.Добавить(Кит.СкрытоеПоле(АдресСсылки.ИмяПараметра(), Значение));
	Результат.Добавить(ПолеНовогоПароля());
	Результат.Добавить(Подсказка.Требования(ИмяПоляПароля()));
	Результат.Добавить(ПолеПовтора());
	Результат.Добавить(Страница.КнопкаФормы("Задать пароль и войти"));

	Возврат Результат;

КонецФункции

Функция ПолеНовогоПароля()
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Автозаполнение",
		ИмяПоляПароля(), "Новый пароль", "пароль", "new-password"));
КонецФункции

Функция ПолеПовтора()
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Автозаполнение",
		ИмяПоляПовтора(), "Повторите пароль", "пароль", "new-password"));
КонецФункции

Функция Заголовок()
	Возврат "Установка пароля";
КонецФункции

Функция ИмяПоляПароля()
	Возврат "пароль";
КонецФункции

Функция ИмяПоляПовтора()
	Возврат "повтор";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Нераспознанный код получает общий текст, а не текст соседней причины.
Функция ТекстОтказа(Знач Причина, Знач Требования)

	Если Причина = Приглашения.ПричинаПросрочена() Тогда
		Возврат "Срок этой ссылки вышел. Попросите администратора выпустить новую.";
	ИначеЕсли Причина = Приглашения.ПричинаПогашена() Тогда
		Возврат "Этой ссылкой уже воспользовались либо её отменил выпуск новой.";
	ИначеЕсли Причина = Приглашения.ПричинаНетУчётки() Тогда
		Возврат "Учётной записи этой ссылки больше нет.";
	ИначеЕсли Причина = Приглашения.ПричинаПароль() Тогда
		Возврат "Пароль не подходит: " + Строка(Требования) + ".";
	ИначеЕсли Причина = Приглашения.ПричинаПарольныйВходВыключен() Тогда
		Возврат "Вход по логину и паролю на этом хабе выключен: заданный здесь пароль"
			+ " никого не пустит. Обратитесь к администратору — войти можно через"
			+ " провайдера входа.";
	КонецЕсли;

	Возврат "Такой ссылки нет. Проверьте адрес целиком — он длинный и легко теряет хвост.";

КонецФункции

// 410 для просроченной и погашенной, 404 для неизвестной: разбирать обращения легче.
Функция КодОтказа(Знач Причина)

	Если Причина = Приглашения.ПричинаПросрочена() ИЛИ Причина = Приглашения.ПричинаПогашена() Тогда
		Возврат 410;
	ИначеЕсли Причина = Приглашения.ПричинаПарольныйВходВыключен() Тогда
		Возврат 403;
	ИначеЕсли Причина = Приглашения.ПричинаПароль() Тогда
		Возврат 400;
	КонецЕсли;
	Возврат 404;

КонецФункции

// Попыткой считается только НЕУГАДАННАЯ ссылка: слабый пароль страницу не запирает.
// Неизвестный адрес не считается вовсе: приписать ему чужие попытки значило бы
// запереть страницу всем разом.
Процедура ЗачестьПопытку(Знач Ключ, Знач Причина)

	Если НЕ ЗначениеЗаполнено(Ключ) ИЛИ Причина <> Приглашения.ПричинаНетСсылки() Тогда
		Возврат;
	КонецЕсли;
	Ограничитель.ЗафиксироватьНеудачу(Ключ);

КонецПроцедуры

// Назначение своё, а не общее с входом: замок на подборе ссылки не запирает вход по паролю.
Функция НазначениеВедра()
	Возврат "ссылка-пароля";
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПриглашений") _Приглашения,
	&Пластилин(Значение = "АдресПриглашения") _АдресСсылки,
	&Пластилин(Значение = "СлужбаСессий") _СлужбаСессий,
	&Пластилин(Значение = "КукиСессии") _КукаСессии,
	&Пластилин(Значение = "ОграничительВхода") _Ограничитель,
	&Пластилин(Значение = "ВедроОграничителяПоАдресу") _Ведра,
	&Пластилин(Значение = "СтраницаДоступа") _Страница,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ПодсказкаПароля") _Подсказка,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "МетодыHTTP") _HTTP,
	&Пластилин(Значение = "ВозвратПослеВхода") _Возврат)

	Приглашения = _Приглашения;
	АдресСсылки = _АдресСсылки;
	СлужбаСессий = _СлужбаСессий;
	КукаСессии = _КукаСессии;
	Ограничитель = _Ограничитель;
	Ведра = _Ведра;
	Страница = _Страница;
	Кит = _Кит;
	Подсказка = _Подсказка;
	РазборФормы = _РазборФормы;
	HTTP = _HTTP;
	ВозвратВхода = _Возврат;

КонецПроцедуры
