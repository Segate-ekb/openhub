// Публичная страница входа /login, выход и веб-поток OIDC (старт и callback). Транзиентное
// состояние OIDC живёт серверно, в отдельной сессии под своей кукой.

Перем Страница;              // СтраницаДоступа (web-ui) — каркас публичного экрана
Перем Кит;                   // Кит (кит) — фабрика элементов экрана
Перем Тексты;                // ТекстыИнтерфейса (кит)
Перем Конфигурация;          // КонфигурацияOIDC (oidc)
Перем СервисВхода;           // СервисВходаOIDC (oidc)
Перем СлужбаСессий;          // СлужбаСессий (auth)
Перем Транзакции;            // ХранительТранзакцийOIDC (oidc)
Перем СервисАутентификации;  // СервисАутентификации (auth)
Перем ПарольныйВход;         // ПолитикаПарольногоВхода (auth)
Перем КукаСессии;            // КукиСессии (вход) — имя и атрибуты сессионной куки
Перем РазборФормы;           // РазборФормы (web-ui)
Перем Активы;                // АдресаСтатики — адреса значков провайдеров
Перем Восстановление;        // ВосстановлениеПароля (auth) — есть ли дорога «забыли пароль»
Перем Отказы;                // ТекстыОтказовВхода (web-ui) — объяснения отказов входа
Перем HTTP;                  // МетодыHTTP (основа)
Перем ВозвратВхода;          // ВозвратПослеВхода (основа)

#Область ТочкиМаршрута

// GET /login — страница входа, POST /login — вход по паролю с установкой куки сессии.
//
// Параметры:
//  Ответ - Ответ - ответ winow: HTML-страница входа либо редирект в кабинет.
//  ТелоЗапроса - Строка - тело POST: логин, пароль, next.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса (контекст страницы).
//  МетодЗапроса - Строка - HTTP-метод запроса; прочие методы → 405.
//  АдресУдаленногоУзла - Строка - адрес клиента, ключ ограничителя попыток.
//  next - Строка - куда вернуть после входа; принимается только путь этого хаба
//         (необязательный, по умолчанию "").
//
&ТочкаМаршрута("login")
Процедура Логин(Ответ, ТелоЗапроса, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	АдресУдаленногоУзла, next = "") Экспорт

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьСтраницуВхода(Ответ, "", 200, КукиЗапроса, Строка(next));
		Возврат;
	КонецЕсли;
	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответ.Заголовки["Allow"] = "GET, POST";
		ОтдатьСтраницуВхода(Ответ, "Разрешены методы GET, POST", 405, КукиЗапроса, Строка(next));
		Возврат;
	КонецЕсли;

	Форма = РазборФормы.Разобрать(ТелоЗапроса);
	Логин = РазборФормы.Поле(Форма, "логин", РазборФормы.Поле(Форма, "login"));
	Пароль = РазборФормы.Поле(Форма, "пароль", РазборФормы.Поле(Форма, "password"));
	Возврат_ = РазборФормы.Поле(Форма, ВозвратВхода.ИмяПараметра(), Строка(next));

	Результат = СервисАутентификации.ВойтиПоПаролю(Логин, Пароль, Строка(АдресУдаленногоУзла));
	Если НЕ Результат.Успех Тогда
		Письмо = Неопределено;
		Результат.Свойство("Письмо", Письмо);
		ОтдатьСтраницуВхода(Ответ, Отказы.ОтказПароля(Результат.Причина, Письмо),
			Отказы.КодОтказаПароля(Результат.Причина), КукиЗапроса, Возврат_);
		Возврат;
	КонецЕсли;

	УстановитьОсновнуюКуку(Ответ, Результат.Сессия.Идентификатор());
	Ответ.Перенаправить(ВозвратВхода.Путь(Возврат_));

КонецПроцедуры

// POST /logout — браузерный выход: гасит серверную сессию и стирает куку.
// Только POST: GET-выход уязвим к предзагрузке ссылок и CSRF.
//
// Параметры:
//  Ответ - Ответ - ответ winow: редирект на главную либо 405.
//  КукиЗапроса - Куки - куки запроса (идентификатор сессии).
//  МетодЗапроса - Строка - HTTP-метод запроса.
//
&ТочкаМаршрута("logout")
Процедура Выход(Ответ, КукиЗапроса, МетодЗапроса) Экспорт

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответ.Заголовки["Allow"] = "POST";
		ОтдатьСтраницуВхода(Ответ, "Для выхода используйте кнопку «Выйти»", 405, КукиЗапроса);
		Возврат;
	КонецЕсли;

	ИдСессии = КукаСессии.ИзЗапроса(КукиЗапроса);
	Если ЗначениеЗаполнено(ИдСессии) Тогда
		СлужбаСессий.Завершить(ИдСессии);
	КонецЕсли;

	СброситьОсновнуюКуку(Ответ);
	Ответ.Перенаправить("/");

КонецПроцедуры

// GET /login/oidc/{провайдер} — старт входа через провайдера: PKCE, state и nonce
// сохраняются в серверной транзакции, браузер уходит на IdP.
//
// Параметры:
//  Ответ - Ответ - ответ winow: редирект на провайдера, 404 либо 502 при отказе старта.
//  провайдер - Строка - имя провайдера из адреса.
//  КукиЗапроса - Куки - куки запроса (контекст страницы).
//  МетодЗапроса - Строка - HTTP-метод запроса; прочие методы → 405.
//  next - Строка - куда вернуть после входа; принимается только путь этого хаба
//         (необязательный, по умолчанию "").
//
&ТочкаМаршрута("login/oidc/{провайдер}")
Процедура СтартOIDC(Ответ, провайдер, КукиЗапроса, МетодЗапроса, next = "") Экспорт

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответ.Заголовки["Allow"] = "GET";
		ОтдатьСтраницуВхода(Ответ, "Разрешён только метод GET", 405, КукиЗапроса, Строка(next));
		Возврат;
	КонецЕсли;

	Если Конфигурация.Провайдер(провайдер) = Неопределено Тогда
		ОтдатьСтраницуВхода(Ответ, "Неизвестный провайдер входа", 404, КукиЗапроса, Строка(next));
		Возврат;
	КонецЕсли;

	Попытка
		Начало = СервисВхода.Начать(провайдер);
	Исключение
		ОтдатьСтраницуВхода(Ответ, "Не удалось начать вход через провайдера", 502, КукиЗапроса,
			Строка(next));
		Возврат;
	КонецПопытки;

	// адрес возврата едет в серверной транзакции, а не через провайдера: у IdP ему делать
	// нечего, а обратно он вернулся бы уже как значение, пришедшее со стороны
	УстановитьКукуТранзакции(Ответ,
		Транзакции.Сохранить(Начало.Транзакция, ВозвратВхода.Путь(next)));
	Ответ.Перенаправить(Начало.URL);

КонецПроцедуры

// GET /oidc/callback — возврат от провайдера: сверка state, обмен кода, вход или привязка.
// Транзакция одноразовая и гасится в любом исходе.
//
// Параметры:
//  Ответ - Ответ - ответ winow: редирект в кабинет либо страница входа с отказом.
//  КукиЗапроса - Куки - куки запроса (ключ транзакции).
//  МетодЗапроса - Строка - HTTP-метод запроса; прочие методы → 405.
//  code - Строка - код авторизации от провайдера (необязательный, по умолчанию "").
//  state - Строка - состояние от провайдера, сверяется с транзакцией
//          (необязательный, по умолчанию "").
//  error - Строка - код отказа провайдера (необязательный, по умолчанию "").
//
&ТочкаМаршрута("oidc/callback")
Процедура Обратно(Ответ, КукиЗапроса, МетодЗапроса, code = "", state = "", error = "") Экспорт

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		Ответ.Заголовки["Allow"] = "GET";
		ОтдатьСтраницуВхода(Ответ, "Разрешён только метод GET", 405, КукиЗапроса);
		Возврат;
	КонецЕсли;

	КлючТранзакции = ЗначениеКуки(КукиЗапроса, Транзакции.ИмяКуки());
	// адрес возврата снимаем до гашения транзакции: он нужен и отказу, чтобы человек
	// повторил вход с той же страницы, а не начинал путь заново
	ПутьВозврата = ВозвратВхода.Путь(Транзакции.ПутьВозврата(КлючТранзакции));

	Если ЗначениеЗаполнено(error) Тогда
		Транзакции.Удалить(КлючТранзакции);
		СброситьКукуТранзакции(Ответ);
		ОтдатьСтраницуВхода(Ответ, "Провайдер отклонил вход", 400, КукиЗапроса, ПутьВозврата);
		Возврат;
	КонецЕсли;

	Транзакция = Транзакции.Прочитать(КлючТранзакции);
	Если Транзакция = Неопределено Тогда
		СброситьКукуТранзакции(Ответ);
		ОтдатьСтраницуВхода(Ответ, "Сессия входа истекла или недействительна, повторите вход", 400, КукиЗапроса);
		Возврат;
	КонецЕсли;

	// контекст снимается до гашения транзакции: он живёт в записи хаба рядом с ней
	Привязка = Транзакции.Контекст(КлючТранзакции);
	Исход = СервисВхода.Завершить(Транзакция, Строка(code), Строка(state), Привязка);

	Транзакции.Удалить(КлючТранзакции);
	СброситьКукуТранзакции(Ответ);

	Если НЕ Исход.Успех Тогда
		ОтдатьСтраницуВхода(Ответ, Отказы.ОтказПровайдера(Исход.Причина), 400, КукиЗапроса, ПутьВозврата);
		Возврат;
	КонецЕсли;

	Если Привязка > 0 Тогда
		// ручная привязка из кабинета — основная сессия не меняется
		Ответ.Перенаправить("/me/settings/oidc");
		Возврат;
	КонецЕсли;

	// вход открывает новую сессию — защита от фиксации
	Сессия = СлужбаСессий.Создать(Исход.Пользователь.Идентификатор);
	УстановитьОсновнуюКуку(Ответ, Сессия.Идентификатор());
	Ответ.Перенаправить(ПутьВозврата);

КонецПроцедуры

#КонецОбласти

#Область Рендер

Процедура ОтдатьСтраницуВхода(Ответ, Знач Ошибка, Знач Статус, Знач КукиЗапроса, Знач Возврат_ = "")

	Тело = Кит.Холст();
	Тело.Добавить(Страница.Заголовок(Заголовок()));
	Тело.Добавить(Страница.Уведомление(Ошибка, "err"));

	// пароль выключен — полей логина и пароля на странице нет вовсе: форма, которая
	// гарантированно получит отказ, читается как сломанный хаб
	Если ПарольныйВход.Выключен() Тогда
		Тело.Добавить(БлокПровайдеров(Возврат_));
		Тело.Добавить(Страница.Уведомление(ВходитьНечем(), "warn"));
	Иначе
		Тело.Добавить(ФормаПароля(Возврат_));
		Тело.Добавить(СсылкаВосстановления());
		Тело.Добавить(СсылкаРегистрации(Возврат_));
		Тело.Добавить(БлокПровайдеров(Возврат_));
	КонецЕсли;

	Страница.Отдать(Ответ, Статус, Заголовок(), Тело, КукиЗапроса);

КонецПроцедуры

Функция ФормаПароля(Знач Возврат_)

	Результат = Кит.ФормаБезСессии(ВозвратВхода.ПутьВхода(), "столбик");

	Результат.Добавить(ПолеЛогина());
	Результат.Добавить(ПолеПароля());
	Результат.Добавить(ПолеВозврата(Возврат_));
	Результат.Добавить(Страница.КнопкаФормы("Войти"));

	Возврат Результат;

КонецФункции

Функция ПолеЛогина()
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Автозаполнение", "логин", "Логин", "username"));
КонецФункции

Функция ПолеПароля()
	Возврат Кит.Поле(Новый Структура("Имя, Метка, Тип, Автозаполнение",
		"пароль", "Пароль", "пароль", "current-password"));
КонецФункции

// Возврата может не быть вовсе — тогда поля в форме нет: пустой холст ничего не печатает.
Функция ПолеВозврата(Знач Возврат_)

	Если НЕ ВозвратВхода.Задан(Возврат_) Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Возврат Кит.СкрытоеПоле(ВозвратВхода.ИмяПараметра(), ВозвратВхода.Путь(Возврат_));

КонецФункции

// Дороги к восстановлению нет, пока хабу нечем слать письмо.
Функция СсылкаВосстановления()

	Если Восстановление = Неопределено ИЛИ НЕ Восстановление.Доступно() Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Ссылка = Кит.Ссылка("/forgot-password");
	Ссылка.Добавить(Кит.Текст(Тексты.Текст("recover.page.link")));

	Результат = Кит.Примечание();
	Результат.Добавить(Ссылка);
	Возврат Результат;

КонецФункции

Функция СсылкаРегистрации(Знач Возврат_)

	Ссылка = Кит.Ссылка(ВозвратВхода.СВозвратом("/register", Возврат_));
	Ссылка.Добавить(Кит.Текст("Зарегистрироваться"));

	Фраза = Кит.Шаблон("Нет аккаунта? %1");
	Фраза.Добавить(Ссылка);

	Результат = Кит.Примечание();
	Результат.Добавить(Фраза);
	Возврат Результат;

КонецФункции

// Способы входа читаются как перечень: кнопки идут стопкой, а не панелью действий в строку.
Функция БлокПровайдеров(Знач Возврат_)

	Если НЕ Конфигурация.ЕстьПровайдеры() Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Результат = Кит.Холст();
	Результат.Добавить(ЗаголовокПровайдеров());

	Стопка = Результат.Добавить(Кит.Сетка(
		Новый Структура("Колонки, Заголовок", 1, "Провайдеры OIDC")));
	Для Каждого Провайдер Из Конфигурация.Провайдеры() Цикл
		Стопка.Добавить(КнопкаПровайдера(Провайдер, Возврат_));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗаголовокПровайдеров()

	Результат = Кит.Заголовок(2);
	Результат.Добавить(Кит.Текст("Или через провайдера"));
	Возврат Результат;

КонецФункции

Функция КнопкаПровайдера(Знач Провайдер, Знач Возврат_)

	Адрес = ВозвратВхода.СВозвратом(
		"/login/oidc/" + КодироватьСтроку(Провайдер.Имя, СпособКодированияСтроки.КодировкаURL),
		Возврат_);

	Возврат Кит.Кнопка(Новый Структура("Подпись, Адрес, Вариант, Иконка, Картинка, ВоВсюШирину",
		"Войти через " + Строка(Провайдер.Метка), Адрес, "вторичная", "ссылка",
		КартинкаПровайдера(Провайдер), Истина));

КонецФункции

// Ключ проверяется заново: адрес даёт только ключ из закрытого списка статики.
Функция КартинкаПровайдера(Знач Провайдер)

	Ключ = "";
	Если ТипЗнч(Провайдер) = Тип("Структура") Тогда
		Провайдер.Свойство("Значок", Ключ);
	КонецЕсли;
	Возврат Активы.АдресЗначка(?(Ключ = Неопределено, "", Ключ));

КонецФункции

// Пустая страница входа выглядит поломкой, а не решением администратора.
Функция ВходитьНечем()

	Если Конфигурация.ЕстьПровайдеры() Тогда
		Возврат "";
	КонецЕсли;

	Возврат "Вход по логину и паролю выключен, а провайдеры входа не настроены."
		+ " Обратитесь к администратору хаба.";

КонецФункции

Функция Заголовок()
	Возврат "Вход";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяКукиТранзакции()
	Возврат Транзакции.ИмяКуки();
КонецФункции

Процедура УстановитьОсновнуюКуку(Ответ, Знач ИдСессии)
	КукаСессии.Установить(Ответ, ИдСессии);
КонецПроцедуры

Процедура СброситьОсновнуюКуку(Ответ)
	КукаСессии.Сбросить(Ответ);
КонецПроцедуры

Процедура УстановитьКукуТранзакции(Ответ, Знач ИдСессии)
	Кука = Ответ.Куки.Добавить(ИмяКукиТранзакции(), ИдСессии);
	Кука.ТолькоХттп = Истина;
	Кука.Путь = "/";
	Кука.ТотжеСайт = "Lax";
КонецПроцедуры

Процедура СброситьКукуТранзакции(Ответ)
	Кука = Ответ.Куки.Добавить(ИмяКукиТранзакции(), "");
	Кука.ТолькоХттп = Истина;
	Кука.Путь = "/";
	Кука.ТотжеСайт = "Lax";
	Кука.ДатаИстечения = Дата(2000, 1, 1);
КонецПроцедуры

Функция ЗначениеКуки(Знач КукиЗапроса, Знач Имя)
	Если КукиЗапроса = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат КукиЗапроса.ПолучитьЗначениеПоИмени(Имя);
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СтраницаДоступа") _Страница,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "КонфигурацияOIDC") _Конфигурация,
	&Пластилин(Значение = "СервисВходаOIDC") _СервисВхода,
