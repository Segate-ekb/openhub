// Публичная страница /confirm-email: человек подтверждает адрес ссылкой из письма и
// просит выслать письмо заново. winow не различает HTTP-метод — разбираем через
// МетодЗапроса.
//
// Подтверждение — это POST по кнопке, а не сам переход по ссылке: почтовые клиенты
// и сканеры безопасности ходят по ссылкам сами, и одноразовый токен сгорал бы, не
// доехав до человека. CSRF-поля у формы подтверждения нет — секрет ссылки и есть то,
// чего у чужого сайта не может быть; у формы повторной отправки сессия есть, и токен
// с неё спрашивается.

Перем Подтверждение;  // СервисПодтвержденияEmail (auth)
Перем Коды;           // КодыПодтверждения (auth) — коды отказов домена
Перем АдресСсылки;    // АдресПодтверждения (auth) — путь страницы и имя параметра
Перем Перехватчик;    // ПерехватчикАутентификации (auth) — принципал запроса
Перем СлужбаСессий;   // СлужбаСессий (auth) — сессия подтвердившему
Перем ВозвратВхода;   // ВозвратПослеВхода (основа) — куда увести после входа
Перем Защита;         // ЗащитаCSRF (auth)
Перем Страница;       // СтраницаДоступа (web-ui) — каркас публичного экрана
Перем Кит;            // Кит (кит) — фабрика элементов экрана
Перем Тексты;         // ТекстыИнтерфейса (кит)
Перем РазборФормы;    // РазборФормы (web-ui)
Перем HTTP;           // МетодыHTTP (основа)

#Область ТочкиМаршрута

// GET /confirm-email — состояние адреса и кнопка подтверждения по ссылке из письма;
// POST — подтверждение адреса либо повторная отправка письма.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow: HTML-страница.
//  ТелоЗапроса - Строка - тело POST-формы.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Куки - куки запроса (сессия и оформление).
//  МетодЗапроса - Строка - HTTP-метод; кроме GET и POST — 405.
//  АдресУдаленногоУзла - Строка - адрес клиента, попадает в журнал аудита.
//  token - Строка - значение ссылки из адреса (необязательный, по умолчанию "").
//
&ТочкаМаршрута("confirm-email")
Процедура Подтверждение_(Ответ, ТелоЗапроса, ЗаголовкиЗапроса, КукиЗапроса, МетодЗапроса,
	АдресУдаленногоУзла, token = "") Экспорт

	Принципал = Перехватчик.ОпределитьПринципала(ЗаголовкиЗапроса, КукиЗапроса);

	Если HTTP.ЭтоМетод(МетодЗапроса, "GET") Тогда
		ОтдатьОбзор(Ответ, Принципал, Строка(token), КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если НЕ HTTP.ЭтоМетод(МетодЗапроса, "POST") Тогда
		Ответ.Заголовки["Allow"] = "GET, POST";
		ОтдатьСообщение(Ответ, Принципал, 405,
			Тексты.Текст("confirm.page.error.method"), "err", КукиЗапроса);
		Возврат;
	КонецЕсли;

	Форма = РазборФормы.Разобрать(ТелоЗапроса);

	Если НРег(СокрЛП(РазборФормы.Поле(Форма, ИмяПоляОперации()))) = ОперацияПовтора() Тогда
		ВыслатьЗаново(Ответ, Принципал, Форма, КукиЗапроса, Строка(АдресУдаленногоУзла));
		Возврат;
	КонецЕсли;

	Значение = РазборФормы.Поле(Форма, АдресСсылки.ИмяПараметра(), Строка(token));
	Исход = Подтверждение.Подтвердить(Значение, Неопределено, Строка(АдресУдаленногоУзла));

	Если НЕ Исход.Успех Тогда
		ОтдатьСообщение(Ответ, Принципал, КодОтказа(Исход.Причина),
			ТекстОтказа(Исход.Причина), "err", КукиЗапроса);
		Возврат;
	КонецЕсли;

	// сюда приходят с неподтверждённым адресом, то есть заперты снаружи: нажал кнопку —
	// и уже внутри. Просить пароль сразу после ссылки из письма — лишний круг, а войти
	// человеку всё равно предстоит
	Если ПользовательПринципала(Принципал) = Неопределено Тогда
		ВпуститьПоПодтверждению(Ответ, Исход.Пользователь);
		Возврат;
	КонецЕсли;

	ОтдатьСообщение(Ответ, Принципал, 200,
		Тексты.Шаблон("confirm.page.done", Строка(Исход.Пользователь.Email)), "ok", КукиЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Операции

// Письмо уходит только на адрес учётки запросившего: получателя форма не называет,
// и рассылку с хаба этой кнопкой не устроить.
Процедура ВыслатьЗаново(Ответ, Знач Принципал, Знач Форма, Знач КукиЗапроса, Знач АдресIP)

	Пользователь = ПользовательПринципала(Принципал);
	Если Пользователь = Неопределено Тогда
		ВыслатьПоНазванному(Ответ, Принципал, Форма, КукиЗапроса, АдресIP);
		Возврат;
	КонецЕсли;

	Если НЕ Защита.Проверить(Принципал.Сессия,
		РазборФормы.Поле(Форма, Защита.ИмяПоля())) Тогда
		ОтдатьСообщение(Ответ, Принципал, 403,
			Тексты.Текст("confirm.page.error.form"), "err", КукиЗапроса);
		Возврат;
	КонецЕсли;

	Итог = Подтверждение.Запросить(Пользователь, Неопределено, АдресIP);
	Если НЕ Итог.Отправлено Тогда
		ОтдатьСообщение(Ответ, Принципал, КодОтказа(Итог.Причина),
			ТекстОтказа(Итог.Причина), "err", КукиЗапроса);
		Возврат;
	КонецЕсли;

	ОтдатьСообщение(Ответ, Принципал, 200,
		Тексты.Шаблон("confirm.page.resend.done", Строка(Пользователь.Email)), "ok",
		КукиЗапроса);

КонецПроцедуры

// Открывает сессию подтвердившему и уводит в кабинет. Ссылку выпустил сам хаб, она
// одноразовая и уже погашена подтверждением, а нажатие кнопки на странице отличает
// человека от почтового сканера.
Процедура ВпуститьПоПодтверждению(Ответ, Знач Пользователь)

	Сессия = СлужбаСессий.Создать(Пользователь.Идентификатор);

	Кука = Ответ.Куки.Добавить(Перехватчик.ИмяКукиСессии(), Сессия.Идентификатор());
	Кука.ТолькоХттп = Истина;
	Кука.Путь = "/";
	Кука.ТотжеСайт = "Lax";

	Ответ.Перенаправить(ВозвратВхода.ПутьПоУмолчанию());

КонецПроцедуры

// Тот, кого хаб не пустил внутрь, сессии не имеет — и просит письмо, называя себя сам.
// Ответ один и тот же, нашлась учётка или нет: иначе перебором логинов вычислялись бы
// существующие. CSRF-поля у формы нет по той же причине, что и у формы восстановления:
// защищать нечего — своей учётки у запросившего в этот момент ещё нет.
Процедура ВыслатьПоНазванному(Ответ, Знач Принципал, Знач Форма, Знач КукиЗапроса,
	Знач АдресIP)

	Итог = Подтверждение.ЗапроситьПоНазванному(
		РазборФормы.Поле(Форма, ИмяПоляУчётки()), Неопределено, АдресIP);

	Если НЕ Итог.Принято Тогда
		ОтдатьСообщение(Ответ, Принципал, КодОтказа(Итог.Причина),
			ТекстОтказа(Итог.Причина), "err", КукиЗапроса);
		Возврат;
	КонецЕсли;

	ОтдатьСообщение(Ответ, Принципал, 200,
		Тексты.Текст("confirm.page.request.done"), "ok", КукиЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Рендер

// Страница без токена рассказывает состояние адреса; с токеном — предлагает кнопку.
Процедура ОтдатьОбзор(Ответ, Знач Принципал, Знач Значение, Знач КукиЗапроса)

	Если ЗначениеЗаполнено(Значение) Тогда
		ОтдатьПоСсылке(Ответ, Принципал, Значение, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Пользователь = ПользовательПринципала(Принципал);
	Если Пользователь = Неопределено Тогда
		ОтдатьЗапросПисьма(Ответ, Принципал, КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Пользователь.Email) Тогда
		ОтдатьСообщение(Ответ, Принципал, 200,
			Тексты.Текст("confirm.page.state.noemail"), "warn", КукиЗапроса);
		Возврат;
	КонецЕсли;

	Если Пользователь.EmailПодтверждён = Истина Тогда
		ОтдатьСообщение(Ответ, Принципал, 200,
			Тексты.Шаблон("confirm.page.state.confirmed", Строка(Пользователь.Email)), "ok",
			КукиЗапроса);
		Возврат;
	КонецЕсли;

	Тело = ТелоСтраницы();
	Тело.Добавить(Кит.Примечание(
		Тексты.Шаблон("confirm.page.resend.lead", Строка(Пользователь.Email))));
	Тело.Добавить(ФормаПовтора(Принципал));

	Отдать(Ответ, Принципал, 200, Тело, КукиЗапроса);

КонецПроцедуры

// Не вошёл и ссылки при себе не имеет: единственное, что ему тут нужно, — попросить
// письмо. Прежний текст «войдите в учётную запись» отправлял в тупик того, кого вход
// как раз и не пустил.
Процедура ОтдатьЗапросПисьма(Ответ, Знач Принципал, Знач КукиЗапроса)

	Тело = ТелоСтраницы();
	Тело.Добавить(Кит.Примечание(Тексты.Текст("confirm.page.request.lead")));
	Тело.Добавить(ФормаЗапросаПисьма());
	Тело.Добавить(Страница.СноскаВхода());

	Отдать(Ответ, Принципал, 200, Тело, КукиЗапроса);

КонецПроцедуры

Функция ФормаЗапросаПисьма()

	Результат = Кит.ФормаБезСессии(АдресСсылки.Путь(), "столбик");

	Результат.Добавить(Кит.СкрытоеПоле(ИмяПоляОперации(), ОперацияПовтора()));
	Результат.Добавить(Кит.Поле(Новый Структура("Имя, Метка, Автозаполнение",
		ИмяПоляУчётки(), Тексты.Текст("confirm.page.request.field"), "username")));
	Результат.Добавить(Страница.КнопкаФормы(Тексты.Текст("confirm.page.request.button")));

	Возврат Результат;

КонецФункции

Процедура ОтдатьПоСсылке(Ответ, Знач Принципал, Знач Значение, Знач КукиЗапроса)

	Проверка = Подтверждение.Проверить(Значение);
	Если НЕ Проверка.Годна Тогда
		ОтдатьСообщение(Ответ, Принципал, КодОтказа(Проверка.Причина),
			ТекстОтказа(Проверка.Причина), "err", КукиЗапроса);
		Возврат;
	КонецЕсли;

	Тело = ТелоСтраницы();
	Тело.Добавить(Кит.Примечание(Тексты.Шаблон("confirm.page.lead",
		Строка(Проверка.Пользователь.Логин), Строка(Проверка.Пользователь.Email))));
	Тело.Добавить(ФормаПодтверждения(Значение));

	Отдать(Ответ, Принципал, 200, Тело, КукиЗапроса);

КонецПроцедуры

Процедура ОтдатьСообщение(Ответ, Знач Принципал, Знач Статус, Знач Сообщение, Знач Вид,
	Знач КукиЗапроса)

	Тело = ТелоСтраницы();
	Тело.Добавить(Страница.Уведомление(Сообщение, Вид));
	Тело.Добавить(Страница.СноскаВхода());

	Отдать(Ответ, Принципал, Статус, Тело, КукиЗапроса);

КонецПроцедуры

// Заголовок стоит на каждой выдаче страницы, поэтому тело начинается с него.
Функция ТелоСтраницы()

	Результат = Кит.Холст();
	Результат.Добавить(Страница.Заголовок(Заголовок()));
	Возврат Результат;

КонецФункции

Процедура Отдать(Ответ, Знач Принципал, Знач Статус, Знач Тело, Знач КукиЗапроса)
	Страница.Отдать(Ответ, Статус, Заголовок(), Тело, КукиЗапроса, ПользовательПринципала(Принципал));
КонецПроцедуры

// Форма подтверждения по ссылке: сессии у пришедшего из письма может не быть вовсе,
// и защищает здесь секрет самой ссылки.
Функция ФормаПодтверждения(Знач Значение)

	Результат = Кит.ФормаБезСессии(АдресСсылки.Путь(), "столбик");

	Результат.Добавить(Кит.СкрытоеПоле(АдресСсылки.ИмяПараметра(), Значение));
	Результат.Добавить(Страница.КнопкаФормы(Тексты.Текст("confirm.page.button")));

	Возврат Результат;

КонецФункции

// Повторное письмо просит вошедший — у него есть сессия, и токен с неё спрашивается.
Функция ФормаПовтора(Знач Принципал)

	Результат = Кит.Форма(АдресСсылки.Путь(),
		Защита.ТокенСессии(Принципал.Сессия), "столбик");

	Результат.Добавить(Кит.СкрытоеПоле(ИмяПоляОперации(), ОперацияПовтора()));
	Результат.Добавить(Страница.КнопкаФормы(Тексты.Текст("confirm.page.resend.button")));

	Возврат Результат;

КонецФункции

Функция Заголовок()
	Возврат Тексты.Текст("confirm.page.title");
КонецФункции

#КонецОбласти

#Область Служебное

// Домен отдаёт код причины, экранный текст собирается здесь: каждый известный код —
// своя ветка, нераспознанный получает общий текст, а не текст соседней причины.
Функция ТекстОтказа(Знач Причина)

	Если Причина = Коды.Просрочена() Тогда
		Возврат Тексты.Текст("confirm.page.error.expired");
	ИначеЕсли Причина = Коды.Погашена() Тогда
		Возврат Тексты.Текст("confirm.page.error.used");
	ИначеЕсли Причина = Коды.НетУчётки() Тогда
		Возврат Тексты.Текст("confirm.page.error.nouser");
	ИначеЕсли Причина = Коды.АдресСменился() Тогда
		Возврат Тексты.Текст("confirm.page.error.changed");
	ИначеЕсли Причина = Коды.Выключено() Тогда
		Возврат Тексты.Текст("confirm.page.error.off");
	ИначеЕсли Причина = Коды.УжеПодтверждён() Тогда
		Возврат Тексты.Текст("confirm.page.error.already");
	ИначеЕсли Причина = Коды.НетАдреса() Тогда
		Возврат Тексты.Текст("confirm.page.state.noemail");
	ИначеЕсли Причина = Коды.НетАдресаХаба() Тогда
		Возврат Тексты.Текст("confirm.page.error.mail");
	ИначеЕсли Причина = Коды.Отправка() Тогда
		Возврат Тексты.Текст("confirm.page.error.send");
	ИначеЕсли Причина = Коды.АдресНеГоден() Тогда
		Возврат Тексты.Текст("confirm.page.error.address");
	ИначеЕсли Коды.ЭтоОтказПочты(Причина) Тогда
		Возврат Тексты.Текст("confirm.page.error.mail");
	КонецЕсли;

	Возврат Тексты.Текст("confirm.page.error.unknown");

КонецФункции

// Негодность ссылки — 410 «ушло навсегда» для просроченной и погашенной, 404 для
// неизвестной: разные коды у одинакового с виду отказа помогают разбирать обращения.
Функция КодОтказа(Знач Причина)

	Если Причина = Коды.Просрочена() ИЛИ Причина = Коды.Погашена()
		ИЛИ Причина = Коды.АдресСменился() Тогда
		Возврат 410;
	ИначеЕсли Причина = Коды.Выключено() ИЛИ Коды.ЭтоОтказПочты(Причина)
		ИЛИ Причина = Коды.НетАдресаХаба() Тогда
		Возврат 503;
	ИначеЕсли Причина = Коды.УжеПодтверждён()
		ИЛИ Причина = Коды.НетАдреса() Тогда
		Возврат 400;
	КонецЕсли;

	Возврат 404;

КонецФункции

Функция ПользовательПринципала(Знач Принципал)
	Возврат ?(Принципал = Неопределено, Неопределено, Принципал.Пользователь);
КонецФункции

Функция ИмяПоляОперации()
	Возврат "операция";
КонецФункции

Функция ОперацияПовтора()
	Возврат "выслать";
КонецФункции

Функция ИмяПоляУчётки()
	Возврат "учётка";
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисПодтвержденияEmail") _Подтверждение,
	&Пластилин(Значение = "КодыПодтверждения") _Коды,
	&Пластилин(Значение = "АдресПодтверждения") _АдресСсылки,
	&Пластилин(Значение = "ПерехватчикАутентификации") _Перехватчик,
	&Пластилин(Значение = "СлужбаСессий") _СлужбаСессий,
	&Пластилин(Значение = "ВозвратПослеВхода") _ВозвратВхода,
	&Пластилин(Значение = "ЗащитаCSRF") _Защита,
	&Пластилин(Значение = "СтраницаДоступа") _Страница,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "РазборФормы") _РазборФормы,
	&Пластилин(Значение = "МетодыHTTP") _HTTP)

	Подтверждение = _Подтверждение;
	Коды = _Коды;
	АдресСсылки = _АдресСсылки;
	Перехватчик = _Перехватчик;
	СлужбаСессий = _СлужбаСессий;
	ВозвратВхода = _ВозвратВхода;
