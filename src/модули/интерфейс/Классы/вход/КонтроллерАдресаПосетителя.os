// Публичная страница /whoami: адрес и страна, какими хаб видит запрос посетителя. Ссылок
// на неё нет — её дают человеку, у которого на странице входа пропал способ входа.

Перем Страница;      // СтраницаДоступа (интерфейс) — каркас публичного экрана
Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем Тексты;        // ТекстыИнтерфейса (кит)
Перем Посетители;    // ПосетительЗапроса (гео) — адрес и заголовки одним значением
Перем Определитель;  // ОпределительСтраны (гео) — та же дверь, что судит вход
Перем Геоправило;    // ГеоправилоПровайдера (вход) — есть ли правила, ради которых страну спрашивают
Перем Атрибуция;     // АтрибуцияБазыСтран (интерфейс) — условие лицензии базы стран
Перем Кэш;           // ЗаголовкиКэша (основа) — страница у каждого посетителя своя

#Область ТочкиМаршрута

// GET /whoami — адрес клиента и страна, какими их видит хаб. Страница только читает:
// гейт входа она не спрашивает, отказов не считает и журнала не пишет.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow: HTML-страница.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса (страна от доверенного прокси).
//  КукиЗапроса - Куки - куки запроса (оформление).
//  АдресУдаленногоУзла - Строка - адрес клиента; за доверенным прокси — адрес человека.
//
&ТочкаМаршрута("whoami")
Процедура КакХабВидитЗапрос(Ответ, ЗаголовкиЗапроса, КукиЗапроса, АдресУдаленногоУзла) Экспорт

	Посетитель = Посетители.Собрать(АдресУдаленногоУзла, ЗаголовкиЗапроса);
	Вердикт = ВердиктПоСтране(Посетитель);

	Тело = Кит.Холст();
	Тело.Добавить(Страница.Заголовок(Заголовок()));
	Тело.Добавить(АдресИСтрана(Посетитель.Адрес, Вердикт));
	Тело.Добавить(Справка(Вердикт));
	Тело.Добавить(АтрибуцияСтраны(Вердикт));

	Кэш.ЗакрытьСтраницу(Ответ);
	Ответ.Заголовки["X-Robots-Tag"] = "noindex";
	Страница.Отдать(Ответ, 200, Заголовок(), Тело, КукиЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Рендер

Функция АдресИСтрана(Знач Адрес, Знач Вердикт)

	Результат = Кит.Свойства();
	Результат.Добавить(Кит.Свойство(Тексты.Текст("whoami.page.address")))
		.Добавить(Кит.Код(Строка(Адрес)));
	Результат.Добавить(Кит.Свойство(Тексты.Текст("whoami.page.country")))
		.Добавить(ЗначениеСтраны(Вердикт));
	Возврат Результат;

КонецФункции

Функция ЗначениеСтраны(Знач Вердикт)

	Если ПравилНет(Вердикт) Тогда
		Возврат Кит.Текст(Тексты.Текст("whoami.country.off"));
	КонецЕсли;

	Если Вердикт.Исход = Определитель.Исходы().Известна Тогда
		Возврат Кит.Код(Вердикт.Страна);
	КонецЕсли;

	Если Вердикт.Исход = Определитель.Исходы().НеНаблюдаемая Тогда
		Возврат Кит.Текст(Тексты.Шаблон("whoami.country.unwatched",
			СтрСоединить(Определитель.НаблюдаемыеСтраны(), ", ")));
	КонецЕсли;

	// причину не печатаем: это диагностика администратора — путь к файлу базы, текст сбоя
	Возврат Кит.Текст(Тексты.Текст("whoami.country.unknown"));

КонецФункции

// Правил нет — страна ничего не решает, и объяснять, что с ней делать, незачем.
Функция Справка(Знач Вердикт)

	Если ПравилНет(Вердикт) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Кит.Примечание(Тексты.Текст("whoami.page.hint"));

КонецФункции

Функция АтрибуцияСтраны(Знач Вердикт)

	Если ПравилНет(Вердикт) ИЛИ Вердикт.Источник <> Определитель.ИсточникБазы() Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Возврат Атрибуция.Примечание();

КонецФункции

Функция Заголовок()
	Возврат Тексты.Текст("whoami.page.title");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вердикт той же двери, что у гейта входа. Пока правил нет, определитель не зовётся вовсе.
Функция ВердиктПоСтране(Знач Посетитель)

	Попытка
		Если НЕ Геоправило.ЕстьПравила() Тогда
			Возврат ВердиктБезПравил();
		КонецЕсли;
		Возврат Определитель.ОпределитьПоЗапросу(Посетитель.Адрес, Посетитель.Заголовки);
	Исключение
		Возврат ВердиктСбоя();
	КонецПопытки;

КонецФункции

Функция ПравилНет(Знач Вердикт)
	Возврат Вердикт = ВердиктБезПравил();
КонецФункции

Функция ВердиктБезПравил()
	Возврат Неопределено;
КонецФункции

// Страница не вправе упасть: не смогли проверить — страна «не определена», как и у гейта.
Функция ВердиктСбоя()
	Возврат Новый Структура("Исход, Страна, Источник", Определитель.Исходы().Неизвестна, "", "");
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СтраницаДоступа") _Страница,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ПосетительЗапроса") _Посетители,
	&Пластилин(Значение = "ОпределительСтраны") _Определитель,
	&Пластилин(Значение = "ГеоправилоПровайдера") _Геоправило,
	&Пластилин(Значение = "АтрибуцияБазыСтран") _Атрибуция,
	&Пластилин(Значение = "ЗаголовкиКэша") _Кэш)

	Страница = _Страница;
	Кит = _Кит;
	Тексты = _Тексты;
	Посетители = _Посетители;
	Определитель = _Определитель;
	Геоправило = _Геоправило;
	Атрибуция = _Атрибуция;
	Кэш = _Кэш;

КонецПроцедуры
