// Человекочитаемые объяснения отказов страницы входа и их HTTP-коды. Нераспознанный код
// получает общий текст, а не текст соседней причины.

Перем СервисАутентификации; // СервисАутентификации (auth) — код «парольный вход выключен»
Перем ГейтАдреса;           // ГейтПодтвержденияАдреса (auth) — код «адрес не подтверждён»
Перем ОтказыУчётки;         // ОтказыУчётки (auth) — причины отказа завести учётку

// Объяснение отказа регистрации на форме /register. Причина одна на все двери
// (таблица `ОтказыУчётки`), а слова — экранные: они зовут человека туда, где выход.
//
// Параметры:
//  Причина - Строка - код причины отказа; "" — причина не названа.
//  Сообщение - Строка - текст отказа, пришедший из службы; показывается, когда причина
//              не названа (ошибка ввода, политика пароля).
//
// Возвращаемое значение:
//  Строка - что произошло и что делать дальше.
//
Функция ОтказРегистрации(Знач Причина, Знач Сообщение) Экспорт

	Если Причина = ОтказыУчётки.ОнбордингНеЗавершён() Тогда
		Возврат "Сначала создайте администратора на странице первого запуска (/setup).";
	ИначеЕсли Причина = ОтказыУчётки.ПарольныйВходВыключен() Тогда
		Возврат "Вход по логину и паролю на этом хабе выключен, поэтому регистрация"
			+ " с паролем закрыта. Войдите через провайдера на странице входа.";
	ИначеЕсли Причина = ОтказыУчётки.РегистрацияВыключена() Тогда
		Возврат "Регистрация на этом хабе отключена. Учётные записи создаёт администратор.";
	ИначеЕсли Причина = ОтказыУчётки.ТолькоПоПриглашению() Тогда
		Возврат "Регистрация только по приглашению. Попросите администратора завести вам"
			+ " учётную запись: он выдаст одноразовую ссылку, по которой вы зададите"
			+ " пароль и войдёте.";
	ИначеЕсли Причина = ОтказыУчётки.ПочтаНеНастроена() Тогда
		Возврат "Регистрация закрыта: на хабе включено подтверждение адреса письмом,"
			+ " а отправка почты не настроена. Это настройка хаба, а не ваши данные —"
			+ " администратору нужно либо настроить почту, либо выключить подтверждение"
			+ " адреса в настройках хаба.";
	ИначеЕсли Причина = ОтказыУчётки.АдресЗанят() Тогда
		Возврат "Этот адрес электронной почты уже занят. Укажите другой или войдите"
			+ " в свою учётную запись.";
	ИначеЕсли Причина = ОтказыУчётки.ЛогинЗанят() Тогда
		Возврат "Такой логин уже занят: имена учётных записей и пулов делят первый сегмент"
			+ " адреса. Выберите другой логин или войдите в свою учётную запись.";
	КонецЕсли;
	Возврат Сообщение;

КонецФункции

// Объяснение отказа возврата от провайдера. Текст — часть контракта с пользователем
// и проверяется тестом напрямую.
//
// Параметры:
//  Причина - Строка - код исхода СервисВходаOIDC.Завершить.
//
// Возвращаемое значение:
//  Строка - что произошло и что делать дальше.
//
Функция ОтказПровайдера(Знач Причина) Экспорт

	Если Причина = "state_mismatch" Тогда
		Возврат "Проверка состояния входа не прошла (возможно, устаревшая ссылка). Повторите вход.";
	ИначеЕсли Причина = "provisioning_disabled" Тогда
		Возврат "Эта личность провайдера не привязана ни к одной учётной записи хаба."
			+ " Войдите логином и паролем и привяжите провайдера в настройках аккаунта"
			+ " (/me/settings/oidc) — либо попросите администратора включить создание"
			+ " учётной записи при первом входе: в разделе «Провайдеры входа»"
			+ " (/hub/settings/providers) либо переменной OSHUB_OIDC_<ID>_AUTOPROVISION.";
	ИначеЕсли Причина = "identity_taken" Тогда
		Возврат "Эта личность уже привязана к другому пользователю.";
	ИначеЕсли Причина = ОтказыУчётки.Код(ОтказыУчётки.АдресЗанят()) Тогда
		// код исхода рождает СервисАвтопривязки через АдресУчётки.ПричинаЗанят: смена
		// наружного кода в таблице молча оставила бы это объяснение непоказанным
		Возврат "Адрес электронной почты из профиля провайдера уже принадлежит другой"
			+ " учётной записи хаба. Войдите в неё и привяжите провайдера в настройках"
			+ " аккаунта (/me/settings/oidc) — либо смените адрес у провайдера.";
	КонецЕсли;
	Возврат "Не удалось завершить вход через провайдера.";

КонецФункции

// Объяснение отказа входа по паролю. Причина отказа по учётке клиенту не раскрывается:
// «неверный логин или пароль» на оба случая.
//
// Параметры:
//  Причина - Строка - код исхода СервисАутентификации.ВойтиПоПаролю.
//  Письмо - Структура, Неопределено - исход ГейтПодтвержденияАдреса.НапомнитьПисьмом:
//           Успех, Причина (код), Сообщение (слова сбоя), СсылкаБыла — текст читает
//           только последнее (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Строка.
//
Функция ОтказПароля(Знач Причина, Знач Письмо = Неопределено) Экспорт

	Если Причина = СервисАутентификации.ПричинаВыключен() Тогда
		Возврат "Вход по логину и паролю на этом хабе выключен: войдите через провайдера.";
	ИначеЕсли Причина = "rate_limited" Тогда
		Возврат "Слишком много попыток входа, попробуйте позже";
	ИначеЕсли Причина = ГейтАдреса.Причина() Тогда
		Возврат АдресНеПодтверждён(Письмо);
	КонецЕсли;
	Возврат "Неверный логин или пароль";

КонецФункции

// Уже отправленное письмо новым не заменяется: человека надо вернуть к тому, что у него на руках.
Функция АдресНеПодтверждён(Знач Письмо)

	Начало = "Адрес электронной почты этой учётной записи не подтверждён, поэтому вход"
		+ " закрыт.";
	Страница = " Письма нет под рукой — запросите новое на странице /confirm-email.";

	Если Письмо <> Неопределено И Письмо.СсылкаБыла = Истина Тогда
		Возврат Начало + " Письмо со ссылкой мы уже отправляли — откройте его и нажмите"
			+ " кнопку подтверждения." + Страница;
	КонецЕсли;

	Возврат Начало + " Мы выслали на него письмо со ссылкой — откройте её и нажмите"
		+ " кнопку подтверждения, после этого входите как обычно." + Страница;

КонецФункции

// HTTP-код отказа входа по паролю.
//
// Параметры:
//  Причина - Строка - код исхода СервисАутентификации.ВойтиПоПаролю.
//
// Возвращаемое значение:
//  Число.
//
Функция КодОтказаПароля(Знач Причина) Экспорт

	Если Причина = СервисАутентификации.ПричинаВыключен()
		ИЛИ Причина = ГейтАдреса.Причина() Тогда
		Возврат 403;
	КонецЕсли;
	Возврат ?(Причина = "rate_limited", 429, 401);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисАутентификации") _СервисАутентификации,
	&Пластилин(Значение = "ГейтПодтвержденияАдреса") _ГейтАдреса,
	&Пластилин(Значение = "ОтказыУчётки") _ОтказыУчётки)

	СервисАутентификации = _СервисАутентификации;
	ГейтАдреса = _ГейтАдреса;
	ОтказыУчётки = _ОтказыУчётки;

КонецПроцедуры
