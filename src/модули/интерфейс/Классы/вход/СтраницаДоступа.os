// Общий каркас публичных экранов входа: заголовок, уведомление, кнопка формы, ход ко входу
// и отправка ответа. Экраны отличаются содержимым, каркас у них один.

Перем Кит;           // Кит (кит) — фабрика элементов экрана
Перем Каркас;        // КаркасСтраницы (кит) — корень страницы
Перем Тексты;        // ТекстыИнтерфейса (кит)
Перем ВозвратВхода;  // ВозвратПослеВхода (основа) — адрес страницы входа

#Область ПубличныйИнтерфейс

// Отдаёт собранную страницу: тело печатается деревом, вокруг него встаёт каркас хаба.
//
// Параметры:
//  Ответ        - ОтветСервера  - ответ winow.
//  Статус       - Число         - код состояния ответа.
//  Вкладка      - Строка        - заголовок вкладки браузера.
//  Тело         - ЭлементЭкрана - содержимое страницы.
//  КукиЗапроса  - Куки, Неопределено - куки запроса: из них берётся оформление читателя.
//  Пользователь - Пользователь, Неопределено - принципал запроса; аноним — Неопределено
//                 (необязательный, по умолчанию Неопределено).
//
Процедура Отдать(Ответ, Знач Статус, Знач Вкладка, Знач Тело, Знач КукиЗапроса,
	Знач Пользователь = Неопределено) Экспорт

	Ответ.УстановитьСостояние(Статус);
	Ответ.УстановитьТипКонтента("html");
	Ответ.ТелоТекст = Каркас.Страница(Вкладка, Тело.Рендер(),
		Каркас.КонтекстСтраницы(Пользователь, КукиЗапроса));

КонецПроцедуры

// Заголовок страницы — первая строка экрана.
//
// Параметры:
//  Текст - Строка - текст заголовка.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Заголовок(Знач Текст) Экспорт

	Результат = Кит.Заголовок(1);
	Результат.Добавить(Кит.Текст(Текст));
	Возврат Результат;

КонецФункции

// Уведомление об исходе действия. Пустой текст не печатается вовсе — поэтому сборщик
// экрана остаётся одной строкой и там, где уведомления может не быть.
//
// Параметры:
//  Текст - Строка - сообщение человеку.
//  Вид   - Строка - «err» (отказ) | «warn» (предупреждение) | «ok» (получилось).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Уведомление(Знач Текст, Знач Вид) Экспорт

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Кит.Холст();
	КонецЕсли;

	Возврат Кит.Уведомление(Новый Структура("Текст, Вид", Текст, Вид));

КонецФункции

// Кнопка отправки формы доступа: на такой форме она одна и стоит во всю ширину.
//
// Параметры:
//  Подпись - Строка - надпись на кнопке.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция КнопкаФормы(Знач Подпись) Экспорт
	Возврат Кит.Кнопка(Новый Структура("Подпись, ВоВсюШирину", Подпись, Истина));
КонецФункции

// Сноска со ссылкой на вход: ею кончаются экраны, с которых человеку дальше входить.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция СноскаВхода() Экспорт

	Результат = Кит.Примечание();
	Результат.Добавить(СсылкаВхода());
	Возврат Результат;

КонецФункции

// Ссылка на страницу входа — её ставят и в середину своей фразы.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция СсылкаВхода() Экспорт

	Результат = Кит.Ссылка(ВозвратВхода.ПутьВхода());
	Результат.Добавить(Кит.Текст(Тексты.Текст("access.page.login")));
	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ВозвратПослеВхода") _ВозвратВхода) Экспорт

	Кит = _Кит;
	Каркас = _Каркас;
	Тексты = _Тексты;
	ВозвратВхода = _ВозвратВхода;

КонецПроцедуры
