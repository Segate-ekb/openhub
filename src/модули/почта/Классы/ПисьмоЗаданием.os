// Одно письмо, отданное транспорту в фоне. Исход задания не смотрит никто, поэтому своё
// исключение оно ловит само, а результат называет журналу.

Перем Транспорт; // ОтправительПисем (почта)
Перем Письмо;    // Структура: Кому, Тема, Текст, ОтКого
Перем Приметы;   // Структура: Получатель (адрес как есть — ящик снимает дверь журнала), Сервер («хост:порт»)
Перем Ошибки;    // ТекстОшибки (основа)
Перем Лог;

// Отдаёт письмо транспорту. Контракт обработчика ЗапускВФоне.
//
Процедура Исполнить() Экспорт

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Транспорт.Отправить(Письмо);
		// ни темы, ни тела: письмо хаба несёт ссылку подтверждения, а журнал читают шире,
		// чем почтовый ящик; ящик получателя снимает дверь выхода журнала
		Лог.Информация("Фоновое письмо: сервер %1 принял письмо получателю %2 за %3 мс",
			Приметы.Сервер, Приметы.Получатель, Потрачено(Начало));
	Исключение
		Причина = Ошибки.Причина(ИнформацияОбОшибке());
		Лог.Ошибка("Фоновое письмо не отправлено — %1. Получатель %2, сервер %3,"
			+ " попытка заняла %4 мс. Проверьте настройки почты хаба.",
			Причина, Приметы.Получатель, Приметы.Сервер, Потрачено(Начало));
	КонецПопытки;

КонецПроцедуры

// Числом без разделителей групп и с НУЛЁМ вместо пустого места: длительность ищут
// поиском по журналу, а «за  мс» — это не ноль миллисекунд, а потерянное значение.
Функция Потрачено(Знач Начало)
	Возврат Формат(ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало, "ЧГ=0; ЧН=0");
КонецФункции

Процедура ПриСозданииОбъекта(Знач _Транспорт, Знач _Письмо, Знач _Лог, Знач _Приметы)

	Транспорт = _Транспорт;
	Письмо = _Письмо;
	Лог = _Лог;
	Приметы = _Приметы;
	Ошибки = Новый ТекстОшибки();

КонецПроцедуры
