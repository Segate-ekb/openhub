// Одно письмо, отданное транспорту в фоне. Исход задания не смотрит никто, поэтому своё
// исключение оно ловит само.

Перем Транспорт; // ОтправительПисем (почта)
Перем Письмо;    // Структура: Кому, Тема, Текст, ОтКого
Перем Лог;

// Отдаёт письмо транспорту. Контракт обработчика ЗапускВФоне.
//
Процедура Исполнить() Экспорт

	Попытка
		Транспорт.Отправить(Письмо);
		// в журнал не идёт ни адрес, ни тема, ни тело — только факт, что фон дошёл до конца
		Лог.Отладка("Фоновое письмо: транспорт принял письмо");
	Исключение
		// ни адреса получателя, ни темы, ни тела: письмо хаба несёт ссылку подтверждения,
		// а журнал читают шире, чем почтовый ящик
		Лог.Ошибка("Письмо не отправлено: %1. Проверьте настройки почты хаба.",
			СтрЗаменить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Символы.ПС, " "));
	КонецПопытки;

КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач _Транспорт, Знач _Письмо, Знач _Лог)

	Транспорт = _Транспорт;
	Письмо = _Письмо;
	Лог = _Лог;

КонецПроцедуры
