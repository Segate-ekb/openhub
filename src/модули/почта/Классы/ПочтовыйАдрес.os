// Что почтовый слой считает годным адресом и чистой строкой заголовка — одно место
// на получателя, отправителя и тему: разрыв строки в любом из них дописывает чужие заголовки.

// Годен ли адрес: непустой, ровно одна собака, без пробелов и разрывов.
//
// Параметры:
//  Адрес - Строка - проверяемый адрес.
//
// Возвращаемое значение:
//  Булево.
//
Функция Годен(Знач Адрес) Экспорт

	Значение = СокрЛП(Строка(Адрес));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрРазделить(Значение, "@", Истина).Количество() <> 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат НЕ ЕстьРазрывИлиПробел(Значение);

КонецФункции

// Есть ли в строке пробел, разрыв строки либо иной символ, которому не место
// в адресе письма.
//
// Параметры:
//  Значение - Строка - проверяемая строка.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьРазрывИлиПробел(Знач Значение) Экспорт

	Строка_ = Строка(Значение);
	Для НомерСимвола = 1 По СтрДлина(Строка_) Цикл
		Символ = Сред(Строка_, НомерСимвола, 1);
		Если Символ = " " ИЛИ ЗапрещённыйСимвол(Символ) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Строка в одну строку: всё, чем разделяют строки заголовка, схлопывается в пробел.
//
// Параметры:
//  Значение - Строка - исходная строка.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОднойСтрокой(Знач Значение) Экспорт

	Исходная = Строка(Значение);
	Результат = "";
	Для НомерСимвола = 1 По СтрДлина(Исходная) Цикл
		Символ = Сред(Исходная, НомерСимвола, 1);
		Результат = Результат + ?(ЗапрещённыйСимвол(Символ), " ", Символ);
	КонецЦикла;
	Возврат СокрЛП(Результат);

КонецФункции

// Управляющие, DEL, NEL, неразрывный пробел и разделители строк и абзацев Юникода.
Функция ЗапрещённыйСимвол(Знач Символ)

	Код = КодСимвола(Символ);
	Возврат Код < 32 ИЛИ Код = 127 ИЛИ Код = 133 ИЛИ Код = 160
		ИЛИ Код = 8232 ИЛИ Код = 8233;

КонецФункции

&Прозвище("ПочтовыйАдрес")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
