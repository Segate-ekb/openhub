// Ключи настроек исходящей почты: выключатель, сервер SMTP с учёткой и адрес отправителя.

Перем Ключи;  // ОбъявленияНастроек (настройки)

#Область ПубличныйИнтерфейс

// Объявления ключей почты в порядке показа.
//
// Возвращаемое значение:
//  ОбъявленияНастроек - ключи почты.
//
Функция Объявления() Экспорт
	Возврат Ключи;
КонецФункции

#КонецОбласти

&Прозвище("КлючиНастроек")
&Порядок(90)
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВидыПроверок") _Правила,
	&Деталька(Значение = "oshub.mail.enabled", ЗначениеПоУмолчанию = "") _ПочтаВключена = "",
	&Деталька(Значение = "oshub.mail.smtp.host", ЗначениеПоУмолчанию = "") _ХостSMTP = "",
	&Деталька(Значение = "oshub.mail.smtp.port", ЗначениеПоУмолчанию = "") _ПортSMTP = "",
	&Деталька(Значение = "oshub.mail.smtp.user", ЗначениеПоУмолчанию = "") _ПользовательSMTP = "",
	&Деталька(Значение = "oshub.mail.smtp.password", ЗначениеПоУмолчанию = "") _ПарольSMTP = "",
	&Деталька(Значение = "oshub.mail.from", ЗначениеПоУмолчанию = "") _ОтправительПисем = "") Экспорт

	Ключи = Новый ОбъявленияНастроек();

	// Выключена по умолчанию: хаб без своего SMTP обязан работать, а включённая пустая
	// настройка молча копила бы неотправленные письма.
	Ключи.Объявить("oshub.mail.enabled", "булево", Ложь, Неопределено, "прикладная", _ПочтаВключена);
	Ключи.Объявить("oshub.mail.smtp.host", "строка", "", Неопределено, "прикладная", _ХостSMTP);
	Ключи.Объявить("oshub.mail.smtp.port", "целое", 587, _Правила.Минимум(1), "прикладная", _ПортSMTP);
	Ключи.Объявить("oshub.mail.smtp.user", "строка", "", Неопределено, "прикладная", _ПользовательSMTP);
	// Пароль SMTP вводят из формы: поле открывается пустым, а карточка отдаёт маску. Кому база
	// не годится — задаёт переменной окружения, и поле запирается.
	Ключи.ОбъявитьСекрет("oshub.mail.smtp.password", "строка", "", Неопределено, "прикладная", _ПарольSMTP);
	Ключи.Объявить("oshub.mail.from", "строка", "", Неопределено, "прикладная", _ОтправительПисем);

КонецПроцедуры
