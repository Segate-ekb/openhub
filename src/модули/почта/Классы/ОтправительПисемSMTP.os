// Реализация ОтправительПисем поверх библиотеки InternetMail (MailKit): соединение
// открывается на каждое письмо и закрывается вместе с ним — держать сессию SMTP между
// редкими письмами хаба не из чего.

#Использовать InternetMail

Перем Параметры; // НастройкиПочты (почта)

// Отправляет письмо простым текстом. Отказ сервера, недоступность и таймаут выходят
// исключением библиотеки; текст письма в него не попадает.
// Реализация контракта ОтправительПисем.
//
// Параметры:
//  Письмо - Структура - Кому (Строка), Тема (Строка), Текст (Строка), ОтКого (Строка).
//
Процедура Отправить(Знач Письмо) Экспорт

	Почта = Новый ИнтернетПочта();
	Попытка
		Почта.Подключиться(Профиль());
		Почта.Послать(Собрать(Письмо));
	Исключение
		ЗакрытьТихо(Почта);
		ВызватьИсключение;
	КонецПопытки;

	ЗакрытьТихо(Почта);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Шифрование выбирает библиотека, и повлиять на выбор нечем: MailKit получает от неё
// SecureSocketOptions.Auto — TLS с первого байта на порту 465, иначе STARTTLS, если
// сервер его предложит, и открытый канал, если не предложит. Подлинность сертификата
// не проверяется. Поэтому настройки «шифрование» у хаба нет: она не меняла бы ничего.
Функция Профиль()

	Значение = Новый ИнтернетПочтовыйПрофиль();
	Значение.АдресСервераSMTP = Параметры.Хост();
	Значение.ПортSMTP = Параметры.Порт();
	// имя и пароль присваиваются ВСЕГДА, в том числе пустыми: «без аутентификации»
	// библиотека отличает от «не задано» только пустой строкой
	Значение.ПользовательSMTP = Параметры.Пользователь();
	Значение.ПарольSMTP = Параметры.Пароль();
	Возврат Значение;

КонецФункции

Функция Собрать(Знач Письмо)

	Значение = Новый ИнтернетПочтовоеСообщение();
	Значение.Отправитель = Письмо.ОтКого;
	Значение.Получатели.Добавить(Письмо.Кому);
	Значение.Тема = Письмо.Тема;
	Значение.Тексты.Добавить(Письмо.Текст, ТипТекстаПочтовогоСообщения.ПростойТекст);
	Возврат Значение;

КонецФункции

// Разрыв соединения не отменяет уже отправленного письма и не должен подменять собой
// настоящую причину отказа.
Процедура ЗакрытьТихо(Почта)
	Попытка
		Почта.Отключиться();
	Исключение
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

&Прозвище("ОтправительПисем")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "НастройкиПочты") _Параметры) Экспорт

	Параметры = _Параметры;

КонецПроцедуры
