// Единственная точка, через которую хаб шлёт письма: гейт «почта настроена», проверка
// адреса получателя и превращение любого отказа транспорта в код причины. Исключений
// наружу не отдаёт — недоставленное письмо не должно ронять операцию, ради которой его
// слали.

Перем Параметры;   // НастройкиПочты (почта)
Перем Транспорт;   // ОтправительПисем (почта)
Перем Адреса;      // ПочтовыйАдрес (почта) — годность адреса и чистота заголовка
Перем Фон;         // ЗапускВФоне (фоновыеЗадания); Неопределено — шлём здесь же
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Отправляет письмо простым текстом.
//
// Параметры:
//  Кому - Строка - адрес получателя.
//  Тема - Строка - тема письма.
//  Текст - Строка - тело письма.
//
// Возвращаемое значение:
//  Структура - Отправлено (Булево), Причина (Строка — код отказа, "" при успехе).
//
Функция Отправить(Знач Кому, Знач Тема, Знач Текст) Экспорт

	Письмо = Собрать(Кому, Тема, Текст);
	Если Письмо = Неопределено Тогда
		Возврат Итог(Ложь, ?(Параметры.Настроена(), ПричинаАдрес(), ПричинаНеНастроена()));
	КонецЕсли;

	Попытка
		Транспорт.Отправить(Письмо);
	Исключение
		// ни адреса получателя, ни темы, ни тела: письмо хаба несёт ссылку подтверждения,
		// а журнал читают шире, чем почтовый ящик
		Лог.Ошибка("Письмо не отправлено: %1. Проверьте настройки почты хаба.",
			СтрЗаменить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Символы.ПС, " "));
		Возврат Итог(Ложь, ПричинаОтказ());
	КонецПопытки;

	Возврат Итог(Истина, "");

КонецФункции

// Отдаёт письмо в фон и сразу возвращается: страница не ждёт, пока ответит SMTP.
// Проверки, которые мгновенны, остаются здесь — ненастроенная почта и негодный адрес
// это отказ по существу, и человеку он нужен сразу, а не в журнале.
//
// Параметры:
//  Кому - Строка - адрес получателя.
//  Тема - Строка - тема письма.
//  Текст - Строка - тело письма.
//
// Возвращаемое значение:
//  Структура - Отправлено (Булево — письмо принято к отправке; доставку это не обещает),
//              Причина (Строка — код отказа, "" при успехе).
//
Функция ОтправитьВФоне(Знач Кому, Знач Тема, Знач Текст) Экспорт

	Письмо = Собрать(Кому, Тема, Текст);
	Если Письмо = Неопределено Тогда
		Возврат Итог(Ложь, ?(Параметры.Настроена(), ПричинаАдрес(), ПричинаНеНастроена()));
	КонецЕсли;

	// без фона письмо уходит здесь же: контракт не собран только в обвязках, где
	// проглоченная отправка выглядела бы как «письма просто нет»
	Если Фон = Неопределено Тогда
		Возврат Отправить(Кому, Тема, Текст);
	КонецЕсли;

	Фон.Запустить(Новый ПисьмоЗаданием(Транспорт, Письмо, Лог));
	Возврат Итог(Истина, "");

КонецФункции

// Готова ли почта к отправке — чтобы экран не предлагал действие, которое не состоится.
//
// Возвращаемое значение:
//  Булево.
//
Функция Настроена() Экспорт
	Возврат Параметры.Настроена();
КонецФункции

// Код отказа «отправка почты на хабе не настроена».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНеНастроена() Экспорт
	Возврат "mail_disabled";
КонецФункции

// Код отказа «адрес получателя не годится»: пустой, без @ либо с пробелом или
// управляющим символом — таким адресом в письмо подставляют чужие заголовки.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаАдрес() Экспорт
	Возврат "mail_bad_address";
КонецФункции

// Код отказа «сервер письмо не принял» (недоступен, отказал, таймаут).
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаОтказ() Экспорт
	Возврат "mail_send_failed";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Готовое к отправке письмо либо Неопределено, если слать нечем или некому. Отправитель
// проверен гейтом «настроена»: негодный адрес отправителя — это ненастроенная почта,
// а не сорвавшаяся отправка.
Функция Собрать(Знач Кому, Знач Тема, Знач Текст)

	Если НЕ Параметры.Настроена() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Адрес = СокрЛП(Строка(Кому));
	Если НЕ Адреса.Годен(Адрес) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Кому, Тема, Текст, ОтКого",
		Адрес, Адреса.ОднойСтрокой(Тема), Строка(Текст), Параметры.Отправитель());

КонецФункции

Функция Итог(Знач Отправлено, Знач Причина)
	Возврат Новый Структура("Отправлено, Причина", Отправлено, Причина);
КонецФункции

#КонецОбласти

// Лог параметром — для создания через `Новый` вне контейнера: инъекция в поле `&Лог`
// туда не доезжает.
&Прозвище("СлужбаПочты")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "НастройкиПочты") _Параметры,
	&Пластилин(Значение = "ОтправительПисем") _Транспорт,
	&Пластилин(Значение = "ПочтовыйАдрес") _Адреса,
	&Пластилин(Значение = "ЗапускВФоне") _Фон = Неопределено,
	&Лог _Лог = Неопределено) Экспорт

	Параметры = _Параметры;
	Транспорт = _Транспорт;
	Адреса = _Адреса;
	Фон = _Фон;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
