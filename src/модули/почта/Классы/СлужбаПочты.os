// Единственная точка, через которую хаб шлёт письма: гейт «почта настроена», проверка адреса
// получателя и превращение любого отказа транспорта в код причины. Исключений не отдаёт.

Перем Параметры;   // НастройкиПочты (почта)
Перем Транспорт;   // ОтправительПисем (почта)
Перем Адреса;      // ПочтовыйАдрес (почта) — годность адреса и чистота заголовка
Перем Фон;         // ЗапускВФоне (фоновыеЗадания); Неопределено — шлём здесь же
Перем Ошибки;      // ТекстОшибки (основа)
Перем Вердикты;    // Вердикт (основа) — форма ответа
Перем Обезличивание; // ОбезличиваниеЖурнала (наблюдаемость) — получатель в журнале без ящика
&Лог
Перем Лог;

#Область ПубличныйИнтерфейс

// Отправляет письмо простым текстом.
//
// Параметры:
//  Кому - Строка - адрес получателя.
//  Тема - Строка - тема письма.
//  Текст - Строка - тело письма.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Причина (Строка — код отказа, "" при успехе).
//
&Наблюдаемый
Функция Отправить(Знач Кому, Знач Тема, Знач Текст) Экспорт

	Письмо = Собрать(Кому, Тема, Текст);
	Если Письмо = Неопределено Тогда
		Возврат Итог(Ложь, ?(Параметры.Настроена(), ПричинаАдрес(), ПричинаНеНастроена()));
	КонецЕсли;

	Адресат = Получатель(Письмо);
	Сервер = Параметры.АдресСервера();

	Попытка
		Транспорт.Отправить(Письмо);
	Исключение
		// получатель обезличен, темы и тела нет вовсе: письмо хаба несёт ссылку
		// подтверждения, а журнал читают шире, чем почтовый ящик
		Лог.Ошибка("Почта: письмо не отправлено — %1. Получатель %2, сервер %3."
			+ " Проверьте настройки почты хаба.",
			Ошибки.Причина(ИнформацияОбОшибке()), Адресат, Сервер);
		Возврат Итог(Ложь, ПричинаОтказ());
	КонецПопытки;

	Лог.Информация("Почта: письмо принято транспортом, получатель %1, сервер %2",
		Адресат, Сервер);
	Возврат Итог(Истина, "");

КонецФункции

// Отдаёт письмо в фон и сразу возвращается: страница не ждёт, пока ответит SMTP.
// Проверки, которые мгновенны, остаются здесь — ненастроенная почта и негодный адрес
// это отказ по существу, и человеку он нужен сразу, а не в журнале.
//
// Параметры:
//  Кому - Строка - адрес получателя.
//  Тема - Строка - тема письма.
//  Текст - Строка - тело письма.
//
// Возвращаемое значение:
//  Структура - Успех (Булево — письмо принято к отправке; доставку это не обещает),
//              Причина (Строка — код отказа, "" при успехе).
//
&Наблюдаемый
Функция ОтправитьВФоне(Знач Кому, Знач Тема, Знач Текст) Экспорт

	Письмо = Собрать(Кому, Тема, Текст);
	Если Письмо = Неопределено Тогда
		Возврат Итог(Ложь, ?(Параметры.Настроена(), ПричинаАдрес(), ПричинаНеНастроена()));
	КонецЕсли;

	// без фона письмо уходит здесь же: контракт не собран только в обвязках, где
	// проглоченная отправка выглядела бы как «письма просто нет»
	Если Фон = Неопределено Тогда
		Лог.Отладка("Почта: контракт фонового запуска не собран — шлём в этом же потоке");
		Возврат Отправить(Кому, Тема, Текст);
	КонецЕсли;

	Адресат = Получатель(Письмо);
	Сервер = Параметры.АдресСервера();

	Фон.Запустить(Новый ПисьмоЗаданием(Транспорт, Письмо, Лог, Приметы(Адресат, Сервер)));
	Лог.Информация("Почта: письмо отдано фоновому заданию, получатель %1, сервер %2",
		Адресат, Сервер);
	Возврат Итог(Истина, "");

КонецФункции

// Готова ли почта к отправке — чтобы экран не предлагал действие, которое не состоится.
//
// Возвращаемое значение:
//  Булево.
//
&Наблюдаемый
Функция Настроена() Экспорт
	Возврат Параметры.Настроена();
КонецФункции

// Код отказа «отправка почты на хабе не настроена».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаНеНастроена() Экспорт
	Возврат "mail_disabled";
КонецФункции

// Код отказа «адрес получателя не годится»: пустой, без @ либо с пробелом или
// управляющим символом — таким адресом в письмо подставляют чужие заголовки.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаАдрес() Экспорт
	Возврат "mail_bad_address";
КонецФункции

// Код отказа «сервер письмо не принял» (недоступен, отказал, таймаут).
//
// Возвращаемое значение:
//  Строка.
//
Функция ПричинаОтказ() Экспорт
	Возврат "mail_send_failed";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Негодный адрес отправителя — это ненастроенная почта, а не сорвавшаяся отправка.
Функция Собрать(Знач Кому, Знач Тема, Знач Текст)

	// хаб без почты — законное состояние, и этой дорогой проходит каждое уведомление:
	// на уровне по умолчанию о ней не пишут ничего
	Если НЕ Параметры.Настроена() Тогда
		Лог.Отладка("Почта: письмо не собрано, отправка не настроена (%1)", ПричинаНеНастроена());
		Возврат Неопределено;
	КонецЕсли;

	Адрес = СокрЛП(Строка(Кому));
	Если НЕ Адреса.Годен(Адрес) Тогда
		// негодный адрес — признак битых данных, и домена у него НЕТ: «victim@org\r\nBcc:
		// attacker@evil.com» назвал бы журналу домен, выбранный подставившим строку.
		// Поэтому от такого значения остаются только факт наличия и длина
		Лог.Предупреждение("Почта: адрес получателя не годится (%1), письмо не собрано:"
			+ " значение %2", ПричинаАдрес(), Обезличивание.Секрет(Адрес));
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Кому, Тема, Текст, ОтКого",
		Адрес, Адреса.ОднойСтрокой(Тема), Строка(Текст), Параметры.Отправитель());

КонецФункции

Функция Итог(Знач Отправлено, Знач Причина)
	Возврат ?(Отправлено, Вердикты.Успех(), Вердикты.Отказ(Причина));
КонецФункции

Функция Получатель(Знач Письмо)
	Возврат Обезличивание.Почта(Письмо.Кому);
КонецФункции

// Всё, что фоновое задание скажет о письме журналу, — именами полей, а не порядком слов.
Функция Приметы(Знач Адресат, Знач Сервер)
	Возврат Новый Структура("Получатель, Сервер", Адресат, Сервер);
КонецФункции

#КонецОбласти

&Прозвище("СлужбаПочты")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "НастройкиПочты") _Параметры,
	&Пластилин(Значение = "ОтправительПисем") _Транспорт,
	&Пластилин(Значение = "ПочтовыйАдрес") _Адреса,
	&Пластилин(Значение = "ЗапускВФоне") _Фон = Неопределено,
	&Лог _Лог = Неопределено,
	&Пластилин(Значение = "ТекстОшибки") _Ошибки = Неопределено) Экспорт

	Ошибки = ?(_Ошибки = Неопределено, Новый ТекстОшибки(), _Ошибки);
	Обезличивание = Новый ОбезличиваниеЖурнала();
	Параметры = _Параметры;
	Транспорт = _Транспорт;
	Адреса = _Адреса;
	Фон = _Фон;
	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

	Вердикты = Новый Вердикт();

КонецПроцедуры
