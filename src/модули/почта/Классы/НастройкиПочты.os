// Параметры исходящей почты из реестра настроек. Значения читаются в месте
// использования, поэтому правка настройки действует без перезапуска хаба.

Перем Настройки; // СервисНастроек (настройки)
Перем Адреса;    // ПочтовыйАдрес (почта) — что считается годным адресом

#Область Ключи

// Ключ настройки «отправка почты включена».
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючВключена() Экспорт
	Возврат "oshub.mail.enabled";
КонецФункции

// Ключ настройки «адрес SMTP-сервера».
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючХост() Экспорт
	Возврат "oshub.mail.smtp.host";
КонецФункции

// Ключ настройки «порт SMTP-сервера».
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючПорт() Экспорт
	Возврат "oshub.mail.smtp.port";
КонецФункции

// Ключ настройки «имя пользователя SMTP».
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючПользователь() Экспорт
	Возврат "oshub.mail.smtp.user";
КонецФункции

// Ключ настройки «пароль SMTP» — секрет класса bootstrap.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючПароль() Экспорт
	Возврат "oshub.mail.smtp.password";
КонецФункции

// Ключ настройки «адрес отправителя писем хаба».
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючОтправитель() Экспорт
	Возврат "oshub.mail.from";
КонецФункции

#КонецОбласти

#Область Значения

// Включена ли отправка почты хабом.
//
// Возвращаемое значение:
//  Булево.
//
Функция Включена() Экспорт
	Возврат Настройки.Флаг(КлючВключена(), Ложь);
КонецФункции

// Адрес SMTP-сервера («» — не задан).
//
// Возвращаемое значение:
//  Строка.
//
Функция Хост() Экспорт
	Возврат Настройки.Текстом(КлючХост());
КонецФункции

// Порт SMTP-сервера.
//
// Возвращаемое значение:
//  Число.
//
Функция Порт() Экспорт
	Возврат Цел(Настройки.Значение(КлючПорт()));
КонецФункции

// Имя пользователя SMTP («» — сервер без аутентификации).
//
// Возвращаемое значение:
//  Строка.
//
Функция Пользователь() Экспорт
	Возврат Настройки.Текстом(КлючПользователь());
КонецФункции

// Пароль SMTP. ЗНАЧЕНИЕ СЕКРЕТА: годится только для передачи в почтовый профиль —
// в журнал, в разметку, в ответы API и в детали аудита оно не попадает.
//
// Возвращаемое значение:
//  Строка.
//
Функция Пароль() Экспорт
	Возврат Строка(Настройки.Значение(КлючПароль()));
КонецФункции

// Адрес, от имени которого хаб шлёт письма («» — не задан).
//
// Возвращаемое значение:
//  Строка.
//
Функция Отправитель() Экспорт
	Возврат НРег(Настройки.Текстом(КлючОтправитель()));
КонецФункции

// Годен ли адрес отправителя: ровно одна собака, ни пробела, ни разрыва строки. Разрыв
// в этом поле — дописанные в письмо заголовки, а значение приходит из настройки, которую
// правят через форму.
//
// Возвращаемое значение:
//  Булево.
//
Функция ОтправительГоден() Экспорт
	Возврат Адреса.Годен(Отправитель());
КонецФункции

// Готова ли почта к отправке: включена, назван сервер и адрес отправителя ГОДЕН. Пустой
// пароль препятствием не считается — открытый релей во внутренней сети законен.
// Негодный адрес отправителя — это «не настроена», а не «отправка сорвалась»: оператор
// правит настройку, а не гадает по коду отказа сервера.
//
// Возвращаемое значение:
//  Булево.
//
Функция Настроена() Экспорт
	Возврат Включена() И ЗначениеЗаполнено(Хост()) И ОтправительГоден();
КонецФункции

#КонецОбласти

&Прозвище("НастройкиПочты")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СервисНастроек") _Настройки,
	&Пластилин(Значение = "ПочтовыйАдрес") _Адреса) Экспорт

	Настройки = _Настройки;
	Адреса = _Адреса;

КонецПроцедуры
