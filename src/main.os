// OpenHub — точка входа: загрузка настроек, сборка контейнера ОСени и запуск веб-сервера winow.
// Настройки собирает запуск/ЗагрузкаНастроек: файл autumn-properties и окружение поверх него.

#Использовать autumn
#Использовать autumn-logos
#Использовать winow
#Использовать autumn-data
#Использовать autumn-cache
#Использовать ospx-tools
#Использовать os-scheduler
#Использовать oidc-client
#Использовать jwt-verify
#Использовать oint
#Использовать errors
#Использовать ip
// Тип аппендера OTel logos создаёт по имени из своих настроек — до сборки контейнера.
#Использовать opentelemetry
// Кит интерфейса — библиотекой. Директива обязана отработать ДО Новый Поделка(...):
// ОСень регистрирует желуди по известным типам, а тип, появившийся после конструктора,
// желудём уже не станет.
#Использовать oscript-ui

Процедура ПодключитьКласс(Знач КаталогМодулей, Знач Путь, Знач ИмяКласса)
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, Путь, ИмяКласса + ".os"), ИмяКласса);
КонецПроцедуры

КаталогМодулей = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "модули");

// Способы вывода logos создаёт сама, по имени типа из своих настроек, и делает это
// раньше, чем ОСень разложит классы приложения. Без подключения здесь первая же строка
// журнала падает «Type is not defined». Обезличивание — дверь, через которую оба способа
// вывода отдают строку; разбор уровней подключается рядом: точка входа не место для
// логики, которую нельзя прогнать тестом.
КаталогЖурнала = ОбъединитьПути("наблюдаемость", "Классы", "журнал");
ПодключитьКласс(КаталогМодулей, КаталогЖурнала, "ОбезличиваниеЖурнала");
ПодключитьКласс(КаталогМодулей, КаталогЖурнала, "ВыводЛогаВКонсольХаба");
ПодключитьКласс(КаталогМодулей, КаталогЖурнала, "ВыводЛогаВOTelХаба");
ПодключитьКласс(КаталогМодулей, КаталогЖурнала, "УровниЖурнала");

// Загрузка настроек работает до контейнера: её классы подключаются здесь же.
ПодключитьКласс(КаталогМодулей, ОбъединитьПути("настройки", "Классы"), "ИменаПеременныхОкружения");
ПодключитьКласс(КаталогМодулей, ОбъединитьПути("запуск", "Классы"), "РасположениеДанных");
ПодключитьКласс(КаталогМодулей, ОбъединитьПути("запуск", "Классы"), "ИсточникиНастроек");
ПодключитьКласс(КаталогМодулей, ОбъединитьПути("запуск", "Классы"), "ЗагрузкаНастроек");

// Журнал хаба идёт в консоль и в OTel.
СпособыВыводаЖурнала = Новый Соответствие();
СпособыВыводаЖурнала.Вставить("console", "ВыводЛогаВКонсольХаба");
СпособыВыводаЖурнала.Вставить("otel", "ВыводЛогаВOTelХаба");

Загрузка = Новый ЗагрузкаНастроек(КаталогМодулей, СпособыВыводаЖурнала);
Совет = Загрузка.Совет();
Загрузка.СоздатьКаталогиДанных();

Поделка = Новый Поделка(Совет);

// Лог берётся после сборки контейнера: уровни и способы вывода logos получает в ней.
ЛогЗапуска = Логирование.ПолучитьЛог("oshub.запуск");
Для Каждого Замечание Из Загрузка.Замечания() Цикл
	ЛогЗапуска.Предупреждение(Замечание);
КонецЦикла;
Для Каждого Сведение Из Загрузка.Сведения() Цикл
	ЛогЗапуска.Информация(Сведение);
КонецЦикла;

// Стартовые рогатки при закрытом порте: упавшая роняет процесс до открытия порта.
Поделка.ЗапуститьПриложение();

// Сборка желудя идёт под уже работающими фоновыми рогатками и однажды повисла на ней
// молча: строка отделяет «рогатки отработали» от «последний шаг начался».
ЛогЗапуска.Информация("Рогатки отработали — собираю желудь последнего шага");

// Блокирующий вызов: /ready и открытие порта.
Поделка.НайтиЖелудь("ОткрытиеПорта").Открыть();
