// OpenHub — точка входа: сборка контейнера ОСени и запуск веб-сервера winow.
// Конфигурация — autumn-properties.json в корне проекта, переменные OSHUB_* поверх него.

#Использовать autumn
#Использовать autumn-logos
#Использовать winow
#Использовать autumn-data
#Использовать entity
#Использовать ospx-tools
#Использовать os-scheduler
#Использовать oidc-client
#Использовать jwt-verify
#Использовать oint
#Использовать errors
#Использовать ip
// Кит интерфейса — библиотекой. Директива обязана отработать ДО Новый Поделка(...):
// ОСень регистрирует желуди по известным типам, а тип, появившийся после конструктора,
// желудём уже не станет.
#Использовать oscript-ui

Функция ПортИзОкружения()

	ЗначениеИзСреды = ПолучитьПеременнуюСреды("OSHUB_PORT");
	Если НЕ ЗначениеЗаполнено(ЗначениеИзСреды) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат Число(ЗначениеИзСреды);
	Исключение
		Сообщить(СтрШаблон("OSHUB_PORT=%1 не является числом, использую порт по умолчанию",
			ЗначениеИзСреды));
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ИзОкружения(Знач ИмяПеременной, Знач ЗначениеПоУмолчанию)

	Значение = ПолучитьПеременнуюСреды(ИмяПеременной);
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Конвенция configor: "_" -> ".", "__" -> "_"; OSHUB_STORAGE_ROOT -> oshub.storage.root.
Функция ДеталькаИзИмениПеременной(Знач ИмяПеременной)

	Возврат НРег(СтрЗаменить(СтрЗаменить(ИмяПеременной, "_", "."), "..", "_"));

КонецФункции

// Приоритеты configor: ENV=1, файл=2, детальки=3 — чтобы OSHUB_* перебивали файл, инъектируем деталькой.
// OTEL_* едут тем же мостом: секрет коллектора живёт только в окружении, а стандартные
// имена переменных OpenTelemetry ждут и SDK, и напильник winow.
Процедура ДобавитьМостыОкружения(Детальки)

	Для Каждого КлючЗначение Из ПеременныеСреды() Цикл
		ИмяПеременной = ВРег(КлючЗначение.Ключ);
		Если НЕ ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(ИмяПеременной, "OSHUB_") ИЛИ СтрНачинаетсяС(ИмяПеременной, "OTEL_") Тогда
			Детальки.Вставить(ДеталькаИзИмениПеременной(КлючЗначение.Ключ), КлючЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры


// Карта "data.ИсточникиДанных" из OSHUB_DB_*; Неопределено — источник истины файл.
Функция ИсточникДанныхИзОкружения()

	ТипКоннектора = ПолучитьПеременнуюСреды("OSHUB_DB_CONNECTOR");
	СтрокаСоединения = ПолучитьПеременнуюСреды("OSHUB_DB_CONNECTION");

	Если НЕ ЗначениеЗаполнено(ТипКоннектора) И НЕ ЗначениеЗаполнено(СтрокаСоединения) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ТипКоннектора) Тогда
		ТипКоннектора = "КоннекторJSON";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СтрокаСоединения) Тогда

		Если ВРег(ТипКоннектора) = ВРег("КоннекторInMemory") Тогда
			СтрокаСоединения = "";
		ИначеЕсли ЭтоФайловыйКоннектор(ТипКоннектора) Тогда
			КаталогДанных = Новый Файл(ИзОкружения("OSHUB_STORAGE_ROOT", "./data")).ПолноеИмя;
			СтрокаСоединения = ОбъединитьПути(КаталогДанных, "entities");
		Иначе
			ВызватьИсключение СтрШаблон(
				"Ошибка конфигурации БД: для OSHUB_DB_CONNECTOR=%1 обязательна переменная OSHUB_DB_CONNECTION"
					+ " (например, для КоннекторPostgreSQL - ""Host=...;Username=...;Password=...;Database=...;"").",
				ТипКоннектора);
		КонецЕсли;

	КонецЕсли;

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", ТипКоннектора);
	ИсточникДанных.Вставить("СтрокаСоединения", СтрокаСоединения);

	Возврат ИсточникДанных;

КонецФункции

Функция ЭтоФайловыйКоннектор(Знач ТипКоннектора)
	Возврат СтрНачинаетсяС(ВРег(Строка(ТипКоннектора)), ВРег("КоннекторJSON"));
КонецФункции

// Должен совпадать с data.ИсточникиДанных.СтрокаСоединения в autumn-properties.json.
Функция ДефолтныйКаталогJSON()
	Возврат Новый Файл("./data/entities").ПолноеИмя;
КонецФункции

// Журнал хаба идёт в консоль и в OTel. Связка описывается здесь, а не в поставочном
// autumn-properties.json: тот же файл читают другие точки входа (oneunit, admin-cli),
// а способы вывода живут в исходниках хаба и вне его процесса не существуют. Уезжают ли
// строки на самом деле, решает ВыводЛогаВOTel по otel.enabled.
//
// Ветки кладутся целиком: и ФабрикаЛогов, и заготовка logos читают деталькой узел
// "logos.logger" и "logos.appender", а не отдельные листья под ними. Оттого и уровни
// оператор задаёт окружением (OSHUB_LOG_LEVEL, OSHUB_LOG_LEVELS), а не файлом:
// носитель сменился, способность «отдельно каждому компоненту» осталась.
Процедура ДобавитьМостЖурналаВOTel(Детальки)

	Типы = Новый Соответствие();
	Типы.Вставить("console", "ВыводЛогаВКонсольХаба");
	Типы.Вставить("otel", "ВыводЛогаВOTel");

	Уровни = Новый УровниЖурнала();
	Связка = Уровни.Связка(ИзОкружения("OSHUB_LOG_LEVEL", "INFO"),
		ИзОкружения("OSHUB_LOG_LEVELS", ""), Типы);

	Для Каждого Замечание Из Уровни.Замечания() Цикл
		Логирование.ПолучитьЛог("oshub.запуск").Предупреждение(Замечание);
	КонецЦикла;

	Детальки.Вставить("logos.logger", Связка.Логи);
	Детальки.Вставить("logos.appender", Связка.СпособыВывода);

КонецПроцедуры

// КоннекторJSON сам каталог не создаёт — без этого первый старт падает DirectoryNotFound.
Процедура ОбеспечитьКаталог(Знач Путь)
	Если ЗначениеЗаполнено(Путь) Тогда
		Каталог = Новый Файл(Путь);
		Если НЕ Каталог.Существует() Тогда
			СоздатьКаталог(Каталог.ПолноеИмя);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

КаталогИсходников = Новый Файл(ТекущийСценарий().Источник).Путь;

// Способ вывода журнала в OTel logos создаёт сама, по имени типа из своих настроек,
// и делает это раньше, чем ОСень разложит классы приложения. Без подключения здесь
// первая же строка журнала падает «Type is not defined». Разбор уровней подключается
// рядом: точка входа не место для логики, которую нельзя прогнать тестом.
КаталогЖурнала = ОбъединитьПути(ОбъединитьПути(КаталогИсходников, "модули"),
	ОбъединитьПути("наблюдаемость", "Классы", "журнал"));
ПодключитьСценарий(ОбъединитьПути(КаталогЖурнала, "ВыводЛогаВOTel.os"), "ВыводЛогаВOTel");
ПодключитьСценарий(ОбъединитьПути(КаталогЖурнала, "ВыводЛогаВКонсольХаба.os"),
	"ВыводЛогаВКонсольХаба");
ПодключитьСценарий(ОбъединитьПути(КаталогЖурнала, "УровниЖурнала.os"), "УровниЖурнала");

Детальки = Новый Соответствие();

ДобавитьМостЖурналаВOTel(Детальки);

// АвтоСтарт выключен сознательно: рогатка winow поднимает слушатель в фоновом задании,
// параллельно стартовым рогаткам. Порт открывает желудь ОткрытиеПорта после старта.
Детальки.Вставить("winow.АвтоСтарт", Ложь);
Детальки.Вставить("winow.ИспользоватьПрикладнойСервер", Ложь);
Детальки.Вставить("winow.КаталогСПриложениями", ОбъединитьПути(КаталогИсходников, "модули"));

// Имя сэмплера — умолчание хаба, а не файла: без него SDK ставит ParentBased(AlwaysOn)
// и настройку «доля отбираемых трасс» ИГНОРИРУЕТ. В поставочном autumn-properties.json
// держать его нельзя — штатный деплой монтирует поверх файл оператора, и доля умерла бы
// молча. Значение перебивается переменной OTEL_TRACES_SAMPLER: мост окружения идёт ниже.
Детальки.Вставить("otel.traces.sampler", "parentbased_traceidratio");

ПортИзСреды = ПортИзОкружения();
Если ПортИзСреды <> Неопределено Тогда
	Детальки.Вставить("winow.Порт", ПортИзСреды);
КонецЕсли;

// Сид основного пула: имя переменной историческое, конвенция моста к нему не ведёт.
ОсновнойПул = ПолучитьПеременнуюСреды("OSHUB_DEFAULT_POOL");
Если ЗначениеЗаполнено(ОсновнойПул) Тогда
	Детальки.Вставить("oshub.pools.default", ОсновнойПул);
КонецЕсли;

ФайлПароляАдмина = ПолучитьПеременнуюСреды("OSHUB_ADMIN_PASSWORD_FILE");
Если ЗначениеЗаполнено(ФайлПароляАдмина) Тогда
	Детальки.Вставить("oshub.admin.password_file", ФайлПароляАдмина);
КонецЕсли;

// Сети обратных прокси: имя переменной названо требованием одним подчёркиванием,
// а конвенция моста удваивает его внутри сегмента ключа.
ДоверенныеПрокси = ПолучитьПеременнуюСреды("OSHUB_INSTANCE_TRUSTED_PROXIES");
Если ЗначениеЗаполнено(ДоверенныеПрокси) Тогда
	Детальки.Вставить("oshub.instance.trusted_proxies", ДоверенныеПрокси);
КонецЕсли;

ИсточникДанных = ИсточникДанныхИзОкружения();
Если ИсточникДанных <> Неопределено Тогда
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	Если ЭтоФайловыйКоннектор(ИсточникДанных["ТипКоннектора"]) Тогда
		ОбеспечитьКаталог(ИсточникДанных["СтрокаСоединения"]);
	КонецЕсли;
Иначе
	ОбеспечитьКаталог(ДефолтныйКаталогJSON());
КонецЕсли;

ОбеспечитьКаталог(Новый Файл(ИзОкружения("OSHUB_STORAGE_ROOT", "./data")).ПолноеИмя);

// После спец-случаев, чтобы не затирать их «правильные» ключи деталек.
ДобавитьМостыОкружения(Детальки);

Совет = Новый СоветДругогоМастера();
Совет.ЗначенияДеталек(Детальки);

Поделка = Новый Поделка(Совет);

// Стартовые рогатки при закрытом порте: упавшая роняет процесс до открытия порта.
Поделка.ЗапуститьПриложение();

// Сборка желудя идёт под уже работающими фоновыми рогатками и однажды повисла на ней
// молча: строка отделяет «рогатки отработали» от «последний шаг начался».
Логирование.ПолучитьЛог("oshub.запуск").Информация(
	"Рогатки отработали — собираю желудь последнего шага");

// Блокирующий вызов: /ready и открытие порта.
Поделка.НайтиЖелудь("ОткрытиеПорта").Открыть();
