{
    "otel": {
        "enabled": true,
        "exporter": {
            "otlp": {
                "endpoint": "http://otel-collector:4318", // Адрес своего OTLP-коллектора
                "protocol": "http/protobuf"
            }
        },
        "entity": {
            "query-text": true
        }
    },
    "oshub": {
        "instance": {
            "trusted_proxies": "" // Сети обратного прокси через запятую, например 172.16.0.0/12
        },
        "storage": {
            "backend": "file", // file либо s3
            // Узел s3 нужен только при backend = s3
            "s3": {
                "endpoint": "",
                "bucket": "",
                "region": "us-east-1",
                "force_path_style": true
            }
        },
        "pools": {
            "default": "public"
        }
    }
}
