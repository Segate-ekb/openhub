&Тест
Процедура ДовериеРешаетсяДоПодменыАдресаКлиента() Экспорт

	// соединение пришло со своего прокси, а в цепочке пересылки — адрес человека.
	// Обёртка страны обязана отработать ПЕРВОЙ: встань она внутрь, доверие судилось бы
	// по адресу человека (203.0.113.9), и заголовок своего же прокси был бы снят
	Наблюдать("RU");
	Доверять("10.0.0.0/8");
	Запрос = ЗапросСЗаголовком("10.0.0.1", "CF-IPCountry", "de");
	Запрос.Заголовки.Вставить("X-Forwarded-For", "203.0.113.9");

	Прогнать(Запрос);

	Ожидаем.Что(Запрос.АдресУдаленногоУзла,
		"адресом клиента стал адрес человека").Равно("203.0.113.9");
	Ожидаем.Что(Заголовок(Запрос, "CF-IPCountry"),
		"а заголовок своего прокси уцелел — доверие судили по адресу соединения").Равно("DE");

КонецПроцедуры

&Тест
Процедура ПараОбёртокСобранаНапильникомВЭтомЖеПорядке() Экспорт

	Наблюдать("RU");
	Доверять("10.0.0.0/8");
	Запрос = ЗапросСЗаголовком("10.0.0.1", "CF-IPCountry", "de");
	Запрос.Заголовки.Вставить("X-Forwarded-For", "203.0.113.9");

	Внешняя = ОбёрткиНапильника();
