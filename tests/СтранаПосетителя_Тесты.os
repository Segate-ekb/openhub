&Тест
Процедура ЗаголовокСНедоверенногоСоединенияСнимаетсяСЗапроса() Экспорт

	Наблюдать("RU");
	Доверять("10.0.0.0/8");
	Запрос = ЗапросСЗаголовком(Проба.НемецкийIPv4(), "CF-IPCountry", "ru");

	Прогнать(Запрос);

	Ожидаем.Что(Заголовок(Запрос, "CF-IPCountry"),
		"заголовок снят, а не «просто не прочитан»").Равно(Неопределено);
	Ожидаем.Что(Определитель.ОпределитьПоЗапросу(Запрос.АдресУдаленногоУзла,
			Запрос.Заголовки).Источник,
		"и источником прокси уже не станет").Равно(Определитель.ИсточникБазы());
	Ожидаем.Что(Запрос.Заголовки.Получить("Host"), "соседние заголовки на месте")
		.Равно("hub.example");

