&Тест
Процедура БезСпискаДоверенныхЗаголовокСнимаетсяВсегда() Экспорт

	// самая частая боевая настройка: список прокси пуст, значит доверенных соединений нет
	// вовсе — и заголовку страны верить неоткуда
	Наблюдать("RU");
	Доверять("");
	Запрос = ЗапросСЗаголовком("10.0.0.1", "CF-IPCountry", "de");

	Прогнать(Запрос);

	Ожидаем.Что(Заголовок(Запрос, "CF-IPCountry"),
		"заголовок снят: доверять некому").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СбойПроверкиСнимаетИменноНастроенныйЗаголовок() Экспорт

	// заглушка настроек бросает на незаданном ключе: доверенные прокси не заданы вовсе,
	// и проверка срывается ВНУТРИ — после того, как имя заголовка уже прочитано
	Наблюдать("RU");
	Настройки.Задать(Определитель.КлючЗаголовка(), "X-Country");
	Запрос = ЗапросСЗаголовком("10.0.0.1", "X-Country", "de");
	Запрос.Заголовки.Вставить("CF-IPCountry", "fr");

	Прогнать(Запрос);

	Ожидаем.Что(Заголовок(Запрос, "X-Country"),
		"снят настроенный заголовок, а не умолчальный").Равно(Неопределено);
	Ожидаем.Что(Определитель.ОпределитьПоЗапросу(Проба.РоссийскийIPv4(),
			Запрос.Заголовки).Источник,
		"и читать определителю уже нечего").Равно(Определитель.ИсточникБазы());
	Ожидаем.Что(Запрос.Заголовки.Получить("Host"), "соседние заголовки на месте")
		.Равно("hub.example");

КонецПроцедуры

