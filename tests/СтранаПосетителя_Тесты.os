// Страна посетителя: три исхода определителя, «своя сеть раньше базы», оба порядка
// источников, доверие заголовку на шве входа и порядок обёрток на этом шве.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя
Перем Проба;          // фикстура БазаСтранПробная
Перем Настройки;      // НастройкиЗаглушка
Перем Фон;            // ЗапускВФонеСинхронный либо ЗапускВФонеОтложенный
Перем База;           // БазаСтран (гео)
Перем Определитель;   // ОпределительСтраны (гео)
Перем Порядок;        // ПорядокАдресов (гео)
Перем Песочница;
Перем КаталогМодулей_;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("БазаСтранПробная");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ЗапускВФонеСинхронный");
	РеестрФикстур.Подключить("ЗапускВФонеОтложенный");
	РеестрФикстур.Подключить("ФейкРазрешительImён");
	РеестрФикстур.Подключить("ОбработчикЗапросовЗаглушка");
	РеестрФикстур.Подключить("ПоделкаИзЖелудей");
	РеестрФикстур.Подключить("ЧтениеСтраныПотоком");
	РеестрФикстур.Подключить("ЧасыРучные");

	ПоискКлассов = Новый КлассыСлоя();
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей_ = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПоискКлассов.ПодключитьОснову(КаталогМодулей_);
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей_, "гео", "Классы"));
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей_, "сеть", "Классы"), "СвояСеть");
	Для Каждого Имя Из КлассыВхода() Цикл
		ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей_, "вход", "Классы"), Имя);
	КонецЦикла;

КонецПроцедуры

&ПередКаждым
Процедура СобратьОпределитель() Экспорт

	Проба = Новый БазаСтранПробная();
	Песочница = УникальныеИмена.ВременныйКаталог("гео-страна");
	Фон = Новый ЗапускВФонеСинхронный();
	Собрать(Фон);

КонецПроцедуры

&ПослеКаждого
Процедура УбратьПесочницу() Экспорт
	УникальныеИмена.УбратьВременное(Песочница);
КонецПроцедуры

#Область ТриИсхода

&Тест
Процедура ТриИсходаРазличимыИНазываютПричину() Экспорт

	Наблюдать("RU");

	Известна = Определитель.Определить(Проба.РоссийскийIPv4());
	Ожидаем.Что(Известна.Исход, "страна известна").Равно(Определитель.Исходы().Известна);
	Ожидаем.Что(Известна.Страна, "и названа кодом").Равно("RU");
	Ожидаем.Что(Известна.Источник, "источник назван").Равно(Определитель.ИсточникБазы());

	Чужая = Определитель.Определить(Проба.НемецкийIPv4());
	Ожидаем.Что(Чужая.Исход, "публичный адрес не из наблюдаемых стран")
		.Равно(Определитель.Исходы().НеНаблюдаемая);
	Ожидаем.Что(Чужая.Страна, "кода у такого исхода нет").Равно("");

	Петля = Определитель.Определить("127.0.0.1");
	Ожидаем.Что(Петля.Исход, "петля — страна неизвестна")
		.Равно(Определитель.Исходы().Неизвестна);
	Ожидаем.Что(ЗначениеЗаполнено(Петля.Причина),
		"и причина написана словами: " + Петля.Причина).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ИзвестнаИПоIPv6ИПоОтображённомуIPv4() Экспорт

	Наблюдать("RU");

	Ожидаем.Что(Определитель.Определить(Проба.РоссийскийIPv6()).Страна, "IPv6").Равно("RU");
	Ожидаем.Что(Определитель.Определить("::ffff:" + Проба.РоссийскийIPv4()).Страна,
		"клиент IPv4 через двойной стек").Равно("RU");
	Ожидаем.Что(Определитель.Определить(Проба.ПервыйРоссийскийIPv4()).Страна,
		"первый адрес диапазона").Равно("RU");
	Ожидаем.Что(Определитель.Определить(Проба.ПоследнийРоссийскийIPv4()).Страна,
		"последний адрес диапазона").Равно("RU");

КонецПроцедуры

#КонецОбласти

#Область СвояСетьРаньшеБазы

&Тест
Процедура СвояСетьСудитсяРаньшеБазыДажеКогдаБазаЗоветЕёСтраной() Экспорт

	// в выпуске 2026-09 база раздаёт настоящим странам десять служебных диапазонов IPv6:
	// семь назначений протоколов IETF, документационный «3fff::/20», «5f00::/16» и хвост
	// «fe00::/9» с «fec0::/10». Пробная база повторяет их строками данных
	Наблюдать("CH,US");
	Индекс = База.ОтветБазы().Индекс;

	Для Каждого Запись Из Проба.СлужебныеДырыIPv6() Цикл
		Ожидаем.Что(ЗначениеЗаполнено(Индекс.Страна(Порядок.КлючЗаписи(Запись))),
			СтрШаблон("КОНТРОЛЬ: база и вправду зовёт %1 страной", Запись)).ЭтоИстина();

		Вердикт = Определитель.Определить(Запись);
		Ожидаем.Что(Вердикт.Исход, СтрШаблон("но гражданства %1 не получает", Запись))
			.Равно(Определитель.Исходы().Неизвестна);
		Ожидаем.Что(Вердикт.Страна, "и кода тоже").Равно("");
		Ожидаем.Что(СтрНайти(Вердикт.Причина, "не публичный") > 0,
			"причина названа: " + Вердикт.Причина).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура НепубличныйИНеразбираемыйАдресДаютНеизвестность() Экспорт

	Наблюдать("RU,CH");
	Неизвестна = Определитель.Исходы().Неизвестна;

	Ожидаем.Что(Определитель.Определить("10.0.0.7").Исход, "частная сеть").Равно(Неизвестна);
	Ожидаем.Что(Определитель.Определить("169.254.169.254").Исход, "link-local").Равно(Неизвестна);
	Ожидаем.Что(Определитель.Определить("100.64.0.1").Исход, "CGNAT").Равно(Неизвестна);
	Ожидаем.Что(Определитель.Определить("fc00::1").Исход, "ULA").Равно(Неизвестна);
	Ожидаем.Что(Определитель.Определить("fe80::1").Исход, "link-local IPv6").Равно(Неизвестна);
	Ожидаем.Что(Определитель.Определить("fe00::1").Исход,
		"зарезервированный IETF fe00::/9").Равно(Неизвестна);
	Ожидаем.Что(Определитель.Определить("ff02::1").Исход, "групповой IPv6").Равно(Неизвестна);
	Ожидаем.Что(Определитель.Определить("203.0.113.9").Исход,
		"сеть для документации, хотя база зовёт её Францией").Равно(Неизвестна);
	Ожидаем.Что(Определитель.Определить("224.0.0.1").Исход, "групповой адрес").Равно(Неизвестна);
	Ожидаем.Что(Определитель.Определить("не-адрес").Исход, "не адрес вовсе").Равно(Неизвестна);
	Ожидаем.Что(Определитель.Определить("127.1").Исход, "нестрогая запись").Равно(Неизвестна);
	Ожидаем.Что(Определитель.Определить("").Исход, "пустая запись").Равно(Неизвестна);
	Ожидаем.Что(Определитель.Определить(Неопределено).Исход, "ничего").Равно(Неизвестна);

КонецПроцедуры

#КонецОбласти

#Область ПорядокИсточников

&Тест
Процедура ПорядокИсточниковРешаетКтоОтвечает() Экспорт

	Наблюдать("RU");

	Настройки.Задать(Определитель.КлючПорядка(), "база-прокси");
	Старшая = Определитель.Определить(Проба.РоссийскийIPv4(), "DE");
	Ожидаем.Что(Старшая.Источник, "старше база").Равно(Определитель.ИсточникБазы());
	Ожидаем.Что(Старшая.Страна, "и отвечает она").Равно("RU");

	Настройки.Задать(Определитель.КлючПорядка(), "прокси-база");
	Старший = Определитель.Определить(Проба.РоссийскийIPv4(), "DE");
	Ожидаем.Что(Старший.Источник, "старше прокси").Равно(Определитель.ИсточникПрокси());
	Ожидаем.Что(Старший.Страна, "и отвечает он").Равно("DE");

КонецПроцедуры

&Тест
Процедура НеОтветившийИсточникУступаетСледующему() Экспорт

	Наблюдать("RU");
	Настройки.Задать(Определитель.КлючПорядка(), "прокси-база");

	Ожидаем.Что(Определитель.Определить(Проба.РоссийскийIPv4(), "").Источник,
		"заголовка не было — отвечает база").Равно(Определитель.ИсточникБазы());
	Ожидаем.Что(Определитель.Определить(Проба.РоссийскийIPv4(), "ZZ").Источник,
		"метка неизвестности страной не является").Равно(Определитель.ИсточникБазы());
	Ожидаем.Что(Определитель.Определить(Проба.РоссийскийIPv4(), "мусор").Источник,
		"мусор в заголовке").Равно(Определитель.ИсточникБазы());

КонецПроцедуры

&Тест
Процедура ПустоеИмяЗаголовкаОтключаетИсточникПрокси() Экспорт

	Наблюдать("RU");
	Настройки.Задать(Определитель.КлючЗаголовка(), "");
	Настройки.Задать(Определитель.КлючПорядка(), "прокси-база");

	Ожидаем.Что(Определитель.ИмяЗаголовка(), "имя заголовка пусто").Равно("");
	Ожидаем.Что(Определитель.Определить(Проба.РоссийскийIPv4(), "DE").Источник,
		"заголовок не читается вовсе — отвечает база").Равно(Определитель.ИсточникБазы());

КонецПроцедуры

#КонецОбласти

#Область НаблюдаемыеСтраны

&Тест
Процедура НаблюдатьНечегоФайлНеЧитаетсяВовсе() Экспорт

	Ожидаем.Что(База.ПрочтенийФайла(), "до объявления стран файл не трогали").Равно(0);

	Определитель.НаблюдатьСтраны(Новый Массив());
	Ожидаем.Что(База.ПрочтенийФайла(), "пустой набор файла не открывает").Равно(0);

	Определитель.НаблюдатьСтраны(Коды("ZZ,XX,T1,мусор"));
	Ожидаем.Что(Определитель.НаблюдаемыеСтраны().Количество(),
		"метки неизвестности странами не становятся").Равно(0);
	Ожидаем.Что(База.ПрочтенийФайла(), "и файла не открывают").Равно(0);

	Вердикт = Определитель.Определить(Проба.РоссийскийIPv4());
	Ожидаем.Что(Вердикт.Исход, "страна при этом неизвестна")
		.Равно(Определитель.Исходы().Неизвестна);
	Ожидаем.Что(База.ПрочтенийФайла(), "запрос файла тоже не открывает").Равно(0);

КонецПроцедуры

&Тест
Процедура НаборСтранПриводитсяККанонуИНеПересобираетсяЗря() Экспорт

	Наблюдать("RU,DE");
	Ожидаем.Что(База.ПрочтенийФайла(), "файл прочитан один раз").Равно(1);

	Определитель.НаблюдатьСтраны(Коды("ru,de"));
	Ожидаем.Что(База.ПрочтенийФайла(), "другая запись того же набора — не повод").Равно(1);

	Определитель.НаблюдатьСтраны(Коды("DE,RU"));
	Ожидаем.Что(База.ПрочтенийФайла(), "другой порядок того же набора — не повод").Равно(1);

	Определитель.НаблюдатьСтраны(Коды("RU,RU,DE"));
	Ожидаем.Что(База.ПрочтенийФайла(), "повтор внутри набора — не повод").Равно(1);
	Ожидаем.Что(СтрСоединить(Определитель.НаблюдаемыеСтраны(), ","),
		"набор один, и записан он одинаково").Равно("DE,RU");

	Определитель.НаблюдатьСтраны(Коды("RU"));
	Ожидаем.Что(База.ПрочтенийФайла(), "а вот другой набор — повод").Равно(2);

КонецПроцедуры

&Тест
Процедура ПокаСтроитсяНовыйИндексХабОтвечаетПоПрежнему() Экспорт

	// иначе правка списка стран на три-пятнадцать секунд закрывала бы вход всем
	// посетителям планеты — и так на каждой правке
	Отложенный = Новый ЗапускВФонеОтложенный();
	Собрать(Отложенный);
	Наблюдать("RU");
	Отложенный.Догнать();

	Определитель.НаблюдатьСтраны(Коды("DE"));

	Ожидаем.Что(Отложенный.Отложено(), "перестройка заказана в фон").Равно(1);
	Ожидаем.Что(Определитель.Определить(Проба.РоссийскийIPv4()).Страна,
		"пока новый индекс строится, отвечает прежний").Равно("RU");
	Ожидаем.Что(Определитель.НаблюдаемыеСтраны()[0],
		"и наблюдаемым числится его набор").Равно("RU");
	Ожидаем.Что(Определитель.СостояниеБазы().Строится,
		"а заказ уже виден отдельно").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Определитель.СостояниеБазы().Заказано, ","),
		"строится для нового набора").Равно("DE");

	Отложенный.Догнать();

	Ожидаем.Что(Определитель.Определить(Проба.НемецкийIPv4()).Страна,
		"с публикацией нового индекса правило и вступает в силу").Равно("DE");
	Ожидаем.Что(Определитель.Определить(Проба.РоссийскийIPv4()).Исход,
		"прежний набор больше не наблюдается")
		.Равно(Определитель.Исходы().НеНаблюдаемая);
	Ожидаем.Что(Определитель.СостояниеБазы().Строится, "и строить больше нечего").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПервоеПостроениеОставляетСтрануНеизвестной() Экспорт

	// прежнего индекса ещё нет — отвечать нечем, и определитель говорит об этом прямо
	Отложенный = Новый ЗапускВФонеОтложенный();
	Собрать(Отложенный);
	Наблюдать("RU");

	Вердикт = Определитель.Определить(Проба.РоссийскийIPv4());
	Ожидаем.Что(Вердикт.Исход, "страна неизвестна").Равно(Определитель.Исходы().Неизвестна);
	Ожидаем.Что(СтрНайти(Вердикт.Причина, "ещё не построен") > 0,
		"и причина названа: " + Вердикт.Причина).ЭтоИстина();
	Ожидаем.Что(Определитель.НаблюдаемыеСтраны().Количество(),
		"наблюдать ещё нечего").Равно(0);

	Отложенный.Догнать();
	Ожидаем.Что(Определитель.Определить(Проба.РоссийскийIPv4()).Страна,
		"а как построится — отвечает").Равно("RU");

КонецПроцедуры

&Тест
Процедура ИзДвухПерестроекПубликуетсяПоследнийЗаказ() Экспорт

	// фоновые задания порядка не обещают: отработай они наоборот, победить обязан
	// всё равно последний заказ, а не последний исполнитель
	Отложенный = Новый ЗапускВФонеОтложенный();
	Собрать(Отложенный);
	Наблюдать("RU");
	Отложенный.Догнать();
	ПослеПервой = База.ПрочтенийФайла();

	Определитель.НаблюдатьСтраны(Коды("DE"));
	Определитель.НаблюдатьСтраны(Коды("FR"));
	Ожидаем.Что(Отложенный.Отложено(), "заказаны две перестройки").Равно(2);

	Отложенный.ДогнатьВОбратномПорядке();

	Ожидаем.Что(СтрСоединить(Определитель.НаблюдаемыеСтраны(), ","),
		"опубликован последний заказанный набор").Равно("FR");
	Ожидаем.Что(База.ПрочтенийФайла() - ПослеПервой,
		"и файл прочитан один раз, а не дважды").Равно(1);
	Ожидаем.Что(Определитель.СостояниеБазы().Строится, "строить больше нечего").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СорвавшаясяПерестройкаПрежнийИндексНеТрогает() Экспорт

	Наблюдать("RU");
	Ожидаем.Что(Определитель.Определить(Проба.РоссийскийIPv4()).Страна,
		"КОНТРОЛЬ: индекс работает").Равно("RU");

	// файл базы исчез — но у хаба уже есть чем отвечать, и отнимать это у него нельзя
	УдалитьФайлы(ПутьБазы());
	Определитель.НаблюдатьСтраны(Коды("DE"));

	Ожидаем.Что(Определитель.Определить(Проба.РоссийскийIPv4()).Страна,
		"прежний индекс остался в работе").Равно("RU");
	Ожидаем.Что(СтрНайти(Определитель.СостояниеБазы().Помеха, "файла базы стран нет") > 0,
		"а неудача названа: " + Определитель.СостояниеБазы().Помеха).ЭтоИстина();
	Ожидаем.Что(Определитель.СостояниеБазы().Строится,
		"заказ так и не выполнен").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗамокПускаетКПерестройкеПоОдному() Экспорт

	// две сборки разом означали бы два индекса в памяти и вдвое больше чтений файла;
	// а не отпущенный замок означал бы, что гео замолчало навсегда
	Наблюдать("RU");
	ДоПерестроек = База.ПрочтенийФайла();
	Определитель.НаблюдатьСтраны(Коды("DE,RU"));

	Задания = Новый Массив();
	Задания.Добавить(ФоновыеЗадания.Выполнить(База, "ПерестроитьСейчас"));
	Задания.Добавить(ФоновыеЗадания.Выполнить(База, "ПерестроитьСейчас"));
	ФоновыеЗадания.ОжидатьВсе(Задания);

	Прочтений = База.ПрочтенийФайла() - ДоПерестроек;
	Ожидаем.Что(Прочтений >= 1 И Прочтений <= 2,
		СтрШаблон("файл прочитан %1 раз — по разу на сборку, не больше", Прочтений)).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Определитель.НаблюдаемыеСтраны(), ","),
		"снимок в конце — под последний заказ").Равно("DE,RU");

	// замок свободен: третья перестройка проходит, а не виснет
	Определитель.НаблюдатьСтраны(Коды("FR"));
	База.ПерестроитьСейчас();
	Ожидаем.Что(СтрСоединить(Определитель.НаблюдаемыеСтраны(), ","),
		"и замок отпущен — следующая сборка проходит").Равно("FR");

КонецПроцедуры

&Тест
Процедура ПерестройкаНеРоняетПараллельныеЧтения() Экспорт

	Наблюдать("RU");

	Читатели = Новый Массив();
	Задания = Новый Массив();
	Для Счёт = 1 По 8 Цикл
		Читатель = Новый ЧтениеСтраныПотоком(Определитель, Проба.РоссийскийIPv4(), 300);
		Читатели.Добавить(Читатель);
		Задания.Добавить(ФоновыеЗадания.Выполнить(Читатель, "Исполнить"));
	КонецЦикла;

	// публикация нового индекса идёт из ЭТОГО потока, пока восемь соседних читают
	Для Круг = 1 По 40 Цикл
		Определитель.НаблюдатьСтраны(Коды(?(Круг % 2 = 0, "RU", "RU,DE")));
	КонецЦикла;

	Для Каждого Задание Из Задания Цикл
		Задание.ОжидатьЗавершения();
	КонецЦикла;

	Жалобы = Новый Массив();
	Спрошено = 0;
	Для Каждого Читатель Из Читатели Цикл
		Если ЗначениеЗаполнено(Читатель.Жалоба()) Тогда
			Жалобы.Добавить(Читатель.Жалоба());
		КонецЕсли;
		Спрошено = Спрошено + Читатель.Спрошено();
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Жалобы, "; "), "жалобы читающих потоков").Равно("");
	Ожидаем.Что(Спрошено, "все ответы получены").Равно(8 * 300);

КонецПроцедуры

#КонецОбласти

#Область СостояниеБазы

&Тест
Процедура БазыНетСтранаНеизвестнаАСостояниеЭтоГоворит() Экспорт

	Настройки.Задать(База.КлючПути(), ОбъединитьПути(Песочница, "нет-такой.csv"));
	Наблюдать("RU");

	Вердикт = Определитель.Определить(Проба.РоссийскийIPv4());
	Ожидаем.Что(Вердикт.Исход, "без базы страна неизвестна")
		.Равно(Определитель.Исходы().Неизвестна);

	Состояние = Определитель.СостояниеБазы();
	Ожидаем.Что(Состояние.Есть, "файла нет").ЭтоЛожь();
	Ожидаем.Что(Состояние.Диапазонов, "и диапазонов нет").Равно(0);
	Ожидаем.Что(Состояние.Страны.Количество(), "различать хабу нечего").Равно(0);
	Ожидаем.Что(СтрСоединить(Состояние.Заказано, ","), "а наблюдать просили").Равно("RU");
	Ожидаем.Что(СтрНайти(Вердикт.Причина, "файла базы стран нет") > 0,
		"причина названа: " + Вердикт.Причина).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВозрастБазыВиденИУстарелостьНазвана() Экспорт

	Наблюдать("RU");
	Состояние = Определитель.СостояниеБазы();

	Ожидаем.Что(Состояние.Есть, "база на месте").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Состояние.Дата), "дата файла известна").ЭтоИстина();
	Ожидаем.Что(Состояние.ВозрастСек < 3600, "только что положенная база свежа").ЭтоИстина();
	Ожидаем.Что(Состояние.Устарела, "и не устарела").ЭтоЛожь();
	Ожидаем.Что(Состояние.Диапазонов, "диапазонов России в пробной базе").Равно(3);

	База.УстановитьЧасы(Новый ЧасыРучные(ТекущаяДата() + База.ПорогУстареванияСек() + 86400));

	Ожидаем.Что(Определитель.СостояниеБазы().Устарела,
		"через полтора месяца та же база устарела").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПодложенныйРукамиФайлПодхватываетсяПоОтпечатку() Экспорт

	Наблюдать("RU");
	Ожидаем.Что(Определитель.Определить(Проба.НемецкийIPv4()).Исход,
		"КОНТРОЛЬ: Германии в наблюдаемых нет")
		.Равно(Определитель.Исходы().НеНаблюдаемая);
	Ожидаем.Что(База.ПересмотретьФайл(), "нетронутый файл перечитывать не за чем").ЭтоЛожь();

	Строчки = Новый Массив();
	Строчки.Добавить("95.213.0.0,95.213.255.255,DE");
	Строчки.Добавить(Проба.РоссийскийIPv4() + "," + Проба.РоссийскийIPv4() + ",RU");
	Строчки.Добавить("2a02:6b8::,2a02:6b8:ffff:ffff:ffff:ffff:ffff:ffff,RU");
	Проба.Написать(ПутьБазы(), Строчки);

	Ожидаем.Что(База.ПересмотретьФайл(), "новый отпечаток — файл перечитан").ЭтоИстина();
	Ожидаем.Что(Определитель.Определить(Проба.РоссийскийIPv4()).Страна,
		"подложенная база действует").Равно("RU");
	Ожидаем.Что(Определитель.Определить(Проба.ПервыйРоссийскийIPv4()).Исход,
		"а прежний российский диапазон уехал Германии")
		.Равно(Определитель.Исходы().НеНаблюдаемая);

