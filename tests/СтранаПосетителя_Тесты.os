	Ожидаем.Что(Заголовок(Запрос, "CF-IPCountry"),
		"и заголовок уцелел — напильник поставил страну снаружи").Равно("DE");

КонецПроцедуры

#КонецОбласти

#Область СправочникДляСоседей

&Тест
Процедура ПроверкаКодаСтраныОткрытаТемКтоПроверяетВвод() Экспорт

	// дверь для проверки введённого администратором; фоновую перестройку индекса
	// за двумя буквами кода тянуть не приходится
	Справочник = Новый СправочникСтран();

	Ожидаем.Что(Справочник.ЭтоКод("ru"), "строчная запись").ЭтоИстина();
	Ожидаем.Что(Справочник.Канон(" De "), "канон").Равно("DE");
	Ожидаем.Что(Справочник.Канон("ZZ"), "метка неизвестности страной не является").Равно("");
	Ожидаем.Что(Справочник.ЭтоКод("ZZ"), "она же признаком").ЭтоЛожь();
	Ожидаем.Что(Справочник.ЭтоКод("RUS"), "alpha-3").ЭтоЛожь();
	Ожидаем.Что(Справочник.Все().Количество(), "список полон")
		.Равно(Справочник.Количество());
	Ожидаем.Что(Справочник.Количество() > 200,
		СтрШаблон("кодов %1 — справочник ослеп", Справочник.Количество())).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебное

Процедура Собрать(Знач ЗапускФона)

	Настройки = Новый НастройкиЗаглушка();
	Канон = Новый КанонIP();
	Порядок = Новый ПорядокАдресов();
	Политика = Новый СвояСеть(Новый ФейкРазрешительImён(), Канон);
	База = Новый БазаСтран(Настройки, ЗапускФона, ЛогТеста());
	Определитель = Новый ОпределительСтраны(База, Политика, Канон, Настройки);

	Настройки.Задать(База.КлючПути(), ПутьБазы());
	Проба.Положить(ПутьБазы());

КонецПроцедуры

Функция ПутьБазы()
	Возврат ОбъединитьПути(Песочница, "гео", "dbip-country-lite.csv");
КонецФункции

Процедура Наблюдать(Знач Через)
	Определитель.НаблюдатьСтраны(Коды(Через));
КонецПроцедуры

Процедура Доверять(Знач Сети)
	Настройки.Задать("oshub.instance.trusted_proxies", Сети);
КонецПроцедуры

Функция Коды(Знач Через)

	Результат = Новый Массив();
	Для Каждого Код Из СтрРазделить(Через, ",", Ложь) Цикл
		Результат.Добавить(Код);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЗапросСЗаголовком(Знач АдресСоединения, Знач ИмяЗаголовка, Знач Значение)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Host", "hub.example");
	Заголовки.Вставить(ИмяЗаголовка, Значение);
	Возврат Новый Структура("АдресУдаленногоУзла, Заголовки", АдресСоединения, Заголовки);

КонецФункции

Функция Заголовок(Знач Запрос, Знач Имя)
	Возврат Новый ЗаголовкиHTTP().Значение(Запрос.Заголовки, Имя);
КонецФункции

// Пара обёрток, собранная руками набора: внешняя — страна, внутренняя — адрес клиента.
Процедура Прогнать(Запрос)

	САдресом = Новый ОбработчикСАдресомКлиента(Новый ОбработчикЗапросовЗаглушка(Неопределено),
		ОпределительАдреса(), ЛогТеста());
	Внешняя = Новый ОбработчикСоСтранойОтПрокси(САдресом, ПравилоДоверияЗаголовку());
	Внешняя.СформироватьОтвет(Запрос);

КонецПроцедуры

// Та же пара, но собранная НАПИЛЬНИКОМ: порядок внутри пары — его решение, и проверять
// надо именно его, а не тот, что собрал набор.
Функция ОбёрткиНапильника()

	Поделка = Новый ПоделкаИзЖелудей();
	Поделка.Положить("АдресКлиентаЗапроса", ОпределительАдреса());
	Поделка.Положить("ДовериеЗаголовкуСтраны", ПравилоДоверияЗаголовку());

	Напильник = Новый НапильникАдресаКлиента(Поделка, ЛогТеста());
	Возврат Напильник.ОбработатьЖелудь(Новый ОбработчикЗапросовЗаглушка(Неопределено),
		Неопределено);

КонецФункции

Функция ОпределительАдреса()

	Канон = Новый КанонIP();
	Прокси = Новый ДоверенныеПрокси(Настройки, Канон, ЛогТеста());
	Возврат Новый АдресКлиентаЗапроса(Прокси, Новый ЗаписиПересылки(Канон), Канон, ЛогТеста());

КонецФункции

Функция ПравилоДоверияЗаголовку()
	Возврат Новый ДовериеЗаголовкуСтраны(
		Новый ДоверенныеПрокси(Настройки, Новый КанонIP(), ЛогТеста()),
		Определитель, ЛогТеста());
КонецФункции

Функция КлассыВхода()

	Результат = Новый Массив();
	Результат.Добавить("ДоверенныеПрокси");
	Результат.Добавить("ЗаписиПересылки");
	Результат.Добавить("АдресКлиентаЗапроса");
	Результат.Добавить("ОбработчикСАдресомКлиента");
	Результат.Добавить("ДовериеЗаголовкуСтраны");
	Результат.Добавить("ОбработчикСоСтранойОтПрокси");
	Результат.Добавить("НапильникАдресаКлиента");
	Возврат Результат;

КонецФункции

Функция ЛогТеста()
	Возврат Логирование.ПолучитьЛог("тест.oshub.страна");
КонецФункции

#КонецОбласти
