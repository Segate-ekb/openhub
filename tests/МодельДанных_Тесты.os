// Юнит-тесты модели данных (src/модули/данные): регистрация сущностей, авто-DDL, CRUD и поиск с опциями
// на чистом entity (КоннекторInMemory), без контейнера ОСени.

#Использовать asserts
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогКлассовDb;
Перем НомерБазы;   // уникализация строки соединения InMemory между тестами

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	НомерБазы = 0;

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассыМодуляDb() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассовDb = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"), ОбъединитьПути("данные", "Классы"));

	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассовDb, "*.os", Истина) Цикл
		// без глушения ошибок: синтаксически сломанный класс должен уронить набор
		ПоискКлассов.ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура АвтоDDLИнициализируетВсеСущности() Экспорт

	МенеджерСущностей = НовыйМенеджерInMemory();

	Для Каждого ИмяСущности Из ИменаВсехСущностей() Цикл
		Хранилище = МенеджерСущностей.ПолучитьХранилищеСущностей(Тип(ИмяСущности));
		Ожидаем.Что(Хранилище, СтрШаблон("хранилище сущности %1", ИмяСущности)).Существует();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПакетСохраняетсяЧитаетсяИУдаляется() Экспорт

	МенеджерСущностей = НовыйМенеджерInMemory();

	Пакет = Новый Пакет();
	Пакет.ПулИдентификатор = 1;
	Пакет.Имя = "WiNow";
	Пакет.ИмяНижнийРегистр = "winow";
	Пакет.Описание = "Веб-фреймворк";
	Пакет.Устарел = Ложь;
	Пакет.Скрыт = Ложь;
	Пакет.Создан = ТекущаяУниверсальнаяДата();
	МенеджерСущностей.Сохранить(Пакет);

	Ожидаем.Что(Пакет.Идентификатор, "идентификатор после сохранения").Существует();

	Отбор = Новый Соответствие();
	Отбор.Вставить("ИмяНижнийРегистр", "winow");
	Найденный = МенеджерСущностей.ПолучитьОдно(Тип("Пакет"), Отбор);

	Ожидаем.Что(Найденный).Существует();
	Ожидаем.Что(Найденный.Имя).Равно("WiNow");
	Ожидаем.Что(Найденный.Скрыт).Равно(Ложь);

	МенеджерСущностей.Удалить(Найденный);
	Ожидаем.Что(МенеджерСущностей.ПолучитьОдно(Тип("Пакет"), Отбор), "после удаления").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ВерсияПакетаХранитSemverКомпоненты() Экспорт

	МенеджерСущностей = НовыйМенеджерInMemory();

	Версия = Новый ВерсияПакета();
	Версия.ПакетИдентификатор = 7;
	Версия.Версия = "1.2.3-rc.1";
	Версия.SemverМажор = 1;
	Версия.SemverМинор = 2;
	Версия.SemverПатч = 3;
	Версия.SemverПререлиз = "rc.1";
	Версия.ПризнакLegacyВерсии = Ложь;
	Версия.Размер = 2048;
	Версия.Sha256 = "abc123";
	Версия.ВерсияДвижка = "1.9.0";
	Версия.Отозвана = Ложь;
	Версия.Опубликована = ТекущаяУниверсальнаяДата();
	Версия.ПутьВХранилище = "pools/main/winow/winow-1.2.3-rc.1.ospx";
	МенеджерСущностей.Сохранить(Версия);

	Прочитанная = МенеджерСущностей.ПолучитьОдно(Тип("ВерсияПакета"), Версия.Идентификатор);

	Ожидаем.Что(Прочитанная.Версия).Равно("1.2.3-rc.1");
	Ожидаем.Что(Прочитанная.SemverМажор).Равно(1);
	Ожидаем.Что(Прочитанная.SemverМинор).Равно(2);
	Ожидаем.Что(Прочитанная.SemverПатч).Равно(3);
	Ожидаем.Что(Прочитанная.SemverПререлиз).Равно("rc.1");
	Ожидаем.Что(Прочитанная.Размер).Равно(2048);
	Ожидаем.Что(Прочитанная.ВерсияДвижка).Равно("1.9.0");

КонецПроцедуры

// Контракт хранения legacy-версий (4 компонента, "1.2.3.4"): Версия — полная строка, единственный источник
// истины; SemverПререлиз пуст — legacy-хвост НЕ пререлиз, "1.2.3.4" СТАРШЕ "1.2.3"; SemverСборка — четвёртая компонента.
&Тест
Процедура LegacyВерсияЧетыреКомпонентыУкладываетсяВМодель() Экспорт

	МенеджерСущностей = НовыйМенеджерInMemory();

	Версия = Новый ВерсияПакета();
	Версия.ПакетИдентификатор = 8;
	Версия.Версия = "1.2.3.4";
	Версия.SemverМажор = 1;
	Версия.SemverМинор = 2;
	Версия.SemverПатч = 3;
	Версия.SemverПререлиз = "";
	Версия.SemverСборка = "4";
	Версия.ПризнакLegacyВерсии = Истина;
	Версия.Опубликована = ТекущаяУниверсальнаяДата();
	МенеджерСущностей.Сохранить(Версия);

	Прочитанная = МенеджерСущностей.ПолучитьОдно(Тип("ВерсияПакета"), Версия.Идентификатор);

	Ожидаем.Что(Прочитанная.Версия, "строка версии хранит все 4 компоненты").Равно("1.2.3.4");
	Ожидаем.Что(Прочитанная.ПризнакLegacyВерсии).Равно(Истина);
	Ожидаем.Что(Прочитанная.SemverМажор).Равно(1);
	Ожидаем.Что(Прочитанная.SemverМинор).Равно(2);
	Ожидаем.Что(Прочитанная.SemverПатч).Равно(3);
	Ожидаем.Что(Прочитанная.SemverПререлиз, "legacy-хвост не пререлиз").Равно("");
	Ожидаем.Что(Прочитанная.SemverСборка, "четвёртая компонента в SemverСборка").Равно("4");

	ОпцииПоиска = Новый ОпцииПоиска()
		.Отбор("ПакетИдентификатор", ВидСравнения.Равно, 8)
		.Отбор("ПризнакLegacyВерсии", ВидСравнения.Равно, Истина);
	Ожидаем.Что(МенеджерСущностей.Получить(Тип("ВерсияПакета"), ОпцииПоиска).Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ПоискСОтборомСортировкойИОграничением() Экспорт

	МенеджерСущностей = НовыйМенеджерInMemory();

	ДобавитьВерсию(МенеджерСущностей, 1, 0, 5, 0);
	ДобавитьВерсию(МенеджерСущностей, 1, 1, 0, 0);
	ДобавитьВерсию(МенеджерСущностей, 1, 2, 0, 1);
	ДобавитьВерсию(МенеджерСущностей, 1, 10, 0, 0);
	ДобавитьВерсию(МенеджерСущностей, 2, 0, 1, 0);   // другой пакет

	ОпцииПоиска = Новый ОпцииПоиска()
		.Отбор("ПакетИдентификатор", ВидСравнения.Равно, 1)
		.Отбор("SemverМинор", ВидСравнения.БольшеИлиРавно, 1)
		.СортироватьПо("SemverМинор", НаправлениеСортировки.Убыв)
		.Первые(1);

	Найденные = МенеджерСущностей.Получить(Тип("ВерсияПакета"), ОпцииПоиска);

	Ожидаем.Что(Найденные.Количество()).Равно(1);
	Ожидаем.Что(Найденные[0].SemverМинор).Равно(10);

	ОпцииПустого = Новый ОпцииПоиска()
		.Отбор("ПакетИдентификатор", ВидСравнения.Равно, 99);
	Ожидаем.Что(МенеджерСущностей.Получить(Тип("ВерсияПакета"), ОпцииПустого).Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура СессияСоСтроковымИдентификаторомСохраняется() Экспорт

	МенеджерСущностей = НовыйМенеджерInMemory();

	Сессия = Новый ВебСессия();
	Сессия.Идентификатор = Строка(Новый УникальныйИдентификатор());
	Сессия.ПользовательИдентификатор = 5;
	Сессия.ДанныеJSON = "{}";
	Сессия.Истекает = ТекущаяУниверсальнаяДата() + 3600;
	МенеджерСущностей.Сохранить(Сессия);

	Прочитанная = МенеджерСущностей.ПолучитьОдно(Тип("ВебСессия"), Сессия.Идентификатор);

	Ожидаем.Что(Прочитанная).Существует();
	Ожидаем.Что(Прочитанная.ПользовательИдентификатор).Равно(5);

КонецПроцедуры

// Новый менеджер сущностей InMemory с уникальной базой и полной моделью данных.
Функция НовыйМенеджерInMemory()

	НомерБазы = НомерБазы + 1;
	МенеджерСущностей = Новый МенеджерСущностей(Тип("КоннекторInMemory"),
		"модель-данных-тесты-" + Формат(НомерБазы, "ЧГ=0"));

	Для Каждого ИмяСущности Из ИменаВсехСущностей() Цикл
		МенеджерСущностей.ДобавитьКлассВМодель(Тип(ИмяСущности));
	КонецЦикла;

	МенеджерСущностей.Инициализировать();

	Возврат МенеджерСущностей;

КонецФункции

// Имена всех классов-сущностей модуля данные: сущность опознаётся аннотацией &Сущность,
// а не префиксом имени файла — в каталоге лежат и фасады, и классы запросов.
Функция ИменаВсехСущностей()

	Имена = Новый Массив();
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассовDb, "*.os", Истина) Цикл
		Если СтрНайти(ТекстФайла(ФайлКласса.ПолноеИмя), "&Сущность") > 0 Тогда
			Имена.Добавить(ФайлКласса.ИмяБезРасширения);
		КонецЕсли;
	КонецЦикла;

	Возврат Имена;

КонецФункции

Функция ТекстФайла(Знач ПолноеИмя)

	Чтение = Новый ЧтениеТекста(ПолноеИмя, КодировкаТекста.UTF8);
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Содержимое;

КонецФункции

Процедура ДобавитьВерсию(МенеджерСущностей, Знач ПакетИдентификатор, Знач Минор, Знач Патч, Знач Отозвана)

	Версия = Новый ВерсияПакета();
	Версия.ПакетИдентификатор = ПакетИдентификатор;
	Версия.SemverМажор = 0;
	Версия.SemverМинор = Минор;
	Версия.SemverПатч = Патч;
	Версия.Версия = СтрШаблон("0.%1.%2", Минор, Патч);
	Версия.Отозвана = (Отозвана = 1);
	Версия.Опубликована = ТекущаяУниверсальнаяДата();
	МенеджерСущностей.Сохранить(Версия);

КонецПроцедуры
