// Самотест фикстуры СтендВходящих: на ней стоят заявки во «входящие» наборов уборки пула,
// каскада удаления и деривации запросов. Стенд, который кладёт в базу не ту заявку, делает
// их зелёными на строке, которой хаб не умеет пользоваться. Проверяется не фикстура на себе,
// а то, ЧТО ВИДЯТ хранилище и СервисВходящих после стенда, — обе двери, и строкой,
// и службами хаба.
// Набор в отдельном процессе: второй контейнер ОСени конфликтует с контейнером раннера OneUnit.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать pwhash
#Использовать "фикстуры"

Перем ПоискКлассов;     // фикстура КлассыСлоя — файл класса ищется по имени
Перем Слои;             // фикстура СлоиКонтейнера — классы продукта подключаются послойно
Перем Поделка;          // общий контейнер на все тесты набора
Перем Засев;            // фикстура ЗасевРеестра — пул, во «входящие» которого ложится заявка
Перем Учётки;           // фикстура СтендУчёток — заявитель
Перем Стенд;            // фикстура СтендВходящих — заявка строкой и службой
Перем КореньХранилища;  // временный корень файлового хранилища артефактов

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	РеестрФикстур.Подключить("СтендУчёток");
	РеестрФикстур.Подключить("СтендВходящих");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	ПодключитьСлоиВходящих(Модули);

	КореньХранилища = УникальныеИмена.ВременныйКаталог("oshub-inbox-stand");

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "стенд-входящих-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	// autumn-properties.json проекта имеет приоритет выше соответствия деталек: файл
	// настроек переименовывается в несуществующий, иначе набор уедет на общую БД
	Совет.ИмяФайлаСоЗначениямиДеталек("стенд-входящих-properties");
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);
	Учётки = Новый СтендУчёток(Поделка);
	Стенд = Новый СтендВходящих(Поделка);

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт

	УникальныеИмена.УбратьВременное(КореньХранилища);

КонецПроцедуры

// Приём заявки тянет за собой весь путь push: очередь, хранилище артефактов, учёт места
// пула и пределы очереди из настроек — стенд обязан собираться на том же наборе классов,
// что и продукт.
Процедура ПодключитьСлоиВходящих(Знач Модули)

	Слои.Подключить("данные");
	Слои.Подключить("хранилище, публикация, реестр, основа, наблюдаемость/телеметрия, события");

	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "СобытиеАудита.os"));

	Слои.Подключить("почта");
	Слои.Подключить("уведомления, вход, права, настройки");

	РеестрФикстур.Подключить("ЗаписывающийПодписчик");

КонецПроцедуры

#Область ЗаявкаСтрокой

&Тест
Процедура ЗаявкаЛожитсяВБазуИВиднаОчередиОжидающих() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("inb"));
	Заявитель = Учётки.Учётка();

	Поданная = Стенд.Заявка(Пул, Заявитель);

	Прочитанная = Входящие().Заявка(Поданная.Идентификатор);
	Ожидаем.Что(Прочитанная, "заявка легла в базу").Существует();
	Ожидаем.Что(Цел(Прочитанная.ПулИдентификатор), "во «входящих» названного пула")
		.Равно(Цел(Пул.Идентификатор));
	Ожидаем.Что(Цел(Прочитанная.ЗаявительИдентификатор), "от названного заявителя")
		.Равно(Цел(Заявитель.Идентификатор));
	Ожидаем.Что(Прочитанная.Версия, "версия по умолчанию").Равно("1.0.0");
	Ожидаем.Что(Входящие().ОжидающиеПула(Пул.Идентификатор).Количество(),
		"заявка ждёт решения").Равно(1);

КонецПроцедуры

// Что набор назвал двери, то и должно доехать до базы. Имя, потерянное по дороге,
// оставило бы набор про захват имени зелёным на чужом имени.
&Тест
Процедура ДверьСтрокойДоноситИмяВерсиюИКанонИмени() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("inb"));
	Заявитель = Учётки.Учётка();

	Стенд.Заявка(Пул, Заявитель, "SelfTest-Inbox", "2.3.4");

	Найденная = Входящие().ОжидающиеПула(Пул.Идентификатор)[0];
	Ожидаем.Что(Найденная.ИмяПакета, "названное имя дошло до базы в своём регистре")
		.Равно("SelfTest-Inbox");
	Ожидаем.Что(Найденная.ИмяНижнийРегистр, "канон имени — тот, по которому ищут соперницу")
		.Равно("selftest-inbox");
	Ожидаем.Что(Найденная.Версия, "названная версия дошла до базы").Равно("2.3.4");
	Ожидаем.Что(Найденная.ИмяФайла, "имя файла собрано как его шлёт opm")
		.Равно("SelfTest-Inbox-2.3.4.ospx");

КонецПроцедуры

// Состояние — параметр двери, а не догадка: заявка, уже рассмотренная, из очереди
// ожидающих уходит, и набор про счётчик очереди считал бы её вместе с живыми.
&Тест
Процедура НазванноеСостояниеУводитЗаявкуИзОчередиОжидающих() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("inb"));
	Заявитель = Учётки.Учётка();

	Отклонённая = Стенд.Заявка(Пул, Заявитель, "", "1.0.0", Входящие().СостояниеОтклонена());
	Стенд.Заявка(Пул, Заявитель);

	Ожидаем.Что(Отклонённая.Состояние, "названное состояние дошло до базы")
		.Равно(Входящие().СостояниеОтклонена());
	Ожидаем.Что(Входящие().ОжидающиеПула(Пул.Идентификатор).Количество(),
		"решения ждёт только вторая заявка").Равно(1);
	Ожидаем.Что(Желудь("ХранилищеВходящихПубликаций").ПолучитьПоПулИдентификаторРавно(
		Пул.Идентификатор).Количество(), "а в таблице пула лежат обе").Равно(2);

КонецПроцедуры

// Имена по умолчанию обязаны быть свободными: заявку на уже заявленное имя хаб отбивает
// как конкурентную, а набор, поднимающий три заявки подряд, имён им не придумывает.
&Тест
Процедура ИменаПоУмолчаниюНеСталкиваются() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("inb"));
	Заявитель = Учётки.Учётка();

	Первая = Стенд.Заявка(Пул, Заявитель);
	Вторая = Стенд.Заявка(Пул, Заявитель);

	Ожидаем.Что(Первая.ИмяПакета <> Вторая.ИмяПакета,
		СтрШаблон("две заявки — два имени (%1 и %2)",
			Первая.ИмяПакета, Вторая.ИмяПакета)).ЭтоИстина();
	Ожидаем.Что(Первая.КлючХранилища <> Вторая.КлючХранилища,
		СтрШаблон("и два ключа во «входящих» (%1 и %2)",
			Первая.КлючХранилища, Вторая.КлючХранилища)).ЭтоИстина();

КонецПроцедуры

// Пул и заявитель называются набору то записью, то одним лишь номером: наборы деривации
// запросов работают с номерами объектов, которых в реестре нет вовсе.
&Тест
Процедура ПулИЗаявительНазываютсяЗаписьюЛибоНомером() Экспорт

	ПулНомер = УникальныеИмена.Номер();
	ЗаявительНомер = УникальныеИмена.Номер();

	Стенд.Заявка(ПулНомер, ЗаявительНомер, "числами", "1.0.0");

	Заявки = Желудь("ХранилищеВходящихПубликаций").ПолучитьПоПулИдентификаторРавно(ПулНомер);
	Ожидаем.Что(Заявки.Количество(), "заявка легла на пул, которого в реестре нет").Равно(1);
	Ожидаем.Что(Цел(Заявки[0].ЗаявительИдентификатор), "и на названного номером заявителя")
		.Равно(ЗаявительНомер);

КонецПроцедуры

#КонецОбласти

#Область ЗаявкаСлужбамиХаба

// Главный сторож фикстуры. Заявка, положенная строкой, обязана быть неотличима от принятой
// службой в тех колонках, по которым её судит хаб: непроставленное «ещё не рассмотрена»
// или чужой канал уводят одобрение такой заявки мимо продуктового пути — версия публикуется
// без метки, а карточка заявки показывает рассмотревшего там, где его нет.
&Тест
Процедура СтрокаСтендаСовпадаетСоСтрокойСлужбыВСудимыхКолонках() Экспорт

	ПулСтроки = Засев.ПулСервисом(УникальныеИмена.Имя("inb"));
	ПулСлужбы = Засев.ПулСервисом(УникальныеИмена.Имя("inb"));
	Заявитель = Учётки.Учётка();
	Имя = УникальныеИмена.Имя("pair");

	Строкой = Стенд.Заявка(ПулСтроки, Заявитель, Имя, "1.2.3");
	Службой = Стенд.ЗаявкаСлужбой(ПулСлужбы, Заявитель, Имя, "1.2.3");

	Ожидаем.Что(Строкой.ИмяПакета, "имя пакета то же, что кладёт служба").Равно(Службой.ИмяПакета);
	Ожидаем.Что(Строкой.ИмяНижнийРегистр, "канон имени тот же").Равно(Службой.ИмяНижнийРегистр);
	Ожидаем.Что(Строкой.Версия, "версия та же").Равно(Службой.Версия);
	Ожидаем.Что(Строкой.Состояние, "состояние то же").Равно(Службой.Состояние);
	Ожидаем.Что(Цел(Строкой.ЗаявительИдентификатор), "заявитель тот же")
		.Равно(Цел(Службой.ЗаявительИдентификатор));
	Ожидаем.Что(Строкой.ИмяФайла, "имя файла то же").Равно(Службой.ИмяФайла);
	Ожидаем.Что(Строкой.Канал, "канал тот же").Равно(Службой.Канал);
	Ожидаем.Что(Строкой.Канал, "и это канал push, а не общая пустота обеих дверей").Равно("stable");
	Ожидаем.Что(Строкой.АвторМанифеста, "автор манифеста тот же").Равно(Службой.АвторМанифеста);
	Ожидаем.Что(Строкой.Комментарий, "комментарий тот же").Равно(Службой.Комментарий);
	Ожидаем.Что(Строкой.Рассмотрена, "момент рассмотрения тот же").Равно(Службой.Рассмотрена);
	Ожидаем.Что(Цел(Строкой.РассмотрелИдентификатор), "рассмотревший тот же")
		.Равно(Цел(Службой.РассмотрелИдентификатор));

	Ожидаем.Что(Цел(Строкой.ПулИдентификатор), "и каждая заявка лежит в своём пуле")
		.Равно(Цел(ПулСтроки.Идентификатор));
	Ожидаем.Что(Цел(Службой.ПулИдентификатор), "включая заявку службы")
		.Равно(Цел(ПулСлужбы.Идентификатор));

КонецПроцедуры

// Этим двери и различаются: служба пишет байты во «входящие» хранилища и занимает ими место
// пула, а строка кладёт только запись. Набор, судящий квоту заявок или выдачу артефакта
// рассматривающему, обязан брать дверь службой.
&Тест
Процедура ДверьСлужбойКладётАртефактИЗанимаетМестоПулаАДверьСтрокойНет() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("inb"));
	Заявитель = Учётки.Учётка();

	Служебная = Стенд.ЗаявкаСлужбой(Пул, Заявитель);

	Ожидаем.Что(Цел(Служебная.Размер) > 0,
		СтрШаблон("служба записала размер артефакта (%1)", Служебная.Размер)).ЭтоИстина();
	Ожидаем.Что(Служебная.Sha256, "и его контрольную сумму").Заполнено();
	Ожидаем.Что(Входящие().ДанныеЗаявки(Служебная, Пул.Имя),
		"байты заявки лежат во «входящих» хранилища").Существует();
	Ожидаем.Что(Цел(ЗанятоПулом(Пул)) > 0,
		СтрШаблон("и заняли место пула (%1 байт)", ЗанятоПулом(Пул))).ЭтоИстина();

	ПулСтроки = Засев.ПулСервисом(УникальныеИмена.Имя("inb"));
	Строкой = Стенд.Заявка(ПулСтроки, Заявитель);

	Ожидаем.Что(Цел(Строкой.Размер), "у заявки строкой размера нет").Равно(0);
	Ожидаем.Что(Цел(ЗанятоПулом(ПулСтроки)), "и места пула она не занимает").Равно(0);

КонецПроцедуры

// Дверь службой обязана быть настоящей, а не пересказом: заявка проходит очередь хаба
// и видна ей наравне с принятыми push.
&Тест
Процедура ДверьСлужбойДоноситИмяВерсиюИСвободныеИменаПоУмолчанию() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("inb"));
	Заявитель = Учётки.Учётка();

	Названная = Стенд.ЗаявкаСлужбой(Пул, Заявитель, "SelfTest-Service", "3.0.1");

	Ожидаем.Что(Названная.ИмяПакета, "названное имя дошло до хаба").Равно("SelfTest-Service");
	Ожидаем.Что(Названная.ИмяНижнийРегистр, "хаб канонизировал имя").Равно("selftest-service");
	Ожидаем.Что(Названная.Версия, "названная версия дошла до хаба").Равно("3.0.1");
	Ожидаем.Что(Входящие().Заявка(Названная.Идентификатор), "заявка видна очереди хаба")
		.Существует();

	Первая = Стенд.ЗаявкаСлужбой(Пул, Заявитель);
	Вторая = Стенд.ЗаявкаСлужбой(Пул, Заявитель);
	Ожидаем.Что(Первая.ИмяПакета <> Вторая.ИмяПакета,
		СтрШаблон("имена по умолчанию свободны (%1 и %2)",
			Первая.ИмяПакета, Вторая.ИмяПакета)).ЭтоИстина();

КонецПроцедуры

// Отказ хаба дверь превращает в исключение, а не в тихое Неопределено: набор, получивший
// вместо заявки пустоту, падал бы позже и не там, а стенд без заявки оставил бы его
// зелёным на пустой очереди.
&Тест
Процедура ОтказХабаДверьСлужбойПревращаетВИсключение() Экспорт

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("inb"));
	Первый = Учётки.Учётка();
	Второй = Учётки.Учётка();
	Имя = УникальныеИмена.Имя("clash");

	Стенд.ЗаявкаСлужбой(Пул, Первый, Имя, "1.0.0");

	Отказ = "";
	Попытка
		Стенд.ЗаявкаСлужбой(Пул, Второй, Имя, "1.0.0");
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Отказ), "заявка на чужое заявленное имя не принята")
		.ЭтоИстина();
	Ожидаем.Что(Входящие().ОжидающиеПула(Пул.Идентификатор).Количество(),
		"и второй строки в очереди не появилось").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция Входящие()
	Возврат Желудь("СервисВходящих");
КонецФункции

Функция ЗанятоПулом(Знач Пул)
	Возврат Желудь("ХранилищеПулов").ПолучитьОдноПоИдентификаторРавно(
		Пул.Идентификатор).ЗанятоБайт;
