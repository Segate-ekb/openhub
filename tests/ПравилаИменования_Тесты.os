// Юнит-тесты ПравилаИменования (реестр): общие правила имён пакетов и пулов.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогКлассов;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт
	ПодключитьКлассыРеестра();
КонецПроцедуры

&Тест
Процедура КорректныеИменаПринимаются() Экспорт

	Имена = СтрРазделить("winow|oscript-md|one_unit|v8.tools|1c-lib|a|A|B2|semver|ospx-tools", "|");

	Для Каждого Имя Из Имена Цикл
		Ожидаем.Что(Правила().ИмяКорректно(Имя),
			СтрШаблон("имя ""%1"" должно приниматься", Имя)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура НекорректныеИменаОтклоняются() Экспорт

	Имена = СтрРазделить("-lead|.lead|_lead|имя|тест-lib|na me|a/b|a\b|па,кет|a@b|", "|");

	Для Каждого Имя Из Имена Цикл
		Ожидаем.Что(Правила().ИмяКорректно(Имя),
			СтрШаблон("имя ""%1"" должно отклоняться", Имя)).ЭтоЛожь();
	КонецЦикла;

	Ожидаем.Что(Правила().ИмяКорректно(Неопределено)).ЭтоЛожь();
	Ожидаем.Что(Правила().ИмяКорректно(42)).ЭтоЛожь();

	Длинное = "";
	Пока СтрДлина(Длинное) <= 100 Цикл
		Длинное = Длинное + "abcdefghij";
	КонецЦикла;
	Ожидаем.Что(Правила().ИмяКорректно(Длинное)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура КанонизацияПриводитКНижнемуРегиструИОбрезаетПробелы() Экспорт

	Ожидаем.Что(Правила().Канонизировать("WiNow")).Равно("winow");
	Ожидаем.Что(Правила().Канонизировать("  OneUnit  ")).Равно("oneunit");
	Ожидаем.Что(Правила().Канонизировать("already-lower")).Равно("already-lower");

КонецПроцедуры

&Тест
Процедура КанонизацияНекорректногоИмениЭтоИсключение() Экспорт

	ОписаниеОшибки = "";
	Попытка
		Правила().Канонизировать("плохое имя");
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрДлина(ОписаниеОшибки) > 0, "некорректное имя - исключение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ОписаниеОшибки, "плохое имя") > 0,
		"текст ошибки называет имя: " + ОписаниеОшибки).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПроверитьИмяПропускаетКорректное() Экспорт

	Правила().ПроверитьИмя("normal-name");
	Ожидаем.Что(Истина).ЭтоИстина();

КонецПроцедуры

// Имена, повторяющие служебные адреса хаба и описания API, — обычные имена: страницы пула
// и пакета живут под /pools, и ни одно имя не соревнуется с адресом хаба.
&Тест
Процедура ИменаСлужебныхАдресовДопустимы() Экспорт

	Для Каждого Имя Из СтрРазделить("api|login|settings|packages|pools|static|me|hub|v3"
		+ "|swagger-ui.html|download|push|changes", "|") Цикл
		Ожидаем.Что(Правила().ИмяКорректно(Имя), СтрШаблон("имя ""%1"" допустимо", Имя)).ЭтоИстина();
		Ожидаем.Что(Правила().Канонизировать(ВРег(Имя)), СтрШаблон("имя ""%1"" канонизируется", Имя))
			.Равно(Имя);
	КонецЦикла;

КонецПроцедуры

Функция Правила()
	Возврат Новый ПравилаИменования();
КонецФункции

Процедура ПодключитьКлассыРеестра()

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогКлассов = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("реестр", "Классы"));

	// Примитивы «основы» спрашивает почти каждый класс реестра: без них набор,
	// запущенный в одиночку, падает «Type is not defined» ещё до утверждений,
	// а в общем прогоне держится на том, что их подключил сосед по процессу.
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	ПоискКлассов.ПодключитьВсе(КаталогКлассов);

КонецПроцедуры
