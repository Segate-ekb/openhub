// Юнит-тесты ПравилаИменования (реестр): общие правила имён пакетов и пулов.

#Использовать asserts
#Использовать annotations
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогКлассов;
Перем КэшМаршрутов;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт
	ПодключитьКлассыРеестра();
КонецПроцедуры

&Тест
Процедура КорректныеИменаПринимаются() Экспорт

	Имена = СтрРазделить("winow|oscript-md|one_unit|v8.tools|1c-lib|a|A|B2|semver|ospx-tools", "|");

	Для Каждого Имя Из Имена Цикл
		Ожидаем.Что(Правила().ИмяКорректно(Имя),
			СтрШаблон("имя ""%1"" должно приниматься", Имя)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура НекорректныеИменаОтклоняются() Экспорт

	Имена = СтрРазделить("-lead|.lead|_lead|имя|тест-lib|na me|a/b|a\b|па,кет|a@b|", "|");

	Для Каждого Имя Из Имена Цикл
		Ожидаем.Что(Правила().ИмяКорректно(Имя),
			СтрШаблон("имя ""%1"" должно отклоняться", Имя)).ЭтоЛожь();
	КонецЦикла;

	Ожидаем.Что(Правила().ИмяКорректно(Неопределено)).ЭтоЛожь();
	Ожидаем.Что(Правила().ИмяКорректно(42)).ЭтоЛожь();

	Длинное = "";
	Пока СтрДлина(Длинное) <= 100 Цикл
		Длинное = Длинное + "abcdefghij";
	КонецЦикла;
	Ожидаем.Что(Правила().ИмяКорректно(Длинное)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура КанонизацияПриводитКНижнемуРегиструИОбрезаетПробелы() Экспорт

	Ожидаем.Что(Правила().Канонизировать("WiNow")).Равно("winow");
	Ожидаем.Что(Правила().Канонизировать("  OneUnit  ")).Равно("oneunit");
	Ожидаем.Что(Правила().Канонизировать("already-lower")).Равно("already-lower");

КонецПроцедуры

&Тест
Процедура КанонизацияНекорректногоИмениЭтоИсключение() Экспорт

	ОписаниеОшибки = "";
	Попытка
		Правила().Канонизировать("плохое имя");
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрДлина(ОписаниеОшибки) > 0, "некорректное имя - исключение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ОписаниеОшибки, "плохое имя") > 0,
		"текст ошибки называет имя: " + ОписаниеОшибки).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПроверитьИмяПропускаетКорректное() Экспорт

	Правила().ПроверитьИмя("normal-name");
	Ожидаем.Что(Истина).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СистемныеСегментыЗарезервированыДляПулов() Экспорт

	// первый сегмент URL делят имена пулов и логины: системный литерал перекрыл бы пул
	Имена = СтрРазделить("static|assets|api|health|ready|packages|login|register|setup|"
		+ "office|download|me|hub|groups|settings|logout|pools|tour|ui|invite|cli", "|");

	Для Каждого Имя Из Имена Цикл
		Ожидаем.Что(Правила().ИмяПулаЗарезервировано(Имя),
			СтрШаблон("имя пула ""%1"" должно быть зарезервировано", Имя)).ЭтоИстина();
		Ожидаем.Что(Правила().ИмяПулаЗарезервировано(ВРег(Имя)),
			СтрШаблон("резерв не зависит от регистра (""%1"")", Имя)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ЛогинПроходитТотЖеРезервЧтоИПул() Экспорт

	// резерв логинов: без списка логин `static` занял бы системный сегмент — список намеренно тот же
	Для Каждого Имя Из Правила().ЗарезервированныеИменаПулов() Цикл
		Ожидаем.Что(Правила().ЛогинЗарезервирован(Имя),
			СтрШаблон("логин ""%1"" должен быть зарезервирован", Имя)).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(Правила().ЛогинЗарезервирован("alice"), "обычный логин свободен").ЭтоЛожь();
	Ожидаем.Что(Правила().ЛогинЗарезервирован("  Static  "), "пробелы и регистр не обходят резерв").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПроверитьЛогинБросаетНаЗарезервированном() Экспорт

	Поймано = Ложь;
	Попытка
		Правила().ПроверитьЛогин("hub");
	Исключение
		Поймано = Истина;
	КонецПопытки;
	Ожидаем.Что(Поймано, "зарезервированный логин — исключение").ЭтоИстина();

	Правила().ПроверитьЛогин("alice"); // не должно бросать

КонецПроцедуры

&Тест
Процедура РезервИмёнПакетовУжеЧемУПулов() Экспорт

	// имя пакета — второй сегмент (/{pool}/{pkg}): мешают только литералы под /{pool}/ (сегодня `настройки`)
	Ожидаем.Что(Правила().ИмяПакетаЗарезервировано("settings"), "settings занят домом пула").ЭтоИстина();
	Ожидаем.Что(Правила().ИмяПакетаЗарезервировано("SETTINGS"), "регистр не обходит резерв").ЭтоИстина();
	Ожидаем.Что(Правила().ИмяПакетаЗарезервировано("  settings "), "пробелы не обходят резерв").ЭтоИстина();

	Для Каждого Имя Из СтрРазделить("hub|api|me|static|winow|settings-helper", "|") Цикл
		Если Имя = "settings" Тогда
			Продолжить;
		КонецЕсли;
		Ожидаем.Что(Правила().ИмяПакетаЗарезервировано(Имя),
			СтрШаблон("имя пакета ""%1"" свободно", Имя)).ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

#Область РезервИМаршруты

// СТОРОЖ ЗНАЧЕНИЯ, А НЕ ТЕКСТА. Перечисление маршрутов руками (тест выше) уже пропустило
// новый `/invite` и годами не замечало `/cli`: человек, добавляя маршрут, правит одно
// место из двух. Список маршрутов здесь СПРАШИВАЕТСЯ У РАНТАЙМА: аннотации разбирает тот
// же Рефлектор, которым СборщикМаршрутов winow читает &Контроллер и &ТочкаМаршрута, —
// регистр, лишние пробелы и переносы там не существуют как класс обхода. Сегмент считается
// по ПОЛНОМУ адресу (префикс контроллера + точка маршрута): префикс занимает первый
// сегмент ровно так же, как маршрут корневого контроллера. Обратное включение не
// проверяется: резерв законно шире.
&Тест
Процедура КаждыйПервыйСегментМаршрутаЗарезервирован() Экспорт

	Скан = МаршрутыРантайма();
	Незарезервированные = Новый Массив();

	Для Каждого КлючЗначение Из Скан.Сегменты Цикл
		Если НЕ Правила().ИмяПулаЗарезервировано(КлючЗначение.Ключ) Тогда
			Незарезервированные.Добавить(КлючЗначение.Ключ + " (" + КлючЗначение.Значение + ")");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Скан.НеПрочитанные, "; "),
		"контроллер не поддался разбору — на его маршрутах сторож ослеп бы молча").Равно("");
	Ожидаем.Что(Скан.Контроллеров > 40,
		СтрШаблон("скан ослеп: контроллеров найдено %1", Скан.Контроллеров)).ЭтоИстина();
	Ожидаем.Что(Скан.Сегменты.Количество() > 20,
		СтрШаблон("скан ослеп: сегментов найдено %1", Скан.Сегменты.Количество())).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Незарезервированные, ", "),
		"первые сегменты маршрутов вне резерва: пул или логин с таким именем заводится,"
		+ " а страница становится недостижимой — добавьте имя в"
		+ " ЗарезервированныеИменаПулов").Равно("");

КонецПроцедуры

// Скан обязан видеть заведомо известные сегменты — и маршруты корневых контроллеров,
// и префиксы самих контроллеров: пустая выдача сделала бы проверку выше вечнозелёной,
// а счётчика для этого мало — он ловит только полную слепоту.
&Тест
Процедура СканМаршрутовВидитИзвестныеСегменты() Экспорт

	Сегменты = МаршрутыРантайма().Сегменты;

	Известные = "invite,cli,register,setup,login,push," // маршруты корневых контроллеров
		+ "api,groups,hub,me,office,packages,static,ui"; // префиксы контроллеров

	Для Каждого Ожидаемый Из СтрРазделить(Известные, ",") Цикл
		Ожидаем.Что(Сегменты.Получить(Ожидаемый) <> Неопределено,
			СтрШаблон("скан видит сегмент ""%1""", Ожидаемый)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// ВТОРАЯ СЕТЬ. Текстовый скан решением не является, но обязан оставаться согласованным
// с рантаймом: маршрут, видимый в исходниках и невидимый рефлексии, означает, что скан
// значения потерял контроллер (не подключился, переименован, обёрнут) — и молча ослеп.
&Тест
Процедура ТекстовыйСканНеНаходитМаршрутовМимоРантайма() Экспорт

	Рантайм = МаршрутыРантайма().Сегменты;
	Пропущенные = Новый Массив();

	Для Каждого Файл Из ФайлыКандидаты() Цикл
		Для Каждого КлючЗначение Из СегментыИзИсходника(ПрочитатьИсходник(Файл.ПолноеИмя)) Цикл
			Если Рантайм.Получить(КлючЗначение.Ключ) = Неопределено Тогда
				Пропущенные.Добавить(КлючЗначение.Ключ + " (" + Файл.Имя + ")");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропущенные, ", "),
		"текст видит сегмент, которого не видит рантайм: скан значения ослеп").Равно("");

КонецПроцедуры

// САМОТЕСТ «литерал — не директива» и «комментарий — не код»: сканер обязан читать
// объявление, а не любое упоминание. Плюс доказательство, что он не вечнозелёный:
// на образце с незарезервированным маршрутом он этот маршрут находит.
&Тест
Процедура СканМаршрутовЧитаетКодАНеТекст() Экспорт

	Образец = "&Контроллер(""/"")" + Символы.ПС
		+ "// &ТочкаМаршрута(""изкомментария"")" + Символы.ПС
		+ "Образец = ""&ТочкаМаршрута(""""излитерала"""")"";" + Символы.ПС
		+ "	Текст = ""начало" + Символы.ПС
		+ "	|&ТочкаМаршрута(""""измногострочного"""")"";" + Символы.ПС
		+ "&ТочкаМаршрута(""настоящий/хвост"")" + Символы.ПС
		+ "Процедура Точка() Экспорт" + Символы.ПС;

	Найденные = СегментыИзИсходника(Образец);

	Ожидаем.Что(Найденные.Получить("настоящий") <> Неопределено,
		"объявление прочитано").ЭтоИстина();
	Ожидаем.Что(Найденные.Получить("изкомментария"), "комментарий не директива").Равно(Неопределено);
	Ожидаем.Что(Найденные.Получить("излитерала"), "литерал не директива").Равно(Неопределено);
	Ожидаем.Что(Найденные.Получить("измногострочного"),
		"продолжение многострочного литерала не директива").Равно(Неопределено);

	// и сам резерв на этом образце обязан отвечать «нет» — иначе главная проверка
	// была бы зелёной при любом сканере
	Ожидаем.Что(Правила().ИмяПулаЗарезервировано("настоящий"),
		"незарезервированный маршрут резерв не признаёт").ЭтоЛожь();

КонецПроцедуры

// САМОТЕСТ «регистр и пробел — не способ спрятаться». Рантайм сопоставляет имена
// аннотаций через НРег, поэтому строчная запись и пробел перед скобкой обслуживаются
// как обычный маршрут; текстовая сеть обязана видеть ровно то же самое.
&Тест
Процедура СканМаршрутовНеОбходитсяРегистромИПробелом() Экспорт

	Образец = "&контроллер (""/"")" + Символы.ПС
		+ "&точкамаршрута(""/строчная"")" + Символы.ПС
		+ "&ТочкаМаршрута  (""/спробелом"")" + Символы.ПС;

	Найденные = СегментыИзИсходника(Образец);

	Ожидаем.Что(Найденные.Получить("строчная") <> Неопределено,
		"строчная аннотация — тот же маршрут").ЭтоИстина();
	Ожидаем.Что(Найденные.Получить("спробелом") <> Неопределено,
		"пробел перед скобкой — тот же маршрут").ЭтоИстина();

	// оба имени вне резерва — иначе самотест был бы зелёным при любом сканере
	Ожидаем.Что(Правила().ИмяПулаЗарезервировано("строчная")).ЭтоЛожь();
	Ожидаем.Что(Правила().ИмяПулаЗарезервировано("спробелом")).ЭтоЛожь();

	// имя аннотации целиком, а не префиксом: &ТочкаМаршрутаЧего-то маршрута не объявляет
	Ожидаем.Что(СегментыИзИсходника("&Контроллер(""/"")" + Символы.ПС
		+ "&ТочкаМаршрутаЛишняя(""/хвост"")" + Символы.ПС).Количество(),
		"похожее имя аннотации маршрутом не считается").Равно(0);

КонецПроцедуры

// САМОТЕСТ «префикс контроллера — тоже первый сегмент». Половина поверхности живёт
// в &Контроллер: новый `&Контроллер("/newthing")` вносит первый сегмент, не написав
// ни одного маршрута с ним.
&Тест
Процедура СканМаршрутовВидитПрефиксКонтроллера() Экспорт

	Найденные = СегментыИзИсходника("&Контроллер(""/префикс"")" + Символы.ПС
		+ "&ТочкаМаршрута(""/хвост"")" + Символы.ПС);

	Ожидаем.Что(Найденные.Получить("префикс") <> Неопределено,
		"префикс контроллера занимает первый сегмент").ЭтоИстина();
	Ожидаем.Что(Найденные.Получить("хвост"),
		"второй сегмент первым не бывает").Равно(Неопределено);
	Ожидаем.Что(Правила().ИмяПулаЗарезервировано("префикс")).ЭтоЛожь();

	Ожидаем.Что(СегментыИзИсходника("&ТочкаМаршрута(""/сирота"")" + Символы.ПС).Количество(),
		"без объявления контроллера маршрута нет").Равно(0);

КонецПроцедуры

// Параметрический сегмент именем не является: {pool} — не литерал, и резервировать
// его нечего. Иначе сканер краснел бы на каждом маршруте пула.
&Тест
Процедура СканМаршрутовНеСчитаетПараметрИКорень() Экспорт

	Образец = "&Контроллер(""/"")" + Символы.ПС
		+ "&ТочкаМаршрута(""{pool}/{name}/settings"")" + Символы.ПС
		+ "&ТочкаМаршрута(""/"")" + Символы.ПС
		+ "&ТочкаМаршрута("""")" + Символы.ПС;

	Ожидаем.Что(СегментыИзИсходника(Образец).Количество(),
		"ни параметр, ни корень, ни пустой маршрут именем не являются").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СканМаршрутов

// Маршруты глазами рантайма: сегмент -> имя файла контроллера. Полный контейнер winow
// поднимать не нужно и незачем — источник истины у сборщика маршрутов тот же самый
// (Рефлектор по типу желудя), а поднятая Поделка потребовала бы БД, хранилища и порта.
Функция МаршрутыРантайма()

	Если КэшМаршрутов <> Неопределено Тогда
		Возврат КэшМаршрутов;
	КонецЕсли;

	Рефлектор = Новый Рефлектор();
	Сегменты = Новый Соответствие();
	НеПрочитанные = Новый Массив();
	Контроллеров = 0;

	Для Каждого Файл Из ФайлыКандидаты() Цикл

		Псевдоним = "СканМаршрутов" + Файл.ИмяБезРасширения;
		Если НЕ ПоискКлассов.ТипЗарегистрирован(Псевдоним) Тогда
			Попытка
				ПодключитьСценарий(Файл.ПолноеИмя, Псевдоним);
			Исключение
				НеПрочитанные.Добавить(Файл.Имя + ": "
					+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
		КонецЕсли;

		Методы = Рефлектор.ПолучитьТаблицуМетодов(Тип(Псевдоним));
		Адрес = ЗначениеАннотации(Методы, "Контроллер");
		Если Адрес = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Контроллеров = Контроллеров + 1;

		Для Каждого Метод Из РаботаСАннотациями.НайтиМетодыСАннотацией(Методы, "ТочкаМаршрута") Цикл
			Точка = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
				РаботаСАннотациями.ПолучитьАннотацию(Метод, "ТочкаМаршрута"));
			Сегмент = ПервыйСегмент(Адрес, Точка);
			Если ЗначениеЗаполнено(Сегмент) Тогда
				Сегменты.Вставить(Сегмент, Файл.Имя);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	КэшМаршрутов = Новый Структура("Сегменты, Контроллеров, НеПрочитанные",
		Сегменты, Контроллеров, НеПрочитанные);
	Возврат КэшМаршрутов;

КонецФункции

Функция ЗначениеАннотации(Знач Методы, Знач ИмяАннотации)

	Для Каждого Метод Из РаботаСАннотациями.НайтиМетодыСАннотацией(Методы, ИмяАннотации) Цикл
		Возврат РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
			РаботаСАннотациями.ПолучитьАннотацию(Метод, ИмяАннотации));
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Кандидат — исходник, где имя аннотации контроллера встречается хоть как-нибудь.
// Отбор намеренно грубый и регистронезависимый: лишний кандидат безвреден (рефлексия
// не найдёт аннотацию), а пропущенный сделал бы сторож слепым.
Функция ФайлыКандидаты()

	Результат = Новый Массив();
	Корень = ОбъединитьПути(КореньПроекта(), "src", "модули");

	Для Каждого Файл Из НайтиФайлы(Корень, "*.os", Истина) Цикл
		Если СтрНайти(НРег(ПрочитатьИсходник(Файл.ПолноеИмя)), "&контроллер") > 0 Тогда
			Результат.Добавить(Файл);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Вторая сеть: тот же ответ, вычитанный из текста. Аннотация в OneScript стоит В НАЧАЛЕ
// строки перед объявлением — этим она и отличается от своего упоминания в комментарии
// (строка начинается с «//») и в литерале (строка начинается с присваивания либо
// с «|» продолжения).
Функция СегментыИзИсходника(Знач Текст)

	Результат = Новый Соответствие();
	Адрес = Неопределено;
	Точки = Новый Массив();

	Для Каждого Строка_ Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Значение = ЗначениеАннотацииСтроки(Строка_, "Контроллер");
		Если Значение <> Неопределено Тогда
			Адрес = ?(Адрес = Неопределено, Значение, Адрес);
			Продолжить;
		КонецЕсли;
		Значение = ЗначениеАннотацииСтроки(Строка_, "ТочкаМаршрута");
		Если Значение <> Неопределено Тогда
			Точки.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

	Если Адрес = Неопределено Тогда
		Возврат Результат; // без объявления контроллера точки маршрута никуда не ведут
	КонецЕсли;

	Для Каждого Точка Из Точки Цикл
		Сегмент = ПервыйСегмент(Адрес, Точка);
		Если ЗначениеЗаполнено(Сегмент) Тогда
			Результат.Вставить(Сегмент, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Регистр и пробелы между именем аннотации и скобкой значения не меняют: рантайм
// сопоставляет имена через НРег, и текстовая сеть обязана видеть ровно то же самое.
Функция ЗначениеАннотацииСтроки(Знач Строка_, Знач ИмяАннотации)

	Остаток = СокрЛП(Строка_);
	Если НЕ СтрНачинаетсяС(НРег(Остаток), "&" + НРег(ИмяАннотации)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Остаток = СокрЛ(Сред(Остаток, СтрДлина(ИмяАннотации) + 2));
	Если НЕ СтрНачинаетсяС(Остаток, "(") Тогда
		Возврат Неопределено; // имя аннотации целиком, а не префиксом
	КонецЕсли;

	Остаток = СокрЛ(Сред(Остаток, 2));
	Если НЕ СтрНачинаетсяС(Остаток, """") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Остаток = Сред(Остаток, 2);
	Конец = СтрНайти(Остаток, """");
	Возврат ?(Конец = 0, Неопределено, Лев(Остаток, Конец - 1));

КонецФункции

// Первый сегмент полного адреса точки: префикс контроллера занимает его наравне
// с маршрутом. Пусто — корень либо параметр {…}: резервировать нечего.
Функция ПервыйСегмент(Знач Адрес, Знач Точка)

	Полный = СтрЗаменить(Строка(Адрес) + "/" + Строка(Точка), "\", "/");
	Части = СтрРазделить(Полный, "/", Ложь);
	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Первый = НРег(СокрЛП(Части[0]));
	Возврат ?(СтрНайти(Первый, "{") > 0, "", Первый);

КонецФункции

Функция КореньПроекта()
	Возврат Новый Файл(ОбъединитьПути(
		Новый Файл(ТекущийСценарий().Источник).Путь, "..")).ПолноеИмя;
КонецФункции

Функция ПрочитатьИсходник(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);
КонецФункции

#КонецОбласти

Функция Правила()
	Возврат Новый ПравилаИменования();
КонецФункции

Процедура ПодключитьКлассыРеестра()

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассов = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"),
		ОбъединитьПути("реестр", "Классы"));

	ПоискКлассов.ПодключитьВсе(КаталогКлассов);

КонецПроцедуры
