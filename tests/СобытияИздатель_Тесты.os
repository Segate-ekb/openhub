// Юнит-тесты ИздателяСобытий: доставка подписчикам, изоляция падения одного подписчика,
// полезная нагрузка, no-op без подписчиков. Классы инстанцируются напрямую, без контейнера.

#Использовать asserts

Перем КаталогКлассов;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассов = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"), "события", "Классы");

	ПодключитьКласс(ОбъединитьПути(КаталогКлассов, "ИздательСобытий.os"), "ИздательСобытий");
	ПодключитьКласс(ОбъединитьПути(КаталогТестов, "фикстуры", "ФейкПодписчик.os"), "ФейкПодписчик");

КонецПроцедуры

&Тест
Процедура СобытиеДоходитДоПодписчика() Экспорт

	Издатель = Новый ИздательСобытий();
	Подписчик = Новый ФейкПодписчик();
	Издатель.Подписать("тест.событие", Подписчик);

	Издатель.Опубликовать("тест.событие", Новый Структура("Ключ", "значение"));

	Ожидаем.Что(Подписчик.Количество(), "подписчик получил ровно одно событие").Равно(1);
	Ожидаем.Что(Подписчик.Последнее().Тип, "тип события").Равно("тест.событие");
	Ожидаем.Что(Подписчик.Последнее().Данные.Ключ, "полезная нагрузка доставлена").Равно("значение");

КонецПроцедуры

&Тест
Процедура ПадениеПодписчикаНеРоняетДругихИИздателя() Экспорт

	Издатель = Новый ИздательСобытий();
	Падающий = Новый ФейкПодписчик(Истина);   // выбрасывает исключение при обработке
	Здоровый = Новый ФейкПодписчик();

	// падающий подписан ПЕРВЫМ — проверяем, что его сбой не мешает второму
	Издатель.Подписать("мутация", Падающий);
	Издатель.Подписать("мутация", Здоровый);

	// Опубликовать НЕ должен выбросить исключение наружу (иначе бы упал HTTP-путь)
	Издатель.Опубликовать("мутация", Новый Структура("X", 1));

	Ожидаем.Что(Здоровый.Количество(), "здоровый подписчик получил событие несмотря на падение соседа").Равно(1);

КонецПроцедуры

&Тест
Процедура НесколькоПодписчиковОдногоТипа() Экспорт

	Издатель = Новый ИздательСобытий();
	А = Новый ФейкПодписчик();
	Б = Новый ФейкПодписчик();
	Издатель.Подписать("t", А);
	Издатель.Подписать("t", Б);

	Издатель.Опубликовать("t");

	Ожидаем.Что(Издатель.КоличествоПодписчиков("t"), "два подписчика типа").Равно(2);
	Ожидаем.Что(А.Количество(), "первый получил").Равно(1);
	Ожидаем.Что(Б.Количество(), "второй получил").Равно(1);

КонецПроцедуры

&Тест
Процедура ПодписчикПолучаетТолькоСвойТип() Экспорт

	Издатель = Новый ИздательСобытий();
	Подписчик = Новый ФейкПодписчик();
	Издатель.Подписать("тип.А", Подписчик);

	Издатель.Опубликовать("тип.Б", Новый Структура("X", 1)); // другой тип

	Ожидаем.Что(Подписчик.Количество(), "событие чужого типа не доставлено").Равно(0);

КонецПроцедуры

&Тест
Процедура ПубликацияБезПодписчиковБезошибочна() Экспорт

	Издатель = Новый ИздательСобытий();
	// не должно быть исключения при отсутствии подписчиков
	Издатель.Опубликовать("никто.не.слушает", Новый Структура("X", 1));

	Ожидаем.Что(Издатель.КоличествоПодписчиков("никто.не.слушает"), "подписчиков нет").Равно(0);

КонецПроцедуры

&Тест
Процедура МоментСобытияПоУмолчаниюЗаполнен() Экспорт

	Издатель = Новый ИздательСобытий();
	Подписчик = Новый ФейкПодписчик();
	Издатель.Подписать("t", Подписчик);

	Издатель.Опубликовать("t");

	Ожидаем.Что(ЗначениеЗаполнено(Подписчик.Последнее().Когда), "момент события проставлен по умолчанию").ЭтоИстина();

КонецПроцедуры

// --- служебные ---

Процедура ПодключитьКласс(Знач Путь, Знач Имя)
	Если НЕ ТипЗарегистрирован(Имя) Тогда
		ПодключитьСценарий(Путь, Имя);
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции
