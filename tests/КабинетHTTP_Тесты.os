&Тест
Процедура УправлениеКаналамиПакетаЧерезКабинет() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/tags";

	Стр = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Стр, "Теги пакета") > 0, "секция тегов на странице").ЭтоИстина();
	Токен = ИзвлечьCSRF(Стр);

	// создание тега-правила: вид и выражение — два поля формы, а не три
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "сохранить");
	Поля.Вставить("имя", "myband");
	Поля.Вставить("вид", "semver");
	Поля.Вставить("правило", "^1.0");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)), "тег создан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "myband") > 0, "тег в списке").ЭтоИстина();

	// некорректный regex → страница с ошибкой валидации (PRG НЕ выполнен: успех был бы 302)
	Плохо = Новый Соответствие();
	Плохо.Вставить("_csrf", Токен);
	Плохо.Вставить("операция", "сохранить");
	Плохо.Вставить("имя", "badrx");
	Плохо.Вставить("вид", "regex");
	Плохо.Вставить("правило", "([");
	ОтветПлохо = Клиент.POSTФормы(Страница, Плохо, Кука);
	// 5.B: непринятый ввод отдаётся с 400 — «не сохранилось» под кодом 200 врало бы
	// и клиенту, и кэшу (ревью М-8). PRG при этом по-прежнему НЕ выполняется.
	Ожидаем.Что(ОтветПлохо.КодСостояния, "невалидный тег не редиректит, а показывает страницу с 400").Равно(400);
	// невалидный тег не создан
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "badrx"), "невалидный тег не сохранён").Равно(0);

	// удаление тега
	ПоляУд = Новый Соответствие();
	ПоляУд.Вставить("_csrf", Токен);
	ПоляУд.Вставить("операция", "удалить");
	ПоляУд.Вставить("имя", "myband");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, ПоляУд, Кука)), "тег удалён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "myband"), "тег исчез из таблицы").Равно(0);

КонецПроцедуры

// Запрет повторной публикации переключается формой в обе стороны, а поля формы берутся
// с живой страницы — так их отправит браузер. Умолчавший о тумблере запрос защиту НЕ
// снимает: снятие говорится явным «0», иначе чужой номер стал бы переписываемым молча.
&Тест
Процедура ТумблерЗапретаПовторнойПубликацииРаботаетВОбеСтороны() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/tags";

	// тег-правило, а не ручной: он не попадает в список ручных тегов соседних экранов,
	// и упавший на полпути тест не мешает соседям
	ЗавестиТегПравила(Кука, "guarded", "^9.9", "", "");
	Правка = Тело(Клиент.GETСКукой(Страница + "?tag=guarded", Кука));
	Ожидаем.Что(СтрНайти(Правка, "Запрет повторной публикации") > 0,
		"тумблер запрета есть в конструкторе").ЭтоИстина();

	Поля = ПоляКонструктораСо(Правка);
	Ожидаем.Что(Поля.Получить("запрет_перезаписи"),
		"у нового тега тумблер включён").Равно("1");
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "переиздание разрешено"),
		"и в таблице канал ничем не помечен").Равно(0);

	// выключенный тумблер приезжает нулём — это и есть снятие
	Поля.Вставить("запрет_перезаписи", "0");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)), "тег сохранён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "переиздание разрешено") > 0,
		"снятый запрет отмечен в строке тега").ЭтоИстина();

	// запрос БЕЗ поля запрет не снимает и не оставляет снятым — он о нём просто не говорил
	БезПоля = ПоляКонструктораСо(Тело(Клиент.GETСКукой(Страница + "?tag=guarded", Кука)));
	БезПоля.Удалить("запрет_перезаписи");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, БезПоля, Кука)), "тег сохранён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "переиздание разрешено"),
		"умолчавший запрос вернул защиту, а не снял её").Равно(0);

	// и обратно тумблером: включённый возвращает запрет
	Включённый = ПоляКонструктораСо(Тело(Клиент.GETСКукой(Страница + "?tag=guarded", Кука)));
	Ожидаем.Что(Включённый.Получить("запрет_перезаписи"),
		"форма показывает вернувшийся запрет").Равно("1");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Включённый, Кука)), "тег сохранён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "переиздание разрешено"),
		"запрет на месте").Равно(0);

	ПоляУд = Новый Соответствие();
	ПоляУд.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука))));
	ПоляУд.Вставить("операция", "удалить");
	ПоляУд.Вставить("имя", "guarded");
	Клиент.POSTФормы(Страница, ПоляУд, Кука);

КонецПроцедуры

&Тест
Процедура ФормаТегаПоказываетПоляТолькоСвоегоТипа() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	База = "/public/alice-pkg/settings/tags";

	// Наборы полей правила напечатаны ОБА, включён ровно набор выбранного вида: невыбранный
	// уезжает под `disabled hidden`, поэтому браузер его не отправляет, а скрипт умеет
	// переключить набор мгновенно — тот же паттерн, что у наборов полей провайдера входа.
	Semver = Тело(Клиент.GETСКукой(База, Кука));
	Ожидаем.Что(СтрНайти(Semver, "Конструктор тега") > 0, "конструктор на странице").ЭтоИстина();
	// секция ОДНА: сохранение — её собственная кнопка, отдельной карточки-шага нет
	Ожидаем.Что(СтрНайти(Semver, "Сохранение тега"), "отдельной секции сохранения нет").Равно(0);
	Ожидаем.Что(СтрНайти(Semver, "name=""операция"" value=""сохранить""") > 0,
		"кнопка сохранения — в самой секции конструктора").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Semver, "data-sets=""вид""") > 0,
		"списку вида объявлены наборы полей").ЭтоИстина();
	Ожидаем.Что(НаборВключён(Semver, "semver"), "вид semver: набор диапазона включён").ЭтоИстина();
	Ожидаем.Что(НаборВключён(Semver, "regex"), "вид semver: набор regex отключён").ЭтоЛожь();
	Ожидаем.Что(ПоляФормыСо(Semver, "name=""вид""").Получить("правило"),
		"браузер отправит диапазон включённого набора").Равно("");

	// поля упразднённых режимов не печатаются вовсе
	Ожидаем.Что(СтрНайти(Semver, "name=""метка"""), "поля метки в форме нет").Равно(0);
	Ожидаем.Что(СтрНайти(Semver, "name=""версия"""), "поля версии в форме тега нет").Равно(0);
	Ожидаем.Что(СтрНайти(Semver, "пин"), "режима «пин» в форме нет").Равно(0);

	Regex = Тело(Клиент.GETСКукой(База + "?kind=regex", Кука));
	Ожидаем.Что(НаборВключён(Regex, "regex"), "вид regex: набор выражения включён").ЭтоИстина();
	Ожидаем.Что(НаборВключён(Regex, "semver"), "вид regex: набор semver отключён").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Regex, "якорится") > 0,
		"вид regex: предупреждение о footgun незаякоренного regex").ЭтоИстина();

	// у ручного тега не включён ни один набор — отбирать версии ему нечем
	Ручной = Тело(Клиент.GETСКукой(База + "?kind=manual", Кука));
	Ожидаем.Что(НаборВключён(Ручной, "semver"), "вид ручной: набор semver отключён").ЭтоЛожь();
	Ожидаем.Что(НаборВключён(Ручной, "regex"), "вид ручной: набор regex отключён").ЭтоЛожь();
	Ожидаем.Что(ПоляФормыСо(Ручной, "name=""вид""").Получить("правило"),
		"у ручного тега правило не отправляется вовсе").Равно(Неопределено);

КонецПроцедуры

// Проверка правила — вторичная кнопка ТОЙ ЖЕ формы: она читает и ничего не пишет,
// а пишет только основная «Сохранить тег». Отдельного шага-карточки между ними нет.
&Тест
Процедура ПроверкаПравилаПоказываетВерсииИНеПишет() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/tags";

	Разметка = Тело(Клиент.GETСКукой(Страница, Кука));
	// операцию называет НАЖАТАЯ кнопка: скрытым полем она не едет вовсе
	Поля = ПоляФормыСо(Разметка, "name=""правило""");
	Ожидаем.Что(Поля.Получить("операция"), "скрытого поля операции в форме нет").Равно(Неопределено);
	Ожидаем.Что(СтрНайти(Разметка, "name=""операция"" value=""проверить""") > 0,
		"проверка правила — кнопка той же формы").ЭтоИстина();

	// заполняем видимые поля так, как это сделал бы человек, и жмём «Проверить правило»
	Поля.Вставить("операция", "проверить");
	Поля.Вставить("имя", "preview-tag");
	Поля.Вставить("правило", "^1.0");

	Ответ = Клиент.POSTФормы(Страница, Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "проверка отдаёт страницу, а не редирект").Равно(200);

	Стр = Тело(Ответ);
	Ожидаем.Что(СтрНайти(Стр, "Под правило попадут") > 0, "список совпадений показан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "Тег будет отдавать версию") > 0,
		"названа версия, которую отдаст тег").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "1.0.0") > 0, "версия 1.0.0 в составе канала").ЭтоИстина();
	// введённое сохранено в форме: иначе проверка стирала бы работу автора
	Ожидаем.Что(СтрНайти(Стр, "preview-tag") > 0, "имя тега сохранено в форме").ЭтоИстина();

	// НИЧЕГО НЕ СОЗДАНО: проверка — чтение
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "preview-tag"),
		"проверка тег не создала").Равно(0);

	// ...и пишет ТА ЖЕ форма, но нажатием основной кнопки
	Поля.Вставить("операция", "сохранить");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)),
		"основная кнопка той же формы пишет тег").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "preview-tag") > 0,
		"тег создан ИМЕННО сохранением").ЭтоИстина();

	УдалитьТег(Кука, "preview-tag");

	// негатив: мусорное правило не роняет страницу, а печатает ошибку в конструкторе
	Мусор = ПоляФормыСо(Тело(Клиент.GETСКукой(Страница, Кука)), "name=""правило""");
	Мусор.Вставить("операция", "проверить");
	Мусор.Вставить("имя", "junk-tag");
	Мусор.Вставить("правило", "не-диапазон");
	ОтветМусор = Клиент.POSTФормы(Страница, Мусор, Кука);
	Ожидаем.Что(ОтветМусор.КодСостояния, "мусор в проверке — 200 с текстом ошибки").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(ОтветМусор), "Правило не применено") > 0,
		"причина отказа названа в конструкторе").ЭтоИстина();

КонецПроцедуры

// Проверка правила — вторичное действие, а не обязательный шаг: у ручного тега её нет
// вовсе (отбирать нечем), у тега-правила она стоит в дереве ПЕРЕД сохранением, поэтому
// неявная отправка по Enter попадает в проверку, а не пишет тег молча.
&Тест
Процедура КнопкаПроверкиПравилаЕстьТолькоУТегаПравила() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	База = "/public/alice-pkg/settings/tags";

	Для Каждого Вид Из СтрРазделить("semver,regex", ",") Цикл
		Разметка = Тело(Клиент.GETСКукой(База + "?kind=" + Вид, Кука));
		Ожидаем.Что(СтрНайти(Разметка, "name=""операция"" value=""проверить""") > 0,
			"вид «" + Вид + "»: проверка правила предложена").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Разметка, "Проверить правило") > 0,
			"вид «" + Вид + "»: кнопка названа по делу, а не «предпросмотром»").ЭтоИстина();
		// Enter отдаёт форму ПЕРВОЙ кнопке отправки в дереве: важен и порядок, и то, что
		// проверка вообще отправляет форму — type="button" молча вернул бы Enter сохранению
		Проверка = ТегКнопкиСо(Разметка, "value=""проверить""");
		Ожидаем.Что(СтрНайти(Проверка, "type=""submit""") > 0,
			"вид «" + Вид + "»: проверка отправляет форму: " + Проверка).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Разметка, "value=""проверить""") < СтрНайти(Разметка, "value=""сохранить"""),
			"вид «" + Вид + "»: Enter попадает в проверку, а не в сохранение").ЭтоИстина();
	КонецЦикла;

	Ручной = Тело(Клиент.GETСКукой(База + "?kind=manual", Кука));
	Ожидаем.Что(СтрНайти(Ручной, "value=""проверить"""),
		"у ручного тега правила нет — и кнопки проверки тоже").Равно(0);
	Ожидаем.Что(СтрНайти(Ручной, "Проверить правило"), "и подписи её нет").Равно(0);
	Ожидаем.Что(СтрНайти(Ручной, "name=""операция"" value=""сохранить""") > 0,
		"сохранение есть у обоих видов").ЭтоИстина();
	// лид секции не обещает шага, которого нет
	Ожидаем.Что(СтрНайти(Ручной, "предпросмотр"), "лид не обещает отдельного шага").Равно(0);

КонецПроцедуры

// Имя тега и номер версии в одном пакете не пересекаются: запись «пакет@1.1.0» читается сначала
// как точная версия, и одноимённый тег был бы недостижим. Форма судит имя САМА — иначе домен
// бросил бы исключение и мейнтейнер увидел бы пятисотку вместо объяснения.
&Тест
Процедура ФормаТегаНеБерётИмяЗанятоеВерсией() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/tags";

	Поля = ПоляФормыСо(Тело(Клиент.GETСКукой(Страница, Кука)), "name=""правило""");
	Поля.Вставить("операция", "сохранить");
	Поля.Вставить("имя", "1.1.0");
	Поля.Вставить("правило", "^1.0");

	Ответ = Клиент.POSTФормы(Страница, Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "имя, занятое версией, — отказ от записи").Равно(400);
	// имя судит САМА форма: иначе отказ приходит текстом исключения домена, а конструктор
	// теряет набранное — сравнивается поэтому формулировка формы, а не общее «занято версией»
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Имя тега занято версией пакета") > 0,
		"причина названа формой, а не пересказом исключения домена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "1.1.0</"),
		"тега с именем версии в разделе не появилось").Равно(0);

	// проверка правила — вопрос, а не запись: занятое имя называется ДО того, как жать «сохранить»
	Вопрос = ПоляФормыСо(Тело(Клиент.GETСКукой(Страница, Кука)), "name=""правило""");
	Вопрос.Вставить("операция", "проверить");
	Вопрос.Вставить("имя", "1.1.0");
	Вопрос.Вставить("правило", "^1.0");
	ОтветВопроса = Клиент.POSTФормы(Страница, Вопрос, Кука);
	Ожидаем.Что(ОтветВопроса.КодСостояния, "проверка — ответ на вопрос (200)").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(ОтветВопроса), "Имя тега занято версией пакета") > 0,
		"проверка называет занятое имя, а не показывает состав будущего канала").ЭтоИстина();

	// КОНТРОЛЬ: «1.9» выглядит версией, но версии с такой строкой у пакета нет — имя свободно
	Свободные = ПоляФормыСо(Тело(Клиент.GETСКукой(Страница, Кука)), "name=""правило""");
	Свободные.Вставить("операция", "сохранить");
	Свободные.Вставить("имя", "1.9");
	Свободные.Вставить("правило", "^1.0");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Свободные, Кука)),
		"имя, не занятое версией, сохраняется").ЭтоИстина();

	УдалитьТег(Кука, "1.9");

КонецПроцедуры

// Операцию называет нажатая кнопка. Форма, пришедшая без неё, — не «сохранить
// по умолчанию»: тег, записанный молча, никто не просил.
&Тест
Процедура ФормаТегаБезОперацииДаётПонятныйОтказ() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/tags";

	Поля = ПоляФормыСо(Тело(Клиент.GETСКукой(Страница, Кука)), "name=""правило""");
	Поля.Вставить("имя", "nooptag");
	Поля.Вставить("правило", "^1.0");

	Ответ = Клиент.POSTФормы(Страница, Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "форма без операции отбита").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Неизвестная операция раздела") > 0,
		"причина отказа названа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "nooptag"),
		"молча ничего не сохранилось").Равно(0);

	// незнакомая операция не должна попадать в чужую ветку
	Чужая = ПоляФормыСо(Тело(Клиент.GETСКукой(Страница, Кука)), "name=""правило""");
	Чужая.Вставить("операция", "стереть");
	Чужая.Вставить("имя", "nooptag");
	Чужая.Вставить("правило", "^1.0");
	Ожидаем.Что(Клиент.POSTФормы(Страница, Чужая, Кука).КодСостояния,
		"незнакомая операция отбита").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "nooptag"),
		"и ничего не создала").Равно(0);

КонецПроцедуры

// Кто правило не проверял, узнаёт его состав ПОСЛЕ записи: тег, который молча не отдаёт
// ничего, — самая дорогая ошибка этого экрана.
&Тест
Процедура ПослеСохраненияПравилаВидноКакиеВерсииПопали() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/tags";

	Поля = ПоляФормыСо(Тело(Клиент.GETСКукой(Страница, Кука)), "name=""правило""");
	Поля.Вставить("операция", "сохранить");
	Поля.Вставить("имя", "shownrule");
	Поля.Вставить("правило", "^1.0");
	Ответ = Клиент.POSTФормы(Страница, Поля, Кука);
	Ожидаем.Что(УспехМутации(Ответ), "тег-правило сохранён одним нажатием").ЭтоИстина();

	Разметка = ПослеЗаписи(Ответ, Кука);
	Ожидаем.Что(СтрНайти(Разметка, "Под правило тега shownrule попали версии") > 0,
		"состав канала показан и без нажатия проверки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "1.0.0") > 0, "названа попавшая версия").ЭтоИстина();

	// правило, не поймавшее ни одной версии, — предупреждением: такой тег не отдаёт ничего
	Пустое = ПоляФормыСо(Тело(Клиент.GETСКукой(Страница, Кука)), "name=""правило""");
	Пустое.Вставить("операция", "сохранить");
	Пустое.Вставить("имя", "hollowrule");
	Пустое.Вставить("правило", "^99.0");
	ОтветПустого = Клиент.POSTФормы(Страница, Пустое, Кука);
	Ожидаем.Что(УспехМутации(ОтветПустого), "тег с пустым каналом всё равно сохраняется").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПослеЗаписи(ОтветПустого, Кука),
		"Под правило тега hollowrule не попала ни одна") > 0,
		"о пустом канале сказано прямо").ЭтоИстина();

	// у ручного тега правила нет — и состава канала после записи тоже
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница + "?kind=manual", Кука)));
	ОтветРучного = Клиент.POSTФормы(Страница,
		ПоляКонструктора(Токен, "manual", "сохранить", "quietman", "plain", ""), Кука);
	Ожидаем.Что(СтрНайти(ПослеЗаписи(ОтветРучного, Кука), "попали версии"),
		"ручному тегу нечего отбирать — и уведомления о составе нет").Равно(0);

	УдалитьТег(Кука, "shownrule");
	УдалитьТег(Кука, "hollowrule");
	УдалитьТег(Кука, "quietman");

КонецПроцедуры

// Отозванная версия в канал ПОПАДАЕТ, но установка её не выбирает. Канал из одних
// отозванных не отдаёт ничего — и обязан читаться как предупреждение, иначе бодрое
// «попали версии» говорит ровно обратное правде.
&Тест
Процедура ОтозванныеВСоставеКаналаНазваныОтдельно() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/tags";

	// состояние отзывов задаём САМИ: иначе тест читает то, что оставили соседи по набору
	ОтозватьВерсию(Кука, "1.0.0", "unyank");
	ОтозватьВерсию(Кука, "1.1.0", "yank");

	// часть попавших отозвана: успех, но отозванные названы ОТДЕЛЬНО, а не в общем списке
	Смешанное = ПоляФормыСо(Тело(Клиент.GETСКукой(Страница, Кука)), "name=""правило""");
	Смешанное.Вставить("операция", "сохранить");
	Смешанное.Вставить("имя", "mixedrule");
	Смешанное.Вставить("правило", "^1.0");
	Разметка = ПослеЗаписи(Клиент.POSTФормы(Страница, Смешанное, Кука), Кука);

	Смешанный = ТекстТостаСо(Разметка, "Под правило тега mixedrule");
	Ожидаем.Что(СтрНайти(Смешанный, "1.0.0") > 0,
		"отдаваемая версия названа: " + Смешанный).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Смешанный, "Отозванные тоже попали (1.1.0)") > 0,
		"отозванная названа отдельно: " + Смешанный).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ДоПодстроки(Смешанный, "Отозванные"), "1.1.0"),
		"отозванной нет среди отдаваемых: " + Смешанный).Равно(0);
	Ожидаем.Что(ВидТостаСо(Разметка, "Под правило тега mixedrule"),
		"канал с отдаваемой версией — успех").Равно("ok");

	// попали ТОЛЬКО отозванные: тег не отдаёт ничего — это предупреждение, а не успех
	Одни = ПоляФормыСо(Тело(Клиент.GETСКукой(Страница + "?kind=regex", Кука)), "name=""правило""");
	Одни.Вставить("операция", "сохранить");
	Одни.Вставить("имя", "onlyyanked");
	Одни.Вставить("правило", "^1\.1\.0$");
	Итог = ПослеЗаписи(Клиент.POSTФормы(Страница, Одни, Кука), Кука);

	Только = ТекстТостаСо(Итог, "Под правило тега onlyyanked");
	Ожидаем.Что(СтрНайти(Только, "попали только отозванные версии (1.1.0)") > 0,
		"канал из одних отозванных назван прямо: " + Только).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Только, "тег не отдаст ничего") > 0,
		"и сказано, что тег не отдаёт ничего: " + Только).ЭтоИстина();
	Ожидаем.Что(ВидТостаСо(Итог, "Под правило тега onlyyanked"),
		"такой канал показан предупреждением, а не успехом").Равно("warn");

	УдалитьТег(Кука, "mixedrule");
	УдалитьТег(Кука, "onlyyanked");

КонецПроцедуры

&Тест
Процедура ФормыДомаНеВложеныДругВДруга() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");

	Адреса = Новый Массив();
	Адреса.Добавить("/public/alice-pkg/settings/tags");
	Адреса.Добавить("/public/alice-pkg/settings/versions");
	Адреса.Добавить("/public/alice-pkg/settings/card");
	Адреса.Добавить("/public/alice-pkg/settings/danger");

	Для Каждого Адрес Из Адреса Цикл
		Ожидаем.Что(ГлубинаВложенностиФорм(Тело(Клиент.GETСКукой(Адрес, Кука))),
			"максимальная вложенность <form> на " + Адрес).Равно(1);
	КонецЦикла;

	// опасная зона пула — тоже отдельной куки: форму удаления видит только носитель права
	// уровня хаба. Зона живёт ВНУТРИ формы секции и своей не печатает, поэтому проверяются
	// обе стороны: вложенности нет, и поле подтверждения лежит в форме — вне формы браузер
	// его не отправит, и кнопка удаления не сделает ничего.
	КукаХаба = Клиент.Войти("root", "RootPassw0rd");
	АдресЗоны = "/owned/settings/danger";
	ЗонаПула = Тело(Клиент.GETСКукой(АдресЗоны, КукаХаба));
	Ожидаем.Что(ГлубинаВложенностиФорм(ЗонаПула),
		"максимальная вложенность <form> на " + АдресЗоны).Равно(1);

	ПоляЗоны = ПоляФормыСо(ЗонаПула, "name=""подтверждение""");
	Ожидаем.Что(ПоляЗоны.Получить("операция"),
		"форма опасной зоны объявляет операцию").Равно("пул-удалить");
	Ожидаем.Что(ЗначениеЗаполнено(ПоляЗоны.Получить("_csrf")),
		"и несёт CSRF-токен").ЭтоИстина();

	// раздел доверия — отдельной куки: его порог выше домового, и обе вкладки разные
	// по набору полей (раскрывашка «дополнительно», чипсы-ссылки)
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Доверие_ = Новый Массив();
	Доверие_.Добавить("/public/alice-pkg/settings/ci");
	Доверие_.Добавить("/public/alice-pkg/settings/ci?ci=gitlab");
	Для Каждого Адрес Из Доверие_ Цикл
		Разметка = Тело(Клиент.GETСКукой(Адрес, КукаАдмина));
		Ожидаем.Что(СтрНайти(Разметка, "name=""репозиторий""") > 0,
			"страница доверия отдана: " + Адрес).ЭтоИстина();
		Ожидаем.Что(ГлубинаВложенностиФорм(Разметка),
			"максимальная вложенность <form> на " + Адрес).Равно(1);
	КонецЦикла;

	// и на странице ПОСЛЕ проверки правила — там у конструктора две кнопки в одной форме
	Страница = "/public/alice-pkg/settings/tags";
	Поля = ПоляФормыСо(Тело(Клиент.GETСКукой(Страница, Кука)), "name=""правило""");
	Поля.Вставить("операция", "проверить");
	Поля.Вставить("имя", "nest-probe");
	Поля.Вставить("правило", "*");
	Ожидаем.Что(ГлубинаВложенностиФорм(Тело(Клиент.POSTФормы(Страница, Поля, Кука))),
		"после проверки правила формы тоже не вложены").Равно(1);

КонецПроцедуры

// Обязательное поле под ЗАКРЫТОЙ раскрывашкой внутри формы браузер не отдаёт вовсе:
// фокус на скрытый контрол он поставить не может («An invalid form control is not
// focusable»), сабмит молча не происходит, и сервер об этом не узнаёт никогда. Прячут под
// кат внутри формы только необязательное («дополнительно»), а обязательное живёт снаружи.
&Тест
Процедура ОбязательныхПолейПодЗакрытымКатомНет() Экспорт

	СамотестСканераКатов();

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	Страницы = Новый Соответствие();
	Страницы.Вставить("/public/alice-pkg/settings/ci", КукаАдмина);
	Страницы.Вставить("/public/alice-pkg/settings/ci?ci=gitlab", КукаАдмина);
	Страницы.Вставить("/public/alice-pkg/settings/versions", Кука);
	Страницы.Вставить("/hub/settings/pools", КукаАдмина);

	Закрытых = 0;
	Для Каждого Страница Из Страницы Цикл
		Каты = КатыВнутриФорм(Тело(Клиент.GETСКукой(Страница.Ключ, Страница.Значение)));
		Закрытых = Закрытых + Каты.Закрытых;
		Ожидаем.Что(СтрСоединить(Каты.Обязательные, "; "),
			"обязательные поля под закрытым катом на " + Страница.Ключ).Равно("");
		Ожидаем.Что(Каты.Незакрытых, "незакрытые <details> на " + Страница.Ключ).Равно(0);
	КонецЦикла;

	Ожидаем.Что(Закрытых > 0,
		"закрытые каты внутри форм на этих страницах есть — иначе сторож сторожит пустоту")
		.ЭтоИстина();

КонецПроцедуры

// Самотест сканера катов. Текстовый разбор здесь единственная сеть, поэтому образцы
// перечислены поимённо: и те, где сторож ОБЯЗАН ловить (иначе защита снимается молча
// первым же классом со словом open), и те, где обязан молчать (иначе он краснеет на
// корректной разметке — например, на отключённом наборе полей [data-set]).
Процедура СамотестСканераКатов()

	Ловит = Новый Соответствие();
	Ловит.Вставить("простой кат в форме",
		"<form><details><summary>ещё</summary><input name=""а"" required></details></form>");
	Ловит.Вставить("слово open ВНУТРИ значения класса атрибутом не является",
		"<form><details class=""fold open danger""><input name=""а"" required></details></form>");
	Ловит.Вставить("слово open внутри значения data-атрибута — тоже не атрибут",
		"<form><details data-x=""a open b""><input name=""а"" required></details></form>");
	Ловит.Вставить("угловая скобка в значении не обрезает тег и не съедает required",
		"<form><details><input value=""a>b"" required></details></form>");
	Ловит.Вставить("включённый набор полей внутри ката прячет обязательное по-настоящему",
		"<form><details><fieldset data-set=""oidc""><input name=""а"" required></fieldset></details></form>");

	Для Каждого Образец Из Ловит Цикл
		Ожидаем.Что(КатыВнутриФорм(Образец.Значение).Обязательные.Количество(),
			"сканер обязан поймать: " + Образец.Ключ).Равно(1);
	КонецЦикла;

	Молчит = Новый Соответствие();
	Молчит.Вставить("раскрытый кат ничего не прячет",
		"<form><details open><input name=""а"" required></details></form>");
	Молчит.Вставить("кат ВНЕ формы браузеру отправлять нечего",
		"<details><input name=""а"" required></details>");
	Молчит.Вставить("обязательное поле рядом с катом — норма",
		"<form><details><input name=""а""></details><input name=""б"" required></form>");
	Молчит.Вставить("отключённый набор полей браузер не валидирует ([data-set])",
		"<form><details><fieldset class=""choice-set"" data-set=""oidc"" disabled hidden>"
		+ "<input name=""а"" required></fieldset></details></form>");
	Молчит.Вставить("отключённое поле браузер не валидирует и поодиночке",
		"<form><details><input name=""а"" required disabled></details></form>");
	Молчит.Вставить("пробел перед скобкой закрывающего тега закрывает кат",
		"<form><details><input name=""а""></details ><input name=""б"" required></form >");
	Молчит.Вставить("выключённый набор закрылся — соседнее поле снова видно",
		"<form><details><fieldset disabled><input name=""а""></fieldset></details>"
		+ "<input name=""б"" required></form>");

	Для Каждого Образец Из Молчит Цикл
		Ожидаем.Что(СтрСоединить(КатыВнутриФорм(Образец.Значение).Обязательные, "; "),
			"сканер обязан молчать: " + Образец.Ключ).Равно("");
	КонецЦикла;

	// Незакрытый <details> браузер тоже не закрывает: всё до конца родителя уезжает
	// ВНУТРЬ ката, поэтому разбор считает так же. Но это дефект разметки сам по себе,
	// и называется он отдельным числом — иначе красный тест читается как «поле не там».
	Рваная = КатыВнутриФорм("<form><details><input name=""а"" required></form>");
	Ожидаем.Что(Рваная.Незакрытых, "незакрытый кат назван отдельно").Равно(1);
	Ожидаем.Что(Рваная.Обязательные.Количество(),
		"поле под незакрытым катом всё равно спрятано — так его видит и браузер").Равно(1);
	Ожидаем.Что(КатыВнутриФорм(
		"<form><details><input name=""а""></details></form>").Незакрытых,
		"закрытый кат незакрытым не считается").Равно(0);

КонецПроцедуры

&Тест
Процедура ТегВешаетсяВМенюВерсииВыборомИзСпискаРучных() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/versions";

	// пока ручных тегов у пакета нет, меню не показывает сломанной формы, а ведёт в конструктор
	Пусто = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Пусто, "class=""menu""") > 0,
		"у строки версии есть меню действий").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Пусто, "Ручных тегов у пакета нет") > 0,
		"пустой список — подсказка, а не пустой <select>").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Пусто, "тег_добавить"),
		"без ручных тегов вешать нечего — формы добавления нет").Равно(0);

	ЗавестиРучнойТег(Кука, "rowtag", "", "");

	Стр = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Стр, "тег_добавить") > 0, "в меню появилось единственное действие").ЭтоИстина();
	// предпосылка сторожа ПанельМенюУходитВВерхнийСлойАНеРаздвигаетСтроку: панель стоит
	// ВНУТРИ обёртки прокрутки, и обрезал бы её именно этот предок — если бы не верхний слой
	Ожидаем.Что(СтрНайти(МеждуМаркеров(Стр, "<div class=""table-scroll"">", "</table>"),
		"class=""menu__panel""") > 0,
		"панель меню — потомок обёртки прокрутки таблицы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "<option value=""rowtag""") > 0,
		"ручной тег предложен выбором из списка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "<option value=""stable""") ,
		"тег-правило в списке не предлагается").Равно(0);
	Токен = ИзвлечьCSRF(Стр);
	ПредложенийДо = СколькоРаз(Стр, "<option value=""rowtag""");
	Ожидаем.Что(ПредложенийДо > 0, "тег предложен хотя бы одной версии").ЭтоИстина();

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_добавить", "1.0.0", "rowtag"), Кука)),
		"тег повешен из меню").ЭтоИстина();

	После = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(После, "rowtag") > 0, "тег виден в строке версии").ЭтоИстина();
	Ожидаем.Что(СтрНайти(После, "Снять тег rowtag с версии 1.0.0") > 0,
		"у ручного тега есть крестик снятия с внятной подписью").ЭтоИстина();
	// крестик лежит ВНУТРИ плашки: соседним узлом его отрывал бы перенос строки
	Ожидаем.Что(СвязкаТегаСКрестиком(После, "rowtag"),
		"крестик — ребёнок плашки тега, а не сосед").ЭтоИстина();
	// из меню СВОЕЙ версии тег ушёл, у остальных остался: вешать висящее нечестно
	Ожидаем.Что(СколькоРаз(После, "<option value=""rowtag"""),
		"у версии с этим тегом его больше не предлагают").Равно(ПредложенийДо - 1);

	СнятьТегСВерсии(Кука, "rowtag", "1.0.0");
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "Снять тег rowtag"),
		"тега на версии больше нет").Равно(0);

	УдалитьТег(Кука, "rowtag");

КонецПроцедуры

// Снятие тега — ДВА шага: первый POST только перерисовывает страницу с вопросом, второй снимает.
// Вопрос задаёт сервер, поэтому шаг работает и без скрипта: скрипт лишь задаёт тот же
// вопрос диалогом заранее, а серверную сверку подтверждения не отменяет.
&Тест
Процедура СнятиеТегаБезПодтвержденияНеПроходит() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/versions";

	ЗавестиРучнойТег(Кука, "askme", "", "");
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));
	Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_добавить", "1.0.0", "askme"), Кука);

	// шаг 1: крестик отдаёт страницу с вопросом, а не редирект — и ничего не снимает
	Спрос = Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_снять", "1.0.0", "askme"), Кука);
	Ожидаем.Что(Спрос.КодСостояния, "первый POST перерисовывает страницу, а не редиректит").Равно(200);
	Разметка = Тело(Спрос);
	Ожидаем.Что(СтрНайти(Разметка, "Снять тег <code>askme</code> с версии <code>1.0.0</code>?") > 0,
		"вопрос называет и тег, и версию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "name=""подтверждение"" value=""да""") > 0,
		"подтверждение уезжает вторым POST").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "Снять тег askme с версии 1.0.0") > 0,
		"после вопроса тег ВСЁ ЕЩЁ на версии").ЭтоИстина();

	// «Отмена» — обычная ссылка на тот же раздел: возврат на страницу ничего не снимает
	Отмена = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Отмена, "Снять тег askme с версии 1.0.0") > 0,
		"отмена (возврат на раздел) тег не сняла").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отмена, "Снять тег <code>askme</code>"),
		"после отмены вопроса на странице нет").Равно(0);

	// шаг 2: с подтверждением — снимается
	СнятьТегСВерсии(Кука, "askme", "1.0.0");
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "Снять тег askme с версии 1.0.0"),
		"подтверждённое снятие сработало").Равно(0);

	УдалитьТег(Кука, "askme");

КонецПроцедуры

// Крестик снятия объявляет вопрос ДАННЫМИ, но подтверждения в разметку не кладёт:
// без скрипта форма уходит без него, и сервер задаёт вопрос сам. Серверная сверка
// подтверждения от этого не ослабевает — она же и держит защиту от подделки запроса.
&Тест
Процедура КрестикСнятияНесётВопросНоНеПодтверждениеИРаботаетБезJS() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/versions";

	ЗавестиРучнойТег(Кука, "askjs", "", "");
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));
	Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_добавить", "1.0.0", "askjs"), Кука);

	БезСкриптов = БезТеговScript(Тело(Клиент.GETСКукой(Страница, Кука)));
	Ожидаем.Что(СтрНайти(БезСкриптов, "<script"), "скриптов не осталось").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "onclick="), "инлайновых обработчиков нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "onsubmit="), "и обработчиков отправки тоже").Равно(0);

	Форма = ФормаСо(БезСкриптов, "data-confirm");
	Ожидаем.Что(СтрНайти(Форма, "data-confirm-field=""подтверждение""") > 0,
		"форма называет поле подтверждения данными: " + Лев(Форма, 400)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Форма, "data-confirm-value=""да""") > 0,
		"и значение, которого ждёт сервер").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Форма, "Снять тег «askjs» с версии «1.0.0»?") > 0,
		"вопрос называет и тег, и версию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Форма, "name=""подтверждение"""),
		"САМОГО подтверждения в разметке НЕТ — иначе первый же клик снимал бы тег молча").Равно(0);
	Ожидаем.Что(СтрНайти(Форма, "type=""submit""") > 0,
		"крестик — обычная кнопка отправки формы").ЭтоИстина();

	// путь без скрипта: отправляем ровно то, что напечатано, — сервер СПРАШИВАЕТ
	Поля = ПоляФормыСо(БезСкриптов, "data-confirm");
	Спрос = Клиент.POSTФормы(Страница, Поля, Кука);
	Ожидаем.Что(Спрос.КодСостояния, "форма из разметки перерисовывает страницу с вопросом").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Спрос), "name=""подтверждение"" value=""да""") > 0,
		"и только там появляется поле подтверждения").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "Снять тег askjs с версии 1.0.0") > 0,
		"тег на версии остался").ЭтоИстина();

	// путь со скриптом: он добавляет то же поле сам — сервер принимает
	Поля.Вставить("подтверждение", "да");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)),
		"с подтверждением снятие проходит одним запросом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "Снять тег askjs с версии 1.0.0"),
		"тег снят").Равно(0);

	// и мимо значения не проходит: сверка на сервере, а не в диалоге
	Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_добавить", "1.0.0", "askjs"), Кука);
	Кривое = ПоляМеню(Токен, "тег_снять", "1.0.0", "askjs");
	Кривое.Вставить("подтверждение", "ага");
	Ожидаем.Что(Клиент.POSTФормы(Страница, Кривое, Кука).КодСостояния,
		"чужое значение подтверждения не снимает, а спрашивает").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "Снять тег askjs с версии 1.0.0") > 0,
		"тег на месте").ЭтоИстина();

	СнятьТегСВерсии(Кука, "askjs", "1.0.0");
	УдалитьТег(Кука, "askjs");

КонецПроцедуры

// Конструктор тега объявляет скрипту, по каким полям перерисовывать плашку, и остаётся
// полностью работоспособным без него: ту же плашку печатает сервер в любой перерисовке.
&Тест
Процедура КонструкторТегаОбъявляетКонтрактПлашкиИЖивётБезJS() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/tags";
	БезСкриптов = БезТеговScript(Тело(Клиент.GETСКукой(Страница + "?kind=manual", Кука)));

	Ожидаем.Что(СтрНайти(БезСкриптов, "<script"), "скриптов не осталось").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "oninput="), "инлайновых обработчиков нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(БезСкриптов), "onchange="), "и обработчиков изменения тоже").Равно(0);

	Студия = МеждуМаркеров(БезСкриптов, "<div class=""studio""", ">");
	Ожидаем.Что(СтрНайти(Студия, "data-chip-name=""имя""") > 0,
		"контракт называет поле имени: " + Студия).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Студия, "data-chip-style=""стиль""") > 0, "контракт называет стиль").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Студия, "data-chip-icon=""значок""") > 0, "и значок").ЭтоИстина();

	// имена контракта — это НАСТОЯЩИЕ поля формы, а не отдельный словарь скрипта
	Для Каждого Имя Из СтрРазделить("имя,стиль,значок", ",") Цикл
		Ожидаем.Что(СтрНайти(БезСкриптов, "name=""" + Имя + """") > 0,
			"поле «" + Имя + "» есть в форме").ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(СтрНайти(БезСкриптов, "name=""вид""") > 0, "и поле вида тега").ЭтоИстина();

	// соответствие «ключ стиля — класс» объявлено на самих вариантах выбора: скрипт не
	// заводит вторую копию этого знания, а сервер печатает ровно тот же класс
	Ожидаем.Что(СтрНайти(БезСкриптов, "<option value=""stable"" data-chip-view=""ok""") > 0,
		"вид плашки объявлен на варианте стиля").ЭтоИстина();

	// без скрипта плашка всё равно нарисована сервером — в любой перерисовке страницы
	Ожидаем.Что(СтрНайти(БезСкриптов, "<span data-chip-target=""""><span class=""tag") > 0,
		"плашка напечатана сервером, а не создаётся скриптом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "name=""операция"" value=""сохранить""") > 0,
		"сохранение — обычная кнопка формы: это и есть путь без скрипта").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСкриптов, "value=""проверить"""),
		"у ручного тега кнопки проверки нет вовсе").Равно(0);

	Токен = ИзвлечьCSRF(БезСкриптов);
	Запись = Клиент.POSTФормы(Страница,
		ПоляКонструктора(Токен, "manual", "сохранить", "nojstag", "stable", "lock"), Кука);
	Ожидаем.Что(УспехМутации(Запись), "ручной тег заведён без единого скрипта").ЭтоИстина();
	Разметка = Тело(Клиент.GETСКукой(Страница + "?tag=nojstag", Кука));
	Ожидаем.Что(СтрНайти(Разметка, "<span data-chip-target=""""><span class=""tag tag--ok"">") > 0,
		"плашка перерисована сервером в выбранном стиле").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "<span data-chip-caption="""">nojstag</span>") > 0,
		"подпись — отдельным узлом, его и обновляет скрипт").ЭтоИстина();
	// глифы напечатаны ВСЕ, показан выбранный: синтезировать svg кита в браузере нечем
	Ожидаем.Что(СтрНайти(Разметка, "data-chip-glyph=""lock""><svg") > 0,
		"выбранный глиф виден").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "data-chip-glyph=""check"" hidden>") > 0,
		"невыбранные глифы напечатаны и скрыты").ЭтоИстина();
	// проверяем ИМЕННО плашку, а не всю страницу: инлайновый блок токенов темы законен
	Плашка = МеждуМаркеров(Разметка, "<span data-chip-target="""">", "</div>");
	Ожидаем.Что(СтрНайти(Плашка, "style="),
		"инлайнового стиля у плашки нет: цвет живёт в теме — " + Плашка).Равно(0);

КонецПроцедуры

// Существующий тег ПРАВИТСЯ тем же конструктором: имя — адрес установки «пакет@тег»,
// поэтому оно не меняется, а режим, правило и оформление меняются. Базовые теги, заведённые
// автоматически, правятся так же — отдельного пути у них нет.
&Тест
Процедура СуществующийТегПравитсяКонструктором() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/tags";

	ЗавестиТегПравила(Кука, "editme", "^1.0", "stable", "check");

	// в таблице у каждого тега есть переход в конструктор
	Список = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Список, "Изменить") > 0, "у тега есть правка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список, "tag=editme") > 0, "правка ведёт в конструктор с именем тега").ЭтоИстина();

	// тег открывается ЗАПОЛНЕННЫМ: имя, вид, правило и оформление подставлены — при переходе
	// от радиокнопок к спискам это первое, что теряется
	Правка = Тело(Клиент.GETСКукой(Страница + "?tag=editme", Кука));
	Ожидаем.Что(СтрНайти(Правка, "value=""editme""") > 0, "имя подставлено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Правка, "value=""^1.0""") > 0, "правило подставлено").ЭтоИстина();
	Ожидаем.Что(ВариантВыбран(Правка, "stable"), "стиль выбран в списке").ЭтоИстина();
	Ожидаем.Что(ВариантВыбран(Правка, "check"), "значок выбран в списке").ЭтоИстина();
	Ожидаем.Что(ВариантВыбран(Правка, "semver"), "вид тега выбран в списке").ЭтоИстина();
	// секция ОДНА, и она сама называет себя правкой: заведение и правка отличаются
	Ожидаем.Что(СтрНайти(Правка, "Изменение тега") > 0,
		"секция названа правкой, а не заведением").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Правка, "Сохранение изменений тега"),
		"отдельной секции сохранения нет").Равно(0);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "Изменение тега"),
		"а пустой конструктор называется конструктором").Равно(0);

	// правим оформление, не трогая имя, — одним нажатием «Сохранить тег»
	Токен = ИзвлечьCSRF(Правка);
	Поля = ПоляКонструктора(Токен, "semver", "сохранить", "editme", "deprecated", "history");
	Поля.Вставить("правило", "^1.0");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)), "правка сохранена").ЭтоИстина();

	После = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(После, "tag--err") > 0, "стиль тега изменился").ЭтоИстина();
	Ожидаем.Что(СколькоРаз(После, ">editme<"), "второго тега не появилось").Равно(1);

	УдалитьТег(Кука, "editme");

КонецПроцедуры

// Смена режима у существующего тега меняет СОСТАВ канала, поэтому о ней предупреждают
// до записи — это и есть подтверждение опасного на этом экране.
&Тест
Процедура СменаРежимаСуществующегоТегаПредупреждаетОСоставе() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/tags";

	ЗавестиРучнойТег(Кука, "switchme", "plain", "");

	// ручной -> правило: метки будут сняты. Конструктор говорит это ДО записи — уже
	// на открытии существующего тега в другом виде
	Разметка = Тело(Клиент.GETСКукой(Страница + "?tag=switchme&kind=semver", Кука));
	Ожидаем.Что(СтрНайти(Разметка, "сейчас ручной") > 0,
		"названо текущее состояние тега").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "метки будут сняты") > 0,
		"сказано, ЧТО именно изменится").ЭтоИстина();

	// и проверка правила предупреждение не теряет
	Токен = ИзвлечьCSRF(Разметка);
	Поля = ПоляКонструктора(Токен, "semver", "проверить", "switchme", "plain", "");
	Поля.Вставить("правило", "*");
	Ожидаем.Что(СтрНайти(Тело(Клиент.POSTФормы(Страница, Поля, Кука)), "метки будут сняты") > 0,
		"проверка правила предупреждение не теряет").ЭтоИстина();

	// у заведения нового тега такого предупреждения нет — пугать не за что
	ПоляНового = ПоляКонструктора(Токен, "semver", "проверить", "freshtag", "plain", "");
	ПоляНового.Вставить("правило", "*");
	Ожидаем.Что(СтрНайти(Тело(Клиент.POSTФормы(Страница, ПоляНового, Кука)), "метки будут сняты"),
		"у нового тега состав менять не с чего").Равно(0);

	УдалитьТег(Кука, "switchme");

КонецПроцедуры

// Список в меню — не гарантия: форму можно подделать. Судит сервер, а не <select>.
&Тест
Процедура ПодделанноеИмяТегаВМенюОтбиваетсяСервером() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/versions";

	ЗавестиРучнойТег(Кука, "real", "", "");
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));

	// (1) тега с таким именем у пакета нет вовсе
	Чужой = Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_добавить", "1.0.0", "нетакого"), Кука);
	Ожидаем.Что(Чужой.КодСостояния, "неизвестное имя тега отбито").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Чужой), "Такого ручного тега у пакета нет") > 0,
		"причина отказа названа").ЭтоИстина();

	// (2) тег есть, но он ПРАВИЛО: ручная метка на нём ни на что не влияет
	Правило = Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_добавить", "1.0.0", "stable"), Кука);
	Ожидаем.Что(Правило.КодСостояния, "тег-правило вместо ручного отбит").Равно(400);

	// (3) снять тем же способом чужой тег тоже нельзя
	Снятие = Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_снять", "1.0.0", "stable"), Кука);
	Ожидаем.Что(Снятие.КодСостояния, "снятие метки с тега-правила отбито").Равно(400);

	Разметка = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Разметка, "Снять тег нетакого"), "подделка ничего не создала").Равно(0);

	УдалитьТег(Кука, "real");

КонецПроцедуры

// Конструктор заводит ОБА вида тега; ручной приходит пустым, а оформление — свойство тега,
// поэтому стоит в обоих режимах.
&Тест
Процедура КонструкторЗаводитРучнойТегИПоказываетПревьюПлашки() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/tags";

	Ручной = Тело(Клиент.GETСКукой(Страница + "?kind=manual", Кука));
	Ожидаем.Что(СтрНайти(Ручной, "Вид тега") > 0, "выбор вида тега на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ручной, "name=""имя""") > 0, "поле имени").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ручной, "name=""стиль""") > 0, "выбор стиля").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ручной, "name=""значок""") > 0, "выбор значка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ручной, "type=""radio"""), "радиокарточек с образцами больше нет").Равно(0);
	Ожидаем.Что(СтрНайти(Ручной, "type=""color"""), "нативной пипетки больше нет").Равно(0);
	Ожидаем.Что(СтрНайти(Ручной, "studio__sample") > 0, "справа — превью плашки").ЭтоИстина();
	Ожидаем.Что(ПоляФормыСо(Ручной, "name=""вид""").Получить("правило"),
		"у ручного тега правило не отправляется").Равно(Неопределено);

	// а у тега-правила поле правила на месте, и оформление тоже
	Правило = Тело(Клиент.GETСКукой(Страница + "?kind=semver", Кука));
	Ожидаем.Что(СтрНайти(Правило, "name=""правило""") > 0, "поле правила").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Правило, "name=""стиль""") > 0, "стиль — свойство тега, а не вида").ЭтоИстина();

	// ручной тег заводится ОДНИМ нажатием: шага-предпросмотра между вводом и записью нет
	Токен = ИзвлечьCSRF(Ручной);
	Поля = ПоляКонструктора(Токен, "manual", "сохранить", "brandtag", "special", "lock");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)),
		"ручной тег сохранён одним нажатием").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница + "?tag=brandtag", Кука)),
		"<span data-chip-target=""""><span class=""tag tag--accent""") > 0,
		"плашка конструктора — в сохранённом стиле").ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Список, "brandtag") > 0, "тег в списке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список, "class=""tag tag--accent""") > 0,
		"плашка тега в таблице несёт сохранённый стиль").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список, "ручной") > 0, "режим сохранён ручным").ЭтоИстина();

	УдалитьТег(Кука, "brandtag");

КонецПроцедуры

// Запрос собирается РОВНО из выданной разметки — так, как его отправит браузер: поля
// формы плюс выбранные варианты списков. Зелёный прогон при неработающей форме ловится
// только этим.
&Тест
Процедура ФормаТегаСобираетсяИзРазметкиИСохраняетВыбранноеОформление() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/tags";
	Разметка = Тело(Клиент.GETСКукой(Страница, Кука));

	// вид, стиль и значок — выпадающие списки, и в них ВСЕ варианты словарей
	Ожидаем.Что(СколькоРаз(Разметка, "<select") >= 3,
		"в форме три выпадающих списка").ЭтоИстина();
	Для Каждого Ключ Из СтрРазделить("plain,stable,prerelease,deprecated,special", ",") Цикл
		Ожидаем.Что(СтрНайти(Разметка, "<option value=""" + Ключ + """") > 0,
			"стиль «" + Ключ + "» предложен списком").ЭтоИстина();
	КонецЦикла;
	Для Каждого Ключ Из СтрРазделить("check,verified,warning,stop,lock,history,cube,key", ",") Цикл
		Ожидаем.Что(СтрНайти(Разметка, "<option value=""" + Ключ + """") > 0,
			"значок «" + Ключ + "» предложен списком").ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(ВариантВыбран(Разметка, ""),
		"«без значка» — пустой ключ, а не подпись").ЭтоИстина();

	Поля = ПоляФормыСо(Разметка, "name=""правило""");
	Ожидаем.Что(Поля.Получить("вид"), "выбранный вид доехал до запроса").Равно("semver");
	Ожидаем.Что(Поля.Получить("стиль"), "выбранный стиль доехал до запроса").Равно("plain");
	Ожидаем.Что(Поля.Получить("значок"), "выбранный значок доехал до запроса").Равно("");

	// человек меняет ровно то, что меняется мышью, и жмёт единственную основную кнопку
	Поля.Вставить("операция", "сохранить");
	Поля.Вставить("имя", "formtag");
	Поля.Вставить("правило", "^1.0");
	Поля.Вставить("стиль", "deprecated");
	Поля.Вставить("значок", "lock");

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)), "тег сохранён").ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Список, "class=""tag tag--err""") > 0,
		"плашка тега в таблице несёт выбранный стиль").ЭтоИстина();

	// и форма правки открывается с ТЕМИ ЖЕ выбранными вариантами
	Правка = Тело(Клиент.GETСКукой(Страница + "?tag=formtag", Кука));
	Ожидаем.Что(ВариантВыбран(Правка, "deprecated"),
		"сохранённый стиль выбран при открытии").ЭтоИстина();
	Ожидаем.Что(ВариантВыбран(Правка, "lock"),
		"сохранённый значок выбран при открытии").ЭтоИстина();

	УдалитьТег(Кука, "formtag");

КонецПроцедуры

// Один список вместо пары вложенных переключателей: три значения — три состояния тега,
// и каждое обязано сохраниться и открыться выбранным.
&Тест
Процедура ТриВидаТегаСохраняютсяИЧитаютсяОбратно() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");

	ПроверитьВидТега(Кука, "semver", "^1.0", "kindsemver");
	ПроверитьВидТега(Кука, "regex", "^1\.0\..*$", "kindregex");
	ПроверитьВидТега(Кука, "manual", "", "kindmanual");

КонецПроцедуры

// Тег-правило без выражения отбирать нечем: ни проверка, ни сохранение его не принимают.
&Тест
Процедура ПравилоБезДиапазонаНеСохраняется() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/tags";
	Разметка = Тело(Клиент.GETСКукой(Страница, Кука));

	Поля = ПоляФормыСо(Разметка, "name=""правило""");
	Поля.Вставить("операция", "проверить");
	Поля.Вставить("имя", "emptyrule");
	Поля.Вставить("правило", "");

	Показ = Клиент.POSTФормы(Страница, Поля, Кука);
	Ожидаем.Что(Показ.КодСостояния, "пустое правило не роняет страницу").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Показ), "Правило не применено") > 0, "причина названа").ЭтоИстина();

	Прямо = ПоляФормыСо(Разметка, "name=""правило""");
	Прямо.Вставить("операция", "сохранить");
	Прямо.Вставить("имя", "emptyrule");
	Прямо.Вставить("правило", "");
	Ожидаем.Что(Клиент.POSTФормы(Страница, Прямо, Кука).КодСостояния,
		"сохранение неисполнимого правила отбито").Равно(400);

	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "emptyrule"), "тег не создан").Равно(0);

КонецПроцедуры

// Живое превью плашки читает ВЫБРАННЫЙ вариант списка, и соответствие «ключ стиля →
// класс» объявлено там же. Сторож держит форму контракта на сервере: поле, названное
// контрактом, обязано быть списком, а вид с его выбранного варианта обязан совпасть
// с классом плашки, которую напечатал сам сервер.
&Тест
Процедура КонтрактЖивогоПревьюСтоитНаВыбранномВариантеСписка() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/tags";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));

	Поля = ПоляКонструктора(Токен, "semver", "проверить", "chiptag", "deprecated", "lock");
	Поля.Вставить("правило", "*");
	Показ = Клиент.POSTФормы(Страница, Поля, Кука);
	Ожидаем.Что(Показ.КодСостояния, "проверка правила отдана").Равно(200);
	Разметка = Тело(Показ);

	Студия = МеждуМаркеров(Разметка, "<div class=""studio""", ">");
	ИмяПоляСтиля = ЗначениеАтрибута(Студия, "data-chip-style");
	Ожидаем.Что(ЗначениеЗаполнено(ИмяПоляСтиля), "контракт называет поле стиля").ЭтоИстина();

	Вариант = ВыбранныйВариантСписка(Разметка, ИмяПоляСтиля);
	Ожидаем.Что(ЗначениеЗаполнено(Вариант),
		"поле «" + ИмяПоляСтиля + "» — список, и у него есть выбранный вариант").ЭтоИстина();

	Вид = ЗначениеАтрибута(Вариант, "data-chip-view");
	Ожидаем.Что(ЗначениеЗаполнено(Вид),
		"выбранный вариант несёт вид плашки: " + Вариант).ЭтоИстина();

	// то же соответствие, но напечатанное сервером — второй копии знания быть не должно
	Ожидаем.Что(СтрНайти(Разметка, "<span data-chip-target=""""><span class=""tag tag--" + Вид + """") > 0,
		"вид варианта совпал с классом серверного превью (" + Вид + ")").ЭтоИстина();

	// и значок скрипт возьмёт из value того же варианта, а глифы напечатаны все
	Ожидаем.Что(СтрНайти(Разметка, "data-chip-glyph=""lock""><svg") > 0,
		"выбранный глиф виден").ЭтоИстина();

КонецПроцедуры

// Наборы полей вида переключаются мгновенно, поэтому браузер обязан отправлять только
// включённый набор. Дефолтный тег добавляет второй случай: его тумблер ЗАБЛОКИРОВАН,
// а заблокированное поле браузер не отправляет вовсе.
&Тест
Процедура ФормаПравкиДефолтногоТегаНеОтдаётПоУмолчанию() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/tags";

	ЗавестиРучнойТег(Кука, "defaulttag", "plain", "");

	Назначение = Новый Соответствие();
	Назначение.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука))));
	Назначение.Вставить("операция", "по_умолчанию");
	Назначение.Вставить("имя", "defaulttag");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Назначение, Кука)),
		"тег назначен основным").ЭтоИстина();

	Правка = Тело(Клиент.GETСКукой(Страница + "?tag=defaulttag", Кука));
	Ожидаем.Что(СтрНайти(Правка, "disabled") > 0, "тумблер основного тега заблокирован").ЭтоИстина();

	Поля = ПоляФормыСо(Правка, "name=""вид""");
	Ожидаем.Что(Поля.Получить("по_умолчанию"),
		"заблокированный тумблер браузер не отправляет").Равно(Неопределено);

	// самотест харнесса на живой форме: включённый тумблер даёт «1», выключенный — «0»,
	// и на повторяющееся имя побеждает ПЕРВОЕ значение — ровно как читает сервер
	Карточка = "/public/alice-pkg/settings/card";
	Выключен = ПоляФормыСо(Тело(Клиент.GETСКукой(Карточка, Кука)), "name=""устарел""");
	Ожидаем.Что(Выключен.Получить("устарел"), "выключенный тумблер уезжает нулём").Равно("0");

	Включение = ПоляФормыСо(Тело(Клиент.GETСКукой(Карточка, Кука)), "name=""устарел""");
	Включение.Вставить("устарел", "1");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Карточка, Включение, Кука)), "признак включён").ЭтоИстина();

	Включен = ПоляФормыСо(Тело(Клиент.GETСКукой(Карточка, Кука)), "name=""устарел""");
	Ожидаем.Что(Включен.Получить("устарел"), "включённый тумблер уезжает единицей").Равно("1");

	Возврат_ = ПоляФормыСо(Тело(Клиент.GETСКукой(Карточка, Кука)), "name=""устарел""");
	Возврат_.Вставить("устарел", "0");
	Клиент.POSTФормы(Карточка, Возврат_, Кука);

	УдалитьТег(Кука, "defaulttag");

КонецПроцедуры

// После сохранения конструктор возвращается В СВОЙ вид: иначе автор ручного тега молча
// оказывался бы в semver-правиле и правил не тот тег, который только что завёл.
&Тест
Процедура ПослеСохраненияКонструкторВозвращаетсяВСвойВид() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/tags";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница + "?kind=manual", Кука)));

	Ответ = Клиент.POSTФормы(Страница,
		ПоляКонструктора(Токен, "manual", "сохранить", "backtag", "plain", ""), Кука);
	Ожидаем.Что(УспехМутации(Ответ), "ручной тег сохранён").ЭтоИстина();

	// клиент мог пройти по редиректу сам — тогда в ответе уже целевая страница
	Если Редирект(Ответ) Тогда
		Адрес = Клиент.ЗаголовокОтвета(Ответ, "Location");
		Ожидаем.Что(СтрНайти(Адрес, "kind=manual") > 0,
			"возврат ведёт в ручной вид: " + Адрес).ЭтоИстина();
		Разметка = Тело(Клиент.GETСКукой(Адрес, Кука));
	Иначе
		Разметка = Тело(Ответ);
	КонецЕсли;

	Ожидаем.Что(ВариантВыбран(Разметка, "manual"),
		"после сохранения конструктор остался в ручном виде").ЭтоИстина();

	УдалитьТег(Кука, "backtag");

КонецПроцедуры

// Крестик снятия есть ТОЛЬКО у ручного тега: у тега-правила снятие метки — гарантированная
// ошибка, и кнопки, которая всегда ошибается, в разметке быть не должно.
&Тест
Процедура КрестикСнятияЕстьТолькоУРучногоТега() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/versions";

	ЗавестиРучнойТег(Кука, "crosstag", "plain", "");
	ЗавестиТегПравила(Кука, "ruletag", "^1.0", "plain", "");
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));
	Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_добавить", "1.0.0", "crosstag"), Кука);

	Разметка = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СвязкаТегаСКрестиком(Разметка, "crosstag"),
		"у ручного тега крестик внутри плашки").ЭтоИстина();
	// тег-правило стоит на той же версии сам, без ручной метки
	Ожидаем.Что(СтрНайти(Разметка, ">ruletag<") > 0,
		"тег-правило виден в строке версии").ЭтоИстина();
	Ожидаем.Что(СвязкаТегаСКрестиком(Разметка, "ruletag"),
		"у тега-правила крестика нет").ЭтоЛожь();

	СнятьТегСВерсии(Кука, "crosstag", "1.0.0");
	УдалитьТег(Кука, "crosstag");
	УдалитьТег(Кука, "ruletag");

КонецПроцедуры

// После снятия образцов подпись — ЕДИНСТВЕННОЕ, чем стили и значки различаются на экране:
// одинаковые подписи делают список бесполезным, и сервер обязан их различать.
&Тест
Процедура ВариантыСписковОформленияНазваныПоРазному() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Разметка = Тело(Клиент.GETСКукой("/public/alice-pkg/settings/tags", Кука));

	Стили = ПодписиВариантов(Разметка, "стиль");
	Ожидаем.Что(Стили.Количество(), "в списке стиля пять вариантов").Равно(5);
	Ожидаем.Что(РазныхПодписей(Стили), "все подписи стилей различны: "
		+ СтрСоединить(Стили, ", ")).Равно(5);

	Значки = ПодписиВариантов(Разметка, "значок");
	Ожидаем.Что(Значки.Количество(), "в списке значка девять вариантов").Равно(9);
	Ожидаем.Что(РазныхПодписей(Значки), "все подписи значков различны: "
		+ СтрСоединить(Значки, ", ")).Равно(9);

КонецПроцедуры

// Стиль и значок — ключи закрытых списков, и судит их СЕРВЕР: список в браузере —
// удобство, а не гарантия. Подделанное значение не сохраняется и не доезжает до разметки.
&Тест
Процедура ПодделанноеОформлениеТегаОтбиваетсяФормой() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = "/public/alice-pkg/settings/tags";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));

	Подделки = Новый Массив();
	Подделки.Добавить("'><script>alert(1)</script>");
	Подделки.Добавить("#e0603a");
	Подделки.Добавить("кислотный");

	Для Каждого Значение Из Подделки Цикл
		Поля = ПоляКонструктора(Токен, "manual", "сохранить", "poison", Значение, "");
		Ответ = Клиент.POSTФормы(Страница, Поля, Кука);
		Ожидаем.Что(Ответ.КодСостояния, "стиль «" + Значение + "» отклонён").Равно(400);
		Разметка = Тело(Ответ);
		Ожидаем.Что(СтрНайти(Разметка, "Оформление не принято") > 0, "причина названа").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Разметка, Значение),
			"непринятое значение НЕ отражается обратно в разметку").Равно(0);
	КонецЦикла;

	// значок судится тем же гейтом: закрытый список и на нём
	Значок = Клиент.POSTФормы(Страница,
		ПоляКонструктора(Токен, "manual", "сохранить", "poison", "stable", "череп"), Кука);
	Ожидаем.Что(Значок.КодСостояния, "незнакомый значок отклонён").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Значок), "Оформление не принято") > 0,
		"причина отказа по значку названа").ЭтоИстина();

	// вид — такой же закрытый список, и он стоит на пути ЗАПИСИ: политика на всех трёх
	// полях одной формы одна
	Для Каждого Значение Из Подделки Цикл
		Ответ = Клиент.POSTФормы(Страница,
			ПоляКонструктора(Токен, Значение, "сохранить", "poison", "stable", ""), Кука);
		Ожидаем.Что(Ответ.КодСостояния, "вид «" + Значение + "» отклонён").Равно(400);
		Ожидаем.Что(СтрНайти(Тело(Ответ), "Вид тега не принят") > 0, "причина названа").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело(Ответ), Значение),
			"непринятый вид НЕ отражается обратно в разметку").Равно(0);
	КонецЦикла;

	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "poison"),
		"ни одна подделка не создала тега").Равно(0);

	// и сырого цвета в разметке страницы пакета нет вовсе — цвет теперь живёт в теме
	Публичная = Тело(Клиент.GET("/public/alice-pkg")) + Тело(Клиент.GET("/public/alice-pkg/versions"));
	Ожидаем.Что(СтрНайти(Публичная, "#e0603a"), "хранимого цвета не осталось").Равно(0);

	// имя тега тоже судит сервер: непринимаемое имя не пишется ни одной кнопкой
	Запись = Клиент.POSTФормы(Страница,
		ПоляКонструктора(Токен, "manual", "сохранить", "Плохое Имя", "", ""), Кука);
	Ожидаем.Что(Запись.КодСостояния, "непринимаемое имя не сохраняется").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Запись), "Имя тега не принято") > 0, "причина названа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "Плохое"), "тег не создан").Равно(0);

	// а проверка — вопрос, а не запись: тот же отказ печатается в конструкторе без 400
	Плохое = ПоляКонструктора(Токен, "semver", "проверить", "Плохое Имя", "", "");
	Плохое.Вставить("правило", "*");
	ОтветПлохого = Клиент.POSTФормы(Страница, Плохое, Кука);
	Ожидаем.Что(ОтветПлохого.КодСостояния, "проверка непринимаемого имени страницу не роняет").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(ОтветПлохого), "Имя тега не принято") > 0,
		"причина названа и в проверке").ЭтоИстина();

КонецПроцедуры

#Область ВидТегаНаВсехСтраницах


// Мейнтейнер выбирает стиль и значок один раз, а тег виден на четырёх страницах.
// Сторож обходит их все и требует ОДИН цвет и ОДИН значок: экран настроек здесь эталон,
// потому что именно на нём человек этот вид и выбрал.
&Тест
Процедура ВидТегаОдинаковыйНаВсехСтраницахПакета() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	ЗавестиТегПравила(Кука, "chan-old", "*", "deprecated", "stop");

	Эталон = ПлашкаТегаНаСтранице(
		Тело(Клиент.GETСКукой("/public/alice-pkg/settings/tags", Кука)), "chan-old");
	Ожидаем.Что(КлассПлашки(Эталон),
		"стиль «устаревший» на экране, где его выбрали").Равно("tag tag--err");
	Ожидаем.Что(ЗначокПлашки(Эталон) <> "", "и выбранный значок нарисован").ЭтоИстина();

	Для Каждого Страница Из СтраницыСТегами(Кука) Цикл

		Плашка = ПлашкаТегаНаСтранице(Страница.Значение, "chan-old");
		Ожидаем.Что(Плашка <> "", "плашка тега есть на " + Страница.Ключ).ЭтоИстина();
		Ожидаем.Что(КлассПлашки(Плашка),
			"цвет тега на " + Страница.Ключ).Равно(КлассПлашки(Эталон));
		Ожидаем.Что(ЗначокПлашки(Плашка),
			"значок тега на " + Страница.Ключ).Равно(ЗначокПлашки(Эталон));

	КонецЦикла;

	УдалитьТег(Кука, "chan-old");

КонецПроцедуры

// «Сюда придёт установка без версии» — свойство ОСНОВНОГО тега, а не совпадения имени
// с базовым списком. Пометка едет за пометкой мейнтейнера и выглядит везде одинаково.
&Тест
Процедура ПометкаОсновногоКаналаЕдетЗаПометкойМейнтейнера() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	ЗавестиТегПравила(Кука, "chan-first", "*", "stable", "verified");
	ЗавестиТегПравила(Кука, "chan-second", "*", "prerelease", "warning");

	СделатьОсновным(Кука, "chan-first");
	ПроверитьПометкуОсновного(Кука, "chan-first");

	СделатьОсновным(Кука, "chan-second");
	ПроверитьПометкуОсновного(Кука, "chan-second");

	УдалитьТег(Кука, "chan-first");
	УдалитьТег(Кука, "chan-second");

КонецПроцедуры

// Пометка основного канала — ЗНАЧОК: слова стояли в каждой строке таблицы и в каждом ряду
// каналов у версии. Немым значок не стал: подпись озвучивает его скринридеру и печатается
// подсказкой браузера. Значок без подписи — пометка, которую видит только зрячий.
&Тест
Процедура ПометкаОсновногоКаналаЗначокСоСловеснойПодписью() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	ЗавестиТегПравила(Кука, "chan-mark", "*", "stable", "verified");
	СделатьОсновным(Кука, "chan-mark");

	Разметка = Тело(Клиент.GETСКукой("/public/alice-pkg/settings/tags", Кука));

	Ожидаем.Что(СтрНайти(Разметка, "(по умолчанию)"),
		"словесной пометки на экране не осталось").Равно(0);
	Ожидаем.Что(СтрНайти(Разметка, "<title>" + ПодписьОсновногоКанала() + "</title>") > 0,
		"пометка звучит словами: подпись значка на месте").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(ВыделенныеКаналыТаблицы(Разметка), ", "),
		"и значок стоит у основного канала").Равно("chan-mark");

	УдалитьТег(Кука, "chan-mark");

КонецПроцедуры

// Основной канал в таблице тегов виден не вчитыванием, а взглядом: его строка залита
// цветом, а значок пометки стоит У ИМЕНИ ТЕГА — в той же ячейке. Своего столбца у пометки
// нет: на узком экране строка становится карточкой, и столбец из одного значка превратился
// бы в строку, которая ничего о себе не говорит.
&Тест
Процедура СтрокаОсновногоКаналаЗалитаЦветомИНесётЗначокУИмениТега() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	ЗавестиТегПравила(Кука, "chan-main", "*", "stable", "verified");
	ЗавестиТегПравила(Кука, "chan-side", "*", "prerelease", "warning");
	СделатьОсновным(Кука, "chan-main");

	Разметка = Тело(Клиент.GETСКукой("/public/alice-pkg/settings/tags", Кука));
	Основная = СтрокаКанала(Разметка, "chan-main");
	Прочая = СтрокаКанала(Разметка, "chan-side");

	Ожидаем.Что(СтрокаВыделена(Основная),
		"строка основного канала залита цветом: " + Основная).ЭтоИстина();
	Ожидаем.Что(ПометкаВЯчейкеТега(Основная),
		"и несёт значок пометки в ячейке тега: " + Основная).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(Основная, ПодписьОсновногоКанала()),
		"пометка в строке ОДНА: второй копии столбцом больше нет: " + Основная).Равно(1);

	Ожидаем.Что(СтрокаВыделена(Прочая),
		"строка обычного канала цветом не залита: " + Прочая).ЭтоЛожь();
	Ожидаем.Что(СтрЧислоВхождений(Прочая, ПодписьОсновногоКанала()),
		"и пометки у неё нет вовсе: " + Прочая).Равно(0);

	УдалитьТег(Кука, "chan-main");
	УдалитьТег(Кука, "chan-side");

КонецПроцедуры

// Три действия строки стояли столбиком и растили строку. Теперь они за шестерёнкой —
// как в списках пулов, учёток и версий: панель уходит во всплывающий слой, а мутации
// едут своими формами с токеном.
&Тест
Процедура МенюСтрокиКаналаНесётТриДействияЗаШестерёнкой() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	ЗавестиТегПравила(Кука, "chan-menu", "^1.0", "", "");

	// всё утверждается В ПРЕДЕЛАХ СТРОКИ канала: меню учётки в шапке страницы даёт и
	// class="menu", и popovertarget — на целой странице эти признаки зелены всегда
	Строка_ = СтрокаКанала(Тело(Клиент.GETСКукой("/public/alice-pkg/settings/tags", Кука)), "chan-menu");
	Ожидаем.Что(Строка_ <> "", "строка канала нашлась в таблице").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Строка_, "class=""menu""") > 0,
		"действия строки собраны в меню").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка_, "popovertarget=""") > 0,
		"у меню есть кнопка-открывашка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка_, "Действия с каналом «chan-menu»") > 0,
		"меню названо своим каналом: одинаковых шестерёнок в таблице столько же,"
		+ " сколько строк").ЭтоИстина();

	Панель = ПанельМенюСо(Строка_, "?tag=chan-menu");
	Ожидаем.Что(Панель <> "", "панель этой строки лежит во всплывающем слое").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "Изменить") > 0, "правка — пунктом меню").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "Сделать основным") > 0,
		"назначение основным — пунктом меню").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "Удалить") > 0, "удаление — пунктом меню").ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(Панель, "class=""menu__form"""),
		"обе мутации едут формами внутри панели").Равно(2);

	// действия ушли ИЗ строки: за пределами панели в строке их не осталось
	Снаружи = БезПанелейМеню(Строка_);
	Ожидаем.Что(СтрНайти(Снаружи, "Сделать основным"),
		"голой кнопки «Сделать основным» в строке больше нет").Равно(0);
	Ожидаем.Что(СтрНайти(Снаружи, "Удалить"),
		"и голой кнопки удаления тоже").Равно(0);
	Ожидаем.Что(СтрНайти(Снаружи, "?tag=chan-menu"),
		"и голой ссылки правки тоже").Равно(0);

	УдалитьТег(Кука, "chan-menu");

КонецПроцедуры

// Регулярка распирала колонку «Правило» на всю таблицу. Правило свёрнуто: видимая строка
// у всех каналов одна и та же, выражение приезжает по клику. Раскрывает браузер — <details>
// работает без единой строки скрипта. Ручной тег правила не имеет: там по-прежнему прочерк.
&Тест
Процедура ПравилоКаналаСвёрнутоИРаскрываетсяБезСкрипта() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	// в выражении нет символов, которые экранирование переписало бы: ищем его как есть
	Выражение = "^1\.2\.(3|4)-nightly\.[0-9]+$";
	ЗавестиТегРегекса(Кука, "chan-long", Выражение);
	ЗавестиРучнойТег(Кука, "chan-plain", "", "");

	Разметка = Тело(Клиент.GETСКукой("/public/alice-pkg/settings/tags", Кука));

	Свёрнутое = РаскрывашкаПравила(Разметка, "chan-long");
	Ожидаем.Что(Свёрнутое <> "", "правило канала стоит раскрывашкой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Свёрнутое, "<summary") > 0,
		"раскрытие даёт браузер, а не скрипт").ЭтоИстина();
	Шапка = ШапкаРаскрывашки(Свёрнутое);
	Ожидаем.Что(СтрНайти(Шапка, Выражение),
		"свёрнутая строка выражения не показывает").Равно(0);
	Ожидаем.Что(СтрНайти(Свёрнутое, Выражение) > 0,
		"а раскрытая отдаёт его целиком").ЭтоИстина();

	// доступное имя строки НАЧИНАЕТСЯ её видимым словом: голосовое управление ищет
	// элемент по тому, что человек прочитал на экране (WCAG 2.5.3 Label in Name)
	Видимое = ВидимыйТекстШапки(Шапка);
	Имя = ДоступноеИмяШапки(Шапка);
	Ожидаем.Что(Видимое <> "", "у свёрнутой строки есть видимое слово: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Имя, "chan-long") > 0,
		"доступное имя называет свой канал: " + Имя).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Имя, Видимое) > 0,
		"доступное имя «" + Имя + "» не содержит видимого слова «" + Видимое
		+ "»: команда «нажать " + Видимое + "» элемент не найдёт").ЭтоИстина();

	// ручной тег правила не имеет: его ячейка как была прочерком, так и осталась
	Ожидаем.Что(РаскрывашкаПравила(Разметка, "chan-plain"),
		"ручному тегу сворачивать нечего").Равно("");

	УдалитьТег(Кука, "chan-long");
	УдалитьТег(Кука, "chan-plain");

КонецПроцедуры

// Канал — свойство ЛЮБОГО тега, а не только тега с базовым именем: тег-правило со своим
// именем показан каналом, в своём стиле и со своей командой установки.
&Тест
Процедура ЛюбойТегПоказанКаналомСоСвоейКомандойУстановки() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	ЗавестиТегПравила(Кука, "chan-lts", "*", "special", "lock");
	ЗавестиТегПравила(Кука, "chan-any", "*", "plain", "");

	Плоско = Тело(Клиент.GET("/public/alice-pkg/versions?flat=1"));

	Для Каждого Имя Из СтрРазделить("chan-lts,chan-any", ",") Цикл
		Плашка = ПлашкаТегаНаСтранице(Плоско, Имя);
		Ожидаем.Что(Плашка <> "", "канал «" + Имя + "» показан в списке версий").ЭтоИстина();
		Подсказка = ПодсказкаПлашки(Плашка);
		Ожидаем.Что(СтрНачинаетсяС(Подсказка, "Канал обновления: opm install "),
			"подсказка канала «" + Имя + "»: " + Подсказка).ЭтоИстина();
		Ожидаем.Что(СтрЗаканчиваетсяНа(Подсказка, "@" + Имя),
			"и команда называет ЭТОТ тег: " + Подсказка).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(КлассПлашки(ПлашкаТегаНаСтранице(Плоско, "chan-lts")),
		"«особый» стиль небазового канала не подменён нейтральным").Равно("tag tag--accent");

	УдалитьТег(Кука, "chan-lts");
	УдалитьТег(Кука, "chan-any");

КонецПроцедуры

// Экран тегов ничего не обещает сам: у пакета без каналов он пуст и предлагает кнопку
// визарда. Что визард завёл, экран показывает плашками, и каждое показанное имя обязано
// отвечать версией, а не «нет такого».
&Тест
Процедура ВизардЗаводитКаналыСЭкранаТегов() Экспорт

	// свой пакет, которого не касается ни один сосед по набору: у нового пакета каналов
	// нет вовсе, и именно это состояние показывает визард
	Кука = Клиент.Войти("pub", "PubPassw0rd");
	Имя = "wizard-pkg";
	Токен = ВыпуститьPATКукой(Кука);
	// по версии на каждый предлагаемый канал: релиз, кандидат и сборочная
	Для Каждого Версия Из СтрРазделить("1.0.0,1.1.0-rc.1,1.2.0-alpha.1", ",") Цикл
		Ожидаем.Что(PushТокеном(Токен, "public", Имя, Версия).КодСостояния,
			"свежий пакет опубликован: " + Версия).Равно(201);
	КонецЦикла;

	Страница = "/public/" + Имя + "/settings/tags";
	Ожидаемые = СтрРазделить("stable,prerelease,develop", ",");
	Резолв = "/api/v1/pools/public/packages/" + Имя + "/resolve?spec=";

	Пусто = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Пусто, "Создать каналы") > 0,
		"у пакета без каналов на экране есть кнопка визарда").ЭтоИстина();
	Ожидаем.Что(Клиент.GET(Резолв + "stable").КодСостояния,
		"КОНТРОЛЬ: до визарда «stable» — «нет такого»").Равно(404);

	// серверная дорога к окну: страница приходит с уже открытым <dialog>
	Открытое = Тело(Клиент.GETСКукой(Страница + "?form=1", Кука));
	Ожидаем.Что(СтрНайти(Открытое, "<dialog") > 0, "окно визарда на странице").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Открытое, " open>") > 0, "и оно открыто адресом").ЭтоИстина();

	// каждый предлагаемый канал показан С СОСТАВОМ, и состав этот — СЛОВА: канал, которому
	// слов не написали, оставил бы человека выбирать вслепую, а плашка рядом словами не
	// является
	Окно = МеждуМаркеров(Открытое, "<dialog", "</dialog>");
	Для Каждого ИмяКанала Из Ожидаемые Цикл
		Ожидаем.Что(СоставКаналаВОкне(Окно, ИмяКанала),
			"канал «" + ИмяКанала + "» предложен со словами о своём составе").Заполнено();
	КонецЦикла;

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Пусто));
	Поля.Вставить("операция", "каналы_по_умолчанию");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)), "визард отработал").ЭтоИстина();

	Разметка = Тело(Клиент.GETСКукой(Страница, Кука));
	Для Каждого ИмяКанала Из Ожидаемые Цикл
		Ожидаем.Что(ЗначениеЗаполнено(ПлашкаТегаНаСтранице(Разметка, ИмяКанала)),
			"экран показывает канал «" + ИмяКанала + "»").ЭтоИстина();
		Ожидаем.Что(Клиент.GET(Резолв + ИмяКанала).КодСостояния,
			"показанный экраном канал «" + ИмяКанала + "» отдаёт версию").Равно(200);
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Разметка, "Создать каналы"),
		"кнопки визарда у пакета с каналами больше нет").Равно(0);

	// опечатка в имени канала объясняется перечнем заведённых — и на резолве, и на выдаче
	Отказ = Клиент.GET(Резолв + "stabel");
	Ожидаем.Что(Отказ.КодСостояния, "незаведённое имя → 404").Равно(404);
	Сообщение = Отказ.ПолучитьТелоКакСтроку();
	Ожидаем.Что(СтрНайти(Сообщение, "stabel") > 0, "названо то, чего нет: " + Сообщение).ЭтоИстина();

	Выдача = Клиент.GET("/api/v1/pools/public/channels/stabel/download/" + Имя + "/" + Имя + ".ospx");
	Ожидаем.Что(Выдача.КодСостояния, "канальный путь с опечаткой → 404").Равно(404);
	ТелоВыдачи = Выдача.ПолучитьТелоКакСтроку();
	Ожидаем.Что(СтрНайти(ТелоВыдачи, "stabel") > 0,
		"выдача тоже называет незаведённое имя: " + ТелоВыдачи).ЭтоИстина();

	Для Каждого ИмяКанала Из Ожидаемые Цикл
		Ожидаем.Что(СтрНайти(Сообщение, ИмяКанала) > 0,
			"резолв перечислил заведённый «" + ИмяКанала + "»: " + Сообщение).ЭтоИстина();
		Ожидаем.Что(СтрНайти(ТелоВыдачи, ИмяКанала) > 0,
			"и выдача теми же словами: " + ТелоВыдачи).ЭтоИстина();
	КонецЦикла;

	ПовторноеНажатиеПредупреждает(Кука, Страница);

КонецПроцедуры

// Три страницы, где тег показан КАНАЛОМ: пометка основного на каждой одна и та же.
// Экран версий в настройках сюда не входит — там тег стоит меткой версии, а не каналом.
// Пометка основного канала едет за решением мейнтейнера на всех экранах сразу, но выглядит
// она по-разному: в таблице тегов это залитая строка со значком в её начале, а у версии —
// значок рядом с плашкой. Обе стороны обязаны показывать ОДИН канал.
Процедура ПроверитьПометкуОсновного(Знач Кука, Знач Ожидаемый)

	Таблица = "/public/alice-pkg/settings/tags";
	Ожидаем.Что(СтрСоединить(ВыделенныеКаналыТаблицы(Тело(Клиент.GETСКукой(Таблица, Кука))), ", "),
		"выделенная строка канала на " + Таблица).Равно(Ожидаемый);

	Адреса = Новый Массив();
	Адреса.Добавить("/public/alice-pkg/versions");
	Адреса.Добавить("/public/alice-pkg/versions?flat=1");

	Для Каждого Адрес Из Адреса Цикл
		Помеченные = КаналыСПометкойОсновного(Тело(Клиент.GETСКукой(Адрес, Кука)));
		Ожидаем.Что(СтрСоединить(Помеченные, ", "),
			"пометка основного канала на " + Адрес).Равно(Ожидаемый);
	КонецЦикла;

КонецПроцедуры

Процедура СделатьОсновным(Знач Кука, Знач ИмяТега)

	Страница = "/public/alice-pkg/settings/tags";
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука))));
	Поля.Вставить("операция", "по_умолчанию");
	Поля.Вставить("имя", ИмяТега);

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)),
		"тег " + ИмяТега + " стал основным").ЭтоИстина();

КонецПроцедуры

Функция СтраницыСТегами(Знач Кука)

	Результат = Новый Соответствие();
	Для Каждого Адрес Из СтрРазделить("/settings/tags,/settings/versions,/versions,"
		+ "/versions?flat=1", ",") Цикл
		Результат.Вставить("/public/alice-pkg" + Адрес,
			Тело(Клиент.GETСКукой("/public/alice-pkg" + Адрес, Кука)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Плашка тега по подписи: <span class="tag…">…имя</span>. У тега-правила управления
// внутри плашки нет, поэтому первый же </span> закрывает именно её.
Функция ПлашкаТегаНаСтранице(Знач Разметка, Знач ИмяТега)

	Хвост = Разметка;
	Начало = СтрНайти(Хвост, "<span class=""tag");

	Пока Начало > 0 Цикл
		Хвост = Сред(Хвост, Начало);
		Конец = СтрНайти(Хвост, "</span>");
		Фрагмент = ?(Конец = 0, Хвост, Лев(Хвост, Конец + 6));
		Если СтрЗаканчиваетсяНа(Фрагмент, ">" + ИмяТега + "</span>") Тогда
			Возврат Фрагмент;
		КонецЕсли;
		Хвост = Сред(Хвост, 2);
		Начало = СтрНайти(Хвост, "<span class=""tag");
	КонецЦикла;

	Возврат "";

КонецФункции

Функция КлассПлашки(Знач Фрагмент)
	Возврат Клиент.ПослеМаркера(Фрагмент, "class=""", """");
КонецФункции

Функция ПодсказкаПлашки(Знач Фрагмент)
	Возврат Клиент.ПослеМаркера(Фрагмент, "title=""", """");
КонецФункции

Функция ЗначокПлашки(Знач Фрагмент)

	Начало = СтрНайти(Фрагмент, "<svg");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Фрагмент, Начало);
	Конец = СтрНайти(Хвост, "</svg>");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец + 5));

КонецФункции

// Имена каналов, у которых стоит пометка основного: их обязано быть ровно одно на пакет,
// сколько бы строк версий эту плашку ни повторяли. Пометка — ЗНАЧОК, и опознаётся она
// по СЛОВАМ своей подписи: значок без подписи немой, и такой пометки здесь быть не должно.
Функция КаналыСПометкойОсновного(Знач Разметка)

	Найденные = Новый Соответствие();
	Маркер = "</span> <span class=""muted""><svg";

	Хвост = Разметка;
	Позиция = СтрНайти(Хвост, Маркер);
	Пока Позиция > 0 Цикл
		Голова = Лев(Хвост, Позиция - 1);
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Если ЗначокОзвучен(Хвост, ПодписьОсновногоКанала()) Тогда
			Найденные.Вставить(ПодписьПеред(Голова), Истина);
		КонецЕсли;
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Результат = Новый Массив();
	Для Каждого КиЗ Из Найденные Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Что пометка основного канала говорит человеку и скринридеру.
Функция ПодписьОсновногоКанала()
	Возврат "Канал по умолчанию";
КонецФункции

// Имена каналов, чья строка в таблице тегов выделена. Выделение — это ДВА признака сразу:
// заливка всей строки и значок пометки в ячейке тега. Строка, у которой есть только
// один из них, выделенной не считается: заливка без значка нема для скринридера, значок
// без заливки не виден боковым зрением.
Функция ВыделенныеКаналыТаблицы(Знач Разметка)

	Результат = Новый Массив();

	Хвост = Разметка;
	Позиция = СтрНайти(Хвост, "<tr");
	Пока Позиция > 0 Цикл

		Хвост = Сред(Хвост, Позиция + 3);
		Конец = СтрНайти(Хвост, "</tr>");
		Строка_ = ?(Конец = 0, Хвост, Лев(Хвост, Конец - 1));

		Имя = ИмяКаналаСтроки(Строка_);
		Если ЗначениеЗаполнено(Имя) И СтрокаВыделена(Строка_) И ПометкаВЯчейкеТега(Строка_) Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

		Позиция = СтрНайти(Хвост, "<tr");

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Имя канала строки — подпись плашки тега в ней; "" — строка канала не показывает.
Функция ИмяКаналаСтроки(Знач Строка_)

	Начало = СтрНайти(Строка_, "<span class=""tag");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Строка_, Начало);
	Конец = СтрНайти(Хвост, "</span>");
	Возврат ?(Конец = 0, "", ПодписьПеред(Лев(Хвост, Конец - 1)));

КонецФункции

// Залита ли строка цветом: признак стоит на самой строке, а не на ячейке внутри неё —
// иначе выделенным оказался бы один столбец из шести.
Функция СтрокаВыделена(Знач Строка_)

	Конец = СтрНайти(Строка_, ">");
	Возврат СтрНайти(?(Конец = 0, Строка_, Лев(Строка_, Конец - 1)), "row-accent") > 0;

КонецФункции

// Стоит ли в первом столбце строки значок пометки, названный словами.
// Пометка основного канала едет ВМЕСТЕ с тегом: в карточке узкого экрана отдельный столбец
// со значком остался бы строкой, которая объясняет сама себя только на широком экране.
Функция ПометкаВЯчейкеТега(Знач Строка_)

	Ячейка = ПерваяЯчейкаСтроки(Строка_);
	Если СтрНайти(Ячейка, "<span class=""tag") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	// значков в ячейке два: свой значок плашки тега и пометка — ищем ОЗВУЧЕННЫЙ
	Хвост = Ячейка;
	Позиция = СтрНайти(Хвост, "<svg");
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + 4);
		Если ЗначокОзвучен(Хвост, ПодписьОсновногоКанала()) Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = СтрНайти(Хвост, "<svg");
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ПерваяЯчейкаСтроки(Знач Строка_)
	Возврат МеждуМаркеров(Строка_, "<td", "</td>");
КонецФункции

// Значок озвучен, если он объявлен рисунком с именем и это имя — ожидаемые слова.
// Ищем в пределах ОДНОГО рисунка: до его закрывающего тега.
Функция ЗначокОзвучен(Знач ХвостПослеSVG, Знач Подпись)

	Конец = СтрНайти(ХвостПослеSVG, "</svg>");
	Если Конец = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Рисунок = Лев(ХвостПослеSVG, Конец);
	Возврат СтрНайти(Рисунок, "role=""img""") > 0
		И СтрНайти(Рисунок, "<title>" + Подпись + "</title>") > 0;

КонецФункции

// Содержимое всплывающих панелей меню: у панели нет вложенных блоков, поэтому её
// закрывает первый же </div>.
Функция ПанелиМеню(Знач Разметка)

	Результат = Новый Массив();
	Маркер = " popover class=""menu__panel"">";

	Хвост = Разметка;
	Позиция = СтрНайти(Хвост, Маркер);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, "</div>");
		Результат.Добавить(?(Конец = 0, Хвост, Лев(Хвост, Конец - 1)));
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Панель меню, внутри которой встретился признак строки.
Функция ПанельМенюСо(Знач Разметка, Знач Признак)

	Для Каждого Панель Из ПанелиМеню(Разметка) Цикл
		Если СтрНайти(Панель, Признак) > 0 Тогда
			Возврат Панель;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Страница без содержимого панелей: в ней видно только то, что осталось стоять в строках.
Функция БезПанелейМеню(Знач Разметка)

	Результат = Разметка;
	Для Каждого Панель Из ПанелиМеню(Разметка) Цикл
		Результат = СтрЗаменить(Результат, Панель, "");
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Строка таблицы, в которой напечатана плашка этого канала.
Функция СтрокаКанала(Знач Разметка, Знач ИмяТега)

	Хвост = Разметка;
	Позиция = СтрНайти(Хвост, "<tr");

	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + 3);
		Конец = СтрНайти(Хвост, "</tr>");
		Строка_ = ?(Конец = 0, Хвост, Лев(Хвост, Конец - 1));
		Если СтрНайти(Строка_, ">" + ИмяТега + "</span>") > 0 Тогда
			Возврат Строка_;
		КонецЕсли;
		Позиция = СтрНайти(Хвост, "<tr");
	КонецЦикла;

	Возврат "";

КонецФункции

// Раскрывашка правила в строке канала; "" — правила у канала нет и сворачивать нечего.
Функция РаскрывашкаПравила(Знач Разметка, Знач ИмяТега)

	Строка_ = СтрокаКанала(Разметка, ИмяТега);
	Начало = СтрНайти(Строка_, "<details");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Строка_, Начало);
	Конец = СтрНайти(Хвост, "</details>");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец + 9));

КонецФункции

// Слово, которое человек читает на свёрнутой строке.
Функция ВидимыйТекстШапки(Знач Шапка)

	Начало = СтрНайти(Шапка, ">");
	Конец = СтрНайти(Шапка, "</summary>");
	Если Начало = 0 ИЛИ Конец = 0 ИЛИ Конец <= Начало Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Сред(Шапка, Начало + 1, Конец - Начало - 1));

КонецФункции

// Имя, которым свёрнутую строку зовут скринридер и голосовое управление.
Функция ДоступноеИмяШапки(Знач Шапка)
	Возврат Клиент.ПослеМаркера(Шапка, "aria-label=""", """");
КонецФункции

// Свёрнутая строка раскрывашки: то, что видно, пока её не раскрыли.
Функция ШапкаРаскрывашки(Знач Раскрывашка)

	Начало = СтрНайти(Раскрывашка, "<summary");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Раскрывашка, Начало);
	Конец = СтрНайти(Хвост, "</summary>");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец + 9));

КонецФункции

Функция ПодписьПеред(Знач Голова)

	Индекс = СтрДлина(Голова);
	Пока Индекс > 0 Цикл
		Если Сред(Голова, Индекс, 1) = ">" Тогда
			Возврат Сред(Голова, Индекс + 1);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат Голова;

КонецФункции

#КонецОбласти

&Тест
Процедура УровняТеговПулаБольшеНет() Экспорт

	// 5.C-2 (О-8): у тегов нет уровня «по умолчанию для пула», поэтому и прежнего
	// owner-гейта на такой уровень нет — publisher (не owner) правит теги СВОИХ пакетов
	// и НЕ может задеть чужие: у чужого пакета своя страница и свой гвард (тест ниже).
	// Скрытого поля «уровень» в форме не осталось: попытка его подсунуть ничего не даёт.
	Кука = Клиент.Войти("pub", "PubPassw0rd");
	Страница = "/public/alice-pkg/settings/tags";

	Стр = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Стр, "Теги пакета") > 0, "publisher видит страницу управления").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "Теги пула"), "секции тегов ПУЛА больше нет").Равно(0);
	Ожидаем.Что(СтрНайти(Стр, "name=""уровень"""), "поля «уровень» в форме нет").Равно(0);
	Токен = ИзвлечьCSRF(Стр);
	Ожидаем.Что(СтрДлина(Токен)).Равно(64);

	// подсунутое поле «уровень=пул» игнорируется: тег создаётся на ПАКЕТЕ, а не на пуле
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "сохранить");
	Поля.Вставить("уровень", "пул");
	Поля.Вставить("имя", "poollevel");
	Поля.Вставить("вид", "semver");
	Поля.Вставить("правило", "^0.0");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)), "тег сохранён на пакете").ЭтоИстина();

	// тег лёг на ЭТОТ пакет (пул-широкого эффекта у тегов нет по построению: сущность
	// Тег привязана к пакету, уровня пула в модели не существует)
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "poollevel") > 0,
		"тег виден в списке тегов пакета").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЧужойНеПравитТегиПакета() Экспорт

	// bob не имеет прав на alice-pkg → 403 на любую мутацию тега пакета (гвард пакета).
	Кука = Клиент.Войти("bob", "BobPassw0rd");
	Страница = "/public/alice-pkg/settings/tags";

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", "нет");
	Поля.Вставить("операция", "сохранить");
	Поля.Вставить("имя", "hack");
	Поля.Вставить("вид", "semver");
	Поля.Вставить("правило", "^1.0");
	Ожидаем.Что(Клиент.POSTФормы(Страница, Поля, Кука).КодСостояния,
		"чужой без прав: 403 на сохранение тега пакета").Равно(403);
	Поля.Вставить("операция", "удалить");
	Ожидаем.Что(Клиент.POSTФормы(Страница, Поля, Кука).КодСостояния,
		"чужой без прав: 403 на удаление тега пакета").Равно(403);

КонецПроцедуры

&Тест
Процедура АдминРазделСтрогоДляАдмина() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");

	Ожидаем.Что(Клиент.GETСКукой("/hub/settings", КукаАдмина).КодСостояния, "админ входит").Равно(200);
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings/users", КукаАдмина).КодСостояния, "список пользователей").Равно(200);
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings", КукаАлисы).КодСостояния, "не-админу отказ").Равно(403);

	// управление квотой пула (мутация админа под CSRF)
	СтрПулов = Тело(Клиент.GETСКукой(АдресПулов(), КукаАдмина));
	Токен = ИзвлечьCSRF(СтрПулов);
	ИдПула = ИдПулаИзОбзора(СтрПулов, "public");
	Ожидаем.Что(УспехМутации(ПостКвотыХаба(КукаАдмина, Токен, ИдПула, "777")), "квота сохранена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(АдресПулов(), КукаАдмина)), "777") > 0,
		"новая квота отображается").ЭтоИстина();

	// Вход к квоте из настроек хаба судит право СВОИМ гвардом, а не только гейтом дома.
	// Адрес — раздел «Пулы»: раздел «Квоты» упразднён, и POST по нему проверял бы
	// несуществующую точку (семантический конфликт мержа, а не текстовый).
	Ожидаем.Что(Клиент.POSTФормы(АдресПулов(), ПоляКвоты(Токен, ИдПула, "1"), КукаАлисы).КодСостояния,
		"не-админ квоту в админке не меняет").Равно(403);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(АдресПулов(), КукаАдмина)), "777") > 0,
		"и значение в базе осталось прежним").ЭтоИстина();

КонецПроцедуры

// Проба почты доходит до администратора обеими половинами: кнопка есть на странице,
// а нажатие попадает в пульт пробы, а не в общий разбор «сохранить значения раздела».
&Тест
Процедура РазделПочтыПредлагаетПробуИОтвечаетНаНеё() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	Страница = Тело(Клиент.GETСКукой(АдресПочты(), КукаАдмина));
	Ожидаем.Что(СтрНайти(Страница, "Отправить проверочное письмо") > 0,
		"в разделе «Почта» есть кнопка пробы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "Письмо уйдёт на адрес вашей учётной записи") > 0,
		"и страница называет получателя, а поля «кому» не предлагает").ЭтоИстина();

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Страница));
	Поля.Вставить("операция", "проба-почты");
	Ответ = Клиент.POSTФормы(АдресПочты(), Поля, КукаАдмина);

	// почта стенда не настроена — ждём именно отказ пробы, а не «неизвестная операция»:
	// вторым текстом отвечает общий разбор раздела, до которого нажатие доходило бы,
	// не будь пульт пробы включён в дом
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Отправка почты не настроена") > 0,
		"нажатие разобрал пульт пробы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Неизвестная операция раздела") = 0,
		"и операция не провалилась в общий разбор значений").ЭтоИстина();

КонецПроцедуры

#Область ПриглашенияУчёток

// Полный цикл глазами обоих участников: админ заводит закрытую учётку и получает ссылку,
// человек по ссылке задаёт пароль и входит логином. Ссылка после этого мертва.
&Тест
Процедура АдминПриглашаетЧеловекСтавитПарольИВходит() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Логин = "invited1";

	Страница = Тело(Клиент.GETСКукой(АдресПользователей(), КукаАдмина));
	Ответ = Клиент.POSTФормы(АдресПользователей(),
		ПоляСозданияУчётки(ИзвлечьCSRF(Страница), Логин, Логин + "@ex.com", "user"), КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "учётка заведена").Равно(200);

	Ссылка = ИзвлечьЗначениеПриглашения(Тело(Ответ));
	Ожидаем.Что(ЗначениеЗаполнено(Ссылка), "ссылка показана один раз прямо в ответе").ЭтоИстина();

	// до установки пароля учётка закрыта: вход не пускает
	Ожидаем.Что(ЗначениеЗаполнено(Клиент.Войти(Логин, "Invited1Passw0rd")),
		"закрытая учётка не пускает").ЭтоЛожь();

	ФормаПароля = Клиент.GET("/invite?token=" + Ссылка);
	Ожидаем.Что(ФормаПароля.КодСостояния, "аноним видит форму установки пароля").Равно(200);
	ТелоФормыПароля = Тело(ФормаПароля);
	Ожидаем.Что(СтрНайти(ТелоФормыПароля, Логин) > 0,
		"и форма называет учётную запись").ЭтоИстина();

	// требования к паролю названы прямо у поля: словами — для человека, кодом — для
	// живой проверки по мере набора
	Ожидаем.Что(СтрНайти(ТелоФормыПароля, "data-pwreq=""пароль""") > 0,
		"подсказка привязана к полю нового пароля").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоФормыПароля, "длина от 8 до 256 символов") > 0,
		"действующая политика напечатана словами").ЭтоИстина();

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/invite",
		ПоляПароля(Ссылка, "Invited1Passw0rd"), "")), "пароль принят").ЭтоИстина();

	Ожидаем.Что(ЗначениеЗаполнено(Клиент.Войти(Логин, "Invited1Passw0rd")),
		"после установки человек входит логином и паролем").ЭтоИстина();

	Повтор = Клиент.GET("/invite?token=" + Ссылка);
	Ожидаем.Что(Повтор.КодСостояния, "использованная ссылка мертва").Равно(410);

КонецПроцедуры

// «Сбросить пароль» выпускает новую ссылку и гасит прежнюю: две живые ссылки на одну
// учётку означали бы, что отозванное приглашение продолжает открывать вход.
&Тест
Процедура СбросПароляГаситПрежнююСсылку() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Логин = "invited2";

	Страница = Тело(Клиент.GETСКукой(АдресПользователей(), КукаАдмина));
	Первая = ИзвлечьЗначениеПриглашения(Тело(Клиент.POSTФормы(АдресПользователей(),
		ПоляСозданияУчётки(ИзвлечьCSRF(Страница), Логин, "", "user"), КукаАдмина)));
	Ожидаем.Что(ЗначениеЗаполнено(Первая), "первая ссылка выпущена").ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(АдресПользователей() + "?q=" + Логин, КукаАдмина));
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Список));
	Поля.Вставить("операция", "сброс");
	Поля.Вставить("пользователь", ИдПользователяИзСписка(Список));
	Вторая = ИзвлечьЗначениеПриглашения(Тело(Клиент.POSTФормы(АдресПользователей(), Поля, КукаАдмина)));

	Ожидаем.Что(ЗначениеЗаполнено(Вторая), "вторая ссылка выпущена").ЭтоИстина();
	Ожидаем.Что(Вторая = Первая, "и это другая ссылка").ЭтоЛожь();
	Ожидаем.Что(Клиент.GET("/invite?token=" + Первая).КодСостояния, "прежняя ссылка мертва").Равно(410);
	Ожидаем.Что(Клиент.GET("/invite?token=" + Вторая).КодСостояния, "новая работает").Равно(200);

КонецПроцедуры

// Заведение учётки живёт ОКНОМ поверх списка — вместе с выбором роли, который владелец
// назвал прямо. У окна серверная дорога, а отбитая форма возвращается в него же.
&Тест
Процедура ФормаЗаведенияУчёткиЖивётВОкнеИВозвращаетсяВНегоЖе() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	Закрытая = Тело(Клиент.GETСКукой(АдресПользователей(), КукаАдмина));
	Ожидаем.Что(СтрНайти(Закрытая, "<dialog class=""modal""") > 0,
		"форма заведения — модальное окно").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Закрытая, ОкноЗаведенияУчётки()) > 0,
		"и окно названо заведением пользователя").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Закрытая, ОкноЗаведенияУчётки() + " open>"),
		"по умолчанию окно закрыто").Равно(0);

	// выбор роли — часть формы заведения, а не отдельного экрана
	Окно = ОкноПоМетке(Закрытая, ОкноЗаведенияУчётки());
	Ожидаем.Что(СтрНайти(Окно, "<select") > 0, "роль выбирается прямо в окне").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "Роль на хабе") > 0, "и подписана словами").ЭтоИстина();

	Открытая = Тело(Клиент.GETСКукой(АдресПользователей() + "?form=1", КукаАдмина));
	Ожидаем.Что(СтрНайти(Открытая, ОкноЗаведенияУчётки() + " open>") > 0,
		"адрес с form=1 открывает окно заведения").ЭтоИстина();

	// логин занят: отказ домена метит логин и не съедает набранный email
	Отбитая = Тело(Клиент.POSTФормы(АдресПользователей(),
		ПоляСозданияУчётки(ИзвлечьCSRF(Закрытая), "bob", "bob-dubl@ex.com", "user"), КукаАдмина));

	Ожидаем.Что(СтрНайти(Отбитая, ОкноЗаведенияУчётки() + " open>") > 0,
		"отбитая форма вернулась ТЕМ ЖЕ окном — открытым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ОкноПоМетке(Отбитая, ОкноЗаведенияУчётки()), "aria-invalid=""true""") > 0,
		"отбитое поле помечено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отбитая, "value=""bob-dubl@ex.com""") > 0,
		"набранное в соседнем поле не съедено").ЭтоИстина();

КонецПроцедуры

// Мусорная ссылка не открывает формы и не рассказывает о существовании учёток.
&Тест
Процедура НеизвестнаяСсылкаОтдаётОтказБезФормы() Экспорт

	Ответ = Клиент.GET("/invite?token=oshub_inv_999999_нетакого");

	Ожидаем.Что(Ответ.КодСостояния, "неизвестная ссылка").Равно(404);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "name=""пароль"""), "формы установки пароля нет").Равно(0);

КонецПроцедуры

// Заведение учётки — админская мутация: чужому 403, без CSRF 403, и в обоих случаях
// учётки не появляется.
&Тест
Процедура ЗаведениеУчёткиТребуетАдминаИCSRF() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(АдресПользователей(), КукаАдмина)));

	Ожидаем.Что(Клиент.POSTФормы(АдресПользователей(),
		ПоляСозданияУчётки(Токен, "byalice", "", "admin"), КукаАлисы).КодСостояния,
		"не-админ учёток не заводит").Равно(403);

	Ожидаем.Что(Клиент.POSTФормы(АдресПользователей(),
		ПоляСозданияУчётки("подделка", "bycsrf", "", "user"), КукаАдмина).КодСостояния,
		"без верного CSRF — отказ").Равно(403);

	Список = Тело(Клиент.GETСКукой(АдресПользователей(), КукаАдмина));
	Ожидаем.Что(СтрНайти(Список, "byalice"), "учётка чужого не появилась").Равно(0);
	Ожидаем.Что(СтрНайти(Список, "bycsrf"), "учётка мимо CSRF не появилась").Равно(0);

КонецПроцедуры

// Строка приглашённого в списке: плашка «нечем войти» и НЕТ кнопки «Разблокировать» —
// домен такую активацию не примет, и предлагать её значило бы обещать несбыточное.
// Контроль — строка обычного активного пользователя: у неё всё наоборот, поэтому
// проверка не зеленеет сама собой.
&Тест
Процедура СтрокаПриглашённогоНеПредлагаетРазблокировку() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Логин = "invited3";

	Страница = Тело(Клиент.GETСКукой(АдресПользователей(), КукаАдмина));
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(АдресПользователей(),
		ПоляСозданияУчётки(ИзвлечьCSRF(Страница), Логин, "", "user"), КукаАдмина)),
		"учётка приглашена").ЭтоИстина();

	// маркер ячейкой, а не логином: первым его встречает поле формы отбора над таблицей
	Строка_ = СтрокаТаблицыС(Тело(Клиент.GETСКукой(АдресПользователей() + "?q=" + Логин, КукаАдмина)),
		">" + Логин + "<");

	Ожидаем.Что(СтрНайти(Строка_, "нечем войти") > 0,
		"плашка называет причину закрытой учётки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка_, "Разблокировать"),
		"кнопки разблокировки у неё нет").Равно(0);
	Ожидаем.Что(СтрНайти(Строка_, "Сбросить пароль") > 0,
		"а выпуск ссылки предлагается").ЭтоИстина();

	// контроль: у активного пользователя ровно обратное
	Контрольная = СтрокаТаблицыС(Тело(Клиент.GETСКукой(АдресПользователей() + "?q=bob", КукаАдмина)),
		">bob<");
	Ожидаем.Что(СтрНайти(Контрольная, "Заблокировать") > 0,
		"у активного кнопка блокировки на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Контрольная, "нечем войти"),
		"и плашки закрытой учётки у него нет").Равно(0);

КонецПроцедуры

// Нераспознанная операция формы отказывает, а не переключает активность молчком:
// подделанное поле не должно попадать в ветку «всё остальное».
&Тест
Процедура НеизвестнаяОперацияРазделаОтказываетИНичегоНеМеняет() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Список = Тело(Клиент.GETСКукой(АдресПользователей() + "?q=bob", КукаАдмина));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Список));
	Поля.Вставить("операция", "чего-нибудь");
	Поля.Вставить("пользователь", ИдПользователяИзСписка(Список));

	Ответ = Клиент.POSTФормы(АдресПользователей(), Поля, КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "неизвестное действие — отказ").Равно(400);

	Строка_ = СтрокаТаблицыС(Тело(Клиент.GETСКукой(АдресПользователей() + "?q=bob", КукаАдмина)), ">bob<");
	Ожидаем.Что(СтрНайти(Строка_, "Заблокировать") > 0,
		"активность bob не тронута").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

// Роль пула на карточке обзора главной: у основного пула — плашка «Основной» (ради такой
// информации плашки и заведены), проектного типа не печатается никакой. Этот засев имеет
// основной пул (public — имя сида), поэтому плашке есть на чём появиться.
&Тест
Процедура КарточкаОсновногоПулаНаГлавнойНесётПлашкуОсновного() Экспорт

	Стр = Тело(Клиент.GET("/"));

	Ожидаем.Что(СтрНайти(Стр, "Пулы хаба") > 0, "предпосылка: обзор пулов на главной").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "href=""/public""") > 0, "и карточка основного пула в нём").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Стр, "Основной") > 0, "у основного пула плашка роли есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "Проектный"), "а плашки проектного типа нет").Равно(0);

КонецПроцедуры

// Второе место той же плашки: колонка признаков раздела «Пулы». У проектного пула тип
// ничего не сообщает и плашки не получает, у личного пространства плашка на месте —
// оба вида пулов в одной выдаче, отличает их ровно тип.
&Тест
Процедура КолонкаПризнаковПуловХабаБезПроектногоНоСЛичным() Экспорт

	Стр = Тело(Клиент.GETСКукой(АдресПулов(), Клиент.Войти("root", "RootPassw0rd")));

	Ожидаем.Что(СтрНайти(Стр, ">public<") > 0, "предпосылка: проектный пул в выдаче").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, ">bob<") > 0, "предпосылка: личное пространство в выдаче").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Стр, "Проектный"), "плашки проектного типа нет").Равно(0);
	Ожидаем.Что(СтрНайти(Стр, "Пользовательский") > 0,
		"плашка личного пространства на месте").ЭтоИстина();

	// Признаки, которых владелец ждёт в таблице: видимость и основной пул. Ячейка плашки
	// ЦЕЛИКОМ, а не «на странице есть слово»: слова «Основной пул хаба» печатает соседняя
	// секция, и проверка на подстроку была бы вечнозелёной (доказано мутацией).
	Ожидаем.Что(СтрНайти(Стр, ">Основной</span>") > 0, "плашка основного пула в таблице").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, ">Публичный</span>") > 0, "плашка видимости в таблице").ЭтоИстина();

КонецПроцедуры

// Число на главной осталось одно — оговорка «Показаны N из M» в обзоре пулов, и оно
// обязано считаться по срезу смотрящего: иначе по приросту M анонимный наблюдатель узнаёт,
// что в хабе завели приватный пул. Замер до/после, поэтому порядку тестов безразличен.
&Тест
Процедура ЧислоОбзораПуловНеРастётАнонимуОтПриватногоПула() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	ЗавестиПулыДоОговорки(Кука);

	АнонимДо = ЧислоПуловИзОговорки(Тело(Клиент.GET("/")), "аноним до");
	АдминДо = ЧислоПуловИзОговорки(Тело(Клиент.GETСКукой("/", Кука)), "админ до");

	Скрытый = УникальныеИмена.Имя("hidden");
	Ожидаем.Что(УспехМутации(ЗавестиПул(Кука, Скрытый, "private")),
		"приватный пул заведён").ЭтоИстина();

	Ожидаем.Что(ЧислоПуловИзОговорки(Тело(Клиент.GET("/")), "аноним после"),
		"приватный пул не поднял число пулов анониму").Равно(АнонимДо);
	Ожидаем.Что(ЧислоПуловИзОговорки(Тело(Клиент.GETСКукой("/", Кука)), "админ после"),
		"а тому, кто его видит, поднял ровно на один").Равно(АдминДо + 1);

КонецПроцедуры

// Форма квот дома «Хаб» читала квоту терпимо (ЧислоИлиНоль): опечатка «5oo» превращалась
// в ноль, то есть «без лимита», и админ видел «сохранено». Тот же мусор, что уже отбивают
// дом настроек пула и PATCH API, обязан отбиваться и здесь — вердикт у всех троих один.
&Тест
Процедура АдминФормаКвотНеГлотаетОпечатку() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	СтрПулов = Тело(Клиент.GETСКукой(АдресПулов(), КукаАдмина));
	Токен = ИзвлечьCSRF(СтрПулов);
	ИдПула = ИдПулаИзОбзора(СтрПулов, "public");

	Ожидаем.Что(УспехМутации(ПостКвотыХаба(КукаАдмина, Токен, ИдПула, "512")),
		"исходная квота выставлена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(АдресПулов(), КукаАдмина)), "512") > 0,
		"исходная квота видна на странице").ЭтоИстина();

	Для Каждого Плохое Из СтрРазделить("5oo|-5|999999999999999999999|1000000000001| ", "|") Цикл
		Ответ = ПостКвотыХаба(КукаАдмина, Токен, ИдПула, Плохое);
		Ожидаем.Что(Ответ.КодСостояния,
			СтрШаблон("форма хаба отвергает квоту ""%1"" → 400, а не «сохранено»", Плохое)).Равно(400);
		Ожидаем.Что(СтрНайти(Тело(Ответ), "НЕ изменена") > 0,
			"сказано, что квота не менялась").ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(АдресПулов(), КукаАдмина)), "512") > 0,
		"ни один отказ квоту не тронул").ЭтоИстина();

	// КОНТРОЛЬ: годная квота по-прежнему сохраняется, в том числе значимый ноль
	Ожидаем.Что(УспехМутации(ПостКвотыХаба(КукаАдмина, Токен, ИдПула, "0")),
		"нулевая квота принята").ЭтоИстина();

КонецПроцедуры

Функция ПостКвотыХаба(Знач Кука, Знач Токен, Знач ИдПула, Знач Значение)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "пул-квота");
	Поля.Вставить("pool", Формат(ИдПула, "ЧГ=0"));
	Поля.Вставить("квота_мб", Значение);
	Поля.Вставить("видимость", "public");
	Возврат Клиент.POSTФормы(АдресПулов(), Поля, Кука);
КонецФункции

&Тест
Процедура PATМенеджерВыпускИОтзыв() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/me/settings/tokens", Кука)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("чтение", "1");
	Поля.Вставить("запись", "1");
	Поля.Вставить("срок_дней", "30");
	ОтветВыпуск = Клиент.POSTФормы("/me/settings/tokens", Поля, Кука);
	Ожидаем.Что(ОтветВыпуск.КодСостояния).Равно(200);
	ТелоВыпуска = Тело(ОтветВыпуск);
	Секрет = ИзвлечьСекрет(ТелоВыпуска);
	Ожидаем.Что(СтрНачинаетсяС(Секрет, "oshub_"), "секрет показан один раз").ЭтоИстина();

	// список НЕ раскрывает секрет
	ТелоСписка = Тело(Клиент.GETСКукой("/me/settings/tokens", Кука));
	Ожидаем.Что(СтрНайти(ТелоСписка, Секрет), "секрет не в списке").Равно(0);

	// отзыв токена
	ИдТокена = ИзвлечьИдТокена(ТелоСписка);
	Ожидаем.Что(ЗначениеЗаполнено(ИдТокена), "id токена найден").ЭтоИстина();
	ТокенСписка = ИзвлечьCSRF(ТелоСписка);
	ПоляОтзыва = Новый Соответствие();
	ПоляОтзыва.Вставить("_csrf", ТокенСписка);
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/me/settings/tokens/" + ИдТокена + "/revoke", ПоляОтзыва, Кука)),
		"отзыв принят").ЭтоИстина();

КонецПроцедуры

// Форма кабинета глазами пользователя: бессрочных ключей она не выпускает вовсе,
// а отказ называет причину и не превращается ни в 500, ни в молчаливую подмену срока.
&Тест
Процедура ФормаКабинетаНеВыпускаетБессрочныйКлюч() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");
	Страница = Тело(Клиент.GETСКукой("/me/settings/tokens", Кука));
	Токен = ИзвлечьCSRF(Страница);

	Ожидаем.Что(СтрНайти(Страница, "0 — бессрочно"), "формулировки «0 — бессрочно» больше нет")
		.Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "Бессрочных токенов хаб не выпускает") > 0,
		"подсказка поля объясняет запрет").ЭтоИстина();

	ОтказНоль = Клиент.POSTФормы("/me/settings/tokens", ПоляВыпускаКлюча(Токен, "0"), Кука);
	ОтказСверхПотолка = Клиент.POSTФормы("/me/settings/tokens", ПоляВыпускаКлюча(Токен, "100000"), Кука);
	ОтказМусор = Клиент.POSTФормы("/me/settings/tokens", ПоляВыпускаКлюча(Токен, "неделя"), Кука);
	ОтказПустого = Клиент.POSTФормы("/me/settings/tokens", ПоляВыпускаКлюча(Токен, ""), Кука);
	Успех = Клиент.POSTФормы("/me/settings/tokens", ПоляВыпускаКлюча(Токен, "7"), Кука);

	Ожидаем.Что(ОтказНоль.КодСостояния, "ноль — отказ на экране, а не 500").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(ОтказНоль), "бессрочных токенов хаб не выпускает") > 0,
		"причина отказа названа (" + Тело(ОтказНоль) + ")").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(ОтказНоль), "Токен выпущен"), "ключ не выпущен").Равно(0);

	Ожидаем.Что(ОтказСверхПотолка.КодСостояния).Равно(200);
	Ожидаем.Что(СтрНайти(Тело(ОтказСверхПотолка), "от 1 до 365 дней") > 0,
		"потолок назван числом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(ОтказСверхПотолка), "Токен выпущен"), "ключ не выпущен").Равно(0);

	Ожидаем.Что(СтрНайти(Тело(ОтказМусор), "Токен выпущен"), "мусор в сроке ключа не даёт").Равно(0);

	// поле помечено обязательным в разметке — сервер требует его так же строго,
	// а не подставляет дефолт молча
	Ожидаем.Что(ОтказПустого.КодСостояния, "пустой срок — отказ на экране").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(ОтказПустого), "бессрочных токенов хаб не выпускает") > 0,
		"пустое поле отвергается той же причиной, что и ноль").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(ОтказПустого), "Токен выпущен"), "ключ не выпущен").Равно(0);

	Ожидаем.Что(СтрНайти(Тело(Успех), "Токен выпущен") > 0, "срок 7 дней принят").ЭтоИстина();
	Ожидаем.Что(СтрНачинаетсяС(ИзвлечьСекрет(Тело(Успех)), "oshub_"), "секрет показан").ЭтоИстина();

КонецПроцедуры

// Ключи, выпущенные до запрета бессрочных, живут до отзыва владельцем: задним числом
// хаб их не гасит, но и за обычные не выдаёт — в таблице у них честная пометка.
// Такой ключ кладёт в базу сидер scripts/сидеры/ЗасеятьКабинет.os: продуктом его уже не завести.
&Тест
Процедура ЛегасиВечныйКлючПускаетИПомеченВТаблице() Экспорт

	Кука = Клиент.Войти("legacy", "LegacyPassw0rd");
	Страница = Тело(Клиент.GETСКукой("/me/settings/tokens", Кука));

	Ожидаем.Что(СтрНайти(Страница, "легаси-вечный") > 0, "легаси-ключ виден в кабинете").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "бессрочно — выпущен до запрета, отзовите") > 0,
		"пустой срок назван своим именем, а не прочерком").ЭтоИстина();

	Ид = Клиент.ПослеМаркера(Сред(Страница, СтрНайти(Страница, "легаси-вечный")),
		"/me/settings/tokens/", "/revoke");
	Ожидаем.Что(ЗначениеЗаполнено(Ид), "идентификатор легаси-ключа найден на странице").ЭтоИстина();

	// 403 «ключ не выпускает ключи» приходит только ОПОЗНАННОМУ ключу: анониму здесь 401
	ПоЛегаси = Клиент.GETСТокеном("/api/v1/tokens", "oshub_" + Ид + "_" + СекретЛегасиКлюча());
	ПоПодделке = Клиент.GETСТокеном("/api/v1/tokens", "oshub_" + Ид + "_wrongsecret");

	Ожидаем.Что(ПоЛегаси.КодСостояния,
		"старый вечный ключ по-прежнему пускают в API").Равно(403);
	Ожидаем.Что(СтрНайти(Тело(ПоЛегаси), "token_cannot_manage_tokens") > 0,
		"отказ ключу как ключу, а не как анониму (" + Тело(ПоЛегаси) + ")").ЭтоИстина();
	Ожидаем.Что(ПоПодделке.КодСостояния, "подделанный секрет того же ключа — 401").Равно(401);

КонецПроцедуры

// Секрет легаси-ключа задан сидером ЗасеятьКабинет.os — без него значение не собрать.
Функция СекретЛегасиКлюча()
	Возврат "legacyeternalsecret00000000000000000000000000000000";
КонецФункции

Функция ПоляВыпускаКлюча(Знач Токен, Знач Срок)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("имя", "срок " + Срок);
	Поля.Вставить("чтение", "1");
	Поля.Вставить("срок_дней", Срок);
	Возврат Поля;
КонецФункции

// Рамки токена задаются В ФОРМЕ: человек отбирает пулы в окне подбора и получает ключ,
// который в отмеченных пулах работает, а в третьем — нет. До этого привязка была только
// у API, а форма жёстко выпускала ключ на весь хаб.
&Тест
Процедура ФормаКабинетаВыпускаетТокенСНаборомПулов() Экспорт

	Кука = ВойтиRoot();
	Первый = ЗавестиПриватныйПул(Кука);
	Второй = ЗавестиПриватныйПул(Кука);
	Третий = ЗавестиПриватныйПул(Кука);

	Страница = Тело(Клиент.GETСКукой("/me/settings/tokens", Кука));
	ТокенCSRF = ИзвлечьCSRF(Страница);

	ПервыйВОкне = ОкноПодбораПулов(Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляПоискаПулов(ТокенCSRF, "ключ-набора", Первый.Имя, Новый Массив()), Кука)));
	ТретийВОкне = ОкноПодбораПулов(Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляПоискаПулов(ТокенCSRF, "ключ-набора", Третий.Имя, Новый Массив()), Кука)));
	Ожидаем.Что(СтрНайти(ПервыйВОкне, ОтметкаПула(Первый)) > 0,
		"пул предложен флажком в окне подбора").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТретийВОкне, ОтметкаПула(Третий)) > 0,
		"и третий тоже — отбирает человек, а не сервер").ЭтоИстина();

	Пары = ПоляЗаявкиТокена(ТокенCSRF, "ключ-набора", "", Идентификаторы(Первый, Второй));

	Выпуск = Клиент.POSTФормы("/me/settings/tokens", Пары, Кука);
	Ожидаем.Что(Выпуск.КодСостояния).Равно(200);
	Ключ = ИзвлечьСекрет(Тело(Выпуск));
	Ожидаем.Что(СтрНачинаетсяС(Ключ, "oshub_"), "ключ выпущен и показан один раз").ЭтоИстина();

	// перечисление пулов — та поверхность, где рамки ключа реально судят выдачу
	ПоКлючу = Тело(Клиент.GETСТокеном("/api/v1/pools?pageSize=200", Ключ));
	Ожидаем.Что(СтрНайти(ПоКлючу, Первый.Имя) > 0, "первый отмеченный пул ключу виден").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПоКлючу, Второй.Имя) > 0,
		"второй отмеченный пул тоже — рамка это НАБОР, а не один пул").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПоКлючу, Третий.Имя), "неотмеченный пул ключу закрыт").Равно(0);

	// КОНТРОЛЬ: сессией тот же человек видит третий пул — дело в рамках ключа, а не в правах
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/api/v1/pools?pageSize=200", Кука)), Третий.Имя) > 0,
		"КОНТРОЛЬ: сессией третий пул виден").ЭтоИстина();

	// операции уровня хаба привязанному ключу недоступны тем более
	Хабовое = Клиент.POSTJSONСТокеном("/api/v1/pools",
		СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", ИмяНовогоПула()), Ключ);
	Ожидаем.Что(Хабовое.КодСостояния, "ключ с рамками не заводит пулы на хабе").Равно(403);

	// список кабинета называет рамки словами, а не идентификаторами
	Строка_ = СтрокаТокенаПоИмени(Тело(Клиент.GETСКукой("/me/settings/tokens", Кука)), "ключ-набора");
	Ожидаем.Что(СтрНайти(Строка_, Первый.Имя) > 0, "в списке названо имя первого пула").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка_, Второй.Имя) > 0, "и второго").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка_, Третий.Имя), "чужой пул в строку не попал").Равно(0);
	Ожидаем.Что(СтрНайти(Строка_, "чтение, запись") > 0, "области названы словами формы").ЭтоИстина();

КонецПроцедуры

// Форма первого показа не должна предлагать НИ ОДНОГО пула: на инсталляции с сотнями
// пулов это была стена флажков. И ни один из них не смеет приехать отмеченным — иначе
// человек, поверивший подсказке «токен действует на весь хаб», молча выпустил бы ключ,
// привязанный к пулам.
&Тест
Процедура СвежаяФормаТокеновНеПредлагаетПуловИНичегоНеОтмечает() Экспорт

	Кука = ВойтиRoot();
	Пул = ЗавестиПриватныйПул(Кука);

	Страница = Тело(Клиент.GETСКукой("/me/settings/tokens", Кука));
	ФормаВыпуска = ФормаВыпускаТокена(Страница);

	Ожидаем.Что(СтрНайти(ФормаВыпуска, "name=""пулы"""),
		"свежая форма списка пулов не показывает вовсе").Равно(0);
	Ожидаем.Что(СтрНайти(ФормаВыпуска, Пул.Имя), "и имени пула на ней нет").Равно(0);
	Ожидаем.Что(ОтмеченныхПулов(ФормаВыпуска),
		"ни один пул не приехал отмеченным (" + ФормаВыпуска + ")").Равно(0);

	Ожидаем.Что(СтрНайти(ФормаВыпуска, "Весь хаб") > 0,
		"состояние по умолчанию названо словами").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ФормаВыпуска, "Выбрать пулы") > 0,
		"сужение — отдельное действие на форме").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "<dialog"), "окно подбора закрыто").Равно(0);

КонецПроцедуры

// Свежеоткрытое окно подбора предлагает пулы, но ни одного не отмечает: отметка — дело
// человека. Здесь же виден путь целиком: открыть подбор, сузить поиском, отметить,
// применить и выпустить ключ ровно на отмеченный пул.
&Тест
Процедура ПодборПуловСужаетсяПоискомИДаётКлючРовноНаОтмеченный() Экспорт

	Кука = ВойтиRoot();
	Искомый = ЗавестиПриватныйПул(Кука);
	Соседний = ЗавестиПриватныйПул(Кука);
	ТокенCSRF = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/me/settings/tokens", Кука)));

	Страница = Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляЗаявкиТокена(ТокенCSRF, "ключ-подбора", ОперацияПодбора(), Новый Массив()), Кука));
	Окно = ОкноПодбораПулов(Страница);
	Ожидаем.Что(ОтмеченныхПулов(Окно),
		"свежий подбор не отмечает ничего сам (" + Окно + ")").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "value=""ключ-подбора""") > 0,
		"набранное имя доехало до окна и не потеряно").ЭтоИстина();

	Найдено = ОкноПодбораПулов(Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляПоискаПулов(ТокенCSRF, "ключ-подбора", Искомый.Имя, Новый Массив()), Кука)));
	Ожидаем.Что(СтрНайти(Найдено, ОтметкаПула(Искомый)) > 0,
		"поиск по подстроке нашёл искомый пул (" + Найдено + ")").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Найдено, ОтметкаПула(Соседний)),
		"и убрал из окна всё остальное").Равно(0);

	Применено = Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляЗаявкиТокена(ТокенCSRF, "ключ-подбора", ОперацияПрименения(),
			Идентификаторы(Искомый)), Кука));
	Ожидаем.Что(СтрНайти(Применено, "<dialog"), "применение закрыло окно").Равно(0);
	ФормаВыпуска = ФормаВыпускаТокена(Применено);
	Ожидаем.Что(СтрНайти(ФормаВыпуска, Искомый.Имя) > 0,
		"выбранный пул назван на форме словами (" + ФормаВыпуска + ")").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ФормаВыпуска, ФлажокПула(Искомый) + " checked") > 0,
		"и стоит отмеченным — снять его можно по одному").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ФормаВыпуска, Соседний.Имя), "лишних пулов на форме нет").Равно(0);

	Ключ = ИзвлечьСекрет(Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляЗаявкиТокена(ТокенCSRF, "ключ-подбора", "", Идентификаторы(Искомый)), Кука)));
	ПоКлючу = Тело(Клиент.GETСТокеном("/api/v1/pools?pageSize=200", Ключ));
	Ожидаем.Что(СтрНайти(ПоКлючу, Искомый.Имя) > 0, "ключ работает в отмеченном пуле").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПоКлючу, Соседний.Имя), "и не работает в неотмеченном").Равно(0);

КонецПроцедуры

// Поиск в окне — серверный, и он обязан ПОМНИТЬ отмеченное: иначе набор пулов нельзя
// собрать из двух поисков, а человек теряет отметку, не понимая, куда она делась.
&Тест
Процедура ПоискВОкнеПодбораНеТеряетУжеОтмеченное() Экспорт

	Кука = ВойтиRoot();
	Отмеченный = ЗавестиПриватныйПул(Кука);
	Искомый = ЗавестиПриватныйПул(Кука);
	ТокенCSRF = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/me/settings/tokens", Кука)));

	Найдено = ОкноПодбораПулов(Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляПоискаПулов(ТокенCSRF, "ключ-двух-поисков", Искомый.Имя,
			Идентификаторы(Отмеченный)), Кука)));

	Ожидаем.Что(СтрНайти(Найдено, ОтметкаПула(Искомый)) > 0,
		"поиск нашёл второй пул").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Найдено, ОтметкаПула(Отмеченный)),
		"первый пул выдачей поиска не является").Равно(0);
	Ожидаем.Что(СтрНайти(Найдено, СкрытыйПул(Отмеченный)) > 0,
		"но отметка на нём пережила поиск скрытым полем (" + Найдено + ")").ЭтоИстина();

	// набор из двух пулов, собранный за два поиска, доезжает до выпуска целиком
	Применено = Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляЗаявкиТокена(ТокенCSRF, "ключ-двух-поисков", ОперацияПрименения(),
			Идентификаторы(Отмеченный, Искомый)), Кука));
	ФормаВыпуска = ФормаВыпускаТокена(Применено);
	Ожидаем.Что(СтрНайти(ФормаВыпуска, Отмеченный.Имя) > 0, "первый пул в наборе").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ФормаВыпуска, Искомый.Имя) > 0, "и второй тоже").ЭтоИстина();

КонецПроцедуры

// Пул снимается с формы по одному — снятой отметкой. Ключ выпускается по тому, что
// осталось отмеченным, а не по тому, что человек когда-то выбрал в окне.
&Тест
Процедура ОтмеченныйПулСнимаетсяСФормыПоОдному() Экспорт

	Кука = ВойтиRoot();
	Оставленный = ЗавестиПриватныйПул(Кука);
	Снятый = ЗавестиПриватныйПул(Кука);
	ТокенCSRF = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/me/settings/tokens", Кука)));

	Применено = Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляЗаявкиТокена(ТокенCSRF, "ключ-снятия", ОперацияПрименения(),
			Идентификаторы(Оставленный, Снятый)), Кука));
	ФормаВыпуска = ФормаВыпускаТокена(Применено);
	Ожидаем.Что(СтрНайти(ФормаВыпуска, ФлажокПула(Снятый) + " checked") > 0,
		"оба пула на форме отмечены").ЭтоИстина();

	// браузер не отправляет снятый флажок — так выглядит «убрал пул из набора»
	Ключ = ИзвлечьСекрет(Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляЗаявкиТокена(ТокенCSRF, "ключ-снятия", "", Идентификаторы(Оставленный)), Кука)));

	Строка_ = СтрокаТокенаПоИмени(Тело(Клиент.GETСКукой("/me/settings/tokens", Кука)), "ключ-снятия");
	Ожидаем.Что(СтрНайти(Строка_, Оставленный.Имя) > 0,
		"оставленный пул в рамках ключа (" + Строка_ + ")").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка_, Снятый.Имя), "а снятый — нет").Равно(0);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСТокеном("/api/v1/pools?pageSize=200", Ключ)), Снятый.Имя),
		"снятый пул ключу и правда закрыт").Равно(0);

КонецПроцедуры

// Ключ на весь хаб — тот же экран без единого отмеченного пула: рамок нет, и список
// обязан сказать это словами, а не пустой ячейкой.
&Тест
Процедура ТокенБезОтмеченныхПуловДействуетНаВесьХабИТакИНазван() Экспорт

	Кука = Клиент.Войти("bob", "BobPassw0rd");
	ТокенCSRF = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/me/settings/tokens", Кука)));

	Пары = Новый Массив();
	Пары.Добавить(Пара("_csrf", ТокенCSRF));
	Пары.Добавить(Пара("имя", "ключ-всего-хаба"));
	Пары.Добавить(Пара("чтение", "1"));
	Пары.Добавить(Пара("срок_дней", "30"));

	Выпуск = Клиент.POSTФормы("/me/settings/tokens", Пары, Кука);
	Ожидаем.Что(Выпуск.КодСостояния).Равно(200);
	Ключ = ИзвлечьСекрет(Тело(Выпуск));

	Ожидаем.Что(Клиент.GETСТокеном("/api/v1/pools/public", Ключ).КодСостояния,
		"ключ без рамок читает пул хаба").Равно(200);

	Строка_ = СтрокаТокенаПоИмени(Тело(Клиент.GETСКукой("/me/settings/tokens", Кука)), "ключ-всего-хаба");
	Ожидаем.Что(СтрНайти(Строка_, "весь хаб") > 0,
		"отсутствие рамок названо словами (" + Строка_ + ")").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка_, "чтение") > 0, "область названа словом формы").ЭтоИстина();

КонецПроцедуры

// Токен без единой области ничего не может, поэтому и не выпускается. Отказ обязан
// назвать причину и вернуть форму в том виде, в каком её отправили: иначе человек
// набирает имя, срок и пулы заново.
&Тест
Процедура ФормаКабинетаОтвергаетВыпускБезОбластей() Экспорт

	Кука = ВойтиRoot();
	Пул = ЗавестиПриватныйПул(Кука);
	ТокенCSRF = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/me/settings/tokens", Кука)));

	Пары = Новый Массив();
	Пары.Добавить(Пара("_csrf", ТокенCSRF));
	Пары.Добавить(Пара("имя", "ключ-без-областей"));
	Пары.Добавить(Пара("пулы", Пул.Ид));
	Пары.Добавить(Пара("срок_дней", "17"));

	Отказ = Клиент.POSTФормы("/me/settings/tokens", Пары, Кука);
	Разметка = Тело(Отказ);

	Ожидаем.Что(Отказ.КодСостояния, "отказ показан на экране, а не 500").Равно(200);
	Ожидаем.Что(СтрНайти(Разметка, "Отметьте хотя бы одну область") > 0,
		"причина названа (" + Разметка + ")").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "Токен выпущен"), "ключ не выпущен").Равно(0);

	Ожидаем.Что(СтрНайти(Разметка, "value=""ключ-без-областей""") > 0,
		"имя не потеряно").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, "value=""17""") > 0, "срок не потерян").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка, ФлажокПула(Пул) + " checked") > 0,
		"отмеченный пул остался отмеченным").ЭтоИстина();

	// ключа с этим именем в списке нет — отказ был отказом, а не «показали ошибку и выпустили»
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/me/settings/tokens", Кука)), ">ключ-без-областей<"),
		"ключ в списке не появился").Равно(0);

КонецПроцедуры

// Пул, которого смотрящий не видит, отвечает ему как несуществующий — даже когда его
// идентификатор угадан. Иначе перебор чисел в форме рассказывал бы о чужих пулах.
&Тест
Процедура ФормаКабинетаНеПринимаетНевидимыйПулВНабор() Экспорт

	ЧужойПул = ЗавестиПриватныйПул(ВойтиRoot());

	КукаЖертвы = Клиент.Войти("bob", "BobPassw0rd");
	Страница = Тело(Клиент.GETСКукой("/me/settings/tokens", КукаЖертвы));
	ТокенCSRF = ИзвлечьCSRF(Страница);
	Ожидаем.Что(СтрНайти(Страница, ФлажокПула(ЧужойПул)),
		"чужой приватный пул в форме не предлагается").Равно(0);

	Окно = Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляЗаявкиТокена(ТокенCSRF, "ключ-подбора", ОперацияПодбора(), Новый Массив()),
		КукаЖертвы));
	Ожидаем.Что(СтрНайти(Окно, ФлажокПула(ЧужойПул)),
		"и в окне подбора его тоже нет").Равно(0);
	Ожидаем.Что(СтрНайти(Окно, ЧужойПул.Имя), "как и его имени").Равно(0);

	Подделка = Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляПодделкиПула(ТокенCSRF, ЧужойПул.Ид), КукаЖертвы));
	Небывалый = Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляПодделкиПула(ТокенCSRF, "99999999"), КукаЖертвы));
	// подбор — та же дверь: набор сверяется до того, как окно назовёт пул по имени
	ПодделкаВОкне = Тело(Клиент.POSTФормы("/me/settings/tokens",
		ПоляЗаявкиТокена(ТокенCSRF, "ключ-подбора", ОперацияПрименения(),
			ОдинИдентификатор(ЧужойПул.Ид)), КукаЖертвы));

	Ожидаем.Что(СтрНайти(Подделка, "не найден") > 0,
		"невидимый пул отвергнут как несуществующий").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Подделка, ЧужойПул.Имя),
		"и имени чужого пула на экране нет").Равно(0);
	Ожидаем.Что(СтрНайти(Небывалый, "не найден") > 0,
		"несуществующий пул отвергнут так же").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Подделка, "Токен выпущен"), "ключ не выпущен").Равно(0);
	Ожидаем.Что(СтрНайти(ПодделкаВОкне, "не найден") > 0,
		"подбор отвергает подделку тем же ответом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПодделкаВОкне, ЧужойПул.Имя),
		"и имени чужого пула не печатает").Равно(0);

КонецПроцедуры

Функция ОдинИдентификатор(Знач Идентификатор)
	Значения = Новый Массив();
	Значения.Добавить(Идентификатор);
	Возврат Значения;
КонецФункции

Функция ПоляПодделкиПула(Знач ТокенCSRF, Знач ИдПула)

	Пары = Новый Массив();
	Пары.Добавить(Пара("_csrf", ТокенCSRF));
	Пары.Добавить(Пара("имя", "ключ-подделки"));
	Пары.Добавить(Пара("чтение", "1"));
	Пары.Добавить(Пара("пулы", ИдПула));
	Пары.Добавить(Пара("срок_дней", "30"));
	Возврат Пары;

КонецФункции

#Область ПодборПуловТокена

Функция ОперацияПодбора()
	Возврат "подбор";
КонецФункции

Функция ОперацияПоиска()
	Возврат "искать";
КонецФункции

Функция ОперацияПрименения()
	Возврат "применить";
КонецФункции

// Поля формы выпуска в том виде, в каком их отправляет браузер. Операция — нажатая
// кнопка; пустая означает «Выпустить токен».
Функция ПоляЗаявкиТокена(Знач ТокенCSRF, Знач Имя, Знач Операция, Знач Пулы)

	Пары = Новый Массив();
	Пары.Добавить(Пара("_csrf", ТокенCSRF));
	Пары.Добавить(Пара("имя", Имя));
	Пары.Добавить(Пара("чтение", "1"));
	Пары.Добавить(Пара("запись", "1"));
	Для Каждого Идентификатор Из Пулы Цикл
		Пары.Добавить(Пара("пулы", Идентификатор));
	КонецЦикла;
	Пары.Добавить(Пара("срок_дней", "30"));
	Если ЗначениеЗаполнено(Операция) Тогда
		Пары.Добавить(Пара("операция", Операция));
	КонецЕсли;
	Возврат Пары;

КонецФункции

// Отправка окна подбора кнопкой «Найти»: черновик заявки приезжает скрытыми полями,
// подстрока — полем поиска, уже отмеченное — флажками и скрытыми полями.
Функция ПоляПоискаПулов(Знач ТокенCSRF, Знач Имя, Знач Подстрока, Знач Пулы)

	Пары = ПоляЗаявкиТокена(ТокенCSRF, Имя, ОперацияПоиска(), Пулы);
	Пары.Добавить(Пара("поиск", Подстрока));
	Возврат Пары;

КонецФункции

Функция Идентификаторы(Знач Первый, Знач Второй = Неопределено)

	Результат = Новый Массив();
	Результат.Добавить(Первый.Ид);
	Если Второй <> Неопределено Тогда
		Результат.Добавить(Второй.Ид);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Флажок пула отличается от скрытого поля с тем же именем: одно человек снимает, другое
// он не видит вовсе, и сторож обязан различать их.
Функция ОтметкаПула(Знач Пул)
	Возврат СтрШаблон("class=""field__check"" name=""пулы"" value=""%1""", Пул.Ид);
КонецФункции

Функция СкрытыйПул(Знач Пул)
	Возврат СтрШаблон("type=""hidden"" name=""пулы"" value=""%1""", Пул.Ид);
КонецФункции

// Окно подбора отдельно от формы: один и тот же флажок пула может стоять и там, и там,
// и сторож обязан знать, про какой из двух он говорит.
Функция ОкноПодбораПулов(Знач Страница)

	Начало = СтрНайти(Страница, "<dialog");
	Если Начало = 0 Тогда
		ВызватьИсключение "На странице токенов нет открытого окна подбора пулов";
	КонецЕсли;

	Хвост = Сред(Страница, Начало);
	Конец = СтрНайти(Хвост, "</dialog>");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец));

КонецФункции

// Форма выпуска без окна подбора: окно — сосед формы, и «на форме пулов нет» проверяется
// по форме, а не по всей странице.
Функция ФормаВыпускаТокена(Знач Страница)

	Начало = СтрНайти(Страница, "Где действует токен");
	Если Начало = 0 Тогда
		ВызватьИсключение "На странице токенов нет группы «Где действует токен»";
	КонецЕсли;

	Хвост = Сред(Страница, Начало);
	Конец = СтрНайти(Хвост, "</form>");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец));

КонецФункции

// Сколько флажков пулов приехали отмеченными: сторож считает ЗНАЧЕНИЕ разметки,
// а не наличие слова, — иначе «checked» соседнего поля сошло бы за отметку пула.
Функция ОтмеченныхПулов(Знач Разметка)

	Найдено = 0;
	Позиция = СтрНайти(Разметка, "name=""пулы""");
	Пока Позиция > 0 Цикл
		Хвост = Сред(Разметка, Позиция);
		Поле = Лев(Хвост, СтрНайти(Хвост, ">"));
		Если СтрНайти(Поле, " checked") > 0 Тогда
			Найдено = Найдено + 1;
		КонецЕсли;
		Смещение = СтрНайти(Сред(Хвост, 2), "name=""пулы""");
		Позиция = ?(Смещение = 0, 0, Позиция + Смещение);
	КонецЦикла;
	Возврат Найдено;

КонецФункции

#КонецОбласти

// Приватный пул под рамки токена: заводится админом хаба, как это делает живой человек.
Функция ЗавестиПриватныйПул(Знач Кука)

	Имя = ИмяНовогоПула();

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Заголовки.Вставить("X-CSRF-Token", ИзвлечьCSRF(Тело(Клиент.GETСКукой("/me/settings/tokens", Кука))));
	Запрос = Новый HTTPЗапрос("/api/v1/pools", Заголовки);
	Запрос.УстановитьТелоИзСтроки(
		СтрШаблон("{""имя"":""%1"",""видимость"":""private""}", Имя), КодировкаТекста.UTF8);

	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение СтрШаблон("Пул под рамки токена не заведён (%1): %2",
			Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
	КонецЕсли;

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Разобрано = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Новый Структура("Имя, Ид", Имя,
		Формат(Разобрано.Получить("pool").Получить("id"), "ЧГ=0; ЧН=0"));

КонецФункции

// Имя пула уникально целиком, а не суффиксом-счётчиком: «scope-pool-1» лежит внутри
// «scope-pool-10», и поиск подстроки в выдаче путал бы один пул с другим.
Функция ИмяНовогоПула()
	Возврат УникальныеИмена.Имя("scope-pool");
КонецФункции

// Разметка флажка пула: имя группы и значение — идентификатор, как их отправит браузер.
Функция ФлажокПула(Знач Пул)
	Возврат СтрШаблон("name=""пулы"" value=""%1""", Пул.Ид);
КонецФункции

// Строка таблицы токенов, в которой встречается имя ключа.
Функция СтрокаТокенаПоИмени(Знач Страница, Знач ИмяКлюча)

	Позиция = СтрНайти(Страница, ">" + ИмяКлюча + "<");
	Если Позиция = 0 Тогда
		ВызватьИсключение СтрШаблон("Ключа «%1» нет в таблице токенов кабинета", ИмяКлюча);
	КонецЕсли;

	Хвост = Сред(Страница, Позиция);
	Конец = СтрНайти(Хвост, "</tr>");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец));

КонецФункции

Функция Пара(Знач Имя, Знач Значение)
	Возврат Новый Структура("Имя, Значение", Имя, Значение);
КонецФункции

&Тест
Процедура ОтзывЧужогоИНесуществующегоТокенаНеразличим404() Экспорт

	// Алиса выпускает токен и узнаёт его id.
	КукаАлисы = Клиент.Войти("alice", "AlicePassw0rd");
	ТокенАлисы = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/me/settings/tokens", КукаАлисы)));
	ПоляВыпуск = Новый Соответствие();
	ПоляВыпуск.Вставить("_csrf", ТокенАлисы);
	ПоляВыпуск.Вставить("чтение", "1");
	ПоляВыпуск.Вставить("запись", "1");
	ПоляВыпуск.Вставить("срок_дней", "30");
	Клиент.POSTФормы("/me/settings/tokens", ПоляВыпуск, КукаАлисы);
	ИдЧужого = ИзвлечьИдТокена(Тело(Клиент.GETСКукой("/me/settings/tokens", КукаАлисы)));
	Ожидаем.Что(ЗначениеЗаполнено(ИдЧужого), "id токена алисы найден").ЭтоИстина();

	// Боб пытается отозвать ЧУЖОЙ токен (принадлежит алисе) со своим валидным CSRF.
	КукаБоба = Клиент.Войти("bob", "BobPassw0rd");
	ТокенБоба = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/me/settings/tokens", КукаБоба)));
	ПоляОтзыва = Новый Соответствие();
	ПоляОтзыва.Вставить("_csrf", ТокенБоба);

	ОтветЧужой = Клиент.POSTФормы("/me/settings/tokens/" + ИдЧужого + "/revoke", ПоляОтзыва, КукаБоба);
	Ожидаем.Что(ОтветЧужой.КодСостояния).Равно(404);

	// Несуществующий токен — тем же CSRF; ответ обязан совпадать (не раскрываем существование).
	ОтветНесущ = Клиент.POSTФормы("/me/settings/tokens/999999/revoke", ПоляОтзыва, КукаБоба);
	Ожидаем.Что(ОтветНесущ.КодСостояния).Равно(404);
	Ожидаем.Что(ОтветЧужой.КодСостояния).Равно(ОтветНесущ.КодСостояния);

	// Чужой токен НЕ отозван — по-прежнему виден в кабинете алисы.
	ИдПосле = ИзвлечьИдТокена(Тело(Клиент.GETСКукой("/me/settings/tokens", КукаАлисы)));
	Ожидаем.Что(ИдПосле).Равно(ИдЧужого);

КонецПроцедуры

&Тест
Процедура ФорсированнаяСменаПароля() Экспорт

	Кука = Клиент.Войти("mustchange", "OldPassw0rd");

	// любой маршрут кабинета редиректит на смену пароля
	ОтветКаб = Клиент.GETСКукой("/me", Кука);
	Если Редирект(ОтветКаб) Тогда
		Ожидаем.Что(СтрНайти(Клиент.ЗаголовокОтвета(ОтветКаб, "Location"), "/me/settings/security") > 0, "форс-редирект на смену").ЭтоИстина();
	Иначе
		Ожидаем.Что(СтрНайти(Тело(ОтветКаб), "Текущий пароль") > 0, "показана форма смены").ЭтоИстина();
	КонецЕсли;

	// сама страница смены доступна
	СтрСмены = Тело(Клиент.GETСКукой("/me/settings/security", Кука));
	Ожидаем.Что(СтрНайти(СтрСмены, "Текущий пароль") > 0, "форма смены пароля").ЭтоИстина();
	Токен = ИзвлечьCSRF(СтрСмены);

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("старый", "OldPassw0rd");
	Поля.Вставить("новый", "NewPassw0rd1");
	Поля.Вставить("повтор", "NewPassw0rd1");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/me/settings/security", Поля, Кука)), "смена принята").ЭтоИстина();

	// после смены кабинет доступен без форс-редиректа. Судим по СОДЕРЖИМОМУ сводки —
	// пакетов у этой учётки нет, поэтому кабинет обязан показать первые шаги; навигация
	// кабинета в счёт не идёт, она одинакова на всех его страницах
	ОтветПосле = Клиент.GETСКукой("/me", Кука);
	Ожидаем.Что(ОтветПосле.КодСостояния).Равно(200);
	Ожидаем.Что(СтрНайти(Тело(ОтветПосле), "Выпустить токен публикации") > 0,
		"кабинет доступен и собран").ЭтоИстина();

КонецПроцедуры

// Смена пароля в кабинете показывает те же требования и так же живьём, что регистрация:
// список привязан к полю нового пароля и несёт коды, по которым браузер судит набираемое.
// Без скрипта страница остаётся годной — те же требования словами и отказ с причиной.
&Тест
Процедура СменаПароляПоказываетТребованияЖивьём() Экспорт

	Кука = Клиент.Войти("bob", "BobPassw0rd");
	Страница = Тело(Клиент.GETСКукой("/me/settings/security", Кука));

	Ожидаем.Что(СтрНайти(Страница, "data-pwreq=""новый""") > 0,
		"подсказка привязана к полю нового пароля").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "data-pwrule=""length""") > 0,
		"требование длины несёт код живой проверки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "data-pwmin=""8""") > 0, "минимум длины числом").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "data-pwmax=""256""") > 0, "максимум длины числом").ЭтоИстина();

	// без JavaScript та же страница называет требования словами
	Ожидаем.Что(СтрНайти(БезТеговScript(Страница), "длина от 8 до 256 символов") > 0,
		"действующая политика напечатана словами").ЭтоИстина();
	// и ровно один раз: второго перечня требований на странице нет
	Ожидаем.Что(СтрЧислоВхождений(Страница, "длина от 8 до 256 символов"),
		"перечень требований на странице один").Равно(1);

	// без скрипта форма работает, а негодный пароль сервер отвергает с причиной
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Страница));
	Поля.Вставить("старый", "BobPassw0rd");
	Поля.Вставить("новый", "abc");
	Поля.Вставить("повтор", "abc");
	Отказ = Клиент.POSTФормы("/me/settings/security", Поля, Кука);
	Ожидаем.Что(Отказ.КодСостояния, "негодный пароль отвергнут").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Отказ), "длина от 8 до 256 символов") > 0,
		"и причина названа теми же словами").ЭтоИстина();

	// пароль не сменился: прежний по-прежнему пускает
	Ожидаем.Что(ЗначениеЗаполнено(Клиент.Войти("bob", "BobPassw0rd")),
		"отвергнутая смена пароль не тронула").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОнбордингРедиректНаSetup() Экспорт

	// отдельный хаб на ПУСТОЙ БД: онбординг не завершён → кабинет уводит на /setup.
	// Порт — свой, выданный ОС (арифметика «Порт + 1» угадывала не лучше окна).
	ХабДва = НовыйХаб();
	ХабДва.ФайловаяБаза("openhub-office-empty");
	ХабДва.Среда("OSHUB_ADMIN_LOGIN", "");
	ХабДва.Среда("OSHUB_ADMIN_PASSWORD", "");

	Попытка
		ХабДва.Запустить();
		Ответ = Новый КлиентХаба(ХабДва, 20).GET("/me");
		Если Редирект(Ответ) Тогда
			Ожидаем.Что(СтрНайти(Клиент.ЗаголовокОтвета(Ответ, "Location"), "/setup") > 0, "редирект на /setup").ЭтоИстина();
		Иначе
			Ожидаем.Что(СтрНайти(Тело(Ответ), "onboarding_needed") > 0, "достигнут мастер /setup").ЭтоИстина();
		КонецЕсли;
	Исключение
		ХабДва.Остановить();
		ВызватьИсключение;
	КонецПопытки;
	ХабДва.Остановить();

КонецПроцедуры

// --- 3.B: управление доступом в кабинете (self-service пул, гранты, эскалация, CSRF) ---

&Тест
Процедура SelfServiceСозданиеПулаАдмином() Экспорт

	// админ (root) имеет право создания на хабе → self-service форма и создание пула
	Кука = Клиент.Войти("root", "RootPassw0rd");
	Стр = Тело(Клиент.GETСКукой(АдресПулов(), Кука));
	Ожидаем.Что(СтрНайти(Стр, "Создать пул") > 0, "админ видит кнопку заведения пула").ЭтоИстина();

	// Заведение живёт кнопкой над таблицей и ОКНОМ поверх экрана: пока не нажали, форма
	// места на экране не занимает.
	Ожидаем.Что(СтрНайти(Стр, "<dialog class=""modal""") > 0,
		"форма заведения — модальное окно").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, ОкноЗаведенияПула()) > 0,
		"и окно названо заведением пула").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "command=""show-modal""") > 0,
		"открывает его кнопка командой движка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, ОкноЗаведенияПула() + " open>"),
		"по умолчанию окно закрыто").Равно(0);
	Токен = ИзвлечьCSRF(Стр);

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "пул-создать");
	Поля.Вставить("имя", "granttest");
	Поля.Вставить("тип", "custom");
	Поля.Вставить("видимость", "private");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(АдресПулов(), Поля, Кука)), "пул создан (302)").ЭтоИстина();

	// пул появился в списке
	Обзор = Тело(Клиент.GETСКукой(АдресПулов(), Кука));
	Ожидаем.Что(СтрНайти(Обзор, "granttest") > 0, "новый пул в списке пулов хаба").ЭтоИстина();

КонецПроцедуры

// Серверная дорога к форме и возврат отбитой формы в ТО ЖЕ окно. Команду показа окна
// старый движок не сработает — значит, до формы обязана вести ссылка; а отказ, съевший
// ввод, заставляет набирать форму заново, и заметно это только человеку.
&Тест
Процедура ФормаЗаведенияПулаОткрываетсяАдресомИВозвращаетсяВНегоЖе() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Закрытая = Тело(Клиент.GETСКукой(АдресПулов(), Кука));

	Открытая = Тело(Клиент.GETСКукой(АдресПулов() + "?form=1", Кука));
	Ожидаем.Что(СтрНайти(Открытая, ОкноЗаведенияПула() + " open>") > 0,
		"адрес с form=1 открывает окно заведения").ЭтоИстина();

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Закрытая));
	Поля.Вставить("операция", "пул-создать");
	Поля.Вставить("имя", "quotatest");
	Поля.Вставить("тип", "custom");
	Поля.Вставить("видимость", "private");
	Поля.Вставить("квота_мб", "5oo"); // мусор: пул с таким пределом не заводится

	Отбитая = Тело(Клиент.POSTФормы(АдресПулов(), Поля, Кука));

	Ожидаем.Что(СтрНайти(Отбитая, ОкноЗаведенияПула() + " open>") > 0,
		"отбитая форма вернулась ТЕМ ЖЕ окном — открытым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отбитая, "aria-invalid=""true""") > 0,
		"отбитое поле помечено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отбитая, "value=""quotatest""") > 0,
		"набранное в соседних полях не съедено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отбитая, "value=""5oo""") > 0,
		"и в самом отбитом поле — тоже").ЭтоИстина();

КонецПроцедуры

// Отказ на форме показывает ПРИЧИНУ, а не служебное «{Модуль /путь/к/файлам/сервера …}»:
// координаты чужого кадра админу ничего не объясняют, зато раскрывают файловую систему хаба.
&Тест
Процедура ОтказСозданияПулаНеПечатаетСлужебнуюОбёртку() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(АдресПулов(), Кука)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "пул-создать");
	Поля.Вставить("имя", "settings"); // имя зарезервировано хабом под системный маршрут
	Поля.Вставить("тип", "custom");
	Поля.Вставить("видимость", "public");

	Страница = Тело(Клиент.POSTФормы(АдресПулов(), Поля, Кука));

	Ожидаем.Что(СтрНайти(Страница, "{Модуль"), "служебной обёртки на странице нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "oscript_modules"), "путей к файлам сервера на странице нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "Error in line"), "координат кадра на странице нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "зарезервировано") > 0, "причина названа словами").ЭтоИстина();

КонецПроцедуры

// З-27: быстрый старт главной печатал выдуманные localhost:3333 и пул public. Здесь
// засев ИМЕЕТ основной пул (public — имя сида), поэтому образец собирается целиком, и
// каждое его поле обязано быть настоящим: узел из заголовка Host, пути — из имени пула.
&Тест
Процедура БыстрыйСтартГлавнойНесётНастоящийАдресИОсновнойПул() Экспорт

	Тело = Тело(Клиент.GET("/"));

	Ожидаем.Что(СтрНайти(Тело, "Быстрый старт") > 0, "блок быстрого старта на месте").ЭтоИстина();
	// сверяем ИМЕННО поля образца, а не подстроку по всей странице: «3333» встречается
	// в отпечатках статики и идентификаторах, и скан по телу давал ложный красный
	Ожидаем.Что(СтрНайти(Тело, "&quot;Порт&quot;: 3333"), "выдуманного порта нет").Равно(0);
	Ожидаем.Что(СтрНайти(Тело, "localhost:3333"), "и в адресе сервера образца тоже").Равно(0);

	// узел берётся из Host запроса, а тесты ходят на localhost:<живой порт>
	НомерПорта = Формат(Порт, "ЧН=0; ЧГ=0");
	Ожидаем.Что(СтрНайти(Тело, "&quot;Сервер&quot;: &quot;http://localhost:" + НомерПорта + "&quot;") > 0,
		"сервер образца — узел запроса").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "&quot;Порт&quot;: " + НомерПорта) > 0,
		"и порт запроса, а не 3333").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "/api/v1/pools/public/download/") > 0,
		"пути образца ведут в основной пул хаба").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "opm install &lt;имя-пакета&gt;") > 0,
		"а установка из основного пула идёт короткой формой").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СозданиеПулаБезCSRFОтклонено() Экспорт
	Кука = Клиент.Войти("root", "RootPassw0rd");
	Поля = Новый Соответствие();
	Поля.Вставить("операция", "пул-создать");
	Поля.Вставить("имя", "nocsrf");
	Ожидаем.Что(Клиент.POSTФормы(АдресПулов(), Поля, Кука).КодСостояния,
		"создание пула без CSRF → 403").Равно(403);
	// отказ обязан не только ответить, но и не завести пул
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(АдресПулов(), Кука)), ">nocsrf<"),
		"пул без CSRF не заведён").Равно(0);
КонецПроцедуры

// Закладка на упразднённый экран прав. Человек с закладкой не виноват, что мы переехали:
// мейнтейнер обязан попасть на свои права, а не на 403 — 403 он прочитает как «отняли доступ».
//
// Адрес возврата проверяется КЛИЕНТОМ БЕЗ ПЕРЕХОДОВ и сравнивается целиком. Под «Если
// Редирект(...)» проверка была вечнозелёной: HTTPСоединение проходит переход сам, кода
// 3xx тест не видит никогда. А наличие подписи «Мои права» на посадочной странице ничего
// не доказывает: это пункт навигации дома аккаунта, он есть на любом /me/settings/*.
&Тест
Процедура ЗакладкаНаСтарыеПраваПулаВедётВДомПула() Экспорт

	ИдOwned = ИдПулаИзОбзора(Тело(Клиент.GETСКукой(АдресПулов(), ВойтиRoot())), "owned");
	Закладки = СтрРазделить("/office/pools/grants|/office/access/grants|/office/access/groups", "|");

	// владелец пула owned: любая из трёх закладок доводит его до РАЗДЕЛА ПРАВ ЕГО ПУЛА
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Для Каждого Закладка Из Закладки Цикл
		Адрес = СтрШаблон("%1?pool=%2", Закладка, Формат(ИдOwned, "ЧН=0; ЧГ=0"));
		Переход = Клиент.GETБезПереходов(Адрес, Клиент.СтрокаКукиСессии(КукаOwner));
		Ожидаем.Что(Редирект(Переход), Закладка + ": закладка уводит переходом").ЭтоИстина();
		Ожидаем.Что(Клиент.ЗаголовокОтвета(Переход, "Location"), Закладка + ": мейнтейнера ведут в права ЕГО пула")
			.Равно("/owned/settings/access");

		Ответ = Клиент.GETСКукой(Адрес, КукаOwner);
		Ожидаем.Что(Ответ.КодСостояния, Закладка + ": владельцу не отказ").Равно(200);
		Ожидаем.Что(СтрНайти(Тело(Ответ), "Выдать роль на пул") > 0,
			Закладка + ": владелец доехал до раздела прав своего пула").ЭтоИстина();
	КонецЦикла;

	// Посторонний: пул ему не виден, и адрес возврата обязан быть ОДИН И ТОТ ЖЕ на любой
	// невидимый пул — иначе перебор идентификаторов раскрывает имена приватных пулов.
	ИдSecret = ИдПулаИзОбзора(Тело(Клиент.GETСКукой(АдресПулов(), ВойтиRoot())), "secret");
	КукаBob = Клиент.Войти("bob", "BobPassw0rd");
	АдресЧужого = СтрШаблон("/office/pools/grants?pool=%1", Формат(ИдSecret, "ЧН=0; ЧГ=0"));

	ПереходЧужой = Клиент.GETБезПереходов(АдресЧужого, Клиент.СтрокаКукиСессии(КукаBob));
	Ожидаем.Что(Редирект(ПереходЧужой), "постороннего тоже уводят переходом, а не отказом").ЭтоИстина();
	Ожидаем.Что(Клиент.ЗаголовокОтвета(ПереходЧужой, "Location"), "посторонний уходит в свои права")
		.Равно("/me/settings/permissions");
	Ожидаем.Что(СтрНайти(Клиент.ЗаголовокОтвета(ПереходЧужой, "Location"), "secret"),
		"имя невидимого пула в адрес возврата не утекает").Равно(0);

	// и тот же адрес — у пула, которого не существует вовсе: неотличимо
	Небывалый = Клиент.GETБезПереходов("/office/pools/grants?pool=987654321", Клиент.СтрокаКукиСессии(КукаBob));
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Небывалый, "Location"), "несуществующий пул неотличим от невидимого")
		.Равно(Клиент.ЗаголовокОтвета(ПереходЧужой, "Location"));

	ОтветЧужой = Клиент.GETСКукой(АдресЧужого, КукаBob);
	Ожидаем.Что(ОтветЧужой.КодСостояния, "постороннему не отказ").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(ОтветЧужой), "secret"),
		"и на посадочной странице имени невидимого пула нет").Равно(0);

КонецПроцедуры

// Меню строки — четыре действия за одной шестерёнкой в конце строки. Проверяется состав
// меню и то, что панель уходит в ВЕРХНИЙ СЛОЙ (в потоке она раздвигала бы строку, а
// абсолютную обрезала бы обёртка прокрутки таблицы).

&Тест
Процедура МенюСтрокиПулаНесётЧетыреДействияЗаШестерёнкой() Экспорт

	Кука = ВойтиRoot();
	Стр = Тело(Клиент.GETСКукой(АдресПулов(), Кука));
	ИдPublic = ИдПулаИзОбзора(Стр, "public");

	// таблица помечена своим классом: на узком экране строка становится карточкой
	Ожидаем.Что(СтрНайти(Стр, "class=""table table-cards""") > 0,
		"таблица пулов несёт класс адаптива").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Стр, "class=""menu""") > 0, "меню строки на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "popovertarget=""") > 0, "у меню есть кнопка-открывашка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, " popover class=""menu__panel""") > 0,
		"и панель с действиями — во всплывающем слое").ЭтоИстина();

	// ЧЕТЫРЕ действия владельца: настройки, права, квота, основной пул
	Ожидаем.Что(СтрНайти(Стр, """/public/settings""") > 0, "меню ведёт в дом пула").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, """/public/settings/access""") > 0, "меню ведёт в права доступа пула").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "?pool=" + Формат(ИдPublic, "ЧН=0; ЧГ=0")) > 0,
		"меню ведёт на правку квоты").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "Сделать основным") > 0, "и предлагает сделать пул основным").ЭтоИстина();

	// действия ушли ИЗ строки в меню: голых кнопок «Настройки пула» вне панели больше нет
	Ожидаем.Что(СтрНайти(Стр, "class=""menu__form""") > 0,
		"мутация строки живёт своей формой внутри панели").ЭтоИстина();

КонецПроцедуры

// Идентификатор, которым кнопка связана со своей панелью, генерирует КИТ порядковым
// номером. Список пулов — единственное место, где ошибка здесь видна как ЧУЖОЕ МЕНЮ
// В ЧУЖОЙ СТРОКЕ: строк много, а имена в них приходят от пользователя. Два пула с почти
// одинаковыми именами — та самая пара, на которой идентификатор «из имени» слипся бы.
&Тест
Процедура ИдентификаторыМенюНаСтраницеПуловУникальны() Экспорт

	Кука = ВойтиRoot();
	Отметка = Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧН=0; ЧГ=0");
	ЗавестиПул(Кука, "twin-pool-" + Отметка, "public");
	ЗавестиПул(Кука, "twin-pool-" + Отметка + "-2", "public");

	Стр = Тело(Клиент.GETСКукой(АдресПулов(), Кука));

	// единое меню инсталляции считается отдельно: его одну панель открывают ТРИ кнопки
	// (бургер, рейка, крест), и арифметика строчных меню на нём не сходится по построению.
	// Их связь стережёт ХолстКита.ТриКнопкиЕдиногоМенюОткрываютОднуПанель
	Панели = БезЕдиногоМеню(ИдентификаторыПанелейМеню(Стр));
	Ожидаем.Что(Панели.Количество() > 2,
		"на странице пулов меню несколько: " + Формат(Панели.Количество(), "ЧН=0; ЧГ=0")).ЭтоИстина();

	Встреченные = Новый Соответствие();
	Повторы = Новый Массив();
	Для Каждого Ид Из Панели Цикл
		Если Встреченные.Получить(Ид) <> Неопределено Тогда
			Повторы.Добавить(Ид);
		КонецЕсли;
		Встреченные.Вставить(Ид, Истина);
		Ожидаем.Что(СтрНайти(Ид, "twin"),
			"имя пула протекло в идентификатор связи: " + Ид).Равно(0);
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Повторы, ", "),
		"две панели с одним идентификатором: шестерёнка откроет меню чужой строки").Равно("");

	Цели = БезЕдиногоМеню(ЗначенияАтрибутовВТеле(Стр, "popovertarget="""));
	Ожидаем.Что(Цели.Количество(), "у каждой панели своя кнопка").Равно(Панели.Количество());

	Потерянные = Новый Массив();
	Для Каждого Цель Из Цели Цикл
		Если Встреченные.Получить(Цель) = Неопределено Тогда
			Потерянные.Добавить(Цель);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Потерянные, ", "),
		"кнопка целится в панель, которой на странице нет").Равно("");

КонецПроцедуры

// Панель правки квоты раскрывается ССЫЛКОЙ меню (?pool=N), а не формой внутри ячейки:
// у неё два поля и свой отказ, в ячейку таблицы они не помещаются.
// Колонка квоты ТРЁХЗНАЧНА: -1 «как в хабе», 0 «без ограничения», >0 своя. Таблица обязана
// печатать ДЕЙСТВУЮЩУЮ квоту, а не записанную: у наследующего пула записано -1, и по
// записанному значению строка сказала бы «квота не задана», хотя предел у пула есть.
// Форму итога пультов держит фабрика ИтогПульта, и поле «Статус» есть у любого из них;
// раньше его не было у соседей, и прочтённое как число Неопределено роняло ответ в 500.
// ОТКУДА ЗДЕСЬ 403: порог всего раздела — администратор хаба, поэтому не-админа отбивает
// ГвардХабАдмина, ДО пульта. Предикат самого ГвардаКвотыПула снаружи недостижим и
// проверяется юнит-набором ПультПулов_Тесты — здесь стережётся только пара кодов
// «отказ по вводу 400 / отказ по праву 403» на одном и том же адресе.
&Тест
Процедура ОтказыПультовРазделаПулыНазываютсяСвоимиКодами() Экспорт

	КукаRoot = ВойтиRoot();
	Обзор = Тело(Клиент.GETСКукой(АдресПулов(), КукаRoot));
	Токен = ИзвлечьCSRF(Обзор);
	ИдPublic = ИдПулаИзОбзора(Обзор, "public");

	// отказ ПО ВВОДУ — 400: форму есть что поправить
	Ожидаем.Что(Клиент.POSTФормы(АдресПулов(), ПоляКвоты(Токен, ИдPublic, "5oo"), КукаRoot).КодСостояния,
		"мусор в квоте — 400").Равно(400);

	// отказ ПО ПРАВУ — 403, и это не 500: у соседних пультов поля «Статус» нет
	Ожидаем.Что(Клиент.POSTФормы(АдресПулов(), ПоляКвоты(Токен, ИдPublic, "64"),
			Клиент.Войти("alice", "AlicePassw0rd")).КодСостояния,
		"не-админ: отказ по праву, а не отказ по вводу").Равно(403);

	// а обычная операция соседнего пульта в этом же разделе по-прежнему отвечает собой
	ПоляТумблера = Новый Соответствие();
	ПоляТумблера.Вставить("_csrf", Токен);
	ПоляТумблера.Вставить("операция", "неизвестная-операция");
	Ожидаем.Что(Клиент.POSTФормы(АдресПулов(), ПоляТумблера, КукаRoot).КодСостояния < 500,
		"нераспознанная операция раздела не роняет ответ").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КолонкаПечатаетДействующуюКвотуАНеЗаписаннуюМинусЕдиницу() Экспорт

	Кука = ВойтиRoot();
	Имя = УникальныеИмена.Имя("inherit");
	Ожидаем.Что(УспехМутации(ЗавестиПул(Кука, Имя, "public")), "пул заведён").ЭтоИстина();

	Обзор = Тело(Клиент.GETСКукой(АдресПулов() + "?q=" + Имя, Кука));
	Ожидаем.Что(СтрНайти(Обзор, ">" + Имя + "</a>") > 0, "предпосылка: пул в отобранном списке").ЭтоИстина();

	// в базе у него записано «как в хабе» — панель правки печатает колонку как есть
	// Заголовок панели ИМЕНУЕТ пул: «value="-1"» само по себе есть и в форме создания,
	// и предпосылка проверялась бы вечнозелёно.
	ИдНового = ИдПулаИзОбзора(Обзор, Имя);
	Ожидаем.Что(СтрНайти(СекцияПравки(Тело(Клиент.GETСКукой(АдресПанели(ИдНового), Кука)), Имя),
		"value=""-1""") > 0, "предпосылка: у нового пула записано «как в хабе»").ЭтоИстина();

	// а в таблице у него ДЕЙСТВУЮЩИЙ предел, полосой, и наследование названо словом
	Ожидаем.Что(СтрНайти(Обзор, "квота хаба") > 0,
		"наследование квоты хаба названо прямо").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Обзор, "квота не задана"),
		"строка наследующего пула НЕ выдаёт себя за пул без ограничения").Равно(0);

КонецПроцедуры

// Панель обязана принимать СВОЁ НАПЕЧАТАННОЕ значение. У пула, наследующего квоту хаба,
// в поле стоит -1, и это состояние по умолчанию: именно его получает пул, заведённый
// формой этого же раздела. Квота и видимость едут ОДНИМ POST, квота судится первой —
// отвергнув минус, панель отвечала отказом и на смену видимости тоже.
&Тест
Процедура ПанельПринимаетНапечатаннуюЕюКвотуКакВХабе() Экспорт

	Кука = ВойтиRoot();
	Имя = УникальныеИмена.Имя("panelinherit");
	Ожидаем.Что(УспехМутации(ЗавестиПул(Кука, Имя, "public")), "пул заведён").ЭтоИстина();

	Обзор = Тело(Клиент.GETСКукой(АдресПулов() + "?q=" + Имя, Кука));
	Ид = ИдПулаИзОбзора(Обзор, Имя);
	Панель = Тело(Клиент.GETСКукой(АдресПанели(Ид), Кука));
	Ожидаем.Что(СтрНайти(СекцияПравки(Панель, Имя), "value=""-1""") > 0,
		"предпосылка: панель напечатала «как в хабе»").ЭтоИстина();

	// ровно то, что панель напечатала, уходит обратно — вместе со сменой видимости
	Поля = ПоляКвоты(ИзвлечьCSRF(Обзор), Ид, "-1");
	Поля.Вставить("видимость", "private");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(АдресПулов(), Поля, Кука)),
		"панель приняла собственное значение квоты").ЭтоИстина();

	ПослеПравки = Тело(Клиент.GETСКукой(АдресПанели(Ид), Кука));
	Ожидаем.Что(СтрНайти(СекцияПравки(ПослеПравки, Имя), "value=""-1""") > 0,
		"квота осталась «как в хабе»").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(АдресПулов() + "?q=" + Имя, Кука)), "Приватный") > 0,
		"и видимость переключилась тем же запросом").ЭтоИстина();

КонецПроцедуры

// Отказ операции применяется ЦЕЛИКОМ или не применяется вовсе. Личное пространство
// приватным быть не может, поэтому видимость отвергает инвариант пула — а квота в том же
// POST записывалась ДО него и оставалась изменённой при сообщении «квота НЕ изменена».
&Тест
Процедура ОтказПанелиНеОставляетКвотуЗаписанной() Экспорт

	Кука = ВойтиRoot();
	Обзор = Тело(Клиент.GETСКукой(АдресПулов() + "?q=bob", Кука));
	Ид = ИдПулаИзОбзора(Обзор, "bob");
	Ожидаем.Что(Ид > 0, "предпосылка: личное пространство bob в списке").ЭтоИстина();

	ДоПравки = СекцияПравки(Тело(Клиент.GETСКукой(АдресПанели(Ид), Кука)), "bob");

	Поля = ПоляКвоты(ИзвлечьCSRF(Обзор), Ид, "777");
	Поля.Вставить("видимость", "private");
	Ответ = Клиент.POSTФормы(АдресПулов(), Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "личное пространство приватным не становится → 400").Равно(400);

	ПослеОтказа = СекцияПравки(Тело(Клиент.GETСКукой(АдресПанели(Ид), Кука)), "bob");
	Ожидаем.Что(СтрНайти(ПослеОтказа, "value=""777"""),
		"отвергнутая операция квоту не записала").Равно(0);
	Ожидаем.Что(ПослеОтказа, "панель показывает прежнее значение целиком").Равно(ДоПравки);

	// КОНТРОЛЬ: тот же ввод с допустимой видимостью проходит и записывает квоту
	Годные = ПоляКвоты(ИзвлечьCSRF(Обзор), Ид, "777");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(АдресПулов(), Годные, Кука)),
		"КОНТРОЛЬ: с публичной видимостью та же квота записывается").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СекцияПравки(Тело(Клиент.GETСКукой(АдресПанели(Ид), Кука)), "bob"),
		"value=""777""") > 0, "и панель печатает её").ЭтоИстина();

КонецПроцедуры

// Отказ по вводу не должен захлопывать панель и терять отбор: обстановку POST несёт
// скрытыми полями формы, своего запроса у него нет.
&Тест
Процедура ОтказПанелиОставляетЕёОткрытойИСохраняетОтбор() Экспорт

	Кука = ВойтиRoot();
	Обзор = Тело(Клиент.GETСКукой(АдресПулов() + "?q=own", Кука));
	Ид = ИдПулаИзОбзора(Обзор, "owned");

	Поля = ПоляКвоты(ИзвлечьCSRF(Обзор), Ид, "5oo");
	Поля.Вставить("q", "own");
	Ответ = Клиент.POSTФормы(АдресПулов(), Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния, "мусор в квоте — 400").Равно(400);

	Страница = Тело(Ответ);
	Ожидаем.Что(СтрНайти(Страница, "Квота и видимость пула «owned»") > 0,
		"панель осталась раскрытой на том же пуле").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, ">owned</a>") > 0, "отбор пережил отказ").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, ">public</a>"), "и прочие пулы не вернулись").Равно(0);

КонецПроцедуры

&Тест
Процедура ПанельПравкиКвотыОткрываетсяСсылкойМеню() Экспорт

	Кука = ВойтиRoot();
	ИдPublic = ИдПулаИзОбзора(Тело(Клиент.GETСКукой(АдресПулов(), Кука)), "public");

	// без параметра панели нет — список не загромождён
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(АдресПулов(), Кука)), "Квота и видимость пула"),
		"без ссылки меню панель правки не печатается").Равно(0);

	Панель = Тело(Клиент.GETСКукой(АдресПанели(ИдPublic), Кука));
	Ожидаем.Что(СтрНайти(Панель, "Квота и видимость пула «public»") > 0,
		"ссылка меню раскрывает панель правки именно этого пула").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "name=""квота_мб""") > 0, "в панели поле квоты").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "name=""видимость""") > 0, "и тумблер видимости").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "пул не указан"), "открытая панель не жалуется на пул").Равно(0);

КонецПроцедуры

// Квота — право АДМИНА ХАБА: владелец пула её видит, но не правит. Проверяется не только
// код ответа, но и то, что подделанный POST значения не изменил. Рядом с «должно быть 403»
// стоит проходящий запрос, отличающийся ровно кукой. Отбивает здесь порог РАЗДЕЛА; то, что
// пульт спрашивает СВОЙ гвард, стережёт юнит-набор ПультПулов_Тесты.
&Тест
Процедура КвотуПулаПравитТолькоАдминХаба() Экспорт

	КукаRoot = ВойтиRoot();
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(АдресПулов(), КукаRoot)));
	ИдOwned = ИдПулаИзОбзора(Тело(Клиент.GETСКукой(АдресПулов(), КукаRoot)), "owned");

	Ожидаем.Что(УспехМутации(ПостКвотыХаба(КукаRoot, Токен, ИдOwned, "333")),
		"админ хаба квоту правит").ЭтоИстина();

	// владелец пула: раздела нет вовсе, а подделанный POST не проходит и не меняет квоту
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Ожидаем.Что(Клиент.POSTФормы(АдресПулов(),
			ПоляКвоты(Токен, ИдOwned, "999"), КукаOwner).КодСостояния,
		"владелец пула: правка квоты через раздел хаба → 403").Равно(403);

	// Значение в БАЗЕ, а не отформатированное человеку: панель правки печатает колонку
	// как она записана, и проверка не зависит от того, как объём округляют на экран.
	Ожидаем.Что(СтрНайти(СекцияПравки(Тело(Клиент.GETСКукой(АдресПанели(ИдOwned), КукаRoot)), "owned"),
		"value=""333""") > 0, "подделанный POST владельца квоту не изменил").ЭтоИстина();

	// а занятое и квота видны в таблице — это владелец просил показать
	Обзор = Тело(Клиент.GETСКукой(АдресПулов(), КукаRoot));
	Ожидаем.Что(СтрНайти(Обзор, "Занято и квота") > 0, "колонка занятого и квоты есть").ЭтоИстина();
	// «из 333» — подпись полосы «занято из квоты»; без десятичной части и единицы,
	// чтобы сторож не зависел от того, каким знаком разделяется дробь
	Ожидаем.Что(СтрНайти(Обзор, "из 333") > 0, "и действующая квота в ней напечатана").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Обзор, "class=""meter") > 0, "занятое показано полосой заполнения").ЭтоИстина();

КонецПроцедуры

// «Сделать основным» — право на ХАБЕ, а не на пуле: администратор отдельного пула не
// должен уводить короткие адреса /download и /push на себя. До переезда у этого действия
// не было ни одного HTTP-теста.
&Тест
Процедура ОсновнойПулНазначаетсяТолькоПравомХаба() Экспорт

	КукаRoot = ВойтиRoot();
	Обзор = Тело(Клиент.GETСКукой(АдресПулов(), КукаRoot));
	Токен = ИзвлечьCSRF(Обзор);
	ИдOwned = ИдПулаИзОбзора(Обзор, "owned");

	// НЕГАТИВ: владелец пула не назначает свой пул основным — ни ответом, ни в базе
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	Ожидаем.Что(Клиент.POSTФормы(АдресПулов(),
			ПоляОсновного(Токен, ИдOwned), КукаOwner).КодСостояния,
		"владелец пула: назначение основного → 403").Равно(403);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/owned", КукаOwner)), "Основной"),
		"подделанный POST основной пул не переставил").Равно(0);

	// ПОЗИТИВ: админ хаба назначает и возвращает обратно
	Попытка

		Ожидаем.Что(УспехМутации(Клиент.POSTФормы(АдресПулов(), ПоляОсновного(Токен, ИдOwned), КукаRoot)),
			"админ хаба назначил основной пул").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/owned", КукаRoot)), "Основной") > 0,
			"плашка основного переехала на owned").ЭтоИстина();

	Исключение

		ВернутьОсновнымPublic(КукаRoot);
		ВызватьИсключение;

	КонецПопытки;

	ВернутьОсновнымPublic(КукаRoot);

КонецПроцедуры

Процедура ВернутьОсновнымPublic(Знач Кука)
	Обзор = Тело(Клиент.GETСКукой(АдресПулов(), Кука));
	Клиент.POSTФормы(АдресПулов(),
		ПоляОсновного(ИзвлечьCSRF(Обзор), ИдПулаИзОбзора(Обзор, "public")), Кука);
КонецПроцедуры

Функция ПоляОсновного(Знач Токен, Знач ИдПула)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "пул-основной");
	Поля.Вставить("pool", Формат(ИдПула, "ЧН=0; ЧГ=0"));
	Возврат Поля;
КонецФункции

Функция АдресПанели(Знач ИдПула)
	Возврат СтрШаблон("%1?pool=%2", АдресПулов(), Формат(ИдПула, "ЧН=0; ЧГ=0"));
КонецФункции

// Только секция правки: «value="-1"» есть и в форме создания, и без вырезки предпосылка
// проверялась бы вечнозелёно. Заголовок секции ИМЕНУЕТ пул — это и есть якорь.
Функция СекцияПравки(Знач Разметка, Знач ИмяПула)

	Заголовок = "Квота и видимость пула «" + ИмяПула + "»";
	Позиция = СтрНайти(Разметка, Заголовок);
	Если Позиция = 0 Тогда
		ВызватьИсключение "Панель правки не раскрыта на пуле " + ИмяПула;
	КонецЕсли;

	Хвост = Сред(Разметка, Позиция);
	Конец = СтрНайти(Хвост, "</section>");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец));

КонецФункции

Функция ПоляКвоты(Знач Токен, Знач ИдПула, Знач Значение)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "пул-квота");
	Поля.Вставить("pool", Формат(ИдПула, "ЧН=0; ЧГ=0"));
	Поля.Вставить("квота_мб", Значение);
	Поля.Вставить("видимость", "public");
	Возврат Поля;
КонецФункции

// Отбор по имени обязан пережить мутацию: иначе после правки квоты администратор
// возвращается к полному списку и ищет пул заново.
&Тест
Процедура ОтборПереживаетПравкуКвоты() Экспорт

	Кука = ВойтиRoot();
	Обзор = Тело(Клиент.GETСКукой(АдресПулов() + "?q=own", Кука));
	Ожидаем.Что(СтрНайти(Обзор, ">owned</a>") > 0, "отбор оставил owned").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Обзор, ">public</a>"), "и убрал прочие").Равно(0);

	Поля = ПоляКвоты(ИзвлечьCSRF(Обзор), ИдПулаИзОбзора(Обзор, "owned"), "444");
	Поля.Вставить("q", "own");
	Ответ = Клиент.POSTФормы(АдресПулов(), Поля, Кука);
	Ожидаем.Что(УспехМутации(Ответ), "квота применена").ЭтоИстина();

	// Проверка БЕЗУСЛОВНАЯ: под «Если Редирект(...)» она была вечнозелёной — клиент
	// проходит редирект сам, ветка не исполнялась ни разу (доказано мутацией).
	Возврат_ = ?(Редирект(Ответ), Тело(Клиент.GETСКукой(Клиент.ЗаголовокОтвета(Ответ, "Location"), Кука)), Тело(Ответ));
	Ожидаем.Что(СтрНайти(Возврат_, ">owned</a>") > 0,
		"после правки список всё ещё сужен до owned").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Возврат_, ">public</a>"),
		"и прочие пулы в него не вернулись").Равно(0);

КонецПроцедуры

&Тест
Процедура НеВладелецНеСоздаётПулИНеУправляетДоступом() Экспорт

	// bob не админ хаба → раздел «Пулы» закрыт ему целиком: ни списка, ни формы создания
	Кука = Клиент.Войти("bob", "BobPassw0rd");
	Ожидаем.Что(Клиент.GETСКукой(АдресПулов(), Кука).КодСостояния,
		"не-админу раздел пулов дома «Хаб» → 403").Равно(403);

	// но своим личным пространством он распоряжается как и прежде: переезд прав не отнял
	Ожидаем.Что(Клиент.GETСКукой("/bob/settings", Кука).КодСостояния,
		"владелец личного пространства входит в его дом").Равно(200);
	Свои = Клиент.GETСКукой("/bob/settings/access", Кука);
	Ожидаем.Что(Свои.КодСостояния, "и в раздел прав своего пула").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Свои), "Выдать роль на пул") > 0,
		"мейнтейнер своего пула раздаёт роли на нём").ЭтоИстина();

	// чужим пулом — не управляет
	Ожидаем.Что(Клиент.GETСКукой(ЭкранПравПула("public"), Кука).КодСостояния,
		"не-мейнтейнер: права чужого пула → 403").Равно(403);

	// МУТАЦИЯ М-19 ревью выжила: порог экрана прав опускался до МожетПисать, и РАЙТЕР
	// пула получал страницу, где раздают роли, — эскалация в один клик. bob прав не имеет
	// вовсе, поэтому его отказ мутацию не ловил; нужен ровно райтер.
	// ОДНА сессия root на всю связку: каждый ВойтиRoot() — новая сессия, а CSRF-токен
	// привязан к своей. Имя переменной уникально (мина захвата имён: присваивание
	// одноимённому полю модуля подменяет чужую сессию).
	КукаRoot7A = ВойтиRoot();
	ЭкранПрав = ЭкранПравПула("public");
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(ЭкранПрав, КукаRoot7A)));
	Ожидаем.Что(УспехМутации(ВыдатьРольНаПул(ЭкранПрав, Токен, КукаRoot7A, "bob", "райтер")),
		"bob сделан райтером public").ЭтоИстина();

	КукаBob7A = Клиент.Войти("bob", "BobPassw0rd");
	ОтветРайтера = Клиент.GETСКукой(ЭкранПрав, КукаBob7A);
	Ожидаем.Что(ОтветРайтера.КодСостояния, "РАЙТЕР пула не входит на экран прав → 403").Равно(403);

	// и выдать роль формой он тоже не может (гейт стоит не только на GET)
	Ожидаем.Что(УспехМутации(ВыдатьРольНаПул(ЭкранПрав, ИзвлечьCSRF(Тело(ОтветРайтера)),
		КукаBob7A, "bob", "мейнтейнер")), "райтер не выдаёт себе мейнтейнера").ЭтоЛожь();

	// отказ обязан не только ответить кодом, но и НЕ записать: перечитываем глазами админа
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(ЭкранПрав, КукаRoot7A)), "<td>bob</td><td>мейнтейнер</td>"),
		"подделанный POST райтера роль в базе не поднял").Равно(0);

	// уборка: снимаем роль bob, чтобы соседние тесты видели прежнюю картину
	УспехМутации(ОтозватьРольНаПул(ЭкранПрав, Токен, КукаRoot7A, "bob"));

КонецПроцедуры

&Тест
Процедура АдминВыдаётИОтзываетРольЧерезUI() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Страница = ЭкранПравПула("public");

	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));

	// выдать bob РОЛЬ райтера на пул public (7.A: форма спрашивает роль, не действия)
	Ожидаем.Что(УспехМутации(ВыдатьРольНаПул(Страница, Токен, Кука, "bob", "райтер")),
		"роль выдана (302)").ЭтоИстина();

	Стр = Тело(Клиент.GETСКукой(Страница, Кука));

	// СОСТАВ И ДЕФОЛТ СПИСКА РОЛЕЙ (мутации М-14 и М-18 ревью выжили). Владелец и админ
	// хаба в форме выдачи невозможны: владение сущностью — право на её КОНТЕЙНЕРЕ, роль
	// хаба раздаёт только админ хаба. Дефолт — САМАЯ СЛАБАЯ роль: выпадающий список, где
	// заранее выбран мейнтейнер, раздаёт администраторов пула одним промахом мыши.
	Ожидаем.Что(СтрНайти(Стр, "value=""читатель""") > 0, "в списке есть читатель").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "value=""райтер""") > 0, "в списке есть райтер").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "value=""мейнтейнер""") > 0, "в списке есть мейнтейнер").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "value=""владелец"""), "владельца в форме выдачи нет").Равно(0);
	Ожидаем.Что(СтрНайти(Стр, "value=""админ"""), "админа хаба в форме выдачи нет").Равно(0);
	Ожидаем.Что(СтрНайти(Стр, "value=""читатель"" selected") > 0,
		"по умолчанию выбран читатель — самая слабая роль").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Стр, "bob") > 0, "субъект bob в таблице прав").ЭтоИстина();
	// наружу — роль, а не набор действий: гранулярность ушла из интерфейса (В-1).
	// ЯЧЕЙКА ЦЕЛИКОМ, а не «содержит ""райтер""»: подписи ролей печатает и сама форма
	// выдачи (варианты выбора), поэтому проверка «на странице есть слово» была бы
	// вечнозелёной — проверено мутацией «форма игнорирует поле роли».
	Ожидаем.Что(СтрНайти(Стр, "<td>bob</td><td>райтер</td>") > 0, "роль отражена в строке выдачи").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, ">чтение, создание, изменение<"), "действий на экране нет").Равно(0);

	// СЕРВЕРНЫЙ ФОЛБЭК РОЛИ (мутация М-18 выжила повторно: в прошлый раз я запинил
	// РАЗМЕТКУ — предвыбранный пункт списка, — а мутируется фолбэк в пульте прав,
	// срабатывающий когда поля «роль» в теле POST НЕТ вовсе: старая закладка, обрезанное
	// тело, скрипт). Least-privilege на пути ВЫДАЧИ ПРАВ обязан быть запинен со стороны
	// сервера, а не вёрстки.
	ПоляБезРоли = Новый Соответствие();
	ПоляБезРоли.Вставить("_csrf", Токен);
	ПоляБезРоли.Вставить("операция", "выдать");
	ПоляБезРоли.Вставить("тип_субъекта", "пользователь");
	ПоляБезРоли.Вставить("субъект", "bob");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, ПоляБезРоли, Кука)),
		"форма без поля «роль» принимается").ЭтоИстина();

	СтрБезРоли = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(СтрБезРоли, "<td>bob</td><td>читатель</td>") > 0,
		"без поля «роль» выдаётся САМАЯ СЛАБАЯ роль, а не мейнтейнер").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрБезРоли, "<td>bob</td><td>мейнтейнер</td>"),
		"мейнтейнер по умолчанию не выдаётся").Равно(0);

	// возвращаем райтера — дальше проверяется отзыв именно его
	Ожидаем.Что(УспехМутации(ВыдатьРольНаПул(Страница, Токен, Кука, "bob", "райтер")),
		"роль возвращена на райтера").ЭтоИстина();

	// отозвать
	Ожидаем.Что(УспехМутации(ОтозватьРольНаПул(Страница, Токен, Кука, "bob")),
		"грант отозван (302)").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "<td>bob</td>"), "bob исчез из таблицы").Равно(0);

КонецПроцедуры

// Права складываются и никогда не вычитаются: выданное на пуле действует на его пакетах,
// а сузить это на пакете нечем — операции «запретить» в хабе нет вовсе. Иначе, глядя
// на строку прав, никогда не скажешь, что человек может на самом деле.
&Тест
Процедура РольНаПулеОткрываетЕгоПакетАЗапретаНеСуществует() Экспорт

	КукаBob = Клиент.Войти("bob", "BobPassw0rd");
	ДомПакета = "/public/alice-pkg/settings";
	Ожидаем.Что(Клиент.GETСКукой(ДомПакета, КукаBob).КодСостояния,
		"самотест: без выдачи bob в дом чужого пакета не входит").Равно(403);

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	ЭкранПула = ЭкранПравПула("public");
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(ЭкранПула, КукаАдмина)));

	Попытка

		Ожидаем.Что(УспехМутации(ВыдатьРольНаПул(ЭкранПула, Токен, КукаАдмина, "bob", "мейнтейнер")),
			"роль выдана на ПУЛ, а на пакете не выдавалось ничего").ЭтоИстина();
		Ожидаем.Что(Клиент.GETСКукой(ДомПакета, КукаBob).КодСостояния,
			"роль родителя действует на вложенном объекте").Равно(200);

		// «дать всем, кроме одного» решается не запретом: запрет — не операция раздела,
		// и попытка сузить выданное на пуле доступа не отнимает. Раздел, не знающий такого
		// слова, форму ОТБИВАЕТ: операций у него ровно две, и прибавлять он умеет, отнимать — нет
		ЭкранПакета = "/public/alice-pkg/settings/access";
		Запрет = Новый Соответствие();
		Запрет.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(ЭкранПакета, КукаАдмина))));
		Запрет.Вставить("операция", "запретить");
		Запрет.Вставить("тип_субъекта", "пользователь");
		Запрет.Вставить("субъект", "bob");
		Запрет.Вставить("роль", "читатель");
		Ожидаем.Что(УспехМутации(Клиент.POSTФормы(ЭкранПакета, Запрет, КукаАдмина)),
			"слова «запретить» раздел не знает и форму отбивает").ЭтоЛожь();
		Ожидаем.Что(Клиент.GETСКукой(ДомПакета, КукаBob).КодСостояния,
			"попытка запрета выданного на пуле доступа не отняла").Равно(200);
		СнятьПравоПакета(КукаАдмина, Токен, "bob");

	Исключение
		СнятьПравоПакета(КукаАдмина, Токен, "bob");
		ОтозватьРольНаПул(ЭкранПула, Токен, КукаАдмина, "bob");
		ВызватьИсключение;
	КонецПопытки;

	// доступ отбирают тем, что снимают саму выдачу — ту, из которой он взялся
	Ожидаем.Что(УспехМутации(ОтозватьРольНаПул(ЭкранПула, Токен, КукаАдмина, "bob")),
		"выдача снята").ЭтоИстина();
	Ожидаем.Что(Клиент.GETСКукой(ДомПакета, КукаBob).КодСостояния,
		"снятие выдачи закрыло и вложенный объект").Равно(403);

КонецПроцедуры

&Тест
Процедура ВитринаПравВДомеПулаНазываетСубъектаЛогиномАНеЧислом() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	ЭкранПрав = ЭкранПравПула("public");

	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(ЭкранПрав, Кука)));

	Ожидаем.Что(УспехМутации(ВыдатьРольНаПул(ЭкранПрав, Токен, Кука, "bob", "читатель")),
		"право доступа выдано (302)").ЭтоИстина();

	Попытка

		Витрина = Тело(Клиент.GETСКукой(ЭкранПрав, Кука));

		// строка витрины целиком: тип субъекта, СУБЪЕКТ, действия. Проверяем именно
		// СОСЕДСТВО ячеек, а не наличие логина где-нибудь на странице: до починки во
		// второй ячейке стояло число, и «bob» на странице всё равно нашёлся бы (шапка
		// аккаунта, ссылки). Числа в этой ячейке быть не может по построению шаблона.
		Ожидаем.Что(СтрНайти(Витрина, "<td>пользователь</td><td>bob</td>") > 0,
			"в витрине дома пула субъект назван логином, а не идентификатором").ЭтоИстина();

		// 7.A (хвост З-5): витрина дома пула тоже говорит РОЛЬЮ. Раньше она печатала
		// набор действий, и один и тот же доступ звучал на двух экранах по-разному.
		Ожидаем.Что(СтрНайти(Витрина, "<td>пользователь</td><td>bob</td><td>читатель</td>") > 0,
			"витрина дома пула называет роль").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Витрина, "<td>чтение</td>"), "набора действий в витрине нет").Равно(0);

		// оба экрана называют субъект одинаково — разворот у них общий
		Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(ЭкранПрав, Кука)), "<td>bob</td>") > 0,
			"экран прав доступа называет субъект тем же логином").ЭтоИстина();

	Исключение

		Снять(Кука, Токен, "public");
		ВызватьИсключение;

	КонецПопытки;

	Снять(Кука, Токен, "public");

КонецПроцедуры

&Тест
Процедура СообщениеОНенайденномПулеЗеркалЭкранировано() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Полезное = "<script>alert(1)</script>";
	Ответ = Клиент.GETСКукой("/office/mirrors/" + КодироватьСтроку(Полезное, СпособКодированияСтроки.КодировкаURL), Кука);

	Ожидаем.Что(Ответ.КодСостояния, "несуществующий пул — 404").Равно(404);

	Стр = Тело(Ответ);
	Ожидаем.Что(СтрНайти(Стр, Полезное), "тег из URL в разметку не вырвался").Равно(0);
	Ожидаем.Что(СтрНайти(Стр, "&lt;script&gt;") > 0, "имя пула отдано экранированным: " + Стр).ЭтоИстина();

КонецПроцедуры

// Настройка пула «заводить каналы автоматически» выключена, пока её не включили, и живёт
// она в разделе «Теги» дома пула. Пакет, попавший в такой пул, каналов не получает —
// а с включённой настройкой получает те же три, что предлагает визард.
&Тест
Процедура НастройкаПулаЗаводитКаналыНовымПакетам() Экспорт

	Кука = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/owned/settings/tags";
	Токен = ВыпуститьPATКукой(Кука);

	Ожидаем.Что(ТумблерВключён(Тело(Клиент.GETСКукой(Раздел, Кука)), "автоканалы"),
		"КОНТРОЛЬ: у пула настройка выключена").ЭтоЛожь();

	Ожидаем.Что(PushТокеном(Токен, "owned", "auto-off-pkg", "1.0.0").КодСостояния,
		"пакет в пул без настройки опубликован").Равно(201);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/owned/auto-off-pkg/settings/tags", Кука)),
		"Создать каналы") > 0, "и каналов у него нет — экран предлагает визард").ЭтоИстина();

	Попытка

		ПереключитьАвтоканалы(Раздел, Кука, Истина);
		Ожидаем.Что(ТумблерВключён(Тело(Клиент.GETСКукой(Раздел, Кука)), "автоканалы"),
			"настройка включена и видна на экране").ЭтоИстина();

		Ожидаем.Что(PushТокеном(Токен, "owned", "auto-on-pkg", "1.0.0").КодСостояния,
			"пакет в пул с настройкой опубликован").Равно(201);

		Разметка = Тело(Клиент.GETСКукой("/owned/auto-on-pkg/settings/tags", Кука));
		Для Каждого ИмяКанала Из СтрРазделить("stable,prerelease,develop", ",") Цикл
			Ожидаем.Что(ЗначениеЗаполнено(ПлашкаТегаНаСтранице(Разметка, ИмяКанала)),
				"первая версия завела канал «" + ИмяКанала + "»").ЭтоИстина();
		КонецЦикла;

	Исключение
		// уборка обязана пройти и по провалу: включённая настройка уронила бы соседей
		ПереключитьАвтоканалы(Раздел, Кука, Ложь);
		ВызватьИсключение;
	КонецПопытки;

	ПереключитьАвтоканалы(Раздел, Кука, Ложь);
	Ожидаем.Что(ТумблерВключён(Тело(Клиент.GETСКукой(Раздел, Кука)), "автоканалы"),
		"настройка выключена обратно").ЭтоЛожь();

КонецПроцедуры

// Выключенная публикация закрывает пул для ЛЮДЕЙ, а не для хаба: из обзора «где заводят
// зеркала» такой пул не пропадает, и карточка пула говорит, чем он наполняется.
&Тест
Процедура ЗакрытыйДляПубликацииПулВиденТамГдеЗаводятЗеркала() Экспорт

	Кука = Клиент.Войти("owner1", "Owner1Passw0rd");
	Раздел = "/owned/settings/upstreams";

	// КОНТРОЛЬ до выключения: пул в обзоре есть, и плашки наполнения на карточке нет
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/office/mirrors", Кука)), "/office/mirrors/owned") > 0,
		"КОНТРОЛЬ: с публикацией пул в обзоре зеркал есть").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/owned", Кука)), "Закрыт для публикации"),
		"КОНТРОЛЬ: с публикацией карточка о закрытости молчит").Равно(0);

	Ид = "";
	Попытка

		ПереключитьПубликациюПула(Раздел, Кука, Ложь);

		Обзор = Тело(Клиент.GETСКукой("/office/mirrors", Кука));
		Ожидаем.Что(СтрНайти(Обзор, "/office/mirrors/owned") > 0,
			"закрытый для публикации пул из обзора зеркал не пропал: " + Обзор).ЭтоИстина();

		// зеркала на нём ещё нет — карточка обязана сказать именно «закрыт», а не выдумывать
		Карточка = Тело(Клиент.GETСКукой("/owned", Кука));
		Ожидаем.Что(СтрНайти(Карточка, "Закрыт для публикации") > 0,
			"карточка пула без зеркал называет его закрытым: " + Карточка).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Карточка, "Наполняется зеркалом"),
			"и зеркала себе не приписывает").Равно(0);

		// заводим зеркало на этот же закрытый пул — подпись обязана перестать врать
		Ид = ЗавестиЗеркалоПула("/office/mirrors/owned", Кука, "http://127.0.0.1:8/download/");
		Ожидаем.Что(ЗначениеЗаполнено(Ид), "зеркало закрытому пулу заведено").ЭтоИстина();

		СЗеркалом = Тело(Клиент.GETСКукой("/owned", Кука));
		Ожидаем.Что(СтрНайти(СЗеркалом, "Наполняется зеркалом") > 0,
			"карточка пула с зеркалом называет источник наполнения: " + СЗеркалом).ЭтоИстина();
		Ожидаем.Что(СтрНайти(СЗеркалом, "Закрыт для публикации"),
			"и «закрыт для всех» больше не говорит").Равно(0);

	Исключение
		// уборка обязана пройти и по провалу: оставленное зеркало и выключенная публикация
		// уронили бы соседние тесты набора — они делят один хаб
		УбратьЗеркалоПула("/office/mirrors/owned", Кука, Ид);
		ПереключитьПубликациюПула(Раздел, Кука, Истина);
		ВызватьИсключение;
	КонецПопытки;

	УбратьЗеркалоПула("/office/mirrors/owned", Кука, Ид);
	ПереключитьПубликациюПула(Раздел, Кука, Истина);

КонецПроцедуры

// Тумблер публикации пула через штатную форму раздела «Апстримы».
// Тумблер раздела «Теги» дома пула: включённый шлёт «1», выключенный — «0».
Процедура ПереключитьАвтоканалы(Знач Раздел, Знач Кука, Знач Включить)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, Кука))));
	Поля.Вставить("операция", "каналы");
	Поля.Вставить("автоканалы", ?(Включить, "1", "0"));

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, Поля, Кука)),
		"тумблер автоканалов переключён").ЭтоИстина();

КонецПроцедуры

// Состояние тумблера на странице: у включённого чекбокса есть «checked». Парное скрытое
// поле выключенного значения носит то же имя, поэтому ищется именно чекбокс.
Функция ТумблерВключён(Знач Разметка, Знач ИмяПоля)

	Маркер = "name=""" + ИмяПоля + """";
	Хвост = Разметка;
	Позиция = СтрНайти(Хвост, "<input");

	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция);
		Конец = СтрНайти(Хвост, ">");
		Поле = ?(Конец = 0, Хвост, Лев(Хвост, Конец));
		Если СтрНайти(Поле, Маркер) > 0 И СтрНайти(Поле, "type=""checkbox""") > 0 Тогда
			Возврат СтрНайти(Поле, "checked") > 0;
		КонецЕсли;
		Хвост = Сред(Хвост, 7);
		Позиция = СтрНайти(Хвост, "<input");
	КонецЦикла;

	ВызватьИсключение "Тумблера «" + ИмяПоля + "» на странице нет";

КонецФункции

Процедура ПереключитьПубликациюПула(Знач Раздел, Знач Кука, Знач Разрешить)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, Кука))));
	Поля.Вставить("операция", "флаги");
	Если Разрешить Тогда
		Поля.Вставить("публикация", "1");
	КонецЕсли;

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, Поля, Кука)),
		"тумблер публикации переключён").ЭтоИстина();

КонецПроцедуры

// Заводит зеркало пула штатной формой обзора; возвращает его идентификатор.
// Апстрим называет вызывающий: у соседнего теста набора он другой, и брошенное зеркало
// не встретится с чужим как дубль.
Функция ЗавестиЗеркалоПула(Знач Обзор, Знач Кука, Знач Апстрим)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Обзор, Кука))));
	Поля.Вставить("url", Апстрим);
	Поля.Вставить("режим", "opm");
	Поля.Вставить("интервал", "600");

	Ответ = Клиент.POSTФормы(Обзор, Поля, Кука);
	Ожидаем.Что(УспехМутации(Ответ), "форма зеркала принята: " + Тело(Ответ)).ЭтоИстина();
	Возврат ИдЗеркалаИзСсылки(Тело(Клиент.GETСКукой(Обзор, Кука)));

КонецФункции

Процедура УбратьЗеркалоПула(Знач Обзор, Знач Кука, Знач Ид)

	Если НЕ ЗначениеЗаполнено(Ид) Тогда
		Возврат;
	КонецЕсли;
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Обзор, Кука))));
	Клиент.POSTФормы(Обзор + "/" + Ид + "/delete", Поля, Кука);

КонецПроцедуры

&Тест
Процедура ИзОбзораЗеркалЕстьХодНаЭкранСостоянияВДомеПула() Экспорт

	// кабинет своего экрана состояния не заводит: обзор ведёт в дом пула, и адрес
	// из ссылки обязан отвечать живой страницей
	Кука = Клиент.Войти("owner1", "Owner1Passw0rd");
	Обзор = "/office/mirrors/owned";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Обзор, Кука)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("url", "http://127.0.0.1:9/download/");
	Поля.Вставить("режим", "opm");
	Поля.Вставить("интервал", "600");
	Ответ = Клиент.POSTФормы(Обзор, Поля, Кука);
	Ожидаем.Что(УспехМутации(Ответ), "зеркало заведено: " + Тело(Ответ)).ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Обзор, Кука));
	Ид = ИдЗеркалаИзСсылки(Список);
	Ожидаем.Что(ЗначениеЗаполнено(Ид),
		"обзор кабинета ведёт на экран состояния в доме пула: " + Список).ЭтоИстина();

	Экран = "/owned/settings/mirrors/" + Ид;

	ОтветЭкрана = Клиент.GETСКукой(Экран, Кука);
	Ожидаем.Что(ОтветЭкрана.КодСостояния, "экран состояния отдан").Равно(200);

	Страница = Тело(ОтветЭкрана);
	Ожидаем.Что(СтрНайти(Страница, "127.0.0.1:9") > 0, "экран показывает это зеркало").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "Счётчики прогона") > 0, "счётчики прогона на экране").ЭтоИстина();

	Ожидаем.Что(Клиент.POSTФормы(Экран, Поля, Кука).КодСостояния,
		"экран состояния ничего не мутирует — POST не разрешён").Равно(405);
	// клиент проходит редирект сам, поэтому судим по содержимому: аноним получает вход
	Ожидаем.Что(СтрНайти(Тело(Клиент.GET(Экран)), "Счётчики прогона"),
		"аноним состояния чужого зеркала не видит").Равно(0);

	// «синхронизировать сейчас»: кабинет ставит заявку и уходит, репликацию ведёт фоновый
	// рабочий. Апстрим заведомо мёртв (loopback-порт 9) — прогон обязан закончиться внятным
	// итогом, а не молчаливым списком
	ОтветСинка = Клиент.POSTФормы(Обзор + "/" + Ид + "/sync", Поля, Кука);
	Ожидаем.Что(УспехМутации(ОтветСинка), "заявка принята и не уронила раздел").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(ОтветСинка), "поставлено в очередь синхронизации") > 0,
		"после нажатия экран говорит, что произошло: " + Тело(ОтветСинка)).ЭтоИстина();

	// ЗВЕНО «кнопка → поставлено»: заявка обязана доехать до ЗАПИСИ зеркала, иначе экран
	// показывает простой и кнопка выглядит не сработавшей. Судим по инициатору: до нажатия
	// экран печатал «по расписанию», а нажатие обязано записать логин в колонку прогона
	СтраницаПослеСинка = Тело(Клиент.GETСКукой(Экран, Кука));
	Ожидаем.Что(СтрНайти(СтраницаПослеСинка, "по расписанию"),
		"прогон больше не безымянный: кнопка записала инициатора в состояние прогона: "
		+ СтраницаПослеСинка).Равно(0);

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Обзор + "/" + Ид + "/delete", Поля, Кука)),
		"зеркало убрано за собой").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ИзНастроекЗеркалированияЧеловекДоходитДоСвоегоЗеркала() Экспорт

	// Обзор зеркал живёт на своём адресе, пункта в дереве разделов у него нет. Зеркало
	// тест заводит прямой формой — это подготовка; РАЗЫСКИВАЕТ он его обходом ссылок
	// от раздела, где настроено зеркалирование, ровно как человек, который зеркало
	// ищет, а не вспоминает адрес.
	Кука = Клиент.Войти("root", "RootPassw0rd");
	Обзор = "/office/mirrors/owned";
	// свой порт апстрима: у соседних тестов набора он другой, и брошенное зеркало
	// не встретится с чужим как дубль. Он же — примета зеркала на странице
	ПриметаЗеркала = "127.0.0.1:7";

	Ид = ЗавестиЗеркалоПула(Обзор, Кука, "http://" + ПриметаЗеркала + "/download/");
	Ожидаем.Что(ЗначениеЗаполнено(Ид), "зеркало, которое предстоит разыскать, заведено").ЭтоИстина();

	Попытка

		АдресГдеВидноЗеркало = АдресДостижимойСтраницы("/hub/settings/mirrors", Кука,
			ПриметаЗеркала, 2);
		Ожидаем.Что(ЗначениеЗаполнено(АдресГдеВидноЗеркало),
			"из раздела «Зеркалирование» по ссылкам виден список зеркал с заведённым зеркалом")
			.ЭтоИстина();

	Исключение
		УбратьЗеркалоПула(Обзор, Кука, Ид);
		ВызватьИсключение;
	КонецПопытки;

	УбратьЗеркалоПула(Обзор, Кука, Ид);

КонецПроцедуры

// Обход интерфейса по ссылкам вширь: адрес первой страницы в пределах Глубины переходов
// от Начала, в разметке которой встретился Признак; "" — такой страницы нет.
Функция АдресДостижимойСтраницы(Знач Начало, Знач Кука, Знач Признак, Знач Глубина)

	Посещённые = Новый Соответствие();
	Посещённые.Вставить(Начало, Истина);

	Фронт = ВнутренниеСсылки(РазметкаСтраницы(Начало, Кука));
	Шаг = 1;

	Пока Шаг <= Глубина Цикл

		Следующий = Новый Массив();
		Для Каждого Адрес Из Фронт Цикл

			Если Посещённые.Получить(Адрес) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Посещённые.Вставить(Адрес, Истина);

			Страница = РазметкаСтраницы(Адрес, Кука);
			Если СтрНайти(Страница, Признак) > 0 Тогда
				Возврат Адрес;
			КонецЕсли;

			Если Шаг < Глубина Тогда
				Для Каждого Ссылка Из ВнутренниеСсылки(Страница) Цикл
					Следующий.Добавить(Ссылка);
				КонецЦикла;
			КонецЕсли;

		КонецЦикла;

		Фронт = Следующий;
		Шаг = Шаг + 1;

	КонецЦикла;

	Возврат "";

КонецФункции

// Разметка страницы без гейтов ритма форм: обход читает десятки чужих страниц, и предмет
// проверки здесь — дорога, а не вёрстка.
Функция РазметкаСтраницы(Знач Путь, Знач Кука)
	Возврат Клиент.GETСКукой(Путь, Кука).ПолучитьТелоКакСтроку();
КонецФункции

// Адреса, по которым обход идёт дальше: ссылки внутрь хаба. Ресурсы, якоря и чужие сайты
// дорогой к экрану не бывают.
Функция ВнутренниеСсылки(Знач Страница)

	Результат = Новый Массив();
	Маркер = "href=""";
	Хвост = Страница;

	Позиция = СтрНайти(Хвост, Маркер);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, """");
		Если Конец > 1 Тогда
			Адрес = Лев(Хвост, Конец - 1);
			Если АдресВнутриХаба(Адрес) Тогда
				Результат.Добавить(Адрес);
			КонецЕсли;
		КонецЕсли;
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция АдресВнутриХаба(Знач Адрес)

	Возврат Лев(Адрес, 1) = "/"
		И Лев(Адрес, 2) <> "//"
		И СтрНайти(Адрес, "#") = 0
		И НЕ СтрНачинаетсяС(Адрес, "/static/")
		И НЕ СтрНачинаетсяС(Адрес, "/brand/");

КонецФункции

// Идентификатор зеркала из ссылки обзора кабинета на дом пула; "" — ссылки нет.
Функция ИдЗеркалаИзСсылки(Знач Разметка)

	Маркер = "href=""/owned/settings/mirrors/";
	Позиция = СтрНайти(Разметка, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Разметка, Позиция + СтрДлина(Маркер));
	Конец = СтрНайти(Хвост, """");
	Возврат ?(Конец > 1, Лев(Хвост, Конец - 1), "");

КонецФункции

// Отзывает выданное в предыдущем тесте право (чтобы витрина не осталась засорённой для
// остальных тестов набора, которые смотрят на те же страницы).
Процедура Снять(Знач Кука, Знач Токен, Знач ИмяПула)

	ОтозватьРольНаПул(ЭкранПравПула(ИмяПула), Токен, Кука, "bob");

КонецПроцедуры

&Тест
Процедура КроссПуловыйГрантОтклонён() Экспорт

	// Раздел прав ПУЛ-ОГРАНИЧЕН маршрутом: объект берётся из адреса, а не из формы.
	// Поля «объект»/«объект_ид»/«пул» здесь не источник данных, а предмет сверки —
	// подделанное значение обязано дать отказ, а не сработать «на том, что нашлось».
	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");
	СвойЭкран = ЭкранПравПула("owned");
	ТокенOwner = ИзвлечьCSRF(Тело(Клиент.GETСКукой(СвойЭкран, КукаOwner)));

	ИдOwned = ИдПулаИзОбзора(Тело(Клиент.GETСКукой(АдресПулов(), ВойтиRoot())), "owned");
	ИдPublic = ИдПулаИзОбзора(Тело(Клиент.GETСКукой(АдресПулов(), ВойтиRoot())), "public");
	Ожидаем.Что(ИдPublic <> ИдOwned, "пулы public и owned различны").ЭтоИстина();

	// 0. в лоб чужой экран — гвард дома пула не пускает вовсе
	Ожидаем.Что(Клиент.GETСКукой(ЭкранПравПула("public"), КукаOwner).КодСостояния,
		"чужой пул: раздел прав → 403").Равно(403);

	// 1. подставлен ЧУЖОЙ пул в поле формы своего экрана
	АтакаПул = Новый Соответствие();
	АтакаПул.Вставить("_csrf", ТокенOwner);
	АтакаПул.Вставить("пул", Формат(ИдPublic, "ЧГ=0"));
	АтакаПул.Вставить("объект", "пул");
	АтакаПул.Вставить("операция", "выдать");
	АтакаПул.Вставить("тип_субъекта", "пользователь");
	АтакаПул.Вставить("субъект", "owner1");
	АтакаПул.Вставить("роль", "мейнтейнер");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(СвойЭкран, АтакаПул, КукаOwner)),
		"подставленный чужой пул отбит").ЭтоЛожь();

	// 2. НАСТОЯЩИЙ кросс-пуловый IDOR: объект — ПАКЕТ чужого пула. Раздел управляет
	//    правами только на свой ПУЛ, поэтому чужой объект не проходит по типу.
	ИдЧужогоПакета = ИдПакетаИзAPI("public", "alice-pkg");
	Ожидаем.Что(ИдЧужогоПакета > 0, "идентификатор чужого пакета получен из API").ЭтоИстина();

	АтакаПакет = Новый Соответствие();
	АтакаПакет.Вставить("_csrf", ТокенOwner);
	АтакаПакет.Вставить("объект", "пакет");
	АтакаПакет.Вставить("объект_ид", Формат(ИдЧужогоПакета, "ЧГ=0"));
	АтакаПакет.Вставить("операция", "выдать");
	АтакаПакет.Вставить("тип_субъекта", "пользователь");
	АтакаПакет.Вставить("субъект", "owner1");
	АтакаПакет.Вставить("роль", "мейнтейнер");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(СвойЭкран, АтакаПакет, КукаOwner)),
		"пакет чужого пула с экрана прав пула отбит").ЭтоЛожь();

	// 3. упразднённый тип объекта — отказ, а не 404/500 и тем более не выдача
	АтакаЛегаси = Новый Соответствие();
	АтакаЛегаси.Вставить("_csrf", ТокенOwner);
	АтакаЛегаси.Вставить("объект", "группа_пакетов");
	АтакаЛегаси.Вставить("объект_ид", Формат(ИдPublic, "ЧГ=0"));
	АтакаЛегаси.Вставить("операция", "выдать");
	АтакаЛегаси.Вставить("тип_субъекта", "пользователь");
	АтакаЛегаси.Вставить("субъект", "owner1");
	АтакаЛегаси.Вставить("роль", "мейнтейнер");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(СвойЭкран, АтакаЛегаси, КукаOwner)),
		"упразднённый тип объекта отбит").ЭтоЛожь();

	// 4. «хаб» — тип законный, но раздел пул-ограниченный: хаб-гранты выдаёт только
	//    администратор хаба, и владелец пула этим путём их не получит.
	АтакаХаб = Новый Соответствие();
	АтакаХаб.Вставить("_csrf", ТокенOwner);
	АтакаХаб.Вставить("объект", "хаб");
	АтакаХаб.Вставить("объект_ид", "0");
	АтакаХаб.Вставить("операция", "выдать");
	АтакаХаб.Вставить("тип_субъекта", "пользователь");
	АтакаХаб.Вставить("субъект", "owner1");
	АтакаХаб.Вставить("роль", "мейнтейнер");
	ОтветХаб = Клиент.POSTФормы(СвойЭкран, АтакаХаб, КукаOwner);
	Ожидаем.Что(УспехМутации(ОтветХаб), "хаб-грант с экрана пула отбит").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Тело(ОтветХаб), "только на свой пул") > 0,
		"причина названа: раздел работает только со своим пулом").ЭтоИстина();

	// 5. чужой пул назван ОБЩИМ именем идентификатора: сверка не зависит от того, каким
	//    из имён форма назвала объект (пакетный экран исторически звал его «объект_ид»)
	АтакаОбщееИмя = Новый Соответствие();
	АтакаОбщееИмя.Вставить("_csrf", ТокенOwner);
	АтакаОбщееИмя.Вставить("объект_ид", Формат(ИдPublic, "ЧГ=0"));
	АтакаОбщееИмя.Вставить("операция", "выдать");
	АтакаОбщееИмя.Вставить("тип_субъекта", "пользователь");
	АтакаОбщееИмя.Вставить("субъект", "owner1");
	АтакаОбщееИмя.Вставить("роль", "мейнтейнер");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(СвойЭкран, АтакаОбщееИмя, КукаOwner)),
		"чужой пул в поле «объект_ид» отбит").ЭтоЛожь();

	// 6. назван объект ЧУЖОГО вида: раздел пула пакетами не распоряжается вовсе
	АтакаЧужойВид = Новый Соответствие();
	АтакаЧужойВид.Вставить("_csrf", ТокенOwner);
	АтакаЧужойВид.Вставить("пакет", Формат(ИдЧужогоПакета, "ЧГ=0"));
	АтакаЧужойВид.Вставить("операция", "выдать");
	АтакаЧужойВид.Вставить("тип_субъекта", "пользователь");
	АтакаЧужойВид.Вставить("субъект", "owner1");
	АтакаЧужойВид.Вставить("роль", "мейнтейнер");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(СвойЭкран, АтакаЧужойВид, КукаOwner)),
		"пакет в форме раздела прав пула отбит").ЭтоЛожь();

	// ГЛАВНОЕ: ни одна из шести подделок ничего не записала. Код ответа без этой
	// проверки ничего не стоит — отказ обязан оставить базу в прежнем состоянии.
	ЧужойЭкран = Тело(Клиент.GETСКукой(ЭкранПравПула("public"), ВойтиRoot()));
	Ожидаем.Что(СтрНайти(ЧужойЭкран, "<td>owner1</td>"),
		"в правах чужого пула owner1 не появился").Равно(0);

КонецПроцедуры

// Идентификатор пакета — из публичного API v2 (карточка пакета отдаёт «id»). В UI кабинета
// идентификаторы пакетов не показываются, а тесту кросс-пулового IDOR нужен НАСТОЯЩИЙ
// идентификатор чужого объекта: подставленный наугад проверял бы 404, а не отказ по правам.
Функция ИдПакетаИзAPI(Знач ИмяПула, Знач ИмяПакета)

	Тело_ = Тело(Клиент.GET(СтрШаблон("/api/v1/pools/%1/packages/%2", ИмяПула, ИмяПакета)));
	Поз = СтрНайти(Тело_, """id""");
	Если Поз = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Цифры = "";
	Для Индекс = Поз + 4 По СтрДлина(Тело_) Цикл
		С = Сред(Тело_, Индекс, 1);
		Если С >= "0" И С <= "9" Тогда
			Цифры = Цифры + С;
		ИначеЕсли ЗначениеЗаполнено(Цифры) Тогда
			Прервать;
		ИначеЕсли С <> ":" И С <> " " Тогда
			Возврат 0;   // за ключом идёт не число — карточка не та, что ожидали
		КонецЕсли;
	КонецЦикла;
	Возврат ?(ЗначениеЗаполнено(Цифры), Число(Цифры), 0);

КонецФункции

&Тест
Процедура АдресГруппПакетовВедётРедиректом() Экспорт

	Кука = ВойтиRoot();
	ИдPublic = ИдПулаИзОбзора(Тело(Клиент.GETСКукой(АдресПулов(), Кука)), "public");

	// клиент проходит по редиректу сам, поэтому смотрим на обе формы ответа: либо 3xx с
	// Location, либо уже отрисованную целевую страницу
	ОтветGET = Клиент.GETСКукой(СтрШаблон("/office/access/groups?pool=%1", ИдPublic), Кука);
	Ожидаем.Что(ОтветGET.КодСостояния < 400,
		"старый адрес не отдаёт ошибку (код " + Формат(ОтветGET.КодСостояния, "ЧГ=0") + ")").ЭтоИстина();
	// адрес несёт пул, поэтому ведёт не в общий список, а в права ЭТОГО пула
	Если Редирект(ОтветGET) Тогда
		Ожидаем.Что(СтрНайти(Клиент.ЗаголовокОтвета(ОтветGET, "Location"), "/settings/access") > 0,
			"редирект ведёт в раздел прав пула").ЭтоИстина();
	Иначе
		Ожидаем.Что(СтрНайти(Тело(ОтветGET), "Выдать роль на пул") > 0,
			"клиент доехал до раздела прав пула").ЭтоИстина();
	КонецЕсли;

	// POST старой формы (без CSRF — страницы, которая его выдавала, больше нет)
	ПоляСтарые = Новый Соответствие();
	ПоляСтарые.Вставить("пул", Формат(ИдPublic, "ЧГ=0"));
	ПоляСтарые.Вставить("действие", "создать");
	ПоляСтарые.Вставить("имя", "victimgrp");
	ОтветPOST = Клиент.POSTФормы("/office/access/groups", ПоляСтарые, Кука);
	Ожидаем.Что(ОтветPOST.КодСостояния < 400,
		"POST старой формы не отдаёт ошибку (редирект, а не 404/405/500)").ЭтоИстина();

	// самой страницы групп больше нет ни под каким адресом
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(АдресПулов(), Кука)), "группы пакетов"),
		"ссылки на группы пакетов в обзоре нет").Равно(0);

КонецПроцедуры

// --- этап 4: управление вебхуками пула в кабинете (UI + права + CSRF + SSRF) ---

&Тест
Процедура АдминСоздаётИВидитВебхукПула() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd"); // хаб-админ администрирует любой пул
	Страница = "/public/settings/webhooks";

	Стр = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(Стр, "Подписки на события") > 0, "страница подписок пула открыта").ЭтоИстина();
	Токен = ИзвлечьCSRF(Стр);

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	// с 7.C форма подписки ВСЕГДА присылает тип действия (селектор ФормыДействияПодписки):
	// типа по умолчанию у раздела нет — иначе «вебхук» был бы зашит в слое представления
	Поля.Вставить("тип_действия", "вебхук");
	Поля.Вставить("url", "https://hooks.example.com/openhub");
	Поля.Вставить("событие_0", "1"); // версия.опубликована
	ОтветСоздания = Клиент.POSTФормы(Страница, Поля, Кука);

	// секрет показывается один раз на странице результата создания
	ТелоСоздания = Тело(ОтветСоздания);
	Ожидаем.Что(СтрНайти(ТелоСоздания, "Скопируйте секрет") > 0, "секрет показан один раз при создании").ЭтоИстина();

	// вебхук виден в списке; секрет в списке НЕ раскрыт (маскирован)
	СтрСписка = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(СтрСписка, "hooks.example.com/openhub") > 0, "вебхук в списке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрСписка, "Секрет подписи скрыт") > 0, "секрет в списке маскирован").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеВладелецПулаПолучает403НаВебхуки() Экспорт
	// bob не владеет пулом public → страница и мутации вебхуков запрещены
	Кука = Клиент.Войти("bob", "BobPassw0rd");
	Ожидаем.Что(Клиент.GETСКукой("/public/settings/webhooks", Кука).КодСостояния, "не-владелец: 403 на страницу").Равно(403);

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", "нет");
	// с 7.C форма подписки ВСЕГДА присылает тип действия (селектор ФормыДействияПодписки):
	// типа по умолчанию у раздела нет — иначе «вебхук» был бы зашит в слое представления
	Поля.Вставить("тип_действия", "вебхук");
	Поля.Вставить("url", "https://evil.example.com/x");
	Поля.Вставить("событие_0", "1");
	Ожидаем.Что(Клиент.POSTФормы("/public/settings/webhooks", Поля, Кука).КодСостояния, "не-владелец: 403 на создание").Равно(403);
КонецПроцедуры

&Тест
Процедура СозданиеВебхукаБезCSRFОтклонено() Экспорт
	Кука = Клиент.Войти("root", "RootPassw0rd");
	Поля = Новый Соответствие();
	// с 7.C форма подписки ВСЕГДА присылает тип действия (селектор ФормыДействияПодписки):
	// типа по умолчанию у раздела нет — иначе «вебхук» был бы зашит в слое представления
	Поля.Вставить("тип_действия", "вебхук");
	Поля.Вставить("url", "https://hooks.example.com/nocsrf");
	Поля.Вставить("событие_0", "1");
	Ожидаем.Что(Клиент.POSTФормы("/public/settings/webhooks", Поля, Кука).КодСостояния,
		"создание без CSRF отклонено").Равно(403);
КонецПроцедуры

// НФТ-ДОСТ-004: подделанный токен формы отбивается на КАЖДОЙ мутирующей дороге кабинета
// и домов настроек, а не только там, где о нём вспомнили. Принципал у каждой дороги
// законный — гвард пропускает, и отказ даёт именно токен; идентификаторы взяты
// несуществующие — токен смотрят до того, как ищут предмет.
&Тест
Процедура ПодделанныйТокенОтбиваетсяНаЧетырнадцатиМутирующихДорогах() Экспорт

	КукаRoot = ВойтиRoot();
	КукаВладельца = Клиент.Войти("owner1", "Owner1Passw0rd");
	КукаAlice = Клиент.Войти("alice", "AlicePassw0rd");

	Дороги = Новый Массив();
	Дороги.Добавить(Дорога("/hub/settings/users", КукаRoot));
	Дороги.Добавить(Дорога("/hub/settings/groups", КукаRoot));
	Дороги.Добавить(Дорога("/owned/settings/mirrors", КукаВладельца));
	Дороги.Добавить(Дорога("/owned/settings/mirrors/999999/toggle", КукаВладельца));
	Дороги.Добавить(Дорога("/owned/settings/mirrors/999999/sync", КукаВладельца));
	Дороги.Добавить(Дорога("/owned/settings/mirrors/999999/token-off", КукаВладельца));
	Дороги.Добавить(Дорога("/owned/settings/mirrors/999999/delete", КукаВладельца));
	Дороги.Добавить(Дорога("/office/mirrors/owned", КукаВладельца));
	Дороги.Добавить(Дорога("/office/mirrors/owned/999999/toggle", КукаВладельца));
	Дороги.Добавить(Дорога("/office/mirrors/owned/999999/sync", КукаВладельца));
	Дороги.Добавить(Дорога("/office/mirrors/owned/999999/delete", КукаВладельца));
	Дороги.Добавить(Дорога("/me/settings/oidc/unlink", КукаAlice));
	Дороги.Добавить(Дорога("/me/inbox", КукаAlice));
	Дороги.Добавить(Дорога("/me/notifications", КукаAlice));

	Для Каждого Дорога_ Из Дороги Цикл
		Поля = Новый Соответствие();
		Поля.Вставить("_csrf", "деадбиф");
		Ожидаем.Что(Клиент.POSTФормы(Дорога_.Адрес, Поля, Дорога_.Кука).КодСостояния,
			"подделанный токен отбит на " + Дорога_.Адрес).Равно(403);
	КонецЦикла;

КонецПроцедуры

Функция Дорога(Знач Адрес, Знач Кука)
	Возврат Новый Структура("Адрес, Кука", Адрес, Кука);
КонецФункции

// НФТ-ПОДП-002: цель во внутренней сети — законный выбор мейнтейнера, и кабинет её
// принимает. Отвергается только то, что адресом не является (следующий тест).
&Тест
Процедура ЦельВоВнутреннейСетиПринимаетсяUI() Экспорт
	Кука = Клиент.Войти("root", "RootPassw0rd");
	Страница = "/public/settings/webhooks";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	// с 7.C форма подписки ВСЕГДА присылает тип действия (селектор ФормыДействияПодписки):
	// типа по умолчанию у раздела нет — иначе «вебхук» был бы зашит в слое представления
	Поля.Вставить("тип_действия", "вебхук");
	Поля.Вставить("url", "https://127.0.0.1:9443/hook");
	Поля.Вставить("событие_0", "1");
	БылоПодписок = ЧислоПодписок(Тело(Клиент.GETСКукой(Страница, Кука)));
	Ответ = Клиент.POSTФормы(Страница, Поля, Кука);

	Ожидаем.Что(Ответ.КодСостояния, "заведение приватной цели не отбивается").Равно(200);
	Ожидаем.Что(ЧислоПодписок(Тело(Клиент.GETСКукой(Страница, Кука))),
		"подписка на приёмник в своей сети заведена").Равно(БылоПодписок + 1);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "127.0.0.1:9443") > 0,
		"и видна в списке раздела").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура НеАдресОтклонёнUI() Экспорт
	Кука = Клиент.Войти("root", "RootPassw0rd");
	Страница = "/public/settings/webhooks";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));

	// строка без схемы адресом не является — создание не проходит, страница показывает ошибку
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("тип_действия", "вебхук");
	Поля.Вставить("url", "не-адрес-вовсе");
	Поля.Вставить("событие_0", "1");
	БылоПодписок = ЧислоПодписок(Тело(Клиент.GETСКукой(Страница, Кука)));
	Ответ = Клиент.POSTФормы(Страница, Поля, Кука);

	// ФАКТ важнее причины (ревью М-6): раньше тест смотрел только на слово в теле
	// и прошёл бы, даже если бы подписка при этом создалась.
	Ожидаем.Что(Ответ.КодСостояния, "отказ отдаётся кодом 400, как в остальных домах").Равно(400);
	Ожидаем.Что(ЧислоПодписок(Тело(Клиент.GETСКукой(Страница, Кука))),
		"ни одной новой подписки не появилось").Равно(БылоПодписок);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "не-адрес-вовсе"), "мусор не сохранён").Равно(0);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Скопируйте секрет"), "секрет не выдан на отклонённый URL").Равно(0);
	// ПРИЧИНА ПРОВЕРЯЕТСЯ МАРКЕРОМ, КОТОРОГО НА ОБЫЧНОЙ СТРАНИЦЕ НЕТ (находка ревью З-4):
	// иначе ассерт проходил бы и без всякого отказа, на подсказке поля.
	Маркер = "Недопустимый URL вебхука";
	Ожидаем.Что(СтрНайти(Тело(Ответ), Маркер) > 0, "показана причина отказа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), Маркер),
		"ассерт причины не пуст: на обычной странице раздела этого маркера нет").Равно(0);
КонецПроцедуры

&Тест
Процедура АдресСУправляющимиСимволамиОтклонён() Экспорт

	// РЕВЬЮ В-4: «%0D%0AX-Evil:+1» доезжает до валидатора настоящими CR/LF и пробелом и
	// рвал строку журнала доставки надвое. Проверяем ФАКТ: подписка не создана.
	Кука = Клиент.Войти("root", "RootPassw0rd");
	Страница = "/public/settings/webhooks";
	БылоПодписок = ЧислоПодписок(Тело(Клиент.GETСКукой(Страница, Кука)));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука))));
	// с 7.C форма подписки ВСЕГДА присылает тип действия (селектор ФормыДействияПодписки):
	// типа по умолчанию у раздела нет — иначе «вебхук» был бы зашит в слое представления
	Поля.Вставить("тип_действия", "вебхук");
	Поля.Вставить("url", "https://crlf.example.com/a" + Символы.ВК + Символы.ПС + "X-Evil: 1");
	Поля.Вставить("событие_0", "1");
	Ответ = Клиент.POSTФормы(Страница, Поля, Кука);

	Ожидаем.Что(Ответ.КодСостояния, "адрес с CR/LF отклонён").Равно(400);
	Ожидаем.Что(ЧислоПодписок(Тело(Клиент.GETСКукой(Страница, Кука))),
		"подписка с управляющими символами не создана").Равно(БылоПодписок);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "crlf.example.com"),
		"её нет и в списке").Равно(0);

КонецПроцедуры

&Тест
Процедура ФормаПодписокБезJSРаботаетДляКаждогоТипа() Экспорт

	// НАХОДКА РЕВЬЮ З-2: второй тип действия не был покрыт НИ ОДНИМ интеграционным
	// тестом — «chat-id» жил только в юнитах через прямое инстанцирование, а
	// «тип_действия» везде равнялся «вебхук». Если бы боевой контейнер не собрал
	// РендерНастроекTelegram, форма молча рисовала бы один тип, и все наборы остались бы
	// зелёными: ровно поверхность «второго входа» желудя. Здесь проверяется ЖИВАЯ
	// страница и полный путь ВТОРОГО типа — от селектора до записи в списке.
	Кука = Клиент.Войти("root", "RootPassw0rd");
	Страница = "/public/settings/webhooks";
	Стр = Тело(Клиент.GETСКукой(Страница, Кука));

	Ожидаем.Что(СтрНайти(Стр, "name=""тип_действия""") > 0, "тип действия на реальной странице").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "[?"), "ни одного маркера потерянного ключа словаря").Равно(0);
	// required у поля чужого типа заблокировал бы отправку формы в браузере без JS
	Ожидаем.Что(СтрНайти(Стр, "required"), "required не печатается").Равно(0);

	// набор полей выбирается ССЫЛКОЙ: у каждого типа свой адрес, JS в переключении не участвует
	АдресВебхука = Страница + "?kind=" + КодироватьСтроку("вебхук", СпособКодированияСтроки.КодировкаURL);
	СтрВебхук = Тело(Клиент.GETСКукой(АдресВебхука, Кука));
	Ожидаем.Что(СтрНайти(СтрВебхук, "name=""url""") > 0, "поле вебхука на его наборе").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрВебхук, "name=""chat-id"""), "и ни одного поля чужого типа").Равно(0);

	СтрТелеграм = Тело(Клиент.GETСКукой(Страница + "?kind=telegram", Кука));
	Ожидаем.Что(СтрНайти(СтрТелеграм, "name=""chat-id""") > 0, "поле telegram на его наборе").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрТелеграм, "name=""бот-токен""") > 0, "и поле своего токена бота").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрТелеграм, "name=""шаблон-текста""") > 0, "и поле своего текста").ЭтоИстина();
	// смотрим ФОРМУ ЗАВЕДЕНИЯ: в карточках уже заведённых вебхуков поле url законное
	Ожидаем.Что(СтрНайти(ХвостПосле(СтрТелеграм, "choice-row"), "name=""url"""),
		"полей вебхука на форме заведения telegram нет").Равно(0);
	Ожидаем.Что(СтрНайти(СтрТелеграм, "{пакет}") > 0,
		"перечень плейсхолдеров показан рядом с полем шаблона").ЭтоИстина();

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(СтрТелеграм));
	Поля.Вставить("тип_действия", "telegram");
	Поля.Вставить("chat-id", "-1001234567890");
	Поля.Вставить("бот-токен", "424242:zhivoy-token-podpiski");
	Поля.Вставить("шаблон-текста", "{событие}: {пакет} {версия}");
	Поля.Вставить("событие_0", "1");
	Ответ = Клиент.POSTФормы(Страница, Поля, Кука);

	Ожидаем.Что(Ответ.КодСостояния < 400,
		"подписка второго типа заводится формой: " + Формат(Ответ.КодСостояния, "ЧГ=0")).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Ответ), "zhivoy-token-podpiski"),
		"страница результата создания токен не печатает").Равно(0);
	СписокПосле = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(СписокПосле, "-1001234567890") > 0,
		"telegram-подписка видна в списке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СписокПосле, "zhivoy-token-podpiski"),
		"а токен её бота не печатается на живой странице").Равно(0);
	Ожидаем.Что(СтрНайти(СписокПосле, "свой бот") > 0, "виден только признак «свой бот»").ЭтоИстина();

	// поле чужого типа, подсунутое подделанной формой, отбивает сервер
	ПоляЧужого = Новый Соответствие();
	ПоляЧужого.Вставить("_csrf", ИзвлечьCSRF(СписокПосле));
	ПоляЧужого.Вставить("тип_действия", "telegram");
	ПоляЧужого.Вставить("chat-id", "-100999");
	ПоляЧужого.Вставить("url", "https://hooks.example.com/чужое");
	ПоляЧужого.Вставить("событие_0", "1");
	ОтветЧужого = Клиент.POSTФормы(Страница, ПоляЧужого, Кука);

	Ожидаем.Что(ОтветЧужого.КодСостояния, "поле чужого типа — 400").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(ОтветЧужого), "не относится к действию") > 0,
		"причина названа словами").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "-100999"),
		"подписка с чужим полем не создана").Равно(0);

	// POST без селектора — внятный отказ словами, а не 500
	ПоляБезТипа = Новый Соответствие();
	ПоляБезТипа.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука))));
	ПоляБезТипа.Вставить("url", "https://hooks.example.com/notype");
	ПоляБезТипа.Вставить("событие_0", "1");
	ОтветБезТипа = Клиент.POSTФормы(Страница, ПоляБезТипа, Кука);

	Ожидаем.Что(ОтветБезТипа.КодСостояния, "POST без типа — 400, а не 500").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(ОтветБезТипа), "Не выбран тип действия") > 0,
		"причина названа словами").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПравкаПодпискиМеняетЕёИНеПринимаетЧужойИдентификатор() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Страница = "/public/settings/webhooks";

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука))));
	Поля.Вставить("тип_действия", "вебхук");
	Поля.Вставить("url", "https://hooks.example.com/pravka-do");
	Поля.Вставить("событие_0", "1");
	Ожидаем.Что(Клиент.POSTФормы(Страница, Поля, Кука).КодСостояния < 400, "подписка заведена").ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Страница, Кука));
	Ид = ИдПодпискиПоАдресу(Список, "pravka-do");

	Правка = Новый Соответствие();
	Правка.Вставить("_csrf", ИзвлечьCSRF(Список));
	Правка.Вставить("тип_действия", "вебхук");
	Правка.Вставить("url", "https://hooks.example.com/pravka-posle");
	Правка.Вставить("секрет", "");
	// имя литералом СОЗНАТЕЛЬНО: здесь проверяется сквозной путь по HTTP, а не связь
	// «напечатано = прочитано» — её стережёт ПодпискиUI.ФлажокСвоегоСекретаЧитаетсяПодНапечатаннымИменем,
	// который берёт имя из разметки формы правки
	Правка.Вставить("секрет-свой", "1");
	Правка.Вставить("событие_0", "1");
	Правка.Вставить("включить", "1");
	Ответ = Клиент.POSTФормы(Страница + "/" + Ид + "/save", Правка, Кука);

	Ожидаем.Что(Ответ.КодСостояния < 400,
		"правка принята: " + Формат(Ответ.КодСостояния, "ЧГ=0")).ЭтоИстина();
	ПослеПравки = Тело(Клиент.GETСКукой(Страница, Кука));
	Ожидаем.Что(СтрНайти(ПослеПравки, "pravka-posle") > 0, "адрес изменён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПослеПравки, "pravka-do"), "прежнего адреса не осталось").Равно(0);

	// чужой идентификатор — 404, а не молчаливое «ничего не произошло»
	Чужая = Новый Соответствие();
	Чужая.Вставить("_csrf", ИзвлечьCSRF(ПослеПравки));
	Чужая.Вставить("тип_действия", "вебхук");
	Чужая.Вставить("url", "https://hooks.example.com/chuzhaya");
	Чужая.Вставить("событие_0", "1");
	Ожидаем.Что(Клиент.POSTФормы(Страница + "/999999/save", Чужая, Кука).КодСостояния,
		"чужой идентификатор подписки — 404").Равно(404);

	// без CSRF правка не проходит
	БезТокена = Новый Соответствие();
	БезТокена.Вставить("тип_действия", "вебхук");
	БезТокена.Вставить("url", "https://hooks.example.com/bez-csrf");
	БезТокена.Вставить("событие_0", "1");
	Ожидаем.Что(Клиент.POSTФормы(Страница + "/" + Ид + "/save", БезТокена, Кука).КодСостояния,
		"правка без CSRF отклонена").Равно(403);

КонецПроцедуры

