// HTTP-интеграционные тесты приватной части: настоящий хаб на файловой БД, засеянной
// сидером ЗасеятьКабинет.os. Вход, кабинет, управление, CSRF, yank, PAT, админка.

#Использовать asserts
// 1connector — клиент, НЕ следующий редиректам: HTTPСоединение проходит переход сам,
// и адрес возврата (Location) штатным клиентом не наблюдаем вовсе
#Использовать 1connector
// раскладка статики кита: по ней тест находит базовый лист библиотеки
#Использовать oscript-ui
#Использовать "фикстуры"

Перем Хаб;             // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Порт;
Перем КаталогПроекта;
Перем РитмПолей;       // фикстура РитмФорм — сквозной гейт ритма форм (ревью 6.A Б-1)
Перем РядыИнлайнов;    // фикстура РядИнлайнов — сквозной гейт соседних атомарных инлайнов
Перем СтилиХаба;       // оба листа страницы (кит + инсталляция), прочитанные один раз

Перем КаталогСборкиЗаявок;  // временный каталог под .ospx очереди заявок
Перем ТокенBobДляPush;      // PAT bob — заявителя без прав, выпускается один раз
Перем ТокенPubДляPush;      // PAT pub — второй заявитель: очередь bob упирается в предел
Перем Клиент;               // фикстура КлиентХаба — все запросы к подопытному хабу

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	ТокенBobДляPush = "";
	ТокенPubДляPush = "";
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	Хаб = НовыйХаб();
	КаталогПроекта = Хаб.КаталогПроекта();
	// повторное подключение того же имени — ошибка, поэтому спрашиваем прямо, а не
	// глушим исключение пустым обработчиком (ревью 6.A, мелочь 4)
	РеестрФикстур.Подключить("РитмФорм");
	РеестрФикстур.Подключить("РядИнлайнов");
	// очередь заявок гоняется настоящим push, поэтому нужен настоящий .ospx
	РеестрФикстур.Подключить("ФикстураПакета");
	КаталогСборкиЗаявок = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-office-ospx-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КаталогСборкиЗаявок);
	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры", "ЗасеятьКабинет.os");

	Хаб.ФайловаяБаза("openhub-office");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	// фоновый доставщик вебхуков гасим: тесты проверяют UI/права/CSRF, а не реальную
	// сеть — иначе созданный в тесте вебхук ушёл бы POST'ом в интернет по расписанию.
	//
	// ДВОЙНОЕ подчёркивание не опечатка: провайдер ENV configor переводит "_" в ".", а
	// "__" в "_". Свойства зовутся oshub.webhooks.delivery_enabled/resolve_enabled, и с
	// одинарным подчёркиванием (как было до этой правки) получалась несуществующая
	// деталька …delivery.enabled — флаг молча не применялся, доставщик работал во всех
	// прогонах. Проверено логом хаба: «Доставщик вебхуков отключён» появляется только
	// при написании с "__".
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	// и резолв имён выключаем — тест не должен ходить в реальный DNS; SSRF-проверка в
	// UI-тесте использует IP-литерал (127.0.0.1), отбиваемый канонизацией без резолва.
	Хаб.Среда("OSHUB_WEBHOOKS_RESOLVE__ENABLED", "false");

	ЗапуститьСидер(Сидер);

	Хаб.Запустить();     // свободный порт + процесс + ожидание /health
	Порт = Хаб.Порт();
	Клиент = Новый КлиентХаба(Хаб, 20);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
	Попытка
		Если ЗначениеЗаполнено(КаталогСборкиЗаявок) И Новый Файл(КаталогСборкиЗаявок).Существует() Тогда
			УдалитьФайлы(КаталогСборкиЗаявок);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

// --- сценарии ---

// Поля формы, в которой встречается Маркер, — имя и значение ровно так, как их отправит
// браузер: один проход в порядке документа по input/select/textarea; `disabled` (в том
// числе унаследованный от `<fieldset disabled>`) не отправляется вовсе, невыбранные
// флажки и радиокнопки тоже, а на повторяющееся имя берётся ПЕРВОЕ значение — как их
// читает сервер (РазборФормы). Бросает исключение, если формы нет.
//
// Параметры:
//  Разметка - Строка - HTML страницы.
//  Маркер   - Строка - подстрока, по которой опознаётся нужная форма.
//
// Возвращаемое значение:
//  Соответствие - имя поля -> значение.
//
Функция ПоляФормыСо(Знач Разметка, Знач Маркер) Экспорт

	Позиция = СтрНайти(Разметка, Маркер);
	Если Позиция = 0 Тогда
		ВызватьИсключение "В разметке нет формы с маркером " + Маркер;
	КонецЕсли;

	// границы формы вокруг маркера
	Начало = 0;
	Хвост = Лев(Разметка, Позиция);
	Ищем = СтрНайти(Хвост, "<form");
	Пока Ищем > 0 Цикл
		Начало = Начало + Ищем;
		Хвост = Сред(Хвост, Ищем + 1);
		Ищем = СтрНайти(Хвост, "<form");
	КонецЦикла;
	Если Начало = 0 Тогда
		ВызватьИсключение "Маркер " + Маркер + " найден вне формы";
	КонецЕсли;

	Остаток = Сред(Разметка, Начало);
	Конец = СтрНайти(Остаток, "</form>");
	Форма = ?(Конец = 0, Остаток, Лев(Остаток, Конец));

	Возврат ПоляФормы(Форма);

КонецФункции

// Один проход по разметке формы в порядке документа — тот же порядок, в котором собирает
// запрос браузер, а значит и тот, в котором значения видит сервер.
Функция ПоляФормы(Знач Форма) Экспорт

	Результат = Новый Соответствие();
	Отключения = Новый Массив(); // стек <fieldset>: отключён ли он сам или его предок
	ИмяСписка = "";
	ВыбранВариант = Ложь;
	ПервыйВариант = Неопределено;

	Для Каждого Кусок Из СтрРазделить(Форма, "<") Цикл

		Низ = НРег(Кусок);

		Если СтрНачинаетсяС(Низ, "fieldset") Тогда
			Отключения.Добавить(ЕстьПометка(Кусок, "disabled") ИЛИ ВнутриОтключённого(Отключения));
			Продолжить;
		КонецЕсли;

		Если СтрНачинаетсяС(Низ, "/fieldset") Тогда
			Если Отключения.Количество() > 0 Тогда
				Отключения.Удалить(Отключения.Количество() - 1);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если СтрНачинаетсяС(Низ, "/select") Тогда
			// без единого selected браузер отправляет первый вариант списка
			Если ЗначениеЗаполнено(ИмяСписка) И НЕ ВыбранВариант И ПервыйВариант <> Неопределено Тогда
				ДобавитьПоле(Результат, ИмяСписка, ПервыйВариант);
			КонецЕсли;
			ИмяСписка = "";
			Продолжить;
		КонецЕсли;

		Если СтрНачинаетсяС(Низ, "option") И ЗначениеЗаполнено(ИмяСписка) Тогда
			Значение = ЗначениеАтрибута(Кусок, "value");
			Если ПервыйВариант = Неопределено Тогда
				ПервыйВариант = Значение;
			КонецЕсли;
			Если НЕ ВыбранВариант И ЕстьПометка(Кусок, "selected") Тогда
				ВыбранВариант = Истина;
				ДобавитьПоле(Результат, ИмяСписка, Значение);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если СтрНачинаетсяС(Низ, "select") Тогда
			ИмяСписка = ?(Отправляется(Кусок, Отключения), ЗначениеАтрибута(Кусок, "name"), "");
			ВыбранВариант = Ложь;
			ПервыйВариант = Неопределено;
			Продолжить;
		КонецЕсли;

		Если СтрНачинаетсяС(Низ, "textarea") И Отправляется(Кусок, Отключения) Тогда
			Конец = СтрНайти(Кусок, ">");
			ДобавитьПоле(Результат, ЗначениеАтрибута(Кусок, "name"),
				РасшифроватьHTML(?(Конец = 0, "", Сред(Кусок, Конец + 1))));
			Продолжить;
		КонецЕсли;

		Если НЕ СтрНачинаетсяС(Низ, "input") ИЛИ НЕ Отправляется(Кусок, Отключения) Тогда
			Продолжить;
		КонецЕсли;

		Тип = НРег(ЗначениеАтрибута(Кусок, "type"));
		Если (Тип = "checkbox" ИЛИ Тип = "radio") И НЕ ЕстьПометка(Кусок, "checked") Тогда
			Продолжить; // невыбранное управление браузер не отправляет вовсе
		КонецЕсли;

		ДобавитьПоле(Результат, ЗначениеАтрибута(Кусок, "name"), ЗначениеАтрибута(Кусок, "value"));

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Отправляется(Знач Кусок, Знач Отключения)
	Возврат НЕ ЕстьПометка(Кусок, "disabled") И НЕ ВнутриОтключённого(Отключения);
КонецФункции

Функция ВнутриОтключённого(Знач Отключения)
	Возврат Отключения.Количество() > 0 И Отключения[Отключения.Количество() - 1] = Истина;
КонецФункции

// Булев атрибут ищем только в самом теге: за «>» начинается уже текст узла.
Функция ЕстьПометка(Знач Кусок, Знач Имя)
	Конец = СтрНайти(Кусок, ">");
	Тег = ?(Конец = 0, Кусок, Лев(Кусок, Конец - 1));
	Возврат СтрНайти(Тег, " " + Имя) > 0;
КонецФункции

Процедура ДобавитьПоле(Результат, Знач Имя, Знач Значение)
	Если ЗначениеЗаполнено(Имя) И Результат.Получить(Имя) = Неопределено Тогда
		Результат.Вставить(Имя, Значение); // первое значение поля — как читает сервер
	КонецЕсли;
КонецПроцедуры

Функция РасшифроватьHTML(Знач Текст)
	Результат = СтрЗаменить(Текст, "&lt;", "<");
	Результат = СтрЗаменить(Результат, "&gt;", ">");
	Результат = СтрЗаменить(Результат, "&quot;", """");
	Результат = СтрЗаменить(Результат, "&#39;", "'");
	Возврат СтрЗаменить(Результат, "&amp;", "&");
КонецФункции

// Истина, если набор полей с таким ключом напечатан и НЕ отключён: отключённый браузер
// не отправляет и не показывает.
Функция НаборВключён(Знач Разметка, Знач Ключ) Экспорт

	Маркер = "data-set=""" + Ключ + """";
	Позиция = СтрНайти(Разметка, Маркер);
	Если Позиция = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Хвост = Сред(Разметка, Позиция + СтрДлина(Маркер));
	Конец = СтрНайти(Хвост, ">");
	Возврат СтрНайти(Лев(Хвост, ?(Конец = 0, СтрДлина(Хвост), Конец - 1)), "disabled") = 0;

КонецФункции

// Подписи вариантов списка с таким именем — в порядке печати.
Функция ПодписиВариантов(Знач Разметка, Знач ИмяПоля) Экспорт

	Результат = Новый Массив();

	Начало = СтрНайти(Разметка, "<select class=""field__control"" name=""" + ИмяПоля + """");
	Если Начало = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Хвост = Сред(Разметка, Начало);
	КонецСписка = СтрНайти(Хвост, "</select>");
	Блок = ?(КонецСписка = 0, Хвост, Лев(Хвост, КонецСписка));

	Для Каждого Кусок Из СтрРазделить(Блок, "<") Цикл
		Если НЕ СтрНачинаетсяС(НРег(Кусок), "option") Тогда
			Продолжить;
		КонецЕсли;
		Конец = СтрНайти(Кусок, ">");
		Если Конец > 0 Тогда
			Результат.Добавить(СокрЛП(Сред(Кусок, Конец + 1)));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция РазныхПодписей(Знач Подписи) Экспорт

	Разные = Новый Соответствие();
	Для Каждого Подпись Из Подписи Цикл
		Разные.Вставить(Подпись, Истина);
	КонецЦикла;
	Возврат Разные.Количество();

КонецФункции

// Тег выбранного варианта списка с таким именем: на нём живут data-атрибуты варианта.
Функция ВыбранныйВариантСписка(Знач Разметка, Знач ИмяПоля) Экспорт

	Начало = СтрНайти(Разметка, "<select class=""field__control"" name=""" + ИмяПоля + """");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Разметка, Начало);
	КонецСписка = СтрНайти(Хвост, "</select>");
	Блок = ?(КонецСписка = 0, Хвост, Лев(Хвост, КонецСписка));

	Для Каждого Кусок Из СтрРазделить(Блок, "<") Цикл
		Если НЕ СтрНачинаетсяС(НРег(Кусок), "option") Тогда
			Продолжить;
		КонецЕсли;
		Если ЕстьПометка(Кусок, "selected") Тогда
			Конец = СтрНайти(Кусок, ">");
			Возврат ?(Конец = 0, Кусок, Лев(Кусок, Конец - 1));
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Истина, если вариант с таким значением помечен выбранным: между value и selected
// могут стоять data-атрибуты варианта, поэтому соседства подстрок недостаточно.
Функция ВариантВыбран(Знач Разметка, Знач Значение) Экспорт

	Маркер = "<option value=""" + Значение + """";
	Хвост = Разметка;
	Позиция = СтрНайти(Хвост, Маркер);

	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, ">");
		Если Конец > 1 И СтрНайти(Лев(Хвост, Конец - 1), "selected") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Значение атрибута тега.
//
// Параметры:
//  Тег     - Строка - разметка одного тега.
//  Атрибут - Строка - имя атрибута.
//
// Возвращаемое значение:
//  Строка - значение атрибута либо "" если его нет.
//
Функция ЗначениеАтрибута(Знач Тег, Знач Атрибут) Экспорт
	Маркер = Атрибут + "=""";
	Позиция = СтрНайти(Тег, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Тег, Позиция + СтрДлина(Маркер));
	Конец = СтрНайти(Остаток, """");
	Возврат ?(Конец = 0, "", Лев(Остаток, Конец - 1));
КонецФункции

// Максимальная глубина вложенности тегов <form> в разметке.
//
// Параметры:
//  Разметка - Строка - HTML страницы.
//
// Возвращаемое значение:
//  Число - глубина; 1 означает, что вложенности нет.
//
Функция ГлубинаВложенностиФорм(Знач Разметка) Экспорт

	Глубина = 0;
	Максимум = 0;
	Хвост = Разметка;

	Пока Истина Цикл
		Открывающий = СтрНайти(Хвост, "<form");
		Закрывающий = СтрНайти(Хвост, "</form>");
		Если Открывающий = 0 И Закрывающий = 0 Тогда
			Прервать;
		КонецЕсли;
		Если Открывающий > 0 И (Закрывающий = 0 ИЛИ Открывающий < Закрывающий) Тогда
			Глубина = Глубина + 1;
			Максимум = Макс(Максимум, Глубина);
			Хвост = Сред(Хвост, Открывающий + 5);
		Иначе
			Глубина = Глубина - 1;
			Хвост = Сред(Хвост, Закрывающий + 7);
		КонецЕсли;
	КонецЦикла;

	Возврат Максимум;

КонецФункции

// Раскрывашки <details>, лежащие ВНУТРИ <form>, и обязательные поля, спрятанные закрытыми
// из них. Отключённое (disabled на поле или на объемлющем <fieldset>) нарушением не
// считается: такие контролы браузер не валидирует, и именно так работает переключатель
// наборов полей [data-set].
//
// Параметры:
//  Разметка - Строка - HTML страницы.
//
// Возвращаемое значение:
//  Структура - Закрытых (Число закрытых катов внутри форм), Обязательные (Массив тегов
//              с атрибутом required, до которых пользователь не доберётся),
//              Незакрытых (Число катов без </details>: браузер уводит внутрь такого
//              ката всё до конца родителя, поэтому разбор считает так же, а число
//              называется отдельно — это дефект разметки сам по себе).
//
Функция КатыВнутриФорм(Знач Разметка) Экспорт

	Результат = Новый Структура("Закрытых, Обязательные, Незакрытых", 0, Новый Массив(), 0);
	ГлубинаФорм = 0;
	Каты = Новый Массив();     // по одному Булево на открытый <details>: «закрыт и внутри формы»
	Наборы = Новый Массив();   // по одному Булево на открытый <fieldset>: «отключён»
	Хвост = Разметка;

	Пока Истина Цикл

		Открытие = СтрНайти(Хвост, "<");
		Если Открытие = 0 Тогда
			Прервать;
		КонецЕсли;
		Хвост = Сред(Хвост, Открытие);

		Длина = ДлинаТега(Хвост);
		Если Длина = 0 Тогда
			Прервать;
		КонецЕсли;
		Тег = Лев(Хвост, Длина);
		Хвост = Сред(Хвост, Длина + 1);

		Имя = ИмяТега(Тег);
		Скелет = СкелетТега(Тег);

		Если Имя = "/form" Тогда
			ГлубинаФорм = Макс(0, ГлубинаФорм - 1);
		ИначеЕсли Имя = "form" Тогда
			ГлубинаФорм = ГлубинаФорм + 1;
		ИначеЕсли Имя = "/details" Тогда
			Если Каты.Количество() > 0 Тогда
				Каты.Удалить(Каты.Количество() - 1);
			КонецЕсли;
		ИначеЕсли Имя = "details" Тогда
			ЗакрытВФорме = ГлубинаФорм > 0 И НЕ ЕстьАтрибут(Скелет, "open");
			Каты.Добавить(ЗакрытВФорме);
			Если ЗакрытВФорме Тогда
				Результат.Закрытых = Результат.Закрытых + 1;
			КонецЕсли;
		ИначеЕсли Имя = "/fieldset" Тогда
			Если Наборы.Количество() > 0 Тогда
				Наборы.Удалить(Наборы.Количество() - 1);
			КонецЕсли;
		ИначеЕсли Имя = "fieldset" Тогда
			Наборы.Добавить(ЕстьАтрибут(Скелет, "disabled"));
		ИначеЕсли ЕстьАтрибут(Скелет, "required")
			И Каты.Найти(Истина) <> Неопределено
			И НЕ ЕстьАтрибут(Скелет, "disabled")
			И Наборы.Найти(Истина) = Неопределено Тогда
			Результат.Обязательные.Добавить(Тег);
		КонецЕсли;

	КонецЦикла;

	Результат.Незакрытых = Каты.Количество();
	Возврат Результат;

КонецФункции

// Длина тега от «<» до закрывающей «>» ВНЕ кавычек: «<input value="a>b" required>» —
// один тег, а не обрезок по первой скобке (обрезок терял бы required).
Функция ДлинаТега(Знач Текст)

	Кавычка = "";

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если ЗначениеЗаполнено(Кавычка) Тогда
			Если Символ = Кавычка Тогда
				Кавычка = "";
			КонецЕсли;
		ИначеЕсли Символ = """" ИЛИ Символ = "'" Тогда
			Кавычка = Символ;
		ИначеЕсли Символ = ">" Тогда
			Возврат Позиция;
		КонецЕсли;
	КонецЦикла;

	Возврат 0;

КонецФункции

// Имя тега в нижнем регистре: «form», «/form», «details». Пробел перед скобкой
// («</details >») в имя не входит.
Функция ИмяТега(Знач Тег)

	Закрывающий = (Лев(Тег, 2) = "</");
	Результат = "";

	Для Позиция = ?(Закрывающий, 3, 2) По СтрДлина(Тег) Цикл
		Символ = НРег(Сред(Тег, Позиция, 1));
		Если ПробельныйСимвол(Символ) ИЛИ Символ = ">" ИЛИ Символ = "/" Тогда
			Прервать;
		КонецЕсли;
		Результат = Результат + Символ;
	КонецЦикла;

	Возврат ?(Закрывающий, "/", "") + Результат;

КонецФункции

// Тег без ЗНАЧЕНИЙ атрибутов: «class="fold open danger"» → «class=». Слово внутри значения
// именем атрибута не становится — иначе кат с классом «open» читался бы раскрытым.
Функция СкелетТега(Знач Тег)

	Результат = " ";
	Кавычка = "";

	Для Позиция = 1 По СтрДлина(Тег) Цикл
		Символ = Сред(Тег, Позиция, 1);
		Если ЗначениеЗаполнено(Кавычка) Тогда
			Если Символ = Кавычка Тогда
				Кавычка = "";
			КонецЕсли;
		ИначеЕсли Символ = """" ИЛИ Символ = "'" Тогда
			Кавычка = Символ;
		ИначеЕсли ПробельныйСимвол(Символ) ИЛИ Символ = ">" ИЛИ Символ = "/" Тогда
			Результат = Результат + " ";
		Иначе
			Результат = Результат + НРег(Символ);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат + " ";

КонецФункции

Функция ЕстьАтрибут(Знач Скелет, Знач Имя)
	Возврат СтрНайти(Скелет, " " + Имя + " ") > 0 ИЛИ СтрНайти(Скелет, " " + Имя + "=") > 0;
КонецФункции

Функция ПробельныйСимвол(Знач Символ)
	Возврат Символ = " " ИЛИ Символ = Символы.ПС ИЛИ Символ = Символы.ВК ИЛИ Символ = Символы.Таб;
КонецФункции

&Тест
Процедура АнонимНеПопадаетВКабинет() Экспорт
	Ответ = Клиент.GET("/me");
	// гвард редиректит анонима на /login (клиент может и не пойти по редиректу)
	Если Редирект(Ответ) Тогда
		Ожидаем.Что(СтрНайти(Клиент.ЗаголовокОтвета(Ответ, "Location"), "/login") > 0, "редирект анонима на /login").ЭтоИстина();
	Иначе
		Ожидаем.Что(СтрНайти(Тело(Ответ), "Мои пакеты"), "аноним не видит кабинет").Равно(0);
	КонецЕсли;
КонецПроцедуры

&Тест
Процедура АвторВидитСвоиПакеты() Экспорт

	// З-13: «мои пакеты» — не отдельное представление, а ОТБОР каталога. Сводка кабинета
	// показывает горстку карточек, а весь список живёт в каталоге под этим отбором.
	Кука = Клиент.Войти("alice", "AlicePassw0rd");

	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/me", Кука)), "href=""/packages?mine=1""") > 0,
		"кабинет ведёт в каталог с отбором").ЭтоИстина();

	Ответ = Клиент.GETСКукой("/packages?mine=1", Кука);
	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "alice-pkg") > 0, "пакет автора в отборе").ЭтоИстина();

	// и шестерёнка «настройки» у управляемого пакета ведёт в дом пакета (З-13)
	Ожидаем.Что(СтрНайти(Тело(Ответ), "/alice-pkg/settings") > 0,
		"шестерёнка ведёт в дом пакета").ЭтоИстина();

КонецПроцедуры

// Дороги вошедшего живут в ЕДИНОМ меню, поэтому доступны с ЛЮБОЙ страницы живого хаба —
// с публичного каталога в том числе. «Входящие» стоят в меню постоянно: раньше туда
// попадали только с виджета главной, а тот появляется вместе с очередью. Дороги ищутся
// ВНУТРИ панели меню: найденная на самой странице ничего про меню не доказывает.
&Тест
Процедура ЕдиноеМенюДаётДорогиВошедшемуСПубличнойСтраницы() Экспорт

	Панель = ПанельЕдиногоМеню(Тело(Клиент.GETСКукой("/packages", Клиент.Войти("alice", "AlicePassw0rd"))));

	Ожидаем.Что(Панель <> "", "единое меню печатается на публичном каталоге").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "class=""hubmenu__login"">alice<") > 0,
		"и подписано именем вошедшего").ЭтоИстина();
	Для Каждого Дорога Из СтрРазделить(
		"/me,/alice,/packages?mine=1,/me/notifications,/me/inbox,/me/settings", ",") Цикл
		Ожидаем.Что(СтрНайти(Панель, "href=""" + Дорога + """") > 0,
			"дорога " + Дорога + " из меню каталога").ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Панель, "action=""/logout""") > 0,
		"и выход формой в том же меню").ЭтоИстина();

	Ожидаем.Что(Клиент.GETСКукой("/me/inbox", Клиент.Войти("alice", "AlicePassw0rd")).КодСостояния,
		"дорога до входящих ведёт на живой экран").Равно(200);
	Ожидаем.Что(Клиент.GETСКукой("/alice", Клиент.Войти("alice", "AlicePassw0rd")).КодСостояния,
		"и дорога до личного пространства — тоже").Равно(200);

	Ожидаем.Что(СтрНайти(Панель, "href=""/hub/settings"""),
		"а настройки хаба рядовому участнику не печатаются").Равно(0);
	АдминскаяПанель = ПанельЕдиногоМеню(Тело(Клиент.GETСКукой("/packages", ВойтиRoot())));
	Ожидаем.Что(СтрНайти(АдминскаяПанель, "href=""/hub/settings""") > 0,
		"админ видит их в своём меню на той же странице").ЭтоИстина();
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings", ВойтиRoot()).КодСостояния,
		"и эта дорога ведёт на живой экран").Равно(200);

КонецПроцедуры

&Тест
Процедура УправлениеРедактированиеCSRFиОтражениеНаПубличной() Экспорт

	Кука = Клиент.Войти("alice", "AlicePassw0rd");

	// страница управления
	Стр = Тело(Клиент.GETСКукой("/public/alice-pkg/settings/card", Кука));
	Ожидаем.Что(СтрНайти(Стр, "alice-pkg") > 0, "заголовок пакета").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/public/alice-pkg/settings/versions", Кука)), "1.1.0") > 0,
		"версия в таблице раздела «версии»").ЭтоИстина();
	Токен = ИзвлечьCSRF(Стр);
	Ожидаем.Что(СтрДлина(Токен)).Равно(64);

	// мутация без CSRF → 403
	БезТокена = Новый Соответствие();
	БезТокена.Вставить("описание", "взлом");
	Ожидаем.Что(Клиент.POSTФормы("/public/alice-pkg/settings/card", БезТокена, Кука).КодСостояния,
		"сохранение без CSRF отклонено").Равно(403);

	// мутация с CSRF (описание с XSS + опасный репозиторий) → редирект
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("описание", "<script>alert(1)</script>MARKERDESC");
	Поля.Вставить("репозиторий", "javascript:alert(2)");
	Поля.Вставить("лицензия", "MIT");
	Поля.Вставить("ключевые_слова", "");
	ОтветСохр = Клиент.POSTФормы("/public/alice-pkg/settings/card", Поля, Кука);
	Ожидаем.Что(УспехМутации(ОтветСохр), "успешное сохранение").ЭтоИстина();

	// отражение на ПУБЛИЧНОЙ странице + санитизация (урок 2.D)
	Пуб = Тело(Клиент.GET("/public/alice-pkg"));
	Ожидаем.Что(СтрНайти(Пуб, "MARKERDESC") > 0, "новое описание отражено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(Пуб), "<script>alert"), "script вырезан").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(Пуб), "href=""javascript"), "js-URL репозитория не исполним").Равно(0);

КонецПроцедуры

