&Тест
Процедура ТокенБотаНеПопадаетНаСтраницуОтказа() Экспорт

	// отказ печатает причину и перерисовывает форму — вместе с уже введёнными значениями
	// это самый простой способ вернуть секрет на экран; страница отказа обязана молчать
	Кука = Клиент.Войти("root", "RootPassw0rd");
	Страница = "/public/settings/webhooks";
	Токен = "515151:token-so-stranicy-otkaza";

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница + "?kind=telegram", Кука))));
	Поля.Вставить("тип_действия", "telegram");
	Поля.Вставить("chat-id", "это не chat_id");
	Поля.Вставить("бот-токен", Токен);
	Поля.Вставить("шаблон-текста", "{событие}");
	Поля.Вставить("событие_0", "1");
	Ответ = Клиент.POSTФормы(Страница, Поля, Кука);

	ТелоОтказа = Тело(Ответ);
	Ожидаем.Что(Ответ.КодСостояния, "негодный chat_id — 400").Равно(400);
	Ожидаем.Что(СтрНайти(ТелоОтказа, "Недопустимый chat_id") > 0, "причина названа словами").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоОтказа, Токен), "токена нет в теле страницы отказа").Равно(0);
	Ожидаем.Что(СтрНайти(ТелоОтказа, "token-so-stranicy"), "и обрывка тоже нет").Равно(0);

	// и сам отказ токеном не вызван: с тем же токеном и годным chat_id подписка заводится
	ПоляГодные = Новый Соответствие();
	ПоляГодные.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница + "?kind=telegram", Кука))));
	ПоляГодные.Вставить("тип_действия", "telegram");
	ПоляГодные.Вставить("chat-id", "-100424242");
	ПоляГодные.Вставить("бот-токен", Токен);
	ПоляГодные.Вставить("событие_0", "1");
	Ожидаем.Что(Клиент.POSTФормы(Страница, ПоляГодные, Кука).КодСостояния < 400,
		"ассерт не пуст: с тем же токеном годная форма проходит").ЭтоИстина();

КонецПроцедуры

// Свой текст уведомления живёт ровно столько, сколько подписка: не вернувшийся в форму
// шаблон стёрся бы первой же правкой чего угодно другого. А неизвестное имя отклоняется
// НА СОХРАНЕНИИ и с перечнем допустимых — не молчаливой пустотой в доставленном сообщении.
&Тест
Процедура СвойТекстУведомленияПереживаетПравкуАНеизвестноеИмяОтклоняется() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Страница = "/public/settings/webhooks";
	Шаблон = "Событие {событие}: {пакет} {версия}";
	ЧатПодопытной = "-100777001";

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница + "?kind=telegram", Кука))));
	Поля.Вставить("тип_действия", "telegram");
	Поля.Вставить("chat-id", ЧатПодопытной);
	Поля.Вставить("бот-токен", "424242:token-svoego-teksta");
	Поля.Вставить("шаблон-текста", Шаблон);
	Поля.Вставить("событие_0", "1");
	Ожидаем.Что(Клиент.POSTФормы(Страница, Поля, Кука).КодСостояния < 400,
		"подписка со своим текстом заведена").ЭтоИстина();

	Список = Тело(Клиент.GETСКукой(Страница, Кука));
	Ид = ИдПодпискиПоАдресу(Список, ЧатПодопытной);

	Попытка

		Ожидаем.Что(СтрНайти(Список, Шаблон + "</textarea>") > 0,
			"заданный текст вернулся в форму правки — иначе он терялся бы при первой правке")
			.ЭтоИстина();

		Плохой = Новый Соответствие();
		Плохой.Вставить("_csrf", ИзвлечьCSRF(Список));
		Плохой.Вставить("тип_действия", "telegram");
		Плохой.Вставить("chat-id", ЧатПодопытной);
		Плохой.Вставить("шаблон-текста", "{чего-то-такого-нет}");
		Плохой.Вставить("событие_0", "1");
		Плохой.Вставить("включить", "1");
		Отказ = Клиент.POSTФормы(Страница + "/" + Ид + "/save", Плохой, Кука);

		Ожидаем.Что(Отказ.КодСостояния, "неизвестное имя отклонено на сохранении").Равно(400);
		Ожидаем.Что(СтрНайти(Тело(Отказ), "Неизвестный плейсхолдер") > 0,
			"и названо словами: " + Тело(Отказ)).ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело(Отказ), "{ссылка}") > 0,
			"вместе с перечнем допустимых имён").ЭтоИстина();

		Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), Шаблон + "</textarea>") > 0,
			"отклонённое сохранение прежний текст не тронуло").ЭтоИстина();

	Исключение
		УбратьПодписку(Страница, Ид, Кука);
		ВызватьИсключение;
	КонецПопытки;

	УбратьПодписку(Страница, Ид, Кука);

КонецПроцедуры

// Перечень того, о чём хаб умеет уведомлять, закрыт: мейнтейнер видит на форме флажки
// подписочных событий с объяснением каждого и не может построить интеграцию на событии,
// которого хаб никому не доставляет.
&Тест
Процедура ФормаПодпискиОбъясняетКаждоеСобытиеИИмениМимоПеречняНеПринимает() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Страница = "/public/settings/webhooks";
	Разметка = Тело(Клиент.GETСКукой(Страница, Кука));

	Блок = БлокСобытийФормы(Разметка);
	Флажков = СтрЧислоВхождений(Блок, "name=""событие_");
	Ожидаем.Что(Флажков > 1, "самотест: форма предлагает несколько событий").ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(Блок, "field__hint") >= Флажков,
		"у каждого события сказано, когда оно возникает").ЭтоИстина();

	// имя за границей перечня событием не становится, и подписка ни на чём не заводится
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Разметка));
	Поля.Вставить("тип_действия", "вебхук");
	Поля.Вставить("url", "https://hooks.example.com/za-perechnem");
	Поля.Вставить("событие_" + Формат(Флажков + 5, "ЧГ=0; ЧН=0"), "1");
	Отказ = Клиент.POSTФормы(Страница, Поля, Кука);

	Ожидаем.Что(Отказ.КодСостояния, "подписка мимо перечня событий отвергнута").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Отказ), "тип событий") > 0,
		"причина названа словами: " + Тело(Отказ)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Страница, Кука)), "za-perechnem"),
		"и подписка не создана").Равно(0);

КонецПроцедуры

// Блок флажков событий формы: от первого флажка до конца его fieldset.
Функция БлокСобытийФормы(Знач Разметка)

	Начало = СтрНайти(Разметка, "name=""событие_0""");
	Ожидаем.Что(Начало > 0, "на форме подписки есть флажки событий").ЭтоИстина();

	Хвост = Сред(Разметка, Начало);
	Конец = СтрНайти(Хвост, "</fieldset>");
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец - 1));

КонецФункции

// Убирает подписку раздела: раздел делится между тестами набора.
Процедура УбратьПодписку(Знач Страница, Знач Ид, Знач Кука)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука))));
	Клиент.POSTФормы(Страница + "/" + Ид + "/delete", Поля, Кука);

КонецПроцедуры

// З-10: раздел дома «Аккаунт» дописывал в свою секцию СПИСОК ПУЛОВ со ссылками в их
// настройки — оба дома обслуживал один контроллер. Дома разведены по классам, и повтор
// исключён физически: у контроллера аккаунта нет ни СервисаПулов, ни ДомаПула. Сторож
// держит это ЗНАЧЕНИЕМ, а не подписью раздела: ни одна ссылка и ни одна форма экрана
// не адресует чужой дом настроек. Смотрим глазами того, кому прежний экран пулы
// и печатал, — администратора пула.
&Тест
Процедура ЭкранАккаунтаНеВедётНиВОдинЧужойДом() Экспорт

	КукаOwner = Клиент.Войти("owner1", "Owner1Passw0rd");

	// КОНТРОЛЬ детектора: на экране ПУЛА адреса не дома аккаунта как раз есть. Без него
	// «ноль чужих адресов» доказывало бы лишь то, что детектор ничего не находит
	Пул = АдресаНастроекСтраницы(Тело(Клиент.GETСКукой("/owned/settings/webhooks", КукаOwner)));
	Ожидаем.Что(ЧужиеДома(Пул, "/me/settings").Количество() > 0,
		"КОНТРОЛЬ: детектор видит адреса чужого дома там, где они есть").ЭтоИстина();

	Аккаунт = АдресаНастроекСтраницы(Тело(Клиент.GETСКукой("/me/settings/tokens", КукаOwner)));
	Ожидаем.Что(Аккаунт.Количество() > 0,
		"экран аккаунта отдан и адреса настроек на нём есть").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(ЧужиеДома(Аккаунт, "/me/settings"), ", "),
		"раздел дома «Аккаунт» ведёт в чужой дом настроек — это и был З-10")
		.Равно("");

КонецПроцедуры

&Тест
Процедура ЭксплойтРевью_КлючНеВыпускаетКлючФормойКабинета() Экспорт

	КукаЖертвы = Клиент.Войти("bob", "BobPassw0rd");
	СтраницаКлючей = Тело(Клиент.GETСКукой("/me/settings/tokens", КукаЖертвы));
	ТокенCSRF = ИзвлечьCSRF(СтраницаКлючей);

	ПоляКонтроля = Новый Соответствие();
	ПоляКонтроля.Вставить("_csrf", ТокенCSRF);
	ПоляКонтроля.Вставить("имя", "review-control");
	ПоляКонтроля.Вставить("чтение", "1");
	ПоляКонтроля.Вставить("срок_дней", "7"); // срок обязателен: форма без него ключ не выпускает
	Контроль = Клиент.POSTФормы("/me/settings/tokens", ПоляКонтроля, КукаЖертвы);

	// теперь тем же телом, но ключом вместо куки
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Заголовки.Вставить("Authorization", "Bearer " + ЛюбойКлюч(КукаЖертвы, ТокенCSRF));
	ПоляКлюча = Новый Соответствие();
	ПоляКлюча.Вставить("_csrf", ТокенCSRF);
	ПоляКлюча.Вставить("имя", "review-escalation");
	ПоляКлюча.Вставить("чтение", "1");
	ПоляКлюча.Вставить("запись", "1");
	ЗапросКлюча = Новый HTTPЗапрос("/me/settings/tokens", Заголовки);
	ЗапросКлюча.УстановитьТелоИзСтроки(Клиент.КодированнаяФорма(ПоляКлюча), КодировкаТекста.UTF8);
	ПоКлючу = Клиент.Соединение().ОтправитьДляОбработки(ЗапросКлюча);

	Ожидаем.Что(УспехМутации(Контроль), "КОНТРОЛЬ: сессией форма выпускает ключ").ЭтоИстина();
	Ожидаем.Что(УспехМутации(ПоКлючу),
		"ключ не выпускает ключ формой кабинета (код " + ПоКлючу.КодСостояния + ")").ЭтоЛожь();

	// ПРИЧИНА ОТКАЗА НАЗВАНА СВОИМ ИМЕНЕМ (В-9). Проверка «просто 403» здесь ничего не
	// стоит: дверь закрывалась и ПОБОЧНО — CSRF не проходит при отсутствии сессии, — и
	// мутация «снять явный запрет» такой пин переживала. Инвариант «ключ не размножается»
	// обязан держаться собственной проверкой, и отличить его от совпадения можно ровно
	// по тексту отказа.
	Ожидаем.Что(СтрНайти(Тело(ПоКлючу), "ключ доступа не выпускает и не отзывает ключи") > 0,
		"отказ назван инвариантом, а не «неверный CSRF» (тело: " + Тело(ПоКлючу) + ")").ЭтоИстина();

КонецПроцедуры

// Любой действующий ключ пользователя: выпускаем формой (сессией) и достаём из страницы.
Функция ЛюбойКлюч(Знач Кука, Знач ТокенCSRF)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ТокенCSRF);
	Поля.Вставить("имя", "review-seed");
	Поля.Вставить("чтение", "1");
	Поля.Вставить("срок_дней", "7");
	Ответ = Клиент.POSTФормы("/me/settings/tokens", Поля, Кука);
	Найдено = "";
	Для Каждого Кусок Из СтрРазделить(Тело(Ответ), "<>""' " + Символы.ПС, Ложь) Цикл
		Если СтрНачинаетсяС(Кусок, "oshub_") Тогда
			Найдено = Кусок;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЗначениеЗаполнено(Найдено) Тогда
		ВызватьИсключение "Не удалось выпустить/прочитать ключ формой кабинета";
	КонецЕсли;
	Возврат Найдено;
КонецФункции

#Область ОчередьЗаявокВКабинете

// Сквозной путь очереди через экраны: push без прав → 202, мейнтейнер видит виджет
// на главной и заявку в разделе пула, одобряет двумя шагами — версия опубликована.
&Тест
Процедура ВиджетИРазделЗаявокПоказываютЗаявкуИОдобряютЕё() Экспорт

	КукаRoot = ВойтиRoot();
	ИмяПула = ЗавестиПулДляЗаявок(КукаRoot);
	ИмяПакета = "ui-inbox-appr";

	// на главной кабинета заявок ещё нет — виджета тоже нет, нуля никто не рисует
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/me", КукаRoot)), "Заявки ждут решения"),
		"пустая очередь виджет не рисует").Равно(0);

	Ожидаем.Что(ЗаявкаОтBob(ИмяПула, ИмяПакета, "1.0.0").КодСостояния,
		"push без прав в видимый пул → 202").Равно(202);

	Главная = Тело(Клиент.GETСКукой("/me", КукаRoot));
	Ожидаем.Что(СтрНайти(Главная, "Заявки ждут решения: 1") > 0,
		"виджет назвал счётчик").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Главная, ИмяПакета) > 0, "виджет назвал пакет").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Главная, "/me/inbox") > 0, "виджет ведёт в полный список").ЭтоИстина();

	Раздел = "/" + ИмяПула + "/settings/inbox";
	Страница = Тело(Клиент.GETСКукой(Раздел, КукаRoot));
	Ожидаем.Что(СтрНайти(Страница, ИмяПакета) > 0, "раздел пула показал заявку").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "bob") > 0, "и назвал заявителя").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "Одобрить") > 0, "кнопка одобрения на месте").ЭтоИстина();

	Номер = ИзвлечьЗначениеПоля(Страница, "заявка");
	Ожидаем.Что(ЗначениеЗаполнено(Номер), "номер заявки печатается скрытым полем").ЭтоИстина();
	ТокенCSRF = ИзвлечьCSRF(Страница);

	// ПЕРВЫЙ POST только спрашивает: без подтверждения решение не принимается
	Шаг = Тело(Клиент.POSTФормы(Раздел, ПоляРешения(ТокенCSRF, "одобрить", Номер, ""), КукаRoot));
	Ожидаем.Что(СтрНайти(Шаг, "Одобрить заявку №" + Номер) > 0,
		"первый POST показал шаг подтверждения").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шаг, "sha256") > 0,
		"на шаге подтверждения видно, по чему решать").ЭтоИстина();
	Ожидаем.Что(ВерсийПакета(ИмяПула, ИмяПакета, КукаRoot), "версия ещё НЕ опубликована").Равно(0);

	// ВТОРОЙ POST с эхом номера — решение
	Готово = Клиент.POSTФормы(Раздел, ПоляРешения(ТокенCSRF, "одобрить", Номер, Номер), КукаRoot);
	Ожидаем.Что(УспехМутации(Готово), "одобрение принято").ЭтоИстина();
	Ожидаем.Что(ВерсийПакета(ИмяПула, ИмяПакета, КукаRoot), "версия опубликована").Равно(1);

	// очередь опустела и на экране, и в виджете
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаRoot)), "Заявок, ждущих решения, нет") > 0,
		"пустое состояние честное, а не пустая таблица").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/me", КукаRoot)), "Заявки ждут решения"),
		"виджет исчез вместе с очередью").Равно(0);

КонецПроцедуры

// Отклонение с причиной: артефакт стёрт, прав нет, имя свободно, мусора не осталось.
&Тест
Процедура ОтклонениеЗаявкиСПричинойОсвобождаетИмя() Экспорт

	КукаRoot = ВойтиRoot();
	ИмяПула = ЗавестиПулДляЗаявок(КукаRoot);
	ИмяПакета = "ui-inbox-rej";

	Ожидаем.Что(ЗаявкаОтBob(ИмяПула, ИмяПакета, "1.0.0").КодСостояния, "заявка принята").Равно(202);

	Раздел = "/" + ИмяПула + "/settings/inbox";
	Страница = Тело(Клиент.GETСКукой(Раздел, КукаRoot));
	Номер = ИзвлечьЗначениеПоля(Страница, "заявка");
	ТокенCSRF = ИзвлечьCSRF(Страница);

	Шаг = Тело(Клиент.POSTФормы(Раздел, ПоляРешения(ТокенCSRF, "отклонить", Номер, ""), КукаRoot));
	Ожидаем.Что(СтрНайти(Шаг, "Отклонить заявку №" + Номер) > 0,
		"шаг подтверждения отказа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шаг, "name=""причина""") > 0,
		"на шаге отказа спрашивается причина").ЭтоИстина();

	Поля = ПоляРешения(ТокенCSRF, "отклонить", Номер, Номер);
	Поля.Вставить("причина", "лицензия не указана");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, Поля, КукаRoot)), "отказ принят").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаRoot)), "Заявок, ждущих решения, нет") > 0,
		"очередь пуста").ЭтоИстина();
	Ожидаем.Что(Клиент.GETСКукой("/" + ИмяПула + "/" + ИмяПакета, КукаRoot).КодСостояния,
		"отклонение пакета не завело").Равно(404);

	// имя свободно: та же заявка подаётся заново
	Ожидаем.Что(ЗаявкаОтBob(ИмяПула, ИмяПакета, "1.0.0").КодСостояния,
		"после отклонения имя снова свободно").Равно(202);

КонецПроцедуры

// Решение — мутация: без CSRF не проходит, и заявка остаётся ждать.
&Тест
Процедура РешениеПоЗаявкеБезCSRFОтклонено() Экспорт

	КукаRoot = ВойтиRoot();
	ИмяПула = ЗавестиПулДляЗаявок(КукаRoot);
	Ожидаем.Что(ЗаявкаОтBob(ИмяПула, "ui-inbox-csrf", "1.0.0").КодСостояния, "заявка принята").Равно(202);

	Раздел = "/" + ИмяПула + "/settings/inbox";
	Страница = Тело(Клиент.GETСКукой(Раздел, КукаRoot));
	Номер = ИзвлечьЗначениеПоля(Страница, "заявка");

	Ответ = Клиент.POSTФормы(Раздел, ПоляРешения("", "одобрить", Номер, Номер), КукаRoot);
	Ожидаем.Что(Ответ.КодСостояния, "решение без CSRF → 403").Равно(403);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаRoot)), "ui-inbox-csrf") > 0,
		"заявка осталась ждать").ЭтоИстина();

КонецПроцедуры

// Чужой пул: раздел закрыт гвардом дома, а сводка кабинета просто пуста — постороннему
// нечего решать, и знать о чужих заявках он не должен.
&Тест
Процедура ЧужиеЗаявкиНеВидныИНеРешаются() Экспорт

	КукаRoot = ВойтиRoot();
	ИмяПула = ЗавестиПулДляЗаявок(КукаRoot);
	Ожидаем.Что(ЗаявкаОтBob(ИмяПула, "ui-inbox-alien", "1.0.0").КодСостояния, "заявка принята").Равно(202);

	Раздел = "/" + ИмяПула + "/settings/inbox";
	Номер = ИзвлечьЗначениеПоля(Тело(Клиент.GETСКукой(Раздел, КукаRoot)), "заявка");

	КукаBob = Клиент.Войти("bob", "BobPassw0rd");
	Ожидаем.Что(Клиент.GETСКукой(Раздел, КукаBob).КодСостояния,
		"не мейнтейнер в раздел «Входящие» не входит → 403").Равно(403);

	Сводка = Тело(Клиент.GETСКукой("/me/inbox", КукаBob));
	Ожидаем.Что(СтрНайти(Сводка, "ui-inbox-alien"),
		"в сводке постороннего чужой заявки нет").Равно(0);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/me", КукаBob)), "Заявки ждут решения"),
		"и виджета у него нет").Равно(0);

	// подстановка настоящего номера в СВОЮ сводку тоже не решает чужую заявку
	CSRFBob = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/me/settings/tokens", КукаBob)));
	Ответ = Клиент.POSTФормы("/me/inbox", ПоляРешения(CSRFBob, "одобрить", Номер, Номер), КукаBob);
	Ожидаем.Что(Ответ.КодСостояния, "чужую заявку посторонний не одобряет").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаRoot)), "ui-inbox-alien") > 0,
		"заявка цела").ЭтоИстина();

КонецПроцедуры

// Сводка кабинета ведёт все пулы сразу и решает из одного места.
&Тест
Процедура СводкаКабинетаРешаетЗаявкуЛюбогоПула() Экспорт

	КукаRoot = ВойтиRoot();
	Первый = ЗавестиПулДляЗаявок(КукаRoot);
	Второй = ЗавестиПулДляЗаявок(КукаRoot);

	Ожидаем.Что(ЗаявкаОтBob(Первый, "ui-digest-one", "1.0.0").КодСостояния, "заявка 1").Равно(202);
	Ожидаем.Что(ЗаявкаОтBob(Второй, "ui-digest-two", "1.0.0").КодСостояния, "заявка 2").Равно(202);

	Сводка = Тело(Клиент.GETСКукой("/me/inbox", КукаRoot));
	Ожидаем.Что(СтрНайти(Сводка, "ui-digest-one") > 0, "сводка несёт заявку первого пула").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Сводка, "ui-digest-two") > 0, "и второго").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Сводка, Первый) > 0, "колонка пула названа именем пула").ЭтоИстина();

	ТокенCSRF = ИзвлечьCSRF(Сводка);
	Номер = ИзвлечьЗначениеПоля(Сводка, "заявка");

	Шаг = Тело(Клиент.POSTФормы("/me/inbox", ПоляРешения(ТокенCSRF, "отклонить", Номер, ""), КукаRoot));
	Ожидаем.Что(СтрНайти(Шаг, "Отклонить заявку №" + Номер) > 0, "подтверждение из сводки").ЭтоИстина();

	Поля = ПоляРешения(ТокенCSRF, "отклонить", Номер, Номер);
	Поля.Вставить("причина", "дубль");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/me/inbox", Поля, КукаRoot)), "решение из сводки принято").ЭтоИстина();

КонецПроцедуры

// Число на кнопке учётки приезжает из домена желудями «РассмотрениеВходящих»
// и «ЛентаУведомлений». Перестань резолвиться прозвище — бейдж молча замрёт на нуле,
// и об этом не узнает никто, поэтому счётчик проверяется ИЗМЕНЕНИЕМ: две заявки в очередь
// того, кто их решает, — плюс два на кнопке. Заодно бейдж обязан быть назван словами:
// цифра спрятана от скринридера, ему достаётся подпись счётчика.
&Тест
Процедура ЗаявкиОчередиДоезжаютДоСчётчикаВШапке() Экспорт

	КукаRoot = ВойтиRoot();
	Было = ЖдущихВШапке(Тело(Клиент.GETСКукой("/packages", КукаRoot)));
	ИмяПула = ЗавестиПулДляЗаявок(КукаRoot);

	// предел очереди считается НА АВТОРА, поэтому очередь разбирается и на пути исключения:
	// заявка, оставленная упавшим сторожем, отняла бы квоту у соседнего теста, и красный
	// прогон дал бы два падения вместо одного — своё и чужое
	Попытка
		СверитьСчётчикШапкиСОчередью(ИмяПула, КукаRoot, Было);
	Исключение
		ОтклонитьВсеЗаявкиПула(ИмяПула, КукаRoot);
		ВызватьИсключение;
	КонецПопытки;

	ОтклонитьВсеЗаявкиПула(ИмяПула, КукаRoot);
	Ожидаем.Что(ЖдущихВШапке(Тело(Клиент.GETСКукой("/packages", КукаRoot))),
		"разобранная очередь вернула счётчик на прежнее число").Равно(Было);

КонецПроцедуры

// Две заявки в очередь того, кто их решает, — плюс два на кнопке учётки.
Процедура СверитьСчётчикШапкиСОчередью(Знач ИмяПула, Знач Кука, Знач Было)

	Ожидаем.Что(ЗаявкаОтBob(ИмяПула, "ui-badge-one", "1.0.0").КодСостояния, "заявка 1").Равно(202);
	Ожидаем.Что(ЗаявкаОтPub(ИмяПула, "ui-badge-two", "1.0.0").КодСостояния, "заявка 2").Равно(202);

	Страница = Тело(Клиент.GETСКукой("/packages", Кука));
	Стало = ЖдущихВШапке(Страница);

	Ожидаем.Что(Стало - Было, "обе заявки доехали до счётчика в шапке").Равно(2);
	Ожидаем.Что(СтрНайти(Страница, "button__count") > 0,
		"и счётчик напечатан бейджем").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "Ждут вашего внимания: " + Формат(Стало, "ЧН=0; ЧГ=0")) > 0,
		"а число названо словами для скринридера: " + Страница).ЭтоИстина();

КонецПроцедуры

// Экран обязан работать без JS: решения — обычные формы method="post", и они не вложены.
&Тест
Процедура ЭкранЗаявокРаботаетБезJS() Экспорт

	КукаRoot = ВойтиRoot();
	ИмяПула = ЗавестиПулДляЗаявок(КукаRoot);
	Ожидаем.Что(ЗаявкаОтBob(ИмяПула, "ui-inbox-nojs", "1.0.0").КодСостояния, "заявка принята").Равно(202);

	Страница = Тело(Клиент.GETСКукой("/" + ИмяПула + "/settings/inbox", КукаRoot));

	Ожидаем.Что(СтрЧислоВхождений(Страница, "<form") >= 2,
		"у каждой кнопки решения своя форма").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "method=""post""") > 0, "формы отправляются POST").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "onclick="), "обработчиков в разметке нет").Равно(0);
	Ожидаем.Что(ГлубинаВложенностиФорм(Страница) <= 1,
		"формы решений не вложены друг в друга").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Инфраструктура

// Логин админа root (для вспомогательных запросов).
&Тест
Процедура ЛентаУведомленийПоказываетЗаявителюИсходЕгоЗаявки() Экспорт

	// личные события — приватная часть: аноним до ленты не доходит. Клиент проходит
	// редирект сам, поэтому судим и по Location, и по содержимому
	Анониму = Клиент.GET(АдресЛенты());
	Если Редирект(Анониму) Тогда
		Ожидаем.Что(СтрНайти(Клиент.ЗаголовокОтвета(Анониму, "Location"), "/login") > 0,
			"аноним отправлен на вход").ЭтоИстина();
	Иначе
		Ожидаем.Что(СтрНайти(Тело(Анониму), "Ваши события"),
			"аноним чужой ленты не видит").Равно(0);
	КонецЕсли;

	КукаRoot = ВойтиRoot();
	ИмяПула = ЗавестиПулДляЗаявок(КукаRoot);
	ИмяПакета = "ui-notify-appr";

	Ожидаем.Что(ЗаявкаОтPub(ИмяПула, ИмяПакета, "1.0.0").КодСостояния,
		"push без прав в видимый пул → 202").Равно(202);
	ОдобритьЗаявкуПула(ИмяПула, КукаRoot);

	// заявитель узнаёт исход У СЕБЯ, а не в очереди мейнтейнера — заглядывать туда
	// ему нечем и незачем
	КукаPub = Клиент.Войти("pub", "PubPassw0rd");
	Лента = Тело(Клиент.GETСКукой(АдресЛенты(), КукаPub));
	Ожидаем.Что(СтрНайти(Лента, ИмяПакета) > 0, "лента назвала пакет").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Лента, ">новое<") > 0, "непрочитанное помечено плашкой").ЭтоИстина();

	// форма без токена ничего не отмечает
	Поля = Новый Соответствие();
	Ожидаем.Что(Клиент.POSTФормы(АдресЛенты(), Поля, КукаPub).КодСостояния,
		"POST без CSRF отбит").Равно(403);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(АдресЛенты(), КукаPub)), ">новое<") > 0,
		"и лента осталась непрочитанной").ЭтоИстина();

	Поля.Вставить("_csrf", ИзвлечьCSRF(Лента));
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(АдресЛенты(), Поля, КукаPub)),
		"лента отмечена прочитанной").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(АдресЛенты(), КукаPub)), ">новое<"),
		"плашки непрочитанного больше нет").Равно(0);

КонецПроцедуры

Функция АдресЛенты()
	Возврат "/me/notifications";
КонецФункции

// Решение по единственной заявке пула: два POST — вопрос и подтверждение.
Процедура ОдобритьЗаявкуПула(Знач ИмяПула, Знач Кука)

	Раздел = "/" + ИмяПула + "/settings/inbox";
	Страница = Тело(Клиент.GETСКукой(Раздел, Кука));
	Номер = ИзвлечьЗначениеПоля(Страница, "заявка");
	Токен = ИзвлечьCSRF(Страница);

	Клиент.POSTФормы(Раздел, ПоляРешения(Токен, "одобрить", Номер, ""), Кука);
	Готово = Клиент.POSTФормы(Раздел, ПоляРешения(Токен, "одобрить", Номер, Номер), Кука);
	Ожидаем.Что(УспехМутации(Готово), "заявка одобрена").ЭтоИстина();

КонецПроцедуры

Функция ВойтиRoot()
	Возврат Клиент.Войти("root", "RootPassw0rd");
КонецФункции

// Разбирает очередь пула до конца: пока в разделе есть заявка — отклоняет её. Набор делит
// один хаб, а предел очереди считается на автора: заявка, оставленная на потом, отнимает
// квоту у соседнего теста.
Процедура ОтклонитьВсеЗаявкиПула(Знач ИмяПула, Знач Кука)

	Раздел = "/" + ИмяПула + "/settings/inbox";
	Потолок = 20;

	Для Заход = 1 По Потолок Цикл

		Страница = Тело(Клиент.GETСКукой(Раздел, Кука));
		Номер = ИзвлечьЗначениеПоля(Страница, "заявка");
		Если НЕ ЗначениеЗаполнено(Номер) Тогда
			Возврат;
		КонецЕсли;

		Поля = ПоляРешения(ИзвлечьCSRF(Страница), "отклонить", Номер, Номер);
		Поля.Вставить("причина", "уборка за тестом");
		Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, Поля, Кука)),
			"заявка №" + Номер + " разобрана").ЭтоИстина();

	КонецЦикла;

	// Потолок нужен затем, что «отклонение отчиталось успехом, а заявка осталась» — это
	// живой цикл до таймаута прогона. Пусть лучше набор упадёт словами.
	ВызватьИсключение СтрШаблон("Очередь пула ""%1"" не разобралась за %2 заходов:"
		+ " решение отчитывается успехом, а заявка остаётся в разделе.", ИмяПула, Потолок);

КонецПроцедуры

// Число с бейджа кнопки учётки. Шапка стоит первой в документе, поэтому первый бейдж
// страницы — её; бейджа нет — ждать нечего.
Функция ЖдущихВШапке(Знач Страница)

	Маркер = "<span class=""button__count"" aria-hidden=""true"">";
	Начало = СтрНайти(Страница, Маркер);
	Если Начало = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Хвост = Сред(Страница, Начало + СтрДлина(Маркер));
	Возврат Число(Лев(Хвост, СтрНайти(Хвост, "<") - 1));

КонецФункции

// Публичный пул под очередь: bob его ВИДИТ (иначе push дал бы 403, а не 202), но прав
// в нём не имеет. Заводится формой кабинета, как это делает живой администратор.
Функция ЗавестиПулДляЗаявок(Знач Кука)

	Имя = УникальныеИмена.Имя("ui-inbox-pool");

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Заголовки.Вставить("X-CSRF-Token", ИзвлечьCSRF(Тело(Клиент.GETСКукой("/me/settings/tokens", Кука))));
	Запрос = Новый HTTPЗапрос("/api/v1/pools", Заголовки);
	Запрос.УстановитьТелоИзСтроки(
		СтрШаблон("{""имя"":""%1"",""видимость"":""public""}", Имя), КодировкаТекста.UTF8);

	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение СтрШаблон("Пул для заявок не заведён (%1): %2",
			Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
	КонецЕсли;
	Возврат Имя;

КонецФункции

// Push от bob — аутентифицирован, пул видит, прав не имеет: ровно случай очереди.
Функция ЗаявкаОтBob(Знач ИмяПула, Знач ИмяПакета, Знач Версия)

	Если НЕ ЗначениеЗаполнено(ТокенBobДляPush) Тогда
		ТокенBobДляPush = ВыпуститьPATКукой(Клиент.Войти("bob", "BobPassw0rd"));
	КонецЕсли;
	Возврат PushТокеном(ТокенBobДляPush, ИмяПула, ИмяПакета, Версия);

КонецФункции

// Push от pub — та же роль заявителя без прав. Второй заявитель нужен затем, что предел
// «сколько заявок ждёт решения» считается НА АВТОРА: очередь bob этот набор уже занял.
Функция ЗаявкаОтPub(Знач ИмяПула, Знач ИмяПакета, Знач Версия)

	Если НЕ ЗначениеЗаполнено(ТокенPubДляPush) Тогда
		ТокенPubДляPush = ВыпуститьPATКукой(Клиент.Войти("pub", "PubPassw0rd"));
	КонецЕсли;
	Возврат PushТокеном(ТокенPubДляPush, ИмяПула, ИмяПакета, Версия);

КонецФункции

Функция PushТокеном(Знач Токен, Знач ИмяПула, Знач ИмяПакета, Знач Версия)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", СтрШаблон("%1-%2.ospx", ИмяПакета, Версия));
	Заголовки.Вставить("CHANNEL", "stable");
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Запрос = Новый HTTPЗапрос(СтрШаблон("/api/v1/pools/%1/push", ИмяПула), Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(ПостроитьOspxДанные(ИмяПакета, Версия));
	Возврат Клиент.Соединение().ОтправитьДляОбработки(Запрос);

КонецФункции

Функция ВыпуститьPATКукой(Знач Кука)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос("/api/v1/tokens", Заголовки);
	Запрос.УстановитьТелоИзСтроки("{""права"":""read,write""}", КодировкаТекста.UTF8);

	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение "PAT для push не выпущен: " + Ответ.КодСостояния;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Строка(Результат.Получить("token_info").Получить("token"));

КонецФункции

Функция ПостроитьOspxДанные(Знач ИмяПакета, Знач Версия)

	Возврат Новый ФикстураПакета().ДанныеOspx(КаталогСборкиЗаявок, ИмяПакета, Версия);

КонецФункции

// Поля формы решения: пустое подтверждение — первый POST (вопрос), эхо номера — второй.
Функция ПоляРешения(Знач ТокенCSRF, Знач Операция, Знач Номер, Знач Подтверждение)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ТокенCSRF);
	Поля.Вставить("операция", Операция);
	Поля.Вставить("заявка", Номер);
	Поля.Вставить("подтверждение", Подтверждение);
	Возврат Поля;

КонецФункции

Функция ВерсийПакета(Знач ИмяПула, Знач ИмяПакета, Знач Кука)

	Ответ = Клиент.GETСКукой(СтрШаблон("/api/v1/pools/%1/packages/%2/versions", ИмяПула, ИмяПакета), Кука);
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат 0;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат.Получить("versions").Количество();

КонецФункции

#Область ПраваНаПакетИзДомаПакета

// Мейнтейнер пакета выдаёт права на СВОЙ пакет, не будучи администратором пула, — ради
// этого раздел и заведён. Проверяется вся связка: вход в раздел, выдача, отражение,
// отзыв и то, что администратором пула он от этого не стал.
&Тест
Процедура МейнтейнерПакетаПравитПраваСвоегоПакета() Экспорт

	КукаRoot = ВойтиRoot();
	Раздел = "/public/alice-pkg/settings/access";

	// админ хаба делает bob МЕЙНТЕЙНЕРОМ ПАКЕТА (не пула) — прямо из дома пакета
	ТокенRoot = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаRoot)));
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел,
			ПолеПрав(ТокенRoot, "выдать", "пользователь", "bob", "мейнтейнер"), КукаRoot)),
		"роль на пакете выдана").ЭтоИстина();

	Попытка

		КукаBob = Клиент.Войти("bob", "BobPassw0rd");

		// bob НЕ администратор пула: экран прав пула ему по-прежнему закрыт
		Ожидаем.Что(Клиент.GETСКукой(ЭкранПравПула("public"), КукаBob).КодСостояния,
			"мейнтейнер пакета не получил прав на пул").Равно(403);

		// а раздел прав СВОЕГО пакета — открыт, и в нём видна действующая роль
		ОтветBob = Клиент.GETСКукой(Раздел, КукаBob);
		Ожидаем.Что(ОтветBob.КодСостояния, "мейнтейнер пакета входит в раздел прав пакета").Равно(200);
		СтрBob = Тело(ОтветBob);
		Ожидаем.Что(СтрНайти(СтрBob, "<td>пользователь</td><td>bob</td><td>мейнтейнер</td>") > 0,
			"строка действующего права названа ролью").ЭтоИстина();

		// и он выдаёт право на этот пакет сам
		ТокенBob = ИзвлечьCSRF(СтрBob);
		Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел,
				ПолеПрав(ТокенBob, "выдать", "пользователь", "pub", "читатель"), КукаBob)),
			"мейнтейнер пакета выдал право на свой пакет").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаBob)),
				"<td>пользователь</td><td>pub</td><td>читатель</td>") > 0,
			"выданное право отражено").ЭтоИстина();

		// отзыв тем же разделом
		Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел,
				ПолеПрав(ТокенBob, "отозвать", "пользователь", "pub", ""), КукаBob)),
			"право отозвано").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаBob)), "<td>pub</td>"),
			"pub исчез из таблицы").Равно(0);

	Исключение
		СнятьПравоПакета(КукаRoot, ТокенRoot, "bob");
		ВызватьИсключение;
	КонецПопытки;

	СнятьПравоПакета(КукаRoot, ТокенRoot, "bob");

КонецПроцедуры

// Потолок роли: мейнтейнер пакета не выдаёт владельца и админа хаба — иначе раздел
// становится лестницей эскалации на один клик.
&Тест
Процедура МейнтейнерПакетаНеВыдаётРольВышеСвоей() Экспорт

	КукаRoot = ВойтиRoot();
	Раздел = "/public/alice-pkg/settings/access";
	ТокенRoot = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаRoot)));
	Клиент.POSTФормы(Раздел, ПолеПрав(ТокенRoot, "выдать", "пользователь", "bob", "мейнтейнер"), КукаRoot);

	Попытка

		КукаBob = Клиент.Войти("bob", "BobPassw0rd");
		ТокенBob = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаBob)));

		Для Каждого Роль Из СтрРазделить("владелец,админ", ",") Цикл
			Ответ = Клиент.POSTФормы(Раздел,
				ПолеПрав(ТокенBob, "выдать", "пользователь", "pub", Роль), КукаBob);
			Ожидаем.Что(Ответ.КодСостояния,
				СтрШаблон("роль «%1» с экрана пакета не выдаётся", Роль)).Равно(400);
		КонецЦикла;

		Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаBob)), "<td>pub</td>"),
			"после отказов права у pub нет").Равно(0);

		// и в форме выдачи этих ролей нет вовсе
		Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаBob)), "value=""владелец"""),
			"владельца в списке ролей нет").Равно(0);
		Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаBob)), "value=""админ"""),
			"админа хаба в списке ролей нет").Равно(0);

	Исключение
		СнятьПравоПакета(КукаRoot, ТокенRoot, "bob");
		ВызватьИсключение;
	КонецПопытки;

	СнятьПравоПакета(КукаRoot, ТокенRoot, "bob");

КонецПроцедуры

// Подделка поля формы: объект действия задаёт маршрут, и присланный другой объект
// обязан ОТБИТЬСЯ, а не молча сработать на «правильном». Дважды найденный в проекте
// класс обхода — кросс-объектная подстановка идентификатора.
&Тест
Процедура ПодделкаОбъектаВФормеПравПакетаОтбивается() Экспорт

	КукаRoot = ВойтиRoot();
	Раздел = "/public/alice-pkg/settings/access";
	ТокенRoot = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаRoot)));
	Клиент.POSTФормы(Раздел, ПолеПрав(ТокенRoot, "выдать", "пользователь", "bob", "мейнтейнер"), КукаRoot);

	Попытка

		КукаBob = Клиент.Войти("bob", "BobPassw0rd");
		ТокенBob = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Раздел, КукаBob)));
		ИдЧужого = ИдПакетаИзAPI("public", "alice-pkg");
		Ожидаем.Что(ИдЧужого > 0, "идентификатор пакета получен из API").ЭтоИстина();

		// 1. подменён ТИП объекта — раздел не выдаёт прав на пул
		Атака = ПолеПрав(ТокенBob, "выдать", "пользователь", "pub", "читатель");
		Атака.Вставить("объект", "пул");
		Ожидаем.Что(Клиент.POSTФормы(Раздел, Атака, КукаBob).КодСостояния,
			"тип объекта «пул» из формы раздела пакета → 400").Равно(400);

		// 2. подменён ИДЕНТИФИКАТОР объекта — чужой пакет (в том числе из чужого пула)
		АтакаИд = ПолеПрав(ТокенBob, "выдать", "пользователь", "pub", "читатель");
		АтакаИд.Вставить("объект_ид", Формат(ИдЧужого + 1000, "ЧГ=0"));
		Ожидаем.Что(Клиент.POSTФормы(Раздел, АтакаИд, КукаBob).КодСостояния,
			"чужой идентификатор объекта → 400").Равно(400);

		// 3. упразднённый тип объекта — тоже отказ, а не выдача «на том, что нашлось»
		АтакаТип = ПолеПрав(ТокенBob, "выдать", "пользователь", "pub", "читатель");
		АтакаТип.Вставить("объект", "хаб");
		Ожидаем.Что(Клиент.POSTФормы(Раздел, АтакаТип, КукаBob).КодСостояния,
			"объект «хаб» из формы раздела пакета → 400").Равно(400);

		// 4. объект назван ИМЕНЕМ СВОЕГО ВИДА — сверка не зависит от того, каким из имён
		//    форма назвала объект (пуловый экран исторически звал его «пул»)
		АтакаИмяВида = ПолеПрав(ТокенBob, "выдать", "пользователь", "pub", "читатель");
		АтакаИмяВида.Вставить("пакет", Формат(ИдЧужого + 1000, "ЧГ=0"));
		Ожидаем.Что(Клиент.POSTФормы(Раздел, АтакаИмяВида, КукаBob).КодСостояния,
			"чужой пакет в поле «пакет» → 400").Равно(400);

		// 5. назван объект ЧУЖОГО вида — раздел пакета пулами не распоряжается вовсе
		АтакаЧужойВид = ПолеПрав(ТокенBob, "выдать", "пользователь", "pub", "читатель");
		АтакаЧужойВид.Вставить("пул", Формат(ИдПулаИзОбзора(
			Тело(Клиент.GETСКукой(АдресПулов(), КукаRoot)), "owned"), "ЧГ=0"));
		Ожидаем.Что(Клиент.POSTФормы(Раздел, АтакаЧужойВид, КукаBob).КодСостояния,
			"пул в форме раздела прав пакета → 400").Равно(400);

		// ни одна подделка не создала права — ни на этом объекте, ни на каком-либо ещё
		Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, КукаBob)), "<td>pub</td>"),
			"подделки не выдали права даже на «правильном» объекте").Равно(0);
		Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой("/groups/platform/settings/grants", КукаRoot)),
				">весь хаб<"), "и на хабе тоже").Равно(0);

	Исключение
		СнятьПравоПакета(КукаRoot, ТокенRoot, "bob");
		ВызватьИсключение;
	КонецПопытки;

	СнятьПравоПакета(КукаRoot, ТокенRoot, "bob");

КонецПроцедуры

// Порог входа в раздел — тот же, что пускает в дом пакета; чужой пакет закрыт целиком.
&Тест
Процедура ЧужойНеВходитВПраваПакета() Экспорт

	КукаPub = Клиент.Войти("pub", "PubPassw0rd");
	Ожидаем.Что(Клиент.GETСКукой("/secret/secret-pkg/settings/access", КукаPub).КодСостояния,
		"пакет приватного чужого пула — 404, существование не раскрывается").Равно(404);

	Ожидаем.Что(Клиент.GETСКукой("/public/alice-pkg/settings/access", Клиент.Войти("bob", "BobPassw0rd")).КодСостояния,
		"без прав на пакет — 403").Равно(403);

КонецПроцедуры

// Выдача роли — тоже заведение: кнопка над таблицей действующих прав, форма в окне,
// серверная дорога и возврат отбитой формы в то же окно. Пул и пакет проверяются
// раздельно: объявление у них одно, а экраны и пульты разные.
&Тест
Процедура ФормаВыдачиРолиНаПулЖивётВОкнеИВозвращаетсяВНегоЖе() Экспорт

	Кука = ВойтиRoot();
	Раздел = ЭкранПравПула("public");

	Закрытая = Тело(Клиент.GETСКукой(Раздел, Кука));
	Ожидаем.Что(СтрНайти(Закрытая, "<dialog class=""modal""") > 0,
		"форма выдачи — модальное окно").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Закрытая, ОкноВыдачиНаПул()) > 0,
		"и окно названо выдачей роли на пул").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Закрытая, ОкноВыдачиНаПул() + " open>"),
		"по умолчанию окно закрыто").Равно(0);

	Открытая = Тело(Клиент.GETСКукой(Раздел + "?form=1", Кука));
	Ожидаем.Что(СтрНайти(Открытая, ОкноВыдачиНаПул() + " open>") > 0,
		"адрес с form=1 открывает окно выдачи").ЭтоИстина();

	// субъекта нет: отказ метит поле субъекта и не съедает набранное
	Отбитая = Тело(Клиент.POSTФормы(Раздел,
		ПолеПрав(ИзвлечьCSRF(Закрытая), "выдать", "пользователь", "nosuchlogin", "читатель"), Кука));

	Ожидаем.Что(СтрНайти(Отбитая, ОкноВыдачиНаПул() + " open>") > 0,
		"отбитая форма вернулась ТЕМ ЖЕ окном — открытым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ОкноПоМетке(Отбитая, ОкноВыдачиНаПул()), "aria-invalid=""true""") > 0,
		"отбитое поле помечено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отбитая, "value=""nosuchlogin""") > 0,
		"набранное не съедено").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ФормаВыдачиПраваНаПакетЖивётВОкнеИВозвращаетсяВНегоЖе() Экспорт

	Кука = ВойтиRoot();
	Раздел = "/public/alice-pkg/settings/access";

	Закрытая = Тело(Клиент.GETСКукой(Раздел, Кука));
	Ожидаем.Что(СтрНайти(Закрытая, "<dialog class=""modal""") > 0,
		"форма выдачи — модальное окно").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Закрытая, ОкноВыдачиНаПакет()) > 0,
		"и окно названо выдачей права на пакет").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Закрытая, ОкноВыдачиНаПакет() + " open>"),
		"по умолчанию окно закрыто").Равно(0);

	Открытая = Тело(Клиент.GETСКукой(Раздел + "?form=1", Кука));
	Ожидаем.Что(СтрНайти(Открытая, ОкноВыдачиНаПакет() + " open>") > 0,
		"адрес с form=1 открывает окно выдачи").ЭтоИстина();

	Отбитая = Тело(Клиент.POSTФормы(Раздел,
		ПолеПрав(ИзвлечьCSRF(Закрытая), "выдать", "пользователь", "nosuchlogin", "читатель"), Кука));

	Ожидаем.Что(СтрНайти(Отбитая, ОкноВыдачиНаПакет() + " open>") > 0,
		"отбитая форма вернулась ТЕМ ЖЕ окном — открытым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ОкноПоМетке(Отбитая, ОкноВыдачиНаПакет()), "aria-invalid=""true""") > 0,
		"отбитое поле помечено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отбитая, "value=""nosuchlogin""") > 0,
		"набранное не съедено").ЭтоИстина();

КонецПроцедуры

Функция ПолеПрав(Знач Токен, Знач Операция, Знач ТипСубъекта, Знач Субъект, Знач Роль)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", Операция);
	Поля.Вставить("тип_субъекта", ТипСубъекта);
	Поля.Вставить("субъект", Субъект);
	Если ЗначениеЗаполнено(Роль) Тогда
		Поля.Вставить("роль", Роль);
	КонецЕсли;
	Возврат Поля;
КонецФункции

// Уборка: соседние тесты набора смотрят на те же страницы.
Процедура СнятьПравоПакета(Знач Кука, Знач Токен, Знач Субъект)
	Клиент.POSTФормы("/public/alice-pkg/settings/access",
		ПолеПрав(Токен, "отозвать", "пользователь", Субъект, ""), Кука);
КонецПроцедуры

#КонецОбласти

#Область ГруппыХаба

// Владелец хаба заводит группы сам: список, создание, дубль и удаление с подтверждением.
&Тест
Процедура АдминХабаЗаводитИУдаляетГруппу() Экспорт

	Кука = ВойтиRoot();
	Раздел = "/hub/settings/groups";

	Стр = Тело(Клиент.GETСКукой(Раздел, Кука));
	Ожидаем.Что(СтрНайти(Стр, "platform") > 0, "существующая группа в списке").ЭтоИстина();
	Токен = ИзвлечьCSRF(Стр);

	Имя = "devs-ui";

	Попытка

		Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, ПоляСоздания(Токен, Имя), Кука)),
			"группа создана").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, Кука)), Имя) > 0,
			"новая группа в списке").ЭтоИстина();
		Ожидаем.Что(Клиент.GETСКукой("/groups/" + Имя + "/settings", Кука).КодСостояния,
			"её дом настроек открывается").Равно(200);

		// уникальность держит приложение: дубль отбивается, а не создаёт вторую строку
		ОтветДубль = Клиент.POSTФормы(Раздел, ПоляСоздания(Токен, ВРег(Имя)), Кука);
		Ожидаем.Что(ОтветДубль.КодСостояния, "дубль по каноническому имени → 400").Равно(400);
		Ожидаем.Что(СтрНайти(Тело(ОтветДубль), "уже существует") > 0,
			"причина отказа названа").ЭтоИстина();

		// пустое имя тоже отбивается
		Ожидаем.Что(Клиент.POSTФормы(Раздел, ПоляСоздания(Токен, "  "), Кука).КодСостояния,
			"пустое имя → 400").Равно(400);

		// подтверждение не совпало — группа на месте
		Ожидаем.Что(Клиент.POSTФормы(Раздел, ПоляУдаления(Токен, Имя, "platform"), Кука).КодСостояния,
			"подтверждение другим именем → 400").Равно(400);
		Ожидаем.Что(Клиент.GETСКукой("/groups/" + Имя + "/settings", Кука).КодСостояния,
			"группа не удалена").Равно(200);

	Исключение
		Клиент.POSTФормы(Раздел, ПоляУдаления(Токен, Имя, Имя), Кука);
		ВызватьИсключение;
	КонецПопытки;

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Раздел, ПоляУдаления(Токен, Имя, Имя), Кука)),
		"группа удалена подтверждённым именем").ЭтоИстина();
	Ожидаем.Что(Клиент.GETСКукой("/groups/" + Имя + "/settings", Кука).КодСостояния,
		"её больше нет").Равно(404);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, Кука)), "platform") > 0,
		"соседняя группа не пострадала").ЭтоИстина();

КонецПроцедуры

// Заведение группы живёт ОКНОМ поверх списка: пока не нажали, формы на экране нет.
// У окна серверная дорога, а отбитая форма возвращается в него же — с набранным
// и помеченным полем.
&Тест
Процедура ФормаЗаведенияГруппыЖивётВОкнеИВозвращаетсяВНегоЖе() Экспорт

	Кука = ВойтиRoot();
	Раздел = "/hub/settings/groups";

	Закрытая = Тело(Клиент.GETСКукой(Раздел, Кука));
	Ожидаем.Что(СтрНайти(Закрытая, "<dialog class=""modal""") > 0,
		"форма заведения — модальное окно").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Закрытая, ОкноЗаведенияГруппы()) > 0,
		"и окно названо заведением группы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Закрытая, ОкноЗаведенияГруппы() + " open>"),
		"по умолчанию окно закрыто").Равно(0);

	Открытая = Тело(Клиент.GETСКукой(Раздел + "?form=1", Кука));
	Ожидаем.Что(СтрНайти(Открытая, ОкноЗаведенияГруппы() + " open>") > 0,
		"адрес с form=1 открывает окно заведения").ЭтоИстина();

	// имя занято: отказ домена метит имя и не съедает набранное описание
	Поля = ПоляСоздания(ИзвлечьCSRF(Закрытая), "platform");
	Поля.Вставить("описание", "команда платформы");
	Отбитая = Тело(Клиент.POSTФормы(Раздел, Поля, Кука));

	Ожидаем.Что(СтрНайти(Отбитая, ОкноЗаведенияГруппы() + " open>") > 0,
		"отбитая форма вернулась ТЕМ ЖЕ окном — открытым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ОкноПоМетке(Отбитая, ОкноЗаведенияГруппы()), "aria-invalid=""true""") > 0,
		"отбитое поле помечено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отбитая, "value=""команда платформы""") > 0,
		"набранное в соседнем поле не съедено").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РазделГруппХабаТолькоДляАдминаХаба() Экспорт

	КукаBob = Клиент.Войти("bob", "BobPassw0rd");
	Ожидаем.Что(Клиент.GETСКукой("/hub/settings/groups", КукаBob).КодСостояния,
		"не админ хаба в раздел групп не входит").Равно(403);

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой("/hub/settings/groups", ВойтиRoot()))));
	Поля.Вставить("операция", "создать");
	Поля.Вставить("имя", "bob-group");
	Ожидаем.Что(Клиент.POSTФормы("/hub/settings/groups", Поля, КукаBob).КодСостояния,
		"и группу формой не заводит (гейт стоит не только на GET)").Равно(403);

КонецПроцедуры

Функция ПоляСоздания(Знач Токен, Знач Имя)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "создать");
	Поля.Вставить("имя", Имя);
	Поля.Вставить("описание", "");
	Возврат Поля;
КонецФункции

Функция ПоляУдаления(Знач Токен, Знач Имя, Знач Подтверждение)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "удалить");
	Поля.Вставить("группа", Имя);
	Поля.Вставить("подтверждение", Подтверждение);
	Возврат Поля;
КонецФункции

#КонецОбласти

#Область ДомГруппы

// Участник подбирается из списка учёток с отбором по подстроке, а не вводится вслепую.
&Тест
Процедура ПодборУчастниковГруппыОтбираетИНеПоказываетСостоящих() Экспорт

	Кука = ВойтиRoot();
	Раздел = "/groups/platform/settings/members";

	Стр = Тело(Клиент.GETСКукой(Раздел, Кука));
	Токен = ИзвлечьCSRF(Стр);

	Ожидаем.Что(СтрНайти(Стр, "<td>bob</td><td>bob@ex.com</td>") > 0,
		"свободная учётка в кандидатах").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стр, "<td>alice</td><td>alice@ex.com</td>"),
		"уже состоящий в группе в кандидатах не показывается").Равно(0);

	Отобранное = Тело(Клиент.GETСКукой(Раздел + "?q=bob", Кука));
	Ожидаем.Что(СтрНайти(Отобранное, "<td>bob</td><td>bob@ex.com</td>") > 0,
		"отбор по подстроке оставляет совпавшего").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отобранное, "<td>pub</td><td>pub@ex.com</td>"),
		"и убирает остальных").Равно(0);

	Попытка

		Поля = Новый Соответствие();
		Поля.Вставить("_csrf", Токен);
		Поля.Вставить("операция", "добавить");
		Поля.Вставить("логин", "bob");
		Поля.Вставить("q", "bob");

		Ответ = Клиент.POSTФормы(Раздел, Поля, Кука);
		Ожидаем.Что(УспехМутации(Ответ), "участник добавлен кнопкой строки").ЭтоИстина();
		Если Редирект(Ответ) Тогда
			Ожидаем.Что(СтрНайти(Клиент.ЗаголовокОтвета(Ответ, "Location"), "q=bob") > 0,
				"отбор переживает добавление").ЭтоИстина();
		КонецЕсли;

		ПослеДобавления = Тело(Клиент.GETСКукой(Раздел, Кука));
		Ожидаем.Что(СтрНайти(ПослеДобавления, "<td>bob@ex.com</td>"),
			"bob ушёл из кандидатов — значит, он в группе").Равно(0);
		// в составе он есть: строка несёт форму исключения со своим логином
		Ожидаем.Что(СтрНайти(ПослеДобавления, "value=""bob""") > 0,
			"и появился в составе").ЭтоИстина();

		// повтор означает устаревший список: молчаливое «ок» соврало бы об эффекте
		Ожидаем.Что(Клиент.POSTФормы(Раздел, Поля, Кука).КодСостояния,
			"добавление уже состоящего → 400").Равно(400);

	Исключение
		СнятьУчастника(Раздел, Токен, Кука, "bob");
		ВызватьИсключение;
	КонецПопытки;

	СнятьУчастника(Раздел, Токен, Кука, "bob");
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(Раздел, Кука)), "<td>bob</td><td>bob@ex.com</td>") > 0,
		"после исключения он снова кандидат").ЭтоИстина();

КонецПроцедуры

// Права группы — по ВСЕМ объектам, но только по тем, которые смотрящий вправе видеть.
// Дом группы читает любой её участник, поэтому неотфильтрованная таблица раздавала бы
// имена приватных пулов и пакетов тому, у кого прав на них нет.
&Тест
Процедура ПраваГруппыПоказываютВсеОбъектыИСкрываютНевидимые() Экспорт

	КукаRoot = ВойтиRoot();
	Права = "/groups/platform/settings/grants";

	ТокенПула = ИзвлечьCSRF(Тело(Клиент.GETСКукой(ЭкранПравПула("public"), КукаRoot)));
	ТокенПакета = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/public/alice-pkg/settings/access", КукаRoot)));
	ТокенСекрета = ИзвлечьCSRF(Тело(Клиент.GETСКукой("/secret/secret-pkg/settings/access", КукаRoot)));

	Попытка

		// 1. право на ПУЛ public
		Ожидаем.Что(УспехМутации(ВыдатьРольНаПул(ЭкранПравПула("public"), ТокенПула, КукаRoot,
				"platform", "читатель", "группа")),
			"группе выдано право на пул").ЭтоИстина();

		// 2. право на ПАКЕТ публичного пула
		Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/public/alice-pkg/settings/access",
				ПолеПрав(ТокенПакета, "выдать", "группа", "platform", "читатель"), КукаRoot)),
			"группе выдано право на пакет").ЭтоИстина();

		// 3. право на ПАКЕТ приватного пула: читать сам пул оно НЕ даёт
		Ожидаем.Что(УспехМутации(Клиент.POSTФормы("/secret/secret-pkg/settings/access",
				ПолеПрав(ТокенСекрета, "выдать", "группа", "platform", "читатель"), КукаRoot)),
			"группе выдано право на пакет приватного пула").ЭтоИстина();

		СтрRoot = Тело(Клиент.GETСКукой(Права, КукаRoot));
		Ожидаем.Что(СтрНайти(СтрRoot, ">public<") > 0, "админ видит объект-пул").ЭтоИстина();
		Ожидаем.Что(СтрНайти(СтрRoot, ">public/alice-pkg<") > 0,
			"и объект-пакет: витрина перестала терять всё, кроме пулов").ЭтоИстина();
		Ожидаем.Что(СтрНайти(СтрRoot, ">secret/secret-pkg<") > 0,
			"и пакет приватного пула, который ему виден").ЭтоИстина();

		// alice — участник platform, но пул secret ей не виден: право на ПАКЕТ чтения
		// пула не даёт, а имя приватного пула из чужой строки прав утекать не должно
		СтрAlice = Тело(Клиент.GETСКукой(Права, Клиент.Войти("alice", "AlicePassw0rd")));
		Ожидаем.Что(СтрНайти(СтрAlice, ">public<") > 0,
			"видимый пул участнику показан").ЭтоИстина();
		Ожидаем.Что(СтрНайти(СтрAlice, ">public/alice-pkg<") > 0,
			"видимый пакет тоже").ЭтоИстина();
		Ожидаем.Что(СтрНайти(СтрAlice, "secret"),
			"имя приватного пула и его пакета участнику не показано").Равно(0);

	Исключение
		СнятьПраваГруппы(КукаRoot, ТокенПула, ТокенПакета, ТокенСекрета);
		ВызватьИсключение;
	КонецПопытки;

	СнятьПраваГруппы(КукаRoot, ТокенПула, ТокенПакета, ТокенСекрета);

КонецПроцедуры

Процедура СнятьУчастника(Знач Раздел, Знач Токен, Знач Кука, Знач Логин)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "удалить");
	Поля.Вставить("логин", Логин);
	Клиент.POSTФормы(Раздел, Поля, Кука);
КонецПроцедуры

Процедура СнятьПраваГруппы(Знач Кука, Знач ТокенПула, Знач ТокенПакета, Знач ТокенСекрета)

	ОтозватьРольНаПул(ЭкранПравПула("public"), ТокенПула, Кука, "platform", "группа");

	Клиент.POSTФормы("/public/alice-pkg/settings/access",
		ПолеПрав(ТокенПакета, "отозвать", "группа", "platform", ""), Кука);
	Клиент.POSTФормы("/secret/secret-pkg/settings/access",
		ПолеПрав(ТокенСекрета, "отозвать", "группа", "platform", ""), Кука);

КонецПроцедуры

#КонецОбласти

#Область НастройкиПулаСоСтраницыПула

// Кнопка ведёт туда, куда пускают: её видит только тот, кого дом настроек пула примет.
&Тест
Процедура КнопкаНастроекПулаВиднаТолькоАдминуПула() Экспорт

	Адрес = "/" + "public" + "/settings";

	СтрRoot = Тело(Клиент.GETСКукой("/public", ВойтиRoot()));
	Ожидаем.Что(СтрНайти(СтрRoot, "Настройки пула") > 0,
		"администратор пула видит кнопку").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СтрRoot, "href=""" + Адрес + """") > 0,
		"и она ведёт в дом настроек пула").ЭтоИстина();

	СтрBob = Тело(Клиент.GETСКукой("/public", Клиент.Войти("bob", "BobPassw0rd")));
	Ожидаем.Что(СтрНайти(СтрBob, "Настройки пула"),
		"обычный пользователь кнопки не видит — иначе переход упрётся в отказ").Равно(0);

	Ожидаем.Что(СтрНайти(Тело(Клиент.GET("/public")), "Настройки пула"),
		"анониму существование настроек не показывается").Равно(0);

	// и это не декорация: bob действительно не пускается по этому адресу
	Ожидаем.Что(Клиент.GETСКукой(Адрес, Клиент.Войти("bob", "BobPassw0rd")).КодСостояния,
		"порог кнопки совпадает с порогом дома настроек пула").Равно(403);

КонецПроцедуры

#КонецОбласти

&Тест
Процедура СтарыеАдресаУправленияДоступомВедутРедиректом() Экспорт

	Кука = ВойтиRoot();

	// все старые адреса управления пулами ведут в один раздел настроек хаба
	// адреса БЕЗ пула в запросе — общий список; адреса с пулом ведёт своя точка
	// (ЗакладкаНаСтарыеПраваПулаВедётВДомПула)
	Для Каждого Старый Из СтрРазделить("/office/access|/office/access/pools|/office/pools", "|") Цикл
		Ответ = Клиент.GETСКукой(Старый, Кука);
		Ожидаем.Что(Ответ.КодСостояния < 400,
			Старый + ": старый адрес не отдаёт ошибку (код " + Формат(Ответ.КодСостояния, "ЧГ=0") + ")").ЭтоИстина();
		Если Редирект(Ответ) Тогда
			Ожидаем.Что(СтрНайти(Клиент.ЗаголовокОтвета(Ответ, "Location"), АдресПулов()) > 0,
				Старый + ": ведёт в раздел пулов настроек хаба").ЭтоИстина();
		Иначе
			Ожидаем.Что(СтрНайти(Тело(Ответ), "Пулы хаба") > 0,
				Старый + ": клиент доехал до раздела пулов").ЭтоИстина();
		КонецЕсли;
	КонецЦикла;

	// Старые ФОРМЫ упразднены вместе со своим экраном, и точки их приёма больше нет.
	// Проверяется не код ответа, а последствие: POST по старому адресу обязан НИЧЕГО
	// не создать. Код сам по себе ничего не значит — важно, что пул не завёлся.
	ПоляСтаройФормы = Новый Соответствие();
	ПоляСтаройФормы.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(АдресПулов(), Кука))));
	ПоляСтаройФормы.Вставить("имя", "legacyform");
	ПоляСтаройФормы.Вставить("тип", "custom");
	ПоляСтаройФормы.Вставить("видимость", "public");
	Клиент.POSTФормы("/office/pools/new", ПоляСтаройФормы, Кука);
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(АдресПулов(), Кука)), ">legacyform<"),
		"старая форма создания пула не завела пул").Равно(0);

	// и сам раздел теперь называется «Пулы хаба»
	Ожидаем.Что(СтрНайти(Тело(Клиент.GETСКукой(АдресПулов(), Кука)), "Пулы хаба") > 0,
		"новый заголовок раздела").ЭтоИстина();

КонецПроцедуры

Функция ИдПулаИзОбзора(Знач Тело_, Знач ИмяПула)
	// Список пулов живёт в настройках хаба: имя печатается ссылкой на пул, идентификатор
	// берётся из соседнего пункта меню «Изменить квоту» (?pool=N).
	Позиция = СтрНайти(Тело_, ">" + ИмяПула + "</a>");
	Если Позиция = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Хвост = Сред(Тело_, Позиция);
	Маркер = "?pool=";
	П = СтрНайти(Хвост, Маркер);
	Если П = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Цифры = "";
	Для Индекс = П + СтрДлина(Маркер) По СтрДлина(Хвост) Цикл
		С = Сред(Хвост, Индекс, 1);
		Если С >= "0" И С <= "9" Тогда
			Цифры = Цифры + С;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(ЗначениеЗаполнено(Цифры), Число(Цифры), 0);
КонецФункции

// Новый подопытный хаб: свободный порт от ОС, окружение, ожидание готовности и
// гарантированная остановка — в фикстуре ЭкземплярХаба. Набор поднимает два хаба,
// поэтому тип подключается только если ещё не подключён.
Функция НовыйХаб()

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Возврат Новый ЭкземплярХаба(90);

КонецФункции

Процедура ЗапуститьСидер(Знач Сидер)
	П = СоздатьПроцесс(СтрШаблон("oscript ""%1""", Сидер), КаталогПроекта, Истина);
	П.Запустить();
	П.ОжидатьЗавершения();
	Если П.КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("Сидер кабинета завершился с кодом %1: %2",
			П.КодВозврата, П.ПолучитьВыводПотокаОшибок());
	КонецЕсли;
КонецПроцедуры

// Окружение БД/хранилища, ожидание готовности и очистка — в фикстуре ЭкземплярХаба.

#КонецОбласти

#Область HTTPПомощники

// СКВОЗНОЙ ГЕЙТ РИТМА ФОРМ (фикс ревью 6.A Б-1).
//
// Каждое тело страницы, которое читает ЛЮБОЙ тест набора, проходит через проверку
// фикстуры РитмФорм: она находит в РЕАЛЬНОЙ выдаче элементы .field/.toggle, поднимается
// к их непосредственному родителю и требует у него интервал в листах страницы.
//
// Почему здесь, а не отдельным тестом со списком страниц: список — это ровно тот
// механизм, которым дефект 6.A Б-1 и просочился (сторож знал три контейнера из
// четырёх). Здесь список не нужен вовсе: под проверку попадает всё, что набор
// запрашивает сегодня, И всё, что в него допишут завтра.
Функция Тело(Знач Ответ)

	Текст = Клиент.Тело(Ответ);
	ПроверитьРитмПолей(Текст);
	ПроверитьРядыИнлайнов(Текст);
	Возврат Текст;

КонецФункции

// Адреса настроек, на которые ссылается страница: значения href и action с сегментом
// «/settings». Читаются ЗНАЧЕНИЯ атрибутов, а не текст: подпись раздела можно переписать
// как угодно, адрес чужого дома — нельзя.
//
// Параметры:
//  Тело_ - Строка - тело HTML-ответа.
//
// Возвращаемое значение:
//  Массив из Строка - адреса без повторов.
//
Функция АдресаНастроекСтраницы(Знач Тело_)

	Результат = Новый Массив();

	Для Каждого Атрибут Из СтрРазделить("href=""|action=""", "|", Ложь) Цикл
		Хвост = Тело_;
		Позиция = СтрНайти(Хвост, Атрибут);
		Пока Позиция > 0 Цикл
			Хвост = Сред(Хвост, Позиция + СтрДлина(Атрибут));
			Конец = СтрНайти(Хвост, """");
			Если Конец = 0 Тогда
				Прервать;
			КонецЕсли;
			Адрес = Лев(Хвост, Конец - 1);
			Если СтрНайти(Адрес, "/settings") > 0 И Результат.Найти(Адрес) = Неопределено Тогда
				Результат.Добавить(Адрес);
			КонецЕсли;
			Хвост = Сред(Хвост, Конец + 1);
			Позиция = СтрНайти(Хвост, Атрибут);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Адреса, выходящие за пределы своего дома настроек.
Функция ЧужиеДома(Знач Адреса, Знач ПриставкаДома)

	Результат = Новый Массив();
	Для Каждого Адрес Из Адреса Цикл
		Если НЕ СтрНачинаетсяС(Адрес, ПриставкаДома) Тогда
			Результат.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Тем же сквозным способом: контейнеры ритма фикстура выводит из самого CSS, поэтому
// новый контейнер попадает под проверку без правки списка.
Процедура ПроверитьРядыИнлайнов(Знач HTML)

	Если РядыИнлайнов = Неопределено Тогда
		РядыИнлайнов = Новый РядИнлайнов();
	КонецЕсли;

	Нарушения = РядыИнлайнов.Нарушения(HTML, ТекстCSS());
	Если Нарушения.Количество() > 0 Тогда
		ВызватьИсключение "Соседние атомарные инлайны: " + СтрСоединить(Нарушения, "; ");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьРитмПолей(Знач HTML)

	// Гейт производительности, а не смысла: если слов «field»/«toggle» в разметке нет
	// вовсе, полей на странице нет и разбирать её незачем. Нарочно БЕЗ привязки к виду
	// атрибута (class="…"): иначе смена кавычек в ките молча отключила бы проверку.
	Если СтрНайти(HTML, "field") = 0 И СтрНайти(HTML, "toggle") = 0 Тогда
		Возврат;
	КонецЕсли;

	Нарушения = Ритм().Нарушения(HTML, ТекстCSS());
	Если Нарушения.Количество() > 0 Тогда
		ВызватьИсключение "Ритм форм: " + СтрСоединить(Нарушения, "; ");
	КонецЕсли;

КонецПроцедуры

Функция Ритм()
	Если РитмПолей = Неопределено Тогда
		РитмПолей = Новый РитмФорм();
	КонецЕсли;
	Возврат РитмПолей;
КонецФункции

// Браузер получает ДВА листа: базовый лист кита и лист инсталляции поверх него. Правила
// сверяются по их сумме — по одному листу половина правил объявилась бы пропавшей.
Функция ТекстCSS()

	Если СтилиХаба = Неопределено Тогда
		Место = Новый РаскладкаСтатики(Новый СтатикаИнсталляцииПоУмолчанию());
		СтилиХаба = ПрочитатьЛист(Место.ПолныйПуть(Место.ФайлБазовогоЛиста()))
			+ Символы.ПС + ПрочитатьЛист(ОбъединитьПути(КаталогПроекта, "src", "статика",
				ИмяФайлаСтилей()));
	КонецЕсли;

	Возврат СтилиХаба;

КонецФункции

Функция ПрочитатьЛист(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

// Имя файла стилей содержит контент-хеш (6.A-0) — берём его у самого каталога статики,
// а не литералом: иначе тест ломался бы при каждой правке CSS.
Функция ИмяФайлаСтилей()

	Найденные = НайтиФайлы(ОбъединитьПути(КаталогПроекта, "src", "статика"), "openhub*.css");
	Если Найденные.Количество() <> 1 Тогда
		ВызватьИсключение СтрШаблон(
			"Ожидался ровно один файл стилей openhub*.css в src/статика, найдено %1",
			Найденные.Количество());
	КонецЕсли;

	Возврат Найденные[0].Имя;

КонецФункции

Функция Редирект(Знач Ответ)
	Возврат Ответ.КодСостояния >= 300 И Ответ.КодСостояния < 400;
КонецФункции

// Мутация принята (успех): редирект ИЛИ 200 (клиент мог сам пройти по редиректу).
// Настоящее доказательство эффекта — отдельная аутентифицированная проверка.
Функция УспехМутации(Знач Ответ)
	Возврат Ответ.КодСостояния < 400;
КонецФункции

#Область ТегиПакетаВКабинете

// Поля формы меню версии: единственное действие меню плюс путь снятия тега.
// Страница глазами браузера с выключенным JS: содержимое <script> вырезано целиком.
Функция БезТеговScript(Знач HTML)

	Результат = HTML;
	Позиция = СтрНайти(Результат, "<script");

	Пока Позиция > 0 Цикл
		Хвост = Сред(Результат, Позиция);
		Конец = СтрНайти(Хвост, "</script>");
		Если Конец = 0 Тогда
			Возврат Лев(Результат, Позиция - 1);
		КонецЕсли;
		Результат = Лев(Результат, Позиция - 1) + Сред(Хвост, Конец + СтрДлина("</script>"));
		Позиция = СтрНайти(Результат, "<script");
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Разметка формы, в которой встречается маркер, целиком — от <form до </form>.
Функция ФормаСо(Знач Разметка, Знач Маркер)

	Позиция = СтрНайти(Разметка, Маркер);
	Если Позиция = 0 Тогда
		ВызватьИсключение "В разметке нет формы с маркером " + Маркер;
	КонецЕсли;

	Начало = 0;
	Хвост = Лев(Разметка, Позиция);
	Ищем = СтрНайти(Хвост, "<form");
	Пока Ищем > 0 Цикл
		Начало = Начало + Ищем;
		Хвост = Сред(Хвост, Ищем + 1);
		Ищем = СтрНайти(Хвост, "<form");
	КонецЦикла;

	Остаток = Сред(Разметка, Начало);
	Конец = СтрНайти(Остаток, "</form>");
	Возврат ?(Конец = 0, Остаток, Лев(Остаток, Конец + 6));

КонецФункции

// Оговорка «Показаны N из M» печатается, только когда командных пулов больше, чем влезает
// в обзор главной. Пулы заводятся, пока она не появится: это предпосылка теста, а не его
// проверка, поэтому число заведённых значения не имеет.
Процедура ЗавестиПулыДоОговорки(Знач Кука)

	Для Счёт = 1 По 12 Цикл
		Если СтрНайти(Тело(Клиент.GET("/")), "Показаны ") > 0 Тогда
			Возврат;
		КонецЕсли;
		ЗавестиПул(Кука, УникальныеИмена.Имя("fill"), "public");
	КонецЦикла;

	Ожидаем.Что(СтрНайти(Тело(Клиент.GET("/")), "Показаны ") > 0,
		"предпосылка: обзор пулов главной печатает оговорку «Показаны N из M»").ЭтоИстина();

КонецПроцедуры

// Идентификаторы всплывающих панелей меню: значение id у элемента, за которым идёт
// атрибут popover. Ищется признак верхнего слоя, а не префикс имени: сторожу важно, что
// панель всплывает и что идентификатор у неё свой, а не как именно кит его назвал.
Функция ИдентификаторыПанелейМеню(Знач Тело_)

	Результат = Новый Массив();
	Маркер = "id=""";
	Позиция = СтрНайти(Тело_, Маркер);

	Пока Позиция > 0 Цикл
		Хвост = Сред(Тело_, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, """");
		Если Конец > 1 И СтрНачинаетсяС(Сред(Хвост, Конец + 1), " popover") Тогда
			Результат.Добавить(Лев(Хвост, Конец - 1));
		КонецЕсли;
		Смещение = Позиция + СтрДлина(Маркер);
		Следующая = СтрНайти(Сред(Тело_, Смещение), Маркер);
		Позиция = ?(Следующая = 0, 0, Смещение + Следующая - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Значения атрибута по маркеру вида «имя="» в порядке появления в теле ответа.
Функция ЗначенияАтрибутовВТеле(Знач Тело_, Знач Маркер)

	Результат = Новый Массив();
	Позиция = СтрНайти(Тело_, Маркер);

	Пока Позиция > 0 Цикл
		Хвост = Сред(Тело_, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, """");
		Если Конец > 1 Тогда
			Результат.Добавить(Лев(Хвост, Конец - 1));
		КонецЕсли;
		Смещение = Позиция + СтрДлина(Маркер);
		Следующая = СтрНайти(Сред(Тело_, Смещение), Маркер);
		Позиция = ?(Следующая = 0, 0, Смещение + Следующая - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗавестиПул(Знач Кука, Знач Имя, Знач Видимость)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(АдресПулов(), Кука))));
	Поля.Вставить("операция", "пул-создать");
	Поля.Вставить("имя", Имя);
	Поля.Вставить("тип", "custom");
	Поля.Вставить("видимость", Видимость);
	Возврат Клиент.POSTФормы(АдресПулов(), Поля, Кука);

КонецФункции

// Раздел «Пулы» дома «Хаб»: список, создание, квоты — один адрес на всё.
Функция АдресПулов()
	Возврат "/hub/settings/pools";
КонецФункции

// Раздел «Почта» дома «Хаб»: настройки SMTP и проба отправки.
Функция АдресПочты()
	Возврат "/hub/settings/mail";
КонецФункции

// Приметой окна заведения служит ЕГО ИМЯ для скринридера: идентификатор выдаёт кит
// порядковым номером, и привязываться к номеру нельзя.
Функция ОкноЗаведенияПула()
	Возврат "aria-label=""Создать пул""";
КонецФункции

Функция ОкноЗаведенияГруппы()
	Возврат "aria-label=""Создать группу""";
КонецФункции

Функция ОкноЗаведенияУчётки()
	Возврат "aria-label=""Создать пользователя""";
КонецФункции

Функция ОкноВыдачиНаПул()
	Возврат "aria-label=""Выдать роль на пул""";
КонецФункции

Функция ОкноВыдачиНаПакет()
	Возврат "aria-label=""Выдать право на пакет""";
КонецФункции

// Разметка ОДНОГО окна — от его метки до закрывающего тега: проверка «что внутри окна»
// не должна ловить совпадение на остальной странице.
Функция ОкноПоМетке(Знач Разметка, Знач Метка)

	Позиция = СтрНайти(Разметка, Метка);
	Если Позиция = 0 Тогда
		ВызватьИсключение "В разметке нет окна с меткой " + Метка;
	КонецЕсли;

	Остаток = Сред(Разметка, Позиция);
	Конец = СтрНайти(Остаток, "</dialog>");
	Возврат ?(Конец = 0, Остаток, Лев(Остаток, Конец));

КонецФункции

// Раздел «Права доступа» дома ПУЛА: роли на пул выдаются там, где живёт сам пул.
Функция ЭкранПравПула(Знач ИмяПула)
	Возврат "/" + ИмяПула + "/settings/access";
КонецФункции

Функция ВыдатьРольНаПул(Знач Экран, Знач Токен, Знач Кука, Знач Субъект, Знач Роль,
	Знач ТипСубъекта = "пользователь")

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "выдать");
	Поля.Вставить("тип_субъекта", ТипСубъекта);
	Поля.Вставить("субъект", Субъект);
	Поля.Вставить("роль", Роль);
	Возврат Клиент.POSTФормы(Экран, Поля, Кука);

КонецФункции

Функция ОтозватьРольНаПул(Знач Экран, Знач Токен, Знач Кука, Знач Субъект,
	Знач ТипСубъекта = "пользователь")

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "отозвать");
	Поля.Вставить("тип_субъекта", ТипСубъекта);
	Поля.Вставить("субъект", Субъект);
	Возврат Клиент.POSTФормы(Экран, Поля, Кука);

КонецФункции

// Число M из оговорки «Показаны N из M — …»: сколько командных пулов видит смотрящий.
Функция ЧислоПуловИзОговорки(Знач Разметка, Знач Кто)

	Фрагмент = СокрЛП(СтрЗаменить(МеждуМаркеров(Разметка, "Показаны ", "—"), "Показаны ", ""));
	Части = СтрРазделить(Фрагмент, " ");

	Ожидаем.Что(Части.Количество() >= 3,
		Кто + ": оговорка обзора пулов на месте (получено «" + Фрагмент + "»)").ЭтоИстина();

	Возврат Число(Части[2]);

КонецФункции

// Второе нажатие визарда ничего не ломает: каналы уже есть, и хаб говорит об этом
// ПРЕДУПРЕЖДЕНИЕМ. Красная плашка на удавшемся действии читается как «не сохранилось»,
// поэтому проверяется именно вид плашки, а не наличие текста.
Процедура ПовторноеНажатиеПредупреждает(Знач Кука, Знач Страница)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука))));
	Поля.Вставить("операция", "каналы_по_умолчанию");
	Ответ = Клиент.POSTФормы(Страница, Поля, Кука);

	Ожидаем.Что(Ответ.КодСостояния, "повтор не отказ: 200, а не 400").Равно(200);

	Разметка = Тело(Ответ);
	Ожидаем.Что(ВидПлашкиУведомления(Разметка, "Заводить нечего"),
		"«заводить нечего» сказано предупреждением, а не ошибкой: " + Разметка).Равно("warn");

КонецПроцедуры

// Вид плашки уведомления, в тексте которой встретилось слово: класс несёт «toast--<вид>».
Функция ВидПлашкиУведомления(Знач Разметка, Знач Слово)

	Маркер = "toast toast--";
	Хвост = Разметка;
	Позиция = СтрНайти(Хвост, Маркер);

	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Вид = Лев(Хвост, СтрНайти(Хвост, """") - 1);
		Плашка = Клиент.ПослеМаркера(Хвост, "toast__text", "</span>");
		Если СтрНайти(Плашка, Слово) > 0 Тогда
			Возврат Вид;
		КонецЕсли;
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат "";

КонецФункции

// Слова о составе канала из строки окна визарда: имя канала стоит в первой ячейке
// машинным значением, состав — во второй, ПЕРЕД плашками. Возвращает то, что прочитает
// человек, — без разметки, поэтому одна плашка за пустыми словами сойти не может.
Функция СоставКаналаВОкне(Знач Окно, Знач ИмяКанала)

	Строка_ = Клиент.ПослеМаркера(Окно, "<code>" + ИмяКанала + "</code>", "</tr>");
	Ячейка = Клиент.ПослеМаркера(Строка_, "<td>", "</td>");
	Возврат СокрЛП(?(СтрНайти(Ячейка, "<") = 0, Ячейка, Лев(Ячейка, СтрНайти(Ячейка, "<") - 1)));

КонецФункции

Функция МеждуМаркеров(Знач Разметка, Знач Открытие, Знач Закрытие)

	Начало = СтрНайти(Разметка, Открытие);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Разметка, Начало);
	Конец = СтрНайти(Хвост, Закрытие);
	Возврат ?(Конец = 0, Хвост, Лев(Хвост, Конец));

КонецФункции

// Панель единого меню инсталляции: она стоит до содержимого страницы, поэтому кончается
// там, где начинается <main>.
Функция ПанельЕдиногоМеню(Знач Разметка)
	Возврат МеждуМаркеров(Разметка, "<div class=""hubmenu""", "<main");
КонецФункции

// Идентификаторы СТРОЧНЫХ меню: связи единого меню инсталляции живут по своим правилам
// (одна панель, три кнопки) и стерегутся отдельным сторожем.
Функция БезЕдиногоМеню(Знач Значения)

	Результат = Новый Массив();
	Для Каждого Значение Из Значения Цикл
		Если НЕ СтрНачинаетсяС(Значение, "hubmenu") Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПоляМеню(Знач Токен, Знач Операция, Знач Версия, Знач ИмяТега)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", Операция);
	Поля.Вставить("версия", Версия);
	Поля.Вставить("имя", ИмяТега);
	Возврат Поля;

КонецФункции

// Поля конструктора тега: вид (semver | regex | manual), операция, имя и оформление
// (ключи стиля и значка).
Функция ПоляКонструктора(Знач Токен, Знач Вид, Знач Операция, Знач ИмяТега,
	Знач Стиль, Знач Значок)

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("вид", Вид);
	Поля.Вставить("операция", Операция);
	Поля.Вставить("имя", ИмяТега);
	Поля.Вставить("стиль", Стиль);
	Поля.Вставить("значок", Значок);
	Возврат Поля;

КонецФункции

// Заводит ручной тег конструктором ровно так, как это делает человек: одним нажатием
// «Сохранить тег».
Процедура ЗавестиРучнойТег(Знач Кука, Знач ИмяТега, Знач Стиль, Знач Значок)

	Страница = "/public/alice-pkg/settings/tags";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница + "?kind=manual", Кука)));

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница,
		ПоляКонструктора(Токен, "manual", "сохранить", ИмяТега, Стиль, Значок), Кука)),
		"ручной тег " + ИмяТега + " сохранён").ЭтоИстина();

КонецПроцедуры

// Заводит тег выбранного вида ФОРМОЙ и проверяет, что вид сохранился и открылся выбранным.
Процедура ПроверитьВидТега(Знач Кука, Знач Вид, Знач Выражение, Знач Имя)

	Страница = "/public/alice-pkg/settings/tags";
	Разметка = Тело(Клиент.GETСКукой(Страница + "?kind=" + Вид, Кука));
	Ожидаем.Что(ВариантВыбран(Разметка, Вид), "вид «" + Вид + "» выбран в списке").ЭтоИстина();

	Поля = ПоляФормыСо(Разметка, "name=""вид""");
	Поля.Вставить("операция", "сохранить");
	Поля.Вставить("имя", Имя);
	Если ЗначениеЗаполнено(Выражение) Тогда
		Поля.Вставить("правило", Выражение);
	КонецЕсли;

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)),
		"тег вида «" + Вид + "» сохранён").ЭтоИстина();

	Правка = Тело(Клиент.GETСКукой(Страница + "?tag=" + Имя, Кука));
	Ожидаем.Что(ВариантВыбран(Правка, Вид),
		"сохранённый вид «" + Вид + "» открылся выбранным").ЭтоИстина();

	УдалитьТег(Кука, Имя);

КонецПроцедуры

// Поля формы конструктора тега в том виде, в каком их отправит браузер, плюс операция
// нажатой кнопки: кнопку разбор разметки не собирает — её посылает сам браузер.
Функция ПоляКонструктораСо(Знач Разметка)

	Поля = ПоляФормыСо(Разметка, "name=""запрет_перезаписи""");
	Поля.Вставить("операция", "сохранить");
	Возврат Поля;

КонецФункции

// Заводит тег-правило конструктором одним нажатием «Сохранить тег».
Процедура ЗавестиТегПравила(Знач Кука, Знач ИмяТега, Знач Выражение, Знач Стиль, Знач Значок)

	Страница = "/public/alice-pkg/settings/tags";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница + "?kind=semver", Кука)));

	Поля = ПоляКонструктора(Токен, "semver", "сохранить", ИмяТега, Стиль, Значок);
	Поля.Вставить("правило", Выражение);
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)),
		"тег-правило " + ИмяТега + " сохранён").ЭтоИстина();

КонецПроцедуры

// Заводит тег-регулярку: длинные выражения приходят именно этим видом правила.
Процедура ЗавестиТегРегекса(Знач Кука, Знач ИмяТега, Знач Выражение)

	Страница = "/public/alice-pkg/settings/tags";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница + "?kind=regex", Кука)));

	Поля = ПоляКонструктора(Токен, "regex", "сохранить", ИмяТега, "", "");
	Поля.Вставить("правило", Выражение);
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)),
		"тег-регулярка " + ИмяТега + " сохранён").ЭтоИстина();

КонецПроцедуры

// Страница, на которую увёл редирект после записи: клиент мог пройти по нему сам.
Функция ПослеЗаписи(Знач Ответ, Знач Кука)
	Возврат ?(Редирект(Ответ), Тело(Клиент.GETСКукой(Клиент.ЗаголовокОтвета(Ответ, "Location"), Кука)), Тело(Ответ));
КонецФункции

// Отзыв и восстановление версии формой раздела «Версии и метки».
Процедура ОтозватьВерсию(Знач Кука, Знач Версия, Знач Операция)

	Страница = "/public/alice-pkg/settings/versions";
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука))));
	Поля.Вставить("операция", Операция);
	Поля.Вставить("версия", Версия);

	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Поля, Кука)),
		"версия " + Версия + ": операция «" + Операция + "»").ЭтоИстина();

КонецПроцедуры

// Текст тоста, в котором встречается Маркер: сравнивать состав канала со всей страницей
// нечестно — те же номера версий печатает и таблица тегов рядом.
Функция ТекстТостаСо(Знач Разметка, Знач Маркер)

	Позиция = СтрНайти(Разметка, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Начало = 0;
	Хвост = Лев(Разметка, Позиция);
	Ищем = СтрНайти(Хвост, "<span class=""toast__text"">");
	Пока Ищем > 0 Цикл
		Начало = Начало + Ищем;
		Хвост = Сред(Хвост, Ищем + 1);
		Ищем = СтрНайти(Хвост, "<span class=""toast__text"">");
	КонецЦикла;
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(Разметка, Начало + СтрДлина("<span class=""toast__text"">"));
	Конец = СтрНайти(Остаток, "</span>");
	Возврат ?(Конец = 0, Остаток, Лев(Остаток, Конец - 1));

КонецФункции

Функция ДоПодстроки(Знач Текст, Знач Подстрока)
	Позиция = СтрНайти(Текст, Подстрока);
	Возврат ?(Позиция = 0, Текст, Лев(Текст, Позиция - 1));
КонецФункции

// Вид тоста («ok» | «warn» | «err»), в тексте которого встречается Маркер: цвет плашки
// уведомления — часть смысла, а не оформление.
Функция ВидТостаСо(Знач Разметка, Знач Маркер)

	Позиция = СтрНайти(Разметка, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Начало = 0;
	Хвост = Лев(Разметка, Позиция);
	Ищем = СтрНайти(Хвост, "class=""toast toast--");
	Пока Ищем > 0 Цикл
		Начало = Начало + Ищем;
		Хвост = Сред(Хвост, Ищем + 1);
		Ищем = СтрНайти(Хвост, "class=""toast toast--");
	КонецЦикла;
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(Разметка, Начало + СтрДлина("class=""toast toast--"));
	Конец = СтрНайти(Остаток, """");
	Возврат ?(Конец = 0, "", Лев(Остаток, Конец - 1));

КонецФункции

// Открывающий тег кнопки, внутри которого встречается Маркер: от ближайшего «<button»
// слева до конца тега. Нужен, чтобы судить о самой кнопке, а не о соседней разметке.
Функция ТегКнопкиСо(Знач Разметка, Знач Маркер)

	Позиция = СтрНайти(Разметка, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Начало = 0;
	Хвост = Лев(Разметка, Позиция);
	Ищем = СтрНайти(Хвост, "<button");
	Пока Ищем > 0 Цикл
		Начало = Начало + Ищем;
		Хвост = Сред(Хвост, Ищем + 1);
		Ищем = СтрНайти(Хвост, "<button");
	КонецЦикла;
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(Разметка, Начало);
	Конец = СтрНайти(Остаток, ">");
	Возврат ?(Конец = 0, Остаток, Лев(Остаток, Конец));

КонецФункции

// Снятие тега с версии целиком: вопрос и подтверждение.
Процедура СнятьТегСВерсии(Знач Кука, Знач ИмяТега, Знач Версия)

	Страница = "/public/alice-pkg/settings/versions";
	Токен = ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука)));

	Вопрос = Клиент.POSTФормы(Страница, ПоляМеню(Токен, "тег_снять", Версия, ИмяТега), Кука);
	Ожидаем.Что(Вопрос.КодСостояния, "вопрос о снятии тега " + ИмяТега).Равно(200);

	Подтверждение = ПоляФормыСо(Тело(Вопрос), "name=""подтверждение""");
	Ожидаем.Что(УспехМутации(Клиент.POSTФормы(Страница, Подтверждение, Кука)),
		"тег " + ИмяТега + " снят подтверждением").ЭтоИстина();

КонецПроцедуры

// Истина, если крестик снятия лежит ВНУТРИ плашки своего тега: подпись тега и открытие
// узла с крестиком обязаны идти подряд — соседним узлом крестик уехал бы переносом строки.
Функция СвязкаТегаСКрестиком(Знач Разметка, Знач ИмяТега)

	Маркер = ">" + ИмяТега + "<span class=""tag__action"">";
	Позиция = СтрНайти(Разметка, Маркер);
	Если Позиция = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Хвост = Сред(Разметка, Позиция + СтрДлина(Маркер));
	Конец = СтрНайти(Хвост, "</form>");
	Крестик = ?(Конец = 0, Хвост, Лев(Хвост, Конец));

	Возврат СтрНайти(Крестик, "value=""тег_снять""") > 0
		И СтрНайти(Крестик, "value=""" + ИмяТега + """") > 0;

КонецФункции

Функция СколькоРаз(Знач Текст, Знач Подстрока)

	Результат = 0;
	Хвост = Текст;
	Позиция = СтрНайти(Хвост, Подстрока);

	Пока Позиция > 0 Цикл
		Результат = Результат + 1;
		Хвост = Сред(Хвост, Позиция + СтрДлина(Подстрока));
		Позиция = СтрНайти(Хвост, Подстрока);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура УдалитьТег(Знач Кука, Знач ИмяТега)

	Страница = "/public/alice-pkg/settings/tags";
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(Клиент.GETСКукой(Страница, Кука))));
	Поля.Вставить("операция", "удалить");
	Поля.Вставить("имя", ИмяТега);
	Клиент.POSTФормы(Страница, Поля, Кука);

КонецПроцедуры

#КонецОбласти

// Сколько подписок в списке: у каждой строки ровно одна форма удаления.
// Идентификатор подписки, чья карточка несёт заданный адрес: в разделе живут подписки
// соседних тестов, и «первая попавшаяся» — не та.
Функция ИдПодпискиПоАдресу(Знач Разметка, Знач Адрес)

	Позиция = СтрНайти(Разметка, Адрес);
	Если Позиция = 0 Тогда
		ВызватьИсключение "В разделе нет подписки с адресом " + Адрес;
	КонецЕсли;
	Возврат Клиент.ПослеМаркера(Сред(Разметка, Позиция), "/public/settings/webhooks/", "/save");

КонецФункции

// Хвост разметки после маркера — чтобы смотреть форму заведения отдельно от карточек.
Функция ХвостПосле(Знач Разметка, Знач Маркер)
	Позиция = СтрНайти(Разметка, Маркер);
	Возврат ?(Позиция = 0, "", Сред(Разметка, Позиция));
КонецФункции

Функция ЧислоПодписок(Знач Разметка)
	Возврат СтрЧислоВхождений(Разметка, "/delete""");
КонецФункции

// Адрес раздела учётных записей дома «Хаб».
Функция АдресПользователей()
	Возврат "/hub/settings/users";
КонецФункции

Функция ПоляСозданияУчётки(Знач Токен, Знач Логин, Знач Email, Знач Роль)
	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Токен);
	Поля.Вставить("операция", "создать");
	Поля.Вставить("логин", Логин);
	Поля.Вставить("email", Email);
	Поля.Вставить("роль", Роль);
	Возврат Поля;
КонецФункции

Функция ПоляПароля(Знач Значение, Знач Пароль)
	Поля = Новый Соответствие();
	Поля.Вставить("token", Значение);
	Поля.Вставить("пароль", Пароль);
	Поля.Вставить("повтор", Пароль);
	Возврат Поля;
КонецФункции

// Значение одноразовой ссылки из разметки: показывается ровно один раз, в базе его нет.
Функция ИзвлечьЗначениеПриглашения(Знач Тело_)

	Поз = СтрНайти(Тело_, "oshub_inv_");
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(Тело_, Поз);
	Результат = "";
	Для Номер = 1 По СтрДлина(Остаток) Цикл
		Символ = Сред(Остаток, Номер, 1);
		Если Символ = "<" ИЛИ Символ = """" ИЛИ Символ = " " Тогда
			Прервать;
		КонецЕсли;
		Результат = Результат + Символ;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Идентификатор учётки из формы её строки в списке пользователей.
Функция ИдПользователяИзСписка(Знач Тело_)
	Возврат Клиент.ПослеМаркера(Тело_, "name=""пользователь"" value=""", """");
КонецФункции

// Строка таблицы, в которой встречается подстрока: проверка ветки СТРОКИ не должна
// зеленеть от того, что нужное слово нашлось в соседней.
Функция СтрокаТаблицыС(Знач Разметка, Знач Подстрока)

	Позиция = СтрНайти(Разметка, Подстрока);
	Если Позиция = 0 Тогда
		ВызватьИсключение "В разметке нет строки таблицы с подстрокой " + Подстрока;
	КонецЕсли;

	Начало = 0;
	Хвост = Лев(Разметка, Позиция);
	Ищем = СтрНайти(Хвост, "<tr");
	Пока Ищем > 0 Цикл
		Начало = Начало + Ищем;
		Хвост = Сред(Хвост, Ищем + 1);
		Ищем = СтрНайти(Хвост, "<tr");
	КонецЦикла;
	Если Начало = 0 Тогда
		ВызватьИсключение "Подстрока " + Подстрока + " найдена вне строки таблицы";
	КонецЕсли;

	Остаток = Сред(Разметка, Начало);
	Конец = СтрНайти(Остаток, "</tr>");
	Возврат ?(Конец = 0, Остаток, Лев(Остаток, Конец));

КонецФункции

Функция ИзвлечьCSRF(Знач Тело_)
	Возврат Клиент.ПослеМаркера(Тело_, "name=""_csrf"" value=""", """");
КонецФункции

// Значение атрибута value первого input с указанным name (для скрытых полей).
Функция ИзвлечьЗначениеПоля(Знач Тело_, Знач ИмяПоля)
	Возврат Клиент.ПослеМаркера(Тело_, "name=""" + ИмяПоля + """ value=""", """");
КонецФункции

// Идентификатор токена из action формы отзыва: /me/settings/tokens/{id}/revoke.
Функция ИзвлечьИдТокена(Знач Тело_)
	Возврат Клиент.ПослеМаркера(Тело_, "/me/settings/tokens/", "/revoke");
КонецФункции

// Секрет токена oshub_..., показанный один раз (внутри <code>...</code> после баннера).
Функция ИзвлечьСекрет(Знач Тело_)
	Поз = СтрНайти(Тело_, "oshub_");
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Тело_, Поз);
	Конец = 1;
	Пока Конец <= СтрДлина(Остаток) Цикл
		С = Сред(Остаток, Конец, 1);
		Если НЕ (С = "_" ИЛИ ЭтоБукваЦифра(С)) Тогда
			Прервать;
		КонецЕсли;
		Конец = Конец + 1;
	КонецЦикла;
	Возврат Лев(Остаток, Конец - 1);
КонецФункции

Функция ЭтоБукваЦифра(Знач С)
	Код = КодСимвола(С);
	Возврат (Код >= 48 И Код <= 57) ИЛИ (Код >= 65 И Код <= 90) ИЛИ (Код >= 97 И Код <= 122);
КонецФункции

#КонецОбласти

