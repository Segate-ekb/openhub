// Интеграционные тесты каркаса: хаб стартует отдельным процессом, /health отвечает 200
// и валидным JSON с растущим аптаймом, неизвестный путь — 404.

#Использовать asserts
#Использовать "фикстуры"

Перем Хаб;          // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Порт;         // порт тестового экземпляра (выдан ОС через фикстуру)

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ЗапуститьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");

	Хаб = Новый ЭкземплярХаба(60);

	Хаб.ФайловаяБаза("openhub-health");

	Хаб.Среда("OSHUB_ADMIN_LOGIN", "health-admin");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "HealthAdminPass1");

	Хаб.Запустить();          // свободный порт + процесс + ожидание /health
	Порт = Хаб.Порт();
	Хаб.ДождатьсяОнбординга(); // env-админ создаётся рогаткой с JIT-прогревом pwhash — ждём

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;

КонецПроцедуры

&Тест
&Тег("смоук")
Процедура ЗдоровьеОтвечает200ИВалиднымJSON() Экспорт

	Ответ = ВыполнитьЗапрос("/health");

	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Ожидаем.Что(СтрНачинаетсяС(НРег(Ответ.Заголовки["Content-Type"]), "application/json")).ЭтоИстина();

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Тело = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Ожидаем.Что(Тело["status"]).Равно("ok");
	Ожидаем.Что(ЗначениеЗаполнено(Тело["version"]), "version должна быть заполнена").ЭтоИстина();
	Ожидаем.Что(Тело["uptime_seconds"]).ИмеетТип("Число");

	ПервыйАптайм = Тело["uptime_seconds"];
	Приостановить(1100);
	ВторойАптайм = АптаймИзОтвета(ВыполнитьЗапрос("/health"));
	Ожидаем.Что(ВторойАптайм > ПервыйАптайм,
		СтрШаблон("аптайм растёт между запросами: было %1, стало %2", ПервыйАптайм, ВторойАптайм))
		.ЭтоИстина();

КонецПроцедуры

Функция АптаймИзОтвета(Знач Ответ)

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Тело = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Тело["uptime_seconds"];

КонецФункции

&Тест
Процедура НеизвестныйПутьОтвечает404() Экспорт

	Ожидаем.Что(ВыполнитьЗапрос("/нет-такого-пути").КодСостояния, "неизвестный пул -> 404").Равно(404);

	Ожидаем.Что(ВыполнитьЗапрос("/a/b/c").КодСостояния, "немаршрутизируемый путь -> 404 роутера").Равно(404);

КонецПроцедуры

Функция ВыполнитьЗапрос(Знач Путь)

	Соединение = Новый HTTPСоединение("localhost", Порт, , , , 10);
	Запрос = Новый HTTPЗапрос(Путь);

	Возврат Соединение.Получить(Запрос);

КонецФункции
