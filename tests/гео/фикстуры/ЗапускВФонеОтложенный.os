// Фикстура ЗапускВФоне: обработчик запоминается и исполняется по команде набора — чтобы смотреть
// на состояние, пока работа не сделана.

Перем Отложенные;

// Контракт ЗапускВФоне: откладывает обработчик до Догнать().
//
// Параметры:
//  Обработчик - Произвольный - объект с методом Исполнить().
//
Процедура Запустить(Знач Обработчик) Экспорт
	Отложенные.Добавить(Обработчик);
КонецПроцедуры

// Исполняет всё отложенное в порядке заказа и очищает очередь.
//
// Возвращаемое значение:
//  Число - сколько обработчиков исполнено.
//
Функция Догнать() Экспорт

	Очередь = Отложенные;
	Отложенные = Новый Массив();

	Для Каждого Обработчик Из Очередь Цикл
		Обработчик.Исполнить();
	КонецЦикла;

	Возврат Очередь.Количество();

КонецФункции

// Исполняет только первую работу очереди, остальные ждут дальше: так видно, что сделала одна
// работа, пока соседняя ещё не начиналась.
//
// Возвращаемое значение:
//  Число - сколько обработчиков исполнено: 1, а для пустой очереди 0.
//
Функция ДогнатьПервую() Экспорт

	Если Отложенные.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Первая = Отложенные[0];
	Отложенные.Удалить(0);
	Первая.Исполнить();

	Возврат 1;

КонецФункции

// Исполняет отложенное с конца очереди: фоновые задания порядка не обещают.
//
// Возвращаемое значение:
//  Число - сколько обработчиков исполнено.
//
Функция ДогнатьВОбратномПорядке() Экспорт

	Очередь = Отложенные;
	Отложенные = Новый Массив();

	Для Сдвиг = 0 По Очередь.ВГраница() Цикл
		Очередь[Очередь.ВГраница() - Сдвиг].Исполнить();
	КонецЦикла;

	Возврат Очередь.Количество();

КонецФункции

// Сколько работ ждёт своей очереди.
//
// Возвращаемое значение:
//  Число.
//
Функция Отложено() Экспорт
	Возврат Отложенные.Количество();
КонецФункции

&Прозвище("ЗапускВФоне")
&Желудь
Процедура ПриСозданииОбъекта()
	Отложенные = Новый Массив();
КонецПроцедуры
