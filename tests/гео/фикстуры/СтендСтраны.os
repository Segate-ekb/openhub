// Живой стенд страны посетителя: пробная база стран для хаба, провайдер входа и правило
// «закрыт в странах», заведённые формами администратора.

Перем Проба;  // фикстура БазаСтранПробная

// Кладёт пробную базу стран во временный каталог — её путь отдают хабу в OSHUB_GEO_DB__PATH.
//
// Параметры:
//  Префикс - Строка - префикс имени временного каталога.
//
// Возвращаемое значение:
//  Строка - полное имя файла базы.
//
Функция ПодложитьБазу(Знач Префикс) Экспорт
	Куда = ОбъединитьПути(УникальныеИмена.ВременныйКаталог(Префикс), "dbip-country-lite.csv");
	Возврат Проба.Положить(Куда);
КонецФункции

// Заводит включённого провайдера входа пресетом github формой администратора.
//
// Параметры:
//  Клиент - КлиентХаба - клиент хаба стенда.
//  Кука - Строка - сессия администратора.
//  ПрефиксИмени - Строка - начало уникального имени провайдера.
//
// Возвращаемое значение:
//  Строка - имя заведённого провайдера.
//
Функция ЗавестиПровайдера(Знач Клиент, Знач Кука, Знач ПрефиксИмени) Экспорт

	Имя = УникальныеИмена.Имя(ПрефиксИмени);
	HTML = Клиент.Тело(Клиент.GETСКукой("/hub/settings/providers?preset=github", Кука));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(HTML));
	Поля.Вставить("имя", Имя);
	Поля.Вставить("пресет", "github");
	Поля.Вставить("клиент", "Iv1.abcdef");
	Поля.Вставить("секрет", "секрет-значение");
	Поля.Вставить("возврат", "https://hub.example.com/oidc/callback");
	Поля.Вставить("включить", "1");

	Ответ = Клиент.POSTФормы("/hub/settings/providers", Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния < 400,
		"провайдер стенда заведён: " + Лев(Клиент.Тело(Ответ), 300)).ЭтоИстина();
	Возврат Имя;

КонецФункции

// Ставит провайдеру правило «закрыт в странах» формой окна «Страны и доступ».
//
// Параметры:
//  Клиент - КлиентХаба - клиент хаба стенда.
//  Имя - Строка - имя провайдера.
//  Страны - Строка - коды стран через запятую.
//  Кука - Строка - сессия администратора.
//
Процедура ПоставитьПравило(Знач Клиент, Знач Имя, Знач Страны, Знач Кука) Экспорт

	HTML = Клиент.Тело(Клиент.GETСКукой("/hub/settings/providers?countries=" + Имя, Кука));

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(HTML));
	Поля.Вставить("страны", Страны);

	Ответ = Клиент.POSTФормы("/hub/settings/providers/" + Имя + "/countries", Поля, Кука);
	Ожидаем.Что(Ответ.КодСостояния < 400, "правило стенда поставлено").ЭтоИстина();

КонецПроцедуры

// Стоит ли на странице атрибуция базы стран DB-IP.
//
// Параметры:
//  HTML - Строка - разметка страницы.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьАтрибуция(Знач HTML) Экспорт
	Возврат СтрНайти(HTML, "IP Geolocation by DB-IP") > 0
		И СтрНайти(HTML, "https://db-ip.com") > 0;
КонецФункции

Процедура ПриСозданииОбъекта()
	РеестрФикстур.Подключить("БазаСтранПробная");
	Проба = Новый БазаСтранПробная();
КонецПроцедуры
