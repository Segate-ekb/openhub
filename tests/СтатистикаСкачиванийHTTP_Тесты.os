// HTTP-интеграция витрины счётчика скачиваний: отдача .ospx → доменное событие → счётчик →
// страница пакета; HEAD и условный 304 скачивание не засчитывают.

#Использовать asserts
#Использовать "фикстуры"

Перем Хаб;           // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Порт;
Перем СидерЛог;

Перем УРЛСкачивания; // Legacy-путь выдачи winow latest в пуле main
Перем УРЛСтраницы;   // страница пакета winow

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	УРЛСкачивания = "/pools/main/download/winow/winow.ospx";
	УРЛСтраницы = "/main/winow";
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");

	Хаб = Новый ЭкземплярХаба(90);
	КаталогПроекта = Хаб.КаталогПроекта();
	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры", "ЗасеятьХаб.os");

	Основа = Хаб.ФайловаяБаза("openhub-stats");
	СидерЛог = ОбъединитьПути(Основа, "seed-error.log");
	Хаб.Среда("OSHUB_SEED_LOG", СидерЛог);

	ЗапуститьСидер(Сидер, КаталогПроекта);

	Хаб.Запустить();     // свободный порт + процесс + ожидание /health
	Порт = Хаб.Порт();

	ДождатьсяВитрины();

КонецПроцедуры

Процедура ДождатьсяВитрины()

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 60 * 1000;
	ПоследнийКод = 0;

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл

		Если НЕ Хаб.Работает() Тогда
			ВызватьИсключение "Процесс хаба умер после ответа /health." + Символы.ПС + Хаб.Дамп();
		КонецЕсли;

		Попытка
			ПоследнийКод = GET(УРЛСтраницы).КодСостояния;
			Если ПоследнийКод = 200 Тогда
				Возврат;
			КонецЕсли;
		Исключение
		КонецПопытки;

		Приостановить(200);

	КонецЦикла;

	ВызватьИсключение СтрШаблон("Витрина пакета не поднялась за 60 сек (последний код %1).%2%3",
		ПоследнийКод, Символы.ПС, Хаб.Дамп());

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

&Тест
Процедура СчётчикРастётТолькоНаРеальнойОтдаче() Экспорт

	ПроверитьСчётчик(0, "на свежей странице пакета счётчик скачиваний = 0");

	Голова = HEAD(УРЛСкачивания);
	Ожидаем.Что(Голова.КодСостояния, "HEAD .ospx → 200").Равно(200);
	ETag = Заголовок(Голова, "ETag");
	Ожидаем.Что(ЗначениеЗаполнено(ETag), "HEAD вернул ETag для условного запроса").ЭтоИстина();
	ПроверитьСчётчик(0, "HEAD не увеличивает счётчик");

	Условный = GETСЗаголовком(УРЛСкачивания, "If-None-Match", ETag);
	Ожидаем.Что(Условный.КодСостояния, "совпавший ETag → 304").Равно(304);
	ПроверитьСчётчик(0, "304 (Not Modified) не увеличивает счётчик");

	Первое = GET(УРЛСкачивания);
	Ожидаем.Что(Первое.КодСостояния, "GET .ospx → 200").Равно(200);
	Ожидаем.Что(Первое.ПолучитьТелоКакДвоичныеДанные().Размер() > 0, "тело .ospx не пустое").ЭтоИстина();
	ПроверитьСчётчик(1, "реальная отдача .ospx увеличила счётчик витрины до 1");

	Ожидаем.Что(GET(УРЛСкачивания).КодСостояния).Равно(200);
	ПроверитьСчётчик(2, "второе скачивание → счётчик 2");

КонецПроцедуры

Процедура ПроверитьСчётчик(Знач Ожидаемое, Знач Пояснение)

	Ответ = GET(УРЛСтраницы);
	Страница = Тело(Ответ);
	Фактическое = СчётчикВитрины(Страница);

	Диагностика = "";
	Если Фактическое <> Ожидаемое Тогда
		Диагностика = Символы.ПС + "--- журнал хаба ---" + Символы.ПС + Хаб.Дамп();
	КонецЕсли;

	Ожидаем.Что(Фактическое, СтрШаблон("%1 [код %2, счётчик %3, выдержка: %4]%5",
		Пояснение, Ответ.КодСостояния, Фактическое, ВыдержкаСтраницы(Страница), Диагностика)).Равно(Ожидаемое);

КонецПроцедуры

// Подпись метаданных в шапке пакета — значок: число стоит за визуально скрытой подписью,
// то есть за первым </span> элемента ряда.
Функция СчётчикВитрины(Знач Страница)

	Позиция = СтрНайти(Страница, "title=""скачиваний""");
	Если Позиция = 0 Тогда
		Возврат -1;
	КонецЕсли;

	Хвост = Сред(Страница, Позиция);
	Конец = СтрНайти(Хвост, "</span>");
	Если Конец = 0 Тогда
		Возврат -1;
	КонецЕсли;

	Цифры = "";
	Хвост = Сред(Хвост, Конец + СтрДлина("</span>"));
	Для Индекс = 1 По СтрДлина(Хвост) Цикл
		Символ = Сред(Хвост, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			Цифры = Цифры + Символ;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат ?(ЗначениеЗаполнено(Цифры), Число(Цифры), -1);

КонецФункции

Функция ВыдержкаСтраницы(Знач Страница)

	Начало = СтрНайти(Страница, "<title>");
	Если Начало > 0 Тогда
		Хвост = Сред(Страница, Начало + СтрДлина("<title>"));
		Конец = СтрНайти(Хвост, "</title>");
		Если Конец > 0 Тогда
			Возврат "title=" + Лев(Хвост, Конец - 1);
		КонецЕсли;
	КонецЕсли;

	Возврат Лев(СтрЗаменить(СтрЗаменить(Страница, Символы.ПС, " "), Символы.Таб, " "), 600);

КонецФункции

Функция Соединение()
	Возврат Новый HTTPСоединение("localhost", Порт, , , , 15);
КонецФункции

Функция GET(Знач Путь)
	Возврат Соединение().Получить(Новый HTTPЗапрос(Путь));
КонецФункции

Функция GETСЗаголовком(Знач Путь, Знач ИмяЗаголовка, Знач ЗначениеЗаголовка)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить(ИмяЗаголовка, ЗначениеЗаголовка);
	Возврат Соединение().Получить(Новый HTTPЗапрос(Путь, Заголовки));
КонецФункции

Функция HEAD(Знач Путь)
	Возврат Соединение().ВызватьHTTPМетод("HEAD", Новый HTTPЗапрос(Путь));
КонецФункции

Функция Тело(Знач Ответ)
	Возврат Ответ.ПолучитьТелоКакСтроку();
КонецФункции

Функция Заголовок(Знач Ответ, Знач Имя)
	ИскомыйКлюч = ВРег(Имя);
	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = ИскомыйКлюч Тогда
			Возврат КиЗ.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ЛогСидера()
	Если ЗначениеЗаполнено(СидерЛог) И Новый Файл(СидерЛог).Существует() Тогда
		Чтение = Новый ЧтениеТекста(СидерЛог, КодировкаТекста.UTF8);
		Содержимое = Чтение.Прочитать();
		Чтение.Закрыть();
		Возврат Содержимое;
	КонецЕсли;
	Возврат "лог недоступен";
КонецФункции

Процедура ЗапуститьСидер(Знач Сидер, Знач Каталог)
	Процесс_ = СоздатьПроцесс(СтрШаблон("oscript ""%1""", Сидер), Каталог, Истина);
	Процесс_.Запустить();
	Процесс_.ОжидатьЗавершения();
	Если Процесс_.КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("Сидер завершился с кодом %1: %2", Процесс_.КодВозврата, ЛогСидера());
	КонецЕсли;
КонецПроцедуры
