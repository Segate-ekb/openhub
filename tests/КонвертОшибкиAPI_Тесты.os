// Юнит-тесты конверта ошибки API: {error:{code,message,details}} один на все адреса.
// Подробностей нет — поля details нет вовсе, а не null: «не сообщили» и «сообщили пустое»
// для клиента разные вещи. Здесь же гейт отчёта по уровню: что уходит клиенту, а что —
// в журнал.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Ответы;

&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура Подключить() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	ПоискКлассов = Новый КлассыСлоя();
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Модули = ОбъединитьПути(Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя,
		"src", "модули");

	ПоискКлассов.ПодключитьОснову(Модули);
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ОтветJSONЗаглушка.os"));

	Ответы = Новый ОтветыAPI(Новый ЗаголовкиHTTP());

КонецПроцедуры

// Код и сообщение есть всегда: машинный код — для скрипта, слова — для человека.
&Тест
Процедура КонвертНесётКодИСообщение() Экспорт

	Ошибка = Отказ(409, "email_taken", "Адрес занят", Неопределено);

	Ожидаем.Что(Ошибка.Получить("code")).Равно("email_taken");
	Ожидаем.Что(Ошибка.Получить("message")).Равно("Адрес занят");

КонецПроцедуры

// Подробности — объектом, ровно теми полями, которые дал отказавший.
&Тест
Процедура ПодробностиПечатаютсяПолемDetails() Экспорт

	Подробности = Новый Структура();
	Подробности.Вставить("limit", "oshub.publish.max_upload_bytes");
	Подробности.Вставить("limit_bytes", 26214400);
	Подробности.Вставить("actual_bytes", 41943040);

	Поля = Отказ(413, "payload_too_large", "Пакет больше предела", Подробности)
		.Получить("details");

	Ожидаем.Что(Поля <> Неопределено, "поле details напечатано").ЭтоИстина();
	Ожидаем.Что(Поля.Получить("limit")).Равно("oshub.publish.max_upload_bytes");
	Ожидаем.Что(Поля.Получить("limit_bytes")).Равно(26214400);
	Ожидаем.Что(Поля.Получить("actual_bytes")).Равно(41943040);

КонецПроцедуры

// Ни Неопределено, ни пустой объект поля не рождают: клиент, читающий details, отличает
// «подробностей нет» от «подробности пустые».
&Тест
Процедура БезПодробностейПоляDetailsНет() Экспорт

	// смотрим сырое тело: разобранный JSON не отличает «поля нет» от «поле равно null»
	БезПодробностей = ТелоОтказа(400, "bad_request", "Так нельзя", Неопределено);
	Пустые = ТелоОтказа(400, "bad_request", "Так нельзя", Новый Структура());

	Ожидаем.Что(СтрНайти(БезПодробностей, "details"),
		"подробностей нет — поля нет: " + БезПодробностей).Равно(0);
	Ожидаем.Что(СтрНайти(Пустые, "details"),
		"пустой объект подробностями не считается: " + Пустые).Равно(0);

КонецПроцедуры

// Клиент, который details не читает (opm печатает тело как текст), ничего не теряет:
// код и сообщение стоят там же, где стояли.
&Тест
Процедура СтарыеПоляОстаютсяНаМесте() Экспорт

	Тело = ТелоОтказа(507, "quota_exceeded", "Квота пула исчерпана",
		Новый Структура("limit", "pool_quota_bytes"));

	Ожидаем.Что(СтрНайти(Тело, "quota_exceeded") > 0, "код на месте: " + Тело).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "Квота пула исчерпана") > 0,
		"и сообщение тоже: " + Тело).ЭтоИстина();

КонецПроцедуры

#Область Инфраструктура

Функция Отказ(Знач Статус, Знач Код, Знач Сообщение, Знач Подробности)
	Ответ = Новый ОтветJSONЗаглушка();
	Ответы.Ошибка(Ответ, Статус, Код, Сообщение, Подробности);
	Ожидаем.Что(Ответ.Код, "статус ответа").Равно(Статус);
	Возврат РазобратьТело(Ответ.ТелоТекст).Получить("error");
КонецФункции

Функция ТелоОтказа(Знач Статус, Знач Код, Знач Сообщение, Знач Подробности)
	Ответ = Новый ОтветJSONЗаглушка();
	Ответы.Ошибка(Ответ, Статус, Код, Сообщение, Подробности);
	Возврат Ответ.ТелоТекст;
КонецФункции

Функция РазобратьТело(Знач Тело)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Тело);
	Разобрано = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Разобрано;
КонецФункции

#КонецОбласти

#Область СбойНеТечётНаружуНоДоезжаетДоЖурнала

// Ядро гейта отчёта по уровню: текст пойманного исключения наружу НЕ идёт. В нём —
// пользовательский ввод, внутренности хаба и координаты чужого модуля; клиент читает
// только ту формулировку, которую выбрала дверь.
&Тест
Процедура СбойНеВыноситТекстИсключенияВОтвет() Экспорт

	Ответ = Новый ОтветJSONЗаглушка();

	Попытка
		ВызватьИсключение "внутренность-хаба-которой-снаружи-не-место";
	Исключение
		Ответы.Сбой(Ответ, 422, "invalid_tag", "Некорректный тег", ИнформацияОбОшибке());
	КонецПопытки;

	Ожидаем.Что(Ответ.Код, "статус выбирает дверь").Равно(422);
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "внутренность-хаба"),
		"текст исключения наружу не уходит: " + Ответ.ТелоТекст).Равно(0);
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "Некорректный тег") > 0,
		"а формулировка двери уходит: " + Ответ.ТелоТекст).ЭтоИстина();

КонецПроцедуры

// Подробности отказа — те и только те поля, которые дверь назвала сама (ИСТ-ПУБЛ-023):
// сбой их не выдумывает и цепочку причин в details не подмешивает.
&Тест
Процедура СбойБезПодробностейПоляDetailsНеРождает() Экспорт

	Ответ = Новый ОтветJSONЗаглушка();

	Попытка
		ВызватьИсключение "причина, у которой нет полей";
	Исключение
		Ответы.Сбой(Ответ, 500, "publish_failed", "Внутренняя ошибка публикации",
			ИнформацияОбОшибке());
	КонецПопытки;

	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "details"),
		"подробностей не назвали — поля нет: " + Ответ.ТелоТекст).Равно(0);

КонецПроцедуры

// Обратная сторона гейта: то, что не ушло клиенту, обязано уйти в журнал — иначе отказ
// становится неразбираемым. Полный отчёт пишется на уровне ОТЛАДКА.
&Тест
Процедура СбойПишетПричинуИОтчётВЖурнал() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.конверт.сбой");
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка);

	СЖурналом = Новый ОтветыAPI(Новый ЗаголовкиHTTP(), Неопределено, Неопределено,
		Неопределено, Лог);
	Ответ = Новый ОтветJSONЗаглушка();

	Попытка
		ВызватьИсключение "внутренность-хаба-которой-снаружи-не-место";
	Исключение
		СЖурналом.Сбой(Ответ, 422, "invalid_tag", "Некорректный тег", ИнформацияОбОшибке());
	КонецПопытки;

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "внутренность-хаба") > 0,
		"причина доехала до журнала: " + Ловушка.Всё()).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "invalid_tag") > 0,
		"и машинный код рядом с ней: " + Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область УровеньОтчётаВыбираетСтатус

// Поломка хаба обязана быть видна оператору на уровне ОШИБКА: 5xx это не «клиент прислал
// не то», а «у нас не вышло», и в консоли такой отказ должен бросаться в глаза.
&Тест
Процедура ПятисотыйПишетсяВЖурналУровнемОшибки() Экспорт

	Стенд = СтендСЖурналом();
	Отказать(Стенд, 500, "publish_failed", "Внутренняя ошибка публикации");

	Ожидаем.Что(СтрНайти(Стенд.Ловушка.Всё(), "ОШИБКА") > 0,
		"поломка хаба названа уровнем ОШИБКА: " + Стенд.Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

// Непринятый ввод поломкой не является: подними его до ОШИБКИ — и консоль боевого хаба
// заполнится чужими опечатками, за которыми настоящий отказ станет не виден.
&Тест
Процедура НепринятыйВводПишетсяУровнемОтладки() Экспорт

	Стенд = СтендСЖурналом();
	Отказать(Стенд, 422, "invalid_tag", "Некорректный тег");

	Ожидаем.Что(СтрНайти(Стенд.Ловушка.Всё(), "ОТЛАДКА") > 0,
		"ввод назван уровнем ОТЛАДКА: " + Стенд.Ловушка.Всё()).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Стенд.Ловушка.Всё(), "ОШИБКА"),
		"и уровнем ОШИБКА — нет: " + Стенд.Ловушка.Всё()).Равно(0);

КонецПроцедуры

// Ответы с собственным журналом: у каждого теста свой накопитель, иначе соседний
// прогон дописал бы в него свои строки.
Функция СтендСЖурналом()

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.конверт.уровень."
		+ Строка(Новый УникальныйИдентификатор()));
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка);

	Возврат Новый Структура("Ловушка, Ответы", Ловушка,
		Новый ОтветыAPI(Новый ЗаголовкиHTTP(), Неопределено, Неопределено, Неопределено, Лог));

КонецФункции

Процедура Отказать(Знач Стенд, Знач Статус, Знач Код, Знач Сообщение)

	Попытка
		ВызватьИсключение "причина, у которой есть место возникновения";
	Исключение
		Стенд.Ответы.Сбой(Новый ОтветJSONЗаглушка(), Статус, Код, Сообщение, ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
