// Юнит-тесты координат пакета для летописей: что помнится между вопросами, а что нет.
// Ответ фейка меняется между вопросами — так видно, спрошен реестр или отдана память.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогМодулейПуть;
Перем КаталогФикстур;
Перем Пакеты;
Перем Пулы;
Перем Координаты;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулейПуть = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогФикстур = ОбъединитьПути(КаталогТестов, "фикстуры");

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.ПодключитьОснову(КаталогМодулейПуть);
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулейПуть, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулейПуть, "реестр", "Классы"), "КоординатыПакета");

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкПакетЗапись.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкПакетовДляЛетописи.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкПуловДляЛетописи.os"));

КонецПроцедуры

&ПередКаждым
Процедура ПересобратьРеестр() Экспорт

	Пакеты = Новый ФейкПакетовДляЛетописи();
	Пулы = Новый ФейкПуловДляЛетописи();
	Пулы.Добавить(7, "мойпул");
	Пакеты.Добавить(42, "мойпакет", 7);
	Координаты = Новый КоординатыПакета(Пакеты, Пулы, Новый ИмяОбъектаАудита());

КонецПроцедуры

&Тест
Процедура КоординатыСобираютсяИзПулаИПакета() Экспорт

	Найденные = Координаты.Пакета(42);

	Ожидаем.Что(Найденные.ПулИдентификатор, "пул пакета — скоуп доставки").Равно(7);
	Ожидаем.Что(Найденные.ИмяПула).Равно("мойпул");
	Ожидаем.Что(Найденные.ИмяПакета).Равно("мойпакет");
	Ожидаем.Что(Найденные.Адрес, "адрес для журнала").Равно("мойпул/мойпакет");

КонецПроцедуры

&Тест
Процедура ПовторныйВопросОТомЖеПакетеИдётИзПамяти() Экспорт

	Координаты.Пакета(42);
	Пакеты.Добавить(42, "подменённый", 7); // реестр спрошен не будет

	Ожидаем.Что(Координаты.АдресПакета(42),
		"подряд идущие события одного пакета обслуживает память").Равно("мойпул/мойпакет");

КонецПроцедуры

// Память — карман на один пакет, а не карта на весь реестр: вопрос о соседе её занимает.
&Тест
Процедура ВопросОСоседеВытесняетЗапомненныйПакет() Экспорт

	Пакеты.Добавить(43, "сосед", 7);

	Координаты.Пакета(42);
	Координаты.Пакета(43);
	Пакеты.Добавить(42, "переименованный", 7);

	Ожидаем.Что(Координаты.АдресПакета(42),
		"пакет спрошен в реестре заново").Равно("мойпул/переименованный");

КонецПроцедуры

// Промах не запоминается: иначе пакет, которого не увидели однажды, до конца жизни
// процесса публиковал бы события с пустым скоупом доставки.
&Тест
Процедура УтраченныйПакетНеЗапоминается() Экспорт

	Утраченный = Координаты.Пакета(99);
	Ожидаем.Что(Утраченный.ПулИдентификатор, "скоуп доставки пуст").Равно(0);
	Ожидаем.Что(Утраченный.Адрес, "адрес называет утраченную сущность").Равно("пакет#99");

	Пакеты.Добавить(99, "опоздавший", 7);

	Повторные = Координаты.Пакета(99);
	Ожидаем.Что(Повторные.ПулИдентификатор, "пакет нашёлся со второго вопроса").Равно(7);
	Ожидаем.Что(Повторные.Адрес).Равно("мойпул/опоздавший");

КонецПроцедуры

&Тест
Процедура ПакетБезПулаОтдаётПустоеИмяПула() Экспорт

	Пакеты.Добавить(44, "сирота", 404);

	Найденные = Координаты.Пакета(44);

	Ожидаем.Что(Найденные.ПулИдентификатор, "идентификатор пула берётся из пакета").Равно(404);
	Ожидаем.Что(Найденные.ИмяПула, "имени утраченного пула нет").Равно("");

КонецПроцедуры

// Промах пула — такой же промах, как промах пакета: запомнить его значило бы навсегда
// оставить события пакета без имени пула в адресе журнала.
&Тест
Процедура УтраченныйПулНеЗапоминается() Экспорт

	Пакеты.Добавить(44, "сирота", 404);
	Координаты.Пакета(44);

	Пулы.Добавить(404, "нашёлся");

	Найденные = Координаты.Пакета(44);
	Ожидаем.Что(Найденные.ИмяПула, "пул спрошен заново").Равно("нашёлся");
	Ожидаем.Что(Найденные.Адрес, "и адрес журнала полон").Равно("нашёлся/сирота");

КонецПроцедуры
