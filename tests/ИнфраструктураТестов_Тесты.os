// Тесты инфраструктуры тестов: выдача портов, жизненный цикл подопытного хаба и линт
// исходников tests/. Линт читает ТЕКСТ и ловит типовые ошибки, а не доказывает
// отсутствие самодельного порта; детекторы проверены приманками на каждую форму.

#Использовать asserts
#Использовать "фикстуры"

Перем КаталогТестов;
Перем КаталогФикстур;

// Файлы, которым запрещённые конструкции разрешены ПО СУЩЕСТВУ (список закрытый,
// каждая позиция обоснована — иначе через него будут обходить правило):
//   ВыдачаПортов.os    — сама выдача: выбирает кандидата случайно, но затем берёт
//                        на него заявку и пробует у ОС (в этом и есть решение);
//   ЭкземплярХаба.os   — единственное место, которому положено знать путь к main.os;
//   этот набор          — держит образцы нарушений для самопроверки детектора.
Перем ИсключенияСкана;
Перем Выдачи;          // все выдачи, созданные тестом — освобождаются в &ПослеКаждого
Перем Хабы;            // все поднятые тестом хабы — останавливаются в &ПослеКаждого

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогФикстур = ОбъединитьПути(КаталогТестов, "фикстуры");

	ИсключенияСкана = Новый Массив();
	ИсключенияСкана.Добавить("ВыдачаПортов.os");
	ИсключенияСкана.Добавить("ЭкземплярХаба.os");
	ИсключенияСкана.Добавить("ИнфраструктураТестов_Тесты.os");

	РеестрФикстур.Подключить("ВыдачаПортов");

	РеестрФикстур.Подключить("ЭкземплярХаба");

КонецПроцедуры

&ПередКаждым
Процедура ЗабытьПрошлыйТест() Экспорт
	Выдачи = Новый Массив();
	Хабы = Новый Массив();
КонецПроцедуры

&ПослеКаждого
Процедура ПрибратьЗаСобой() Экспорт

	// Хабы — ПЕРВЫМИ: пока процесс жив, он держит порт, и снятая раньше времени заявка
	// позволила бы выдать этот же номер соседнему тесту.
	Если Хабы <> Неопределено Тогда
		Для Каждого Хаб Из Хабы Цикл
			Попытка
				Хаб.Остановить();
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	Если Выдачи <> Неопределено Тогда
		Для Каждого Выдача Из Выдачи Цикл
			Попытка
				Выдача.ВернутьВсе();
			Исключение
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	Хабы = Новый Массив();
	Выдачи = Новый Массив();

КонецПроцедуры

#Область СканИсходниковТестов

&Тест
Процедура НиОдинНаборНеУгадываетПорт() Экспорт

	// Правило: номер порта тестовому хабу выдаёт ОС (фикстура ВыдачаПортов), а не
	// автор набора. Любое фиксированное окно, случайное смещение, соседний «Порт + 1»
	// или запуск main.os мимо фикстуры — нарушение, и оно должно быть видно ЗДЕСЬ,
	// а не в виде «набор падает у второго агента».
	Нарушители = Новый Массив();
	Просканировано = 0;

	Для Каждого Файл Из ФайлыТестов() Цикл

		Просканировано = Просканировано + 1;
		Текст = ПрочитатьФайл(Файл.ПолноеИмя);

		Нарушения = НарушенияВТексте(Текст);

		Для Каждого Нарушение Из НарушенияАннотаций(Текст) Цикл
			Нарушения.Добавить(Нарушение);
		КонецЦикла;

		Для Каждого Нарушение Из НарушенияПодключенияКоннекторов(Текст) Цикл
			Нарушения.Добавить(Нарушение);
		КонецЦикла;

		// Фикстурам вдобавок ЗАПРЕЩЕНО поднимать хаб и ходить по HTTP: иначе слой
		// косвенности над ЭкземплярХаба стал бы легальной лазейкой для набора.
		// Сравниваем по ПРЕФИКСУ с разделителем: Файл.Путь отдаёт каталог со слешем на
		// конце, ОбъединитьПути — без него, и прямое сравнение молча не срабатывало
		// (проверено: правило для фикстур не применялось ни разу).
		Если СтрНачинаетсяС(Файл.ПолноеИмя, КаталогФикстур + ПолучитьРазделительПути())
			И ФикстурыЗапускальщики().Найти(Файл.Имя) = Неопределено Тогда
			Для Каждого Нарушение Из НарушенияФикстуры(Текст) Цикл
				Нарушения.Добавить(Нарушение);
			КонецЦикла;
		КонецЕсли;

		Для Каждого Нарушение Из Нарушения Цикл
			Нарушители.Добавить(Файл.Имя + ": " + Нарушение);
		КонецЦикла;

	КонецЦикла;

	// Защита от вечнозелёности: сканер обязан реально что-то прочитать — и добраться
	// до ПОДКАТАЛОГОВ, иначе рекурсия молча выродится в прежний плоский обход.
	Ожидаем.Что(Просканировано > 40, СтрШаблон("просканировано файлов: %1", Просканировано)).ЭтоИстина();
	Ожидаем.Что(ЕстьФайлИзПодкаталога(), "линт обязан видеть файлы подкаталогов tests/").ЭтоИстина();

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС), "порты в тестах угадываются вручную").Равно("");

КонецПроцедуры

&Тест
Процедура ДетекторЛовитНаборСAutumnDataБезКоннекторов() Экспорт

	// ЛОВУШКА, которая молча съедает целый набор. Имя класса коннектора стоит в
	// autumn-properties.json, и заготовка autumn-data резолвит его `Тип(<имя>)` при
	// сборке КАЖДОГО контейнера ОСени в этом чекауте — включая контейнер раннера
	// OneUnit. Коннекторы приезжают с entity: без директивы тип не зарегистрирован, и
	// набор падает «Type is not registered» ЕЩЁ ДО ПЕРВОГО ТЕСТА — без единого
	// выполненного утверждения и без намёка на причину.
	// Воспроизводилось на 19 наборах разом.
	Плохой = "#Использовать asserts" + Символы.ПС + "#Использовать autumn-data";
	Хороший = "#Использовать entity" + Символы.ПС + "#Использовать autumn-data";

	Ожидаем.Что(ЕстьНарушение(НарушенияПодключенияКоннекторов(Плохой), "entity"),
		"набор с autumn-data без entity ловится").ЭтоИстина();
	Ожидаем.Что(НарушенияПодключенияКоннекторов(Хороший).Количество(),
		"корректный набор нарушений не даёт").Равно(0);
	Ожидаем.Что(НарушенияПодключенияКоннекторов("#Использовать asserts").Количество(),
		"набор без autumn-data правило не касается").Равно(0);

КонецПроцедуры

&Тест
Процедура ДетекторНаходитВсеЧетыреНарушения() Экспорт

	// Сканер проверяется на ЗАВЕДОМО плохом образце: если детектор перестанет ловить
	// хотя бы один вид нарушения, тест выше станет вечнозелёным, а этот — покраснеет.
	Образец = Новый Массив();
	Образец.Добавить("	Хаб = НовыйХаб(90);");
	Образец.Добавить("	Порт = 20000 + ГСЧ.СлучайноеЧисло(0, 9999);");
	Образец.Добавить("	ПортДва = Порт + 1;");

	Найдено = НарушенияВТексте(СтрСоединить(Образец, Символы.ПС));

	// вторая строка образца даёт сразу два нарушения (случайное число + литерал порта)
	Ожидаем.Что(ЕстьНарушение(Найдено, "случайн"), "ловится случайный порт").ЭтоИстина();
	Ожидаем.Что(ЕстьНарушение(Найдено, "фиксированн"), "ловится фиксированный номер порта").ЭтоИстина();
	Ожидаем.Что(ЕстьНарушение(Найдено, "соседн"), "ловится арифметика соседнего порта").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДетекторЛовитОбходЧерезОбёрткуНадФикстурой() Экспорт

	// ОБХОД №1 из ревью: набор не упоминает ни ЭкземплярХаба, ни main.os — он ходит
	// через слой косвенности. Прежний детектор по подстроке отключал на таком файле
	// ВСЕ четыре правила разом. Теперь правила идут от потребителя номера, а не от
	// имени фикстуры, поэтому файл проверяется как обычно.
	Образец = Новый Массив();
	Образец.Добавить("	Обёртка = Новый ОбёрткаХаба();");
	Образец.Добавить("	Порт = 25000 + ГСЧ.СлучайноеЧисло(0, 999);");
	Образец.Добавить("	Обёртка.Поднять(Порт);");
	Образец.Добавить("	Соединение = Новый HTTPСоединение(""localhost"", Порт, , , , 15);");

	Найдено = НарушенияВТексте(СтрСоединить(Образец, Символы.ПС));

	Ожидаем.Что(ЕстьНарушение(Найдено, "случайн"), "обход обёрткой: случайный порт").ЭтоИстина();
	Ожидаем.Что(ЕстьНарушение(Найдено, "фиксированн"), "обход обёрткой: фиксированный номер").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗапускатьПроцессыВправеТолькоФикстурыИзЗакрытогоСписка() Экспорт

	// Список — исключение из правила, поэтому он обязан оставаться коротким и
	// проверяемым: незнакомая фикстура ловится, знакомая пропускается, а сам список
	// не должен разрастись незаметно.
	Образец = Новый Массив();
	Образец.Добавить("	Процесс = СоздатьПроцесс(""oscript main.os"");");
	Образец.Добавить("	Соединение = Новый HTTPСоединение(""localhost"", НомерПорта);");
	Найдено = НарушенияФикстуры(СтрСоединить(Образец, Символы.ПС));

	Ожидаем.Что(ЕстьНарушение(Найдено, "запускает процесс"), "чужая фикстура ловится").ЭтоИстина();
	Ожидаем.Что(ЕстьНарушение(Найдено, "HTTP-соединение"), "и по HTTP ей тоже нельзя").ЭтоИстина();

	Ожидаем.Что(ФикстурыЗапускальщики().Количество(),
		"список запускальщиков разрастается только осознанно").Равно(2);
	Ожидаем.Что(ФикстурыЗапускальщики().Найти("ЭкземплярХаба.os"), "подопытный хаб в списке")
		.Существует();
	Ожидаем.Что(ФикстурыЗапускальщики().Найти("ЭкземплярФейковогоIdP.os"), "фейковый IdP в списке")
		.Существует();

КонецПроцедуры

&Тест
Процедура ДетекторЛовитПортПодЧужимИменем() Экспорт

	// ОБХОД №2 из ревью: переменная названа без слова «порт». Прежний детектор искал
	// слово «Порт» в той же строке и такой номер пропускал. Теперь имя опознаётся по
	// РОЛИ — оно стоит в позиции порта у HTTPСоединение.
	Образец = Новый Массив();
	Образец.Добавить("	НомерХаба = 25000;");
	Образец.Добавить("	Соединение = Новый HTTPСоединение(""localhost"", НомерХаба, , , , 15);");

	Ожидаем.Что(ЕстьНарушение(НарушенияВТексте(СтрСоединить(Образец, Символы.ПС)), "фиксированн"),
		"порт под чужим именем всё равно ловится").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДетекторЛовитАрифметикуОтВызоваПорта() Экспорт

	// ОБХОД №3 из ревью: естественная форма соседнего порта — не «Порт + 1», а
	// «Хаб.Порт() + 1». Прежний детектор ждал «+» сразу за словом «Порт» и на скобке
	// сбивался.
	Образец = Новый Массив();
	Образец.Добавить("	ПортДва = Хаб.Порт() + 1;");
	Образец.Добавить("	Соединение = Новый HTTPСоединение(""localhost"", ПортДва, , , , 15);");

	Ожидаем.Что(ЕстьНарушение(НарушенияВТексте(СтрСоединить(Образец, Символы.ПС)), "соседн"),
		"арифметика от вызова Порт() ловится").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДетекторЛовитФиксированныйНомерПрямоВВызове() Экспорт

	// Вырожденная форма: номер вообще без переменной.
	Образец = "	Соединение = Новый HTTPСоединение(""localhost"", 25000, , , , 15);";

	Ожидаем.Что(ЕстьНарушение(НарушенияВТексте(Образец), "прямо в вызове"),
		"литерал в позиции порта ловится").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДетекторЛовитПереносСтрокиВВызове() Экспорт

	// ОБХОД А (второй круг ревью): длинный вызов, разбитый переносами. Это НЕ уловка —
	// так выглядит любой отформатированный вызов. Разбор по физическим строкам не выходил
	// за строку и не находил ни одного аргумента.
	Образец = Новый Массив();
	Образец.Добавить("	Соединение = Новый HTTPСоединение(");
	Образец.Добавить("		""localhost"",");
	Образец.Добавить("		25000,");
	Образец.Добавить("		,");
	Образец.Добавить("		15);");

	Ожидаем.Что(ЕстьНарушение(НарушенияВТексте(СтрСоединить(Образец, Символы.ПС)), "прямо в вызове"),
		"номер в многострочном вызове ловится").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДетекторЛовитОтмывкуЧерезПеременную() Экспорт

	// ОБХОД Б: литерал кладётся в постороннюю переменную, а уже она — в порт.
	Образец = Новый Массив();
	Образец.Добавить("	Значение = 25000;");
	Образец.Добавить("	Порт = Значение;");

	Ожидаем.Что(ЕстьНарушение(НарушенияВТексте(СтрСоединить(Образец, Символы.ПС)), "фиксированн"),
		"литерал через промежуточную переменную ловится").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДетекторЛовитСмещениеПеременной() Экспорт

	// ОБХОД Г: слагаемое — переменная, а не цифра.
	Образец = Новый Массив();
	Образец.Добавить("	Смещение = 1;");
	Образец.Добавить("	ПортДва = Хаб.Порт() + Смещение;");

	Ожидаем.Что(ЕстьНарушение(НарушенияВТексте(СтрСоединить(Образец, Символы.ПС)), "соседн"),
		"смещение переменной ловится").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДетекторЛовитПробелПередСкобкой() Экспорт

	// ОБХОД Д: законный синтаксис — пробел между именем типа и скобкой.
	Образец = "	Соединение = Новый HTTPСоединение (""localhost"", 25000, , , , 15);";

	Ожидаем.Что(ЕстьНарушение(НарушенияВТексте(Образец), "прямо в вызове"),
		"пробел перед скобкой не прячет номер").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДетекторЛовитЗапускательВЛюбомФайлеTests() Экспорт

	// ОБХОД З: тот же слой косвенности, поднятый из tests/фикстуры/ в tests/. Каталожный
	// запрет его не видел — правило теперь по СУЩЕСТВУ: путь к сценарию литералом.
	// (В образце имя собрано из кусков — тем же приёмом, каким обходили правило.)
	Образец = "	П = СоздатьПроцесс(""oscript "" + ОбъединитьПути(Корень, ""src"", ""ma" + "in.os""), Корень, Истина);";

	Ожидаем.Что(ЕстьНарушение(НарушенияВТексте(Образец), "зашит литералом"),
		"самодельный запуск ловится в любом файле tests/").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗапускЧерезПеременнуюНеСчитаетсяНарушением() Экспорт

	// Обратная сторона правила З: законные запуски сидеров и opm передают путь
	// переменной либо через СтрШаблон — ложной красноты быть не должно, иначе правило
	// начнут обходить.
	Чистый = Новый Массив();
	Чистый.Добавить("	П = СоздатьПроцесс(СтрШаблон(""oscript ""%1"""", Сидер), КаталогПроекта, Истина);");
	Чистый.Добавить("	ПроцессOpm = СоздатьПроцесс(""opm install -l "" + Пакет, РабочийКаталог, Истина);");
	Чистый.Добавить("	Проба = СоздатьПроцесс(""opm version"", , Истина);");

	Ожидаем.Что(СтрСоединить(НарушенияВТексте(СтрСоединить(Чистый, Символы.ПС)), "; "),
		"законные запуски нарушений не дают").Равно("");

КонецПроцедуры

&Тест
Процедура ИменаАннотацийСверяютсяСКанонами() Экспорт

	// Имя-призрак игнорируется МОЛЧА: «&ПослеКаждым» вместо «&ПослеКаждого» прожил в
	// проекте с шага 1.D, хук уборки не вызывался ни разу. Параметр-призрак, наоборот,
	// роняет прогон — уязвимы только имена.
	Ожидаем.Что(ЕстьНарушение(НарушенияАннотаций("&ПослеКаждым" + Символы.ПС + "Процедура Убрать() Экспорт"), "игнорируется молча"),
		"опечатка в имени аннотации ловится").ЭтоИстина();

	Ожидаем.Что(ЕстьНарушение(НарушенияАннотаций("&ПередКаждым" + Символы.ПС + "Процедура Подготовить() Экспорт"), "игнорируется молча"),
		"каноничное имя OneUnit нарушением не считается").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура АннотацииПодключённыхБиблиотекЗаконныВTests() Экспорт

	// Правило бьёт по ВСЕМ файлам tests/, а фикстуры законно пользуются аннотациями не
	// только OneUnit. Осенние — доминирующий стиль конструкторов; entity — заглушки
	// сущностей, где пять законных имён встречаются В ОДНОМ файле, то есть цена ошибки
	// здесь не «одна краснота», а «набор целиком».
	Законные = Новый Массив();
	Законные.Добавить("&Желудь");
	Законные.Добавить("&Деталька(Значение = ""oshub.storage.root"")");
	Законные.Добавить("&Пластилин(Значение = ""СервисПулов"")");
	Законные.Добавить("&Рогатка(ЗапускатьВФоне = Ложь)");
	Законные.Добавить("&Прозвище(""ХранилищеS3"")");
	Законные.Добавить("&Сущность");
	Законные.Добавить("&ХранилищеСущностей(""Пакеты"")");
	Законные.Добавить("&Идентификатор");
	Законные.Добавить("&ГенерируемоеЗначение");
	Законные.Добавить("&Колонка(Тип = ""Строка"")");
	Законные.Добавить("&ПодчиненнаяТаблица");
	Законные.Добавить("&МетодЗапроса(""GET"")");
	Законные.Добавить("&ЛогВебСервера");
	Законные.Добавить("&Контроллер(""/"")");
	Законные.Добавить("&ТочкаМаршрута(""/health"")");

	Для Каждого Аннотация Из Законные Цикл
		Ожидаем.Что(НарушенияАннотаций(Аннотация + Символы.ПС + "Процедура ПриСозданииОбъекта()").Количество(),
			"аннотация подключённой библиотеки " + Аннотация + " законна").Равно(0);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ЗаглушкаСущностиНеДаётЛожнойКрасноты() Экспорт

	// Ровно та фикстура, на которой линт краснел пятью нарушениями сразу: такой файл
	// вероятен в ветке 5.C, и покраснеть он должен был БЫ в чужой ветке на законном коде.
	Заглушка = Новый Массив();
	Заглушка.Добавить("&Сущность");
	Заглушка.Добавить("&ХранилищеСущностей(""ТестовыеПакеты"")");
	Заглушка.Добавить("Перем Ссылка;");
	Заглушка.Добавить("");
	Заглушка.Добавить("&Идентификатор");
	Заглушка.Добавить("&ГенерируемоеЗначение");
	Заглушка.Добавить("Перем Код;");
	Заглушка.Добавить("");
	Заглушка.Добавить("&Колонка(Тип = ""Строка"", Длина = 100)");
	Заглушка.Добавить("Перем Имя;");

	Ожидаем.Что(СтрСоединить(НарушенияАннотаций(СтрСоединить(Заглушка, Символы.ПС)), "; "),
		"заглушка сущности законна целиком").Равно("");

КонецПроцедуры

&Тест
Процедура ТранспортИЭкспортНеСчитаютсяПортом() Экспорт

	// Мина ложных срабатываний: слова «транспорт» и «экспорт» СОДЕРЖАТ «порт». В tests/
	// уже живут ТранспортOTLPХаба, ФейкТранспортHTTP, ТранспортJWKSХаба, ЭкспортИдётЧерез —
	// и одна строка вида «ТранспортТаймаут = 10000» красила бы чужой набор. Граница слова
	// здесь camelCase: «Порт» с заглавной буквы.
	Чужие = Новый Массив();
	Чужие.Добавить("	ТранспортТаймаут = 10000;");
	Чужие.Добавить("	ЭкспортныйБуфер = 2048;");
	Чужие.Добавить("	ФейкТранспортHTTP = 30000;");

	Ожидаем.Что(СтрСоединить(НарушенияВТексте(СтрСоединить(Чужие, Символы.ПС)), "; "),
		"транспорт и экспорт — не порт").Равно("");

	// а настоящее портовое имя по-прежнему ловится
	Ожидаем.Что(ЕстьНарушение(НарушенияВТексте("	НомерПорта = 25000;"), "фиксированн"),
		"НомерПорта остаётся портовым именем").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДлинныйВызовНеТеряетХвост() Экспорт

	// ОБХОД К: раньше склейка обрывалась на 12-й строке, и аргумент за ней молча уезжал
	// в «следующую» логическую строку — потеря хвоста конструкции, то есть баг разбора.
	// Теперь склейка держится до закрывающей скобки, а многострочные литералы больше не
	// ломают баланс (состояние литерала переживает перевод строки).
	// Первый аргумент — вложенный многострочный вызов, из-за него НОМЕР ПОРТА оказывается
	// за 12-й строкой конструкции. Форма реалистичная: так выглядит вызов с собранным
	// на месте хостом.
	Образец = Новый Массив();
	Образец.Добавить("	Соединение = Новый HTTPСоединение(");
	Образец.Добавить("		ХостИзНастроек(");
	Для Счётчик = 1 По 12 Цикл
		Образец.Добавить("			ПараметрНастройки,");
	КонецЦикла;
	Образец.Добавить("			Последний),");
	Образец.Добавить("		25000,");
	Образец.Добавить("		15);");

	Ожидаем.Что(ЕстьНарушение(НарушенияВТексте(СтрСоединить(Образец, Символы.ПС)), "прямо в вызове"),
		"номер за 12-й строкой вызова не теряется").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура МногострочныйЛитералНеЛомаетРазбор() Экспорт

	// Обратная сторона: «|»-продолжение внутри СтрШаблон не должно склеивать полфайла и
	// давать ложную красноту (так падали ПубликацияPush и Контракт_Opm).
	Образец = Новый Массив();
	Образец.Добавить("	Конфиг = СтрШаблон(");
	Образец.Добавить("	""{");
	Образец.Добавить("	|    ""Порт"": %1,");
	Образец.Добавить("	|}"", Формат(Порт, ""ЧГ=0""));");
	Образец.Добавить("	П = СоздатьПроцесс(Команда, Каталог, Истина);");

	Ожидаем.Что(СтрСоединить(НарушенияВТексте(СтрСоединить(Образец, Символы.ПС)), "; "),
		"многострочный литерал не даёт ложной красноты").Равно("");

КонецПроцедуры

&Тест
Процедура ФикстуреЗапрещеноПодниматьХабИХодитьПоHTTP() Экспорт

	// Запрет вместо подстроки: обёртка-посредник между набором и ЭкземплярХаба — сама
	// по себе нарушение, независимо от того, как она называется.
	СЗапуском = "	П = СоздатьПроцесс(Команда, Каталог, Истина);";
	СHTTP = "	Возврат Новый HTTPСоединение(""localhost"", НомерПорта, , , , 15);";

	Ожидаем.Что(ЕстьНарушение(НарушенияФикстуры(СЗапуском), "запускает процесс"),
		"фикстура-запускатель ловится").ЭтоИстина();
	Ожидаем.Что(ЕстьНарушение(НарушенияФикстуры(СHTTP), "HTTP-соединение"),
		"фикстура с HTTP ловится").ЭтоИстина();
	Ожидаем.Что(НарушенияФикстуры("	Значения.Вставить(Имя, Значение);").Количество(),
		"обычная заглушка нарушений не даёт").Равно(0);

КонецПроцедуры

&Тест
Процедура ПравилаПортаНеРаспространяютсяНаЮнитыКонфигурации() Экспорт

	// Обратная сторона правила: набор, который хаб НЕ поднимает, вправе проверять
	// дефолтный порт хаба числом (КонфигурацияХаба_Тесты: 3333, "8080"). Иначе сканер
	// краснел бы там, где никакого угадывания нет, и правило начали бы обходить.
	Образец = Новый Массив();
	Образец.Добавить("	Конфигурация = Новый КонфигурацияХаба();");
	Образец.Добавить("	Ожидаем.Что(Конфигурация.Порт()).Равно(3333);");

	Ожидаем.Что(СтрСоединить(НарушенияВТексте(СтрСоединить(Образец, Символы.ПС)), "; "),
		"юнит конфигурации нарушений не даёт").Равно("");

КонецПроцедуры

&Тест
Процедура ДетекторЛовитЗапускХабаМимоФикстуры() Экспорт

	// Отдельным тестом: строка запуска main.os вне фикстуры. В образце имя файла
	// собрано из частей — иначе этот набор нарушал бы собственное правило.
	ПлохаяСтрока = "	П = СоздатьПроцесс(""oscript "" + ОбъединитьПути(Корень, ""src"", ""ma" + "in.os""));";

	Ожидаем.Что(ЕстьНарушение(НарушенияВТексте(ПлохаяСтрока), "фикстур"),
		"ловится запуск хаба мимо фикстуры").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПутьКТочкеВходаВЛитералеНеСчитаетсяЗапуском() Экспорт

	// Обратная сторона: «литерал — не директива». Статический линт (ДисциплинаЛогирования)
	// называет src/main.os ключом в списке исключений и ничего не поднимает — сканер,
	// читавший любое упоминание, красил его как самодельный запуск хаба.
	Данные = Новый Массив();
	Данные.Добавить("	Исключения = Новый Соответствие();");
	Данные.Добавить("	Исключения.Вставить(""src/ma" + "in.os"", ""точка входа: инъекции туда не доезжает"");");

	Ожидаем.Что(СтрСоединить(НарушенияВТексте(СтрСоединить(Данные, Символы.ПС)), "; "),
		"путь к точке входа в данных запуском не считается").Равно("");

КонецПроцедуры

&Тест
Процедура ДетекторНеРугаетсяНаЧистыйКод() Экспорт

	// Обратная сторона: типовой код фикстурного набора не должен давать ложную красноту
	// (иначе правило начнут обходить). Комментарии и строковые литералы вырезаются.
	Чистый = Новый Массив();
	Чистый.Добавить("	// раньше здесь было: Порт = 20000 плюс ГСЧ.СлучайноеЧисло(0, 9999)");
	Чистый.Добавить("	Хаб = НовыйХаб(90);");
	Чистый.Добавить("	Хаб.Запустить();");
	Чистый.Добавить("	Порт = Хаб.Порт();");
	Чистый.Добавить("	Соединение = Новый HTTPСоединение(""localhost"", Порт, , , , 15);");
	Чистый.Добавить("	Ожидаем.Что(GET_Порт(ПортДва, ""/setup"").КодСостояния).Равно(200);");

	Ожидаем.Что(СтрСоединить(НарушенияВТексте(СтрСоединить(Чистый, Символы.ПС)), "; "),
		"чистый код нарушений не даёт").Равно("");

КонецПроцедуры

&Тест
Процедура НаборДефектовБиблиотекПропущенЦеликом() Экспорт

	Файл_ = Новый Файл(ОбъединитьПути(КаталогТестов, "ДефектыБиблиотек_Тесты.os"));
	Ожидаем.Что(Файл_.Существует(),
		"набор дефектов библиотек на месте: " + Файл_.ПолноеИмя).ЭтоИстина();

	Текст = ПрочитатьФайл(Файл_.ПолноеИмя);

	// защита от вечнозелёности: сканер обязан реально увидеть тесты, а не пустой файл
	Ожидаем.Что(ВсегоТестовВТексте(Текст) >= 10,
		СтрШаблон("в наборе найдено тестов: %1", ВсегоТестовВТексте(Текст))).ЭтоИстина();

	Ожидаем.Что(СтрСоединить(НепропущенныеТесты(Текст), ", "),
		"в наборе дефектов библиотек есть НЕпропущенные тесты — это красный CI"
		+ " на чужом дефекте; либо верните безусловный пропуск, либо перенесите тест"
		+ " в обычный набор, если апстрим дефект починил").Равно("");

КонецПроцедуры

&Тест
Процедура ЛинтПропусковЛовитЖивойТестВНабореДефектов() Экспорт

	Пропущенный = "&Тест" + Символы.ПС
		+ "&ВключенЕсли(""() -> Ложь""," + Символы.ПС
		+ "	Причина = ""библиотека X: не работает Y"")" + Символы.ПС
		+ "Процедура ЧужойДефект() Экспорт" + Символы.ПС + "КонецПроцедуры";
	Ожидаем.Что(НепропущенныеТесты(Пропущенный).Количество(),
		"на безусловном пропуске сканер молчит").Равно(0);

	Живой = "&Тест" + Символы.ПС
		+ "Процедура ЧужойДефект() Экспорт" + Символы.ПС + "КонецПроцедуры";
	Ожидаем.Что(СтрСоединить(НепропущенныеТесты(Живой), ", "),
		"снятый гейт пойман").Равно("ЧужойДефект");

	// ПОДМЕНА безусловного пропуска СРЕДОВЫМ гейтом — самая правдоподобная ошибка:
	// выглядит как пропуск, но краснеет там, где окружение есть.
	Условный = "&Тест" + Символы.ПС
		+ "&ВключенЕсли(""() -> SQLiteДоступен()""," + Символы.ПС
		+ "	Причина = ""нет нативной библиотеки"")" + Символы.ПС
		+ "Процедура ЧужойДефект() Экспорт" + Символы.ПС + "КонецПроцедуры";
	Ожидаем.Что(СтрСоединить(НепропущенныеТесты(Условный), ", "),
		"средовой гейт пропуском не считается").Равно("ЧужойДефект");

	ВыключенЕсли = "&Тест" + Символы.ПС
		+ "&ВыключенЕсли(""() -> Истина"")" + Символы.ПС
		+ "Процедура ЧужойДефект() Экспорт" + Символы.ПС + "КонецПроцедуры";
	Ожидаем.Что(СтрСоединить(НепропущенныеТесты(ВыключенЕсли), ", "),
		"&ВыключенЕсли условен и пропуском не считается").Равно("ЧужойДефект");

	// &Выключен без суффикса — законная безусловная форма OneUnit
	Выключенный = "&Тест" + Символы.ПС
		+ "&Выключен" + Символы.ПС
		+ "Процедура ЧужойДефект() Экспорт" + Символы.ПС + "КонецПроцедуры";
	Ожидаем.Что(НепропущенныеТесты(Выключенный).Количество(),
		"&Выключен — безусловная форма, сканер молчит").Равно(0);

	// пропуск, спрятанный в КОММЕНТАРИЙ, пропуском не является
	ВКомментарии = "&Тест" + Символы.ПС
		+ "// &ВключенЕсли(""() -> Ложь"")" + Символы.ПС
		+ "Процедура ЧужойДефект() Экспорт" + Символы.ПС + "КонецПроцедуры";
	Ожидаем.Что(СтрСоединить(НепропущенныеТесты(ВКомментарии), ", "),
		"закомментированный пропуск не считается").Равно("ЧужойДефект");

	// соседние объявления не считаются тестами: гейт относится только к своему &Тест
	Соседи = "&ТестовыйНабор(Характер = ""Одиночка"")" + Символы.ПС
		+ "Процедура ПриСозданииОбъекта() Экспорт" + Символы.ПС + "КонецПроцедуры" + Символы.ПС
		+ "&ПередВсеми" + Символы.ПС
		+ "Процедура Подготовить() Экспорт" + Символы.ПС + "КонецПроцедуры" + Символы.ПС
		+ "Функция Служебная()" + Символы.ПС + "КонецФункции";
	Ожидаем.Что(ВсегоТестовВТексте(Соседи),
		"&ТестовыйНабор, &ПередВсеми и служебные функции тестами не считаются").Равно(0);
	Ожидаем.Что(НепропущенныеТесты(Соседи).Количество(),
		"на наборе без тестов сканер молчит").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ВыдачаПортов

&Тест
Процедура ВыданныйПортДействительноСвободен() Экспорт

	Выдача = НоваяВыдача();
	Порт = Выдача.Выдать();

	Ожидаем.Что(Порт > 0, "порт выдан").ЭтоИстина();
	Ожидаем.Что(Новый Файл(Выдача.ПутьЗаявки(Порт)).Существует(), "заявка на порт удерживается").ЭтоИстина();

	// главное: ОС отдаёт этот порт под bind — значит он свободен не «по нашему мнению»
	Сервер = Новый TCPСервер(Порт);
	Сервер.Запустить();
	Сервер.Остановить();

	Выдача.ВернутьВсе();
	Ожидаем.Что(Новый Файл(Выдача.ПутьЗаявки(Порт)).Существует(), "заявка снята при возврате").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ВыданныеПортыЛежатВБезопасномДиапазоне() Экспорт

	// Диапазон — часть гарантии, а не деталь реализации:
	//   * НИЖЕ 20000 живут чужие сервисы, включая хаб разработчика, поднятый вручную
	//     (наблюдался на порту 3380) — выдать такой порт значит убить чужую работу;
	//   * ВЫШЕ 32000 начинаются эфемерные диапазоны ОС (Linux 32768+, macOS 49152+),
	//     откуда ядро само раздаёт порты исходящим соединениям — оттуда порт могут
	//     отобрать между пробой и стартом хаба.
	Выдача = НоваяВыдача();
	Порты = Новый Массив();

	Для Счётчик = 1 По 20 Цикл
		Порт = Выдача.Выдать();
		Порты.Добавить(Порт);
		Ожидаем.Что(Порт >= 20000 И Порт <= 32000,
			СтрШаблон("порт %1 вне безопасного диапазона 20000..32000", Порт)).ЭтоИстина();
	КонецЦикла;

	// и все двадцать — разные (заявки не переиспользуются, пока не возвращены)
	Уникальные = Новый Соответствие();
	Для Каждого Порт Из Порты Цикл
		Уникальные.Вставить(Порт, Истина);
	КонецЦикла;
	Ожидаем.Что(Уникальные.Количество(), "двадцать выдач — двадцать разных портов").Равно(20);

	Выдача.ВернутьВсе();

КонецПроцедуры

&Тест
Процедура ДваВыдатчикаНеПолучаютОдинПорт() Экспорт

	// Детерминированное доказательство взаимоисключения: диапазон сужен до ОДНОГО
	// номера. Первый выдатчик его получает, второй обязан уйти ни с чем — ровно это
	// и происходит между двумя параллельными прогонами oneunit на машине.
	Единственный = СвободныйПортДляОпыта();

	Первый = НоваяВыдача();
	Первый.УстановитьДиапазон(Единственный, Единственный);
	Ожидаем.Что(Первый.Выдать()).Равно(Единственный);

	Второй = НоваяВыдача();
	Второй.УстановитьДиапазон(Единственный, Единственный);

	Отказал = Ложь;
	Попытка
		Второй.Выдать();
	Исключение
		Отказал = Истина;
	КонецПопытки;

	Ожидаем.Что(Отказал, "занятый заявкой порт второму выдатчику не достаётся").ЭтоИстина();

	// после возврата номер снова в обороте
	Первый.ВернутьВсе();
	Ожидаем.Что(Второй.Выдать()).Равно(Единственный);
	Второй.ВернутьВсе();

КонецПроцедуры

&Тест
Процедура БрошеннаяЗаявкаПерехватывается() Экспорт

	// Прогон, снятый извне (SIGKILL по сторожу — за этот этап случалось), заявку снять
	// не успевает. Такая заявка обязана перехватываться по времени, иначе номер выпадает
	// из оборота навсегда. Возраст задаём НАСТОЯЩИЙ — сдвигаем время изменения файла,
	// а не подкручиваем порог: проверять надо правило, а не сеттер.
	Единственный = СвободныйПортДляОпыта();

	Брошенная = НоваяВыдача();
	Брошенная.УстановитьДиапазон(Единственный, Единственный);
	Ожидаем.Что(Брошенная.Выдать()).Равно(Единственный);

	Путь = Брошенная.ПутьЗаявки(Единственный);
	Ожидаем.Что(Новый Файл(Путь).Существует(), "заявка создана").ЭтоИстина();

	// пока заявка свежая — порт занят и вторым выдатчиком не берётся
	Свежая = НоваяВыдача();
	Свежая.УстановитьДиапазон(Единственный, Единственный);
	Отказал = Ложь;
	Попытка
		Свежая.Выдать();
	Исключение
		Отказал = Истина;
	КонецПопытки;
	Ожидаем.Что(Отказал, "свежая заявка чужого прогона уважается").ЭтоИстина();

	// делаем её брошенной: старше порога устаревания
	ФайлЗаявки = Новый Файл(Путь);
	ФайлЗаявки.УстановитьВремяИзменения(ТекущаяДата() - 5 * 3600);

	Перехватчик = НоваяВыдача();
	Перехватчик.УстановитьДиапазон(Единственный, Единственный);
	Ожидаем.Что(Перехватчик.Выдать(), "брошенная заявка перехвачена").Равно(Единственный);

КонецПроцедуры

&Тест
Процедура ВернутьНеСвойПортНеСнимаетЧужуюЗаявку() Экспорт

	// Инкапсуляция: экземпляр отвечает только за то, что выдал сам. Иначе ошибочный
	// Вернуть(чужой_порт) освободил бы заявку другого прогона (замечание ревью).
	Единственный = СвободныйПортДляОпыта();

	Владелец = НоваяВыдача();
	Владелец.УстановитьДиапазон(Единственный, Единственный);
	Ожидаем.Что(Владелец.Выдать()).Равно(Единственный);

	Посторонний = НоваяВыдача();
	Посторонний.Вернуть(Единственный);

	Ожидаем.Что(Новый Файл(Владелец.ПутьЗаявки(Единственный)).Существует(),
		"чужая заявка осталась на месте").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПортЗанятыйЧужимПроцессомНеВыдаётся() Экспорт

	// Заявок на него нет (чужой процесс о наших файлах не знает) — отсекает только
	// проба у ОС. Так отбраковываются осиротевшие хабы и посторонний софт.
	Единственный = СвободныйПортДляОпыта();

	Чужой = Новый TCPСервер(Единственный);
	Чужой.Запустить();

	Выдача = НоваяВыдача();
	Выдача.УстановитьДиапазон(Единственный, Единственный);

	Отказал = Ложь;
	Попытка
		Выдача.Выдать();
	Исключение
		Отказал = Истина;
	КонецПопытки;

	Чужой.Остановить();

	Ожидаем.Что(Отказал, "занятый в ОС порт не выдаётся").ЭтоИстина();
	Ожидаем.Что(Новый Файл(Выдача.ПутьЗаявки(Единственный)).Существует(),
		"заявка на непригодный порт не остаётся мусором").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ЖизненныйЦиклХаба

&Тест
Процедура НеудачныйСтартНеОставляетСироту() Экспорт

	// Хаб стартует за секунды; таймаут готовности в 1 секунду гарантированно истекает,
	// когда процесс ЖИВ. Это ровно тот случай, в котором раньше оставался сирота с
	// PPID=1: исключение улетало из &ПередВсеми, а процесс продолжал держать порт.
	Хаб = НовыйХаб(1);
	Хаб.ФайловаяБаза("openhub-сирота-проба");

	Упало = Ложь;
	Попытка
		Хаб.Запустить();
	Исключение
		Упало = Истина;
	КонецПопытки;

	Ожидаем.Что(Упало, "старт с таймаутом 1 сек не мог успеть").ЭтоИстина();
	Ожидаем.Что(Хаб.Работает(), "процесс хаба убит фикстурой").ЭтоЛожь();
	Ожидаем.Что(Хаб.Порт(), "порт возвращён в оборот").Равно(0);

	// Главное: процесса с этим PID в системе НЕТ. Ассерт именно на таблице процессов —
	// «фикстура считает, что убила» и «убила» это разные утверждения, а долг был ровно
	// про живых сирот.
	PID = Хаб.ПоследнийИдентификаторПроцесса();
	Ожидаем.Что(PID > 0, "PID подопытного процесса известен").ЭтоИстина();
	Ожидаем.Что(ПроцессЖив(PID), СтрШаблон("процесс %1 не пережил неудачный старт", PID)).ЭтоЛожь();

	// Повторный Остановить() после провала безопасен (наборы зовут его в &ПослеВсех).
	Хаб.Остановить();

КонецПроцедуры

&Тест
Процедура ХабПомеченМеткойПрогонаДляВнешнейЧистки() Экспорт

	// Гарантия «сироты не остаётся» кончается там, где прогон снимают извне (SIGKILL):
	// тогда не исполняется ни одна строка фикстуры. Единственное, что может помочь
	// внешней чистке — метка на процессе. Проверяем, что метка ДОХОДИТ до процесса
	// хаба, а не остаётся обещанием в комментарии: спрашиваем окружение у самой ОС.
	Хаб = НовыйХаб(90);
	Хаб.ФайловаяБаза("openhub-метка-проба");
	Хаб.Запустить();

	Метка = Хаб.МеткаПрогона();
	PID = Хаб.ИдентификаторПроцесса();

	Ожидаем.Что(ЗначениеЗаполнено(Метка), "метка прогона задана").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ОкружениеПроцесса(PID), Метка) > 0,
		СтрШаблон("метка %1 видна в окружении процесса %2", Метка, PID)).ЭтоИстина();

	Хаб.Остановить();

КонецПроцедуры

&Тест
Процедура ОстановкаОсвобождаетПортИОкружение() Экспорт

	Хаб = НовыйХаб(90);
	Хаб.ФайловаяБаза("openhub-остановка-проба");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Запустить();

	Порт = Хаб.Порт();
	PID = Хаб.ИдентификаторПроцесса();
	Ожидаем.Что(Хаб.Работает(), "хаб поднялся").ЭтоИстина();
	Ожидаем.Что(ПроцессЖив(PID), "процесс хаба виден в системе").ЭтоИстина();

	Хаб.Остановить();

	Ожидаем.Что(Хаб.Работает(), "процесс остановлен").ЭтоЛожь();
	Ожидаем.Что(ПроцессЖив(PID), СтрШаблон("процесс %1 снят с системы", PID)).ЭтоЛожь();
	Ожидаем.Что(ЗначениеЗаполнено(ПолучитьПеременнуюСреды("OSHUB_PORT")),
		"OSHUB_PORT не утекает следующим наборам").ЭтоЛожь();
	Ожидаем.Что(Новый Файл(НоваяВыдача().ПутьЗаявки(Порт)).Существует(),
		"заявка на порт снята").ЭтоЛожь();

	Хаб.Остановить(); // идемпотентность

КонецПроцедуры

&Тест
Процедура ОтказГотовностиОбъясняетСебяЖурналомХаба() Экспорт

	Хаб = НовыйХаб(5);

	Сообщение = Хаб.СообщениеОтказаГотовности(503, "");

	Ожидаем.Что(СтрНайти(Сообщение, "503") > 0,
		"последний код ответа назван").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Сообщение, "Стартовые задачи") > 0,
		"состояние стартовых задач названо").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Сообщение, "Журнал хаба:") > 0,
		"дамп хаба приложен — «отвечал 503» без журнала не объясняет ПОЧЕМУ").ЭтоИстина();

	// не поднимавшийся хаб честно говорит об отсутствии вывода, а не молчит
	Ожидаем.Что(СтрНайти(Сообщение, "вывод не сохранён") > 0,
		"дамп не пустая строка даже без процесса").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебное

// Хаб, за которым приберёт &ПослеКаждого (см. ПрибратьЗаСобой). Тесты обязаны поднимать
// хабы только так — иначе упавший ассерт оставит сироту.
Функция НовыйХаб(Знач ТаймаутГотовностиСек = 90)

	Хаб = Новый ЭкземплярХаба(ТаймаутГотовностиСек);
	Хабы.Добавить(Хаб);

	Возврат Хаб;

КонецФункции

// Выдача, за которой приберёт &ПослеКаждого (см. ПрибратьЗаСобой).
Функция НоваяВыдача()

	Выдача = Новый ВыдачаПортов();
	Выдачи.Добавить(Выдача);

	Возврат Выдача;

КонецФункции

// Окружение процесса по данным ОС. macOS отдаёт его через `ps -E`, Linux — через
// /proc/<pid>/environ; берём то, что сработало.
Функция ОкружениеПроцесса(Знач PID)

	Команда = СтрШаблон("ps -E -p %1", Формат(PID, "ЧГ=0; ЧН=0"));
	Проба = СоздатьПроцесс(Команда, , Истина);
	Проба.Запустить();
	Проба.ОжидатьЗавершения();
	Вывод = Проба.ПотокВывода.Прочитать();

	Если ЗначениеЗаполнено(Вывод) Тогда
		Возврат Вывод;
	КонецЕсли;

	Путь = СтрШаблон("/proc/%1/environ", Формат(PID, "ЧГ=0; ЧН=0"));
	Если Новый Файл(Путь).Существует() Тогда
		Возврат ПрочитатьФайл(Путь);
	КонецЕсли;

	Возврат "";

КонецФункции

// Жив ли процесс с таким PID — спрашиваем у системы, а не у своей памяти.
// Именно этим отличается «фикстура думает, что убила» от «убила».
Функция ПроцессЖив(Знач PID)

	Проба = СоздатьПроцесс(СтрШаблон("ps -p %1", Формат(PID, "ЧГ=0; ЧН=0")), , Истина);
	Проба.Запустить();
	Проба.ОжидатьЗавершения();

	// ps завершается кодом 0, только если процесс найден
	Возврат Проба.КодВозврата = 0;

КонецФункции

// Свободный порт «для опыта»: берём у той же выдачи и сразу возвращаем — номер
// заведомо в допустимом диапазоне и свободен на момент опыта.
Функция СвободныйПортДляОпыта()

	Выдача = НоваяВыдача();
	Порт = Выдача.Выдать();
	Выдача.ВернутьВсе();

	Возврат Порт;

КонецФункции

&Тест
Процедура НиОдинКлассНеОбъявляетМетодДважды() Экспорт

	Нарушители = Новый Массив();
	Просканировано = 0;

	Для Каждого Файл_ Из ИсходникиПроекта() Цикл

		Просканировано = Просканировано + 1;
		Имена = Новый Соответствие();

		Для Каждого Строка_ Из СтрРазделить(БезКомментариев(ПрочитатьФайл(Файл_.ПолноеИмя)), Символы.ПС, Истина) Цикл

			ИмяМетода = ИмяОбъявляемогоМетода(Строка_);
			Если НЕ ЗначениеЗаполнено(ИмяМетода) Тогда
				Продолжить;
			КонецЕсли;

			Если Имена.Получить(НРег(ИмяМетода)) = Истина Тогда
				Нарушители.Добавить(СтрШаблон("%1: метод %2 объявлен повторно", Файл_.Имя, ИмяМетода));
			КонецЕсли;
			Имена.Вставить(НРег(ИмяМетода), Истина);

		КонецЦикла;

	КонецЦикла;

	// защита от вечнозелёности: сканер обязан реально что-то прочитать
	Ожидаем.Что(Просканировано > 100, СтрШаблон("просканировано исходников: %1", Просканировано)).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС), "методы объявлены повторно").Равно("");

КонецПроцедуры

&Тест
Процедура ЛинтДублейЛовитПовторноеОбъявление() Экспорт

	СПовтором = "Функция Прочитать(А) Экспорт" + Символы.ПС + "КонецФункции" + Символы.ПС
		+ "Процедура Прочитать(Б) Экспорт" + Символы.ПС + "КонецПроцедуры";
	Ожидаем.Что(ПовторыВТексте(СПовтором).Количество() > 0, "повтор пойман").ЭтоИстина();

	БезПовтора = "Функция Прочитать(А) Экспорт" + Символы.ПС + "КонецФункции" + Символы.ПС
		+ "Процедура Записать(Б) Экспорт" + Символы.ПС + "КонецПроцедуры";
	Ожидаем.Что(ПовторыВТексте(БезПовтора).Количество(), "на чистом тексте молчит").Равно(0);

	// объявление в КОММЕНТАРИИ повтором не считается
	СКомментарием = "Функция Прочитать(А) Экспорт" + Символы.ПС + "КонецФункции" + Символы.ПС
		+ "// Функция Прочитать(Б) Экспорт";
	Ожидаем.Что(ПовторыВТексте(СКомментарием).Количество(), "комментарий не считается").Равно(0);

КонецПроцедуры

// Есть ли среди сканируемых файлов хотя бы один из ПОДКАТАЛОГА (глубже tests/ и
// tests/фикстуры). Без этой проверки переход обхода обратно на плоский остался бы
// незамеченным — счётчик файлов почти не изменился бы.
Функция ЕстьФайлИзПодкаталога()

	Для Каждого Файл Из ФайлыТестов() Цикл
		Родитель = Новый Файл(Файл.Путь).ПолноеИмя;
		Если Родитель <> Новый Файл(КаталогТестов).ПолноеИмя
			И Родитель <> Новый Файл(КаталогФикстур).ПолноеИмя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ФайлыТестов()

	Результат = Новый Массив();

	// РЕКУРСИВНО. Раньше сканировались только два каталога верхнего уровня, и любой
	// подкаталог tests/ был слепым пятном линта: файл в tests/фикстуры/<что-то>/
	// не проверялся вовсе. Дыру открыл первый же такой подкаталог (старт-хаос).
	Для Каждого Файл Из НайтиФайлы(КаталогТестов, "*.os", Истина) Цикл
		Если ИсключенияСкана.Найти(Файл.Имя) = Неопределено Тогда
			Результат.Добавить(Файл);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Нарушения правил линта в тексте модуля.
//
// Разбор идёт по ЛОГИЧЕСКИМ строкам: физические склеиваются, пока не закроются скобки.
// Без этого любой отформатированный длинный вызов (перенос после запятой) выпадал из
// анализа целиком — «Новый HTTPСоединение(» ↵ «"localhost",» ↵ «25000,» не давал ни
// одного нарушения, потому что разбор аргументов не выходил за физическую строку.
//
// Порядок правил — от ПОТРЕБИТЕЛЯ номера:
//   1) что играет роль номера порта: аргумент-порт в HTTPСоединение()/TCPСервер(),
//      имена со словом «порт», а также имена, ОТКУДА они присвоены (провенанс на шаг
//      назад — иначе «Значение = 25000; Порт = Значение» отмывает литерал);
//   2) откуда это имя получает значение: литерал >= 1024, случайное число, арифметика
//      (± число ИЛИ ± переменная — «Хаб.Порт() + Смещение» это то же угадывание).
//
// Параметры:
//   Текст - Строка - исходный текст .os-файла.
//
// Возвращаемое значение:
//   Массив из Строка - описания нарушений (пустой массив = чисто).
//
Функция НарушенияВТексте(Знач Текст)

	Результат = Новый Массив();

	// Два среза одного текста: путь к точке входа живёт в ЛИТЕРАЛЕ (его надо сохранить),
	// а угадывание порта — это КОД (литералы и комментарии вырезаны, иначе ложная
	// краснота на примере в комментарии и ложная зелень на спрятанном в строку).
	// Правила по ЛИТЕРАЛАМ — по физическим строкам: склейка им не нужна, а многострочный
	// литерал («|»-продолжение в СтрШаблон) ломает скобочный баланс и склеивал десятки
	// строк в одну, давая ложную красноту на законных СтрШаблон+СоздатьПроцесс.
	ТолькоКод = БезКомментариевИЛитералов(Текст);
	СтрокиСЛитералами = СтрРазделить(БезКомментариев(Текст), Символы.ПС, Истина);
	СтрокиКода = ЛогическиеСтроки(ТолькоКод);

	// Запуск хаба — это ЗАПУСК, а не упоминание: путь к точке входа обязан лежать
	// в литерале (иначе его не написать), но одного литерала мало. Статический линт
	// называет src/main.os ключом в списке исключений и ничего не поднимает; пока
	// в КОДЕ файла нет запуска процесса, такой литерал — данные, а не директива.
	ФайлЗапускаетПроцессы = ЕстьЗапускПроцессаВКоде(ТолькоКод);

	Для НомерФизической = 1 По СтрокиСЛитералами.Количество() Цикл

		Физическая = СтрокиСЛитералами[НомерФизической - 1];

		Если ФайлЗапускаетПроцессы И СтрНайти(НРег(Физическая), "main.os") > 0 Тогда
			Результат.Добавить(СтрШаблон("строка %1: хаб поднимается мимо фикстуры ЭкземплярХаба", НомерФизической));
		КонецЕсли;

		// Запуск процесса, которому путь к сценарию зашит литералом (в том числе склейкой
		// вида "ma" + "in.os"): законные запуски в наборах передают путь переменной или
		// через СтрШаблон, а литерал «.os» в команде — признак самодельного подъёма хаба.
		// Правило действует во ВСЁМ tests/, а не только в каталоге фикстур: тот же слой
		// косвенности, поднятый уровнем выше, обходил каталожный запрет.
		Если СтрНайти(Физическая, "СоздатьПроцесс") > 0 И ЕстьЛитералСценария(Физическая) Тогда
			Результат.Добавить(СтрШаблон(
				"строка %1: путь к запускаемому сценарию зашит литералом — хаб поднимает только ЭкземплярХаба",
				НомерФизической));
		КонецЕсли;

	КонецЦикла;

	ПортовыеИмена = ПортовыеИдентификаторы(СтрокиКода, Результат);

	Для Каждого Строка_ Из СтрокиКода Цикл

		Имя = ИмяПрисваивания(Строка_.Текст);

		Если НЕ ЗначениеЗаполнено(Имя) ИЛИ ПортовыеИмена.Получить(НРег(Имя)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Источник = ЧастьПослеПрисваивания(Строка_.Текст);

		Если СтрНайти(Источник, "СлучайноеЧисло") > 0 Тогда
			Результат.Добавить(СтрШаблон("строка %1: порт выбирается случайно вместо запроса у ОС", Строка_.Номер));
		КонецЕсли;

		Если ЕстьЧислоПорта(Источник) Тогда
			Результат.Добавить(СтрШаблон("строка %1: фиксированный номер порта (%2)", Строка_.Номер, Имя));
		КонецЕсли;

		Если ЕстьАрифметикаНомера(Источник) Тогда
			Результат.Добавить(СтрШаблон("строка %1: соседний порт арифметикой (%2)", Строка_.Номер, Имя));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Нарушения канона ИМЁН АННОТАЦИЙ.
//
// Зачем отдельное правило. Аннотация с опечаткой в ИМЕНИ игнорируется МОЛЧА: «&ПослеКаждым»
// вместо «&ПослеКаждого» прожил в проекте с шага 1.D, хук уборки не вызывался ни разу, и
// на машине скопились тысячи временных каталогов. Опечатка в ПАРАМЕТРЕ аннотации, наоборот,
// роняет прогон с внятной ошибкой — уязвимы именно имена, и от рецидива не защищает ничто,
// кроме этой проверки.
//
// Канон получен из самого OneUnit:
//   grep -rhoE '^&Аннотация\("[^"]+' <lib>/oneunit/src
// и из остальных подключённых библиотек тем же способом по их src. Канон нужен целиком:
// правило бьёт по всем файлам tests/, а фикстуры законно пользуются аннотациями ОСени
// (&Деталька в многострочной сигнатуре конструктора — доминирующий стиль проекта) и
// entity (&Сущность, &Колонка и прочие в заглушках сущностей — пять имён в одном файле).
// Появилась новая библиотека или аннотация — её место в этом списке, и это осознанная
// однострочная правка, а не молчаливый пропуск.
//
// Параметры:
//   Текст - Строка - исходный текст .os-файла.
//
// Возвращаемое значение:
//   Массив из Строка - описания нарушений.
//
Функция НарушенияАннотаций(Знач Текст)

	Результат = Новый Массив();
	Канон = КанонАннотаций();
	НомерСтроки = 0;

	Для Каждого Строка_ Из СтрРазделить(БезКомментариев(Текст), Символы.ПС, Истина) Цикл

		НомерСтроки = НомерСтроки + 1;
		Обрезанная = СокрЛП(Строка_);

		Если НЕ СтрНачинаетсяС(Обрезанная, "&") Тогда
			Продолжить;
		КонецЕсли;

		Имя = "";
		Для Индекс = 2 По СтрДлина(Обрезанная) Цикл
			Символ = Сред(Обрезанная, Индекс, 1);
			Если НЕ ЭтоБукваИлиЦифра(Символ) Тогда
				Прервать;
			КонецЕсли;
			Имя = Имя + Символ;
		КонецЦикла;

		Если НЕ ЗначениеЗаполнено(Имя) Тогда
			Продолжить;
		КонецЕсли;

		Если Канон.Получить(НРег(Имя)) = Неопределено Тогда
			Результат.Добавить(СтрШаблон(
				"строка %1: аннотация &%2 не известна ни одной из подключённых библиотек —"
				+ " незнакомое имя игнорируется молча", НомерСтроки, Имя));
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Канон имён аннотаций: OneUnit (38) + ОСень (18) + entity/winow/autumn-data/opentelemetry (8).
// Все три списка добыты одним и тем же грепом по исходникам библиотек.
Функция КанонАннотаций()

	Имена = "ВключенДляOneScript,ВключенЕсли,ВключенНаОС,Выключен,ВыключенДляOneScript,ВыключенЕсли,"
		+ "ВыключенНаОС,Изолированный,ИсточникJSON,ИсточникВыражение,ИсточникЗначение,ИсточникНеопределено,"
		+ "ИсточникПеречисление,ОпцияИскатьВПодкаталогах,ОпцияКаталогиТестов,ОпцияРежимВывода,"
		+ "ОпцияТегиВключаемые,ОпцияТегиИсключаемые,ОпцияТестовыеМетодыВключаемые,"
		+ "ОпцияТестовыеМетодыИсключаемые,ОпцияТестовыеНаборыВключаемые,ОпцияТестовыеНаборыИсключаемые,"
		+ "ОпцияФайлыТестов,ОтображаемоеИмя,ПараметризованныйТест,ПередВсеми,ПередКаждым,ПовторяемыйТест,"
		+ "ПослеВсех,ПослеКаждого,Таймаут,Тег,Тест,ТестШаблон,Тестируемый,ТестовыйНабор,ФабрикаТестов,"
		+ "Фильтр,"
		// ОСень: grep -rhoE '^&Аннотация\("[^"]+' <lib>/autumn/src
		+ "Блестяшка,Верховный,Деталька,Дуб,Желудь,Завязь,Заготовка,Напильник,ОсобоеОбращение,"
		+ "Пластилин,Порядок,Приемка,Прозвище,Рогатка,Спецификация,Табакерка,ФинальныйШтрих,Характер,"
		// entity / winow / autumn-data / opentelemetry: grep '^&Аннотация' по их src.
		// Без них фикстура-заглушка сущности даёт пять ложных краснот разом.
		+ "ГенерируемоеЗначение,Идентификатор,Колонка,Контроллер,ЛогВебСервера,МетодЗапроса,"
		+ "ПодчиненнаяТаблица,Сущность,ТочкаМаршрута,ХранилищеСущностей";

	Канон = Новый Соответствие();
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Канон.Вставить(НРег(СокрЛП(Имя)), Истина);
	КонецЦикла;

	Возврат Канон;

КонецФункции

// Набор, работающий с autumn-data, ОБЯЗАН подключить entity.
//
// Иначе заготовка autumn-data не сможет разрешить имя коннектора из
// autumn-properties.json и уронит контейнер раннера до первого теста (см. самотест
// ДетекторЛовитНаборСAutumnDataБезКоннекторов).
//
// Параметры:
//   Текст - Строка - исходный текст набора.
//
// Возвращаемое значение:
//   Массив из Строка - описания нарушений.
//
Функция НарушенияПодключенияКоннекторов(Знач Текст)

	Результат = Новый Массив();
	ТолькоКод = БезКомментариев(Текст);

	Если СтрНайти(ТолькоКод, "#Использовать autumn-data") = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Если СтрНайти(ТолькоКод, "#Использовать entity") = 0 Тогда
		Результат.Добавить(
			"набор работает с autumn-data, но не подключает entity"
			+ " (#Использовать entity) — тип коннектора из autumn-properties.json"
			+ " не зарегистрирован, контейнер упадёт «Type is not registered»"
			+ " до первого теста");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Закрытый список фикстур, которым позволено поднимать процесс и ходить по HTTP.
// Каждая из них берёт порт у ВыдачаПортов и гасит процесс за собой; всё остальное
// обязано ходить через них — слой косвенности над ними был бы лазейкой.
//
// Возвращаемое значение:
//   Массив из Строка - имена файлов фикстур.
//
Функция ФикстурыЗапускальщики() Экспорт

	Результат = Новый Массив();
	Результат.Добавить("ЭкземплярХаба.os");          // подопытный хаб
	Результат.Добавить("ЭкземплярФейковогоIdP.os");  // внешний провайдер входа
	Возврат Результат;

КонецФункции

// Запрет для фикстур: поднимать процессы и ходить по HTTP вправе только фикстуры
// из ФикстурыЗапускальщики. Слой косвенности между набором и фикстурой — тоже нарушение.
//
// Параметры:
//   Текст - Строка - исходный текст фикстуры (кроме ЭкземплярХаба.os).
//
// Возвращаемое значение:
//   Массив из Строка - описания нарушений.
//
Функция НарушенияФикстуры(Знач Текст)

	Результат = Новый Массив();
	ТолькоКод = БезКомментариевИЛитералов(Текст);

	Если ЕстьЗапускПроцессаВКоде(ТолькоКод) Тогда
		Результат.Добавить("фикстура запускает процесс — это делают только фикстуры-запускальщики");
	КонецЕсли;

	Если СтрНайти(ТолькоКод, "HTTPСоединение") > 0 Тогда
		Результат.Добавить("фикстура сама строит HTTP-соединение — это дело фикстур-запускальщиков");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Логические строки: физические склеиваются, пока открыты скобки. Номер — первой
// физической строки конструкции, чтобы сообщение указывало на её начало.
//
// Параметры:
//   Текст - Строка - текст модуля (со срезанными комментариями).
//
// Возвращаемое значение:
//   Массив из Структура - Номер (Число), Текст (Строка).
//
Функция ЛогическиеСтроки(Знач Текст)

	Результат = Новый Массив();
	Буфер = "";
	НомерНачала = 0;
	Глубина = 0;
	НомерСтроки = 0;

	Для Каждого Физическая Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл

		НомерСтроки = НомерСтроки + 1;

		Если Буфер = "" Тогда
			НомерНачала = НомерСтроки;
			Буфер = Физическая;
		Иначе
			Буфер = Буфер + " " + СокрЛ(Физическая);
		КонецЕсли;

		Глубина = Глубина + ПриростГлубины(Физическая);

		Если Глубина <= 0 Тогда
			Результат.Добавить(Новый Структура("Номер,Текст", НомерНачала, Буфер));
			Буфер = "";
			Глубина = 0;
		КонецЕсли;

	КонецЦикла;

	Если Буфер <> "" Тогда
		Результат.Добавить(Новый Структура("Номер,Текст", НомерНачала, Буфер));
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Изменение скобочной глубины строкой. Скобки внутри строковых литералов не считаются:
// иначе «"<h1>403</h1><p class=("» уводила бы склейку до конца файла.
Функция ПриростГлубины(Знач Строка_)

	Прирост = 0;
	ВЛитерале = Ложь;

	Для Индекс = 1 По СтрДлина(Строка_) Цикл

		Символ = Сред(Строка_, Индекс, 1);

		Если Символ = """" Тогда
			ВЛитерале = НЕ ВЛитерале;
			Продолжить;
		КонецЕсли;

		Если ВЛитерале Тогда
			Продолжить;
		КонецЕсли;

		Если Символ = "(" Тогда
			Прирост = Прирост + 1;
		ИначеЕсли Символ = ")" Тогда
			Прирост = Прирост - 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Прирост;

КонецФункции

// Имена, играющие роль номера порта: аргумент-порт в HTTPСоединение()/TCPСервер(),
// любой идентификатор со словом «порт» и — на шаг назад — имя, из которого портовое
// имя присвоено напрямую. Числовой литерал прямо в позиции порта — нарушение само по себе.
Функция ПортовыеИдентификаторы(Знач СтрокиКода, Нарушения)

	Имена = Новый Соответствие();

	Приёмники = Новый Соответствие();
	Приёмники.Вставить("HTTPСоединение", 1); // второй аргумент — порт
	Приёмники.Вставить("TCPСервер", 0);      // первый аргумент — порт

	Для Каждого Строка_ Из СтрокиКода Цикл

		Для Каждого Слово Из Идентификаторы(Строка_.Текст) Цикл
			Если ЭтоПортовоеИмя(Слово) Тогда
				Имена.Вставить(НРег(Слово), Слово);
			КонецЕсли;
		КонецЦикла;

		Для Каждого Приёмник Из Приёмники Цикл

			Аргумент = АргументВызова(Строка_.Текст, Приёмник.Ключ, Приёмник.Значение);
			Если Аргумент = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Если ЭтоЦелоеЧисло(Аргумент) Тогда
				Если Число(Аргумент) >= 1024 Тогда
					Нарушения.Добавить(СтрШаблон(
						"строка %1: фиксированный номер порта прямо в вызове (%2)", Строка_.Номер, Аргумент));
				КонецЕсли;
			ИначеЕсли ЭтоИдентификатор(Аргумент) Тогда
				Имена.Вставить(НРег(Аргумент), Аргумент);
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Возврат ДополнитьПровенансом(Имена, СтрокиКода);

КонецФункции

// Провенанс на шаг назад: если портовое имя присвоено из ДРУГОГО имени, то и оно
// портовое. Без этого литерал отмывается одной лишней переменной. Итерируем до
// стабилизации (цепочка присваиваний), но с потолком — линт не должен зависать.
Функция ДополнитьПровенансом(Знач Имена, Знач СтрокиКода)

	Для Шаг = 1 По 5 Цикл

		Добавлено = Ложь;

		Для Каждого Строка_ Из СтрокиКода Цикл

			Имя = ИмяПрисваивания(Строка_.Текст);
			Если НЕ ЗначениеЗаполнено(Имя) ИЛИ Имена.Получить(НРег(Имя)) = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Источник = СокрЛП(ЧастьПослеПрисваивания(Строка_.Текст));
			Если Прав(Источник, 1) = ";" Тогда
				Источник = СокрЛП(Лев(Источник, СтрДлина(Источник) - 1));
			КонецЕсли;

			Если ЭтоИдентификатор(Источник) И Имена.Получить(НРег(Источник)) = Неопределено Тогда
				Имена.Вставить(НРег(Источник), Источник);
				Добавлено = Истина;
			КонецЕсли;

		КонецЦикла;

		Если НЕ Добавлено Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Имена;

КонецФункции

// Идентификатор ИМЕНУЕТ порт, а не просто содержит эти буквы.
//
// Граница слова здесь — camelCase: «Порт» с заглавной П (Порт, ПортДва, НомерПорта),
// тогда как «транспорт» и «экспорт» несут «порт» строчными буквами. Без этой границы
// одна строка вида «ТранспортТаймаут = 10000» в тестах телеметрии красила бы чужой
// набор — мина, которую нашло ревью: ТранспортOTLPХаба, ФейкТранспортHTTP, ТранспортJWKSХаба,
// ЭкспортИдётЧерез уже живут в tests/ и спасаются только тем, что им пока не присваивают
// больших чисел.
Функция ЭтоПортовоеИмя(Знач Слово)

	// СтрНайти регистрозависим — именно это и отделяет «Порт» от «транспорт»
	Если СтрНайти(Слово, "Порт") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат НРег(Слово) = "порт";

КонецФункции

// Аргумент вызова по номеру (0-based) или Неопределено, если вызова в строке нет.
// Имя приёмника задаётся БЕЗ скобки: «Новый HTTPСоединение (…)» с пробелом перед
// скобкой — законный синтаксис, и маркер с приклеенной скобкой его не находил.
Функция АргументВызова(Знач Строка_, Знач Приёмник, Знач НомерАргумента)

	Позиция = СтрНайти(Строка_, Приёмник);
	Если Позиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Индекс = Позиция + СтрДлина(Приёмник);
	Пока Индекс <= СтрДлина(Строка_) И Сред(Строка_, Индекс, 1) = " " Цикл
		Индекс = Индекс + 1;
	КонецЦикла;

	Если Индекс > СтрДлина(Строка_) ИЛИ Сред(Строка_, Индекс, 1) <> "(" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Хвост = Сред(Строка_, Индекс + 1);
	Глубина = 0;
	Текущий = "";
	Аргументы = Новый Массив();

	Для Смещение = 1 По СтрДлина(Хвост) Цикл

		Символ = Сред(Хвост, Смещение, 1);

		Если Символ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = ")" Тогда
			Если Глубина = 0 Тогда
				Прервать;
			КонецЕсли;
			Глубина = Глубина - 1;
		ИначеЕсли Символ = "," И Глубина = 0 Тогда
			Аргументы.Добавить(СокрЛП(Текущий));
			Текущий = "";
			Продолжить;
		КонецЕсли;

		Текущий = Текущий + Символ;

	КонецЦикла;

	Аргументы.Добавить(СокрЛП(Текущий));

	Если НомерАргумента >= Аргументы.Количество() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Аргументы[НомерАргумента];

КонецФункции

// Запускает ли КОД процесс. Единственный запускающий вызов платформы — СоздатьПроцесс,
// и регистр в OneScript незначим: «создатьПроцесс» запускает хаб ровно так же.
// «ЗапуститьПриложение» под правило не подпадает: в tests/ это всегда метод Поделки
// (сборка контейнера ОСени), а не платформенный глобальный запуск.
// Текст обязан приходить уже без комментариев и литералов: упоминание в строке —
// это данные (образец линта, ключ списка исключений), а не запуск.
Функция ЕстьЗапускПроцессаВКоде(Знач ТолькоКод)

	Возврат СтрНайти(НРег(ТолькоКод), "создатьпроцесс") > 0;

КонецФункции

// Строковый литерал с именем .os-сценария в строке (правило о самодельном запуске).
Функция ЕстьЛитералСценария(Знач Строка_)

	ВЛитерале = Ложь;
	Литерал = "";

	Для Индекс = 1 По СтрДлина(Строка_) Цикл

		Символ = Сред(Строка_, Индекс, 1);

		Если Символ = """" Тогда
			Если ВЛитерале Тогда
				Если СтрНайти(НРег(Литерал), ".os") > 0 Тогда
					Возврат Истина;
				КонецЕсли;
				Литерал = "";
			КонецЕсли;
			ВЛитерале = НЕ ВЛитерале;
			Продолжить;
		КонецЕсли;

		Если ВЛитерале Тогда
			Литерал = Литерал + Символ;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Имя слева от присваивания, если слева стоит простой идентификатор. Сравнения
// (<=, >=, <>) и выражения с точками/скобками присваиванием не считаются.
Функция ИмяПрисваивания(Знач Строка_)

	Позиция = СтрНайти(Строка_, "=");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Предыдущий = ?(Позиция > 1, Сред(Строка_, Позиция - 1, 1), "");
	Если Предыдущий = "<" ИЛИ Предыдущий = ">" ИЛИ Предыдущий = "=" Тогда
		Возврат "";
	КонецЕсли;

	Слева = СокрЛП(Лев(Строка_, Позиция - 1));
	Возврат ?(ЭтоИдентификатор(Слева), Слева, "");

КонецФункции

Функция ЧастьПослеПрисваивания(Знач Строка_)

	Позиция = СтрНайти(Строка_, "=");
	Возврат ?(Позиция = 0, "", Сред(Строка_, Позиция + 1));

КонецФункции

// Числовой литерал «портового» размера в выражении. Коды ответов, таймауты и индексы
// (все меньше 1024) ложной красноты не дают.
Функция ЕстьЧислоПорта(Знач Выражение)

	Для Каждого Число_ Из ЧисловыеЛитералы(Выражение) Цикл
		Если Число_ >= 1024 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Сложение/вычитание в выражении: «сосед по номеру» занят ровно с той же вероятностью,
// что и любой другой порт. Слагаемым может быть и ЧИСЛО («Порт + 1»), и ПЕРЕМЕННАЯ
// («Хаб.Порт() + Смещение») — на второй форме предыдущая версия промахивалась.
Функция ЕстьАрифметикаНомера(Знач Выражение)

	Индекс = 1;

	Пока Индекс <= СтрДлина(Выражение) Цикл

		Символ = Сред(Выражение, Индекс, 1);

		Если Символ = "+" ИЛИ Символ = "-" Тогда

			Хвост = Индекс + 1;
			Пока Хвост <= СтрДлина(Выражение) И Сред(Выражение, Хвост, 1) = " " Цикл
				Хвост = Хвост + 1;
			КонецЦикла;

			Если Хвост <= СтрДлина(Выражение) И ЭтоБукваИлиЦифра(Сред(Выражение, Хвост, 1)) Тогда
				Возврат Истина;
			КонецЕсли;

		КонецЕсли;

		Индекс = Индекс + 1;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Идентификаторы строки (буквы, цифры и подчёркивания; не начинаются с цифры).
Функция Идентификаторы(Знач Строка_)

	Результат = Новый Массив();
	Текущий = "";

	Для Индекс = 1 По СтрДлина(Строка_) Цикл

		Символ = Сред(Строка_, Индекс, 1);

		Если ЭтоБукваИлиЦифра(Символ) Тогда
			Текущий = Текущий + Символ;
		Иначе
			Если ЭтоИдентификатор(Текущий) Тогда
				Результат.Добавить(Текущий);
			КонецЕсли;
			Текущий = "";
		КонецЕсли;

	КонецЦикла;

	Если ЭтоИдентификатор(Текущий) Тогда
		Результат.Добавить(Текущий);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ЭтоИдентификатор(Знач Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ЭтоЦифра(Лев(Значение, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если НЕ ЭтоБукваИлиЦифра(Сред(Значение, Индекс, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЭтоЦелоеЧисло(Знач Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если НЕ ЭтоЦифра(Сред(Значение, Индекс, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЕстьНарушение(Знач Нарушения, Знач Фрагмент)

	Для Каждого Нарушение Из Нарушения Цикл
		Если СтрНайти(НРег(Нарушение), НРег(Фрагмент)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЧисловыеЛитералы(Знач Строка_)

	Результат = Новый Массив();
	Цифры = "";
	ПредыдущийБуква = Ложь;

	Для Индекс = 1 По СтрДлина(Строка_) Цикл

		Символ = Сред(Строка_, Индекс, 1);

		Если ЭтоЦифра(Символ) Тогда
			Цифры = Цифры + Символ;
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(Цифры) Тогда
			Если НЕ ПредыдущийБуква Тогда
				Результат.Добавить(Число(Цифры));
			КонецЕсли;
			Цифры = "";
		КонецЕсли;

		ПредыдущийБуква = ЭтоБукваИлиЦифра(Символ);

	КонецЦикла;

	Если ЗначениеЗаполнено(Цифры) И НЕ ПредыдущийБуква Тогда
		Результат.Добавить(Число(Цифры));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ЭтоЦифра(Знач Символ)
	Возврат Символ >= "0" И Символ <= "9";
КонецФункции

Функция ЭтоБукваИлиЦифра(Знач Символ)

	Если ЭтоЦифра(Символ) Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Символ = "_" ИЛИ НРег(Символ) <> ВРег(Символ);

КонецФункции

// Вырезает ТОЛЬКО комментарии (литералы остаются): в них живут пути к main.os.
Функция БезКомментариев(Знач Текст)

	Результат = Новый Массив();

	Для Каждого Строка_ Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл

		Очищенная = "";
		ВСтроке = Ложь;
		Позиция = 1;

		Пока Позиция <= СтрДлина(Строка_) Цикл

			Символ = Сред(Строка_, Позиция, 1);

			Если ВСтроке Тогда
				Если Символ = """" И Сред(Строка_, Позиция + 1, 1) = """" Тогда
					Очищенная = Очищенная + """""";
					Позиция = Позиция + 2;
					Продолжить;
				КонецЕсли;
				Если Символ = """" Тогда
					ВСтроке = Ложь;
				КонецЕсли;
			ИначеЕсли Символ = """" Тогда
				ВСтроке = Истина;
			ИначеЕсли Символ = "/" И Сред(Строка_, Позиция + 1, 1) = "/" Тогда
				Прервать;
			КонецЕсли;

			Очищенная = Очищенная + Символ;
			Позиция = Позиция + 1;

		КонецЦикла;

		Результат.Добавить(Очищенная);

	КонецЦикла;

	Возврат СтрСоединить(Результат, Символы.ПС);

КонецФункции

// Вырезает комментарии и строковые литералы: без этого сканер даёт и ложную
// красноту (пример в комментарии), и ложную зелень (нарушение, спрятанное в строку).
Функция БезКомментариевИЛитералов(Знач Текст)

	Результат = Новый Массив();
	ВСтроке = Ложь; // состояние ПЕРЕЖИВАЕТ перевод строки: литерал бывает многострочным

	Для Каждого Строка_ Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл

		Очищенная = "";
		Позиция = 1;

		Пока Позиция <= СтрДлина(Строка_) Цикл

			Символ = Сред(Строка_, Позиция, 1);

			Если ВСтроке Тогда
				Если Символ = """" Тогда
					Если Сред(Строка_, Позиция + 1, 1) = """" Тогда
						Позиция = Позиция + 2; // удвоенная кавычка внутри литерала
						Продолжить;
					КонецЕсли;
					ВСтроке = Ложь;
				КонецЕсли;
			ИначеЕсли Символ = """" Тогда
				ВСтроке = Истина;
			ИначеЕсли Символ = "/" И Сред(Строка_, Позиция + 1, 1) = "/" Тогда
				Прервать; // дальше комментарий до конца строки
			Иначе
				Очищенная = Очищенная + Символ;
			КонецЕсли;

			Позиция = Позиция + 1;

		КонецЦикла;

		Результат.Добавить(Очищенная);

	КонецЦикла;

	Возврат СтрСоединить(Результат, Символы.ПС);

КонецФункции


// Все исходники проекта: src + tools + tests (рекурсивно).
Функция ИсходникиПроекта()

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;

	Результат = Новый Массив();
	Для Каждого Корень Из СтрРазделить("src,tools,tests", ",") Цикл
		Каталог = ОбъединитьПути(КаталогПроекта, Корень);
		Если НЕ Новый Файл(Каталог).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Найденный Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
			Если НЕ Найденный.ЭтоКаталог() Тогда
				Результат.Добавить(Найденный);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Имя метода, ОБЪЯВЛЯЕМОГО этой строкой ("" — строка не объявление).
Функция ИмяОбъявляемогоМетода(Знач Строка_)

	Текст = СокрЛП(Строка_);
	Ключевое = "";
	Если СтрНачинаетсяС(Текст, "Функция ") Тогда
		Ключевое = "Функция ";
	ИначеЕсли СтрНачинаетсяС(Текст, "Процедура ") Тогда
		Ключевое = "Процедура ";
	Иначе
		Возврат "";
	КонецЕсли;

	Хвост = СокрЛП(Сред(Текст, СтрДлина(Ключевое) + 1));
	Скобка = СтрНайти(Хвост, "(");
	Если Скобка < 2 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Лев(Хвост, Скобка - 1));

КонецФункции

// Повторно объявленные имена в тексте (для самотеста линта).
Функция ПовторыВТексте(Знач Текст)

	Имена = Новый Соответствие();
	Повторы = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(БезКомментариев(Текст), Символы.ПС, Истина) Цикл
		Имя = ИмяОбъявляемогоМетода(Строка_);
		Если НЕ ЗначениеЗаполнено(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Если Имена.Получить(НРег(Имя)) = Истина Тогда
			Повторы.Добавить(Имя);
		КонецЕсли;
		Имена.Вставить(НРег(Имя), Истина);
	КонецЦикла;
	Возврат Повторы;

КонецФункции

// Имена тестов, у которых НЕТ безусловной отключающей аннотации.
//
// Разбор построчный и намеренно простой: между `&Тест` и объявлением процедуры стоят
// только аннотации, и там ищется одна из двух безусловных форм. Комментарии вырезаются
// (иначе закомментированный пропуск считался бы пропуском), литералы сохраняются
// (иначе не увидеть `"() -> Ложь"` внутри аннотации).
//
// Параметры:
//   Текст - Строка - исходный текст набора.
//
// Возвращаемое значение:
//   Массив из Строка - имена НЕпропущенных тестов (пустой массив = все пропущены).
//
Функция НепропущенныеТесты(Знач Текст)

	Результат = Новый Массив();
	ЖдёмПропуск = Ложь;
	Пропущен = Ложь;

	Для Каждого Строка_ Из СтрРазделить(БезКомментариев(Текст), Символы.ПС, Истина) Цикл

		Обрезанная = СокрЛП(Строка_);

		Если ЭтоАннотацияТеста(Обрезанная) Тогда
			ЖдёмПропуск = Истина;
			Пропущен = Ложь;
			Продолжить;
		КонецЕсли;

		Если НЕ ЖдёмПропуск Тогда
			Продолжить;
		КонецЕсли;

		Если ЭтоБезусловныйПропуск(Обрезанная) Тогда
			Пропущен = Истина;
		КонецЕсли;

		ИмяМетода = ИмяОбъявляемогоМетода(Обрезанная);
		Если НЕ ЗначениеЗаполнено(ИмяМетода) Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ Пропущен Тогда
			Результат.Добавить(ИмяМетода);
		КонецЕсли;
		ЖдёмПропуск = Ложь;
		Пропущен = Ложь;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сколько всего тестов объявлено в тексте (защита сторожа от вечнозелёности).
Функция ВсегоТестовВТексте(Знач Текст)

	Всего = 0;
	Для Каждого Строка_ Из СтрРазделить(БезКомментариев(Текст), Символы.ПС, Истина) Цикл
		Если ЭтоАннотацияТеста(СокрЛП(Строка_)) Тогда
			Всего = Всего + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Всего;

КонецФункции

// `&Тест` и только он: `&ТестовыйНабор`, `&ТестШаблон`, `&Тестируемый` — другие аннотации.
Функция ЭтоАннотацияТеста(Знач Обрезанная)

	Если НЕ СтрНачинаетсяС(Обрезанная, "&Тест") Тогда
		Возврат Ложь;
	КонецЕсли;

	Хвост = СокрЛП(Сред(Обрезанная, СтрДлина("&Тест") + 1));
	Возврат Хвост = "" ИЛИ СтрНачинаетсяС(Хвост, "(");

КонецФункции

// Безусловное отключение теста: `&ВключенЕсли("() -> Ложь", …)` либо `&Выключен`.
// Условные формы (`&ВыключенЕсли`, `&ВключенЕсли` с настоящим условием, `&ВыключенНаОС`)
// пропуском НЕ считаются — они зависят от окружения.
Функция ЭтоБезусловныйПропуск(Знач Обрезанная)

	Если СтрНачинаетсяС(Обрезанная, "&ВключенЕсли") Тогда
		БезПробелов = СтрЗаменить(Обрезанная, " ", "");
		Возврат СтрНайти(БезПробелов, """()->Ложь""") > 0;
	КонецЕсли;

	Если СтрНачинаетсяС(Обрезанная, "&Выключен") Тогда
		Хвост = СокрЛП(Сред(Обрезанная, СтрДлина("&Выключен") + 1));
		Возврат Хвост = "" ИЛИ СтрНачинаетсяС(Хвост, "(");
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ПрочитатьФайл(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат ?(Содержимое = Неопределено, "", Содержимое);

КонецФункции

#КонецОбласти
