// Юнит-тесты ПланировщикаПриложения на ручных часах: расписание, изоляция ошибки задачи,
// грациозная остановка, политика перекрытия, реальные обработчики задач.

#Использовать asserts
#Использовать autumn-logos
#Использовать os-scheduler

Перем КаталогМодулей_;
Перем КаталогФикстур_;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей_ = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогФикстур_ = ОбъединитьПути(КаталогТестов, "фикстуры");
КонецПроцедуры

&ПередВсеми
Процедура ЗарегистрироватьТипы() Экспорт
	Подключить(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ПланировщикПриложения.os"), "ПланировщикПриложения");
	Подключить(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ЖурналФоновыхЗадач.os"), "ЖурналФоновыхЗадач");
	Подключить(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ЗадачаПодЖурналом.os"), "ЗадачаПодЖурналом");
	Подключить(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ЗадачаСбросаСтатистики.os"), "ЗадачаСбросаСтатистики");
	Подключить(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ЗадачаСбораКэшаПрокси.os"), "ЗадачаСбораКэшаПрокси");
	Подключить(ОбъединитьПути(КаталогФикстур_, "ОбработчикСчётчик.os"), "ОбработчикСчётчик");
	Подключить(ОбъединитьПути(КаталогФикстур_, "ОбработчикПадающий.os"), "ОбработчикПадающий");
	Подключить(ОбъединитьПути(КаталогФикстур_, "ЧасыРучные.os"), "ЧасыРучные");
	Подключить(ОбъединитьПути(КаталогФикстур_, "ВыполнениеРучное.os"), "ВыполнениеРучное");
	Подключить(ОбъединитьПути(КаталогФикстур_, "ИсполнительРучной.os"), "ИсполнительРучной");
	Подключить(ОбъединитьПути(КаталогФикстур_, "СтатистикаЗаглушка.os"), "СтатистикаЗаглушка");
	Подключить(ОбъединитьПути(КаталогФикстур_, "СборщикЗаглушка.os"), "СборщикЗаглушка");
КонецПроцедуры

&Тест
Процедура ЗадачиРегистрируютсяИСрабатываютПоРасписанию() Экспорт

	Стат = Новый ОбработчикСчётчик();
	GC = Новый ОбработчикСчётчик();
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));

	Пл = НовыйПланировщик(Стат, GC, 60, 120, Часы);
	Пл.Настроить();
	Планировщик = Пл.ЭкземплярПланировщика();

	Ожидаем.Что(Планировщик.Состояния().Количество(), "зарегистрированы семь задач").Равно(7);
	Ожидаем.Что(Планировщик.Запущен(), "планировщик запущен").ЭтоИстина();

	Часы.Прибавить(60);
	Планировщик.Тик();
	Ожидаем.Что(Стат.Вызовов(), "сброс-статистики (интервал 60) сработал").Равно(1);
	Ожидаем.Что(GC.Вызовов(), "gc (интервал 120) ещё не наступил").Равно(0);

	Часы.Прибавить(60); // t0+120
	Планировщик.Тик();
	Ожидаем.Что(GC.Вызовов(), "gc (интервал 120) сработал").Равно(1);
	Ожидаем.Что(Стат.Вызовов(), "сброс-статистики сработал повторно").Равно(2);

КонецПроцедуры

&Тест
Процедура СбойОднойЗадачиНеРоняетПрочиеИПланировщик() Экспорт

	Стат = Новый ОбработчикСчётчик();
	GC = Новый ОбработчикПадающий(); // роняет каждый запуск
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));

	Пл = НовыйПланировщик(Стат, GC, 60, 60, Часы);
	Пл.Настроить();
	Планировщик = Пл.ЭкземплярПланировщика();

	Часы.Прибавить(60);
	Планировщик.Тик();

	Ожидаем.Что(GC.Вызовов(), "падающая задача была вызвана").Равно(1);
	Ожидаем.Что(Планировщик.Состояние("gc-кэша-прокси").статус, "её статус — ошибка").Равно("ошибка");
	Ожидаем.Что(Стат.Вызовов(), "соседняя задача отработала несмотря на сбой gc").Равно(1);
	Ожидаем.Что(Планировщик.Запущен(), "планировщик продолжает работу").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ГрациознаяОстановкаSyncПрекращаетДиспетчеризацию() Экспорт

	Стат = Новый ОбработчикСчётчик();
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));

	Пл = НовыйПланировщик(Стат, Новый ОбработчикСчётчик(), 60, 120, Часы);
	Пл.Настроить();
	Планировщик = Пл.ЭкземплярПланировщика();

	Активных = Пл.Остановить();
	Ожидаем.Что(Активных, "синхронный исполнитель не оставляет активных").Равно(0);
	Ожидаем.Что(Планировщик.Запущен(), "после остановки не запущен").ЭтоЛожь();

	Часы.Прибавить(600);
	Планировщик.Тик();
	Ожидаем.Что(Стат.Вызовов(), "после остановки новые задачи не диспетчеризуются").Равно(0);

КонецПроцедуры

&Тест
Процедура ГрациознаяОстановкаДорабатываетИдущиеAsync() Экспорт

	Стат = Новый ОбработчикСчётчик();
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));
	Ручной = Новый ИсполнительРучной();

	Пл = НовыйПланировщик(Стат, Новый ОбработчикСчётчик(), 60, 120, Часы);
	Пл.УстановитьИсполнитель(Ручной);
	Пл.Настроить();
	Планировщик = Пл.ЭкземплярПланировщика();

	Часы.Прибавить(60);
	Планировщик.Тик(); // задача стартовала, но не завершилась (async)
	Ожидаем.Что(Планировщик.Активных() >= 1, "есть идущее выполнение").ЭтоИстина();

	Активных = Пл.Остановить();
	Ожидаем.Что(Активных >= 1, "грациозная остановка отдаёт число идущих").ЭтоИстина();

	Ручной.ЗавершитьВсеУспехом();
	Планировщик.Тик(); // финализируем завершившиеся
	Ожидаем.Что(Планировщик.Активных(), "после доработки идущих активных не осталось").Равно(0);

КонецПроцедуры

&Тест
Процедура ПерекрытиеПропуститьНеЗапускаетПовторноПокаЗадачаИдёт() Экспорт

	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));
	Ручной = Новый ИсполнительРучной();
	Счётчик = Новый ОбработчикСчётчик();

	Планировщик = Новый Планировщик(Новый Структура("Исполнитель, Часы", Ручной, Часы));
	Планировщик.Зарегистрировать("j", Расписания.Интервал(60), Счётчик,
		Новый Структура("ПолитикаПерекрытия", "пропустить"));
	Планировщик.Запустить();

	Часы.Прибавить(60);
	Планировщик.Тик(); // старт (async, идёт)
	Ожидаем.Что(Ручной.ВызововЗапуска(), "первый запуск").Равно(1);

	Часы.Прибавить(60);
	Планировщик.Тик(); // предыдущий ещё идёт -> пропустить
	Ожидаем.Что(Ручной.ВызововЗапуска(), "перекрытие пропущено, повторного запуска нет").Равно(1);

	Ручной.ЗавершитьВсеУспехом();
	Часы.Прибавить(60);
	Планировщик.Тик(); // теперь свободен и настал момент -> запуск
	Ожидаем.Что(Ручной.ВызововЗапуска(), "после освобождения задача снова запущена").Равно(2);

КонецПроцедуры

&Тест
Процедура ОбработчикиСтатистикиИGCВызываютСервисыПоРасписанию() Экспорт

	МокСтат = Новый СтатистикаЗаглушка();
	МокСборщик = Новый СборщикЗаглушка();

	ЗадачаСтат = Новый ЗадачаСбросаСтатистики(МокСтат);
	ЗадачаGC = Новый ЗадачаСбораКэшаПрокси(МокСборщик);
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));

	Пл = НовыйПланировщик(ЗадачаСтат, ЗадачаGC, 60, 120, Часы);
	Пл.Настроить();
	Планировщик = Пл.ЭкземплярПланировщика();

	Часы.Прибавить(120);
	Планировщик.Тик();

	Ожидаем.Что(МокСтат.СбросовВызвано() >= 1, "планировщик реально вызвал сброс статистики").ЭтоИстина();
	Ожидаем.Что(МокСборщик.ПроходовВызвано() >= 1, "планировщик реально вызвал GC кэша прокси").ЭтоИстина();

КонецПроцедуры

Функция НовыйПланировщик(Знач ЗадачаСтат, Знач ЗадачаGC,
		Знач ИнтервалСтат, Знач ИнтервалGC, Знач Часы)
	Пл = Новый ПланировщикПриложения(ЗадачаСтат, ЗадачаGC, Новый ОбработчикСчётчик(),
		Новый ОбработчикСчётчик(), Новый ОбработчикСчётчик(), Новый ОбработчикСчётчик(),
		Новый ОбработчикСчётчик(),
		ИнтервалСтат, ИнтервалGC, 999999, 999999, 999999, 999999, 999999, 10, Истина,
		НоваяГотовность(), Новый ЖурналФоновыхЗадач(ЛогТестов()), ЛогТестов());
	Пл.УстановитьЧасы(Часы);
	Возврат Пл;
КонецФункции

Процедура Подключить(Знач ПолныйПуть, Знач ИмяКласса)
	Если НЕ ТипЗарегистрирован(ИмяКласса) Тогда
		ПодключитьСценарий(ПолныйПуть, ИмяКласса);
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция НоваяГотовность()

	Попытка
		КаталогНабора = Новый Файл(ТекущийСценарий().Источник).Путь;
		ПодключитьСценарий(ОбъединитьПути(Новый Файл(ОбъединитьПути(КаталогНабора, "..")).ПолноеИмя,
			"src/модули/наблюдаемость/Классы/пробы/ГотовностьХаба.os"), "ГотовностьХаба");
	Исключение
	КонецПопытки;

	Возврат Новый ГотовностьХаба(ЛогТестов());

КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.старт");
КонецФункции
