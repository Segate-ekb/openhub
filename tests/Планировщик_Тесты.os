// Юнит-тесты ПланировщикаПриложения на ручных часах: расписание, изоляция ошибки задачи,
// грациозная остановка, политика перекрытия, реальные обработчики задач.

#Использовать asserts
#Использовать autumn-logos
#Использовать os-scheduler
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогМодулей_;
Перем КаталогФикстур_;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей_ = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогФикстур_ = ОбъединитьПути(КаталогТестов, "фикстуры");

КонецПроцедуры

&ПередВсеми
Процедура ЗарегистрироватьТипы() Экспорт
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ФоновыйЦикл.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ПланировщикПриложения.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ЖурналФоновыхЗадач.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ЗадачаПодЖурналом.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ЗадачаПодСпаном.os"));
	ПоискКлассов.ПодключитьОснову(КаталогМодулей_);
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ЗадачаСбросаСтатистики.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ЗадачаСбораКэшаПрокси.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур_, "ОбработчикСчётчик.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур_, "ОбработчикПадающий.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур_, "ЧасыРучные.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур_, "ВыполнениеРучное.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур_, "ИсполнительРучной.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур_, "СтатистикаЗаглушка.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур_, "СборщикЗаглушка.os"));
КонецПроцедуры

&Тест
Процедура ЗадачиРегистрируютсяИСрабатываютПоРасписанию() Экспорт

	Стат = Новый ОбработчикСчётчик();
	GC = Новый ОбработчикСчётчик();
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));

	Пл = НовыйПланировщик(Стат, GC, 60, 120, Часы);
	Пл.Настроить();
	Планировщик = Пл.ЭкземплярПланировщика();

	Ожидаем.Что(Планировщик.Состояния().Количество(), "зарегистрированы восемь задач").Равно(8);
	Ожидаем.Что(Планировщик.Запущен(), "планировщик запущен").ЭтоИстина();

	Часы.Прибавить(60);
	Планировщик.Тик();
	Ожидаем.Что(Стат.Вызовов(), "сброс-статистики (интервал 60) сработал").Равно(1);
	Ожидаем.Что(GC.Вызовов(), "gc (интервал 120) ещё не наступил").Равно(0);

	Часы.Прибавить(60); // t0+120
	Планировщик.Тик();
	Ожидаем.Что(GC.Вызовов(), "gc (интервал 120) сработал").Равно(1);
	Ожидаем.Что(Стат.Вызовов(), "сброс-статистики сработал повторно").Равно(2);

КонецПроцедуры

&Тест
Процедура СбойОднойЗадачиНеРоняетПрочиеИПланировщик() Экспорт

	Стат = Новый ОбработчикСчётчик();
	GC = Новый ОбработчикПадающий(); // роняет каждый запуск
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));

	Пл = НовыйПланировщик(Стат, GC, 60, 60, Часы);
	Пл.Настроить();
	Планировщик = Пл.ЭкземплярПланировщика();

	Часы.Прибавить(60);
	Планировщик.Тик();

	Ожидаем.Что(GC.Вызовов(), "падающая задача была вызвана").Равно(1);
	Ожидаем.Что(Планировщик.Состояние("gc-кэша-прокси").статус, "её статус — ошибка").Равно("ошибка");
	Ожидаем.Что(Стат.Вызовов(), "соседняя задача отработала несмотря на сбой gc").Равно(1);
	Ожидаем.Что(Планировщик.Запущен(), "планировщик продолжает работу").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ГрациознаяОстановкаSyncПрекращаетДиспетчеризацию() Экспорт

	Стат = Новый ОбработчикСчётчик();
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));

	Пл = НовыйПланировщик(Стат, Новый ОбработчикСчётчик(), 60, 120, Часы);
	Пл.Настроить();
	Планировщик = Пл.ЭкземплярПланировщика();

	Активных = Пл.Остановить();
	Ожидаем.Что(Активных, "синхронный исполнитель не оставляет активных").Равно(0);
	Ожидаем.Что(Планировщик.Запущен(), "после остановки не запущен").ЭтоЛожь();

	Часы.Прибавить(600);
	Планировщик.Тик();
	Ожидаем.Что(Стат.Вызовов(), "после остановки новые задачи не диспетчеризуются").Равно(0);

КонецПроцедуры

&Тест
Процедура ГрациознаяОстановкаДорабатываетИдущиеAsync() Экспорт

	Стат = Новый ОбработчикСчётчик();
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));
	Ручной = Новый ИсполнительРучной();

	Пл = НовыйПланировщик(Стат, Новый ОбработчикСчётчик(), 60, 120, Часы);
	Пл.УстановитьИсполнитель(Ручной);
	Пл.Настроить();
	Планировщик = Пл.ЭкземплярПланировщика();

	Часы.Прибавить(60);
	Планировщик.Тик(); // задача стартовала, но не завершилась (async)
	Ожидаем.Что(Планировщик.Активных() >= 1, "есть идущее выполнение").ЭтоИстина();

	Активных = Пл.Остановить();
	Ожидаем.Что(Активных >= 1, "грациозная остановка отдаёт число идущих").ЭтоИстина();

	Ручной.ЗавершитьВсеУспехом();
	Планировщик.Тик(); // финализируем завершившиеся
	Ожидаем.Что(Планировщик.Активных(), "после доработки идущих активных не осталось").Равно(0);

КонецПроцедуры

&Тест
Процедура ПерекрытиеПропуститьНеЗапускаетПовторноПокаЗадачаИдёт() Экспорт

	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));
	Ручной = Новый ИсполнительРучной();
	Счётчик = Новый ОбработчикСчётчик();

	Планировщик = Новый Планировщик(Новый Структура("Исполнитель, Часы", Ручной, Часы));
	Планировщик.Зарегистрировать("j", Расписания.Интервал(60), Счётчик,
		Новый Структура("ПолитикаПерекрытия", "пропустить"));
	Планировщик.Запустить();

	Часы.Прибавить(60);
	Планировщик.Тик(); // старт (async, идёт)
	Ожидаем.Что(Ручной.ВызововЗапуска(), "первый запуск").Равно(1);

	Часы.Прибавить(60);
	Планировщик.Тик(); // предыдущий ещё идёт -> пропустить
	Ожидаем.Что(Ручной.ВызововЗапуска(), "перекрытие пропущено, повторного запуска нет").Равно(1);

	Ручной.ЗавершитьВсеУспехом();
	Часы.Прибавить(60);
	Планировщик.Тик(); // теперь свободен и настал момент -> запуск
	Ожидаем.Что(Ручной.ВызововЗапуска(), "после освобождения задача снова запущена").Равно(2);

КонецПроцедуры

&Тест
Процедура ОбработчикиСтатистикиИGCВызываютСервисыПоРасписанию() Экспорт

	МокСтат = Новый СтатистикаЗаглушка();
	МокСборщик = Новый СборщикЗаглушка();

	ЗадачаСтат = Новый ЗадачаСбросаСтатистики(МокСтат);
	ЗадачаGC = Новый ЗадачаСбораКэшаПрокси(МокСборщик);
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));

	Пл = НовыйПланировщик(ЗадачаСтат, ЗадачаGC, 60, 120, Часы);
	Пл.Настроить();
	Планировщик = Пл.ЭкземплярПланировщика();

	Часы.Прибавить(120);
	Планировщик.Тик();

	Ожидаем.Что(МокСтат.СбросовВызвано() >= 1, "планировщик реально вызвал сброс статистики").ЭтоИстина();
	Ожидаем.Что(МокСборщик.ПроходовВызвано() >= 1, "планировщик реально вызвал GC кэша прокси").ЭтоИстина();

КонецПроцедуры

// Ноль в настройке часа — это полночь, а не «не задано»: ЗначениеЗаполнено(0) ложно,
// и на общем разборе чисел оператор, поставивший 0, молча получал бы умолчание 3:00.
&Тест
Процедура ЧасПереиндексацииНольЗначитПолночь() Экспорт

	Полночь = Новый ОбработчикСчётчик();
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 23, 0, 0));
	Пл = ПланировщикСЧасомПереиндексации(0, Полночь, Часы);
	Пл.Настроить();

	Часы.Прибавить(3600); // 2026-01-02 00:00
	Пл.ЭкземплярПланировщика().Тик();

	Ожидаем.Что(Полночь.Вызовов(), "час 0 поставил задачу на полночь").Равно(1);

	// КОНТРОЛЬ: с умолчальным часом та же полночь задачу не запускает — иначе тест
	// зеленел бы на «срабатывает при любом расписании»
	Умолчание = Новый ОбработчикСчётчик();
	ЧасыКонтроля = Новый ЧасыРучные(Дата(2026, 1, 1, 23, 0, 0));
	ПлКонтроля = ПланировщикСЧасомПереиндексации(3, Умолчание, ЧасыКонтроля);
	ПлКонтроля.Настроить();

	ЧасыКонтроля.Прибавить(3600);
	ПлКонтроля.ЭкземплярПланировщика().Тик();

	Ожидаем.Что(Умолчание.Вызовов(), "КОНТРОЛЬ: час 3 в полночь не срабатывает").Равно(0);

КонецПроцедуры

// Час вне суток — опечатка оператора, а не повод оставить хаб без ВСЕХ фоновых задач:
// os-scheduler такое расписание не принимает, и исключение унесло бы всю регистрацию.
&Тест
Процедура ЧасПереиндексацииВнеСутокНеРоняетРегистрациюЗадач() Экспорт

	Задача = Новый ОбработчикСчётчик();
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 2, 0, 0));
	Пл = ПланировщикСЧасомПереиндексации(99, Задача, Часы);
	Пл.Настроить();

	Ожидаем.Что(Пл.ЭкземплярПланировщика().Состояния().Количество(),
		"все восемь задач зарегистрированы").Равно(8);

	Часы.Прибавить(3600); // 03:00 — умолчальный час
	Пл.ЭкземплярПланировщика().Тик();
	Ожидаем.Что(Задача.Вызовов(), "и переиндексация встала на умолчальный час").Равно(1);

КонецПроцедуры

Функция ПланировщикСЧасомПереиндексации(Знач ЧасREADME, Знач ЗадачаREADME, Знач Часы)
	Пл = Новый ПланировщикПриложения(Новый ОбработчикСчётчик(), Новый ОбработчикСчётчик(),
		ЗадачаREADME, Новый ОбработчикСчётчик(), Новый ОбработчикСчётчик(),
		Новый ОбработчикСчётчик(), Новый ОбработчикСчётчик(), Новый ОбработчикСчётчик(),
		999999, 999999, ЧасREADME, 999999, 999999, 999999, 999999, 999999, 10, Истина,
		НоваяГотовность(), Новый ЖурналФоновыхЗадач(ЛогТестов()), ЛогТестов());
	Пл.УстановитьЧасы(Часы);
	Возврат Пл;
КонецФункции

Функция НовыйПланировщик(Знач ЗадачаСтат, Знач ЗадачаGC,
		Знач ИнтервалСтат, Знач ИнтервалGC, Знач Часы)
	Пл = Новый ПланировщикПриложения(ЗадачаСтат, ЗадачаGC, Новый ОбработчикСчётчик(),
		Новый ОбработчикСчётчик(), Новый ОбработчикСчётчик(), Новый ОбработчикСчётчик(),
		Новый ОбработчикСчётчик(), Новый ОбработчикСчётчик(),
		ИнтервалСтат, ИнтервалGC, 3, 999999, 999999, 999999, 999999, 999999, 10, Истина,
		НоваяГотовность(), Новый ЖурналФоновыхЗадач(ЛогТестов()), ЛогТестов());
	Пл.УстановитьЧасы(Часы);
	Возврат Пл;
КонецФункции

Функция НоваяГотовность()

	Попытка
		КаталогНабора = Новый Файл(ТекущийСценарий().Источник).Путь;
		ПодключитьСценарий(ОбъединитьПути(Новый Файл(ОбъединитьПути(КаталогНабора, "..")).ПолноеИмя,
			"src/модули/наблюдаемость/Классы/пробы/ГотовностьХаба.os"), "ГотовностьХаба");
	Исключение
	КонецПопытки;

	Возврат Новый ГотовностьХаба(ЛогТестов());

КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.старт");
КонецФункции
