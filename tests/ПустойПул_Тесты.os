// Страница пула без пакетов глазами четверых: админа командного пула, владельца пустого
// личного пространства, постороннего и гостя. Засев кабинета даёт и то и другое — пустой
// командный пул owned с владельцем owner1 и пустые личные пространства учёток.

#Использовать asserts
#Использовать "фикстуры"

Перем Хаб;      // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;   // фикстура КлиентХаба — все запросы к подопытному хабу

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);

	Хаб.ФайловаяБаза("openhub-пустой-пул");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	// фоновую доставку вебхуков и резолв имён гасим: набор смотрит страницу, а не сеть
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Хаб.Среда("OSHUB_WEBHOOKS_RESOLVE__ENABLED", "false");

	Хаб.ЗапуститьСидер(ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры",
		"ЗасеятьКабинет.os"));

	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

// Пустой пул для своего администратора — не тупик: оба пути названы и ведут туда, где
// они продолжаются. Перенос — это заведение зеркала с предвыбранным режимом (параметр
// migrate), а не просто раздел зеркал.
&Тест
Процедура ПустойКомандныйПулПредлагаетАдминуПубликациюИПеренос() Экспорт

	КукаВладельца = Клиент.Войти("owner1", "Owner1Passw0rd");
	Страница = Клиент.Тело(Клиент.GETСКукой("/owned", КукаВладельца));

	Ожидаем.Что(СтрНайти(Страница, "Опубликовать первый пакет") > 0,
		"первый путь назван").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "href=""/tour""") > 0,
		"и ведёт он в тот же проводник первой публикации, что и кабинет").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Страница, "Перенести пакеты из другого хаба") > 0,
		"второй путь назван").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "href=""/owned/settings/mirrors?migrate=1""") > 0,
		"и ведёт он в заведение зеркала с предвыбранным переносом").ЭтоИстина();

	// предложение не декорация: по обоим адресам администратора действительно пускают
	Ожидаем.Что(Клиент.GETСКукой("/owned/settings/mirrors?migrate=1", КукаВладельца).КодСостояния,
		"адрес переноса открыт тому, кому предложен").Равно(200);
	Ожидаем.Что(Клиент.GETСКукой("/tour", КукаВладельца).КодСостояния,
		"и проводник первой публикации тоже").Равно(200);

КонецПроцедуры

// Личному пространству внешние источники недопустимы по типу пула, поэтому переносить
// в него нечем. Контроль рядом: кнопку настроек владелец видит — значит дело в типе пула,
// а не в том, что его приняли за постороннего.
&Тест
Процедура ПустоеЛичноеПространствоПредлагаетТолькоПервуюПубликацию() Экспорт

	Страница = Клиент.Тело(Клиент.GETСКукой("/bob", Клиент.Войти("bob", "BobPassw0rd")));

	Ожидаем.Что(СтрНайти(Страница, "С чего начать") > 0,
		"владельцу пустого пространства путь предложен").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "href=""/tour""") > 0,
		"и это публикация первого пакета").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "href=""/bob/settings""") > 0,
		"КОНТРОЛЬ: администратор пространства тут он же — кнопка его настроек на месте").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Страница, "Перенести пакеты из другого хаба"),
		"переноса личному пространству не предлагают").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "migrate=1"),
		"и хода в заведение зеркала на странице нет").Равно(0);

КонецПроцедуры

// Посторонний и гость видят прежнюю пустоту: предложение — разговор с тем, кто пулом
// распоряжается, остальным оно показывало бы дороги, на которых их не ждут.
&Тест
Процедура ПостороннемуИГостюПустойПулДействийНеПоказывает() Экспорт

	ГлазамиПостороннего = Клиент.Тело(
		Клиент.GETСКукой("/bob", Клиент.Войти("alice", "AlicePassw0rd")));
	ГлазамиГостя = Клиент.Тело(Клиент.GET("/bob"));

	ПроверитьПустотуБезДействий(ГлазамиПостороннего, "вошедший посторонний");
	ПроверитьПустотуБезДействий(ГлазамиГостя, "гость");

КонецПроцедуры

// Пул с пакетами показывает пакеты: предложение начать принадлежит пустоте и вместе
// с ней уходит.
&Тест
Процедура НепустойПулПутейНеПредлагает() Экспорт

	Страница = Клиент.Тело(Клиент.GETСКукой("/secret", Клиент.Войти("owner1", "Owner1Passw0rd")));

	Ожидаем.Что(СтрНайти(Страница, "secret-pkg") > 0,
		"пакет пула на странице").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "С чего начать"),
		"предложения начать в непустом пуле нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "href=""/tour"""),
		"и хода в проводник тоже").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "migrate=1"),
		"и в заведение зеркала").Равно(0);

КонецПроцедуры

Процедура ПроверитьПустотуБезДействий(Знач Страница, Знач Кто)

	Ожидаем.Что(СтрНайти(Страница, "В пуле пока нет пакетов") > 0,
		Кто + " видит пустое состояние").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "С чего начать"),
		Кто + ": предложения начать нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "href=""/tour"""),
		Кто + ": хода в проводник нет").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "migrate=1"),
		Кто + ": хода в заведение зеркала нет").Равно(0);

КонецПроцедуры
