// Живые сторожа негодного ключа доступа: настоящий хаб отдельным процессом, настоящий
// HTTP. Клиент с протухшим или отозванным ключом обслуживается ровно как гость — тот же
// код, то же тело, та же метка ресурса, — но узнаёт из заголовка ответа, что его ключ
// хабом отвергнут. Приватный пул при этом по-прежнему неотличим от несуществующего.

#Использовать asserts
#Использовать ospx-tools
#Использовать "фикстуры"

Перем Хаб;                 // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;              // фикстура КлиентХаба — запросы к подопытному хабу
Перем КореньДанных;
Перем ТокенАдмина;         // живой PAT: контроль «отметки на годном ключе нет»
Перем ОтозванныйКлюч;      // PAT, отозванный владельцем — записи в базе больше нет
Перем ПубличныйПул;
Перем ПриватныйПул;
Перем Пакет;

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт

	ПубличныйПул = "marked";
	ПриватныйПул = "markedpriv";
	Пакет = "markedpkg";

КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФикстураПакета");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 30);
	КореньДанных = Хаб.ФайловаяБаза("openhub-отметка");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "root");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "RootPassw0rd");

	Хаб.Запустить();

	КукаАдмина = ДождатьсяВхода("root", "RootPassw0rd");
	ТокенАдмина = ВыпуститьТокен(КукаАдмина).Получить("token");
	ОтозванныйКлюч = ОтозванныйТокен(КукаАдмина);

	ЗавестиПул(ПубличныйПул, "public");
	ЗавестиПул(ПриватныйПул, "private");
	Опубликовать(ПубличныйПул, Пакет, "1.0.0");

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;

КонецПроцедуры

// Главное обещание: с негодным ключом клиент получает результат, а не отказ, — и при
// этом видит, что ключ отвергнут.
&Тест
Процедура СписокПубличногоПулаОтдаётсяКакГостю() Экспорт

	Гость = Клиент.GET(АдресСписка(ПубличныйПул));
	СКлючом = GETСКлючом(АдресСписка(ПубличныйПул), ОтозванныйКлюч);

	Ожидаем.Что(Гость.КодСостояния, "КОНТРОЛЬ: гость получает список").Равно(200);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Гость), Пакет) > 0, "КОНТРОЛЬ: пакет в списке есть").ЭтоИстина();

	Ожидаем.Что(СКлючом.КодСостояния, "негодный ключ не мешает получить список").Равно(200);
	Ожидаем.Что(Клиент.Тело(СКлючом), "тело то же, что у гостя").Равно(Клиент.Тело(Гость));
	Ожидаем.Что(Заголовок(СКлючом, "ETag"), "метка ресурса та же, что у гостя")
		.Равно(Заголовок(Гость, "ETag"));
	Ожидаем.Что(Отметка(СКлючом), "ключ назван неопознанным").Равно("invalid");

КонецПроцедуры

// Отмеченный ответ не должен осесть в разделяемом кэше как гостевой: заголовок
// OAUTH-TOKEN промежуточные кэши учётными данными не считают. Проверяется на адресах,
// которые гостю отдаются ИМЕННО с «public», — иначе утверждение было бы бесплатным.
&Тест
Процедура ОтмеченныйОтветЗакрытОтОбщегоКэша() Экспорт

	ПубличныеАдреса = Новый Массив();
	ПубличныеАдреса.Добавить(АдресСтраницыПакета());
	ПубличныеАдреса.Добавить(АдресТочнойВерсии("1.0.0"));

	Для Каждого Адрес Из ПубличныеАдреса Цикл

		Гостю = НРег(Заголовок(Клиент.GET(Адрес), "Cache-Control"));
		СКлючом = НРег(Заголовок(GETСКлючом(Адрес, ОтозванныйКлюч), "Cache-Control"));

		Ожидаем.Что(СтрНайти(Гостю, "public") > 0,
			СтрШаблон("КОНТРОЛЬ: гостю %1 отдаётся в общий кэш: %2", Адрес, Гостю)).ЭтоИстина();
		Ожидаем.Что(СтрНайти(СКлючом, "public"),
			СтрШаблон("с негодным ключом %1 в общий кэш не кладётся: %2", Адрес, СКлючом)).Равно(0);
		Ожидаем.Что(СтрНайти(СКлючом, "private") > 0,
			СтрШаблон("и виден только запросившему: %1", СКлючом)).ЭтоИстина();

	КонецЦикла;

КонецПроцедуры

// Остальные указания кэшу — не «public» — отмена не заслужили: срок жизни ответа
// точной версии переживает отметку.
&Тест
Процедура ОстальныеУказанияКэшуОстаютсяНаМесте() Экспорт

	Адрес = АдресТочнойВерсии("1.0.0");
	Гостю = НРег(Заголовок(Клиент.GET(Адрес), "Cache-Control"));
	СКлючом = НРег(Заголовок(GETСКлючом(Адрес, ОтозванныйКлюч), "Cache-Control"));

	Ожидаем.Что(СтрНайти(Гостю, "immutable") > 0,
		"КОНТРОЛЬ: тело точной версии неизменно: " + Гостю).ЭтоИстина();
	Ожидаем.Что(СтрНайти(СКлючом, "immutable") > 0,
		"и с отметкой оно неизменно по-прежнему: " + СКлючом).ЭтоИстина();
	Ожидаем.Что(СтрНайти(СКлючом, "max-age=31536000") > 0,
		"срок хранения не потерян: " + СКлючом).ЭтоИстина();

КонецПроцедуры

// Легаси-заголовок opm ходит теми же путями, что и Authorization.
&Тест
Процедура ЛегасиЗаголовокOAuthОтмечаетсяТакЖе() Экспорт

	Гость = Клиент.GET(АдресСписка(ПубличныйПул));
	СКлючом = GETСЗаголовком(АдресСписка(ПубличныйПул), "OAUTH-TOKEN", ОтозванныйКлюч);

	Ожидаем.Что(СКлючом.КодСостояния, "легаси-заголовок обслуживается так же").Равно(200);
	Ожидаем.Что(Клиент.Тело(СКлючом), "тело то же, что у гостя").Равно(Клиент.Тело(Гость));
	Ожидаем.Что(Отметка(СКлючом), "и ключ назван").Равно("invalid");
	Ожидаем.Что(СтрНайти(НРег(Заголовок(СКлючом, "Cache-Control")), "private") > 0,
		"и общему кэшу отдан не будет").ЭтоИстина();

КонецПроцедуры

// Отметка не зависит от того, чем кончился запрос: 304 без тела несёт её так же.
&Тест
Процедура УсловныйЗапросОтвечает304СОтметкой() Экспорт

	Метка = Заголовок(Клиент.GET(АдресСписка(ПубличныйПул)), "ETag");
	Ожидаем.Что(ЗначениеЗаполнено(Метка), "КОНТРОЛЬ: список отдаёт метку ресурса").ЭтоИстина();

	Гость = GETСЗаголовком(АдресСписка(ПубличныйПул), "If-None-Match", Метка);
	СКлючом = УсловныйСКлючом(АдресСписка(ПубличныйПул), Метка, ОтозванныйКлюч);

	Ожидаем.Что(Гость.КодСостояния, "КОНТРОЛЬ: гостю по совпавшей метке — 304").Равно(304);
	Ожидаем.Что(СКлючом.КодСостояния, "и с негодным ключом тоже 304").Равно(304);
	Ожидаем.Что(Отметка(СКлючом), "отметка есть и на ответе без тела").Равно("invalid");
	Ожидаем.Что(Отметка(Гость), "у гостя отметки нет").Равно("");

КонецПроцедуры

// НФТ-ДОСТ-002: отметка говорит о ключе, а не о цели запроса — по паре
// «приватный пул / несуществующий пул» она различить их не помогает.
&Тест
Процедура ПриватныйПулНеотличимОтНесуществующего() Экспорт

	ИмяВыдумки = "нет-такого-пула-9x";
	Приватный = GETСКлючом(АдресСписка(ПриватныйПул), ОтозванныйКлюч);
	Несуществующий = GETСКлючом(АдресСписка(ИмяВыдумки), ОтозванныйКлюч);

	Ожидаем.Что(Приватный.КодСостояния, "приватный пул негодному ключу не виден").Равно(404);
	Ожидаем.Что(Несуществующий.КодСостояния, "и несуществующий тоже").Равно(404);
	// в теле стоит имя, которое назвал сам клиент; всё остальное обязано совпадать
	Ожидаем.Что(БезИмениПула(Клиент.Тело(Приватный), ПриватныйПул), "тела неразличимы")
		.Равно(БезИмениПула(Клиент.Тело(Несуществующий), ИмяВыдумки));
	Ожидаем.Что(Отметка(Приватный), "отметка одна и та же").Равно(Отметка(Несуществующий));
	Ожидаем.Что(Отметка(Приватный), "и она говорит о ключе, а не о цели запроса").Равно("invalid");

КонецПроцедуры

// Обе стороны контроля: отметку получает только тот, кто предъявил негодный ключ.
&Тест
Процедура ГостьИЖивойКлючОтметкиНеПолучают() Экспорт

	Гость = Клиент.GET(АдресСписка(ПубличныйПул));
	Живой = GETСКлючом(АдресСписка(ПубличныйПул), ТокенАдмина);
	Мусор = GETСКлючом(АдресСписка(ПубличныйПул), "oshub_999999_deadbeef");

	Ожидаем.Что(Отметка(Гость), "гость ключа не предъявлял").Равно("");
	Ожидаем.Что(Живой.КодСостояния, "КОНТРОЛЬ: живой ключ работает").Равно(200);
	Ожидаем.Что(Отметка(Живой), "к живому ключу вопросов нет").Равно("");
	Ожидаем.Что(Отметка(Мусор), "нечитаемый ключ не опознан").Равно("invalid");

КонецПроцедуры

// Отметка живёт в общем месте, а не в выдаче: её несут и страницы, и JSON-чтение.
&Тест
Процедура СтраницаИЧтениеAPIТожеОтмечаются() Экспорт

	СтраницаГостя = Клиент.GET("/");
	СтраницаСКлючом = GETСКлючом("/", ОтозванныйКлюч);

	Ожидаем.Что(СтраницаГостя.КодСостояния, "КОНТРОЛЬ: главная открыта гостю").Равно(200);
	Ожидаем.Что(СтраницаСКлючом.КодСостояния, "и с негодным ключом открыта так же").Равно(200);
	Ожидаем.Что(Отметка(СтраницаСКлючом), "страница несёт отметку").Равно("invalid");
	Ожидаем.Что(Отметка(СтраницаГостя), "у гостя её нет").Равно("");

	АдресПакетов = СтрШаблон("/api/v1/pools/%1/packages", ПубличныйПул);
	ЧтениеГостя = Клиент.GET(АдресПакетов);
	ЧтениеСКлючом = GETСКлючом(АдресПакетов, ОтозванныйКлюч);

	Ожидаем.Что(ЧтениеСКлючом.КодСостояния, "JSON-чтение обслужено как гостю")
		.Равно(ЧтениеГостя.КодСостояния);
	Ожидаем.Что(Клиент.Тело(ЧтениеСКлючом), "и отдало то же содержимое").Равно(Клиент.Тело(ЧтениеГостя));
	Ожидаем.Что(Отметка(ЧтениеСКлючом), "чтение API несёт отметку").Равно("invalid");

КонецПроцедуры

// Отметка — не пропуск: мутации негодным ключом отвергаются, как отвергались.
&Тест
Процедура МутацииНегоднымКлючомПоПрежнемуОтвергаются() Экспорт

	Создание = POSTJsonКлючом("/api/v1/pools", "{""имя"":""marked-sneak""}", ОтозванныйКлюч);
	Ожидаем.Что(Создание.КодСостояния, "пул негодным ключом не создаётся").Равно(401);

	Ожидаем.Что(Клиент.GET(АдресСписка("marked-sneak")).КодСостояния,
		"и в самом деле не создан").Равно(404);

КонецПроцедуры

#Область Обвязка

Функция АдресСписка(Знач ИмяПула)
	Возврат СтрШаблон("/api/v1/pools/%1/download/list.txt", ИмяПула);
КонецФункции

Функция БезИмениПула(Знач Тело_, Знач ИмяПула)
	Возврат СтрЗаменить(Тело_, ИмяПула, "<пул>");
КонецФункции

// Страница пакета публичного пула — ответ, который гостю отдаётся в общий кэш.
Функция АдресСтраницыПакета()
	Возврат СтрШаблон("/%1/%2", ПубличныйПул, Пакет);
КонецФункции

// Тело точной версии публичного пула — неизменяемый ответ с длинным сроком.
Функция АдресТочнойВерсии(Знач Версия)
	Возврат СтрШаблон("/api/v1/pools/%1/download/%2/%3-%4.ospx",
		ПубличныйПул, Пакет, Пакет, Версия);
КонецФункции

Процедура ЗавестиПул(Знач Имя, Знач Видимость)

	Ответ = POSTJsonКлючом("/api/v1/pools",
		СтрШаблон("{""имя"":""%1"",""тип"":""custom"",""видимость"":""%2""}", Имя, Видимость),
		ТокенАдмина);
	Ожидаем.Что(Ответ.КодСостояния = 201 ИЛИ Ответ.КодСостояния = 409,
		СтрШаблон("пул %1 заведён: %2", Имя, Клиент.Тело(Ответ))).ЭтоИстина();

КонецПроцедуры

Процедура Опубликовать(Знач ИмяПула, Знач ИмяПакета, Знач Версия)

	Каталог = ОбъединитьПути(КореньДанных, "сборка-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Каталог);
	Данные = Новый ДвоичныеДанные(Новый ФикстураПакета().ПостроитьOspxПоМанифесту(
		Каталог, ПакетыOspx.НовыйМанифест(ИмяПакета, Версия), "# " + ИмяПакета));

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", СтрШаблон("%1-%2.ospx", ИмяПакета, Версия));
	Заголовки.Вставить("OAUTH-TOKEN", ТокенАдмина);
	Запрос = Новый HTTPЗапрос(СтрШаблон("/api/v1/pools/%1/push", ИмяПула), Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Данные);

	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Ожидаем.Что(Ответ.КодСостояния,
		СтрШаблон("пакет %1 опубликован: %2", ИмяПакета, Клиент.Тело(Ответ))).Равно(201);

КонецПроцедуры

// Ключ, отозванный владельцем: записи в базе нет, значение на руках у клиента осталось.
Функция ОтозванныйТокен(Знач Кука)

	Выпуск = ВыпуститьТокен(Кука);
	Адрес = "/api/v1/tokens/" + Формат(Выпуск.Получить("id"), "ЧГ=0");

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Ответ = Клиент.Соединение().ВызватьHTTPМетод("DELETE", Новый HTTPЗапрос(Адрес, Заголовки));
	Ожидаем.Что(Ответ.КодСостояния, "ключ отозван: " + Клиент.Тело(Ответ)).Равно(200);

	Возврат Выпуск.Получить("token");

КонецФункции

Функция ВыпуститьТокен(Знач Кука)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос("/api/v1/tokens", Заголовки);
	Запрос.УстановитьТелоИзСтроки("{""права"":""read,write""}", КодировкаТекста.UTF8);

	Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
	Ожидаем.Что(Ответ.КодСостояния, "PAT выпущен: " + Клиент.Тело(Ответ)).Равно(201);

	Возврат Клиент.ТелоJSON(Ответ).Получить("token_info");

КонецФункции

Функция ДождатьсяВхода(Знач Логин, Знач Пароль)

	Тело_ = СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", Логин, Пароль);
	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 30 * 1000;

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Заголовки = Новый Соответствие();
		Заголовки.Вставить("Content-Type", "application/json");
		Запрос = Новый HTTPЗапрос("/api/v1/login", Заголовки);
		Запрос.УстановитьТелоИзСтроки(Тело_, КодировкаТекста.UTF8);
		Ответ = Клиент.Соединение().ОтправитьДляОбработки(Запрос);
		Если Ответ.КодСостояния = 200 Тогда
			Возврат КукаСессии(Ответ);
		КонецЕсли;
		Приостановить(500);
	КонецЦикла;

	ВызватьИсключение "Админ не смог войти за отведённое время." + Символы.ПС + Хаб.Дамп();

КонецФункции

Функция POSTJsonКлючом(Знач Путь, Знач Тело_, Знач Ключ)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Authorization", "Bearer " + Ключ);
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело_, КодировкаТекста.UTF8);

	Возврат Клиент.Соединение().ОтправитьДляОбработки(Запрос);

КонецФункции

Функция GETСЗаголовком(Знач Путь, Знач ИмяЗаголовка, Знач ЗначениеЗаголовка)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить(ИмяЗаголовка, ЗначениеЗаголовка);
	Возврат Клиент.Соединение().Получить(Новый HTTPЗапрос(Путь, Заголовки));
КонецФункции

Функция GETСКлючом(Знач Путь, Знач Ключ)
	Возврат GETСЗаголовком(Путь, "Authorization", "Bearer " + Ключ);
КонецФункции

Функция УсловныйСКлючом(Знач Путь, Знач Метка, Знач Ключ)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Authorization", "Bearer " + Ключ);
	Заголовки.Вставить("If-None-Match", Метка);

	Возврат Клиент.Соединение().Получить(Новый HTTPЗапрос(Путь, Заголовки));

КонецФункции

// Значение отметки состояния ключа; "" — заголовка в ответе нет.
Функция Отметка(Знач Ответ)
	Возврат Заголовок(Ответ, "OSHub-Token-Status");
КонецФункции

Функция Заголовок(Знач Ответ, Знач Имя)

	ИскомыйКлюч = ВРег(Имя);
	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = ИскомыйКлюч Тогда
			Возврат Строка(КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция КукаСессии(Знач Ответ)

	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) <> "SET-COOKIE" Тогда
			Продолжить;
		КонецЕсли;
		Значение = ЗначениеКуки(Строка(КиЗ.Значение), "oshub_session");
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ЗначениеКуки(Знач СтрокаКук, Знач ИмяКуки)

	Маркер = ИмяКуки + "=";
	Поз = СтрНайти(СтрокаКук, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(СтрокаКук, Поз + СтрДлина(Маркер));
	Конец = СтрДлина(Остаток) + 1;
	ТочкаЗпт = СтрНайти(Остаток, ";");
	Если ТочкаЗпт > 0 И ТочкаЗпт < Конец Тогда
		Конец = ТочкаЗпт;
	КонецЕсли;
	Запятая = СтрНайти(Остаток, ",");
	Если Запятая > 0 И Запятая < Конец Тогда
		Конец = Запятая;
	КонецЕсли;

	Возврат СокрЛП(Лев(Остаток, Конец - 1));

КонецФункции

#КонецОбласти
