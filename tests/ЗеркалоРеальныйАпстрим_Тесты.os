// Приёмка зеркала против НАСТОЯЩЕГО hub.oscript.io: хаб поднимается с апстримом на живой
// публичный хаб и отдаёт оттуда реальный пакет. Нужна внешняя система и сеть, поэтому
// набор помечен тегом «внешние» и в регрессию не идёт — иначе «ноль ошибочных» зависел бы
// от чужого сервера. Всё, что сети не требует, живёт в Зеркало_Тесты.

#Использовать asserts
#Использовать "фикстуры"

Перем Хаб;
Перем КаталогПроекта;
Перем ТаймаутСек;
Перем Доступность;  // фикстура ДоступностьАпстрима — правило предиката включения

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
&Тег("внешние")
Процедура ПриСозданииОбъекта() Экспорт
	ТаймаутСек = 60;
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьФикстуры() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("ДоступностьАпстрима");

	Доступность = Новый ДоступностьАпстрима();

КонецПроцедуры

&ПослеКаждого
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
		Хаб = Неопределено;
	КонецЕсли;
	ОчиститьОкружение();
КонецПроцедуры

&Тест
&ВключенЕсли("() -> РеальныйHubДоступен()",
	Причина = "нет сети до hub.oscript.io (приёмочная проверка реального зеркала пропускается)")
Процедура РеальныйHubЗеркалируется() Экспорт

	Корень = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-real-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Корень);
	СоздатьКаталог(ОбъединитьПути(Корень, "jsondb"));

	Хаб = НовыйХаб();
	ЗадатьОкружение(Корень);
	ЗапуститьЗасев(); // пул назначения с апстримом на hub.oscript.io

	Хаб.Запустить();

	// tempfiles — небольшой реальный пакет на hub.oscript.io
	Ответ = GET(Хаб.Порт(), "/download/tempfiles/tempfiles.ospx");
	Ожидаем.Что(Ответ.КодСостояния, "реальный пакет проксирован с hub.oscript.io").Равно(200);
	Ожидаем.Что(Ответ.ПолучитьТелоКакДвоичныеДанные().Размер() > 0, "тело реального .ospx не пустое").ЭтоИстина();

КонецПроцедуры

#Область Служебное

// Отвечает ли реальный hub.oscript.io. Предикат судит СЕТЬ, а не содержимое ответа:
// «сервер ответил, просто перенаправляет» (hub.oscript.io отдаёт 301 на https) — это
// доступность. Само правило и его сторож живут в фикстуре ДоступностьАпстрима и
// в Зеркало_Тесты: проверка «код равен 200» превращала любое изменение на чужой стороне
// в тихое отключение теста — ровно так приёмка перестала ловить дефект редиректа.
//
// Возвращаемое значение:
//  Булево - признак доступности апстрима.
//
Функция РеальныйHubДоступен() Экспорт

	Попытка
		Соединение = Новый HTTPСоединение("hub.oscript.io", 80, , , , 8);
		Ответ = Соединение.Получить(Новый HTTPЗапрос("/list.txt"));
		Возврат ПравилоДоступности().ОтветОзначаетДоступность(Ответ.КодСостояния);
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Предикат зовётся OneUnit до &ПередВсеми, поэтому правило поднимается по требованию.
Функция ПравилоДоступности()

	Если Доступность = Неопределено Тогда
		КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
		РеестрФикстур.Подключить("ДоступностьАпстрима");
		Доступность = Новый ДоступностьАпстрима();
	КонецЕсли;

	Возврат Доступность;

КонецФункции

Функция НовыйХаб()

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	РеестрФикстур.Подключить("ЭкземплярХаба");

	Результат = Новый ЭкземплярХаба(ТаймаутСек);

	// Фоновые задачи и доставщик вебхуков выключены по той же причине, что в Зеркало_Тесты:
	// обработчик запроса и фоновая рогатка в одном процессе лезут в один файл КоннектораJSON.
	Результат.Среда("OSHUB_JOBS_ENABLED", "false");
	Результат.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");

	Возврат Результат;

КонецФункции

Процедура ЗадатьОкружение(Знач Корень)

	Хаб.Среда("OSHUB_STORAGE_ROOT", Корень);
	Хаб.Среда("OSHUB_DB_CONNECTION", ОбъединитьПути(Корень, "jsondb"));
	Хаб.Среда("OSHUB_DEFAULT_POOL", "");
	Хаб.Среда("OSHUB_SEED_FIXTURE", ПутьФикстурыПакета());
	Хаб.Среда("OSHUB_SEED_POOL", "public");
	Хаб.Среда("OSHUB_SEED_PACKAGE", "mirror-local-pkg");
	Хаб.Среда("OSHUB_SEED_VERSIONS", "0.1.0");
	Хаб.Среда("OSHUB_SEED_YANKED", "");
	// адрес КАТАЛОГА ВЫДАЧИ по контракту opm, а не главной страницы: на голом хосте
	// апстрим отвечает сплошными 404 (СервисПрокси.ПодсказкаОПутиВыдачи)
	Хаб.Среда("OSHUB_SEED_UPSTREAM_URL", "http://hub.oscript.io/download/");
	Хаб.Среда("OSHUB_SEED_UPSTREAM_ALLOW_PRIVATE", "");
	Хаб.Среда("OSHUB_SEED_UPSTREAM_TTL_SEC", "60");

КонецПроцедуры

Функция ПутьФикстурыПакета()
	Путь = ОбъединитьПути(КаталогПроекта, "tests", "фикстуры");
	Возврат ОбъединитьПути(Путь, "spike0c-testpkg-0.1.0.ospx");
КонецФункции

Процедура ЗапуститьЗасев()

	ПутьЗасевщика = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры", "ЗасеятьПакет.os");
	ПроцессЗасева = СоздатьПроцесс(СтрШаблон("oscript ""%1""", ПутьЗасевщика), КаталогПроекта, Истина);
	ПроцессЗасева.Запустить();
	ДождатьсяПроцесса(ПроцессЗасева, "засев пула назначения");
	Если ПроцессЗасева.КодВозврата <> 0 Тогда
		ВызватьИсключение "Засев завершился с ошибкой (см. вывод в консоли теста)";
	КонецЕсли;

КонецПроцедуры

Процедура ДождатьсяПроцесса(Знач Процесс_, Знач Пояснение)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСек * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Если Процесс_.Завершен Тогда
			Возврат;
		КонецЕсли;
		Приостановить(300);
	КонецЦикла;
	ВызватьИсключение СтрШаблон("Процесс ""%1"" не завершился за %2 сек", Пояснение, ТаймаутСек);

КонецПроцедуры

Процедура ОчиститьОкружение()

	Перем_ = "OSHUB_PORT,OSHUB_STORAGE_ROOT,OSHUB_DB_CONNECTOR,OSHUB_DB_CONNECTION,OSHUB_SEED_FIXTURE,"
		+ "OSHUB_SEED_POOL,OSHUB_SEED_PACKAGE,OSHUB_SEED_VERSIONS,OSHUB_SEED_YANKED,OSHUB_DEFAULT_POOL,"
		+ "OSHUB_SEED_UPSTREAM_URL,OSHUB_SEED_UPSTREAM_ALLOW_PRIVATE,OSHUB_SEED_UPSTREAM_TTL_SEC";
	Для Каждого Имя Из СтрРазделить(Перем_, ",") Цикл
		УстановитьПеременнуюСреды(Имя, "");
	КонецЦикла;

КонецПроцедуры

Функция GET(Знач Порт, Знач Путь)
	Возврат Новый HTTPСоединение("localhost", Порт, , , , 20).Получить(Новый HTTPЗапрос(Путь));
КонецФункции

#КонецОбласти
