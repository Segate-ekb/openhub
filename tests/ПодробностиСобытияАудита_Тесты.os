// Круг подробностей события: что СобытиеАудита записало в журнал, то ФорматЖурналаАудита
// оттуда и вернул — теми же полями и теми же типами. Разбор один на весь хаб; читать
// подробности платформенным ПрочитатьJSON нельзя: он подменяет ISO-подобную строку Датой,
// и «истекает» уезжает на экран журнала не тем, чем в него ушло.

#Использовать asserts
#Использовать "фикстуры"

Перем Нагрузка;   // СобытиеАудита — сборка нагрузки записи журнала
Перем Формат;     // ФорматЖурналаАудита — форма строки журнала и разбор подробностей

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.ПодключитьОснову(Модули);

	КлассыАудита = ОбъединитьПути(Модули, "аудит", "Классы");
	ПоискКлассов.Подключить(КлассыАудита, "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(КлассыАудита, "СобытиеАудита");
	ПоискКлассов.Подключить(КлассыАудита, "ФорматЖурналаАудита");

	Нагрузка = Новый СобытиеАудита(Новый ИмяОбъектаАудита(), Новый ТекстJSON());
	Формат = Новый ФорматЖурналаАудита();

КонецПроцедуры

#Область КругПодробностей

&Тест
Процедура ПодробностиВозвращаютсяТемиЖеПолямиИТипами() Экспорт

	Детали = Новый Структура();
	Детали.Вставить("пул", "public");
	Детали.Вставить("размер", 512000);
	Детали.Вставить("доля", 1.5);
	Детали.Вставить("включено", Истина);
	Детали.Вставить("отключено", Ложь);

	Поля = Прочитанные(Детали);

	Ожидаем.Что(Поля.Получить("пул"), "имя пула").Равно("public");
	Ожидаем.Что(Поля.Получить("размер"), "размер числом").Равно(512000);
	Ожидаем.Что(Поля.Получить("доля"), "дробное числом").Равно(1.5);
	Ожидаем.Что(Поля.Получить("включено"), "флаг истиной").ЭтоИстина();
	Ожидаем.Что(Поля.Получить("отключено"), "флаг ложью").ЭтоЛожь();

	Ожидаем.Что(Строка(ТипЗнч(Поля.Получить("размер"))), "тип числа").Равно("Number");
	Ожидаем.Что(Строка(ТипЗнч(Поля.Получить("включено"))), "тип флага").Равно("Boolean");

КонецПроцедуры

// Сердце круга: платформенный ПрочитатьJSON отдал бы здесь Дату, и в подробностях
// на экране журнала вместо записанного момента оказалось бы локальное представление.
&Тест
Процедура МоментОстаётсяСтрокойАНеСтановитсяДатой() Экспорт

	Детали = Новый Структура("истекает", "2026-09-05T10:11:12Z");

	Значение = Прочитанные(Детали).Получить("истекает");

	Ожидаем.Что(Строка(ТипЗнч(Значение)), "ISO-подобная строка обязана вернуться строкой")
		.Равно("String");
	Ожидаем.Что(Значение, "и ровно той же строкой").Равно("2026-09-05T10:11:12Z");

КонецПроцедуры

&Тест
Процедура ПереносыИКавычкиВнутриПодробностейПереживаютКруг() Экспорт

	Текст = "первая" + Символы.ПС + "вторая ""в кавычках"" и \слэш\";
	Детали = Новый Структура("причина", Текст);

	Ожидаем.Что(Прочитанные(Детали).Получить("причина"), "экранирование JSON обратимо")
		.Равно(Текст);

КонецПроцедуры

&Тест
Процедура ВложенныйОбъектИМассивВозвращаютсяЦеликом() Экспорт

	Вложенное = Новый Структура("имя, попыток", "зеркало-1", 3);
	Детали = Новый Структура();
	Детали.Вставить("источник", Вложенное);
	Детали.Вставить("версии", ТриВерсии());

	Поля = Прочитанные(Детали);

	Ожидаем.Что(Строка(ТипЗнч(Поля.Получить("источник"))), "вложенный объект").Равно("Map");
	Ожидаем.Что(Поля.Получить("источник").Получить("имя"), "поле вложенного объекта")
		.Равно("зеркало-1");
	Ожидаем.Что(Поля.Получить("источник").Получить("попыток"), "число во вложенном объекте")
		.Равно(3);

	Ожидаем.Что(Строка(ТипЗнч(Поля.Получить("версии"))), "массив").Равно("Array");
	Ожидаем.Что(Поля.Получить("версии").Количество(), "элементов массива").Равно(3);
	Ожидаем.Что(Поля.Получить("версии")[2], "последний элемент").Равно("1.0.2");

КонецПроцедуры

// Граница «ничего»: null — законное значение поля, а не поломка разбора. Если их
// не различать, одно пустое поле уносит с экрана ВСЕ подробности записи.
&Тест
Процедура ПолеБезЗначенияНеУноситОстальныеПодробности() Экспорт

	Детали = Новый Структура();
	Детали.Вставить("пул", "public");
	Детали.Вставить("причина", Неопределено);

	Поля = Прочитанные(Детали);

	Ожидаем.Что(Поля, "объект с null разбирается").Существует();
	Ожидаем.Что(Поля.Количество(), "полей прочитано").Равно(2);
	Ожидаем.Что(Поля.Получить("пул"), "соседнее поле цело").Равно("public");
	Ожидаем.Что(Поля.Получить("причина"), "пустое поле пустым и вернулось").ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура СобытиеБезПодробностейДаётПустойНаборПолей() Экспорт

	Поля = Формат.ДеталиПолями(Нагрузка.Собрать("root", "тест", "", "", Неопределено).ДеталиJSON);

	Ожидаем.Что(Поля, "пустой объект — это разобранный объект, а не отказ").Существует();
	Ожидаем.Что(Поля.Количество(), "полей нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ОтказыРазбора

&Тест
Процедура НеJSONПодробностямиНеСчитается() Экспорт

	Ожидаем.Что(Формат.ДеталиПолями(""), "пустой текст").ЭтоНеопределено();
	Ожидаем.Что(Формат.ДеталиПолями("просто текст"), "не JSON").ЭтоНеопределено();
	Ожидаем.Что(Формат.ДеталиПолями("[1,2]"), "массив верхним уровнем — не подробности")
		.ЭтоНеопределено();
	Ожидаем.Что(Формат.ДеталиПолями("{""пул"":""public"""), "оборванный объект")
		.ЭтоНеопределено();
	Ожидаем.Что(Формат.ДеталиПолями("{""пул"":ерунда}"), "значение не является литералом JSON")
		.ЭтоНеопределено();

КонецПроцедуры

// Строка журнала и подробности разбираются ОДНИМ разбором в двух режимах: послабление,
// сделанное для подробностей, не имеет права ослабить строгость самой строки журнала.
&Тест
Процедура СтрокаЖурналаПоПрежнемуТребуетТекстовыхПолей() Экспорт

	Ожидаем.Что(Формат.ИзСтроки("{""когда"":123}"), "число на месте поля записи")
		.ЭтоНеопределено();
	Ожидаем.Что(Формат.ИзСтроки("{""когда"":true}"), "флаг на месте поля записи")
		.ЭтоНеопределено();
	Ожидаем.Что(Формат.ИзСтроки("{""кто"":""root""}"), "запись без времени")
		.ЭтоНеопределено();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Полный круг: подробности уходят в нагрузку события ровно так, как их пишет хаб,
// и читаются оттуда единственным разбором журнала.
Функция Прочитанные(Знач Детали)

	Данные = Нагрузка.Собрать("root", "тест.действия", "", "", Детали);

	Возврат Формат.ДеталиПолями(Данные.ДеталиJSON);

КонецФункции

Функция ТриВерсии()

	Номера = Новый Массив();
	Номера.Добавить("1.0.0");
	Номера.Добавить("1.0.1");
	Номера.Добавить("1.0.2");

	Возврат Номера;

КонецФункции

#КонецОбласти
