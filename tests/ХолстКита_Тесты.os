// Слой элементов UI-кита: экран собирается деревом узлов, а разметку печатает кит.
// Проверяется поведение, которое ломается для человека: порядок на экране, экранирование
// чужого текста, признаки для скрипта страницы, отказ формы без CSRF и отказ узла, внутрь
// которого класть нельзя.

#Использовать asserts
#Использовать "фикстуры"

Перем UI;        // СборкаUI — граф компонентов и рендереров
Перем Кит;       // Кит — фабрика элементов экрана
Перем Кабинет;   // РендерерКабинета — им собраны экраны приватной части

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));
	Кит = UI.Кит;

	// экраны приватной части собираются не каркасом напрямую, а рендерером кабинета:
	// путь до обрамления идёт через него, и стеречь надо именно этот ход
	Поиск = Новый КлассыСлоя();
	Поиск.Подключить(
		ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы", "общее"), "РендерерКабинета");
	Кабинет = Новый РендерерКабинета(UI.Каркас);

КонецПроцедуры

#Область СоставДерева

// Порядок на экране — это состав дерева, а не арифметика строк: ребёнок печатается
// ВНУТРИ родителя и в том порядке, в каком его положили.
&Тест
Процедура РебёнокПечатаетсяВнутриРодителяИВПорядкеДобавления() Экспорт

	Ряд = Кит.Ряд("выбор");
	Ряд.Добавить(Кит.Надпись("название")).Добавить(Кит.Текст("первый"));
	Ряд.Добавить(Кит.Надпись("сноска")).Добавить(Кит.Текст("второй"));

	HTML = Ряд.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "первый") > 0 И СтрНайти(HTML, "второй") > 0,
		"оба ребёнка напечатаны: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "первый") < СтрНайти(HTML, "второй"),
		"порядок на экране равен порядку добавления: " + HTML).ЭтоИстина();

	Внутри = МеждуМаркеров(HTML, "<div", "</div>");
	Ожидаем.Что(СтрНайти(Внутри, "первый") > 0,
		"ребёнок лежит ВНУТРИ родителя, а не рядом с ним: " + HTML).ЭтоИстина();

КонецПроцедуры

// «Из чего собран этот экран» отвечается объектом, а не чтением одиннадцати файлов.
&Тест
Процедура ДеревоЭкранаПечатаетсяРодамиИВидами() Экспорт

	Раскрывашка = Кит.Раскрывашка();
	Раскрывашка.Шапка().Добавить(Кит.Надпись("название")).Добавить(Кит.Код("имя"));
	Раскрывашка.Добавить(Кит.Примечание("пояснение"));
	Раскрывашка.Добавить(Кит.Кнопка(Новый Структура("Подпись", "Сохранить")));

	Дерево = Раскрывашка.Дерево();
	Строки = СтрРазделить(СокрЛП(Дерево), Символы.ПС, Ложь);

	Ожидаем.Что(СокрЛП(Строки[0]), "корень назван родом").Равно("раскрывашка");
	Ожидаем.Что(СтрНайти(Дерево, "надпись[название]") > 0,
		"вид узла виден в дереве: " + Дерево).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Дерево, "компонент[кнопка]") > 0,
		"компонент назван, а не безымянный кусок HTML: " + Дерево).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Дерево, "код") > 0, "лист дерева виден: " + Дерево).ЭтоИстина();

КонецПроцедуры

// Шапка раскрывашки и её тело — РАЗНЫЕ холсты: содержимое, положенное в тело, не должно
// уезжать в свёрнутую строку и наоборот.
&Тест
Процедура ШапкаИТелоРаскрывашкиНеПеремешиваются() Экспорт

	Узел = Кит.Раскрывашка();
	Узел.Шапка().Добавить(Кит.Текст("свёрнуто"));
	Узел.Добавить(Кит.Текст("развёрнуто"));

	HTML = Узел.Рендер();
	Свёрнутое = МеждуМаркеров(HTML, "<summary", "</summary>");

	Ожидаем.Что(СтрНайти(Свёрнутое, "свёрнуто") > 0,
		"шапка напечатана в summary: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Свёрнутое, "развёрнуто"),
		"тело в шапку не протекло: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "развёрнуто") > 0,
		"а само тело на месте: " + HTML).ЭтоИстина();

КонецПроцедуры

// Элемент, положенный внутрь второго родителя, исчез бы с первого места молча.
&Тест
Процедура ЭлементНеКладётсяВДваМестаИНеКладётсяВСебя() Экспорт

	Первый = Кит.Холст();
	Второй = Кит.Холст();
	Общий = Кит.Надпись("");
	Первый.Добавить(Общий);

	Ожидаем.Что(ОшибкаДобавления(Второй, Общий),
		"элемент уже лежит внутри другого").Заполнено();

	Гнездо = Кит.Холст();
	Первый.Добавить(Гнездо);
	Ожидаем.Что(ОшибкаДобавления(Гнездо, Первый),
		"предок, положенный в потомка, дал бы бесконечную печать").Заполнено();

КонецПроцедуры

// Лист дерева печатает себя целиком, внутрь него класть нечего — и об этом говорят
// словами, а не молча теряют вложенное.
&Тест
Процедура ЛистДереваВнутрьСебяНеПускает() Экспорт

	Ожидаем.Что(ОшибкаДобавления(Кит.Текст("значение"), Кит.Надпись("")),
		"текстовый узел холстом не бывает").Заполнено();
	Ожидаем.Что(ОшибкаДобавления(Кит.Картинка("/static/x.svg", "значок"), Кит.Надпись("")),
		"картинка холстом не бывает").Заполнено();
	Ожидаем.Что(ОшибкаДобавления(Кит.Кнопка(Новый Структура("Подпись", "Сохранить")),
		Кит.Надпись("")), "готовый компонент холстом не бывает").Заполнено();

	// КОНТРОЛЬ: раскладочный узел внутрь пускает, иначе проверка выше зелена всегда
	Ожидаем.Что(ОшибкаДобавления(Кит.Холст(), Кит.Надпись("")),
		"холст вложенное принимает").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ЭкранированиеИВид

// Экранирование структурно: текстовый узел иначе печатать не умеет, и «не забыл ли автор
// экранировать» перестаёт быть вопросом.
&Тест
Процедура ТекстовыйУзелЭкранируетсяПоСвоейПрироде() Экспорт

	Злое = "<script>alert(1)</script>";

	Надпись = Кит.Надпись("название");
	Надпись.Добавить(Кит.Текст(Злое));
	HTML = Надпись.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<script"), "чужой текст разметкой не стал: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;script&gt;") > 0,
		"он напечатан текстом: " + HTML).ЭтоИстина();

	// и то же самое внутри машинного значения
	Код = Кит.Код(Злое).Рендер();
	Ожидаем.Что(СтрНайти(Код, "<script"), "и в <code> тоже: " + Код).Равно(0);

КонецПроцедуры

// Сырой узел ОДИН, назван явно и существует только ради перехода: пока экраны переводятся
// по одному, непереведённый кусок обязан куда-то ложиться.
&Тест
Процедура ГотовыйФрагментПечатаетсяКакЕстьИЭтоЕдинственнаяТакаяДверь() Экспорт

	HTML = Кит.Готовое("<b>жирным</b>").Рендер();
	Ожидаем.Что(HTML, "готовый фрагмент печатается как есть").Равно("<b>жирным</b>");

	// та же строка, положенная текстом, разметкой не становится
	Текстом = Кит.Текст("<b>жирным</b>").Рендер();
	Ожидаем.Что(СтрНайти(Текстом, "<b>"), "текстовый узел эту дверь не открывает").Равно(0);

КонецПроцедуры

// Вид — значение из закрытого набора кита, а не имя CSS-класса. Опечатка в виде обязана
// останавливать сборку: иначе экран приезжает без оформления, и виноватым выглядит CSS.
&Тест
Процедура НеизвестныйВидОстанавливаетСборкуИВКлассНеПротекает() Экспорт

	Отказ = "";
	Попытка
		Проба = Кит.Надпись("tag--accent");
		Проба = Проба;
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Отказ, "вид вне набора кита отбит").Заполнено();
	Ожидаем.Что(СтрНайти(Отказ, "tag--accent") > 0, "названо, что именно отбито: " + Отказ)
		.ЭтоИстина();

	// КОНТРОЛЬ: вид из набора проходит и даёт СВОЙ класс, а не пустой
	HTML = Кит.Надпись("пояснение").Рендер();
	Ожидаем.Что(СтрНайти(HTML, "class=") > 0, "известный вид даёт класс: " + HTML).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область КонтрактСБраузером

// data-признак печатается ДАЖЕ ПУСТЫМ: по нему скрипт страницы находит набор полей,
// и у набора с пустым ключом (это «свой провайдер») пропавший `data-…=""` тихо выключает
// переключение — без единой ошибки в журнале.
&Тест
Процедура ПризнакПечатаетсяДажеСПустымЗначением() Экспорт

	HTML = Кит.Группа("", "набор").Признак("set", "").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "data-set=""""") > 0,
		"пустой признак напечатан, скрипту есть за что взять узел: " + HTML).ЭтоИстина();

	Заполненный = Кит.Группа("", "набор").Признак("set", "github").Рендер();
	Ожидаем.Что(СтрНайти(Заполненный, "data-set=""github""") > 0,
		"и заполненный тоже: " + Заполненный).ЭтоИстина();

КонецПроцедуры

// Отключённый набор браузер не отправляет, не пускает в него фокус и не держит на нём
// обязательность; скрытый — не занимает места. Обе пометки едут вместе.
&Тест
Процедура ОтключённыйИСкрытыйНаборНесётОбеПометки() Экспорт

	HTML = Кит.Группа("", "набор").Отключить().Скрыть().Рендер();

	Ожидаем.Что(СтрНайти(HTML, " disabled") > 0, "набор отключён: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, " hidden") > 0, "и скрыт: " + HTML).ЭтоИстина();

	Открытый = Кит.Группа("", "набор").Рендер();
	Ожидаем.Что(СтрНайти(Открытый, "disabled"), "КОНТРОЛЬ: обычный набор рабочий").Равно(0);
	Ожидаем.Что(СтрНайти(Открытый, "hidden"), "КОНТРОЛЬ: и видимый").Равно(0);

КонецПроцедуры

// Форма без CSRF-токена выглядит рабочей и гарантированно получает 403. Такую форму
// собрать нельзя вовсе — гарантия перенесена из памяти автора в кит.
&Тест
Процедура ФормаБезТокенаНеСобирается() Экспорт

	Отказ = "";
	Попытка
		Проба = Кит.Форма("/hub/settings/providers", "");
		Проба = Проба;
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Отказ, "форма без токена отбита").Заполнено();

	HTML = Кит.Форма("/hub/settings/providers", "т0кен", "столбик").Рендер();
	Ожидаем.Что(СтрНайти(HTML, "name=""_csrf""") > 0,
		"а с токеном скрытое поле на месте: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "value=""т0кен""") > 0,
		"и в нём именно токен сессии: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "action=""/hub/settings/providers""") > 0,
		"и адрес действия: " + HTML).ЭтоИстина();

КонецПроцедуры

// Пустой адрес значка не должен давать битой картинки: у провайдера без значка на экране
// пусто, а не сломанное изображение.
&Тест
Процедура КартинкаБезАдресаНеПечатается() Экспорт

	Ожидаем.Что(Кит.Картинка("", "значок").Рендер(), "битого <img> нет").Равно("");
	Ожидаем.Что(СтрНайти(Кит.Картинка("/static/github.svg", "значок").Рендер(),
		"src=""/static/github.svg""") > 0, "КОНТРОЛЬ: заданный значок печатается").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Каркас страницы принадлежит киту, а СВОИ адреса, знак и подпись хаб подаёт ему
// обрамлением инсталляции. Ломается для человека прямо: ход на главную ведёт в никуда,
// вкладка называется чужим именем, выход не работает.
&Тест
Процедура ОбрамлениеХабаПодаётКаркасуСвоиАдресаЗнакИПодпись() Экспорт

	HTML = UI.Каркас.Страница("Каталог", Кит.Примечание("тело"),
		UI.Каркас.КонтекстСтраницы(Новый Структура("Логин", "alice"), Неопределено));

	Ожидаем.Что(СтрНайти(HTML, "<title>Каталог — OpenHub</title>") > 0,
		"вкладка названа знаком хаба: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<a href=""/"" class=""brand""") > 0,
		"ход на главную: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "href=""/packages""") > 0,
		"верхняя навигация ведёт в каталог: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "action=""/ui/theme""") > 0,
		"переключатель оформления на своём адресе: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "href=""/me""") > 0, "ход в кабинет: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "action=""/logout""") > 0, "выход формой: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "Открытый хаб пакетов OneScript") > 0,
		"подпись подвала: " + HTML).ЭтоИстина();

	// и ни один из этих адресов не зашит в кит: обрамление их и приносит
	Рамка = UI.Обрамление.Обрамление(
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено, Ложь, Истина));
	Ожидаем.Что(Рамка.Адреса.Выход).Равно("/logout");
	Ожидаем.Что(Рамка.Адреса.Вход).Равно("/login");

КонецПроцедуры

// Дороги вошедшего собраны в ОДНОМ меню, поэтому они одни и те же на ЛЮБОЙ странице —
// в том числе на публичной, где второго ряда разделов не было никогда. Проверяются они
// ВНУТРИ панели меню: дорога, доступная только с этого экрана, требования не закрывает.
&Тест
Процедура ЕдиноеМенюНесётСемьДорогВошедшегоНаПубличнойСтранице() Экспорт

	Страница = СтраницаВошедшего("root", Истина);
	Панель = ПанельМеню(Страница);

	Ожидаем.Что(Панель <> "", "панель единого меню печатается: " + Страница).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "class=""hubmenu__login"">root<") > 0,
		"меню подписано именем вошедшего: " + Панель).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "office-nav"),
		"второго ряда разделов больше нет: " + Страница).Равно(0);

	Для Каждого Дорога Из СтрРазделить("/me,/root,/packages?mine=1,/me/notifications,"
		+ "/me/inbox,/me/settings,/hub/settings", ",") Цикл
		Ожидаем.Что(СтрНайти(Панель, "href=""" + Дорога + """") > 0,
			"дорога " + Дорога + " ведёт из панели меню: " + Панель).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(СтрНайти(Панель, "action=""/logout""") > 0,
		"и выход формой в самом меню: " + Панель).ЭтоИстина();

КонецПроцедуры

// На широком экране ходы стоят классической шапкой: дороги хаба, переключатель темы
// и кнопка-учётка, открывающая ту же панель. Узкую полосу прячет лист стилей, поэтому
// сторожится СОСТАВ шапки, а не её видимость.
&Тест
Процедура ШапкаШирокогоЭкранаНесётДорогиХабаИУчётку() Экспорт

	Шапка = ШапкаСтраницы(СтраницаВошедшего("alice", Ложь));

	Ожидаем.Что(СтрНайти(Шапка, "href=""/packages""") > 0,
		"дорога хаба в шапке: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "action=""/ui/theme""") > 0,
		"переключатель темы там же: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "hubmenu__user") > 0,
		"кнопка-учётка в шапке: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, ">alice<") > 0,
		"и подписана именем вошедшего: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "popovertarget=""hubmenu""") > 0,
		"а открывает ту же панель, что и бургер: " + Шапка).ЭтоИстина();


КонецПроцедуры

// Ход ко входу гостю печатает КИТ — и в шапке, и в панели. Хаб своей дороги «Войти»
// не подаёт: на стенде именно из-за неё в шапке оказались ДВА «Войти» рядом.
&Тест
Процедура ГостьВидитВШапкеОдинХодКоВходу() Экспорт

	Гостевая = ШапкаСтраницы(СтраницаГостя());

	Ожидаем.Что(СтрЧислоВхождений(Гостевая, "href=""/login"""),
		"ход ко входу в шапке ровно один: " + Гостевая).Равно(1);
	Ожидаем.Что(СтрЧислоВхождений(Гостевая, "Войти"),
		"и словом он назван один раз: " + Гостевая).Равно(1);
	Ожидаем.Что(СтрНайти(Гостевая, "hubmenu__user"),
		"кнопки-учётки гостю нет: " + Гостевая).Равно(0);
	Ожидаем.Что(СтрНайти(Гостевая, "href=""/packages""") > 0,
		"КОНТРОЛЬ: дороги хаба в шапке на месте: " + Гостевая).ЭтоИстина();

КонецПроцедуры

// Настройки хаба — единственное дело меню с порогом: рядовому участнику его не печатают
// вовсе, а не прячут стилями.
&Тест
Процедура НастройкиХабаВМенюВидитТолькоАдмин() Экспорт

	Участник = СтраницаВошедшего("alice", Ложь);
	Ожидаем.Что(СтрНайти(Участник, "href=""/hub/settings"""),
		"рядовому участнику хода в настройки хаба нет: " + Участник).Равно(0);
	Ожидаем.Что(СтрНайти(Участник, "Настройки хаба"),
		"и словом пункт не назван: " + Участник).Равно(0);
	Ожидаем.Что(СтрНайти(Участник, "href=""/me/settings""") > 0,
		"КОНТРОЛЬ: свои настройки у него на месте: " + Участник).ЭтоИстина();

	Админ = СтраницаВошедшего("root", Истина);
	Ожидаем.Что(СтрНайти(Админ, "href=""/hub/settings""") > 0,
		"админу ход в настройки хаба показан: " + Админ).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПанельМеню(Админ), "администратор хаба") > 0,
		"и роль подписана прямо под его именем: " + Админ).ЭтоИстина();

КонецПроцедуры

// Гостю показывать нечего, кроме дорог самого хаба: ни дел, ни имени у него нет. Вход
// стоит дорогой меню — в слим-шапке кнопки входа больше не осталось.
&Тест
Процедура ГостюВЕдиномМенюОстаютсяДорогиХабаИВход() Экспорт

	Гость = СтраницаГостя();
	Панель = ПанельМеню(Гость);

	Ожидаем.Что(Панель <> "", "меню гостю печатается: " + Гость).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "hubmenu__account"),
		"но блока учётки в нём нет: " + Панель).Равно(0);
	// вход в панели печатает КИТ, хаб его дорогой не дублирует
	Ожидаем.Что(СтрЧислоВхождений(Панель, "href=""/login"""),
		"вход в панели ровно один: " + Панель).Равно(1);
	Ожидаем.Что(СтрЧислоВхождений(Панель, "href=""/packages"""),
		"и дорога хаба в панели одна, а не парой: " + Панель).Равно(1);
	Ожидаем.Что(СтрНайти(Гость, "action=""/logout"""),
		"а выходить ему неоткуда: " + Гость).Равно(0);
	Ожидаем.Что(СтрНайти(Гость, "href=""/me"""),
		"и дел вошедшего у него нет: " + Гость).Равно(0);

КонецПроцедуры

// Меню на странице ОДНО: бургер узкого экрана, кнопка-учётка широкого и крест внутри
// панели открывают одну и ту же панель. Второй экземпляр панели означал бы вторую копию
// пунктов в разметке, а кнопка, целящаяся мимо, — меню, которое не открывается.
&Тест
Процедура ТриКнопкиЕдиногоМенюОткрываютОднуПанель() Экспорт

	Страница = СтраницаВошедшего("alice", Ложь);

	Ожидаем.Что(СтрЧислоВхождений(Страница, "class=""hubmenu"" id="),
		"панель меню на странице одна").Равно(1);

	Ид = МеждуМаркеров(Страница, "class=""hubmenu"" id=""", """");
	Ожидаем.Что(ЗначениеЗаполнено(Ид), "у панели есть идентификатор связи: " + Страница).ЭтоИстина();

	Ожидаем.Что(СтрЧислоВхождений(Страница, "popovertarget=""" + Ид + """"),
		"её открывают ровно три кнопки: бургер, учётка и крест").Равно(3);
	Ожидаем.Что(СтрЧислоВхождений(Страница, "popovertarget="""),
		"и других кнопок верхнего слоя на странице нет").Равно(3);

КонецПроцедуры

// Человек должен видеть, где он стоит: текущая дорога в меню и в рейке помечена
// aria-current. Горит РОВНО ОДНА: «Кабинет» (/me) на экране уведомлений светился бы
// вместе с «Уведомлениями», а «Каталог» — вместе с «Моими пакетами».
&Тест
Процедура ТекущаяДорогаВМенюГоритОднаИТаСамая() Экспорт

	Проверки = Новый Соответствие();
	Проверки.Вставить("/packages", "Каталог");
	Проверки.Вставить("/packages?mine=1", "Мои пакеты");
	Проверки.Вставить("/me", "Кабинет");
	Проверки.Вставить("/me/notifications", "Уведомления");
	Проверки.Вставить("/me/settings/tokens", "Настройки аккаунта");
	Проверки.Вставить("/hub/settings/people", "Настройки хаба");

	Для Каждого Проверка Из Проверки Цикл

		Панель = ПанельМеню(СтраницаПоАдресу("root", Истина, Проверка.Ключ));
		Активные = ПодписиАктивных(Панель);

		Ожидаем.Что(Активные, "на " + Проверка.Ключ + " горит ровно одна дорога: " + Активные)
			.Равно(Проверка.Значение);

	КонецЦикла;

	// адрес, которому в меню не соответствует ничего, не зажигает ближайшую дорогу
	Ожидаем.Что(ПодписиАктивных(ПанельМеню(СтраницаПоАдресу("root", Истина, "/tour"))),
		"на чужом адресе не горит ничего").Равно("");

КонецПроцедуры

// Кто из накрывших адрес точнее: сперва длина пути, и лишь при равных путях — параметры
// запроса. Правильный ответ НЕ последний в списке: подсветка, раздающая признак всем
// подряд, зажгла бы именно последнего.
&Тест
Процедура ТочнееТотЧейПутьДлиннееАПриРавныхПутяхТотЧтоСПараметром() Экспорт

	Ожидаем.Что(ГоритНаПути("/me/settings/tokens", "/me/settings/tokens,/me"),
		"длинный путь точнее короткого").Равно("/me/settings/tokens");

	Ожидаем.Что(ГоритНаПути("/packages?mine=1", "/packages?mine=1,/packages"),
		"при равных путях побеждает требующий параметр").Равно("/packages?mine=1");

	// параметр — требование, а не украшение: на голом адресе горит дорога без него
	Ожидаем.Что(ГоритНаПути("/packages", "/packages?mine=1,/packages"),
		"без параметра горит дорога, которая его не требует").Равно("/packages");

	// лишние параметры запроса требованию не мешают
	Ожидаем.Что(ГоритНаПути("/packages?mine=1&page=2", "/packages?mine=1,/packages"),
		"страница и поиск требованию не мешают").Равно("/packages?mine=1");

КонецПроцедуры

// Накрытие считается по СЕГМЕНТАМ, а не по началу строки: иначе «Кабинет» горел бы
// на «/menu», а «Настройки хаба» — на «/hub/settings-backup».
&Тест
Процедура НакрытиеАдресаСчитаетсяПоСегментам() Экспорт

	Ожидаем.Что(ГоритНаПути("/menu", "/me"), "«/me» не накрывает «/menu»").Равно("");
	Ожидаем.Что(ГоритНаПути("/hub/settings-backup", "/hub/settings"),
		"«/hub/settings» не накрывает «/hub/settings-backup»").Равно("");

	Ожидаем.Что(ГоритНаПути("/hub/settings/people", "/hub/settings"),
		"а свой раздел дорога накрывает").Равно("/hub/settings");
	Ожидаем.Что(ГоритНаПути("/me/", "/me"),
		"хвостовая косая адрес не меняет").Равно("/me");

	// корень накрыл бы весь хаб разом, поэтому совпадает только сам с собой
	Ожидаем.Что(ГоритНаПути("/packages", "/"), "корень не накрывает весь хаб").Равно("");
	Ожидаем.Что(ГоритНаПути("/", "/"), "но сам себя — накрывает").Равно("/");

КонецПроцедуры

// Экраны приватной части собирает РендерерКабинета, и путь до обрамления идёт через него:
// потеряй он путь — в кабинете не горело бы ничего никогда.
&Тест
Процедура РендерерКабинетаДоводитПутьДоМеню() Экспорт

	Страница = Кабинет.Страница("Кабинет", "<p>тело</p>",
		Кабинет.КонтекстСтраницы(Новый Структура("Логин", "alice"), Неопределено, Ложь, "/me"));

	Ожидаем.Что(ПодписиАктивных(ПанельМеню(Страница)),
		"на /me через рендерер кабинета горит «Кабинет»").Равно("Кабинет");

КонецПроцедуры

// Бейдж означает «есть что разобрать»: ноль читался бы как «что-то есть». Мест у бейджа
// два — бургер узкого экрана и кнопка-учётка широкого, — и при нуле дел его нет НИГДЕ.
// Граф рендера собран без ленты и без рассмотрения, поэтому ждать здесь нечего.
&Тест
Процедура БезЖдущихДелБейджаНетНиНаБургереНиНаУчётке() Экспорт

	Страница = СтраницаВошедшего("alice", Ложь);

	Ожидаем.Что(СтрНайти(ШапкаСтраницы(Страница), "button__count"),
		"числа в шапке нет ни на одной кнопке: " + Страница).Равно(0);
	Ожидаем.Что(СтрНайти(ПанельМеню(Страница), "button__count"),
		"и в панели меню его нет: " + Страница).Равно(0);
	Ожидаем.Что(РамкаВошедшего("alice", Ложь).МенюХаба.Счётчик,
		"и само обрамление подаёт ноль").Равно(0);

КонецПроцедуры

// Разделы ТЕКУЩЕГО экрана знает не инсталляция, а страница, поэтому они приезжают каркасу
// отдельным аргументом. Без этой секции человек с телефона не ушёл бы из раздела в раздел:
// колонка разделов на узком экране не показывается.
&Тест
Процедура РазделыЭкранаЕдутВМенюОтдельнойСекцией() Экспорт

	Разделы = Новый Массив();
	Разделы.Добавить(Новый Структура("Подпись, Адрес, Иконка, Активен",
		"Токены", "/me/settings/tokens", "ключ", Истина));

	Панель = ПанельМеню(UI.Каркас.Страница("Настройки", Кит.Примечание("тело"),
		КонтекстВошедшего("alice", Ложь), Разделы));

	Ожидаем.Что(СтрНайти(Панель, "href=""/me/settings/tokens""") > 0,
		"раздел экрана достижим из меню: " + Панель).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "aria-current=""true""") > 0,
		"текущий раздел помечен: " + Панель).ЭтоИстина();

	Ожидаем.Что(СтрНайти(ПанельМеню(СтраницаВошедшего("alice", Ложь)), "Разделы экрана"),
		"на экране без своих разделов секции нет").Равно(0);

КонецПроцедуры

// Страница хаба глазами гостя: ни имени, ни дел — только дороги хаба и ход ко входу.
Функция СтраницаГостя()

	Возврат UI.Каркас.Страница("Каталог", Кит.Примечание("тело"),
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено));

КонецФункции

// Страница хаба глазами вошедшего: публичная, если админских дорог не спрашивали.
Функция СтраницаВошедшего(Знач Логин, Знач ПоказатьАдмин)

	Возврат UI.Каркас.Страница("Каталог", Кит.Примечание("тело"),
		КонтекстВошедшего(Логин, ПоказатьАдмин));

КонецФункции

Функция РамкаВошедшего(Знач Логин, Знач ПоказатьАдмин)
	Возврат UI.Обрамление.Обрамление(КонтекстВошедшего(Логин, ПоказатьАдмин));
КонецФункции

// Шапка страницы: она стоит первой и кончается на своём закрывающем теге.
Функция ШапкаСтраницы(Знач Страница)
	Возврат МеждуМаркеров(Страница, "<header", "</header>");
КонецФункции

// Панель единого меню: она стоит до содержимого страницы, поэтому кончается там, где
// начинается <main>. Дорога, найденная вне панели, дороги ИЗ МЕНЮ не доказывает.
Функция ПанельМеню(Знач Страница)
	Возврат МеждуМаркеров(Страница, "<div class=""hubmenu""", "<main");
КонецФункции

// Страница хаба, открытая по конкретному адресу: путь запроса приносит контекст, и по нему
// меню решает, что подсветить.
Функция СтраницаПоАдресу(Знач Логин, Знач ПоказатьАдмин, Знач Путь)

	Возврат UI.Каркас.Страница("Экран", Кит.Примечание("тело"),
		UI.Каркас.КонтекстСтраницы(Новый Структура("Логин", Логин), Неопределено,
			ПоказатьАдмин, Ложь, Путь));

КонецФункции

// Подписи пунктов, помеченных текущими: aria-current стоит на самом пункте, а его текст —
// в первом безатрибутном <span> внутри (в спане с атрибутом живёт бейдж).
Функция ПодписиАктивных(Знач Панель)

	Результат = Новый Массив();
	Маркер = "aria-current=""true""";

	Хвост = Панель;
	Позиция = СтрНайти(Хвост, Маркер);
	Пока Позиция > 0 Цикл
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Результат.Добавить(МеждуМаркеров(Хвост, "<span>", "</span>"));
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

	Возврат СтрСоединить(Результат, ", ");

КонецФункции

// Адрес пункта, который подсветка пометила текущим на этом пути; пусто — не помечен ни
// один. Пункты перечисляются адресами через запятую, и правильный ответ в списке НЕ
// последний: подсветка, раздающая признак всем подряд, зажигала бы именно последнего.
Функция ГоритНаПути(Знач Путь, Знач Адреса)

	Пункты = Новый Массив();
	Для Каждого Адрес Из СтрРазделить(Адреса, ",") Цикл
		Пункты.Добавить(Новый Структура("Подпись, Адрес, Иконка", Адрес, Адрес, "пакет"));
	КонецЦикла;

	UI.Подсветка.ОтметитьТекущую(Путь, Пункты, Новый Массив());

	Горящие = Новый Массив();
	Для Каждого Пункт Из Пункты Цикл
		Если Пункт.Свойство("Активен") И Пункт.Активен = Истина Тогда
			Горящие.Добавить(Пункт.Адрес);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Горящие, ", ");

КонецФункции

Функция КонтекстВошедшего(Знач Логин, Знач ПоказатьАдмин)

	Возврат UI.Каркас.КонтекстСтраницы(Новый Структура("Логин", Логин), Неопределено,
		ПоказатьАдмин);

КонецФункции

Функция ОшибкаДобавления(Знач Холст, Знач Ребёнок)

	Попытка
		Холст.Добавить(Ребёнок);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция МеждуМаркеров(Знач Текст, Знач Начало, Знач Конец)

	Открытие = СтрНайти(Текст, Начало);
	Если Открытие = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Открытие + СтрДлина(Начало));
	Закрытие = СтрНайти(Хвост, Конец);
	Возврат ?(Закрытие = 0, Хвост, Лев(Хвост, Закрытие - 1));

КонецФункции

#КонецОбласти
