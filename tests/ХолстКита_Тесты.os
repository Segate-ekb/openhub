// Слой элементов UI-кита: экран собирается деревом узлов, а разметку печатает кит.
// Проверяется поведение, которое ломается для человека: порядок на экране, экранирование
// чужого текста, признаки для скрипта страницы, отказ формы без CSRF и отказ узла, внутрь
// которого класть нельзя.

#Использовать asserts
#Использовать "фикстуры"

Перем UI;    // СборкаUI — граф компонентов и рендереров
Перем Кит;   // Кит — фабрика элементов экрана

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));
	Кит = UI.Кит;

КонецПроцедуры

#Область СоставДерева

// Порядок на экране — это состав дерева, а не арифметика строк: ребёнок печатается
// ВНУТРИ родителя и в том порядке, в каком его положили.
&Тест
Процедура РебёнокПечатаетсяВнутриРодителяИВПорядкеДобавления() Экспорт

	Ряд = Кит.Ряд("выбор");
	Ряд.Добавить(Кит.Надпись("название")).Добавить(Кит.Текст("первый"));
	Ряд.Добавить(Кит.Надпись("сноска")).Добавить(Кит.Текст("второй"));

	HTML = Ряд.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "первый") > 0 И СтрНайти(HTML, "второй") > 0,
		"оба ребёнка напечатаны: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "первый") < СтрНайти(HTML, "второй"),
		"порядок на экране равен порядку добавления: " + HTML).ЭтоИстина();

	Внутри = МеждуМаркеров(HTML, "<div", "</div>");
	Ожидаем.Что(СтрНайти(Внутри, "первый") > 0,
		"ребёнок лежит ВНУТРИ родителя, а не рядом с ним: " + HTML).ЭтоИстина();

КонецПроцедуры

// «Из чего собран этот экран» отвечается объектом, а не чтением одиннадцати файлов.
&Тест
Процедура ДеревоЭкранаПечатаетсяРодамиИВидами() Экспорт

	Раскрывашка = Кит.Раскрывашка();
	Раскрывашка.Шапка().Добавить(Кит.Надпись("название")).Добавить(Кит.Код("имя"));
	Раскрывашка.Добавить(Кит.Примечание("пояснение"));
	Раскрывашка.Добавить(Кит.Кнопка(Новый Структура("Подпись", "Сохранить")));

	Дерево = Раскрывашка.Дерево();
	Строки = СтрРазделить(СокрЛП(Дерево), Символы.ПС, Ложь);

	Ожидаем.Что(СокрЛП(Строки[0]), "корень назван родом").Равно("раскрывашка");
	Ожидаем.Что(СтрНайти(Дерево, "надпись[название]") > 0,
		"вид узла виден в дереве: " + Дерево).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Дерево, "компонент[кнопка]") > 0,
		"компонент назван, а не безымянный кусок HTML: " + Дерево).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Дерево, "код") > 0, "лист дерева виден: " + Дерево).ЭтоИстина();

КонецПроцедуры

// Шапка раскрывашки и её тело — РАЗНЫЕ холсты: содержимое, положенное в тело, не должно
// уезжать в свёрнутую строку и наоборот.
&Тест
Процедура ШапкаИТелоРаскрывашкиНеПеремешиваются() Экспорт

	Узел = Кит.Раскрывашка();
	Узел.Шапка().Добавить(Кит.Текст("свёрнуто"));
	Узел.Добавить(Кит.Текст("развёрнуто"));

	HTML = Узел.Рендер();
	Свёрнутое = МеждуМаркеров(HTML, "<summary", "</summary>");

	Ожидаем.Что(СтрНайти(Свёрнутое, "свёрнуто") > 0,
		"шапка напечатана в summary: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Свёрнутое, "развёрнуто"),
		"тело в шапку не протекло: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "развёрнуто") > 0,
		"а само тело на месте: " + HTML).ЭтоИстина();

КонецПроцедуры

// Элемент, положенный внутрь второго родителя, исчез бы с первого места молча.
&Тест
Процедура ЭлементНеКладётсяВДваМестаИНеКладётсяВСебя() Экспорт

	Первый = Кит.Холст();
	Второй = Кит.Холст();
	Общий = Кит.Надпись("");
	Первый.Добавить(Общий);

	Ожидаем.Что(ОшибкаДобавления(Второй, Общий),
		"элемент уже лежит внутри другого").Заполнено();

	Гнездо = Кит.Холст();
	Первый.Добавить(Гнездо);
	Ожидаем.Что(ОшибкаДобавления(Гнездо, Первый),
		"предок, положенный в потомка, дал бы бесконечную печать").Заполнено();

КонецПроцедуры

// Лист дерева печатает себя целиком, внутрь него класть нечего — и об этом говорят
// словами, а не молча теряют вложенное.
&Тест
Процедура ЛистДереваВнутрьСебяНеПускает() Экспорт

	Ожидаем.Что(ОшибкаДобавления(Кит.Текст("значение"), Кит.Надпись("")),
		"текстовый узел холстом не бывает").Заполнено();
	Ожидаем.Что(ОшибкаДобавления(Кит.Картинка("/static/x.svg", "значок"), Кит.Надпись("")),
		"картинка холстом не бывает").Заполнено();
	Ожидаем.Что(ОшибкаДобавления(Кит.Кнопка(Новый Структура("Подпись", "Сохранить")),
		Кит.Надпись("")), "готовый компонент холстом не бывает").Заполнено();

	// КОНТРОЛЬ: раскладочный узел внутрь пускает, иначе проверка выше зелена всегда
	Ожидаем.Что(ОшибкаДобавления(Кит.Холст(), Кит.Надпись("")),
		"холст вложенное принимает").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ЭкранированиеИВид

// Экранирование структурно: текстовый узел иначе печатать не умеет, и «не забыл ли автор
// экранировать» перестаёт быть вопросом.
&Тест
Процедура ТекстовыйУзелЭкранируетсяПоСвоейПрироде() Экспорт

	Злое = "<script>alert(1)</script>";

	Надпись = Кит.Надпись("название");
	Надпись.Добавить(Кит.Текст(Злое));
	HTML = Надпись.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<script"), "чужой текст разметкой не стал: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;script&gt;") > 0,
		"он напечатан текстом: " + HTML).ЭтоИстина();

	// и то же самое внутри машинного значения
	Код = Кит.Код(Злое).Рендер();
	Ожидаем.Что(СтрНайти(Код, "<script"), "и в <code> тоже: " + Код).Равно(0);

КонецПроцедуры

// Сырой узел ОДИН, назван явно и существует только ради перехода: пока экраны переводятся
// по одному, непереведённый кусок обязан куда-то ложиться.
&Тест
Процедура ГотовыйФрагментПечатаетсяКакЕстьИЭтоЕдинственнаяТакаяДверь() Экспорт

	HTML = Кит.Готовое("<b>жирным</b>").Рендер();
	Ожидаем.Что(HTML, "готовый фрагмент печатается как есть").Равно("<b>жирным</b>");

	// та же строка, положенная текстом, разметкой не становится
	Текстом = Кит.Текст("<b>жирным</b>").Рендер();
	Ожидаем.Что(СтрНайти(Текстом, "<b>"), "текстовый узел эту дверь не открывает").Равно(0);

КонецПроцедуры

// Вид — значение из закрытого набора кита, а не имя CSS-класса. Опечатка в виде обязана
// останавливать сборку: иначе экран приезжает без оформления, и виноватым выглядит CSS.
&Тест
Процедура НеизвестныйВидОстанавливаетСборкуИВКлассНеПротекает() Экспорт

	Отказ = "";
	Попытка
		Проба = Кит.Надпись("tag--accent");
		Проба = Проба;
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Отказ, "вид вне набора кита отбит").Заполнено();
	Ожидаем.Что(СтрНайти(Отказ, "tag--accent") > 0, "названо, что именно отбито: " + Отказ)
		.ЭтоИстина();

	// КОНТРОЛЬ: вид из набора проходит и даёт СВОЙ класс, а не пустой
	HTML = Кит.Надпись("пояснение").Рендер();
	Ожидаем.Что(СтрНайти(HTML, "class=") > 0, "известный вид даёт класс: " + HTML).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область КонтрактСБраузером

// data-признак печатается ДАЖЕ ПУСТЫМ: по нему скрипт страницы находит набор полей,
// и у набора с пустым ключом (это «свой провайдер») пропавший `data-…=""` тихо выключает
// переключение — без единой ошибки в журнале.
&Тест
Процедура ПризнакПечатаетсяДажеСПустымЗначением() Экспорт

	HTML = Кит.Группа("", "набор").Признак("set", "").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "data-set=""""") > 0,
		"пустой признак напечатан, скрипту есть за что взять узел: " + HTML).ЭтоИстина();

	Заполненный = Кит.Группа("", "набор").Признак("set", "github").Рендер();
	Ожидаем.Что(СтрНайти(Заполненный, "data-set=""github""") > 0,
		"и заполненный тоже: " + Заполненный).ЭтоИстина();

КонецПроцедуры

// Отключённый набор браузер не отправляет, не пускает в него фокус и не держит на нём
// обязательность; скрытый — не занимает места. Обе пометки едут вместе.
&Тест
Процедура ОтключённыйИСкрытыйНаборНесётОбеПометки() Экспорт

	HTML = Кит.Группа("", "набор").Отключить().Скрыть().Рендер();

	Ожидаем.Что(СтрНайти(HTML, " disabled") > 0, "набор отключён: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, " hidden") > 0, "и скрыт: " + HTML).ЭтоИстина();

	Открытый = Кит.Группа("", "набор").Рендер();
	Ожидаем.Что(СтрНайти(Открытый, "disabled"), "КОНТРОЛЬ: обычный набор рабочий").Равно(0);
	Ожидаем.Что(СтрНайти(Открытый, "hidden"), "КОНТРОЛЬ: и видимый").Равно(0);

КонецПроцедуры

// Форма без CSRF-токена выглядит рабочей и гарантированно получает 403. Такую форму
// собрать нельзя вовсе — гарантия перенесена из памяти автора в кит.
&Тест
Процедура ФормаБезТокенаНеСобирается() Экспорт

	Отказ = "";
	Попытка
		Проба = Кит.Форма("/hub/settings/providers", "");
		Проба = Проба;
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Отказ, "форма без токена отбита").Заполнено();

	HTML = Кит.Форма("/hub/settings/providers", "т0кен", "столбик").Рендер();
	Ожидаем.Что(СтрНайти(HTML, "name=""_csrf""") > 0,
		"а с токеном скрытое поле на месте: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "value=""т0кен""") > 0,
		"и в нём именно токен сессии: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "action=""/hub/settings/providers""") > 0,
		"и адрес действия: " + HTML).ЭтоИстина();

КонецПроцедуры

// Пустой адрес значка не должен давать битой картинки: у провайдера без значка на экране
// пусто, а не сломанное изображение.
&Тест
Процедура КартинкаБезАдресаНеПечатается() Экспорт

	Ожидаем.Что(Кит.Картинка("", "значок").Рендер(), "битого <img> нет").Равно("");
	Ожидаем.Что(СтрНайти(Кит.Картинка("/static/github.svg", "значок").Рендер(),
		"src=""/static/github.svg""") > 0, "КОНТРОЛЬ: заданный значок печатается").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Каркас страницы принадлежит киту, а СВОИ адреса, знак и подпись хаб подаёт ему
// обрамлением инсталляции. Ломается для человека прямо: ход на главную ведёт в никуда,
// вкладка называется чужим именем, выход не работает.
&Тест
Процедура ОбрамлениеХабаПодаётКаркасуСвоиАдресаЗнакИПодпись() Экспорт

	HTML = UI.Каркас.Страница("Каталог", Кит.Примечание("тело"),
		UI.Каркас.КонтекстСтраницы(Новый Структура("Логин", "alice"), Неопределено));

	Ожидаем.Что(СтрНайти(HTML, "<title>Каталог — OpenHub</title>") > 0,
		"вкладка названа знаком хаба: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<a href=""/"" class=""brand""") > 0,
		"ход на главную: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "href=""/packages""") > 0,
		"верхняя навигация ведёт в каталог: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "action=""/ui/theme""") > 0,
		"переключатель оформления на своём адресе: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "href=""/me""") > 0, "ход в кабинет: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "action=""/logout""") > 0, "выход формой: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "Открытый хаб пакетов OneScript") > 0,
		"подпись подвала: " + HTML).ЭтоИстина();

	// и ни один из этих адресов не зашит в кит: обрамление их и приносит
	Рамка = UI.Обрамление.Обрамление(
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено, Ложь, Истина));
	Ожидаем.Что(Рамка.Адреса.Выход).Равно("/logout");
	Ожидаем.Что(Рамка.Адреса.Вход).Равно("/login");

КонецПроцедуры

// Приватная часть отличается от публичной ровно навигацией кабинета: она стоит НАД
// содержимым, и «Настройки хаба» в ней видит только админ.
&Тест
Процедура НавигацияКабинетаЕстьТолькоУПриватнойСтраницы() Экспорт

	Публичная = UI.Каркас.Страница("Каталог", Кит.Примечание("тело"),
		UI.Каркас.КонтекстСтраницы(Неопределено, Неопределено));
	Ожидаем.Что(СтрНайти(Публичная, "office-nav"),
		"на публичной странице разделов кабинета нет: " + Публичная).Равно(0);

	Участник = UI.Каркас.Страница("Кабинет", Кит.Примечание("тело"),
		UI.Каркас.КонтекстСтраницы(Новый Структура("Логин", "alice"), Неопределено, Ложь, Истина));
	Ожидаем.Что(СтрНайти(Участник, "office-nav") > 0,
		"у приватной — есть: " + Участник).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Участник, "href=""/hub/settings"""),
		"а хода в настройки хаба у рядового участника нет: " + Участник).Равно(0);

	Админ = UI.Каркас.Страница("Кабинет", Кит.Примечание("тело"),
		UI.Каркас.КонтекстСтраницы(Новый Структура("Логин", "root"), Неопределено, Истина, Истина));
	Ожидаем.Что(СтрНайти(Админ, "href=""/hub/settings""") > 0,
		"админу ход в настройки хаба показан: " + Админ).ЭтоИстина();

КонецПроцедуры

Функция ОшибкаДобавления(Знач Холст, Знач Ребёнок)

	Попытка
		Холст.Добавить(Ребёнок);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция МеждуМаркеров(Знач Текст, Знач Начало, Знач Конец)

	Открытие = СтрНайти(Текст, Начало);
	Если Открытие = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Открытие + СтрДлина(Начало));
	Закрытие = СтрНайти(Хвост, Конец);
	Возврат ?(Закрытие = 0, Хвост, Лев(Хвост, Закрытие - 1));

КонецФункции

#КонецОбласти
