// Примитив сеть/ТаймаутыHTTP: сколько хаб ждёт чужой сервер. Проверяется значение —
// что ожидание апстрима приходит из настройки живым числом, а не из константы, и что
// ключ настройки один и тот же у читающего и у подсказки оператору.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем Таймауты;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "сеть", "Классы"), "ТаймаутыHTTP");
	РеестрФикстур.Подключить("НастройкиЗаглушка");

КонецПроцедуры

&ПередКаждым
Процедура СобратьТаймауты() Экспорт
	Таймауты = Новый ТаймаутыHTTP();
КонецПроцедуры

&Тест
Процедура КлючНастройкиНазванОдинРаз() Экспорт

	Ожидаем.Что(Таймауты.КлючТаймаутаАпстрима(), "ключ ожидания похода в апстрим")
		.Равно("oshub.proxy.timeout.sec");

КонецПроцедуры

&Тест
Процедура ОжиданиеАпстримаБерётсяИзНастройкиЦелым() Экспорт

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать(Таймауты.КлючТаймаутаАпстрима(), 20);
	Ожидаем.Что(Таймауты.ТаймаутАпстрима(Настройки), "значение оператора").Равно(20);

	Настройки.Задать(Таймауты.КлючТаймаутаАпстрима(), "7");
	Ожидаем.Что(Таймауты.ТаймаутАпстрима(Настройки), "строка настройки читается числом")
		.Равно(7);

КонецПроцедуры

&Тест
Процедура ОжиданиеСлужебногоЗапросаНеНастраивается() Экспорт

	Ожидаем.Что(Таймауты.ТаймаутСлужебногоЗапроса(),
		"документ ключей и проверка права ждут фиксированное время").Равно(15);

КонецПроцедуры
