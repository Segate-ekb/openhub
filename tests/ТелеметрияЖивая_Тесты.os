// Живой хаб с ВКЛЮЧЁННОЙ телеметрией и заведомо мёртвым коллектором. Офлайн-наборы
// поднять её не могут: включённость едет строкой из окружения, напильник winow
// оборачивает конвейер на старте, а спаны родятся только на настоящем запросе.

#Использовать asserts
#Использовать "фикстуры"

Перем Хаб;              // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем ВыдачаПортов;     // фикстура ВыдачаПортов — порт под коллектор берётся у ОС
Перем ПортМёртвогоКоллектора;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХабСТелеметрией() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("ВыдачаПортов");
	Хаб = Новый ЭкземплярХаба();
	Хаб.ФайловаяБаза("openhub-отел-живой");

	// Коллектор не поднимается вовсе: порт берём у выдачи и слушателя на нём не заводим.
	// Угаданный номер мог бы оказаться занятым чужим процессом, и «мёртвый коллектор»
	// перестал бы быть мёртвым — тест молча проверял бы не то (НФТ-ЭКСП-009).
	ВыдачаПортов = Новый ВыдачаПортов();
	ПортМёртвогоКоллектора = ВыдачаПортов.Выдать();

	// Значения — строками, как их приносит окружение боевой инсталляции. Строковое "true"
	// это и есть тот случай, на котором фасад и напильник winow расходились.
	Хаб.Среда("OTEL_ENABLED", "true");
	Хаб.Среда("OTEL_SERVICE_NAME", "openhub-живой-тест");
	Хаб.Среда("OTEL_EXPORTER_OTLP_ENDPOINT",
		"http://127.0.0.1:" + Формат(ПортМёртвогоКоллектора, "ЧГ=0"));
	// Секрет коллектора — только из окружения; в журнал он попасть не должен.
	Хаб.Среда("OTEL_EXPORTER_OTLP_HEADERS", "Authorization=Bearer SEKRET-ЖИВОЙ-XYZ");

	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура УбратьХаб() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;

	Если ВыдачаПортов <> Неопределено Тогда
		ВыдачаПортов.ВернутьВсе();
	КонецЕсли;

КонецПроцедуры

// Мост окружения: строковое "true" обязано включить трассировку у ФАСАДА, а не только
// у напильника. Расхождение этих двоих даёт полтелеметрии — каркас трассирует,
// а доменные спаны не заводятся, и в трассе нет ни публикации, ни доставки.
&Тест
Процедура СтроковыйФлагОкруженияВключаетТелеметриюХаба() Экспорт

	Хаб.ДождатьсяСтрокиЖурнала("OTel: трассировка включена", 30);

	Ожидаем.Что(СтрНайти(Хаб.Дамп(), "OTel: трассировка выключена"),
		"фасад не должен считать себя выключенным при OTEL_ENABLED=true").Равно(0);

КонецПроцедуры

// Напильник winow оборачивает конвейер только при otel.enabled, а спан родится лишь
// на настоящем запросе. Дошедший до экспорта спан доказывает всю цепочку разом:
// мост окружения → напильник → SDK → фоновый экспорт.
//
// ⚠ Признак «конвейер дошёл» — путь /v1/traces в ТЕКСТЕ ОШИБКИ чужого SDK. Снаружи
// другого сигнала нет: коллектора нет по замыслу, а своего счётчика экспорта хаб больше
// не держит. Апстрим сменит формулировку — тест не покраснеет, а повиснет до таймаута
// ожидания строки; читать такой отказ надо как «сигнал устарел», а не «телеметрия сломана».
&Тест
Процедура ЗапросРождаетСпанИКонвейерДоходитДоЭкспорта() Экспорт

	Ожидаем.Что(ОтветНаЗдоровье("").КодСостояния, "хаб отвечает при включённой телеметрии").Равно(200);

	// Мёртвый коллектор отвечает отказом соединения — значит спаны до него дошли.
	Хаб.ДождатьсяСтрокиЖурнала("/v1/traces", 60);

КонецПроцедуры

// Входящий traceparent — чужой ввод на горячем пути. Разбирает его winow; хаб обязан
// пережить и валидный, и заведомо мусорный, отвечая одинаково верно.
&Тест
Процедура ВходящийTraceparentНеМешаетОтвету() Экспорт

	Валидный = "00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01";
	Ожидаем.Что(ОтветНаЗдоровье(Валидный).КодСостояния,
		"запрос с валидным traceparent обслужен").Равно(200);

	// Мусор — только ASCII: не-ASCII в заголовке отвергает сам 1connector на нашей стороне,
	// и до хаба такой запрос не доедет вовсе (ЗНАНИЕ §4).
	Ожидаем.Что(ОтветНаЗдоровье("not-a-traceparent").КодСостояния,
		"запрос с мусорным traceparent обслужен, а не отвергнут").Равно(200);

	Ожидаем.Что(ОтветНаЗдоровье("00-" + Сверхдлинный()).КодСостояния,
		"сверхдлинный traceparent не роняет запрос").Равно(200);

КонецПроцедуры

// НФТ-ЭКСП-008: секрет коллектора живёт только в окружении и в журнал не попадает.
// Офлайн это проверяется на файле настроек; живьём — на журнале работающего хаба,
// который уже успел сходить к коллектору и получить отказ.
//
// ⚠ Ожидание /v1/traces здесь — тот же хрупкий сигнал чужого SDK, что и выше.
&Тест
Процедура СекретКоллектораВЖурналеЖивогоХабаНеПоявляется() Экспорт

	Хаб.ДождатьсяСтрокиЖурнала("/v1/traces", 60);

	Ожидаем.Что(СтрНайти(Хаб.Дамп(), "SEKRET-ЖИВОЙ-XYZ"),
		"секрет коллектора в журнале живого хаба").Равно(0);

КонецПроцедуры

// М-5: имя сэмплера инъектируется деталькой в main.os, а не лежит в поставочном файле —
// штатный деплой монтирует файл оператора поверх, и доля выборки умирала бы молча.
// Проверяется единственным наблюдаемым снаружи способом: доля 0.0 обязана отсечь ВСЁ.
// Без инъекции SDK взял бы ParentBased(AlwaysOn), долю проигнорировал и спаны уехали бы.
&Тест
Процедура ДоляНольОтсекаетТрассыБезИмениСэмплераВОкружении() Экспорт

	Второй = Новый ЭкземплярХаба();
	Второй.ФайловаяБаза("openhub-отел-доля");
	Второй.Среда("OTEL_ENABLED", "true");
	Второй.Среда("OTEL_SERVICE_NAME", "openhub-доля-ноль");
	Второй.Среда("OTEL_EXPORTER_OTLP_ENDPOINT",
		"http://127.0.0.1:" + Формат(ВыдачаПортов.Выдать(), "ЧГ=0"));
	// Имя сэмплера НЕ задаём: его обязана дать инъекция main.os.
	Второй.Среда("OTEL_TRACES_SAMPLER_ARG", "0.0");

	Попытка
		Второй.Запустить();

		// Положительный контроль: хаб жив и запросы обслуживает, спанам было из чего родиться.
		Для Счёт = 1 По 5 Цикл
			Запрос = Новый HTTPЗапрос("/health");
			Ожидаем.Что(Второй.Соединение().Получить(Запрос).КодСостояния,
				"хаб с нулевой долей обслуживает запросы").Равно(200);
		КонецЦикла;

		// Партия уезжает раз в otel.bsp.schedule.delay (5 с). Ждём заведомо дольше:
		// при работающей инъекции отсылать нечего, и /v1/traces не появится никогда.
		ПодождатьПартии(15);

		Ожидаем.Что(СтрНайти(Второй.Дамп(), "/v1/traces"),
			"при доле 0.0 трассы не уезжают — значит инъекция сэмплера на месте").Равно(0);
	Исключение
		Второй.Остановить();
		ВызватьИсключение;
	КонецПопытки;

	Второй.Остановить();

КонецПроцедуры

#Область Служебное

// Ожидание партии фонового экспорта: своего сигнала «партия ушла» снаружи нет.
Процедура ПодождатьПартии(Знач Секунд)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + Секунд * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Приостановить(500);
	КонецЦикла;

КонецПроцедуры

Функция Сверхдлинный()

	Буква = "a";
	Пока СтрДлина(Буква) < 4000 Цикл
		Буква = Буква + Буква;
	КонецЦикла;

	Возврат Буква;

КонецФункции

Функция ОтветНаЗдоровье(Знач Traceparent)

	Запрос = Новый HTTPЗапрос("/health");
	Если ЗначениеЗаполнено(Traceparent) Тогда
		Запрос.Заголовки.Вставить("traceparent", Traceparent);
	КонецЕсли;

	Возврат Хаб.Соединение().Получить(Запрос);

КонецФункции

#КонецОбласти
