// Общий хаб группы для scripts/тесты.sh: «поднять <группа>» поднимает хаб по ГруппыХабов, печатает
// порт, PID и каталог и выходит, хаб живёт дальше; «остановить <pid> [<каталог>]» гасит его и чистит.

#Использовать "../фикстуры"

Процедура Поднять(Знач Группа)

	Описание = ГруппыХабов.Описание(Группа);

	РеестрФикстур.Подключить("ЭкземплярХаба");
	Хаб = Новый ЭкземплярХаба(90);
	Хаб.ВестиЖурналВФайле();
	Каталог = ОбщийХаб.Поднять(Хаб, Описание);

	// поднятый хаб живёт и после выхода инструмента: без напечатанного PID его никто не погасит
	Попытка
		Порт = Формат(Хаб.Порт(), "ЧГ=0; ЧН=0");

		Запись = Новый ЗаписьТекста(ОбъединитьПути(Каталог, "хаб.порт"), КодировкаТекста.UTF8NoBOM);
		Запись.Записать(Порт);
		Запись.Закрыть();

		Сообщить("переменная: " + ГруппыХабов.ПеременнаяАдреса(Описание.Имя));
		Сообщить("порт: " + Порт);
		Сообщить("pid: " + Формат(Хаб.ИдентификаторПроцесса(), "ЧГ=0; ЧН=0"));
		Сообщить("каталог: " + Каталог);
		Сообщить("журнал: " + Хаб.ФайлЖурнала());
	Исключение
		Хаб.Остановить();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Гасит хаб по PID и убирает его каталог и заявку порта; каталог пуст — только PID. Ложь — PID жив,
// но это не хаб этого репозитория: процесс не тронут.
Функция Остановить(Знач PID, Знач Каталог)

	Тронут = Ложь;
	Чужой = Ложь;
	Если НЕ Новый РегулярноеВыражение("^[0-9]+$").Совпадает(PID) Тогда
		Сообщить(СтрШаблон("pid «%1» не число — процесс не тронут", PID));
		Чужой = Истина;
	ИначеЕсли Жив(PID) И НЕ НашХаб(PID) Тогда
		Сообщить(СтрШаблон("pid %1 — не хаб этого репозитория (%2), процесс не тронут", PID, ТочкаВходаХаба()));
		Чужой = Истина;
	ИначеЕсли Жив(PID) Тогда
		Команда("kill " + PID);
		Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10 * 1000;
		Пока Жив(PID) И ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
			Приостановить(100);
		КонецЦикла;
		Если Жив(PID) И НашХаб(PID) Тогда
			Команда("kill -9 " + PID);
		КонецЕсли;
		Тронут = Истина;
	КонецЕсли;

	Если ЗначениеЗаполнено(Каталог) Тогда
		ФайлПорта = ОбъединитьПути(Каталог, "хаб.порт");
		Если Новый Файл(ФайлПорта).Существует() Тогда
			Чтение = Новый ЧтениеТекста(ФайлПорта, КодировкаТекста.UTF8);
			Порт = СокрЛП(Чтение.Прочитать());
			Чтение.Закрыть();
			РеестрФикстур.Подключить("ВыдачаПортов");
			Заявка = Новый ВыдачаПортов().ПутьЗаявки(Число(Порт));
			Если Новый Файл(Заявка).Существует() Тогда
				УдалитьФайлы(Заявка);
			КонецЕсли;
		КонецЕсли;
		Если Новый Файл(Каталог).Существует() Тогда
			УникальныеИмена.УбратьВременное(Каталог);
		КонецЕсли;
	КонецЕсли;

	Сообщить(СтрШаблон("%1: pid %2, каталог %3", ?(Чужой, "не тронут", ?(Тронут, "остановлен", "уже не жил")),
		PID, ?(ЗначениеЗаполнено(Каталог), Каталог, "не назван")));

	Возврат НЕ Чужой;

КонецФункции

Функция Жив(Знач PID)
	Возврат Команда("kill -0 " + PID) = 0;
КонецФункции

// PID мог достаться чужому процессу: сигнал — только процессу с точкой входа хаба в командной строке.
Функция НашХаб(Знач PID)

	Процесс = СоздатьПроцесс("ps -o command= -p " + PID, , Истина);
	Процесс.Запустить();
	Процесс.ОжидатьЗавершения();
	Возврат СтрНайти(Процесс.ПотокВывода.Прочитать(), ТочкаВходаХаба()) > 0;

КонецФункции

// Та же, с которой фикстура поднимает хаб.
Функция ТочкаВходаХаба()
	РеестрФикстур.Подключить("ЭкземплярХаба");
	Возврат Новый ЭкземплярХаба().ТочкаВхода();
КонецФункции

Функция Команда(Знач Строка)
	Процесс = СоздатьПроцесс(Строка, , Истина);
	Процесс.Запустить();
	Процесс.ОжидатьЗавершения();
	Возврат Процесс.КодВозврата;
КонецФункции

Если АргументыКоманднойСтроки.Количество() = 2 И АргументыКоманднойСтроки[0] = "поднять" Тогда
	Попытка
		Поднять(АргументыКоманднойСтроки[1]);
	Исключение
		Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗавершитьРаботу(1);
	КонецПопытки;
ИначеЕсли (АргументыКоманднойСтроки.Количество() = 2 ИЛИ АргументыКоманднойСтроки.Количество() = 3)
	И АргументыКоманднойСтроки[0] = "остановить" Тогда
	Каталог = ?(АргументыКоманднойСтроки.Количество() = 3, АргументыКоманднойСтроки[2], "");
	Если НЕ Остановить(АргументыКоманднойСтроки[1], Каталог) Тогда
		ЗавершитьРаботу(1);
	КонецЕсли;
Иначе
	Сообщить("Использование: oscript tests/инструменты/хаб-группы.os поднять <группа>"
		+ " | остановить <pid> [<каталог>]");
	ЗавершитьРаботу(2);
КонецЕсли;
