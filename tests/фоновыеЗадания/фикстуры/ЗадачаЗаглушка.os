// Задача планировщика для тестов: одно интервальное расписание под заданным именем,
// прогон отдаётся обработчику — счётчику либо падающему.

Перем Имя_;
Перем ИнтервалСек_;
Перем Обработчик_;

// Контракт ЗадачаПланировщика: одна интервальная регистрация.
//
// Параметры:
//  Регистрации - РегистрацииЗадачи - куда записывается регистрация.
//
Процедура Зарегистрировать(Регистрации) Экспорт
	Регистрации.КаждыеСекунд(Имя_, ИнтервалСек_);
КонецПроцедуры

// Контракт ЗадачаПланировщика: прогон уходит обработчику.
//
Процедура Исполнить() Экспорт
	Обработчик_.Исполнить();
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач Имя, Знач ИнтервалСек, Знач Обработчик)
	Имя_ = Имя;
	ИнтервалСек_ = ИнтервалСек;
	Обработчик_ = Обработчик;
КонецПроцедуры
