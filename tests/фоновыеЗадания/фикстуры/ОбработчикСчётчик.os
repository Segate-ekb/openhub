// Обработчик задачи для тестов планировщика: контракт os-scheduler, считает вызовы и по просьбе падает.

Перем Вызовов_;
Перем Падать_;

// Контракт обработчика os-scheduler: засчитывает вызов; падающий после этого бросает исключение.
//
Процедура Исполнить() Экспорт

	Вызовов_ = Вызовов_ + 1;

	Если Падать_ Тогда
		ВызватьИсключение "ОбработчикСчётчик: намеренный сбой задачи";
	КонецЕсли;

КонецПроцедуры

// Число вызовов Исполнить.
//
// Возвращаемое значение:
//  Число.
//
Функция Вызовов() Экспорт
	Возврат Вызовов_;
КонецФункции

Процедура ПриСозданииОбъекта(Знач Падать = Ложь)
	Вызовов_ = 0;
	Падать_ = Падать;
КонецПроцедуры
