// Фикстура: планировщик приложения на ручных часах — на нём задачи модулей проверяют своё
// расписание без живого хаба, а движок фона — диспетчеризацию.

#Использовать autumn-logos

Перем Поиск;           // фикстура КлассыСлоя
Перем КаталогМодулей;

// Планировщик приложения с названными задачами на ручных часах. Ещё не настроен: исполнитель
// можно подменить до Настроить(); тик — ЭкземплярПланировщика().Тик().
//
// Параметры:
//  Задачи - Массив - задачи планировщика.
//  Часы - ЧасыРучные - часы, которыми тест двигает время.
//
// Возвращаемое значение:
//  ПланировщикПриложения - планировщик на этих часах.
//
Функция Планировщик(Знач Задачи, Знач Часы) Экспорт

	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы"), "ГотовностьХаба");

	Пл = Новый ПланировщикПриложения(Задачи, Новый ГотовностьХаба(Лог()),
		Новый ЖурналФоновыхЗадач(Лог()), 10, Истина, Лог());
	Пл.УстановитьЧасы(Часы);
	Возврат Пл;

КонецФункции

// Журнал для задач, которые его просят параметром конструктора.
//
// Возвращаемое значение:
//  Лог - журнал тестов планировщика.
//
Функция Лог() Экспорт
	Возврат Логирование.ПолучитьЛог("тест.oshub.старт");
КонецФункции

Процедура ПриСозданииОбъекта()

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЧасыРучные");
	Поиск = Новый КлассыСлоя();
	КаталогМодулей = КаталогиПроекта.Модули();

	Поиск.ПодключитьОснову(КаталогМодулей);
	КаталогЗадач = ОбъединитьПути(КаталогМодулей, "фоновыеЗадания", "Классы");
	Для Каждого Имя Из СтрРазделить("ФоновыйЦикл,ПланировщикПриложения,ЖурналФоновыхЗадач,"
		+ "ЗадачаПодЖурналом,РегистрацииЗадачи", ",") Цикл
		Поиск.Подключить(КаталогЗадач, Имя);
	КонецЦикла;

КонецПроцедуры
