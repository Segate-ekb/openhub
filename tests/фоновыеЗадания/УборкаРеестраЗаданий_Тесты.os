// Уборка реестра заданий платформы оставляет его пустым и называет в отладке, сколько записей сняла.
// Отдельный процесс: реестр заданий один на процесс.

#Использовать asserts
#Использовать autumn-logos
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогЗадач_;
Перем КаталогМодулей_;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогМодулей_ = КаталогиПроекта.Модули();
	КаталогЗадач_ = ОбъединитьПути(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания"), "Классы");

КонецПроцедуры

&ПередВсеми
Процедура ЗарегистрироватьТипы() Экспорт

	ПоискКлассов.ПодключитьОснову(КаталогМодулей_);
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогЗадач_, "РеестрЗаданийПлатформы.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогЗадач_, "ЗадачаУборкиРеестраЗаданий.os"));
	РеестрФикстур.Подключить("ЛовушкаЛога");

КонецПроцедуры

// Завершённое задание платформа из реестра не убирает сама: реестр растёт на каждое
// задание и пустеет только шагом уборки. Ради этого шаг и заведён.
&Тест
Процедура ОтработавшиеЗаданияЛежатВРеестреПокаИхНеУберут() Экспорт

	Реестр = Новый РеестрЗаданийПлатформы();
	Реестр.Очистить();

	ВыполнитьКороткихЗаданий(5);

	Ожидаем.Что(Реестр.Размер() >= 5,
		СтрШаблон("отработавшие задания остались в реестре, записей %1", Реестр.Размер())).ЭтоИстина();

	НоваяУборка(Реестр, ЛогТестов()).Исполнить();

	Ожидаем.Что(Реестр.Размер(), "после шага уборки реестр пуст").Равно(0);

КонецПроцедуры

// Оператор обязан видеть, ЧТО именно выросло: без числа строка «прошла уборка» не говорит
// ни о размере утечки, ни о том, работает ли уборка вообще.
&Тест
Процедура УборкаНазываетРазмерРеестраДоСебя() Экспорт

	Реестр = Новый РеестрЗаданийПлатформы();
	Реестр.Очистить();
	ВыполнитьКороткихЗаданий(3);
	Было = Реестр.Размер();

	Ловушка = Новый ЛовушкаЛога();
	НоваяУборка(Реестр, ЛогТестов(Ловушка)).Исполнить();

	Ожидаем.Что(Ловушка.Всё(), "размер реестра до уборки назван в отладке")
		.Содержит("записей до уборки " + Строка(Было));

КонецПроцедуры

// Хаб, которому нечего убирать, — норма простаивающей инсталляции: шаг обязан пройти
// молча и назвать ноль, а не сорваться на пустом реестре.
&Тест
Процедура УборкаПустогоРеестраПроходитИНазываетНоль() Экспорт

	Реестр = Новый РеестрЗаданийПлатформы();
	Реестр.Очистить();

	Ловушка = Новый ЛовушкаЛога();
	НоваяУборка(Реестр, ЛогТестов(Ловушка)).Исполнить();

	Ожидаем.Что(Ловушка.Всё(), "пустой реестр назван нулём").Содержит("записей до уборки 0");
	Ожидаем.Что(Реестр.Размер(), "и после уборки он по-прежнему пуст").Равно(0);

КонецПроцедуры

#Область Служебное

Функция НоваяУборка(Знач Реестр, Знач Лог)
	Возврат Новый ЗадачаУборкиРеестраЗаданий(Реестр, Лог);
КонецФункции

// Задания подбираются самые короткие, какие есть: доказывается судьба ЗАПИСИ о задании,
// а не работа внутри него.
Процедура ВыполнитьКороткихЗаданий(Знач Сколько)

	Задания = Новый Массив();
	Для Номер = 1 По Сколько Цикл
		Аргументы = Новый Массив();
		Аргументы.Добавить(Номер);
		Задания.Добавить(ФоновыеЗадания.Выполнить(Новый Массив(), "Добавить", Аргументы));
	КонецЦикла;

	ФоновыеЗадания.ОжидатьВсе(Задания, 60000);

КонецПроцедуры

// Лог с ловушкой, когда тест смотрит написанное, и обычный, когда не смотрит.
Функция ЛогТестов(Знач Ловушка = Неопределено)

	Если Ловушка = Неопределено Тогда
		Возврат Логирование.ПолучитьЛог("тест.oshub.уборка");
	КонецЕсли;

	Лог = Логирование.ПолучитьЛог("тест.oshub.уборка." + Строка(Новый УникальныйИдентификатор()));
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка, УровниЛога.Отладка);

	Возврат Лог;

КонецФункции

#КонецОбласти
