// Журнал фоновых задач: состав объявлен целиком, прогон виден стартом и исходом на отладке, упавшая
// задача не выдаёт себя за успешную, смерть фонового цикла не пропадает молча.

#Использовать asserts
#Использовать autumn-logos
#Использовать os-scheduler
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогМодулей_;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	КаталогМодулей_ = КаталогиПроекта.Модули();

КонецПроцедуры

&ПередВсеми
Процедура ЗарегистрироватьТипы() Экспорт
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ФоновыйЦикл.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ПланировщикПриложения.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ЖурналФоновыхЗадач.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ЗадачаПодЖурналом.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "РегистрацииЗадачи.os"));
	ПоискКлассов.ПодключитьОснову(КаталогМодулей_);
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогМодулей_, "наблюдаемость", "Классы", "пробы"),
		"ГотовностьХаба.os"));
	РеестрФикстур.Подключить("ОбработчикСчётчик");
	РеестрФикстур.Подключить("ЧасыРучные");
	РеестрФикстур.Подключить("ЧасыПадающие");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("ЗадачаЗаглушка");
КонецПроцедуры

#Область СоставЗадач

// Оператор читает состав задач из журнала: задача, которой в объявлении нет, для него
// не существует. Сверяется не с рукописным списком, а с реестром самого планировщика.
&Тест
Процедура ОбъявленныйСоставСовпадаетСРеестромПланировщика() Экспорт

	Мир = НовыйМир("состав", УровниЛога.Информация, Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0)));
	Мир.Планировщик.Настроить();

	Необъявленные = Новый Массив();
	Для Каждого Запись Из Мир.Планировщик.ЭкземплярПланировщика().Состояния() Цикл
		Если СтрНайти(Мир.Ловушка.Всё(), Запись.Ключ) = 0 Тогда
			Необъявленные.Добавить(Запись.Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Мир.Планировщик.ЭкземплярПланировщика().Состояния().Количество(),
		"планировщик поднял все задачи, которые ему отдали").Равно(ЗадачМира());
	Ожидаем.Что(СтрСоединить(Необъявленные, ", "),
		"задачи, которых оператор в журнале старта не увидит: " + Мир.Ловушка.Всё()).Равно("");

КонецПроцедуры

// Задачи объявляют их модули, и контейнер отдаёт их в своём порядке — на другой машине
// в другом. Оператор, сравнивающий журналы двух стартов, видит состав по именам.
&Тест
Процедура СоставВЖурналеИдётПоИменамЗадач() Экспорт

	Мир = НовыйМир("порядок", УровниЛога.Информация, Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0)));
	Мир.Планировщик.Настроить();

	Журнал = Мир.Ловушка.Всё();
	Позиции = Новый Массив();
	Для Каждого Имя Из СтрРазделить("gc-кэша-прокси,сброс-статистики,уборка-реестра-заданий", ",") Цикл
		Позиции.Добавить(СтрНайти(Журнал, СтрШаблон("Фоновая задача ""%1""", Имя)));
	КонецЦикла;

	Ожидаем.Что(Позиции[0] > 0 И Позиции[1] > Позиции[0] И Позиции[2] > Позиции[1],
		"задачи объявлены в порядке имён, а не в порядке массива: " + Журнал).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПрогоныЗадач

// Прогон полезен, но шумит на каждый проход, — значит ОТЛАДКА: поднявший подробность
// этого журнала видит старт и исход, а обычная консоль хаба ими не засоряется.
&Тест
Процедура ПрогонЗадачиВиденСтартомИЗавершениемНаОтладке() Экспорт

	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));
	Мир = НовыйМир("прогон", УровниЛога.Отладка, Часы);
	Мир.Планировщик.Настроить();
	ДоПрогона = Мир.Ловушка.Количество();

	Часы.Прибавить(60);
	Мир.Планировщик.ЭкземплярПланировщика().Тик();

	Ожидаем.Что(Мир.Обработчики.Статистика.Вызовов(), "задача действительно отработала").Равно(1);

	Старт = Мир.Ловушка.Сообщение(ДоПрогона);
	Исход = Мир.Ловушка.Сообщение(ДоПрогона + 1);
	Ожидаем.Что(Мир.Ловушка.Количество() - ДоПрогона,
		"прогон дал ровно две записи — старт и исход").Равно(2);
	Ожидаем.Что(СтрНайти(Старт, "сброс-статистики") > 0 И СтрНайти(Старт, "стартовала") > 0,
		"первая запись — старт задачи: " + Старт).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Исход, "сброс-статистики") > 0 И СтрНайти(Исход, "отработала") > 0,
		"вторая запись — её завершение: " + Исход).ЭтоИстина();

КонецПроцедуры

// Молчащий сбой неотличим от неработающего планировщика — самый дорогой из режимов
// отказа: хаб выглядит живым, а задача не делает ничего много суток подряд.
&Тест
Процедура УпавшаяЗадачаВиднаСТекстомОшибкиИНеСчитаетсяУспешной() Экспорт

	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));
	Мир = НовыйМир("сбой", УровниЛога.Информация, Часы, ПадающийОбработчик());

	Мир.Планировщик.Настроить();
	Часы.Прибавить(60);
	Мир.Планировщик.ЭкземплярПланировщика().Тик();

	Состояние = Мир.Планировщик.ЭкземплярПланировщика().Состояние("сброс-статистики");
	Ожидаем.Что(Состояние.статус, "исключение обёртка не проглотила").Равно("ошибка");
	Ожидаем.Что(Состояние.успехов, "упавший прогон не засчитан успехом").Равно(0);
	Ожидаем.Что(СтрНайти(Мир.Ловушка.Всё(), "ОбработчикСчётчик: намеренный сбой задачи") > 0,
		"текст ошибки обработчика дошёл до оператора: " + Мир.Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

// Уровень прогонов не переключается из хаба: на ИНФОРМАЦИИ их нет никогда, а сбой
// остаётся ОШИБКОЙ — то есть виден и там.
&Тест
Процедура НаИнформацииПрогоновНетАСбойВиден() Экспорт

	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));
	Мир = НовыйМир("тихо", УровниЛога.Информация, Часы, ПадающийОбработчик());
	Мир.Планировщик.Настроить();
	ДоПрогона = Мир.Ловушка.Количество();

	Часы.Прибавить(60);
	Мир.Планировщик.ЭкземплярПланировщика().Тик();
	Записано = Мир.Ловушка.Сообщение(ДоПрогона);

	// Ровно одна запись на упавший прогон: старт и исход ушли на ОТЛАДКУ, сбой остался.
	Ожидаем.Что(Мир.Ловушка.Количество() - ДоПрогона,
		"на ИНФОРМАЦИИ прогон оставляет в консоли одну запись — сбой").Равно(1);
	Ожидаем.Что(СтрНайти(Записано, "ОбработчикСчётчик: намеренный сбой задачи") > 0,
		"сбой виден и без поднятой подробности: " + Записано).ЭтоИстина();

КонецПроцедуры

// Успешный прогон на уровне информации не пишет ничего: строка о старте задачи — шум.
&Тест
Процедура НаИнформацииУспешныйПрогонМолчит() Экспорт

	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));
	Мир = НовыйМир("молча", УровниЛога.Информация, Часы);
	Мир.Планировщик.Настроить();
	ДоПрогона = Мир.Ловушка.Количество();

	Часы.Прибавить(60);
	Мир.Планировщик.ЭкземплярПланировщика().Тик();

	Ожидаем.Что(Мир.Обработчики.Статистика.Вызовов(), "задача действительно отработала").Равно(1);
	Ожидаем.Что(Мир.Ловушка.Количество() - ДоПрогона,
		"успешный прогон на ИНФОРМАЦИИ не пишет ни строки: " + Мир.Ловушка.Всё()).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ЖивучестьЦикла

// ОСень фоновую рогатку с ОжидатьЗавершения = Ложь не дожидается: без перехвата внутри цикл
// умирает, не оставив в журнале ни строки, а хаб продолжает отвечать 200.
&Тест
Процедура СмертьФоновогоЦиклаПопадаетВЖурнал() Экспорт

	Мир = НовыйМир("цикл", УровниЛога.Информация, Новый ЧасыПадающие());

	Мир.Планировщик.ПриЗапускеПриложения();

	Ожидаем.Что(СтрНайти(Мир.Ловушка.Всё(), "ЧасыПадающие: намеренный сбой источника времени") > 0,
		"причина смерти фонового цикла названа: " + Мир.Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Обвязка

// Планировщик хаба на ручных часах с ловушкой журнала.
Функция НовыйМир(Знач Прозвище, Знач Уровень, Знач Часы, Знач ЗадачаСтатистики = Неопределено)

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.задачи." + Прозвище);
	// Уровень журнала: то, чего тут нет, оператор в консоли не увидит.
	Лог.УстановитьУровень(Уровень);
	Лог.ДобавитьСпособВывода(Ловушка);

	Обработчики = Новый Структура("Статистика", ?(ЗадачаСтатистики = Неопределено,
		Новый ОбработчикСчётчик(), ЗадачаСтатистики));

	// порядок массива нарочно не алфавитный: так контейнер и отдаёт задачи модулей
	Задачи = Новый Массив();
	Задачи.Добавить(Новый ЗадачаЗаглушка("уборка-реестра-заданий", 999999, Новый ОбработчикСчётчик()));
	Задачи.Добавить(Новый ЗадачаЗаглушка("сброс-статистики", 60, Обработчики.Статистика));
	Задачи.Добавить(Новый ЗадачаЗаглушка("gc-кэша-прокси", 999999, Новый ОбработчикСчётчик()));

	// порядок аргументов — порядок параметров конструктора: задачи, готовность, журнал задач,
	// шаг опроса, выключатель, журнал
	Планировщик = Новый ПланировщикПриложения(Задачи, Новый ГотовностьХаба(Лог), Новый ЖурналФоновыхЗадач(Лог),
		10, Истина, Лог);
	Планировщик.УстановитьЧасы(Часы);

	Возврат Новый Структура("Планировщик, Ловушка, Обработчики", Планировщик, Ловушка, Обработчики);

КонецФункции

// Обработчик, который засчитывает вызов и роняет каждый запуск.
Функция ПадающийОбработчик()
	Возврат Новый ОбработчикСчётчик(Истина);
КонецФункции

// Сколько задач отдаёт планировщику НовыйМир.
Функция ЗадачМира()
	Возврат 3;
КонецФункции

#КонецОбласти
