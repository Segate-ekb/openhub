// Юнит-тесты ПланировщикаПриложения на ручных часах: расписание, изоляция ошибки задачи,
// грациозная остановка, политика перекрытия и уборка реестра фоновых заданий.

#Использовать asserts
#Использовать autumn-logos
#Использовать os-scheduler
#Использовать "../фикстуры"

Перем Стенд;   // фикстура ПланировщикНаЧасах — планировщик приложения на ручных часах

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ЗарегистрироватьТипы() Экспорт

	РеестрФикстур.Подключить("ПланировщикНаЧасах");
	Стенд = Новый ПланировщикНаЧасах();

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогиПроекта.Модули(), "фоновыеЗадания", "Классы"),
		"ЗадачаУборкиРеестраЗаданий");

	Для Каждого Имя Из СтрРазделить("ОбработчикСчётчик,ВыполнениеРучное,ИсполнительРучной,ЗадачаЗаглушка,"
		+ "РеестрЗаданийЗаглушка", ",") Цикл
		РеестрФикстур.Подключить(Имя);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ЗадачиРегистрируютсяИСрабатываютПоРасписанию() Экспорт

	Стат = Новый ОбработчикСчётчик();
	GC = Новый ОбработчикСчётчик();
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));

	Пл = Стенд.Планировщик(ДвеЗадачи(Стат, GC, 60, 120), Часы);
	Пл.Настроить();
	Планировщик = Пл.ЭкземплярПланировщика();

	Ожидаем.Что(Планировщик.Состояния().Количество(), "зарегистрированы обе задачи").Равно(2);
	Ожидаем.Что(Планировщик.Запущен(), "планировщик запущен").ЭтоИстина();

	Часы.Прибавить(60);
	Планировщик.Тик();
	Ожидаем.Что(Стат.Вызовов(), "сброс-статистики (интервал 60) сработал").Равно(1);
	Ожидаем.Что(GC.Вызовов(), "gc (интервал 120) ещё не наступил").Равно(0);

	Часы.Прибавить(60); // t0+120
	Планировщик.Тик();
	Ожидаем.Что(GC.Вызовов(), "gc (интервал 120) сработал").Равно(1);
	Ожидаем.Что(Стат.Вызовов(), "сброс-статистики сработал повторно").Равно(2);

КонецПроцедуры

&Тест
Процедура СбойОднойЗадачиНеРоняетПрочиеИПланировщик() Экспорт

	Стат = Новый ОбработчикСчётчик();
	GC = ПадающийОбработчик();
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));

	Пл = Стенд.Планировщик(ДвеЗадачи(Стат, GC, 60, 60), Часы);
	Пл.Настроить();
	Планировщик = Пл.ЭкземплярПланировщика();

	Часы.Прибавить(60);
	Планировщик.Тик();

	Ожидаем.Что(GC.Вызовов(), "падающая задача была вызвана").Равно(1);
	Ожидаем.Что(Планировщик.Состояние("gc-кэша-прокси").статус, "её статус — ошибка").Равно("ошибка");
	Ожидаем.Что(Стат.Вызовов(), "соседняя задача отработала несмотря на сбой gc").Равно(1);
	Ожидаем.Что(Планировщик.Запущен(), "планировщик продолжает работу").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ГрациознаяОстановкаSyncПрекращаетДиспетчеризацию() Экспорт

	Стат = Новый ОбработчикСчётчик();
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));

	Пл = Стенд.Планировщик(ДвеЗадачи(Стат, Новый ОбработчикСчётчик(), 60, 120), Часы);
	Пл.Настроить();
	Планировщик = Пл.ЭкземплярПланировщика();

	Активных = Пл.Остановить();
	Ожидаем.Что(Активных, "синхронный исполнитель не оставляет активных").Равно(0);
	Ожидаем.Что(Планировщик.Запущен(), "после остановки не запущен").ЭтоЛожь();

	Часы.Прибавить(600);
	Планировщик.Тик();
	Ожидаем.Что(Стат.Вызовов(), "после остановки новые задачи не диспетчеризуются").Равно(0);

КонецПроцедуры

&Тест
Процедура ГрациознаяОстановкаДорабатываетИдущиеAsync() Экспорт

	Стат = Новый ОбработчикСчётчик();
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));
	Ручной = Новый ИсполнительРучной();

	Пл = Стенд.Планировщик(ДвеЗадачи(Стат, Новый ОбработчикСчётчик(), 60, 120), Часы);
	Пл.УстановитьИсполнитель(Ручной);
	Пл.Настроить();
	Планировщик = Пл.ЭкземплярПланировщика();

	Часы.Прибавить(60);
	Планировщик.Тик(); // задача стартовала, но не завершилась (async)
	Ожидаем.Что(Планировщик.Активных() >= 1, "есть идущее выполнение").ЭтоИстина();

	Активных = Пл.Остановить();
	Ожидаем.Что(Активных >= 1, "грациозная остановка отдаёт число идущих").ЭтоИстина();

	Ручной.ЗавершитьВсеУспехом();
	Планировщик.Тик(); // финализируем завершившиеся
	Ожидаем.Что(Планировщик.Активных(), "после доработки идущих активных не осталось").Равно(0);

КонецПроцедуры

&Тест
Процедура ПерекрытиеПропуститьНеЗапускаетПовторноПокаЗадачаИдёт() Экспорт

	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));
	Ручной = Новый ИсполнительРучной();
	Счётчик = Новый ОбработчикСчётчик();

	Планировщик = Новый Планировщик(Новый Структура("Исполнитель, Часы", Ручной, Часы));
	Планировщик.Зарегистрировать("j", Расписания.Интервал(60), Счётчик,
		Новый Структура("ПолитикаПерекрытия", "пропустить"));
	Планировщик.Запустить();

	Часы.Прибавить(60);
	Планировщик.Тик(); // старт (async, идёт)
	Ожидаем.Что(Ручной.ВызововЗапуска(), "первый запуск").Равно(1);

	Часы.Прибавить(60);
	Планировщик.Тик(); // предыдущий ещё идёт -> пропустить
	Ожидаем.Что(Ручной.ВызововЗапуска(), "перекрытие пропущено, повторного запуска нет").Равно(1);

	Ручной.ЗавершитьВсеУспехом();
	Часы.Прибавить(60);
	Планировщик.Тик(); // теперь свободен и настал момент -> запуск
	Ожидаем.Что(Ручной.ВызововЗапуска(), "после освобождения задача снова запущена").Равно(2);

КонецПроцедуры

// Реестр фоновых заданий платформы отработавшие задания не отпускает, поэтому уборка
// обязана стоять в расписании — и ровно с тем шагом, который назвала настройка хаба.
&Тест
Процедура УборкаРеестраЗаданийИдётШагомИзНастройки() Экспорт

	Реестр = Новый РеестрЗаданийЗаглушка();
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));
	Задачи = Новый Массив();
	Задачи.Добавить(Новый ЗадачаУборкиРеестраЗаданий(Реестр, Стенд.Лог(), 30));
	Пл = Стенд.Планировщик(Задачи, Часы);
	Пл.Настроить();
	Планировщик = Пл.ЭкземплярПланировщика();

	Ожидаем.Что(Планировщик.Состояние("уборка-реестра-заданий") <> Неопределено,
		"задача уборки реестра зарегистрирована под своим именем").ЭтоИстина();

	Часы.Прибавить(29);
	Планировщик.Тик();
	Ожидаем.Что(Реестр.Уборок(), "до шага настройки уборка не идёт").Равно(0);

	Часы.Прибавить(1); // t0+30
	Планировщик.Тик();
	Ожидаем.Что(Реестр.Уборок(), "шаг настройки настал — уборка прошла").Равно(1);

	Часы.Прибавить(30); // t0+60
	Планировщик.Тик();
	Ожидаем.Что(Реестр.Уборок(), "и повторяется тем же шагом").Равно(2);

КонецПроцедуры

#Область Обвязка

// Обработчик, который засчитывает вызов и роняет каждый запуск.
Функция ПадающийОбработчик()
	Возврат Новый ОбработчикСчётчик(Истина);
КонецФункции

Функция ДвеЗадачи(Знач Стат, Знач GC, Знач ИнтервалСтат, Знач ИнтервалGC)
	Задачи = Новый Массив();
	Задачи.Добавить(Новый ЗадачаЗаглушка("сброс-статистики", ИнтервалСтат, Стат));
	Задачи.Добавить(Новый ЗадачаЗаглушка("gc-кэша-прокси", ИнтервалGC, GC));
	Возврат Задачи;
КонецФункции

#КонецОбласти
