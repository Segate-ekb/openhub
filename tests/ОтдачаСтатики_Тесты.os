// Адрес /static объявлен неизменяемым на год, поэтому отказ по нему опаснее самого отказа:
// осевший в общем кэше 404 переживёт причину. Здесь проверяется, что обе ветки отказа —
// имя вне белого списка и пропавший с диска файл — уносят кэш-заголовки с собой.

#Использовать asserts
#Использовать oscript-ui
#Использовать "фикстуры"

Перем Контроллер;
Перем Активы;
Перем Ответ;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("СловарьТекстовЗаглушка");
	РеестрФикстур.Подключить("АктивыСтатикиЗаглушка");

	Поиск = Новый КлассыСлоя();
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Модули = ОбъединитьПути(Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя, "src", "модули");

	Поиск.ПодключитьОснову(Модули);
	Поиск.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "ОтветыAPI");
	Поиск.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "ОтветНеНайдено");
	Поиск.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "КонтроллерСтатики");

КонецПроцедуры

&ПередКаждым
Процедура СобратьКонтроллер() Экспорт

	Словарь = Новый СловарьТекстовЗаглушка();
	Словарь.Положить("public.static.notfound", "not found");

	Кэш = Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP());
	Активы = Новый АктивыСтатикиЗаглушка();
	Ответ = Новый ОтветСтраницыЗаглушка();

	Контроллер = Новый КонтроллерСтатики(
		Активы,
		Новый ОтветыAPI(Новый ЗаголовкиHTTP()),
		Кэш,
		Неопределено,
		Новый ОтветНеНайдено(Кэш, Новый ТекстыИнтерфейса(Словарь)));

КонецПроцедуры

// Имя, которого нет в белом списке, — самый частый отказ: так выглядит адрес без
// отпечатка и адрес с чужим отпечатком.
&Тест
Процедура ИмяВнеБелогоСпискаОтдаётсяБезКэшЗаголовков() Экспорт

	Контроллер.Отдать(Ответ, "openhub.css", Новый Соответствие());

	Ожидаем.Что(Ответ.Код, "имени в списке нет — 404").Равно(404);
	Ожидаем.Что(Ответ.Заголовок("Cache-Control"), "отказ хранить нельзя").Равно("no-store");
	Ожидаем.Что(Ответ.Заголовок("ETag"), "и валидатора у отказа нет").Равно("");
	Ожидаем.Что(Ответ.ТелоТекст, "тело — текст отказа").Равно("not found");

КонецПроцедуры

// Вторая ветка отказа срабатывает ПОСЛЕ того, как на ответ встали годовой срок жизни
// и метка: файл объявлен списком, а на диске его нет. Не сняв их, хаб научил бы общий
// кэш отвечать 404 за себя — на год и на все последующие запросы этого адреса.
&Тест
Процедура ПропавшийСДискаФайлНеОтравляетОбщийКэш() Экспорт

	Активы.Объявить("openhub-0123456789abcdef.css", "text/css; charset=utf-8", """отпечаток""",
		ОбъединитьПути(КаталогВременныхФайлов(), "такого-файла-нет-" + Строка(Новый УникальныйИдентификатор)));

	Контроллер.Отдать(Ответ, "openhub-0123456789abcdef.css", Новый Соответствие());

	Ожидаем.Что(Ответ.Код, "файла на диске нет — 404").Равно(404);
	Ожидаем.Что(Ответ.Заголовок("Cache-Control"), "годовой срок жизни снят вместе с отказом")
		.Равно("no-store");
	Ожидаем.Что(Ответ.Заголовок("ETag"), "и метка снята: по ней кэш переспросил бы и получил 404")
		.Равно("");

КонецПроцедуры

// КОНТРОЛЬ: найденный файл живёт по прежним правилам — вечный кэш и 304 по метке.
&Тест
Процедура НайденныйФайлОстаётсяНеизменяемымИОтвечает304() Экспорт

	Метка = """отпечаток""";
	Активы.Объявить("openhub-0123456789abcdef.css", "text/css; charset=utf-8", Метка,
		Новый Файл(ТекущийСценарий().Источник).ПолноеИмя);

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("If-None-Match", "W/" + Метка);
	Контроллер.Отдать(Ответ, "openhub-0123456789abcdef.css", Заголовки);

	Ожидаем.Что(Ответ.Код, "слабый валидатор той же метки → 304").Равно(304);
	Ожидаем.Что(СтрНайти(Ответ.Заголовок("Cache-Control"), "immutable") > 0,
		"найденный файл остаётся неизменяемым: " + Ответ.Заголовок("Cache-Control")).ЭтоИстина();
	Ожидаем.Что(Ответ.Заголовок("ETag"), "и несёт метку").Равно(Метка);

КонецПроцедуры
