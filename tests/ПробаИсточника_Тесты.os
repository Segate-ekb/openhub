// Юнит-тесты пробного подключения к источнику (ИСТ-АПСТ-004, НФТ-АПСТ-001): исход пробы словами,
// потолок перенаправлений на стороне хаба, выключатель пробы и память о живости источника.
// Сети в наборе нет вовсе: единственный транспорт — фейк, который на незаданный адрес
// бросает исключение, поэтому уход в настоящую сеть невозможен по построению.

#Использовать asserts
#Использовать autumn-logos

Перем КаталогПроекта;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	Подключить(ОбъединитьПути(Модули, "наблюдаемость", "Классы",
		ОбъединитьПути("журнал", "ОбезличиваниеЖурнала.os")), "ОбезличиваниеЖурнала");
	Подключить(ОбъединитьПути(Модули, "прокси", "Классы", "КлиентАпстрима.os"), "КлиентАпстрима");
	Подключить(ОбъединитьПути(Модули, "прокси", "Классы", "ПробникИсточника.os"), "ПробникИсточника");
	Подключить(ОбъединитьПути(Модули, "прокси", "Классы", "СтражАпстримов.os"), "СтражАпстримов");
	Подключить(ОбъединитьПути(КаталогТестов, "фикстуры", "ФейкТранспортИсточника.os"),
		"ФейкТранспортИсточника");
	Подключить(ОбъединитьПути(КаталогТестов, "фикстуры", "НастройкиЗаглушка.os"), "НастройкиЗаглушка");

КонецПроцедуры

#Область ИсходПробыСловами

&Тест
Процедура ОтветившийИсточникПробуПроходит() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПриАдресе("http://hub.local/download/list.txt", 200, "alpha" + Символы.ПС + "beta");

	Проба = Пробник(Транспорт).Проверить("http://hub.local/download/");

	Ожидаем.Что(Проба.Ок, "источник ответил списком пакетов — проба пройдена").ЭтоИстина();
	Ожидаем.Что(Проба.Причина, "у удачной пробы причины нет").Равно("");
	Ожидаем.Что(Транспорт.Обращения().Количество(), "проба стоит ровно одного запроса").Равно(1);

КонецПроцедуры

&Тест
Процедура НеразрешившеесяИмяНазываетСебя() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.СбойНаАдресе("http://nowhere.invalid/download/list.txt",
		"System.Net.Http.HttpRequestException: No such host is known. (nowhere.invalid:80)");

	Проба = Пробник(Транспорт).Проверить("http://nowhere.invalid/download/");

	Ожидаем.Что(Проба.Ок, "имя не разрешилось — источник не заводится").ЭтоЛожь();
	Ожидаем.Что(Проба.Причина, "названо ИМЕННО то, что не получилось").Содержит("имя не разрешилось");

КонецПроцедуры

&Тест
Процедура ОтбитоеСоединениеНазываетСебя() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.СбойНаАдресе("http://hub.local/download/list.txt",
		"System.Net.Sockets.SocketException: Connection refused (hub.local:80)");

	Проба = Пробник(Транспорт).Проверить("http://hub.local/download/");

	Ожидаем.Что(Проба.Ок, "соединение отбито — источник не заводится").ЭтоЛожь();
	Ожидаем.Что(Проба.Причина, "названа причина").Содержит("соединение отбито");

КонецПроцедуры

&Тест
Процедура ТаймаутНазываетСебяИСвойПорог() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.СбойНаАдресе("http://slow.local/download/list.txt",
		"The request was canceled due to the configured HttpClient.Timeout of 7 seconds elapsing");

	Проба = Пробник(Транспорт, 7).Проверить("http://slow.local/download/");

	Ожидаем.Что(Проба.Ок, "молчание до таймаута — источник не заводится").ЭтоЛожь();
	Ожидаем.Что(Проба.Причина, "названо, что это таймаут").Содержит("таймаут");
	Ожидаем.Что(Проба.Причина, "назван и сам порог ожидания").Содержит("7");

КонецПроцедуры

&Тест
Процедура ОтветНеПоКонтрактуOpmНазываетСебя() Экспорт

	// код не 200: список пакетов по адресу не отдают
	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПриАдресе("http://site.local/list.txt", 404, "");

	Проба = Пробник(Транспорт).Проверить("http://site.local/");

	Ожидаем.Что(Проба.Ок, "404 на list.txt — это не источник opm").ЭтоЛожь();
	Ожидаем.Что(Проба.Причина, "названо, что ответ не по контракту").Содержит("не по контракту opm");
	Ожидаем.Что(Проба.Причина, "назван и полученный код").Содержит("404");

КонецПроцедуры

&Тест
Процедура СтраницаВместоСпискаЭтоНеИсточник() Экспорт

	// 200 есть, но по адресу лежит главная страница хаба, а не каталог выдачи
	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПриАдресе("http://hub.local/list.txt", 200,
		"<!doctype html>" + Символы.ПС + "<html><body>OpenHub</body></html>");

	Проба = Пробник(Транспорт).Проверить("http://hub.local/");

	Ожидаем.Что(Проба.Ок, "разметка вместо списка — проба не пройдена").ЭтоЛожь();
	Ожидаем.Что(Проба.Причина, "человеку сказано про путь выдачи").Содержит("каталога выдачи");

КонецПроцедуры

&Тест
Процедура ПустойСписокЭтоЖивойИсточник() Экспорт

	// у свежего хаба пакетов ещё нет — это не повод отказать в заведении
	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПриАдресе("http://fresh.local/download/list.txt", 200, "");

	Ожидаем.Что(Пробник(Транспорт).Проверить("http://fresh.local/download/").Ок,
		"пустой list.txt — законный ответ живого хаба").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПотолокПеренаправлений

&Тест
Процедура ХабИдётПоLocationСамИСчитаетПереходы() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("http://hub.local/download/list.txt", "https://hub.local/download/list.txt");
	Транспорт.ПриАдресе("https://hub.local/download/list.txt", 200, "alpha");

	Проба = Пробник(Транспорт).Проверить("http://hub.local/download/");

	Ожидаем.Что(Проба.Ок, "301 http→https проба переживает").ЭтоИстина();
	Ожидаем.Что(Транспорт.Обращения().Количество(), "переход сделан хабом, отдельным запросом").Равно(2);
	Для Каждого Просили Из Транспорт.РедиректыЗапрашивались() Цикл
		Ожидаем.Что(Просили, "по Location ходит хаб, а не транспорт").ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ОтносительныйLocationРазворачиваетсяОтТекущегоАдреса() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("http://hub.local/download/list.txt", "/pub/list.txt");
	Транспорт.ПриАдресе("http://hub.local/pub/list.txt", 200, "alpha");

	Ожидаем.Что(Пробник(Транспорт).Проверить("http://hub.local/download/").Ок,
		"относительный Location разобран").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЦепочкаБезКонцаОбрываетсяПоСчётчику() Экспорт

	// без потолка запрос крутился бы вечно; потолок держит ХАБ, а не библиотека
	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("http://loop.local/download/list.txt", "http://loop.local/download/list.txt");

	Проба = Пробник(Транспорт).Проверить("http://loop.local/download/");

	Ожидаем.Что(Проба.Ок, "бесконечная цепочка — источник не заводится").ЭтоЛожь();
	Ожидаем.Что(Проба.Причина, "названа причина, а не молчание").Содержит("перенаправлений");
	Ожидаем.Что(Транспорт.Обращения().Количество(),
		"сделано ровно потолок+1 запросов (5 переходов)").Равно(6);

КонецПроцедуры

&Тест
Процедура ПотолокПеренаправленийБерётсяИзНастройки() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("http://loop.local/download/list.txt", "http://loop.local/download/list.txt");

	Проба = Пробник(Транспорт, 20, 2).Проверить("http://loop.local/download/");

	Ожидаем.Что(Проба.Ок, "цепочка длиннее потолка — отказ").ЭтоЛожь();
	Ожидаем.Что(Транспорт.Обращения().Количество(), "потолок 2 — три запроса всего").Равно(3);

КонецПроцедуры

#КонецОбласти

#Область Выключатель

&Тест
Процедура ВыключеннаяПробаНеХодитВСетьВовсе() Экспорт

	// инсталляция без выхода наружу заводит источник без пробы — и НИ ОДНОГО запроса не делает
	Транспорт = Новый ФейкТранспортИсточника();

	Проба = ПробникБезПробы(Транспорт).Проверить("http://hub.local/download/");

	Ожидаем.Что(Проба.Ок, "выключенная проба заведению не мешает").ЭтоИстина();
	Ожидаем.Что(Транспорт.Обращения().Количество(), "наружу не ушло ни одного запроса").Равно(0);

КонецПроцедуры

&Тест
Процедура ВыключательВиденПотребителю() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();

	Ожидаем.Что(Пробник(Транспорт).ПробаВключена(), "по умолчанию проба включена").ЭтоИстина();
	Ожидаем.Что(ПробникБезПробы(Транспорт).ПробаВключена(), "выключатель виден").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ПамятьОЖивости

&Тест
Процедура НеизвестныйИсточникПолучаетСвойЧестныйЗапрос() Экспорт

	Страж = НовыйСтраж();
	Апстрим = Источник("http://hub.local/download/");

	Ожидаем.Что(Страж.Допустим(Апстрим), "о непроверенном источнике ничего не известно").ЭтоИстина();
	Ожидаем.Что(Страж.Состояние(Апстрим).Известно, "и это видно как «не проверялся»").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЛежачийИсточникБольшеНеОпрашивается() Экспорт

	Страж = НовыйСтраж();
	Апстрим = Источник("http://dead.local/download/");

	Страж.ОтметитьЛежащим("http://dead.local/download/", "соединение отбито");

	Ожидаем.Что(Страж.Допустим(Апстрим), "к лежачему источнику не ходят").ЭтоЛожь();
	Ожидаем.Что(Страж.Пропустить(Апстрим), "и точка выдачи его пропускает").ЭтоЛожь();
	Ожидаем.Что(Страж.ПричинаОтказа(Апстрим),
		"«лежит» не выдаётся за «пакета нет»: причина названа").Содержит("соединение отбито");
	Ожидаем.Что(Страж.Состояние(Апстрим).Известно, "состояние известно экрану").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПоднявшийсяИсточникВозвращаетсяВРаботуСам() Экспорт

	Страж = НовыйСтраж();
	Апстрим = Источник("http://flaky.local/download/");

	Страж.ОтметитьЛежащим("http://flaky.local/download/", "источник не ответил");
	Ожидаем.Что(Страж.Допустим(Апстрим), "лежит").ЭтоЛожь();

	Страж.ОтметитьЖивым("http://flaky.local/download/");

	Ожидаем.Что(Страж.Допустим(Апстрим), "снова ответил — снова опрашивается").ЭтоИстина();
	Ожидаем.Что(Страж.Состояние(Апстрим).Живой, "и это видно на экране").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПротухшаяОтметкаСноваДаётИсточникуШанс() Экспорт

	// нулевой TTL — «память не живёт»: отметка протухает мгновенно, и лежачий источник
	// получает честный запрос вместо вечного отказа
	Страж = НовыйСтраж(0);
	Апстрим = Источник("http://dead.local/download/");

	Страж.ОтметитьЛежащим("http://dead.local/download/", "источник не ответил");

	Ожидаем.Что(Страж.Допустим(Апстрим), "протухшая отметка — это «неизвестно»").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АдресИсточникаСличаетсяБезУчётаРегистра() Экспорт

	Страж = НовыйСтраж();
	Страж.ОтметитьЛежащим("http://Hub.Local/Download/", "источник не ответил");

	Ожидаем.Что(Страж.Допустим(Источник("http://hub.local/Download/")),
		"тот же адрес в другом регистре — тот же источник").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЗабытьСбрасываетПамять() Экспорт

	Страж = НовыйСтраж();
	Страж.ОтметитьЛежащим("http://dead.local/download/", "источник не ответил");
	Страж.Забыть();

	Ожидаем.Что(Страж.Допустим(Источник("http://dead.local/download/")),
		"после сброса о источнике снова ничего не известно").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебные

Функция Пробник(Знач Транспорт, Знач Таймаут = 20, Знач Потолок = 5)
	Возврат Новый ПробникИсточника(
		Новый КлиентАпстрима(Транспорт, Настройки(Таймаут, Потолок, Истина), ЛогТестов()),
		Настройки(Таймаут, Потолок, Истина), ЛогТестов());
КонецФункции

Функция ПробникБезПробы(Знач Транспорт)
	Возврат Новый ПробникИсточника(
		Новый КлиентАпстрима(Транспорт, Настройки(20, 5, Ложь), ЛогТестов()),
		Настройки(20, 5, Ложь), ЛогТестов());
КонецФункции

Функция НовыйСтраж(Знач TTL = 300)
	Заглушка = Новый НастройкиЗаглушка();
	Заглушка.ЗадатьПрокси(20, Ложь, 60, TTL);
	Возврат Новый СтражАпстримов(Заглушка, ЛогТестов());
КонецФункции

// Источник в контракте стража — это объект с полем Url; сущность БД тут не нужна.
Функция Источник(Знач Url)
	Возврат Новый Структура("Url", Url);
КонецФункции

Функция Настройки(Знач Таймаут, Знач Потолок, Знач ПробаВключена)
	Заглушка = Новый НастройкиЗаглушка();
	Заглушка.ЗадатьПрокси(Таймаут, Ложь, 60, 300, Потолок, ПробаВключена);
	Возврат Заглушка;
КонецФункции

Процедура Подключить(Знач ПутьФайла, Знач ИмяКласса)
	Если НЕ ТипЗарегистрирован(ИмяКласса) Тогда
		ПодключитьСценарий(ПутьФайла, ИмяКласса);
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.проба");
КонецФункции

#КонецОбласти
