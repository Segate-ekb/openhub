// Юнит-тесты пробного подключения к источнику (ИСТ-АПСТ-004, ИСТ-АПСТ-006, НФТ-АПСТ-001):
// исход пробы словами, токен приватного источника, потолок перенаправлений на стороне хаба,
// выключатель пробы и память о живости источника.
// Сети в наборе нет вовсе: единственный транспорт — фейк, который на незаданный адрес
// бросает исключение, поэтому уход в настоящую сеть невозможен по построению.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогПроекта;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "наблюдаемость", "Классы",
		ОбъединитьПути("журнал", "ОбезличиваниеЖурнала.os")));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "прокси", "Классы", "СекретИсточника.os"));
	ПоискКлассов.ПодключитьОснову(Модули);
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "сеть", "Классы", "ТаймаутыHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "прокси", "Классы", "КлиентАпстрима.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "прокси", "Классы", "ПробникИсточника.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "прокси", "Классы", "СтражАпстримов.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ФейкТранспортИсточника.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "НастройкиЗаглушка.os"));

КонецПроцедуры

#Область ИсходПробыСловами

&Тест
Процедура ОтветившийИсточникПробуПроходит() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПриАдресе("http://hub.local/download/list.txt", 200, "alpha" + Символы.ПС + "beta");

	Проба = Пробник(Транспорт).Проверить("http://hub.local/download/");

	Ожидаем.Что(Проба.Успех, "источник ответил списком пакетов — проба пройдена").ЭтоИстина();
	Ожидаем.Что(Проба.Сообщение, "у удачной пробы причины нет").Равно("");
	Ожидаем.Что(Транспорт.Обращения().Количество(), "проба стоит ровно одного запроса").Равно(1);

КонецПроцедуры

&Тест
Процедура НеразрешившеесяИмяНазываетСебя() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.СбойНаАдресе("http://nowhere.invalid/download/list.txt",
		"System.Net.Http.HttpRequestException: No such host is known. (nowhere.invalid:80)");

	Проба = Пробник(Транспорт).Проверить("http://nowhere.invalid/download/");

	Ожидаем.Что(Проба.Успех, "имя не разрешилось — источник не заводится").ЭтоЛожь();
	Ожидаем.Что(Проба.Сообщение, "названо ИМЕННО то, что не получилось").Содержит("имя не разрешилось");

КонецПроцедуры

&Тест
Процедура ОтбитоеСоединениеНазываетСебя() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.СбойНаАдресе("http://hub.local/download/list.txt",
		"System.Net.Sockets.SocketException: Connection refused (hub.local:80)");

	Проба = Пробник(Транспорт).Проверить("http://hub.local/download/");

	Ожидаем.Что(Проба.Успех, "соединение отбито — источник не заводится").ЭтоЛожь();
	Ожидаем.Что(Проба.Сообщение, "названа причина").Содержит("соединение отбито");

КонецПроцедуры

&Тест
Процедура ТаймаутНазываетСебяИСвойПорог() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.СбойНаАдресе("http://slow.local/download/list.txt",
		"The request was canceled due to the configured HttpClient.Timeout of 7 seconds elapsing");

	Проба = Пробник(Транспорт, 7).Проверить("http://slow.local/download/");

	Ожидаем.Что(Проба.Успех, "молчание до таймаута — источник не заводится").ЭтоЛожь();
	Ожидаем.Что(Проба.Сообщение, "названо, что это таймаут").Содержит("таймаут");
	Ожидаем.Что(Проба.Сообщение, "назван и сам порог ожидания").Содержит("7");

КонецПроцедуры

&Тест
Процедура ОтветНеПоКонтрактуOpmНазываетСебя() Экспорт

	// код не 200: список пакетов по адресу не отдают
	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПриАдресе("http://site.local/list.txt", 404, "");

	Проба = Пробник(Транспорт).Проверить("http://site.local/");

	Ожидаем.Что(Проба.Успех, "404 на list.txt — это не источник opm").ЭтоЛожь();
	Ожидаем.Что(Проба.Сообщение, "названо, что ответ не по контракту").Содержит("не по контракту opm");
	Ожидаем.Что(Проба.Сообщение, "назван и полученный код").Содержит("404");

КонецПроцедуры

&Тест
Процедура СтраницаВместоСпискаЭтоНеИсточник() Экспорт

	// 200 есть, но по адресу лежит главная страница хаба, а не каталог выдачи
	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПриАдресе("http://hub.local/list.txt", 200,
		"<!doctype html>" + Символы.ПС + "<html><body>OpenHub</body></html>");

	Проба = Пробник(Транспорт).Проверить("http://hub.local/");

	Ожидаем.Что(Проба.Успех, "разметка вместо списка — проба не пройдена").ЭтоЛожь();
	Ожидаем.Что(Проба.Сообщение, "человеку сказано про путь выдачи").Содержит("каталога выдачи");

КонецПроцедуры

&Тест
Процедура ПустойСписокЭтоЖивойИсточник() Экспорт

	// у свежего хаба пакетов ещё нет — это не повод отказать в заведении
	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПриАдресе("http://fresh.local/download/list.txt", 200, "");

	Ожидаем.Что(Пробник(Транспорт).Проверить("http://fresh.local/download/").Успех,
		"пустой list.txt — законный ответ живого хаба").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПотолокПеренаправлений

&Тест
Процедура ХабИдётПоLocationСамИСчитаетПереходы() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("http://hub.local/download/list.txt", "https://hub.local/download/list.txt");
	Транспорт.ПриАдресе("https://hub.local/download/list.txt", 200, "alpha");

	Проба = Пробник(Транспорт).Проверить("http://hub.local/download/");

	Ожидаем.Что(Проба.Успех, "301 http→https проба переживает").ЭтоИстина();
	Ожидаем.Что(Транспорт.Обращения().Количество(), "переход сделан хабом, отдельным запросом").Равно(2);
	Для Каждого Просили Из Транспорт.РедиректыЗапрашивались() Цикл
		Ожидаем.Что(Просили, "по Location ходит хаб, а не транспорт").ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ОтносительныйLocationРазворачиваетсяОтТекущегоАдреса() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("http://hub.local/download/list.txt", "/pub/list.txt");
	Транспорт.ПриАдресе("http://hub.local/pub/list.txt", 200, "alpha");

	Ожидаем.Что(Пробник(Транспорт).Проверить("http://hub.local/download/").Успех,
		"относительный Location разобран").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

// Location всех семи форм RFC 3986 § 5.2 ведёт ровно туда, куда велит стандарт: адрес
// следующего запроса — наблюдаемая величина, её и сверяем.
#Область ФормыLocation

&Тест
Процедура АбсолютныйLocationБерётсяЦеликом() Экспорт

	Ожидаем.Что(КудаУвёл("https://other.local/pub/list.txt"),
		"абсолютный адрес не разрешается ни от чего").Равно("https://other.local/pub/list.txt");

КонецПроцедуры

&Тест
Процедура КорневойLocationСчитаетсяОтКорняУзла() Экспорт

	Ожидаем.Что(КудаУвёл("/pub/list.txt"),
		"путь от корня меняет весь путь, но не узел").Равно("http://hub.local/pub/list.txt");

КонецПроцедуры

&Тест
Процедура ОтносительныйLocationСчитаетсяОтКаталогаТекущего() Экспорт

	Ожидаем.Что(КудаУвёл("иной.txt"),
		"относительное имя ложится в каталог текущего адреса")
		.Равно("http://hub.local/download/иной.txt");

КонецПроцедуры

&Тест
Процедура ТочкиНазадВLocationСхлопываются() Экспорт

	// «../» обязан схлопнуться: приклеенный к пути он дал бы адрес, которого у источника нет
	Ожидаем.Что(КудаУвёл("../на-уровень-выше/list.txt"),
		"«../» поднимает на уровень, а не остаётся в пути")
		.Равно("http://hub.local/на-уровень-выше/list.txt");

КонецПроцедуры

&Тест
Процедура LocationБезСхемыМеняетУзел() Экспорт

	// «//хост/путь» — это смена узла при сохранённой схеме, а не путь текущего узла
	Ожидаем.Что(КудаУвёл("//другой.local/pub/list.txt"),
		"схема остаётся своя, узел становится чужим")
		.Равно("http://другой.local/pub/list.txt");

КонецПроцедуры

&Тест
Процедура LocationИзОдногоЗапросаОтбрасываетПрежний() Экспорт

	Ожидаем.Что(КудаУвёл("?страница=7"),
		"путь остаётся прежним, а прежняя строка запроса отбрасывается целиком")
		.Равно("http://hub.local/download/list.txt?страница=7");

КонецПроцедуры

&Тест
Процедура ФрагментLocationВЗапросНеЕдет() Экспорт

	// фрагмент адресует место ВНУТРИ ответа: серверу его не показывают
	Ожидаем.Что(КудаУвёл("/pub/list.txt#начало"),
		"фрагмент остаётся у клиента").Равно("http://hub.local/pub/list.txt");

КонецПроцедуры

&Тест
Процедура ЦепочкаФормРазрешаетсяШагЗаШагом() Экспорт

	// каждый следующий Location считается от адреса, на котором цепочка стоит сейчас
	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("http://hub.local/download/list.txt", "/зеркало/выдача/list.txt");
	Транспорт.ПеренаправитьС("http://hub.local/зеркало/выдача/list.txt", "../итог/list.txt");
	Транспорт.ПеренаправитьС("http://hub.local/зеркало/итог/list.txt", "//иной.local/list.txt");
	Транспорт.ПриАдресе("http://иной.local/list.txt", 200, "alpha");

	Проба = Пробник(Транспорт).Проверить("http://hub.local/download/");

	Ожидаем.Что(Проба.Успех, "цепочка из трёх форм доходит до конца").ЭтоИстина();
	Ожидаем.Что(Транспорт.Обращения()[2],
		"«../» считается от адреса второго шага").Равно("http://hub.local/зеркало/итог/list.txt");
	Ожидаем.Что(Транспорт.Обращения()[3],
		"«//узел» считается от схемы третьего шага").Равно("http://иной.local/list.txt");

КонецПроцедуры

&Тест
Процедура ТокенСудитсяПоРазрешённомуАдресу() Экспорт

	// узел решает разрешённый адрес, а не текст Location: «../» остаётся на своём узле,
	// «//чужой» уходит на другой — токен едет ровно в первом случае
	Свой = ТокенПослеПерехода("../иначе/list.txt", "http://private.local/иначе/list.txt");
	Чужой = ТокенПослеПерехода("//elsewhere.local/download/list.txt",
		"http://elsewhere.local/download/list.txt");

	Ожидаем.Что(Свой, "«../» узла не меняет — токен предъявлен").Равно("Bearer sekret-42");
	Ожидаем.Что(Чужой, "«//чужой-узел» узел меняет — токен снят").Равно("");

КонецПроцедуры

&Тест
Процедура ЯвныйСтандартныйПортУзлаНеМеняет() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("https://private.local/download/list.txt",
		"https://private.local:443/pub/list.txt");
	Транспорт.ПриАдресе("https://private.local:443/pub/list.txt", 200, "alpha");

	Пробник(Транспорт).Проверить("https://private.local/download/", "sekret-42");

	Ожидаем.Что(Транспорт.Заголовок("Authorization", 2),
		"хаб:443 и хаб — один узел").Равно("Bearer sekret-42");

КонецПроцедуры

&Тест
Процедура ЧужойПортУзелМеняет() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("https://private.local/download/list.txt",
		"https://private.local:8443/pub/list.txt");
	Транспорт.ПриАдресе("https://private.local:8443/pub/list.txt", 200, "alpha");

	Пробник(Транспорт).Проверить("https://private.local/download/", "sekret-42");

	Ожидаем.Что(Транспорт.Заголовок("Authorization", 2),
		"хаб:8443 — другой узел").Равно("");

КонецПроцедуры

&Тест
Процедура НеразбираемыйLocationПереходомНеСтановится() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("http://hub.local/download/list.txt", "http://hub.local/п|уть");

	Проба = Пробник(Транспорт).Проверить("http://hub.local/download/");

	Ожидаем.Что(Проба.Успех, "301 без разбираемой цели — источник не завёлся").ЭтоЛожь();
	Ожидаем.Что(Проба.Сообщение, "названо, чем ответил источник").Содержит("301");
	Ожидаем.Что(Транспорт.Обращения().Количество(),
		"второго запроса не было: адреса, куда идти, нет").Равно(1);

КонецПроцедуры

&Тест
Процедура ЦепочкаБезКонцаОбрываетсяПоСчётчику() Экспорт

	// без потолка запрос крутился бы вечно; потолок держит ХАБ, а не библиотека
	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("http://loop.local/download/list.txt", "http://loop.local/download/list.txt");

	Проба = Пробник(Транспорт).Проверить("http://loop.local/download/");

	Ожидаем.Что(Проба.Успех, "бесконечная цепочка — источник не заводится").ЭтоЛожь();
	Ожидаем.Что(Проба.Сообщение, "названа причина, а не молчание").Содержит("перенаправлений");
	Ожидаем.Что(Транспорт.Обращения().Количество(),
		"сделано ровно потолок+1 запросов (5 переходов)").Равно(6);

КонецПроцедуры

&Тест
Процедура ПотолокПеренаправленийБерётсяИзНастройки() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("http://loop.local/download/list.txt", "http://loop.local/download/list.txt");

	Проба = Пробник(Транспорт, 20, 2).Проверить("http://loop.local/download/");

	Ожидаем.Что(Проба.Успех, "цепочка длиннее потолка — отказ").ЭтоЛожь();
	Ожидаем.Что(Транспорт.Обращения().Количество(), "потолок 2 — три запроса всего").Равно(3);

КонецПроцедуры

#КонецОбласти

#Область Выключатель

&Тест
Процедура ВыключеннаяПробаНеХодитВСетьВовсе() Экспорт

	// инсталляция без выхода наружу заводит источник без пробы — и НИ ОДНОГО запроса не делает
	Транспорт = Новый ФейкТранспортИсточника();

	Проба = ПробникБезПробы(Транспорт).Проверить("http://hub.local/download/");

	Ожидаем.Что(Проба.Успех, "выключенная проба заведению не мешает").ЭтоИстина();
	Ожидаем.Что(Транспорт.Обращения().Количество(), "наружу не ушло ни одного запроса").Равно(0);

КонецПроцедуры

&Тест
Процедура ВыключательВиденПотребителю() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();

	Ожидаем.Что(Пробник(Транспорт).ПробаВключена(), "по умолчанию проба включена").ЭтоИстина();
	Ожидаем.Что(ПробникБезПробы(Транспорт).ПробаВключена(), "выключатель виден").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ТокенДоступаКИсточнику

// ИСТ-АПСТ-006: токен предъявляется КАЖДОМУ запросу к источнику, и проба подключения —
// такой же запрос, как перечисление и скачивание.
&Тест
Процедура ПробаПриватногоИсточникаПредъявляетТокен() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПриАдресе("http://private.local/download/list.txt", 200, "alpha");

	Проба = Пробник(Транспорт).Проверить("http://private.local/download/", "sekret-42");

	Ожидаем.Что(Проба.Успех, "источник пустил по токену").ЭтоИстина();
	Ожидаем.Что(Транспорт.Заголовок("Authorization"),
		"токен уехал заголовком авторизации").Равно("Bearer sekret-42");

КонецПроцедуры

&Тест
Процедура БезТокенаИсточникПробуетсяАнонимно() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПриАдресе("http://open.local/download/list.txt", 200, "alpha");

	Пробник(Транспорт).Проверить("http://open.local/download/");

	Ожидаем.Что(Транспорт.Заголовок("Authorization"),
		"без токена заголовка авторизации нет вовсе").Равно("");

КонецПроцедуры

// Три исхода, которые до ИСТ-АПСТ-006 выглядели одинаково: «не пустил» — это ни «пакета
// нет», ни «источник лежит». Различие структурное, а не по тексту причины.
&Тест
Процедура ОтказДоступаОтличимОтМолчанияИОтветаНеПоКонтракту() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПриАдресе("http://private.local/download/list.txt", 401);
	Транспорт.ПриАдресе("http://forbidden.local/download/list.txt", 403);
	Транспорт.ПриАдресе("http://gone.local/download/list.txt", 404);
	Транспорт.СбойНаАдресе("http://dead.local/download/list.txt", "Connection refused");

	Неавторизован = Пробник(Транспорт).Проверить("http://private.local/download/");
	Запрещён = Пробник(Транспорт).Проверить("http://forbidden.local/download/");
	Промах = Пробник(Транспорт).Проверить("http://gone.local/download/");
	Молчит = Пробник(Транспорт).Проверить("http://dead.local/download/");

	Ожидаем.Что(Неавторизован.Отказано, "401 — источник не пустил").ЭтоИстина();
	Ожидаем.Что(Неавторизован.Код, "код источника виден как есть").Равно(401);
	Ожидаем.Что(Неавторизован.Сообщение, "причина названа человеку").Содержит("источник не пустил");
	Ожидаем.Что(Запрещён.Отказано, "403 — тоже отказ доступа").ЭтоИстина();
	Ожидаем.Что(Промах.Отказано, "404 отказом доступа не считается").ЭтоЛожь();
	Ожидаем.Что(Молчит.Отказано, "молчащий источник отказом доступа не считается").ЭтоЛожь();

КонецПроцедуры

// Проба, обязанная удаться, — одно правило на все двери заведения источника: апстрим пула
// и зеркало спрашивают её вместо своей копии «не подключился — не сохраняем».
&Тест
Процедура ОбязательнаяПробаПрерываетОперациюНазваннойПричиной() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.СбойНаАдресе("http://dead.local/download/list.txt", "Connection refused");
	Транспорт.ПриАдресе("http://alive.local/download/list.txt", 200, "alpha");

	Поймано = "";
	Попытка
		Пробник(Транспорт).ТребоватьПодключение("http://dead.local/download/");
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Поймано, "неудачная проба обязана прервать операцию")
		.Содержит("не удалось подключиться");
	Ожидаем.Что(Поймано, "и назвать причину, а не промолчать").Содержит("соединение отбито");
	Ожидаем.Что(Поймано, "адрес источника в отказе назван").Содержит("http://dead.local/download/");

	// обратная сторона: удачная проба молчит, исключение — только исход неудачи
	Пробник(Транспорт).ТребоватьПодключение("http://alive.local/download/");

КонецПроцедуры

// Причина отказа зовёт человека чинить РАЗНОЕ: у анонимного источника токена нет вовсе,
// у приватного он есть, но не подошёл.
&Тест
Процедура ПричинаОтказаРазличаетЗаданныйИНезаданныйТокен() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПриАдресе("http://private.local/download/list.txt", 401);

	БезТокена = Пробник(Транспорт).Проверить("http://private.local/download/");
	СТокеном = Пробник(Транспорт).Проверить("http://private.local/download/", "sekret-42");

	Ожидаем.Что(БезТокена.Сообщение, "анонимному источнику предлагается задать токен")
		.Содержит("задайте токен доступа");
	Ожидаем.Что(СТокеном.Сообщение, "с заданным токеном разговор о другом")
		.Содержит("Токен источника задан");
	Ожидаем.Что(СтрНайти(СТокеном.Сообщение, "sekret-42"),
		"значение токена в причину не попадает").Равно(0);

КонецПроцедуры

// Токен выдан узлом, на который заведён источник; перенаправление на посторонний хост
// уводит запрос, но не секрет.
&Тест
Процедура ПереходНаЧужойУзелТокенНеУносит() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("http://private.local/download/list.txt",
		"http://elsewhere.local/download/list.txt");
	Транспорт.ПриАдресе("http://elsewhere.local/download/list.txt", 200, "alpha");

	Пробник(Транспорт).Проверить("http://private.local/download/", "sekret-42");

	Ожидаем.Что(Транспорт.Заголовок("Authorization", 1),
		"своему узлу токен предъявлен").Равно("Bearer sekret-42");
	Ожидаем.Что(Транспорт.Заголовок("Authorization", 2),
		"чужому узлу — нет").Равно("");

КонецПроцедуры

// Подъём http → https на том же хосте это тот же источник, и токен обязан доехать:
// иначе выдача чужого хаба за 301 перестала бы читаться по токену вовсе.
&Тест
Процедура ПереходВнутриУзлаТокенСохраняет() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("http://private.local/download/list.txt",
		"https://private.local/download/list.txt");
	Транспорт.ПриАдресе("https://private.local/download/list.txt", 200, "alpha");

	Пробник(Транспорт).Проверить("http://private.local/download/", "sekret-42");

	Ожидаем.Что(Транспорт.Заголовок("Authorization", 2),
		"тот же узел по https — тот же источник").Равно("Bearer sekret-42");

КонецПроцедуры

// Обратный шаг тем же узлом секрет раздевает: по http заголовок авторизации читается
// по дороге, поэтому понижение канала токен снимает так же, как чужой хост.
&Тест
Процедура ПонижениеКаналаТокенСнимает() Экспорт

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("https://private.local/download/list.txt",
		"http://private.local/download/list.txt");
	Транспорт.ПриАдресе("http://private.local/download/list.txt", 200, "alpha");

	Пробник(Транспорт).Проверить("https://private.local/download/", "sekret-42");

	Ожидаем.Что(Транспорт.Заголовок("Authorization", 1),
		"защищённому каналу токен предъявлен").Равно("Bearer sekret-42");
	Ожидаем.Что(Транспорт.Заголовок("Authorization", 2),
		"открытому — нет, даже на том же узле").Равно("");

КонецПроцедуры

// Токен — секрет: он не показывается ни формой, ни API, ни журналом. Журнал самый
// незаметный из трёх, потому что пишется отладочным уровнем и наружу не смотрит.
&Тест
Процедура ТокенНеПопадаетНиВОднуСтрокуЖурнала() Экспорт

	РеестрФикстур.Подключить("ЛовушкаЛога");
	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.проба.токен");
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка);

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("http://private.local/download/list.txt",
		"http://elsewhere.local/download/list.txt");
	Транспорт.ПриАдресе("http://elsewhere.local/download/list.txt", 401);

	Попытка
		ПробникСЛогом(Транспорт, Лог).Проверить("http://private.local/download/", "sekret-42");
	Исключение
		Лог.УдалитьСпособВывода(Ловушка);
		ВызватьИсключение;
	КонецПопытки;
	Лог.УдалитьСпособВывода(Ловушка);

	Ожидаем.Что(Ловушка.Количество() > 0, "журнал вообще что-то написал").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "sekret-42"),
		"значения токена нет ни в одной строке: " + Ловушка.Всё()).Равно(0);
	Ожидаем.Что(Ловушка.Всё(), "но факт наличия токена в журнале виден").Содержит("токен источника задан");

КонецПроцедуры

#КонецОбласти

#Область ПамятьОЖивости

&Тест
Процедура НеизвестныйИсточникПолучаетСвойЧестныйЗапрос() Экспорт

	Страж = НовыйСтраж();
	Апстрим = Источник("http://hub.local/download/");

	Ожидаем.Что(Страж.Допустим(Апстрим), "о непроверенном источнике ничего не известно").ЭтоИстина();
	Ожидаем.Что(Страж.Состояние(Апстрим).Известно, "и это видно как «не проверялся»").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЛежачийИсточникБольшеНеОпрашивается() Экспорт

	Страж = НовыйСтраж();
	Апстрим = Источник("http://dead.local/download/");

	Страж.ОтметитьЛежащим("http://dead.local/download/", "соединение отбито");

	Ожидаем.Что(Страж.Допустим(Апстрим), "к лежачему источнику не ходят").ЭтоЛожь();
	Ожидаем.Что(Страж.Пропустить(Апстрим), "и точка выдачи его пропускает").ЭтоЛожь();
	Ожидаем.Что(Страж.ПричинаОтказа(Апстрим),
		"«лежит» не выдаётся за «пакета нет»: причина названа").Содержит("соединение отбито");
	Ожидаем.Что(Страж.Состояние(Апстрим).Известно, "состояние известно экрану").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПоднявшийсяИсточникВозвращаетсяВРаботуСам() Экспорт

	Страж = НовыйСтраж();
	Апстрим = Источник("http://flaky.local/download/");

	Страж.ОтметитьЛежащим("http://flaky.local/download/", "источник не ответил");
	Ожидаем.Что(Страж.Допустим(Апстрим), "лежит").ЭтоЛожь();

	Страж.ОтметитьЖивым("http://flaky.local/download/");

	Ожидаем.Что(Страж.Допустим(Апстрим), "снова ответил — снова опрашивается").ЭтоИстина();
	Ожидаем.Что(Страж.Состояние(Апстрим).Живой, "и это видно на экране").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПротухшаяОтметкаСноваДаётИсточникуШанс() Экспорт

	// нулевой TTL — «память не живёт»: отметка протухает мгновенно, и лежачий источник
	// получает честный запрос вместо вечного отказа
	Страж = НовыйСтраж(0);
	Апстрим = Источник("http://dead.local/download/");

	Страж.ОтметитьЛежащим("http://dead.local/download/", "источник не ответил");

	Ожидаем.Что(Страж.Допустим(Апстрим), "протухшая отметка — это «неизвестно»").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АдресИсточникаСличаетсяБезУчётаРегистра() Экспорт

	Страж = НовыйСтраж();
	Страж.ОтметитьЛежащим("http://Hub.Local/Download/", "источник не ответил");

	Ожидаем.Что(Страж.Допустим(Источник("http://hub.local/Download/")),
		"тот же адрес в другом регистре — тот же источник").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЗабытьСбрасываетПамять() Экспорт

	Страж = НовыйСтраж();
	Страж.ОтметитьЛежащим("http://dead.local/download/", "источник не ответил");
	Страж.Забыть();

	Ожидаем.Что(Страж.Допустим(Источник("http://dead.local/download/")),
		"после сброса о источнике снова ничего не известно").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебные

// Куда цепочка уходит с адреса «http://hub.local/download/list.txt?страница=2»: первым
// шагом источник приводит хаб именно туда, вторым — отдаёт проверяемый Location.
// Адрес третьего запроса и есть наблюдаемая величина.
Функция КудаУвёл(Знач Location)

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("http://hub.local/download/list.txt", "list.txt?страница=2");
	Транспорт.ПеренаправитьС("http://hub.local/download/list.txt?страница=2", Location);

	Попытка
		Пробник(Транспорт).Проверить("http://hub.local/download/");
	Исключение
		// ответ на третий адрес фейку не задан: нужен сам адрес, а не ответ по нему
	КонецПопытки;

	Возврат ?(Транспорт.Обращения().Количество() > 2, Транспорт.Обращения()[2], "");

КонецФункции

// Заголовок авторизации, доехавший до второго шага цепочки.
Функция ТокенПослеПерехода(Знач Location, Знач Цель)

	Транспорт = Новый ФейкТранспортИсточника();
	Транспорт.ПеренаправитьС("http://private.local/download/list.txt", Location);
	Транспорт.ПриАдресе(Цель, 200, "alpha");

	Пробник(Транспорт).Проверить("http://private.local/download/", "sekret-42");

	Возврат Транспорт.Заголовок("Authorization", 2);

КонецФункции

Функция Пробник(Знач Транспорт, Знач Таймаут = 20, Знач Потолок = 5)
	Возврат Новый ПробникИсточника(
		Новый КлиентАпстрима(Транспорт, Настройки(Таймаут, Потолок, Истина), ЛогТестов()),
		Настройки(Таймаут, Потолок, Истина), ЛогТестов());
КонецФункции

// Пробник, весь вывод которого идёт в переданный лог: им проверяется, чего в журнале НЕТ.
Функция ПробникСЛогом(Знач Транспорт, Знач Лог)
	Возврат Новый ПробникИсточника(
		Новый КлиентАпстрима(Транспорт, Настройки(20, 5, Истина), Лог),
		Настройки(20, 5, Истина), Лог);
КонецФункции

Функция ПробникБезПробы(Знач Транспорт)
	Возврат Новый ПробникИсточника(
		Новый КлиентАпстрима(Транспорт, Настройки(20, 5, Ложь), ЛогТестов()),
		Настройки(20, 5, Ложь), ЛогТестов());
КонецФункции

Функция НовыйСтраж(Знач TTL = 300)
	Заглушка = Новый НастройкиЗаглушка();
	Заглушка.ЗадатьПрокси(20, Ложь, 60, TTL);
	Возврат Новый СтражАпстримов(Заглушка, ЛогТестов());
КонецФункции

// Источник в контракте стража — это объект с полем Url; сущность БД тут не нужна.
Функция Источник(Знач Url)
	Возврат Новый Структура("Url", Url);
КонецФункции

Функция Настройки(Знач Таймаут, Знач Потолок, Знач ПробаВключена)
	Заглушка = Новый НастройкиЗаглушка();
	Заглушка.ЗадатьПрокси(Таймаут, Ложь, 60, 300, Потолок, ПробаВключена);
	Возврат Заглушка;
КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.проба");
КонецФункции

#КонецОбласти
