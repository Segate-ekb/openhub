// Таблица решений пульта пулов: право на квоту, вердикт по вводу и порядок «сначала
// судить весь ввод, потом писать». Домен подменён фикстурой — здесь проверяется РЕШЕНИЕ
// пульта, а не работа сервиса; правило квоты фикстура берёт у настоящей КвотыПула.
//
// Почему юнитом, а не HTTP: порог раздела «Пулы» — администратор хаба, и внешний гвард
// отказывает раньше пульта. Ветки «нет права на квоту» и «отказ по праву — свой код»
// снаружи недостижимы, и HTTP-тест зеленел бы с вырезанным из пульта гвардом.

#Использовать asserts
#Использовать "фикстуры"

Перем UI;          // СборкаUI — граф компонентов и рендереров web-ui
Перем Кабинет;     // РендерерКабинета (кабинет)
Перем Разбор;      // РазборФормы (кабинет)
Перем Ошибки;      // ТекстОшибки (основа)
Перем Числа;       // ПриведениеЧисел (основа)
Перем Витрина;     // ВитринаПулов (настройки) — имена полей и значения операций
Перем ДомХаба_;    // ДомХаба (настройки)
Перем ФабрикаИтога; // ИтогПульта (настройки)
Перем ПравилоКвоты; // КвотаПула (реестр)
Перем ФормаПула;    // ФормаСозданияПула (настройки) — объявление полей формы заведения

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	РеестрФикстур.Подключить("ФейкСервисПрав");
	РеестрФикстур.Подключить("ФейкПуловДляПульта");
	РеестрФикстур.Подключить("СлужбаДоступаЗаглушка");

	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	Поиск = Новый КлассыСлоя();
	КаталогОбщего = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы", "общее");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	Поиск.Подключить(КаталогОбщего, "РендерерКабинета");
	Поиск.Подключить(КаталогОбщего, "РазборФормы");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ТекстОшибки");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ПриведениеЧисел");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"), "ЗаполнениеПула");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ОбъёмТекстом");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"), "ПлашкиПула");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"), "КвотаПула");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "права", "Классы"), "ГвардКвотыПула");

	КаталогНастроек = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы", "настройки");
	Поиск.Подключить(КаталогНастроек, "КаталогРазделов");
	Поиск.Подключить(КаталогНастроек, "ДомПула");
	Поиск.Подключить(КаталогНастроек, "ДомХаба");
	Поиск.Подключить(КаталогНастроек, "ИтогПульта");
	Поиск.Подключить(КаталогОбщего, "ОтметкаСохранения");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ПараметрыСсылки");
	Поиск.Подключить(КаталогНастроек, "ОкноФормы");
	Поиск.Подключить(КаталогНастроек, "ФормаСозданияПула");
	Поиск.Подключить(КаталогНастроек, "ВитринаПулов");
	Поиск.Подключить(КаталогНастроек, "БланкРаздела");
	Поиск.Подключить(КаталогНастроек, "ПультПулов");

	Кабинет = Новый РендерерКабинета(UI.Каркас);
	Разбор = Новый РазборФормы();
	Ошибки = Новый ТекстОшибки();
	Числа = Новый ПриведениеЧисел();
	ФабрикаИтога = Новый ИтогПульта();
	ПравилоКвоты = Новый КвотаПула(Новый Массив());

	Каталог = Новый КаталогРазделов(UI.РендерерНастроек);
	ДомХаба_ = Новый ДомХаба(Каталог, UI.Тексты);
	// витрина отдаёт пульту только имена полей и значения операций — она одна на набор
	ПулыВитрины = Новый ФейкПуловДляПульта(ПравилоКвоты);
	// объявление формы одно на отрисовку и на разбор: и витрина, и пульт зовут его
	ФормаПула = Новый ФормаСозданияПула(UI.Кит, UI.Формы, ПулыВитрины,
		Новый ОкноФормы(UI.Кит, UI.Тексты), UI.Тексты);
	Витрина = Новый ВитринаПулов(UI.Кит, UI.РендерерНастроек, ФормаПула,
		Новый ДомПула(Каталог, UI.Тексты),
		Новый ПлашкиПула(ПулыВитрины, UI.Тексты, UI.ЗначкиМеты), ПулыВитрины, Новый ЗаполнениеПула(),
		Новый ОбъёмТекстом(), UI.Тексты, Новый БланкРаздела(UI.Кит), UI.Примечания);

КонецПроцедуры

#Область ПравоНаКвоту

// Право на квоту спрашивается у СВОЕГО гварда, а не выводится из порога раздела: разойдись
// предикаты — и экран начнёт пускать к квоте того, кому её менять нельзя.
&Тест
Процедура БезПраваНаКвотуПультОтказываетСвоимКодомИНичегоНеПишет() Экспорт

	Стенд = ПостроитьСтенд();

	Итог = Стенд.Пульт.Применить("pools", ФормаКвоты(7, "512", "public"), НеАдмин());

	Ожидаем.Что(Итог.Перехвачено, "пульт распорядился сам").ЭтоИстина();
	Ожидаем.Что(Итог.Статус, "отказ по праву называет себя своим кодом").Равно(403);
	Ожидаем.Что(Итог.Ошибка, "и причина названа словами").Содержит("администратор хаба");
	Ожидаем.Что(Стенд.Пулы.ЗаписанныеКвоты().Количество(), "квота не записана").Равно(0);
	Ожидаем.Что(Стенд.Пулы.ЗаписанныеВидимости().Количество(), "и видимость тоже").Равно(0);

	// КОНТРОЛЬ: тот же запрос от администратора хаба проходит и пишет
	ИтогАдмина = Стенд.Пульт.Применить("pools", ФормаКвоты(7, "512", "public"), Админ());
	Ожидаем.Что(ИтогАдмина.Ошибка, "КОНТРОЛЬ: администратору отказа нет").Равно("");
	Ожидаем.Что(ИтогАдмина.Статус, "и кода отказа нет").Равно(0);
	Ожидаем.Что(Стенд.Пулы.ЗаписанныеКвоты()[0], "квота записана").Равно(512);

КонецПроцедуры

// Аноним — не «пользователь без флага админа», а Неопределено: гвард обязан пережить его.
&Тест
Процедура АнонимуКвотаЗапрещена() Экспорт

	Стенд = ПостроитьСтенд();

	Итог = Стенд.Пульт.Применить("pools", ФормаКвоты(7, "512", "public"), Неопределено);

	Ожидаем.Что(Итог.Статус, "аноним получает отказ по праву").Равно(403);
	Ожидаем.Что(Стенд.Пулы.ЗаписанныеКвоты().Количество(), "и ничего не записывает").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ВердиктПоВводу

// «Как в хабе» (-1) — значение, которое печатает сама панель. Отвергая его, пульт
// отказывал бы и в смене видимости: она едет тем же POST, а квота судится первой.
&Тест
Процедура МинусЕдиницаПринимаетсяКакЗначениеПоУмолчанию() Экспорт

	Стенд = ПостроитьСтенд();

	Итог = Стенд.Пульт.Применить("pools", ФормаКвоты(7, "-1", "private"), Админ());

	Ожидаем.Что(Итог.Ошибка, "«как в хабе» принято").Равно("");
	Ожидаем.Что(Стенд.Пулы.ЗаписанныеКвоты()[0], "и записано как -1")
		.Равно(ПравилоКвоты.КакВХабе());
	Ожидаем.Что(Стенд.Пулы.ЗаписанныеВидимости()[0], "видимость доехала тем же запросом")
		.Равно("private");

КонецПроцедуры

&Тест
Процедура НедопустимаяКвотаОтвергаетсяБезЗаписи() Экспорт

	Стенд = ПостроитьСтенд();

	Для Каждого Плохое Из СтрРазделить("5oo|-5|-|1000000000001| ", "|") Цикл
		Итог = Стенд.Пульт.Применить("pools", ФормаКвоты(7, Плохое, "public"), Админ());
		Ожидаем.Что(ЗначениеЗаполнено(Итог.Ошибка),
			СтрШаблон("квота ""%1"" отвергнута", Плохое)).ЭтоИстина();
		Ожидаем.Что(Итог.Статус, СтрШаблон("квота ""%1"": отказ по вводу, а не по праву", Плохое))
			.Равно(0);
	КонецЦикла;

	Ожидаем.Что(Стенд.Пулы.ЗаписанныеКвоты().Количество(), "ни один отказ ничего не записал").Равно(0);
	Ожидаем.Что(Стенд.Пулы.ЗаписанныеВидимости().Количество(), "и видимость не тронул").Равно(0);

КонецПроцедуры

&Тест
Процедура ПультОтвечаетНаНеуказанныйПулПонятнымОтказом() Экспорт

	Стенд = ПостроитьСтенд();

	Итог = Стенд.Пульт.Применить("pools", ФормаКвоты(0, "512", "public"), Админ());

	Ожидаем.Что(ЗначениеЗаполнено(Итог.Ошибка), "пул не указан — отказ").ЭтоИстина();
	Ожидаем.Что(Стенд.Пулы.ЗаписанныеКвоты().Количество(), "и ничего не записано").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПорядокЗаписей

// Квота и видимость — ОДНА операция. Инвариант видимости (личное пространство и основной
// пул всегда публичны) обязан быть рассужен ДО записи квоты, иначе отказ «квота НЕ
// изменена» приходит уже после того, как она изменена.
&Тест
Процедура ОтказВидимостиНеОставляетКвотуЗаписанной() Экспорт

	Стенд = ПостроитьСтенд();
	Стенд.Пулы.ЗапретитьПриватность("Пул «bob» — личное пространство пользователя");

	Итог = Стенд.Пульт.Применить("pools", ФормаКвоты(7, "777", "private"), Админ());

	Ожидаем.Что(ЗначениеЗаполнено(Итог.Ошибка), "операция отвергнута").ЭтоИстина();
	Ожидаем.Что(Итог.Ошибка, "и причина названа").Содержит("личное пространство");
	Ожидаем.Что(Стенд.Пулы.ЗаписанныеКвоты().Количество(),
		"квота НЕ записана: отказ применён целиком, а не наполовину").Равно(0);
	Ожидаем.Что(Стенд.Пулы.ЗаписанныеВидимости().Количество(), "и видимость тоже").Равно(0);

	// КОНТРОЛЬ: та же квота с допустимой видимостью пишется
	Стенд.Пульт.Применить("pools", ФормаКвоты(7, "777", "public"), Админ());
	Ожидаем.Что(Стенд.Пулы.ЗаписанныеКвоты()[0], "КОНТРОЛЬ: с публичной видимостью записана")
		.Равно(777);

КонецПроцедуры

#КонецОбласти

#Область СозданиеПула

// Создание судит квоту ТЕМ ЖЕ вердиктом, что и правка: терпимое чтение молча превращало
// «500abc» в 500, а «5oo» — в наследование квоты хаба, и пул заводился с чужим пределом.
&Тест
Процедура МусорВКвотеСозданияОтвергаетсяАПулНеЗаводится() Экспорт

	Стенд = ПостроитьСтенд();

	Итог = Стенд.Пульт.Применить("pools", ФормаСоздания("newpool", "5oo"), Админ());

	Ожидаем.Что(ЗначениеЗаполнено(Итог.Ошибка), "мусор в квоте создания отвергнут").ЭтоИстина();
	Ожидаем.Что(Стенд.Служба.Созданные().Количество(), "и пул не заведён").Равно(0);

КонецПроцедуры

&Тест
Процедура ПустаяКвотаСозданияОзначаетКакВХабе() Экспорт

	Стенд = ПостроитьСтенд();

	Итог = Стенд.Пульт.Применить("pools", ФормаСоздания("newpool", ""), Админ());

	Ожидаем.Что(Итог.Ошибка, "форма без поля квоты принимается").Равно("");
	Ожидаем.Что(Стенд.Служба.Созданные()[0].КвотаМб, "пул наследует квоту хаба")
		.Равно(ПравилоКвоты.КакВХабе());

КонецПроцедуры

&Тест
Процедура ЗаданнаяКвотаСозданияДоезжаетДоСлужбы() Экспорт

	Стенд = ПостроитьСтенд();

	Стенд.Пульт.Применить("pools", ФормаСоздания("newpool", "256"), Админ());

	Ожидаем.Что(Стенд.Служба.Созданные()[0].КвотаМб, "квота доехала числом").Равно(256);

КонецПроцедуры

#КонецОбласти

#Область ЧужойРаздел

&Тест
Процедура ЧужойРазделПультНеТрогает() Экспорт

	Стенд = ПостроитьСтенд();

	Итог = Стенд.Пульт.Применить("auth", ФормаКвоты(7, "512", "public"), Админ());

	Ожидаем.Что(Итог.Перехвачено, "раздел не наш — общий путь").ЭтоЛожь();
	Ожидаем.Что(Стенд.Пулы.ЗаписанныеКвоты().Количество(), "и ничего не записано").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Стенд

Функция ПостроитьСтенд()

	Пулы = Новый ФейкПуловДляПульта(ПравилоКвоты);
	Служба = Новый СлужбаДоступаЗаглушка();
	Гвард = Новый ГвардКвотыПула(Новый ФейкСервисПрав());

	Пульт = Новый ПультПулов(Разбор, Служба, Пулы, Гвард, Витрина, ФормаПула, ДомХаба_,
		ФабрикаИтога, Числа, Ошибки, UI.Тексты, Новый ОтметкаСохранения(Новый ПараметрыСсылки()));

	Возврат Новый Структура("Пулы, Служба, Пульт", Пулы, Служба, Пульт);

КонецФункции

Функция Админ()
	Возврат Новый Структура("Логин, Админ", "root", Истина);
КонецФункции

Функция НеАдмин()
	Возврат Новый Структура("Логин, Админ", "owner1", Ложь);
КонецФункции

Функция ФормаКвоты(Знач ИдПула, Знач Квота, Знач Видимость)

	Форма = Новый Соответствие();
	Форма.Вставить(Витрина.ИмяПоляОперации(), Витрина.ОперацияКвоты());
	Форма.Вставить(Витрина.ИмяПоляПула(), Формат(ИдПула, "ЧН=0; ЧГ=0"));
	Форма.Вставить("квота_мб", Квота);
	Форма.Вставить("видимость", Видимость);
	Возврат Форма;

КонецФункции

Функция ФормаСоздания(Знач Имя, Знач Квота)

	Форма = Новый Соответствие();
	Форма.Вставить(Витрина.ИмяПоляОперации(), Витрина.ОперацияСоздания());
	Форма.Вставить("имя", Имя);
	Форма.Вставить("тип", "custom");
	Форма.Вставить("видимость", "public");
	Форма.Вставить("квота_мб", Квота);
	Возврат Форма;

КонецФункции

#КонецОбласти
