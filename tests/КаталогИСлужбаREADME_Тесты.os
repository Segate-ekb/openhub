// Интеграционные тесты сервисов web-ui в контейнере ОСени: КаталогПакетов (поиск, пагинация), СтатистикаХаба,
// СлужбаREADME (README из .ospx → рендер → санитизация, кэш). Бэкенд — InMemory, набор в отдельном процессе.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать oscript-md
#Использовать ospx-tools
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем КореньХранилища;
Перем Фикстура;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("данные", "Классы")));
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("настройки", "Классы")));
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("реестр", "Классы")));

	// SSRF-гейт апстримов: СервисПулов требует валидатор адреса обязательно (fail-closed)
	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("хранилище", "Классы")));
	// каталог опирается на СлужбуПоиска с ранжированием по популярности — отсюда зависимости stats и events
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("события", "Классы")));
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("статистика", "Классы")));
	// ГотовностьХаба — гейт стартовых задач: без желудя бины рогаток модуля не собираются
	Попытка
		ПодключитьСценарий(ОбъединитьПути(КаталогМодулей,
			ОбъединитьПути("наблюдаемость", ОбъединитьПути("Классы/пробы", "ГотовностьХаба.os"))),
			"ГотовностьХаба");
	Исключение
	КонецПопытки;
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("поиск", "Классы")));

	// ACL-шов: поиск/ВидимостьПулов опирается на СервисПрав; ПроверяющийGitHub — фейк без сети
	// сервисы auth пишут журнал через ИмяОбъектаАудита — без него их желуди не собираются
	Попытка
		ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "аудит", "Классы", "ИмяОбъектаАудита.os"),
			"ИмяОбъектаАудита");
	Исключение
	КонецПопытки;
	КаталогВхода = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("вход", "Классы"));
	ПоискКлассов.Подключить(КаталогМодулей, "СервисПрав");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисГрупп");
	Подключить(ОбъединитьПути(КаталогТестов, ОбъединитьПути("фикстуры", "ФейкПроверяющийGitHub.os")), "ФейкПроверяющийGitHub");

	// право «которыми я могу управлять» каталог спрашивает у доменной СлужбыКабинета — подключаем ровно её желудь
	Подключить(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("кабинет", ОбъединитьПути("Классы", "СлужбаКабинета.os"))),
		"СлужбаКабинета");

	// служба README — свой модуль; файл ищется РЕКУРСИВНО, классы разложены по подкаталогам
	КаталогREADME = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("описания", "Классы"));
	Для Каждого Имя Из СтрРазделить(
		"КоординатыREADME,ХранилищеREADME,РендерерREADME,ИсточникREADME,СлужбаREADME", ",") Цикл
		Подключить(НайтиФайлы(КаталогREADME, Имя + ".os", Истина)[0].ПолноеИмя, Имя);
	КонецЦикла;

	// только сервисные желуди web-ui; файл ищется РЕКУРСИВНО — классы разложены по подкаталогам
	КаталогWebUI = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("интерфейс", "Классы"));
	Для Каждого Имя Из СтрРазделить("КаталогПакетов,ВидимоеСодержимое,СтатистикаХаба,ВитринаГлавной",
		",") Цикл
		Подключить(НайтиФайлы(КаталогWebUI, Имя + ".os", Истина)[0].ПолноеИмя, Имя);
	КонецЦикла;

	Для Каждого ФайлОбщий Из НайтиФайлы(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "*.os", Истина) Цикл
		Подключить(ФайлОбщий.ПолноеИмя, ФайлОбщий.ИмяБезРасширения);
	КонецЦикла;

	Подключить(ОбъединитьПути(КаталогТестов, ОбъединитьПути("фикстуры", "ФикстураПакета.os")), "ФикстураПакета");
	Фикстура = Новый ФикстураПакета();

	Подключить(ОбъединитьПути(КаталогТестов,
		ОбъединитьПути("фикстуры", "СчитающееХранилищеВерсий.os")), "СчитающееХранилищеВерсий");

	КореньХранилища = ОбъединитьПути(КаталогВременныхФайлов(), "openhub-webui-" + Лев(Строка(Новый УникальныйИдентификатор()), 8));
	СоздатьКаталог(КореньХранилища);

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "web-ui-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

&ПослеВсех
Процедура УбратьКорень() Экспорт
	Если ЗначениеЗаполнено(КореньХранилища) Тогда
		Попытка
			УдалитьФайлы(КореньХранилища);
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

&Тест
Процедура ПоискПоПодстрокеИПагинация() Экспорт

	Пул = НовыйПул("catalog-pool");
	Для Каждого Имя Из СтрРазделить("winow,autumn,configor,semver,entity", ",") Цикл
		ЗарегистрироватьПакет(Пул.Идентификатор, Имя);
	КонецЦикла;

	Каталог = Поделка.НайтиЖелудь("КаталогПакетов");

	Найдено = Каталог.НайтиПакеты("WIN", 1, 20);
	Ожидаем.Что(Найдено.Всего, "по подстроке ""win"" найден только winow").Равно(1);
	Ожидаем.Что(Найдено.Элементы[0].Пакет.Имя).Равно("winow");
	Ожидаем.Что(Найдено.Элементы[0].Пул.Имя).Равно("catalog-pool");

	Все = Каталог.НайтиПакеты("", 1, 20);
	Ожидаем.Что(Все.Всего).Равно(5);
	Ожидаем.Что(Все.Элементы[0].Пакет.Имя, "сортировка по имени").Равно("autumn");

	Стр1 = Каталог.НайтиПакеты("", 1, 2);
	Ожидаем.Что(Стр1.ВсегоСтраниц).Равно(3);
	Ожидаем.Что(Стр1.Элементы.Количество()).Равно(2);
	Стр3 = Каталог.НайтиПакеты("", 3, 2);
	Ожидаем.Что(Стр3.Страница).Равно(3);
	Ожидаем.Что(Стр3.Элементы.Количество()).Равно(1);

	ЗаГранью = Каталог.НайтиПакеты("", 99, 2);
	Ожидаем.Что(ЗаГранью.Страница).Равно(3);

	Ожидаем.Что(Каталог.НайтиПакеты("неттакого", 1, 20).Всего).Равно(0);

КонецПроцедуры

&Тест
Процедура КаталогОтбираетПоПулу() Экспорт

	Каталог = Поделка.НайтиЖелудь("КаталогПакетов");
	СервисПулов = Поделка.НайтиЖелудь("СервисПулов");
	СервисПакетов = Поделка.НайтиЖелудь("СервисПакетов");

	Ключ = Лев(Строка(Новый УникальныйИдентификатор()), 8);
	ПулA = СервисПулов.СоздатьПул("fa-" + Ключ, "custom", "public");
	ПулB = СервисПулов.СоздатьПул("fb-" + Ключ, "custom", "public");
	СервисПакетов.ЗарегистрироватьПакет(ПулA.Идентификатор, "fpkg-a-" + Ключ);
	СервисПакетов.ЗарегистрироватьПакет(ПулB.Идентификатор, "fpkg-b-" + Ключ);

	Отбор = Новый Структура("Пул, ТолькоУправляемые", ПулA.Имя, Ложь);
	Выдача = Каталог.НайтиПакеты("fpkg-", 1, 50, Неопределено, Отбор);

	Ожидаем.Что(Выдача.Всего, "в отборе только пакеты своего пула").Равно(1);
	Ожидаем.Что(Выдача.Элементы[0].Пул.Имя, "и это именно отобранный пул").Равно(ПулA.Имя);

	// без отбора видны оба — иначе тест зеленел бы на пустой выдаче
	БезОтбора = Каталог.НайтиПакеты("fpkg-", 1, 50, Неопределено, Неопределено);
	Ожидаем.Что(БезОтбора.Всего, "без отбора видны оба пакета").Равно(2);

КонецПроцедуры

&Тест
Процедура ОтборПоПулуНеРаскрываетПриватныйПул() Экспорт

	// Отбор по пулу — отдельная ветка выдачи: СлужбаПоиска её не проходит, право чтения спрашивает сам каталог.
	// Без этой проверки /packages?pool=<имя> отдавал бы пакеты приватного пула анониму.
	Каталог = Поделка.НайтиЖелудь("КаталогПакетов");
	СервисПулов = Поделка.НайтиЖелудь("СервисПулов");
	СервисПакетов = Поделка.НайтиЖелудь("СервисПакетов");

	Ключ = Лев(Строка(Новый УникальныйИдентификатор()), 8);
	Приватный = СервисПулов.СоздатьПул("pr-" + Ключ, "custom", "private");
	Публичный = СервисПулов.СоздатьПул("pu-" + Ключ, "custom", "public");
	СервисПакетов.ЗарегистрироватьПакет(Приватный.Идентификатор, "acl-secret-" + Ключ);
	СервисПакетов.ЗарегистрироватьПакет(Публичный.Идентификатор, "acl-open-" + Ключ);

	Скрытый = Каталог.НайтиПакеты("acl-", 1, 50, Неопределено,
		Новый Структура("Пул, ТолькоУправляемые", Приватный.Имя, Ложь));
	Ожидаем.Что(Скрытый.Всего, "аноним не видит пакеты приватного пула в отборе").Равно(0);

	// контроль: публичный пул тем же вызовом виден — иначе тест зеленел бы на любой поломке отбора
	Видимый = Каталог.НайтиПакеты("acl-", 1, 50, Неопределено,
		Новый Структура("Пул, ТолькоУправляемые", Публичный.Имя, Ложь));
	Ожидаем.Что(Видимый.Всего, "публичный пул в том же отборе виден").Равно(1);

КонецПроцедуры

&Тест
Процедура ОтборУправляемыхПустДляАнонима() Экспорт

	// аноним не управляет ничем: «отбор молча игнорируется» выглядит на экране как «показаны все пакеты»
	Каталог = Поделка.НайтиЖелудь("КаталогПакетов");
	СервисПулов = Поделка.НайтиЖелудь("СервисПулов");
	СервисПакетов = Поделка.НайтиЖелудь("СервисПакетов");

	Ключ = Лев(Строка(Новый УникальныйИдентификатор()), 8);
	Пул = СервисПулов.СоздатьПул("mp-" + Ключ, "custom", "public");
	СервисПакетов.ЗарегистрироватьПакет(Пул.Идентификатор, "mpkg-" + Ключ);

	Отбор = Новый Структура("Пул, ТолькоУправляемые", "", Истина);
	Выдача = Каталог.НайтиПакеты("mpkg-", 1, 50, Неопределено, Отбор);

	Ожидаем.Что(Выдача.Всего, "аноним не управляет ничем").Равно(0);
	Ожидаем.Что(Каталог.НайтиПакеты("mpkg-", 1, 50, Неопределено, Неопределено).Всего,
		"а без отбора пакет виден").Равно(1);

КонецПроцедуры

&Тест
Процедура СкрытыеПакетыВКаталогНеПопадают() Экспорт

	Пул = НовыйПул("hidden-pool");
	Видимый = ЗарегистрироватьПакет(Пул.Идентификатор, "visible-pkg");
	Скрытый = ЗарегистрироватьПакет(Пул.Идентификатор, "hidden-pkg");
	Скрытый.Скрыт = Истина;
	Скрытый.Сохранить();

	Каталог = Поделка.НайтиЖелудь("КаталогПакетов");
	Найдено = Каталог.НайтиПакеты("pkg", 1, 20);

	Имена = Новый Массив();
	Для Каждого Э Из Найдено.Элементы Цикл
		Имена.Добавить(Э.Пакет.Имя);
	КонецЦикла;

	Ожидаем.Что(Имена.Найти("visible-pkg") <> Неопределено, "видимый в каталоге").ЭтоИстина();
	Ожидаем.Что(Имена.Найти("hidden-pkg"), "скрытый не в каталоге").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СводкаСчитаетПакетыИПулы() Экспорт

	СервисПулов = Поделка.НайтиЖелудь("СервисПулов");
	ПулA = СервисПулов.СоздатьПул("stat-team", "custom");
	ЗарегистрироватьПакет(ПулA.Идентификатор, "stat-pkg-1");
	ЗарегистрироватьПакет(ПулA.Идентификатор, "stat-pkg-2");

	Сводка = Поделка.НайтиЖелудь("СтатистикаХаба").Сводка();

	Ожидаем.Что(Сводка.ВсегоПакетов >= 2, "учтены оба пакета").ЭтоИстина();
	Ожидаем.Что(Сводка.ВсегоПулов >= 1, "учтён пул").ЭтоИстина();
	Ожидаем.Что(Сводка.ВсегоПулов = Сводка.ПуловЛичных + Сводка.ПуловКоманд,
		"разрез покрывает все пулы").ЭтоИстина();

КонецПроцедуры

// Числа лендинга — такой же агрегат о закрытом контуре, как и /metrics: по приросту
// счётчика аноним узнавал бы, что в хабе завели приватный пул или пакет в нём.
&Тест
Процедура СводкаНеСчитаетПриватныйПулАнонимуИПостороннему() Экспорт

	Ключ = Лев(Строка(Новый УникальныйИдентификатор()), 8);
	СервисПулов = Поделка.НайтиЖелудь("СервисПулов");
	Статистика = Поделка.НайтиЖелудь("СтатистикаХаба");

	ДоПулов = Статистика.Сводка().ВсегоПулов;
	ДоПакетов = Статистика.Сводка().ВсегоПакетов;

	Приватный = СервисПулов.СоздатьПул("hid-" + Ключ, "custom", "private");
	ЗарегистрироватьПакет(Приватный.Идентификатор, "hidpkg-" + Ключ);

	Аноним = Статистика.Сводка();
	Ожидаем.Что(Аноним.ВсегоПулов, "приватный пул не увеличил число пулов анониму").Равно(ДоПулов);
	Ожидаем.Что(Аноним.ВсегоПакетов, "и его пакет не увеличил число пакетов").Равно(ДоПакетов);

	Посторонний = Статистика.Сводка(ЗавестиУчётку("out-" + Ключ, "user"));
	Ожидаем.Что(Посторонний.ВсегоПулов, "постороннему — так же").Равно(ДоПулов);
	Ожидаем.Что(Посторонний.ВсегоПакетов, "и по пакетам").Равно(ДоПакетов);

КонецПроцедуры

// Обратная сторона отбора: тем, кто пул читает, числа обязаны его показывать — иначе
// починка утечки превратилась бы в потерю функции.
&Тест
Процедура СводкаСчитаетПриватныйПулУчастникуИАдмину() Экспорт

	Ключ = Лев(Строка(Новый УникальныйИдентификатор()), 8);
	СервисПулов = Поделка.НайтиЖелудь("СервисПулов");
	Статистика = Поделка.НайтиЖелудь("СтатистикаХаба");

	Участник = ЗавестиУчётку("in-" + Ключ, "user");
	Админ = ЗавестиУчётку("adm-" + Ключ, "admin");

	ДоУчастника = Статистика.Сводка(Участник);
	ДоАдмина = Статистика.Сводка(Админ);

	Приватный = СервисПулов.СоздатьПул("vis-" + Ключ, "custom", "private");
	ЗарегистрироватьПакет(Приватный.Идентификатор, "vispkg-" + Ключ);
	ДатьЧтение(Приватный.Идентификатор, Участник.Идентификатор);

	ПослеУчастника = Статистика.Сводка(Участник);
	Ожидаем.Что(ПослеУчастника.ВсегоПулов, "участник видит свой приватный пул")
		.Равно(ДоУчастника.ВсегоПулов + 1);
	Ожидаем.Что(ПослеУчастника.ВсегоПакетов, "и его пакет")
		.Равно(ДоУчастника.ВсегоПакетов + 1);

	ПослеАдмина = Статистика.Сводка(Админ);
	Ожидаем.Что(ПослеАдмина.ВсегоПулов, "админ хаба видит любой пул")
		.Равно(ДоАдмина.ВсегоПулов + 1);
	Ожидаем.Что(ПослеАдмина.ВсегоПакетов, "и любой пакет")
		.Равно(ДоАдмина.ВсегоПакетов + 1);

КонецПроцедуры

&Тест
Процедура СрезНеОтдаётСкрытыеПакетыИПакетыСирот() Экспорт

	Ключ = Лев(Строка(Новый УникальныйИдентификатор()), 8);
	Пул = Поделка.НайтиЖелудь("СервисПулов").СоздатьПул("slice-" + Ключ, "custom");

	ЗарегистрироватьПакет(Пул.Идентификатор, "slice-open-" + Ключ);
	Скрытый = ЗарегистрироватьПакет(Пул.Идентификатор, "slice-hidden-" + Ключ);
	Скрытый.Скрыт = Истина;
	Скрытый.Сохранить();

	// пакет с несуществующим пулом: fail-closed — он не попадает ни в срез, ни в число
	Сирота = Поделка.НайтиЖелудь("ХранилищеПакетов").СоздатьЭлемент();
	Сирота.ПулИдентификатор = 999999;
	Сирота.Имя = "slice-orphan-" + Ключ;
	Сирота.ИмяНижнийРегистр = НРег(Сирота.Имя);
	Сирота.Описание = "";
	Сирота.КлючевыеСлова = "";
	Сирота.АдресРепозитория = "";
	Сирота.Лицензия = "";
	Сирота.Устарел = Ложь;
	Сирота.Скрыт = Ложь;
	Сирота.Создан = ТекущаяУниверсальнаяДата();
	Сирота.Сохранить();

	Срез = Поделка.НайтиЖелудь("ВидимоеСодержимое").Срез();

	Имена = Новый Массив();
	Для Каждого Пакет Из Срез.Пакеты Цикл
		Имена.Добавить(Пакет.Имя);
	КонецЦикла;

	Ожидаем.Что(Имена.Найти("slice-open-" + Ключ) <> Неопределено, "видимый пакет в срезе").ЭтоИстина();
	Ожидаем.Что(Имена.Найти("slice-hidden-" + Ключ), "скрытый пакет не в срезе").Равно(Неопределено);
	Ожидаем.Что(Имена.Найти("slice-orphan-" + Ключ), "пакет-сирота не в срезе").Равно(Неопределено);
	Ожидаем.Что(Срез.ПакетовВПуле.Получить(Цел(Пул.Идентификатор)),
		"счётчик пула считает только видимые").Равно(1);

КонецПроцедуры

&Тест
Процедура READMEИзАртефактаРендеритсяИСанитизируется() Экспорт

	Пул = НовыйПул("readme-pool");
	Пакет = ЗарегистрироватьПакет(Пул.Идентификатор, "demo-pkg");
	Версия = ОпубликоватьВерсию(Пакет.Идентификатор, "1.0.0");

	ПоложитьАртефактСREADME(Пул.Имя, Пакет.Имя, Версия.Версия, Фикстура.ВредоносныйREADME());

	Служба = Поделка.НайтиЖелудь("СлужбаREADME");
	Представление = Служба.ПредставлениеREADME(Пул, Пакет, Версия);

	Ожидаем.Что(Представление.ЕстьREADME, "README извлечён из артефакта").ЭтоИстина();

	HTML = НРег(Представление.HTML);
	Ожидаем.Что(СтрНайти(HTML, "демо-пакет winow") > 0, "легитимный заголовок README отрендерен").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "итоговый абзац") > 0, "текст README сохранён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<script"), "тег script вырезан санитайзером").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "javascript:"), "javascript-URL вырезаны").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "onclick"), "обработчик on* вырезан").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "xss-script"), "текст из script-блока отсутствует").Равно(0);

	Повтор = Служба.ПредставлениеREADME(Пул, Пакет, Версия);
	Ожидаем.Что(Повтор.HTML, "повторный запрос отдаёт то же").Равно(Представление.HTML);

КонецПроцедуры

// Описание версии кладёт на диск ПРИЁМ — то самое общее ядро, через которое проходят
// и push, и зеркало, и прокси. Файл лежит рядом с артефактом под именем, которое
// сборщик кэша прокси не разбирает как .ospx.
&Тест
Процедура ПриёмВерсииКладётОписаниеНаДиск() Экспорт

	Пул = НовыйПул("intake-readme-pool");
	Принятое = ПринятьВерсию(Пул, "intake-pkg", "1.0.0", "# Описание пакета");

	Ожидаем.Что(Принятое.Версия.Версия, "версия принята").Равно("1.0.0");
	Ожидаем.Что(ФайлОписанияЕсть(Пул.Имя, "intake-pkg", "1.0.0"),
		"описание принятой версии лежит файлом intake-pkg-1.0.0.readme.md").ЭтоИстина();
	Ожидаем.Что(ТекстФайлаОписания(Пул.Имя, "intake-pkg", "1.0.0"),
		"на диске лежит именно README пакета").Равно("# Описание пакета");

	// байты описания входят в объём пула, и счётчик знает о них сразу, а не после сверки
	Занято = Поделка.НайтиЖелудь("УчётОбъёмаПула").ЗанятоБайт(ОбновлённыйПул(Пул));
	Ожидаем.Что(Занято, "занятое пула выросло на размер файла описания")
		.Равно(РазмерФайлаОписания(Пул.Имя, "intake-pkg", "1.0.0"));

КонецПроцедуры

// Ради чего всё затевалось: после рестарта хаба описание отдаётся с диска. Артефакта
// в хранилище нет вовсе — распаковывать нечего, а страница README показывает.
&Тест
Процедура ОписаниеОтдаётсяБезАртефактаИБезПрогрева() Экспорт

	Пул = НовыйПул("disk-readme-pool");
	Принятое = ПринятьВерсию(Пул, "disk-pkg", "2.0.0", "# С диска" + Символы.ПС + Символы.ПС + "Текст.");

	Ожидаем.Что(АртефактЕсть(Пул.Имя, "disk-pkg", "2.0.0"),
		"самотест: .ospx этой версии в хранилище нет").ЭтоЛожь();

	Представление = Поделка.НайтиЖелудь("СлужбаREADME").ПредставлениеREADME(
		Пул, Принятое.Пакет, Принятое.Версия);

	Ожидаем.Что(Представление.ЕстьREADME, "описание нашлось на диске").ЭтоИстина();
	Ожидаем.Что(СтрНайти(НРег(Представление.HTML), "с диска") > 0,
		"и отрендерено: " + Представление.HTML).ЭтоИстина();

КонецПроцедуры

// Версии, принятые до появления дискового кэша, чинит первое же чтение: описание
// снимается с .ospx и остаётся на диске — второй раз распаковывать нечего.
&Тест
Процедура ПромахДискаЗаполняетсяИзАртефактаНавсегда() Экспорт

	Пул = НовыйПул("legacy-readme-pool");
	Пакет = ЗарегистрироватьПакет(Пул.Идентификатор, "legacy-pkg");
	Версия = ОпубликоватьВерсию(Пакет.Идентификатор, "1.0.0");
	ПоложитьАртефактСREADME(Пул.Имя, Пакет.Имя, Версия.Версия, "# Старая версия");

	Ожидаем.Что(ФайлОписанияЕсть(Пул.Имя, Пакет.Имя, Версия.Версия),
		"самотест: описания на диске ещё нет").ЭтоЛожь();

	Служба = Поделка.НайтиЖелудь("СлужбаREADME");
	Первое = Служба.ПредставлениеREADME(Пул, Пакет, Версия);
	Ожидаем.Что(Первое.ЕстьREADME, "первое чтение снимает README с артефакта").ЭтоИстина();

	Ожидаем.Что(ФайлОписанияЕсть(Пул.Имя, Пакет.Имя, Версия.Версия),
		"и оставляет его на диске").ЭтоИстина();

	// артефакта больше нет: если бы чтение по-прежнему шло в .ospx, README пропал бы
	УбратьАртефакт(Пул.Имя, Пакет.Имя, Версия.Версия);
	Второе = Служба.ПредставлениеREADME(Пул, Пакет, Версия);
	Ожидаем.Что(Второе.ЕстьREADME, "второе чтение обходится диском").ЭтоИстина();
	Ожидаем.Что(Второе.HTML, "и отдаёт то же самое").Равно(Первое.HTML);

КонецПроцедуры

// «README нет» — такой же ответ, и он тоже запоминается: иначе страница пакета без
// описания распаковывала бы .ospx на каждый показ.
&Тест
Процедура ВерсияБезREADMEЗапоминаетсяПустымФайлом() Экспорт

	Пул = НовыйПул("noreadme-disk-pool");
	Принятое = ПринятьВерсию(Пул, "silent-pkg", "1.0.0", "");

	Ожидаем.Что(ФайлОписанияЕсть(Пул.Имя, "silent-pkg", "1.0.0"),
		"пустое описание тоже лежит файлом").ЭтоИстина();
	Ожидаем.Что(РазмерФайлаОписания(Пул.Имя, "silent-pkg", "1.0.0"),
		"и он пуст").Равно(0);

	Представление = Поделка.НайтиЖелудь("СлужбаREADME").ПредставлениеREADME(
		Пул, Принятое.Пакет, Принятое.Версия);
	Ожидаем.Что(Представление.ЕстьREADME, "страница показывает заглушку").ЭтоЛожь();
	Ожидаем.Что(Представление.HTML).Равно("");

КонецПроцедуры

// Вызывающий, который пакет не читал (переиндексация уже лежащего артефакта), пустышку
// не пишет: иначе «не знаю» превратилось бы в «README нет» навсегда.
&Тест
Процедура ПриёмБезПрочитанногоПакетаОписаниеНеТрогает() Экспорт

	Пул = НовыйПул("unknown-readme-pool");
	ПринятьВерсию(Пул, "unknown-pkg", "1.0.0", Неопределено);

	Ожидаем.Что(ФайлОписанияЕсть(Пул.Имя, "unknown-pkg", "1.0.0"),
		"описания на диске нет — читать было нечего").ЭтоЛожь();

КонецПроцедуры

// Уборка пакета уносит и описания его версий: файл лежит в области пула и место занимает.
&Тест
Процедура УборкаПакетаУноситОписанияВерсий() Экспорт

	Пул = НовыйПул("cleanup-readme-pool");
	Принятое = ПринятьВерсию(Пул, "cleanup-pkg", "1.0.0", "# Уходит вместе с пакетом");
	ПринятьВерсию(Пул, "cleanup-pkg", "1.1.0", "# И эта тоже");

	Ожидаем.Что(ФайлОписанияЕсть(Пул.Имя, "cleanup-pkg", "1.0.0"),
		"самотест: описание первой версии на диске").ЭтоИстина();

	Поделка.НайтиЖелудь("УборкаПакета").УдалитьПакет(Принятое.Пакет);

	Ожидаем.Что(ФайлОписанияЕсть(Пул.Имя, "cleanup-pkg", "1.0.0"),
		"описание первой версии снято").ЭтоЛожь();
	Ожидаем.Что(ФайлОписанияЕсть(Пул.Имя, "cleanup-pkg", "1.1.0"),
		"и второй тоже").ЭтоЛожь();
	Ожидаем.Что(Поделка.НайтиЖелудь("УчётОбъёмаПула").ЗанятоБайт(ОбновлённыйПул(Пул)),
		"занятое пула вернулось к нулю").Равно(0);

КонецПроцедуры

&Тест
Процедура READMEСGFMДоходитДоСтраницыРазметкой() Экспорт

	Пул = НовыйПул("gfm-pool");
	Пакет = ЗарегистрироватьПакет(Пул.Идентификатор, "gfm-pkg");
	Версия = ОпубликоватьВерсию(Пакет.Идентификатор, "1.0.0");

	ПоложитьАртефактСREADME(Пул.Имя, Пакет.Имя, Версия.Версия, Фикстура.READMEвСтилеGitHub());

	Представление = Поделка.НайтиЖелудь("СлужбаREADME").ПредставлениеREADME(Пул, Пакет, Версия);

	Ожидаем.Что(Представление.ЕстьREADME, "README извлечён из артефакта").ЭтоИстина();

	HTML = НРег(Представление.HTML);
	Ожидаем.Что(СтрНайти(HTML, "<table>") > 0, "таблица README отрисована разметкой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<td>install</td>") > 0, "ячейка таблицы на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "align=""right""") > 0, "выравнивание колонки сохранено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "| --- |"), "таблица не осталась палками в тексте").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "type=""checkbox""") > 0, "чекбоксы списка задач на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "[x]"), "скобочная запись задачи не вывалилась текстом").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<del>устарело</del>") > 0, "зачёркивание отрисовано").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<a href=""https://hub.oscript.io/package/winow""") > 0,
		"голый адрес стал ссылкой").ЭтоИстина();

	Ожидаем.Что(СтрНайти(HTML, "<script"), "script из ячейки не выжил тегом").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "xss-cell") > 0, "содержимое script осталось текстом ячейки").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВерсияБезАртефактаДаётЗаглушку() Экспорт

	Пул = НовыйПул("noreadme-pool");
	Пакет = ЗарегистрироватьПакет(Пул.Идентификатор, "empty-pkg");
	Версия = ОпубликоватьВерсию(Пакет.Идентификатор, "1.0.0");

	Представление = Поделка.НайтиЖелудь("СлужбаREADME").ПредставлениеREADME(Пул, Пакет, Версия);

	Ожидаем.Что(Представление.ЕстьREADME, "без артефакта README отсутствует").ЭтоЛожь();
	Ожидаем.Что(Представление.HTML).Равно("");

	// «артефакт недоступен» запоминать НЕЛЬЗЯ: моргнувшее хранилище оставило бы версию
	// без описания навсегда — пустышку пишет только ПРОЧИТАННЫЙ пакет
	Ожидаем.Что(ФайлОписанияЕсть(Пул.Имя, Пакет.Имя, Версия.Версия),
		"недоступный артефакт пустого описания не оставил").ЭтоЛожь();

	// и следующее чтение по-прежнему идёт к артефакту: вернулся артефакт — вернулся README
	ПоложитьАртефактСREADME(Пул.Имя, Пакет.Имя, Версия.Версия, "# Хранилище вернулось");
	Второе = Поделка.НайтиЖелудь("СлужбаREADME").ПредставлениеREADME(Пул, Пакет, Версия);
	Ожидаем.Что(Второе.ЕстьREADME, "как только артефакт доступен, README показывается").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура БезВерсииREADMEОтсутствует() Экспорт

	Пул = НовыйПул("noversion-pool");
	Пакет = ЗарегистрироватьПакет(Пул.Идентификатор, "no-version-pkg");

	Представление = Поделка.НайтиЖелудь("СлужбаREADME").ПредставлениеREADME(Пул, Пакет, Неопределено);
	Ожидаем.Что(Представление.ЕстьREADME).ЭтоЛожь();

КонецПроцедуры

// Списки главной проходят тот же отбор, что и числа: имя приватного пула и его пакета
// не должно всплыть ни в обзоре пулов, ни в ленте новинок.
&Тест
Процедура ОбзорГлавнойНеНазываетПриватноеАнонимуИНазываетУчастнику() Экспорт

	Ключ = Лев(Строка(Новый УникальныйИдентификатор()), 8);
	Витрина = Поделка.НайтиЖелудь("ВитринаГлавной");

	Приватный = Поделка.НайтиЖелудь("СервисПулов").СоздатьПул("den-" + Ключ, "custom", "private");
	Пакет = ЗарегистрироватьПакет(Приватный.Идентификатор, "denpkg-" + Ключ);
	ОпубликоватьВерсию(Пакет.Идентификатор, "1.0.0");

	Участник = ЗавестиУчётку("den-in-" + Ключ, "user");
	ДатьЧтение(Приватный.Идентификатор, Участник.Идентификатор);

	Аноним = Витрина.Обзор();
	Ожидаем.Что(ИменаПулов(Аноним).Найти(Приватный.Имя),
		"аноним не видит приватный пул в обзоре").Равно(Неопределено);
	Ожидаем.Что(ИменаПакетов(Аноним.Новинки).Найти(Пакет.Имя),
		"и его пакет в новинках").Равно(Неопределено);

	Свой = Витрина.Обзор(Участник);
	Ожидаем.Что(ИменаПулов(Свой).Найти(Приватный.Имя) <> Неопределено,
		"участник видит свой приватный пул в обзоре").ЭтоИстина();
	Ожидаем.Что(ИменаПакетов(Свой.Новинки).Найти(Пакет.Имя) <> Неопределено,
		"и его свежую версию в новинках").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОбзорГлавнойНеОтдаётБольшеПределовИПропускаетЛичныеПулы() Экспорт

	Ключ = Лев(Строка(Новый УникальныйИдентификатор()), 8);
	СервисПулов = Поделка.НайтиЖелудь("СервисПулов");
	Витрина = Поделка.НайтиЖелудь("ВитринаГлавной");

	Для Номер = 1 По Витрина.ПределПулов() + 2 Цикл
		СервисПулов.СоздатьПул(СтрШаблон("lim%1-%2", Формат(Номер, "ЧН=0; ЧГ=0"), Ключ), "custom");
	КонецЦикла;

	Личный = СервисПулов.СоздатьЛичныйПул("lim-me-" + Ключ, 0);

	Обзор = Витрина.Обзор();

	Ожидаем.Что(Обзор.Пулы.Количество(), "обзор пулов ограничен своим пределом")
		.Равно(Витрина.ПределПулов());
	Ожидаем.Что(Обзор.Новинки.Количество() <= Витрина.ПределСписка(),
		"новинок не больше предела списка").ЭтоИстина();
	Ожидаем.Что(Обзор.Популярные.Количество() <= Витрина.ПределСписка(),
		"популярных не больше предела списка").ЭтоИстина();
	Ожидаем.Что(ИменаПулов(Обзор).Найти(Личный.Имя),
		"личное пространство в обзор не идёт").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ПопулярноеБерётСкачиванияИНеПоказываетНулевые() Экспорт

	Ключ = Лев(Строка(Новый УникальныйИдентификатор()), 8);
	Пул = Поделка.НайтиЖелудь("СервисПулов").СоздатьПул("pop-" + Ключ, "custom");

	Лидер = ЗарегистрироватьПакет(Пул.Идентификатор, "pop-top-" + Ключ);
	Второй = ЗарегистрироватьПакет(Пул.Идентификатор, "pop-mid-" + Ключ);
	ЗарегистрироватьПакет(Пул.Идентификатор, "pop-zero-" + Ключ);

	ВерсияЛидера = ОпубликоватьВерсию(Лидер.Идентификатор, "1.0.0");
	ВерсияВторого = ОпубликоватьВерсию(Второй.Идентификатор, "1.0.0");

	Статистика = Поделка.НайтиЖелудь("СлужбаСтатистикиСкачиваний");
	Для Счёт = 1 По 5 Цикл
		Статистика.ЗафиксироватьСкачивание(Лидер.Идентификатор, ВерсияЛидера.Идентификатор);
	КонецЦикла;
	Статистика.ЗафиксироватьСкачивание(Второй.Идентификатор, ВерсияВторого.Идентификатор);
	Статистика.Сбросить();

	Популярные = Поделка.НайтиЖелудь("ВитринаГлавной").Обзор().Популярные;
	Имена = ИменаПакетов(Популярные);

	Ожидаем.Что(Имена.Найти(Лидер.Имя), "самый скачиваемый — первый в списке").Равно(0);
	Ожидаем.Что(Имена.Найти(Второй.Имя) <> Неопределено, "второй по скачиваниям тоже в списке").ЭтоИстина();
	Ожидаем.Что(Имена.Найти("pop-zero-" + Ключ),
		"пакет без единого скачивания в популярное не идёт").Равно(Неопределено);

	// карточка популярного печатает и дату обновления, поэтому запись её несёт
	Ожидаем.Что(ЗначениеЗаполнено(Популярные[0].Обновлена),
		"в записи популярного есть дата последней публикации").ЭтоИстина();

КонецПроцедуры

// Даты обновления для всего блока популярного берутся ОДНИМ разрезом: запрос на карточку
// превратил бы главную — самую посещаемую страницу — в N+1. Меряем запросами хранилища:
// счётчик на сервисе не увидел бы цикл, спрятанный внутри самого сервиса.
&Тест
Процедура ДатыОбновленияПопулярногоБерутсяОднимЗапросом() Экспорт

	Ключ = Лев(Строка(Новый УникальныйИдентификатор()), 8);
	Пул = Поделка.НайтиЖелудь("СервисПулов").СоздатьПул("cnt-" + Ключ, "custom");
	Статистика = Поделка.НайтиЖелудь("СлужбаСтатистикиСкачиваний");

	Для Номер = 1 По 3 Цикл
		Пакет = ЗарегистрироватьПакет(Пул.Идентификатор,
			СтрШаблон("cnt%1-%2", Формат(Номер, "ЧН=0; ЧГ=0"), Ключ));
		Версия = ОпубликоватьВерсию(Пакет.Идентификатор, "1.0.0");
		ОпубликоватьВерсию(Пакет.Идентификатор, "1.1.0");
		Статистика.ЗафиксироватьСкачивание(Пакет.Идентификатор, Версия.Идентификатор);
	КонецЦикла;
	Статистика.Сбросить();

	Считающее = Новый СчитающееХранилищеВерсий(Поделка.НайтиЖелудь("ХранилищеВерсийПакета"));
	Витрина = Новый ВитринаГлавной(
		Поделка.НайтиЖелудь("ВидимоеСодержимое"),
		Поделка.НайтиЖелудь("СтатистикаХаба"),
		Новый СервисВерсий(Считающее,
			Поделка.НайтиЖелудь("ХранилищеПакетов"),
			Поделка.НайтиЖелудь("СравнительВерсий"),
			Поделка.НайтиЖелудь("РезолверВерсий"),
			Поделка.НайтиЖелудь("СервисПроисхождения"),
			Неопределено),
		Поделка.НайтиЖелудь("СлужбаСтатистикиСкачиваний"));

	Популярные = Витрина.Обзор().Популярные;

	// замер не должен мерить пустую работу: карточки есть и даты в них проставлены
	Ожидаем.Что(Популярные.Количество() >= 3, "в популярном не меньше трёх карточек").ЭтоИстина();
	Для Каждого Запись Из Популярные Цикл
		Ожидаем.Что(ЗначениеЗаполнено(Запись.Обновлена),
			"у карточки «" + Запись.Пакет.Имя + "» есть дата обновления").ЭтоИстина();
	КонецЦикла;

	Запросов = Считающее.Запросов();
	Ожидаем.Что(Запросов.ВерсииПакетов,
		"даты всего блока получены одним разрезом").Равно(1);
	Ожидаем.Что(Запросов.НаОдинПакет,
		СтрШаблон("запросов «на один пакет» не делается вовсе (%1)",
			Формат(Запросов.НаОдинПакет, "ЧГ=0"))).Равно(0);

КонецПроцедуры

// Витрина, а не лента: блок главной вмещает 4–6 карточек, и при избытке кандидатов
// заполняется ровно до предела.
&Тест
Процедура БлокГлавнойВмещаетОтЧетырёхДоШестиКарточек() Экспорт

	Ключ = Лев(Строка(Новый УникальныйИдентификатор()), 8);
	Витрина = Поделка.НайтиЖелудь("ВитринаГлавной");
	Предел = Витрина.ПределСписка();

	Ожидаем.Что(Предел >= 4 И Предел <= 6, "предел блока главной — витрина на 4–6 карточек").ЭтоИстина();

	Пул = Поделка.НайтиЖелудь("СервисПулов").СоздатьПул("many-" + Ключ, "custom");
	Для Номер = 1 По Предел + 2 Цикл
		Пакет = ЗарегистрироватьПакет(Пул.Идентификатор,
			СтрШаблон("many%1-%2", Формат(Номер, "ЧН=0; ЧГ=0"), Ключ));
		ОпубликоватьВерсию(Пакет.Идентификатор, "1.0.0");
	КонецЦикла;

	Ожидаем.Что(Витрина.Обзор().Новинки.Количество(),
		"кандидатов больше предела — блок заполнен ровно до предела").Равно(Предел);

КонецПроцедуры

Функция ИменаПулов(Знач Обзор)

	Результат = Новый Массив();
	Для Каждого Запись Из Обзор.Пулы Цикл
		Результат.Добавить(Запись.Пул.Имя);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ИменаПакетов(Знач Записи)

	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Результат.Добавить(Запись.Пакет.Имя);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЗавестиУчётку(Знач Логин, Знач Роль)

	Учётка = Поделка.НайтиЖелудь("ХранилищеПользователей").СоздатьЭлемент();
	Учётка.Логин = Логин;
	Учётка.Email = Логин + "@ex.com";
	Учётка.EmailПодтверждён = Ложь;
	Учётка.ХешПароля = "";
	Учётка.Активен = Истина;
	Учётка.РольХаба = Роль;
	Учётка.ТребуетсяСменаПароля = Ложь;
	Учётка.Создан = ТекущаяУниверсальнаяДата();
	Учётка.Сохранить();
	Возврат Учётка;

КонецФункции

Процедура ДатьЧтение(Знач ПулИдентификатор, Знач ПользовательИдентификатор)

	Участие = Поделка.НайтиЖелудь("ХранилищеУчастниковПула").СоздатьЭлемент();
	Участие.ПулИдентификатор = ПулИдентификатор;
	Участие.ТипСубъекта = "пользователь";
	Участие.СубъектИдентификатор = ПользовательИдентификатор;
	Участие.Роль = "читатель";
	Участие.Сохранить();

КонецПроцедуры

Функция НовыйПул(Знач Имя)
	Возврат Поделка.НайтиЖелудь("СервисПулов").СоздатьПул(Имя);
КонецФункции

Функция ЗарегистрироватьПакет(Знач ПулИдентификатор, Знач Имя)
	Возврат Поделка.НайтиЖелудь("СервисПакетов").ЗарегистрироватьПакет(ПулИдентификатор, Имя,
		Новый Структура("Описание", "Описание пакета " + Имя));
КонецФункции

Функция ОпубликоватьВерсию(Знач ПакетИдентификатор, Знач Строка)
	Возврат Поделка.НайтиЖелудь("СервисВерсий").Опубликовать(
		Новый ЗаявкаНаПубликацию(ПакетИдентификатор, Строка));
КонецФункции

// Приём версии — то же ядро, которым пользуются push, зеркало и прокси; ТекстREADME
// Неопределено означает «вызывающий пакет не читал».
Функция ПринятьВерсию(Знач Пул, Знач ИмяПакета, Знач Версия, Знач ТекстREADME)

	Артефакт = Новый Структура("Размер, Sha256", 0, "");
	Возврат Поделка.НайтиЖелудь("ПриёмВерсии").ПринятьВнешнюю(
		Пул, ИмяПакета, Версия, Неопределено, Артефакт, , ТекстREADME);

КонецФункции

// Имя файла описания здесь написано руками: сторож обязан ловить и переименование.
Функция КоординатыОписания(Знач ИмяПула, Знач ИмяПакета, Знач Версия)
	Возврат Новый КоординатыАртефакта(ИмяПула, ИмяПакета, Версия,
		ИмяПакета + "-" + Версия + ".readme.md");
КонецФункции

Функция ФайлОписанияЕсть(Знач ИмяПула, Знач ИмяПакета, Знач Версия)
	Возврат Поделка.НайтиЖелудь("ХранилищеАртефактов").Существует(
		КоординатыОписания(ИмяПула, ИмяПакета, Версия));
КонецФункции

Функция РазмерФайлаОписания(Знач ИмяПула, Знач ИмяПакета, Знач Версия)
	Возврат Поделка.НайтиЖелудь("ХранилищеАртефактов").Размер(
		КоординатыОписания(ИмяПула, ИмяПакета, Версия));
КонецФункции

Функция ТекстФайлаОписания(Знач ИмяПула, Знач ИмяПакета, Знач Версия)
	Данные = Поделка.НайтиЖелудь("ХранилищеАртефактов").ПолучитьДанные(
		КоординатыОписания(ИмяПула, ИмяПакета, Версия));
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, "UTF-8");
КонецФункции

Функция АртефактЕсть(Знач ИмяПула, Знач ИмяПакета, Знач Версия)
	Возврат Поделка.НайтиЖелудь("ХранилищеАртефактов").Существует(
		Новый КоординатыАртефакта(ИмяПула, ИмяПакета, Версия));
КонецФункции

Процедура УбратьАртефакт(Знач ИмяПула, Знач ИмяПакета, Знач Версия)
	Поделка.НайтиЖелудь("ХранилищеАртефактов").Удалить(
		Новый КоординатыАртефакта(ИмяПула, ИмяПакета, Версия));
КонецПроцедуры

// Счётчик занятого живёт в строке пула — перечитываем её, а не смотрим в старый объект.
Функция ОбновлённыйПул(Знач Пул)
	Возврат Поделка.НайтиЖелудь("СервисПулов").ПулПоИдентификатору(Цел(Пул.Идентификатор));
КонецФункции

Процедура ПоложитьАртефактСREADME(Знач ИмяПула, Знач ИмяПакета, Знач Версия, Знач ТекстReadme)

	КаталогСборки = ОбъединитьПути(КаталогВременныхФайлов(), "ospx-" + Лев(Строка(Новый УникальныйИдентификатор()), 8));
	СоздатьКаталог(КаталогСборки);

	ПутьOspx = Фикстура.ПостроитьOspx(КаталогСборки, ИмяПакета, Версия, ТекстReadme);

	Координаты = Новый КоординатыАртефакта(ИмяПула, ИмяПакета, Версия);
	Поделка.НайтиЖелудь("ХранилищеАртефактов").Сохранить(Координаты, ПутьOspx);

КонецПроцедуры

Процедура ПодключитьКлассыКаталога(Знач КаталогКлассов)
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		Подключить(ФайлКласса.ПолноеИмя, ФайлКласса.ИмяБезРасширения);
	КонецЦикла;
КонецПроцедуры

Процедура Подключить(Знач ПолныйПуть, Знач ИмяКласса)
	Если НЕ ТипЗарегистрирован(ИмяКласса) Тогда
		ПодключитьСценарий(ПолныйПуть, ИмяКласса);
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции
