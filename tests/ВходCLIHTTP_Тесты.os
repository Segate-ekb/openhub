// HTTP-интеграционные тесты входа CLI (RFC 8628) на живом хабе: инициация клиентом,
// подтверждение человеком в браузере, опрос до выдачи PAT, отказ и защиты потока.

#Использовать asserts
#Использовать "фикстуры"

Перем Хаб;
Перем Клиент; // фикстура КлиентХаба — запросы к подопытному хабу
Перем КукаПользователя;   // сессия браузера подопытного человека
Перем ЛогинПользователя;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	ЛогинПользователя = "clihuman";
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб, 15);
	Хаб.ФайловаяБаза("openhub-cli-вход");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	// инсталляция без почты выбирает одну из двух развилок (ИСТ-ПОЧТ-007); здесь —
	// выключенное подтверждение адреса, иначе регистрация закрыта
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	// короткая блокировка ограничителя: набор проверяет и сам перебор, и работу после него
	Хаб.Среда("OSHUB_AUTH_LOGIN_LOCKOUTSECONDS", "2");
	Хаб.Запустить();

	// первый админ закрывает онбординг, дальше работаем обычным пользователем
	Клиент.POSTJSON("/setup", "{""логин"":""root"",""пароль"":""SuperSecret1""}");
	Регистрация = Клиент.POSTJSON("/api/v1/register",
		СтрШаблон("{""логин"":""%1"",""email"":""cli@example.com"",""пароль"":""password123""}",
			ЛогинПользователя));
	КукаПользователя = Клиент.КукаСессии(Регистрация);

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область СчастливыйПуть

&Тест
Процедура ПолныйЦиклВходаCLIЧерезБраузер() Экспорт

	Заявка = Клиент.ТелоJSON(НачатьЗаявку("opm 1.6.6 на ci", "read,write"));

	Ожидаем.Что(СтрДлина(Строка(Заявка.Получить("device_code"))) >= 48, "device_code").ЭтоИстина();
	КодЧеловека = Строка(Заявка.Получить("user_code"));
	Ожидаем.Что(СтрДлина(КодЧеловека), "user_code вида XXXX-XXXX").Равно(9);
	Ожидаем.Что(Заявка.Получить("expires_in"), "срок жизни заявки").Равно(600);
	Ожидаем.Что(Заявка.Получить("interval"), "интервал опроса").Равно(5);
	Ожидаем.Что(СтрЗаканчиваетсяНа(Строка(Заявка.Получить("verification_uri")), "/cli/login"),
		"адрес подтверждения: " + Строка(Заявка.Получить("verification_uri"))).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка(Заявка.Получить("verification_uri_complete")),
		"user_code=") > 0, "полный адрес несёт код").ЭтоИстина();

	// до решения человека клиент получает authorization_pending
	Ответ = Опрос(Заявка.Получить("device_code"));
	Ожидаем.Что(Ответ.КодСостояния, "ожидание — это 400").Равно(400);
	Ожидаем.Что(Клиент.ТелоJSON(Ответ).Получить("error")).Равно("authorization_pending");

	// опрос сразу же — slow_down
	Ожидаем.Что(Клиент.ТелоJSON(Опрос(Заявка.Получить("device_code"))).Получить("error")).Равно("slow_down");

	// страница подтверждения по сессии показывает код, клиента и права
	Страница = Клиент.GETСКукой("/cli/login?user_code=" + КодЧеловека, КукаПользователя);
	Ожидаем.Что(Страница.КодСостояния).Равно(200);
	ТелоСтраницы = Клиент.Тело(Страница);
	Ожидаем.Что(СтрНайти(ТелоСтраницы, КодЧеловека) > 0, "на странице виден код").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоСтраницы, "opm 1.6.6 на ci") > 0, "и имя клиента").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоСтраницы, "read,write") > 0, "и запрошенные права").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоСтраницы, "Разрешить") > 0, "и кнопка разрешения").ЭтоИстина();

	// человек разрешает
	Поля = Новый Соответствие();
	Поля.Вставить("user_code", КодЧеловека);
	Поля.Вставить("действие", "разрешить");
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(ТелоСтраницы));
	Решение = Клиент.POSTФормы("/cli/login", Поля, КукаПользователя);
	Ожидаем.Что(Решение.КодСостояния, "форма подтверждения принята").Равно(200);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Решение), "Вход разрешён") > 0, "страница подтверждает разрешение").ЭтоИстина();

	// клиент забирает ключ — значение отдаётся только здесь
	Выдача = Клиент.ТелоJSON(ОпросДоРешения(Заявка.Получить("device_code")));
	Токен = Строка(Выдача.Получить("access_token"));
	Ожидаем.Что(СтрНачинаетсяС(Токен, "oshub_"), "выдан PAT").ЭтоИстина();
	Ожидаем.Что(Выдача.Получить("token_type")).Равно("Bearer");
	Ожидаем.Что(Выдача.Получить("scope")).Равно("read,write");
	Ожидаем.Что(Число(Выдача.Получить("token_id")) > 0, "идентификатор ключа").ЭтоИстина();

	// ключ работает и опознаётся как ключ этого человека
	КтоЯ = Клиент.GETСТокеном("/api/v1/whoami", Токен);
	Ожидаем.Что(КтоЯ.КодСостояния).Равно(200);
	Ожидаем.Что(Клиент.ТелоJSON(КтоЯ).Получить("user").Получить("login")).Равно(ЛогинПользователя);

	// в кабинете ключ виден под именем происхождения, самого значения в списке нет
	Список = Клиент.Тело(Клиент.GETСКукой("/api/v1/tokens", КукаПользователя));
	Ожидаем.Что(СтрНайти(Список, "opm CLI") > 0, "имя ключа названо: " + Список).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Список, Токен), "значение ключа в списке не светится").Равно(0);

	// повторный опрос той же заявки ничего не даёт
	Ожидаем.Что(Клиент.ТелоJSON(ОпросДоРешения(Заявка.Получить("device_code"))).Получить("error"))
		.Равно("expired_token");

КонецПроцедуры

#КонецОбласти

#Область Отказы

&Тест
Процедура ОтказЧеловекаЗакрываетЗаявку() Экспорт

	Заявка = Клиент.ТелоJSON(НачатьЗаявку("opm на чужой машине", "read"));
	КодЧеловека = Строка(Заявка.Получить("user_code"));

	Страница = Клиент.Тело(Клиент.GETСКукой("/cli/login?user_code=" + КодЧеловека, КукаПользователя));

	Поля = Новый Соответствие();
	Поля.Вставить("user_code", КодЧеловека);
	Поля.Вставить("действие", "отклонить");
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Страница));
	Решение = Клиент.POSTФормы("/cli/login", Поля, КукаПользователя);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Решение), "Вход отклонён") > 0, "страница подтверждает отказ").ЭтоИстина();

	Ответ = ОпросДоРешения(Заявка.Получить("device_code"));
	Ожидаем.Что(Ответ.КодСостояния).Равно(400);
	Ожидаем.Что(Клиент.ТелоJSON(Ответ).Получить("error")).Равно("access_denied");

КонецПроцедуры

&Тест
Процедура НеизвестныйИлиЧужойКодУстройстваНеОткрываетНичего() Экспорт

	Ответ = Опрос("00000000000000000000000000000000000000000000000000000000");
	Ожидаем.Что(Ответ.КодСостояния).Равно(400);
	Ожидаем.Что(Клиент.ТелоJSON(Ответ).Получить("error")).Равно("expired_token");

	Ожидаем.Что(Клиент.ТелоJSON(Опрос("")).Получить("error")).Равно("expired_token");

КонецПроцедуры

&Тест
Процедура НеизвестноеПравоЗаявкуНеЗаводит() Экспорт

	Ответ = НачатьЗаявку("opm", "admin");
	Ожидаем.Что(Ответ.КодСостояния).Равно(400);
	Ожидаем.Что(Клиент.ТелоJSON(Ответ).Получить("error"), "код ошибки — в форме RFC 8628")
		.Равно("invalid_scope");

КонецПроцедуры

&Тест
Процедура ТочкиПотокаОтвечаютТолькоНаPOST() Экспорт

	Ответ = Клиент.GET("/api/v1/cli/auth/device");
	Ожидаем.Что(Ответ.КодСостояния).Равно(405);
	Ожидаем.Что(Клиент.ТелоJSON(Ответ).Получить("error"), "и здесь форма ошибки одна на весь поток")
		.Равно("invalid_request");
	Ожидаем.Что(Клиент.GET("/api/v1/cli/auth/device/token").КодСостояния).Равно(405);

КонецПроцедуры

#КонецОбласти

#Область ЗащитаПодтверждения

&Тест
&Тег("смоук")
Процедура АнонимаУводитНаВходСВозвратомНаЭтуЖеСтраницу() Экспорт

	Заявка = Клиент.ТелоJSON(НачатьЗаявку("opm", "read"));
	КодЧеловека = Строка(Заявка.Получить("user_code"));

	// клиент сам идёт по редиректу, поэтому в ответе — уже страница входа
	Ответ = Клиент.GET("/cli/login?user_code=" + КодЧеловека);
	Ожидаем.Что(Ответ.КодСостояния < 400, "аноним не получает ошибку").ЭтоИстина();

	ТелоОтвета = Клиент.Тело(Ответ);
	Ожидаем.Что(СтрНайти(ТелоОтвета, "action=""/login""") > 0, "показана форма входа").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоОтвета, "/cli/login") > 0,
		"вход помнит, куда вернуть человека").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТелоОтвета, КодЧеловека) > 0, "и с каким кодом").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВозвратПослеВходаПринимаетсяТолькоСвой() Экспорт

	Свой = Клиент.GET("/login?next=" + КодироватьСтроку("/cli/login?user_code=ABCD-EFGH",
		СпособКодированияСтроки.КодировкаURL));
	Ожидаем.Что(СтрНайти(Клиент.Тело(Свой), "name=""next"" value=""/cli/login?user_code=ABCD-EFGH""") > 0,
		"свой путь возврата доезжает до формы входа").ЭтоИстина();

	Чужой = Клиент.GET("/login?next=" + КодироватьСтроку("https://evil.example/украсть",
		СпособКодированияСтроки.КодировкаURL));
	Ожидаем.Что(СтрНайти(Клиент.Тело(Чужой), "evil.example"),
		"чужой адрес в форму входа не попадает").Равно(0);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Чужой), "name=""next"""),
		"и поля возврата на странице нет вовсе").Равно(0);

КонецПроцедуры

&Тест
Процедура КлючомПодтвердитьВходНельзя() Экспорт

	Заявка = Клиент.ТелоJSON(НачатьЗаявку("opm", "read"));
	КодЧеловека = Строка(Заявка.Получить("user_code"));

	ОтветКлюча = Клиент.GETСТокеном("/cli/login?user_code=" + КодЧеловека, ВыпуститьКлюч());
	Ожидаем.Что(ОтветКлюча.КодСостояния, "ключ не подтверждает вход").Равно(403);

	// заявка после этого по-прежнему ждёт человека
	Ожидаем.Что(Клиент.ТелоJSON(Опрос(Заявка.Получить("device_code"))).Получить("error"))
		.Равно("authorization_pending");

КонецПроцедуры

&Тест
Процедура ФормаБезВерногоCSRFРешенияНеПринимает() Экспорт

	Заявка = Клиент.ТелоJSON(НачатьЗаявку("opm", "read"));
	КодЧеловека = Строка(Заявка.Получить("user_code"));

	Поля = Новый Соответствие();
	Поля.Вставить("user_code", КодЧеловека);
	Поля.Вставить("действие", "разрешить");
	Поля.Вставить("_csrf", "деадбиф");
	Ожидаем.Что(Клиент.POSTФормы("/cli/login", Поля, КукаПользователя).КодСостояния).Равно(403);

	Ожидаем.Что(Клиент.ТелоJSON(Опрос(Заявка.Получить("device_code"))).Получить("error"),
		"чужая форма заявку не одобрила").Равно("authorization_pending");

КонецПроцедуры

&Тест
Процедура ПодборКодаБлокируетсяОграничителем() Экспорт

	// у ограничителя общий с входом порог (5 по умолчанию): серия неизвестных кодов
	// от одного человека упирается в блокировку
	Заблокировано = Ложь;
	Для НомерПопытки = 1 По 8 Цикл
		Ответ = Клиент.GETСКукой("/cli/login?user_code=ZZZZ-ZZZ" + Сред("ABCDEFGH", НомерПопытки, 1),
			КукаПользователя);
		Если Ответ.КодСостояния = 429 Тогда
			Заблокировано = Истина;
			Прервать;
		КонецЕсли;
		Ожидаем.Что(Ответ.КодСостояния, "неизвестный код — 404 до блокировки").Равно(404);
	КонецЦикла;

	Ожидаем.Что(Заблокировано, "перебор кодов упирается в ограничитель").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Инфраструктура

Функция НачатьЗаявку(Знач ИмяКлиента, Знач Права)
	Возврат Клиент.POSTJSON("/api/v1/cli/auth/device",
		СтрШаблон("{""client_name"":""%1"",""scopes"":""%2""}", ИмяКлиента, Права));
КонецФункции

Функция Опрос(Знач КодУстройства)
	Возврат Клиент.POSTJSON("/api/v1/cli/auth/device/token",
		СтрШаблон("{""device_code"":""%1""}", Строка(КодУстройства)));
КонецФункции

// Клиент обязан выдерживать интервал опроса — здесь это ожидание и воспроизводится.
Функция ОпросДоРешения(Знач КодУстройства)

	Ответ = Опрос(КодУстройства);
	Для НомерПопытки = 1 По 10 Цикл
		Если СтрНайти(Клиент.Тело(Ответ), "slow_down") = 0 Тогда
			Возврат Ответ;
		КонецЕсли;
		// пауза длиннее интервала: каждый опрос сдвигает окно, и 2 секунды не помогли бы
		Приостановить(6000);
		Ответ = Опрос(КодУстройства);
	КонецЦикла;

	Возврат Ответ;

КонецФункции

Функция ВыпуститьКлюч()
	Ответ = Клиент.POSTJSON("/api/v1/tokens", "{""права"":""read,write""}", КукаПользователя);
	Возврат Строка(Клиент.ТелоJSON(Ответ).Получить("token_info").Получить("token"));
КонецФункции

#КонецОбласти
