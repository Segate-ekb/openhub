	СервисПакетов = Поделка.НайтиЖелудь("СервисПакетов");

	БылоИсключение = Ложь;
	Попытка
		СервисПакетов.ЗарегистрироватьПакет(Пул.Идентификатор, "не латиница");
	Исключение
