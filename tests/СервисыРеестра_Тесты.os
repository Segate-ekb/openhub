КонецПроцедуры

&Тест
Процедура ПубликацияЗаполняетSemverКолонкиПоКонтракту() Экспорт

	Пакет = НовыйПакет("ver-pool-1", "semver-pkg");
	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");

	Заявка = Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.2.3-rc.1+build.5");
	Заявка.Размер = 2048;
	Заявка.Sha256 = "abc123";
	Заявка.ВерсияДвижка = "1.9.0";
	Заявка.АвторМанифеста = "автор";
	Заявка.ОпубликовалИдентификатор = 5;
	Заявка.ПутьВХранилище = "pools/ver-pool-1/semver-pkg/semver-pkg-1.2.3-rc.1+build.5.ospx";

	Версия = СервисВерсий.Опубликовать(Заявка);

	Ожидаем.Что(Версия.Идентификатор).Существует();
	Ожидаем.Что(Версия.Версия).Равно("1.2.3-rc.1+build.5");
	Ожидаем.Что(Версия.SemverМажор).Равно(1);
	Ожидаем.Что(Версия.SemverМинор).Равно(2);
	Ожидаем.Что(Версия.SemverПатч).Равно(3);
	Ожидаем.Что(Версия.SemverПререлиз).Равно("rc.1");
	Ожидаем.Что(Версия.SemverСборка).Равно("build.5");
	Ожидаем.Что(Версия.ПризнакLegacyВерсии).Равно(Ложь);
	Ожидаем.Что(Версия.Отозвана).Равно(Ложь);
	Ожидаем.Что(Версия.Размер).Равно(2048);
	Ожидаем.Что(Версия.Sha256).Равно("abc123");
	Ожидаем.Что(Версия.ОпубликовалИдентификатор).Равно(5);

КонецПроцедуры

&Тест
Процедура ПубликацияLegacyВерсииПоКонтрактуХранения() Экспорт

	Пакет = НовыйПакет("ver-pool-2", "legacy-pkg");
	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");

	Версия = СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.2.3.4"));

	Ожидаем.Что(Версия.Версия, "строка версии хранит все 4 компоненты").Равно("1.2.3.4");
	Ожидаем.Что(Версия.ПризнакLegacyВерсии).Равно(Истина);
	Ожидаем.Что(Версия.SemverМажор).Равно(1);
	Ожидаем.Что(Версия.SemverМинор).Равно(2);
	Ожидаем.Что(Версия.SemverПатч).Равно(3);
	Ожидаем.Что(Версия.SemverПререлиз, "legacy-хвост не пререлиз").Равно("");
	Ожидаем.Что(Версия.SemverСборка, "четвёртая компонента в SemverСборка").Равно("4");

КонецПроцедуры

// Витрине «недавно опубликовано» нужны последние версии хаба, а не все: порядок и предел
// задаёт база, иначе главная вычитывала бы таблицу версий целиком на каждый показ.
&Тест
Процедура ПоследниеВерсииОтдаютНовыеПервымиИНеБольшеЛимита() Экспорт

	Пакет = НовыйПакет("ver-pool-fresh", "fresh-pkg");
	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");

	СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.0.0"));
	СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.0.1"));
	Последняя = СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.0.2"));

	Свежие = СервисВерсий.ПоследниеВерсии(2);

	Ожидаем.Что(Свежие.Количество(), "предел выдачи соблюдён").Равно(2);
	Ожидаем.Что(Свежие[0].Идентификатор, "первой идёт самая свежая версия").Равно(Последняя.Идентификатор);
	Ожидаем.Что(СервисВерсий.ПоследниеВерсии(0).Количество(),
		"нулевой предел — пустая выдача, а не вся таблица").Равно(0);

КонецПроцедуры

// Отметку последней публикации пакет носит в себе: списки берут из неё порядок «свежие
// первыми», не читая версий. Публикация двигает её вперёд, отзыв последней версии
// откатывает на предыдущую действующую, восстановление возвращает обратно.
&Тест
Процедура ОтметкаПоследнейПубликацииЖивётНаПакете() Экспорт

	Пакет = НовыйПакет("ver-pool-mark", "mark-pkg");
	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");
	СервисПакетов = Поделка.НайтиЖелудь("СервисПакетов");

	Ожидаем.Что(ЗначениеЗаполнено(Пакет.ПоследняяПубликация),
		"у пакета без версий отметки нет").ЭтоЛожь();

	Первая = СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.0.0"));
	Вторая = СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.0.1"));

	Ожидаем.Что(Отметка(СервисПакетов, Пакет), "отметка равна публикации свежей версии")
		.Равно(Вторая.Опубликована);

	СервисВерсий.ОтозватьВерсию(Пакет.Идентификатор, "1.0.1");
	Ожидаем.Что(Отметка(СервисПакетов, Пакет), "отзыв свежей версии откатил отметку")
		.Равно(Первая.Опубликована);

	СервисВерсий.ОтозватьВерсию(Пакет.Идентификатор, "1.0.1", Ложь);
	Ожидаем.Что(Отметка(СервисПакетов, Пакет), "восстановление вернуло отметку")
		.Равно(Вторая.Опубликована);

	// чужой пакет отзывом не задет: отметка считается по версиям своего
	Чужой = НовыйПакет("ver-pool-mark-2", "mark-other");
	СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Чужой.Идентификатор, "2.0.0"));
	СервисВерсий.ОтозватьВерсию(Пакет.Идентификатор, "1.0.1");
	Ожидаем.Что(ЗначениеЗаполнено(Отметка(СервисПакетов, Чужой)),
		"отметка соседнего пакета на месте").ЭтоИстина();

	// отозвана последняя действующая версия: публиковаться пакету больше нечем, и
	// «свежий» с датой первой публикации он изображать не вправе
	СервисВерсий.ОтозватьВерсию(Пакет.Идентификатор, "1.0.0");
	Ожидаем.Что(ЗначениеЗаполнено(Отметка(СервисПакетов, Пакет)),
		"без единой действующей версии отметки нет").ЭтоЛожь();

	// переиздание того же номера — тоже публикация: отметка обязана сдвинуться вперёд
	// с пустой, иначе переизданный пакет навсегда остался бы в конце списков
	Переизданная = СервисВерсий.Опубликовать(
		Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.0.0"), Истина);
	Ожидаем.Что(Отметка(СервисПакетов, Пакет), "переиздание сдвинуло отметку вперёд")
		.Равно(Переизданная.Опубликована);

КонецПроцедуры

Функция Отметка(Знач СервисПакетов, Знач Пакет)
	Возврат СервисПакетов.ПакетПоИдентификатору(Пакет.Идентификатор).ПоследняяПубликация;
КонецФункции

&Тест
Процедура ПовторнаяПубликацияВерсииОтклоняется() Экспорт

	Пакет = НовыйПакет("ver-pool-3", "immutable-pkg");
	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");

	СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.0.0"));

	ОписаниеОшибки = "";
	Попытка
		СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.0.0"));
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрДлина(ОписаниеОшибки) > 0, "перезапись версии запрещена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ОписаниеОшибки, "неизменяем") > 0,
		"понятная ошибка про иммутабельность: " + ОписаниеОшибки).ЭтоИстина();
	Ожидаем.Что(СервисВерсий.ВерсииПакета(Пакет.Идентификатор).Количество(), "дубль не создан").Равно(1);

	ДругойПакет = НовыйПакет("ver-pool-4", "other-pkg");
	Другая = СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(ДругойПакет.Идентификатор, "1.0.0"));
	Ожидаем.Что(Другая.Идентификатор).Существует();

КонецПроцедуры

&Тест
Процедура ПубликацияМусорнойВерсииОтклоняется() Экспорт

	Пакет = НовыйПакет("ver-pool-5", "garbage-pkg");
	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");

	Для Каждого Строка Из СтрРазделить("abc|1.2.3.4.5|1.2.3-|1.2.3.4-rc.1", "|") Цикл
		БылоИсключение = Ложь;
		Попытка
			СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, Строка));
		Исключение
			БылоИсключение = Истина;
		КонецПопытки;
		Ожидаем.Что(БылоИсключение, СтрШаблон("версия ""%1"" должна отклоняться", Строка)).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(СервисВерсий.ВерсииПакета(Пакет.Идентификатор).Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ПубликацияВерсийСВедущимиНулямиОтклоняется() Экспорт

	// semver-библиотека нормализует ведущие нули ("01.2.3" → 1.2.3): такие строки прошли бы уникальность
	// как отдельные версии, но равны по порядку — latest становится недетерминированным
	Пакет = НовыйПакет("ver-pool-lz", "leading-zero-pkg");
	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");

	Отклоняемые = СтрРазделить("01.2.3;1.02.3;1.2.03;00.0.0;1.2.3-01;1.2.3-rc.01;1.2.3.04", ";");
	Для Каждого Строка Из Отклоняемые Цикл
		ОписаниеОшибки = "";
		Попытка
			СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, Строка));
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		Ожидаем.Что(СтрДлина(ОписаниеОшибки) > 0,
			СтрШаблон("версия ""%1"" с ведущим нулём должна отклоняться при публикации", Строка)).ЭтоИстина();
		Ожидаем.Что(СтрНайти(ОписаниеОшибки, "ведущие нули") > 0,
			СтрШаблон("понятная ошибка про ведущие нули для ""%1"": %2", Строка, ОписаниеОшибки)).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(СервисВерсий.ВерсииПакета(Пакет.Идентификатор).Количество(),
		"ни одна неканоническая версия не сохранена").Равно(0);

	Каноническая = СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.2.3"));
	Ожидаем.Что(Каноническая.Версия).Равно("1.2.3");
	// build-метаданные с ведущим нулём допустимы (spec: на порядок не влияют)
	СБилдом = СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.2.4+build.01"));
	Ожидаем.Что(СБилдом.Версия).Равно("1.2.4+build.01");

КонецПроцедуры

&Тест
Процедура ПубликацияВНесуществующийПакетОтклоняется() Экспорт

	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");

	БылоИсключение = Ложь;
	Попытка
		СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(777666, "1.0.0"));
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;
	Ожидаем.Что(БылоИсключение).ЭтоИстина();

КонецПроцедуры

// SNAPSHOT — единственная версия вне semver, которую принимает манифест .ospx.
// Хранится вербатим и с признаком «вне порядка»: semver-колонки нулевые, а значит
// ни одно semver-правило её не рассматривает.
&Тест
Процедура ПубликацияSNAPSHOTХранитЕёВнеПорядка() Экспорт

	Пакет = НовыйПакет("ver-pool-snap", "snapshot-pkg");
	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");

	Версия = СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "SNAPSHOT"));

	Ожидаем.Что(Версия.Версия, "строка версии хранится вербатим").Равно("SNAPSHOT");
	Ожидаем.Что(Версия.ПризнакВнеПорядка, "SNAPSHOT — версия вне semver-порядка").Равно(Истина);
	Ожидаем.Что(Версия.ПризнакLegacyВерсии).Равно(Ложь);
	Ожидаем.Что(Версия.SemverМажор, "semver-колонки не заполняются").Равно(0);
	Ожидаем.Что(Версия.SemverМинор).Равно(0);
	Ожидаем.Что(Версия.SemverПатч).Равно(0);
	Ожидаем.Что(Версия.SemverПререлиз, "SNAPSHOT не пререлиз").Равно("");

	Ожидаем.Что(СервисВерсий.НайтиВерсию(Пакет.Идентификатор, "SNAPSHOT"),
		"по точной строке версия находится").Существует();

КонецПроцедуры

// Инвариант владельца: `opm install <пакет>` без версии обязан поставить релиз.
// SNAPSHOT не становится latest ни рядом с релизом, ни в одиночестве — во втором
// случае «последней» нет вовсе, и безверсионный запрос честно кончается ничем.
&Тест
Процедура SNAPSHOTНикогдаНеСтановитсяПоследней() Экспорт

	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");

	СоРелизом = НовыйПакет("ver-pool-snap-rel", "snapshot-and-release");
	Для Каждого Строка Из СтрРазделить("1.0.0,SNAPSHOT", ",") Цикл
		СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(СоРелизом.Идентификатор, Строка));
	КонецЦикла;

	Ожидаем.Что(СервисВерсий.ПоследняяВерсия(СоРелизом.Идентификатор).Версия,
		"последняя — релиз, а не снапшот").Равно("1.0.0");
	Ожидаем.Что(СервисВерсий.ПоследняяСобственнаяВерсия(СоРелизом.Идентификатор).Версия).Равно("1.0.0");
	Ожидаем.Что(СервисВерсий.РазрешитьПоДиапазону(СоРелизом.Идентификатор, ">=0.0.0-0").Версия,
		"в пререлизный диапазон SNAPSHOT тоже не попадает").Равно("1.0.0");

	ТолькоСнапшот = НовыйПакет("ver-pool-snap-only", "snapshot-only");
	СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(ТолькоСнапшот.Идентификатор, "SNAPSHOT"));

	Ожидаем.Что(СервисВерсий.ПоследняяВерсия(ТолькоСнапшот.Идентификатор),
		"пакет без релизов не имеет последней версии").Равно(Неопределено);
	Ожидаем.Что(СервисВерсий.РазрешитьПоДиапазону(ТолькоСнапшот.Идентификатор, "*")).Равно(Неопределено);
	Ожидаем.Что(СервисВерсий.ДействующиеВерсии(ТолькоСнапшот.Идентификатор).Количество(),
		"при этом версия в реестре есть и скачивается по точной координате").Равно(1);

КонецПроцедуры

// Чем версионирует свои артефакты апстрим — не наше решение: индексация внешней версии
// принимает любую строку. Публикация в хаб по-прежнему требует semver либо SNAPSHOT.
&Тест
Процедура ИндексацияВнешнейПринимаетЛюбуюСтрокуВерсии() Экспорт

	Пакет = НовыйПакет("ver-pool-ext", "external-pkg");
	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");

	Заявка = Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "SNAPSHOT");
	Заявка.Размер = 100;
	Заявка.ПутьВХранилище = "pools/ver-pool-ext/external-pkg/external-pkg-SNAPSHOT.ospx";
	Внешняя = СервисВерсий.ИндексироватьВнешнюю(Заявка, 42);

	Ожидаем.Что(Внешняя.Версия).Равно("SNAPSHOT");
	Ожидаем.Что(Внешняя.ПризнакВнеПорядка).Равно(Истина);

	Повторная = СервисВерсий.ИндексироватьВнешнюю(
		Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "SNAPSHOT"), 42);
	Ожидаем.Что(Повторная.Идентификатор, "индексация идемпотентна").Равно(Внешняя.Идентификатор);

	Чужая = СервисВерсий.ИндексироватьВнешнюю(
		Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "nightly-2026-07-31"));
	Ожидаем.Что(Чужая.Версия, "строка апстрима индексируется как есть").Равно("nightly-2026-07-31");
	Ожидаем.Что(Чужая.ПризнакВнеПорядка).Равно(Истина);
	Ожидаем.Что(СервисВерсий.ПоследняяВерсия(Пакет.Идентификатор),
		"ни одна из них не претендует на latest").Равно(Неопределено);

	// а публикация мусора остаётся отказом: контракт хаба строже контракта апстрима
	БылоИсключение = Ложь;
	Попытка
		СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "nightly-2026-08-01"));
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;
	Ожидаем.Что(БылоИсключение, "публикация не-semver версии, кроме SNAPSHOT, отклоняется").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РезолвЧерезСервисПоТегамИДиапазонам() Экспорт

	Пакет = НовыйПакет("ver-pool-6", "resolve-pkg");
	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");

	Для Каждого Строка Из СтрРазделить("1.0.0,1.1.0.7,1.2.0,2.0.0-rc.1", ",") Цикл
		СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, Строка));
	КонецЦикла;

	Последняя = СервисВерсий.ПоследняяВерсия(Пакет.Идентификатор);
	Ожидаем.Что(Последняя.Версия).Равно("1.2.0");

	Пре = СервисВерсий.РазрешитьПоДиапазону(Пакет.Идентификатор, ">=0.0.0-0");
	Ожидаем.Что(Пре.Версия).Равно("2.0.0-rc.1");

	Ожидаем.Что(СервисВерсий.РазрешитьПоДиапазону(Пакет.Идентификатор, "^1.0").Версия).Равно("1.2.0");
	Ожидаем.Что(СервисВерсий.РазрешитьПоДиапазону(Пакет.Идентификатор, "<=1.1.0.7").Версия).Равно("1.1.0.7");
	Ожидаем.Что(СервисВерсий.РазрешитьПоДиапазону(Пакет.Идентификатор, ">=3.0.0")).Равно(Неопределено);

	Ожидаем.Что(СервисВерсий.НайтиВерсию(Пакет.Идентификатор, "1.1.0.7").ПризнакLegacyВерсии).Равно(Истина);
	Ожидаем.Что(СервисВерсий.НайтиВерсию(Пакет.Идентификатор, "9.9.9")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ОтозванныеВерсииНеРезолвятся() Экспорт

	Пакет = НовыйПакет("ver-pool-7", "yanked-pkg");
	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");

	СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.0.0"));
	Старшая = СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.1.0"));

	// отзыв (yank): версия остаётся в БД, но резолвером не выдаётся
	Старшая.Отозвана = Истина;
	Старшая.Сохранить();

	Ожидаем.Что(СервисВерсий.ПоследняяВерсия(Пакет.Идентификатор).Версия).Равно("1.0.0");
	Ожидаем.Что(СервисВерсий.ДействующиеВерсии(Пакет.Идентификатор).Количество()).Равно(1);
	Ожидаем.Что(СервисВерсий.ВерсииПакета(Пакет.Идентификатор).Количество(), "в полном списке версия остаётся").Равно(2);
	Ожидаем.Что(СервисВерсий.НайтиВерсию(Пакет.Идентификатор, "1.1.0"), "прямой доступ сохраняется").Существует();

КонецПроцедуры

// Инвариант «одна запись провенанса на версию» держит ТОЛЬКО check-and-set в сервисе: индексов проект не заводит,
// а повторно провенанс фиксируют и перезапись версии, и синк зеркала, и ленивая индексация прокси.
&Тест
Процедура ПовторнаяФиксацияПровенансаНеСоздаётВторойЗаписи() Экспорт

	Пакет = НовыйПакет("prov-pool-1", "prov-pkg");
	СервисВерсий = Поделка.НайтиЖелудь("СервисВерсий");
	Провенанс = Поделка.НайтиЖелудь("СервисПроисхождения");
	Хранилище = Поделка.НайтиЖелудь("ХранилищеПроисхожденияВерсий");

	Версия = СервисВерсий.Опубликовать(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.0.0"));

	Ожидаем.Что(Хранилище.ПолучитьПоПакетИдентификаторРавно(Пакет.Идентификатор).Количество(),
		"публикация завела ровно одну запись провенанса").Равно(1);

	// вторая фиксация тем же источником и третья — ДРУГИМ: обе обязаны править ту же строку
	Провенанс.Зафиксировать(Версия, Провенанс.ИсточникСвой());
	Провенанс.Зафиксировать(Версия, Провенанс.ИсточникАпстрим(), 42);

	Ожидаем.Что(Хранилище.ПолучитьПоПакетИдентификаторРавно(Пакет.Идентификатор).Количество(),
		"повторная фиксация не плодит вторую запись на версию").Равно(1);
	Ожидаем.Что(Провенанс.ИсточникВерсии(Версия),
		"источник перезаписан в той же строке").Равно(Провенанс.ИсточникАпстрим());

КонецПроцедуры

&Тест
Процедура ЗаявкаНаПубликациюВалидируетОбязательныеПоля() Экспорт

	ОжидатьИсключениеЗаявки(0, "1.0.0", "нулевой идентификатор пакета");
	ОжидатьИсключениеЗаявки(-5, "1.0.0", "отрицательный идентификатор пакета");
	ОжидатьИсключениеЗаявки(1, "", "пустая версия");

КонецПроцедуры

Функция НовыйПул(Знач Имя)
	Возврат Поделка.НайтиЖелудь("СервисПулов").СоздатьПул(Имя);
КонецФункции

Функция НовыйПакет(Знач ИмяПула, Знач ИмяПакета)
	Пул = НовыйПул(ИмяПула);
	Возврат Поделка.НайтиЖелудь("СервисПакетов").ЗарегистрироватьПакет(Пул.Идентификатор, ИмяПакета);
КонецФункции

Процедура ОжидатьИсключениеСозданияПула(Знач СервисПулов, Знач Имя, Знач Тип, Знач Видимость, Знач Пояснение)

	БылоИсключение = Ложь;
	Попытка
		СервисПулов.СоздатьПул(Имя, Тип, Видимость);
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;
	Ожидаем.Что(БылоИсключение, Пояснение).ЭтоИстина();

КонецПроцедуры

Процедура ОжидатьИсключениеЗаявки(Знач ПакетИдентификатор, Знач Версия, Знач Пояснение)

	БылоИсключение = Ложь;
	Попытка
		Проба = Новый ЗаявкаНаПубликацию(ПакетИдентификатор, Версия);
		Проба = Проба;
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;
	Ожидаем.Что(БылоИсключение, Пояснение).ЭтоИстина();

КонецПроцедуры
