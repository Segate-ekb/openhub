// Интеграционные тесты сервисов реестра (СервисПулов, СервисПакетов, СервисВерсий): именование,
// уникальность, иммутабельность версий, semver-колонки, резолв. InMemory, набор в отдельном процессе.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;          // общий контейнер на все тесты набора
Перем КореньХранилища;  // временный корень файлового хранилища артефактов

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("данные", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("настройки", "Классы")));
	// летописи тегов и версий собирают вид объекта журнала желудём ИмяОбъектаАудита
	Попытка
		ПодключитьСценарий(ОбъединитьПути(ОбъединитьПути(КаталогМодулей, "аудит", "Классы"),
			"ИмяОбъектаАудита.os"), "ИмяОбъектаАудита");
	Исключение
	КонецПопытки;
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("реестр", "Классы")));

	// storage: занятое пулом меряется по хранилищу (УчётОбъёмаПула), поэтому реестру
	// нужен бэкенд артефактов — файловый, во временном каталоге набора
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("хранилище", "Классы")));
	// файловое хранилище убирает временные файлы желудём основы
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("основа", "Классы")));

	// events: core-registry содержит подписчиков доменных событий — контейнеру нужен издатель
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("события", "Классы")));

	// SSRF-гейт апстримов: СервисПулов требует валидатор адреса обязательно (fail-closed)
	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();

	КореньХранилища = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-registry-unit-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньХранилища);

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "сервисы-реестра-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	Попытка
		Если ЗначениеЗаполнено(КореньХранилища) И Новый Файл(КореньХранилища).Существует() Тогда
			УдалитьФайлы(КореньХранилища);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

&Тест
Процедура СервисыРегистрируютсяЖелудями() Экспорт

	ИменаЖелудей = СтрРазделить(
		"СервисПулов,СервисПакетов,СервисВерсий,РезолверВерсий,СравнительВерсий,ПравилаИменования", ",");

	Для Каждого ИмяЖелудя Из ИменаЖелудей Цикл
		Желудь = Поделка.НайтиЖелудь(ИмяЖелудя);
		Ожидаем.Что(Желудь, СтрШаблон("желудь %1", ИмяЖелудя)).Существует();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПулСоздаётсяИИщетсяВЛюбомРегистре() Экспорт

	СервисПулов = Поделка.НайтиЖелудь("СервисПулов");

	Пул = СервисПулов.СоздатьПул("Main-Pool", "custom", "public", 7, 100);

	Ожидаем.Что(Пул.Идентификатор).Существует();
	Ожидаем.Что(Пул.Имя, "имя пула хранится канонизированным").Равно("main-pool");
	Ожидаем.Что(Пул.Тип).Равно("custom");
	Ожидаем.Что(Пул.Видимость).Равно("public");
	Ожидаем.Что(Пул.ВладелецИдентификатор).Равно(7);
	Ожидаем.Что(Пул.КвотаМб).Равно(100);

	Ожидаем.Что(СервисПулов.НайтиПул("MAIN-POOL"), "поиск не зависит от регистра").Существует();
	Ожидаем.Что(СервисПулов.ПолучитьПул("main-pool").Идентификатор).Равно(Пул.Идентификатор);
	Ожидаем.Что(СервисПулов.ПулПоИдентификатору(Пул.Идентификатор).Имя).Равно("main-pool");
	Ожидаем.Что(СервисПулов.НайтиПул("нет-такого")).Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ДубльИмениПулаОтклоняется() Экспорт

	СервисПулов = Поделка.НайтиЖелудь("СервисПулов");
	СервисПулов.СоздатьПул("dup-pool");

	// дубль в любом регистре — уникальность обеспечивает сервисный слой
	Для Каждого Имя Из СтрРазделить("dup-pool,DUP-POOL,Dup-Pool", ",") Цикл
		БылоИсключение = Ложь;
		Попытка
			СервисПулов.СоздатьПул(Имя);
		Исключение
			БылоИсключение = Истина;
		КонецПопытки;
		Ожидаем.Что(БылоИсключение, СтрШаблон("дубль ""%1"" должен отклоняться", Имя)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура НекорректныеПараметрыПулаОтклоняются() Экспорт

	СервисПулов = Поделка.НайтиЖелудь("СервисПулов");

	ОжидатьИсключениеСозданияПула(СервисПулов, "плохое имя", "custom", "public", "некорректное имя");
	ОжидатьИсключениеСозданияПула(СервисПулов, "ok-pool-1", "чудо", "public", "некорректный тип");
	ОжидатьИсключениеСозданияПула(СервисПулов, "ok-pool-2", "custom", "секретно", "некорректная видимость");

КонецПроцедуры

&Тест
Процедура ПолучитьОтсутствующийПулЭтоИсключение() Экспорт

	СервисПулов = Поделка.НайтиЖелудь("СервисПулов");

	БылоИсключение = Ложь;
	Попытка
		СервисПулов.ПолучитьПул("не-существует");
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;
	Ожидаем.Что(БылоИсключение).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗарезервированноеИмяПулаОтклоняется() Экспорт

	// имена, совпадающие с литеральными маршрутами web-ui, недопустимы: winow берёт first-match без бэктрекинга
	СервисПулов = Поделка.НайтиЖелудь("СервисПулов");

	Зарезервированные = СтрРазделить(
		"health,packages,package,api,login,register,setup,office,download,static,assets", ",");

	Для Каждого Имя Из Зарезервированные Цикл
		ОписаниеОшибки = "";
		Попытка
			СервисПулов.СоздатьПул(Имя);
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		Ожидаем.Что(СтрДлина(ОписаниеОшибки) > 0,
			СтрШаблон("зарезервированное имя пула ""%1"" должно отклоняться", Имя)).ЭтоИстина();
		Ожидаем.Что(СтрНайти(ОписаниеОшибки, "зарезервировано") > 0,
			СтрШаблон("понятная ошибка про резерв для ""%1"": %2", Имя, ОписаниеОшибки)).ЭтоИстина();
	КонецЦикла;

	БылоИсключение = Ложь;
	Попытка
		СервисПулов.СоздатьПул("PACKAGES");
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;
	Ожидаем.Что(БылоИсключение, "резерв не зависит от регистра").ЭтоИстина();

	Ожидаем.Что(СервисПулов.СоздатьПул("my-team").Имя).Равно("my-team");

КонецПроцедуры

&Тест
Процедура АдресРепозиторияСОпаснойСхемойОбнуляется() Экспорт

	// вторая линия защиты от stored XSS: небезопасные схемы АдресРепозитория обнуляются при регистрации пакета
	Пул = НовыйПул("repo-pool");
	СервисПакетов = Поделка.НайтиЖелудь("СервисПакетов");

	Опасные = СтрРазделить("javascript:alert(1)| data:text/html,x|vbscript:msgbox(1)|JavaScript:alert(1)", "|");
	Индекс = 0;
	Для Каждого Плохой Из Опасные Цикл
		Индекс = Индекс + 1;
		Пакет = СервисПакетов.ЗарегистрироватьПакет(Пул.Идентификатор, "evil-pkg-" + Индекс,
			Новый Структура("АдресРепозитория", Плохой));
		Ожидаем.Что(Пакет.АдресРепозитория,
			СтрШаблон("опасная схема ""%1"" обнулена", Плохой)).Равно("");
	КонецЦикла;

	Хороший = СервисПакетов.ЗарегистрироватьПакет(Пул.Идентификатор, "good-pkg",
		Новый Структура("АдресРепозитория", "https://github.com/autumn-library/winow"));
	Ожидаем.Что(Хороший.АдресРепозитория).Равно("https://github.com/autumn-library/winow");

КонецПроцедуры

&Тест
Процедура ПакетРегистрируетсяССохранениемРегистраИмени() Экспорт

	Пул = НовыйПул("pkg-pool-1");
	СервисПакетов = Поделка.НайтиЖелудь("СервисПакетов");

	Свойства = Новый Структура("Описание, Лицензия", "Веб-фреймворк", "MIT");
	Пакет = СервисПакетов.ЗарегистрироватьПакет(Пул.Идентификатор, "WiNow", Свойства);

	Ожидаем.Что(Пакет.Имя, "регистр первой публикации сохраняется").Равно("WiNow");
	Ожидаем.Что(Пакет.ИмяНижнийРегистр, "канонический ключ - нижний регистр").Равно("winow");
	Ожидаем.Что(Пакет.Описание).Равно("Веб-фреймворк");
	Ожидаем.Что(Пакет.Лицензия).Равно("MIT");
	Ожидаем.Что(Пакет.Скрыт).Равно(Ложь);

	Ожидаем.Что(СервисПакетов.НайтиПакет(Пул.Идентификатор, "wInOw").Идентификатор).Равно(Пакет.Идентификатор);
	Ожидаем.Что(СервисПакетов.ПакетПоИдентификатору(Пакет.Идентификатор).Имя).Равно("WiNow");
	Ожидаем.Что(СервисПакетов.ПакетыПула(Пул.Идентификатор).Количество()).Равно(1);

КонецПроцедуры

&Тест
Процедура ДубльИмениПакетаВПулеОтклоняетсяВЛюбомРегистре() Экспорт

	Пул = НовыйПул("pkg-pool-2");
	ДругойПул = НовыйПул("pkg-pool-3");
	СервисПакетов = Поделка.НайтиЖелудь("СервисПакетов");

	СервисПакетов.ЗарегистрироватьПакет(Пул.Идентификатор, "MyLib");

	ОписаниеОшибки = "";
	Попытка
		СервисПакетов.ЗарегистрироватьПакет(Пул.Идентификатор, "MYLIB");
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(СтрДлина(ОписаниеОшибки) > 0, "дубль в другом регистре отклоняется").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ОписаниеОшибки, "MyLib") > 0,
		"понятная ошибка называет занятое имя: " + ОписаниеОшибки).ЭтоИстина();

	ВДругомПуле = СервисПакетов.ЗарегистрироватьПакет(ДругойПул.Идентификатор, "MyLib");
	Ожидаем.Что(ВДругомПуле.Идентификатор).Существует();

КонецПроцедуры

&Тест
Процедура ПакетНеРегистрируетсяВНесуществующемПуле() Экспорт

	СервисПакетов = Поделка.НайтиЖелудь("СервисПакетов");

	БылоИсключение = Ложь;
	Попытка
		СервисПакетов.ЗарегистрироватьПакет(999888, "orphan");
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;
	Ожидаем.Что(БылоИсключение).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НайтиИлиЗарегистрироватьВозвращаетСуществующий() Экспорт

	Пул = НовыйПул("pkg-pool-4");
	СервисПакетов = Поделка.НайтиЖелудь("СервисПакетов");

	Первый = СервисПакетов.НайтиИлиЗарегистрировать(Пул.Идентификатор, "OneUnit");
	Повторный = СервисПакетов.НайтиИлиЗарегистрировать(Пул.Идентификатор, "ONEUNIT");

	Ожидаем.Что(Повторный.Идентификатор).Равно(Первый.Идентификатор);
	Ожидаем.Что(Повторный.Имя, "регистр первой публикации").Равно("OneUnit");
	Ожидаем.Что(СервисПакетов.ПакетыПула(Пул.Идентификатор).Количество()).Равно(1);

КонецПроцедуры

