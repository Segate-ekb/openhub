// Юнит-тесты хранилищ учётного контура (пользователи, токены, сессии, личности, группы,
// участники групп): фасады отдают деривованные запросы autumn-data и реально фильтруют.
// Набор в отдельном процессе: второй контейнер ОСени конфликтует с контейнером раннера OneUnit.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;   // общий контейнер на все тесты набора

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассовDb = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"), ОбъединитьПути("данные", "Классы"));

	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассовDb, "*.os", Истина) Цикл
		// без глушения ошибок: синтаксически сломанный класс должен уронить набор
		ПоискКлассов.ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;

	Детальки = Новый Соответствие();

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "хранилища-учёток-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

#Область СборкаКонтейнера

// Ошибку сборки желудя ОСень глотает: НайтиЖелудь молча отдаёт Неопределено.
&Тест
Процедура ФасадыИКлассыЗапросовРегистрируютсяЖелудями() Экспорт

	Имена = СтрРазделить(
		"ХранилищеПользователей,ХранилищеТокенов,ХранилищеСессий,ХранилищеВнешнихЛичностей,"
		+ "ХранилищеГрупп,ХранилищеУчастниковГрупп,"
		+ "ЗапросыПользователей,ЗапросыТокенов,ЗапросыСессий,ЗапросыВнешнихЛичностей,"
		+ "ЗапросыГрупп,ЗапросыУчастниковГрупп", ",");

	Для Каждого Имя Из Имена Цикл
		Ожидаем.Что(Поделка.НайтиЖелудь(Имя), СтрШаблон("желудь %1", Имя)).Существует();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Пользователи

&Тест
Процедура ПользователиИщутсяПоИдентификаторуИЛогину() Экспорт

	Хранилище = Желудь("ХранилищеПользователей");

	Первый = ДобавитьПользователя(Хранилище, "ivan", "ivan@example.com");
	Второй = ДобавитьПользователя(Хранилище, "petr", "petr@example.com");

	Найденный = Хранилище.ПолучитьОдноПоИдентификаторРавно(Второй.Идентификатор);
	Ожидаем.Что(Найденный, "поиск по идентификатору").Существует();
	Ожидаем.Что(Найденный.Логин, "отбор по идентификатору не берёт первую строку").Равно("petr");

	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(Первый.Идентификатор).Логин).Равно("ivan");
	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(999999), "чужой идентификатор").Равно(Неопределено);

	ПоЛогину = Хранилище.НайтиПоЛогину("petr");
	Ожидаем.Что(ПоЛогину, "поиск по логину").Существует();
	Ожидаем.Что(ПоЛогину.Идентификатор).Равно(Второй.Идентификатор);
	Ожидаем.Что(Хранилище.НайтиПоЛогину("нет-такого"), "несуществующий логин").Равно(Неопределено);
	// логин хранится нормализованным: отбор регистрозависим и подмены «найдётся хоть что-то» нет
	Ожидаем.Что(Хранилище.НайтиПоЛогину("PETR"), "логин ищется как есть").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ПользователиИщутсяПоEmailВсеСовпадения() Экспорт

	Хранилище = Желудь("ХранилищеПользователей");

	ДобавитьПользователя(Хранилище, "dup1", "shared@example.com");
	ДобавитьПользователя(Хранилище, "dup2", "shared@example.com");
	ДобавитьПользователя(Хранилище, "solo", "solo@example.com");

	Совпадения = Хранилище.НайтиВсехПоEmail("shared@example.com");
	Ожидаем.Что(Совпадения.Количество(), "email не уникален — оба совпадения").Равно(2);
	Логины = Новый Массив();
	Для Каждого Пользователь Из Совпадения Цикл
		Логины.Добавить(Пользователь.Логин);
	КонецЦикла;
	Ожидаем.Что(Логины.Найти("solo"), "чужой email в выборку не попадает").Равно(Неопределено);

	Ожидаем.Что(Хранилище.НайтиВсехПоEmail("solo@example.com").Количество()).Равно(1);
	Ожидаем.Что(Хранилище.НайтиВсехПоEmail("никого@example.com").Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура ВсеИКоличествоПользователейСчитаютТаблицуЦеликом() Экспорт

	Хранилище = Желудь("ХранилищеПользователей");

	ДоСоздания = Хранилище.Количество();
	Ожидаем.Что(Хранилище.Все().Количество(), "Количество считает то же, что Все").Равно(ДоСоздания);

	ДобавитьПользователя(Хранилище, "счёт1", "счёт1@example.com");
	ДобавитьПользователя(Хранилище, "счёт2", "счёт2@example.com");

	Ожидаем.Что(Хранилище.Количество(), "две новые учётки видны в общем счёте").Равно(ДоСоздания + 2);
	Ожидаем.Что(Хранилище.Все().Количество()).Равно(ДоСоздания + 2);

КонецПроцедуры

#КонецОбласти

#Область Токены

&Тест
Процедура ТокеныИщутсяПоВладельцуИУдаляются() Экспорт

	Хранилище = Желудь("ХранилищеТокенов");

	Мой = ДобавитьТокен(Хранилище, 1001, "aaa");
	ДобавитьТокен(Хранилище, 1001, "bbb");
	Чужой = ДобавитьТокен(Хранилище, 1002, "ccc");

	Мои = Хранилище.ПолучитьПоПользовательИдентификаторРавно(1001);
	Ожидаем.Что(Мои.Количество(), "токены чужого владельца отсеиваются").Равно(2);
	Ожидаем.Что(Хранилище.ПолучитьПоПользовательИдентификаторРавно(1002).Количество()).Равно(1);
	Ожидаем.Что(Хранилище.ПолучитьПоПользовательИдентификаторРавно(9999).Количество()).Равно(0);

	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(Чужой.Идентификатор).Префикс).Равно("ccc");
	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(999999)).Равно(Неопределено);

	Хранилище.Удалить(Мой);
	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(Мой.Идентификатор), "отозванный токен").Равно(Неопределено);
	Ожидаем.Что(Хранилище.ПолучитьПоПользовательИдентификаторРавно(1001).Количество(),
		"второй токен владельца остаётся").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Сессии

&Тест
Процедура СессииИщутсяПоИдентификаторуИВладельцу() Экспорт

	Хранилище = Желудь("ХранилищеСессий");

	ДобавитьСессию(Хранилище, "сессия-а", 2001, ТекущаяУниверсальнаяДата() + 3600, Ложь);
	ДобавитьСессию(Хранилище, "сессия-б", 2001, ТекущаяУниверсальнаяДата() + 3600, Ложь);
	ДобавитьСессию(Хранилище, "сессия-в", 2002, ТекущаяУниверсальнаяДата() + 3600, Ложь);

	Найденная = Хранилище.ПолучитьОдноПоИдентификаторРавно("сессия-в");
	Ожидаем.Что(Найденная, "поиск по строковому ключу").Существует();
	Ожидаем.Что(Найденная.ПользовательИдентификатор).Равно(2002);
	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно("нет-такой")).Равно(Неопределено);

	Ожидаем.Что(Хранилище.ПолучитьПоПользовательИдентификаторРавно(2001).Количество(),
		"сессии чужого пользователя отсеиваются").Равно(2);
	Ожидаем.Что(Хранилище.ПолучитьПоПользовательИдентификаторРавно(2003).Количество()).Равно(0);

	Ожидаем.Что(Хранилище.Все().Количество() >= 3, "Все отдаёт таблицу целиком").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НедействительныеСессииОтбираютЗавершённыеИПросроченные() Экспорт

	Хранилище = Желудь("ХранилищеСессий");
	Момент = Дата(2030, 1, 1, 12, 0, 0);

	ДобавитьСессию(Хранилище, "недейст-завершённая", 2100, Момент + 86400, Истина);
	ДобавитьСессию(Хранилище, "недейст-просроченная", 2100, Момент - 10, Ложь);
	ДобавитьСессию(Хранилище, "недейст-граница", 2100, Момент, Ложь);
	ДобавитьСессию(Хранилище, "недейст-живая", 2100, Момент + 10, Ложь);

	Идентификаторы = Новый Массив();
	Для Каждого Запись Из Хранилище.НедействительныеДо(Момент) Цикл
		Идентификаторы.Добавить(Запись.Идентификатор);
	КонецЦикла;

	Ожидаем.Что(Идентификаторы.Найти("недейст-завершённая"), "завершённая недействительна").Существует();
	Ожидаем.Что(Идентификаторы.Найти("недейст-просроченная"), "просроченная недействительна").Существует();
	Ожидаем.Что(Идентификаторы.Найти("недейст-граница"), "дедлайн ровно в момент — недействительна").Существует();
	Ожидаем.Что(Идентификаторы.Найти("недейст-живая"), "живая сессия не удаляется").Равно(Неопределено);

	// завершённая с дедлайном в будущем не должна дублироваться объединением двух выборок
	Дублей = 0;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Если Идентификатор = "недейст-завершённая" Тогда
			Дублей = Дублей + 1;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Дублей, "объединение выборок без дублей").Равно(1);

КонецПроцедуры

&Тест
Процедура СессияУдаляется() Экспорт

	Хранилище = Желудь("ХранилищеСессий");

	ДобавитьСессию(Хранилище, "сессия-удаляемая", 2200, ТекущаяУниверсальнаяДата() + 60, Ложь);
	ДобавитьСессию(Хранилище, "сессия-остаётся", 2200, ТекущаяУниверсальнаяДата() + 60, Ложь);

	Хранилище.Удалить(Хранилище.ПолучитьОдноПоИдентификаторРавно("сессия-удаляемая"));

	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно("сессия-удаляемая")).Равно(Неопределено);
	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно("сессия-остаётся")).Существует();

КонецПроцедуры

#КонецОбласти

#Область ВнешниеЛичности

&Тест
Процедура ЛичностьИщетсяПоПареИздательСубъект() Экспорт

	Хранилище = Желудь("ХранилищеВнешнихЛичностей");

	Целевая = ДобавитьЛичность(Хранилище, "https://idp-1", "sub-1", 3001);
	ДобавитьЛичность(Хранилище, "https://idp-1", "sub-2", 3002);
	ДобавитьЛичность(Хранилище, "https://idp-2", "sub-1", 3003);

	Найденная = Хранилище.НайтиПоЛичности("https://idp-1", "sub-1");
	Ожидаем.Что(Найденная, "оба отбора работают вместе").Существует();
	Ожидаем.Что(Найденная.Идентификатор).Равно(Целевая.Идентификатор);
	Ожидаем.Что(Найденная.ПользовательИдентификатор, "не соседняя запись того же издателя").Равно(3001);

	Ожидаем.Что(Хранилище.НайтиПоЛичности("https://idp-1", "sub-9"), "субъекта нет").Равно(Неопределено);
	Ожидаем.Что(Хранилище.НайтиПоЛичности("https://idp-9", "sub-1"), "издателя нет").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ЛичностиЧитаютсяПоПользователюИЦеликом() Экспорт

	Хранилище = Желудь("ХранилищеВнешнихЛичностей");

	Первая = ДобавитьЛичность(Хранилище, "https://idp-3", "s-1", 3100);
	ДобавитьЛичность(Хранилище, "https://idp-4", "s-2", 3100);
	ДобавитьЛичность(Хранилище, "https://idp-3", "s-3", 3200);

	Ожидаем.Что(Хранилище.ПолучитьПоПользовательИдентификаторРавно(3100).Количество(),
		"привязки чужого пользователя отсеиваются").Равно(2);
	Ожидаем.Что(Хранилище.ПолучитьПоПользовательИдентификаторРавно(3300).Количество()).Равно(0);

	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(Первая.Идентификатор).Субъект).Равно("s-1");
	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(999999)).Равно(Неопределено);

	ВсегоДоУдаления = Хранилище.Получить().Количество();
	Ожидаем.Что(ВсегоДоУдаления >= 3, "Получить отдаёт таблицу целиком").ЭтоИстина();

	Хранилище.Удалить(Первая);
	Ожидаем.Что(Хранилище.Получить().Количество(), "после отвязки строк на одну меньше").Равно(ВсегоДоУдаления - 1);
	Ожидаем.Что(Хранилище.ПолучитьПоПользовательИдентификаторРавно(3100).Количество()).Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Группы

&Тест
Процедура ГруппыИщутсяПоИмениИИдентификатору() Экспорт

	Хранилище = Желудь("ХранилищеГрупп");

	ДоСоздания = Хранилище.Все().Количество();

	Первая = ДобавитьГруппу(Хранилище, "разработчики");
	Вторая = ДобавитьГруппу(Хранилище, "сопровождение");

	Найденная = Хранилище.НайтиПоИмени("сопровождение");
	Ожидаем.Что(Найденная, "поиск по имени").Существует();
	Ожидаем.Что(Найденная.Идентификатор, "отбор не берёт первую строку").Равно(Вторая.Идентификатор);
	Ожидаем.Что(Хранилище.НайтиПоИмени("нет-такой"), "несуществующее имя").Равно(Неопределено);

	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(Первая.Идентификатор).Имя).Равно("разработчики");
	Ожидаем.Что(Хранилище.ПолучитьОдноПоИдентификаторРавно(999999)).Равно(Неопределено);

	Ожидаем.Что(Хранилище.Все().Количество(), "обе группы в общем списке").Равно(ДоСоздания + 2);

КонецПроцедуры

#КонецОбласти

#Область УчастникиГрупп

&Тест
Процедура ЧленстваОтбираютсяПоГруппеПользователюИПаре() Экспорт

	Хранилище = Желудь("ХранилищеУчастниковГрупп");

	ДобавитьЧленство(Хранилище, 4001, 5001, "local");
	ДобавитьЧленство(Хранилище, 4001, 5002, "oidc");
	ДобавитьЧленство(Хранилище, 4002, 5001, "oidc");

	Ожидаем.Что(Хранилище.ПолучитьПоГруппаИдентификаторРавно(4001).Количество(),
		"участники соседней группы отсеиваются").Равно(2);
	Ожидаем.Что(Хранилище.ПолучитьПоГруппаИдентификаторРавно(4003).Количество()).Равно(0);

	Ожидаем.Что(Хранилище.ПолучитьПоПользовательИдентификаторРавно(5001).Количество(),
		"членства пользователя во всех группах").Равно(2);
	Ожидаем.Что(Хранилище.ПолучитьПоПользовательИдентификаторРавно(5003).Количество()).Равно(0);

	Членство = Хранилище.НайтиЧленство(4001, 5002);
	Ожидаем.Что(Членство, "оба отбора работают вместе").Существует();
	Ожидаем.Что(Строка(Членство.Источник), "не соседняя строка той же группы").Равно("oidc");
	Ожидаем.Что(Строка(Хранилище.НайтиЧленство(4001, 5001).Источник)).Равно("local");

	Ожидаем.Что(Хранилище.НайтиЧленство(4002, 5002), "пары нет").Равно(Неопределено);
	Ожидаем.Что(Хранилище.НайтиЧленство(4003, 5001), "группы нет").Равно(Неопределено);

	Хранилище.Удалить(Членство);
	Ожидаем.Что(Хранилище.НайтиЧленство(4001, 5002), "членство снято").Равно(Неопределено);
	Ожидаем.Что(Хранилище.ПолучитьПоГруппаИдентификаторРавно(4001).Количество(),
		"остальные участники группы на месте").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Фикстуры

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция ДобавитьПользователя(Хранилище, Знач Логин, Знач Email)

	Пользователь = Хранилище.СоздатьЭлемент();
	Пользователь.Логин = Логин;
	Пользователь.Email = Email;
	Пользователь.EmailПодтверждён = Ложь;
	Пользователь.Активен = Истина;
	Пользователь.РольХаба = "user";
	Пользователь.ТребуетсяСменаПароля = Ложь;
	Пользователь.Создан = ТекущаяУниверсальнаяДата();
	Пользователь.Сохранить();
	Возврат Пользователь;

КонецФункции

Функция ДобавитьТокен(Хранилище, Знач ПользовательИдентификатор, Знач Префикс)

	Токен = Хранилище.СоздатьЭлемент();
	Токен.ПользовательИдентификатор = ПользовательИдентификатор;
	Токен.Префикс = Префикс;
	Токен.Хеш = "хеш-" + Префикс;
	Токен.Права = "read";
	Токен.Создан = ТекущаяУниверсальнаяДата();
	Токен.Сохранить();
	Возврат Токен;

КонецФункции

Функция ДобавитьСессию(Хранилище, Знач Идентификатор, Знач ПользовательИдентификатор, Знач Истекает, Знач Завершена)

	Сессия = Хранилище.СоздатьЭлемент();
	Сессия.Идентификатор = Идентификатор;
	Сессия.ПользовательИдентификатор = ПользовательИдентификатор;
	Сессия.ДанныеJSON = "{}";
	Сессия.Истекает = Истекает;
	Сессия.Завершена = Завершена;
	Сессия.Сохранить();
	Возврат Сессия;

КонецФункции

Функция ДобавитьЛичность(Хранилище, Знач Издатель, Знач Субъект, Знач ПользовательИдентификатор)

	Личность = Хранилище.СоздатьЭлемент();
	Личность.Издатель = Издатель;
	Личность.Субъект = Субъект;
	Личность.ПользовательИдентификатор = ПользовательИдентификатор;
	Личность.Email = Субъект + "@example.com";
	Личность.Создана = ТекущаяУниверсальнаяДата();
	Личность.Сохранить();
	Возврат Личность;

КонецФункции

Функция ДобавитьГруппу(Хранилище, Знач Имя)

	Группа = Хранилище.СоздатьЭлемент();
	Группа.Имя = Имя;
	Группа.Описание = "";
	Группа.Создана = ТекущаяУниверсальнаяДата();
	Группа.Сохранить();
	Возврат Группа;

КонецФункции

Функция ДобавитьЧленство(Хранилище, Знач ГруппаИдентификатор, Знач ПользовательИдентификатор, Знач Источник)

	Участник = Хранилище.СоздатьЭлемент();
	Участник.ГруппаИдентификатор = ГруппаИдентификатор;
	Участник.ПользовательИдентификатор = ПользовательИдентификатор;
	Участник.Источник = Источник;
	Участник.Сохранить();
	Возврат Участник;

КонецФункции

#КонецОбласти
