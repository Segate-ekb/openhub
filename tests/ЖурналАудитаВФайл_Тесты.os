&Тест
Процедура ОборваннаяСтрокаНеБросаетИсключение() Экспорт

	Запись = Формат.НоваяЗапись();
	Запись.Когда = Дата(2030, 1, 5);
	Запись.Кто = "vasya";
	Запись.Действие = "версия.опубликована";
	Запись.Объект = "public/пакет@1.0.0";
	Запись.Детали = "детали с \ и кавычкой "" и переводом" + Символы.ПС + "строки";
	Эталон = Формат.Строкой(Запись);

	// файл журнала обрывается на любом байте: диск кончился, процесс убит,
	// copytruncate снял копию посреди записи
	Обрывки = Новый Массив();
	Для Длина = 1 По СтрДлина(Эталон) - 1 Цикл
		Обрывки.Добавить(Лев(Эталон, Длина));
	КонецЦикла;
	// формы, на которых разбор спотыкается раньше всего: позиция уходит за конец строки
	Обрывки.Добавить("{""");
	Обрывки.Добавить("{""когда"":""");
	Обрывки.Добавить("{""когда"":""\""");
	Обрывки.Добавить("{""когда"":""x"",""кто"":""\");
	Обрывки.Добавить("""");

	Исключения = Новый Массив();
	ЛожныеЗаписи = 0;

	Для Каждого Обрывок Из Обрывки Цикл
		Попытка
			Если Формат.ИзСтроки(Обрывок) <> Неопределено Тогда
				ЛожныеЗаписи = ЛожныеЗаписи + 1;
			КонецЕсли;
		Исключение
			Если Исключения.Количество() < 3 Тогда
				Исключения.Добавить("[" + Обрывок + "] -> "
					+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Исключения, "; "),
		"оборванная строка обязана давать «не запись», а не исключение: разбор стоит"
		+ " на горячем пути чтения журнала безопасности").Равно("");
	Ожидаем.Что(ЛожныеЗаписи, "и не выдавать обрывок за настоящее событие").Равно(0);

КонецПроцедуры

&Тест
Процедура ОборванныйХвостФайлаНеРоняетЧтениеЖурнала() Экспорт

	// как это увидит пользователь хаба: три события записаны, процесс убит посреди
	// четвёртой строки — экран журнала и секция аудита в доме хаба обязаны работать
	Каталог = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-аудит-обрыв-" + Суффикс());
	СоздатьКаталог(Каталог);
	Путь = ОбъединитьПути(Каталог, "аудит.log");

	Писака = Новый ЗаписьТекста(Путь, "utf-8", , Истина);
	Для Сч = 1 По 3 Цикл
		Целая = Формат.НоваяЗапись();
		Целая.Когда = Дата(2030, 1, 1) + Сч;
		Целая.Кто = "vasya";
		Целая.Действие = "версия.опубликована";
		Целая.Объект = "объект-" + Сч;
		Писака.ЗаписатьСтроку(Формат.Строкой(Целая));
	КонецЦикла;
	// последняя строка обрывается сразу после открывающей кавычки значения
	Писака.Записать("{""когда"":""2030-01-05T00:00:00Z"",""кто"":""vasya"",""детали"":""");
	Писака.Закрыть();

	Читатель_ = Новый ЧитательЖурналаАудита(Формат, Новый ЗаглушкаПутиАудита(Путь), ОтборАдреса(), ЛогТестов());

	Страница = Читатель_.Страница(Неопределено, 0, 20);
	Ожидаем.Что(Страница.Записи.Количество(),
		"экран журнала обязан показать целые записи, а не упасть на обрывке").Равно(3);
	Ожидаем.Что(Страница.Записи[0].Объект, "новые первыми").Равно("объект-3");

	Служба = Новый СлужбаАудита(Неопределено, Новый ГотовностьЗаглушка(), Летопись, Читатель_,
		Новый ИмяОбъектаАудита());
	Ожидаем.Что(Служба.ЗаписиСтраницей(Неопределено, 1, 20).Записи.Количество(),
		"секция аудита в доме хаба обязана работать на оборванном журнале").Равно(3);

КонецПроцедуры

&Тест
Процедура АдресЗаписиПишетсяКанонично() Экспорт

	Метка = Суффикс();
	Летопись.Записать(ТекущаяУниверсальнаяДата(), "root", "канон.адреса" + Метка,
		"объект", "", "", "::ffff:192.0.2.1");
	Летопись.Записать(ТекущаяУниверсальнаяДата(), "root", "канон.регистра" + Метка,
		"объект", "", "", "2001:0DB8:0000:0000:0000:0000:0000:0001");
	Летопись.Записать(ТекущаяУниверсальнаяДата(), "root", "канон.мусора" + Метка,
		"объект", "", "", "не-адрес");

	Ожидаем.Что(ПерваяПоДействию("канон.адреса" + Метка).АдресIP,
		"отображённый IPv4 в колонке журнала — это IPv4").Равно("192.0.2.1");
	Ожидаем.Что(ПерваяПоДействию("канон.регистра" + Метка).АдресIP,
		"развёрнутая запись в верхнем регистре — тот же адрес").Равно("2001:db8::1");
	Ожидаем.Что(ПерваяПоДействию("канон.мусора" + Метка).АдресIP,
		"непонятый адрес журнал пишет как пришёл").Равно("не-адрес");

КонецПроцедуры

&Тест
Процедура ЗаписиПрежнейВерсииОтбираютсяНаравнеСКаноническими() Экспорт

	// журнал не мигрируется: в файле лежат адреса, записанные как пришли. Отбор сравнивает
	// ЗНАЧЕНИЕ, поэтому одна запись адреса в форме находит все его записи в файле
	Каталог = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-аудит-адреса-" + Суффикс());
	СоздатьКаталог(Каталог);
	Путь = ОбъединитьПути(Каталог, "аудит.log");

	Писака = Новый ЗаписьТекста(Путь, "utf-8", , Истина);
	Писака.ЗаписатьСтроку(СтрокаСАдресом("192.0.2.1"));
	Писака.ЗаписатьСтроку(СтрокаСАдресом("::ffff:192.0.2.1"));
	Писака.ЗаписатьСтроку(СтрокаСАдресом("2001:0DB8:0000:0000:0000:0000:0000:0001"));
	Писака.ЗаписатьСтроку(СтрокаСАдресом("192.0.2.9"));
	Писака.ЗаписатьСтроку(СтрокаСАдресом("203.0.113.7"));
	Писака.Закрыть();

	Читатель_ = Новый ЧитательЖурналаАудита(Формат, Новый ЗаглушкаПутиАудита(Путь),
		ОтборАдреса(), ЛогТестов());
	Условия = ОтборАдреса();

	Ожидаем.Что(НайденоПоАдресу(Читатель_, Условия, "192.0.2.1"),
		"обе записи одного узла — по канонической форме").Равно(2);
	Ожидаем.Что(НайденоПоАдресу(Читатель_, Условия, "::ffff:192.0.2.1"),
		"те же две — по отображённой форме").Равно(2);
	Ожидаем.Что(НайденоПоАдресу(Читатель_, Условия, "2001:db8::1"),
		"развёрнутая запись IPv6 находится сжатой").Равно(1);
	Ожидаем.Что(НайденоПоАдресу(Читатель_, Условия, "192.0.2.0/24"),
		"сеть находит все свои адреса").Равно(3);
	Ожидаем.Что(НайденоПоАдресу(Читатель_, Условия, "203.0.113.0/24"),
		"соседняя сеть — свои записи").Равно(1);
	Ожидаем.Что(НайденоПоАдресу(Читатель_, Условия, "не-адрес"),
		"непрочитанное условие отбором не становится: журнал показан целиком").Равно(5);
	Ожидаем.Что(Читатель_.Страница(Неопределено, 0, 20).Записи.Количество(),
		"без условия видны все записи").Равно(5);

КонецПроцедуры

&Тест
Процедура СбойРазбораНеРоняетСтраницуЖурнала() Экспорт

	// второй слой защиты: даже если разбор строки когда-нибудь начнёт падать,
	// экран журнала безопасности обязан открыться, а не отдать 500
	Каталог = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-аудит-сбой-" + Суффикс());
	СоздатьКаталог(Каталог);
	Путь = ОбъединитьПути(Каталог, "аудит.log");

	Писака = Новый ЗаписьТекста(Путь, "utf-8", , Истина);
	Целая = Формат.НоваяЗапись();
	Целая.Когда = Дата(2030, 1, 1);
	Целая.Кто = "vasya";
	Целая.Действие = "версия.опубликована";
	Писака.ЗаписатьСтроку(Формат.Строкой(Целая));
	Писака.Закрыть();

	Читатель_ = Новый ЧитательЖурналаАудита(Новый ФорматПадающий(),
		Новый ЗаглушкаПутиАудита(Путь), ОтборАдреса(), ЛогТестов());

	Страница = Читатель_.Страница(Неопределено, 0, 20);

	Ожидаем.Что(Страница.Записи.Количество(),
		"падающий разбор даёт пустую страницу, а не исключение наружу").Равно(0);
	Ожидаем.Что(Страница.ЕстьСледующая, "и не обещает продолжения").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура НеразбираемаяСтрокаОтдаётНеопределено() Экспорт

	Ожидаем.Что(Формат.ИзСтроки(""), "пустая строка — не запись").ЭтоНеопределено();
	Ожидаем.Что(Формат.ИзСтроки("просто текст"), "не JSON — не запись").ЭтоНеопределено();
	Ожидаем.Что(Формат.ИзСтроки("{""кто"":""root""}"), "JSON без времени — не запись")
		.ЭтоНеопределено();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Событие(Знач Тип, Знач Когда, Знач Кто, Знач Объект, Знач Субъект, Знач Детали, Знач АдресIP)

	Данные = Новый Структура();
	Данные.Вставить("Кто", Кто);
	Данные.Вставить("Действие", Тип);
	Данные.Вставить("Объект", Объект);
	Данные.Вставить("Субъект", Субъект);
	Данные.Вставить("ДеталиJSON", Детали);
	Данные.Вставить("АдресIP", АдресIP);

	Возврат Новый Структура("Тип, Когда, Данные", Тип, Когда, Данные);

КонецФункции

Функция ПерваяПоДействию(Знач Действие)

	Страница = Читатель.Страница(Новый Структура("Действие", Действие), 0, 1);

	Возврат ?(Страница.Записи.Количество() = 0, Неопределено, Страница.Записи[0]);

КонецФункции

Функция ПерваяСыраяСтрокаС(Знач Подстрока)

	Для Каждого Строчка Из СтрокиФайла() Цикл
		Если СтрНайти(Строчка, Подстрока) > 0 Тогда
			Возврат Строчка;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция СтрокиФайла()

	Поток = ФайловыеПотоки.ОткрытьДляЧтения(Аппендер.Путь());
	Чтение = Новый ЧтениеДанных(Поток);
	Буфер = Чтение.ПрочитатьВБуферДвоичныхДанных();
	Чтение.Закрыть();
	Поток.Закрыть();

	Возврат СтрРазделить(ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер, "utf-8"), Символы.ПС);

КонецФункции

Функция СтрокФайла()

	Всего = 0;
	Для Каждого Строчка Из СтрокиФайла() Цикл
		Если НЕ ПустаяСтрока(Строчка) Тогда
			Всего = Всего + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Всего;

КонецФункции

Функция Файл()
	Возврат " файл " + Аппендер.Путь();
КонецФункции

Функция ЭтоISO8601UTC(Знач Текст)

	Образец = "9999-99-99T99:99:99Z";
	Если СтрДлина(Текст) <> СтрДлина(Образец) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Образец) Цикл
		Эталон = Сред(Образец, Позиция, 1);
		Символ = Сред(Текст, Позиция, 1);
		Если Эталон = "9" Тогда
			Если СтрНайти("0123456789", Символ) = 0 Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли Символ <> Эталон Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.аудит");
КонецФункции

Функция ОтборАдреса()
	Возврат Новый ОтборПоАдресу(Новый КанонIP());
КонецФункции

Функция СтрокаСАдресом(Знач АдресIP)
	Запись = Формат.НоваяЗапись();
	Запись.Когда = Дата(2030, 1, 1);
	Запись.Кто = "vasya";
	Запись.Действие = "версия.опубликована";
	Запись.Объект = "объект";
	Запись.АдресIP = АдресIP;
	Возврат Формат.Строкой(Запись);
КонецФункции

Функция НайденоПоАдресу(Знач Читатель_, Знач Условия, Знач Значение)
	Отбор = Новый Структура("Адрес", Условия.Условие(Значение));
	Возврат Читатель_.Страница(Отбор, 0, 20).Записи.Количество();
КонецФункции

// Служба поверх заданного источника: издатель и готовность к выдаче страниц не относятся.
Функция СлужбаНад(Знач Источник)
	Возврат Новый СлужбаАудита(Неопределено, Новый ГотовностьЗаглушка(), Летопись, Источник,
		Новый ИмяОбъектаАудита());
КонецФункции

Функция Суффикс()
	Возврат СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
КонецФункции

Функция Падает(Знач Аппендер_, Знач Строчка)

	Попытка
		Аппендер_.ВывестиСобытие(Новый СобытиеЛогаЗаглушка(Строчка));
	Исключение
		Возврат Истина;
	КонецПопытки;

	Возврат Ложь;

КонецФункции

Функция КорпусЗначений()

	Корпус = Новый Массив();
	Корпус.Добавить("2020-01-02T03:04:05.789Z");
	Корпус.Добавить("2020-01-02T03:04:05");
	Корпус.Добавить("2020-01-02T03:04:05+03:00");
	Корпус.Добавить("2020-01-02T03:04:05Z");
	Корпус.Добавить("до" + Символы.ПС + "после");
	Корпус.Добавить("до" + Символы.ВК + "после");
	Корпус.Добавить("до" + Символы.Таб + "после");
	Корпус.Добавить("до""после");
	Корпус.Добавить("до\после");
	Корпус.Добавить("литеральные \n и \\ и \""");
	Корпус.Добавить("юникод: ёжик ünïcode 中文");
	Корпус.Добавить("эмодзи: 🔥🚀");
	Корпус.Добавить("разделители строк:" + Символ(8232) + "и" + Символ(8233));
	Корпус.Добавить("NUL:" + Символ(0) + "конец");
	Корпус.Добавить("управляющий:" + Символ(1) + "конец");
	Корпус.Добавить("шаблон %1 и %2");
	Корпус.Добавить("{""вложенный"":""json"",""когда"":""2020-01-02T03:04:05Z""}");
	Корпус.Добавить("'апостроф' и <угол> и & и /слэш/");
	Корпус.Добавить("");
	Корпус.Добавить(" ");

	Длинная = "0123456789";
	Пока СтрДлина(Длинная) < 40000 Цикл
		Длинная = Длинная + Длинная;
	КонецЦикла;
	Корпус.Добавить(Лев(Длинная, 40000));

	Возврат Корпус;

КонецФункции

// Журнал, у которого граница читаемого хвоста приходится РОВНО на середину первой
// строки, причём её остаток — синтаксически годная запись. Так проверяется, что
// обрывок отбрасывается, а не выдаётся за настоящее событие.
Функция ЖурналСПриманкойНаГранице()

	Если ЖурналСПриманкой_ <> Неопределено Тогда
		Возврат ЖурналСПриманкой_;
	КонецЕсли;

	Каталог = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-аудит-граница-" + Суффикс());
	СоздатьКаталог(Каталог);
	Путь = ОбъединитьПути(Каталог, "аудит.log");

	Приманка = "{""когда"":""2031-02-02T00:00:00Z"",""кто"":""подделка""}";

	// голова строки — без перевода строки, поэтому её длина и есть смещение приманки
	Начало = Новый ЗаписьТекста(Путь, "utf-8", , Истина);
	Начало.Записать("голова оборванной строки: ");
	Начало.Закрыть();
	СмещениеПриманки = Новый Файл(Путь).Размер();

	Писака = Новый ЗаписьТекста(Путь, "utf-8", , Истина);
	Писака.ЗаписатьСтроку(Приманка);
	Для Сч = 1 По 5 Цикл
		Запись = Формат.НоваяЗапись();
		Запись.Когда = Дата(2037, 1, 1) + Сч;
		Запись.Кто = "настоящий";
		Запись.Действие = "граница";
		Запись.Объект = "объект-" + Сч;
		Писака.ЗаписатьСтроку(Формат.Строкой(Запись));
	КонецЦикла;
	Писака.Закрыть();

	// добиваем файл ровно до СмещениеПриманки + размер хвоста: набивочная строка из
	// однобайтовых символов даёт точный размер без арифметики по длине записей
	Осталось = СмещениеПриманки + 4194304 - Новый Файл(Путь).Размер();
	Ожидаем.Что(Осталось > 1, "приманка обязана оказаться ровно на границе хвоста").ЭтоИстина();

	Набивка = "x";
	Пока СтрДлина(Набивка) < Осталось Цикл
		Набивка = Набивка + Набивка;
	КонецЦикла;

	// именно Записать, а не ЗаписатьСтроку: длина завершителя строки платформозависима,
	// а размер файла обязан совпасть до байта
	Хвостовая = Новый ЗаписьТекста(Путь, "utf-8", , Истина);
	Хвостовая.Записать(Лев(Набивка, Осталось));
	Хвостовая.Закрыть();

	Ожидаем.Что(Новый Файл(Путь).Размер() - 4194304,
		"граница хвоста обязана попасть ровно на начало приманки").Равно(СмещениеПриманки);

	ЖурналСПриманкой_ = Путь;

	Возврат Путь;

КонецФункции

#КонецОбласти
