// Журнал аудита в файле: формат строки (запись и разбор — одним классом), захардкоженный
// файловый аппендер logos, чтение хвоста с отбором и страницами.
// Путь журнала свой на прогон: параллельные прогоны не должны драться за один файл.

#Использовать asserts
#Использовать autumn
#Использовать logos
#Использовать "фикстуры"

Перем Исходники;   // фикстура ИсходникиПроекта — чтение файлов репозитория
Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогПроекта;
Перем КаталогТестов;
Перем Поделка;
Перем Летопись;
Перем Читатель;
Перем Аппендер;
Перем Формат;
Перем КореньХранилища;
Перем ЖурналСПриманкой_;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ИсходникиПроекта");
	Исходники = Новый ИсходникиПроекта();

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогКлассов = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"),
		ОбъединитьПути("аудит", "Классы"));

	Для Каждого Имя Из СтрРазделить("ФорматЖурналаАудита,АппендерЖурналаАудита,"
		+ "ЛетописьАудита,ЧитательЖурналаАудита,ИмяОбъектаАудита,ОтборПоАдресу", ",") Цикл
		ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогКлассов, Имя + ".os"));
	КонецЦикла;
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"),
		ОбъединитьПути("основа", "Классы", "КанонIP.os")));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"),
		ОбъединитьПути("основа", "Классы", "ТекстОшибки.os")));

	// вложенного каталога заведомо нет: аппендер обязан создать его сам, иначе старт падает
	КореньХранилища = ОбъединитьПути(
		ОбъединитьПути(КаталогВременныхФайлов(), "oshub-аудит-" + Строка(Новый УникальныйИдентификатор)),
		"вложенный");

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);

	Совет = Новый СоветДругогоМастера();
	// файл autumn-properties.json имеет приоритет над детальками — подменяем имя на
	// несуществующее, иначе журнал уедет в общий ./data и наборы подерутся за файл
	Совет.ИмяФайлаСоЗначениямиДеталек("журнал-аудита-в-файл-properties");
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Летопись = Поделка.НайтиЖелудь("ЛетописьАудита");
	Читатель = Поделка.НайтиЖелудь("ЧитательЖурналаАудита");
	Аппендер = Поделка.НайтиЖелудь("АппендерЖурналаАудита");
	Формат = Поделка.НайтиЖелудь("ФорматЖурналаАудита");

	// служба подключается ПОСЛЕ сборки контейнера: её рогатке нужны желуди events и
	// observability, которых в этом наборе нет, а как класс она нужна для прямого создания
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогКлассов, "СлужбаАудита.os"));
	РеестрФикстур.Подключить("ГотовностьЗаглушка");
	РеестрФикстур.Подключить("ЗаглушкаПутиАудита");
	РеестрФикстур.Подключить("СобытиеЛогаЗаглушка");
	РеестрФикстур.Подключить("ФорматПадающий");

КонецПроцедуры

#Область ФайловыйСлед

&Тест
Процедура СобытиеАудитаДоезжаетДоФайлаЦеликом() Экспорт

	Служба = Новый СлужбаАудита(Неопределено, Новый ГотовностьЗаглушка(), Летопись, Читатель,
		Новый ИмяОбъектаАудита());
	Метка = Суффикс();

	Служба.ОбработатьСобытие(Событие("версия.опубликована" + Метка, Дата(2031, 3, 4, 5, 6, 7),
		"vasya", "public/пакет@1.0.0" + Метка, "субъект-один", "{""версия"":""1.0.0""}", "10.0.0.7"));

	Запись = ПерваяПоДействию("версия.опубликована" + Метка);

	Ожидаем.Что(Запись <> Неопределено, "событие обязано попасть в файл журнала:" + Файл()).ЭтоИстина();
	Ожидаем.Что(Запись.Кто, "кто").Равно("vasya");
	Ожидаем.Что(Запись.Объект, "объект").Равно("public/пакет@1.0.0" + Метка);
	Ожидаем.Что(Запись.Субъект, "субъект доезжает до строки лога").Равно("субъект-один");
	Ожидаем.Что(Запись.Детали, "детали").Равно("{""версия"":""1.0.0""}");
	Ожидаем.Что(Запись.АдресIP, "адрес источника").Равно("10.0.0.7");
	Ожидаем.Что(Запись.Когда, "момент операции — из события, а не время записи")
		.Равно(Дата(2031, 3, 4, 5, 6, 7));

КонецПроцедуры

&Тест
Процедура СтрокаЖурналаНесётВремяВUTCПоISO8601() Экспорт

	Метка = Суффикс();
	Летопись.Записать(ТекущаяУниверсальнаяДата(), "root", "проба.времени" + Метка,
		"объект", "", "", "");

	Сырая = ПерваяСыраяСтрокаС("проба.времени" + Метка);
	Ожидаем.Что(Сырая <> "", "строка найдена в файле").ЭтоИстина();

	Позиция = СтрНайти(Сырая, """когда"":""");
	Ожидаем.Что(Позиция > 0, "в строке журнала обязано быть время: " + Сырая).ЭтоИстина();

	Момент = Сред(Сырая, Позиция + СтрДлина("""когда"":"""), 20);
	Ожидаем.Что(ЭтоISO8601UTC(Момент), "время в UTC по ISO-8601: " + Момент).ЭтоИстина();

	Запись = ПерваяПоДействию("проба.времени" + Метка);
	Разница = Макс(ТекущаяУниверсальнаяДата() - Запись.Когда, Запись.Когда - ТекущаяУниверсальнаяДата());
	Ожидаем.Что(Разница <= 120, "время записи — сейчас, а не эпоха: " + Строка(Запись.Когда)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПереводСтрокиИКавычкиВДеталяхНеРвутЗапись() Экспорт

	Метка = Суффикс();
	Детали = "первая" + Символы.ПС + "вторая с ""кавычками"" и | разделителем и %1";

	БылоСтрок = СтрокФайла();
	Летопись.Записать(ТекущаяУниверсальнаяДата(), "root", "многострочное" + Метка,
		"объект" + Метка, "", Детали, "");

	Ожидаем.Что(СтрокФайла() - БылоСтрок, "одно событие — ровно одна строка файла").Равно(1);

	Запись = ПерваяПоДействию("многострочное" + Метка);
	Ожидаем.Что(Запись <> Неопределено, "запись читается обратно").ЭтоИстина();
	Ожидаем.Что(Запись.Детали, "детали пережили круг без потерь").Равно(Детали);

КонецПроцедуры

&Тест
Процедура КаталогЖурналаСоздаётсяСамимАппендером() Экспорт

	Ожидаем.Что(Аппендер.Открыт(), "файл журнала открыт, хотя каталога не было: "
		+ Аппендер.Сбой()).ЭтоИстина();
	Ожидаем.Что(Новый Файл(Аппендер.Путь()).Существует(),
		"файл журнала создан во вложенном каталоге " + КореньХранилища).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НепригодныйПутьНеРоняетНиСозданиеНиЗапись() Экспорт

	// корень — существующий ФАЙЛ: каталог под ним не создать, файл журнала не открыть
	Занятый = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-аудит-занято-" + Суффикс());
	Писака = Новый ЗаписьТекста(Занятый, "utf-8");
	Писака.ЗаписатьСтроку("не каталог");
	Писака.Закрыть();

	Битый = Новый АппендерЖурналаАудита(Занятый);

	Ожидаем.Что(Битый.Открыт(), "непригодный путь оставляет аппендер закрытым").ЭтоЛожь();
	Ожидаем.Что(Битый.Сбой() <> "", "причина сбоя сохранена: " + Битый.Сбой()).ЭтоИстина();

	ЛетописьБезФайла = Новый ЛетописьАудита(Формат, Битый, Новый КанонIP(), Неопределено,
		ЛогТестов());
	ЛетописьБезФайла.Записать(ТекущаяУниверсальнаяДата(), "root", "в.пустоту", "объект", "", "", "");

	Ожидаем.Что(Истина, "сбой файлового следа не выпустил исключение наружу").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПоднятыйУровеньЛоговНеГлушитЖурналАудита() Экспорт

	Метка = Суффикс();
	Лог = Логирование.ПолучитьЛог("аудит");
	БылУровень = Лог.Уровень();

	// «приглушить сервис» — обычное действие в бою; журнал безопасности этим
	// выключаться не имеет права: logos отсекает событие по уровню ДО способов вывода
	Лог.УстановитьУровень(4);
	Попытка
		Летопись.Записать(ТекущаяУниверсальнаяДата(), "root", "под.уровнем" + Метка,
			"объект", "", "", "");
	Исключение
		Лог.УстановитьУровень(БылУровень);
		ВызватьИсключение;
	КонецПопытки;
	Лог.УстановитьУровень(БылУровень);

	Ожидаем.Что(ПерваяПоДействию("под.уровнем" + Метка) <> Неопределено,
		"событие аудита обязано попасть в файл при любом уровне лога:"
		+ " аппендер вешается со своим уровнем").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АппендерВозобновляетЗаписьПослеУстраненияСбоя() Экспорт

	// корень — существующий ФАЙЛ: каталога под ним не создать
	Занятый = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-аудит-возврат-" + Суффикс());
	Писака = Новый ЗаписьТекста(Занятый, "utf-8");
	Писака.ЗаписатьСтроку("не каталог");
	Писака.Закрыть();

	Аппендер_ = Новый АппендерЖурналаАудита(Занятый);
	Ожидаем.Что(Аппендер_.Открыт(), "препятствие на месте — аппендер закрыт").ЭтоЛожь();

	Строчка = Формат.Строкой(Формат.НоваяЗапись());
	Ожидаем.Что(Падает(Аппендер_, Строчка), "закрытый аппендер честно сообщает о потере")
		.ЭтоИстина();

	УдалитьФайлы(Занятый); // оператор починил права/путь

	Аппендер_.ВывестиСобытие(Новый СобытиеЛогаЗаглушка(Строчка));

	Ожидаем.Что(Аппендер_.Открыт(),
		"после устранения препятствия журнал возобновляется сам, без рестарта хаба")
		.ЭтоИстина();
	Ожидаем.Что(Новый Файл(Аппендер_.Путь()).Существует(), "файл журнала появился").ЭтоИстина();

	Аппендер_.Закрыть();

КонецПроцедуры

&Тест
Процедура СобытияАудитаНеДублируютсяВStdout() Экспорт

	Лог = Логирование.ПолучитьЛог("аудит");
	Способы = Новый Рефлектор().ПолучитьСвойство(Лог, "мСпособыВывода");

	Имена = Новый Массив();
	Для Каждого Способ Из Способы Цикл
		Имена.Добавить(Строка(ТипЗнч(Способ)));
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Имена, ","),
		"у лога аудита ровно один вывод — файловый: консольный вывод logos снимается"
		+ " первым же ручным ДобавитьСпособВывода, дублировать журнал в stdout не нужно")
		.Равно("АппендерЖурналаАудита");

КонецПроцедуры

#КонецОбласти

#Область МногопоточностьЗаписи

&Тест
Процедура КонкурентнаяЗаписьНеПеремешиваетСтроки() Экспорт

	Метка = Суффикс();
	Потоков = 6;
	НаПоток = 150;

	БылоСтрок = СтрокФайла();

	Задания = Новый Массив();
	Для Поток = 1 По Потоков Цикл
		Параметры = Новый Массив();
		Параметры.Добавить(Метка + "-" + Поток);
		Параметры.Добавить(НаПоток);
		Задания.Добавить(ФоновыеЗадания.Выполнить(ЭтотОбъект, "ПисатьПоток", Параметры));
	КонецЦикла;
	ФоновыеЗадания.ОжидатьВсе(Задания);

	Строки = СтрокиФайла();
	Целых = 0;
	Битых = 0;
	Пример = "";
	Для Индекс = БылоСтрок По Строки.Количество() - 1 Цикл
		Строчка = Строки[Индекс];
		Если ПустаяСтрока(Строчка) Тогда
			Продолжить;
		КонецЕсли;
		Если Формат.ИзСтроки(Строчка) = Неопределено Тогда
			Битых = Битых + 1;
			Пример = ?(Пример = "", Лев(Строчка, 200), Пример);
		Иначе
			Целых = Целых + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Битых, "конкурентная запись рвёт строки, если писать без блокировки."
		+ " Пример битой строки: " + Пример).Равно(0);
	Ожидаем.Что(Целых, "ни одна запись не потеряна").Равно(Потоков * НаПоток);

КонецПроцедуры

// Тело фонового задания конкурентного теста.
//
// Параметры:
//  Метка - Строка - префикс действия потока.
//  Сколько - Число - сколько событий записать.
//
Процедура ПисатьПоток(Знач Метка, Знач Сколько) Экспорт

	Для Сч = 1 По Сколько Цикл
		Летопись.Записать(ТекущаяУниверсальнаяДата(), "поток" + Метка, "гонка." + Метка,
			"объект/" + Сч, "субъект", "{""номер"":" + Сч + "}", "10.0.0.1");
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ЧтениеЖурнала

&Тест
Процедура СтраницаОтдаётНовыеПервымиИРежетПоРазмеру() Экспорт

	Метка = Суффикс();
	Для Сч = 1 По 5 Цикл
		Летопись.Записать(Дата(2032, 1, 1) + Сч, "root", "стр." + Метка, "объект-" + Сч, "", "", "");
	КонецЦикла;

	Отбор = Новый Структура("Действие", "стр." + Метка);

	Первая = Читатель.Страница(Отбор, 0, 2);
	Ожидаем.Что(Первая.Записи.Количество(), "размер страницы соблюдён").Равно(2);
	Ожидаем.Что(Первая.Записи[0].Объект, "новые первыми").Равно("объект-5");
	Ожидаем.Что(Первая.Записи[1].Объект, "и дальше по убыванию").Равно("объект-4");
	Ожидаем.Что(Первая.ЕстьСледующая, "есть что показать дальше").ЭтоИстина();

	Вторая = Читатель.Страница(Отбор, 2, 2);
	Ожидаем.Что(Вторая.Записи[0].Объект, "смещение сдвигает окно").Равно("объект-3");

	Последняя = Читатель.Страница(Отбор, 4, 2);
	Ожидаем.Что(Последняя.Записи.Количество(), "хвост короче страницы").Равно(1);
	Ожидаем.Что(Последняя.ЕстьСледующая, "за последней страницей ничего нет").ЭтоЛожь();

	ЗаПределом = Читатель.Страница(Отбор, 100, 2);
	Ожидаем.Что(ЗаПределом.Записи.Количество(), "смещение за пределом — пустая страница").Равно(0);
	Ожидаем.Что(ЗаПределом.ЕстьСледующая, "и следующей нет").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ОтборРаботаетПоДействиюКомуИПериоду() Экспорт

	Метка = Суффикс();
	Летопись.Записать(Дата(2033, 1, 10), "alice", "право.выдано" + Метка, "объект-а", "", "", "");
	Летопись.Записать(Дата(2033, 2, 10), "bob", "право.выдано" + Метка, "объект-б", "", "", "");
	Летопись.Записать(Дата(2033, 3, 10), "alice", "право.отозвано" + Метка, "объект-в", "", "", "");

	ПоДействию = Читатель.Страница(Новый Структура("Действие", "право.выдано" + Метка), 0, 50);
	Ожидаем.Что(ПоДействию.Записи.Количество(), "отбор по действию отсеивает чужое").Равно(2);

	ПоКому = Читатель.Страница(
		Новый Структура("Действие, Кто", "право.выдано" + Метка, "alice"), 0, 50);
	Ожидаем.Что(ПоКому.Записи.Количество(), "отбор по автору сужает").Равно(1);
	Ожидаем.Что(ПоКому.Записи[0].Объект).Равно("объект-а");

	ПоПериоду = Читатель.Страница(
		Новый Структура("Кто, С, По", "alice", Дата(2033, 2, 1), Дата(2033, 4, 1)), 0, 50);
	Ожидаем.Что(ПоПериоду.Записи.Количество(), "период отсекает раннее").Равно(1);
	Ожидаем.Что(ПоПериоду.Записи[0].Объект).Равно("объект-в");

	Граница = Читатель.Страница(
		Новый Структура("Действие, С, По", "право.выдано" + Метка,
			Дата(2033, 1, 10), Дата(2033, 1, 10)), 0, 50);
	Ожидаем.Что(Граница.Записи.Количество(), "границы периода включительны").Равно(1);

КонецПроцедуры

