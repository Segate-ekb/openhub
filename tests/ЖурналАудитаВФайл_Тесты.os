&Тест
Процедура НехваткаХвостаВиднаВызывающему() Экспорт

	Длинный = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-аудит-хвост-" + Суффикс());
	СоздатьКаталог(Длинный);
	ПутьЖурнала = ОбъединитьПути(Длинный, "аудит.log");

	Набивка = "";
	Для Сч = 1 По 40 Цикл
		Набивка = Набивка + "0123456789";
	КонецЦикла;

	Писака = Новый ЗаписьТекста(ПутьЖурнала, "utf-8", , Истина);
	Для Сч = 1 По 12000 Цикл
		Запись = Формат.НоваяЗапись();
		Запись.Когда = Дата(2034, 1, 1) + Сч;
		Запись.Кто = "root";
		Запись.Действие = "набивка";
		Запись.Объект = "объект-" + Сч;
		Запись.Детали = Набивка;
		Писака.ЗаписатьСтроку(Формат.Строкой(Запись));
	КонецЦикла;
	Писака.Закрыть();

	Читатель_ = Новый ЧитательЖурналаАудита(Формат, Новый ЗаглушкаПутиАудита(ПутьЖурнала), ОтборАдреса(), ЛогТестов());
	Страница = Читатель_.Страница(Неопределено, 0, 5);

	Ожидаем.Что(Новый Файл(ПутьЖурнала).Размер() > 4194304,
		"журнал должен перерасти размер читаемого хвоста").ЭтоИстина();
	Ожидаем.Что(Страница.ХвостУсечён,
		"прочитан не весь файл — вызывающий обязан это увидеть, иначе пустой отбор"
		+ " выглядит как «ничего не было»").ЭтоИстина();
	Ожидаем.Что(Страница.Записи.Количество(), "хвост всё равно отдаёт свежие записи").Равно(5);
	Ожидаем.Что(Страница.Записи[0].Объект, "самая свежая запись — в голове").Равно("объект-12000");

КонецПроцедуры

&Тест
Процедура НечитаемыйФайлОтличаетсяОтПустогоЖурнала() Экспорт

	// «Показать нечем» и «событий не было» для аудитора означают РАЗНОЕ, и различить их
	// умеет только источник: пустая страница без признака выдала бы сбой чтения за
	// спокойный пустой журнал.
	Каталог = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-аудит-нечитаемо-" + Суффикс());
	СоздатьКаталог(Каталог);

	Нет = ОбъединитьПути(Каталог, "аудит.log");
	Пустой = Новый ЧитательЖурналаАудита(Формат, Новый ЗаглушкаПутиАудита(Нет), ОтборАдреса(), ЛогТестов())
		.Страница(Неопределено, 0, 20);
	Ожидаем.Что(Пустой.Записи.Количество(), "файла ещё нет — записей нет").Равно(0);
	Ожидаем.Что(Пустой.Доступен,
		"но журнал доступен: ненаписанный журнал — это пустой журнал, а не сбой").ЭтоИстина();

	// путь занят КАТАЛОГОМ: файл «существует», а прочитать его нельзя
	Занятый = ОбъединитьПути(Каталог, "занято.log");
	СоздатьКаталог(Занятый);
	Сбой = Новый ЧитательЖурналаАудита(Формат, Новый ЗаглушкаПутиАудита(Занятый), ОтборАдреса(), ЛогТестов())
		.Страница(Неопределено, 0, 20);

	Ожидаем.Что(Сбой.Записи.Количество(), "прочитать нечего").Равно(0);
	Ожидаем.Что(Сбой.Доступен, "и источник честно говорит, что журнал не прочитан").ЭтоЛожь();

КонецПроцедуры

