&Тест
Процедура ЗаписьПереживаетКругЗаписьРазбор() Экспорт

	Исходная = Формат.НоваяЗапись();
	Исходная.Когда = Дата(2035, 12, 31, 23, 59, 58);
	Исходная.Кто = "пользователь с пробелом";
	Исходная.Действие = "действие=со=знаками";
	Исходная.Объект = "пул/пакет@1.0.0+meta";
	Исходная.Субъект = "группа ""админы""";
	Исходная.Детали = "{""a"":1}" + Символы.ПС + "хвост	с табом и %1";
	Исходная.АдресIP = "2001:db8::1";

	Строчка = Формат.Строкой(Исходная);
	Ожидаем.Что(СтрНайти(Строчка, Символы.ПС), "сериализованная запись — одна строка").Равно(0);

	Обратно = Формат.ИзСтроки(Строчка);

	Ожидаем.Что(Обратно.Когда, "когда").Равно(Исходная.Когда);
	Ожидаем.Что(Обратно.Кто, "кто").Равно(Исходная.Кто);
	Ожидаем.Что(Обратно.Действие, "действие").Равно(Исходная.Действие);
	Ожидаем.Что(Обратно.Объект, "объект").Равно(Исходная.Объект);
	Ожидаем.Что(Обратно.Субъект, "субъект").Равно(Исходная.Субъект);
	Ожидаем.Что(Обратно.Детали, "детали").Равно(Исходная.Детали);
	Ожидаем.Что(Обратно.АдресIP, "адрес").Равно(Исходная.АдресIP);

КонецПроцедуры

&Тест
Процедура ЛюбоеЗначениеПереживаетКругБезПотерь() Экспорт

	Момент = Дата(2036, 5, 6, 7, 8, 9);
	Потери = Новый Массив();

	Для Каждого Значение Из КорпусЗначений() Цикл

		Исходная = Формат.НоваяЗапись();
		Исходная.Когда = Момент;
		Исходная.Кто = Значение;
		Исходная.Объект = Значение;
		Исходная.Детали = Значение;

		Строчка = Формат.Строкой(Исходная);
		Если СтрНайти(Строчка, Символы.ПС) > 0 Тогда
			Потери.Добавить("многострочно: " + Лев(Значение, 40));
			Продолжить;
		КонецЕсли;

		Обратно = Формат.ИзСтроки(Строчка);
		Если Обратно = Неопределено Тогда
			Потери.Добавить("не разобралось: " + Лев(Значение, 40));
			Продолжить;
		КонецЕсли;

		Если Обратно.Детали <> Значение ИЛИ Обратно.Кто <> Значение ИЛИ Обратно.Объект <> Значение Тогда
			Потери.Добавить("положили [" + Лев(Значение, 40) + "] вернулось ["
				+ Лев(Обратно.Детали, 40) + "]");
		ИначеЕсли Обратно.Когда <> Момент Тогда
			Потери.Добавить("время разошлось на значении " + Лев(Значение, 40));
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Потери, "; "),
		"значения журнала обязаны возвращаться байт в байт: писатель и читатель"
		+ " формата разойтись не могут").Равно("");

КонецПроцедуры

&Тест
Процедура ISOПодобноеЗначениеНеТеряетДолиИСмещение() Экспорт

	// именно эти три формы платформенный ЧтениеJSON молча приводит к типу Дата,
	// теряя доли секунды и смещение зоны — значение меняет смысл
	Опасные = Новый Массив();
	Опасные.Добавить("2020-01-02T03:04:05.789Z");
	Опасные.Добавить("2020-01-02T03:04:05");
	Опасные.Добавить("2020-01-02T03:04:05+03:00");

	Для Каждого Значение Из Опасные Цикл
		Исходная = Формат.НоваяЗапись();
		Исходная.Когда = Дата(2036, 5, 6, 7, 8, 9);
		Исходная.Детали = Значение;

		Обратно = Формат.ИзСтроки(Формат.Строкой(Исходная));

		Ожидаем.Что(Обратно.Детали, "значение " + Значение + " обязано вернуться как есть")
			.Равно(Значение);
		Ожидаем.Что(Обратно.Когда, "и момент записи разобран правильно").Равно(Исходная.Когда);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ОборваннаяСтрокаХвостаНеСтановитсяЗаписью() Экспорт

	Путь = ЖурналСПриманкойНаГранице();

	Читатель_ = Новый ЧитательЖурналаАудита(Формат, Новый ЗаглушкаПутиАудита(Путь), ОтборАдреса(), ЛогТестов());
	Страница = Читатель_.Страница(Неопределено, 0, 100);

	Подделки = 0;
	Для Каждого Запись Из Страница.Записи Цикл
		Если Запись.Кто = "подделка" Тогда
			Подделки = Подделки + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Страница.ХвостУсечён, "файл длиннее хвоста — чтение усечено").ЭтоИстина();
	Ожидаем.Что(Подделки,
		"хвост начинается ПОСЕРЕДИНЕ строки: её остаток разбирается как валидный объект"
		+ " и обязан быть отброшен, а не выдан за запись журнала").Равно(0);
	Ожидаем.Что(Страница.Записи.Количество() > 0,
		"настоящие записи из хвоста при этом читаются").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УсечениеХвостаДоезжаетДоВыдачиСлужбы() Экспорт

	// Признак, который остаётся у читателя, — то же самое, что признака нет: экран
	// покажет пустую страницу по старому периоду как «событий не было». Служба обязана
	// перенести его в свою выдачу, и Ложь на целиком прочитанном журнале — тоже ответ.
	Длинный = Новый ЧитательЖурналаАудита(Формат,
		Новый ЗаглушкаПутиАудита(ЖурналСПриманкойНаГранице()), ОтборАдреса(), ЛогТестов());

	Выдача = СлужбаНад(Длинный).ЗаписиСтраницей(Неопределено, 1, 5);

	Ожидаем.Что(Выдача.Свойство("ХвостУсечён"),
		"выдача службы обязана нести признак усечения").ЭтоИстина();
	Ожидаем.Что(Выдача.ХвостУсечён,
		"файл длиннее читаемого хвоста — пользователю показано не всё").ЭтоИстина();
	Ожидаем.Что(Выдача.Записи.Количество() > 0, "записи из хвоста при этом читаются").ЭтоИстина();

	Метка = Суффикс();
	Летопись.Записать(ТекущаяУниверсальнаяДата(), "root", "целиком." + Метка, "объект", "", "", "");
	Короткая = СлужбаНад(Читатель).ЗаписиСтраницей(
		Новый Структура("Действие", "целиком." + Метка), 1, 5);

	Ожидаем.Что(Короткая.Записи.Количество(), "журнал набора читается целиком").Равно(1);
	Ожидаем.Что(Короткая.ХвостУсечён,
		"короткий журнал прочитан весь — усечения нет").ЭтоЛожь();

КонецПроцедуры

