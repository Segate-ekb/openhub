// Юнит-тесты фабрики КонфигурацияХранилища: выбор бэкенда по конфигу, проброс каталога и квоты,
// ключи S3 — детальками значением либо файлом. Фабрика создаётся прямым конструктором.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассов = ОбъединитьПути(
		ОбъединитьПути(КаталогПроекта, "src", "модули"), "хранилище", "Классы");

	ПоискКлассов.ПодключитьВсе(КаталогКлассов);

	// примитивы основы целиком, а не поштучно: хранилище спрашивает у них уборку, хеш,
	// числа и флаги, и поимённый список ломал бы набор на каждом новом примитиве
	ПоискКлассов.ПодключитьОснову(ОбъединитьПути(КаталогКлассов, "..", ".."));

	РеестрФикстур.Подключить("НастройкиЗаглушка");

КонецПроцедуры

&Тест
Процедура ПотолокОбъёмаСпрашиваетсяНаЗаписиАНеПриСборке() Экспорт

	// ИСТ-НАСТ-013: порог крутят по мере роста хаба, и поднятый из формы потолок судит
	// уже следующую публикацию. Вшитый при сборке бэкенда потолок этого не умеет
	Каталог = УникальныеИмена.ВременныйКаталог("oshub-storage-cap");

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.storage.quota.bytes", 10);
	Хранилище = Новый ФайловоеХранилище(Каталог, 0, Новый ПотолокХранилища(Настройки));

	Координаты = Новый КоординатыАртефакта("pool", "pkg", "1.0.0");
	Данные = ПолучитьДвоичныеДанныеИзСтроки("0123456789ABCDEF", "UTF-8");

	Ожидаем.Что(Падает(Хранилище, Координаты, Данные),
		"артефакт крупнее потолка не размещается").ЭтоИстина();

	// потолок поднят из интерфейса — БЕЗ пересборки бэкенда
	Настройки.Задать("oshub.storage.quota.bytes", 1048576);
	Ожидаем.Что(Падает(Хранилище, Координаты, Данные),
		"тот же бэкенд судит уже по новому потолку").ЭтоЛожь();

	// ноль по-прежнему означает «хаб объём не ограничивает»
	Настройки.Задать("oshub.storage.quota.bytes", 0);
	Ожидаем.Что(Падает(Хранилище, Новый КоординатыАртефакта("pool", "pkg", "2.0.0"), Данные),
		"ноль — без ограничения, а не «места нет»").ЭтоЛожь();

	УникальныеИмена.УбратьВременное(Каталог);

КонецПроцедуры

&Тест
Процедура BackendFileСобираетФайловыйБэкенд() Экспорт

	Фабрика = Новый КонфигурацияХранилища("file", "./данные-тест", , , , , , , ЛогТестов());
	Хранилище = Фабрика.ХранилищеАртефактов();

	Ожидаем.Что(ТипЗнч(Хранилище)).Равно(Тип("ФайловоеХранилище"));
	Ожидаем.Что(Хранилище.Бэкенд()).Равно("fs");

КонецПроцедуры

&Тест
Процедура ПустойBackendПоУмолчаниюФайловый() Экспорт

	Фабрика = Новый КонфигурацияХранилища("", "./данные-тест", , , , , , , ЛогТестов());
	Ожидаем.Что(ТипЗнч(Фабрика.ХранилищеАртефактов())).Равно(Тип("ФайловоеХранилище"));

КонецПроцедуры

&Тест
Процедура BackendS3БезСекретовПадаетПонятнойОшибкой() Экспорт

	// s3-ветка выбрана, а ключей нет ни значением, ни файлом
	Фабрика = Новый КонфигурацияХранилища("s3", "",
		"http://localhost:9000", "us-east-1", "openhub-artifacts", "Истина", "", , ЛогТестов());

	ТекстОшибки = "";
	Попытка
		Фабрика.ХранилищеАртефактов();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(ТекстОшибки, "S3") > 0,
		"ожидали ошибку конфигурации S3-бэкенда, получили: " + ТекстОшибки).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТекстОшибки, "oshub.storage.s3.access_key") > 0,
		"ошибка называет настройку ключа доступа, получили: " + ТекстОшибки).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТекстОшибки, "oshub.storage.s3.secret_key_file") > 0,
		"и файловый путь секретного ключа, получили: " + ТекстОшибки).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КлючиS3ПриходятДетальками() Экспорт

	Фабрика = Новый КонфигурацияХранилища("s3", "", "http://localhost:9000", "us-east-1",
		"openhub-artifacts", "Истина", "", , ЛогТестов(), , "ключ-доступа", , "секретный-ключ");

	Ожидаем.Что(ТипЗнч(Фабрика.ХранилищеАртефактов()), "S3 собран из деталек ключей")
		.Равно(Тип("S3Хранилище"));

КонецПроцедуры

&Тест
Процедура КлючиS3ЧитаютсяИзФайлов() Экспорт

	Каталог = УникальныеИмена.ВременныйПуть("ключи-s3");
	СоздатьКаталог(Каталог);
	ФайлДоступа = ОбъединитьПути(Каталог, "access");
	ФайлСекрета = ОбъединитьПути(Каталог, "secret");
	ЗаписатьТекст(ФайлДоступа, "ключ-доступа" + Символы.ПС);
	ЗаписатьТекст(ФайлСекрета, "секретный-ключ" + Символы.ПС);

	Попытка
		Фабрика = Новый КонфигурацияХранилища("s3", "", "http://localhost:9000", "us-east-1",
			"openhub-artifacts", "Истина", "", , ЛогТестов(), , , ФайлДоступа, , ФайлСекрета);
		Ожидаем.Что(ТипЗнч(Фабрика.ХранилищеАртефактов()), "S3 собран из файлов секретов")
			.Равно(Тип("S3Хранилище"));
	Исключение
		УникальныеИмена.УбратьВременное(Каталог);
		ВызватьИсключение;
	КонецПопытки;

	УникальныеИмена.УбратьВременное(Каталог);

КонецПроцедуры

&Тест
Процедура BackendS3БезБакетаИЭндпоинтаПеречисляетНедостающее() Экспорт

	Фабрика = Новый КонфигурацияХранилища("s3", "", "", "us-east-1", "", "Истина", "", , ЛогТестов());

	ТекстОшибки = "";
	Попытка
		Фабрика.ХранилищеАртефактов();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(ТекстОшибки, "бакет") > 0, ТекстОшибки).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТекстОшибки, "эндпоинт") > 0, ТекстОшибки).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КлиентS3OintИS3ХранилищеКонструируютсяБезСети() Экспорт

	Клиент = Новый КлиентS3Oint("http://localhost:9000", "us-east-1", "bkt", "ak", "sk",
		Истина, ЛогТестов());
	Хранилище = Новый S3Хранилище(Клиент, "префикс", 0);

	Ожидаем.Что(Хранилище.Бэкенд()).Равно("s3");

КонецПроцедуры

Процедура ЗаписатьТекст(Знач Путь, Знач Текст)
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

// Лог для классов, созданных напрямую минуя контейнер: продуктовый класс получает лог инъекцией
// и без него отказывает громко (см. tests/ДисциплинаЛогирования_Тесты.os).
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.storage");
КонецФункции

// Отвергает ли хранилище размещение артефакта.
Функция Падает(Знач Хранилище, Знач Координаты, Знач Данные)
	Попытка
		Хранилище.Сохранить(Координаты, Данные);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции
