// Сторожа журнала расследования: арность вызовов доказывается исполнением СтрШаблон,
// обезличивание — значениями, переключение уровня и молчание при INFO — живым классом.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем Исходники;   // фикстура ИсходникиПроекта — чтение файлов репозитория
Перем КаталогПроекта;
Перем Обезличивание;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ИсходникиПроекта");
	Исходники = Новый ИсходникиПроекта();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	// клиент апстрима спрашивает ожидание похода наружу у владельца
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "сеть", "Классы"), "ТаймаутыHTTP");

	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы",
		ОбъединитьПути("журнал", "ОбезличиваниеЖурнала.os")), "ОбезличиваниеЖурнала");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "прокси", "Классы",
		"СекретИсточника.os"), "СекретИсточника");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "прокси", "Классы",
		"КлиентАпстрима.os"), "КлиентАпстрима");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы",
		ОбъединитьПути("журнал", "УровниЖурнала.os")), "УровниЖурнала");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ФейкТранспортHTTP");

	Обезличивание = Новый ОбезличиваниеЖурнала();

КонецПроцедуры

#Область АрностьВызововЖурнала

// Лишний заполненный аргумент — исключение СтрШаблон, и logos форматирует ПОСЛЕ отсечения
// по уровню: при INFO мина спит, на ОТЛАДКЕ рвётся ровно тогда, когда журнал и понадобился.
// Шаблон и число аргументов берутся из исходников, а вердикт выносит сам СтрШаблон.
&Тест
Процедура ВызовыЖурналаПереживаютПодстановкуАргументов() Экспорт

	Нарушители = Новый Массив();
	Всего = 0;

	Для Каждого Файл Из ПродуктовыеФайлы() Цикл
		Для Каждого Вызов Из ВызовыЖурналаВФайле(Файл) Цикл
			Всего = Всего + 1;
			Беда = ЧтоНеТакСВызовом(Вызов);
			Если ЗначениеЗаполнено(Беда) Тогда
				Нарушители.Добавить(Исходники.ОтносительныйПуть(Файл) + ": " + Беда);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Всего >= 100,
		СтрШаблон("разобрано %1 вызовов журнала при минимуме 100 — скан ослеп", Всего)).ЭтоИстина();

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС),
		"вызовы журнала, которые СтрШаблон не переживёт: число аргументов не сходится"
		+ " с числом мест подстановки").Равно("");

КонецПроцедуры

&Тест
Процедура СтрШаблонВзрываетсяИменноНаЛишнемАргументе() Экспорт

	Ожидаем.Что(ЧтоНеТакСВызовом(Вызов("нет мест подстановки", 2)),
		"лишний аргумент опознан").Содержит("аргументов 1");

	Ожидаем.Что(ЧтоНеТакСВызовом(Вызов("есть %1", 2)),
		"ровно по местам — не нарушение").Равно("");

	Ожидаем.Что(ЧтоНеТакСВызовом(Вызов("есть %1 и %2", 2)),
		"недостача мест исключения не даёт: СтрШаблон подставит пустую строку").Равно("");

	Ожидаем.Что(ЧтоНеТакСВызовом(Вызов("сто %%1 процентов", 2)),
		"экранированный процент местом подстановки не является").Содержит("аргументов 1");

	Ожидаем.Что(ЧтоНеТакСВызовом(Вызов("%1 и снова %1", 3)),
		"повтор одного места вторым аргументом не оплачивается").Содержит("аргументов 2");

КонецПроцедуры

// Шаблон с параметрами обязан быть литералом: иначе судить об арности нечем, и вызов
// уезжает в продакшн неразобранным. Один аргумент безопасен всегда — logos при пустых
// параметрах СтрШаблон не зовёт вовсе.
&Тест
Процедура ШаблонСПараметрамиОбязанБытьЛитералом() Экспорт

	Ожидаем.Что(ЧтоНеТакСВызовом(ВызовСВыражением("Сообщение", 1)),
		"переменная без параметров — законный вызов").Равно("");

	Ожидаем.Что(ЧтоНеТакСВызовом(ВызовСВыражением("Сообщение", 2)),
		"переменная с параметрами — судить нечем").Содержит("не литерал");

КонецПроцедуры

#КонецОбласти

#Область СамотестыСкана

&Тест
Процедура СканВидитВызовыПродуктаИНеВидитТекста() Экспорт

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка(""%1"", Имя);").Количество(),
		"обычный вызов найден").Равно(1);

	Ожидаем.Что(ВызовыЖурналаВТексте("	// Лог.Отладка(""%1"", Имя);").Количество(),
		"вызов в комментарии — не вызов").Равно(0);

	Ожидаем.Что(ВызовыЖурналаВТексте("	Образец = ""Лог.Отладка(%1)"";").Количество(),
		"вызов внутри литерала — не вызов").Равно(0);

	Ожидаем.Что(ВызовыЖурналаВТексте("	КаталогЛог.Отладка(""%1"", Имя);").Количество(),
		"хвост чужого идентификатора — не наш вызов").Равно(0);

КонецПроцедуры

// OneScript зовёт метод и через пробел, и через перенос строки. Скан, искавший точное
// «Лог.Отладка(», оставался зелёным при живой мине арности — а мина в КлиентеАпстрима
// не роняет запрос, а глотается перехватом и выдаёт «апстрим недоступен (offline)»:
// включённая отладка заставила бы хаб считать недоступными все апстримы сразу.
&Тест
Процедура ПробелПередСкобкойНеПрячетВызов() Экспорт

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка (""%1"", Имя);").Количество(),
		"пробел перед скобкой вызов не прячет").Равно(1);

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка	(""%1"", Имя);").Количество(),
		"табуляция перед скобкой вызов не прячет").Равно(1);

	Ожидаем.Что(ВызовыЖурналаВТексте(
			"	Лог.Отладка" + Символы.ПС + "		(""нет мест"", Лишний);")[0].Аргументов,
		"перенос строки перед скобкой вызов не прячет, аргументы читаются").Равно(2);

	Ожидаем.Что(ЧтоНеТакСВызовом(
			ВызовыЖурналаВТексте("	Лог.Отладка (""нет мест"", Лишний);")[0]),
		"мина за пробелом опознана").Содержит("аргументов 1");

	Ожидаем.Что(ВызовыЖурналаВТексте("	Значение = Лог.Отладка;").Количество(),
		"обращение без скобки вызовом не считается").Равно(0);

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка /* */ (""%1"", Имя);").Количество(),
		"между именем и скобкой допустимы только пробелы: прочее — не вызов").Равно(0);

КонецПроцедуры

&Тест
Процедура СканСчитаетАргументыАНеЗапятые() Экспорт

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка(""а, б: %1"", Имя);")[0].Аргументов,
		"запятая внутри литерала аргумента не делит").Равно(2);

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка(""%1"", Массив.Количество());")[0].Аргументов,
		"скобки вложенного вызова не закрывают вызов журнала").Равно(2);

	Ожидаем.Что(ВызовыЖурналаВТексте(
			"	Лог.Отладка(""%1 и %2""," + Символы.ПС + "		Первый, Второй);")[0].Аргументов,
		"вызов, разбитый на строки, читается целиком").Равно(3);

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка(""%1"", ?(Флаг, ""а"", ""б""));")[0].Аргументов,
		"запятые внутри литералов тернарника не делят аргументы").Равно(2);

КонецПроцедуры

&Тест
Процедура СканСобираетШаблонИзЧастей() Экспорт

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка(""левая %1"" + "" правая %2"", А, Б);")[0].Шаблон,
		"склейка литералов собирается в один шаблон").Равно("левая %1 правая %2");

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка(""кавычка """" внутри %1"", А);")[0].Шаблон,
		"удвоенная кавычка — содержимое литерала, а не его конец")
		.Равно("кавычка "" внутри %1");

	Ожидаем.Что(ВызовыЖурналаВТексте(
			"	Лог.Отладка(""первая" + Символы.ПС + "		|вторая %1"", А);")[0].Шаблон,
		"многострочный литерал склеивается без вертикальной черты")
		.Равно("первая" + Символы.ПС + "вторая %1");

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка(Шаблон + ""хвост %1"", А);")[0].Литерал,
		"шаблон с переменной литералом не считается").ЭтоЛожь();

	Ожидаем.Что(ВызовыЖурналаВТексте(
			"	Лог.Отладка(""левая"" + Символы.ПС + ""правая %1"", А);")[0].Литерал,
		"Символы.ПС в склейке литерал не портит").ЭтоИстина();

КонецПроцедуры

// Скан обязан находить живые вызовы всех уровней в src/, иначе главная проверка зелена ни о чём.
&Тест
Процедура СканНаходитВсеУровниВПродукте() Экспорт

	Уровни = Новый Соответствие();
	Для Каждого Файл Из ПродуктовыеФайлы() Цикл
		Для Каждого Вызов Из ВызовыЖурналаВФайле(Файл) Цикл
			Уровни.Вставить(Вызов.Уровень, Истина);
		КонецЦикла;
	КонецЦикла;

	Отсутствуют = Новый Массив();
	Для Каждого Уровень Из СтрРазделить("Отладка,Информация,Предупреждение,Ошибка", ",") Цикл
		Если Уровни.Получить(Уровень) = Неопределено Тогда
			Отсутствуют.Добавить(Уровень);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Отсутствуют, ", "),
		"уровни журнала, которых скан не встретил в src/ — либо уровень пропал из продукта,"
		+ " либо скан перестал его видеть").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Обезличивание

&Тест
Процедура АдресТеряетПараметрыИУчётныеДанные() Экспорт

	Ожидаем.Что(Обезличивание.Адрес("https://hub.example.com/download/list.txt"),
		"адрес без параметров остаётся читаемым целиком")
		.Равно("https://hub.example.com/download/list.txt");

	Ожидаем.Что(Обезличивание.Адрес("https://hub.example.com/x?token=СЕКРЕТ&a=1"),
		"строка запроса снята, факт её наличия сохранён")
		.Равно("https://hub.example.com/x?…");

	Ожидаем.Что(Обезличивание.Адрес("https://вася:СЕКРЕТ@hub.example.com:8443/x"),
		"учётные данные из authority сняты")
		.Равно("https://…@hub.example.com:8443/x");

	Ожидаем.Что(Обезличивание.Адрес("https://hub.example.com/x#СЕКРЕТ"),
		"фрагмент снят вместе с содержимым").Равно("https://hub.example.com/x");

	Ожидаем.Что(Обезличивание.Адрес("https://вася:СЕКРЕТ@hub.example.com/p?q=СЕКРЕТ"),
		"учётные данные и параметры снимаются вместе")
		.Равно("https://…@hub.example.com/p?…");

	// пароль пула набирают руками, и «/» в нём законен: резка authority по первой косой
	// оставляла такой пароль целиком — «@» оказывался уже «в пути» и учётку не срезали
	Ожидаем.Что(Обезличивание.Адрес("https://вася:СЕК/РЕТ@hub.example.com/d/list.txt"),
		"косая внутри пароля не спасает учётные данные от срезания")
		.Равно("https://…@hub.example.com/d/list.txt");

	Ожидаем.Что(СтрНайти(Обезличивание.Адрес("https://u:a/b/c@hub.example.com/d"), "a/b/c"),
		"ни куска пароля с несколькими косыми наружу").Равно(0);

	Ожидаем.Что(Обезличивание.Адрес(""), "пустой адрес").Равно("«пусто»");
	Ожидаем.Что(Обезличивание.Адрес(Неопределено), "адреса нет").Равно("«пусто»");

КонецПроцедуры

&Тест
Процедура СекретОстаётсяТолькоФактомНаличия() Экспорт

	Ожидаем.Что(Обезличивание.Секрет("ghp_ОченьДлинныйТокен"),
		"содержимого нет, длина есть").Равно("«задано, 21 симв.»");

	Ожидаем.Что(Обезличивание.Секрет(""), "пустой секрет").Равно("«пусто»");
	Ожидаем.Что(Обезличивание.Секрет("   "), "секрет из пробелов — пустой").Равно("«пусто»");
	Ожидаем.Что(Обезличивание.Секрет(Неопределено), "секрета нет").Равно("«пусто»");

	Ожидаем.Что(СтрНайти(Обезличивание.Секрет("s3cret"), "s3cret"),
		"ни одного знака секрета наружу").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПоведениеЖурналаНаЖивомКлассе

// Отладка обязана быть выключаемой: то, что при INFO не написано ни строки, — это и есть
// «шум под контролем», а появление тех же строк на DEBUG — «уровень переключается».
&Тест
Процедура УровеньЖурналаПереключаетОтладкуРеальногоКласса() Экспорт

	ПриИнформации = ПрогнатьКлиентАпстрима(УровниЛога.Информация, "https://hub.example.com/d/");
	ПриОтладке = ПрогнатьКлиентАпстрима(УровниЛога.Отладка, "https://hub.example.com/d/");

	Ожидаем.Что(ПриИнформации.Количество(),
		"при INFO отладочных строк в консоли нет: " + ПриИнформации.Всё()).Равно(0);

	Ожидаем.Что(ПриОтладке.Количество() > 0,
		"при DEBUG путь до апстрима виден").ЭтоИстина();

	Ожидаем.Что(СтрНайти(ПриОтладке.Всё(), "hub.example.com") > 0,
		"в отладке названо, к кому ходили: " + ПриОтладке.Всё()).ЭтоИстина();

	Ожидаем.Что(СтрНайти(ПриОтладке.Всё(), "200") > 0,
		"в отладке назван ответ апстрима: " + ПриОтладке.Всё()).ЭтоИстина();

КонецПроцедуры

// ИСТ-ЭКСП-006: подробность поднимается ТОЧЕЧНО. Носитель — окружение: связка logos
// инъектируется деталькой и файл оператора перебивает, поэтому уровни компонентов едут
// в OSHUB_LOG_LEVELS. Компонент обязан получить свой уровень, а остальные — корневой.
&Тест
Процедура ТочечныйУровеньПоднимаетсяОдномуКомпоненту() Экспорт

	Логи = НоваяСвязка("INFO", "КлиентАпстрима=DEBUG,СервисПрокси=WARN").Логи;

	Ожидаем.Что(Логи["rootLogger"]["level"], "корневой уровень взят как задан").Равно("INFO");
	Ожидаем.Что(Логи["КлиентАпстрима"]["level"], "компоненту поднята подробность").Равно("DEBUG");
	Ожидаем.Что(Логи["СервисПрокси"]["level"], "второму компоненту свой уровень").Равно("WARN");
	Ожидаем.Что(Логи["КлиентАпстрима"]["appenders"].Количество() > 0,
		"у компонента есть куда писать: без способов вывода поднятый уровень немой").ЭтоИстина();

КонецПроцедуры

// Цена подробности платится только тогда, когда её попросили. Уровень способа вывода
// открывает гейт logos: способ вывода на DEBUG заставляет КАЖДЫЙ лог собирать подавленную
// отладочную строку целиком, и «выключенная подробность ничего не стоит» перестаёт быть
// правдой. Поэтому уровень способов вывода — самый подробный из ФАКТИЧЕСКИ запрошенных.
&Тест
Процедура УровеньСпособовВыводаРавенСамойПодробнойПросьбе() Экспорт

	Умолчания = НоваяСвязка("INFO", "").СпособыВывода;
	Ожидаем.Что(Умолчания["console"]["level"],
		"при умолчаниях гейт logos закрыт рано — отладочные строки не собираются").Равно("INFO");
	Ожидаем.Что(Умолчания["otel"]["level"], "оба способа вывода на одном уровне").Равно("INFO");

	Точечная = НоваяСвязка("INFO", "КлиентАпстрима=DEBUG").СпособыВывода;
	Ожидаем.Что(Точечная["console"]["level"],
		"попросили отладку компоненту — гейт открылся до DEBUG").Равно("DEBUG");

	Молчаливая = НоваяСвязка("ERROR", "КлиентАпстрима=WARN").СпособыВывода;
	Ожидаем.Что(Молчаливая["console"]["level"],
		"самая подробная просьба здесь — WARN, ниже гейт не опускается").Равно("WARN");

	Ожидаем.Что(НоваяСвязка("DEBUG", "").СпособыВывода["otel"]["level"],
		"подробность целиком хабу тоже открывает гейт").Равно("DEBUG");

	// DEFAULT — законное слово, хаб сам называет его в подсказке. Подробности оно собой
	// не добавляет («как у корня»), и в ряду подробности его нет: не прочитав это, расчёт
	// уровня способов вывода ронял старт на непонятном «Invalid type of argument».
	Ожидаем.Что(НоваяСвязка("DEFAULT", "").СпособыВывода["console"]["level"],
		"корневой DEFAULT читается как INFO и гейт не открывает").Равно("INFO");

	Ожидаем.Что(НоваяСвязка("INFO", "СервисПрокси=DEFAULT").СпособыВывода["console"]["level"],
		"DEFAULT у компонента гейт тоже не открывает").Равно("INFO");

	Ожидаем.Что(
		НоваяСвязка("INFO", "СервисПрокси=DEFAULT,ГотовностьХаба=DEBUG").СпособыВывода["otel"]["level"],
		"DEFAULT рядом с настоящей просьбой её не отменяет").Равно("DEBUG");

КонецПроцедуры

// Уровнем распоряжается лог, а не способ вывода: способы вывода объявлены самым подробным
// из запрошенных уровней, и отбор чужой подробности делает сам способ вывода.
&Тест
Процедура СтрокаНижеУровняСвоегоЛогаНеПроходит() Экспорт

	Уровни = Новый УровниЖурнала();

	Ожидаем.Что(Уровни.СтрокаПроходит(СобытиеУровня(УровниЛога.Отладка, УровниЛога.Информация)),
		"отладка спокойного лога не проходит").ЭтоЛожь();
	Ожидаем.Что(Уровни.СтрокаПроходит(СобытиеУровня(УровниЛога.Отладка, УровниЛога.Отладка)),
		"отладка подробного лога проходит").ЭтоИстина();
	Ожидаем.Что(Уровни.СтрокаПроходит(СобытиеУровня(УровниЛога.Ошибка, УровниЛога.Информация)),
		"ошибка проходит всегда").ЭтоИстина();

КонецПроцедуры

// Незнакомое слово уровня роняло хаб голой ошибкой logos, в которой нет ни имени
// переменной, ни списка допустимых. Откат на запасное плюс внятное замечание.
&Тест
Процедура НезнакомыйУровеньНеРоняетСтартАОбъясняется() Экспорт

	Уровни = Новый УровниЖурнала();
	Логи = Уровни.Связка("TRACE", "КлиентАпстрима=ОЧЕНЬПОДРОБНО,мусор", ТипыСпособовВывода()).Логи;

	Ожидаем.Что(Логи["rootLogger"]["level"], "корневой уровень откатился на INFO").Равно("INFO");
	Ожидаем.Что(Логи["КлиентАпстрима"]["level"],
		"компонент остался на корневом уровне").Равно("DEFAULT");
	Ожидаем.Что(Логи.Получить("мусор"),
		"токен без знака равенства именем лога не становится").Равно(Неопределено);

	Замечания = СтрСоединить(Уровни.Замечания(), Символы.ПС);
	Ожидаем.Что(СтрНайти(Замечания, "OSHUB_LOG_LEVEL") > 0,
		"замечание называет переменную: " + Замечания).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Замечания, "CRITICALERROR") > 0,
		"замечание перечисляет допустимые уровни: " + Замечания).ЭтоИстина();

КонецПроцедуры

// Пустое окружение — не ошибка оператора: умолчание берётся молча.
&Тест
Процедура НезаданныеУровниЗамечанийНеРодят() Экспорт

	Уровни = Новый УровниЖурнала();
	Связка = Уровни.Связка("", "", ТипыСпособовВывода());

	Ожидаем.Что(Связка.Логи["rootLogger"]["level"], "корневой уровень по умолчанию").Равно("INFO");
	Ожидаем.Что(Уровни.Замечания().Количество(), "жаловаться не на что").Равно(0);

КонецПроцедуры

// Секрет в адресе апстрима — не выдумка: базовый URL пула правится руками, и токен
// в строке запроса туда попадает ровно так же, как в любую другую настройку.
&Тест
Процедура СекретИзАдресаАпстримаВЖурналНеПопадает() Экспорт

	Ловушка = ПрогнатьКлиентАпстрима(УровниЛога.Отладка,
		"https://логин:ПАРОЛЬ42@hub.example.com/d/?token=ТОКЕН42");

	Ожидаем.Что(Ловушка.Количество() > 0, "отладка вообще писалась").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "ТОКЕН42"),
		"токен из строки запроса в журнал не попал: " + Ловушка.Всё()).Равно(0);

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "ПАРОЛЬ42"),
		"пароль из учётных данных адреса в журнал не попал: " + Ловушка.Всё()).Равно(0);

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "hub.example.com") > 0,
		"узел при этом остался виден — иначе отладка бесполезна").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Обвязка

Функция ПрогнатьКлиентАпстрима(Знач Уровень, Знач БазовыйURL)

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.журнал." + Строка(Уровень));
	Лог.УстановитьУровень(Уровень);
	Лог.ДобавитьСпособВывода(Ловушка);

	Транспорт = Новый ФейкТранспортHTTP();
	Транспорт.УстановитьОтвет(200, "a" + Символы.ПС + "b", """etag-1""");

	Клиент = Новый КлиентАпстрима(Транспорт, НастройкиПрокси(5), Лог);
	Клиент.ПолучитьТекст(БазовыйURL, "list.txt");

	Лог.УдалитьСпособВывода(Ловушка);

	Возврат Ловушка;

КонецФункции

Функция Вызов(Знач Шаблон, Знач Аргументов)
	Возврат Новый Структура("Уровень, Шаблон, Аргументов, Литерал, Текст",
		"Отладка", Шаблон, Аргументов, Истина, "");
КонецФункции

Функция ВызовСВыражением(Знач Текст, Знач Аргументов)
	Возврат Новый Структура("Уровень, Шаблон, Аргументов, Литерал, Текст",
		"Отладка", "", Аргументов, Ложь, Текст);
КонецФункции

#КонецОбласти

#Область ПроверкаВызова

// Вердикт выносит сам СтрШаблон: подставляем столько же аргументов, сколько стоит в коде,
// и смотрим, переживёт ли он это. Так проверка не зависит от нашего счёта мест подстановки.
Функция ЧтоНеТакСВызовом(Знач Вызов)

	Если Вызов.Аргументов <= 1 Тогда
		Возврат ""; // logos при пустых параметрах СтрШаблон не зовёт вовсе
	КонецЕсли;

	Если НЕ Вызов.Литерал Тогда
		Возврат СтрШаблон("шаблон не литерал (%1) при %2 аргументах — арность не проверяема,"
			+ " соберите сообщение до вызова журнала", Вызов.Текст, Вызов.Аргументов);
	КонецЕсли;

	Попытка
		Подставить(Вызов.Шаблон, Вызов.Аргументов - 1);
	Исключение
		Возврат СтрШаблон("«%1» — аргументов %2, а мест подстановки меньше: %3",
			Однострочно(Вызов.Шаблон), Вызов.Аргументов - 1,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат "";

КонецФункции

Функция Подставить(Знач Шаблон, Знач Сколько)

	З = "x";
	Если Сколько = 1 Тогда
		Возврат СтрШаблон(Шаблон, З);
	ИначеЕсли Сколько = 2 Тогда
		Возврат СтрШаблон(Шаблон, З, З);
	ИначеЕсли Сколько = 3 Тогда
		Возврат СтрШаблон(Шаблон, З, З, З);
	ИначеЕсли Сколько = 4 Тогда
		Возврат СтрШаблон(Шаблон, З, З, З, З);
	ИначеЕсли Сколько = 5 Тогда
		Возврат СтрШаблон(Шаблон, З, З, З, З, З);
	ИначеЕсли Сколько = 6 Тогда
		Возврат СтрШаблон(Шаблон, З, З, З, З, З, З);
	ИначеЕсли Сколько = 7 Тогда
		Возврат СтрШаблон(Шаблон, З, З, З, З, З, З, З);
	ИначеЕсли Сколько = 8 Тогда
		Возврат СтрШаблон(Шаблон, З, З, З, З, З, З, З, З);
	КонецЕсли;

	Возврат СтрШаблон(Шаблон, З, З, З, З, З, З, З, З, З);

КонецФункции

Функция Однострочно(Знач Текст)
	Возврат СтрЗаменить(СтрЗаменить(Строка(Текст), Символы.ПС, "⏎"), Символы.Таб, " ");
КонецФункции

#КонецОбласти

#Область СканВызовов

Функция ВызовыЖурналаВФайле(Знач Путь)
	Возврат ВызовыЖурналаВТексте(Исходники.Текст(Путь));
КонецФункции

// Разметка отделяет код от литералов и комментариев, поэтому структуру вызова читаем
// по ней, а содержимое шаблона — по исходному тексту.
Функция ВызовыЖурналаВТексте(Знач ИсходныйТекст)

	Текст = СтрЗаменить(Строка(ИсходныйТекст), Символы.ВК, "");
	Результат = Новый Массив();
	Если СтрНайти(Текст, "Лог.") = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Разметка = РазметкаТекста(Текст);

	Для Каждого Уровень Из УровниЖурнала() Цикл
		Образец = "Лог." + Уровень;
		Позиция = 1;
		Пока Истина Цикл
			Найдено = СтрНайти(Текст, Образец, , Позиция);
			Если Найдено = 0 Тогда
				Прервать;
			КонецЕсли;
			Позиция = Найдено + 1;
			Если Сред(Разметка, Найдено, 1) <> "к" Тогда
				Продолжить; // вызов внутри литерала или комментария
			КонецЕсли;
			Если НЕ ЭтоГраницаИдентификатора(Текст, Найдено - 1) Тогда
				Продолжить; // хвост чужого имени: КаталогЛог.Отладка
			КонецЕсли;
			Скобка = ПозицияСкобкиВызова(Текст, Разметка, Найдено + СтрДлина(Образец));
			Если Скобка = 0 Тогда
				Продолжить; // не вызов: Лог.Отладка без скобки — обращение к свойству
			КонецЕсли;
			Вызов = РазобратьВызов(Текст, Разметка, Уровень, Скобка);
			Если Вызов <> Неопределено Тогда
				Результат.Добавить(Вызов);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция УровниЖурнала()
	Возврат СтрРазделить("Отладка,Информация,Предупреждение,Ошибка,КритичнаяОшибка", ",");
КонецФункции

// OneScript разрешает пробелы и переносы между именем метода и скобкой, поэтому искать
// «Лог.Отладка(» точной подстрокой нельзя: `Лог.Отладка (` обошёл бы скан при живой мине.
// Возвращает 0, если за именем идёт не вызов.
Функция ПозицияСкобкиВызова(Знач Текст, Знач Разметка, Знач ПослеИмени)

	Позиция = ПослеИмени;
	Длина = СтрДлина(Текст);

	Пока Позиция <= Длина Цикл
		Если Сред(Разметка, Позиция, 1) <> "к" Тогда
			Возврат 0;
		КонецЕсли;
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = "(" Тогда
			Возврат Позиция;
		КонецЕсли;
		Если Символ <> " " И Символ <> Символы.Таб И Символ <> Символы.ПС Тогда
			Возврат 0;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат 0;

КонецФункции

Функция РазобратьВызов(Знач Текст, Знач Разметка, Знач Уровень, Знач ПозицияСкобки)

	Куски = АргументыВызова(Текст, Разметка, ПозицияСкобки);
	Если Куски = Неопределено Тогда
		Возврат Неопределено; // незакрытая скобка: файл оборван, судить не о чем
	КонецЕсли;

	Первый = Куски[0];
	Разбор = СобратьШаблон(Текст, Разметка, Первый.Начало, Первый.Длина);

	Возврат Новый Структура("Уровень, Шаблон, Аргументов, Литерал, Текст",
		Уровень, Разбор.Шаблон, Куски.Количество(), Разбор.Литерал,
		СокрЛП(Сред(Текст, Первый.Начало, Первый.Длина)));

КонецФункции

// Куски аргументов верхнего уровня: скобки и запятые считаются только там, где код.
Функция АргументыВызова(Знач Текст, Знач Разметка, Знач ПозицияСкобки)

	Куски = Новый Массив();
	Глубина = 1;
	Начало = ПозицияСкобки + 1;
	Позиция = Начало;
	Длина = СтрДлина(Текст);

	Пока Позиция <= Длина Цикл
		Если Сред(Разметка, Позиция, 1) = "к" Тогда
			Символ = Сред(Текст, Позиция, 1);
			Если Символ = "(" Тогда
				Глубина = Глубина + 1;
			ИначеЕсли Символ = ")" Тогда
				Глубина = Глубина - 1;
				Если Глубина = 0 Тогда
					Куски.Добавить(Кусок(Начало, Позиция - Начало));
					Возврат Куски;
				КонецЕсли;
			ИначеЕсли Символ = "," И Глубина = 1 Тогда
				Куски.Добавить(Кусок(Начало, Позиция - Начало));
				Начало = Позиция + 1;
			КонецЕсли;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция Кусок(Знач Начало, Знач Длина)
	Возврат Новый Структура("Начало, Длина", Начало, Длина);
КонецФункции

// Шаблон складывается из литералов куска; между ними допустимы только «+», пробелы
// и Символы.* — всё прочее делает шаблон невычислимым на глаз.
Функция СобратьШаблон(Знач Текст, Знач Разметка, Знач Начало, Знач Длина)

	Шаблон = "";
	Код = "";

	Для Позиция = Начало По Начало + Длина - 1 Цикл
		Метка = Сред(Разметка, Позиция, 1);
		Если Метка = "с" Тогда
			Шаблон = Шаблон + Сред(Текст, Позиция, 1);
		ИначеЕсли Метка = "к" Тогда
			Код = Код + Сред(Текст, Позиция, 1);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Шаблон, Литерал", Шаблон, ЭтоСклейкаЛитералов(Код));

КонецФункции

Функция ЭтоСклейкаЛитералов(Знач Код)

	Остаток = Код;
	Для Каждого Имя Из СтрРазделить("Символы.ПС,Символы.ВК,Символы.Таб,Символы.НПП", ",") Цикл
		Остаток = СтрЗаменить(Остаток, Имя, "");
	КонецЦикла;

	Возврат НЕ ЗначениеЗаполнено(СтрЗаменить(СтрЗаменить(СокрЛП(Остаток), "+", ""), Символы.Таб, ""));

КонецФункции

#КонецОбласти

#Область РазметкаИсходника

// На каждый знак текста — метка: «к» код, «с» содержимое литерала, «"» кавычка литерала,
// «э» служебный знак литерала (вертикальная черта переноса, вторая кавычка удвоенной),
// «#» комментарий. Состояние литерала переносится между строками: литерал бывает
// многострочным, и без переноса состояния код за ним читается как содержимое.
Функция РазметкаТекста(Знач Текст)

	Куски = Новый Массив();
	ВЛитерале = Ложь;

	Для Каждого Строка_ Из СтрРазделить(Текст, Символы.ПС) Цикл
		Если Куски.Количество() > 0 Тогда
			Куски.Добавить(?(ВЛитерале, "с", "к")); // сам перевод строки
		КонецЕсли;
		Разбор = РазметитьСтроку(Строка_, ВЛитерале);
		Куски.Добавить(Разбор.Разметка);
		ВЛитерале = Разбор.ВЛитерале;
	КонецЦикла;

	Возврат СтрСоединить(Куски, "");

КонецФункции

Функция РазметитьСтроку(Знач Строка_, Знач ВходВЛитерале)

	Метки = Новый Массив();
	ВЛитерале = ВходВЛитерале;
	Позиция = 1;
	Длина = СтрДлина(Строка_);

	Если ВЛитерале Тогда
		Позиция = ОтметитьПереносЛитерала(Строка_, Метки);
	КонецЕсли;

	Пока Позиция <= Длина Цикл
		Символ = Сред(Строка_, Позиция, 1);

		Если Символ = """" Тогда
			Если ВЛитерале И Сред(Строка_, Позиция + 1, 1) = """" Тогда
				Метки.Добавить("сэ"); // удвоенная кавычка — содержимое
				Позиция = Позиция + 2;
				Продолжить;
			КонецЕсли;
			ВЛитерале = НЕ ВЛитерале;
			Метки.Добавить("""");
		ИначеЕсли НЕ ВЛитерале И Символ = "/" И Сред(Строка_, Позиция + 1, 1) = "/" Тогда
			Метки.Добавить(Повторить("#", Длина - Позиция + 1));
			Позиция = Длина + 1;
			Прервать;
		Иначе
			Метки.Добавить(?(ВЛитерале, "с", "к"));
		КонецЕсли;

		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Новый Структура("Разметка, ВЛитерале", СтрСоединить(Метки, ""), ВЛитерале);

КонецФункции

// Продолжение многострочного литерала: отступ и вертикальная черта — синтаксис, не текст.
Функция ОтметитьПереносЛитерала(Знач Строка_, Метки)

	Позиция = 1;
	Длина = СтрДлина(Строка_);

	Пока Позиция <= Длина Цикл
		Символ = Сред(Строка_, Позиция, 1);
		Если Символ = " " ИЛИ Символ = Символы.Таб Тогда
			Метки.Добавить("э");
			Позиция = Позиция + 1;
		ИначеЕсли Символ = "|" Тогда
			Метки.Добавить("э");
			Возврат Позиция + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Позиция;

КонецФункции

Функция Повторить(Знач Символ, Знач Сколько)

	Куски = Новый Массив();
	Для Счёт = 1 По Сколько Цикл
		Куски.Добавить(Символ);
	КонецЦикла;
	Возврат СтрСоединить(Куски, "");

КонецФункции

Функция ЭтоГраницаИдентификатора(Знач Текст, Знач Позиция)

	Если Позиция < 1 Тогда
		Возврат Истина;
	КонецЕсли;

	Символ = Сред(Текст, Позиция, 1);
	Возврат СтрНайти("QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm"
		+ "ЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮйцукенгшщзхъфывапролджэячсмитьбю"
		+ "0123456789_", Символ) = 0;

КонецФункции

#КонецОбласти

#Область Корпус

Функция ПродуктовыеФайлы()

	Файлы = Новый Массив();
	Для Каждого Найденный Из НайтиФайлы(ОбъединитьПути(КаталогПроекта, "src"), "*.os", Истина) Цикл
		Если Найденный.ЭтоФайл() Тогда
			Файлы.Добавить(Найденный.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Если Файлы.Количество() < 100 Тогда
		ВызватьИсключение СтрШаблон("Корпус скана подозрительно мал (%1 файлов)",
			Файлы.Количество());
	КонецЕсли;

	Возврат Файлы;

КонецФункции

#КонецОбласти

Функция ТипыСпособовВывода()

	Типы = Новый Соответствие();
	Типы.Вставить("console", "ВыводЛогаВКонсольХаба");
	Типы.Вставить("otel", "ВыводЛогаВOTel");

	Возврат Типы;

КонецФункции

Функция НоваяСвязка(Знач Корневой, Знач Точечные)
	Возврат Новый УровниЖурнала().Связка(Корневой, Точечные, ТипыСпособовВывода());
КонецФункции

// Настоящее событие logos: уровень строки и уровень её лога — то, по чему идёт отбор.
Функция СобытиеУровня(Знач УровеньСтроки, Знач УровеньЛога)

	Строитель = Новый СтроительСобытияЛога();
	Строитель.УстановитьИмяЛога("тест");
	Строитель.УстановитьУровень(УровеньСтроки);
	Строитель.УстановитьУровеньЛога(УровеньЛога);
	Строитель.УстановитьСообщение("строка");

	Возврат Строитель.Создать();

КонецФункции

// Настройки прокси для прямой сборки вне контейнера: таймаут — параметром.
Функция НастройкиПрокси(Знач Таймаут)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПрокси(Таймаут);
	Возврат Настройки;
КонецФункции
