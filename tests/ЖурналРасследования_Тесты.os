// Сторожа журнала расследования: арность вызовов доказывается исполнением СтрШаблон,
// обезличивание — значениями, связка журнала — узлами logos, переключение уровня — живым классом.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем Исходники;   // фикстура ИсходникиПроекта — чтение файлов репозитория
Перем КаталогПроекта;
Перем Обезличивание;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ИсходникиПроекта");
	Исходники = Новый ИсходникиПроекта();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	// клиент апстрима спрашивает ожидание похода наружу у владельца
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "сеть", "Классы"), "ТаймаутыHTTP");

	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы",
		ОбъединитьПути("журнал", "ОбезличиваниеЖурнала.os")), "ОбезличиваниеЖурнала");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "прокси", "Классы",
		"СекретИсточника.os"), "СекретИсточника");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "прокси", "Классы",
		"КлиентАпстрима.os"), "КлиентАпстрима");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы",
		ОбъединитьПути("журнал", "ШкалаЖурнала.os")), "ШкалаЖурнала");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы",
		ОбъединитьПути("журнал", "УровниЖурнала.os")), "УровниЖурнала");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы",
		ОбъединитьПути("журнал", "ВыводЛогаВКонсольХаба.os")), "ВыводЛогаВКонсольХаба");
	ПодключитьСценарий(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы",
		ОбъединитьПути("журнал", "ВыводЛогаВOTelХаба.os")), "ВыводЛогаВOTelХаба");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ФейкТранспортHTTP");

	Обезличивание = Новый ОбезличиваниеЖурнала();

КонецПроцедуры

#Область АрностьВызововЖурнала

// Лишний заполненный аргумент — исключение СтрШаблон, и logos форматирует ПОСЛЕ отсечения
// по уровню: при INFO мина спит, на ОТЛАДКЕ рвётся ровно тогда, когда журнал и понадобился.
// Шаблон и число аргументов берутся из исходников, а вердикт выносит сам СтрШаблон.
&Тест
Процедура ВызовыЖурналаПереживаютПодстановкуАргументов() Экспорт

	Нарушители = Новый Массив();
	Всего = 0;

	Для Каждого Файл Из ПродуктовыеФайлы() Цикл
		Для Каждого Вызов Из ВызовыЖурналаВФайле(Файл) Цикл
			Всего = Всего + 1;
			Беда = ЧтоНеТакСВызовом(Вызов);
			Если ЗначениеЗаполнено(Беда) Тогда
				Нарушители.Добавить(Исходники.ОтносительныйПуть(Файл) + ": " + Беда);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Всего >= 100,
		СтрШаблон("разобрано %1 вызовов журнала при минимуме 100 — скан ослеп", Всего)).ЭтоИстина();

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС),
		"вызовы журнала, которые СтрШаблон не переживёт: число аргументов не сходится"
		+ " с числом мест подстановки").Равно("");

КонецПроцедуры

&Тест
Процедура СтрШаблонВзрываетсяИменноНаЛишнемАргументе() Экспорт

	Ожидаем.Что(ЧтоНеТакСВызовом(Вызов("нет мест подстановки", 2)),
		"лишний аргумент опознан").Содержит("аргументов 1");

	Ожидаем.Что(ЧтоНеТакСВызовом(Вызов("есть %1", 2)),
		"ровно по местам — не нарушение").Равно("");

	Ожидаем.Что(ЧтоНеТакСВызовом(Вызов("есть %1 и %2", 2)),
		"недостача мест исключения не даёт: СтрШаблон подставит пустую строку").Равно("");

	Ожидаем.Что(ЧтоНеТакСВызовом(Вызов("сто %%1 процентов", 2)),
		"экранированный процент местом подстановки не является").Содержит("аргументов 1");

	Ожидаем.Что(ЧтоНеТакСВызовом(Вызов("%1 и снова %1", 3)),
		"повтор одного места вторым аргументом не оплачивается").Содержит("аргументов 2");

КонецПроцедуры

// Шаблон с параметрами обязан быть литералом: иначе судить об арности нечем, и вызов
// уезжает в продакшн неразобранным. Один аргумент безопасен всегда — logos при пустых
// параметрах СтрШаблон не зовёт вовсе.
&Тест
Процедура ШаблонСПараметрамиОбязанБытьЛитералом() Экспорт

	Ожидаем.Что(ЧтоНеТакСВызовом(ВызовСВыражением("Сообщение", 1)),
		"переменная без параметров — законный вызов").Равно("");

	Ожидаем.Что(ЧтоНеТакСВызовом(ВызовСВыражением("Сообщение", 2)),
		"переменная с параметрами — судить нечем").Содержит("не литерал");

КонецПроцедуры

#КонецОбласти

#Область СамотестыСкана

&Тест
Процедура СканВидитВызовыПродуктаИНеВидитТекста() Экспорт

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка(""%1"", Имя);").Количество(),
		"обычный вызов найден").Равно(1);

	Ожидаем.Что(ВызовыЖурналаВТексте("	// Лог.Отладка(""%1"", Имя);").Количество(),
		"вызов в комментарии — не вызов").Равно(0);

	Ожидаем.Что(ВызовыЖурналаВТексте("	Образец = ""Лог.Отладка(%1)"";").Количество(),
		"вызов внутри литерала — не вызов").Равно(0);

	Ожидаем.Что(ВызовыЖурналаВТексте("	КаталогЛог.Отладка(""%1"", Имя);").Количество(),
		"хвост чужого идентификатора — не наш вызов").Равно(0);

КонецПроцедуры

// OneScript зовёт метод и через пробел, и через перенос строки. Скан, искавший точное
// «Лог.Отладка(», оставался зелёным при живой мине арности — а мина в КлиентеАпстрима
// не роняет запрос, а глотается перехватом и выдаёт «апстрим недоступен (offline)»:
// включённая отладка заставила бы хаб считать недоступными все апстримы сразу.
&Тест
Процедура ПробелПередСкобкойНеПрячетВызов() Экспорт

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка (""%1"", Имя);").Количество(),
		"пробел перед скобкой вызов не прячет").Равно(1);

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка	(""%1"", Имя);").Количество(),
		"табуляция перед скобкой вызов не прячет").Равно(1);

	Ожидаем.Что(ВызовыЖурналаВТексте(
			"	Лог.Отладка" + Символы.ПС + "		(""нет мест"", Лишний);")[0].Аргументов,
		"перенос строки перед скобкой вызов не прячет, аргументы читаются").Равно(2);

	Ожидаем.Что(ЧтоНеТакСВызовом(
			ВызовыЖурналаВТексте("	Лог.Отладка (""нет мест"", Лишний);")[0]),
		"мина за пробелом опознана").Содержит("аргументов 1");

	Ожидаем.Что(ВызовыЖурналаВТексте("	Значение = Лог.Отладка;").Количество(),
		"обращение без скобки вызовом не считается").Равно(0);

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка /* */ (""%1"", Имя);").Количество(),
		"между именем и скобкой допустимы только пробелы: прочее — не вызов").Равно(0);

КонецПроцедуры

&Тест
Процедура СканСчитаетАргументыАНеЗапятые() Экспорт

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка(""а, б: %1"", Имя);")[0].Аргументов,
		"запятая внутри литерала аргумента не делит").Равно(2);

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка(""%1"", Массив.Количество());")[0].Аргументов,
		"скобки вложенного вызова не закрывают вызов журнала").Равно(2);

	Ожидаем.Что(ВызовыЖурналаВТексте(
			"	Лог.Отладка(""%1 и %2""," + Символы.ПС + "		Первый, Второй);")[0].Аргументов,
		"вызов, разбитый на строки, читается целиком").Равно(3);

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка(""%1"", ?(Флаг, ""а"", ""б""));")[0].Аргументов,
		"запятые внутри литералов тернарника не делят аргументы").Равно(2);

КонецПроцедуры

&Тест
Процедура СканСобираетШаблонИзЧастей() Экспорт

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка(""левая %1"" + "" правая %2"", А, Б);")[0].Шаблон,
		"склейка литералов собирается в один шаблон").Равно("левая %1 правая %2");

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка(""кавычка """" внутри %1"", А);")[0].Шаблон,
		"удвоенная кавычка — содержимое литерала, а не его конец")
		.Равно("кавычка "" внутри %1");

	Ожидаем.Что(ВызовыЖурналаВТексте(
			"	Лог.Отладка(""первая" + Символы.ПС + "		|вторая %1"", А);")[0].Шаблон,
		"многострочный литерал склеивается без вертикальной черты")
		.Равно("первая" + Символы.ПС + "вторая %1");

	Ожидаем.Что(ВызовыЖурналаВТексте("	Лог.Отладка(Шаблон + ""хвост %1"", А);")[0].Литерал,
		"шаблон с переменной литералом не считается").ЭтоЛожь();

	Ожидаем.Что(ВызовыЖурналаВТексте(
			"	Лог.Отладка(""левая"" + Символы.ПС + ""правая %1"", А);")[0].Литерал,
		"Символы.ПС в склейке литерал не портит").ЭтоИстина();

КонецПроцедуры

// Скан обязан находить живые вызовы всех уровней в src/, иначе главная проверка зелена ни о чём.
&Тест
Процедура СканНаходитВсеУровниВПродукте() Экспорт

	Уровни = Новый Соответствие();
	Для Каждого Файл Из ПродуктовыеФайлы() Цикл
		Для Каждого Вызов Из ВызовыЖурналаВФайле(Файл) Цикл
			Уровни.Вставить(Вызов.Уровень, Истина);
		КонецЦикла;
	КонецЦикла;

	Отсутствуют = Новый Массив();
	Для Каждого Уровень Из СтрРазделить("Отладка,Информация,Предупреждение,Ошибка", ",") Цикл
		Если Уровни.Получить(Уровень) = Неопределено Тогда
			Отсутствуют.Добавить(Уровень);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Отсутствуют, ", "),
		"уровни журнала, которых скан не встретил в src/ — либо уровень пропал из продукта,"
		+ " либо скан перестал его видеть").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Обезличивание

&Тест
Процедура АдресТеряетПараметрыИУчётныеДанные() Экспорт

	Ожидаем.Что(Обезличивание.Адрес("https://hub.example.com/download/list.txt"),
		"адрес без параметров остаётся читаемым целиком")
		.Равно("https://hub.example.com/download/list.txt");

	Ожидаем.Что(Обезличивание.Адрес("https://hub.example.com/x?token=СЕКРЕТ&a=1"),
		"строка запроса снята, факт её наличия сохранён")
		.Равно("https://hub.example.com/x?…");

	Ожидаем.Что(Обезличивание.Адрес("https://вася:СЕКРЕТ@hub.example.com:8443/x"),
		"учётные данные из authority сняты")
		.Равно("https://…@hub.example.com:8443/x");

	Ожидаем.Что(Обезличивание.Адрес("https://hub.example.com/x#СЕКРЕТ"),
		"фрагмент снят вместе с содержимым").Равно("https://hub.example.com/x");

	Ожидаем.Что(Обезличивание.Адрес("https://вася:СЕКРЕТ@hub.example.com/p?q=СЕКРЕТ"),
		"учётные данные и параметры снимаются вместе")
		.Равно("https://…@hub.example.com/p?…");

	// пароль пула набирают руками, и «/» в нём законен: резка authority по первой косой
	// оставляла такой пароль целиком — «@» оказывался уже «в пути» и учётку не срезали
	Ожидаем.Что(Обезличивание.Адрес("https://вася:СЕК/РЕТ@hub.example.com/d/list.txt"),
		"косая внутри пароля не спасает учётные данные от срезания")
		.Равно("https://…@hub.example.com/d/list.txt");

	Ожидаем.Что(СтрНайти(Обезличивание.Адрес("https://u:a/b/c@hub.example.com/d"), "a/b/c"),
		"ни куска пароля с несколькими косыми наружу").Равно(0);

	Ожидаем.Что(Обезличивание.Адрес(""), "пустой адрес").Равно("«пусто»");
	Ожидаем.Что(Обезличивание.Адрес(Неопределено), "адреса нет").Равно("«пусто»");

КонецПроцедуры

// Адрес получателя письма в журнале нужен домену, а не ящику: оператор судит по нему,
// куда ушло письмо, но соотнести строку с человеком по ней нельзя.
&Тест
Процедура АдресПочтыТеряетЯщикНоНеДомен() Экспорт

	Ожидаем.Что(Обезличивание.Почта("sergey@example.org"),
		"от ящика остаётся одна буква, почтовая система видна целиком")
		.Равно("s***@example.org");

	Ожидаем.Что(СтрНайти(Обезличивание.Почта("sergey@example.org"), "sergey@example.org"),
		"сырого адреса в строке журнала нет").Равно(0);

	Ожидаем.Что(СтрНайти(Обезличивание.Почта("sergey@example.org"), "example.org") > 0,
		"а домен виден — иначе по строке не понять, куда ушло письмо").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Обезличивание.Почта("a@example.org"), "a@example.org"),
		"однобуквенный ящик целиком не раскрывается").Равно(0);
	Ожидаем.Что(Обезличивание.Почта("a@example.org"),
		"и выглядит он ровно так же, как длинный").Равно("a***@example.org");

	Ожидаем.Что(Обезличивание.Почта("вася+спам@почта.рф"),
		"плюс-адресация уходит вместе с ящиком").Равно("в***@почта.рф");

	Ожидаем.Что(Обезличивание.Почта("u@sub.example.org"),
		"поддомен — часть почтовой системы, он остаётся").Равно("u***@sub.example.org");

	// собак в строке бывает больше одной: доменом считается то, что после ПОСЛЕДНЕЙ,
	// иначе «a@b@c.org» унёс бы в журнал кусок ящика
	Ожидаем.Что(Обезличивание.Почта("a@b@c.org"),
		"домен берётся после последней собаки").Равно("a***@c.org");
	Ожидаем.Что(СтрНайти(Обезличивание.Почта("вася@спам@почта.рф"), "спам"),
		"и ничего из середины наружу не уходит").Равно(0);

	Ожидаем.Что(Обезличивание.Почта(" Sergey@Example.org "),
		"края срезаются, регистр остаётся как был").Равно("S***@Example.org");

	Ожидаем.Что(Обезличивание.Почта(""), "пустой адрес").Равно("«пусто»");
	Ожидаем.Что(Обезличивание.Почта("   "), "адрес из пробелов — пустой").Равно("«пусто»");
	Ожидаем.Что(Обезличивание.Почта(Неопределено), "адреса нет").Равно("«пусто»");

	Ожидаем.Что(Обезличивание.Почта("не-адрес-вовсе"),
		"строка без собаки адресом не притворяется").Равно("«не адрес»");
	Ожидаем.Что(Обезличивание.Почта("@example.org"),
		"ящика нет вовсе — прятать нечего, но и адреса нет").Равно("«не адрес»");

КонецПроцедуры

// Адрес почты в произвольном тексте узнаётся по значению и теряет ящик ровно так, как его
// теряет Почта; то, что адресом почты не является, остаётся нетронутым.
&Тест
Процедура АдресаПочтыВТекстеТеряютЯщики() Экспорт

	Ожидаем.Что(Обезличивание.ПочтаВТексте("кому=vasya@ya.ru, и petya@почта.рф."),
		"каждый адрес в строке, знак препинания за ним остаётся")
		.Равно("кому=v***@ya.ru, и p***@почта.рф.");
	Ожидаем.Что(Обезличивание.ПочтаВТексте("{""email"":""Segate@Inbox.RU""}"),
		"ключ любой: адрес узнаётся значением").Равно("{""email"":""S***@Inbox.RU""}");
	Ожидаем.Что(Обезличивание.ПочтаВТексте("почта/segate@inbox.ru"),
		"адрес после косой — всё равно адрес").Равно("почта/s***@inbox.ru");
	Ожидаем.Что(Обезличивание.ПочтаВТексте("a@b@c.org"),
		"кусок ящика между собаками наружу не уходит").Равно("a***@c.org");
	Ожидаем.Что(Обезличивание.ПочтаВТексте("mailto:ivan@example.org"),
		"mailto — это почта").Равно("mailto:i***@example.org");
	Ожидаем.Что(Обезличивание.ПочтаВТексте("u@xn--80ak6aa92e.xn--p1ai"),
		"IDN-зона — тоже зона").Равно("u***@xn--80ak6aa92e.xn--p1ai");

	Обезличенный = Обезличивание.ПочтаВТексте("получатель s***@inbox.ru");
	Ожидаем.Что(Обезличенный, "второй проход ничего не меняет").Равно("получатель s***@inbox.ru");

	Ожидаем.Что(Обезличивание.ПочтаВТексте("кому:ivan@mail.ru"),
		"двоеточие вне адреса со схемой почту не прячет").Равно("кому:i***@mail.ru");
	Ожидаем.Что(Обезличивание.ПочтаВТексте("d'artagnan@mail.ru"),
		"апостроф — часть ящика").Равно("d***@mail.ru");
	Ожидаем.Что(Обезличивание.ПочтаВТексте("user@163.com и 12345@67890.com"),
		"цифровой домен — не версия").Равно("u***@163.com и 1***@67890.com");
	Ожидаем.Что(Обезличивание.ПочтаВТексте("ivan@1-800-flowers.com"),
		"дефис с цифрой за цифрами — домен").Равно("i***@1-800-flowers.com");
	Ожидаем.Что(Обезличивание.ПочтаВТексте("ivan@mail.ru:550 rejected"),
		"двоеточие без пути с косой — не координата").Равно("i***@mail.ru:550 rejected");
	Ожидаем.Что(Обезличивание.ПочтаВТексте("ivan@mail.ru:secret"),
		"и без пути вовсе").Равно("i***@mail.ru:secret");
	Ожидаем.Что(Обезличивание.ПочтаВТексте("'ivan@mail.ru'"),
		"кавычки вокруг адреса не ящик").Равно("'i***@mail.ru'");

	Длинный = "";
	Для Номер = 1 По 65 Цикл
		Длинный = Длинный + "a";
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Обезличивание.ПочтаВТексте(Длинный + "segate@inbox.ru"), "segate@"),
		"адрес, приклеенный к длинному токену, всё равно теряет ящик").Равно(0);

	Для Каждого НеАдрес Из СтрРазделить("user@|без собаки вовсе|@example.org|a@localhost|"
		+ "public/пакет@1.0.0|пакет#5@1.0.0-beta.rc|pkg@2.0-beta|"
		+ "пул/пакет@1.0-beta.rc|пул/пакет@1-rc.beta|пул/пакет@2.1-alpha.dev+build.ci|"
		+ "пул/пакет@v1.0.0.beta|git@github.com:org/repo.git|ssh://git@host.example.com:2222/org/repo|"
		+ "https://вася:СЕКРЕТ@hub.example.com/x", "|") Цикл
		Ожидаем.Что(Обезличивание.ПочтаВТексте(НеАдрес), "не адрес почты: " + НеАдрес)
			.Равно(НеАдрес);
	КонецЦикла;

	Ожидаем.Что(Обезличивание.ПочтаВТексте(Неопределено), "ничего — пустая строка").Равно("");

КонецПроцедуры

&Тест
Процедура СекретОстаётсяТолькоФактомНаличия() Экспорт

	Ожидаем.Что(Обезличивание.Секрет("ghp_ОченьДлинныйТокен"),
		"содержимого нет, длина есть").Равно("«задано, 21 симв.»");

	Ожидаем.Что(Обезличивание.Секрет(""), "пустой секрет").Равно("«пусто»");
	Ожидаем.Что(Обезличивание.Секрет("   "), "секрет из пробелов — пустой").Равно("«пусто»");
	Ожидаем.Что(Обезличивание.Секрет(Неопределено), "секрета нет").Равно("«пусто»");

	Ожидаем.Что(СтрНайти(Обезличивание.Секрет("s3cret"), "s3cret"),
		"ни одного знака секрета наружу").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ДверьВыходаЖурнала

// Текст из журнала приходит и снаружи: строка из тысяч собак обязана разбираться за доли
// секунды, а не блокировать поток, который пишет журнал.
&Тест
Процедура СтрокаИзТысячСобакРазбираетсяБыстро() Экспорт

	Части = Новый Массив();
	Для Номер = 1 По 1000 Цикл
		Части.Добавить("aaaaaaaaaa@");
	КонецЦикла;
	Текст = СтрСоединить(Части);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Итог = Обезличивание.ПочтаВТексте(Текст);
	Потрачено = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Ожидаем.Что(Итог, "адресов почты в ней нет — текст прежний").Равно(Текст);
	Ожидаем.Что(Потрачено < 1000, СтрШаблон("11 тыс. знаков за %1 мс", Потрачено)).ЭтоИстина();

КонецПроцедуры

// Коллектор получает строку журнала через дверь: адрес почты, названный службой как есть,
// уезжает без ящика — и в тексте, и в готовой строке, и в дополнительных полях.
&Тест
Процедура СтрокаЖурналаУходитВКоллекторБезЯщика() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Лог = ЛогСВыводом(Новый ВыводЛогаВOTelХаба(Ловушка));

	Лог.Информация("Почта: письмо принято, получатель %1", "segate@inbox.ru");
	Лог.Поля("кому", "Petr.Ivanov@mail.example.ru").Информация("Письмо с полем");

	Ушедшее = Ловушка.Всё();
	Ожидаем.Что(СтрНайти(Ушедшее, "получатель s***@inbox.ru") > 0,
		"домен остался: " + Ушедшее).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ушедшее, "P***@mail.example.ru") > 0,
		"поле события — тоже: " + Ушедшее).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ушедшее, "segate@"), "ящика в коллекторе нет").Равно(0);
	Ожидаем.Что(СтрНайти(Ушедшее, "Petr.Ivanov@"), "и ящика из поля").Равно(0);

КонецПроцедуры

// Консоль хаба печатает строку через ту же дверь, что и коллектор.
&Тест
Процедура КонсольПечатаетСтрокуБезЯщика() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	ВыводВКонсоль = Новый ВыводЛогаВКонсольХаба();
	// на месте печати в stdout — ловушка: дверь стоит перед печатью, её и смотрим
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(ВыводВКонсоль, "Печать", Ловушка);
	Лог = ЛогСВыводом(ВыводВКонсоль);

	Лог.Информация("Фоновое письмо: сервер smtp.example.com:465 принял письмо получателю %1",
		"segate@inbox.ru");

	Ожидаем.Что(Ловушка.Всё(), "консоль видит обезличенную строку")
		.Содержит("получателю s***@inbox.ru");
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "segate@"), "ящика в консоли нет").Равно(0);

КонецПроцедуры

// Событие без адреса почты дверь пропускает как есть — без копии и без правки текста.
&Тест
Процедура СтрокаБезАдресаПочтыПроходитДверьНетронутой() Экспорт

	Событие = СобытиеУровня(УровниЛога.Информация, УровниЛога.Информация);
	Ожидаем.Что(Обезличивание.Событие(Событие), "то же самое событие").Равно(Событие);

	Ловушка = Новый ЛовушкаЛога();
	Лог = ЛогСВыводом(Новый ВыводЛогаВOTelХаба(Ловушка));
	Лог.Информация("версия public/пакет@1.0.0 опубликована с https://вася:x@hub.example.com");

	Ожидаем.Что(Ловушка.Всё(), "строка без почты не изменилась")
		.Содержит("версия public/пакет@1.0.0 опубликована с https://вася:x@hub.example.com");

КонецПроцедуры

#КонецОбласти

#Область ПоведениеЖурналаНаЖивомКлассе

// Отладка обязана быть выключаемой: то, что при INFO не написано ни строки, — это и есть
// «шум под контролем», а появление тех же строк на DEBUG — «уровень переключается».
&Тест
Процедура УровеньЖурналаПереключаетОтладкуРеальногоКласса() Экспорт

	ПриИнформации = ПрогнатьКлиентАпстрима(УровниЛога.Информация, "https://hub.example.com/d/");
	ПриОтладке = ПрогнатьКлиентАпстрима(УровниЛога.Отладка, "https://hub.example.com/d/");

	Ожидаем.Что(ПриИнформации.Количество(),
		"при INFO отладочных строк в консоли нет: " + ПриИнформации.Всё()).Равно(0);

	Ожидаем.Что(ПриОтладке.Количество() > 0,
		"при DEBUG путь до апстрима виден").ЭтоИстина();

	Ожидаем.Что(СтрНайти(ПриОтладке.Всё(), "hub.example.com") > 0,
		"в отладке названо, к кому ходили: " + ПриОтладке.Всё()).ЭтоИстина();

	Ожидаем.Что(СтрНайти(ПриОтладке.Всё(), "200") > 0,
		"в отладке назван ответ апстрима: " + ПриОтладке.Всё()).ЭтоИстина();

КонецПроцедуры

// Секрет в адресе апстрима — не выдумка: базовый URL пула правится руками, и токен
// в строке запроса туда попадает ровно так же, как в любую другую настройку.
&Тест
Процедура СекретИзАдресаАпстримаВЖурналНеПопадает() Экспорт

	Ловушка = ПрогнатьКлиентАпстрима(УровниЛога.Отладка,
		"https://логин:ПАРОЛЬ42@hub.example.com/d/?token=ТОКЕН42");

	Ожидаем.Что(Ловушка.Количество() > 0, "отладка вообще писалась").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "ТОКЕН42"),
		"токен из строки запроса в журнал не попал: " + Ловушка.Всё()).Равно(0);

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "ПАРОЛЬ42"),
		"пароль из учётных данных адреса в журнал не попал: " + Ловушка.Всё()).Равно(0);

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "hub.example.com") > 0,
		"узел при этом остался виден — иначе отладка бесполезна").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СвязкаЖурнала

// Подробность поднимается ТОЧЕЧНО: компонент получает свой уровень, остальные живут на корне,
// и у поднятого компонента есть куда писать.
&Тест
Процедура ТочечныйУровеньПоднимаетсяОдномуКомпоненту() Экспорт

	Логи = СвязкаИз(ИзОкружения("Уровни", "КлиентАпстрима=DEBUG,СервисПрокси=WARN")).Логи;

	Ожидаем.Что(Логи["rootLogger"]["level"], "корень — умолчание").Равно("INFO");
	Ожидаем.Что(Логи["КлиентАпстрима"]["level"], "компоненту поднята подробность").Равно("DEBUG");
	Ожидаем.Что(Логи["СервисПрокси"]["level"], "второму компоненту свой уровень").Равно("WARN");
	Ожидаем.Что(Логи["КлиентАпстрима"]["appenders"].Количество(), "у компонента все выходы").Равно(3);

КонецПроцедуры

// Цена подробности платится только за просьбу: выход со своим уровнем открыл бы гейт logos
// КАЖДОМУ логу — и строку отладки собирали бы все. Выходы объявлены с уровнем DEFAULT
// и следуют уровню своего лога.
&Тест
Процедура ВыходыОбъявленыБезСвоегоУровня() Экспорт

	СпособыВывода = СвязкаИз(ИзОкружения("Уровни", "КлиентАпстрима=DEBUG")).СпособыВывода;

	Ожидаем.Что(СпособыВывода.Количество(), "объявлены три выхода").Равно(3);
	Для Каждого Выход Из СпособыВывода Цикл
		Ожидаем.Что(Выход.Значение["level"], "выход " + Выход.Ключ + " следует уровню лога")
			.Равно("DEFAULT");
	КонецЦикла;
	Ожидаем.Что(СпособыВывода["console"]["type"], "консоль хаба").Равно("ВыводЛогаВКонсольХаба");
	Ожидаем.Что(СпособыВывода["memory"]["type"], "память хаба").Равно("ВыводЛогаВПамятьХаба");
	Ожидаем.Что(СпособыВывода["otel"]["type"], "коллектор хаба").Равно("ВыводЛогаВOTelХаба");

КонецПроцедуры

// Порог коллектора выше уровня лога — выход коллектора со своим уровнем; не выше — выход
// следует уровню лога: logos открывает гейт по самому подробному выходу, и порог ниже
// уровня добавил бы логу подробности.
&Тест
Процедура ПорогКоллектораТолькоСужает() Экспорт

	Заданное = ИзОкружения("Порог", "WARN");
	Задать(Заданное, "Окружение", "Уровни", "Подробный=DEBUG,Молчаливый=ERROR");
	Связка = СвязкаИз(Заданное);

	Ожидаем.Что(ИмяВыходаКоллектора(Связка.Логи, "rootLogger"), "корень INFO — в коллектор с WARN")
		.Равно("otel-warn");
	Ожидаем.Что(ИмяВыходаКоллектора(Связка.Логи, "Подробный"), "отладка лога в коллектор не идёт")
		.Равно("otel-warn");
	Ожидаем.Что(ИмяВыходаКоллектора(Связка.Логи, "Молчаливый"), "лог на ERROR порогом WARN не расширяется")
		.Равно("otel");
	Ожидаем.Что(Связка.СпособыВывода["otel-warn"]["level"], "выход порога несёт уровень").Равно("WARN");
	Ожидаем.Что(Связка.СпособыВывода["otel-warn"]["type"], "того же класса").Равно("ВыводЛогаВOTelХаба");

	Подробный = СвязкаИз(ИзОкружения("Порог", "DEBUG"));
	Ожидаем.Что(ИмяВыходаКоллектора(Подробный.Логи, "rootLogger"), "порог ниже уровня — следует уровню")
		.Равно("otel");
	Ожидаем.Что(Подробный.СпособыВывода.Получить("otel-debug"), "и своего выхода не заводит")
		.Равно(Неопределено);

КонецПроцедуры

// DISABLE — самый высокий порог: выход коллектора стоит на DISABLE и ничего не шлёт, а уровень
// журнала и остальные выходы порог не трогает; порог журналу сильнее общего.
&Тест
Процедура ПорогDISABLEГлушитКоллекторНеТрогаяЖурнала() Экспорт

	Заданное = ИзОкружения("Порог", "DISABLE");
	Задать(Заданное, "Окружение", "Пороги", "Нужный=WARN,Тихий=DISABLE");
	Задать(Заданное, "Окружение", "Уровни", "Тихий=DEBUG");
	Связка = СвязкаИз(Заданное);
	Логи = Связка.Логи;

	Ожидаем.Что(СтрСоединить(Логи["rootLogger"]["appenders"], ","), "коллектор корня молчит")
		.Равно("console,memory,otel-disable");
	Ожидаем.Что(Связка.СпособыВывода["otel-disable"]["level"], "выход коллектора на DISABLE").Равно("DISABLE");
	Ожидаем.Что(СтрСоединить(Логи["Тихий"]["appenders"], ","), "консоль и память журнала пишут")
		.Равно("console,memory,otel-disable");
	Ожидаем.Что(Логи["Тихий"]["level"], "уровень журнала порог не трогает").Равно("DEBUG");
	Ожидаем.Что(СтрСоединить(Логи["Нужный"]["appenders"], ","), "свой порог журналу сильнее общего")
		.Равно("console,memory,otel-warn");

КонецПроцедуры

// Порог DISABLE журналу, чей единственный выход — коллектор, уровня журнала не меняет: выход
// остаётся и молчит, а журнал живёт на своём уровне.
&Тест
Процедура ПорогDISABLEНеВыключаетЖурнал() Экспорт

	Заданное = ИзОкружения("Пороги", "Только=DISABLE");
	ЗадатьУзел(Заданное, УзелФайла("Только", "DEBUG", "otel", Ложь));
	Логи = СвязкаИз(Заданное).Логи;

	Ожидаем.Что(Логи["Только"]["level"], "уровень журнала как задан").Равно("DEBUG");
	Ожидаем.Что(СтрСоединить(Логи["Только"]["appenders"], ","), "выход коллектора молчит").Равно("otel-disable");

КонецПроцедуры

// Лог, которому процесс не оставил ни одного выхода, молчит, но несёт выход хаба —
// заглушённую консоль: пустой список logos прочла бы как «выходы корня», и строки ушли бы
// туда, куда оператор их не звал, а лог без выходов из настроек пульт принял бы за созданный
// до них.
&Тест
Процедура ЛогБезВыходовНесётЗаглушённуюКонсоль() Экспорт

	ТолькоКонсоль = Новый Соответствие();
	ТолькоКонсоль.Вставить("console", "ВыводЛогаВКонсоль");
	Заданное = ПустоеЗаданное();
	ЗадатьУзел(Заданное, УзелФайла("Только", "DEBUG", "memory,otel", Ложь));
	Связка = Новый УровниЖурнала(ТолькоКонсоль).Связка(Заданное);

	Ожидаем.Что(СтрСоединить(Связка.Логи["Только"]["appenders"], ","), "один выход — консоль на DISABLE")
		.Равно("console-disable");
	Ожидаем.Что(Связка.СпособыВывода["console-disable"]["level"], "выход молчит").Равно("DISABLE");
	Ожидаем.Что(Связка.СпособыВывода["console-disable"]["type"], "тем же классом консоли")
		.Равно("ВыводЛогаВКонсоль");
	Ожидаем.Что(Связка.Логи["Только"]["level"], "уровень лога как задан").Равно("DEBUG");
	Ожидаем.Что(Связка.ПриСтарте["Только"]["Выходы"].Количество(), "пишущих выходов нет").Равно(0);

КонецПроцедуры

// Журнал со своим приёмником (аудит) выходов хаба не получает, что бы ни задал оператор:
// ни уровнем корня, ни уровнем и выходами журнала, ни порогом — строки пишет только
// приёмник, повешенный кодом.
&Тест
Процедура ЖурналСоСвоимПриёмникомБезВыходовХаба() Экспорт

	Заданное = ИзОкружения("Уровень", "DISABLE");
	Задать(Заданное, "Окружение", "Уровни", "аудит=ERROR");
	Задать(Заданное, "Окружение", "Пороги", "аудит=WARN");
	ЗадатьУзел(Заданное, УзелФайла("аудит", "DEBUG", "console,memory,otel"));
	Уровни = Новый УровниЖурнала(ТипыСпособовВывода(), СтрРазделить("аудит", ","));
	Связка = Уровни.Связка(Заданное);
	Аудит = Связка.Логи["аудит"];

	Ожидаем.Что(СтрСоединить(Аудит["appenders"], ","), "выходов хаба нет — только заглушённая консоль")
		.Равно("console-disable");
	Ожидаем.Что(Аудит["additivity"], "выходы корня к нему не добавляются").Равно(Ложь);
	Ожидаем.Что(Аудит["level"], "уровень свой, не корня и не оператора").Равно("INFO");
	Ожидаем.Что(Связка.Логи["rootLogger"]["level"], "самотест: корень заглушён").Равно("DISABLE");
	Ожидаем.Что(Связка.ПриСтарте["аудит"]["Выходы"].Количество(), "в таблице старта пишущих выходов нет")
		.Равно(0);
	Ожидаем.Что(СтрСоединить(Уровни.Замечания(), Символы.ПС), "заданное ему названо неприменённым")
		.Содержит("журнал аудит пишет только в свой приёмник");

КонецПроцедуры

#КонецОбласти

#Область ПорядокИсточников

// Сначала источник, потом имя: переменная окружения сильнее файла, а в одном файле родной
// узел logos.logger сильнее ключей хаба — они его псевдонимы.
&Тест
Процедура ПеременнаяСильнееФайлаУзелСильнееКлючаХаба() Экспорт

	Узел = Новый Соответствие();
	Узел.Вставить("rootLogger", "WARN");
	Узел.Вставить("Спорный", "ERROR");
	Узел.Вставить("УзлаИКлюча", "WARN");
	Заданное = ИзОкружения("Уровни", "Спорный=DEBUG");
	ЗадатьУзел(Заданное, Узел);
	Задать(Заданное, "Файл", "Уровень", "DEBUG");
	Задать(Заданное, "Файл", "Уровни", "УзлаИКлюча=DEBUG,ТолькоКлюча=ERROR");
	Логи = СвязкаИз(Заданное).Логи;

	Ожидаем.Что(Логи["Спорный"]["level"], "переменная сильнее узла файла").Равно("DEBUG");
	Ожидаем.Что(Логи["УзлаИКлюча"]["level"], "узел сильнее ключа хаба того же файла").Равно("WARN");
	Ожидаем.Что(Логи["rootLogger"]["level"], "и у корня").Равно("WARN");
	Ожидаем.Что(Логи["ТолькоКлюча"]["level"], "ключ файла действует там, где узел молчит").Равно("ERROR");

	Задать(Заданное, "Окружение", "Уровень", "INFO");
	Ожидаем.Что(СвязкаИз(Заданное).Логи["rootLogger"]["level"], "переменная корня сильнее узла")
		.Равно("INFO");

КонецПроцедуры

// Откуда задан уровень каждого лога, видно экрану: переменная, узел файла или ключ файла.
&Тест
Процедура ТаблицаСтартаНазываетИсточникПоСтаршинству() Экспорт

	Заданное = ИзОкружения("Уровни", "ИзОкружения=DEBUG");
	ЗадатьУзел(Заданное, УзелФайла("ИзУзла", "WARN", "console"));
	Задать(Заданное, "Файл", "Уровни", "ИзУзла=DEBUG,ИзКлюча=ERROR");
	ПриСтарте = СвязкаИз(Заданное).ПриСтарте;

	Ожидаем.Что(ПриСтарте["ИзОкружения"]["ИмяНастройки"], "переменная").Равно("ПРОБА");
	Ожидаем.Что(ПриСтарте["ИзУзла"]["Откуда"], "узел — файл").Равно("файл");
	Ожидаем.Что(ПриСтарте["ИзУзла"]["ИмяНастройки"], "родным ключом").Равно("logos.logger.ИзУзла.level");
	Ожидаем.Что(ПриСтарте["ИзКлюча"]["ИмяНастройки"], "ключом хаба").Равно("oshub.log.levels");
	Ожидаем.Что(ПриСтарте["rootLogger"]["Откуда"], "корень — умолчание").Равно("умолчание");

КонецПроцедуры

// DEFAULT в переменной — «как у корня», и уровня из файла он логу не оставляет.
&Тест
Процедура DEFAULTПеременнойВозвращаетЛогНаКорень() Экспорт

	Узел = Новый Соответствие();
	Узел.Вставить("Спорный", "DEBUG");
	Заданное = ИзОкружения("Уровни", "Спорный=DEFAULT");
	Задать(Заданное, "Окружение", "Уровень", "WARN");
	ЗадатьУзел(Заданное, Узел);

	Ожидаем.Что(СвязкаИз(Заданное).Логи["Спорный"]["level"], "уровень корня").Равно("WARN");

КонецПроцедуры

#КонецОбласти

#Область ПорогОтдельнымСлоем

// Общий порог из файла доходит до журнала, которому узел того же файла назвал выходы
// с коллектором: у порога и узла разные места, и спорить им не о чем.
&Тест
Процедура ОбщийПорогФайлаСужаетКоллекторВыходовУзла() Экспорт

	Узел = УзелФайла("rootLogger", "INFO", "console,otel");
	Узел.Вставить("Названный", УзелФайла("Названный", "INFO", "console,otel", Ложь)["Названный"]);
	Заданное = ПустоеЗаданное();
	ЗадатьУзел(Заданное, Узел);
	Задать(Заданное, "Файл", "Порог", "WARN");
	Уровни = Новый УровниЖурнала(ТипыСпособовВывода());
	Логи = Уровни.Связка(Заданное).Логи;

	Ожидаем.Что(СтрСоединить(Логи["rootLogger"]["appenders"], ","), "выходы корня из узла, коллектор сужен")
		.Равно("console,otel-warn");
	Ожидаем.Что(СтрСоединить(Логи["Названный"]["appenders"], ","), "и у журнала, названного узлом")
		.Равно("console,otel-warn");
	Ожидаем.Что(Уровни.Замечания().Количество(), "спорить не о чем").Равно(0);

КонецПроцедуры

// Порог только сужает: коллектора, которого журналу не дал узел, он не добавляет — ни из файла,
// ни из переменной; порог, названный такому журналу, назван оператору замечанием.
&Тест
Процедура ПорогНеДобавляетКоллектораКоторогоНет() Экспорт

	Заданное = ПустоеЗаданное();
	ЗадатьУзел(Заданное, УзелФайла("Узкий", "INFO", "console", Ложь));
	Задать(Заданное, "Файл", "Пороги", "Узкий=ERROR");
	Уровни = Новый УровниЖурнала(ТипыСпособовВывода());
	Логи = Уровни.Связка(Заданное).Логи;

	Ожидаем.Что(СтрСоединить(Логи["Узкий"]["appenders"], ","), "выходы узла как названы").Равно("console");
	Ожидаем.Что(Логи["Узкий"]["level"], "уровень как назван").Равно("INFO");
	Ожидаем.Что(СтрСоединить(Уровни.Замечания(), Символы.ПС), "замечание называет ключ и журнал")
		.Содержит("oshub.log.otel.levels[Узкий] не действует");

	Задать(Заданное, "Окружение", "Пороги", "Узкий=ERROR");
	Ожидаем.Что(СтрСоединить(СвязкаИз(Заданное).Логи["Узкий"]["appenders"], ","), "и переменная не добавляет")
		.Равно("console");

КонецПроцедуры

// Журнал, которого назвал только порог, живёт как у logos: уровень и выходы — у ближайшего
// названного предка по имени; порог сужает ему один коллектор.
&Тест
Процедура НезаданноеНаследуетсяОтПредкаПоИмени() Экспорт

	Заданное = ИзОкружения("Уровни", "oscript.lib=WARN");
	Задать(Заданное, "Окружение", "Пороги", "oscript.lib.autumn-cache=ERROR");
	Логи = СвязкаИз(Заданное).Логи;

	Ожидаем.Что(Логи["oscript.lib.autumn-cache"]["level"], "уровень предка").Равно("WARN");
	Ожидаем.Что(СтрСоединить(Логи["oscript.lib.autumn-cache"]["appenders"], ","), "выходы предка, свой порог")
		.Равно("console,memory,otel-error");

КонецПроцедуры

// Порог не меняет журналу уровень и выходы в консоль и память — ни названному, ни потомку:
// заглушённая библиотека не заговорит от просьбы не слать её потомка в коллектор, а выходы,
// названные предку узлом, потомок сохранит.
&Тест
Процедура ПорогНеМеняетУровеньИВыходыПотомка() Экспорт

	Заданное = ИзОкружения("Уровни", "oscript.lib=DISABLE");
	Задать(Заданное, "Окружение", "Пороги", "oscript.lib.autumn-cache=DISABLE");
	Логи = СвязкаИз(Заданное).Логи;

	Ожидаем.Что(Логи["oscript.lib.autumn-cache"]["level"], "заглушённый предком молчит").Равно("DISABLE");

	Заданное = ИзОкружения("Пороги", "oscript.lib.autumn-cache=ERROR");
	ЗадатьУзел(Заданное, УзелФайла("oscript.lib", "WARN", "console", Ложь));
	Логи = СвязкаИз(Заданное).Логи;

	Ожидаем.Что(Логи["oscript.lib.autumn-cache"]["level"], "уровень предка из узла").Равно("WARN");
	Ожидаем.Что(СтрСоединить(Логи["oscript.lib.autumn-cache"]["appenders"], ","), "выходы предка из узла")
		.Равно("console");

КонецПроцедуры

// Порог, названный журналу, действует и на его потомков по имени — как уровень у logos;
// ближайший названный выигрывает, общий — остальным.
&Тест
Процедура ПорогПредкаДействуетНаПотомков() Экспорт

	Заданное = ИзОкружения("Уровни", "oscript.lib.winow.Фабрика=DEBUG,oscript.lib.decorator=DEBUG,Свой=DEBUG");
	Задать(Заданное, "Окружение", "Пороги", "oscript.lib=ERROR,oscript.lib.winow=WARN");
	Задать(Заданное, "Окружение", "Порог", "INFO");
	Логи = СвязкаИз(Заданное).Логи;

	Ожидаем.Что(ИмяВыходаКоллектора(Логи, "oscript.lib.winow.Фабрика"), "ближайший названный предок")
		.Равно("otel-warn");
	Ожидаем.Что(ИмяВыходаКоллектора(Логи, "oscript.lib.decorator"), "дальний названный предок")
		.Равно("otel-error");
	Ожидаем.Что(ИмяВыходаКоллектора(Логи, "Свой"), "журналу без названного предка — общий")
		.Равно("otel-info");
	Ожидаем.Что(ИмяВыходаКоллектора(Логи, "rootLogger"), "общий не подробнее уровня корня — следует ему")
		.Равно("otel");

КонецПроцедуры

// Таблица старта несёт заданный журналу порог, даже когда при старте он ничего не сужает:
// пульт поднимет уровень на лету — и порог обязан остаться.
&Тест
Процедура ТаблицаСтартаНазываетЗаданныйПорог() Экспорт

	Заданное = ИзОкружения("Порог", "INFO");
	Задать(Заданное, "Файл", "Пороги", "a=DISABLE");
	Задать(Заданное, "Файл", "Уровни", "a.b=DEBUG,c=WARN");
	ПриСтарте = СвязкаИз(Заданное).ПриСтарте;

	Ожидаем.Что(ПриСтарте["rootLogger"]["Порог"], "порог INFO при корне INFO назван").Равно("INFO");
	Ожидаем.Что(ПриСтарте["rootLogger"]["ПорогОткуда"], "откуда").Равно("окружение");
	Ожидаем.Что(ПриСтарте["a"]["Порог"], "порог журналу").Равно("DISABLE");
	Ожидаем.Что(ПриСтарте["a"]["ПорогСвой"], "назван ему самому").ЭтоИстина();
	Ожидаем.Что(ПриСтарте["a.b"]["Порог"], "потомку — порог предка").Равно("DISABLE");
	Ожидаем.Что(ПриСтарте["a.b"]["ПорогИмяНастройки"], "той же настройкой").Равно("oshub.log.otel.levels");
	Ожидаем.Что(ПриСтарте["a.b"]["ПорогСвой"], "но не ему самому").ЭтоЛожь();
	Ожидаем.Что(ПриСтарте["c"]["Порог"], "журналу без своего — общий").Равно("INFO");
	Ожидаем.Что(ПриСтарте["c"]["ПорогИмяНастройки"], "общей настройкой").Равно("ПРОБА");

	БезПорога = СвязкаИз(ИзОкружения("Уровни", "c=WARN")).ПриСтарте;
	Ожидаем.Что(БезПорога["c"]["Порог"], "порога нет — поле пустое").Равно("");
	Ожидаем.Что(БезПорога["c"]["ПорогОткуда"]).Равно("умолчание");

КонецПроцедуры

#КонецОбласти

#Область УзелФайлаОператора

// Выходы логу оператор называет логическими именами; незнакомое имя снимается с замечанием,
// опции раскладки autumn-logos переходят в узел как были.
&Тест
Процедура ВыходыИОпцииИзФайлаДоезжаютДоУзла() Экспорт

	Опции = Новый Соответствие();
	Опции.Вставить("level", "INFO");
	Опции.Вставить("appenders", "console, файл, OTEL");
	Опции.Вставить("additivity", Ложь);
	Опции.Вставить("classLayout", "МояРаскладка");
	Узел = Новый Соответствие();
	Узел.Вставить("Раскладной", Опции);
	Заданное = ПустоеЗаданное();
	ЗадатьУзел(Заданное, Узел);

	Уровни = Новый УровниЖурнала(ТипыСпособовВывода());
	Логи = Уровни.Связка(Заданное).Логи;
	Замечания = СтрСоединить(Уровни.Замечания(), Символы.ПС);

	Ожидаем.Что(СтрСоединить(Логи["Раскладной"]["appenders"], ","), "названные выходы, имя — без учёта регистра")
		.Равно("console,otel");
	Ожидаем.Что(Логи["Раскладной"]["classLayout"], "раскладка на месте").Равно("МояРаскладка");
	Ожидаем.Что(Логи["Раскладной"]["additivity"], "список полный — корневые к нему не добавляются")
		.Равно(Ложь);
	Ожидаем.Что(Замечания, "незнакомый выход назван").Содержит("logos.logger.Раскладной.appenders");
	Ожидаем.Что(Замечания, "с перечнем знакомых").Содержит("console, memory, otel");

КонецПроцедуры

// Как в logos: выходы, названные журналу, добавляются к выходам корня, с additivity: false —
// заменяют их. В узле хаба у названного лога список уже полный, поэтому additivity: false
// стоит у каждого лога, кроме корня.
&Тест
Процедура ВыходыЖурналаДобавляютсяКВыходамКорняБезAdditivity() Экспорт

	Узел = УзелФайла("rootLogger", "INFO", "console,memory");
	Узел.Вставить("Добавочный", УзелФайла("Добавочный", "INFO", "otel")["Добавочный"]);
	Узел.Вставить("Заменяющий", УзелФайла("Заменяющий", "INFO", "otel", Ложь)["Заменяющий"]);
	Заданное = ПустоеЗаданное();
	ЗадатьУзел(Заданное, Узел);
	Логи = СвязкаИз(Заданное).Логи;

	Ожидаем.Что(СтрСоединить(Логи["rootLogger"]["appenders"], ","), "корень — как назван").Равно("console,memory");
	Ожидаем.Что(СтрСоединить(Логи["Добавочный"]["appenders"], ","), "свой выход к корневым")
		.Равно("console,memory,otel");
	Ожидаем.Что(СтрСоединить(Логи["Заменяющий"]["appenders"], ","), "только свой").Равно("otel");
	Ожидаем.Что(Логи["Добавочный"]["additivity"], "в узле хаба список лога полный").Равно(Ложь);
	Ожидаем.Что(Логи["rootLogger"].Получить("additivity"), "у корня additivity нет").Равно(Неопределено);

КонецПроцедуры

// Как в logos: названный журнал берёт незаданное у корня, а не у предка по имени, — предок
// действует только на журналы, которых узел не назвал (их logos находит сама).
&Тест
Процедура НазванныйЖурналБерётНезаданноеУКорняАНеУПредка() Экспорт

	Узел = УзелФайла("rootLogger", "INFO", "console");
	Узел.Вставить("a", УзелФайла("a", "WARN", "otel", Ложь)["a"]);
	Опции = Новый Соответствие();
	Опции.Вставить("appenders", "memory");
	Узел.Вставить("a.b.c", Опции);
	Заданное = ПустоеЗаданное();
	ЗадатьУзел(Заданное, Узел);
	Логи = СвязкаИз(Заданное).Логи;

	Ожидаем.Что(Логи["a.b.c"]["level"], "уровень корня, а не предка").Равно("INFO");
	Ожидаем.Что(СтрСоединить(Логи["a.b.c"]["appenders"], ","), "выходы корня и свои, без выходов предка")
		.Равно("console,memory");

КонецПроцедуры

// Непонятое значение additivity не роняет старт: выходы добавляются к выходам корня, как
// без него, а оператор слышит, где ошибся.
&Тест
Процедура НепонятыйAdditivityНазванЗамечанием() Экспорт

	Заданное = ПустоеЗаданное();
	ЗадатьУзел(Заданное, УзелФайла("Странный", "INFO", "otel", "иногда"));
	Уровни = Новый УровниЖурнала(ТипыСпособовВывода());
	Логи = Уровни.Связка(Заданное).Логи;

	Ожидаем.Что(СтрСоединить(Логи["Странный"]["appenders"], ","), "как без additivity")
		.Равно("console,memory,otel");
	Ожидаем.Что(СтрСоединить(Уровни.Замечания(), Символы.ПС), "замечание называет ключ")
		.Содержит("logos.logger.Странный.additivity");

КонецПроцедуры

// Вне сервера (admin-cli, сидеры) выход один — консоль logos: коллектор и память снимаются
// молча, иначе logos падает «способ вывода нигде не описан».
&Тест
Процедура ВнеСервераОстаётсяКонсольLogos() Экспорт

	ТолькоКонсоль = Новый Соответствие();
	ТолькоКонсоль.Вставить("console", "ВыводЛогаВКонсоль");
	Уровни = Новый УровниЖурнала(ТолькоКонсоль);
	Заданное = ИзОкружения("Уровни", "Проба=DEBUG");
	ЗадатьУзел(Заданное, УзелФайла("ИзФайла", "WARN", "console,memory,otel"));
	Связка = Уровни.Связка(Заданное);

	Ожидаем.Что(СтрСоединить(Связка.Логи["ИзФайла"]["appenders"], ","), "только консоль").Равно("console");
	Ожидаем.Что(СтрСоединить(Связка.Логи["Проба"]["appenders"], ",")).Равно("console");
	Ожидаем.Что(Связка.СпособыВывода.Количество(), "объявлена одна консоль").Равно(1);
	Ожидаем.Что(Связка.СпособыВывода["console"]["type"]).Равно("ВыводЛогаВКонсоль");
	Ожидаем.Что(Уровни.Замечания().Количество(), "выходы сервера замечаний не родят").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область НепонятоеСлово

// Незнакомое слово роняло хаб голой ошибкой logos, в которой нет ни имени настройки, ни
// списка допустимых. Такое слово не применяется, оператор слышит настройку и перечень.
&Тест
Процедура НезнакомыйУровеньНеРоняетСтартАОбъясняется() Экспорт

	Уровни = Новый УровниЖурнала(ТипыСпособовВывода());
	Заданное = ПустоеЗаданное();
	Задать(Заданное, "Окружение", "Уровень", "TRACE", "ПРОБА_УРОВЕНЬ");
	Задать(Заданное, "Окружение", "Уровни", "КлиентАпстрима=ОЧЕНЬПОДРОБНО,мусор", "ПРОБА_УРОВНИ");
	Задать(Заданное, "Окружение", "Порог", "ГРОМКО", "ПРОБА_ПОРОГ");
	Задать(Заданное, "Окружение", "Пороги", "КлиентАпстрима=ТИХО", "ПРОБА_ПОРОГИ");
	Связка = Уровни.Связка(Заданное);
	Логи = Связка.Логи;

	Ожидаем.Что(Логи["rootLogger"]["level"], "корень — умолчание").Равно("INFO");
	Ожидаем.Что(Логи.Получить("КлиентАпстрима"), "компонент остался на корне").Равно(Неопределено);
	Ожидаем.Что(Логи.Получить("мусор"), "токен без знака равенства именем лога не становится")
		.Равно(Неопределено);
	Ожидаем.Что(ИмяВыходаКоллектора(Связка.Логи, "rootLogger"), "непонятый порог не сужает").Равно("otel");

	Замечания = СтрСоединить(Уровни.Замечания(), Символы.ПС);
	Для Каждого Названное Из СтрРазделить("ПРОБА_УРОВЕНЬ: ""TRACE"",ПРОБА_УРОВНИ[КлиентАпстрима],"
		+ "ПРОБА_УРОВНИ: ""мусор"",ПРОБА_ПОРОГ: ""ГРОМКО"",ПРОБА_ПОРОГИ[КлиентАпстрима]", ",") Цикл
		Ожидаем.Что(Замечания, "замечание называет настройку").Содержит(Названное);
	КонецЦикла;
	Ожидаем.Что(Замечания, "и перечисляет допустимые").Содержит("CRITICALERROR");

КонецПроцедуры

// Непонятое слово места не занимает: настройку берёт следующий по старшинству источник —
// ровно так, как если бы непонятого значения не было. Правило одно для каждого ключа.
&Тест
Процедура НепонятоеСловоОтдаётМестоСледующемуИсточнику() Экспорт

	Узел = Новый Соответствие();
	Узел.Вставить("ИзУзла", "DEBUG");
	Узел.Вставить("УзелСОпечаткой", "ОЧЕНЬ");
	Заданное = ПустоеЗаданное();
	Задать(Заданное, "Окружение", "Уровень", "TRACE");
	Задать(Заданное, "Окружение", "Уровни", "ИзУзла=ОЧЕНЬ,ИзКлюча=ОЧЕНЬ");
	Задать(Заданное, "Окружение", "Порог", "ТИШЕ");
	Задать(Заданное, "Окружение", "Пороги", "Икс=ТИШЕ");
	ЗадатьУзел(Заданное, Узел);
	Задать(Заданное, "Файл", "Уровень", "WARN");
	Задать(Заданное, "Файл", "Уровни", "ИзКлюча=ERROR,УзелСОпечаткой=DEBUG");
	Задать(Заданное, "Файл", "Порог", "ERROR");
	Задать(Заданное, "Файл", "Пороги", "Икс=CRITICALERROR");
	Логи = СвязкаИз(Заданное).Логи;

	Ожидаем.Что(Логи["rootLogger"]["level"], "уровень корня — из файла").Равно("WARN");
	Ожидаем.Что(Логи["ИзУзла"]["level"], "уровень лога — из узла").Равно("DEBUG");
	Ожидаем.Что(Логи["ИзКлюча"]["level"], "уровень лога — из ключа файла").Равно("ERROR");
	Ожидаем.Что(Логи["УзелСОпечаткой"]["level"], "опечатка узла отдаёт место ключу файла").Равно("DEBUG");
	Ожидаем.Что(ИмяВыходаКоллектора(Логи, "rootLogger"), "порог всем — из файла").Равно("otel-error");
	Ожидаем.Что(ИмяВыходаКоллектора(Логи, "Икс"), "порог логу — из файла").Равно("otel-criticalerror");

КонецПроцедуры

// Пустое — не ошибка оператора: умолчание берётся молча.
&Тест
Процедура НезаданныеУровниЗамечанийНеРодят() Экспорт

	Уровни = Новый УровниЖурнала(ТипыСпособовВывода());
	Связка = Уровни.Связка(ИзОкружения("Уровень", ""));

	Ожидаем.Что(Связка.Логи["rootLogger"]["level"], "корневой уровень по умолчанию").Равно("INFO");
	Ожидаем.Что(Уровни.Замечания().Количество(), "жаловаться не на что").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Обвязка

Функция ПрогнатьКлиентАпстрима(Знач Уровень, Знач БазовыйURL)

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.журнал." + Строка(Уровень));
	Лог.УстановитьУровень(Уровень);
	Лог.ДобавитьСпособВывода(Ловушка);

	Транспорт = Новый ФейкТранспортHTTP();
	Транспорт.УстановитьОтвет(200, "a" + Символы.ПС + "b", """etag-1""");

	Клиент = Новый КлиентАпстрима(Транспорт, НастройкиПрокси(5), Лог);
	Клиент.ПолучитьТекст(БазовыйURL, "list.txt");

	Лог.УдалитьСпособВывода(Ловушка);

	Возврат Ловушка;

КонецФункции

Функция Вызов(Знач Шаблон, Знач Аргументов)
	Возврат Новый Структура("Уровень, Шаблон, Аргументов, Литерал, Текст",
		"Отладка", Шаблон, Аргументов, Истина, "");
КонецФункции

Функция ВызовСВыражением(Знач Текст, Знач Аргументов)
	Возврат Новый Структура("Уровень, Шаблон, Аргументов, Литерал, Текст",
		"Отладка", "", Аргументов, Ложь, Текст);
КонецФункции

#КонецОбласти

#Область ПроверкаВызова

// Вердикт выносит сам СтрШаблон: подставляем столько же аргументов, сколько стоит в коде,
// и смотрим, переживёт ли он это. Так проверка не зависит от нашего счёта мест подстановки.
Функция ЧтоНеТакСВызовом(Знач Вызов)

	Если Вызов.Аргументов <= 1 Тогда
		Возврат ""; // logos при пустых параметрах СтрШаблон не зовёт вовсе
	КонецЕсли;

	Если НЕ Вызов.Литерал Тогда
		Возврат СтрШаблон("шаблон не литерал (%1) при %2 аргументах — арность не проверяема,"
			+ " соберите сообщение до вызова журнала", Вызов.Текст, Вызов.Аргументов);
	КонецЕсли;

	Попытка
		Подставить(Вызов.Шаблон, Вызов.Аргументов - 1);
	Исключение
		Возврат СтрШаблон("«%1» — аргументов %2, а мест подстановки меньше: %3",
			Однострочно(Вызов.Шаблон), Вызов.Аргументов - 1,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат "";

КонецФункции

Функция Подставить(Знач Шаблон, Знач Сколько)

	З = "x";
	Если Сколько = 1 Тогда
		Возврат СтрШаблон(Шаблон, З);
	ИначеЕсли Сколько = 2 Тогда
		Возврат СтрШаблон(Шаблон, З, З);
	ИначеЕсли Сколько = 3 Тогда
		Возврат СтрШаблон(Шаблон, З, З, З);
	ИначеЕсли Сколько = 4 Тогда
		Возврат СтрШаблон(Шаблон, З, З, З, З);
	ИначеЕсли Сколько = 5 Тогда
		Возврат СтрШаблон(Шаблон, З, З, З, З, З);
	ИначеЕсли Сколько = 6 Тогда
		Возврат СтрШаблон(Шаблон, З, З, З, З, З, З);
	ИначеЕсли Сколько = 7 Тогда
		Возврат СтрШаблон(Шаблон, З, З, З, З, З, З, З);
	ИначеЕсли Сколько = 8 Тогда
		Возврат СтрШаблон(Шаблон, З, З, З, З, З, З, З, З);
	КонецЕсли;

	Возврат СтрШаблон(Шаблон, З, З, З, З, З, З, З, З, З);

КонецФункции

Функция Однострочно(Знач Текст)
	Возврат СтрЗаменить(СтрЗаменить(Строка(Текст), Символы.ПС, "⏎"), Символы.Таб, " ");
КонецФункции

#КонецОбласти

#Область СканВызовов

Функция ВызовыЖурналаВФайле(Знач Путь)
	Возврат ВызовыЖурналаВТексте(Исходники.Текст(Путь));
КонецФункции

// Разметка отделяет код от литералов и комментариев, поэтому структуру вызова читаем
// по ней, а содержимое шаблона — по исходному тексту.
Функция ВызовыЖурналаВТексте(Знач ИсходныйТекст)

	Текст = СтрЗаменить(Строка(ИсходныйТекст), Символы.ВК, "");
	Результат = Новый Массив();
	Если СтрНайти(Текст, "Лог.") = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Разметка = РазметкаТекста(Текст);

	Для Каждого Уровень Из УровниЖурнала() Цикл
		Образец = "Лог." + Уровень;
		Позиция = 1;
		Пока Истина Цикл
			Найдено = СтрНайти(Текст, Образец, , Позиция);
			Если Найдено = 0 Тогда
				Прервать;
			КонецЕсли;
			Позиция = Найдено + 1;
			Если Сред(Разметка, Найдено, 1) <> "к" Тогда
				Продолжить; // вызов внутри литерала или комментария
			КонецЕсли;
			Если НЕ ЭтоГраницаИдентификатора(Текст, Найдено - 1) Тогда
				Продолжить; // хвост чужого имени: КаталогЛог.Отладка
			КонецЕсли;
			Скобка = ПозицияСкобкиВызова(Текст, Разметка, Найдено + СтрДлина(Образец));
			Если Скобка = 0 Тогда
				Продолжить; // не вызов: Лог.Отладка без скобки — обращение к свойству
			КонецЕсли;
			Вызов = РазобратьВызов(Текст, Разметка, Уровень, Скобка);
			Если Вызов <> Неопределено Тогда
				Результат.Добавить(Вызов);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция УровниЖурнала()
	Возврат СтрРазделить("Отладка,Информация,Предупреждение,Ошибка,КритичнаяОшибка", ",");
КонецФункции

// OneScript разрешает пробелы и переносы между именем метода и скобкой, поэтому искать
// «Лог.Отладка(» точной подстрокой нельзя: `Лог.Отладка (` обошёл бы скан при живой мине.
// Возвращает 0, если за именем идёт не вызов.
Функция ПозицияСкобкиВызова(Знач Текст, Знач Разметка, Знач ПослеИмени)

	Позиция = ПослеИмени;
	Длина = СтрДлина(Текст);

	Пока Позиция <= Длина Цикл
		Если Сред(Разметка, Позиция, 1) <> "к" Тогда
			Возврат 0;
		КонецЕсли;
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = "(" Тогда
			Возврат Позиция;
		КонецЕсли;
		Если Символ <> " " И Символ <> Символы.Таб И Символ <> Символы.ПС Тогда
			Возврат 0;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат 0;

КонецФункции

Функция РазобратьВызов(Знач Текст, Знач Разметка, Знач Уровень, Знач ПозицияСкобки)

	Куски = АргументыВызова(Текст, Разметка, ПозицияСкобки);
	Если Куски = Неопределено Тогда
		Возврат Неопределено; // незакрытая скобка: файл оборван, судить не о чем
	КонецЕсли;

	Первый = Куски[0];
	Разбор = СобратьШаблон(Текст, Разметка, Первый.Начало, Первый.Длина);

	Возврат Новый Структура("Уровень, Шаблон, Аргументов, Литерал, Текст",
		Уровень, Разбор.Шаблон, Куски.Количество(), Разбор.Литерал,
		СокрЛП(Сред(Текст, Первый.Начало, Первый.Длина)));

КонецФункции

// Куски аргументов верхнего уровня: скобки и запятые считаются только там, где код.
Функция АргументыВызова(Знач Текст, Знач Разметка, Знач ПозицияСкобки)

	Куски = Новый Массив();
	Глубина = 1;
	Начало = ПозицияСкобки + 1;
	Позиция = Начало;
	Длина = СтрДлина(Текст);

	Пока Позиция <= Длина Цикл
		Если Сред(Разметка, Позиция, 1) = "к" Тогда
			Символ = Сред(Текст, Позиция, 1);
			Если Символ = "(" Тогда
				Глубина = Глубина + 1;
			ИначеЕсли Символ = ")" Тогда
				Глубина = Глубина - 1;
				Если Глубина = 0 Тогда
					Куски.Добавить(Кусок(Начало, Позиция - Начало));
					Возврат Куски;
				КонецЕсли;
			ИначеЕсли Символ = "," И Глубина = 1 Тогда
				Куски.Добавить(Кусок(Начало, Позиция - Начало));
				Начало = Позиция + 1;
			КонецЕсли;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция Кусок(Знач Начало, Знач Длина)
	Возврат Новый Структура("Начало, Длина", Начало, Длина);
КонецФункции

// Шаблон складывается из литералов куска; между ними допустимы только «+», пробелы
// и Символы.* — всё прочее делает шаблон невычислимым на глаз.
Функция СобратьШаблон(Знач Текст, Знач Разметка, Знач Начало, Знач Длина)

	Шаблон = "";
	Код = "";

	Для Позиция = Начало По Начало + Длина - 1 Цикл
		Метка = Сред(Разметка, Позиция, 1);
		Если Метка = "с" Тогда
			Шаблон = Шаблон + Сред(Текст, Позиция, 1);
		ИначеЕсли Метка = "к" Тогда
			Код = Код + Сред(Текст, Позиция, 1);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Шаблон, Литерал", Шаблон, ЭтоСклейкаЛитералов(Код));

КонецФункции

Функция ЭтоСклейкаЛитералов(Знач Код)

	Остаток = Код;
	Для Каждого Имя Из СтрРазделить("Символы.ПС,Символы.ВК,Символы.Таб,Символы.НПП", ",") Цикл
		Остаток = СтрЗаменить(Остаток, Имя, "");
	КонецЦикла;

	Возврат НЕ ЗначениеЗаполнено(СтрЗаменить(СтрЗаменить(СокрЛП(Остаток), "+", ""), Символы.Таб, ""));

КонецФункции

#КонецОбласти

#Область РазметкаИсходника

// На каждый знак текста — метка: «к» код, «с» содержимое литерала, «"» кавычка литерала,
// «э» служебный знак литерала (вертикальная черта переноса, вторая кавычка удвоенной),
// «#» комментарий. Состояние литерала переносится между строками: литерал бывает
// многострочным, и без переноса состояния код за ним читается как содержимое.
Функция РазметкаТекста(Знач Текст)

	Куски = Новый Массив();
	ВЛитерале = Ложь;

	Для Каждого Строка_ Из СтрРазделить(Текст, Символы.ПС) Цикл
		Если Куски.Количество() > 0 Тогда
			Куски.Добавить(?(ВЛитерале, "с", "к")); // сам перевод строки
		КонецЕсли;
		Разбор = РазметитьСтроку(Строка_, ВЛитерале);
		Куски.Добавить(Разбор.Разметка);
		ВЛитерале = Разбор.ВЛитерале;
	КонецЦикла;

	Возврат СтрСоединить(Куски, "");

КонецФункции

Функция РазметитьСтроку(Знач Строка_, Знач ВходВЛитерале)

	Метки = Новый Массив();
	ВЛитерале = ВходВЛитерале;
	Позиция = 1;
	Длина = СтрДлина(Строка_);

	Если ВЛитерале Тогда
		Позиция = ОтметитьПереносЛитерала(Строка_, Метки);
	КонецЕсли;

	Пока Позиция <= Длина Цикл
		Символ = Сред(Строка_, Позиция, 1);

		Если Символ = """" Тогда
			Если ВЛитерале И Сред(Строка_, Позиция + 1, 1) = """" Тогда
				Метки.Добавить("сэ"); // удвоенная кавычка — содержимое
				Позиция = Позиция + 2;
				Продолжить;
			КонецЕсли;
			ВЛитерале = НЕ ВЛитерале;
			Метки.Добавить("""");
		ИначеЕсли НЕ ВЛитерале И Символ = "/" И Сред(Строка_, Позиция + 1, 1) = "/" Тогда
			Метки.Добавить(Повторить("#", Длина - Позиция + 1));
			Позиция = Длина + 1;
			Прервать;
		Иначе
			Метки.Добавить(?(ВЛитерале, "с", "к"));
		КонецЕсли;

		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Новый Структура("Разметка, ВЛитерале", СтрСоединить(Метки, ""), ВЛитерале);

КонецФункции

// Продолжение многострочного литерала: отступ и вертикальная черта — синтаксис, не текст.
Функция ОтметитьПереносЛитерала(Знач Строка_, Метки)

	Позиция = 1;
	Длина = СтрДлина(Строка_);

	Пока Позиция <= Длина Цикл
		Символ = Сред(Строка_, Позиция, 1);
		Если Символ = " " ИЛИ Символ = Символы.Таб Тогда
			Метки.Добавить("э");
			Позиция = Позиция + 1;
		ИначеЕсли Символ = "|" Тогда
			Метки.Добавить("э");
			Возврат Позиция + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат Позиция;

КонецФункции

Функция Повторить(Знач Символ, Знач Сколько)

	Куски = Новый Массив();
	Для Счёт = 1 По Сколько Цикл
		Куски.Добавить(Символ);
	КонецЦикла;
	Возврат СтрСоединить(Куски, "");

КонецФункции

Функция ЭтоГраницаИдентификатора(Знач Текст, Знач Позиция)

	Если Позиция < 1 Тогда
		Возврат Истина;
	КонецЕсли;

	Символ = Сред(Текст, Позиция, 1);
	Возврат СтрНайти("QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm"
		+ "ЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮйцукенгшщзхъфывапролджэячсмитьбю"
		+ "0123456789_", Символ) = 0;

КонецФункции

#КонецОбласти

#Область Корпус

Функция ПродуктовыеФайлы()

	Файлы = Новый Массив();
	Для Каждого Найденный Из НайтиФайлы(ОбъединитьПути(КаталогПроекта, "src"), "*.os", Истина) Цикл
		Если Найденный.ЭтоФайл() Тогда
			Файлы.Добавить(Найденный.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Если Файлы.Количество() < 100 Тогда
		ВызватьИсключение СтрШаблон("Корпус скана подозрительно мал (%1 файлов)",
			Файлы.Количество());
	КонецЕсли;

	Возврат Файлы;

КонецФункции

#КонецОбласти

Функция ТипыСпособовВывода()

	Типы = Новый Соответствие();
	Типы.Вставить("console", "ВыводЛогаВКонсольХаба");
	Типы.Вставить("memory", "ВыводЛогаВПамятьХаба");
	Типы.Вставить("otel", "ВыводЛогаВOTelХаба");

	Возврат Типы;

КонецФункции

Функция СвязкаИз(Знач Заданное)
	Возврат Новый УровниЖурнала(ТипыСпособовВывода()).Связка(Заданное);
КонецФункции

// Заданное оператором по источникам — так его отдаёт загрузка настроек; пока пустое.
Функция ПустоеЗаданное()
	Возврат Новый Структура("Программно, Окружение, Файл", Новый Структура(), Новый Структура(),
		Новый Структура());
КонецФункции

// Заданное с одним ключом, пришедшим переменной окружения.
Функция ИзОкружения(Знач Поле, Знач Значение)
	Заданное = ПустоеЗаданное();
	Задать(Заданное, "Окружение", Поле, Значение);
	Возврат Заданное;
КонецФункции

// Ключ хаба в источнике; имя настройки у файла — сам ключ, у переменной — ПРОБА.
Процедура Задать(Заданное, Знач Источник, Знач Поле, Знач Значение, Знач ИмяНастройки = "")

	Если НЕ ЗначениеЗаполнено(ИмяНастройки) Тогда
		Ключи = Новый Структура("Уровень, Уровни, Порог, Пороги",
			"oshub.log.level", "oshub.log.levels", "oshub.log.otel.level", "oshub.log.otel.levels");
		ИмяНастройки = ?(Источник = "Файл", Ключи[Поле], "ПРОБА");
	КонецЕсли;
	Заданное[Источник].Вставить(Поле, Новый Структура("Значение, Откуда, ИмяНастройки, Название",
		Значение, НРег(Источник), ИмяНастройки, ИмяНастройки));

КонецПроцедуры

Процедура ЗадатьУзел(Заданное, Знач Узел)
	Заданное.Файл.Вставить("Узел", Новый Структура("Значение, Откуда, ИмяНастройки, Название",
		Узел, "файл", "logos.logger", "logos.logger файла настроек"));
КонецПроцедуры

// Узел logos.logger файла с одним логом: уровень и выходы строкой; additivity — если назван.
Функция УзелФайла(Знач ИмяЛога, Знач Уровень, Знач Выходы, Знач Добавочно = Неопределено)
	Опции = Новый Соответствие();
	Опции.Вставить("level", Уровень);
	Опции.Вставить("appenders", Выходы);
	Если Добавочно <> Неопределено Тогда
		Опции.Вставить("additivity", Добавочно);
	КонецЕсли;
	Узел = Новый Соответствие();
	Узел.Вставить(ИмяЛога, Опции);
	Возврат Узел;
КонецФункции

// Имя выхода коллектора у лога; пусто — лог в коллектор не пишет.
Функция ИмяВыходаКоллектора(Знач Логи, Знач ИмяЛога)
	Для Каждого Выход Из Логи[ИмяЛога]["appenders"] Цикл
		Если СтрНачинаетсяС(Выход, "otel") Тогда
			Возврат Выход;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Свой лог на тест с единственным способом вывода: соседние тесты его строк не видят.
Функция ЛогСВыводом(Знач СпособВывода)

	Лог = Логирование.ПолучитьЛог("тест.oshub.дверь." + Строка(Новый УникальныйИдентификатор()));
	Лог.УстановитьУровень(УровниЛога.Информация);
	Лог.ДобавитьСпособВывода(СпособВывода);
	Возврат Лог;

КонецФункции

// Настоящее событие logos: уровень строки и уровень её лога — то, по чему идёт отбор.
Функция СобытиеУровня(Знач УровеньСтроки, Знач УровеньЛога)

	Строитель = Новый СтроительСобытияЛога();
	Строитель.УстановитьИмяЛога("тест");
	Строитель.УстановитьУровень(УровеньСтроки);
	Строитель.УстановитьУровеньЛога(УровеньЛога);
	Строитель.УстановитьСообщение("строка");

	Возврат Строитель.Создать();

КонецФункции

// Настройки прокси для прямой сборки вне контейнера: таймаут — параметром.
Функция НастройкиПрокси(Знач Таймаут)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПрокси(Таймаут);
	Возврат Настройки;
КонецФункции
