// Приёмка страницы описания API на живом хабе (ИСТ-ЭКСП-014): адрес постоянный, страница
// собрана из своей статики, читает то же описание, которое хаб отдаёт машине, и до первого
// администратора уводит на мастер первого запуска.

#Использовать asserts
#Использовать 1connector
#Использовать oscript-ui
#Использовать "фикстуры"

Перем Хаб;     // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;  // фикстура КлиентХаба — запросы к подопытному хабу
Перем ОтветДоОнбординга;  // снимок ответа страницы ДО появления первого администратора
Перем Разметка;           // разметка страницы, снятая один раз на набор
Перем КукаАдмина;         // сессия администратора — ею ходит пробный запрос со страницы
Перем Тексты;             // ТекстыИнтерфейса поверх словаря хаба — тексты берутся по ключу
Перем Экран;              // ЭкранированиеHTML (кит) — текст ищется в разметке так, как напечатан

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("КлассыСлоя");

	// предупреждение на странице ищется ПО КЛЮЧУ: свой литерал в наборе разошёлся бы
	// со словарём молча, и тест покраснел бы на безобидной правке формулировки
	Поиск = Новый КлассыСлоя();
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Модули = ОбъединитьПути(Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя,
		"src", "модули");
	Поиск.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "СловарьТекстов");
	Тексты = Новый ТекстыИнтерфейса(Новый СловарьТекстов());
	Экран = Новый ЭкранированиеHTML();

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	Хаб.ФайловаяБаза("openhub-описание-api");

	// администратора заводит мастер, а не окружение: до него хаб обязан уводить на /setup,
	// и снять это можно только ДО прохождения мастера
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");

	Хаб.Запустить();

	ОтветДоОнбординга = Клиент.GETБезПереходов(АдресСтраницы());

	ПройтиМастерПервогоЗапуска("root", "RootSecret1");

	Разметка = Клиент.Тело(Клиент.GETСтраницы(АдресСтраницы()));
	КукаАдмина = Клиент.Войти("root", "RootSecret1");

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область Страница

&Тест
Процедура СтраницаОтдаётсяРазметкойПоПостоянномуАдресу() Экспорт

	Ответ = Клиент.GETСтраницы(АдресСтраницы());

	Ожидаем.Что(Ответ.КодСостояния, АдресСтраницы() + " отдаётся").Равно(200);
	Ожидаем.Что(НРег(Клиент.ЗаголовокОтвета(Ответ, "Content-Type")), "и отдаётся разметкой")
		.Содержит("text/html");
	Ожидаем.Что(СтрНайти(Разметка, "data-swagger-ui") > 0,
		"на странице есть место, куда движок рисует себя").ЭтоИстина();

КонецПроцедуры

// НФТ-ИНТФ-003 на живой странице: корпоративный контур без выхода в интернет обязан
// увидеть её такой же. Проверяется ЗНАЧЕНИЕ каждого адреса разметки, а не отсутствие
// слова «http» в тексте: «//cdn.tld/x.js» слова не содержит и работает.
&Тест
Процедура БраузерНеУходитСоСтраницыНиНаОдинЧужойУзел() Экспорт

	Чужие = Новый Массив();

	Для Каждого Адрес Из АдресаРесурсов(Разметка) Цикл
		Если НЕ СтрНачинаетсяС(Адрес, "/") ИЛИ СтрНачинаетсяС(Адрес, "//") Тогда
			Чужие.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Чужие, ", "),
		"адреса страницы, ведущие не на этот хаб").Равно("");
	Ожидаем.Что(АдресаРесурсов(Разметка).Количество() > 5,
		СтрШаблон("разбор ослеп: адресов на странице найдено %1",
			АдресаРесурсов(Разметка).Количество())).ЭтоИстина();

КонецПроцедуры

// Адрес ресурса несёт отпечаток его содержимого, поэтому он объявлен неизменяемым.
// Ссылка на файл, которого хаб не отдаёт, оставила бы страницу без оформления или
// без движка — и увидел бы это только человек.
&Тест
Процедура КаждыйРесурсСтраницыОтдаётсяЭтимЖеХабомИНеИстекает() Экспорт

	Отказы = Новый Массив();
	Проверено = 0;

	Для Каждого Адрес Из АдресаРесурсов(Разметка) Цикл

		Если НЕ СтрНачинаетсяС(Адрес, "/static/") Тогда
			Продолжить;
		КонецЕсли;

		Проверено = Проверено + 1;
		Ответ = Клиент.GET(Адрес);

		Если Ответ.КодСостояния <> 200 Тогда
			Отказы.Добавить(СтрШаблон("%1 — код %2", Адрес, Ответ.КодСостояния));
			Продолжить;
		КонецЕсли;

		Если СтрНайти(Клиент.ЗаголовокОтвета(Ответ, "Cache-Control"), "immutable") = 0 Тогда
			Отказы.Добавить(СтрШаблон("%1 — Cache-Control «%2» без immutable",
				Адрес, Клиент.ЗаголовокОтвета(Ответ, "Cache-Control")));
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Отказы, "; "), "статика страницы отдаётся неверно").Равно("");
	Ожидаем.Что(Проверено > 2,
		СтрШаблон("на странице найдено файлов статики: %1", Проверено)).ЭтоИстина();

КонецПроцедуры

// Движок — три файла, и каждый обязан приехать со своим типом: браузер не исполнит
// скрипт, отданный текстом, и не применит лист, отданный не стилем.
&Тест
Процедура ЛистИСкриптыДвижкаПриезжаютСоСвоимиТипами() Экспорт

	Ожидания = Новый Массив();
	Ожидания.Добавить(ФайлДвижка("swagger-ui.css", "text/css"));
	Ожидания.Добавить(ФайлДвижка("swagger-ui-bundle.js", "application/javascript"));
	Ожидания.Добавить(ФайлДвижка("openhub-swagger.js", "application/javascript"));

	Расхождения = Новый Массив();

	Для Каждого Ожидаемый Из Ожидания Цикл

		Адрес = АдресФайлаСтатики(Ожидаемый.Файл);
		Если НЕ ЗначениеЗаполнено(Адрес) Тогда
			Расхождения.Добавить(Ожидаемый.Файл + " — на странице не упомянут вовсе");
			Продолжить;
		КонецЕсли;

		Тип = НРег(Клиент.ЗаголовокОтвета(Клиент.GET(Адрес), "Content-Type"));
		Если СтрНайти(Тип, Ожидаемый.Тип) = 0 Тогда
			Расхождения.Добавить(СтрШаблон("%1 (%2) отдан как «%3»",
				Ожидаемый.Файл, Адрес, Тип));
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Расхождения, "; "), "файлы движка на странице").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ЧужойДвижокНаСвоейСтранице

// Движок приехал из чужого пакета под Apache-2.0, и разрешение на него обязано быть
// достижимо оттуда, где он работает: отданный по адресу, которого никто не знает, текст
// лицензии обещание «авторство указано в отдаваемом файле» не выполняет.
&Тест
Процедура РазрешенияНаДвижокДостижимыСоСтраницы() Экспорт

	Отказы = Новый Массив();
	Файлы = СтрРазделить("swagger-ui-LICENSE.txt,swagger-ui-NOTICE.txt,"
		+ "swagger-ui-bundle.js.LICENSE.txt", ",");

	Для Каждого Имя Из Файлы Цикл

		Адрес = АдресФайлаСтатики(Имя);
		Если НЕ ЗначениеЗаполнено(Адрес) Тогда
			Отказы.Добавить(Имя + " — хода со страницы нет");
			Продолжить;
		КонецЕсли;

		Ответ = Клиент.GET(Адрес);
		Если Ответ.КодСостояния <> 200 Тогда
			Отказы.Добавить(СтрШаблон("%1 (%2) — код %3", Имя, Адрес, Ответ.КодСостояния));
			Продолжить;
		КонецЕсли;

		Если СтрНайти(НРег(Клиент.ЗаголовокОтвета(Ответ, "Content-Type")), "text/plain") = 0 Тогда
			Отказы.Добавить(СтрШаблон("%1 отдан как «%2»", Имя,
				Клиент.ЗаголовокОтвета(Ответ, "Content-Type")));
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Отказы, "; "), "ходы на разрешения движка").Равно("");

КонецПроцедуры

// Одно правило листа движка не заперто под его классом и красит КОРЕНЬ документа своим
// тёмным. Хаб держит фон на теле, и без поправки страница показывает два разных тёмных.
// Поправка перебивает чужое правило ПОРЯДКОМ при равной специфичности, поэтому проверяется
// именно порядок: уехав выше листа движка, она перестанет работать молча.
&Тест
Процедура ФонКорняПодДвижкомОстаётсяФономХаба() Экспорт

	Лист = СтрНайти(Разметка, АдресФайлаСтатики("swagger-ui.css"));
	Поправка = СтрНайти(Разметка, "html.dark-mode{background:var(--color-bg)}");

	Ожидаем.Что(Лист > 0, "лист движка на странице есть").ЭтоИстина();

	// поправка нужна ровно до тех пор, пока чужое правило существует: сняв его,
	// новая версия движка оставила бы у нас мёртвый код, и молча
	Ожидаем.Что(СтрНайти(Клиент.Тело(Клиент.GET(АдресФайлаСтатики("swagger-ui.css"))),
		"html.dark-mode") > 0,
		"движок всё ещё красит корень документа — иначе поправку пора снимать").ЭтоИстина();
	Ожидаем.Что(Поправка > 0,
		"фон корня возвращён хабу тем же селектором, которым его забрал движок").ЭтоИстина();
	Ожидаем.Что(Поправка > Лист,
		СтрШаблон("поправка стоит ПОСЛЕ листа движка (лист %1, поправка %2)", Лист, Поправка))
		.ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ОдноОписаниеНаЧеловекаИМашину

// Страница не несёт своей копии описания: она называет АДРЕС документа, и это тот самый
// адрес, по которому хаб отдаёт описание машине.
&Тест
Процедура СтраницаЧитаетТоЖеОписаниеЧтоХабОтдаётМашине() Экспорт

	Адрес = Клиент.ПослеМаркера(Разметка, "data-openapi=""", """");

	Ожидаем.Что(Адрес, "адрес описания на странице").Равно("/api/v1/openapi.json");

	Ответ = Клиент.GET(Адрес);
	Ожидаем.Что(Ответ.КодСостояния, Адрес + " отдаётся").Равно(200);
	Ожидаем.Что(НРег(Клиент.ЗаголовокОтвета(Ответ, "Content-Type")), "описание машиночитаемо")
		.Содержит("json");

	Документ = Клиент.ТелоJSON(Ответ);
	Ожидаем.Что(Строка(Документ.Получить("openapi")), "версия формата описания")
		.Содержит("3.");
	Ожидаем.Что(Документ.Получить("paths") <> Неопределено, "в описании есть адреса")
		.ЭтоИстина();

КонецПроцедуры

// Ссылка на тот же документ стоит и в тексте страницы: человек, которому нужен файл,
// забирает его отсюда, а не из исходников хаба.
&Тест
Процедура СтраницаДаётЧеловекуХодКМашиночитаемомуОписанию() Экспорт

	Ожидаем.Что(АдресаРесурсов(Разметка).Найти("/api/v1/openapi.json") <> Неопределено,
		"на странице есть ход к машиночитаемому описанию").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ОбещанноеСтраницей

// Страница обещает человеку словами: пробный запрос уходит с его текущей сессией, чтение
// ответит так, как видит вошедший, а изменение хаб отвергнет без токена CSRF. Обещание
// сказано на экране — значит, оно обязано быть правдой, иначе интегратор решит, что ручка
// анонимна, увидев в ней свои же приватные данные.
&Тест
Процедура ПробномуЗапросуСессияЧитателяДаётЧтениеНоНеИзменение() Экспорт

	Ожидаем.Что(ЗначениеЗаполнено(КукаАдмина), "сессия для проверки получена").ЭтоИстина();

	Чтение = Клиент.GETСКукой("/api/v1/tokens", КукаАдмина);
	Ожидаем.Что(Чтение.КодСостояния, "сессии для чтения достаточно").Равно(200);

	Аноним = Клиент.GET("/api/v1/tokens");
	Ожидаем.Что(Аноним.КодСостояния = 200, "КОНТРОЛЬ: анониму та же ручка не отвечает")
		.ЭтоЛожь();

	Изменение = Клиент.ЗапросJSON("POST", "/api/v1/pools",
		"{""name"":""проба-со-страницы"",""type"":""public""}", Клиент.Кука(КукаАдмина));
	Ожидаем.Что(Изменение.КодСостояния, "сессия без токена CSRF к изменению не допущена")
		.Равно(403);
	Ожидаем.Что(Клиент.Тело(Изменение), "и отказ называет причину").Содержит("csrf");

	// снятое со страницы предупреждение не делает эти факты менее верными — оно делает
	// их незаметными, и без этой проверки набор остался бы зелёным
	Непроизнесённые = Новый Массив();
	Ключи = "public.api.probe,public.api.probe.read,public.api.probe.write,public.api.probe.token";
	Для Каждого Ключ Из СтрРазделить(Ключи, ",") Цикл
		Если СтрНайти(Разметка, Экран.Экранировать(Тексты.Текст(Ключ))) = 0 Тогда
			Непроизнесённые.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Непроизнесённые, ", "),
		"страница обязана предупреждать о сессии, иначе проверенные выше факты"
			+ " станут ловушкой").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ДоступностьИОтказы

// Страница публичная, а значит подчиняется общему правилу публичных экранов: пока хаба
// ещё нет как инсталляции, любой заход ведёт к мастеру первого запуска.
&Тест
Процедура ДоПервогоАдминистратораСтраницаУводитНаМастерПервогоЗапуска() Экспорт

	Ожидаем.Что(ОтветДоОнбординга.КодСостояния, "переход, а не страница").Равно(302);
	Ожидаем.Что(Клиент.ЗаголовокОтвета(ОтветДоОнбординга, "Location"), "куда ведёт переход")
		.Равно("/setup");

КонецПроцедуры

// winow метод не различает: POST по адресу страницы придёт в тот же обработчик. Отказ
// обязан назвать разрешённое, а не отдать страницу как ни в чём не бывало.
&Тест
Процедура МутацияПоАдресуСтраницыОтвергается() Экспорт

	Ответ = Клиент.ЗапросФормы("POST", АдресСтраницы(), Новый Соответствие());

	Ожидаем.Что(Ответ.КодСостояния, "POST по адресу страницы").Равно(405);
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Ответ, "Allow"), "и отказ называет разрешённое")
		.Равно("GET");

КонецПроцедуры

// Страница бесполезна, если её некому найти: ход на неё стоит в меню хаба и виден
// с любой страницы, в том числе анониму на главной. Голое «API» в ряду дорог человеку
// ничего не объясняет, поэтому подпись проверяется вместе с адресом.
&Тест
Процедура ХодНаСтраницуСтоитВМенюХабаИНазванСловами() Экспорт

	Главная = Клиент.Тело(Клиент.GETСтраницы("/"));

	Ожидаем.Что(СтрНайти(Главная, СтрШаблон("href=""%1""", АдресСтраницы())) > 0,
		"ход на описание API есть на главной").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Главная, "Описание API") > 0,
		"и назван словами, а не сокращением").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АдресСтраницы()
	Возврат "/swagger-ui.html";
КонецФункции

// Все адреса, по которым браузер пойдёт, открывая страницу: ресурсы и ходы.
Функция АдресаРесурсов(Знач HTML)

	Результат = Новый Массив();
	Отбор = Новый РегулярноеВыражение("(?:src|href|action)=""([^""]*)""");

	Для Каждого Совпадение Из Отбор.НайтиСовпадения(HTML) Цикл
		Значение = Совпадение.Группы[1].Значение;
		Если ЗначениеЗаполнено(Значение) И Результат.Найти(Значение) = Неопределено Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ФайлДвижка(Знач ИмяНаДиске, Знач ТипКонтента)
	Возврат Новый Структура("Файл, Тип", ИмяНаДиске, ТипКонтента);
КонецФункции

// Адрес файла статики по его имени на диске: отпечаток содержимого встаёт в адресе
// МЕЖДУ именем и расширением, поэтому имя сверяется с началом, а расширение — с концом.
// Одного начала мало: «swagger-ui-» начинает и адрес листа, и адрес движка.
Функция АдресФайлаСтатики(Знач ИмяНаДиске)

	Расширение = Новый Файл(ИмяНаДиске).Расширение;
	Начало = "/static/" + Лев(ИмяНаДиске, СтрДлина(ИмяНаДиске) - СтрДлина(Расширение)) + "-";

	Для Каждого Адрес Из АдресаРесурсов(Разметка) Цикл
		Если СтрНачинаетсяС(Адрес, Начало) И СтрЗаканчиваетсяНа(Адрес, Расширение) Тогда
			Возврат Адрес;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Мастер первого запуска: заводит администратора без требования сменить пароль.
Процедура ПройтиМастерПервогоЗапуска(Знач Логин, Знач Пароль)

	Ответ = Клиент.ЗапросJSON("POST", "/setup",
		СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", Логин, Пароль));

	Если Ответ.КодСостояния <> 201 Тогда
		ВызватьИсключение СтрШаблон("Мастер /setup не создал администратора: код %1, тело %2",
			Ответ.КодСостояния, Ответ.ПолучитьТелоКакСтроку());
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
