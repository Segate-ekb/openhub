// Юнит-тесты файлового хранилища артефактов: раскладка на диске, атомарная запись, sha256,
// квоты, перезапись, защита от выхода за корень, юникод. Каждый тест — в своём временном корне.

#Использовать asserts
#Использовать tempfiles
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КореньДанных;   // Строка - временный корень хранилища текущего теста
Перем ЭталонSha256;   // Строка - sha256 строки "hello" (utf-8, без BOM)

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ЭталонSha256 = "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824";

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассов = ОбъединитьПути(
		ОбъединитьПути(КаталогПроекта, "src", "модули"), "хранилище", "Классы");

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогКлассов, "КоординатыАртефакта.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогКлассов, "РаскладкаФайловХранилища.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогКлассов, "КвотаХранилища.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогКлассов, "ПомощникАртефакта.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогКлассов, "..", ".."),
		"основа", "Классы", "ТихаяУборка.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогКлассов, "ВместимостьКвоты.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогКлассов, "ФайловоеХранилище.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ПоддельныеКоординаты.os"));

КонецПроцедуры

&ПередКаждым
Процедура ПодготовитьКорень() Экспорт

	// Корень хранилища лежит ВНУТРИ песочницы, а не прямо в каталоге временных файлов.
	// Причина — тест КоординатыСОбходомКорняОтклоняютсяХранилищем: он проверяет, что
	// снаружи корня ничего не появилось, сканируя РОДИТЕЛЯ корня рекурсивно. Когда
	// родителем был системный TMPDIR, скан обходил все временные файлы машины: 2170 мс
	// (измерено) и регулярный FileNotFoundException на чужом каталоге, удалённом другим
	// процессом между перечислением и чтением. Песочница делает тот же скан локальным.
	Песочница = ВременныеФайлы.СоздатьКаталог();
	КореньДанных = ОбъединитьПути(Песочница, "корень");
	СоздатьКаталог(КореньДанных);

КонецПроцедуры

&ПослеКаждого
Процедура УбратьКорень() Экспорт
	ВременныеФайлы.УдалитьФайл(Новый Файл(КореньДанных).Путь);
КонецПроцедуры

#Область СохранениеИЧтение

&Тест
Процедура ПереименованиеПулаПереноситВсюОбластьХранения() Экспорт

	// Координаты артефакта включают ИМЯ пула, поэтому переименование пула — операция над
	// всей его областью, а не над одним файлом: артефакты обязаны переехать вместе
	// с именем, иначе выдача ищет файлы там, где их уже нет.
	Хранилище = НовоеХранилище();

	Хранилище.Сохранить(Новый КоординатыАртефакта("старый", "lib", "1.0.0"), Данные("артефакт"));
	Ожидаем.Что(Хранилище.Существует(Новый КоординатыАртефакта("старый", "lib", "1.0.0")),
		"артефакт на месте до переноса").ЭтоИстина();

	Хранилище.ПереименоватьПул("старый", "новый");

	Ожидаем.Что(Хранилище.Существует(Новый КоординатыАртефакта("новый", "lib", "1.0.0")),
		"артефакт доступен по новому имени").ЭтоИстина();
	Ожидаем.Что(Хранилище.Существует(Новый КоординатыАртефакта("старый", "lib", "1.0.0")),
		"по старому имени не остался").ЭтоЛожь();

	// идемпотентность: исходной области больше нет — переносить нечего, это не ошибка
	Хранилище.ПереименоватьПул("старый", "новый");
	Ожидаем.Что(Хранилище.Существует(Новый КоординатыАртефакта("новый", "lib", "1.0.0")),
		"повторный вызов ничего не сломал").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПереименованиеПулаНеСливаетДвеОбласти() Экспорт

	// Слияние областей молча потеряло бы артефакт при совпадении имён файлов, поэтому
	// существующая цель — отказ, а не «дописать сверху».
	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Новый КоординатыАртефакта("а", "lib", "1.0.0"), Данные("первый"));
	Хранилище.Сохранить(Новый КоординатыАртефакта("б", "lib", "1.0.0"), Данные("второй"));

	Поймано = "";
	Попытка
		Хранилище.ПереименоватьПул("а", "б");
	Исключение
		Поймано = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Поймано), "перенос в занятую область отклонён").ЭтоИстина();
	Ожидаем.Что(Хранилище.Существует(Новый КоординатыАртефакта("а", "lib", "1.0.0")),
		"исходная область не тронута").ЭтоИстина();
	Ожидаем.Что(Хранилище.Существует(Новый КоординатыАртефакта("б", "lib", "1.0.0")),
		"целевая область не тронута").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СохранениеИзДвоичныхДанныхКладетФайлПоКаноническомуПути() Экспорт

	Хранилище = НовоеХранилище();
	Координаты = Новый КоординатыАртефакта("main", "gitrunner", "1.9.3");

	Результат = Хранилище.Сохранить(Координаты, ДанныеHello());

	Ожидаем.Что(Результат.Sha256).Равно(ЭталонSha256);
	Ожидаем.Что(Результат.Размер).Равно(5);

	ОжидаемыйПуть = ОбъединитьПути(
		ОбъединитьПути(КореньДанных, "pools", "main", "gitrunner"),
		"gitrunner-1.9.3.ospx");
	Ожидаем.Что(Новый Файл(ОжидаемыйПуть).Существует(), "артефакт должен лежать по каноническому пути").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СохранениеИзФайлаДаетТотЖеРезультат() Экспорт

	ФайлИсточника = ВременныеФайлы.НовоеИмяФайла("bin");
	ДанныеHello().Записать(ФайлИсточника);

	Хранилище = НовоеХранилище();
	Результат = Хранилище.Сохранить(Координаты111(), ФайлИсточника);

	Ожидаем.Что(Результат.Sha256).Равно(ЭталонSha256);
	Ожидаем.Что(Результат.Размер).Равно(5);
	// источник не перемещается, а копируется
	Ожидаем.Что(Новый Файл(ФайлИсточника).Существует(), "файл-источник должен остаться на месте").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПолучитьВозвращаетПутьСИсходнымСодержимым() Экспорт

	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Путь = Хранилище.Получить(Координаты111());

	Ожидаем.Что(Новый Файл(Путь).Существует()).ЭтоИстина();
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь))).Равно("hello");

КонецПроцедуры

&Тест
Процедура ПолучитьДанныеВозвращаетСодержимое() Экспорт

	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Данные = Хранилище.ПолучитьДанные(Координаты111());

	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Данные)).Равно("hello");

КонецПроцедуры

&Тест
Процедура СверкаВернойКонтрольнойСуммыПроходит() Экспорт

	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	// регистр суммы не важен
	Путь = Хранилище.Получить(Координаты111(), ВРег(ЭталонSha256));

	Ожидаем.Что(Новый Файл(Путь).Существует()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СверкаНевернойКонтрольнойСуммыПадает() Экспорт

	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	ОжидатьИсключениеСТекстом(Хранилище, "Получить", Координаты111(),
		СтрЗаменить(ЭталонSha256, "2", "3"), "не совпадает");

КонецПроцедуры

&Тест
Процедура ПолучениеОтсутствующегоАртефактаПадает() Экспорт

	Хранилище = НовоеХранилище();

	ОжидатьИсключениеСТекстом(Хранилище, "Получить", Координаты111(), "", "не найден");
	ОжидатьИсключениеСТекстом(Хранилище, "ПолучитьДанные", Координаты111(), "", "не найден");

КонецПроцедуры

&Тест
Процедура ПустойАртефактНольБайтСохраняетсяКорректно() Экспорт

	Хранилище = НовоеХранилище();

	Результат = Хранилище.Сохранить(Координаты111(), Данные(""));

	// эталонный sha256 пустого содержимого
	Ожидаем.Что(Результат.Sha256)
		.Равно("e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
	Ожидаем.Что(Результат.Размер).Равно(0);
	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоИстина();
	Ожидаем.Что(Хранилище.Размер(Координаты111())).Равно(0);
	Ожидаем.Что(Хранилище.ПолучитьДанные(Координаты111()).Размер()).Равно(0);

КонецПроцедуры

&Тест
Процедура ЮникодноеИмяПакетаСохраняетсяИЧитается() Экспорт

	Хранилище = НовоеХранилище();
	Координаты = Новый КоординатыАртефакта("пул-приватный", "пакет-тест", "1.0.0");

	Хранилище.Сохранить(Координаты, ДанныеHello());

	Ожидаем.Что(Хранилище.Существует(Координаты)).ЭтоИстина();
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Хранилище.ПолучитьДанные(Координаты))).Равно("hello");

КонецПроцедуры

#КонецОбласти

#Область СуществованиеУдалениеРазмер

&Тест
Процедура СуществуетОтражаетНаличиеИУдалениеИдемпотентно() Экспорт

	Хранилище = НовоеХранилище();

	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоЛожь();

	Хранилище.Сохранить(Координаты111(), ДанныеHello());
	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоИстина();

	Хранилище.Удалить(Координаты111());
	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоЛожь();

	// повторное удаление - не ошибка
	Хранилище.Удалить(Координаты111());

КонецПроцедуры

&Тест
Процедура РазмерВозвращаетБайтыАртефакта() Экспорт

	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Ожидаем.Что(Хранилище.Размер(Координаты111())).Равно(5);

КонецПроцедуры

&Тест
Процедура ОсвободитьВыдачуНеУдаляетПостоянныйФайлХранилища() Экспорт

	// критично: у файлового бэкенда Получить отдаёт САМ файл хранилища; парный
	// ОсвободитьВыдачу обязан быть no-op, иначе выдача разрушала бы хранилище
	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Путь = Хранилище.Получить(Координаты111());
	Хранилище.ОсвободитьВыдачу(Путь);

	Ожидаем.Что(Новый Файл(Путь).Существует(), "файл хранилища должен остаться на месте").ЭтоИстина();
	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоИстина();
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Хранилище.ПолучитьДанные(Координаты111()))).Равно("hello");

КонецПроцедуры

&Тест
Процедура РазмерОтсутствующегоАртефактаПадает() Экспорт

	Хранилище = НовоеХранилище();

	БылоИсключение = Ложь;
	Попытка
		Хранилище.Размер(Координаты111());
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;

	Ожидаем.Что(БылоИсключение, "ожидали исключение на размере отсутствующего артефакта").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗанятыйОбъемСуммируетВсеАртефакты() Экспорт

	Хранилище = НовоеХранилище();

	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(0);

	Хранилище.Сохранить(Координаты111(), ДанныеHello());                                   // 5 байт
	Хранилище.Сохранить(Новый КоординатыАртефакта("другой", "пакет", "2.0.0"), Данные("abc")); // 3 байта

	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(8);

	Хранилище.Удалить(Координаты111());
	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(3);

КонецПроцедуры

&Тест
Процедура ОбъёмПулаСчитаетТолькоСвойПулИВесьЕгоКаталог() Экспорт

	Хранилище = НовоеХранилище();

	Ожидаем.Что(Хранилище.ОбъёмПула("пул"), "пула ещё нет — не ошибка, а ноль").Равно(0);

	Хранилище.Сохранить(Координаты111(), ДанныеHello());                                    // 5 байт
	Хранилище.Сохранить(Новый КоординатыАртефакта("пул", "второй", "2.0.0"), Данные("abc")); // 3 байта
	Хранилище.Сохранить(Новый КоординатыАртефакта("чужой", "пакет", "2.0.0"), Данные("xyzw"));

	Ожидаем.Что(Хранилище.ОбъёмПула("пул"), "оба пакета своего пула").Равно(8);
	Ожидаем.Что(Хранилище.ОбъёмПула("чужой"), "соседний пул считается отдельно").Равно(4);

	Хранилище.Удалить(Координаты111());
	Ожидаем.Что(Хранилище.ОбъёмПула("пул"), "удаление освободило место").Равно(3);

КонецПроцедуры

&Тест
Процедура ОбъёмПулаВидитФайлыМимоРаскладкиКоординат() Экспорт

	// «размер папки» — это ВСЁ, что лежит под именем пула: и «входящие», и вложенные
	// каталоги любой глубины, а не только {пакет}/{пакет}-{версия}.ospx
	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Координаты111(), ДанныеHello()); // 5 байт

	ЧужойКаталог = ОбъединитьПути(ОбъединитьПути(КореньДанных, "pools", "пул"), "_вложенное", "глубже");
	СоздатьКаталог(ЧужойКаталог);
	Данные("1234567").Записать(ОбъединитьПути(ЧужойКаталог, "мусор.bin")); // 7 байт

	Ожидаем.Что(Хранилище.ОбъёмПула("пул"), "посторонний файл под пулом тоже занимает место").Равно(12);

КонецПроцедуры

&Тест
Процедура ОбъёмыПуловСнимаютВсеПулыОднимПроходом() Экспорт

	Хранилище = НовоеХранилище();

	Ожидаем.Что(Хранилище.ОбъёмыПулов().Количество(), "пустое хранилище — пустой снимок").Равно(0);

	Хранилище.Сохранить(Координаты111(), ДанныеHello());                                     // пул: 5
	Хранилище.Сохранить(Новый КоординатыАртефакта("пул", "второй", "2.0.0"), Данные("abc")); // пул: +3
	Хранилище.Сохранить(Новый КоординатыАртефакта("чужой", "пакет", "2.0.0"), Данные("xy")); // чужой: 2

	Снимок = Хранилище.ОбъёмыПулов();

	Ожидаем.Что(Снимок.Количество(), "в снимке ровно два пула").Равно(2);
	Ожидаем.Что(Снимок.Получить("пул"), "объём первого пула").Равно(8);
	Ожидаем.Что(Снимок.Получить("чужой"), "объём второго пула").Равно(2);
	Ожидаем.Что(Снимок.Получить("пул"), "снимок согласован с поштучным замером")
		.Равно(Хранилище.ОбъёмПула("пул"));

КонецПроцедуры

&Тест
Процедура ОбъёмПулаОтклоняетИмяВыводящееЗаКорень() Экспорт

	Хранилище = НовоеХранилище();

	ТекстОшибки = "";
	Попытка
		Хранилище.ОбъёмПула("../..");
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(ТекстОшибки, "за пределы корня") > 0,
		"замер по имени с выходом за корень обязан отказать, получили: " + ТекстОшибки).ЭтоИстина();

	Ожидаем.Что(Хранилище.ОбъёмПула(""), "пустое имя — ноль, а не обход корня").Равно(0);

	// опись ходит по тому же имени пула и обязана быть закрыта тем же замком: иначе
	// GC кэша получал бы список файлов ВНЕ корня хранилища
	ОшибкаОписи = "";
	Попытка
		Хранилище.Опись("../..");
	Исключение
		ОшибкаОписи = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(СтрНайти(ОшибкаОписи, "за пределы корня") > 0,
		"опись по имени с выходом за корень обязана отказать, получили: " + ОшибкаОписи).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область АтомарностьИПерезапись

&Тест
Процедура ПослеСохраненияВременныйКаталогПуст() Экспорт

	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Ожидаем.Что(КоличествоВременныхФайлов(), "временные файлы должны убираться после записи").Равно(0);

КонецПроцедуры

&Тест
Процедура ПриОшибкеИсточникаЦелевойФайлНеПоявляетсяИВременныхНет() Экспорт

	Хранилище = НовоеХранилище();

	БылоИсключение = Ложь;
	Попытка
		Хранилище.Сохранить(Координаты111(), ОбъединитьПути(КореньДанных, "нет-такого-файла.bin"));
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;

	Ожидаем.Что(БылоИсключение).ЭтоИстина();
	Ожидаем.Что(Хранилище.Существует(Координаты111()), "артефакт не должен появиться").ЭтоЛожь();
	Ожидаем.Что(КоличествоВременныхФайлов()).Равно(0);

КонецПроцедуры

&Тест
Процедура НеподдерживаемыйТипИсточникаПадаетБезСледовВХранилище() Экспорт

	Хранилище = НовоеХранилище();

	БылоИсключение = Ложь;
	Попытка
		Хранилище.Сохранить(Координаты111(), 12345);
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;

	Ожидаем.Что(БылоИсключение).ЭтоИстина();
	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоЛожь();
	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(0);

КонецПроцедуры

&Тест
Процедура ПерезаписьЗаменяетСодержимоеЦеликом() Экспорт

	Хранилище = НовоеХранилище();
	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Результат = Хранилище.Сохранить(Координаты111(), Данные("новое содержимое"));

	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Хранилище.ПолучитьДанные(Координаты111())))
		.Равно("новое содержимое");
	Ожидаем.Что(Хранилище.Размер(Координаты111())).Равно(Результат.Размер);
	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(Результат.Размер);

КонецПроцедуры

#КонецОбласти

#Область Квоты

&Тест
Процедура ПревышениеКвотыПадаетПонятнойОшибкойИНеОставляетСледов() Экспорт

	Хранилище = НовоеХранилище(8);
	Хранилище.Сохранить(Координаты111(), ДанныеHello()); // 5 из 8 байт

	Вторые = Новый КоординатыАртефакта("пул", "пакет", "2.0.0");

	ТекстОшибки = "";
	Попытка
		Хранилище.Сохранить(Вторые, Данные("1234")); // 5 + 4 > 8
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(ТекстОшибки, "квота") > 0,
		"ожидали понятную ошибку о квоте, получили: " + ТекстОшибки).ЭтоИстина();
	Ожидаем.Что(Хранилище.Существует(Вторые), "артефакт сверх квоты не должен появиться").ЭтоЛожь();
	Ожидаем.Что(КоличествоВременныхФайлов()).Равно(0);
	// первый артефакт цел
	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СохранениеВПределахКвотыПроходит() Экспорт

	Хранилище = НовоеХранилище(8);

	Хранилище.Сохранить(Координаты111(), ДанныеHello()); // 5 из 8
	Хранилище.Сохранить(Новый КоординатыАртефакта("пул", "пакет", "2.0.0"), Данные("123")); // ровно 8

	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(8);

КонецПроцедуры

&Тест
Процедура ПерезаписьУчитываетОсвобождаемыйОбъем() Экспорт

	Хранилище = НовоеХранилище(10);
	Хранилище.Сохранить(Координаты111(), Данные("12345678")); // 8 из 10

	// замена на 9 байт: 8 - 8 + 9 = 9 <= 10 - должна пройти
	Хранилище.Сохранить(Координаты111(), Данные("123456789"));

	Ожидаем.Что(Хранилище.ЗанятыйОбъем()).Равно(9);

КонецПроцедуры

&Тест
Процедура НулеваяКвотаОзначаетБезЛимита() Экспорт

	Хранилище = НовоеХранилище(0);

	Хранилище.Сохранить(Координаты111(), ДанныеHello());

	Ожидаем.Что(Хранилище.Существует(Координаты111())).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОтрицательнаяКвотаОтклоняетсяКакМиссконфигурация() Экспорт

	ТекстОшибки = "";
	Попытка
		Хранилище = НовоеХранилище(-1);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(ТекстОшибки, "квота") > 0,
		"ожидали исключение о некорректной квоте, получили: " + ТекстОшибки).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ЗащитаОтВыходаЗаКорень

&Тест
Процедура КоординатыСОбходомКорняОтклоняютсяХранилищем() Экспорт

	Хранилище = НовоеХранилище();

	// первая линия (валидация КоординатыАртефакта) обойдена фикстурой -
	// хранилище обязано отклонить путь, выходящий за корень
	ОжидатьОтказТраверсал(Хранилище, Новый ПоддельныеКоординаты("..", "..", "1.0.0", "побег.ospx"));
	ОжидатьОтказТраверсал(Хранилище, Новый ПоддельныеКоординаты("пул", "..", "1.0.0", ".."));
	ОжидатьОтказТраверсал(Хранилище,
		Новый ПоддельныеКоординаты("../../../..", "пакет", "1.0.0", "побег.ospx"));

	// снаружи корня ничего не появилось
	Ожидаем.Что(НайтиФайлы(Новый Файл(КореньДанных).Путь, "побег.ospx", Истина).Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура АбсолютныйПутьВКоординатахОтклоняетсяХранилищем() Экспорт

	Хранилище = НовоеХранилище();
	ПутьПобега = ОбъединитьПути(КаталогВременныхФайлов(), "побег-абсолютный.ospx");

	ОжидатьОтказТраверсал(Хранилище,
		Новый ПоддельныеКоординаты("пул", "пакет", "1.0.0", ПутьПобега));
	ОжидатьОтказТраверсал(Хранилище,
		Новый ПоддельныеКоординаты(ПутьПобега, "пакет", "1.0.0", "имя.ospx"));

	Ожидаем.Что(Новый Файл(ПутьПобега).Существует(), "файл вне корня не должен появиться").ЭтоЛожь();

КонецПроцедуры

Процедура ОжидатьОтказТраверсал(Знач Хранилище, Знач Координаты)

	ТекстОшибки = "";
	Попытка
		Хранилище.Сохранить(Координаты, ДанныеHello());
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(ТекстОшибки, "за пределы корня") > 0,
		СтрШаблон("ожидали отказ ""за пределы корня"" на координатах %1, получили: %2",
			Координаты.Представление(), ТекстОшибки))
		.ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебные

Функция НовоеХранилище(Знач Квота = 0)
	Возврат Новый ФайловоеХранилище(КореньДанных, Квота);
КонецФункции

Функция Координаты111()
	Возврат Новый КоординатыАртефакта("пул", "пакет", "1.1.1");
КонецФункции

Функция Данные(Знач Текст)
	// без BOM: sha256 строки "hello" тогда равен общеизвестному эталону
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Текст);
КонецФункции

Функция ДанныеHello()
	Возврат Данные("hello");
КонецФункции

Функция КоличествоВременныхФайлов()

	КаталогВременных = ОбъединитьПути(КореньДанных, "tmp");

	Если НЕ Новый Файл(КаталогВременных).Существует() Тогда
		Возврат 0;
	КонецЕсли;

	Возврат НайтиФайлы(КаталогВременных, "*", Истина).Количество();

КонецФункции

Процедура ОжидатьИсключениеСТекстом(Знач Хранилище, Знач ИмяМетода, Знач Координаты, Знач Сумма, Знач Фрагмент)

	ТекстОшибки = "";
	Попытка
		Если ИмяМетода = "Получить" Тогда
			Хранилище.Получить(Координаты, Сумма);
		Иначе
			Хранилище.ПолучитьДанные(Координаты, Сумма);
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(ТекстОшибки, Фрагмент) > 0,
		СтрШаблон("ожидали исключение с текстом ""%1"", получили: %2", Фрагмент, ТекстОшибки))
		.ЭтоИстина();

КонецПроцедуры

#КонецОбласти
