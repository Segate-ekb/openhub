// Фикстура: выдача свободного TCP-порта тестовым экземплярам хаба.
// Взаимоисключение прогонов — файл-заявка в общем КаталогеВременныхФайлов(); поверх — проба у ОС.

Перем КаталогЗаявок;
Перем Выданные;          // Массив из Число — что выдано этим экземпляром
Перем ГСЧ;
Перем НижняяГраница;
Перем ВерхняяГраница;
Перем ПопытокВыбора;
Перем ЧасовДоУстаревания; // заявка старше — считается брошенной (прогон убит извне)

Процедура ПриСозданииОбъекта() Экспорт

	// Ниже эфемерных диапазонов ОС (Linux 32768+, macOS 49152+).
	НижняяГраница = 20000;
	ВерхняяГраница = 32000;
	ПопытокВыбора = 200;
	ЧасовДоУстаревания = 4;

	ГСЧ = Новый ГенераторСлучайныхЧисел();
	Выданные = Новый Массив();

	КаталогЗаявок = ОбъединитьПути(КаталогВременныхФайлов(), "openhub-заявки-портов");
	Если НЕ Новый Файл(КаталогЗаявок).Существует() Тогда
		СоздатьКаталог(КаталогЗаявок);
	КонецЕсли;

КонецПроцедуры

// Сужает диапазон кандидатов — нужен тестам самой выдачи.
//
// Параметры:
//  Нижняя  - Число - нижняя граница включительно.
//  Верхняя - Число - верхняя граница включительно.
//
Процедура УстановитьДиапазон(Знач Нижняя, Знач Верхняя) Экспорт

	НижняяГраница = Нижняя;
	ВерхняяГраница = Верхняя;

КонецПроцедуры

// Выдаёт свободный порт и удерживает заявку на него до Вернуть()/ВернутьВсе().
// Бросает исключение, если свободный порт не найден за отведённое число попыток.
//
// Возвращаемое значение:
//  Число - номер порта.
//
Функция Выдать() Экспорт

	Для НомерПопытки = 1 По ПопытокВыбора Цикл

		Кандидат = ГСЧ.СлучайноеЧисло(НижняяГраница, ВерхняяГраница);

		Если НЕ ЗанятьЗаявку(Кандидат) Тогда
			Продолжить;
		КонецЕсли;

		Если СвободенПоМнениюОС(Кандидат) Тогда
			Выданные.Добавить(Кандидат);
			Возврат Кандидат;
		КонецЕсли;

		// порт держит чужой процесс — заявку снимаем, чтобы не копить мусор
		ОсвободитьЗаявку(Кандидат);

	КонецЦикла;

	ВызватьИсключение СтрШаблон(
		"Не удалось найти свободный порт в диапазоне %1..%2 за %3 попыток"
		+ " (заявки: %4). Похоже, машина забита осиротевшими хабами.",
		НижняяГраница, ВерхняяГраница, ПопытокВыбора, КаталогЗаявок);

КонецФункции

// Снимает заявку на СВОЙ порт и возвращает его в оборот. Чужой порт игнорируется,
// повторный вызов безопасен.
//
// Параметры:
//  НомерПорта - Число - ранее выданный порт.
//
Процедура Вернуть(Знач НомерПорта) Экспорт

	Индекс = Выданные.Найти(НомерПорта);

	Если Индекс = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Выданные.Удалить(Индекс);
	ОсвободитьЗаявку(НомерПорта);

КонецПроцедуры

// Возвращает в оборот все порты, выданные этим экземпляром.
//
Процедура ВернутьВсе() Экспорт

	Пока Выданные.Количество() > 0 Цикл
		Вернуть(Выданные[0]);
	КонецЦикла;

КонецПроцедуры

// Путь файла-заявки на порт.
//
// Параметры:
//  НомерПорта - Число - номер порта.
//
// Возвращаемое значение:
//  Строка - полный путь файла заявки.
//
Функция ПутьЗаявки(Знач НомерПорта) Экспорт

	Возврат ОбъединитьПути(КаталогЗаявок, Формат(НомерПорта, "ЧГ=0; ЧН=0") + ".заявка");

КонецФункции

#Область Служебное

// Атомарно создаёт файл-заявку. Истина — заявка наша.
Функция ЗанятьЗаявку(Знач НомерПорта)

	Путь = ПутьЗаявки(НомерПорта);

	Если НЕ СоздатьЭксклюзивно(Путь) Тогда
		// Заявка чужая; брошенную (прогон убит извне) перехватываем.
		Если НЕ ЗаявкаУстарела(Путь) Тогда
			Возврат Ложь;
		КонецЕсли;
		Попытка
			УдалитьФайлы(Путь);
		Исключение
			Возврат Ложь;
		КонецПопытки;
		Если НЕ СоздатьЭксклюзивно(Путь) Тогда
			Возврат Ложь; // кто-то опередил — не наш порт
		КонецЕсли;
	КонецЕсли;

	Попытка
		Запись = Новый ЗаписьТекста(Путь, "UTF-8");
		Запись.ЗаписатьСтроку(СтрШаблон("порт=%1 прогон=%2 время=%3",
			НомерПорта, ТекущийСценарий().Источник, ТекущаяДата()));
		Запись.Закрыть();
	Исключение
		// содержимое заявки — только для диагностики; сама заявка уже наша
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Создание файла режимом O_EXCL: второй процесс получает исключение.
// Единственная межпроцессная взаимоблокировка в чистом OneScript (СоздатьКаталог молча проходит).
Функция СоздатьЭксклюзивно(Знач Путь)

	Попытка
		Поток = Новый ФайловыйПоток(Путь, РежимОткрытияФайла.СоздатьНовый);
		Поток.Закрыть();
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат Истина;

КонецФункции

Функция ЗаявкаУстарела(Знач Путь)

	Попытка
		Файл = Новый Файл(Путь);
		Если НЕ Файл.Существует() Тогда
			Возврат Истина;
		КонецЕсли;
		Возврат Файл.ПолучитьВремяИзменения() < ТекущаяДата() - ЧасовДоУстаревания * 3600;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Процедура ОсвободитьЗаявку(Знач НомерПорта)

	Попытка
		Путь = ПутьЗаявки(НомерПорта);
		Если Новый Файл(Путь).Существует() Тогда
			УдалитьФайлы(Путь);
		КонецЕсли;
	Исключение
		// снять заявку не удалось — она устареет по времени и будет перехвачена
	КонецПопытки;

КонецПроцедуры

// Проба у ОС: реально ли порт свободен прямо сейчас.
Функция СвободенПоМнениюОС(Знач НомерПорта)

	Попытка
		Сервер = Новый TCPСервер(НомерПорта);
		Сервер.Запустить();
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Попытка
		Сервер.Остановить();
	Исключение
		Возврат Ложь; // не смогли освободить — отдавать такой порт нельзя
	КонецПопытки;

	Возврат Истина;

КонецФункции

#КонецОбласти
