// Заглушка ЗащитыCSRF: токен сессии предсказуем, проверка задаётся тестом.

Перем Проходит_;

// Проверяет токен формы.
//
// Параметры:
//  Сессия - Произвольный - сессия запроса.
//  Токен - Строка - токен из формы.
//
// Возвращаемое значение:
//  Булево.
//
Функция Проверить(Знач Сессия, Знач Токен) Экспорт
	Сессия = Сессия;
	Токен = Токен;
	Возврат Проходит_;
КонецФункции

// Токен сессии для формы.
//
// Параметры:
//  Сессия - Произвольный - сессия запроса.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТокенСессии(Знач Сессия) Экспорт
	Сессия = Сессия;
	Возврат "токен-теста";
КонецФункции

// Имя скрытого поля токена.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоля() Экспорт
	Возврат "_csrf";
КонецФункции

// Задаёт исход проверки токена.
//
// Параметры:
//  Значение - Булево - проходит ли проверка.
//
Процедура ЗадатьИсход(Знач Значение) Экспорт
	Проходит_ = Значение;
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Проходит_ = Истина;
КонецПроцедуры
