// Окружение проводника первой публикации, не ходящее в базу: гвард впускает пользователя,
// онбординг пройден, у пользователя один пул с правом записи, токенов и версий нет, адреса
// домов — образцы, страница отдаётся без обрамления.

Перем ПулПубликации; // единственный пул, куда пользователь может публиковать

#Область НаполнениеФикстуры

// Назначает пул, в который пользователь может публиковать.
//
// Параметры:
//  Пул - Произвольный - пул с разрешённой публикацией.
//
Процедура ДатьПулПубликации(Знач Пул) Экспорт
	ПулПубликации = Пул;
КонецПроцедуры

#КонецОбласти

#Область ГвардИСтраница

// Пользователь впущен в кабинет.
//
// Параметры:
//  Ответ - Произвольный - ответ сервера, заглушкой не трогается.
//  ЗаголовкиЗапроса - Произвольный - заголовки, заглушкой не трогаются.
//  КукиЗапроса - Произвольный - куки, заглушкой не трогаются.
//
// Возвращаемое значение:
//  Структура - Разрешено, Пользователь.
//
Функция Проверить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса) Экспорт

	Ответ = Ответ;
	ЗаголовкиЗапроса = ЗаголовкиЗапроса;
	КукиЗапроса = КукиЗапроса;

	Пользователь = Новый Структура("Идентификатор, Логин", 7, "alice");
	Возврат Новый Структура("Разрешено, Пользователь", Истина, Пользователь);

КонецФункции

// Страница кабинета без обрамления: проверяется содержимое, а не каркас.
//
// Параметры:
//  Заголовок - Строка - заголовок страницы.
//  Содержимое - Строка - тело страницы.
//  Контекст - Произвольный - контекст запроса.
//
// Возвращаемое значение:
//  Строка - тело как есть.
//
Функция Страница(Знач Заголовок, Знач Содержимое, Знач Контекст) Экспорт
	Заголовок = Заголовок;
	Контекст = Контекст;
	Возврат Содержимое;
КонецФункции

// Контекст страницы кабинета; окружению он безразличен.
//
// Параметры:
//  Пользователь - Произвольный - смотрящий.
//  КукиЗапроса - Произвольный - куки.
//  ПоказатьАдмин - Булево - показывать ли админские дороги.
//  Путь - Строка - адрес открытого экрана.
//
// Возвращаемое значение:
//  Неопределено.
//
Функция КонтекстСтраницы(Знач Пользователь, Знач КукиЗапроса, Знач ПоказатьАдмин, Знач Путь) Экспорт
	Пользователь = Пользователь;
	КукиЗапроса = КукиЗапроса;
	ПоказатьАдмин = ПоказатьАдмин;
	Путь = Путь;
	Возврат Неопределено;
КонецФункции

#КонецОбласти

#Область ОнбордингПулыИПрава

// Онбординг пройден: администратор в хабе уже есть.
//
// Возвращаемое значение:
//  Булево - Ложь.
//
Функция НуженОнбординг() Экспорт
	Возврат Ложь;
КонецФункции

// Пулы хаба — только назначенный пул публикации.
//
// Возвращаемое значение:
//  Массив из Произвольный - пулы.
//
Функция ВсеПулы() Экспорт

	Результат = Новый Массив();
	Если ПулПубликации <> Неопределено Тогда
		Результат.Добавить(ПулПубликации);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Разрешена ли публикация в пул — как объявлено у самого пула.
//
// Параметры:
//  Пул - Произвольный - пул.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПубликацияРазрешена(Знач Пул) Экспорт
	Возврат Пул.ПубликацияРазрешена;
КонецФункции

// Пользователь — не администратор: пул ему даёт право записи.
//
// Параметры:
//  Пользователь - Произвольный - пользователь, заглушкой не трогается.
//
// Возвращаемое значение:
//  Булево - Ложь.
//
Функция ПользовательАдмин(Знач Пользователь) Экспорт
	Пользователь = Пользователь;
	Возврат Ложь;
КонецФункции

// Право записи есть в любой пул окружения.
//
// Параметры:
//  Пользователь - Произвольный - пользователь, заглушкой не трогается.
//  Пул - Произвольный - пул, заглушкой не трогается.
//
// Возвращаемое значение:
//  Булево - Истина.
//
Функция МожетПисать(Знач Пользователь, Знач Пул) Экспорт
	Пользователь = Пользователь;
	Пул = Пул;
	Возврат Истина;
КонецФункции

#КонецОбласти

#Область ТокеныИВерсии

// Токенов у пользователя ещё нет.
//
// Параметры:
//  Идентификатор - Произвольный - идентификатор пользователя, заглушкой не трогается.
//
// Возвращаемое значение:
//  Массив - пустой.
//
Функция ТокеныПользователя(Знач Идентификатор) Экспорт
	Идентификатор = Идентификатор;
	Возврат Новый Массив();
КонецФункции

// Действующего ключа доступа у пользователя нет — как нет и самих токенов.
//
// Параметры:
//  Идентификатор - Произвольный - идентификатор владельца, заглушкой не трогается.
//
// Возвращаемое значение:
//  Булево - Ложь.
//
Функция ЕстьДействующийКлюч(Знач Идентификатор) Экспорт
	Идентификатор = Идентификатор;
	Возврат Ложь;
КонецФункции

// Своих версий у пользователя ещё нет.
//
// Параметры:
//  Идентификатор - Произвольный - идентификатор публиковавшего, заглушкой не трогается.
//
// Возвращаемое значение:
//  Булево - Ложь.
//
Функция ЕстьВерсииПубликатораВХабе(Знач Идентификатор) Экспорт
	Идентификатор = Идентификатор;
	Возврат Ложь;
КонецФункции

#КонецОбласти

#Область АдресаДомов

// Адрес настроек пула.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Строка - образец адреса.
//
Функция АдресПула(Знач ИмяПула) Экспорт
	Возврат "/" + ИмяПула + "/settings";
КонецФункции

// Адрес раздела настроек аккаунта.
//
// Параметры:
//  Раздел - Строка - имя раздела.
//
// Возвращаемое значение:
//  Строка - образец адреса.
//
Функция АдресРаздела(Знач Раздел) Экспорт
	Возврат "/me/settings/" + Раздел;
КонецФункции

#КонецОбласти
