// Фейк СервисаЗеркал для очереди и фонового рабочего: системные чтения записей
// и отметка «прогон поставлен».

Перем Записи;  // Массив из Структура
Перем Заявки;  // Массив из Структура — вызовы ПоставитьПрогон в порядке поступления
Перем ИдущиеПрогоны; // Соответствие: ид зеркала -> Булево (прогон по записи)
Перем Отметки;       // Соответствие: ид зеркала -> Дата последней отметки прогресса

// Заводит запись зеркала.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//  Включено - Булево - признак включённости (необязательный, по умолчанию Истина).
//
Процедура Добавить(Знач Идентификатор, Знач Включено = Истина) Экспорт
	Записи.Добавить(Новый Структура("Идентификатор, Включено, Режим, АпстримURL",
		Цел(Идентификатор), Включено = Истина, "opm", "https://example.org/download/"));
КонецПроцедуры

// Убирает запись — зеркало, удалённое, пока заявка ждала в очереди.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//
Процедура Убрать(Знач Идентификатор) Экспорт
	Для Каждого Запись Из Записи Цикл
		Если Запись.Идентификатор = Цел(Идентификатор) Тогда
			Записи.Удалить(Записи.Найти(Запись));
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Запись зеркала по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если записи нет.
//
Функция ПоИдентификатору(Знач Идентификатор) Экспорт
	Для Каждого Запись Из Записи Цикл
		Если Запись.Идентификатор = Цел(Идентификатор) Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Все включённые зеркала хаба.
//
// Возвращаемое значение:
//  Массив из Структура.
//
Функция ВключённыеЗеркала() Экспорт
	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Если Запись.Включено = Истина Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Контракт службы: пометить прогон зеркала поставленным.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//  Запустил - Строка - логин инициатора (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Булево - Истина: фейк постановку не отклоняет.
//
Функция ПоставитьПрогон(Знач Идентификатор, Знач Запустил = "") Экспорт
	Заявки.Добавить(Новый Структура("Идентификатор, Запустил",
		Цел(Идентификатор), СокрЛП(Строка(Запустил))));
	Возврат Истина;
КонецФункции

// Контракт службы: порог, после которого молчащий прогон считается брошенным.
// Боевое значение по умолчанию — тесты двигают часы, а не порог.
//
// Возвращаемое значение:
//  Число - секунды.
//
Функция ПорогЗависанияПрогона() Экспорт
	Возврат 900;
КонецФункции

// Контракт службы: ведёт ли прогон зеркала кто-то по ЗАПИСИ. Задаётся тестом —
// так воспроизводится прогон, начатый прошлым запуском хаба.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПрогонИдёт(Знач Идентификатор) Экспорт
	Возврат ИдущиеПрогоны.Получить(Цел(Идентификатор)) = Истина;
КонецФункции

// Объявляет прогон зеркала идущим по записи.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//  Значение - Булево - новое состояние (необязательный, по умолчанию Истина).
//  Обновлён - Дата - момент последней отметки прогресса; Неопределено — «только что»
//             (необязательный, по умолчанию Неопределено).
//
Процедура ЗадатьИдущийПрогон(Знач Идентификатор, Знач Значение = Истина,
	Знач Обновлён = Неопределено) Экспорт
	ИдущиеПрогоны.Вставить(Цел(Идентификатор), Значение = Истина);
	Отметки.Вставить(Цел(Идентификатор),
		?(Обновлён = Неопределено, ТекущаяУниверсальнаяДата(), Обновлён));
КонецПроцедуры

// Контракт службы: состояние прогона по записи. Отказ заявке называет по нему цифры —
// сколько прогон молчит и сколько осталось до отвисания.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//
// Возвращаемое значение:
//  Структура, Неопределено - Обновлён (Дата); Неопределено, если о прогоне ничего не известно.
//
Функция СостояниеПрогона(Знач Идентификатор) Экспорт
	Отметка = Отметки.Получить(Цел(Идентификатор));
	Возврат ?(Отметка = Неопределено, Неопределено, Новый Структура("Обновлён", Отметка));
КонецФункции

// Заявки на прогон, дошедшие до службы.
//
// Возвращаемое значение:
//  Массив из Структура - Идентификатор (Число), Запустил (Строка).
//
Функция ЗаявкиПрогона() Экспорт
	Возврат Заявки;
КонецФункции

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	Заявки = Новый Массив();
	ИдущиеПрогоны = Новый Соответствие();
	Отметки = Новый Соответствие();
КонецПроцедуры
