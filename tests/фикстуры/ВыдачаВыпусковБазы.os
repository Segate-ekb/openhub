// Фикстура ТранспортHTTP для обновления базы стран: на каждый адрес свой ответ, а тело —
// двоичные данные. Строкового фейка тут мало: выпуск базы приезжает gzip-ом, и строкой
// его не изобразить.

Перем Ответы;     // Соответствие: URL -> Структура(Код, Данные)
Перем Спрошено;   // Массив из Строка - адреса всех вызовов по порядку
Перем Ломается;

#Область ЧтоОтдавать

// Задаёт ответ на запрос по адресу.
//
// Параметры:
//  URL - Строка - адрес выпуска.
//  Код - Число - код состояния.
//  Данные - ДвоичныеДанные - тело ответа; Неопределено — пустое тело.
//
Процедура ПриАдресе(Знач URL, Знач Код, Знач Данные = Неопределено) Экспорт
	Ответы.Вставить(Строка(URL), Новый Структура("Код, Данные", Код, Данные));
КонецПроцедуры

// Переводит фейк в режим сетевого сбоя: любой вызов бросит исключение.
//
Процедура Ломаться() Экспорт
	Ломается = Истина;
КонецПроцедуры

#КонецОбласти

#Область ЧтоСпрашивали

// Адреса всех запросов по порядку.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Спрошенное() Экспорт
	Возврат Спрошено;
КонецФункции

// Сколько раз транспорт спрашивали вообще.
//
// Возвращаемое значение:
//  Число.
//
Функция ВсегоЗапросов() Экспорт
	Возврат Спрошено.Количество();
КонецФункции

#КонецОбласти

// Контракт ТранспортHTTP. Незаданный адрес отвечает 404: у издателя базы так и выглядит
// выпуск месяца, которого ещё нет.
//
// Параметры:
//  URL - Строка - адрес запроса.
//  Заголовки - Соответствие - заголовки запроса (необязательный, по умолчанию Неопределено).
//  ТаймаутСек - Число - таймаут (необязательный, по умолчанию 20).
//  ПроверятьSSL - Булево - проверка сертификата (необязательный, по умолчанию Истина).
//  РазрешитьПеренаправление - Булево - идти ли по Location (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура - Код, Заголовки, Данные.
//
Функция Получить(Знач URL, Знач Заголовки = Неопределено, Знач ТаймаутСек = 20,
	Знач ПроверятьSSL = Истина, Знач РазрешитьПеренаправление = Ложь) Экспорт

	Спрошено.Добавить(Строка(URL));
	Если Ломается Тогда
		ВызватьИсключение "эмуляция сетевого сбоя при скачивании выпуска базы";
	КонецЕсли;

	Ответ = Ответы.Получить(Строка(URL));
	Если Ответ = Неопределено Тогда
		Возврат Новый Структура("Код, Заголовки, Данные", 404, Новый Соответствие(), Неопределено);
	КонецЕсли;

	Возврат Новый Структура("Код, Заголовки, Данные", Ответ.Код, Новый Соответствие(), Ответ.Данные);

КонецФункции

// Контракт ТранспортHTTP: POST выпускам базы не нужен, но желудь обязан его иметь.
//
// Параметры:
//  URL - Строка - адрес запроса.
//  Тело - Произвольный - тело запроса.
//  Заголовки - Соответствие - заголовки (необязательный, по умолчанию Неопределено).
//  ТаймаутСек - Число - таймаут (необязательный, по умолчанию 20).
//  ПроверятьSSL - Булево - проверка сертификата (необязательный, по умолчанию Истина).
//
// Возвращаемое значение:
//  Структура - Код, Заголовки, Данные.
//
Функция Отправить(Знач URL, Знач Тело, Знач Заголовки = Неопределено, Знач ТаймаутСек = 20,
	Знач ПроверятьSSL = Истина) Экспорт
	Возврат Получить(URL, Заголовки, ТаймаутСек, ПроверятьSSL, Ложь);
КонецФункции

&Прозвище("ТранспортHTTP")
&Желудь
Процедура ПриСозданииОбъекта()
	Ответы = Новый Соответствие();
	Спрошено = Новый Массив();
	Ломается = Ложь;
КонецПроцедуры
