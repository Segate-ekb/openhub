// ХранилищеПравДоступа в памяти, считающее обращения. Обе двери на месте: точечный
// «грант на объект» (через него цена росла числом объектов) и разрез «все гранты субъекта».

Перем Гранты;   // Массив из Структура (ТипСубъекта, СубъектИдентификатор, ТипОбъекта, ОбъектИдентификатор, Создание, Изменение, Удаление, Чтение)
Перем Счётчик;   // СчётчикОбращений — счёт обращений к фикстуре

// Сколько раз хранилище спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Заводит грант (за обращение не считается).
//
// Параметры:
//  ТипСубъекта - Строка - пользователь либо группа.
//  СубъектИдентификатор - Число - идентификатор субъекта.
//  ТипОбъекта - Строка - хаб, пул либо пакет.
//  ОбъектИдентификатор - Число - идентификатор объекта.
//  Действия - Строка - действия через запятую: создание, изменение, удаление, чтение.
//
Процедура Добавить(Знач ТипСубъекта, Знач СубъектИдентификатор, Знач ТипОбъекта,
	Знач ОбъектИдентификатор, Знач Действия) Экспорт

	Набор = Новый Соответствие();
	Для Каждого Действие Из СтрРазделить(Строка(Действия), ",") Цикл
		Набор.Вставить(НРег(СокрЛП(Действие)), Истина);
	КонецЦикла;

	Гранты.Добавить(Новый Структура(
		"ТипСубъекта, СубъектИдентификатор, ТипОбъекта, ОбъектИдентификатор,"
			+ " Создание, Изменение, Удаление, Чтение",
		ТипСубъекта, Цел(СубъектИдентификатор), ТипОбъекта, Цел(ОбъектИдентификатор),
		Набор.Получить("создание") = Истина, Набор.Получить("изменение") = Истина,
		Набор.Получить("удаление") = Истина, Набор.Получить("чтение") = Истина));

КонецПроцедуры

// Грант субъекта на объект; считает обращение.
//
// Параметры:
//  ТипСубъекта - Строка.
//  СубъектИдентификатор - Число.
//  ТипОбъекта - Строка.
//  ОбъектИдентификатор - Число.
//
// Возвращаемое значение:
//  Структура, Неопределено - найденный грант.
//
Функция НайтиГрант(Знач ТипСубъекта, Знач СубъектИдентификатор, Знач ТипОбъекта,
	Знач ОбъектИдентификатор) Экспорт

	Счётчик.Отметить();

	Для Каждого Грант Из Гранты Цикл
		Если Грант.ТипСубъекта = ТипСубъекта
			И Грант.СубъектИдентификатор = Цел(СубъектИдентификатор)
			И Грант.ТипОбъекта = ТипОбъекта
			И Грант.ОбъектИдентификатор = Цел(ОбъектИдентификатор) Тогда
			Возврат Грант;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Все гранты субъекта; считает обращение.
//
// Параметры:
//  ТипСубъекта - Строка.
//  СубъектИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив - гранты субъекта.
//
Функция ГрантыСубъекта(Знач ТипСубъекта, Знач СубъектИдентификатор) Экспорт

	Счётчик.Отметить();

	Результат = Новый Массив();
	Для Каждого Грант Из Гранты Цикл
		Если Грант.ТипСубъекта = ТипСубъекта
			И Грант.СубъектИдентификатор = Цел(СубъектИдентификатор) Тогда
			Результат.Добавить(Грант);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ПриСозданииОбъекта()
	Гранты = Новый Массив();
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
