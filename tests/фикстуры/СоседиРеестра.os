// Фикстура: обязательные соседи реестра для частичного контейнера, в котором заводят пул или чистят
// пакет, — гейт адреса апстрима, правило токена источника, занятость имени логином и скачивания пакета.

// Подключает классы, без которых реестр в частичном контейнере не заводит пул, источник пула
// и не удаляет пакет: SSRF-гейт адреса и правило токена источника (СервисАпстримовПула требует
// их обязательно), ответ входа «занято ли имя логином» с таблицей учёток и дверь статистики,
// которой уборка пакета снимает скачивания. Модули подписки, прокси, вход и статистика целиком
// тянуть нельзя.
//
// Параметры:
//  КаталогМодулей - Строка - путь к src/модули; пусто — модули этого репозитория
//                   (необязательный, по умолчанию "").
//
Процедура Подключить(Знач КаталогМодулей = "") Экспорт

	Модули = ?(ЗначениеЗаполнено(КаталогМодулей), КаталогМодулей, КаталогиПроекта.Модули());
	КаталогВебхуков = ОбъединитьПути(Модули, "подписки", "Классы");
	КаталогРеестра = ОбъединитьПути(Модули, "реестр", "Классы");
	КаталогCommon = ОбъединитьПути(Модули, "основа", "Классы");
	КаталогПрокси = ОбъединитьПути(Модули, "прокси", "Классы");
	КаталогСети = ОбъединитьПути(Модули, "сеть", "Классы");
	КаталогВхода = ОбъединитьПути(Модули, "вход", "Классы");
	КаталогСтатистики = ОбъединитьПути(Модули, "статистика", "Классы");

	// Приведения — общие помощники основы: их просят настройки и соседи заведения источника.
	Подключить1(КаталогCommon, "ПриведениеЧисел");
	Подключить1(КаталогCommon, "ПриведениеФлагов");
	Подключить1(КаталогCommon, "РазборАдреса");
	// строка становится адресом и сетью только в каноне: его просит политика своей сети
	Подключить1(КаталогCommon, "КанонIP");
	Подключить1(КаталогВебхуков, "ВалидаторАдресаВебхука");
	Подключить1(КаталогРеестра, "ВалидаторАдресаАпстрима");
	// одно определение своей сети на хаб: без политики страж издателей CI не выдаёт разрешений
	Подключить1(КаталогСети, "СвояСеть");
	Подключить1(КаталогПрокси, "СекретИсточника");
	Подключить1(КаталогПрокси, "ЗаведениеИсточникаСПробой");

	// имена пулов и логины делят одно пространство: без ответа входа пул не заводится
	Подключить1(КаталогВхода, "Пользователь");
	Подключить1(КаталогВхода, "ХранилищеПользователей");
	Подключить1(КаталогВхода, "ЗанятостьИмениЛогином");

	// агрегаты скачиваний пакета: без двери статистики пакет не удаляется
	Подключить1(КаталогСтатистики, "СкачиваниеАгрегат");
	Подключить1(КаталогСтатистики, "ХранилищеСкачиванийАгрегатов");
	Подключить1(КаталогСтатистики, "СкачиванияПакетов");

КонецПроцедуры

// Файл ищется по имени в каталоге и подкаталогах: уехавший в подкаталог класс иначе молча теряется.
Процедура Подключить1(Знач Каталог, Знач ИмяКласса)
	Если ТипЗарегистрирован(ИмяКласса) Тогда
		Возврат;
	КонецЕсли;
	Найденные = НайтиФайлы(Каталог, ИмяКласса + ".os", Истина);
	Если Найденные.Количество() <> 1 Тогда
		ВызватьИсключение СтрШаблон("Класс %1 в %2 найден %3 раз(а), ожидался ровно один",
			ИмяКласса, Каталог, Найденные.Количество());
	КонецЕсли;
	ПодключитьСценарий(Найденные[0].ПолноеИмя, ИмяКласса);
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Процедура ПриСозданииОбъекта()
КонецПроцедуры
