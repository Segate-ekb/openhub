// Заглушка СервисПользователей: считает пользователей и запоминает вызов СоздатьПользователя;
// учётки с исходом личного пространства заводит ДобавитьУчётку, учётки с признаком Админ — ОтвечатьУчётками.

Перем КоличествоПользователей Экспорт;
Перем ПоследнийСозданный Экспорт;   // Структура вызова СоздатьПользователя либо Неопределено
Перем Учётки_;                      // Массив из Структура — учётки ДобавитьУчётку
Перем ИсходыПространств_;           // Соответствие: логин -> исход ОбеспечитьЛичныйПул
Перем Админы_;                      // Соответствие: идентификатор -> Истина; Неопределено — учёток нет
Перем Нечитаемая_;                  // Число - учётка, чтение которой отказывает; 0 — отказов нет
Перем Чтения_;                      // СчётчикОбращений — обращения к ПоИдентификатору и ПоИдентификаторам

// Число пользователей, заданное фикстурой.
//
// Возвращаемое значение:
//  Число - количество пользователей.
//
Функция ВсегоПользователей() Экспорт
	Возврат КоличествоПользователей;
КонецФункции

// Есть ли хоть одна учётка при заданном фикстурой количестве.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьХотяБыОднаУчётка() Экспорт
	Возврат КоличествоПользователей > 0;
КонецФункции

// Запоминает вызов в ПоследнийСозданный и увеличивает счётчик пользователей.
//
// Параметры:
//  Логин                - Строка - логин пользователя.
//  Email                - Строка - адрес почты (необязательный, по умолчанию "").
//  Пароль               - Строка - пароль (необязательный, по умолчанию "").
//  РольХаба             - Строка - роль в хабе (необязательный, по умолчанию "user").
//  ТребуетсяСменаПароля - Булево - признак смены пароля (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура - Идентификатор, Логин, РольХаба.
//
Функция СоздатьПользователя(Знач Логин, Знач Email = "", Знач Пароль = "",
	Знач РольХаба = "user", Знач ТребуетсяСменаПароля = Ложь) Экспорт

	ПоследнийСозданный = Новый Структура();
	ПоследнийСозданный.Вставить("Логин", Логин);
	ПоследнийСозданный.Вставить("Email", Email);
	ПоследнийСозданный.Вставить("Пароль", Пароль);
	ПоследнийСозданный.Вставить("Роль", РольХаба);
	ПоследнийСозданный.Вставить("СменаПароля", ТребуетсяСменаПароля);

	КоличествоПользователей = КоличествоПользователей + 1;

	Возврат Новый Структура("Идентификатор, Логин, РольХаба", 1, Логин, РольХаба);

КонецФункции

// Каноническое имя роли администратора хаба.
//
// Возвращаемое значение:
//  Строка.
//
Функция РольАдмин() Экспорт
	Возврат "admin";
КонецФункции

// Каноническое имя роли обычного пользователя.
//
// Возвращаемое значение:
//  Строка.
//
Функция РольПользователь() Экспорт
	Возврат "user";
КонецФункции

// Поиск пользователя по идентификатору: «нет», пока не включён ОтвечатьУчётками.
//
// Параметры:
//  Идентификатор - Число - идентификатор пользователя.
//
// Возвращаемое значение:
//  Структура, Неопределено - Идентификатор (Число), Админ (Булево); без ОтвечатьУчётками — Неопределено.
//
Функция ПоИдентификатору(Знач Идентификатор) Экспорт
	Если Админы_ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Чтения_.Отметить();
	ОтказатьЕслиНечитаемая(Цел(Идентификатор));
	Возврат УчёткаСПризнаком(Идентификатор);
КонецФункции

// Поиск учёток списком: пустой разрез, пока не включён ОтвечатьУчётками.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пользователей.
//
// Возвращаемое значение:
//  Соответствие - ключ Число, значение Структура (Идентификатор, Админ).
//
Функция ПоИдентификаторам(Знач Идентификаторы) Экспорт
	Результат = Новый Соответствие();
	Если Админы_ = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Чтения_.Отметить();
	Для Каждого Идентификатор Из Идентификаторы Цикл
		ОтказатьЕслиНечитаемая(Цел(Идентификатор));
		Результат.Вставить(Цел(Идентификатор), УчёткаСПризнаком(Идентификатор));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Включает ответы учётками: по любому идентификатору — учётка с признаком Админ.
//
// Параметры:
//  АдминыCSV - Строка - идентификаторы администраторов через запятую; пусто — админов нет.
//
Процедура ОтвечатьУчётками(Знач АдминыCSV) Экспорт
	Админы_ = Новый Соответствие();
	Для Каждого Элемент Из СтрРазделить(Строка(АдминыCSV), ",") Цикл
		Если ЗначениеЗаполнено(СокрЛП(Элемент)) Тогда
			Админы_.Вставить(Число(СокрЛП(Элемент)), Истина);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Делает учётку нечитаемой: точечное чтение о ней падает, разрез — целиком, если она в списке.
//
// Параметры:
//  Идентификатор - Число - учётка, чтение которой отказывает; 0 снимает отказ.
//
Процедура ПадатьНаУчётке(Знач Идентификатор) Экспорт
	Нечитаемая_ = Цел(Идентификатор);
КонецПроцедуры

// Сколько раз спросили учётки по идентификаторам с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Чтений() Экспорт
	Возврат Чтения_.Обращений();
КонецФункции

// Заводит учётку с заданным исходом обеспечения личного пространства.
//
// Параметры:
//  Логин - Строка - логин учётки.
//  ИсходПространства - Строка - что ответит ОбеспечитьЛичныйПул
//                      (необязательный, по умолчанию ИтогСоздан()).
//
// Возвращаемое значение:
//  Структура - Идентификатор, Логин.
//
Функция ДобавитьУчётку(Знач Логин, Знач ИсходПространства = "создан") Экспорт
	Учётка = Новый Структура("Идентификатор, Логин", Учётки_.Количество() + 1, Логин);
	Учётки_.Добавить(Учётка);
	ИсходыПространств_.Вставить(Логин, ИсходПространства);
	Возврат Учётка;
КонецФункции

// Учётки, заведённые ДобавитьУчётку.
//
// Возвращаемое значение:
//  Массив из Структура.
//
Функция ВсеПользователи() Экспорт
	Возврат Учётки_;
КонецФункции

// Исход, заданный учётке при ДобавитьУчётку.
//
// Параметры:
//  Пользователь - Структура - учётка.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОбеспечитьЛичныйПул(Знач Пользователь) Экспорт
	Возврат ИсходыПространств_.Получить(Пользователь.Логин);
КонецФункции

// Исход «пространство заведено».
//
// Возвращаемое значение:
//  Строка.
//
Функция ИтогСоздан() Экспорт
	Возврат "создан";
КонецФункции

// Исход «пространство уже было».
//
// Возвращаемое значение:
//  Строка.
//
Функция ИтогБыло() Экспорт
	Возврат "был";
КонецФункции

// Исход «имя логина носит чужой пул».
//
// Возвращаемое значение:
//  Строка.
//
Функция ИтогИмяЗанято() Экспорт
	Возврат "занято";
КонецФункции

// Исход «пространство не полагается».
//
// Возвращаемое значение:
//  Строка.
//
Функция ИтогПропущен() Экспорт
	Возврат "пропущен";
КонецФункции

// Исход «попытка сорвалась».
//
// Возвращаемое значение:
//  Строка.
//
Функция ИтогОшибка() Экспорт
	Возврат "ошибка";
КонецФункции

Процедура ОтказатьЕслиНечитаемая(Знач Идентификатор)
	Если Нечитаемая_ > 0 И Идентификатор = Нечитаемая_ Тогда
		ВызватьИсключение "Учётка недоступна: " + Формат(Идентификатор, "ЧН=0; ЧГ=0");
	КонецЕсли;
КонецПроцедуры

Функция УчёткаСПризнаком(Знач Идентификатор)
	Возврат Новый Структура("Идентификатор, Админ",
		Цел(Идентификатор), Админы_.Получить(Цел(Идентификатор)) = Истина);
КонецФункции

Процедура ПриСозданииОбъекта() Экспорт
	КоличествоПользователей = 0;
	ПоследнийСозданный = Неопределено;
	Учётки_ = Новый Массив();
	ИсходыПространств_ = Новый Соответствие();
	Админы_ = Неопределено;
	Нечитаемая_ = 0;
	РеестрФикстур.Подключить("СчётчикОбращений");
	Чтения_ = Новый СчётчикОбращений();
КонецПроцедуры
