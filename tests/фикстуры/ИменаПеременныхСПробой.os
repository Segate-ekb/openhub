// Фикстура: список псевдонимов хаба плюс один пробный, которого загрузка настроек в глаза
// не видела, — чтобы доказать, что загрузка ходит по списку, а не по своим ключам.

Перем Настоящие;   // ИменаПеременныхОкружения (настройки)
Перем Проба;       // Структура — описание пробного псевдонима

// Имя переменной ключа; у пробной цели — имя пробного псевдонима.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - имя переменной.
//
Функция Переменная(Знач Ключ) Экспорт
	Возврат ?(НРег(Ключ) = НРег(Проба.Цель), Проба.Переменная, Настоящие.Переменная(Ключ));
КонецФункции

// Имя по конвенции configor.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - имя переменной.
//
Функция ПоКонвенции(Знач Ключ) Экспорт
	Возврат Настоящие.ПоКонвенции(Ключ);
КонецФункции

// Список хаба и пробный псевдоним последним.
//
// Возвращаемое значение:
//  Массив из Структура - описания псевдонимов.
//
Функция Псевдонимы() Экспорт
	Список = Настоящие.Псевдонимы();
	Список.Добавить(Проба);
	Возврат Список;
КонецФункции

// Описание псевдонима по цели.
//
// Параметры:
//  Цель - Строка - ключ-цель.
//
// Возвращаемое значение:
//  Структура, Неопределено - описание псевдонима.
//
Функция ПсевдонимЦели(Знач Цель) Экспорт
	Возврат ?(НРег(Цель) = НРег(Проба.Цель), Проба, Настоящие.ПсевдонимЦели(Цель));
КонецФункции

// Параметры:
//  Ключ - Строка - ключ пробного псевдонима.
//  Цель - Строка - ключ, на который он ложится.
//  Число - Булево - цель ждёт число (необязательный).
//
Процедура ПриСозданииОбъекта(Знач Ключ, Знач Цель, Знач Число = Ложь) Экспорт

	Настоящие = Новый ИменаПеременныхОкружения();
	Проба = Новый Структура("Ключ, Переменная, Цель, ЦельУзел, Число, Пара",
		Ключ, Настоящие.ПоКонвенции(Ключ), Цель, Ложь, Число, Ложь);

КонецПроцедуры
