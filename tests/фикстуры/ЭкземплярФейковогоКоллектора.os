// Фикстура: фейковый OTLP-коллектор в отдельном процессе — свободный порт, запуск,
// ожидание готовности, чтение принятых партий по сигналам, гарантированная остановка.

Перем Выдача;
Перем Процесс;
Перем НомерПорта;
Перем КорневойКаталог;   // корень репозитория: от него запускается oscript
Перем ТаймаутСек;
Перем КореньДампов;      // префикс файлов сигналов во временном каталоге
Перем Метка;

// Конструктор.
//
// Параметры:
//  ТаймаутГотовностиСек - Число - сколько ждать первого ответа (необязательный,
//                         по умолчанию 60).
//
Процедура ПриСозданииОбъекта(Знач ТаймаутГотовностиСек = 60) Экспорт

	ТаймаутСек = ТаймаутГотовностиСек;
	НомерПорта = 0;
	Метка = "фейковый-otlp-" + Строка(Новый УникальныйИдентификатор());
	КореньДампов = ОбъединитьПути(КаталогВременныхФайлов(), Метка);

	КаталогФикстур = Новый Файл(ТекущийСценарий().Источник).Путь;
	КорневойКаталог = Новый Файл(ОбъединитьПути(КаталогФикстур, "..", "..")).ПолноеИмя;

	РеестрФикстур.Подключить("ВыдачаПортов");

	Выдача = Новый ВыдачаПортов();

КонецПроцедуры

// Поднимает коллектор и ждёт, пока он ответит на пробу готовности.
//
Процедура Запустить() Экспорт

	НомерПорта = Выдача.Выдать();

	УстановитьПеременнуюСреды("FAKE_OTLP_PORT", Формат(НомерПорта, "ЧГ=0; ЧН=0"));
	УстановитьПеременнуюСреды("FAKE_OTLP_DUMP", КореньДампов);

	Процесс = СоздатьПроцесс(СтрШаблон("oscript ""%1""", ТочкаВхода()), КорневойКаталог, Истина);
	Процесс.Запустить();

	Попытка
		ДождатьсяГотовности();
	Исключение
		Отказ = ОписаниеОшибки();
		ПортОтказа = НомерПорта;
		Диагностика = Вывод();
		Остановить();
		ВызватьИсключение СтрШаблон("Фейковый OTLP-коллектор не поднялся на порту %1: %2%3%4",
			ПортОтказа, Отказ, Символы.ПС, Диагностика);
	КонецПопытки;

КонецПроцедуры

// Останавливает коллектор, снимает заявку на порт, чистит окружение и дампы. Идемпотентна.
//
Процедура Остановить() Экспорт

	Попытка
		Если Процесс <> Неопределено И НЕ Процесс.Завершен Тогда
			Процесс.Завершить();
			Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10 * 1000;
			Пока НЕ Процесс.Завершен И ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
				Приостановить(50);
			КонецЦикла;
		КонецЕсли;
	Исключение
		// процесс мог умереть между проверкой и вызовом — это нормально
	КонецПопытки;
	Процесс = Неопределено;

	Если НомерПорта > 0 Тогда
		Выдача.Вернуть(НомерПорта);
		НомерПорта = 0;
	КонецЕсли;

	Для Каждого Имя Из СтрРазделить("FAKE_OTLP_PORT,FAKE_OTLP_DUMP", ",") Цикл
		Попытка
			УстановитьПеременнуюСреды(Имя, "");
		Исключение
		КонецПопытки;
	КонецЦикла;

	Для Каждого Сигнал Из Сигналы() Цикл
		Попытка
			Если Новый Файл(ФайлСигнала(Сигнал)).Существует() Тогда
				УдалитьФайлы(ФайлСигнала(Сигнал));
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

// Адрес коллектора — он же значение OTEL_EXPORTER_OTLP_ENDPOINT для хаба.
//
// Возвращаемое значение:
//  Строка - базовый адрес без завершающего слеша.
//
Функция Адрес() Экспорт
	Возврат "http://127.0.0.1:" + Формат(НомерПорта, "ЧГ=0; ЧН=0");
КонецФункции

// Всё, что коллектор принял по сигналу, одной строкой.
//
// Параметры:
//  Сигнал - Строка - "traces", "metrics" либо "logs".
//
// Возвращаемое значение:
//  Строка - принятые тела; пустая строка — по сигналу не приходило ничего.
//
Функция Принятое(Знач Сигнал) Экспорт

	Попытка
		Если НЕ Новый Файл(ФайлСигнала(Сигнал)).Существует() Тогда
			Возврат "";
		КонецЕсли;
		Чтение = Новый ЧтениеТекста(ФайлСигнала(Сигнал), "UTF-8");
		Содержимое = Чтение.Прочитать();
		Чтение.Закрыть();
	Исключение
		Возврат "";
	КонецПопытки;

	Возврат ?(Содержимое = Неопределено, "", Содержимое);

КонецФункции

// Ждёт, пока в принятом по сигналу появится подстрока.
//
// Параметры:
//  Сигнал - Строка - "traces", "metrics" либо "logs".
//  Фрагмент - Строка - что искать; пустая строка — ждать любой партии.
//  ТаймаутОжиданияСек - Число - сколько ждать (необязательный, по умолчанию 90).
//
// Возвращаемое значение:
//  Строка - принятое по сигналу на момент находки.
//
Функция ДождатьсяПартии(Знач Сигнал, Знач Фрагмент = "", Знач ТаймаутОжиданияСек = 90) Экспорт

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутОжиданияСек * 1000;

	Пока Истина Цикл
		Принято = Принятое(Сигнал);
		Если ЗначениеЗаполнено(Принято)
			И (НЕ ЗначениеЗаполнено(Фрагмент) ИЛИ СтрНайти(Принято, Фрагмент) > 0) Тогда
			Возврат Принято;
		КонецЕсли;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			ВызватьИсключение СтрШаблон(
				"Коллектор не принял по сигналу %1 партию с ""%2"" за %3 с; принято %4 симв.",
				Сигнал, Фрагмент, ТаймаутОжиданияСек, СтрДлина(Принято));
		КонецЕсли;
		Приостановить(500);
	КонецЦикла;

КонецФункции

// Сколько партий принято по сигналу. Партия — один POST экспортёра: по росту этого
// числа видно, что поток не оборвался после первой выгрузки.
//
// Параметры:
//  Сигнал - Строка - "traces", "metrics" либо "logs".
//
// Возвращаемое значение:
//  Число - число принятых партий.
//
Функция ЧислоПартий(Знач Сигнал) Экспорт

	Принято = Принятое(Сигнал);
	Если НЕ ЗначениеЗаполнено(Принято) Тогда
		Возврат 0;
	КонецЕсли;

	Возврат СтрЧислоВхождений(Принято, КорневойКлюч(Сигнал));

КонецФункции

// Накопленный вывод процесса — диагностика при отказе старта.
//
// Возвращаемое значение:
//  Строка - вывод коллектора либо пояснение, почему его нет.
//
Функция Вывод() Экспорт

	Если Процесс = Неопределено Тогда
		Возврат "процесс фейкового коллектора уже остановлен";
	КонецЕсли;

	Попытка
		Возврат Процесс.ПотокВывода.Прочитать() + Процесс.ПотокОшибок.Прочитать();
	Исключение
		Возврат "вывод недоступен: " + ОписаниеОшибки();
	КонецПопытки;

КонецФункции

#Область Служебное

Функция Сигналы()
	Возврат СтрРазделить("traces,metrics,logs", ",");
КонецФункции

// Корневой ключ OTLP-тела сигнала: по одному на партию.
Функция КорневойКлюч(Знач Сигнал)

	Если Сигнал = "traces" Тогда
		Возврат "resourceSpans";
	ИначеЕсли Сигнал = "metrics" Тогда
		Возврат "resourceMetrics";
	КонецЕсли;

	Возврат "resourceLogs";

КонецФункции

Функция ФайлСигнала(Знач Сигнал)
	Возврат КореньДампов + "-" + Сигнал + ".json";
КонецФункции

Функция ТочкаВхода()
	КаталогФикстур = Новый Файл(ТекущийСценарий().Источник).Путь;
	Возврат ОбъединитьПути(КаталогФикстур, "коллектор", "запуск.os");
КонецФункции

Процедура ДождатьсяГотовности()

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСек * 1000;
	ПоследняяОшибка = "";

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл

		Если Процесс.Завершен Тогда
			ВызватьИсключение СтрШаблон("процесс завершился до готовности, код %1",
				Процесс.КодВозврата);
		КонецЕсли;

		Попытка
			Соединение = Новый HTTPСоединение("127.0.0.1", НомерПорта, , , , 5);
			Если Соединение.Получить(Новый HTTPЗапрос("/ready")).КодСостояния = 200 Тогда
				Возврат;
			КонецЕсли;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
		КонецПопытки;

		Приостановить(300);

	КонецЦикла;

	ВызватьИсключение СтрШаблон("проба готовности не ответила за %1 сек (%2)",
		ТаймаутСек, ?(ЗначениеЗаполнено(ПоследняяОшибка), ПоследняяОшибка, "ответы не 200"));

КонецПроцедуры

#КонецОбласти
