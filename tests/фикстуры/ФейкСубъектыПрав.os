// Фейк резолвера СубъектыПрав: пользователь 17 — «alice», группа 5 — «team-autumn», прочее — «тип#ид».

// Контракт СубъектыПрав: имя субъекта по типу и идентификатору.
//
// Параметры:
//  ТипСубъекта - Строка - тип субъекта: пользователь, группа.
//  СубъектИд - Число - идентификатор субъекта.
//
// Возвращаемое значение:
//  Строка - имя субъекта либо «тип#ид» для ненастроенной пары.
//
Функция Имя(Знач ТипСубъекта, Знач СубъектИд) Экспорт

	Если НРег(Строка(ТипСубъекта)) = "пользователь" И СубъектИд = 17 Тогда
		Возврат "alice";
	КонецЕсли;
	Если НРег(Строка(ТипСубъекта)) = "группа" И СубъектИд = 5 Тогда
		Возврат "team-autumn";
	КонецЕсли;
	Возврат Строка(ТипСубъекта) + "#" + Формат(СубъектИд, "ЧН=0; ЧГ=0");

КонецФункции
