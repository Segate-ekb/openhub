// Фейк резолвера СубъектыПрав: пользователь 17 — «alice», группа 5 — «team-autumn», прочее — «тип#ид».
// Обращения считаются: цена таблицы прав не должна расти числом строк.

Перем Счётчик;   // СчётчикОбращений — счёт обращений к фикстуре

// Сколько раз резолвер спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Контракт СубъектыПрав: имя субъекта по типу и идентификатору.
//
// Параметры:
//  ТипСубъекта - Строка - тип субъекта: пользователь, группа.
//  СубъектИд - Число - идентификатор субъекта.
//  Имена - Соответствие, Неопределено - готовые имена списка, снятые Имена(Записи);
//          Неопределено — спросить фикстуру (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Строка - имя субъекта либо «тип#ид» для ненастроенной пары.
//
Функция Имя(Знач ТипСубъекта, Знач СубъектИд, Знач Имена = Неопределено) Экспорт

	Если Имена <> Неопределено Тогда
		Готовое = Имена.Получить(Ключ(ТипСубъекта, СубъектИд));
		Если Готовое <> Неопределено Тогда
			Возврат Готовое;
		КонецЕсли;
	КонецЕсли;

	Счётчик.Отметить();
	Возврат Резолв(ТипСубъекта, СубъектИд);

КонецФункции

// Контракт СубъектыПрав: имена всех субъектов списка записей; считает одно обращение.
//
// Параметры:
//  Записи - Массив - записи с полями ТипСубъекта и СубъектИдентификатор.
//
// Возвращаемое значение:
//  Соответствие - готовые имена для формы Имя(ТипСубъекта, СубъектИд, Имена).
//
Функция Имена(Знач Записи) Экспорт

	Счётчик.Отметить();

	Результат = Новый Соответствие();
	Для Каждого Запись Из Записи Цикл
		Результат.Вставить(Ключ(Запись.ТипСубъекта, Запись.СубъектИдентификатор),
			Резолв(Запись.ТипСубъекта, Запись.СубъектИдентификатор));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Ключ снимка имён ровно той же формы, что у продукта, — но только для двух законных
// типов субъекта. Третий тип фикстура не придумывает: в продукте он молча читался бы
// как «пользователь», и набор зеленел бы на подделанном вводе.
Функция Ключ(Знач ТипСубъекта, Знач СубъектИд)

	Норм = НРег(СокрЛП(Строка(ТипСубъекта)));
	Если Норм <> "пользователь" И Норм <> "группа" Тогда
		ВызватьИсключение "Фикстуре неизвестен тип субъекта: " + Строка(ТипСубъекта);
	КонецЕсли;

	Возврат Норм + "#" + Формат(Цел(СубъектИд), "ЧН=0; ЧГ=0");

КонецФункции

Функция Резолв(Знач ТипСубъекта, Знач СубъектИд)

	Если НРег(Строка(ТипСубъекта)) = "пользователь" И СубъектИд = 17 Тогда
		Возврат "alice";
	КонецЕсли;
	Если НРег(Строка(ТипСубъекта)) = "группа" И СубъектИд = 5 Тогда
		Возврат "team-autumn";
	КонецЕсли;
	Возврат Строка(ТипСубъекта) + "#" + Формат(СубъектИд, "ЧН=0; ЧГ=0");

КонецФункции

Процедура ПриСозданииОбъекта()
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
