// ХранилищеЛичныхУведомлений в памяти, считающее обращения и ПРОЧИТАННЫЕ СТРОКИ. Двери
// на месте все: число непрочитанного, окно свежайших, полная лента и срез «непрочитанное
// свежими первыми». Счёт строк отличает число, взятое счётчиком, от числа, посчитанного
// по поднятой ленте.

Перем Записи;   // Массив из Структура (Идентификатор, ПользовательИдентификатор, Прочитано)
Перем Счётчик;   // СчётчикОбращений — счёт обращений к фикстуре

// Сколько раз хранилище спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Сколько строк ленты хранилище отдало с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Строк() Экспорт
	Возврат Счётчик.Строк();
КонецФункции

// Заводит непрочитанное уведомление (за обращение не считается).
//
// Параметры:
//  ПользовательИдентификатор - Число - адресат.
//
Процедура Добавить(Знач ПользовательИдентификатор) Экспорт

	Записи.Добавить(Новый Структура("Идентификатор, ПользовательИдентификатор, Прочитано",
		Записи.Количество() + 1, Цел(ПользовательИдентификатор), Ложь));

КонецПроцедуры

// Сколько уведомлений учётки не прочитано; считает обращение, строк не отдаёт.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Число.
//
Функция СчётНепрочитанных(Знач ПользовательИдентификатор) Экспорт

	Счётчик.Отметить();

	Возврат Непрочитанное(ПользовательИдентификатор).Количество();

КонецФункции

// Непрочитанные уведомления учётки; считает обращение.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив.
//
Функция Непрочитанные(Знач ПользовательИдентификатор) Экспорт
	Возврат Отдать(Непрочитанное(ПользовательИдентификатор), 0);
КонецФункции

// Непрочитанные уведомления учётки, свежие первыми; считает обращение.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив.
//
Функция НепрочитанныеСвежимиПервыми(Знач ПользовательИдентификатор) Экспорт
	Возврат Отдать(Непрочитанное(ПользовательИдентификатор), 0);
КонецФункции

// Несколько свежайших непрочитанных; считает обращение.
//
// Параметры:
//  ПользовательИдентификатор - Число.
//  Предел - Число - сколько записей вернуть.
//
// Возвращаемое значение:
//  Массив.
//
Функция СвежиеНепрочитанные(Знач ПользовательИдентификатор, Знач Предел) Экспорт
	Возврат Отдать(Непрочитанное(ПользовательИдентификатор), Цел(Предел));
КонецФункции

Функция Непрочитанное(Знач ПользовательИдентификатор)

	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Если Запись.ПользовательИдентификатор = Цел(ПользовательИдентификатор)
			И НЕ Запись.Прочитано Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Предел 0 означает «без предела».
Функция Отдать(Знач Строки, Знач Предел)

	Если Предел <= 0 Тогда
		Возврат Счётчик.Отдать(Строки);
	КонецЕсли;

	Окно = Новый Массив();
	Для Каждого Строка Из Строки Цикл
		Если Окно.Количество() >= Предел Тогда
			Прервать;
		КонецЕсли;
		Окно.Добавить(Строка);
	КонецЦикла;

	Возврат Счётчик.Отдать(Окно);

КонецФункции

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
