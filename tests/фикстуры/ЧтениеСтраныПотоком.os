// Обработчик фонового задания для нагрузочного смока страны посетителя: спрашивает страну
// одного и того же адреса по кругу, пока соседний поток перестраивает индекс. Своего
// утверждения не делает: судит набор, собрав жалобы всех потоков.

Перем Определитель;  // ОпределительСтраны
Перем Адрес;         // Строка - адрес, о котором спрашиваем
Перем Кругов;        // Число
Перем Спрошено;      // Число - ответов без жалоб
Перем Жалоба;        // Строка - первая жалоба; "" — поток отработал чисто

// Жалоба потока: текст сбоя либо неизвестный исход; пустая строка — отвечали как должно.
//
// Возвращаемое значение:
//  Строка.
//
Функция Жалоба() Экспорт
	Возврат Жалоба;
КонецФункции

// Сколько ответов поток успел получить без жалоб.
//
// Возвращаемое значение:
//  Число.
//
Функция Спрошено() Экспорт
	Возврат Спрошено;
КонецФункции

// Контракт обработчика фонового задания.
Процедура Исполнить() Экспорт

	Попытка
		СпроситьКруги();
	Исключение
		Пожаловаться("определение страны упало: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура СпроситьКруги()

	Исходы = Определитель.Исходы();

	Для Круг = 1 По Кругов Цикл
		Вердикт = Определитель.Определить(Адрес);
		Если Вердикт.Исход <> Исходы.Известна И Вердикт.Исход <> Исходы.НеНаблюдаемая
			И Вердикт.Исход <> Исходы.Неизвестна Тогда
			Пожаловаться(СтрШаблон("на круге %1 пришёл неизвестный исход ""%2""",
				Круг, Вердикт.Исход));
			Возврат;
		КонецЕсли;
		Если Вердикт.Исход = Исходы.Известна И НЕ ЗначениеЗаполнено(Вердикт.Страна) Тогда
			Пожаловаться(СтрШаблон("на круге %1 страна известна, а кода нет", Круг));
			Возврат;
		КонецЕсли;
		Спрошено = Спрошено + 1;
	КонецЦикла;

КонецПроцедуры

Процедура Пожаловаться(Знач Текст)
	Если НЕ ЗначениеЗаполнено(Жалоба) Тогда
		Жалоба = Текст;
	КонецЕсли;
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач ОпределительСтраны, Знач АдресКлиента, Знач ЧислоКругов)
	Определитель = ОпределительСтраны;
	Адрес = АдресКлиента;
	Кругов = ЧислоКругов;
	Спрошено = 0;
	Жалоба = "";
КонецПроцедуры
