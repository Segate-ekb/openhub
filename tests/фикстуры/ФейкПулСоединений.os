// Пул соединений entity с заданными числами: тест сам решает, исчерпан пул или нет.

Перем Занято_;
Перем Свободно_;
Перем Ожидают_;
Перем Создано_;

#Область КонтрактПула

// Соединений, занятых потоками исполнения.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоЗанятых() Экспорт
	Возврат Занято_;
КонецФункции

// Свободных соединений в очереди пула.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоСвободных() Экспорт
	Возврат Свободно_;
КонецФункции

// Потоков исполнения, стоящих в очереди за соединением.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоОжидающих() Экспорт
	Возврат Ожидают_;
КонецФункции

// Занятых пулом мест: открытых соединений и броней под те, что открываются сейчас.
// Именно это число пул сравнивает со своим размером.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоСозданных() Экспорт
	Возврат Создано_;
КонецФункции

#КонецОбласти

// Числа снимка задаёт тест.
//
// Параметры:
//  Занято   - Число - соединений у потоков.
//  Свободно - Число - свободных соединений.
//  Ожидают  - Число - потоков в очереди.
//  Создано  - Число, Неопределено - занятых мест в пуле; Неопределено — занятые
//             и свободные соединения, то есть пул без броней.
//
Процедура ПриСозданииОбъекта(Знач Занято, Знач Свободно, Знач Ожидают,
	Знач Создано = Неопределено) Экспорт
	Занято_ = Занято;
	Свободно_ = Свободно;
	Ожидают_ = Ожидают;
	Создано_ = ?(Создано = Неопределено, Занято + Свободно, Создано);
КонецПроцедуры
