// Заглушка ГвардаДоступаКПулу для маршрутов выдачи: вердикт чтения пула задаёт тест.

Перем Разрешено_;

// Вердикт доступа к пулу на чтение (контракт ГвардДоступаКПулу).
//
// Параметры:
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса, заглушкой не различаются.
//  КукиЗапроса - Произвольный - куки запроса, заглушкой не различаются.
//  ИмяПула - Строка - имя пула из адреса.
//
// Возвращаемое значение:
//  Структура - Разрешено (Булево).
//
Функция Проверить(Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ИмяПула) Экспорт

	ЗаголовкиЗапроса = ЗаголовкиЗапроса;
	КукиЗапроса = КукиЗапроса;
	ИмяПула = ИмяПула;

	Возврат Новый Структура("Разрешено", Разрешено_);

КонецФункции

// Закрывает пул на чтение.
//
Процедура Запретить() Экспорт
	Разрешено_ = Ложь;
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Разрешено_ = Истина;
КонецПроцедуры
