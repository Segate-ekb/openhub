// Стенд принципалов запроса в форме ПерехватчикаАутентификации: сессия, ключ, ключ старой записи —
// структурой без базы (поле Сессия пусто), ключ службой — настоящим выпуском хаба.

Перем Контейнер;

#Область ПринципалыСтрокой

// Принципал сессии браузера: ключа в запросе нет, сужать выдачу нечем.
//
// Параметры:
//  Владелец - Пользователь, Неопределено - учётка за запросом; Неопределено — аноним.
//
// Возвращаемое значение:
//  Структура - принципал запроса в форме ПерехватчикаАутентификации.
//
Функция Сессия(Знач Владелец) Экспорт
	Возврат Принципал(Владелец, "session", "", Новый Массив(), 0);
КонецФункции

// Принципал запроса с ключом доступа (PAT): скоупы и рамки пулов сужают то, что человеку
// иначе разрешено.
//
// Параметры:
//  Владелец - Пользователь, Неопределено - учётка, от имени которой предъявлен ключ.
//  Права - Строка - скоупы через запятую, например «read» или «read,write»
//          (необязательный, по умолчанию "read,write").
//  ПулИдентификатор - Число - одиночная привязка ключа к пулу; 0 — ключ на весь хаб
//                     (необязательный, по умолчанию 0).
//  Пулы - Массив из Число, Неопределено - набор пулов, которыми ограничен ключ; пустой
//         набор и Неопределено — весь хаб (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - принципал запроса в форме ПерехватчикаАутентификации.
//
Функция Ключ(Знач Владелец, Знач Права = "read,write", Знач ПулИдентификатор = 0,
	Знач Пулы = Неопределено) Экспорт

	Возврат Принципал(Владелец, "token", Права,
		?(Пулы = Неопределено, Новый Массив(), Пулы), ПулИдентификатор);

КонецФункции

// Принципал ключа, выпущенного до наборов пулов: поля Пулы у него нет вовсе, рамка
// названа одиночной привязкой. Такие записи лежат в базах, заведённых старым хабом,
// и хаб обязан судить их как набор из одного пула.
//
// Параметры:
//  Владелец - Пользователь, Неопределено - учётка, от имени которой предъявлен ключ.
//  Права - Строка - скоупы через запятую (необязательный, по умолчанию "read,write").
//  ПулИдентификатор - Число - одиночная привязка к пулу; 0 — весь хаб (необязательный,
//                     по умолчанию 0).
//
// Возвращаемое значение:
//  Структура - принципал БЕЗ поля Пулы.
//
Функция КлючСтаройЗаписи(Знач Владелец, Знач Права = "read,write",
	Знач ПулИдентификатор = 0) Экспорт

	Старый = Принципал(Владелец, "token", Права, Новый Массив(), ПулИдентификатор);
	Старый.Удалить("Пулы");

	Возврат Старый;

КонецФункции

#КонецОбласти

#Область ПринципалыСлужбамиХаба

// Выпускает настоящий ключ доступа и отдаёт принципала так, как его собирает хаб на живом
// запросе: СервисТокенов пишет запись и привязки, ПерехватчикАутентификации читает
// заголовок Authorization и опознаёт владельца. Ключ живёт сутки — самый короткий срок,
// который принимает хаб, и его хватает любому тесту: истечения в пределах прогона не будет.
//
// Параметры:
//  Владелец - Пользователь - учётка, которой выпускается ключ.
//  Права - Строка - скоупы через запятую (необязательный, по умолчанию "read,write").
//  Пулы - Массив из Число, Неопределено - пулы, которыми ограничен ключ; пустой набор
//         и Неопределено — весь хаб (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - принципал запроса, собранный ПерехватчикомАутентификации.
//
Функция КлючСлужбой(Знач Владелец, Знач Права = "read,write", Знач Пулы = Неопределено) Экспорт

	СрокДней = 1;
	// рамка ключа задаётся НАБОРОМ пулов; старое поле одиночной привязки остаётся пустым
	ОдиночнаяПривязка = 0;

	Выпуск = Контейнер.НайтиЖелудь("СервисТокенов").ВыпуститьТокен(Владелец.Идентификатор,
		Права, СрокДней, ОдиночнаяПривязка, УникальныеИмена.Имя("ключ"), Пулы);

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Authorization", "Bearer " + Выпуск.ЗначениеТокена);

	Возврат Контейнер.НайтиЖелудь("ПерехватчикАутентификации").ОпределитьПринципала(
		Заголовки, Неопределено);

КонецФункции

#КонецОбласти

#Область Служебное

// Поля и их порядок — те же, что у ПерехватчикаАутентификации: принципал стенда и принципал
// живого запроса обязаны быть неразличимы для гвардов.
Функция Принципал(Знач Владелец, Знач Способ, Знач Права, Знач Пулы, Знач ПулИдентификатор)

	Структура = Новый Структура();
	Структура.Вставить("Пользователь", Владелец);
	Структура.Вставить("Способ", Способ);
	Структура.Вставить("Права", Права);
	Структура.Вставить("Пулы", Пулы);
	Структура.Вставить("ПулИдентификатор", Цел(ПулИдентификатор));
	Структура.Вставить("Сессия", Неопределено);
	Структура.Вставить("ПроблемаТокена", "");

	Возврат Структура;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач Поделка)
	Контейнер = Поделка;
КонецПроцедуры
