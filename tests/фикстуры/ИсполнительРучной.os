// Ручной исполнитель os-scheduler: возвращает незавершённый дескриптор — тест завершает его сам.

Перем Выполнения_;
Перем ВызововЗапуска_;

// Запускает обработчик синхронно и возвращает НЕЗАВЕРШЁННОЕ выполнение.
//
// Параметры:
//  Обработчик - Произвольный - объект с методом Исполнить(); его исключение гасится.
//
// Возвращаемое значение:
//  ВыполнениеРучное - дескриптор, который тест завершает сам.
//
Функция Запустить(Знач Обработчик) Экспорт
	ВызововЗапуска_ = ВызововЗапуска_ + 1;
	Попытка
		Обработчик.Исполнить();
	Исключение
	КонецПопытки;
	Выполнение = Новый ВыполнениеРучное();
	Выполнения_.Добавить(Выполнение);
	Возврат Выполнение;
КонецФункции

// Число вызовов Запустить.
//
// Возвращаемое значение:
//  Число.
//
Функция ВызововЗапуска() Экспорт
	Возврат ВызововЗапуска_;
КонецФункции

// Завершает успехом все выданные и ещё не завершённые выполнения.
Процедура ЗавершитьВсеУспехом() Экспорт
	Для Каждого Выполнение Из Выполнения_ Цикл
		Если НЕ Выполнение.Завершено() Тогда
			Выполнение.ЗавершитьУспехом();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Выполнения_ = Новый Массив();
	ВызововЗапуска_ = 0;
КонецПроцедуры
