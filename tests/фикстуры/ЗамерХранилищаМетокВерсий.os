// ХранилищеМетокВерсий в памяти, считающее ОБРАЩЕНИЯ и ПРОЧИТАННЫЕ СТРОКИ: ответ
// `/versions` перечисляет метки каждой версии, и вопрос на строку стоил горячему пути
// `opm` одного обращения на версию.

Перем Записи;      // Массив из Структура — метки версий
Перем Счётчик;   // СчётчикОбращений — счёт запросов и прочитанных строк

#Область Счётчики

// Сколько строк меток хранилище отдало с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Строк() Экспорт
	Возврат Счётчик.Строк();
КонецФункции

// Сколько запросов к хранилищу ушло с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Запросов() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Обнуляет счётчики, оставляя фактуру.
Процедура Обнулить() Экспорт
	Счётчик.Обнулить();
КонецПроцедуры

#КонецОбласти

#Область НаполнениеФикстуры

// Присваивает версии метку (за обращение не считается).
//
// Параметры:
//  ВерсияИдентификатор - Число - идентификатор версии.
//  Метка - Строка - значение метки.
//
Процедура Присвоить(Знач ВерсияИдентификатор, Знач Метка) Экспорт

	Записи.Добавить(Новый Структура("Идентификатор, ВерсияИдентификатор, Метка",
		Записи.Количество() + 1, Цел(ВерсияИдентификатор), Метка));

КонецПроцедуры

#КонецОбласти

#Область КонтрактХранилища

// Метки одной версии.
//
// Параметры:
//  ВерсияИдентификатор - Число - идентификатор версии.
//
// Возвращаемое значение:
//  Массив - метки версии.
//
Функция ПолучитьПоВерсияИдентификаторРавно(Знач ВерсияИдентификатор) Экспорт

	Список = Новый Массив();
	Список.Добавить(Цел(ВерсияИдентификатор));
	Возврат Отдать(ПоВерсиям(Список));

КонецФункции

// Метки перечисленных версий одним отбором.
//
// Параметры:
//  ВерсияИдентификаторы - Массив из Число - идентификаторы версий.
//
// Возвращаемое значение:
//  Массив - метки всех перечисленных версий.
//
Функция МеткиВерсий(Знач ВерсияИдентификаторы) Экспорт
	Возврат Отдать(ПоВерсиям(ВерсияИдентификаторы));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПоВерсиям(Знач ВерсияИдентификаторы)

	Нужные = Новый Соответствие();
	Для Каждого Номер Из ВерсияИдентификаторы Цикл
		Нужные.Вставить(Цел(Номер), Истина);
	КонецЦикла;

	Отобранные = Новый Массив();
	Для Каждого Строка_ Из Записи Цикл
		Если Нужные.Получить(Строка_.ВерсияИдентификатор) = Истина Тогда
			Отобранные.Добавить(Строка_);
		КонецЕсли;
	КонецЦикла;
	Возврат Отобранные;

КонецФункции

Функция Отдать(Знач Строки)

	Возврат Счётчик.Отдать(Строки);

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
