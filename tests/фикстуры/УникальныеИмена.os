// Свободные имена, номера и временные каталоги для наборов: один счётчик на процесс с солью запуска,
// имя годится и в логин, и в имя пула, пакета, провайдера.

Перем Счётчик;
Перем СчётчикНомеров;
Перем СольЗапуска;
Перем ПродуктоваяУборка;   // основа/ТихаяУборка — владелец временного пути и удаления

// Свободное имя с приставкой: «gha-7-3f1a9c».
//
// Параметры:
//  Приставка - Строка - смысловая часть имени; отделяется дефисом.
//
// Возвращаемое значение:
//  Строка - имя, которого не выдавали ни в этом процессе, ни в соседнем.
//
Функция Имя(Знач Приставка) Экспорт
	Возврат Приставка + "-" + Хвост();
КонецФункции

// Свободный хвост без приставки: «7-3f1a9c». Нужен там, где разделитель выбирает сам
// набор — приставка кончается подчёркиванием («alice_») или склеивается вплотную.
//
// Возвращаемое значение:
//  Строка - хвост, которого не выдавали ни в этом процессе, ни в соседнем.
//
Функция Хвост() Экспорт

	Счётчик = Счётчик + 1;

	Возврат Формат(Счётчик, "ЧГ=0; ЧН=0") + "-" + СольЗапуска;

КонецФункции

// Свободный номер строки: синтетический идентификатор пакета, субъекта или связки там,
// где внешних ключей нет и строка ссылается на кого угодно. Номер обязан быть свой
// у каждого теста — иначе отбор соседа вычитывает чужие строки.
//
// Параметры:
//  Запас - Число - сколько номеров подряд остаётся за вызывающим: он получает первый,
//          а соседние «+1», «+7» никому больше не достанутся (необязательный,
//          по умолчанию 1 — один номер).
//
// Возвращаемое значение:
//  Число - номер, которого не выдавали в этом процессе.
//
Функция Номер(Знач Запас = 1) Экспорт

	Выданный = ПервыйНомер() + СчётчикНомеров;
	СчётчикНомеров = СчётчикНомеров + ?(Цел(Запас) < 1, 1, Цел(Запас));

	Возврат Выданный;

КонецФункции

// Не ноль: нулём в хабе называют «уровень хаба» и «нет объекта», и строка с нулевым
// номером читалась бы как ничья.
Функция ПервыйНомер()
	Возврат 1000;
КонецФункции

// Соль текущего процесса: у двух запусков она разная, внутри запуска — одна.
//
// Возвращаемое значение:
//  Строка - шесть знаков соли.
//
Функция Соль() Экспорт
	Возврат СольЗапуска;
КонецФункции

// Свой каталог набора в каталоге временных файлов системы: создан и пуст.
//
// Параметры:
//  Приставка - Строка - смысловая часть имени, по ней каталог узнаётся среди чужого
//              мусора; отделяется дефисом.
//
// Возвращаемое значение:
//  Строка - полный путь созданного каталога.
//
Функция ВременныйКаталог(Знач Приставка) Экспорт

	Путь = Уборка().ВременныйПуть(Приставка + "-");
	СоздатьКаталог(Путь);

	Возврат Путь;

КонецФункции

// Свободный путь во временных файлах системы, которого ещё нет. Что по нему появится,
// решает вызывающий: файл он пишет сам, каталог заводит сам или отдаёт путь тому, кто
// заведёт, — а проверка «такого пути не бывает» не заводит ничего.
//
// Параметры:
//  Приставка - Строка - смысловая часть имени; отделяется дефисом.
//  Расширение - Строка - расширение без точки (необязательный, по умолчанию "" —
//               имя без расширения).
//
// Возвращаемое значение:
//  Строка - полный путь.
//
Функция ВременныйПуть(Знач Приставка, Знач Расширение = "") Экспорт
	Возврат Уборка().ВременныйПуть(Приставка + "-", Расширение);
КонецФункции

// Убирает то, что выдали эти двери: каталог со всем содержимым или файл. Пустой путь,
// уже убранный путь и отказ файловой системы проходят молча — падение уборки затирало бы
// ту ошибку, ради которой набор красный.
//
// Параметры:
//  Путь - Строка - путь к каталогу или файлу.
//
Процедура УбратьВременное(Знач Путь) Экспорт
	Уборка().УдалитьФайл(Путь);
КонецПроцедуры

// Продуктовая уборка: имя временного пути и удаление, которое не роняет вызывающего,
// живут в основа/ТихаяУборка. Класс подключается по требованию и один раз на процесс.
Функция Уборка()

	Если ПродуктоваяУборка = Неопределено Тогда
		РеестрФикстур.Подключить("КлассыСлоя");
		ПоискКлассов = Новый КлассыСлоя();
		ПоискКлассов.ПодключитьФайл(ФайлТихойУборки());
		ПродуктоваяУборка = Новый ТихаяУборка();
	КонецЕсли;

	Возврат ПродуктоваяУборка;

КонецФункции

Функция ФайлТихойУборки()

	КлассыОсновы = ОбъединитьПути(КаталогиПроекта.Модули(), "основа", "Классы");

	Возврат ОбъединитьПути(КлассыОсновы, "ТихаяУборка.os");

КонецФункции

Счётчик = 0;
СчётчикНомеров = 0;
СольЗапуска = Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 6);
