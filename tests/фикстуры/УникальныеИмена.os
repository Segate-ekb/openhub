// Свободные имена для наборов: логины, имена пулов и пакетов, префиксы ключей, суффиксы
// адресов. Одна дверь вместо счётчика, переписанного в каждом наборе своими словами.
//
// Уникальности счётчика мало. Счётчик начинается заново в каждом процессе, а база живого
// хаба процесс переживает: второй набор в том же хабе получал бы те же «u-1», и падал бы
// не он, а тот сценарий, который ищет по имени. Поэтому к номеру приклеена соль запуска —
// шесть знаков, свои у каждого процесса.
//
// Общий модуль, а не класс: счётчик обязан быть один на процесс. Счётчик экземпляра — ровно
// та ошибка, из-за которой два стенда одного набора молча берут одно и то же имя.
//
// Вид имени подчинён правилам хаба: строчная латиница, цифры и дефис, первый символ —
// буква или цифра. Такое имя годится и в логин (2–64), и в имя пула или пакета (до 100),
// и в имя провайдера входа (2–32).

Перем Счётчик;
Перем СольЗапуска;

// Свободное имя с приставкой: «gha-7-3f1a9c».
//
// Параметры:
//  Приставка - Строка - смысловая часть имени; отделяется дефисом.
//
// Возвращаемое значение:
//  Строка - имя, которого не выдавали ни в этом процессе, ни в соседнем.
//
Функция Имя(Знач Приставка) Экспорт
	Возврат Приставка + "-" + Хвост();
КонецФункции

// Свободный хвост без приставки: «7-3f1a9c». Нужен там, где разделитель выбирает сам
// набор — приставка кончается подчёркиванием («alice_») или склеивается вплотную.
//
// Возвращаемое значение:
//  Строка - хвост, которого не выдавали ни в этом процессе, ни в соседнем.
//
Функция Хвост() Экспорт

	Счётчик = Счётчик + 1;

	Возврат Формат(Счётчик, "ЧГ=0; ЧН=0") + "-" + СольЗапуска;

КонецФункции

// Соль текущего процесса: у двух запусков она разная, внутри запуска — одна.
//
// Возвращаемое значение:
//  Строка - шесть знаков соли.
//
Функция Соль() Экспорт
	Возврат СольЗапуска;
КонецФункции

Счётчик = 0;
СольЗапуска = Лев(СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""), 6);
