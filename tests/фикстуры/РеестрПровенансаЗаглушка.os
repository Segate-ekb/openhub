// Заглушка реестра и провенанса для тестов GC прокси-кэша: есть ли пакет, есть ли версия
// и откуда версия. Не входит в состав приложения.

Перем Источники_;   // Соответствие: "пакет|версия" -> "свой" | "апстрим"

// Регистрирует версию пакета с её происхождением.
//
// Параметры:
//  ИмяПакета - Строка - имя пакета.
//  СтрокаВерсии - Строка - версия.
//  Источник - Строка - «свой» либо «апстрим».
//
Процедура Добавить(Знач ИмяПакета, Знач СтрокаВерсии, Знач Источник) Экспорт
	Источники_.Вставить(Ключ(ИмяПакета, СтрокаВерсии), Источник);
КонецПроцедуры

// Роль СервисПакетов: пакет по имени. Идентификатором пакета служит само его имя —
// так различаются одноимённые версии разных пакетов.
//
// Параметры:
//  ПулИдентификатор - Число - заглушкой не используется.
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Структура (Идентификатор, Имя), Неопределено - Неопределено, если версий пакета
//   не регистрировали.
//
// BSLLS:UnusedParameters-off
Функция НайтиПакет(Знач ПулИдентификатор, Знач ИмяПакета) Экспорт
	Для Каждого КиЗ Из Источники_ Цикл
		Если СтрНачинаетсяС(КиЗ.Ключ, НРег(ИмяПакета) + "|") Тогда
			Возврат Новый Структура("Идентификатор, Имя", НРег(ИмяПакета), ИмяПакета);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Роль СервисВерсий: версия пакета по строке версии.
//
// Параметры:
//  ПакетИдентификатор - Строка - идентификатор пакета (его имя).
//  СтрокаВерсии - Строка - версия.
//
// Возвращаемое значение:
//  Структура (Идентификатор, Версия, Источник), Неопределено - Неопределено, если версии нет.
//
Функция НайтиВерсию(Знач ПакетИдентификатор, Знач СтрокаВерсии) Экспорт
	Источник = Источники_.Получить(Ключ(Строка(ПакетИдентификатор), СтрокаВерсии));
	Если Источник = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Идентификатор, Версия, Источник", 1, СтрокаВерсии, Источник);
КонецФункции

// Роль СервисПроисхождения: происхождение версии.
//
// Параметры:
//  Версия - Структура, Неопределено - запись версии.
//
// Возвращаемое значение:
//  Строка - «свой» либо «апстрим»; для Неопределено — «свой».
//
Функция ИсточникВерсии(Знач Версия) Экспорт
	Возврат ?(Версия = Неопределено, ИсточникСвой(), Версия.Источник);
КонецФункции

// Обозначение собственной публикации.
//
// Возвращаемое значение:
//  Строка - "свой".
//
Функция ИсточникСвой() Экспорт
	Возврат "свой";
КонецФункции

// Обозначение версии, пришедшей из апстрима.
//
// Возвращаемое значение:
//  Строка - "апстрим".
//
Функция ИсточникАпстрим() Экспорт
	Возврат "апстрим";
КонецФункции

Функция Ключ(Знач ИмяПакета, Знач СтрокаВерсии)
	Возврат НРег(ИмяПакета) + "|" + НРег(СтрокаВерсии);
КонецФункции

Процедура ПриСозданииОбъекта()
	Источники_ = Новый Соответствие();
КонецПроцедуры
