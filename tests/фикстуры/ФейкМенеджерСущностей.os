// Менеджер сущностей entity без базы: считает обращения и умеет падать по команде теста.
// Счётчик обращений — то, чем доказывается, что проба при исчерпанном пуле в базу не пошла.

Перем Источник_;
Перем Обращений_;
Перем ТекстОтказа_;

#Область КонтрактМенеджера

// Источник данных, из которого создан менеджер.
//
// Возвращаемое значение:
//  ФейкИсточникДанных.
//
Функция ИсточникДанных() Экспорт
	Возврат Источник_;
КонецФункции

// Выборка сущностей: считает обращение и падает, если тесту нужен отказ базы.
//
// Параметры:
//  ТипСущности - Тип - тип искомой сущности.
//  Опции - ОпцииПоиска, Неопределено - отбор.
//
// Возвращаемое значение:
//  Массив - всегда пустой: проба смотрит на факт ответа, а не на строки.
//
Функция Получить(ТипСущности, Знач Опции = Неопределено) Экспорт

	Обращений_ = Обращений_ + 1;

	Если ЗначениеЗаполнено(ТекстОтказа_) Тогда
		ВызватьИсключение ТекстОтказа_;
	КонецЕсли;

	Возврат Новый Массив();

КонецФункции

#КонецОбласти

#Область УправлениеИзТеста

// Сколько раз у менеджера спросили строки.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Обращений_;
КонецФункции

// Заставляет следующие выборки падать с этим текстом.
//
// Параметры:
//  Текст - Строка - текст исключения.
//
Процедура ПадатьС(Знач Текст) Экспорт
	ТекстОтказа_ = Текст;
КонецПроцедуры

#КонецОбласти

// Источник задаёт тест; выборки по умолчанию проходят.
//
// Параметры:
//  Источник - ФейкИсточникДанных - источник данных менеджера.
//
Процедура ПриСозданииОбъекта(Знач Источник) Экспорт
	Источник_ = Источник;
	Обращений_ = 0;
	ТекстОтказа_ = "";
КонецПроцедуры
