// Табакерка для тестов телеметрии: считает, сколько раз из неё доставали SDK,
// и умеет сорваться на доставании — так проверяется, что выключенная трассировка
// SDK не поднимает, а сбой SDK операцию не роняет.

Перем Содержимое;
Перем СрыватьсяНаДоставании;
Перем ЧислоДоставаний;

// Достаёт содержимое табакерки — контракт ОСени.
//
// Параметры:
//  ПрилепляемыеЧастицы - Произвольный - совместимость с контрактом; не используется
//                        (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Произвольный - то, что положили в конструкторе.
//
Функция Достать(ПрилепляемыеЧастицы = Неопределено) Экспорт

	ЧислоДоставаний = ЧислоДоставаний + 1;
	Если СрыватьсяНаДоставании Тогда
		ВызватьИсключение "ТабакеркаНаблюдаемая: намеренный сбой подъёма SDK";
	КонецЕсли;

	Возврат Содержимое;

КонецФункции

// Сколько раз из табакерки доставали.
//
// Возвращаемое значение:
//  Число - счётчик обращений; ноль означает, что SDK не поднимали.
//
Функция ЧислоДоставаний() Экспорт
	Возврат ЧислоДоставаний;
КонецФункции

Процедура ПриСозданииОбъекта(Знач НовоеСодержимое = Неопределено, Знач НовыйСрыв = Ложь)
	Содержимое = НовоеСодержимое;
	СрыватьсяНаДоставании = НовыйСрыв;
	ЧислоДоставаний = 0;
КонецПроцедуры
