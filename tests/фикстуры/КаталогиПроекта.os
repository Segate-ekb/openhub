// Каталоги репозитория для наборов и фикстур: корень, модули продукта, дерево тестов и общие
// фикстуры. Считаются от этого файла, поэтому набор не зависит от того, в каком подкаталоге лежит.

Перем Корень_;

// Корень репозитория.
//
// Возвращаемое значение:
//  Строка - полный путь.
//
Функция Корень() Экспорт
	Возврат Корень_;
КонецФункции

// Каталог модулей продукта — src/модули.
//
// Возвращаемое значение:
//  Строка - полный путь.
//
Функция Модули() Экспорт
	Возврат ОбъединитьПути(Корень_, "src", "модули");
КонецФункции

// Корень дерева тестов — tests.
//
// Возвращаемое значение:
//  Строка - полный путь.
//
Функция Тесты() Экспорт
	Возврат ОбъединитьПути(Корень_, "tests");
КонецФункции

// Общий каталог фикстур — tests/фикстуры: здесь же лежат их данные (пакеты, токены, база стран).
//
// Возвращаемое значение:
//  Строка - полный путь.
//
Функция Фикстуры() Экспорт
	Возврат ОбъединитьПути(Корень_, "tests", "фикстуры");
КонецФункции

Корень_ = Новый Файл(ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..", "..")).ПолноеИмя;
