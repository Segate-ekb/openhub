// Заглушка СервисаПулов: пул добавляется вместе с признаком «есть апстрим».

Перем Пулы_;
Перем САпстримами_;
Перем Апстримы_;   // Соответствие: идентификатор пула -> Массив источников
Перем КвотаХабаМб_;

// Добавляет пул в фикстуру.
//
// Параметры:
//  Пул         - Произвольный - объект пула (нужны поля Имя и Тип).
//  САпстримами - Булево - попадёт ли пул в ПулыСАпстримами (необязательный, по умолчанию Истина).
//
Процедура ДобавитьПул(Знач Пул, Знач САпстримами = Истина) Экспорт
	Пулы_.Добавить(Пул);
	САпстримами_.Вставить(Пул.Имя, САпстримами = Истина);
КонецПроцедуры

// Пулы, помеченные признаком «есть апстрим».
//
// Возвращаемое значение:
//  Массив - добавленные пулы.
//
Функция ПулыСАпстримами() Экспорт
	Результат = Новый Массив();
	Для Каждого Пул Из Пулы_ Цикл
		Если САпстримами_.Получить(Пул.Имя) = Истина Тогда
			Результат.Добавить(Пул);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Пулы заданного типа.
//
// Параметры:
//  Тип - Строка - тип пула.
//
// Возвращаемое значение:
//  Массив - подходящие пулы.
//
Функция ПулыПоТипу(Знач Тип) Экспорт
	Результат = Новый Массив();
	Для Каждого Пул Из Пулы_ Цикл
		Если Пул.Тип = Тип Тогда
			Результат.Добавить(Пул);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Действующая квота пула в байтах — тот же трёхзначный разбор КвотаМб, что у КвотыПула:
// -1 наследует квоту хаба, 0 снимает ограничение.
//
// Параметры:
//  Пул - Произвольный - объект пула.
//
// Возвращаемое значение:
//  Число - байты; 0 — без ограничения.
//
Функция ЭффективнаяКвотаБайт(Знач Пул) Экспорт

	Если Пул = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	// как в продукте: незаполненная колонка означает «как в хабе», а не «без ограничения»
	КвотаМб = ?(Пул.КвотаМб = Неопределено, -1, Цел(Число(Пул.КвотаМб)));
	Если КвотаМб < 0 Тогда
		КвотаМб = КвотаХабаМб_;
	КонецЕсли;
	Возврат ?(КвотаМб <= 0, 0, КвотаМб * 1024 * 1024);

КонецФункции

// Задаёт квоту хаба по умолчанию, которую наследуют пулы со значением -1.
//
// Параметры:
//  КвотаМб - Число - квота в МБ.
//
Процедура УстановитьКвотуХабаМб(Знач КвотаМб) Экспорт
	КвотаХабаМб_ = Цел(КвотаМб);
КонецПроцедуры

// Источники пула в порядке обхода.
//
// Параметры:
//  ИдентификаторПула - Произвольный - идентификатор пула.
//
// Возвращаемое значение:
//  Массив - заданные ЗадатьАпстримы источники; по умолчанию пусто.
//
Функция АпстримыПула(Знач ИдентификаторПула) Экспорт
	Найдено = Апстримы_.Получить(Строка(ИдентификаторПула));
	Возврат ?(Найдено = Неопределено, Новый Массив(), Найдено);
КонецФункции

// Источники пула, которые разрешено опрашивать: включённые, в том же порядке.
//
// Параметры:
//  Пул - Произвольный - объект пула.
//
// Возвращаемое значение:
//  Массив - включённые источники.
//
Функция АпстримыДляОпроса(Знач Пул) Экспорт

	Результат = Новый Массив();
	Если Пул = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Апстрим Из АпстримыПула(Пул.Идентификатор) Цикл
		Если Апстрим.Включён = Истина Тогда
			Результат.Добавить(Апстрим);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Задаёт источники пула.
//
// Параметры:
//  ИдентификаторПула - Произвольный - идентификатор пула.
//  Список - Массив - структуры Url, ВремяЖизниСек, Включён.
//
Процедура ЗадатьАпстримы(Знач ИдентификаторПула, Знач Список) Экспорт
	Апстримы_.Вставить(Строка(ИдентификаторПула), Список);
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Пулы_ = Новый Массив();
	САпстримами_ = Новый Соответствие();
	Апстримы_ = Новый Соответствие();
	КвотаХабаМб_ = 0;
КонецПроцедуры
