// Заглушка СервисаПулов и списка источников пула: пул добавляется вместе с признаком «есть апстрим»,
// источники задаются ЗадатьАпстримы; заведение, назначение основным и удаление пула запоминаются.

Перем Пулы_;
Перем САпстримами_;
Перем Апстримы_;   // Соответствие: идентификатор пула -> Массив источников
Перем КвотаХабаМб_;
Перем Несносимые_; // Соответствие: имя пула -> Истина; УдалитьПул на нём бросает исключение
Перем Созданные Экспорт;   // Массив из Структура вызовов СоздатьПул
Перем Назначенные Экспорт; // Массив из Структура (ПулИдентификатор, Кем) вызовов НазначитьПулПоУмолчанию
Перем Удалённые Экспорт;   // Массив из Число — пулы, снесённые УдалитьПул

// Добавляет пул в фикстуру.
//
// Параметры:
//  Пул         - Произвольный - объект пула (нужны поля Имя и Тип).
//  САпстримами - Булево - попадёт ли пул в ПулыСАпстримами (необязательный, по умолчанию Истина).
//
Процедура ДобавитьПул(Знач Пул, Знач САпстримами = Истина) Экспорт
	Пулы_.Добавить(Пул);
	САпстримами_.Вставить(Пул.Имя, САпстримами = Истина);
КонецПроцедуры

// Пулы, помеченные признаком «есть апстрим».
//
// Возвращаемое значение:
//  Массив - добавленные пулы.
//
Функция ПулыСАпстримами() Экспорт
	Результат = Новый Массив();
	Для Каждого Пул Из Пулы_ Цикл
		Если САпстримами_.Получить(Пул.Имя) = Истина Тогда
			Результат.Добавить(Пул);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Пулы заданного типа.
//
// Параметры:
//  Тип - Строка - тип пула.
//
// Возвращаемое значение:
//  Массив - подходящие пулы.
//
Функция ПулыПоТипу(Знач Тип) Экспорт
	Результат = Новый Массив();
	Для Каждого Пул Из Пулы_ Цикл
		Если Пул.Тип = Тип Тогда
			Результат.Добавить(Пул);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Действующая квота пула в байтах — тот же трёхзначный разбор КвотаМб, что у КвотыПула:
// -1 наследует квоту хаба, 0 снимает ограничение.
//
// Параметры:
//  Пул - Произвольный - объект пула.
//
// Возвращаемое значение:
//  Число - байты; 0 — без ограничения.
//
Функция ЭффективнаяКвотаБайт(Знач Пул) Экспорт

	Если Пул = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	// как в продукте: незаполненная колонка означает «как в хабе», а не «без ограничения»
	КвотаМб = ?(Пул.КвотаМб = Неопределено, -1, Цел(Число(Пул.КвотаМб)));
	Если КвотаМб < 0 Тогда
		КвотаМб = КвотаХабаМб_;
	КонецЕсли;
	Возврат ?(КвотаМб <= 0, 0, КвотаМб * 1024 * 1024);

КонецФункции

// Задаёт квоту хаба по умолчанию, которую наследуют пулы со значением -1.
//
// Параметры:
//  КвотаМб - Число - квота в МБ.
//
Процедура УстановитьКвотуХабаМб(Знач КвотаМб) Экспорт
	КвотаХабаМб_ = Цел(КвотаМб);
КонецПроцедуры

// Источники пула в порядке обхода.
//
// Параметры:
//  ИдентификаторПула - Произвольный - идентификатор пула.
//
// Возвращаемое значение:
//  Массив - заданные ЗадатьАпстримы источники; по умолчанию пусто.
//
Функция Все(Знач ИдентификаторПула) Экспорт
	Найдено = Апстримы_.Получить(Строка(ИдентификаторПула));
	Возврат ?(Найдено = Неопределено, Новый Массив(), Найдено);
КонецФункции

// Источники пула, которые разрешено опрашивать: включённые, в том же порядке.
//
// Параметры:
//  Пул - Произвольный - объект пула.
//
// Возвращаемое значение:
//  Массив - включённые источники.
//
Функция ДляОпроса(Знач Пул) Экспорт

	Результат = Новый Массив();
	Если Пул = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Апстрим Из Все(Пул.Идентификатор) Цикл
		Если Апстрим.Включён = Истина Тогда
			Результат.Добавить(Апстрим);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Задаёт источники пула.
//
// Параметры:
//  ИдентификаторПула - Произвольный - идентификатор пула.
//  Список - Массив - структуры Url, ВремяЖизниСек, Включён.
//
Процедура ЗадатьАпстримы(Знач ИдентификаторПула, Знач Список) Экспорт
	Апстримы_.Вставить(Строка(ИдентификаторПула), Список);
КонецПроцедуры

// Пул по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - добавленный пул.
//
Функция ПулПоИдентификатору(Знач Идентификатор) Экспорт
	Для Каждого Пул Из Пулы_ Цикл
		Если Цел(Пул.Идентификатор) = Цел(Идентификатор) Тогда
			Возврат Пул;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Пулы перечисленных идентификаторов.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пулов.
//
// Возвращаемое значение:
//  Соответствие - идентификатор -> пул; ненайденных нет.
//
Функция ПулыПоИдентификаторам(Знач Идентификаторы) Экспорт
	Результат = Новый Соответствие();
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Пул = ПулПоИдентификатору(Идентификатор);
		Если Пул <> Неопределено Тогда
			Результат.Вставить(Цел(Пул.Идентификатор), Пул);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Все пулы — в порядке, обратном добавлению: порядок выдачи наводит вызывающий.
//
// Возвращаемое значение:
//  Массив - добавленные пулы.
//
Функция ВсеПулы() Экспорт
	Результат = Новый Массив();
	Для Каждого Пул Из Пулы_ Цикл
		Результат.Вставить(0, Пул);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Тип личного пула.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТипЛичный() Экспорт
	Возврат "user";
КонецФункции

// Квота «как в хабе» для нового пула.
//
// Возвращаемое значение:
//  Число - -1.
//
Функция КвотаКакВХабе() Экспорт
	Возврат -1;
КонецФункции

// Заводит пул и запоминает вызов в Созданные.
//
// Параметры:
//  Имя - Строка - имя пула.
//  Тип - Строка - тип пула.
//  Видимость - Строка - public | private.
//  ВладелецИдентификатор - Число - хозяин пула.
//  КвотаМб - Число - квота пула.
//
// Возвращаемое значение:
//  Структура - Идентификатор, Имя, Тип, ВладелецИдентификатор.
//
Функция СоздатьПул(Знач Имя, Знач Тип, Знач Видимость, Знач ВладелецИдентификатор, Знач КвотаМб) Экспорт

	Созданные.Добавить(Новый Структура("Имя, Тип, Видимость, ВладелецИдентификатор, КвотаМб",
		Имя, Тип, Видимость, ВладелецИдентификатор, КвотаМб));

	Следующий = 1;
	Для Каждого Пул Из Пулы_ Цикл
		Следующий = Макс(Следующий, Цел(Пул.Идентификатор) + 1);
	КонецЦикла;
	Пул = Новый Структура("Идентификатор, Имя, Тип, ВладелецИдентификатор", Следующий, Имя, Тип,
		ВладелецИдентификатор);
	ДобавитьПул(Пул, Ложь);
	Возврат Пул;

КонецФункции

// Основной пул — последний назначенный через НазначитьПулПоУмолчанию.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - пул; Неопределено, если назначений не было.
//
Функция ДефолтныйПул() Экспорт
	Если Назначенные.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ПулПоИдентификатору(Назначенные[Назначенные.ВГраница()].ПулИдентификатор);
КонецФункции

// Запоминает вызов в Назначенные.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Кем - Строка - кто назначил (необязательный).
//
// Возвращаемое значение:
//  Произвольный, Неопределено - пул.
//
Функция НазначитьПулПоУмолчанию(Знач ПулИдентификатор, Знач Кем = "") Экспорт
	Назначенные.Добавить(Новый Структура("ПулИдентификатор, Кем", ПулИдентификатор, Кем));
	Возврат ПулПоИдентификатору(ПулИдентификатор);
КонецФункции

// Сносит пул; несносимый — исключение. Числа уборки различны, чтобы их нельзя было перепутать.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Структура - Имя и числа уборки: Пакетов, Артефактов, Доступов, Ролей, Подписок, Зеркал,
//              Апстримов, Заявок, Строк.
//
Функция УдалитьПул(Знач ПулИдентификатор) Экспорт

	Пул = ПулПоИдентификатору(ПулИдентификатор);
	Если Пул = Неопределено Тогда
		ВызватьИсключение "Пул не найден";
	КонецЕсли;
	Если Несносимые_.Получить(Пул.Имя) = Истина Тогда
		ВызватьИсключение "каталог пула закрыт на запись";
	КонецЕсли;

	Пулы_.Удалить(Пулы_.Найти(Пул));
	Удалённые.Добавить(Цел(Пул.Идентификатор));

	Возврат Новый Структура("Имя, Пакетов, Артефактов, Доступов, Ролей, Подписок, Зеркал, Апстримов, Заявок, Строк",
		Пул.Имя, 1, 2, 3, 4, 5, 6, 7, 8, 9);

КонецФункции

// Делает пул несносимым: УдалитьПул на нём бросает исключение.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
Процедура СорватьУдаление(Знач ИмяПула) Экспорт
	Несносимые_.Вставить(ИмяПула, Истина);
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Пулы_ = Новый Массив();
	САпстримами_ = Новый Соответствие();
	Апстримы_ = Новый Соответствие();
	КвотаХабаМб_ = 0;
	Несносимые_ = Новый Соответствие();
	Созданные = Новый Массив();
	Назначенные = Новый Массив();
	Удалённые = Новый Массив();
КонецПроцедуры
