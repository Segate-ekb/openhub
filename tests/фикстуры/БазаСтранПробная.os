// Фикстура: крошечная база стран (десяток строк того же вида, что и настоящая DB-IP Lite)
// и её адреса под рукой. Нужна и офлайн-наборам, и живому хабу с подложенной базой:
// настоящая база — тридцать мегабайт под чужой лицензией, в дереве её нет и не будет.
//
// «Российский» адрес взят из обычного публичного диапазона: документационные сети
// (203.0.113.0/24 и соседи) политика своей сети считает непригодными для интернета,
// и до базы такой адрес не доходит вовсе.

#Область ГдеЛежит

// Полное имя файла пробной базы.
//
// Возвращаемое значение:
//  Строка.
//
Функция Путь() Экспорт
	Возврат ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "гео",
		"dbip-country-lite-проба.csv");
КонецФункции

// Строки пробной базы как есть.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Строки() Экспорт

	Чтение = Новый ЧтениеТекста(Путь(), "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Результат = Новый Массив();
	Для Каждого Строчка Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Строчка)) Тогда
			Результат.Добавить(СокрЛП(Строчка));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Кладёт пробную базу по названному пути — так её подкладывают живому хабу.
//
// Параметры:
//  Куда - Строка - полное имя файла базы; каталог создаётся.
//
// Возвращаемое значение:
//  Строка - тот же путь.
//
Функция Положить(Знач Куда) Экспорт
	Возврат Написать(Куда, Строки());
КонецФункции

// Кладёт по названному пути свой набор строк — для наборов, которым нужна база
// вперемешку, с битыми строками или без наблюдаемых стран.
//
// Параметры:
//  Куда - Строка - полное имя файла базы; каталог создаётся.
//  Строчки - Массив из Строка - содержимое файла.
//
// Возвращаемое значение:
//  Строка - тот же путь.
//
Функция Написать(Знач Куда, Знач Строчки) Экспорт

	Каталог = Новый Файл(Куда).Путь;
	Если ЗначениеЗаполнено(Каталог) И НЕ Новый Файл(Каталог).Существует() Тогда
		СоздатьКаталог(Каталог);
	КонецЕсли;

	Запись = Новый ЗаписьТекста(Куда, "UTF-8");
	Для Каждого Строчка Из Строчки Цикл
		Запись.ЗаписатьСтроку(Строчка);
	КонецЦикла;
	Запись.Закрыть();

	Возврат Куда;

КонецФункции

#КонецОбласти

#Область АдресаПробнойБазы

// Публичный адрес, который пробная база зовёт Россией.
//
// Возвращаемое значение:
//  Строка.
//
Функция РоссийскийIPv4() Экспорт
	Возврат "95.213.7.7";
КонецФункции

// Первый адрес российского диапазона IPv4.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПервыйРоссийскийIPv4() Экспорт
	Возврат "95.213.0.0";
КонецФункции

// Последний адрес российского диапазона IPv4.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПоследнийРоссийскийIPv4() Экспорт
	Возврат "95.213.255.255";
КонецФункции

// Публичный адрес IPv6, который пробная база зовёт Россией.
//
// Возвращаемое значение:
//  Строка.
//
Функция РоссийскийIPv6() Экспорт
	Возврат "2a02:6b8::1";
КонецФункции

// Публичный адрес, который пробная база зовёт Германией.
//
// Возвращаемое значение:
//  Строка.
//
Функция НемецкийIPv4() Экспорт
	Возврат "95.214.0.5";
КонецФункции

// Служебный адрес IPv6, который база относит к Швейцарии: на нём проверяется, что своя
// сеть судится ДО базы.
//
// Возвращаемое значение:
//  Строка.
//
Функция СоседПетлиИзШвейцарии() Экспорт
	Возврат "fec0::1";
КонецФункции

// Все служебные адреса IPv6, которые база отдаёт настоящей стране. В выпуске 2026-09
// таких дыр десять: семь в блоке назначений протоколов IETF («2001::/23», вперемешку
// США и Швейцария), документационная «3fff::/20» и «5f00::/16» за Швейцарией, а в хвосте —
// «fe00::–fe7f:…» и «fec0::–ffff:…» тоже за Швейцарией. Пробная база повторяет их строками
// данных, чтобы контроль «база и вправду зовёт этот адрес страной» был настоящим.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция СлужебныеДырыIPv6() Экспорт

	Возврат СтрРазделить("2001::1,2001:1::1,2001:2::1,2001:3::1,2001:10::1,2001:20::1,"
		+ "2001:30::1,3fff::1,5f00::1,fe00::1,fe40::1,fec0::1", ",");

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
КонецПроцедуры
