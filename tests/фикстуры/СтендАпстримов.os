// Стенд источников пула: строкой в хранилище — для фона сценария, службой СервисАпстримовПула —
// с каноном адреса, пробой и порядком обхода.

Перем Контейнер;

// Заводит апстрим пула строкой в хранилище.
//
// Параметры:
//  ПулИлиИдентификатор - Пул, Число - пул, которому принадлежит источник.
//  Url - Строка - базовый URL выдачи источника (необязательный, по умолчанию
//        "http://upstream.invalid/download/").
//  Порядок - Число - позиция в порядке обхода, меньше — раньше (необязательный,
//            по умолчанию 0).
//  ВремяЖизниСек - Число - TTL кэша изменяемых ресурсов, секунды (необязательный,
//                  по умолчанию 900).
//  Включён - Булево - опрашивается ли источник выдачей (необязательный, по умолчанию
//            Истина).
//
// Возвращаемое значение:
//  АпстримПула - сохранённая строка источника.
//
Функция Апстрим(Знач ПулИлиИдентификатор, Знач Url = "http://upstream.invalid/download/",
	Знач Порядок = 0, Знач ВремяЖизниСек = 900, Знач Включён = Истина) Экспорт

	Запись = Контейнер.НайтиЖелудь("ХранилищеАпстримовПула").СоздатьЭлемент();
	Запись.ПулИдентификатор = ПомощникиСтендов.Идентификатор(ПулИлиИдентификатор);
	Запись.Порядок = Цел(Порядок);
	Запись.Url = Url;
	Запись.ТокенДоступа = "";
	Запись.ВремяЖизниСек = Цел(ВремяЖизниСек);
	Запись.СписокРазрешенийJSON = "";
	Запись.Включён = Включён;
	Запись.ПоследняяСинхронизация = '00010101000000';
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

// Заводит апстрим руками хаба — СервисАпстримовПула, как это делает экран источников пула.
//
// Параметры:
//  Пул - Пул - пул, которому заводится источник; его тип решает судьбу заведения.
//  Url - Строка - базовый URL выдачи источника (необязательный, по умолчанию
//        "http://upstream.invalid/download/").
//  ВремяЖизниСек - Число - TTL кэша изменяемых ресурсов, секунды (необязательный,
//                  по умолчанию 900).
//
// Возвращаемое значение:
//  АпстримПула - заведённая запись источника.
//
Функция АпстримСлужбой(Знач Пул, Знач Url = "http://upstream.invalid/download/",
	Знач ВремяЖизниСек = 900) Экспорт

	Возврат Контейнер.НайтиЖелудь("СервисАпстримовПула").Записать(Пул, Url, Цел(ВремяЖизниСек));

КонецФункции

Процедура ПриСозданииОбъекта(Знач Поделка)
	Контейнер = Поделка;
КонецПроцедуры
