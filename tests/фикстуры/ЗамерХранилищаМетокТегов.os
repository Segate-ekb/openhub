// ХранилищеМетокТегов в памяти, считающее ОБРАЩЕНИЯ и ПРОЧИТАННЫЕ СТРОКИ: состав ручных
// каналов спрашивался по разу на тег, и цена вкладки версий росла числом каналов пакета.

Перем Записи;      // Массив из Структура — метки тегов
Перем СчётСтрок;
Перем СчётЗапросов;

#Область Счётчики

// Сколько строк меток хранилище отдало с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Строк() Экспорт
	Возврат СчётСтрок;
КонецФункции

// Сколько запросов к хранилищу ушло с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Запросов() Экспорт
	Возврат СчётЗапросов;
КонецФункции

// Обнуляет счётчики, оставляя фактуру.
Процедура Обнулить() Экспорт
	СчётСтрок = 0;
	СчётЗапросов = 0;
КонецПроцедуры

#КонецОбласти

#Область НаполнениеФикстуры

// Помечает версию тегом (за обращение не считается).
//
// Параметры:
//  ТегИдентификатор - Число - идентификатор тега.
//  ВерсияИдентификатор - Число - идентификатор версии.
//
Процедура Пометить(Знач ТегИдентификатор, Знач ВерсияИдентификатор) Экспорт

	Записи.Добавить(Новый Структура("Идентификатор, ТегИдентификатор, ВерсияИдентификатор",
		Записи.Количество() + 1, Цел(ТегИдентификатор), Цел(ВерсияИдентификатор)));

КонецПроцедуры

#КонецОбласти

#Область КонтрактХранилища

// Состав одного тега.
//
// Параметры:
//  ТегИдентификатор - Число - идентификатор тега.
//
// Возвращаемое значение:
//  Массив - метки тега.
//
Функция ПолучитьПоТегИдентификаторРавно(Знач ТегИдентификатор) Экспорт

	Список = Новый Массив();
	Список.Добавить(Цел(ТегИдентификатор));
	Возврат Отдать(ПоТегам(Список));

КонецФункции

// Состав перечисленных тегов одним отбором.
//
// Параметры:
//  ТегИдентификаторы - Массив из Число - идентификаторы тегов.
//
// Возвращаемое значение:
//  Массив - метки всех перечисленных тегов.
//
Функция СоставТегов(Знач ТегИдентификаторы) Экспорт
	Возврат Отдать(ПоТегам(ТегИдентификаторы));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПоТегам(Знач ТегИдентификаторы)

	Нужные = Новый Соответствие();
	Для Каждого Номер Из ТегИдентификаторы Цикл
		Нужные.Вставить(Цел(Номер), Истина);
	КонецЦикла;

	Отобранные = Новый Массив();
	Для Каждого Строка_ Из Записи Цикл
		Если Нужные.Получить(Строка_.ТегИдентификатор) = Истина Тогда
			Отобранные.Добавить(Строка_);
		КонецЕсли;
	КонецЦикла;
	Возврат Отобранные;

КонецФункции

Функция Отдать(Знач Строки)

	СчётЗапросов = СчётЗапросов + 1;
	СчётСтрок = СчётСтрок + Строки.Количество();
	Возврат Строки;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	СчётСтрок = 0;
	СчётЗапросов = 0;
КонецПроцедуры
