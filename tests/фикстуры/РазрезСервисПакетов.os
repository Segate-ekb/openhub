// СервисПакетов в памяти, считающий ПРОЧИТАННЫЕ СТРОКИ: «все пакеты хаба» и «пакеты
// названных пулов» стоят одного запроса каждый, а различаются объёмом выдачи — цена
// экрана росла именно им, а не числом обращений.

Перем Пакеты;         // Массив из Структура (Идентификатор, ПулИдентификатор, Имя, …)
Перем СчётСтрок;
Перем СчётЗапросов;

#Область Счётчики

// Сколько строк пакетов сервис отдал с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Строк() Экспорт
	Возврат СчётСтрок;
КонецФункции

// Сколько запросов к сервису ушло с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Запросов() Экспорт
	Возврат СчётЗапросов;
КонецФункции

#КонецОбласти

// Заводит пакет (наполнение фикстуры; за обращение не считается).
//
// Параметры:
//  Идентификатор - Число - идентификатор пакета.
//  ПулИдентификатор - Число - пул пакета.
//  Имя - Строка - имя пакета.
//  Скрыт - Булево - скрыт ли пакет от выдачи (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура - заведённый пакет.
//
Функция ДобавитьПакет(Знач Идентификатор, Знач ПулИдентификатор, Знач Имя, Знач Скрыт = Ложь) Экспорт

	Пакет = Новый Структура("Идентификатор, ПулИдентификатор, Имя, ИмяНижнийРегистр,"
		+ " Описание, КлючевыеСлова, Устарел, Скрыт, Создан",
		Цел(Идентификатор), Цел(ПулИдентификатор), Имя, НРег(Имя),
		"", "", Ложь, Скрыт, Дата(2026, 1, 1, 0, 0, 0));
	Пакеты.Добавить(Пакет);
	Возврат Пакет;

КонецФункции

// Все пакеты хаба — дверь, через которую цена выдачи росла числом чужих пакетов.
//
// Возвращаемое значение:
//  Массив - все заведённые пакеты.
//
Функция ВсеПакеты() Экспорт
	Возврат Отдать(Пакеты);
КонецФункции

// Пакеты перечисленных пулов.
//
// Параметры:
//  ПулИдентификаторы - Массив из Число - идентификаторы пулов.
//
// Возвращаемое значение:
//  Массив - пакеты названных пулов.
//
Функция ПакетыПулов(Знач ПулИдентификаторы) Экспорт

	Названные = Новый Соответствие();
	Для Каждого ПулИдентификатор Из ПулИдентификаторы Цикл
		Названные.Вставить(Цел(ПулИдентификатор), Истина);
	КонецЦикла;

	Отобранные = Новый Массив();
	Для Каждого Пакет Из Пакеты Цикл
		Если Названные.Получить(Пакет.ПулИдентификатор) <> Неопределено Тогда
			Отобранные.Добавить(Пакет);
		КонецЕсли;
	КонецЦикла;
	Возврат Отдать(Отобранные);

КонецФункции

Функция Отдать(Знач Строки)

	СчётЗапросов = СчётЗапросов + 1;
	СчётСтрок = СчётСтрок + Строки.Количество();
	Возврат Строки;

КонецФункции

Процедура ПриСозданииОбъекта()
	Пакеты = Новый Массив();
	СчётСтрок = 0;
	СчётЗапросов = 0;
КонецПроцедуры
