// Фикстура: подставной SMTP-сервер для живых стендов. Занимает свой порт до старта хаба,
// принимает письмо и отдаёт его текст тесту — настоящего почтового сервера у стендов нет.
//
// ⚠ Ловушка НЕ аутентифицирует: команды AUTH она не объявляет и не понимает. Стенд,
// поднятый с OSHUB_MAIL_SMTP_USER и OSHUB_MAIL_SMTP_PASSWORD, об неё сломается.
// ⚠ ОжидатьСоединения выжидает свой таймаут ЦЕЛИКОМ, поэтому ждём короткими ломтями,
// а не одним куском на всё терпение теста.

Перем Выдача;
Перем Сервер;
Перем НомерПорта;
Перем ПолучательПоследнего; // адрес из RCPT TO последнего пойманного письма

#Область ЖизненныйЦикл

Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ВыдачаПортов");
	Выдача = Новый ВыдачаПортов();
	НомерПорта = 0;
	ПолучательПоследнего = "";

КонецПроцедуры

// Занимает свободный порт и начинает слушать. Зовётся ДО запуска хаба: письмо, посланное
// на занятый порт, ждёт приёма в очереди ОС, а на свободный — отвергается сразу.
//
// Возвращаемое значение:
//  Число - порт, на котором ловушка слушает.
//
Функция Слушать() Экспорт

	НомерПорта = Выдача.Выдать();
	Сервер = Новый TCPСервер(НомерПорта);
	Сервер.Запустить();

	Возврат НомерПорта;

КонецФункции

// Закрывает порт и возвращает его в оборот. Идемпотентна.
//
Процедура Остановить() Экспорт

	Если Сервер <> Неопределено Тогда
		Попытка
			Сервер.Остановить();
		Исключение
			// порт всё равно освободится вместе с процессом прогона
		КонецПопытки;
		Сервер = Неопределено;
	КонецЕсли;

	Выдача.ВернутьВсе();
	НомерПорта = 0;

КонецПроцедуры

#КонецОбласти

#Область ПриёмПисьма

// Принимает одно письмо и отдаёт его целиком — заголовки и тело, как их прислал хаб.
//
// Параметры:
//  ТаймаутСек - Число - сколько ждать письма (необязательный, по умолчанию 60).
//
// Возвращаемое значение:
//  Строка - письмо целиком; пустая строка — за отведённое время письма не было.
//
Функция ДождатьсяПисьма(Знач ТаймаутСек = 60) Экспорт

	ПолучательПоследнего = "";

	Соединение = ДождатьсяСоединения(ТаймаутСек);
	Если Соединение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Письмо = ПровестиРазговор(Соединение);
	Исключение
		ЗакрытьТихо(Соединение);
		ВызватьИсключение;
	КонецПопытки;

	ЗакрытьТихо(Соединение);

	Возврат Письмо;

КонецФункции

// Кому хаб ВЕЛЕЛ доставить последнее письмо: адрес из конверта SMTP (RCPT TO). Заголовок
// To: письма пишет сам отправитель, а доставку решает конверт.
//
// Возвращаемое значение:
//  Строка - адрес получателя; пустая строка — письма не было либо конверт его не назвал.
//
Функция ПолучательКонверта() Экспорт
	Возврат ПолучательПоследнего;
КонецФункции

// Значение ссылки из пойманного письма: то, что человек в почте видит после token=.
//
// Параметры:
//  Письмо - Строка - письмо целиком.
//
// Возвращаемое значение:
//  Строка - значение токена; пустая строка — ссылки в письме нет.
//
Функция ТокенИзПисьма(Знач Письмо) Экспорт

	Маркер = "token=";
	Позиция = СтрНайти(Письмо, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Письмо, Позиция + СтрДлина(Маркер));
	Возврат СокрЛП(ПервоеСлово(Хвост));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ломтями, а не одним долгим ожиданием: ОжидатьСоединения высиживает отпущенное ему
// время целиком, даже когда соединение пришло в первую же миллисекунду.
Функция ДождатьсяСоединения(Знач ТаймаутСек)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСек * 1000;

	Пока Истина Цикл
		Соединение = Сервер.ОжидатьСоединения(ЛомотьОжиданияМс());
		Если Соединение <> Неопределено Тогда
			Возврат Соединение;
		КонецЕсли;
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

КонецФункции

Функция ЛомотьОжиданияМс()
	Возврат 200;
КонецФункции

// Предел одного разговора: клиент, замолчавший на полуслове, не вешает прогон.
Функция ПределРазговораМс()
	Возврат 120000;
КонецФункции

Функция ТаймаутЧтенияМс()
	Возврат 30000;
КонецФункции

// Минимальный SMTP: поздороваться, принять конверт, забрать тело до строки с точкой.
Функция ПровестиРазговор(Соединение)

	Соединение.ТаймаутЧтения = ТаймаутЧтенияМс();
	Ответить(Соединение, "220 oshub-ловушка ESMTP");

	Разговор = НачалоРазговора();
	Остаток = "";
	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ПределРазговораМс();

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл

		Кусок = Прочитать(Соединение);
		Если Кусок = Неопределено Тогда
			Прервать;
		КонецЕсли;

		Разбор = РазобратьНаСтроки(Остаток + Кусок);
		Остаток = Разбор.Остаток;

		Для Каждого Строка_ Из Разбор.Строки Цикл
			Разговор = ШагРазговора(Соединение, Строка_, Разговор);
			Если Разговор.Окончен Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если Разговор.Окончен Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	ПолучательПоследнего = Разговор.Получатель;

	Возврат Разговор.Письмо;

КонецФункции

// Одна строка разговора: отвечает клиенту и отдаёт новое состояние разговора.
Функция ШагРазговора(Соединение, Знач Строка_, Знач Разговор)

	Если Разговор.ВТеле Тогда
		Если Строка_ = "." Тогда
			Ответить(Соединение, "250 письмо принято");
			Возврат ТелоКончилось(Разговор);
		КонецЕсли;
		Возврат СтрокаТела(Разговор, Строка_);
	КонецЕсли;

	Команда = ВРег(Строка_);

	Если СтрНачинаетсяС(Команда, "EHLO") Тогда
		Ответить(Соединение, "250-oshub-ловушка");
		// 8BITMIME — строка несущая: без неё MimeKit переводит кириллическое тело
		// в quoted-printable, и ссылка приезжает поломанной («token=3D…»)
		Ответить(Соединение, "250 8BITMIME");
	ИначеЕсли СтрНачинаетсяС(Команда, "RCPT TO") Тогда
		Ответить(Соединение, "250 принято");
		Возврат КонвертНазванный(Разговор, АдресКонверта(Строка_));
	ИначеЕсли Команда = "DATA" Тогда
		Ответить(Соединение, "354 диктуйте");
		Возврат ТелоНачалось(Разговор);
	ИначеЕсли Команда = "QUIT" Тогда
		Ответить(Соединение, "221 до свидания");
		Возврат РазговорОкончен(Разговор);
	Иначе
		// HELO, MAIL FROM, RSET и прочее: ловушка не привередлива
		Ответить(Соединение, "250 принято");
	КонецЕсли;

	Возврат Разговор;

КонецФункции

// Адрес из команды конверта: RCPT TO:<кому@…>, иногда с параметрами за скобкой.
Функция АдресКонверта(Знач Строка_)

	Открывающая = СтрНайти(Строка_, "<");
	Закрывающая = СтрНайти(Строка_, ">");
	Если Открывающая > 0 И Закрывающая > Открывающая Тогда
		Возврат Сред(Строка_, Открывающая + 1, Закрывающая - Открывающая - 1);
	КонецЕсли;

	Двоеточие = СтрНайти(Строка_, ":");
	Возврат ?(Двоеточие = 0, "", СокрЛП(Сред(Строка_, Двоеточие + 1)));

КонецФункции

Функция НачалоРазговора()
	Возврат СостояниеРазговора("", Ложь, Ложь, "");
КонецФункции

Функция КонвертНазванный(Знач Прежнее, Знач Получатель)
	Возврат СостояниеРазговора(Прежнее.Письмо, Прежнее.ВТеле, Ложь, Получатель);
КонецФункции

Функция ТелоНачалось(Знач Прежнее)
	Возврат СостояниеРазговора(Прежнее.Письмо, Истина, Ложь, Прежнее.Получатель);
КонецФункции

Функция СтрокаТела(Знач Прежнее, Знач Строка_)
	Возврат СостояниеРазговора(Прежнее.Письмо + Строка_ + Символы.ПС, Истина, Ложь,
		Прежнее.Получатель);
КонецФункции

Функция ТелоКончилось(Знач Прежнее)
	Возврат СостояниеРазговора(Прежнее.Письмо, Ложь, Ложь, Прежнее.Получатель);
КонецФункции

Функция РазговорОкончен(Знач Прежнее)
	Возврат СостояниеРазговора(Прежнее.Письмо, Ложь, Истина, Прежнее.Получатель);
КонецФункции

// Единственное место, где состояние разговора собирается: снаружи его зовут по имени
// шага, а не четырьмя значениями подряд.
Функция СостояниеРазговора(Знач Письмо, Знач ВТеле, Знач Окончен, Знач Получатель)
	Возврат Новый Структура("Письмо, ВТеле, Окончен, Получатель",
		Письмо, ВТеле, Окончен, Получатель);
КонецФункции

// ПрочитатьСтроку отдаёт не строку, а то, что принесло соединение: команды приезжают
// по одной, а всё тело письма — одним куском с переводами строк внутри и точкой конца
// в хвосте того же куска (замер: 520 символов, 15 переводов). Поэтому строки собираются
// здесь, а недочитанный хвост ждёт следующего куска.
Функция РазобратьНаСтроки(Знач Накопленное)

	Строки = Новый Массив();
	Части = СтрРазделить(Накопленное, Символы.ПС, Истина);

	Для Индекс = 0 По Части.Количество() - 2 Цикл
		Строки.Добавить(СтрЗаменить(Части[Индекс], Символы.ВК, ""));
	КонецЦикла;

	Возврат Новый Структура("Строки, Остаток", Строки, Части[Части.Количество() - 1]);

КонецФункции

Функция Прочитать(Соединение)
	Попытка
		Возврат Соединение.ПрочитатьСтроку();
	Исключение
		Возврат Неопределено; // отвалившееся соединение — это конец разговора, а не сбой
	КонецПопытки;
КонецФункции

// Перевод строки у ответа обязателен: без него клиент ждёт продолжения ответа вечно.
Процедура Ответить(Соединение, Знач Текст)
	Соединение.ОтправитьСтроку(Текст + Символы.ВК + Символы.ПС);
КонецПроцедуры

Процедура ЗакрытьТихо(Соединение)
	Попытка
		Соединение.Закрыть();
	Исключение
		// клиент мог отсоединиться первым
	КонецПопытки;
КонецПроцедуры

// Ссылка заканчивается там, где кончается непрерывный кусок текста.
Функция ПервоеСлово(Знач Текст)

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = " " ИЛИ Символ = Символы.ПС ИЛИ Символ = Символы.ВК
			ИЛИ Символ = Символы.Таб Тогда
			Возврат Лев(Текст, Позиция - 1);
		КонецЕсли;
	КонецЦикла;

	Возврат Текст;

КонецФункции

#КонецОбласти
