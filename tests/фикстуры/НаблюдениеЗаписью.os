// Приёмник среза метрики: запоминает записанное. Контракт ОтелНаблюдениеМетрики
// в объёме, которым пользуются приборы хаба.

Перем Записи;

#Область ПубличныйИнтерфейс

// Контракт наблюдения: записать значение среза.
//
// Параметры:
//  Значение - Число - значение прибора.
//  Атрибуты - Произвольный - атрибуты точки данных (необязательный).
//
Функция Записать(Знач Значение, Знач Атрибуты = Неопределено) Экспорт

	Записи.Добавить(Значение);

	Возврат ЭтотОбъект;

КонецФункции

// Сколько раз прибор записал значение.
//
// Возвращаемое значение:
//  Число - число записей; ноль означает разрыв в ряду.
//
Функция Количество() Экспорт
	Возврат Записи.Количество();
КонецФункции

// Последнее записанное значение.
//
// Возвращаемое значение:
//  Число - значение; Неопределено, если не записывали.
//
Функция Записанное() Экспорт
	Возврат ?(Записи.Количество() = 0, Неопределено, Записи[Записи.ВГраница()]);
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
КонецПроцедуры
