// Приёмник среза метрики: запоминает записанное вместе с атрибутами точки данных.
// Контракт ОтелНаблюдениеМетрики в объёме, которым пользуются приборы хаба.

Перем Записи;   // Массив из Структура(Значение, Атрибуты)

#Область ПубличныйИнтерфейс

// Контракт наблюдения: записать значение среза.
//
// Параметры:
//  Значение - Число - значение прибора.
//  Атрибуты - ОтелАтрибуты - атрибуты точки данных (необязательный).
//
Функция Записать(Знач Значение, Знач Атрибуты = Неопределено) Экспорт

	Записи.Добавить(Новый Структура("Значение, Атрибуты", Значение, Атрибуты));

	Возврат ЭтотОбъект;

КонецФункции

// Сколько раз прибор записал значение.
//
// Возвращаемое значение:
//  Число - число точек данных; ноль означает разрыв в ряду.
//
Функция Количество() Экспорт
	Возврат Записи.Количество();
КонецФункции

// Последнее записанное значение.
//
// Возвращаемое значение:
//  Число - значение; Неопределено, если не записывали.
//
Функция Записанное() Экспорт
	Возврат ?(Записи.Количество() = 0, Неопределено, Записи[Записи.ВГраница()].Значение);
КонецФункции

// Значение точки данных, чей атрибут равен названному; Неопределено — такой точки нет.
// Своя точка данных у каждой комбинации атрибутов, и разрез по пулу виден только так.
//
// Параметры:
//  Ключ - Строка - ключ атрибута.
//  Значение - Строка - значение атрибута.
//
// Возвращаемое значение:
//  Число, Неопределено.
//
Функция ЗаписанноеСАтрибутом(Знач Ключ, Знач Значение) Экспорт

	Для Каждого Запись Из Записи Цикл
		Если Запись.Атрибуты <> Неопределено
			И Запись.Атрибуты.Получить(Ключ) = Значение Тогда
			Возврат Запись.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
КонецПроцедуры
