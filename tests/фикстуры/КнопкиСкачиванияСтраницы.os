// Фикстура: кнопки скачивания, вычитанные из разметки страницы пакета. Кнопка — значок,
// поэтому имя обещанного файла читается только из её доступного имени.

// Все кнопки скачивания страницы в порядке печати.
//
// Параметры:
//  Разметка - Строка - HTML страницы пакета.
//
// Возвращаемое значение:
//  Массив из Структура - Адрес (Строка, значение href) и Файл (Строка, имя артефакта,
//  которое кнопка обещает доступным именем).
//
Функция Все(Знач Разметка) Экспорт

	Результат = Новый Массив();
	Маркер = "<a href=""";
	Хвост = Разметка;

	Начало = СтрНайти(Хвост, Маркер);
	Пока Начало > 0 Цикл

		Хвост = Сред(Хвост, Начало + СтрДлина(Маркер));
		ОткрывающийТег = Лев(Хвост, СтрНайти(Хвост, ">"));
		ИмяФайла = ОбещанныйФайл(ОткрывающийТег);

		Если ЗначениеЗаполнено(ИмяФайла) Тогда
			Результат.Добавить(Новый Структура("Адрес, Файл",
				Лев(Хвост, СтрНайти(Хвост, """") - 1), ИмяФайла));
		КонецЕсли;

		Начало = СтрНайти(Хвост, Маркер);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Кнопка скачивания с заданным адресом.
//
// Параметры:
//  Разметка - Строка - HTML страницы пакета.
//  Адрес - Строка - искомое значение href.
//
// Возвращаемое значение:
//  Структура, Неопределено - кнопка либо Неопределено, если такой на странице нет.
//
Функция ПоАдресу(Знач Разметка, Знач Адрес) Экспорт

	Для Каждого Кнопка Из Все(Разметка) Цикл
		Если Кнопка.Адрес = Адрес Тогда
			Возврат Кнопка;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Признак кнопки скачивания в её доступном имени: по нему она и отличается от прочих
// ссылок страницы.
Функция ПризнакВДоступномИмени()
	Возврат "aria-label=""Скачать ";
КонецФункции

// Имя файла из доступного имени ссылки; пустая строка — ссылка не кнопка скачивания.
Функция ОбещанныйФайл(Знач ОткрывающийТег)

	Начало = СтрНайти(ОткрывающийТег, ПризнакВДоступномИмени());
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(ОткрывающийТег, Начало + СтрДлина(ПризнакВДоступномИмени()));
	Конец = СтрНайти(Хвост, """");
	Возврат ?(Конец = 0, "", Лев(Хвост, Конец - 1));

КонецФункции

Процедура ПриСозданииОбъекта()
КонецПроцедуры
