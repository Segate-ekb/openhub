// Заглушка ИздателяСобытий для тестов настроек: запоминает опубликованные события целиком
// (по ним проверяется принципал мутации).

Перем События; // Массив из Структура(Тип, Данные)

// Контракт ИздателяСобытий: тип события об изменении настройки.
//
// Возвращаемое значение:
//  Строка - "настройка.изменена".
//
Функция ТипНастройкаИзменена() Экспорт
	Возврат "настройка.изменена";
КонецФункции

// Контракт ИздателяСобытий: запоминает событие целиком, никому его не рассылая.
//
// Параметры:
//  ТипСобытия - Строка - тип события.
//  Данные - Структура - полезная нагрузка (необязательный, по умолчанию Неопределено —
//   запоминается пустая структура).
//  Момент - Дата - момент события; заглушкой не используется (необязательный,
//   по умолчанию Неопределено).
//
Процедура Опубликовать(Знач ТипСобытия, Знач Данные = Неопределено, Знач Момент = Неопределено) Экспорт
	События.Добавить(Новый Структура("Тип, Данные", ТипСобытия,
		?(Данные = Неопределено, Новый Структура(), Данные)));
КонецПроцедуры

// Все опубликованные события в порядке публикации.
//
// Возвращаемое значение:
//  Массив из Структура (Тип, Данные).
//
Функция Опубликованные() Экспорт
	Возврат События;
КонецФункции

// Автор последнего события — поле «Кто» его полезной нагрузки.
//
// Возвращаемое значение:
//  Строка - пусто, если событий не было либо автор не указан.
//
Функция ПоследнийАвтор() Экспорт

	Перем Кто;

	Если События.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Данные = События[События.Количество() - 1].Данные;
	Кто = "";
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("Кто", Кто) Тогда
		Возврат ?(Кто = Неопределено, "", Строка(Кто));
	КонецЕсли;
	Возврат "";

КонецФункции

// Очищает накопитель событий.
Процедура Очистить() Экспорт
	События.Очистить();
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	События = Новый Массив();
КонецПроцедуры
