// Фейк СервисаЗеркал для тестов синхронизатора: перечень включённых зеркал без обращения к БД.

Перем Зеркала;

// Добавляет зеркало в перечень включённых.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - запись зеркала.
//
Процедура Добавить(Знач Зеркало) Экспорт
	Зеркала.Добавить(Зеркало);
КонецПроцедуры

// Контракт СервисаЗеркал: включённые зеркала.
//
// Возвращаемое значение:
//  Массив из ЗеркалоХаба - записи в порядке добавления.
//
Функция ВключённыеЗеркала() Экспорт
	Возврат Зеркала;
КонецФункции

Процедура ПриСозданииОбъекта()
	Зеркала = Новый Массив();
КонецПроцедуры
