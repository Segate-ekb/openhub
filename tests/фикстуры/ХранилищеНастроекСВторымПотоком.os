// Хранилище прикладных настроек, которое во время чтения оговорённого ключа пускает к сервису
// ВТОРОЙ поток с тем же вопросом и дожидается его ответа. Шов для теста: ответ второго потока
// показывает, чьё состояние у разрешения настройки — одного вызова или всего процесса.
// Значения хранит соседняя заглушка, этой достаётся только пропуск потока.

Перем Записи;      // ХранилищеНастроекВПамяти — где на самом деле лежат значения
Перем Сервис;      // СервисНастроек, которому второй поток задаёт свой вопрос
Перем КлючПропуска; // ключ, чтение которого пускает второй поток
Перем Пущен;       // второй поток пускается один раз: он приходит в это же хранилище
Перем ОтветПотока; // что второй поток получил от сервиса
Перем ПотокУспел;  // Булево — уложился ли второй поток в таймаут ожидания

#Область НастройкаШва

// Открывает шов: чтение этого ключа пустит второй поток с вопросом о нём же.
//
// Параметры:
//  СервисНастроек - Произвольный - сервис, которому второй поток задаёт вопрос.
//  Ключ - Строка - ключ, чтение которого открывает второй поток.
//
Процедура ПуститьПотокНаКлюче(Знач СервисНастроек, Знач Ключ) Экспорт
	Сервис = СервисНастроек;
	КлючПропуска = Ключ;
КонецПроцедуры

// Кладёт значение, которое сервис прочитает «из базы».
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//  Значение - Произвольный - значение; хранится строкой.
//
Процедура Положить(Знач Ключ, Знач Значение) Экспорт
	Записи.Установить(Ключ, Значение, "тест", ТекущаяУниверсальнаяДата());
КонецПроцедуры

// Ответ, полученный вторым потоком.
//
// Возвращаемое значение:
//  Произвольный - значение настройки глазами второго потока; Неопределено, если он не ходил.
//
Функция ОтветВторогоПотока() Экспорт
	Возврат ОтветПотока;
КонецФункции

// Уложился ли второй поток в таймаут ожидания.
//
// Возвращаемое значение:
//  Булево - Ложь, если поток не пускали либо он не ответил вовремя.
//
Функция ВторойПотокУспел() Экспорт
	Возврат ПотокУспел;
КонецФункции

#КонецОбласти

#Область КонтрактХранилища

// Значение прикладной настройки; на оговорённом ключе сперва отрабатывает второй поток.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка, Неопределено - значение либо Неопределено, если записи нет.
//
Функция Значение(Знач Ключ) Экспорт

	Если Ключ = КлючПропуска И НЕ Пущен Тогда
		Пущен = Истина;
		ПуститьВторойПоток();
	КонецЕсли;

	Возврат Записи.Значение(Ключ);

КонецФункции

// Записывает значение ключа.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//  Значение - Произвольный - значение; хранится строкой.
//  Кто - Произвольный - принципал мутации.
//  Когда - Дата - момент записи.
//
Процедура Установить(Знач Ключ, Знач Значение, Знач Кто, Знач Когда) Экспорт
	Записи.Установить(Ключ, Значение, Кто, Когда);
КонецПроцедуры

// Удаляет запись ключа; отсутствие записи не ошибка.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
Процедура Удалить(Знач Ключ) Экспорт
	Записи.Удалить(Ключ);
КонецПроцедуры

#КонецОбласти

// Контракт обработчика фонового задания: тот же вопрос сервису, но из своего потока.
Процедура Исполнить() Экспорт
	ОтветПотока = Сервис.Значение(КлючПропуска);
КонецПроцедуры

// Ожидание с таймаутом, а не навсегда: набор обязан покраснеть, а не повиснуть,
// если второй поток заперт замком того, кто его пустил.
Процедура ПуститьВторойПоток()
	Задание = ФоновыеЗадания.Выполнить(ЭтотОбъект, "Исполнить");
	ПотокУспел = Задание.ОжидатьЗавершения(10000);
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач ХранилищеЗначений)
	Записи = ХранилищеЗначений;
	КлючПропуска = "";
	Пущен = Ложь;
	ПотокУспел = Ложь;
КонецПроцедуры
