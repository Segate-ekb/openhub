// Управляемые часы для тестов планировщика: контракт os-scheduler (Сейчас() -> Дата),
// момент двигает тест. Библиотека своих часов наружу не отдаёт — двойник живёт здесь.

Перем Момент_; // Дата

Процедура ПриСозданииОбъекта(НачальныйМомент = Неопределено)

	Момент_ = ?(НачальныйМомент = Неопределено, Дата(2026, 1, 1, 12, 0, 0), НачальныйМомент);

КонецПроцедуры

// Текущий момент управляемых часов.
//
// Возвращаемое значение:
//  Дата.
//
Функция Сейчас() Экспорт
	Возврат Момент_;
КонецФункции

// Устанавливает момент времени.
//
// Параметры:
//  Момент - Дата - новый момент.
//
Процедура УстановитьМомент(Знач Момент) Экспорт
	Момент_ = Момент;
КонецПроцедуры

// Продвигает часы вперёд.
//
// Параметры:
//  Секунд - Число - на сколько секунд продвинуть.
//
Процедура Прибавить(Знач Секунд) Экспорт
	Момент_ = Момент_ + Секунд;
КонецПроцедуры
