// Наблюдатель источника данных, считающий ОПЕРАЦИИ по таблицам: сторож цены прохода,
// которому важно не время, а число походов в базу. Желудь контейнера — autumn-data
// регистрирует наблюдателей на источнике до создания менеджера.

#Использовать entity

Перем ЧтенийПоТаблицам;    // Соответствие: имя таблицы -> Число
Перем ЗаписейПоТаблицам;   // Соответствие: имя таблицы -> Число
Перем Замок;               // БлокировкаРесурса — наблюдателя зовут из разных потоков

#Область КонтрактНаблюдателя

// Контракт наблюдателя: до события ничего не считаем — операция могла и упасть.
//
// Параметры:
//  Событие - СобытиеИсточникаДанных - начатое событие.
//
Процедура ПередСобытием(Событие) Экспорт // BSLLS:UnusedParameters-off
КонецПроцедуры

// Контракт наблюдателя: считаем завершённые операции чтения и записи по таблице сущности.
//
// Параметры:
//  Событие - СобытиеИсточникаДанных - завершённое событие.
//
Процедура ПослеСобытия(Событие) Экспорт

	Если Событие.Вид() <> ВидыСобытийИсточникаДанных.Операция() Тогда
		Возврат;
	КонецЕсли;

	Операция = Событие.Операция();
	Если Операция = "Получить" ИЛИ Операция = "ПолучитьОдно" Тогда
		Учесть(ЧтенийПоТаблицам, Событие.ИмяТаблицы());
	ИначеЕсли Операция = "Сохранить" Тогда
		Учесть(ЗаписейПоТаблицам, Событие.ИмяТаблицы());
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Счётчики

// Сколько чтений ушло к названной таблице с момента последнего обнуления.
//
// Параметры:
//  Таблица - Строка - имя таблицы сущности.
//
// Возвращаемое значение:
//  Число.
//
Функция Чтений(Знач Таблица) Экспорт
	Возврат Счёт(ЧтенийПоТаблицам, Таблица);
КонецФункции

// Сколько записей ушло в названную таблицу с момента последнего обнуления.
//
// Параметры:
//  Таблица - Строка - имя таблицы сущности.
//
// Возвращаемое значение:
//  Число.
//
Функция Записей(Знач Таблица) Экспорт
	Возврат Счёт(ЗаписейПоТаблицам, Таблица);
КонецФункции

// Обнуляет счёт: сторож меряет один проход, а не всю жизнь стенда.
//
Процедура Обнулить() Экспорт
	Замок.Заблокировать();
	ЧтенийПоТаблицам = Новый Соответствие();
	ЗаписейПоТаблицам = Новый Соответствие();
	Замок.Разблокировать();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Учесть(Счёт_, Знач ИмяТаблицы)

	Таблица = Строка(ИмяТаблицы);
	Замок.Заблокировать();
	Попытка
		Было = Счёт_.Получить(Таблица);
		Счёт_.Вставить(Таблица, ?(Было = Неопределено, 0, Было) + 1);
	Исключение
		Замок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	Замок.Разблокировать();

КонецПроцедуры

Функция Счёт(Знач Счёт_, Знач Таблица)
	Значение = Счёт_.Получить(Строка(Таблица));
	Возврат ?(Значение = Неопределено, 0, Значение);
КонецФункции

#КонецОбласти

&Прозвище("НаблюдательИсточникаДанных")
&Желудь
&Реализует("НаблюдательИсточникаДанных")
Процедура ПриСозданииОбъекта()
	ЧтенийПоТаблицам = Новый Соответствие();
	ЗаписейПоТаблицам = Новый Соответствие();
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
КонецПроцедуры
