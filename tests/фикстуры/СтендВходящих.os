// Стенд «входящих» пула: заявка на публикацию свободного имени — строкой в хранилище
// либо руками служб хаба. Одной фикстурой вместо дюжины присваиваний «ПулИдентификатор,
// ИмяПакета, ИмяНижнийРегистр, Версия, Заявитель, Состояние, Создана…», переписанных
// в трёх наборах разной длины: каждая копия заполняла свой набор колонок и молча
// оставляла остальные пустыми.
//
// Дверь выбирает набор. «Строкой» (Заявка) кладёт запись прямо в хранилище: быстро,
// без байтов в хранилище артефактов и без расхода места пула — годится там, где заявка
// только фон сценария (уборка пула, отбор запросов, каскад удаления). «Службами хаба»
// (ЗаявкаСлужбой) заводит заявку руками СервисаВходящих, как это делает push свободного
// имени: канон имени, проверка конкурентной заявки, пределы очереди, артефакт
// во «входящих» хранилища и учтённое место пула.
//
// Набор, который потом судит на заявке продуктовую логику приёма или квоты, обязан брать
// вторую дверь: заявка, положенная строкой, отличается от принятой хабом молча — у неё
// нулевой размер, а байтов её артефакта в хранилище нет вовсе.

Перем Контейнер;

#Область ЗаявкиСтрокой

// Кладёт заявку во «входящие» пула строкой в хранилище.
//
// Параметры:
//  ПулИлиИдентификатор - Пул, Число - пул, во «входящие» которого ложится заявка.
//  ЗаявительИлиИдентификатор - Пользователь, Число - кто подал заявку.
//  ИмяПакета - Строка - заявленное имя пакета (необязательный, по умолчанию "" —
//              свободное «inbox-N»).
//  Версия - Строка - номер версии (необязательный, по умолчанию "1.0.0").
//  Состояние - Строка - ожидает, одобрена либо отклонена (необязательный, по умолчанию
//              "" — «ожидает»).
//
// Возвращаемое значение:
//  ВходящаяПубликация - сохранённая строка заявки.
//
Функция Заявка(Знач ПулИлиИдентификатор, Знач ЗаявительИлиИдентификатор,
	Знач ИмяПакета = "", Знач Версия = "1.0.0", Знач Состояние = "") Экспорт

	Имя = ?(ЗначениеЗаполнено(ИмяПакета), СокрЛП(Строка(ИмяПакета)), УникальныеИмена.Имя("inbox"));
	Номер = СокрЛП(Строка(Версия));

	Запись = Заявки().СоздатьЭлемент();
	Запись.ПулИдентификатор = ПомощникиСтендов.Идентификатор(ПулИлиИдентификатор);
	Запись.ИмяПакета = Имя;
	Запись.ИмяНижнийРегистр = НРег(Имя);
	Запись.Версия = Номер;
	Запись.ЗаявительИдентификатор = ПомощникиСтендов.Идентификатор(ЗаявительИлиИдентификатор);
	Запись.Состояние = ?(ЗначениеЗаполнено(Состояние), Состояние, Запись.СостояниеОжидает());
	Запись.Создана = ТекущаяУниверсальнаяДата();
	Запись.Рассмотрена = МоментНеРассмотрена();
	Запись.РассмотрелИдентификатор = 0;
	Запись.ИмяФайла = ИмяФайлаПуша(Имя, Номер);
	Запись.Канал = КаналПоУмолчанию();
	Запись.АвторМанифеста = "";
	Запись.Размер = 0;
	Запись.Sha256 = "";
	Запись.КлючХранилища = СвободныйКлючХранилища();
	Запись.Комментарий = "";
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

#КонецОбласти

#Область ЗаявкиСлужбамиХаба

// Подаёт заявку руками хаба — СервисВходящих, как её принимает push свободного имени
// от пользователя без прав на пул. Байты артефакта ложатся во «входящие» хранилища,
// а их размер занимает место пула: строка, положенная напрямую, ничего этого не делает,
// и набор, проверяющий на заявке квоту или выдачу артефакта, оставался бы зелёным
// на пустом хранилище.
//
// Пул называется записью, а не номером: служба читает его имя — оно образует адрес
// артефакта во «входящих» и попадает в текст ответа заявителю.
//
// Параметры:
//  Пул - Пул - пул назначения.
//  Заявитель - Пользователь - от чьего имени подаётся заявка.
//  ИмяПакета - Строка - заявленное имя пакета (необязательный, по умолчанию "" —
//              свободное «inbox-N»).
//  Версия - Строка - номер версии (необязательный, по умолчанию "1.0.0").
//
// Возвращаемое значение:
//  ВходящаяПубликация - принятая службой заявка.
//
Функция ЗаявкаСлужбой(Знач Пул, Знач Заявитель, Знач ИмяПакета = "",
	Знач Версия = "1.0.0") Экспорт

	Имя = ?(ЗначениеЗаполнено(ИмяПакета), СокрЛП(Строка(ИмяПакета)), УникальныеИмена.Имя("inbox"));
	Номер = СокрЛП(Строка(Версия));

	Итог = ПоставитьЧерезСлужбу(Пул, Заявитель, Имя, Номер);
	Если НЕ Итог.Успех Тогда
		ВызватьИсключение СтрШаблон("Хаб не принял заявку (%1): %2", Итог.Код, Итог.Сообщение);
	КонецЕсли;

	Возврат Итог.Заявка;

КонецФункции

#КонецОбласти

#Область Служебное

// Приём заявки службой вместе с временным файлом её байтов: хранилище берёт источником
// путь, и файл убирается на любом исходе — исключение службы тоже не должно оставлять
// мусор в каталоге временных файлов.
Функция ПоставитьЧерезСлужбу(Знач Пул, Знач Заявитель, Знач Имя, Знач Номер)

	ВременныйПуть = ВременныеБайты(Имя, Номер);

	Попытка
		Итог = Контейнер.НайтиЖелудь("СервисВходящих").Поставить(Пул, Имя, Номер,
			ИмяФайлаПуша(Имя, Номер), КаналПоУмолчанию(), ВременныйПуть, Заявитель);
	Исключение
		УбратьФайл(ВременныйПуть);
		ВызватьИсключение;
	КонецПопытки;

	УбратьФайл(ВременныйПуть);

	Возврат Итог;

КонецФункции

// Байты «артефакта»: содержимое .ospx служба не разбирает — она считает его размер
// и сумму, поэтому годится любой файл, лишь бы у двух заявок он был разный.
Функция ВременныеБайты(Знач Имя, Знач Номер)

	Путь = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-inbox-stand-" + Строка(Новый УникальныйИдентификатор) + ".ospx");

	Запись = Новый ЗаписьТекста(Путь);
	Запись.ЗаписатьСтроку(СтрШаблон("%1 %2", Имя, Номер));
	Запись.Закрыть();

	Возврат Путь;

КонецФункции

Процедура УбратьФайл(Знач Путь)
	Попытка
		Если Новый Файл(Путь).Существует() Тогда
			УдалитьФайлы(Путь);
		КонецЕсли;
	Исключение
		// уборка вторична: заявка уже подана
	КонецПопытки;
КонецПроцедуры

// Имя файла в заголовке FILE-NAME исходного push — то же, каким его называет opm.
Функция ИмяФайлаПуша(Знач Имя, Знач Номер)
	Возврат СтрШаблон("%1-%2.ospx", Имя, Номер);
КонецФункции

// Канал заявки одобрение переносит на публикуемую версию: заявка без канала дала бы
// версию без метки, и набор про одобрение зеленел бы на непомеченной версии.
Функция КаналПоУмолчанию()
	Возврат "stable";
КонецФункции

// Момент «ещё не рассмотрена» — тот же, каким его ставит служба приёма.
Функция МоментНеРассмотрена()
	Возврат '00010101';
КонецФункции

// Ключ артефакта во «входящих» уникален по всему хранилищу, как его выдаёт служба:
// два стенда с одним ключом писали бы в один файл.
Функция СвободныйКлючХранилища()
	Возврат Строка(Новый УникальныйИдентификатор) + ".ospx";
КонецФункции

Функция Заявки()
	Возврат Контейнер.НайтиЖелудь("ХранилищеВходящихПубликаций");
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач Поделка)
	Контейнер = Поделка;
КонецПроцедуры
