// Фейк пульта журнала по его контракту поле в поле и параметр в параметр: настоящие имена логов,
// корень — лог rootLogger, правка возвращает применённое и пропущенное, повтор своего — не правка.

Перем Вызовы Экспорт;           // Массив из Структура - Метод, Имена, Значение, Кто, АдресIP, Порог
Перем Аудит Экспорт;            // Массив из Структура - Метод, Имя, Значение, Кто, АдресIP: применённые правки
Перем ПоследнийОтбор Экспорт;   // Структура - отбор последнего Хвост; Неопределено — не звали

Перем Логи_;       // Соответствие: имя -> состояние лога
Перем Порядок_;    // Массив из Строка
Перем Корень_;     // состояние корня
Перем Строки_;     // Массив из Структура — строки журнала, старые первыми
Перем Отказ_;      // Строка — код, которым откажет следующая правка; "" — не отказывать
Перем Коллектор_;  // Булево — ЖурналУходитВКоллектор

#Область КонтрактПульта

// Уровни от подробного к молчаливому.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция Уровни() Экспорт
	Возврат СтрРазделить("DEBUG,INFO,WARN,ERROR,CRITICALERROR,DISABLE", ",");
КонецФункции

// Узлы логов.
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция Логи() Экспорт
	Результат = Новый Массив();
	Для Каждого Имя Из Порядок_ Цикл
		Результат.Добавить(Узел(Логи_.Получить(Имя)));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Узел корня.
//
// Возвращаемое значение:
//  Структура
//
Функция Корень() Экспорт
	Возврат Узел(Корень_);
КонецФункции

// Пути оператора; «audit-trail» — ключ, которого нет в словаре экрана.
//
// Возвращаемое значение:
//  Массив из Структура - Ключ, Логи.
//
Функция Пути() Экспорт

	Результат = Новый Массив();
	Результат.Добавить(Путь("delivery", "КонтроллерВыдачиAPI, РезолверВыдачи, СервисПрокси, КлиентАпстрима,"
		+ " КэшАртефактов, СтражХранилища"));
	Результат.Добавить(Путь("login", "СервисАутентификации, ПолитикаПарольногоВхода, СервисВходаOIDC"));
	Результат.Добавить(Путь("storage", "КонфигурацияХранилища, КэшАртефактов, СтражХранилища"));
	Результат.Добавить(Путь("audit-trail", "СлужбаАудита, аудит"));
	Возврат Результат;

КонецФункции

// Строки журнала, свежие первыми. Отбор запоминается как есть.
//
// Параметры:
//  Отбор - Структура - поля отбора пульта.
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция Хвост(Знач Отбор) Экспорт

	ПоследнийОтбор = Отбор;
	Имена = Новый Соответствие();
	Если Отбор.Свойство("Логи") Тогда
		Для Каждого Имя Из Отбор.Логи Цикл
			Имена.Вставить(Имя, Истина);
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Массив();
	Номер = Строки_.ВГраница();
	Пока Номер >= 0 Цикл
		Запись = Строки_[Номер];
		Номер = Номер - 1;
		Если Имена.Количество() = 0 ИЛИ Имена.Получить(Запись.Лог) <> Неопределено Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Счёт памяти.
//
// Возвращаемое значение:
//  Структура - Всего, Ёмкость, ЁмкостьВажного.
//
Функция СчётПамяти() Экспорт
	Возврат Новый Структура("Всего, Ёмкость, ЁмкостьВажного", Строки_.Количество(), 500, 200);
КонецФункции

// Уходит ли журнал в коллектор.
//
// Возвращаемое значение:
//  Булево
//
Функция ЖурналУходитВКоллектор() Экспорт
	Возврат Коллектор_;
КонецФункции

// Строки закрепления: переменная уровней и переменная отправки, если что-то задано с экрана.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция СтрокиДляЗакрепления() Экспорт

	ПоЛогам = Новый Массив();
	Отправка = Новый Массив();
	Для Каждого Имя Из Порядок_ Цикл
		Лог = Логи_.Получить(Имя);
		Если Лог.СЭкрана <> Неопределено Тогда
			ПоЛогам.Добавить(Имя + "=" + Лог.СЭкрана);
		КонецЕсли;
		Если Лог.OTelСЭкрана <> Неопределено Тогда
			Отправка.Добавить(Имя + "=" + ?(Лог.OTelСЭкрана, "ON", "OFF"));
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив();
	Если ПоЛогам.Количество() > 0 Тогда
		Результат.Добавить("OSHUB_LOG_LEVELS=" + СтрСоединить(ПоЛогам, ","));
	КонецЕсли;
	Если Отправка.Количество() > 0 Тогда
		Результат.Добавить("OSHUB_LOG_OTEL_LEVELS=" + СтрСоединить(Отправка, ","));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Уровень логам; имя корня правит корень. Повтор своего уровня лога — не правка.
//
// Параметры:
//  ИменаЛогов - Массив из Строка - имена.
//  Уровень - Строка - уровень.
//  Кто - Строка - логин.
//  АдресIP - Строка - адрес клиента (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Применено, Пропущено (Массив из Строка).
//
Функция ЗадатьУровень(Знач ИменаЛогов, Знач Уровень, Знач Кто, Знач АдресIP = "") Экспорт

	Записать("ЗадатьУровень", ИменаЛогов, Уровень, Кто, АдресIP);
	Норм = ПроверенныйУровень(Уровень);
	Разбор = Разобрать(ИменаЛогов);
	Итог = НовыйИтог(Разбор.Пропущено);
	Для Каждого Лог Из Разбор.Правимые Цикл
		Если СвойУровень(Лог) <> Норм Тогда
			Лог.СЭкрана = Норм;
			Лог.Кто = Кто;
			Лог.Когда = Дата(2026, 9, 28, 12, 0, 0);
			Применить(Итог, "ЗадатьУровень", Лог, Норм, Кто, АдресIP);
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Уровень корню; повтор своего уровня корня — не правка.
//
// Параметры:
//  Уровень - Строка - уровень.
//  Кто - Строка - логин.
//  АдресIP - Строка - адрес клиента (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Применено, Пропущено (Массив из Строка).
//
Функция ЗадатьУровеньКорню(Знач Уровень, Знач Кто, Знач АдресIP = "") Экспорт

	Записать("ЗадатьУровеньКорню", Новый Массив(), Уровень, Кто, АдресIP);
	Норм = ПроверенныйУровень(Уровень);
	Итог = НовыйИтог(Новый Массив());
	Если СвойУровень(Корень_) <> Норм Тогда
		Корень_.СЭкрана = Норм;
		Корень_.Кто = Кто;
		Корень_.Когда = Дата(2026, 9, 28, 12, 0, 0);
		Применить(Итог, "ЗадатьУровеньКорню", Корень_, Норм, Кто, АдресIP);
	КонецЕсли;
	Возврат Итог;

КонецФункции

// Отправка в коллектор; имя корня правит корень. Повтор своей отправки лога — не правка.
//
// Параметры:
//  ИменаЛогов - Массив из Строка - имена.
//  Признак - Булево - отправлять.
//  Кто - Строка - логин.
//  АдресIP - Строка - адрес клиента (необязательный, по умолчанию "").
//  Порог - Строка - уровень, с которого отправлять (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Применено, Пропущено (Массив из Строка).
//
Функция ОтправлятьВOTel(Знач ИменаЛогов, Знач Признак, Знач Кто, Знач АдресIP = "", Знач Порог = "") Экспорт

	Записать("ОтправлятьВOTel", ИменаЛогов, Признак, Кто, АдресIP, Порог);
	Разбор = Разобрать(ИменаЛогов);
	Для Каждого Лог Из Разбор.Правимые Цикл
		Если НЕ Лог.МожноВOTel Тогда
			ВызватьИсключение "log.otel_unreachable: " + Лог.Имя;
		КонецЕсли;
	КонецЦикла;

	НовыйПорог = ?(ЗначениеЗаполнено(Порог), ПроверенныйУровень(Порог), Неопределено);
	Итог = НовыйИтог(Разбор.Пропущено);
	Для Каждого Лог Из Разбор.Правимые Цикл
		Если СвояОтправка(Лог) = Признак И (НовыйПорог = Неопределено ИЛИ НовыйПорог = ПорогЛога(Лог)) Тогда
			Продолжить;
		КонецЕсли;
		Лог.OTelСЭкрана = Признак;
		Лог.ПорогСЭкрана = НовыйПорог;
		Лог.OTelКто = Кто;
		Лог.OTelКогда = Дата(2026, 9, 28, 12, 30, 0);
		Применить(Итог, "ОтправлятьВOTel", Лог, Признак, Кто, АдресIP);
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Возврат к старту названных логов; имя корня возвращает корень. Лог, у которого с экрана
// ничего не задано, возвращать нечего.
//
// Параметры:
//  ИменаЛогов - Массив из Строка - имена.
//  Кто - Строка - логин.
//  АдресIP - Строка - адрес клиента (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Применено, Пропущено (Массив из Строка).
//
Функция ВернутьКСтарту(Знач ИменаЛогов, Знач Кто, Знач АдресIP = "") Экспорт

	Записать("ВернутьКСтарту", ИменаЛогов, Неопределено, Кто, АдресIP);
	Разбор = Разобрать(ИменаЛогов);
	Итог = НовыйИтог(Разбор.Пропущено);
	Для Каждого Лог Из Разбор.Правимые Цикл
		Вернуть(Итог, Лог, Кто, АдресIP);
	КонецЦикла;
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область Настройка

// Добавляет строку журнала.
//
// Параметры:
//  Лог - Строка - имя лога.
//  Уровень - Строка - уровень.
//  Текст - Строка - текст строки, как его отдал бы пульт.
//  Трасса - Строка - trace_id (необязательный, по умолчанию "").
//
Процедура ДобавитьСтроку(Знач Лог, Знач Уровень, Знач Текст, Знач Трасса = "") Экспорт
	Строки_.Добавить(Новый Структура("Номер, Время, Миллисекунды, Уровень, Лог, Текст, Трасса",
		Строки_.Количество() + 1, Дата(2026, 9, 28, 12, 0, 0) + Строки_.Количество(), 7, Уровень, Лог,
		Текст, Трасса));
КонецПроцедуры

// Следующая правка откажет исключением с этим кодом.
//
// Параметры:
//  Код - Строка - код отказа пульта либо любой текст сбоя.
//
Процедура Отказывать(Знач Код) Экспорт
	Отказ_ = Код;
КонецПроцедуры

// Задаёт ответ ЖурналУходитВКоллектор.
//
// Параметры:
//  Значение - Булево - уходит ли журнал в коллектор.
//
Процедура ЗадатьКоллектор(Знач Значение) Экспорт
	Коллектор_ = Значение;
КонецПроцедуры

// Задаёт логу либо корню уровень с экрана в обход записи вызовов: так тест готовит экран,
// на котором что-то уже задано.
//
// Параметры:
//  Имя - Строка - имя лога; имя корня — корень.
//  Уровень - Строка - уровень.
//  Кто - Строка - логин.
//
Процедура ПодготовитьУровень(Знач Имя, Знач Уровень, Знач Кто) Экспорт
	Лог = Состояние(Имя);
	Лог.СЭкрана = Уровень;
	Лог.Кто = Кто;
	Лог.Когда = Дата(2026, 9, 28, 11, 0, 0);
КонецПроцедуры

// Задаёт логу либо корню отправку с экрана в обход записи вызовов.
//
// Параметры:
//  Имя - Строка - имя лога; имя корня — корень.
//  Признак - Булево - отправлять.
//  Кто - Строка - логин.
//
Процедура ПодготовитьОтправку(Знач Имя, Знач Признак, Знач Кто) Экспорт
	Лог = Состояние(Имя);
	Лог.OTelСЭкрана = Признак;
	Лог.OTelКто = Кто;
	Лог.OTelКогда = Дата(2026, 9, 28, 12, 30, 0);
КонецПроцедуры

// Выключает логу отправку настройкой при старте: выход коллектора есть, тумблер правится.
//
// Параметры:
//  Имя - Строка - имя лога.
//
Процедура ВыключитьОтправкуНастройкой(Знач Имя) Экспорт
	Состояние(Имя).OTelСтарт = Ложь;
КонецПроцедуры

// Делает лог только для чтения с кодом причины.
//
// Параметры:
//  Имя - Строка - имя лога.
//  Код - Строка - код причины: audit, before_wiring либо незнакомый экрану.
//
Процедура ЗапретитьПравку(Знач Имя, Знач Код) Экспорт
	Лог = Состояние(Имя);
	Лог.ТолькоЧтение = Истина;
	Лог.Почему = Код;
КонецПроцедуры

// Задаёт логу порог коллектора настройкой, в обход записи вызовов.
//
// Параметры:
//  Имя - Строка - имя лога.
//  Порог - Строка - уровень, с которого строки уходят в коллектор.
//
Процедура ЗадатьПорог(Знач Имя, Знач Порог) Экспорт
	Состояние(Имя).ПорогСтарт = Порог;
КонецПроцедуры

// Оставляет пульт без единого лога — только корень.
//
Процедура БезЛогов() Экспорт
	Логи_.Очистить();
	Порядок_.Очистить();
КонецПроцедуры

// Добавляет лог в группу; пустая группа — лог, которому пульт группы не назвал.
//
// Параметры:
//  Имя - Строка - имя лога.
//  Группа - Строка - путь группы.
//
Процедура ДобавитьЛог(Знач Имя, Знач Группа) Экспорт
	Ветка(Группа, Имя);
КонецПроцедуры

// Вызовы одного метода.
//
// Параметры:
//  Метод - Строка - имя метода контракта.
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция ВызовыМетода(Знач Метод) Экспорт
	Результат = Новый Массив();
	Для Каждого Вызов Из Вызовы Цикл
		Если Вызов.Метод = Метод Тогда
			Результат.Добавить(Вызов);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Состояние

Процедура Записать(Знач Метод, Знач Имена, Знач Значение, Знач Кто, Знач АдресIP, Знач Порог = "")

	Копия = Новый Массив();
	Для Каждого Имя Из Имена Цикл
		Копия.Добавить(Имя);
	КонецЦикла;
	Вызовы.Добавить(Новый Структура("Метод, Имена, Значение, Кто, АдресIP, Порог", Метод, Копия, Значение, Кто,
		АдресIP, Порог));

	Если ЗначениеЗаполнено(Отказ_) Тогда
		Код = Отказ_;
		Отказ_ = "";
		ВызватьИсключение Код + ": " + СтрСоединить(Имена, ", ");
	КонецЕсли;

КонецПроцедуры

Функция НовыйИтог(Знач Пропущено)
	Возврат Новый Структура("Применено, Пропущено", Новый Массив(), Пропущено);
КонецФункции

Процедура Применить(Итог, Знач Метод, Знач Лог, Знач Значение, Знач Кто, Знач АдресIP)
	Итог.Применено.Добавить(Лог.Имя);
	Аудит.Добавить(Новый Структура("Метод, Имя, Значение, Кто, АдресIP", Метод, Лог.Имя, Значение, Кто, АдресIP));
КонецПроцедуры

Процедура Вернуть(Итог, Лог, Знач Кто, Знач АдресIP)
	Если Лог.СЭкрана = Неопределено И Лог.OTelСЭкрана = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Лог.СЭкрана = Неопределено;
	Лог.OTelСЭкрана = Неопределено;
	Лог.ПорогСЭкрана = Неопределено;
	Применить(Итог, "ВернутьКСтарту", Лог, Неопределено, Кто, АдресIP);
КонецПроцедуры

Функция Узел(Знач Лог)

	Результат = Новый Структура();
	Результат.Вставить("Имя", Лог.Имя);
	Результат.Вставить("Группа", Лог.Группа);
	Результат.Вставить("УровеньПриСтарте", ?(Лог.Старт = Неопределено, Корень_.Старт, Лог.Старт));
	Результат.Вставить("СвойПриСтарте", Лог.Старт <> Неопределено);
	Результат.Вставить("ОткудаПриСтарте", Лог.Откуда);
	Результат.Вставить("ИмяНастройки", Лог.Настройка);
	Результат.Вставить("УровеньСЭкрана", Лог.СЭкрана);
	Результат.Вставить("ЗаданоКем", ?(Лог.СЭкрана = Неопределено, Неопределено, Лог.Кто));
	Результат.Вставить("ЗаданоКогда", ?(Лог.СЭкрана = Неопределено, Неопределено, Лог.Когда));
	Результат.Вставить("УровеньДействующий", Действующий(Лог));
	Результат.Вставить("ВКонсоль", Лог.ВКонсоль);
	Результат.Вставить("ВПамять", Лог.ВПамять);
	Результат.Вставить("ВOTel", Лог.МожноВOTel И СвояОтправка(Лог));
	Результат.Вставить("ПорогOTel", ПорогЛога(Лог));
	Результат.Вставить("OTelСЭкрана", Лог.OTelСЭкрана <> Неопределено);
	Результат.Вставить("OTelЗаданКем", ?(Лог.OTelСЭкрана = Неопределено, Неопределено, Лог.OTelКто));
	Результат.Вставить("OTelЗаданКогда", ?(Лог.OTelСЭкрана = Неопределено, Неопределено, Лог.OTelКогда));
	Результат.Вставить("МожноВOTel", Лог.МожноВOTel);
	Результат.Вставить("ТолькоЧтение", Лог.ТолькоЧтение);
	Результат.Вставить("ПочемуТолькоЧтение", Лог.Почему);
	Результат.Вставить("ПрочиеВыходы", Лог.ПрочиеВыходы);
	Результат.Вставить("СтрокЗаМинуту", Лог.ЗаМинуту);
	Возврат Результат;

КонецФункции

Функция Действующий(Знач Лог)
	Свой = СвойУровень(Лог);
	Если Свой <> Неопределено Тогда
		Возврат Свой;
	КонецЕсли;
	Возврат СвойУровень(Корень_);
КонецФункции

// Свой уровень — заданный с экрана либо названный логу при старте; уровень от корня своим не считается.
Функция СвойУровень(Знач Лог)
	Возврат ?(Лог.СЭкрана <> Неопределено, Лог.СЭкрана, Лог.Старт);
КонецФункции

Функция СвояОтправка(Знач Лог)
	Возврат ?(Лог.OTelСЭкрана <> Неопределено, Лог.OTelСЭкрана, Лог.OTelСтарт);
КонецФункции

Функция ПорогЛога(Знач Лог)
	Возврат ?(Лог.ПорогСЭкрана <> Неопределено, Лог.ПорогСЭкрана, Лог.ПорогСтарт);
КонецФункции

// Незнакомое имя — отказ; лог только для чтения в списке пропускается, список из одних таких — отказ.
Функция Разобрать(Знач ИменаЛогов)

	Разбор = Новый Структура("Правимые, Пропущено", Новый Массив(), Новый Массив());
	Для Каждого Имя Из ИменаЛогов Цикл
		Лог = Состояние(Имя);
		Если Лог = Неопределено Тогда
			ВызватьИсключение "log.unknown_logger: " + Имя;
		ИначеЕсли Лог.ТолькоЧтение Тогда
			Разбор.Пропущено.Добавить(Имя);
		Иначе
			Разбор.Правимые.Добавить(Лог);
		КонецЕсли;
	КонецЦикла;
	Если Разбор.Правимые.Количество() = 0 И Разбор.Пропущено.Количество() > 0 Тогда
		ВызватьИсключение "log.read_only: " + СтрСоединить(Разбор.Пропущено, ", ");
	КонецЕсли;
	Возврат Разбор;

КонецФункции

Функция Состояние(Знач Имя)
	Возврат ?(Имя = Корень_.Имя, Корень_, Логи_.Получить(Имя));
КонецФункции

Функция ПроверенныйУровень(Знач Уровень)
	Норм = ВРег(СокрЛП(Строка(Уровень)));
	Если Уровни().Найти(Норм) = Неопределено Тогда
		ВызватьИсключение "log.unknown_level: " + Уровень;
	КонецЕсли;
	Возврат Норм;
КонецФункции

Функция Путь(Знач Ключ, Знач Имена)
	Список = Новый Массив();
	Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
		Список.Добавить(СокрЛП(Имя));
	КонецЦикла;
	Возврат Новый Структура("Ключ, Логи", Ключ, Список);
КонецФункции

Функция НовыйЛог(Знач Имя, Знач Группа)
	Лог = Новый Структура("Имя, Группа, Старт, Откуда, Настройка, СЭкрана, Кто, Когда", Имя, Группа,
		Неопределено, "умолчание", "", Неопределено, "", Неопределено);
	Лог.Вставить("OTelСтарт", Истина);
	Лог.Вставить("OTelСЭкрана", Неопределено);
	Лог.Вставить("OTelКто", "");
	Лог.Вставить("OTelКогда", Неопределено);
	Лог.Вставить("ПорогСтарт", Неопределено);
	Лог.Вставить("ПорогСЭкрана", Неопределено);
	Лог.Вставить("МожноВOTel", Истина);
	Лог.Вставить("ТолькоЧтение", Ложь);
	Лог.Вставить("Почему", "");
	Лог.Вставить("ПрочиеВыходы", Новый Массив());
	Лог.Вставить("ВКонсоль", Истина);
	Лог.Вставить("ВПамять", Истина);
	Лог.Вставить("ЗаМинуту", 0);
	Возврат Лог;
КонецФункции

Процедура Ветка(Знач Группа, Знач Имена, Знач Библиотека = Ложь)
	Для Каждого Имя Из СтрРазделить(Имена, ",", Ложь) Цикл
		Лог = НовыйЛог(СокрЛП(Имя), Группа);
		Лог.МожноВOTel = НЕ Библиотека;
		Лог.OTelСтарт = НЕ Библиотека;
		Лог.ВКонсоль = НЕ Библиотека;
		Логи_.Вставить(Лог.Имя, Лог);
		Порядок_.Добавить(Лог.Имя);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

Процедура ПриСозданииОбъекта() Экспорт

	Вызовы = Новый Массив();
	Аудит = Новый Массив();
	Строки_ = Новый Массив();
	Отказ_ = "";
	Коллектор_ = Ложь;
	Логи_ = Новый Соответствие();
	Порядок_ = Новый Массив();
	Корень_ = НовыйЛог("rootLogger", "");
	Корень_.Старт = "INFO";

	Ветка("хаб/api", "КонтроллерВыдачиAPI, КонтроллерЗеркалAPI");
	Ветка("хаб/oshub", "oshub.запуск, аудит");
	Ветка("хаб/аудит", "СлужбаАудита, ЧитательЖурналаАудита");
	Ветка("хаб/вход/паролем", "ВосстановлениеПароля, ПолитикаПарольногоВхода, СервисАутентификации");
	Ветка("хаб/вход/провайдером", "ГейтВходаПоСтране, КонфигурацияOIDC, СервисВходаOIDC");
	Ветка("хаб/наблюдаемость/пробы", "ГотовностьХаба, ЧислаХаба");
	Ветка("хаб/почта", "СлужбаПочты");
	Ветка("хаб/прокси", "ИндексВерсийИсточника, КлиентАпстрима, РезолверВыдачи, СервисПрокси");
	Ветка("хаб/хранилище", "КонфигурацияХранилища, КэшАртефактов, СтражХранилища");
	Ветка("библиотеки/entity", "oscript.lib.entity.connector.json, oscript.lib.entity.pool", Истина);
	Ветка("библиотеки/winow", "oscript.lib.winow.ОбработчикЗапросов, winow.router.СборщикМаршрутов", Истина);

	Запуск = Логи_.Получить("oshub.запуск");
	Запуск.МожноВOTel = Ложь;
	Запуск.OTelСтарт = Ложь;
	// журнал аудита пишется только в свой файл: ни в консоль, ни в память, ни в коллектор
	ЖурналАудита = Логи_.Получить("аудит");
	ЗапретитьПравку("аудит", "audit");
	ЖурналАудита.ВКонсоль = Ложь;
	ЖурналАудита.ВПамять = Ложь;
	ЖурналАудита.МожноВOTel = Ложь;
	ЖурналАудита.OTelСтарт = Ложь;
	ЖурналАудита.ПрочиеВыходы.Добавить("файл аудита");
	ЗапретитьПравку("winow.router.СборщикМаршрутов", "before_wiring");
	Готовность = Логи_.Получить("ГотовностьХаба");
	Готовность.Старт = "DEBUG";
	Готовность.Откуда = "окружение";
	Готовность.Настройка = "OSHUB_LOG_LEVELS";
	ИзФайла = Логи_.Получить("КонфигурацияOIDC");
	ИзФайла.Старт = "WARN";
	ИзФайла.Откуда = "файл";
	ИзФайла.Настройка = "oshub.log.levels";
	Логи_.Получить("ЧислаХаба").ВПамять = Ложь;
	Логи_.Получить("СервисПрокси").ЗаМинуту = 5;
	Логи_.Получить("РезолверВыдачи").ЗаМинуту = 3;

КонецПроцедуры
