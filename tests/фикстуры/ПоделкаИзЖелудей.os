// Фикстура поделки ОСени: отдаёт ровно те желуди, которые в неё положил набор. Нужна
// напильникам — они собирают свою обёртку не из параметров конструктора, а поиском
// по имени, и без поделки их не проверить вовсе.

Перем Желуди;  // Соответствие: имя -> желудь

// Кладёт желудь под названным именем.
//
// Параметры:
//  Имя - Строка - имя желудя, каким его спрашивает напильник.
//  Желудь - Произвольный - сам желудь.
//
Процедура Положить(Знач Имя, Знач Желудь) Экспорт
	Желуди.Вставить(Имя, Желудь);
КонецПроцедуры

// Контракт поделки: желудь по имени.
//
// Параметры:
//  Имя - Строка - имя желудя.
//
// Возвращаемое значение:
//  Произвольный - желудь; ненайденное имя — исключение, а не Неопределено: молчаливое
//                 Неопределено уехало бы в обёртку и упало бы позже и не там.
//
Функция НайтиЖелудь(Знач Имя) Экспорт

	Найденный = Желуди.Получить(Имя);
	Если Найденный = Неопределено Тогда
		ВызватьИсключение СтрШаблон("ПоделкаИзЖелудей: желудь ""%1"" в неё не положен", Имя);
	КонецЕсли;
	Возврат Найденный;

КонецФункции

Процедура ПриСозданииОбъекта()
	Желуди = Новый Соответствие();
КонецПроцедуры
