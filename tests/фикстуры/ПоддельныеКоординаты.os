// Фикстура: координаты без валидации — позволяет подсунуть хранилищу опасные компоненты
// и проверить вторую линию защиты от выхода за корень.

Перем ЗначениеПула;
Перем ЗначениеПакета;
Перем ЗначениеВерсии;
Перем ЗначениеИмениФайла;

// Контракт координат: сегмент пула — как задан тестом, без валидации.
//
// Возвращаемое значение:
//  Строка.
//
Функция Пул() Экспорт
	Возврат ЗначениеПула;
КонецФункции

// Контракт координат: сегмент пакета — как задан тестом, без валидации.
//
// Возвращаемое значение:
//  Строка.
//
Функция Пакет() Экспорт
	Возврат ЗначениеПакета;
КонецФункции

// Контракт координат: сегмент версии — как задан тестом, без валидации.
//
// Возвращаемое значение:
//  Строка.
//
Функция Версия() Экспорт
	Возврат ЗначениеВерсии;
КонецФункции

// Контракт координат: имя файла — как задано тестом, без валидации.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяФайла() Экспорт
	Возврат ЗначениеИмениФайла;
КонецФункции

// Контракт координат: представление вида «пул/пакет/имя файла».
//
// Возвращаемое значение:
//  Строка.
//
Функция Представление() Экспорт
	Возврат СтрШаблон("%1/%2/%3", ЗначениеПула, ЗначениеПакета, ЗначениеИмениФайла);
КонецФункции

Процедура ПриСозданииОбъекта(Знач Пул, Знач Пакет, Знач Версия, Знач ИмяФайла)
	ЗначениеПула = Пул;
	ЗначениеПакета = Пакет;
	ЗначениеВерсии = Версия;
	ЗначениеИмениФайла = ИмяФайла;
КонецПроцедуры
