// Обработчик фонового задания для сторожа потокобезопасности памяти журнала: пишет строки
// своего лога и запоминает первую жалобу. Своего утверждения не делает — судит набор.

Перем Память;       // ПамятьЖурнала
Перем ИмяЛога_;     // Строка
Перем Строк;        // Число
Перем Жалоба_;      // Строка — первая жалоба; "" — поток отработал чисто

// Жалоба потока: текст сбоя; пустая строка — писалось без исключений.
//
// Возвращаемое значение:
//  Строка.
//
Функция Жалоба() Экспорт
	Возврат Жалоба_;
КонецФункции

// Контракт обработчика фонового задания.
Процедура Исполнить() Экспорт

	Попытка
		Для Номер = 1 По Строк Цикл
			Память.Записать(ТекущаяУниверсальнаяДатаВМиллисекундах(), Номер % 3, ИмяЛога_,
				ИмяЛога_ + " строка " + Номер, "");
		КонецЦикла;
	Исключение
		Жалоба_ = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач _Память, Знач _ИмяЛога, Знач _Строк)
	Память = _Память;
	ИмяЛога_ = _ИмяЛога;
	Строк = _Строк;
	Жалоба_ = "";
КонецПроцедуры
