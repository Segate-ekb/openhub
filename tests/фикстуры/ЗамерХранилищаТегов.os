// ХранилищеТегов в памяти, считающее ОБРАЩЕНИЯ и ПРОЧИТАННЫЕ СТРОКИ: страница пакета
// спрашивает теги и на шапке (версия по умолчанию), и на вкладке версий.

Перем Записи;      // Массив из Структура — строки тегов
Перем Счётчик;   // СчётчикОбращений — счёт запросов и прочитанных строк

#Область Счётчики

// Сколько строк тегов хранилище отдало с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Строк() Экспорт
	Возврат Счётчик.Строк();
КонецФункции

// Сколько запросов к хранилищу ушло с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Запросов() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Обнуляет счётчики, оставляя фактуру.
Процедура Обнулить() Экспорт
	Счётчик.Обнулить();
КонецПроцедуры

#КонецОбласти

#Область НаполнениеФикстуры

// Заводит ручной тег-канал: состав такого тега ведут метки, и именно они дорожали
// с числом тегов.
//
// Параметры:
//  Идентификатор - Число - идентификатор тега.
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега.
//  ПоУмолчанию - Булево - основной канал пакета.
//
Процедура ДобавитьРучной(Знач Идентификатор, Знач ПакетИдентификатор, Знач Имя,
	Знач ПоУмолчанию = Ложь) Экспорт

	Строка_ = Новый Структура();
	Строка_.Вставить("Идентификатор", Цел(Идентификатор));
	Строка_.Вставить("ПакетИдентификатор", Цел(ПакетИдентификатор));
	Строка_.Вставить("Имя", Имя);
	Строка_.Вставить("Режим", "manual");
	Строка_.Вставить("Правило", "");
	Строка_.Вставить("ТипПравила", "");
	Строка_.Вставить("ПоУмолчанию", ПоУмолчанию);
	Строка_.Вставить("ПерезаписьРазрешена", Ложь);
	Строка_.Вставить("Стиль", "");
	Строка_.Вставить("Значок", "");
	Строка_.Вставить("Обновлён", '20260101120000');
	Строка_.Вставить("КемИдентификатор", 1);
	Записи.Добавить(Строка_);

КонецПроцедуры

#КонецОбласти

#Область КонтрактХранилища

// Все теги пакета.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив - теги пакета.
//
Функция ПолучитьПоПакетИдентификаторРавно(Знач ПакетИдентификатор) Экспорт

	Отобранные = Новый Массив();
	Для Каждого Строка_ Из Записи Цикл
		Если Строка_.ПакетИдентификатор = Цел(ПакетИдентификатор) Тогда
			Отобранные.Добавить(Строка_);
		КонецЕсли;
	КонецЦикла;

	Возврат Счётчик.Отдать(Отобранные);

КонецФункции

// Тег пакета по имени.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя тега.
//
// Возвращаемое значение:
//  Структура, Неопределено - найденный тег.
//
Функция ПолучитьОдноПоПакетИдентификаторРавноИИмяРавно(Знач ПакетИдентификатор, Знач Имя) Экспорт

	Для Каждого Строка_ Из Записи Цикл
		Если Строка_.ПакетИдентификатор = Цел(ПакетИдентификатор) И Строка_.Имя = Имя Тогда
			Возврат Счётчик.ОтдатьОдну(Строка_);
		КонецЕсли;
	КонецЦикла;
	Возврат Счётчик.ОтдатьОдну(Неопределено);

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
