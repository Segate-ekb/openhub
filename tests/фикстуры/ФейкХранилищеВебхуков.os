// Фейковое хранилище вебхуков в памяти: контракт ХранилищаВебхуков без autumn-data и БД.

Перем Записи;
Перем СледИд;

// Контракт репозитория: новая несохранённая запись, привязанная к этому хранилищу.
//
// Возвращаемое значение:
//  ФейкВебхукЗапись.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Новый ФейкВебхукЗапись(ЭтотОбъект);
КонецФункции

// Приём записи от Запись.Сохранить(): новой присваивает идентификатор и кладёт в список,
// уже сохранённую не дублирует.
//
// Параметры:
//  Запись - ФейкВебхукЗапись - сохраняемая запись.
//
Процедура Принять(Знач Запись) Экспорт
	Если Запись.Идентификатор = 0 Тогда
		Запись.Идентификатор = СледИд;
		СледИд = СледИд + 1;
		Записи.Добавить(Запись);
	КонецЕсли;
КонецПроцедуры

// Все записи хранилища.
//
// Возвращаемое значение:
//  Массив из ФейкВебхукЗапись.
//
Функция Все() Экспорт
	Возврат Записи;
КонецФункции

// Контракт репозитория: записи, привязанные к объекту.
//
// Параметры:
//  ТипОбъекта - Строка - тип объекта подписки.
//  ОбъектИдентификатор - Число - идентификатор объекта.
//
// Возвращаемое значение:
//  Массив из ФейкВебхукЗапись.
//
Функция ПолучитьПоОбъекту(Знач ТипОбъекта, Знач ОбъектИдентификатор) Экспорт
	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Если Запись.ТипОбъекта = Строка(ТипОбъекта)
			И Запись.ОбъектИдентификатор = Цел(ОбъектИдентификатор) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Контракт репозитория: запись по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор записи.
//
// Возвращаемое значение:
//  ФейкВебхукЗапись, Неопределено - Неопределено, если записи нет.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Для Каждого Запись Из Записи Цикл
		Если Запись.Идентификатор = Цел(Идентификатор) Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Контракт репозитория: удаляет запись. Отсутствие записи в списке не ошибка.
//
// Параметры:
//  Запись - ФейкВебхукЗапись - удаляемая запись.
//
Процедура Удалить(Знач Запись) Экспорт
	Индекс = Записи.Найти(Запись);
	Если Индекс <> Неопределено Тогда
		Записи.Удалить(Индекс);
	КонецЕсли;
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	СледИд = 1;
КонецПроцедуры
