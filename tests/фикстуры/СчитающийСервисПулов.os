// Служба пулов в памяти, считающая обращения к базе. Обе двери — «пул по идентификатору»
// и «пулы по списку идентификаторов» — у настоящей службы ровно один запрос к хранилищу
// каждая (ЗапросыПулов_Тесты стерегут это отдельно), поэтому счёт вызовов здесь и есть
// счёт запросов экрана.

Перем Пулы;   // Соответствие: идентификатор -> Структура (Идентификатор, Имя)
Перем Счётчик;   // СчётчикОбращений — счёт обращений к фикстуре

// Сколько раз службу спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Заводит пул (наполнение фикстуры; за обращение не считается).
//
// Параметры:
//  Идентификатор - Число - идентификатор пула.
//  Имя - Строка - имя пула.
//  Видимость - Строка - public либо private: право чтения спрашивают только у закрытого
//              (необязательный, по умолчанию public).
//
// Возвращаемое значение:
//  Структура - заведённый пул.
//
Функция ДобавитьПул(Знач Идентификатор, Знач Имя, Знач Видимость = "public") Экспорт

	Пул = Новый Структура("Идентификатор, Имя, Видимость", Цел(Идентификатор), Имя, Видимость);
	Пулы.Вставить(Цел(Идентификатор), Пул);
	Возврат Пул;

КонецФункции

// Пул по идентификатору; считает обращение.
//
// Параметры:
//  Идентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Структура, Неопределено.
//
Функция ПулПоИдентификатору(Знач Идентификатор) Экспорт
	Счётчик.Отметить();
	Возврат Пулы.Получить(Цел(Идентификатор));
КонецФункции

// Все пулы хаба; считает обращение. Дверь, через которую сводка обходила реестр целиком.
//
// Возвращаемое значение:
//  Массив - все заведённые пулы.
//
Функция ВсеПулы() Экспорт

	Счётчик.Отметить();

	Результат = Новый Массив();
	Для Каждого КиЗ Из Пулы Цикл
		Результат.Добавить(КиЗ.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пулы перечисленных идентификаторов; считает обращение.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пулов.
//
// Возвращаемое значение:
//  Соответствие - ключ Число, значение Структура; ненайденных ключей в нём нет.
//
Функция ПулыПоИдентификаторам(Знач Идентификаторы) Экспорт

	Счётчик.Отметить();

	Результат = Новый Соответствие();
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Пул = Пулы.Получить(Цел(Идентификатор));
		Если Пул <> Неопределено Тогда
			Результат.Вставить(Цел(Идентификатор), Пул);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ПриСозданииОбъекта()
	Пулы = Новый Соответствие();
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
