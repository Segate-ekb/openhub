// Фейковый IdP для HTTP-тестов входа через провайдера: discovery, authorize, token,
// userinfo. Состояния не держит — одноразовость едет внутрь кода авторизации.

Перем Издатель;      // Строка - issuer, он же база всех конечных точек
Перем КлиентИдент;   // Строка - client_id, попадающий в aud идентификационного токена
Перем Субъект;       // Строка - sub входящего человека
Перем Почта;         // Строка - email входящего человека
Перем Логин;         // Строка - preferred_username входящего человека
Перем ЖурналПрофиля; // Строка - файл отметок о запросах userinfo; "" — не вести

#Область ТочкиМаршрута

// GET /.well-known/openid-configuration — документ обнаружения.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//
&ТочкаМаршрута(".well-known/openid-configuration")
Процедура Обнаружение(Ответ) Экспорт

	Документ = Новый Соответствие();
	Документ.Вставить("issuer", Издатель);
	Документ.Вставить("authorization_endpoint", Издатель + "/authorize");
	Документ.Вставить("token_endpoint", Издатель + "/token");
	Документ.Вставить("userinfo_endpoint", Издатель + "/userinfo");
	Документ.Вставить("jwks_uri", Издатель + "/jwks");

	ОтдатьJSON(Ответ, 200, Документ);

КонецПроцедуры

// GET /authorize — «человек согласился»: сразу возвращает браузер на адрес хаба.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow: редирект на redirect_uri.
//  redirect_uri - Строка - куда вернуть браузер (необязательный, по умолчанию "").
//  state - Строка - состояние хаба, возвращается как есть (необязательный, по умолчанию "").
//  nonce - Строка - одноразовость хаба; уезжает внутрь кода авторизации
//          (необязательный, по умолчанию "").
//
&ТочкаМаршрута("authorize")
Процедура Авторизация(Ответ, redirect_uri = "", state = "", nonce = "") Экспорт

	Ответ.Перенаправить(Строка(redirect_uri)
		+ "?code=" + КодироватьСтроку(КодАвторизации(Строка(nonce)), СпособКодированияСтроки.КодировкаURL)
		+ "&state=" + КодироватьСтроку(Строка(state), СпособКодированияСтроки.КодировкаURL));

КонецПроцедуры

// POST /token — обмен кода на токены. Подпись идентификационного токена фиктивная:
// oidc-client её не проверяет, доверие держится на том, что ответ пришёл от эндпоинта.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ТелоЗапроса - Строка - тело формы обмена кода.
//
&ТочкаМаршрута("token")
Процедура Токены(Ответ, ТелоЗапроса) Экспорт

	Токены_ = Новый Соответствие();
	// только ASCII: токен уезжает в заголовок Authorization, а не-ASCII в заголовках
	// платформа отвергает — иначе userinfo не запрашивается вовсе
	Токены_.Вставить("access_token", "fake-access-token");
	Токены_.Вставить("token_type", "Bearer");
	Токены_.Вставить("expires_in", 3600);
	Токены_.Вставить("id_token", ИдентификационныйТокен(ОдноразовостьИзКода(Строка(ТелоЗапроса))));

	ОтдатьJSON(Ответ, 200, Токены_);

КонецПроцедуры

// GET /userinfo — профиль вошедшего.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//
&ТочкаМаршрута("userinfo")
Процедура Профиль(Ответ) Экспорт

	ОтметитьВызовПрофиля();

	Профиль_ = Новый Соответствие();
	Профиль_.Вставить("sub", Субъект);
	Профиль_.Вставить("email", Почта);
	Профиль_.Вставить("email_verified", Истина);
	Профиль_.Вставить("preferred_username", Логин);

	ОтдатьJSON(Ответ, 200, Профиль_);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отметка в файл, а не в поле: состояние между запросами фейк не держит, а набору нужно
// знать, дошёл ли вход до профиля. Сбой записи вход не роняет — это диагностика.
Процедура ОтметитьВызовПрофиля()

	Если ПустаяСтрока(ЖурналПрофиля) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Запись = Новый ЗаписьТекста(ЖурналПрофиля, "UTF-8", , Истина);
		Запись.ЗаписатьСтроку("userinfo");
		Запись.Закрыть();
	Исключение
	КонецПопытки;

КонецПроцедуры

// Одноразовость едет внутрь кода: иначе фейку пришлось бы помнить её между запросами.
Функция КодАвторизации(Знач Одноразовость)
	Возврат "код." + Base64URL(ПолучитьДвоичныеДанныеИзСтроки(Одноразовость, "UTF-8"));
КонецФункции

Функция ОдноразовостьИзКода(Знач ТелоФормы)

	Код = ПолеФормы(ТелоФормы, "code");
	Точка = СтрНайти(Код, ".");
	Если Точка = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат ПолучитьСтрокуИзДвоичныхДанных(ИзBase64URL(Сред(Код, Точка + 1)), "UTF-8");

КонецФункции

Функция ПолеФормы(Знач ТелоФормы, Знач Имя)

	Для Каждого Пара Из СтрРазделить(Строка(ТелоФормы), "&", Ложь) Цикл
		Равно = СтрНайти(Пара, "=");
		Если Равно > 0 И Лев(Пара, Равно - 1) = Имя Тогда
			Возврат РаскодироватьСтроку(Сред(Пара, Равно + 1), СпособКодированияСтроки.КодировкаURL);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ИдентификационныйТокен(Знач Одноразовость)

	Сейчас = ТекущаяУниверсальнаяДата();
	Начало = Дата(1970, 1, 1);

	Заголовок = Новый Соответствие();
	Заголовок.Вставить("alg", "RS256");
	Заголовок.Вставить("typ", "JWT");
	Заголовок.Вставить("kid", "фейковый-ключ");

	Клеймы = Новый Соответствие();
	Клеймы.Вставить("iss", Издатель);
	Клеймы.Вставить("aud", КлиентИдент);
	Клеймы.Вставить("azp", КлиентИдент);
	Клеймы.Вставить("sub", Субъект);
	Клеймы.Вставить("nonce", Одноразовость);
	Клеймы.Вставить("iat", Сейчас - Начало - 10);
	Клеймы.Вставить("nbf", Сейчас - Начало - 10);
	Клеймы.Вставить("exp", Сейчас - Начало + 600);
	Клеймы.Вставить("email", Почта);
	Клеймы.Вставить("email_verified", Истина);

	Возврат ЧастьТокена(Заголовок) + "." + ЧастьТокена(Клеймы) + ".фейковая-подпись";

КонецФункции

Функция ЧастьТокена(Знач Данные)
	Возврат Base64URL(ПолучитьДвоичныеДанныеИзСтроки(ВJSON(Данные), "UTF-8"));
КонецФункции

Функция ВJSON(Знач Данные)
	Запись = Новый ЗаписьJSON();
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция Base64URL(Знач Данные)
	Строка_ = СтрЗаменить(СтрЗаменить(Base64Строка(Данные), Символы.ВК, ""), Символы.ПС, "");
	Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(Строка_, "=", ""), "+", "-"), "/", "_");
КонецФункции

Функция ИзBase64URL(Знач Строка_)

	Основа = СтрЗаменить(СтрЗаменить(Строка_, "-", "+"), "_", "/");
	Пока СтрДлина(Основа) % 4 <> 0 Цикл
		Основа = Основа + "=";
	КонецЦикла;

	Возврат Base64Значение(Основа);

КонецФункции

Процедура ОтдатьJSON(Ответ, Знач Код, Знач Данные)

	Тело = ВJSON(Данные);

	Ответ.УстановитьСостояние(Код);
	Ответ.Заголовки["Content-Type"] = "application/json; charset=utf-8";
	Ответ.Заголовки["Content-Length"] = Формат(ПолучитьДвоичныеДанныеИзСтроки(Тело).Размер(), "ЧГ=0; ЧН=0");
	Ответ.ТелоТекст = Тело;

КонецПроцедуры

Функция ИзОкружения(Знач Имя, Знач ПоУмолчанию)
	Значение = ПолучитьПеременнуюСреды(Имя);
	Возврат ?(ЗначениеЗаполнено(Значение), Строка(Значение), ПоУмолчанию);
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта()

	Издатель = ИзОкружения("FAKE_IDP_ISSUER", "http://localhost:0");
	КлиентИдент = ИзОкружения("FAKE_IDP_CLIENT_ID", "фейк-клиент");
	Субъект = ИзОкружения("FAKE_IDP_SUBJECT", "субъект-провайдера");
	Почта = ИзОкружения("FAKE_IDP_EMAIL", "провайдерный@example.com");
	// без своего логина IdP отдаёт клеймом сам субъект
	Логин = ИзОкружения("FAKE_IDP_LOGIN", Субъект);
	ЖурналПрофиля = ИзОкружения("FAKE_IDP_USERINFO_LOG", "");

КонецПроцедуры
