// Точка входа фейкового IdP: поднимает winow с единственным контроллером-провайдером.
// Порт и приметы провайдера приходят окружением FAKE_IDP_*.

#Использовать autumn
#Использовать autumn-logos
#Использовать winow

КаталогЗапуска = Новый Файл(ТекущийСценарий().Источник).Путь;

Детальки = Новый Соответствие();
Детальки.Вставить("winow.АвтоСтарт", Истина);
Детальки.Вставить("winow.ИспользоватьПрикладнойСервер", Ложь);
Детальки.Вставить("winow.КаталогСПриложениями", ОбъединитьПути(КаталогЗапуска, "Классы"));
Детальки.Вставить("winow.Порт", Число(ПолучитьПеременнуюСреды("FAKE_IDP_PORT")));

Совет = Новый СоветДругогоМастера();
Совет.ЗначенияДеталек(Детальки);

Поделка = Новый Поделка(Совет);
Поделка.ЗапуститьПриложение();
