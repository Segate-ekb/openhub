// Двойник сессии исходящего HTTP: discovery, token, userinfo и список адресов почты отвечают
// заранее настроенным телом, в сеть набор не ходит. Прозвище боевое — в контейнере теста
// желудь занимает этот класс, и вход через провайдера идёт целиком через него. Незнакомый
// адрес двойник не глотает: запрос запоминается, и набор обязан о нём спросить.

Перем Издатель_;      // Строка - базовый issuer (без завершающего слеша)
Перем ТелоТокена_;    // Строка - JSON ответа token endpoint
Перем КодТокена_;     // Число  - HTTP-код ответа token endpoint
Перем ТелоПрофиля_;   // Строка - JSON ответа userinfo
Перем КодПрофиля_;    // Число  - HTTP-код userinfo
Перем ТелоАдресов_;   // Строка, Неопределено - JSON списка адресов; Неопределено — точки нет
Перем КодАдресов_;    // Число  - HTTP-код списка адресов
Перем ОбрывовАдресов_;   // Число - сколько ближайших запросов адресов не состоится
Перем ЗапросовАдресов_;  // Число - сколько раз спрашивали адреса, включая оборванные
Перем Таймауты_;         // Соответствие - «МЕТОД адрес» → Таймаут из параметров запроса
Перем Незнакомые_;       // Массив - запросы на адреса, которых двойник не знает

// Настраивает issuer, от которого строится discovery-документ, и забывает ожидания
// прежних запросов.
//
// Параметры:
//  Издатель - Строка - базовый issuer без завершающего слеша.
//
Процедура УстановитьИздателя(Знач Издатель) Экспорт
	Издатель_ = Издатель;
	Таймауты_ = Новый Соответствие();
КонецПроцедуры

// Настраивает ответ token endpoint.
//
// Параметры:
//  ТелоJSON - Строка - тело ответа.
//  Код - Число - HTTP-код ответа (необязательный, по умолчанию 200).
//
Процедура УстановитьОтветТокена(Знач ТелоJSON, Знач Код = 200) Экспорт
	ТелоТокена_ = ТелоJSON;
	КодТокена_ = Код;
КонецПроцедуры

// Настраивает ответ userinfo.
//
// Параметры:
//  ТелоJSON - Строка - тело ответа.
//  Код - Число - HTTP-код ответа (необязательный, по умолчанию 200).
//
Процедура УстановитьОтветПрофиля(Знач ТелоJSON, Знач Код = 200) Экспорт
	ТелоПрофиля_ = ТелоJSON;
	КодПрофиля_ = Код;
КонецПроцедуры

// Задаёт сценарий точки списка адресов почты (как GitHub /user/emails) целиком: сколько
// первых запросов не состоится и что ответят следующие. Счёт запросов начинается заново.
//
// Параметры:
//  ТелоJSON - Строка - тело ответа.
//  Код - Число - HTTP-код ответа (необязательный, по умолчанию 200).
//  Обрывов - Число - сколько первых запросов оборвать исключением, как 1connector при
//            обрыве соединения (необязательный, по умолчанию 0).
//
Процедура УстановитьОтветАдресов(Знач ТелоJSON, Знач Код = 200, Знач Обрывов = 0) Экспорт
	ТелоАдресов_ = ТелоJSON;
	КодАдресов_ = Код;
	ОбрывовАдресов_ = Обрывов;
	ЗапросовАдресов_ = 0;
КонецПроцедуры

// Сколько раз спрашивали список адресов с последней настройки ответа, включая оборванные.
//
// Возвращаемое значение:
//  Число.
//
Функция ЗапросовАдресов() Экспорт
	Возврат ЗапросовАдресов_;
КонецФункции

// Ожидания запросов с последней настройки издателя: Таймаут из параметров 1connector.
//
// Возвращаемое значение:
//  Соответствие - «МЕТОД адрес» → Число либо Неопределено, если вызывающий ожидания не задал.
//
Функция ТаймаутыЗапросов() Экспорт
	Возврат Таймауты_;
КонецФункции

// Запросы на незнакомые адреса с прошлого вызова — и забывает их.
//
// Возвращаемое значение:
//  Строка - «МЕТОД адрес» через перевод строки; пусто, если таких не было.
//
Функция ИзъятьНезнакомыеАдреса() Экспорт
	Результат = СтрСоединить(Незнакомые_, Символы.ПС);
	Незнакомые_ = Новый Массив();
	Возврат Результат;
КонецФункции

// Контракт сессии 1connector: GET на discovery, userinfo либо список адресов, POST на token
// endpoint. Незнакомый адрес запоминается и отвечает исключением.
//
// Параметры:
//  Метод - Строка - HTTP-метод.
//  URL - Строка - адрес запроса.
//  ДополнительныеПараметры - Структура - параметры 1connector (необязательный,
//                            по умолчанию Неопределено).
//
// Возвращаемое значение:
//  ФейкОтветаКоннектора.
//
Функция ВызватьМетод(Знач Метод, Знач URL, Знач ДополнительныеПараметры = Неопределено) Экспорт

	Адрес = Строка(URL);
	ЗапомнитьТаймаут(Метод, Адрес, ДополнительныеПараметры);

	Если ВРег(Строка(Метод)) = "POST" И Адрес = КонечнаяТочкаТокена() Тогда
		Возврат Ответ(КодТокена_, ТелоТокена_);
	ИначеЕсли ВРег(Строка(Метод)) <> "GET" Тогда
		Возврат Незнакомый(Метод, Адрес);
	КонецЕсли;

	Если СтрЗаканчиваетсяНа(Адрес, "/.well-known/openid-configuration") Тогда
		Возврат Ответ(200, ДокументDiscovery());
	ИначеЕсли Адрес = КонечнаяТочкаПрофиля() Тогда
		Возврат Ответ(КодПрофиля_, ТелоПрофиля_);
	ИначеЕсли Адрес = КонечнаяТочкаАдресов() И ТелоАдресов_ <> Неопределено Тогда
		Возврат ОтветАдресов();
	КонецЕсли;
	Возврат Незнакомый(Метод, Адрес);

КонецФункции

#Область Служебное

Функция КонечнаяТочкаТокена()
	Возврат Издатель_ + "/token";
КонецФункции

Функция КонечнаяТочкаПрофиля()
	Возврат Издатель_ + "/userinfo";
КонецФункции

Функция КонечнаяТочкаАдресов()
	Возврат Издатель_ + "/user/emails";
КонецФункции

Функция ОтветАдресов()

	ЗапросовАдресов_ = ЗапросовАдресов_ + 1;
	Если ОбрывовАдресов_ > 0 Тогда
		ОбрывовАдресов_ = ОбрывовАдресов_ - 1;
		ВызватьИсключение "An error occurred while sending the request." + Символы.ПС
			+ "caused by:" + Символы.ПС + "Connection reset by peer";
	КонецЕсли;
	Возврат Ответ(КодАдресов_, ТелоАдресов_);

КонецФункции

Функция Незнакомый(Знач Метод, Знач Адрес)
	Незнакомые_.Добавить(ВРег(Строка(Метод)) + " " + Адрес);
	ВызватьИсключение СтрШаблон("ФейкСессииOIDC: незнакомый адрес %1 %2", Метод, Адрес);
КонецФункции

Процедура ЗапомнитьТаймаут(Знач Метод, Знач Адрес, Знач ДополнительныеПараметры)
	Таймаут = Неопределено;
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		ДополнительныеПараметры.Свойство("Таймаут", Таймаут);
	КонецЕсли;
	Таймауты_.Вставить(ВРег(Строка(Метод)) + " " + Адрес, Таймаут);
КонецПроцедуры

Функция ДокументDiscovery()
	Данные = Новый Соответствие();
	Данные.Вставить("issuer", Издатель_);
	Данные.Вставить("authorization_endpoint", Издатель_ + "/authorize");
	Данные.Вставить("token_endpoint", КонечнаяТочкаТокена());
	Данные.Вставить("userinfo_endpoint", КонечнаяТочкаПрофиля());
	Данные.Вставить("jwks_uri", Издатель_ + "/jwks");
	Возврат ВJSON(Данные);
КонецФункции

Функция ВJSON(Знач Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция Ответ(Знач Код, Знач Тело)
	Результат = Новый ФейкОтветаКоннектора();
	Результат.Установить(Код, ?(Тело = Неопределено, "", Тело));
	Возврат Результат;
КонецФункции

#КонецОбласти

&Прозвище("СессияИсходящегоHTTP")
&Желудь
Процедура ПриСозданииОбъекта()
	Издатель_ = "https://idp.test";
	ТелоТокена_ = "{}";
	КодТокена_ = 200;
	ТелоПрофиля_ = "{}";
	КодПрофиля_ = 200;
	ТелоАдресов_ = Неопределено;
	КодАдресов_ = 200;
	ОбрывовАдресов_ = 0;
	ЗапросовАдресов_ = 0;
	Таймауты_ = Новый Соответствие();
	Незнакомые_ = Новый Массив();
КонецПроцедуры
