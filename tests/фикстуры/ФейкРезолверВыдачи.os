// Фейк РезолвераВыдачи: на любой запрос файла роняет заранее подготовленный сбой.
// Так проверяется, каким кодом отвечает выдача на отказ хранилища.

Перем Сбой_;   // ИнформацияОбОшибке либо Строка - что бросить вместо резолва

// Контракт РезолвераВыдачи: резолв артефакта. Заглушка вместо резолва бросает сбой.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяКанала - Строка - имя канала.
//  ИмяПакета - Строка - имя пакета.
//  Запрос - Структура - разобранный запрос файла.
//
// Возвращаемое значение:
//  Структура - до возврата дело не доходит.
//
Функция РазрешитьФайл(Знач ИмяПула, Знач ИмяКанала, Знач ИмяПакета, Знач Запрос) Экспорт

	ИмяПула = ИмяПула;
	ИмяКанала = ИмяКанала;
	ИмяПакета = ИмяПакета;
	Запрос = Запрос;

	ВызватьИсключение Сбой_;

КонецФункции

// Контракт РезолвераВыдачи: освобождение временной копии. Заглушке освобождать нечего.
//
// Параметры:
//  Путь - Строка - путь временной копии.
//
Процедура Освободить(Знач Путь) Экспорт
	Путь = Путь;
КонецПроцедуры

// Контракт РезолвераВыдачи: объяснение отказа. До него ветка сбоя не доходит.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяКанала - Строка - имя канала.
//  ИмяПакета - Строка - имя пакета.
//  Запрос - Структура - разобранный запрос файла.
//
// Возвращаемое значение:
//  Строка - пустая строка.
//
Функция ОбъяснитьОтказ(Знач ИмяПула, Знач ИмяКанала, Знач ИмяПакета, Знач Запрос) Экспорт

	ИмяПула = ИмяПула;
	ИмяКанала = ИмяКанала;
	ИмяПакета = ИмяПакета;
	Запрос = Запрос;

	Возврат "";

КонецФункции

Процедура ПриСозданииОбъекта(Знач Сбой)
	Сбой_ = Сбой;
КонецПроцедуры
