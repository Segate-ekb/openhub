// Фейк РезолвераВыдачи: роняет заранее подготовленный сбой — на резолве либо, когда версия
// «найдена», на чтении её тела. Так проверяется, каким кодом отвечает выдача на отказ хранилища.

Перем Сбой_;       // ИнформацияОбОшибке либо Строка - что бросить
Перем НаЧтении_;   // Булево - резолв находит версию, а сбой бросает чтение тела

// Контракт РезолвераВыдачи: резолв артефакта. Бросает сбой, а в режиме «сбой на чтении»
// находит версию без контрольной суммы.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяКанала - Строка - имя канала.
//  ИмяПакета - Строка - имя пакета.
//  Запрос - Структура - разобранный запрос файла.
//
// Возвращаемое значение:
//  Структура - найденное разрешение в режиме «сбой на чтении».
//
Функция РазрешитьФайл(Знач ИмяПула, Знач ИмяКанала, Знач ИмяПакета, Знач Запрос) Экспорт

	ИмяКанала = ИмяКанала;
	Запрос = Запрос;

	Если НЕ НаЧтении_ Тогда
		ВызватьИсключение Сбой_;
	КонецЕсли;

	Версия = Новый Структура("Версия, Sha256, Размер, Опубликована", "1.0.0", "", 0, '00010101');
	Возврат Новый Структура("Найдено, Версия, Координаты, ИмяАртефакта, ВерсиюВыбралХаб, ИмяПула",
		Истина, Версия, Неопределено, ИмяПакета + "-1.0.0.ospx", Ложь, ИмяПула);

КонецФункции

// Контракт РезолвераВыдачи: содержимое найденного артефакта. Заглушка бросает сбой.
//
// Параметры:
//  Разрешение - Структура - результат РазрешитьФайл.
//
// Возвращаемое значение:
//  ДвоичныеДанные - до возврата дело не доходит.
//
Функция Содержимое(Знач Разрешение) Экспорт
	Разрешение = Разрешение;
	ВызватьИсключение Сбой_;
КонецФункции

// Контракт РезолвераВыдачи: объяснение отказа. До него ветка сбоя не доходит.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  ИмяКанала - Строка - имя канала.
//  ИмяПакета - Строка - имя пакета.
//  Запрос - Структура - разобранный запрос файла.
//
// Возвращаемое значение:
//  Строка - пустая строка.
//
Функция ОбъяснитьОтказ(Знач ИмяПула, Знач ИмяКанала, Знач ИмяПакета, Знач Запрос) Экспорт

	ИмяПула = ИмяПула;
	ИмяКанала = ИмяКанала;
	ИмяПакета = ИмяПакета;
	Запрос = Запрос;

	Возврат "";

КонецФункции

Процедура ПриСозданииОбъекта(Знач Сбой, Знач НаЧтении = Ложь)
	Сбой_ = Сбой;
	НаЧтении_ = НаЧтении;
КонецПроцедуры
