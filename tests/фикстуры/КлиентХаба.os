// Фикстура: HTTP-клиент подопытного хаба. Соединение берёт у ЭкземплярХаба — ни порта,
// ни соединения клиент не строит сам. Второй хаб в сценарии — второй клиент, а не номер
// порта в параметре.

// 1connector нужен запросам, которые НЕ идут по Location: HTTPСоединение проходит
// перенаправление само, и адрес возврата штатным клиентом не наблюдаем вовсе.
#Использовать 1connector

Перем Хаб;
Перем ТаймаутСек;

#Область Соединение

// Соединение с подопытным хабом. Каждый вызов даёт новое: набор шлёт запросы подряд,
// и переиспользование одного соединения меняло бы условия теста.
//
// Возвращаемое значение:
//  HTTPСоединение - соединение с портом подопытного хаба.
//
Функция Соединение() Экспорт
	Возврат Хаб.Соединение(ТаймаутСек);
КонецФункции

// Полный адрес пути на подопытном хабе.
//
// Параметры:
//  Путь - Строка - путь запроса вместе со строкой параметров.
//
// Возвращаемое значение:
//  Строка - http://localhost:<порт><путь>.
//
Функция Адрес(Знач Путь) Экспорт
	Возврат СтрШаблон("http://localhost:%1%2", Формат(Хаб.Порт(), "ЧН=0; ЧГ=0"), Путь);
КонецФункции

#КонецОбласти

#Область Заголовки

// Заголовки с кукой сессии. Пустое значение даёт заголовки без Cookie — запрос уходит
// анонимным, а не с пустой кукой.
//
// Параметры:
//  Значение - Строка - значение куки oshub_session.
//
// Возвращаемое значение:
//  Соответствие - заголовки запроса.
//
Функция Кука(Знач Значение) Экспорт

	Заголовки = Новый Соответствие();

	Если ЗначениеЗаполнено(Значение) Тогда
		Заголовки.Вставить("Cookie", "oshub_session=" + Значение);
	КонецЕсли;

	Возврат Заголовки;

КонецФункции

// Заголовки с ключом доступа. Пустой ключ даёт заголовки без Authorization.
//
// Параметры:
//  Значение - Строка - значение токена без слова Bearer.
//
// Возвращаемое значение:
//  Соответствие - заголовки запроса.
//
Функция Токен(Знач Значение) Экспорт

	Заголовки = Новый Соответствие();

	Если ЗначениеЗаполнено(Значение) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + Значение);
	КонецЕсли;

	Возврат Заголовки;

КонецФункции

// Заголовки из одной пары.
//
// Параметры:
//  Имя      - Строка - имя заголовка.
//  Значение - Строка - значение заголовка.
//
// Возвращаемое значение:
//  Соответствие - заголовки запроса.
//
Функция Заголовок(Знач Имя, Знач Значение) Экспорт

	Заголовки = Новый Соответствие();
	Заголовки.Вставить(Строка(Имя), Строка(Значение));

	Возврат Заголовки;

КонецФункции

// Заголовки мутации, пришедшей из браузера: кука сессии и токен CSRF.
//
// Параметры:
//  Значение - Строка - значение куки сессии.
//  CSRF     - Строка - токен CSRF; пусто — заголовка нет.
//
// Возвращаемое значение:
//  Соответствие - заголовки запроса.
//
Функция ЗаголовкиМутации(Знач Значение, Знач CSRF) Экспорт

	Заголовки = Кука(Значение);

	Если ЗначениеЗаполнено(CSRF) Тогда
		Заголовки.Вставить("X-CSRF-Token", CSRF);
	КонецЕсли;

	Возврат Заголовки;

КонецФункции

// Заголовки запроса, ожидающего разметку.
Функция ЗаголовкиHTML(Знач Кука_ = "")

	Заголовки = Кука(Кука_);
	Заголовки.Вставить("Accept", "text/html");

	Возврат Заголовки;

КонецФункции

#КонецОбласти

#Область Запросы

// GET по адресу хаба.
//
// Параметры:
//  Путь      - Строка - путь запроса вместе со строкой параметров.
//  Заголовки - Соответствие - заголовки запроса (необязательный, по умолчанию без них).
//
// Возвращаемое значение:
//  HTTPОтвет - ответ хаба.
//
Функция GET(Знач Путь, Знач Заголовки = Неопределено) Экспорт
	Возврат Соединение().Получить(НовыйЗапрос(Путь, Заголовки));
КонецФункции

// GET от имени вошедшего пользователя.
//
// Параметры:
//  Путь - Строка - путь запроса вместе со строкой параметров.
//  Кука_ - Строка - значение куки сессии oshub_session.
//
// Возвращаемое значение:
//  HTTPОтвет - ответ хаба.
//
Функция GETСКукой(Знач Путь, Знач Кука_) Экспорт
	Возврат GET(Путь, Кука(Кука_));
КонецФункции

// GET с ключом доступа в Authorization.
//
// Параметры:
//  Путь   - Строка - путь запроса вместе со строкой параметров.
//  Токен_ - Строка - значение токена без слова Bearer; пусто — запрос без заголовка.
//
// Возвращаемое значение:
//  HTTPОтвет - ответ хаба.
//
Функция GETСТокеном(Знач Путь, Знач Токен_) Экспорт
	Возврат GET(Путь, Токен(Токен_));
КонецФункции

// GET страницы: Accept просит разметку.
//
// Параметры:
//  Путь  - Строка - путь запроса вместе со строкой параметров.
//  Кука_ - Строка - значение куки сессии; пусто — анонимно (необязательный).
//
// Возвращаемое значение:
//  HTTPОтвет - ответ хаба.
//
Функция GETСтраницы(Знач Путь, Знач Кука_ = "") Экспорт
	Возврат GET(Путь, ЗаголовкиHTML(Кука_));
КонецФункции

// HEAD по адресу хаба.
//
// Параметры:
//  Путь      - Строка - путь запроса вместе со строкой параметров.
//  Заголовки - Соответствие - заголовки запроса (необязательный, по умолчанию без них).
//
// Возвращаемое значение:
//  HTTPОтвет - ответ хаба.
//
Функция HEAD(Знач Путь, Знач Заголовки = Неопределено) Экспорт
	Возврат Соединение().ВызватьHTTPМетод("HEAD", НовыйЗапрос(Путь, Заголовки));
КонецФункции

// POST формы: тело кодируется как application/x-www-form-urlencoded. Пустая кука —
// запрос уходит анонимным, заголовка Cookie в нём нет вовсе.
//
// Параметры:
//  Путь  - Строка - путь запроса.
//  Поля  - Соответствие, Массив - поля формы; массив — записи с полями Имя и Значение.
//  Кука_ - Строка - значение куки сессии oshub_session; пусто — без куки.
//
// Возвращаемое значение:
//  HTTPОтвет - ответ хаба.
//
Функция POSTФормы(Знач Путь, Знач Поля, Знач Кука_) Экспорт
	Возврат ЗапросФормы("POST", Путь, Поля, Кука(Кука_));
КонецФункции

// Запрос с телом-формой: поля кодируются, если пришли не строкой.
Функция ЗапросФормы(Знач Метод, Знач Путь, Знач Поля, Знач Заголовки = Неопределено)

	Полные = Дополненные(Заголовки, "Content-Type", "application/x-www-form-urlencoded");
	Тело_ = ?(ТипЗнч(Поля) = Тип("Строка"), Поля, КодированнаяФорма(Поля));

	Возврат Отправить(Метод, Путь, Полные, Тело_);

КонецФункции

// Запрос с телом-JSON.
//
// Параметры:
//  Метод     - Строка - метод HTTP.
//  Путь      - Строка - путь запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  Заголовки - Соответствие - заголовки запроса (необязательный, по умолчанию без них).
//
// Возвращаемое значение:
//  HTTPОтвет - ответ хаба.
//
Функция ЗапросJSON(Знач Метод, Знач Путь, Знач ТелоЗапроса, Знач Заголовки = Неопределено) Экспорт

	Полные = Дополненные(Заголовки, "Content-Type", "application/json");

	Возврат Отправить(Метод, Путь, Полные, ?(ЗначениеЗаполнено(ТелоЗапроса), ТелоЗапроса, Неопределено));

КонецФункции

// POST тела-JSON от имени вошедшего пользователя.
//
// Параметры:
//  Путь  - Строка - путь запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  Кука_ - Строка - значение куки сессии; пусто — анонимно (необязательный).
//
// Возвращаемое значение:
//  HTTPОтвет - ответ хаба.
//
Функция POSTJSON(Знач Путь, Знач ТелоЗапроса, Знач Кука_ = "") Экспорт
	Возврат ЗапросJSON("POST", Путь, ТелоЗапроса, Кука(Кука_));
КонецФункции

// POST тела-JSON с ключом доступа.
//
// Параметры:
//  Путь  - Строка - путь запроса.
//  ТелоЗапроса - Строка - тело запроса.
//  Токен_ - Строка - значение токена без слова Bearer.
//
// Возвращаемое значение:
//  HTTPОтвет - ответ хаба.
//
Функция POSTJSONСТокеном(Знач Путь, Знач ТелоЗапроса, Знач Токен_) Экспорт
	Возврат ЗапросJSON("POST", Путь, ТелоЗапроса, Токен(Токен_));
КонецФункции

// Запрос с телом-JSON и ключом доступа: одна дверь для POST, PUT, PATCH и DELETE API.
//
// Параметры:
//  Метод  - Строка - метод HTTP.
//  Путь   - Строка - путь запроса.
//  ТелоЗапроса - Строка - тело запроса; пусто — тело не ставится.
//  Токен_ - Строка - значение токена без слова Bearer; пусто — запрос без заголовка.
//
// Возвращаемое значение:
//  HTTPОтвет - ответ хаба.
//
Функция ЗапросJSONСТокеном(Знач Метод, Знач Путь, Знач ТелоЗапроса, Знач Токен_) Экспорт
	Возврат ЗапросJSON(Метод, Путь, ТелоЗапроса, Токен(Токен_));
КонецФункции

// POST составной формы multipart/form-data: текстовые поля и файлы одним телом.
//
// Параметры:
//  Путь      - Строка - путь запроса.
//  Текстовые - Соответствие - текстовые поля формы.
//  Файловые  - Массив - части с полями Имя, ИмяФайла, ТипКонтента, Данные.
//  Кука_     - Строка - значение куки сессии; пусто — анонимно.
//
// Возвращаемое значение:
//  HTTPОтвет - ответ хаба.
//
Функция POSTСоставной(Знач Путь, Знач Текстовые, Знач Файловые, Знач Кука_) Экспорт

	Граница = "----oshub" + Лев(Строка(Новый УникальныйИдентификатор()), 12);

	Поток = Новый ПотокВПамяти();
	Запись = Новый ЗаписьДанных(Поток);

	Для Каждого КиЗ Из Текстовые Цикл
		Запись.ЗаписатьСимволы("--" + Граница + Символы.ВК + Символы.ПС
			+ СтрШаблон("Content-Disposition: form-data; name=""%1""", КиЗ.Ключ)
			+ Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС
			+ Строка(КиЗ.Значение) + Символы.ВК + Символы.ПС, КодировкаТекста.UTF8);
	КонецЦикла;

	Для Каждого Часть Из Файловые Цикл
		Запись.ЗаписатьСимволы("--" + Граница + Символы.ВК + Символы.ПС
			+ СтрШаблон("Content-Disposition: form-data; name=""%1""; filename=""%2""",
				Часть.Имя, Часть.ИмяФайла)
			+ Символы.ВК + Символы.ПС
			+ "Content-Type: " + Часть.ТипКонтента
			+ Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС, КодировкаТекста.UTF8);
		Запись.Записать(Часть.Данные);
		Запись.ЗаписатьСимволы(Символы.ВК + Символы.ПС, КодировкаТекста.UTF8);
	КонецЦикла;

	Запись.ЗаписатьСимволы("--" + Граница + "--" + Символы.ВК + Символы.ПС, КодировкаТекста.UTF8);
	Запись.Закрыть();

	Заголовки = Кука(Кука_);
	Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Граница);

	Запрос = НовыйЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Поток.ЗакрытьИПолучитьДвоичныеДанные());

	Возврат Соединение().ОтправитьДляОбработки(Запрос);

КонецФункции

#КонецОбласти

#Область ЗапросыБезПереходов

// GET, не идущий по Location: ответ показывает сам переход, а не страницу за ним.
//
// Параметры:
//  Путь      - Строка - путь запроса.
//  СтрокаКук - Строка - готовая строка заголовка Cookie; пусто — анонимно (необязательный).
//
// Возвращаемое значение:
//  Произвольный - ответ 1connector: Код, ТелоТекст, Заголовки, Куки.
//
Функция GETБезПереходов(Знач Путь, Знач СтрокаКук = "") Экспорт
	Возврат ПоАдресуБезПереходов(Адрес(Путь), СтрокаКук);
КонецФункции

// GET по уже готовому адресу, не идущий по Location: так читается адрес возврата,
// выданный предыдущим ответом.
//
// Параметры:
//  ПолныйАдрес - Строка - адрес целиком.
//  СтрокаКук   - Строка - готовая строка заголовка Cookie; пусто — анонимно (необязательный).
//
// Возвращаемое значение:
//  Произвольный - ответ 1connector.
//
Функция ПоАдресуБезПереходов(Знач ПолныйАдрес, Знач СтрокаКук = "") Экспорт

	Возврат СессияБезПереходов(СтрокаКук).ВызватьМетод("GET", ПолныйАдрес,
		Новый Структура("РазрешитьПеренаправление", Ложь));

КонецФункции

// POST формы, не идущий по Location.
//
// Параметры:
//  Путь      - Строка - путь запроса.
//  Поля      - Соответствие, Массив, Строка - поля формы либо готовое тело.
//  СтрокаКук - Строка - готовая строка заголовка Cookie; пусто — анонимно (необязательный).
//
// Возвращаемое значение:
//  Произвольный - ответ 1connector.
//
Функция POSTФормыБезПереходов(Знач Путь, Знач Поля, Знач СтрокаКук = "") Экспорт

	Сессия_ = СессияБезПереходов(СтрокаКук);
	Сессия_.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Тело_ = ?(ТипЗнч(Поля) = Тип("Строка"), Поля, КодированнаяФорма(Поля));

	Возврат Сессия_.ВызватьМетод("POST", Адрес(Путь),
		Новый Структура("РазрешитьПеренаправление, Данные", Ложь, Тело_));

КонецФункции

// Строка заголовка Cookie для куки сессии — её ждут запросы без переходов.
//
// Параметры:
//  Значение - Строка - значение куки oshub_session.
//
// Возвращаемое значение:
//  Строка - готовая строка заголовка; пустое значение — пустая строка.
//
Функция СтрокаКукиСессии(Знач Значение) Экспорт
	Возврат ?(ЗначениеЗаполнено(Значение), "oshub_session=" + Значение, "");
КонецФункции

#КонецОбласти

#Область Вход

// Вход по логину и паролю через /api/v1/login.
//
// Параметры:
//  Логин  - Строка - логин учётки.
//  Пароль - Строка - пароль учётки.
//
// Возвращаемое значение:
//  Строка - кука сессии; вход не удался — пустая строка.
//
Функция Войти(Знач Логин, Знач Пароль) Экспорт

	Тело_ = СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", Логин, Пароль);

	Возврат КукаСессии(ЗапросJSON("POST", "/api/v1/login", Тело_));

КонецФункции

#КонецОбласти

#Область РазборОтвета

// Кука сессии из заголовков Set-Cookie ответа.
//
// Параметры:
//  Ответ - HTTPОтвет - ответ хаба.
//
// Возвращаемое значение:
//  Строка - значение oshub_session; куки в ответе нет — пустая строка.
//
Функция КукаСессии(Знач Ответ) Экспорт
	Возврат КукаОтвета(Ответ, "oshub_session");
КонецФункции

// Значение произвольной куки из заголовков Set-Cookie ответа.
//
// Параметры:
//  Ответ   - HTTPОтвет - ответ хаба.
//  ИмяКуки - Строка - имя куки.
//
// Возвращаемое значение:
//  Строка - значение куки; куки в ответе нет — пустая строка.
//
Функция КукаОтвета(Знач Ответ, Знач ИмяКуки) Экспорт

	Для Каждого КиЗ Из Ответ.Заголовки Цикл

		Если ВРег(Строка(КиЗ.Ключ)) <> "SET-COOKIE" Тогда
			Продолжить;
		КонецЕсли;

		Значение = ЗначениеКуки(Строка(КиЗ.Значение), ИмяКуки);

		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

// Значение заголовка ответа без оглядки на регистр имени; пробелы по краям значения
// обрезаются — заголовок несёт значение, а не отступ отправителя.
//
// Параметры:
//  Ответ - HTTPОтвет - ответ хаба.
//  Имя   - Строка - имя заголовка.
//
// Возвращаемое значение:
//  Строка - значение заголовка; заголовка нет — пустая строка.
//
Функция ЗаголовокОтвета(Знач Ответ, Знач Имя) Экспорт

	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = ВРег(Строка(Имя)) Тогда
			Возврат СокрЛП(Строка(КиЗ.Значение));
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Тело ответа строкой.
//
// Параметры:
//  Ответ - HTTPОтвет - ответ хаба.
//
// Возвращаемое значение:
//  Строка - тело ответа.
//
Функция Тело(Знач Ответ) Экспорт
	Возврат Ответ.ПолучитьТелоКакСтроку();
КонецФункции

// Тело ответа, разобранное как JSON.
//
// Параметры:
//  Ответ - HTTPОтвет - ответ хаба.
//
// Возвращаемое значение:
//  Соответствие, Массив - разобранное тело.
//
Функция ТелоJSON(Знач Ответ) Экспорт

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Тело(Ответ));
	Разобранное = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат Разобранное;

КонецФункции

// Токен CSRF из скрытого поля формы на странице.
//
// Параметры:
//  ТелоСтраницы - Строка - разметка страницы.
//
// Возвращаемое значение:
//  Строка - токен; поля на странице нет — пустая строка.
//
Функция ТокенCSRF(Знач ТелоСтраницы) Экспорт
	Возврат ПослеМаркера(ТелоСтраницы, "name=""_csrf"" value=""", """");
КонецФункции

// Кусок текста между маркером и ближайшим за ним терминатором.
//
// Параметры:
//  Текст       - Строка - где искать.
//  Маркер      - Строка - что стоит перед искомым куском.
//  Терминатор  - Строка - что закрывает искомый кусок.
//
// Возвращаемое значение:
//  Строка - найденный кусок; маркера или терминатора нет — пустая строка.
//
Функция ПослеМаркера(Знач Текст, Знач Маркер, Знач Терминатор) Экспорт

	Поз = СтрНайти(Текст, Маркер);

	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(Текст, Поз + СтрДлина(Маркер));
	Конец = СтрНайти(Остаток, Терминатор);

	Возврат ?(Конец = 0, "", Лев(Остаток, Конец - 1));

КонецФункции

// Поля формы строкой application/x-www-form-urlencoded.
//
// Параметры:
//  Поля - Соответствие, Массив - поля формы; массив — записи с полями Имя и Значение.
//
// Возвращаемое значение:
//  Строка - закодированное тело.
//
Функция КодированнаяФорма(Знач Поля) Экспорт

	Части = Новый Массив();

	Если ТипЗнч(Поля) = Тип("Соответствие") Тогда
		Для Каждого КиЗ Из Поля Цикл
			Части.Добавить(Пара(КиЗ.Ключ, КиЗ.Значение));
		КонецЦикла;
	Иначе
		Для Каждого Поле Из Поля Цикл
			Части.Добавить(Пара(Поле.Имя, Поле.Значение));
		КонецЦикла;
	КонецЕсли;

	Возврат СтрСоединить(Части, "&");

КонецФункции

#КонецОбласти

// Запрос: явный Неопределено вторым параметром HTTPЗапрос не принимает.
Функция НовыйЗапрос(Знач Путь, Знач Заголовки)
	Возврат ?(Заголовки = Неопределено, Новый HTTPЗапрос(Путь), Новый HTTPЗапрос(Путь, Заголовки));
КонецФункции

Функция Отправить(Знач Метод, Знач Путь, Знач Заголовки, Знач ТелоЗапроса)

	Запрос = НовыйЗапрос(Путь, Заголовки);

	Если ТелоЗапроса <> Неопределено Тогда
		Запрос.УстановитьТелоИзСтроки(Строка(ТелоЗапроса), КодировкаТекста.UTF8);
	КонецЕсли;

	Если ВРег(Строка(Метод)) = "POST" Тогда
		Возврат Соединение().ОтправитьДляОбработки(Запрос);
	КонецЕсли;

	Возврат Соединение().ВызватьHTTPМетод(ВРег(Строка(Метод)), Запрос);

КонецФункции

// Копия заголовков с добавленной парой: исходное соответствие вызывающего не трогаем.
Функция Дополненные(Знач Заголовки, Знач Имя, Знач Значение)

	Полные = Новый Соответствие();

	Если Заголовки <> Неопределено Тогда
		Для Каждого КиЗ Из Заголовки Цикл
			Полные.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;

	Если Полные.Получить(Имя) = Неопределено Тогда
		Полные.Вставить(Имя, Значение);
	КонецЕсли;

	Возврат Полные;

КонецФункции

Функция СессияБезПереходов(Знач СтрокаКук)

	Сессия_ = Новый Сессия();
	Сессия_.Заголовки.Вставить("Accept", "text/html");

	Если ЗначениеЗаполнено(СтрокаКук) Тогда
		Сессия_.Заголовки.Вставить("Cookie", СтрокаКук);
	КонецЕсли;

	Возврат Сессия_;

КонецФункции

Функция Пара(Знач Имя, Знач Значение)
	Возврат КодироватьСтроку(Строка(Имя), СпособКодированияСтроки.URLEncoding)
		+ "=" + КодироватьСтроку(Строка(Значение), СпособКодированияСтроки.URLEncoding);
КонецФункции

// Значение куки из строки заголовка Set-Cookie.
Функция ЗначениеКуки(Знач СтрокаКук, Знач ИмяКуки)

	Маркер = ИмяКуки + "=";
	Поз = СтрНайти(СтрокаКук, Маркер);

	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(СтрокаКук, Поз + СтрДлина(Маркер));
	ТочкаЗпт = СтрНайти(Остаток, ";");

	Возврат СокрЛП(?(ТочкаЗпт = 0, Остаток, Лев(Остаток, ТочкаЗпт - 1)));

КонецФункции

Процедура ПриСозданииОбъекта(Знач ПодопытныйХаб, Знач ТаймаутСоединенияСек = 20)
	Хаб = ПодопытныйХаб;
	ТаймаутСек = ТаймаутСоединенияСек;
КонецПроцедуры
