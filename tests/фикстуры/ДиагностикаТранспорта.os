// Диагностика транспорта ДОСЛОВНО: так её отдаёт 1connector, и именно она приезжает
// стражу источников с горячего пути выдачи. Отказ соединения и неразрешившееся имя сняты
// с живого клиента (macOS, 1connector 1.x); тексты про сертификат и незнакомый сбой —
// дословные сообщения .NET, которые тот же клиент заворачивает в ту же обёртку. Переписывать
// их своими словами нельзя: сторож обязан судить то, что бывает на самом деле.

Перем Модуль_;  // путь внутрь контейнера, как его печатает платформа

#Область Образцы

// Соединение отбито: порт заявлен, но никем не слушается.
//
// Параметры:
//  Узел - Строка - «хост:порт», к которому не достучались.
//
// Возвращаемое значение:
//  Строка - блоб диагностики как есть.
//
Функция ОтбитоеСоединение(Знач Узел) Экспорт

	// живой клиент печатает порт ЗА скобками литерала IPv6: «[::ffff:127.0.0.1]:39947»
	Корень = СтрШаблон("Connection refused [::ffff:%1]:%2 (%1:%2)",
		ХостУзла(Узел), ПортУзла(Узел));
	Возврат Блоб(СтрШаблон("Внешнее исключение (System.Net.WebException): %1", Корень), Корень);

КонецФункции

// Имя не разрешилось: у адреса нет ответа DNS.
//
// Параметры:
//  Хост - Строка - имя, которого нет.
//
// Возвращаемое значение:
//  Строка - блоб диагностики как есть.
//
Функция ИмяНеРазрешилось(Знач Хост) Экспорт

	Корень = СтрШаблон("nodename nor servname provided, or not known (%1:80)", Хост);
	Возврат Блоб(СтрШаблон("Внешнее исключение (System.Net.WebException): %1", Корень), Корень);

КонецФункции

// Источник не ответил за отведённое время.
//
// Возвращаемое значение:
//  Строка - блоб диагностики как есть.
//
Функция Таймаут() Экспорт

	Корень = "The operation has timed out";
	Возврат Блоб(СтрШаблон("Внешнее исключение (System.Net.WebException): %1", Корень), Корень);

КонецФункции

// Сертификат источника не принят: просрочен, самоподписан, выдан неизвестным
// удостоверяющим центром либо выписан на другое имя.
//
// Возвращаемое значение:
//  Строка - блоб диагностики как есть.
//
Функция СертификатНеПринят() Экспорт

	Корень = "The remote certificate is invalid according to the validation procedure";
	Возврат Блоб("Внешнее исключение (System.Net.WebException):"
		+ " The SSL connection could not be established, see inner exception", Корень);

КонецФункции

// Сбой, о котором словарь причин ничего не знает.
//
// Возвращаемое значение:
//  Строка - блоб диагностики как есть.
//
Функция НезнакомоеИсключение() Экспорт

	Корень = "Unable to write data to the transport connection";
	Возврат Блоб(СтрШаблон("Внешнее исключение (System.IO.IOException): %1", Корень), Корень);

КонецФункции

// Незнакомый сбой, в корне которого адрес с учётными данными. Живой 1connector на macOS
// печатает только «хост:порт», но чужой текст бывает каким угодно, и наружу он идёт
// дословно — учётным данным в нём не место.
//
// Параметры:
//  Адрес - Строка - адрес источника вместе с учётными данными.
//
// Возвращаемое значение:
//  Строка - блоб диагностики как есть.
//
Функция НезнакомоеИсключениеСУчётнымиДанными(Знач Адрес) Экспорт

	Корень = СтрШаблон("failed to fetch %1 now", Адрес);
	Возврат Блоб(СтрШаблон("Внешнее исключение (System.Net.WebException): %1", Корень), Корень);

КонецФункции

// Приметы, которым в причине для человека места нет.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ВнутренностиКонтейнера() Экспорт

	Результат = Новый Массив();
	Результат.Добавить("{Модуль");
	Результат.Добавить("Error in line");
	Результат.Добавить("oscript_modules");
	Результат.Добавить("/src/");
	Результат.Добавить(".os");
	Результат.Добавить("caused by");
	Результат.Добавить("Внешнее исключение");
	Возврат Результат;

КонецФункции

#КонецОбласти

// Обёртка платформы, вложенная сама в себя, строка исходника за её закрывающей скобкой
// и хвост «caused by» — ровно в этом порядке и без переносов, как приходит однострочно.
Функция Блоб(Знач Текст, Знач Корень)

	Внутренний = СтрШаблон("{Модуль %1 / Error in line: 614 / %2}", Модуль_, Текст);
	Внешний = СтрШаблон("{Модуль %1 / Error in line: 710 / %2}", Модуль_, Внутренний);

	Возврат Внешний
		+ "  Возврат Соединение.ВызватьHTTPМетод(ПодготовленныйЗапрос.Метод,"
		+ " ПодготовленныйЗапрос.HTTPЗапрос, Настройки.ИмяВыходногоФайла);"
		+ СтрШаблон("  caused by: %1  caused by: %1  caused by: %1", Корень);

КонецФункции

Функция ХостУзла(Знач Узел)
	Разделитель = СтрНайти(Узел, ":", НаправлениеПоиска.СКонца);
	Возврат ?(Разделитель > 0, Лев(Узел, Разделитель - 1), Узел);
КонецФункции

Функция ПортУзла(Знач Узел)
	Разделитель = СтрНайти(Узел, ":", НаправлениеПоиска.СКонца);
	Возврат ?(Разделитель > 0, Сред(Узел, Разделитель + 1), "");
КонецФункции

Процедура ПриСозданииОбъекта()
	Модуль_ = "/Users/dev/проект/oscript_modules/1connector/src/internal/Модули/КоннекторHTTPСлужебный.os";
КонецПроцедуры
