// Фейк ХранилищаПользователей: по идентификатору отдаёт структуру с признаком Админ;
// список админов задаётся CSV (пустой — админов нет вовсе). Обе двери на месте: точечная
// и разрез по списку; любая из них умеет отказать — этим меряется радиус fail-closed.

Перем Админы;      // Соответствие: идентификатор -> Истина
Перем Нечитаемая;  // Число - учётка, чтение которой отказывает; 0 — отказов нет
Перем Счётчик;     // СчётчикОбращений — счёт обращений к фикстуре

// Сколько раз хранилище спросили об учётках с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Чтений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Делает одну учётку нечитаемой: точечное чтение о ней падает, а разрез падает целиком,
// если она в списке, — так ведёт себя база с битой строкой.
//
// Параметры:
//  Идентификатор - Число - учётка, чтение которой отказывает; 0 снимает отказ.
//
Процедура ПадатьНаУчётке(Знач Идентификатор) Экспорт
	Нечитаемая = Цел(Идентификатор);
КонецПроцедуры

// Контракт ХранилищаПользователей: пользователь по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пользователя.
//
// Возвращаемое значение:
//  Структура - Идентификатор (Число), Админ (Булево).
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт

	Счётчик.Отметить();
	ОтказатьЕслиНечитаемая(Цел(Идентификатор));

	Возврат Учётка(Идентификатор);

КонецФункции

// Контракт ХранилищаПользователей: учётки перечисленных идентификаторов.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пользователей.
//
// Возвращаемое значение:
//  Соответствие - ключ Число, значение Структура (Идентификатор, Админ).
//
Функция ПоИдентификаторам(Знач Идентификаторы) Экспорт

	Счётчик.Отметить();

	Результат = Новый Соответствие();
	Для Каждого Идентификатор Из Идентификаторы Цикл
		ОтказатьЕслиНечитаемая(Цел(Идентификатор));
		Результат.Вставить(Цел(Идентификатор), Учётка(Идентификатор));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ОтказатьЕслиНечитаемая(Знач Идентификатор)
	Если Нечитаемая > 0 И Идентификатор = Нечитаемая Тогда
		ВызватьИсключение "Учётка недоступна: " + Формат(Идентификатор, "ЧН=0; ЧГ=0");
	КонецЕсли;
КонецПроцедуры

Функция Учётка(Знач Идентификатор)
	Возврат Новый Структура("Идентификатор, Админ",
		Цел(Идентификатор), Админы.Получить(Цел(Идентификатор)) = Истина);
КонецФункции

Процедура ПриСозданииОбъекта(Знач АдминыCSV = "100")

	Админы = Новый Соответствие();
	Нечитаемая = 0;
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
	Для Каждого Элемент Из СтрРазделить(Строка(АдминыCSV), ",") Цикл
		Норм = СокрЛП(Элемент);
		Если ЗначениеЗаполнено(Норм) Тогда
			Админы.Вставить(Число(Норм), Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
