// Фейк ХранилищаПользователей: по идентификатору отдаёт структуру с признаком Админ;
// список админов задаётся CSV (пустой — админов нет вовсе).

Перем Админы; // Соответствие: идентификатор -> Истина

// Контракт ХранилищаПользователей: пользователь по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пользователя.
//
// Возвращаемое значение:
//  Структура - Идентификатор (Число), Админ (Булево).
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Новый Структура("Идентификатор, Админ",
		Цел(Идентификатор), Админы.Получить(Цел(Идентификатор)) = Истина);
КонецФункции

Процедура ПриСозданииОбъекта(Знач АдминыCSV = "100")

	Админы = Новый Соответствие();
	Для Каждого Элемент Из СтрРазделить(Строка(АдминыCSV), ",") Цикл
		Норм = СокрЛП(Элемент);
		Если ЗначениеЗаполнено(Норм) Тогда
			Админы.Вставить(Число(Норм), Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
