// Фейк СервисаПулов для экранов зеркал: поиск пула по имени и признак публикации.

Перем Пулы_;

// Добавляет пул в фикстуру.
//
// Параметры:
//  Пул - Произвольный - объект пула (нужны поля Имя и ПубликацияРазрешена).
//
Процедура ДобавитьПул(Знач Пул) Экспорт
	Пулы_.Добавить(Пул);
КонецПроцедуры

// Пул по имени.
//
// Параметры:
//  Имя - Строка - имя пула.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - пул либо Неопределено, если такого нет.
//
Функция НайтиПул(Знач Имя) Экспорт

	Для Каждого Пул Из Пулы_ Цикл
		Если Пул.Имя = Имя Тогда
			Возврат Пул;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Все пулы фикстуры.
//
// Возвращаемое значение:
//  Массив - добавленные пулы.
//
Функция ВсеПулы() Экспорт
	Возврат Пулы_;
КонецФункции

// Принимает ли пул публикации.
//
// Параметры:
//  Пул - Произвольный - пул.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПубликацияРазрешена(Знач Пул) Экспорт
	Возврат Пул.ПубликацияРазрешена = Истина;
КонецФункции

Процедура ПриСозданииОбъекта() Экспорт
	Пулы_ = Новый Массив();
КонецПроцедуры
