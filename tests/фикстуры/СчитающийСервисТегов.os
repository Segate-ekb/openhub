// СервисТегов-обёртка: делегирует настоящему сервису и считает обращения (сторож N+1).

Перем Настоящий;
Перем СчётКаналыПакета;
Перем СчётВерсияТега;
Перем СчётВерсииТега;
Перем СчётТегиПакета;

#Область Счётчики

// Сколько раз звали каждый метод с момента создания обёртки.
//
// Возвращаемое значение:
//  Структура - КаналыПакета, ВерсияТега, ВерсииТега, ТегиПакета (Число).
//
Функция Вызовов() Экспорт
	Результат = Новый Структура();
	Результат.Вставить("КаналыПакета", СчётКаналыПакета);
	Результат.Вставить("ВерсияТега", СчётВерсияТега);
	Результат.Вставить("ВерсииТега", СчётВерсииТега);
	Результат.Вставить("ТегиПакета", СчётТегиПакета);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ДелегированиеСервисуТегов

// Каналы пакета; считает обращение и делегирует настоящему сервису.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив - каналы пакета.
//
Функция КаналыПакета(Знач ПакетИдентификатор) Экспорт
	СчётКаналыПакета = СчётКаналыПакета + 1;
	Возврат Настоящий.КаналыПакета(ПакетИдентификатор);
КонецФункции

// Версия тега; считает обращение и делегирует настоящему сервису.
//
// Параметры:
//  Тег - Произвольный - запись тега.
//
// Возвращаемое значение:
//  Произвольный - версия тега либо Неопределено.
//
Функция ВерсияТега(Знач Тег) Экспорт
	СчётВерсияТега = СчётВерсияТега + 1;
	Возврат Настоящий.ВерсияТега(Тег);
КонецФункции

// Версии тега; считает обращение и делегирует настоящему сервису.
//
// Параметры:
//  Тег - Произвольный - запись тега.
//
// Возвращаемое значение:
//  Массив - версии тега.
//
Функция ВерсииТега(Знач Тег) Экспорт
	СчётВерсииТега = СчётВерсииТега + 1;
	Возврат Настоящий.ВерсииТега(Тег);
КонецФункции

// Теги пакета; считает обращение и делегирует настоящему сервису.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив - теги пакета.
//
Функция ТегиПакета(Знач ПакетИдентификатор) Экспорт
	СчётТегиПакета = СчётТегиПакета + 1;
	Возврат Настоящий.ТегиПакета(ПакетИдентификатор);
КонецФункции

// Правило тега; делегирует настоящему сервису без подсчёта.
//
// Параметры:
//  Тег - Произвольный - запись тега.
//
// Возвращаемое значение:
//  Произвольный - правило тега.
//
Функция ПравилоИзТега(Знач Тег) Экспорт
	Возврат Настоящий.ПравилоИзТега(Тег);
КонецФункции

// Снят ли с тега запрет повторной публикации; делегирует настоящему сервису без подсчёта:
// значение читается из уже полученной записи тега и в хранилище не ходит.
//
// Параметры:
//  Тег - Произвольный - запись тега.
//
// Возвращаемое значение:
//  Булево - снят ли запрет переиздания номеров этого тега.
//
Функция ЗапретСнят(Знач Тег) Экспорт
	Возврат Настоящий.ЗапретСнят(Тег);
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач _Настоящий)

	Настоящий = _Настоящий;
	СчётКаналыПакета = 0;
	СчётВерсияТега = 0;
	СчётВерсииТега = 0;
	СчётТегиПакета = 0;

КонецПроцедуры
