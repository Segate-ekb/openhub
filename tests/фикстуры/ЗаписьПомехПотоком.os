// Обработчик фонового задания для нагрузочного сторожа свёртки: пишет помехи по кругу
// и запоминает первую жалобу. Своего утверждения не делает — судит набор по таблице.

Перем Летопись;     // ЛетописьПомех
Перем Подсистема_;  // Строка
Перем Объект_;      // Строка
Перем Предметы;     // Массив из Строка — по предмету на круг; один предмет = один ключ
Перем Кругов;       // Число
Перем Прогон_;      // Строка
Перем Записано;     // Число - сделанных вызовов
Перем Жалоба_;      // Строка - первая жалоба; "" — поток отработал чисто

// Жалоба потока: текст сбоя; пустая строка — писалось без исключений.
//
// Возвращаемое значение:
//  Строка.
//
Функция Жалоба() Экспорт
	Возврат Жалоба_;
КонецФункции

// Сколько вызовов записи поток успел сделать.
//
// Возвращаемое значение:
//  Число.
//
Функция Записано() Экспорт
	Возврат Записано;
КонецФункции

// Контракт обработчика фонового задания.
Процедура Исполнить() Экспорт

	Попытка
		ПисатьКруги();
	Исключение
		Пожаловаться("запись помех упала: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура ПисатьКруги()

	Для Круг = 1 По Кругов Цикл
		Для Каждого Предмет Из Предметы Цикл
			Летопись.Записать(Подсистема_, Объект_, Предмет, "mirror_empty_body",
				"Источник ответил без тела", Прогон_);
			Записано = Записано + 1;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура Пожаловаться(Знач Текст)
	Если НЕ ЗначениеЗаполнено(Жалоба_) Тогда
		Жалоба_ = Текст;
	КонецЕсли;
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач ЛетописьПомех, Знач Подсистема, Знач Объект,
	Знач СписокПредметов, Знач ЧислоКругов, Знач Прогон = "")

	Летопись = ЛетописьПомех;
	Подсистема_ = Подсистема;
	Объект_ = Объект;
	Предметы = СписокПредметов;
	Кругов = ЧислоКругов;
	Прогон_ = Прогон;
	Записано = 0;
	Жалоба_ = "";

КонецПроцедуры
