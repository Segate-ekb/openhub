// Обёртка ХранилищаПользователей, считающая обращения к нему: сами учётки отдаёт
// настоящее хранилище, счёт нужен там, где цена выдачи росла числом строк.

Перем Хранилище;   // ХранилищеПользователей — настоящий источник учёток
Перем Счётчик;     // СчётчикОбращений — счёт обращений к хранилищу

// Сколько раз хранилище спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Контракт ХранилищаПользователей: пользователь по идентификатору; считает обращение.
//
// Параметры:
//  Идентификатор - Число - идентификатор пользователя.
//
// Возвращаемое значение:
//  Пользователь, Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Счётчик.Отметить();
	Возврат Хранилище.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Контракт ХранилищаПользователей: учётки перечисленных идентификаторов; считает обращение.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пользователей.
//
// Возвращаемое значение:
//  Соответствие - ключ Число, значение Пользователь; ненайденных в нём нет.
//
Функция ПоИдентификаторам(Знач Идентификаторы) Экспорт
	Счётчик.Отметить();
	Возврат Хранилище.ПоИдентификаторам(Идентификаторы);
КонецФункции

Процедура ПриСозданииОбъекта(Знач НастоящееХранилище)
	Хранилище = НастоящееХранилище;
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
