// Фикстура: пространство имён, у которого лежит хранилище пулов. Ни занятости, ни свободы
// оно не знает — оно просто не отвечает, и это сбой, а не занятое имя.

// Проверяет, занято ли имя существующим пулом.
//
// Параметры:
//  Имя - Строка - имя в любом регистре.
//
// Возвращаемое значение:
//  Булево - никогда: хранилище пулов недоступно.
//
Функция ЗанятоПулом(Знач Имя) Экспорт
	ВызватьИсключение "Хранилище пулов недоступно: соединение с базой потеряно";
КонецФункции

// Проверяет, занято ли имя логином существующего пользователя.
//
// Параметры:
//  Имя - Строка - имя в любом регистре.
//
// Возвращаемое значение:
//  Булево - никогда: хранилище пулов недоступно.
//
Функция ЗанятоЛогином(Знач Имя) Экспорт
	ВызватьИсключение "Хранилище пулов недоступно: соединение с базой потеряно";
КонецФункции

// Проверяет, что имя свободно для пула.
//
// Параметры:
//  Имя - Строка - предполагаемое имя пула.
//  СвойЛогин - Строка - логин владельца личного пула (необязательный, по умолчанию "").
//
Процедура ПроверитьСвободноДляПула(Знач Имя, Знач СвойЛогин = "") Экспорт
	ВызватьИсключение "Хранилище пулов недоступно: соединение с базой потеряно";
КонецПроцедуры

// Проверяет, что имя свободно для логина.
//
// Параметры:
//  Логин - Строка - предполагаемый логин.
//
Процедура ПроверитьСвободноДляЛогина(Знач Логин) Экспорт
	ВызватьИсключение "Хранилище пулов недоступно: соединение с базой потеряно";
КонецПроцедуры
