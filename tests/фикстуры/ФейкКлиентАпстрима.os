// Фейк КлиентаАпстрима без сети: ответ по конкретному пути либо общий ответ на любой путь,
// журнал запросов (базовый адрес и путь) и счётчик скачиваний.

Перем КодДанных;
Перем ДанныеОтвета;
Перем ETagДанных;
Перем КодТекста;
Перем ТелоТекста;
Перем ETagТекста;
Перем ТекстыПоПути;    // Соответствие: путь → Структура(Код, Тело, ETag)
Перем СбоиПоПути;      // Соответствие: путь → Истина
Перем Запросы;         // Массив из Структура(База, Путь) — обращения в порядке вызова
Перем СчётчикСкачиваний;

// Задаёт ответ на СкачатьДанные.
//
// Параметры:
//  Код - Число - HTTP-код ответа.
//  Данные - ДвоичныеДанные - тело ответа.
//  ETag - Строка - ETag ответа (необязательный, по умолчанию "").
//
Процедура УстановитьОтветДанные(Знач Код, Знач Данные, Знач ETag = "") Экспорт
	КодДанных = Код;
	ДанныеОтвета = Данные;
	ETagДанных = ETag;
КонецПроцедуры

// Задаёт ответ на ПолучитьТекст для любого пути, у которого нет собственного ответа.
//
// Параметры:
//  Код - Число - HTTP-код ответа.
//  Тело - Строка - тело ответа.
//  ETag - Строка - ETag ответа (необязательный, по умолчанию "").
//
Процедура УстановитьОтветТекст(Знач Код, Знач Тело, Знач ETag = "") Экспорт
	КодТекста = Код;
	ТелоТекста = Тело;
	ETagТекста = ETag;
КонецПроцедуры

// Задаёт ответ на ПолучитьТекст по конкретному относительному пути.
//
// Параметры:
//  Путь - Строка - относительный путь запроса, например "package/alfa".
//  Код - Число - HTTP-код ответа.
//  Тело - Строка - тело ответа.
//  ETag - Строка - ETag ответа (необязательный, по умолчанию "").
//
Процедура УстановитьОтветТекстПоПути(Знач Путь, Знач Код, Знач Тело, Знач ETag = "") Экспорт
	ТекстыПоПути.Вставить(СокрЛП(Строка(Путь)),
		Новый Структура("Код, Тело, ETag", Код, Тело, ETag));
КонецПроцедуры

// Заставляет запрос по этому пути бросить исключение — сбой транспорта, а не HTTP-код.
//
// Параметры:
//  Путь - Строка - относительный путь запроса.
//
Процедура УстановитьСбойПоПути(Знач Путь) Экспорт
	СбоиПоПути.Вставить(СокрЛП(Строка(Путь)), Истина);
КонецПроцедуры

// Относительные пути всех запросов в порядке обращения.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ПутиЗапросов() Экспорт
	Возврат Поле("Путь");
КонецФункции

// Базовые адреса всех запросов в порядке обращения: к какому корню обратился клиент.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция БазыЗапросов() Экспорт
	Возврат Поле("База");
КонецФункции

// Число обращений СкачатьДанные — для проверки повторной загрузки после промаха.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоСкачиваний() Экспорт
	Возврат СчётчикСкачиваний;
КонецФункции

// Контракт КлиентаАпстрима: заранее заданный ответ, без обращения к сети.
//
// Параметры:
//  БазовыйURL - Строка - базовый адрес апстрима; журналируется.
//  ОтносительныйПуть - Строка - путь артефакта; журналируется.
//  УсловныйETag - Строка - ETag условного запроса (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура (Код, Данные, ETag, Пояснение).
//
// BSLLS:UnusedParameters-off
Функция СкачатьДанные(Знач БазовыйURL, Знач ОтносительныйПуть, Знач УсловныйETag = "") Экспорт
	ЗапомнитьЗапрос(БазовыйURL, ОтносительныйПуть);
	СчётчикСкачиваний = СчётчикСкачиваний + 1;
	Возврат Новый Структура("Код, Данные, ETag, Пояснение", КодДанных, ДанныеОтвета, ETagДанных, "");
КонецФункции

// Контракт КлиентаАпстрима: ответ по пути, иначе общий ответ; без обращения к сети.
//
// Параметры:
//  БазовыйURL - Строка - базовый адрес апстрима; журналируется.
//  ОтносительныйПуть - Строка - путь ресурса; по нему выбирается ответ.
//  УсловныйETag - Строка - ETag условного запроса (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура (Код, Тело, ETag, Пояснение).
//
Функция ПолучитьТекст(Знач БазовыйURL, Знач ОтносительныйПуть, Знач УсловныйETag = "") Экспорт

	Ключ = ЗапомнитьЗапрос(БазовыйURL, ОтносительныйПуть);
	Если СбоиПоПути.Получить(Ключ) <> Неопределено Тогда
		ВызватьИсключение СтрШаблон("Фейк апстрима: сбой запроса ""%1""", Ключ);
	КонецЕсли;

	Ответ = ТекстыПоПути.Получить(Ключ);
	Если Ответ = Неопределено Тогда
		Возврат Новый Структура("Код, Тело, ETag, Пояснение", КодТекста, ТелоТекста, ETagТекста, "");
	КонецЕсли;
	Возврат Новый Структура("Код, Тело, ETag, Пояснение", Ответ.Код, Ответ.Тело, Ответ.ETag, "");

КонецФункции

Функция ЗапомнитьЗапрос(Знач БазовыйURL, Знач ОтносительныйПуть)
	Ключ = СокрЛП(Строка(ОтносительныйПуть));
	Запросы.Добавить(Новый Структура("База, Путь", СокрЛП(Строка(БазовыйURL)), Ключ));
	Возврат Ключ;
КонецФункции

Функция Поле(Знач Имя)
	Значения = Новый Массив();
	Для Каждого Запрос Из Запросы Цикл
		Значения.Добавить(Запрос[Имя]);
	КонецЦикла;
	Возврат Значения;
КонецФункции

Процедура ПриСозданииОбъекта()
	КодДанных = 0;
	ДанныеОтвета = Неопределено;
	ETagДанных = "";
	КодТекста = 0;
	ТелоТекста = "";
	ETagТекста = "";
	ТекстыПоПути = Новый Соответствие();
	СбоиПоПути = Новый Соответствие();
	Запросы = Новый Массив();
	СчётчикСкачиваний = 0;
КонецПроцедуры
