// Фикстура: КаталогСобытий, собранный из описаний событий всех предметов без контейнера —
// тот же перечень, что у живого хаба.

Перем Объявления;   // фикстура ОбъявленияПредметов

// Перечень событий хаба над названным издателем.
//
// Параметры:
//  Издатель - ИздательСобытий, Неопределено - источник имён типов; не задан — новый
//             (необязательный).
//
// Возвращаемое значение:
//  КаталогСобытий - перечень из описаний всех предметов.
//
Функция Каталог(Знач Издатель = Неопределено) Экспорт

	Желуди = Новый Соответствие();
	Желуди.Вставить("ИздательСобытий", ?(Издатель = Неопределено, Новый ИздательСобытий(), Издатель));
	Возврат Новый КаталогСобытий(Объявления.Собрать("ОписанияСобытий", "ОписанияСобытий", Желуди));

КонецФункции

// Параметры:
//  ПоискКлассов - КлассыСлоя - через него классы попадают в процесс.
//  КаталогМодулей - Строка - корень src/модули.
//
Процедура ПриСозданииОбъекта(Знач ПоискКлассов, Знач КаталогМодулей)

	РеестрФикстур.Подключить("ОбъявленияПредметов");
	Объявления = Новый ОбъявленияПредметов(ПоискКлассов, КаталогМодулей);

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "события", "Классы"));
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "подписки", "Классы"), "КаталогСобытий");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "реестр", "Классы"), "ЗаполнениеПула");
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);

КонецПроцедуры
