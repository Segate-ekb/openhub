// Заглушка окружения ВитринаПакетов: провенанс версий и служба кабинета.

Перем БезСобственныхВерсий;
Перем СвоиИмена;  // Соответствие: идентификатор пакета -> Истина; пусто — решает переключатель

// Есть ли у имени собственные версии (контракт СервисПроисхождения).
//
// Параметры:
//  Идентификатор - Произвольный - идентификатор пакета.
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьСобственныеВерсии(Знач Идентификатор) Экспорт

	Если СвоиИмена.Количество() > 0 Тогда
		Возврат СвоиИмена.Получить(Цел(Идентификатор)) = Истина;
	КонецЕсли;
	Возврат НЕ БезСобственныхВерсий;

КонецФункции

// Свои имена среди перечисленных — батч-контракт СервисПроисхождения, которым списку
// карточек отвечают разом.
//
// Параметры:
//  ПакетИдентификаторы - Массив - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Соответствие - идентификатор пакета в Истина; чужого имени в множестве нет.
//
Функция СвоиИменаСреди(Знач ПакетИдентификаторы) Экспорт

	Результат = Новый Соответствие();
	Для Каждого Идентификатор Из ПакетИдентификаторы Цикл
		Если ЕстьСобственныеВерсии(Идентификатор) Тогда
			Результат.Вставить(Цел(Идентификатор), Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Объявляет имя своим поимённо: список карточек показывает и свои имена, и привезённые.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета с собственными версиями.
//
Процедура ОбъявитьСвоим(Знач ПакетИдентификатор) Экспорт
	СвоиИмена.Вставить(Цел(ПакетИдентификатор), Истина);
КонецПроцедуры

// Пакеты в управлении смотрящего (контракт СлужбаКабинета).
//
// Параметры:
//  Пользователь - Произвольный - субъект запроса.
//
// Возвращаемое значение:
//  Массив - всегда пустой: карточка настроек в этих тестах не проверяется.
//
Функция ПакетыВУправлении(Знач Пользователь) Экспорт
	Возврат Новый Массив();
КонецФункции

// Переключает ветку «пакет пришёл с апстрима».
//
// Параметры:
//  Значение - Булево - Истина, если собственных версий у имени нет.
//
Процедура УстановитьБезСобственныхВерсий(Знач Значение) Экспорт
	БезСобственныхВерсий = Значение;
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	БезСобственныхВерсий = Ложь;
	СвоиИмена = Новый Соответствие();
КонецПроцедуры
