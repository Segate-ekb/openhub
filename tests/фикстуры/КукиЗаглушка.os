// Заглушка кук запроса winow (контракт winow.Куки).

Перем Значения;

// Кладёт куку.
//
// Параметры:
//  Имя      - Строка - имя куки.
//  Значение - Строка - значение как пришло бы от браузера.
//
Процедура Добавить(Знач Имя, Знач Значение) Экспорт
	Значения.Вставить(Имя, Значение);
КонецПроцедуры

// Значение куки по имени (контракт winow.Куки).
//
// Параметры:
//  Имя - Строка - имя куки.
//
// Возвращаемое значение:
//  Строка, Неопределено - значение либо Неопределено, если куки нет.
//
Функция ПолучитьЗначениеПоИмени(Знач Имя) Экспорт
	Возврат Значения.Получить(Имя);
КонецФункции

Процедура ПриСозданииОбъекта()
	Значения = Новый Соответствие();
КонецПроцедуры
