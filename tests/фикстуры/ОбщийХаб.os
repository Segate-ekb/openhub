// Хаб группы живых наборов: внешний, поднятый scripts/тесты.sh на весь прогон, либо свой,
// поднятый по описанию группы из ГруппыХабов, когда набор запущен поодиночке.

// Хаб группы для набора. Задана переменная OSHUB_TEST_HUB_<ИДЕНТИФИКАТОР> — экземпляр подключается
// к внешнему хабу и Остановить() его не гасит; не ответивший /health за СрокСек внешний хаб — исключение.
// Не задана — поднимает свой хаб группы.
//
// Параметры:
//  Группа  - Строка - имя группы из ГруппыХабов («витрина»).
//  СрокСек - Число  - сколько секунд ждать ответа /health внешнего хаба.
//
// Возвращаемое значение:
//  ЭкземплярХаба - работающий хаб группы.
//
Функция Экземпляр(Знач Группа, Знач СрокСек = 15) Экспорт

	Описание = ГруппыХабов.Описание(Группа);

	РеестрФикстур.Подключить("ЭкземплярХаба");
	Хаб = Новый ЭкземплярХаба(90);

	Переменная = ГруппыХабов.ПеременнаяАдреса(Описание.Имя);
	Адрес = ПолучитьПеременнуюСреды(Переменная);
	Если ЗначениеЗаполнено(Адрес) Тогда
		Журнал = ПолучитьПеременнуюСреды(ГруппыХабов.ПеременнаяЖурнала(Описание.Имя));
		Хаб.ПодключитьсяКВнешнему(Адрес, ?(ЗначениеЗаполнено(Журнал), Журнал, ""),
			СтрШаблон("общий хаб группы «%1» (%2)", Описание.Имя, Переменная));
		Попытка
			Хаб.Дождаться(СрокСек);
		Исключение
			ВызватьИсключение СтрШаблон("Общий хаб группы «%1» на %2 не отвечает на /health %3 с (адрес из %4): %5",
				Описание.Имя, Адрес, СрокСек, Переменная, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Возврат Хаб;
	КонецЕсли;

	Поднять(Хаб, Описание);

	Возврат Хаб;

КонецФункции

// Поднимает хаб по описанию группы: временный каталог с префиксом группы, её окружение и сидер.
//
// Параметры:
//  Хаб      - ЭкземплярХаба - ещё не запущенный экземпляр.
//  Описание - Структура     - описание группы из ГруппыХабов.Описание().
//
// Возвращаемое значение:
//  Строка - корень временного каталога хаба.
//
Функция Поднять(Знач Хаб, Знач Описание) Экспорт
	Возврат Хаб.Поднять(Описание.Префикс, Описание.Окружение, Описание.Сидер);
КонецФункции

// Проходит мастер /setup учёткой группы из ГруппыХабов.Мастер(): 201 — администратор заведён,
// 409 already_initialized — мастер уже пройден (соседом по группе); иной ответ — исключение с
// кодом и телом. Наборы группы зовут его в &ПередВсеми, и порядок наборов внутри фазы не важен.
//
// Параметры:
//  Хаб    - ЭкземплярХаба - работающий хаб группы.
//  Группа - Строка        - имя группы из ГруппыХабов («мастер»).
//
// Возвращаемое значение:
//  Структура - учётка мастера группы (Логин, Пароль).
//
Функция ПройтиМастер(Знач Хаб, Знач Группа) Экспорт

	Мастер = ГруппыХабов.Мастер(Группа);

	РеестрФикстур.Подключить("КлиентХаба");
	Клиент = Новый КлиентХаба(Хаб);
	Ответ = Клиент.ЗапросJSON("POST", "/setup",
		СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", Мастер.Логин, Мастер.Пароль));
	Если Ответ.КодСостояния = 201
		ИЛИ Ответ.КодСостояния = 409 И КодОтказа(Клиент, Ответ) = "already_initialized" Тогда
		Возврат Мастер;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Мастер /setup группы «%1» не прошёл учёткой %2: %3",
		Группа, Мастер.Логин, Клиент.КодИТело(Ответ));

КонецФункции

// Код отказа из тела {"error":{"code":…}}; тело не JSON или без кода — пустая строка.
Функция КодОтказа(Знач Клиент, Знач Ответ)

	Попытка
		Возврат Строка(Клиент.ТелоJSON(Ответ).Получить("error").Получить("code"));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции
