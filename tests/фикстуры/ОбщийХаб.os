// Хаб группы живых наборов: внешний, поднятый scripts/тесты.sh на весь прогон, либо свой,
// поднятый по описанию группы из ГруппыХабов, когда набор запущен поодиночке.

// Хаб группы для набора. Задана переменная OSHUB_TEST_HUB_<ИДЕНТИФИКАТОР> — экземпляр подключается
// к внешнему хабу и Остановить() его не гасит; не ответивший /health за 15 с внешний хаб — исключение.
// Не задана — поднимает свой хаб группы.
//
// Параметры:
//  Группа - Строка - имя группы из ГруппыХабов («витрина»).
//
// Возвращаемое значение:
//  ЭкземплярХаба - работающий хаб группы.
//
Функция Экземпляр(Знач Группа) Экспорт

	Описание = ГруппыХабов.Описание(Группа);

	РеестрФикстур.Подключить("ЭкземплярХаба");
	Хаб = Новый ЭкземплярХаба(90);

	Переменная = ГруппыХабов.ПеременнаяАдреса(Описание.Имя);
	Адрес = ПолучитьПеременнуюСреды(Переменная);
	Если ЗначениеЗаполнено(Адрес) Тогда
		Журнал = ПолучитьПеременнуюСреды(ГруппыХабов.ПеременнаяЖурнала(Описание.Имя));
		Хаб.ПодключитьсяКВнешнему(Адрес, ?(ЗначениеЗаполнено(Журнал), Журнал, ""),
			СтрШаблон("общий хаб группы «%1» (%2)", Описание.Имя, Переменная));
		Попытка
			Хаб.Дождаться(15);
		Исключение
			ВызватьИсключение СтрШаблон("Общий хаб группы «%1» на %2 не отвечает на /health 15 с (адрес из %3): %4",
				Описание.Имя, Адрес, Переменная, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Возврат Хаб;
	КонецЕсли;

	Поднять(Хаб, Описание);

	Возврат Хаб;

КонецФункции

// Поднимает хаб по описанию группы: временный каталог с префиксом группы, её окружение и сидер.
//
// Параметры:
//  Хаб      - ЭкземплярХаба - ещё не запущенный экземпляр.
//  Описание - Структура     - описание группы из ГруппыХабов.Описание().
//
// Возвращаемое значение:
//  Строка - корень временного каталога хаба.
//
Функция Поднять(Знач Хаб, Знач Описание) Экспорт
	Возврат Хаб.Поднять(Описание.Префикс, Описание.Окружение, Описание.Сидер);
КонецФункции
