// Заглушка ответа winow для контроллеров входа: редирект, куки, статус, тип и тело.
// Куки приходят отдельным объектом, чтобы фикстуры не зависели друг от друга по типу.

Перем Куки Экспорт;           // КукиОтветаЗаглушка
Перем Заголовки Экспорт;      // Соответствие
Перем БылРедирект Экспорт;    // Булево
Перем ПутьРедиректа Экспорт;  // Строка
Перем Состояние Экспорт;      // Число
Перем ТипКонтента Экспорт;    // Строка
Перем ТелоТекст Экспорт;      // Строка

// Фиксирует редирект: был ли он и куда.
//
// Параметры:
//  Путь - Строка - адрес перенаправления.
//
Процедура Перенаправить(Знач Путь) Экспорт
	БылРедирект = Истина;
	ПутьРедиректа = Строка(Путь);
КонецПроцедуры

// Запоминает код состояния ответа.
//
// Параметры:
//  Код - Число - код состояния HTTP.
//
Процедура УстановитьСостояние(Знач Код) Экспорт
	Состояние = Код;
КонецПроцедуры

// Запоминает тип контента ответа.
//
// Параметры:
//  Тип - Строка - тип контента.
//
Процедура УстановитьТипКонтента(Знач Тип) Экспорт
	ТипКонтента = Строка(Тип);
КонецПроцедуры

// Конструктор.
//
// Параметры:
//  КукиОтвета - КукиОтветаЗаглушка - коллекция кук, в которую пишет контроллер.
//
Процедура ПриСозданииОбъекта(Знач КукиОтвета) Экспорт

	Куки = КукиОтвета;
	Заголовки = Новый Соответствие();
	БылРедирект = Ложь;
	ПутьРедиректа = "";
	Состояние = 0;
	ТипКонтента = "";
	ТелоТекст = "";

КонецПроцедуры
