// Хранилище-заглушка с единственным методом, который спрашивает ИмяОбъектаАудита.

Перем ПоИдентификатору;

// Кладёт сущность в хранилище.
//
// Параметры:
//  Сущность - ФейкСущностьАудита - носитель полей Идентификатор/Имя/Логин.
//
Процедура Добавить(Знач Сущность) Экспорт
	ПоИдентификатору.Вставить(Цел(Сущность.Идентификатор), Сущность);
КонецПроцедуры

// Сущность по идентификатору.
//
// Параметры:
//  Идентификатор - Число - искомый идентификатор.
//
// Возвращаемое значение:
//  ФейкСущностьАудита, Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат ПоИдентификатору.Получить(Цел(Идентификатор));
КонецФункции

Процедура ПриСозданииОбъекта()
	ПоИдентификатору = Новый Соответствие();
КонецПроцедуры
