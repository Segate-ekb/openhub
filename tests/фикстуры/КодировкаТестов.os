// base64url для наборов: собрать компактный JWT и прочитать его нагрузку. Внутренние
// модули библиотек тесты не читают — у наборов свой инструмент.

// Кодирует строку UTF-8 в base64url без дополнения.
//
// Параметры:
//  Значение - Строка - исходная строка.
//
// Возвращаемое значение:
//  Строка.
//
Функция Закодировать(Знач Значение) Экспорт

	Данные = ПолучитьДвоичныеДанныеИзСтроки(Строка(Значение), "UTF-8", Ложь);
	Текст = СтрЗаменить(СтрЗаменить(Base64Строка(Данные), Символы.ВК, ""), Символы.ПС, "");
	Текст = СтрЗаменить(СтрЗаменить(Текст, "+", "-"), "/", "_");
	Возврат СтрЗаменить(Текст, "=", "");

КонецФункции

// Читает строку из base64url; дополнение восстанавливается.
//
// Параметры:
//  Значение - Строка - сегмент base64url.
//
// Возвращаемое значение:
//  Строка.
//
Функция Раскодировать(Знач Значение) Экспорт

	Текст = СтрЗаменить(СтрЗаменить(СокрЛП(Строка(Значение)), "-", "+"), "_", "/");
	Остаток = СтрДлина(Текст) % 4;
	Если Остаток > 0 Тогда
		Текст = Текст + Лев("===", 4 - Остаток);
	КонецЕсли;
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(Текст), "UTF-8");

КонецФункции

// Полезная нагрузка компактного JWS как Соответствие. Подпись не проверяется — набору
// нужны клеймы, а не доверие к ним.
//
// Параметры:
//  Токен - Строка - компактный JWS из трёх сегментов.
//
// Возвращаемое значение:
//  Соответствие.
//
Функция НагрузкаJWT(Знач Токен) Экспорт

	Части = СтрРазделить(СокрЛП(Строка(Токен)), ".", Истина);
	Если Части.Количество() < 2 Тогда
		ВызватьИсключение "КодировкаТестов: это не компактный JWT";
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Раскодировать(Части[1]));
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		ВызватьИсключение "КодировкаТестов: нагрузка JWT — не объект";
	КонецЕсли;
	Возврат Результат;

КонецФункции

Процедура ПриСозданииОбъекта()
КонецПроцедуры
