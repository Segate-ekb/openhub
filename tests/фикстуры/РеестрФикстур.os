// Регистрация фикстур в системе типов процесса: файл ищется по имени во всех каталогах
// «фикстуры» дерева тестов — общем и модульных, — повторная регистрация молчит.

Перем КаталогФикстур;
Перем КаталогТестов;
Перем Указатель; // Соответствие: имя фикстуры -> Массив путей; строится при первом обращении

// Регистрирует фикстуру под её именем, если такого типа в процессе ещё нет.
//
// Параметры:
//  Имя - Строка - имя фикстуры без расширения.
//
// Возвращаемое значение:
//  Булево - Истина, если тип зарегистрирован этим вызовом; Ложь, если тип с таким именем
//           в процессе уже был — чей бы он ни был.
//
Функция Подключить(Знач Имя) Экспорт

	Если ТипЗарегистрирован(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПодключитьСценарий(Путь(Имя), Имя);

	Возврат Истина;

КонецФункции

// Полный путь к файлу фикстуры. Фикстуры нет или она лежит в двух каталогах сразу —
// исключение: имена типов глобальны на процесс, и второй файл с тем же именем не подключится.
//
// Параметры:
//  Имя - Строка - имя фикстуры без расширения.
//
// Возвращаемое значение:
//  Строка - полное имя файла.
//
Функция Путь(Знач Имя) Экспорт

	Найденные = НайденныеФайлы(Имя);
	Если Найденные.Количество() = 0 Тогда
		Указатель = Неопределено; // фикстура могла появиться после первого обращения
		Найденные = НайденныеФайлы(Имя);
	КонецЕсли;

	Если Найденные.Количество() = 1 Тогда
		Возврат Найденные[0];
	КонецЕсли;

	Если Найденные.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон("Фикстура %1 не найдена ни в одном каталоге «фикстуры» под %2.",
			Имя, КаталогТестов);
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Фикстура %1 лежит в %2 каталогах фикстур, а имя типа одно на процесс:%3%4",
		Имя, Найденные.Количество(), Символы.ПС, СтрСоединить(Найденные, Символы.ПС));

КонецФункции

// Общий каталог фикстур — тот, где лежит сам реестр.
//
// Возвращаемое значение:
//  Строка - полный путь каталога.
//
Функция Каталог() Экспорт
	Возврат КаталогФикстур;
КонецФункции

Функция НайденныеФайлы(Знач Имя)

	Если Указатель = Неопределено Тогда
		Указатель = ПостроитьУказатель();
	КонецЕсли;

	Найденные = Указатель.Получить(Имя);
	Возврат ?(Найденные = Неопределено, Новый Массив(), Найденные);

КонецФункции

// Фикстура — файл, лежащий прямо в каталоге «фикстуры»; вложенные каталоги (приложения
// фейкового IdP, коллектора) держат свои классы, а не фикстуры.
Функция ПостроитьУказатель()

	Результат = Новый Соответствие();

	Для Каждого Каталог Из НайтиФайлы(КаталогТестов, "фикстуры", Истина) Цикл
		Если НЕ Каталог.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Файл Из НайтиФайлы(Каталог.ПолноеИмя, "*.os", Ложь) Цикл
			Пути = Результат.Получить(Файл.ИмяБезРасширения);
			Если Пути = Неопределено Тогда
				Пути = Новый Массив();
				Результат.Вставить(Файл.ИмяБезРасширения, Пути);
			КонецЕсли;
			Пути.Добавить(Файл.ПолноеИмя);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Глобальный ТипЗарегистрирован() в модуле библиотеки недоступен («Symbol not found»),
// поэтому проба типом.
Функция ТипЗарегистрирован(Знач Имя)
	Попытка
		Проба = Тип(Имя);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

КаталогФикстур = Новый Файл(ТекущийСценарий().Источник).Путь;
КаталогТестов = Новый Файл(ОбъединитьПути(КаталогФикстур, "..")).ПолноеИмя;
