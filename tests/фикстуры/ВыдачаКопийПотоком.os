// Обработчик фонового задания для сторожа параллельной выдачи: по кругу берёт пачку
// временных копий артефакта и освобождает её, запоминая первую жалобу и все выданные пути.
// Своего утверждения не делает — судит набор.

Перем Хранилище;    // ХранилищеАртефактов
Перем Координаты_;  // КоординатыАртефакта
Перем Кругов;       // Число
Перем Пачка;        // Число - сколько копий поток держит одновременно
Перем Выданные_;    // Массив из Строка - все пути, которые выдало хранилище
Перем Жалоба_;      // Строка - первая жалоба; "" — поток отработал чисто

// Жалоба потока: текст сбоя; пустая строка — выдача шла без исключений.
//
// Возвращаемое значение:
//  Строка.
//
Функция Жалоба() Экспорт
	Возврат Жалоба_;
КонецФункции

// Все пути временных копий, которые поток получил от хранилища.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Выданные() Экспорт
	Возврат Выданные_;
КонецФункции

// Контракт обработчика фонового задания.
Процедура Исполнить() Экспорт

	Попытка
		ВыдаватьКруги();
	Исключение
		Пожаловаться("выдача копий упала: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура ВыдаватьКруги()

	Для Круг = 1 По Кругов Цикл

		Держит = Новый Массив();
		Для Н = 1 По Пачка Цикл
			Путь = Хранилище.Получить(Координаты_);
			Выданные_.Добавить(Путь);
			Держит.Добавить(Путь);
		КонецЦикла;

		Для Каждого Путь Из Держит Цикл
			Хранилище.ОсвободитьВыдачу(Путь);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

Процедура Пожаловаться(Знач Текст)
	Если НЕ ЗначениеЗаполнено(Жалоба_) Тогда
		Жалоба_ = Текст;
	КонецЕсли;
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач ХранилищеАртефактов, Знач Координаты, Знач ЧислоКругов,
	Знач КопийВПачке)

	Хранилище = ХранилищеАртефактов;
	Координаты_ = Координаты;
	Кругов = ЧислоКругов;
	Пачка = КопийВПачке;
	Выданные_ = Новый Массив();
	Жалоба_ = "";

КонецПроцедуры
