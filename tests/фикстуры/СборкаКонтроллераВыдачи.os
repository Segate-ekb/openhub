// Сборка КонтроллераВыдачиAPI для offline-наборов: части называются именами, а не позициями.
// Правка конструктора контроллера видна здесь одним местом и не съезжает по набору молча.

Перем Резолвер Экспорт;        // РезолверВыдачи либо его фейк
Перем РезолверФайла Экспорт;   // РезолверФайлаПакета
Перем Куки Экспорт;            // пустая коллекция кук ответа
Перем Издатель Экспорт;        // ИздательСобытий; Неопределено — ветка сбоя до него не доходит
Перем Телеметрия Экспорт;      // Неопределено — спан не заводится
Перем ЧтениеПула Экспорт;      // ГвардДоступаКПулу либо его заглушка
Перем СервисПулов Экспорт;     // нужен только вечным алиасам
Перем Кэш Экспорт;             // ЗаголовкиКэша
Перем Права Экспорт;           // СервисПрав; нужен только успешной выдаче
Перем Лог Экспорт;             // инъекция &Лог до созданного напрямую класса не доезжает
Перем Ошибки Экспорт;          // ТекстОшибки

// Собирает контроллер из заданных частей.
//
// Возвращаемое значение:
//  КонтроллерВыдачиAPI - готовый к вызову точек маршрута.
//
Функция Собрать() Экспорт

	Возврат Новый КонтроллерВыдачиAPI(Резолвер, РезолверФайла, Куки, Издатель, Телеметрия,
		ЧтениеПула, СервисПулов, Кэш, Права, Лог, Ошибки);

КонецФункции

// Параметры:
//  ЛогНабора - Лог - лог, под которым читается журнал выдачи.
//
Процедура ПриСозданииОбъекта(Знач ЛогНабора)

	Резолвер = Неопределено;
	РезолверФайла = Новый РезолверФайлаПакета();
	Куки = Новый КукиЗаглушка();
	Издатель = Неопределено;
	Телеметрия = Неопределено;
	ЧтениеПула = Новый ДопускКПулуЗаглушка();
	СервисПулов = Неопределено;
	Кэш = Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP());
	Права = Неопределено;
	Лог = ЛогНабора;
	Ошибки = Новый ТекстОшибки();

КонецПроцедуры
