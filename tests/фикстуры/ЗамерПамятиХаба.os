// Память процесса поднятого хаба по ps: RSS сейчас и пик по ходу передачи — опросом без пауз
// в отдельном sh до файла-стопа. ps есть и на macOS, и на Linux раннера.

Перем Хаб;       // ЭкземплярХаба - чей процесс меряется
Перем Каталог;   // Строка - каталог скриптов и итогов опроса

// Resident set процесса хаба сейчас.
//
// Возвращаемое значение:
//  Число - RSS, байты.
//
Функция Текущая() Экспорт

	Процесс = СоздатьПроцесс(СтрШаблон("ps -o rss= -p %1", ИдентификаторХаба()), , Истина);
	Процесс.Запустить();
	Процесс.ОжидатьЗавершения();
	Вывод = СокрЛП(Процесс.ПотокВывода.Прочитать());
	Если НЕ ЗначениеЗаполнено(Вывод) Тогда
		ВызватьИсключение СтрШаблон("ps не назвал RSS процесса хаба %1", ИдентификаторХаба());
	КонецЕсли;
	Возврат Число(Вывод) * 1024;

КонецФункции

// Запускает опрос RSS без пауз; первый опрос снят до возврата, поэтому передача, начатая
// после вызова, попадает в замер целиком.
//
// Возвращаемое значение:
//  Структура - замер для ИтогПика.
//
Функция НачатьПик() Экспорт

	КаталогЗамера = ОбъединитьПути(Каталог, Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КаталогЗамера);
	Замер = Новый Структура("Итог, Стоп, Процесс",
		ОбъединитьПути(КаталогЗамера, "peak"), ОбъединитьПути(КаталогЗамера, "stop"));
	Скрипт = ОбъединитьПути(КаталогЗамера, "peak.sh");

	Запись = Новый ЗаписьТекста(Скрипт, КодировкаТекста.UTF8NoBOM, , , Символы.ПС);
	Запись.ЗаписатьСтроку("max=0; n=0");
	Запись.ЗаписатьСтроку("while :; do");
	Запись.ЗаписатьСтроку("  r=$(ps -o rss= -p ""$1"" | tr -d ' ')");
	Запись.ЗаписатьСтроку("  [ -z ""$r"" ] && break");
	Запись.ЗаписатьСтроку("  n=$((n + 1)); [ ""$r"" -gt ""$max"" ] && max=$r");
	Запись.ЗаписатьСтроку("  echo ""$max $n"" > ""$2.part"" && mv ""$2.part"" ""$2""");
	Запись.ЗаписатьСтроку("  [ -e ""$3"" ] && break");
	Запись.ЗаписатьСтроку("done");
	Запись.Закрыть();

	Замер.Процесс = СоздатьПроцесс(СтрШаблон("sh %1 %2 %3 %4", Скрипт, ИдентификаторХаба(),
		Замер.Итог, Замер.Стоп), , Истина);
	Замер.Процесс.Запустить();

	Срок = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10000;
	Пока НЕ Новый Файл(Замер.Итог).Существует() И ТекущаяУниверсальнаяДатаВМиллисекундах() < Срок Цикл
		Приостановить(20);
	КонецЦикла;
	Если НЕ Новый Файл(Замер.Итог).Существует() Тогда
		ВызватьИсключение "Опрос RSS хаба не снял первого замера за 10 с";
	КонецЕсли;

	Возврат Замер;

КонецФункции

// Останавливает опрос.
//
// Параметры:
//  Замер - Структура - результат НачатьПик.
//
// Возвращаемое значение:
//  Структура - Пик (Число, наибольший RSS за замер, байты), Опросов (Число).
//
Функция ИтогПика(Знач Замер) Экспорт

	Запись = Новый ЗаписьТекста(Замер.Стоп);
	Запись.Закрыть();
	Замер.Процесс.ОжидатьЗавершения();

	Чтение = Новый ЧтениеТекста(Замер.Итог);
	Части = СтрРазделить(СокрЛП(Чтение.Прочитать()), " ");
	Чтение.Закрыть();

	Возврат Новый Структура("Пик, Опросов", Число(Части[0]) * 1024, Число(Части[1]));

КонецФункции

Функция ИдентификаторХаба()
	Возврат Формат(Хаб.ИдентификаторПроцесса(), "ЧГ=0");
КонецФункции

// Параметры:
//  ЭкземплярХаба - ЭкземплярХаба - поднятый хаб.
//  КаталогЗамеров - Строка - существующий каталог под скрипты опроса; убирает вызывающий.
//
Процедура ПриСозданииОбъекта(Знач ЭкземплярХаба, Знач КаталогЗамеров)
	Хаб = ЭкземплярХаба;
	Каталог = КаталогЗамеров;
КонецПроцедуры
