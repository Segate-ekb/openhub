// Форма смены темы на отданной странице глазами сервера: адрес формы из разметки и путь
// возврата, который придёт в контроллер темы, раскодированный так же, как его читает winow.

// Адрес формы смены темы, как его отправит браузер.
//
// Параметры:
//  Страница - Строка - разметка страницы.
//
// Возвращаемое значение:
//  Строка - значение action формы темы; "" — формы на странице нет.
//
Функция Адрес(Знач Страница) Экспорт

	Метка = "action=""/ui/theme";
	Начало = СтрНайти(Страница, Метка);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Страница, Начало + СтрДлина("action="""));
	Возврат СтрЗаменить(Лев(Хвост, СтрНайти(Хвост, """") - 1), "&amp;", "&");

КонецФункции

// Путь возврата, который форма темы несёт на сервер.
//
// Параметры:
//  Страница - Строка - разметка страницы.
//
// Возвращаемое значение:
//  Строка - путь возврата; "" — форма его не несёт.
//
Функция ПутьВозврата(Знач Страница) Экспорт

	Адрес = Адрес(Страница);
	Позиция = СтрНайти(Адрес, "?");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого Пара Из СтрРазделить(Сред(Адрес, Позиция + 1), "&", Ложь) Цикл
		Разделитель = СтрНайти(Пара, "=");
		Если Разделитель > 0 И Лев(Пара, Разделитель - 1) = "back" Тогда
			Возврат РаскодироватьСтроку(Сред(Пара, Разделитель + 1), СпособКодированияСтроки.КодировкаURL);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции
