// Фикстура: объявления предметов (ключи настроек, описания событий, коды происшествий) без
// контейнера — так, как их собрала бы ОСень: по &Порядок, с желудями и детальками.

Перем Классы;          // фикстура КлассыСлоя
Перем КореньМодулей;   // Строка — src/модули

#Область ПубличныйИнтерфейс

// Файлы классов, чьё имя начинается с префикса, во всех модулях.
//
// Параметры:
//  Префикс - Строка - начало имени файла («КлючиНастроек»).
//
// Возвращаемое значение:
//  Массив из Файл - файлы по имени; пустой выдачи не бывает — это исключение.
//
Функция Файлы(Знач Префикс) Экспорт

	Результат = Новый Массив();
	Для Каждого Файл Из НайтиФайлы(КореньМодулей, Префикс + "*.os", Истина) Цикл
		Если Файл.ЭтоФайл() Тогда
			Результат.Добавить(Файл);
		КонецЕсли;
	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон("В %1 нет ни одного класса с именем на «%2»: скан ослеп",
			КореньМодулей, Префикс);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Подключает классы, чьё имя начинается с префикса, во всех модулях. Идемпотентно.
//
// Параметры:
//  Префикс - Строка - начало имени файла.
//
Процедура Подключить(Знач Префикс) Экспорт
	Для Каждого Файл Из Файлы(Префикс) Цикл
		Классы.ПодключитьФайл(Файл.ПолноеИмя);
	КонецЦикла;
КонецПроцедуры

// Все объявления прозвища из подключённых классов с префиксом, по &Порядок.
//
// Параметры:
//  Прозвище - Строка - прозвище, под которым реестр собирает объявления.
//  Префикс - Строка - начало имени файлов, среди которых искать.
//  Желуди - Соответствие, Неопределено - имя желудя → объект для &Пластилин; не названный
//           здесь желудь создаётся Новым по имени (необязательный).
//  Детальки - Соответствие, Неопределено - ключ → сырое значение для &Деталька; не
//             названная деталька получает ЗначениеПоУмолчанию аннотации (необязательный).
//
// Возвращаемое значение:
//  Массив - объекты объявлений в порядке, в котором их отдала бы ОСень.
//
Функция Собрать(Знач Прозвище, Знач Префикс, Знач Желуди = Неопределено,
	Знач Детальки = Неопределено) Экспорт

	Подключить(Префикс);

	Найденные = Новый ТаблицаЗначений();
	Найденные.Колонки.Добавить("Порядок");
	Найденные.Колонки.Добавить("Имя");
	Найденные.Колонки.Добавить("Конструктор");

	Для Каждого Файл Из Файлы(Префикс) Цикл
		Конструктор = Конструктор(Файл.ИмяБезРасширения);
		Если НЕ ЭтоЖелудьПрозвища(Конструктор, Прозвище) Тогда
			Продолжить;
		КонецЕсли;
		Строка_ = Найденные.Добавить();
		Строка_.Порядок = ЧислоИлиНоль(ЗначениеАннотации(Конструктор.Аннотации, "Порядок"));
		Строка_.Имя = Файл.ИмяБезРасширения;
		Строка_.Конструктор = Конструктор;
	КонецЦикла;

	Найденные.Сортировать("Порядок, Имя");

	Результат = Новый Массив();
	Для Каждого Строка_ Из Найденные Цикл
		Результат.Добавить(Новый(Строка_.Имя, Аргументы(Строка_.Конструктор, Желуди, Детальки)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Конструктор(Знач ИмяКласса)

	Рефлектор = Новый Рефлектор();
	Для Каждого Метод Из Рефлектор.ПолучитьТаблицуМетодов(Тип(ИмяКласса)) Цикл
		Если Метод.Имя = "ПриСозданииОбъекта" Тогда
			Возврат Метод;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Объявление — желудь под нужным прозвищем: класс без &Желудь ОСень в коллекцию не берёт.
Функция ЭтоЖелудьПрозвища(Знач Конструктор, Знач Прозвище)
	Возврат Конструктор <> Неопределено
		И АннотацияПоИмени(Конструктор.Аннотации, "Желудь") <> Неопределено
		И ЗначениеАннотации(Конструктор.Аннотации, "Прозвище") = Прозвище;
КонецФункции

Функция Аргументы(Знач Конструктор, Знач Желуди, Знач Детальки)

	Результат = Новый Массив();
	Для Каждого Параметр Из Конструктор.Параметры Цикл
		Результат.Добавить(Аргумент(Параметр, Желуди, Детальки));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Аргумент(Знач Параметр, Знач Желуди, Знач Детальки)

	Пластилин = АннотацияПоИмени(Параметр.Аннотации, "Пластилин");
	Если Пластилин <> Неопределено Тогда
		Имя = ПараметрАннотации(Пластилин, "Значение");
		Если Желуди <> Неопределено И Желуди.Получить(Имя) <> Неопределено Тогда
			Возврат Желуди.Получить(Имя);
		КонецЕсли;
		Возврат Новый(Имя);
	КонецЕсли;

	Деталька = АннотацияПоИмени(Параметр.Аннотации, "Деталька");
	Если Деталька <> Неопределено Тогда
		Ключ = ПараметрАннотации(Деталька, "Значение");
		Если Детальки <> Неопределено И Детальки.Получить(Ключ) <> Неопределено Тогда
			Возврат Детальки.Получить(Ключ);
		КонецЕсли;
		Умолчание = ПараметрАннотации(Деталька, "ЗначениеПоУмолчанию");
		Возврат ?(Умолчание = Неопределено, "", Умолчание);
	КонецЕсли;

	ВызватьИсключение СтрШаблон("ОбъявленияПредметов: параметр %1 без &Пластилин и &Деталька — чем его наполнить, фикстура не знает",
		Параметр.Имя);

КонецФункции

Функция АннотацияПоИмени(Знач Аннотации, Знач Имя)

	Если Аннотации = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Аннотация Из Аннотации Цикл
		Если НРег(Аннотация.Имя) = НРег(Имя) Тогда
			Возврат Аннотация;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Значение аннотации: именованный параметр «Значение» либо первый безымянный.
Функция ЗначениеАннотации(Знач Аннотации, Знач Имя)

	Аннотация = АннотацияПоИмени(Аннотации, Имя);
	Если Аннотация = Неопределено ИЛИ Аннотация.Параметры.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Аннотация.Параметры[0].Значение;

КонецФункции

Функция ПараметрАннотации(Знач Аннотация, Знач Имя)

	Для Каждого Параметр Из Аннотация.Параметры Цикл
		Если НРег(Строка(Параметр.Имя)) = НРег(Имя) Тогда
			Возврат Параметр.Значение;
		КонецЕсли;
	КонецЦикла;
	// &Пластилин("Имя") — безымянный первый параметр и есть значение
	Если НРег(Имя) = "значение" И Аннотация.Параметры.Количество() > 0
		И НЕ ЗначениеЗаполнено(Аннотация.Параметры[0].Имя) Тогда
		Возврат Аннотация.Параметры[0].Значение;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ЧислоИлиНоль(Знач Значение)
	Если Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Число(Значение);
КонецФункции

#КонецОбласти

// Параметры:
//  ПоискКлассов - КлассыСлоя - через него файлы попадают в процесс.
//  КаталогМодулей - Строка - корень src/модули.
//
Процедура ПриСозданииОбъекта(Знач ПоискКлассов, Знач КаталогМодулей)
	Классы = ПоискКлассов;
	КореньМодулей = КаталогМодулей;
КонецПроцедуры
