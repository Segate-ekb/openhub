// ХранилищеПроисхожденияВерсий в памяти, считающее ОБРАЩЕНИЯ и ПРОЧИТАННЫЕ СТРОКИ.
// Провенанс страница спрашивала четырьмя разными вопросами плюс по разу на строку версий —
// счётчик обращений показывает и то и другое.

Перем Записи;      // Массив из Структура — строки провенанса
Перем СчётСтрок;
Перем СчётЗапросов;

#Область Счётчики

// Сколько строк провенанса хранилище отдало с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Строк() Экспорт
	Возврат СчётСтрок;
КонецФункции

// Сколько запросов к хранилищу ушло с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Запросов() Экспорт
	Возврат СчётЗапросов;
КонецФункции

// Обнуляет счётчики, оставляя фактуру.
Процедура Обнулить() Экспорт
	СчётСтрок = 0;
	СчётЗапросов = 0;
КонецПроцедуры

#КонецОбласти

#Область НаполнениеФикстуры

// Заводит запись провенанса (за обращение не считается).
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  ВерсияИдентификатор - Число - идентификатор версии.
//  Источник - Строка - «свой» либо «апстрим».
//  ДовереннаяПубликация - Булево - признак доверенного конвейера.
//
Процедура Добавить(Знач ПакетИдентификатор, Знач ВерсияИдентификатор, Знач Источник,
	Знач ДовереннаяПубликация = Ложь) Экспорт

	Записи.Добавить(Новый Структура(
		"Идентификатор, ПакетИдентификатор, ВерсияИдентификатор, Источник, ДовереннаяПубликация",
		Записи.Количество() + 1, Цел(ПакетИдентификатор), Цел(ВерсияИдентификатор),
		Источник, ДовереннаяПубликация));

КонецПроцедуры

#КонецОбласти

#Область КонтрактХранилища

// Провенанс конкретной версии.
//
// Параметры:
//  ВерсияИдентификатор - Число - идентификатор версии.
//
// Возвращаемое значение:
//  Структура, Неопределено - запись провенанса.
//
Функция ПолучитьОдноПоВерсияИдентификаторРавно(Знач ВерсияИдентификатор) Экспорт

	СчётЗапросов = СчётЗапросов + 1;
	Для Каждого Строка_ Из Записи Цикл
		Если Строка_.ВерсияИдентификатор = Цел(ВерсияИдентификатор) Тогда
			СчётСтрок = СчётСтрок + 1;
			Возврат Строка_;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Провенанс всех версий пакета.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив - записи провенанса пакета.
//
Функция ПолучитьПоПакетИдентификаторРавно(Знач ПакетИдентификатор) Экспорт

	Список = Новый Массив();
	Список.Добавить(Цел(ПакетИдентификатор));
	Возврат Отдать(ПоПакетам(Список));

КонецФункции

// Провенанс версий перечисленных пакетов.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Массив - записи провенанса.
//
Функция ПровенансПакетов(Знач ПакетИдентификаторы) Экспорт
	Возврат Отдать(ПоПакетам(ПакетИдентификаторы));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПоПакетам(Знач ПакетИдентификаторы)

	Нужные = Новый Соответствие();
	Для Каждого Номер Из ПакетИдентификаторы Цикл
		Нужные.Вставить(Цел(Номер), Истина);
	КонецЦикла;

	Отобранные = Новый Массив();
	Для Каждого Строка_ Из Записи Цикл
		Если Нужные.Получить(Строка_.ПакетИдентификатор) = Истина Тогда
			Отобранные.Добавить(Строка_);
		КонецЕсли;
	КонецЦикла;
	Возврат Отобранные;

КонецФункции

Функция Отдать(Знач Строки)

	СчётЗапросов = СчётЗапросов + 1;
	СчётСтрок = СчётСтрок + Строки.Количество();
	Возврат Строки;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	СчётСтрок = 0;
	СчётЗапросов = 0;
КонецПроцедуры
