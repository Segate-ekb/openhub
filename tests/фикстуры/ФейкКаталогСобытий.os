// Фейковый КаталогСобытий для тестов витрины подписок: подпись типа и обход перечня.

Перем Записи_;

// Запись каталога по типу события.
//
// Параметры:
//  Тип - Строка - тип события.
//
// Возвращаемое значение:
//  Структура - запись каталога либо Неопределено, если типа нет.
//
Функция Запись(Знач Тип) Экспорт

	Для Каждого Элемент Из Записи_ Цикл
		Если Элемент.Тип = Тип Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Описание параметра подписки для типа события.
//
// Параметры:
//  Тип - Строка - тип события.
//
// Возвращаемое значение:
//  Структура, Неопределено - Имя, Минимум, Максимум, ПоУмолчанию.
//
Функция ПараметрПодписки(Знач Тип) Экспорт
	Элемент = Запись(Тип);
	Возврат ?(Элемент = Неопределено, Неопределено, Элемент.Параметр);
КонецФункции

// Весь перечень записей каталога.
//
// Возвращаемое значение:
//  Массив из Структура.
//
Функция Все() Экспорт
	Возврат Записи_;
КонецФункции

Процедура ПриСозданииОбъекта()

	Записи_ = Новый Массив();
	Записи_.Добавить(Новый Структура("Тип, Подпись, Пояснение, ДляПодписки, ПочемуВнутреннее, Параметр",
		"package.version.published", "Версия опубликована",
		"В пул принята новая версия пакета.", Истина, "", Неопределено));
	Записи_.Добавить(Новый Структура("Тип, Подпись, Пояснение, ДляПодписки, ПочемуВнутреннее, Параметр",
		"hub.internal.audit", "Внутреннее событие",
		"Служебная запись аудита.", Ложь, "Не покидает хаб.", Неопределено));
	// событие с параметром: витрина обязана нарисовать рядом с флажком числовое поле
	Записи_.Добавить(Новый Структура("Тип, Подпись, Пояснение, ДляПодписки, ПочемуВнутреннее, Параметр",
		"pool.storage.filled", "Пул заполняется",
		"Занятый объём достиг заданного процента квоты.", Истина, "",
		Новый Структура("Имя, Минимум, Максимум, ПоУмолчанию", "порог", 1, 100, 80)));

КонецПроцедуры
