// Счётчик обращений к фейку-хранилищу: сколько раз спросили, сколько строк отдали
// и сколько ушло в каждую названную дверь. Одна идиома на все считающие фикстуры:
// сторожа N+1 отличаются фактурой хранилища, а счёт у них один и тот же.

Перем ВсегоОбращений;
Перем ВсегоСтрок;
Перем СчётДверей;   // Соответствие: имя двери -> число обращений

// Отмечает обращение к хранилищу.
//
// Параметры:
//  Дверь - Строка - имя двери, если набор считает двери по отдельности
//          (необязательный, по умолчанию "" — идёт только общий счёт).
//
Процедура Отметить(Знач Дверь = "") Экспорт

	ВсегоОбращений = ВсегоОбращений + 1;

	Если ЗначениеЗаполнено(Дверь) Тогда
		СчётДверей.Вставить(Дверь, ОбращенийВ(Дверь) + 1);
	КонецЕсли;

КонецПроцедуры

// Отмечает обращение и объём выдачи разом: сторожу N+1 важно и число запросов,
// и число прочитанных строк. Возвращает те же строки, чтобы отметка ставилась
// прямо в Возврат фикстуры.
//
// Параметры:
//  Строки - Массив - то, что хранилище отдаёт вызывающему.
//  Дверь - Строка - имя двери (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Массив - те же строки.
//
Функция Отдать(Знач Строки, Знач Дверь = "") Экспорт

	Отметить(Дверь);
	ВсегоСтрок = ВсегоСтрок + Строки.Количество();

	Возврат Строки;

КонецФункции

// Отмечает обращение, отдавшее одну строку либо ничего.
//
// Параметры:
//  Строка_ - Произвольный - найденная строка либо Неопределено.
//  Дверь - Строка - имя двери (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Произвольный - та же строка.
//
Функция ОтдатьОдну(Знач Строка_, Знач Дверь = "") Экспорт

	Отметить(Дверь);
	Если Строка_ <> Неопределено Тогда
		ВсегоСтрок = ВсегоСтрок + 1;
	КонецЕсли;

	Возврат Строка_;

КонецФункции

// Сколько раз хранилище спросили с момента создания либо последнего обнуления.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат ВсегоОбращений;
КонецФункции

// Сколько строк хранилище отдало с момента создания либо последнего обнуления.
//
// Возвращаемое значение:
//  Число.
//
Функция Строк() Экспорт
	Возврат ВсегоСтрок;
КонецФункции

// Сколько обращений ушло в названную дверь.
//
// Параметры:
//  Дверь - Строка - имя двери.
//
// Возвращаемое значение:
//  Число - ноль, если в эту дверь не заходили ни разу.
//
Функция ОбращенийВ(Знач Дверь) Экспорт

	Сколько = СчётДверей.Получить(Дверь);

	Возврат ?(Сколько = Неопределено, 0, Сколько);

КонецФункции

// Счёт по названным дверям структурой — так его читает набор, сверяющий несколько дверей.
//
// Параметры:
//  Имена - Строка - имена дверей через запятую.
//
// Возвращаемое значение:
//  Структура - имя двери -> число обращений.
//
Функция ПоДверям(Знач Имена) Экспорт

	Результат = Новый Структура();
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Дверь = СокрЛП(Имя);
		Если ЗначениеЗаполнено(Дверь) Тогда
			Результат.Вставить(Дверь, ОбращенийВ(Дверь));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Обнуляет счёт, оставляя фактуру хранилища нетронутой.
Процедура Обнулить() Экспорт

	ВсегоОбращений = 0;
	ВсегоСтрок = 0;
	СчётДверей = Новый Соответствие();

КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Обнулить();
КонецПроцедуры
