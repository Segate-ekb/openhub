// Фейк СервисаПрав: без набора действий админ вправе всё, остальные — ничего; с набором — показывает,
// какое право требует служба. Области изменения, пулы в распоряжении и счёт снимков задаются отдельно.

Перем Разрешённые;   // Соответствие: действие -> Истина; пусто — решает признак Админ
Перем Области;       // Структура ВесьХаб, Пулы, Пакеты из ЗадатьОбласти; Неопределено — решает признак Админ
Перем ПулыВРаспоряжении; // Соответствие: идентификатор пула -> Истина; пусто — прежнее правило МожетАдминистрировать
Перем СчётСнимков;   // Булево — СчитатьСнимки включил счёт снимков прав
Перем СнимковСнято Экспорт; // Число — снимков прав, снятых явно или вопросом без снимка

// Разрешено ли действие над объектом.
//
// Параметры:
//  Пользователь - Структура, Неопределено - субъект; Неопределено — аноним, всегда отказ.
//  Действие     - Строка - действие модели прав; без набора действий не различается.
//  Объект       - Структура - описание объекта; фейком не учитывается.
//
// Возвращаемое значение:
//  Булево - разрешено ли действие.
//
Функция РазрешеноДействие(Знач Пользователь, Знач Действие, Знач Объект) Экспорт

	Объект = Объект;

	Если Пользователь = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Разрешённые.Количество() = 0 Тогда
		Возврат ПользовательАдмин(Пользователь);
	КонецЕсли;

	Возврат Разрешённые.Получить(НРег(СокрЛП(Строка(Действие)))) = Истина;

КонецФункции

// Нормализованное описание объекта действия.
//
// Параметры:
//  ТипОбъекта       - Строка - тип объекта: хаб, пул, пакет.
//  Идентификатор    - Число  - идентификатор объекта.
//  ПулИдентификатор - Число  - идентификатор пула (необязательный, по умолчанию 0).
//
// Возвращаемое значение:
//  Структура - ТипОбъекта, Идентификатор, ПулИдентификатор.
//
Функция ОписаниеОбъекта(Знач ТипОбъекта, Знач Идентификатор, Знач ПулИдентификатор = 0) Экспорт
	Возврат Новый Структура("ТипОбъекта, Идентификатор, ПулИдентификатор",
		НРег(СокрЛП(Строка(ТипОбъекта))), Цел(Идентификатор), Цел(ПулИдентификатор));
КонецФункции

// Описание объекта «хаб».
//
// Возвращаемое значение:
//  Структура - ТипОбъекта, Идентификатор, ПулИдентификатор.
//
Функция ОбъектХаб() Экспорт
	Возврат ОписаниеОбъекта("хаб", 0, 0);
КонецФункции

// Описание объекта «пул».
//
// Параметры:
//  Пул - Произвольный - пул с полем Идентификатор.
//
// Возвращаемое значение:
//  Структура - ТипОбъекта, Идентификатор, ПулИдентификатор.
//
Функция ОбъектПул(Знач Пул) Экспорт
	Возврат ОписаниеОбъекта("пул", Пул.Идентификатор, Пул.Идентификатор);
КонецФункции

// Описание объекта «пакет».
//
// Параметры:
//  Пакет - Произвольный - пакет с полями Идентификатор и ПулИдентификатор.
//
// Возвращаемое значение:
//  Структура - ТипОбъекта, Идентификатор, ПулИдентификатор.
//
Функция ОбъектПакет(Знач Пакет) Экспорт
	Возврат ОписаниеОбъекта("пакет", Пакет.Идентификатор, Пакет.ПулИдентификатор);
КонецФункции

// Может ли пользователь администрировать пул: без набора действий — признак Админ,
// с набором — право «удаление» на пуле.
//
// Параметры:
//  Пользователь - Структура, Неопределено - субъект.
//  Пул          - Произвольный - пул.
//  Снимок       - Неопределено - снимок прав, фейком не используется (необязательный).
//
// Возвращаемое значение:
//  Булево - может ли администрировать.
//
Функция МожетАдминистрировать(Знач Пользователь, Знач Пул, Знач Снимок = Неопределено) Экспорт

	УчестьСнимок(Снимок);
	Если ПулыВРаспоряжении.Количество() > 0 Тогда
		Возврат Пользователь <> Неопределено И ПулыВРаспоряжении.Получить(Цел(Пул.Идентификатор)) = Истина;
	КонецЕсли;

	Если Разрешённые.Количество() = 0 Тогда
		Пул = Пул;
		Возврат ПользовательАдмин(Пользователь);
	КонецЕсли;

	Возврат РазрешеноДействие(Пользователь, "удаление", ОбъектПул(Пул));

КонецФункции

// Снимок прав субъекта: без счёта снимков запоминать нечего, со счётом — отметка снятого снимка.
//
// Параметры:
//  Пользователь - Структура, Неопределено - субъект.
//
// Возвращаемое значение:
//  Неопределено, Структура - Неопределено без счёта снимков, иначе снимок-отметка.
//
Функция СнимокПрав(Знач Пользователь) Экспорт
	Если НЕ СчётСнимков Тогда
		Возврат Неопределено;
	КонецЕсли;
	СнимковСнято = СнимковСнято + 1;
	Возврат Новый Структура("Пользователь", Пользователь);
КонецФункции

// Где субъекту можно изменять: заданное ЗадатьОбласти, а без него — администратору весь хаб,
// остальным нигде.
//
// Параметры:
//  Пользователь - Структура, Неопределено - субъект.
//  Снимок       - Произвольный - снимок прав (необязательный).
//
// Возвращаемое значение:
//  Структура - ВесьХаб, Пулы, Пакеты.
//
Функция ОбластиИзменения(Знач Пользователь, Знач Снимок = Неопределено) Экспорт
	УчестьСнимок(Снимок);
	Если Области <> Неопределено Тогда
		Возврат Области;
	КонецЕсли;
	Возврат Новый Структура("ВесьХаб, Пулы, Пакеты",
		ПользовательАдмин(Пользователь), Новый Массив(), Новый Массив());
КонецФункции

// Может ли пользователь создать пул: действие «создание» на хабе.
//
// Параметры:
//  Пользователь - Структура, Неопределено - субъект.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетСоздаватьПул(Знач Пользователь) Экспорт
	Возврат РазрешеноДействие(Пользователь, "создание", ОбъектХаб());
КонецФункции

// Может ли пользователь назначить основной пул: действие «изменение» на хабе.
//
// Параметры:
//  Пользователь - Структура, Неопределено - субъект.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетНазначатьОсновнойПул(Знач Пользователь) Экспорт
	Возврат РазрешеноДействие(Пользователь, "изменение", ОбъектХаб());
КонецФункции

// Может ли пользователь удалить пул: действие «удаление» на хабе.
//
// Параметры:
//  Пользователь - Структура, Неопределено - субъект.
//
// Возвращаемое значение:
//  Булево.
//
Функция МожетУдалятьПул(Знач Пользователь) Экспорт
	Возврат РазрешеноДействие(Пользователь, "удаление", ОбъектХаб());
КонецФункции

// Задаёт ответ ОбластиИзменения для любого субъекта.
//
// Параметры:
//  ВесьХаб - Булево - изменять можно везде.
//  Пулы - Массив из Число - пулы с правом изменения (необязательный).
//  Пакеты - Массив из Число - пакеты с правом изменения (необязательный).
//
Процедура ЗадатьОбласти(Знач ВесьХаб, Знач Пулы = Неопределено, Знач Пакеты = Неопределено) Экспорт
	Области = Новый Структура("ВесьХаб, Пулы, Пакеты", ВесьХаб,
		?(Пулы = Неопределено, Новый Массив(), Пулы),
		?(Пакеты = Неопределено, Новый Массив(), Пакеты));
КонецПроцедуры

// Даёт распоряжаться пулом: МожетАдминистрировать отвечает по списку таких пулов.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
Процедура РазрешитьРаспоряжаться(Знач ПулИдентификатор) Экспорт
	ПулыВРаспоряжении.Вставить(Цел(ПулИдентификатор), Истина);
КонецПроцедуры

// Включает счёт снимков прав: СнимокПрав отдаёт снимок, вопрос без снимка считается ещё одним.
//
Процедура СчитатьСнимки() Экспорт
	СчётСнимков = Истина;
КонецПроцедуры

// Является ли субъект администратором хаба. С заданным набором действий — никогда:
// суперправо перекрыло бы проверку того, какое именно право спрашивает служба.
//
// Параметры:
//  Пользователь - Структура, Неопределено - субъект.
//
// Возвращаемое значение:
//  Булево - признак администратора.
//
Функция ПользовательАдмин(Знач Пользователь) Экспорт

	Если Разрешённые.Количество() > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Пользователь <> Неопределено И Пользователь.Свойство("Админ")
		И Пользователь.Админ = Истина;

КонецФункции

// Вопрос без снимка снимает его заново — так же, как это делает модель прав.
Процедура УчестьСнимок(Знач Снимок)
	Если СчётСнимков И Снимок = Неопределено Тогда
		СнимковСнято = СнимковСнято + 1;
	КонецЕсли;
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач ДействияCSV = "")

	Разрешённые = Новый Соответствие();
	ПулыВРаспоряжении = Новый Соответствие();
	СчётСнимков = Ложь;
	СнимковСнято = 0;

	Для Каждого Действие Из СтрРазделить(Строка(ДействияCSV), ",") Цикл
		Норм = НРег(СокрЛП(Действие));
		Если ЗначениеЗаполнено(Норм) Тогда
			Разрешённые.Вставить(Норм, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
