// Совет ОСени для контейнера набора: детальки набора сильнее файла настроек и окружения.

#Использовать autumn

// Совет, каким его собирает ОСень по умолчанию: окружение, файл autumn-properties проекта
// и поверх них детальки набора.
//
// Параметры:
//  Детальки - Соответствие - детальки набора.
//
// Возвращаемое значение:
//  СоветДругогоМастера - совет для Новый Поделка(Совет).
//
Функция СДетальками(Знач Детальки) Экспорт

	Совет = Новый СоветДругогоМастера();
	Совет.ПолучитьСтроительМенеджераПараметров().ДобавитьПровайдерСоответствие(Детальки, 3, "inline");
	Возврат Совет;

КонецФункции

// Совет без файла настроек: окружение и детальки набора. Файл autumn-properties проекта
// контейнер не читает, и его узлы (база, корень данных, порт) набор не перекрывают.
//
// Параметры:
//  Детальки - Соответствие - детальки набора.
//
// Возвращаемое значение:
//  СоветДругогоМастера - совет для Новый Поделка(Совет).
//
Функция БезФайлаНастроек(Знач Детальки) Экспорт

	Совет = СДетальками(Детальки);
	Совет.ПолучитьСтроительМенеджераПараметров().УдалитьПровайдер("default");
	Возврат Совет;

КонецФункции
