// Фикстура: единственный разбор таблицы стилей слоя — правила, CSS-переменные и ритм полей
// в формах (у родителя с двумя и более полями обязан быть интервал: gap либо «> * + *»).

Перем ПустыеТеги;   // void-элементы HTML: закрывающего тега не имеют
Перем БлочныеТеги;  // блочные элементы: их открытие закрывает незакрытый <p>
Перем КэшТекстаCSS; // фикстуру зовут на каждую страницу набора — таблицу стилей
Перем КэшПравилCSS; // разбираем один раз

#Область ПрограммныйИнтерфейс

// Проверяет ритм полей в готовой разметке: у контейнера с двумя и более полями обязан
// быть вертикальный интервал в CSS.
//
// Параметры:
//  HTML - Строка - разметка, напечатанная слоем представления.
//  ТекстCSS - Строка - содержимое таблицы стилей.
//
// Возвращаемое значение:
//  Массив из Строка - описания нарушений; пустой массив — ритм в порядке.
//
Функция Нарушения(Знач HTML, Знач ТекстCSS) Экспорт

	Результат = Новый Массив();
	ВладеетИнтервалом = Новый Соответствие();   // класс -> Булево, кэш разбора CSS

	Для Каждого Родитель Из Родители(HTML) Цикл

		Если Родитель.Полей < 2 Тогда
			Продолжить;
		КонецЕсли;

		Если Родитель.Корень Тогда
			Результат.Добавить(СтрШаблон(
				"%1 полей (.field/.toggle) лежат в корне разметки, без контейнера вовсе:"
				+ " интервал между ними давать некому. Либо разметка потеряла обёртку,"
				+ " либо разбор сбился на незакрытом элементе (6.A-3, ревью 6.A A-3).",
				Родитель.Полей));
			Продолжить;
		КонецЕсли;

		Кандидаты = Новый Массив();
		Для Каждого Класс Из Родитель.Классы Цикл
			Кандидаты.Добавить("." + Класс);
		КонецЦикла;
		Кандидаты.Добавить(Родитель.Тег);

		Владелец = "";
		Для Каждого Кандидат Из Кандидаты Цикл
			Если ВладеетИнтервалом[Кандидат] = Неопределено Тогда
				ВладеетИнтервалом.Вставить(Кандидат, СелекторЗадаётИнтервал(ТекстCSS, Кандидат));
			КонецЕсли;
			Если ВладеетИнтервалом[Кандидат] Тогда
				Владелец = Кандидат;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ЗначениеЗаполнено(Владелец) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(СтрШаблон(
			"<%1 class=""%2""> держит %3 полей (.field/.toggle) вплотную: ни один из"
			+ " селекторов %4 не задаёт интервал в листах страницы — нужен либо «gap:»"
			+ " у flex/grid, либо правило «> * + * { margin-top: … }». Интервал между"
			+ " полями даёт КОНТЕЙНЕР, а не поле (6.A-3, ревью 6.A Б-1).",
			Родитель.Тег, СтрСоединить(Родитель.Классы, " "), Родитель.Полей,
			СтрСоединить(Кандидаты, ", ")));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Родители полей .field/.toggle, найденные в разметке.
//
// Параметры:
//  HTML - Строка - разметка.
//
// Возвращаемое значение:
//  Массив из Структура (Тег, Классы, Полей, Корень) - по элементу на каждый контейнер,
//   непосредственно содержащий поля; поля вне любого элемента дают одну запись
//   с Корень = Истина и пустыми Тег и Классы.
//
Функция Родители(Знач HTML) Экспорт

	Стек = Новый Массив();          // открытые элементы: Структура (Тег, Классы, Индекс)
	Найденные = Новый Массив();     // Структура (Тег, Классы, Полей, Корень)
	ПолейВКорне = 0;
	Позиция = 1;
	Длина = СтрДлина(HTML);

	Пока Позиция <= Длина Цикл

		Начало = СтрНайти(HTML, "<", НаправлениеПоиска.СНачала, Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;

		Следующий = Сред(HTML, Начало + 1, 1);

		Если Следующий = "!" Тогда
			Позиция = КонецКомментарияИлиДоктайпа(HTML, Начало);
			Продолжить;
		КонецЕсли;

		Если Следующий = "/" Тогда
			КонецТега = КонецОткрывающего(HTML, Начало);
			Закрыть(Стек, ИмяТега(Сред(HTML, Начало + 2, КонецТега - Начало - 2)));
			Позиция = КонецТега + 1;
			Продолжить;
		КонецЕсли;

		Если НЕ БукваТега(Следующий) Тогда
			Позиция = Начало + 1;
			Продолжить;
		КонецЕсли;

		КонецТега = КонецОткрывающего(HTML, Начало);
		Разметка = Сред(HTML, Начало + 1, КонецТега - Начало - 1);
		Тег = ИмяТега(Разметка);
		Классы = КлассыИзРазметки(Разметка);

		Пока Стек.Количество() > 0 И НеявноЗакрывается(Стек[Стек.ВГраница()].Тег, Тег) Цикл
			Стек.Удалить(Стек.ВГраница());
		КонецЦикла;

		Если ЭтоПоле(Классы) Тогда
			Если Стек.Количество() > 0 Тогда
				Родитель = Найденные[Стек[Стек.ВГраница()].Индекс];
				Родитель.Полей = Родитель.Полей + 1;
			Иначе
				ПолейВКорне = ПолейВКорне + 1;
			КонецЕсли;
		КонецЕсли;

		Если НЕ (ПустойТег(Тег) ИЛИ СамозакрытыйТег(Разметка)) Тогда
			Запись = Новый Структура("Тег, Классы, Полей, Корень", Тег, Классы, 0, Ложь);
			Найденные.Добавить(Запись);
			Стек.Добавить(Новый Структура("Тег, Индекс", Тег, Найденные.Количество() - 1));
		КонецЕсли;

		Позиция = КонецТега + 1;

	КонецЦикла;

	Итог = Новый Массив();
	Для Каждого Запись Из Найденные Цикл
		Если Запись.Полей > 0 Тогда
			Итог.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	Если ПолейВКорне > 0 Тогда
		Итог.Добавить(Новый Структура("Тег, Классы, Полей, Корень",
			"", Новый Массив(), ПолейВКорне, Истина));
	КонецЕсли;

	Возврат Итог;

КонецФункции

// Задаёт ли селектор вертикальный интервал между своими детьми.
//
// Параметры:
//  ТекстCSS - Строка - содержимое таблицы стилей.
//  Основа - Строка - селектор родителя: класс с точкой («.form-stack») либо тег.
//
// Возвращаемое значение:
//  Булево - Истина при ненулевом gap/row-gap у flex- или grid-контейнера либо при правиле
//   потока «> * + *» с ненулевым margin-top.
//
Функция СелекторЗадаётИнтервал(Знач ТекстCSS, Знач Основа) Экспорт

	Для Каждого Правило Из ПравилаCSS(ТекстCSS) Цикл
		Для Каждого Селектор Из СтрРазделить(Правило.Селектор, ",", Ложь) Цикл

			Очищенный = СокрЛП(Селектор);

			Если Очищенный = Основа Тогда
				Если (ЕстьОбъявление(Правило.Объявления, "gap")
						ИЛИ ЕстьОбъявление(Правило.Объявления, "row-gap"))
					И ЭтоFlexИлиGrid(ТекстCSS, Основа) Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЕсли;

			Если ПравилоПотока(Очищенный, Основа)
				И ЕстьОбъявление(Правило.Объявления, "margin-top") Тогда
				Возврат Истина;
			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Разбирает таблицу стилей на правила.
//
// Параметры:
//  ТекстCSS - Строка - содержимое таблицы стилей.
//  ВключаяУсловные - Булево - вернуть и правила внутри @media/@supports/@keyframes
//   (необязательный, по умолчанию Ложь — только безусловные).
//
// Возвращаемое значение:
//  Массив из Структура (Селектор, Объявления).
//
Функция ПравилаCSS(Знач ТекстCSS, Знач ВключаяУсловные = Ложь) Экспорт

	Если КэшТекстаCSS <> ТекстCSS Тогда
		КэшТекстаCSS = ТекстCSS;
		КэшПравилCSS = Новый Соответствие();
	КонецЕсли;

	Если КэшПравилCSS[ВключаяУсловные] <> Неопределено Тогда
		Возврат КэшПравилCSS[ВключаяУсловные];
	КонецЕсли;

	Текст = БезКомментариев(ТекстCSS);
	Результат = Новый Массив();
	Буфер = "";
	Позиция = 1;
	Длина = СтрДлина(Текст);

	Пока Позиция <= Длина Цикл

		Символ = Сред(Текст, Позиция, 1);

		Если Символ = "{" Тогда

			Селектор = СокрЛП(Буфер);
			Буфер = "";

			Если Лев(Селектор, 1) = "@" Тогда
				Если ВключаяУсловные Тогда
					Позиция = Позиция + 1;   // содержимое разберут следующие витки
				Иначе
					Позиция = КонецБлока(Текст, Позиция);   // условный блок целиком
				КонецЕсли;
				Продолжить;
			КонецЕсли;

			Закрытие = СтрНайти(Текст, "}", НаправлениеПоиска.СНачала, Позиция);
			Если Закрытие = 0 Тогда
				Прервать;
			КонецЕсли;

			Результат.Добавить(Новый Структура("Селектор, Объявления",
				Селектор, Сред(Текст, Позиция + 1, Закрытие - Позиция - 1)));
			Позиция = Закрытие + 1;
			Продолжить;

		ИначеЕсли Символ = "}" Тогда
			Буфер = "";
		Иначе
			Буфер = Буфер + Символ;
		КонецЕсли;

		Позиция = Позиция + 1;

	КонецЦикла;

	КэшПравилCSS.Вставить(ВключаяУсловные, Результат);

	Возврат Результат;

КонецФункции

// Текст таблицы стилей без комментариев /* … */.
//
// Параметры:
//  Текст - Строка - исходный CSS.
//
// Возвращаемое значение:
//  Строка.
//
Функция БезКомментариевCSS(Знач Текст) Экспорт
	Возврат БезКомментариев(Текст);
КонецФункции

// Имена CSS-переменных, которые текст ИСПОЛЬЗУЕТ через var(--…).
//
// Параметры:
//  ТекстCSS - Строка - таблица стилей либо блок объявлений.
//
// Возвращаемое значение:
//  Массив из Строка - имена вида «--color-bg», каждое по одному разу. Запасное значение
//   var(--x, значение) отбрасывается, вложенные var() учитываются; имена из комментариев
//   /* … */ и из строковых литералов (content: "var(--x)") использованием не считаются.
//
Функция ИспользованныеПеременные(Знач ТекстCSS) Экспорт

	Результат = Новый Массив();
	// комментарий заменяется ПРОБЕЛОМ: склейка соседей («solid/*c*/var(--x)» → «solidvar(»)
	// теряла бы такое использование молча
	Текст = БезЛитералов(БезКомментариев(ТекстCSS, " "));
	Позиция = 1;

	Пока Истина Цикл

		Начало = СтрНайти(Текст, "var(", НаправлениеПоиска.СНачала, Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;

		Позиция = Начало + 4;

		// «--my-var(» — хвост чужого идентификатора, а не функция var()
		Если Начало > 1 И НЕ РазделительCSS(Сред(Текст, Начало - 1, 1)) Тогда
			Продолжить;
		КонецЕсли;

		Имя = ИмяПеременной(Текст, ПропуститьПробельные(Текст, Позиция));
		Если ЗначениеЗаполнено(Имя) И Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Имена CSS-переменных, которые текст ОБЪЯВЛЯЕТ («--имя: значение»).
//
// Параметры:
//  ТекстCSS - Строка - блок объявлений либо таблица стилей.
//
// Возвращаемое значение:
//  Массив из Строка - имена вида «--color-bg», каждое по одному разу. Использование
//   var(--x) в значении объявлением не считается, «.button--link» — тем более.
//
Функция ОбъявленныеПеременные(Знач ТекстCSS) Экспорт

	Результат = Новый Массив();
	Текст = БезКомментариев(ТекстCSS);
	Позиция = 1;

	Пока Истина Цикл

		Начало = СтрНайти(Текст, "--", НаправлениеПоиска.СНачала, Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;

		Позиция = Начало + 2;

		// «.button--link» — модификатор класса, а не переменная
		Если Начало > 1 И НЕ РазделительCSS(Сред(Текст, Начало - 1, 1)) Тогда
			Продолжить;
		КонецЕсли;

		Имя = ИмяПеременной(Текст, Начало);
		Если НЕ ЗначениеЗаполнено(Имя) Тогда
			Продолжить;
		КонецЕсли;

		// двоеточие после имени отличает объявление от var(--x) в значении
		Если Сред(Текст, ПропуститьПробельные(Текст, Начало + СтрДлина(Имя)), 1) <> ":" Тогда
			Продолжить;
		КонецЕсли;

		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныйРазбор

Функция ЭтоПоле(Знач Классы)
	Возврат Классы.Найти("field") <> Неопределено ИЛИ Классы.Найти("toggle") <> Неопределено;
КонецФункции

Функция ПравилоПотока(Знач Селектор, Знач Основа)

	Если Лев(Селектор, СтрДлина(Основа)) <> Основа Тогда
		Возврат Ложь;
	КонецЕсли;

	Хвост = СтрЗаменить(СтрЗаменить(Сред(Селектор, СтрДлина(Основа) + 1), " ", ""),
		Символы.Таб, "");

	Возврат Хвост = ">*+*" ИЛИ Хвост = ">*~*"
		ИЛИ Хвост = ">:not(:first-child)" ИЛИ Хвост = ">*:not(:first-child)";

КонецФункции

Функция ЭтоFlexИлиGrid(Знач ТекстCSS, Знач Основа)

	Последнее = "";

	Для Каждого Правило Из ПравилаCSS(ТекстCSS) Цикл
		Для Каждого Селектор Из СтрРазделить(Правило.Селектор, ",", Ложь) Цикл

			Если СокрЛП(Селектор) <> Основа Тогда
				Продолжить;
			КонецЕсли;

			Значение = НРег(ЗначениеОбъявления(Правило.Объявления, "display"));
			Если ЗначениеЗаполнено(Значение) Тогда
				Последнее = Значение;
			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

	Возврат Последнее = "flex" ИЛИ Последнее = "inline-flex"
		ИЛИ Последнее = "grid" ИЛИ Последнее = "inline-grid";

КонецФункции

Функция ЕстьОбъявление(Знач Объявления, Знач Свойство)

	Значение = ЗначениеОбъявления(Объявления, Свойство);
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Первая = "";
	Для Каждого Токен Из СтрРазделить(Значение, " ", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Токен)) Тогда
			Первая = СокрЛП(Токен);
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат НЕ НулеваяВеличина(Первая);

КонецФункции

Функция ЗначениеОбъявления(Знач Объявления, Знач Свойство)

	Результат = "";

	Для Каждого Кусок Из СтрРазделить(Объявления, ";", Ложь) Цикл
		Разделитель = СтрНайти(Кусок, ":");
		Если Разделитель = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если НРег(СокрЛП(Лев(Кусок, Разделитель - 1))) <> Свойство Тогда
			Продолжить;
		КонецЕсли;
		Результат = СокрЛП(Сред(Кусок, Разделитель + 1));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НулеваяВеличина(Знач Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Истина;
	КонецЕсли;

	Если Лев(Значение, 1) = "-" Тогда
		Возврат Истина;
	КонецЕсли;

	Число_ = "";
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Символ = Сред(Значение, Индекс, 1);
		Если СтрНайти("0123456789.", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		Число_ = Число_ + Символ;
	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(Число_) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрЗаменить(СтрЗаменить(Число_, "0", ""), ".", "") = "";

КонецФункции

// Имя переменной, начинающееся в указанной позиции; "" — если там не «--имя».
Функция ИмяПеременной(Знач Текст, Знач Начало)

	Если Сред(Текст, Начало, 2) <> "--" Тогда
		Возврат "";
	КонецЕсли;

	Имя = "--";
	Индекс = Начало + 2;
	Пока Индекс <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если РазделительCSS(Символ) Тогда
			Прервать;
		КонецЕсли;
		Имя = Имя + Символ;
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат ?(Имя = "--", "", Имя);

КонецФункции

Функция ПропуститьПробельные(Знач Текст, Знач Начало)

	Индекс = Начало;
	Пока Индекс <= СтрДлина(Текст) И Пробельный(Сред(Текст, Индекс, 1)) Цикл
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат Индекс;

КонецФункции

// Что угодно, кроме символов имени: дефис и подчёркивание в имя входят, буквы любого
// алфавита — тоже, поэтому перечислены именно РАЗДЕЛИТЕЛИ.
Функция РазделительCSS(Знач Символ)
	Возврат СтрНайти(" ,;:(){}[]<>'""/*+~=|!?.#%&@\" + Символы.Таб + Символы.ПС + Символы.ВК,
		Символ) > 0;
КонецФункции

Функция БезКомментариев(Знач Текст, Знач Замена = "")

	Результат = Текст;
	Пока Истина Цикл
		Начало = СтрНайти(Результат, "/*");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Конец = СтрНайти(Результат, "*/", НаправлениеПоиска.СНачала, Начало + 2);
		Если Конец = 0 Тогда
			Возврат Лев(Результат, Начало - 1);
		КонецЕсли;
		Результат = Лев(Результат, Начало - 1) + Замена + Сред(Результат, Конец + 2);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Содержимое строковых литералов вырезается: «content: "var(--x)"» переменной не использует,
// а сканер считал бы её живой и требовал объявления.
Функция БезЛитералов(Знач Текст)

	Результат = "";
	Кавычка = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если ЗначениеЗаполнено(Кавычка) Тогда
			Если Символ = Кавычка Тогда
				Кавычка = "";
				Результат = Результат + Символ;
			КонецЕсли;
		ИначеЕсли Символ = """" ИЛИ Символ = "'" Тогда
			Кавычка = Символ;
			Результат = Результат + Символ;
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КонецОткрывающего(Знач HTML, Знач Начало)

	Позиция = Начало + 1;
	Длина = СтрДлина(HTML);
	Кавычка = "";

	Закрытие = СтрНайти(HTML, ">", НаправлениеПоиска.СНачала, Позиция);
	Если Закрытие = 0 Тогда
		Возврат Длина + 1;
	КонецЕсли;
	Апостроф = СтрНайти(HTML, "'", НаправлениеПоиска.СНачала, Позиция);
	Двойная = СтрНайти(HTML, """", НаправлениеПоиска.СНачала, Позиция);
	Если (Апостроф = 0 ИЛИ Апостроф > Закрытие) И (Двойная = 0 ИЛИ Двойная > Закрытие) Тогда
		Возврат Закрытие;
	КонецЕсли;

	Пока Позиция <= Длина Цикл
		Символ = Сред(HTML, Позиция, 1);
		Если ЗначениеЗаполнено(Кавычка) Тогда
			Если Символ = Кавычка Тогда
				Кавычка = "";
			КонецЕсли;
		ИначеЕсли Символ = """" ИЛИ Символ = "'" Тогда
			Кавычка = Символ;
		ИначеЕсли Символ = ">" Тогда
			Возврат Позиция;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Длина + 1;

КонецФункции

Функция КонецБлока(Знач Текст, Знач Начало)

	Глубина = 0;
	Позиция = Начало;
	Длина = СтрДлина(Текст);

	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = "{" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = "}" Тогда
			Глубина = Глубина - 1;
			Если Глубина <= 0 Тогда
				Возврат Позиция + 1;
			КонецЕсли;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Длина + 1;

КонецФункции

Функция КонецКомментарияИлиДоктайпа(Знач HTML, Знач Начало)

	Если Сред(HTML, Начало, 4) = "<!--" Тогда
		Конец = СтрНайти(HTML, "-->", НаправлениеПоиска.СНачала, Начало + 4);
		Возврат ?(Конец = 0, СтрДлина(HTML) + 1, Конец + 3);
	КонецЕсли;

	Конец = СтрНайти(HTML, ">", НаправлениеПоиска.СНачала, Начало);
	Возврат ?(Конец = 0, СтрДлина(HTML) + 1, Конец + 1);

КонецФункции

Функция ИмяТега(Знач Разметка)

	Имя = "";
	Для Индекс = 1 По СтрДлина(Разметка) Цикл
		Символ = Сред(Разметка, Индекс, 1);
		Если БукваТега(Символ) ИЛИ (ЗначениеЗаполнено(Имя) И СтрНайти("0123456789-", Символ) > 0) Тогда
			Имя = Имя + Символ;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат НРег(СокрЛП(Имя));

КонецФункции

Функция БукваТега(Знач Символ)
	Возврат СтрНайти("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", Символ) > 0;
КонецФункции

Функция КлассыИзРазметки(Знач Разметка)

	Результат = Новый Массив();
	Позиция = ПозицияАтрибутаКласса(Разметка);
	Если Позиция = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Хвост = СокрЛ(Сред(Разметка, Позиция + 6));
	Кавычка = Лев(Хвост, 1);
	Если Кавычка = """" ИЛИ Кавычка = "'" Тогда
		Хвост = Сред(Хвост, 2);
		Конец = СтрНайти(Хвост, Кавычка);
	Иначе
		Конец = СтрНайти(Хвост, " ");
	КонецЕсли;

	Значение = ?(Конец = 0, Хвост, Лев(Хвост, Конец - 1));

	Для Каждого Класс Из СтрРазделить(СтрЗаменить(Значение, Символы.ПС, " "), " ", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Класс)) Тогда
			Результат.Добавить(СокрЛП(Класс));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПозицияАтрибутаКласса(Знач Разметка)

	Низкий = НРег(Разметка);
	Отступ = 1;

	Пока Истина Цикл

		Позиция = СтрНайти(Низкий, "class=", НаправлениеПоиска.СНачала, Отступ);
		Если Позиция = 0 Тогда
			Возврат 0;
		КонецЕсли;

		Если Позиция > 1 И Пробельный(Сред(Низкий, Позиция - 1, 1)) Тогда
			Возврат Позиция;
		КонецЕсли;

		Отступ = Позиция + 6;

	КонецЦикла;

КонецФункции

Функция Пробельный(Знач Символ)
	Возврат Символ = " " ИЛИ Символ = Символы.Таб ИЛИ Символ = Символы.ПС ИЛИ Символ = Символы.ВК;
КонецФункции

Функция НеявноЗакрывается(Знач Открытый, Знач Новый_)

	Если Открытый = "p" Тогда
		Возврат БлочныйТег(Новый_);
	ИначеЕсли Открытый = "li" Тогда
		Возврат Новый_ = "li";
	ИначеЕсли Открытый = "option" Тогда
		Возврат Новый_ = "option" ИЛИ Новый_ = "optgroup";
	ИначеЕсли Открытый = "dt" ИЛИ Открытый = "dd" Тогда
		Возврат Новый_ = "dt" ИЛИ Новый_ = "dd";
	ИначеЕсли Открытый = "tr" Тогда
		Возврат Новый_ = "tr";
	ИначеЕсли Открытый = "td" ИЛИ Открытый = "th" Тогда
		Возврат Новый_ = "td" ИЛИ Новый_ = "th" ИЛИ Новый_ = "tr";
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция БлочныйТег(Знач Тег)
	Возврат БлочныеТеги.Найти(Тег) <> Неопределено;
КонецФункции

Функция ПустойТег(Знач Тег)
	Возврат ПустыеТеги.Найти(Тег) <> Неопределено;
КонецФункции

Функция СамозакрытыйТег(Знач Разметка)
	Возврат Прав(СокрП(Разметка), 1) = "/";
КонецФункции

Процедура Закрыть(Стек, Знач Тег)

	Для Индекс = -Стек.ВГраница() По 0 Цикл
		Если Стек[-Индекс].Тег = Тег Тогда
			Пока Стек.Количество() > -Индекс Цикл
				Стек.Удалить(Стек.ВГраница());
			КонецЦикла;
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

ПустыеТеги = Новый Массив();
ПустыеТеги.Добавить("area");
ПустыеТеги.Добавить("base");
ПустыеТеги.Добавить("br");
ПустыеТеги.Добавить("col");
ПустыеТеги.Добавить("embed");
ПустыеТеги.Добавить("hr");
ПустыеТеги.Добавить("img");
ПустыеТеги.Добавить("input");
ПустыеТеги.Добавить("link");
ПустыеТеги.Добавить("meta");
ПустыеТеги.Добавить("param");
ПустыеТеги.Добавить("source");
ПустыеТеги.Добавить("track");
ПустыеТеги.Добавить("wbr");
ПустыеТеги.Добавить("path");
ПустыеТеги.Добавить("circle");
ПустыеТеги.Добавить("rect");
ПустыеТеги.Добавить("line");
ПустыеТеги.Добавить("polyline");
ПустыеТеги.Добавить("polygon");
ПустыеТеги.Добавить("use");

БлочныеТеги = Новый Массив();
Для Каждого ИмяБлочного Из СтрРазделить("address,article,aside,blockquote,details,div,dl,"
	+ "fieldset,figcaption,figure,footer,form,h1,h2,h3,h4,h5,h6,header,hgroup,hr,main,menu,"
	+ "nav,ol,p,pre,section,table,ul", ",", Ложь) Цикл
	БлочныеТеги.Добавить(ИмяБлочного);
КонецЦикла;
