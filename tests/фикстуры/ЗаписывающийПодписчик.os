// Фикстура: подписчик доменных событий, складывающий всё пришедшее — тест утверждает,
// какое событие опубликовано и с какой полезной нагрузкой.

Перем События Экспорт; // Массив из Структура (Тип, Когда, Данные)

// Контракт подписчика: складывает событие в накопитель.
//
// Параметры:
//  Событие - Структура - доменное событие (Тип, Когда, Данные).
//
Процедура ОбработатьСобытие(Знач Событие) Экспорт
	События.Добавить(Событие);
КонецПроцедуры

// Первое принятое событие заданного типа.
//
// Параметры:
//  Тип - Строка - тип события.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если события такого типа не было.
//
Функция Первое(Знач Тип) Экспорт

	Для Каждого Событие Из События Цикл
		Если Событие.Тип = Тип Тогда
			Возврат Событие;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Число принятых событий.
//
// Параметры:
//  Тип - Строка - тип события; пусто — считать все (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Число.
//
Функция Количество(Знач Тип = "") Экспорт

	Если НЕ ЗначениеЗаполнено(Тип) Тогда
		Возврат События.Количество();
	КонецЕсли;
	Итог = 0;
	Для Каждого Событие Из События Цикл
		Если Событие.Тип = Тип Тогда
			Итог = Итог + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

Процедура ПриСозданииОбъекта()
	События = Новый Массив();
КонецПроцедуры
