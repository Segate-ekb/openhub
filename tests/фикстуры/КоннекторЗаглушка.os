// Заглушка коннектора entity для тестов SQL-генерации ПоискаPostgreSQL: захватывает тексты
// запросов и отдаёт заранее заданные строки. Не входит в состав приложения.

Перем Запросы_;              // Массив текстов запросов
Перем СчётВернуть_;          // Число - что вернуть для COUNT
Перем ИдентификаторыВернуть_; // Массив id для выборки

// Контракт коннектора entity: запоминает текст запроса и отдаёт заранее заданный результат.
//
// Параметры:
//  ТекстЗапроса - Строка - текст SQL-запроса.
//
// Возвращаемое значение:
//  Массив из Соответствие - для COUNT одна строка с колонкой «кол», иначе строки
//   с колонкой «ид».
//
Функция ВыполнитьЗапрос(Знач ТекстЗапроса) Экспорт

	Запросы_.Добавить(ТекстЗапроса);

	Результат = Новый Массив();
	Если СтрНайти(ТекстЗапроса, "COUNT(") > 0 Тогда
		Строка = Новый Соответствие();
		Строка.Вставить("кол", СчётВернуть_);
		Результат.Добавить(Строка);
	Иначе
		Для Каждого Ид Из ИдентификаторыВернуть_ Цикл
			Строка = Новый Соответствие();
			Строка.Вставить("ид", Ид);
			Результат.Добавить(Строка);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Все выполненные запросы в порядке вызова.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Запросы() Экспорт
	Возврат Запросы_;
КонецФункции

// Последний запрос выборки идентификаторов (не COUNT).
//
// Возвращаемое значение:
//  Строка - пусто, если таких запросов не было.
//
Функция ЗапросВыборки() Экспорт
	Найдено = "";
	Для Каждого Текст Из Запросы_ Цикл
		Если СтрНайти(Текст, "COUNT(") = 0 Тогда
			Найдено = Текст;
		КонецЕсли;
	КонецЦикла;
	Возврат Найдено;
КонецФункции

// Последний запрос счёта (COUNT).
//
// Возвращаемое значение:
//  Строка - пусто, если таких запросов не было.
//
Функция ЗапросСчёта() Экспорт
	Найдено = "";
	Для Каждого Текст Из Запросы_ Цикл
		Если СтрНайти(Текст, "COUNT(") > 0 Тогда
			Найдено = Текст;
		КонецЕсли;
	КонецЦикла;
	Возврат Найдено;
КонецФункции

Процедура ПриСозданииОбъекта(Знач СчётВернуть, Знач ИдентификаторыВернуть)
	Запросы_ = Новый Массив();
	СчётВернуть_ = СчётВернуть;
	ИдентификаторыВернуть_ = ИдентификаторыВернуть;
КонецПроцедуры
