// Фейковый ИсточникАпстрима: заданный перечень элементов и ответы на скачивание без сети.

Перем РежимИсточника;
Перем КодПеречисления;
Перем Элементы;               // Массив из Структура(ИмяПакета, Версия, ПутьСкачивания, ВерсияИзвестна)
Перем ОтветыПоПути;           // Соответствие: ПутьСкачивания -> Структура(Код, Данные, ETag)
Перем СбойНаПути;             // Соответствие: ПутьСкачивания -> Истина (бросить исключение)
Перем СчётчикСкачиваний;
Перем ЕстьЕщё;                // Булево - что источник сообщает о непройденном хвосте списка
Перем СледующийКурсор;        // Строка - имя, с которого продолжится обход
Перем КурсорыВызовов;         // Массив из Строка - чем движок звал Перечислить
Перем ИменВсего_;             // Число - имён у апстрима после фильтра
Перем ИменПройдено_;          // Число - имён, пройденных обходом до порции
Перем Наблюдатель;            // объект с методом ПриСкачивании(Номер) — заглядывает в прогон

#Область Настройка

// Добавляет элемент синка с известной версией и ответ на его скачивание.
//
// Параметры:
//  ИмяПакета - Строка - имя пакета.
//  Версия    - Строка - версия пакета.
//  Код       - Число  - код ответа на скачивание.
//  Данные    - ДвоичныеДанные - тело ответа.
//  ETag      - Строка - значение ETag (необязательный, по умолчанию "").
//
Процедура ДобавитьВерсию(Знач ИмяПакета, Знач Версия, Знач Код, Знач Данные, Знач ETag = "") Экспорт
	Путь = СтрШаблон("%1/%1-%2.ospx", ИмяПакета, Версия);
	Элементы.Добавить(Новый Структура("ИмяПакета, Версия, ПутьСкачивания, ВерсияИзвестна",
		ИмяПакета, Версия, Путь, Истина));
	ОтветыПоПути.Вставить(Путь, Новый Структура("Код, Данные, ETag", Код, Данные, ETag));
КонецПроцедуры

// Добавляет элемент-latest: версия неизвестна до скачивания (режим legacy).
//
// Параметры:
//  ИмяПакета - Строка - имя пакета.
//  Код       - Число  - код ответа на скачивание.
//  Данные    - ДвоичныеДанные - тело ответа.
//  ETag      - Строка - значение ETag (необязательный, по умолчанию "").
//
Процедура ДобавитьLatest(Знач ИмяПакета, Знач Код, Знач Данные, Знач ETag = "") Экспорт
	Путь = СтрШаблон("%1/%1.ospx", ИмяПакета);
	Элементы.Добавить(Новый Структура("ИмяПакета, Версия, ПутьСкачивания, ВерсияИзвестна",
		ИмяПакета, "", Путь, Ложь));
	ОтветыПоПути.Вставить(Путь, Новый Структура("Код, Данные, ETag", Код, Данные, ETag));
КонецПроцедуры

// Помечает элемент как бросающий исключение при скачивании.
//
// Параметры:
//  ИмяПакета - Строка - имя пакета.
//  Версия    - Строка - версия пакета.
//
Процедура ОтметитьСбой(Знач ИмяПакета, Знач Версия) Экспорт
	СбойНаПути.Вставить(СтрШаблон("%1/%1-%2.ospx", ИмяПакета, Версия), Истина);
КонецПроцедуры

// Задаёт код ответа перечисления.
//
// Параметры:
//  Код - Число - код ответа; 0 — апстрим недоступен.
//
Процедура УстановитьКодПеречисления(Знач Код) Экспорт
	КодПеречисления = Код;
КонецПроцедуры

// Сколько раз звали Скачать().
//
// Возвращаемое значение:
//  Число - количество скачиваний.
//
Функция КоличествоСкачиваний() Экспорт
	Возврат СчётчикСкачиваний;
КонецФункции

// Задаёт хвост списка апстрима, о котором источник сообщает движку.
//
// Параметры:
//  Флаг - Булево - остались ли непройденные имена.
//  Курсор - Строка - имя, с которого продолжится обход (необязательный, по умолчанию "").
//
Процедура УстановитьХвост(Знач Флаг, Знач Курсор = "") Экспорт
	ЕстьЕщё = Флаг;
	СледующийКурсор = Курсор;
КонецПроцедуры

// Курсоры, с которыми движок звал Перечислить, в порядке вызовов.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ПолученныеКурсоры() Экспорт
	Возврат КурсорыВызовов;
КонецФункции

// Подсаживает наблюдателя: его ПриСкачивании(Номер) зовётся из каждого Скачать() —
// так тест заглядывает в состояние прогона, ПОКА цикл идёт.
//
// Параметры:
//  Объект - Произвольный - наблюдатель с методом ПриСкачивании(Номер).
//
Процедура ЗадатьНаблюдателя(Знач Объект) Экспорт
	Наблюдатель = Объект;
КонецПроцедуры

#КонецОбласти

#Область КонтрактИсточника

// Режим источника (контракт ИсточникАпстрима).
//
// Возвращаемое значение:
//  Строка - режим источника.
//
Функция Режим() Экспорт
	Возврат РежимИсточника;
КонецФункции

// Перечень элементов синка (контракт ИсточникАпстрима). Порцию не режет: отдаёт всё
// заданное, а хвост списка сообщает тем, что задал тест.
//
// Параметры:
//  Зеркало      - Произвольный - запись зеркала, не используется.
//  РазмерПорции - Число - предел выборки, не используется.
//  Курсор       - Строка - имя продолжения; запоминается для проверки (необязательный,
//                 по умолчанию "").
//  Отметка      - Произвольный - отметка живости с методом Шаг(ИмяПакета); зовётся на каждом
//                 перечисленном имени (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Структура - Код, Элементы, ЕстьЕщё, Курсор, ИменВсего, ИменПройдено.
//
// BSLLS:UnusedParameters-off
Функция Перечислить(Знач Зеркало, Знач РазмерПорции, Знач Курсор = "", Знач Отметка = Неопределено) Экспорт

	КурсорыВызовов.Добавить(Строка(Курсор));
	// боевой источник отмечается на каждом ИМЕНИ, а не на каждой версии: страница версий —
	// один запрос к апстриму на имя
	Если Отметка <> Неопределено Тогда
		Отмеченное = "";
		Для Каждого Элемент Из Элементы Цикл
			Если Строка(Элемент.ИмяПакета) <> Отмеченное Тогда
				Отмеченное = Строка(Элемент.ИмяПакета);
				Отметка.Шаг(Отмеченное);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Новый Структура("Код, Элементы, ЕстьЕщё, Курсор, ИменВсего, ИменПройдено",
		КодПеречисления, Элементы, ЕстьЕщё, СледующийКурсор, ИменВсего_, ИменПройдено_);

КонецФункции

// Задаёт шкалу обхода, которую источник отдаёт движку.
//
// Параметры:
//  Всего    - Число - имён у апстрима после фильтра.
//  Пройдено - Число - имён, пройденных обходом до этой порции.
//
Процедура ЗадатьШкалуИмён(Знач Всего, Знач Пройдено) Экспорт
	ИменВсего_ = Всего;
	ИменПройдено_ = Пройдено;
КонецПроцедуры

// Отдаёт заранее заданный ответ на скачивание элемента (контракт ИсточникАпстрима).
// Бросает исключение, если элемент помечен ОтметитьСбой.
//
// Параметры:
//  Зеркало - Произвольный - запись зеркала, не используется.
//  Элемент - Структура - элемент синка с полем ПутьСкачивания.
//
// Возвращаемое значение:
//  Структура - Код, Данные, ETag; 404 для неизвестного пути.
//
Функция Скачать(Знач Зеркало, Знач Элемент) Экспорт
	СчётчикСкачиваний = СчётчикСкачиваний + 1;
	Если Наблюдатель <> Неопределено Тогда
		Наблюдатель.ПриСкачивании(СчётчикСкачиваний);
	КонецЕсли;
	Если СбойНаПути.Получить(Элемент.ПутьСкачивания) = Истина Тогда
		ВызватьИсключение "эмуляция сбоя скачивания элемента " + Элемент.ПутьСкачивания;
	КонецЕсли;
	Ответ = ОтветыПоПути.Получить(Элемент.ПутьСкачивания);
	Если Ответ = Неопределено Тогда
		Возврат Новый Структура("Код, Данные, ETag", 404, Неопределено, "");
	КонецЕсли;
	Возврат Ответ;
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач Режим = "opm")
	РежимИсточника = Режим;
	КодПеречисления = 200;
	Элементы = Новый Массив();
	ОтветыПоПути = Новый Соответствие();
	СбойНаПути = Новый Соответствие();
	СчётчикСкачиваний = 0;
	ЕстьЕщё = Ложь;
	СледующийКурсор = "";
	КурсорыВызовов = Новый Массив();
	Наблюдатель = Неопределено;
	ИменВсего_ = 0;
	ИменПройдено_ = 0;
КонецПроцедуры
