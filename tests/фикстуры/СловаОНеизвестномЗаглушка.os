// Заглушка контракта «НеизвестныйАдресСловами»: отдаёт узнаваемые фразу и страницу и помнит,
// с чем её звали. Настоящая страница проверяется своим набором — здесь важно, ЧТО шов входа
// спрашивает и куда кладёт ответ.

Перем Страницы_;    // Массив из Структура (Заголовки, Куки, Путь)

#Область КонтрактНеизвестныйАдресСловами

// Фраза посетителю.
//
// Возвращаемое значение:
//  Строка.
//
Функция Фраза() Экспорт
	Возврат "фраза[неизвестный адрес]";
КонецФункции

// Страница «адрес не найден» целиком.
//
// Параметры:
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//  ПутьЗапроса - Строка - путь запроса.
//
// Возвращаемое значение:
//  Строка - разметка страницы.
//
Функция Страница(Знач ЗаголовкиЗапроса, Знач КукиЗапроса, Знач ПутьЗапроса) Экспорт

	Страницы_.Добавить(Новый Структура("Заголовки, Куки, Путь", ЗаголовкиЗапроса, КукиЗапроса,
		Строка(ПутьЗапроса)));
	Возврат "<html><body>" + Фраза() + " " + Строка(ПутьЗапроса) + "</body></html>";

КонецФункции

#КонецОбласти

// Вызовы сборки страницы в порядке вызова.
//
// Возвращаемое значение:
//  Массив из Структура - Заголовки, Куки, Путь.
//
Функция Страницы() Экспорт
	Возврат Страницы_;
КонецФункции

Процедура ПриСозданииОбъекта()
	Страницы_ = Новый Массив();
КонецПроцедуры
