// Фейк ПроверяющегоПодписиCI: по умолчанию отказывает. Позволяет проверить всё остальное
// в пути доверенных конвейеров — клеймы, срок действия, привязку к пакету, рамки ключа.
// Подпись не проверяет, поэтому при «разрешено» отдаёт нагрузку токена как проверенную.

Перем Разрешено;         // Булево
Перем ОжидаемыйИздатель; // Строка — "" означает «любой»
Перем Вердикты;          // Вердикт (основа) — форма ответа

// Разрешает считать подпись достоверной.
//
// Параметры:
//  Издатель - Строка - ограничить доверие одним издателем; пусто — любой
//   (необязательный, по умолчанию "").
//
Процедура Разрешить(Знач Издатель = "") Экспорт
	Разрешено = Истина;
	ОжидаемыйИздатель = НРег(СокрЛП(Строка(Издатель)));
КонецПроцедуры

// Возвращает фейк в исходное состояние «подпись недостоверна».
Процедура Запретить() Экспорт
	Разрешено = Ложь;
	ОжидаемыйИздатель = "";
КонецПроцедуры

// Контракт ПроверяющегоПодписиCI: проверка подписи и клеймы токена.
//
// Параметры:
//  Токен - Строка - id-token конвейера.
//  Издатель - Строка - издатель токена.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Сообщение (Строка), Клеймы (Соответствие либо Неопределено).
//
Функция ПроверитьТокен(Знач Токен, Знач Издатель) Экспорт

	Если НЕ Разрешено ИЛИ НЕ ЗначениеЗаполнено(Токен) Тогда
		Возврат Отказ("фейк настроен отказывать");
	КонецЕсли;

	Если ЗначениеЗаполнено(ОжидаемыйИздатель)
		И НРег(СокрЛП(Строка(Издатель))) <> ОжидаемыйИздатель Тогда
		Возврат Отказ("фейк доверяет другому издателю");
	КонецЕсли;

	Попытка
		Клеймы = Новый КодировкаТестов().НагрузкаJWT(Токен);
	Исключение
		Возврат Отказ("нагрузка токена не разобрана");
	КонецПопытки;

	Возврат Вердикты.УспехСловами(Нагрузка(Клеймы));

КонецФункции

Функция Нагрузка(Знач Клеймы = Неопределено)
	Возврат Новый Структура("Клеймы", Клеймы);
КонецФункции

Функция Отказ(Знач Сообщение)
	Возврат Вердикты.ОтказСловами(Сообщение, Нагрузка());
КонецФункции

&Прозвище("ПроверяющийПодписиCI")
&Желудь
Процедура ПриСозданииОбъекта()
	Разрешено = Ложь;
	ОжидаемыйИздатель = "";
	Вердикты = Новый Вердикт();
КонецПроцедуры
