// Фейковое хранилище зеркал в памяти: контракт ХранилищаЗеркалХабов без autumn-data и БД.

Перем Записи;
Перем СледИд;
Перем ЧтенийПоИдентификатору;  // Число - сколько раз спрашивали запись по идентификатору

// Контракт хранилища: новая, ещё не принятая запись зеркала.
//
// Возвращаемое значение:
//  ФейкЗеркалоЗапись.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Новый ФейкЗеркалоЗапись(ЭтотОбъект);
КонецФункции

// Принимает запись в хранилище, выдавая идентификатор при первом сохранении.
//
// Параметры:
//  Запись - ФейкЗеркалоЗапись - сохраняемая запись.
//
Процедура Принять(Знач Запись) Экспорт
	Если Запись.Идентификатор = 0 Тогда
		Запись.Идентификатор = СледИд;
		СледИд = СледИд + 1;
		Записи.Добавить(Запись);
	КонецЕсли;
КонецПроцедуры

// Записи зеркал пула назначения.
//
// Параметры:
//  ПулНазначенияИдентификатор - Число - идентификатор пула назначения.
//
// Возвращаемое значение:
//  Массив из ФейкЗеркалоЗапись.
//
Функция ПолучитьПоПулНазначенияИдентификаторРавно(Знач ПулНазначенияИдентификатор) Экспорт
	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Если Запись.ПулНазначенияИдентификатор = Цел(ПулНазначенияИдентификатор) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Запись зеркала по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор записи.
//
// Возвращаемое значение:
//  ФейкЗеркалоЗапись - либо Неопределено, если записи нет.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	ЧтенийПоИдентификатору = ЧтенийПоИдентификатору + 1;
	Для Каждого Запись Из Записи Цикл
		Если Запись.Идентификатор = Цел(Идентификатор) Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Запись зеркала по паре «пул назначения + адрес апстрима».
//
// Параметры:
//  ПулНазначенияИдентификатор - Число - идентификатор пула назначения.
//  АпстримURL - Строка - адрес апстрима.
//
// Возвращаемое значение:
//  ФейкЗеркалоЗапись - либо Неопределено, если пары нет.
//
Функция НайтиПоПулИАпстриму(Знач ПулНазначенияИдентификатор, Знач АпстримURL) Экспорт
	Для Каждого Запись Из Записи Цикл
		Если Запись.ПулНазначенияИдентификатор = Цел(ПулНазначенияИдентификатор)
			И Запись.АпстримURL = Строка(АпстримURL) Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Все записи хранилища.
//
// Возвращаемое значение:
//  Массив из ФейкЗеркалоЗапись.
//
Функция Все() Экспорт
	Возврат Записи;
КонецФункции

// Удаляет запись; отсутствие записи в хранилище не ошибка.
//
// Параметры:
//  Запись - ФейкЗеркалоЗапись - удаляемая запись.
//
Процедура Удалить(Знач Запись) Экспорт
	Индекс = Записи.Найти(Запись);
	Если Индекс <> Неопределено Тогда
		Записи.Удалить(Индекс);
	КонецЕсли;
КонецПроцедуры

// Сколько раз хранилище спрашивали по идентификатору: этим меряется N+1 в списках.
//
// Возвращаемое значение:
//  Число.
//
Функция ЧтенийПоИдентификатору() Экспорт
	Возврат ЧтенийПоИдентификатору;
КонецФункции

// Обнуляет счётчик чтений — начало замера.
//
Процедура СброситьСчётчикЧтений() Экспорт
	ЧтенийПоИдентификатору = 0;
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	СледИд = 1;
	ЧтенийПоИдентификатору = 0;
КонецПроцедуры
