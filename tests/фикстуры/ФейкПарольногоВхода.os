// Фейк ПолитикиПарольногоВхода: включён ли вход по паролю, задаёт тест.

Перем Состояние;

// Контракт ПолитикиПарольногоВхода: включён ли парольный вход.
//
// Возвращаемое значение:
//  Булево.
//
Функция Включён() Экспорт
	Возврат Состояние;
КонецФункции

// Контракт ПолитикиПарольногоВхода: выключен ли парольный вход.
//
// Возвращаемое значение:
//  Булево.
//
Функция Выключен() Экспорт
	Возврат НЕ Состояние;
КонецФункции

// Контракт ПолитикиПарольногоВхода: считается ли пароль учётки способом войти.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - учётная запись.
//  ВходВключён - Булево, Неопределено - снятое состояние парольного входа.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПарольДействует(Знач Пользователь, Знач ВходВключён = Неопределено) Экспорт

	Если Пользователь = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Работает = ?(ВходВключён = Неопределено, Состояние, ВходВключён = Истина);

	Возврат ЗначениеЗаполнено(Пользователь.ХешПароля) И Работает;

КонецФункции

// Задаёт состояние парольного входа.
//
// Параметры:
//  Значение - Булево - Истина, если вход по логину и паролю включён.
//
Процедура Установить(Знач Значение) Экспорт
	Состояние = (Значение = Истина);
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач Включено = Истина)
	Состояние = (Включено = Истина);
КонецПроцедуры
