// Фейковая запись пакета: поля, которых касаются ЛетописьВерсий и отметка последней
// публикации в СервисеВерсий, и Сохранить().

Перем Идентификатор Экспорт;
Перем Имя Экспорт;
Перем ПулИдентификатор Экспорт;
Перем ПоследняяПубликация Экспорт;
Перем СохраненийБыло Экспорт;

// Считает сохранение записи (контракт autumn-data).
//
Процедура Сохранить() Экспорт
	СохраненийБыло = СохраненийБыло + 1;
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач _Идентификатор, Знач _Имя, Знач _ПулИдентификатор)
	Идентификатор = Цел(_Идентификатор);
	Имя = Строка(_Имя);
	ПулИдентификатор = Цел(_ПулИдентификатор);
	ПоследняяПубликация = '00010101000000';
	СохраненийБыло = 0;
КонецПроцедуры
