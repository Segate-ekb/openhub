// Стенд учёток двумя дверями: учётная запись, её роль на пуле, грант права и ключ
// доступа — строкой в хранилище либо руками служб хаба. Одной фикстурой вместо шести
// строк «Логин, Email, Активен, РольХаба, Создан, Сохранить», переписанных в каждом
// наборе. Поля, которые сценарию безразличны, фикстура заполняет сама — набор называет
// только то, ради чего он написан.
//
// Дверь выбирает набор. «Строкой» (Учётка, РольВПуле, Грант, Ключ) кладёт запись прямо
// в хранилище: быстро и без последствий, годится там, где учётка — фон сценария.
// «Службами хаба» (УчёткаСлужбой) заводит учётку руками продукта, со всеми его
// последствиями — канон логина, резерв системных имён, проверка занятости, хеш пароля.
// Набор, который потом проверяет на учётке продуктовую логику входа, обязан брать вторую
// дверь: учётка, положенная строкой, отличается от заведённой хабом молча — у неё пустой
// ХешПароля и незанятый логин.
//
// Свободные имена берутся у общего модуля УникальныеИмена, а не у счётчика фикстуры:
// стендов в наборе бывает несколько, и счётчик каждого начинался бы с единицы.

Перем Контейнер;

#Область УчёткиСтрокой

// Заводит учётную запись строкой в хранилище.
//
// Параметры:
//  РольХаба - Строка - admin либо user (необязательный, по умолчанию "user").
//  Логин - Строка - логин (необязательный, по умолчанию "" — свободный «u-N-соль»).
//  Email - Строка - адрес почты (необязательный, по умолчанию "" — «<логин>@example.com»).
//  Активен - Булево - признак действующей учётки (необязательный, по умолчанию Истина).
//
// Возвращаемое значение:
//  Пользователь - сохранённая строка учётки.
//
Функция Учётка(Знач РольХаба = "user", Знач Логин = "", Знач Email = "",
	Знач Активен = Истина) Экспорт

	ИмяВхода = ?(ЗначениеЗаполнено(Логин), Логин, УникальныеИмена.Имя("u"));

	Запись = Желудь("ХранилищеПользователей").СоздатьЭлемент();
	Запись.Логин = ИмяВхода;
	Запись.Email = ?(ЗначениеЗаполнено(Email), Email, ИмяВхода + "@example.com");
	Запись.EmailПодтверждён = Ложь;
	Запись.ПодтверждёнХабом = Ложь;
	Запись.ХешПароля = "";
	Запись.Активен = Активен;
	Запись.РольХаба = РольХаба;
	Запись.ТребуетсяСменаПароля = Ложь;
	Запись.Создан = ТекущаяУниверсальнаяДата();
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

// Учётка с ролью на пуле — самый частый стенд: тот, кому пул принадлежит.
//
// Параметры:
//  ПулИлиИдентификатор - Пул, Число - пул, на котором выдаётся роль.
//  Роль - Строка - роль на пуле (необязательный, по умолчанию "owner").
//
// Возвращаемое значение:
//  Пользователь - учётка, получившая роль.
//
Функция УчёткаСРолью(Знач ПулИлиИдентификатор, Знач Роль = "owner") Экспорт

	Хозяин = Учётка();
	РольВПуле(ПулИлиИдентификатор, Хозяин, Роль);

	Возврат Хозяин;

КонецФункции

// Выдаёт субъекту роль на пуле строкой в хранилище участников.
//
// Параметры:
//  ПулИлиИдентификатор - Пул, Число - пул, на котором выдаётся роль.
//  СубъектИлиИдентификатор - Пользователь, Число - кому выдаётся роль.
//  Роль - Строка - owner, publisher либо reader (необязательный, по умолчанию "owner").
//  ТипСубъекта - Строка - «пользователь» либо «группа» (необязательный, по умолчанию
//                «пользователь»).
//
// Возвращаемое значение:
//  УчастникПула - сохранённая строка участия.
//
Функция РольВПуле(Знач ПулИлиИдентификатор, Знач СубъектИлиИдентификатор,
	Знач Роль = "owner", Знач ТипСубъекта = "пользователь") Экспорт

	Запись = Желудь("ХранилищеУчастниковПула").СоздатьЭлемент();
	Запись.ПулИдентификатор = Идентификатор(ПулИлиИдентификатор);
	Запись.ТипСубъекта = ТипСубъекта;
	Запись.СубъектИдентификатор = Идентификатор(СубъектИлиИдентификатор);
	Запись.Роль = Роль;
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

// Выдаёт грант права строкой в хранилище прав доступа. Действия называются по одному:
// «читать можно, удалять нельзя» — это и есть смысл гранта, умолчания тут прячут сценарий.
//
// Параметры:
//  СубъектИлиИдентификатор - Пользователь, Число - кому выдаётся право.
//  ТипОбъекта - Строка - хаб, пул либо пакет.
//  ОбъектИдентификатор - Число - объект права; 0 — уровень «хаб».
//  Действия - Структура - создание, изменение, удаление, чтение (см. Действия()).
//  ТипСубъекта - Строка - «пользователь» либо «группа» (необязательный, по умолчанию
//                «пользователь»).
//
// Возвращаемое значение:
//  ПравоДоступа - сохранённая строка гранта.
//
Функция Грант(Знач СубъектИлиИдентификатор, Знач ТипОбъекта, Знач ОбъектИдентификатор,
	Знач Действия, Знач ТипСубъекта = "пользователь") Экспорт

	Запись = Желудь("ХранилищеПравДоступа").СоздатьЭлемент();
	Запись.ТипСубъекта = ТипСубъекта;
	Запись.СубъектИдентификатор = Идентификатор(СубъектИлиИдентификатор);
	Запись.ТипОбъекта = ТипОбъекта;
	Запись.ОбъектИдентификатор = Цел(ОбъектИдентификатор);
	Запись.Создание = Действия.создание;
	Запись.Изменение = Действия.изменение;
	Запись.Удаление = Действия.удаление;
	Запись.Чтение = Действия.чтение;
	Запись.КемВыдано = 0;
	Запись.Выдано = ТекущаяУниверсальнаяДата();
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

// Набор действий гранта.
//
// Параметры:
//  Создание - Булево - право заводить.
//  Изменение - Булево - право менять.
//  Удаление - Булево - право сносить.
//  Чтение - Булево - право читать.
//
// Возвращаемое значение:
//  Структура - создание, изменение, удаление, чтение.
//
Функция Действия(Знач Создание, Знач Изменение, Знач Удаление, Знач Чтение) Экспорт

	Возврат Новый Структура("создание, изменение, удаление, чтение",
		Создание, Изменение, Удаление, Чтение);

КонецФункции

// Заводит персональный ключ доступа строкой в хранилище токенов. Хеш непустой: ключ
// с пустым хешом не совпадёт ни с одним предъявленным секретом, и гейт ключа отобьёт
// его раньше, чем набор дойдёт до своей проверки.
//
// Параметры:
//  ВладелецИлиИдентификатор - Пользователь, Число - хозяин ключа.
//  Права - Строка - строка-скоуп, например «read» или «publish» (необязательный,
//          по умолчанию "read").
//  ПулИдентификатор - Число - рамка одного пула; 0 — ключ на весь хаб (необязательный,
//                     по умолчанию 0).
//  Имя - Строка - имя ключа в списках кабинета (необязательный, по умолчанию
//        "ключ доступа").
//  Истекает - Дата - момент истечения; пустая дата — бессрочный ключ (необязательный,
//             по умолчанию бессрочный).
//
// Возвращаемое значение:
//  ТокенДоступа - сохранённая строка ключа.
//
Функция Ключ(Знач ВладелецИлиИдентификатор, Знач Права = "read",
	Знач ПулИдентификатор = 0, Знач Имя = "ключ доступа",
	Знач Истекает = '00010101') Экспорт

	Запись = Желудь("ХранилищеТокенов").СоздатьЭлемент();
	Запись.ПользовательИдентификатор = Идентификатор(ВладелецИлиИдентификатор);
	Запись.Префикс = УникальныеИмена.Имя("pfx");
	Запись.Имя = Имя;
	Запись.Хеш = "hash";
	Запись.Права = Права;
	Запись.ПулИдентификатор = Цел(ПулИдентификатор);
	Запись.Истекает = Истекает;
	Запись.Создан = ТекущаяУниверсальнаяДата();
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

#КонецОбласти

#Область УчёткиСлужбамиХаба

// Заводит учётку руками хаба — СервисПользователей, как это делает регистрация. Учётка
// получает канон логина, проверку резерва и занятости имени и настоящий хеш пароля.
// Строка, положенная в таблицу напрямую, ничего этого не имеет, и набор, проверяющий
// на ней вход паролем, оставался бы на ней зелёным молча.
//
// Параметры:
//  РольХаба - Строка - admin либо user (необязательный, по умолчанию "user").
//  Логин - Строка - логин (необязательный, по умолчанию "" — свободный «u-N-соль»).
//  Пароль - Строка - пароль учётки (необязательный, по умолчанию "TestPassw0rd").
//  Email - Строка - адрес почты (необязательный, по умолчанию "" — «<логин>@example.com»).
//
// Возвращаемое значение:
//  Пользователь - заведённая учётка.
//
Функция УчёткаСлужбой(Знач РольХаба = "user", Знач Логин = "",
	Знач Пароль = "TestPassw0rd", Знач Email = "") Экспорт

	ИмяВхода = ?(ЗначениеЗаполнено(Логин), Логин, УникальныеИмена.Имя("u"));

	Возврат Желудь("СервисПользователей").СоздатьПользователя(ИмяВхода,
		?(ЗначениеЗаполнено(Email), Email, ИмяВхода + "@example.com"), Пароль, РольХаба);

КонецФункции

#КонецОбласти

#Область Служебное

Функция Желудь(Знач Имя)
	Возврат Контейнер.НайтиЖелудь(Имя);
КонецФункции

// Пул и субъект называются набору либо записью, либо своим идентификатором — удобны оба.
Функция Идентификатор(Знач ЗаписьИлиЧисло)

	Если ТипЗнч(ЗаписьИлиЧисло) = Тип("Число") Тогда
		Возврат Цел(ЗаписьИлиЧисло);
	КонецЕсли;

	Возврат Цел(ЗаписьИлиЧисло.Идентификатор);

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач Поделка)
	Контейнер = Поделка;
КонецПроцедуры
