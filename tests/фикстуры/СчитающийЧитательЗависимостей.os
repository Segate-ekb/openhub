// Обёртка ХранилищаЗависимостей, считающая обращения к нему: сами строки отдаёт настоящее
// хранилище, счёт нужен там, где цена уборки росла числом версий.

Перем Хранилище;   // ХранилищеЗависимостей — настоящий источник строк
Перем Счётчик;     // СчётчикОбращений — счёт обращений к хранилищу

// Сколько раз хранилище спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Контракт ХранилищаЗависимостей: зависимости одной версии; считает обращение.
//
// Параметры:
//  ВерсияИдентификатор - Число - идентификатор версии.
//
// Возвращаемое значение:
//  Массив из ЗависимостьВерсии.
//
Функция ПоВерсии(Знач ВерсияИдентификатор) Экспорт
	Счётчик.Отметить();
	Возврат Хранилище.ПоВерсии(ВерсияИдентификатор);
КонецФункции

// Контракт ХранилищаЗависимостей: зависимости перечисленных версий; считает обращение.
//
// Параметры:
//  ВерсияИдентификаторы - Массив из Число - идентификаторы версий.
//
// Возвращаемое значение:
//  Массив из ЗависимостьВерсии.
//
Функция ПоВерсиям(Знач ВерсияИдентификаторы) Экспорт
	Счётчик.Отметить();
	Возврат Хранилище.ПоВерсиям(ВерсияИдентификаторы);
КонецФункции

Процедура ПриСозданииОбъекта(Знач НастоящееХранилище)
	Хранилище = НастоящееХранилище;
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
