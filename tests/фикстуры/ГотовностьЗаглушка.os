// Заглушка гейтов готовности: принимает заявки и отметки, ничего не проверяя.
// Нужна там, где проверяется поведение подписчика, а не признак готовности хаба.

Перем Задачи;

// Контракт ГотовностьХаба: заявка обязательной стартовой задачи.
//
// Параметры:
//  Имя - Строка - имя задачи.
//
Процедура ЗаявитьЗадачу(Знач Имя) Экспорт
	Задачи.Вставить(Имя, Ложь);
КонецПроцедуры

// Контракт ГотовностьХаба: отметка выполнения стартовой задачи.
//
// Параметры:
//  Имя - Строка - имя задачи.
//
Процедура ОтметитьЗадачуВыполненной(Знач Имя) Экспорт
	Задачи.Вставить(Имя, Истина);
КонецПроцедуры

// Отработала ли заявленная задача.
//
// Параметры:
//  Имя - Строка - имя задачи.
//
// Возвращаемое значение:
//  Булево.
//
Функция Выполнена(Знач Имя) Экспорт
	Возврат Задачи.Получить(Имя) = Истина;
КонецФункции

Процедура ПриСозданииОбъекта()
	Задачи = Новый Соответствие();
КонецПроцедуры
