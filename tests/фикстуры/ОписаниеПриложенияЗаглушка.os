// Заглушка ОписаниеПриложения: своя версия хаба задаётся тестом, а не читается из packagedef.

Перем Версия_;

// Имя приложения.
//
// Возвращаемое значение:
//  Строка.
//
Функция Имя() Экспорт
	Возврат "openhub";
КонецФункции

// Версия приложения — та, что задал тест.
//
// Возвращаемое значение:
//  Строка.
//
Функция Версия() Экспорт
	Возврат Версия_;
КонецФункции

// Задаёт версию приложения.
//
// Параметры:
//  Версия - Строка - версия semver.
//
Процедура УстановитьВерсию(Знач Версия) Экспорт
	Версия_ = Версия;
КонецПроцедуры

// Параметры:
//  Версия - Строка - версия semver (необязательный, по умолчанию «0.20.6»).
//
Процедура ПриСозданииОбъекта(Знач Версия = "0.20.6")
	Версия_ = Версия;
КонецПроцедуры
