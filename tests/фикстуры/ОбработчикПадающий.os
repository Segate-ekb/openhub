// Обработчик, всегда бросающий исключение — для теста изоляции ошибок планировщика.

Перем Вызовов_;

// Считает вызов и всегда бросает исключение.
//
Процедура Исполнить() Экспорт
	Вызовов_ = Вызовов_ + 1;
	ВызватьИсключение "ОбработчикПадающий: намеренный сбой задачи";
КонецПроцедуры

// Сколько раз звали Исполнить().
//
// Возвращаемое значение:
//  Число - количество вызовов.
//
Функция Вызовов() Экспорт
	Возврат Вызовов_;
КонецФункции

Процедура ПриСозданииОбъекта()
	Вызовов_ = 0;
КонецПроцедуры
