// Заглушка ПроксиTelegram для транспорта Bot API: прокси настоящий (локальный слушатель),
// а вычёркивание секретов оставляет в тексте метку — по ней видно, что его вообще звали.

Перем Сервер;
Перем Порт;
Перем Метка;

// Контракт ПроксиTelegram: прокси для обращения к Bot API.
//
// Возвращаемое значение:
//  ИнтернетПрокси - прокси на заданный конструктором адрес.
//
Функция Соединение() Экспорт

	Прокси = Новый ИнтернетПрокси();
	Прокси.Установить("https", Сервер, Порт, "", "", Ложь);
	Возврат Прокси;

КонецФункции

// Контракт ПроксиTelegram: текст без секретов прокси. Вместо вычёркивания — метка:
// не позови её транспорт, метки в тексте отказа не окажется.
//
// Параметры:
//  Текст - Строка - диагностическое сообщение.
//
// Возвращаемое значение:
//  Строка - текст с меткой.
//
Функция БезСвоихСекретов(Знач Текст) Экспорт
	Возврат Строка(Текст) + " " + Метка;
КонецФункции

// Метка, которую заглушка приписывает к тексту.
//
// Возвращаемое значение:
//  Строка.
//
Функция МеткаВычёркивания() Экспорт
	Возврат Метка;
КонецФункции

Процедура ПриСозданииОбъекта(Знач АдресСервера, Знач НомерПорта)

	Сервер = Строка(АдресСервера);
	Порт = НомерПорта;
	Метка = "[секреты-прокси-вычеркнуты]";

КонецПроцедуры
