// Хранилище артефактов-обёртка: делегирует настоящему и считает обращения по дверям.
// На S3 каждое такое обращение — сетевой запрос, и сторож цены обхода считает именно их.
// Умеет отказать в описи тем же машинным кодом, каким отказывает лежащий S3.

#Использовать errors

Перем Настоящий;
Перем Счётчик;       // СчётчикОбращений — счёт по дверям хранилища
Перем ОписьЛомается; // Булево - опись отказывает, как недоступное хранилище

#Область Счётчики

// Сколько раз обход сходил в хранилище: вопросы «лежит ли» плюс описи.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.ОбращенийВ("Существует") + Счётчик.ОбращенийВ("Опись");
КонецФункции

// Счёт по дверям: Существует, Опись.
//
// Возвращаемое значение:
//  Структура - имя двери -> число обращений.
//
Функция ПоДверям() Экспорт
	Возврат Счётчик.ПоДверям("Существует, Опись");
КонецФункции

// Обнуляет счёт: сторож меряет один обход, а не весь набор.
//
Процедура Обнулить() Экспорт
	Счётчик.Обнулить();
КонецПроцедуры

// Дальше опись отказывает кодом «зависимость недоступна» — так отвечает лежащий S3.
//
Процедура ЛоматьОпись() Экспорт
	ОписьЛомается = Истина;
КонецПроцедуры

#КонецОбласти

#Область КонтрактХранилищаАртефактов

// Контракт ХранилищаАртефактов; считает вопрос «лежит ли».
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта.
//
// Возвращаемое значение:
//  Булево.
//
Функция Существует(Знач Координаты) Экспорт
	Счётчик.Отметить("Существует");
	Возврат Настоящий.Существует(Координаты);
КонецФункции

// Контракт ХранилищаАртефактов; считает опись.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Массив из Структура - Пул, Пакет, ИмяФайла, Размер, Изменён.
//
Функция Опись(Знач ИмяПула) Экспорт
	Счётчик.Отметить("Опись");
	Если ОписьЛомается Тогда
		ВызватьИсключение СтандартныеОшибки.ЗависимостьНедоступна("s3://проба",
			"Хранилище артефактов: опись не отвечает");
	КонецЕсли;
	Возврат Настоящий.Опись(ИмяПула);
КонецФункции

// Контракт ХранилищаАртефактов.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта.
//  Источник - Произвольный - путь к файлу либо двоичные данные.
//
// Возвращаемое значение:
//  Структура - Размер, Sha256.
//
Функция Сохранить(Знач Координаты, Знач Источник) Экспорт
	Возврат Настоящий.Сохранить(Координаты, Источник);
КонецФункции

// Контракт ХранилищаАртефактов.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта.
//
// Возвращаемое значение:
//  Число.
//
Функция Размер(Знач Координаты) Экспорт
	Возврат Настоящий.Размер(Координаты);
КонецФункции

// Контракт ХранилищаАртефактов.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта.
//  ОжидаемыйSha256 - Строка - сумма для сверки.
//
// Возвращаемое значение:
//  Строка - путь к файлу.
//
Функция Получить(Знач Координаты, Знач ОжидаемыйSha256 = "") Экспорт
	Возврат Настоящий.Получить(Координаты, ОжидаемыйSha256);
КонецФункции

// Контракт ХранилищаАртефактов.
//
// Параметры:
//  Путь - Строка - путь, выданный методом Получить.
//
Процедура ОсвободитьВыдачу(Знач Путь) Экспорт
	Настоящий.ОсвободитьВыдачу(Путь);
КонецПроцедуры

// Контракт ХранилищаАртефактов.
//
// Параметры:
//  Координаты - КоординатыАртефакта - адрес артефакта.
//
Процедура Удалить(Знач Координаты) Экспорт
	Настоящий.Удалить(Координаты);
КонецПроцедуры

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач НастоящееХранилище)
	Настоящий = НастоящееХранилище;
	Счётчик = Новый СчётчикОбращений();
	ОписьЛомается = Ложь;
КонецПроцедуры
