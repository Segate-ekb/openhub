// Фейк СервисаВходаCLI: заведение заявки падает по требованию теста. Нужен там, где
// проверяется ответ контроллера на сбой домена, а не сам поток входа CLI.

Перем Падать Экспорт;  // Булево — НачатьЗаявку бросает исключение

#Область КонтрактСервисаВходаCLI

// Контракт СервисВходаCLI: каноничная запись запрошенных прав.
//
// Параметры:
//  Права - Строка - права, как их прислал клиент.
//
// Возвращаемое значение:
//  Строка - те же права; фейк ничего не отбраковывает.
//
Функция НормализоватьПрава(Знач Права) Экспорт
	Возврат СокрЛП(Строка(Права));
КонецФункции

// Контракт СервисВходаCLI: заводит заявку входа.
//
// Параметры:
//  ИмяКлиента - Строка - как представился клиент.
//  Права - Строка - запрошенные права.
//
// Возвращаемое значение:
//  Структура - КодУстройства, КодПользователя.
//
Функция НачатьЗаявку(Знач ИмяКлиента = "", Знач Права = "read") Экспорт

	Если Падать Тогда
		ВызватьИсключение "Не удалось подобрать свободный код входа CLI";
	КонецЕсли;

	Возврат Новый Структура("КодУстройства, КодПользователя", "dev-код", "AAAA-BBBB");

КонецФункции

// Контракт СервисВходаCLI: срок жизни заявки.
//
// Возвращаемое значение:
//  Число - секунды.
//
Функция СрокЖизниСек() Экспорт
	Возврат 600;
КонецФункции

// Контракт СервисВходаCLI: с каким интервалом клиенту опрашивать хаб.
//
// Возвращаемое значение:
//  Число - секунды.
//
Функция ИнтервалОпросаСек() Экспорт
	Возврат 5;
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач ПадатьНаЗаявке = Ложь) Экспорт
	Падать = ПадатьНаЗаявке;
КонецПроцедуры
