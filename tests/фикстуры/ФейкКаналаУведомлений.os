// Фейк СлужбыЛичныхУведомлений: обращения к человеку складываются в память. Нужен там,
// где проверяется домен, а не канал: тянуть ради одного вызова ленту, почту и настройки
// инсталляции дороже, чем подменить дверь.

Перем Обращения; // Массив из Структура - всё, что «отправлено» человеку
Перем Каталог;   // ПоводыУведомлений - настоящий перечень поводов

#Область КонтрактКанала

// Контракт СлужбаЛичныхУведомлений: «сообщает» человеку о событии.
//
// Параметры:
//  Пользователь - Пользователь, Неопределено - адресат.
//  Повод - Строка - повод из ПоводыУведомлений.
//  Заголовок - Строка - о чём событие.
//  Текст - Строка - подробности события.
//  Ссылка - Строка - куда ведёт событие (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - Записано, Отправлено, Причина.
//
Функция Уведомить(Знач Пользователь, Знач Повод, Знач Заголовок, Знач Текст,
	Знач Ссылка = "") Экспорт

	Обращения.Добавить(Новый Структура("Логин, Повод, Заголовок, Текст, Ссылка",
		?(Пользователь = Неопределено, "", Строка(Пользователь.Логин)),
		Строка(Повод), Строка(Заголовок), Строка(Текст), Строка(Ссылка)));

	Возврат Новый Структура("Записано, Отправлено, Причина", Истина, Ложь, "");

КонецФункции

// Контракт СлужбаЛичныхУведомлений: «шлёт» письмо с одноразовой ссылкой.
//
// Параметры:
//  Пользователь - Пользователь - адресат.
//  Повод - Строка - повод из ПоводыУведомлений.
//  Тема - Строка - тема письма.
//  Текст - Строка - тело письма.
//
// Возвращаемое значение:
//  Структура - Отправлено, Причина.
//
Функция ПисьмоСоСсылкой(Знач Пользователь, Знач Повод, Знач Тема, Знач Текст) Экспорт

	Обращения.Добавить(Новый Структура("Логин, Повод, Заголовок, Текст, Ссылка",
		Строка(Пользователь.Логин), Строка(Повод), Строка(Тема), Строка(Текст), ""));

	Возврат Новый Структура("Отправлено, Причина", Истина, "");

КонецФункции

// Контракт СлужбаЛичныхУведомлений: почта фейка всегда готова.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПочтаНастроена() Экспорт
	Возврат Истина;
КонецФункции

// Контракт СлужбаЛичныхУведомлений: настоящий перечень поводов.
//
// Возвращаемое значение:
//  ПоводыУведомлений.
//
Функция Поводы() Экспорт
	Возврат Каталог;
КонецФункции

#КонецОбласти

#Область Наблюдение

// Все обращения к человеку.
//
// Возвращаемое значение:
//  Массив из Структура.
//
Функция Все() Экспорт
	Возврат Обращения;
КонецФункции

// Последнее обращение.
//
// Возвращаемое значение:
//  Структура, Неопределено.
//
Функция Последнее() Экспорт
	Возврат ?(Обращения.Количество() = 0, Неопределено, Обращения[Обращения.ВГраница()]);
КонецФункции

// Сколько раз хаб обратился к человеку.
//
// Возвращаемое значение:
//  Число.
//
Функция Количество() Экспорт
	Возврат Обращения.Количество();
КонецФункции

// Забывает все обращения.
Процедура Очистить() Экспорт
	Обращения.Очистить();
КонецПроцедуры

#КонецОбласти

&Прозвище("СлужбаЛичныхУведомлений")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ПоводыУведомлений") _Каталог)

	Обращения = Новый Массив();
	Каталог = _Каталог;

КонецПроцедуры
