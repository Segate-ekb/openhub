// Пробный тип действия подписки: реализует все три контракта точки расширения
// (доставка · хранение · рендер настроек). Настраивается конструктором.

Перем Тип_;
Перем ИмяПоля_;
Перем Обязательное_;

Перем Доставленные Экспорт; // Массив заданий, дошедших до Доставить

#Область КонтрактОбработчикаДоставки

// Контракт точки расширения: тип действия.
//
// Возвращаемое значение:
//  Строка - тип, заданный конструктором.
//
Функция ТипДействия() Экспорт
	Возврат Тип_;
КонецФункции

// Контракт доставки: проверка задания перед отправкой.
//
// Параметры:
//  Задание - Структура - задание очереди доставки.
//
// Возвращаемое значение:
//  Структура - Ок (Булево), Ошибка (Строка); пробный тип всегда пропускает.
//
Функция ПередДоставкой(Знач Задание) Экспорт
	Возврат Новый Структура("Ок, Ошибка", Истина, "");
КонецФункции

// Контракт доставки: «отправляет» задание, накапливая его в Доставленные.
//
// Параметры:
//  Задание - Структура - задание очереди доставки.
//
// Возвращаемое значение:
//  Булево - всегда Истина.
//
Функция Доставить(Знач Задание) Экспорт
	Доставленные.Добавить(Задание);
	Возврат Истина;
КонецФункции

#КонецОбласти

#Область КонтрактХранения

// Контракт хранения: превращает доменный ввод формы в поля подписки.
//
// Параметры:
//  Ввод - Структура - доменный ввод формы.
//
// Возвращаемое значение:
//  Структура - Адрес, Секрет, НастройкиДействия; пустое обязательное значение — исключение.
//
Функция ПодготовитьНастройки(Знач Ввод) Экспорт

	Значение = "";
	Ввод.Свойство(ИмяСвойстваВвода(), Значение);
	Если Обязательное_ И НЕ ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение "Пробный тип действия: пустое значение";
	КонецЕсли;
	Возврат Новый Структура("Адрес, Секрет, НастройкиДействия", Строка(Значение), "", "");

КонецФункции

// Контракт хранения: настройки доставки из записи подписки.
//
// Параметры:
//  Подписка - Произвольный - запись подписки.
//
// Возвращаемое значение:
//  Структура - Адрес.
//
Функция НастройкиДоставки(Знач Подписка) Экспорт
	Возврат Новый Структура("Адрес", Строка(Подписка.URL));
КонецФункции

#КонецОбласти

#Область КонтрактРендераНастроек

// Контракт рендера настроек: ключ словаря для подписи поля.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючПодписи() Экспорт
	Возврат "probe.action." + Тип_ + ".label";
КонецФункции

// Контракт рендера настроек: ключ словаря для пояснения; у пробного типа пуст.
//
// Возвращаемое значение:
//  Строка.
//
Функция КлючПояснения() Экспорт
	Возврат "";
КонецФункции

// Имя свойства доменного ввода — то же, что имя поля формы.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяСвойстваВвода() Экспорт
	Возврат ИмяПоля_;
КонецФункции

// Контракт рендера настроек: декларация полей формы.
//
// Возвращаемое значение:
//  Массив из Структура - Имя, ИмяПоля, КлючПодписи, КлючПодсказки, КлючПлейсхолдера,
//  Обязательное, Секретное.
//
Функция ОписаниеПолей() Экспорт

	Поля = Новый Массив();
	Поля.Добавить(Новый Структура(
		"Имя, ИмяПоля, КлючПодписи, КлючПодсказки, КлючПлейсхолдера, Обязательное, Секретное",
		ИмяПоля_, ИмяПоля_, КлючПодписи(), "", "", Обязательное_, Ложь));
	Возврат Поля;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач Тип, Знач ИмяПоля, Знач Обязательное = Истина)

	Тип_ = Тип;
	ИмяПоля_ = ИмяПоля;
	Обязательное_ = Обязательное;
	Доставленные = Новый Массив();

КонецПроцедуры
