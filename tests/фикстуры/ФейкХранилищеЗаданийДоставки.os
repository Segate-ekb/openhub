// Фейковое хранилище заданий доставки в памяти: контракт ХранилищаЗаданийДоставки
// без autumn-data и БД. Переживает пересоздание очереди — этим и проверяется, что
// незавершённое доживает до следующего запуска процесса.
//
// Выдаёт и принимает СНИМКИ, а не живые объекты: правка записи, не доведённая
// до Сохранить(), теряется так же, как в настоящей базе. Иначе фейк доказывал бы
// хранение там, где его нет.

Перем Записи;
Перем СледИд;
Перем Чтений;

// Контракт репозитория: новая несохранённая запись, привязанная к этому хранилищу.
//
// Возвращаемое значение:
//  ФейкЗаданиеДоставкиЗапись.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Новый ФейкЗаданиеДоставкиЗапись(ЭтотОбъект);
КонецФункции

// Приём записи от Запись.Сохранить(): новой присваивает идентификатор, известную
// перезаписывает по идентификатору.
//
// Параметры:
//  Запись - ФейкЗаданиеДоставкиЗапись - сохраняемая запись.
//
Процедура Принять(Знач Запись) Экспорт

	Если Запись.Идентификатор = 0 Тогда
		Запись.Идентификатор = СледИд;
		СледИд = СледИд + 1;
		Записи.Добавить(Снимок(Запись));
		Возврат;
	КонецЕсли;

	Хранимая = ПоИдентификатору(Запись.Идентификатор);
	Если Хранимая <> Неопределено Тогда
		ПеренестиПоля(Запись, Хранимая);
	КонецЕсли;

КонецПроцедуры

// Контракт репозитория: все записи таблицы (снимками).
//
// Возвращаемое значение:
//  Массив из ФейкЗаданиеДоставкиЗапись.
//
Функция Все() Экспорт
	Чтений = Чтений + 1;
	Результат = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Результат.Добавить(Снимок(Запись));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Контракт репозитория: удаляет запись по идентификатору. Отсутствие записи не ошибка.
//
// Параметры:
//  Запись - ФейкЗаданиеДоставкиЗапись - удаляемая запись.
//
Процедура Удалить(Знач Запись) Экспорт
	Хранимая = ПоИдентификатору(Запись.Идентификатор);
	Если Хранимая <> Неопределено Тогда
		Записи.Удалить(Записи.Найти(Хранимая));
	КонецЕсли;
КонецПроцедуры

// Сколько раз хранилище читали целиком: постановка в очередь обязана быть дешёвой.
//
// Возвращаемое значение:
//  Число - число вызовов Все().
//
Функция ЧтенийТаблицы() Экспорт
	Возврат Чтений;
КонецФункции

Функция ПоИдентификатору(Знач Идентификатор)
	Для Каждого Запись Из Записи Цикл
		Если Запись.Идентификатор = Цел(Идентификатор) Тогда
			Возврат Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция Снимок(Знач Источник)
	Копия = Новый ФейкЗаданиеДоставкиЗапись(ЭтотОбъект);
	Копия.Идентификатор = Источник.Идентификатор;
	ПеренестиПоля(Источник, Копия);
	Возврат Копия;
КонецФункции

Процедура ПеренестиПоля(Знач Источник, Приёмник)
	Приёмник.ИдДоставки = Источник.ИдДоставки;
	Приёмник.ТипДействия = Источник.ТипДействия;
	Приёмник.НастройкиJSON = Источник.НастройкиJSON;
	Приёмник.ТипСобытия = Источник.ТипСобытия;
	Приёмник.Тело = Источник.Тело;
	Приёмник.НомерПопытки = Источник.НомерПопытки;
	Приёмник.НеРанее = Источник.НеРанее;
	Приёмник.Поставлено = Источник.Поставлено;
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	СледИд = 1;
	Чтений = 0;
КонецПроцедуры
