// Фейк ВалидатораАдресаАпстрима: вердикт задаётся тестом и может меняться между вызовами —
// так проверяется, что страж судит адрес заново, а не отдаёт запомненный ответ.

Перем Ок_;
Перем Ошибка_;
Перем Вызовов_;

// Задаёт вердикт на последующие проверки.
//
// Параметры:
//  Разрешено - Булево - каким будет Ок.
//  Ошибка - Строка - причина отказа (необязательный, по умолчанию "приватный адрес").
//
Процедура Отвечать(Знач Разрешено, Знач Ошибка = "приватный адрес") Экспорт
	Ок_ = Разрешено;
	Ошибка_ = Ошибка;
КонецПроцедуры

// Сколько раз у валидатора спросили вердикт.
//
// Возвращаемое значение:
//  Число - количество вызовов Проверить.
//
Функция Вызовов() Экспорт
	Возврат Вызовов_;
КонецФункции

// Контракт ВалидатораАдресаАпстрима.
//
// Параметры:
//  URL - Строка - проверяемый адрес.
//  РазрешитьПриватные - Булево - флаг интранета (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура - Ок (Булево), Ошибка (Строка).
//
Функция Проверить(Знач URL, Знач РазрешитьПриватные = Ложь) Экспорт
	Вызовов_ = Вызовов_ + 1;
	Возврат Новый Структура("Ок, Ошибка", Ок_, ?(Ок_, "", Ошибка_));
КонецФункции

// Контракт ВалидатораАдресаАпстрима: судейство без резолва имени.
//
// Параметры:
//  URL - Строка - проверяемый адрес.
//
// Возвращаемое значение:
//  Структура - Ок (Булево), Ошибка (Строка).
//
Функция ПроверитьБезРезолва(Знач URL) Экспорт
	Возврат Проверить(URL, Ложь);
КонецФункции

Процедура ПриСозданииОбъекта()
	Ок_ = Истина;
	Ошибка_ = "приватный адрес";
	Вызовов_ = 0;
КонецПроцедуры
