// СервисПулов в памяти для сторожей дешевизны публичной части: считает обращения и отдаёт
// пулы, отвечающие «личное ли это пространство» — сводка лендинга их различает.
// Обе двери за именами пулов — «пул по идентификатору» и «пулы по списку» — у настоящей
// службы стоят одного запроса каждая, поэтому счёт вызовов здесь и есть счёт запросов экрана.

Перем Пулы;   // Соответствие: идентификатор -> РазрезПул
Перем СчётОбращений;

// Сколько раз службу спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат СчётОбращений;
КонецФункции

// Заводит пул (наполнение фикстуры; за обращение не считается).
//
// Параметры:
//  Идентификатор - Число - идентификатор пула.
//  Имя - Строка - имя пула.
//  Личный - Булево - личное ли это пространство (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  РазрезПул - заведённый пул.
//
Функция ДобавитьПул(Знач Идентификатор, Знач Имя, Знач Личный = Ложь) Экспорт

	Пул = Новый РазрезПул(Идентификатор, Имя, Личный);
	Пулы.Вставить(Цел(Идентификатор), Пул);
	Возврат Пул;

КонецФункции

// Все пулы хаба; считает обращение.
//
// Возвращаемое значение:
//  Массив из РазрезПул.
//
Функция ВсеПулы() Экспорт

	СчётОбращений = СчётОбращений + 1;

	Результат = Новый Массив();
	Для Каждого КиЗ Из Пулы Цикл
		Результат.Добавить(КиЗ.Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пул по идентификатору; считает обращение. Дверь, через которую цена страницы росла
// числом её строк.
//
// Параметры:
//  Идентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  РазрезПул, Неопределено.
//
Функция ПулПоИдентификатору(Знач Идентификатор) Экспорт
	СчётОбращений = СчётОбращений + 1;
	Возврат Пулы.Получить(Цел(Идентификатор));
КонецФункции

// Пулы перечисленных идентификаторов; считает обращение.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пулов.
//
// Возвращаемое значение:
//  Соответствие - ключ Число, значение РазрезПул; ненайденных ключей в нём нет.
//
Функция ПулыПоИдентификаторам(Знач Идентификаторы) Экспорт

	СчётОбращений = СчётОбращений + 1;

	Результат = Новый Соответствие();
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Пул = Пулы.Получить(Цел(Идентификатор));
		Если Пул <> Неопределено Тогда
			Результат.Вставить(Цел(Идентификатор), Пул);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пулы страницы по её пакетам; считает обращение.
//
// Параметры:
//  Пакеты - Массив - пакеты страницы; у каждого читается ПулИдентификатор.
//
// Возвращаемое значение:
//  Соответствие - ключ Число, значение РазрезПул.
//
Функция ПулыПакетов(Знач Пакеты) Экспорт

	Идентификаторы = Новый Массив();
	Для Каждого Пакет Из Пакеты Цикл
		Идентификаторы.Добавить(Цел(Пакет.ПулИдентификатор));
	КонецЦикла;
	Возврат ПулыПоИдентификаторам(Идентификаторы);

КонецФункции

Процедура ПриСозданииОбъекта()
	Пулы = Новый Соответствие();
	СчётОбращений = 0;
КонецПроцедуры
