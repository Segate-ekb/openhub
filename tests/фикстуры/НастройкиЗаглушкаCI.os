// Заглушка СервисаНастроек для стража издателей: отдаёт одно значение по ключу.

Перем Значения;

// Задаёт значение настройки.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//  Значение - Строка - значение.
//
Процедура Задать(Знач Ключ, Знач Значение) Экспорт
	Значения.Вставить(Ключ, Значение);
КонецПроцедуры

// Значение настройки по ключу.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - значение либо "".
//
Функция Значение(Знач Ключ) Экспорт
	Найдено = Значения.Получить(Ключ);
	Возврат ?(Найдено = Неопределено, "", Найдено);
КонецФункции

Процедура ПриСозданииОбъекта()
	Значения = Новый Соответствие();
КонецПроцедуры
