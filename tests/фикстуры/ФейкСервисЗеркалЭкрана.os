// Фейк СервисаЗеркал для тестов экранов: список зеркал пула задаётся тестом, базы нет.
// Отдельно от фейка со стороны синхронизатора: поверхности службы у них разные.

Перем Зеркала;
Перем Режимы;
Перем Заявки;  // Массив из Структура — вызовы ПоставитьПрогон в порядке поступления
Перем Брошен_; // Булево — вердикт «прогон брошен», задаётся тестом

// Зеркала пула назначения.
//
// Параметры:
//  ПулНазначенияИдентификатор - Число - идентификатор пула назначения, не используется.
//
// Возвращаемое значение:
//  Массив - заданные тестом зеркала.
//
Функция СписокПула(Знач ПулНазначенияИдентификатор) Экспорт
	ПулНазначенияИдентификатор = ПулНазначенияИдентификатор;
	Возврат Зеркала;
КонецФункции

// Зеркало пула по идентификатору.
//
// Параметры:
//  Пул - Произвольный - пул назначения, не используется.
//  Идентификатор - Число - идентификатор зеркала.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - зеркало с таким идентификатором либо Неопределено.
//
Функция ЗеркалоПула(Знач Пул, Знач Идентификатор) Экспорт

	Пул = Пул;
	Для Каждого Зеркало Из Зеркала Цикл
		Если Цел(Зеркало.Идентификатор) = Цел(Идентификатор) Тогда
			Возврат Зеркало;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Режимы синхронизации, известные движку.
//
// Возвращаемое значение:
//  Массив из Строка - имена режимов.
//
Функция ИзвестныеРежимы() Экспорт
	Возврат Режимы;
КонецФункции

// Контракт службы: пометить прогон зеркала поставленным.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//  Запустил - Строка - логин инициатора (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Булево - Истина: фейк постановку не отклоняет.
//
Функция ПоставитьПрогон(Знач Идентификатор, Знач Запустил = "") Экспорт
	Заявки.Добавить(Новый Структура("Идентификатор, Запустил",
		Цел(Идентификатор), СокрЛП(Строка(Запустил))));
	Возврат Истина;
КонецФункции

// Контракт службы: порог, после которого молчащий прогон считается брошенным.
//
// Возвращаемое значение:
//  Число - секунды.
//
Функция ПорогЗависанияПрогона() Экспорт
	Возврат 900;
КонецФункции

// Контракт службы: ведёт ли прогон зеркала кто-то по записи. Экранным тестам прогон
// прошлого запуска хаба не нужен — всегда Ложь.
//
// Параметры:
//  Идентификатор - Число - идентификатор зеркала.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПрогонИдёт(Знач Идентификатор) Экспорт
	Идентификатор = Идентификатор;
	Возврат Ложь;
КонецФункции

// Контракт службы: брошен ли прогон прочитанной записи. Вердикт задаёт тест —
// так воспроизводится зеркало, чей рабочий умер.
//
// Параметры:
//  Зеркало - Структура - прочитанная запись зеркала.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПрогонБрошен(Знач Зеркало) Экспорт
	Зеркало = Зеркало;
	Возврат Брошен_;
КонецФункции

// Объявляет прогон брошенным: рабочий взял зеркало и молчит дольше порога.
//
// Параметры:
//  Значение - Булево - вердикт (необязательный, по умолчанию Истина).
//
Процедура ЗадатьБрошенныйПрогон(Знач Значение = Истина) Экспорт
	Брошен_ = (Значение = Истина);
КонецПроцедуры

// Заявки на прогон, дошедшие до службы.
//
// Возвращаемое значение:
//  Массив из Структура - Идентификатор (Число), Запустил (Строка).
//
Функция ЗаявкиПрогона() Экспорт
	Возврат Заявки;
КонецФункции

// Задаёт зеркала пула.
//
// Параметры:
//  Список - Массив - зеркала, которые вернёт СписокПула.
//
Процедура Задать(Знач Список) Экспорт
	Зеркала = Список;
КонецПроцедуры

Процедура ПриСозданииОбъекта() Экспорт

	Зеркала = Новый Массив();
	Заявки = Новый Массив();
	Брошен_ = Ложь;
	Режимы = Новый Массив();
	Режимы.Добавить("opm");

КонецПроцедуры
