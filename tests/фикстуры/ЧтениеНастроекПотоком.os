// Обработчик фонового задания для нагрузочного смока настроек: читает одни и те же ключи
// по кругу и запоминает первую жалобу — сбой чтения либо значение, разошедшееся с ожидаемым.
// Своего утверждения не делает: судит набор, собрав жалобы всех потоков.

Перем Настройки;  // СервисНастроек
Перем Ожидания;   // Соответствие: ключ -> действующее значение, которое обязан видеть любой поток
Перем Кругов;     // Число - сколько раз пройти все ключи
Перем Прочитано;  // Число - успешных чтений
Перем Жалоба;     // Строка - первая жалоба; "" — поток отработал чисто

// Жалоба потока: текст сбоя либо расхождения; пустая строка — читалось ровно ожидаемое.
//
// Возвращаемое значение:
//  Строка - жалоба потока.
//
Функция Жалоба() Экспорт
	Возврат Жалоба;
КонецФункции

// Сколько чтений поток успел сделать без жалоб.
//
// Возвращаемое значение:
//  Число - успешных чтений.
//
Функция Прочитано() Экспорт
	Возврат Прочитано;
КонецФункции

// Контракт обработчика фонового задания.
Процедура Исполнить() Экспорт

	Попытка
		ПрочитатьКруги();
	Исключение
		Пожаловаться("чтение настроек упало: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура ПрочитатьКруги()

	Для Круг = 1 По Кругов Цикл
		Для Каждого КлючИЗначение Из Ожидания Цикл
			Прочитанное = Настройки.Значение(КлючИЗначение.Ключ);
			Если Прочитанное <> КлючИЗначение.Значение Тогда
				Пожаловаться(СтрШаблон("настройка %1 на круге %2: прочитано ""%3"", ожидалось ""%4""",
					КлючИЗначение.Ключ, Круг, Прочитанное, КлючИЗначение.Значение));
				Возврат;
			КонецЕсли;
			Прочитано = Прочитано + 1;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура Пожаловаться(Знач Текст)
	Если НЕ ЗначениеЗаполнено(Жалоба) Тогда
		Жалоба = Текст;
	КонецЕсли;
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач СервисНастроек, Знач ОжидаемыеЗначения, Знач ЧислоКругов)
	Настройки = СервисНастроек;
	Ожидания = ОжидаемыеЗначения;
	Кругов = ЧислоКругов;
	Прочитано = 0;
	Жалоба = "";
КонецПроцедуры
