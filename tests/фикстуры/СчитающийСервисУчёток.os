// СервисПользователей в памяти, считающий обращения. Обе двери на месте: «учётка
// по идентификатору» (через неё цена списка росла числом строк) и разрез по списку.

Перем Учётки;   // Соответствие: идентификатор -> Структура (Идентификатор, Логин)
Перем Счётчик;   // СчётчикОбращений — счёт обращений к фикстуре

// Сколько раз службу спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Заводит учётку (за обращение не считается).
//
// Параметры:
//  Идентификатор - Число - идентификатор учётки.
//  Логин - Строка - логин.
//
// Возвращаемое значение:
//  Структура - заведённая учётка.
//
Функция Добавить(Знач Идентификатор, Знач Логин) Экспорт

	Учётка = Новый Структура("Идентификатор, Логин", Цел(Идентификатор), Логин);
	Учётки.Вставить(Цел(Идентификатор), Учётка);
	Возврат Учётка;

КонецФункции

// Учётка по идентификатору; считает обращение.
//
// Параметры:
//  Идентификатор - Число - идентификатор учётки.
//
// Возвращаемое значение:
//  Структура, Неопределено.
//
Функция ПоИдентификатору(Знач Идентификатор) Экспорт
	Счётчик.Отметить();
	Возврат Учётки.Получить(Цел(Идентификатор));
КонецФункции

// Учётки перечисленных идентификаторов; считает обращение.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы учёток.
//
// Возвращаемое значение:
//  Соответствие - ключ Число, значение Структура; ненайденных ключей в нём нет.
//
Функция ПоИдентификаторам(Знач Идентификаторы) Экспорт

	Счётчик.Отметить();

	Результат = Новый Соответствие();
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Учётка = Учётки.Получить(Цел(Идентификатор));
		Если Учётка <> Неопределено Тогда
			Результат.Вставить(Цел(Идентификатор), Учётка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ПриСозданииОбъекта()
	Учётки = Новый Соответствие();
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
