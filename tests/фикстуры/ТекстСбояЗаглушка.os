// Заглушка ТекстСбоя: отдаёт причину как есть и запоминает, что просили перевести
// человеку. Словаря кита и журнала у неё нет — набору важен сам факт обращения.

Перем Переведённые_;  // Массив из Строка — краткие представления, прошедшие через Человеку

// Причина пойманного сбоя словами человека.
//
// Параметры:
//  Инфо - ИнформацияОбОшибке - пойманное исключение.
//
// Возвращаемое значение:
//  Строка.
//
Функция Человеку(Знач Инфо) Экспорт
	Текст = КраткоеПредставлениеОшибки(Инфо);
	Переведённые_.Добавить(Текст);
	Возврат ПонятныйТекст(Текст);
КонецФункции

// Причина, уже названная доменом словами.
//
// Параметры:
//  Текст - Строка - причина отказа.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПонятныйТекст(Знач Текст) Экспорт
	Возврат ?(ЗначениеЗаполнено(Текст), Строка(Текст), "внутренняя ошибка");
КонецФункции

// Что просили перевести человеку, в порядке обращений.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Переведённые() Экспорт
	Возврат Переведённые_;
КонецФункции

Процедура ПриСозданииОбъекта() Экспорт
	Переведённые_ = Новый Массив();
КонецПроцедуры
