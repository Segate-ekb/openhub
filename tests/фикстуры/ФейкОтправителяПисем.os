// Фейк ОтправителяПисем: письма складываются в память, живого SMTP в тестах нет.
// Умеет падать по требованию — так проверяется поведение хаба при отказе сервера.

Перем Письма;    // Массив из Структура - всё, что «отправлено»
Перем Падать;    // Булево - следующая отправка выбрасывает исключение

// Контракт ОтправительПисем: «отправляет» письмо.
//
// Параметры:
//  Письмо - Структура - Кому, Тема, Текст, ОтКого.
//
Процедура Отправить(Знач Письмо) Экспорт

	Если Падать Тогда
		ВызватьИсключение "Почтовый сервер недоступен (фейк)";
	КонецЕсли;
	Письма.Добавить(Письмо);

КонецПроцедуры

// Все «отправленные» письма.
//
// Возвращаемое значение:
//  Массив из Структура.
//
Функция Все() Экспорт
	Возврат Письма;
КонецФункции

// Последнее «отправленное» письмо.
//
// Возвращаемое значение:
//  Структура, Неопределено.
//
Функция Последнее() Экспорт
	Возврат ?(Письма.Количество() = 0, Неопределено, Письма[Письма.ВГраница()]);
КонецФункции

// Сколько писем «отправлено».
//
// Возвращаемое значение:
//  Число.
//
Функция Количество() Экспорт
	Возврат Письма.Количество();
КонецФункции

// Забывает всё «отправленное».
Процедура Очистить() Экспорт
	Письма.Очистить();
КонецПроцедуры

// Заставляет следующие отправки падать.
//
// Параметры:
//  Значение - Булево - падать ли.
//
Процедура ПадатьНаОтправке(Знач Значение) Экспорт
	Падать = (Значение = Истина);
КонецПроцедуры

&Прозвище("ОтправительПисем")
&Желудь
Процедура ПриСозданииОбъекта()
	Письма = Новый Массив();
	Падать = Ложь;
КонецПроцедуры
