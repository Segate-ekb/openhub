// Пул для сторожей дешевизны публичной части: сводка лендинга считает личные
// пространства отдельно, поэтому пул обязан отвечать, личный ли он, а не только называться.

Перем Идентификатор Экспорт;
Перем Имя Экспорт;
Перем Личный;

// Личное ли это пространство пользователя (тип user).
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоЛичный() Экспорт
	Возврат Личный = Истина;
КонецФункции

Процедура ПриСозданииОбъекта(Знач ЗначениеИд, Знач ЗначениеИмя, Знач ЗначениеЛичный = Ложь)
	Идентификатор = Цел(ЗначениеИд);
	Имя = ЗначениеИмя;
	Личный = (ЗначениеЛичный = Истина);
КонецПроцедуры
