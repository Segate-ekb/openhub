// Фейк шва КлиентS3 — in-memory реализация без сети и без oint. Семантика повторяет КлиентS3Oint:
// запись атомарна, Удалить идемпотентно, чтение отсутствующего — resource.not_found,
// а подставная недоступность хранилища — dependency.unavailable.

#Использовать errors

Перем Объекты;       // Соответствие ключ(Строка) -> Структура(Данные(ДвоичныеДанные), Изменён(Дата))
Перем ПределСтраницы; // Число - предел объектов под ведущим сегментом (0 = без эмуляции лимита)
Перем ОтказНедоступности; // Строка - пояснение недоступности; пусто — хранилище отвечает
Перем ОтказДоступа;       // Строка - пояснение отказа в доступе; пусто — доступ открыт
Перем ТекстОтсутствия;    // Строка - как хранилище формулирует «нет объекта»

// Контракт КлиентаS3: кладёт объект, заменяя прежний целиком.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//  Источник - ДвоичныеДанные, Строка - данные объекта либо путь к файлу.
//
Процедура Положить(Знач Ключ, Знач Источник) Экспорт

	ПроверитьДоступность();

	Запись = Новый Структура("Данные, Изменён", ВБайты(Источник), ТекущаяДата());
	Объекты.Вставить(Ключ, Запись);

КонецПроцедуры

// Контракт КлиентаS3: сохраняет объект в файл. Бросает исключение, если объекта нет.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//  ПутьСохранения - Строка - путь файла назначения.
//
// Возвращаемое значение:
//  Строка - полное имя записанного файла.
//
Функция Скачать(Знач Ключ, Знач ПутьСохранения) Экспорт

	Запись = ТребоватьЗапись(Ключ);
	Запись.Данные.Записать(ПутьСохранения);
	Возврат Новый Файл(ПутьСохранения).ПолноеИмя;

КонецФункции

// Контракт КлиентаS3: содержимое объекта. Бросает исключение, если объекта нет.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//
// Возвращаемое значение:
//  ДвоичныеДанные.
//
Функция ПолучитьБайты(Знач Ключ) Экспорт
	Возврат ТребоватьЗапись(Ключ).Данные;
КонецФункции

// Контракт КлиентаS3: есть ли объект с таким ключом. Повторяет боевой клиент дословно —
// отсутствие это Ложь, а недоступное хранилище это отказ, а не тихое «нет».
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//
// Возвращаемое значение:
//  Булево - Истина, если объект есть; Ложь, если хранилище сказало «его нет».
//
Функция Существует(Знач Ключ) Экспорт
	ПроверитьДоступность();
	Возврат Объекты.Получить(Ключ) <> Неопределено;
КонецФункции

// Контракт КлиентаS3: ответ хранилища на описание объекта как есть. Повторяет боевой
// клиент: отсутствие объекта — 404, закрытый доступ — 403, недоступность — исключение.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//  СрокСек - Число - срок ожидания; фейк отвечает сразу и его не ждёт.
//
// Возвращаемое значение:
//  Структура - status и, для отказа доступа, response с машинным кодом.
//
Функция ОписаниеОбъекта(Знач Ключ, Знач СрокСек) Экспорт

	ПроверитьОтвет();

	Если ЗначениеЗаполнено(ОтказДоступа) Тогда
		Возврат ОтветОтказаДоступа();
	КонецЕсли;

	Возврат Новый Структура("status", ?(Объекты.Получить(Ключ) = Неопределено, 404, 200));

КонецФункции

// Контракт КлиентаS3: размер объекта в байтах. Бросает исключение, если объекта нет.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//
// Возвращаемое значение:
//  Число.
//
Функция Размер(Знач Ключ) Экспорт
	Возврат ТребоватьЗапись(Ключ).Данные.Размер();
КонецФункции

// Контракт КлиентаS3: удаляет объект. Идемпотентно — отсутствие объекта не ошибка.
//
// Параметры:
//  Ключ - Строка - ключ объекта.
//
Процедура Удалить(Знач Ключ) Экспорт
	Объекты.Удалить(Ключ); // идемпотентно: отсутствие — не ошибка
КонецПроцедуры

// Контракт КлиентаS3: ключи объектов с заданным префиксом. При заданном пределе страницы
// бросает исключение, если под ведущим сегментом объектов больше предела.
//
// Параметры:
//  Префикс - Строка - префикс ключа; пусто — все объекты.
//
// Возвращаемое значение:
//  Массив из Строка - ключи объектов.
//
Функция Перечислить(Знач Префикс) Экспорт

	ПроверитьДоступность();

	Если ПределСтраницы > 0 Тогда
		ВедущийСегмент = ВедущийСегментБезСлеша(Префикс);
		Если ОбъектовПодСегментом(ВедущийСегмент) > ПределСтраницы Тогда
			ВызватьИсключение СтрШаблон(
				"ФейкКлиентS3: список объектов (ведущий сегмент ""%1"") превышает предел страницы %2 —"
					+ " эмуляция fail-loud реального КлиентS3Oint (403 на постраничном токене)",
				ВедущийСегмент, Формат(ПределСтраницы, "ЧГ=0"));
		КонецЕсли;
	КонецЕсли;

	Результат = Новый Массив();
	ПустойПрефикс = НЕ ЗначениеЗаполнено(Префикс);
	Для Каждого КлючЗначение Из Объекты Цикл
		Если ПустойПрефикс ИЛИ СтрНачинаетсяС(КлючЗначение.Ключ, Префикс) Тогда
			Результат.Добавить(Новый Структура("Ключ, Размер, Изменён",
				КлючЗначение.Ключ,
				КлючЗначение.Значение.Данные.Размер(),
				КлючЗначение.Значение.Изменён));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Число хранимых объектов; вспомогательная проверка теста, не часть контракта.
//
// Возвращаемое значение:
//  Число.
//
Функция Количество() Экспорт
	Возврат Объекты.Количество();
КонецФункции

// Переводит фейк в режим недоступного хранилища: любое чтение и запись отвечают
// dependency.unavailable. Пустое пояснение возвращает хранилище в рабочий режим.
//
// Параметры:
//  Пояснение - Строка - текст, которым хранилище объясняет свою недоступность.
//
Процедура СтатьНедоступным(Знач Пояснение) Экспорт
	ОтказНедоступности = Строка(Пояснение);
КонецПроцедуры

// Переводит фейк в режим «отвечает, но этот доступ не пускает»: описание объекта даёт
// 403 с машинным кодом AccessDenied, остальные операции — dependency.unavailable, как
// у боевого клиента. Пустое пояснение возвращает доступ.
//
// Параметры:
//  Пояснение - Строка - чем хранилище объясняет отказ в доступе.
//
Процедура НеПускать(Знач Пояснение) Экспорт
	ОтказДоступа = Строка(Пояснение);
КонецПроцедуры

// Меняет ФОРМУЛИРОВКУ отсутствия объекта, не трогая машинный код: так проверяется, что
// вердикт хаба держится на коде ответа, а не на словах чужой библиотеки.
//
// Параметры:
//  Текст - Строка - как библиотека хранилища сообщает об отсутствии объекта.
//
Процедура ГоворитьОбОтсутствииТак(Знач Текст) Экспорт
	ТекстОтсутствия = Строка(Текст);
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач ПределСтраницыЛистинга = 0)
	Объекты = Новый Соответствие();
	ПределСтраницы = ПределСтраницыЛистинга;
	ОтказНедоступности = "";
	ОтказДоступа = "";
	ТекстОтсутствия = "";
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция ТребоватьЗапись(Знач Ключ)

	ПроверитьДоступность();

	Запись = Объекты.Получить(Ключ);
	Если Запись = Неопределено Тогда
		ВызватьИсключение СтандартныеОшибки.РесурсНеНайден(Ключ, ?(ЗначениеЗаполнено(ТекстОтсутствия),
			ТекстОтсутствия, СтрШаблон("Объект S3 не найден: %1", Ключ)));
	КонецЕсли;

	Возврат Запись;

КонецФункции

Процедура ПроверитьДоступность()

	ПроверитьОтвет();

	// боевой клиент отдаёт закрытый доступ тем же кодом: разводит «лежит» и «не пустило»
	// только проба, у которой на руках статус ответа
	Если ЗначениеЗаполнено(ОтказДоступа) Тогда
		ВызватьИсключение СтандартныеОшибки.ЗависимостьНедоступна("s3://фейк", ОтказДоступа);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьОтвет()
	Если ЗначениеЗаполнено(ОтказНедоступности) Тогда
		ВызватьИсключение СтандартныеОшибки.ЗависимостьНедоступна("s3://фейк", ОтказНедоступности);
	КонецЕсли;
КонецПроцедуры

Функция ОтветОтказаДоступа()

	Ошибка = Новый Соответствие();
	Ошибка.Вставить("Code", "AccessDenied");
	Ошибка.Вставить("Message", ОтказДоступа);

	Тело = Новый Соответствие();
	Тело.Вставить("Error", Ошибка);

	Возврат Новый Структура("status, response", 403, Тело);

КонецФункции

Функция ВедущийСегментБезСлеша(Знач Префикс)
	Если НЕ ЗначениеЗаполнено(Префикс) Тогда
		Возврат "";
	КонецЕсли;
	Позиция = СтрНайти(Префикс, "/");
	Возврат ?(Позиция = 0, Префикс, Лев(Префикс, Позиция - 1));
КонецФункции

Функция ОбъектовПодСегментом(Знач Сегмент)
	Если НЕ ЗначениеЗаполнено(Сегмент) Тогда
		Возврат Объекты.Количество();
	КонецЕсли;
	Счётчик = 0;
	Для Каждого КлючЗначение Из Объекты Цикл
		Если СтрНачинаетсяС(КлючЗначение.Ключ, Сегмент) Тогда
			Счётчик = Счётчик + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Счётчик;
КонецФункции

Функция ВБайты(Знач Источник)
	Если ТипЗнч(Источник) = Тип("ДвоичныеДанные") Тогда
		Возврат Источник;
	КонецЕсли;
	Если ТипЗнч(Источник) = Тип("Строка") Тогда
		Возврат Новый ДвоичныеДанные(Источник);
	КонецЕсли;
	ВызватьИсключение СтрШаблон(
		"ФейкКлиентS3: неподдерживаемый тип источника %1", ТипЗнч(Источник));
КонецФункции

#КонецОбласти
