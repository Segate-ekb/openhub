// Заглушка ответа winow для тестов гвардов: фиксирует Перенаправить (был ли редирект и куда).

Перем БылРедирект Экспорт;
Перем ПутьРедиректа Экспорт;

// Фиксирует редирект: запоминает факт вызова и путь.
//
// Параметры:
//  Путь - Строка - адрес перенаправления.
//
Процедура Перенаправить(Знач Путь) Экспорт
	БылРедирект = Истина;
	ПутьРедиректа = Строка(Путь);
КонецПроцедуры

// Готовит заглушку: редиректа не было, путь пуст.
Процедура ПриСозданииОбъекта() Экспорт
	БылРедирект = Ложь;
	ПутьРедиректа = "";
КонецПроцедуры
