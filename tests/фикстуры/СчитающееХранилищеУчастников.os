// ХранилищеУчастниковПула в памяти, считающее обращения. Обе двери на месте: точечная
// «роль на пуле» (через неё цена росла числом пулов) и разрез «все роли субъекта».

Перем Участия;   // Массив из Структура (ПулИдентификатор, ТипСубъекта, СубъектИдентификатор, Роль)
Перем СчётОбращений;

// Сколько раз хранилище спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат СчётОбращений;
КонецФункции

// Заводит запись участия (за обращение не считается).
//
// Параметры:
//  ПулИдентификатор - Число - пул.
//  ТипСубъекта - Строка - пользователь либо группа.
//  СубъектИдентификатор - Число - идентификатор субъекта.
//  Роль - Строка - имя роли.
//
Процедура Добавить(Знач ПулИдентификатор, Знач ТипСубъекта, Знач СубъектИдентификатор,
	Знач Роль) Экспорт

	Участия.Добавить(Новый Структура("ПулИдентификатор, ТипСубъекта, СубъектИдентификатор, Роль",
		Цел(ПулИдентификатор), ТипСубъекта, Цел(СубъектИдентификатор), Роль));

КонецПроцедуры

// Роль субъекта на пуле; считает обращение.
//
// Параметры:
//  ПулИдентификатор - Число.
//  ТипСубъекта - Строка.
//  СубъектИдентификатор - Число.
//
// Возвращаемое значение:
//  Структура, Неопределено - запись участия.
//
Функция НайтиРоль(Знач ПулИдентификатор, Знач ТипСубъекта, Знач СубъектИдентификатор) Экспорт

	СчётОбращений = СчётОбращений + 1;

	Для Каждого Участие Из Участия Цикл
		Если Участие.ПулИдентификатор = Цел(ПулИдентификатор)
			И Участие.ТипСубъекта = ТипСубъекта
			И Участие.СубъектИдентификатор = Цел(СубъектИдентификатор) Тогда
			Возврат Участие;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Все роли субъекта на всех пулах; считает обращение.
//
// Параметры:
//  ТипСубъекта - Строка.
//  СубъектИдентификатор - Число.
//
// Возвращаемое значение:
//  Массив - записи участия субъекта.
//
Функция РолиСубъекта(Знач ТипСубъекта, Знач СубъектИдентификатор) Экспорт

	СчётОбращений = СчётОбращений + 1;

	Результат = Новый Массив();
	Для Каждого Участие Из Участия Цикл
		Если Участие.ТипСубъекта = ТипСубъекта
			И Участие.СубъектИдентификатор = Цел(СубъектИдентификатор) Тогда
			Результат.Добавить(Участие);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ПриСозданииОбъекта()
	Участия = Новый Массив();
	СчётОбращений = 0;
КонецПроцедуры
