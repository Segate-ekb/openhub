// ХранилищеВерсийПакета-обёртка: делегирует настоящему хранилищу и считает ЗАПРОСЫ
// (сторож N+1). Считаются и разрезы по списку пакетов, и двери «на один пакет».

Перем Настоящий;
Перем СчётВерсииПакетов;
Перем СчётПоследниеОпубликованные;
Перем СчётНаОдинПакет;

#Область Счётчики

// Сколько запросов каждого вида ушло с момента создания обёртки.
//
// Возвращаемое значение:
//  Структура - ВерсииПакетов, ПоследниеОпубликованные, НаОдинПакет (Число).
//
Функция Запросов() Экспорт
	Результат = Новый Структура();
	Результат.Вставить("ВерсииПакетов", СчётВерсииПакетов);
	Результат.Вставить("ПоследниеОпубликованные", СчётПоследниеОпубликованные);
	Результат.Вставить("НаОдинПакет", СчётНаОдинПакет);
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ДелегированиеХранилищу

// Версии перечисленных пакетов одним запросом; считает разрез.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Массив - версии перечисленных пакетов.
//
Функция ВерсииПакетов(Знач ПакетИдентификаторы) Экспорт
	СчётВерсииПакетов = СчётВерсииПакетов + 1;
	Возврат Настоящий.ВерсииПакетов(ПакетИдентификаторы);
КонецФункции

// Последние опубликованные версии; считает запрос.
//
// Параметры:
//  Лимит - Число - сколько версий вернуть.
//
// Возвращаемое значение:
//  Массив - версии в порядке убывания даты публикации.
//
Функция ПоследниеОпубликованные(Знач Лимит) Экспорт
	СчётПоследниеОпубликованные = СчётПоследниеОпубликованные + 1;
	Возврат Настоящий.ПоследниеОпубликованные(Лимит);
КонецФункции

// Версии одного пакета; считает дверь «на один пакет» — через неё и растёт N+1.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив - версии пакета.
//
Функция ПолучитьПоПакетИдентификаторРавно(Знач ПакетИдентификатор) Экспорт
	СчётНаОдинПакет = СчётНаОдинПакет + 1;
	Возврат Настоящий.ПолучитьПоПакетИдентификаторРавно(ПакетИдентификатор);
КонецФункции

// Действующие версии одного пакета; считает дверь «на один пакет».
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив - неотозванные версии пакета.
//
Функция ДействующиеВерсии(Знач ПакетИдентификатор) Экспорт
	СчётНаОдинПакет = СчётНаОдинПакет + 1;
	Возврат Настоящий.ДействующиеВерсии(ПакетИдентификатор);
КонецФункции

// Версия по идентификатору; делегирует без подсчёта.
//
// Параметры:
//  Идентификатор - Число - идентификатор версии.
//
// Возвращаемое значение:
//  Произвольный - найденная версия либо Неопределено.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт
	Возврат Настоящий.ПолучитьОдноПоИдентификаторРавно(Идентификатор);
КонецФункции

// Новая строка версии; делегирует без подсчёта.
//
// Возвращаемое значение:
//  Произвольный - элемент хранилища.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Настоящий.СоздатьЭлемент();
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач _Настоящий)

	Настоящий = _Настоящий;
	СчётВерсииПакетов = 0;
	СчётПоследниеОпубликованные = 0;
	СчётНаОдинПакет = 0;

КонецПроцедуры
