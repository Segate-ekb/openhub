// Заглушка владельца фонового цикла: на каждом хуке записывает, закрыт ли уже гейт
// готовности, и останавливает цикл после первого шага. Свой цикл заглушка обрывает
// потолком шагов, но чужие им не спасает: гейт-сторожа стоят в наборе первыми, чтобы
// красное успело напечататься — наборы с настоящими рогатками под незакрытым гейтом
// бесконечны по построению.

Перем Готовность_;
Перем ИмяЗадачи_;
Перем Входить_;
Перем Цикл_;
Перем След_;
Перем Шагов_;

// Привязывает цикл, который заглушка останавливает после первого шага.
//
// Параметры:
//  Каркас - ФоновыйЦикл - крутящийся цикл.
//
Процедура ПривязатьЦикл(Знач Каркас) Экспорт
	Цикл_ = Каркас;
КонецПроцедуры

// След обращений: «хук:состояние гейта» через точку с запятой.
//
// Возвращаемое значение:
//  Строка.
//
Функция След() Экспорт
	Возврат СтрСоединить(След_, ";");
КонецФункции

// Контракт ФоновогоЦикла: входить ли в цикл.
//
// Возвращаемое значение:
//  Булево.
//
Функция ПередЦиклом() Экспорт
	Отметить("перед");
	Возврат Входить_;
КонецФункции

// Контракт ФоновогоЦикла: один шаг. После него цикл останавливается.
//
// Возвращаемое значение:
//  Булево - Ложь: пауза берётся всегда.
//
Функция ШагЦикла() Экспорт

	Отметить("шаг");
	Шагов_ = Шагов_ + 1;
	Если Шагов_ > ПотолокШагов() Тогда
		ВызватьИсключение СтрШаблон(
			"ВладелецЦиклаЗаглушка: цикл не остановился за %1 шагов", ПотолокШагов());
	КонецЕсли;

	Цикл_.Остановить();
	Возврат Ложь;

КонецФункции

// Контракт ФоновогоЦикла: пауза между шагами, миллисекунды.
//
// Возвращаемое значение:
//  Число.
//
Функция ПаузаМс() Экспорт
	Возврат 0;
КонецФункции

// Контракт ФоновогоЦикла: хвост грациозной остановки.
//
Процедура ПослеЦикла() Экспорт
	Отметить("после");
КонецПроцедуры

// Шагов заглушке нужен ровно один; потолок — предохранитель от собственного цикла,
// который не услышал Остановить.
Функция ПотолокШагов()
	Возврат 3;
КонецФункции

Процедура Отметить(Знач Хук)
	Закрыт = Готовность_.НезавершённыеЗадачи().Найти(ИмяЗадачи_) = Неопределено;
	След_.Добавить(Хук + ":" + ?(Закрыт, "закрыт", "открыт"));
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач Готовность, Знач ИмяЗадачи, Знач Входить = Истина)
	Готовность_ = Готовность;
	ИмяЗадачи_ = ИмяЗадачи;
	Входить_ = Входить;
	След_ = Новый Массив();
	Шагов_ = 0;
КонецПроцедуры
