// Честная заглушка ПроверяющийПодписиCI: подпись не проверяется, значит ни один CI-токен
// не достоверен. Желудём НЕ является — прозвище держит ПроверяющийПодписиJWKS; этот класс
// собирают напрямую там, где проверки подписи нет и отказ должен быть явным и названным.

Перем Лог;

// Отказывает любому токену; см. контракт публикация/ПроверяющийПодписиCI.
//
// Параметры:
//  Токен - Строка - id-token в компактной форме JWS.
//  Издатель - Строка - ожидаемый iss.
//
// Возвращаемое значение:
//  Структура - Достоверна (всегда Ложь), Причина (Строка), Клеймы (Неопределено).
//
Функция ПроверитьТокен(Знач Токен, Знач Издатель) Экспорт

	// предупреждение только на реально предъявленный токен, иначе журнал зарастёт шумом
	Если ЗначениеЗаполнено(Токен) Тогда
		Лог.Предупреждение(
			"Предъявлен id-token конвейера для издателя ""%1"", но проверка подписи в этом"
			+ " контейнере не собрана: публикация отклонена. Прозвище ПроверяющийПодписиCI"
			+ " в поставке держит ПроверяющийПодписиJWKS.", Издатель);
	КонецЕсли;

	Возврат Новый Структура("Достоверна, Причина, Клеймы", Ложь,
		"проверка подписи id-token не установлена в этом хабе", Неопределено);

КонецФункции

// Лог принимается параметром: желудём класс не является, инъекция в поле до него не
// доезжает, и первая же запись в журнал падала бы «Value is not of object type».
Процедура ПриСозданииОбъекта(Знач _Лог = Неопределено)

	Если _Лог <> Неопределено Тогда
		Лог = _Лог;
	КонецЕсли;

КонецПроцедуры
