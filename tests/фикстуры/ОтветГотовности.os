// Заглушка ответа winow: фиксирует код состояния, заголовки и тело.

Перем Код Экспорт;        // Число - последний установленный код состояния
Перем Заголовки Экспорт;  // Соответствие
Перем ТелоТекст Экспорт;  // Строка

// Запоминает код состояния ответа.
//
// Параметры:
//  КодСостояния - Число - код HTTP.
//
Процедура УстановитьСостояние(Знач КодСостояния) Экспорт
	Код = КодСостояния;
КонецПроцедуры

// Запоминает код состояния 200.
Процедура УстановитьСостояниеОК() Экспорт
	Код = 200;
КонецПроцедуры

// Готовит пустой ответ: код 0, пустые заголовки и тело.
Процедура ПриСозданииОбъекта() Экспорт
	Код = 0;
	Заголовки = Новый Соответствие();
	ТелоТекст = "";
КонецПроцедуры
