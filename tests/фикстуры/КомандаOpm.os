// opm из набора: есть ли он в окружении и что он ответил на команду; ожидание ограничено.

Перем ТаймаутСек;

// Есть ли в окружении рабочий opm: `opm version` завершается с кодом 0.
//
// Возвращаемое значение:
//  Булево.
//
Функция Доступен() Экспорт
	Попытка
		Итог = Запустить("version", КаталогиПроекта.Корень());
		Возврат Итог.КодВозврата = 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Запускает `opm <аргументы>` в рабочем каталоге и ждёт завершения.
//
// Параметры:
//  Аргументы - Строка - аргументы командной строки opm.
//  РабочийКаталог - Строка - каталог, где лежат opm.cfg и файлы команды.
//
// Возвращаемое значение:
//  Структура - КодВозврата (Число), Вывод (Строка: стандартный вывод одной строкой).
//              Не завершился за таймаут — исключение.
//
Функция Запустить(Знач Аргументы, Знач РабочийКаталог) Экспорт

	Процесс = СоздатьПроцесс("opm " + Аргументы, РабочийКаталог, Истина);
	Процесс.Запустить();

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСек * 1000;
	Пока НЕ Процесс.Завершен Цикл
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() > Крайний Тогда
			ВызватьИсключение СтрШаблон("opm %1 не завершился за %2 с", Аргументы, ТаймаутСек);
		КонецЕсли;
		Приостановить(300);
	КонецЦикла;

	Вывод = "";
	Попытка
		Вывод = СтрЗаменить(Строка(Процесс.ПотокВывода.ПрочитатьВсе()), Символы.ПС, " | ");
	Исключение
	КонецПопытки;

	Возврат Новый Структура("КодВозврата, Вывод", Процесс.КодВозврата, Вывод);

КонецФункции

Процедура ПриСозданииОбъекта(Знач _ТаймаутСек = 60)
	ТаймаутСек = _ТаймаутСек;
КонецПроцедуры
