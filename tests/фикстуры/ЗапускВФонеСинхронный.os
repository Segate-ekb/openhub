// Фейк ЗапускВФоне: исполняет обработчик тут же, в потоке вызывающего. Нужен наборам,
// которые проверяют ИСХОД раздачи, а не её асинхронность: фон делает их гонкой.
// Асинхронность проверяется отдельно, на боевом ЗапускВФонеЗаданием.

Перем Запусков_;

// Число обращений к Запустить.
//
// Возвращаемое значение:
//  Число.
//
Функция Запусков() Экспорт
	Возврат Запусков_;
КонецФункции

// Контракт ЗапускВФоне: исполняет обработчик немедленно и синхронно.
//
// Параметры:
//  Обработчик - Произвольный - объект с методом Исполнить().
//
Процедура Запустить(Знач Обработчик) Экспорт
	Запусков_ = Запусков_ + 1;
	Обработчик.Исполнить();
КонецПроцедуры

&Прозвище("ЗапускВФоне")
&Желудь
Процедура ПриСозданииОбъекта()
	Запусков_ = 0;
КонецПроцедуры
