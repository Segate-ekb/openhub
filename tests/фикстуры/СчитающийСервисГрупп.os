// СервисГрупп без единой группы, считающий обращения: список групп нужен каждому вопросу
// о правах, и спрашивать его на каждый объект — тот же N+1, что и сами права.

Перем Счётчик;   // СчётчикОбращений — счёт обращений к фикстуре

// Сколько раз службу спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Группы пользователя; считает обращение.
//
// Параметры:
//  ПользовательИдентификатор - Число - идентификатор пользователя.
//
// Возвращаемое значение:
//  Массив - всегда пустой.
//
Функция ГруппыПользователя(Знач ПользовательИдентификатор) Экспорт
	ПользовательИдентификатор = ПользовательИдентификатор;
	Счётчик.Отметить();
	Возврат Новый Массив();
КонецФункции

Процедура ПриСозданииОбъекта()
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
