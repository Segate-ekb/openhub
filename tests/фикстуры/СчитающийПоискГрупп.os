// Обёртка СервисаГрупп, считающая обращения к нему: сами группы отдаёт настоящая служба,
// счёт нужен там, где цена входа через провайдера росла числом значений клейма.

Перем Служба;    // СервисГрупп — настоящая служба групп
Перем Счётчик;   // СчётчикОбращений — счёт обращений к службе

// Сколько раз службу спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Контракт СервисаГрупп: группа по имени; считает обращение.
//
// Параметры:
//  Имя - Строка - имя группы в любом регистре.
//
// Возвращаемое значение:
//  Группа, Неопределено.
//
Функция НайтиГруппу(Знач Имя) Экспорт
	Счётчик.Отметить();
	Возврат Служба.НайтиГруппу(Имя);
КонецФункции

// Контракт СервисаГрупп: группы по списку имён; считает обращение.
//
// Параметры:
//  Имена - Массив из Строка - имена групп в любом регистре.
//
// Возвращаемое значение:
//  Соответствие - ключ Строка (каноническое имя), значение Группа.
//
Функция ПоИменам(Знач Имена) Экспорт
	Счётчик.Отметить();
	Возврат Служба.ПоИменам(Имена);
КонецФункции

// Контракт СервисаГрупп: создание группы; считает обращение.
//
// Параметры:
//  Имя - Строка - имя группы.
//  Описание - Строка - описание группы (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Группа - созданная группа.
//
Функция СоздатьГруппу(Знач Имя, Знач Описание = "") Экспорт
	Счётчик.Отметить();
	Возврат Служба.СоздатьГруппу(Имя, Описание);
КонецФункции

Процедура ПриСозданииОбъекта(Знач НастоящаяСлужба)
	Служба = НастоящаяСлужба;
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
