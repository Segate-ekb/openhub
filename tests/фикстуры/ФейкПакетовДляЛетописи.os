// Фейк СервисаПакетов: ЛетописьВерсий спрашивает имя и пул пакета, отметка последней публикации
// пишется прямо в запись; службы кабинета читают пакеты пула и списком.

Перем Пакеты; // Соответствие: идентификатор -> ФейкПакетЗапись
Перем ОбращенийКПакетамПула Экспорт; // Число — сколько раз спросили ПакетыПула

// Контракт СервисаПакетов: пакет по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  ФейкПакетЗапись, Неопределено - Неопределено, если пакета нет.
//
Функция ПакетПоИдентификатору(Знач Идентификатор) Экспорт
	Возврат Пакеты.Получить(Цел(Идентификатор));
КонецФункции

// Контракт СервисаПакетов: отметка последней публикации только вперёд.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Момент - Дата - момент публикации.
//
Процедура ПродвинутьПоследнююПубликацию(Знач ПакетИдентификатор, Знач Момент) Экспорт

	Запись = Пакеты.Получить(Цел(ПакетИдентификатор));
	Если Запись = Неопределено ИЛИ Запись.ПоследняяПубликация >= Момент Тогда
		Возврат;
	КонецЕсли;
	Запись.ПоследняяПубликация = Момент;
	Запись.Сохранить();

КонецПроцедуры

// Контракт СервисаПакетов: отметка последней публикации как есть.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Момент - Дата - момент публикации старшей действующей версии.
//
Процедура УстановитьПоследнююПубликацию(Знач ПакетИдентификатор, Знач Момент) Экспорт

	Запись = Пакеты.Получить(Цел(ПакетИдентификатор));
	Если Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Запись.ПоследняяПубликация = Момент;
	Запись.Сохранить();

КонецПроцедуры

// Регистрирует пакет в фейке.
//
// Параметры:
//  Идентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя пакета.
//  ПулИдентификатор - Число - идентификатор пула пакета.
//
// Возвращаемое значение:
//  ФейкПакетЗапись - заведённая запись.
//
Функция Добавить(Знач Идентификатор, Знач Имя, Знач ПулИдентификатор) Экспорт

	Запись = Новый ФейкПакетЗапись(Идентификатор, Имя, ПулИдентификатор);
	Пакеты.Вставить(Цел(Идентификатор), Запись);
	Возврат Запись;

КонецФункции

// Контракт СервисаПакетов: все пакеты хаба.
//
// Возвращаемое значение:
//  Массив из ФейкПакетЗапись.
//
Функция ВсеПакеты() Экспорт
	Результат = Новый Массив();
	Для Каждого КиЗ Из Пакеты Цикл
		Результат.Добавить(КиЗ.Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Контракт СервисаПакетов: пакеты пула; каждое обращение считается.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив из ФейкПакетЗапись.
//
Функция ПакетыПула(Знач ПулИдентификатор) Экспорт
	ОбращенийКПакетамПула = ОбращенийКПакетамПула + 1;
	Результат = Новый Массив();
	Для Каждого Запись Из ВсеПакеты() Цикл
		Если Запись.ПулИдентификатор = Цел(ПулИдентификатор) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Контракт СервисаПакетов: пакеты перечисленных идентификаторов.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Массив из ФейкПакетЗапись - найденные.
//
Функция ПакетыПоИдентификаторам(Знач Идентификаторы) Экспорт
	Результат = Новый Массив();
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Запись = ПакетПоИдентификатору(Идентификатор);
		Если Запись <> Неопределено Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПриСозданииОбъекта()
	Пакеты = Новый Соответствие();
	ОбращенийКПакетамПула = 0;
КонецПроцедуры
