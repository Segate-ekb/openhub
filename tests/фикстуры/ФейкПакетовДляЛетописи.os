// Фейк СервисаПакетов для тестов ЛетописиВерсий: пакет по идентификатору.

Перем Пакеты; // Соответствие: идентификатор -> Структура (Идентификатор, Имя, ПулИдентификатор)

// Контракт СервисаПакетов: пакет по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Структура (Идентификатор, Имя, ПулИдентификатор), Неопределено - Неопределено, если
//   пакета нет.
//
Функция ПакетПоИдентификатору(Знач Идентификатор) Экспорт
	Возврат Пакеты.Получить(Цел(Идентификатор));
КонецФункции

// Регистрирует пакет в фейке.
//
// Параметры:
//  Идентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя пакета.
//  ПулИдентификатор - Число - идентификатор пула пакета.
//
Процедура Добавить(Знач Идентификатор, Знач Имя, Знач ПулИдентификатор) Экспорт
	Пакеты.Вставить(Цел(Идентификатор), Новый Структура("Идентификатор, Имя, ПулИдентификатор",
		Цел(Идентификатор), Строка(Имя), Цел(ПулИдентификатор)));
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Пакеты = Новый Соответствие();
КонецПроцедуры
