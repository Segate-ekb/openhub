// Фейк СервисаПакетов для СервисВерсий: ЛетописьВерсий спрашивает имя и пул пакета, отметка
// последней публикации пишется прямо в запись.

Перем Пакеты; // Соответствие: идентификатор -> ФейкПакетЗапись

// Контракт СервисаПакетов: пакет по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  ФейкПакетЗапись, Неопределено - Неопределено, если пакета нет.
//
Функция ПакетПоИдентификатору(Знач Идентификатор) Экспорт
	Возврат Пакеты.Получить(Цел(Идентификатор));
КонецФункции

// Контракт СервисаПакетов: отметка последней публикации только вперёд.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Момент - Дата - момент публикации.
//
Процедура ПродвинутьПоследнююПубликацию(Знач ПакетИдентификатор, Знач Момент) Экспорт

	Запись = Пакеты.Получить(Цел(ПакетИдентификатор));
	Если Запись = Неопределено ИЛИ Запись.ПоследняяПубликация >= Момент Тогда
		Возврат;
	КонецЕсли;
	Запись.ПоследняяПубликация = Момент;
	Запись.Сохранить();

КонецПроцедуры

// Контракт СервисаПакетов: отметка последней публикации как есть.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Момент - Дата - момент публикации старшей действующей версии.
//
Процедура УстановитьПоследнююПубликацию(Знач ПакетИдентификатор, Знач Момент) Экспорт

	Запись = Пакеты.Получить(Цел(ПакетИдентификатор));
	Если Запись = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Запись.ПоследняяПубликация = Момент;
	Запись.Сохранить();

КонецПроцедуры

// Регистрирует пакет в фейке.
//
// Параметры:
//  Идентификатор - Число - идентификатор пакета.
//  Имя - Строка - имя пакета.
//  ПулИдентификатор - Число - идентификатор пула пакета.
//
// Возвращаемое значение:
//  ФейкПакетЗапись - заведённая запись.
//
Функция Добавить(Знач Идентификатор, Знач Имя, Знач ПулИдентификатор) Экспорт

	Запись = Новый ФейкПакетЗапись(Идентификатор, Имя, ПулИдентификатор);
	Пакеты.Вставить(Цел(Идентификатор), Запись);
	Возврат Запись;

КонецФункции

Процедура ПриСозданииОбъекта()
	Пакеты = Новый Соответствие();
КонецПроцедуры
