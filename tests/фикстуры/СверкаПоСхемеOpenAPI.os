// Сверка значения JSON со схемой описания API: подмножество JSON Schema, которое печатает winow,
// и объект со свойствами считается закрытым — лишнее поле расходится со схемой.

Перем Схемы;              // Соответствие — components.schemas документа
Перем ИзвестныеСлова;     // Соответствие — ключевые слова схемы, которые сверка понимает
Перем Пройденные_;        // Соответствие — имена схем components, через которые сверка прошла

#Область ПубличныйИнтерфейс

// Расхождения значения со схемой.
//
// Параметры:
//  Значение - Произвольный - значение, прочитанное ПрочитатьJSON в Соответствие.
//  Схема - Соответствие - схема из документа описания.
//  Путь - Строка - где лежит значение, для текста расхождения (необязательный, по умолчанию "$").
//
// Возвращаемое значение:
//  Массив из Строка - расхождения; пустой — значение подходит.
//
Функция Расхождения(Знач Значение, Знач Схема, Знач Путь = "$") Экспорт

	Найденные = Новый Массив();
	Сверить(Значение, Схема, Путь, Найденные);
	Возврат Найденные;

КонецФункции

// Схемы components, через которые прошла хоть одна сверка: схема, которой ни одно значение не коснулось,
// ничего не стережёт.
//
// Возвращаемое значение:
//  Соответствие - имя схемы → Истина.
//
Функция Пройденные() Экспорт
	Возврат Пройденные_;
КонецФункции

#КонецОбласти

#Область Сверка

Процедура Сверить(Знач Значение, Знач Схема, Знач Путь, Найденные)

	Если ТипЗнч(Схема) <> Тип("Соответствие") Тогда
		Найденные.Добавить(СтрШаблон("%1: схема не объект", Путь));
		Возврат;
	КонецЕсли;

	Для Каждого Слово Из Схема Цикл
		Если ИзвестныеСлова.Получить(Слово.Ключ) = Неопределено Тогда
			Найденные.Добавить(СтрШаблон("%1: сверка не знает ключевого слова %2", Путь, Слово.Ключ));
		КонецЕсли;
	КонецЦикла;

	Ссылка = Схема.Получить("$ref");
	Если Ссылка <> Неопределено Тогда
		Сверить(Значение, ПоСсылке(Ссылка, Путь, Найденные, Значение <> Неопределено), Путь, Найденные);
	КонецЕсли;

	Варианты = Схема.Получить("anyOf");
	Если Варианты <> Неопределено И НЕ ПодходитХотьОдин(Значение, Варианты, Путь) Тогда
		Найденные.Добавить(СтрШаблон("%1: не подходит ни один вариант anyOf", Путь));
	КонецЕсли;

	Типы = Схема.Получить("type");
	Если Типы <> Неопределено И НЕ ТипПодходит(Значение, Типы) Тогда
		Найденные.Добавить(СтрШаблон("%1: ожидался тип %2, пришло %3", Путь, ТипыСтрокой(Типы),
			ВидЗначения(Значение)));
		Возврат;
	КонецЕсли;

	Перечень = Схема.Получить("enum");
	Если Перечень <> Неопределено И Перечень.Найти(Значение) = Неопределено Тогда
		Найденные.Добавить(СтрШаблон("%1: значение «%2» не из перечня %3", Путь, Значение, СтрСоединить(Перечень, ", ")));
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		СверитьОбъект(Значение, Схема, Путь, Найденные);
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		СверитьМассив(Значение, Схема, Путь, Найденные);
	КонецЕсли;

КонецПроцедуры

// Объект с ключом properties закрыт: winow не печатает additionalProperties: false, а схема ответа хаба
// обязана назвать каждое поле, которое он отдаёт. Объект без ключа properties и без additionalProperties —
// словарь любого состава.
Процедура СверитьОбъект(Знач Значение, Знач Схема, Знач Путь, Найденные)

	Свойства = Схема.Получить("properties");
	Прочие = Схема.Получить("additionalProperties");

	Обязательные = Схема.Получить("required");
	Если Обязательные <> Неопределено Тогда
		Для Каждого Имя Из Обязательные Цикл
			Если НЕ ЕстьКлюч(Значение, Имя) Тогда
				Найденные.Добавить(СтрШаблон("%1: нет обязательного поля %2", Путь, Имя));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого Поле Из Значение Цикл

		ПутьПоля = Путь + "." + Поле.Ключ;
		СхемаПоля = ?(Свойства = Неопределено, Неопределено, Свойства.Получить(Поле.Ключ));

		Если СхемаПоля <> Неопределено Тогда
			Сверить(Поле.Значение, СхемаПоля, ПутьПоля, Найденные);
		ИначеЕсли Прочие <> Неопределено Тогда
			Сверить(Поле.Значение, Прочие, ПутьПоля, Найденные);
		ИначеЕсли Свойства <> Неопределено Тогда
			Найденные.Добавить(СтрШаблон("%1: поля нет в схеме", ПутьПоля));
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура СверитьМассив(Знач Значение, Знач Схема, Знач Путь, Найденные)

	Элементы = Схема.Получить("items");
	Если Элементы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Индекс = 0 По Значение.ВГраница() Цикл
		Сверить(Значение[Индекс], Элементы, СтрШаблон("%1[%2]", Путь, Формат(Индекс, "ЧН=0; ЧГ=0")), Найденные);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Типы

Функция ТипПодходит(Знач Значение, Знач Типы)

	Если ТипЗнч(Типы) = Тип("Массив") Тогда
		Возврат Типы.Найти(ВидЗначения(Значение)) <> Неопределено;
	КонецЕсли;

	Возврат ВидЗначения(Значение) = Типы;

КонецФункции

// Имя типа JSON Schema для значения, прочитанного ПрочитатьJSON.
Функция ВидЗначения(Знач Значение)

	Вид = ТипЗнч(Значение);
	Если Вид = Тип("Строка") Тогда
		Возврат "string";
	ИначеЕсли Вид = Тип("Число") Тогда
		Возврат "number";
	ИначеЕсли Вид = Тип("Булево") Тогда
		Возврат "boolean";
	ИначеЕсли Вид = Тип("Массив") Тогда
		Возврат "array";
	ИначеЕсли Вид = Тип("Соответствие") Тогда
		Возврат "object";
	ИначеЕсли Значение = Неопределено ИЛИ Значение = Null Тогда
		Возврат "null";
	КонецЕсли;

	Возврат Строка(Вид);

КонецФункции

Функция ТипыСтрокой(Знач Типы)
	Возврат ?(ТипЗнч(Типы) = Тип("Массив"), СтрСоединить(Типы, "|"), Типы);
КонецФункции

#КонецОбласти

#Область Служебное

// Null схему не проверяет: пройденной она становится от значения.
Функция ПоСсылке(Знач Ссылка, Знач Путь, Найденные, Знач ЕстьЗначение)

	Префикс = "#/components/schemas/";
	Если НЕ СтрНачинаетсяС(Ссылка, Префикс) Тогда
		Найденные.Добавить(СтрШаблон("%1: ссылка %2 не в components.schemas", Путь, Ссылка));
		Возврат Новый Соответствие();
	КонецЕсли;

	Имя = Сред(Ссылка, СтрДлина(Префикс) + 1);
	Схема = Схемы.Получить(Имя);
	Если Схема = Неопределено Тогда
		Найденные.Добавить(СтрШаблон("%1: схемы %2 нет в документе", Путь, Ссылка));
		Возврат Новый Соответствие();
	КонецЕсли;

	Если ЕстьЗначение Тогда
		Пройденные_.Вставить(Имя, Истина);
	КонецЕсли;
	Возврат Схема;

КонецФункции

Функция ПодходитХотьОдин(Знач Значение, Знач Варианты, Знач Путь)

	Для Каждого Вариант Из Варианты Цикл
		Если Расхождения(Значение, Вариант, Путь).Количество() = 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЕстьКлюч(Знач Объект, Знач Имя)

	Для Каждого Поле Из Объект Цикл
		Если Поле.Ключ = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

// Параметры:
//  КомпонентыСхем - Соответствие - раздел components.schemas документа описания; пустой —
//                   ссылкам разрешаться не во что.
//
Процедура ПриСозданииОбъекта(Знач КомпонентыСхем) Экспорт

	Схемы = ?(КомпонентыСхем = Неопределено, Новый Соответствие(), КомпонентыСхем);
	Пройденные_ = Новый Соответствие();

	// ровно то, что печатает построитель схем winow
	ИзвестныеСлова = Новый Соответствие();
	Для Каждого Слово Из СтрРазделить("$ref,anyOf,type,properties,required,additionalProperties,items,enum,description",
		",") Цикл
		ИзвестныеСлова.Вставить(Слово, Истина);
	КонецЦикла;

КонецПроцедуры
