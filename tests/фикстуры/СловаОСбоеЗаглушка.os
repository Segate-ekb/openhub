// Заглушка контракта «СбойХабаСловами»: отдаёт узнаваемые фразу и страницу и помнит,
// с чем её звали. Страница настоящая проверяется своим набором — здесь важно, ЧТО шов
// входа спрашивает и куда кладёт ответ.

Перем Фразы_;       // Массив из Строка — коды, о которых спрашивали фразу
Перем Страницы_;    // Массив из Структура (Код, Статус, КодЗапроса, Куки)
Перем ПадаетНаСтранице_;

#Область КонтрактСбойХабаСловами

// Фраза посетителю по машинному коду отказа.
//
// Параметры:
//  КодСбоя - Строка - машинный код отказа.
//
// Возвращаемое значение:
//  Строка.
//
Функция Фраза(Знач КодСбоя) Экспорт
	Фразы_.Добавить(Строка(КодСбоя));
	Возврат "фраза[" + Строка(КодСбоя) + "]";
КонецФункции

// Страница отказа целиком.
//
// Параметры:
//  КодСбоя - Строка - машинный код отказа.
//  Статус - Число - код состояния HTTP.
//  КодЗапроса - Строка - код запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//
// Возвращаемое значение:
//  Строка - разметка страницы.
//
Функция Страница(Знач КодСбоя, Знач Статус, Знач КодЗапроса, Знач КукиЗапроса) Экспорт

	Страницы_.Добавить(Новый Структура("Код, Статус, КодЗапроса, Куки",
		Строка(КодСбоя), Статус, Строка(КодЗапроса), КукиЗапроса));

	Если ПадаетНаСтранице_ Тогда
		ВызватьИсключение "СловаОСбоеЗаглушка: страница намеренно не собралась";
	КонецЕсли;

	Возврат "<html><body>" + Фраза(КодСбоя) + " " + Строка(КодЗапроса) + "</body></html>";

КонецФункции

#КонецОбласти

#Область ЧтоУвиделДвойник

// Коды, о которых спрашивали фразу, в порядке вызова.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Фразы() Экспорт
	Возврат Фразы_;
КонецФункции

// Вызовы сборки страницы в порядке вызова.
//
// Возвращаемое значение:
//  Массив из Структура - Код, Статус, КодЗапроса, Куки.
//
Функция Страницы() Экспорт
	Возврат Страницы_;
КонецФункции

// Страница собираться отказывается — так проверяется запасной путь шва.
//
// Возвращаемое значение:
//  СловаОСбоеЗаглушка - этот же объект.
//
Функция ПадаетНаСтранице() Экспорт
	ПадаетНаСтранице_ = Истина;
	Возврат ЭтотОбъект;
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()

	Фразы_ = Новый Массив();
	Страницы_ = Новый Массив();
	ПадаетНаСтранице_ = Ложь;

КонецПроцедуры
