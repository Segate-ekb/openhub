// Причины обхода зеркала-заглушка: набор задаёт снимки, которые увидит экран, либо велит
// чтению упасть — так проверяется экран над лежащей базой. Заодно считает обращения:
// цена отрисовки — одно чтение.

Перем Снимки_;
Перем Падать_;
Перем Спрошено_;

#Область КонтрактПричинЗеркала

// Контракт ПричинЗеркала: причины текущего обхода.
//
// Параметры:
//  Зеркало - ЗеркалоХаба - прочитанная запись зеркала.
//
// Возвращаемое значение:
//  Массив из Структура - снимки происшествий.
//
Функция Обхода(Знач Зеркало) Экспорт

	Спрошено_ = Спрошено_ + 1;
	Если Падать_ Тогда
		ВызватьИсключение "ФейкПричинЗеркала: причины прочитать нечем — база не отвечает";
	КонецЕсли;
	Возврат Снимки_;

КонецФункции

#КонецОбласти

#Область ЧтоЗадаётНабор

// Добавляет снимок происшествия в выдачу.
//
// Параметры:
//  Предмет - Строка - «пакет@версия»; пусто — происшествие всего обхода.
//  Код - Строка - машинный код причины.
//  Причина - Строка - фраза для человека.
//  Повторов - Число - сколько раз причина повторилась (необязательный, по умолчанию 1).
//  Устранимо - Булево - пройдёт ли причина следующим заходом (необязательный,
//              по умолчанию Ложь).
//  Последний - Дата - момент последнего повтора (необязательный, по умолчанию пустой).
//  ИсходНеясен - Булево - про причину неизвестно, повторится она или нет (необязательный,
//                по умолчанию Ложь).
//  Впервые - Дата - момент первого появления; пустой — берётся «последний»
//            (необязательный).
//
Процедура Добавить(Знач Предмет, Знач Код, Знач Причина, Знач Повторов = 1,
	Знач Устранимо = Ложь, Знач Последний = '00010101000000', Знач ИсходНеясен = Ложь,
	Знач Впервые = '00010101000000') Экспорт

	Снимок = Новый Структура();
	Снимок.Вставить("Подсистема", "зеркало");
	Снимок.Вставить("Объект", "зеркало/1");
	Снимок.Вставить("Предмет", Предмет);
	Снимок.Вставить("Код", Код);
	Снимок.Вставить("Причина", Причина);
	Снимок.Вставить("Количество", Повторов);
	Снимок.Вставить("Впервые", ?(ЗначениеЗаполнено(Впервые), Впервые, Последний));
	Снимок.Вставить("Последний", Последний);
	Снимок.Вставить("Прогон", "обход-1");
	Снимок.Вставить("Устранимо", Устранимо);
	Снимок.Вставить("ИсходНеясен", ИсходНеясен);
	Снимки_.Добавить(Снимок);

КонецПроцедуры

// Велит чтению падать: так ведёт себя лежащая база.
//
Процедура Ломаться() Экспорт
	Падать_ = Истина;
КонецПроцедуры

// Сколько раз у заглушки спросили причины.
//
// Возвращаемое значение:
//  Число.
//
Функция Спрошено() Экспорт
	Возврат Спрошено_;
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	Снимки_ = Новый Массив();
	Падать_ = Ложь;
	Спрошено_ = 0;
КонецПроцедуры
