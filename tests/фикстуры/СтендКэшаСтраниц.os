// Окружение КэшСтраницАнонима одним объектом: поделка winow, менеджер кэшей в памяти, перехватчик,
// выбор оформления (разбор куки — настоящий из кита), настройки хаба, фоновый запуск по требованию
// и обёрнутый обработчик, который считает сборки.

Перем Записи;           // Соответствие — кэш «страницыАнонима»
Перем Отложенные;       // Массив — задания фона, ждущие ВыполнитьФон()
Перем Сборок Экспорт;   // Число — сколько раз обёрнутый обработчик собирал ответ
Перем Запросы Экспорт;  // Массив — запросы, которые видел обёрнутый обработчик
Перем Код Экспорт;      // Число — код следующих ответов
Перем Тело Экспорт;     // Строка — тело следующих ответов; номер сборки дописывается
Перем ТипКонтента Экспорт;
Перем КукаОтвета Экспорт;  // Строка — имя куки, которую ответ выдаёт; пусто — никакой
Перем ЗначениеКукиОтвета Экспорт; // Строка — её значение; пусто — гасящая кука, как при выходе
Перем Пользователи Экспорт; // Соответствие — значение куки сессии → логин
Перем Шаблон Экспорт;   // Строка — шаблон маршрута, который «находит» обработчик
Перем Включён Экспорт;  // Булево — настройка oshub.cache.guest_pages
Перем ЧтенийВыключателя Экспорт; // Число — сколько раз кэш спросил выключатель
Перем АдресХаба Экспорт; // Строка — настройка oshub.instance.url; пусто — не задана
Перем ОпределенийПринципала Экспорт; // Число — сколько раз кэш спросил перехватчик о пользователе
Перем ВыданоСессийWinow Экспорт; // Число — сколько сессий winow завёл кэш

#Область Поделка

Функция НайтиЖелудь(Знач Имя) Экспорт
	Если Имя = "ВходящийЗапрос" Тогда
		Возврат Запрос("GET", "");
	КонецЕсли;
	Возврат ЭтотОбъект;
КонецФункции

Функция НовыйОтвет() Экспорт
	Возврат Новый ОтветСтраницыКэшаЗаглушка(0, "", "");
КонецФункции

Функция ИмяКукаСессии() Экспорт
	Возврат "SessionID";
КонецФункции

Функция ПолучитьСессиюПоКукам(Знач Куки) Экспорт // BSLLS:UnusedParameters-off
	ВыданоСессийWinow = ВыданоСессийWinow + 1;
	Возврат Новый Структура("Логин", "");
КонецФункции

#КонецОбласти

#Область МенеджерКэшей

Функция Достать() Экспорт
	Возврат ЭтотОбъект;
КонецФункции

Функция Кэш(Знач Имя) Экспорт // BSLLS:UnusedParameters-off
	Возврат ЭтотОбъект;
КонецФункции

Функция Получить(Знач Ключ) Экспорт
	Возврат Записи.Получить(Ключ);
КонецФункции

Функция Положить(Знач Ключ, Знач Значение) Экспорт
	Записи.Вставить(Ключ, Значение);
	Возврат Значение;
КонецФункции

Процедура Удалить(Знач Ключ) Экспорт
	Записи.Удалить(Ключ);
КонецПроцедуры

Процедура Очистить() Экспорт
	Записи.Очистить();
КонецПроцедуры

Функция ЗаписейВКэше() Экспорт
	Возврат Записи.Количество();
КонецФункции

// Состаривает все записи на заданное число миллисекунд.
Процедура Состарить(Знач Мс) Экспорт
	Для Каждого КиЗ Из Новый ФиксированноеСоответствие(Записи) Цикл
		Старая = КиЗ.Значение;
		Если ТипЗнч(Старая) <> Тип("ФиксированнаяСтруктура") Тогда
			Продолжить;
		КонецЕсли;
		Записи.Вставить(КиЗ.Ключ, Новый ФиксированнаяСтруктура("Тело, Заголовки, Собрана, Поколение, Образец",
			Старая.Тело, Старая.Заголовки, Старая.Собрана - Мс, Старая.Поколение, Старая.Образец));
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ПерехватчикИОформление

Функция ИмяКукиСессии() Экспорт
	Возврат "oshub_session";
КонецФункции

Функция ИзвлечьТокен(Знач Заголовки) Экспорт
	Значение = Заголовки.Получить("Authorization");
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции

Функция ОпределитьПринципала(Знач Заголовки, Знач Куки) Экспорт
	ОпределенийПринципала = ОпределенийПринципала + 1;
	Пользователь = Неопределено;
	Если Куки <> Неопределено Тогда
		Пользователь = Пользователи.Получить(Куки.ПолучитьЗначениеПоИмени(ИмяКукиСессии()));
	КонецЕсли;
	Возврат Новый Структура("Пользователь, ПроблемаТокена", Пользователь, "");
КонецФункции

Функция ИмяCookie() Экспорт
	Возврат "ui";
КонецФункции

Функция РазобратьЗначение(Знач Значение) Экспорт
	Возврат Новый ВыборОформления(ЭтотОбъект).РазобратьЗначение(Значение);
КонецФункции

// Оформление инсталляции для ВыборОформления кита: своего у стенда нет.
Функция Оформление() Экспорт
	Возврат Новый Структура();
КонецФункции

#КонецОбласти

#Область Настройки

Функция Флаг(Знач Ключ, Знач Дефолт) Экспорт
	Если Ключ = "oshub.cache.guest_pages" Тогда
		ЧтенийВыключателя = ЧтенийВыключателя + 1;
	КонецЕсли;
	Возврат ?(Ключ = "oshub.cache.guest_pages", Включён, Дефолт);
КонецФункции

Функция Текстом(Знач Ключ, Знач Дефолт = "") Экспорт
	Возврат ?(Ключ = "oshub.instance.url", АдресХаба, Дефолт);
КонецФункции

#КонецОбласти

#Область ФонИОбработчик

Процедура Запустить(Знач Задание) Экспорт
	Отложенные.Добавить(Задание);
КонецПроцедуры

Функция ВыполнитьФон() Экспорт
	Выполнено = Отложенные.Количество();
	Для Каждого Задание Из Отложенные Цикл
		Задание.Исполнить();
	КонецЦикла;
	Отложенные.Очистить();
	Возврат Выполнено;
КонецФункции

Функция СформироватьОтвет(Знач ВходящийЗапрос) Экспорт
	Сборок = Сборок + 1;
	ВходящийЗапрос.ШаблонМаршрута = Шаблон;
	Запросы.Добавить(ВходящийЗапрос);
	Ответ = Новый ОтветСтраницыКэшаЗаглушка(Код, Тело + " #" + Сборок, ТипКонтента);
	Если ЗначениеЗаполнено(КукаОтвета) Тогда
		Ответ.ВыдатьКуку(КукаОтвета, ЗначениеКукиОтвета);
	КонецЕсли;
	Возврат Ответ;
КонецФункции

// Запрос winow полями, которые читает кэш; шаблон маршрута ставит обработчик.
Функция Запрос(Знач Метод, Знач ПолныйПуть, Знач Куки = Неопределено, Знач Заголовки = Неопределено) Экспорт

	Части = СтрРазделить(ПолныйПуть + "?", "?");
	Путь = Части[0];
	Параметры = Новый Соответствие();
	Для Каждого Пара Из СтрРазделить(Части[1], "&", Ложь) Цикл
		Позиция = СтрНайти(Пара + "=", "=");
		Параметры.Вставить(Лев(Пара, Позиция - 1), Сред(Пара, Позиция + 1));
	КонецЦикла;
	Результат = Новый Структура("Идентификатор, Метод, Путь, ПолныйПуть, Заголовки, Куки, ПараметрыИменные,
		|ШаблонМаршрута, АдресУдаленногоУзла, Сессия", "1", Метод, Путь, ПолныйПуть,
		?(Заголовки = Неопределено, Новый Соответствие(), Заголовки),
		?(Куки = Неопределено, Новый КукиЗаглушка(), Куки), Параметры, "", "", Неопределено);
	Возврат Результат;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта() Экспорт
	Записи = Новый Соответствие();
	Отложенные = Новый Массив();
	Сборок = 0;
	Запросы = Новый Массив();
	Код = 200;
	Тело = "<html>страница</html>";
	ТипКонтента = "text/html; charset=utf-8";
	КукаОтвета = "";
	ЗначениеКукиОтвета = "значение";
	Пользователи = Новый Соответствие();
	Шаблон = "/pools/{pool}";
	Включён = Истина;
	ЧтенийВыключателя = 0;
	АдресХаба = "";
	ОпределенийПринципала = 0;
	ВыданоСессийWinow = 0;
КонецПроцедуры
