// Заглушка хаба для самотестов ЭкземплярХаба: порт OSHUB_PORT открывается, когда есть файл OSHUB_TEST_STUB_GATE
// (пусто — сразу); 200 на любой запрос, в журнал — непустые OSHUB_* «окружение ИМЯ=значение» и строка конца старта.

Функция КонецСтроки()
	Возврат Символы.ВК + Символы.ПС;
КонецФункции

// Читает запрос до пустой строки после заголовков: тела у проб фикстуры нет.
Процедура ДочитатьЗаголовки(Знач Соединение)

	Принято = "";
	Пока СтрНайти(Принято, КонецСтроки() + КонецСтроки()) = 0 Цикл
		Порция = Соединение.ПрочитатьДвоичныеДанные();
		Если Порция.Размер() = 0 Тогда
			Возврат;
		КонецЕсли;
		Принято = Принято + ПолучитьСтрокуИзДвоичныхДанных(Порция, "UTF-8");
	КонецЦикла;

КонецПроцедуры

Процедура Ответить(Знач Соединение)

	Попытка
		Соединение.ТаймаутЧтения = 2000;
		ДочитатьЗаголовки(Соединение);
		Соединение.ОтправитьСтроку("HTTP/1.1 200 OK" + КонецСтроки() + "Content-Type: text/plain" + КонецСтроки()
			+ "Content-Length: 2" + КонецСтроки() + "Connection: close" + КонецСтроки() + КонецСтроки() + "ok");
		Соединение.Закрыть();
	Исключение
		// клиент мог сдаться раньше ответа — заглушка ждёт следующего
	КонецПопытки;

КонецПроцедуры

Ворота = ПолучитьПеременнуюСреды("OSHUB_TEST_STUB_GATE");
Пока ЗначениеЗаполнено(Ворота) И НЕ Новый Файл(Ворота).Существует() Цикл
	Приостановить(50);
КонецЦикла;

// Порт занят — исключение и выход с ненулевым кодом, как у хаба: фикстура повторит старт на другом порту.
Порт = Число(ПолучитьПеременнуюСреды("OSHUB_PORT"));
Сервер = Новый TCPСервер(Порт);
Сервер.Запустить();

Для Каждого Переменная Из ПеременныеСреды() Цикл
	Если СтрНачинаетсяС(Переменная.Ключ, "OSHUB_") И ЗначениеЗаполнено(Переменная.Значение) Тогда
		Сообщить("окружение " + Переменная.Ключ + "=" + Переменная.Значение);
	КонецЕсли;
КонецЦикла;
Сообщить("Стартовые задачи завершены");

Пока Истина Цикл
	Соединение = Сервер.ОжидатьСоединения(200);
	Если Соединение <> Неопределено Тогда
		Ответить(Соединение);
	КонецЕсли;
КонецЦикла;
