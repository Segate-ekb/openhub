// Сценарий сторожа ОкружениеПрогона: переменная OSHUB_TEST_STUB_OUTER задана процессу до фикстур, сосед её
// переставляет, а затем стирает остановкой — журналы заглушек печатаются с метками «при соседе» и «после соседа».

#Использовать ".."

РеестрФикстур.Подключить("ЭкземплярХаба");
Каталог = ОбъединитьПути(КаталогиПроекта.Фикстуры(), "заглушка-хаба");
Сосед = Новый ЭкземплярХаба(30, Каталог);
ПриСоседе = Новый ЭкземплярХаба(30, Каталог);
ПослеСоседа = Новый ЭкземплярХаба(30, Каталог);

Попытка
	Сосед.Среда("OSHUB_TEST_STUB_OUTER", "чужое");
	Сосед.ЗапуститьВФоне();
	ПриСоседе.ЗапуститьВФоне();
	Сосед.Дождаться();
	ПриСоседе.Дождаться();
	Сосед.Остановить();
	ПослеСоседа.ЗапуститьВФоне();
	ПослеСоседа.Дождаться();
	Сообщить("при соседе: " + СтрЗаменить(ПриСоседе.ЖурналЦеликом(), Символы.ПС, " | при соседе: "));
	Сообщить("после соседа: " + СтрЗаменить(ПослеСоседа.ЖурналЦеликом(), Символы.ПС, " | после соседа: "));
Исключение
	Сосед.Остановить();
	ПриСоседе.Остановить();
	ПослеСоседа.Остановить();
	ВызватьИсключение;
КонецПопытки;

ПриСоседе.Остановить();
ПослеСоседа.Остановить();
