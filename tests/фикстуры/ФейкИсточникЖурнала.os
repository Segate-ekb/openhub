// Фейк источника журнала аудита (чтение файла лога): отдаёт заданную страницу
// и запоминает, с каким отбором, смещением и размером его спросили.

Перем Записи Экспорт;             // Массив из Структура — записи страницы
Перем ЕстьСледующая Экспорт;      // Булево
Перем Доступен Экспорт;           // Булево — читается ли файл журнала
Перем ХвостУсечён Экспорт;        // Булево — файл прочитан не целиком
Перем ПоследнийОтбор Экспорт;     // Структура — отбор последнего запроса
Перем ПоследнееСмещение Экспорт;
Перем ПоследнийРазмер Экспорт;

// Страница журнала по контракту источника.
//
// Параметры:
//  Отбор - Структура - Действие, Кто, С, По.
//  Смещение - Число - сколько записей пропустить.
//  Размер - Число - записей на странице.
//
// Возвращаемое значение:
//  Структура - Записи, ЕстьСледующая, Доступен, ХвостУсечён.
//
Функция Страница(Знач Отбор, Знач Смещение, Знач Размер) Экспорт

	ПоследнийОтбор = Отбор;
	ПоследнееСмещение = Смещение;
	ПоследнийРазмер = Размер;
	Возврат Новый Структура("Записи, ЕстьСледующая, Доступен, ХвостУсечён",
		Записи, ЕстьСледующая, Доступен, ХвостУсечён);

КонецФункции

// Добавляет запись в выдачу источника.
//
// Параметры:
//  Кто - Строка - субъект операции.
//  Действие - Строка - имя действия.
//  Объект - Строка - затронутый объект.
//
Процедура Добавить(Знач Кто, Знач Действие, Знач Объект) Экспорт

	Записи.Добавить(Новый Структура("Когда, Кто, Действие, Объект, Субъект, Детали, АдресIP",
		Дата(2026, 8, 3, 10, 0, 0), Кто, Действие, Объект, "", "{}", ""));

КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	ЕстьСледующая = Ложь;
	Доступен = Истина;
	ХвостУсечён = Ложь;
	ПоследнееСмещение = -1;
	ПоследнийРазмер = -1;
КонецПроцедуры
