// Фейковый ответ 1connector: код, заголовки и тело — двоичными, текстом либо разобранным JSON.
// Столько, сколько читают потребители: oidc-client берёт Текст и Json, адаптер исходящего
// HTTP — заголовки и двоичные данные.

Перем КодСостояния Экспорт;
Перем Заголовки Экспорт;
Перем ДвоичныеОтвета_;

// Задаёт код и текстовое тело ответа.
//
// Параметры:
//  Код  - Число  - код состояния HTTP.
//  Тело - Строка - тело ответа.
//
Процедура Установить(Знач Код, Знач Тело) Экспорт
	КодСостояния = Код;
	ДвоичныеОтвета_ = ПолучитьДвоичныеДанныеИзСтроки(?(Тело = Неопределено, "", Строка(Тело)));
КонецПроцедуры

// Тело ответа (контракт ПодготовленныйОтвет 1connector).
//
// Возвращаемое значение:
//  ДвоичныеДанные - тело ответа либо Неопределено.
//
Функция ДвоичныеДанные() Экспорт
	Возврат ДвоичныеОтвета_;
КонецФункции

// Тело ответа строкой.
//
// Возвращаемое значение:
//  Строка - тело; тела нет — пустая строка.
//
Функция Текст() Экспорт
	Возврат ?(ДвоичныеОтвета_ = Неопределено, "", ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеОтвета_));
КонецФункции

// Тело ответа, разобранное как JSON; неразбираемое тело — исключение, как у 1connector.
//
// Возвращаемое значение:
//  Соответствие, Массив, Произвольный - разобранное тело.
//
Функция Json() Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст());
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

Процедура ПриСозданииОбъекта(Знач Код = 200, Знач Двоичные = Неопределено, Знач ЗаголовкиОтвета = Неопределено)
	КодСостояния = Код;
	ДвоичныеОтвета_ = Двоичные;
	Заголовки = ?(ЗаголовкиОтвета = Неопределено, Новый Соответствие(), ЗаголовкиОтвета);
КонецПроцедуры
