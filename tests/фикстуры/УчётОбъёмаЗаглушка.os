// Заглушка УчётаОбъёмаПула: копит дельты занятого по имени пула, чтобы тест мог
// проверить, что записавший или удаливший байты сообщил о них.

Перем Дельты_;  // Соответствие имя пула -> накопленная дельта, байты

// Контракт УчётаОбъёмаПула: принимает изменение занятого пулом места.
//
// Параметры:
//  Пул - Произвольный - объект пула (нужно поле Имя).
//  ДельтаБайт - Число - приращение объёма; отрицательное уменьшает.
//
// Возвращаемое значение:
//  Структура - Пул, ЗанятоДо, ЗанятоПосле; Неопределено для пустого пула.
//
Функция Учесть(Знач Пул, Знач ДельтаБайт) Экспорт

	Если Пул = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Имя = Строка(Пул.Имя);
	До = Дельта(Имя);
	После = До + Цел(Число(ДельтаБайт));
	Дельты_.Вставить(Имя, После);

	Возврат Новый Структура("Пул, ЗанятоДо, ЗанятоПосле", Пул, До, После);

КонецФункции

// Накопленная дельта занятого по пулу.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//
// Возвращаемое значение:
//  Число - сумма сообщённых дельт, байты; 0, если о пуле не сообщали.
//
Функция Дельта(Знач ИмяПула) Экспорт
	Значение = Дельты_.Получить(Строка(ИмяПула));
	Возврат ?(Значение = Неопределено, 0, Значение);
КонецФункции

// Сколько пулов упоминалось в сообщениях об изменении занятого.
//
// Возвращаемое значение:
//  Число.
//
Функция ЧислоПулов() Экспорт
	Возврат Дельты_.Количество();
КонецФункции

Процедура ПриСозданииОбъекта()
	Дельты_ = Новый Соответствие();
КонецПроцедуры
