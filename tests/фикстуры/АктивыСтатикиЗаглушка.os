// Заглушка белого списка статики: объявленное имя отдаётся с типом, меткой и путём.
// Позволяет собрать расхождение «в списке есть, на диске нет», которого на живом хабе
// не собрать: список строится сканом того же диска.

Перем Типы;
Перем Метки;
Перем Пути;

// Объявляет имя в белом списке.
//
// Параметры:
//  Имя         - Строка - публичное имя файла.
//  ТипКонтента - Строка - Content-Type отдачи.
//  Метка       - Строка - значение ETag; допускается пустое.
//  Путь        - Строка - путь на диске; несуществующий — расхождение со списком.
//
Процедура Объявить(Знач Имя, Знач ТипКонтента, Знач Метка, Знач Путь) Экспорт
	Типы.Вставить(Имя, ТипКонтента);
	Метки.Вставить(Имя, Метка);
	Пути.Вставить(Имя, Путь);
КонецПроцедуры

// Контракт АктивыСтатики: тип контента либо Неопределено для имени вне списка.
//
// Параметры:
//  Имя - Строка - публичное имя файла.
//
// Возвращаемое значение:
//  Строка, Неопределено
//
Функция ТипКонтента(Знач Имя) Экспорт
	Возврат Типы.Получить(Имя);
КонецФункции

// Контракт АктивыСтатики: метка ресурса.
//
// Параметры:
//  Имя - Строка - публичное имя файла.
//
// Возвращаемое значение:
//  Строка - значение ETag либо "" для неизвестного имени.
//
Функция ETag(Знач Имя) Экспорт
	Значение = Метки.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", Значение);
КонецФункции

// Контракт АктивыСтатики: путь на диске либо Неопределено для имени вне списка.
//
// Параметры:
//  Имя - Строка - публичное имя файла.
//
// Возвращаемое значение:
//  Строка, Неопределено
//
Функция ПутьНаДиске(Знач Имя) Экспорт
	Возврат Пути.Получить(Имя);
КонецФункции

Процедура ПриСозданииОбъекта()
	Типы = Новый Соответствие();
	Метки = Новый Соответствие();
	Пути = Новый Соответствие();
КонецПроцедуры
