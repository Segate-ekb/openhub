// Летопись пульта журнала для контейнера без журнала аудита: желудь под именем
// ЛетописьПультаЖурнала, который копит правки вместо записи — набор видит, что ушло бы в аудит.

Перем Записи Экспорт;   // Массив из Структура — Действие, Правка

// Контракт летописи: правка пульта.
//
// Параметры:
//  Правка - Структура - Что, Кто, АдресIP, Когда, Было, Стало, Пропущены, Возвращено.
//
Процедура Записать(Знач Правка) Экспорт
	Записи.Добавить(Новый Структура("Действие, Правка", Правка.Что, Правка));
КонецПроцедуры

// Последняя записанная правка.
//
// Возвращаемое значение:
//  Структура, Неопределено - Действие, Правка; Неопределено — записей нет.
//
Функция Последняя() Экспорт
	Возврат ?(Записи.Количество() = 0, Неопределено, Записи[Записи.ВГраница()]);
КонецФункции

&Прозвище("ЛетописьПультаЖурнала")
&Желудь
Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
КонецПроцедуры
