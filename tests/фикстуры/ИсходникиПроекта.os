// Фикстура: чтение файлов проекта дисциплинарными наборами — содержимое строкой
// и путь относительно корня репозитория для внятного сообщения об ошибке.

Перем Корень_;

// Корень репозитория.
//
// Возвращаемое значение:
//  Строка - полный путь корня проекта.
//
Функция Корень() Экспорт
	Возврат Корень_;
КонецФункции

// Содержимое файла строкой (UTF-8). Пустой файл даёт пустую строку, а не Неопределено.
//
// Параметры:
//  Путь - Строка - полное имя файла.
//
// Возвращаемое значение:
//  Строка - содержимое файла.
//
Функция Текст(Знач Путь) Экспорт

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат ?(Содержимое = Неопределено, "", Содержимое);

КонецФункции

// Путь относительно корня проекта, разделителями «/» — в таком виде его читает человек
// в сообщении упавшего сторожа.
//
// Параметры:
//  Путь - Строка - полное имя файла.
//
// Возвращаемое значение:
//  Строка - относительный путь без ведущего разделителя.
//
Функция ОтносительныйПуть(Знач Путь) Экспорт

	Относительный = СтрЗаменить(СтрЗаменить(Путь, Корень_, ""), "\", "/");

	Если СтрНачинаетсяС(Относительный, "/") Тогда
		Относительный = Сред(Относительный, 2);
	КонецЕсли;

	Возврат Относительный;

КонецФункции

Процедура ПриСозданииОбъекта(Знач КаталогПроекта = "")

	Если ЗначениеЗаполнено(КаталогПроекта) Тогда
		Корень_ = КаталогПроекта;
		Возврат;
	КонецЕсли;

	КаталогФикстур = Новый Файл(ТекущийСценарий().Источник).Путь;
	Корень_ = Новый Файл(ОбъединитьПути(КаталогФикстур, "..", "..")).ПолноеИмя;

КонецПроцедуры
