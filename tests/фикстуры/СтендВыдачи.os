// Стенд выдачи без живого хаба: контейнер ОСени на КоннекторInMemory, хранилище — S3 над
// фейковым клиентом со счётом обращений, кэши — по деталькам набора, контроллер выдачи
// собран руками. Набор подключает autumn-cache сам: без неё кэши не оборачиваются.

#Использовать autumn
#Использовать autumn-data
#Использовать entity

Перем Поделка;
Перем Засев Экспорт;          // ЗасевРеестра — пул службами хаба
Перем Апстримы Экспорт;       // СтендАпстримов — строка источника пула
Перем ПоискКлассов;           // КлассыСлоя — файл класса ищется по имени

// Желудь контейнера стенда.
//
// Параметры:
//  Имя - Строка - имя желудя.
//
// Возвращаемое значение:
//  Произвольный - желудь.
//
Функция Желудь(Знач Имя) Экспорт
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

// Фейковый клиент S3 хранилища стенда: считает обращения к хранилищу.
//
// Возвращаемое значение:
//  ФейкКлиентS3.
//
Функция КлиентS3() Экспорт
	Возврат Желудь("КлиентS3Набора");
КонецФункции

// Публикует версию 1.0.0 нового пакета в новом публичном пуле без источников.
//
// Параметры:
//  Содержимое - Строка - содержимое артефакта.
//
// Возвращаемое значение:
//  Структура - Пул, Пакет, Координаты, Версия, Данные (ДвоичныеДанные), Sha256.
//
Функция Опубликовать(Знач Содержимое) Экспорт

	Пул = Засев.ПулСервисом();
	ИмяПакета = УникальныеИмена.Имя("pkg");

	Пакет = Желудь("СервисПакетов").НайтиИлиЗарегистрировать(Пул.Идентификатор, ИмяПакета);
	Желудь("КаналыПоУмолчанию").Создать(Пакет.Идентификатор);

	Координаты = Новый КоординатыАртефакта(Пул.Имя, Пакет.Имя, "1.0.0");
	Данные = ПолучитьДвоичныеДанныеИзСтроки(Содержимое);
	Сохранено = Желудь("ХранилищеАртефактов").Сохранить(Координаты, Данные);

	Заявка = Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "1.0.0");
	Заявка.Размер = Сохранено.Размер;
	Заявка.Sha256 = Сохранено.Sha256;
	Заявка.ПутьВХранилище = СтрШаблон("pools/%1/%2/%2-1.0.0.ospx", Пул.Имя, Пакет.Имя);
	Версия = Желудь("СервисВерсий").Опубликовать(Заявка);

	Возврат Новый Структура("Пул, Пакет, Координаты, Версия, Данные, Sha256",
		Пул, Пакет, Координаты, Версия, Данные, Сохранено.Sha256);

КонецФункции

// Ответ маршрута выдачи на запрос файла пакета.
//
// Параметры:
//  Выпуск - Структура - результат Опубликовать.
//  Метод - Строка - GET либо HEAD (необязательный, по умолчанию "GET").
//  Метка - Строка - значение If-None-Match (необязательный, по умолчанию "" — без метки).
//  ИмяФайла - Строка - имя файла в адресе (необязательный, по умолчанию "" — версия 1.0.0).
//
// Возвращаемое значение:
//  ОтветСтраницыЗаглушка - ответ маршрута.
//
Функция Выдать(Знач Выпуск, Знач Метод = "GET", Знач Метка = "", Знач ИмяФайла = "") Экспорт

	Заголовки = Новый Соответствие();
	Если ЗначениеЗаполнено(Метка) Тогда
		Заголовки.Вставить("If-None-Match", Метка);
	КонецЕсли;

	Сборка = Новый СборкаКонтроллераВыдачи(Логирование.ПолучитьЛог("тест.oshub.стендвыдачи"));
	Сборка.Резолвер = Желудь("РезолверВыдачи");
	Сборка.СервисПулов = Желудь("СервисПулов");
	Сборка.Права = Новый СервисПрав(Неопределено, Неопределено, Неопределено, Неопределено);

	Ответ = Новый ОтветСтраницыЗаглушка(Новый КукиОтветаЗаглушка());
	Сборка.Собрать().ФайлПула(Ответ, Выпуск.Пул.Имя, Выпуск.Пакет.Имя,
		?(ЗначениеЗаполнено(ИмяФайла), ИмяФайла, Выпуск.Пакет.Имя + "-1.0.0.ospx"),
		Метод, Заголовки, Новый КукиЗаглушка());

	Возврат Ответ;

КонецФункции

// Хранилище контейнера даёт фабрика стенда, поэтому своя фабрика модуля и боевой клиент S3
// не подключаются.
Процедура ПодключитьХранилищеБезФабрики(Знач Каталог)

	Для Каждого Файл Из ПоискКлассов.ФайлыКлассов(Каталог) Цикл
		Если Файл.ИмяБезРасширения <> "КонфигурацияХранилища" И Файл.ИмяБезРасширения <> "КлиентS3Oint" Тогда
			ПоискКлассов.ПодключитьФайл(Файл.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Параметры:
//  ДеталькиНабора - Соответствие - детальки набора (кэши); стенд добавляет к ним свои.
//  ИмяБазы - Строка - строка соединения КоннекторInMemory: у каждого набора своя база.
//  ДопСлои - Строка - слои продукта сверх выдачи через запятую, как у СлоиКонтейнера
//            (необязательный, по умолчанию "" — только выдача).
//
Процедура ПриСозданииОбъекта(Знач ДеталькиНабора, Знач ИмяБазы, Знач ДопСлои = "")

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	РеестрФикстур.Подключить("СтендАпстримов");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогПроекта = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..", "..");
	КаталогМодулей = Новый Файл(ОбъединитьПути(КаталогПроекта, "src", "модули")).ПолноеИмя;
	Для Каждого Модуль Из СтрРазделить("данные,настройки,реестр,происшествия,прокси,сеть,события,аудит", ",") Цикл
		ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, Модуль, "Классы"));
	КонецЦикла;
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	ПодключитьХранилищеБезФабрики(ОбъединитьПути(КаталогМодулей, "хранилище", "Классы"));
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы", "пробы"),
		"ГотовностьХаба");
	Если ЗначениеЗаполнено(ДопСлои) Тогда
		РеестрФикстур.Подключить("СлоиКонтейнера");
		Слои = Новый СлоиКонтейнера(ПоискКлассов, КаталогМодулей);
		Слои.Подключить(ДопСлои);
	КонецЕсли;

	РеестрФикстур.Подключить("ГейтАпстримов");
	Гейт = Новый ГейтАпстримов();
	Гейт.Подключить();
	РеестрФикстур.Подключить("ЖурналАудитаФайлом");
	РеестрФикстур.Подключить("ФейкКлиентS3");
	РеестрФикстур.Подключить("ХранилищеНаФейкеS3");

	Детальки = Новый Соответствие();
	Для Каждого КлючИЗначение Из ДеталькиНабора Цикл
		Детальки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Детальки.Вставить("oshub.storage.backend", "s3");
	Детальки.Вставить("oshub.upstream.probe.enabled", "false");

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", ИмяБазы);
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);
	Апстримы = Новый СтендАпстримов(Поделка);

	// контроллер выдачи и права собираются руками: подключённые после контейнера, желудями они не станут
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "api", "Классы"), "РезолверФайлаПакета");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "api", "Классы"), "КонтроллерВыдачиAPI");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "права", "Классы"), "СервисПрав");
	РеестрФикстур.Подключить("СборкаКонтроллераВыдачи");
	РеестрФикстур.Подключить("ДопускКПулуЗаглушка");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("КукиОтветаЗаглушка");
	РеестрФикстур.Подключить("КукиЗаглушка");

КонецПроцедуры
