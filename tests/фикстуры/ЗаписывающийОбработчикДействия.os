// Фикстура: обработчик доставки стороннего типа действия «тест.запись» — доказательство, что новый
// тип добавляется без правки ядра подписок. Доставки пишутся в память, неуспех задаётся тестом.

Перем Доставки;       // Массив из Структура {Канал, ТипСобытия, Тело, НомерПопытки}
Перем ОтказПроверки;  // Строка — не пусто: ПередДоставкой отвечает «не Ок» с этим текстом
Перем БроситьПроверку; // Булево — ПередДоставкой бросает исключение (контракт нарушен)
Перем ОтветУспех;     // Булево — что возвращает Доставить

// Контракт обработчика доставки: обслуживаемый тип действия подписки.
//
// Возвращаемое значение:
//  Строка - "тест.запись".
//
Функция ТипДействия() Экспорт
	Возврат "тест.запись";
КонецФункции

// Контракт обработчика доставки: проверка задания перед отправкой.
// Бросает исключение, если фикстуре задано УстановитьИсключениеПроверки.
//
// Параметры:
//  Задание - Структура - задание доставки.
//
// Возвращаемое значение:
//  Структура (Ок, Ошибка) - вердикт проверки.
//
Функция ПередДоставкой(Знач Задание) Экспорт
	Если БроситьПроверку Тогда
		ВызватьИсключение "ЗаписывающийОбработчикДействия: эмуляция сбоя проверки";
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтказПроверки) Тогда
		Возврат Новый Структура("Ок, Ошибка", Ложь, ОтказПроверки);
	КонецЕсли;
	Возврат Новый Структура("Ок, Ошибка", Истина, "");
КонецФункции

// Контракт обработчика доставки: записывает доставку в память.
//
// Параметры:
//  Задание - Структура - задание доставки (Действие, ТипСобытия, Тело, НомерПопытки).
//
// Возвращаемое значение:
//  Булево - успех доставки; переключается методом УстановитьНеуспех.
//
Функция Доставить(Знач Задание) Экспорт
	Доставки.Добавить(Новый Структура("Канал, ТипСобытия, Тело, НомерПопытки",
		Задание.Действие.Канал, Задание.ТипСобытия, Задание.Тело, Задание.НомерПопытки));
	Возврат ОтветУспех;
КонецФункции

// Заставляет ПередДоставкой отвечать отказом с заданным текстом.
//
// Параметры:
//  Текст - Строка - текст отказа; пусто — проверка снова успешна.
//
Процедура УстановитьОтказПроверки(Знач Текст) Экспорт
	ОтказПроверки = Текст;
КонецПроцедуры

// Заставляет ПередДоставкой бросать исключение — нарушение контракта обработчика.
Процедура УстановитьИсключениеПроверки() Экспорт
	БроситьПроверку = Истина;
КонецПроцедуры

// Заставляет Доставить возвращать неуспех — для проверки ретраев ядра.
Процедура УстановитьНеуспех() Экспорт
	ОтветУспех = Ложь;
КонецПроцедуры

// Число записанных доставок.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоДоставок() Экспорт
	Возврат Доставки.Количество();
КонецФункции

// Последняя записанная доставка.
//
// Возвращаемое значение:
//  Структура (Канал, ТипСобытия, Тело, НомерПопытки), Неопределено - Неопределено, если
//   доставок не было.
//
Функция ПоследняяДоставка() Экспорт
	Если Доставки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Доставки[Доставки.Количество() - 1];
КонецФункции

Процедура ПриСозданииОбъекта()
	Доставки = Новый Массив();
	ОтказПроверки = "";
	БроситьПроверку = Ложь;
	ОтветУспех = Истина;
КонецПроцедуры
