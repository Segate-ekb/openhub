// Заглушка РендерерНастроек для юнит-тестов контроллеров: имя поля CSRF и пустая секция.

// Имя скрытого поля CSRF.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляCSRF() Экспорт
	Возврат "_csrf";
КонецФункции

// Описание секции раздела.
//
// Параметры:
//  Заголовок - Строка - заголовок секции.
//  Пояснение - Строка - пояснение секции (необязательный, по умолчанию "").
//  Тело - Строка - разметка тела (необязательный, по умолчанию "").
//
// Возвращаемое значение:
//  Структура - описание секции.
//
Функция Секция(Знач Заголовок, Знач Пояснение = "", Знач Тело = "") Экспорт
	Возврат Новый Структура("Заголовок, Пояснение, Тело, Действие, Токен, Иконка, Класс",
		Заголовок, Пояснение, Тело, "", "", "", "");
КонецФункции

// Отрисовывает дом настроек.
//
// Параметры:
//  Модель - Структура - модель дома.
//
// Возвращаемое значение:
//  Строка.
//
Функция Отрисовать(Знач Модель) Экспорт
	Модель = Модель;
	Возврат "";
КонецФункции
