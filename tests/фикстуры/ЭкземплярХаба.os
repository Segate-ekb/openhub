// Жизненный цикл тестового хаба в отдельном процессе: порт, окружение, запуск, готовность, остановка;
// сироты внешнего снятия прогона находятся по метке OSHUB_TEST_RUN.

Перем Выдача;
Перем Процесс;
Перем НомерПорта;
Перем Переменные;        // Соответствие: имя переменной окружения → значение (для чистки)
Перем КорневойКаталог;   // корень репозитория
Перем ТаймаутСек;
Перем ВременныйКорень;   // каталог, созданный ФайловаяБаза() — удаляется в Остановить()
Перем ПопытокПорта;
Перем ПоследнийPID;      // PID последнего запущенного процесса — для доказательств «сироты нет»
Перем Метка;             // OSHUB_TEST_RUN: по ней внешняя чистка находит подопытные хабы
Перем НакопленныйВывод;  // stdout+stderr, вычитанные ранее (поток отдаёт данные ОДИН раз)
Перем ВнешнийАдрес;      // адрес хаба, поднятого вне набора; пусто — хаб свой
Перем ЖурналВФайл;       // Булево: вывод хаба — в файл, процесс не держится за канал поднявшего
Перем ПутьЖурнала;       // файл журнала хаба; пусто — журнал в канале процесса
Перем ПрочитаноБайт;     // сколько байт файла журнала уже в НакопленныйВывод
Перем КаталогЖурнала;    // временный каталог журнала вне ВременныйКорень — удаляется в Остановить()
Перем ИсточникВнешнего;  // откуда экземпляр знает внешний хаб — для текстов отказа

// Конструктор.
//
// Параметры:
//  ТаймаутГотовностиСек - Число  - сколько ждать ответа /health (необязательный, по умолчанию 90).
//  КаталогПроекта       - Строка - корень репозитория; пусто — корень этого репозитория
//                         (необязательный, по умолчанию "").
//
Процедура ПриСозданииОбъекта(Знач ТаймаутГотовностиСек = 90, Знач КаталогПроекта = "") Экспорт

	ТаймаутСек = ТаймаутГотовностиСек;
	ПопытокПорта = 3;
	Переменные = Новый Соответствие();
	НомерПорта = 0;
	ПоследнийPID = 0;
	ВременныйКорень = "";
	Метка = "openhub-тест-" + Строка(Новый УникальныйИдентификатор());
	НакопленныйВывод = "";
	ВнешнийАдрес = "";
	ЖурналВФайл = Ложь;
	ПутьЖурнала = "";
	ПрочитаноБайт = 0;
	КаталогЖурнала = "";
	ИсточникВнешнего = "";

	Если ЗначениеЗаполнено(КаталогПроекта) Тогда
		КорневойКаталог = КаталогПроекта;
	Иначе
		КорневойКаталог = КаталогиПроекта.Корень();
	КонецЕсли;

	Выдача = НоваяВыдачаПортов();

КонецПроцедуры

#Область Окружение

// Ставит переменную окружения прямо сейчас (её унаследуют и сидеры) и запоминает,
// чтобы очистить в Остановить().
//
// Параметры:
//  Имя      - Строка - имя переменной (OSHUB_*).
//  Значение - Строка - значение переменной.
//
Процедура Среда(Знач Имя, Знач Значение) Экспорт

	ОтказатьВнешнему("Среда(""" + Имя + """)");
	Переменные.Вставить(Имя, Значение);
	УстановитьПеременнуюСреды(Имя, Значение);

КонецПроцедуры

// Ставит переменную только тогда, когда набор не назвал её сам: умолчание фикстуры
// выбор набора не перебивает.
Процедура ПоУмолчанию(Знач Имя, Знач Значение)

	Если Переменные.Получить(Имя) = Неопределено Тогда
		Среда(Имя, Значение);
	КонецЕсли;

КонецПроцедуры

// Готовит окружение «файловая БД + файловое хранилище» во временном каталоге,
// который удаляется в Остановить().
//
// Параметры:
//  Префикс - Строка - префикс имени временного каталога.
//
// Возвращаемое значение:
//  Строка - корень созданного каталога (внутри — db и storage).
//
Функция ФайловаяБаза(Знач Префикс) Экспорт

	ОтказатьВнешнему("ФайловаяБаза()");
	ВременныйКорень = УникальныеИмена.ВременныйПуть(Префикс);
	СоздатьКаталог(КаталогБазы());
	СоздатьКаталог(КореньХранилища());

	// ТИП коннектора не задаём: должен действовать продуктовый дефолт КоннекторJSON.
	Среда("OSHUB_DB_CONNECTION", КаталогБазы());
	Среда("OSHUB_STORAGE_ROOT", КореньХранилища());

	Возврат ВременныйКорень;

КонецФункции

// Каталог файловой БД внутри временного корня.
//
// Возвращаемое значение:
//  Строка - путь каталога.
//
Функция КаталогБазы() Экспорт
	Возврат ОбъединитьПути(ВременныйКорень, "db");
КонецФункции

// Корень файлового хранилища внутри временного корня.
//
// Возвращаемое значение:
//  Строка - путь каталога.
//
Функция КореньХранилища() Экспорт
	Возврат ОбъединитьПути(ВременныйКорень, "storage");
КонецФункции

// Гасит фоновые задачи и доставку вебхуков: обработчик запроса и фоновая задача в одном
// процессе делят файлы файловой базы и ловят блокировку.
//
Процедура ВыключитьФон() Экспорт
	ОтказатьВнешнему("ВыключитьФон()");
	Среда("OSHUB_JOBS_ENABLED", "false");
	ВыключитьДоставкуВебхуков();
КонецПроцедуры

// Гасит фоновую доставку вебхуков — она ходит в сеть. Детальку delivery_enabled
// переменная окружения называет двойным подчёркиванием.
//
Процедура ВыключитьДоставкуВебхуков() Экспорт
	ОтказатьВнешнему("ВыключитьДоставкуВебхуков()");
	Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
КонецПроцедуры

#КонецОбласти

#Область ВнешнийХаб

// Подключает экземпляр к хабу, поднятому вне набора на этой машине: своего процесса нет,
// Остановить() ничего не гасит, ожидание онбординга — проверка /health. Окружение, база, сидер
// и запуск у внешнего хаба свои: их методы отказывают исключением.
//
// Параметры:
//  Адрес      - Строка - адрес хаба: «http://127.0.0.1:<порт>» или «http://localhost:<порт>».
//  ЖурналХаба - Строка - файл журнала внешнего хаба; пусто — журнала у экземпляра нет
//               (необязательный, по умолчанию "").
//  Источник   - Строка - откуда взят адрес — для текстов отказа («общий хаб группы «витрина»
//               (OSHUB_TEST_HUB_SHOWCASE)»); необязательный, по умолчанию "внешний хаб".
//
Процедура ПодключитьсяКВнешнему(Знач Адрес, Знач ЖурналХаба = "", Знач Источник = "") Экспорт

	Источник = ?(ЗначениеЗаполнено(Источник), Источник, "внешний хаб");
	// Остановить() у внешнего ничего не гасит: свой процесс и каталог остались бы сиротами
	Если Процесс <> Неопределено ИЛИ ЗначениеЗаполнено(ВременныйКорень) Тогда
		ВызватьИсключение СтрШаблон("%1 (%2): экземпляр уже поднял свой хаб (порт %3, каталог «%4») —"
			+ " сначала Остановить(), потом подключаться к внешнему.", Источник, Адрес, НомерПорта, ВременныйКорень);
	КонецЕсли;

	Разбор =Новый РегулярноеВыражение("^https?://([^/:]+):([^/]*)/?$");
	Совпадения = Разбор.НайтиСовпадения(СокрЛП(Адрес));
	Если Совпадения.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон("%1: адрес «%2» не похож на «http://127.0.0.1:<порт>».", Источник, Адрес);
	КонецЕсли;

	Хост = НРег(Совпадения[0].Группы[1].Значение);
	Если Хост <> "127.0.0.1" И Хост <> "localhost" Тогда
		ВызватьИсключение СтрШаблон("%1: адрес «%2» — хост «%3» не локальный; общий хаб поднимается"
			+ " на этой машине (127.0.0.1 или localhost).", Источник, Адрес, Хост);
	КонецЕсли;

	ПортАдреса = Совпадения[0].Группы[2].Значение;
	Если НЕ Новый РегулярноеВыражение("^[0-9]{1,5}$").Совпадает(ПортАдреса) Тогда
		ВызватьИсключение СтрШаблон("%1: адрес «%2» — порт «%3» пуст или не число.", Источник, Адрес, ПортАдреса);
	КонецЕсли;

	ВнешнийАдрес = Адрес;
	ИсточникВнешнего = Источник;
	НомерПорта = Число(ПортАдреса);
	// журнал общего хаба — с момента подключения: строки инструмента и прежних наборов не в счёт
	ПутьЖурнала = ЖурналХаба;
	НакопленныйВывод = "";
	ПрочитаноБайт = РазмерЖурнала();

КонецПроцедуры

// Подключён ли экземпляр к хабу, поднятому вне набора.
//
// Возвращаемое значение:
//  Булево - Истина для внешнего хаба.
//
Функция Внешний() Экспорт
	Возврат ЗначениеЗаполнено(ВнешнийАдрес);
КонецФункции

// Велит вести журнал хаба в файле временного каталога, а не в канале: процесс хаба тогда
// переживает поднявший его процесс. Вызывать до Запустить().
//
Процедура ВестиЖурналВФайле() Экспорт
	ЖурналВФайл = Истина;
КонецПроцедуры

// Файл журнала хаба.
//
// Возвращаемое значение:
//  Строка - полный путь; пусто — журнал в канале процесса либо у внешнего хаба его нет.
//
Функция ФайлЖурнала() Экспорт
	Возврат ПутьЖурнала;
КонецФункции

// Журнал хаба целиком, со строк старта: у журнала в файле — весь файл (у внешнего хаба — и строки
// до подключения), Дамп() отдал бы только хвост в 200 строк; журнал в канале — Дамп().
//
// Возвращаемое значение:
//  Строка - текст журнала.
//
Функция ЖурналЦеликом() Экспорт

	Если НЕ ЗначениеЗаполнено(ПутьЖурнала) Тогда
		Возврат Дамп();
	КонецЕсли;

	Если НЕ Новый Файл(ПутьЖурнала).Существует() Тогда
		ВызватьИсключение СтрШаблон("Файла журнала хаба нет: %1", ПутьЖурнала);
	КонецЕсли;

	// хаб держит файл открытым на запись: читаем без монопольного захвата
	Чтение = Новый ЧтениеТекста(ПутьЖурнала, "UTF-8", , , Ложь);
	Текст = Строка(Чтение.Прочитать());
	Чтение.Закрыть();
	Возврат Текст;

КонецФункции

#КонецОбласти

#Область ЖизненныйЦикл

// Поднимает хаб на файловой базе во временном каталоге: окружение, засев, запуск.
// При неудаче на любом шаге хаб останавливается: окружение и каталог не достаются соседям.
//
// Параметры:
//  Префикс   - Строка - префикс имени временного каталога базы и хранилища.
//  Окружение - Соответствие, Структура - переменные окружения хаба: имя → значение
//              (необязательный, по умолчанию без них).
//  Сидер     - Строка, Массив, ФиксированныйМассив - имена сидеров из scripts/сидеры или полные пути
//              к ним по порядку; Неопределено и пустые строки пропускаются (необязательный).
//
// Возвращаемое значение:
//  Строка - корень временного каталога хаба (внутри — db и storage), см. ФайловаяБаза().
//
Функция Поднять(Знач Префикс, Знач Окружение = Неопределено, Знач Сидер = "") Экспорт

	ОтказатьВнешнему("Поднять()");

	Попытка

		Корень = ФайловаяБаза(Префикс);

		Если Окружение <> Неопределено Тогда
			Для Каждого Переменная Из Окружение Цикл
				Среда(Переменная.Ключ, Переменная.Значение);
			КонецЦикла;
		КонецЕсли;

		Для Каждого Имя Из СписокСидеров(Сидер) Цикл
			ЗапуститьСидер(ПутьСидера(Имя));
		КонецЦикла;

		Запустить();

	Исключение
		Остановить();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Корень;

КонецФункции

// Сидеры параметра «Сидер» метода Поднять() списком по порядку запуска.
//
// Параметры:
//  Сидер - Строка, Массив из Строка, ФиксированныйМассив из Строка, Неопределено - один сидер,
//          несколько или ни одного.
//
// Возвращаемое значение:
//  Массив из Строка - новый массив в том же порядке, без пустых строк; пусто и Неопределено — пустой.
//
Функция СписокСидеров(Знач Сидер) Экспорт

	Сидеры = Новый Массив();
	Если ТипЗнч(Сидер) = Тип("Массив") Или ТипЗнч(Сидер) = Тип("ФиксированныйМассив") Тогда
		Для Каждого Имя Из Сидер Цикл
			Если ЗначениеЗаполнено(Имя) Тогда
				Сидеры.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(Сидер) Тогда
		Сидеры.Добавить(Сидер);
	КонецЕсли;
	Возврат Сидеры;

КонецФункции

// Путь сидера проекта по имени файла.
//
// Параметры:
//  Имя - Строка - имя файла из scripts/сидеры либо уже полный путь.
//
// Возвращаемое значение:
//  Строка - полный путь к сидеру.
//
Функция ПутьСидера(Знач Имя) Экспорт

	Если Новый Файл(Имя).Имя <> Имя Тогда
		Возврат Имя;
	КонецЕсли;

	Возврат ОбъединитьПути(КорневойКаталог, "scripts", "сидеры", Имя);

КонецФункции

// Поднимает хаб на свободном порту и ждёт завершения старта и /health.
// При неудаче процесс убивается, порт возвращается в оборот, исключение пробрасывается.
//
Процедура Запустить() Экспорт

	ОтказатьВнешнему("Запустить()");

	Для НомерПопытки = 1 По ПопытокПорта Цикл

		НомерПорта = Выдача.Выдать();
		Среда("OSHUB_PORT", Формат(НомерПорта, "ЧГ=0; ЧН=0"));
		Среда("OSHUB_TEST_RUN", Метка);

		ПоднятьПроцесс();

		Попытка
			// Сперва ЖУРНАЛ, потом HTTP: строка старта появляется раньше открытия порта.
			ДождатьсяЗавершенияСтарта();
			ДождатьсяГотовности();
			Возврат;
		Исключение

			Инфо = ИнформацияОбОшибке();
			// Хаб умер сам — порт перехвачен в микроокне между пробой и bind'ом; только тут ретрай.
			ПортПерехвачен = Процесс.Завершен;
			ДиагностикаПроцесса = Дамп();

			ЗавершитьПроцесс();
			Выдача.Вернуть(НомерПорта);
			НомерПорта = 0;

			Если НЕ ПортПерехвачен ИЛИ НомерПопытки = ПопытокПорта Тогда
				ОчиститьОкружение();
				ВызватьИсключение СтрШаблон("Хаб не поднялся (попытка %1 из %2): %3%4",
					НомерПопытки, ПопытокПорта, ПодробноеПредставлениеОшибки(Инфо),
					?(ЗначениеЗаполнено(ДиагностикаПроцесса), " | вывод: " + ДиагностикаПроцесса, ""));
			КонецЕсли;

		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// Поднимает хаб и сразу возвращает управление: ни готовности, ни ретрая по перехвату
// порта. Для наборов, проверяющих сам старт. Порт уже выдан и виден через Порт().
//
Процедура ЗапуститьБезОжидания() Экспорт

	ОтказатьВнешнему("ЗапуститьБезОжидания()");
	НомерПорта = Выдача.Выдать();
	Среда("OSHUB_PORT", Формат(НомерПорта, "ЧГ=0; ЧН=0"));
	Среда("OSHUB_TEST_RUN", Метка);

	ПоднятьПроцесс();

КонецПроцедуры

// Ждёт ответа хаба по HTTP — для набора, поднявшегося без ожидания.
//
// Параметры:
//  ТаймаутОжиданияСек - Число - предел ожидания; 0 — таймаут экземпляра
//                       (необязательный, по умолчанию 0).
//
Процедура Дождаться(Знач ТаймаутОжиданияСек = 0) Экспорт

	Прежний = ТаймаутСек;
	Если ТаймаутОжиданияСек > 0 Тогда
		ТаймаутСек = ТаймаутОжиданияСек;
	КонецЕсли;

	Попытка
		ДождатьсяГотовности();
	Исключение
		ТаймаутСек = Прежний;
		ВызватьИсключение;
	КонецПопытки;

	ТаймаутСек = Прежний;

КонецПроцедуры

// Подбирает накопившийся вывод хаба: буфер канала конечен, переполнив его, хаб
// блокируется на записи в stdout и перестаёт отвечать. Вызывать только из одного потока.
//
Процедура ПодобратьВывод() Экспорт
	ДочитатьВывод();
КонецПроцедуры

// Строка журнала, которой хаб отмечает конец стартовой последовательности.
//
// Возвращаемое значение:
//  Строка - искомый фрагмент журнала.
//
Функция МаркерЗавершенияСтарта() Экспорт
	Возврат "Стартовые задачи завершены";
КонецФункции

// Останавливает хаб, снимает заявку на порт, чистит окружение и временный каталог; журнал-файл
// перед удалением дочитывается — Дамп() отдаёт его и после остановки.
// Идемпотентна: повторный вызов и вызов до Запустить() безопасны.
//
Процедура Остановить() Экспорт

	Если Внешний() Тогда
		Возврат;
	КонецЕсли;

	ЗавершитьПроцесс();
	ДочитатьВывод(Истина);
	ПутьЖурнала = "";
	Если ЗначениеЗаполнено(КаталогЖурнала) Тогда
		УникальныеИмена.УбратьВременное(КаталогЖурнала);
		КаталогЖурнала = "";
	КонецЕсли;

	Если НомерПорта > 0 Тогда
		Выдача.Вернуть(НомерПорта);
		НомерПорта = 0;
	КонецЕсли;

	ОчиститьОкружение();
	УдалитьВременныйКорень();

КонецПроцедуры

// Номер порта работающего экземпляра.
//
// Возвращаемое значение:
//  Число - номер порта; 0 — экземпляр не запущен.
//
Функция Порт() Экспорт
	Возврат НомерПорта;
КонецФункции

// Жив ли процесс хаба.
//
// Возвращаемое значение:
//  Булево - признак живого процесса.
//
Функция Работает() Экспорт

	Если НЕ Внешний() Тогда
		Возврат Процесс <> Неопределено И НЕ Процесс.Завершен;
	КонецЕсли;

	Попытка
		Возврат Соединение(10).Получить(Новый HTTPЗапрос("/health")).КодСостояния = 200;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// PID текущего процесса хаба.
//
// Возвращаемое значение:
//  Число - PID; 0 — процесса нет.
//
Функция ИдентификаторПроцесса() Экспорт
	Возврат ?(Процесс = Неопределено, 0, Процесс.Идентификатор);
КонецФункции

// Метка прогона (значение OSHUB_TEST_RUN): по ней внешняя чистка отбирает
// осиротевшие после SIGKILL хабы.
//
// Возвращаемое значение:
//  Строка - метка прогона.
//
Функция МеткаПрогона() Экспорт
	Возврат Метка;
КонецФункции

// PID последнего запущенного процесса — известен и после остановки, чтобы тест мог
// спросить у системы, действительно ли процесса больше нет.
//
// Возвращаемое значение:
//  Число - PID; 0 — процесс ни разу не поднимался.
//
Функция ПоследнийИдентификаторПроцесса() Экспорт
	Возврат ПоследнийPID;
КонецФункции

// Корень репозитория, от которого запускается хаб.
//
// Возвращаемое значение:
//  Строка - путь каталога.
//
Функция КаталогПроекта() Экспорт
	Возврат КорневойКаталог;
КонецФункции

// Прогоняет сидер oscript в каталоге проекта и ждёт его завершения. Ненулевой код —
// исключение с выводом потока ошибок: молча засеянная наполовину база даёт падение
// в другом месте и через полминуты. Сидер, не уложившийся в предел, снимается,
// и набор падает с его выводом, а не висит. Отказ сидера до старта хаба — как отказ старта:
// окружение и временный каталог экземпляра снимаются.
//
// Параметры:
//  Сидер     - Строка - полное имя файла сидера.
//  ПределСек - Число  - сколько секунд ждать сидер; 0 — без предела
//              (необязательный, по умолчанию 0).
//
Процедура ЗапуститьСидер(Знач Сидер, Знач ПределСек = 0) Экспорт

	ОтказатьВнешнему("ЗапуститьСидер()");
	Процесс_ = СоздатьПроцесс(СтрШаблон("oscript ""%1""", Сидер), КорневойКаталог, Истина);
	Процесс_.Запустить();

	Если ПределСек > 0 Тогда
		УложилсяВПредел = ДождатьсяСидера(Процесс_, ПределСек);
	Иначе
		Процесс_.ОжидатьЗавершения();
		УложилсяВПредел = Истина;
	КонецЕсли;

	// оба потока: упавший сценарий OneScript печатает своё падение в stdout, и один
	// только stderr оставил бы диагностику пустой; молчавший поток читается Неопределено
	Вывод = Строка(Процесс_.ПотокВывода.Прочитать()) + Строка(Процесс_.ПотокОшибок.Прочитать());

	Отказал = НЕ УложилсяВПредел;
	Если НЕ Отказал Тогда
		Отказал = Процесс_.КодВозврата <> 0;
	КонецЕсли;
	Если Отказал И Процесс = Неопределено Тогда
		Остановить();
	КонецЕсли;

	Если НЕ УложилсяВПредел Тогда
		ВызватьИсключение СтрШаблон("Сидер %1 не завершился за %2 сек и снят: %3",
			Сидер, ПределСек, Вывод);
	КонецЕсли;

	Если Процесс_.КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("Сидер завершился с кодом %1: %2",
			Процесс_.КодВозврата, Вывод);
	КонецЕсли;

КонецПроцедуры

// Ждёт сидер не дольше предела; не дождался — снимает процесс и отвечает Ложью.
Функция ДождатьсяСидера(Знач Процесс_, Знач ПределСек)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ПределСек * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Если Процесс_.Завершен Тогда
			Возврат Истина;
		КонецЕсли;
		Приостановить(300);
	КонецЦикла;

	Если Процесс_.Завершен Тогда
		Возврат Истина;
	КонецЕсли;

	Попытка
		Процесс_.Завершить();
	Исключение
		// сидер мог завершиться между проверкой и вызовом
	КонецПопытки;
	Возврат Ложь;

КонецФункции

// Накопленный вывод процесса (stdout + stderr) — единственный источник серверного
// стектрейса при 5xx. Журнал в файле (общий хаб, ВестиЖурналВФайле) отдаётся хвостом
// в 200 строк с пометкой, сколько строк всего.
//
// Возвращаемое значение:
//  Строка - вывод хаба либо пояснение, почему его нет.
//
Функция Дамп() Экспорт

	ДочитатьВывод();

	Если Внешний() Тогда
		Если НЕ ЗначениеЗаполнено(ПутьЖурнала) Тогда
			Возврат СтрШаблон("хаб поднят вне набора (%1), его журнала у набора нет", ВнешнийАдрес);
		КонецЕсли;
		Заголовок = СтрШаблон("журнал общего хаба с момента подключения (%1)", ВнешнийАдрес);
		Если НЕ ЗначениеЗаполнено(НакопленныйВывод) Тогда
			Возврат Заголовок + ": пуст";
		КонецЕсли;
		Возврат Заголовок + ":" + Символы.ПС + ХвостЖурнала();
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(НакопленныйВывод) Тогда
		Возврат ?(Процесс = Неопределено, "процесс хаба уже остановлен, вывод не сохранён", "вывод пуст");
	КонецЕсли;

	Если НЕ ЖурналВФайл Тогда
		Возврат НакопленныйВывод;
	КонецЕсли;

	Возврат ХвостЖурнала();

КонецФункции

// Последние 200 строк прочитанного журнала; длиннее — с пометкой, сколько строк всего.
Функция ХвостЖурнала()

	Строки = СтрРазделить(НакопленныйВывод, Символы.ПС, Истина);
	Если Строки[Строки.ВГраница()] = "" Тогда
		Строки.Удалить(Строки.ВГраница());
	КонецЕсли;
	Хвост = 200;
	Если Строки.Количество() <= Хвост Тогда
		Возврат НакопленныйВывод;
	КонецЕсли;

	Последние = Новый Массив();
	Для Номер = Строки.Количество() - Хвост По Строки.ВГраница() Цикл
		Последние.Добавить(Строки[Номер]);
	КонецЦикла;

	Возврат СтрШаблон("… журнал хаба: последние %1 из %2 строк%3%4", Хвост, Строки.Количество(),
		Символы.ПС, СтрСоединить(Последние, Символы.ПС));

КонецФункции

// Ждёт строку в журнале хаба — признак готовности, не трогающий БД: HTTP-проба на
// старте сталкивается со стартовой рогаткой на одном JSON-файле, и хаб падает.
// Бросает исключение по таймауту либо если процесс умер, не написав строку.
//
// Параметры:
//  Фрагмент           - Строка - что искать в журнале.
//  ТаймаутОжиданияСек - Число  - сколько ждать (необязательный, по умолчанию 60).
//
Процедура ДождатьсяСтрокиЖурнала(Знач Фрагмент, Знач ТаймаутОжиданияСек = 60) Экспорт

	Если Внешний() И НЕ ЗначениеЗаполнено(ПутьЖурнала) Тогда
		ВызватьИсключение СтрШаблон("%1 (%2): журнала у экземпляра нет — строку «%3» ждать негде.",
			ИсточникВнешнего, ВнешнийАдрес, Фрагмент);
	КонецЕсли;

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутОжиданияСек * 1000;

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл

		ДочитатьВывод();

		Если СтрНайти(НакопленныйВывод, Фрагмент) > 0 Тогда
			Возврат;
		КонецЕсли;

		Если НЕ Внешний() И (Процесс = Неопределено ИЛИ Процесс.Завершен) Тогда
			ВызватьИсключение СтрШаблон(
				"Процесс хаба (порт %1) завершился, не написав в журнал ""%2"".%3%4",
				НомерПорта, Фрагмент, Символы.ПС, Дамп());
		КонецЕсли;

		Приостановить(200);

	КонецЦикла;

	ВызватьИсключение СтрШаблон(
		"В журнале хаба (порт %1) за %2 сек не появилось ""%3"".%4Процесс: %5.%6%7%8%9",
		НомерПорта, ТаймаутОжиданияСек, Фрагмент, Символы.ПС,
		?(Работает(), "ЖИВ (значит это не смерть хаба, а незавершённая работа)", "завершился"),
		Символы.ПС, СостояниеСтартовыхЗадач(), Символы.ПС, Дамп());

КонецПроцедуры

// Ждёт, пока отработают стартовые рогатки, а не только откроется слушатель.
Процедура ДождатьсяЗавершенияСтарта()

	ДождатьсяСтрокиЖурнала(МаркерЗавершенияСтарта(), ТаймаутСек);

КонецПроцедуры

// Что успел сообщить хаб о своих стартовых задачах — чтобы отказ объяснял себя сам.
Функция СостояниеСтартовыхЗадач()

	Последняя = "";
	Для Каждого Строка_ Из СтрРазделить(НакопленныйВывод, Символы.ПС, Истина) Цикл
		Если СтрНайти(Строка_, "Стартовая задача") > 0 И СтрНайти(Строка_, "осталось задач") > 0 Тогда
			Последняя = СокрЛП(Строка_);
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(Последняя) Тогда
		Возврат "Стартовые задачи: не отработала НИ ОДНА — старт не дошёл даже до"
			+ " фоновых задач (смотрите сборку контейнера в дампе ниже).";
	КонецЕсли;

	Возврат "Стартовые задачи, последнее событие: " + Последняя;

КонецФункции

// Поток процесса отдаёт данные ОДИН раз — вычитанное копим, иначе опрос журнала съест дамп.
// Журнал-файл дочитывается с прежнего смещения; ДоКонца — и недописанная последняя строка.
Процедура ДочитатьВывод(Знач ДоКонца = Ложь)

	Если ЗначениеЗаполнено(ПутьЖурнала) Тогда
		ДочитатьЖурнал(ДоКонца);
		Возврат;
	КонецЕсли;

	Если Процесс = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		НакопленныйВывод = НакопленныйВывод + Процесс.ПотокВывода.Прочитать() + Процесс.ПотокОшибок.Прочитать();
	Исключение
		НакопленныйВывод = НакопленныйВывод + Символы.ПС + "вывод недоступен: " + ОписаниеОшибки();
	КонецПопытки;

КонецПроцедуры

// HTTP-соединение с этим экземпляром.
//
// Параметры:
//  ТаймаутСоединенияСек - Число - таймаут соединения (необязательный, по умолчанию 15).
//
// Возвращаемое значение:
//  HTTPСоединение - соединение с localhost на выданном порту.
//
Функция Соединение(Знач ТаймаутСоединенияСек = 15) Экспорт
	Возврат Новый HTTPСоединение("localhost", НомерПорта, , , , ТаймаутСоединенияСек);
КонецФункции

// Ждёт, пока /setup ответит «онбординг не нужен» (безголовый админ создан рогаткой).
// При неуспехе хаб останавливается и бросается исключение с журналом — сироты не будет.
//
// Параметры:
//  ТаймаутОнбордингаСек - Число - сколько ждать (необязательный, по умолчанию 30).
//
Процедура ДождатьсяОнбординга(Знач ТаймаутОнбордингаСек = 30) Экспорт

	Если Внешний() Тогда
		Дождаться(ТаймаутОнбордингаСек);
		Возврат;
	КонецЕсли;

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутОнбордингаСек * 1000;

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Попытка
			Ответ = Соединение(10).Получить(Новый HTTPЗапрос("/setup"));
			Чтение = Новый ЧтениеJSON();
			Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
			Тело = ПрочитатьJSON(Чтение, Истина);
			Чтение.Закрыть();
			Если Тело["onboarding_needed"] = Ложь Тогда
				Возврат;
			КонецЕсли;
		Исключение
		КонецПопытки;
		Приостановить(500);
	КонецЦикла;

	// Журнал снимаем ДО остановки — иначе отказ выглядит немым «админ не создан».
	Журнал = Дамп();
	Остановить();

	ВызватьИсключение СтрШаблон("Онбординг не завершился за %1 сек (безголовый админ не создан).%2%3",
		ТаймаутОнбордингаСек, Символы.ПС, Журнал);

КонецПроцедуры

#КонецОбласти

#Область Служебное

// Сценарий, который экземпляр запускает как хаб: src/main.os каталога проекта.
//
// Возвращаемое значение:
//  Строка - полный путь.
//
Функция ТочкаВхода() Экспорт
	Возврат ОбъединитьПути(КорневойКаталог, "src", "main.os");
КонецФункции

Процедура ПоднятьПроцесс()

	// Проба подключения к источнику — сетевой запрос: подопытный хаб её не делает,
	// иначе заведение апстрима в тесте ушло бы в настоящую сеть. Набору, который пробу
	// как раз и проверяет, умолчание не мешает: заданное им значение сильнее.
	ПоУмолчанию("OSHUB_UPSTREAM_PROBE_ENABLED", "false");
	// README из репозитория пакета — поход на GitHub: подопытный хаб его не делает, набор,
	// который его проверяет, включает поход сам и ведёт его на свой стенд
	ПоУмолчанию("OSHUB_README_REPOSITORY_ENABLED", "false");

	// вывод — только нового процесса: маркер старта мёртвой попытки не засчитывается повтору
	НакопленныйВывод = "";
	Если ЖурналВФайл Тогда
		Если ЗначениеЗаполнено(ВременныйКорень) Тогда
			ПутьЖурнала = ОбъединитьПути(ВременныйКорень, "хаб.журнал");
		Иначе
			Если НЕ ЗначениеЗаполнено(КаталогЖурнала) Тогда
				КаталогЖурнала = УникальныеИмена.ВременныйПуть("openhub-журнал-хаба");
			КонецЕсли;
			ПутьЖурнала = ОбъединитьПути(КаталогЖурнала, "хаб.журнал");
		КонецЕсли;
		// повтор старта дописывает в тот же файл: строки мёртвой попытки — не журнал нового процесса
		ПрочитаноБайт = РазмерЖурнала();
		СоздатьКаталог(Новый Файл(ПутьЖурнала).Путь);
		// все три потока — мимо канала: иначе хаб держит вывод поднявшего его процесса
		Процесс = СоздатьПроцесс(СтрШаблон("/bin/sh -c ""exec oscript '%1' < /dev/null >> '%2' 2>&1""",
			ТочкаВхода(), ПутьЖурнала), КорневойКаталог, Ложь);
	Иначе
		Процесс = СоздатьПроцесс(СтрШаблон("oscript ""%1""", ТочкаВхода()), КорневойКаталог, Истина);
	КонецЕсли;
	Процесс.Запустить();
	ПоследнийPID = Процесс.Идентификатор;

КонецПроцедуры

Функция НоваяВыдачаПортов()

	РеестрФикстур.Подключить("ВыдачаПортов");

	Возврат Новый ВыдачаПортов();

КонецФункции

Процедура ДождатьсяГотовности()

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСек * 1000;
	ПоследняяОшибка = "";
	ПоследнийКод = 0;

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл

		Если Процесс <> Неопределено И Процесс.Завершен Тогда
			ВызватьИсключение СтрШаблон("Хаб завершился до готовности (порт %1), код %2",
				НомерПорта, Процесс.КодВозврата);
		КонецЕсли;

		Попытка
			// Код запоминаем отдельно от ошибки: отвечающий, но не 200 хаб — не молчащий.
			ПоследнийКод = Соединение(10).Получить(Новый HTTPЗапрос("/health")).КодСостояния;
			Если ПоследнийКод = 200 Тогда
				Возврат;
			КонецЕсли;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
		КонецПопытки;

		Приостановить(500);

	КонецЦикла;

	ДочитатьВывод();
	ВызватьИсключение СообщениеОтказаГотовности(ПоследнийКод, ПоследняяОшибка);

КонецПроцедуры

// Собирает диагностику отказа ожидания готовности: состояние процесса, стартовые
// задачи, последний код /health, последняя ошибка запроса и журнал хаба.
//
// Параметры:
//  ПоследнийКод    - Число  - последний код /health; 0 — ни одного ответа.
//  ПоследняяОшибка - Строка - последняя ошибка запроса; "" — ошибок не было.
//
// Возвращаемое значение:
//  Строка - многострочная диагностика.
//
Функция СообщениеОтказаГотовности(Знач ПоследнийКод, Знач ПоследняяОшибка) Экспорт

	Возврат СтрШаблон("Хаб не ответил /health на порту %1 за %2 сек.%3Процесс: %4.%5%6%7%8%9",
		НомерПорта, ТаймаутСек, Символы.ПС,
		?(Работает(), "ЖИВ", "завершился"), Символы.ПС, СостояниеСтартовыхЗадач(),
		Символы.ПС,
		?(ПоследнийКод = 0, "Ни одного ответа по HTTP не получено.",
			СтрШаблон("Последний полученный код: %1 (то есть хаб ОТВЕЧАЛ, но не 200).", ПоследнийКод)),
		?(ЗначениеЗаполнено(ПоследняяОшибка),
			Символы.ПС + "Последняя ошибка запроса: " + ПоследняяОшибка, ""))
		+ Символы.ПС + "Журнал хаба: " + Дамп();

КонецФункции

// Убивает процесс и ДОЖИДАЕТСЯ смерти: Завершить() возвращает управление раньше,
// чем ядро снимает процесс.
Процедура ЗавершитьПроцесс()

	Попытка
		Если Процесс <> Неопределено И НЕ Процесс.Завершен Тогда
			Процесс.Завершить();
			Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10 * 1000;
			Пока НЕ Процесс.Завершен И ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
				Приостановить(50);
			КонецЦикла;
		КонецЕсли;
	Исключение
		// процесс мог умереть между проверкой и вызовом — это нормально
	КонецПопытки;

	Процесс = Неопределено;

КонецПроцедуры

// Новые байты журнала — до последнего перевода строки: недописанная строка и разрезанный
// символ UTF-8 дождутся следующего чтения.
Процедура ДочитатьЖурнал(Знач ДоКонца)

	Если НЕ Новый Файл(ПутьЖурнала).Существует() Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Поток = ФайловыеПотоки.ОткрытьДляЧтения(ПутьЖурнала);
		Новых = Поток.Размер() - ПрочитаноБайт;
		Если Новых <= 0 Тогда
			Поток.Закрыть();
			Возврат;
		КонецЕсли;
		Поток.Перейти(ПрочитаноБайт, ПозицияВПотоке.Начало);
		Буфер = Новый БуферДвоичныхДанных(Новых);
		Новых = Поток.Прочитать(Буфер, 0, Новых);
		Поток.Закрыть();
	Исключение
		НакопленныйВывод = НакопленныйВывод + Символы.ПС + "журнал недоступен: " + ОписаниеОшибки();
		Возврат;
	КонецПопытки;

	Взять = Новых;
	Если НЕ ДоКонца Тогда
		Пока Взять > 0 И Буфер[Взять - 1] <> 10 Цикл
			Взять = Взять - 1;
		КонецЦикла;
	КонецЕсли;
	Если Взять = 0 Тогда
		Возврат;
	КонецЕсли;

	НакопленныйВывод = НакопленныйВывод + ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер.Прочитать(0, Взять), "UTF-8");
	ПрочитаноБайт = ПрочитаноБайт + Взять;

КонецПроцедуры

Функция РазмерЖурнала()

	Если НЕ ЗначениеЗаполнено(ПутьЖурнала) Тогда
		Возврат 0;
	КонецЕсли;
	Файл = Новый Файл(ПутьЖурнала);
	Возврат ?(Файл.Существует(), Файл.Размер(), 0);

КонецФункции

// Методы, меняющие окружение, базу или процесс, внешнему хабу не годятся: у него всё своё.
Процедура ОтказатьВнешнему(Знач Действие)

	Если Внешний() Тогда
		ВызватьИсключение СтрШаблон("%1 на %2: экземпляр подключён к внешнему хабу, %3 ему недоступно —"
			+ " окружение, база и процесс у хаба свои.", ИсточникВнешнего, ВнешнийАдрес, Действие);
	КонецЕсли;

КонецПроцедуры

Процедура ОчиститьОкружение()

	Для Каждого КиЗ Из Переменные Цикл
		Попытка
			УстановитьПеременнуюСреды(КиЗ.Ключ, "");
		Исключение
		КонецПопытки;
	КонецЦикла;

	Переменные.Очистить();

КонецПроцедуры

Процедура УдалитьВременныйКорень()

	Если НЕ ЗначениеЗаполнено(ВременныйКорень) Тогда
		Возврат;
	КонецЕсли;

	УникальныеИмена.УбратьВременное(ВременныйКорень);

	ВременныйКорень = "";

КонецПроцедуры

#КонецОбласти
