// ХранилищеПулов в памяти со счётчиком занятого места: им проверяют, откуда экран
// берёт занятый объём. Пул здесь — носитель двух полей, домена в нём нет.

Перем Пулы;   // Массив из Структура (Идентификатор, Имя, ЗанятоБайт)

// Контракт ХранилищеПулов: все пулы хаба.
//
// Возвращаемое значение:
//  Массив - заведённые пулы.
//
Функция Все() Экспорт
	Возврат Пулы;
КонецФункции

// Контракт ХранилищеПулов: пул по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Структура, Неопределено - найденный пул.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт

	Для Каждого Пул Из Пулы Цикл
		Если Пул.Идентификатор = Цел(Идентификатор) Тогда
			Возврат Пул;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Заводит пул с занятым местом.
//
// Параметры:
//  Имя - Строка - имя пула.
//  ЗанятоБайт - Число - занятый объём по счётчику.
//
Процедура Добавить(Знач Имя, Знач ЗанятоБайт) Экспорт

	Пулы.Добавить(Новый Структура("Идентификатор, Имя, ЗанятоБайт",
		Пулы.Количество() + 1, Строка(Имя), Цел(ЗанятоБайт)));

КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Пулы = Новый Массив();
КонецПроцедуры
