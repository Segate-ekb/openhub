// Фейковый ТранспортHTTP: заданный ответ без сети, эмуляция offline, журнал вызовов.

Перем КодОтвета;
Перем ДанныеОтвета;
Перем ЗаголовкиОтвета;
Перем БросатьСбой;
Перем СчётчикВызовов;
Перем ПоследнийURL;
Перем ПоследниеЗаголовки;
Перем ПоследнийТаймаут;
Перем ПоследнееТело;   // тело последнего Отправить (POST)
Перем ВсеURL_;         // Массив из Строка - URL всех вызовов по порядку
Перем ПоследнийРедирект; // Булево - просили ли идти по Location в последнем вызове

// Задаёт ответ на Получить/Отправить и снимает режим сбоя.
//
// Параметры:
//  Код    - Число  - код состояния ответа.
//  Данные - Произвольный - тело ответа (необязательный, по умолчанию Неопределено).
//  ETag   - Строка - значение заголовка ETag (необязательный, по умолчанию "").
//
Процедура УстановитьОтвет(Знач Код, Знач Данные = Неопределено, Знач ETag = "") Экспорт
	КодОтвета = Код;
	ДанныеОтвета = Данные;
	ЗаголовкиОтвета = Новый Соответствие();
	Если ЗначениеЗаполнено(ETag) Тогда
		ЗаголовкиОтвета.Вставить("ETag", ETag);
	КонецЕсли;
	БросатьСбой = Ложь;
КонецПроцедуры

// Добавляет заголовок в ответ. Зовётся ПОСЛЕ УстановитьОтвет: тот собирает заголовки заново.
//
// Параметры:
//  Имя - Строка - имя заголовка.
//  Значение - Строка - значение заголовка.
//
Процедура УстановитьЗаголовокОтвета(Знач Имя, Знач Значение) Экспорт
	ЗаголовкиОтвета.Вставить(Строка(Имя), Строка(Значение));
КонецПроцедуры

// Переводит фейк в режим сетевого сбоя: следующий вызов бросит исключение.
//
Процедура ЭмулироватьОффлайн() Экспорт
	БросатьСбой = Истина;
КонецПроцедуры

// Число обращений к Получить/Отправить.
//
// Возвращаемое значение:
//  Число - количество вызовов.
//
Функция КоличествоВызовов() Экспорт
	Возврат СчётчикВызовов;
КонецФункции

// Адрес последнего запроса.
//
// Возвращаемое значение:
//  Строка - URL либо "" до первого вызова.
//
Функция URLПоследний() Экспорт
	Возврат ПоследнийURL;
КонецФункции

// Адреса всех запросов по порядку — состав и очерёдность доставок.
//
// Возвращаемое значение:
//  Массив из Строка - URL вызовов.
//
Функция ВсеURL() Экспорт
	Возврат ВсеURL_;
КонецФункции

// Значение заголовка последнего запроса.
//
// Параметры:
//  Имя - Строка - имя заголовка.
//
// Возвращаемое значение:
//  Строка - значение заголовка либо "" если его нет.
//
Функция ЗаголовокПоследний(Знач Имя) Экспорт
	Если ПоследниеЗаголовки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение = ПоследниеЗаголовки.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

// Тело последнего запроса Отправить.
//
// Возвращаемое значение:
//  Строка - тело запроса либо "" если POST не было.
//
Функция ТелоПоследнее() Экспорт
	Возврат ?(ПоследнееТело = Неопределено, "", Строка(ПоследнееТело));
КонецФункции

// Просил ли вызывающий идти по перенаправлениям в последнем запросе.
//
// Возвращаемое значение:
//  Булево - значение параметра РазрешитьПеренаправление.
//
Функция РедиректыПоследний() Экспорт
	Возврат ПоследнийРедирект;
КонецФункции

// Отдаёт настроенный ответ и запоминает параметры вызова (контракт ТранспортHTTP).
// Бросает исключение в режиме offline.
//
// Параметры:
//  URL          - Строка - адрес запроса.
//  Заголовки    - Соответствие - заголовки запроса (необязательный, по умолчанию Неопределено).
//  ТаймаутСек   - Число  - таймаут запроса (необязательный, по умолчанию 20).
//  ПроверятьSSL - Булево - проверка сертификата (необязательный, по умолчанию Истина).
//  РазрешитьПеренаправление - Булево - идти ли по Location (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура - Код, Заголовки, Данные.
//
Функция Получить(Знач URL, Знач Заголовки = Неопределено, Знач ТаймаутСек = 20, Знач ПроверятьSSL = Истина,
	Знач РазрешитьПеренаправление = Ложь) Экспорт
	СчётчикВызовов = СчётчикВызовов + 1;
	ПоследнийURL = URL;
	ВсеURL_.Добавить(Строка(URL));
	ПоследниеЗаголовки = Заголовки;
	ПоследнийТаймаут = ТаймаутСек;
	ПоследнийРедирект = (РазрешитьПеренаправление = Истина);
	Если БросатьСбой Тогда
		ВызватьИсключение "эмуляция сетевого сбоя (offline)";
	КонецЕсли;
	Возврат Новый Структура("Код, Заголовки, Данные", КодОтвета, ЗаголовкиОтвета, ДанныеОтвета);
КонецФункции

// Отдаёт настроенный ответ и запоминает тело запроса (контракт ТранспортHTTP).
// Бросает исключение в режиме offline.
//
// Параметры:
//  URL          - Строка - адрес запроса.
//  Тело         - Произвольный - тело запроса.
//  Заголовки    - Соответствие - заголовки запроса (необязательный, по умолчанию Неопределено).
//  ТаймаутСек   - Число  - таймаут запроса (необязательный, по умолчанию 20).
//  ПроверятьSSL - Булево - проверка сертификата (необязательный, по умолчанию Истина).
//
// Возвращаемое значение:
//  Структура - Код, Заголовки, Данные.
//
Функция Отправить(Знач URL, Знач Тело, Знач Заголовки = Неопределено, Знач ТаймаутСек = 20, Знач ПроверятьSSL = Истина) Экспорт
	СчётчикВызовов = СчётчикВызовов + 1;
	ПоследнийURL = URL;
	ВсеURL_.Добавить(Строка(URL));
	ПоследнееТело = Тело;
	ПоследниеЗаголовки = Заголовки;
	ПоследнийТаймаут = ТаймаутСек;
	Если БросатьСбой Тогда
		ВызватьИсключение "эмуляция сетевого сбоя (offline)";
	КонецЕсли;
	Возврат Новый Структура("Код, Заголовки, Данные", КодОтвета, ЗаголовкиОтвета, ДанныеОтвета);
КонецФункции

&Прозвище("ТранспортHTTP")
&Желудь
Процедура ПриСозданииОбъекта()
	КодОтвета = 0;
	ДанныеОтвета = Неопределено;
	ЗаголовкиОтвета = Новый Соответствие();
	БросатьСбой = Ложь;
	СчётчикВызовов = 0;
	ПоследнийURL = "";
	ВсеURL_ = Новый Массив();
	ПоследниеЗаголовки = Неопределено;
	ПоследнийТаймаут = 0;
	ПоследнееТело = Неопределено;
	ПоследнийРедирект = Ложь;
КонецПроцедуры
