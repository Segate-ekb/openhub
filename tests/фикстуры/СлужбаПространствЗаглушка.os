// Заглушка СлужбыЛичныхПространств: числа задаются тестом, вызовы считаются.
// Нужна там, где проверяется РЕШЕНИЕ пульта, а не работа домена.

Перем Сводка;
Перем ИтогСноса;
Перем ИтогРаздачи;
Перем СносовВызвано Экспорт;
Перем РаздачВызвано Экспорт;
Перем СносПадает;
Перем РаздачаПадает;
Перем Наблюдаемые;              // СервисНастроек — чьё значение снимается В МОМЕНТ вызова
Перем НастройкаПриРаздаче Экспорт; // Булево, Неопределено — значение на входе в раздачу
Перем НастройкаПриСносе Экспорт;   // Булево, Неопределено — значение на входе в снос

// Просит заглушку снимать значение настройки В МОМЕНТ вызова домена: так проверяется
// ПОРЯДОК «записать → выполнить», а не только факт записи.
//
// Параметры:
//  Настройки - СервисНастроек - резолвер, у которого спрашивать значение.
//
Процедура НаблюдатьЗа(Знач Настройки) Экспорт
	Наблюдаемые = Настройки;
КонецПроцедуры

// Задаёт сводку, которую пульт покажет в окне предупреждения и с которой сверит эхо.
//
// Параметры:
//  Пулов - Число - сколько личных пространств к сносу.
//  Пакетов - Число - сколько пакетов уйдёт.
//  Версий - Число - сколько версий уйдёт.
//
Процедура ЗадатьСводку(Знач Пулов, Знач Пакетов = 0, Знач Версий = 0) Экспорт
	Сводка = Новый Структура("Пулов, ПуловСПакетами, Пакетов, Версий, Ошибок",
		Пулов, ?(Пакетов > 0, 1, 0), Пакетов, Версий, 0);
КонецПроцедуры

// Задаёт итог сноса: сколько снесено и сколько пространств снести не вышло.
//
// Параметры:
//  Пулов - Число - фактически снесено.
//  Ошибок - Число - пространств с неудачей.
//
Процедура ЗадатьИтогСноса(Знач Пулов, Знач Ошибок) Экспорт
	ИтогСноса = Новый Структура("Пулов, ПуловСПакетами, Пакетов, Версий, Ошибок",
		Пулов, 0, 0, 0, Ошибок);
КонецПроцедуры

// Задаёт итог раздачи.
//
// Параметры:
//  Создано - Число.
//  Было - Число.
//  Пропущено - Число.
//  Ошибок - Число - учёток, оставшихся без пространства.
//
Процедура ЗадатьИтогРаздачи(Знач Создано, Знач Было, Знач Пропущено, Знач Ошибок) Экспорт
	ИтогРаздачи = Новый Структура("Создано, Было, Пропущено, Ошибок",
		Создано, Было, Пропущено, Ошибок);
КонецПроцедуры

// Заставляет снос падать исключением.
//
Процедура РонятьСнос() Экспорт
	СносПадает = Истина;
КонецПроцедуры

// Заставляет раздачу падать исключением.
//
Процедура РонятьРаздачу() Экспорт
	РаздачаПадает = Истина;
КонецПроцедуры

#Область КонтрактСлужбы

// Сводка последствий выключения.
//
// Возвращаемое значение:
//  Структура.
//
Функция СводкаУдаления() Экспорт
	Возврат Сводка;
КонецФункции

// Снос всех личных пространств.
//
// Параметры:
//  Кто - Строка - принципал операции.
//
// Возвращаемое значение:
//  Структура.
//
Функция УдалитьВсе(Знач Кто) Экспорт
	Кто = Кто;
	СносовВызвано = СносовВызвано + 1;
	НастройкаПриСносе = Наблюдение();
	Если СносПадает Тогда
		ВызватьИсключение "Заглушка: снос сорвался";
	КонецЕсли;
	Возврат ИтогСноса;
КонецФункции

// Раздача пространств всем учёткам.
//
// Параметры:
//  Кто - Строка - принципал операции.
//
// Возвращаемое значение:
//  Структура.
//
Функция РаздатьВсем(Знач Кто) Экспорт
	Кто = Кто;
	РаздачВызвано = РаздачВызвано + 1;
	НастройкаПриРаздаче = Наблюдение();
	Если РаздачаПадает Тогда
		ВызватьИсключение "Заглушка: раздача сорвалась";
	КонецЕсли;
	Возврат ИтогРаздачи;
КонецФункции

// Действие журнала аудита для выключения настройки.
//
// Возвращаемое значение:
//  Строка.
//
Функция ДействиеВыключены() Экспорт
	Возврат "пространства.личные.снесены";
КонецФункции

// Действие журнала аудита для включения настройки.
//
// Возвращаемое значение:
//  Строка.
//
Функция ДействиеВключены() Экспорт
	Возврат "пространства.личные.розданы";
КонецФункции

#КонецОбласти

Функция Наблюдение()
	Если Наблюдаемые = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Наблюдаемые.Значение("oshub.pools.personal_enabled");
КонецФункции

Процедура ПриСозданииОбъекта() Экспорт
	СносовВызвано = 0;
	РаздачВызвано = 0;
	СносПадает = Ложь;
	РаздачаПадает = Ложь;
	Наблюдаемые = Неопределено;
	НастройкаПриРаздаче = Неопределено;
	НастройкаПриСносе = Неопределено;
	ЗадатьСводку(0);
	ЗадатьИтогСноса(0, 0);
	ЗадатьИтогРаздачи(0, 0, 0, 0);
КонецПроцедуры
