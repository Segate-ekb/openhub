// Мост коллектора для контейнера без телеметрии: желудь под именем ОтелАппендерLogos, который
// копит события вместо отправки — набор видит, что уехало бы в коллектор.

Перем События;   // Массив из Структура — Лог, Уровень, Текст

// Контракт способа вывода logos (API 3).
//
// Параметры:
//  СобытиеЛога - СобытиеЛога - событие, прошедшее дверь хаба.
//
Процедура ВывестиСобытие(Знач СобытиеЛога) Экспорт
	События.Добавить(Новый Структура("Лог, Уровень, Текст", СобытиеЛога.ПолучитьИмяЛога(),
		СобытиеЛога.ПолучитьУровень(), СобытиеЛога.ПолучитьСообщение()));
КонецПроцедуры

// Контракт способа вывода logos: закрывать нечего.
//
Процедура Закрыть() Экспорт
КонецПроцедуры

// Контракт способа вывода logos: своих свойств нет.
//
// Параметры:
//  ИмяСвойства - Строка - имя свойства.
//  Значение - Произвольный - значение свойства.
//
Процедура УстановитьСвойство(Знач ИмяСвойства, Знач Значение) Экспорт
КонецПроцедуры

// События, уехавшие бы в коллектор от названного лога.
//
// Параметры:
//  ИмяЛога - Строка - имя лога.
//
// Возвращаемое значение:
//  Массив из Структура - Лог, Уровень (Число), Текст.
//
Функция СобытияЛога(Знач ИмяЛога) Экспорт

	Результат = Новый Массив();
	Для Каждого Событие Из События Цикл
		Если Событие.Лог = ИмяЛога Тогда
			Результат.Добавить(Событие);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

&Прозвище("ОтелАппендерLogos")
&Желудь
Процедура ПриСозданииОбъекта()
	События = Новый Массив();
КонецПроцедуры
