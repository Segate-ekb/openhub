// Фейковый ТранспортHTTP для проб источника: ответ на каждый адрес вместе с заголовками
// (нужен Location), сетевой сбой с заданным текстом и журнал обращений.
// Незаданный адрес — сетевой сбой «нет ответа»: тест, ушедший не туда, краснеет громко.

Перем Ответы;    // Соответствие: URL → Структура(Код, Тело, Заголовки)
Перем Сбои;      // Соответствие: URL → Строка (текст исключения)
Перем Журнал_;   // Массив из Строка - адреса обращений по порядку
Перем Редиректы; // Массив из Булево - значение РазрешитьПеренаправление по вызовам

// Задаёт ответ на адрес.
//
// Параметры:
//  URL - Строка - адрес запроса.
//  Код - Число - код состояния.
//  Тело - Строка - тело ответа (необязательный, по умолчанию "").
//
Процедура ПриАдресе(Знач URL, Знач Код, Знач Тело = "") Экспорт
	Ответы.Вставить(Строка(URL), Новый Структура("Код, Тело, Заголовки",
		Код, Строка(Тело), Новый Соответствие()));
КонецПроцедуры

// Задаёт перенаправление с адреса на адрес.
//
// Параметры:
//  URL - Строка - адрес запроса.
//  Куда - Строка - значение заголовка Location.
//  Код - Число - код перенаправления (необязательный, по умолчанию 301).
//
Процедура ПеренаправитьС(Знач URL, Знач Куда, Знач Код = 301) Экспорт
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Location", Строка(Куда));
	Ответы.Вставить(Строка(URL), Новый Структура("Код, Тело, Заголовки", Код, "", Заголовки));
КонецПроцедуры

// Задаёт сетевой сбой на адресе с конкретным текстом — им проверяется классификация причины.
//
// Параметры:
//  URL - Строка - адрес запроса.
//  Текст - Строка - текст исключения транспорта.
//
Процедура СбойНаАдресе(Знач URL, Знач Текст) Экспорт
	Сбои.Вставить(Строка(URL), Строка(Текст));
КонецПроцедуры

// Адреса обращений по порядку.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Обращения() Экспорт
	Возврат Журнал_;
КонецФункции

// Значения параметра РазрешитьПеренаправление по вызовам.
//
// Возвращаемое значение:
//  Массив из Булево.
//
Функция РедиректыЗапрашивались() Экспорт
	Возврат Редиректы;
КонецФункции

// Контракт ТранспортHTTP.
//
// Параметры:
//  URL - Строка - адрес запроса.
//  Заголовки - Соответствие - заголовки запроса (необязательный, по умолчанию Неопределено).
//  ТаймаутСек - Число - таймаут (необязательный, по умолчанию 20).
//  ПроверятьSSL - Булево - проверка сертификата (необязательный, по умолчанию Истина).
//  РазрешитьПеренаправление - Булево - идти ли по Location (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура - Код, Заголовки, Данные.
//
Функция Получить(Знач URL, Знач Заголовки = Неопределено, Знач ТаймаутСек = 20,
	Знач ПроверятьSSL = Истина, Знач РазрешитьПеренаправление = Ложь) Экспорт

	Журнал_.Добавить(Строка(URL));
	Редиректы.Добавить(РазрешитьПеренаправление = Истина);

	Сбой = Сбои.Получить(Строка(URL));
	Если Сбой <> Неопределено Тогда
		ВызватьИсключение Сбой;
	КонецЕсли;

	Ответ = Ответы.Получить(Строка(URL));
	Если Ответ = Неопределено Тогда
		ВызватьИсключение "фейк транспорта: ответ на адрес не задан — " + Строка(URL);
	КонецЕсли;

	Возврат Новый Структура("Код, Заголовки, Данные",
		Ответ.Код, Ответ.Заголовки, ПолучитьДвоичныеДанныеИзСтроки(Ответ.Тело));

КонецФункции

// Контракт ТранспортHTTP: POST фейку не нужен, но метод обязан существовать.
//
// Параметры:
//  URL - Строка - адрес запроса.
//  Тело - Произвольный - тело запроса.
//  Заголовки - Соответствие - заголовки запроса (необязательный, по умолчанию Неопределено).
//  ТаймаутСек - Число - таймаут (необязательный, по умолчанию 20).
//  ПроверятьSSL - Булево - проверка сертификата (необязательный, по умолчанию Истина).
//
// Возвращаемое значение:
//  Структура - Код, Заголовки, Данные.
//
Функция Отправить(Знач URL, Знач Тело, Знач Заголовки = Неопределено, Знач ТаймаутСек = 20,
	Знач ПроверятьSSL = Истина) Экспорт
	Возврат Получить(URL, Заголовки, ТаймаутСек, ПроверятьSSL, Ложь);
КонецФункции

Процедура ПриСозданииОбъекта()
	Ответы = Новый Соответствие();
	Сбои = Новый Соответствие();
	Журнал_ = Новый Массив();
	Редиректы = Новый Массив();
КонецПроцедуры
