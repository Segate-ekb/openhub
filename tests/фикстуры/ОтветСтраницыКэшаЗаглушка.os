// Ответ winow для наборов кэша страниц гостя: поля и методы, которые читает и ставит кэш.

Перем ИдентификаторЗапроса Экспорт;
Перем СостояниеКод Экспорт;
Перем Заголовки Экспорт;
Перем ТелоТекст Экспорт;
Перем ТелоДвоичныеДанные Экспорт;
Перем ТелоПоток Экспорт;
Перем ТелоФайл Экспорт;
Перем Куки Экспорт;     // сам ответ: Получить() — выданные куки
Перем Выданные;

Процедура УстановитьСостояние(Знач Код) Экспорт
	СостояниеКод = Код;
КонецПроцедуры

Процедура УстановитьСостояниеОК() Экспорт
	СостояниеКод = 200;
КонецПроцедуры

Функция Получить() Экспорт
	Возврат Новый ФиксированноеСоответствие(Выданные);
КонецФункции

Функция ПолучитьЗначениеПоИмени(Знач Имя) Экспорт
	Возврат Выданные.Получить(Имя);
КонецФункции

Процедура ВыдатьКуку(Знач Имя, Знач Значение) Экспорт
	Выданные.Вставить(Имя, Значение);
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач Код = 200, Знач Тело = "", Знач ТипКонтента = "text/html; charset=utf-8") Экспорт
	СостояниеКод = Код;
	ТелоТекст = Тело;
	Заголовки = Новый Соответствие();
	Если ЗначениеЗаполнено(ТипКонтента) Тогда
		Заголовки.Вставить("Content-Type", ТипКонтента);
	КонецЕсли;
	Выданные = Новый Соответствие();
	// winow ставит свою куку сессии каждому ответу
	Выданные.Вставить("SessionID", "winow");
	Куки = ЭтотОбъект;
КонецПроцедуры
