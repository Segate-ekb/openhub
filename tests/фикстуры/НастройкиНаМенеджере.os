// Таблица прикладных настроек над голым менеджером сущностей: первые строки читаются тем же
// запросом, что строит деривованный ПолучитьПервые хранилища. Нужна пробе там, где контейнера
// нет, — у источника, за которым СУБД не отвечает.

#Использовать entity

Перем Менеджер_;

// Первые строки таблицы прикладных настроек.
//
// Параметры:
//  Количество - Число - максимум строк.
//
// Возвращаемое значение:
//  Массив из ПрикладнаяНастройка.
//
Функция ПолучитьПервые(Количество) Экспорт
	Возврат Менеджер_.Получить(Тип("ПрикладнаяНастройка"), Новый ОпцииПоиска().Первые(Количество));
КонецФункции

// Менеджер задаёт тест; в его модели обязана быть сущность ПрикладнаяНастройка.
//
// Параметры:
//  Менеджер - МенеджерСущностей - менеджер над источником теста.
//
Процедура ПриСозданииОбъекта(Знач Менеджер) Экспорт
	Менеджер_ = Менеджер;
КонецПроцедуры
