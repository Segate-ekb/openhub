// Заглушка гварда кабинета: впущенный пользователь — администратор хаба,
// поэтому фейк прав пускает его к любому пулу.

Перем Разрешено_;
Перем Логин_;

// Вердикт допуска в кабинет.
//
// Параметры:
//  Ответ - Произвольный - ответ сервера.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//
// Возвращаемое значение:
//  Структура - Разрешено, Пользователь, Сессия.
//
Функция Проверить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса) Экспорт

	Ответ = Ответ;
	ЗаголовкиЗапроса = ЗаголовкиЗапроса;
	КукиЗапроса = КукиЗапроса;

	Пользователь = ?(ЗначениеЗаполнено(Логин_),
		Новый Структура("Логин, Админ", Логин_, Истина), Неопределено);

	Возврат Новый Структура("Разрешено, Пользователь, Сессия", Разрешено_, Пользователь, "сессия");

КонецФункции

// Задаёт вошедшего администратора.
//
// Параметры:
//  Логин - Строка - логин пользователя сессии.
//
Процедура Впустить(Знач Логин) Экспорт
	Разрешено_ = Истина;
	Логин_ = Логин;
КонецПроцедуры

Процедура ПриСозданииОбъекта() Экспорт
	Разрешено_ = Ложь;
	Логин_ = "";
КонецПроцедуры
