// Заглушка ВитринаНастроек для юнит-тестов сохранения раздела дома «Хаб»: одна
// редактируемая карточка, действующее значение задаётся тестом.

Перем Карточки_;  // Массив из Структура (Ключ, Тип, Значение)

// Принимает ли раздел мутации.
//
// Параметры:
//  Раздел - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Булево - всегда Истина.
//
Функция ПринимаетИзменения(Знач Раздел) Экспорт
	Раздел = Раздел;
	Возврат Истина;
КонецФункции

// Редактируемые карточки раздела.
//
// Параметры:
//  Раздел - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Массив из Структура - карточки настроек.
//
Функция РедактируемыеРаздела(Знач Раздел) Экспорт
	Раздел = Раздел;
	Возврат Карточки_;
КонецФункции

// Карточки раздела (для рендера страницы отказа).
//
// Параметры:
//  Раздел - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Массив из Структура - карточки настроек.
//
Функция КарточкиРаздела(Знач Раздел) Экспорт
	Возврат РедактируемыеРаздела(Раздел);
КонецФункции

// Имя поля формы для ключа настройки.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - имя поля.
//
Функция ИмяПоля(Знач Ключ) Экспорт
	Возврат НРег(СокрЛП(Строка(Ключ)));
КонецФункции

// Имя скрытого поля операции раздела.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляОперации() Экспорт
	Возврат "операция";
КонецФункции

// Имя скрытого поля ключа настройки.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяПоляКлюча() Экспорт
	Возврат "ключ";
КонецФункции

// Имя операции сброса.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОперацияСброса() Экспорт
	Возврат "сбросить";
КонецФункции

// Значение включённого булева поля.
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеВключено() Экспорт
	Возврат "1";
КонецФункции

// Действующее значение карточки в форме, пригодной для сравнения с вводом.
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//
// Возвращаемое значение:
//  Строка.
//
Функция ЗначениеДляСравнения(Знач Карточка) Экспорт
	Возврат СокрЛП(Строка(Карточка.Значение));
КонецФункции

// Человеческая метка настройки.
//
// Параметры:
//  Карточка - Структура - карточка настройки.
//
// Возвращаемое значение:
//  Строка.
//
Функция Метка(Знач Карточка) Экспорт
	Возврат Строка(Карточка.Ключ);
КонецФункции

// Заводит редактируемую карточку с действующим значением.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//  Значение - Произвольный - действующее значение.
//  Тип - Строка - тип значения (необязательный, по умолчанию "строка").
//
Процедура ЗавестиКарточку(Знач Ключ, Знач Значение, Знач Тип = "строка") Экспорт
	// «Секрет» — часть контракта карточки: пульт спрашивает его у каждой настройки
	Карточки_.Добавить(Новый Структура("Ключ, Тип, Значение, Секрет", Ключ, Тип, Значение, Ложь));
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Карточки_ = Новый Массив();
КонецПроцедуры
