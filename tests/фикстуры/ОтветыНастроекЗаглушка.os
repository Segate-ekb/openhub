// Заглушка ОтветыНастроек: запоминает, каким отказом ответил контроллер, и не рендерит.

Перем ПоследнийОтказ Экспорт;   // "" — отказа не было
Перем БылДом Экспорт;           // Булево — страница раздела отрисована

// Совпадает ли метод запроса с ожидаемым.
//
// Параметры:
//  МетодЗапроса - Строка - метод запроса.
//  Ожидаемый - Строка - ожидаемый метод.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоМетод(Знач МетодЗапроса, Знач Ожидаемый) Экспорт
	Возврат ВРег(СокрЛП(Строка(МетодЗапроса))) = ВРег(СокрЛП(Строка(Ожидаемый)));
КонецФункции

// Отдаёт страницу дома.
//
// Параметры:
//  Ответ - Произвольный - ответ сервера.
//  Модель - Структура - модель дома.
//  Пользователь - Произвольный - пользователь запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//  Заголовок - Строка - заголовок страницы.
//  Статус - Число - код ответа (необязательный, по умолчанию 200).
//
Процедура ОтдатьДом(Ответ, Знач Модель, Знач Пользователь, Знач КукиЗапроса, Знач Заголовок,
	Знач Статус = 200) Экспорт
	Ответ = Ответ;
	Модель = Модель;
	Пользователь = Пользователь;
	КукиЗапроса = КукиЗапроса;
	Заголовок = Заголовок;
	Статус = Статус;
	БылДом = Истина;
КонецПроцедуры

// Отказ «метод не разрешён».
//
// Параметры:
//  Ответ - Произвольный - ответ сервера.
//  Разрешённые - Строка - разрешённые методы.
//  Пользователь - Произвольный - пользователь запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//
Процедура ОтдатьМетодНеРазрешён(Ответ, Знач Разрешённые, Знач Пользователь, Знач КукиЗапроса) Экспорт
	Ответ = Ответ;
	Разрешённые = Разрешённые;
	Пользователь = Пользователь;
	КукиЗапроса = КукиЗапроса;
	ПоследнийОтказ = "метод";
КонецПроцедуры

// Отказ «не найдено».
//
// Параметры:
//  Ответ - Произвольный - ответ сервера.
//  Пользователь - Произвольный - пользователь запроса.
//  Сообщение - Строка - текст сообщения.
//  КукиЗапроса - Произвольный - куки запроса.
//
Процедура ОтдатьНеНайдено(Ответ, Знач Пользователь, Знач Сообщение, Знач КукиЗапроса) Экспорт
	Ответ = Ответ;
	Пользователь = Пользователь;
	Сообщение = Сообщение;
	КукиЗапроса = КукиЗапроса;
	ПоследнийОтказ = "не найдено";
КонецПроцедуры

// Отказ «неверный CSRF».
//
// Параметры:
//  Ответ - Произвольный - ответ сервера.
//  Пользователь - Произвольный - пользователь запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//
Процедура ОтдатьНеверныйCSRF(Ответ, Знач Пользователь, Знач КукиЗапроса) Экспорт
	Ответ = Ответ;
	Пользователь = Пользователь;
	КукиЗапроса = КукиЗапроса;
	ПоследнийОтказ = "csrf";
КонецПроцедуры

// Уведомления раздела.
//
// Параметры:
//  Сохранено - Булево - показать «сохранено».
//  Ошибка - Строка - текст ошибки.
//
// Возвращаемое значение:
//  Массив.
//
Функция УведомленияРаздела(Знач Сохранено, Знач Ошибка) Экспорт
	Сохранено = Сохранено;
	Если ЗначениеЗаполнено(Ошибка) Тогда
		ПоследнийОтказ = "ошибка: " + Ошибка;
	КонецЕсли;
	Возврат Новый Массив();
КонецФункции

// Краткое описание ошибки.
//
// Параметры:
//  ОписаниеИсключения - Строка - описание ошибки.
//
// Возвращаемое значение:
//  Строка.
//
Функция КраткоОшибка(Знач ОписаниеИсключения) Экспорт
	Возврат Строка(ОписаниеИсключения);
КонецФункции

// Уведомление для модели дома.
//
// Параметры:
//  Текст - Строка - текст уведомления.
//  Вид - Строка - вид уведомления (необязательный, по умолчанию "ok").
//
// Возвращаемое значение:
//  Структура.
//
Функция Уведомление(Знач Текст, Знач Вид = "ok") Экспорт
	Возврат Новый Структура("Текст, Вид", Текст, Вид);
КонецФункции

Процедура ПриСозданииОбъекта()
	ПоследнийОтказ = "";
	БылДом = Ложь;
КонецПроцедуры
