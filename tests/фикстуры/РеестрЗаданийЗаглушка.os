// Реестр фоновых заданий с управляемым размером: тест задаёт число, которое реестр
// назовёт следующему спросившему. Контракт РеестрЗаданийПлатформы в объёме приборов хаба.

Перем ТекущийРазмер;
Перем Уборок;

#Область ПубличныйИнтерфейс

// Контракт реестра: сколько записей он держит.
//
// Возвращаемое значение:
//  Число.
//
Функция Размер() Экспорт
	Возврат ТекущийРазмер;
КонецФункции

// Контракт реестра: снять записи всех заданий.
//
Процедура Очистить() Экспорт
	ТекущийРазмер = 0;
	Уборок = Уборок + 1;
КонецПроцедуры

// Задаёт число, которое реестр назовёт следующему спросившему.
//
// Параметры:
//  Записей - Число - размер реестра.
//
Процедура Наполнить(Знач Записей) Экспорт
	ТекущийРазмер = Записей;
КонецПроцедуры

// Сколько раз реестр чистили.
//
// Возвращаемое значение:
//  Число.
//
Функция Уборок() Экспорт
	Возврат Уборок;
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач НачальныйРазмер = 0)
	ТекущийРазмер = НачальныйРазмер;
	Уборок = 0;
КонецПроцедуры
