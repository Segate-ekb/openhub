// Способ вывода logos, накапливающий сообщения в памяти: тест смотрит, что в лог попало
// (и, главное, что НЕ попало). Подключается через Лог.ДобавитьСпособВывода либо Поставить.

Перем Сообщения_;
Перем Постановки_;  // Массив из Структура: Лог, Прежний — логи, на которых ловушка висит

// Контракт способа вывода logos (API 3).
//
// Параметры:
//  СобытиеЛога - СобытиеЛога - событие с уже отформатированным сообщением.
//
Процедура ВывестиСобытие(Знач СобытиеЛога) Экспорт
	Сообщения_.Добавить(Строка(СобытиеЛога.ПолучитьФорматированноеСообщение()));
КонецПроцедуры

// Контракт способа вывода logos: закрытие ресурса; накопителю закрывать нечего.
//
Процедура Закрыть() Экспорт
КонецПроцедуры

// Контракт способа вывода logos: установка свойства из конфигурации.
//
// Параметры:
//  ИмяСвойства - Строка - имя свойства.
//  Значение - Произвольный - значение свойства.
//
Процедура УстановитьСвойство(Знач ИмяСвойства, Знач Значение) Экспорт
КонецПроцедуры

// Вешает ловушку на лог и ставит логу уровень на время теста: так тест видит журнал таким,
// каким его видит оператор на этом уровне. Снять() возвращает лог как был.
//
// Параметры:
//  Лог - Лог - лог logos; логи живут по имени на весь процесс.
//  Уровень - Число - уровень лога на время теста (УровниЛога).
//
Процедура Поставить(Знач Лог, Знач Уровень) Экспорт
	Постановки_.Добавить(Новый Структура("Лог, Прежний", Лог, Лог.Уровень()));
	Лог.УстановитьУровень(Уровень);
	Лог.ДобавитьСпособВывода(ЭтотОбъект);
КонецПроцедуры

// Снимает ловушку со всех логов, на которые она поставлена, и возвращает им прежний уровень.
// Накопленное остаётся читаемым.
//
Процедура Снять() Экспорт
	Для Каждого Постановка Из Постановки_ Цикл
		Постановка.Лог.УдалитьСпособВывода(ЭтотОбъект);
		Постановка.Лог.УстановитьУровень(Постановка.Прежний);
	КонецЦикла;
	Постановки_ = Новый Массив();
КонецПроцедуры

// Всё накопленное одной строкой — для поиска и для сообщения упавшего ассерта.
//
// Возвращаемое значение:
//  Строка.
//
Функция Всё() Экспорт
	Возврат СтрСоединить(Сообщения_, Символы.ПС);
КонецФункции

// Забывает накопленное. Нужна набору, который вешает ловушку на лог ОДИН раз, а смотрит
// журнал в каждом тесте: повторное ДобавитьСпособВывода копит выводы на общем логе.
//
Процедура Очистить() Экспорт
	Сообщения_ = Новый Массив();
КонецПроцедуры

// Число накопленных сообщений.
//
// Возвращаемое значение:
//  Число.
//
Функция Количество() Экспорт
	Возврат Сообщения_.Количество();
КонецФункции

// Одно накопленное сообщение целиком. Считать записи строками нельзя: сообщение
// с подробным описанием ошибки многострочное, и отсчёт по строкам разъезжается.
//
// Параметры:
//  Индекс - Число - порядковый номер сообщения, с нуля.
//
// Возвращаемое значение:
//  Строка - сообщение; пустая строка, если такого номера нет.
//
Функция Сообщение(Знач Индекс) Экспорт

	Если Индекс < 0 ИЛИ Индекс > Сообщения_.ВГраница() Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сообщения_[Индекс];

КонецФункции

Процедура ПриСозданииОбъекта()
	Сообщения_ = Новый Массив();
	Постановки_ = Новый Массив();
КонецПроцедуры
