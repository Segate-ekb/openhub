// Дескриптор выполнения для тестов: контракт os-scheduler (Завершено/ЗавершеноУспешно/
// ТекстОшибки), завершает его тест. Библиотека дескриптор наружу не отдаёт — двойник здесь.

Перем Завершено_; // Булево
Перем Успех_;     // Булево
Перем Ошибка_;    // Строка | Неопределено

Процедура ПриСозданииОбъекта()
	Завершено_ = Ложь;
	Успех_ = Ложь;
	Ошибка_ = Неопределено;
КонецПроцедуры

// Переводит дескриптор в состояние «успешно завершено».
Процедура ЗавершитьУспехом() Экспорт
	Завершено_ = Истина;
	Успех_ = Истина;
	Ошибка_ = Неопределено;
КонецПроцедуры

// Переводит дескриптор в состояние «завершено с ошибкой».
//
// Параметры:
//  Текст - Строка - описание ошибки.
//
Процедура ЗавершитьОшибкой(Знач Текст) Экспорт
	Завершено_ = Истина;
	Успех_ = Ложь;
	Ошибка_ = Текст;
КонецПроцедуры

// Истина, если выполнение завершено (успешно или с ошибкой).
//
// Возвращаемое значение:
//  Булево.
//
Функция Завершено() Экспорт
	Возврат Завершено_;
КонецФункции

// Истина, если выполнение завершилось успешно.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЗавершеноУспешно() Экспорт
	Возврат Успех_;
КонецФункции

// Текст ошибки последнего выполнения или Неопределено.
//
// Возвращаемое значение:
//  Строка, Неопределено.
//
Функция ТекстОшибки() Экспорт
	Возврат Ошибка_;
КонецФункции
