// Общий модуль тестов: снятие комментариев и строковых литералов с исходника — один на все
// сканеры дерева, «//» внутри литерала комментария не открывает.

// Текст без построчных комментариев. Литералы сохранены целиком: «//» внутри кавычек —
// это данные, а не начало комментария. Состояние литерала переживает перевод строки:
// в OneScript многострочный литерал продолжается символом «|», кавычка не открывается заново.
//
// Параметры:
//  Текст - Строка - исходник.
//
// Возвращаемое значение:
//  Строка - тот же текст без комментариев; число строк сохраняется.
//
Функция БезКомментариев(Знач Текст) Экспорт
	Возврат Очищенный(Текст, Ложь);
КонецФункции

// Текст без комментариев и без содержимого строковых литералов: от литерала не остаётся
// ни кавычек, ни начинки. Нужен сканерам кода — литерал перестаёт читаться как директива.
//
// Параметры:
//  Текст - Строка - исходник.
//
// Возвращаемое значение:
//  Строка - код без комментариев и литералов; число строк сохраняется.
//
Функция БезКомментариевИЛитералов(Знач Текст) Экспорт
	Возврат Очищенный(Текст, Истина);
КонецФункции

// Одна строка без хвостового комментария. «//» внутри литерала комментария не открывает.
//
// Параметры:
//  Строка_ - Строка - строка исходника.
//
// Возвращаемое значение:
//  Строка - строка до комментария.
//
Функция БезХвостовогоКомментария(Знач Строка_) Экспорт
	Возврат Очищенный(Строка_, Ложь);
КонецФункции

// Единственный разбор исходника: проход кусками от кавычки до кавычки и от кода до «//»,
// знающий, что литерал бывает многострочным. Удвоенная кавычка внутри литерала закрывает
// его и тут же открывает заново — результат тот же.
Функция Очищенный(Знач Текст, Знач СнятьЛитералы)

	Куски = Новый Массив();
	Кавычка = """";
	Позиция = 1;
	Длина = СтрДлина(Текст);

	Пока Позиция <= Длина Цикл

		Открытие = СтрНайти(Текст, Кавычка, , Позиция);
		Комментарий = СтрНайти(Текст, "//", , Позиция);

		Если Комментарий > 0 И (Открытие = 0 ИЛИ Комментарий < Открытие) Тогда
			Куски.Добавить(Сред(Текст, Позиция, Комментарий - Позиция));
			КонецСтроки = СтрНайти(Текст, Символы.ПС, , Комментарий);
			// перевод строки допишет следующий проход
			Позиция = ?(КонецСтроки = 0, Длина + 1, КонецСтроки);
			Продолжить;
		КонецЕсли;

		Если Открытие = 0 Тогда
			Куски.Добавить(Сред(Текст, Позиция));
			Прервать;
		КонецЕсли;

		Куски.Добавить(Сред(Текст, Позиция, Открытие - Позиция));
		Закрытие = 0;
		// СтрНайти с начальной позицией за концом строки падает, а не возвращает 0
		Если Открытие < Длина Тогда
			Закрытие = СтрНайти(Текст, Кавычка, , Открытие + 1);
		КонецЕсли;
		Литерал = ?(Закрытие = 0, Сред(Текст, Открытие), Сред(Текст, Открытие, Закрытие - Открытие + 1));
		Куски.Добавить(?(СнятьЛитералы, ПереводыСтрок(Литерал), Литерал));
		Позиция = ?(Закрытие = 0, Длина + 1, Закрытие + 1);

	КонецЦикла;

	Возврат СтрСоединить(Куски, "");

КонецФункции

// От снятого литерала остаются только переводы строк: число строк исходника не меняется.
Функция ПереводыСтрок(Знач Литерал)

	Переводы = Новый Массив();
	Для Номер = 1 По СтрЧислоВхождений(Литерал, Символы.ПС) Цикл
		Переводы.Добавить(Символы.ПС);
	КонецЦикла;

	Возврат СтрСоединить(Переводы, "");

КонецФункции
