// Общий модуль тестов: снятие комментариев и строковых литералов с исходника — один
// на все сканеры дерева. Копии расходились ровно в том, читают ли они «//» внутри
// литерала: наивная обрезка по первому «//» даёт и ложную защиту, и ложный отказ.

// Текст без построчных комментариев. Литералы сохранены целиком: «//» внутри кавычек —
// это данные, а не начало комментария. Состояние литерала переживает перевод строки:
// в OneScript многострочный литерал продолжается символом «|», кавычка не открывается заново.
//
// Параметры:
//  Текст - Строка - исходник.
//
// Возвращаемое значение:
//  Строка - тот же текст без комментариев; число строк сохраняется.
//
Функция БезКомментариев(Знач Текст) Экспорт
	Возврат Очищенный(Текст, Ложь);
КонецФункции

// Текст без комментариев и без содержимого строковых литералов: от литерала не остаётся
// ни кавычек, ни начинки. Нужен сканерам кода — литерал перестаёт читаться как директива.
//
// Параметры:
//  Текст - Строка - исходник.
//
// Возвращаемое значение:
//  Строка - код без комментариев и литералов; число строк сохраняется.
//
Функция БезКомментариевИЛитералов(Знач Текст) Экспорт
	Возврат Очищенный(Текст, Истина);
КонецФункции

// Одна строка без хвостового комментария. «//» внутри литерала комментария не открывает.
//
// Параметры:
//  Строка_ - Строка - строка исходника.
//
// Возвращаемое значение:
//  Строка - строка до комментария.
//
Функция БезХвостовогоКомментария(Знач Строка_) Экспорт
	Возврат Очищенный(Строка_, Ложь);
КонецФункции

// Единственный разбор исходника: посимвольный проход, знающий про литералы и про то,
// что литерал бывает многострочным. Кавычка просто переключает состояние — удвоенная
// кавычка внутри литерала закрывает его и тут же открывает заново, и результат тот же.
Функция Очищенный(Знач Текст, Знач СнятьЛитералы)

	Результат = "";
	ВЛитерале = Ложь;
	Позиция = 1;
	Длина = СтрДлина(Текст);

	Пока Позиция <= Длина Цикл

		Символ = Сред(Текст, Позиция, 1);

		Если Символ = """" Тогда
			ВЛитерале = НЕ ВЛитерале;
			Результат = Результат + ?(СнятьЛитералы, "", Символ);
		ИначеЕсли ВЛитерале Тогда
			// перевод строки остаётся даже внутри литерала: строки не склеиваем
			Результат = Результат + ?(СнятьЛитералы И Символ <> Символы.ПС, "", Символ);
		ИначеЕсли Символ = "/" И Сред(Текст, Позиция + 1, 1) = "/" Тогда
			Пока Позиция <= Длина И Сред(Текст, Позиция, 1) <> Символы.ПС Цикл
				Позиция = Позиция + 1;
			КонецЦикла;
			Продолжить;                           // перевод строки допишет следующий проход
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;

		Позиция = Позиция + 1;

	КонецЦикла;

	Возврат Результат;

КонецФункции
