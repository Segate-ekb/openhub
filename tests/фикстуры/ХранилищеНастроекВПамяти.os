// Заглушка ХранилищеПрикладныхНастроек в памяти: Значение()/Все()/Установить()/Удалить()
// без БД. Обе двери чтения на месте: точечная (через неё цена сборки карточек росла
// числом ключей) и разрез «всё введённое руками».

Перем Записи; // Соответствие: ключ -> Структура(Значение, Кто, Когда)
Перем ОтказЧтения; // Строка - причина отказа читать; "" — хранилище работает
Перем Счётчик; // СчётчикОбращений — счёт чтений значений

// Значение прикладной настройки.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - значение либо Неопределено, если записи нет.
//
Функция Значение(Знач Ключ) Экспорт
	Счётчик.Отметить();
	Если ЗначениеЗаполнено(ОтказЧтения) Тогда
		ВызватьИсключение ОтказЧтения;
	КонецЕсли;
	Запись = Записи.Получить(Норм(Ключ));
	Возврат ?(Запись = Неопределено, Неопределено, Запись.Значение);
КонецФункции

// Все введённые руками значения.
//
// Возвращаемое значение:
//  Массив из Структура - Ключ (Строка), Значение (Строка).
//
Функция Все() Экспорт

	Счётчик.Отметить();
	Если ЗначениеЗаполнено(ОтказЧтения) Тогда
		ВызватьИсключение ОтказЧтения;
	КонецЕсли;

	Результат = Новый Массив();
	Для Каждого КлючИЗапись Из Записи Цикл
		Результат.Добавить(Новый Структура("Ключ, Значение",
			КлючИЗапись.Ключ, КлючИЗапись.Значение.Значение));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Сколько раз хранилище спросили о значениях с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Чтений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Заставляет хранилище падать на чтении — тест недоступной базы.
//
// Параметры:
//  Причина - Строка - текст исключения; "" возвращает хранилище в рабочее состояние.
//
Процедура ПадатьПриЧтении(Знач Причина) Экспорт
	ОтказЧтения = Строка(Причина);
КонецПроцедуры

// Записывает значение ключа, перезаписывая прежнюю запись.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//  Значение - Произвольный - значение; хранится строкой.
//  Кто - Произвольный - принципал мутации.
//  Когда - Дата - момент записи.
//
Процедура Установить(Знач Ключ, Знач Значение, Знач Кто, Знач Когда) Экспорт
	Записи.Вставить(Норм(Ключ), Новый Структура("Значение, Кто, Когда", Строка(Значение), Кто, Когда));
КонецПроцедуры

// Удаляет запись ключа; отсутствие записи не ошибка.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
Процедура Удалить(Знач Ключ) Экспорт
	Записи.Удалить(Норм(Ключ));
КонецПроцедуры

// Принципал, записавший значение ключа.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//
// Возвращаемое значение:
//  Строка - принципал либо "", если записи нет.
//
Функция Автор(Знач Ключ) Экспорт
	Запись = Записи.Получить(Норм(Ключ));
	Возврат ?(Запись = Неопределено, "", Строка(Запись.Кто));
КонецФункции

Функция Норм(Знач Ключ)
	Возврат НРег(СокрЛП(Строка(Ключ)));
КонецФункции

Процедура ПриСозданииОбъекта()
	Записи = Новый Соответствие();
	ОтказЧтения = "";
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
