// Фейк СервисаПулов для ЛетописиВерсий: только пул по идентификатору.

Перем Пулы; // Соответствие: идентификатор -> Структура (Идентификатор, Имя)

// Пул по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Структура, Неопределено - Идентификатор, Имя либо Неопределено.
//
Функция ПулПоИдентификатору(Знач Идентификатор) Экспорт
	Возврат Пулы.Получить(Цел(Идентификатор));
КонецФункции

// Заводит пул в фикстуре.
//
// Параметры:
//  Идентификатор - Число  - идентификатор пула.
//  Имя           - Строка - имя пула.
//
Процедура Добавить(Знач Идентификатор, Знач Имя) Экспорт
	Пулы.Вставить(Цел(Идентификатор),
		Новый Структура("Идентификатор, Имя", Цел(Идентификатор), Строка(Имя)));
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Пулы = Новый Соответствие();
КонецПроцедуры
