// Заглушка гварда дома настроек: допуск задаётся тестом, пользователь — по логину.

Перем Разрешено_;
Перем Логин_;

// Вердикт допуска к дому настроек.
//
// Параметры:
//  Ответ - Произвольный - ответ сервера.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//
// Возвращаемое значение:
//  Структура - Разрешено, Пользователь, Сессия.
//
Функция Проверить(Ответ, Знач ЗаголовкиЗапроса, Знач КукиЗапроса) Экспорт

	Ответ = Ответ;
	ЗаголовкиЗапроса = ЗаголовкиЗапроса;
	КукиЗапроса = КукиЗапроса;

	Пользователь = ?(ЗначениеЗаполнено(Логин_), Новый Структура("Логин", Логин_), Неопределено);
	Возврат Новый Структура("Разрешено, Пользователь, Сессия", Разрешено_, Пользователь, "сессия");

КонецФункции

// Задаёт вошедшего пользователя.
//
// Параметры:
//  Логин - Строка - логин пользователя сессии.
//
Процедура Впустить(Знач Логин) Экспорт
	Разрешено_ = Истина;
	Логин_ = Логин;
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Разрешено_ = Ложь;
	Логин_ = "";
КонецПроцедуры
