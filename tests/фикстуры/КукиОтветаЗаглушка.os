// Заглушка коллекции кук ответа winow: запоминает выданные куки и отдаёт их тесту.

Перем Выданные;   // Соответствие: имя куки → Структура её полей

// Заводит куку и отдаёт её поля для настройки (контракт коллекции кук ответа winow:
// вызывающий присваивает ТолькоХттп, Путь, ТотжеСайт, ДатаИстечения).
//
// Параметры:
//  Имя - Строка - имя куки.
//  Значение - Строка - значение куки.
//
// Возвращаемое значение:
//  Структура - поля куки.
//
Функция Добавить(Знач Имя, Знач Значение) Экспорт

	Кука = Новый Структура("Имя, Значение, ТолькоХттп, Путь, ТотжеСайт, ДатаИстечения",
		Строка(Имя), Строка(Значение), Ложь, "", "", '00010101');
	Выданные.Вставить(Строка(Имя), Кука);
	Возврат Кука;

КонецФункции

// Выданная кука со всеми полями: имя, значение, ТолькоХттп, Путь, ТотжеСайт,
// ДатаИстечения. Ими проверяются атрибуты выдачи, а не только значение.
//
// Параметры:
//  Имя - Строка - имя куки.
//
// Возвращаемое значение:
//  Структура, Неопределено - поля куки; Неопределено — такой куки не выдавали.
//
Функция Кука(Знач Имя) Экспорт
	Возврат Выданные.Получить(Строка(Имя));
КонецФункции

// Значение выданной куки.
//
// Параметры:
//  Имя - Строка - имя куки.
//
// Возвращаемое значение:
//  Строка - значение; "" — такой куки не выдавали.
//
Функция Значение(Знач Имя) Экспорт
	Кука = Выданные.Получить(Строка(Имя));
	Возврат ?(Кука = Неопределено, "", Строка(Кука.Значение));
КонецФункции

Процедура ПриСозданииОбъекта()
	Выданные = Новый Соответствие();
КонецПроцедуры
