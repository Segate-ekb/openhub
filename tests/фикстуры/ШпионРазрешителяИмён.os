// Шпион разрешителя имён (прозвище РазрешительImён): считает обращения и ничего не резолвит.
// Нужен, чтобы доказать исполнением, что путь доверенных конвейеров имён не резолвит вовсе —
// у системного разрешителя каждое обращение это запуск подпроцесса.

Перем Обращений_;
Перем Имена_;

// Сколько раз у разрешителя спросили адреса.
//
// Возвращаемое значение:
//  Число - количество обращений.
//
Функция Обращений() Экспорт
	Возврат Обращений_;
КонецФункции

// Имена, о которых спрашивали, через запятую — чтобы отказ называл виновника.
//
// Возвращаемое значение:
//  Строка - перечень имён.
//
Функция Имена() Экспорт
	Возврат СтрСоединить(Имена_, ", ");
КонецФункции

// Обнуляет счётчик перед замером.
Процедура Забыть() Экспорт
	Обращений_ = 0;
	Имена_ = Новый Массив();
КонецПроцедуры

// Контракт РазрешительImён: адреса имени. Шпион не резолвит — Неопределено означает
// «резолв недоступен», и судья на этом останавливается.
//
// Параметры:
//  Хост - Строка - DNS-имя.
//
// Возвращаемое значение:
//  Неопределено - всегда.
//
Функция Разрешить(Знач Хост) Экспорт
	Обращений_ = Обращений_ + 1;
	Имена_.Добавить(Строка(Хост));
	Возврат Неопределено;
КонецФункции

&Прозвище("РазрешительImён")
&Желудь
Процедура ПриСозданииОбъекта()
	Обращений_ = 0;
	Имена_ = Новый Массив();
КонецПроцедуры
