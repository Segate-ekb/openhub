// Форма из выданной страницы — так, как её отправил бы браузер без скрипта: скрытые поля
// всегда, флажок только отмеченный, выбор — отмеченный вариант, в порядке разметки.
// Тест меняет только те поля, что страница напечатала: выдумывать поля он не вправе.

// Поля формы, найденной на странице по примете.
//
// Параметры:
//  Страница - Строка - разметка страницы.
//  Примета - Строка - кусок разметки внутри нужной формы.
//
// Возвращаемое значение:
//  Массив из Структура - Имя, Значение.
//
Функция Поля(Знач Страница, Знач Примета) Экспорт

	Форма = Блок(Страница, Примета);
	Результат = Новый Массив();
	Позиция = 1;
	Пока Истина Цикл
		Ввод = СтрНайти(Форма, "<input", , Позиция);
		Выбор = СтрНайти(Форма, "<select", , Позиция);
		Если Ввод = 0 И Выбор = 0 Тогда
			Прервать;
		КонецЕсли;
		Если Выбор = 0 ИЛИ Ввод > 0 И Ввод < Выбор Тогда
			Тег = Лев(Сред(Форма, Ввод), СтрНайти(Сред(Форма, Ввод), ">"));
			Позиция = Ввод + СтрДлина(Тег);
			Имя = Атрибут(Тег, "name");
			Отмечен = Атрибут(Тег, "type") <> "checkbox" ИЛИ СтрНайти(Тег, " checked") > 0;
			Если ЗначениеЗаполнено(Имя) И Отмечен И СтрНайти(Тег, " disabled") = 0 Тогда
				Результат.Добавить(Новый Структура("Имя, Значение", Имя, Атрибут(Тег, "value")));
			КонецЕсли;
		Иначе
			Хвост = Сред(Форма, Выбор);
			Список = Лев(Хвост, СтрНайти(Хвост, "</select>"));
			Позиция = Выбор + СтрДлина(Список);
			Тег = Лев(Список, СтрНайти(Список, ">"));
			Результат.Добавить(Новый Структура("Имя, Значение", Атрибут(Тег, "name"), Выбранный(Список)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Открывающий тег формы, найденной по примете.
//
// Параметры:
//  Страница - Строка - разметка страницы.
//  Примета - Строка - кусок разметки внутри нужной формы.
//
// Возвращаемое значение:
//  Строка - от «<form» до «>».
//
Функция Тег(Знач Страница, Знач Примета) Экспорт
	Форма = Блок(Страница, Примета);
	Возврат Лев(Форма, СтрНайти(Форма, ">"));
КонецФункции

// Значение атрибута тега, как его прочитал бы браузер.
//
// Параметры:
//  Тег - Строка - открывающий тег.
//  Имя - Строка - имя атрибута.
//
// Возвращаемое значение:
//  Строка - ""; если атрибута нет.
//
Функция Атрибут(Знач Тег, Знач Имя) Экспорт
	Поз = СтрНайти(Тег, " " + Имя + "=""");
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Начало = Поз + СтрДлина(Имя) + 3;
	Значение = Сред(Тег, Начало, СтрНайти(Тег, """", , Начало) - Начало);
	Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Значение, "&quot;", """"), "&lt;", "<"),
		"&gt;", ">"), "&amp;", "&");
КонецФункции

// Значение поля по имени.
//
// Параметры:
//  Поля - Массив из Структура - результат Поля.
//  Имя - Строка - имя поля.
//
// Возвращаемое значение:
//  Строка, Неопределено - первое значение поля; Неопределено — поля нет.
//
Функция Значение(Знач Поля, Знач Имя) Экспорт
	Для Каждого Поле Из Поля Цикл
		Если Поле.Имя = Имя Тогда
			Возврат Поле.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Те же поля с другим значением одного из них. Поля, которого страница не напечатала,
// заменить нельзя.
//
// Параметры:
//  Поля - Массив из Структура - результат Поля.
//  Имя - Строка - имя поля.
//  НовоеЗначение - Строка - значение, которое выбрал бы человек.
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция СЗаменой(Знач Поля, Знач Имя, Знач НовоеЗначение) Экспорт
	Результат = Новый Массив();
	Найдено = Ложь;
	Для Каждого Поле Из Поля Цикл
		Если Поле.Имя = Имя И НЕ Найдено Тогда
			Результат.Добавить(Новый Структура("Имя, Значение", Имя, НовоеЗначение));
			Найдено = Истина;
		Иначе
			Результат.Добавить(Поле);
		КонецЕсли;
	КонецЦикла;
	Если НЕ Найдено Тогда
		ВызватьИсключение "Форма не печатает поле " + Имя;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Те же поля со снятым флажком: браузер не шлёт его «1», остаётся парное скрытое «0».
//
// Параметры:
//  Поля - Массив из Структура - результат Поля.
//  Имя - Строка - имя флажка.
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция БезФлажка(Знач Поля, Знач Имя) Экспорт
	Результат = Новый Массив();
	Снят = Ложь;
	Для Каждого Поле Из Поля Цикл
		Если Поле.Имя = Имя И НЕ Снят И Поле.Значение = "1" Тогда
			Снят = Истина;
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Поле);
	КонецЦикла;
	Если НЕ Снят Тогда
		ВызватьИсключение "Флажок не отмечен: " + Имя;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Те же поля с отмеченным флажком: перед парным скрытым «0» встаёт «1» флажка, как шлёт браузер.
// Флажок, у которого страница не напечатала парного «0», отметить нельзя.
//
// Параметры:
//  Поля - Массив из Структура - результат Поля.
//  Имя - Строка - имя флажка.
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция СФлажком(Знач Поля, Знач Имя) Экспорт
	Результат = Новый Массив();
	Отмечен = Ложь;
	Для Каждого Поле Из Поля Цикл
		Если Поле.Имя = Имя И Поле.Значение = "1" Тогда
			ВызватьИсключение "Флажок уже отмечен: " + Имя;
		ИначеЕсли Поле.Имя = Имя И НЕ Отмечен И Поле.Значение = "0" Тогда
			Результат.Добавить(Новый Структура("Имя, Значение", Имя, "1"));
			Отмечен = Истина;
		КонецЕсли;
		Результат.Добавить(Поле);
	КонецЦикла;
	Если НЕ Отмечен Тогда
		ВызватьИсключение "Форма не печатает флажок " + Имя;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Те же поля плюс нажатая кнопка отправки: браузер шлёт имя и значение только той кнопки,
// которую нажали, и только если форма её напечатала.
//
// Параметры:
//  Поля - Массив из Структура - результат Поля.
//  Страница - Строка - разметка страницы.
//  Примета - Строка - кусок разметки внутри нужной формы.
//  Имя - Строка - имя кнопки.
//  Значение - Строка - значение кнопки.
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция Нажатием(Знач Поля, Знач Страница, Знач Примета, Знач Имя, Знач Значение) Экспорт

	КнопкаФормы(Блок(Страница, Примета), Имя, Значение);

	Результат = Новый Массив();
	Для Каждого Поле Из Поля Цикл
		Результат.Добавить(Поле);
	КонецЦикла;
	Результат.Добавить(Новый Структура("Имя, Значение", Имя, Значение));
	Возврат Результат;

КонецФункции

// Адрес, на который браузер отправит форму нажатием кнопки: свой адрес кнопки (formaction),
// а без него — адрес формы.
//
// Параметры:
//  Страница - Строка - разметка страницы.
//  Примета - Строка - кусок разметки внутри нужной формы.
//  Имя - Строка - имя кнопки.
//  Значение - Строка - значение кнопки.
//
// Возвращаемое значение:
//  Строка
//
Функция АдресНажатия(Знач Страница, Знач Примета, Знач Имя, Знач Значение) Экспорт
	СвойАдрес = Атрибут(КнопкаФормы(Блок(Страница, Примета), Имя, Значение), "formaction");
	Возврат ?(ЗначениеЗаполнено(СвойАдрес), СвойАдрес, Атрибут(Тег(Страница, Примета), "action"));
КонецФункции

// Те же поля, отправленные по Enter: браузер жмёт первую кнопку отправки формы по порядку
// разметки и шлёт её имя и значение, если они у неё есть.
//
// Параметры:
//  Поля - Массив из Структура - результат Поля.
//  Страница - Строка - разметка страницы.
//  Примета - Строка - кусок разметки внутри нужной формы.
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция НеявнойОтправкой(Знач Поля, Знач Страница, Знач Примета) Экспорт

	Форма = Блок(Страница, Примета);
	Позиция = СтрНайти(Форма, "<button");
	Пока Позиция > 0 Цикл
		Тег = Лев(Сред(Форма, Позиция), СтрНайти(Сред(Форма, Позиция), ">"));
		Если Атрибут(Тег, "type") <> "button" Тогда
			Прервать;
		КонецЕсли;
		Позиция = СтрНайти(Форма, "<button", , Позиция + 1);
	КонецЦикла;
	Если Позиция = 0 Тогда
		ВызватьИсключение "В форме нет кнопки отправки: " + Примета;
	КонецЕсли;

	Результат = Новый Массив();
	Для Каждого Поле Из Поля Цикл
		Результат.Добавить(Поле);
	КонецЦикла;
	Если ЗначениеЗаполнено(Атрибут(Тег, "name")) Тогда
		Результат.Добавить(Новый Структура("Имя, Значение", Атрибут(Тег, "name"), Атрибут(Тег, "value")));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Тело запроса x-www-form-urlencoded: пары в порядке полей, повторы сохраняются.
//
// Параметры:
//  Поля - Массив из Структура - поля формы.
//
// Возвращаемое значение:
//  Строка
//
Функция Тело(Знач Поля) Экспорт
	Части = Новый Массив();
	Для Каждого Поле Из Поля Цикл
		Части.Добавить(КодироватьСтроку(Поле.Имя, СпособКодированияСтроки.КодировкаURL) + "="
			+ КодироватьСтроку(Поле.Значение, СпособКодированияСтроки.КодировкаURL));
	КонецЦикла;
	Возврат СтрСоединить(Части, "&");
КонецФункции

Функция Выбранный(Знач Список)
	Поз = СтрНайти(Список, " selected>");
	Если Поз = 0 Тогда
		Поз = СтрНайти(Список, "<option");
		Возврат Атрибут(Лев(Сред(Список, Поз), СтрНайти(Сред(Список, Поз), ">")), "value");
	КонецЕсли;
	Начало = СтрНайти(Лев(Список, Поз), "<option", НаправлениеПоиска.СКонца);
	Возврат Атрибут(Сред(Список, Начало, Поз - Начало + 10), "value");
КонецФункции

// Открывающий тег кнопки формы с этим именем и значением; кнопки нет — исключение.
Функция КнопкаФормы(Знач Форма, Знач Имя, Знач Значение)
	Позиция = СтрНайти(Форма, "<button");
	Пока Позиция > 0 Цикл
		Кнопка = Лев(Сред(Форма, Позиция), СтрНайти(Сред(Форма, Позиция), ">"));
		Если Атрибут(Кнопка, "name") = Имя И Атрибут(Кнопка, "value") = Значение Тогда
			Возврат Кнопка;
		КонецЕсли;
		Позиция = СтрНайти(Форма, "<button", , Позиция + 1);
	КонецЦикла;
	ВызватьИсключение СтрШаблон("Форма не печатает кнопку %1=%2", Имя, Значение);
КонецФункции

Функция Блок(Знач Страница, Знач Примета)
	Поз = СтрНайти(Страница, Примета);
	Если Поз = 0 Тогда
		ВызватьИсключение "На странице нет формы с приметой " + Примета;
	КонецЕсли;
	Начало = СтрНайти(Лев(Страница, Поз), "<form", НаправлениеПоиска.СКонца);
	Хвост = Сред(Страница, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, "</form>"));
КонецФункции

Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
