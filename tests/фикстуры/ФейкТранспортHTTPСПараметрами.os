// Фикстура ревью: ТранспортHTTP, запоминающий ПАРАМЕТРЫ вызова — проверку сертификата и
// разрешение перенаправлений. Без неё «ключи читаются по проверенному TLS» ничем не держится.

Перем Ответы;         // Соответствие: URL → Структура(Код, Тело)
Перем ПоследнийSSL;   // Булево, Неопределено — значение ПроверятьSSL последнего вызова
Перем ПоследнийРедирект; // Булево, Неопределено — значение РазрешитьПеренаправление

// Задаёт ответ на запрос по адресу.
//
// Параметры:
//  URL - Строка - адрес.
//  Код - Число - код состояния.
//  Тело - Строка - тело ответа.
//
Процедура ПриАдресе(Знач URL, Знач Код, Знач Тело) Экспорт
	Ответы.Вставить(Строка(URL), Новый Структура("Код, Тело", Код, Строка(Тело)));
КонецПроцедуры

// Значение ПроверятьSSL последнего вызова.
//
// Возвращаемое значение:
//  Булево, Неопределено - Неопределено, если вызовов не было.
//
Функция ПроверялСертификат() Экспорт
	Возврат ПоследнийSSL;
КонецФункции

// Значение РазрешитьПеренаправление последнего вызова.
//
// Возвращаемое значение:
//  Булево, Неопределено - Неопределено, если вызовов не было.
//
Функция РазрешалПеренаправление() Экспорт
	Возврат ПоследнийРедирект;
КонецФункции

// Контракт ТранспортHTTP.
//
// Параметры:
//  URL - Строка - адрес запроса.
//  Заголовки - Соответствие - заголовки (необязательный, по умолчанию Неопределено).
//  ТаймаутСек - Число - таймаут (необязательный, по умолчанию 20).
//  ПроверятьSSL - Булево - проверка сертификата (необязательный, по умолчанию Истина).
//  РазрешитьПеренаправление - Булево - идти ли по Location (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  Структура - Код (Число), Заголовки (Соответствие), Данные (ДвоичныеДанные).
//
Функция Получить(Знач URL, Знач Заголовки = Неопределено, Знач ТаймаутСек = 20,
	Знач ПроверятьSSL = Истина, Знач РазрешитьПеренаправление = Ложь) Экспорт

	ПоследнийSSL = ПроверятьSSL;
	ПоследнийРедирект = РазрешитьПеренаправление;

	Ответ = Ответы.Получить(Строка(URL));
	Если Ответ = Неопределено Тогда
		ВызватьИсключение "ФейкТранспортHTTPСПараметрами: ответ для " + URL + " не задан";
	КонецЕсли;

	Возврат Новый Структура("Код, Заголовки, Данные", Ответ.Код, Новый Соответствие(),
		ПолучитьДвоичныеДанныеИзСтроки(Ответ.Тело));

КонецФункции

// Контракт ТранспортHTTP.
//
// Параметры:
//  URL - Строка - адрес запроса.
//  Тело - Строка - тело запроса.
//  Заголовки - Соответствие - заголовки (необязательный, по умолчанию Неопределено).
//  ТаймаутСек - Число - таймаут (необязательный, по умолчанию 20).
//  ПроверятьSSL - Булево - проверка сертификата (необязательный, по умолчанию Истина).
//
// Возвращаемое значение:
//  Структура - Код, Заголовки, Данные.
//
Функция Отправить(Знач URL, Знач Тело, Знач Заголовки = Неопределено, Знач ТаймаутСек = 20,
	Знач ПроверятьSSL = Истина) Экспорт
	Возврат Получить(URL, Заголовки, ТаймаутСек, ПроверятьSSL, Ложь);
КонецФункции

// Значение User-Agent (контракт ТранспортHTTP).
//
// Возвращаемое значение:
//  Строка - имя агента.
//
Функция ИмяАгента() Экспорт
	Возврат "OpenHubReview/1.0";
КонецФункции

Процедура ПриСозданииОбъекта()
	Ответы = Новый Соответствие();
	ПоследнийSSL = Неопределено;
	ПоследнийРедирект = Неопределено;
КонецПроцедуры
