// Группы общих хабов живых наборов: имя группы в теге «хаб:<имя>» → латинский идентификатор
// переменной OSHUB_TEST_HUB_<ИДЕНТИФИКАТОР>, префикс временного каталога, окружение и сидер.

Перем Группы; // Массив из Структура — описания групп в порядке объявления

// Описание группы по имени из тега или по латинскому идентификатору.
// Неизвестная группа — исключение со списком известных.
//
// Параметры:
//  Группа - Строка - имя группы («витрина») или её идентификатор («SHOWCASE»).
//
// Возвращаемое значение:
//  Структура - описание группы:
//   * Имя           - Строка       - имя группы в теге набора.
//   * Идентификатор - Строка       - латинская часть имени переменной среды.
//   * Префикс       - Строка       - префикс временного каталога базы и хранилища.
//   * Окружение     - Соответствие - переменные окружения хаба: имя → значение.
//   * Сидер         - Строка, Массив из Строка - имя сидера из scripts/сидеры или несколько имён,
//                     которые запускаются по порядку; пусто — без засева.
//   * Мастер        - Структура, Неопределено - учётка первого администратора, которую наборы
//                     группы заводят мастером /setup (Логин, Пароль); Неопределено — группа без мастера.
//
Функция Описание(Знач Группа) Экспорт

	Для Каждого Описание Из Все() Цикл
		Если Описание.Имя = Группа ИЛИ Описание.Идентификатор = Группа Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;

	Имена = Новый Массив();
	Для Каждого Описание Из Все() Цикл
		Имена.Добавить(Описание.Имя);
	КонецЦикла;

	ВызватьИсключение СтрШаблон("Группа общего хаба «%1» не объявлена в ГруппыХабов; известны: %2.",
		Группа, СтрСоединить(Имена, ", "));

КонецФункции

// Все объявленные группы.
//
// Возвращаемое значение:
//  Массив из Структура - описания групп, как у Описание().
//
Функция Все() Экспорт

	Если Группы = Неопределено Тогда
		Группы = ОбъявитьГруппы();
	КонецЕсли;

	Возврат Группы;

КонецФункции

// Имя переменной среды, по которой наборы группы узнают внешний хаб.
//
// Параметры:
//  Группа - Строка - имя группы или её идентификатор.
//
// Возвращаемое значение:
//  Строка - «OSHUB_TEST_HUB_<ИДЕНТИФИКАТОР>».
//
Функция ПеременнаяАдреса(Знач Группа) Экспорт
	Возврат "OSHUB_TEST_HUB_" + Описание(Группа).Идентификатор;
КонецФункции

// Имя переменной среды с путём к журналу внешнего хаба группы.
//
// Параметры:
//  Группа - Строка - имя группы или её идентификатор.
//
// Возвращаемое значение:
//  Строка - «OSHUB_TEST_HUB_<ИДЕНТИФИКАТОР>_LOG».
//
Функция ПеременнаяЖурнала(Знач Группа) Экспорт
	Возврат ПеременнаяАдреса(Группа) + "_LOG";
КонецФункции

// Значение переменной окружения из описания группы — учётка админа, адрес хаба;
// переменная не объявлена или пуста — исключение с именами группы и переменной.
//
// Параметры:
//  Группа - Строка - имя группы или её идентификатор.
//  Имя    - Строка - имя переменной окружения хаба.
//
// Возвращаемое значение:
//  Строка - значение переменной.
//
Функция Окружение(Знач Группа, Знач Имя) Экспорт

	Группа_ = Описание(Группа);
	Значение = Группа_.Окружение.Получить(Имя);
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение СтрШаблон("Окружение группы «%1» не задаёт %2 — набору нечего взять из описания группы.",
			Группа_.Имя, Имя);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Учётка первого администратора, которую наборы группы заводят мастером /setup; группа её
// не объявляет — исключение с именем группы.
//
// Параметры:
//  Группа - Строка - имя группы или её идентификатор.
//
// Возвращаемое значение:
//  Структура - учётка мастера:
//   * Логин  - Строка - логин администратора.
//   * Пароль - Строка - его пароль.
//
Функция Мастер(Знач Группа) Экспорт

	Группа_ = Описание(Группа);
	Если Группа_.Мастер = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Группа «%1» не объявляет учётку мастера /setup — набору нечего пройти мастером.",
			Группа_.Имя);
	КонецЕсли;

	Возврат Группа_.Мастер;

КонецФункции

// Объявляет группу до Снять() — для сторожей механики общего хаба, которым нужна группа,
// не задевающая переменных настоящих групп.
//
// Параметры:
//  Имя           - Строка - имя группы.
//  Идентификатор - Строка - латинская часть имени переменной среды.
//  Префикс       - Строка - префикс временного каталога.
//
Процедура ОбъявитьНаВремя(Знач Имя, Знач Идентификатор, Знач Префикс) Экспорт
	Объявить(Все(), Имя, Идентификатор, Префикс);
КонецПроцедуры

// Снимает группу, объявленную ОбъявитьНаВремя(); неизвестное имя — без действия.
//
// Параметры:
//  Имя - Строка - имя группы.
//
Процедура Снять(Знач Имя) Экспорт

	Все_ = Все();
	Для Индекс = 0 По Все_.ВГраница() Цикл
		Если Все_[Индекс].Имя = Имя Тогда
			Все_.Удалить(Индекс);
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ОбъявитьГруппы()

	Результат = Новый Массив();

	// планировщик выключен, синхронизация зеркал работает; факты группы — тела сидеров (Засеять),
	// что из них трогает набор — его шапка
	Кабинет = Новый Соответствие();
	Кабинет.Вставить("OSHUB_ADMIN_LOGIN", "");
	Кабинет.Вставить("OSHUB_ADMIN_PASSWORD", "");
	Кабинет.Вставить("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Кабинет.Вставить("OSHUB_JOBS_ENABLED", "false");
	Кабинет.Вставить("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	Сидеры = Новый Массив();
	Сидеры.Добавить("ЗасеятьКабинет.os");
	Сидеры.Добавить("ЗасеятьСводкуКабинета.os");
	Объявить(Результат, "кабинет", "CABINET", "openhub-общий-кабинет", Кабинет, Сидеры);

	Объявить(Результат, "витрина", "SHOWCASE", "openhub-общая-витрина", Неопределено, "ЗасеятьХаб.os");

	// засев — пул public с пакетом spike0c-testpkg версий по умолчанию ЗасеятьПакет, 1.1.0.7 отозвана;
	// админ из окружения; фон выключен, как у «кабинета»; предел распакованного пакета — тот, что
	// просит ПубликацияPush
	Пакеты = Новый Соответствие();
	Пакеты.Вставить("OSHUB_ADMIN_LOGIN", "packages-admin");
	Пакеты.Вставить("OSHUB_ADMIN_PASSWORD", "PackagesAdminPass1");
	Пакеты.Вставить("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Пакеты.Вставить("OSHUB_JOBS_ENABLED", "false");
	Пакеты.Вставить("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	Пакеты.Вставить("OSHUB_INSTANCE_URL", "https://hub.example.ru");
	Пакеты.Вставить("OSHUB_PUBLISH_MAX__UNPACKED__BYTES", "536870912");
	Пакеты.Вставить("OSHUB_SEED_FIXTURE", ОбъединитьПути(КаталогиПроекта.Фикстуры(), "spike0c-testpkg-0.1.0.ospx"));
	Пакеты.Вставить("OSHUB_SEED_YANKED", "1.1.0.7");
	Объявить(Результат, "пакеты", "PACKAGES", "openhub-общие-пакеты", Пакеты, "ЗасеятьПакет.os");

	// хаб на пустой базе ждёт мастера /setup: администратора заводят сами наборы учёткой группы
	// (ОбщийХаб.ПройтиМастер); засева нет — пакетов на хабе нет, на этом стоят проверки пустого
	// лендинга; основной пул не назначен — общих пулов наборы группы не заводят
	Мастер = Новый Соответствие();
	// пустой админ из окружения — иначе хаб завёл бы его сам и мастер был бы пройден до наборов
	Мастер.Вставить("OSHUB_ADMIN_LOGIN", "");
	Мастер.Вставить("OSHUB_ADMIN_PASSWORD", "");
	// регистрация без почты открыта только так: АутентификацияHTTP, ВходCLIHTTP, ВебUI4UI, Брендирование
	Мастер.Вставить("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	// фон выключен, как у других групп: хаб группы — только HTTP наборов
	Мастер.Вставить("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Мастер.Вставить("OSHUB_JOBS_ENABLED", "false");
	// режим регистрации по умолчанию (открыта): ВебUI4UI регистрирует учётку с экрана
	Мастер.Вставить("OSHUB_AUTH_REGISTRATION_MODE", "");
	// замок ограничителя входа — 2 с: ВходCLIHTTP запирает 127.0.0.1 подбором кода,
	// АутентификацияHTTP — неудачными входами, соседи входят ВойтиДождавшись
	Мастер.Вставить("OSHUB_AUTH_LOGIN_LOCKOUTSECONDS", "2");
	Объявить(Результат, "мастер", "SETUP", "openhub-общий-мастер", Мастер, "",
		Новый Структура("Логин, Пароль", "root", "RootSecret1"));

	Возврат Результат;

КонецФункции

Процедура Объявить(Результат, Знач Имя, Знач Идентификатор, Знач Префикс, Знач Окружение = Неопределено,
	Знач Сидер = "", Знач Мастер = Неопределено)

	Если Окружение = Неопределено Тогда
		Окружение = Новый Соответствие();
	КонецЕсли;

	Результат.Добавить(Новый Структура("Имя, Идентификатор, Префикс, Окружение, Сидер, Мастер",
		Имя, Идентификатор, Префикс, Окружение, Сидер, Мастер));

КонецПроцедуры
