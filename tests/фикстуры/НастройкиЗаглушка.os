// Заглушка СервисНастроек: значения из карты, мутабельна; незнакомый ключ — исключение.

Перем Значения; // Соответствие: ключ (НРег) -> значение
Перем Вызовы Экспорт;  // Массив из Структура (Ключ, Значение, Кто, АдресIP) — записи через Установить
Перем Сбросы Экспорт;  // Массив из Структура (Ключ, Кто, АдресIP)

// Значение настройки по ключу.
//
// Параметры:
//  Ключ - Строка - ключ настройки (регистр и обрамляющие пробелы не важны).
//
// Возвращаемое значение:
//  Произвольный - заданное значение; для незаданного ключа бросает исключение.
//
Функция Значение(Знач Ключ) Экспорт

	НормКлюч = НРег(СокрЛП(Строка(Ключ)));
	Найдено = Значения.Получить(НормКлюч);
	Если Найдено = Неопределено Тогда
		ВызватьИсключение "НастройкиЗаглушка: значение ключа не задано: " + НормКлюч;
	КонецЕсли;
	Возврат Найдено;

КонецФункции

// Целое значение настройки с запасным числом — контракт СервисНастроек.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//  Дефолт - Число - что вернуть, когда значения нет либо оно непригодно.
//  Минимум - Число - нижняя граница результата (необязательный, по умолчанию 0).
//
// Возвращаемое значение:
//  Число.
//
Функция Целое(Знач Ключ, Знач Дефолт, Знач Минимум = 0) Экспорт

	Попытка
		Прочитанное = Цел(Число(Значение(Ключ)));
	Исключение
		Прочитанное = Цел(Дефолт);
	КонецПопытки;

	Возврат Макс(Цел(Минимум), Прочитанное);

КонецФункции

// Флаг настройки с запасным значением — контракт СервисНастроек.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//  Дефолт - Булево - что вернуть, когда значения нет.
//
// Возвращаемое значение:
//  Булево.
//
Функция Флаг(Знач Ключ, Знач Дефолт) Экспорт

	// значения заглушки задаются тестом уже типизированными, разбирать строку нечего
	Попытка
		Возврат Значение(Ключ) = Истина;
	Исключение
		Возврат Дефолт;
	КонецПопытки;

КонецФункции

// Записывает значение настройки доменным API — вызовы копятся для проверки.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//  Значение - Произвольный - новое значение.
//  Кто - Строка - автор изменения.
//  АдресIP - Строка - адрес источника (необязательный, по умолчанию "").
//
Процедура Установить(Знач Ключ, Знач Значение, Знач Кто, Знач АдресIP = "") Экспорт

	Вызовы.Добавить(Новый Структура("Ключ, Значение, Кто, АдресIP",
		Строка(Ключ), Значение, Строка(Кто), Строка(АдресIP)));
	Задать(Ключ, Значение);

КонецПроцедуры

// Сбрасывает значение настройки — вызовы копятся для проверки.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//  Кто - Строка - автор изменения.
//  АдресIP - Строка - адрес источника (необязательный, по умолчанию "").
//
Процедура Сбросить(Знач Ключ, Знач Кто, Знач АдресIP = "") Экспорт

	Сбросы.Добавить(Новый Структура("Ключ, Кто, АдресIP",
		Строка(Ключ), Строка(Кто), Строка(АдресIP)));

КонецПроцедуры

// Задаёт значение настройки, перезаписывая прежнее.
//
// Параметры:
//  Ключ - Строка - ключ настройки.
//  НовоеЗначение - Произвольный - новое значение.
//
Процедура Задать(Знач Ключ, Знач НовоеЗначение) Экспорт
	Значения.Вставить(НРег(СокрЛП(Строка(Ключ))), НовоеЗначение);
КонецПроцедуры

// Задаёт настройки входа одним вызовом.
//
// Параметры:
//  МаксПопыток - Число - число попыток входа до блокировки.
//  СекундБлокировки - Число - длительность блокировки, секунд.
//
Процедура ЗадатьВход(Знач МаксПопыток, Знач СекундБлокировки) Экспорт
	Задать("oshub.auth.login.maxattempts", МаксПопыток);
	Задать("oshub.auth.login.lockoutseconds", СекундБлокировки);
КонецПроцедуры

// Задаёт настройки доставки подписок одним вызовом — все ключи раздела сразу.
//
// Параметры:
//  Включена - Булево - общий рубильник доставки.
//  МаксПопыток - Число - сколько раз повторять недоставленное.
//  БэкоффБаза - Число - основание паузы между повторами, секунд.
//  МаксОчередь - Число - потолок очереди недоставленного.
//  РазрешитьHTTP - Булево - допускать http и непроверенный TLS.
//
Процедура ЗадатьПодписки(Знач Включена = Истина, Знач МаксПопыток = 5, Знач БэкоффБаза = 10,
	Знач МаксОчередь = 10000, Знач РазрешитьHTTP = Ложь) Экспорт

	Задать("oshub.webhooks.delivery_enabled", Включена);
	Задать("oshub.webhooks.max_attempts", МаксПопыток);
	Задать("oshub.webhooks.backoff_base_sec", БэкоффБаза);
	Задать("oshub.webhooks.max_queue", МаксОчередь);
	Задать("oshub.webhooks.allow_insecure", РазрешитьHTTP);
	Задать("oshub.webhooks.delivery_timeout_sec", 10);
	Задать("oshub.webhooks.delivery_interval_sec", 5);

КонецПроцедуры

// Задаёт настройки прокси апстрима одним вызовом.
//
// Параметры:
//  Таймаут - Число - таймаут похода в чужой хаб, секунд.
//  Офлайн - Булево - принудительный офлайн.
//  НегативныйTTL - Число - срок отрицательного ответа источника, секунд.
//  TTLПерепроверки - Число - срок памяти о живости источника, секунд.
//
Процедура ЗадатьПрокси(Знач Таймаут = 20, Знач Офлайн = Ложь, Знач НегативныйTTL = 60,
	Знач TTLПерепроверки = 300, Знач ПотолокРедиректов = 5, Знач ПробаВключена = Истина) Экспорт

	Задать("oshub.proxy.timeout.sec", Таймаут);
	Задать("oshub.proxy.offline", Офлайн);
	Задать("oshub.proxy.negative.ttl.sec", НегативныйTTL);
	Задать("oshub.proxy.upstream.recheck.ttl.sec", TTLПерепроверки);
	Задать("oshub.proxy.max_redirects", ПотолокРедиректов);
	Задать("oshub.upstream.probe.enabled", ПробаВключена);

КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Значения = Новый Соответствие();
	Вызовы = Новый Массив();
	Сбросы = Новый Массив();
КонецПроцедуры
