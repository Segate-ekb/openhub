// Разбор того, что принял фейковый OTLP-коллектор: партии спанов и срезы метрик
// в протоколе http/json. Живые наборы читают принятое ЗНАЧЕНИЯМИ — спанами, родителями,
// атрибутами и точками данных, — а не подстрокой в теле партии: имя прибора встречается
// в партии и тогда, когда вызовов не было ни одного.
//
// Разбор живёт одной фикстурой затем, что копий его было две и они успели разойтись.

#Область РазборТрасс

// Все уехавшие спаны по их идентификаторам. Партии дописываются в файл одна за другой,
// поэтому текст делится по началу документа OTLP, а недописанный хвост отбрасывается.
//
// Параметры:
//  Тело - Строка - всё, что принял коллектор по сигналу traces.
//
// Возвращаемое значение:
//  Соответствие - идентификатор спана -> описание спана.
//
Функция СпаныПартий(Знач Тело) Экспорт

	Спаны = Новый Соответствие();

	Для Каждого Документ Из ДокументыПартий(Тело) Цикл
		Для Каждого РесурсныеСпаны Из Документ["resourceSpans"] Цикл
			Для Каждого ОбластныеСпаны Из РесурсныеСпаны["scopeSpans"] Цикл
				Для Каждого Спан Из ОбластныеСпаны["spans"] Цикл
					Спаны.Вставить(Спан["spanId"], ОписаниеСпана(Спан));
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Возврат Спаны;

КонецФункции

// Разобранные документы партий трасс из принятого коллектором.
//
// Параметры:
//  Тело - Строка - всё, что принял коллектор по сигналу traces.
//
// Возвращаемое значение:
//  Массив - разобранные документы OTLP/JSON.
//
Функция ДокументыПартий(Знач Тело) Экспорт

	// СтрРазделить режет по КАЖДОМУ символу разделителя, поэтому начало документа сперва
	// помечается служебным символом, которого в JSON быть не может, и режется уже по нему.
	Маркер = "{" + Символы.ПС + """resourceSpans""";
	Метка = Символ(1);
	Размеченное = СтрЗаменить(Тело, Маркер, Метка + Маркер);

	Результат = Новый Массив();

	Для Каждого Кусок Из СтрРазделить(Размеченное, Метка, Ложь) Цикл
		Попытка
			Чтение = Новый ЧтениеJSON();
			Чтение.УстановитьСтроку(Кусок);
			Результат.Добавить(ПрочитатьJSON(Чтение));
			Чтение.Закрыть();
		Исключение
			// голова файла до первой партии и недописанный хвост последней
		КонецПопытки;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Спан OTLP/JSON в том виде, в каком его читают наборы: имя, трасса, ссылка на родителя,
// границы в наносекундах и атрибуты значениями.
//
// Параметры:
//  Спан - Соответствие - спан из разобранной партии.
//
// Возвращаемое значение:
//  Структура - Имя, Трасса, Родитель, Начало, Конец, Атрибуты.
//
Функция ОписаниеСпана(Знач Спан) Экспорт

	Возврат Новый Структура("Имя, Трасса, Родитель, Начало, Конец, Атрибуты",
		Спан["name"], Спан["traceId"], Спан["parentSpanId"],
		МоментНаносекунд(Спан["startTimeUnixNano"]), МоментНаносекунд(Спан["endTimeUnixNano"]),
		Атрибуты(Спан));

КонецФункции

// Первый спан с таким именем.
//
// Параметры:
//  Спаны - Соответствие - разобранные спаны.
//  Имя - Строка - имя спана.
//
// Возвращаемое значение:
//  Структура, Неопределено - описание спана; Неопределено, если такого нет.
//
Функция СпанСИменем(Знач Спаны, Знач Имя) Экспорт

	Для Каждого Пара Из Спаны Цикл
		Если Пара.Значение.Имя = Имя Тогда
			Возврат Пара.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Первый спан, несущий атрибут с таким значением.
//
// Параметры:
//  Спаны - Соответствие - разобранные спаны.
//  Ключ - Строка - ключ атрибута.
//  Значение - Строка - значение атрибута.
//
// Возвращаемое значение:
//  Структура, Неопределено - описание спана; Неопределено, если такого нет.
//
Функция СпанСАтрибутом(Знач Спаны, Знач Ключ, Знач Значение) Экспорт

	Для Каждого Пара Из Спаны Цикл
		Если Пара.Значение.Атрибуты[Ключ] = Значение Тогда
			Возврат Пара.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Сколько спанов с этим именем среди разобранных.
//
// Параметры:
//  Спаны - Соответствие - разобранные спаны.
//  Имя - Строка - имя спана.
//
// Возвращаемое значение:
//  Число.
//
Функция СпановСИменем(Знач Спаны, Знач Имя) Экспорт

	Счёт = 0;
	Для Каждого Пара Из Спаны Цикл
		Если Пара.Значение.Имя = Имя Тогда
			Счёт = Счёт + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Счёт;

КонецФункции

// Корневой ли спан: у корня ссылки на родителя нет вовсе.
//
// Параметры:
//  Спан - Структура - описание спана.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоКорень(Знач Спан) Экспорт
	Возврат НЕ ЗначениеЗаполнено(Спан.Родитель);
КонецФункции

#КонецОбласти

#Область РазборМетрик

// Все срезы прибора из принятого коллектором: по одному на партию метрик.
//
// Параметры:
//  Тело - Строка - всё, что принял коллектор по сигналу metrics.
//  ИмяПрибора - Строка - имя прибора OTel.
//
// Возвращаемое значение:
//  Массив - разобранные приборы (по одному на партию).
//
Функция СнимкиПрибора(Знач Тело, Знач ИмяПрибора) Экспорт

	Снимки = Новый Массив();

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Тело);
	Пока Истина Цикл
		Партия = ОчереднаяПартия(Чтение);
		Если Партия = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Для Каждого Ресурс Из Список(Партия, "resourceMetrics") Цикл
			Для Каждого Область Из Список(Ресурс, "scopeMetrics") Цикл
				Для Каждого Прибор Из Список(Область, "metrics") Цикл
					Если Прибор.Получить("name") = ИмяПрибора Тогда
						Снимки.Добавить(Прибор);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Чтение.Закрыть();

	Возврат Снимки;

КонецФункции

// Очередная партия потока; Неопределено — партии кончились. Принятое коллектором это
// все партии подряд, одна за другой, и конец потока разбор сообщает исключением.
//
// Параметры:
//  Чтение - ЧтениеJSON - поток принятого.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - разобранная партия.
//
Функция ОчереднаяПартия(Знач Чтение) Экспорт

	Попытка
		Возврат ПрочитатьJSON(Чтение, Истина);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Точки данных прибора из всех его срезов — значением и атрибутами. Своя точка данных
// у каждой комбинации атрибутов, поэтому разрез по пулу виден только здесь.
//
// Параметры:
//  Тело - Строка - всё, что принял коллектор по сигналу metrics.
//  ИмяПрибора - Строка - имя прибора OTel.
//
// Возвращаемое значение:
//  Массив из Структура - Значение (Число), Атрибуты (Соответствие).
//
Функция ТочкиПрибора(Знач Тело, Знач ИмяПрибора) Экспорт

	Результат = Новый Массив();

	Для Каждого Прибор Из СнимкиПрибора(Тело, ИмяПрибора) Цикл
		Точки = ТочкиДанных(Прибор);
		Если Точки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Точка Из Точки Цикл
			Результат.Добавить(Новый Структура("Значение, Атрибуты",
				ЧислоТочки(Точка, "asInt") + ЧислоТочки(Точка, "asDouble"), Атрибуты(Точка)));
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Наибольшее значение точки данных, у которой атрибут равен названному. -1 — такой
// точки среди срезов нет. Берётся наибольшее: срезы накопительные, и самый ранний снят
// на непрогретом хабе.
//
// Параметры:
//  Тело - Строка - всё, что принял коллектор по сигналу metrics.
//  ИмяПрибора - Строка - имя прибора OTel.
//  Ключ - Строка - ключ атрибута.
//  Значение - Строка - значение атрибута.
//
// Возвращаемое значение:
//  Число.
//
Функция НаибольшееСАтрибутом(Знач Тело, Знач ИмяПрибора, Знач Ключ, Знач Значение) Экспорт

	Наибольшее = -1;

	Для Каждого Точка Из ТочкиПрибора(Тело, ИмяПрибора) Цикл
		Если Точка.Атрибуты[Ключ] = Значение Тогда
			Наибольшее = Макс(Наибольшее, Точка.Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Наибольшее;

КонецФункции

// Значение прибора из принятого коллектором, числом. Читается разбором, а не поиском
// числа за именем: первое число после имени принадлежит СОСЕДУ по партии не реже, чем
// самому прибору. Берётся ПОСЛЕДНИЙ срез: в принятом лежат все партии с начала прогона,
// а самый ранний снят на непрогретом хабе. -1 — прибора в партиях нет либо точек нет.
//
// Параметры:
//  Тело - Строка - всё, что принял коллектор по сигналу metrics.
//  ИмяПрибора - Строка - имя прибора OTel.
//
// Возвращаемое значение:
//  Число.
//
Функция ЗначениеИзПрибора(Знач Тело, Знач ИмяПрибора) Экспорт

	Найденное = -1;

	Для Каждого Прибор Из СнимкиПрибора(Тело, ИмяПрибора) Цикл
		Найденное = ЧислоТочкиДанных(Прибор);
	КонецЦикла;

	Возврат Найденное;

КонецФункции

// Значение единственной точки данных прибора. -1 — точки данных нет.
//
// Параметры:
//  Прибор - Соответствие - разобранный прибор из партии.
//
// Возвращаемое значение:
//  Число.
//
Функция ЧислоТочкиДанных(Знач Прибор) Экспорт

	Точки = ТочкиДанных(Прибор);
	Если Точки = Неопределено ИЛИ Точки.Количество() = 0 Тогда
		Возврат -1;
	КонецЕсли;

	Значение = Точки[0].Получить("asInt");
	Если Значение = Неопределено Тогда
		Значение = Точки[0].Получить("asDouble");
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Возврат -1;
	КонецЕсли;

	Возврат ЧислоПоля(Значение);

КонецФункции

// Точки данных лежат внутри агрегации, а вид её у датчика, счётчика и гистограммы свой.
//
// Параметры:
//  Прибор - Соответствие - разобранный прибор из партии.
//
// Возвращаемое значение:
//  Массив, Неопределено - точки данных; Неопределено, если агрегации нет.
//
Функция ТочкиДанных(Знач Прибор) Экспорт

	Для Каждого Вид Из ВидыАгрегации() Цикл
		Агрегация = Прибор.Получить(Вид);
		Если Агрегация <> Неопределено Тогда
			Возврат Агрегация.Получить("dataPoints");
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Точки данных прибора внутри агрегации своего вида; пустой массив — агрегации нет.
//
// Параметры:
//  Прибор - Соответствие - разобранный прибор из партии.
//  ВидАгрегации - Строка - gauge, sum либо histogram.
//
// Возвращаемое значение:
//  Массив.
//
Функция ТочкиАгрегации(Знач Прибор, Знач ВидАгрегации) Экспорт

	Агрегация = Прибор.Получить(ВидАгрегации);

	Возврат ?(Агрегация = Неопределено, Новый Массив(), Список(Агрегация, "dataPoints"));

КонецФункции

// Число из поля точки данных: экспортёр пишет его то строкой ("asInt": "3"), то числом
// ("count": 3). Ноль — поля в точке нет.
//
// Параметры:
//  Точка - Соответствие - точка данных.
//  Поле - Строка - имя поля.
//
// Возвращаемое значение:
//  Число.
//
Функция ЧислоТочки(Знач Точка, Знач Поле) Экспорт

	Значение = Точка.Получить(Поле);

	Возврат ?(Значение = Неопределено, 0, ЧислоПоля(Значение));

КонецФункции

Функция ВидыАгрегации() Экспорт
	Возврат СтрРазделить("gauge,sum,histogram", ",");
КонецФункции

// Массив по ключу разобранного куска партии; пустой массив — ключа нет.
//
// Параметры:
//  Поля - Соответствие, Структура - разобранный кусок партии.
//  Ключ - Строка - имя поля.
//
// Возвращаемое значение:
//  Массив.
//
Функция Список(Знач Поля, Знач Ключ) Экспорт

	Значение = Поле(Поля, Ключ);

	Возврат ?(Значение = Неопределено, Новый Массив(), Значение);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// В OTLP значение атрибута завёрнуто в объект вида {"stringValue": "main"} — и у спана,
// и у точки данных метрики.
Функция Атрибуты(Знач Носитель)

	Результат = Новый Соответствие();

	Для Каждого Атрибут Из Список(Носитель, "attributes") Цикл
		Для Каждого Обёртка Из Атрибут["value"] Цикл
			Результат.Вставить(Атрибут["key"], Обёртка.Значение);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Трассы разбираются в Структуру, а срезы метрик — в Соответствие: у первой поля
// спрашиваются Свойством, у второго — Получить. Разбор читает оба сигнала, поэтому
// поле берётся одной дверью.
Функция Поле(Знач Носитель, Знач Ключ)

	Если ТипЗнч(Носитель) = Тип("Структура") Тогда
		Значение = Неопределено;
		Носитель.Свойство(Ключ, Значение);
		Возврат Значение;
	КонецЕсли;

	Возврат Носитель.Получить(Ключ);

КонецФункции

// Момент спана в наносекундах. 64-битные числа OTLP/JSON кодирует десятичной строкой,
// но экспортёр вправе отдать и число — принимаются обе формы.
Функция МоментНаносекунд(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ?(ЗначениеЗаполнено(Значение), Число(Значение), 0);

КонецФункции

// Через Строка() число прогонять нельзя: она вставляет разделители групп, и Число()
// потом падает.
Функция ЧислоПоля(Знач Значение)
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Цел(Значение), Цел(Число(Значение)));
КонецФункции

#КонецОбласти
