// Заглушка ответа winow в том объёме, которым пользуется шов входа: код состояния,
// модель стандартного шаблона, заголовки, тело, куки и код запроса.

Перем ИдентификаторЗапроса Экспорт;
Перем СостояниеКод Экспорт;
Перем Модель Экспорт;        // Структура стандартного шаблона winow либо Неопределено
Перем Заголовки Экспорт;
Перем ТелоТекст Экспорт;
Перем Куки Экспорт;

// Устанавливает код состояния ответа.
//
// Параметры:
//  НовыйКод - Число - код HTTP.
//
Процедура УстановитьСостояние(Знач НовыйКод) Экспорт
	СостояниеКод = НовыйКод;
КонецПроцедуры

// Устанавливает код состояния 200.
//
Процедура УстановитьСостояниеОК() Экспорт
	СостояниеКод = 200;
КонецПроцедуры

// Устанавливает заголовок Content-Type.
//
// Параметры:
//  Тип - Строка - значение заголовка.
//
Процедура УстановитьТипКонтента(Знач Тип) Экспорт
	Заголовки["Content-Type"] = Тип;
КонецПроцедуры

// Значение заголовка ответа.
//
// Параметры:
//  Имя - Строка - имя заголовка.
//
// Возвращаемое значение:
//  Строка - значение либо "" для незаданного заголовка.
//
Функция Заголовок(Знач Имя) Экспорт
	Значение = Заголовки[Имя];
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

// Наполняет ответ так, как это делает сам winow, поймав исключение обработчика:
// код 500, модель стандартного шаблона и дословный текст сбоя в ней.
//
// Параметры:
//  Текст - Строка - текст исключения, каким его сохранил winow.
//
// Возвращаемое значение:
//  ОтветWinowЗаглушка - этот же объект.
//
Функция КакПятисоткаWinow(Знач Текст) Экспорт

	СостояниеКод = 500;
	Модель = Новый Структура();
	Модель.Вставить("КодСостояния", 500);
	Модель.Вставить("ТекстСообщения", Текст);
	Модель.Вставить("Запрос", Неопределено);
	ТелоТекст = Текст;
	Возврат ЭтотОбъект;

КонецФункции

Процедура ПриСозданииОбъекта(Знач КодЗапроса = "") Экспорт

	ИдентификаторЗапроса = КодЗапроса;
	СостояниеКод = "";
	Модель = Неопределено;
	Заголовки = Новый Соответствие();
	ТелоТекст = "";
	Куки = Неопределено;

КонецПроцедуры
