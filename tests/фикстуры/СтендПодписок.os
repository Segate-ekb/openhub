// Стенд подписок на доменные события: строка вебхука хаба, пула или пакета — одной дверью
// вместо полутора десятков присваиваний, переписанных в трёх наборах.
//
// Дверь выбирает набор. «Строкой» (Подписка) кладёт запись прямо в хранилище: так нужен
// набору, который проверяет отбор запросов или уборку пула — там подписка только фон,
// а объекта, на который она заведена, в реестре может и не быть. «Службами хаба»
// (ПодпискаСлужбой) заводит подписку руками СервисаПодписок, со всеми последствиями:
// требование прав на объект, канон типа действия, нормализация типов событий, отказ
// на дубле адреса.
//
// Автора подписки хаб судит на каждой доставке: подписку УРОВНЯ ХАБА он выбирает, только
// если её завёл человек, который админом остаётся до сих пор (СервисПодписок,
// АвторДоСихПорАдмин). Поэтому автор — параметр двери, а не подразумеваемый ноль: стенд
// хабовой подписки без автора доставок не получит никогда, и набор про доставку зеленел бы
// на пустом списке. Подписке пула и пакета автор безразличен.

Перем Контейнер;

// Заводит подписку строкой в хранилище.
//
// Параметры:
//  ТипОбъекта - Строка - «хаб», «пул» либо «пакет».
//  ОбъектИлиИдентификатор - Пул, Пакет, Число - объект-владелец подписки; 0 для хаба.
//  ПулИдентификатор - Число - пул-контейнер подписки, скоуп приватности; 0 для подписки
//                     хаба (необязательный, по умолчанию 0).
//  URL - Строка - адрес действия (необязательный, по умолчанию "" — свободный
//        «https://hook.example/<имя>»).
//  ТипыСобытий - Строка - типы через запятую (необязательный, по умолчанию
//                "версия.опубликована").
//  Активен - Булево - получает ли подписка доставки (необязательный, по умолчанию Истина).
//  Автор - Пользователь, Число - кто завёл подписку; на подписке УРОВНЯ ХАБА автор обязан
//          быть действующим админом, иначе доставок не будет (необязательный,
//          по умолчанию 0 — автора нет).
//
// Возвращаемое значение:
//  Вебхук - сохранённая строка подписки.
//
Функция Подписка(Знач ТипОбъекта, Знач ОбъектИлиИдентификатор, Знач ПулИдентификатор = 0,
	Знач URL = "", Знач ТипыСобытий = "версия.опубликована", Знач Активен = Истина,
	Знач Автор = 0) Экспорт

	Запись = Контейнер.НайтиЖелудь("ХранилищеВебхуков").СоздатьЭлемент();
	Запись.ТипОбъекта = ТипОбъекта;
	Запись.ОбъектИдентификатор = ПомощникиСтендов.Идентификатор(ОбъектИлиИдентификатор);
	Запись.ПулИдентификатор = Цел(ПулИдентификатор);
	Запись.ТипДействия = ТипДействияПоУмолчанию();
	Запись.URL = ?(ЗначениеЗаполнено(URL), URL,
		"https://hook.example/" + УникальныеИмена.Имя("h"));
	Запись.Секрет = "";
	Запись.НастройкиДействия = "";
	Запись.ТокенДействия = "";
	Запись.ШаблонТекста = "";
	Запись.ТипыСобытий = ТипыСобытий;
	Запись.ПараметрыСобытийJSON = "";
	Запись.Активен = Активен;
	Запись.СозданКем = ПомощникиСтендов.Идентификатор(Автор);
	Запись.Создан = ТекущаяУниверсальнаяДата();
	Запись.Обновлён = Запись.Создан;
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

// Заводит подписку руками хаба — СервисПодписок, как это делает экран подписок объекта.
//
// Параметры:
//  Инициатор - Пользователь - от чьего имени заводится подписка; права на объект
//              обязательны.
//  Объект - Структура - описание объекта от СервисаПодписок (ОбъектХаба, ОбъектПула,
//           ОбъектПакета).
//  URL - Строка - адрес действия (необязательный, по умолчанию "" — свободный
//        «https://hook.example/<имя>»).
//  ТипыСобытий - Строка - типы через запятую (необязательный, по умолчанию
//                "версия.опубликована").
//
// Возвращаемое значение:
//  Вебхук - заведённая запись подписки.
//
Функция ПодпискаСлужбой(Знач Инициатор, Знач Объект, Знач URL = "",
	Знач ТипыСобытий = "версия.опубликована") Экспорт

	Адрес = ?(ЗначениеЗаполнено(URL), URL,
		"https://hook.example/" + УникальныеИмена.Имя("h"));

	Возврат Контейнер.НайтиЖелудь("СервисПодписок").Создать(Инициатор, Объект, Адрес, ТипыСобытий);

КонецФункции

#Область Служебное

// Тип действия у подписки, заведённой строкой, — тот же, что кладёт СервисПодписок:
// подписку с чужим написанием типа обработчик доставки не узнает.
Функция ТипДействияПоУмолчанию()
	Возврат "вебхук";
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач Поделка)
	Контейнер = Поделка;
КонецПроцедуры
