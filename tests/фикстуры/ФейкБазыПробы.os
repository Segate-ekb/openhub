// База без базы для пробы: источник данных с заданным пулом и пределом и заодно таблица, из
// которой проба читает строку. Считает чтения и умеет падать по команде теста; счётчик чтений —
// то, чем доказывается, что проба при исчерпанном пуле в базу не пошла.

Перем Пул_;
Перем Предел_;
Перем Обращений_;
Перем ТекстОтказа_;

#Область КонтрактИсточника

// Пул соединений источника.
//
// Возвращаемое значение:
//  ФейкПулСоединений.
//
Функция ПулСоединений() Экспорт
	Возврат Пул_;
КонецФункции

// Предел одновременно живущих соединений; 0 — без предела.
//
// Возвращаемое значение:
//  Число.
//
Функция РазмерПула() Экспорт
	Возврат Предел_;
КонецФункции

#КонецОбласти

#Область КонтрактТаблицы

// Первые строки таблицы: считает обращение и падает, если тесту нужен отказ базы.
//
// Параметры:
//  Количество - Число - максимум строк.
//
// Возвращаемое значение:
//  Массив - всегда пустой: проба смотрит на факт ответа, а не на строки.
//
Функция ПолучитьПервые(Количество) Экспорт

	Обращений_ = Обращений_ + 1;

	Если ЗначениеЗаполнено(ТекстОтказа_) Тогда
		ВызватьИсключение ТекстОтказа_;
	КонецЕсли;

	Возврат Новый Массив();

КонецФункции

#КонецОбласти

#Область УправлениеИзТеста

// Сколько раз у базы спросили строки.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Обращений_;
КонецФункции

// Заставляет следующие выборки падать с этим текстом.
//
// Параметры:
//  Текст - Строка - текст исключения.
//
Процедура ПадатьС(Знач Текст) Экспорт
	ТекстОтказа_ = Текст;
КонецПроцедуры

#КонецОбласти

// Пул и предел задаёт тест; выборки по умолчанию проходят.
//
// Параметры:
//  Пул    - ФейкПулСоединений - снимок занятости.
//  Предел - Число - размер пула; 0 — без предела.
//
Процедура ПриСозданииОбъекта(Знач Пул, Знач Предел) Экспорт
	Пул_ = Пул;
	Предел_ = Предел;
	Обращений_ = 0;
	ТекстОтказа_ = "";
КонецПроцедуры
