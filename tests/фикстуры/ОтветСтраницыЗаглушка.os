// Заглушка ответа winow для экранов: код состояния, заголовки, тело, редирект и куки.
// Куки приходят отдельным объектом, чтобы фикстуры не зависели друг от друга по типу.

Перем Код Экспорт;
Перем Заголовки Экспорт;
Перем ТелоТекст Экспорт;
Перем ТелоДвоичныеДанные Экспорт;   // экраны его не пишут
Перем ТелоПоток Экспорт;            // отдача файлов пишет тело потоком
Перем ТелоФайл Экспорт;             // Строка - файл тела, когда он отдаётся по ходу загрузки
Перем ДлинаТела Экспорт;            // Число - объявленная длина такого файла
Перем ПрочитанноеТело;               // ДвоичныеДанные - тело потока, дочитанное один раз
Перем ПутьРедиректа Экспорт;
Перем Куки Экспорт;       // КукиОтветаЗаглушка

// Устанавливает код состояния ответа.
//
// Параметры:
//  НовыйКод - Число - код HTTP.
//
Процедура УстановитьСостояние(Знач НовыйКод) Экспорт
	Код = НовыйКод;
КонецПроцедуры

// Устанавливает код состояния 200.
//
Процедура УстановитьСостояниеОК() Экспорт
	Код = 200;
КонецПроцедуры

// Устанавливает код состояния 404.
//
Процедура УстановитьСостояниеНеНайдено() Экспорт
	Код = 404;
КонецПроцедуры

// Устанавливает заголовок Content-Type.
//
// Параметры:
//  Тип - Строка - значение заголовка.
//
Процедура УстановитьТипКонтента(Знач Тип) Экспорт
	Заголовки["Content-Type"] = Тип;
КонецПроцедуры

// Запоминает адрес перенаправления.
//
// Параметры:
//  Путь - Строка - адрес перенаправления.
//
Процедура Перенаправить(Знач Путь) Экспорт
	Код = 302;
	ПутьРедиректа = Строка(Путь);
КонецПроцедуры

// Как у winow: тело из файла потоком.
//
// Параметры:
//  ПутьКФайлу - Строка - файл тела.
//  Длина - Число - полный размер файла, который ещё дописывается (необязательный).
//
Процедура УстановитьТелоИзФайла(Знач ПутьКФайлу, Знач Длина = Неопределено) Экспорт
	ТелоФайл = ПутьКФайлу;
	ДлинаТела = Длина;
	ТелоПоток = Новый ФайловыйПоток(ПутьКФайлу, РежимОткрытияФайла.Открыть, ДоступКФайлу.Чтение);
КонецПроцедуры

// Тело, положенное потоком, — дочитанное и закрытое, как его закрыл бы веб-сервер.
//
// Возвращаемое значение:
//  ДвоичныеДанные, Неопределено - тело; Неопределено, если потока нет.
//
Функция ТелоДанными() Экспорт

	Если ПрочитанноеТело = Неопределено И ТелоПоток <> Неопределено Тогда
		ПрочитанноеТело = ?(ДлинаТела = Неопределено,
			Новый ЧтениеДанных(ТелоПоток).Прочитать().ПолучитьДвоичныеДанные(), ДочитатьДоДлины());
		ТелоПоток.Закрыть();
	КонецЕсли;
	Возврат ПрочитанноеТело;

КонецФункции

// Файл, отданный по ходу загрузки, дочитывается до объявленной длины, как это делает winow;
// дольше пяти секунд не ждёт.
Функция ДочитатьДоДлины()

	Чтение = Новый ЧтениеДанных(ТелоПоток);
	Части = Новый Массив();
	Прочитано = 0;
	Ожиданий = 0;
	Пока Прочитано < ДлинаТела И Ожиданий < 250 Цикл
		Порция = Чтение.Прочитать(ДлинаТела - Прочитано).ПолучитьДвоичныеДанные();
		Если Порция.Размер() = 0 Тогда
			Ожиданий = Ожиданий + 1;
			Приостановить(20);
			Продолжить;
		КонецЕсли;
		Части.Добавить(Порция);
		Прочитано = Прочитано + Порция.Размер();
	КонецЦикла;

	Возврат СоединитьДвоичныеДанные(Части);

КонецФункции

// Значение заголовка ответа.
//
// Параметры:
//  Имя - Строка - имя заголовка.
//
// Возвращаемое значение:
//  Строка - значение либо "" для незаданного заголовка.
//
Функция Заголовок(Знач Имя) Экспорт
	Значение = Заголовки[Имя];
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

// Параметры:
//  КукиОтвета - КукиОтветаЗаглушка - куда экран пишет куки (необязательный,
//               по умолчанию Неопределено — экран кук не ставит).
//
Процедура ПриСозданииОбъекта(Знач КукиОтвета = Неопределено) Экспорт

	Код = 0;
	Заголовки = Новый Соответствие();
	ТелоТекст = "";
	ТелоДвоичныеДанные = Неопределено;
	ТелоПоток = Неопределено;
	ПутьРедиректа = "";
	Куки = КукиОтвета;

КонецПроцедуры
