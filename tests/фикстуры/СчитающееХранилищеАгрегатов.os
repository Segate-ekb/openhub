// ХранилищеСкачиванийАгрегатов в памяти, считающее ПРОЧИТАННЫЕ СТРОКИ: разрез «весь хаб»
// и разрез «по списку пакетов» стоят одного запроса каждый. Суммы отдаются готовыми —
// так их считает база, — и строк за собой не оставляют: по ним и видно, что витрина
// перестала поднимать суточные строки ради суммы.

Перем Агрегаты;   // Массив из Структура (ПакетИдентификатор, Количество)
Перем Счётчик;   // СчётчикОбращений — счёт запросов и прочитанных строк
Перем НомерПоколения;
Перем ОтказатьНаСледующем;

// Заказывает разовый отказ базы: ближайшее чтение бросит исключение, дальнейшие пройдут.
// Так проверяется, что витрина не запоминает сбойное чтение как удавшееся.
//
Процедура ОтказатьОдинРаз() Экспорт
	ОтказатьНаСледующем = Истина;
КонецПроцедуры

// Поколение таблицы: витрина сверяет его, чтобы заметить чужую запись. Фикстура заводит
// строки методом Добавить — он и меняет поколение.
//
// Возвращаемое значение:
//  Число.
//
Функция Поколение() Экспорт
	Возврат НомерПоколения;
КонецФункции

#Область Счётчики

// Сколько строк агрегатов хранилище отдало с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Строк() Экспорт
	Возврат Счётчик.Строк();
КонецФункции

// Сколько запросов к хранилищу ушло с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Запросов() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

#КонецОбласти

// Заводит суточный агрегат (за обращение не считается).
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Количество - Число - сколько скачиваний в строке.
//
Процедура Добавить(Знач ПакетИдентификатор, Знач Количество) Экспорт

	НомерПоколения = НомерПоколения + 1;
	Агрегаты.Добавить(Новый Структура("ПакетИдентификатор, Количество",
		Цел(ПакетИдентификатор), Цел(Количество)));

КонецПроцедуры

// Все агрегаты хаба — дверь, через которую цена росла числом пакетов.
//
// Возвращаемое значение:
//  Массив - все строки агрегатов.
//
Функция Все() Экспорт
	Возврат Отдать(Агрегаты);
КонецФункции

// Агрегаты перечисленных пакетов.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Массив - строки агрегатов перечисленных пакетов.
//
Функция АгрегатыПакетов(Знач ПакетИдентификаторы) Экспорт
	Возврат Отдать(Отобрать(ПакетИдентификаторы));
КонецФункции

// Суммы скачиваний по всем пакетам хаба; считает обращение, строк не отдаёт.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (идентификатор пакета), значение Число.
//
Функция СуммыПоПакетам() Экспорт
	Возврат Сумма(Агрегаты);
КонецФункции

// Суммы скачиваний названных пакетов; считает обращение, строк не отдаёт.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Соответствие - ключ Число (идентификатор пакета), значение Число.
//
Функция СуммыПакетов(Знач ПакетИдентификаторы) Экспорт
	Возврат Сумма(Отобрать(ПакетИдентификаторы));
КонецФункции

Функция Сумма(Знач Строки)

	Если ОтказатьНаСледующем Тогда
		ОтказатьНаСледующем = Ложь;
		ВызватьИсключение "СчитающееХранилищеАгрегатов: заказанный разовый отказ базы";
	КонецЕсли;

	Счётчик.Отметить();

	Итог = Новый Соответствие();
	Для Каждого Агрегат Из Строки Цикл
		Было = Итог.Получить(Агрегат.ПакетИдентификатор);
		Итог.Вставить(Агрегат.ПакетИдентификатор,
			?(Было = Неопределено, 0, Было) + Агрегат.Количество);
	КонецЦикла;

	Возврат Итог;

КонецФункции

Функция Отобрать(Знач ПакетИдентификаторы)

	Нужные = Новый Соответствие();
	Для Каждого Идентификатор Из ПакетИдентификаторы Цикл
		Нужные.Вставить(Цел(Идентификатор), Истина);
	КонецЦикла;

	Отобранные = Новый Массив();
	Для Каждого Агрегат Из Агрегаты Цикл
		Если Нужные.Получить(Агрегат.ПакетИдентификатор) <> Неопределено Тогда
			Отобранные.Добавить(Агрегат);
		КонецЕсли;
	КонецЦикла;

	Возврат Отобранные;

КонецФункции

Функция Отдать(Знач Строки)

	Если ОтказатьНаСледующем Тогда
		ОтказатьНаСледующем = Ложь;
		ВызватьИсключение "СчитающееХранилищеАгрегатов: заказанный разовый отказ базы";
	КонецЕсли;

	Возврат Счётчик.Отдать(Строки);

КонецФункции

Процедура ПриСозданииОбъекта()
	Агрегаты = Новый Массив();
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
	НомерПоколения = 0;
	ОтказатьНаСледующем = Ложь;
КонецПроцедуры
