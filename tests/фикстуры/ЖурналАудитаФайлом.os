// Чтение журнала аудита из файла в удобной для утверждений форме: «последние N» и
// «всё по объекту». Поверх ЧитательЖурналаАудита, то есть читает ровно то, что хаб записал.

Перем Читатель;

// Последние записи журнала, новые первыми.
//
// Параметры:
//  Лимит - Число - максимум записей (необязательный, по умолчанию 100).
//
// Возвращаемое значение:
//  Массив структур - Когда, Кто, Действие, Объект, Субъект, Детали, АдресIP.
//
Функция Последние(Знач Лимит = 100) Экспорт
	Возврат Читатель.Страница(Неопределено, 0, Лимит).Записи;
КонецФункции

// Записи по конкретному объекту, новые первыми.
//
// Параметры:
//  Объект - Строка - затронутый объект, например "пул/пакет@версия".
//
// Возвращаемое значение:
//  Массив структур - см. Последние.
//
Функция ПоОбъекту(Знач Объект) Экспорт

	Результат = Новый Массив();
	Для Каждого Запись Из Последние(1000) Цикл
		Если Запись.Объект = Объект Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ПриСозданииОбъекта(ЧитательЖурнала)
	Читатель = ЧитательЖурнала;
КонецПроцедуры
