// Заглушка репозитория &ХранилищеСущностей для агрегатов: играет бэкенд (с SQL, без SQL
// либо отказывающий), запоминает тексты запросов и считает обращения обоих видов.
// Тот же объект отвечает и за менеджер сущностей — пробу агрегаты делают на нём.

Перем Модель_;
Перем Записи_;
Перем Ответы_;                 // Массив из ТаблицаЗначений — что отдаёт очередной запрос
Перем ИсполняетSQL_;
Перем ПадаетНаЗапросе_;
Перем Тексты_;
Перем Выборок_;

#Область НастройкаДвойника

// Бэкенд исполняет SQL: ВычислитьСКоннектором отдаёт заготовленный ответ, а не падает.
//
// Параметры:
//  Значение - Булево - исполняет ли бэкенд SQL.
//
// Возвращаемое значение:
//  ЗапросыЗаглушка - этот же объект.
//
Функция ИсполняетSQL(Знач Значение = Истина) Экспорт
	ИсполняетSQL_ = Значение;
	Возврат ЭтотОбъект;
КонецФункции

// Бэкенд SQL исполняет, но конкретный запрос отвергает — так выглядит отказ базы,
// а не отсутствие SQL.
//
// Возвращаемое значение:
//  ЗапросыЗаглушка - этот же объект.
//
Функция ПадаетНаЗапросе() Экспорт
	ИсполняетSQL_ = Истина;
	ПадаетНаЗапросе_ = Истина;
	Возврат ЭтотОбъект;
КонецФункции

// Ответ, который бэкенд отдаст на очередной запрос.
//
// Параметры:
//  Таблица - ТаблицаЗначений - результат запроса.
//
// Возвращаемое значение:
//  ЗапросыЗаглушка - этот же объект.
//
Функция Ответ(Знач Таблица) Экспорт
	Ответы_.Добавить(Таблица);
	Возврат ЭтотОбъект;
КонецФункции

// Строки, которые отдаст выборка в памяти.
//
// Параметры:
//  Записи - Массив - записи сущности.
//
// Возвращаемое значение:
//  ЗапросыЗаглушка - этот же объект.
//
Функция Строки(Знач Записи) Экспорт
	Записи_ = Записи;
	Возврат ЭтотОбъект;
КонецФункции

#КонецОбласти

#Область ЧтоУвиделДвойник

// Тексты всех запросов, ушедших в коннектор, в порядке вызова.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Тексты() Экспорт
	Возврат Тексты_;
КонецФункции

// Сколько раз спрашивали коннектор.
//
// Возвращаемое значение:
//  Число.
//
Функция ЗапросовККоннектору() Экспорт
	Возврат Тексты_.Количество();
КонецФункции

// Сколько раз поднимали строки выборкой.
//
// Возвращаемое значение:
//  Число.
//
Функция Выборок() Экспорт
	Возврат Выборок_;
КонецФункции

#КонецОбласти

#Область КонтрактХранилищаИМенеджера

// Контракт entity: алгоритм на коннекторе источника. Двойник не разбирает лямбду —
// агрегаты хаба зовут её одним и тем же выражением, а текст запроса лежит в контексте.
//
// Параметры:
//  Алгоритм - Строка - лямбда-выражение с параметром-коннектором.
//  Контекст - Структура - значения алгоритма; текст запроса — в ключе «Текст».
//  Объект - Произвольный - контракту entity нужен третий параметр (необязательный).
//
// Возвращаемое значение:
//  ТаблицаЗначений - заготовленный ответ либо пустая таблица.
//
Функция ВычислитьСКоннектором(Знач Алгоритм, Знач Контекст = Неопределено, Объект = Неопределено) Экспорт

	Тексты_.Добавить(Контекст.Текст);

	Если НЕ ИсполняетSQL_ Тогда
		ВызватьИсключение "Метод объекта не обнаружен (ВыполнитьЗапрос)";
	КонецЕсли;

	Если ПадаетНаЗапросе_ Тогда
		ВызватьИсключение "42601: syntax error at or near ""FROM""";
	КонецЕсли;

	Если Ответы_.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений();
	КонецЕсли;

	Ответ = Ответы_[0];
	Ответы_.Удалить(0);

	Возврат Ответ;

КонецФункции

// Контракт entity: выборка строк по опциям поиска. Отбор двойник не применяет — он про счёт
// обращений, а не про семантику отбора.
//
// Параметры:
//  Опции - ОпцииПоиска, Неопределено - опции поиска.
//
// Возвращаемое значение:
//  Массив - заготовленные строки.
//
Функция Получить(Знач Опции = Неопределено) Экспорт
	Выборок_ = Выборок_ + 1;
	Возврат Записи_;
КонецФункции

// Контракт entity: модель сущности.
//
// Возвращаемое значение:
//  Произвольный - модель, переданная конструктором.
//
Функция ПолучитьОбъектМодели() Экспорт
	Возврат Модель_;
КонецФункции

// Контракт менеджера сущностей: источник данных. Двойник сам себе источник — агрегатам
// от источника нужен только тип коннектора для строки журнала.
//
// Возвращаемое значение:
//  ЗапросыЗаглушка - этот же объект.
//
Функция ИсточникДанных() Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// Контракт источника данных: тип коннектора.
//
// Возвращаемое значение:
//  Строка.
//
Функция ТипКоннектора() Экспорт
	Возврат "КоннекторДвойник";
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач Модель = Неопределено)

	Модель_ = Модель;
	Записи_ = Новый Массив();
	Ответы_ = Новый Массив();
	Тексты_ = Новый Массив();
	Выборок_ = 0;
	ИсполняетSQL_ = Ложь;
	ПадаетНаЗапросе_ = Ложь;

КонецПроцедуры
