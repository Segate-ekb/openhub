// Фикстура: атомарные инлайны в контейнере вертикального ритма. Контейнеры выводит из самого CSS
// (правила «X > * + *»), атомарность ребёнка — из его display и списка замещаемых тегов.

Перем ПустыеТеги;
Перем БлочныеТеги;
Перем ЗамещаемыеТеги;   // атомарны по природе: своего display в таблице стилей им не нужно
Перем Ритм;             // РитмФорм — разбор CSS общий с гейтом ритма форм

#Область ПрограммныйИнтерфейс

// Проверяет, что контейнер вертикального ритма не начинается с ДВУХ атомарно-инлайновых
// детей: первому «> * + *» маргина не даёт, второму даёт, и на общей строке этот маргин
// уходит в высоту строчного бокса — ряд опускается, контейнер растёт на пустое место.
//
// Ряд инлайнов ПОСЛЕ блока не нарушение: там маргин достаётся всем элементам строки
// поровну и работает как задумано — отбивает ряд от блока выше (замер: три inline-формы
// в теле подписки стоят на одной линии, у каждой margin-top 11.2px, смещения нет).
//
// Параметры:
//  HTML - Строка - разметка, напечатанная слоем представления.
//  ТекстCSS - Строка - содержимое таблицы стилей.
//
// Возвращаемое значение:
//  Массив из Строка - описания нарушений; пустой массив — таких контейнеров нет.
//
Функция Нарушения(Знач HTML, Знач ТекстCSS) Экспорт

	// имя локальной НЕ «Контейнеры»: переменная отобрала бы имя у функции модуля
	Основы = КонтейнерыРитма(ТекстCSS);
	Если Основы.Количество() = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;

	Результат = Новый Массив();
	Кэш = Новый Соответствие();   // селектор -> Булево, атомарность по CSS

	Для Каждого Контейнер Из Контейнеры(HTML, Основы) Цикл

		Если Контейнер.Дети.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;

		Первый = Контейнер.Дети[0];
		Второй = Контейнер.Дети[1];

		Если НЕ АтомарныйИнлайн(Первый, ТекстCSS, Кэш)
			ИЛИ НЕ АтомарныйИнлайн(Второй, ТекстCSS, Кэш) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(СтрШаблон(
			"<%1 class=""%2""> начинается с двух атомарно-инлайновых детей (%3 и %4):"
			+ " первому вертикальный ритм контейнера маргина не даёт, второму даёт, и на"
			+ " общей строке этот маргин уходит в высоту строчного бокса — ряд опускается,"
			+ " контейнер растёт. Ряд инлайнов печатается ОДНИМ ребёнком (компонент"
			+ " «Плашка», метод Ряд).",
			Контейнер.Тег, СтрСоединить(Контейнер.Классы, " "),
			Подпись(Первый), Подпись(Второй)));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Основы селекторов, которым CSS задаёт вертикальный ритм детей правилом «X > * + *».
//
// Параметры:
//  ТекстCSS - Строка - содержимое таблицы стилей.
//
// Возвращаемое значение:
//  Массив из Строка - «.card__body», «fieldset» и прочие основы как они записаны в CSS.
//
Функция КонтейнерыРитма(Знач ТекстCSS) Экспорт

	Результат = Новый Массив();

	Для Каждого Правило Из РазборCSS().ПравилаCSS(ТекстCSS) Цикл
		Для Каждого Селектор Из СтрРазделить(Правило.Селектор, ",", Ложь) Цикл

			Основа = ОсноваПравилаПотока(СокрЛП(Селектор));
			Если НЕ ЗначениеЗаполнено(Основа) Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ЗначениеОбъявления(Правило.Объявления, "margin-top")) Тогда
				Продолжить;
			КонецЕсли;
			Если Результат.Найти(Основа) = Неопределено Тогда
				Результат.Добавить(Основа);
			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Контейнеры ритма, найденные в разметке, вместе с их непосредственными детьми.
//
// Параметры:
//  HTML - Строка - разметка.
//  Основы - Массив из Строка - основы селекторов контейнеров ритма.
//
// Возвращаемое значение:
//  Массив из Структура (Тег, Классы, Дети) - Дети: Массив из Структура (Тег, Классы).
//
Функция Контейнеры(Знач HTML, Знач Основы) Экспорт

	Стек = Новый Массив();        // Структура (Тег, Индекс): Индекс = -1 у не-контейнера
	Найденные = Новый Массив();
	Позиция = 1;
	Длина = СтрДлина(HTML);

	Пока Позиция <= Длина Цикл

		Начало = СтрНайти(HTML, "<", НаправлениеПоиска.СНачала, Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;

		Следующий = Сред(HTML, Начало + 1, 1);

		Если Следующий = "!" Тогда
			Позиция = КонецКомментарияИлиДоктайпа(HTML, Начало);
			Продолжить;
		КонецЕсли;

		Если Следующий = "/" Тогда
			КонецТега = КонецОткрывающего(HTML, Начало);
			Закрыть(Стек, ИмяТега(Сред(HTML, Начало + 2, КонецТега - Начало - 2)));
			Позиция = КонецТега + 1;
			Продолжить;
		КонецЕсли;

		Если НЕ БукваТега(Следующий) Тогда
			Позиция = Начало + 1;
			Продолжить;
		КонецЕсли;

		КонецТега = КонецОткрывающего(HTML, Начало);
		Разметка = Сред(HTML, Начало + 1, КонецТега - Начало - 1);
		Тег = ИмяТега(Разметка);
		Классы = КлассыИзРазметки(Разметка);

		Пока Стек.Количество() > 0 И НеявноЗакрывается(Стек[Стек.ВГраница()].Тег, Тег) Цикл
			Стек.Удалить(Стек.ВГраница());
		КонецЦикла;

		// ребёнком элемент становится ДО того, как сам станет контейнером: void-теги
		// на стек не встают, но детьми быть не перестают. Скрытое поле — исключение:
		// коробки у него нет вовсе, и соседей по строке оно не создаёт
		Если Стек.Количество() > 0 И Стек[Стек.ВГраница()].Индекс >= 0
			И НЕ СкрытоеПоле(Тег, Разметка) Тогда
			Найденные[Стек[Стек.ВГраница()].Индекс].Дети.Добавить(
				Новый Структура("Тег, Классы", Тег, Классы));
		КонецЕсли;

		Если ПустойТег(Тег) ИЛИ СамозакрытыйТег(Разметка) Тогда
			Позиция = КонецТега + 1;
			Продолжить;
		КонецЕсли;

		Индекс = -1;
		Если ЭтоКонтейнерРитма(Тег, Классы, Основы) Тогда
			Найденные.Добавить(Новый Структура("Тег, Классы, Дети", Тег, Классы, Новый Массив()));
			Индекс = Найденные.Количество() - 1;
		КонецЕсли;
		Стек.Добавить(Новый Структура("Тег, Индекс", Тег, Индекс));

		Позиция = КонецТега + 1;

	КонецЦикла;

	Возврат Найденные;

КонецФункции

// Атомарен ли элемент как инлайн: замещаемый тег либо display: inline-block/-flex/-grid/-table.
//
// Параметры:
//  Элемент - Структура - Тег, Классы.
//  ТекстCSS - Строка - содержимое таблицы стилей.
//  Кэш - Соответствие - разобранные селекторы (необязательный).
//
// Возвращаемое значение:
//  Булево.
//
Функция АтомарныйИнлайн(Знач Элемент, Знач ТекстCSS, Кэш = Неопределено) Экспорт

	Если ЗамещаемыеТеги.Найти(Элемент.Тег) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если Кэш = Неопределено Тогда
		Кэш = Новый Соответствие();
	КонецЕсли;

	Кандидаты = Новый Массив();
	Для Каждого Класс Из Элемент.Классы Цикл
		Кандидаты.Добавить("." + Класс);
	КонецЦикла;
	Кандидаты.Добавить(Элемент.Тег);

	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кэш[Кандидат] = Неопределено Тогда
			Кэш.Вставить(Кандидат, АтомарныйПоCSS(ТекстCSS, Кандидат));
		КонецЕсли;
		Если Кэш[Кандидат] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область СлужебныйРазбор

Функция Подпись(Знач Элемент)
	Возврат "<" + Элемент.Тег
		+ ?(Элемент.Классы.Количество() > 0, " class=""" + СтрСоединить(Элемент.Классы, " ") + """", "")
		+ ">";
КонецФункции

// <input type="hidden"> — display: none по таблице браузера: коробки нет, в строку не встаёт.
Функция СкрытоеПоле(Знач Тег, Знач Разметка)

	Если Тег <> "input" Тогда
		Возврат Ложь;
	КонецЕсли;

	Низкий = СтрЗаменить(СтрЗаменить(НРег(Разметка), " ", ""), Символы.Таб, "");

	Возврат СтрНайти(Низкий, "type=""hidden""") > 0
		ИЛИ СтрНайти(Низкий, "type='hidden'") > 0
		ИЛИ СтрНайти(Низкий, "type=hidden") > 0;

КонецФункции

Функция ЭтоКонтейнерРитма(Знач Тег, Знач Классы, Знач Основы)

	Если Основы.Найти(Тег) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Класс Из Классы Цикл
		Если Основы.Найти("." + Класс) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// «X > * + *» и его синонимы; возвращает X либо "" для любого другого селектора.
Функция ОсноваПравилаПотока(Знач Селектор)

	Хвосты = Новый Массив();
	Хвосты.Добавить(">*+*");
	Хвосты.Добавить(">*~*");
	Хвосты.Добавить(">:not(:first-child)");
	Хвосты.Добавить(">*:not(:first-child)");

	Сжатый = СтрЗаменить(СтрЗаменить(Селектор, " ", ""), Символы.Таб, "");

	Для Каждого Хвост Из Хвосты Цикл
		Если Прав(Сжатый, СтрДлина(Хвост)) = Хвост Тогда
			Возврат Лев(Сжатый, СтрДлина(Сжатый) - СтрДлина(Хвост));
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция АтомарныйПоCSS(Знач ТекстCSS, Знач Основа)

	Последнее = "";

	Для Каждого Правило Из РазборCSS().ПравилаCSS(ТекстCSS) Цикл
		Для Каждого Селектор Из СтрРазделить(Правило.Селектор, ",", Ложь) Цикл
			Если СокрЛП(Селектор) <> Основа Тогда
				Продолжить;
			КонецЕсли;
			Значение = НРег(ЗначениеОбъявления(Правило.Объявления, "display"));
			Если ЗначениеЗаполнено(Значение) Тогда
				Последнее = Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Лев(Последнее, 7) = "inline-";

КонецФункции

Функция ЗначениеОбъявления(Знач Объявления, Знач Свойство)

	Результат = "";

	Для Каждого Кусок Из СтрРазделить(Объявления, ";", Ложь) Цикл
		Разделитель = СтрНайти(Кусок, ":");
		Если Разделитель = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если НРег(СокрЛП(Лев(Кусок, Разделитель - 1))) <> Свойство Тогда
			Продолжить;
		КонецЕсли;
		Результат = СокрЛП(Сред(Кусок, Разделитель + 1));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция РазборCSS()
	Если Ритм = Неопределено Тогда
		Ритм = Новый РитмФорм();
	КонецЕсли;
	Возврат Ритм;
КонецФункции

Функция КонецОткрывающего(Знач HTML, Знач Начало)

	Позиция = Начало + 1;
	Длина = СтрДлина(HTML);
	Кавычка = "";

	Закрытие = СтрНайти(HTML, ">", НаправлениеПоиска.СНачала, Позиция);
	Если Закрытие = 0 Тогда
		Возврат Длина + 1;
	КонецЕсли;
	Апостроф = СтрНайти(HTML, "'", НаправлениеПоиска.СНачала, Позиция);
	Двойная = СтрНайти(HTML, """", НаправлениеПоиска.СНачала, Позиция);
	Если (Апостроф = 0 ИЛИ Апостроф > Закрытие) И (Двойная = 0 ИЛИ Двойная > Закрытие) Тогда
		Возврат Закрытие;
	КонецЕсли;

	Пока Позиция <= Длина Цикл
		Символ = Сред(HTML, Позиция, 1);
		Если ЗначениеЗаполнено(Кавычка) Тогда
			Если Символ = Кавычка Тогда
				Кавычка = "";
			КонецЕсли;
		ИначеЕсли Символ = """" ИЛИ Символ = "'" Тогда
			Кавычка = Символ;
		ИначеЕсли Символ = ">" Тогда
			Возврат Позиция;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Длина + 1;

КонецФункции

Функция КонецКомментарияИлиДоктайпа(Знач HTML, Знач Начало)

	Если Сред(HTML, Начало, 4) = "<!--" Тогда
		Конец = СтрНайти(HTML, "-->", НаправлениеПоиска.СНачала, Начало + 4);
		Возврат ?(Конец = 0, СтрДлина(HTML) + 1, Конец + 3);
	КонецЕсли;

	Конец = СтрНайти(HTML, ">", НаправлениеПоиска.СНачала, Начало);
	Возврат ?(Конец = 0, СтрДлина(HTML) + 1, Конец + 1);

КонецФункции

Функция ИмяТега(Знач Разметка)

	Имя = "";
	Для Индекс = 1 По СтрДлина(Разметка) Цикл
		Символ = Сред(Разметка, Индекс, 1);
		Если БукваТега(Символ) ИЛИ (ЗначениеЗаполнено(Имя) И СтрНайти("0123456789-", Символ) > 0) Тогда
			Имя = Имя + Символ;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат НРег(СокрЛП(Имя));

КонецФункции

Функция БукваТега(Знач Символ)
	Возврат СтрНайти("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", Символ) > 0;
КонецФункции

Функция КлассыИзРазметки(Знач Разметка)

	Результат = Новый Массив();
	Позиция = ПозицияАтрибутаКласса(Разметка);
	Если Позиция = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Хвост = СокрЛ(Сред(Разметка, Позиция + 6));
	Кавычка = Лев(Хвост, 1);
	Если Кавычка = """" ИЛИ Кавычка = "'" Тогда
		Хвост = Сред(Хвост, 2);
		Конец = СтрНайти(Хвост, Кавычка);
	Иначе
		Конец = СтрНайти(Хвост, " ");
	КонецЕсли;

	Значение = ?(Конец = 0, Хвост, Лев(Хвост, Конец - 1));

	Для Каждого Класс Из СтрРазделить(СтрЗаменить(Значение, Символы.ПС, " "), " ", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Класс)) Тогда
			Результат.Добавить(СокрЛП(Класс));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПозицияАтрибутаКласса(Знач Разметка)

	Низкий = НРег(Разметка);
	Отступ = 1;

	Пока Истина Цикл

		Позиция = СтрНайти(Низкий, "class=", НаправлениеПоиска.СНачала, Отступ);
		Если Позиция = 0 Тогда
			Возврат 0;
		КонецЕсли;

		Если Позиция > 1 И Пробельный(Сред(Низкий, Позиция - 1, 1)) Тогда
			Возврат Позиция;
		КонецЕсли;

		Отступ = Позиция + 6;

	КонецЦикла;

КонецФункции

Функция Пробельный(Знач Символ)
	Возврат Символ = " " ИЛИ Символ = Символы.Таб ИЛИ Символ = Символы.ПС ИЛИ Символ = Символы.ВК;
КонецФункции

Функция НеявноЗакрывается(Знач Открытый, Знач Новый_)

	Если Открытый = "p" Тогда
		Возврат БлочныйТег(Новый_);
	ИначеЕсли Открытый = "li" Тогда
		Возврат Новый_ = "li";
	ИначеЕсли Открытый = "option" Тогда
		Возврат Новый_ = "option" ИЛИ Новый_ = "optgroup";
	ИначеЕсли Открытый = "dt" ИЛИ Открытый = "dd" Тогда
		Возврат Новый_ = "dt" ИЛИ Новый_ = "dd";
	ИначеЕсли Открытый = "tr" Тогда
		Возврат Новый_ = "tr";
	ИначеЕсли Открытый = "td" ИЛИ Открытый = "th" Тогда
		Возврат Новый_ = "td" ИЛИ Новый_ = "th" ИЛИ Новый_ = "tr";
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция БлочныйТег(Знач Тег)
	Возврат БлочныеТеги.Найти(Тег) <> Неопределено;
КонецФункции

Функция ПустойТег(Знач Тег)
	Возврат ПустыеТеги.Найти(Тег) <> Неопределено;
КонецФункции

Функция СамозакрытыйТег(Знач Разметка)
	Возврат Прав(СокрП(Разметка), 1) = "/";
КонецФункции

Процедура Закрыть(Стек, Знач Тег)

	Для Индекс = -Стек.ВГраница() По 0 Цикл
		Если Стек[-Индекс].Тег = Тег Тогда
			Пока Стек.Количество() > -Индекс Цикл
				Стек.Удалить(Стек.ВГраница());
			КонецЦикла;
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

ПустыеТеги = Новый Массив();
Для Каждого ИмяПустого Из СтрРазделить("area,base,br,col,embed,hr,img,input,link,meta,param,"
	+ "source,track,wbr,path,circle,rect,line,polyline,polygon,use", ",", Ложь) Цикл
	ПустыеТеги.Добавить(ИмяПустого);
КонецЦикла;

БлочныеТеги = Новый Массив();
Для Каждого ИмяБлочного Из СтрРазделить("address,article,aside,blockquote,details,div,dl,"
	+ "fieldset,figcaption,figure,footer,form,h1,h2,h3,h4,h5,h6,header,hgroup,hr,main,menu,"
	+ "nav,ol,p,pre,section,table,ul", ",", Ложь) Цикл
	БлочныеТеги.Добавить(ИмяБлочного);
КонецЦикла;

// Замещаемые и формоподобные: атомарны по умолчанию браузера, своего display в CSS проекта им не нужно.
ЗамещаемыеТеги = Новый Массив();
Для Каждого ИмяЗамещаемого Из СтрРазделить("svg,img,canvas,video,audio,iframe,object,embed,"
	+ "input,select,textarea,button", ",", Ложь) Цикл
	ЗамещаемыеТеги.Добавить(ИмяЗамещаемого);
КонецЦикла;
