// Фикстура: хранилище геоправил, которое ПИШЕТ посреди чужого чтения. Гонка «читатель
// начал до записи, а опубликовал снимок после неё» так проверяется детерминированно —
// без настоящих потоков, порядок задаёт сама фикстура.
//
// Строки материализуются ДО вмешательства: читатель уносит уже устаревший список, ровно
// как в гонке. Вмешательство срабатывает один раз, иначе снятие правила зациклилось бы
// на собственном чтении.

Перем Строки;         // Соответствие: ключ -> Строка кодов через запятую
Перем Чтений;
Перем Владелец;       // ГеоправилоПровайдера, который вмешается в чужое чтение
Перем Жертва;         // Строка — имя провайдера, чьё правило снимет вмешательство
Перем Вмешались;
Перем Падать;         // Булево — читать не получается вовсе

// Контракт ХранилищаГеоправил: все правила.
//
// Возвращаемое значение:
//  Массив из Структура - Ключ, Страны.
//
Функция Все() Экспорт

	Чтений = Чтений + 1;

	Если Падать Тогда
		ВызватьИсключение "таблица геоправил недоступна";
	КонецЕсли;

	Результат = Новый Массив();
	Для Каждого КиЗ Из Строки Цикл
		Результат.Добавить(Новый Структура("Ключ, Страны", КиЗ.Ключ, КиЗ.Значение));
	КонецЦикла;

	Если Владелец <> Неопределено И НЕ Вмешались Тогда
		Вмешались = Истина;
		Владелец.Снять(Неопределено, Жертва);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Контракт ХранилищаГеоправил: записать страны правила.
//
// Параметры:
//  Ключ - Строка.
//  Страны - Строка - каноничный список кодов через запятую.
//  Кто - Строка - логин автора изменения.
//  Когда - Дата - момент (UTC).
//
Процедура Установить(Знач Ключ, Знач Страны, Знач Кто, Знач Когда) Экспорт
	Строки.Вставить(НРег(СокрЛП(Строка(Ключ))), Страны);
КонецПроцедуры

// Контракт ХранилищаГеоправил: снять правило.
//
// Параметры:
//  Ключ - Строка.
//
Процедура Удалить(Знач Ключ) Экспорт
	Строки.Удалить(НРег(СокрЛП(Строка(Ключ))));
КонецПроцедуры

// Назначает вмешательство: на первом же чтении правило названного провайдера снимается
// ЧЕРЕЗ его владельца — значит, версия правил сдвигается ровно так, как при чужой записи.
//
// Параметры:
//  Правило - ГеоправилоПровайдера - владелец правил, которым идёт запись.
//  ИмяПровайдера - Строка - чьё правило снимет вмешательство.
//
Процедура СниматьПриПервомЧтении(Знач Правило, Знач ИмяПровайдера) Экспорт
	Владелец = Правило;
	Жертва = ИмяПровайдера;
	Вмешались = Ложь;
КонецПроцедуры

// Переводит хранилище в неисправное: любое чтение бросает исключение.
Процедура Сломаться() Экспорт
	Падать = Истина;
КонецПроцедуры

// Сколько раз читали таблицу — так видно, ходил ли владелец в базу повторно.
//
// Возвращаемое значение:
//  Число.
//
Функция Чтений() Экспорт
	Возврат Чтений;
КонецФункции

Процедура ПриСозданииОбъекта()
	Строки = Новый Соответствие();
	Чтений = 0;
	Вмешались = Истина;
	Падать = Ложь;
КонецПроцедуры
