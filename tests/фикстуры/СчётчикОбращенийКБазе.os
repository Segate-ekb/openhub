// Наблюдатель источника данных entity, считающий обращения к СУБД и поднятые сущности.
// Им проверяется цена агрегата: один запрос и ноль поднятых строк вместо выборки таблицы.

#Использовать entity

Перем Запросов_;
Перем ПоднятоСущностей_;
Перем Тексты_;

// Контракт наблюдателя entity: фаза до выполнения. Считать до выполнения нечего —
// длительность, ошибка и число строк заполняются к фазе после.
//
// Параметры:
//  Событие - СобытиеИсточникаДанных - событие источника.
//
Процедура ПередСобытием(Знач Событие) Экспорт
КонецПроцедуры

// Контракт наблюдателя entity: фаза после выполнения.
//
// Параметры:
//  Событие - СобытиеИсточникаДанных - событие источника.
//
Процедура ПослеСобытия(Знач Событие) Экспорт

	Если Событие.Вид() = ВидыСобытийИсточникаДанных.Запрос() И Событие.Операция() = "SELECT" Тогда
		Запросов_ = Запросов_ + 1;
		Тексты_.Добавить(Строка(Событие.ТекстЗапроса()));
	КонецЕсли;

	Если Событие.Вид() = ВидыСобытийИсточникаДанных.Операция()
		И Событие.КоличествоСтрок() <> Неопределено Тогда
		ПоднятоСущностей_ = ПоднятоСущностей_ + Событие.КоличествоСтрок();
	КонецЕсли;

КонецПроцедуры

// Сколько выборок ушло в СУБД.
//
// Возвращаемое значение:
//  Число.
//
Функция Запросов() Экспорт
	Возврат Запросов_;
КонецФункции

// Сколько строк сущностей подняли операции менеджера и хранилищ.
//
// Возвращаемое значение:
//  Число.
//
Функция ПоднятоСущностей() Экспорт
	Возврат ПоднятоСущностей_;
КонецФункции

// Тексты выборок в порядке выполнения.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Тексты() Экспорт
	Возврат Тексты_;
КонецФункции

// Обнуляет счётчики: замер ставится вокруг одного вызова, а не вокруг всего теста.
//
// Возвращаемое значение:
//  СчётчикОбращенийКБазе - этот же объект.
//
Функция Сбросить() Экспорт

	Запросов_ = 0;
	ПоднятоСущностей_ = 0;
	Тексты_ = Новый Массив();

	Возврат ЭтотОбъект;

КонецФункции

&Реализует("НаблюдательИсточникаДанных")
Процедура ПриСозданииОбъекта()
	Сбросить();
КонецПроцедуры
