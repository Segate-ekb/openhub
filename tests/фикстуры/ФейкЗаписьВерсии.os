// Фейковая запись версии: поля, которых касается СервисВерсий.ОтозватьВерсию, и Сохранить().

Перем ПакетИдентификатор Экспорт;
Перем Версия Экспорт;
Перем Отозвана Экспорт;
Перем Опубликована Экспорт;
Перем Изменена Экспорт;
Перем Размер Экспорт;
Перем СохраненийБыло Экспорт;

// Считает сохранение записи (контракт autumn-data).
//
Процедура Сохранить() Экспорт
	СохраненийБыло = СохраненийБыло + 1;
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач _ПакетИдентификатор, Знач _Версия)
	ПакетИдентификатор = Цел(_ПакетИдентификатор);
	Версия = СокрЛП(Строка(_Версия));
	Отозвана = Ложь;
	// опубликованная версия всегда несёт момент публикации: по нему считается отметка пакета
	Опубликована = ТекущаяУниверсальнаяДата();
	Изменена = '00010101000000';
	Размер = 0;
	СохраненийБыло = 0;
КонецПроцедуры
