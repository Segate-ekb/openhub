// Заглушка дома настроек: один раздел, предсказуемые адреса.

// Ключ дома.
//
// Возвращаемое значение:
//  Строка.
//
Функция Ключ() Экспорт
	Возврат "hub";
КонецФункции

// Заголовок дома.
//
// Возвращаемое значение:
//  Строка.
//
Функция Заголовок() Экспорт
	Возврат "Настройки хаба";
КонецФункции

// Пояснение дома.
//
// Возвращаемое значение:
//  Строка.
//
Функция Пояснение() Экспорт
	Возврат "";
КонецФункции

// Есть ли раздел с таким ключом.
//
// Параметры:
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьРаздел(Знач Ключ) Экспорт
	Возврат ЗначениеЗаполнено(Ключ);
КонецФункции

// Адрес раздела.
//
// Параметры:
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Строка.
//
Функция АдресРаздела(Знач Ключ) Экспорт
	Возврат "/hub/settings/" + Строка(Ключ);
КонецФункции

// Подпись раздела.
//
// Параметры:
//  Ключ - Строка - ключ раздела.
//
// Возвращаемое значение:
//  Строка.
//
Функция ПодписьРаздела(Знач Ключ) Экспорт
	Возврат Строка(Ключ);
КонецФункции

// Раздел-хозяин вложенного блока: у заглушки вложенных блоков нет.
//
// Параметры:
//  Ключ - Строка - ключ блока.
//
// Возвращаемое значение:
//  Строка.
//
Функция Хозяин(Знач Ключ) Экспорт
	Ключ = Ключ;
	Возврат "";
КонецФункции

// Разделы дома для дерева навигации.
//
// Параметры:
//  Активный - Строка - активный раздел.
//
// Возвращаемое значение:
//  Массив.
//
Функция Разделы(Знач Активный) Экспорт
	Активный = Активный;
	Возврат Новый Массив();
КонецФункции
