// Фикстура пакета для тестов web-ui: собирает валидный .ospx (opm-metadata.xml + content.zip
// с README.md) для сквозной проверки пути README — артефакт, извлечение, рендер, санитизация.

#Использовать ospx-tools

// README с набором XSS-векторов — для проверки, что санитизация их вырезает.
//
// Возвращаемое значение:
//  Строка - Markdown с легитимным содержимым и вредоносными вставками.
//
Функция ВредоносныйREADME() Экспорт
	Возврат "# Демо-пакет winow" + Символы.ПС + Символы.ПС
		+ "Веб-фреймворк для OneScript." + Символы.ПС + Символы.ПС
		+ "[перейти](javascript:alert('XSS-LINK'))" + Символы.ПС + Символы.ПС
		+ "![картинка](javascript:alert('XSS-IMG'))" + Символы.ПС + Символы.ПС
		+ "<script>alert('XSS-SCRIPT')</script>" + Символы.ПС + Символы.ПС
		+ "<div onclick=""evil()"">клик</div>" + Символы.ПС + Символы.ПС
		+ "Итоговый абзац.";
КонецФункции

// README в стиле GitHub: таблица, список задач, зачёркивание и голый адрес,
// а во вредной строке таблицы — XSS-вектор.
//
// Возвращаемое значение:
//  Строка - Markdown с GFM-разметкой и вредоносной ячейкой.
//
Функция READMEвСтилеGitHub() Экспорт
	Возврат "# Демо-пакет winow" + Символы.ПС + Символы.ПС
		+ "| Команда | Назначение |" + Символы.ПС
		+ "| --- | ---: |" + Символы.ПС
		+ "| install | установка |" + Символы.ПС
		+ "| <script>alert('XSS-CELL')</script> | зло |" + Символы.ПС + Символы.ПС
		+ "- [x] выпущено" + Символы.ПС
		+ "- [ ] в работе" + Символы.ПС + Символы.ПС
		+ "~~устарело~~" + Символы.ПС + Символы.ПС
		+ "https://hub.oscript.io/package/winow" + Символы.ПС;
КонецФункции

// Собирает валидный .ospx: opm-metadata.xml и, при наличии README, content.zip. Манифест
// называет адрес репозитория — без него хаб не примет первую версию имени.
//
// Параметры:
//  Каталог - Строка - каталог для .ospx и промежуточных файлов.
//  ИмяПакета - Строка - имя пакета для манифеста и имени файла.
//  Версия - Строка - версия пакета.
//  ТекстReadme - Строка, Неопределено - текст README; Неопределено — пакет без README.
//
// Возвращаемое значение:
//  Строка - путь к собранному .ospx.
//
Функция ПостроитьOspx(Знач Каталог, Знач ИмяПакета, Знач Версия, Знач ТекстReadme) Экспорт
	Возврат ПостроитьOspxПоМанифесту(Каталог, МанифестСРепозиторием(ИмяПакета, Версия), ТекстReadme);
КонецФункции

// Манифест с адресом репозитория, без которого хаб не принимает первую версию имени.
// Остальное — описание, зависимости — вызывающий дописывает цепочкой.
//
// Параметры:
//  ИмяПакета - Строка - имя пакета.
//  Версия - Строка - версия пакета.
//
// Возвращаемое значение:
//  МанифестПакета - манифест с адресом репозитория.
//
Функция МанифестСРепозиторием(Знач ИмяПакета, Знач Версия) Экспорт
	Возврат ПакетыOspx.НовыйМанифест(ИмяПакета, Версия)
		.УстановитьАдресРепозитория(АдресРепозиторияПоУмолчанию(ИмяПакета));
КонецФункции

// Адрес репозитория, который фикстура пишет в манифест.
//
// Параметры:
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Строка - веб-адрес репозитория.
//
Функция АдресРепозиторияПоУмолчанию(Знач ИмяПакета) Экспорт
	Возврат "https://example.org/openhub-tests/" + НРег(СокрЛП(ИмяПакета));
КонецФункции

// Собранный .ospx двоичными данными — то, что уходит в тело запроса публикации.
// Пакет складывается в свой подкаталог сборки: одно и то же имя публикуется в тесте
// не один раз, и общий каталог давал бы столкновение файлов.
//
// Параметры:
//  КаталогСборки - Строка - каталог, внутри которого заводится подкаталог пакета.
//  ИмяПакета - Строка - имя пакета для манифеста.
//  Версия - Строка - версия пакета.
//  ТекстReadme - Строка, Неопределено - текст README; Неопределено — заголовок из имени.
//
// Возвращаемое значение:
//  ДвоичныеДанные - содержимое собранного .ospx.
//
Функция ДанныеOspx(Знач КаталогСборки, Знач ИмяПакета, Знач Версия, Знач ТекстReadme = Неопределено) Экспорт

	КаталогПакета = ОбъединитьПути(КаталогСборки, Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КаталогПакета);

	Readme = ?(ТекстReadme = Неопределено, "# " + ИмяПакета, ТекстReadme);

	Возврат Новый ДвоичныеДанные(ПостроитьOspx(КаталогПакета, ИмяПакета, Версия, Readme));

КонецФункции

// Собранный по ГОТОВОМУ манифесту .ospx двоичными данными — в своём подкаталоге сборки,
// как у ДанныеOspx.
//
// Параметры:
//  КаталогСборки - Строка - каталог, внутри которого заводится подкаталог пакета.
//  Манифест - МанифестПакета - манифест пакета.
//  ТекстReadme - Строка, Неопределено - текст README; Неопределено — заголовок из имени.
//
// Возвращаемое значение:
//  ДвоичныеДанные - содержимое собранного .ospx.
//
Функция ДанныеOspxПоМанифесту(Знач КаталогСборки, Знач Манифест, Знач ТекстReadme = Неопределено) Экспорт

	КаталогПакета = ОбъединитьПути(КаталогСборки, Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КаталогПакета);

	Readme = ?(ТекстReadme = Неопределено, "# " + Манифест.Имя(), ТекстReadme);

	Возврат Новый ДвоичныеДанные(ПостроитьOspxПоМанифесту(КаталогПакета, Манифест, Readme));

КонецФункции

// Собирает .ospx с ГОТОВЫМ манифестом: описание, адрес репозитория и зависимости задаёт
// вызывающий. Имя файла — по имени и версии из манифеста.
//
// Параметры:
//  Каталог - Строка - каталог для .ospx и промежуточных файлов.
//  Манифест - МанифестПакета - манифест пакета.
//  ТекстReadme - Строка, Неопределено - текст README; Неопределено — пакет без README
//                (content.zip у такого пакета есть, README.md в нём нет).
//
// Возвращаемое значение:
//  Строка - путь к собранному .ospx.
//
Функция ПостроитьOspxПоМанифесту(Знач Каталог, Знач Манифест, Знач ТекстReadme) Экспорт

	ИмяПакета = Манифест.Имя();
	Версия = Манифест.Версия();

	ПутьМан = ОбъединитьПути(Каталог, "opm-metadata.xml");
	ПакетыOspx.ЗаписатьМанифестВФайл(Манифест, ПутьМан);

	ПутьOspx = ОбъединитьПути(Каталог, СтрШаблон("%1-%2.ospx", ИмяПакета, Версия));
	ЗаписьO = Новый ЗаписьZipФайла(ПутьOspx);
	ЗаписьO.Добавить(ПутьМан, РежимСохраненияПутейZIP.НеСохранятьПути);
	ЗаписьO.Добавить(СобратьСодержимое(Каталог, ТекстReadme), РежимСохраненияПутейZIP.НеСохранятьПути);
	ЗаписьO.Записать();

	Возврат ПутьOspx;

КонецФункции

// Собирает тяжёлый валидный .ospx: к README в содержимое ложится файл несжимаемых байт
// заданного размера, так что и .ospx весит не меньше.
//
// Параметры:
//  Каталог - Строка - каталог для .ospx и промежуточных файлов.
//  ИмяПакета - Строка - имя пакета для манифеста и имени файла.
//  Версия - Строка - версия пакета.
//  РазмерНагрузки - Число - размер файла нагрузки, байты.
//
// Возвращаемое значение:
//  Строка - путь к собранному .ospx.
//
Функция ПостроитьТяжёлыйOspx(Знач Каталог, Знач ИмяПакета, Знач Версия, Знач РазмерНагрузки) Экспорт

	ПутьМан = ОбъединитьПути(Каталог, "opm-metadata.xml");
	ПакетыOspx.ЗаписатьМанифестВФайл(МанифестСРепозиторием(ИмяПакета, Версия), ПутьМан);

	ПутьReadme = ОбъединитьПути(Каталог, "README.md");
	Запись = Новый ЗаписьТекста(ПутьReadme, КодировкаТекста.UTF8);
	Запись.Записать("# " + ИмяПакета);
	Запись.Закрыть();

	ПутьContent = ОбъединитьПути(Каталог, "content.zip");
	ЗаписьC = Новый ЗаписьZipФайла(ПутьContent);
	ЗаписьC.Добавить(ПутьReadme, РежимСохраненияПутейZIP.НеСохранятьПути);
	ЗаписьC.Добавить(ФайлНесжимаемыхБайт(Каталог, РазмерНагрузки), РежимСохраненияПутейZIP.НеСохранятьПути);
	ЗаписьC.Записать();

	ПутьOspx = ОбъединитьПути(Каталог, СтрШаблон("%1-%2.ospx", ИмяПакета, Версия));
	ЗаписьO = Новый ЗаписьZipФайла(ПутьOspx);
	ЗаписьO.Добавить(ПутьМан, РежимСохраненияПутейZIP.НеСохранятьПути);
	ЗаписьO.Добавить(ПутьContent, РежимСохраненияПутейZIP.НеСохранятьПути);
	ЗаписьO.Записать();

	Возврат ПутьOspx;

КонецФункции

// Мегабайт случайных байт, повторённый до размера: окно deflate — 32 КБ, повтор через
// мегабайт сжатию не поддаётся, а случайное число на каждый байт шло бы минутами.
Функция ФайлНесжимаемыхБайт(Знач Каталог, Знач Размер)

	Блок = 1048576;
	Генератор = Новый ГенераторСлучайныхЧисел(20260930);
	Буфер = Новый БуферДвоичныхДанных(Блок);
	Для Индекс = 0 По Блок - 1 Цикл
		Буфер.Установить(Индекс, Генератор.СлучайноеЧисло(0, 255));
	КонецЦикла;

	Путь = ОбъединитьПути(Каталог, "payload.bin");
	Файл = Новый ФайловыйПоток(Путь, РежимОткрытияФайла.Создать, ДоступКФайлу.Запись);
	Осталось = Размер;
	Пока Осталось > 0 Цикл
		Порция = Мин(Блок, Осталось);
		Файл.Записать(Буфер, 0, Порция);
		Осталось = Осталось - Порция;
	КонецЦикла;
	Файл.Закрыть();

	Возврат Путь;

КонецФункции

// content.zip есть у любого валидного .ospx: пакет без README — это пакет, в содержимом
// которого нет README.md, а не пакет без содержимого.
Функция СобратьСодержимое(Знач Каталог, Знач ТекстReadme)

	Если ТекстReadme = Неопределено Тогда
		ПутьФайла = ОбъединитьПути(Каталог, "lib.config");
		Содержимое = "<package-def />";
	Иначе
		ПутьФайла = ОбъединитьПути(Каталог, "README.md");
		Содержимое = ТекстReadme;
	КонецЕсли;

	Запись = Новый ЗаписьТекста(ПутьФайла, КодировкаТекста.UTF8);
	Запись.Записать(Содержимое);
	Запись.Закрыть();

	ПутьContent = ОбъединитьПути(Каталог, "content.zip");
	ЗаписьC = Новый ЗаписьZipФайла(ПутьContent);
	ЗаписьC.Добавить(ПутьФайла, РежимСохраненияПутейZIP.НеСохранятьПути);
	ЗаписьC.Записать();

	Возврат ПутьContent;

КонецФункции
