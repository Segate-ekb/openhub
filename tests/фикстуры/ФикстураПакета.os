// Фикстура пакета для тестов web-ui: собирает валидный .ospx (opm-metadata.xml + content.zip
// с README.md) для сквозной проверки пути README — артефакт, извлечение, рендер, санитизация.

#Использовать ospx-tools

// README с набором XSS-векторов — для проверки, что санитизация их вырезает.
//
// Возвращаемое значение:
//  Строка - Markdown с легитимным содержимым и вредоносными вставками.
//
Функция ВредоносныйREADME() Экспорт
	Возврат "# Демо-пакет winow" + Символы.ПС + Символы.ПС
		+ "Веб-фреймворк для OneScript." + Символы.ПС + Символы.ПС
		+ "[перейти](javascript:alert('XSS-LINK'))" + Символы.ПС + Символы.ПС
		+ "![картинка](javascript:alert('XSS-IMG'))" + Символы.ПС + Символы.ПС
		+ "<script>alert('XSS-SCRIPT')</script>" + Символы.ПС + Символы.ПС
		+ "<div onclick=""evil()"">клик</div>" + Символы.ПС + Символы.ПС
		+ "Итоговый абзац.";
КонецФункции

// README в стиле GitHub: таблица, список задач, зачёркивание и голый адрес,
// а во вредной строке таблицы — XSS-вектор.
//
// Возвращаемое значение:
//  Строка - Markdown с GFM-разметкой и вредоносной ячейкой.
//
Функция READMEвСтилеGitHub() Экспорт
	Возврат "# Демо-пакет winow" + Символы.ПС + Символы.ПС
		+ "| Команда | Назначение |" + Символы.ПС
		+ "| --- | ---: |" + Символы.ПС
		+ "| install | установка |" + Символы.ПС
		+ "| <script>alert('XSS-CELL')</script> | зло |" + Символы.ПС + Символы.ПС
		+ "- [x] выпущено" + Символы.ПС
		+ "- [ ] в работе" + Символы.ПС + Символы.ПС
		+ "~~устарело~~" + Символы.ПС + Символы.ПС
		+ "https://hub.oscript.io/package/winow" + Символы.ПС;
КонецФункции

// Собирает валидный .ospx: opm-metadata.xml и, при наличии README, content.zip.
//
// Параметры:
//  Каталог - Строка - каталог для .ospx и промежуточных файлов.
//  ИмяПакета - Строка - имя пакета для манифеста и имени файла.
//  Версия - Строка - версия пакета.
//  ТекстReadme - Строка, Неопределено - текст README; Неопределено — пакет без README.
//
// Возвращаемое значение:
//  Строка - путь к собранному .ospx.
//
Функция ПостроитьOspx(Знач Каталог, Знач ИмяПакета, Знач Версия, Знач ТекстReadme) Экспорт
	Возврат ПостроитьOspxПоМанифесту(Каталог, ПакетыOspx.НовыйМанифест(ИмяПакета, Версия), ТекстReadme);
КонецФункции

// Собирает .ospx с ГОТОВЫМ манифестом: описание, адрес репозитория и зависимости задаёт
// вызывающий. Имя файла — по имени и версии из манифеста.
//
// Параметры:
//  Каталог - Строка - каталог для .ospx и промежуточных файлов.
//  Манифест - МанифестПакета - манифест пакета.
//  ТекстReadme - Строка, Неопределено - текст README; Неопределено — пакет без README.
//
// Возвращаемое значение:
//  Строка - путь к собранному .ospx.
//
Функция ПостроитьOspxПоМанифесту(Знач Каталог, Знач Манифест, Знач ТекстReadme) Экспорт

	ИмяПакета = Манифест.Имя();
	Версия = Манифест.Версия();

	ПутьМан = ОбъединитьПути(Каталог, "opm-metadata.xml");
	ПакетыOspx.ЗаписатьМанифестВФайл(Манифест, ПутьМан);

	ПутьOspx = ОбъединитьПути(Каталог, СтрШаблон("%1-%2.ospx", ИмяПакета, Версия));
	ЗаписьO = Новый ЗаписьZipФайла(ПутьOspx);
	ЗаписьO.Добавить(ПутьМан, РежимСохраненияПутейZIP.НеСохранятьПути);

	Если ТекстReadme <> Неопределено Тогда
		ПутьReadme = ОбъединитьПути(Каталог, "README.md");
		Запись = Новый ЗаписьТекста(ПутьReadme, КодировкаТекста.UTF8);
		Запись.Записать(ТекстReadme);
		Запись.Закрыть();

		ПутьContent = ОбъединитьПути(Каталог, "content.zip");
		ЗаписьC = Новый ЗаписьZipФайла(ПутьContent);
		ЗаписьC.Добавить(ПутьReadme, РежимСохраненияПутейZIP.НеСохранятьПути);
		ЗаписьC.Записать();

		ЗаписьO.Добавить(ПутьContent, РежимСохраненияПутейZIP.НеСохранятьПути);
	КонецЕсли;

	ЗаписьO.Записать();
	Возврат ПутьOspx;

КонецФункции
