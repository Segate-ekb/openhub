// Заглушка сущности «Пул» для тестов, которым не нужен контейнер с БД.
// АпстримыДопустимы намеренно повторяет правило сущности.

Перем Идентификатор Экспорт;
Перем Имя Экспорт;
Перем Тип Экспорт;
Перем Видимость Экспорт;
Перем КвотаМб Экспорт;
Перем ПубликацияРазрешена Экспорт;

// Допустимы ли внешние источники для пула этого типа.
//
// Возвращаемое значение:
//  Булево - Ложь для личного пространства (тип user).
//
Функция АпстримыДопустимы() Экспорт
	Возврат НРег(СокрЛП(Строка(Тип))) <> "user";
КонецФункции

// Дефолтный ли это пул хаба.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоДефолтный() Экспорт
	Возврат НРег(СокрЛП(Строка(Тип))) = "default";
КонецФункции

Процедура ПриСозданииОбъекта(Знач ЗначениеИд, Знач ЗначениеИмя, Знач ЗначениеТип,
	Знач ЗначениеКвотаМб = 0, Знач ЗначениеПубликация = Истина, Знач ЗначениеВидимость = "public")
	Идентификатор = ЗначениеИд;
	Имя = ЗначениеИмя;
	Тип = ЗначениеТип;
	Видимость = ЗначениеВидимость;
	КвотаМб = ЗначениеКвотаМб;
	ПубликацияРазрешена = ЗначениеПубликация;
КонецПроцедуры
