// Заглушка ОпределителяБэкенда: заранее заданный ответ ЭтоPostgreSQL(). Не входит в состав приложения.

Перем ЭтоPG;

// Контракт ОпределителяБэкенда: заранее заданный ответ о бэкенде источника.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоPostgreSQL() Экспорт
	Возврат ЭтоPG;
КонецФункции

// Контракт ОпределителяБэкенда: коннектор источника.
//
// Возвращаемое значение:
//  Неопределено - заглушка коннектора не имеет.
//
Функция Коннектор() Экспорт
	Возврат Неопределено;
КонецФункции

Процедура ПриСозданииОбъекта(Знач ЗначениеЭтоPG)
	ЭтоPG = ЗначениеЭтоPG;
КонецПроцедуры
