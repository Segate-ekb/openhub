// Обработчик фонового задания для сторожа потокобезопасности пульта журнала: читает пульт
// и пишет в лог, пока другой поток правит, и запоминает первую жалобу. Судит набор.

Перем Пульт;     // ПультЖурнала
Перем Лог_;      // Лог — лог, в который поток пишет между чтениями
Перем Раз;       // Число — сколько кругов чтения
Перем Жалоба_;   // Строка — первая жалоба; "" — поток отработал чисто

// Жалоба потока: текст сбоя; пустая строка — читалось без исключений.
//
// Возвращаемое значение:
//  Строка.
//
Функция Жалоба() Экспорт
	Возврат Жалоба_;
КонецФункции

// Контракт обработчика фонового задания.
Процедура Исполнить() Экспорт

	Попытка
		Для Номер = 1 По Раз Цикл
			Пульт.Логи();
			Пульт.Корень();
			Пульт.СтрокиДляЗакрепления();
			Лог_.Отладка("чтение пульта, круг " + Номер);
		КонецЦикла;
	Исключение
		Жалоба_ = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач _Пульт, Знач _Лог, Знач _Раз)
	Пульт = _Пульт;
	Лог_ = _Лог;
	Раз = _Раз;
	Жалоба_ = "";
КонецПроцедуры
