// Фикстура: поиск и подключение классов модуля, разложенных по подкаталогам; имена типов глобальны.
// Подключение класса тянет объявления ключей настроек его модуля (РеестрНастроекХаба.КлассПодключён).

// Полный путь к файлу класса, найденному по имени в каталоге классов и его подкаталогах.
// Бросает исключение, если класс не найден либо найден в нескольких местах.
//
// Параметры:
//  КаталогКлассов - Строка - корень каталога классов модуля.
//  ИмяКласса      - Строка - имя класса без расширения.
//
// Возвращаемое значение:
//  Строка - полное имя файла.
//
Функция ФайлКласса(Знач КаталогКлассов, Знач ИмяКласса) Экспорт

	Найденные = Новый Массив();

	Для Каждого Файл Из НайтиФайлы(КаталогКлассов, ИмяКласса + ".os", Истина) Цикл
		Если Файл.ЭтоФайл() Тогда
			Найденные.Добавить(Файл.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Если Найденные.Количество() = 1 Тогда
		Возврат Найденные[0];
	КонецЕсли;

	Если Найденные.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Класс %1 не найден ни в %2, ни в его подкаталогах.", ИмяКласса, КаталогКлассов);
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Класс %1 найден в %2 местах — имена типов в OneScript глобальны, подкаталог"
			+ " пространства имён не создаёт (на продукте это падение старта"
			+ " «Type ... already registered»):%3%4",
		ИмяКласса, Найденные.Количество(), Символы.ПС, СтрСоединить(Найденные, Символы.ПС));

КонецФункции

// Все файлы классов модуля рекурсивно по подкаталогам.
//
// Параметры:
//  КаталогКлассов - Строка - корень каталога классов модуля.
//
// Возвращаемое значение:
//  Массив из Файл - файлы классов; каталога нет — исключение с его именем.
//
Функция ФайлыКлассов(Знач КаталогКлассов) Экспорт

	Результат = Новый Массив();

	// пустая выдача на пропавшем каталоге СУЖАЛА БЫ КОРПУС МОЛЧА: сканирующий набор
	// зеленел бы на нуле файлов, а переехавший или переименованный модуль уезжал
	// из-под проверки без единого красного
	Если НЕ Новый Файл(КаталогКлассов).Существует() Тогда
		ВызватьИсключение СтрШаблон(
			"Каталога классов %1 нет: путь переехал, модуль переименован либо снят."
				+ " Пустой корпус — это не «нечего проверять», а ослепший скан.",
			КаталогКлассов);
	КонецЕсли;

	Для Каждого Файл Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		Если Файл.ЭтоФайл() Тогда
			Результат.Добавить(Файл);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Подключает один класс по имени. Идемпотентно: повторный вызов безопасен.
//
// Параметры:
//  КаталогКлассов - Строка - корень каталога классов модуля.
//  ИмяКласса      - Строка - имя класса без расширения.
//
Процедура Подключить(Знач КаталогКлассов, Знач ИмяКласса) Экспорт

	Если ТипЗарегистрирован(ИмяКласса) Тогда
		Возврат;
	КонецЕсли;

	ПодключитьФайл(ФайлКласса(КаталогКлассов, ИмяКласса));

КонецПроцедуры

// Подключает класс по ГОТОВОМУ пути к файлу: имя типа — имя файла. Идемпотентно. Отмечает модуль
// класса у РеестрНастроекХаба: при подключённом реестре следом едут ключи настроек модуля.
//
// Параметры:
//  Путь - Строка - полное имя файла класса.
//
Процедура ПодключитьФайл(Знач Путь) Экспорт

	Имя = Новый Файл(Путь).ИмяБезРасширения;

	Если ТипЗарегистрирован(Имя) Тогда
		Возврат;
	КонецЕсли;

	ПодключитьСценарий(Путь, Имя);
	РеестрНастроекХаба.КлассПодключён(Путь);

КонецПроцедуры

// Подключает все классы модуля рекурсивно, пропуская уже зарегистрированные имена.
//
// Параметры:
//  КаталогКлассов - Строка - корень каталога классов модуля.
//
Процедура ПодключитьВсе(Знач КаталогКлассов) Экспорт

	Для Каждого Файл Из ФайлыКлассов(КаталогКлассов) Цикл
		ПодключитьФайл(Файл.ПолноеИмя);
	КонецЦикла;

КонецПроцедуры

// Подключает таблицы названных модулей — сущности и их хранилища — без остальных классов
// модуля: набору слоя данных службы предмета не нужны. Технику доступа к базе, на которой
// стоят хранилища, подключает модуль «данные». Идемпотентно.
//
// Параметры:
//  КаталогМодулей - Строка - корень src/модули.
//  СписокМодулей - Строка - модули-хозяева таблиц через запятую.
//
Процедура ПодключитьТаблицы(Знач КаталогМодулей, Знач СписокМодулей) Экспорт

	Для Каждого Файл Из ФайлыТаблиц(КаталогМодулей, СписокМодулей) Цикл
		ПодключитьФайл(Файл.ПолноеИмя);
	КонецЦикла;

КонецПроцедуры

// Файлы таблиц названных модулей: сущностей и их хранилищ.
//
// Параметры:
//  КаталогМодулей - Строка - корень src/модули.
//  СписокМодулей - Строка - модули-хозяева таблиц через запятую.
//
// Возвращаемое значение:
//  Массив из Файл - файлы классов, объявляющих таблицу.
//
Функция ФайлыТаблиц(Знач КаталогМодулей, Знач СписокМодулей) Экспорт

	Результат = Новый Массив();

	Для Каждого Модуль Из СтрРазделить(СписокМодулей, ",", Ложь) Цикл
		Для Каждого Файл Из ФайлыКлассов(ОбъединитьПути(КаталогМодулей, СокрЛП(Модуль), "Классы")) Цикл
			Если ОбъявляетТаблицу(ТекстФайла(Файл.ПолноеИмя)) Тогда
				Результат.Добавить(Файл);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Все модули приложения — каталоги корня src/модули — для набора, которому нужна модель
// данных хаба целиком.
//
// Параметры:
//  КаталогМодулей - Строка - корень src/модули.
//
// Возвращаемое значение:
//  Строка - имена модулей через запятую.
//
Функция ВсеМодули(Знач КаталогМодулей) Экспорт

	Имена = Новый Массив();
	Для Каждого Каталог Из НайтиФайлы(КаталогМодулей, "*", Ложь) Цикл
		Если Каталог.ЭтоКаталог() Тогда
			Имена.Добавить(Каталог.Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Имена, ",");

КонецФункции

// Подключает реализации названных контрактов из всех модулей вместе с таблицами их модулей:
// набору, который собирает контейнер по слоям, реализации из чужих модулей иначе не достаются,
// и контракт, собранный массивом, молча остаётся пустым. Реализация предмета стоит на его
// таблицах; прочие её зависимости подключает набор.
//
// Параметры:
//  КаталогМодулей - Строка - корень src/модули.
//  СписокКонтрактов - Строка - имена контрактов через запятую.
//
Процедура ПодключитьРеализации(Знач КаталогМодулей, Знач СписокКонтрактов) Экспорт

	МодулиРеализаций = Новый Массив();
	Для Каждого Реализация Из Реализации(КаталогМодулей, СписокКонтрактов) Цикл
		ПодключитьФайл(Реализация.Файл.ПолноеИмя);
		Если МодулиРеализаций.Найти(Реализация.Модуль) = Неопределено Тогда
			МодулиРеализаций.Добавить(Реализация.Модуль);
		КонецЕсли;
	КонецЦикла;

	ПодключитьТаблицы(КаталогМодулей, СтрСоединить(МодулиРеализаций, ","));

КонецПроцедуры

// Реализации названных контрактов во всех модулях: классы, несущие прозвище контракта.
//
// Параметры:
//  КаталогМодулей - Строка - корень src/модули.
//  СписокКонтрактов - Строка - имена контрактов через запятую.
//
// Возвращаемое значение:
//  Массив из Структура - Модуль (Строка), Файл (Файл) — в порядке обхода модулей.
//
Функция Реализации(Знач КаталогМодулей, Знач СписокКонтрактов) Экспорт

	Контракты = Новый Массив();
	Для Каждого Контракт Из СтрРазделить(СписокКонтрактов, ",", Ложь) Цикл
		Контракты.Добавить(СокрЛП(Контракт));
	КонецЦикла;

	Результат = Новый Массив();
	Для Каждого Модуль Из СтрРазделить(ВсеМодули(КаталогМодулей), ",", Ложь) Цикл
		Для Каждого Файл Из ФайлыКлассов(ОбъединитьПути(КаталогМодулей, Модуль, "Классы")) Цикл
			Если РеализуетОдинИз(ТекстФайла(Файл.ПолноеИмя), Контракты) Тогда
				Результат.Добавить(Новый Структура("Модуль, Файл", Модуль, Файл));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Объявляет ли исходник таблицу модели данных: аннотация &Сущность либо &ХранилищеСущностей
// в коде без комментариев и литералов. Дешёвый отсев по слову — до посимвольного разбора.
//
// Параметры:
//  Исходник - Строка - текст модуля.
//
// Возвращаемое значение:
//  Булево - Истина, если модуль — сущность или её хранилище.
//
Функция ОбъявляетТаблицу(Знач Исходник) Экспорт

	Если СтрНайти(Исходник, "Сущност") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Код = ИсходникБезКомментариев.БезКомментариевИЛитералов(Исходник);
	Возврат ЕстьАннотация(Код, "Сущность") ИЛИ ЕстьАннотация(Код, "ХранилищеСущностей");

КонецФункции

// Реализует ли исходник контракт: аннотация &Прозвище("<Контракт>") в коде без комментариев.
// Строка аннотации начинается с «&» — так не начинается ни продолжение многострочного
// литерала («|»), ни строка кода, где литерал лишь упоминает аннотацию.
//
// Параметры:
//  Исходник - Строка - текст модуля.
//  Контракт - Строка - имя контракта.
//
// Возвращаемое значение:
//  Булево - Истина, если модуль несёт прозвище контракта.
//
Функция РеализуетКонтракт(Знач Исходник, Знач Контракт) Экспорт

	Образец = СтрШаблон("&Прозвище(""%1"")", Контракт);
	Если СтрНайти(СтрЗаменить(Исходник, " ", ""), Образец) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Строка_ Из СтрРазделить(ИсходникБезКомментариев.БезКомментариев(Исходник), Символы.ПС) Цикл
		Голая = СтрЗаменить(СокрЛП(Строка_), " ", "");
		Если СтрНачинаетсяС(Голая, "&") И СтрНайти(Голая, Образец) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция РеализуетОдинИз(Знач Исходник, Знач Контракты)

	Для Каждого Контракт Из Контракты Цикл
		Если РеализуетКонтракт(Исходник, Контракт) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Аннотация — «&Имя», за которым не продолжается идентификатор: пробел и скобка допустимы,
// «&ИмяДлиннее» — чужая аннотация.
Функция ЕстьАннотация(Знач Код, Знач ИмяАннотации)

	Образец = "&" + ИмяАннотации;
	Позиция = 1;

	Пока Истина Цикл
		Найдено = СтрНайти(Код, Образец, , Позиция);
		Если Найдено = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Следующий = Сред(Код, Найдено + СтрДлина(Образец), 1);
		Если Следующий = "" ИЛИ СтрНайти(СимволыИдентификатора(), НРег(Следующий)) = 0 Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = Найдено + 1;
	КонецЦикла;

КонецФункции

Функция СимволыИдентификатора()
	Возврат "abcdefghijklmnopqrstuvwxyz0123456789_абвгдеёжзийклмнопрстуфхцчшщъыьэюя";
КонецФункции

Функция ТекстФайла(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Текст;

КонецФункции

// Подключает примитивы модуля «основа» целиком и дверь обезличивания журнала. Их спрашивает
// почти каждый класс хаба, создавая «Новым», а перечисление по одному имени ломает набор
// на каждом новом примитиве — и ломает не утверждением, а незагрузившимся набором.
//
// Параметры:
//  КаталогМодулей - Строка - корень src/модули.
//
Процедура ПодключитьОснову(Знач КаталогМодулей) Экспорт
	ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "основа", "Классы"));
	Подключить(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы"), "ОбезличиваниеЖурнала");
КонецПроцедуры

// Подключает словарь текстов интерфейса вместе с частями — реализациями контракта
// «ЧастьСловаряТекстов». Без частей словарь не создаётся. Идемпотентно.
//
// Параметры:
//  КаталогМодулей - Строка - корень src/модули.
//
Процедура ПодключитьСловарьТекстов(Знач КаталогМодулей) Экспорт

	ПодключитьРеализации(КаталогМодулей, КонтрактЧастиСловаря());
	Подключить(КаталогКлассовИнтерфейса(КаталогМодулей), "СловарьТекстов");

КонецПроцедуры

// Части словаря текстов по экземпляру на каждую реализацию контракта — то, что словарь получает
// от контейнера массивом. Типы частей подключает ПодключитьСловарьТекстов.
//
// Параметры:
//  КаталогМодулей - Строка - корень src/модули.
//
// Возвращаемое значение:
//  Массив из ЧастьСловаряТекстов - части словаря.
//
Функция ЧастиСловаряТекстов(Знач КаталогМодулей) Экспорт

	Результат = Новый Массив();
	Для Каждого Реализация Из Реализации(КаталогМодулей, КонтрактЧастиСловаря()) Цикл
		Результат.Добавить(Новый(Реализация.Файл.ИмяБезРасширения));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КонтрактЧастиСловаря()
	Возврат "ЧастьСловаряТекстов";
КонецФункции

Функция КаталогКлассовИнтерфейса(Знач КаталогМодулей)
	Возврат ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
КонецФункции

// Зарегистрирован ли тип. Глобальный ТипЗарегистрирован() в модуле-классе
// недоступен («Symbol not found»), поэтому проба типом.
//
// Параметры:
//  ИмяТипа - Строка - имя типа.
//
// Возвращаемое значение:
//  Булево - признак регистрации.
//
Функция ТипЗарегистрирован(Знач ИмяТипа) Экспорт

	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции
