// Фейк КаталогРепозиториевGitHub: отвечает по таблице «токен → репозитории», без сети.
// Считает обращения — этим проверяется, что в сеть не ходили вовсе.

Перем ПоТокену;       // Соответствие: токен → Массив имён репозиториев
Перем СчётчикВызовов;
Перем ПоследнийЛогин;
Перем ПоследняяОрганизация;
Перем БросатьСбой;
Перем ЗадержкаМС;     // Число - сколько «отвечает GitHub»; так проверяется, что вход не ждёт

// Объявляет, какие репозитории видит владелец токена.
//
// Параметры:
//  Токен - Строка - access-token.
//  ИменаЧерезЗапятую - Строка - короткие имена репозиториев.
//
Процедура Разрешить(Знач Токен, Знач ИменаЧерезЗапятую) Экспорт
	Имена = Новый Массив();
	Для Каждого Имя Из СтрРазделить(ИменаЧерезЗапятую, ",") Цикл
		Если ЗначениеЗаполнено(СокрЛП(Имя)) Тогда
			Имена.Добавить(СокрЛП(Имя));
		КонецЕсли;
	КонецЦикла;
	ПоТокену.Вставить(Ключ(Токен), Имена);
КонецПроцедуры

// Переводит фейк в режим сбоя и обратно: в режиме сбоя вызов бросает исключение.
//
// Параметры:
//  Включить - Булево - режим сбоя (необязательный, по умолчанию Истина).
//
Процедура ЭмулироватьСбой(Знач Включить = Истина) Экспорт
	БросатьСбой = Включить;
КонецПроцедуры

// Задаёт, сколько каталог «идёт в GitHub», прежде чем ответить.
//
// Параметры:
//  Миллисекунд - Число - длительность ответа; 0 снимает задержку.
//
Процедура ОтвечатьДолго(Знач Миллисекунд) Экспорт
	ЗадержкаМС = Макс(0, Цел(Миллисекунд));
КонецПроцедуры

// Число обращений к РепозиторииСПравомЗаписи.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоВызовов() Экспорт
	Возврат СчётчикВызовов;
КонецФункции

// Логин, с которым звали в последний раз.
//
// Возвращаемое значение:
//  Строка.
//
Функция ЛогинПоследний() Экспорт
	Возврат ПоследнийЛогин;
КонецФункции

// Организация, с которой звали в последний раз.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОрганизацияПоследняя() Экспорт
	Возврат ПоследняяОрганизация;
КонецФункции

// Контракт КаталогРепозиториевGitHub.
//
// Параметры:
//  Токен - Строка - access-token.
//  ЛогинGitHub - Строка - логин владельца токена.
//  Организация - Строка - владелец репозиториев.
//
// Возвращаемое значение:
//  Массив из Строка - заранее объявленные имена либо пустой массив.
//
Функция РепозиторииСПравомЗаписи(Знач Токен, Знач ЛогинGitHub, Знач Организация) Экспорт

	СчётчикВызовов = СчётчикВызовов + 1;
	ПоследнийЛогин = Строка(ЛогинGitHub);
	ПоследняяОрганизация = Строка(Организация);

	Если ЗадержкаМС > 0 Тогда
		Приостановить(ЗадержкаМС);
	КонецЕсли;

	Если БросатьСбой Тогда
		ВызватьИсключение "ФейкКаталогаРепозиториевGitHub: эмуляция сбоя каталога";
	КонецЕсли;

	Имена = ПоТокену.Получить(Ключ(Токен));
	Возврат ?(Имена = Неопределено, Новый Массив(), Имена);

КонецФункции

Функция Ключ(Знач Токен)
	Возврат СокрЛП(Строка(Токен));
КонецФункции

&Прозвище("КаталогРепозиториевGitHub")
&Желудь
Процедура ПриСозданииОбъекта()
	ПоТокену = Новый Соответствие();
	СчётчикВызовов = 0;
	ПоследнийЛогин = "";
	ПоследняяОрганизация = "";
	БросатьСбой = Ложь;
	ЗадержкаМС = 0;
КонецПроцедуры
