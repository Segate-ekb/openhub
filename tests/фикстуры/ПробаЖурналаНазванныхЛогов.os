// Желудь с несколькими названными логами: каждому набор связки журнала задаёт свой уровень,
// порог коллектора или выходы и смотрит, куда уходят строки.

Перем Логи;   // Соответствие: имя лога → Лог

// Лог по имени.
//
// Параметры:
//  Имя - Строка - имя лога: проба.сосед, проба.безколлектора, проба.порог, проба.изфайла,
//        проба.вконсоль.
//
// Возвращаемое значение:
//  Лог - лог, внедрённый фабрикой autumn-logos.
//
Функция Лог(Знач Имя) Экспорт
	Возврат Логи[Имя];
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Лог(Значение = "проба.сосед", УчитыватьИмяКласса = Ложь) _Сосед,
	&Лог(Значение = "проба.безколлектора", УчитыватьИмяКласса = Ложь) _БезКоллектора,
	&Лог(Значение = "проба.порог", УчитыватьИмяКласса = Ложь) _Порог,
	&Лог(Значение = "проба.изфайла", УчитыватьИмяКласса = Ложь) _ИзФайла,
	&Лог(Значение = "проба.вконсоль", УчитыватьИмяКласса = Ложь) _ВКонсоль)

	Логи = Новый Соответствие();
	Логи.Вставить("проба.сосед", _Сосед);
	Логи.Вставить("проба.безколлектора", _БезКоллектора);
	Логи.Вставить("проба.порог", _Порог);
	Логи.Вставить("проба.изфайла", _ИзФайла);
	Логи.Вставить("проба.вконсоль", _ВКонсоль);

КонецПроцедуры
