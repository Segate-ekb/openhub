// Отметка живости, которая только считает шаги: ею меряется, отмечается ли перечисление
// порции внутри цикла.

Перем Шагов_;
Перем Имена_;

// Контракт отметки живости: перечисление дошло до очередного имени.
//
// Параметры:
//  ИмяПакета - Строка - имя, до которого дошло перечисление.
//
Процедура Шаг(Знач ИмяПакета) Экспорт
	Шагов_ = Шагов_ + 1;
	Имена_.Добавить(Строка(ИмяПакета));
КонецПроцедуры

// Сколько раз перечисление отметилось.
//
// Возвращаемое значение:
//  Число.
//
Функция Шагов() Экспорт
	Возврат Шагов_;
КонецФункции

// Имена, на которых перечисление отмечалось.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Имена() Экспорт
	Возврат Имена_;
КонецФункции

Процедура ПриСозданииОбъекта()
	Шагов_ = 0;
	Имена_ = Новый Массив();
КонецПроцедуры
