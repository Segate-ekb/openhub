// Реестр-образец для проверки чисел хаба: играет сразу за сервис пулов, сервис пакетов,
// сервис прав, хранилище версий, сервис пользователей, статистику скачиваний, очереди
// доставок и обходов и издателя событий — все они нужны желудям РазмерыПубличногоРеестра
// и ЧислаХаба, а порознь рассказывали бы не о реестре, а о десятке заглушек.

Перем Пулы_;
Перем ПакетыПулов;   // идентификатор пула -> Массив пакетов
Перем Версий_;
Перем Пользователей_;
Перем СкачиванияПакетов;  // идентификатор пакета -> Число
Перем ОчередьДоставок;
Перем ОчередьОбходов;
Перем Пропущено_;
Перем Срываться;
Перем СрыватьсяНаПользователях;

#Область ПубличныйИнтерфейс

// Добавляет пул.
//
// Параметры:
//  Идентификатор - Строка - идентификатор пула; он же имя пула.
//  Публичный - Булево - виден ли пул анонимному посетителю.
//  Занято - Число - занятое пулом место в байтах (необязательный).
//
Процедура ДобавитьПул(Знач Идентификатор, Знач Публичный, Знач Занято = 0) Экспорт

	Пулы_.Добавить(Новый Структура("Идентификатор, Имя, Публичный, ЗанятоБайт",
		Идентификатор, Идентификатор, Публичный, Занято));
	ПакетыПулов.Вставить(Идентификатор, Новый Массив());

КонецПроцедуры

// Добавляет пакет в пул.
//
// Параметры:
//  ПулИдентификатор - Строка - пул пакета.
//  Скрыт - Булево - скрыт ли пакет.
//
Процедура ДобавитьПакет(Знач ПулИдентификатор, Знач Скрыт) Экспорт
	ПакетыПулов[ПулИдентификатор].Добавить(Новый Структура("Скрыт", Скрыт));
КонецПроцедуры

// Задаёт остальные числа хаба — те, что не считаются по пулам и пакетам.
//
// Параметры:
//  Версий - Число - версий в реестре.
//  Пользователей - Число - пользователей хаба.
//  Доставок - Число - заданий в очереди доставки подписок.
//  Обходов - Число - заявок в очереди обходов зеркал.
//  Пропущено - Число - уроненных подписчиками доставок событий.
//
Процедура ЗадатьЧисла(Знач Версий, Знач Пользователей, Знач Доставок, Знач Обходов,
	Знач Пропущено) Экспорт

	Версий_ = Версий;
	Пользователей_ = Пользователей;
	ОчередьДоставок = Доставок;
	ОчередьОбходов = Обходов;
	Пропущено_ = Пропущено;

КонецПроцедуры

// Добавляет скачивания пакету.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Сколько - Число - число скачиваний.
//
Процедура ДобавитьСкачивания(Знач ПакетИдентификатор, Знач Сколько) Экспорт
	СкачиванияПакетов.Вставить(ПакетИдентификатор, Сколько);
КонецПроцедуры

// Заставляет реестр срываться на первом же обращении: так проверяется, что сбой подсчёта
// отдаётся признаком, а не исключением наружу.
//
Процедура Сорваться() Экспорт
	Срываться = Истина;
КонецПроцедуры

// Заставляет срываться ОДИН источник — пользователей: так проверяется, что сбой одного
// числа не отнимает снимок у остальных.
//
Процедура СорватьПользователей() Экспорт
	СрыватьсяНаПользователях = Истина;
КонецПроцедуры

#КонецОбласти

#Область КонтрактыСлужб

// Контракт СервисПулов.
//
// Возвращаемое значение:
//  Массив - пулы реестра.
//
Функция ВсеПулы() Экспорт

	Если Срываться Тогда
		ВызватьИсключение "РеестрОбразцаДляЧисел: намеренный сбой чтения пулов";
	КонецЕсли;

	Возврат Пулы_;

КонецФункции

// Контракт СервисПулов: занятое пулом место.
//
// Параметры:
//  Пул - Структура - пул реестра.
//
// Возвращаемое значение:
//  Число - байты.
//
Функция ЗанятоБайт(Знач Пул) Экспорт
	Возврат Пул.ЗанятоБайт;
КонецФункции

// Контракт СервисПулов: занятое место пулов списком.
//
// Параметры:
//  Пулы - Массив из Структура - пулы реестра.
//
// Возвращаемое значение:
//  Соответствие - идентификатор пула → байты.
//
Функция ЗанятоПулами(Знач Пулы) Экспорт

	Занято = Новый Соответствие();
	Для Каждого Пул Из Пулы Цикл
		Занято.Вставить(Пул.Идентификатор, Пул.ЗанятоБайт);
	КонецЦикла;
	Возврат Занято;

КонецФункции

// Контракт СервисПакетов.
//
// Параметры:
//  ПулИдентификатор - Строка - пул.
//
// Возвращаемое значение:
//  Массив - пакеты пула.
//
Функция ПакетыПула(Знач ПулИдентификатор) Экспорт
	Возврат ПакетыПулов[ПулИдентификатор];
КонецФункции

// Контракт СервисПакетов: сколько нескрытых пакетов в названных пулах — одним счётом.
//
// Параметры:
//  ПулИдентификаторы - Массив - идентификаторы пулов.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоВидимыхПакетовПулов(Знач ПулИдентификаторы) Экспорт

	Итог = 0;
	Для Каждого ПулИдентификатор Из ПулИдентификаторы Цикл
		Для Каждого Пакет Из ПакетыПулов[ПулИдентификатор] Цикл
			Если Пакет.Скрыт = Ложь Тогда
				Итог = Итог + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Контракт СервисПрав.
//
// Параметры:
//  Пул - Структура - пул реестра.
//
// Возвращаемое значение:
//  Булево - виден ли пул анонимному посетителю.
//
Функция ПулПубличный(Знач Пул) Экспорт
	Возврат Пул.Публичный;
КонецФункции

// Контракт ХранилищеВерсийПакета: сколько версий в реестре.
//
// Возвращаемое значение:
//  Число.
//
Функция Количество() Экспорт
	Возврат Версий_;
КонецФункции

// Контракт СервисПользователей.
//
// Возвращаемое значение:
//  Число.
//
Функция ВсегоПользователей() Экспорт

	Если СрыватьсяНаПользователях Тогда
		ВызватьИсключение "РеестрОбразцаДляЧисел: намеренный сбой счёта пользователей";
	КонецЕсли;

	Возврат Пользователей_;

КонецФункции

// Контракт СлужбаСтатистикиСкачиваний: скачивания всего хаба одним числом.
//
// Возвращаемое значение:
//  Число.
//
Функция СкачиванийВсего() Экспорт

	Итог = 0;
	Для Каждого КиЗ Из СкачиванияПакетов Цикл
		Итог = Итог + КиЗ.Значение;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Контракт СлужбаДоставкиПодписок.
//
// Возвращаемое значение:
//  Число - заданий в очереди доставки.
//
Функция РазмерОчереди() Экспорт
	Возврат ОчередьДоставок;
КонецФункции

// Контракт ОчередьСинхронизацииЗеркал.
//
// Возвращаемое значение:
//  Число - заявок в очереди обходов.
//
Функция Размер() Экспорт
	Возврат ОчередьОбходов;
КонецФункции

// Контракт ИздательСобытий: сколько доставок подписчики уронили.
//
// Возвращаемое значение:
//  Число.
//
Функция ПропущенныхДоставок() Экспорт
	Возврат Пропущено_;
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()

	Пулы_ = Новый Массив();
	ПакетыПулов = Новый Соответствие();
	СкачиванияПакетов = Новый Соответствие();
	Версий_ = 0;
	Пользователей_ = 0;
	ОчередьДоставок = 0;
	ОчередьОбходов = 0;
	Пропущено_ = 0;
	Срываться = Ложь;
	СрыватьсяНаПользователях = Ложь;

КонецПроцедуры
