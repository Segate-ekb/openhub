// ХранилищеВерсийПакета в памяти, считающее ПРОЧИТАННЫЕ СТРОКИ. Запрос у блока «Мои пакеты»
// и так был один — растёт не их число, а число версий, которое запрос отдаёт витрине:
// весь список пакетов в управлении против горстки показанных.

Перем Версии;        // Массив из Структура (Идентификатор, ПакетИдентификатор, Версия, Опубликована, Отозвана)
Перем СчётСтрок;
Перем СчётЗапросов;

#Область Счётчики

// Сколько строк версий хранилище отдало с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Строк() Экспорт
	Возврат СчётСтрок;
КонецФункции

// Сколько запросов к хранилищу ушло с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Запросов() Экспорт
	Возврат СчётЗапросов;
КонецФункции

#КонецОбласти

#Область НаполнениеФикстуры

// Заводит версию (за обращение не считается).
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Версия - Строка - строка версии.
//  Опубликована - Дата - момент публикации.
//  Отозвана - Булево - признак отзыва (необязательный, по умолчанию Ложь).
//
Процедура Добавить(Знач ПакетИдентификатор, Знач Версия, Знач Опубликована,
	Знач Отозвана = Ложь) Экспорт

	Версии.Добавить(Новый Структура(
		"Идентификатор, ПакетИдентификатор, Версия, Опубликована, Отозвана",
		Версии.Количество() + 1, Цел(ПакетИдентификатор), Версия, Опубликована, Отозвана));

КонецПроцедуры

#КонецОбласти

#Область КонтрактХранилища

// Все версии перечисленных пакетов — дверь, через которую цена росла числом версий.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Массив - версии всех перечисленных пакетов.
//
Функция ВерсииПакетов(Знач ПакетИдентификаторы) Экспорт
	Возврат Отдать(ВерсииСписка(ПакетИдентификаторы));
КонецФункции

#КонецОбласти

Функция ВерсииСписка(Знач ПакетИдентификаторы)

	Нужные = Новый Соответствие();
	Для Каждого Идентификатор Из ПакетИдентификаторы Цикл
		Нужные.Вставить(Цел(Идентификатор), Истина);
	КонецЦикла;

	Результат = Новый Массив();
	Для Каждого Версия Из Версии Цикл
		Если Нужные.Получить(Версия.ПакетИдентификатор) <> Неопределено Тогда
			Результат.Добавить(Версия);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Отдать(Знач Строки)

	СчётЗапросов = СчётЗапросов + 1;
	СчётСтрок = СчётСтрок + Строки.Количество();
	Возврат Строки;

КонецФункции

Процедура ПриСозданииОбъекта()
	Версии = Новый Массив();
	СчётСтрок = 0;
	СчётЗапросов = 0;
КонецПроцедуры
