// Желудь с логами для набора пульта журнала: лог на корне, логи с уровнем и порогом из настроек,
// лог без коллектора, лог с отправкой, выключенной при старте, лог, чей единственный выход молчит,
// и лог, которому код повесил свой выход, как журналу аудита.

Перем Логи;         // Соответствие: имя лога → Лог
Перем ЧужойВыход;   // ЛовушкаЛога — выход, повешенный кодом на лог пульт.чужой

// Лог по имени.
//
// Параметры:
//  Имя - Строка - пульт.сосед, пульт.другой, пульт.свой, пульт.поднят, пульт.порог,
//        пульт.порогинфо, пульт.безколлектора, пульт.отключён, пульт.молчит, пульт.чужой.
//
// Возвращаемое значение:
//  Лог - лог, внедрённый фабрикой autumn-logos.
//
Функция Лог(Знач Имя) Экспорт
	Возврат Логи[Имя];
КонецФункции

// Выход, который код повесил на лог пульт.чужой своим уровнем.
//
// Возвращаемое значение:
//  ЛовушкаЛога
//
Функция ЧужойВыход() Экспорт
	Возврат ЧужойВыход;
КонецФункции

// Пишет строку отладки из фонового задания: так набор видит, что правку видит не только
// поток, который её сделал.
//
// Параметры:
//  Имя - Строка - имя лога.
//  Текст - Строка - текст строки.
//
Процедура ОтладкаИзФона(Знач Имя, Знач Текст) Экспорт
	Логи[Имя].Отладка(Текст);
КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Лог(Значение = "пульт.сосед", УчитыватьИмяКласса = Ложь) _Сосед,
	&Лог(Значение = "пульт.другой", УчитыватьИмяКласса = Ложь) _Другой,
	&Лог(Значение = "пульт.свой", УчитыватьИмяКласса = Ложь) _Свой,
	&Лог(Значение = "пульт.поднят", УчитыватьИмяКласса = Ложь) _Поднят,
	&Лог(Значение = "пульт.порог", УчитыватьИмяКласса = Ложь) _Порог,
	&Лог(Значение = "пульт.порогинфо", УчитыватьИмяКласса = Ложь) _ПорогИнфо,
	&Лог(Значение = "пульт.безколлектора", УчитыватьИмяКласса = Ложь) _БезКоллектора,
	&Лог(Значение = "пульт.отключён", УчитыватьИмяКласса = Ложь) _Отключён,
	&Лог(Значение = "пульт.молчит", УчитыватьИмяКласса = Ложь) _Молчит,
	&Лог(Значение = "пульт.чужой", УчитыватьИмяКласса = Ложь) _Чужой)

	Логи = Новый Соответствие();
	Логи.Вставить("пульт.сосед", _Сосед);
	Логи.Вставить("пульт.другой", _Другой);
	Логи.Вставить("пульт.свой", _Свой);
	Логи.Вставить("пульт.поднят", _Поднят);
	Логи.Вставить("пульт.порог", _Порог);
	Логи.Вставить("пульт.порогинфо", _ПорогИнфо);
	Логи.Вставить("пульт.безколлектора", _БезКоллектора);
	Логи.Вставить("пульт.отключён", _Отключён);
	Логи.Вставить("пульт.молчит", _Молчит);
	Логи.Вставить("пульт.чужой", _Чужой);

	// как ЛетописьАудита: свой выход с самым подробным уровнем, мимо настроек logos
	ЧужойВыход = Новый ЛовушкаЛога();
	_Чужой.ДобавитьСпособВывода(ЧужойВыход, 0);

КонецПроцедуры
