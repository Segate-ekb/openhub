// Фейк ПроверяющийGitHub: отвечает по таблице «токен+пакет → право записи», без сети.

Перем Разрешения;    // Соответствие "токен|пакет" -> Булево
Перем СчётчикВызовов; // число обращений (проверка stateless-перепроверки)

// Разрешает запись для пары «токен + пакет».
//
// Параметры:
//  Токен - Строка - токен доступа.
//  ИмяПакета - Строка - имя пакета.
//
Процедура Разрешить(Знач Токен, Знач ИмяПакета) Экспорт
	Разрешения.Вставить(Ключ(Токен, ИмяПакета), Истина);
КонецПроцедуры

// Число обращений к ЕстьПравоЗаписи.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоВызовов() Экспорт
	Возврат СчётчикВызовов;
КонецФункции

// Контракт ПроверяющийGitHub: есть ли право записи в репозиторий зеркала для пакета.
//
// Параметры:
//  Токен - Строка - токен доступа.
//  ИмяПакета - Строка - имя пакета.
//
// Возвращаемое значение:
//  Булево - Истина, если пара заранее разрешена.
//
Функция ЕстьПравоЗаписи(Знач Токен, Знач ИмяПакета) Экспорт
	СчётчикВызовов = СчётчикВызовов + 1;
	Возврат Разрешения[Ключ(Токен, ИмяПакета)] = Истина;
КонецФункции

Функция Ключ(Знач Токен, Знач ИмяПакета)
	Возврат НРег(СокрЛП(Строка(Токен))) + "|" + НРег(СокрЛП(Строка(ИмяПакета)));
КонецФункции

&Прозвище("ПроверяющийGitHub")
&Желудь
Процедура ПриСозданииОбъекта()
	Разрешения = Новый Соответствие();
	СчётчикВызовов = 0;
КонецПроцедуры
