// Фейк ПоследствийЗакрытияПровайдера: обстановку, которую видит администратор,
// задаёт тест. Настоящая считает её по учёткам, и наборам о правиле это не нужно.

Перем Учёток;
Перем ПарольныйВход;
Перем ВосстановлениеПароля;

// Контракт ПоследствийЗакрытияПровайдера: обстановка вокруг провайдера.
//
// Параметры:
//  ИмяПровайдера - Строка - имя провайдера (фейком не используется).
//
// Возвращаемое значение:
//  Структура - Учёток (Число), ПарольныйВход (Булево), ВосстановлениеПароля (Булево).
//
Функция ДляПровайдера(Знач ИмяПровайдера) Экспорт

	Возврат Новый Структура("Учёток, ПарольныйВход, ВосстановлениеПароля",
		Учёток, ПарольныйВход, ВосстановлениеПароля);

КонецФункции

// Задаёт обстановку, которую фейк отдаёт любому провайдеру.
//
// Параметры:
//  Число - Число - учёток без другого способа войти.
//  Пароль - Булево - включён ли парольный вход.
//  Восстановление - Булево - доступно ли восстановление пароля.
//
Процедура Установить(Знач Число, Знач Пароль, Знач Восстановление) Экспорт

	Учёток = Цел(Число);
	ПарольныйВход = (Пароль = Истина);
	ВосстановлениеПароля = (Восстановление = Истина);

КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Учёток = 0;
	ПарольныйВход = Истина;
	ВосстановлениеПароля = Истина;
КонецПроцедуры
