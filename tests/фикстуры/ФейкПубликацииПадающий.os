// Фейк СервисаПубликации: публикация срывается заранее подготовленным сбоем.
// Так проверяется, что видит человек в консоли opm и что уходит в журнал.

Перем Сбой_;   // ИнформацияОбОшибке либо Строка - что бросить вместо публикации

// Контракт СервисаПубликации: публикация артефакта. Заглушка вместо неё бросает сбой.
//
// Параметры:
//  ИмяПула - Строка - имя пула.
//  Тело - ДвоичныеДанные - байты .ospx.
//  ИмяФайла - Строка - имя файла из заголовка.
//  Канал - Строка - имя канала из заголовка.
//  Пользователь - Произвольный - публикующий.
//  Токен - Строка - ключ доступа.
//  Принципал - Произвольный - принципал запроса.
//  Форсировать - Булево - режим замены опубликованного номера.
//
// Возвращаемое значение:
//  Структура - до возврата дело не доходит.
//
Функция Опубликовать(Знач ИмяПула, Знач Тело, Знач ИмяФайла, Знач Канал, Знач Пользователь,
	Знач Токен, Знач Принципал, Знач Форсировать) Экспорт

	ИмяПула = ИмяПула;
	Тело = Тело;
	ИмяФайла = ИмяФайла;
	Канал = Канал;
	Пользователь = Пользователь;
	Токен = Токен;
	Принципал = Принципал;
	Форсировать = Форсировать;

	ВызватьИсключение Сбой_;

КонецФункции

// Контракт СервисаПубликации: разбор параметра «?force=».
//
// Параметры:
//  Флаг - Строка - значение параметра адреса.
//
// Возвращаемое значение:
//  Булево - Ложь: заглушке форс безразличен.
//
Функция ЭтоФорс(Знач Флаг) Экспорт
	Флаг = Флаг;
	Возврат Ложь;
КонецФункции

Процедура ПриСозданииОбъекта(Знач Сбой)
	Сбой_ = Сбой;
КонецПроцедуры
