// Стенд зеркал хаба: строка зеркала пула со всеми её колонками — одной дверью вместо
// двух десятков присваиваний, переписанных в каждом наборе.
//
// Зеркало пишется СТРОКОЙ, мимо СервисаЗеркал: наборам движка обхода нужна запись
// в состоянии «создано, ещё не синхронизировано», а не последствия заведения службой.
// Колонки прогона заполняются нулями и пустыми моментами — ровно так, как их оставляет
// хаб на только что заведённом зеркале; зеркало с мусором в колонках прогона ведёт себя
// в инкрементальном обходе не так, как настоящее.

Перем Контейнер;

// Заводит зеркало пула строкой в хранилище.
//
// Параметры:
//  ПулИлиИдентификатор - Пул, Число - пул назначения.
//  АпстримURL - Строка - адрес источника (необязательный, по умолчанию
//               "http://upstream.invalid/download/").
//  Режим - Строка - opm, api-v1, pull либо «пакеты» (необязательный, по умолчанию "opm").
//  Включено - Булево - признак включённого зеркала (необязательный, по умолчанию Истина).
//
// Возвращаемое значение:
//  ЗеркалоХаба - сохранённая строка зеркала.
//
Функция Зеркало(Знач ПулИлиИдентификатор, Знач АпстримURL = "http://upstream.invalid/download/",
	Знач Режим = "opm", Знач Включено = Истина) Экспорт

	Пусто = '00010101000000';

	Запись = Контейнер.НайтиЖелудь("ХранилищеЗеркалХабов").СоздатьЭлемент();
	Запись.ПулНазначенияИдентификатор = ПомощникиСтендов.Идентификатор(ПулИлиИдентификатор);
	Запись.АпстримURL = АпстримURL;
	Запись.ТокенДоступа = "";
	Запись.Режим = Режим;
	Запись.ФильтрJSON = "";
	Запись.ИнтервалСинкаСек = 3600;
	Запись.Включено = Включено;
	Запись.ПоследнийСинк = Пусто;
	Запись.Статус = "создано, ещё не синхронизировано";

	Запись.СостояниеПрогона = "простаивает";
	Запись.ПрогонНачат = Пусто;
	Запись.ПрогонОбновлён = Пусто;
	Запись.ПрогонВсего = 0;
	Запись.ПрогонСкачано = 0;
	Запись.ПрогонПропущено = 0;
	Запись.ПрогонОшибок = 0;
	Запись.ПрогонНедоступно = 0;
	Запись.ПрогонИмёнВсего = 0;
	Запись.ПрогонИмёнПройдено = 0;
	Запись.ПрогонКурсор = "";
	Запись.ПрогонЗапустил = "";
	Запись.ВычитаноДо = Пусто;
	Запись.ПрогонСрезС = Пусто;
	Запись.ПрогонМоментСреза = Пусто;

	Запись.СозданКем = 0;
	Запись.Создан = ТекущаяУниверсальнаяДата();
	Запись.Обновлён = Запись.Создан;
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

Процедура ПриСозданииОбъекта(Знач Поделка)
	Контейнер = Поделка;
КонецПроцедуры
