// Источник данных entity с заданным пулом и пределом: базы за ним нет.

Перем Пул_;
Перем Предел_;

#Область КонтрактИсточника

// Пул соединений источника.
//
// Возвращаемое значение:
//  ФейкПулСоединений.
//
Функция ПулСоединений() Экспорт
	Возврат Пул_;
КонецФункции

// Предел одновременно живущих соединений; 0 — без предела.
//
// Возвращаемое значение:
//  Число.
//
Функция РазмерПула() Экспорт
	Возврат Предел_;
КонецФункции

#КонецОбласти

// Пул и предел задаёт тест.
//
// Параметры:
//  Пул    - ФейкПулСоединений - снимок занятости.
//  Предел - Число - размер пула; 0 — без предела.
//
Процедура ПриСозданииОбъекта(Знач Пул, Знач Предел) Экспорт
	Пул_ = Пул;
	Предел_ = Предел;
КонецПроцедуры
