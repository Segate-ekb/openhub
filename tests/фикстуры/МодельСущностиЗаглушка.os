// Заглушка ОбъектаМодели entity: имя таблицы и имена колонок задаёт тест. Текст агрегата,
// собранный из литералов вместо модели, на такой модели разъезжается сразу.

Перем ИмяТаблицы_;
Перем Колонки_;

// Поле сущности и колонка, которой оно лежит в базе.
//
// Параметры:
//  ИмяПоля - Строка - имя поля сущности.
//  ИмяКолонки - Строка - имя колонки в базе.
//  ТипКолонки - Строка - тип модели: «Целое», «Строка», «Булево» (необязательный,
//               по умолчанию «Строка»).
//
// Возвращаемое значение:
//  МодельСущностиЗаглушка - этот же объект, чтобы поля писались цепочкой.
//
Функция Поле(Знач ИмяПоля, Знач ИмяКолонки, Знач ТипКолонки = "Строка") Экспорт

	Строка = Колонки_.Добавить();
	Строка.ИмяПоля = ИмяПоля;
	Строка.ИмяКолонки = ИмяКолонки;
	Строка.ТипКолонки = ТипКолонки;

	Возврат ЭтотОбъект;

КонецФункции

// Контракт ОбъектаМодели: имя таблицы сущности.
//
// Возвращаемое значение:
//  Строка.
//
Функция ИмяТаблицы() Экспорт
	Возврат ИмяТаблицы_;
КонецФункции

// Контракт ОбъектаМодели: колонки сущности.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки ИмяПоля, ИмяКолонки, ТипКолонки.
//
Функция Колонки() Экспорт
	Возврат Колонки_.Скопировать();
КонецФункции

Процедура ПриСозданииОбъекта(Знач ИмяТаблицы)

	ИмяТаблицы_ = ИмяТаблицы;
	Колонки_ = Новый ТаблицаЗначений();
	Колонки_.Колонки.Добавить("ИмяПоля");
	Колонки_.Колонки.Добавить("ИмяКолонки");
	Колонки_.Колонки.Добавить("ТипКолонки");

КонецПроцедуры
