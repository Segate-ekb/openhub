// Фейк РазрешителяImён: заданные IP по имени, иначе Неопределено — DNS-based SSRF проверяется офлайн.

Перем Карта;      // Соответствие: имя (НРег) -> Массив из Строка (IP) ЛИБО Неопределено
Перем Запросов;   // сколько раз резолв спрашивали

// Настраивает ответ резолва для имени.
//
// Параметры:
//  Имя - Строка - имя хоста.
//  Адреса - Массив из Строка - адреса; Неопределено — имя не разрешается.
//
Процедура ЗадатьАдреса(Знач Имя, Знач Адреса) Экспорт
	Карта.Вставить(НРег(СокрЛП(Строка(Имя))), Адреса);
КонецПроцедуры

// Настраивает единственный приватный адрес для имени.
//
// Параметры:
//  Имя - Строка - имя хоста.
//  IP - Строка - адрес.
//
Процедура ЗадатьПриватный(Знач Имя, Знач IP) Экспорт
	Массив_ = Новый Массив();
	Массив_.Добавить(IP);
	ЗадатьАдреса(Имя, Массив_);
КонецПроцедуры

// Контракт РазрешителяImён: адреса хоста.
//
// Параметры:
//  Хост - Строка - имя хоста.
//
// Возвращаемое значение:
//  Массив из Строка - адреса либо Неопределено, если имя не настроено.
//
Функция Разрешить(Знач Хост) Экспорт
	Запросов = Запросов + 1;
	Значение = Карта.Получить(НРег(СокрЛП(Строка(Хост))));
	Возврат Значение; // Неопределено, если имя не настроено
КонецФункции

// Сколько раз резолв спрашивали: путь, который обязан обходиться без DNS, проверяется
// этим числом, а не результатом.
//
// Возвращаемое значение:
//  Число - число вызовов Разрешить.
//
Функция КоличествоЗапросов() Экспорт
	Возврат Запросов;
КонецФункции

Процедура ПриСозданииОбъекта()
	Карта = Новый Соответствие();
	Запросов = 0;
КонецПроцедуры
