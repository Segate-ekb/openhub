// Фейк СервисДоверияCI для тестов представления: записи задаёт вызывающий, база не нужна.
// Имя записи считает настоящий ИмяЗаписиДоверия — своей копии этого правила у фейка нет.

Перем Строки;
Перем Аудитория;
Перем Имена;

// Задаёт аудиторию, которую фейк отдаёт как ожидаемую хабом.
//
// Параметры:
//  Значение - Строка - значение клейма aud.
//
Процедура ЗадатьАудиторию(Знач Значение) Экспорт
	Аудитория = Значение;
КонецПроцедуры

// Аудитория, которую хаб ждёт в клейме aud.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОжидаемаяАудитория() Экспорт
	Возврат Аудитория;
КонецФункции

// Добавляет запись доверия в выдачу фейка.
//
// Параметры:
//  Идентификатор - Число - номер записи.
//  Провайдер - Строка - github либо gitlab.
//  Издатель - Строка - клейм iss записи.
//  Репозиторий - Строка - owner/repo либо group/project.
//  Конвейер - Строка - каноническое значение конвейера, "" — любой.
//  Реф - Строка - маска рефа.
//  Логин - Строка - логин автора записи; "" — учётка исчезла (необязательный,
//          по умолчанию "").
//  Создано - Дата - когда заведена (необязательный, по умолчанию 01.03.2026).
//
Функция Добавить(Знач Идентификатор, Знач Провайдер, Знач Издатель, Знач Репозиторий,
	Знач Конвейер, Знач Реф, Знач Логин = "", Знач Создано = Неопределено) Экспорт

	Запись = Новый Структура("Идентификатор, Провайдер, Издатель, Репозиторий, Конвейер, Реф, Создано",
		Идентификатор, Провайдер, Издатель, Репозиторий, Конвейер, Реф,
		?(Создано = Неопределено, Дата(2026, 3, 1), Создано));

	Автор = ?(ЗначениеЗаполнено(Логин), Новый Структура("Логин", Логин), Неопределено);
	Строки.Добавить(Новый Структура("Доверие, Автор", Запись, Автор));
	Возврат Запись;

КонецФункции

// Очищает выдачу.
Процедура Очистить() Экспорт
	Строки = Новый Массив();
КонецПроцедуры

// Доверенные конвейеры пакета вместе с автором записи.
//
// Параметры:
//  Пакет - Произвольный - не используется фейком.
//
// Возвращаемое значение:
//  Массив из Структура - Доверие, Автор.
//
Функция СтрокиПакета(Знач Пакет) Экспорт
	Возврат Строки;
КонецФункции

// Доверенные конвейеры пакета.
//
// Параметры:
//  Пакет - Произвольный - не используется фейком.
//
// Возвращаемое значение:
//  Массив - записи доверия.
//
Функция КонвейерыПакета(Знач Пакет) Экспорт

	Результат = Новый Массив();
	Для Каждого Строка_ Из Строки Цикл
		Результат.Добавить(Строка_.Доверие);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Человекочитаемое имя записи доверия — та же форма, что у боевого сервиса.
//
// Параметры:
//  Запись - Структура - запись доверия.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОписаниеЗаписи(Знач Запись) Экспорт
	Возврат Имена.Составить(Запись.Провайдер, Запись.Издатель, Запись.Репозиторий,
		Запись.Конвейер, Запись.Реф);
КонецФункции

// Провайдеры, которым хаб умеет доверять.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ДопустимыеПровайдеры() Экспорт
	Результат = Новый Массив();
	Результат.Добавить("github");
	Результат.Добавить("gitlab");
	Возврат Результат;
КонецФункции

// Каноническое значение провайдера «GitLab CI».
//
// Возвращаемое значение:
//  Строка.
//
Функция ПровайдерGitLab() Экспорт
	Возврат "gitlab";
КонецФункции

Процедура ПриСозданииОбъекта(Знач _Имена)
	Строки = Новый Массив();
	Аудитория = "";
	Имена = _Имена;
КонецПроцедуры
