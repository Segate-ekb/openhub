// Летопись журнала-заглушка: помнит, что записали, и сколько раз.

Перем Записи;

// Контракт ЛетописиАудита.
//
// Параметры:
//  Когда - Дата - момент операции.
//  Кто - Строка - принципал.
//  Действие - Строка - тип операции.
//  Объект - Строка - адрес объекта.
//  Субъект - Строка - адресат действия.
//  Детали - Строка - детали операции в JSON.
//  АдресIP - Строка - адрес источника.
//
Процедура Записать(Знач Когда, Знач Кто, Знач Действие, Знач Объект, Знач Субъект,
	Знач Детали, Знач АдресIP) Экспорт
	Записи.Добавить(Новый Структура("Объект, Субъект", Строка(Объект), Строка(Субъект)));
КонецПроцедуры

// Сколько строк записано.
//
// Возвращаемое значение:
//  Число.
//
Функция Количество() Экспорт
	Возврат Записи.Количество();
КонецФункции

// Адрес объекта последней записи.
//
// Возвращаемое значение:
//  Строка - пустая строка, если записей нет.
//
Функция ПоследнийОбъект() Экспорт
	Возврат ?(Записи.Количество() = 0, "", Записи[Записи.ВГраница()].Объект);
КонецФункции

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
КонецПроцедуры
