// Заглушка ответа winow: запоминает код состояния, заголовки и тело.

Перем Код Экспорт;
Перем Заголовки Экспорт;
Перем ТелоТекст Экспорт;
Перем Куки Экспорт;      // коллекция кук ответа: ей отвечает БезСессионнойКуки

// Устанавливает код состояния ответа.
//
// Параметры:
//  НовыйКод - Число - код HTTP.
//
Процедура УстановитьСостояние(Знач НовыйКод) Экспорт
	Код = НовыйКод;
КонецПроцедуры

// Устанавливает код состояния 200.
//
Процедура УстановитьСостояниеОК() Экспорт
	Код = 200;
КонецПроцедуры

// Устанавливает заголовок Content-Type.
//
// Параметры:
//  Тип - Строка - значение заголовка.
//
Процедура УстановитьТипКонтента(Знач Тип) Экспорт
	Заголовки["Content-Type"] = Тип;
КонецПроцедуры

Процедура ПриСозданииОбъекта() Экспорт
	Код = 0;
	Заголовки = Новый Соответствие();
	ТелоТекст = "";
	Куки = Неопределено;
КонецПроцедуры
