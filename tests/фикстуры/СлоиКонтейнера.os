// Подключение классов продукта в юнит-контейнер послойно, в порядке перечисления; слой — каталог
// src/модули.

Перем Классы;        // фикстура КлассыСлоя: через неё файл попадает в контейнер
Перем КореньМодулей;
Перем ПропускаемыеПрефиксы;

// Подключает классы перечисленных слоёв в порядке перечисления.
//
// Параметры:
//  СписокСлоёв - Строка - слои через запятую; вложенный каталог — через «/»
//                («состояние/телеметрия»).
//
Процедура Подключить(Знач СписокСлоёв) Экспорт

	Для Каждого Имя Из СтрРазделить(СписокСлоёв, ",") Цикл
		Если СокрЛП(Имя) = "основа" Тогда
			Классы.ПодключитьОснову(КореньМодулей); // с дверью обезличивания журнала
		Иначе
			ПодключитьКаталог(КаталогСлоя(СокрЛП(Имя)));
		КонецЕсли;
		Если СокрЛП(Имя) = "настройки" Тогда
			РеестрНастроекХаба.ПодключитьКлассы(Классы, КореньМодулей);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Подключает таблицы перечисленных модулей — сущности и их хранилища — без остальных
// классов модуля: слой целиком набору не нужен, а чужие таблицы нужны его службам.
//
// Параметры:
//  СписокМодулей - Строка - модули-хозяева таблиц через запятую.
//
Процедура ПодключитьТаблицы(Знач СписокМодулей) Экспорт
	Классы.ПодключитьТаблицы(КореньМодулей, СписокМодулей);
КонецПроцедуры

// Подключает реализации названных контрактов из всех модулей вместе с таблицами их модулей:
// контракт, собранный массивом, без них молча остаётся пустым.
//
// Параметры:
//  СписокКонтрактов - Строка - имена контрактов через запятую.
//
Процедура ПодключитьРеализации(Знач СписокКонтрактов) Экспорт
	Классы.ПодключитьРеализации(КореньМодулей, СписокКонтрактов);
КонецПроцедуры

// Добавляет префиксы к тем, чьи классы в контейнер не попадают. «Контроллер» пропускается
// всегда — ему нужен winow, которого в юнит-контейнере нет; названное здесь идёт СВЕРХ него,
// а не вместо: набор, попросивший пропустить «Рендерер», не должен молча получить контроллеры.
//
// Параметры:
//  Префиксы - Строка - префиксы имён через запятую.
//
Процедура ПропускатьТакже(Знач Префиксы) Экспорт

	Для Каждого Префикс Из СтрРазделить(Префиксы, ",") Цикл
		Если ЗначениеЗаполнено(СокрЛП(Префикс)) Тогда
			ПропускаемыеПрефиксы.Добавить(СокрЛП(Префикс));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция КаталогСлоя(Знач Имя)

	Части = СтрРазделить(Имя, "/");
	Каталог = ОбъединитьПути(КореньМодулей, Части[0], "Классы");

	Для Индекс = 1 По Части.ВГраница() Цикл
		Каталог = ОбъединитьПути(Каталог, Части[Индекс]);
	КонецЦикла;

	Возврат Каталог;

КонецФункции

Процедура ПодключитьКаталог(Знач Каталог)

	Для Каждого ФайлКласса Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
		Если НЕ Пропускается(ФайлКласса.ИмяБезРасширения) Тогда
			Классы.ПодключитьФайл(ФайлКласса.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция Пропускается(Знач ИмяКласса)

	Для Каждого Префикс Из ПропускаемыеПрефиксы Цикл
		Если СтрНачинаетсяС(ИмяКласса, Префикс) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ПриСозданииОбъекта(Знач ПоискКлассов, Знач КаталогМодулей)
	Классы = ПоискКлассов;
	КореньМодулей = КаталогМодулей;
	ПропускаемыеПрефиксы = Новый Массив();
	ПропускаемыеПрефиксы.Добавить("Контроллер");
КонецПроцедуры
