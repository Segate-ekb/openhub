// Подставной приёмник исходящих запросов хаба для живых стендов: свой порт до запроса, сырой запрос
// тесту. Не отвечает: набор однопоточный и ждёт ответа хаба, поэтому запрос забирается из очереди ОС
// уже после того, как хаб его отправил и бросил ждать по таймауту.

Перем Выдача;
Перем Сервер;
Перем НомерПорта;

#Область ЖизненныйЦикл

Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ВыдачаПортов");
	Выдача = Новый ВыдачаПортов();
	НомерПорта = 0;

КонецПроцедуры

// Занимает свободный порт и начинает слушать: соединение хаба ждёт приёма в очереди ОС.
//
// Возвращаемое значение:
//  Число - порт, на котором приёмник слушает.
//
Функция Слушать() Экспорт

	НомерПорта = Выдача.Выдать();
	Сервер = Новый TCPСервер(НомерПорта);
	Сервер.Запустить();

	Возврат НомерПорта;

КонецФункции

// Закрывает порт и возвращает его в оборот. Идемпотентна.
//
Процедура Остановить() Экспорт

	Если Сервер <> Неопределено Тогда
		Попытка
			Сервер.Остановить();
		Исключение
			// порт всё равно освободится вместе с процессом прогона
		КонецПопытки;
		Сервер = Неопределено;
	КонецЕсли;

	Выдача.ВернутьВсе();
	НомерПорта = 0;

КонецПроцедуры

#КонецОбласти

#Область ПриёмЗапроса

// Забирает одно соединение из очереди и читает его до конца: строка запроса, заголовки, тело.
//
// Параметры:
//  ТаймаутСек - Число - сколько ждать соединения (необязательный, по умолчанию 10).
//
// Возвращаемое значение:
//  Строка - запрос целиком; пустая строка — соединения не было.
//
Функция ПринятьЗапрос(Знач ТаймаутСек = 10) Экспорт

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСек * 1000;
	Соединение = Неопределено;
	Пока Соединение = Неопределено И ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Соединение = Сервер.ОжидатьСоединения(200);
	КонецЦикла;
	Если Соединение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Соединение.ТаймаутЧтения = 2000;
	Запрос = "";
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Кусок = Прочитать(Соединение);
		Если НЕ ЗначениеЗаполнено(Кусок) Тогда
			Прервать;
		КонецЕсли;
		Запрос = Запрос + Кусок;
	КонецЦикла;

	Попытка
		Соединение.Закрыть();
	Исключение
		// хаб мог закрыть соединение первым
	КонецПопытки;

	Возврат Запрос;

КонецФункции

#КонецОбласти

// Закрытое собеседником соединение и истёкший таймаут — конец запроса, а не сбой.
Функция Прочитать(Соединение)
	Попытка
		Возврат Соединение.ПрочитатьСтроку();
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции
