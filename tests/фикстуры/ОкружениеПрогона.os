// Окружение процесса набора, каким оно было до фикстур: снято один раз при загрузке библиотеки фикстур.

Перем Снимок; // Соответствие: имя переменной → значение на загрузке библиотеки

// Окружение дочернего процесса экземпляра — для шестого параметра СоздатьПроцесс(): дополняет окружение
// процесса набора. Переменные хаба (OSHUB_*, OTEL_*), которых экземпляр не задал, получают значение из
// снимка до фикстур, а заданные другими экземплярами — пустое: хаб и сидеры пустую переменную не читают.
//
// Параметры:
//  Свои - Соответствие - имя переменной → значение, заданные экземпляром.
//
// Возвращаемое значение:
//  Соответствие - новая карта: свои переменные экземпляра и погашенные чужие.
//
Функция ДляРебёнка(Знач Свои) Экспорт

	Карта = Новый Соответствие();

	Для Каждого Переменная Из ПеременныеСреды() Цикл
		Если ПеременнаяХаба(Переменная.Ключ) Тогда
			Карта.Вставить(Переменная.Ключ, ЗначениеДоФикстур(Переменная.Ключ));
		КонецЕсли;
	КонецЦикла;

	Для Каждого Переменная Из Снимок Цикл
		Если ПеременнаяХаба(Переменная.Ключ) Тогда
			Карта.Вставить(Переменная.Ключ, Переменная.Значение);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Переменная Из Свои Цикл
		Карта.Вставить(Переменная.Ключ, Строка(Переменная.Значение));
	КонецЦикла;

	Возврат Карта;

КонецФункции

// Значение переменной на загрузке библиотеки фикстур; пусто — переменной не было.
Функция ЗначениеДоФикстур(Знач Имя)

	Значение = Снимок.Получить(Имя);
	Возврат ?(Значение = Неопределено, "", Значение);

КонецФункции

Функция ПеременнаяХаба(Знач Имя)
	Возврат СтрНачинаетсяС(ВРег(Имя), "OSHUB_") ИЛИ СтрНачинаетсяС(ВРег(Имя), "OTEL_");
КонецФункции

Снимок = ПеременныеСреды();
