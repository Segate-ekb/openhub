// Маршруты хаба в настоящем маршрутизаторе winow. Контроллеры модулей читаются Рефлектором —
// тем же чтением аннотаций, каким их собирает сборщик маршрутов winow, — и ложатся в его
// Маршрутизатор. Поиск адреса отвечает ровно то, что увидел бы хаб на запросе, а свободный
// адрес — то, что увидел бы регистратор описания API на старте: занятость winow проверяет
// тем же поиском. Поднимать контейнер незачем: база, хранилище и порт маршрутам не нужны.

#Использовать annotations
#Использовать winow

Перем Маршрутизатор_;   // Маршрутизатор (winow)
Перем Контроллеров_;    // Число — сколько контроллеров разобрано
Перем НеПрочитанные_;   // Массив из Строка — файлы, не поддавшиеся разбору

#Область ПубличныйИнтерфейс

// Кто обслужил бы адрес.
//
// Параметры:
//  Путь - Строка - путь запроса от корня хаба.
//
// Возвращаемое значение:
//  Структура, Неопределено - Контроллер (Строка, имя класса), Метод (Строка); Неопределено —
//                            адрес не обслуживает ни один маршрут хаба.
//
Функция Обработчик(Знач Путь) Экспорт

	Найдено = Маршрутизатор_.НайтиОбработчикИПараметрыПоПолномуПути(Путь);
	Если НЕ ЗначениеЗаполнено(Найдено.Действие) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура("Контроллер, Метод", Найдено.Действие.Желудь, Найдено.Действие.ИмяМетода);

КонецФункции

// Полные пути всех маршрутов хаба в записи маршрутизатора: параметр — символ СимволПараметра().
//
// Возвращаемое значение:
//  Массив из Строка - пути маршрутов.
//
Функция Пути() Экспорт

	Результат = Новый Массив();
	Для Каждого Маршрут Из Маршрутизатор_.ПолучитьВсеМаршруты() Цикл
		Результат.Добавить(Маршрут.ПолныйПуть);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Как маршрутизатор записывает сегмент-параметр.
//
// Возвращаемое значение:
//  Строка - символ параметра winow.
//
Функция СимволПараметра() Экспорт
	Возврат Маршрутизатор_.СимволПараметраТочкиМаршрута();
КонецФункции

// Сколько контроллеров разобрано: слепой скан дал бы пустую таблицу и вечнозелёные проверки.
//
// Возвращаемое значение:
//  Число - число контроллеров.
//
Функция Контроллеров() Экспорт
	Возврат Контроллеров_;
КонецФункции

// Файлы, которые не удалось подключить: на их маршрутах проверки ослепли бы молча.
//
// Возвращаемое значение:
//  Массив из Строка - имя файла и причина.
//
Функция НеПрочитанные() Экспорт
	Возврат НеПрочитанные_;
КонецФункции

#КонецОбласти

#Область Сборка

Процедура ЗарегистрироватьКонтроллер(Знач Файл, Знач Рефлектор)

	Псевдоним = "МаршрутыХаба" + Файл.ИмяБезРасширения;
	Если НЕ ТипЕсть(Псевдоним) Тогда
		Попытка
			ПодключитьСценарий(Файл.ПолноеИмя, Псевдоним);
		Исключение
			НеПрочитанные_.Добавить(Файл.Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат;
		КонецПопытки;
	КонецЕсли;

	Методы = Рефлектор.ПолучитьТаблицуМетодов(Тип(Псевдоним));
	АдресКонтроллера = ЗначениеАннотации(Методы, "Контроллер");
	Если АдресКонтроллера = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Контроллеров_ = Контроллеров_ + 1;

	Для Каждого Метод Из РаботаСАннотациями.НайтиМетодыСАннотацией(Методы, "ТочкаМаршрута") Цикл
		Точка = РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
			РаботаСАннотациями.ПолучитьАннотацию(Метод, "ТочкаМаршрута"));
		Действие = Маршрутизатор_.ОписаниеТочкиМаршрута();
		Действие.Желудь = Файл.ИмяБезРасширения;
		Действие.ИмяМетода = Метод.Имя;
		Маршрутизатор_.ДобавитьМаршрут(ПутьМаршрута(АдресКонтроллера, Точка), Действие);
	КонецЦикла;

КонецПроцедуры

// Путь склеивается так же, как у сборщика маршрутов winow: ОбъединитьПути и сегмент-параметр
// под символом маршрутизатора.
Функция ПутьМаршрута(Знач АдресКонтроллера, Знач Точка)

	Сегменты = Новый Массив();
	Для Каждого Сегмент Из СтрРазделить(СтрЗаменить(Точка, "\", "/"), "/") Цикл
		ЭтоПараметр = СтрНачинаетсяС(Сегмент, "{") И СтрЗаканчиваетсяНа(Сегмент, "}");
		Сегменты.Добавить(?(ЭтоПараметр, СимволПараметра(), Сегмент));
	КонецЦикла;

	Возврат СтрЗаменить(ОбъединитьПути(АдресКонтроллера, СтрСоединить(Сегменты, "/")), "\", "/");

КонецФункции

Функция ЗначениеАннотации(Знач Методы, Знач ИмяАннотации)

	Для Каждого Метод Из РаботаСАннотациями.НайтиМетодыСАннотацией(Методы, ИмяАннотации) Цикл
		Возврат РаботаСАннотациями.ПолучитьЗначениеПараметраАннотации(
			РаботаСАннотациями.ПолучитьАннотацию(Метод, ИмяАннотации));
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Кандидат — исходник, где имя аннотации контроллера встречается хоть как-нибудь: лишний
// кандидат безвреден (рефлексия аннотацию не найдёт), пропущенный ослепил бы проверки.
Функция ФайлыКандидаты(Знач КаталогМодулей)

	Результат = Новый Массив();
	Для Каждого Файл Из НайтиФайлы(КаталогМодулей, "*.os", Истина) Цикл
		Если СтрНайти(НРег(ПрочитатьИсходник(Файл.ПолноеИмя)), "&контроллер") > 0 Тогда
			Результат.Добавить(Файл);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПрочитатьИсходник(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);
КонецФункции

Функция ТипЕсть(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

#КонецОбласти

// Собирает таблицу маршрутов по исходникам модулей.
//
// Параметры:
//  КаталогМодулей - Строка - каталог src/модули проекта.
//
Процедура ПриСозданииОбъекта(Знач КаталогМодулей) Экспорт

	Маршрутизатор_ = Новый Маршрутизатор(Новый Перечисления());
	Контроллеров_ = 0;
	НеПрочитанные_ = Новый Массив();

	Рефлектор = Новый Рефлектор();
	Для Каждого Файл Из ФайлыКандидаты(КаталогМодулей) Цикл
		ЗарегистрироватьКонтроллер(Файл, Рефлектор);
	КонецЦикла;

КонецПроцедуры
