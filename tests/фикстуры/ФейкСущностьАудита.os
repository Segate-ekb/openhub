// Носитель полей, которые ИмяОбъектаАудита читает у пула, пакета, учётки и группы.

Перем Идентификатор Экспорт;
Перем Имя Экспорт;
Перем ПулИдентификатор Экспорт;
Перем Логин Экспорт;

Процедура ПриСозданииОбъекта(Знач НовыйИдентификатор, Знач НовоеИмя = "", Знач НовыйПул = 0)
	Идентификатор = НовыйИдентификатор;
	Имя = НовоеИмя;
	ПулИдентификатор = НовыйПул;
	Логин = "";
КонецПроцедуры
