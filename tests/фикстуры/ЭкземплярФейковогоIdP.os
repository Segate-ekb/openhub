// Фикстура: жизненный цикл фейкового IdP в отдельном процессе — свободный порт,
// приметы провайдера окружением, запуск, ожидание готовности, гарантированная остановка.

Перем Выдача;
Перем Процесс;
Перем НомерПорта;
Перем КорневойКаталог;   // корень репозитория: от него запускается oscript
Перем ТаймаутСек;
Перем ИдентификаторКлиента;
Перем Субъект;
Перем Почта;
Перем Логин;
Перем ЖурналПрофиля;     // файл, в который IdP пишет отметку на каждый запрос userinfo
Перем Метка;             // FAKE_IDP_TEST_RUN: по ней внешняя чистка находит сироту

// Конструктор.
//
// Параметры:
//  ИдентификаторКлиентаIdP - Строка - client_id, который IdP кладёт в aud токена.
//  СубъектIdP - Строка - sub входящего человека.
//  ПочтаIdP - Строка - email входящего человека.
//  ТаймаутГотовностиСек - Число - сколько ждать первого ответа (необязательный,
//                         по умолчанию 60).
//  ЛогинIdP - Строка - preferred_username входящего человека (необязательный,
//             по умолчанию "" — IdP отдаёт клеймом сам субъект).
//
Процедура ПриСозданииОбъекта(Знач ИдентификаторКлиентаIdP, Знач СубъектIdP, Знач ПочтаIdP,
	Знач ТаймаутГотовностиСек = 60, Знач ЛогинIdP = "") Экспорт

	ИдентификаторКлиента = ИдентификаторКлиентаIdP;
	Субъект = СубъектIdP;
	Почта = ПочтаIdP;
	Логин = ЛогинIdP;
	ТаймаутСек = ТаймаутГотовностиСек;
	НомерПорта = 0;
	Метка = "фейковый-idp-" + Строка(Новый УникальныйИдентификатор());
	ЖурналПрофиля = ОбъединитьПути(КаталогВременныхФайлов(), Метка + "-userinfo.log");

	КаталогФикстур = Новый Файл(ТекущийСценарий().Источник).Путь;
	КорневойКаталог = Новый Файл(ОбъединитьПути(КаталогФикстур, "..", "..")).ПолноеИмя;

	РеестрФикстур.Подключить("ВыдачаПортов");

	Выдача = Новый ВыдачаПортов();

КонецПроцедуры

// Поднимает IdP и ждёт, пока он ответит документом обнаружения.
// При неудаче процесс убивается, порт возвращается в оборот, исключение пробрасывается.
//
Процедура Запустить() Экспорт

	НомерПорта = Выдача.Выдать();

	УстановитьПеременнуюСреды("FAKE_IDP_PORT", Формат(НомерПорта, "ЧГ=0; ЧН=0"));
	УстановитьПеременнуюСреды("FAKE_IDP_ISSUER", Издатель());
	УстановитьПеременнуюСреды("FAKE_IDP_CLIENT_ID", ИдентификаторКлиента);
	УстановитьПеременнуюСреды("FAKE_IDP_SUBJECT", Субъект);
	УстановитьПеременнуюСреды("FAKE_IDP_EMAIL", Почта);
	УстановитьПеременнуюСреды("FAKE_IDP_LOGIN", Логин);
	УстановитьПеременнуюСреды("FAKE_IDP_USERINFO_LOG", ЖурналПрофиля);
	УстановитьПеременнуюСреды("FAKE_IDP_TEST_RUN", Метка);

	Процесс = СоздатьПроцесс(СтрШаблон("oscript ""%1""", ТочкаВхода()), КорневойКаталог, Истина);
	Процесс.Запустить();

	Попытка
		ДождатьсяГотовности();
	Исключение
		Отказ = ОписаниеОшибки();
		ПортОтказа = НомерПорта;
		Диагностика = Вывод();
		Остановить();
		ВызватьИсключение СтрШаблон("Фейковый IdP не поднялся на порту %1: %2%3%4",
			ПортОтказа, Отказ, Символы.ПС, Диагностика);
	КонецПопытки;

КонецПроцедуры

// Останавливает IdP, снимает заявку на порт и чистит окружение. Идемпотентна.
//
Процедура Остановить() Экспорт

	// Завершить() возвращает управление раньше, чем ядро снимает процесс: не дождавшись
	// смерти, порт вернулся бы в оборот занятым, и следующий набор упал бы на bind.
	Попытка
		Если Процесс <> Неопределено И НЕ Процесс.Завершен Тогда
			Процесс.Завершить();
			Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 10 * 1000;
			Пока НЕ Процесс.Завершен И ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
				Приостановить(50);
			КонецЦикла;
		КонецЕсли;
	Исключение
		// процесс мог умереть между проверкой и вызовом — это нормально
	КонецПопытки;
	Процесс = Неопределено;

	Если НомерПорта > 0 Тогда
		Выдача.Вернуть(НомерПорта);
		НомерПорта = 0;
	КонецЕсли;

	Для Каждого Имя Из СтрРазделить("FAKE_IDP_PORT,FAKE_IDP_ISSUER,FAKE_IDP_CLIENT_ID,"
		+ "FAKE_IDP_SUBJECT,FAKE_IDP_EMAIL,FAKE_IDP_LOGIN,FAKE_IDP_USERINFO_LOG,"
		+ "FAKE_IDP_TEST_RUN", ",") Цикл
		Попытка
			УстановитьПеременнуюСреды(Имя, "");
		Исключение
		КонецПопытки;
	КонецЦикла;

	Попытка
		Если Новый Файл(ЖурналПрофиля).Существует() Тогда
			УдалитьФайлы(ЖурналПрофиля);
		КонецЕсли;
	Исключение
	КонецПопытки;

КонецПроцедуры

// Issuer этого экземпляра — он же значение OSHUB_OIDC_<ИД>_ISSUER для хаба.
//
// Возвращаемое значение:
//  Строка - базовый адрес IdP без завершающего слеша.
//
Функция Издатель() Экспорт
	Возврат "http://localhost:" + Формат(НомерПорта, "ЧГ=0; ЧН=0");
КонецФункции

// Метка прогона (значение FAKE_IDP_TEST_RUN): по ней внешняя чистка отбирает
// осиротевшие после SIGKILL процессы IdP.
//
// Возвращаемое значение:
//  Строка - метка прогона.
//
Функция МеткаПрогона() Экспорт
	Возврат Метка;
КонецФункции

// Номер порта работающего экземпляра.
//
// Возвращаемое значение:
//  Число - номер порта; 0 — экземпляр не запущен.
//
Функция Порт() Экспорт
	Возврат НомерПорта;
КонецФункции

// Сколько раз IdP отдавал userinfo. Профиль запрашивает сам хаб отдельным HTTP-запросом
// с токеном доступа, и по этому счётчику видно, дошёл ли вход до профиля или деградировал
// до клеймов id_token — снаружи эти два исхода различаются только этим.
//
// Возвращаемое значение:
//  Число - число обслуженных запросов userinfo; 0 — ни одного.
//
Функция ВызововПрофиля() Экспорт

	Попытка
		Если НЕ Новый Файл(ЖурналПрофиля).Существует() Тогда
			Возврат 0;
		КонецЕсли;
		Чтение = Новый ЧтениеТекста(ЖурналПрофиля, "UTF-8");
		Содержимое = Чтение.Прочитать();
		Чтение.Закрыть();
	Исключение
		Возврат 0;
	КонецПопытки;

	// СтрЧислоСтрок("") = 1, поэтому пустой файл считаем отдельно, а не «одной отметкой»
	Отметки = СокрЛП(?(Содержимое = Неопределено, "", Содержимое));
	Возврат ?(ПустаяСтрока(Отметки), 0, СтрЧислоСтрок(Отметки));

КонецФункции

// Накопленный вывод процесса — единственный источник диагностики при отказе старта.
//
// Возвращаемое значение:
//  Строка - вывод IdP либо пояснение, почему его нет.
//
Функция Вывод() Экспорт

	Если Процесс = Неопределено Тогда
		Возврат "процесс фейкового IdP уже остановлен";
	КонецЕсли;

	Попытка
		Возврат Процесс.ПотокВывода.Прочитать() + Процесс.ПотокОшибок.Прочитать();
	Исключение
		Возврат "вывод недоступен: " + ОписаниеОшибки();
	КонецПопытки;

КонецФункции

#Область Служебное

Функция ТочкаВхода()
	КаталогФикстур = Новый Файл(ТекущийСценарий().Источник).Путь;
	Возврат ОбъединитьПути(КаталогФикстур, "idp", "запуск.os");
КонецФункции

Процедура ДождатьсяГотовности()

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСек * 1000;
	ПоследняяОшибка = "";

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл

		Если Процесс.Завершен Тогда
			ВызватьИсключение СтрШаблон("процесс завершился до готовности, код %1",
				Процесс.КодВозврата);
		КонецЕсли;

		Попытка
			Соединение = Новый HTTPСоединение("localhost", НомерПорта, , , , 5);
			Если Соединение.Получить(Новый HTTPЗапрос(
				"/.well-known/openid-configuration")).КодСостояния = 200 Тогда
				Возврат;
			КонецЕсли;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
		КонецПопытки;

		Приостановить(300);

	КонецЦикла;

	ВызватьИсключение СтрШаблон("документ обнаружения не отдан за %1 сек (%2)",
		ТаймаутСек, ?(ЗначениеЗаполнено(ПоследняяОшибка), ПоследняяОшибка, "ответы не 200"));

КонецПроцедуры

#КонецОбласти
