// Хранилище внешних личностей в памяти, считающее ОБРАЩЕНИЯ. Считаются обе двери:
// «личности одного пользователя» — та, через которую растёт N+1, — и «личности списка».

Перем Личности;   // Массив из Структура (ПользовательИдентификатор, Издатель, Субъект)
Перем Счётчик;   // СчётчикОбращений — счёт обращений к фикстуре

// Сколько раз хранилище спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Привязывает внешнюю личность к учётке (наполнение фикстуры; за обращение не считается).
//
// Параметры:
//  ПользовательИдентификатор - Число - владелец личности.
//
// Возвращаемое значение:
//  Структура - записанная личность.
//
Функция Привязать(Знач ПользовательИдентификатор) Экспорт

	Ключ = Цел(ПользовательИдентификатор);
	Личность = Новый Структура("ПользовательИдентификатор, Издатель, Субъект",
		Ключ, "https://idp.example.test", "sub-" + Формат(Ключ, "ЧГ=0"));
	Личности.Добавить(Личность);
	Возврат Личность;

КонецФункции

// Личности одного пользователя; считает обращение.
//
// Параметры:
//  ПользовательИдентификатор - Число - владелец личностей.
//
// Возвращаемое значение:
//  Массив из Структура.
//
Функция ПолучитьПоПользовательИдентификаторРавно(Знач ПользовательИдентификатор) Экспорт

	Счётчик.Отметить();

	Список = Новый Массив();
	Список.Добавить(Цел(ПользовательИдентификатор));
	Возврат Отобрать(Список);

КонецФункции

// Личности списка пользователей; считает обращение.
//
// Параметры:
//  ПользовательИдентификаторы - Массив из Число - владельцы личностей.
//
// Возвращаемое значение:
//  Массив из Структура.
//
Функция ПолучитьПоПользовательИдентификаторВ(Знач ПользовательИдентификаторы) Экспорт

	Счётчик.Отметить();

	Список = Новый Массив();
	Для Каждого Идентификатор Из ПользовательИдентификаторы Цикл
		Список.Добавить(Цел(Идентификатор));
	КонецЦикла;
	Возврат Отобрать(Список);

КонецФункции

Функция Отобрать(Знач Идентификаторы)

	Результат = Новый Массив();
	Для Каждого Личность Из Личности Цикл
		Если Идентификаторы.Найти(Личность.ПользовательИдентификатор) <> Неопределено Тогда
			Результат.Добавить(Личность);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ПриСозданииОбъекта()
	Личности = Новый Массив();
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
