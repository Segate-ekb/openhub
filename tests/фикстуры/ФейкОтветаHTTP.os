// Двойник ответа 1connector: КодСостояния, Текст(), Json(). Столько, сколько читает
// oidc-client — больше он от ответа ничего не спрашивает.

Перем КодСостояния Экспорт;
Перем Тело_;

// Задаёт код и тело ответа.
//
// Параметры:
//  Код - Число - код состояния HTTP.
//  Тело - Строка - тело ответа.
//
Процедура Установить(Знач Код, Знач Тело) Экспорт
	КодСостояния = Код;
	Тело_ = ?(Тело = Неопределено, "", Строка(Тело));
КонецПроцедуры

// Тело ответа строкой.
//
// Возвращаемое значение:
//  Строка.
//
Функция Текст() Экспорт
	Возврат Тело_;
КонецФункции

// Тело ответа, разобранное как JSON; неразбираемое тело — исключение, как у 1connector.
//
// Возвращаемое значение:
//  Соответствие, Массив, Произвольный.
//
Функция Json() Экспорт

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Тело_);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

Процедура ПриСозданииОбъекта()
	КодСостояния = 200;
	Тело_ = "";
КонецПроцедуры
