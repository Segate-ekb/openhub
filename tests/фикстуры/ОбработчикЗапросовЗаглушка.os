// Заглушка обработчика запросов winow: отдаёт заранее собранный ответ, чем бы её
// ни позвали. Ответ отдаётся тем же объектом — тест смотрит, что с ним сделала обёртка.
// Умеет и не отдавать ничего: обёртке, которая ловит сбой, нужен падающий сосед.

Перем Ответ Экспорт;
Перем Сбой_;     // Строка — текст исключения; пусто — заглушка отдаёт ответ

// Отдаёт заранее заданный ответ либо бросает заданный сбой.
//
// Параметры:
//  Запрос - Произвольный - запрос winow; заглушка его не смотрит.
//
// Возвращаемое значение:
//  Произвольный - заданный конструктором ответ.
//
Функция СформироватьОтвет(Запрос) Экспорт // BSLLS:UnusedParameters-off

	Если ЗначениеЗаполнено(Сбой_) Тогда
		ВызватьИсключение Сбой_;
	КонецЕсли;

	Возврат Ответ;

КонецФункции

// Вместо ответа заглушка бросает исключение с этим текстом.
//
// Параметры:
//  Текст - Строка - текст исключения.
//
// Возвращаемое значение:
//  ОбработчикЗапросовЗаглушка - этот же объект.
//
Функция Падает(Знач Текст) Экспорт
	Сбой_ = Текст;
	Возврат ЭтотОбъект;
КонецФункции

// Готовит заглушку.
//
// Параметры:
//  ГотовыйОтвет - Произвольный - объект ответа с полем Заголовки.
//
Процедура ПриСозданииОбъекта(Знач ГотовыйОтвет) Экспорт
	Ответ = ГотовыйОтвет;
	Сбой_ = "";
КонецПроцедуры
