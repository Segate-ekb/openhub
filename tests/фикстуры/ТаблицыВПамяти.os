// Юнит-контейнер ОСени над таблицами названных модулей на базе в памяти: техника данных, основа,
// сущности и хранилища модулей — без их служб.

#Использовать autumn
#Использовать autumn-data
#Использовать entity

// Подключает таблицы модулей и поднимает над ними контейнер на базе в памяти.
//
// Параметры:
//  СписокМодулей - Строка - модули-хозяева таблиц через запятую.
//  ИмяБазы - Строка - строка соединения коннектора в памяти; своя у каждого набора.
//
// Возвращаемое значение:
//  Поделка - запущенный контейнер.
//
Функция Поднять(Знач СписокМодулей, Знач ИмяБазы) Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	Модули = КаталогиПроекта.Модули();

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "данные", "Классы"));
	ПоискКлассов.ПодключитьТаблицы(Модули, СписокМодулей);
	ПоискКлассов.ПодключитьОснову(Модули);

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", ИмяБазы);

	Детальки = Новый Соответствие();
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = СоветНабора.БезФайлаНастроек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();
	Возврат Поделка;

КонецФункции
