// Летопись происшествий — заглушка для наборов, которые судят ПИШУЩЕГО, а не летопись:
// помнит, что записали, что сняли и с чего начали прогон.
//
// ⚠ Обезличивания и обрезки причины здесь НЕТ — фраза хранится как дали, и секрет из неё
// не вычёркивается. Проверять на этой заглушке обезличивание нельзя: его держит настоящая
// ЛетописьПроисшествий, и стережёт его Происшествия_Тесты.

Перем Записи_;   // Массив из Структура (Подсистема, Объект, Предмет, Код, Причина, Прогон, Секрет)
Перем Снятые_;   // Массив из Структура (Подсистема, Объект)
Перем Прогоны_;  // Массив из Структура (Подсистема, Объект, Прогон)
Перем Часы_;     // подставленный источник времени; заглушка им не пользуется

#Область КонтрактЛетописи

// Контракт ЛетописьПроисшествий.
//
// Параметры:
//  Подсистема - Строка - «хранилище» | «зеркало» | «источник».
//  Объект - Строка - адрес объекта.
//  Предмет - Строка - «пакет@версия» либо пустая строка.
//  Код - Строка - машинный код причины.
//  Причина - Строка - фраза для человека.
//  Прогон - Строка - метка обхода (необязательный).
//  Секрет - Строка - значение, которого в причине быть не должно (необязательный).
//
Процедура Записать(Знач Подсистема, Знач Объект, Знач Предмет, Знач Код, Знач Причина,
	Знач Прогон = "", Знач Секрет = "") Экспорт

	Записи_.Добавить(Новый Структура("Подсистема, Объект, Предмет, Код, Причина, Прогон, Секрет",
		Строка(Подсистема), Строка(Объект), Строка(Предмет), Строка(Код),
		Строка(Причина), Строка(Прогон), Строка(Секрет)));

КонецПроцедуры

// Контракт ЛетописьПроисшествий.
//
// Параметры:
//  Подсистема - Строка - чьи происшествия снимаются.
//  Объект - Строка - адрес объекта.
//
Процедура Снять(Знач Подсистема, Знач Объект) Экспорт
	Снятые_.Добавить(Новый Структура("Подсистема, Объект", Строка(Подсистема), Строка(Объект)));
КонецПроцедуры

// Контракт ЛетописьПроисшествий.
//
// Параметры:
//  Подсистема - Строка - чей обход начался.
//  Объект - Строка - адрес объекта.
//  Прогон - Строка - метка начавшегося обхода.
//
Процедура НачатьПрогон(Знач Подсистема, Знач Объект, Знач Прогон) Экспорт

	Прогоны_.Добавить(Новый Структура("Подсистема, Объект, Прогон",
		Строка(Подсистема), Строка(Объект), Строка(Прогон)));

КонецПроцедуры

// Контракт ЛетописьПроисшествий: заглушке убирать нечего.
//
// Параметры:
//  Момент - Дата - «сейчас» вызывающего (необязательный).
//
// Возвращаемое значение:
//  Число.
//
Функция УбратьУстаревшие(Знач Момент = Неопределено) Экспорт
	Возврат 0;
КонецФункции

// Контракт ЛетописьПроисшествий: умолчание кода.
//
// Возвращаемое значение:
//  Число.
//
Функция ПотолокНаОбъект() Экспорт
	Возврат 50;
КонецФункции

// Контракт ЛетописьПроисшествий: умолчание кода.
//
// Возвращаемое значение:
//  Число.
//
Функция СрокЖизниСек() Экспорт
	Возврат 1209600;
КонецФункции

// Контракт ЛетописьПроисшествий: умолчание кода.
//
// Возвращаемое значение:
//  Число.
//
Функция ПределПричины() Экспорт
	Возврат 500;
КонецФункции

// Контракт ЛетописьПроисшествий: заглушка времени не спрашивает, шов принимается молча.
//
// Параметры:
//  ИсточникВремени - Произвольный - объект с методом Сейчас().
//
Процедура УстановитьЧасы(Знач ИсточникВремени) Экспорт
	Часы_ = ИсточникВремени;
КонецПроцедуры

#КонецОбласти

#Область ЧтоЗапомнила

// Всё записанное.
//
// Возвращаемое значение:
//  Массив из Структура - Подсистема, Объект, Предмет, Код, Причина, Прогон, Секрет.
//
Функция Записи() Экспорт
	Возврат Записи_;
КонецФункции

// Записи с названным кодом.
//
// Параметры:
//  Код - Строка - машинный код причины.
//
// Возвращаемое значение:
//  Массив из Структура.
//
Функция ПоКоду(Знач Код) Экспорт

	Результат = Новый Массив();
	Для Каждого Запись Из Записи_ Цикл
		Если Запись.Код = Строка(Код) Тогда
			Результат.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Снятия происшествий.
//
// Возвращаемое значение:
//  Массив из Структура - Подсистема, Объект.
//
Функция Снятые() Экспорт
	Возврат Снятые_;
КонецФункции

// Объявленные начала прогонов.
//
// Возвращаемое значение:
//  Массив из Структура - Подсистема, Объект, Прогон.
//
Функция Прогоны() Экспорт
	Возврат Прогоны_;
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	Записи_ = Новый Массив();
	Снятые_ = Новый Массив();
	Прогоны_ = Новый Массив();
	Часы_ = Неопределено;
КонецПроцедуры
