// Считающий читатель происшествий: отдаёт то же, что настоящий, и считает обращения к нему.
// Нужен там, где судится ЦЕНА экрана: одно чтение на весь список против чтения на строку.

Перем Настоящий;    // ЧитательПроисшествий либо Неопределено — тогда происшествий нет вовсе
Перем Обращений_;

#Область КонтрактЧитателя

// Контракт ЧитательПроисшествий.
//
// Параметры:
//  Подсистема - Строка - подсистема.
//  Объекты - Массив из Строка - адреса объектов.
//
// Возвращаемое значение:
//  Соответствие - адрес объекта → Массив из Структура.
//
Функция ПроисшествияОбъектов(Знач Подсистема, Знач Объекты) Экспорт

	Обращений_ = Обращений_ + 1;
	Если Настоящий = Неопределено Тогда
		Возврат Новый Соответствие();
	КонецЕсли;
	Возврат Настоящий.ПроисшествияОбъектов(Подсистема, Объекты);

КонецФункции

#КонецОбласти

// Сколько раз читателя спросили.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Обращений_;
КонецФункции

Процедура ПриСозданииОбъекта(Знач ЧитательПроисшествий = Неопределено)
	Настоящий = ЧитательПроисшествий;
	Обращений_ = 0;
КонецПроцедуры
