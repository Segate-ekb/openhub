// Хранилище привязок токенов к пулам в памяти, считающее ОБРАЩЕНИЯ. Считаются обе двери:
// «привязки одного токена» — та, через которую и растёт N+1, — и «привязки списка токенов».

Перем Привязки;    // Массив из Структура (ТокенИдентификатор, ПулИдентификатор)
Перем Счётчик;   // СчётчикОбращений — счёт обращений к фикстуре

// Сколько раз хранилище спросили с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Обращений() Экспорт
	Возврат Счётчик.Обращений();
КонецФункции

// Записывает привязку токена к пулу (наполнение фикстуры; за обращение не считается).
//
// Параметры:
//  ТокенИдентификатор - Число - идентификатор токена доступа.
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Структура - записанная привязка.
//
Функция Записать(Знач ТокенИдентификатор, Знач ПулИдентификатор) Экспорт

	Привязка = Новый Структура("ТокенИдентификатор, ПулИдентификатор",
		Цел(ТокенИдентификатор), Цел(ПулИдентификатор));
	Привязки.Добавить(Привязка);
	Возврат Привязка;

КонецФункции

// Привязки одного токена; считает обращение.
//
// Параметры:
//  ТокенИдентификатор - Число - идентификатор токена доступа.
//
// Возвращаемое значение:
//  Массив из Структура.
//
Функция ПривязкиТокена(Знач ТокенИдентификатор) Экспорт

	Счётчик.Отметить();

	Список = Новый Массив();
	Список.Добавить(Цел(ТокенИдентификатор));
	Возврат Отобрать(Список);

КонецФункции

// Привязки списка токенов; считает обращение.
//
// Параметры:
//  ТокенИдентификаторы - Массив из Число - идентификаторы токенов доступа.
//
// Возвращаемое значение:
//  Массив из Структура.
//
Функция ПривязкиТокенов(Знач ТокенИдентификаторы) Экспорт

	Счётчик.Отметить();

	Список = Новый Массив();
	Для Каждого Идентификатор Из ТокенИдентификаторы Цикл
		Список.Добавить(Цел(Идентификатор));
	КонецЦикла;
	Возврат Отобрать(Список);

КонецФункции

Функция Отобрать(Знач Идентификаторы)

	Результат = Новый Массив();
	Для Каждого Привязка Из Привязки Цикл
		Если Идентификаторы.Найти(Привязка.ТокенИдентификатор) <> Неопределено Тогда
			Результат.Добавить(Привязка);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ПриСозданииОбъекта()
	Привязки = Новый Массив();
	РеестрФикстур.Подключить("СчётчикОбращений");
	Счётчик = Новый СчётчикОбращений();
КонецПроцедуры
