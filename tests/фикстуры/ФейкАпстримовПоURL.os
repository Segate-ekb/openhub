// Фейк клиента апстримов по базовому URL: ответ задаётся на каждый URL, журнал хранит порядок
// обращений — по нему проверяется, что следующий апстрим не опрашивается после ответившего.
// Ответ можно задать и на конкретный ресурс базы — так различаются list.txt, страница пакета
// и артефакт одного и того же источника; журнал путей показывает, ЧТО именно спрашивали.

Перем ОтветыДанных;   // Соответствие: базовый URL -> Структура(Код, Данные, ETag)
Перем ОтветыТекста;   // Соответствие: базовый URL -> Структура(Код, Тело, ETag)
Перем ОтветыРесурсов; // Соответствие: базовый URL + "|" + путь -> Структура(Код, Тело, ETag)
Перем Журнал;         // Массив из Строка - базовые URL в порядке обращений
Перем ПутиОбращений;  // Массив из Строка - относительные пути в том же порядке
Перем Токены;         // Массив из Строка - токены обращений в том же порядке
Перем ЗадержкаМс;     // Число - эмуляция «лежачего» апстрима (таймаут соединения)

// Задаёт ответ апстрима на СкачатьДанные.
//
// Параметры:
//  БазовыйURL - Строка - базовый адрес апстрима.
//  Код - Число - HTTP-код ответа.
//  Данные - ДвоичныеДанные - тело ответа.
//  ETag - Строка - ETag ответа (необязательный, по умолчанию "").
//
Процедура ЗадатьДанные(Знач БазовыйURL, Знач Код, Знач Данные, Знач ETag = "") Экспорт
	ОтветыДанных.Вставить(Ключ(БазовыйURL), Новый Структура("Код, Данные, ETag, Пояснение", Код, Данные, ETag, ""));
КонецПроцедуры

// Задаёт ответ апстрима на ПолучитьТекст.
//
// Параметры:
//  БазовыйURL - Строка - базовый адрес апстрима.
//  Код - Число - HTTP-код ответа.
//  Тело - Строка - тело ответа.
//  ETag - Строка - ETag ответа (необязательный, по умолчанию "").
//
Процедура ЗадатьТекст(Знач БазовыйURL, Знач Код, Знач Тело, Знач ETag = "") Экспорт
	ОтветыТекста.Вставить(Ключ(БазовыйURL), Новый Структура("Код, Тело, ETag, Пояснение", Код, Тело, ETag, ""));
КонецПроцедуры

// Задаёт ответ апстрима на ПолучитьТекст КОНКРЕТНОГО ресурса: он старше ответа по базе,
// поэтому list.txt, страница пакета и перечень версий одного источника различимы.
//
// Параметры:
//  БазовыйURL - Строка - базовый адрес апстрима.
//  ОтносительныйПуть - Строка - путь ресурса относительно базы.
//  Код - Число - HTTP-код ответа.
//  Тело - Строка - тело ответа.
//  ETag - Строка - ETag ответа (необязательный, по умолчанию "").
//
Процедура ЗадатьРесурс(Знач БазовыйURL, Знач ОтносительныйПуть, Знач Код, Знач Тело, Знач ETag = "") Экспорт
	ОтветыРесурсов.Вставить(КлючРесурса(БазовыйURL, ОтносительныйПуть),
		Новый Структура("Код, Тело, ETag, Пояснение", Код, Тело, ETag, ""));
КонецПроцедуры

// Эмулирует медленный апстрим: каждое обращение «висит» заданное время.
//
// Параметры:
//  Миллисекунд - Число - задержка обращения; 0 — без задержки.
//
Процедура УстановитьЗадержку(Знач Миллисекунд) Экспорт
	ЗадержкаМс = Миллисекунд;
КонецПроцедуры

// Журнал обращений: базовые URL в порядке вызовов.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Обращения() Экспорт
	Возврат Журнал;
КонецФункции

// Число обращений к заданному апстриму.
//
// Параметры:
//  БазовыйURL - Строка - базовый адрес апстрима.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоОбращений(Знач БазовыйURL) Экспорт
	Искомый = Ключ(БазовыйURL);
	Счёт = 0;
	Для Каждого Запись Из Журнал Цикл
		Если Запись = Искомый Тогда
			Счёт = Счёт + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Счёт;
КонецФункции

// Очищает журнал обращений и снимает задержку; заданные ответы сохраняются.
Процедура СброситьЖурнал() Экспорт
	Журнал = Новый Массив();
	ПутиОбращений = Новый Массив();
	Токены = Новый Массив();
	ЗадержкаМс = 0;
КонецПроцедуры

// Относительные пути всех обращений в порядке вызова: ЧТО именно спрашивали у источника.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Пути() Экспорт
	Возврат ПутиОбращений;
КонецФункции

// Токены всех обращений в порядке вызова: с каким доступом клиент пошёл к источнику.
//
// Возвращаемое значение:
//  Массив из Строка - пустая строка означает анонимный запрос.
//
Функция ТокеныЗапросов() Экспорт
	Возврат Токены;
КонецФункции

// Контракт КлиентаАпстрима: ответ, заданный для этого базового URL; неизвестный URL — 404.
//
// Параметры:
//  БазовыйURL - Строка - базовый адрес апстрима.
//  ОтносительныйПуть - Строка - путь артефакта; фейком не используется.
//  УсловныйETag - Строка - ETag условного запроса (необязательный, по умолчанию "").
//  Токен - Строка - токен доступа к источнику; журналируется (необязательный,
//          по умолчанию "").
//
// Возвращаемое значение:
//  Структура (Код, Данные, ETag, Пояснение).
//
// BSLLS:UnusedParameters-off
Функция СкачатьДанные(Знач БазовыйURL, Знач ОтносительныйПуть, Знач УсловныйETag = "",
	Знач Токен = "") Экспорт

	ЗапомнитьОбращение(БазовыйURL, ОтносительныйПуть, Токен);
	Подождать();
	Ответ = ОтветыДанных.Получить(Ключ(БазовыйURL));
	Если Ответ = Неопределено Тогда
		Возврат Новый Структура("Код, Данные, ETag, Пояснение", 404, Неопределено, "", "");
	КонецЕсли;
	Возврат Новый Структура("Код, Данные, ETag, Пояснение", Ответ.Код, Ответ.Данные, Ответ.ETag, "");

КонецФункции

// Контракт КлиентаАпстрима: ответ, заданный для этого базового URL; неизвестный URL — 404.
//
// Параметры:
//  БазовыйURL - Строка - базовый адрес апстрима.
//  ОтносительныйПуть - Строка - путь ресурса; фейком не используется.
//  УсловныйETag - Строка - ETag условного запроса (необязательный, по умолчанию "").
//  Токен - Строка - токен доступа к источнику; журналируется (необязательный,
//          по умолчанию "").
//
// Возвращаемое значение:
//  Структура (Код, Тело, ETag, Пояснение).
//
Функция ПолучитьТекст(Знач БазовыйURL, Знач ОтносительныйПуть, Знач УсловныйETag = "",
	Знач Токен = "") Экспорт

	ЗапомнитьОбращение(БазовыйURL, ОтносительныйПуть, Токен);
	Подождать();
	Ответ = ОтветыРесурсов.Получить(КлючРесурса(БазовыйURL, ОтносительныйПуть));
	Если Ответ = Неопределено Тогда
		Ответ = ОтветыТекста.Получить(Ключ(БазовыйURL));
	КонецЕсли;
	Если Ответ = Неопределено Тогда
		Возврат Новый Структура("Код, Тело, ETag, Пояснение", 404, "", "", "");
	КонецЕсли;
	Возврат Новый Структура("Код, Тело, ETag, Пояснение", Ответ.Код, Ответ.Тело, Ответ.ETag, "");

КонецФункции

Процедура ЗапомнитьОбращение(Знач БазовыйURL, Знач ОтносительныйПуть, Знач Токен)
	Токены.Добавить(СокрЛП(Строка(Токен)));
	Журнал.Добавить(Ключ(БазовыйURL));
	ПутиОбращений.Добавить(СокрЛП(Строка(ОтносительныйПуть)));
КонецПроцедуры

Процедура Подождать()
	Если ЗначениеЗаполнено(ЗадержкаМс) Тогда
		Приостановить(ЗадержкаМс);
	КонецЕсли;
КонецПроцедуры

Функция Ключ(Знач БазовыйURL)
	Возврат НРег(СокрЛП(Строка(БазовыйURL)));
КонецФункции

Функция КлючРесурса(Знач БазовыйURL, Знач ОтносительныйПуть)
	Возврат Ключ(БазовыйURL) + "|" + НРег(СокрЛП(Строка(ОтносительныйПуть)));
КонецФункции

Процедура ПриСозданииОбъекта()
	ОтветыДанных = Новый Соответствие();
	ОтветыТекста = Новый Соответствие();
	ОтветыРесурсов = Новый Соответствие();
	Журнал = Новый Массив();
	ПутиОбращений = Новый Массив();
	Токены = Новый Массив();
	ЗадержкаМс = 0;
КонецПроцедуры
