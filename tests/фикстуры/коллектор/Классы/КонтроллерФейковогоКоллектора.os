// Фейковый OTLP-приёмник: три конечные точки спецификации OTLP/HTTP складывают тело
// запроса в файл своего сигнала. Разбирать OTLP не нужно — тест ищет в теле подстроку.

Перем КореньДампов;  // Строка - префикс пути файлов сигналов

#Область ТочкиМаршрута

// GET /ready — коллектор поднялся и слушает.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//
&ТочкаМаршрута("ready")
Процедура Готовность(Ответ) Экспорт
	ОтдатьПусто(Ответ);
КонецПроцедуры

// POST /v1/traces — партия спанов.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ТелоЗапроса - Строка - тело OTLP-запроса.
//
&ТочкаМаршрута("v1/traces")
Процедура Трассы(Ответ, ТелоЗапроса = "") Экспорт
	Принять("traces", ТелоЗапроса);
	ОтдатьПусто(Ответ);
КонецПроцедуры

// POST /v1/metrics — срез метрик.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ТелоЗапроса - Строка - тело OTLP-запроса.
//
&ТочкаМаршрута("v1/metrics")
Процедура Метрики(Ответ, ТелоЗапроса = "") Экспорт
	Принять("metrics", ТелоЗапроса);
	ОтдатьПусто(Ответ);
КонецПроцедуры

// POST /v1/logs — партия записей журнала.
//
// Параметры:
//  Ответ - ОтветСервера - ответ winow.
//  ТелоЗапроса - Строка - тело OTLP-запроса.
//
&ТочкаМаршрута("v1/logs")
Процедура Логи(Ответ, ТелоЗапроса = "") Экспорт
	Принять("logs", ТелоЗапроса);
	ОтдатьПусто(Ответ);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Принять(Знач Сигнал, Знач Тело)

	Попытка
		Запись = Новый ЗаписьТекста(ФайлСигнала(Сигнал), КодировкаТекста.UTF8, , Истина);
		Запись.ЗаписатьСтроку(Строка(Тело));
		Запись.Закрыть();
	Исключение
		// Приёмник существует ради теста: не записав партию, роняться незачем.
	КонецПопытки;

КонецПроцедуры

Функция ФайлСигнала(Знач Сигнал)
	Возврат КореньДампов + "-" + Сигнал + ".json";
КонецФункции

Процедура ОтдатьПусто(Ответ)

	Ответ.УстановитьСостояние(200);
	Ответ.Заголовки["Content-Type"] = "application/json";
	Ответ.ТелоТекст = "{}";

КонецПроцедуры

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта()

	КореньДампов = Строка(ПолучитьПеременнуюСреды("FAKE_OTLP_DUMP"));

КонецПроцедуры
