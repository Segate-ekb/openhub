// Фикстура: хранилище помех, у которого падает любое обращение. Так ведёт себя база,
// упавшая ровно в тот момент, когда хаб собрался объяснить неудачу.

// Контракт ХранилищаПомех.
//
// Параметры:
//  Подсистема - Строка.
//  Объект - Строка.
//
// Возвращаемое значение:
//  Массив - не возвращает: всегда исключение.
//
Функция ПоОбъекту(Знач Подсистема, Знач Объект) Экспорт
	ВызватьИсключение Сбой();
КонецФункции

// Контракт ХранилищаПомех.
//
// Параметры:
//  Подсистема - Строка.
//  Объект - Строка.
//  Прогон - Строка.
//
// Возвращаемое значение:
//  Массив - не возвращает: всегда исключение.
//
Функция ПоОбъектуИПрогону(Знач Подсистема, Знач Объект, Знач Прогон) Экспорт
	ВызватьИсключение Сбой();
КонецФункции

// Контракт ХранилищаПомех.
//
// Параметры:
//  Момент - Дата.
//
// Возвращаемое значение:
//  Массив - не возвращает: всегда исключение.
//
Функция СтарееЧем(Знач Момент) Экспорт
	ВызватьИсключение Сбой();
КонецФункции

// Контракт ХранилищаПомех.
//
// Возвращаемое значение:
//  Помеха - не возвращает: всегда исключение.
//
Функция СоздатьЭлемент() Экспорт
	ВызватьИсключение Сбой();
КонецФункции

// Контракт ХранилищаПомех.
//
// Параметры:
//  Запись - Произвольный - строка таблицы.
//
Процедура Удалить(Знач Запись) Экспорт
	ВызватьИсключение Сбой();
КонецПроцедуры

Функция Сбой()
	Возврат "Таблица «Помехи» недоступна: соединение с базой потеряно";
КонецФункции
