// Фикстура: корпус сканов слоя представления — классы названных модулей проекта и установленного
// кита, то есть ровно тот код, который печатает экраны хаба.

Перем Поиск;          // КлассыСлоя — обход каталогов классов
Перем КореньПроекта;  // Строка
Перем Модули;         // Массив из Строка — модули проекта в корпусе
Перем Минимум;        // Число — меньше файлов в корпусе быть не может, иначе скан ослеп

#Область ПубличныйИнтерфейс

// Файлы корпуса. Пропавший каталог модуля или поредевший корпус — исключение: скан,
// зеленеющий на пустоте, выглядел бы как «нарушений нет».
//
// Возвращаемое значение:
//  Соответствие - "модуль/Файл.os" -> полное имя; файлы кита — под именем ИмяКита().
//
Функция Файлы() Экспорт

	Результат = Новый Соответствие();

	Для Каждого Модуль Из Модули Цикл
		ДобавитьФайлыМодуля(Результат, Модуль, КаталогКлассовМодуля(Модуль));
	КонецЦикла;
	ДобавитьФайлыМодуля(Результат, ИмяКита(), КаталогКлассовКита());

	Если Результат.Количество() < Минимум Тогда
		ВызватьИсключение СтрШаблон("Корпус слоя представления (%1) — %2 файлов при минимуме %3:"
			+ " скан ослеп. Проверьте состав модулей и раскладку по каталогам.",
			СтрСоединить(Модули, ", "), Результат.Количество(), Минимум);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Файл класса корпуса по имени: ищется во всех модулях корпуса и в ките, а не в одном
// зашитом каталоге, — переезд класса обращений не ломает.
//
// Параметры:
//  ИмяКласса - Строка - имя класса без расширения.
//
// Возвращаемое значение:
//  Строка - полное имя файла; не найден или найден дважды — исключение.
//
Функция ФайлКласса(Знач ИмяКласса) Экспорт

	Корни = Новый Массив();
	Для Каждого Модуль Из Модули Цикл
		Корни.Добавить(КаталогКлассовМодуля(Модуль));
	КонецЦикла;
	Корни.Добавить(КаталогКлассовКита());

	Найденные = Новый Массив();
	Для Каждого Каталог Из Корни Цикл
		Для Каждого Файл Из НайтиФайлы(Каталог, ИмяКласса + ".os", Истина) Цикл
			Если Файл.ЭтоФайл() Тогда
				Найденные.Добавить(Файл.ПолноеИмя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Найденные.Количество() <> 1 Тогда
		ВызватьИсключение СтрШаблон("Класс %1 в корпусе слоя представления найден %2 раз: %3",
			ИмяКласса, Найденные.Количество(), СтрСоединить(Найденные, ", "));
	КонецЕсли;

	Возврат Найденные[0];

КонецФункции

// Ключи списка исключений, файлов которых в корпусе нет: файл переименован или снят,
// а исключение осталось.
//
// Параметры:
//  Исключения - Соответствие - "модуль/Файл.os" -> причина.
//  Файлы - Соответствие - файлы корпуса (см. Файлы).
//
// Возвращаемое значение:
//  Массив из Строка - потерянные ключи.
//
Функция НетВКорпусе(Знач Исключения, Знач Файлы) Экспорт

	Результат = Новый Массив();
	Для Каждого КиЗ Из Исключения Цикл
		Если Файлы.Получить(КиЗ.Ключ) = Неопределено Тогда
			Результат.Добавить(КиЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Имя, под которым файлы кита стоят в ключах корпуса.
//
// Возвращаемое значение:
//  Строка - "кит".
//
Функция ИмяКита() Экспорт
	Возврат "кит";
КонецФункции

// Собирает ключи словаря из вызовов резолвера «.Текст("…")» и «.Шаблон("…")». Узлы кита
// называются так же, но делают другое — литерал в них текст экрана, а не ключ.
//
// Параметры:
//  Результат - Соответствие - ключ -> файл, где он встретился первым; пополняется.
//  Текст - Строка - исходник без комментариев.
//  Маркер - Строка - начало вызова вместе с кавычкой: ".Текст(""" или ".Шаблон(""".
//  ИмяФайла - Строка - чем назвать источник ключа.
//
Процедура ДобавитьКлючиВызова(Результат, Знач Текст, Знач Маркер, Знач ИмяФайла) Экспорт

	Хвост = Текст;
	Позиция = СтрНайти(Хвост, Маркер);

	Пока Позиция > 0 Цикл
		Получатель = Лев(Хвост, Позиция - 1);
		Хвост = Сред(Хвост, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Хвост, """");
		Если Конец > 1 И НЕ ЭтоУзелКита(Получатель) Тогда
			Ключ = Лев(Хвост, Конец - 1);
			Если Результат.Получить(Ключ) = Неопределено Тогда
				Результат.Вставить(Ключ, ИмяФайла);
			КонецЕсли;
		КонецЕсли;
		Позиция = СтрНайти(Хвост, Маркер);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьФайлыМодуля(Результат, Знач Модуль, Знач Каталог)

	Для Каждого Файл Из Поиск.ФайлыКлассов(Каталог) Цикл
		Ключ = Модуль + "/" + Файл.Имя;
		Если Результат.Получить(Ключ) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон("Два класса с именем %1 в модуле %2 (%3 и %4): имена типов"
				+ " глобальны, подкаталог пространства имён не создаёт.",
				Файл.Имя, Модуль, Результат[Ключ], Файл.ПолноеИмя);
		КонецЕсли;
		Результат.Вставить(Ключ, Файл.ПолноеИмя);
	КонецЦикла;

КонецПроцедуры

Функция КаталогКлассовМодуля(Знач Модуль)
	Возврат ОбъединитьПути(ОбъединитьПути(КореньПроекта, "src", "модули"), Модуль, "Классы");
КонецФункции

// Сканы читают УСТАНОВЛЕННЫЙ кит — тот код, который исполняет хаб.
Функция КаталогКлассовКита()

	Каталог = ОбъединитьПути(ОбъединитьПути(КореньПроекта, "oscript_modules"), "oscript-ui", "src", "Классы");
	Если НЕ Новый Файл(Каталог).Существует() Тогда
		ВызватьИсключение СтрШаблон("Кит не установлен: каталога %1 нет. Без него сканы слоя"
			+ " считают мёртвыми правила и ключи, которые печатает он.", Каталог);
	КонецЕсли;
	Возврат Каталог;

КонецФункции

Функция ЭтоУзелКита(Знач Получатель)
	Возврат Прав(СокрП(Получатель), 3) = "Кит";
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач СписокМодулей, Знач МинимумФайлов)

	РеестрФикстур.Подключить("КлассыСлоя");
	Поиск = Новый КлассыСлоя();
	КореньПроекта = КаталогиПроекта.Корень();
	Минимум = МинимумФайлов;

	Модули = Новый Массив();
	Для Каждого Модуль Из СтрРазделить(СписокМодулей, ",", Ложь) Цикл
		Модули.Добавить(СокрЛП(Модуль));
	КонецЦикла;

КонецПроцедуры
