// Фикстура: репозиторий агрегатов скачиваний поверх настоящего, у которого витрину
// спрашивают посреди записи — после того, как строка готова, и до того, как она сохранена.

Перем Настоящие;  // ЗапросыСкачиванийАгрегатов (данные)
Перем Служба;     // СлужбаСтатистикиСкачиваний (статистика), Неопределено — не спрашивать
Перем Пакет;      // Число - о каком пакете спрашивать витрину
Перем Увидено_;   // Массив из Число - что витрина ответила посреди записей

// Назначает, кого и о каком пакете спрашивать посреди каждой записи.
//
// Параметры:
//  _Служба - СлужбаСтатистикиСкачиваний.
//  _Пакет - Число.
//
Процедура СмотретьПосредиЗаписи(Знач _Служба, Знач _Пакет) Экспорт
	Служба = _Служба;
	Пакет = _Пакет;
КонецПроцедуры

// Что витрина ответила посреди записей, по порядку записей.
//
// Возвращаемое значение:
//  Массив из Число.
//
Функция Увидено() Экспорт
	Возврат Увидено_;
КонецФункции

// Вызывается строкой перед её сохранением.
//
Процедура ПередЗаписью() Экспорт
	Если Служба <> Неопределено Тогда
		Увидено_.Добавить(Служба.СкачиванийПакета(Пакет));
	КонецЕсли;
КонецПроцедуры

#Область КонтрактРепозитория

// Контракт ЗапросыСкачиванийАгрегатов.
//
// Параметры:
//  ПакетИдентификатор - Число.
//  ВерсияИдентификатор - Число.
//  ДатаДень - Дата.
//
// Возвращаемое значение:
//  СтрокаАгрегатаПодНаблюдением, Неопределено.
//
Функция ПолучитьОдноПоПакетИдентификаторРавноИВерсияИдентификаторРавноИДатаДеньРавно(
	Знач ПакетИдентификатор, Знач ВерсияИдентификатор, Знач ДатаДень) Экспорт

	Строка = Настоящие.ПолучитьОдноПоПакетИдентификаторРавноИВерсияИдентификаторРавноИДатаДеньРавно(
		ПакетИдентификатор, ВерсияИдентификатор, ДатаДень);
	Возврат ?(Строка = Неопределено, Неопределено, Новый СтрокаАгрегатаПодНаблюдением(Строка, ЭтотОбъект));

КонецФункции

// Контракт ЗапросыСкачиванийАгрегатов.
//
// Возвращаемое значение:
//  СтрокаАгрегатаПодНаблюдением.
//
Функция СоздатьЭлемент() Экспорт
	Возврат Новый СтрокаАгрегатаПодНаблюдением(Настоящие.СоздатьЭлемент(), ЭтотОбъект);
КонецФункции

// Контракт репозитория autumn-data: чтение для подсчётов в памяти.
//
// Параметры:
//  Опции - ОпцииПоиска, Неопределено.
//
// Возвращаемое значение:
//  Массив из СкачиваниеАгрегат.
//
Функция Получить(Знач Опции = Неопределено) Экспорт
	Возврат Настоящие.Получить(Опции);
КонецФункции

// Контракт репозитория autumn-data: модель сущности.
//
// Возвращаемое значение:
//  ОбъектМодели.
//
Функция ПолучитьОбъектМодели() Экспорт
	Возврат Настоящие.ПолучитьОбъектМодели();
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач _Настоящие)
	Настоящие = _Настоящие;
	Служба = Неопределено;
	Пакет = 0;
	Увидено_ = Новый Массив();
КонецПроцедуры
