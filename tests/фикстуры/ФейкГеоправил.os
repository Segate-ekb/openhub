// Фейк ГеоправилаПровайдера: какие провайдеры закрыты правилом по стране, задаёт тест.
// Нужен наборам, которым важен ВЕРДИКТ по правилу, а не его хранение.

Перем Правила;  // Соответствие: имя провайдера (НРег) -> Строка кодов через запятую

// Контракт ГеоправилаПровайдера: правило провайдера.
//
// Параметры:
//  ИмяПровайдера - Строка - имя провайдера; регистр не значим.
//
// Возвращаемое значение:
//  Структура - Есть (Булево), Страны (Массив из Строка), Текстом (Строка).
//
Функция Правило(Знач ИмяПровайдера) Экспорт

	Страны = Правила.Получить(НРег(СокрЛП(Строка(ИмяПровайдера))));
	Есть = (Страны <> Неопределено);

	Возврат Новый Структура("Есть, Страны, Текстом", Есть,
		?(Есть, СтрРазделить(Страны, ",", Ложь), Новый Массив()), ?(Есть, Страны, ""));

КонецФункции

// Закрывает провайдера в названных странах.
//
// Параметры:
//  ИмяПровайдера - Строка - имя провайдера.
//  Страны - Строка - коды стран через запятую.
//
Процедура Закрыть(Знач ИмяПровайдера, Знач Страны) Экспорт
	Правила.Вставить(НРег(СокрЛП(Строка(ИмяПровайдера))), Страны);
КонецПроцедуры

Процедура ПриСозданииОбъекта()
	Правила = Новый Соответствие();
КонецПроцедуры
