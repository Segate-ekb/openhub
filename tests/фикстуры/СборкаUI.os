// Ручная сборка графа компонентов рендера web-ui для юнит-тестов. Кит приезжает
// библиотекой: его классы регистрирует директива, резолвить их по файлам под src/ нечем.

#Использовать oscript-ui

Перем Классы;
Перем Поиск;   // КлассыСлоя — resolver файла класса по имени (рекурсивно по подкаталогам)

// Собирает граф компонентов рендера web-ui и сам рендерер.
//
// Параметры:
//  КаталогКлассов - Строка - путь к каталогу классов слоя web-ui.
//
// Возвращаемое значение:
//  Структура - компоненты слоя, словарь текстов, оформление, рендереры и витрина.
//
Функция Собрать(Знач КаталогКлассов) Экспорт

	Корни = Корни(КаталогКлассов);

	Для Каждого Имя Из Классы Цикл
		Подключить(Корни, Имя);
	КонецЦикла;

	Экран = Новый ЭкранированиеHTML();
	Модели = Новый ЧтениеМодели();
	Словарь = Новый СловарьТекстов();
	Тексты = Новый ТекстыИнтерфейса(Словарь);
	Поставка = Новый СтатикаХаба();
	Место = Новый РаскладкаСтатики(Поставка);
	Отпечатки = Новый ОтпечаткиСтатики(Место);
	Активы = Новый АктивыСтатики(Место, Отпечатки);
	Адреса = Новый АдресаСтатики(Активы, Поставка, Место);
	ЧтениеГлифов = Новый ЧтениеГлифа();
	Иконки = Новый НаборИконок(Место, ЧтениеГлифов);
	Значки = Новый Иконка(Экран, Иконки, Модели);
	ЗначкиПодписей = Новый ЗначкиМеты();
	РядыМеты = Новый РядМеты(Экран, Модели, Значки);

	Карточки = Новый Карточка(Экран, Модели, Значки);
	Поля = Новый ПолеФормы(Экран, Модели);
	ПоляКонфига = Новый ПолеИзКонфига(Экран, Модели, Поля, Значки);
	Таблицы = Новый Таблица(Экран, Модели);
	Тосты = Новый Тост(Экран, Модели, Значки);
	Плашки = Новый Плашка(Экран, Модели, Значки);
	Деревья = Новый ДеревоРазделов(Экран, Модели, Значки);
	Тумблеры = Новый Тумблер(Экран, Модели);
	Проводники = Новый Проводник(Экран, Модели, Значки);

	Кнопки = Новый Кнопка(Экран, Модели, Значки);
	Панели = Новый ПанельСохранения(Экран, Модели, Кнопки);
	Вкладки = Новый Табы(Экран, Модели, Значки);
	Пустоты = Новый ПустоеСостояние(Экран, Модели, Значки, Кнопки);
	Зоны = Новый ОпаснаяЗона(Экран, Модели, Значки, Поля, Кнопки);
	Команды = Новый БлокКоманды(Экран, Модели, Значки);
	Шапки = Новый ШапкаОбъекта(Экран, Модели, Значки, Плашки, Команды, РядыМеты);
	Страницы = Новый Пагинация(Экран, Модели, Значки);
	Плитки = Новый Плитка(Экран, Модели, Значки);
	Сетки = Новый Сетка(Экран, Модели);
	ЗначкиСостоянияВерсии = Новый ЗначкиВерсии(Плашки, Тексты);

	ПоляСкрытые = Новый СкрытоеПоле(Экран, Модели);
	Заглавия = Новый ЗаголовокСтраницы(Экран, Модели);
	СтраницыОшибок = Новый СтраницаОшибки(Модели, Заглавия);
	ФормыОтбора = Новый ФормаОтбора(Экран, Модели, Поля, Кнопки, ПоляСкрытые);
	Полосы = Новый ПолосаЗаполнения(Экран, Модели);
	Менюшки = Новый Меню(Экран, Модели, Кнопки);
	МенюИнсталляции = Новый МенюХаба(Экран, Модели, Кнопки, Тексты);

	Набор = Новый НаборКомпонентов(Карточки, Поля, ПоляКонфига, Таблицы, Тосты,
		Плашки, Деревья, Панели, Значки, Тумблеры, Проводники,
		Кнопки, Вкладки, Пустоты, Зоны, Команды, Шапки, Страницы,
		Плитки, Сетки, ПоляСкрытые, Заглавия, СтраницыОшибок, ФормыОтбора,
		Полосы, Менюшки, МенюИнсталляции, РядыМеты);

	АдресаКаталога_ = Новый АдресаКаталога();
	АдресаКабинета_ = Новый АдресаКабинета();
	Токены = Новый ТокеныТемы();
	// граф рендера без прикладных настроек: оформление хаба без СервисНастроек отдаёт
	// пустые тему и акцент, но своё имя cookie — живое. Живые значения темы проверяются
	// там, где настройки есть
	Оформление = Новый ВыборОформления(Новый ОформлениеХаба(Неопределено));
	Бренд = Новый Брендирование(Неопределено);

	РендерерНастроек = Новый РендерерНастроек(Экран, Модели, Набор, Тексты);
	ПроверкиПолей = Новый ПроверкаПоля(Тексты);
	ЗначенияФорм = Новый ЗначенияФормы();
	РазметкаУзлов = Новый РазметкаЭлементов(Экран);
	ПечатиФорм = Новый ПечатьФормы(Экран, Набор, Модели, РазметкаУзлов);
	Формы_ = Новый Формы(Модели, ПроверкиПолей, ЗначенияФорм, ПечатиФорм, РендерерНастроек);
	КитЭлементов = Новый Кит(РазметкаУзлов, Набор, РендерерНастроек);

	// витрина исполняет исходники своих образцов, поэтому берёт те же желуди, что и экран
	Образцы = Новый СборкаОбразцов();
	Витрина = Новый ВитринаКита(Набор, КитЭлементов, Формы_, РендерерНастроек, РазметкаУзлов,
		Новый ОбразцыСтраницы(Образцы), Новый ОбразцыВвода(Образцы),
		Новый ОбразцыПоказа(Образцы), Новый ОбразцыХолста(Образцы));

	// корень страницы принадлежит киту, а чем хаб её обрамляет — контракту ОбрамлениеИнсталляции
	Подсветка = Новый ПодсветкаТекущейДороги();
	Обрамление = Новый ОбрамлениеХаба(Бренд, Адреса, Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()), Тексты,
		АдресаКаталога_, Новый ВозвратПослеВхода(), АдресаКабинета_, КитЭлементов, Подсветка);
	Каркас = Новый КаркасСтраницы(КитЭлементов, Токены, Оформление, Тексты, Модели,
		Активы, Обрамление, МенюИнсталляции);

	// доменная сборка стоит НА ките, поэтому собирается после него
	КарточкиПакетов = Новый КарточкаПакета(КитЭлементов, Модели, ЗначкиПодписей);
	СтилиТегов = Новый СтильТега();
	ЗначкиТегов = Новый ЗначокТега();
	ОформленияТегов = Новый ОформлениеТега(СтилиТегов, ЗначкиТегов);
	ПлашкиТегов = Новый ПлашкаТега(КитЭлементов, ОформленияТегов, ЗначкиТегов, Тексты, Модели);

	Результат = Новый Структура();
	Результат.Вставить("Экран", Экран);
	Результат.Вставить("СловарьТекстов", Словарь);
	Результат.Вставить("Тексты", Тексты);
	Результат.Вставить("Модели", Модели);
	Результат.Вставить("НаборИконок", Иконки);
	Результат.Вставить("ЧтениеГлифа", ЧтениеГлифов);
	Результат.Вставить("ЗначкиМеты", ЗначкиПодписей);
	Результат.Вставить("РядМеты", РядыМеты);
	Результат.Вставить("Иконка", Значки);
	Результат.Вставить("Карточка", Карточки);
	Результат.Вставить("Поле", Поля);
	Результат.Вставить("ПолеИзКонфига", ПоляКонфига);
	Результат.Вставить("Таблица", Таблицы);
	Результат.Вставить("Тост", Тосты);
	Результат.Вставить("Плашка", Плашки);
	Результат.Вставить("ДеревоРазделов", Деревья);
	Результат.Вставить("ПанельСохранения", Панели);
	Результат.Вставить("Тумблер", Тумблеры);
	Результат.Вставить("Проводник", Проводники);
	Результат.Вставить("Кнопка", Кнопки);
	Результат.Вставить("Табы", Вкладки);
	Результат.Вставить("ПустоеСостояние", Пустоты);
	Результат.Вставить("ОпаснаяЗона", Зоны);
	Результат.Вставить("БлокКоманды", Команды);
	Результат.Вставить("ШапкаОбъекта", Шапки);
	Результат.Вставить("КарточкаПакета", КарточкиПакетов);
	Результат.Вставить("Пагинация", Страницы);
	Результат.Вставить("Плитка", Плитки);
	Результат.Вставить("Сетка", Сетки);
	Результат.Вставить("ПлашкаТега", ПлашкиТегов);
	Результат.Вставить("ОформлениеТега", ОформленияТегов);
	Результат.Вставить("ЗначкиВерсии", ЗначкиСостоянияВерсии);
	Результат.Вставить("СкрытоеПоле", ПоляСкрытые);
	Результат.Вставить("ЗаголовокСтраницы", Заглавия);
	Результат.Вставить("СтраницаОшибки", СтраницыОшибок);
	Результат.Вставить("ФормаОтбора", ФормыОтбора);
	Результат.Вставить("ПолосаЗаполнения", Полосы);
	Результат.Вставить("Меню", Менюшки);
	Результат.Вставить("МенюХаба", МенюИнсталляции);
	Результат.Вставить("Набор", Набор);
	Результат.Вставить("АдресаКаталога", АдресаКаталога_);
	Результат.Вставить("АдресаКабинета", АдресаКабинета_);
	Результат.Вставить("Токены", Токены);
	Результат.Вставить("Активы", Активы);
	Результат.Вставить("Место", Место);
	Результат.Вставить("Адреса", Адреса);
	Результат.Вставить("Поставка", Поставка);
	Результат.Вставить("Отпечатки", Отпечатки);
	Результат.Вставить("Оформление", Оформление);
	Результат.Вставить("Бренд", Бренд);
	Результат.Вставить("Подсветка", Подсветка);
	Результат.Вставить("Обрамление", Обрамление);
	Результат.Вставить("Каркас", Каркас);
	Результат.Вставить("РендерерНастроек", РендерерНастроек);
	Результат.Вставить("ПроверкаПоля", ПроверкиПолей);
	Результат.Вставить("ПечатьФормы", ПечатиФорм);
	Результат.Вставить("ЗначенияФормы", ЗначенияФорм);
	Результат.Вставить("Формы", Формы_);
	Результат.Вставить("Витрина", Витрина);
	Результат.Вставить("РазметкаЭлементов", РазметкаУзлов);
	Результат.Вставить("Кит", КитЭлементов);

	Возврат Результат;

КонецФункции

// Корни поиска классов: интерфейс хаба — в переданном, общее — рядом. Кита среди корней
// нет: его классы приехали библиотекой и уже зарегистрированы директивой.
Функция Корни(Знач КаталогКлассов)

	Модули = Новый Файл(Новый Файл(КаталогКлассов).Путь).Путь;

	Результат = Новый Массив();
	Результат.Добавить(КаталогКлассов);
	// общий модуль: рендерер берёт из него политику перехода — она одна на <meta> и заголовок
	Результат.Добавить(ОбъединитьПути(Модули, "основа", "Классы"));
	// расформирование common развело его классы по хозяевам: статика инсталляции уехала
	// к брендовым активам, отбор адреса возврата — к сессиям входа
	Результат.Добавить(ОбъединитьПути(Модули, "настройки", "Классы"));
	Результат.Добавить(ОбъединитьПути(Модули, "вход", "Классы"));
	// домен: плашка тега переводит ХРАНИМЫЕ ключи стиля и значка, а их словари живут там
	Результат.Добавить(ОбъединитьПути(Модули, "реестр", "Классы"));
	Возврат Результат;

КонецФункции

// Путь к файлу класса ищет resolver КлассыСлоя: классы разложены по подкаталогам.
Процедура Подключить(Знач Корни, Знач ИмяКласса)

	Для Каждого Корень Из Корни Цикл
		Если НайтиФайлы(Корень, ИмяКласса + ".os", Истина).Количество() > 0 Тогда
			Поиск.Подключить(Корень, ИмяКласса);
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение СтрШаблон("Класс %1 не найден ни в одном корне слоя: %2",
		ИмяКласса, СтрСоединить(Корни, ", "));

КонецПроцедуры

Процедура ПриСозданииОбъекта()

	РеестрФикстур.Подключить("КлассыСлоя");
	Поиск = Новый КлассыСлоя();

	// только классы ПРОЕКТА: китовые приезжают библиотекой
	Классы = Новый Массив();
	Классы.Добавить("СловарьТекстов");
	Классы.Добавить("СтатикаХаба");
	Классы.Добавить("АдресаСтатики");
	Классы.Добавить("ЗначкиМеты");
	Классы.Добавить("ЗначкиВерсии");
	Классы.Добавить("КарточкаПакета");
	Классы.Добавить("СтильТега");
	Классы.Добавить("ЗначокТега");
	Классы.Добавить("ОформлениеТега");
	Классы.Добавить("ПлашкаТега");
	Классы.Добавить("АдресаКаталога");
	Классы.Добавить("АдресаКабинета");
	Классы.Добавить("ОформлениеХаба");
	Классы.Добавить("Брендирование");
	Классы.Добавить("ЗаголовкиHTTP");
	Классы.Добавить("ЗаголовкиКэша");
	Классы.Добавить("ПодсветкаТекущейДороги");
	Классы.Добавить("ОбрамлениеХаба");
	Классы.Добавить("ВозвратПослеВхода");

КонецПроцедуры
