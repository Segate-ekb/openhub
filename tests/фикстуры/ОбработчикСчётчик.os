// Обработчик-счётчик для тестов планировщика: контракт os-scheduler, считает вызовы.

Перем Вызовов_;

// Контракт обработчика os-scheduler: засчитывает вызов.
Процедура Исполнить() Экспорт
	Вызовов_ = Вызовов_ + 1;
КонецПроцедуры

// Число вызовов Исполнить.
//
// Возвращаемое значение:
//  Число.
//
Функция Вызовов() Экспорт
	Возврат Вызовов_;
КонецФункции

Процедура ПриСозданииОбъекта()
	Вызовов_ = 0;
КонецПроцедуры
