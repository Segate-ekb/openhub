// ХранилищеВерсийПакета в памяти, считающее ОБРАЩЕНИЯ и ПРОЧИТАННЫЕ СТРОКИ. Страница
// пакета читала список версий трижды за запрос — счётчик строк ловит это там, где счётчик
// запросов молчит: три запроса по N строк и один по N отличаются только объёмом.

Перем Записи;      // Массив из Структура — строки версий
Перем СчётСтрок;
Перем СчётЗапросов;

#Область Счётчики

// Сколько строк версий хранилище отдало с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Строк() Экспорт
	Возврат СчётСтрок;
КонецФункции

// Сколько запросов к хранилищу ушло с момента создания.
//
// Возвращаемое значение:
//  Число.
//
Функция Запросов() Экспорт
	Возврат СчётЗапросов;
КонецФункции

// Обнуляет счётчики, оставляя фактуру: замер считает цену ОДНОГО запроса страницы.
Процедура Обнулить() Экспорт
	СчётСтрок = 0;
	СчётЗапросов = 0;
КонецПроцедуры

#КонецОбласти

#Область НаполнениеФикстуры

// Заводит версию (за обращение не считается).
//
// Параметры:
//  Идентификатор - Число - идентификатор версии.
//  ПакетИдентификатор - Число - идентификатор пакета.
//  Версия - Строка - строка версии.
//  Мажор - Число - semver-мажор.
//  Минор - Число - semver-минор.
//  Патч - Число - semver-патч.
//  Момент - Дата - публикация и изменение строки (необязательный, по умолчанию
//           '20260101120000').
//
Процедура Добавить(Знач Идентификатор, Знач ПакетИдентификатор, Знач Версия,
	Знач Мажор, Знач Минор, Знач Патч, Знач Момент = '20260101120000') Экспорт

	Строка_ = Новый Структура();
	Строка_.Вставить("Идентификатор", Цел(Идентификатор));
	Строка_.Вставить("ПакетИдентификатор", Цел(ПакетИдентификатор));
	Строка_.Вставить("Версия", Версия);
	Строка_.Вставить("SemverМажор", Мажор);
	Строка_.Вставить("SemverМинор", Минор);
	Строка_.Вставить("SemverПатч", Патч);
	Строка_.Вставить("SemverПререлиз", "");
	Строка_.Вставить("SemverСборка", "");
	Строка_.Вставить("ПризнакLegacyВерсии", Ложь);
	Строка_.Вставить("ПризнакВнеПорядка", Ложь);
	Строка_.Вставить("Размер", 1024);
	Строка_.Вставить("Sha256", "abcdef0123456789");
	Строка_.Вставить("АвторМанифеста", "alice");
	Строка_.Вставить("Отозвана", Ложь);
	Строка_.Вставить("ОпубликовалИдентификатор", 1);
	Строка_.Вставить("Опубликована", Момент);
	Строка_.Вставить("Изменена", Момент);
	Строка_.Вставить("ПутьВХранилище", "");
	Строка_.Вставить("ВерсияДвижка", "");
	Записи.Добавить(Строка_);

КонецПроцедуры

#КонецОбласти

#Область КонтрактХранилища

// Все версии пакета.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив - версии пакета.
//
Функция ПолучитьПоПакетИдентификаторРавно(Знач ПакетИдентификатор) Экспорт
	Возврат Отдать(ПоПакету(ПакетИдентификатор));
КонецФункции

// Действующие версии пакета.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Массив - неотозванные версии пакета.
//
Функция ДействующиеВерсии(Знач ПакетИдентификатор) Экспорт

	Отобранные = Новый Массив();
	Для Каждого Строка_ Из ПоПакету(ПакетИдентификатор) Цикл
		Если Строка_.Отозвана <> Истина Тогда
			Отобранные.Добавить(Строка_);
		КонецЕсли;
	КонецЦикла;
	Возврат Отдать(Отобранные);

КонецФункции

// Версия по идентификатору.
//
// Параметры:
//  Идентификатор - Число - идентификатор версии.
//
// Возвращаемое значение:
//  Структура, Неопределено - найденная версия.
//
Функция ПолучитьОдноПоИдентификаторРавно(Знач Идентификатор) Экспорт

	СчётЗапросов = СчётЗапросов + 1;
	Для Каждого Строка_ Из Записи Цикл
		Если Строка_.Идентификатор = Цел(Идентификатор) Тогда
			СчётСтрок = СчётСтрок + 1;
			Возврат Строка_;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Версии перечисленных идентификаторов одним отбором.
//
// Параметры:
//  Идентификаторы - Массив из Число - идентификаторы версий.
//
// Возвращаемое значение:
//  Массив - найденные версии.
//
Функция ВерсииПоИдентификаторам(Знач Идентификаторы) Экспорт

	Нужные = Множество(Идентификаторы);
	Отобранные = Новый Массив();
	Для Каждого Строка_ Из Записи Цикл
		Если Нужные.Получить(Строка_.Идентификатор) = Истина Тогда
			Отобранные.Добавить(Строка_);
		КонецЕсли;
	КонецЦикла;
	Возврат Отдать(Отобранные);

КонецФункции

// Версии перечисленных пакетов одним отбором.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//
// Возвращаемое значение:
//  Массив - версии всех перечисленных пакетов.
//
Функция ВерсииПакетов(Знач ПакетИдентификаторы) Экспорт
	Возврат Отдать(ПоПакетам(ПакетИдентификаторы));
КонецФункции

// Версии перечисленных пакетов, тронутые не раньше момента.
//
// Параметры:
//  ПакетИдентификаторы - Массив из Число - идентификаторы пакетов.
//  Момент - Дата - нижняя граница включительно; незаполненная означает «все версии».
//
// Возвращаемое значение:
//  Массив - версии-кандидаты.
//
Функция ТронутыеПосле(Знач ПакетИдентификаторы, Знач Момент) Экспорт

	Если НЕ ЗначениеЗаполнено(Момент) Тогда
		Возврат Отдать(ПоПакетам(ПакетИдентификаторы));
	КонецЕсли;

	Отобранные = Новый Массив();
	Для Каждого Строка_ Из ПоПакетам(ПакетИдентификаторы) Цикл
		Если Строка_.Изменена >= Момент ИЛИ Строка_.Опубликована >= Момент Тогда
			Отобранные.Добавить(Строка_);
		КонецЕсли;
	КонецЦикла;
	Возврат Отдать(Отобранные);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПоПакету(Знач ПакетИдентификатор)

	Отобранные = Новый Массив();
	Для Каждого Строка_ Из Записи Цикл
		Если Строка_.ПакетИдентификатор = Цел(ПакетИдентификатор) Тогда
			Отобранные.Добавить(Строка_);
		КонецЕсли;
	КонецЦикла;
	Возврат Отобранные;

КонецФункции

Функция ПоПакетам(Знач ПакетИдентификаторы)

	Нужные = Множество(ПакетИдентификаторы);
	Отобранные = Новый Массив();
	Для Каждого Строка_ Из Записи Цикл
		Если Нужные.Получить(Строка_.ПакетИдентификатор) = Истина Тогда
			Отобранные.Добавить(Строка_);
		КонецЕсли;
	КонецЦикла;
	Возврат Отобранные;

КонецФункции

Функция Множество(Знач Номера)

	Нужные = Новый Соответствие();
	Для Каждого Номер Из Номера Цикл
		Нужные.Вставить(Цел(Номер), Истина);
	КонецЦикла;
	Возврат Нужные;

КонецФункции

Функция Отдать(Знач Строки)

	СчётЗапросов = СчётЗапросов + 1;
	СчётСтрок = СчётСтрок + Строки.Количество();
	Возврат Строки;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	СчётСтрок = 0;
	СчётЗапросов = 0;
КонецПроцедуры
