// Наблюдатель за идущим прогоном зеркала: на заданном по счёту скачивании снимает состояние
// прогона и, если попросили, пробует запустить синк того же зеркала повторно.

Перем Прогон_;
Перем ЗеркалоЗапись;
Перем НаКаком;
Перем Снятое;
Перем Синхронизатор;
Перем ИтогПовтора;

// Контракт наблюдателя ФейкаИсточникаЗеркала.
//
// Параметры:
//  Номер - Число - порядковый номер скачивания в цикле.
//
Процедура ПриСкачивании(Знач Номер) Экспорт

	Если Номер <> НаКаком Тогда
		Возврат;
	КонецЕсли;
	Снятое = Прогон_.Состояние(ЗеркалоЗапись.Идентификатор);
	Если Синхронизатор <> Неопределено Тогда
		ИтогПовтора = Синхронизатор.Синхронизировать(ЗеркалоЗапись);
	КонецЕсли;

КонецПроцедуры

// Просит наблюдателя дёрнуть повторный синк того же зеркала прямо посреди цикла.
//
// Параметры:
//  Движок - СинхронизаторЗеркал - движок, которым пробовать повторный запуск.
//
Процедура ПробоватьПовторныйЗапуск(Знач Движок) Экспорт
	Синхронизатор = Движок;
КонецПроцедуры

// Состояние прогона, снятое ПОСРЕДИ цикла.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если наблюдателя так и не позвали.
//
Функция Состояние() Экспорт
	Возврат Снятое;
КонецФункции

// Итог повторного запуска, сделанного посреди цикла.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если повторный запуск не просили.
//
Функция ИтогПовторногоЗапуска() Экспорт
	Возврат ИтогПовтора;
КонецФункции

Процедура ПриСозданииОбъекта(Знач Прогон, Знач Зеркало, Знач НомерСкачивания)
	Прогон_ = Прогон;
	ЗеркалоЗапись = Зеркало;
	НаКаком = НомерСкачивания;
	Снятое = Неопределено;
	Синхронизатор = Неопределено;
	ИтогПовтора = Неопределено;
КонецПроцедуры
