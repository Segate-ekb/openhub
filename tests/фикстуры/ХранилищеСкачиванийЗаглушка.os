// Фикстура ХранилищеСкачиванийАгрегатов: дописывание — чтение, пауза и запись, как у базы
// без атомарного инкремента. Помнит, сколько дописываний шло разом, умеет держать их
// у закрытых ворот, придерживать уже записанными и отказывать. Суммы версий пакета
// держит кэшем, как кэш «скачиванияВерсий», — до ЗабытьСуммыВерсийПакета.

Перем Суммы;           // Соответствие: пакет -> Число
Перем СуммыВерсий;     // Соответствие: версия -> Структура(Пакет, Количество)
Перем КэшВерсий;       // Соответствие: пакет -> ФиксированноеСоответствие сумм его версий
Перем Замок;           // БлокировкаРесурса — охраняет поля фикстуры, но не окно дописывания
Перем Идёт;            // Число - дописываний внутри прямо сейчас
Перем НаибольшеРазом_; // Число
Перем Начато_;         // Число - дописываний, вошедших в хранилище
Перем Завершено_;      // Число - дописываний, дошедших до записи
Перем Пропустить;      // Число - сколько дописываний пройдёт, прежде чем начнутся отказы
Перем Отказов;         // Число - сколько дописываний после пропущенных бросят
Перем ПаузаМс;         // Число - окно между чтением и записью
Перем ДержатьМс;       // Число - окно между записью и сменой поколения
Перем ВоротаОткрыты;   // Булево
Перем ЖдатьВоротМс;    // Число - сколько дописывание стоит у закрытых ворот, прежде чем пройти
Перем Забыто_;         // Соответствие: пакет -> сколько раз забыты его суммы версий

#Область Управление

// Растягивает окно между чтением строки и её записью.
//
// Параметры:
//  Миллисекунд - Число.
//
Процедура РастянутьДописывание(Знач Миллисекунд) Экспорт
	ПаузаМс = Миллисекунд;
КонецПроцедуры

// Придерживает конец дописывания: строка уже записана, а поколение ещё прежнее.
//
// Параметры:
//  Миллисекунд - Число.
//
Процедура ПридержатьЗавершение(Знач Миллисекунд) Экспорт
	ДержатьМс = Миллисекунд;
КонецПроцедуры

// Закрывает ворота: дописывание ждёт их открытия, но не дольше заданного.
//
// Параметры:
//  НеДольшеМс - Число - через сколько дописывание пройдёт само.
//
Процедура ЗакрытьВорота(Знач НеДольшеМс) Экспорт
	ЖдатьВоротМс = НеДольшеМс;
	ВоротаОткрыты = Ложь;
КонецПроцедуры

// Открывает ворота.
//
Процедура ОткрытьВорота() Экспорт
	ВоротаОткрыты = Истина;
КонецПроцедуры

// Назначает отказы: первые Пройдёт дописываний проходят, следующие Откажет бросают.
//
// Параметры:
//  Пройдёт - Число.
//  Откажет - Число.
//
Процедура Отказывать(Знач Пройдёт, Знач Откажет) Экспорт
	Пропустить = Пройдёт;
	Отказов = Откажет;
КонецПроцедуры

#КонецОбласти

#Область Наблюдение

// Больше всего дописываний, шедших одновременно.
//
// Возвращаемое значение:
//  Число.
//
Функция НаибольшеРазом() Экспорт
	Возврат НаибольшеРазом_;
КонецФункции

// Сколько дописываний вошло в хранилище, включая сорвавшиеся и ждущие ворот.
//
// Возвращаемое значение:
//  Число.
//
Функция Начато() Экспорт
	Возврат Начато_;
КонецФункции

// Сколько дописываний дошло до записи.
//
// Возвращаемое значение:
//  Число.
//
Функция Завершено() Экспорт
	Возврат Завершено_;
КонецФункции

// Сколько раз забыты суммы версий пакета.
//
// Параметры:
//  Пакет - Число.
//
// Возвращаемое значение:
//  Число.
//
Функция Забыто(Знач Пакет) Экспорт
	Замок.Заблокировать();
	Раз = Забыто_.Получить(Цел(Пакет));
	Замок.Разблокировать();
	Возврат ?(Раз = Неопределено, 0, Раз);
КонецФункции

// Сколько скачиваний пакета записано.
//
// Параметры:
//  Пакет - Число.
//
// Возвращаемое значение:
//  Число.
//
Функция СуммаПоПакету(Знач Пакет) Экспорт
	Возврат Прочитать(Пакет);
КонецФункции

#КонецОбласти

#Область КонтрактХранилища

// Контракт ХранилищеСкачиванийАгрегатов: меняется на каждой записи.
//
// Возвращаемое значение:
//  Число.
//
Функция Поколение() Экспорт
	Возврат Завершено_;
КонецФункции

// Контракт ХранилищеСкачиванийАгрегатов: дописывает скачивания пакета.
//
// Параметры:
//  Пакет - Число.
//  Версия - Число.
//  ДатаДень - Дата.
//  Количество - Число.
//
Процедура Накопить(Знач Пакет, Знач Версия, Знач ДатаДень, Знач Количество) Экспорт

	Войти();
	Попытка
		ДождатьсяВорот();
		Было = Прочитать(Пакет);
		Если ПаузаМс > 0 Тогда
			Приостановить(ПаузаМс);
		КонецЕсли;
		Записать(Пакет, Было + Количество);
		ЗаписатьВерсию(Пакет, Версия, Количество);
		Если ДержатьМс > 0 Тогда
			Приостановить(ДержатьМс);
		КонецЕсли;
	Исключение
		Выйти(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	Выйти(Истина);

КонецПроцедуры

// Контракт ХранилищеСкачиванийАгрегатов: забывает скачивания версий пакета и считает,
// сколько раз его забыли.
//
// Параметры:
//  Пакет - Число.
//
Процедура ЗабытьСуммыВерсийПакета(Знач Пакет) Экспорт
	Замок.Заблокировать();
	Раз = Забыто_.Получить(Цел(Пакет));
	Забыто_.Вставить(Цел(Пакет), ?(Раз = Неопределено, 0, Раз) + 1);
	КэшВерсий.Удалить(Цел(Пакет));
	Замок.Разблокировать();
КонецПроцедуры

// Контракт ХранилищеСкачиванийАгрегатов: суммы версий пакета из кэша. Прочитанное первым
// фикстура отдаёт до ЗабытьСуммыВерсийПакета, как бы ни менялась база.
//
// Параметры:
//  Пакет - Число.
//
// Возвращаемое значение:
//  ФиксированноеСоответствие - версия -> Число; версий без записей в нём нет.
//
Функция СуммыВерсийПакета(Знач Пакет) Экспорт

	Замок.Заблокировать();
	Кэш = КэшВерсий.Получить(Цел(Пакет));
	Если Кэш = Неопределено Тогда
		Названные = Новый Массив();
		Названные.Добавить(Пакет);
		Кэш = Новый ФиксированноеСоответствие(ВерсииПакетов(Названные));
		КэшВерсий.Вставить(Цел(Пакет), Кэш);
	КонецЕсли;
	Замок.Разблокировать();

	Возврат Кэш;

КонецФункции

// Контракт ХранилищеСкачиванийАгрегатов: суммы версий названных пакетов, мимо кэша.
//
// Параметры:
//  Пакеты - Массив из Число.
//
// Возвращаемое значение:
//  Соответствие - версия -> Число.
//
Функция СуммыВерсийПакетов(Знач Пакеты) Экспорт
	Замок.Заблокировать();
	Результат = ВерсииПакетов(Пакеты);
	Замок.Разблокировать();
	Возврат Результат;
КонецФункции

// Контракт ХранилищеСкачиванийАгрегатов: суммы названных пакетов.
//
// Параметры:
//  Пакеты - Массив из Число.
//
// Возвращаемое значение:
//  Соответствие - пакет -> Число; пакетов без записей в нём нет.
//
Функция СуммыПакетов(Знач Пакеты) Экспорт

	Результат = Новый Соответствие();
	Для Каждого Пакет Из Пакеты Цикл
		Сумма = Прочитать(Пакет);
		Если Сумма <> 0 Тогда
			Результат.Вставить(Цел(Пакет), Сумма);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Контракт ХранилищеСкачиванийАгрегатов: суммы всех пакетов.
//
// Возвращаемое значение:
//  Соответствие - пакет -> Число.
//
Функция СуммыПоПакетам() Экспорт

	Замок.Заблокировать();
	Результат = Новый Соответствие();
	Для Каждого КиЗ Из Суммы Цикл
		Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Замок.Разблокировать();

	Возврат Результат;

КонецФункции

// Контракт ХранилищеСкачиванийАгрегатов: сумма по хабу.
//
// Возвращаемое значение:
//  Число.
//
Функция СуммаПоХабу() Экспорт

	Замок.Заблокировать();
	Итог = 0;
	Для Каждого КиЗ Из Суммы Цикл
		Итог = Итог + КиЗ.Значение;
	КонецЦикла;
	Замок.Разблокировать();

	Возврат Итог;

КонецФункции

#КонецОбласти

#Область Служебное

Процедура Войти()

	Замок.Заблокировать();
	Начато_ = Начато_ + 1;
	Идёт = Идёт + 1;
	НаибольшеРазом_ = Макс(НаибольшеРазом_, Идёт);
	Если Пропустить > 0 Тогда
		Пропустить = Пропустить - 1;
		Отказать = Ложь;
	Иначе
		Отказать = Отказов > 0;
		Отказов = ?(Отказать, Отказов - 1, Отказов);
	КонецЕсли;
	Замок.Разблокировать();

	Если Отказать Тогда
		Выйти(Ложь);
		ВызватьИсключение "ХранилищеСкачиванийЗаглушка: намеренный отказ записи";
	КонецЕсли;

КонецПроцедуры

Процедура Выйти(Знач Записано)
	Замок.Заблокировать();
	Идёт = Идёт - 1;
	Завершено_ = Завершено_ + ?(Записано, 1, 0);
	Замок.Разблокировать();
КонецПроцедуры

Процедура ДождатьсяВорот()
	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ЖдатьВоротМс;
	Пока НЕ ВоротаОткрыты И ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Приостановить(10);
	КонецЦикла;
КонецПроцедуры

Функция Прочитать(Знач Пакет)
	Замок.Заблокировать();
	Сумма = Суммы.Получить(Цел(Пакет));
	Замок.Разблокировать();
	Возврат ?(Сумма = Неопределено, 0, Сумма);
КонецФункции

Процедура Записать(Знач Пакет, Знач Сумма)
	Замок.Заблокировать();
	Суммы.Вставить(Цел(Пакет), Сумма);
	Замок.Разблокировать();
КонецПроцедуры

Процедура ЗаписатьВерсию(Знач Пакет, Знач Версия, Знач Количество)
	Замок.Заблокировать();
	Было = СуммыВерсий.Получить(Цел(Версия));
	СуммыВерсий.Вставить(Цел(Версия), Новый Структура("Пакет, Количество", Цел(Пакет),
		?(Было = Неопределено, 0, Было.Количество) + Количество));
	Замок.Разблокировать();
КонецПроцедуры

// Зовётся под замком фикстуры.
Функция ВерсииПакетов(Знач Пакеты)

	Названные = Новый Соответствие();
	Для Каждого Пакет Из Пакеты Цикл
		Названные.Вставить(Цел(Пакет), Истина);
	КонецЦикла;

	Результат = Новый Соответствие();
	Для Каждого КиЗ Из СуммыВерсий Цикл
		Если Названные.Получить(КиЗ.Значение.Пакет) <> Неопределено Тогда
			Результат.Вставить(КиЗ.Ключ, КиЗ.Значение.Количество);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()

	Суммы = Новый Соответствие();
	Замок = Новый БлокировкаРесурса(ЭтотОбъект);
	Идёт = 0;
	НаибольшеРазом_ = 0;
	Начато_ = 0;
	Завершено_ = 0;
	Пропустить = 0;
	Отказов = 0;
	ПаузаМс = 0;
	ДержатьМс = 0;
	ВоротаОткрыты = Истина;
	ЖдатьВоротМс = 0;
	Забыто_ = Новый Соответствие();
	СуммыВерсий = Новый Соответствие();
	КэшВерсий = Новый Соответствие();

КонецПроцедуры
