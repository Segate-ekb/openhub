// Фикстура: реестр настроек, как у живого хаба; общий модуль — состояние одно на процесс. Ключи модуля
// приезжают вслед за его классами (КлассыСлоя.ПодключитьФайл), ключи всех — по просьбе сторожа полноты.

Перем Объявления;       // фикстура ОбъявленияПредметов — после ПодключитьКлассы
Перем Поиск_;           // КлассыСлоя, которым подключаются ключи вслед за классами
Перем КореньМодулей_;
Перем ТронутыеМодули;   // Соответствие: модуль, чей класс уже в процессе, → Истина
Перем КлючиСледуют;     // Булево: реестр подключён, и ключи едут за классами

// Подключает реестр настроек: юнит-контейнер ОСени соберёт его из объявлений ключей тех
// модулей, чьи классы попали в процесс, — до этого вызова и после. Идемпотентно.
//
// Параметры:
//  ПоискКлассов - КлассыСлоя - через него классы попадают в процесс.
//  КаталогМодулей - Строка - корень src/модули.
//
Процедура ПодключитьКлассы(Знач ПоискКлассов, Знач КаталогМодулей) Экспорт

	РеестрФикстур.Подключить("ОбъявленияПредметов");
	Объявления = Новый ОбъявленияПредметов(ПоискКлассов, КаталогМодулей);
	Поиск_ = ПоискКлассов;
	КореньМодулей_ = КаталогМодулей;

	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	КаталогНастроек = ОбъединитьПути(КаталогМодулей, "настройки", "Классы");
	Для Каждого Имя Из СтрРазделить("ВидыПроверок,ОбъявленияНастроек,ИменаПеременныхОкружения,РеестрНастроек", ",") Цикл
		ПоискКлассов.Подключить(КаталогНастроек, Имя);
	КонецЦикла;

	КлючиСледуют = Истина;
	Для Каждого Тронутый Из ТронутыеМодули Цикл
		ПодключитьКлючиМодуля(Тронутый.Ключ);
	КонецЦикла;

КонецПроцедуры

// Подключает ключи настроек названных модулей, чьих классов в процессе нет: так набор берёт
// объявление, которое правит чужой ключ (механизм правки, срок задачи). Вызывать после ПодключитьКлассы.
//
// Параметры:
//  СписокМодулей - Строка - модули через запятую.
//
Процедура ПодключитьКлючиМодулей(Знач СписокМодулей) Экспорт

	Если НЕ КлючиСледуют Тогда
		ВызватьИсключение "РеестрНастроекХаба: сначала ПодключитьКлассы — ключам не к чему приехать";
	КонецЕсли;

	Для Каждого Модуль Из СтрРазделить(СписокМодулей, ",", Ложь) Цикл
		ПодключитьКлючиМодуля(СокрЛП(Модуль));
	КонецЦикла;

КонецПроцедуры

// Подключает реестр настроек с ключами всех модулей — для сторожа полноты реестра.
//
// Параметры:
//  ПоискКлассов - КлассыСлоя - через него классы попадают в процесс.
//  КаталогМодулей - Строка - корень src/модули.
//
Процедура ПодключитьКлючиВсехПредметов(Знач ПоискКлассов, Знач КаталогМодулей) Экспорт
	ПодключитьКлассы(ПоискКлассов, КаталогМодулей);
	Объявления.Подключить("КлючиНастроек");
КонецПроцедуры

// Отмечает модуль класса, попавшего в процесс: при подключённом реестре ключи настроек модуля
// приезжают вслед. Зовёт КлассыСлоя на каждом подключении.
//
// Параметры:
//  Путь - Строка - полное имя файла подключённого класса.
//
Процедура КлассПодключён(Знач Путь) Экспорт

	Модуль = МодульФайла(Путь);
	Если НЕ ЗначениеЗаполнено(Модуль) ИЛИ ТронутыеМодули.Получить(Модуль) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТронутыеМодули.Вставить(Модуль, Истина);
	Если КлючиСледуют Тогда
		ПодключитьКлючиМодуля(Модуль);
	КонецЕсли;

КонецПроцедуры

// Объявления ключей всех предметов в порядке, в котором их отдала бы ОСень.
//
// Параметры:
//  Детальки - Соответствие, Неопределено - «файл конфигурации»: ключ → сырое значение
//             (необязательный).
//
// Возвращаемое значение:
//  Массив - объекты КлючиНастроек* всех модулей.
//
Функция Предметы(Знач Детальки = Неопределено) Экспорт

	Если Объявления = Неопределено Тогда
		ВызватьИсключение "РеестрНастроекХаба: сначала ПодключитьКлассы — без неё объявления не найти";
	КонецЕсли;

	Желуди = Новый Соответствие();
	Желуди.Вставить("ВидыПроверок", Новый ВидыПроверок());
	Возврат Объявления.Собрать("КлючиНастроек", "КлючиНастроек", Желуди, Детальки);

КонецФункции

// Реестр настроек над ключами всех предметов.
//
// Параметры:
//  Детальки - Соответствие, Неопределено - «файл конфигурации»: ключ → сырое значение
//             (необязательный).
//
// Возвращаемое значение:
//  РеестрНастроек - реестр.
//
Функция Реестр(Знач Детальки = Неопределено) Экспорт
	Возврат Новый РеестрНастроек(Предметы(Детальки));
КонецФункции

Процедура ПодключитьКлючиМодуля(Знач Модуль)

	Для Каждого Файл Из НайтиФайлы(ОбъединитьПути(КореньМодулей_, Модуль), "КлючиНастроек*.os", Истина) Цикл
		Поиск_.ПодключитьФайл(Файл.ПолноеИмя);
	КонецЦикла;

КонецПроцедуры

// Модуль — каталог под src/модули, в котором лежит файл; вне модулей — пустая строка.
Функция МодульФайла(Знач Путь)

	Разделитель = ПолучитьРазделительПути();
	Маркер = Разделитель + "модули" + Разделитель;
	Позиция = СтрНайти(Путь, Маркер, НаправлениеПоиска.СКонца);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Путь, Позиция + СтрДлина(Маркер));
	Конец = СтрНайти(Хвост, Разделитель);

	Возврат ?(Конец = 0, "", Лев(Хвост, Конец - 1));

КонецФункции

ТронутыеМодули = Новый Соответствие();
КлючиСледуют = Ложь;
