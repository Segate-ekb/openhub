// Фейковый транспорт Telegram: записывает отправки вместо сети; ответ и сбой настраиваются тестом.

Перем Отправки;      // Массив из Структура {Токен, ЧатИд, Текст}
Перем ОтветОк;       // Булево — что вернуть в Ок
Перем ОписаниеОтказа;
Перем Оффлайн;       // Булево — бросать исключение (сетевой сбой)
Перем ТекстСбоя;     // Строка — текст исключения в режиме оффлайн

// Контракт ТранспортTelegramOint: отправка текстового сообщения; вместо сети — накопление.
//
// Параметры:
//  Токен - Строка - токен бота.
//  ЧатИд - Строка - идентификатор чата.
//  Текст - Строка - текст сообщения.
//
// Возвращаемое значение:
//  Структура - Ок (Булево), Описание (Строка); в режиме оффлайн бросает исключение.
//
Функция ОтправитьСообщение(Знач Токен, Знач ЧатИд, Знач Текст) Экспорт

	Если Оффлайн Тогда
		ВызватьИсключение ТекстСбоя;
	КонецЕсли;

	Отправки.Добавить(Новый Структура("Токен, ЧатИд, Текст",
		Строка(Токен), Строка(ЧатИд), Строка(Текст)));
	Возврат Новый Структура("Успех, Сообщение", ОтветОк, ?(ОтветОк, "", ОписаниеОтказа));

КонецФункции

// Переводит фейк в режим отказа Bot API.
//
// Параметры:
//  Описание - Строка - причина отказа (необязательный, по умолчанию "chat not found").
//
Процедура УстановитьОтказ(Знач Описание = "chat not found") Экспорт
	ОтветОк = Ложь;
	ОписаниеОтказа = Описание;
КонецПроцедуры

// Переводит фейк в режим сетевого сбоя: отправка бросает исключение.
//
// Параметры:
//  Сообщение - Строка - текст исключения (необязательный; по умолчанию — эмуляция сбоя).
//
Процедура ЭмулироватьОффлайн(Знач Сообщение = "") Экспорт
	Оффлайн = Истина;
	Если ЗначениеЗаполнено(Сообщение) Тогда
		ТекстСбоя = Сообщение;
	КонецЕсли;
КонецПроцедуры

// Число накопленных отправок.
//
// Возвращаемое значение:
//  Число.
//
Функция КоличествоОтправок() Экспорт
	Возврат Отправки.Количество();
КонецФункции

// Все накопленные отправки в порядке вызовов.
//
// Возвращаемое значение:
//  Массив из Структура - Токен, ЧатИд, Текст.
//
Функция ВсеОтправки() Экспорт
	Возврат Отправки;
КонецФункции

// Последняя отправка.
//
// Возвращаемое значение:
//  Структура - Токен, ЧатИд, Текст; Неопределено, если отправок не было.
//
Функция ПоследняяОтправка() Экспорт
	Если Отправки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Отправки[Отправки.Количество() - 1];
КонецФункции

Процедура ПриСозданииОбъекта()
	Отправки = Новый Массив();
	ОтветОк = Истина;
	ОписаниеОтказа = "";
	Оффлайн = Ложь;
	ТекстСбоя = "ФейкТранспортTelegram: эмуляция сетевого сбоя";
КонецПроцедуры
