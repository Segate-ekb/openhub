// Фейк-подписчик доменных событий: считает события и запоминает последнее; по флагу Падать
// бросает исключение — для проверки изоляции подписчиков в издателе.

Перем Падать;             // Булево - выбрасывать исключение при обработке
Перем ПолученоСобытий;    // Число  - счётчик обработанных событий
Перем ПоследнееСобытие;   // Структура, Неопределено - последнее принятое событие

Процедура ПриСозданииОбъекта(Знач ПадатьПриОбработке = Ложь)
	Падать = ПадатьПриОбработке;
	ПолученоСобытий = 0;
	ПоследнееСобытие = Неопределено;
КонецПроцедуры

// Контракт подписчика: учитывает событие и запоминает его как последнее.
// При взведённом флаге Падать бросает исключение — проверка изоляции подписчиков.
//
// Параметры:
//  Событие - Структура - доменное событие.
//
Процедура ОбработатьСобытие(Знач Событие) Экспорт
	Если Падать Тогда
		ВызватьИсключение "фейк-подписчик умышленно упал";
	КонецЕсли;
	ПолученоСобытий = ПолученоСобытий + 1;
	ПоследнееСобытие = Событие;
КонецПроцедуры

// Число принятых событий.
//
// Возвращаемое значение:
//  Число.
//
Функция Количество() Экспорт
	Возврат ПолученоСобытий;
КонецФункции

// Последнее принятое событие.
//
// Возвращаемое значение:
//  Структура, Неопределено - Неопределено, если событий не было.
//
Функция Последнее() Экспорт
	Возврат ПоследнееСобытие;
КонецФункции
