// Накопитель предупреждений: повторяет ту часть контракта лога logos, которой
// пользуются проверяемые классы — Предупреждение(Шаблон, П1...П3) и Отладка того же вида.

Перем Записи;           // Массив из Строка - отформатированные предупреждения в порядке получения
Перем ОтладочныеЗаписи; // Массив из Строка - отладочные строки в порядке получения

Процедура Предупреждение(Знач Шаблон, Знач П1 = Неопределено, Знач П2 = Неопределено,
	Знач П3 = Неопределено) Экспорт

	Записи.Добавить(СтрШаблон(Шаблон, П1, П2, П3));

КонецПроцедуры

// Отладка накапливается отдельно: проверяемые классы ведут её дорожкой разбора,
// а набор смотрит только предупреждения.
Процедура Отладка(Знач Шаблон, Знач П1 = Неопределено, Знач П2 = Неопределено,
	Знач П3 = Неопределено) Экспорт

	ОтладочныеЗаписи.Добавить(СтрШаблон(Шаблон, П1, П2, П3));

КонецПроцедуры

// Накопленные отладочные записи в порядке получения.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция ОтладочныеСтроки() Экспорт
	Возврат ОтладочныеЗаписи;
КонецФункции

// Накопленные предупреждения в порядке получения.
//
// Возвращаемое значение:
//  Массив из Строка.
//
Функция Предупреждения() Экспорт
	Возврат Записи;
КонецФункции

Процедура ПриСозданииОбъекта()
	Записи = Новый Массив();
	ОтладочныеЗаписи = Новый Массив();
КонецПроцедуры
