// Обработчик фонового задания для сторожа потокобезопасности пульта журнала: правит уровень
// и отправку своих логов по кругу, пока другие потоки делают то же, и запоминает первую жалобу.

Перем Пульт;     // ПультЖурнала
Перем Имена;     // Массив из Строка — логи, которые правит поток
Перем Раз;       // Число — сколько кругов правок
Перем Кто;       // Строка — логин администратора потока
Перем Жалоба_;   // Строка — первая жалоба; "" — поток отработал чисто

// Жалоба потока: текст сбоя; пустая строка — правилось без исключений.
//
// Возвращаемое значение:
//  Строка.
//
Функция Жалоба() Экспорт
	Возврат Жалоба_;
КонецФункции

// Контракт обработчика фонового задания.
Процедура Исполнить() Экспорт

	Попытка
		Для Номер = 1 По Раз Цикл
			Пульт.ЗадатьУровень(Имена, ?(Номер % 2 = 0, "DEBUG", "WARN"), Кто);
			Пульт.ОтправлятьВOTel(Имена, Номер % 3 <> 0, Кто);
			Если Номер % 5 = 0 Тогда
				Пульт.ВернутьКСтарту(Имена, Кто);
			КонецЕсли;
		КонецЦикла;
	Исключение
		Жалоба_ = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач _Пульт, Знач _Имена, Знач _Раз, Знач _Кто)
	Пульт = _Пульт;
	Имена = _Имена;
	Раз = _Раз;
	Кто = _Кто;
	Жалоба_ = "";
КонецПроцедуры
