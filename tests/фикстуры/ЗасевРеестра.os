// Засев реестра двумя дверями: пул, пакет и версия — строкой в хранилище либо руками
// служб хаба, одной фикстурой вместо ручной сборки в каждом наборе. Поля, которые
// сценарию безразличны, фикстура заполняет сама — набор называет только то, ради чего
// он написан. Имена по умолчанию свободны ПО ТАБЛИЦЕ, а не по счётчику экземпляра:
// засевов в наборе может быть несколько.
//
// Дверь выбирает набор. «Строкой» (Пул, Пакет, Версия) кладёт запись прямо в хранилище:
// быстро и без последствий, годится там, где реестр — фон сценария. «Службами хаба»
// (ПулСервисом, ПакетСервисом, ОсновнойПул) заводит то же самое руками продукта,
// со всеми его последствиями — канон имени, проверка занятости, квота «как в хабе»,
// основной пул. Набор, который потом проверяет на засеянном продуктовую логику, обязан
// брать вторую дверь: пул, положенный строкой, отличается от заведённого хабом молча.

Перем Контейнер;

#Область ЗасевСтрокой

// Заводит пул. Имя по умолчанию уникально в пределах набора — одноимённые пулы
// в одной базе не живут.
//
// Параметры:
//  Имя - Строка - имя пула (необязательный, по умолчанию "" — уникальное «pool-N»).
//  Видимость - Строка - public либо private (необязательный, по умолчанию "public").
//  Тип - Строка - тип пула (необязательный, по умолчанию "custom").
//
// Возвращаемое значение:
//  Пул - сохранённая строка пула.
//
Функция Пул(Знач Имя = "", Знач Видимость = "public", Знач Тип = "custom") Экспорт

	Запись = Контейнер.НайтиЖелудь("ХранилищеПулов").СоздатьЭлемент();
	Запись.Имя = ?(ЗначениеЗаполнено(Имя), Имя, СвободноеИмяПула());
	Запись.Тип = Тип;
	Запись.Видимость = Видимость;
	Запись.ПоУмолчанию = Ложь;
	Запись.ВладелецИдентификатор = 0;
	Запись.ПубликацияРазрешена = Истина;
	Запись.НастройкиJSON = "";
	Запись.КвотаМб = 0;
	Запись.ЗанятоБайт = 0;
	Запись.Создан = ТекущаяУниверсальнаяДата();
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

// Заводит пакет в пуле.
//
// Параметры:
//  ПулИлиИдентификатор - Пул, Число - пул, в котором заводится пакет.
//  Имя - Строка - имя пакета (необязательный, по умолчанию "" — уникальное «pkg-N»).
//
// Возвращаемое значение:
//  Пакет - сохранённая строка пакета.
//
Функция Пакет(Знач ПулИлиИдентификатор, Знач Имя = "") Экспорт

	ПулИдентификатор = ПомощникиСтендов.Идентификатор(ПулИлиИдентификатор);
	ИмяПакета = ?(ЗначениеЗаполнено(Имя), Имя, СвободноеИмяПакета(ПулИдентификатор));

	Запись = Контейнер.НайтиЖелудь("ХранилищеПакетов").СоздатьЭлемент();
	Запись.ПулИдентификатор = ПулИдентификатор;
	Запись.Имя = ИмяПакета;
	Запись.ИмяНижнийРегистр = НРег(ИмяПакета);
	Запись.Описание = "";
	Запись.Устарел = Ложь;
	Запись.Скрыт = Ложь;
	Запись.Создан = ТекущаяУниверсальнаяДата();
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

// Заводит версию пакета. Semver-колонки разбираются из номера: по ним хаб сортирует
// версии, и версия без них ведёт себя в реестре не так, как настоящая.
//
// Параметры:
//  ПакетИлиИдентификатор - Пакет, Число - пакет, которому принадлежит версия.
//  Номер - Строка - номер версии (необязательный, по умолчанию "1.0.0").
//  Отозвана - Булево - признак отзыва (необязательный, по умолчанию Ложь).
//
// Возвращаемое значение:
//  ВерсияПакета - сохранённая строка версии.
//
Функция Версия(Знач ПакетИлиИдентификатор, Знач Номер = "1.0.0", Знач Отозвана = Ложь) Экспорт

	Части = Номера(Номер);

	Запись = Контейнер.НайтиЖелудь("ХранилищеВерсийПакета").СоздатьЭлемент();
	Запись.ПакетИдентификатор = ПомощникиСтендов.Идентификатор(ПакетИлиИдентификатор);
	Запись.Версия = Номер;
	Запись.ВерсияДвижка = "";
	Запись.SemverМажор = Части[0];
	Запись.SemverМинор = Части[1];
	Запись.SemverПатч = Части[2];
	Запись.SemverПререлиз = "";
	Запись.SemverСборка = "";
	Запись.ПризнакLegacyВерсии = Ложь;
	Запись.ПризнакВнеПорядка = Ложь;
	Запись.Размер = 1024;
	Запись.Sha256 = "";
	Запись.АвторМанифеста = "";
	Запись.Отозвана = Отозвана;
	Запись.ОпубликовалИдентификатор = 0;
	Запись.Опубликована = ТекущаяУниверсальнаяДата();
	Запись.Изменена = ТекущаяУниверсальнаяДата();
	Запись.ПутьВХранилище = "";
	Запись.Сохранить();

	Возврат Запись;

КонецФункции

// Полный засев одного пакета: пул, пакет и одна его версия.
//
// Параметры:
//  ИмяПакета - Строка - имя пакета (необязательный, по умолчанию "" — уникальное).
//  Номер - Строка - номер версии (необязательный, по умолчанию "1.0.0").
//
// Возвращаемое значение:
//  Структура - Пул, Пакет, Версия.
//
Функция ПулПакетВерсия(Знач ИмяПакета = "", Знач Номер = "1.0.0") Экспорт

	ЗаписьПула = Пул();
	ЗаписьПакета = Пакет(ЗаписьПула, ИмяПакета);

	Возврат Новый Структура("Пул, Пакет, Версия",
		ЗаписьПула, ЗаписьПакета, Версия(ЗаписьПакета, Номер));

КонецФункции

#КонецОбласти

#Область ЗасевСлужбамиХаба

// Заводит пул руками хаба — СервисПулов, как это делает администратор. Пул получает
// канон имени, проверку занятости и квоту «как в хабе». Строка, положенная в таблицу
// напрямую, ничего этого не имеет, и набор, проверяющий на пуле продуктовую логику,
// оставался бы на ней зелёным молча.
//
// Параметры:
//  Имя - Строка - имя пула (необязательный, по умолчанию "" — свободное «pool-N»).
//  Видимость - Строка - public либо private (необязательный, по умолчанию "public").
//  ВладелецИдентификатор - Число - владелец, 0 — системный (необязательный, по умолчанию 0).
//  КвотаМб - Число - квота: -1 «как в хабе», 0 без ограничения (необязательный,
//            по умолчанию -1).
//
// Возвращаемое значение:
//  Пул - заведённый пул.
//
Функция ПулСервисом(Знач Имя = "", Знач Видимость = "public",
	Знач ВладелецИдентификатор = 0, Знач КвотаМб = -1) Экспорт

	Возврат Контейнер.НайтиЖелудь("СервисПулов").СоздатьПул(
		?(ЗначениеЗаполнено(Имя), Имя, СвободноеИмяПула()),
		"custom", Видимость, ВладелецИдентификатор, КвотаМб);

КонецФункции

// Регистрирует пакет в пуле руками хаба — СервисПакетов.
//
// Параметры:
//  ПулИлиИдентификатор - Пул, Число - пул, в котором заводится пакет.
//  Имя - Строка - имя пакета (необязательный, по умолчанию "" — свободное «pkg-N»).
//  Свойства - Структура, Неопределено - описание, лицензия и прочие поля карточки
//             (необязательный, по умолчанию Неопределено).
//
// Возвращаемое значение:
//  Пакет - зарегистрированный пакет.
//
Функция ПакетСервисом(Знач ПулИлиИдентификатор, Знач Имя = "", Знач Свойства = Неопределено) Экспорт

	ПулИдентификатор = ПомощникиСтендов.Идентификатор(ПулИлиИдентификатор);

	Возврат Контейнер.НайтиЖелудь("СервисПакетов").ЗарегистрироватьПакет(ПулИдентификатор,
		?(ЗначениеЗаполнено(Имя), Имя, СвободноеИмяПакета(ПулИдентификатор)), Свойства);

КонецФункции

// Основной пул хаба: назначенный, а если такого нет — заведённый и назначенный здесь же.
// Короткие адреса /download и /push обслуживает именно он, и хаб без основного пула
// отвечает по ним объяснением вместо выдачи. Набору, который их проверяет, основной пул
// нужен, а какой именно — безразлично.
//
// Носитель признака ПоУмолчанию, а НЕ пул с именем «public»: подавление TOFU и путь
// GitHub-токена спрашивают признак, и засев, подсунувший одноимённый пул без него,
// провёл бы набор мимо продуктового кода. Оговорка на одно имя: пул, названный так же,
// как деталька oshub.pools.default (по умолчанию «public»), хаб делает основным сам —
// СервисПулов.Завести зовёт ОбеспечитьОсновнойПул() на каждое заведение. Любому другому
// имени признак ставит только эта дверь.
//
// Возвращаемое значение:
//  Пул - основной пул хаба.
//
Функция ОсновнойПул() Экспорт

	Пулы = Контейнер.НайтиЖелудь("СервисПулов");

	Назначенный = Пулы.ДефолтныйПул();
	Если Назначенный <> Неопределено Тогда
		Возврат Назначенный;
	КонецЕсли;

	Возврат Пулы.НазначитьПулПоУмолчанию(ПулСервисом().Идентификатор, "тест");

КонецФункции

#КонецОбласти

#Область Служебное

// Свободное имя пула. Счёт ведётся ПО ТАБЛИЦЕ, а не по счётчику экземпляра: два засева
// в одном наборе — обычное дело, и счётчик каждого начинался бы с единицы, молча заводя
// два пула «pool-1». Одноимённых пулов в хабе не бывает, и такой засев ломал бы не себя,
// а тот сценарий, который потом ищет пул по имени.
//
// Возвращаемое значение:
//  Строка - «pool-N», которого в таблице ещё нет.
//
Функция СвободноеИмяПула()

	Пулы = Контейнер.НайтиЖелудь("ХранилищеПулов");
	Номер = Пулы.Все().Количество();

	Пока Истина Цикл
		Номер = Номер + 1;
		Имя = "pool-" + Формат(Номер, "ЧГ=0; ЧН=0");
		Если Пулы.ПолучитьОдноПоИмяРавно(Имя) = Неопределено Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;

КонецФункции

// Свободное имя пакета В ПУЛЕ: имена пакетов уникальны внутри пула, а не по всему хабу.
//
// Параметры:
//  ПулИдентификатор - Число - пул, в котором заводится пакет.
//
// Возвращаемое значение:
//  Строка - «pkg-N», которого в этом пуле ещё нет.
//
Функция СвободноеИмяПакета(Знач ПулИдентификатор)

	Пакеты = Контейнер.НайтиЖелудь("ХранилищеПакетов");
	Номер = 0;

	Пока Истина Цикл
		Номер = Номер + 1;
		Имя = "pkg-" + Формат(Номер, "ЧГ=0; ЧН=0");
		Если Пакеты.НайтиПоИмени(ПулИдентификатор, Имя) = Неопределено Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;

КонецФункции

// Номер, из которого semver не читается (легаси-четвёрка, пререлиз), даёт нули —
// ровно как их оставляет хаб на версии, которую не смог разобрать.
Функция Номера(Знач Номер)

	Разряды = Новый Массив();
	Части = СтрРазделить(Строка(Номер), ".");

	Для Место = 0 По 2 Цикл
		Разряды.Добавить(?(Место <= Части.ВГраница(), Целое(Части[Место]), 0));
	КонецЦикла;

	Возврат Разряды;

КонецФункции

Функция Целое(Знач Текст)

	Попытка
		Возврат Цел(Число(СокрЛП(Текст)));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта(Знач Поделка)
	Контейнер = Поделка;
КонецПроцедуры
