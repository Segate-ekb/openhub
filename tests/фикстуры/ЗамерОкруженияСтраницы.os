// Окружение страницы пакета, не ходящее в базу: гвард, принципал, чтение пула, каркас,
// отдача страницы, кабинет, статистика и реестр пакетов. Всё это цену страницы не двигает,
// поэтому в замере стоит заглушкой — считаются только хранилища.

Перем Пул;
Перем Пакеты;
Перем Разметка;  // последняя отданная страница

#Область НаполнениеФикстуры

// Задаёт пул, в котором живут пакеты замера.
//
// Параметры:
//  ПулЗамера - Структура - пул с полями Идентификатор, Имя, Видимость.
//
Процедура ЗадатьПул(Знач ПулЗамера) Экспорт
	Пул = ПулЗамера;
КонецПроцедуры

// Добавляет пакет в пул замера; первый становится пакетом страницы.
//
// Параметры:
//  ПакетЗамера - Структура - пакет с полями Идентификатор, ПулИдентификатор, Имя и прочими.
//
Процедура ДобавитьПакет(Знач ПакетЗамера) Экспорт
	Пакеты.Добавить(ПакетЗамера);
КонецПроцедуры

// Разметка, которую страница отдала последним запросом: замер обязан мерить настоящую
// работу, а не пустой ответ.
//
// Возвращаемое значение:
//  Строка.
//
Функция ОтданнаяРазметка() Экспорт
	Возврат ?(Разметка = Неопределено, "", Разметка);
КонецФункции

#КонецОбласти

#Область ГвардИПринципал

// Онбординг пройден: страница открыта.
//
// Параметры:
//  Ответ - Произвольный - ответ сервера, заглушкой не трогается.
//
// Возвращаемое значение:
//  Структура - Разрешено (Булево).
//
Функция Проверить(Знач Ответ) Экспорт
	Ответ = Ответ;
	Возврат Новый Структура("Разрешено", Истина);
КонецФункции

// Читатель — гость: страница собирается в самой дешёвой своей форме.
//
// Параметры:
//  ЗаголовкиЗапроса - Произвольный - заголовки, заглушкой не трогаются.
//  КукиЗапроса - Произвольный - куки, заглушкой не трогаются.
//
// Возвращаемое значение:
//  Структура - Пользователь, Принципал.
//
Функция ОпределитьПринципала(Знач ЗаголовкиЗапроса, Знач КукиЗапроса) Экспорт
	ЗаголовкиЗапроса = ЗаголовкиЗапроса;
	КукиЗапроса = КукиЗапроса;
	Возврат Новый Структура("Пользователь, Принципал", Неопределено, Неопределено);
КонецФункции

// Пул читаем всегда.
//
// Параметры:
//  Пользователь - Произвольный - читатель.
//  ИмяПула - Строка - имя пула из адреса.
//  Принципал - Произвольный - субъект запроса.
//
// Возвращаемое значение:
//  Структура - пул замера.
//
Функция ЧитаемыйПул(Знач Пользователь, Знач ИмяПула, Знач Принципал) Экспорт
	Пользователь = Пользователь;
	ИмяПула = ИмяПула;
	Принципал = Принципал;
	Возврат Пул;
КонецФункции

#КонецОбласти

#Область КаркасИОтдача

// Каркас страницы в замере не участвует: считается цена данных, а не обрамления.
//
// Параметры:
//  Заголовок - Строка - заголовок страницы.
//  Контент - Строка - тело страницы.
//  Контекст - Произвольный - контекст оформления.
//
// Возвращаемое значение:
//  Строка - тело как есть.
//
Функция Страница(Знач Заголовок, Знач Контент, Знач Контекст) Экспорт
	Заголовок = Заголовок;
	Контекст = Контекст;
	Возврат Контент;
КонецФункции

// Контекст оформления страницы; замеру он безразличен.
//
// Параметры:
//  Пользователь - Произвольный - читатель.
//  КукиЗапроса - Произвольный - куки читателя.
//  ПоказатьМеню - Булево - показывать ли меню.
//  ПоказатьПоиск - Булево - показывать ли поиск.
//  Дорога - Строка - активная дорога меню.
//
// Возвращаемое значение:
//  Неопределено.
//
Функция КонтекстСтраницы(Знач Пользователь, Знач КукиЗапроса, Знач ПоказатьМеню,
	Знач ПоказатьПоиск, Знач Дорога) Экспорт

	Пользователь = Пользователь;
	КукиЗапроса = КукиЗапроса;
	ПоказатьМеню = ПоказатьМеню;
	ПоказатьПоиск = ПоказатьПоиск;
	Дорога = Дорога;
	Возврат Неопределено;

КонецФункции

// Запоминает отданную страницу вместо записи в ответ winow.
//
// Параметры:
//  Ответ - Произвольный - ответ сервера, заглушкой не трогается.
//  ТелоСтраницы - Строка - готовая разметка.
//  ГодитсяОбщемуКэшу - Булево - признак общего кэша.
//  ЗаголовкиЗапроса - Произвольный - заголовки запроса.
//
Процедура ОтдатьСтраницу(Ответ, Знач ТелоСтраницы, Знач ГодитсяОбщемуКэшу,
	Знач ЗаголовкиЗапроса) Экспорт

	Ответ = Ответ;
	ГодитсяОбщемуКэшу = ГодитсяОбщемуКэшу;
	ЗаголовкиЗапроса = ЗаголовкиЗапроса;
	Разметка = ТелоСтраницы;

КонецПроцедуры

#КонецОбласти

#Область КабинетСтатистикаИРеестр

// Гость пакетом не управляет: шестерёнки в шапке нет.
//
// Параметры:
//  Пользователь - Произвольный - читатель.
//  ПулПакета - Произвольный - пул пакета.
//  ПакетЭкрана - Произвольный - пакет.
//
// Возвращаемое значение:
//  Булево - всегда Ложь.
//
Функция МожетУправлять(Знач Пользователь, Знач ПулПакета, Знач ПакетЭкрана) Экспорт
	Пользователь = Пользователь;
	ПулПакета = ПулПакета;
	ПакетЭкрана = ПакетЭкрана;
	Возврат Ложь;
КонецФункции

// Счётчик скачиваний: в базу не ходит.
//
// Параметры:
//  ПакетИдентификатор - Число - идентификатор пакета.
//
// Возвращаемое значение:
//  Число - всегда ноль.
//
Функция СкачиванийПакета(Знач ПакетИдентификатор) Экспорт
	ПакетИдентификатор = ПакетИдентификатор;
	Возврат 0;
КонецФункции

// Пакет пула по имени (контракт СервисПакетов): адрес страницы уже разобран, читать нечего.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//  Имя - Строка - имя пакета.
//
// Возвращаемое значение:
//  Структура, Неопределено - пакет замера.
//
Функция НайтиПакет(Знач ПулИдентификатор, Знач Имя) Экспорт

	ПулИдентификатор = ПулИдентификатор;
	Для Каждого ПакетПула Из Пакеты Цикл
		Если НРег(Строка(ПакетПула.Имя)) = НРег(СокрЛП(Строка(Имя))) Тогда
			Возврат ПакетПула;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Все пакеты пула (контракт СервисПакетов): срез изменений перечисляет имена пула.
//
// Параметры:
//  ПулИдентификатор - Число - идентификатор пула.
//
// Возвращаемое значение:
//  Массив - пакеты замера.
//
Функция ПакетыПула(Знач ПулИдентификатор) Экспорт
	ПулИдентификатор = ПулИдентификатор;
	Возврат Пакеты;
КонецФункции

#КонецОбласти

Процедура ПриСозданииОбъекта()
	Пакеты = Новый Массив();
	Разметка = "";
КонецПроцедуры
