// Фикстура: обязательные соседи заведения источника — SSRF-гейт адреса апстрима
// и правило токена доступа — для частичных тест-контейнеров.

// Подключает классы, без которых не поднимается заведение источника: SSRF-гейт адреса
// и правило токена доступа. СервисПулов требует их обязательно, а модули
// подписки/mirror/прокси целиком тянуть нельзя.
//
// Параметры:
//  КаталогМодулей - Строка - путь к src/модули; пусто — вычислить от расположения фикстуры
//                   (необязательный, по умолчанию "").
//
Процедура Подключить(Знач КаталогМодулей = "") Экспорт

	Модули = ?(ЗначениеЗаполнено(КаталогМодулей), КаталогМодулей, КаталогМодулейПоУмолчанию());
	КаталогВебхуков = ОбъединитьПути(Модули, "подписки", "Классы");
	КаталогЗеркал = ОбъединитьПути(Модули, "зеркала", "Классы");
	КаталогCommon = ОбъединитьПути(Модули, "основа", "Классы");
	КаталогПрокси = ОбъединитьПути(Модули, "прокси", "Классы");

	// Без ПриведенияЧисел резолвер молча не поднимается, и DNS-ветка гейта получает Неопределено.
	Подключить1(КаталогCommon, "ПриведениеЧисел");
	Подключить1(КаталогВебхуков, "РазрешительImёнСистемный");
	Подключить1(КаталогВебхуков, "ВалидаторАдресаВебхука");
	Подключить1(КаталогЗеркал, "ВалидаторАдресаАпстрима");
	Подключить1(КаталогПрокси, "СекретИсточника");

КонецПроцедуры

Функция КаталогМодулейПоУмолчанию()
	КаталогФикстур = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогТестов = Новый Файл(КаталогФикстур).Путь;
	КаталогПроекта = Новый Файл(КаталогТестов).Путь;
	Возврат ОбъединитьПути(КаталогПроекта, "src", "модули");
КонецФункции

// Файл ищется по имени в каталоге и его подкаталогах: путь из имени не строится, иначе
// уехавший в подкаталог класс молча теряется (docs/процесс/РАСКЛАДКА.md).
Процедура Подключить1(Знач Каталог, Знач ИмяКласса)
	Если ТипЗарегистрирован(ИмяКласса) Тогда
		Возврат;
	КонецЕсли;
	Найденные = НайтиФайлы(Каталог, ИмяКласса + ".os", Истина);
	Если Найденные.Количество() <> 1 Тогда
		ВызватьИсключение СтрШаблон("Класс %1 в %2 найден %3 раз(а), ожидался ровно один",
			ИмяКласса, Каталог, Найденные.Количество());
	КонецЕсли;
	ПодключитьСценарий(Найденные[0].ПолноеИмя, ИмяКласса);
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Процедура ПриСозданииОбъекта()
КонецПроцедуры
