// Журнал аудита на настоящем контейнере со связкой журнала хаба: запись аудита лежит в своём
// файле и не уходит ни в консоль, ни в память, ни в коллектор — даже когда корень заглушён,
// а оператор назвал журналу аудита уровень и все выходы хаба.

#Использовать asserts
#Использовать autumn
#Использовать autumn-logos
#Использовать logos
#Использовать opentelemetry
#Использовать "фикстуры"

Перем Поделка;
Перем Загрузка;        // ЗагрузкаНастроек — её замечания
Перем ПечатьКонсоли;   // ЛовушкаЛога на месте печати консоли хаба
Перем Мост;            // МостКоллектораЛовушка — что уехало бы в коллектор
Перем Память;          // ПамятьЖурнала
Перем Летопись;        // ЛетописьАудита
Перем Аппендер;        // АппендерЖурналаАудита — его файл
Перем Названные;       // ПробаЖурналаНазванныхЛогов — самотест ловушек

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	Модули = КаталогМодулей();
	ПоискКлассов.ПодключитьОснову(Модули);
	Журнал = ОбъединитьПути(Модули, "наблюдаемость", "Классы");
	Для Каждого Имя Из СтрРазделить("ШкалаЖурнала,ОбезличиваниеЖурнала,ВыводЛогаВКонсольХаба,ВыводЛогаВOTelХаба,"
		+ "ВыводЛогаВПамятьХаба,КольцоЖурнала,ПамятьЖурнала,УровниЖурнала", ",") Цикл
		ПоискКлассов.Подключить(Журнал, Имя);
	КонецЦикла;
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "настройки", "Классы"), "ИменаПеременныхОкружения");
	Для Каждого Имя Из СтрРазделить("РасположениеДанных,ИсточникиНастроек,ЗагрузкаНастроек", ",") Цикл
		ПоискКлассов.Подключить(ОбъединитьПути(Модули, "запуск", "Классы"), Имя);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ФорматЖурналаАудита,АппендерЖурналаАудита,ЛетописьАудита", ",") Цикл
		ПоискКлассов.Подключить(ОбъединитьПути(Модули, "аудит", "Классы"), Имя);
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("ПробаЖурналаНазванныхЛогов,МостКоллектораЛовушка,ЛовушкаЛога", ",") Цикл
		РеестрФикстур.Подключить(Имя);
	КонецЦикла;

	Загрузка = Новый ЗагрузкаНастроек("", ВыходыСервера());
	Детальки = Загрузка.ДеталькиПоверх(ФайлОператора(), ОкружениеОператора());
	Детальки.Вставить("oshub.storage.root", УникальныеИмена.ВременныйПуть("oshub-аудит-связка"));

	Совет = Новый СоветДругогоМастера();
	// файл настроек проекта сильнее деталек — имя уводится на несуществующее
	Совет.ИмяФайлаСоЗначениямиДеталек("журнал-аудита-со-связкой-без-файла");
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	ПечатьКонсоли = Новый ЛовушкаЛога();
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Поделка.НайтиЖелудь("ВыводЛогаВКонсольХаба"), "Печать", ПечатьКонсоли);
	Мост = Поделка.НайтиЖелудь("ОтелАппендерLogos");
	Память = Поделка.НайтиЖелудь("ПамятьЖурнала");
	Летопись = Поделка.НайтиЖелудь("ЛетописьАудита");
	Аппендер = Поделка.НайтиЖелудь("АппендерЖурналаАудита");
	Названные = Поделка.НайтиЖелудь("ПробаЖурналаНазванныхЛогов");

КонецПроцедуры

// Файл — единственный приёмник журнала аудита: запись есть в нём и нет ни в консоли, ни
// в памяти, ни в коллекторе. Ловушки живые: сведение соседнего журнала они видят.
&Тест
Процедура ЗаписьАудитаТолькоВФайле() Экспорт

	Метка = Метка();
	Летопись.Записать(ТекущаяУниверсальнаяДата(), "root", "проба.аудит", "объект/" + Метка, "", "", "");
	Названные.Лог("проба.сосед").Информация("сведение соседа " + Метка);

	Ожидаем.Что(СтрокФайла(Метка), "запись аудита в файле").Равно(1);
	Ожидаем.Что(СтрокКонсоли("объект/" + Метка), "в консоли её нет").Равно(0);
	Ожидаем.Что(СтрокПамяти("объект/" + Метка), "в памяти нет").Равно(0);
	Ожидаем.Что(Мост.СобытияЛога("аудит").Количество(), "в коллектор журнал аудита не уходит").Равно(0);

	Ожидаем.Что(СтрокКонсоли("сведение соседа " + Метка), "самотест: консоль ловит").Равно(1);
	Ожидаем.Что(СтрокПамяти("сведение соседа " + Метка), "самотест: память ловит").Равно(1);

КонецПроцедуры

// Заглушённый корень и уровень, выходы и порог, названные журналу аудита оператором, аудит
// не глушат и в выходы хаба не выводят; оператор слышит, что заданное не применено.
&Тест
Процедура НастройкиУровнейАудитНеГлушат() Экспорт

	Таблица = Поделка.НайтиДетальку("oshub.log.startup");
	Ожидаем.Что(Таблица["rootLogger"]["Уровень"], "самотест: корень заглушён").Равно("DISABLE");

	Метка = Метка();
	Для Номер = 1 По 3 Цикл
		Летопись.Записать(ТекущаяУниверсальнаяДата(), "root", "проба.аудит", "объект/" + Метка, "", "", "");
	КонецЦикла;

	Ожидаем.Что(СтрокФайла(Метка), "все три записи в файле").Равно(3);
	Ожидаем.Что(СтрокКонсоли("объект/" + Метка), "в консоли ни одной").Равно(0);
	Ожидаем.Что(СтрСоединить(Загрузка.Замечания(), Символы.ПС), "заданное аудиту названо неприменённым")
		.Содержит("журнал аудит пишет только в свой приёмник");

КонецПроцедуры

#Область Обвязка

Функция ВыходыСервера()
	Выходы = Новый Соответствие();
	Выходы.Вставить("console", "ВыводЛогаВКонсольХаба");
	Выходы.Вставить("memory", "ВыводЛогаВПамятьХаба");
	Выходы.Вставить("otel", "ВыводЛогаВOTelХаба");
	Возврат Выходы;
КонецФункции

// Оператор назвал журналу аудита подробный уровень и все выходы хаба.
Функция ФайлОператора()

	Выходы = СтрРазделить("console,memory,otel", ",");
	Аудит = Новый Соответствие();
	Аудит.Вставить("level", "DEBUG");
	Аудит.Вставить("appenders", Выходы);

	Логгеры = Новый Соответствие();
	Логгеры.Вставить("аудит", Аудит);
	Узел = Новый Соответствие();
	Узел.Вставить("logger", Логгеры);
	Файл = Новый Соответствие();
	Файл.Вставить("logos", Узел);
	Возврат Файл;

КонецФункции

// Так переменные отдаёт провайдер окружения configor: ключ через точку. Корень заглушён,
// соседний журнал пишет сведения — по нему видно, что ловушки ловят.
Функция ОкружениеОператора()
	Окружение = Новый Соответствие();
	Окружение.Вставить("OSHUB.LOG.LEVEL", "DISABLE");
	Окружение.Вставить("OSHUB.LOG.LEVELS", "проба.сосед=INFO");
	Окружение.Вставить("OSHUB.LOG.OTEL.LEVELS", "аудит=DEBUG");
	Возврат Окружение;
КонецФункции

Функция Метка()
	Возврат "метка-" + Строка(Новый УникальныйИдентификатор());
КонецФункции

Функция СтрокФайла(Знач Фрагмент)

	Поток = ФайловыеПотоки.ОткрытьДляЧтения(Аппендер.Путь());
	Чтение = Новый ЧтениеДанных(Поток);
	Буфер = Чтение.ПрочитатьВБуферДвоичныхДанных();
	Чтение.Закрыть();
	Поток.Закрыть();

	Сколько = 0;
	Для Каждого Строчка Из СтрРазделить(ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер, "utf-8"), Символы.ПС) Цикл
		Если СтрНайти(Строчка, Фрагмент) > 0 Тогда
			Сколько = Сколько + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Сколько;

КонецФункции

Функция СтрокКонсоли(Знач Фрагмент)
	Сколько = 0;
	Для Номер = 0 По ПечатьКонсоли.Количество() - 1 Цикл
		Если СтрНайти(ПечатьКонсоли.Сообщение(Номер), Фрагмент) > 0 Тогда
			Сколько = Сколько + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Сколько;
КонецФункции

Функция СтрокПамяти(Знач Фрагмент)
	Возврат Память.Хвост(Новый Структура("Содержит, Количество", Фрагмент, 100000)).Количество();
КонецФункции

Функция КаталогМодулей()
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Возврат Новый Файл(ОбъединитьПути(КаталогТестов, "..", "src", "модули")).ПолноеИмя;
КонецФункции

#КонецОбласти
