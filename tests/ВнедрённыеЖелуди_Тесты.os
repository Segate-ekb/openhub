// Примитив основа/ВнедрённыеЖелуди: три формы, которыми ОСень отдаёт необязательную
// зависимость. Проверяется значение — что все три читаются одинаково, а «зависимости нет»
// отличимо от «зависимость есть»: перепутать их значит собрать класс с пустым сотрудником.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем Желуди;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "основа", "Классы"), "ВнедрённыеЖелуди");

КонецПроцедуры

&ПередКаждым
Процедура СобратьЖелуди() Экспорт
	Желуди = Новый ВнедрённыеЖелуди();
КонецПроцедуры

&Тест
Процедура ТриФормыВнедренияЧитаютсяОдинаково() Экспорт

	Сотрудник = Новый Структура("Имя", "пробник");

	Массив_ = Новый Массив();
	Массив_.Добавить(Сотрудник);

	Ожидаем.Что(Желуди.ПервыйИз(Массив_), "обычный Массив — форма теста").Равно(Сотрудник);
	Ожидаем.Что(Желуди.ПервыйИз(Новый ФиксированныйМассив(Массив_)),
		"ФиксированныйМассив — форма контейнера").Равно(Сотрудник);
	Ожидаем.Что(Желуди.ПервыйИз(Сотрудник), "сам объект — третья форма").Равно(Сотрудник);

КонецПроцедуры

&Тест
Процедура ОтсутствиеЗависимостиОтличимоОтЕёНаличия() Экспорт

	Ожидаем.Что(Желуди.ПервыйИз(Неопределено), "зависимости нет вовсе")
		.Равно(Неопределено);
	Ожидаем.Что(Желуди.ПервыйИз(Новый Массив()), "пустая коллекция — имени в контейнере нет")
		.Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ИзНесколькихКандидатовБерётсяПервый() Экспорт

	Первый = Новый Структура("Имя", "первый");
	Второй = Новый Структура("Имя", "второй");

	Кандидаты = Новый Массив();
	Кандидаты.Добавить(Первый);
	Кандидаты.Добавить(Второй);

	Ожидаем.Что(Желуди.ПервыйИз(Кандидаты), "контейнер собрал двоих — берётся первый")
		.Равно(Первый);

КонецПроцедуры

&Тест
Процедура ПустаяСтрокаИНольЗависимостьюОстаются() Экспорт

	// «зависимости нет» — это Неопределено и пустая коллекция, а не любое пустое значение:
	// сотрудник вправе быть чем угодно, и решать за него примитив не должен
	Ожидаем.Что(Желуди.ПервыйИз(""), "пустая строка — это значение, а не отсутствие").Равно("");
	Ожидаем.Что(Желуди.ПервыйИз(0), "ноль — это значение").Равно(0);

КонецПроцедуры
