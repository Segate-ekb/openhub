// Самотест общего модуля УникальныеИмена: на нём стоят логины, имена пулов и пакетов
// два десятка наборов. Имя, которое повторилось, не роняет тот набор, который его взял, —
// оно роняет соседний, ищущий по имени; имя, которого не принимает хаб, роняет засев
// службами. Поэтому проверяется не форма строки, а то, ЧТО СКАЖЕТ ХАБ на выданное имя,
// и то, что два имени подряд разные.

#Использовать asserts
#Использовать ospx-tools
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Имена;          // ПравилаИменования — приговор хаба имени пула и пакета
Перем Учётки;         // НормализаторУчётки — приговор хаба логину
Перем КаталогФикстур; // библиотека фикстур — её берёт соседний процесс
Перем Убираемое;      // всё, что тест взял у двери; снимается в &ПослеКаждого

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогФикстур = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "фикстуры");

КонецПроцедуры

&ПередКаждым
Процедура ЗавестиСписокУбираемого() Экспорт
	Убираемое = Новый Массив();
КонецПроцедуры

&ПослеКаждого
Процедура УбратьВзятоеУДвери() Экспорт
	Для Каждого Путь Из Убираемое Цикл
		УникальныеИмена.УбратьВременное(Путь);
	КонецЦикла;
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьСудейИмён() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Модули = ОбъединитьПути(Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя,
		"src", "модули");

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "основа", "Классы", "КанонСтроки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "основа", "Классы", "КонтрольСимволов.os"));
	ПоискКлассов.ПодключитьФайл(
		ОбъединитьПути(Модули, "реестр", "Классы", "ПравилаИменования.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(
		ОбъединитьПути(Модули, "вход", "Классы", "учётки"), "НормализаторУчётки.os"));

	Имена = Новый ПравилаИменования();
	Учётки = Новый НормализаторУчётки();

КонецПроцедуры

#Область ПриговорХаба

// Имя из этой двери ложится в имя пула и пакета: засев службами хаба гонит его через
// ПравилаИменования, и имя, которого хаб не принимает, роняет набор не тестом, а засевом.
&Тест
Процедура ИмяПринимаетсяПравиламиИменованияХаба() Экспорт

	Для Счёт = 1 По 20 Цикл
		Выданное = УникальныеИмена.Имя("pool");
		Ожидаем.Что(Имена.ИмяКорректно(Выданное),
			СтрШаблон("хаб принимает имя пула ""%1""", Выданное)).ЭтоИстина();
	КонецЦикла;

	// длинная приставка — обычное дело: «cipathpool», «scopeown»; имя обязано остаться
	// в пределах ста знаков вместе с ней
	Длинное = УникальныеИмена.Имя("оченьдлиннаяприставкаиззаголовканабора");
	Ожидаем.Что(СтрДлина(Длинное) < 100, СтрШаблон("длина имени: %1", СтрДлина(Длинное))).ЭтоИстина();

КонецПроцедуры

// То же имя служит логином: хаб проверяет его отдельными правилами — строчная латиница,
// первый символ буква или цифра, длина 2–64.
&Тест
Процедура ИмяПринимаетсяХабомКакЛогин() Экспорт

	Для Счёт = 1 По 20 Цикл
		Логин = УникальныеИмена.Имя("u");
		Ожидаем.Что(Учётки.НормализоватьЛогин(Логин),
			"логин из двери уже канонический, нормализация его не меняет").Равно(Логин);
		Учётки.ПроверитьЛогин(Логин); // некорректный логин — исключение, тест краснеет
	КонецЦикла;

КонецПроцедуры

// Приставка склеивается с хвостом вплотную: «dave» + хвост — тоже законный логин,
// и набор, которому нужен свой разделитель, берёт хвост, а не имя.
&Тест
Процедура ХвостГодитсяВЛогинСоСвоейПриставкой() Экспорт

	Учётки.ПроверитьЛогин("dave" + УникальныеИмена.Хвост());
	Учётки.ПроверитьЛогин("alice_" + УникальныеИмена.Хвост());

	Ожидаем.Что(Имена.ИмяКорректно("sub." + УникальныеИмена.Хвост()),
		"хвост не мешает точке в имени").ЭтоИстина();

КонецПроцедуры

// Имя провайдера входа хаб проверяет своей меркой: только строчная латиница, цифры
// и дефис, длина 2–32, дефиса по краям нет. Три набора провайдеров берут имена отсюда.
&Тест
Процедура ИмяГодитсяВИмяПровайдераВхода() Экспорт

	Выданное = УникальныеИмена.Имя("scopeown");

	Ожидаем.Что(СтрДлина(Выданное) >= 2 И СтрДлина(Выданное) <= 32,
		СтрШаблон("длина имени провайдера: %1 (%2)", СтрДлина(Выданное), Выданное)).ЭтоИстина();
	Ожидаем.Что(Лев(Выданное, 1) <> "-" И Прав(Выданное, 1) <> "-",
		"дефиса по краям нет").ЭтоИстина();

	Алфавит = "abcdefghijklmnopqrstuvwxyz0123456789-";
	Чужие = "";
	Для Позиция = 1 По СтрДлина(Выданное) Цикл
		Символ = Сред(Выданное, Позиция, 1);
		Если Найти(Алфавит, Символ) = 0 Тогда
			Чужие = Чужие + Символ;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Чужие, СтрШаблон("знаки вне алфавита провайдера в ""%1""", Выданное)).Равно("");

КонецПроцедуры

#КонецОбласти

#Область Свобода

// Два имени подряд — два разных имени: на этом стоит весь засев.
&Тест
Процедура ДваИмениПодрядРазные() Экспорт

	Первое = УникальныеИмена.Имя("u");
	Второе = УникальныеИмена.Имя("u");

	Ожидаем.Что(Первое <> Второе,
		СтрШаблон("два имени с одной приставкой: %1 и %2", Первое, Второе)).ЭтоИстина();
	Ожидаем.Что(УникальныеИмена.Хвост() <> УникальныеИмена.Хвост(),
		"два хвоста подряд тоже разные").ЭтоИстина();

КонецПроцедуры

// Сотня имён подряд — сотня разных: счётчик, который перестал расти, дал бы одно и то же
// имя всем, а набор с двумя пулами упал бы не здесь, а у соседа.
&Тест
Процедура СотняИмёнНеПовторяетсяНиРазу() Экспорт

	Выданные = Новый Соответствие();

	Для Счёт = 1 По 100 Цикл
		Выданные.Вставить(УникальныеИмена.Имя("много"), Истина);
	КонецЦикла;

	Ожидаем.Что(Выданные.Количество(), "сто вызовов — сто разных имён").Равно(100);

КонецПроцедуры

// Приставка — смысловая часть имени, по ней набор узнаёт свой стенд в базе и в логах.
&Тест
Процедура ПриставкаПопадаетВИмяИОтделенаДефисом() Экспорт

	Выданное = УникальныеИмена.Имя("cipath");

	Ожидаем.Что(СтрНачинаетсяС(Выданное, "cipath-"),
		СтрШаблон("имя начинается приставкой: %1", Выданное)).ЭтоИстина();
	Ожидаем.Что(Выданное <> "cipath-", "имя не сводится к приставке").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СвободныеНомера

// Номер строки нужен там, где внешних ключей нет и строка ссылается на кого угодно:
// два теста, взявшие один номер, читают строки друг друга и падают не там, где сломано.
&Тест
Процедура ДваНомераПодрядРазныеИНеНулевые() Экспорт

	Первый = УникальныеИмена.Номер();
	Второй = УникальныеИмена.Номер();

	Ожидаем.Что(Первый <> Второй,
		СтрШаблон("два номера подряд: %1 и %2", Первый, Второй)).ЭтоИстина();
	// нулём в хабе называют «уровень хаба» и «нет объекта»: строка с нулевым номером ничья
	Ожидаем.Что(Первый > 0, СтрШаблон("номер не ноль: %1", Первый)).ЭтоИстина();
	Ожидаем.Что(Второй > 0, СтрШаблон("и второй тоже: %1", Второй)).ЭтоИстина();

КонецПроцедуры

// Запас — это соседние номера, оставленные вызывающему: тест кладёт строки на «номер»,
// «номер + 1», «номер + 7», и ни один из них не должен достаться соседу.
&Тест
Процедура ЗапасОставляетСоседниеНомераЗаВызывающим() Экспорт

	Первый = УникальныеИмена.Номер(100);
	Второй = УникальныеИмена.Номер(100);

	Ожидаем.Что(Второй - Первый >= 100,
		СтрШаблон("между номерами запас: %1 и %2", Первый, Второй)).ЭтоИстина();

	// сотня номеров с запасом подряд: ни один сосед не попадает в чужой запас
	Выданные = Новый Соответствие();
	Для Счёт = 1 По 100 Цикл
		Начало = УникальныеИмена.Номер(10);
		Для Сдвиг = 0 По 9 Цикл
			Выданные.Вставить(Начало + Сдвиг, Истина);
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Выданные.Количество(), "сто запасов по десять — тысяча разных номеров").Равно(1000);

КонецПроцедуры

// Запас по умолчанию — один номер, и он же минимальный: запас, названный нулём или
// отрицательным числом, остановил бы счётчик и выдал бы один номер дважды.
&Тест
Процедура ЗапасПоУмолчаниюОдинИМеньшеНеБывает() Экспорт

	Первый = УникальныеИмена.Номер();
	Второй = УникальныеИмена.Номер();
	Ожидаем.Что(Второй - Первый, "запас по умолчанию — один номер").Равно(1);

	Нулевой = УникальныеИмена.Номер(0);
	Отрицательный = УникальныеИмена.Номер(-5);
	Следующий = УникальныеИмена.Номер();

	Ожидаем.Что(Нулевой <> Отрицательный, "нулевой запас счётчик не останавливает").ЭтоИстина();
	Ожидаем.Что(Отрицательный <> Следующий, "и отрицательный тоже").ЭтоИстина();

КонецПроцедуры

// Номера и имена считаются порознь: имя, взятое между двумя номерами, не сдвигает
// нумерацию строк, а номер не съедает имя.
&Тест
Процедура НомераИИменаНеОтнимаютДругУДруга() Экспорт

	Первый = УникальныеИмена.Номер();
	УникальныеИмена.Имя("между");
	УникальныеИмена.Хвост();
	Второй = УникальныеИмена.Номер();

	Ожидаем.Что(Второй - Первый, "имя между номерами нумерацию не сдвинуло").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ВременныеКаталоги

// Дверь возвращает каталог, а не имя каталога: набор кладёт в него файлы первой же
// строкой, и «создай сам» тут же вернулось бы копиями СоздатьКаталог по всему дереву.
&Тест
Процедура ВременныйКаталогСозданПустИЛежитВоВременных() Экспорт

	Путь = УникальныеИмена.ВременныйКаталог("oshub-probe");
	Убираемое.Добавить(Путь);
	Каталог = Новый Файл(Путь);

	Ожидаем.Что(Каталог.Существует(), СтрШаблон("каталог создан: %1", Путь)).ЭтоИстина();
	Ожидаем.Что(Каталог.ЭтоКаталог(), "это каталог, а не файл").ЭтоИстина();
	Ожидаем.Что(НайтиФайлы(Путь, "*").Количество(), "новый каталог пуст").Равно(0);
	Ожидаем.Что(Каталог.Путь, "каталог временных файлов системы")
		.Равно(Новый Файл(ОбъединитьПути(КаталогВременныхФайлов(), "x")).Путь);

КонецПроцедуры

// Два каталога подряд — два разных: набор, поднимающий апстрим и зеркало, писал бы
// обоих в один корень, а падал бы не на этом, а на чужих файлах в выдаче.
&Тест
Процедура ДваВременныхКаталогаПодрядНикогдаНеСовпадают() Экспорт

	Выданные = Новый Соответствие();

	Для Счёт = 1 По 20 Цикл
		Путь = УникальныеИмена.ВременныйКаталог("oshub-row");
		Убираемое.Добавить(Путь);
		Выданные.Вставить(Путь, Истина);
	КонецЦикла;

	Ожидаем.Что(Выданные.Количество(), "двадцать вызовов — двадцать разных каталогов").Равно(20);

КонецПроцедуры

// Соседний процесс — не соседний вызов: наборы гоняются дочерними процессами, и каталог,
// уникальный только внутри процесса, столкнулся бы с каталогом соседа по прогону.
&Тест
Процедура ВременныйКаталогНеСовпадаетСКаталогомСоседнегоПроцесса() Экспорт

	Свой = УникальныеИмена.ВременныйКаталог("oshub-process");
	Убираемое.Добавить(Свой);

	Чужой = ВременныйКаталогИзСоседнегоПроцесса("oshub-process");
	Убираемое.Добавить(Чужой);

	Ожидаем.Что(Свой <> Чужой,
		СтрШаблон("свой %1 и чужой %2", Свой, Чужой)).ЭтоИстина();
	Ожидаем.Что(Новый Файл(Чужой).Существует(),
		"соседний процесс тоже получил созданный каталог").ЭтоИстина();

КонецПроцедуры

// Приставка — то, по чему набор узнаёт свой мусор в /tmp и своё падение в логе.
&Тест
Процедура ПриставкаПопадаетВИмяКаталогаИФайла() Экспорт

	Каталог = УникальныеИмена.ВременныйКаталог("oshub-prefix");
	Убираемое.Добавить(Каталог);
	Файл = УникальныеИмена.ВременныйПуть("oshub-prefix", "ospx");
	Убираемое.Добавить(Файл);

	Ожидаем.Что(СтрНачинаетсяС(Новый Файл(Каталог).Имя, "oshub-prefix-"),
		СтрШаблон("имя каталога: %1", Каталог)).ЭтоИстина();
	Ожидаем.Что(СтрНачинаетсяС(Новый Файл(Файл).Имя, "oshub-prefix-"),
		СтрШаблон("имя файла: %1", Файл)).ЭтоИстина();
	Ожидаем.Что(СтрЗаканчиваетсяНа(Файл, ".ospx"), "расширение на месте").ЭтоИстина();

КонецПроцедуры

// Файл дверь не создаёт: его пишет набор. Каталог создаёт — на то и разные двери.
&Тест
Процедура ВременныйПутьЕщёНеСуществуетИЛожитсяВоВременных() Экспорт

	Путь = УникальныеИмена.ВременныйПуть("oshub-nofile");
	Убираемое.Добавить(Путь);

	Ожидаем.Что(Новый Файл(Путь).Существует(), "файла ещё нет — его пишет набор").ЭтоЛожь();
	Ожидаем.Что(Новый Файл(Путь).Путь, "каталог временных файлов системы")
		.Равно(Новый Файл(ОбъединитьПути(КаталогВременныхФайлов(), "x")).Путь);
	Ожидаем.Что(Найти(Новый Файл(Путь).Имя, "."), "без расширения имя без точки").Равно(0);

КонецПроцедуры

// Уборка снимает каталог СО ВСЕМ содержимым: набор оставляет в песочнице базу и ospx,
// а уборка «только пустой каталог» копила бы их прогон за прогоном.
&Тест
Процедура УборкаСнимаетКаталогСоВложениямиИФайл() Экспорт

	Каталог = УникальныеИмена.ВременныйКаталог("oshub-cleanup");
	Вложенный = ОбъединитьПути(Каталог, "внутри");
	СоздатьКаталог(Вложенный);
	ЗаписатьСтрокуВФайл(ОбъединитьПути(Вложенный, "данные.txt"), "мусор");

	Файл = УникальныеИмена.ВременныйПуть("oshub-cleanup", "txt");
	ЗаписатьСтрокуВФайл(Файл, "мусор");

	УникальныеИмена.УбратьВременное(Каталог);
	УникальныеИмена.УбратьВременное(Файл);

	Ожидаем.Что(Новый Файл(Каталог).Существует(),
		СтрШаблон("каталог убран со вложениями: %1", Каталог)).ЭтоЛожь();
	Ожидаем.Что(Новый Файл(Файл).Существует(),
		СтрШаблон("файл убран: %1", Файл)).ЭтоЛожь();

КонецПроцедуры

// Уборка зовётся в &ПослеВсех, когда тест уже упал: исключение из неё затёрло бы
// причину падения. Поэтому пустой путь, чужой путь и повторная уборка проходят молча.
&Тест
Процедура УборкаМолчитНаПустомНесуществующемИПовторном() Экспорт

	Каталог = УникальныеИмена.ВременныйКаталог("oshub-silent");

	УникальныеИмена.УбратьВременное("");
	УникальныеИмена.УбратьВременное(Неопределено);
	УникальныеИмена.УбратьВременное(ОбъединитьПути(КаталогВременныхФайлов(), "oshub-nothing-" + УникальныеИмена.Хвост()));
	УникальныеИмена.УбратьВременное(Каталог);
	УникальныеИмена.УбратьВременное(Каталог);

	Ожидаем.Что(Новый Файл(Каталог).Существует(), "каталог убран").ЭтоЛожь();

КонецПроцедуры

// Дочерний oscript зовёт ту же дверь и печатает выданный путь: своего счётчика
// у процесса нет, поэтому «первый каталог первого процесса» столкнулся бы с «первым
// каталогом второго» — а наборы гоняются именно дочерними процессами.
Функция ВременныйКаталогИзСоседнегоПроцесса(Знач Приставка)

	Песочница = УникальныеИмена.ВременныйКаталог("oshub-neighbour");
	Убираемое.Добавить(Песочница);
	Сценарий = ОбъединитьПути(Песочница, "сосед.os");

	Запись = Новый ЗаписьТекста(Сценарий, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(СтрШаблон("#Использовать ""%1""", КаталогФикстур));
	Запись.ЗаписатьСтроку(
		СтрШаблон("Сообщить(УникальныеИмена.ВременныйКаталог(""%1""));", Приставка));
	Запись.Закрыть();

	Сосед = СоздатьПроцесс(СтрШаблон("oscript ""%1""", Сценарий), , Истина);
	Сосед.Запустить();
	Сосед.ОжидатьЗавершения();

	Если Сосед.КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("Соседний процесс завершился с кодом %1: %2",
			Сосед.КодВозврата, Сосед.ПолучитьВыводПотокаОшибок());
	КонецЕсли;

	Возврат СокрЛП(Сосед.ПотокВывода.Прочитать());

КонецФункции

// Файл с одной строкой: тесту уборки нужно, чтобы в каталоге лежало содержимое.
Процедура ЗаписатьСтрокуВФайл(Знач Путь, Знач Текст)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(Текст);
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СольЗапуска

// Счётчика мало: он начинается заново в каждом процессе, а база живого хаба процесс
// переживает. Соль запуска — это то, чем прогон отличается от прогона; имя без неё
// столкнулось бы с именем прошлого прогона в той же базе.
&Тест
Процедура СольВходитВКаждоеИмяИОдинаковаВПределахПроцесса() Экспорт

	Соль = УникальныеИмена.Соль();

	Ожидаем.Что(ЗначениеЗаполнено(Соль), "соль запуска задана").ЭтоИстина();
	Ожидаем.Что(СтрДлина(Соль), "длина соли").Равно(6);
	Ожидаем.Что(СтрНайти(УникальныеИмена.Имя("s"), Соль) > 0, "соль входит в имя").ЭтоИстина();
	Ожидаем.Что(СтрНайти(УникальныеИмена.Хвост(), Соль) > 0, "соль входит в хвост").ЭтоИстина();
	Ожидаем.Что(УникальныеИмена.Соль(), "внутри процесса соль одна").Равно(Соль);

КонецПроцедуры

// Соль — не порядковый номер: она берётся из источника, разного у разных процессов.
// Знаки шестнадцатеричные, потому что источник — идентификатор запуска.
&Тест
Процедура СольНеВыводитсяИзСчётчика() Экспорт

	Соль = УникальныеИмена.Соль();

	Чужие = "";
	Для Позиция = 1 По СтрДлина(Соль) Цикл
		Символ = Сред(Соль, Позиция, 1);
		Если Найти("0123456789abcdef", Символ) = 0 Тогда
			Чужие = Чужие + Символ;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Чужие, СтрШаблон("знаки вне шестнадцатеричных в соли ""%1""", Соль)).Равно("");
	Ожидаем.Что(Соль <> "1", "соль не равна номеру первого имени").ЭтоИстина();

КонецПроцедуры

#КонецОбласти
