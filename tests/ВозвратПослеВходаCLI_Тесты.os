// HTTP-сценарий «opm login --browser» на настоящем хабе: аноним идёт по ссылке
// подтверждения с кодом, входит любой веткой (пароль, внешний провайдер, регистрация)
// и обязан вернуться на страницу подтверждения с тем же кодом, а не в кабинет.
// Запрос каждой ветки собирается ИЗ ВЫДАННОЙ РАЗМЕТКИ: адрес действия, имена полей
// и адрес возврата читаются из HTML, а не пишутся в тесте руками.

#Использовать asserts
#Использовать 1connector
#Использовать "фикстуры"

Перем Хаб;
Перем Клиент; // фикстура КлиентХаба — запросы к подопытному хабу
Перем IdP;
Перем Порт;
Перем ЛогинЧеловека;
Перем ПарольЧеловека;
Перем ИмяПровайдера;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	ЛогинЧеловека = "vozvrashenets";
	ПарольЧеловека = "password123";
	ИмяПровайдера = "fake";
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьСтенд() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ЭкземплярФейковогоIdP");

	IdP = Новый ЭкземплярФейковогоIdP("хаб-клиент", "субъект-возвращенца", "provider@example.com");
	IdP.Запустить();

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	Хаб.ФайловаяБаза("openhub-возврат-входа");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	// инсталляция без почты выбирает одну из двух развилок (ИСТ-ПОЧТ-007); здесь —
	// выключенное подтверждение адреса, иначе регистрация закрыта
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");
	Хаб.Среда("OSHUB_OIDC_PROVIDERS", ИмяПровайдера);
	Хаб.Среда("OSHUB_OIDC_FAKE_LABEL", "Фейковый IdP");
	Хаб.Среда("OSHUB_OIDC_FAKE_ISSUER", IdP.Издатель());
	Хаб.Среда("OSHUB_OIDC_FAKE_CLIENT_ID", "хаб-клиент");
	Хаб.Среда("OSHUB_OIDC_FAKE_CLIENT_SECRET", "секрет-хаб-клиента");
	// порт хаба выдаётся только в Запустить(), поэтому адрес возврата здесь условный:
	// браузер в тесте берёт из ответа IdP путь и запрос, а идёт на реальный порт хаба
	Хаб.Среда("OSHUB_OIDC_FAKE_REDIRECT_URI", "http://localhost/oidc/callback");
	Хаб.Среда("OSHUB_OIDC_FAKE_AUTOPROVISION", "true");
	Хаб.Запустить();
	Порт = Хаб.Порт();

	POSTjson("/setup", "{""логин"":""root"",""пароль"":""SuperSecret1""}");

	Регистрация = POSTjson("/api/v1/register", СтрШаблон(
		"{""логин"":""%1"",""email"":""%1@example.com"",""пароль"":""%2""}",
		ЛогинЧеловека, ПарольЧеловека));
	Если Регистрация.КодСостояния <> 201 Тогда
		ВызватьИсключение "Подопытный человек не заведён: " + Клиент.Тело(Регистрация);
	КонецЕсли;

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьСтенд() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
		Хаб = Неопределено;
	КонецЕсли;
	Если IdP <> Неопределено Тогда
		IdP.Остановить();
		IdP = Неопределено;
	КонецЕсли;

КонецПроцедуры

#Область ВеткиВхода

&Тест
Процедура ПаролемЧеловекПопадаетНаПодтверждениеСКодом() Экспорт

	Код = НовыйКодЗаявки();
	Вход = СтраницаВходаПоСсылкеСКодом(Код);

	Ожидаем.Что(СтрНайти(Вход, "action=""/login""") > 0, "аноним получил форму входа").ЭтоИстина();
	Возврат_ = СкрытоеПоле(Вход, "next");
	Ожидаем.Что(Возврат_, "форма входа помнит, куда вернуть человека")
		.Равно("/cli/login?user_code=" + Код);

	Решение = ВойтиПаролем(Возврат_, ПарольЧеловека);
	Ожидаем.Что(Локейшн(Решение), "после входа человек уходит на подтверждение кода")
		.Равно("/cli/login?user_code=" + Код);

	Подтверждение = GET_Кука(Локейшн(Решение), КукаПоИмени(Решение, "oshub_session"));
	Ожидаем.Что(Подтверждение.КодСостояния).Равно(200);
	ПроверитьСтраницуПодтверждения(Клиент.Тело(Подтверждение), Код);

КонецПроцедуры

&Тест
Процедура ЧерезПровайдераЧеловекПопадаетНаПодтверждениеСКодом() Экспорт

	Код = НовыйКодЗаявки();
	Вход = СтраницаВходаПоСсылкеСКодом(Код);

	АдресПровайдера = АдресКнопкиПровайдера(Вход);
	Ожидаем.Что(СтрНайти(АдресПровайдера, "next=") > 0,
		"кнопка провайдера несёт адрес возврата: " + АдресПровайдера).ЭтоИстина();

	Старт = GET_БезПереходов(АдресПровайдера, "");
	Ожидаем.Что(Старт.КодСостояния, "старт входа уводит к провайдеру").Равно(302);
	КукаТранзакции = КукаПоИмени(Старт, "oshub_oidc_txn");
	Ожидаем.Что(ЗначениеЗаполнено(КукаТранзакции), "ключ транзакции выдан браузеру").ЭтоИстина();

	// адрес возврата — серверное состояние: провайдеру его не показывают
	АдресIdP = Локейшн(Старт);
	Ожидаем.Что(СтрНайти(АдресIdP, "next="), "у провайдера параметра возврата нет").Равно(0);
	Ожидаем.Что(СтрНайти(АдресIdP, "user_code"), "и кода заявки у него тоже нет").Равно(0);
	Ожидаем.Что(СтрНайти(АдресIdP, "cli%2Flogin"), "и следа страницы подтверждения").Равно(0);

	Возврат_ = ВернутьсяОтПровайдера(АдресIdP, КукаТранзакции);
	Ожидаем.Что(Локейшн(Возврат_), "после входа через провайдера человек уходит на подтверждение")
		.Равно("/cli/login?user_code=" + Код);

	Подтверждение = GET_Кука(Локейшн(Возврат_), КукаПоИмени(Возврат_, "oshub_session"));
	Ожидаем.Что(Подтверждение.КодСостояния).Равно(200);
	ПроверитьСтраницуПодтверждения(Клиент.Тело(Подтверждение), Код);

КонецПроцедуры

&Тест
Процедура ЧерезРегистрациюЧеловекПопадаетНаПодтверждениеСКодом() Экспорт

	Код = НовыйКодЗаявки();
	Вход = СтраницаВходаПоСсылкеСКодом(Код);

	АдресРегистрации = АдресСсылкиРегистрации(Вход);
	Ожидаем.Что(СтрНайти(АдресРегистрации, "next=") > 0,
		"ссылка на регистрацию несёт адрес возврата: " + АдресРегистрации).ЭтоИстина();

	Форма = Клиент.Тело(GET(АдресРегистрации));
	Ожидаем.Что(СкрытоеПоле(Форма, "next"), "форма регистрации помнит адрес возврата")
		.Равно("/cli/login?user_code=" + Код);

	// передумал регистрироваться — ссылка «Войти» возвращает на вход с тем же адресом
	Ожидаем.Что(СтрНайти(Форма, "href=""/login?next=%2Fcli%2Flogin%3Fuser_code%3D" + Код + """") > 0,
		"со страницы регистрации можно вернуться на вход, не потеряв адрес").ЭтоИстина();

	Новичок = "novichok" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0; ЧН=0");
	Поля = Новый Соответствие();
	Поля.Вставить("логин", Новичок);
	Поля.Вставить("email", Новичок + "@example.com");
	Поля.Вставить("пароль", "password123");
	Поля.Вставить("next", СкрытоеПоле(Форма, "next"));

	Ответ = POSTФормыБезПереходов("/register", КодироватьФорму(Поля), "");
	Ожидаем.Что(Локейшн(Ответ), "после регистрации человек уходит на подтверждение кода")
		.Равно("/cli/login?user_code=" + Код);

	Подтверждение = GET_Кука(Локейшн(Ответ), КукаПоИмени(Ответ, "oshub_session"));
	ПроверитьСтраницуПодтверждения(Клиент.Тело(Подтверждение), Код);

КонецПроцедуры

&Тест
Процедура НеверныйПарольНеТеряетАдресВозврата() Экспорт

	Код = НовыйКодЗаявки();
	Возврат_ = СкрытоеПоле(СтраницаВходаПоСсылкеСКодом(Код), "next");

	Отказ = ВойтиПаролем(Возврат_, "НЕВЕРНЫЙ-ПАРОЛЬ");
	Ожидаем.Что(Отказ.КодСостояния, "неверный пароль — отказ, а не редирект").Равно(401);

	Перерисованная = Отказ.Текст();
	Ожидаем.Что(СкрытоеПоле(Перерисованная, "next"),
		"перерисованная форма входа помнит адрес возврата").Равно("/cli/login?user_code=" + Код);
	Ожидаем.Что(СтрНайти(АдресКнопкиПровайдера(Перерисованная), "next=") > 0,
		"и кнопка провайдера на ней тоже").ЭтоИстина();

	// со второй попытки тот же адрес доводит человека до подтверждения
	Успех = ВойтиПаролем(СкрытоеПоле(Перерисованная, "next"), ПарольЧеловека);
	Ожидаем.Что(Локейшн(Успех)).Равно("/cli/login?user_code=" + Код);

КонецПроцедуры

#КонецОбласти

#Область ОдноразовостьТранзакции

&Тест
Процедура ОтказПровайдераГаситТранзакцию() Экспорт

	// Транзакция одноразовая в ЛЮБОМ исходе: после «провайдер отклонил вход» честный код
	// по той же куке войти уже не должен — иначе отказ оставляет живой ключ входа.
	Старт = GET_БезПереходов("/login/oidc/" + ИмяПровайдера + "?next=%2Fme%2Ftokens", "");
	Кука = КукаПоИмени(Старт, "oshub_oidc_txn");
	АдресСогласия = Локейшн(Старт);

	Отказ = GET_БезПереходов("/oidc/callback?error=access_denied", "oshub_oidc_txn=" + Кука);
	Ожидаем.Что(Отказ.КодСостояния, "отказ провайдера — страница входа").Равно(400);

	Согласие = GET_БезПереходовПоАдресу(АдресСогласия, "");
	Поздний = GET_БезПереходов(ПутьСЗапросом(Локейшн(Согласие)), "oshub_oidc_txn=" + Кука);

	Ожидаем.Что(ЗначениеЗаполнено(КукаПоИмени(Поздний, "oshub_session")),
		"погашенная отказом транзакция входа не даёт").ЭтоЛожь();
	Ожидаем.Что(Локейшн(Поздний), "и никуда не уводит").Равно("");

КонецПроцедуры

&Тест
Процедура ПовторныйCallbackНеВходитИНеУводит() Экспорт

	Старт = GET_БезПереходов("/login/oidc/" + ИмяПровайдера + "?next=%2Fme%2Ftokens", "");
	Кука = КукаПоИмени(Старт, "oshub_oidc_txn");
	Согласие = GET_БезПереходовПоАдресу(Локейшн(Старт), "");
	ПутьВозврата = ПутьСЗапросом(Локейшн(Согласие));

	Первый = GET_БезПереходов(ПутьВозврата, "oshub_oidc_txn=" + Кука);
	Ожидаем.Что(Локейшн(Первый), "КОНТРОЛЬ: первый callback входит и уводит по адресу")
		.Равно("/me/tokens");
	Ожидаем.Что(ЗначениеЗаполнено(КукаПоИмени(Первый, "oshub_session")),
		"КОНТРОЛЬ: сессия выдана").ЭтоИстина();

	Второй = GET_БезПереходов(ПутьВозврата, "oshub_oidc_txn=" + Кука);
	Ожидаем.Что(Второй.КодСостояния, "повтор того же callback — отказ").Равно(400);
	Ожидаем.Что(ЗначениеЗаполнено(КукаПоИмени(Второй, "oshub_session")),
		"повтор сессии не выдаёт").ЭтоЛожь();
	Ожидаем.Что(Локейшн(Второй), "и никуда не редиректит").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ЧужойАдресВозврата

&Тест
Процедура ПаролемЧужойАдресВозвратаНеУводитСХаба() Экспорт

	// КОНТРОЛЬ: законный путь этого хаба доезжает до редиректа
	Ожидаем.Что(Локейшн(ВойтиПаролем("/me/tokens", ПарольЧеловека)),
		"КОНТРОЛЬ: свой путь принимается").Равно("/me/tokens");

	Для Каждого Чужой Из ЧужиеАдреса() Цикл
		Ожидаем.Что(Локейшн(ВойтиПаролем(Чужой, ПарольЧеловека)),
			"чужой адрес возврата <" + Чужой + "> не уводит с хаба").Равно("/me");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ЧерезПровайдераЧужойАдресВозвратаНеУводитСХаба() Экспорт

	// КОНТРОЛЬ: законный путь переживает круг через провайдера
	Ожидаем.Что(Локейшн(ВойтиПровайдером("/me/tokens")),
		"КОНТРОЛЬ: свой путь принимается").Равно("/me/tokens");

	Для Каждого Чужой Из ЧужиеАдреса() Цикл
		Ожидаем.Что(Локейшн(ВойтиПровайдером(Чужой)),
			"чужой адрес возврата <" + Чужой + "> не уводит с хаба").Равно("/me");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ЧужойАдресВозвратаНеПопадаетНиВРазметкуНиКПровайдеру() Экспорт

	Страница = Клиент.Тело(GET("/login?next=" + КодироватьСтроку("https://evil.example/украсть",
		СпособКодированияСтроки.КодировкаURL)));

	Ожидаем.Что(СтрНайти(Страница, "evil.example"), "чужой адрес в разметку не попадает").Равно(0);
	Ожидаем.Что(СтрНайти(Страница, "name=""next"""), "поля возврата на странице нет вовсе").Равно(0);
	Ожидаем.Что(СтрНайти(АдресКнопкиПровайдера(Страница), "next="),
		"и кнопка провайдера чужой адрес не несёт").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СценарийВхода

// Аноним по verification_uri_complete: клиент сам идёт по редиректу, поэтому в ответе —
// уже страница входа.
Функция СтраницаВходаПоСсылкеСКодом(Знач Код)

	Ответ = GET("/cli/login?user_code=" + Код);
	Ожидаем.Что(Ответ.КодСостояния, "аноним не получает ошибку").Равно(200);
	Возврат Клиент.Тело(Ответ);

КонецФункции

Функция ВойтиПаролем(Знач АдресВозврата, Знач Пароль)

	Поля = Новый Соответствие();
	Поля.Вставить("логин", ЛогинЧеловека);
	Поля.Вставить("пароль", Пароль);
	Поля.Вставить("next", АдресВозврата);

	Возврат POSTФормыБезПереходов("/login", КодироватьФорму(Поля), "");

КонецФункции

// Полный круг через провайдера: старт → IdP → callback хаба. Возвращает ответ callback.
Функция ВойтиПровайдером(Знач АдресВозврата)

	Старт = GET_БезПереходов("/login/oidc/" + ИмяПровайдера + "?next="
		+ КодироватьСтроку(АдресВозврата, СпособКодированияСтроки.КодировкаURL), "");

	Возврат ВернутьсяОтПровайдера(Локейшн(Старт), КукаПоИмени(Старт, "oshub_oidc_txn"));

КонецФункции

// Браузер идёт к провайдеру и возвращается на хаб. Порт в адресе возврата у фейкового IdP
// условный (хаб не знает своего порта до старта), поэтому идём по пути и запросу.
Функция ВернутьсяОтПровайдера(Знач АдресIdP, Знач КукаТранзакции)

	Согласие = GET_БезПереходовПоАдресу(АдресIdP, "");
	Ожидаем.Что(Согласие.КодСостояния, "провайдер вернул браузер на хаб").Равно(302);

	Возврат GET_БезПереходов(ПутьСЗапросом(Локейшн(Согласие)),
		"oshub_oidc_txn=" + КукаТранзакции);

КонецФункции

Функция НовыйКодЗаявки()

	Ответ = POSTjson("/api/v1/cli/auth/device",
		"{""client_name"":""opm 1.6.6"",""scopes"":""read""}");
	Ожидаем.Что(Ответ.КодСостояния, "заявка CLI заведена").Равно(201);
	Возврат Строка(JSON(Ответ).Получить("user_code"));

КонецФункции

Процедура ПроверитьСтраницуПодтверждения(Знач Страница, Знач Код)

	Ожидаем.Что(СтрНайти(Страница, "Разрешить вход клиента?") > 0,
		"человек видит именно страницу подтверждения, а не кабинет").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, Код) > 0, "и код заявки уже подставлен").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "name=""user_code"" value=""" + Код + """") > 0,
		"код уехал в форму решения — повторно вводить его не нужно").ЭтоИстина();

КонецПроцедуры

Функция ЧужиеАдреса()

	// только ASCII: чужой адрес обязан доехать до заголовка Location как есть, иначе
	// провал теста объяснялся бы кодировкой, а не открытым редиректом
	Адреса = Новый Массив();
	Адреса.Добавить("https://evil.example/steal");
	Адреса.Добавить("//evil.example/steal");
	Адреса.Добавить("javascript:alert(1)");
	Адреса.Добавить("/cli/login" + Символы.ПС + "Set-Cookie: fake=1");
	Адреса.Добавить("\\evil.example\steal");
	Возврат Адреса;

КонецФункции

#КонецОбласти

#Область ЧтениеРазметки

Функция СкрытоеПоле(Знач Страница, Знач Имя)
	Возврат ЗначениеПослеМаркера(Страница, "name=""" + Имя + """ value=""");
КонецФункции

Функция АдресКнопкиПровайдера(Знач Страница)
	Возврат АдресПоПрефиксу(Страница, "/login/oidc/");
КонецФункции

Функция АдресСсылкиРегистрации(Знач Страница)
	Возврат АдресПоПрефиксу(Страница, "/register");
КонецФункции

// Ссылка целиком: маркер ищет её по началу пути, но в результат путь входит полностью —
// иначе тест пошёл бы не туда, куда ведёт разметка.
Функция АдресПоПрефиксу(Знач Страница, Знач Префикс)

	Хвост = ЗначениеПослеМаркера(Страница, "href=""" + Префикс);
	Возврат ?(СтрНайти(Страница, "href=""" + Префикс) = 0, "",
		Префикс + РаскодироватьHTML(Хвост));

КонецФункции

// Значение атрибута, начинающегося маркером: от конца маркера до ближайшей кавычки.
Функция ЗначениеПослеМаркера(Знач Страница, Знач Маркер)

	Начало = СтрНайти(Страница, Маркер);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Страница, Начало + СтрДлина(Маркер));
	Кавычка = СтрНайти(Хвост, """");
	Возврат ?(Кавычка = 0, "", Лев(Хвост, Кавычка - 1));

КонецФункции

Функция РаскодироватьHTML(Знач Текст)
	Возврат СтрЗаменить(СтрЗаменить(Текст, "&amp;", "&"), "&#39;", "'");
КонецФункции

Функция ПутьСЗапросом(Знач Адрес)

	Позиция = СтрНайти(Адрес, "://");
	Если Позиция = 0 Тогда
		Возврат Адрес;
	КонецЕсли;

	Хвост = Сред(Адрес, Позиция + 3);
	Слеш = СтрНайти(Хвост, "/");
	Возврат ?(Слеш = 0, "/", Сред(Хвост, Слеш));

КонецФункции

#КонецОбласти

#Область HTTP

Функция GET(Знач Путь)
	Возврат Клиент.Соединение().Получить(Новый HTTPЗапрос(Путь, ЗаголовкиHTML("")));
КонецФункции

Функция GET_Кука(Знач Путь, Знач Кука)
	Возврат Клиент.Соединение().Получить(Новый HTTPЗапрос(Путь, ЗаголовкиHTML("oshub_session=" + Кука)));
КонецФункции

Функция GET_БезПереходов(Знач Путь, Знач СтрокаКуки)
	Возврат GET_БезПереходовПоАдресу(Адрес(Путь), СтрокаКуки);
КонецФункции

// Запрос БЕЗ следования редиректам (1connector): штатный HTTPСоединение переходы
// выполняет сам, и проверить сам факт редиректа им нельзя.
Функция GET_БезПереходовПоАдресу(Знач ПолныйАдрес, Знач СтрокаКуки)

	Сессия = Новый Сессия();
	Сессия.Заголовки.Вставить("Accept", "text/html");
	Если ЗначениеЗаполнено(СтрокаКуки) Тогда
		Сессия.Заголовки.Вставить("Cookie", СтрокаКуки);
	КонецЕсли;

	Возврат Сессия.ВызватьМетод("GET", ПолныйАдрес,
		Новый Структура("РазрешитьПеренаправление", Ложь));

КонецФункции

Функция POSTФормыБезПереходов(Знач Путь, Знач ТелоФормы, Знач СтрокаКуки)

	Сессия = Новый Сессия();
	Сессия.Заголовки.Вставить("Accept", "text/html");
	Сессия.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Если ЗначениеЗаполнено(СтрокаКуки) Тогда
		Сессия.Заголовки.Вставить("Cookie", СтрокаКуки);
	КонецЕсли;

	Возврат Сессия.ВызватьМетод("POST", Адрес(Путь),
		Новый Структура("РазрешитьПеренаправление, Данные", Ложь, ТелоФормы));

КонецФункции

Функция POSTjson(Знач Путь, Знач ТелоЗапроса)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
	Возврат Клиент.Соединение().ОтправитьДляОбработки(Запрос);

КонецФункции

Функция ЗаголовкиHTML(Знач СтрокаКуки)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept", "text/html");
	Если ЗначениеЗаполнено(СтрокаКуки) Тогда
		Заголовки.Вставить("Cookie", СтрокаКуки);
	КонецЕсли;
	Возврат Заголовки;

КонецФункции

Функция КодироватьФорму(Знач Поля)

	Части = Новый Массив();
	Для Каждого КиЗ Из Поля Цикл
		Части.Добавить(КодироватьСтроку(Строка(КиЗ.Ключ), СпособКодированияСтроки.КодировкаURL)
			+ "=" + КодироватьСтроку(Строка(КиЗ.Значение), СпособКодированияСтроки.КодировкаURL));
	КонецЦикла;
	Возврат СтрСоединить(Части, "&");

КонецФункции

Функция Адрес(Знач Путь)
	Возврат СтрШаблон("http://localhost:%1%2", Формат(Порт, "ЧГ=0; ЧН=0"), Путь);
КонецФункции

Функция JSON(Знач Ответ)

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

Функция Локейшн(Знач Ответ)

	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = "LOCATION" Тогда
			Возврат Строка(КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция КукаПоИмени(Знач Ответ, Знач Имя)

	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) <> "SET-COOKIE" Тогда
			Продолжить;
		КонецЕсли;
		Значение = ЗначениеКуки(Строка(КиЗ.Значение), Имя);
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция ЗначениеКуки(Знач СтрокаКук, Знач Имя)

	Маркер = Имя + "=";
	Поз = СтрНайти(СтрокаКук, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(СтрокаКук, Поз + СтрДлина(Маркер));
	Конец = СтрДлина(Остаток) + 1;
	ТочкаЗпт = СтрНайти(Остаток, ";");
	Если ТочкаЗпт > 0 И ТочкаЗпт < Конец Тогда
		Конец = ТочкаЗпт;
	КонецЕсли;
	Запятая = СтрНайти(Остаток, ",");
	Если Запятая > 0 И Запятая < Конец Тогда
		Конец = Запятая;
	КонецЕсли;

	Возврат СокрЛП(Лев(Остаток, Конец - 1));

КонецФункции

#КонецОбласти
