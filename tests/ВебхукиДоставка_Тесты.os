// Юнит-тесты доставки вебхуков (модуль подписки): очередь и успешная доставка, подпись
// X-OpenHub-Signature, ретрай с бэкоффом и лимитом, гейт delivery_enabled, ограничение
// очереди, переживание перезапуска.

#Использовать asserts
#Использовать autumn-logos
#Использовать pwhash
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогКлассов;
Перем КаталогФикстур;
Перем Хранилище;   // ФейкХранилищеЗаданийДоставки — очередь, переживающая пересоздание службы

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассов = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"), "подписки", "Классы");
	КаталогФикстур = ОбъединитьПути(КаталогТестов, "фикстуры");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(КаталогКлассов, "СлужбаДоставкиПодписок");
	ПоискКлассов.Подключить(КаталогКлассов, "ОчередьДоставокПодписок");
	ПоискКлассов.Подключить(КаталогКлассов, "РеестрДействийПодписок");
	КаталогВебхука = ОбъединитьПути(ОбъединитьПути(КаталогКлассов, "обработчики"), "вебхук");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогВебхука, "ДоставкаВебхуком.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогВебхука, "ХранениеПодпискиВебхука.os"));
	КаталогCommon = ОбъединитьПути(ОбъединитьПути(КаталогКлассов, "..", ".."), "основа", "Классы");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогCommon, "ПриведениеЧисел.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогCommon, "ТекстОшибки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкТранспортHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкВалидаторВебхука.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкЗаданиеДоставкиЗапись.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ФейкХранилищеЗаданийДоставки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ЛовушкаЛога.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "НастройкиЗаглушка.os"));
КонецПроцедуры

// Хранилище очереди — общее на тест: «перезапуск» это новая служба над теми же данными.
&ПередКаждым
Процедура ЗавестиХранилище() Экспорт
	Хранилище = Новый ФейкХранилищеЗаданийДоставки();
КонецПроцедуры

&Тест
Процедура УспешнаяДоставкаОпустошаетОчередьИШлётЗаголовки() Экспорт

	Транспорт = Новый ФейкТранспортHTTP();
	Транспорт.УстановитьОтвет(200);
	Служба = НоваяСлужба(Транспорт, 3, 10);
	Момент = Дата(2026, 1, 1, 12, 0, 0);

	ИдДоставки = Служба.Поставить("вебхук", Действие("https://example.com/hook", "секрет-1"), "версия.опубликована", "{""тип"":""версия.опубликована""}", Момент);
	Ожидаем.Что(Служба.РазмерОчереди(), "одно задание в очереди").Равно(1);

	Итог = Служба.ОбработатьПартию(Момент);

	Ожидаем.Что(Итог.Доставлено, "доставлено одно").Равно(1);
	Ожидаем.Что(Служба.РазмерОчереди(), "очередь пуста после успеха").Равно(0);
	Ожидаем.Что(Транспорт.URLПоследний(), "POST ушёл на цель").Равно("https://example.com/hook");
	Ожидаем.Что(Транспорт.ТелоПоследнее(), "тело доставлено как есть").Равно("{""тип"":""версия.опубликована""}");
	Ожидаем.Что(Транспорт.ЗаголовокПоследний("X-OpenHub-Event"), "заголовок типа события").Равно("версия.опубликована");
	Ожидаем.Что(Транспорт.ЗаголовокПоследний("X-OpenHub-Delivery"), "идемпотентный id доставки в заголовке").Равно(ИдДоставки);
	// подпись сверяется с НЕЗАВИСИМО посчитанным HMAC: «заголовок непуст» пропустил бы подпись чужим секретом
	ОжидаемаяПодпись = "sha256=" + НРег(ПолучитьHexСтрокуИзДвоичныхДанных(
		ХешированиеПаролей.HMACSHA256("секрет-1", "{""тип"":""версия.опубликована""}")));
	Ожидаем.Что(Транспорт.ЗаголовокПоследний("X-OpenHub-Signature"),
		"подпись доставки = HMAC(секрет задания, тело)").Равно(ОжидаемаяПодпись);
	Ожидаем.Что(Найти(Транспорт.ЗаголовокПоследний("Content-Type"), "application/json") > 0, "Content-Type JSON").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПодписьСовпадаетСНезависимымHMAC() Экспорт

	Обработчик = НовыйОбработчикВебхука(Новый ФейкТранспортHTTP(), Новый ФейкВалидаторВебхука());
	Тело = "{""a"":1}";
	Секрет = "мой-секрет";

	Ожидаемая = "sha256=" + НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешированиеПаролей.HMACSHA256(Секрет, Тело)));
	Ожидаем.Что(Обработчик.Подпись(Секрет, Тело), "подпись = sha256=<HMAC-SHA256 pwhash>").Равно(Ожидаемая);

КонецПроцедуры

&Тест
Процедура ПодписьИдемпотентнаИЗависитОтСекретаИТела() Экспорт

	Обработчик = НовыйОбработчикВебхука(Новый ФейкТранспортHTTP(), Новый ФейкВалидаторВебхука());

	Ожидаем.Что(Обработчик.Подпись("s", "body"), "одинаковый вход → одинаковая подпись").Равно(Обработчик.Подпись("s", "body"));
	Ожидаем.Что(Обработчик.Подпись("s", "body") = Обработчик.Подпись("s2", "body"), "другой секрет → другая подпись").ЭтоЛожь();
	Ожидаем.Что(Обработчик.Подпись("s", "body") = Обработчик.Подпись("s", "body2"), "другое тело → другая подпись").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СетевойСбойИзолированИЗаданиеПовторяется() Экспорт

	Транспорт = Новый ФейкТранспортHTTP();
	Транспорт.ЭмулироватьОффлайн(); // Отправить бросает исключение
	Служба = НоваяСлужба(Транспорт, 5, 10);

	Момент = Дата(2026, 1, 1, 12, 0, 0);
	Служба.Поставить("вебхук", Действие("https://example.com/hook", "s"), "версия.опубликована", "{}", Момент);

	Итог = Служба.ОбработатьПартию(Момент); // сбой изолирован, партия не падает

	Ожидаем.Что(Итог.Повторно, "задание поставлено на повтор").Равно(1);
	Ожидаем.Что(Итог.Доставлено, "ничего не доставлено").Равно(0);
	Ожидаем.Что(Служба.РазмерОчереди(), "задание вернулось в очередь").Равно(1);

КонецПроцедуры

&Тест
Процедура НезрелоеЗаданиеНеЗабираетсяРаньшеБэкоффа() Экспорт

	Транспорт = Новый ФейкТранспортHTTP();
	Транспорт.УстановитьОтвет(500); // не-2xx → неуспех
	Служба = НоваяСлужба(Транспорт, 5, 10); // база бэкоффа 10с

	Момент = Дата(2026, 1, 1, 12, 0, 0);
	Служба.Поставить("вебхук", Действие("https://example.com/hook", "s"), "версия.опубликована", "{}", Момент);

	Служба.ОбработатьПартию(Момент);        // попытка 1 неуспех → бэкофф 10с (НеРанее = +10с)

	Итог2 = Служба.ОбработатьПартию(Момент);
	Ожидаем.Что(Итог2.Доставлено + Итог2.Повторно + Итог2.Отброшено, "незрелое задание не берётся").Равно(0);
	Ожидаем.Что(Служба.РазмерОчереди(), "задание ждёт в очереди").Равно(1);

	Итог3 = Служба.ОбработатьПартию(Момент + 10);
	Ожидаем.Что(Итог3.Повторно, "после бэкоффа задание снова обработано").Равно(1);

КонецПроцедуры

&Тест
Процедура РетраиОграниченыМаксПопыток() Экспорт

	Транспорт = Новый ФейкТранспортHTTP();
	Транспорт.УстановитьОтвет(500); // всегда неуспех
	Служба = НоваяСлужба(Транспорт, 3, 1); // МаксПопыток=3, база бэкоффа=1с

	Служба.Поставить("вебхук", Действие("https://example.com/hook", "s"), "версия.опубликована", "{}", Дата(2026, 1, 1, 0, 0, 0));

	Итог = Неопределено;
	Момент = Дата(2026, 1, 1, 0, 0, 0);
	Для Шаг = 1 По 10 Цикл
		Итог = Служба.ОбработатьПартию(Момент);
		Момент = Момент + 3600; // заведомо больше любого бэкоффа
	КонецЦикла;

	Ожидаем.Что(Служба.РазмерОчереди(), "после исчерпания попыток задание отброшено (хаб не заddos-ит цель)").Равно(0);
	Ожидаем.Что(Транспорт.КоличествоВызовов(), "ровно МаксПопыток сетевых попыток").Равно(3);

КонецПроцедуры

&Тест
Процедура ОтказПроверкиПередДоставкойСнимаетЗаданиеБезРетраев() Экспорт

	Транспорт = Новый ФейкТранспортHTTP();
	Транспорт.УстановитьОтвет(200);
	Валидатор = Новый ФейкВалидаторВебхука();
	Валидатор.Запретить("broken.target"); // сохранённая строка перестала быть адресом
	Служба = НоваяСлужбаПолная(Транспорт, Валидатор, 5, 10, Истина, 10000);

	Момент = Дата(2026, 1, 1, 12, 0, 0);
	Служба.Поставить("вебхук", Действие("https://broken.target/steal", "s"), "версия.опубликована", "{}", Момент);

	Итог = Служба.ОбработатьПартию(Момент);

	Ожидаем.Что(Итог.Отброшено, "цель отклонена проверкой → снята").Равно(1);
	Ожидаем.Что(Итог.Доставлено, "POST не выполнялся").Равно(0);
	Ожидаем.Что(Транспорт.КоличествоВызовов(), "сетевой попытки не было").Равно(0);
	Ожидаем.Что(Служба.РазмерОчереди(), "не ретраится: строка сама себя не починит").Равно(0);

КонецПроцедуры

&Тест
Процедура ПроверкаПередДоставкойДействуетИНаРетрае() Экспорт

	// цель, испортившаяся МЕЖДУ попытками, отклоняется на ретрае, а не доставляется по инерции
	Транспорт = Новый ФейкТранспортHTTP();
	Транспорт.УстановитьОтвет(500); // первая попытка: цель валидна, но отвечает 500
	Валидатор = Новый ФейкВалидаторВебхука();
	Служба = НоваяСлужбаПолная(Транспорт, Валидатор, 5, 10, Истина, 10000);
	Момент = Дата(2026, 1, 1, 12, 0, 0);

	Служба.Поставить("вебхук", Действие("https://broken.target/hook", "s"), "версия.опубликована", "{}", Момент);
	Итог1 = Служба.ОбработатьПартию(Момент);
	Ожидаем.Что(Итог1.Повторно, "первая попытка прошла проверку и ушла в ретрай").Равно(1);
	Ожидаем.Что(Транспорт.КоличествоВызовов(), "сетевая попытка была одна").Равно(1);

	Валидатор.Запретить("broken.target");
	Итог2 = Служба.ОбработатьПартию(Момент + 3600);

	Ожидаем.Что(Итог2.Отброшено, "ретрай отклонён проверкой перед доставкой").Равно(1);
	Ожидаем.Что(Транспорт.КоличествоВызовов(), "второй сетевой попытки не было").Равно(1);
	Ожидаем.Что(Служба.РазмерОчереди(), "задание не ретраится дальше").Равно(0);

КонецПроцедуры

&Тест
Процедура ПриВыключеннойДоставкеОчередьНеРастёт() Экспорт

	Служба = НоваяСлужбаПолная(Новый ФейкТранспортHTTP(), Новый ФейкВалидаторВебхука(), 5, 10, Ложь, 10000);

	Ид = Служба.Поставить("вебхук", Действие("https://example.com/hook", "s"), "версия.опубликована", "{}", Дата(2026, 1, 1, 0, 0, 0));

	Ожидаем.Что(ЗначениеЗаполнено(Ид), "выключенная доставка возвращает пустой id").ЭтоЛожь();
	Ожидаем.Что(Служба.РазмерОчереди(), "при delivery_enabled=false задание не ставится").Равно(0);

КонецПроцедуры

&Тест
Процедура ОчередьОграниченаСверхуДропаетСтарейшее() Экспорт

	Транспорт = Новый ФейкТранспортHTTP();
	Транспорт.УстановитьОтвет(200);
	Служба = НоваяСлужбаПолная(Транспорт, Новый ФейкВалидаторВебхука(), 5, 10, Истина, 2);
	Момент = Дата(2026, 1, 1, 0, 0, 0);

	Служба.Поставить("вебхук", Действие("https://example.com/1", "s"), "версия.опубликована", "{}", Момент);
	Служба.Поставить("вебхук", Действие("https://example.com/2", "s"), "версия.опубликована", "{}", Момент);
	Служба.Поставить("вебхук", Действие("https://example.com/3", "s"), "версия.опубликована", "{}", Момент); // переполнение

	Ожидаем.Что(Служба.РазмерОчереди(), "очередь ограничена лимитом").Равно(2);

	// отброшено именно СТАРЕЙШЕЕ (/1), в очереди остались /2 и /3 в порядке постановки
	Итог = Служба.ОбработатьПартию(Момент);
	Ожидаем.Что(Итог.Доставлено, "остаток очереди доставлен целиком").Равно(2);
	Ожидаем.Что(СтрСоединить(Транспорт.ВсеURL(), " "),
		"доставлены ровно /2 и /3 по порядку — старейшее /1 отброшено")
		.Равно("https://example.com/2 https://example.com/3");

КонецПроцедуры

// Тик доставщика идёт каждые несколько секунд, и на простаивающем хабе партия пуста
// всегда. Строка о пустой партии капала бы в консоль бесконечно, а её аргумент
// РазмерОчереди берёт БлокировкуРесурса — и берёт её вызывающий, то есть даже при
// выключенной отладке. Молчание на простое проверяется на самом уровне ОТЛАДКИ:
// при нём видно и лишнюю строку, и то, что при непустой партии строка есть.
&Тест
Процедура ПустаяПартияДоставкиМолчитДажеНаОтладке() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.доставка.простой");
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка);

	Транспорт = Новый ФейкТранспортHTTP();
	Транспорт.УстановитьОтвет(200);
	Служба = Новый СлужбаДоставкиПодписок(РеестрВебхука(Транспорт, Новый ФейкВалидаторВебхука()),
		НоваяОчередь(10000), НастройкиПодписок(3, 10, Истина, 10000), Лог,
		Новый ТекстОшибки());

	Служба.ОбработатьПартию(Дата(2026, 8, 6, 12, 0, 0));
	НаПростое = Ловушка.Количество();

	Служба.Поставить("вебхук", Новый Структура("URL, Секрет", "https://example.com/1", ""),
		"пакет.опубликован", "{}", Дата(2026, 8, 6, 12, 0, 0));
	Служба.ОбработатьПартию(Дата(2026, 8, 6, 12, 0, 1));
	СРаботой = Ловушка.Количество();

	Лог.УдалитьСпособВывода(Ловушка);

	Ожидаем.Что(НаПростое, "пустая партия не пишет в журнал ни строки: " + Ловушка.Всё()).Равно(0);
	Ожидаем.Что(СРаботой > 0, "непустая партия в журнале видна").ЭтоИстина();

КонецПроцедуры

// НФТ-ПОДП-006: очередь живёт в базе, а не в памяти процесса, поэтому «перезапуск хаба» —
// это новая служба над теми же данными. Задание обязано найтись с ТЕМ ЖЕ числом сделанных
// попыток: сброс счётчика дал бы цели лишние POST'ы сверх max_attempts.
&Тест
Процедура НедоставленноеПереживаетПерезапускСТемЖеЧисломПопыток() Экспорт

	Транспорт = Новый ФейкТранспортHTTP();
	Транспорт.УстановитьОтвет(500); // приёмник лежит
	ДоПерезапуска = НоваяСлужбаПолная(Транспорт, Новый ФейкВалидаторВебхука(), 2, 10, Истина, 10000);
	Момент = Дата(2026, 1, 1, 12, 0, 0);

	ДоПерезапуска.Поставить("вебхук", Действие("https://example.com/hook", "s"),
		"версия.опубликована", "{}", Момент);
	Ожидаем.Что(ДоПерезапуска.ОбработатьПартию(Момент).Повторно, "попытка 1 из 2 неудачна").Равно(1);

	// перезапуск процесса: службы и очереди в памяти больше нет, база та же
	ПослеПерезапуска = НоваяСлужбаПолная(Транспорт, Новый ФейкВалидаторВебхука(), 2, 10, Истина, 10000);
	Ожидаем.Что(ПослеПерезапуска.РазмерОчереди(), "недоставленное задание пережило перезапуск").Равно(1);

	Итог = ПослеПерезапуска.ОбработатьПартию(Момент + 3600);
	Ожидаем.Что(Итог.Отброшено,
		"после перезапуска идёт ВТОРАЯ попытка из двух — счётчик не сброшен").Равно(1);
	Ожидаем.Что(Транспорт.КоличествоВызовов(),
		"ровно max_attempts сетевых попыток на задание через перезапуск").Равно(2);
	Ожидаем.Что(ПослеПерезапуска.РазмерОчереди(), "исчерпавшее попытки задание снято").Равно(0);

КонецПроцедуры

// Бэкофф тоже принадлежит заданию, а не памяти процесса: иначе перезапуск хаба превращался бы
// в снятие паузы и хаб долбил бы лежащую цель на каждом рестарте.
&Тест
Процедура ПерезапускНеСбрасываетБэкоффЗадания() Экспорт

	Транспорт = Новый ФейкТранспортHTTP();
	Транспорт.УстановитьОтвет(500);
	ДоПерезапуска = НоваяСлужбаПолная(Транспорт, Новый ФейкВалидаторВебхука(), 5, 60, Истина, 10000);
	Момент = Дата(2026, 1, 1, 12, 0, 0);

	ДоПерезапуска.Поставить("вебхук", Действие("https://example.com/hook", "s"),
		"версия.опубликована", "{}", Момент);
	ДоПерезапуска.ОбработатьПартию(Момент); // неудача → НеРанее = +60с

	ПослеПерезапуска = НоваяСлужбаПолная(Транспорт, Новый ФейкВалидаторВебхука(), 5, 60, Истина, 10000);

	Итог = ПослеПерезапуска.ОбработатьПартию(Момент + 30);
	Ожидаем.Что(Итог.Доставлено + Итог.Повторно + Итог.Отброшено,
		"незрелое задание не берётся и после перезапуска").Равно(0);
	Ожидаем.Что(Транспорт.КоличествоВызовов(), "второй сетевой попытки раньше срока нет").Равно(1);

	Ожидаем.Что(ПослеПерезапуска.ОбработатьПартию(Момент + 60).Повторно,
		"по истечении прежнего бэкоффа задание снова берётся").Равно(1);

КонецПроцедуры

// Партия, оборванная падением процесса посреди работы, не должна уносить взятые задания:
// пока задание не завершено и не отложено, оно остаётся в очереди.
&Тест
Процедура ОборваннаяПартияЗаданиеНеТеряет() Экспорт

	Транспорт = Новый ФейкТранспортHTTP();
	Транспорт.УстановитьОтвет(200);
	Служба = НоваяСлужба(Транспорт, 3, 10);
	Момент = Дата(2026, 1, 1, 12, 0, 0);

	Служба.Поставить("вебхук", Действие("https://example.com/hook", "s"), "версия.опубликована", "{}", Момент);

	// процесс убит между «взяли созревшие» и «доставили»
	Очередь = НоваяОчередь(10000);
	Ожидаем.Что(Очередь.Созревшие(Момент).Количество(), "задание взято в работу").Равно(1);

	ПослеПерезапуска = НоваяСлужба(Транспорт, 3, 10);
	Ожидаем.Что(ПослеПерезапуска.РазмерОчереди(), "взятое, но не завершённое задание на месте").Равно(1);
	Ожидаем.Что(ПослеПерезапуска.ОбработатьПартию(Момент).Доставлено,
		"и доставляется следующим запуском").Равно(1);
	Ожидаем.Что(Транспорт.ТелоПоследнее(), "тело пережило перезапуск").Равно("{}");

КонецПроцедуры

// Снимок настроек доставки едет в базе и обязан вернуться тем же: иначе после перезапуска
// подпись считалась бы чужим секретом и приёмник отверг бы доставку.
&Тест
Процедура СнимокНастроекДоставкиПереживаетПерезапуск() Экспорт

	Транспорт = Новый ФейкТранспортHTTP();
	Транспорт.УстановитьОтвет(200);
	ДоПерезапуска = НоваяСлужба(Транспорт, 3, 10);
	Момент = Дата(2026, 1, 1, 12, 0, 0);

	ДоПерезапуска.Поставить("вебхук", Действие("https://example.com/hook", "секрет-1"),
		"версия.опубликована", "{""тип"":""версия.опубликована""}", Момент);

	НоваяСлужба(Транспорт, 3, 10).ОбработатьПартию(Момент);

	Ожидаем.Что(Транспорт.URLПоследний(), "адрес цели взят из снимка").Равно("https://example.com/hook");
	ОжидаемаяПодпись = "sha256=" + НРег(ПолучитьHexСтрокуИзДвоичныхДанных(
		ХешированиеПаролей.HMACSHA256("секрет-1", "{""тип"":""версия.опубликована""}")));
	Ожидаем.Что(Транспорт.ЗаголовокПоследний("X-OpenHub-Signature"),
		"секрет подписи пережил перезапуск").Равно(ОжидаемаяПодпись);

КонецПроцедуры

// НФТ-ПОДП-005 остаётся в силе и с очередью в базе: постановка не читает таблицу целиком,
// иначе публикация платила бы за каждое событие обходом всей очереди.
&Тест
Процедура ПостановкаВОчередьНеЧитаетТаблицуЦеликом() Экспорт

	Служба = НоваяСлужба(Новый ФейкТранспортHTTP(), 3, 10);
	Момент = Дата(2026, 1, 1, 12, 0, 0);

	Для Ном = 1 По 20 Цикл
		Служба.Поставить("вебхук", Действие("https://example.com/" + Ном, "s"),
			"версия.опубликована", "{}", Момент);
	КонецЦикла;

	Ожидаем.Что(Хранилище.ЧтенийТаблицы(),
		"размер очереди считается один раз, дальше ведётся в памяти").Равно(1);
	Ожидаем.Что(Служба.РазмерОчереди(), "и он верен").Равно(20);

КонецПроцедуры

Функция НоваяСлужба(Знач Транспорт, Знач МаксПопыток, Знач БэкоффБаза)
	Возврат НоваяСлужбаПолная(Транспорт, Новый ФейкВалидаторВебхука(), МаксПопыток, БэкоффБаза, Истина, 10000);
КонецФункции

Функция НоваяСлужбаПолная(Знач Транспорт, Знач Валидатор, Знач МаксПопыток, Знач БэкоффБаза, Знач Включена, Знач МаксОчередь)
	// ядро: (Реестр, Очередь, макс_попыток, база_бэкоффа, delivery_enabled, Лог, Числа, Ошибки)
	Возврат Новый СлужбаДоставкиПодписок(РеестрВебхука(Транспорт, Валидатор),
		НоваяОчередь(МаксОчередь), НастройкиПодписок(МаксПопыток, БэкоффБаза, Включена, МаксОчередь),
		ЛогТестов(), Новый ТекстОшибки());
КонецФункции

// Очередь: (Хранилище, max_queue, Лог, Числа). Хранилище общее — его переживание
// пересоздания службы и есть переживание перезапуска процесса.
Функция НоваяОчередь(Знач МаксОчередь)
	Возврат Новый ОчередьДоставокПодписок(Хранилище, НастройкиПодписок(5, 10, Истина, МаксОчередь), ЛогТестов(), Новый ПриведениеЧисел());
КонецФункции

// Обработчик доставки вебхука: (КлиентHTTP, Валидатор, таймаут, Телеметрия, Лог).
Функция НовыйОбработчикВебхука(Знач Транспорт, Знач Валидатор)
	Возврат Новый ДоставкаВебхуком(Транспорт, Валидатор, НастройкиПодписок(5, 10, Истина, 10000),
		Неопределено, ЛогТестов());
КонецФункции

// Настройки доставки для прямой сборки службы вне контейнера.
Функция НастройкиПодписок(Знач МаксПопыток, Знач БэкоффБаза, Знач Включена, Знач МаксОчередь)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПодписки(Включена, МаксПопыток, БэкоффБаза, МаксОчередь);
	Возврат Настройки;
КонецФункции

Функция РеестрВебхука(Знач Транспорт, Знач Валидатор)
	Доставки = Новый Массив();
	Доставки.Добавить(НовыйОбработчикВебхука(Транспорт, Валидатор));
	Хранения = Новый Массив();
	Хранения.Добавить(Новый ХранениеПодпискиВебхука(Валидатор));
	Возврат Новый РеестрДействийПодписок(Доставки, Хранения);
КонецФункции

Функция Действие(Знач URL, Знач Секрет)
	Возврат Новый Структура("URL, Секрет", URL, Секрет);
КонецФункции

// Лог для классов, создаваемых напрямую минуя контейнер: инъекция `&Лог` до них не доезжает.
Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub");
КонецФункции
