	Ожидаем.Что(База.ПрочтенийФайла(), "файла базы не открывал").Равно(ДоЗахода);

КонецПроцедуры

#КонецОбласти

#Область АдресВыпуска

&Тест
Процедура АдресВыпускаСобираетсяИзШаблонаНастройки() Экспорт

	Ожидаем.Что(Обновление.АдресВыпуска(Дата(2026, 9, 21)), "умолчание — выпуск DB-IP")
		.Равно("https://download.db-ip.com/free/dbip-country-lite-2026-09.csv.gz");

	Настройки.Задать(Обновление.КлючАдреса(), "https://зеркало.local/{ГОД}/{МЕСЯЦ}/база.csv.gz");
	Ожидаем.Что(Обновление.АдресВыпуска(Дата(2026, 1, 3)), "шаблон инсталляции")
		.Равно("https://зеркало.local/2026/01/база.csv.gz");

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция ПутьБазы()
	Возврат ОбъединитьПути(Песочница, "гео", "dbip-country-lite.csv");
КонецФункции

Функция АдресМесяца(Знач ГодВыпуска, Знач МесяцВыпуска)
	Возврат Обновление.АдресВыпуска(Дата(ГодВыпуска, МесяцВыпуска, 1));
КонецФункции

// Годный выпуск: пробная база, добитая до боевого порога годности строками ненаблюдаемой
// страны. Добивка именно ненаблюдаемой: наблюдаемых строк от этого не прибавляется,
// и набор не платит за сборку тридцати тысяч диапазонов на каждом тесте.
Функция Длинный()

	Результат = Проба.Строки();
	Пока Результат.Количество() <= 100000 Цикл
		Результат.Добавить("1.0.0.0,1.0.0.255,AU");
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Архив, чей хвост обещает названное число байт распакованного: тела как такового нет,
// до распаковки дело и не доходит.
Функция АрхивСОбещанием(Знач Обещано)

	Путь = ОбъединитьПути(Песочница, "бомба.gz");
	Запись = Новый ЗаписьДанных(Путь);
	Запись.Записать(ПолучитьДвоичныеДанныеИзСтроки("тело выпуска тут не важно", "UTF-8", Ложь));
	Запись.ЗаписатьЦелое32(Обещано);
	Запись.Закрыть();

	Возврат Новый ДвоичныеДанные(Путь);

КонецФункции

// Три члена gzip подряд — законный архив, который распакуется втрое длиннее, чем обещает
// его хвост: обещание в хвосте принадлежит последнему члену. Ровно для такого случая
// у потолка и есть вторая сеть.
Функция АрхивИзТрёхЧленов()

	Один = Сжать(Проба.Написать(ОбъединитьПути(Песочница, "член.csv"), Длинный()));

	Путь = ОбъединитьПути(Песочница, "склейка.gz");
	Запись = Новый ЗаписьДанных(Путь);
	Для Счёт = 1 По 3 Цикл
		Запись.Записать(Один);
	КонецЦикла;
	Запись.Закрыть();

	Возврат Новый ДвоичныеДанные(Путь);

КонецФункции

Функция Сжать(Знач Путь)
	Компрессор = Новый GZipКомпрессор();
	Возврат Компрессор.Упаковать(Новый ДвоичныеДанные(Путь));
КонецФункции

Функция СтрокФайла(Знач Путь)

	Если НЕ Новый Файл(Путь).Существует() Тогда
		Возврат 0;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
	Сколько = 0;
	Строчка = Чтение.ПрочитатьСтроку();
	Пока Строчка <> Неопределено Цикл
		Сколько = Сколько + 1;
		Строчка = Чтение.ПрочитатьСтроку();
	КонецЦикла;
	Чтение.Закрыть();

	Возврат Сколько;

КонецФункции

Функция Страны(Знач Через)

	Результат = Новый Массив();
	Для Каждого Код Из СтрРазделить(Через, ",", Ложь) Цикл
		Результат.Добавить(Код);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЛогТеста()
	Возврат Логирование.ПолучитьЛог("тест.oshub.гео.обновление");
КонецФункции

#КонецОбласти
