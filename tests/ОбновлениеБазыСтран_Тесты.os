// Обновление встроенной базы стран: подмена tmp → rename, неудача оставляет прежнюю базу,
// негодный кандидат её не подменяет, происшествие пишется и снимается, а подложенный
// руками файл подхватывается по отпечатку. В настоящий db-ip.com набор не ходит.

#Использовать asserts
#Использовать autumn-logos
#Использовать compressor
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя
Перем Проба;          // фикстура БазаСтранПробная
Перем Настройки;      // НастройкиЗаглушка
Перем Летопись;       // ФейкЛетописьПомех
Перем КодыПричин;     // КодыПомех (помехи)
Перем Объекты;        // ОбъектыПомех (помехи)
Перем Выдача;         // ВыдачаВыпусковБазы
Перем База;           // БазаСтран (гео)
Перем Обновление;     // ОбновлениеБазыСтран (гео)
Перем Часы;           // ЧасыРучные — с них берётся месяц выпуска
Перем Песочница;
Перем ВыпускGZ;       // ДвоичныеДанные — годный выпуск, собранный один раз на набор
Перем КороткийGZ;     // ДвоичныеДанные — файл в десять строк: базой мира не бывает

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("БазаСтранПробная");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ЗапускВФонеСинхронный");
	РеестрФикстур.Подключить("ФейкЛетописьПомех");
	РеестрФикстур.Подключить("ВыдачаВыпусковБазы");
	РеестрФикстур.Подключить("ЧасыРучные");

	ПоискКлассов = Новый КлассыСлоя();
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "гео", "Классы"));
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "помехи", "Классы"), "КодыПомех");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "помехи", "Классы"), "ОбъектыПомех");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы"),
		"ОбезличиваниеЖурнала");

КонецПроцедуры

&ПередВсеми
Процедура СобратьВыпуски() Экспорт

	Проба = Новый БазаСтранПробная();
	Общая = УникальныеИмена.ВременныйКаталог("гео-выпуски");

	// порог годности у проверки боевой (сто тысяч строк), поэтому годный выпуск и вправду
	// длинный: собирается он один раз на набор, а не в каждом тесте
	ВыпускGZ = Сжать(Проба.Написать(ОбъединитьПути(Общая, "годный.csv"), Длинный()));
	КороткийGZ = Сжать(Проба.Положить(ОбъединитьПути(Общая, "короткий.csv")));

	УникальныеИмена.УбратьВременное(Общая);

КонецПроцедуры

&ПередКаждым
Процедура СобратьОбновление() Экспорт

	Песочница = УникальныеИмена.ВременныйКаталог("гео-обновление");
	Настройки = Новый НастройкиЗаглушка();
	Летопись = Новый ФейкЛетописьПомех();
	КодыПричин = Новый КодыПомех();
	Объекты = Новый ОбъектыПомех(Новый ИмяОбъектаАудита());
	Выдача = Новый ВыдачаВыпусковБазы();
	Часы = Новый ЧасыРучные(Дата(2026, 9, 21, 12, 0, 0));

	База = Новый БазаСтран(Настройки, Новый ЗапускВФонеСинхронный(), ЛогТеста());
	Обновление = Новый ОбновлениеБазыСтран(База, Выдача, Настройки, Летопись, КодыПричин,
		Объекты, ЛогТеста());
	Обновление.УстановитьЧасы(Часы);

	Настройки.Задать(База.КлючПути(), ПутьБазы());
	Настройки.Задать(Обновление.КлючВключено(), Истина);
	Проба.Положить(ПутьБазы());
	База.НаблюдатьСтраны(Страны("RU"));

КонецПроцедуры

&ПослеКаждого
Процедура УбратьПесочницу() Экспорт
	УникальныеИмена.УбратьВременное(Песочница);
КонецПроцедуры

#Область УдачноеОбновление

&Тест
Процедура УдачноеОбновлениеПодменяетБазуИСнимаетПроисшествие() Экспорт

	Выдача.ПриАдресе(АдресМесяца(2026, 9), 200, ВыпускGZ);

	Обновление.Обойти();

	Ожидаем.Что(СтрокФайла(ПутьБазы()) > 100000, "база подменена длинным выпуском").ЭтоИстина();
	Ожидаем.Что(Новый Файл(ПутьБазы() + ".tmp").Существует(),
		"временный файл после подмены не остаётся").ЭтоЛожь();
	Ожидаем.Что(Новый Файл(ПутьБазы() + ".прежняя").Существует(),
		"и прежняя база тоже убрана").ЭтоЛожь();

	Ожидаем.Что(База.Состояние().Диапазонов > 0, "индекс пересобран по новой базе")
		.ЭтоИстина();
	Ожидаем.Что(Летопись.Записи().Количество(), "жаловаться не на что").Равно(0);
	Ожидаем.Что(Летопись.Снятые().Количество(), "и прежние жалобы сняты").Равно(1);
	Ожидаем.Что(Летопись.Снятые()[0].Подсистема, "снято подсистемой гео")
		.Равно(КодыПричин.ПодсистемаГео());

КонецПроцедуры

&Тест
Процедура ВыпускПрошлогоМесяцаБерётсяКогдаТекущегоЕщёНет() Экспорт

	// выпуск нового месяца появляется у издателя не первого числа: 404 на текущем —
	// это не сбой, а «ещё не вышел»
	Выдача.ПриАдресе(АдресМесяца(2026, 8), 200, ВыпускGZ);

	Обновление.Обойти();

	Спрошенное = Выдача.Спрошенное();
	Ожидаем.Что(Спрошенное.Количество(), "спрошены оба выпуска").Равно(2);
	Ожидаем.Что(Спрошенное[0], "сначала текущий месяц").Равно(АдресМесяца(2026, 9));
	Ожидаем.Что(Спрошенное[1], "потом прошлый").Равно(АдресМесяца(2026, 8));
	Ожидаем.Что(СтрокФайла(ПутьБазы()) > 100000, "база подменена").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЯнварьСпрашиваетДекабрьПрошлогоГода() Экспорт

	Часы.УстановитьМомент(Дата(2026, 1, 5, 12, 0, 0));
	Выдача.ПриАдресе(АдресМесяца(2025, 12), 200, ВыпускGZ);

	Обновление.Обойти();

	Ожидаем.Что(Выдача.Спрошенное()[1], "за декабрём — в прошлый год")
		.Равно(АдресМесяца(2025, 12));
	Ожидаем.Что(СтрокФайла(ПутьБазы()) > 100000, "база подменена").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область НеудачноеОбновление

&Тест
Процедура СбойСкачиванияОставляетСтаруюБазуИПишетПроисшествие() Экспорт

	Выдача.Ломаться();

	Обновление.Обойти();

	Ожидаем.Что(СтрокФайла(ПутьБазы()), "прежняя база на месте вся").Равно(14);
	Ожидаем.Что(Новый Файл(ПутьБазы() + ".tmp").Существует(),
		"временный файл после сбоя убран").ЭтоЛожь();

	Записи = Летопись.ПоКоду(КодыПричин.БазаСтранНеОбновилась());
	Ожидаем.Что(Записи.Количество(), "происшествие записано").Равно(1);
	Ожидаем.Что(Записи[0].Подсистема, "подсистема гео").Равно(КодыПричин.ПодсистемаГео());
	Ожидаем.Что(Записи[0].Объект, "объект — файл базы")
		.Равно(Объекты.БазаСтран("dbip-country-lite.csv"));
	Ожидаем.Что(ЗначениеЗаполнено(Записи[0].Причина),
		"и причина названа словами: " + Записи[0].Причина).ЭтоИстина();
	Ожидаем.Что(Летопись.Снятые().Количество(), "снимать при неудаче нечего").Равно(0);

КонецПроцедуры

&Тест
Процедура НегодныйФайлБазуНеПодменяет() Экспорт

	// десять строк базой мира не бывают: кандидат судится ДО подмены
	Выдача.ПриАдресе(АдресМесяца(2026, 9), 200, КороткийGZ);

	Обновление.Обойти();

	Ожидаем.Что(СтрокФайла(ПутьБазы()), "прежняя база не тронута").Равно(14);
	Ожидаем.Что(Летопись.ПоКоду(КодыПричин.БазаСтранНеОбновилась()).Количество(),
		"и неудача названа").Равно(1);

КонецПроцедуры

&Тест
Процедура ПустоеТелоИОтказИздателяБазуНеПодменяют() Экспорт

	Выдача.ПриАдресе(АдресМесяца(2026, 9), 200, Неопределено);
	Выдача.ПриАдресе(АдресМесяца(2026, 8), 503, Неопределено);

	Обновление.Обойти();

	Ожидаем.Что(СтрокФайла(ПутьБазы()), "прежняя база не тронута").Равно(14);
	Ожидаем.Что(Летопись.ПоКоду(КодыПричин.БазаСтранНеОбновилась()).Количество(),
		"неудача названа").Равно(1);

КонецПроцедуры

&Тест
Процедура АрхивОбещающийБольшеПотолкаНеРаспаковываетсяВовсе() Экспорт

	// у архивной бомбы тело маленькое: единственная дешёвая защита — прочитать обещание
	// в хвосте gzip и не начинать
	Выдача.ПриАдресе(АдресМесяца(2026, 9), 200, АрхивСОбещанием(300 * 1024 * 1024));

	Обновление.Обойти();

	Ожидаем.Что(СтрокФайла(ПутьБазы()), "прежняя база не тронута").Равно(14);
	Ожидаем.Что(Новый Файл(ПутьБазы() + ".tmp").Существует(),
		"и распакованного не появилось").ЭтоЛожь();

	Записи = Летопись.ПоКоду(КодыПричин.БазаСтранНеОбновилась());
	Ожидаем.Что(Записи.Количество(), "неудача записана").Равно(1);
	Ожидаем.Что(СтрНайти(Записи[0].Причина, "больше потолка") > 0,
		"и потолок назван: " + Записи[0].Причина).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РаспакованноеБольшеПотолкаБазуНеПодменяет() Экспорт

	// вторая сеть: обещанию в хвосте gzip верить нельзя. Склеенные подряд члены gzip
	// распаковываются все, а обещание в хвосте — только последнего из них
	Обновление.УстановитьПотолок(2000);
	Выдача.ПриАдресе(АдресМесяца(2026, 9), 200, АрхивИзТрёхЧленов());

	Обновление.Обойти();

	Ожидаем.Что(СтрокФайла(ПутьБазы()), "прежняя база не тронута").Равно(14);
	Ожидаем.Что(Новый Файл(ПутьБазы() + ".tmp").Существует(),
		"недописанный кандидат убран").ЭтоЛожь();

	Записи = Летопись.ПоКоду(КодыПричин.БазаСтранНеОбновилась());
	Ожидаем.Что(Записи.Количество(), "неудача записана").Равно(1);
	Ожидаем.Что(СтрНайти(Записи[0].Причина, "больше потолка") > 0,
		"и потолок назван: " + Записи[0].Причина).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НеGZipБазуНеПодменяет() Экспорт

	Выдача.ПриАдресе(АдресМесяца(2026, 9), 200,
		ПолучитьДвоичныеДанныеИзСтроки("<html>503 Service Unavailable</html>"));

	Обновление.Обойти();

	Ожидаем.Что(СтрокФайла(ПутьБазы()), "прежняя база не тронута").Равно(14);
	Ожидаем.Что(Новый Файл(ПутьБазы() + ".tmp").Существует(), "мусор убран").ЭтоЛожь();
	Ожидаем.Что(Летопись.ПоКоду(КодыПричин.БазаСтранНеОбновилась()).Количество(),
		"неудача названа").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ЗакрытыйКонтур

&Тест
Процедура ВыключенноеОбновлениеНаружуНеХодитАФайлПодхватывает() Экспорт

	Настройки.Задать(Обновление.КлючВключено(), Ложь);
	Выдача.ПриАдресе(АдресМесяца(2026, 9), 200, ВыпускGZ);

	Обновление.Обойти();

	Ожидаем.Что(Выдача.ВсегоЗапросов(), "наружу хаб не ходил").Равно(0);
	Ожидаем.Что(СтрокФайла(ПутьБазы()), "база та, что лежала").Равно(14);
	Ожидаем.Что(Летопись.Снятые().Количество(), "свежая база жалоб не оставляет").Равно(1);

	// базу положили руками — заход её подхватывает по отпечатку
	ДоПодкладывания = База.ПрочтенийФайла();
	Проба.Написать(ПутьБазы(), Длинный());
	Обновление.Обойти();

	Ожидаем.Что(Выдача.ВсегоЗапросов(), "и всё равно наружу не ходил").Равно(0);
	Ожидаем.Что(База.ПрочтенийФайла() - ДоПодкладывания,
		"подложенная база прочитана ровно один раз").Равно(1);
	Ожидаем.Что(СтрокФайла(ПутьБазы()) > 100000, "и действует именно она").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура БазыНетПроисшествиеНазываетПутьИНастройку() Экспорт

	Настройки.Задать(Обновление.КлючВключено(), Ложь);
	УдалитьФайлы(ПутьБазы());

	Обновление.Обойти();

	Записи = Летопись.ПоКоду(КодыПричин.БазыСтранНет());
	Ожидаем.Что(Записи.Количество(), "происшествие записано").Равно(1);
	Ожидаем.Что(СтрНайти(Записи[0].Причина, Обновление.КлючВключено()) > 0,
		"названа настройка: " + Записи[0].Причина).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Записи[0].Причина, "dbip-country-lite.csv") > 0,
		"и путь: " + Записи[0].Причина).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УстаревшаяБазаОбъясняетСебяПроисшествием() Экспорт

	Настройки.Задать(Обновление.КлючВключено(), Ложь);
	База.УстановитьЧасы(Новый ЧасыРучные(ТекущаяДата() + База.ПорогУстареванияСек() + 86400));

	Обновление.Обойти();

	Ожидаем.Что(Летопись.ПоКоду(КодыПричин.БазаСтранУстарела()).Количество(),
