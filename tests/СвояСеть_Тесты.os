// НФТ-ДОСТ-013: «своя сеть» у хаба одна. Набор адресов прогоняется через КАЖДУЮ судящую
// дверь — обе точки провайдера входа и издателя доверенного конвейера — и через саму
// политику; сверяется значение вердикта, а не текст исходников. Здесь же живёт разрешитель
// имён: политика — его единственный потребитель.

#Использовать asserts
#Использовать autumn-logos
#Использовать oscript-ui
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем КаталогФикстур;
Перем Резолвер;       // ФейкРазрешительImён — DNS без сети
Перем Политика;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогФикстур = ОбъединитьПути(КаталогТестов, "фикстуры");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ФейкРазрешительImён");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.ПодключитьОснову(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "сеть", "Классы"), "СвояСеть");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "зеркала", "Классы"), "ВалидаторАдресаАпстрима");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "публикация", "Классы"), "СтражИздателейCI");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "ВалидаторАдресаПровайдера");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "ИздателиOAuth2");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "СловарьТекстов");

	// разрешитель имён — сосед политики по модулю и её единственный потребитель
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "сеть", "Классы"), "РазрешительImёнСистемный");

КонецПроцедуры

&ПередКаждым
Процедура СобратьПолитику() Экспорт
	Резолвер = Новый ФейкРазрешительImён();
	Политика = Новый СвояСеть(Резолвер, Новый КанонIP());
КонецПроцедуры

#Область ОдноПравило

// Список сетей один: вердикт политики на векторах истории сверяется ЗНАЧЕНИЕМ. Уберите
// диапазон из СетиПолитики() — покраснеет здесь, а не в текстовом скане исходников.
&Тест
Процедура ОдинСписокСетейОдинВердикт() Экспорт

	Расхождения = Новый Массив();
	СверитьКоды(Расхождения, СвояСеть(), Политика.Коды().СвояСеть);
	СверитьКоды(Расхождения, НеДляИнтернета(), Политика.Коды().НеДляИнтернета);
	СверитьКоды(Расхождения, НестрогаяЗапись(), Политика.Коды().НеАдрес);
	СверитьКоды(Расхождения, Интернет(), Политика.Коды().Интернет);

	Ожидаем.Что(СтрСоединить(Расхождения, "; "),
		"вердикт политики разошёлся с набором адресов истории").Равно("");

КонецПроцедуры

// Нестрогая запись — «не адрес», а не разобранный по-своему адрес и не DNS-имя.
&Тест
Процедура НестрогаяЗаписьЭтоНеАдрес() Экспорт

	Для Каждого Хост Из НестрогаяЗапись() Цикл
		Ожидаем.Что(Политика.Вердикт(Хост).Код,
			СтрШаблон("«%1» разобран по-своему вместо отказа", Хост))
			.Равно(Политика.Коды().НеАдрес);
	КонецЦикла;

	// КОНТРОЛЬ: строгая запись тех же четырёх октетов адресом является
	Ожидаем.Что(Политика.Вердикт("127.0.0.1").Код, "КОНТРОЛЬ: строгая запись петли — адрес")
		.Равно(Политика.Коды().СвояСеть);

КонецПроцедуры

// Вложенный IPv4 — отображённый, совместимый и NAT64 — судится как сам IPv4, и своей,
// и публичной стороной.
&Тест
Процедура ВложенныйIPv4СудитсяКакIPv4() Экспорт

	Пары = Новый Соответствие();
	Пары.Вставить("::ffff:127.0.0.1", "127.0.0.1");
	Пары.Вставить("::ffff:169.254.169.254", "169.254.169.254");
	Пары.Вставить("64:ff9b::a9fe:a9fe", "169.254.169.254");
	Пары.Вставить("::7f00:1", "127.0.0.1");
	Пары.Вставить("::ffff:8.8.8.8", "8.8.8.8");
	Пары.Вставить("64:ff9b::8080:8080", "128.128.128.128");

	Расхождения = Новый Массив();
	Для Каждого Пара Из Пары Цикл
		Обёрнутый = Политика.Вердикт(Пара.Ключ);
		Голый = Политика.Вердикт(Пара.Значение);
		Если Обёрнутый.Код <> Голый.Код ИЛИ Обёрнутый.Сеть <> Голый.Сеть Тогда
			Расхождения.Добавить(СтрШаблон("%1 (%2) <> %3 (%4)",
				Пара.Ключ, Обёрнутый.Код, Пара.Значение, Голый.Код));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Расхождения, "; "),
		"вложенный IPv4 судится не как сам IPv4").Равно("");

КонецПроцедуры

// localhost и *.localhost — своя сеть БЕЗ резолва имени.
&Тест
Процедура LocalhostСвояСетьБезРезолва() Экспорт

	Ожидаем.Что(Политика.ЭтоСвояСеть("localhost"), "localhost — своя сеть").ЭтоИстина();
	Ожидаем.Что(Политика.ЭтоСвояСеть("x.localhost"), "*.localhost — своя сеть").ЭтоИстина();
	Ожидаем.Что(Резолвер.КоличествоЗапросов(),
		"имя петли резолвом не проверяется").Равно(0);

	// КОНТРОЛЬ: похожее имя своим не становится
	Ожидаем.Что(Политика.ЭтоСвояСеть("localhost.evil.com"),
		"КОНТРОЛЬ: чужой домен с приставкой localhost — не своя сеть").ЭтоЛожь();

КонецПроцедуры

// Результат резолва судится ТЕМ ЖЕ списком сетей, что и литерал.
&Тест
Процедура ИмяСудитсяТемЖеСпискомСетей() Экспорт

	Резолвер.ЗадатьПриватный("internal.corp", "10.0.0.5");
	Резолвер.ЗадатьПриватный("public.corp", "93.184.216.34");
	Резолвер.ЗадатьПриватный("doc.corp", "192.0.2.7");

	Ожидаем.Что(Политика.ВердиктСРезолвом("internal.corp").Код,
		"имя в частную сеть — своя сеть").Равно(Политика.Коды().СвояСеть);
	Ожидаем.Что(Политика.ВердиктСРезолвом("doc.corp").Код,
		"имя в документационную сеть — непригодно для интернета")
		.Равно(Политика.Коды().НеДляИнтернета);
	Ожидаем.Что(Политика.ВердиктСРезолвом("public.corp").Код,
		"КОНТРОЛЬ: имя в публичный адрес — интернет").Равно(Политика.Коды().Интернет);
	Ожидаем.Что(Политика.ВердиктСРезолвом("unknown.corp").Код,
		"нерезолвящееся имя своим не объявляется").Равно(Политика.Коды().Интернет);

КонецПроцедуры

// В2: разрешитель имён — обязательный желудь. Политика без него обязана падать громко,
// а не отвечать «интернет»: молчаливый fail-open открыл бы SSRF-гейт провайдера входа.
&Тест
Процедура ПолитикаБезРазрешителяНеСудитИмяМолча() Экспорт

	Голая = Новый СвояСеть(Неопределено, Новый КанонIP());
	Молча = Ложь;

	Попытка
		Молча = (Голая.ВердиктСРезолвом("internal.corp").Код = Голая.Коды().Интернет);
	Исключение
		Молча = Ложь;
	КонецПопытки;

	Ожидаем.Что(Молча,
		"имя без разрешителя признано интернетом молча — это выключенный гейт").ЭтоЛожь();

	// КОНТРОЛЬ: запись адреса резолвера не спрашивает и без него судится по-прежнему
	Ожидаем.Что(Голая.Вердикт("10.1.2.3").Код,
		"КОНТРОЛЬ: литерал судится и без разрешителя").Равно(Голая.Коды().СвояСеть);

КонецПроцедуры

#КонецОбласти

#Область СудящиеДвери

// Одни и те же адреса отвергают ОБЕ двери, которые судят сеть: точка провайдера входа
// и адрес издателя доверенного конвейера.
&Тест
Процедура КаждаяСудящаяДверьОтвергаетВесьНабор() Экспорт

	Проехавшие = Новый Массив();
	Для Каждого Хост Из ОтвергаемыеВезде() Цикл
		Если ВалидаторПровайдера().ПроверитьТочку(URL("https", Хост), "точка").Ок Тогда
			Проехавшие.Добавить("точка провайдера: " + Хост);
		КонецЕсли;
		Если СтражКонвейеров().ДопустимАдрес(URL("https", Хост)).Ок Тогда
			Проехавшие.Добавить("издатель конвейера: " + Хост);
		КонецЕсли;
	КонецЦикла;

	// КОНТРОЛЬ: публичный адрес проезжает обе двери — отличие ровно в адресе
	Ожидаем.Что(ВалидаторПровайдера().ПроверитьТочку("https://idp.example.com/authorize", "точка").Ок,
		"КОНТРОЛЬ: публичное имя проходит точку провайдера").ЭтоИстина();
	Ожидаем.Что(СтражКонвейеров().ДопустимАдрес("https://token.actions.githubusercontent.com/keys").Ок,
		"КОНТРОЛЬ: публичное имя проходит издателя конвейера").ЭтоИстина();

	Ожидаем.Что(СтрСоединить(Проехавшие, Символы.ПС),
		"адреса, проехавшие судящую дверь:").Равно("");

КонецПроцедуры

// Обе двери отвергают ОДНИМИ СЛОВАМИ: причину формулирует политика, а не каждая дверь сама.
&Тест
Процедура ОбеДвериОтвергаютОднимиСловами() Экспорт

	Расхождения = Новый Массив();
	Для Каждого Хост Из ОтвергаемыеВезде() Цикл
		Причина = Политика.Вердикт(Хост).Текст;
		Точка = ВалидаторПровайдера().ПроверитьТочку(URL("https", Хост), "точка").Ошибка;
		Издатель = СтражКонвейеров().ДопустимАдрес(URL("https", Хост)).Ошибка;
		Если СтрНайти(Точка, Причина) = 0 Тогда
			Расхождения.Добавить(СтрШаблон("%1 — точка провайдера: «%2»", Хост, Точка));
		КонецЕсли;
		Если СтрНайти(Издатель, Причина) = 0 Тогда
			Расхождения.Добавить(СтрШаблон("%1 — издатель конвейера: «%2»", Хост, Издатель));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Расхождения, Символы.ПС),
		СтрШаблон("дверь назвала причину не словами политики (ждали «%1»):",
			Политика.Вердикт("127.0.0.2").Текст)).Равно("");

КонецПроцедуры

// Адрес возврата судит тем же списком сетей, но берёт из него РОВНО ПЕТЛЮ: по этому
// адресу едет authorization code, и открытым каналом он не должен покидать узел.
// Выигрыш требования — в записях петли, которых прежние три литерала не знали
// (127.0.0.2, x.localhost, ::ffff:127.0.0.1), а не в расширении разрешения на всю
// свою сеть: частная сеть, link-local, CGNAT и незаданный адрес по http отвергаются.
&Тест
Процедура АдресВозвратаПускаетHTTPРовноВПетлю() Экспорт

	Отвергнутые = Новый Массив();
	Для Каждого Хост Из Петля() Цикл
		Если НЕ ВалидаторПровайдера().ПроверитьАдресВозврата(URL("http", Хост)).Ок Тогда
			Отвергнутые.Добавить(Хост);
		КонецЕсли;
	КонецЦикла;

	Проехавшие = Новый Массив();
	Для Каждого Хост Из НеПетля() Цикл
		Если ВалидаторПровайдера().ПроверитьАдресВозврата(URL("http", Хост)).Ок Тогда
			Проехавшие.Добавить(Хост);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Отвергнутые, ", "),
		"запись петли, которую дверь возврата петлёй не признала").Равно("");
	Ожидаем.Что(СтрСоединить(Проехавшие, ", "),
		"http по адресу возврата уехал за пределы петли").Равно("");

	// КОНТРОЛЬ: по https те же адреса ходят — отличие ровно в схеме
	Ожидаем.Что(ВалидаторПровайдера().ПроверитьАдресВозврата("https://hub.example.com/cb").Ок,
		"КОНТРОЛЬ: https принимается").ЭтоИстина();

КонецПроцедуры

// Петля и «своя сеть» — не одно и то же, и политика различает их сама: иначе дверь
// возврата пришлось бы учить третьему определению.
&Тест
Процедура ПетляУжеСвоейСетиНоСудитсяТемЖеСписком() Экспорт

	НеПетлевые = Новый Массив();
	Для Каждого Хост Из НеПетля() Цикл
		Если Политика.ЭтоПетля(Хост) Тогда
			НеПетлевые.Добавить(Хост);
		КонецЕсли;
	КонецЦикла;

	Непризнанные = Новый Массив();
	Для Каждого Хост Из Петля() Цикл
		Если НЕ (Политика.ЭтоПетля(Хост) И Политика.ЭтоСвояСеть(Хост)) Тогда
			Непризнанные.Добавить(Хост);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(НеПетлевые, ", "), "петлёй названо лишнее").Равно("");
	Ожидаем.Что(СтрСоединить(Непризнанные, ", "),
		"запись петли не признана петлёй либо своей сетью").Равно("");

	// у петли одно имя сети во всех её записях — различие живёт в тексте причины
	Ожидаем.Что(Политика.Вердикт("localhost").Сеть,
		"имя сети у петли по имени и по адресу одно").Равно(Политика.Вердикт("127.0.0.1").Сеть);
	Ожидаем.Что(Политика.Вердикт("localhost").Текст = Политика.Вердикт("127.0.0.1").Текст,
		"а причина у них разная — иначе отказ не объясняет, что узнал хаб").ЭтоЛожь();

КонецПроцедуры

// Публичные адреса всех форм проходят обе судящие двери: гейт не превратился в «запрещено всё».
&Тест
Процедура ПубличныеАдресаПроходятОбеДвери() Экспорт

	Отвергнутые = Новый Массив();
	Для Каждого Хост Из Интернет() Цикл
		Точка = ВалидаторПровайдера().ПроверитьТочку(URL("https", Хост), "точка");
		Если НЕ Точка.Ок Тогда
			Отвергнутые.Добавить("точка провайдера: " + Хост + " — " + Точка.Ошибка);
		КонецЕсли;
		Издатель = СтражКонвейеров().ДопустимАдрес(URL("https", Хост));
		Если НЕ Издатель.Ок Тогда
			Отвергнутые.Добавить("издатель конвейера: " + Хост + " — " + Издатель.Ошибка);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Отвергнутые, Символы.ПС),
		"публичные адреса, отвергнутые судящей дверью:").Равно("");

КонецПроцедуры

#КонецОбласти

#Область НаборыАдресов

// Своя сеть — петля, частные, link-local, ULA, CGNAT, NAT64, незаданный и localhost.
Функция СвояСеть()
	Возврат СтрРазделить("127.0.0.2,::1,::ffff:127.0.0.1,10.1.2.3,fc00::1,169.254.169.254,"
		+ "::ffff:169.254.169.254,64:ff9b::a9fe:a9fe,fe80::1,100.64.0.1,0.0.0.0,::,"
		+ "localhost,x.localhost", ",");
КонецФункции

// Непригодные для интернета: групповые, зарезервированные, документационные, тестовые.
Функция НеДляИнтернета()
	Возврат СтрРазделить("224.0.0.1,240.0.0.1,255.255.255.255,192.0.2.1,198.18.0.1,2001:db8::1", ",");
КонецФункции

// Нестрогие записи: восьмеричная, шестнадцатеричная, сокращённая и одним числом.
Функция НестрогаяЗапись()
	Возврат СтрРазделить("0x7f.0.0.1,127.1,0177.0.0.1,2130706433", ",");
КонецФункции

// Контрольная сторона набора: адреса и имена, которым в интернете самое место.
Функция Интернет()
	Возврат СтрРазделить("8.8.8.8,172.15.0.1,example.com,2606:4700:4700::1111,"
		+ "::ffff:8.8.8.8,64:ff9b::8080:8080", ",");
КонецФункции

// Петля во всех записях — единственное, что дверь возврата пускает по http.
Функция Петля()
	Возврат СтрРазделить("127.0.0.2,::1,::ffff:127.0.0.1,localhost,x.localhost", ",");
КонецФункции

// Остальная своя сеть плюс непригодные для интернета и нестрогие записи: по http
// адресом возврата быть не могут.
Функция НеПетля()
	Возврат Объединить(Объединить(
		СтрРазделить("10.1.2.3,fc00::1,169.254.169.254,100.64.0.1,fe80::1,0.0.0.0,::,"
			+ "64:ff9b::a9fe:a9fe,::ffff:169.254.169.254,::ffff:10.0.0.1", ","),
		НеДляИнтернета()), НестрогаяЗапись());
КонецФункции

Функция ОтвергаемыеВезде()
	Возврат Объединить(Объединить(СвояСеть(), НеДляИнтернета()), НестрогаяЗапись());
КонецФункции

Функция Объединить(Знач Левые, Знач Правые)
	Результат = Новый Массив();
	Для Каждого Элемент Из Левые Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;
	Для Каждого Элемент Из Правые Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область РазрешительИмён

// Скрипт резолва лежал в общем временном каталоге под ПОСТОЯННЫМ именем: два хаба на одной
// машине (соседние прогоны, blue/green на одном хосте) затирали файл друг у друга ровно
// тогда, когда python3 его читал, и резолв молча отдавал пустой список — SSRF-гейт при этом
// открывается (fail-open). Проверяется САМО имя: два подряд идущих резолва обязаны взять
// разные пути. Уборка за собой — отдельное, более слабое требование, и одной ею постоянное
// имя не ловится.
&Тест
Процедура ИмяСкриптаРезолваСвоёНаКаждыйВызов() Экспорт

	Песочница = НоваяПесочницаTMPDIR();
	Прежний = ПолучитьПеременнуюСреды("TMPDIR");

	Попытка
		УстановитьПеременнуюСреды("TMPDIR", Песочница);
		Резолвер = Новый РазрешительImёнСистемный();

		Адреса = Резолвер.Разрешить("localhost");
		Первый = Резолвер.ПутьСкриптаПоследнегоРезолва();

		Резолвер.Разрешить("localhost");
		Второй = Резолвер.ПутьСкриптаПоследнегоРезолва();

		Остаток = ИменаФайлов(Песочница);
	Исключение
		УстановитьПеременнуюСреды("TMPDIR", Прежний);
		ВызватьИсключение;
	КонецПопытки;

	УстановитьПеременнуюСреды("TMPDIR", Прежний);
	УдалитьФайлы(Песочница);

	Ожидаем.Что(ЗначениеЗаполнено(Первый), "путь скрипта виден снаружи — иначе проверять нечего")
		.ЭтоИстина();
	Ожидаем.Что(Первый = Второй,
		СтрШаблон("два резолва взяли ОДИН путь скрипта (%1): общее имя во временном каталоге"
			+ " перезапишет соседний хаб ровно на чтении интерпретатором", Первый)).ЭтоЛожь();

	Ожидаем.Что(СтрСоединить(Остаток, ", "),
		"резолвер оставил за собой файлы во временном каталоге").Равно("");

	// Песочница с пробелом в имени: без кавычек вокруг путей команда разваливается и резолв
	// отдаёт Неопределено. Наличие python3 спрашивается отдельно — иначе «резолв недоступен»
	// прятало бы поломку под законный исход окружения без интерпретатора.
	Если НЕ ЕстьPython3() Тогда
		Возврат;
	КонецЕсли;

	Ожидаем.Что(Адреса <> Неопределено,
		"python3 в окружении есть, а резолв недоступен: пути в команде обязаны быть"
		+ " в кавычках — временный каталог содержит пробел").ЭтоИстина();
	Ожидаем.Что(Адреса.Количество() > 0, "localhost разрешился хотя бы в один адрес").ЭтоИстина();
	Ожидаем.Что(Адреса.Найти("127.0.0.1") <> Неопределено ИЛИ Адреса.Найти("::1") <> Неопределено,
		"среди адресов localhost есть петля: " + СтрСоединить(Адреса, ", ")).ЭтоИстина();

КонецПроцедуры

// Резолвер создаётся напрямую (`Новый`) — лог инъекцией в поле до него не доезжает.
// Любой сбой резолва обязан стать Неопределено, а не улететь наружу: наружу он приходит
// в ПроверитьХост, то есть валит проверку адреса целиком.
&Тест
Процедура СбойРезолваНеЛетитНаружуБезИнъекцииЛога() Экспорт

	// каталог заведомо не существует — запись скрипта сорвётся внутри резолва
	Несуществующий = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-нет-каталога-" + Строка(Новый УникальныйИдентификатор));
	Прежний = ПолучитьПеременнуюСреды("TMPDIR");

	Попытка
		УстановитьПеременнуюСреды("TMPDIR", Несуществующий);
		Резолвер = Новый РазрешительImёнСистемный();
		Результат = Резолвер.Разрешить("localhost");
	Исключение
		УстановитьПеременнуюСреды("TMPDIR", Прежний);
		ВызватьИсключение СтрШаблон(
			"сбой резолва улетел наружу вместо Неопределено: %1", ОписаниеОшибки());
	КонецПопытки;

	УстановитьПеременнуюСреды("TMPDIR", Прежний);

	Ожидаем.Что(Результат, "недоступный резолв — Неопределено, а не исключение").Равно(Неопределено);

КонецПроцедуры

// Недоступный резолв — это выключенный SSRF-гейт по адресу, и молчать о нём нельзя:
// оператор иначе никогда не узнает, что имена перестали проверяться.
&Тест
Процедура НедоступныйРезолвПишетПредупреждениеВЖурнал() Экспорт

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогФикстур, "ЛовушкаЛога.os"));

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.сеть.резолв");
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка);

	Несуществующий = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-нет-каталога-" + Строка(Новый УникальныйИдентификатор));
	Прежний = ПолучитьПеременнуюСреды("TMPDIR");

	Попытка
		УстановитьПеременнуюСреды("TMPDIR", Несуществующий);
		Резолвер = Новый РазрешительImёнСистемный(, , , Лог);
		Резолвер.Разрешить("localtest.me");
	Исключение
		УстановитьПеременнуюСреды("TMPDIR", Прежний);
		ВызватьИсключение;
	КонецПопытки;

	УстановитьПеременнуюСреды("TMPDIR", Прежний);

	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "localtest.me") > 0,
		"в журнале названо имя, для которого резолв не отработал: " + Ловушка.Всё()).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "не проверен") > 0
			ИЛИ СтрНайти(Ловушка.Всё(), "сорвался") > 0,
		"сказано, что адрес по результату разрешения имени не проверен: " + Ловушка.Всё())
		.ЭтоИстина();

КонецПроцедуры

Функция ЕстьPython3()

	КодВозврата = 0;
	Попытка
		ЗапуститьПриложение("/bin/sh -c ""command -v python3 >/dev/null 2>&1""", , Истина, КодВозврата);
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Возврат КодВозврата = 0;

КонецФункции

// Пробел в имени намеренный: временный каталог пользователя может его содержать.
Функция НоваяПесочницаTMPDIR()

	Песочница = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub резолв " + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Песочница);
	Возврат Песочница;

КонецФункции

Функция ИменаФайлов(Знач Каталог)

	Результат = Новый Массив();
	Для Каждого Найденный Из НайтиФайлы(Каталог, "*") Цикл
		Результат.Добавить(Найденный.Имя);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СверитьКоды(Расхождения, Знач Хосты, Знач Ожидаемый)
	Для Каждого Хост Из Хосты Цикл
		Вердикт = Политика.Вердикт(Хост);
		Если Вердикт.Код <> Ожидаемый Тогда
			Расхождения.Добавить(СтрШаблон("%1 → %2, ждали %3", Хост, Вердикт.Код, Ожидаемый));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// IPv6-литерал в URL живёт в скобках; имя и IPv4 — как есть.
Функция URL(Знач Схема, Знач Хост)
	Запись = ?(Найти(Хост, ":") > 0, "[" + Хост + "]", Хост);
	Возврат СтрШаблон("%1://%2/точка", Схема, Запись);
КонецФункции

Функция ВалидаторПровайдера()
	Возврат Новый ВалидаторАдресаПровайдера(Политика, Новый ИздателиOAuth2(),
		Новый ТекстыИнтерфейса(Новый СловарьТекстов()));
КонецФункции

Функция СтражКонвейеров()
	Возврат Новый СтражИздателейCI(Новый ВалидаторАдресаАпстрима(), Политика, Неопределено,
		Логирование.ПолучитьЛог("тест.oshub.своя-сеть"));
КонецФункции

#КонецОбласти
