// НФТ-ДОСТ-013: «своя сеть» у хаба одна. Набор адресов прогоняется через КАЖДУЮ судящую
// дверь — обе точки провайдера входа и издателя доверенного конвейера — и через саму
// политику; сверяется значение вердикта, а не текст исходников.

#Использовать asserts
#Использовать autumn-logos
#Использовать oscript-ui
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем Политика;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.ПодключитьОснову(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "сеть", "Классы"), "СвояСеть");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "зеркала", "Классы"), "ВалидаторАдресаАпстрима");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "публикация", "Классы"), "СтражИздателейCI");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "ВалидаторАдресаПровайдера");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "ИздателиOAuth2");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "интерфейс", "Классы"), "СловарьТекстов");

КонецПроцедуры

&ПередКаждым
Процедура СобратьПолитику() Экспорт
	Политика = Новый СвояСеть(Новый КанонIP());
КонецПроцедуры

#Область ОдноПравило

// Список сетей один: вердикт политики на векторах истории сверяется ЗНАЧЕНИЕМ. Уберите
// диапазон из СетиПолитики() — покраснеет здесь, а не в текстовом скане исходников.
&Тест
Процедура ОдинСписокСетейОдинВердикт() Экспорт

	Расхождения = Новый Массив();
	СверитьКоды(Расхождения, СвояСеть(), Политика.Коды().СвояСеть);
	СверитьКоды(Расхождения, НеДляИнтернета(), Политика.Коды().НеДляИнтернета);
	СверитьКоды(Расхождения, НестрогаяЗапись(), Политика.Коды().НеАдрес);
	СверитьКоды(Расхождения, Интернет(), Политика.Коды().Интернет);

	Ожидаем.Что(СтрСоединить(Расхождения, "; "),
		"вердикт политики разошёлся с набором адресов истории").Равно("");

КонецПроцедуры

// Нестрогая запись — «не адрес», а не разобранный по-своему адрес и не DNS-имя.
&Тест
Процедура НестрогаяЗаписьЭтоНеАдрес() Экспорт

	Для Каждого Хост Из НестрогаяЗапись() Цикл
		Ожидаем.Что(Политика.Вердикт(Хост).Код,
			СтрШаблон("«%1» разобран по-своему вместо отказа", Хост))
			.Равно(Политика.Коды().НеАдрес);
	КонецЦикла;

	// КОНТРОЛЬ: строгая запись тех же четырёх октетов адресом является
	Ожидаем.Что(Политика.Вердикт("127.0.0.1").Код, "КОНТРОЛЬ: строгая запись петли — адрес")
		.Равно(Политика.Коды().СвояСеть);

КонецПроцедуры

// Вложенный IPv4 — отображённый, совместимый и NAT64 — судится как сам IPv4, и своей,
// и публичной стороной.
&Тест
Процедура ВложенныйIPv4СудитсяКакIPv4() Экспорт

	Пары = Новый Соответствие();
	Пары.Вставить("::ffff:127.0.0.1", "127.0.0.1");
	Пары.Вставить("::ffff:169.254.169.254", "169.254.169.254");
	Пары.Вставить("64:ff9b::a9fe:a9fe", "169.254.169.254");
	Пары.Вставить("::7f00:1", "127.0.0.1");
	Пары.Вставить("::ffff:8.8.8.8", "8.8.8.8");
	Пары.Вставить("64:ff9b::8080:8080", "128.128.128.128");

	Расхождения = Новый Массив();
	Для Каждого Пара Из Пары Цикл
		Обёрнутый = Политика.Вердикт(Пара.Ключ);
		Голый = Политика.Вердикт(Пара.Значение);
		Если Обёрнутый.Код <> Голый.Код ИЛИ Обёрнутый.Сеть <> Голый.Сеть Тогда
			Расхождения.Добавить(СтрШаблон("%1 (%2) <> %3 (%4)",
				Пара.Ключ, Обёрнутый.Код, Пара.Значение, Голый.Код));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Расхождения, "; "),
		"вложенный IPv4 судится не как сам IPv4").Равно("");

КонецПроцедуры

// localhost и *.localhost — своя сеть по САМОМУ имени: имён хаб не разрешает вовсе,
// и петля по имени обязана узнаваться списком, а не ответом DNS.
&Тест
Процедура LocalhostСвояСетьБезРезолва() Экспорт

	Ожидаем.Что(Политика.ЭтоСвояСеть("localhost"), "localhost — своя сеть").ЭтоИстина();
	Ожидаем.Что(Политика.ЭтоСвояСеть("x.localhost"), "*.localhost — своя сеть").ЭтоИстина();
	// хвостовая точка — корень доменного дерева (RFC 6761), а не другое имя: «localhost.»
	// ведёт ровно туда же, куда и «localhost»
	Ожидаем.Что(Политика.ЭтоСвояСеть("localhost."),
		"localhost с корневой точкой — та же петля").ЭтоИстина();
	Ожидаем.Что(Политика.ЭтоПетля("x.localhost."),
		"и поддомен с корневой точкой тоже").ЭтоИстина();

	// КОНТРОЛЬ: похожее имя своим не становится
	Ожидаем.Что(Политика.ЭтоСвояСеть("localhost.evil.com"),
		"КОНТРОЛЬ: чужой домен с приставкой localhost — не своя сеть").ЭтоЛожь();
	Ожидаем.Что(Политика.ЭтоСвояСеть("localhost.evil.com."),
		"КОНТРОЛЬ: и он же с корневой точкой").ЭтоЛожь();

КонецПроцедуры

// Политику судит ЗАПИСЬ адреса: имя — это «интернет», и никаким внешним ответом
// вердикт по нему не меняется. Принятый риск НФТ-ДОСТ-013: имя, ведущее во внутреннюю
// сеть, дверью не отбивается.
&Тест
Процедура ИмяСудитсяТолькоПоЗаписи() Экспорт

	Ожидаем.Что(Политика.Вердикт("internal.corp").Код,
		"имя — интернет, чем бы оно ни оказалось").Равно(Политика.Коды().Интернет);
	Ожидаем.Что(Политика.Вердикт("internal.corp").Текст,
		"у вердикта «интернет» причины нет").Равно("");

	// КОНТРОЛЬ: тот же адрес записью судится своим — отличие ровно в записи
	Ожидаем.Что(Политика.Вердикт("10.0.0.5").Код,
		"КОНТРОЛЬ: запись частного адреса — своя сеть").Равно(Политика.Коды().СвояСеть);

КонецПроцедуры

#КонецОбласти

#Область СудящиеДвери

// Одни и те же адреса отвергают ОБЕ двери, которые судят сеть: точка провайдера входа
// и адрес издателя доверенного конвейера.
&Тест
Процедура КаждаяСудящаяДверьОтвергаетВесьНабор() Экспорт

	Проехавшие = Новый Массив();
	Для Каждого Хост Из ОтвергаемыеВезде() Цикл
		Если ВалидаторПровайдера().ПроверитьТочку(URL("https", Хост), "точка").Успех Тогда
			Проехавшие.Добавить("точка провайдера: " + Хост);
		КонецЕсли;
		Если СтражКонвейеров().ДопустимАдрес(URL("https", Хост)).Успех Тогда
			Проехавшие.Добавить("издатель конвейера: " + Хост);
		КонецЕсли;
	КонецЦикла;

	// КОНТРОЛЬ: публичный адрес проезжает обе двери — отличие ровно в адресе
	Ожидаем.Что(ВалидаторПровайдера().ПроверитьТочку("https://idp.example.com/authorize", "точка").Успех,
		"КОНТРОЛЬ: публичное имя проходит точку провайдера").ЭтоИстина();
	Ожидаем.Что(СтражКонвейеров().ДопустимАдрес("https://token.actions.githubusercontent.com/keys").Успех,
		"КОНТРОЛЬ: публичное имя проходит издателя конвейера").ЭтоИстина();

	Ожидаем.Что(СтрСоединить(Проехавшие, Символы.ПС),
		"адреса, проехавшие судящую дверь:").Равно("");

КонецПроцедуры

// Обе двери отвергают ОДНИМИ СЛОВАМИ: причину формулирует политика, а не каждая дверь сама.
&Тест
Процедура ОбеДвериОтвергаютОднимиСловами() Экспорт

	Расхождения = Новый Массив();
	Для Каждого Хост Из ОтвергаемыеВезде() Цикл
		Причина = Политика.Вердикт(Хост).Текст;
		Точка = ВалидаторПровайдера().ПроверитьТочку(URL("https", Хост), "точка").Сообщение;
		Издатель = СтражКонвейеров().ДопустимАдрес(URL("https", Хост)).Сообщение;
		Если СтрНайти(Точка, Причина) = 0 Тогда
			Расхождения.Добавить(СтрШаблон("%1 — точка провайдера: «%2»", Хост, Точка));
		КонецЕсли;
		Если СтрНайти(Издатель, Причина) = 0 Тогда
			Расхождения.Добавить(СтрШаблон("%1 — издатель конвейера: «%2»", Хост, Издатель));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Расхождения, Символы.ПС),
		СтрШаблон("дверь назвала причину не словами политики (ждали «%1»):",
			Политика.Вердикт("127.0.0.2").Текст)).Равно("");

КонецПроцедуры

// Адрес возврата судит тем же списком сетей, но берёт из него РОВНО ПЕТЛЮ: по этому
// адресу едет authorization code, и открытым каналом он не должен покидать узел.
// Выигрыш требования — в записях петли, которых прежние три литерала не знали
// (127.0.0.2, x.localhost, ::ffff:127.0.0.1), а не в расширении разрешения на всю
// свою сеть: частная сеть, link-local, CGNAT и незаданный адрес по http отвергаются.
&Тест
Процедура АдресВозвратаПускаетHTTPРовноВПетлю() Экспорт

	Отвергнутые = Новый Массив();
	Для Каждого Хост Из Петля() Цикл
		Если НЕ ВалидаторПровайдера().ПроверитьАдресВозврата(URL("http", Хост)).Успех Тогда
			Отвергнутые.Добавить(Хост);
		КонецЕсли;
	КонецЦикла;

	Проехавшие = Новый Массив();
	Для Каждого Хост Из НеПетля() Цикл
		Если ВалидаторПровайдера().ПроверитьАдресВозврата(URL("http", Хост)).Успех Тогда
			Проехавшие.Добавить(Хост);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Отвергнутые, ", "),
		"запись петли, которую дверь возврата петлёй не признала").Равно("");
	Ожидаем.Что(СтрСоединить(Проехавшие, ", "),
		"http по адресу возврата уехал за пределы петли").Равно("");

	// КОНТРОЛЬ: по https те же адреса ходят — отличие ровно в схеме
	Ожидаем.Что(ВалидаторПровайдера().ПроверитьАдресВозврата("https://hub.example.com/cb").Успех,
		"КОНТРОЛЬ: https принимается").ЭтоИстина();

КонецПроцедуры

// Петля и «своя сеть» — не одно и то же, и политика различает их сама: иначе дверь
// возврата пришлось бы учить третьему определению.
&Тест
Процедура ПетляУжеСвоейСетиНоСудитсяТемЖеСписком() Экспорт

	НеПетлевые = Новый Массив();
	Для Каждого Хост Из НеПетля() Цикл
		Если Политика.ЭтоПетля(Хост) Тогда
			НеПетлевые.Добавить(Хост);
		КонецЕсли;
	КонецЦикла;

	Непризнанные = Новый Массив();
	Для Каждого Хост Из Петля() Цикл
		Если НЕ (Политика.ЭтоПетля(Хост) И Политика.ЭтоСвояСеть(Хост)) Тогда
			Непризнанные.Добавить(Хост);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(НеПетлевые, ", "), "петлёй названо лишнее").Равно("");
	Ожидаем.Что(СтрСоединить(Непризнанные, ", "),
		"запись петли не признана петлёй либо своей сетью").Равно("");

	// у петли одно имя сети во всех её записях — различие живёт в тексте причины
	Ожидаем.Что(Политика.Вердикт("localhost").Сеть,
		"имя сети у петли по имени и по адресу одно").Равно(Политика.Вердикт("127.0.0.1").Сеть);
	Ожидаем.Что(Политика.Вердикт("localhost").Текст = Политика.Вердикт("127.0.0.1").Текст,
		"а причина у них разная — иначе отказ не объясняет, что узнал хаб").ЭтоЛожь();

КонецПроцедуры

// Публичные адреса всех форм проходят обе судящие двери: гейт не превратился в «запрещено всё».
&Тест
Процедура ПубличныеАдресаПроходятОбеДвери() Экспорт

	Отвергнутые = Новый Массив();
	Для Каждого Хост Из Интернет() Цикл
		Точка = ВалидаторПровайдера().ПроверитьТочку(URL("https", Хост), "точка");
		Если НЕ Точка.Успех Тогда
			Отвергнутые.Добавить("точка провайдера: " + Хост + " — " + Точка.Сообщение);
		КонецЕсли;
		Издатель = СтражКонвейеров().ДопустимАдрес(URL("https", Хост));
		Если НЕ Издатель.Успех Тогда
			Отвергнутые.Добавить("издатель конвейера: " + Хост + " — " + Издатель.Сообщение);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Отвергнутые, Символы.ПС),
		"публичные адреса, отвергнутые судящей дверью:").Равно("");

КонецПроцедуры

#КонецОбласти

#Область НаборыАдресов

// Своя сеть — петля, частные, link-local, ULA, CGNAT, NAT64, незаданный и localhost.
Функция СвояСеть()
	Возврат СтрРазделить("127.0.0.2,::1,::ffff:127.0.0.1,10.1.2.3,fc00::1,169.254.169.254,"
		+ "::ffff:169.254.169.254,64:ff9b::a9fe:a9fe,fe80::1,100.64.0.1,0.0.0.0,::,"
		+ "localhost,x.localhost", ",");
КонецФункции

// Непригодные для интернета: групповые, зарезервированные, документационные, тестовые
// и служебные дыры IPv6 — их база стран зовёт настоящей страной. Семь адресов из блока
// назначений протоколов IETF взяты по одному на назначение: Teredo, протокольные
// присвоения, испытательный стенд, AMT, ORCHID обеих версий и удалённую идентификацию.
Функция НеДляИнтернета()
	Возврат СтрРазделить("224.0.0.1,240.0.0.1,255.255.255.255,192.0.2.1,198.18.0.1,"
		+ "2001:db8::1,3fff::1,5f00::1,"
		+ "2001::1,2001:1::1,2001:2::1,2001:3::1,2001:10::1,2001:20::1,2001:30::1,"
		+ "fe00::1,fe40::1,fec0::1", ",");
КонецФункции

// Нестрогие записи: восьмеричная, шестнадцатеричная, сокращённая и одним числом.
Функция НестрогаяЗапись()
	Возврат СтрРазделить("0x7f.0.0.1,127.1,0177.0.0.1,2130706433", ",");
КонецФункции

// Контрольная сторона набора: адреса и имена, которым в интернете самое место.
Функция Интернет()
	Возврат СтрРазделить("8.8.8.8,172.15.0.1,example.com,2606:4700:4700::1111,"
		+ "::ffff:8.8.8.8,64:ff9b::8080:8080", ",");
КонецФункции

// Петля во всех записях — единственное, что дверь возврата пускает по http.
Функция Петля()
	Возврат СтрРазделить("127.0.0.2,::1,::ffff:127.0.0.1,localhost,x.localhost", ",");
КонецФункции

// Остальная своя сеть плюс непригодные для интернета и нестрогие записи: по http
// адресом возврата быть не могут.
Функция НеПетля()
	Возврат Объединить(Объединить(
		СтрРазделить("10.1.2.3,fc00::1,169.254.169.254,100.64.0.1,fe80::1,0.0.0.0,::,"
			+ "64:ff9b::a9fe:a9fe,::ffff:169.254.169.254,::ffff:10.0.0.1", ","),
		НеДляИнтернета()), НестрогаяЗапись());
КонецФункции

Функция ОтвергаемыеВезде()
	Возврат Объединить(Объединить(СвояСеть(), НеДляИнтернета()), НестрогаяЗапись());
КонецФункции

Функция Объединить(Знач Левые, Знач Правые)
	Результат = Новый Массив();
	Для Каждого Элемент Из Левые Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;
	Для Каждого Элемент Из Правые Цикл
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СверитьКоды(Расхождения, Знач Хосты, Знач Ожидаемый)
	Для Каждого Хост Из Хосты Цикл
		Вердикт = Политика.Вердикт(Хост);
		Если Вердикт.Код <> Ожидаемый Тогда
			Расхождения.Добавить(СтрШаблон("%1 → %2, ждали %3", Хост, Вердикт.Код, Ожидаемый));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// IPv6-литерал в URL живёт в скобках; имя и IPv4 — как есть.
Функция URL(Знач Схема, Знач Хост)
	Запись = ?(Найти(Хост, ":") > 0, "[" + Хост + "]", Хост);
	Возврат СтрШаблон("%1://%2/точка", Схема, Запись);
КонецФункции

Функция ВалидаторПровайдера()
	Возврат Новый ВалидаторАдресаПровайдера(Политика, Новый ИздателиOAuth2(),
		Новый ТекстыИнтерфейса(Новый СловарьТекстов()));
КонецФункции

Функция СтражКонвейеров()
	Возврат Новый СтражИздателейCI(Новый ВалидаторАдресаАпстрима(), Политика, Неопределено,
		Логирование.ПолучитьЛог("тест.oshub.своя-сеть"));
КонецФункции

#КонецОбласти
