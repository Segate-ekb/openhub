&Тест
Процедура ГрантСозданияИTOFUВладение() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");
	Пул = СоздатьLocalПул(); // случайное имя (не «public») → TOFU разрешён
	Польз = СоздатьПользователя();
	Доступ.ЗафиксироватьГрант("пользователь", Польз.Идентификатор, Права.ОбъектПул(Пул),
		Новый Структура("создание, изменение, удаление, чтение", Истина, Ложь, Ложь, Ложь), 0);

	ИмяПакета = УникальноеИмя("tofu");
	Результат = Опубликовать(Пул, Польз, ИмяПакета, "1.0.0", "stable", "");
	Ожидаем.Что(Результат.Успех, "грант создание разрешает первое имя: " + Результат.Сообщение).ЭтоИстина();

	// TOFU: публикатор стал владельцем пакета (получил удаление на пакет, чего у него не было)
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Ожидаем.Что(Права.РазрешеноДействие(Польз, "удаление", Права.ОбъектПакет(Пакет)),
		"TOFU дал владельцу удаление на пакет").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВДефолтномПулеTOFUВладенияНет() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");
	Public = ОбеспечитьДефолтныйПул();
	Польз = СоздатьПользователя();
	Доступ.ЗафиксироватьГрант("пользователь", Польз.Идентификатор, Права.ОбъектПул(Public),
		Новый Структура("создание, изменение, удаление, чтение", Истина, Истина, Ложь, Ложь), 0);

	ИмяПакета = УникальноеИмя("pubname");
	Результат = Опубликовать(Public, Польз, ИмяПакета, "1.0.0", "stable", "");
	Ожидаем.Что(Результат.Успех, "с грантом можно опубликовать в дефолтный пул").ЭтоИстина();

	Пакет = Желудь("СервисПакетов").НайтиПакет(Public.Идентификатор, ИмяПакета);
	Ожидаем.Что(Права.РазрешеноДействие(Польз, "удаление", Права.ОбъектПакет(Пакет)),
		"дефолтный пул: авто-TOFU-владения нет (удаления не появилось)").ЭтоЛожь();

	// КОНТРОЛЬ рядом: тот же сценарий в НЕ-дефолтном пуле TOFU ДАЁТ. Без него первый
	// ассерт был бы ложно-зелёным при вовсе сломанном TOFU.
	Обычный = СоздатьLocalПул();
	Доступ.ЗафиксироватьГрант("пользователь", Польз.Идентификатор, Права.ОбъектПул(Обычный),
		Новый Структура("создание, изменение, удаление, чтение", Истина, Истина, Ложь, Ложь), 0);
	ИмяВОбычном = УникальноеИмя("plainname");
	Ожидаем.Что(Опубликовать(Обычный, Польз, ИмяВОбычном, "1.0.0", "stable", "").Успех,
		"контроль: публикация в обычный пул прошла").ЭтоИстина();
	ПакетОбычный = Желудь("СервисПакетов").НайтиПакет(Обычный.Идентификатор, ИмяВОбычном);
	Ожидаем.Что(Права.РазрешеноДействие(Польз, "удаление", Права.ОбъектПакет(ПакетОбычный)),
		"контроль: в обычном пуле TOFU сработал").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЛегасиGitHubТолькоВДефолтномПулеИПоОпцииХаба() Экспорт

	Настройки = Желудь("СервисНастроек");
	Дефолтный = ОбеспечитьДефолтныйПул();
	ИмяПакета = УникальноеИмя("ghpkg");
	Токен = "gh-token-xyz";
	Желудь("ПроверяющийGitHub").Разрешить(Токен, ИмяПакета);

	Попытка

		// 1. опция хаба выключена (дефолт) — write-доступ на GitHub права не даёт
		Настройки.Установить("oshub.publish.github_legacy", Ложь, Неопределено);
		Отказ = Опубликовать(Дефолтный, Неопределено, ИмяПакета, "1.0.0", "stable", Токен);
		Ожидаем.Что(Отказ.Успех, "опция хаба выключена → легаси-путь закрыт").ЭтоЛожь();
		Ожидаем.Что(Отказ.Код, "нет принципала и легаси выключен → 401").Равно(401);

		// 2. КОНТРОЛЬ, отличающийся РОВНО опцией: включаем — тот же push проходит
		Настройки.Установить("oshub.publish.github_legacy", Истина, Неопределено);
		Успех = Опубликовать(Дефолтный, Неопределено, ИмяПакета, "1.0.0", "stable", Токен);
		Ожидаем.Что(Успех.Успех, "опция включена + дефолтный пул → push: " + Успех.Сообщение).ЭтоИстина();

		// 3. НЕ дефолтный пул — отказ даже при включённой опции и старом флаге пула
		Обычный = СоздатьLocalПул();
		Желудь("СервисПулов").УстановитьФлаг(Обычный.Идентификатор, "github_compat", Истина);
		Обычный = Желудь("СервисПулов").ПулПоИдентификатору(Обычный.Идентификатор);
		ВтороеИмя = УникальноеИмя("ghpkg2");
		Желудь("ПроверяющийGitHub").Разрешить(Токен, ВтороеИмя);
		ВнеДефолта = Опубликовать(Обычный, Неопределено, ВтороеИмя, "1.0.0", "stable", Токен);
		Ожидаем.Что(ВнеДефолта.Успех,
			"легаси-путь вне дефолтного пула закрыт даже со старым флагом github_compat").ЭтоЛожь();

	Исключение
		Настройки.Установить("oshub.publish.github_legacy", Ложь, Неопределено);
		ВызватьИсключение;
	КонецПопытки;

	Настройки.Установить("oshub.publish.github_legacy", Ложь, Неопределено);

КонецПроцедуры

