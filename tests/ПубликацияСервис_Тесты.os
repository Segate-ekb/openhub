// Юнит-тесты сервиса публикации (push) на контейнере ОСени с КоннекторInMemory и файловым
// хранилищем во временном каталоге: авторизация, иммутабельность, сверка манифеста.
// Набор изолирован процессом: второй контейнер конфликтует с контейнером раннера OneUnit.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать ospx-tools
// autumn-logos — единая точка входа логирования: классу, созданному НАПРЯМУЮ (минуя
// контейнер ОСени), лог передаёт тест параметром конструктора (дисциплина 6.D)
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем КореньХранилища;
Перем КаталогСборки;
Перем Счётчик;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Счётчик = 0;
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("данные", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("хранилище", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("реестр", "Классы")));

	// SSRF-гейт апстримов (5.B): СервисПулов требует валидатор адреса ОБЯЗАТЕЛЬНО
	// (fail-closed). Модули webhooks/mirror целиком не тянем — в webhooks рогатки,
	// которым нужен весь хаб; фикстура подключает ровно три класса гейта.
	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();

	// из auth берём только сервис прав и группы (без web/session/pwhash); контракт
	// ПроверяющийGitHub — интерфейс, реальную реализацию НЕ грузим (её место — фейк)
	КаталогВхода = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("вход", "Классы"));
	ПоискКлассов.Подключить(КаталогМодулей, "СервисПрав");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисГрупп");
	ПоискКлассов.Подключить(КаталогМодулей, "СервисПравДоступа");
	ПоискКлассов.Подключить(КаталогМодулей, "ПроверяющийGitHub");
	// гейт ключа (7.A п.3): СервисПубликации спрашивает у него скоуп и привязку PAT
	// ДО модели прав. Он тянет СервисТокенов (разбор строки скоупов — там, второго
	// разбора не заводим), тот — ХранилищеТокенов из db.
	ПоискКлассов.Подключить(КаталогМодулей, "СервисТокенов");
	ПоискКлассов.Подключить(КаталогМодулей, "ГейтТокена");
	// ГвардКлюча (7.B) — единая формулировка рамок ключа на доменных мутациях; его
	// спрашивает СервисДоверияCI
	ПоискКлассов.Подключить(КаталогМодулей, "ГвардКлюча");

	// события + аудит (шаг 2.F): СервисПубликации публикует доменное событие, на него
	// подписана СлужбаАудита и пишет строку в файловый журнал аудита
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("события", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("аудит", "Классы")));

	// observability (этап 4): издатель событий инъектирует желудь «Телеметрия» (в этом
	// контейнере выключенный, no-op). Ему нужны БуферСпановТелеметрии (наблюдаемость) и
	// ТранспортHTTP (сеть) — регистрируем минимально необходимое.
	КаталогNet = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("сеть", "Классы"));
	КаталогObs = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/телеметрия"));
	КаталогПроб = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/пробы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КоннекторHTTPБиблиотеки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КлиентHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "БуферСпанов.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "СпанХаба.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "Телеметрия.os"));
	// ГотовностьХаба — гейт стартовых задач: рогатки модулей аудит /
	// stats / proxy / webhooks / jobs заявляют в ней свои задачи, поэтому желудь
	// обязан присутствовать в контейнере, иначе их бины не собираются.
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПроб, "ГотовностьХаба.os"));

	// общий модуль утилит (6.C п.8): классы реестра берут ПриведениеЧисел желудём
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("основа", "Классы")));

	// settings (7.E): СервисПубликации читает лимиты у резолвера СервисНастроек —
	// контейнеру нужны его желуди (реестр + резолвер), дома/контроллеры не тянем
	КаталогSettings = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("настройки", "Классы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВидыПроверок.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "НастройкиПодсистем.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "РеестрНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "СервисНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВалидаторНастроек.os"));

	// publish (7.B): СервисПубликации зависит от очереди заявок и доверенных конвейеров.
	// ОБЕ зависимости объявлены со значением по умолчанию, но это НЕ делает их
	// необязательными: ФабрикаЖелудей ОСени бросает исключение ДО конструктора, если бина
	// нет в контейнере, и Поделка кладёт Неопределено вместо ВСЕГО класса-потребителя
	// (измерено на этом же наборе: 34 из 35 красных). Поэтому классы перечислены здесь.
	КаталогPublish = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("публикация", "Классы"));
	ПоискКлассов.Подключить(КаталогPublish, "СервисВходящих");
	ПоискКлассов.Подключить(КаталогPublish, "СтражИздателейCI");
	ПоискКлассов.Подключить(КаталогPublish, "АудиторияТокенаCI");
	ПоискКлассов.Подключить(КаталогPublish, "СервисДоверияCI");
	ПоискКлассов.Подключить(КаталогPublish, "МестоВПуле");
	ПоискКлассов.Подключить(КаталогPublish, "СервисПубликации");

	// описания: README принятого пакета ложится на диск прямо в приёме версии, поэтому
	// хранилищу описаний место в этом контейнере
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("описания", "Классы")));

	// фейки прозвищ, чьи боевые реализации сюда не тянем: GitHub-проверяющий и
	// проверяющий подписи CI (боевой ходит за ключами в сеть)
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогТестов, "фикстуры"), "ФейкПроверяющийGitHub.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогТестов, "фикстуры"), "КодировкаТестов.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогТестов, "фикстуры"), "ФейкПроверяющийПодписиCI.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогТестов, "фикстуры"), "ФикстураПакета.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогТестов, "фикстуры"), "ЖурналАудитаФайлом.os"));

	КореньХранилища = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-push-unit-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньХранилища);
	КаталогСборки = ОбъединитьПути(КореньХранилища, "сборка");
	СоздатьКаталог(КаталогСборки);

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	Детальки.Вставить("oshub.publish.public_selfservice", "Ложь");

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "публикация-сервис-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	Попытка
		Если ЗначениеЗаполнено(КореньХранилища) И Новый Файл(КореньХранилища).Существует() Тогда
			УдалитьФайлы(КореньХранилища);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

// --- проверки ---

&Тест
Процедура ЖелудиPublishЗарегистрированы() Экспорт
	Для Каждого Имя Из СтрРазделить("СервисПубликации,СервисПрав,ПроверяющийGitHub,ХранилищеАртефактов", ",") Цикл
		Ожидаем.Что(Поделка.НайтиЖелудь(Имя), СтрШаблон("желудь %1", Имя)).Существует();
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура НесобранныйГейтКлючаЗакрываетPushПоТокенуНоНеВнутреннийВызов() Экспорт

	// БЛОКЕР Б-5 ревью: ветку fail-closed «гейт не собран» ревьюер снёс целиком, и оба
	// набора остались зелёными. Ветка страхует от повтора РЕАЛЬНОЙ ошибки этого же трека:
	// забытое присваивание в конструкторе оставило поле Неопределено, сборка прошла, и
	// энфорсмент ключа молча выключился.
	//
	// Экземпляр собирается НАПРЯМУЮ с Неопределено вместо гейта — контейнер здесь ни при
	// чём, проверяется поведение класса при несобранной зависимости.
	Сервис = Новый СервисПубликации(
		Желудь("СервисПулов"), Желудь("СервисПакетов"), Желудь("СервисВерсий"),
		Желудь("ПриёмВерсии"),
		Желудь("СервисМетокВерсий"), Желудь("ПравилаИменования"),
		Желудь("ХранилищеАртефактов"), Желудь("ЗаписьЗанятогоМеста"),
		Желудь("СервисПрав"), Неопределено,
		Желудь("СервисПравДоступа"), Желудь("ИздательСобытий"),
		Желудь("СервисНастроек"), Желудь("ИмяОбъектаАудита"),
		// очередь заявок и доверенные конвейеры (7.B) — ПОЗИЦИОННЫЕ параметры перед логом:
		// собранная очередь здесь не нужна (тест про несобранный гейт ключа), но пропустить
		// их нельзя — лог уехал бы в чужой параметр и молча выключил журнал
		Желудь("СервисВходящих"), Желудь("СервисДоверияCI"), ЛогТестов());

	Пул = СоздатьLocalПул();
	Польз = СоздатьПользователя();
	ВыдатьРоль(Пул, Польз, "publisher");

	Принципал = Новый Структура("Пользователь, Способ, Права, ПулИдентификатор, Сессия",
		Польз, "token", "read,write", 0, Неопределено);

	ПоТокену = Сервис.Опубликовать(Пул.Имя, ПостроитьOspxДанные("nogate", "1.0.0"),
		"nogate-1.0.0.ospx", "stable", Польз, "", Принципал);

	Ожидаем.Что(ПоТокену.Успех, "без собранного гейта публикация ПО КЛЮЧУ не проходит").ЭтоЛожь();
	Ожидаем.Что(ПоТокену.Код, "отказ ключа → 403").Равно(403);
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, "nogate"),
		"и пакет не заведён").Равно(Неопределено);

	// РАДИУС ПОРАЖЕНИЯ: запрос БЕЗ ключа (сессия кабинета, внутренний вызов, частичный
	// контейнер) продолжает работать — fail-closed сужен до ключа, а не до всего push
	БезКлюча = Сервис.Опубликовать(Пул.Имя, ПостроитьOspxДанные("nogate2", "1.0.0"),
		"nogate2-1.0.0.ospx", "stable", Польз, "");
	Ожидаем.Что(БезКлюча.Успех, "публикация без ключа не сломана").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ГейтКлючаЗакрываетPushТокеномБезЗаписиИЧужогоПула() Экспорт

	// 7.A п.3: скоуп PAT и привязка к пулу ЭНФОРСЯТСЯ на публикации. До этого шага оба
	// поля хранились и не читались: токен, выпущенный «только на чтение» и «только на
	// свой пул», публиковал в любой пул своего владельца. Права человека здесь полные —
	// красным становится ровно гейт ключа, а не модель прав.
	Пул = СоздатьLocalПул();
	Польз = СоздатьПользователя();
	ВыдатьРоль(Пул, Польз, "publisher");

	БезЗаписи = ОпубликоватьКлючом(Пул, Польз, "gate-scope", "1.0.0", "read", 0);
	Ожидаем.Что(БезЗаписи.Успех, "ключ без скоупа write не публикует").ЭтоЛожь();
	Ожидаем.Что(БезЗаписи.Код, "отказ ключа → 403").Равно(403);
	Ожидаем.Что(СтрНайти(БезЗаписи.Сообщение, "скоуп") > 0, "причина названа").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, "gate-scope"),
		"пакет не создан").Равно(Неопределено);

	ЧужойПул = ОпубликоватьКлючом(Пул, Польз, "gate-bind", "1.0.0", "read,write", Пул.Идентификатор + 1000);
	Ожидаем.Что(ЧужойПул.Успех, "ключ, привязанный к другому пулу, не публикует").ЭтоЛожь();
	Ожидаем.Что(ЧужойПул.Код, "отказ привязки → 403").Равно(403);
	Ожидаем.Что(СтрНайти(ЧужойПул.Сообщение, "другому пулу") > 0, "причина названа").ЭтоИстина();

	// свой пул и полный скоуп — публикация проходит (гейт не ломает штатный путь)
	Свой = ОпубликоватьКлючом(Пул, Польз, "gate-ok", "1.0.0", "read,write", Пул.Идентификатор);
	Ожидаем.Что(Свой.Успех, "свой пул и скоуп write публикуют").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗарезервированноеИмяПакетаОтклоняется() Экспорт

	// Находка ревью 5.B В-3: пакет `настройки` публиковался и ставился через opm, но его
	// страница /{pool}/settings навсегда перекрыта домом настроек пула — хаб принимал имя,
	// которое сам же не мог показать. Принимать такое молча нельзя.
	Пул = СоздатьLocalПул();
	Польз = СоздатьПользователя();
	ВыдатьРоль(Пул, Польз, "publisher");

	Результат = Опубликовать(Пул, Польз, "settings", "1.0.0", "stable", "");

	Ожидаем.Что(Результат.Успех, "зарезервированное имя пакета не публикуется").ЭтоЛожь();
	Ожидаем.Что(Результат.Код, "отказ ввода → 400").Равно(400);
	Ожидаем.Что(СтрНайти(Результат.Сообщение, "зарезервировано") > 0,
		"причина названа явно").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, "settings"),
		"пакет не создан").Равно(Неопределено);

	// регистр не обходит резерв
	Ожидаем.Что(Опубликовать(Пул, Польз, "SETTINGS", "1.0.0", "stable", "").Код,
		"регистр не обходит резерв").Равно(400);

	// соседнее имя по-прежнему принимается: резерв узкий и не мешает нормальным пакетам
	Ожидаем.Что(Опубликовать(Пул, Польз, "settings-helper", "1.0.0", "stable", "").Успех,
		"похожее имя публикуется").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НоваяВерсияПубликуетсяВLocalПул() Экспорт

	Пул = СоздатьLocalПул();
	Польз = СоздатьПользователя();
	ВыдатьРоль(Пул, Польз, "publisher");

	ИмяПакета = УникальноеИмя("pkg");
	Результат = Опубликовать(Пул, Польз, ИмяПакета, "1.0.0", "stable", "");

	Ожидаем.Что(Результат.Успех, "публикация успешна: " + Результат.Сообщение).ЭтоИстина();
	Ожидаем.Что(Результат.Код, "новая версия → 201").Равно(201);

	// артефакт лёг в хранилище, версия в реестре
	Координаты = Новый КоординатыАртефакта(Пул.Имя, ИмяПакета, "1.0.0");
	Ожидаем.Что(Желудь("ХранилищеАртефактов").Существует(Координаты), "артефакт сохранён").ЭтоИстина();

	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Ожидаем.Что(Пакет, "пакет зарегистрирован").Существует();
	Версия = Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, "1.0.0");
	Ожидаем.Что(Версия, "версия в реестре").Существует();

КонецПроцедуры

