// --- аудит (шаг 2.F): мутация публикации → запись в журнал с корректным принципалом ---

&Тест
Процедура АудитЗаписываетсяПриПубликации() Экспорт

	Пул = СоздатьLocalПул();
	Польз = СоздатьПользователя();
	ВыдатьРоль(Пул, Польз, "publisher");
	ИмяПакета = УникальноеИмя("audited");

	Результат = Опубликовать(Пул, Польз, ИмяПакета, "1.0.0", "stable", "");
	Ожидаем.Что(Результат.Успех, "публикация прошла: " + Результат.Сообщение).ЭтоИстина();

	Запись = НайтиЗаписьАудита(СтрШаблон("%1/%2@1.0.0", Пул.Имя, ИмяПакета));
	Ожидаем.Что(Запись, "по факту публикации создана запись аудита").Существует();
	Ожидаем.Что(Запись.Кто, "принципал аудита = логин публикатора").Равно(Польз.Логин);
	Ожидаем.Что(Запись.Действие, "действие — публикация версии").Равно("публикация.версии");
	Ожидаем.Что(СтрНайти(Запись.Детали, ИмяПакета) > 0, "детали содержат имя пакета").ЭтоИстина();

КонецПроцедуры

