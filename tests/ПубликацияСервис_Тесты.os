КонецПроцедуры

&Тест
Процедура ReleaseНеПерезаписатьЧерезCHANNELdev() Экспорт

	Пул = СоздатьLocalПул();
	Польз = СоздатьПользователя();
	ВыдатьРоль(Пул, Польз, "publisher");
	ИмяПакета = УникальноеИмя("attackdev");

	Первый = Опубликовать(Пул, Польз, ИмяПакета, "1.0.0", "stable", "");
	Ожидаем.Что(Первый.Код, "release 1.0.0 (stable) → 201").Равно(201);

	// подмена CHANNEL на dev запрет не снимает: канал — метка, а не право
	Атака = Опубликовать(Пул, Польз, ИмяПакета, "1.0.0", "dev", "");
	Ожидаем.Что(Атака.Успех, "release не перезаписывается через CHANNEL=dev").ЭтоЛожь();
	Ожидаем.Что(Атака.Код, "подмена CHANNEL=dev на release → 409").Равно(409);

КонецПроцедуры

&Тест
Процедура ReleaseНеПерезаписатьПустымCHANNEL() Экспорт

	Пул = СоздатьLocalПул();
	Польз = СоздатьПользователя();
	ВыдатьРоль(Пул, Польз, "publisher");
	ИмяПакета = УникальноеИмя("attackempty");

	Первый = Опубликовать(Пул, Польз, ИмяПакета, "1.0.0", "stable", "");
	Ожидаем.Что(Первый.Код).Равно(201);

	Атака = Опубликовать(Пул, Польз, ИмяПакета, "1.0.0", "", "");
	Ожидаем.Что(Атака.Успех, "release не перезаписывается пустым CHANNEL").ЭтоЛожь();
	Ожидаем.Что(Атака.Код, "пустой CHANNEL на release → 409").Равно(409);

КонецПроцедуры

// Вид версии перезапись больше не разрешает: пререлиз попадает под базовый тег prerelease,
// а запрет включён и на нём. До ИСТ-ПУБЛ-008 второй push пререлиза молча заменял чужой
// артефакт — установленная у людей 1.0.0-rc.1 оказывалась другими байтами.
&Тест
Процедура ПовторныйПререлизОтклоняетсяКакИRelease() Экспорт

	Пул = СоздатьLocalПул();
	Польз = СоздатьПользователя();
	ВыдатьРоль(Пул, Польз, "publisher");
	ИмяПакета = УникальноеИмя("pre");

	Первый = Опубликовать(Пул, Польз, ИмяПакета, "1.0.0-rc.1", "stable", "");
	Ожидаем.Что(Первый.Успех, "первый prerelease-push").ЭтоИстина();
	// каналы заводит мейнтейнер: сам хаб их не выдумывает, а запрет держит именно тег
	Визард().Создать(НайтиПакет(Пул, ИмяПакета).Идентификатор);

	Второй = Опубликовать(Пул, Польз, ИмяПакета, "1.0.0-rc.1", "stable", "");
	Ожидаем.Что(Второй.Успех, "пререлиз сам по себе перезапись не разрешает").ЭтоЛожь();
	Ожидаем.Что(Второй.Код, "повторный номер → конфликт, а не 400").Равно(409);
	Ожидаем.Что(СтрНайти(Второй.Сообщение, "?force=1") > 0,
		"отказ называет рабочую сегодня форму замены: " + Второй.Сообщение).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Второй.Сообщение, "prerelease") > 0,
		"и второй — с именем запрещающего тега: " + Второй.Сообщение).ЭтоИстина();

	// SNAPSHOT-маркер был вторым обходом той же природы — он тоже снят
	Снимок = УникальноеИмя("snap");
	Ожидаем.Что(Опубликовать(Пул, Польз, Снимок, "1.0.0-SNAPSHOT", "stable", "").Успех,
		"первый SNAPSHOT-push").ЭтоИстина();
	Ожидаем.Что(Опубликовать(Пул, Польз, Снимок, "1.0.0-SNAPSHOT", "stable", "").Код,
		"SNAPSHOT сам по себе перезапись не разрешает → 409").Равно(409);

КонецПроцедуры

// CHANNEL не влияет ни на запрет, ни на форс: заголовок остаётся меткой версии.
&Тест
Процедура ЗапретИФорсНеЗависятОтCHANNEL() Экспорт

	Пул = СоздатьLocalПул();
	Польз = СоздатьПользователя();
	ВыдатьРоль(Пул, Польз, "publisher");
	ИмяПакета = УникальноеИмя("preany");

	Ожидаем.Что(Опубликовать(Пул, Польз, ИмяПакета, "1.0.0-rc.1", "stable", "").Код,
		"prerelease → 201").Равно(201);

	Для Каждого Канал Из СтрРазделить("stable,dev,,экзотика", ",") Цикл
		Ожидаем.Что(Опубликовать(Пул, Польз, ИмяПакета, "1.0.0-rc.1", Канал, "").Код,
			СтрШаблон("CHANNEL ""%1"" запрет не снимает", Канал)).Равно(409);
	КонецЦикла;

	Ожидаем.Что(ОпубликоватьФорсом(Пул, Польз, ИмяПакета, "1.0.0-rc.1", "экзотика").Код,
		"а форс проходит при любом CHANNEL").Равно(200);

КонецПроцедуры

// Запрет висит на КАЖДОМ теге отдельно: пока хоть один тег версии его держит, номер
// неизменяем. Снятый на одном канале запрет соседний не отменяет.
&Тест
Процедура ЗапретДержитЛюбойИзТеговВерсии() Экспорт

	Пул = СоздатьLocalПул();
	Польз = СоздатьПользователя();
	ВыдатьРоль(Пул, Польз, "owner");
	ИмяПакета = УникальноеИмя("twotags");

	Ожидаем.Что(Опубликовать(Пул, Польз, ИмяПакета, "2.0.0", "stable", "").Код).Равно(201);
	Пакет = НайтиПакет(Пул, ИмяПакета);

	// каналы «по умолчанию» завёл мейнтейнер: версия попала и в stable, и в prerelease,
	// а сверху на неё повешен ручной тег lts
	Визард().Создать(Пакет.Идентификатор);
	Теги().ПометитьВерсию(Пакет.Идентификатор, "lts", "2.0.0");

	Ожидаем.Что(СнятьЗапрет(Пакет, "stable"), "запрет снят со stable").ЭтоИстина();
	Ожидаем.Что(Опубликовать(Пул, Польз, ИмяПакета, "2.0.0", "stable", "").Код,
		"prerelease и lts запрет держат → 409").Равно(409);

	Ожидаем.Что(СнятьЗапрет(Пакет, "prerelease"), "запрет снят с prerelease").ЭтоИстина();
	Отказ = Опубликовать(Пул, Польз, ИмяПакета, "2.0.0", "stable", "");
	Ожидаем.Что(Отказ.Код, "ручной lts держит запрет в одиночку → 409").Равно(409);
	Ожидаем.Что(СтрНайти(Отказ.Сообщение, "lts") > 0,
		"назван именно оставшийся тег: " + Отказ.Сообщение).ЭтоИстина();

	// снят на всех тегах версии — переиздание идёт свободно, без всякого форса
	Ожидаем.Что(СнятьЗапрет(Пакет, "lts"), "запрет снят с lts").ЭтоИстина();
	Свободная = Опубликовать(Пул, Польз, ИмяПакета, "2.0.0", "stable", "");
	Ожидаем.Что(Свободная.Успех, "запрета не осталось — перезапись свободна").ЭтоИстина();
	Ожидаем.Что(Свободная.Код).Равно(200);

КонецПроцедуры

// Роль на хабе перезаписи не даёт: у админа те же 409, что и у мейнтейнера, а заменяет
// номер только явный --force — и остаётся следом в журнале.
&Тест
Процедура АдминБезФорсаНеПерезаписываетАСФорсомПишетСлед() Экспорт

	Пул = СоздатьLocalПул();
	Админ = СоздатьАдмина();
	ИмяПакета = УникальноеИмя("adminrel");

	Ожидаем.Что(Опубликовать(Пул, Админ, ИмяПакета, "3.0.0", "stable", "").Успех,
		"первый release админа").ЭтоИстина();

	Второй = Опубликовать(Пул, Админ, ИмяПакета, "3.0.0", "stable", "");
	Ожидаем.Что(Второй.Успех, "роль админа перезапись не разрешает").ЭтоЛожь();
	Ожидаем.Что(Второй.Код, "админ без форса → 409").Равно(409);

	Форсом = ОпубликоватьФорсом(Пул, Админ, ИмяПакета, "3.0.0", "stable");
	Ожидаем.Что(Форсом.Успех, "с форсом номер заменяется: " + Форсом.Сообщение).ЭтоИстина();
	Ожидаем.Что(Форсом.Код, "замена номера → 200").Равно(200);

	Запись = НайтиЗаписьАудита(СтрШаблон("%1/%2@3.0.0", Пул.Имя, ИмяПакета));
	Ожидаем.Что(Запись, "запись аудита есть").Существует();
	Ожидаем.Что(Запись.Действие, "перезапись — в аудит").Равно("перезапись.версии");
	Ожидаем.Что(СтрНайти(Строка(Запись.Детали), """форс"": true") > 0,
		"и в деталях виден именно форс: " + Строка(Запись.Детали)).ЭтоИстина();

КонецПроцедуры

// Форс — не право, а способ: у того, кому публиковать нельзя, он не открывает ничего.
&Тест
Процедура ФорсНеЗаменяетПраваНаПубликацию() Экспорт

	Пул = СоздатьLocalПул();
	Хозяин = СоздатьПользователя();
	ВыдатьРоль(Пул, Хозяин, "owner");
	ИмяПакета = УникальноеИмя("forceacl");

	Ожидаем.Что(Опубликовать(Пул, Хозяин, ИмяПакета, "1.0.0", "stable", "").Успех,
		"владелец опубликовал первым").ЭтоИстина();
	ShaДо = Строка(НайтиВерсию(Пул, ИмяПакета, "1.0.0").Sha256);

	Чужой = СоздатьПользователя();
	БезПрава = ОпубликоватьФорсом(Пул, Чужой, ИмяПакета, "1.0.0", "stable");
	Ожидаем.Что(БезПрава.Успех, "форс без права публикации не проходит").ЭтоЛожь();
	Ожидаем.Что(БезПрава.Код, "нет права → 403, а не 200").Равно(403);
	Ожидаем.Что(Строка(НайтиВерсию(Пул, ИмяПакета, "1.0.0").Sha256),
		"и чужой артефакт не тронут").Равно(ShaДо);

КонецПроцедуры

// НФТ-ПУБЛ-002: отказ по правилу стоит ДО записи артефакта и до учёта байтов. Отклонённая
// публикация не оставляет ни новых байтов на диске, ни занятого места, ни записи в журнале,
// ни нового состава зависимостей.
&Тест
Процедура ОтклонённыйПовторныйПушНеОставляетСледов() Экспорт

	Пул = СоздатьLocalПул();
	Польз = СоздатьПользователя();
	ВыдатьРоль(Пул, Польз, "owner");
	ИмяПакета = УникальноеИмя("notrace");

	Первый = НовыйМанифест(ИмяПакета, "1.0.0");
	Первый.ДобавитьЗависимость("json", "1.0.0");
	Ожидаем.Что(ОпубликоватьМанифест(Пул, Польз, Первый).Успех, "первая публикация").ЭтоИстина();

	Координаты = Новый КоординатыАртефакта(Пул.Имя, ИмяПакета, "1.0.0");
	ShaДо = Строка(НайтиВерсию(Пул, ИмяПакета, "1.0.0").Sha256);
	РазмерДо = Желудь("ХранилищеАртефактов").Размер(Координаты);
	ЗанятоДо = ЗанятоПулом(Пул);
	ЗаписейДо = ЖурналАудита().ПоОбъекту(
		СтрШаблон("%1/%2@1.0.0", Пул.Имя, ИмяПакета)).Количество();

	// второй push ДРУГИМИ байтами: другой состав зависимостей — другой архив
	Другой = НовыйМанифест(ИмяПакета, "1.0.0");
	Другой.ДобавитьЗависимость("winow", "0.5.0");
	Другой.ДобавитьЗависимость("logos", "2.0.0");
	Отказ = ОпубликоватьМанифест(Пул, Польз, Другой);

	Ожидаем.Что(Отказ.Код, "повторный номер → 409").Равно(409);
	Ожидаем.Что(Строка(НайтиВерсию(Пул, ИмяПакета, "1.0.0").Sha256),
		"контрольная сумма версии не поменялась").Равно(ShaДо);
	Ожидаем.Что(Желудь("ХранилищеАртефактов").Размер(Координаты),
		"и байты на диске остались прежними").Равно(РазмерДо);
	Ожидаем.Что(ЗанятоПулом(Пул), "занятое место не выросло").Равно(ЗанятоДо);
	Ожидаем.Что(Желудь("УчётОбъёмаПула").Пересчитать(ЗаписьПула(Пул)),
		"и пересчёт по диску даёт то же").Равно(ЗанятоДо);
	Ожидаем.Что(ЖурналАудита().ПоОбъекту(СтрШаблон("%1/%2@1.0.0", Пул.Имя, ИмяПакета)).Количество(),
		"отклонённая публикация в журнал не пишется").Равно(ЗаписейДо);

	Состав = ЗависимостиВерсии(НайтиВерсию(Пул, ИмяПакета, "1.0.0"));
	Ожидаем.Что(Состав.Количество(), "состав зависимостей не тронут").Равно(1);
	Ожидаем.Что(НайтиЗависимость(Состав, "json"), "остался прежний").Существует();

КонецПроцедуры

// Версия, не попавшая НИ ПОД ОДИН тег, тоже неизменяема. Голый SNAPSHOT — единственная
// строка, которую валидатор пропускает, а semver-правила не ловят: до этого запрета такой
// номер молча переписывался вторым push, потому что запрещать было некому.
&Тест
Процедура ВерсияБезЕдиногоТегаЗапрещенаБезТега() Экспорт

	Пул = СоздатьLocalПул();
	Польз = СоздатьПользователя();
	ВыдатьРоль(Пул, Польз, "owner");
	ИмяПакета = УникальноеИмя("notag");

	Ожидаем.Что(Опубликовать(Пул, Польз, ИмяПакета, "SNAPSHOT", "stable", "").Код,
		"голый SNAPSHOT публикуется").Равно(201);
	Пакет = НайтиПакет(Пул, ИмяПакета);
	Ожидаем.Что(Теги().ЗапретПерезаписи(Пакет, "SNAPSHOT").ИмяТега,
		"под теги пакета такой номер не попадает").Равно("");

	Повтор = Опубликовать(Пул, Польз, ИмяПакета, "SNAPSHOT", "stable", "");
	Ожидаем.Что(Повтор.Код, "и всё равно 409, а не молчаливая замена").Равно(409);
	Ожидаем.Что(СтрНайти(Повтор.Сообщение, "?force=1") > 0,
		"назван единственный выход: " + Повтор.Сообщение).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Повтор.Сообщение, "снять запрет"),
		"и не предложено снимать запрет, которого не с чего снимать: " + Повтор.Сообщение).Равно(0);

	Ожидаем.Что(ОпубликоватьФорсом(Пул, Польз, ИмяПакета, "SNAPSHOT", "stable").Код,
		"форс такой номер заменяет").Равно(200);

КонецПроцедуры

// Тот же запрет без тега получается вторым путём: у пакета удалили все теги. Канал,
// из которого версия выпала, не имеет права открывать её переиздание всем.
&Тест
Процедура УдалениеВсехТеговНеОткрываетНомер() Экспорт

	Пул = СоздатьLocalПул();
	Польз = СоздатьПользователя();
	ВыдатьРоль(Пул, Польз, "owner");
	ИмяПакета = УникальноеИмя("notags");

	Ожидаем.Что(Опубликовать(Пул, Польз, ИмяПакета, "1.0.0", "stable", "").Код).Равно(201);
	Пакет = НайтиПакет(Пул, ИмяПакета);

	Для Каждого Тег Из Теги().ТегиПакета(Пакет.Идентификатор) Цикл
		Теги().УдалитьТег(Пакет.Идентификатор, Тег.Имя, "тест");
	КонецЦикла;
	Ожидаем.Что(Теги().ТегиПакета(Пакет.Идентификатор).Количество(),
		"тегов у пакета не осталось").Равно(0);

	Ожидаем.Что(Опубликовать(Пул, Польз, ИмяПакета, "1.0.0", "stable", "").Код,
		"номер без тегов по-прежнему неизменяем").Равно(409);
	Ожидаем.Что(ОпубликоватьФорсом(Пул, Польз, ИмяПакета, "1.0.0", "stable").Код,
		"а форс работает").Равно(200);

КонецПроцедуры

// Форс снимает ОДИН запрет — повторной публикации, и не становится ключом от всех дверей:
// негодная строка версии и номер, занятый именем тега, отвергаются с ним ровно так же.
&Тест
Процедура ФорсНеПроноситНиНегоднуюСтрокуНиИмяТега() Экспорт

	Пул = СоздатьLocalПул();
	Польз = СоздатьПользователя();
	ВыдатьРоль(Пул, Польз, "owner");
	ИмяПакета = УникальноеИмя("forcegate");

	Нулями = ОпубликоватьФорсом(Пул, Польз, ИмяПакета, "01.2.3", "stable");
	Ожидаем.Что(Нулями.Код, "ведущие нули с форсом — по-прежнему 400").Равно(400);
	Ожидаем.Что(НайтиПакет(Пул, ИмяПакета), "и пакет не заведён").Равно(Неопределено);

	// имя тега и номер версии не пересекаются (ИСТ-КАТ-023) — форс это правило не отменяет
	Ожидаем.Что(Опубликовать(Пул, Польз, ИмяПакета, "1.0.0", "stable", "").Код).Равно(201);
	Пакет = НайтиПакет(Пул, ИмяПакета);
	Теги().ОпределитьРучнойТег(Пакет.Идентификатор, "lts", "тест");

	ПодИмяТега = ОпубликоватьФорсом(Пул, Польз, ИмяПакета, "lts", "stable");
	Ожидаем.Что(ПодИмяТега.Успех, "номер, занятый именем тега, с форсом не проходит").ЭтоЛожь();
	Ожидаем.Что(ПодИмяТега.Код, "это отказ по вводу → 400").Равно(400);
	Ожидаем.Что(НайтиВерсию(Пул, ИмяПакета, "lts"), "версия не создана").Равно(Неопределено);

КонецПроцедуры

// Разбор параметра адреса один на обе двери публикации: невнятное значение — обычный push.
&Тест
Процедура ФлагФорсаЧитаетсяОдинаковоОбеимиДверями() Экспорт

	Сервис = Желудь("СервисПубликации");
	Для Каждого Значение Из СтрРазделить("1,true,TRUE,да,истина", ",") Цикл
		Ожидаем.Что(Сервис.ЭтоФорс(Значение), "«" + Значение + "» — форс").ЭтоИстина();
	КонецЦикла;
	Для Каждого Значение Из СтрРазделить("0,false,нет,абракадабра, ", ",") Цикл
		Ожидаем.Что(Сервис.ЭтоФорс(Значение), "«" + Значение + "» форсом не считается").ЭтоЛожь();
	КонецЦикла;
	Ожидаем.Что(Сервис.ЭтоФорс(""), "пустой параметр — обычный push").ЭтоЛожь();
	Ожидаем.Что(Сервис.ЭтоФорс(Неопределено), "и отсутствующий тоже").ЭтоЛожь();

