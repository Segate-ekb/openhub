// Как логи стартовали по настройкам — строка таблицы старта для лога, предка по имени и корня —
// и строки окружения, закрепляющие заданное с экрана поверх названного при старте.

#Использовать asserts
#Использовать "фикстуры"

&ТестовыйНабор
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	Журнал = ОбъединитьПути(КаталогМодулей(), "наблюдаемость", "Классы");
	ПоискКлассов.Подключить(Журнал, "ШкалаЖурнала");
	ПоискКлассов.Подключить(Журнал, "СтартЖурнала");
	ПоискКлассов.Подключить(Журнал, "ЗаданноеСЭкрана");
	ПоискКлассов.Подключить(Журнал, "ЗакреплениеЖурнала");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей(), "настройки", "Классы"), "ИменаПеременныхОкружения");

КонецПроцедуры

#Область Старт

&Тест
Процедура ЛогБезСвоейСтрокиСтартовалКакКорень() Экспорт

	Стартовал = Новый СтартЖурнала(Таблица(), Новый ШкалаЖурнала()).Лога("СервисНастроек");

	Ожидаем.Что(Стартовал.Уровень, "уровень корня").Равно("WARN");
	Ожидаем.Что(Стартовал.Свой, "свой уровень не назван").ЭтоЛожь();
	Ожидаем.Что(Стартовал.ПорогНазван, "и порога ему не называли").ЭтоЛожь();
	Ожидаем.Что(Стартовал.ИмяНастройки, "имя настройки корня").Равно("OSHUB_LOG_LEVELS");

КонецПроцедуры

&Тест
Процедура ЛогСоСвоейСтрокойНазванНастройкой() Экспорт

	Стартовал = Новый СтартЖурнала(Таблица(), Новый ШкалаЖурнала()).Лога("ГотовностьХаба");

	Ожидаем.Что(Стартовал.Уровень).Равно("DEBUG");
	Ожидаем.Что(Стартовал.Свой).ЭтоИстина();
	Ожидаем.Что(Стартовал.Откуда).Равно("окружение");
	Ожидаем.Что(Стартовал.ИмяНастройки).Равно("OSHUB_LOG_LEVELS");

КонецПроцедуры

// Настройку logos ищет по имени от лога к предкам: потомок названного лога живёт его уровнем,
// а не уровнем корня.
&Тест
Процедура ПотомокНазванногоЛогаЖивётЕгоУровнем() Экспорт

	Стартовал = Новый СтартЖурнала(Таблица(), Новый ШкалаЖурнала()).Лога("oscript.lib.entity.pool");

	Ожидаем.Что(Стартовал.Уровень, "уровень предка").Равно("ERROR");
	Ожидаем.Что(Стартовал.Свой, "свой — от предка, не от корня").ЭтоИстина();
	Ожидаем.Что(Стартовал.ИмяНастройки, "и настройка предка").Равно("logos.logger.oscript.lib.entity");

КонецПроцедуры

// Лог, названный только порогом коллектора, уровнем живёт на корне, а порог у него свой.
&Тест
Процедура ЛогСТолькоПорогомНаКорнеПоУровнюНоПорогНазван() Экспорт

	Стартовал = Новый СтартЖурнала(Таблица(), Новый ШкалаЖурнала()).Лога("СервисПрокси");

	Ожидаем.Что(Стартовал.Свой, "уровень не свой").ЭтоЛожь();
	Ожидаем.Что(Стартовал.ПорогНазван, "а порог назван").ЭтоИстина();
	Ожидаем.Что(Стартовал.Порог).Равно("ERROR");

КонецПроцедуры

// Порог, названный предку, действует на потомка, но в «названные этой настройкой» потомок
// не попадает: переменная, собранная из названных, не должна плодить пары.
&Тест
Процедура ПорогПредкаНазванПотомкуНоНеНазванИм() Экспорт

	Старт = Новый СтартЖурнала(Таблица(), Новый ШкалаЖурнала());

	Потомок = Старт.Лога("oscript.lib.winow.Сервер");
	Ожидаем.Что(Потомок.Порог, "порог предка").Равно("DISABLE");
	Ожидаем.Что(Потомок.ПорогНазван, "назван предку — значит, и ему").ЭтоИстина();

	Названные = Старт.ПорогиНазванные(ИменаОтбора("oshub.log.otel.levels"));
	Ожидаем.Что(Названные.Получить("oscript.lib.winow"), "предок назван").Равно("DISABLE");
	Ожидаем.Что(Названные.Получить("oscript.lib.winow.Сервер"), "потомок с порогом предка — нет")
		.Равно(Неопределено);
	Ожидаем.Что(Названные.Получить("rootLogger"), "общий порог парой корня").Равно("WARN");

КонецПроцедуры

&Тест
Процедура КореньОписанСвоейСтрокой() Экспорт

	Корень = Новый СтартЖурнала(Таблица(), Новый ШкалаЖурнала()).Корень();

	Ожидаем.Что(Корень.Уровень).Равно("WARN");
	Ожидаем.Что(Корень.Свой, "уровень корня назван").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Корень.Выходы, ","), "выходы").Равно("console,memory,otel");

КонецПроцедуры

// Лог, созданный раньше настроек, живёт умолчанием logos: свой уровень, откуда — умолчание,
// ни порога, ни выходов хаба.
&Тест
Процедура ЛогДоНастроекЖивётУмолчаниемLogos() Экспорт

	Стартовал = Новый СтартЖурнала(Таблица(), Новый ШкалаЖурнала()).ДоНастроек("INFO");

	Ожидаем.Что(Стартовал.Уровень).Равно("INFO");
	Ожидаем.Что(Стартовал.Свой, "не уровень корня").ЭтоИстина();
	Ожидаем.Что(Стартовал.Откуда).Равно("умолчание");
	Ожидаем.Что(Стартовал.Порог).Равно("");
	Ожидаем.Что(Стартовал.Выходы.Количество()).Равно(0);

КонецПроцедуры

&Тест
Процедура БезТаблицыКореньПоУмолчанию() Экспорт

	Старт = Новый СтартЖурнала(Неопределено, Новый ШкалаЖурнала());

	Ожидаем.Что(Старт.Корень().Уровень).Равно("INFO");
	Ожидаем.Что(Старт.Корень().Откуда).Равно("умолчание");
	Ожидаем.Что(Старт.Лога("Любой").ПорогНазван).ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Закрепление

&Тест
Процедура БезПравокЗакреплятьНечего() Экспорт
	Ожидаем.Что(Закрепление().Строки(Закрепляемое()).Количество()).Равно(0);
КонецПроцедуры

// Переменная окружения заменяет прежнее значение целиком: названное ею при старте остаётся
// в строке, заданное с экрана ложится поверх.
&Тест
Процедура ЗаданноеСЭкранаЛожитсяПоверхНазванногоПриСтарте() Экспорт

	Закрепляемое = Закрепляемое();
	Закрепляемое.Уровни.Вставить("СервисНастроек", "DEBUG");
	Закрепляемое.Уровни.Вставить("ГотовностьХаба", "INFO");
	Закрепляемое.Пороги.Вставить("СервисНастроек", "DISABLE");
	Закрепляемое.Пороги.Вставить("КлиентАпстрима", "WARN");

	Строки = Закрепление().Строки(Закрепляемое);

	// ГейтТокена назван ключом файла: файл его и сохранит, в переменную он не переезжает
	Ожидаем.Что(СтрСоединить(Строки, Символы.ПС), "уровни и пороги логов").Равно(
		"OSHUB_LOG_LEVELS=rootLogger=WARN,ГотовностьХаба=INFO,СервисНастроек=DEBUG" + Символы.ПС
		+ "OSHUB_LOG_OTEL_LEVELS=oscript.lib.winow=DISABLE,rootLogger=WARN,КлиентАпстрима=WARN,"
		+ "СервисНастроек=DISABLE,СервисПрокси=ERROR");

КонецПроцедуры

// Корень с экрана — своей переменной, а пара корня уходит из списка: две разные записи корня
// в одном окружении читались бы по старшинству, а не по смыслу.
&Тест
Процедура КореньЗакрепляетсяСвоимиПеременными() Экспорт

	Закрепляемое = Закрепляемое();
	Закрепляемое.Уровни.Вставить("rootLogger", "ERROR");
	Закрепляемое.Уровни.Вставить("СервисНастроек", "DEBUG");
	Закрепляемое.Пороги.Вставить("rootLogger", "DISABLE");

	Ожидаем.Что(СтрСоединить(Закрепление().Строки(Закрепляемое), ";"))
		.Равно("OSHUB_LOG_LEVEL=ERROR;OSHUB_LOG_LEVELS=ГотовностьХаба=DEBUG,СервисНастроек=DEBUG;"
			+ "OSHUB_LOG_OTEL_LEVEL=DISABLE");

КонецПроцедуры

#КонецОбласти

#Область Обвязка

// Таблица старта в том виде, в каком её кладёт загрузка настроек: корень задан окружением,
// один лог назван уровнем, один — только порогом, предок библиотеки — узлом файла.
Функция Таблица()

	Таблица = Новый Соответствие();
	Корень = Строка_("WARN", Истина, "окружение", "OSHUB_LOG_LEVELS", "WARN");
	СПорогом(Корень, "OSHUB_LOG_OTEL_LEVELS", Истина);
	Таблица.Вставить("rootLogger", Корень);
	Таблица.Вставить("ГотовностьХаба", Строка_("DEBUG", Истина, "окружение", "OSHUB_LOG_LEVELS", "WARN"));
	Таблица.Вставить("oscript.lib.entity", Строка_("ERROR", Истина, "файл", "logos.logger.oscript.lib.entity", "WARN"));
	Таблица.Вставить("ГейтТокена", Строка_("DEBUG", Истина, "файл", "oshub.log.levels", "WARN"));
	Прокси = Строка_("WARN", Ложь, "окружение", "OSHUB_LOG_LEVELS", "ERROR");
	СПорогом(Прокси, "OSHUB_LOG_OTEL_LEVELS", Истина);
	Таблица.Вставить("СервисПрокси", Прокси);
	Winow = Строка_("WARN", Ложь, "окружение", "OSHUB_LOG_LEVELS", "DISABLE");
	СПорогом(Winow, "OSHUB_LOG_OTEL_LEVELS", Истина);
	Таблица.Вставить("oscript.lib.winow", Winow);
	Возврат Таблица;

КонецФункции

Функция Строка_(Знач Уровень, Знач Свой, Знач Откуда, Знач ИмяНастройки, Знач Порог)
	Выходы = СтрРазделить("console,memory,otel", ",");
	Итог = Новый Соответствие();
	Итог.Вставить("Уровень", Уровень);
	Итог.Вставить("Свой", Свой);
	Итог.Вставить("Откуда", Откуда);
	Итог.Вставить("ИмяНастройки", ИмяНастройки);
	Итог.Вставить("Порог", Порог);
	Итог.Вставить("ПорогОткуда", ?(ЗначениеЗаполнено(Порог), Откуда, "умолчание"));
	Итог.Вставить("ПорогИмяНастройки", "");
	Итог.Вставить("ПорогСвой", Ложь);
	Итог.Вставить("Выходы", Выходы);
	Возврат Итог;
КонецФункции

Процедура СПорогом(Строка_, Знач ИмяНастройки, Знач Свой)
	Строка_.Вставить("ПорогИмяНастройки", ИмяНастройки);
	Строка_.Вставить("ПорогСвой", Свой);
КонецПроцедуры

Функция Закрепляемое()
	Возврат Новый Структура("Уровни, Пороги", Новый Соответствие(), Новый Соответствие());
КонецФункции

Функция ИменаОтбора(Знач Ключ)
	Итог = Новый Массив();
	Итог.Добавить(Ключ);
	Итог.Добавить(Новый ИменаПеременныхОкружения().Переменная(Ключ));
	Возврат Итог;
КонецФункции

Функция Закрепление()
	Возврат Новый ЗакреплениеЖурнала(Новый ШкалаЖурнала(), Новый СтартЖурнала(Таблица(), Новый ШкалаЖурнала()),
		Новый ИменаПеременныхОкружения());
КонецФункции

Функция КаталогМодулей()
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Возврат Новый Файл(ОбъединитьПути(КаталогТестов, "..", "src", "модули")).ПолноеИмя;
КонецФункции

#КонецОбласти
