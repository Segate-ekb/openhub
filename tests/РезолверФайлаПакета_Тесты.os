// Юнит-тесты разбора запроса артефакта (контракт opm): «{name}.ospx» и «{name}-{спец}.ospx»,
// плюс параметр spec, который старший над версионным слотом имени.

#Использовать asserts

Перем Резолвер;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ЗагрузитьКласс() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассов = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогКлассов = ОбъединитьПути(КаталогКлассов, "api", "Классы");
	ПутьКлассу = ОбъединитьПути(КаталогКлассов, "РезолверФайлаПакета.os");

	Если НЕ ТипЗарегистрирован("РезолверФайлаПакета") Тогда
		ПодключитьСценарий(ПутьКлассу, "РезолверФайлаПакета");
	КонецЕсли;

	Резолвер = Новый РезолверФайлаПакета();

КонецПроцедуры

&Тест
Процедура ЗапросПоследнейВерсии() Экспорт

	Разбор = Резолвер.РазобратьЗапросФайла("winow", "winow.ospx");

	Ожидаем.Что(Разбор, "запрос {name}.ospx распознан").Существует();
	Ожидаем.Что(Разбор.БезСпецификации).ЭтоИстина();
	Ожидаем.Что(Разбор.Спецификация).Равно("");

КонецПроцедуры

&Тест
Процедура ЗапросТочнойВерсии() Экспорт

	Разбор = Резолвер.РазобратьЗапросФайла("winow", "winow-1.2.3.ospx");

	Ожидаем.Что(Разбор).Существует();
	Ожидаем.Что(Разбор.БезСпецификации).ЭтоЛожь();
	Ожидаем.Что(Разбор.Спецификация).Равно("1.2.3");

КонецПроцедуры

&Тест
Процедура ВерсияСПререлизомИМетаданными() Экспорт

	Разбор = Резолвер.РазобратьЗапросФайла("mylib", "mylib-2.0.0-rc.1+build.5.ospx");

	Ожидаем.Что(Разбор).Существует();
	Ожидаем.Что(Разбор.БезСпецификации).ЭтоЛожь();
	Ожидаем.Что(Разбор.Спецификация, "версия извлекается целиком, вкл. пререлиз и +build").Равно("2.0.0-rc.1+build.5");

КонецПроцедуры

&Тест
Процедура LegacyЧетырёхкомпонентнаяВерсия() Экспорт

	Разбор = Резолвер.РазобратьЗапросФайла("pkg", "pkg-1.2.3.4.ospx");

	Ожидаем.Что(Разбор).Существует();
	Ожидаем.Что(Разбор.Спецификация).Равно("1.2.3.4");

КонецПроцедуры

&Тест
Процедура ИмяПакетаСДефисами() Экспорт

	Разбор = Резолвер.РазобратьЗапросФайла("spike0c-testpkg", "spike0c-testpkg-0.1.0.ospx");

	Ожидаем.Что(Разбор).Существует();
	Ожидаем.Что(Разбор.БезСпецификации).ЭтоЛожь();
	Ожидаем.Что(Разбор.Спецификация).Равно("0.1.0");

	РазборБезСпецификации = Резолвер.РазобратьЗапросФайла("spike0c-testpkg", "spike0c-testpkg.ospx");
	Ожидаем.Что(РазборБезСпецификации.БезСпецификации).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РегистрИмениНеЗначим() Экспорт

	Разбор = Резолвер.РазобратьЗапросФайла("WiNow", "winow-1.0.0.ospx");
	Ожидаем.Что(Разбор).Существует();
	Ожидаем.Что(Разбор.Спецификация).Равно("1.0.0");

	РазборБезСпецификации = Резолвер.РазобратьЗапросФайла("winow", "WINOW.ospx");
	Ожидаем.Что(РазборБезСпецификации.БезСпецификации).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СтрокаВерсииСохраняетРегистр() Экспорт

	Разбор = Резолвер.РазобратьЗапросФайла("pkg", "pkg-1.0.0-RC.1.ospx");
	Ожидаем.Что(Разбор.Спецификация, "регистр строки версии сохраняется").Равно("1.0.0-RC.1");

КонецПроцедуры

// Новый клиент называет спецификацию параметром, старый вклеивает её в имя файла.
// Пришли обе — параметр главнее: имя файла в этом случае легаси-подсказка того же запроса.
&Тест
Процедура ПараметрСпецификацииПеребиваетВерсионныйСлотИмени() Экспорт

	Разбор = Резолвер.РазобратьЗапросФайла("winow", "winow-1.2.3.ospx", "stable");

	Ожидаем.Что(Разбор).Существует();
	Ожидаем.Что(Разбор.БезСпецификации).ЭтоЛожь();
	Ожидаем.Что(Разбор.Спецификация, "спецификация из параметра, а не из имени файла").Равно("stable");

КонецПроцедуры

&Тест
Процедура ПараметрСпецификацииРаботаетИНаБезверсионномИмени() Экспорт

	Разбор = Резолвер.РазобратьЗапросФайла("winow", "winow.ospx", "^1.2");

	Ожидаем.Что(Разбор).Существует();
	Ожидаем.Что(Разбор.БезСпецификации, "спецификация названа — запрос уже не безверсионный").ЭтоЛожь();
	Ожидаем.Что(Разбор.Спецификация).Равно("^1.2");

КонецПроцедуры

&Тест
Процедура ИмяТегаИзВерсионногоСлотаБеретсяКакСпецификация() Экспорт

	Разбор = Резолвер.РазобратьЗапросФайла("winow", "winow-stable.ospx");

	Ожидаем.Что(Разбор).Существует();
	Ожидаем.Что(Разбор.БезСпецификации).ЭтоЛожь();
	Ожидаем.Что(Разбор.Спецификация).Равно("stable");

КонецПроцедуры

// Параметр не отменяет проверку принадлежности имени файла пакету: иначе адресом выдачи
// одного пакета качался бы чужой.
&Тест
Процедура ПараметрНеСпасаетЧужоеИмяФайла_Неопределено() Экспорт
	Ожидаем.Что(Резолвер.РазобратьЗапросФайла("winow", "other-1.0.0.ospx", "stable")).Равно(Неопределено);
	Ожидаем.Что(Резолвер.РазобратьЗапросФайла("winow", "winow.zip", "stable")).Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура НеОспкс_Неопределено() Экспорт
	Ожидаем.Что(Резолвер.РазобратьЗапросФайла("winow", "winow.zip")).Равно(Неопределено);
	Ожидаем.Что(Резолвер.РазобратьЗапросФайла("winow", "winow")).Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура ИмяФайлаНеСоответствуетПакету_Неопределено() Экспорт
	Ожидаем.Что(Резолвер.РазобратьЗапросФайла("winow", "other.ospx")).Равно(Неопределено);
	Ожидаем.Что(Резолвер.РазобратьЗапросФайла("winow", "other-1.0.0.ospx")).Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура ПустаяВерсияПослеДефиса_Неопределено() Экспорт
	Ожидаем.Что(Резолвер.РазобратьЗапросФайла("winow", "winow-.ospx")).Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура ПустыеАргументы_Неопределено() Экспорт
	Ожидаем.Что(Резолвер.РазобратьЗапросФайла("", "winow.ospx")).Равно(Неопределено);
	Ожидаем.Что(Резолвер.РазобратьЗапросФайла("winow", "")).Равно(Неопределено);
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции
