// Память журнала для экрана: кольца держат не больше ёмкости и отдают свежие строки первыми,
// отладка не вытесняет предупреждений, номер растёт всю жизнь процесса, темп считается за
// минуту, параллельная запись не теряет строк.

#Использовать asserts
#Использовать logos
#Использовать "фикстуры"

&ТестовыйНабор
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	Журнал = ОбъединитьПути(КаталогМодулей(), "наблюдаемость", "Классы");
	ПоискКлассов.Подключить(Журнал, "КольцоЖурнала");
	ПоискКлассов.Подключить(Журнал, "ШкалаЖурнала");
	ПоискКлассов.Подключить(Журнал, "ПамятьЖурнала");
	РеестрФикстур.Подключить("ЗаписьЖурналаПотоком");

КонецПроцедуры

#Область Кольца

&Тест
Процедура КольцоДержитНеБольшеЁмкостиИОтдаётСвежиеПервыми() Экспорт

	Память = Новый ПамятьЖурнала(3);
	Для Номер = 1 По 5 Цикл
		Записать(Память, УровниЛога.Информация, "проба", "строка " + Номер);
	КонецЦикла;

	Хвост = Память.Хвост();
	Ожидаем.Что(Хвост.Количество(), "в памяти ровно ёмкость").Равно(3);
	Ожидаем.Что(Хвост[0].Текст, "свежая первой").Равно("строка 5");
	Ожидаем.Что(Хвост[2].Текст, "старшие вытеснены").Равно("строка 3");
	Ожидаем.Что(Память.Счёт().Всего, "а записано за жизнь — все").Равно(5);

КонецПроцедуры

// Поток отладки за секунды вытесняет из общего кольца всё остальное: без второго кольца
// ошибка, ради которой открыли экран, уже не видна.
&Тест
Процедура ОтладкаНеВытесняетПредупреждений() Экспорт

	Память = Новый ПамятьЖурнала(8);
	Записать(Память, УровниЛога.Ошибка, "проба", "та самая ошибка");
	Записать(Память, УровниЛога.Предупреждение, "проба", "предупреждение");
	Для Номер = 1 По 100 Цикл
		Записать(Память, УровниЛога.Отладка, "шумный", "отладка " + Номер);
	КонецЦикла;

	Ожидаем.Что(ТекстыХвоста(Память.Хвост()), "общее кольцо залито отладкой")
		.Не_().Содержит("та самая ошибка");

	Важное = Память.Хвост(Новый Структура("ТолькоВажное", Истина));
	Ожидаем.Что(Важное.Количество(), "в кольце важного обе строки").Равно(2);
	Ожидаем.Что(Важное[0].Текст, "свежая первой").Равно("предупреждение");
	Ожидаем.Что(Важное[1].Текст, "и ошибка на месте").Равно("та самая ошибка");
	Ожидаем.Что(Память.Счёт().ЁмкостьВажного, "важному — четверть ёмкости").Равно(2);

КонецПроцедуры

&Тест
Процедура НулеваяЁмкостьНичегоНеДержит() Экспорт

	Память = Новый ПамятьЖурнала(0);
	Записать(Память, УровниЛога.Ошибка, "проба", "строка");

	Ожидаем.Что(Память.Хвост().Количество(), "всё — пусто").Равно(0);
	Ожидаем.Что(Память.Хвост(Новый Структура("ТолькоВажное", Истина)).Количество(), "важное — пусто")
		.Равно(0);
	Ожидаем.Что(Память.Счёт().Ёмкость, "ёмкость ноль").Равно(0);
	Ожидаем.Что(Память.Счёт().ЁмкостьВажного, "и у важного").Равно(0);

КонецПроцедуры

// Самая малая ёмкость: кольцу важного достаётся одна запись, а не ноль — иначе при крошечной
// памяти предупреждения не держались бы вовсе.
&Тест
Процедура ЁмкостьОдинДержитОднуЗаписьИОдноПредупреждение() Экспорт

	Память = Новый ПамятьЖурнала(1);
	Записать(Память, УровниЛога.Ошибка, "проба", "ошибка");
	Записать(Память, УровниЛога.Отладка, "проба", "отладка");

	Ожидаем.Что(Память.Счёт().ЁмкостьВажного, "важному — одна запись").Равно(1);
	Ожидаем.Что(Память.Хвост()[0].Текст, "во всём — последняя").Равно("отладка");
	Ожидаем.Что(Память.Хвост(Новый Структура("ТолькоВажное", Истина))[0].Текст, "в важном — ошибка")
		.Равно("ошибка");

КонецПроцедуры

// Память ограничена ёмкостью: сколько бы хаб ни писал, держится не больше неё.
&Тест
Процедура ПамятьНеРастётСверхЁмкости() Экспорт

	Память = Новый ПамятьЖурнала(50);
	Для Номер = 1 По 5000 Цикл
		Записать(Память, Номер % 5, "лог" + (Номер % 7), "строка " + Номер);
	КонецЦикла;

	Все = Память.Хвост(Новый Структура("Количество", 100000));
	Важные = Память.Хвост(Новый Структура("Количество, ТолькоВажное", 100000, Истина));
	Ожидаем.Что(Все.Количество(), "всё — не больше ёмкости").Равно(50);
	Ожидаем.Что(Важные.Количество(), "важное — не больше своей ёмкости").Равно(13);
	Ожидаем.Что(Память.СтрокЗаМинуту().Количество(), "темп — по одной записи на журнал").Равно(7);

КонецПроцедуры

#КонецОбласти

#Область Запись

&Тест
Процедура ЗаписьНесётНомерВремяУровеньЛогТекстИТрассу() Экспорт

	Память = Новый ПамятьЖурнала(10);
	Момент = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Память.Записать(Момент, УровниЛога.Предупреждение, "СервисПрокси", "апстрим не ответил",
		"4bf92f3577b34da6a3ce929d0e0e4736");

	Запись = Память.Хвост()[0];
	Ожидаем.Что(Запись.Номер, "номер первой строки").Равно(1);
	Ожидаем.Что(Запись.Время, "время — дата UTC до секунды").Равно(Дата(1, 1, 1) + Цел(Момент / 1000));
	Ожидаем.Что(Запись.Миллисекунды, "и миллисекунды отдельно").Равно(Момент % 1000);
	Ожидаем.Что(Запись.Уровень, "уровень словом").Равно("WARN");
	Ожидаем.Что(Запись.Лог, "лог").Равно("СервисПрокси");
	Ожидаем.Что(Запись.Текст, "текст").Равно("апстрим не ответил");
	Ожидаем.Что(Запись.Трасса, "трасса").Равно("4bf92f3577b34da6a3ce929d0e0e4736");

КонецПроцедуры

// Экран опрашивает хвост с последнего увиденного номера: номер не повторяется и после того,
// как кольцо провернулось.
&Тест
Процедура ПослеДочитываетТолькоНовое() Экспорт

	Память = Новый ПамятьЖурнала(4);
	Для Номер = 1 По 6 Цикл
		Записать(Память, УровниЛога.Информация, "проба", "строка " + Номер);
	КонецЦикла;
	Увиденный = Память.Хвост()[0].Номер;

	Записать(Память, УровниЛога.Информация, "проба", "строка 7");
	Записать(Память, УровниЛога.Информация, "проба", "строка 8");

	Новые = Память.Хвост(Новый Структура("После", Увиденный));
	Ожидаем.Что(Увиденный, "номер растёт всю жизнь процесса").Равно(6);
	Ожидаем.Что(Новые.Количество(), "дочитаны только новые").Равно(2);
	Ожидаем.Что(Новые[0].Номер, "свежая первой").Равно(8);
	Ожидаем.Что(Новые[1].Номер).Равно(7);

КонецПроцедуры

&Тест
Процедура ОтборПоЛогамУровнюПодстрокеИКоличеству() Экспорт

	Память = Новый ПамятьЖурнала(20);
	Записать(Память, УровниЛога.Отладка, "РезолверВыдачи", "кэш: промах winow");
	Записать(Память, УровниЛога.Ошибка, "РезолверВыдачи", "Сбой выдачи winow");
	Записать(Память, УровниЛога.Ошибка, "СервисПрокси", "сбой апстрима");
	Записать(Память, УровниЛога.Информация, "ГотовностьХаба", "готов");

	Логам = Новый Массив();
	Логам.Добавить("РезолверВыдачи");
	Ожидаем.Что(Память.Хвост(Новый Структура("Логи", Логам)).Количество(), "только названные логи").Равно(2);
	Ожидаем.Что(Память.Хвост(Новый Структура("УровеньНеНиже", "error")).Количество(),
		"не ниже уровня, слово без учёта регистра").Равно(2);
	Ожидаем.Что(Память.Хвост(Новый Структура("Содержит", "WINOW")).Количество(),
		"подстрока без учёта регистра").Равно(2);
	Ожидаем.Что(Память.Хвост(Новый Структура("Логи, УровеньНеНиже", Логам, "ERROR"))[0].Текст,
		"условия складываются").Равно("Сбой выдачи winow");
	Ожидаем.Что(Память.Хвост(Новый Структура("Количество", 1))[0].Текст, "не больше названного числа")
		.Равно("готов");

КонецПроцедуры

// Темп — строк за последние шестьдесят секунд: строка полутораминутной давности не считается.
&Тест
Процедура ТемпСчитаетПоследнююМинуту() Экспорт

	Память = Новый ПамятьЖурнала(10);
	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Память.Записать(Сейчас - 90000, УровниЛога.Информация, "проба", "давняя", "");
	Память.Записать(Сейчас - 30000, УровниЛога.Информация, "проба", "полминуты назад", "");
	Память.Записать(Сейчас, УровниЛога.Информация, "проба", "сейчас", "");
	Память.Записать(Сейчас, УровниЛога.Отладка, "соседний", "сейчас", "");

	Темп = Память.СтрокЗаМинуту();
	Ожидаем.Что(Темп["проба"], "давняя строка вне минуты").Равно(2);
	Ожидаем.Что(Темп["соседний"], "у каждого лога свой счёт").Равно(1);

КонецПроцедуры

// Пишут потоки запросов и фона одновременно: ни одна строка не теряется и номер не повторяется.
&Тест
Процедура ПараллельнаяЗаписьНеТеряетСтрок() Экспорт

	Память = Новый ПамятьЖурнала(5000);
	Писатели = Новый Массив();
	Задания = Новый Массив();
	Для Поток = 1 По 4 Цикл
		Писатель = Новый ЗаписьЖурналаПотоком(Память, "поток" + Поток, 500);
		Писатели.Добавить(Писатель);
		Задания.Добавить(ФоновыеЗадания.Выполнить(Писатель, "Исполнить"));
	КонецЦикла;
	Для Каждого Задание Из Задания Цикл
		Ожидаем.Что(Задание.ОжидатьЗавершения(60000), "поток дописал").ЭтоИстина();
	КонецЦикла;
	Для Каждого Писатель Из Писатели Цикл
		Ожидаем.Что(Писатель.Жалоба(), "запись без исключений").Равно("");
	КонецЦикла;

	Хвост = Память.Хвост(Новый Структура("Количество", 10000));
	Номера = Новый Соответствие();
	Для Каждого Запись Из Хвост Цикл
		Номера.Вставить(Запись.Номер, Истина);
	КонецЦикла;
	Ожидаем.Что(Память.Счёт().Всего, "записаны все строки").Равно(2000);
	Ожидаем.Что(Хвост.Количество(), "и все в памяти").Равно(2000);
	Ожидаем.Что(Номера.Количество(), "номера не повторяются").Равно(2000);
	Ожидаем.Что(Память.СтрокЗаМинуту()["поток3"], "темп каждого потока").Равно(500);

КонецПроцедуры

#КонецОбласти

#Область Обвязка

Процедура Записать(Память, Знач Уровень, Знач Лог, Знач Текст)
	Память.Записать(ТекущаяУниверсальнаяДатаВМиллисекундах(), Уровень, Лог, Текст, "");
КонецПроцедуры

Функция ТекстыХвоста(Знач Хвост)
	Тексты = Новый Массив();
	Для Каждого Запись Из Хвост Цикл
		Тексты.Добавить(Запись.Текст);
	КонецЦикла;
	Возврат СтрСоединить(Тексты, Символы.ПС);
КонецФункции

Функция КаталогМодулей()
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Возврат Новый Файл(ОбъединитьПути(КаталогТестов, "..", "src", "модули")).ПолноеИмя;
КонецФункции

#КонецОбласти
