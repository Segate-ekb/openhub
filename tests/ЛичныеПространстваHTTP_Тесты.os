// HTTP-тесты раздела «Пулы» дома «Хаб»: выключение личных пространств через серверное
// окно предупреждения с эхом, включение с раздачей пространств всем учёткам, порог
// админа хаба. Формы отправляются ровно теми полями, которые печатает сама страница.
// В конце — пространство новой учётки: появляется само, принимает публикацию владельца
// и приватным не становится.

#Использовать asserts
#Использовать 1connector
#Использовать "фикстуры"

Перем Хаб;             // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Порт;
Перем КаталогПроекта;
Перем КореньХранилища;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");

	Хаб = Новый ЭкземплярХаба(90);
	КаталогПроекта = Хаб.КаталогПроекта();

	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры");
	Сидер = ОбъединитьПути(Сидер, "ЗасеятьЛичныеПространства.os");

	// фикстура сборки .ospx: личное пространство доказывается публикацией в него
	РеестрФикстур.Подключить("ФикстураПакета");

	Хаб.ФайловаяБаза("openhub-личные-пространства");
	КореньХранилища = Хаб.КореньХранилища();
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Хаб.Среда("OSHUB_WEBHOOKS_RESOLVE__ENABLED", "false");
	// почты на стенде нет, а регистрация нужна живая: подтверждение адреса выключено
	// (одна из двух развилок инсталляции без почты, ИСТ-ПОЧТ-007)
	Хаб.Среда("OSHUB_AUTH_EMAIL_CONFIRM_ENABLED", "false");

	ЗапуститьСидер(Сидер);

	Хаб.Запустить();
	Порт = Хаб.Порт();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область ПорогАдминаХаба

// Настройка и обе её операции — только админу хаба. КОНТРОЛЬ рядом: тот же адрес,
// та же форма, отличие ровно в роли — админ получает 200.
&Тест
Процедура НеАдминНиВыключитьНиВключитьНеМожет() Экспорт

	КукаАнны = Войти("anna", "AnnaPassw0rd");
	КукаАдмина = Войти("root", "RootPassw0rd");

	Ожидаем.Что(GET_Кука(Раздел(), КукаАнны).КодСостояния,
		"обычный пользователь раздел «Пулы» не видит").Равно(403);

	// токен берём со страницы АДМИНА: иначе запрос отбился бы CSRF, и гейт роли остался бы непроверенным
	Токен = ИзвлечьCSRF(Тело(GET_Кука(Раздел(), КукаАдмина)));

	Выключение = Новый Соответствие();
	Выключение.Вставить("_csrf", Токен);
	Выключение.Вставить("операция", "личные-пространства");
	Выключение.Вставить("подтверждение", "4");
	Ожидаем.Что(POSTФорма(Раздел(), Выключение, КукаАнны).КодСостояния,
		"и снести чужие пространства не может").Равно(403);

	Включение = Новый Соответствие();
	Включение.Вставить("_csrf", Токен);
	Включение.Вставить("oshub.pools.personal_enabled", "1");
	Ожидаем.Что(POSTФорма(Раздел(), Включение, КукаАнны).КодСостояния,
		"и раздать их всем — тоже").Равно(403);

	Ожидаем.Что(ЛичныйПулЕсть("anna"), "личное пространство anna на месте").ЭтоИстина();

	// КОНТРОЛЬ: тот же адрес и та же форма от админа хаба принимаются
	Ожидаем.Что(GET_Кука(Раздел(), КукаАдмина).КодСостояния,
		"КОНТРОЛЬ: админу хаба раздел открыт").Равно(200);

КонецПроцедуры

#КонецОбласти

#Область ВыключениеЧерезОкноПредупреждения

// Сквозной путь через РАЗМЕТКУ: тест берёт форму раздела из выданного HTML и отправляет
// ровно те поля, что она печатает. Выключенный тумблер браузер отдаёт парным скрытым
// полем «0» — именно оно и приезжает. Сохранения нет: приходит окно предупреждения
// с числами, посчитанными на месте.
&Тест
Процедура ВыключениеТумблераВедётНаОкноПредупрежденияСЧислами() Экспорт

	КукаАдмина = Войти("root", "RootPassw0rd");
	Разметка = Тело(GET_Кука(Раздел(), КукаАдмина));

	Форма = ПоляФормыСо(Разметка, "name=""oshub.pools.personal_enabled""");
	Ожидаем.Что(Форма.Получить("oshub.pools.personal_enabled"),
		"форма раздела печатает выключенное значение тумблера").Равно("0");

	Вопрос = POSTФорма(Раздел(), Форма, КукаАдмина);
	Ожидаем.Что(Вопрос.КодСостояния, "выключение спрашивает, а не сохраняет").Равно(200);

	Окно = Тело(Вопрос);
	Ожидаем.Что(СтрНайти(Окно, "Выключить личные пространства") > 0,
		"показано окно предупреждения").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "Будет удалено безвозвратно") > 0,
		"и в нём числа последствий").ЭтоИстина();
	// сид: четыре личных пространства (root, anna, boris, sleeper) и одно из них с пакетом
	Ожидаем.Что(СтрНайти(Окно, "личных пространств — 4") > 0,
		"число удаляемых пространств посчитано на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "из них с пакетами — 1") > 0, "и непустые среди них").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "пакетов — 1") > 0, "и пакеты").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "версий — 2") > 0, "и версии").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "name=""подтверждение""") > 0,
		"подтверждение — поле ввода, а не галочка").ЭтоИстина();

	Ожидаем.Что(ЛичныйПулЕсть("anna"), "и ни одно пространство ещё не снесено").ЭтоИстина();
	Ожидаем.Что(НастройкаВключена(КукаАдмина), "и настройка не изменилась").ЭтоИстина();

КонецПроцедуры

// Эхо — точное число удаляемых пространств. Ошибся числом — не удалено НИЧЕГО.
&Тест
Процедура НеверноеЭхоНеУдаляетНичего() Экспорт

	КукаАдмина = Войти("root", "RootPassw0rd");
	Окно = Тело(POSTФорма(Раздел(),
		ПоляФормыСо(Тело(GET_Кука(Раздел(), КукаАдмина)), "name=""oshub.pools.personal_enabled"""),
		КукаАдмина));

	Поля = ПоляФормыСо(Окно, "name=""подтверждение""");
	Поля.Вставить("подтверждение", "1");    // не то число: пространств больше

	Ответ = POSTФорма(Раздел(), Поля, КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "неверное эхо — отказ, а не «сохранено»").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Ничего не удалено") > 0,
		"и сказано, что не удалено ничего").ЭтоИстина();

	Ожидаем.Что(ЛичныйПулЕсть("anna"), "пространство anna на месте").ЭтоИстина();
	Ожидаем.Что(ЛичныйПулЕсть("boris"), "пространство boris на месте").ЭтоИстина();
	Ожидаем.Что(НастройкаВключена(КукаАдмина), "настройка тоже не менялась").ЭтоИстина();
	Ожидаем.Что(АртефактЕсть("anna", "anna-lib", "1.0.0"), "и файл артефакта на месте").ЭтоИстина();

	// пустое подтверждение — тот же отказ: «просто нажать ещё раз» не проходит
	Пустое = ПоляФормыСо(Окно, "name=""подтверждение""");
	Пустое.Вставить("подтверждение", "");
	Ожидаем.Что(POSTФорма(Раздел(), Пустое, КукаАдмина).КодСостояния,
		"пустое подтверждение тоже отвергнуто").Равно(400);
	Ожидаем.Что(ЛичныйПулЕсть("anna"), "и снова ничего не снесено").ЭтоИстина();

КонецПроцедуры

// Верное эхо выполняет операцию: личные пространства уходят вместе с пакетами, версиями
// и файлами; обычный пул не тронут; в журнале аудита остаётся след с автором.
// Дальше набор идёт по изменённому состоянию: тесты исполняются в порядке объявления.
&Тест
Процедура ВерноеЭхоСноситПространстваИПишетВАудит() Экспорт

	КукаАдмина = Войти("root", "RootPassw0rd");
	Окно = Тело(POSTФорма(Раздел(),
		ПоляФормыСо(Тело(GET_Кука(Раздел(), КукаАдмина)), "name=""oshub.pools.personal_enabled"""),
		КукаАдмина));

	Поля = ПоляФормыСо(Окно, "name=""подтверждение""");
	Поля.Вставить("подтверждение", ЧислоИзОкна(Окно));

	Ответ = POSTФорма(Раздел(), Поля, КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "верное эхо принято").Равно(200);
	Ожидаем.Что(СтрНайти(Тело(Ответ), "Личные пространства выключены") > 0,
		"итог операции показан с числами").ЭтоИстина();

	Ожидаем.Что(ЛичныйПулЕсть("anna"), "личное пространство anna снесено").ЭтоЛожь();
	Ожидаем.Что(ЛичныйПулЕсть("boris"), "и boris тоже").ЭтоЛожь();
	Ожидаем.Что(АртефактЕсть("anna", "anna-lib", "1.0.0"),
		"файл артефакта личного пространства снят с диска").ЭтоЛожь();
	Ожидаем.Что(АртефактЕсть("anna", "anna-lib", "1.1.0"), "обе версии").ЭтоЛожь();
	Ожидаем.Что(НастройкаВключена(КукаАдмина), "настройка выключена").ЭтоЛожь();

	// обычный пул каскад не трогает — отбор идёт по типу пула
	Ожидаем.Что(GET("/shared/shared-lib").КодСостояния, "обычный пул на месте").Равно(200);
	Ожидаем.Что(АртефактЕсть("shared", "shared-lib", "1.0.0"),
		"и его артефакт тоже").ЭтоИстина();

	// Сквозной путь «мутация → файл журнала → экран»: числа операции проверяет
	// ЛичныеПространства_Тесты, здесь — что запись доехала до экрана и назвала автора.
	Журнал = Тело(GET_Кука("/hub/settings/audit", КукаАдмина));
	Ожидаем.Что(СтрНайти(Журнал, "<td>root</td><td>пространства.личные.снесены</td>") > 0,
		"снос записан в журнал аудита, автор — вошедший администратор").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Включение

// Включение подтверждения не требует, но раздаёт пространства ВСЕМ существующим учёткам
// и печатает числа. Отключённая учётка пространства не получает.
// Продолжает состояние после сноса — тесты исполняются в порядке объявления.
&Тест
Процедура ВключениеРаздаётПространстваВсемКромеОтключённой() Экспорт

	КукаАдмина = Войти("root", "RootPassw0rd");

	// состояние после сноса: настройка выключена, личных пространств нет
	Ожидаем.Что(НастройкаВключена(КукаАдмина), "исходно настройка выключена").ЭтоЛожь();
	Ожидаем.Что(ЛичныйПулЕсть("anna"), "и личных пространств нет").ЭтоЛожь();

	Поля = ПоляФормыСо(Тело(GET_Кука(Раздел(), КукаАдмина)), "name=""oshub.pools.personal_enabled""");
	Поля.Вставить("oshub.pools.personal_enabled", "1");   // именно так браузер шлёт включённый тумблер

	Ответ = POSTФорма(Раздел(), Поля, КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "включение выполняется без подтверждения").Равно(200);

	Итог = Тело(Ответ);
	Ожидаем.Что(СтрНайти(Итог, "Личные пространства включены") > 0, "итог показан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Итог, "создано — 3") > 0,
		"пространства созданы всем активным учёткам, а не только будущим").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Итог, "пропущено отключённых учёток — 1") > 0,
		"отключённая учётка пропущена").ЭтоИстина();

	Ожидаем.Что(ЛичныйПулЕсть("anna"), "у anna пространство появилось").ЭтоИстина();
	Ожидаем.Что(ЛичныйПулЕсть("boris"), "у boris тоже").ЭтоИстина();
	Ожидаем.Что(ЛичныйПулЕсть("sleeper"), "у отключённой учётки — нет").ЭтоЛожь();
	Ожидаем.Что(НастройкаВключена(КукаАдмина), "настройка включена").ЭтоИстина();

	// след раздачи в аудите — там же, в ЛичныеПространства_Тесты

КонецПроцедуры

// Повторная отправка формы включения при уже включённой настройке — не операция:
// перехода нет, значит нет и раздачи. Пулов не прибавляется, отказа тоже нет.
// (Идемпотентность самой раздачи проверяет ЛичныеПространства_Тесты на домене.)
&Тест
Процедура ПовторноеВключениеНичегоНеМеняет() Экспорт

	КукаАдмина = Войти("root", "RootPassw0rd");
	Ожидаем.Что(ЛичныйПулЕсть("anna"), "пространства уже розданы").ЭтоИстина();

	Поля = ПоляФормыСо(Тело(GET_Кука(Раздел(), КукаАдмина)), "name=""oshub.pools.personal_enabled""");
	Поля.Вставить("oshub.pools.personal_enabled", "1");

	Ответ = POSTФорма(Раздел(), Поля, КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния < 400, "повторное включение принято без отказа").ЭтоИстина();

	Ожидаем.Что(ЛичныйПулЕсть("anna"), "пространство anna на месте").ЭтоИстина();
	Ожидаем.Что(ЛичныйПулЕсть("boris"), "и boris").ЭтоИстина();
	Ожидаем.Что(ЛичныйПулЕсть("sleeper"), "отключённая учётка по-прежнему без пространства").ЭтоЛожь();
	Ожидаем.Что(НастройкаВключена(КукаАдмина), "настройка по-прежнему включена").ЭтоИстина();

	// а повторная РАЗДАЧА (снос и включение заново) дублей не плодит и не падает
	Окно = Тело(POSTФорма(Раздел(),
		ПоляФормыСо(Тело(GET_Кука(Раздел(), КукаАдмина)), "name=""oshub.pools.personal_enabled"""),
		КукаАдмина));
	Снос = ПоляФормыСо(Окно, "name=""подтверждение""");
	Снос.Вставить("подтверждение", ЧислоИзОкна(Окно));
	POSTФорма(Раздел(), Снос, КукаАдмина);

	Повтор = Тело(POSTФорма(Раздел(), Поля, КукаАдмина));
	Ожидаем.Что(СтрНайти(Повтор, "создано — 3") > 0,
		"вторая раздача заводит ровно те же три пространства").ЭтоИстина();
	Ожидаем.Что(ЛичныйПулЕсть("anna"), "и anna снова со своим пространством").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПространствоНовойУчётки

// Пространство появляется у зарегистрировавшегося САМО — без заявки и без администратора —
// называется его логином и приезжает пригодным к работе: владелец публикует в него сразу,
// и пакет ложится по адресу /{логин}/{пакет}.
&Тест
Процедура ЗарегистрировавшийсяПолучаетСвоёПространствоИСразуВНегоПубликует() Экспорт

	Логин = "newcomer";
	Ожидаем.Что(ЗавестиУчётку(Логин).КодСостояния, "учётка заведена").Равно(201);

	Ожидаем.Что(GET("/" + Логин).КодСостояния,
		"пространство появилось само и названо логином").Равно(200);

	Токен = ВыпуститьКлюч(Войти(Логин, ПарольНовичка()));
	Ожидаем.Что(ЗначениеЗаполнено(Токен), "владелец выпустил себе ключ").ЭтоИстина();

	ИмяПакета = "newcomer-lib";
	Публикация = Опубликовать(Логин, ИмяПакета, "1.0.0", Токен);
	Ожидаем.Что(Публикация.КодСостояния,
		"владелец публикует в своё пространство, ничего не выпрашивая: "
		+ Тело(Публикация)).Равно(201);

	Ожидаем.Что(GET("/" + Логин + "/" + ИмяПакета).КодСостояния,
		"и пакет лежит по адресу /{логин}/{пакет}").Равно(200);

КонецПроцедуры

// Личное пространство раздаётся каждому зарегистрировавшемуся, поэтому приватным быть
// не может — иначе хаб превращается в бесплатное закрытое хранилище чего угодно. Отказ
// называет именно эту причину, а не «нет прав», и пространство остаётся публичным.
// Основным пулом хаба оно тоже не назначается.
&Тест
Процедура ЛичноеПространствоНеЗакрытьИНеСделатьОсновнымПуломХаба() Экспорт

	Логин = "newcomer";
	Кука = Войти(Логин, ПарольНовичка());
	Раздел = "/" + Логин + "/settings/visibility";

	Поля = Новый Соответствие();
	Поля.Вставить("видимость", "private");
	Поля.Вставить("_csrf", ИзвлечьCSRF(Тело(GET_Кука(Раздел, Кука))));

	Отказ = POSTФорма(Раздел, Поля, Кука);
	Ожидаем.Что(Отказ.КодСостояния, "закрыть пространство не дают").Равно(400);
	Ожидаем.Что(СтрНайти(Тело(Отказ), "личное пространство") > 0,
		"и названа именно эта причина, а не «нет прав»: " + Лев(Тело(Отказ), 600)).ЭтоИстина();

	Ожидаем.Что(GET("/" + Логин).КодСостояния,
		"пространство осталось видно всем").Равно(200);

	Основным = POSTjsonТокеном("/api/v1/pools/" + Логин + "/default", "{}",
		ВыпуститьКлюч(Войти("root", "RootPassw0rd")));
	Ожидаем.Что(Основным.КодСостояния >= 400,
		"основным пулом хаба личное пространство не назначается: " + Тело(Основным)).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция ПарольНовичка()
	Возврат "NewcomerPassw0rd";
КонецФункции

Функция ЗавестиУчётку(Знач Логин)
	Возврат POSTjson("/api/v1/register", СтрШаблон(
		"{""логин"":""%1"",""email"":""%1@example.org"",""пароль"":""%2""}", Логин, ПарольНовичка()));
КонецФункции

Функция ВыпуститьКлюч(Знач Кука)
	Ответ = POSTjsonКукой("/api/v1/tokens", "{""права"":""read,write""}", Кука);
	Если Ответ.КодСостояния <> 201 Тогда
		Возврат "";
	КонецЕсли;
	Возврат ТелоJSON(Ответ).Получить("token_info").Получить("token");
КонецФункции

Функция Опубликовать(Знач ИмяПула, Знач ИмяПакета, Знач Версия, Знач Токен)

	Каталог = ОбъединитьПути(КаталогВременныхФайлов(),
		"сборка-" + Строка(Новый УникальныйИдентификатор()));
	СоздатьКаталог(Каталог);
	Путь = Новый ФикстураПакета().ПостроитьOspx(Каталог, ИмяПакета, Версия, "# " + ИмяПакета);

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", СтрШаблон("%1-%2.ospx", ИмяПакета, Версия));
	Заголовки.Вставить("CHANNEL", "stable");
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Запрос = Новый HTTPЗапрос("/api/v1/pools/" + ИмяПула + "/push", Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Новый ДвоичныеДанные(Путь));

	Возврат Соединение().ОтправитьДляОбработки(Запрос);

КонецФункции

Функция POSTjson(Знач Путь, Знач Тело_)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело_, КодировкаТекста.UTF8);
	Возврат Соединение().ОтправитьДляОбработки(Запрос);
КонецФункции

Функция POSTjsonКукой(Знач Путь, Знач Тело_, Знач Кука)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело_, КодировкаТекста.UTF8);
	Возврат Соединение().ОтправитьДляОбработки(Запрос);
КонецФункции

Функция POSTjsonТокеном(Знач Путь, Знач Тело_, Знач Токен)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело_, КодировкаТекста.UTF8);
	Возврат Соединение().ОтправитьДляОбработки(Запрос);
КонецФункции

Функция ТелоJSON(Знач Ответ)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция Раздел()
	Возврат "/hub/settings/pools";
КонецФункции

// Число удаляемых пространств берётся ИЗ САМОГО ОКНА: подтверждать человек будет ровно
// то, что ему показали, — вписанная в тест константа проверяла бы не эхо, а себя.
Функция ЧислоИзОкна(Знач Окно)

	Маркер = "личных пространств — ";
	Поз = СтрНайти(Окно, Маркер);
	Если Поз = 0 Тогда
		ВызватьИсключение "В окне предупреждения нет числа удаляемых пространств";
	КонецЕсли;

	Остаток = Сред(Окно, Поз + СтрДлина(Маркер));
	Цифры = "";
	Для Позиция = 1 По СтрДлина(Остаток) Цикл
		Символ = Сред(Остаток, Позиция, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		Цифры = Цифры + Символ;
	КонецЦикла;

	Возврат Цифры;

КонецФункции

Функция ЛичныйПулЕсть(Знач Логин)
	Возврат GET("/" + Логин).КодСостояния = 200;
КонецФункции

// «checked» стоит только у включённого тумблера; имя поля рядом — чужой тумблер не спутать.
Функция НастройкаВключена(Знач Кука)
	Разметка = Тело(GET_Кука(Раздел(), Кука));
	Возврат СтрНайти(Разметка, "name=""oshub.pools.personal_enabled"" value=""1"" checked") > 0;
КонецФункции

Функция АртефактЕсть(Знач ИмяПула, Знач ИмяПакета, Знач Версия)
	Путь = ОбъединитьПути(ОбъединитьПути(КореньХранилища, "pools", ИмяПула), ИмяПакета,
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия));
	Возврат Новый Файл(Путь).Существует();
КонецФункции

// Поля формы, в которой встречается Маркер, — имя и значение, как их отправит браузер.
// Разбор нарочно примитивный (input с name и value). Бросает исключение, если формы нет.
Функция ПоляФормыСо(Знач Разметка, Знач Маркер)

	Результат = Новый Соответствие();

	Позиция = СтрНайти(Разметка, Маркер);
	Если Позиция = 0 Тогда
		ВызватьИсключение "В разметке нет формы с маркером " + Маркер;
	КонецЕсли;

	Начало = 0;
	Хвост = Лев(Разметка, Позиция);
	Ищем = СтрНайти(Хвост, "<form");
	Пока Ищем > 0 Цикл
		Начало = Начало + Ищем;
		Хвост = Сред(Хвост, Ищем + 1);
		Ищем = СтрНайти(Хвост, "<form");
	КонецЦикла;
	Если Начало = 0 Тогда
		ВызватьИсключение "Маркер " + Маркер + " найден вне формы";
	КонецЕсли;

	Остаток = Сред(Разметка, Начало);
	Конец = СтрНайти(Остаток, "</form>");
	Форма = ?(Конец = 0, Остаток, Лев(Остаток, Конец));

	Для Каждого Кусок Из СтрРазделить(Форма, "<") Цикл
		Если НЕ СтрНачинаетсяС(НРег(Кусок), "input") Тогда
			Продолжить;
		КонецЕсли;
		Имя = ЗначениеАтрибута(Кусок, "name");
		Если ПустаяСтрока(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(Имя, ЗначениеАтрибута(Кусок, "value"));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗначениеАтрибута(Знач Тег, Знач Атрибут)
	Маркер = Атрибут + "=""";
	Поз = СтрНайти(Тег, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Тег, Поз + СтрДлина(Маркер));
	Конец = СтрНайти(Остаток, """");
	Возврат ?(Конец = 0, "", Лев(Остаток, Конец - 1));
КонецФункции

Процедура ЗапуститьСидер(Знач Сидер)
	П = СоздатьПроцесс(СтрШаблон("oscript ""%1""", Сидер), КаталогПроекта, Истина);
	П.Запустить();
	П.ОжидатьЗавершения();
	Если П.КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("Сидер завершился с кодом %1: %2",
			П.КодВозврата, П.ПолучитьВыводПотокаОшибок());
	КонецЕсли;
КонецПроцедуры

Функция Войти(Знач Логин, Знач Пароль)
	Тело_ = СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", Логин, Пароль);
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Запрос = Новый HTTPЗапрос("/api/v1/login", Заголовки);
	Запрос.УстановитьТелоИзСтроки(Тело_, КодировкаТекста.UTF8);
	Возврат ИзвлечьКукуСессии(Соединение().ОтправитьДляОбработки(Запрос));
КонецФункции

Функция GET(Знач Путь)
	Возврат Соединение().Получить(Новый HTTPЗапрос(Путь));
КонецФункции

Функция GET_Кука(Знач Путь, Знач Кука)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Возврат Соединение().Получить(Новый HTTPЗапрос(Путь, Заголовки));
КонецФункции

Функция POSTФорма(Знач Путь, Знач Поля, Знач Кука)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Если ЗначениеЗаполнено(Кука) Тогда
		Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	КонецЕсли;
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Запрос.УстановитьТелоИзСтроки(КодироватьФорму(Поля), КодировкаТекста.UTF8);
	Возврат Соединение().ОтправитьДляОбработки(Запрос);
КонецФункции

Функция КодироватьФорму(Знач Поля)
	Части = Новый Массив();
	Для Каждого КиЗ Из Поля Цикл
		Части.Добавить(КодироватьСтроку(Строка(КиЗ.Ключ), СпособКодированияСтроки.URLEncoding)
			+ "=" + КодироватьСтроку(Строка(КиЗ.Значение), СпособКодированияСтроки.URLEncoding));
	КонецЦикла;
	Возврат СтрСоединить(Части, "&");
КонецФункции

Функция Соединение()
	Возврат Новый HTTPСоединение("localhost", Порт, , , , 20);
КонецФункции

Функция Тело(Знач Ответ)
	Возврат Ответ.ПолучитьТелоКакСтроку();
КонецФункции

Функция ИзвлечьCSRF(Знач Тело_)
	Возврат ИзвлечьПослеМаркера(Тело_, "name=""_csrf"" value=""", """");
КонецФункции

Функция ИзвлечьПослеМаркера(Знач Тело_, Знач Маркер, Знач Терминатор)
	Поз = СтрНайти(Тело_, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Тело_, Поз + СтрДлина(Маркер));
	КонецЗнач = СтрНайти(Остаток, Терминатор);
	Возврат ?(КонецЗнач = 0, "", Лев(Остаток, КонецЗнач - 1));
КонецФункции

Функция ИзвлечьКукуСессии(Знач Ответ)
	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = "SET-COOKIE" Тогда
			Значение = ИзвлечьЗначениеКуки(Строка(КиЗ.Значение), "oshub_session");
			Если ЗначениеЗаполнено(Значение) Тогда
				Возврат Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ИзвлечьЗначениеКуки(Знач СтрокаКук, Знач ИмяКуки)
	Маркер = ИмяКуки + "=";
	Поз = СтрНайти(СтрокаКук, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(СтрокаКук, Поз + СтрДлина(Маркер));
	ТочкаЗпт = СтрНайти(Остаток, ";");
	Возврат ?(ТочкаЗпт = 0, Остаток, Лев(Остаток, ТочкаЗпт - 1));
КонецФункции

#КонецОбласти
