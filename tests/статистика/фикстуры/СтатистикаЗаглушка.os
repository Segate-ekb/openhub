// Заглушка службы статистики: считает вызовы Сбросить().

Перем СбросовВызвано_;

// Считает вызов сброса агрегатов.
//
// Параметры:
//  Момент - Дата - игнорируется (необязательный, по умолчанию Неопределено).
//
Процедура Сбросить(Знач Момент = Неопределено) Экспорт
	СбросовВызвано_ = СбросовВызвано_ + 1;
КонецПроцедуры

// Сколько раз звали Сбросить().
//
// Возвращаемое значение:
//  Число - количество вызовов.
//
Функция СбросовВызвано() Экспорт
	Возврат СбросовВызвано_;
КонецФункции

Процедура ПриСозданииОбъекта()
	СбросовВызвано_ = 0;
КонецПроцедуры
