// Задача планировщика «сброс-статистики» на ручных часах: планировщик приложения зовёт сброс
// службы статистики с интервалом из настройки.

#Использовать asserts
#Использовать "../фикстуры"

Перем Стенд;   // фикстура ПланировщикНаЧасах — планировщик приложения на ручных часах

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ЗарегистрироватьТипы() Экспорт

	РеестрФикстур.Подключить("ПланировщикНаЧасах");
	Стенд = Новый ПланировщикНаЧасах();

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогиПроекта.Модули(), "статистика", "Классы"),
		"ЗадачаСбросаСтатистики");
	РеестрФикстур.Подключить("СтатистикаЗаглушка");

КонецПроцедуры

&Тест
Процедура СбросИдётСИнтерваломИзНастройки() Экспорт

	Служба = Новый СтатистикаЗаглушка();
	Часы = Новый ЧасыРучные(Дата(2026, 1, 1, 0, 0, 0));
	Задачи = Новый Массив();
	Задачи.Добавить(Новый ЗадачаСбросаСтатистики(Служба, 60));

	Пл = Стенд.Планировщик(Задачи, Часы);
	Пл.Настроить();
	Планировщик = Пл.ЭкземплярПланировщика();

	Часы.Прибавить(59);
	Планировщик.Тик();
	Ожидаем.Что(Служба.СбросовВызвано(), "до интервала сброса нет").Равно(0);

	Часы.Прибавить(1);
	Планировщик.Тик();
	Ожидаем.Что(Служба.СбросовВызвано(), "планировщик вызвал сброс статистики").Равно(1);

КонецПроцедуры
