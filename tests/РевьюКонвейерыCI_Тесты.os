// Набор РЕВЬЮ доверенных конвейеров: сценарии, которых нет у автора — негативы массивной
// формы aud, подстрока и префикс адреса хаба, канонизация iss (регистр, слэш, порт,
// юникод-двойник), сверка конвейера, nbf/exp, кросс-пакетное использование токена.
// Ходит в ту же реальную точку маршрута КонтроллерПубликации.ПушВПул.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать ospx-tools
#Использовать autumn-logos
#Использовать pwhash
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Контроллер;
Перем Фикстура;
Перем КореньХранилища;
Перем КаталогСборки;
Перем ИсходникКонтроллераПуша;
Перем Счётчик;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Счётчик = 0;
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");

	Фикстура = ПрочитатьФикстуру(ОбъединитьПути(Фикстуры, "ci-токены-ревью.json"));

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("данные", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("хранилище", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("реестр", "Классы")));

	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтФикстура = Новый ГейтАпстримов();
	ГейтФикстура.Подключить();

	КаталогВхода = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("вход", "Классы"));
	Для Каждого Имя Из СтрРазделить("СверкаСекретов,"
		+ "СервисПрав,СервисГрупп,СервисПравДоступа,ПроверяющийGitHub,"
		+ "СервисТокенов,ГейтТокена,ГвардКлюча,НормализаторУчётки,ПолитикаПароля,"
		+ "СервисПользователей,ХранилищеСессийБД,СлужбаСессий,ПерехватчикАутентификации", ",") Цикл
		ПоискКлассов.Подключить(КаталогМодулей, Имя);
	КонецЦикла;

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("события", "Классы")));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("аудит", "Классы")));

	КаталогObs = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/телеметрия"));
	КаталогПроб = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/пробы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "СпанХаба.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "Телеметрия.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогПроб, "ГотовностьХаба.os"));

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("основа", "Классы")));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей,
		ОбъединитьПути("api", ОбъединитьПути("Классы", "РезолверФайлаПакета.os"))));

	КаталогSettings = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("настройки", "Классы"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВидыПроверок.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "НастройкиПодсистем.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "РеестрНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "СервисНастроек.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВалидаторНастроек.os"));

	КаталогPublish = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("публикация", "Классы"));
	Для Каждого Имя Из СтрРазделить("СервисВходящих,СтражИздателейCI,МаскаРефа,КороткаяФормаДоверия,ИмяЗаписиДоверия,"
		+ "ВидРефаДоверия,СрокТокенаCI,АудиторияТокенаCI,ТранспортJWKSХаба,"
		+ "КэшиКлючейCI,ПроверяющийПодписиJWKS,СервисДоверияCI,МестоВПуле,СервисПубликации,"
		+ "РассмотрениеВходящих,СервисРезервированияИмён", ",") Цикл
		ПоискКлассов.Подключить(КаталогPublish, Имя);
	КонецЦикла;

	// исход заявки заявителю уходит личным каналом; здесь проверяется домен, а не канал,
	// поэтому дверь подменена фейком — перечень поводов при этом настоящий
	ПоискКлассов.Подключить(КаталогМодулей, "ПоводыУведомлений");
	РеестрФикстур.Подключить("ФейкКаналаУведомлений");

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФейкПроверяющийGitHub.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФейкТранспортHTTPПоАдресам.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФейкТранспортHTTPСПараметрами.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФейкПадающийСтражИздателей.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФейкПроверяющийСПодменойКлеймов.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ФикстураПакета.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "КукиЗаглушка.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Фикстуры, "ОтветПушаЗаглушка.os"));

	КореньХранилища = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-ci-review-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньХранилища);
	КаталогСборки = ОбъединитьПути(КореньХранилища, "сборка");
	СоздатьКаталог(КаталогСборки);

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "ревью-конвейеры-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	НаполнитьТранспорт();
	ЗадатьАудиторию(Фикстура["аудитория"]);

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы"),
		ОбъединитьПути("журнал", "ОбезличиваниеЖурнала.os")));
	ПоискКлассов.Подключить(КаталогPublish, "КонтроллерПубликации");
	Контроллер = Новый КонтроллерПубликации(Желудь("СервисПубликации"),
		Желудь("ПерехватчикАутентификации"), Новый КукиЗаглушка(), Желудь("СервисПулов"),
		ЛогТестов(), Желудь("ЗаголовкиHTTP"));

	// сниппеты подключаются ТИПОМ после сборки: их желудь живёт в web-ui, которого в этом
	// контейнере нет, а нужен здесь сам напечатанный текст конвейера. Файл ищется ПО ИМЕНИ:
	// в каком разделе web-ui он лежит — дело раскладки, а не этой обвязки
	КлассыWebUI = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	Сниппеты = НайтиФайлы(КлассыWebUI, "СниппетыКонвейеров.os", Истина);
	Если Сниппеты.Количество() = 0 Тогда
		ВызватьИсключение "СниппетыКонвейеров не найдены в " + КлассыWebUI;
	КонецЕсли;
	ПоискКлассов.ПодключитьФайл(Сниппеты[0].ПолноеИмя);
	ИсходникКонтроллераПуша = ПрочитатьТекст(
		ПоискКлассов.ФайлКласса(КаталогPublish, "КонтроллерПубликации"));

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	Попытка
		Если ЗначениеЗаполнено(КореньХранилища) И Новый Файл(КореньХранилища).Существует() Тогда
			УдалитьФайлы(КореньХранилища);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

#Область Аудитория

// Массивная форма aud БЕЗ нашего адреса: у автора покрыт только положительный случай.
&Тест
Процедура AudМассивомБезНашегоАдресаНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("raudarr");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("aud_массив_чужой"));
	Ожидаем.Что(Атака.Код, "массив без нашего адреса → 403").Равно(403);
	Ожидаем.Что(Атака.ТелоТекст, "причина названа").Содержит("другого сервиса");

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("aud_массив_регистр"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: массив с нашим адресом публикует: "
		+ Контроль.ТелоТекст).Равно(201);

КонецПроцедуры

// aud не должен совпадать ни по префиксу, ни по подстроке, ни с добавленным путём.
&Тест
Процедура AudПоЧастичномуСовпадениюНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("raudpart");
	Отказы = Новый Массив();

	Для Каждого Имя Из СтрРазделить("aud_наш_как_префикс,aud_наш_с_путём,aud_подстрока,aud_пустой", ",") Цикл
		Ответ = ПушТокеном(Стенд, "1.1.0", Токен(Имя));
		Если Ответ.Код = 403 Тогда
			Отказы.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Отказы.Количество(), "все четыре частичные формы aud отбиты: "
		+ СтрСоединить(Отказы, ", ")).Равно(4);

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: точный aud публикует").Равно(201);

КонецПроцедуры

// Регистр и хвостовой слэш адреса инстанса совпадению мешать не должны.
&Тест
Процедура AudДругогоРегистраИСоСлэшемПубликует() Экспорт

	Стенд = ЗавестиСтенд("raudcase");

	Ответ = ПушТокеном(Стенд, "1.1.0", Токен("aud_регистр_и_слэш"));
	Ожидаем.Что(Ответ.Код, "регистр и хвостовой слэш: " + Ответ.ТелоТекст).Равно(201);

КонецПроцедуры

#КонецОбласти

#Область КанонизацияИздателя

// Издатель другим регистром и с хвостовым слэшем — тот же издатель.
&Тест
Процедура ИздательДругогоРегистраПубликует() Экспорт

	Стенд = ЗавестиСтенд("risscase");

	Ответ = ПушТокеном(Стенд, "1.1.0", Токен("iss_регистр_и_слэш"));
	Ожидаем.Что(Ответ.Код, "iss в верхнем регистре со слэшем: " + Ответ.ТелоТекст).Равно(201);

КонецПроцедуры

// Юникод-двойник хоста и добавленный порт списка издателей не проходят.
&Тест
Процедура ПодделкаХостаИздателяНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("rissfake");
	Отказы = Новый Массив();

	Для Каждого Имя Из СтрРазделить("iss_юникод_двойник,iss_с_портом", ",") Цикл
		Ответ = ПушТокеном(Стенд, "1.1.0", Токен(Имя));
		Если Ответ.Код = 403 Тогда
			Отказы.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Отказы.Количество(), "юникод-двойник и порт отбиты: "
		+ СтрСоединить(Отказы, ", ")).Равно(2);

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: канонический издатель публикует").Равно(201);

КонецПроцедуры

#КонецОбласти

#Область Конвейер

// Поле «конвейер» записи доверия обязано работать: чужой workflow того же репозитория
// и той же ветки публиковать не вправе.
&Тест
Процедура ЧужойКонвейерНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("rwf");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("чужой_конвейер"));
	Ожидаем.Что(Атака.Код, "чужой workflow → 403").Равно(403);

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: доверенный workflow публикует").Равно(201);

КонецПроцедуры

// Клеймо конвейера отсутствует вовсе — заполненное поле записи закрыто (default-closed).
&Тест
Процедура ОтсутствиеКлеймаКонвейераНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("rwfnone");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("конвейера_нет"));
	Ожидаем.Что(Атака.Код, "нет клейма конвейера → 403").Равно(403);

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: клеймо на месте — публикует: "
		+ Контроль.ТелоТекст).Равно(201);

КонецПроцедуры

// Сверяется ВЕРХНЕУРОВНЕВЫЙ workflow своего репозитория: при вызове reusable клейм
// «где определён job» указывает на чужой репозиторий и сверке не мешает.
&Тест
Процедура ReusableИзЧужогоРепозиторияПубликует() Экспорт

	Стенд = ЗавестиСтенд("rreuse");

	Ожидаем.Что(ПушТокеном(Стенд, "1.1.0", Токен("reusable")).Код,
		"workflow своего репозитория публикует, вызвав чужой reusable").Равно(201);

КонецПроцедуры

#КонецОбласти

#Область Репозиторий

// Отсутствие клейма репозитория — отказ; фолбэк на project_path работает.
&Тест
Процедура ОтсутствиеРепозиторияНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("rrepo");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("репозитория_нет"));
	Ожидаем.Что(Атака.Код, "нет клейма репозитория → 403").Равно(403);

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("репозиторий_через_project_path"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: project_path публикует: "
		+ Контроль.ТелоТекст).Равно(201);

КонецПроцедуры

#КонецОбласти

#Область Срок

// nbf в будущем и exp вовсе — отказ.
&Тест
Процедура НеживойСрокНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("rexp");
	Отказы = Новый Массив();

	Для Каждого Имя Из СтрРазделить("nbf_в_будущем,без_exp,exp_строкой", ",") Цикл
		Ответ = ПушТокеном(Стенд, "1.1.0", Токен(Имя));
		Если Ответ.Код = 403 Тогда
			Отказы.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Отказы.Количество(), "все три формы неживого срока отбиты: "
		+ СтрСоединить(Отказы, ", ")).Равно(3);

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: живой срок публикует").Равно(201);

КонецПроцедуры

#КонецОбласти

#Область ПодменаАлгоритма

// HS256, где секретом взят модуль открытого ключа: белый список алгоритмов обязан отбить.
&Тест
Процедура HS256НаМодулеКлючаНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("rhs");

	Атака = ПушТокеном(Стенд, "1.1.0", Токен("alg_hs256"));
	Ожидаем.Что(Атака.Код, "HS256 на модуле открытого ключа → 403").Равно(403);

	Контроль = ПушТокеном(Стенд, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: RS256 публикует").Равно(201);

КонецПроцедуры

#КонецОбласти

#Область КроссПакет

// Годный токен доверенного конвейера пакета А не публикует пакет Б, у которого
// доверие настроено на ДРУГОЙ репозиторий. Отличие от контроля — только пакет.
&Тест
Процедура ТокенЧужогоПакетаНеПубликует() Экспорт

	Свой = ЗавестиСтенд("rcrossa");
	Чужой = ЗавестиСтендНаРепозиторий("rcrossb", "evil/other");

	Атака = ПушТокеном(Чужой, "1.1.0", Токен("годный"));
	Ожидаем.Что(Атака.Код, "токен пакета А в пакет Б → 403").Равно(403);
	Ожидаем.Что(ВерсияЕсть(Чужой, "1.1.0"), "версии в чужом пакете нет").ЭтоЛожь();

	Контроль = ПушТокеном(Свой, "1.1.0", Токен("годный"));
	Ожидаем.Что(Контроль.Код, "КОНТРОЛЬ: свой пакет публикуется").Равно(201);

КонецПроцедуры

// Пакет без единой записи доверия годный токен не публикует.
&Тест
Процедура ПакетБезДоверияНеПубликуетГоднымТокеном() Экспорт

	Голый = ЗавестиСтендБезДоверия("rnotrust");

	Атака = ПушТокеном(Голый, "1.1.0", Токен("годный"));
	Ожидаем.Что(Атака.Код, "пакет без доверия → 403").Равно(403);
	Ожидаем.Что(Атака.ТелоТекст, "причина названа").Содержит("не настроено");

КонецПроцедуры

#КонецОбласти

#Область Транспорт

// Отказ должен быть на ЛЮБОМ 3xx, а не только на 302.
&Тест
Процедура ТранспортОтказываетНаЛюбом3xx() Экспорт

	Клиент = Новый ФейкТранспортHTTPПоАдресам();
	Транспорт = Новый ТранспортJWKSХаба(Клиент, Желудь("СтражИздателейCI"), ЛогТестов());
	Отбиты = Новый Массив();

	Для Каждого КодСтрока Из СтрРазделить("300,301,302,303,307,308,399", ",") Цикл
		Код = Число(КодСтрока);
		Клиент.ПриАдресе("https://gitlab.com/keys", Код, "{""keys"":[]}");
		Если СтрНайти(ОшибкаЗапроса(Транспорт, "https://gitlab.com/keys"), "перенаправлением") > 0 Тогда
			Отбиты.Добавить(КодСтрока);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Отбиты.Количество(), "все семь кодов 3xx отбиты: "
		+ СтрСоединить(Отбиты, ", ")).Равно(7);

	Клиент.ПриАдресе("https://gitlab.com/keys", 200, "{""keys"":[]}");
	Ожидаем.Что(Транспорт.Получить("https://gitlab.com/keys").Код,
		"КОНТРОЛЬ: 200 читается").Равно(200);

КонецПроцедуры

// Транспорт судит адрес САМ и не полагается на то, что его позвали с проверенным.
&Тест
Процедура ТранспортОтбиваетПриватныеФормыАдреса() Экспорт

	Клиент = Новый ФейкТранспортHTTPПоАдресам();
	Транспорт = Новый ТранспортJWKSХаба(Клиент, Желудь("СтражИздателейCI"), ЛогТестов());
	Отбиты = Новый Массив();

	Адреса = "https://127.0.0.1/keys,https://10.1.2.3/keys,https://192.168.0.1/keys,"
		+ "https://172.16.0.1/keys,https://localhost/keys,https://[::1]/keys,"
		+ "https://2130706433/keys,https://0x7f000001/keys,https://[::ffff:127.0.0.1]/keys";
	Для Каждого Адрес Из СтрРазделить(Адреса, ",") Цикл
		Клиент.ПриАдресе(Адрес, 200, "{""keys"":[]}");
		Если СтрНайти(ОшибкаЗапроса(Транспорт, Адрес), "недопустим") > 0 Тогда
			Отбиты.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Отбиты.Количество(), "все девять приватных форм отбиты: "
		+ СтрСоединить(Отбиты, ", ")).Равно(9);
	Ожидаем.Что(Клиент.ВсегоЗапросов(), "до сети ни один не дошёл").Равно(0);

	Клиент.ПриАдресе("https://gitlab.com/keys", 200, "{""keys"":[]}");
	Ожидаем.Что(Транспорт.Получить("https://gitlab.com/keys").Код,
		"КОНТРОЛЬ: публичный адрес читается").Равно(200);

КонецПроцедуры

#КонецОбласти

#Область FailClosed

// Проверяющий, собранный без стража и без кэшей, обязан отказывать и называть причину.
&Тест
Процедура ПроверяющийБезЗависимостейОтказывает() Экспорт

	Голый = Новый ПроверяющийПодписиJWKS(Неопределено, Неопределено, ЛогТестов());

	Проверка = Голый.ПроверитьТокен(Токен("годный"), Фикстура["издатель"]);
	Ожидаем.Что(Проверка.Причина, "причина названа").Содержит("не собрана");
	Ожидаем.Что(Проверка.Достоверна, "без зависимостей подпись недостоверна").ЭтоЛожь();

	Ожидаем.Что(Желудь("ПроверяющийПодписиCI").ПроверитьТокен(
			Токен("годный"), Фикстура["издатель"]).Достоверна,
		"КОНТРОЛЬ: собранный проверяющий тот же токен принимает").ЭтоИстина();

КонецПроцедуры

// Исключение внутри проверки — это отказ, а не «продолжаем». Отличие от контроля ровно
// одно: страж, который падает вместо вердикта.
&Тест
Процедура ИсключениеВнутриПроверкиЗапираетПуть() Экспорт

	Падающий = Новый ПроверяющийПодписиJWKS(Новый ФейкПадающийСтражИздателей(),
		Желудь("КэшиКлючейCI"), ЛогТестов());

	Проверка = Падающий.ПроверитьТокен(Токен("годный"), Фикстура["издатель"]);
	Ожидаем.Что(СтрНайти(Проверка.Причина, "не собрана"),
		"зависимости на месте — значит отказ не по «не собрано»").Равно(0);
	Ожидаем.Что(Проверка.Достоверна,
		"исключение внутри проверки → подпись недостоверна").ЭтоЛожь();
	Ожидаем.Что(Проверка.Клеймы = Неопределено, "клеймов при отказе нет").ЭтоИстина();

	Ожидаем.Что(Желудь("ПроверяющийПодписиCI").ПроверитьТокен(
			Токен("годный"), Фикстура["издатель"]).Достоверна,
		"КОНТРОЛЬ: с рабочим стражем тот же токен достоверен").ЭтоИстина();

КонецПроцедуры

// Страж без валидатора адресов не выдаёт разрешений: непроверенный адрес не опрашивается.
&Тест
Процедура СтражБезВалидатораНеРазрешаетАдрес() Экспорт

	Голый = Новый СтражИздателейCI(Неопределено, Неопределено, Неопределено, ЛогТестов());

	Ожидаем.Что(Голый.ДопустимАдрес("https://gitlab.com/keys").Ок,
		"без валидатора адрес не разрешён").ЭтоЛожь();
	Ожидаем.Что(Голый.ДопустимИздатель("https://gitlab.com").Ок,
		"встроенный издатель без валидатора тоже не разрешён").ЭтоЛожь();

	Ожидаем.Что(Желудь("СтражИздателейCI").ДопустимАдрес("https://gitlab.com/keys").Ок,
		"КОНТРОЛЬ: собранный страж тот же адрес разрешает").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПроверенныеКлеймы

// Решение принимается по клеймам, ВЕРНУВШИМСЯ С ПОДПИСЬЮ, а не по нагрузке предъявленного
// токена. Проверяющий-подменщик разводит два источника: пара случаев ниже даёт
// противоположные ответы в зависимости от того, какой из них читает домен.
&Тест
Процедура РешениеПринимаетсяПоПровереннымКлеймам() Экспорт

	Стенд = ЗавестиСтенд("rverif");
	Подменщик = Новый ФейкПроверяющийСПодменойКлеймов();
	Доверие_ = ДовериеСПроверяющим(Подменщик);

	// нагрузка токена подходит записи, а ПРОВЕРЕННЫЕ клеймы называют чужой репозиторий
	Подменщик.ОтдаватьКлеймы(Клеймы("evil/fork", Фикстура["конвейер"], Фикстура["реф"]));
	Ожидаем.Что(Доверие_.РазрешаетПубликацию(Стенд.Пакет, Токен("годный")).Разрешено,
		"проверенные клеймы называют чужой репозиторий — отказ, даже если нагрузка подходит")
		.ЭтоЛожь();

	// зеркальный случай: нагрузка записи НЕ подходит, а проверенные клеймы подходят
	Подменщик.ОтдаватьКлеймы(Клеймы(Фикстура["репозиторий"], Фикстура["конвейер"], Фикстура["реф"]));
	Ожидаем.Что(Доверие_.РазрешаетПубликацию(
			Стенд.Пакет, Токен("репозитория_нет")).Разрешено,
		"КОНТРОЛЬ: решают проверенные клеймы, и они подходят").ЭтоИстина();

КонецПроцедуры

// РЕГИСТР рефа решает, кто публикует. Пакет доверяет ветке «main», она защищена; ветку
// «Main» заводит кто угодно, и GitHub выдаёт ей id-token того же репозитория. Совпадение
// по регистру означало бы, что защита ветки обходится одной заглавной буквой.
&Тест
Процедура РефДругогоРегистраНеПубликует() Экспорт

	Стенд = ЗавестиСтенд("rcase");
	Подменщик = Новый ФейкПроверяющийСПодменойКлеймов();
	Доверие_ = ДовериеСПроверяющим(Подменщик);
	Отказы = Новый Массив();

	Для Каждого Написание Из СтрРазделить("refs/heads/MAIN,refs/heads/Main,REFS/HEADS/MAIN", ",") Цикл
		Подменщик.ОтдаватьКлеймы(Клеймы(Фикстура["репозиторий"], Фикстура["конвейер"], Написание));
		Если НЕ Доверие_.РазрешаетПубликацию(Стенд.Пакет, Токен("годный")).Разрешено Тогда
			Отказы.Добавить(Написание);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Отказы.Количество(), "все три написания отбиты: "
		+ СтрСоединить(Отказы, ", ")).Равно(3);

	Подменщик.ОтдаватьКлеймы(Клеймы(Фикстура["репозиторий"], Фикстура["конвейер"], Фикстура["реф"]));
	Ожидаем.Что(Доверие_.РазрешаетПубликацию(Стенд.Пакет, Токен("годный")).Разрешено,
		"КОНТРОЛЬ: реф своего регистра публикует").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СогласованностьСНапечатаннымКонвейером

// СЕТЬ, КОТОРОЙ НЕ БЫЛО. Хаб ПЕЧАТАЕТ конвейер и ПРИНИМАЕТ клеймы его запусков — две
// стороны одного правила, и жили они порознь: снипет запускался по тегам, а форма
// заполнялась ветками, и мейнтейнер, сделавший ровно то, что сказал хаб, получал отказ
// «клеймы не совпали ни с одним доверенным конвейером».
// Тест берёт НАПЕЧАТАННЫЙ текст конвейера, читает из него реф, аудиторию и адрес, заводит
// доверие ровно этими значениями и предъявляет клеймы такого запуска настоящей сверке.
&Тест
Процедура ЗаписьПоНапечатанномуКонвейеруПринимаетЕгоКлеймы() Экспорт

	Стенд = ЗавестиСтендБезДоверия("rsnip");
	Аудитория = Доверие().ОжидаемаяАудитория();
	Текст = Новый СниппетыКонвейеров(Неопределено, Желудь("ВидРефаДоверия")).GitHubActions(
		"https://hub.example.org", Стенд.Пул.Имя, Стенд.ИмяПакета, Аудитория);

	Запуск = ЗапускКонвейера(Текст);
	Ожидаем.Что(Запуск.Вид, "напечатанный конвейер запускается по тегам").Равно("тег");
	Ожидаем.Что(ЗначениеYAML(Текст, "audience: "),
		"аудитория напечатана та же, что сверяет хаб").Равно(Аудитория);
	Ожидаем.Что(ЗначениеYAML(Текст, "hub: "), "адрес хаба напечатан").Равно("https://hub.example.org");
	// адрес публикации из снипета обязан быть НАСТОЯЩИМ маршрутом: опечатка в нём даёт 404
	// вместо публикации, и виноватым выглядит доверие
	Ожидаем.Что(ИсходникКонтроллераПуша, "путь push из снипета — маршрут контроллера")
		.Содержит(СтрШаблон("&ТочкаМаршрута(""%1"")", МаршрутПуша(Текст)));

	// доверие заводится ПО ПОДСКАЗКАМ ХАБА: маска запуска и вид рефа этого запуска
	Заведение = Доверие().Доверить(СессияПринципал(Стенд.Мейнтейнер), Стенд.Пакет, "github",
		Фикстура["издатель"], Фикстура["репозиторий"], "publish.yml", Запуск.Маска, Запуск.Вид);
	Ожидаем.Что(Заведение.Успех, "запись заведена: " + Заведение.Сообщение).ЭтоИстина();

	Подменщик = Новый ФейкПроверяющийСПодменойКлеймов();
	Доверие_ = ДовериеСПроверяющим(Подменщик);
	Конвейер = Желудь("КороткаяФормаДоверия").Конвейер("github", Фикстура["издатель"],
		Фикстура["репозиторий"], "publish.yml");

	// запуск по тегу релиза — ровно то, чем конвейер запускается; имя тега выведено
	// из САМОЙ напечатанной маски, а не вписано в тест
	Имя = СтрЗаменить(Запуск.Маска, "*", "1.2.3");
	Подменщик.ОтдаватьКлеймы(КлеймыЗапуска(Конвейер, "refs/tags/" + Имя,
		ЗначениеYAML(Текст, "audience: ")));
	Ожидаем.Что(Доверие_.РазрешаетПубликацию(Стенд.Пакет, Токен("годный")).Разрешено,
		"клеймы запуска напечатанного конвейера приняты").ЭтоИстина();

	// та же маска, прочитанная веткой, не совпала бы никогда — это и был разлад
	Подменщик.ОтдаватьКлеймы(КлеймыЗапуска(Конвейер, "refs/heads/" + Имя,
		ЗначениеYAML(Текст, "audience: ")));
	Ожидаем.Что(Доверие_.РазрешаетПубликацию(Стенд.Пакет, Токен("годный")).Разрешено,
		"ветка того же имени под запись не подходит").ЭтоЛожь();

	// посторонний тег конвейер не запускает, и доверие ему не выдано
	Подменщик.ОтдаватьКлеймы(КлеймыЗапуска(Конвейер, "refs/tags/test",
		ЗначениеYAML(Текст, "audience: ")));
	Ожидаем.Что(Доверие_.РазрешаетПубликацию(Стенд.Пакет, Токен("годный")).Разрешено,
		"посторонний тег не публикует").ЭтоЛожь();

КонецПроцедуры

// Отказ называет ДОСТИЖИМЫЙ путь. Проверяем не формулировку, а исполнение: конвейер
// пушит НОВОЕ имя в тот же пул сквозь настоящий маршрут — очередь заявок его не принимает
// (она требует аутентифицированного человека, и до неё при ненулевом вердикте конвейера
// исполнение не доходит), значит совет «заявка во входящие» был советом в никуда.
&Тест
Процедура НовоеИмяКонвейеромНеЗаводитсяИОтказНазываетДостижимыйПуть() Экспорт

	Стенд = ЗавестиСтенд("rnewname");
	НовоеИмя = УникальноеИмя("rbrandnew");

	Ответ = ПушИменем(Стенд.Пул, НовоеИмя, "1.0.0", Токен("годный"));

	// 202 означал бы принятую заявку во «входящие» — её конвейеру не дают
	Ожидаем.Что(Ответ.Код, "новое имя доверенным конвейером не заводится → 403: "
		+ Ответ.ТелоТекст).Равно(403);
	Ожидаем.Что(Желудь("СервисПакетов").НайтиПакет(Стенд.Пул.Идентификатор, НовоеИмя) = Неопределено,
		"пакета с новым именем не появилось").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "входящ"),
		"недостижимый путь в отказе не предлагается: " + Ответ.ТелоТекст).Равно(0);
	Ожидаем.Что(Ответ.ТелоТекст, "назван путь, который человеку доступен")
		.Содержит("ключом доступа");
	Ожидаем.Что(Ответ.ТелоТекст, "и резервирование имени").Содержит("резервирован");

	// КОНТРОЛЬ: тот же токен в СУЩЕСТВУЮЩИЙ пакет с доверием публикует — отличие ровно
	// в том, заведено имя или нет
	Ожидаем.Что(ПушТокеном(Стенд, "1.1.0", Токен("годный")).Код,
		"КОНТРОЛЬ: существующее имя публикуется").Равно(201);

КонецПроцедуры

#КонецОбласти

#Область ИсточникиКлючей

// Ключи берутся у ТОГО издателя, чей iss в токене. Токен подписан ключом, который лежит
// только в JWKS GitLab: источник ключей GitHub его знать не должен.
&Тест
Процедура КлючиЧужогоИздателяНеПринимаются() Экспорт

	Проверяющий = Желудь("ПроверяющийПодписиCI");

	Ожидаем.Что(Проверяющий.ПроверитьТокен(
			Токен("ключ_гитлаба_издатель_гитхаб"), Фикстура["издатель"]).Достоверна,
		"ключ есть только в JWKS GitLab — у издателя GitHub его нет").ЭтоЛожь();

	Ожидаем.Что(Проверяющий.ПроверитьТокен(
			Токен("ключ_гитлаба_издатель_гитлаб"), Фикстура["издатель_гитлаб"]).Достоверна,
		"КОНТРОЛЬ: тот же ключ у своего издателя достоверен").ЭтоИстина();

КонецПроцедуры

// Ключи, которыми решается право на публикацию, читаются по ПРОВЕРЕННОМУ TLS
// и без хождения по Location.
&Тест
Процедура КлючиЧитаютсяПоПроверенномуTLS() Экспорт

	Клиент = Новый ФейкТранспортHTTPСПараметрами();
	Клиент.ПриАдресе("https://gitlab.com/keys", 200, "{""keys"":[]}");
	Транспорт = Новый ТранспортJWKSХаба(Клиент, Желудь("СтражИздателейCI"), ЛогТестов());

	Транспорт.Получить("https://gitlab.com/keys");

	Ожидаем.Что(Клиент.ПроверялСертификат(),
		"сертификат JWKS проверяется: без этого MITM подсовывает свои ключи").ЭтоИстина();
	Ожидаем.Что(Клиент.РазрешалПеренаправление(),
		"по Location транспорт ходить не просит").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область Служебное

// СервисДоверияCI с подменённым проверяющим подписи; прочие зависимости — из контейнера.
Функция ДовериеСПроверяющим(Знач Проверяющий)
	Возврат Новый СервисДоверияCI(Желудь("ХранилищеДоверияCI"),
		Желудь("ХранилищеПользователей"), Желудь("ИмяОбъектаАудита"), Желудь("СервисПакетов"),
		Желудь("СервисПрав"), Проверяющий, Желудь("ГвардКлюча"), Желудь("ИздательСобытий"),
		Желудь("АудиторияТокенаCI"), Желудь("СтражИздателейCI"), Желудь("КороткаяФормаДоверия"),
		Желудь("ИмяЗаписиДоверия"), Желудь("МаскаРефа"), Желудь("ВидРефаДоверия"),
		Желудь("СрокТокенаCI"), ЛогТестов());
КонецФункции

// Чем запускается напечатанный конвейер: вид рефа и маска читаются из САМОГО YAML.
Функция ЗапускКонвейера(Знач Текст)

	Если СтрНайти(Текст, "tags: [") > 0 Тогда
		Возврат Новый Структура("Вид, Маска", "тег", МеждуМаркерами(Текст, "tags: ['", "']"));
	КонецЕсли;
	Возврат Новый Структура("Вид, Маска", "ветка",
		МеждуМаркерами(Текст, "branches: ['", "']"));

КонецФункции

// Значение простого ключа YAML: «      audience: openhub» → «openhub».
Функция ЗначениеYAML(Знач Текст, Знач Ключ)

	Позиция = СтрНайти(Текст, Ключ);
	Ожидаем.Что(Позиция > 0, "в конвейере есть ключ " + Ключ).ЭтоИстина();
	Хвост = Сред(Текст, Позиция + СтрДлина(Ключ));
	Конец = СтрНайти(Хвост, Символы.ПС);
	Возврат СокрЛП(?(Конец = 0, Хвост, Лев(Хвост, Конец - 1)));

КонецФункции

// Маршрут публикации, напечатанный в снипете, в форме объявления контроллера:
// «"$hub/api/v1/pools/$pool/push"» → «api/v1/pools/{Пул}/push».
Функция МаршрутПуша(Знач Текст)

	Путь = МеждуМаркерами(Текст, "POST ""$hub/", """");
	Ожидаем.Что(ЗначениеЗаполнено(Путь), "в конвейере напечатан адрес публикации").ЭтоИстина();
	Возврат СтрЗаменить(Путь, "$pool", "{Пул}");

КонецФункции

Функция МеждуМаркерами(Знач Текст, Знач Начало, Знач Конец)

	Позиция = СтрНайти(Текст, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Текст, Позиция + СтрДлина(Начало));
	Край = СтрНайти(Хвост, Конец);
	Возврат ?(Край = 0, "", Лев(Хвост, Край - 1));

КонецФункции

Функция ПрочитатьТекст(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Текст;

КонецФункции

// Клеймы запуска конвейера: репозиторий и издатель фикстуры, остальное — от вызывающего.
Функция КлеймыЗапуска(Знач Конвейер, Знач Реф, Знач Аудитория)

	Результат = Клеймы(Фикстура["репозиторий"], Конвейер, Реф);
	Результат.Вставить("aud", Аудитория);
	Возврат Результат;

КонецФункции

// Полный набор клеймов доверенного конвейера с подставляемыми репозиторием, конвейером и рефом.
Функция Клеймы(Знач Репозиторий, Знач Конвейер, Знач Реф)
	Результат = Новый Соответствие();
	Результат.Вставить("iss", Фикстура["издатель"]);
	Результат.Вставить("aud", Фикстура["аудитория"]);
	Результат.Вставить("exp", 4102444800);
	Результат.Вставить("nbf", 1704067200);
	Результат.Вставить("repository", Репозиторий);
	Результат.Вставить("workflow_ref", Конвейер);
	Результат.Вставить("ref", Реф);
	Возврат Результат;
КонецФункции

Функция ЗавестиСтенд(Знач Префикс)
	Возврат ЗавестиСтендНаРепозиторий(Префикс, Фикстура["репозиторий"]);
КонецФункции

Функция ЗавестиСтендНаРепозиторий(Знач Префикс, Знач Репозиторий)

	Стенд = ЗавестиСтендБезДоверия(Префикс);

	Доверие_ = Доверие().Доверить(СессияПринципал(Стенд.Мейнтейнер), Стенд.Пакет, "github",
		Фикстура["издатель"], Репозиторий, Фикстура["конвейер"], Фикстура["реф"]);
	Если НЕ Доверие_.Успех Тогда
		ВызватьИсключение "Доверие не настроено: " + Доверие_.Сообщение;
	КонецЕсли;

	Возврат Стенд;

КонецФункции

Функция ЗавестиСтендБезДоверия(Знач Префикс)

	Пул = Желудь("СервисПулов").СоздатьПул(УникальноеИмя(Префикс + "pool"), "custom", "public");
	Мейнтейнер = СоздатьМейнтейнера(Пул);
	ИмяПакета = УникальноеИмя(Префикс);

	Заведение = Опубликовать(Пул, Мейнтейнер, ИмяПакета, "1.0.0");
	Если НЕ Заведение.Успех Тогда
		ВызватьИсключение "Имя не заведено: " + Заведение.Сообщение;
	КонецЕсли;
	Пакет = Желудь("СервисПакетов").НайтиПакет(Пул.Идентификатор, ИмяПакета);

	Возврат Новый Структура("Пул, Мейнтейнер, Пакет, ИмяПакета",
		Пул, Мейнтейнер, Пакет, ИмяПакета);

КонецФункции

// Пуш ПРОИЗВОЛЬНЫМ именем пакета в пул — тем же маршрутом, что и обычный.
Функция ПушИменем(Знач Пул, Знач ИмяПакета, Знач Версия, Знач Токен_)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", СтрШаблон("%1-%2.ospx", ИмяПакета, Версия));
	Заголовки.Вставить("CHANNEL", "stable");
	Заголовки.Вставить("OAUTH-TOKEN", Токен_);

	Ответ = Новый ОтветПушаЗаглушка();
	Контроллер.ПушВПул(Ответ, Пул.Имя, "POST", Заголовки, ПостроитьOspxДанные(ИмяПакета, Версия));
	Возврат Ответ;

КонецФункции

Функция ПушТокеном(Знач Стенд, Знач Версия, Знач Токен_)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", СтрШаблон("%1-%2.ospx", Стенд.ИмяПакета, Версия));
	Заголовки.Вставить("CHANNEL", "stable");
	Заголовки.Вставить("OAUTH-TOKEN", Токен_);

	Ответ = Новый ОтветПушаЗаглушка();
	Контроллер.ПушВПул(Ответ, Стенд.Пул.Имя, "POST", Заголовки,
		ПостроитьOspxДанные(Стенд.ИмяПакета, Версия));
	Возврат Ответ;

КонецФункции

Функция ВерсияЕсть(Знач Стенд, Знач Версия)
	Возврат Желудь("СервисВерсий").НайтиВерсию(Стенд.Пакет.Идентификатор, Версия) <> Неопределено;
КонецФункции

Функция Токен(Знач Имя)
	Возврат Фикстура["токены"][Имя];
КонецФункции

Функция ОшибкаЗапроса(Знач Транспорт, Знач URL)
	Попытка
		Транспорт.Получить(URL);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";
КонецФункции

Процедура ЗадатьАудиторию(Знач Значение)
	Желудь("СервисНастроек").Установить("oshub.publish.ci.audience", Значение, "ревью");
КонецПроцедуры

Процедура НаполнитьТранспорт()
	Транспорт = Желудь("ТранспортHTTP");
	Транспорт.ПриАдресе(Фикстура["адрес_дискавери"], 200, Фикстура["дискавери"]);
	Транспорт.ПриАдресе(Фикстура["адрес_ключей"], 200, Фикстура["жвк"]);
	// GitLab отдаёт ДРУГОЙ ключ под другим kid: иначе смешение источников ключей
	// неотличимо от правильной работы
	ОтдаватьКлючи(Транспорт, Фикстура["издатель_гитлаб"], Фикстура["жвк_гитлаб"]);
КонецПроцедуры

Процедура ОтдаватьКлючи(Знач Транспорт, Знач Издатель, Знач ДокументКлючей)
	Транспорт.ПриАдресе(Издатель + "/.well-known/openid-configuration", 200, СтрШаблон(
		"{""issuer"":""%1"",""jwks_uri"":""%1/.well-known/jwks""}", Издатель));
	Транспорт.ПриАдресе(Издатель + "/.well-known/jwks", 200, ДокументКлючей);
КонецПроцедуры

Функция ПрочитатьФикстуру(Знач Путь)
	Чтение = Новый ЧтениеJSON();
	Чтение.ОткрытьФайл(Путь);
	Значение = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Значение;
КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция Доверие()
	Возврат Желудь("СервисДоверияCI");
КонецФункции

Функция СессияПринципал(Знач Пользователь)
	Возврат Новый Структура("Пользователь, Способ, Права, ПулИдентификатор, Сессия",
		Пользователь, "session", "", 0, Неопределено);
КонецФункции

Функция Опубликовать(Знач Пул, Знач Пользователь, Знач ИмяПакета, Знач Версия)
	Возврат Желудь("СервисПубликации").Опубликовать(Пул.Имя,
		ПостроитьOspxДанные(ИмяПакета, Версия),
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия), "stable", Пользователь, "");
КонецФункции

Функция СоздатьМейнтейнера(Знач Пул)

	Хранилище = Желудь("ХранилищеПользователей");
	Польз = Хранилище.СоздатьЭлемент();
	Польз.Логин = УникальноеИмя("u");
	Польз.Email = Польз.Логин + "@example.com";
	Польз.Активен = Истина;
	Польз.РольХаба = "user";
	Польз.Создан = ТекущаяУниверсальнаяДата();
	Польз.Сохранить();

	Участник = Желудь("ХранилищеУчастниковПула").СоздатьЭлемент();
	Участник.ПулИдентификатор = Пул.Идентификатор;
	Участник.ТипСубъекта = "пользователь";
	Участник.СубъектИдентификатор = Польз.Идентификатор;
	Участник.Роль = "owner";
	Участник.Сохранить();
	Возврат Польз;

КонецФункции

Функция ПостроитьOspxДанные(Знач ИмяПакета, Знач Версия)
	Возврат Новый ФикстураПакета().ДанныеOspx(КаталогСборки, ИмяПакета, Версия);
КонецФункции

Функция УникальноеИмя(Знач Префикс)
	Счётчик = Счётчик + 1;
	Возврат Префикс + "-" + Формат(Счётчик, "ЧГ=0; ЧН=0");
КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("ревью.oshub.конвейеры");
КонецФункции

#КонецОбласти
