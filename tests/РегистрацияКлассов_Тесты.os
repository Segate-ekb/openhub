// Сторож регистрации классов: winow рекурсивно сканирует src/модули и подключает каждый
// *.os под именем файла. Поэтому файл без типа, пара одноимённых файлов и требование
// желудя, которому больше не соответствует класс, ломают хаб молча — падением в другом
// месте или несобранным желудем при зелёных тестах. Детекторы закрыты самотестами.

#Использовать asserts
#Использовать autumn
#Использовать autumn-logos
#Использовать winow
#Использовать autumn-data
#Использовать entity
#Использовать ospx-tools
#Использовать os-scheduler
#Использовать oidc-client
#Использовать oint
#Использовать "фикстуры"

Перем Исходники;   // фикстура ИсходникиПроекта — чтение файлов репозитория
Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогПроекта;
Перем Хаб;
Перем Порт;

// Ниже этого числа скан считается ослепшим: в src/ сотни классов, ноль или десяток
// файлов означают переехавший каталог, а не похудевший проект.
Перем МинимумФайлов;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ИсходникиПроекта");
	Исходники = Новый ИсходникиПроекта();

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	МинимумФайлов = 300;

КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;

	РеестрФикстур.Подключить("ЭкземплярХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Хаб.ФайловаяБаза("openhub-регистрация");
	// акцент — метка инсталляции на странице: у пустышки кита оформление пустое,
	// и подстановки --color-accent в разметке не будет вовсе
	Хаб.Среда("OSHUB_UI_ACCENT", АкцентИнсталляции());
	Хаб.Запустить();
	Порт = Хаб.Порт();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;

КонецПроцедуры

#Область СторожРегистрации

&Тест
&Тег("смоук")
Процедура ЖивойХабПоднимаетсяСТекущейРаскладкойКлассов() Экспорт

	Готовность = ДождатьсяГотовности(30);

	Ожидаем.Что(Готовность.Код,
		"GET /ready поднятого хаба: 503 или отказ соединения = контейнер не собрался"
		+ " на текущей раскладке файлов классов. Последний ответ: " + Готовность.Ответ).Равно(200);

КонецПроцедуры

&Тест
Процедура КаждыйФайлИсходниковДаётТипСИменемФайла() Экспорт

	Нарушители = Новый Массив();
	Проверено = 0;

	Для Каждого Файл Из ФайлыИсходников() Цикл

		Если ЭтоЗаконноеИсключение(Файл) Тогда
			Продолжить;
		КонецЕсли;

		Путь = Исходники.ОтносительныйПуть(Файл.ПолноеИмя);
		Проверено = Проверено + 1;

		Если ПоискКлассов.ТипЗарегистрирован(Файл.ИмяБезРасширения) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ПодключитьСценарий(Файл.ПолноеИмя, Файл.ИмяБезРасширения);
		Исключение
			Нарушители.Добавить(Путь + " — подключение отказало: " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Если НЕ ПоискКлассов.ТипЗарегистрирован(Файл.ИмяБезРасширения) Тогда
			Нарушители.Добавить(Путь + " — подключился, но типа "
				+ Файл.ИмяБезРасширения + " не появилось");
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС),
		"файлы src/, не дающие тип с именем файла: winow подключает их на старте хаба —"
		+ " такой файл роняет сборку контейнера либо тихо оставляет желудь несобранным")
		.Равно("");

	Ожидаем.Что(Проверено >= МинимумФайлов,
		СтрШаблон("проверено %1 файлов при минимуме %2 — скан ослеп", Проверено, МинимумФайлов))
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КаждыйТребуемыйЖелудьИмеетКлассИлиПрозвище() Экспорт

	Известные = ИзвестныеИменаЖелудей();
	Нарушители = Новый Массив();
	Требований = 0;

	Для Каждого Файл Из ФайлыИсходников() Цикл

		Путь = Исходники.ОтносительныйПуть(Файл.ПолноеИмя);

		Для Каждого Имя Из ИменаЖелудейИзТекста(Исходники.Текст(Файл.ПолноеИмя)) Цикл
			Требований = Требований + 1;
			Если Известные[Имя] = Неопределено Тогда
				Нарушители.Добавить(Путь + " требует желудь " + Имя);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС),
		"требования &Пластилин без класса, прозвища и завязи: переименованный или"
		+ " потерянный класс ОСень обнаружит только при сборке зависимого желудя —"
		+ " то есть в рантайме и в другом месте").Равно("");

	Ожидаем.Что(Требований > 500,
		СтрШаблон("найдено %1 требований &Пластилин — детектор ослеп", Требований)).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ИменаФайловИсходниковУникальныГлобально() Экспорт

	ПутиПоИмени = Новый Соответствие();

	Для Каждого Файл Из ФайлыИсходников() Цикл
		Пути = ПутиПоИмени[Файл.ИмяБезРасширения];
		Если Пути = Неопределено Тогда
			Пути = Новый Массив();
			ПутиПоИмени.Вставить(Файл.ИмяБезРасширения, Пути);
		КонецЕсли;
		Пути.Добавить(Исходники.ОтносительныйПуть(Файл.ПолноеИмя));
	КонецЦикла;

	Дубли = Новый Массив();
	Для Каждого КиЗ Из ПутиПоИмени Цикл
		Если КиЗ.Значение.Количество() > 1 Тогда
			Дубли.Добавить(КиЗ.Ключ + ": " + СтрСоединить(КиЗ.Значение, ", "));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Дубли, Символы.ПС),
		"одноимённые файлы классов: имена типов в OneScript глобальны, подкаталог"
		+ " пространства имён не создаёт — какой из двух файлов победит, непредсказуемо,"
		+ " а на одноимённых желудях ОСень роняет старт хаба").Равно("");

КонецПроцедуры

&Тест
Процедура ПрозвищеПринадлежитРовноОдномуКлассу() Экспорт

	ПутиПоПрозвищу = ПрозвищаПоФайлам();

	Ожидаем.Что(СтрСоединить(ДублиПрозвищ(ПутиПоПрозвищу), Символы.ПС),
		"два класса src/ с одним прозвищем вне списка реестров реализаций: ОСень выберет"
		+ " один из них непредсказуемо, и подмена реализации пройдёт незамеченной").Равно("");

	// прозвище, решающее «публиковать или нет», названо поимённо: у поставки должна быть
	// ровно одна проверка подписи, а не «какая нашлась»
	Носители = ПутиПоПрозвищу["ПроверяющийПодписиCI"];
	Ожидаем.Что(?(Носители = Неопределено, 0, Носители.Количество()),
		"ровно один класс src/ носит прозвище ПроверяющийПодписиCI").Равно(1);

	Ожидаем.Что(ПутиПоПрозвищу.Количество() > 20,
		СтрШаблон("найдено %1 прозвищ — детектор ослеп", ПутиПоПрозвищу.Количество())).ЭтоИстина();

КонецПроцедуры

// Перебиваемый контракт — единственное место, где двух носителей прозвища терпят.
// Терпимость держится на &Верховном: ОСень ищет желудь СНАЧАЛА по имени и только потом
// по прозвищу, а среди прозвищ выбирает верховного; без него — «найдено несколько
// желудей», а при двух верховных — исключение на старте. Ни то ни другое не должно
// доезжать до боевого запуска.
&Тест
Процедура ПеребиваемыйКонтрактИмеетРовноОдногоВерховного() Экспорт

	ПутиПоПрозвищу = ПрозвищаПоФайлам();
	Нарушения = Новый Массив();

	Для Каждого КиЗ Из ПеребиваемыеПрозвища() Цикл

		Пути = ПутиПоПрозвищу[КиЗ.Ключ];
		Если Пути = Неопределено ИЛИ Пути.Количество() < 2 Тогда
			Нарушения.Добавить(СтрШаблон("%1 — носителей %2: контракт перестал быть"
				+ " перебиваемым, уберите его из списка",
				КиЗ.Ключ, ?(Пути = Неопределено, 0, Пути.Количество())));
			Продолжить;
		КонецЕсли;

		Верховных = ВерховныхНосителей(Пути);
		Если Верховных <> 1 Тогда
			Нарушения.Добавить(СтрШаблон("%1 — верховных носителей %2 при ровно одном"
				+ " ожидаемом (%3)", КиЗ.Ключ, Верховных, СтрСоединить(Пути, ", ")));
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушения, Символы.ПС),
		"перебиваемые контракты без ровно одного &Верховного носителя").Равно("");

КонецПроцедуры

// У контракта кита пустышка живёт в библиотеке, поэтому в src/ носитель ровно один —
// реализация инсталляции, и она обязана быть &Верховной. Без пометки ОСень выбирает
// из двух произвольно, и хаб может молча остаться на пустышке.
&Тест
Процедура УКонтрактаКитаОдинНосительВПроектеИОнВерховный() Экспорт

	ПутиПоПрозвищу = ПрозвищаПоФайлам();
	Нарушения = Новый Массив();

	Для Каждого КиЗ Из КонтрактыКита() Цикл

		Пути = ПутиПоПрозвищу[КиЗ.Ключ];
		Если Пути = Неопределено ИЛИ Пути.Количество() <> 1 Тогда
			Нарушения.Добавить(СтрШаблон("%1 — носителей в src/ %2 при ровно одном ожидаемом",
				КиЗ.Ключ, ?(Пути = Неопределено, 0, Пути.Количество())));
			Продолжить;
		КонецЕсли;

		Если ВерховныхНосителей(Пути) <> 1 Тогда
			Нарушения.Добавить(СтрШаблон("%1 — носитель %2 не помечен &Верховным:"
				+ " пустышка кита его не пропустит", КиЗ.Ключ, Пути[0]));
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушения, Символы.ПС),
		"контракты кита без единственного &Верховного носителя в проекте").Равно("");

КонецПроцедуры

// Та же защита, но ПО ЗНАЧЕНИЮ: страница живого хаба показывает, чья реализация выиграла
// у контейнера. Текстовая проверка выше сторожит объявления, эта — результат, и она
// переживает любые переезды файлов. Каждый признак виден только тогда, когда контракт
// перебит инсталляцией: у пустышек кита словарь пуст, оформление пусто, статики нет вовсе.
&Тест
&Тег("смоук")
Процедура КонтрактыКитаПеребитыИнсталляциейНаЖивомХабе() Экспорт

	Ответ = Запрос(СтраницаБезВхода());
	Ожидаем.Что(Ответ.КодСостояния, "страница входа отдана").Равно(200);
	Разметка = Ответ.ПолучитьТелоКакСтроку();

	Ожидаем.Что(СтрНайти(Разметка, "[?"),
		"маркер [?ключ] в разметке: СловарьИнтерфейса остался пустышкой кита,"
		+ " и экраны печатают ключи вместо текстов").Равно(0);

	Ожидаем.Что(СтрНайти(Разметка, "--color-accent:" + АкцентИнсталляции()) > 0,
		СтрШаблон("акцент инсталляции %1 не доехал до страницы: ОформлениеИнсталляции"
			+ " осталось пустышкой кита", АкцентИнсталляции())).ЭтоИстина();

	Ожидаем.Что(СтрНайти(Разметка, "/static/openhub-") > 0,
		"адреса таблицы стилей с отпечатком на странице нет: СтатикаИнсталляции"
		+ " осталась пустышкой кита, и хаб отдаёт страницу без оформления").ЭтоИстина();

КонецПроцедуры

// Желудь, которому ОСень что-то внедряет, обязан приезжать из контейнера. Созданный
// оператором «Новый», он получает пустые зависимости: форматтер журнала без хранилищ
// пишет номера вместо имён, буфер спанов теряет настройку оператора. Снаружи оба
// выглядят собранными, поэтому такая подмена переживает и тесты, и ревью.
&Тест
Процедура ЖелудьСВнедрениямиНеСоздаётсяНапрямую() Экспорт

	Желуди = ЖелудиСВнедрениями();
	Нарушители = Новый Массив();

	Для Каждого Файл Из ФайлыИсходников() Цикл
		Для Каждого Место Из ПрямыеСоздания(Исходники.Текст(Файл.ПолноеИмя), Желуди) Цикл
			Нарушители.Добавить(Файл.Имя + ": " + Место);
		КонецЦикла;
	КонецЦикла;

	// Числа мало: пятая часть корпуса выпадала из-под сторожа при зелёном «> 100».
	// Поэтому названы поимённо носители РАЗНЫХ аннотаций класса — &Желудь, &Контроллер
	// winow, &Дуб: отбор по аннотации класса срезал бы контроллеры и конфигурацию молча.
	Ожидаем.Что(Желуди.Количество() > 300,
		СтрШаблон("желудей с внедрениями найдено %1 — детектор ослеп", Желуди.Количество())).ЭтоИстина();
	Ожидаем.Что(Желуди["ИмяОбъектаАудита"] <> Неопределено,
		"&Желудь с внедрёнными хранилищами").ЭтоИстина();
	Ожидаем.Что(Желуди["КонтроллерДомаХаба"] <> Неопределено,
		"&Контроллер winow с семнадцатью пластилинами, включая гвард админа").ЭтоИстина();
	Ожидаем.Что(Желуди["КонфигурацияХранилища"] <> Неопределено,
		"&Дуб с восемью детальками: созданный напрямую, берёт умолчания вместо настроек")
		.ЭтоИстина();
	Ожидаем.Что(Желуди["ГотовностьХаба"] <> Неопределено,
		"конструктор с одним &Лог — тоже внедрение: напрямую созданный объект получит"
		+ " дефолтный логгер вместо контейнерного").ЭтоИстина();
	Ожидаем.Что(Желуди["ПриведениеЧисел"],
		"желудь без единого внедрения ничего не теряет от прямого создания").Равно(Неопределено);

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС),
		"желуди, созданные в обход контейнера: зависимости приедут пустыми").Равно("");

КонецПроцедуры

&Тест
Процедура СписокЖелудейСобираетсяПоАннотациямПараметровАНеКласса() Экспорт

	// Роль класса к внедрениям отношения не имеет: &Контроллер winow и &Дуб получают
	// зависимости так же, как &Желудь. Отбор по аннотации класса выбрасывал полсотни
	// контроллеров вместе с гвардом админа и единственный &Дуб проекта.
	Роли = Новый Соответствие();
	Роли.Вставить("&Желудь", "&Желудь");
	Роли.Вставить("&Рогатка", "&Рогатка");
	Роли.Вставить("&Дуб", "&Дуб");
	Роли.Вставить("&Контроллер winow", "&Контроллер(Путь = ""/hub"")");
	Роли.Вставить("без аннотации класса", "");

	Незамеченные = Новый Массив();
	Для Каждого КиЗ Из Роли Цикл
		Исходник = КиЗ.Значение + Символы.ПС
			+ "Процедура ПриСозданииОбъекта(" + Символы.ПС
			+ "	&Пластилин(Значение = ""ХранилищеПулов"") _Пулы)" + Символы.ПС
			+ "КонецПроцедуры";
		Если НЕ ЭтоЖелудьСВнедрениями(Исходник) Тогда
			Незамеченные.Добавить(КиЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Незамеченные, ", "),
		"роли классов, чьи внедрения список не заметил").Равно("");

	// имя конструктора ищется как ИМЯ: пробел перед скобкой — валидный OneScript, и класс
	// с таким написанием выпадал из списка вместе со всеми своими внедрениями
	Ожидаем.Что(ЭтоЖелудьСВнедрениями("&Желудь" + Символы.ПС
		+ "Процедура ПриСозданииОбъекта (" + Символы.ПС
		+ "	&Деталька(Значение = ""oshub.webhooks.max_queue"") _Размер = 2048)" + Символы.ПС
		+ "КонецПроцедуры"),
		"пробел перед скобкой конструктора не прячет внедрения").ЭтоИстина();

	// приманка: метод-сосед, чьё ИМЯ КОНЧАЕТСЯ на имя конструктора, уводил разбор на свои
	// параметры — внедрений там нет, и класс уходил из-под сторожа
	Сосед = "Процедура ЗаписатьПриСозданииОбъекта(Знач Сообщение)" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС
		+ "&Желудь" + Символы.ПС
		+ "Процедура ПриСозданииОбъекта(&Пластилин(Значение = ""ХранилищеПулов"") _Пулы)" + Символы.ПС
		+ "КонецПроцедуры";
	Ожидаем.Что(ЭтоЖелудьСВнедрениями(Сосед),
		"суффикс в имени чужого метода не подменяет конструктор").ЭтоИстина();

	// приманка: упоминание конструктора в ЛИТЕРАЛЕ выше настоящего уводило разбор на себя
	Приманка = "Функция Подсказка()" + Символы.ПС
		+ "	Возврат ""вызовите ПриСозданииОбъекта(Лимит) сами"";" + Символы.ПС
		+ "КонецФункции" + Символы.ПС
		+ "&Дуб" + Символы.ПС
		+ "Процедура ПриСозданииОбъекта(" + Символы.ПС
		+ "	&Деталька(Значение = ""oshub.storage.root"") _Корень = """")" + Символы.ПС
		+ "КонецПроцедуры";
	Ожидаем.Что(ЭтоЖелудьСВнедрениями(Приманка),
		"литерал с именем конструктора не уводит разбор с настоящего").ЭтоИстина();

	Ожидаем.Что(ЭтоЖелудьСВнедрениями("&Желудь" + Символы.ПС
		+ "Процедура ПриСозданииОбъекта(&Лог _Лог = Неопределено)" + Символы.ПС
		+ "КонецПроцедуры"),
		"один только &Лог — тоже внедрение").ЭтоИстина();

	Ожидаем.Что(ЭтоЖелудьСВнедрениями(
		"Процедура ПриСозданииОбъекта(Знач Лимит = 10)" + Символы.ПС + "КонецПроцедуры"),
		"конструктор без внедрений — не желудь с зависимостями").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ДетекторПрямогоСозданияВидитОбходы() Экспорт

	// Каждая форма — рабочий OneScript, и каждая снимала прежнего сканера, искавшего
	// «Новый<Имя>(»: скобки необязательны, перенос строки разделителем не считается,
	// а имя класса вправе приехать переменной.
	Желуди = Новый Соответствие();
	Желуди.Вставить("ИмяОбъектаАудита", Истина);

	Формы = Новый Соответствие();
	Формы.Вставить("канон", "	Имена = Новый ИмяОбъектаАудита();");
	Формы.Вставить("без скобок", "	Имена = ?(_Имена = Неопределено, Новый ИмяОбъектаАудита, _Имена);");
	Формы.Вставить("перенос строки", "	Имена = Новый" + Символы.ПС + "		ИмяОбъектаАудита();");
	Формы.Вставить("таб вместо пробела", "	Имена = Новый	ИмяОбъектаАудита;");
	Формы.Вставить("имя переменной", "	Имена = Новый(ИмяКласса);");
	Формы.Вставить("имя литералом", "	Имена = Новый(""ИмяОбъектаАудита"");");
	// закрывающая строка многострочного литерала: после кавычки на ней законно стоит код,
	// и обнуление строки целиком стирало создание раньше, чем сканер до него доходил
	Формы.Вставить("код за закрывающей кавычкой литерала",
		"	Лог.Отладка(""форматтер не прилеплен," + Символы.ПС
		+ "	|собираю сам""); Имена = Новый ИмяОбъектаАудита();");

	Пропущенные = Новый Массив();
	Для Каждого КиЗ Из Формы Цикл
		Если ПрямыеСоздания(КиЗ.Значение, Желуди).Количество() = 0 Тогда
			Пропущенные.Добавить(КиЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Пропущенные, ", "), "обходы, которых сканер не видит").Равно("");

	// вечнокрасный сканер не лучше вечнозелёного
	Ложные = Новый Соответствие();
	Ложные.Вставить("чужой класс с общим началом имени", "	Х = Новый ИмяОбъектаАудитаДругой();");
	Ложные.Вставить("встроенный тип без скобок", "	Строки = Новый Массив;");
	Ложные.Вставить("упоминание в комментарии", "	// раньше здесь было Новый ИмяОбъектаАудита()");
	Ложные.Вставить("упоминание в литерале", "	Текст = ""Новый ИмяОбъектаАудита() — так нельзя"";");
	Ложные.Вставить("желудь не из списка", "	Числа = Новый ПриведениеЧисел();");
	// имя параметра, начинающееся на «Новый», — не оператор создания: на этом сканер
	// поймал сам себя, объявив нарушителем присваивание внедрённого клиента
	Ложные.Вставить("переменная с именем на «Новый»", "	Имена = НовыйИмяОбъектаАудита;");
	// а САМ текст многострочного литерала кодом не становится
	Ложные.Вставить("упоминание внутри многострочного литерала",
		"	Текст = ""так делать нельзя:" + Символы.ПС
		+ "	|Новый ИмяОбъектаАудита"";");

	Ошибочные = Новый Массив();
	Для Каждого КиЗ Из Ложные Цикл
		Если ПрямыеСоздания(КиЗ.Значение, Желуди).Количество() > 0 Тогда
			Ошибочные.Добавить(КиЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Ошибочные, ", "), "ложные срабатывания сканера").Равно("");

КонецПроцедуры

&Тест
Процедура ДетекторДублейПрозвищЛовитВторогоНосителя() Экспорт

	Проба = Новый Соответствие();
	Проба.Вставить("Одинокое", НосителиПробы("а.os"));
	Проба.Вставить("Двойное", НосителиПробы("а.os", "б.os"));

	Найдено = СтрСоединить(ДублиПрозвищ(Проба), Символы.ПС);
	Ожидаем.Что(Найдено, "два носителя опознаны").Содержит("Двойное");
	Ожидаем.Что(Найдено, "и названы оба файла").Содержит("б.os");
	Ожидаем.Что(СтрНайти(Найдено, "Одинокое"), "единственный носитель нарушением не считается").Равно(0);

	Исключённое = Новый Соответствие();
	Исключённое.Вставить("ХранениеПодписки", НосителиПробы("а.os", "б.os"));
	Ожидаем.Что(ДублиПрозвищ(Исключённое).Количество(),
		"прозвище из списка реестров реализаций пропускается").Равно(0);

КонецПроцедуры

// Список исключений без этой проверки превращается в свалку: снятый второй носитель
// оставляет в нём мёртвую строку, и она молча разрешает будущую подмену.
&Тест
Процедура СписокМногоносныхПрозвищНеПротух() Экспорт

	ПутиПоПрозвищу = ПрозвищаПоФайлам();
	Лишние = Новый Массив();

	Для Каждого КиЗ Из МногоносныеПрозвища() Цикл
		Носители = ПутиПоПрозвищу[КиЗ.Ключ];
		Если Носители = Неопределено ИЛИ Носители.Количество() < 2 Тогда
			Лишние.Добавить(КиЗ.Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Лишние, ", "),
		"прозвища числятся многоносными, а носитель у них уже один или ни одного:"
		+ " строку надо убрать, иначе исключение переживёт свою причину").Равно("");

КонецПроцедуры

&Тест
Процедура СборщикКонтейнераБерётХранилищеВместеСРеестром() Экспорт

	// Желуди core-registry (УчётОбъёмаПула, УборкаПакета) требуют ХранилищеАртефактов:
	// сборщик, перечисливший каталоги модулей и взявший реестр без storage, получает
	// НЕсобранный СервисПулов — и падает не при сборке, а в первой же публикации.
	// Область — src/, tools/ и scripts/: тестовый контейнер, взявший реестр без хранилища,
	// краснеет собственным набором в тот же прогон, а принудительный storage замедлил бы
	// десяток наборов, которым эти желуди не нужны.
	Сборщики = СборщикиКонтейнера();
	Ожидаем.Что(Сборщики.Количество() >= 3,
		СтрШаблон("сборщиков контейнера найдено %1 — скан ослеп", Сборщики.Количество())).ЭтоИстина();

	Нарушители = Новый Массив();
	Для Каждого Файл Из Сборщики Цикл
		Текст = Исходники.Текст(Файл.ПолноеИмя);
		Если СтрНайти(Текст, """core-registry""") > 0 И СтрНайти(Текст, """storage""") = 0 Тогда
			Нарушители.Добавить(Файл.Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"сборщики контейнера, взявшие core-registry без storage").Равно("");

КонецПроцедуры

&Тест
Процедура КорпусСканаНеВыродился() Экспорт

	Файлов = ФайлыИсходников().Количество();

	Ожидаем.Что(Файлов >= МинимумФайлов,
		СтрШаблон("в корпусе %1 файлов *.os при минимуме %2 — каталог src/ переехал"
			+ " и сторож зеленеет на пустом множестве", Файлов, МинимумФайлов)).ЭтоИстина();

	Ожидаем.Что(ЕстьВКорпусе("Пакет.os"),
		"сущность Пакет обязана быть в корпусе").ЭтоИстина();
	Ожидаем.Что(ЕстьВКорпусе("КонтроллерГотовности.os"),
		"контроллер готовности обязан быть в корпусе").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СпискиИсключенийНеПротухли() Экспорт

	ПутиКорпуса = Новый Соответствие();
	Для Каждого Файл Из ФайлыИсходников() Цикл
		ПутиКорпуса.Вставить(ОтносительныйПутьБезРасширения(Файл), Истина);
	КонецЦикла;

	Пропавшие = Новый Массив();
	Для Каждого Путь Из ЗаконныеИсключения() Цикл
		Если ПутиКорпуса[Путь] = Неопределено Тогда
			Пропавшие.Добавить(Путь);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропавшие, ", "),
		"файлы-исключения, которых нет в корпусе: список протух и однажды накроет"
		+ " собой настоящий класс").Равно("");

	Требуемые = Новый Соответствие();
	Для Каждого Файл Из ФайлыИсходников() Цикл
		Для Каждого Имя Из ИменаЖелудейИзТекста(Исходники.Текст(Файл.ПолноеИмя)) Цикл
			Требуемые.Вставить(Имя, Истина);
		КонецЦикла;
	КонецЦикла;

	Лишние = Новый Массив();
	Для Каждого КиЗ Из ЖелудиБиблиотек() Цикл
		Если Требуемые[КиЗ.Ключ] = Неопределено Тогда
			Лишние.Добавить(КиЗ.Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Лишние, ", "),
		"желуди библиотек, которых никто не требует: запись в списке лишняя и"
		+ " прикрывает собой будущую опечатку").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СамотестыДетекторов

&Тест
Процедура ДетекторИмёнЖелудейРазбираетОбеФормыАннотации() Экспорт

	Текст = "Процедура ПриСозданииОбъекта(" + Символы.ПС
		+ "	&Пластилин(Значение = ""ХранилищеПакетов"") _Хранилище," + Символы.ПС
		+ "	&Пластилин(Значение =" + Символы.ПС
		+ "		""ХранилищеПулов"") _Пулы," + Символы.ПС
		+ "	&Пластилин ЗапросыПакетов)" + Символы.ПС
		+ "КонецПроцедуры";

	Ожидаем.Что(СтрСоединить(ИменаЖелудейИзТекста(Текст), ","),
		"именованная, многострочная и голая формы &Пластилин")
		.Равно("ХранилищеПакетов,ХранилищеПулов,ЗапросыПакетов");

	Ожидаем.Что(ИменаЖелудейИзТекста("// &Пластилин(Значение = ""Призрак"")").Количество(),
		"упоминание в комментарии — не требование желудя").Равно(0);

	Ожидаем.Что(ИменаЖелудейИзТекста("Адрес = ""https://hub.example"";").Количество(),
		"двойной слэш внутри литерала не обрезает строку").Равно(0);

КонецПроцедуры

&Тест
Процедура ДетекторПрозвищСобираетИмяИзЛитерала() Экспорт

	Ожидаем.Что(СтрСоединить(ИменаИзАннотации("&Прозвище(""ТранспортHTTP"")", "&Прозвище"), ","),
		"прозвище класса").Равно("ТранспортHTTP");

	Ожидаем.Что(СтрСоединить(
		ИменаИзАннотации("&Завязь(Значение = ""ХранилищеАртефактов"", Тип = ""ХранилищеАртефактов"")",
			"&Завязь"), ","),
		"имя завязи — первый литерал аннотации").Равно("ХранилищеАртефактов");

	Ожидаем.Что(ИменаИзАннотации("// &Прозвище(""Призрак"")", "&Прозвище").Количество(),
		"упоминание в комментарии — не объявление").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Списки

// Файлы src/**/*.os, которым тип не положен. Перечисление явное, без шаблонов:
// шаблон рано или поздно накрывает собой настоящий незарегистрированный класс.
// Пути даны без расширения: литерал пути к точке входа в наборах запрещён линтом
// tests/ИнфраструктураТестов_Тесты.os.
Функция ЗаконныеИсключения()

	Исключения = Новый Массив();

	// точка входа: сценарий верхнего уровня вне src/модули — winow его не сканирует,
	// а подключение как класса подняло бы второй хаб прямо в процессе набора.
	Исключения.Добавить("src/main");

	Возврат Исключения;

КонецФункции

// Прозвище → пути файлов src/, которые его объявляют.
Функция ПрозвищаПоФайлам()

	Результат = Новый Соответствие();

	Для Каждого Файл Из ФайлыИсходников() Цикл
		Для Каждого Имя Из ИменаИзАннотации(Исходники.Текст(Файл.ПолноеИмя), "&Прозвище") Цикл
			Пути = Результат[Имя];
			Если Пути = Неопределено Тогда
				Пути = Новый Массив();
				Результат.Вставить(Имя, Пути);
			КонецЕсли;
			Пути.Добавить(Исходники.ОтносительныйПуть(Файл.ПолноеИмя));
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Прозвища с несколькими носителями, кроме законных реестров реализаций и перебиваемых
// контрактов.
Функция ДублиПрозвищ(Знач ПутиПоПрозвищу)

	Результат = Новый Массив();

	Для Каждого КиЗ Из ПутиПоПрозвищу Цикл
		Если КиЗ.Значение.Количество() = 1
			ИЛИ МногоносныеПрозвища()[КиЗ.Ключ] <> Неопределено
			ИЛИ ПеребиваемыеПрозвища()[КиЗ.Ключ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(КиЗ.Ключ + ": " + СтрСоединить(КиЗ.Значение, ", "));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сколько носителей прозвища помечены &Верховный.
Функция ВерховныхНосителей(Знач Пути)

	Сколько = 0;
	Для Каждого Путь Из Пути Цикл
		Полный = ОбъединитьПути(КаталогПроекта, СтрЗаменить(Путь, "/", ПолучитьРазделительПути()));
		Если СтрНайти(БезКомментариев(Исходники.Текст(Полный)), "&Верховный") > 0 Тогда
			Сколько = Сколько + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Сколько;

КонецФункции

Функция НосителиПробы(Знач Первый, Знач Второй = "")
	Результат = Новый Массив();
	Результат.Добавить(Первый);
	Если ЗначениеЗаполнено(Второй) Тогда
		Результат.Добавить(Второй);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Прозвища, у которых носителей ЗАКОННО много: ОСень собирает их списком, и каждый
// обработчик подписок объявляет свою реализацию под общим именем. Перечисление явное —
// шаблон рано или поздно накроет собой настоящую подмену реализации.
Функция МногоносныеПрозвища()

	Имена = Новый Соответствие();
	Имена.Вставить("РендерНастроекПодписки", Истина);
	Имена.Вставить("ОбработчикДоставкиПодписки", Истина);
	Имена.Вставить("ХранениеПодписки", Истина);
	// источники апстрима синхронизатор берёт МАССИВОМ и диспетчеризует по Режим():
	// второй носитель — это второй протокол зеркалирования, а не подмена первого
	Имена.Вставить("ИсточникАпстрима", Истина);
	Возврат Имена;

КонецФункции

// Прозвища-КОНТРАКТЫ проекта, у которых носителей законно двое: реализация по умолчанию
// и перебивающая её реализация инсталляции.
Функция ПеребиваемыеПрозвища()

	Имена = Новый Соответствие();
	Имена.Вставить("АвтовыдачаПравGitHub", Истина);
	Возврат Имена;

КонецФункции

// Прозвища-контракты КИТА: пустышка каждого приезжает библиотекой, поэтому носитель
// в src/ ровно один — реализация инсталляции. Что перебивка действительно сработала,
// проверяет по значению КонтрактыКитаПеребитыИнсталляциейНаЖивомХабе.
Функция КонтрактыКита()

	Имена = Новый Соответствие();
	Имена.Вставить("СловарьИнтерфейса", Истина);
	Имена.Вставить("ОформлениеИнсталляции", Истина);
	Имена.Вставить("СтатикаИнсталляции", Истина);
	Возврат Имена;

КонецФункции

// Желуди чужих библиотек: класса в src/ у них нет и не будет. Классы, которые библиотека
// поставляет файлами, сюда не пишутся — их знает КлассыБиблиотек по lib.config.
Функция ЖелудиБиблиотек()

	Имена = Новый Соответствие();

	// winow: сервер, открывающий порт.
	Имена.Вставить("ВебСервер", Истина);
	// winow: куки текущего запроса.
	Имена.Вставить("Куки", Истина);

	Возврат Имена;

КонецФункции

// Классы, поставляемые установленными библиотеками. Читается манифест поставки, а не
// список руками: кит один привозит полсотни желудей, и переписанный руками список
// разошёлся бы с поставкой в первый же подъём версии.
Функция КлассыБиблиотек()

	Имена = Новый Соответствие();
	Корень = ОбъединитьПути(КаталогПроекта, "oscript_modules");

	Если НЕ Новый Файл(Корень).Существует() Тогда
		Возврат Имена;
	КонецЕсли;

	Для Каждого Манифест Из НайтиФайлы(Корень, "lib.config", Истина) Цикл
		Если Манифест.ЭтоФайл() Тогда
			ДобавитьКлассыМанифеста(Имена, Исходники.Текст(Манифест.ПолноеИмя));
		КонецЕсли;
	КонецЦикла;

	Возврат Имена;

КонецФункции

Процедура ДобавитьКлассыМанифеста(Имена, Знач Текст)

	Позиция = 1;
	Пока Истина Цикл

		Начало = СтрНайти(Текст, "<class ", , Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;

		Хвост = Сред(Текст, СтрНайти(Текст, "name=""", , Начало) + СтрДлина("name="""));
		Имена.Вставить(Лев(Хвост, СтрНайти(Хвост, """") - 1), Истина);
		Позиция = Начало + 1;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Детекторы

// Имена желудей, которые класс требует через &Пластилин: именованная форма
// &Пластилин(Значение = "Имя") и голая форма &Пластилин ИмяПараметра.
Функция ИменаЖелудейИзТекста(Знач Текст)

	Имена = Новый Массив();
	Чистый = БезКомментариев(Текст);
	Позиция = 1;

	Пока Истина Цикл

		Найдено = СтрНайти(Чистый, "&Пластилин", , Позиция);
		Если Найдено = 0 Тогда
			Прервать;
		КонецЕсли;

		Хвост = СокрЛ(Сред(Чистый, Найдено + СтрДлина("&Пластилин")));
		Если Лев(Хвост, 1) = "(" Тогда
			Имя = ПервыйЛитерал(Хвост);
		Иначе
			Имя = Идентификатор(Хвост);
		КонецЕсли;

		Если ЗначениеЗаполнено(Имя) Тогда
			Имена.Добавить(Имя);
		КонецЕсли;

		Позиция = Найдено + 1;

	КонецЦикла;

	Возврат Имена;

КонецФункции

// Имена, объявленные аннотацией вида &Аннотация("Имя") либо &Аннотация(Значение = "Имя", ...).
Функция ИменаИзАннотации(Знач Текст, Знач ИмяАннотации)

	Имена = Новый Массив();
	Чистый = БезКомментариев(Текст);
	Позиция = 1;

	Пока Истина Цикл

		Найдено = СтрНайти(Чистый, ИмяАннотации + "(", , Позиция);
		Если Найдено = 0 Тогда
			Прервать;
		КонецЕсли;

		Имя = ПервыйЛитерал(Сред(Чистый, Найдено + СтрДлина(ИмяАннотации)));
		Если ЗначениеЗаполнено(Имя) Тогда
			Имена.Добавить(Имя);
		КонецЕсли;

		Позиция = Найдено + 1;

	КонецЦикла;

	Возврат Имена;

КонецФункции

// Первый строковый литерал внутри скобок аннотации.
Функция ПервыйЛитерал(Знач Хвост)

	Конец = СтрНайти(Хвост, ")");
	Если Конец = 0 Тогда
		Возврат "";
	КонецЕсли;

	Сегмент = Лев(Хвост, Конец);
	Открывающая = СтрНайти(Сегмент, """");
	Если Открывающая = 0 Тогда
		Возврат "";
	КонецЕсли;

	Закрывающая = СтрНайти(Сегмент, """", , Открывающая + 1);
	Если Закрывающая = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Сред(Сегмент, Открывающая + 1, Закрывающая - Открывающая - 1);

КонецФункции

Функция Идентификатор(Знач Хвост)

	Итог = "";

	Для Позиция = 1 По СтрДлина(Хвост) Цикл
		Символ = Сред(Хвост, Позиция, 1);
		Если НЕ ЭтоСимволИдентификатора(Символ) Тогда
			Прервать;
		КонецЕсли;
		Итог = Итог + Символ;
	КонецЦикла;

	Возврат Итог;

КонецФункции

Функция ЭтоСимволИдентификатора(Знач Символ)

	Возврат СтрНайти("QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm"
		+ "ЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮйцукенгшщзхъфывапролджэячсмитьбю"
		+ "0123456789_", Символ) > 0;

КонецФункции

// Срезает построчные комментарии, не трогая содержимое строковых литералов.
// Классы-желуди, которым ОСень что-то внедряет в конструктор: имя класса → Истина.
// Желудь без единого внедрения от прямого создания ничего не теряет и в список не идёт.
Функция ЖелудиСВнедрениями()

	Желуди = Новый Соответствие();

	Для Каждого Файл Из ФайлыИсходников() Цикл
		Если ЭтоЖелудьСВнедрениями(Исходники.Текст(Файл.ПолноеИмя)) Тогда
			Желуди.Вставить(Новый Файл(Файл.ПолноеИмя).ИмяБезРасширения, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Желуди;

КонецФункции

// Аннотация класса к делу не относится: внедряет ОСень по аннотациям ПАРАМЕТРОВ, а носит
// класс &Желудь, &Рогатка, &Дуб или &Контроллер winow — вопрос его роли, не зависимостей.
// Отбор по аннотации класса выбрасывал из-под сторожа полсотни контроллеров и единственный
// в проекте &Дуб — конфигурацию хранилища с восемью детальками.
Функция ЭтоЖелудьСВнедрениями(Знач Текст) Экспорт
	Возврат ЕстьВнедрения(ПараметрыКонструктора(ПлоскийИсходник(Текст)));
КонецФункции

// Места файла, где желудь создаётся оператором «Новый» вместо инъекции.
//
// Параметры:
//  Текст - Строка - исходник класса.
//  Желуди - Соответствие - имя класса-желудя → Истина.
//
// Возвращаемое значение:
//  Массив из Строка - имена созданных напрямую желудей.
//
Функция ПрямыеСоздания(Знач Текст, Знач Желуди) Экспорт

	ПоИмени = Новый Соответствие();
	Для Каждого КиЗ Из Желуди Цикл
		ПоИмени.Вставить(НРег(КиЗ.Ключ), КиЗ.Ключ);
	КонецЦикла;

	Плоский = ПлоскийИсходник(Текст);
	Найденные = Новый Массив();
	Оператор = "новый";

	Позиция = СтрНайти(Плоский, Оператор);
	Пока Позиция > 0 Цикл

		// «новый» — самостоятельное слово, а не начало имени: параметр НовыйКлиентHTTP
		// оператором создания не является
		Граница = НЕ ЧастьИмени(Сред(Плоский, Позиция - 1, 1))
			И НЕ ЧастьИмени(Сред(Плоский, Позиция + СтрДлина(Оператор), 1));

		Если Граница Тогда
			Хвост = СокрЛ(Сред(Плоский, Позиция + СтрДлина(Оператор)));
			Если Лев(Хвост, 1) = "(" Тогда
				// имя класса выражением: чей это желудь, по тексту не узнать, поэтому
				// форма запрещена целиком — иначе сканер снимается одной переменной
				Найденные.Добавить("Новый(<имя выражением>)");
			Иначе
				Имя = ПоИмени[ПервоеИмя(Хвост)];
				Если Имя <> Неопределено Тогда
					Найденные.Добавить(Имя);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		Позиция = СтрНайти(Плоский, Оператор, , Позиция + 1);

	КонецЦикла;

	Возврат Найденные;

КонецФункции

// Внедряет ОСень по аннотациям параметров конструктора — они и есть критерий. &Лог здесь
// наравне с остальными: он тоже внедряется, и созданный напрямую объект получает дефолтный
// логгер вместо контейнерного — ИздательСобытий про это прямо и написал.
Функция ЕстьВнедрения(Знач Параметры)
	Возврат СтрНайти(Параметры, "&пластилин") > 0 ИЛИ СтрНайти(Параметры, "&деталька") > 0
		ИЛИ СтрНайти(Параметры, "&завязь") > 0 ИЛИ СтрНайти(Параметры, "&лог") > 0;
КонецФункции

Функция ПервоеИмя(Знач Хвост)

	Длина = 0;
	Пока Длина < СтрДлина(Хвост) И ЧастьИмени(Сред(Хвост, Длина + 1, 1)) Цикл
		Длина = Длина + 1;
	КонецЦикла;

	Возврат Лев(Хвост, Длина);

КонецФункции

// Список параметров ПриСозданииОбъекта на УПЛОЩЁННОМ исходнике: без уплощения упоминание
// «ПриСозданииОбъекта(» внутри строкового литерала уводит разбор на себя, и класс тихо
// выпадает из списка — сканер literal-aware, построитель списка обязан быть таким же.
// Имя ищется КАК ИМЯ, а не как подстрока: пробел перед скобкой законен, а суффикс чужого
// метода (ЗаписатьПриСозданииОбъекта) конструктором не является.
Функция ПараметрыКонструктора(Знач Текст)

	Заголовок = "присозданииобъекта";

	Позиция = СтрНайти(Текст, Заголовок);
	Пока Позиция > 0 Цикл

		Слева = ?(Позиция > 1, Сред(Текст, Позиция - 1, 1), " ");
		Хвост = СокрЛ(Сред(Текст, Позиция + СтрДлина(Заголовок)));
		Если НЕ ЧастьИмени(Слева) И Лев(Хвост, 1) = "(" Тогда
			Возврат ДоПарнойСкобки(Хвост);
		КонецЕсли;

		Позиция = СтрНайти(Текст, Заголовок, , Позиция + 1);

	КонецЦикла;

	Возврат "";

КонецФункции

// Внутри списка параметров свои скобки: аннотации пишутся как &Пластилин(Значение = "Имя").
Функция ДоПарнойСкобки(Знач Хвост)

	Глубина = 0;
	Для Индекс = 1 По СтрДлина(Хвост) Цикл
		Символ = Сред(Хвост, Индекс, 1);
		Если Символ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = ")" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				Возврат Лев(Хвост, Индекс);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Хвост;

КонецФункции

// Плоский исходник: без комментариев и содержимого литералов, в нижнем регистре, любой
// пропуск — один пробел. Перенос строки и таб разделяют «Новый» и имя класса ровно так же,
// как пробел, а скобки после имени необязательны — обе формы валидный OneScript.
Функция ПлоскийИсходник(Знач Текст)

	Строки = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(БезКомментариев(Текст), Символы.ПС) Цикл
		Строки.Добавить(БезЛитералов(Строка_));
	КонецЦикла;

	Плоский = СтрСоединить(Строки, " ");
	Плоский = СтрЗаменить(СтрЗаменить(Плоский, Символы.Таб, " "), Символы.ВК, " ");

	Возврат " " + НРег(СтрСоединить(СтрРазделить(Плоский, " ", Ложь), " ")) + " ";

КонецФункции

// Содержимое строковых литералов — не код: «Новый ИмяОбъектаАудита» в тексте сообщения
// созданием не является.
Функция БезЛитералов(Знач Строка_)

	Части = СтрРазделить(Строка_, """", Истина);
	Снаружи = Новый Массив();
	Для Индекс = 0 По Части.ВГраница() Цикл
		Снаружи.Добавить(?(Индекс % 2 = 0, Части[Индекс], ""));
	КонецЦикла;

	Возврат СтрСоединить(Снаружи, """");

КонецФункции

Функция ЧастьИмени(Знач Символ)
	Возврат ЗначениеЗаполнено(Символ)
		И СтрНайти("абвгдеёжзийклмнопрстуфхцчшщъыьэюяabcdefghijklmnopqrstuvwxyz0123456789_",
			НРег(Символ)) > 0;
КонецФункции

Функция БезКомментариев(Знач Текст)

	Строки = Новый Массив();

	Для Каждого Строка_ Из СтрРазделить(Текст, Символы.ПС) Цикл
		Если СтрНачинаетсяС(СокрЛП(Строка_), "|") Тогда
			Строки.Добавить(ХвостПродолженияЛитерала(Строка_));
		Иначе
			Строки.Добавить(БезКомментария(Строка_));
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Строка-продолжение многострочного литерала: до ЗАКРЫВАЮЩЕЙ кавычки — текст литерала,
// а после неё на той же строке законно стоит код. Обнулять такую строку целиком значит
// стирать этот код раньше, чем его увидит сканер. Кавычки нет — строка вся внутри литерала.
Функция ХвостПродолженияЛитерала(Знач Строка_)

	Позиция = 1;
	Длина = СтрДлина(Строка_);

	Пока Позиция <= Длина Цикл
		Если Сред(Строка_, Позиция, 1) = """" Тогда
			// удвоенная кавычка — экранированная внутри литерала, а не его конец
			Если Сред(Строка_, Позиция + 1, 1) = """" Тогда
				Позиция = Позиция + 2;
				Продолжить;
			КонецЕсли;
			Возврат БезКомментария(Сред(Строка_, Позиция + 1));
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция БезКомментария(Знач Строка_)

	ВЛитерале = Ложь;

	Для Позиция = 1 По СтрДлина(Строка_) Цикл
		Символ = Сред(Строка_, Позиция, 1);
		Если Символ = """" Тогда
			ВЛитерале = НЕ ВЛитерале;
		ИначеЕсли НЕ ВЛитерале И Символ = "/" И Сред(Строка_, Позиция + 1, 1) = "/" Тогда
			Возврат Лев(Строка_, Позиция - 1);
		КонецЕсли;
	КонецЦикла;

	Возврат Строка_;

КонецФункции

#КонецОбласти

#Область Корпус

// Имена, под которыми ОСень знает желуди хаба: класс, прозвище, завязь либо желудь
// чужой библиотеки.
Функция ИзвестныеИменаЖелудей()

	Известные = Новый Соответствие();

	Для Каждого КиЗ Из ЖелудиБиблиотек() Цикл
		Известные.Вставить(КиЗ.Ключ, Истина);
	КонецЦикла;

	Для Каждого КиЗ Из КлассыБиблиотек() Цикл
		Известные.Вставить(КиЗ.Ключ, Истина);
	КонецЦикла;

	Для Каждого Файл Из ФайлыИсходников() Цикл

		Известные.Вставить(Файл.ИмяБезРасширения, Истина);

		Текст = Исходники.Текст(Файл.ПолноеИмя);
		Для Каждого Имя Из ИменаИзАннотации(Текст, "&Прозвище") Цикл
			Известные.Вставить(Имя, Истина);
		КонецЦикла;
		Для Каждого Имя Из ИменаИзАннотации(Текст, "&Завязь") Цикл
			Известные.Вставить(Имя, Истина);
		КонецЦикла;

	КонецЦикла;

	Возврат Известные;

КонецФункции

Функция СборщикиКонтейнера()

	Файлы = Новый Массив();
	Каталоги = Новый Массив();
	Каталоги.Добавить(ОбъединитьПути(КаталогПроекта, "src"));
	Каталоги.Добавить(ОбъединитьПути(КаталогПроекта, "tools"));
	Каталоги.Добавить(ОбъединитьПути(КаталогПроекта, "scripts"));

	Для Каждого Каталог Из Каталоги Цикл
		Для Каждого Найденный Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
			Если Найденный.ЭтоФайл() И СтрНайти(Исходники.Текст(Найденный.ПолноеИмя), "Новый Поделка(") > 0 Тогда
				Файлы.Добавить(Найденный);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Файлы;

КонецФункции

Функция ФайлыИсходников()

	Файлы = Новый Массив();

	Для Каждого Найденный Из НайтиФайлы(ОбъединитьПути(КаталогПроекта, "src"), "*.os", Истина) Цикл
		Если Найденный.ЭтоФайл() Тогда
			Файлы.Добавить(Найденный);
		КонецЕсли;
	КонецЦикла;

	Возврат Файлы;

КонецФункции

Функция ЭтоЗаконноеИсключение(Знач Файл)

	Путь = ОтносительныйПутьБезРасширения(Файл);

	Для Каждого Законный Из ЗаконныеИсключения() Цикл
		Если Путь = Законный Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ОтносительныйПутьБезРасширения(Знач Файл)

	Путь = Исходники.ОтносительныйПуть(Файл.ПолноеИмя);

	Возврат Лев(Путь, СтрДлина(Путь) - СтрДлина(Файл.Расширение));

КонецФункции

Функция ЕстьВКорпусе(Знач ИмяФайла)

	Для Каждого Файл Из ФайлыИсходников() Цикл
		Если Файл.Имя = ИмяФайла Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Порт открывается РАНЬШЕ, чем закрываются гейты фоновых стартовых задач, поэтому
// /ready сразу после /health законно отвечает 503 (балансировщик на то и опрашивает).
// Один запрос здесь проверял бы не сборку контейнера, а расторопность доставщика подписок.
//
// Параметры:
//  ТаймаутСек - Число - предел ожидания готовности.
//
// Возвращаемое значение:
//  Структура - Код (Число, 0 — ни одного ответа), Ответ (Строка) последней попытки.
//
Функция ДождатьсяГотовности(Знач ТаймаутСек)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСек * 1000;
	Код = 0;
	ТелоОтвета = "";

	Пока Истина Цикл

		Попытка
			Ответ = Запрос("/ready");
			Код = Ответ.КодСостояния;
			ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
		Исключение
			Код = 0;
			ТелоОтвета = ОписаниеОшибки();
		КонецПопытки;

		Если Код = 200 ИЛИ ТекущаяУниверсальнаяДатаВМиллисекундах() >= Крайний Тогда
			Прервать;
		КонецЕсли;

		Приостановить(200);

	КонецЦикла;

	Возврат Новый Структура("Код, Ответ", Код, ТелоОтвета);

КонецФункции

Функция Запрос(Знач Путь)

	Возврат Новый HTTPСоединение("localhost", Порт, , , , 15).Получить(Новый HTTPЗапрос(Путь));

КонецФункции

// Экран, который отдаётся без сессии и без наполненной базы: форма входа.
Функция СтраницаБезВхода()
	Возврат "/login";
КонецФункции

// Цвет заметный и ничей: совпасть с палитрой темы он не может, поэтому его появление
// в разметке означает ровно одно — оформление пришло из настроек инсталляции.
Функция АкцентИнсталляции()
	Возврат "#123456";
КонецФункции

#КонецОбласти
