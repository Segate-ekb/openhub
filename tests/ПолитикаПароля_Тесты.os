// Юнит-тесты ПолитикаПароля: границы длины, anti-DoS-лимит хеширования, требования
// к классам символов, дефолты и человекочитаемые формулировки требований.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КлассыВхода;

&ТестовыйНабор(Характер = "Одиночка")
&Изолированный(Уровень = "Процесс")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура Подключить() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	// сервисы auth пишут журнал через ИмяОбъектаАудита — без него их желуди не собираются
	Попытка
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"),
			"ИмяОбъектаАудита");
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "СобытиеАудита.os"),
			"СобытиеАудита");
		ПодключитьСценарий(ОбъединитьПути(Модули, "основа", "Классы", "ТекстJSON.os"),
			"ТекстJSON");
		ПодключитьСценарий(ОбъединитьПути(Модули, "основа", "Классы", "ТекстОшибки.os"),
			"ТекстОшибки");
	Исключение
	КонецПопытки;
	КлассыВхода = ОбъединитьПути(Модули, "вход", "Классы");
	ПоискКлассов.Подключить(Модули, "ПолитикаПароля");
	РеестрФикстур.Подключить("НастройкиЗаглушка");
КонецПроцедуры

// --- дефолты (не слабее прежней политики: мин 8, макс 256, без классов) ---

&Тест
Процедура ДефолтныйМинимумВосемь() Экспорт
	Политика = Дефолтная();
	Ожидаем.Что(Политика.МинДлина(), "дефолтный минимум").Равно(8);
	Ожидаем.Что(Политика.МаксДлина(), "дефолтный максимум").Равно(256);
	Ожидаем.Что(Отклонён(Политика, "short7x"), "7 символов отклонены").ЭтоИстина(); // 7 символов
	Ожидаем.Что(Политика.Допустим("passw0rd"), "8 символов приняты").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ДефолтБезТребованийКлассов() Экспорт
	Политика = Дефолтная();
	// чисто строчный пароль без цифр — при дефолте допустим (безопасность не ослаблена,
	// но и не ужесточена относительно прежнего поведения)
	Ожидаем.Что(Политика.Допустим("passwordonly"), "дефолт не требует классов").ЭтоИстина();
КонецПроцедуры

// --- границы длины ---

&Тест
Процедура СлишкомКороткийОтклонён() Экспорт
	Политика = СобратьПолитику(10, 256, Ложь, Ложь, Ложь, Ложь);
	Ожидаем.Что(Отклонён(Политика, "12345678"), "8 < 10 — отклонён").ЭтоИстина();
	Ожидаем.Что(Политика.Допустим("1234567890"), "10 символов — принят").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура СлишкомДлинныйОтклонёнAntiDoS() Экспорт
	Политика = СобратьПолитику(8, 16, Ложь, Ложь, Ложь, Ложь);
	Длинный = "";
	Для Сч = 1 По 20 Цикл
		Длинный = Длинный + "x";
	КонецЦикла;
	Ожидаем.Что(Политика.ПревышаетМаксимум(Длинный), "20 > 16 — превышает лимит").ЭтоИстина();
	Ожидаем.Что(Отклонён(Политика, Длинный), "длинный пароль отклонён Проверить").ЭтоИстина();
	Ожидаем.Что(Политика.ПревышаетМаксимум("shortpwd"), "короткий не превышает").ЭтоЛожь();
КонецПроцедуры

// --- классы символов (единообразно) ---

&Тест
Процедура ТребованиеЦифры() Экспорт
	Политика = СобратьПолитику(8, 256, Ложь, Ложь, Истина, Ложь);
	Ожидаем.Что(Отклонён(Политика, "passwordx"), "без цифры — отклонён").ЭтоИстина();
	Ожидаем.Что(Политика.Допустим("password1"), "с цифрой — принят").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ТребованиеПрописной() Экспорт
	Политика = СобратьПолитику(8, 256, Ложь, Истина, Ложь, Ложь);
	Ожидаем.Что(Отклонён(Политика, "password1"), "без прописной — отклонён").ЭтоИстина();
	Ожидаем.Что(Политика.Допустим("Password1"), "с прописной — принят").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ТребованиеСтрочной() Экспорт
	Политика = СобратьПолитику(8, 256, Истина, Ложь, Ложь, Ложь);
	Ожидаем.Что(Отклонён(Политика, "PASSWORD1"), "без строчной — отклонён").ЭтоИстина();
	Ожидаем.Что(Политика.Допустим("passwORD1"), "со строчной — принят").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ТребованиеСпецсимвола() Экспорт
	Политика = СобратьПолитику(8, 256, Ложь, Ложь, Ложь, Истина);
	Ожидаем.Что(Отклонён(Политика, "password1"), "без спецсимвола — отклонён").ЭтоИстина();
	Ожидаем.Что(Политика.Допустим("password!"), "со спецсимволом — принят").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ВсеКлассыВместе() Экспорт
	Политика = СобратьПолитику(10, 256, Истина, Истина, Истина, Истина);
	Ожидаем.Что(Отклонён(Политика, "Password12"), "нет спецсимвола — отклонён").ЭтоИстина();
	Ожидаем.Что(Политика.Допустим("Passw0rd!x"), "все классы + длина — принят").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ПустойПарольОтклоняется() Экспорт
	Политика = Дефолтная();
	Ожидаем.Что(Политика.Допустим(""), "пустой пароль недопустим").ЭтоЛожь();
	Ожидаем.Что(Отклонён(Политика, ""), "Проверить обязан отказать на пустой строке").ЭтоИстина();
КонецПроцедуры

// --- описание требований для UI/пульта ---

&Тест
Процедура ОписаниеСодержитДлинуИКлассы() Экспорт
	Политика = СобратьПолитику(8, 64, Ложь, Ложь, Истина, Ложь);
	Описание = Политика.ОписаниеОднойСтрокой();
	Ожидаем.Что(СтрНайти(Описание, "8") > 0, "длина в описании").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Описание, "64") > 0, "макс. длина в описании").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Описание, "цифра") > 0, "требование цифры в описании").ЭтоИстина();
	Ожидаем.Что(Политика.Требования().Количество() >= 2, "минимум два требования").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ПравкаПолитикиДействуетНаБлижайшейПроверке() Экспорт

	// ИСТ-ДОСТ-032: изменение действует на ближайшей же проверке пароля, без перезапуска.
	// Снимок, снятый при сборке желудя, эту проверку не прошёл бы
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.auth.password.min_length", 8);
	Настройки.Задать("oshub.auth.password.max_length", 256);
	Настройки.Задать("oshub.auth.password.require_lowercase", Ложь);
	Настройки.Задать("oshub.auth.password.require_uppercase", Ложь);
	Настройки.Задать("oshub.auth.password.require_digit", Ложь);
	Настройки.Задать("oshub.auth.password.require_special", Ложь);
	Политика = Новый ПолитикаПароля(Настройки);

	Ожидаем.Что(Политика.Допустим("passwordo"), "девять букв проходят прежнюю политику").ЭтоИстина();

	Настройки.Задать("oshub.auth.password.min_length", 12);
	Настройки.Задать("oshub.auth.password.require_digit", Истина);

	Ожидаем.Что(Политика.МинДлина(), "минимум перечитан у настроек").Равно(12);
	Ожидаем.Что(Политика.Допустим("passwordo"), "тот же пароль ужесточённую политику не проходит")
		.ЭтоЛожь();
	Ожидаем.Что(Политика.Допустим("passwordo123"), "годный по новой политике принимается").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Политика.ОписаниеОднойСтрокой(), "12") > 0,
		"человеку печатается новая политика: " + Политика.ОписаниеОднойСтрокой()).ЭтоИстина();

КонецПроцедуры

// --- требования с машинными кодами (живая проверка на форме) ---

// Подробный список — тот же список, что печатается словами, но у каждой строки свой код:
// разойтись им нельзя, иначе форма судила бы не то, что обещала.
&Тест
Процедура ПодробныеТребованияИдутВПаруКТекстам() Экспорт

	Политика = СобратьПолитику(12, 64, Истина, Ложь, Истина, Ложь);

	Тексты = Политика.Требования();
	Подробно = Политика.ТребованияПодробно();

	Ожидаем.Что(Подробно.Количество(), "строк столько же, сколько текстов")
		.Равно(Тексты.Количество());

	Коды = Новый Массив();
	Для Номер = 0 По Подробно.ВГраница() Цикл
		Ожидаем.Что(Подробно[Номер].Текст, "текст строки тот же, что и в списке словами")
			.Равно(Тексты[Номер]);
		Коды.Добавить(Подробно[Номер].Код);
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Коды, ","), "коды включённых требований по порядку")
		.Равно("length,lower,digit");
	Ожидаем.Что(Подробно[0].Минимум, "минимум числом").Равно(12);
	Ожидаем.Что(Подробно[0].Максимум, "максимум числом").Равно(64);

КонецПроцедуры

// Подробный список пересобирается на вызове, как и сама политика: ужесточение,
// сделанное администратором, видно на следующей же нарисованной форме.
&Тест
Процедура ПодробныеТребованияПеречитываютсяПослеПравкиПолитики() Экспорт

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.auth.password.min_length", 8);
	Настройки.Задать("oshub.auth.password.max_length", 256);
	Настройки.Задать("oshub.auth.password.require_lowercase", Ложь);
	Настройки.Задать("oshub.auth.password.require_uppercase", Ложь);
	Настройки.Задать("oshub.auth.password.require_digit", Ложь);
	Настройки.Задать("oshub.auth.password.require_special", Ложь);
	Политика = Новый ПолитикаПароля(Настройки);

	Ожидаем.Что(Политика.ТребованияПодробно().Количество(),
		"пока требование одно — длина").Равно(1);

	Настройки.Задать("oshub.auth.password.require_special", Истина);
	Настройки.Задать("oshub.auth.password.min_length", 16);

	Подробно = Политика.ТребованияПодробно();
	Ожидаем.Что(Подробно.Количество(), "требований стало двое").Равно(2);
	Ожидаем.Что(Подробно[1].Код, "второе — спецсимвол").Равно("special");
	Ожидаем.Что(Подробно[0].Минимум, "и минимум новый").Равно(16);

КонецПроцедуры

// --- служебное ---

Функция Дефолтная()
	Возврат СобратьПолитику(8, 256, Ложь, Ложь, Ложь, Ложь);
КонецФункции

// Политика поверх заглушки настроек: боевой путь читает те же ключи у СервисНастроек.
Функция СобратьПолитику(Знач МинДлина, Знач МаксДлина, Знач Строчная, Знач Прописная, Знач Цифра,
	Знач Спец)

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.auth.password.min_length", МинДлина);
	Настройки.Задать("oshub.auth.password.max_length", МаксДлина);
	Настройки.Задать("oshub.auth.password.require_lowercase", Строчная);
	Настройки.Задать("oshub.auth.password.require_uppercase", Прописная);
	Настройки.Задать("oshub.auth.password.require_digit", Цифра);
	Настройки.Задать("oshub.auth.password.require_special", Спец);
	Возврат Новый ПолитикаПароля(Настройки);

КонецФункции

Функция Отклонён(Знач Политика, Знач Пароль)
	Попытка
		Политика.Проверить(Пароль);
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;
КонецФункции
