// Юнит-тесты СервисВходаCLI: выдача пары кодов, одобрение и отказ человеком, опрос
// клиентом, срок жизни заявки, интервал опроса, сгорание по перебору и уникальность кода.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать pwhash
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("данные", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("реестр", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("события", "Классы")));

	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();

	// сервисы auth пишут журнал через ИмяОбъектаАудита — без него их желуди не собираются
	Попытка
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"),
			"ИмяОбъектаАудита");
	Исключение
	КонецПопытки;
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("вход", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("права", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, ОбъединитьПути("настройки", "Классы")));
	ПодключитьСервисы(ОбъединитьПути(Модули, "интерфейс", "Классы", "настройки"));

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "вход-cli-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

#Область СчастливыйПуть

&Тест
Процедура ЦиклИнициацияОдобрениеОпросДаётРабочийТокен() Экспорт

	Сервис = СервисВхода();
	Момент = Дата(2026, 8, 1, 10, 0, 0);

	Выдача = Сервис.НачатьЗаявку("opm 1.6.6 на laptop", "read,write", Момент);

	Ожидаем.Что(СтрДлина(Выдача.КодУстройства) >= 48, "device_code не короче 48 знаков").ЭтоИстина();
	Ожидаем.Что(СтрДлина(Выдача.КодПользователя), "user_code вида XXXX-XXXX").Равно(9);
	Ожидаем.Что(Выдача.Заявка.Статус).Равно(Сервис.СтатусОжидание());

	Ожидаем.Что(Сервис.Опросить(Выдача.КодУстройства, Момент).Статус,
		"до решения человека — ожидание").Равно("ожидание");

	Одобрение = Сервис.Одобрить(Выдача.КодПользователя, Пользователь().Идентификатор, Момент);
	Ожидаем.Что(Одобрение.Успех, "одобрение принято").ЭтоИстина();

	Исход = Сервис.Опросить(Выдача.КодУстройства, Момент + 10);
	Ожидаем.Что(Исход.Статус, "после одобрения токен выдан").Равно("выдан");
	Ожидаем.Что(Исход.Права).Равно("read,write");
	Ожидаем.Что(СтрНачинаетсяС(Исход.ЗначениеТокена, "oshub_"), "выдан именно PAT").ЭтоИстина();

	Проверка = Желудь("СервисТокенов").РезультатПроверки(Исход.ЗначениеТокена, Момент + 20).Проверка;
	Ожидаем.Что(Проверка, "выданный токен проходит проверку").Существует();
	Ожидаем.Что(Проверка.ПользовательИдентификатор, "токен принадлежит одобрившему")
		.Равно(Пользователь().Идентификатор);
	Ожидаем.Что(Проверка.Запись.Имя, "имя токена называет происхождение")
		.Равно("opm CLI — opm 1.6.6 на laptop");

КонецПроцедуры

&Тест
Процедура ВыданныйCLIТокенЖивётСрокИзНастроекХаба() Экспорт

	Сервис = СервисВхода();
	СервисТокенов = Желудь("СервисТокенов");
	СрокДней = СервисТокенов.СрокПоУмолчаниюДней();
	Момент = Дата(2026, 8, 1, 21, 0, 0);

	Выдача = Сервис.НачатьЗаявку("opm", "read", Момент);
	Сервис.Одобрить(Выдача.КодПользователя, Пользователь().Идентификатор, Момент);
	Выпуск = Сервис.Опросить(Выдача.КодУстройства, Момент + 10);

	Запись = СервисТокенов.РезультатПроверки(Выпуск.ЗначениеТокена).Проверка.Запись;
	Ожидаемое = ТекущаяУниверсальнаяДата() + СрокДней * 86400;

	Ожидаем.Что(СрокДней, "срок opm login — дефолт хаба").Равно(7);
	Ожидаем.Что(ЗначениеЗаполнено(Запись.Истекает), "у ключа opm login есть дата истечения").ЭтоИстина();
	Ожидаем.Что(Запись.Истекает <= Ожидаемое И Запись.Истекает > Ожидаемое - 120,
		СтрШаблон("истекает через %1 дней (истекает %2, ожидали около %3)",
			СрокДней, XMLСтрока(Запись.Истекает), XMLСтрока(Ожидаемое))).ЭтоИстина();

	// ключ живёт ровно до срока: за день до — пускает, через день после — уже нет
	Ожидаем.Что(СервисТокенов.РезультатПроверки(Выпуск.ЗначениеТокена,
		Запись.Истекает - 86400).Проверка, "до срока ключ действует").Существует();
	Ожидаем.Что(СервисТокенов.РезультатПроверки(Выпуск.ЗначениеТокена,
		Запись.Истекает + 86400).Проверка, "после срока ключ мёртв").Равно(Неопределено);

	// сама граница: в секунду истечения ключ уже не действует, лишнего интервала нет
	Ожидаем.Что(СервисТокенов.РезультатПроверки(Выпуск.ЗначениеТокена, Запись.Истекает - 1).Проверка,
		"за секунду до истечения ключ ещё жив").Существует();
	Ожидаем.Что(СервисТокенов.РезультатПроверки(Выпуск.ЗначениеТокена, Запись.Истекает).Проверка,
		"в момент истечения ключ уже мёртв").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СырогоСекретаКлиентаВЗаявкеНет() Экспорт

	Сервис = СервисВхода();
	Выдача = Сервис.НачатьЗаявку("opm", "read");

	Ожидаем.Что(Выдача.Заявка.ХешКодаУстройства = Выдача.КодУстройства,
		"в базе лежит хеш, а не сам device_code").ЭтоЛожь();
	Ожидаем.Что(СтрДлина(Выдача.Заявка.ХешКодаУстройства), "sha256 в hex").Равно(64);

КонецПроцедуры

#КонецОбласти

#Область ОтказыИСроки

&Тест
Процедура ОтклонённаяЗаявкаОтдаётОтказИНеОживает() Экспорт

	Сервис = СервисВхода();
	Момент = Дата(2026, 8, 1, 11, 0, 0);
	Выдача = Сервис.НачатьЗаявку("opm", "read", Момент);

	Ожидаем.Что(Сервис.Отклонить(Выдача.КодПользователя, Момент).Успех).ЭтоИстина();
	Ожидаем.Что(Сервис.Опросить(Выдача.КодУстройства, Момент + 10).Статус).Равно("отклонена");

	Повтор = Сервис.Одобрить(Выдача.КодПользователя, Пользователь().Идентификатор, Момент + 20);
	Ожидаем.Что(Повтор.Успех, "отказ терминален: одобрить после него нельзя").ЭтоЛожь();
	Ожидаем.Что(Сервис.Опросить(Выдача.КодУстройства, Момент + 30).Статус).Равно("отклонена");

КонецПроцедуры

&Тест
Процедура ИстёкшаяЗаявкаНеОдобряетсяИНеВыдаётТокен() Экспорт

	Сервис = СервисВхода();
	Момент = Дата(2026, 8, 1, 12, 0, 0);
	Выдача = Сервис.НачатьЗаявку("opm", "read", Момент);
	После = Момент + Сервис.СрокЖизниСек() + 1;

	Ожидаем.Что(Сервис.ЖиваяЗаявкаПоКоду(Выдача.КодПользователя, После),
		"истёкшая заявка по коду не находится").Равно(Неопределено);
	Ожидаем.Что(Сервис.Одобрить(Выдача.КодПользователя, Пользователь().Идентификатор, После).Успех)
		.ЭтоЛожь();
	Ожидаем.Что(Сервис.Опросить(Выдача.КодУстройства, После).Статус).Равно("истекла");

КонецПроцедуры

&Тест
Процедура ОдобреннаяНоНеЗабраннаяЗаявкаСгораетПоСроку() Экспорт

	Сервис = СервисВхода();
	Момент = Дата(2026, 8, 1, 12, 30, 0);
	Выдача = Сервис.НачатьЗаявку("opm", "read", Момент);
	Сервис.Одобрить(Выдача.КодПользователя, Пользователь().Идентификатор, Момент);

	Ожидаем.Что(Сервис.Опросить(Выдача.КодУстройства, Момент + Сервис.СрокЖизниСек() + 1).Статус,
		"висящее одобрение не переживает срок заявки").Равно("истекла");

КонецПроцедуры

&Тест
Процедура ПовторныйОпросПослеВыдачиТокенаНеПовторяет() Экспорт

	Сервис = СервисВхода();
	Момент = Дата(2026, 8, 1, 13, 0, 0);
	Выдача = Сервис.НачатьЗаявку("opm", "read", Момент);
	Сервис.Одобрить(Выдача.КодПользователя, Пользователь().Идентификатор, Момент);

	Первый = Сервис.Опросить(Выдача.КодУстройства, Момент + 10);
	Ожидаем.Что(Первый.Статус).Равно("выдан");

	Второй = Сервис.Опросить(Выдача.КодУстройства, Момент + 20);
	Ожидаем.Что(Второй.Статус, "заявка одноразовая").Равно("истекла");
	Ожидаем.Что(Второй.ЗначениеТокена, "второй раз токен не отдаётся").Равно("");

КонецПроцедуры

&Тест
Процедура НеизвестныйКодУстройстваНичегоНеОткрывает() Экспорт

	Сервис = СервисВхода();
	Момент = Дата(2026, 8, 1, 14, 0, 0);
	Выдача = Сервис.НачатьЗаявку("opm", "read", Момент);
	Сервис.Одобрить(Выдача.КодПользователя, Пользователь().Идентификатор, Момент);

	Ожидаем.Что(Сервис.Опросить("00000000000000000000000000000000", Момент + 10).Статус)
		.Равно("истекла");
	Ожидаем.Что(Сервис.Опросить("", Момент + 10).Статус).Равно("истекла");
	Ожидаем.Что(Сервис.Опросить(Выдача.КодПользователя, Момент + 10).Статус,
		"код человека вместо секрета клиента токена не даёт").Равно("истекла");

КонецПроцедуры

&Тест
Процедура ЧастыйОпросПолучаетПросьбуЗамедлиться() Экспорт

	Сервис = СервисВхода();
	Момент = Дата(2026, 8, 1, 15, 0, 0);
	Выдача = Сервис.НачатьЗаявку("opm", "read", Момент);

	Ожидаем.Что(Сервис.Опросить(Выдача.КодУстройства, Момент).Статус).Равно("ожидание");
	Ожидаем.Что(Сервис.Опросить(Выдача.КодУстройства, Момент + 1).Статус,
		"опрос раньше интервала").Равно("часто");
	Ожидаем.Что(Сервис.Опросить(Выдача.КодУстройства, Момент + 1 + Сервис.ИнтервалОпросаСек()).Статус,
		"выждавший интервал опрос снова обычный").Равно("ожидание");

КонецПроцедуры

&Тест
Процедура ПереборПопытокСжигаетЗаявку() Экспорт

	Сервис = СервисВхода();
	Момент = Дата(2026, 8, 1, 16, 0, 0);
	Выдача = Сервис.НачатьЗаявку("opm", "read", Момент);

	Для НомерПопытки = 1 По Сервис.ПорогПопыток() - 1 Цикл
		Ожидаем.Что(Сервис.ЗафиксироватьНеудачу(Выдача.Заявка),
			"до порога заявка жива").ЭтоЛожь();
	КонецЦикла;

	Ожидаем.Что(Сервис.ЗафиксироватьНеудачу(Выдача.Заявка), "на пороге заявка сгорает").ЭтоИстина();
	Ожидаем.Что(Сервис.Одобрить(Выдача.КодПользователя, Пользователь().Идентификатор, Момент).Успех,
		"сгоревшую заявку одобрить нельзя").ЭтоЛожь();
	Ожидаем.Что(Сервис.Опросить(Выдача.КодУстройства, Момент + 10).Статус).Равно("отклонена");

КонецПроцедуры

#КонецОбласти

#Область КодыИПрава

&Тест
Процедура ДубльКодаПользователяОтвергаетсяСервисом() Экспорт

	Сервис = СервисВхода();
	Момент = Дата(2026, 8, 1, 17, 0, 0);
	Выдача = Сервис.НачатьЗаявку("opm", "read", Момент);

	Ожидаем.Что(Сервис.КодСвободен(Выдача.КодПользователя, Момент),
		"код живой заявки занят").ЭтоЛожь();

	Отказ = "";
	Попытка
		Сервис.ЗарегистрироватьЗаявку(Выдача.КодПользователя, "второй клиент", "read", Момент);
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Отказ), "повторная заявка с тем же кодом — исключение").ЭтоИстина();
	Ожидаем.Что(Сервис.КодСвободен(Выдача.КодПользователя, Момент + Сервис.СрокЖизниСек() + 1),
		"после истечения код снова свободен").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КодыРазныеИзАлфавитаБезДвусмысленностей() Экспорт

	Сервис = СервисВхода();
	Момент = Дата(2026, 8, 1, 18, 0, 0);
	Виденные = Новый Соответствие();

	Для Счётчик = 1 По 30 Цикл
		Код = Сервис.НачатьЗаявку("opm", "read", Момент).КодПользователя;
		Ожидаем.Что(Виденные.Получить(Код), "коды заявок не повторяются").Равно(Неопределено);
		Виденные.Вставить(Код, Истина);

		Ожидаем.Что(СтрДлина(СтрЗаменить(Код, "-", "")), "восемь значащих знаков").Равно(8);
		Для Каждого Двусмысленный Из СтрРазделить("0|O|1|I|L", "|") Цикл
			Ожидаем.Что(СтрНайти(Код, Двусмысленный),
				СтрШаблон("знак %1 в коде %2", Двусмысленный, Код)).Равно(0);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура КодЧитаетсяВЛюбойЗаписи() Экспорт

	Сервис = СервисВхода();
	Момент = Дата(2026, 8, 1, 19, 0, 0);
	Выдача = Сервис.НачатьЗаявку("opm", "read", Момент);
	Значащие = СтрЗаменить(Выдача.КодПользователя, "-", "");

	Ожидаем.Что(Сервис.ЖиваяЗаявкаПоКоду(НРег(Значащие), Момент), "нижний регистр без дефиса")
		.Существует();
	Ожидаем.Что(Сервис.ЖиваяЗаявкаПоКоду(" " + Выдача.КодПользователя + " ", Момент), "с пробелами")
		.Существует();
	Ожидаем.Что(Сервис.ЖиваяЗаявкаПоКоду("ABC", Момент), "огрызок кода").Равно(Неопределено);
	Ожидаем.Что(Сервис.НормализоватьКод("0OIL"), "знаки вне алфавита кодом не являются").Равно("");

КонецПроцедуры

&Тест
Процедура ПраваПриводятсяКИзвестнымСкоупам() Экспорт

	Сервис = СервисВхода();

	Ожидаем.Что(Сервис.НормализоватьПрава("")).Равно("read");
	Ожидаем.Что(Сервис.НормализоватьПрава("write, read")).Равно("read,write");
	Ожидаем.Что(Сервис.НормализоватьПрава("READ")).Равно("read");
	Ожидаем.Что(Сервис.НормализоватьПрава("admin"), "неизвестный скоуп не проходит").Равно("");

	Отказ = "";
	Попытка
		Сервис.НачатьЗаявку("opm", "admin");
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(ЗначениеЗаполнено(Отказ), "заявка с неизвестным правом не заводится").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ИмяКлиентаЧиститсяИОбрезается() Экспорт

	Сервис = СервисВхода();
	Длинное = "";
	Пока СтрДлина(Длинное) < 200 Цикл
		Длинное = Длинное + "opm-";
	КонецЦикла;

	Ожидаем.Что(Сервис.ОчиститьИмяКлиента("opm" + Символы.ПС + "1.6.6"),
		"перенос строки из имени убран").Равно("opm1.6.6");
	Ожидаем.Что(СтрДлина(Сервис.ОчиститьИмяКлиента(Длинное)) <= 64, "имя обрезано").ЭтоИстина();
	Ожидаем.Что(Сервис.ИмяТокена(""), "клиент без имени всё равно опознаваем").Равно("opm CLI");

КонецПроцедуры

#КонецОбласти

#Область Чистка

&Тест
Процедура ЧисткаУдаляетТолькоПросроченныеЗаявки() Экспорт

	Сервис = СервисВхода();
	Старт = Дата(2026, 8, 1, 20, 0, 0);

	Старая = Сервис.НачатьЗаявку("старый клиент", "read", Старт);
	Живая = Сервис.НачатьЗаявку("живой клиент", "read", Старт + Сервис.СрокЖизниСек());

	Граница = Старт + Сервис.СрокЖизниСек() + 1;
	Ожидаем.Что(Сервис.УдалитьПросроченные(Граница) >= 1, "просроченная заявка удалена").ЭтоИстина();

	Ожидаем.Что(Сервис.Опросить(Старая.КодУстройства, Граница).Статус).Равно("истекла");
	Ожидаем.Что(Сервис.ЖиваяЗаявкаПоКоду(Живая.КодПользователя, Граница),
		"живая заявка чисткой не тронута").Существует();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СервисВхода()
	Возврат Желудь("СервисВходаCLI");
КонецФункции

// Один подопытный пользователь на набор: заявки к нему не привязаны до одобрения.
Функция Пользователь()

	Логин = "clitester";
	Найденный = Желудь("СервисПользователей").НайтиПоЛогину(Логин);
	Если Найденный <> Неопределено Тогда
		Возврат Найденный;
	КонецЕсли;

	Возврат Желудь("СервисПользователей").СоздатьПользователя(Логин, "cli@example.com",
		"password123", "user");

КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Процедура ПодключитьСервисы(Знач КаталогКлассов)
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		Если СтрНачинаетсяС(ФайлКласса.ИмяБезРасширения, "Контроллер") Тогда
			Продолжить; // контроллерам нужен winow, в юнит-контейнере не подключаем
		КонецЕсли;
		ПоискКлассов.ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
