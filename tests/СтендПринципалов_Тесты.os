// Самотест фикстуры СтендПринципалов: на ней стоят гварды доступа и гейт ключа полутора
// десятков наборов. Принципал «своей формы» — с недостающим или лишним полем — уводит
// их мимо продукта молча: гвард судит не то, что судил бы на живом запросе.
// Проверяется не структура сама по себе, а то, ЧТО СКАЖУТ О НЕЙ гварды хаба, и то, что
// форма ручного принципала совпадает с формой принципала живого запроса.
// Набор в отдельном процессе: второй контейнер ОСени конфликтует с контейнером раннера OneUnit.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать pwhash
#Использовать "фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Слои;          // фикстура СлоиКонтейнера — классы продукта подключаются послойно
Перем Поделка;       // общий контейнер на все тесты набора
Перем Засев;         // фикстура ЗасевРеестра — пул, на который судят рамки ключа
Перем Учётки;        // фикстура СтендУчёток — учётка, от имени которой предъявлен ключ
Перем Стенд;         // фикстура СтендПринципалов — принципал сессии и ключа

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	РеестрФикстур.Подключить("СтендУчёток");
	РеестрФикстур.Подключить("СтендПринципалов");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	РеестрФикстур.Подключить("СлоиКонтейнера");
	Слои = Новый СлоиКонтейнера(ПоискКлассов, Модули);

	ПодключитьСлоиПринципалов(Модули);

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "стенд-принципалов-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	// autumn-properties.json проекта имеет приоритет выше соответствия деталек: файл
	// настроек переименовывается в несуществующий, иначе набор уедет на общую БД
	Совет.ИмяФайлаСоЗначениямиДеталек("стенд-принципалов-properties");
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);
	Учётки = Новый СтендУчёток(Поделка);
	Стенд = Новый СтендПринципалов(Поделка);

КонецПроцедуры

// Судьи принципала и выпуск ключа: гейт ключа и гвард пула живут в слое прав, выпуск
// и опознание ключа — в слое входа, а тот тянет за собой почту, уведомления и реестр.
Процедура ПодключитьСлоиПринципалов(Знач Модули)

	Слои.Подключить("данные");
	Слои.Подключить("хранилище, публикация, реестр, основа, наблюдаемость/телеметрия, события");

	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "СобытиеАудита.os"));

	Слои.Подключить("почта");
	Слои.Подключить("уведомления, вход, права, настройки");

	РеестрФикстур.Подключить("ЗаписывающийПодписчик");

КонецПроцедуры

#Область ФормаПринципала

// Главный сторож фикстуры. Принципал, собранный стендом, обязан иметь те же поля, что
// принципал живого запроса: недостающее поле означает для гварда не «неизвестно»,
// а конкретное значение по умолчанию — например, отсутствие поля Пулы читается гейтом
// ключа как «ключ на весь хаб», и набор про рамки ключа зеленел бы на любых рамках.
&Тест
Процедура ФормаРучногоПринципалаСовпадаетСФормойЖивогоЗапроса() Экспорт

	Хозяин = Учётки.Учётка();

	Ручной = Стенд.Ключ(Хозяин, "read,write");
	Живой = Стенд.КлючСлужбой(Хозяин, "read,write");

	Ожидаем.Что(ПоляПоПорядку(Ручной), "поля принципала стенда").Равно(ПоляПоПорядку(Живой));

КонецПроцедуры

// Дверь «службами хаба» обязана быть настоящей, а не пересказом: ключ, который она
// выпускает, лежит в базе и опознаётся хабом как ключ названной учётки.
&Тест
Процедура ДверьСлужбойВыпускаетНастоящийКлючИОпознаётЕгоВладельца() Экспорт

	Хозяин = Учётки.Учётка();

	Живой = Стенд.КлючСлужбой(Хозяин, "read");

	Ожидаем.Что(Живой.Способ, "запрос предъявлен ключом").Равно("token");
	Ожидаем.Что(Живой.Пользователь, "владелец опознан").Существует();
	Ожидаем.Что(Живой.Пользователь.Идентификатор, "та самая учётка").Равно(Хозяин.Идентификатор);
	Ожидаем.Что(Живой.Права, "названные скоупы дошли до проверки").Равно("read");
	Ожидаем.Что(Живой.ПроблемаТокена, "к ключу у хаба вопросов нет").Равно("");
	Ожидаем.Что(Желудь("СервисТокенов").ТокеныПользователя(Хозяин.Идентификатор).Количество(),
		"ключ лежит в базе").Равно(1);

КонецПроцедуры

// Набор пулов доезжает и через дверь службой: сервис пишет строки привязок, перехватчик
// читает их обратно. Иначе рамки живого ключа судились бы на пустом наборе.
&Тест
Процедура ДверьСлужбойДоноситНаборПулов() Экспорт

	Хозяин = Учётки.Учётка();
	Пул = Засев.Пул();

	Живой = Стенд.КлючСлужбой(Хозяин, "read,write", Пулами(Пул.Идентификатор));

	Ожидаем.Что(Живой.Пулы.Количество(), "набор пулов дошёл до проверки").Равно(1);
	Ожидаем.Что(Живой.Пулы[0], "тот самый пул").Равно(Пул.Идентификатор);
	Ожидаем.Что(Гейт().Проверить(Живой, "создание", Пул.Идентификатор).Разрешено,
		"свой пул живому ключу открыт").ЭтоИстина();
	Ожидаем.Что(Гейт().Проверить(Живой, "создание", Пул.Идентификатор + 1).Разрешено,
		"чужой — закрыт").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область ДверьСессии

// Принципал сессии для гейта ключа прозрачен: сужать выдачу нечем, и любое действие
// на любом пуле ему разрешено. Принципал, у которого способ сбился на «token»,
// закрыл бы сессионному пользователю всё, чего не разрешает пустая строка скоупов.
&Тест
Процедура ПринципалСессииПрозраченДляГейтаКлюча() Экспорт

	Сессия = Стенд.Сессия(Учётки.Учётка());

	Ожидаем.Что(Сессия.Способ, "запрос предъявлен сессией").Равно("session");
	Ожидаем.Что(Гейт().Проверить(Сессия, "удаление", 5).Разрешено,
		"гейт ключа сессии прозрачен").ЭтоИстина();
	Ожидаем.Что(Гейт().Проверить(Сессия, "создание", 0).Разрешено,
		"и на уровне хаба тоже").ЭтоИстина();

КонецПроцедуры

// Учётка — единственный параметр двери, и она обязана доехать: гвард называет её в ответе
// («кто спрашивал»), а витрины по ней отбирают своё.
&Тест
Процедура ДверьСессииДоноситУчёткуИДопускаетАнонима() Экспорт

	Хозяин = Учётки.Учётка();

	Ожидаем.Что(Принципалы().Пользователь(Стенд.Сессия(Хозяин)).Идентификатор,
		"названная учётка дошла до чтения принципала").Равно(Хозяин.Идентификатор);
	Ожидаем.Что(Принципалы().Пользователь(Стенд.Сессия(Неопределено)),
		"аноним читается как «никто», а не падением").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ДверьКлюча

// Скоупы — параметр двери, и гейт ключа судит именно их. Права, потерянные по дороге,
// оставили бы набор про read-only ключ зелёным на полном.
&Тест
Процедура ДверьКлючаДоноситСкоупы() Экспорт

	ТолькоЧтение = Стенд.Ключ(Учётки.Учётка(), "read");

	Ожидаем.Что(ТолькоЧтение.Права, "названные скоупы дошли до принципала").Равно("read");
	Ожидаем.Что(Гейт().Проверить(ТолькоЧтение, "чтение", 5).Разрешено, "read читает").ЭтоИстина();
	Ожидаем.Что(Гейт().Проверить(ТолькоЧтение, "создание", 5).Разрешено, "но не создаёт").ЭтоЛожь();
	Ожидаем.Что(Гейт().Проверить(Стенд.Ключ(Учётки.Учётка()), "создание", 5).Разрешено,
		"скоупы по умолчанию — чтение и запись").ЭтоИстина();

КонецПроцедуры

// Одиночная привязка — параметр двери: ключ пула не открывает соседний пул и уровень хаба.
&Тест
Процедура ДверьКлючаДоноситОдиночнуюПривязку() Экспорт

	Привязанный = Стенд.Ключ(Учётки.Учётка(), "read,write", 7);

	Ожидаем.Что(Гейт().Проверить(Привязанный, "создание", 7).Разрешено, "свой пул").ЭтоИстина();
	Ожидаем.Что(Гейт().Проверить(Привязанный, "чтение", 8).Разрешено, "чужой пул закрыт").ЭтоЛожь();
	Ожидаем.Что(Гейт().Проверить(Привязанный, "создание", 0).Разрешено,
		"и уровень хаба закрыт").ЭтоЛожь();
	Ожидаем.Что(Гейт().Проверить(Стенд.Ключ(Учётки.Учётка()), "создание", 0).Разрешено,
		"привязка по умолчанию не ставится — ключ на весь хаб").ЭтоИстина();

КонецПроцедуры

// Набор пулов — параметр двери, и он судится целиком, а не первым элементом. Набор,
// потерянный по дороге, превратил бы ключ двух пулов в ключ на весь хаб.
&Тест
Процедура ДверьКлючаДоноситНаборПулов() Экспорт

	Двухпуловый = Стенд.Ключ(Учётки.Учётка(), "read,write", 0, Пулами(4, 9));

	Ожидаем.Что(Гейт().Проверить(Двухпуловый, "создание", 4).Разрешено, "первый пул набора").ЭтоИстина();
	Ожидаем.Что(Гейт().Проверить(Двухпуловый, "создание", 9).Разрешено, "второй пул набора").ЭтоИстина();
	Ожидаем.Что(Гейт().Проверить(Двухпуловый, "чтение", 5).Разрешено, "пул вне набора закрыт").ЭтоЛожь();
	Ожидаем.Что(Стенд.Ключ(Учётки.Учётка()).Пулы.Количество(),
		"набор по умолчанию пуст — это «весь хаб»").Равно(0);

КонецПроцедуры

// Учётка — параметр двери и здесь: ключ предъявляется от имени человека, и гвард
// называет его в ответе.
&Тест
Процедура ДверьКлючаДоноситВладельцаИДопускаетАнонима() Экспорт

	Хозяин = Учётки.Учётка();

	Ожидаем.Что(Принципалы().Пользователь(Стенд.Ключ(Хозяин)).Идентификатор,
		"названный владелец дошёл до чтения принципала").Равно(Хозяин.Идентификатор);
	Ожидаем.Что(Принципалы().Пользователь(Стенд.Ключ(Неопределено)),
		"ключ без учётки читается как «никто»").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область ДверьСтаройЗаписи

// Ключи, выпущенные до наборов пулов, поля Пулы не имеют вовсе, и хаб обязан судить их
// по одиночной привязке. Дверь, которая молча дописала бы пустой набор, сделала бы
// проверку легаси проверкой сегодняшней записи.
&Тест
Процедура ДверьСтаройЗаписиНеИмеетПоляНабора() Экспорт

	Старый = Стенд.КлючСтаройЗаписи(Учётки.Учётка(), "read,write", 7);

	Значение = Неопределено;
	Ожидаем.Что(Старый.Свойство("Пулы", Значение), "поля набора у старой записи нет").ЭтоЛожь();
	Ожидаем.Что(Гейт().Проверить(Старый, "создание", 7).Разрешено,
		"старая привязка судится как набор из одного пула").ЭтоИстина();
	Ожидаем.Что(Гейт().Проверить(Старый, "чтение", 8).Разрешено, "чужой пул закрыт").ЭтоЛожь();
	Ожидаем.Что(Гейт().Проверить(Старый, "создание", 0).Разрешено, "уровень хаба закрыт").ЭтоЛожь();

КонецПроцедуры

// Скоупы, привязка и владелец — параметры и этой двери: она отличается от обычной
// отсутствием набора, а не безразличием ко всему остальному.
&Тест
Процедура ДверьСтаройЗаписиДоноситСкоупыПривязкуИВладельца() Экспорт

	Хозяин = Учётки.Учётка();

	ТолькоЧтение = Стенд.КлючСтаройЗаписи(Хозяин, "read", 3);

	Ожидаем.Что(Принципалы().Пользователь(ТолькоЧтение).Идентификатор,
		"владелец дошёл до чтения принципала").Равно(Хозяин.Идентификатор);
	Ожидаем.Что(Гейт().Проверить(ТолькоЧтение, "чтение", 3).Разрешено, "read читает свой пул").ЭтоИстина();
	Ожидаем.Что(Гейт().Проверить(ТолькоЧтение, "изменение", 3).Причина,
		"а писать не даёт — и причина скоуп").Равно("скоуп");
	Ожидаем.Что(Гейт().Проверить(Стенд.КлючСтаройЗаписи(Хозяин), "создание", 0).Разрешено,
		"привязка по умолчанию не ставится").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция Гейт()
	Возврат Желудь("ГейтТокена");
КонецФункции

// Чтение полей принципала глазами продукта: тем же классом их читают гварды.
Функция Принципалы()
	Возврат Желудь("УчёткаПринципала");
КонецФункции

// Имена полей структуры одной строкой в порядке обхода: так расхождение форм видно
// целиком, а не по первому несовпавшему полю.
Функция ПоляПоПорядку(Знач Принципал)

	Имена = Новый Массив();
	Для Каждого КиЗ Из Принципал Цикл
		Имена.Добавить(КиЗ.Ключ);
	КонецЦикла;

	Возврат СтрСоединить(Имена, ",");

КонецФункции

Функция Пулами(Знач Первый, Знач Второй = Неопределено)

	Набор = Новый Массив();
	Набор.Добавить(Первый);
	Если Второй <> Неопределено Тогда
		Набор.Добавить(Второй);
	КонецЕсли;

	Возврат Набор;

КонецФункции

#КонецОбласти
