// Занятое место меняется на каждой публикации и в снимок не входит: его читают у базы.
&Тест
Процедура ЗанятоеМестоЧитаетсяМимоКэша() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Снимок = Пулы().ПулДляЧтения(Пул.Имя);

	Выдача.Желудь("ЗаписьЗанятогоМеста").Учесть(Пул, 4096, "тест");

	Ожидаем.Что(Пулы().ЗанятоБайт(Снимок), "занятое место снимка — свежее").Равно(4096);

КонецПроцедуры

#КонецОбласти

#Область ИсточникиПула

&Тест
Процедура СтрокиИсточниковЧитаютсяИзКэша() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Источники().СтрокиПула(Пулы().ПулДляЧтения(Пул.Имя));

	База.Сбросить();
	Строки = Источники().СтрокиПула(Пулы().ПулДляЧтения(Пул.Имя));

	Ожидаем.Что(Строки.Количество(), "у пула источников нет").Равно(0);
	Ожидаем.Что(Операций(), "пустой ответ — тоже ответ, и он из кэша").Равно(0);

КонецПроцедуры

&Тест
Процедура ЗаведённыйИсточникВиденСразу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	СтрокиИсточников(Пул);

	Источники().Записать(Пул, АдресИсточника("new"));

	Ожидаем.Что(СтрокиИсточников(Пул).Количество(), "заведённый источник виден сразу").Равно(1);

