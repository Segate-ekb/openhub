&Тест
Процедура ВыключенныйИсточникВиденСразу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Источники().Записать(Пул, АдресИсточника("off"));
	Ожидаем.Что(Источники().ДляОпроса(Пулы().ПулДляЧтения(Пул.Имя)).Количество(), "самотест: источник включён")
		.Равно(1);

	Источники().Переключить(Пул.Идентификатор, АдресИсточника("off"), Ложь);

	Ожидаем.Что(Источники().ДляОпроса(Пулы().ПулДляЧтения(Пул.Имя)).Количество(),
		"выключенный источник выдача больше не опрашивает").Равно(0);
	Ожидаем.Что(СтрокиИсточников(Пул).Количество(), "но строка источника у пула осталась").Равно(1);

