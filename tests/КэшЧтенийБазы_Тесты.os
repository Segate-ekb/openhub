#КонецОбласти

#Область Учётки

// Ответ «учёток нет» открывает мастер первого запуска и потому в кэш не кладётся: первая
// же учётка видна сразу. Удалить последнюю учётку хаб не даёт — снятие «есть» по удалению
// наблюдаемо только тем, что кэш не держит ответа «нет».
&Тест
Процедура ПерваяУчёткаВиднаСразуАОтветЕстьИзКэша() Экспорт

	Учётки = Выдача.Желудь("СервисПользователей");
	Ожидаем.Что(Учётки.ЕстьХотяБыОднаУчётка(), "самотест: учёток ещё нет").ЭтоЛожь();
	Ожидаем.Что(Учётки.ЕстьХотяБыОднаУчётка(), "и второй вопрос — тоже «нет»").ЭтоЛожь();

	Учётки.СоздатьПользователя(УникальныеИмена.Имя("first"), "", "FirstPassw0rd!", "admin");

	Ожидаем.Что(Учётки.ЕстьХотяБыОднаУчётка(), "первая учётка видна сразу").ЭтоИстина();
	База.Сбросить();
	Ожидаем.Что(Учётки.ЕстьХотяБыОднаУчётка()).ЭтоИстина();
	Ожидаем.Что(Операций(), "ответ «есть» — из кэша").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Витрина

&Тест
Процедура ПовторноеЧтениеВитриныНеХодитВБазу() Экспорт

	Выпуск = Выдача.Опубликовать("витрина из кэша");
	Пакеты().ПакетыПулаДляЧтения(Выпуск.Пул.Идентификатор);
	СлужбаВерсий().ПоследниеВерсииДляЧтения(10);

	База.Сбросить();
	ПакетыПула = Пакеты().ПакетыПулаДляЧтения(Выпуск.Пул.Идентификатор);
	Пакеты().ПакетыПуловДляЧтения(ОдинПул(Выпуск));
	СлужбаВерсий().ПоследниеВерсииДляЧтения(10);

	Ожидаем.Что(ПакетыПула[0].Имя, "снимок называет пакет").Равно(Выпуск.Пакет.Имя);
	Ожидаем.Что(Операций(), "повторный показ витрины идёт из кэша").Равно(0);

