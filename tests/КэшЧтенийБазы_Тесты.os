// Частые чтения из базы идут из кэша в памяти, а запись через хаб видна следующему же чтению:
// на каждого писателя — «записал, прочитал новое». Кэш держит только неизменяемые снимки
// в общем бюджете памяти, срок жизни выключен: свежесть держит сброс, а не устаревание.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать autumn-cache
#Использовать entity
#Использовать "фикстуры"

Перем Выдача;        // фикстура СтендВыдачи — контейнер, хранилище на фейке S3, маршрут выдачи
Перем Отказы;        // фикстура ЛовушкаЛога — ошибки библиотеки кэша за весь набор
Перем База;          // фикстура СчётчикОбращенийКБазе — обращения к источнику данных

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("СтендВыдачи");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("СчётчикОбращенийКБазе");

	Отказы = Новый ЛовушкаЛога();
	ЖурналКэша = Логирование.ПолучитьЛог("oscript.lib.autumn-cache");
	ЖурналКэша.ДобавитьСпособВывода(Отказы, УровниЛога.Ошибка);

	Детальки = Новый Соответствие();
	Детальки.Вставить("cache.ПределПамяти", 16777216);
	Выдача = Новый СтендВыдачи(Детальки, "кэш-чтений-базы-тесты");

	База = Новый СчётчикОбращенийКБазе();
	Выдача.Желудь("ИсточникДанных").ДобавитьНаблюдателя(База);

КонецПроцедуры

#Область Пулы

&Тест
Процедура ПовторноеЧтениеПулаНеХодитВБазу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Пулы().ПулДляЧтения(Пул.Имя);

	База.Сбросить();
	Снимок = Пулы().ПулДляЧтения(Пул.Имя);
	Пулы().ПулыДляЧтения();
	Пулы().ИмяПулаПоУмолчанию();
	Пулы().ПулыДляЧтения();

	Ожидаем.Что(Снимок.Имя, "снимок называет пул").Равно(Пул.Имя);
	Ожидаем.Что(Снимок.ЭтоЛичный(), "у снимка есть методы пула").ЭтоЛожь();
	Ожидаем.Что(Операций(), "повторное чтение пулов идёт из кэша").Равно(0);

	Пулы().НайтиПул(Пул.Имя);
	Ожидаем.Что(Операций(), "самотест: чтение мимо кэша счётчик видит").Больше(0);

КонецПроцедуры

&Тест
Процедура ЗаведённыйПулВиденСразу() Экспорт

	Имя = УникальныеИмена.Имя("pool-new");
	ЧислоПулов = Пулы().ПулыДляЧтения().Количество();
	Ожидаем.Что(Пулы().ПулДляЧтения(Имя), "самотест: пула ещё нет").Равно(Неопределено);

	Выдача.Засев.ПулСервисом(Имя);

	Ожидаем.Что(Пулы().ПулДляЧтения(Имя), "заведённый пул находится по имени").Не_().Равно(Неопределено);
	Ожидаем.Что(Пулы().ПулыДляЧтения().Количество(), "и попадает в список пулов").Равно(ЧислоПулов + 1);

КонецПроцедуры

&Тест
Процедура УдалённыйПулПропадаетСразу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Пулы().ПулДляЧтения(Пул.Имя);
	ЧислоПулов = Пулы().ПулыДляЧтения().Количество();

	Пулы().УдалитьПул(Пул.Идентификатор);

	Ожидаем.Что(Пулы().ПулДляЧтения(Пул.Имя), "удалённый пул не находится").Равно(Неопределено);
	Ожидаем.Что(Пулы().ПулыДляЧтения().Количество(), "и уходит из списка").Равно(ЧислоПулов - 1);

КонецПроцедуры

&Тест
Процедура ВидимостьПулаВиднаСразу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Пулы().ПулДляЧтения(Пул.Имя);

	Пулы().УстановитьВидимость(Пул.Идентификатор, "private");

	Ожидаем.Что(Пулы().ПулДляЧтения(Пул.Имя).Видимость).Равно("private");

КонецПроцедуры

&Тест
Процедура ТипПулаВиденСразу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Пулы().ПулДляЧтения(Пул.Имя);

	Пулы().УстановитьТип(Пул.Идентификатор, Пулы().ТипЛичный());

	Ожидаем.Что(Пулы().ПулДляЧтения(Пул.Имя).ЭтоЛичный(), "тип пула виден сразу").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОсновнойПулВиденСразу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Пулы().ИмяПулаПоУмолчанию();

	Пулы().НазначитьПулПоУмолчанию(Пул.Идентификатор);

	Ожидаем.Что(Пулы().ИмяПулаПоУмолчанию(), "основной пул сменился сразу").Равно(Пул.Имя);

КонецПроцедуры

&Тест
Процедура ФлагПулаВиденСразу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Ожидаем.Что(Пулы().ПулДляЧтения(Пул.Имя).Флаг("тест-флаг"), "самотест: флаг не поднят").ЭтоЛожь();

	Пулы().УстановитьФлаг(Пул.Идентификатор, "тест-флаг", Истина);

	Ожидаем.Что(Пулы().ПулДляЧтения(Пул.Имя).Флаг("тест-флаг"), "флаг виден сразу").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗапретПубликацииВиденСразу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Пулы().ПулДляЧтения(Пул.Имя);

	Пулы().УстановитьПубликациюРазрешена(Пул.Идентификатор, Ложь);

	Ожидаем.Что(Пулы().ПулДляЧтения(Пул.Имя).ПубликацияРазрешена, "запрет публикации виден сразу").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура КвотаПулаВиднаСразу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Пулы().ПулДляЧтения(Пул.Имя);

	Пулы().УстановитьКвоту(Пул.Идентификатор, 7);

	Ожидаем.Что(Пулы().ПулДляЧтения(Пул.Имя).КвотаМб, "квота видна сразу").Равно(7);

КонецПроцедуры

// Занятое место меняется на каждой публикации и в снимок не входит: его читают у базы.
&Тест
Процедура ЗанятоеМестоЧитаетсяМимоКэша() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Снимок = Пулы().ПулДляЧтения(Пул.Имя);

	Выдача.Желудь("ЗаписьЗанятогоМеста").Учесть(Пул, 4096, "тест");

	Ожидаем.Что(Пулы().ЗанятоБайт(Снимок), "занятое место снимка — свежее").Равно(4096);

КонецПроцедуры

#КонецОбласти

#Область ИсточникиПула

&Тест
Процедура СтрокиИсточниковЧитаютсяИзКэша() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Источники().СтрокиПула(Пулы().ПулДляЧтения(Пул.Имя));

	База.Сбросить();
	Строки = Источники().СтрокиПула(Пулы().ПулДляЧтения(Пул.Имя));

	Ожидаем.Что(Строки.Количество(), "у пула источников нет").Равно(0);
	Ожидаем.Что(Операций(), "пустой ответ — тоже ответ, и он из кэша").Равно(0);

КонецПроцедуры

&Тест
Процедура ЗаведённыйИсточникВиденСразу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	СтрокиИсточников(Пул);

	Источники().Записать(Пул, АдресИсточника("new"));

	Ожидаем.Что(СтрокиИсточников(Пул).Количество(), "заведённый источник виден сразу").Равно(1);

КонецПроцедуры

&Тест
Процедура ВыключенныйИсточникВиденСразу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Источники().Записать(Пул, АдресИсточника("off"));
	Ожидаем.Что(Источники().ДляОпроса(Пулы().ПулДляЧтения(Пул.Имя)).Количество(), "самотест: источник включён")
		.Равно(1);

	Источники().Переключить(Пул.Идентификатор, АдресИсточника("off"), Ложь);

	Ожидаем.Что(Источники().ДляОпроса(Пулы().ПулДляЧтения(Пул.Имя)).Количество(),
		"выключенный источник выдача больше не опрашивает").Равно(0);
	Ожидаем.Что(СтрокиИсточников(Пул).Количество(), "но строка источника у пула осталась").Равно(1);

КонецПроцедуры

&Тест
Процедура СнятыйТокенВиденСразу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Источники().Записать(Пул, АдресИсточника("token"), , , "source-secret-token");
	Ожидаем.Что(ЗначениеЗаполнено(СтрокиИсточников(Пул)[0].ТокенДоступа), "самотест: токен задан").ЭтоИстина();

	Источники().СнятьТокен(Пул.Идентификатор, АдресИсточника("token"));

	Ожидаем.Что(СтрокиИсточников(Пул)[0].ТокенДоступа, "снятый токен виден сразу").Равно("");

КонецПроцедуры

&Тест
Процедура УдалённыйИсточникПропадаетСразу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Источники().Записать(Пул, АдресИсточника("gone"));
	СтрокиИсточников(Пул);

	Источники().Удалить(Пул.Идентификатор, АдресИсточника("gone"));

	Ожидаем.Что(СтрокиИсточников(Пул).Количество(), "удалённый источник пропал сразу").Равно(0);

КонецПроцедуры

&Тест
Процедура ПорядокИсточниковВиденСразу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Источники().Записать(Пул, АдресИсточника("first"));
	Источники().Записать(Пул, АдресИсточника("second"));
	Ожидаем.Что(СтрокиИсточников(Пул)[0].Url, "самотест: первым заведён first").Равно(АдресИсточника("first"));

	Источники().Переместить(Пул.Идентификатор, АдресИсточника("second"), 0);

	Ожидаем.Что(СтрокиИсточников(Пул)[0].Url, "новый порядок опроса виден сразу").Равно(АдресИсточника("second"));

КонецПроцедуры

&Тест
Процедура УдалённыйПулЗабываетИсточники() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Источники().Записать(Пул, АдресИсточника("pool-gone"));
	Хранилище = Выдача.Желудь("ХранилищеАпстримовПула");
	Ожидаем.Что(Хранилище.СнимкиПула(Пул.Идентификатор).Количество(), "самотест: строка в кэше").Равно(1);

	Пулы().УдалитьПул(Пул.Идентификатор);

	Ожидаем.Что(Хранилище.СнимкиПула(Пул.Идентификатор).Количество(), "уборка пула забыла его источники")
		.Равно(0);

КонецПроцедуры

#КонецОбласти

// Кэш в памяти с общим бюджетом отказывает изменяемым значениям ошибкой в своём журнале:
// ни один горячий путь не приносит ему сущность или изменяемую коллекцию.
&Тест
Процедура КэшВПамятиНеДержитИзменяемого() Экспорт

	Выпуск = Выдача.Опубликовать("пакет горячих путей");
	Для Номер = 1 По 2 Цикл
		Выдача.Выдать(Выпуск, "GET");
		Выдача.Выдать(Выпуск, "HEAD");
		Пулы().ПулыДляЧтения();
		Пулы().ИмяПулаПоУмолчанию();
	КонецЦикла;

	Ожидаем.Что(Отказы.Всё(), "отказов «изменяемое» в журнале кэша нет").Равно("");

КонецПроцедуры

#Область Помощники

Функция Пулы()
	Возврат Выдача.Желудь("СервисПулов");
КонецФункции

Функция Источники()
	Возврат Выдача.Желудь("СервисАпстримовПула");
КонецФункции

Функция СтрокиИсточников(Знач Пул)
	Возврат Источники().СтрокиПула(Пулы().ПулДляЧтения(Пул.Имя));
КонецФункции

Функция АдресИсточника(Знач Метка)
	Возврат СтрШаблон("http://%1.upstream.invalid/download/", Метка);
КонецФункции

// На КоннекторInMemory текста SQL нет: обращение к базе — операция источника данных.
Функция Операций()
	Возврат База.Операций();
КонецФункции

#КонецОбласти
