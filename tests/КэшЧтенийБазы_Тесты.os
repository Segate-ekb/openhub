&Тест
Процедура ПровенансВиденРезолвуСразу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Имя = УникальныеИмена.Имя("prov");
	Версия = Приём().ПринятьВнешнюю(Пул, Имя, "1.0.0", Неопределено,
		Новый Структура("Размер, Sha256", 5, "cccc"), , , "отметка").Версия;
	Происхождение = Выдача.Желудь("СервисПроисхождения");
	Ожидаем.Что(Происхождение.СнимокПакетаДляЧтения(Версия.ПакетИдентификатор).ЕстьСобственныеВерсии(),
		"самотест: версия привезена источником").ЭтоЛожь();

	Происхождение.Зафиксировать(Версия, Происхождение.ИсточникСвой());

	Ожидаем.Что(Происхождение.СнимокПакетаДляЧтения(Версия.ПакетИдентификатор).ЕстьСобственныеВерсии(),
		"своя публикация видна резолву сразу").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

// Кэш в памяти с общим бюджетом отказывает изменяемым значениям ошибкой в своём журнале:
// ни один горячий путь не приносит ему сущность или изменяемую коллекцию.
&Тест
Процедура КэшВПамятиНеДержитИзменяемого() Экспорт

	Выпуск = Выдача.Опубликовать("пакет горячих путей");
	Для Номер = 1 По 2 Цикл
		Выдача.Выдать(Выпуск, "GET");
		Выдача.Выдать(Выпуск, "HEAD");
		Пулы().ПулыДляЧтения();
		Пулы().ИмяПулаПоУмолчанию();
	КонецЦикла;

	Ожидаем.Что(Отказы.Всё(), "отказов «изменяемое» в журнале кэша нет").Равно("");

КонецПроцедуры

#Область Помощники

Функция Пулы()
	Возврат Выдача.Желудь("СервисПулов");
КонецФункции

Функция Источники()
	Возврат Выдача.Желудь("СервисАпстримовПула");
КонецФункции

Функция СтрокиИсточников(Знач Пул)
	Возврат Источники().СтрокиПула(Пулы().ПулДляЧтения(Пул.Имя));
КонецФункции

Функция АдресИсточника(Знач Метка)
	Возврат СтрШаблон("http://%1.upstream.invalid/download/", Метка);
КонецФункции

Функция Пакеты()
	Возврат Выдача.Желудь("СервисПакетов");
КонецФункции

Функция СлужбаВерсий()
	Возврат Выдача.Желудь("СервисВерсий");
КонецФункции

Функция Приём()
	Возврат Выдача.Желудь("ПриёмВерсии");
КонецФункции

Функция Принципалы()
	Возврат Новый СтендПринципалов(Выдача.Поделка());
КонецФункции

Функция ПакетыПула(Знач Выпуск)
	Возврат Пакеты().ПакетыПулаДляЧтения(Выпуск.Пул.Идентификатор);
КонецФункции

Функция ПакетВыпуска(Знач Выпуск)
	Возврат Пакеты().ПакетДляЧтения(Выпуск.Пул.Идентификатор, Выпуск.Пакет.Имя);
КонецФункции

Функция ПоследняяВыпуска(Знач Выпуск)
	Возврат Выпуск.Пакет.Имя + ".ospx";
КонецФункции

// Какую версию выдача отдала по безверсионному адресу: имя артефакта в Content-Disposition.
Функция ВыданнаяВерсия(Знач Выпуск)

	Ответ = Выдача.Выдать(Выпуск, "HEAD", "", ПоследняяВыпуска(Выпуск));
	Имя = Ответ.Заголовок("Content-Disposition");
	Начало = СтрНайти(Имя, Выпуск.Пакет.Имя + "-") + СтрДлина(Выпуск.Пакет.Имя) + 1;
	Возврат СтрЗаменить(Сред(Имя, Начало), ".ospx""", "");

КонецФункции

Функция ОдинПул(Знач Выпуск)
	Пулы = Новый Массив();
	Пулы.Добавить(Выпуск.Пул.Идентификатор);
	Возврат Пулы;
КонецФункции

// Версия выпуска среди новинок — окно шире числа версий набора.
Функция НовинкаВыпуска(Знач Выпуск)

	Для Каждого Версия Из СлужбаВерсий().ПоследниеВерсииДляЧтения(1000) Цикл
		Если Версия.Идентификатор = Выпуск.Версия.Идентификатор Тогда
			Возврат Версия;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "версии выпуска среди новинок нет";

КонецФункции

// Публикует версию пакета выпуска с артефактом в хранилище; Перезаписать — поверх той же строки.
Функция ОпубликоватьВерсию(Знач Выпуск, Знач СтрокаВерсии, Знач Содержимое, Знач Перезаписать = Ложь)

	Координаты = Новый КоординатыАртефакта(Выпуск.Пул.Имя, Выпуск.Пакет.Имя, СтрокаВерсии);
	Сохранено = Выдача.Желудь("ХранилищеАртефактов").Сохранить(Координаты,
		ПолучитьДвоичныеДанныеИзСтроки(Содержимое));

	Заявка = Новый ЗаявкаНаПубликацию(Выпуск.Пакет.Идентификатор, СтрокаВерсии);
	Заявка.Размер = Сохранено.Размер;
	Заявка.Sha256 = Сохранено.Sha256;
	Заявка.ПутьВХранилище = СтрШаблон("pools/%1/%2/%2-%3.ospx", Выпуск.Пул.Имя, Выпуск.Пакет.Имя, СтрокаВерсии);
	Возврат СлужбаВерсий().Опубликовать(Заявка, Перезаписать);

КонецФункции

Функция Учётка(Знач Роль)
	Возврат Выдача.Желудь("СервисПользователей").СоздатьПользователя(
		УникальныеИмена.Имя(Роль), "", "RolePassw0rd!", Роль);
КонецФункции

// На КоннекторInMemory текста SQL нет: обращение к базе — операция источника данных.
Функция Операций()
	Возврат База.Операций();
КонецФункции

#КонецОбласти
