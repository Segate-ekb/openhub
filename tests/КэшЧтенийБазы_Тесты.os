// Частые чтения из базы идут из кэша в памяти, а запись через хаб видна следующему же чтению:
// на каждого писателя — «записал, прочитал новое». Кэш держит только неизменяемые снимки
// в общем бюджете памяти, срок жизни выключен: свежесть держит сброс, а не устаревание.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать autumn-cache
#Использовать entity
#Использовать "фикстуры"

Перем Выдача;        // фикстура СтендВыдачи — контейнер, хранилище на фейке S3, маршрут выдачи
Перем Отказы;        // фикстура ЛовушкаЛога — ошибки библиотеки кэша за весь набор
Перем База;          // фикстура СчётчикОбращенийКБазе — обращения к источнику данных

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("СтендВыдачи");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("СчётчикОбращенийКБазе");
	РеестрФикстур.Подключить("СтендПринципалов");

	Отказы = Новый ЛовушкаЛога();
	ЖурналКэша = Логирование.ПолучитьЛог("oscript.lib.autumn-cache");
	ЖурналКэша.ДобавитьСпособВывода(Отказы, УровниЛога.Ошибка);

	Детальки = Новый Соответствие();
	Детальки.Вставить("cache.ПределПамяти", 16777216);
	// сверх выдачи — писатели: учётки и права ради удаления учётки, публикация ради push
	Выдача = Новый СтендВыдачи(Детальки, "кэш-чтений-базы-тесты",
		"почта, уведомления, вход, права, публикация");

	База = Новый СчётчикОбращенийКБазе();
	Выдача.Желудь("ИсточникДанных").ДобавитьНаблюдателя(База);

КонецПроцедуры

#Область Пулы

&Тест
Процедура ПовторноеЧтениеПулаНеХодитВБазу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Пулы().ПулДляЧтения(Пул.Имя);

	База.Сбросить();
	Снимок = Пулы().ПулДляЧтения(Пул.Имя);
	Пулы().ПулыДляЧтения();
	Пулы().ИмяПулаПоУмолчанию();
	Пулы().ПулыДляЧтения();

	Ожидаем.Что(Снимок.Имя, "снимок называет пул").Равно(Пул.Имя);
	Ожидаем.Что(Снимок.ЭтоЛичный(), "у снимка есть методы пула").ЭтоЛожь();
	Ожидаем.Что(Операций(), "повторное чтение пулов идёт из кэша").Равно(0);

	Пулы().НайтиПул(Пул.Имя);
	Ожидаем.Что(Операций(), "самотест: чтение мимо кэша счётчик видит").Больше(0);

КонецПроцедуры

&Тест
Процедура ЗаведённыйПулВиденСразу() Экспорт

	Имя = УникальныеИмена.Имя("pool-new");
	ЧислоПулов = Пулы().ПулыДляЧтения().Количество();
	Ожидаем.Что(Пулы().ПулДляЧтения(Имя), "самотест: пула ещё нет").Равно(Неопределено);

	Выдача.Засев.ПулСервисом(Имя);

	Ожидаем.Что(Пулы().ПулДляЧтения(Имя), "заведённый пул находится по имени").Не_().Равно(Неопределено);
	Ожидаем.Что(Пулы().ПулыДляЧтения().Количество(), "и попадает в список пулов").Равно(ЧислоПулов + 1);

КонецПроцедуры

&Тест
Процедура УдалённыйПулПропадаетСразу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Пулы().ПулДляЧтения(Пул.Имя);
	ЧислоПулов = Пулы().ПулыДляЧтения().Количество();

	Пулы().УдалитьПул(Пул.Идентификатор);

	Ожидаем.Что(Пулы().ПулДляЧтения(Пул.Имя), "удалённый пул не находится").Равно(Неопределено);
	Ожидаем.Что(Пулы().ПулыДляЧтения().Количество(), "и уходит из списка").Равно(ЧислоПулов - 1);

КонецПроцедуры

