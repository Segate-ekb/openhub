	Пакеты().ЗарегистрироватьПакет(Пул.Идентификатор, Имя);

	Ожидаем.Что(Пакеты().ПакетыПулаДляЧтения(Пул.Идентификатор).Количество(), "новый пакет виден сразу").Равно(1);
	Ожидаем.Что(Пакеты().ПакетДляЧтения(Пул.Идентификатор, Имя), "и находится по имени").Не_().Равно(Неопределено);

