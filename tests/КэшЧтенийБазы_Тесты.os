КонецПроцедуры

&Тест
Процедура СменаСлотаИсточникаВиднаВНовинкахСразу() Экспорт

	Пул = Выдача.Засев.ПулСервисом();
	Имя = УникальныеИмена.Имя("slot");
	Приём().ПринятьВнешнюю(Пул, Имя, "SNAPSHOT", Неопределено,
		Новый Структура("Размер, Sha256", 10, "aaaa"), , , "отметка-1");
	Ожидаем.Что(СлужбаВерсий().ПоследниеВерсииДляЧтения(1)[0].Sha256, "самотест: слот принят").Равно("aaaa");
	ПакетИд = Пакеты().ПакетДляЧтения(Пул.Идентификатор, Имя).Идентификатор;
	СлужбаВерсий().ВерсииПакетаДляЧтения(ПакетИд);

	Приём().ПринятьВнешнюю(Пул, Имя, "SNAPSHOT", Неопределено,
		Новый Структура("Размер, Sha256", 11, "bbbb"), , , "отметка-2");

	Ожидаем.Что(СлужбаВерсий().ПоследниеВерсииДляЧтения(1)[0].Sha256, "сменившийся слот виден сразу").Равно("bbbb");
	Ожидаем.Что(СлужбаВерсий().НайтиВерсиюДляЧтения(ПакетИд, "SNAPSHOT").Sha256, "и резолву выдачи")
		.Равно("bbbb");

КонецПроцедуры

&Тест
Процедура УдалённыйПакетУходитСВитриныСразу() Экспорт

	Выпуск = Выдача.Опубликовать("удаляемый");
	ПакетыПула(Выпуск);
	СлужбаВерсий().ПоследниеВерсииДляЧтения(1);

	Выдача.Желудь("УборкаПакета").УдалитьПакет(Выдача.Желудь("СервисПакетов").ПакетПоИдентификатору(
		Выпуск.Пакет.Идентификатор));

	Ожидаем.Что(ПакетыПула(Выпуск).Количество(), "пакет ушёл с витрины сразу").Равно(0);
	Ожидаем.Что(СлужбаВерсий().ПоследниеВерсииДляЧтения(1)[0].ПакетИдентификатор, "и его версия — из новинок")
		.Не_().Равно(Выпуск.Пакет.Идентификатор);

КонецПроцедуры

&Тест
Процедура СнятыйРезервУходитСВитриныСразу() Экспорт

	Админ = Учётка("admin");
	Пул = Выдача.Засев.ПулСервисом();
	Имя = УникальныеИмена.Имя("reserved");
	Пакеты().ЗарегистрироватьПакет(Пул.Идентификатор, Имя);
	Ожидаем.Что(Пакеты().ПакетыПулаДляЧтения(Пул.Идентификатор).Количество(), "самотест: резерв виден").Равно(1);
	Ожидаем.Что(Пакеты().ПакетДляЧтения(Пул.Идентификатор, Имя), "самотест: резерв находится").Не_().Равно(Неопределено);

	Снято = Выдача.Желудь("СервисРезервированияИмён").СнятьРезерв(Принципалы().Сессия(Админ), Пул, Имя);

	Ожидаем.Что(Снято.Успех, "самотест: резерв снят").ЭтоИстина();
	Ожидаем.Что(Пакеты().ПакетыПулаДляЧтения(Пул.Идентификатор).Количество(), "снятый резерв ушёл сразу").Равно(0);
	Ожидаем.Что(Пакеты().ПакетДляЧтения(Пул.Идентификатор, Имя), "и по имени не находится").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ОбезличеннаяПубликацияВиднаВНовинкахСразу() Экспорт

	Админ = Учётка("admin");
	Автор = Учётка("user");
	Выпуск = Выдача.Опубликовать("чужая публикация");
	Выпуск.Версия.ОпубликовалИдентификатор = Автор.Идентификатор;
	Выпуск.Версия.Сохранить();
	СлужбаВерсий().ОтозватьВерсию(Выпуск.Пакет.Идентификатор, "1.0.0", Ложь);
	Ожидаем.Что(НовинкаВыпуска(Выпуск).ОпубликовалИдентификатор, "самотест: автор назван")
		.Равно(Автор.Идентификатор);
	СлужбаВерсий().ВерсииПакетаДляЧтения(Выпуск.Пакет.Идентификатор);

	Выдача.Желудь("УдалениеУчётки").Удалить(Админ, Автор);

	Ожидаем.Что(НовинкаВыпуска(Выпуск).ОпубликовалИдентификатор, "публикация обезличена сразу").Равно(0);
	Ожидаем.Что(СлужбаВерсий().НайтиВерсиюДляЧтения(Выпуск.Пакет.Идентификатор, "1.0.0").ОпубликовалИдентификатор,
		"и в снимке версий пакета").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СнимокПакета

// Разогретое скачивание версии: пул, источники, пакет, версии и провенанс — из кэша.
&Тест
Процедура СкачиваниеВерсииВРазогретомХабеНеХодитВБазу() Экспорт

	Выпуск = Выдача.Опубликовать("разогретое скачивание");

	База.Сбросить();
	Выдача.Выдать(Выпуск);
	Холодное = Операций();

	База.Сбросить();
	Ответ = Выдача.Выдать(Выпуск);

	Ожидаем.Что(Ответ.Код).Равно(200);
	Ожидаем.Что(Холодное, "самотест: холодное скачивание базу спрашивает").Больше(0);
	Ожидаем.Что(Операций(), "повторное скачивание версии в базу не ходит").Равно(0);

КонецПроцедуры

// Скачивание без версии выбирает её по основному тегу: теги кэша не имеют, остальное — из кэша.
&Тест
Процедура СкачиваниеПоследнейВРазогретомХабеСпрашиваетБазуТолькоОТегах() Экспорт

	Выпуск = Выдача.Опубликовать("разогретое последнее");
	Выдача.Выдать(Выпуск, "GET", "", ПоследняяВыпуска(Выпуск));

	База.Сбросить();
	Ответ = Выдача.Выдать(Выпуск, "GET", "", ПоследняяВыпуска(Выпуск));

	Ожидаем.Что(Ответ.Код).Равно(200);
	Ожидаем.Что(Операций(), "в базу уходит только вопрос о тегах пакета").Равно(1);

КонецПроцедуры

