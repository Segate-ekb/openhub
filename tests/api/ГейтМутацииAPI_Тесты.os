// Гейт мутации API: неизвестный способ аутентификации и ключ без собранного гейта мутацию
// не проходят. По HTTP в эти ветки не въехать — отсюда прямой экземпляр.

#Использовать asserts
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогПроекта;

// Набор регистрирует классы прикладных модулей в своём процессе.
&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогПроекта = КаталогиПроекта.Корень();
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПоискКлассов.ПодключитьОснову(Модули);
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "права", "Классы"), "УчёткаПринципала");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "api", "Классы"), "ГейтМутацииAPI");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");

КонецПроцедуры

&Тест
Процедура НеизвестныйСпособАутентификацииНеПропускаетМутацию() Экспорт

	Ответ = Новый ОтветСтраницыЗаглушка();
	Разрешено = Гейт().ПроверитьМутацию(Ответ, Принципал("mtls", "кто-то"),
		Новый Соответствие(), Новый Соответствие());

	Ожидаем.Что(Разрешено, "неизвестный способ мутацию НЕ проходит").ЭтоЛожь();
	Ожидаем.Что(Ответ.Код, "и получает 403").Равно(403);
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "unknown_auth_method") > 0,
		"причина названа своим кодом (тело: " + Ответ.ТелоТекст + ")").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АнонимПроходитНасквозьАПолуличностьНет() Экспорт

	// аноним = пустой способ И отсутствующий пользователь — только он проходит
	ОтветАнонима = Новый ОтветСтраницыЗаглушка();
	Ожидаем.Что(Гейт().ПроверитьМутацию(ОтветАнонима, Принципал("", Неопределено),
		Новый Соответствие(), Новый Соответствие()), "аноним проходит насквозь").ЭтоИстина();
	Ожидаем.Что(ОтветАнонима.Код, "и ответ не тронут — отказ выдаст аутентификация ниже").Равно(0);

	// пустой способ с пользователем перехватчик не выдаёт — это неизвестный способ, а не аноним
	ОтветПолу = Новый ОтветСтраницыЗаглушка();
	Ожидаем.Что(Гейт().ПроверитьМутацию(ОтветПолу, Принципал("", "кто-то"),
		Новый Соответствие(), Новый Соответствие()),
		"пустой способ с пользователем насквозь не проходит").ЭтоЛожь();
	Ожидаем.Что(ОтветПолу.Код, "и это 403").Равно(403);

	// названный способ без пользователя — тоже не аноним
	ОтветБезЛица = Новый ОтветСтраницыЗаглушка();
	Ожидаем.Что(Гейт().ПроверитьМутацию(ОтветБезЛица, Принципал("mtls", Неопределено),
		Новый Соответствие(), Новый Соответствие()),
		"названный способ без пользователя насквозь не проходит").ЭтоЛожь();
	Ожидаем.Что(ОтветБезЛица.Код, "и это 403").Равно(403);

КонецПроцедуры

// В собранном контейнере гейт ключа есть всегда; у прямого экземпляра его может не быть —
// тогда мутация по ключу закрыта.
&Тест
Процедура КлючБезСобранногоГейтаМутациюНеПроходит() Экспорт

	Ответ = Новый ОтветСтраницыЗаглушка();
	Разрешено = Гейт().ПроверитьМутацию(Ответ, Принципал("token", "кто-то"),
		Новый Соответствие(), Новый Соответствие());

	Ожидаем.Что(Разрешено, "без гейта ключ мутацию НЕ проходит").ЭтоЛожь();
	Ожидаем.Что(Ответ.Код, "и получает 403").Равно(403);
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "token_gate_missing") > 0,
		"причина названа своим кодом (тело: " + Ответ.ТелоТекст + ")").ЭтоИстина();

КонецПроцедуры

// Проверяемые ветки не трогают ни одной зависимости, кроме ОтветыAPI: он пишет отказ.
Функция Гейт()
	Возврат Новый ГейтМутацииAPI(Неопределено, Неопределено, Неопределено, Неопределено,
		Новый ЗаголовкиHTTP(), Новый ОтветыAPI(Новый ЗаголовкиHTTP()), Неопределено);
КонецФункции

Функция Принципал(Знач Способ, Знач Пользователь)
	Возврат Новый Структура("Способ, Пользователь, Права, ПулИдентификатор, Сессия",
		Способ, Пользователь, "", 0, Неопределено);
КонецФункции
