// Отказы правки и удаления зеркала в API без живого хаба: сбой службы — JSON 500 своим кодом
// и честным составом применённого, зеркало, снятое параллельно, — 404, негодный токен — 422.

#Использовать asserts
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогПроекта;
Перем Служба;         // ФейкСервисЗеркалЭкрана — зеркала пула и сбои службы
Перем Сборка;         // СборкаКонтроллераЗеркал

// Набор регистрирует классы прикладных модулей в своём процессе.
&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогПроекта = КаталогиПроекта.Корень();
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	ПоискКлассов.ПодключитьОснову(Модули);
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "протоколAPI", "Классы"));
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "api", "Классы"), "КонтроллерЗеркалAPI");

	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("КукиЗаглушка");
	РеестрФикстур.Подключить("ФейкСервисЗеркалЭкрана");
	РеестрФикстур.Подключить("ПрологПравкиЗаглушка");
	РеестрФикстур.Подключить("СборкаКонтроллераЗеркал");

КонецПроцедуры

&ПередКаждым
Процедура ЗаведёноОдноЗеркало() Экспорт

	Зеркала = Новый Массив();
	Зеркала.Добавить(Новый Структура("Идентификатор, ТокенДоступа", 7, "sekret-42"));

	Служба = Новый ФейкСервисЗеркалЭкрана();
	Служба.Задать(Зеркала);

	Сборка = Новый СборкаКонтроллераЗеркал();
	Сборка.СервисЗеркал = Служба;
	Сборка.ПрологПравки = Новый ПрологПравкиЗаглушка();

КонецПроцедуры

&Тест
Процедура СбойВключенияОтвечаетJSON500НичегоНеПрименив() Экспорт

	Служба.Сбоить("Переключить");

	Ответ = Править("{""enabled"":false}");

	Ожидаем.Что(Ответ.Код, "сбой службы — 500").Равно(500);
	Ожидаем.Что(Ответ.Заголовки["Content-Type"], "конверт JSON, а не страница").Содержит("application/json");
	Ожидаем.Что(Ошибка(Ответ)["code"], "код сбоя правки").Равно("mirror_update_failed");
	Ожидаем.Что(Ошибка(Ответ).Получить("details"), "применённого нет").ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура СбойСнятияТокенаОтвечаетJSON500() Экспорт

	Служба.Сбоить("СнятьТокен");

	Ответ = Править("{""token_remove"":true}");

	Ожидаем.Что(Ответ.Код, "сбой службы — 500").Равно(500);
	Ожидаем.Что(Ошибка(Ответ)["code"], "код сбоя правки").Равно("mirror_update_failed");
	Ожидаем.Что(Ошибка(Ответ).Получить("details"), "применённого нет").ЭтоНеопределено();

КонецПроцедуры

// Токен уже снят, а включение упало: ответ называет применённое, а не «ничего не изменено».
&Тест
Процедура СбойВключенияПослеТокенаНазываетПрименённыйТокен() Экспорт

	Служба.Сбоить("Переключить");

	Ответ = Править("{""token_remove"":true,""enabled"":false}");

	Ожидаем.Что(Ответ.Код, "сбой службы — 500").Равно(500);
	Ожидаем.Что(Ошибка(Ответ)["code"], "код сбоя правки").Равно("mirror_update_failed");
	Применено = Ошибка(Ответ)["details"]["applied"];
	Ожидаем.Что(Применено.Количество(), "применено одно поле").Равно(1);
	Ожидаем.Что(Применено[0], "и это токен").Равно("token");
	Ожидаем.Что(Служба.ЗеркалоПула(Неопределено, 7).ТокенДоступа, "токен и правда снят").Равно("");

КонецПроцедуры

&Тест
Процедура НегодныйТокенОтвечает422() Экспорт

	Служба.Сбоить("ЗадатьТокен");

	Ответ = Править("{""token"":""плохой токен""}");

	Ожидаем.Что(Ответ.Код, "токен не принят — 422").Равно(422);
	Ожидаем.Что(Ошибка(Ответ)["code"], "код отказа токена").Равно("invalid_mirror");

КонецПроцедуры

&Тест
Процедура СбойУдаленияОтвечаетJSON500() Экспорт

	Служба.Сбоить("Удалить");

	Ответ = Запросить("DELETE", "");

	Ожидаем.Что(Ответ.Код, "сбой службы — 500").Равно(500);
	Ожидаем.Что(Ответ.Заголовки["Content-Type"], "конверт JSON, а не страница").Содержит("application/json");
	Ожидаем.Что(Ошибка(Ответ)["code"], "код сбоя удаления").Равно("mirror_delete_failed");

КонецПроцедуры

&Тест
Процедура ЗеркалоСнятоеПараллельноОтвечает404() Экспорт

	Служба.СниматьПослеПравки();

	Ответ = Править("{""enabled"":false}");

	Ожидаем.Что(Ответ.Код, "перечитывать нечего — 404").Равно(404);
	Ожидаем.Что(Ошибка(Ответ)["code"], "код отсутствующего зеркала").Равно("mirror_not_found");

КонецПроцедуры

Функция Править(Знач Тело)
	Возврат Запросить("PATCH", Тело);
КонецФункции

Функция Запросить(Знач Метод, Знач Тело)
	Ответ = Новый ОтветСтраницыЗаглушка();
	Сборка.Собрать().Зеркало(Ответ, "secret", "7", Новый Соответствие(), Неопределено, Тело, Метод);
	Возврат Ответ;
КонецФункции

Функция Ошибка(Знач Ответ)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ТелоТекст);
	Тело = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Тело["error"];
КонецФункции
