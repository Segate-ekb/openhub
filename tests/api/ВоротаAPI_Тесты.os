// Двери и пороги API без живого хаба: закрытое неотличимо от отсутствующего, нет права — 403,
// пролог правки останавливается на первом отказе и проходит порог до мутации.

#Использовать asserts
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КаталогПроекта;

Перем Гвард;          // ГвардДоступаКПулуЗаглушка
Перем Пакеты;         // СервисПакетовЗаглушка
Перем Права;          // ФейкСервисПрав
Перем Кабинет;        // СлужбаКабинетаЗаглушка
Перем Гейт;           // ГейтМутацииЗаглушка

// Набор регистрирует классы прикладных модулей в своём процессе.
&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогПроекта = КаталогиПроекта.Корень();
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КлассыAPI = ОбъединитьПути(Модули, "api", "Классы");

	ПоискКлассов.ПодключитьОснову(Модули);
	ПоискКлассов.Подключить(КлассыAPI, "ДвериAPI");
	ПоискКлассов.Подключить(КлассыAPI, "ПорогиПравAPI");
	ПоискКлассов.Подключить(КлассыAPI, "ПрологПравкиAPI");

	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("ГвардДоступаКПулуЗаглушка");
	РеестрФикстур.Подключить("СервисПакетовЗаглушка");
	РеестрФикстур.Подключить("ФейкСервисПрав");
	РеестрФикстур.Подключить("СлужбаКабинетаЗаглушка");
	РеестрФикстур.Подключить("ГейтМутацииЗаглушка");

КонецПроцедуры

&ПередКаждым
Процедура НовыйМир() Экспорт
	Гвард = Новый ГвардДоступаКПулуЗаглушка();
	Пакеты = Новый СервисПакетовЗаглушка();
	Права = Новый ФейкСервисПрав();
	Кабинет = Новый СлужбаКабинетаЗаглушка();
	Гейт = Новый ГейтМутацииЗаглушка();
КонецПроцедуры

#Область ДвериВПулИПакет

&Тест
Процедура ЗакрытыйПулНеотличимОтОтсутствующего() Экспорт

	Гвард.ЗавестиПул("secret", Ложь, Ложь);

	Закрытый = Новый ОтветСтраницыЗаглушка();
	Отсутствующий = Новый ОтветСтраницыЗаглушка();

	Ожидаем.Что(Двери().ВидимыйПул(Закрытый, "secret", Неопределено), "закрытый пул не отдан")
		.ЭтоНеопределено();
	Ожидаем.Что(Двери().ВидимыйПул(Отсутствующий, "nosuch", Неопределено),
		"отсутствующий пул не отдан").ЭтоНеопределено();

	Ожидаем.Что(Закрытый.Код, "закрытый — 404").Равно(404);
	Ожидаем.Что(КодОшибки(Закрытый), "и код отказа пула").Равно("pool_not_found");
	Ожидаем.Что(СтрЗаменить(Закрытый.ТелоТекст, "secret", "nosuch"),
		"тела одинаковы с точностью до имени").Равно(Отсутствующий.ТелоТекст);

КонецПроцедуры

&Тест
Процедура ОткрытыйПулОтдаётсяБезОтвета() Экспорт

	Пул = Гвард.ЗавестиПул("public");

	Ответ = Новый ОтветСтраницыЗаглушка();
	Ожидаем.Что(Двери().ВидимыйПул(Ответ, "public", Неопределено).Идентификатор, "пул отдан")
		.Равно(Пул.Идентификатор);
	Ожидаем.Что(Ответ.Код, "ответ не тронут").Равно(0);

КонецПроцедуры

// Дверь мутаций шире двери чтения: пул, открытый только на запись, в неё входит.
&Тест
Процедура ПулТолькоНаЗаписьВходитВДверьМутацийНоНеВДверьЧтения() Экспорт

	Гвард.ЗавестиПул("write-only", Ложь, Истина);

	Ожидаем.Что(Двери().ПулМутации(Новый ОтветСтраницыЗаглушка(), "write-only", Неопределено),
		"дверь мутаций открыта").Не_().ЭтоНеопределено();
	Ожидаем.Что(Двери().ВидимыйПул(Новый ОтветСтраницыЗаглушка(), "write-only", Неопределено),
		"дверь чтения закрыта").ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура БезГвардаПулНеОткрытНикому() Экспорт

	Гвард.ЗавестиПул("public");
	БезГварда = Новый ДвериAPI(Неопределено, Пакеты, Пороги(), Новый ОтветыAPI(Новый ЗаголовкиHTTP()));

	Ответ = Новый ОтветСтраницыЗаглушка();
	Ожидаем.Что(БезГварда.ВидимыйПул(Ответ, "public", Неопределено), "без гварда пула нет")
		.ЭтоНеопределено();
	Ожидаем.Что(Ответ.Код, "и это 404").Равно(404);

КонецПроцедуры

&Тест
Процедура СкрытыйПакетНеотличимОтОтсутствующегоЗаОбеимиДверями() Экспорт

	Пул = Гвард.ЗавестиПул("public");
	Пакеты.ЗавестиПакет(Пул, "hidden", Истина);

	Для Каждого Мутация Из СтрРазделить("чтение,мутация", ",") Цикл

		Скрытый = Новый ОтветСтраницыЗаглушка();
		Отсутствующий = Новый ОтветСтраницыЗаглушка();

		Ожидаем.Что(ПакетЗаДверью(Мутация, Скрытый, "hidden"), Мутация + ": скрытый не отдан")
			.ЭтоНеопределено();
		Ожидаем.Что(ПакетЗаДверью(Мутация, Отсутствующий, "nosuch"), Мутация + ": отсутствующий не отдан")
			.ЭтоНеопределено();
		Ожидаем.Что(Скрытый.Код, Мутация + ": скрытый — 404").Равно(404);
		Ожидаем.Что(КодОшибки(Скрытый), Мутация + ": код отказа пакета").Равно("package_not_found");
		Ожидаем.Что(СтрЗаменить(Скрытый.ТелоТекст, "hidden", "nosuch"),
			Мутация + ": тела одинаковы с точностью до имени").Равно(Отсутствующий.ТелоТекст);

	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПакетЗакрытогоПулаДаётОтказПула() Экспорт

	Пул = Гвард.ЗавестиПул("secret", Ложь, Ложь);
	Пакеты.ЗавестиПакет(Пул, "lib");

	Ответ = Новый ОтветСтраницыЗаглушка();
	Ожидаем.Что(Двери().ВидимыйПакет(Ответ, "secret", "lib", Неопределено), "пакет не отдан")
		.ЭтоНеопределено();
	Ожидаем.Что(Ответ.Код, "404").Равно(404);
	Ожидаем.Что(КодОшибки(Ответ), "отказ называет пул, а не пакет").Равно("pool_not_found");

КонецПроцедуры

// Невидимый пул — 404 и для администрирования: 403 выдал бы, что пул существует.
&Тест
Процедура АдминистрируемыйПулНевидимому404ВидимомуБезПрава403() Экспорт

	Гвард.ЗавестиПул("secret", Ложь, Ложь);
	Публичный = Гвард.ЗавестиПул("public");
	Принципал = ПринципалСубъекта(Гейт);

	Невидимый = Новый ОтветСтраницыЗаглушка();
	Двери().АдминистрируемыйПул(Невидимый, "secret", Принципал);
	Ожидаем.Что(Невидимый.Код, "невидимый пул — 404, а не 403").Равно(404);

	БезПрава = Новый ОтветСтраницыЗаглушка();
	Ожидаем.Что(Двери().АдминистрируемыйПул(БезПрава, "public", Принципал), "без права пула нет")
		.ЭтоНеопределено();
	ПроверитьОтказ(БезПрава, "администратора пула");

	Права.РазрешитьРаспоряжаться(Публичный.Идентификатор);
	СПравом = Новый ОтветСтраницыЗаглушка();
	Ожидаем.Что(Двери().АдминистрируемыйПул(СПравом, "public", Принципал), "с правом пул отдан")
		.Не_().ЭтоНеопределено();
	Ожидаем.Что(СПравом.Код, "и ответ не тронут").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Пороги

&Тест
Процедура ПорогиХабаБезПраваДают403СвоимиСловами() Экспорт

	ПорогиПрав = Пороги();
	Субъект = Новый Структура("Логин, Админ", "кто-то", Ложь);

	Ответ = Новый ОтветСтраницыЗаглушка();
	Ожидаем.Что(ПорогиПрав.ТребоватьАдминаХаба(Ответ, Субъект), "админ хаба").ЭтоЛожь();
	ПроверитьОтказ(Ответ, "администратора хаба");

	Ответ = Новый ОтветСтраницыЗаглушка();
	Ожидаем.Что(ПорогиПрав.ТребоватьСозданиеПула(Ответ, Субъект), "заведение пула").ЭтоЛожь();
	ПроверитьОтказ(Ответ, "создания пула");

	Ответ = Новый ОтветСтраницыЗаглушка();
	Ожидаем.Что(ПорогиПрав.ТребоватьУдалениеПула(Ответ, Субъект), "удаление пула").ЭтоЛожь();
	ПроверитьОтказ(Ответ, "удаления пула");

	Ответ = Новый ОтветСтраницыЗаглушка();
	Ожидаем.Что(ПорогиПрав.ТребоватьНазначениеОсновногоПула(Ответ, Субъект), "основной пул").ЭтоЛожь();
	ПроверитьОтказ(Ответ, "основной пул");

	Админ = Новый Структура("Логин, Админ", "root", Истина);
	СПравом = Новый ОтветСтраницыЗаглушка();
	Ожидаем.Что(ПорогиПрав.ТребоватьАдминаХаба(СПравом, Админ), "с правом порог пройден").ЭтоИстина();
	Ожидаем.Что(СПравом.Код, "и ответ не тронут").Равно(0);

КонецПроцедуры

&Тест
Процедура ПорогПакетаСпрашиваетКабинетИОтказываетСвоимиСловами() Экспорт

	Пул = Гвард.ЗавестиПул("public");
	Пакеты.ЗавестиПакет(Пул, "lib");
	Пакет = Пакеты.НайтиПакет(Пул.Идентификатор, "lib");
	Субъект = Новый Структура("Логин, Админ", "кто-то", Ложь);

	Ответ = Новый ОтветСтраницыЗаглушка();
	Ожидаем.Что(Пороги().ТребоватьИзменениеПакета(Ответ, Субъект, Пул, Пакет), "без права")
		.ЭтоЛожь();
	ПроверитьОтказ(Ответ, "изменения пакета");

	Кабинет.Разрешить();
	СПравом = Новый ОтветСтраницыЗаглушка();
	Ожидаем.Что(Пороги().ТребоватьИзменениеПакета(СПравом, Субъект, Пул, Пакет), "с правом кабинета")
		.ЭтоИстина();
	Ожидаем.Что(СПравом.Код, "и ответ не тронут").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ПрологПравки

&Тест
Процедура ПравкаПакетаБезПраваУправленияОтбивается403() Экспорт

	Пул = Гвард.ЗавестиПул("public");
	Пакеты.ЗавестиПакет(Пул, "lib");

	Ответ = Новый ОтветСтраницыЗаглушка();
	Ожидаем.Что(Пролог().ПравкаПакета(Ответ, "public", "lib", Новый Соответствие(), Неопределено, ""),
		"без права правки нет").ЭтоНеопределено();
	ПроверитьОтказ(Ответ, "изменения пакета");

	Кабинет.Разрешить();
	СПравом = Новый ОтветСтраницыЗаглушка();
	Правка = Пролог().ПравкаПакета(СПравом, "public", "lib", Новый Соответствие(), Неопределено, "");
	Ожидаем.Что(Правка.Пакет.Имя, "правка несёт пакет").Равно("lib");
	Ожидаем.Что(Правка.Пул.Имя, "и пул").Равно("public");
	Ожидаем.Что(Правка.Пользователь.Логин, "и субъекта мутации").Равно("кто-то");
	Ожидаем.Что(СПравом.Код, "ответ не тронут").Равно(0);

КонецПроцедуры

// Отказ гейта останавливает пролог до двери: о пуле никого не спрашивают.
&Тест
Процедура ОтказГейтаОстанавливаетПрологДоДвери() Экспорт

	Гвард.ЗавестиПул("public");
	Кабинет.Разрешить();
	Гейт.Отказать();

	Для Каждого Пролог_ Из СтрРазделить("пакет,пул", ",") Цикл
		Ответ = Новый ОтветСтраницыЗаглушка();
		Если Пролог_ = "пакет" Тогда
			Итог = Пролог().ПравкаПакета(Ответ, "public", "lib", Новый Соответствие(), Неопределено, "");
		Иначе
			Итог = Пролог().АдминистрированиеПула(Ответ, "public", Новый Соответствие(), Неопределено, "");
		КонецЕсли;
		Ожидаем.Что(Итог, Пролог_ + ": правки нет").ЭтоНеопределено();
		Ожидаем.Что(Ответ.Код, Пролог_ + ": ответ гейта").Равно(403);
	КонецЦикла;

	Ожидаем.Что(Гвард.Вопросов(), "до двери пролог не дошёл").Равно(0);

КонецПроцедуры

&Тест
Процедура АдминистрированиеЗакрытогоПулаОтвечает404() Экспорт

	Гвард.ЗавестиПул("secret", Ложь, Ложь);

	Ответ = Новый ОтветСтраницыЗаглушка();
	Ожидаем.Что(Пролог().АдминистрированиеПула(Ответ, "secret", Новый Соответствие(), Неопределено, ""),
		"закрытый пул не администрируется").ЭтоНеопределено();
	Ожидаем.Что(Ответ.Код, "и отвечает как отсутствующий").Равно(404);
	Ожидаем.Что(КодОшибки(Ответ), "отказ пула").Равно("pool_not_found");

КонецПроцедуры

#КонецОбласти

Функция Двери()
	Возврат Новый ДвериAPI(Гвард, Пакеты, Пороги(), Новый ОтветыAPI(Новый ЗаголовкиHTTP()));
КонецФункции

Функция Пороги()
	Возврат Новый ПорогиПравAPI(Права, Кабинет, Новый ОтветыAPI(Новый ЗаголовкиHTTP()));
КонецФункции

Функция Пролог()
	Возврат Новый ПрологПравкиAPI(Гейт, Двери(), Пороги());
КонецФункции

Функция ПакетЗаДверью(Знач Дверь, Ответ, Знач ИмяПакета)
	Если Дверь = "чтение" Тогда
		Возврат Двери().ВидимыйПакет(Ответ, "public", ИмяПакета, Неопределено);
	КонецЕсли;
	Возврат Двери().ПакетМутации(Ответ, "public", ИмяПакета, Неопределено);
КонецФункции

// Принципал субъекта, которого пропускает гейт.
Функция ПринципалСубъекта(Знач ГейтМутации)
	Возврат ГейтМутации.НачатьМутацию(Новый ОтветСтраницыЗаглушка(), Новый Соответствие(),
		Неопределено, "").Принципал;
КонецФункции

Процедура ПроверитьОтказ(Знач Ответ, Знач Слова)
	Ожидаем.Что(Ответ.Код, Слова + ": 403").Равно(403);
	Ожидаем.Что(КодОшибки(Ответ), Слова + ": код отказа").Равно("forbidden");
	Ожидаем.Что(Ошибка(Ответ)["message"], Слова + ": отказ назван словами").Содержит(Слова);
КонецПроцедуры

Функция КодОшибки(Знач Ответ)
	Возврат Ошибка(Ответ)["code"];
КонецФункции

Функция Ошибка(Знач Ответ)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ТелоТекст);
	Тело = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Тело["error"];
КонецФункции
