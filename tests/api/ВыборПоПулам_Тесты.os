&Тест
Процедура СписокПоПуламОбъединяетИменаОткрытыхПулов() Экспорт

	Стенд.ПоложитьВерсию(Стенд.ЗавестиПул("main"), "1.0.0");
	Extra = Стенд.ЗавестиПул("extra");
	Стенд.ПоложитьВерсию(Extra, "1.1.0");
	Стенд.ПоложитьИмя(Extra, "yabox");
	Стенд.ПоложитьИмя(Extra, "Winow");
	Стенд.ПоложитьИмя(Стенд.ЗавестиПул("team", Ложь), "secret-tool");

	Ответ = ВыдатьСписок();

	Ожидаем.Что(Ответ.Код, Ответ.ТелоТекст).Равно(200);
	Ожидаем.Что(Ответ.Заголовок("Content-Type")).Содержит("text/plain");
	Ожидаем.Что(Ответ.ТелоТекст, "имена открытых пулов без повторов и без учёта регистра, по алфавиту")
		.Равно("winow" + Символы.ПС + "yabox");
	Ожидаем.Что(Ответ.Заголовок("Cache-Control"), "состав зависит от того, кто спросил").Содержит("private");

