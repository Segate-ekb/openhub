	Ожидаем.Что(СтрСоединить(Итог.ОпрошенныеПулы, ","), "опрошенные — по порядку имён").Равно("Alpha,beta,main");

КонецПроцедуры

&Тест
Процедура ВерсияИсточникаПулаПроксиУчаствуетВСпоре() Экспорт

	Стенд.ПоложитьВерсию(Стенд.ЗавестиПул("main"), "1.1.0");
	Прокси = Стенд.ЗавестиПул("proxy");
	Стенд.ПоложитьВерсию(Прокси, "1.0.0");
	Стенд.ПредложитьИзИсточника(Прокси, "1.2.0");

	Итог = Выбор().Выбрать(Неопределено, "winow", "");

	Ожидаем.Что(Итог.Победитель.СтрокаВерсии).Равно("1.2.0");
	Ожидаем.Что(Итог.Победитель.Пул.Имя).Равно("proxy");
	Ожидаем.Что(Итог.Победитель.Апстрим, "версия источника не привезена — названа источником").Существует();
	Ожидаем.Что(Итог.Победитель.Версия, "записи версии в пуле ещё нет").Равно(Неопределено);

