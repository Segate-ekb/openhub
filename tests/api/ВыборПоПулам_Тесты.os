	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "team"), "закрытый пул не упомянут").Равно(0);
	Ожидаем.Что(Стенд.Запросы.Количество(), "файл ни у кого не просили").Равно(0);

