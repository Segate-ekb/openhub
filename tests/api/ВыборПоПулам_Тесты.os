&Тест
Процедура КлючСПривязкойНеОткрываетЧужойПубличныйПул() Экспорт

	Стенд.ПоложитьВерсию(Стенд.ЗавестиПул("public"), "1.2.0");
	Стенд.ПоложитьВерсию(Стенд.ЗавестиПул("secret", Ложь), "1.1.0");
	Привязанный = Новый Структура("Пользователь, Способ, Пул", Новый Структура("Идентификатор", 7), "token", "secret");

	Итог = Выбор().Выбрать(Привязанный, "winow", "");

	Ожидаем.Что(Итог.Победитель.Пул.Имя, "ключ, привязанный к secret, в public не пускают").Равно("secret");
	Ожидаем.Что(Итог.Победитель.СтрокаВерсии).Равно("1.1.0");
	Ожидаем.Что(СтрСоединить(Итог.ОпрошенныеПулы, ","), "круг — только пул привязки").Равно("secret");

	Стенд.ПринципалЗапроса = Привязанный;
	ВыдатьФайл("winow.ospx");
	Ожидаем.Что(СтрСоединить(Стенд.Запросы, ","), "файл — та же версия из того же пула").Равно("secret 1.1.0");

КонецПроцедуры

&Тест
Процедура СтаршаяОтсеянаДвижкомПобеждаетМладшаяДругогоПула() Экспорт

	Стенд.ПоложитьВерсию(Стенд.ЗавестиПул("main"), "1.2.0", "2.2.0");
	Стенд.ПоложитьВерсию(Стенд.ЗавестиПул("extra"), "1.1.0");

	ПодДвижок = Выбор().Выбрать(Неопределено, "winow", "", "2.0.0");
	БезДвижка = Выбор().Выбрать(Неопределено, "winow", "");

	Ожидаем.Что(ПодДвижок.Победитель.Пул.Имя, "старшая требует движок новее — побеждает младшая").Равно("extra");
	Ожидаем.Что(ПодДвижок.Победитель.СтрокаВерсии).Равно("1.1.0");
	Ожидаем.Что(БезДвижка.Победитель.СтрокаВерсии, "без engine — старшая").Равно("1.2.0");

