	Стенд.Отказать(Стенд.ЗавестиПул("bbb"), "нет");
	Стенд.Отказать(Стенд.ЗавестиПул("ccc"), "тег");

	Итог = Выбор().Выбрать(Неопределено, "winow", "stable");

	Ожидаем.Что(Итог.Найдена).ЭтоЛожь();
	Ожидаем.Что(Итог.Отказ.Пул.Имя, "«нет версии» точнее, чем «нет тега»").Равно("bbb");
	Ожидаем.Что(Итог.Отказ.Разрешение.ТегНеизвестен).ЭтоЛожь();

