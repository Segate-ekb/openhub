	Итог = Выбор().Выбрать(Неопределено, "winow", "^1.0", "1.9.0");

	Ожидаем.Что(Итог.Отказ.Пул.Имя).Равно("bbb");
	Ожидаем.Что(Итог.Отказ.Разрешение.ОтсеяноДвижком).ЭтоИстина();

