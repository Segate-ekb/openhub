КонецПроцедуры

Функция ВыдатьСписок(Знач Метод = "GET")

	Ответ = Новый ОтветСтраницыЗаглушка(Новый КукиОтветаЗаглушка());
	Контроллер().СписокПоПулам(Ответ, Метод, Новый Соответствие(), Новый КукиЗаглушка());
	Возврат Ответ;

КонецФункции

Функция ВыдатьФайл(Знач ИмяФайла, Знач Спецификация = "", Знач ВерсияДвижка = "")

	Ответ = Новый ОтветСтраницыЗаглушка(Новый КукиОтветаЗаглушка());
	Контроллер().ФайлПоПулам(Ответ, "winow", ИмяФайла, "GET", Новый Соответствие(), Новый КукиЗаглушка(),
		Спецификация, ВерсияДвижка);
	Возврат Ответ;

КонецФункции

Функция Контроллер()

	Сборка = Новый СборкаКонтроллераВыдачи(Логирование.ПолучитьЛог("тест.oshub.выборпопулам"));
	Сборка.Резолвер = Стенд;
	Сборка.Допуск = Стенд;
	Сборка.ВыборПоПулам = Выбор();
	Сборка.Совместимость = Новый СовместимостьСДвижком(Новый СравнительВерсий());
	Возврат Сборка.Собрать();

КонецФункции

Функция Выбор()
	Возврат Новый ВыборПоПулам(Стенд, Стенд, Стенд, Стенд, Стенд, Стенд, Новый СравнительВерсий());
КонецФункции

Функция СТокеном()
	Возврат Новый Структура("Пользователь, Способ", Новый Структура("Идентификатор", 7), "token");
КонецФункции
