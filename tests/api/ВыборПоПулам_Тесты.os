// Выбор версии по всем доступным пулам: круг — читаемые пулы, побеждает старшая, при равных —
// основной пул, затем первый по имени; пустой итог называет отказ дальше всех прошедшего пула.
// Список list.txt по всем пулам — имена открытых пулов без повторов.

#Использовать asserts
#Использовать autumn-logos
#Использовать errors
#Использовать "../фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Стенд;          // СтендВыбораПоПулам

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СтендВыбораПоПулам");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ЗагрузитьКлассы() Экспорт

	КаталогМодулей = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	КлассыРеестра = ОбъединитьПути(КаталогМодулей, "реестр", "Классы");
	ПоискКлассов.Подключить(КлассыРеестра, "РазобраннаяВерсия");
	ПоискКлассов.Подключить(КлассыРеестра, "СравнительВерсий");
	ПоискКлассов.Подключить(КлассыРеестра, "СовместимостьСДвижком");
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	КлассыAPI = ОбъединитьПути(КаталогМодулей, "api", "Классы");
	ПоискКлассов.Подключить(КлассыAPI, "ВыборПоПулам");
	ПоискКлассов.Подключить(КлассыAPI, "РезолверФайлаПакета");
	ПоискКлассов.Подключить(КлассыAPI, "КонтроллерВыдачиAPI");

	РеестрФикстур.Подключить("ДопускКПулуЗаглушка");
	РеестрФикстур.Подключить("СборкаКонтроллераВыдачи");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("КукиОтветаЗаглушка");
	РеестрФикстур.Подключить("КукиЗаглушка");

КонецПроцедуры

&ПередКаждым
Процедура НовыйСтенд() Экспорт
	Стенд = Новый СтендВыбораПоПулам();
КонецПроцедуры

&Тест
Процедура СтаршаяВерсияПобеждаетОсновнойПул() Экспорт

	Стенд.ПоложитьВерсию(Стенд.ЗавестиПул("main"), "1.0.0");
	Стенд.ПоложитьВерсию(Стенд.ЗавестиПул("team", Ложь), "1.1.0");

	Итог = Выбор().Выбрать(СТокеном(), "winow", "");

	Ожидаем.Что(Итог.Найдена).ЭтоИстина();
	Ожидаем.Что(Итог.Победитель.СтрокаВерсии, "старшая из найденных").Равно("1.1.0");
	Ожидаем.Что(Итог.Победитель.Пул.Имя, "пул старшей").Равно("team");

КонецПроцедуры

&Тест
Процедура ЗакрытыйПулВнеКругаАнонима() Экспорт

	Стенд.ПоложитьВерсию(Стенд.ЗавестиПул("main"), "1.0.0");
	Стенд.ПоложитьВерсию(Стенд.ЗавестиПул("team", Ложь), "1.1.0");

	Итог = Выбор().Выбрать(Неопределено, "winow", "");

	Ожидаем.Что(Итог.Победитель.СтрокаВерсии, "приватная версия анониму не видна").Равно("1.0.0");
	Ожидаем.Что(Итог.Победитель.Пул.Имя).Равно("main");
	Ожидаем.Что(СтрСоединить(Итог.ОпрошенныеПулы, ","), "закрытый пул не упоминается").Равно("main");

КонецПроцедуры

&Тест
Процедура РавныеВерсииОтдаютсяОсновномуПулу() Экспорт

	Стенд.ПоложитьВерсию(Стенд.ЗавестиПул("aaa"), "2.0.0");
	Стенд.ПоложитьВерсию(Стенд.ЗавестиПул("main"), "2.0.0");
	Стенд.ПоложитьВерсию(Стенд.ЗавестиПул("zzz"), "2.0.0");

	Итог = Выбор().Выбрать(Неопределено, "winow", "");

	Ожидаем.Что(Итог.Победитель.Пул.Имя, "при равных — основной").Равно("main");

КонецПроцедуры

&Тест
Процедура РавныеВерсииВнеОсновногоОтдаютсяПервомуПоИмени() Экспорт

	Стенд.ПоложитьВерсию(Стенд.ЗавестиПул("main"), "1.0.0");
	Стенд.ПоложитьВерсию(Стенд.ЗавестиПул("beta"), "2.0.0");
