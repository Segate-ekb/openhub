// Разметка схем у точек под /api/ без живого хаба: каждый объявленный ответ с телом и каждое JSON-тело
// запроса называют тип — класс дерева либо тип платформы; новая точка без схемы — красный до запуска хаба.

#Использовать asserts
#Использовать "../фикстуры"

Перем Маршруты;   // фикстура МаршрутыХаба — точки по исходникам
Перем Классы;     // Соответствие — имена классов src/модули

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("МаршрутыХаба");
	Модули = ОбъединитьПути(КаталогиПроекта.Корень(), "src", "модули");
	Маршруты = Новый МаршрутыХаба(Модули);

	Классы = Новый Соответствие();
	Для Каждого Файл Из НайтиФайлы(Модули, "*.os", Истина) Цикл
		Классы.Вставить(Файл.ИмяБезРасширения, Истина);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура КаждыйОтветСТеломНазываетТип() Экспорт

	Непокрытые = Новый Массив();
	Для Каждого Точка Из Точки() Цикл
		Если Точка.Ответы.Количество() = 0 Тогда
			Непокрытые.Добавить(Точка.Путь + ": ответы не объявлены &Возвращает");
		КонецЕсли;
		Для Каждого Ответ Из Точка.Ответы Цикл
			Если Ответ.Код = 304 Тогда
				Продолжить;
			КонецЕсли;
			Причина = ПричинаНегодногоТипа(Ответ.Тип);
			Если ЗначениеЗаполнено(Причина) Тогда
				Непокрытые.Добавить(СтрШаблон("%1 %2: %3", Точка.Путь, Ответ.Код, Причина));
			ИначеЕсли ЗначениеЗаполнено(Ответ.Элемент) И ЗначениеЗаполнено(ПричинаНегодногоТипа(Ответ.Элемент)) Тогда
				Непокрытые.Добавить(СтрШаблон("%1 %2: элемент %3", Точка.Путь, Ответ.Код, ПричинаНегодногоТипа(Ответ.Элемент)));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Непокрытые, Символы.ПС), "ответы точек под /api/ без годного типа").Равно("");

КонецПроцедуры

// Точка, которая читает JSON-тело, объявляет его схему типом параметра ТелоЗапросаОбъект.
&Тест
Процедура КаждоеТелоЗапросаНазываетТип() Экспорт

	Непокрытые = Новый Массив();
	Для Каждого Точка Из Точки() Цикл
		Если Точка.ЧитаетТело И НЕ Точка.ТелоДвоичное Тогда
			Причина = ПричинаНегодногоТипа(Точка.ТипТела);
			Если ЗначениеЗаполнено(Причина) Тогда
				Непокрытые.Добавить(СтрШаблон("%1: тело запроса — %2", Точка.Путь, Причина));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Непокрытые, Символы.ПС), "точки под /api/ без схемы тела запроса").Равно("");

КонецПроцедуры

// Тип, которого нет ни среди классов, ни среди типов платформы, winow молча выбросит из описания.
&Тест
Процедура НеизвестныйТипОтвергается() Экспорт
	Ожидаем.Что(ПричинаНегодногоТипа(""), "пустой тип").Не_().Равно("");
	Ожидаем.Что(ПричинаНегодногоТипа("ПулJSONОпечатка"), "опечатка").Не_().Равно("");
	Ожидаем.Что(ПричинаНегодногоТипа("ОтказJSON"), "класс дерева").Равно("");
	Ожидаем.Что(ПричинаНегодногоТипа("Строка"), "тип платформы").Равно("");
КонецПроцедуры

Функция Точки()
	Точки_ = Маршруты.ТочкиAPI();
	Ожидаем.Что(Точки_.Количество() > 60, СтрШаблон("точек под /api/ прочитано: %1", Точки_.Количество())).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Маршруты.НеПрочитанные(), Символы.ПС), "контроллеры прочитаны").Равно("");
	Возврат Точки_;
КонецФункции

Функция ПричинаНегодногоТипа(Знач ИмяТипа)

	Если НЕ ЗначениеЗаполнено(ИмяТипа) Тогда
		Возврат "тип не назван";
	КонецЕсли;
	Если Классы.Получить(ИмяТипа) <> Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат ?(Тип(ИмяТипа) = Неопределено, "тип не разобран", "");
	Исключение
		Возврат СтрШаблон("типа %1 нет", ИмяТипа);
	КонецПопытки;

КонецФункции
