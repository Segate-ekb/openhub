// Заглушка СервисаПакетов для дверей API: пакеты пулов задаёт тест.

Перем Пакеты;   // Соответствие: "пул/имя" -> пакет
Перем Номер;    // Число — последний выданный идентификатор

// Пакет пула для чтения.
//
// Параметры:
//  ПулИдентификатор - Число - пул.
//  Имя - Строка - имя пакета.
//
// Возвращаемое значение:
//  Структура, Неопределено - пакет либо Неопределено.
//
Функция ПакетДляЧтения(Знач ПулИдентификатор, Знач Имя) Экспорт
	Возврат Пакеты.Получить(Ключ(ПулИдентификатор, Имя));
КонецФункции

// Пакет пула для изменения.
//
// Параметры:
//  ПулИдентификатор - Число - пул.
//  Имя - Строка - имя пакета.
//
// Возвращаемое значение:
//  Структура, Неопределено - пакет либо Неопределено.
//
Функция НайтиПакет(Знач ПулИдентификатор, Знач Имя) Экспорт
	Возврат Пакеты.Получить(Ключ(ПулИдентификатор, Имя));
КонецФункции

// Заводит пакет в пуле.
//
// Параметры:
//  Пул - Структура - пул с полем Идентификатор.
//  Имя - Строка - имя пакета.
//  Скрыт - Булево - скрыт ли пакет (необязательный, по умолчанию Ложь).
//
Процедура ЗавестиПакет(Знач Пул, Знач Имя, Знач Скрыт = Ложь) Экспорт
	Номер = Номер + 1;
	Пакеты.Вставить(Ключ(Пул.Идентификатор, Имя), Новый Структура("Идентификатор, Имя, Скрыт, ПулИдентификатор",
		Номер, Имя, Скрыт, Пул.Идентификатор));
КонецПроцедуры

Функция Ключ(Знач ПулИдентификатор, Знач Имя)
	Возврат Формат(ПулИдентификатор, "ЧГ=0") + "/" + Имя;
КонецФункции

Процедура ПриСозданииОбъекта() Экспорт
	Пакеты = Новый Соответствие();
	Номер = 1000;
КонецПроцедуры
