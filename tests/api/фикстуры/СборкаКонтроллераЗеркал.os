// Сборка КонтроллераЗеркалAPI для модульных наборов: части называются именами, а не позициями,
// и правка конструктора контроллера видна здесь одним местом.

Перем СервисЗеркал Экспорт;    // СервисЗеркал либо его фейк
Перем ПрологПравки Экспорт;    // ПрологПравкиAPI либо его заглушка
Перем Очередь Экспорт;         // ОчередьСинхронизацииЗеркал; Неопределено — ветка до неё не доходит

// Собирает контроллер из заданных частей; протокол API и примитивы — настоящие.
//
// Возвращаемое значение:
//  КонтроллерЗеркалAPI - готовый к вызову точек маршрута.
//
Функция Собрать() Экспорт

	Заголовки = Новый ЗаголовкиHTTP();
	Ответы = Новый ОтветыAPI(Заголовки);
	Запрос = Новый ЗапросAPI(Ответы, Заголовки);
	Маршрут = Новый МаршрутAPI(Ответы, Новый КукиЗаглушка(), Новый МетодыHTTP());

	// допуск, двери, страницы, секрет и причины обхода проверяемым веткам не нужны
	Возврат Новый КонтроллерЗеркалAPI(Ответы, Запрос, Маршрут, Неопределено, Неопределено,
		ПрологПравки, Неопределено, СервисЗеркал, Очередь, Новый ПриведениеЧисел(), Новый МетодыHTTP(),
		Неопределено, Неопределено);

КонецФункции

Процедура ПриСозданииОбъекта() Экспорт
	СервисЗеркал = Неопределено;
	ПрологПравки = Неопределено;
	Очередь = Неопределено;
КонецПроцедуры
