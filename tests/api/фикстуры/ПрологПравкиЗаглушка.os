// Заглушка ПрологПравкиAPI: администрирование пула пропущено, тело запроса разобрано из JSON.

Перем Пул_;            // Структура — пул, чьё администрирование пропускается
Перем Пользователь_;   // Структура — субъект правки

// Администрирование пула: всегда пропущено.
//
// Параметры:
//  Ответ - Произвольный - ответ.
//  ИмяПула - Строка - имя пула из адреса.
//  ЗаголовкиЗапроса - Соответствие - заголовки запроса.
//  КукиЗапроса - Произвольный - куки запроса.
//  ТелоЗапроса - Строка - тело запроса JSON; пустое — пустое тело.
//
// Возвращаемое значение:
//  Структура - Пул, Тело, Пользователь, Принципал.
//
Функция АдминистрированиеПула(Ответ, Знач ИмяПула, Знач ЗаголовкиЗапроса, Знач КукиЗапроса,
	Знач ТелоЗапроса) Экспорт

	Принципал = Новый Структура("Пользователь, Способ", Пользователь_, "session");
	Возврат Новый Структура("Пул, Тело, Пользователь, Принципал",
		Пул_, РазобранноеТело(ТелоЗапроса), Пользователь_, Принципал);

КонецФункции

Функция РазобранноеТело(Знач ТелоЗапроса)

	Если НЕ ЗначениеЗаполнено(ТелоЗапроса) Тогда
		Возврат Новый Соответствие();
	КонецЕсли;

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(ТелоЗапроса);
	Тело = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Тело;

КонецФункции

Процедура ПриСозданииОбъекта() Экспорт
	Пул_ = Новый Структура("Идентификатор, Имя", 1, "secret");
	Пользователь_ = Новый Структура("Логин", "owner1");
КонецПроцедуры
