// BSLLS:YoLetterUsage-off
// Заглушка СлужбыКабинета для порога «управляет пакетом»: ответ задаёт тест.

Перем Управляет;   // Булево — ответ МожетУправлять

// Может ли пользователь управлять пакетом.
//
// Параметры:
//  Пользователь - Произвольный - субъект.
//  Пул - Структура - пул пакета.
//  Пакет - Структура - пакет.
//
// Возвращаемое значение:
//  Булево
//
Функция МожетУправлять(Знач Пользователь, Знач Пул, Знач Пакет) Экспорт
	Возврат Управляет;
КонецФункции

// Даёт право управлять любым пакетом.
//
Процедура Разрешить() Экспорт
	Управляет = Истина;
КонецПроцедуры

Процедура ПриСозданииОбъекта() Экспорт
	Управляет = Ложь;
КонецПроцедуры
