// Юнит-тесты полного цикла подтверждения адреса: регистрация шлёт письмо, ссылка из него
// подтверждает адрес один раз, чужая и просроченная не подтверждают ничего. Плюс защита
// от рассылки (суточный потолок, получатель только из учётки) и поведение хаба, у которого
// почта не настроена. Живого SMTP нет: транспорт подменён фейком.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать oscript-ui
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Счётчик;
Перем Транспорт; // ФейкОтправителяПисем
Перем UI;        // СборкаUI — граф рендера для проверки публичной страницы

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	Счётчик = 0;

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПодключитьСервисы(ОбъединитьПути(Модули, "данные", "Классы"));
	ПодключитьСервисы(ОбъединитьПути(Модули, "реестр", "Классы"));
	ПодключитьСервисы(ОбъединитьПути(Модули, "основа", "Классы"));
	// фон — синхронным фейком: письмо уходит заданием, а набор смотрит исход сразу,
	// и настоящий ЗапускВФонеЗаданием (модуль фоновыеЗадания) сделал бы из этого гонку
	РеестрФикстур.Подключить("ЗапускВФонеСинхронный");
	ПодключитьСервисы(ОбъединитьПути(Модули, "наблюдаемость", "Классы", "телеметрия"));
	ПодключитьСервисы(ОбъединитьПути(Модули, "события", "Классы"));

	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();

	Попытка
		ПодключитьСценарий(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"),
			"ИмяОбъектаАудита");
	Исключение
	КонецПопытки;

	// транспорт письма подменяется ДО подключения модуля почты: настоящий SMTP-отправитель
	// носит то же прозвище, и вдвоём с фейком они спорили бы за одно место в контейнере
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ФейкОтправителяПисем.os"));
	ПодключитьПочтуБезSMTP(ОбъединитьПути(Модули, "почта", "Классы"));
	// личный канал: письма подтверждения и восстановления ходят через него
	ПодключитьСервисы(ОбъединитьПути(Модули, "уведомления", "Классы"));

	ПодключитьСервисы(ОбъединитьПути(Модули, "вход", "Классы"));

	ПодключитьСервисы(ОбъединитьПути(Модули, "права", "Классы"));
	ПодключитьСервисы(ОбъединитьПути(Модули, "настройки", "Классы"));
	// резолвер ключей приезжает китом (#Использовать выше), словарь — свой
	ПодключитьПоИмени(ОбъединитьПути(Модули, "интерфейс", "Классы"), "СловарьТекстов");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ЗаписывающийПодписчик.os"));

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "подтверждение-адреса-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Транспорт = Желудь("ОтправительПисем");

	// Граф рендера и сама страница собираются ПОСЛЕ контейнера: контроллеру нужен winow,
	// и в юнит-контейнере ему не место. Страница проверяется здесь, а не в HTTP-наборе,
	// потому что настоящий токен есть только тут — его отдаёт подменённый транспорт.
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "СборкаUI.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ОтветСтраницыЗаглушка.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "КукиЗаглушка.os"));
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(Модули, "интерфейс", "Классы"));
	ПодключитьПоИмени(ОбъединитьПути(Модули, "вход", "Классы"), "ЗащитаCSRF");
	ПодключитьПоИмени(ОбъединитьПути(Модули, "интерфейс", "Классы"), "РазборФормы");
	ПодключитьПоИмени(ОбъединитьПути(Модули, "интерфейс", "Классы"), "СтраницаДоступа");
	ПодключитьПоИмени(ОбъединитьПути(Модули, "интерфейс", "Классы"),
		"КонтроллерПодтвержденияEmail");
	ПодключитьПоИмени(ОбъединитьПути(Модули, "вход", "Классы"), "КонтроллерАутентификации");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "КукиОтветаЗаглушка.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогТестов, "фикстуры", "ОтветВходаЗаглушка.os"));

	// самостоятельная регистрация закрыта, пока у хаба нет первого администратора
	Желудь("СервисПользователей").СоздатьПользователя("cnfadmin", "cnfadmin@example.org",
		"AdminPassw0rd", "admin");

КонецПроцедуры

&ПередКаждым
Процедура ПодготовитьХаб() Экспорт

	НастроитьПочту();
	Транспорт.ПадатьНаОтправке(Ложь);
	Транспорт.Очистить();

КонецПроцедуры

#Область ПолныйЦикл

&Тест
Процедура РегистрацияШлётПисьмоСоСсылкойПодтверждения() Экспорт

	Логин = УникальныйЛогин("cnf");
	Учётка = Зарегистрировать(Логин);

	Ожидаем.Что(Учётка.EmailПодтверждён = Истина, "новая учётка адрес не подтвердила")
		.ЭтоЛожь();
	Ожидаем.Что(Транспорт.Количество(), "письмо ушло ровно одно").Равно(1);

	Письмо = Транспорт.Последнее();
	Ожидаем.Что(Письмо.Кому, "письмо ушло на адрес учётки").Равно(Учётка.Email);
	Ожидаем.Что(Письмо.ОтКого, "отправитель — из настроек хаба").Равно("hub@example.com");
	Ожидаем.Что(СтрНайти(Письмо.Текст, "oshub_cnf_") > 0, "в письме значение ссылки")
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(Письмо.Текст, "https://hub.example.com/confirm-email?token=") > 0,
		"и полный адрес публичной страницы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Письмо.Текст, Логин) > 0, "письмо называет учётную запись")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПоСсылкеИзПисьмаАдресСтановитсяПодтверждённым() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("cnf"));
	Значение = ЗначениеИзПисьма();

	Исход = Подтверждение().Подтвердить(Значение, Неопределено, "203.0.113.7");

	Ожидаем.Что(Исход.Успех, "адрес подтверждён: " + Исход.Причина).ЭтоИстина();
	Ожидаем.Что(Пользователи().НайтиПоЛогину(Учётка.Логин).EmailПодтверждён = Истина,
		"флаг учётки поднят").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СырогоЗначенияСсылкиВБазеНет() Экспорт

	Зарегистрировать(УникальныйЛогин("cnf"));
	Значение = ЗначениеИзПисьма();
	Секрет = Сред(Значение, СтрНайти(Значение, "oshub_cnf_") + 10);

	Проверка = Подтверждение().Проверить(Значение);
	Ожидаем.Что(Проверка.Годна, "ссылка годна").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка(Проверка.Заявка.ХешТокена), Секрет),
		"в базе лежит хеш, а не секрет").Равно(0);
	Ожидаем.Что(СтрДлина(Строка(Проверка.Заявка.ХешТокена)), "и это sha256 в hex").Равно(64);

КонецПроцедуры

&Тест
Процедура СсылкаСрабатываетОдинРаз() Экспорт

	Зарегистрировать(УникальныйЛогин("cnf"));
	Значение = ЗначениеИзПисьма();

	Ожидаем.Что(Подтверждение().Подтвердить(Значение).Успех, "первый переход").ЭтоИстина();

	Повтор = Подтверждение().Подтвердить(Значение);
	Ожидаем.Что(Повтор.Успех, "второй переход не проходит").ЭтоЛожь();
	Ожидаем.Что(Повтор.Причина, "и называет себя погашенной")
		.Равно(Подтверждение().Причины().Погашена());

КонецПроцедуры

&Тест
Процедура ПросроченнаяСсылкаНеПодтверждает() Экспорт

	Зарегистрировать(УникальныйЛогин("cnf"));
	Значение = ЗначениеИзПисьма();
	Заявка = Подтверждение().Проверить(Значение).Заявка;

	Исход = Подтверждение().Подтвердить(Значение, Заявка.Истекает + 1);

	Ожидаем.Что(Исход.Успех, "после срока ссылка мертва").ЭтоЛожь();
	Ожидаем.Что(Исход.Причина, "код отказа — просрочена")
		.Равно(Подтверждение().Причины().Просрочена());

КонецПроцедуры

// Граница включительная: в саму секунду истечения ссылка уже не работает. Без этого
// теста «<» вместо «<=» жило бы незамеченным целую секунду на каждой ссылке.
&Тест
Процедура ВМоментИстеченияСсылкаУжеМертва() Экспорт

	Зарегистрировать(УникальныйЛогин("cnf"));
	Значение = ЗначениеИзПисьма();
	Заявка = Подтверждение().Проверить(Значение).Заявка;

	ЗаСекунду = Подтверждение().Проверить(Значение, Заявка.Истекает - 1);
	Ожидаем.Что(ЗаСекунду.Годна, "за секунду до истечения ссылка жива").ЭтоИстина();

	Ровно = Подтверждение().Проверить(Значение, Заявка.Истекает);
	Ожидаем.Что(Ровно.Годна, "ровно в момент истечения — уже нет").ЭтоЛожь();
	Ожидаем.Что(Ровно.Причина, "и это именно просрочка")
		.Равно(Подтверждение().Причины().Просрочена());

КонецПроцедуры

&Тест
Процедура ЧужойСекретНеотличимОтНесуществующейСсылки() Экспорт

	Зарегистрировать(УникальныйЛогин("cnf"));
	Значение = ЗначениеИзПисьма();
	Заявка = Подтверждение().Проверить(Значение).Заявка;

	Подделка = СтрШаблон("oshub_cnf_%1_%2", Заявка.Идентификатор,
		"00000000000000000000000000000000000000000000000000");

	Проверка = Подтверждение().Проверить(Подделка);
	Ожидаем.Что(Проверка.Годна, "чужой секрет не подходит").ЭтоЛожь();
	Ожидаем.Что(Проверка.Причина, "и отказ не рассказывает, что заявка существует")
		.Равно(Подтверждение().Причины().НетСсылки());

	Ожидаем.Что(Подтверждение().Проверить("мусор").Причина, "мусор — тот же отказ")
		.Равно(Подтверждение().Причины().НетСсылки());

	// то, что Число() съедает, а хранилище — нет: такой номер обязан отвалиться
	// разбором, а не пятисоткой драйвера базы
	Ожидаем.Что(Подтверждение().Проверить("oshub_cnf_1e300_abc").Причина,
		"номер заявки — только цифры").Равно(Подтверждение().Причины().НетСсылки());
	Ожидаем.Что(Подтверждение().Проверить("oshub_cnf_99999999999999999999_abc").Причина,
		"и разумной длины").Равно(Подтверждение().Причины().НетСсылки());

	// «нечего сравнивать» — это не «сравнили и сошлось»: пустой хеш не совпадает ни с чем,
	// включая другой пустой. Без этого заявка с пустым ХешТокена открывалась бы пустым
	// секретом, а пустой ХешТокен у заявки бывает — между двумя её сохранениями
	Секреты = Желудь("СекретПодтверждения");
	Ожидаем.Что(Секреты.Совпадают("", ""), "пустой хеш не совпадает с пустым").ЭтоЛожь();
	Ожидаем.Что(Секреты.Совпадают(Секреты.Хеш("что-то"), ""),
		"и настоящий хеш не совпадает с пустым").ЭтоЛожь();
	Ожидаем.Что(Секреты.Совпадают(Неопределено, Неопределено),
		"незаданный хеш — тоже «нечего сравнивать»").ЭтоЛожь();

КонецПроцедуры

// Оборотная сторона правила глазами человека: заявка, чей хеш в базе пуст, не открывается
// ни своим секретом, ни любым другим. Отказ даёт сравнение длин — пустому хешу
// противостоит 64-символьный sha256; само правило «незаполненное не совпадает ни с чем»
// стережётся выше, вызовом Совпадают("", "").
&Тест
Процедура ЗаявкаБезЗаписанногоХешаНеПодтверждаетАдрес() Экспорт

	Зарегистрировать(УникальныйЛогин("cnf"));
	Значение = ЗначениеИзПисьма();
	Заявка = Подтверждение().Проверить(Значение).Заявка;

	Заявка.ХешТокена = "";
	Заявка.Сохранить();

	Ожидаем.Что(Подтверждение().Проверить(Значение).Причина,
		"своим же секретом заявка без записанного хеша не открывается")
		.Равно(Подтверждение().Причины().НетСсылки());
	Ожидаем.Что(Подтверждение().Подтвердить(Значение, Неопределено, "203.0.113.9").Успех,
		"и адрес по ней не подтверждается").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СтраницаПодтверждения

// Переход по ссылке НЕ подтверждает адрес: почтовые клиенты и сканеры безопасности
// ходят по ссылкам сами, и одноразовый токен сгорал бы, не доехав до человека.
&Тест
Процедура GETСГоднымТокеномАдресНеПодтверждает() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("cnf"));
	Значение = ЗначениеИзПисьма();

	Ответ = ОткрытьСтраницу(Значение);

	Ожидаем.Что(Ответ.Код, "страница отдана").Равно(200);
	Ожидаем.Что(Пользователи().НайтиПоЛогину(Учётка.Логин).EmailПодтверждён = Истина,
		"адрес переходом по ссылке НЕ подтверждён").ЭтоЛожь();
	Ожидаем.Что(Подтверждение().Проверить(Значение).Годна,
		"и ссылка осталась годной — её не сожгли").ЭтоИстина();

КонецПроцедуры

// Раз подтверждает не переход, а кнопка, — форма с токеном обязана быть на странице,
// иначе подтвердить адрес нечем вовсе.
&Тест
Процедура GETСГоднымТокеномРисуетФормуСЭтимЖеТокеном() Экспорт

	Зарегистрировать(УникальныйЛогин("cnf"));
	Значение = ЗначениеИзПисьма();

	Тело = ОткрытьСтраницу(Значение).ТелоТекст;

	Ожидаем.Что(СтрНайти(Тело, "<form") > 0, "на странице есть форма").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, "method=""post""") > 0, "и она отправляется методом POST")
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тело, Значение) > 0, "форма несёт то же значение ссылки")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура POSTСГоднымТокеномПодтверждаетАдрес() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("cnf"));
	Значение = ЗначениеИзПисьма();

	Ответ = ОтправитьФорму(Значение);

	Ожидаем.Что(Пользователи().НайтиПоЛогину(Учётка.Логин).EmailПодтверждён = Истина,
		"адрес подтверждён кнопкой").ЭтоИстина();
	Ожидаем.Что(Подтверждение().Проверить(Значение).Причина,
		"и ссылка погашена").Равно(Подтверждение().Причины().Погашена());

	// человек пришёл сюда запертым снаружи: подтвердил — и уже внутри, без второго круга
	Ожидаем.Что(Ответ.Код, "страница уводит в кабинет").Равно(302);
	Ожидаем.Что(ЗначениеЗаполнено(Ответ.Куки.Значение(ИмяКукиСессии())),
		"сессия открыта тут же").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СменаАдреса

// Ссылка говорит о ТОМ адресе, на который её послали. Иначе достаточно было бы получить
// письмо на свой адрес, а потом вписать в учётку чужой и подтвердить его этой ссылкой.
&Тест
Процедура ПослеСменыАдресаСтараяСсылкаЕгоНеПодтверждает() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("cnf"));
	Значение = ЗначениеИзПисьма();

	Адреса().Сменить(Учётка, "victim@example.org");

	Исход = Подтверждение().Подтвердить(Значение);
	Ожидаем.Что(Исход.Успех, "старой ссылкой новый адрес не подтверждается").ЭтоЛожь();
	Ожидаем.Что(Исход.Причина, "код отказа — адрес сменился")
		.Равно(Подтверждение().Причины().АдресСменился());
	Ожидаем.Что(Пользователи().НайтиПоЛогину(Учётка.Логин).EmailПодтверждён = Истина,
		"чужой адрес подтверждённым не стал").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СменаАдресаСнимаетПодтверждениеИЦиклПовторяется() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("cnf"));
	Подтверждение().Подтвердить(ЗначениеИзПисьма());
	Ожидаем.Что(Пользователи().НайтиПоЛогину(Учётка.Логин).EmailПодтверждён = Истина,
		"адрес подтверждён").ЭтоИстина();

	Адреса().Сменить(Учётка, УникальныйЛогин("new") + "@example.org");
	Ожидаем.Что(Учётка.EmailПодтверждён = Истина, "смена адреса сняла подтверждение")
		.ЭтоЛожь();

	Транспорт.Очистить();
	Итог = Подтверждение().Запросить(Учётка);
	Ожидаем.Что(Итог.Отправлено, "новый адрес попадает в тот же цикл: " + Итог.Причина)
		.ЭтоИстина();
	Ожидаем.Что(Транспорт.Последнее().Кому, "письмо ушло на НОВЫЙ адрес").Равно(Учётка.Email);

КонецПроцедуры

&Тест
Процедура НовоеПисьмоГаситПрежнююЖивуюСсылку() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("cnf"));
	Прежняя = ЗначениеИзПисьма();

	Транспорт.Очистить();
	Подтверждение().Запросить(Учётка);
	Новая = ЗначениеИзПисьма();

	Ожидаем.Что(Подтверждение().Проверить(Прежняя).Причина, "прежняя ссылка погашена")
		.Равно(Подтверждение().Причины().Погашена());
	Ожидаем.Что(Подтверждение().Проверить(Новая).Годна, "новая работает").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УжеПодтверждённомуАдресуПисемНеШлют() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("cnf"));
	Подтверждение().Подтвердить(ЗначениеИзПисьма());

	Транспорт.Очистить();
	Итог = Подтверждение().Запросить(Учётка);

	Ожидаем.Что(Итог.Отправлено, "подтверждать нечего").ЭтоЛожь();
	Ожидаем.Что(Итог.Причина, "код отказа").Равно(Подтверждение().Причины().УжеПодтверждён());
	Ожидаем.Что(Транспорт.Количество(), "письма нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ЗащитаОтРассылки

// Владелец снял потолки писем: «Убрать совсем… пока мы принимаем как осознанный риск,
// возможность рассылать много сообщений». Значит повторы не запираются ничем — ни счётом
// по учётке, ни по адресу получателя, ни по источнику запроса.
&Тест
Процедура ПовторыПисемНеЗапираютсяНичем() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("cnf"));
	Транспорт.Очистить();

	Для Счёт = 1 По 30 Цикл
		Ожидаем.Что(Подтверждение().Запросить(Учётка, , "198.51.100.9").Отправлено,
			"письмо № " + Формат(Счёт, "ЧГ=0") + " ушло").ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(Транспорт.Количество(), "все тридцать писем ушли").Равно(30);

КонецПроцедуры

// Уборка истёкших заявок больше ничего не считает: считать нечего, и мёртвая ссылка
// после уборки становится неизвестной, а не «просроченной внутри окна счёта».
&Тест
Процедура УборкаУноситИстёкшуюЗаявку() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("cnf"));
	Учётка = Учётка;
	Значение = ЗначениеИзПисьма();

	ЧерезДваДня = ТекущаяУниверсальнаяДата() + 200000;
	Ожидаем.Что(Подтверждение().УдалитьПросроченные(ЧерезДваДня) >= 1,
		"истёкшая заявка удалена").ЭтоИстина();

	Ожидаем.Что(Подтверждение().Проверить(Значение).Причина, "и ссылки больше нет")
		.Равно(Подтверждение().Причины().НетСсылки());

КонецПроцедуры

&Тест
Процедура ПолучательПисьмаБерётсяТолькоИзУчётки() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("cnf"));
	Транспорт.Очистить();

	Подтверждение().Запросить(Учётка);

	Ожидаем.Что(Транспорт.Последнее().Кому, "адресата называет учётка, а не вызывающий")
		.Равно(Учётка.Email);

КонецПроцедуры

#КонецОбласти

// Первая застава на пути рассылки — уникальность адреса (ИСТ-ДОСТ-029): вторую учётку
// на чужой ящик не завести вовсе, и поток писем обрывается на первом же повторе.
&Тест
Процедура ВтораяРегистрацияНаТотЖеЯщикНеЗаводится() Экспорт

	Жертва = "victim" + НРег(Прав(Строка(Новый УникальныйИдентификатор), 8)) + "@example.net";
	Транспорт.Очистить();

	Регистрация().Зарегистрировать(УникальныйЛогин("spam"), Жертва, "Password123!", "203.0.113.1");

	Повторный = УникальныйЛогин("spam");
	Отказ = "";
	Попытка
		Регистрация().Зарегистрировать(Повторный, Жертва, "Password123!", "203.0.113.2");
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(Отказ, "email_taken") > 0, "повтор отвергнут: " + Отказ).ЭтоИстина();
	Ожидаем.Что(Пользователи().НайтиПоЛогину(Повторный) = Неопределено,
		"второй учётки нет").ЭтоИстина();
	Ожидаем.Что(Транспорт.Количество(), "и письмо ушло ровно одно").Равно(1);

КонецПроцедуры

// Уникальность держит адрес за учёткой, пока та его не отпустит. Отпустив (смена адреса
// в кабинете), ящик отдают следующей учётке — и писем на него уходит столько, сколько
// учёток завели. Это и есть принятый владельцем риск, названный прямо.
&Тест
Процедура ЭстафетаУчётокШлётПисьмаБезСчёта() Экспорт

	Жертва = "victim" + НРег(Прав(Строка(Новый УникальныйИдентификатор), 8)) + "@example.net";
	Транспорт.Очистить();

	Для Попытка_ = 1 По 8 Цикл
		Логин = УникальныйЛогин("relay");
		Учётка = Регистрация().Зарегистрировать(Логин, Жертва, "Password123!",
			"203.0.113." + Формат(Попытка_, "ЧГ=0"));
		Адреса().Сменить(Учётка, Логин + "@example.org");
	КонецЦикла;

	Ожидаем.Что(Транспорт.Количество(),
		"на один чужой ящик уходит письмо от каждой учётки: счёта у хаба нет").Равно(8);

КонецПроцедуры

// КОНТРОЛЬ: потолки не запирают обычную регистрацию — письмо получает каждый.
&Тест
Процедура ОбычныеРегистрацииПисьмаПолучают() Экспорт

	Транспорт.Очистить();

	Для Попытка_ = 1 По 3 Цикл
		Логин = УникальныйЛогин("normal");
		Регистрация().Зарегистрировать(Логин, Логин + "@example.org", "Password123!",
			"192.0.2." + Формат(Попытка_, "ЧГ=0"));
	КонецЦикла;

	Ожидаем.Что(Транспорт.Количество(), "три разных человека — три письма").Равно(3);

КонецПроцедуры

#Область ПочтаНеНастроена

// Подтверждение обещано, а слать письма нечем — учётная запись не заводится вовсе:
// иначе она осталась бы с неподтверждённым адресом навсегда, и никто бы не заметил.
&Тест
Процедура БезНастроеннойПочтыРегистрацияОтказывает() Экспорт

	ВыключитьПочту();

	Логин = УникальныйЛогин("cnf");
	Отказ = ОтказРегистрации(Логин);

	Ожидаем.Что(ЗначениеЗаполнено(Отказ), "регистрация отклонена").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отказ, "registration_mail_not_configured") > 0,
		"код причины назван: " + Отказ).ЭтоИстина();
	Ожидаем.Что(Пользователи().НайтиПоЛогину(Логин) = Неопределено,
		"учётной записи в базе нет").ЭтоИстина();
	Ожидаем.Что(Транспорт.Количество(), "и письма, конечно, тоже нет").Равно(0);

КонецПроцедуры

// Тот же отказ на входе API: адрес отвечает 503 «дело в настройке хаба», а не 400
// «проверьте, что вы ввели».
&Тест
Процедура БезНастроеннойПочтыAPIРегистрацииОтвечает503() Экспорт

	ВыключитьПочту();

	Логин = УникальныйЛогин("cnf");
	Ответ = ЗарегистрироватьПоAPI(Логин, Логин + "@example.org", "203.0.113.5");

	Ожидаем.Что(Ответ.Состояние, "состояние хаба, а не данные человека").Равно(503);
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "registration_mail_not_configured") > 0,
		"код причины в теле: " + Ответ.ТелоТекст).ЭтоИстина();
	Ожидаем.Что(Пользователи().НайтиПоЛогину(Логин) = Неопределено,
		"учётной записи в базе нет").ЭтоИстина();

КонецПроцедуры

// Выключенное подтверждение снимает условие: почты нет, регистрация работает,
// писем хаб не шлёт.
&Тест
Процедура ВыключенноеПодтверждениеОткрываетРегистрациюБезПочты() Экспорт

	ВыключитьПочту();
	Настройки().Установить("oshub.auth.email.confirm.enabled", Ложь, "тест");

	Логин = УникальныйЛогин("cnf");
	Учётка = Регистрация().Зарегистрировать(Логин, Логин + "@example.org", "Password123!");

	Ожидаем.Что(Учётка, "учётка заведена").Существует();
	Ожидаем.Что(Учётка.Активен = Истина, "и активна").ЭтоИстина();
	Ожидаем.Что(Транспорт.Количество(), "писем хаб не шлёт").Равно(0);

КонецПроцедуры

// На умолчаниях правило действует так же: свежая инсталляция (подтверждение включено,
// почта выключена) регистраций не принимает, пока администратор не выбрал одно из двух.
&Тест
Процедура НаУмолчанияхИнсталляцииРегистрацияЗакрыта() Экспорт

	Настройки().Сбросить("oshub.mail.enabled", "тест");
	Настройки().Сбросить("oshub.mail.smtp.host", "тест");
	Настройки().Сбросить("oshub.mail.from", "тест");
	Настройки().Сбросить("oshub.auth.email.confirm.enabled", "тест");

	Ожидаем.Что(Настройки().Значение("oshub.auth.email.confirm.enabled") = Истина,
		"умолчание реестра: подтверждение включено").ЭтоИстина();
	Ожидаем.Что(Настройки().Значение("oshub.mail.enabled") = Истина,
		"умолчание реестра: почта выключена").ЭтоЛожь();

	Логин = УникальныйЛогин("cnf");
	Отказ = ОтказРегистрации(Логин);

	Ожидаем.Что(СтрНайти(Отказ, "registration_mail_not_configured") > 0,
		"свежая инсталляция регистраций не принимает: " + Отказ).ЭтоИстина();
	Ожидаем.Что(Пользователи().НайтиПоЛогину(Логин) = Неопределено,
		"учётной записи в базе нет").ЭтоИстина();

КонецПроцедуры

// Домен по-прежнему честно называет причину, когда письмо просят у учётки, заведённой
// администратором: регистрация закрыта, а такие учётки заводятся мимо неё.
&Тест
Процедура БезНастроеннойПочтыДоменНазываетПричину() Экспорт

	Учётка = ЗавестиУчётку(УникальныйЛогин("cnf"));
	ВыключитьПочту();

	Итог = Подтверждение().Запросить(Учётка);

	Ожидаем.Что(Итог.Отправлено, "письма нет").ЭтоЛожь();
	Ожидаем.Что(Итог.Причина, "домен честно называет причину")
		.Равно(Подтверждение().Причины().ПочтаНеНастроена());

КонецПроцедуры

&Тест
Процедура БезАдресаИнстансаПисьмоНеУходит() Экспорт

	Настройки().Установить("oshub.instance.url", "", "тест");

	Учётка = ЗавестиУчётку(УникальныйЛогин("cnf"));
	Транспорт.Очистить();
	Итог = Подтверждение().Запросить(Учётка);

	Ожидаем.Что(Итог.Отправлено, "ссылка в письме вела бы в никуда").ЭтоЛожь();
	Ожидаем.Что(Итог.Причина, "код отказа").Равно(Подтверждение().Причины().НетАдресаХаба());
	Ожидаем.Что(Транспорт.Количество(), "письма нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ВыключенноеПодтверждениеГаситВыпускНоНеУжеВыданнуюСсылку() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("cnf"));
	Значение = ЗначениеИзПисьма();

	Настройки().Установить("oshub.auth.email.confirm.enabled", Ложь, "тест");

	Транспорт.Очистить();
	Итог = Подтверждение().Запросить(Учётка);
	Ожидаем.Что(Итог.Отправлено, "новых писем нет").ЭтоЛожь();
	Ожидаем.Что(Итог.Причина, "код отказа").Равно(Подтверждение().Причины().Выключено());

	Исход = Подтверждение().Подтвердить(Значение);
	Ожидаем.Что(Исход.Успех, "уже посланная ссылка остаётся доказательством владения")
		.ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОтказСервераНеРоняетРегистрацию() Экспорт

	Транспорт.ПадатьНаОтправке(Истина);

	Логин = УникальныйЛогин("cnf");
	Учётка = Регистрация().Зарегистрировать(Логин, Логин + "@example.org", "Password123!");

	Ожидаем.Что(Учётка, "учётка заведена, несмотря на сломанный SMTP").Существует();
	Ожидаем.Что(Пользователи().НайтиПоЛогину(Логин), "и найдена в базе").Существует();

КонецПроцедуры

// Профиль провайдера без адреса рождает учётку вовсе без почты. Письма ей не
// выпускаются, и домен называет причину отдельным кодом, а не общим отказом.
&Тест
Процедура УчёткеБезАдресаПисьмаНеВыпускаются() Экспорт

	Безадресный = Пользователи().СоздатьПользователя(УникальныйЛогин("noaddr"), "",
		"Password123!");
	Транспорт.Очистить();

	Итог = Подтверждение().Запросить(Безадресный);

	Ожидаем.Что(Итог.Отправлено, "письма нет").ЭтоЛожь();
	Ожидаем.Что(Итог.Причина, "и это именно «у учётки нет адреса»")
		.Равно(Подтверждение().Причины().НетАдреса());
	Ожидаем.Что(Транспорт.Количество(), "транспорт не трогали вовсе").Равно(0);
	Ожидаем.Что(Итог.Заявка, "и заявка не выпускалась").Равно(Неопределено);

КонецПроцедуры

// Пустой профиль не оставляет человека с учёткой, которую невозможно довести
// до подтверждённого состояния: он вписывает адрес в кабинете и проходит цикл.
&Тест
Процедура УчёткаБезАдресаДоводитсяДоПодтверждённой() Экспорт

	Логин = УникальныйЛогин("noaddr");
	Безадресный = Пользователи().СоздатьПользователя(Логин, "", "Password123!");

	Адреса().Сменить(Безадресный, Логин + "@example.org");
	Транспорт.Очистить();

	Итог = Подтверждение().Запросить(Пользователи().ПоИдентификатору(Безадресный.Идентификатор));
	Ожидаем.Что(Итог.Отправлено, "письмо ушло: " + Итог.Причина).ЭтоИстина();

	Исход = Подтверждение().Подтвердить(ЗначениеИзПисьма());
	Ожидаем.Что(Исход.Успех, "цикл подтверждения достижим: " + Исход.Причина).ЭтоИстина();
	Ожидаем.Что(Пользователи().НайтиПоЛогину(Логин).EmailПодтверждён = Истина,
		"адрес подтверждён").ЭтоИстина();

КонецПроцедуры

// Страница /confirm-email вошедшему без адреса называет причину, а не рисует кнопку
// «выслать ещё раз», которая ничего не сделает.
&Тест
Процедура СтраницаБезАдресаНазываетПричинуАНеПредлагаетКнопку() Экспорт

	Безадресный = Пользователи().СоздатьПользователя(УникальныйЛогин("noaddr"), "",
		"Password123!");

	Ответ = СтраницаОтИмени(Безадресный);

	Ожидаем.Что(Ответ.Код, "страница отдана").Равно(200);
	Тексты = Желудь("ТекстыИнтерфейса");
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, Тексты.Текст("confirm.page.state.noemail")) > 0,
		"страница называет «у учётки нет адреса»: " + Лев(Ответ.ТелоТекст, 600)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, Тексты.Текст("confirm.page.resend.button")),
		"кнопки повтора, которая ничего не даст, нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ВосстановлениеПароля

// Со страницы входа есть путь «забыли пароль»: человек называет логин, и хаб шлёт
// письмо со ссылкой смены пароля. Работает и по адресу — люди помнят почту лучше логина.
&Тест
Процедура ПоЛогинуИПоАдресуУходитПисьмоСоСсылкой() Экспорт

	Учётка = УчёткаСДоказаннымАдресом("rec");
	Транспорт.Очистить();

	Исход = Восстановление().Запросить(Учётка.Логин, Неопределено, "203.0.113.20");

	Ожидаем.Что(Исход.Принято, "запрос принят").ЭтоИстина();
	Ожидаем.Что(Транспорт.Количество(), "письмо ушло ровно одно").Равно(1);
	Письмо = Транспорт.Последнее();
	Ожидаем.Что(Письмо.Кому, "письмо ушло на адрес учётки").Равно(Учётка.Email);
	Ожидаем.Что(СтрНайти(Письмо.Текст, "oshub_inv_") > 0, "в письме значение ссылки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Письмо.Текст, "https://hub.example.com/invite?token=") > 0,
		"и полный адрес страницы установки пароля").ЭтоИстина();

	Транспорт.Очистить();
	Ожидаем.Что(Восстановление().Запросить(ВРег(Учётка.Email), Неопределено, "203.0.113.21").Принято,
		"по адресу — тот же путь").ЭтоИстина();
	Ожидаем.Что(Транспорт.Количество(), "и то же письмо").Равно(1);

КонецПроцедуры

// ЛОВУШКА ТРЕБОВАНИЯ: флаг «адрес подтверждён» поднимает и клейм внешнего провайдера,
// а он переживает и отвязку личности, и снос провайдера целиком. Восстановление верит
// только собственному подтверждению хаба — иначе владелец учётки в снесённом IdP
// получил бы ссылку смены пароля.
&Тест
Процедура КлеймоПровайдераСсылкиСбросаНеДаёт() Экспорт

	Логин = УникальныйЛогин("idp");
	Учётка = ЗавестиУчётку(Логин);
	// ровно то, что делает вход через провайдера: флаг поднят, письма хаба не было
	Адреса().Подтвердить(Учётка);

	Ожидаем.Что(Пользователи().ПоИдентификатору(Учётка.Идентификатор).EmailПодтверждён = Истина,
		"адрес числится подтверждённым").ЭтоИстина();
	Ожидаем.Что(Адреса().ДоказанХабом(
		Пользователи().ПоИдентификатору(Учётка.Идентификатор)),
		"но собственного подтверждения хаба нет").ЭтоЛожь();

	Транспорт.Очистить();
	Исход = Восстановление().Запросить(Логин, Неопределено, "203.0.113.22");

	Ожидаем.Что(Исход.Причина, "внутренний исход — адрес не доказан")
		.Равно(Восстановление().ИсходАдресНеДоказан());
	Ожидаем.Что(Транспорт.Количество(), "письма нет").Равно(0);

	// а после собственного письма хаба — тот же адрес уже даёт восстановление
	Итог = Подтверждение().Запросить(Пользователи().ПоИдентификатору(Учётка.Идентификатор));
	Ожидаем.Что(Итог.Причина, "письмо подтверждения выпущено")
		.Равно(Подтверждение().Причины().УжеПодтверждён());

КонецПроцедуры

// Второй конец той же ловушки: адрес, доказанный ссылкой хаба, восстановление даёт.
&Тест
Процедура СобственноеПодтверждениеХабаСсылкуСбросаДаёт() Экспорт

	Учётка = УчёткаСДоказаннымАдресом("own");

	Ожидаем.Что(Адреса().ДоказанХабом(Учётка),
		"адрес доказан собственным письмом хаба").ЭтоИстина();

	Транспорт.Очистить();
	Исход = Восстановление().Запросить(Учётка.Логин, Неопределено, "203.0.113.23");

	Ожидаем.Что(Исход.Причина, "ссылка выслана").Равно(Восстановление().ИсходОтправлено());

КонецПроцедуры

// Смена адреса снимает и собственное подтверждение: доказан был ПРЕЖНИЙ ящик.
&Тест
Процедура СменаАдресаСнимаетДоказательствоХаба() Экспорт

	Учётка = УчёткаСДоказаннымАдресом("moved");
	Адреса().Сменить(Учётка, УникальныйЛогин("moved") + "@example.org");

	Свежая = Пользователи().ПоИдентификатору(Учётка.Идентификатор);
	Ожидаем.Что(Адреса().ДоказанХабом(Свежая), "новый ящик хаб не проверял")
		.ЭтоЛожь();

	Транспорт.Очистить();
	Ожидаем.Что(Восстановление().Запросить(Свежая.Логин, Неопределено, "203.0.113.24").Причина,
		"ссылка на непроверенный ящик не уходит")
		.Равно(Восстановление().ИсходАдресНеДоказан());
	Ожидаем.Что(Транспорт.Количество(), "письма нет").Равно(0);

КонецПроцедуры

// Перебором логинов и адресов существующие учётки не вычисляются: исход одинаков.
&Тест
Процедура ОтветОдинаковДляСуществующейИНесуществующейУчётки() Экспорт

	Учётка = УчёткаСДоказаннымАдресом("same");

	Есть = Восстановление().Запросить(Учётка.Логин, Неопределено, "203.0.113.25");
	Нет = Восстановление().Запросить("нетакого" + УникальныйЛогин("x"), Неопределено, "203.0.113.26");
	НетАдреса = Восстановление().Запросить("никого@example.net", Неопределено, "203.0.113.27");

	Ожидаем.Что(Есть.Принято, "исход существующей").ЭтоИстина();
	Ожидаем.Что(Нет.Принято, "исход несуществующей — такой же").ЭтоИстина();
	Ожидаем.Что(НетАдреса.Принято, "и по несуществующему адресу — такой же").ЭтоИстина();

КонецПроцедуры

// Ссылка одноразовая: по ней ставят пароль ровно раз.
&Тест
Процедура СсылкаВосстановленияСрабатываетОдинРаз() Экспорт

	Учётка = УчёткаСДоказаннымАдресом("once");
	Транспорт.Очистить();
	Восстановление().Запросить(Учётка.Логин, Неопределено, "203.0.113.28");
	Значение = СсылкаИзПисьма();

	Первый = Приглашения().Погасить(Значение, "NewPassw0rd!");
	Ожидаем.Что(Первый.Успех, "первый переход: " + Первый.Причина).ЭтоИстина();

	Второй = Приглашения().Погасить(Значение, "OtherPassw0rd!");
	Ожидаем.Что(Второй.Успех, "второй переход не проходит").ЭтоЛожь();
	Ожидаем.Что(Второй.Причина, "и называет себя погашенной")
		.Равно(Приглашения().ПричинаПогашена());

КонецПроцедуры

// Просроченная ссылка не срабатывает, и граница включительная: в саму секунду
// истечения она уже мертва.
&Тест
Процедура ПросроченнаяСсылкаВосстановленияНеСрабатывает() Экспорт

	Учётка = УчёткаСДоказаннымАдресом("exp");
	Транспорт.Очистить();
	Восстановление().Запросить(Учётка.Логин, Неопределено, "203.0.113.29");
	Значение = СсылкаИзПисьма();
	Заявка = Приглашения().Проверить(Значение).Заявка;

	ЗаСекунду = Приглашения().Проверить(Значение, Заявка.Истекает - 1);
	Ожидаем.Что(ЗаСекунду.Годна, "за секунду до истечения ссылка жива").ЭтоИстина();

	Ровно = Приглашения().Проверить(Значение, Заявка.Истекает);
	Ожидаем.Что(Ровно.Годна, "ровно в момент истечения — уже нет").ЭтоЛожь();
	Ожидаем.Что(Ровно.Причина, "и это именно просрочка")
		.Равно(Приглашения().ПричинаПросрочена());

	Исход = Приглашения().Погасить(Значение, "NewPassw0rd!", Заявка.Истекает + 1);
	Ожидаем.Что(Исход.Успех, "после срока пароль по ней не задать").ЭтоЛожь();

КонецПроцедуры

// Выпущенная до предыдущей ссылка не срабатывает: годной у учётки в каждый момент
// не больше одной.
&Тест
Процедура ПредыдущаяСсылкаВосстановленияГаснетНовой() Экспорт

	Учётка = УчёткаСДоказаннымАдресом("prev");
	Транспорт.Очистить();
	Восстановление().Запросить(Учётка.Логин, Неопределено, "203.0.113.30");
	Первая = СсылкаИзПисьма();

	Транспорт.Очистить();
	Восстановление().Запросить(Учётка.Логин, Неопределено, "203.0.113.31");
	Вторая = СсылкаИзПисьма();
	Ожидаем.Что(Первая = Вторая, "ссылки разные").ЭтоЛожь();

	Исход = Приглашения().Погасить(Первая, "NewPassw0rd!");
	Ожидаем.Что(Исход.Успех, "прежняя ссылка мертва").ЭтоЛожь();
	Ожидаем.Что(Исход.Причина, "её погасил выпуск следующей")
		.Равно(Приглашения().ПричинаПогашена());
	Ожидаем.Что(Приглашения().Погасить(Вторая, "NewPassw0rd!").Успех,
		"а свежая работает").ЭтоИстина();

КонецПроцедуры

// Новый пароль проверяется той же политикой, что и при регистрации, а отказ называет
// требования человеческим текстом. Слабый пароль ссылку не гасит.
&Тест
Процедура НовыйПарольПроверяетсяТойЖеПолитикой() Экспорт

	Учётка = УчёткаСДоказаннымАдресом("weak");
	Транспорт.Очистить();
	Восстановление().Запросить(Учётка.Логин, Неопределено, "203.0.113.32");
	Значение = СсылкаИзПисьма();

	Слабый = Приглашения().Погасить(Значение, "1");
	Ожидаем.Что(Слабый.Успех, "слабый пароль отвергнут").ЭтоЛожь();
	Ожидаем.Что(Слабый.Причина).Равно(Приглашения().ПричинаПароль());
	Ожидаем.Что(ЗначениеЗаполнено(Слабый.Требования),
		"отказ называет требования человеческим текстом: " + Слабый.Требования).ЭтоИстина();
	Ожидаем.Что(Слабый.Требования, "и это тот же текст, что у политики")
		.Равно(Желудь("ПолитикаПароля").ОписаниеОднойСтрокой());

	Ожидаем.Что(Приглашения().Погасить(Значение, "NewPassw0rd!").Успех,
		"ссылка от слабого пароля не сгорела").ЭтоИстина();

КонецПроцедуры

// На хабе без настроенной почты путь восстановления не притворяется работающим.
&Тест
Процедура БезПочтыВосстановлениеНедоступно() Экспорт

	Учётка = УчёткаСДоказаннымАдресом("nomail");
	ВыключитьПочту();

	Ожидаем.Что(Восстановление().Доступно(), "путь закрыт").ЭтоЛожь();

	Транспорт.Очистить();
	Исход = Восстановление().Запросить(Учётка.Логин, Неопределено, "203.0.113.33");
	Ожидаем.Что(Исход.Причина, "и внутренний исход это называет")
		.Равно(Восстановление().ИсходНедоступно());
	Ожидаем.Что(Транспорт.Количество(), "письма нет").Равно(0);

КонецПроцедуры

// Потолка у писем восстановления нет — как и у писем подтверждения: владелец снял обе
// защиты одним решением и назвал рассылку без счёта принятым риском.
&Тест
Процедура ПовторыВосстановленияНеЗапираютсяНичем() Экспорт

	Учётка = УчёткаСДоказаннымАдресом("flood");
	Транспорт.Очистить();

	Для Попытка_ = 1 По 12 Цикл
		Ожидаем.Что(Восстановление().Запросить(Учётка.Логин, Неопределено, "203.0.113.34").Причина,
			"письмо № " + Формат(Попытка_, "ЧГ=0") + " ушло")
			.Равно(Восстановление().ИсходОтправлено());
	КонецЦикла;

	Ожидаем.Что(Транспорт.Количество(), "все двенадцать писем ушли").Равно(12);

КонецПроцедуры

// Секрета ссылки восстановления в журнале аудита нет и быть не может.
&Тест
Процедура ЗначениеСсылкиВосстановленияВЖурналНеПопадает() Экспорт

	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель = Желудь("ИздательСобытий");
	Издатель.Подписать(Издатель.ТипПриглашениеУчётки(), Слушатель);

	Учётка = УчёткаСДоказаннымАдресом("audit");
	Транспорт.Очистить();
	Восстановление().Запросить(Учётка.Логин, Неопределено, "203.0.113.35");
	Значение = СсылкаИзПисьма();
	Секрет = Сред(Значение, СтрНайти(Значение, "oshub_inv_") + 10);

	Найдено = Ложь;
	Для Каждого Событие Из Слушатель.События Цикл
		Если СтрНайти(Строка(Событие.Данные.Объект), Учётка.Логин) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Найдено = Истина;
		Ожидаем.Что(СтрНайти(Строка(Событие.Данные.ДеталиJSON), Секрет),
			"секрета ссылки в деталях события нет").Равно(0);
		Ожидаем.Что(СтрНайти(Строка(Событие.Данные.ДеталиJSON), "oshub_inv_"),
			"и самого значения ссылки тоже").Равно(0);
	КонецЦикла;

	Ожидаем.Что(Найдено, "события учётки в журнале есть").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ВходДоПодтверждения

// Ради чего затеян весь цикл: пока адрес не подтверждён, паролем в хаб не войти.
&Тест
Процедура НеподтверждённыйАдресВходаНеДаёт() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("gate"));

	Исход = Вход().ВойтиПоПаролю(Учётка.Логин, "Password123!", "203.0.113.70");

	Ожидаем.Что(Исход.Успех, "вход закрыт").ЭтоЛожь();
	Ожидаем.Что(Исход.Причина, "и называет причину").Равно("email_not_confirmed");
	Ожидаем.Что(Исход.Сессия = Неопределено, "сессии не открылось").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПодтверждённыйАдресВходОткрывает() Экспорт

	Учётка = УчёткаСДоказаннымАдресом("gate");

	Исход = Вход().ВойтиПоПаролю(Учётка.Логин, "Password123!", "203.0.113.71");

	Ожидаем.Что(Исход.Успех, "вход открыт: " + Исход.Причина).ЭтоИстина();
	Ожидаем.Что(Исход.Сессия = Неопределено, "сессия выдана").ЭтоЛожь();

КонецПроцедуры

// Письмо у человека на руках — второго не шлём: выпуск гасит прежнюю ссылку, и та,
// которую он как раз открыл, умерла бы прямо в почте.
&Тест
Процедура ЖивуюСсылкуОтказВходаНеЗаменяет() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("gate"));
	Значение = ЗначениеИзПисьма();
	Транспорт.Очистить();

	Вход().ВойтиПоПаролю(Учётка.Логин, "Password123!", "203.0.113.79");

	Ожидаем.Что(Транспорт.Количество(), "второго письма не ушло").Равно(0);
	Ожидаем.Что(Подтверждение().Проверить(Значение).Годна,
		"а ссылка из первого письма по-прежнему годна").ЭтоИстина();

КонецПроцедуры

// Нажимать стало нечего — вот теперь письмо: круг замыкается, и заперт никто не остаётся.
&Тест
Процедура ПротухшуюСсылкуОтказВходаЗаменяетНовой() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("gate"));
	Заявка = Подтверждение().Проверить(ЗначениеИзПисьма()).Заявка;
	Заявка.Истекает = ТекущаяУниверсальнаяДата() - 1;
	Заявка.Сохранить();
	Транспорт.Очистить();

	Вход().ВойтиПоПаролю(Учётка.Логин, "Password123!", "203.0.113.80");

	Ожидаем.Что(Транспорт.Количество(), "взамен протухшей ушло новое письмо").Равно(1);
	Ожидаем.Что(Транспорт.Последнее().Кому, "на адрес самой учётки").Равно(Учётка.Email);

	Ожидаем.Что(Подтверждение().Подтвердить(ЗначениеИзПисьма()).Успех,
		"по новой ссылке адрес подтверждается").ЭтоИстина();
	Ожидаем.Что(Вход().ВойтиПоПаролю(Учётка.Логин, "Password123!", "203.0.113.80").Успех,
		"и вход открывается").ЭтоИстина();

КонецПроцедуры

// Кнопка «выслать письмо» для того, кого хаб внутрь не пустил: сессии у него нет,
// поэтому он называет себя сам. Ответ одинаков, нашлась учётка или нет.
&Тест
Процедура ПисьмоВысылаетсяПоНазванномуЛогинуИАдресу() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("gate"));

	Транспорт.Очистить();
	ПоЛогину = Подтверждение().ЗапроситьПоНазванному(Учётка.Логин, Неопределено, "203.0.113.81");
	Ожидаем.Что(ПоЛогину.Принято, "форма принята: " + ПоЛогину.Причина).ЭтоИстина();
	Ожидаем.Что(Транспорт.Количество(), "письмо ушло по логину").Равно(1);

	Транспорт.Очистить();
	ПоАдресу = Подтверждение().ЗапроситьПоНазванному(Учётка.Email, Неопределено, "203.0.113.81");
	Ожидаем.Что(ПоАдресу.Принято, "и по адресу форма принята").ЭтоИстина();
	Ожидаем.Что(Транспорт.Количество(), "письмо ушло по адресу").Равно(1);

	Транспорт.Очистить();
	Чужой = Подтверждение().ЗапроситьПоНазванному("нет-такой-учётки", Неопределено, "203.0.113.81");
	Ожидаем.Что(Чужой.Принято, "ответ несуществующей — тот же самый").ЭтоИстина();
	Ожидаем.Что(Транспорт.Количество(), "но письма никому не ушло").Равно(0);

КонецПроцедуры

// Состояние чужой учётки — не для того, кто пароля не знает: неверный пароль получает
// свой обычный отказ и никаких писем не рассылает.
&Тест
Процедура НевернымПаролемСостояниеАдресаНеУзнать() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("gate"));
	Транспорт.Очистить();

	Исход = Вход().ВойтиПоПаролю(Учётка.Логин, "чужой-пароль", "203.0.113.73");

	Ожидаем.Что(Исход.Причина, "отказ обычный").Равно("invalid_credentials");
	Ожидаем.Что(Транспорт.Количество(), "и писем никому не ушло").Равно(0);

КонецПроцедуры

// Выключенное подтверждение снимает и запрет входа: ссылок хаб не выпускает, значит
// подтверждать нечем, и запирать учётку не за что.
&Тест
Процедура ВыключенноеПодтверждениеВходНеЗапирает() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("gate"));
	Настройки().Установить("oshub.auth.email.confirm.enabled", Ложь, "тест");

	Ожидаем.Что(Вход().ВойтиПоПаролю(Учётка.Логин, "Password123!", "203.0.113.74").Успех,
		"вход открыт").ЭтоИстина();

КонецПроцедуры

// Подтверждение, которое хабу нечем выполнить, никого не запирает: ссылку слать нечем,
// и запертому нечего нажать. Иначе администратор, включивший подтверждение раньше почты,
// разом отобрал бы вход у всех, у кого адрес есть.
&Тест
Процедура НенастроеннаяПочтаВходНеЗапирает() Экспорт

	Учётка = Зарегистрировать(УникальныйЛогин("gate"));
	ВыключитьПочту();

	Ожидаем.Что(Вход().ВойтиПоПаролю(Учётка.Логин, "Password123!", "203.0.113.78").Успех,
		"вход открыт").ЭтоИстина();

КонецПроцедуры

// Администратор мастера /setup заводится вообще без адреса. Запертый на нём хаб остался
// бы без единого входа, поэтому учётке без почты подтверждать нечего.
&Тест
Процедура УчёткаБезАдресаВходитВсегда() Экспорт

	Логин = УникальныйЛогин("gate");
	Пользователи().СоздатьПользователя(Логин, "", "Password123!", "admin");

	Ожидаем.Что(Вход().ВойтиПоПаролю(Логин, "Password123!", "203.0.113.75").Успех,
		"вход открыт").ЭтоИстина();

КонецПроцедуры

// Регистрация больше не логинит: сессию открывает подтверждённый адрес.
&Тест
Процедура APIРегистрацияСессииНеОткрывает() Экспорт

	Логин = УникальныйЛогин("gate");
	Ответ = ЗарегистрироватьПоAPI(Логин, Логин + "@example.org", "203.0.113.76");

	Ожидаем.Что(Ответ.Состояние, "учётка заведена").Равно(201);
	Ожидаем.Что(Ответ.Куки.Значение(ИмяКукиСессии()), "куки сессии в ответе нет").Равно("");
	Ожидаем.Что(ТелоОтвета(Ответ)["email_confirmation_required"],
		"ответ говорит, чего ждать: " + Ответ.ТелоТекст).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура БезПодтвержденияAPIРегистрацияЛогинитКакПрежде() Экспорт

	Настройки().Установить("oshub.auth.email.confirm.enabled", Ложь, "тест");
	Логин = УникальныйЛогин("gate");

	Ответ = ЗарегистрироватьПоAPI(Логин, Логин + "@example.org", "203.0.113.77");

	Ожидаем.Что(Ответ.Состояние, "учётка заведена").Равно(201);
	Ожидаем.Что(ЗначениеЗаполнено(Ответ.Куки.Значение(ИмяКукиСессии())),
		"и сессия открыта сразу").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Журнал

// Ссылка подтверждения — секрет одного адресата. Журнал аудита читают шире, чем ящик,
// поэтому значения ссылки в событии не бывает ни при каких обстоятельствах.
&Тест
Процедура ЗначениеСсылкиВЖурналНеПопадает() Экспорт

	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель = Желудь("ИздательСобытий");
	Издатель.Подписать(Издатель.ТипПодтверждениеАдреса(), Слушатель);

	Учётка = Зарегистрировать(УникальныйЛогин("cnf"));
	Значение = ЗначениеИзПисьма();
	Секрет = Сред(Значение, СтрНайти(Значение, "oshub_cnf_") + 10);
	Подтверждение().Подтвердить(Значение, Неопределено, "203.0.113.9");

	Найдено = Ложь;
	Для Каждого Событие Из Слушатель.События Цикл
		Если СтрНайти(Строка(Событие.Данные.Объект), Учётка.Логин) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Найдено = Истина;
		Ожидаем.Что(СтрНайти(Строка(Событие.Данные.ДеталиJSON), Секрет),
			"секрета ссылки в деталях события нет").Равно(0);
		Ожидаем.Что(СтрНайти(Строка(Событие.Данные.ДеталиJSON), "oshub_cnf_"),
			"и самого значения ссылки тоже").Равно(0);
	КонецЦикла;

	Ожидаем.Что(Найдено, "события учётки в журнале есть").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Страница подтверждения на настоящем графе рендера: ответ — заглушка winow.
Функция НоваяСтраница()

	Возврат Новый КонтроллерПодтвержденияEmail(Желудь("СервисПодтвержденияEmail"),
		Желудь("КодыПодтверждения"), Желудь("АдресПодтверждения"),
		Желудь("ПерехватчикАутентификации"), Желудь("СлужбаСессий"), Желудь("КукиСессии"),
		Новый ВозвратПослеВхода(), Новый ЗащитаCSRF(Неопределено),
		НоваяСтраницаДоступа(), UI.Кит, UI.Тексты, Новый РазборФормы(),
		Желудь("МетодыHTTP"));

КонецФункции

// Каркас публичного экрана: тот же граф рендера, что у живого хаба.
Функция НоваяСтраницаДоступа()

	Возврат Новый СтраницаДоступа(UI.Кит, UI.Каркас, UI.Тексты,
		Желудь("ВозвратПослеВхода"));

КонецФункции

// Регистрация тем же путём, каким её зовёт winow: через контроллер API.
Функция ЗарегистрироватьПоAPI(Знач Логин, Знач Email, Знач Источник)

	Контроллер = Новый КонтроллерАутентификации(Желудь("СервисАутентификации"),
		Желудь("СервисРегистрации"), Желудь("СлужбаСессий"),
		Желудь("ПерехватчикАутентификации"), Желудь("ОтветыAPI"), Желудь("АдресУчётки"),
		Желудь("ГейтПодтвержденияАдреса"), Новый КукиОтветаЗаглушка(), Желудь("МетодыHTTP"),
		Желудь("КукиСессии"));

	Ответ = Новый ОтветВходаЗаглушка(Новый КукиОтветаЗаглушка());
	Тело = СтрШаблон("{""логин"":""%1"",""email"":""%2"",""пароль"":""Password123!""}",
		Логин, Email);
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");

	Контроллер.Регистрация(Ответ, Тело, Заголовки, "POST", Источник);
	Возврат Ответ;

КонецФункции

Функция ОткрытьСтраницу(Знач Значение)

	Ответ = Новый ОтветСтраницыЗаглушка();
	НоваяСтраница().ПодтверждениеEmail(Ответ, "", Новый Соответствие(), Новый КукиЗаглушка(),
		"GET", "203.0.113.1", Значение);
	Возврат Ответ;

КонецФункции

// Страница /confirm-email глазами вошедшего человека: сессия настоящая, кука приходит
// заглушкой ровно так, как её прислал бы браузер.
Функция СтраницаОтИмени(Знач Пользователь)

	Сессия = Желудь("СлужбаСессий").Создать(Пользователь.Идентификатор);
	Куки = Новый КукиЗаглушка();
	Куки.Добавить(Желудь("ПерехватчикАутентификации").ИмяКукиСессии(), Сессия.Идентификатор());

	Ответ = Новый ОтветСтраницыЗаглушка();
	НоваяСтраница().ПодтверждениеEmail(Ответ, "", Новый Соответствие(), Куки,
		"GET", "203.0.113.40", "");
	Возврат Ответ;

КонецФункции

Функция ОтправитьФорму(Знач Значение)

	Ответ = Новый ОтветСтраницыЗаглушка(Новый КукиОтветаЗаглушка());
	Тело = "token=" + КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);
	НоваяСтраница().ПодтверждениеEmail(Ответ, Тело, Новый Соответствие(), Новый КукиЗаглушка(),
		"POST", "203.0.113.1", "");
	Возврат Ответ;

КонецФункции

Функция Подтверждение()
	Возврат Желудь("СервисПодтвержденияEmail");
КонецФункции

Функция Вход()
	Возврат Желудь("СервисАутентификации");
КонецФункции

Функция ИмяКукиСессии()
	Возврат Желудь("ПерехватчикАутентификации").ИмяКукиСессии();
КонецФункции

Функция ТелоОтвета(Знач Ответ)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Ответ.ТелоТекст);
	Возврат ПрочитатьJSON(Чтение, Истина);
КонецФункции

Функция Пользователи()
	Возврат Желудь("СервисПользователей");
КонецФункции

Функция Адреса()
	Возврат Желудь("АдресУчётки");
КонецФункции

Функция Регистрация()
	Возврат Желудь("СервисРегистрации");
КонецФункции

Функция Настройки()
	Возврат Желудь("СервисНастроек");
КонецФункции

Функция Восстановление()
	Возврат Желудь("ВосстановлениеПароля");
КонецФункции

Функция Приглашения()
	Возврат Желудь("СервисПриглашений");
КонецФункции

// Учётка, чей адрес доказан СОБСТВЕННЫМ письмом хаба: регистрация, письмо, переход
// по ссылке — ровно то, что делает человек.
Функция УчёткаСДоказаннымАдресом(Знач Приставка)

	Учётка = Зарегистрировать(УникальныйЛогин(Приставка));
	Исход = Подтверждение().Подтвердить(ЗначениеИзПисьма());
	Ожидаем.Что(Исход.Успех, "адрес подтверждён ссылкой хаба: " + Исход.Причина).ЭтоИстина();
	Возврат Пользователи().ПоИдентификатору(Учётка.Идентификатор);

КонецФункции

// Значение ссылки установки пароля из последнего письма.
Функция СсылкаИзПисьма()

	Письмо = Транспорт.Последнее();
	Ожидаем.Что(Письмо, "письмо отправлено").Существует();

	Маркер = "token=";
	Позиция = СтрНайти(Письмо.Текст, Маркер);
	Ожидаем.Что(Позиция > 0, "в письме есть ссылка с токеном").ЭтоИстина();

	Хвост = Сред(Письмо.Текст, Позиция + СтрДлина(Маркер));
	Конец = СтрНайти(Хвост, Символы.ПС);
	Возврат СокрЛП(?(Конец = 0, Хвост, Лев(Хвост, Конец - 1)));

КонецФункции

Процедура НастроитьПочту()

	Настройки().Установить("oshub.instance.url", "https://hub.example.com", "тест");
	Настройки().Установить("oshub.mail.enabled", Истина, "тест");
	Настройки().Установить("oshub.mail.smtp.host", "smtp.example.com", "тест");
	Настройки().Установить("oshub.mail.from", "hub@example.com", "тест");
	Настройки().Установить("oshub.auth.email.confirm.enabled", Истина, "тест");

КонецПроцедуры

Процедура ВыключитьПочту()
	Настройки().Установить("oshub.mail.enabled", Ложь, "тест");
КонецПроцедуры

// Учётка через регистрацию: письмо уходит попутно, как у живого хаба.
Функция Зарегистрировать(Знач Логин)
	Возврат Регистрация().Зарегистрировать(Логин, Логин + "@example.org", "Password123!");
КонецФункции

// Учётка без письма — когда письмо в тесте запрашивается отдельно.
Функция ЗавестиУчётку(Знач Логин)
	Возврат Пользователи().СоздатьПользователя(Логин, Логин + "@example.org", "Password123!");
КонецФункции

// Текст отказа регистрации; пустая строка — регистрация неожиданно прошла.
Функция ОтказРегистрации(Знач Логин)
	Попытка
		Регистрация().Зарегистрировать(Логин, Логин + "@example.org", "Password123!");
		Возврат "";
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
КонецФункции

// Значение ссылки из последнего письма: тест видит ровно то, что видит человек в почте.
Функция ЗначениеИзПисьма()

	Письмо = Транспорт.Последнее();
	Ожидаем.Что(Письмо, "письмо отправлено").Существует();

	Маркер = "token=";
	Позиция = СтрНайти(Письмо.Текст, Маркер);
	Ожидаем.Что(Позиция > 0, "в письме есть ссылка с токеном").ЭтоИстина();

	Хвост = Сред(Письмо.Текст, Позиция + СтрДлина(Маркер));
	Конец = СтрНайти(Хвост, Символы.ПС);
	Возврат СокрЛП(?(Конец = 0, Хвост, Лев(Хвост, Конец - 1)));

КонецФункции

Функция УникальныйЛогин(Знач Приставка)
	Счётчик = Счётчик + 1;
	Возврат Приставка + Формат(Счётчик, "ЧГ=0; ЧН=0")
		+ НРег(Прав(Строка(Новый УникальныйИдентификатор), 6));
КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Процедура ПодключитьСервисы(Знач КаталогКлассов)
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		Если СтрНачинаетсяС(ФайлКласса.ИмяБезРасширения, "Контроллер") Тогда
			Продолжить; // контроллерам нужен winow, в юнит-контейнере не подключаем
		КонецЕсли;
		ПоискКлассов.ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;
КонецПроцедуры

// Всё из модуля почты, кроме настоящего SMTP-отправителя: его место занял фейк.
Процедура ПодключитьПочтуБезSMTP(Знач КаталогКлассов)
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		Если ФайлКласса.ИмяБезРасширения = "ОтправительПисемSMTP" Тогда
			Продолжить;
		КонецЕсли;
		ПоискКлассов.ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;
КонецПроцедуры

Процедура ПодключитьПоИмени(Знач КаталогКлассов, Знач ИмяКласса)
	Найденные = НайтиФайлы(КаталогКлассов, ИмяКласса + ".os", Истина);
	Если Найденные.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон("Класс %1 не найден в %2", ИмяКласса, КаталогКлассов);
	КонецЕсли;
	ПоискКлассов.ПодключитьФайл(Найденные[0].ПолноеИмя);
КонецПроцедуры

#КонецОбласти
