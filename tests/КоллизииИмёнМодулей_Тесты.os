// Скан-тест против класса дефектов «имя общего модуля библиотеки отбирает глобальное
// свойство»: присваивание необъявленной переменной с таким именем падает в рантайме
// «Property 'X' is not writable». Корпус — src/, tests/, tools/, scripts/ и код установленных
// библиотек; состав корпуса проверяется по частям, детектор — синтетическими пробами.

#Использовать asserts

Перем КаталогПроекта;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура НайтиКорень() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
КонецПроцедуры

#Область ПроверкаДетектора

&Тест
Процедура ДетекторЛовитПрисваиваниеИмениОбщегоМодуля() Экспорт

	Имена = Новый Соответствие();
	Имена.Вставить("сравнение", "проба-библиотека");

	// 1. форма дефекта entity: присваивание внутри СГЕНЕРИРОВАННОГО текста лямбды
	Итог = КоллизииВТексте(ТекстПробыЛямбды(), Имена);
	Ожидаем.Что(Итог.Коллизии.Количество(), "проба-лямбда опознана").Равно(1);
	Ожидаем.Что(Итог.Коллизии[0].Имя).Равно("сравнение");
	Ожидаем.Что(Итог.Коллизии[0].Строка, "названа строка с присваиванием").Равно(3);

	// 2. обычное присваивание необъявленной переменной
	Текст = "Процедура Мина() Экспорт" + Символы.ПС
		+ "	Сравнение = 0;" + Символы.ПС
		+ "КонецПроцедуры";
	Ожидаем.Что(КоллизииВТексте(Текст, Имена).Коллизии.Количество(),
		"необъявленная локальная переменная опознана").Равно(1);

	// 3. второй оператор в строке (после `;`)
	Текст = "Процедура Мина() Экспорт" + Символы.ПС
		+ "	Итог = 1; Сравнение = 2;" + Символы.ПС
		+ "КонецПроцедуры";
	Ожидаем.Что(КоллизииВТексте(Текст, Имена).Коллизии.Количество(),
		"присваивание вторым оператором строки опознано").Равно(1);

КонецПроцедуры

&Тест
Процедура ДетекторНеСчитаетКоллизиейОбъявленноеИмя() Экспорт

	Имена = Новый Соответствие();
	Имена.Вставить("сравнение", "проба-библиотека");

	// параметр метода: имя занято локальным слотом
	Текст = "Процедура Сортировать(Массив, Знач Сравнение = Неопределено) Экспорт" + Символы.ПС
		+ "	Сравнение = 1;" + Символы.ПС
		+ "КонецПроцедуры";
	Ожидаем.Что(КоллизииВТексте(Текст, Имена).Коллизии.Количество(),
		"параметр метода — не коллизия").Равно(0);

	// параметр в подписи, разъехавшейся по строкам
	Текст = "Процедура Сортировать(Массив," + Символы.ПС
		+ "	Знач Сравнение) Экспорт" + Символы.ПС
		+ "	Сравнение = 1;" + Символы.ПС
		+ "КонецПроцедуры";
	Ожидаем.Что(КоллизииВТексте(Текст, Имена).Коллизии.Количество(),
		"многострочная подпись прочитана").Равно(0);

	// Перем модуля и Перем метода
	Текст = "Перем Сравнение Экспорт;" + Символы.ПС
		+ "Процедура Мина() Экспорт" + Символы.ПС
		+ "	Сравнение = 1;" + Символы.ПС
		+ "КонецПроцедуры";
	Ожидаем.Что(КоллизииВТексте(Текст, Имена).Коллизии.Количество(),
		"Перем модуля — не коллизия").Равно(0);

	Текст = "Процедура Мина() Экспорт" + Символы.ПС
		+ "	Перем Сравнение;" + Символы.ПС
		+ "	Сравнение = 1;" + Символы.ПС
		+ "КонецПроцедуры";
	Ожидаем.Что(КоллизииВТексте(Текст, Имена).Коллизии.Количество(),
		"Перем метода — не коллизия").Равно(0);

	// сравнение, обращение к свойству, имя-суффикс и комментарий присваиванием не являются
	Текст = "Процедура НеМина() Экспорт" + Символы.ПС
		+ "	Если Сравнение = 0 Тогда" + Символы.ПС
		+ "		Объект.Сравнение = 1;" + Символы.ПС
		+ "	КонецЕсли;" + Символы.ПС
		+ "	ПробаСравнение = 2;" + Символы.ПС
		+ "	// Сравнение = 3;" + Символы.ПС
		+ "КонецПроцедуры";
	Ожидаем.Что(КоллизииВТексте(Текст, Имена).Коллизии.Количество(),
		"сравнение/свойство/имя-суффикс/комментарий — не присваивания").Равно(0);

КонецПроцедуры

&Тест
Процедура ПрефильтрПропускаетВыравненныеПрисваивания() Экспорт

	// Замечание B-2 ревью 6.E: дешёвый префильтр отсекает ФАЙЛ ЦЕЛИКОМ, поэтому он обязан
	// быть не уже разбора. Прежняя редакция знала только `имя=` и `имя =` — ровно один
	// пробел, — и файл с выравненным присваиванием не доходил до разбора ни одной строкой.
	// Стиль не гипотетический: `Обработки  = Неопределено;` (два пробела) живёт в oint,
	// tools/http/Modules/OPI_ЗапросыHTTP.os, рядом с `ИмяТипа    = …`.
	Имена = Новый Соответствие();
	Имена.Вставить("сравнение", "проба-библиотека");

	Ожидаем.Что(ПохожеНаПрисваиваниеМодулю("	Сравнение = 0;", Имена),
		"один пробел").ЭтоИстина();
	Ожидаем.Что(ПохожеНаПрисваиваниеМодулю("	Сравнение=0;", Имена),
		"без пробела").ЭтоИстина();
	Ожидаем.Что(ПохожеНаПрисваиваниеМодулю("	Сравнение  = 0;", Имена),
		"ДВА пробела — выравненный стиль (ровно та слепота, которую закрывает B-2)")
		.ЭтоИстина();
	Ожидаем.Что(ПохожеНаПрисваиваниеМодулю("	Сравнение" + Символы.Таб + "= 0;", Имена),
		"выравнивание табом").ЭтоИстина();
	Ожидаем.Что(ПохожеНаПрисваиваниеМодулю("	ВидСравнения    = 0;" + Символы.ПС
			+ "	Сравнение  = 1;", Имена),
		"имя-суффикс выше не мешает найти настоящее ниже").ЭтоИстина();
	Ожидаем.Что(ПохожеНаПрисваиваниеМодулю("	Итог = Сравнение;" + Символы.ПС
			+ "	Если Сравнение <> 0 Тогда", Имена),
		"чтения имени без присваивания префильтр не пропускает").ЭтоЛожь();
	Ожидаем.Что(ПохожеНаПрисваиваниеМодулю("	Прочее = 1;", Имена),
		"имени модуля в файле нет вовсе").ЭтоЛожь();

	// Префильтр СОГЛАСОВАН С РАЗБОРОМ: то, что он пропускает, разбор обязан опознать.
	Ожидаем.Что(КоллизииВТексте("Процедура Мина() Экспорт" + Символы.ПС
			+ "	Сравнение  = 0;" + Символы.ПС + "КонецПроцедуры", Имена).Коллизии.Количество(),
		"разбор видит присваивание с двумя пробелами — префильтр не строже него").Равно(1);

КонецПроцедуры

&Тест
Процедура ИменаОбщихМодулейСобираютсяИзБиблиотекПроцесса() Экспорт

	Имена = ИменаОбщихМодулей();

	// охват: если разбор lib.config сломается, скан ниже станет вечнозелёным
	Ожидаем.Что(Имена.Количество() >= 50,
		СтрШаблон("общих модулей найдено: %1 (ожидается не меньше 50)", Имена.Количество())).ЭтоИстина();

	// поимённо — по модулю из двух разных библиотек: разбор lib.config обязан видеть обе.
	// Прежний образец жил в oidc-client, но с 0.5.0 у него общих модулей нет вовсе —
	// они уехали в src/internal, и занимать глобальные имена ему больше нечем
	Ожидаем.Что(Имена.Получить("хешированиепаролей"), "модуль pwhash опознан").Существует();
	Ожидаем.Что(Имена.Получить("видсравнения"), "модуль entity опознан").Существует();

	// свой общий модуль занимает глобальное имя так же, как чужой, и стережётся тем же сканом
	Ожидаем.Что(Имена.Получить("реестрфикстур"), "модуль каталога фикстур опознан").Существует();

	// ИМЯ, КОТОРОЕ БОЛЬШЕ НЕЛЬЗЯ ЗАНИМАТЬ. Пока `Сравнение` не объявлено ничьим общим
	// модулем, скан ниже не имеет к entity претензий. Вернётся имя — вернётся дефект.
	Ожидаем.Что(Имена.Получить("сравнение"),
		"имя `Сравнение` снова занято общим модулем — см. шапку набора").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область Скан

&Тест
Процедура ИменаОбщихМодулейНеОтбираютИменаЛокальныхПеременных() Экспорт

	Имена = ИменаОбщихМодулей();
	Файлы = СканируемыеФайлы();

	// КОНТРОЛЬ СОСТАВА КОРПУСА, А НЕ ЕГО РАЗМЕРА (замечание B-1 ревью 6.E). Прежняя редакция
	// требовала «всего файлов >= 300», и мутация ревьюера — выброс ВСЕГО `oscript_modules/**`,
	// то есть `entity/КоннекторInMemory.os`, где дефект волны и сработал, — оставалась
	// ЗЕЛЁНОЙ: своих файлов хаба 419, порог перекрыт. Поэтому каждая часть корпуса считается
	// ОТДЕЛЬНО и имеет свой порог, а код библиотек вдобавок закреплён ИМЕНЕМ ФАЙЛА: без
	// него порог библиотек можно было бы перекрыть одной большой сторонней библиотекой.
	ФайловИсходников = ФайловСПрефиксом(Файлы, "/src/");
	ФайловТестов = ФайловСПрефиксом(Файлы, "/tests/");
	ФайловИнструментов = ФайловСПрефиксом(Файлы, "/tools/") + ФайловСПрефиксом(Файлы, "/scripts/");
	ФайловБиблиотек = ФайловСПрефиксом(Файлы, "/oscript_modules/");

	Ожидаем.Что(ФайловИсходников >= 200,
		СтрШаблон("файлов src/ в корпусе: %1 (ожидается не меньше 200)",
			ФайловИсходников)).ЭтоИстина();
	Ожидаем.Что(ФайловТестов >= 100,
		СтрШаблон("файлов tests/ в корпусе: %1 (ожидается не меньше 100)",
			ФайловТестов)).ЭтоИстина();
	Ожидаем.Что(ФайловИнструментов >= 5,
		СтрШаблон("файлов tools/ и scripts/ в корпусе: %1 (ожидается не меньше 5; скрипты"
			+ " сопровождения грузятся с теми же библиотеками — граница B-3)",
			ФайловИнструментов)).ЭтоИстина();
	Ожидаем.Что(ФайловБиблиотек >= 300,
		СтрШаблон("файлов библиотек (oscript_modules) в корпусе: %1 (ожидается не меньше 300)."
			+ " Именно код библиотек — то место, где мина срабатывала",
			ФайловБиблиотек)).ЭтоИстина();
	Ожидаем.Что(ЕстьВКорпусе(Файлы, "/oscript_modules/entity/"),
		"в корпусе нет ни одного файла entity — а мина волны 4 сработала именно там"
		+ " (КоннекторInMemory/КоннекторJSON): порог по числу файлов такое сужение"
		+ " не поймал бы").ЭтоИстина();

	Коллизии = Новый Массив();
	Кандидатов = 0;
	КандидатовВБиблиотеках = 0;
	Разобрано = 0;

	Для Каждого Путь Из Файлы Цикл

		Если Путь = ТекущийСценарий().Источник Тогда
			Продолжить; // собственные синтетические пробы набора — это данные, а не код
		КонецЕсли;

		Текст = ПрочитатьТекст(Путь);
		Если НЕ ПохожеНаПрисваиваниеМодулю(Текст, Имена) Тогда
			Продолжить; // дешёвый отсев: имени модуля с `=` в файле нет вовсе
		КонецЕсли;

		Разобрано = Разобрано + 1;
		Итог = КоллизииВТексте(Текст, Имена);
		Кандидатов = Кандидатов + Итог.Кандидатов;
		Если СтрНачинаетсяС(ОтносительныйПуть(Путь), "/oscript_modules/") Тогда
			КандидатовВБиблиотеках = КандидатовВБиблиотеках + Итог.Кандидатов;
		КонецЕсли;
		Для Каждого Коллизия Из Итог.Коллизии Цикл
			Коллизии.Добавить(СтрШаблон("%1 (модуль библиотеки %2) — %3:%4",
				Коллизия.Имя, Имена.Получить(Коллизия.Имя),
				ОтносительныйПуть(Путь), Коллизия.Строка));
		КонецЦикла;

	КонецЦикла;

	Сообщить(СтрШаблон("охват скана коллизий имён: модулей %1, файлов %2"
		+ " (src %3 + tests %4 + tools %5 + библиотеки %6), разобрано подробно %7,"
		+ " присваиваний именам модулей %8 (из них в библиотеках %9), коллизий %10",
		Имена.Количество(), Файлы.Количество(), ФайловИсходников, ФайловТестов,
		ФайловИнструментов, ФайловБиблиотек,
		Разобрано, Кандидатов, КандидатовВБиблиотеках, Коллизии.Количество()));

	// КОНТРОЛЬ ОХВАТА, А НЕ ДЕФЕКТ. Присваивания именам общих модулей в дереве ЕСТЬ, и все
	// они законные — объявленным переменным (`Знач СравнениеЗначений` в collectionos,
	// `Перем ВидСравнения` в entity). Ноль здесь значит, что скан перестал читать файлы
	// или разбирать строки: без этой проверки сломанный детектор был бы вечнозелёным.
	// Если проверка упала после обновления библиотек — сперва убедитесь по числам охвата
	// выше, что скан вообще доходит до кода, и только потом правьте её.
	Ожидаем.Что(Кандидатов > 0,
		СтрШаблон("контроль охвата: присваиваний именам модулей найдено %1 (ожидается > 0)",
			Кандидатов)).ЭтоИстина();

	Ожидаем.Что(СтрСоединить(Коллизии, Символы.ПС),
		"имена общих модулей, отобранные локальными переменными (см. шапку набора)").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Детектор

// Коллизии в тексте одного файла.
//
// Параметры:
//   Текст - Строка          - исходник .os;
//   Имена - Соответствие    - имя общего модуля (НРег) → библиотека.
//
// Возвращаемое значение:
//   Структура:
//     Коллизии   - Массив из Структура(Имя, Строка, Текст);
//     Кандидатов - Число - сколько присваиваний именам модулей встретилось всего
//                  (вместе с объявленными) — контроль охвата.
//
Функция КоллизииВТексте(Знач Текст, Знач Имена)

	Строки = СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС);

	МодульныеПеременные = Новый Соответствие();
	Для Инд = 0 По Строки.ВГраница() Цикл
		Если ЭтоНачалоМетода(Строки[Инд]) Тогда
			Прервать;
		КонецЕсли;
		ДобавитьОбъявленные(МодульныеПеременные, Строки[Инд]);
	КонецЦикла;

	Коллизии = Новый Массив();
	Кандидатов = 0;

	Для Инд = 0 По Строки.ВГраница() Цикл

		Строка = Строки[Инд];
		Если ЭтоКомментарий(Строка) Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Якорь Из ЯкоряОператоров(Строка) Цикл

			Цель = НРег(ЦельПрисваивания(Строка, Якорь));
			Если СтрДлина(Цель) = 0 ИЛИ Имена.Получить(Цель) = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Кандидатов = Кандидатов + 1;
			Если ИмяОбъявлено(Строки, Инд, Цель, МодульныеПеременные) Тогда
				Продолжить;
			КонецЕсли;

			Коллизии.Добавить(Новый Структура("Имя, Строка, Текст", Цель, Инд + 1, СокрЛП(Строка)));

		КонецЦикла;

	КонецЦикла;

	Возврат Новый Структура("Коллизии, Кандидатов", Коллизии, Кандидатов);

КонецФункции

// Дешёвый отсев целого файла: есть ли в нём вообще имя общего модуля перед `=`.
// Подробный разбор строк дороже, а таких файлов единицы.
//
// ПРЕФИЛЬТР ОБЯЗАН БЫТЬ НЕ УЖЕ РАЗБОРА (замечание B-2 ревью 6.E). Прежняя редакция знала
// только `имя=` и `имя =` — РОВНО один пробел, — а разбор (`ЦельПрисваивания` →
// `ПропуститьПробелы`) допускает любой пробельный отрезок, включая табы. Файл с выравненным
// присваиванием (`Обработки  = Неопределено;` — два пробела, живой стиль в oint:
// tools/http/Modules/OPI_ЗапросыHTTP.os) отсекался ЦЕЛИКОМ, вместе со всеми остальными своими
// строками. Теперь ищем ИМЯ, а решение «присваивание или нет» оставляем разбору: пропуск
// пробелов здесь тот же самый, что и там.
Функция ПохожеНаПрисваиваниеМодулю(Знач Текст, Знач Имена)

	НижнийТекст = НРег(Текст);

	Для Каждого КиЗ Из Имена Цикл
		Позиция = 1;
		Пока Истина Цикл
			Найдено = СтрНайти(НижнийТекст, КиЗ.Ключ, , Позиция);
			Если Найдено = 0 Тогда
				Прервать;
			КонецЕсли;
			Продолжение = ПропуститьПробелы(НижнийТекст, Найдено + СтрДлина(КиЗ.Ключ));
			Если Сред(НижнийТекст, Продолжение, 1) = "=" Тогда
				Возврат Истина;
			КонецЕсли;
			Позиция = Найдено + 1;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Объявлено ли имя в области видимости присваивания: `Перем` модуля, подпись
// охватывающего метода или `Перем` внутри метода до строки присваивания.
Функция ИмяОбъявлено(Знач Строки, Знач Инд, Знач Цель, Знач МодульныеПеременные)

	Если МодульныеПеременные.Получить(Цель) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	НачалоМетода = -1;
	Обратный = Инд;
	Пока Обратный >= 0 Цикл
		Если ЭтоНачалоМетода(Строки[Обратный]) Тогда
			НачалоМетода = Обратный;
			Прервать;
		КонецЕсли;
		Обратный = Обратный - 1;
	КонецЦикла;

	Если НачалоМетода < 0 Тогда
		Возврат Ложь; // присваивание вне метода — тело модуля, объявлений уже не будет
	КонецЕсли;

	// подпись метода: до первой закрывающей скобки
	Позиция = НачалоМетода;
	Пока Позиция <= Строки.ВГраница() Цикл
		Для Каждого Слово Из СловаСтроки(Строки[Позиция]) Цикл
			Если Слово = Цель Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
		Если СтрНайти(Строки[Позиция], ")") > 0 Тогда
			Прервать;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	// Перем внутри метода
	Позиция = НачалоМетода;
	Пока Позиция <= Инд Цикл
		Объявленные = Новый Соответствие();
		ДобавитьОбъявленные(Объявленные, Строки[Позиция]);
		Если Объявленные.Получить(Цель) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Позиции, с которых может начинаться ОПЕРАТОР: первый значимый символ строки, а также
// позиции сразу после `"`, `|` и `;` — так выглядят присваивания в сгенерированном коде
// (текст лямбды в кавычках, продолжения многострочного литерала) и вторые операторы строки.
Функция ЯкоряОператоров(Знач Строка)

	Якоря = Новый Массив();
	Длина = СтрДлина(Строка);

	Якорь = ПропуститьПробелы(Строка, 1);
	Если Якорь <= Длина Тогда
		Якоря.Добавить(Якорь);
	КонецЕсли;

	Для Инд = 1 По Длина Цикл
		Символ = Сред(Строка, Инд, 1);
		Если Символ = """" ИЛИ Символ = "|" ИЛИ Символ = ";" Тогда
			Якорь = ПропуститьПробелы(Строка, Инд + 1);
			Если Якорь <= Длина Тогда
				Якоря.Добавить(Якорь);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Якоря;

КонецФункции

// Имя, которому присваивают начиная с позиции, либо "" (не присваивание).
Функция ЦельПрисваивания(Знач Строка, Знач Позиция)

	Имя = ИдентификаторС(Строка, Позиция);
	Если СтрДлина(Имя) = 0 Тогда
		Возврат "";
	КонецЕсли;

	Продолжение = ПропуститьПробелы(Строка, Позиция + СтрДлина(Имя));
	Если Продолжение > СтрДлина(Строка) ИЛИ Сред(Строка, Продолжение, 1) <> "=" Тогда
		Возврат "";
	КонецЕсли;

	Возврат Имя;

КонецФункции

Функция ИдентификаторС(Знач Строка, Знач Позиция)

	Длина = СтрДлина(Строка);
	Результат = "";
	Инд = Позиция;
	Пока Инд <= Длина Цикл
		Символ = Сред(Строка, Инд, 1);
		Если НЕ ЭтоСимволИдентификатора(Символ) Тогда
			Прервать;
		КонецЕсли;
		Результат = Результат + Символ;
		Инд = Инд + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПропуститьПробелы(Знач Строка, Знач Позиция)

	Длина = СтрДлина(Строка);
	Инд = Позиция;
	Пока Инд <= Длина Цикл
		Символ = Сред(Строка, Инд, 1);
		Если Символ <> " " И Символ <> Символы.Таб Тогда
			Прервать;
		КонецЕсли;
		Инд = Инд + 1;
	КонецЦикла;

	Возврат Инд;

КонецФункции

Функция ЭтоСимволИдентификатора(Знач Символ)

	Если Символ = "_" Тогда
		Возврат Истина;
	КонецЕсли;

	Код = КодСимвола(Символ);
	Если Код >= 48 И Код <= 57 Тогда        // цифры
		Возврат Истина;
	КонецЕсли;
	Если Код >= 65 И Код <= 90 Тогда        // A-Z
		Возврат Истина;
	КонецЕсли;
	Если Код >= 97 И Код <= 122 Тогда       // a-z
		Возврат Истина;
	КонецЕсли;
	Если Код >= 1024 И Код <= 1279 Тогда    // кириллица, включая Ё/ё
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

Функция ЭтоНачалоМетода(Знач Строка)
	Начало = НРег(СокрЛП(Строка));
	Возврат СтрНачинаетсяС(Начало, "процедура ") ИЛИ СтрНачинаетсяС(Начало, "функция ");
КонецФункции

Функция ЭтоКомментарий(Знач Строка)
	Возврат СтрНачинаетсяС(СокрЛП(Строка), "//");
КонецФункции

// Имена из объявления `Перем А, Б Экспорт;` (иначе набор не меняется).
Процедура ДобавитьОбъявленные(Набор, Знач Строка)

	Начало = НРег(СокрЛП(Строка));
	Если НЕ СтрНачинаетсяС(Начало, "перем ") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Слово Из СловаСтроки(Строка) Цикл
		Если Слово <> "перем" И Слово <> "экспорт" Тогда
			Набор.Вставить(Слово, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Идентификаторы строки в нижнем регистре.
Функция СловаСтроки(Знач Строка)

	Слова = Новый Массив();
	Текущее = "";
	Для Инд = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Инд, 1);
		Если ЭтоСимволИдентификатора(Символ) Тогда
			Текущее = Текущее + Символ;
		ИначеЕсли СтрДлина(Текущее) > 0 Тогда
			Слова.Добавить(НРег(Текущее));
			Текущее = "";
		КонецЕсли;
	КонецЦикла;
	Если СтрДлина(Текущее) > 0 Тогда
		Слова.Добавить(НРег(Текущее));
	КонецЕсли;

	Возврат Слова;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Имена общих модулей всех библиотек, чей код попадает в процесс: и установленных,
// и своих. НРег(имя) → библиотека.
Функция ИменаОбщихМодулей()

	Имена = Новый Соответствие();
	Библиотеки = Новый Массив();

	КаталогБиблиотек = ОбъединитьПути(КаталогПроекта, "oscript_modules");
	Для Каждого Установленная Из НайтиФайлы(КаталогБиблиотек, "*", Ложь) Цикл
		Если Установленная.ЭтоКаталог() Тогда
			Библиотеки.Добавить(Установленная);
		КонецЕсли;
	КонецЦикла;

	// каталог фикстур — тоже библиотека: наборы берут из него РеестрФикстур
	Библиотеки.Добавить(Новый Файл(ОбъединитьПути(КаталогПроекта, "tests", "фикстуры")));

	Для Каждого Библиотека Из Библиотеки Цикл

		Конфигурация = Новый Файл(ОбъединитьПути(Библиотека.ПолноеИмя, "lib.config"));
		Если НЕ Конфигурация.Существует() Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Имя Из ИменаМодулейКонфигурации(ПрочитатьТекст(Конфигурация.ПолноеИмя)) Цикл
			Имена.Вставить(НРег(Имя), Библиотека.Имя);
		КонецЦикла;

	КонецЦикла;

	Возврат Имена;

КонецФункции

// `<module name="X" .../>` из lib.config. Разбором XML не пользуемся намеренно: у части
// библиотек в файле нет объявления пространства имён, и строгий читатель на них спотыкается.
// Ищем подстроками, а не СтрРазделить: у СтрРазделить разделителем работает КАЖДЫЙ символ
// строки-разделителя, и "<module" разнесло бы текст по буквам.
Функция ИменаМодулейКонфигурации(Знач Текст)

	Имена = Новый Массив();
	Остаток = Текст;

	Пока Истина Цикл

		Начало = СтрНайти(Остаток, "<module");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Остаток = Сред(Остаток, Начало + 7);

		ПозицияИмени = СтрНайти(Остаток, "name=""");
		Если ПозицияИмени = 0 Тогда
			Прервать;
		КонецЕсли;

		// атрибут обязан лежать внутри ЭТОГО тега, иначе это уже следующий элемент
		КонецТега = СтрНайти(Остаток, ">");
		Если КонецТега > 0 И ПозицияИмени > КонецТега Тогда
			Продолжить;
		КонецЕсли;

		Хвост = Сред(Остаток, ПозицияИмени + 6);
		Конец = СтрНайти(Хвост, """");
		Если Конец > 1 Тогда
			Имена.Добавить(Сред(Хвост, 1, Конец - 1));
		КонецЕсли;

	КонецЦикла;

	Возврат Имена;

КонецФункции

// Код, который может оказаться в одном процессе с библиотеками: исходники хаба, его тесты,
// скрипты сопровождения и код самих библиотек. Тесты библиотек исключены — см. границы в
// шапке набора.
//
// `tools/` и `scripts/` включены по замечанию B-3 ревью 6.E: скрипты сопровождения
// (`admin-cli.os`, `сидеры/ЗасеятьХаб.os`, `демо/ЗаполнитьЧерезAPI.os`) грузятся в один процесс
// с ТЕМИ ЖЕ библиотеками и подвержены мине ровно так же, а живых кандидатов там сейчас нет —
// значит расширение корпуса бесплатно.
Функция СканируемыеФайлы()

	Файлы = Новый Массив();

	ДобавитьФайлы(Файлы, ОбъединитьПути(КаталогПроекта, "src"));
	ДобавитьФайлы(Файлы, ОбъединитьПути(КаталогПроекта, "tests"));
	ДобавитьФайлы(Файлы, ОбъединитьПути(КаталогПроекта, "tools"));
	ДобавитьФайлы(Файлы, ОбъединитьПути(КаталогПроекта, "scripts"));

	КаталогБиблиотек = ОбъединитьПути(КаталогПроекта, "oscript_modules");
	Для Каждого Библиотека Из НайтиФайлы(КаталогБиблиотек, "*", Ложь) Цикл
		Если НЕ Библиотека.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Вложенный Из НайтиФайлы(Библиотека.ПолноеИмя, "*", Ложь) Цикл
			Если Вложенный.ЭтоКаталог() И НРег(Вложенный.Имя) = "tests" Тогда
				Продолжить;
			КонецЕсли;
			Если Вложенный.ЭтоКаталог() Тогда
				ДобавитьФайлы(Файлы, Вложенный.ПолноеИмя);
			ИначеЕсли НРег(Вложенный.Расширение) = ".os" Тогда
				Файлы.Добавить(Вложенный.ПолноеИмя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Файлы;

КонецФункции

// Сколько файлов корпуса лежит под указанным префиксом относительного пути.
// Префикс, а не подстрока: `/tools/` подстрокой попал бы и в `oscript_modules/oint/tools/…`.
Функция ФайловСПрефиксом(Знач Файлы, Знач Префикс)

	Количество = 0;
	Для Каждого Путь Из Файлы Цикл
		Если СтрНачинаетсяС(ОтносительныйПуть(Путь), Префикс) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Количество;

КонецФункции

// Есть ли в корпусе хоть один файл, чей относительный путь содержит указанный фрагмент.
Функция ЕстьВКорпусе(Знач Файлы, Знач Фрагмент)

	Для Каждого Путь Из Файлы Цикл
		Если СтрНайти(ОтносительныйПуть(Путь), Фрагмент) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ДобавитьФайлы(Файлы, Знач Каталог)

	Если НЕ Новый Файл(Каталог).Существует() Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Найденный Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
		Если НЕ Найденный.ЭтоКаталог() Тогда
			Файлы.Добавить(Найденный.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПрочитатьТекст(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);
КонецФункции

Функция ОтносительныйПуть(Знач Путь)
	Возврат СтрЗаменить(СтрЗаменить(Путь, КаталогПроекта, ""), "\", "/");
КонецФункции

// Проба формы дефекта entity: присваивание живёт внутри текста лямбды сортировки.
Функция ТекстПробыЛямбды()

	Возврат "Функция ТекстСортировки()" + Символы.ПС
		+ "	СтрокаСортировка = СтрШаблон(" + Символы.ПС
		+ "		""Сравнение = ПроцессорыКоллекцийСлужебный.СравнениеЗначений(Э1, Э2);" + Символы.ПС
		+ "		|Если Сравнение <> 0 Тогда" + Символы.ПС
		+ "		|	Возврат Сравнение;" + Символы.ПС
		+ "		|КонецЕсли;"");" + Символы.ПС
		+ "	Возврат СтрокаСортировка;" + Символы.ПС
		+ "КонецФункции";

КонецФункции

#КонецОбласти
