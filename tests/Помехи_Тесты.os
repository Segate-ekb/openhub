		"и размер пакета тоже").ЭтоЛожь();
	Ожидаем.Что(Коды.Устранимо(Коды.Прочее()),
		"про сводку разных причин утверждать нечего").ЭтоЛожь();
	Ожидаем.Что(Коды.Устранимо("код-которого-нет"),
		"незнакомый код устранимым не объявляется").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СнимокЧитателяНесётПризнакУстранимости() Экспорт

	Объект = НовыйОбъект();
	ЗаписатьЗеркало(Объект, "oint@1.0.0", Коды.ИсточникНеОтветил(), "Источник не ответил");
	ЗаписатьЗеркало(Объект, "плохое имя@1.0.0", Коды.ИмяНеПоПравилам(), "Имя не по правилам");

	Строки = Читатель.ПомехиОбъекта(Зеркало(), Объект);
	Устранимая = ПерваяСКодом(Строки, Коды.ИсточникНеОтветил());
	Насовсем = ПерваяСКодом(Строки, Коды.ИмяНеПоПравилам());

	Ожидаем.Что(Устранимая.Устранимо, "устранимая названа устранимой").ЭтоИстина();
	Ожидаем.Что(Насовсем.Устранимо, "пропущенная насовсем — нет").ЭтоЛожь();
	Ожидаем.Что(Устранимая.Подсистема, "подсистема в снимке").Равно(Зеркало());
	Ожидаем.Что(Устранимая.Объект, "объект в снимке").Равно(Объект);

КонецПроцедуры

// Связь «функция кода ↔ объявление» проверяется значением, а не числом кодов: забытое
// объявление дало бы код вне Все() и молчаливую Ложь в Устранимо.
&Тест
Процедура КаждаяФункцияКодаОтдаётОбъявленныйКод() Экспорт

	Объявленные = Новый Соответствие();
	Для Каждого Код Из Коды.Все() Цикл
		Ожидаем.Что(Объявленные.Получить(Код), "код объявлен дважды: " + Код).Равно(Неопределено);
		Объявленные.Вставить(Код, Истина);
	КонецЦикла;

	Функции = БезаргументныеЭкспортные(Тип("КодыПомех"), НеКоды());
	Чужие = Новый Массив();
	Для Каждого Имя Из Функции Цикл
		Значение = Новый Рефлектор().ВызватьМетод(Коды, Имя, Новый Массив());
		Если Объявленные.Получить(Значение) = Неопределено Тогда
			Чужие.Добавить(СтрШаблон("%1 -> %2", Имя, Значение));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Функции.Количество() >= 20,
		СтрШаблон("функций-кодов найдено %1 — скан ослеп", Функции.Количество())).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Чужие, ", "), "функции, отдающие необъявленный код").Равно("");
	Ожидаем.Что(Коды.Подсистемы().Количество(), "подсистем первой волны три").Равно(3);

КонецПроцедуры

&Тест
Процедура АдресаОбъектовСобраныВФормеЖурналаАудита() Экспорт

	АдресЗеркала = Объекты.Зеркало(17);
	Бакет = Объекты.ХранилищеS3("openhub-artifacts");
	Корень = Объекты.ХранилищеФайлами("./data");
	ИсточникАдрес = Объекты.Источник("https://hub.example/download/");

	Ожидаем.Что(АдресЗеркала, "зеркало названо своим номером").Равно("зеркало/17");
	Ожидаем.Что(Бакет, "хранилище названо корзиной").Равно("хранилище/s3://openhub-artifacts");
	Ожидаем.Что(Корень, "файловое хранилище названо корнем").Равно("хранилище/./data");
	Ожидаем.Что(ИсточникАдрес, "источник назван адресом")
		.Равно("источник/https://hub.example/download/");

	Отвергнутые = Новый Массив();
	Для Каждого Адрес Из Адреса(АдресЗеркала, Бакет, Корень, ИсточникАдрес) Цикл
		Если НЕ Имена.ЭтоАдресЖурнала(Адрес) Тогда
			Отвергнутые.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Отвергнутые, ", "),
		"форматтер выдал адрес, который сам не признаёт").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СбойЛетописи

&Тест
Процедура СбойХранилищаНеУноситТогоКтоПишетПомеху() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.помехи.сбой");
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка);

	Падающая = НоваяЛетопись(Новый ХранилищеПомехПадающее(), Настройки, Лог);

	// ни один из трёх путей не имеет права бросить наружу: иначе зеркало упало бы
	// из-за летописи, которая объясняет, почему оно не доехало
	Падающая.Записать(Зеркало(), "зеркало/1", "oint@1.0.0",
		Коды.ПустоеТело(), "Тела нет", "прогон-1");
	Падающая.Снять(Зеркало(), "зеркало/1");
	Падающая.НачатьПрогон(Зеркало(), "зеркало/1", "прогон-2");

	Ожидаем.Что(Ловушка.Количество(), "о каждом сбое летопись пожаловалась в журнал").Равно(3);
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "Летопись помех") > 0,
		"жалоба называет себя: " + Ловушка.Всё()).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "соединение с базой потеряно") > 0,
		"и называет причину: " + Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СбойУборкиУстаревшегоПланировщикуВиден() Экспорт

	// уборка — задача планировщика, и её сбой обязан быть виден журналу фоновых задач:
	// молча вернуть ноль значило бы показать оператору вечно чистую таблицу
	Падающая = НоваяЛетопись(Новый ХранилищеПомехПадающее(), Настройки, Неопределено);

	Ожидаем.Что(УборкаУпала(Падающая), "сбой уборки не проглочен").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗамокОтпускаетсяИПослеСбоя() Экспорт

	// незакрытый замок подвесил бы следующего пишущего навсегда — и это был бы отказ
	// не летописи, а зеркала, которое её позвало. Спрашивать надо ДРУГОЙ поток: замок
	// реентрантен, и повторный вызов в том же потоке прошёл бы и по незакрытому
	Падающая = НоваяЛетопись(Новый ХранилищеПомехПадающее(), Настройки, Неопределено);
	Объект = НовыйОбъект();

	Падающая.Записать(Зеркало(), Объект, "", Коды.ПустоеТело(), "Тела нет");
	Падающая.Записать(Зеркало(), Объект, "", Коды.ПустоеТело(), "Тела нет");

	Предметы = Новый Массив();
	Предметы.Добавить("oint@1.0.0");
	Писатель = Новый ЗаписьПомехПотоком(Падающая, Зеркало(), Объект, Предметы, 1, "прогон-1");
	Задание = ФоновыеЗадания.Выполнить(Писатель, "Исполнить");

	Ожидаем.Что(Задание.ОжидатьЗавершения(8000),
		"чужой поток не заперт замком, брошенным на сбое").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область КонтрактЗаглушки

// Заглушка, разошедшаяся с оригиналом, даёт трём трекам ложную защиту: тест зелен,
// а продукт зовёт метод, которого у настоящей летописи нет (или наоборот).
&Тест
Процедура ФейкЛетописиНесётВесьКонтрактНастоящей() Экспорт

	Настоящие = ЭкспортныеМетоды(Тип("ЛетописьПомех"));
	Заглушка = ЭкспортныеМетоды(Тип("ФейкЛетописьПомех"));

	Пропущенные = Новый Массив();
	Расходятся = Новый Массив();
	Для Каждого ИмяИЧисло Из Настоящие Цикл
		Наличие = Заглушка.Получить(ИмяИЧисло.Ключ);
		Если Наличие = Неопределено Тогда
			Пропущенные.Добавить(ИмяИЧисло.Ключ);
		ИначеЕсли Наличие <> ИмяИЧисло.Значение Тогда
			Расходятся.Добавить(СтрШаблон("%1: у летописи %2 параметров, у заглушки %3",
				ИмяИЧисло.Ключ, ИмяИЧисло.Значение, Наличие));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Настоящие.Количество() >= 8,
		СтрШаблон("экспортных методов летописи найдено %1 — скан ослеп",
			Настоящие.Количество())).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Пропущенные, ", "), "методы летописи, которых нет у заглушки")
		.Равно("");
	Ожидаем.Что(СтрСоединить(Расходятся, "; "), "методы, разошедшиеся числом параметров")
		.Равно("");

КонецПроцедуры

&Тест
Процедура ФейкЛетописиХранитПричинуКакДалиИСамОбОтомГоворит() Экспорт

	// обещание шапки заглушки проверяется значением: она НЕ обезличивает, и наборы,
	// которым нужна проверка обезличивания, обязаны идти к настоящей летописи
	Фейк = Новый ФейкЛетописьПомех();
	Причина = "Источник не пустил: https://robot:s3cr3tpass@hub.example/?token=abc";

	Фейк.Записать(Зеркало(), "зеркало/1", "oint@1.0.0", Коды.ИсточникНеПустил(),
		Причина, "прогон-1", "s3cr3tpass");

	Ожидаем.Что(Фейк.Записи()[0].Причина, "заглушка хранит фразу дословно").Равно(Причина);
	Ожидаем.Что(Фейк.Записи()[0].Секрет, "и запоминает названный секрет").Равно("s3cr3tpass");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПодключитьСлоиХаба(Знач КаталогМодулей)

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "данные", "Классы"));
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "события", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "аудит", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогМодулей, "помехи", "Классы"));

	КаталогСети = ОбъединитьПути(КаталогМодулей, "сеть", "Классы");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогСети, "КоннекторHTTPБиблиотеки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогСети, "КлиентHTTP.os"));

	КаталогНаблюдаемости = ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы");
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогНаблюдаемости, "телеметрия"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КаталогНаблюдаемости, "журнал"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогНаблюдаемости, "пробы", "ГотовностьХаба.os"));

	КаталогНастроек = ОбъединитьПути(КаталогМодулей, "настройки", "Классы");
	Для Каждого Имя Из СтрРазделить("ВидыПроверок,НастройкиПодсистем,РеестрНастроек,"
		+ "СервисНастроек,ВалидаторНастроек", ",") Цикл
		ПоискКлассов.Подключить(КаталогНастроек, Имя);
	КонецЦикла;

	// из фоновых задач — только чистка помех: планировщик потянул бы стартовые рогатки
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогМодулей, "фоновыеЗадания", "Классы",
		"ЗадачаЧисткиПомех.os"));

КонецПроцедуры

Функция НоваяЛетопись(Знач ХранилищеПомех, Знач СервисНастроек, Знач Лог)

	Результат = Новый ЛетописьПомех(ХранилищеПомех, Коды, СервисНастроек, Лог);
	Результат.УстановитьЧасы(Часы);
	Возврат Результат;

КонецФункции

// Подменяет Летопись экземпляром с ловушкой журнала и отдаёт ловушку: сама по себе
// «потоки не упали» ничего не доказывает — летопись наружу не бросает.
Функция ЛетописьСЛовушкой(Знач Прозвище)

	Ловушка = Новый ЛовушкаЛога();
	Лог = Логирование.ПолучитьЛог("тест.oshub.помехи." + Прозвище);
	Лог.УстановитьУровень(УровниЛога.Отладка);
	Лог.ДобавитьСпособВывода(Ловушка);

	Летопись = НоваяЛетопись(Хранилище, Настройки, Лог);
	Возврат Ловушка;

КонецФункции

Функция Зеркало()
	Возврат Коды.ПодсистемаЗеркало();
КонецФункции

Функция Источник()
	Возврат Коды.ПодсистемаИсточник();
КонецФункции

Процедура ЗаписатьЗеркало(Знач Объект, Знач Предмет, Знач Код, Знач Причина)
	Летопись.Записать(Зеркало(), Объект, Предмет, Код, Причина, "прогон-1");
КонецПроцедуры

Процедура ЗаписатьВПрогоне(Знач Объект, Знач Предмет, Знач Код, Знач Прогон)
	Летопись.Записать(Зеркало(), Объект, Предмет, Код, "Тела нет", Прогон);
КонецПроцедуры

// База живёт весь набор, поэтому объект у каждого теста свой: иначе тесты читали бы
// состояние соседей.
Функция НовыйОбъект()
	НомерОбъекта = НомерОбъекта + 1;
	Возврат Объекты.Зеркало(НомерОбъекта);
КонецФункции

// N потоков пишут одну и ту же летопись; возвращает жалобы и число доработавших.
Функция ПрогнатьПотоки(Знач Потоков, Знач Объект, Знач Предметы, Знач Кругов)

	Писатели = Новый Массив();
	Задания = Новый Массив();
	Для Номер = 1 По Потоков Цикл
		Писатель = Новый ЗаписьПомехПотоком(Летопись, Зеркало(), Объект, Предметы,
			Кругов, "прогон-1");
		Писатели.Добавить(Писатель);
		Задания.Добавить(ФоновыеЗадания.Выполнить(Писатель, "Исполнить"));
	КонецЦикла;

	Доработали = 0;
	Для Каждого Задание Из Задания Цикл
		Если Задание.ОжидатьЗавершения(120000) Тогда
			Доработали = Доработали + 1;
		КонецЕсли;
	КонецЦикла;

	Записано = 0;
	Для Каждого Писатель Из Писатели Цикл
		Записано = Записано + Писатель.Записано();
	КонецЦикла;

	Возврат Новый Структура("Доработали, Записано", Доработали, Записано);

КонецФункции

Функция ЗаписейСКодом(Знач Строки, Знач Код)

	Сколько = 0;
	Для Каждого Строка_ Из Строки Цикл
		Если Строка_.Код = Код Тогда
			Сколько = Сколько + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Сколько;

КонецФункции

Функция ПерваяСКодом(Знач Строки, Знач Код)

	Для Каждого Строка_ Из Строки Цикл
		Если Строка_.Код = Код Тогда
			Возврат Строка_;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение СтрШаблон("В выдаче нет записи с кодом ""%1""", Код);

КонецФункции

Функция СуммаСчётчиков(Знач Строки)

	Итог = 0;
	Для Каждого Строка_ Из Строки Цикл
		Итог = Итог + Строка_.Количество;
	КонецЦикла;
	Возврат Итог;

КонецФункции

Функция Адреса(Знач Первый, Знач Второй, Знач Третий, Знач Четвёртый)

	Результат = Новый Массив();
	Результат.Добавить(Первый);
	Результат.Добавить(Второй);
	Результат.Добавить(Третий);
	Результат.Добавить(Четвёртый);
	Возврат Результат;

КонецФункции

Функция УборкаУпала(Знач ЛетописьПодПробой)

	Попытка
		ЛетописьПодПробой.УбратьУстаревшие();
		Возврат Ложь;
	Исключение
		Возврат Истина;
	КонецПопытки;

КонецФункции

// Экспортные методы типа: имя -> число параметров.
Функция ЭкспортныеМетоды(Знач ТипКласса)

	Результат = Новый Соответствие();
	Для Каждого Метод Из Новый Рефлектор().ПолучитьТаблицуМетодов(ТипКласса) Цикл
		Если Метод.Экспорт И Метод.Имя <> "ПриСозданииОбъекта" Тогда
			Результат.Вставить(Метод.Имя, Метод.КоличествоПараметров);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Имена экспортных функций без параметров, кроме названных.
Функция БезаргументныеЭкспортные(Знач ТипКласса, Знач Исключения)

	Результат = Новый Массив();
	Для Каждого Метод Из Новый Рефлектор().ПолучитьТаблицуМетодов(ТипКласса) Цикл
		Если Метод.Экспорт И Метод.ЭтоФункция И Метод.КоличествоПараметров = 0
			И Исключения.Получить(Метод.Имя) = Неопределено Тогда
			Результат.Добавить(Метод.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Безаргументные функции КодыПомех, кодами не являющиеся.
Функция НеКоды()

	Результат = Новый Соответствие();
	Для Каждого Имя Из СтрРазделить("Все,Подсистемы,ПодсистемаХранилище,ПодсистемаЗеркало,"
		+ "ПодсистемаИсточник", ",") Цикл
		Результат.Вставить(Имя, Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
