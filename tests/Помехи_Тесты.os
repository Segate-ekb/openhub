// Ядро помех: свёртка повторов под замком (в том числе из нескольких потоков), потолок
// пары подсистема + объект со сводкой «прочее», срок жизни, обезличивание причины и адреса,
// прогон как граница «текущего», признак устранимости и обещание «летопись наружу
// не бросает». Контейнер настоящий, база настоящая (КоннекторInMemory), время ручное:
// срок и «последний раз» проверяются значением, а не ожиданием.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать autumn-logos
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем КореньХранилища;

Перем Хранилище;   // ХранилищеПомех — желудь настоящего контейнера
Перем Коды;        // КодыПомех — желудь настоящего контейнера
Перем Объекты;     // ОбъектыПомех — желудь настоящего контейнера
Перем Имена;       // ИмяОбъектаАудита — желудь настоящего контейнера
Перем Читатель;    // ЧитательПомех — желудь настоящего контейнера

Перем Настройки;   // НастройкиЗаглушка — числа инсталляции для поведенческих тестов
Перем Часы;        // ЧасыРучные
Перем Летопись;    // ЛетописьПомех на ручных часах и заглушке настроек

Перем НомерОбъекта;   // уникализация объекта между тестами: база общая на набор

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	НомерОбъекта = 0;

КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПодключитьСлоиХаба(КаталогМодулей);

	РеестрФикстур.Подключить("НастройкиЗаглушка");
	РеестрФикстур.Подключить("ЧасыРучные");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("ХранилищеПомехПадающее");
	РеестрФикстур.Подключить("ФейкЛетописьПомех");
	РеестрФикстур.Подключить("ЗаписьПомехПотоком");

	КореньХранилища = УникальныеИмена.ВременныйКаталог("oshub-помехи");

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньХранилища);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "помехи-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	// autumn-properties.json проекта приоритетнее деталек: имя файла уводится
	// в несуществующее, иначе набор уедет на КоннекторJSON и общую базу
	Совет.ИмяФайлаСоЗначениямиДеталек("помехи-тесты-properties");
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Хранилище = Поделка.НайтиЖелудь("ХранилищеПомех");
	Коды = Поделка.НайтиЖелудь("КодыПомех");
	Объекты = Поделка.НайтиЖелудь("ОбъектыПомех");
	Читатель = Поделка.НайтиЖелудь("ЧитательПомех");
	Имена = Поделка.НайтиЖелудь("ИмяОбъектаАудита");

КонецПроцедуры

// Таблица общая на набор, а уборка по сроку смотрит на неё целиком: без чистки перед
// каждым тестом сторож срока считал бы записи соседей.
&ПередКаждым
Процедура СвежаяЛетописьНадПустойТаблицей() Экспорт

	Настройки = Новый НастройкиЗаглушка();
	Часы = Новый ЧасыРучные(Дата(2026, 9, 21, 12, 0, 0));
	Летопись = НоваяЛетопись(Хранилище, Настройки, Неопределено);

	Для Каждого Запись Из Хранилище.СтарееЧем(Дата(2100, 1, 1)) Цикл
		Хранилище.Удалить(Запись);
	КонецЦикла;

КонецПроцедуры

#Область СборкаЖелудей

&Тест
Процедура ВсеЖелудиПомехСобраныНастоящимКонтейнером() Экспорт

	// ОСень глотает ошибку сборки желудя (лог + Неопределено): опечатка в прозвище
	// пластилина не уронит старт хаба, а взорвётся на первом тике чистки через час
	Ожидаемые = Новый Соответствие();
	Ожидаемые.Вставить("ХранилищеПомех", "ХранилищеПомех");
	Ожидаемые.Вставить("КодыПомех", "КодыПомех");
	Ожидаемые.Вставить("ОбъектыПомех", "ОбъектыПомех");
	Ожидаемые.Вставить("ЛетописьПомех", "ЛетописьПомех");
	Ожидаемые.Вставить("ЧитательПомех", "ЧитательПомех");
	Ожидаемые.Вставить("ЗадачаЧисткиПомех", "ЗадачаЧисткиПомех");
	// ЗапросыПомех приезжает декоратором autumn-data — тип у него чужой, спрашиваем
	// только сборку и рабочий метод
	Ожидаем.Что(Поделка.НайтиЖелудь("ЗапросыПомех"), "желудь ЗапросыПомех").Существует();

	Несобранные = Новый Массив();
	ЧужогоТипа = Новый Массив();
	Для Каждого ИмяИТип Из Ожидаемые Цикл
		Желудь = Поделка.НайтиЖелудь(ИмяИТип.Ключ);
		Если Желудь = Неопределено Тогда
			Несобранные.Добавить(ИмяИТип.Ключ);
		ИначеЕсли ТипЗнч(Желудь) <> Тип(ИмяИТип.Значение) Тогда
			ЧужогоТипа.Добавить(СтрШаблон("%1 — %2", ИмяИТип.Ключ, ТипЗнч(Желудь)));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Несобранные, ", "), "желуди, которых контейнер не собрал").Равно("");
	Ожидаем.Что(СтрСоединить(ЧужогоТипа, ", "), "желуди, собранные не тем классом").Равно("");

КонецПроцедуры

&Тест
Процедура ТаблицаПомехЖивётВНастоящейБазе() Экспорт

	Объект = НовыйОбъект();
	Ожидаем.Что(Читатель.ЧислоПомех(Зеркало(), Объект), "пустой объект").Равно(0);

	ЗаписатьЗеркало(Объект, "oint@1.0.0", Коды.ПустоеТело(), "Апстрим ответил без тела");

	Ожидаем.Что(Читатель.ЧислоПомех(Зеркало(), Объект), "запись легла в таблицу").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Свёртка

&Тест
Процедура ОдинаковаяПричинаНеПлодитЗаписейАСчитаетПовторы() Экспорт

	Объект = НовыйОбъект();
	Впервые = Часы.Сейчас();

	Для Повтор = 1 По 5 Цикл
		ЗаписатьЗеркало(Объект, "oint@1.0.0", Коды.ИсточникНеОтветил(), "Источник не ответил");
		Часы.Прибавить(60);
	КонецЦикла;

	Строки = Читатель.ПомехиОбъекта(Зеркало(), Объект);

	Ожидаем.Что(Строки.Количество(), "пять повторов дали одну запись").Равно(1);
	Ожидаем.Что(Строки[0].Количество, "счётчик повторов").Равно(5);
	Ожидаем.Что(Строки[0].Впервые, "момент первого раза не двигается").Равно(Впервые);
	Ожидаем.Что(Строки[0].Последний, "момент последнего раза — от пятой записи")
		.Равно(Впервые + 240);

КонецПроцедуры

&Тест
Процедура РазныеПредметыИКодыРазводятсяПоЗаписям() Экспорт

	Объект = НовыйОбъект();

	ЗаписатьЗеркало(Объект, "oint@1.0.0", Коды.ПустоеТело(), "Тела нет");
	ЗаписатьЗеркало(Объект, "oint@2.0.0", Коды.ПустоеТело(), "Тела нет");
	ЗаписатьЗеркало(Объект, "oint@1.0.0", Коды.АрхивНеРазбирается(), "Архив битый");

	Ожидаем.Что(Читатель.ПомехиОбъекта(Зеркало(), Объект).Количество(),
		"предмет и код — части ключа").Равно(3);

КонецПроцедуры

&Тест
Процедура ЧужойОбъектВВыдачуНеПопадает() Экспорт

	Свой = НовыйОбъект();
	Чужой = НовыйОбъект();

	ЗаписатьЗеркало(Свой, "oint@1.0.0", Коды.ПустоеТело(), "Тела нет");
	ЗаписатьЗеркало(Чужой, "winow@1.0.0", Коды.ПустоеТело(), "Тела нет");

	Строки = Читатель.ПомехиОбъекта(Зеркало(), Свой);

	Ожидаем.Что(Строки.Количество(), "в выдаче только свой объект").Равно(1);
	Ожидаем.Что(Строки[0].Предмет, "предмет своего объекта").Равно("oint@1.0.0");
	Ожидаем.Что(Читатель.ЕстьПомехи(Зеркало(), Свой), "у объекта есть помехи").ЭтоИстина();
	Ожидаем.Что(Читатель.ЕстьПомехи(Зеркало(), НовыйОбъект()), "у нетронутого объекта помех нет")
		.ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПоследниеПомехиИдутСверху() Экспорт

	Объект = НовыйОбъект();

	ЗаписатьЗеркало(Объект, "oint@1.0.0", Коды.ПустоеТело(), "Тела нет");
	Часы.Прибавить(60);
	ЗаписатьЗеркало(Объект, "winow@1.0.0", Коды.КвотаПула(), "Пул переполнен");

	Строки = Читатель.ПомехиОбъекта(Зеркало(), Объект);

	Ожидаем.Что(Строки[0].Предмет, "свежая запись сверху").Равно("winow@1.0.0");
	Ожидаем.Что(Строки[1].Предмет, "прежняя — под ней").Равно("oint@1.0.0");
	Ожидаем.Что(Читатель.ПомехиОбъекта(Зеркало(), Объект, "", 1).Количество(),
		"ограничение режет выдачу").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ОдновременнаяЗапись

// Настоящая одновременность, а не два последовательных вызова: read-modify-write без
// замка даёт здесь дубль ключа и потерянные инкременты.
&Тест
Процедура ЧетыреПотокаНаОдинКлючДаютОднуЗаписьИПолныйСчётчик() Экспорт

	Ловушка = ЛетописьСЛовушкой("один-ключ");
	Объект = НовыйОбъект();
	Потоков = 4;
	Кругов = 25;

	Предметы = Новый Массив();
	Предметы.Добавить("oint@1.0.0");

	Итог = ПрогнатьПотоки(Потоков, Объект, Предметы, Кругов);

	Строки = Читатель.ПомехиОбъекта(Зеркало(), Объект);

	// летопись наружу не бросает, поэтому «потоки не упали» само по себе ничего
	// не значит: спрашиваем её собственные жалобы, иначе падение назовёт счётчик,
	// а не причину
	Ожидаем.Что(Ловушка.Всё(), "летопись ни разу не пожаловалась").Равно("");
	Ожидаем.Что(Итог.Доработали, "все потоки доработали до конца").Равно(Потоков);
	Ожидаем.Что(Строки.Количество(), "дубля ключа нет: запись одна").Равно(1);
	Ожидаем.Что(Строки[0].Количество, "ни один инкремент не потерян")
		.Равно(Потоков * Кругов);

КонецПроцедуры

&Тест
Процедура ПотолокДержитсяИПодОдновременнойЗаписью() Экспорт

	Ловушка = ЛетописьСЛовушкой("потолок");
	Настройки.Задать("oshub.incidents.max_per_object", 3);
	Объект = НовыйОбъект();

	Предметы = Новый Массив();
	Для Номер = 1 По 12 Цикл
		Предметы.Добавить(СтрШаблон("pkg%1@1.0.0", Номер));
	КонецЦикла;

	Итог = ПрогнатьПотоки(4, Объект, Предметы, 3);

	Строки = Читатель.ПомехиОбъекта(Зеркало(), Объект);

	Ожидаем.Что(Ловушка.Всё(), "летопись ни разу не пожаловалась").Равно("");
	Ожидаем.Что(Итог.Доработали, "все потоки доработали до конца").Равно(4);
	// под замком число детерминировано: два обычных ключа и сводка
	Ожидаем.Что(Строки.Количество(), "потолок 3 не перешагнут и не недобран").Равно(3);
	Ожидаем.Что(ЗаписейСКодом(Строки, Коды.Прочее()),
		"сводка переполнения одна").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ПотолокНаОбъект

&Тест
Процедура ПятьдесятПервыйКлючУходитВПрочееАПрочееОдноИСчитает() Экспорт

	// потолок по умолчанию — 50; последний слот пары держит сводку переполнения,
	// поэтому своих ключей помещается 49, а 50-м встаёт «прочее»
	Объект = НовыйОбъект();

	Для Номер = 1 По 51 Цикл
		ЗаписатьЗеркало(Объект, СтрШаблон("pkg%1@1.0.0", Номер),
			Коды.ПустоеТело(), "Тела нет");
	КонецЦикла;

	Строки = Читатель.ПомехиОбъекта(Зеркало(), Объект);

	Ожидаем.Что(Строки.Количество(), "записей на объект — ровно потолок").Равно(50);
	Ожидаем.Что(ЗаписейСКодом(Строки, Коды.Прочее()), "сводка переполнения одна").Равно(1);
	Ожидаем.Что(ПерваяСКодом(Строки, Коды.Прочее()).Количество,
		"«прочее» считает всех, кто не поместился").Равно(2);

КонецПроцедуры

&Тест
Процедура ПотолокСчитаетсяПоПареПодсистемаИОбъект() Экспорт

	Настройки.Задать("oshub.incidents.max_per_object", 3);
	Первый = НовыйОбъект();
	Второй = НовыйОбъект();

	Для Номер = 1 По 10 Цикл
		ЗаписатьЗеркало(Первый, СтрШаблон("pkg%1@1.0.0", Номер), Коды.ПустоеТело(), "Тела нет");
	КонецЦикла;
	ЗаписатьЗеркало(Второй, "winow@1.0.0", Коды.КвотаПула(), "Пул переполнен");

	Ожидаем.Что(Читатель.ЧислоПомех(Зеркало(), Первый), "переполненный объект").Равно(3);
	Ожидаем.Что(Читатель.ЧислоПомех(Зеркало(), Второй), "соседний объект потолком не задет")
		.Равно(1);
	Ожидаем.Что(ПерваяСКодом(Читатель.ПомехиОбъекта(Зеркало(), Первый), Коды.Прочее()).Количество,
		"в «прочее» ушли все, кроме двух своих ключей").Равно(8);

КонецПроцедуры

// Край, на котором прежняя редакция молча теряла запись: сводки этого прогона нет,
// а свободных слотов тоже нет — потому что их выбрали сводки чужих прогонов.
&Тест
Процедура ПереполнениеБезСвоейСводкиСчитаетсяЧужойАНеПропадает() Экспорт

	Настройки.Задать("oshub.incidents.max_per_object", 2);
	Объект = НовыйОбъект();

	// прогон-1 набивает пару до потолка: один свой ключ и сводка
	ЗаписатьВПрогоне(Объект, "pkg1@1.0.0", Коды.ПустоеТело(), "прогон-1");
	ЗаписатьВПрогоне(Объект, "pkg2@1.0.0", Коды.ПустоеТело(), "прогон-1");
	Ожидаем.Что(Читатель.ЧислоПомех(Зеркало(), Объект), "пара набита прогоном-1").Равно(2);

	// прогон-2 приходит БЕЗ снятия прошлого: места нет и своей сводки нет
	ДоПрихода = СуммаСчётчиков(Читатель.ПомехиОбъекта(Зеркало(), Объект));
	ЗаписатьВПрогоне(Объект, "pkg9@1.0.0", Коды.КвотаПула(), "прогон-2");
	Строки = Читатель.ПомехиОбъекта(Зеркало(), Объект);

	Ожидаем.Что(Строки.Количество(), "потолок не перешагнут").Равно(2);
	Ожидаем.Что(СуммаСчётчиков(Строки), "счёт вырос: запись не пропала молча")
		.Равно(ДоПрихода + 1);
	Ожидаем.Что(ПерваяСКодом(Строки, Коды.Прочее()).Количество,
		"счёт ушёл лежащей сводке").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область ДвеПодсистемыВОдномОбъекте

// ИСТ-АПСТ-009: в «источник/<адрес>» пишут и проба пула, и обход зеркала. Соседи
// не имеют права стирать и вытеснять друг друга.
&Тест
Процедура СнятиеОднойПодсистемыНеТрогаетПомехиДругой() Экспорт

	Объект = Объекты.Источник("https://hub.example/download/");
	Летопись.Записать(Источник(), Объект, "", Коды.ИсточникЛежит(), "Источник лежит");
	Летопись.Записать(Зеркало(), Объект, "oint@1.0.0", Коды.ПустоеТело(), "Тела нет", "прогон-1");

	Летопись.Снять(Источник(), Объект);

	Ожидаем.Что(Читатель.ЧислоПомех(Источник(), Объект), "проба свои помехи сняла").Равно(0);
	Ожидаем.Что(Читатель.ЧислоПомех(Зеркало(), Объект), "помехи зеркала на месте").Равно(1);

КонецПроцедуры

&Тест
Процедура НачалоПрогонаЗеркалаНеТрогаетПомехиПробы() Экспорт

	Объект = Объекты.Источник("https://hub.example/download/");
	Летопись.Записать(Источник(), Объект, "", Коды.ИсточникНеПустил(), "Токен отвергнут");
	Летопись.Записать(Зеркало(), Объект, "oint@1.0.0", Коды.ПустоеТело(), "Тела нет", "прогон-1");

	Летопись.НачатьПрогон(Зеркало(), Объект, "прогон-2");

	Ожидаем.Что(Читатель.ЧислоПомех(Источник(), Объект),
		"пустой прогон пробы не считается прошлым прогоном зеркала").Равно(1);
	Ожидаем.Что(Читатель.ЧислоПомех(Зеркало(), Объект),
		"прошлый прогон зеркала снят").Равно(0);

КонецПроцедуры

&Тест
Процедура ПотолокОднойПодсистемыНеВытесняетПричиныДругой() Экспорт

	Настройки.Задать("oshub.incidents.max_per_object", 2);
	Объект = Объекты.Источник("https://hub.example/download/");

	Летопись.Записать(Источник(), Объект, "", Коды.ИсточникЛежит(), "Источник лежит");
	Для Номер = 1 По 10 Цикл
		Летопись.Записать(Зеркало(), Объект, СтрШаблон("pkg%1@1.0.0", Номер),
			Коды.ПустоеТело(), "Тела нет", "прогон-1");
	КонецЦикла;

	Ожидаем.Что(Читатель.ЧислоПомех(Зеркало(), Объект), "зеркало упёрлось в свой потолок")
		.Равно(2);
	Ожидаем.Что(Читатель.ЧислоПомех(Источник(), Объект),
		"причина пробы не вытеснена потолком соседа").Равно(1);
	Ожидаем.Что(Читатель.ПомехиОбъекта(Источник(), Объект)[0].Код,
		"и осталась именно она").Равно(Коды.ИсточникЛежит());

КонецПроцедуры

#КонецОбласти

#Область СрокЖизни

&Тест
Процедура ЧисткаУбираетСтароеИОставляетСвежее() Экспорт

	Настройки.Задать("oshub.incidents.ttl.sec", 3600);
	Объект = НовыйОбъект();

	ЗаписатьЗеркало(Объект, "старое@1.0.0", Коды.ПустоеТело(), "Тела нет");
	Часы.Прибавить(3601);
	ЗаписатьЗеркало(Объект, "свежее@1.0.0", Коды.ПустоеТело(), "Тела нет");

	Убрано = Летопись.УбратьУстаревшие();
	Строки = Читатель.ПомехиОбъекта(Зеркало(), Объект);

	Ожидаем.Что(Убрано, "убрана одна запись").Равно(1);
	Ожидаем.Что(Строки.Количество(), "свежая осталась").Равно(1);
	Ожидаем.Что(Строки[0].Предмет, "осталась именно свежая").Равно("свежее@1.0.0");

КонецПроцедуры

&Тест
Процедура ПовторПродлеваетЖизньЗаписи() Экспорт

	// срок считается от последнего раза, а не от первого: иначе живая причина
	// исчезала бы с экрана ровно тогда, когда она всё ещё мешает
	Настройки.Задать("oshub.incidents.ttl.sec", 3600);
	Объект = НовыйОбъект();

	ЗаписатьЗеркало(Объект, "oint@1.0.0", Коды.ПустоеТело(), "Тела нет");
	Часы.Прибавить(3000);
	ЗаписатьЗеркало(Объект, "oint@1.0.0", Коды.ПустоеТело(), "Тела нет");
	Часы.Прибавить(3000);

	Ожидаем.Что(Летопись.УбратьУстаревшие(), "повторённая запись не устарела").Равно(0);
	Ожидаем.Что(Читатель.ЧислоПомех(Зеркало(), Объект), "и осталась на месте").Равно(1);

КонецПроцедуры

