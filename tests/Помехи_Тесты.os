#Область Прогон

&Тест
Процедура ПомехиПрошлогоПрогонаНеВыдаютсяЗаТекущие() Экспорт

	Объект = НовыйОбъект();

	Летопись.НачатьПрогон(Зеркало(), Объект, "прогон-1");
	ЗаписатьВПрогоне(Объект, "oint@1.0.0", Коды.ПустоеТело(), "прогон-1");

	Летопись.НачатьПрогон(Зеркало(), Объект, "прогон-2");
	ЗаписатьВПрогоне(Объект, "winow@1.0.0", Коды.КвотаПула(), "прогон-2");

	Текущие = Читатель.ПомехиОбъекта(Зеркало(), Объект, "прогон-2");

	Ожидаем.Что(Текущие.Количество(), "в текущем прогоне одна помеха").Равно(1);
	Ожидаем.Что(Текущие[0].Предмет, "и это помеха текущего прогона").Равно("winow@1.0.0");
	Ожидаем.Что(Читатель.ЧислоПомех(Зеркало(), Объект, "прогон-1"),
		"прошлый прогон снят началом текущего").Равно(0);
	Ожидаем.Что(Читатель.ЧислоПомех(Зеркало(), Объект), "в объекте только текущее").Равно(1);
	Ожидаем.Что(Читатель.ЕстьПомехи(Зеркало(), Объект, "прогон-1"),
		"и признак по прошлому прогону это подтверждает").ЭтоЛожь();

