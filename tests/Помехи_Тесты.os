#Область Обезличивание

&Тест
Процедура ПодписьS3ИзПричиныНеПопадаетВЗапись() Экспорт

	Объект = НовыйОбъект();
	Причина = "Хранилище не приняло PUT"
		+ " https://openhub.s3.example/pools/main/oint.ospx"
		+ "?X-Amz-Signature=deadbeefcafe&X-Amz-Credential=AKIAIOSFODNN7EXAMPLE, статус 403";

	ЗаписатьЗеркало(Объект, "oint@1.0.0", Коды.ХранилищеНеПриняло(), Причина);
	Записанная = Читатель.ПомехиОбъекта(Зеркало(), Объект)[0].Причина;

	Ожидаем.Что(СтрНайти(Записанная, "X-Amz-Signature"), "подписи в причине нет").Равно(0);
	Ожидаем.Что(СтрНайти(Записанная, "deadbeefcafe"), "значения подписи нет").Равно(0);
	Ожидаем.Что(СтрНайти(Записанная, "AKIAIOSFODNN7EXAMPLE"), "ключа доступа нет").Равно(0);
	Ожидаем.Что(СтрНайти(Записанная, "openhub.s3.example") > 0,
		"а сам адрес остался: без него причина ничего не называет").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Записанная, "статус 403") > 0,
		"хвост фразы не съеден обезличиванием").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура УчётныеДанныеИТокенИзПричиныНеПопадаютВЗапись() Экспорт

	Объект = НовыйОбъект();
	Причина = "Источник не пустил: https://robot:s3cr3tpass@hub.example/download/?token=abcdef123456";

	ЗаписатьЗеркало(Объект, "oint@1.0.0", Коды.ИсточникОтветилОтказом(), Причина);
	Записанная = Читатель.ПомехиОбъекта(Зеркало(), Объект)[0].Причина;

	Ожидаем.Что(СтрНайти(Записанная, "s3cr3tpass"), "пароля в причине нет").Равно(0);
	Ожидаем.Что(СтрНайти(Записанная, "robot"), "имени пользователя нет").Равно(0);
	Ожидаем.Что(СтрНайти(Записанная, "abcdef123456"), "токена нет").Равно(0);
	Ожидаем.Что(СтрНайти(Записанная, "hub.example") > 0, "узел назван").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НазванныйСекретВычёркиваетсяИзПричиныДажеБезАдреса() Экспорт

	// голый токен адресом не является, и распознать его нечем — но названный явно
	// вычёркивается. Контроль рядом: без указания секрета он остаётся, и это честно
	Объект = НовыйОбъект();
	Токен = "ghp_SEKRETTOKEN0123456789";
	Причина = "Апстрим отверг ключ " + Токен + " с кодом 401";

	Летопись.Записать(Зеркало(), Объект, "oint@1.0.0", Коды.ИсточникНеПустил(),
		Причина, "прогон-1", Токен);
	СоСнятым = Читатель.ПомехиОбъекта(Зеркало(), Объект)[0].Причина;

	Другой = НовыйОбъект();
	Летопись.Записать(Зеркало(), Другой, "oint@1.0.0", Коды.ИсточникНеПустил(), Причина);
	БезСнятия = Читатель.ПомехиОбъекта(Зеркало(), Другой)[0].Причина;

	Ожидаем.Что(СтрНайти(СоСнятым, Токен), "названный секрет вычеркнут").Равно(0);
	Ожидаем.Что(СтрНайти(СоСнятым, "кодом 401") > 0, "остальная фраза цела").ЭтоИстина();
	Ожидаем.Что(СтрНайти(БезСнятия, Токен) > 0,
		"КОНТРОЛЬ: не названный секрет остаётся — механизм, а не магия").ЭтоИстина();

КонецПроцедуры

