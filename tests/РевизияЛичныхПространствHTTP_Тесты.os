// РЕВЬЮ-СТОРОЖА (временный набор ревью-агента): разметка окна подтверждения и границы эха.
// Проверяется, что на странице раздела нет вложенных форм ни до, ни после появления окна,
// и что эхо принимает РОВНО напечатанное число, а не всё, что к нему приводится.

#Использовать asserts
#Использовать 1connector
#Использовать "фикстуры"

Перем Хаб;
Перем Клиент; // фикстура КлиентХаба — запросы к подопытному хабу
Перем КаталогПроекта;
Перем КореньХранилища;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	КаталогПроекта = Хаб.КаталогПроекта();

	Сидер = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры");
	Сидер = ОбъединитьПути(Сидер, "ЗасеятьЛичныеПространства.os");

	Хаб.ФайловаяБаза("openhub-ревизия-личных");
	КореньХранилища = Хаб.КореньХранилища();
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Хаб.Среда("OSHUB_WEBHOOKS_RESOLVE__ENABLED", "false");

	Хаб.ЗапуститьСидер(Сидер);

	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область Разметка

// Браузер вложенную форму схлопывает и присоединяет её поля к внешней: окно
// подтверждения, попавшее внутрь формы раздела, отправляло бы эхо вместе с тумблером.
&Тест
Процедура ВложенныхФормНетНиДоОкнаНиВНём() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");

	Раздел = Клиент.Тело(Клиент.GETСКукой(Раздел(), КукаАдмина));
	Ожидаем.Что(ГлубинаФорм(Раздел), "глубина вложенности форм на разделе «Пулы»").Равно(1);

	Окно = Клиент.Тело(Клиент.POSTФормы(Раздел(),
		ПоляФормыСо(Раздел, "name=""oshub.pools.personal_enabled"""), КукаАдмина));
	Ожидаем.Что(СтрНайти(Окно, "name=""подтверждение""") > 0, "окно подтверждения показано").ЭтоИстина();
	Ожидаем.Что(ГлубинаФорм(Окно), "глубина вложенности форм на странице с окном").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ГраницыЭха

// Эхо — точное совпадение строки. Всё, что «похоже на число», должно отвергаться:
// иначе подтверждение перестаёт быть осознанным вводом.
&Тест
Процедура ПохожиеНаЧислоЭхаОтвергаются() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Окно = ОткрытьОкно(КукаАдмина);
	Число_ = ЧислоИзОкна(Окно);

	Ожидаем.Что(Число_, "в окне напечатано число пространств").Равно("4");

	Отвергнуть(Окно, КукаАдмина, "0" + Число_, "ведущий ноль");
	Отвергнуть(Окно, КукаАдмина, Число_ + ".0", "дробная запись");
	Отвергнуть(Окно, КукаАдмина, "-" + Число_, "отрицательное");
	Отвергнуть(Окно, КукаАдмина, "+" + Число_, "со знаком плюс");
	Отвергнуть(Окно, КукаАдмина, Число_ + Число_, "число дважды");
	Отвергнуть(Окно, КукаАдмина, "все", "слово вместо числа");
	Отвергнуть(Окно, КукаАдмина, "", "пустое подтверждение");

	Ожидаем.Что(ЛичныйПулЕсть("anna"), "после всех отказов пространство anna на месте").ЭтоИстина();
	Ожидаем.Что(ЛичныйПулЕсть("boris"), "и boris").ЭтоИстина();
	Ожидаем.Что(АртефактЕсть("anna", "anna-lib", "1.0.0"), "и его артефакт").ЭтоИстина();

КонецПроцедуры

// Пробелы вокруг числа отбрасываются: человек, скопировавший число из окна, не должен
// получить отказ. Это осознанное послабление, и оно закреплено сторожем.
&Тест
Процедура ПробелыВокругЧислаНеМешают() Экспорт

	КукаАдмина = Клиент.Войти("root", "RootPassw0rd");
	Окно = ОткрытьОкно(КукаАдмина);

	Поля = ПоляФормыСо(Окно, "name=""подтверждение""");
	Поля.Вставить("подтверждение", "  " + ЧислоИзОкна(Окно) + "  ");

	Ответ = Клиент.POSTФормы(Раздел(), Поля, КукаАдмина);
	Ожидаем.Что(Ответ.КодСостояния, "эхо с пробелами принято").Равно(200);
	Ожидаем.Что(ЛичныйПулЕсть("anna"), "и пространства снесены").ЭтоЛожь();

	// проектный пул и его файл каскад не тронул
	СтраницаПула = Клиент.GET("/shared/shared-lib");
	Ожидаем.Что(СтраницаПула.КодСостояния,
		"проектный пул на месте." + ЖурналПриОтказе(СтраницаПула)).Равно(200);
	Ожидаем.Что(АртефактЕсть("shared", "shared-lib", "1.0.0"), "и его артефакт").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Помощники

Функция Раздел()
	Возврат "/hub/settings/pools";
КонецФункции

// Хаб живёт отдельным процессом, и его стектрейс никуда не печатается: 5xx в регрессии
// выглядел голым «ожидали 200, получили 500», и отличить дефект продукта от гонки было
// не на чем. Диагностика прикладывается ТОЛЬКО к отказу — у зелёного теста сообщение
// пустое, и вывод хаба не вычитывается зря.
Функция ЖурналПриОтказе(Знач Ответ)

	Если Ответ.КодСостояния = 200 Тогда
		Возврат "";
	КонецЕсли;

	Возврат " Код " + Ответ.КодСостояния + ", тело: "
		+ Лев(Ответ.ПолучитьТелоКакСтроку(), 500) + Символы.ПС
		+ "Журнал хаба: " + Прав(Хаб.Дамп(), 4000);

КонецФункции

Процедура Отвергнуть(Знач Окно, Знач Кука, Знач Эхо, Знач Пояснение)

	Поля = ПоляФормыСо(Окно, "name=""подтверждение""");
	Поля.Вставить("подтверждение", Эхо);

	Ожидаем.Что(Клиент.POSTФормы(Раздел(), Поля, Кука).КодСостояния,
		"эхо «" + Эхо + "» (" + Пояснение + ") отвергнуто").Равно(400);

КонецПроцедуры

Функция ОткрытьОкно(Знач Кука)
	Возврат Клиент.Тело(Клиент.POSTФормы(Раздел(),
		ПоляФормыСо(Клиент.Тело(Клиент.GETСКукой(Раздел(), Кука)), "name=""oshub.pools.personal_enabled"""), Кука));
КонецФункции

// Максимальная глубина вложенности <form> в разметке.
Функция ГлубинаФорм(Знач Разметка)

	Глубина = 0;
	Максимум = 0;
	Хвост = Разметка;

	Пока Истина Цикл

		Открытие = СтрНайти(Хвост, "<form");
		Закрытие = СтрНайти(Хвост, "</form>");

		Если Открытие = 0 И Закрытие = 0 Тогда
			Прервать;
		КонецЕсли;

		Если Открытие > 0 И (Закрытие = 0 ИЛИ Открытие < Закрытие) Тогда
			Глубина = Глубина + 1;
			Максимум = Макс(Максимум, Глубина);
			Хвост = Сред(Хвост, Открытие + 5);
		Иначе
			Глубина = Глубина - 1;
			Хвост = Сред(Хвост, Закрытие + 7);
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(Глубина, "все формы закрыты").Равно(0);
	Ожидаем.Что(Максимум > 0, "формы на странице вообще есть").ЭтоИстина();
	Возврат Максимум;

КонецФункции

Функция ЧислоИзОкна(Знач Окно)

	Маркер = "личных пространств — ";
	Поз = СтрНайти(Окно, Маркер);
	Если Поз = 0 Тогда
		ВызватьИсключение "В окне предупреждения нет числа удаляемых пространств";
	КонецЕсли;

	Остаток = Сред(Окно, Поз + СтрДлина(Маркер));
	Цифры = "";
	Для Позиция = 1 По СтрДлина(Остаток) Цикл
		Символ = Сред(Остаток, Позиция, 1);
		Если СтрНайти("0123456789", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		Цифры = Цифры + Символ;
	КонецЦикла;

	Возврат Цифры;

КонецФункции

Функция ЛичныйПулЕсть(Знач Логин)
	Возврат Клиент.GET("/" + Логин).КодСостояния = 200;
КонецФункции

Функция АртефактЕсть(Знач ИмяПула, Знач ИмяПакета, Знач Версия)
	Путь = ОбъединитьПути(ОбъединитьПути(КореньХранилища, "pools", ИмяПула), ИмяПакета,
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия));
	Возврат Новый Файл(Путь).Существует();
КонецФункции

Функция ПоляФормыСо(Знач Разметка, Знач Маркер)

	Результат = Новый Соответствие();

	Позиция = СтрНайти(Разметка, Маркер);
	Если Позиция = 0 Тогда
		ВызватьИсключение "В разметке нет формы с маркером " + Маркер;
	КонецЕсли;

	Начало = 0;
	Хвост = Лев(Разметка, Позиция);
	Ищем = СтрНайти(Хвост, "<form");
	Пока Ищем > 0 Цикл
		Начало = Начало + Ищем;
		Хвост = Сред(Хвост, Ищем + 1);
		Ищем = СтрНайти(Хвост, "<form");
	КонецЦикла;
	Если Начало = 0 Тогда
		ВызватьИсключение "Маркер " + Маркер + " найден вне формы";
	КонецЕсли;

	Остаток = Сред(Разметка, Начало);
	Конец = СтрНайти(Остаток, "</form>");
	Форма = ?(Конец = 0, Остаток, Лев(Остаток, Конец));

	Для Каждого Кусок Из СтрРазделить(Форма, "<") Цикл
		Если НЕ СтрНачинаетсяС(НРег(Кусок), "input") Тогда
			Продолжить;
		КонецЕсли;
		Имя = ЗначениеАтрибута(Кусок, "name");
		Если ПустаяСтрока(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(Имя, ЗначениеАтрибута(Кусок, "value"));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗначениеАтрибута(Знач Тег, Знач Атрибут)
	Маркер = Атрибут + "=""";
	Поз = СтрНайти(Тег, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Тег, Поз + СтрДлина(Маркер));
	Конец = СтрНайти(Остаток, """");
	Возврат ?(Конец = 0, "", Лев(Остаток, Конец - 1));
КонецФункции

#КонецОбласти
