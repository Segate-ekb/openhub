// Контрактные тесты совместимости с настоящим opm: реальный хаб с засеянным пакетом,
// install по имени, по версии, по каноническому адресу /api/v1 и через вечные алиасы,
// отрицательные сценарии, Authorization. ПутьНаСервере и РесурсПубликацииПакетов задаются
// в opm.cfg, поэтому немодифицированный opm ходит прямо в новое дерево адресов.

#Использовать asserts
#Использовать "фикстуры"

Перем Хаб;              // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Порт;             // порт тестового экземпляра (выдан ОС через фикстуру)
Перем КореньДанных;     // временный каталог данных
Перем КаталогПроекта;   // корень репозитория
Перем ТаймаутСек;
Перем Пакет;            // имя тестового пакета
Перем ВременныеКаталоги; // временные каталоги для чистки в teardown (data-корень + opm-workdirs)

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт

	ТаймаутСек = 60;
	Пакет = "spike0c-testpkg";
	ВременныеКаталоги = Новый Массив();

КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХабСЗасевом() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");

	Хаб = Новый ЭкземплярХаба(ТаймаутСек);
	КаталогПроекта = Хаб.КаталогПроекта();

	КореньДанных = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-контракт-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньДанных);
	ВременныеКаталоги.Добавить(КореньДанных);

	ПутьФикстуры = ОбъединитьПути(КаталогПроекта, "spikes", "0c-push-contract");
	ПутьФикстуры = ОбъединитьПути(ПутьФикстуры, "fixtures", "spike0c-testpkg-0.1.0.ospx");

	Хаб.Среда("OSHUB_STORAGE_ROOT", КореньДанных);
	Хаб.Среда("OSHUB_DB_CONNECTION", ОбъединитьПути(КореньДанных, "jsondb"));
	Хаб.Среда("OSHUB_SEED_FIXTURE", ПутьФикстуры);
	Хаб.Среда("OSHUB_SEED_YANKED", "1.1.0.7");

	ЗапуститьЗасев(КаталогПроекта);

	Хаб.Запустить();
	Порт = Хаб.Порт();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт

	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;

	Для Каждого Каталог Из ВременныеКаталоги Цикл
		Попытка
			Если Новый Файл(Каталог).Существует() Тогда
				УдалитьФайлы(Каталог);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура КонтрактСпискаListTxt() Экспорт

	Ответ = GET("/api/v1/pools/public/download/list.txt");

	Ожидаем.Что(Ответ.КодСостояния, "list.txt пула отдаёт 200").Равно(200);
	Ожидаем.Что(СтрНачинаетсяС(НРег(Заголовок(Ответ, "Content-Type")), "text/plain"),
		"list.txt — text/plain (Content-Type: " + Заголовок(Ответ, "Content-Type") + ")").ЭтоИстина();

	Строки = СтрРазделить(Ответ.ПолучитьТелоКакСтроку(), Символы.ПС, Ложь);
	НайденОтдельнойСтрокой = Ложь;
	Для Каждого Строка_ Из Строки Цикл
		Если СокрЛП(Строка_) = Пакет Тогда
			НайденОтдельнойСтрокой = Истина;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(НайденОтдельнойСтрокой,
		"пакет " + Пакет + " присутствует в list.txt отдельной строкой").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КонтрактLatestОтдаётКаноническоеИмяФайла() Экспорт

	Ответ = GET("/api/v1/pools/public/download/" + Пакет + "/" + Пакет + ".ospx");

	Ожидаем.Что(Ответ.КодСостояния).Равно(200);
	Ожидаем.Что(Заголовок(Ответ, "Content-Type")).Равно("application/octet-stream");
	Ожидаем.Что(СтрНайти(Заголовок(Ответ, "Content-Disposition"), Пакет + "-1.1.0.ospx") > 0,
		"latest(stable) = 1.1.0: " + Заголовок(Ответ, "Content-Disposition")).ЭтоИстина();
	Ожидаем.Что(Ответ.ПолучитьТелоКакДвоичныеДанные().Размер() > 0, "тело .ospx не пустое").ЭтоИстина();

КонецПроцедуры

&Тест
&Тег("смоук")
&ВключенЕсли("() -> ОпмДоступен()",
	Причина = "в окружении нет исполняемого opm (контрактная проверка пропускается)")
Процедура УстановкаПоИмениLatestЧерезКаноническийПуть() Экспорт

	Результат = УстановитьOpm(Пакет, "/api/v1/pools/public/download/", "");

	Ожидаем.Что(Результат.КодВозврата,
		"opm install " + Пакет + " (latest, /api/v1) → код 0 (см. вывод opm в консоли теста)").Равно(0);
	Ожидаем.Что(ПакетУстановлен(Результат.Каталог, Пакет),
		"пакет установлен: " + Результат.Каталог).ЭтоИстина();

КонецПроцедуры

&Тест
&ВключенЕсли("() -> ОпмДоступен()",
	Причина = "в окружении нет исполняемого opm (контрактная проверка пропускается)")
Процедура УстановкаТочнойВерсии() Экспорт

	Результат = УстановитьOpm(Пакет + "@1.0.0", "/api/v1/pools/public/download/", "");

	Ожидаем.Что(Результат.КодВозврата,
		"opm install " + Пакет + "@1.0.0 → код 0").Равно(0);
	Ожидаем.Что(ПакетУстановлен(Результат.Каталог, Пакет),
		"точная версия установлена: " + Результат.Каталог).ЭтоИстина();

КонецПроцедуры

// «pkg@stable» немодифицированный opm превращает в запрос pkg-stable.ospx: имени тега
// в его словаре нет, он просто вклеивает написанное после «@» в имя артефакта. Резолв
// делает хаб — синтаксис пользователю менять не приходится, а клиент патчить не нужно.
// Какая именно версия при этом отдана, стережёт ВыдачаПакетов_Тесты: фикстура засеяна
// одними и теми же байтами под все версии, и по установленному пакету версию не узнать.
&Тест
&ВключенЕсли("() -> ОпмДоступен()",
	Причина = "в окружении нет исполняемого opm (контрактная проверка пропускается)")
Процедура УстановкаПоИмениТега() Экспорт

	Результат = УстановитьOpm(Пакет + "@stable", "/api/v1/pools/public/download/", "");

	Ожидаем.Что(Результат.КодВозврата,
		"opm install " + Пакет + "@stable → код 0 (см. вывод opm в консоли теста)").Равно(0);
	Ожидаем.Что(ПакетУстановлен(Результат.Каталог, Пакет),
		"пакет установлен по имени тега: " + Результат.Каталог).ЭтоИстина();

КонецПроцедуры

// Имя тега, которого у пакета нет, — это отказ, а не «возьмите последнюю»: молчаливая
// подмена версии ломала бы воспроизводимость сборки ровно у того, кто просил тег.
&Тест
&ВключенЕсли("() -> ОпмДоступен()",
	Причина = "в окружении нет исполняемого opm (контрактная проверка пропускается)")
Процедура ОтказУстановкиПоНеизвестномуТегу() Экспорт

	Результат = УстановитьOpm(Пакет + "@nosuchtag", "/api/v1/pools/public/download/", "");

	Ожидаем.Что(Результат.КодВозврата <> 0,
		"opm install " + Пакет + "@nosuchtag → ненулевой код (фактический: "
			+ Формат(Результат.КодВозврата, "ЧГ=0; ЧН=0") + ")").ЭтоИстина();
	Ожидаем.Что(ПакетУстановлен(Результат.Каталог, Пакет),
		"по неизвестному тегу не установлено ничего").ЭтоЛожь();

КонецПроцедуры

&Тест
&ВключенЕсли("() -> ОпмДоступен()",
	Причина = "в окружении нет исполняемого opm (контрактная проверка пропускается)")
Процедура УстановкаЧерезКанальныйКаноническийПуть() Экспорт

	Результат = УстановитьOpm(Пакет, "/api/v1/pools/public/channels/stable/download/", "");

	Ожидаем.Что(Результат.КодВозврата,
		"opm install " + Пакет + " через канальный /api/v1-путь → код 0").Равно(0);
	Ожидаем.Что(ПакетУстановлен(Результат.Каталог, Пакет),
		"пакет установлен каналом: " + Результат.Каталог).ЭтоИстина();

КонецПроцедуры

&Тест
&ВключенЕсли("() -> ОпмДоступен()",
	Причина = "в окружении нет исполняемого opm (контрактная проверка пропускается)")
Процедура УстановкаЧерезДефолтныйАлиас() Экспорт

	Результат = УстановитьOpm(Пакет, "/download/", "");

	Ожидаем.Что(Результат.КодВозврата,
		"opm install " + Пакет + " через дефолтный алиас /download/ → код 0").Равно(0);
	Ожидаем.Что(ПакетУстановлен(Результат.Каталог, Пакет),
		"пакет установлен через алиас: " + Результат.Каталог).ЭтоИстина();

КонецПроцедуры

// Алиас пулового пути — вторая форма обратной совместимости: в opm.cfg он прописан
// у тех, кто настраивал пул до переезда адресов под /api/v1.
&Тест
&ВключенЕсли("() -> ОпмДоступен()",
	Причина = "в окружении нет исполняемого opm (контрактная проверка пропускается)")
Процедура УстановкаЧерезПуловыйАлиас() Экспорт

	Результат = УстановитьOpm(Пакет, "/pools/public/download/", "");

	Ожидаем.Что(Результат.КодВозврата,
		"opm install " + Пакет + " через алиас /pools/public/download/ → код 0").Равно(0);
	Ожидаем.Что(ПакетУстановлен(Результат.Каталог, Пакет),
		"пакет установлен через пуловый алиас: " + Результат.Каталог).ЭтоИстина();

КонецПроцедуры

&Тест
&ВключенЕсли("() -> ОпмДоступен()",
	Причина = "в окружении нет исполняемого opm (контрактная проверка пропускается)")
Процедура ОтказУстановкиНесуществующегоПакета() Экспорт

	Несуществующий = "нетакогопакета-" + Строка(Новый УникальныйИдентификатор);
	Результат = УстановитьOpm(Несуществующий, "/api/v1/pools/public/download/", "");

	Ожидаем.Что(Результат.КодВозврата <> 0,
		"opm install несуществующего пакета → ненулевой код (фактический: "
			+ Формат(Результат.КодВозврата, "ЧГ=0; ЧН=0") + ")").ЭтоИстина();
	Ожидаем.Что(ПакетУстановлен(Результат.Каталог, Несуществующий),
		"несуществующий пакет НЕ установлен").ЭтоЛожь();

КонецПроцедуры

&Тест
&ВключенЕсли("() -> ОпмДоступен()",
	Причина = "в окружении нет исполняемого opm (контрактная проверка пропускается)")
Процедура ОтказУстановкиНесуществующейВерсии() Экспорт

	Результат = УстановитьOpm(Пакет + "@9.9.9", "/api/v1/pools/public/download/", "");

	Ожидаем.Что(Результат.КодВозврата <> 0,
		"opm install " + Пакет + "@9.9.9 → ненулевой код (фактический: "
			+ Формат(Результат.КодВозврата, "ЧГ=0; ЧН=0") + ")").ЭтоИстина();

КонецПроцедуры

&Тест
&ВключенЕсли("() -> ОпмДоступен()",
	Причина = "в окружении нет исполняемого opm (контрактная проверка пропускается)")
Процедура УстановкаСЗаголовкомAuthorizationНеЛомается() Экспорт

	Результат = УстановитьOpm(Пакет, "/api/v1/pools/public/download/", "Bearer test-token-1h");

	Ожидаем.Что(Результат.КодВозврата,
		"opm install с Authorization на публичном пуле → код 0 (канал жив; "
			+ "доставка заголовка и принуждение приватности — 2.B)").Равно(0);
	Ожидаем.Что(ПакетУстановлен(Результат.Каталог, Пакет),
		"пакет установлен при наличии Authorization: " + Результат.Каталог).ЭтоИстина();

КонецПроцедуры

Функция УстановитьOpm(Знач АргументУстановки, Знач ПутьНаСервере, Знач Авторизация)

	РабочийКаталог = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-opm-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(РабочийКаталог);
	ВременныеКаталоги.Добавить(РабочийКаталог);

	ПолеАвторизации = "";
	Если ЗначениеЗаполнено(Авторизация) Тогда
		ПолеАвторизации = СтрШаблон(",
		|            ""Авторизация"": ""%1""", Авторизация);
	КонецЕсли;

	Конфиг = СтрШаблон(
	"{
	|    ""СервераПакетов"": [
	|        {
	|            ""Имя"": ""openhub-контракт"",
	|            ""Сервер"": ""http://localhost"",
	|            ""Порт"": %1,
	|            ""ПутьНаСервере"": ""%2"",
	|            ""РесурсПубликацииПакетов"": ""/api/v1/pools/public/push""%3,
	|            ""Приоритет"": 0
	|        }
	|    ]
	|}", Формат(Порт, "ЧГ=0; ЧН=0"), ПутьНаСервере, ПолеАвторизации);

	ЗаписьКонфига = Новый ЗаписьТекста(ОбъединитьПути(РабочийКаталог, "opm.cfg"), КодировкаТекста.UTF8);
	ЗаписьКонфига.Записать(Конфиг);
	ЗаписьКонфига.Закрыть();

	ПроцессOpm = СоздатьПроцесс("opm install -l " + АргументУстановки, РабочийКаталог, Истина);
	ПроцессOpm.Запустить();
	ДождатьсяПроцесса(ПроцессOpm, "opm install " + АргументУстановки);

	Результат = Новый Структура("КодВозврата, Каталог", ПроцессOpm.КодВозврата, РабочийКаталог);
	Возврат Результат;

КонецФункции

Функция ПакетУстановлен(Знач РабочийКаталог, Знач ИмяПакета)
	Манифест = ОбъединитьПути(РабочийКаталог, "oscript_modules", ИмяПакета, "opm-metadata.xml");
	Возврат Новый Файл(Манифест).Существует();
КонецФункции

// Есть ли в окружении исполняемый opm — проба «opm version».
//
// Возвращаемое значение:
//  Булево - Истина, если opm запустился с нулевым кодом возврата.
//
Функция ОпмДоступен() Экспорт

	Попытка
		Проба = СоздатьПроцесс("opm version", , Истина);
		Проба.Запустить();
		ДождатьсяПроцесса(Проба, "opm version");
		Возврат Проба.КодВозврата = 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Процедура ДождатьсяПроцесса(Знач Процесс_, Знач Пояснение)

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСек * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Если Процесс_.Завершен Тогда
			Возврат;
		КонецЕсли;
		Приостановить(300);
	КонецЦикла;

	ВызватьИсключение СтрШаблон("Процесс ""%1"" не завершился за %2 сек", Пояснение, ТаймаутСек);

КонецПроцедуры

Функция Соединение()
	Возврат Новый HTTPСоединение("localhost", Порт, , , , 15);
КонецФункции

Функция GET(Знач Путь)
	Возврат Соединение().Получить(Новый HTTPЗапрос(Путь));
КонецФункции

Функция Заголовок(Знач Ответ, Знач Имя)

	ИскомыйКлюч = ВРег(Имя);
	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = ИскомыйКлюч Тогда
			Возврат КиЗ.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Процедура ЗапуститьЗасев(Знач КаталогПроекта)

	ПутьЗасевщика = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры", "ЗасеятьПакет.os");
	Команда = СтрШаблон("oscript ""%1""", ПутьЗасевщика);
	ПроцессЗасева = СоздатьПроцесс(Команда, КаталогПроекта, Истина);
	ПроцессЗасева.Запустить();

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСек * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Если ПроцессЗасева.Завершен Тогда
			Прервать;
		КонецЕсли;
		Приостановить(300);
	КонецЦикла;

	Если НЕ ПроцессЗасева.Завершен Тогда
		ВызватьИсключение "Засев не завершился за отведённое время";
	КонецЕсли;

	Если ПроцессЗасева.КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("Засев завершился с ошибкой (код %1); см. вывод засевщика в консоли теста",
			Формат(ПроцессЗасева.КодВозврата, "ЧГ=0; ЧН=0"));
	КонецЕсли;

КонецПроцедуры
