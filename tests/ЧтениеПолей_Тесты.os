// Примитив основа/ЧтениеПолей: одно правило чтения поля недоверенного набора.
// Проверяется значение — что Структура и Соответствие читаются одинаково, а «поля нет»,
// «поле Неопределено» и «набор не того типа» дают ровно значение по умолчанию.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем ЧтениеПолей;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.ПодключитьОснову(Модули);

КонецПроцедуры

&ПередКаждым
Процедура СобратьЧтение() Экспорт
	ЧтениеПолей = Новый ЧтениеПолей();
КонецПроцедуры

&Тест
Процедура СтруктураИСоответствиеЧитаютсяОдинаково() Экспорт

	Структура_ = Новый Структура("пакет, версия", "oscript-ui", "1.2.3");

	Соответствие_ = Новый Соответствие();
	Соответствие_.Вставить("пакет", "oscript-ui");
	Соответствие_.Вставить("версия", "1.2.3");

	Ожидаем.Что(ЧтениеПолей.Поле(Структура_, "пакет", ""), "поле структуры").Равно("oscript-ui");
	Ожидаем.Что(ЧтениеПолей.Поле(Соответствие_, "пакет", ""), "поле соответствия")
		.Равно("oscript-ui");

КонецПроцедуры

&Тест
Процедура ОтсутствующееПолеДаётУмолчание() Экспорт

	Ожидаем.Что(ЧтениеПолей.Поле(Новый Структура("пакет", "x"), "пул", "public"),
		"поля нет — умолчание").Равно("public");
	Ожидаем.Что(ЧтениеПолей.Поле(Новый Соответствие(), "пул", "public"),
		"пустое соответствие — умолчание").Равно("public");

КонецПроцедуры

&Тест
Процедура ПолеСоЗначениемНеопределеноЧитаетсяКакОтсутствующее() Экспорт

	Ожидаем.Что(ЧтениеПолей.Поле(Новый Структура("пул", Неопределено), "пул", "public"),
		"Неопределено в поле — то же, что поля нет").Равно("public");

	Соответствие_ = Новый Соответствие();
	Соответствие_.Вставить("пул", Неопределено);
	Ожидаем.Что(ЧтениеПолей.Поле(Соответствие_, "пул", "public"),
		"и в соответствии тоже").Равно("public");

КонецПроцедуры

&Тест
Процедура НаборНеТогоТипаЧитаетсяУмолчанием() Экспорт

	Ожидаем.Что(ЧтениеПолей.Поле(Неопределено, "пул", 0), "Неопределено вместо набора").Равно(0);
	Ожидаем.Что(ЧтениеПолей.Поле("строка", "пул", 0), "строка вместо набора").Равно(0);
	Ожидаем.Что(ЧтениеПолей.Поле(Новый Массив(), "пул", 0), "массив вместо набора").Равно(0);

КонецПроцедуры

&Тест
Процедура ЛожьИНольОтУмолчанияОтличимы() Экспорт

	Ожидаем.Что(ЧтениеПолей.Поле(Новый Структура("включено", Ложь), "включено", Истина),
		"Ложь — заданное значение, а не пустота").ЭтоЛожь();
	Ожидаем.Что(ЧтениеПолей.Поле(Новый Структура("порог", 0), "порог", 80),
		"ноль — заданное значение, а не пустота").Равно(0);

КонецПроцедуры
