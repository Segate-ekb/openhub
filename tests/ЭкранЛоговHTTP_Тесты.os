// Экран «Логи» на живом хабе: порог админа хаба, форма без токена, круг «кнопка свёрнутой
// ветки → выбор → ещё одна ветка → «Применить» → «Вернуть всё» после вопроса» так, как его прошёл
// бы браузер без скрипта, и половина «Строки» только на GET. Имена логов берутся со страницы:
// какие логи есть, решает пульт журнала, а не тест.

#Использовать asserts
#Использовать 1connector
#Использовать "фикстуры"

Перем Хаб;       // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Клиент;    // фикстура КлиентХаба — запросы к подопытному хабу
Перем Браузер;   // фикстура ФормаСоСтраницы — форма страницы так, как её отправил бы браузер

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	РеестрФикстур.Подключить("КлиентХаба");
	РеестрФикстур.Подключить("ФормаСоСтраницы");

	Хаб = Новый ЭкземплярХаба(90);
	Клиент = Новый КлиентХаба(Хаб);
	Браузер = Новый ФормаСоСтраницы();

	Сидер = ОбъединитьПути(Хаб.КаталогПроекта(), "scripts", "сидеры", "ЗасеятьКабинет.os");

	Хаб.ФайловаяБаза("openhub-логи");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");
	Хаб.ЗапуститьСидер(Сидер);
	Хаб.Запустить();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

#Область ПорогАдминаХаба

&Тест
Процедура ЛогиВидитТолькоАдминХаба() Экспорт

	Алиса = Клиент.Войти("alice", "AlicePassw0rd");
	Ожидаем.Что(Клиент.GETСКукой(Уровни(), Алиса).КодСостояния, "обычный пользователь дерева не видит")
		.Равно(403);
	Ожидаем.Что(Клиент.GETСКукой(Строки(), Алиса).КодСостояния, "и строк тоже").Равно(403);
	Ожидаем.Что(Клиент.GETСКукой(Уровни(), Клиент.Войти("owner1", "Owner1Passw0rd")).КодСостояния,
		"владелец пула — тоже").Равно(403);

	Аноним = Клиент.Тело(Клиент.Соединение().Получить(Новый HTTPЗапрос(Уровни())));
	Ожидаем.Что(СтрНайти(Аноним, "Дерево логов"), "анониму дерева не видно").Равно(0);

	Ответ = Клиент.GETСКукой(Уровни(), Клиент.Войти("root", "RootPassw0rd"));
	Ожидаем.Что(Ответ.КодСостояния, "КОНТРОЛЬ: админу хаба экран открыт").Равно(200);
	Ожидаем.Что(СтрНайти(Клиент.Тело(Ответ), "Дерево логов") > 0, "и это дерево логов").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПравкаБезТокенаФормыОтвергаетсяИНичегоНеМеняет() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Раскрытая = РаскрытаяВетка(Кука, Клиент.Тело(Клиент.GETСКукой(Уровни(), Кука)), Неопределено);
	Поле = ПервыйВыборЛога(Раскрытая.Страница);

	Поля = Браузер.СЗаменой(ПоляДерева(Раскрытая.Страница), Поле, "DEBUG");
	БезТокена = Новый Массив();
	Для Каждого Пара Из Поля Цикл
		Если Пара.Имя <> "_csrf" Тогда
			БезТокена.Добавить(Пара);
		КонецЕсли;
	КонецЦикла;

	Ответ = Клиент.POSTФормыБезПереходов(Уровни(), Браузер.Тело(БезТокена), Клиент.СтрокаКукиСессии(Кука));
	Ожидаем.Что(Ответ.КодСостояния, "форма без токена сессии — 403").Равно(403);

	После = Клиент.Тело(Клиент.GETСКукой(Раскрытая.Адрес, Кука));
	Ожидаем.Что(Браузер.Значение(ПоляДерева(После), Поле), "уровень лога не тронут").Равно("start");

КонецПроцедуры

#КонецОбласти

#Область КругФормы

// Браузер без скрипта: кнопка свёрнутой ветки раскрывает её той же формой дерева, и страница
// с выбранным приходит сразу, «Применить» уходит обычным POST со всеми полями страницы,
// перенаправление ведёт к правленой ветке, «Вернуть всё» сначала показывает, что снимется.
&Тест
Процедура ПравкаУровняПереживаетРаскрытиеИВозвращаетсяКСтартуПослеВопроса() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");
	Раскрытая = РаскрытаяВетка(Кука, Клиент.Тело(Клиент.GETСКукой(Уровни(), Кука)), Неопределено);
	Поле = ПервыйВыборЛога(Раскрытая.Страница);
	ИмяЛога = Сред(Поле, СтрДлина("уровень|") + 1);

	Выбрано = Браузер.СЗаменой(ПоляДерева(Раскрытая.Страница), Поле, "DEBUG");
	Соседняя = РаскрытаяВетка(Кука, Раскрытая.Страница, Выбрано);
	Ожидаем.Что(Браузер.Значение(ПоляДерева(Соседняя.Страница), Поле), "раскрытие соседней ветки выбор не теряет")
		.Равно("DEBUG");
	Ожидаем.Что(СтрНайти(Соседняя.Страница, "Выбрано и ещё не применено: 1") > 0,
		"и называет его неприменённым").ЭтоИстина();
	Ожидаем.Что(Браузер.Значение(ПоляДерева(Клиент.Тело(Клиент.GETСКукой(Раскрытая.Адрес, Кука))), Поле),
		"до «Применить» хаб уровня не менял").Равно("start");

	Ответ = Клиент.POSTФормыБезПереходов(Уровни(), Браузер.Тело(ПоляДерева(Соседняя.Страница)),
		Клиент.СтрокаКукиСессии(Кука));
	Ожидаем.Что(Ответ.КодСостояния >= 300 И Ответ.КодСостояния < 400, "после правки — перенаправление")
		.ЭтоИстина();
	Куда = Клиент.ЗаголовокОтвета(Ответ, "Location");
	Ожидаем.Что(СтрНайти(Куда, "#logs-") > 0, "страница откроется у правленой ветки").ЭтоИстина();

	После = Клиент.Тело(Клиент.GETСКукой(БезЯкоря(Куда), Кука));
	Ожидаем.Что(Браузер.Значение(ПоляДерева(После), Поле), "лог пишет от DEBUG").Равно("DEBUG");
	Ожидаем.Что(СтрНайти(После, "Применено к логам: 1") > 0, "экран назвал, сколько применено").ЭтоИстина();
	Ожидаем.Что(СтрНайти(После, ИмяЛога) > 0, "и какой лог").ЭтоИстина();

	Вопрос = Клиент.POSTФормыБезПереходов(Уровни(),
		Браузер.Тело(Браузер.Поля(После, "операция"" value=""к-старту")), Клиент.СтрокаКукиСессии(Кука));
	Ожидаем.Что(Вопрос.КодСостояния, "первое нажатие «Вернуть всё» только спрашивает").Равно(200);
	СтраницаВопроса = Вопрос.Текст();
	Ожидаем.Что(Браузер.Значение(ПоляДерева(СтраницаВопроса), Поле), "и ничего не снимает").Равно("DEBUG");
	Ожидаем.Что(СтрНайти(СтраницаВопроса, ">Вернуть всё как при старте (1)<") > 0,
		"вопрос называет, сколько снимется").ЭтоИстина();

	Возврат_ = Клиент.POSTФормыБезПереходов(Уровни(),
		Браузер.Тело(Браузер.Поля(СтраницаВопроса, "операция"" value=""вернуть-всё")), Клиент.СтрокаКукиСессии(Кука));
	Ожидаем.Что(Возврат_.КодСостояния >= 300 И Возврат_.КодСостояния < 400,
		"кнопка вопроса — возврат и перенаправление").ЭтоИстина();
	Итог = Клиент.Тело(Клиент.GETСКукой(Раскрытая.Адрес, Кука));
	Ожидаем.Что(Браузер.Значение(ПоляДерева(Итог), Поле), "лог снова как при старте").Равно("start");

КонецПроцедуры

#КонецОбласти

#Область Строки

&Тест
Процедура СтрокиОткрываютсяФормойОтбораИОтвечаютТолькоНаGET() Экспорт

	Кука = Клиент.Войти("root", "RootPassw0rd");

	Ответ = Клиент.GETСКукой(Строки(), Кука);
	Ожидаем.Что(Ответ.КодСостояния, "половина «Строки» открывается").Равно(200);
	Отбор = Браузер.Тег(Клиент.Тело(Ответ), "name=""level""");
	Ожидаем.Что(Браузер.Атрибут(Отбор, "method") + " " + Браузер.Атрибут(Отбор, "action"),
		"отбор строк — GET-форма на адрес половины").Равно("get " + Строки());

	Поля = Новый Соответствие();
	Поля.Вставить("_csrf", Клиент.ТокенCSRF(Клиент.Тело(Клиент.GETСКукой(Уровни(), Кука))));
	Отказ = Клиент.POSTФормы(Строки(), Поля, Кука);
	Ожидаем.Что(Отказ.КодСостояния, "POST на строки → 405").Равно(405);
	Ожидаем.Что(Клиент.ЗаголовокОтвета(Отказ, "Allow"), "405 несёт заголовок Allow").Равно("GET");

КонецПроцедуры

#КонецОбласти

#Область Помощники

// Первая свёрнутая ветка страницы, раскрытая её кнопкой в форме дерева: с формой уезжают
// выбранные поля, если их передали, иначе — поля, как их напечатала страница.
Функция РаскрытаяВетка(Знач Кука, Знач Страница, Знач Выбрано)

	Начало = СтрНайти(Страница, "data-logs-closed=""");
	Ожидаем.Что(Начало > 0, "на дереве есть свёрнутая ветка").ЭтоИстина();
	Тег = Сред(Страница, СтрНайти(Лев(Страница, Начало), "<", НаправлениеПоиска.СКонца));
	Путь = Браузер.Атрибут(Лев(Тег, СтрНайти(Тег, ">")), "data-logs-closed");

	Поля = ?(Выбрано = Неопределено, ПоляДерева(Страница), Выбрано);
	Ответ = Клиент.POSTФормыБезПереходов(Уровни(), Браузер.Тело(Браузер.Нажатием(Поля, Страница,
		"операция"" value=""дерево", "раскрыть", Путь)), Клиент.СтрокаКукиСессии(Кука));
	Ожидаем.Что(Ответ.КодСостояния, "раскрытая ветка приходит сразу, без перенаправления").Равно(200);
	Раскрытая = Ответ.Текст();

	Возврат Новый Структура("Адрес, Страница", АдресОтмены(Раскрытая), Раскрытая);

КонецФункции

// Адрес «Отменить» формы дерева: те же раскрытые ветки без выбранного.
Функция АдресОтмены(Знач Страница)
	Хвост = Сред(Страница, СтрНайти(Страница, "data-savebar"));
	Хвост = Сред(Хвост, СтрНайти(Хвост, "href=""") + 6);
	Возврат СтрЗаменить(Лев(Хвост, СтрНайти(Хвост, """") - 1), "&amp;", "&");
КонецФункции

// Имя первого выбора уровня лога в форме дерева.
Функция ПервыйВыборЛога(Знач Страница)

	Для Каждого Пара Из ПоляДерева(Страница) Цикл
		Если СтрНачинаетсяС(Пара.Имя, "уровень|") Тогда
			Возврат Пара.Имя;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "В раскрытой ветке нет ни одного правимого лога";

КонецФункции

Функция ПоляДерева(Знач Страница)
	Возврат Браузер.Поля(Страница, "операция"" value=""дерево");
КонецФункции

Функция БезЯкоря(Знач Адрес)
	Поз = СтрНайти(Адрес, "#");
	Возврат ?(Поз = 0, Адрес, Лев(Адрес, Поз - 1));
КонецФункции

Функция Уровни()
	Возврат "/hub/settings/logs";
КонецФункции

Функция Строки()
	Возврат "/hub/settings/logs/lines";
КонецФункции

#КонецОбласти
