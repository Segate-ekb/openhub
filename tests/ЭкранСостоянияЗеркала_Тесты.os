&Тест
Процедура ИтогИИнициаторНаЭкранеЭкранированы() Экспорт

	// статус пишет движок из ответа чужого хаба, инициатора — логин пользователя:
	// оба доезжают до экрана как есть
	Зеркало_ = Зеркало("ошибка");
	Зеркало_.Статус = "апстрим ответил " + Полезное();
	Зеркало_.ПрогонЗапустил = Полезное();

	HTML = ЭкранHTML(Зеркало_);

	Ожидаем.Что(СтрНайти(HTML, Полезное()), "ни итог, ни инициатор тегом не прорвались").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;script&gt;") > 0, "оба экранированы").ЭтоИстина();

