КонецПроцедуры

#КонецОбласти

#Область ЗапускСинкаВКабинете

// Кабинет — последний вход, державший HTTP-поток до конца цикла репликации. Теперь он
// ставит заявку и уходит; сеть в обработчике не трогается вовсе.
&Тест
Процедура ПринятыйЗапускВозвращаетПользователяСИтогом() Экспорт

	Ответ = Синк(Зеркало("простаивает"));

	Ожидаем.Что(Очередь_.Размер(), "заявка встала в очередь").Равно(1);
	Ожидаем.Что(Ответ.ПутьРедиректа, "принятый запуск помечен в адресе возврата")
		.Равно("/office/mirrors/owned?sync=1");

	// звено «кнопка → поставлено»: без записи в состояние прогона экран показывал бы
	// «простаивает» до первого цикла движка, то есть кнопка выглядела бы не сработавшей
	Заявки = Сервис.ЗаявкиПрогона();
	Ожидаем.Что(Заявки.Количество(), "прогон помечен поставленным ровно один раз").Равно(1);
	Ожидаем.Что(Заявки[0].Идентификатор, "поставлено то самое зеркало").Равно(1);
	Ожидаем.Что(Заявки[0].Запустил, "инициатор — логин нажавшего, а не пусто").Равно("owner1");

КонецПроцедуры

&Тест
Процедура НепринятыйЗапускНеВыдаётсяЗаУспешный() Экспорт

	// зеркало уже ждёт своей очереди: настоящая очередь повтор отвергает
	Очередь_.Поставить(1, "owner1");

	Ожидаем.Что(Синк(Зеркало("поставлено")).ПутьРедиректа, "непринятый запуск помечен отдельно")
		.Равно("/office/mirrors/owned?sync=queued");
	Ожидаем.Что(Сервис.ЗаявкиПрогона().Количество(),
		"отвергнутая заявка состояние прогона не переписывает").Равно(1);

КонецПроцедуры

// «Уже в очереди» и «прогон уже идёт» — разные вещи для человека: в первом случае ждать
// секунды, во втором — конца обхода. Один код на оба отказа этой разницы не доносил.
&Тест
Процедура ИдущийПрогонОтличёнОтОжиданияВОчереди() Экспорт

	Очередь_.Поставить(1, "owner1");
	Очередь_.Забрать(); // рабочий взял зеркало — прогон пошёл

	Ожидаем.Что(Синк(Зеркало("идёт")).ПутьРедиректа, "идущий прогон назван своим кодом")
		.Равно("/office/mirrors/owned?sync=running");

КонецПроцедуры

// Выключенная настройкой синхронизация — тот же отказ: заявку никто не разберёт,
// и обещать «прогон пошёл» значит соврать.
&Тест
Процедура ВыключеннаяСинхронизацияЗапускомНеСчитается() Экспорт

	Выключенная = Новый ОчередьСинхронизацииЗеркал(Новый ПриведениеЧисел(), Сервис,
		ЧислаЗеркал(900, Ложь),
		Логирование.ПолучитьЛог("тест.oshub.экран-зеркала"));
	Права_ = Новый ФейкСервисПрав();
	Кабинет_ = Новый КонтроллерЗеркалКабинета(ГвардКабинета, Новый ЗащитаCSRFЗаглушка(),
		Новый РазборФормы(), Пулы, Сервис, Выключенная, Права_,
		Новый СлужбаКабинета(Пулы, Неопределено, Неопределено, Права_),
		ВитринаКабинета, Ответы, UI.Тексты, Новый ПриведениеЧисел(), Новый МетодыHTTP());

	Ожидаем.Что(Синк(Зеркало("простаивает")).ПутьРедиректа, "запуск не выдан за успешный")
		.Равно("/office/mirrors/owned?sync=disabled");
	Ожидаем.Что(Сервис.ЗаявкиПрогона().Количество(),
		"и до состояния прогона ничего не дошло").Равно(0);

КонецПроцедуры

&Тест
Процедура КаждыйИтогЗапускаНазванСловамиНаСтранице() Экспорт

	Ожидаем.Что(СтрНайти(СписокКабинетаПоАдресу("1"), Текст("office.mirrors.sync.started")) > 0,
		"после принятого запуска страница говорит, что прогон пошёл").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СписокКабинетаПоАдресу("running"), Текст("office.mirrors.sync.running")) > 0,
		"идущий прогон назван идущим").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СписокКабинетаПоАдресу("queued"), Текст("office.mirrors.sync.queued")) > 0,
		"ожидание в очереди названо ожиданием").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СписокКабинетаПоАдресу("disabled"), Текст("office.mirrors.sync.disabled")) > 0,
		"выключенная синхронизация названа выключенной").ЭтоИстина();
	Ожидаем.Что(СтрНайти(СписокКабинетаПоАдресу(""), Текст("office.mirrors.sync.started")),
		"без признака в адресе баннера нет").Равно(0);

КонецПроцедуры

&Тест
Процедура НенайденныйПулКабинетаДаётВозвратКЗеркалам() Экспорт

	Ответ = Новый ОтветСтраницыЗаглушка();
	Кабинет_.Пул(Ответ, "нет-такого", Новый Соответствие(), Неопределено, "GET", "");

	Ожидаем.Что(Ответ.Код, "неизвестный пул — 404").Равно(404);
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, "href=""/office/mirrors""") > 0,
		"со страницы отказа есть путь назад к зеркалам: " + Ответ.ТелоТекст).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Служебное

Функция Зеркало(Знач Состояние)

	Результат = Новый Структура();
	Результат.Вставить("Идентификатор", 1);
	Результат.Вставить("АпстримURL", "http://hub.example/download/");
	Результат.Вставить("ТокенДоступа", "");
	Результат.Вставить("Режим", "opm");
	Результат.Вставить("ИнтервалСинкаСек", 3600);
	Результат.Вставить("Включено", Истина);
	Результат.Вставить("ПоследнийСинк", МоментСинка());
	Результат.Вставить("Статус", "создано");
	Результат.Вставить("СостояниеПрогона", Состояние);
	Результат.Вставить("ПрогонНачат", Дата(2026, 3, 12, 10, 0, 0));
	Результат.Вставить("ПрогонОбновлён", Дата(2026, 3, 12, 10, 25, 0));
	Результат.Вставить("ПрогонВсего", 0);
	Результат.Вставить("ПрогонСкачано", 0);
	Результат.Вставить("ПрогонПропущено", 0);
	Результат.Вставить("ПрогонОшибок", 0);
	Результат.Вставить("ПрогонНедоступно", 0);
	Результат.Вставить("ПрогонИмёнВсего", 0);
	Результат.Вставить("ПрогонИмёнПройдено", 0);
	Результат.Вставить("ПрогонКурсор", "corp-lib");
	Результат.Вставить("ПрогонЗапустил", "");
	Результат.Вставить("ВычитаноДо", '00010101000000');
	Результат.Вставить("ПрогонСрезС", '00010101000000');
	Результат.Вставить("ПрогонМоментСреза", '00010101000000');
	Возврат Результат;

КонецФункции

// Зеркало, по которому прогон ещё не начинался: колонки есть, но пусты — ровно то,
// что записывает СервисЗеркал.Создать.
Функция ЗеркалоБезПрогона()

	Результат = Зеркало("");
	Результат.ПрогонНачат = '00010101000000';
	Результат.ПрогонОбновлён = '00010101000000';
	Результат.ПрогонКурсор = "";
	Возврат Результат;

КонецФункции

Функция ЗеркалоСоСчётчиками(Знач Всего, Знач Скачано, Знач Пропущено, Знач Ошибок,
	Знач Недоступно)

	Результат = Зеркало("идёт");
	Результат.ПрогонВсего = Всего;
	Результат.ПрогонСкачано = Скачано;
	Результат.ПрогонПропущено = Пропущено;
	Результат.ПрогонОшибок = Ошибок;
	Результат.ПрогонНедоступно = Недоступно;
	Возврат Результат;

КонецФункции

// Шкала обхода: имён у апстрима всего и сколько из них пройдено.
Функция ЗеркалоСоШкалой(Знач ИмёнВсего, Знач ИмёнПройдено)

	Результат = Зеркало("идёт");
	Результат.ПрогонИмёнВсего = ИмёнВсего;
	Результат.ПрогонИмёнПройдено = ИмёнПройдено;
	Возврат Результат;

КонецФункции

Функция ЭкранHTML(Знач Зеркало_)

	Параметры = Новый Структура();
	Параметры.Вставить("Зеркало", Зеркало_);
	Параметры.Вставить("Прогон", Прогоны.Модель(Зеркало_));
	Параметры.Вставить("АдресЭкрана", "/owned/settings/mirrors/1");
	Параметры.Вставить("АдресСписка", "/owned/settings/mirrors");
	Параметры.Вставить("Токен", "токен-теста");
	Параметры.Вставить("Обновление", 5);

	Возврат UI.РендерерНастроек.Отрисовать(Новый Структура("Ключ, Заголовок, Секции",
		"pool", "проба", ВитринаЭкрана.Секции(Параметры)));

КонецФункции

Функция Показать(Знач Зеркало_, Знач Синк = "")

	Список = Новый Массив();
	Список.Добавить(Зеркало_);
	Сервис.Задать(Список);

	Ответ = Новый ОтветСтраницыЗаглушка();
	Пульт.Показать(Ответ, "owned", "1", Новый Соответствие(), Неопределено, "GET", Синк);
	Возврат Ответ;

КонецФункции

Функция СписокПулаHTML(Знач Зеркало_)

	Список = Новый Массив();
	Список.Добавить(Зеркало_);
	Сервис.Задать(Список);

	Параметры = Новый Структура("Пул, Адрес, Токен", Пул, "/owned/settings/mirrors", "токен");

	Результат = "";
	Для Каждого Секция Из ВитринаСписка.Секции(Параметры) Цикл
		Результат = Результат + Секция.Тело;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СписокКабинетаHTML(Знач Зеркало_)

	Список = Новый Массив();
	Список.Добавить(Зеркало_);
	Сервис.Задать(Список);

	Возврат ВитринаКабинета.Список(
		Новый Структура("Пул, Токен, Баннеры", Пул, "токен", Новый Массив()));

КонецФункции

Функция Полезное()
	Возврат "<script>alert(1)</script>";
КонецФункции

Функция ЗеркалоСПолезнойНагрузкой()
	Результат = Зеркало("идёт");
	Результат.АпстримURL = "http://evil/" + Полезное();
	Возврат Результат;
КонецФункции

Функция Синк(Знач Зеркало_)

	Список = Новый Массив();
	Список.Добавить(Зеркало_);
	Сервис.Задать(Список);

	Ответ = Новый ОтветСтраницыЗаглушка();
	Кабинет_.Синхронизация(Ответ, "owned", "1", Новый Соответствие(), Неопределено, "POST",
		"_csrf=токен-теста");
	Возврат Ответ;

КонецФункции

// Итог цикла, ничего не прибавляющий: печатает накопленную базу как есть.
Функция ПустойИтогЦикла()
	Возврат Новый Структура("Всего, Скачано, Пропущено, Ошибок, Недоступно, ЕстьЕщё, Статус",
		0, 0, 0, 0, 0, Ложь, "");
КонецФункции

// Уровень консоли хаба: то, чего тут нет, оператор в консоли не увидит.
// Числа зеркалирования из настроек хаба: очередь и прогон спрашивают их на каждый вызов.
// Дроссель с заданным темпом — тестовый шов: в боевом контейнере темп фиксирован.
Функция Дроссель(Знач Элементов, Знач Секунд)
	Результат = Новый ДроссельПрогресса(Новый ПриведениеЧисел());
	Результат.УстановитьТемп(Элементов, Секунд);
	Возврат Результат;
КонецФункции

Функция ЧислаЗеркал(Знач Порог, Знач Включена = Истина)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.mirror.run_stale_sec", Порог);
	Настройки.Задать("oshub.mirror.sync_enabled", Включена);
	Настройки.Задать("oshub.mirror.queue_max", 100);
	Возврат Новый ЧислаЗеркалирования(Новый ПриведениеЧисел(), Настройки);
КонецФункции

Функция ЛогСЛовушкой(Знач Ловушка)
	Лог = Логирование.ПолучитьЛог("тест.oshub.экран-зеркала.ловушка");
	Лог.УстановитьУровень(УровниЛога.Информация);
	Лог.ДобавитьСпособВывода(Ловушка);
	Возврат Лог;
КонецФункции

Функция СинкДомаПула(Знач Зеркало_)

	Список = Новый Массив();
	Список.Добавить(Зеркало_);
	Сервис.Задать(Список);

	Ответ = Новый ОтветСтраницыЗаглушка();
	ДомПула_.Синхронизация(Ответ, "owned", "1", Новый Соответствие(), Неопределено, "POST",
		"_csrf=токен-теста");
	Возврат Ответ;

КонецФункции

Функция СписокКабинетаПоАдресу(Знач Признак)

	Сервис.Задать(Новый Массив());

	Ответ = Новый ОтветСтраницыЗаглушка();
	Кабинет_.Пул(Ответ, "owned", Новый Соответствие(), Неопределено, "GET", "", Признак);
	Возврат Ответ.ТелоТекст;

КонецФункции

Функция МоментСинка()
	Возврат Дата(2026, 3, 12, 10, 30, 0);
КонецФункции

Функция ЧастьПримечания()
	Возврат Лев(Текст("settings.pool.mirror-status.refresh.note"), 30);
КонецФункции

Функция Текст(Знач Ключ)
	Возврат UI.СловарьТекстов.НайтиТекст(Ключ);
КонецФункции

#КонецОбласти
