// Экран состояния синхронизации зеркала и колонка прогона в списках: настоящие
// ПредставлениеПрогонаЗеркала, ВитринаСостоянияЗеркала, ВитринаЗеркал, ВитринаЗеркалКабинета
// и ПультСостоянияЗеркала. Базы нет — зеркала задаёт фейк сервиса.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем UI;            // СборкаUI — граф компонентов и рендереров web-ui
Перем Кабинет;       // РендерерКабинета
Перем Ответы;        // ОтветыНастроек
Перем Дом;           // ДомПула
Перем Прогоны;       // ПредставлениеПрогонаЗеркала
Перем Сервис;        // ФейкСервисЗеркалЭкрана
Перем ВитринаЭкрана; // ВитринаСостоянияЗеркала
Перем ВитринаСписка; // ВитринаЗеркал
Перем ВитринаКабинета;
Перем Пульт;         // ПультСостоянияЗеркала
Перем Гвард;         // ГвардПулаЗаглушка
Перем Кабинет_;      // КонтроллерЗеркалКабинета с фейками
Перем ДомПула_;      // КонтроллерЗеркалПула с фейками — кнопка дома пула
Перем Ловушка_;      // ЛовушкаЛога — что нажатие кнопки оставило в журнале
Перем Очередь_;      // ОчередьСинхронизацииЗеркал — настоящая, а не фейк запуска
Перем ГвардКабинета;
Перем Пулы;
Перем Пул;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("СборкаUI");
	UI = Новый СборкаUI().Собрать(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы"));

	РеестрФикстур.Подключить("ПулЗаглушка");
	РеестрФикстур.Подключить("ГвардПулаЗаглушка");
	РеестрФикстур.Подключить("ФейкСервисЗеркалЭкрана");
	РеестрФикстур.Подключить("ОтветСтраницыЗаглушка");
	РеестрФикстур.Подключить("ФейкСервисПрав");
	РеестрФикстур.Подключить("ГвардКабинетаЗаглушка");
	РеестрФикстур.Подключить("ЗащитаCSRFЗаглушка");
	РеестрФикстур.Подключить("ФейкПуловЗеркал");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("ФейкЗеркалоЗапись");
	РеестрФикстур.Подключить("ФейкХранилищеЗеркал");
	РеестрФикстур.Подключить("НастройкиЗаглушка");

	Поиск = Новый КлассыСлоя();
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"),
		"ОчередьСинхронизацииЗеркал");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "ДроссельПрогресса");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "ПрогонЗеркала");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "ЧислаЗеркалирования");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "СчётчикиОбхода");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "СрезОбхода");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "вход", "Классы"), "ЗащитаCSRF");
	// обзор зеркал спрашивает «пулы в распоряжении» у службы кабинета — берём настоящую
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "кабинет", "Классы"), "СлужбаКабинета");
	// правило токена доступа: витрина зеркал спрашивает у него, задан ли токен
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "прокси", "Классы"), "СекретИсточника");
	КаталогWeb = ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы");
	Для Каждого Имя Из СтрРазделить("РендерерКабинета,КаталогРазделов,ДомПула,"
		+ "ОтветыНастроек,ПредставлениеПрогонаЗеркала,ВитринаСостоянияЗеркала,ВитринаЗеркал,"
		+ "ВитринаЗеркалКабинета,ПультСостоянияЗеркала,РазборФормы,КонтроллерЗеркалКабинета,"
		+ "КонтроллерЗеркалПула,БланкРаздела", ",") Цикл
		Поиск.Подключить(КаталогWeb, Имя);
	КонецЦикла;
	Поиск.Подключить(КаталогWeb, "ДомХаба");
	Поиск.Подключить(КаталогWeb, "РаскладкаНастроекХаба");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "настройки", "Классы"),
		"РазделыНастроекХаба");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "МетодыHTTP");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ТекстОшибки");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ПриведениеЧисел");
	Поиск.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ВнедрённыеЖелуди");

	Кабинет = Новый РендерерКабинета(UI.Каркас, UI.Экран, Новый ЗащитаCSRF(Неопределено), UI.Набор,
		UI.Тексты);
	Ответы = Новый ОтветыНастроек(UI.Каркас, UI.Кит, UI.РендерерНастроек, Новый ФейкСервисПрав(),
		UI.Тексты, Новый МетодыHTTP(), Новый ТекстОшибки(), Новый ЗаголовкиКэша(Новый ЗаголовкиHTTP()));
	Дом = Новый ДомПула(Новый КаталогРазделов(UI.РендерерНастроек), UI.Тексты);
	Прогоны = Новый ПредставлениеПрогонаЗеркала(UI.Тексты, Новый СчётчикиОбхода(Новый ПриведениеЧисел()));
	Пул = Новый ПулЗаглушка(7, "owned", "local");

КонецПроцедуры

&ПередКаждым
Процедура СобратьВитрины() Экспорт

	Сервис = Новый ФейкСервисЗеркалЭкрана();
	ВитринаЭкрана = Новый ВитринаСостоянияЗеркала(UI.Кит, UI.РендерерНастроек, UI.Тексты,
		Новый БланкРаздела(UI.Кит));
	ВитринаСписка = Новый ВитринаЗеркал(UI.Кит, UI.РендерерНастроек, Сервис, Прогоны, UI.Тексты,
		Новый БланкРаздела(UI.Кит), Новый Массив());
	ВитринаКабинета = Новый ВитринаЗеркалКабинета(UI.Кит, Сервис, Прогоны, Дом, UI.Тексты,
		Новый БланкРаздела(UI.Кит));

	Гвард = Новый ГвардПулаЗаглушка();
	Гвард.Впустить("owner1", Пул);
	Пульт = Новый ПультСостоянияЗеркала(Гвард, Новый ЗащитаCSRFЗаглушка(), Сервис, Прогоны,
		ВитринаЭкрана, Ответы, Дом, UI.Тексты, Новый ПриведениеЧисел());

	ГвардКабинета = Новый ГвардКабинетаЗаглушка();
	ГвардКабинета.Впустить("owner1");
	Пулы = Новый ФейкПуловЗеркал();
	Пулы.ДобавитьПул(Пул);
	Ловушка_ = Новый ЛовушкаЛога();
	Очередь_ = Новый ОчередьСинхронизацииЗеркал(Новый ПриведениеЧисел(), Сервис,
		ЧислаЗеркал(900), ЛогСЛовушкой(Ловушка_));
	// «пулы в распоряжении» считает настоящая служба кабинета: у обзора зеркал и у сводки
	// кабинета этот отбор ОДИН, и подменять его заглушкой значило бы проверять не тот код
	Права_ = Новый ФейкСервисПрав();
	СлужбаКабинета_ = Новый СлужбаКабинета(Пулы, Неопределено, Неопределено, Права_);
	Кабинет_ = Новый КонтроллерЗеркалКабинета(ГвардКабинета, Новый ЗащитаCSRFЗаглушка(),
		Новый РазборФормы(), Пулы, Сервис, Очередь_, Права_, СлужбаКабинета_, ВитринаКабинета,
		Ответы, UI.Тексты, Новый ПриведениеЧисел(), Новый МетодыHTTP());

	ДомПула_ = Новый КонтроллерЗеркалПула(Гвард, Новый ЗащитаCSRFЗаглушка(), Новый РазборФормы(),
		Сервис, Очередь_, Ответы, Дом, ВитринаСписка, Пульт, UI.Тексты, Новый ПриведениеЧисел());

КонецПроцедуры

#Область МодельПрогона

&Тест
Процедура ИдущийПрогонНазванСловамиИСчитаетсяАктивным() Экспорт

	Модель = Прогоны.Модель(Зеркало("идёт"));

	Ожидаем.Что(Модель.Код, "код хранения сохранён как есть").Равно("идёт");
	Ожидаем.Что(Модель.Подпись, "состояние названо словами словаря")
		.Равно(UI.СловарьТекстов.НайтиТекст("mirror.run.state.running"));
	Ожидаем.Что(Модель.Активен, "идущий прогон активен").ЭтоИстина();
	Ожидаем.Что(Модель.Вид, "идущий прогон выделен плашкой").Равно("accent");

КонецПроцедуры

&Тест
Процедура ПоставленныйПрогонТожеАктивен() Экспорт

	Модель = Прогоны.Модель(Зеркало("поставлено"));

	Ожидаем.Что(Модель.Активен, "ждущий очереди прогон активен: экран обязан обновляться")
		.ЭтоИстина();
	Ожидаем.Что(Модель.Подпись, "очередь названа своими словами")
		.Равно(UI.СловарьТекстов.НайтиТекст("mirror.run.state.queued"));

КонецПроцедуры

&Тест
Процедура ЗавершённыйИОшибочныйПрогонНеАктивны() Экспорт

	Ожидаем.Что(Прогоны.Модель(Зеркало("завершён")).Активен,
		"завершённый прогон не активен").ЭтоЛожь();
	Ожидаем.Что(Прогоны.Модель(Зеркало("завершён")).Вид, "завершённый прогон зелёный").Равно("ok");
	Ожидаем.Что(Прогоны.Модель(Зеркало("ошибка")).Активен, "ошибка не активна").ЭтоЛожь();
	Ожидаем.Что(Прогоны.Модель(Зеркало("ошибка")).Вид, "ошибка красная").Равно("err");

КонецПроцедуры

// Вердикт про порог приносит домен: запись говорит «идёт» и после смерти рабочего,
// и экран, поверивший ей на слово, часами показывал живой прогон.
&Тест
Процедура БрошенныйПрогонНеСчитаетсяНиИдущимНиАктивным() Экспорт

	Модель = Прогоны.Модель(Зеркало("идёт"), Истина);

	Ожидаем.Что(Модель.Код, "идущий, но брошенный прогон идущим не зовётся").Равно("брошен");
	Ожидаем.Что(Модель.Подпись, "и назван словами словаря")
		.Равно(UI.СловарьТекстов.НайтиТекст("mirror.run.state.stale"));
	Ожидаем.Что(Модель.Активен, "мёртвый прогон не активен: обновлять страницу незачем").ЭтоЛожь();
	Ожидаем.Что(Модель.Вид, "и подсвечен как беда, а не как работа").Равно("err");

	// брошенной бывает и заявка, которую никто не взял
	Ожидаем.Что(Прогоны.Модель(Зеркало("поставлено"), Истина).Код,
		"брошенная заявка тоже не ждёт вечно").Равно("брошен");

	// закрытые состояния порогом не трогаются: у них молчание — норма
	Ожидаем.Что(Прогоны.Модель(Зеркало("завершён"), Истина).Код,
		"завершённый прогон брошенным не объявляется").Равно("завершён");
	Ожидаем.Что(Прогоны.Модель(Зеркало("идёт"), Ложь).Код,
		"живой прогон остаётся идущим").Равно("идёт");

КонецПроцедуры

&Тест
Процедура НеизвестноеСостояниеЧитаетсяКакПростой() Экспорт

	Модель = Прогоны.Модель(Зеркало("чёрт-те что"));

	Ожидаем.Что(Модель.Код, "незнакомый код хранения не доезжает до экрана").Равно("простаивает");
	Ожидаем.Что(Модель.Активен, "незнакомое состояние не считается активным").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЗеркалоБезПолейПрогонаПоказываетсяПростаивающим() Экспорт

	// зеркало заведено, но ни разу не прогонялось: пустые колонки прогона обязаны
	// читаться как простой, а итог и дата прошлого синка — показываться
	Модель = Прогоны.Модель(ЗеркалоБезПрогона());

	Ожидаем.Что(Модель.Код, "зеркало без полей прогона простаивает").Равно("простаивает");
	Ожидаем.Что(Модель.Всего + Модель.Скачано + Модель.Ошибок, "счётчики нулевые").Равно(0);
	Ожидаем.Что(Модель.Итог, "итог прошлого синка виден и без движка").Равно("создано");
	Ожидаем.Что(ЗначениеЗаполнено(Модель.ПоследнийСинк),
		"дата прошлого синка видна и без движка").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПроцентСчитаетсяПоРазобраннымПакетам() Экспорт

	// недоступные считаются ПОВЕРХ пропущенных, а не вместо: 40 + 30 + 20 = 90 элементов,
	// а сумма всех пяти колонок посчитала бы десять недоступных дважды
	Модель = Прогоны.Модель(ЗеркалоСоСчётчиками(200, 40, 30, 20, 10));

	Ожидаем.Что(Модель.Обработано, "разобрано — по одному исходу на элемент").Равно(90);

КонецПроцедуры

// Шкала считает ИМЕНА, а не версии: 25 имён апстрима дали 194 версии, и доля по версиям
// упиралась в сто процентов на конце каждой порции и падала в начале следующей.
&Тест
Процедура ДоляОбходаСчитаетсяПоИменамАпстрима() Экспорт

	Модель = Прогоны.Модель(ЗеркалоСоШкалой(200, 90));

	Ожидаем.Что(Модель.ИмёнВсего, "знаменатель — имена у апстрима").Равно(200);
	Ожидаем.Что(Модель.ИмёнПройдено, "числитель — пройденные имена").Равно(90);
	Ожидаем.Что(Модель.Процент, "доля обхода считается по ним").Равно(45);

КонецПроцедуры

// Версий у имени бывает сколько угодно, и на долю обхода они не влияют вовсе: иначе
// знаменатель ехал бы от порции к порции.
&Тест
Процедура ЧислоВерсийНаДолюОбходаНеВлияет() Экспорт

	Запись = ЗеркалоСоШкалой(200, 90);
	Запись.ПрогонВсего = 194;
	Запись.ПрогонСкачано = 194;

	Ожидаем.Что(Прогоны.Модель(Запись).Процент,
		"194 перенесённые версии не двигают шкалу имён").Равно(45);

КонецПроцедуры

// «Сколько элементов обхода уже обработано» спрашивают ДВОЕ: домен — чтобы перенести
// знаменатель в следующий цикл, экран — чтобы напечатать число. Формула у них теперь ОДНА
// (СчётчикиОбхода), и сторож это доказывает: разойдись они — карточка врала бы про тот же
// обход, который сама же и продолжает. Недоступные обязательны: без них формулы совпадают
// при любой ошибке.
&Тест
Процедура ЭкранИДоменСчитаютОбработанноеОдинаково() Экспорт

	Хранилище = Новый ФейкХранилищеЗеркал();
	Прогон = Новый ПрогонЗеркала(Хранилище, Новый ПриведениеЧисел(),
		Дроссель(1, 1), ЧислаЗеркал(900), Новый СчётчикиОбхода(Новый ПриведениеЧисел()));

	Запись = Хранилище.СоздатьЭлемент();
	Запись.ПулНазначенияИдентификатор = 1;
	Запись.АпстримURL = "http://upstream.invalid/download/";
	Запись.Режим = "opm";
	Запись.СостояниеПрогона = "поставлено";
	Запись.ПрогонКурсор = "autumn"; // непустой курсор = продолжение обхода
	Запись.ПрогонВсего = 194;
	Запись.ПрогонСкачано = 100;
	Запись.ПрогонПропущено = 10;
	Запись.ПрогонОшибок = 3;
	Запись.ПрогонНедоступно = 4; // наложены на пропущенные
	Запись.ПрогонОбновлён = ТекущаяУниверсальнаяДата();
	Запись.Сохранить();

	НаЭкране = Прогоны.Модель(Запись).Обработано;

	// домен показывает своё «обработано» переносом знаменателя: захват запоминает базу,
	// а пустой итог печатает её в запись как есть
	Прогон.Занять(Запись.Идентификатор);
	Прогон.Отметить(Запись.Идентификатор, ПустойИтогЦикла(), "autumn");
	ВДомене = Хранилище.ПолучитьОдноПоИдентификаторРавно(Запись.Идентификатор).ПрогонВсего;

	Ожидаем.Что(НаЭкране, "экран считает обработанное по одному исходу на элемент").Равно(113);
	Ожидаем.Что(ВДомене, "и домен переносит в знаменатель ровно столько же").Равно(НаЭкране);

КонецПроцедуры

// Доля обхода не имеет права перевалить за сто: у пользователя это выглядит как ошибка,
// а прячет она двойной счёт в счётчиках.
&Тест
Процедура ДоляОбходаНеПереваливаетЗаСто() Экспорт

	// каждый элемент порции оказался недоступен: пропущено 50 и недоступно те же 50
	Модель = Прогоны.Модель(ЗеркалоСоСчётчиками(50, 0, 50, 0, 50));

	Ожидаем.Что(Модель.Обработано, "разобрана вся порция, а не полторы").Равно(50);

	// пройденных имён больше, чем их у апстрима, не бывает; но если запись врёт —
	// экран обязан показать сто, а не сто двадцать
	Ожидаем.Что(Прогоны.Модель(ЗеркалоСоШкалой(50, 60)).Процент,
		"доля обхода не переваливает за сто").Равно(100);
	Ожидаем.Что(Прогоны.Модель(ЗеркалоСоШкалой(50, 50)).Процент,
		"пройденный до конца обход — ровно сто").Равно(100);

КонецПроцедуры

&Тест
Процедура НесосчитанныйАпстримНеДаётДоли() Экспорт

	Модель = Прогоны.Модель(ЗеркалоСоСчётчиками(0, 7, 0, 0, 0));

	Ожидаем.Что(Модель.Процент, "без общего числа имён доля неизвестна, а не 100%").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ЭкранСостояния

&Тест
Процедура ЭкранПечатаетСчётчикиКурсорИМоменты() Экспорт

	HTML = ЭкранHTML(ЗеркалоСоСчётчиками(200, 40, 30, 20, 10));

	Ожидаем.Что(СтрНайти(HTML, ">200<") > 0, "всего пакетов у апстрима напечатано").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ">40<") > 0, "скачано напечатано").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ">30<") > 0, "пропущено напечатано").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ">20<") > 0, "ошибок напечатано").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ">10<") > 0, "недоступно напечатано").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "corp-lib") > 0, "курсор обхода напечатан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, Текст("settings.pool.mirror-status.field.started")) > 0,
		"момент старта назван").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПлановыйЗапускНазванСловамиАРучнойЛогином() Экспорт

	Плановое = Зеркало("идёт");
	Ожидаем.Что(СтрНайти(ЭкранHTML(Плановое),
			Текст("settings.pool.mirror-status.field.by-schedule")) > 0,
		"пустой инициатор назван «по расписанию», а не пустой ячейкой").ЭтоИстина();

	Ручное = Зеркало("идёт");
	Ручное.ПрогонЗапустил = "owner1";
	Ожидаем.Что(СтрНайти(ЭкранHTML(Ручное), "owner1") > 0,
		"инициатор ручного запуска назван").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АктивныйПрогонОбещаетСамообновлениеАПростойНет() Экспорт

	Идёт = ЭкранHTML(Зеркало("идёт"));
	Ожидаем.Что(СтрНайти(Идёт, ЧастьПримечания()) > 0,
		"у идущего прогона экран обещает обновиться сам: " + ЧастьПримечания()).ЭтоИстина();

	Ожидаем.Что(СтрНайти(ЭкранHTML(Зеркало("завершён")), ЧастьПримечания()),
		"остановленный прогон обещания не даёт — обновляться нечему").Равно(0);

КонецПроцедуры

&Тест
Процедура ПолосаПечатаетсяТолькоКогдаАпстримСосчитан() Экспорт

	Ожидаем.Что(СтрНайти(ЭкранHTML(ЗеркалоСоШкалой(200, 90)), "meter__track") > 0,
		"сосчитанный апстрим даёт полосу заполнения").ЭтоИстина();
	// перенесённые версии полосы не дают: без числа ИМЁН доля обхода неизвестна
	Ожидаем.Что(СтрНайти(ЭкранHTML(ЗеркалоСоСчётчиками(200, 40, 30, 20, 10)), "meter__track"),
		"несосчитанный апстрим полосы не даёт, сколько бы версий ни приехало").Равно(0);

КонецПроцедуры

// Подпись «Всего пакетов у апстрима» была неверна дважды: это не «всего» и не «пакеты» —
// 25 имён апстрима дали 194 версии. Экран обязан называть обе величины своими словами.
// Числа зеркалирования собраны в СВОЙ раздел дома «Хаб»: иначе они рассыпаются
// по «Обслуживанию» вперемешку с чужими, и обещание «одним местом» становится неправдой.
&Тест
Процедура ЧислаЗеркалированияЖивутВСвоёмРазделеДомаХаба() Экспорт

	Дом_ = Новый ДомХаба(Новый КаталогРазделов(UI.РендерерНастроек), UI.Тексты);
	Разделы = Новый РазделыНастроекХаба();

	Ожидаем.Что(Дом_.ЕстьРаздел("mirrors"), "у зеркалирования свой раздел дома «Хаб»").ЭтоИстина();
	Ожидаем.Что(Дом_.ЛидРаздела("mirrors") <> "", "раздел объясняет себя").ЭтоИстина();

	Чужие = Новый Массив();
	Для Каждого Ключ Из Новый ЧислаЗеркалирования(Новый ПриведениеЧисел()).Ключи() Цикл
		Если Разделы.РазделКлюча(Ключ) <> "mirrors" Тогда
			Чужие.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Чужие, ", "),
		"каждое число зеркалирования показывается в этом разделе").Равно("");

	// пределы приёма живут в «Хранилище» вместе с числами публикации: они общие
	Ожидаем.Что(Разделы.РазделКлюча("oshub.publish.max_upload_bytes"),
		"предел приёма — один на хаб и показан там же, где числа публикации").Равно("storage");

КонецПроцедуры

&Тест
Процедура СчётчикиНазываютИменаИВерсииРазными() Экспорт

	Запись = ЗеркалоСоШкалой(25, 12);
	Запись.ПрогонВсего = 194;
	HTML = ЭкранHTML(Запись);

	Ожидаем.Что(HTML, "число имён апстрима названо именами").Содержит("Пакетов у апстрима");
	Ожидаем.Что(HTML, "и рядом видно, сколько их пройдено").Содержит("Пакетов пройдено обходом");
	Ожидаем.Что(HTML, "а число элементов названо версиями").Содержит("Версий перечислено за обход");
	Ожидаем.Что(СтрНайти(HTML, "Всего пакетов у апстрима"),
		"старой неправды на экране нет").Равно(0);
	Ожидаем.Что(HTML, "подпись шкалы считает пакеты").Содержит("пакетов пройдено 12 из 25");

КонецПроцедуры

// Способ обхода объясняет цену прогона: инкремент спрашивает у источника только изменившееся
// с названного момента, и момент этот на экране виден.
&Тест
Процедура ЭкранПоказываетИнкрементИМоментОтсчёта() Экспорт

	Запись = Зеркало("идёт");
	Запись.ПрогонСрезС = Дата(2026, 8, 12, 10, 0, 0);

	HTML = ЭкранHTML(Запись);

	Ожидаем.Что(HTML, "способ обхода назван").Содержит("Способ обхода");
	// момент печатается тем же представлением, что и остальные моменты экрана
	Ожидаем.Что(HTML, "инкремент назван инкрементом и с момента")
		.Содержит("инкремент с " + Прогоны.Модель(Запись).СрезС);
	Ожидаем.Что(СтрНайти(HTML, "полный обход"), "полным такой обход не называется").Равно(0);

КонецПроцедуры

// Источник, инкремента не умеющий, момента не называет — и обход на экране честно полный.
&Тест
Процедура ЭкранНазываетОбходПолнымБезМомента() Экспорт

	HTML = ЭкранHTML(Зеркало("идёт"));

	Ожидаем.Что(HTML, "способ обхода назван").Содержит("Способ обхода");
	Ожидаем.Что(HTML, "без момента обход полный").Содержит("полный обход");
	Ожидаем.Что(СтрНайти(HTML, "инкремент"), "инкрементом он не притворяется").Равно(0);

КонецПроцедуры

&Тест
Процедура АпстримИКурсорЭкранированы() Экспорт

	Полезное = "<script>alert(1)</script>";
	Зеркало_ = Зеркало("идёт");
	Зеркало_.АпстримURL = "http://evil/" + Полезное;
	Зеркало_.ПрогонКурсор = Полезное;

	HTML = ЭкранHTML(Зеркало_);

	Ожидаем.Что(СтрНайти(HTML, Полезное), "тег из внешних данных в разметку не вырвался").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;script&gt;") > 0, "внешние данные экранированы").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЭкранНесётИтогИНастройкиЗеркала() Экспорт

	HTML = ЭкранHTML(Зеркало("завершён"));

	Ожидаем.Что(СтрНайти(HTML, "hub.example") > 0, "апстрим показан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "opm") > 0, "режим показан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "создано") > 0, "итог прошлого прогона показан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "/owned/settings/mirrors") > 0,
		"с экрана есть возврат к списку зеркал").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПультЭкрана

&Тест
Процедура ИдущийПрогонПеререрисовываетСтраницуСам() Экспорт

	Ответ = Показать(Зеркало("идёт"), "1");

	Ожидаем.Что(Ответ.Код, "экран отдан").Равно(200);
	// адрес в заголовке обязателен: без него браузер перезагружает текущий URL вместе
	// с ?sync, и разовый баннер о нажатии перепечатывается каждые пять секунд часами
	Ожидаем.Что(Ответ.Заголовок("Refresh"),
		"страница перерисовывает себя сама — и БЕЗ признака нажатия в адресе")
		.Равно("5; url=/owned/settings/mirrors/1");

КонецПроцедуры

// Дефект владельца, вторая половина: рабочий умер, а карточка ещё пятнадцать минут
// показывала «идёт», «68 %, 133 из 194» и обещание «страница обновляется сама».
// Очередь про порог знает — экран обязан знать тоже.
&Тест
Процедура БрошенныйПрогонНаЭкранеНеВыдаётсяЗаЖивой() Экспорт

	Сервис.ЗадатьБрошенныйПрогон();

	Ответ = Показать(Зеркало("идёт"));

	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, Текст("mirror.run.state.stale")) > 0,
		"состояние названо брошенным: " + Ответ.ТелоТекст).ЭтоИстина();
	Ожидаем.Что(Ответ.Заголовок("Refresh"),
		"страницу мёртвого прогона крутить нечем").Равно("");
	Ожидаем.Что(СтрНайти(Ответ.ТелоТекст, ЧастьПримечания()),
		"и обещания само-обновления на ней нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ОстановленныйПрогонСтраницуНеПерерисовывает() Экспорт

	Ожидаем.Что(Показать(Зеркало("завершён")).Заголовок("Refresh"),
		"у остановленного прогона авто-обновления быть не должно").Равно("");
	Ожидаем.Что(Показать(ЗеркалоБезПрогона()).Заголовок("Refresh"),
		"простаивающее зеркало страницу не крутит").Равно("");

КонецПроцедуры

&Тест
Процедура ЧужогоЗеркалаНаЭкранеНет() Экспорт

	Сервис.Задать(Новый Массив());

	Ответ = Новый ОтветСтраницыЗаглушка();
	Пульт.Показать(Ответ, "owned", "77", Новый Соответствие(), Неопределено, "GET");

	Ожидаем.Что(Ответ.Код, "зеркала нет в этом пуле — 404").Равно(404);

КонецПроцедуры

&Тест
Процедура ЭкранСостоянияТолькоGET() Экспорт

	Список = Новый Массив();
	Список.Добавить(Зеркало("идёт"));
	Сервис.Задать(Список);

	Ответ = Новый ОтветСтраницыЗаглушка();
	Пульт.Показать(Ответ, "owned", "1", Новый Соответствие(), Неопределено, "POST");

	Ожидаем.Что(Ответ.Код, "экран состояния не мутирует — POST не разрешён").Равно(405);
	Ожидаем.Что(Ответ.Заголовок("Allow"), "разрешённый метод назван").Равно("GET");

КонецПроцедуры

// Жалоба владельца дословно: «ни одной строки о рабочем зеркал — ни ошибки, ни ничего».
// Боевой путь нажатия — кнопка → контроллер дома пула → очередь; строка обязана быть
// на нём, а не только в движке, до которого отвергнутая заявка не доходит вовсе.
&Тест
Процедура НажатиеКнопкиОставляетСледВЖурнале() Экспорт

	СинкДомаПула(Зеркало("простаивает"));
	Ожидаем.Что(СтрНайти(Ловушка_.Всё(), "поставлено в очередь синхронизации") > 0,
		"принятая заявка названа в журнале: " + Ловушка_.Всё()).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ловушка_.Всё(), "owner1") > 0,
		"с логином того, кто нажал").ЭтоИстина();

	СинкДомаПула(Зеркало("поставлено"));
	Ожидаем.Что(СтрНайти(Ловушка_.Всё(), "не принята: зеркало уже стоит в очереди") > 0,
		"отказ назван причиной, а не молчанием: " + Ловушка_.Всё()).ЭтоИстина();

	Очередь_.Забрать(); // рабочий взял зеркало
	СинкДомаПула(Зеркало("идёт"));
	Ожидаем.Что(СтрНайти(Ловушка_.Всё(), "не принята: рабочий уже ведёт это зеркало") > 0,
		"и отказ по идущему прогону тоже: " + Ловушка_.Всё()).ЭтоИстина();

КонецПроцедуры

// Дефект владельца: кнопка дома пула отвечала одним и тем же 302 и на принятую заявку,
// и на отказ дедупликации, поэтому «ничего не происходит» выглядело как исправная работа.
&Тест
Процедура КнопкаДомаПулаУводитСИтогомЗаявки() Экспорт

	Ожидаем.Что(СинкДомаПула(Зеркало("простаивает")).ПутьРедиректа, "принятая заявка помечена")
		.Равно("/owned/settings/mirrors/1?sync=1");

	// зеркало уже ждёт очереди: повтор отвергается, и адрес обязан это назвать
	Ожидаем.Что(СинкДомаПула(Зеркало("поставлено")).ПутьРедиректа, "ожидание в очереди помечено")
		.Равно("/owned/settings/mirrors/1?sync=queued");

	Очередь_.Забрать(); // рабочий взял зеркало — прогон пошёл
	Ожидаем.Что(СинкДомаПула(Зеркало("идёт")).ПутьРедиректа, "идущий прогон помечен отдельно")
		.Равно("/owned/settings/mirrors/1?sync=running");

КонецПроцедуры

// ИСТ-АПСТ-006: кнопка «Снять токен» в списке зеркал — своя точка дома пула, и она
// возвращает апстрим к анонимному чтению, а не молча уводит редиректом ни с чем.
&Тест
Процедура КнопкаДомаПулаСнимаетТокенЗеркала() Экспорт

	Приватное = Зеркало("простаивает");
	Приватное.ТокенДоступа = "sekret-42";

	Список = Новый Массив();
	Список.Добавить(Приватное);
	Сервис.Задать(Список);

	Ответ = Новый ОтветСтраницыЗаглушка();
	ДомПула_.СнятиеТокена(Ответ, "owned", "1", Новый Соответствие(), Неопределено, "POST",
		"_csrf=токен-теста");

	Ожидаем.Что(Приватное.ТокенДоступа, "токен снят").Равно("");
	Ожидаем.Что(Ответ.ПутьРедиректа, "и человек возвращается в раздел")
		.Равно("/owned/settings/mirrors?saved=1");

КонецПроцедуры

// Дефект владельца: кнопка «Синхронизировать сейчас» отвечала тихим 302 и на приём заявки,
// и на отказ — человек нажимал больше десяти раз, не понимая, взяли его заявку или нет.
&Тест
Процедура ИтогНажатияКнопкиНазванСловамиНаЭкране() Экспорт

	Ожидаем.Что(СтрНайти(Показать(Зеркало("поставлено"), "1").ТелоТекст,
			Текст("settings.pool.mirrors.sync.queued")) > 0,
		"принятая заявка названа принятой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Показать(Зеркало("идёт"), "running").ТелоТекст,
			Текст("settings.pool.mirrors.sync.running")) > 0,
		"отказ по идущему прогону объяснён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Показать(Зеркало("поставлено"), "queued").ТелоТекст,
			Текст("settings.pool.mirrors.sync.waiting")) > 0,
		"отказ по ожиданию в очереди объяснён").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Показать(Зеркало("идёт"), "").ТелоТекст,
			Текст("settings.pool.mirrors.sync.queued")),
		"без нажатия кнопки баннера на экране нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область КолонкаПрогонаВСписках

&Тест
Процедура СписокПулаПечатаетДатуПоследнегоСинкаАНеСтатус() Экспорт

	// до починки в колонке «Последний синк» стояла строка Статуса: заголовок обещал дату,
	// а ячейка показывала текст итога
	HTML = СписокПулаHTML(Зеркало("завершён"));

	Ожидаем.Что(СтрНайти(HTML, Формат(МоментСинка(), "ДЛФ=DT")) > 0,
		"колонка «Последний синк» печатает дату: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<td>создано</td>"),
		"строка статуса в колонке даты больше не печатается").Равно(0);

КонецПроцедуры

