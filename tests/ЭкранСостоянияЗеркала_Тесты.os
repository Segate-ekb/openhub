&Тест
Процедура НаЭкранеСостоянияЕстьЗапускСинхронизации() Экспорт

	HTML = ЭкранHTML(Зеркало("завершён"));

	Ожидаем.Что(СтрНайти(HTML, "action=""/owned/settings/mirrors/1/sync""") > 0,
		"с экрана состояния можно запустить прогон: " + HTML).ЭтоИстина();
