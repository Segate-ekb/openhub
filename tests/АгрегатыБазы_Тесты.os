// Агрегаты слоя данных: текст запроса собирается из модели, значения попадают в него одной
// дверью, а на бэкенде без SQL и на отказавшем запросе та же цифра приезжает выборкой
// в памяти. Набор в отдельном процессе: контейнер ОСени конфликтует с контейнером раннера.

#Использовать asserts
#Использовать autumn-logos
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать errors
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Текст;          // ТекстАгрегата — текст запроса по описанию сущности
Перем Образец;        // МодельСущностиЗаглушка — имена таблицы и колонок придумывает тест
Перем Сущность;       // ОписаниеСущности поверх образца
Перем КаталогПроекта_;
Перем СозданныеКаталоги;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	РеестрФикстур.Подключить("ЛовушкаЛога");
	РеестрФикстур.Подключить("МодельСущностиЗаглушка");
	РеестрФикстур.Подключить("ЗапросыЗаглушка");
	ПоискКлассов = Новый КлассыСлоя();
	СозданныеКаталоги = Новый Массив();

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассыСлояДанных() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта_ = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(КореньМодулей(), "данные", "Классы"));
	ПоискКлассов.ПодключитьОснову(КореньМодулей());

	Текст = Новый ТекстАгрегата();
	Образец = ОбразцоваяМодель();
	Сущность = Новый ОписаниеСущности(Образец);

КонецПроцедуры

&ПослеВсех
Процедура УдалитьВременныеКаталоги() Экспорт

	Для Каждого Каталог Из СозданныеКаталоги Цикл
		УникальныеИмена.УбратьВременное(Каталог);
	КонецЦикла;

КонецПроцедуры

#Область ТекстЗапроса

// Литерал физического имени в коде — это запрос, который переживёт переименование поля
// и молча посчитает не то. Имена приходят из модели: подменили модель — поехал текст.
&Тест
Процедура ИменаТаблицыИКолонокБерутсяИзМодели() Экспорт

	Опции = Новый ОпцииПоиска().Отбор("Скрыт", ВидСравнения.Равно, Ложь);
	Собранный = Текст.Количество(Сущность, Опции);

	Ожидаем.Что(Собранный, "имя таблицы — из модели").Содержит("FROM Таблица_Образец");
	Ожидаем.Что(Собранный, "имя колонки — из модели").Содержит("скрыт_образца = FALSE");
	Ожидаем.Что(СтрНайти(Собранный, "Скрыт "), "имя ПОЛЯ в тексте запроса не печатается").Равно(0);

КонецПроцедуры

&Тест
Процедура ГруппировкаНазываетКолонкиКлючаИЧисла() Экспорт

	Собранный = Текст.СуммаПоКлючу(Сущность, "Идентификатор", "Объём");

	Ожидаем.Что(Собранный, "ключ разреза").Содержит("id_образца AS " + Текст.КолонкаКлюча());
	Ожидаем.Что(Собранный, "сумма").Содержит("SUM(объём_образца) AS " + Текст.КолонкаЧисла());
	Ожидаем.Что(Собранный, "группировка по той же колонке").Содержит("GROUP BY id_образца");

КонецПроцедуры

// Апостроф внутри имени пула — законное имя, а не попытка дописать запрос.
&Тест
Процедура ОдинарнаяКавычкаВЗначенииУдваивается() Экспорт

	Опции = Новый ОпцииПоиска().Отбор("Имя", ВидСравнения.Равно, "О'Брайен");

	Ожидаем.Что(Текст.Количество(Сущность, Опции), "кавычка удвоена, строка не разорвана")
		.Содержит("имя_образца = 'О''Брайен'");

КонецПроцедуры

// Обратный слеш в обоих диалектах — обычный символ строки, и удваивать его нельзя:
// удвоенный он стал бы двумя символами в значении отбора.
&Тест
Процедура ОбратныйСлешВЗначенииОстаётсяОднимСимволом() Экспорт

	Опции = Новый ОпцииПоиска().Отбор("Имя", ВидСравнения.Равно, "путь\к\файлу");

	Ожидаем.Что(Текст.Количество(Сущность, Опции), "слеш перенесён как есть")
		.Содержит("имя_образца = 'путь\к\файлу'");

КонецПроцедуры

&Тест
Процедура ЦелоеПечатаетсяЦифрамиАБулевоСловом() Экспорт

	Ожидаем.Что(Условие("Объём", ВидСравнения.БольшеИлиРавно, 1234567), "разрядов в числе нет")
		.Содержит("объём_образца >= 1234567");
	Ожидаем.Что(Условие("Объём", ВидСравнения.Равно, 0), "ноль печатается нулём")
		.Содержит("объём_образца = 0");
	Ожидаем.Что(Условие("Объём", ВидСравнения.Меньше, -42), "минус остаётся при числе")
		.Содержит("объём_образца < -42");
	Ожидаем.Что(Условие("Скрыт", ВидСравнения.НеРавно, Истина), "булево — словом обоих диалектов")
		.Содержит("скрыт_образца <> TRUE");

КонецПроцедуры

// Дробное число в тексте запроса — это разделитель разрядов, зависящий от локали процесса:
// под русской он превращает одно значение в два, и база считает не то, ничего не сообщая.
&Тест
Процедура ДробномуЧислуЛитералаВЗапросеНет() Экспорт

	Ожидаем.Что(НашаСборкаОтказала(Новый ОпцииПоиска().Отбор("Объём", ВидСравнения.Равно, 1.5)),
		"дробное значение в запрос не попадает").ЭтоИстина();
	Ожидаем.Что(НашаСборкаОтказала(Новый ОпцииПоиска().Отбор("Объём", ВидСравнения.В, Числа(20.5))),
		"и в списке значений тоже").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДатаПечатаетсяISOБезЧасовогоПояса() Экспорт

	Опции = Новый ОпцииПоиска().Отбор("Истекает", ВидСравнения.Больше, '20260922143005');

	Ожидаем.Что(Текст.Количество(Сущность, Опции), "момент читается одинаково обоими диалектами")
		.Содержит("истекает_образца > '2026-09-22 14:30:05'");

КонецПроцедуры

// Колонке «Дата» база отбрасывает время сама: литерал с временем превратил бы «равно
// моменту» в равенство целым суткам, и счётчик за день считал бы не тот день.
&Тест
Процедура КолонкеДатыВремяВЛитералНеПопадает() Экспорт

	ПоДню = Новый ОпцииПоиска().Отбор("ДатаДень", ВидСравнения.Равно, '20260922143005');
	ПоМоменту = Новый ОпцииПоиска().Отбор("Момент", ВидСравнения.Равно, '20260922143005');
	ПоВремени = Новый ОпцииПоиска().Отбор("Время", ВидСравнения.Равно, '20260922143005');

	Ожидаем.Что(Текст.Количество(СуткиИМоменты(), ПоДню), "колонке суток — только дата")
		.Содержит("день_образца = '2026-09-22'");
	Ожидаем.Что(Текст.Количество(СуткиИМоменты(), ПоМоменту), "колонке момента — дата и время")
		.Содержит("момент_образца = '2026-09-22 14:30:05'");
	Ожидаем.Что(Текст.Количество(СуткиИМоменты(), ПоВремени), "колонке времени — только время")
		.Содержит("время_образца = '14:30:05'");

КонецПроцедуры

// Пустая дата — законный вопрос хаба: бессрочный ключ доступа, нерассмотренная заявка
// и неопрошенное устройство записаны именно ею. Без явного представления Формат печатает
// её пустой строкой, и в запрос уезжает сравнение с ''.
&Тест
Процедура ПустаяДатаПечатаетсяПолнымМоментомАНеПустойСтрокой() Экспорт

	Пустая = '00010101';

	Ожидаем.Что(Условие("Истекает", ВидСравнения.Равно, Пустая), "колонке момента")
		.Содержит("истекает_образца <= '0001-01-01 00:00:00'");
	Ожидаем.Что(Текст.Количество(СуткиИМоменты(),
		Новый ОпцииПоиска().Отбор("ДатаДень", ВидСравнения.Равно, Пустая)), "колонке суток")
		.Содержит("день_образца <= '0001-01-01'");
	Ожидаем.Что(Текст.Количество(СуткиИМоменты(),
		Новый ОпцииПоиска().Отбор("Время", ВидСравнения.Равно, Пустая)), "колонке времени")
		.Содержит("время_образца <= '00:00:00'");

КонецПроцедуры

// Npgsql пишет пустую дату в timestamp как -infinity, и равенство «= '0001-01-01 …'»
// не находит НИ ОДНОЙ строки — молча, без ошибки. Поэтому незаполненный момент
// сравнивается диапазоном: он сходится и с -infinity, и с 0001-01-01.
&Тест
Процедура НезаполненныйМоментСравниваетсяДиапазономАНеРавенством() Экспорт

	Пустая = '00010101';
	Живая = '20260922143005';

	Ожидаем.Что(Условие("Истекает", ВидСравнения.Равно, Пустая), "«равно пустому» — это «не позже»")
		.Содержит("истекает_образца <= '0001-01-01 00:00:00'");
	Ожидаем.Что(Условие("Истекает", ВидСравнения.НеРавно, Пустая), "«не равно пустому» — «позже»")
		.Содержит("истекает_образца > '0001-01-01 00:00:00'");

	Ожидаем.Что(Условие("Истекает", ВидСравнения.Равно, Живая), "заполненный момент — равенством")
		.Содержит("истекает_образца = '2026-09-22 14:30:05'");
	Ожидаем.Что(Условие("Истекает", ВидСравнения.НеРавно, Живая), "и неравенством")
		.Содержит("истекает_образца <> '2026-09-22 14:30:05'");

	Ожидаем.Что(Условие("Истекает", ВидСравнения.Больше, Пустая), "«больше пустого» — как есть")
		.Содержит("истекает_образца > '0001-01-01 00:00:00'");
	Ожидаем.Что(Условие("Истекает", ВидСравнения.МеньшеИлиРавно, Пустая), "«не позже» — тоже")
		.Содержит("истекает_образца <= '0001-01-01 00:00:00'");

	// в памяти «не раньше пустого» берёт ВСЕ строки, а в PostgreSQL — все, кроме -infinity;
	// «раньше пустого» в памяти не берёт НИ ОДНОЙ, а в PostgreSQL берёт как раз -infinity
	Ожидаем.Что(НашаСборкаОтказала(
		Новый ОпцииПоиска().Отбор("Истекает", ВидСравнения.БольшеИлиРавно, Пустая)),
		"«не раньше пустого» отвергается").ЭтоИстина();
	Ожидаем.Что(НашаСборкаОтказала(
		Новый ОпцииПоиска().Отбор("Истекает", ВидСравнения.Меньше, Пустая)),
		"«раньше пустого» тоже").ЭтоИстина();

КонецПроцедуры

// Список значений диапазоном не переписать, а равенством пустой момент на PostgreSQL
// не находится: отказ громкий, а не тихий промах мимо всех строк.
&Тест
Процедура НезаполненныйМоментВСпискеЗначенийОтвергается() Экспорт

	Моменты = Новый Массив();
	Моменты.Добавить('20260922143005');
	Моменты.Добавить('00010101');

	Ожидаем.Что(НашаСборкаОтказала(
		Новый ОпцииПоиска().Отбор("Истекает", ВидСравнения.В, Моменты)),
		"пустой момент в списке — отказ сборки").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗначениеНеподдержанногоТипаВЗапросНеПопадает() Экспорт

	Ожидаем.Что(НашаСборкаОтказала(Новый ОпцииПоиска().Отбор("Имя", ВидСравнения.Равно, Новый Массив())),
		"значение типа, которому нет литерала, — отказ сборки").ЭтоИстина();
	Ожидаем.Что(НашаСборкаОтказала(Новый ОпцииПоиска().Отбор("Имя", ВидСравнения.Равно, Неопределено)),
		"пустое значение тоже: NULL-семантики у агрегата нет").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НезнакомыйВидСравненияОтвергается() Экспорт

	Ожидаем.Что(НашаСборкаОтказала(Новый ОпцииПоиска().Отбор("Имя", "LIKE", "прив%")),
		"незнакомый вид сравнения — отказ, а не отбор, пропущенный молча").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПолеЧужойТаблицыВЗапросНеПопадает() Экспорт

	Ожидаем.Что(НашаСборкаОтказала(Новый ОпцииПоиска().Отбор("НетТакогоПоля", ВидСравнения.Равно, 1)),
		"поля нет в модели — отказ сборки").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ВсеВидыСравненияПревращаютсяВОператорыSQL() Экспорт

	Ожидаем.Что(Условие("Объём", ВидСравнения.Равно, 1)).Содержит("объём_образца = 1");
	Ожидаем.Что(Условие("Объём", ВидСравнения.НеРавно, 1)).Содержит("объём_образца <> 1");
	Ожидаем.Что(Условие("Объём", ВидСравнения.Больше, 1)).Содержит("объём_образца > 1");
	Ожидаем.Что(Условие("Объём", ВидСравнения.БольшеИлиРавно, 1)).Содержит("объём_образца >= 1");
	Ожидаем.Что(Условие("Объём", ВидСравнения.Меньше, 1)).Содержит("объём_образца < 1");
	Ожидаем.Что(Условие("Объём", ВидСравнения.МеньшеИлиРавно, 1)).Содержит("объём_образца <= 1");
	Ожидаем.Что(Условие("Объём", ВидСравнения.В, Числа(1, 2))).Содержит("объём_образца IN (1, 2)");
	Ожидаем.Что(Условие("Объём", ВидСравнения.НеВ, Числа(1, 2))).Содержит("объём_образца NOT IN (1, 2)");

КонецПроцедуры

&Тест
Процедура ПустойСписокЗначенийНикогоНеВыбираетНоНикогоИНеОтсеивает() Экспорт

	ПустойВ = Новый ОпцииПоиска().Отбор("Идентификатор", ВидСравнения.В, Новый Массив());
	ПустойНеВ = Новый ОпцииПоиска().Отбор("Идентификатор", ВидСравнения.НеВ, Новый Массив());

	Ожидаем.Что(Текст.ОтборНикогоНеВыберет(ПустойВ), "«В пустом» не выберет никого").ЭтоИстина();
	Ожидаем.Что(Текст.ОтборНикогоНеВыберет(ПустойНеВ), "«НЕ В пустом» отсеивать некого").ЭтоЛожь();
	Ожидаем.Что(Текст.Количество(Сущность, ПустойНеВ), "и остаётся условием-константой")
		.Содержит("WHERE TRUE");

КонецПроцедуры

&Тест
Процедура ОтборБезУсловийДаётЗапросБезWHERE() Экспорт

	Ожидаем.Что(СтрНайти(Текст.Количество(Сущность), "WHERE"), "вся таблица — без WHERE").Равно(0);
	Ожидаем.Что(Текст.Количество(Сущность)).Содержит("SELECT COUNT(*) AS " + Текст.КолонкаЧисла());

КонецПроцедуры

// Два отбора складываются, а не выбираются: «ИЛИ» посчитало бы объединение множеств,
// и число оказалось бы больше настоящего.
&Тест
Процедура ДваОтбораСкладываютсяАНеВыбираются() Экспорт

	Двумя = Новый ОпцииПоиска()
		.Отбор("Скрыт", ВидСравнения.Равно, Ложь)
		.Отбор("Объём", ВидСравнения.Больше, 100);
	Собранный = Текст.Количество(Сущность, Двумя);

	Ожидаем.Что(Собранный, "условия склеены союзом «И»").Содержит(" AND ");
	Ожидаем.Что(Собранный, "первое условие на месте").Содержит("скрыт_образца = FALSE");
	Ожидаем.Что(Собранный, "и второе тоже").Содержит("объём_образца > 100");

КонецПроцедуры

// Формат числа зависит от локали процесса, Строка — нет. Сторож гоняет сборку текста
// в ДРУГОМ процессе под русской локалью: в этом её уже не сменить.
//
// Канарейка держит сам сторож, а не продукт: она краснеет, если локаль дочернего процесса
// перестала браться (снят «ЧГ=0», сменилась платформа, не установлена культура) — без неё
// сторож зеленел бы на инвариантной локали, ничего не проверив. Сам дефект — дробное число
// в тексте запроса — стережёт ДробномуЧислуЛитералаВЗапросеНет; здесь же проверяется,
// что и целое, и дата приходят в текст одинаковыми под любой локалью.
&Тест
Процедура ЧислоВЗапросеНеЗависитОтЛокалиПроцесса() Экспорт

	ПодРусской = ТекстПодЛокалью("ru_RU.UTF-8");
	ПодСишной = ТекстПодЛокалью("C");

	Ожидаем.Что(ПодРусской.Канарейка, "русская локаль в дочернем процессе действительно взята"
		+ " (иначе сторож зелен впустую)").Равно("1,5");
	Ожидаем.Что(ПодСишной.Канарейка, "а «C» отделяет дробную часть точкой").Равно("1.5");
	Ожидаем.Что(ПодРусской.Запрос, "текст запроса от локали не зависит").Равно(ПодСишной.Запрос);
	Ожидаем.Что(ПодРусской.Запрос, "и число в нём — цифрами подряд").Содержит("= 1234567");
	Ожидаем.Что(ПодРусской.Запрос, "и момент — ISO, а не русским форматом даты")
		.Содержит("= '2026-09-22 14:30:05'");

КонецПроцедуры

#КонецОбласти

#Область ВыборДорогиИФолбэк

&Тест
Процедура БэкендБезSQLПробуетсяОдинРазИБольшеНеТревожится() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Менеджер = Новый ЗапросыЗаглушка();
	Агрегаты = АгрегатыНа(Менеджер, Ловушка);
	Хранилище = Новый ЗапросыЗаглушка(Образец).Строки(Новый Массив());

	Для Счётчик = 1 По 5 Цикл
		Агрегаты.Количество(Хранилище);
		Агрегаты.БазаСчитает();
	КонецЦикла;

	Ожидаем.Что(Агрегаты.БазаСчитает(), "бэкенд без SQL агрегаты не считает").ЭтоЛожь();
	Ожидаем.Что(Менеджер.ЗапросовККоннектору(), "проба одна на все вызовы").Равно(1);
	Ожидаем.Что(Менеджер.Тексты()[0], "проба — минимальная выборка")
		.Содержит("SELECT 1 AS " + Текст.КолонкаЧисла());
	Ожидаем.Что(Ловушка.Количество(), "и одна строка в журнале").Равно(1);
	Ожидаем.Что(Ловушка.Всё(), "она называет коннектор").Содержит("КоннекторДвойник");

КонецПроцедуры

&Тест
Процедура ПослеОтрицательнойПробыХранилищеКоннектораНеВидит() Экспорт

	Хранилище = Новый ЗапросыЗаглушка(Образец).Строки(Числа(1, 2, 3));
	Агрегаты = АгрегатыНа(Новый ЗапросыЗаглушка(), Новый ЛовушкаЛога());

	Ожидаем.Что(Агрегаты.Количество(Хранилище), "счёт приехал выборкой").Равно(3);
	Ожидаем.Что(Агрегаты.Есть(Хранилище), "и признак наличия тоже").ЭтоИстина();

	Ожидаем.Что(Хранилище.ЗапросовККоннектору(), "коннектор хранилища не спрашивали ни разу").Равно(0);
	Ожидаем.Что(Хранилище.Выборок(), "зато строки поднимали на каждый агрегат").Равно(2);

КонецПроцедуры

// Успешная дорога базы: число, пустой ответ и NULL разбираются из таблицы результата.
// Без этого сторожа их разбор жил бы только в наборе на живом PostgreSQL, а он
// в регрессии пропускается.
&Тест
Процедура ЧислоПустойОтветИNULLРазбираютсяИзОтветаБазы() Экспорт

	Агрегаты = АгрегатыНаSQL();

	СЧислом = Новый ЗапросыЗаглушка(Образец).ИсполняетSQL().Ответ(ТаблицаЧисла(7));
	Ожидаем.Что(Агрегаты.Количество(СЧислом), "число берётся из колонки ответа").Равно(7);

	Пустой = Новый ЗапросыЗаглушка(Образец).ИсполняетSQL().Ответ(Новый ТаблицаЗначений());
	Ожидаем.Что(Агрегаты.Сумма(Пустой, "Объём"), "пустой ответ — это ноль").Равно(0);

	СNULL = Новый ЗапросыЗаглушка(Образец).ИсполняетSQL().Ответ(ТаблицаЧисла(NULL));
	Ожидаем.Что(Агрегаты.Сумма(СNULL, "Объём"), "SUM без строк даёт NULL, а не ноль").Равно(0);

КонецПроцедуры

&Тест
Процедура РазрезИзОтветаБазыАдресуетсяТипомПоляСущности() Экспорт

	Агрегаты = АгрегатыНаSQL();

	ПоЦелому = Новый ЗапросыЗаглушка(Образец).ИсполняетSQL().Ответ(ТаблицаРазреза(5, 2));
	ПоИдентификатору = Агрегаты.КоличествоПоКлючу(ПоЦелому, "Идентификатор");
	Ожидаем.Что(ПоИдентификатору.Получить(5), "целый ключ адресуется целым").Равно(2);

	ПоСтроке = Новый ЗапросыЗаглушка(Образец).ИсполняетSQL().Ответ(ТаблицаРазреза("public", 3));
	ПоИмени_ = Агрегаты.КоличествоПоКлючу(ПоСтроке, "Имя");
	Ожидаем.Что(ПоИмени_.Получить("public"), "строковый ключ остаётся строкой").Равно(3);

КонецПроцедуры

// Отказ базы не меняет ответа пользователю: цифра приезжает выборкой, а причина —
// строкой в журнал.
&Тест
Процедура ОтказБазыУводитВПамятьИНазываетПричину() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Агрегаты = АгрегатыНа(Новый ЗапросыЗаглушка().ИсполняетSQL(), Ловушка, УровниЛога.Предупреждение);
	Хранилище = Новый ЗапросыЗаглушка(Образец).ПадаетНаЗапросе().Строки(Числа(1, 2, 3, 4));

	Ожидаем.Что(Агрегаты.Количество(Хранилище), "ответ тот же, что дала бы выборка").Равно(4);
	Ожидаем.Что(Хранилище.ЗапросовККоннектору(), "база спрошена").Равно(1);
	Ожидаем.Что(Ловушка.Всё(), "журнал винит базу").Содержит("база не посчитала");
	Ожидаем.Что(Ловушка.Всё(), "и называет таблицу").Содержит("Таблица_Образец");
	Ожидаем.Что(Ловушка.Всё(), "и причину отказа").Содержит("syntax error");

КонецПроцедуры

// Запрос, который хаб не собрал, база не видела вовсе: обвинять её в нём — значит слать
// администратора чинить исправную СУБД.
&Тест
Процедура ОтказСборкиНеВыдаётсяЗаОтказБазы() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Агрегаты = АгрегатыНа(Новый ЗапросыЗаглушка().ИсполняетSQL(), Ловушка, УровниЛога.Предупреждение);
	Хранилище = Новый ЗапросыЗаглушка(Образец).ИсполняетSQL().Строки(Числа(1, 2));
	Незнакомый = Новый ОпцииПоиска().Отбор("Имя", "LIKE", "прив%");

	Ожидаем.Что(Агрегаты.Количество(Хранилище, Незнакомый), "ответ приехал выборкой").Равно(2);
	Ожидаем.Что(Хранилище.ЗапросовККоннектору(), "база не спрошена: собирать было нечего").Равно(0);
	Ожидаем.Что(Ловушка.Всё(), "журнал говорит про несобранный запрос").Содержит("не собран");
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "база не посчитала"), "и базу не обвиняет").Равно(0);

КонецПроцедуры

// Счётчик спрашивают на каждой отрисовке страницы: повтори предупреждение — и журнал
// утонет, а нового в нём не появится. Поэтому предупреждение одно, а повторы — в отладке.
&Тест
Процедура ПовторныйОтказПредупреждениеНеПовторяетНоВОтладкеОстаётся() Экспорт

	Предупреждения = Новый ЛовушкаЛога();
	ГромкиеАгрегаты = АгрегатыНа(Новый ЗапросыЗаглушка().ИсполняетSQL(), Предупреждения,
		УровниЛога.Предупреждение);

	Отладка = Новый ЛовушкаЛога();
	ТихиеАгрегаты = АгрегатыНа(Новый ЗапросыЗаглушка().ИсполняетSQL(), Отладка, УровниЛога.Отладка);

	Для Счётчик = 1 По 3 Цикл
		ГромкиеАгрегаты.Количество(Новый ЗапросыЗаглушка(Образец).ПадаетНаЗапросе().Строки(Числа(1)));
		ТихиеАгрегаты.Количество(Новый ЗапросыЗаглушка(Образец).ПадаетНаЗапросе().Строки(Числа(1)));
	КонецЦикла;

	Ожидаем.Что(Предупреждения.Количество(), "предупреждение одно на три отказа").Равно(1);
	Ожидаем.Что(Отладка.Количество(), "а в отладке все три").Равно(3);

КонецПроцедуры

// Два вида отказа — две разные строки предупреждения: иначе первый же несобранный запрос
// закрывал бы своим ключом настоящий отказ базы по той же таблице.
&Тест
Процедура ОтказСборкиИОтказБазыПредупреждаютПоОтдельности() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Агрегаты = АгрегатыНа(Новый ЗапросыЗаглушка().ИсполняетSQL(), Ловушка, УровниЛога.Предупреждение);
	Незнакомый = Новый ОпцииПоиска().Отбор("Имя", "LIKE", "прив%");

	Агрегаты.Количество(Новый ЗапросыЗаглушка(Образец).ИсполняетSQL().Строки(Числа(1)), Незнакомый);
	Агрегаты.Количество(Новый ЗапросыЗаглушка(Образец).ПадаетНаЗапросе().Строки(Числа(1)));

	Ожидаем.Что(Ловушка.Количество(), "оба отказа названы").Равно(2);
	Ожидаем.Что(Ловушка.Всё(), "один — про сборку").Содержит("не собран");
	Ожидаем.Что(Ловушка.Всё(), "другой — про базу").Содержит("база не посчитала");

КонецПроцедуры

&Тест
Процедура ПустойСписокСчитаетсяБезОбращенияКБазеВовсе() Экспорт

	Хранилище = Новый ЗапросыЗаглушка(Образец).ИсполняетSQL().Строки(Числа(1, 2));
	Агрегаты = АгрегатыНаSQL();
	Пусто = Новый ОпцииПоиска().Отбор("Идентификатор", ВидСравнения.В, Новый Массив());

	Ожидаем.Что(Агрегаты.Количество(Хранилище, Пусто), "счёт по пустому списку").Равно(0);
	Ожидаем.Что(Агрегаты.Есть(Хранилище, Пусто), "наличия по пустому списку нет").ЭтоЛожь();
	Ожидаем.Что(Агрегаты.Сумма(Хранилище, "Объём", Пусто), "сумма по пустому списку").Равно(0);
	Ожидаем.Что(Агрегаты.КоличествоПоКлючу(Хранилище, "Идентификатор", Пусто).Количество(),
		"разрез по пустому списку пуст").Равно(0);

	Ожидаем.Что(Хранилище.ЗапросовККоннектору(), "база не спрошена").Равно(0);
	Ожидаем.Что(Хранилище.Выборок(), "и строки не подняты").Равно(0);

КонецПроцедуры

// Ни SQL, ни сложение в памяти текст и дату не суммируют. Отказ обязан быть один на обе
// дороги и до обращения к базе: иначе одна дорога молчала бы, а вторая падала пятисоткой.
&Тест
Процедура СуммаПоНечисловомуПолюОтвергаетсяДоВыбораДороги() Экспорт

	Хранилище = Новый ЗапросыЗаглушка(Образец).ИсполняетSQL().Строки(Числа(1, 2));
	Агрегаты = АгрегатыНаSQL();

	Ожидаем.Что(УпалоНаСумме(Агрегаты, Хранилище, "Имя"), "сумма по строковому полю")
		.ЭтоИстина();
	Ожидаем.Что(УпалоНаСумме(Агрегаты, Хранилище, "Истекает"), "сумма по полю момента")
		.ЭтоИстина();
	Ожидаем.Что(УпалоНаСумме(Агрегаты, Хранилище, "Скрыт"), "сумма по признаку")
		.ЭтоИстина();

	Пусто = Новый ОпцииПоиска().Отбор("Идентификатор", ВидСравнения.В, Новый Массив());
	Ожидаем.Что(УпалоНаСумме(Агрегаты, Хранилище, "Имя", Пусто),
		"и при заведомо пустом отборе тоже: неверный вызов не спасается пустым списком")
		.ЭтоИстина();

	Ожидаем.Что(Хранилище.ЗапросовККоннектору(), "база об этом даже не спрошена").Равно(0);
	Ожидаем.Что(Хранилище.Выборок(), "и строки не подняты").Равно(0);

КонецПроцедуры

// Агрегат по странице дал бы две разные цифры, смотря какой дорогой его посчитали.
&Тест
Процедура ПостраничныеОпцииАгрегатНеСчитает() Экспорт

	Хранилище = Новый ЗапросыЗаглушка(Образец).Строки(Числа(1, 2));
	Агрегаты = АгрегатыНа(Новый ЗапросыЗаглушка(), Новый ЛовушкаЛога());

	Ожидаем.Что(УпалоНаАгрегате(Агрегаты, Хранилище, Новый ОпцииПоиска().Первые(1)),
		"счёт по первым N").ЭтоИстина();
	Ожидаем.Что(УпалоНаАгрегате(Агрегаты, Хранилище, Новый ОпцииПоиска().Смещение(5)),
		"счёт со смещением").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПаритетДорогНаЖивойБазе

&Тест
Процедура НаКоннектореВПамятиАгрегатыСходятсяСПрямойВыборкой() Экспорт
	ПроверитьПаритет("КоннекторInMemory", "агрегаты-в-памяти-" + УникальныеИмена.Имя("ключ"));
КонецПроцедуры

&Тест
Процедура НаФайловомКоннектореАгрегатыСходятсяСПрямойВыборкой() Экспорт
