КонецПроцедуры

#КонецОбласти

#Область СверкаДорог

// Паритет дорог: то же число, что даёт прямая выборка, — на всех пяти агрегатах сразу.
Процедура ПроверитьПаритет(Знач ТипКоннектора, Знач СтрокаСоединения)

	Поделка = ПостроитьКонтейнер(ТипКоннектора, СтрокаСоединения);
	Засев = Новый ЗасевРеестра(Поделка);
	Агрегаты = Поделка.НайтиЖелудь("АгрегатыБазы");
	Пулы = Поделка.НайтиЖелудь("ЗапросыПулов");
	Пакеты = Поделка.НайтиЖелудь("ЗапросыПакетов");

	Ожидаем.Что(Агрегаты, "желудь агрегатов, " + ТипКоннектора).Существует();
	Ожидаем.Что(Агрегаты.БазаСчитает(), "бэкенд " + ТипКоннектора + " SQL не исполняет").ЭтоЛожь();

	Открытый = ЗасеятьПул(Засев, "public", 10);
	Второй = ЗасеятьПул(Засев, "public", 20);
	Закрытый = ЗасеятьПул(Засев, "private", 30);
	Засев.Пакет(Открытый);
	Засев.Пакет(Открытый);
	Засев.Пакет(Второй);

	Публичные = Новый ОпцииПоиска().Отбор("Видимость", ВидСравнения.Равно, "public");
	Крупные = Новый ОпцииПоиска()
		.Отбор("Видимость", ВидСравнения.Равно, "public")
		.Отбор("ЗанятоБайт", ВидСравнения.Больше, 15);

	Ожидаем.Что(Агрегаты.Количество(Пулы), "счёт всех пулов, " + ТипКоннектора).Равно(3);
	Ожидаем.Что(Агрегаты.Количество(Пулы, Публичные), "счёт с отбором, " + ТипКоннектора)
		.Равно(Пулы.Получить(Публичные).Количество());
	Ожидаем.Что(Агрегаты.Количество(Пулы, Крупные), "счёт с двумя отборами, " + ТипКоннектора)
		.Равно(Пулы.Получить(Крупные).Количество());
	Ожидаем.Что(Агрегаты.Количество(Пулы, Крупные), "два отбора складываются, а не выбираются, "
		+ ТипКоннектора).Равно(1);
	Ожидаем.Что(Агрегаты.Сумма(Пулы, "ЗанятоБайт"), "сумма поля, " + ТипКоннектора).Равно(60);
	Ожидаем.Что(Агрегаты.Сумма(Пулы, "ЗанятоБайт", Публичные), "сумма с отбором, " + ТипКоннектора)
		.Равно(30);
	Ожидаем.Что(Агрегаты.Есть(Пулы, ПоИмени(Закрытый.Имя)), "пул с таким именем есть, " + ТипКоннектора)
		.ЭтоИстина();
	Ожидаем.Что(Агрегаты.Есть(Пулы, ПоИмени(Закрытый.Имя + "-нет-такого")),
		"а с таким — нет, " + ТипКоннектора).ЭтоЛожь();

	Разрез = Агрегаты.КоличествоПоКлючу(Пакеты, "ПулИдентификатор");
	Ожидаем.Что(Разрез.Количество(), "в разрезе только пулы с пакетами, " + ТипКоннектора).Равно(2);
	Ожидаем.Что(Разрез.Получить(Цел(Открытый.Идентификатор)), "пакетов первого пула, " + ТипКоннектора)
		.Равно(2);
	Ожидаем.Что(Разрез.Получить(Цел(Второй.Идентификатор)), "пакетов второго пула, " + ТипКоннектора)
		.Равно(1);
	Ожидаем.Что(Разрез.Получить(Цел(Закрытый.Идентификатор)), "пула без пакетов в разрезе нет, "
		+ ТипКоннектора).ЭтоНеопределено();

	Объёмы = Агрегаты.СуммаПоКлючу(Пулы, "Видимость", "ЗанятоБайт");
	Ожидаем.Что(Объёмы.Получить("public"), "объём публичных, " + ТипКоннектора).Равно(30);
	Ожидаем.Что(Объёмы.Получить("private"), "объём закрытых, " + ТипКоннектора).Равно(30);

КонецПроцедуры

Функция ЗасеятьПул(Знач Засев, Знач Видимость, Знач Занято)

	Пул = Засев.Пул(УникальныеИмена.Имя("пул"), Видимость);
	Пул.ЗанятоБайт = Занято;
	Пул.Сохранить();

	Возврат Пул;

КонецФункции

Функция ПоИмени(Знач Имя)
	Возврат Новый ОпцииПоиска().Отбор("Имя", ВидСравнения.Равно, Имя);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Три формы момента в одной модели: база печатает их по-разному, и различает их только
// тип колонки.
Функция СуткиИМоменты()

	Возврат Новый ОписаниеСущности(Новый МодельСущностиЗаглушка("Таблица_Суток")
		.Поле("ДатаДень", "день_образца", "Дата")
		.Поле("Момент", "момент_образца", "ДатаВремя")
		.Поле("Время", "время_образца", "Время"));

КонецФункции

Функция ОбразцоваяМодель()

	Возврат Новый МодельСущностиЗаглушка("Таблица_Образец")
		.Поле("Идентификатор", "id_образца", "Целое")
		.Поле("Имя", "имя_образца")
		.Поле("Скрыт", "скрыт_образца", "Булево")
		.Поле("Истекает", "истекает_образца", "ДатаВремя")
		.Поле("Объём", "объём_образца", "Целое");

КонецФункции

// Свой лог на каждый экземпляр агрегатов: логи logos живут на процесс, и общий уносил бы
// в ловушку соседа строки этого теста.
Функция АгрегатыНа(Знач Менеджер, Знач Ловушка, Знач Уровень = Неопределено)

	Лог = Логирование.ПолучитьЛог("тест.oshub.агрегаты." + Строка(Новый УникальныйИдентификатор()));
	Лог.УстановитьУровень(?(Уровень = Неопределено, УровниЛога.Отладка, Уровень));
	Лог.ДобавитьСпособВывода(Ловушка);

	Возврат Новый АгрегатыБазы(Менеджер, Лог);

КонецФункции

Функция АгрегатыНаSQL()
	Возврат АгрегатыНа(Новый ЗапросыЗаглушка().ИсполняетSQL(), Новый ЛовушкаЛога());
КонецФункции

Функция ТаблицаЧисла(Знач Значение)

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить(Текст.КолонкаЧисла());
	Таблица.Добавить()[Текст.КолонкаЧисла()] = Значение;

	Возврат Таблица;

КонецФункции

Функция ТаблицаРазреза(Знач Ключ, Знач Значение)

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить(Текст.КолонкаКлюча());
	Таблица.Колонки.Добавить(Текст.КолонкаЧисла());

	СтрокаОтвета = Таблица.Добавить();
	СтрокаОтвета[Текст.КолонкаКлюча()] = Ключ;
	СтрокаОтвета[Текст.КолонкаЧисла()] = Значение;

	Возврат Таблица;

КонецФункции

Функция Условие(Знач ИмяПоля, Знач Вид, Знач Значение)
	Возврат Текст.Количество(Сущность, Новый ОпцииПоиска().Отбор(ИмяПоля, Вид, Значение));
КонецФункции

Функция Числа(Знач Первое, Знач Второе = Неопределено, Знач Третье = Неопределено,
	Знач Четвёртое = Неопределено)

	Результат = Новый Массив();
	Результат.Добавить(Первое);
	Если Второе <> Неопределено Тогда
		Результат.Добавить(Второе);
	КонецЕсли;
	Если Третье <> Неопределено Тогда
		Результат.Добавить(Третье);
	КонецЕсли;
	Если Четвёртое <> Неопределено Тогда
		Результат.Добавить(Четвёртое);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Истина, если сборку текста отвергли именно наши правила, а не что-то ещё: отказ несёт
// код «операция не поддерживается», по нему его и отличает вызывающий.
Функция НашаСборкаОтказала(Знач Опции)

	Попытка
		Текст.Количество(Сущность, Опции);
	Исключение
		Возврат ДиагностикаОшибок.Содержит(ИнформацияОбОшибке(),
			КодыСтандартныхОшибок.ОперацияНеПоддерживается());
	КонецПопытки;

	Возврат Ложь;

КонецФункции

// Отказ сверяется кодом: любое другое исключение — находка, а не ожидаемое поведение.
Функция УпалоНаСумме(Знач Агрегаты, Знач Хранилище, Знач ИмяПоля, Знач Опции = Неопределено)

	Попытка
		Агрегаты.Сумма(Хранилище, ИмяПоля, Опции);
	Исключение
		Возврат ДиагностикаОшибок.Содержит(ИнформацияОбОшибке(),
			КодыСтандартныхОшибок.ОперацияНеПоддерживается());
	КонецПопытки;

	Возврат Ложь;

КонецФункции

Функция УпалоНаАгрегате(Знач Агрегаты, Знач Хранилище, Знач Опции)

	Попытка
		Агрегаты.Количество(Хранилище, Опции);
	Исключение
		Возврат Истина;
	КонецПопытки;

	Возврат Ложь;

КонецФункции

// Сборка текста в отдельном процессе под заданной локалью: в своём её уже не сменить —
// платформа берёт культуру один раз на старте.
//
// Возвращаемое значение:
//  Структура - Канарейка (Строка — как локаль печатает 1,5), Запрос (Строка — текст агрегата).
//
Функция ТекстПодЛокалью(Знач Локаль)

	БылаЛокаль = ПолучитьПеременнуюСреды("LC_ALL");
	БылаНастройка = ПолучитьПеременнуюСреды("OSCRIPT_CONFIG");
	УстановитьПеременнуюСреды("LC_ALL", Локаль);
	// сценарий лежит во временном каталоге, а oscript.cfg ищется рядом со сценарием:
	// путь к библиотекам дочернему процессу приходится назвать переменной среды
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG",
		"lib.additional=" + ОбъединитьПути(КаталогПроекта_, "oscript_modules"));

	Попытка
		Вывод = ВыводСценарияЛокали();
	Исключение
		ВернутьСреду(БылаЛокаль, БылаНастройка);
		ВызватьИсключение;
	КонецПопытки;
	ВернутьСреду(БылаЛокаль, БылаНастройка);

	Части = СтрРазделить(СокрЛП(Вывод), "|", Ложь);
	Ожидаем.Что(Части.Количество(), "дочерний процесс напечатал канарейку и запрос: " + Вывод)
		.Равно(2);

	Возврат Новый Структура("Канарейка, Запрос", СокрЛП(Части[0]), СокрЛП(Части[1]));

КонецФункции

Процедура ВернутьСреду(Знач Локаль, Знач Настройка)
	УстановитьПеременнуюСреды("LC_ALL", ?(Локаль = Неопределено, "", Локаль));
	УстановитьПеременнуюСреды("OSCRIPT_CONFIG", ?(Настройка = Неопределено, "", Настройка));
КонецПроцедуры

Функция ВыводСценарияЛокали()

	Процесс = СоздатьПроцесс(СтрШаблон("oscript ""%1""", СценарийЛокали()), КаталогПроекта_, Истина);
	Процесс.Запустить();
	Процесс.ОжидатьЗавершения();

	// поток отдаёт данные ОДИН раз: читаем оба до проверки кода возврата
	Напечатанное = Процесс.ПотокВывода.Прочитать();
	Сбой = Процесс.ПотокОшибок.Прочитать();

	Если Процесс.КодВозврата <> 0 Тогда
		ВызватьИсключение СтрШаблон("Сценарий локали завершился с кодом %1: %2",
			Процесс.КодВозврата, Сбой);
	КонецЕсли;

	Возврат Напечатанное;

КонецФункции

// Сценарий-однодневка: собирает тот же текст агрегата теми же классами продукта, но
// в процессе с другой локалью.
Функция СценарийЛокали()

	Путь = ОбъединитьПути(НовыйВременныйКаталог(), "проба-локали.os");
	Фикстуры = ОбъединитьПути(КаталогПроекта_, "tests", "фикстуры");
	Служебное = ОбъединитьПути(КореньМодулей(), "данные", "Классы", "служебное");

	Строки = Новый Массив();
	Строки.Добавить("#Использовать entity");
	Строки.Добавить(Подключение(ОбъединитьПути(Фикстуры, "МодельСущностиЗаглушка.os"),
		"МодельСущностиЗаглушка"));
	Строки.Добавить(Подключение(ОбъединитьПути(Служебное, "ОписаниеСущности.os"),
		"ОписаниеСущности"));
	Строки.Добавить(Подключение(ОбъединитьПути(Служебное, "ТекстАгрегата.os"), "ТекстАгрегата"));
	Строки.Добавить("Модель = Новый МодельСущностиЗаглушка(""Таблица_Образец"")"
		+ ".Поле(""Объём"", ""объём_образца"", ""Целое"")"
		+ ".Поле(""Момент"", ""момент_образца"", ""ДатаВремя"");");
	Строки.Добавить("Опции = Новый ОпцииПоиска()"
		+ ".Отбор(""Объём"", ВидСравнения.Равно, 1234567)"
		+ ".Отбор(""Момент"", ВидСравнения.Равно, '20260922143005');");
	Строки.Добавить("Собранный = Новый ТекстАгрегата().Количество("
		+ "Новый ОписаниеСущности(Модель), Опции);");
	Строки.Добавить("Сообщить(Формат(1.5, ""ЧГ=0; ЧН=0"") + ""|"" + Собранный);");

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.ЗаписатьСтроку(СтрСоединить(Строки, Символы.ПС));
	Запись.Закрыть();

	Возврат Путь;

КонецФункции

Функция Подключение(Знач Файл, Знач ИмяТипа)
	Возврат СтрШаблон("ПодключитьСценарий(""%1"", ""%2"");", Файл, ИмяТипа);
КонецФункции

Функция КореньМодулей()
	Возврат ОбъединитьПути(КаталогПроекта_, "src", "модули");
КонецФункции

Функция НовыйВременныйКаталог()

	Каталог = УникальныеИмена.ВременныйКаталог("openhub-агрегаты");
	СозданныеКаталоги.Добавить(Каталог);

	Возврат Каталог;

КонецФункции

Функция ПостроитьКонтейнер(Знач ТипКоннектора, Знач СтрокаСоединения)

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", ТипКоннектора);
	ИсточникДанных.Вставить("СтрокаСоединения", СтрокаСоединения);

	Детальки = Новый Соответствие();
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Возврат Поделка;

КонецФункции

#КонецОбласти
