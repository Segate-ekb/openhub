// Интеграционные тесты прозрачного зеркала: поднимаются ДВА настоящих хаба, downstream
// проксирует, кэширует и лениво индексирует пакеты upstream. Апстрим — наш второй хаб,
// не реальный hub.oscript.io. Бэкенд БД — КоннекторJSON: SQLite нет на macOS arm64,
// а InMemory не делится между процессами засевщика и хаба.
// Сети наружу набор не требует: приёмка против живого hub.oscript.io живёт отдельным
// набором ЗеркалоРеальныйАпстрим_Тесты с тегом «внешние».

#Использовать asserts
#Использовать "фикстуры"

Перем ХабУпстрима;      // фикстуры ЭкземплярХаба: свой свободный порт у каждого
Перем ХабЗеркала;
Перем ПортУпстрима;
Перем ПортЗеркала;
Перем КореньУпстрима;
Перем КореньЗеркала;
Перем КаталогПроекта;
Перем ТаймаутСек;
Перем Пакет;
Перем Доступность;      // фикстура ДоступностьАпстрима — правило предиката приёмки

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
	ТаймаутСек = 60;
	Пакет = "spike0c-testpkg";
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьДваХаба() Экспорт

	ХабУпстрима = НовыйХаб();
	КаталогПроекта = ХабУпстрима.КаталогПроекта();

	РеестрФикстур.Подключить("ДоступностьАпстрима");
	Доступность = Новый ДоступностьАпстрима();

	КореньУпстрима = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-up-" + Строка(Новый УникальныйИдентификатор));
	КореньЗеркала = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-mirror-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньУпстрима);
	СоздатьКаталог(КореньЗеркала);
	// КоннекторJSON пишет по файлу на таблицу в каталог соединения — он должен
	// существовать до старта. Для upstream его создаёт засевщик, для зеркала — здесь.
	СоздатьКаталог(ОбъединитьПути(КореньУпстрима, "jsondb"));
	СоздатьКаталог(ОбъединитьПути(КореньЗеркала, "jsondb"));

	// --- upstream: засев + запуск ---
	ЗадатьОкружениеУпстрима(ПутьФикстурыПакета());
	ЗапуститьЗасев();
	ХабУпстрима.Запустить();
	ПортУпстрима = ХабУпстрима.Порт();

	// --- downstream (зеркало): топология заводится ДО старта, затем запуск ---
	// Порт апстрима уже известен — он и подставляется в апстрим пула назначения.
	ХабЗеркала = НовыйХаб();
	ЗадатьОкружениеЗеркала();
	ЗапуститьЗасев(); // пул public + апстрим на upstream + свой локальный пакет
	ХабЗеркала.Запустить();
	ПортЗеркала = ХабЗеркала.Порт();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХабы() Экспорт
	Если ХабЗеркала <> Неопределено Тогда
		ХабЗеркала.Остановить();
	КонецЕсли;
	Если ХабУпстрима <> Неопределено Тогда
		ХабУпстрима.Остановить();
	КонецЕсли;
	ОчиститьОкружение();
КонецПроцедуры

&Тест
Процедура ПрозрачноеЗеркалоСквозной() Экспорт

	// Диагностика (замечание ревью): хабы запускаются отдельными процессами, их вывод
	// нигде не печатается — при провале (например, 500 вместо 200) стектрейс сервера
	// терялся, и причину нельзя было отличить от флака. Дампим вывод обоих хабов.
	Попытка
		СквознойСценарий();
	Исключение
		ДампХабов();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура СквознойСценарий()

	// 1) точная версия проксируется дефолтным пулом "public" через его апстрим
	ПоГруппе = GET(ПортЗеркала, "/pools/public/download/" + Пакет + "/" + Пакет + "-1.0.0.ospx");
	Ожидаем.Что(ПоГруппе.КодСостояния, "точная версия проксирована дефолтным пулом").Равно(200);
	Ожидаем.Что(ПоГруппе.ПолучитьТелоКакДвоичныеДанные().Размер() > 0, "тело .ospx не пустое").ЭтоИстина();

	// то же через дефолтный алиас /download (алиас = group-зеркало)
	ПоАлиасу = GET(ПортЗеркала, "/download/" + Пакет + "/" + Пакет + "-1.0.0.ospx");
	Ожидаем.Что(ПоАлиасу.КодСостояния, "точная версия через дефолтный алиас /download").Равно(200);

	// 2) latest проксируется: версия берётся из МАНИФЕСТА скачанного .ospx
	// (в фикстуре манифест = 0.1.0 для всех версий → latest отдаёт 0.1.0; в реальности
	// манифест latest совпадает со stable-версией). Проверяем, что манифест разобран.
	Latest = GET(ПортЗеркала, "/download/" + Пакет + "/" + Пакет + ".ospx");
	Ожидаем.Что(Latest.КодСостояния, "latest проксирован").Равно(200);
	Ожидаем.Что(СтрНайти(Заголовок(Latest, "Content-Disposition"), Пакет + "-0.1.0.ospx") > 0,
		"latest резолвится по версии из манифеста: " + Заголовок(Latest, "Content-Disposition")).ЭтоИстина();

	// 3) ленивая индексация: пакет появился в реестре ДЕФОЛТНОГО пула — с 5.D-2 отдельного
	// proxy-участника нет, кэш живёт в том же пуле, у которого настроен апстрим
	СписокHub = GET(ПортЗеркала, "/pools/public/download/list.txt");
	Ожидаем.Что(СтрНайти(СписокHub.ПолучитьТелоКакСтроку(), Пакет) > 0,
		"скачанный пакет проиндексирован в дефолтном пуле").ЭтоИстина();

	// проиндексированная версия несёт sha256 → отдаётся ETag (метаданные из хранилища)
	Ожидаем.Что(ЗначениеЗаполнено(Заголовок(ПоГруппе, "ETag")), "проксированная версия отдаёт ETag").ЭтоИстина();

	// 4) артефакт физически закэширован на диске зеркала (immutable-кэш)
	КэшФайл = ОбъединитьПути(ОбъединитьПути(КореньЗеркала, "pools", "public"), Пакет);
	КэшФайл = ОбъединитьПути(КэшФайл, Пакет + "-1.0.0.ospx");
	Ожидаем.Что(Новый Файл(КэшФайл).Существует(), "артефакт закэширован: " + КэшФайл).ЭтоИстина();

	// 5) главный приёмочный: настоящий opm install через зеркало (если opm доступен)
	Если ОпмДоступен() Тогда
		ПроверитьOpmInstallЧерезЗеркало();
	КонецЕсли;

	// 6) offline: останавливаем апстрим — immutable-кэш продолжает обслуживать,
	// а не скачанное ранее возвращает 404
	ХабУпстрима.Остановить();
	Приостановить(1000);

	ИзКэша = GET(ПортЗеркала, "/download/" + Пакет + "/" + Пакет + "-1.0.0.ospx");
	Ожидаем.Что(ИзКэша.КодСостояния, "закэшированная версия отдаётся при недоступном апстриме").Равно(200);

	Промах = GET(ПортЗеркала, "/download/" + Пакет + "/" + Пакет + "-2.0.0-rc.1.ospx");
	Ожидаем.Что(Промах.КодСостояния, "не скачанная ранее версия при offline → 404").Равно(404);

КонецПроцедуры

// Вывод обоих хабов ОДНОЙ СТРОКОЙ — для исключений из &ПередВсеми: там Сообщить()
// в консоль прогона не попадает, и единственный способ донести диагностику до отчёта —
// вложить её в текст исключения.
Функция ДампХабовСтрокой()

	Возврат "=== ЗЕРКАЛО (downstream) ===" + Символы.ПС
		+ ?(ХабЗеркала = Неопределено, "не поднималось", ХабЗеркала.Дамп()) + Символы.ПС
		+ "=== УПСТРИМ (upstream) ===" + Символы.ПС
		+ ?(ХабУпстрима = Неопределено, "не поднимался", ХабУпстрима.Дамп());

КонецФункции

// Печатает накопленный вывод обоих хабов — единственный источник стектрейса при 5xx.
Процедура ДампХабов()
	Сообщить("=== ЗЕРКАЛО (downstream) ===");
	Сообщить(?(ХабЗеркала = Неопределено, "не поднималось", ХабЗеркала.Дамп()));
	Сообщить("=== УПСТРИМ (upstream) ===");
	Сообщить(?(ХабУпстрима = Неопределено, "не поднимался", ХабУпстрима.Дамп()));
КонецПроцедуры

// Сторож правила, по которому приёмка против живого hub.oscript.io решает, идти ей в сеть
// или тихо уйти в пропуски: правило обязано отличать «сервера нет» от «сервер ответил
// иначе, чем вчера». Сама приёмка уехала в набор с тегом «внешние», а её правило стережётся
// здесь — в наборе, который гоняется регрессией и сети не касается.
&Тест
Процедура ПредикатДоступностиНеПутаетРедиректСНедоступностью() Экспорт

	Ожидаем.Что(Доступность.ОтветОзначаетДоступность(200), "200 — доступен").ЭтоИстина();
	Ожидаем.Что(Доступность.ОтветОзначаетДоступность(301),
		"301 на https — сервер ответил, значит доступен").ЭтоИстина();
	Ожидаем.Что(Доступность.ОтветОзначаетДоступность(308), "постоянный редирект — тоже ответ").ЭтоИстина();
	Ожидаем.Что(Доступность.ОтветОзначаетДоступность(404),
		"чужой хаб переименовал ресурс — сеть до него есть").ЭтоИстина();

	Ожидаем.Что(Доступность.ОтветОзначаетДоступность(500), "5xx — сервер не обслуживает").ЭтоЛожь();
	Ожидаем.Что(Доступность.ОтветОзначаетДоступность(503), "5xx — сервер не обслуживает").ЭтоЛожь();
	Ожидаем.Что(Доступность.ОтветОзначаетДоступность(0), "ответа нет вовсе").ЭтоЛожь();

КонецПроцедуры

// Установлен ли исполняемый opm — предикат включения приёмочного теста.
//
// Возвращаемое значение:
//  Булево - признак доступности opm.
//
Функция ОпмДоступен() Экспорт
	Попытка
		Проба = СоздатьПроцесс("opm version", , Истина);
		Проба.Запустить();
		ДождатьсяПроцесса(Проба, "opm version");
		Возврат Проба.КодВозврата = 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// --- служебные ---

Процедура ПроверитьOpmInstallЧерезЗеркало()

	РабочийКаталог = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-opm-mirror-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(РабочийКаталог);

	// opm видит group-зеркало как обычный сервер: путь пула public
	Конфиг =
	"{
	|    ""СервераПакетов"": [
	|        {
	|            ""Имя"": ""openhub-mirror"",
	|            ""Сервер"": ""http://localhost"",
	|            ""Порт"": " + Формат(ПортЗеркала, "ЧГ=0; ЧН=0") + ",
	|            ""ПутьНаСервере"": ""/pools/public/download/"",
	|            ""РесурсПубликацииПакетов"": ""/pools/public/push"",
	|            ""Приоритет"": 0
	|        }
	|    ]
	|}";
	ЗаписьКонфига = Новый ЗаписьТекста(ОбъединитьПути(РабочийКаталог, "opm.cfg"), КодировкаТекста.UTF8);
	ЗаписьКонфига.Записать(Конфиг);
	ЗаписьКонфига.Закрыть();

	ПроцессOpm = СоздатьПроцесс("opm install -l " + Пакет, РабочийКаталог, Истина);
	ПроцессOpm.Запустить();
	ДождатьсяПроцесса(ПроцессOpm, "opm install через зеркало");

	Ожидаем.Что(ПроцессOpm.КодВозврата,
		"opm install через зеркало должен завершиться кодом 0 (проксирование с upstream)").Равно(0);

	Установленный = ОбъединитьПути(ОбъединитьПути(РабочийКаталог, "oscript_modules"), Пакет);
	Установленный = ОбъединитьПути(Установленный, "opm-metadata.xml");
	Ожидаем.Что(Новый Файл(Установленный).Существует(),
		"пакет установлен через зеркало: " + Установленный).ЭтоИстина();

КонецПроцедуры

Процедура ЗадатьОкружениеУпстрима(Знач ПутьФикстуры)
	ХабУпстрима.Среда("OSHUB_STORAGE_ROOT", КореньУпстрима);
	ХабУпстрима.Среда("OSHUB_DB_CONNECTION", ОбъединитьПути(КореньУпстрима, "jsondb"));
	ХабУпстрима.Среда("OSHUB_SEED_FIXTURE", ПутьФикстуры);
	ХабУпстрима.Среда("OSHUB_SEED_POOL", "public");
	ХабУпстрима.Среда("OSHUB_SEED_PACKAGE", Пакет);
	ХабУпстрима.Среда("OSHUB_SEED_VERSIONS", "1.0.0,1.1.0,1.1.0.7,2.0.0-rc.1");
	ХабУпстрима.Среда("OSHUB_SEED_YANKED", "1.1.0.7");
	// upstream — обычный хаб, апстримов у его пула нет
	СнятьПеременныеАпстримаЗасева();
КонецПроцедуры

// Топология зеркала заводится ЯВНО, сидером: пул назначения + его апстрим. Автоматического
// разворачивания по переменным окружения больше нет — апстрим заводит оператор (интерфейс
// пула или API), и набор идёт тем же путём.
Процедура ЗадатьОкружениеЗеркала()
	ХабЗеркала.Среда("OSHUB_STORAGE_ROOT", КореньЗеркала);
	ХабЗеркала.Среда("OSHUB_DB_CONNECTION", ОбъединитьПути(КореньЗеркала, "jsondb"));
	ХабЗеркала.Среда("OSHUB_DEFAULT_POOL", "");
	// свой пакет пула назначения: он раздаётся из пула, а чужие подтягиваются апстримом
	ХабЗеркала.Среда("OSHUB_SEED_FIXTURE", ПутьФикстурыПакета());
	ХабЗеркала.Среда("OSHUB_SEED_POOL", "public");
	ХабЗеркала.Среда("OSHUB_SEED_PACKAGE", "mirror-local-pkg");
	ХабЗеркала.Среда("OSHUB_SEED_VERSIONS", "0.1.0");
	ХабЗеркала.Среда("OSHUB_SEED_YANKED", "");
	ХабЗеркала.Среда("OSHUB_SEED_UPSTREAM_URL",
		СтрШаблон("http://localhost:%1/download/", Формат(ПортУпстрима, "ЧГ=0; ЧН=0")));
	// апстрим здесь — НАШ второй хаб на localhost, то есть заведомо приватный адрес.
	// SSRF-гейт апстримов пропускает такие только по явному разрешению — ровно так же,
	// как это делает оператор интранет-зеркала.
	ХабЗеркала.Среда("OSHUB_SEED_UPSTREAM_ALLOW_PRIVATE", "1");
	ХабЗеркала.Среда("OSHUB_SEED_UPSTREAM_TTL_SEC", "3");
КонецПроцедуры

Функция ПутьФикстурыПакета()
	Путь = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "spikes", "0c-push-contract"), "fixtures");
	Возврат ОбъединитьПути(Путь, "spike0c-testpkg-0.1.0.ospx");
КонецФункции

Процедура СнятьПеременныеАпстримаЗасева()
	Для Каждого Имя Из СтрРазделить(
		"OSHUB_SEED_UPSTREAM_URL,OSHUB_SEED_UPSTREAM_ALLOW_PRIVATE,OSHUB_SEED_UPSTREAM_TTL_SEC,OSHUB_DEFAULT_POOL", ",") Цикл
		УстановитьПеременнуюСреды(Имя, "");
	КонецЦикла;
КонецПроцедуры

Процедура ОчиститьОкружение()
	Перем_ = "OSHUB_PORT,OSHUB_STORAGE_ROOT,OSHUB_DB_CONNECTOR,OSHUB_DB_CONNECTION,OSHUB_SEED_FIXTURE,"
		+ "OSHUB_SEED_POOL,OSHUB_SEED_PACKAGE,OSHUB_SEED_VERSIONS,OSHUB_SEED_YANKED,OSHUB_DEFAULT_POOL,"
		+ "OSHUB_SEED_UPSTREAM_URL,OSHUB_SEED_UPSTREAM_ALLOW_PRIVATE,OSHUB_SEED_UPSTREAM_TTL_SEC";
	Для Каждого Имя Из СтрРазделить(Перем_, ",") Цикл
		УстановитьПеременнуюСреды(Имя, "");
	КонецЦикла;
КонецПроцедуры

Процедура ЗапуститьЗасев()
	ПутьЗасевщика = ОбъединитьПути(КаталогПроекта, "scripts", "сидеры", "ЗасеятьПакет.os");
	ПроцессЗасева = СоздатьПроцесс(СтрШаблон("oscript ""%1""", ПутьЗасевщика), КаталогПроекта, Истина);
	ПроцессЗасева.Запустить();
	ДождатьсяПроцесса(ПроцессЗасева, "засев upstream");
	Если ПроцессЗасева.КодВозврата <> 0 Тогда
		ВызватьИсключение "Засев upstream завершился с ошибкой (см. вывод в консоли теста)";
	КонецЕсли;
КонецПроцедуры

// Новый подопытный хаб: свободный порт от ОС, ожидание готовности и гарантированная
// остановка — в фикстуре ЭкземплярХаба. Набор поднимает два хаба, поэтому повторную
// регистрацию типа гасим исключением (ТипЗарегистрирован в модуле набора недоступен).
Функция НовыйХаб()

	РеестрФикстур.Подключить("ЭкземплярХаба");

	Хаб = Новый ЭкземплярХаба(ТаймаутСек);

	// Фоновые задачи и доставщик вебхуков ВЫКЛЮЧЕНЫ — и это не «на всякий случай».
	// Под нагрузкой (два полных прогона одновременно) набор падал 404/502, и в логе
	// зеркала видно причину: «Сбой резолва выдачи … КоннекторJSON … The process cannot
	// access the file …/jsondb/Пулы.json because it is being used by another process» —
	// обработчик запроса и фоновая рогатка в ОДНОМ процессе хаба лезут в один JSON-файл.
	// Набор проверяет проксирование и кэш, а не планировщик; конкурентность файлового
	// коннектора — отдельный долг продукта (см. отчёт), а не предмет этого теста.
	// ВНИМАНИЕ к написанию: провайдер ENV configor превращает "_" в ".", а ДВОЙНОЕ
	// подчёркивание — в одинарное. Свойство называется oshub.webhooks.delivery_enabled,
	// поэтому гасит доставщика только OSHUB_WEBHOOKS_DELIVERY__ENABLED; написание с
	// одним подчёркиванием даёт oshub.webhooks.delivery.enabled — НЕСУЩЕСТВУЮЩУЮ
	// детальку, и флаг молча не применяется (проверено логом хаба: «Доставщик вебхуков
	// запущен» против «Доставщик вебхуков отключён»).
	Хаб.Среда("OSHUB_JOBS_ENABLED", "false");
	Хаб.Среда("OSHUB_WEBHOOKS_DELIVERY__ENABLED", "false");

	Возврат Хаб;

КонецФункции

Процедура ДождатьсяПроцесса(Знач Процесс_, Знач Пояснение)
	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТаймаутСек * 1000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Если Процесс_.Завершен Тогда
			Возврат;
		КонецЕсли;
		Приостановить(300);
	КонецЦикла;
	ВызватьИсключение СтрШаблон("Процесс ""%1"" не завершился за %2 сек", Пояснение, ТаймаутСек);
КонецПроцедуры

// Ожидание готовности хаба живёт в фикстуре ЭкземплярХаба (общая для всех HTTP-наборов).

Функция GET(Знач Порт, Знач Путь)
	Возврат Новый HTTPСоединение("localhost", Порт, , , , 20).Получить(Новый HTTPЗапрос(Путь));
КонецФункции

Функция Заголовок(Знач Ответ, Знач Имя)
	ИскомыйКлюч = ВРег(Имя);
	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) = ИскомыйКлюч Тогда
			Возврат Строка(КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции
