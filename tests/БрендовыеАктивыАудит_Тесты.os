// След картинок оформления в журнале аудита: кто, что и ЧЕМ заменил. Сервис собирается
// на НАСТОЯЩЕМ хранилище (контейнер ОСени на КоннекторInMemory), заглушки — только
// у соседей, чей вклад в запись проверять нечем: издатель событий и резолвер настроек.

#Использовать asserts
#Использовать autumn
// имя коннектора стоит в autumn-properties.json — без entity тип не зарегистрирован
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Сервис;
Перем Издатель;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	Для Каждого ФайлКласса Из НайтиФайлы(
		ОбъединитьПути(КаталогМодулей, "данные", "Классы"), "*.os", Истина) Цикл
		ПоискКлассов.ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;

	ПоискКлассов.ПодключитьОснову(КаталогМодулей);
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "настройки", "Классы"), "СервисБрендовыхАктивов");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "настройки", "Классы"), "ТипыКартинок");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "аудит", "Классы"), "ИмяОбъектаАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "аудит", "Классы"), "СобытиеАудита");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогТестов, "фикстуры"), "ИздательНастроекЗаглушка");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогТестов, "фикстуры"), "НастройкиЗаглушка");

	Поделка = ПостроитьКонтейнер();

КонецПроцедуры

&ПередКаждым
Процедура СобратьСервис() Экспорт

	Хранилище = Поделка.НайтиЖелудь("ХранилищеБрендовыхАктивов");
	Для Каждого Актив Из Хранилище.Все() Цикл
		Хранилище.Удалить(Строка(Актив.Ключ));
	КонецЦикла;

	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.ui.asset.max_bytes", 1048576);

	Издатель = Новый ИздательНастроекЗаглушка();
	ИменаЖурнала = Новый ИмяОбъектаАудита();
	Сервис = Новый СервисБрендовыхАктивов(Хранилище, Настройки, Новый ТипыКартинок(),
		Издатель, ИменаЖурнала, Новый СобытиеАудита(ИменаЖурнала, Новый ТекстJSON()));

КонецПроцедуры

// Загрузка обязана оставить в журнале автора, объект и НОВОЕ состояние картинки —
// иначе по журналу не отличить «поставили логотип» от «поставили что-то».
&Тест
Процедура ЗагрузкаПишетВЖурналАвтораИНовоеСостояние() Экспорт

	Вердикт = Сервис.Загрузить("logo", ПолучитьДвоичныеДанныеИзСтроки("первая картинка"),
		"image/png", "лого.png", "ольга-админ", "10.0.0.7");
	Ожидаем.Что(Вердикт.Принято, "загрузка принята").ЭтоИстина();

	Запись = ПоследняяЗапись();
	Ожидаем.Что(Запись.Кто, "автор изменения").Равно("ольга-админ");
	Ожидаем.Что(Запись.Действие, "действие журнала").Равно("настройка.изменена");
	Ожидаем.Что(Запись.Объект, "объект журнала называет актив")
		.Равно("настройка/oshub.ui.asset.logo");
	Ожидаем.Что(Запись.АдресIP, "адрес клиента").Равно("10.0.0.7");

	Стало = Запись.Детали.Получить("стало");
	Ожидаем.Что(Стало, "новое состояние в деталях").Существует();
	Ожидаем.Что(Стало.Получить("тип"), "тип новой картинки").Равно("image/png");
	Ожидаем.Что(Число(Стало.Получить("размер")), "размер новой картинки")
		.Равно(ПолучитьДвоичныеДанныеИзСтроки("первая картинка").Размер());

КонецПроцедуры

// Замена — это ДВА состояния. Журнал, в котором видно только новое, не отвечает на
// главный вопрос разбора: что тут было до того, как всё сломалось.
&Тест
Процедура ЗаменаПишетИПрежнееСостояниеИНовое() Экспорт

	Сервис.Загрузить("logo", ПолучитьДвоичныеДанныеИзСтроки("первая"), "image/png",
		"лого.png", "ольга-админ");
	Сервис.Загрузить("logo", ПолучитьДвоичныеДанныеИзСтроки("вторая картинка"),
		"image/svg+xml", "лого.svg", "пётр-админ");

	Запись = ПоследняяЗапись();
	Было = Запись.Детали.Получить("было");
	Стало = Запись.Детали.Получить("стало");

	Ожидаем.Что(Было, "прежнее состояние в деталях").Существует();
	Ожидаем.Что(Было.Получить("тип"), "тип прежней картинки").Равно("image/png");
	Ожидаем.Что(Стало.Получить("тип"), "тип новой картинки").Равно("image/svg+xml");
	Ожидаем.Что(Было.Получить("отпечаток") = Стало.Получить("отпечаток"),
		"отпечатки прежней и новой различаются").ЭтоЛожь();

КонецПроцедуры

// Сброс — единственное место, где «стало» пусто по существу; зато «было» обязано
// назвать снятую картинку, иначе из записи не видно, что именно убрали.
&Тест
Процедура СбросПишетСнятуюКартинкуАНеПустоту() Экспорт

	Сервис.Загрузить("favicon", ПолучитьДвоичныеДанныеИзСтроки("значок"), "image/png",
		"значок.png", "ольга-админ");

	Сервис.Сбросить("favicon", "пётр-админ", "10.0.0.9");

	Запись = ПоследняяЗапись();
	Ожидаем.Что(Запись.Действие, "действие журнала").Равно("настройка.сброшена");
	Ожидаем.Что(Запись.Кто, "автор сброса").Равно("пётр-админ");
	Ожидаем.Что(Запись.Объект, "объект журнала называет актив")
		.Равно("настройка/oshub.ui.asset.favicon");

	Было = Запись.Детали.Получить("было");
	Ожидаем.Что(Было, "снятая картинка названа").Существует();
	Ожидаем.Что(Было.Получить("тип"), "тип снятой картинки").Равно("image/png");
	Ожидаем.Что(Число(Было.Получить("размер")), "размер снятой картинки")
		.Равно(ПолучитьДвоичныеДанныеИзСтроки("значок").Размер());
	Ожидаем.Что(Запись.Детали.Получить("стало"), "после сброса состояния нет")
		.ЭтоНеопределено();

КонецПроцедуры

// Отвергнутая загрузка — не событие: журнал, распухший от чужих неудачных попыток,
// перестаёт читаться.
&Тест
Процедура ОтвергнутаяЗагрузкаВЖурналНеПопадает() Экспорт

	Вердикт = Сервис.Загрузить("logo", ПолучитьДвоичныеДанныеИзСтроки("не картинка"),
		"text/plain", "документ.txt", "ольга-админ");

	Ожидаем.Что(Вердикт.Принято, "загрузка отвергнута").ЭтоЛожь();
	Ожидаем.Что(Издатель.Опубликованные().Количество(), "события не было").Равно(0);

КонецПроцедуры

#Область Служебное

// Полезная нагрузка последнего события с уже разобранными деталями.
Функция ПоследняяЗапись()

	События = Издатель.Опубликованные();
	Ожидаем.Что(События.Количество() > 0, "событие опубликовано").ЭтоИстина();

	Данные = События[События.Количество() - 1].Данные;
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Строка(Данные.ДеталиJSON));
	// в соответствие, а не в структуру: у отсутствующего ключа тогда Неопределено,
	// а не падение — «стало» после сброса обязано читаться пустотой, а не исключением
	Детали = ПрочитатьJSON(Чтение, Истина);

	Возврат Новый Структура("Кто, Действие, Объект, АдресIP, Детали",
		Строка(Данные.Кто), Строка(Данные.Действие), Строка(Данные.Объект),
		Строка(Данные.АдресIP), Детали);

КонецФункции

Функция ПостроитьКонтейнер()

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "брендовые-активы-аудит");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	// файл autumn-properties.json приоритетнее деталек, поэтому имя искомого файла
	// подменяется на несуществующее: набору нужен именно in-memory
	Совет.ИмяФайлаСоЗначениямиДеталек("брендовые-активы-аудит-properties");
	Совет.ЗначенияДеталек(Детальки);

	Результат = Новый Поделка(Совет);
	Результат.ЗапуститьПриложение();
	Возврат Результат;

КонецФункции

#КонецОбласти
