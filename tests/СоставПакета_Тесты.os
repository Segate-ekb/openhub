// Сторож состава .ospx: пакет обязан нести всё закрытие зависимостей хаба, иначе образ
// не поднимется. Состав поставки считается по факту — путь `oscript_modules` целиком
// разворачивается по диску. Разбор манифеста идёт по КОДУ, а не по сырому тексту.

#Использовать asserts

Перем КаталогПроекта;
Перем КаталогМодулей;
Перем ТекстМанифеста;   // Строка - packagedef без комментариев

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "oscript_modules");
	ТекстМанифеста = БезКомментариев(ПрочитатьФайл(ОбъединитьПути(КаталогПроекта, "packagedef")));

КонецПроцедуры

#Область СамотестыДетекторов

&Тест
Процедура ДетекторыСоставаНеПусты() Экспорт

	// Самотест: разбор, дающий пустоту, делает остальные тесты набора вечнозелёными —
	// тогда любая потеря библиотеки проходит незамеченной.
	Ожидаем.Что(ПакетыПоставки().Количество(), "библиотек в поставке пакета").Больше(20);
	Ожидаем.Что(КорниЗависимостей().Количество(), "корней зависимостей хаба").Больше(10);
	Ожидаем.Что(ЗакрытиеЗависимостей().Количество(), "закрытие зависимостей хаба").Больше(20);

КонецПроцедуры

&Тест
Процедура РазборМанифестаНеВидитЗакомментированныхВключений() Экспорт

	// Закомментировать строку — самый обычный способ выключить включение файла, и по
	// сырому тексту сторож считал бы её действующей: пакет уезжает без библиотеки,
	// а набор зелёный. Тот же промах в обратную сторону — комментарий, ПОКАЗЫВАЮЩИЙ
	// пример вызова, сторож засчитывал за настоящий путь.
	// Имена библиотек в образце ВЫМЫШЛЕННЫЕ: настоящие в литерале ловятся скан-тестами
	// соседних наборов как настоящие директивы (так и вышло с "#Использовать autumn-data"
	// в первой редакции этого набора — покраснел ИнфраструктураТестов_Тесты).
	Образец = ".ВключитьФайл(""src"")" + Символы.ПС
		+ "	// .ВключитьФайл(""oscript_modules/сказка"")" + Символы.ПС
		+ "	// Пример вызова в тексте комментария: .ВключитьФайл(""oscript_modules/присказка"")" + Символы.ПС
		+ "	.ВключитьФайл(""oscript_modules/быль"") // .ВключитьФайл(""oscript_modules/небылица"")";

	Ожидаем.Что(СтрСоединить(ПутиИзТекстаМанифеста(БезКомментариев(Образец)), ", "),
		"пути, увиденные разбором в образце с комментариями")
		.Равно("src, oscript_modules/быль");

КонецПроцедуры

&Тест
Процедура РазборИсходниковНеВидитЗакомментированныхИмпортов() Экспорт

	// Имена вымышленные — по той же причине, что и в образце выше.
	Образец = "#Использовать сказка" + Символы.ПС
		+ "// #Использовать небылица" + Символы.ПС
		+ "	#Использовать быль-небыль";

	Ожидаем.Что(СтрСоединить(ИменаИзТекстаИсходника(Образец), ", "),
		"импорты, увиденные разбором в образце с комментариями")
		.Равно("сказка, быль-небыль");

КонецПроцедуры

&Тест
Процедура КаждаяНеТестоваяЗависимостьЗакрытияУстановлена() Экспорт

	// Закрытие строится по объявлениям dev="false". Если такая зависимость не
	// установлена, закрытие молча сузится, и тест про полноту поставки её не хватится —
	// падать об этом надо здесь, с именем пакета.
	Ожидаем.Что(СтрСоединить(Отсортированный(НеустановленныеЗависимости()), ", "),
		"рантайм-зависимости закрытия, которых нет в oscript_modules").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СоставПакета

&Тест
Процедура ПакетНесётВсёЗакрытиеЗависимостей() Экспорт

	Поставка = ПакетыПоставки();
	Недостающие = Новый Массив();

	Для Каждого КлючЗначение Из ЗакрытиеЗависимостей() Цикл
		Если Поставка.Получить(КлючЗначение.Ключ) = Неопределено Тогда
			Недостающие.Добавить(КлючЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Отсортированный(Недостающие), ", "),
		"библиотеки из закрытия зависимостей, не попавшие в поставку"
		+ " (образ ставится без hub.oscript.io — чего нет в пакете, того нет в рантайме)")
		.Равно("");

КонецПроцедуры

&Тест
Процедура ВключённыеПутиСуществуют() Экспорт

	Пропавшие = Новый Массив();

	Для Каждого ОтносительныйПуть Из ВключённыеПути() Цикл
		Файл = Новый Файл(ОбъединитьПути(КаталогПроекта, ОтносительныйПуть));
		Если НЕ Файл.Существует() Тогда
			Пропавшие.Добавить(ОтносительныйПуть);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропавшие, ", "),
		"пути из .ВключитьФайл, которых нет на диске — opm build упадёт на них").Равно("");

КонецПроцедуры

&Тест
Процедура ПакетНесётИсходникиИКонфигурациюПоУмолчанию() Экспорт

	Включённые = Новый Соответствие();
	Для Каждого Путь Из ВключённыеПути() Цикл
		Включённые.Вставить(Путь, Истина);
	КонецЦикла;

	Обязательные = СтрРазделить("src,README.md,autumn-properties.json", ",");
	Пропущенные = Новый Массив();
	Для Каждого Имя Из Обязательные Цикл
		Если Включённые.Получить(Имя) = Неопределено Тогда
			Пропущенные.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропущенные, ", "),
		"обязательное содержимое пакета: без autumn-properties.json образ поднимается"
		+ " на значениях по умолчанию из аннотаций, а не на конфигурации поставки").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВключённыеПути()
	Возврат ПутиИзТекстаМанифеста(ТекстМанифеста);
КонецФункции

// Пути из .ВключитьФайл("…"), в порядке объявления. Текст обязан прийти без комментариев.
Функция ПутиИзТекстаМанифеста(Знач Текст)

	Результат = Новый Массив();
	Отбор = Новый РегулярноеВыражение("\.ВключитьФайл\(""([^""]+)""\)");

	Для Каждого Совпадение Из Отбор.НайтиСовпадения(Текст) Цикл
		Результат.Добавить(Совпадение.Группы[1].Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Текст без комментариев "//": закомментированная строка — обычный способ выключить
// объявление, и разбор обязан видеть её выключенной.
Функция БезКомментариев(Знач Текст)

	Строки = Новый Массив();

	Для Каждого ТекущаяСтрока Из СтрРазделить(Текст, Символы.ПС) Цикл
		Строки.Добавить(Лев(ТекущаяСтрока, ДлинаКода(ТекущаяСтрока)));
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

// Длина части строки до "//" вне строкового литерала; вся строка, если комментария нет.
Функция ДлинаКода(Знач ТекущаяСтрока)

	ВнутриЛитерала = Ложь;

	Для Позиция = 1 По СтрДлина(ТекущаяСтрока) Цикл
		Символ = Сред(ТекущаяСтрока, Позиция, 1);
		Если Символ = """" Тогда
			ВнутриЛитерала = НЕ ВнутриЛитерала;
		ИначеЕсли НЕ ВнутриЛитерала И Символ = "/" И Сред(ТекущаяСтрока, Позиция + 1, 1) = "/" Тогда
			Возврат Позиция - 1;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрДлина(ТекущаяСтрока);

КонецФункции

// Имена библиотек, чьи файлы едут в пакете. Путь `oscript_modules` целиком берётся по
// факту диска: opm build кладёт каталог в .ospx как есть, со всем, что там лежит.
Функция ПакетыПоставки()

	Результат = Новый Соответствие();

	Для Каждого Путь Из ВключённыеПути() Цикл

		Если Путь = "oscript_modules" ИЛИ Путь = "oscript_modules/" Тогда
			Для Каждого Элемент Из НайтиФайлы(КаталогМодулей, "*", Ложь) Цикл
				Если Элемент.ЭтоКаталог() Тогда
					Результат.Вставить(Элемент.Имя, Истина);
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли СтрНачинаетсяС(Путь, "oscript_modules/") Тогда
			Сегменты = СтрРазделить(Сред(Путь, СтрДлина("oscript_modules/") + 1), "/");
			Результат.Вставить(Сегменты[0], Истина);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Корни: объявленные зависимости плюс библиотеки, которые src/ импортирует напрямую
// (entity и autumn-data в packagedef сознательно не объявлены — см. его шапку).
Функция КорниЗависимостей()

	Результат = Новый Соответствие();

	ОтборЗависимостей = Новый РегулярноеВыражение("\.ЗависитОт\(""([^""]+)""");
	Для Каждого Совпадение Из ОтборЗависимостей.НайтиСовпадения(ТекстМанифеста) Цикл
		Результат.Вставить(Совпадение.Группы[1].Значение, Истина);
	КонецЦикла;

	Для Каждого Файл Из НайтиФайлы(ОбъединитьПути(КаталогПроекта, "src"), "*.os", Истина) Цикл
		Для Каждого Имя Из ИменаИзТекстаИсходника(ПрочитатьФайл(Файл.ПолноеИмя)) Цикл
			Результат.Вставить(Имя, Истина);
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Библиотеки из директив #Использовать. Директива значима только в начале строки, поэтому
// закомментированная ("// #Использовать …") сюда не попадает — это закрыто самотестом.
Функция ИменаИзТекстаИсходника(Знач Текст)

	Результат = Новый Массив();
	Отбор = Новый РегулярноеВыражение("(?m)^[ \t]*#Использовать\s+([\w\-\.]+)");

	Для Каждого Совпадение Из Отбор.НайтиСовпадения(Текст) Цикл
		Результат.Добавить(Совпадение.Группы[1].Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Транзитивное закрытие корней по РАНТАЙМ-объявлениям opm-metadata.xml: dev-зависимости
// (oneunit, coverage, 1bdd) в рантайме хаба не участвуют и в поставку не едут.
Функция ЗакрытиеЗависимостей()
	Возврат ОбойтиЗакрытие(Новый Массив());
КонецФункции

// Рантайм-зависимости закрытия, которых нет в oscript_modules: закрытие на них обрывается.
Функция НеустановленныеЗависимости()

	Пропавшие = Новый Массив();
	ОбойтиЗакрытие(Пропавшие);

	Возврат Пропавшие;

КонецФункции

// Обход закрытия от корней; неразрешённые имена складываются в Пропавшие.
Функция ОбойтиЗакрытие(Пропавшие)

	Установленные = ЗависимостиУстановленных();
	Результат = Новый Соответствие();

	Очередь = Новый Массив();
	Для Каждого КлючЗначение Из КорниЗависимостей() Цикл
		Очередь.Добавить(КлючЗначение.Ключ);
	КонецЦикла;

	Пока Очередь.Количество() > 0 Цикл

		Имя = Очередь[Очередь.ВГраница()];
		Очередь.Удалить(Очередь.ВГраница());

		Если Результат.Получить(Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Объявленные = Установленные.Получить(Имя);
		Если Объявленные = Неопределено Тогда
			Пропавшие.Добавить(Имя);
			Продолжить;
		КонецЕсли;

		Результат.Вставить(Имя, Истина);
		Для Каждого Зависимость Из Объявленные Цикл
			Очередь.Добавить(Зависимость);
		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Соответствие "имя установленной библиотеки" -> Массив имён её РАНТАЙМ-зависимостей
// (объявления с dev="true" отброшены).
Функция ЗависимостиУстановленных()

	Результат = Новый Соответствие();
	Отбор = Новый РегулярноеВыражение("<depends-on\s+([^>]*)/?>");
	ОтборИмени = Новый РегулярноеВыражение("name=""([^""]+)""");

	Для Каждого Каталог Из НайтиФайлы(КаталогМодулей, "*", Ложь) Цикл

		Если НЕ Каталог.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;

		Метаданные = Новый Файл(ОбъединитьПути(Каталог.ПолноеИмя, "opm-metadata.xml"));
		Если НЕ Метаданные.Существует() Тогда
			Продолжить;
		КонецЕсли;

		Зависимости = Новый Массив();
		Для Каждого Совпадение Из Отбор.НайтиСовпадения(ПрочитатьФайл(Метаданные.ПолноеИмя)) Цикл
			Атрибуты = Совпадение.Группы[1].Значение;
			Если СтрНайти(Атрибуты, "dev=""true""") > 0 Тогда
				Продолжить;
			КонецЕсли;
			Имена = ОтборИмени.НайтиСовпадения(Атрибуты);
			Если Имена.Количество() > 0 Тогда
				Зависимости.Добавить(Имена[0].Группы[1].Значение);
			КонецЕсли;
		КонецЦикла;

		Результат.Вставить(Каталог.Имя, Зависимости);

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Отсортированный(Знач Имена)

	Список = Новый СписокЗначений();
	Список.ЗагрузитьЗначения(Имена);
	Список.СортироватьПоЗначению();

	Результат = Новый Массив();
	Для Каждого Элемент Из Список Цикл
		Результат.Добавить(Элемент.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПрочитатьФайл(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Содержимое = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат ?(Содержимое = Неопределено, "", Содержимое);

КонецФункции

#КонецОбласти
