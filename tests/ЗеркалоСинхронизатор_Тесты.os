// Счётчик занятого места пула, как его читают экраны и гейт квоты.
Функция ЗанятоПулом(Знач Пул)
	Запись = Поделка.НайтиЖелудь("ХранилищеПулов").ПолучитьОдноПоИдентификаторРавно(
		Цел(Пул.Идентификатор));
	Возврат Поделка.НайтиЖелудь("СервисПулов").ЗанятоБайт(Запись);
КонецФункции

Функция Издатель()
	Возврат Поделка.НайтиЖелудь("ИздательСобытий");
КонецФункции

Процедура ПодключитьКлассыКаталога(Знач КаталогКлассов)
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		Если НЕ ТипЗарегистрирован(ФайлКласса.ИмяБезРасширения) Тогда
			ПодключитьСценарий(ФайлКласса.ПолноеИмя, ФайлКласса.ИмяБезРасширения);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Класс ищется по имени в каталоге и его подкаталогах: путь к файлу из имени не строится
// (docs/процесс/РАСКЛАДКА.md).
Процедура Подключить(Знач КаталогКлассов, Знач Имя)
	ПоискКлассов.Подключить(КаталогКлассов, Имя);
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub");
КонецФункции

// Настройки подписок для прямой сборки вне контейнера — умолчания реестра.
Функция НастройкиПодписок()
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПодписки();
	Возврат Настройки;
КонецФункции
