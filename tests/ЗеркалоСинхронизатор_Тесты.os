// Интеграционные тесты СинхронизатораЗеркал на реальных бинах и фейковом источнике апстрима:
// инкрементальность, идемпотентность, недоверенный .ospx, изоляция сбоев, лимиты, SSRF, аудит,
// перенос состава зависимостей обеими ветками индексации.

#Использовать asserts
#Использовать autumn-logos
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать ospx-tools
#Использовать "фикстуры"

Перем Поделка;
Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем КореньДанных;
Перем КаталогOspx;
Перем НомерПула;
Перем Разрешитель_; // ФейкРазрешительImён — конфигурируется тестом SSRF-ре-валидации

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("данные", "Классы")));
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("настройки", "Классы")));
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("хранилище", "Классы")));
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("реестр", "Классы")));
	// описания: README привезённого пакета кладёт на диск приём версии
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("описания", "Классы")));
	Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ПриведениеЧисел");
	Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ТекстОшибки");
	Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "РазборАдреса");
	Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ТихаяУборка");
	Подключить(ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь,
		"фикстуры"), "НастройкиЗаглушка");

	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("события", "Классы")));
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("аудит", "Классы")));
	Попытка
		Подключить(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы"), "ГотовностьХаба");
	Исключение
	КонецПопытки;
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы")));

	Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "ДроссельПрогресса");
	Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "ЧислаЗеркалирования");
	Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "СчётчикиОбхода");
	Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "СрезОбхода");
	Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "РазборНастроекЗеркала");
	Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "СледЦиклаЗеркала");
	Подключить(ОбъединитьПути(КаталогМодулей, "прокси", "Классы"), "СтражАпстримов");
	Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "ОтметкаПеречисления");
	Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "ПределыПриёмаПакета");
	Подключить(ОбъединитьПути(КаталогМодулей, "публикация", "Классы"), "МестоВПуле");
	Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "ПрогонЗеркала");
	Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "ПереносЭлементаСинка");
	Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "СинхронизаторЗеркал");
	Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "РазборПакетовЗеркала");
	Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "ВалидаторАдресаАпстрима");
	Подключить(ОбъединитьПути(КаталогМодулей, "подписки", "Классы"), "ВалидаторАдресаВебхука");

	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	Подключить(Фикстуры, "ФейкИсточникЗеркала");
	Подключить(Фикстуры, "ФейкСервисЗеркалСинк");
	Подключить(Фикстуры, "ФикстураПакета");
	Подключить(Фикстуры, "ФейкРазрешительImён");
	Подключить(Фикстуры, "НаблюдательПрогонаЗеркала");
	Подключить(Фикстуры, "ЛовушкаЛога");
	Подключить(Фикстуры, "НастройкиЗаглушка");
	Подключить(Фикстуры, "СчётчикОтметок");

	КореньДанных = ОбъединитьПути(КаталогВременныхФайлов(), "oshub-mirror-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньДанных);
	КаталогOspx = ОбъединитьПути(КореньДанных, "ospx");
	СоздатьКаталог(КаталогOspx);
	НомерПула = 0;
	Разрешитель_ = Новый ФейкРазрешительImён();

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", КореньДанных);
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "зеркало-синк-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	// Служба и очередь — ПОСЛЕ старта контейнера: собираются руками поверх его хранилища,
	// а желудями в этот контейнер не заезжают (СервисПрав модуля auth в нём нет).
	Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"), "СервисЗеркал");
	Подключить(ОбъединитьПути(КаталогМодулей, "зеркала", "Классы"),
		"ОчередьСинхронизацииЗеркал");
	Подключить(Фикстуры, "ФейкСервисПрав");

КонецПроцедуры

&ПослеВсех
Процедура УбратьКорень() Экспорт
	Если ЗначениеЗаполнено(КореньДанных) И Новый Файл(КореньДанных).Существует() Тогда
		УдалитьФайлы(КореньДанных);
	КонецЕсли;
КонецПроцедуры

&Тест
Процедура ИнкрементальностьИИдемпотентность() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("pkgi", "1.0.0", 200, Ospx("pkgi", "1.0.0"));
	Синх = НовыйСинхронизатор(Источник);

	Итог1 = Синх.Синхронизировать(Зеркало(Пул.Идентификатор));
	Ожидаем.Что(Итог1.Скачано, "первый синк скачал версию").Равно(1);
	Ожидаем.Что(Хранилище().Существует(Новый КоординатыАртефакта(Пул.Имя, "pkgi", "1.0.0")),
		"артефакт в хранилище").ЭтоИстина();
	Ожидаем.Что(ВерсийПакета(Пул, "pkgi"), "версия проиндексирована").Равно(1);

	// зеркалированные байты занимают место пула наравне со своими публикациями;
	// описание версии лежит там же и считается тем же счётчиком
	Размер = Хранилище().Размер(Новый КоординатыАртефакта(Пул.Имя, "pkgi", "1.0.0"));
	Ожидаем.Что(ЗанятоПулом(Пул), "скачанное зеркалом учтено в занятом месте пула")
		.Равно(Размер + РазмерОписания(Пул, "pkgi", "1.0.0"));

	Итог2 = Синх.Синхронизировать(Зеркало(Пул.Идентификатор));
	Ожидаем.Что(Итог2.Скачано, "повторный синк не скачивает").Равно(0);
	Ожидаем.Что(Итог2.Пропущено, "существующая версия пропущена").Равно(1);
	Ожидаем.Что(Источник.КоличествоСкачиваний(), "известная существующая версия не перекачана").Равно(1);
	Ожидаем.Что(ВерсийПакета(Пул, "pkgi"), "дублей версий нет").Равно(1);
	Ожидаем.Что(ЗанятоПулом(Пул), "повторный синк ничего не дописал и счётчик не раздул")
		.Равно(Размер + РазмерОписания(Пул, "pkgi", "1.0.0"));

КонецПроцедуры

&Тест
Процедура НедоверенныйБитыйOspxНеСохраняется() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("badpkg", "1.0.0", 200, ПолучитьДвоичныеДанныеИзСтроки("это точно не zip-архив"));
	Синх = НовыйСинхронизатор(Источник);

	Итог = Синх.Синхронизировать(Зеркало(Пул.Идентификатор));
	Ожидаем.Что(Итог.Скачано, "битый .ospx не сохранён").Равно(0);
	Ожидаем.Что(Итог.Пропущено, "битый .ospx пропущен").Равно(1);
	Ожидаем.Что(Хранилище().Существует(Новый КоординатыАртефакта(Пул.Имя, "badpkg", "1.0.0")),
		"битый артефакт отсутствует").ЭтоЛожь();
	Ожидаем.Что(СервисПакетов().НайтиПакет(Пул.Идентификатор, "badpkg"),
		"битый пакет не индексируется").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СбойПакетаИзолированОтОстальных() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("okpkg", "1.0.0", 200, Ospx("okpkg", "1.0.0"));
	Источник.ДобавитьВерсию("boom", "1.0.0", 200, Ospx("boom", "1.0.0"));
	Источник.ОтметитьСбой("boom", "1.0.0"); // скачивание бросит исключение
	Синх = НовыйСинхронизатор(Источник);

	Итог = Синх.Синхронизировать(Зеркало(Пул.Идентификатор));
	Ожидаем.Что(Итог.Ошибок, "сбой boom учтён").Равно(1);
	Ожидаем.Что(Итог.Скачано, "okpkg скачан несмотря на сбой boom").Равно(1);
	Ожидаем.Что(Хранилище().Существует(Новый КоординатыАртефакта(Пул.Имя, "okpkg", "1.0.0")),
		"okpkg сохранён").ЭтоИстина();

КонецПроцедуры

// Номер версии не пересекается с именем тега, и апстрим об этом не знает: привезённая версия,
// одноимённая тегу пула назначения, в реестр не берётся. Отказ — НЕУСТРАНИМЫЙ, и вести себя он
// обязан как любой сбой пакета: обход идёт дальше, соседи скачиваются, файла без индекса не остаётся.
&Тест
Процедура ВерсияСИменемТегаПулаНеБерётсяИОбходНеПадает() Экспорт

	Пул = НовыйLocalПул();
	// «1.4» — уже имя тега в этом пуле: мейнтейнер завёл его на привезённой раньше версии
	Первый = Новый ФейкИсточникЗеркала();
	Первый.ДобавитьВерсию("clashpkg", "1.4.0", 200, Ospx("clashpkg", "1.4.0"));
	НовыйСинхронизатор(Первый).Синхронизировать(Зеркало(Пул.Идентификатор));
	ПакетИд = СервисПакетов().НайтиПакет(Пул.Идентификатор, "clashpkg").Идентификатор;
	СервисТегов().ПереместитьТег(ПакетИд, "1.4", "1.4.0");

	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("clashpkg", "1.4", 200, Ospx("clashpkg", "1.4"));
	Источник.ДобавитьВерсию("okpkg", "1.0.0", 200, Ospx("okpkg", "1.0.0"));

	Итог = НовыйСинхронизатор(Источник).Синхронизировать(Зеркало(Пул.Идентификатор));

	Ожидаем.Что(Итог.Ошибок, "столкновение имён учтено сбоем пакета").Равно(1);
	Ожидаем.Что(Итог.Скачано, "сосед по обходу скачан").Равно(1);
	Ожидаем.Что(Хранилище().Существует(Новый КоординатыАртефакта(Пул.Имя, "okpkg", "1.0.0")),
		"okpkg сохранён").ЭтоИстина();

	Ожидаем.Что(СервисВерсий().НайтиВерсию(ПакетИд, "1.4"), "версия «1.4» не проиндексирована").Равно(Неопределено);
	Ожидаем.Что(Хранилище().Существует(Новый КоординатыАртефакта(Пул.Имя, "clashpkg", "1.4")),
		"артефакт откачен: файла без индекса не осталось").ЭтоЛожь();
	Ожидаем.Что(СервисТегов().РазрешитьВерсиюТега(
		СервисПакетов().НайтиПакет(Пул.Идентификатор, "clashpkg"), "1.4").Версия,
		"тег «1.4» остался достижимым").Равно("1.4.0");

КонецПроцедуры

&Тест
Процедура ИммутабельностьНеПерезаписываетВерсию() Экспорт

	Пул = НовыйLocalПул();
	Первый = Новый ФейкИсточникЗеркала();
	Первый.ДобавитьВерсию("immut", "1.0.0", 200, Ospx("immut", "1.0.0"));
	НовыйСинхронизатор(Первый).Синхронизировать(Зеркало(Пул.Идентификатор));

	ПакетИд = СервисПакетов().НайтиПакет(Пул.Идентификатор, "immut").Идентификатор;
	ShaДо = СервисВерсий().НайтиВерсию(ПакетИд, "1.0.0").Sha256;

	Второй = Новый ФейкИсточникЗеркала();
	Второй.ДобавитьВерсию("immut", "1.0.0", 200, Ospx2("immut", "1.0.0"));
	Итог = НовыйСинхронизатор(Второй).Синхронизировать(Зеркало(Пул.Идентификатор));

	Ожидаем.Что(Итог.Скачано, "существующая версия не перекачана").Равно(0);
	Ожидаем.Что(Второй.КоличествоСкачиваний(), "известная версия не скачивалась вовсе").Равно(0);
	Ожидаем.Что(СервисВерсий().НайтиВерсию(ПакетИд, "1.0.0").Sha256, "sha версии не изменился").Равно(ShaДо);

КонецПроцедуры

&Тест
Процедура OfflineАпстримНеФейлитСинк() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.УстановитьКодПеречисления(0); // апстрим недоступен
	Источник.ДобавитьВерсию("pkgo", "1.0.0", 200, Ospx("pkgo", "1.0.0"));
	Синх = НовыйСинхронизатор(Источник);

	Итог = Синх.Синхронизировать(Зеркало(Пул.Идентификатор));
	Ожидаем.Что(Итог.Offline, "апстрим отмечен offline").ЭтоИстина();
	Ожидаем.Что(Итог.Скачано, "ничего не скачано offline").Равно(0);
	Ожидаем.Что(Хранилище().Существует(Новый КоординатыАртефакта(Пул.Имя, "pkgo", "1.0.0")),
		"offline — артефакта нет").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура РазмерныйЛимитОтсекает() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("bigpkg", "1.0.0", 200, Ospx("bigpkg", "1.0.0"));
	Синх = НовыйСинхронизаторСЛимитом(Источник, 10); // 10 байт — заведомо меньше .ospx

	Итог = Синх.Синхронизировать(Зеркало(Пул.Идентификатор));
	Ожидаем.Что(Итог.Скачано, "превышение лимита размера — не сохранён").Равно(0);
	Ожидаем.Что(Итог.Пропущено, "превышение лимита размера — пропущен").Равно(1);

КонецПроцедуры

&Тест
Процедура LatestБерётВерсиюИзМанифеста() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьLatest("late", 200, Ospx("late", "2.5.0")); // версия неизвестна из списка
	Синх = НовыйСинхронизатор(Источник);

	Итог = Синх.Синхронизировать(Зеркало(Пул.Идентификатор));
	Ожидаем.Что(Итог.Скачано, "latest скачан").Равно(1);
	Ожидаем.Что(Хранилище().Существует(Новый КоординатыАртефакта(Пул.Имя, "late", "2.5.0")),
		"версия из манифеста сохранена").ЭтоИстина();
	Ожидаем.Что(ВерсийПакета(Пул, "late"), "версия проиндексирована").Равно(1);

КонецПроцедуры

// Зеркалирование зовёт ту же ИндексироватьВнешнюю, что и прокси: до починки версия
// SNAPSHOT роняла индексацию, и синхронизатор откатывал уже скачанный артефакт.
&Тест
Процедура SNAPSHOTЗеркалируетсяНоПоследнейНеСтановится() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("dash-mir-pkg", "1.0.0", 200, Ospx("dash-mir-pkg", "1.0.0"));
	Источник.ДобавитьВерсию("dash-mir-pkg", "SNAPSHOT", 200, Ospx("dash-mir-pkg", "SNAPSHOT"));
	Синх = НовыйСинхронизатор(Источник);

	Итог = Синх.Синхронизировать(Зеркало(Пул.Идентификатор));

	Ожидаем.Что(Итог.Ошибок, "сбоев индексации нет").Равно(0);
	Ожидаем.Что(Итог.Скачано, "скачаны обе версии").Равно(2);
	Ожидаем.Что(Хранилище().Существует(Новый КоординатыАртефакта(Пул.Имя, "dash-mir-pkg", "SNAPSHOT")),
		"артефакт снапшота не откачен").ЭтоИстина();
	Ожидаем.Что(ВерсийПакета(Пул, "dash-mir-pkg"), "проиндексированы обе").Равно(2);

	Пакет = СервисПакетов().НайтиПакет(Пул.Идентификатор, "dash-mir-pkg");
	Ожидаем.Что(СервисВерсий().НайтиВерсию(Пакет.Идентификатор, "SNAPSHOT").ПризнакВнеПорядка,
		"снапшот вне semver-порядка").Равно(Истина);
	Ожидаем.Что(СервисВерсий().ПоследняяВерсия(Пакет.Идентификатор).Версия,
		"последней остаётся релиз").Равно("1.0.0");

КонецПроцедуры

&Тест
Процедура СинкЭмититСобытиеВАудит() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("audpkg", "1.0.0", 200, Ospx("audpkg", "1.0.0"));
	НовыйСинхронизатор(Источник).Синхронизировать(Зеркало(Пул.Идентификатор));

	Записи = ЗаписиСинкаПула(Пул);
	Ожидаем.Что(Записи.Количество(), "итог обхода попал в журнал аудита через событие").Равно(1);

	Адрес = Строка(Записи[0].Объект);
	// сеть, независимая от текста исходников: адрес обязан держать форму журнала
	Ожидаем.Что(ИменаАудита().ЭтоАдресЖурнала(Адрес),
		"адрес пула в журнале держит форму: " + Адрес).ЭтоИстина();
	Ожидаем.Что(Адрес, "и это именно адрес пула").Равно(ИменаАудита().ПулПоИмени(Пул.Имя));

КонецПроцедуры

// Дефект боевой инсталляции: журнал показывал «синхронизацию зеркала» несколько раз в минуту
// при часовом интервале. Событие уходило на каждую ПОРЦИЮ, а недочитанное зеркало рабочий
// очереди возвращает в работу сразу — порции шли встык и топили журнал.
&Тест
Процедура ОбходИзНесколькихПорцийДаётОднуЗаписьАудита() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("chunk-pkg", "1.0.0", 200, Ospx("chunk-pkg", "1.0.0"));
	Источник.УстановитьХвост(Истина, "chunk-pkg");
	Синх = НовыйСинхронизатор(Источник);
	ЗаписьЗеркала = Зеркало(Пул.Идентификатор);

	Синх.Синхронизировать(ЗаписьЗеркала);
	Ожидаем.Что(ЗаписиСинкаПула(Пул).Количество(),
		"порция оставила хвост — обход не закрыт, записи нет").Равно(0);
	Синх.Синхронизировать(ЗаписьЗеркала);
	Ожидаем.Что(ЗаписиСинкаПула(Пул).Количество(),
		"вторая порция журнала тоже не касается").Равно(0);

	Источник.УстановитьХвост(Ложь);
	Синх.Синхронизировать(ЗаписьЗеркала);

	Записи = ЗаписиСинкаПула(Пул);
	Ожидаем.Что(Записи.Количество(), "закрытый обход дал ровно одну запись").Равно(1);

	Детали = ДеталиЗаписи(Записи[0]);
	Ожидаем.Что(Детали.Получить("состояние"), "обход закрыт завершением").Равно("завершён");
	Ожидаем.Что(Детали.Получить("статус"), "и словами сказано, чем он кончился").Содержит("синк ок");
	Ожидаем.Что(Детали.Получить("всего"),
		"в записи числа всего обхода, а не последней его порции").Равно(3);
	Ожидаем.Что(Детали.Получить("скачано"), "скачанное первой порцией из итога не пропало").Равно(1);
	Ожидаем.Что(Детали.Получить("пропущено"), "пропущенное двумя порциями сложилось").Равно(2);

КонецПроцедуры

// Апстрим не ответил — обход всё равно закрывается «завершён» с нулями, и по одним числам
// он неотличим от удачного прохода. Отличают его слова статуса: без них журнал утверждал бы,
// что зеркало синхронизировалось, хотя оно даже не сходило.
&Тест
Процедура НеответившийАпстримВЖурналеНеВыдаётСебяЗаУдачныйСинк() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.УстановитьКодПеречисления(0);

	НовыйСинхронизатор(Источник).Синхронизировать(Зеркало(Пул.Идентификатор));

	Записи = ЗаписиСинкаПула(Пул);
	Ожидаем.Что(Записи.Количество(), "обход закрыт и потому назван в журнале").Равно(1);

	Детали = ДеталиЗаписи(Записи[0]);
	Ожидаем.Что(Детали.Получить("статус"), "в записи сказано, что апстрим не ответил")
		.Содержит("апстрим недоступен");
	Ожидаем.Что(Детали.Получить("всего"), "и что не привезено ничего").Равно(0);

КонецПроцедуры

// Пустой апстрим — законный исход, а не отсутствие работы: обход закрыт, запись одна,
// и её статус отличает «сходили, брать нечего» от «сходить не смогли».
&Тест
Процедура ОбходБезЕдинойВерсииЗакрываетсяЗаписьюСоСтатусом() Экспорт

	Пул = НовыйLocalПул();

	НовыйСинхронизатор(Новый ФейкИсточникЗеркала()).Синхронизировать(Зеркало(Пул.Идентификатор));

	Записи = ЗаписиСинкаПула(Пул);
	Ожидаем.Что(Записи.Количество(), "пустой обход — тоже закрытый обход").Равно(1);

	Детали = ДеталиЗаписи(Записи[0]);
	Ожидаем.Что(Детали.Получить("статус"), "апстрим ответил, брать было нечего")
		.Содержит("синк ок");
	Ожидаем.Что(Детали.Получить("всего"), "и в обходе ни одного элемента").Равно(0);

КонецПроцедуры

// Оборванный сбоем обход — тоже закрытый обход: он ждёт своего интервала, журнал им
// не топится, а зеркало, падающее каждый час, обязано оставлять след — иначе разбирать
// инцидент администратору не по чему.
&Тест
Процедура ОбходОборванныйОшибкойНазываетСебяВЖурнале() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.УстановитьСбойПеречисления("апстрим оборвал перечисление");

	Итог = НовыйСинхронизатор(Источник).Синхронизировать(Зеркало(Пул.Идентификатор));

	Ожидаем.Что(Итог.Статус, "цикл упал целиком").Содержит("ошибка синхронизации");
	Записи = ЗаписиСинкаПула(Пул);
	Ожидаем.Что(Записи.Количество(), "оборванный обход дал одну запись").Равно(1);
	Ожидаем.Что(ДеталиЗаписи(Записи[0]).Получить("состояние"),
		"и назвал себя в журнале ошибкой, а не удачным синком").Равно("ошибка");

КонецПроцедуры

&Тест
Процедура СинхронизироватьВсеПеребираетВключённые() Экспорт

	ПулA = НовыйLocalПул();
	ПулB = НовыйLocalПул();

	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("multi", "1.0.0", 200, Ospx("multi", "1.0.0"));

	ЗеркалоA = Зеркало(ПулA.Идентификатор);
	ЗеркалоB = Зеркало(ПулB.Идентификатор);
	ФейкЗеркал = Новый ФейкСервисЗеркалСинк();
	ФейкЗеркал.Добавить(ЗеркалоA);
	ФейкЗеркал.Добавить(ЗеркалоB);

	Обработано = НовыйСинхронизаторНад(ФейкЗеркал, Источник).СинхронизироватьВсе();

	Ожидаем.Что(Обработано, "перебраны оба включённых зеркала").Равно(2);
	Ожидаем.Что(ЗначениеЗаполнено(Состояние(ЗеркалоA).Статус), "статус зеркала A записан").ЭтоИстина();
	Ожидаем.Что(ЗначениеЗаполнено(Состояние(ЗеркалоB).Статус), "статус зеркала B записан").ЭтоИстина();

КонецПроцедуры

// Своё расписание зеркала до этой волны хранилось, показывалось и не работало: джоб синкал
// всё подряд на общем интервале. Свежесинканное зеркало плановый прогон обязан пропустить.
&Тест
Процедура ПлановыйПрогонУважаетИнтервалЗеркала() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("sched", "1.0.0", 200, Ospx("sched", "1.0.0"));

	Частое = Зеркало(Пул.Идентификатор);
	Частое.ИнтервалСинкаСек = 60;
	Частое.ПоследнийСинк = ТекущаяУниверсальнаяДата() - 600;
	Частое.Сохранить();

	Редкое = Зеркало(Пул.Идентификатор);
	Редкое.ИнтервалСинкаСек = 86400;
	Редкое.ПоследнийСинк = ТекущаяУниверсальнаяДата() - 600;
	Редкое.Сохранить();

	ФейкЗеркал = Новый ФейкСервисЗеркалСинк();
	ФейкЗеркал.Добавить(Частое);
	ФейкЗеркал.Добавить(Редкое);

	Обработано = НовыйСинхронизаторНад(ФейкЗеркал, Источник).СинхронизироватьВсе();

	Ожидаем.Что(Обработано, "синкнуто одно зеркало — то, чей интервал истёк").Равно(1);
	Ожидаем.Что(Состояние(Частое).Состояние, "зеркало с интервалом 60 с синкнуто").Равно("завершён");
	Ожидаем.Что(Состояние(Редкое).Состояние, "зеркало с суточным интервалом не тронуто")
		.Равно("простаивает");

КонецПроцедуры

// Незаконченный обход интервала не ждёт: иначе хвост апстрима догонялся бы по порции в час.
&Тест
Процедура НезаконченныйОбходПродолжаетсяНеЖдяИнтервала() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("tail", "1.0.0", 200, Ospx("tail", "1.0.0"));

	// так обход выглядит между порциями: курсор указывает на продолжение, состояние — поставлено
	Незаконченное = Зеркало(Пул.Идентификатор);
	Незаконченное.ИнтервалСинкаСек = 86400;
	Незаконченное.ПоследнийСинк = ТекущаяУниверсальнаяДата() - 60;
	Незаконченное.ПрогонКурсор = "tail";
	Незаконченное.СостояниеПрогона = "поставлено";
	Незаконченное.ПрогонОбновлён = ТекущаяУниверсальнаяДата();
	Незаконченное.Сохранить();

	ФейкЗеркал = Новый ФейкСервисЗеркалСинк();
	ФейкЗеркал.Добавить(Незаконченное);

	Обработано = НовыйСинхронизаторНад(ФейкЗеркал, Источник).СинхронизироватьВсе();

	Ожидаем.Что(Обработано, "обход с непустым курсором продолжен").Равно(1);
	Ожидаем.Что(Источник.ПолученныеКурсоры()[0], "продолжили ровно с сохранённого имени").Равно("tail");

КонецПроцедуры

// --- прогон: прогресс по ходу, курсор, защита от двойного запуска ---

// До этой волны итог писался ОДИН РАЗ в конце, и всё время синка экран показывал статус
// прошлого прогона: «нет информации о прогрессе» из жалобы владельца.
&Тест
Процедура ПрогрессВиденПокаЦиклИдёт() Экспорт

	Пул = НовыйLocalПул();
	Источник = ИсточникСВерсиями("progr", 12);
	ЗеркалоЗапись = Зеркало(Пул.Идентификатор);
	Наблюдатель = Новый НаблюдательПрогонаЗеркала(Прогон(), ЗеркалоЗапись, 12);
	Источник.ЗадатьНаблюдателя(Наблюдатель);

	Итог = НовыйСинхронизатор(Источник).Синхронизировать(ЗеркалоЗапись);

	Снято = Наблюдатель.Состояние();
	Ожидаем.Что(Снято, "состояние снято прямо посреди цикла").Существует();
	Ожидаем.Что(Снято.Состояние, "во время цикла зеркало помечено идущим").Равно("идёт");
	Ожидаем.Что(Снято.Идёт, "признак «идёт сейчас» поднят").ЭтоИстина();
	// инвариант — «дописан ПО ХОДУ, а не в конце»: посреди цикла в записи уже есть скачанное,
	// но ещё не всё. Точное число зависит от темпа дросселя и предметом сторожа не является.
	Ожидаем.Что(Снято.Скачано > 0 И Снято.Скачано < 12,
		СтрШаблон("прогресс дописан ПО ХОДУ, а не в конце: скачано %1 из 12", Снято.Скачано))
		.ЭтоИстина();

	Ожидаем.Что(Итог.Скачано, "цикл довёл дело до конца").Равно(12);
	Ожидаем.Что(Состояние(ЗеркалоЗапись).Состояние, "по завершении прогон закрыт").Равно("завершён");
	Ожидаем.Что(Состояние(ЗеркалоЗапись).Скачано, "итоговые счётчики дописаны").Равно(12);
	Ожидаем.Что(Состояние(ЗеркалоЗапись).Идёт, "и признак «идёт» снят").ЭтоЛожь();

КонецПроцедуры

// Предел приёма один на весь хаб: зеркало судится тем же oshub.publish.max_upload_bytes,
// что и публикация снаружи, и своего числа у него нет. Отказ называет и предел, и ключ —
// иначе оператор ищет вторую крутилку, которой не существует.
&Тест
Процедура ПределРазмераУЗеркалаТотЖеЧтоУПубликации() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("bigpkg", "1.0.0", 200, Ospx("bigpkg", "1.0.0"));
	Синх = НовыйСинхронизаторНад(Новый ФейкСервисЗеркалСинк(), Источник, 10, ЛогСЛовушкой(Ловушка));

	Итог = Синх.Синхронизировать(Зеркало(Пул.Идентификатор));

	Ожидаем.Что(Итог.Скачано, "пакет сверх предела приёма не сохранён").Равно(0);
	Ожидаем.Что(Ловушка.Всё(), "отказ называет ключ предела: " + Ловушка.Всё())
		.Содержит("oshub.publish.max_upload_bytes");
	Ожидаем.Что(Ловушка.Всё(), "и само число предела").Содержит("10 байт");

КонецПроцедуры

// Квота пула — единственный размерный предел сверх чисел приёма, и на пути зеркалирования
// её не спрашивали вовсе: пул набивался приезжающим до отказа диска.
&Тест
Процедура ПакетСверхКвотыПулаВПулНеПопадает() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Пул = ПулСКвотойМб(1);
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("quotapkg", "1.0.0", 200, Ospx("quotapkg", "1.0.0"));
	Синх = НовыйСинхронизаторНад(Новый ФейкСервисЗеркалСинк(), Источник, 26214400,
		ЛогСЛовушкой(Ловушка));

	ЗанятьПулПодЗавязку(Пул);
	Итог = Синх.Синхронизировать(Зеркало(Пул.Идентификатор));

	Ожидаем.Что(Итог.Скачано, "в переполненный пул приезжающее не кладётся").Равно(0);
	Ожидаем.Что(Итог.Пропущено, "пакет пропущен, а прогон не отменён").Равно(1);
	Ожидаем.Что(Хранилище().Существует(Новый КоординатыАртефакта(Пул.Имя, "quotapkg", "1.0.0")),
		"артефакта в хранилище нет").ЭтоЛожь();
	Ожидаем.Что(Ловушка.Всё(), "отказ называет квоту: " + Ловушка.Всё()).Содержит("Квота пула");

КонецПроцедуры

// Пока цикл перечисляет порцию, прогон обязан подавать признаки жизни: без отметки внутри
// перечисления живой обход молчал (порция + 1) × таймаут и объявлялся брошенным.
&Тест
Процедура ПеречислениеПорцииОтмечаетсяВЗаписи() Экспорт

	Пул = НовыйLocalПул();
	Источник = ИсточникСВерсиями("mark", 3);
	ЗеркалоЗапись = Зеркало(Пул.Идентификатор);
	Отметка = Новый СчётчикОтметок();

	Прогон().Занять(ЗеркалоЗапись.Идентификатор);
	Источник.Перечислить(ЗеркалоЗапись, 25, "", Отметка);

	Ожидаем.Что(Отметка.Шагов() > 0,
		"источник отмечает живость на каждом перечисленном имени").ЭтоИстина();

КонецПроцедуры

// Шкала обхода немонотонной быть не имеет права: владелец судит по ней, жив ли прогон.
// Знаменатель «обработано + перечисленное порцией» упирался в сто процентов на конце
// каждого цикла и падал в начале следующего.
&Тест
Процедура ШкалаОбходаНеЕдетНазадМеждуЦиклами() Экспорт

	Пул = НовыйLocalПул();
	Источник = ИсточникСВерсиями("scale", 4);
	Источник.УстановитьХвост(Истина, "scale-next");
	Источник.ЗадатьШкалуИмён(10, 0);
	ЗеркалоЗапись = Зеркало(Пул.Идентификатор);
	Синх = НовыйСинхронизатор(Источник);

	Первый = Синх.Синхронизировать(ЗеркалоЗапись);
	ПослеПервого = Состояние(ЗеркалоЗапись);

	Источник.ЗадатьШкалуИмён(10, ПослеПервого.ИмёнПройдено);
	Второй = Синх.Синхронизировать(ЗеркалоЗапись);
	ПослеВторого = Состояние(ЗеркалоЗапись);

	Ожидаем.Что(Первый.ИмёнВсего, "знаменатель — ИМЕНА апстрима, а не версии порции").Равно(10);
	Ожидаем.Что(ПослеПервого.ИмёнПройдено > 0, "первый цикл сдвинул шкалу").ЭтоИстина();
	Ожидаем.Что(ПослеВторого.ИмёнПройдено >= ПослеПервого.ИмёнПройдено,
		СтрШаблон("шкала не едет назад: было %1, стало %2",
			ПослеПервого.ИмёнПройдено, ПослеВторого.ИмёнПройдено)).ЭтоИстина();
	Ожидаем.Что(ПослеВторого.ИмёнВсего, "знаменатель между циклами не скачет").Равно(10);
	Ожидаем.Что(Второй.Всего > 0, "версии при этом переносятся").ЭтоИстина();

КонецПроцедуры

// Имя считается пройденным ровно ОДИН раз и только когда его версии кончились: иначе
// шкала обгоняет обход и упирается в сто процентов раньше, чем обход дошёл до конца.
&Тест
Процедура ИмяСчитаетсяПройденнымОдинРазИПослеСвоихВерсий() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Для Каждого Имя Из СтрРазделить("one,two", ",") Цикл
		Для Каждого Версия Из СтрРазделить("1.0.0,1.0.1", ",") Цикл
			Источник.ДобавитьВерсию(Имя, Версия, 200, Ospx(Имя, Версия));
		КонецЦикла;
	КонецЦикла;
	Источник.ЗадатьШкалуИмён(7, 3); // три имени пройдено прошлыми циклами

	Итог = НовыйСинхронизатор(Источник).Синхронизировать(Зеркало(Пул.Идентификатор));

	Ожидаем.Что(Итог.Всего, "порция дала четыре элемента синка").Равно(4);
	Ожидаем.Что(Итог.ИмёнПройдено,
		"два имени по две версии добавили РОВНО два к пройденным").Равно(5);
	Ожидаем.Что(Итог.ИмёнВсего, "знаменатель — весь список апстрима").Равно(7);

КонецПроцедуры

// Оборванная порция недоделанное имя пройденным не считает: иначе продолжение с курсора
// прошло бы его второй раз, а шкала уже отчиталась.
&Тест
Процедура НедоделанноеИмяПройденнымНеСчитается() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("alfa", "1.0.0", 200, Ospx("alfa", "1.0.0"));
	Источник.ДобавитьВерсию("beta", "1.0.0", 0, Неопределено); // апстрим отвалился на beta
	Источник.ЗадатьШкалуИмён(5, 0);

	Итог = НовыйСинхронизатор(Источник).Синхронизировать(Зеркало(Пул.Идентификатор));

	Ожидаем.Что(Итог.Offline, "апстрим отвалился посреди порции").ЭтоИстина();
	Ожидаем.Что(Итог.ИмёнПройдено,
		"пройденным считается только доделанное имя").Равно(1);

КонецПроцедуры

// Offline-цикл апстрим не считает — и уже показанную шкалу обнулять не вправе: иначе
// доля обхода падала бы в ноль от каждого сетевого сбоя.
&Тест
Процедура НесосчитанныйЦиклШкалуНеОбнуляет() Экспорт

	Пул = НовыйLocalПул();
	Источник = ИсточникСВерсиями("keep", 2);
	Источник.ЗадатьШкалуИмён(8, 3);
	// обход НЕ закончен: следующий цикл продолжает его, а не начинает новый
	Источник.УстановитьХвост(Истина, "keep-next");
	ЗеркалоЗапись = Зеркало(Пул.Идентификатор);
	Синх = НовыйСинхронизатор(Источник);
	Синх.Синхронизировать(ЗеркалоЗапись);
	ДоСбоя = Состояние(ЗеркалоЗапись).ИмёнВсего;

	Лежит = Новый ФейкИсточникЗеркала();
	Лежит.УстановитьКодПеречисления(0);
	НовыйСинхронизатор(Лежит).Синхронизировать(ЗеркалоЗапись);

	Ожидаем.Что(ДоСбоя, "первый цикл сосчитал апстрим").Равно(8);
	Ожидаем.Что(Состояние(ЗеркалоЗапись).ИмёнВсего,
		"недоступный апстрим шкалу не стирает").Равно(8);

КонецПроцедуры

// Отладка — единственный инструмент разбора у подсистемы без экрана. На уровне хаба её
// строк нет ни одной, при включённой видно: к кому шли, что ответили, по какому числу
// принято решение.
&Тест
Процедура ОтладкаСинхронизатораПоказываетДорожкуЦикла() Экспорт

	Пул = НовыйLocalПул();
	Источник = ИсточникСВерсиями("dbg", 2);
	Источник.ЗадатьШкалуИмён(5, 1);

	ПриИнформации = Новый ЛовушкаЛога();
	НовыйСинхронизаторНад(Новый ФейкСервисЗеркалСинк(), Источник, 26214400,
		ЛогУровня(ПриИнформации, УровниЛога.Информация)).Синхронизировать(Зеркало(Пул.Идентификатор));

	ПриОтладке = Новый ЛовушкаЛога();
	НовыйСинхронизаторНад(Новый ФейкСервисЗеркалСинк(), Источник, 26214400,
		ЛогУровня(ПриОтладке, УровниЛога.Отладка)).Синхронизировать(Зеркало(Пул.Идентификатор));

	Ожидаем.Что(СтрНайти(ПриИнформации.Всё(), "перечисляю порцию"),
		"на уровне хаба отладочных строк нет: " + ПриИнформации.Всё()).Равно(0);
	Ожидаем.Что(ПриОтладке.Всё(), "при отладке видно, что спросили: " + ПриОтладке.Всё())
		.Содержит("перечисляю порцию");
	Ожидаем.Что(ПриОтладке.Всё(), "по какому числу судили молчание прогона")
		.Содержит("порог молчания");
	Ожидаем.Что(ПриОтладке.Всё(), "и чем цикл кончился").Содержит("цикл закончен");

КонецПроцедуры

// Кнопка «синхронизировать сейчас» и расписание могут совпасть; защиты не было вовсе.
&Тест
Процедура ПовторныйЗапускПокаИдётОтклонён() Экспорт

	Пул = НовыйLocalПул();
	Источник = ИсточникСВерсиями("dbl", 3);
	ЗеркалоЗапись = Зеркало(Пул.Идентификатор);
	Синх = НовыйСинхронизатор(Источник);
	Наблюдатель = Новый НаблюдательПрогонаЗеркала(Прогон(), ЗеркалоЗапись, 2);
	Наблюдатель.ПробоватьПовторныйЗапуск(Синх);
	Источник.ЗадатьНаблюдателя(Наблюдатель);

	Итог = Синх.Синхронизировать(ЗеркалоЗапись);

	Повтор = Наблюдатель.ИтогПовторногоЗапуска();
	Ожидаем.Что(Повтор, "повторный запуск случился посреди цикла").Существует();
	Ожидаем.Что(НРег(Повтор.Статус), "повторный запуск отклонён").Содержит("уже идёт");
	Ожидаем.Что(Повтор.Скачано, "второй прогон ничего не качал").Равно(0);
	Ожидаем.Что(Итог.Скачано, "первый прогон отработал целиком").Равно(3);
	Ожидаем.Что(Источник.КоличествоСкачиваний(), "работа не удвоилась").Равно(3);

КонецПроцедуры

// Процесс может умереть с зеркалом в состоянии «идёт»: без отвисания такое зеркало
// не синхронизировалось бы больше никогда.
&Тест
Процедура БрошенныйПрогонПерехватываетсяСКурсора() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("stuck", "1.0.0", 200, Ospx("stuck", "1.0.0"));

	ЗеркалоЗапись = Зеркало(Пул.Идентификатор);
	ЗеркалоЗапись.СостояниеПрогона = "идёт";
	ЗеркалоЗапись.ПрогонОбновлён = ТекущаяУниверсальнаяДата() - 3600;
	ЗеркалоЗапись.ПрогонКурсор = "stuck";
	ЗеркалоЗапись.Сохранить();

	Итог = НовыйСинхронизатор(Источник).Синхронизировать(ЗеркалоЗапись);

	Ожидаем.Что(Итог.Скачано, "брошенный прогон перехвачен, цикл прошёл").Равно(1);
	Ожидаем.Что(Источник.ПолученныеКурсоры()[0], "перехват продолжил с курсора брошенного прогона")
		.Равно("stuck");

КонецПроцедуры

&Тест
Процедура СвежийИдущийПрогонНеПерехватывается() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("live", "1.0.0", 200, Ospx("live", "1.0.0"));

	ЗеркалоЗапись = Зеркало(Пул.Идентификатор);
	ЗеркалоЗапись.СостояниеПрогона = "идёт";
	ЗеркалоЗапись.ПрогонОбновлён = ТекущаяУниверсальнаяДата() - 5;
	ЗеркалоЗапись.Сохранить();

	// Отказ захвата раньше был нем: заявка пропадала у рабочего, и в журнале не появлялось
	// ни строки — снаружи это выглядело как «кнопка ничего не делает».
	Ловушка = Новый ЛовушкаЛога();
	Итог = НовыйСинхронизаторНад(Новый ФейкСервисЗеркалСинк(), Источник, 26214400,
		ЛогСЛовушкой(Ловушка)).Синхронизировать(ЗеркалоЗапись);

	Ожидаем.Что(НРег(Итог.Статус), "живой прогон не перехвачен").Содержит("уже идёт");
	Ожидаем.Что(Источник.КоличествоСкачиваний(), "к апстриму не ходили").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(Ловушка.Всё()), "уже идёт") > 0,
		"отказ захвата назван в журнале: " + Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

// Хвост списка апстрима за пределами порции был недостижим детерминированно: каждый цикл
// начинался с начала list.txt. Курсор доводит обход до конца и сбрасывается.
&Тест
Процедура КурсорСохраняетсяИПродолжаетОбходСледующимЦиклом() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("cur", "1.0.0", 200, Ospx("cur", "1.0.0"));
	Источник.УстановитьХвост(Истина, "хвост-списка");
	ЗеркалоЗапись = Зеркало(Пул.Идентификатор);
	Синх = НовыйСинхронизатор(Источник);

	Первый = Синх.Синхронизировать(ЗеркалоЗапись);

	Ожидаем.Что(Первый.ЕстьЕщё, "источник сообщил о непройденном хвосте").ЭтоИстина();
	Ожидаем.Что(Состояние(ЗеркалоЗапись).Курсор, "курсор следующего цикла сохранён")
		.Равно("хвост-списка");
	Ожидаем.Что(Состояние(ЗеркалоЗапись).Состояние,
		"между порциями зеркало ждёт продолжения, а не отработало").Равно("поставлено");
	Ожидаем.Что(Источник.ПолученныеКурсоры()[0], "первый цикл шёл с начала списка").Равно("");

	Источник.УстановитьХвост(Ложь, "");
	Второй = Синх.Синхронизировать(ЗеркалоЗапись);

	Ожидаем.Что(Источник.ПолученныеКурсоры()[1], "второй цикл продолжил с сохранённого имени")
		.Равно("хвост-списка");
	Ожидаем.Что(Второй.ЕстьЕщё, "список пройден до конца").ЭтоЛожь();
	Ожидаем.Что(Состояние(ЗеркалоЗапись).Курсор, "курсор сброшен — следующий обход с начала")
		.Равно("");
	Ожидаем.Что(Состояние(ЗеркалоЗапись).Состояние, "и только теперь обход завершён")
		.Равно("завершён");

КонецПроцедуры

// Апстрим отвалился посреди порции: качать дальше нечего, а курсор обязан остаться
// на недокачанном пакете, иначе он потеряется до следующего полного обхода.
&Тест
Процедура ОтвалАпстримаОбрываетПорциюИДержитКурсор() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("aaa", "1.0.0", 200, Ospx("aaa", "1.0.0"));
	Источник.ДобавитьВерсию("bbb", "1.0.0", 0, Неопределено); // апстрим не ответил
	Источник.ДобавитьВерсию("ccc", "1.0.0", 200, Ospx("ccc", "1.0.0"));
	Источник.УстановитьХвост(Истина, "ддд");
	ЗеркалоЗапись = Зеркало(Пул.Идентификатор);

	Итог = НовыйСинхронизатор(Источник).Синхронизировать(ЗеркалоЗапись);

	Ожидаем.Что(Итог.Offline, "отвал апстрима замечен").ЭтоИстина();
	Ожидаем.Что(Итог.Недоступно, "недоступный элемент посчитан").Равно(1);
	Ожидаем.Что(Итог.Скачано, "успело скачаться только первое").Равно(1);
	Ожидаем.Что(Источник.КоличествоСкачиваний(), "за третьим пакетом не ходили").Равно(2);
	Ожидаем.Что(Состояние(ЗеркалоЗапись).Курсор, "курсор стоит на недокачанном пакете").Равно("bbb");
	Ожидаем.Что(Итог.ЕстьЕщё, "цикл не просит продолжения — апстрим лежит").ЭтоЛожь();
	Ожидаем.Что(НРег(Итог.Статус), "статус не врёт про «синк ок»").Содержит("отвалился");

КонецПроцедуры

// Мёртвый апстрим сохраняет курсор, и без ограничения зеркало дёргалось бы каждый тик
// расписания по таймауту на запрос. Пустой цикл — отказ апстрима, и он ждёт своего интервала.
&Тест
Процедура МёртвыйАпстримНеДёргаетсяКаждыйТик() Экспорт

	Пул = НовыйLocalПул();
	Лежит = Новый ФейкИсточникЗеркала();
	Лежит.УстановитьКодПеречисления(0);

	ЗеркалоЗапись = Зеркало(Пул.Идентификатор);
	ЗеркалоЗапись.ИнтервалСинкаСек = 86400;
	ЗеркалоЗапись.ПрогонКурсор = "недойденное-имя";
	ЗеркалоЗапись.СостояниеПрогона = "поставлено";
	ЗеркалоЗапись.ПрогонОбновлён = ТекущаяУниверсальнаяДата();
	ЗеркалоЗапись.ПоследнийСинк = ТекущаяУниверсальнаяДата() - 60;
	ЗеркалоЗапись.Сохранить();

	ФейкЗеркал = Новый ФейкСервисЗеркалСинк();
	ФейкЗеркал.Добавить(ЗеркалоЗапись);
	Движок = НовыйСинхронизаторНад(ФейкЗеркал, Лежит);

	Ожидаем.Что(Движок.СинхронизироватьВсе(), "первый тик попробовал — апстрим лежит").Равно(1);
	Ожидаем.Что(Состояние(ЗеркалоЗапись).Курсор, "курсор сохранён — обход не потерян")
		.Равно("недойденное-имя");

	Ожидаем.Что(Движок.СинхронизироватьВсе(),
		"следующий тик мёртвый апстрим не дёргает — ждёт своего интервала").Равно(0);
	Ожидаем.Что(Лежит.ПолученныеКурсоры().Количество(), "и к апстриму больше не ходили").Равно(1);

КонецПроцедуры

// Кнопку нажали, фоновый рабочий умер, не начав цикла: заявка с пустым курсором обязана
// подхватываться плановым прогоном, иначе она провисит до истечения интервала.
&Тест
Процедура ПоставленныйПрогонПодхватываетсяПланово() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("queued", "1.0.0", 200, Ospx("queued", "1.0.0"));

	ЗеркалоЗапись = Зеркало(Пул.Идентификатор);
	ЗеркалоЗапись.ИнтервалСинкаСек = 86400;
	ЗеркалоЗапись.ПоследнийСинк = ТекущаяУниверсальнаяДата() - 60;
	ЗеркалоЗапись.Сохранить();
	Прогон().Поставить(ЗеркалоЗапись.Идентификатор, "user-9");

	ФейкЗеркал = Новый ФейкСервисЗеркалСинк();
	ФейкЗеркал.Добавить(ЗеркалоЗапись);

	Ожидаем.Что(НовыйСинхронизаторНад(ФейкЗеркал, Источник).СинхронизироватьВсе(),
		"поставленный прогон интервала не ждёт").Равно(1);
	Ожидаем.Что(Состояние(ЗеркалоЗапись).Скачано, "заявка отработана").Равно(1);
	Ожидаем.Что(Состояние(ЗеркалоЗапись).Запустил, "инициатор заявки сохранён").Равно("user-9");

КонецПроцедуры

// Цепочка целиком: нажатие → заявка очереди → «поставлено» НА ЗАПИСИ → движок торопится
// на неё, не дожидаясь интервала → счётчики после реального прогона ненулевые. Заявка,
// оставшаяся только в памяти процесса, дала бы экрану «простаивает» — половину жалобы
// владельца; счётчик, читаемый мимо колонки, дал бы ноль при сделанной работе — вторую.
&Тест
Процедура ЗаявкаОчередиДоезжаетДоЗаписиИПодхватываетсяДвижком() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("chain", "1.0.0", 200, Ospx("chain", "1.0.0"));

	ЗеркалоЗапись = Зеркало(Пул.Идентификатор);
	ЗеркалоЗапись.ИнтервалСинкаСек = 86400;
	ЗеркалоЗапись.ПоследнийСинк = ТекущаяУниверсальнаяДата() - 60;
	ЗеркалоЗапись.Сохранить();

	Ожидаем.Что(Очередь().Поставить(ЗеркалоЗапись.Идентификатор, "owner1"), "заявка принята")
		.ЭтоИстина();

	Ожидаем.Что(Состояние(ЗеркалоЗапись).Состояние, "заявка доехала до записи зеркала")
		.Равно("поставлено");
	Ожидаем.Что(Состояние(ЗеркалоЗапись).Запустил, "инициатор записан логином").Равно("owner1");

	ФейкЗеркал = Новый ФейкСервисЗеркалСинк();
	ФейкЗеркал.Добавить(ЗеркалоЗапись);
	Ожидаем.Что(НовыйСинхронизаторНад(ФейкЗеркал, Источник).СинхронизироватьВсе(),
		"движок подхватил заявку, не дожидаясь интервала").Равно(1);

	Итог = Состояние(ЗеркалоЗапись);
	Ожидаем.Что(Итог.Состояние, "прогон закрыт").Равно("завершён");
	Ожидаем.Что(Итог.Скачано, "счётчики после реального прогона ненулевые").Равно(1);
	Ожидаем.Что(Итог.Всего > 0, "и перечисленное апстримом сосчитано").ЭтоИстина();

КонецПроцедуры

// ИСТ-АПСТ-008: в лежачий источник не ходит и зеркало — цикл не платит за него ни одного таймаута.
&Тест
Процедура ЛежачийИсточникЗеркаломНеОпрашивается() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("pkgs", "1.0.0", 200, Ospx("pkgs", "1.0.0"));

	Страж = НовыйСтраж();
	Страж.ОтметитьЛежащим("http://down.example/download/", "соединение отбито");
	Синх = НовыйСинхронизаторСоСтражем(Источник, Страж);

	Итог = Синх.Синхронизировать(ЗеркалоURL(Пул.Идентификатор, "http://down.example/download/"));

	Ожидаем.Что(Источник.КоличествоСкачиваний(), "к лежачему источнику цикл не ходит").Равно(0);
	Ожидаем.Что(Итог.Скачано, "ничего не скачано").Равно(0);
	Ожидаем.Что(Итог.Статус, "причина названа, а не выдана за пустой апстрим").Содержит("лежащим");

	// а живой источник тем же движком синхронизируется
	Страж.ОтметитьЖивым("http://down.example/download/");
	Итог = НовыйСинхронизаторСоСтражем(Источник, Страж).Синхронизировать(
		ЗеркалоURL(Пул.Идентификатор, "http://down.example/download/"));
	Ожидаем.Что(Итог.Скачано, "поднявшийся источник снова зеркалируется").Равно(1);

КонецПроцедуры

// Сеть, в которой живёт источник, синк не судит: её выбрал администратор пула
// (ИСТ-АПСТ-004, принятый риск). Зеркало на имя, разрешающееся в приватный адрес, работает.
&Тест
Процедура СинкНеСудитСетьИсточника() Экспорт

	Пул = НовыйLocalПул();
	Разрешитель_.ЗадатьПриватный("rebind.example", "169.254.169.254");

	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("pkgs", "1.0.0", 200, Ospx("pkgs", "1.0.0"));
	Синх = НовыйСинхронизатор(Источник);

	Итог = Синх.Синхронизировать(ЗеркалоURL(Пул.Идентификатор, "http://rebind.example/download/"));

	Ожидаем.Что(Итог.Скачано, "интранет-источник зеркалируется").Равно(1);
	Ожидаем.Что(Найти(НРег(Итог.Статус), "отклон"), "отказа по сети нет").Равно(0);
	Ожидаем.Что(Хранилище().Существует(Новый КоординатыАртефакта(Пул.Имя, "pkgs", "1.0.0")),
		"артефакт привезён").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ИмяИзURLАНеИзМанифеста() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("good", "1.0.0", 200, Ospx("evil", "1.0.0"));
	Синх = НовыйСинхронизатор(Источник);

	Итог = Синх.Синхронизировать(Зеркало(Пул.Идентификатор));

	Ожидаем.Что(Итог.Скачано, "пакет сохранён").Равно(1);
	Ожидаем.Что(Хранилище().Существует(Новый КоординатыАртефакта(Пул.Имя, "good", "1.0.0")),
		"координаты — из URL-имени good").ЭтоИстина();
	Ожидаем.Что(СервисПакетов().НайтиПакет(Пул.Идентификатор, "good") <> Неопределено,
		"реестр знает good").ЭтоИстина();
	Ожидаем.Что(СервисПакетов().НайтиПакет(Пул.Идентификатор, "evil"),
		"манифестное имя evil НЕ попало в реестр").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура TraversalИмяПропускаетсяБезОбращенияКФС() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("../../etc", "1.0.0", 200, Ospx("x", "1.0.0"));
	Синх = НовыйСинхронизатор(Источник);

	Итог = Синх.Синхронизировать(Зеркало(Пул.Идентификатор));

	Ожидаем.Что(Итог.Скачано, "traversal-имя не сохранено").Равно(0);
	Ожидаем.Что(Итог.Пропущено, "traversal-имя пропущено").Равно(1);
	Ожидаем.Что(Источник.КоличествоСкачиваний(), "к апстриму по traversal-имени не обращались").Равно(0);

КонецПроцедуры

// --- состав зависимостей зазеркаленной версии ---

&Тест
Процедура ЗеркалированиеПереноситСоставЗависимостей() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("depmir", "1.0.0", 200, OspxСЗависимостями("depmir", "1.0.0"));

	Итог = НовыйСинхронизатор(Источник).Синхронизировать(Зеркало(Пул.Идентификатор));

	Ожидаем.Что(Итог.Скачано, "версия зазеркалена").Равно(1);
	Состав = СоставВерсии(Пул, "depmir", "1.0.0");
	Ожидаем.Что(Состав.Количество(), "обе зависимости манифеста попали в реестр").Равно(2);

	Обычная = НайтиЗависимость(Состав, "json");
	Ожидаем.Что(Обычная, "зависимость json").Существует();
	Ожидаем.Что(Обычная.ВерсияМин, "минимальная версия из манифеста").Равно("1.0.0");
	Ожидаем.Что(Обычная.ВерсияМакс, "максимальная версия из манифеста").Равно("2.0.0");
	Ожидаем.Что(Обычная.ДляРазработки = Истина, "обычная зависимость признаком не помечена").ЭтоЛожь();

	Разработочная = НайтиЗависимость(Состав, "asserts");
	Ожидаем.Что(Разработочная, "зависимость asserts").Существует();
	Ожидаем.Что(Разработочная.ДляРазработки = Истина, "dev-зависимость помечена признаком").ЭтоИстина();
	Ожидаем.Что(Разработочная.ВерсияМакс, "максимум не задан — пустая строка").Равно("");

	// обратный граф вкладки «кто зависит» обязан видеть и зазеркаленную версию
	Ожидаем.Что(ЕстьВерсияВСоставе(КтоЗависитОт("json"), ВерсияЗаписью(Пул, "depmir", "1.0.0").Идентификатор),
		"обратный граф видит зазеркаленную версию").ЭтоИстина();

КонецПроцедуры

// --- карточка зазеркаленного пакета ---

// Дефект боевой инсталляции: у пакета, приехавшего с апстрима, карточка оставалась пустой —
// ни описания, ни ссылки на репозиторий, — хотя манифест их несёт. Наполняет её тот же
// приём версии, что и публикация здесь.
&Тест
Процедура ЗеркалированиеНаполняетКарточкуПакетаИзМанифеста() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("cardmir", "1.0.0", 200,
		OspxСКарточкой("cardmir", "1.0.0", "Пакет из чужого хаба", "https://github.com/owner/cardmir"));

	Ожидаем.Что(НовыйСинхронизатор(Источник).Синхронизировать(Зеркало(Пул.Идентификатор)).Скачано,
		"версия зазеркалена").Равно(1);

	Пакет = СервисПакетов().НайтиПакет(Пул.Идентификатор, "cardmir");
	Ожидаем.Что(Строка(Пакет.Описание), "описание манифеста доехало до карточки")
		.Равно("Пакет из чужого хаба");
	Ожидаем.Что(Строка(Пакет.АдресРепозитория), "и адрес репозитория")
		.Равно("https://github.com/owner/cardmir");

КонецПроцедуры

// README привезённого пакета ложится на диск тем же приёмом, что и у публикации здесь:
// страница зазеркаленного пакета показывает описание, не распаковывая .ospx.
&Тест
Процедура ЗеркалированиеКладётREADMEНаДиск() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("readmemir", "1.0.0", 200, Ospx("readmemir", "1.0.0"));

	Ожидаем.Что(НовыйСинхронизатор(Источник).Синхронизировать(Зеркало(Пул.Идентификатор)).Скачано,
		"версия зазеркалена").Равно(1);

	Описание = Новый КоординатыАртефакта(Пул.Имя, "readmemir", "1.0.0",
		"readmemir-1.0.0.readme.md");
	Ожидаем.Что(Хранилище().Существует(Описание),
		"README привезённой версии лежит рядом с артефактом").ЭтоИстина();
	Ожидаем.Что(ПолучитьСтрокуИзДвоичныхДанных(Хранилище().ПолучитьДанные(Описание), "UTF-8"),
		"и это README из привезённого .ospx").Равно("# readmemir 1.0.0");

КонецПроцедуры

// Синк не откатывает работу мейнтейнера: лицензии и ключевых слов в формате .ospx нет вовсе,
// снятие с витрины — решение оператора, а описание, которого в манифесте нет, приезд новой
// версии не стирает.
&Тест
Процедура ПовторныйСинкРукописнуюКарточкуНеОткатывает() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("keepmir", "1.0.0", 200,
		OspxСКарточкой("keepmir", "1.0.0", "Описание апстрима", "https://github.com/owner/keepmir"));
	Синх = НовыйСинхронизатор(Источник);
	Синх.Синхронизировать(Зеркало(Пул.Идентификатор));

	Пакет = СервисПакетов().НайтиПакет(Пул.Идентификатор, "keepmir");
	Рукописное = Новый Структура("Описание, КлючевыеСлова, Лицензия, Скрыт",
		"Описание мейнтейнера", "http, сервер", "MIT", Истина);
	СервисПакетов().ОбновитьМетаданные(Пакет.Идентификатор, Рукописное);

	// вторая версия того же имени: её манифест описания не несёт вовсе
	Источник.ДобавитьВерсию("keepmir", "1.1.0", 200, Ospx("keepmir", "1.1.0"));
	Ожидаем.Что(Синх.Синхронизировать(Зеркало(Пул.Идентификатор)).Скачано,
		"вторая версия зазеркалена").Равно(1);

	Обновлённый = СервисПакетов().НайтиПакет(Пул.Идентификатор, "keepmir");
	Ожидаем.Что(Строка(Обновлённый.Описание), "пустое описание манифеста правку не откатило")
		.Равно("Описание мейнтейнера");
	Ожидаем.Что(Строка(Обновлённый.КлючевыеСлова), "ключевых слов в манифесте нет — синк их не трогает")
		.Равно("http, сервер");
	Ожидаем.Что(Строка(Обновлённый.Лицензия), "лицензии в манифесте нет — тоже").Равно("MIT");
	Ожидаем.Что(Обновлённый.Скрыт = Истина, "снятый с витрины пакет на неё не вернулся").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗеркалоБезЗависимостейСоставаНеОставляет() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("nodepmir", "1.0.0", 200, Ospx("nodepmir", "1.0.0"));

	НовыйСинхронизатор(Источник).Синхронизировать(Зеркало(Пул.Идентификатор));

	Ожидаем.Что(СоставВерсии(Пул, "nodepmir", "1.0.0").Количество(),
		"зависимостей в манифесте нет — строк состава не появилось").Равно(0);

КонецПроцедуры

&Тест
Процедура ПовторныйСинкСоставНеДублирует() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("redepmir", "1.0.0", 200, OspxСЗависимостями("redepmir", "1.0.0"));
	Синх = НовыйСинхронизатор(Источник);

	Синх.Синхронизировать(Зеркало(Пул.Идентификатор));
	Итог = Синх.Синхронизировать(Зеркало(Пул.Идентификатор));

	Ожидаем.Что(Итог.Пропущено, "второй синк существующую версию пропустил").Равно(1);
	Ожидаем.Что(СоставВерсии(Пул, "redepmir", "1.0.0").Количество(),
		"состав не удвоился").Равно(2);

КонецПроцедуры

// Артефакт уже лежит в хранилище (скачан прокси, перенесён руками, индекс потерян) —
// версию заводит вторая ветка индексации, и её состав обязан совпасть со скачанной.
&Тест
Процедура ИндексПоХранимомуАртефактуДаётТотЖеСостав() Экспорт

	Байты = OspxСЗависимостями("twinmir", "1.0.0");

	Скачанный = НовыйLocalПул();
	ИсточникА = Новый ФейкИсточникЗеркала();
	ИсточникА.ДобавитьВерсию("twinmir", "1.0.0", 200, Байты);
	НовыйСинхронизатор(ИсточникА).Синхронизировать(Зеркало(Скачанный.Идентификатор));

	Хранимый = НовыйLocalПул();
	Хранилище().Сохранить(Новый КоординатыАртефакта(Хранимый.Имя, "twinmir", "1.0.0"), Байты);
	ИсточникБ = Новый ФейкИсточникЗеркала();
	ИсточникБ.ДобавитьВерсию("twinmir", "1.0.0", 200, Байты);
	Итог = НовыйСинхронизатор(ИсточникБ).Синхронизировать(Зеркало(Хранимый.Идентификатор));

	Ожидаем.Что(Итог.Скачано, "артефакт уже лежал — качать нечего").Равно(0);
	Ожидаем.Что(ИсточникБ.КоличествоСкачиваний(), "к апстриму не ходили вовсе").Равно(0);

	ПоХранимому = ОписаниеСостава(СоставВерсии(Хранимый, "twinmir", "1.0.0"));
	Ожидаем.Что(ЗначениеЗаполнено(ПоХранимому), "состав по хранимому артефакту не пуст").ЭтоИстина();
	Ожидаем.Что(ПоХранимому, "обе ветки индексации дали один состав")
		.Равно(ОписаниеСостава(СоставВерсии(Скачанный, "twinmir", "1.0.0")));

	// метаданные манифеста в этой ветке тоже берутся из хранимого артефакта
	Версия = ВерсияЗаписью(Хранимый, "twinmir", "1.0.0");
	Ожидаем.Что(Строка(Версия.АвторМанифеста), "автор из хранимого манифеста").Равно("автор апстрима");
	Ожидаем.Что(Строка(Версия.ВерсияДвижка), "версия движка из хранимого манифеста").Равно("1.9");

	// sha считается по тому файлу, что лежит: без него выдача отдаёт версию без ETag
	// и X-Checksum-Sha256
	Ожидаем.Что(НРег(Строка(Версия.Sha256)), "sha256 посчитан по хранимому артефакту")
		.Равно(Sha256Данных(Байты));
	Ожидаем.Что(НРег(Строка(Версия.Sha256)), "и совпал со sha скачанной ветки")
		.Равно(НРег(Строка(ВерсияЗаписью(Скачанный, "twinmir", "1.0.0").Sha256)));

КонецПроцедуры

// Ветка «latest + артефакт уже в хранилище + версия не проиндексирована»: манифест только
// что разобран, и второй раз за ним в хранилище не ходят.
&Тест
Процедура LatestНеПеречитываетХранимыйАртефактРадиМанифеста() Экспорт

	Пул = НовыйLocalПул();
	// под теми же координатами лежит НЕЧИТАЕМЫЙ файл: полезь ветка за манифестом
	// в хранилище — состава у версии не было бы
	Хранилище().Сохранить(Новый КоординатыАртефакта(Пул.Имя, "latemir", "2.5.0"),
		ПолучитьДвоичныеДанныеИзСтроки("это точно не zip-архив"));
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьLatest("latemir", 200, OspxСЗависимостями("latemir", "2.5.0"));

	Итог = НовыйСинхронизатор(Источник).Синхронизировать(Зеркало(Пул.Идентификатор));

	Ожидаем.Что(Итог.Скачано, "артефакт уже лежал — заново не сохраняли").Равно(0);
	Ожидаем.Что(Итог.Пропущено, "элемент пропущен как уже имеющийся").Равно(1);

	Версия = ВерсияЗаписью(Пул, "latemir", "2.5.0");
	Ожидаем.Что(Версия, "версия из latest-манифеста проиндексирована").Существует();
	Ожидаем.Что(СоставВерсии(Пул, "latemir", "2.5.0").Количество(),
		"состав взят из разобранного манифеста, а не из нечитаемого хранимого файла").Равно(2);
	Ожидаем.Что(Строка(Версия.АвторМанифеста), "и метаданные из него же").Равно("автор апстрима");

КонецПроцедуры

&Тест
Процедура НечитаемыйХранимыйАртефактНеРоняетИндексацию() Экспорт

	Пул = НовыйLocalПул();
	Хранилище().Сохранить(Новый КоординатыАртефакта(Пул.Имя, "junkmir", "1.0.0"),
		ПолучитьДвоичныеДанныеИзСтроки("это точно не zip-архив"));
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("junkmir", "1.0.0", 200, Ospx("junkmir", "1.0.0"));

	Итог = НовыйСинхронизатор(Источник).Синхронизировать(Зеркало(Пул.Идентификатор));

	Ожидаем.Что(Итог.Ошибок, "нечитаемый манифест синк не роняет").Равно(0);
	Ожидаем.Что(ВерсияЗаписью(Пул, "junkmir", "1.0.0"),
		"версия всё равно проиндексирована — артефакт-то есть").Существует();
	Ожидаем.Что(СоставВерсии(Пул, "junkmir", "1.0.0").Количество(),
		"состав неизвестен, а не выдуман").Равно(0);

КонецПроцедуры

// Версия проиндексирована без состава (например, до починки), артефакт из пула пропал —
// перекачка обязана состав добрать, а не оставить вкладку пустой навсегда.
&Тест
Процедура ПерекачкаДобираетСоставПроиндексированнойВерсии() Экспорт

	Пул = НовыйLocalПул();
	Источник = Новый ФейкИсточникЗеркала();
	Источник.ДобавитьВерсию("backfill", "1.0.0", 200, OspxСЗависимостями("backfill", "1.0.0"));
	Синх = НовыйСинхронизатор(Источник);
	Синх.Синхронизировать(Зеркало(Пул.Идентификатор));

	Версия = ВерсияЗаписью(Пул, "backfill", "1.0.0");
	Поделка.НайтиЖелудь("СервисЗависимостей").ЗаписатьСостав(Версия.Идентификатор, Новый Массив());
	Ожидаем.Что(СоставВерсии(Пул, "backfill", "1.0.0").Количество(), "состав снят").Равно(0);
	Хранилище().Удалить(Новый КоординатыАртефакта(Пул.Имя, "backfill", "1.0.0"));

	Итог = Синх.Синхронизировать(Зеркало(Пул.Идентификатор));

	Ожидаем.Что(Итог.Скачано, "артефакта нет — версия перекачана").Равно(1);
	Ожидаем.Что(СоставВерсии(Пул, "backfill", "1.0.0").Количество(),
		"состав добран перекачкой, без дублей").Равно(2);
	Ожидаем.Что(СервисВерсий().ВерсииПакета(
		СервисПакетов().НайтиПакет(Пул.Идентификатор, "backfill").Идентификатор).Количество(),
		"версия осталась одна").Равно(1);

КонецПроцедуры

// Синхронизатор с боевой памятью о живости источников.
Функция НовыйСинхронизаторСоСтражем(Знач Источник, Знач Страж)
	Возврат Новый СинхронизаторЗеркал(
		Новый ФейкСервисЗеркалСинк(), СервисПулов(), НовыйПеренос(26214400), Прогон(), След(),
		Валидатор(), Массив(Страж), Массив(Источник), Числа(), ЧислаЗеркал(200), ЛогТестов());
КонецФункции

Функция НовыйСтраж()
	Настройки = Новый НастройкиЗаглушка();
	Настройки.ЗадатьПрокси(20, Ложь, 60, 300);
	Возврат Новый СтражАпстримов(Настройки, ЛогТестов());
КонецФункции

Функция НовыйСинхронизатор(Знач Источник)
	Возврат НовыйСинхронизаторСЛимитом(Источник, 26214400);
КонецФункции

Функция НовыйСинхронизаторСЛимитом(Знач Источник, Знач МаксРазмер)
	Возврат НовыйСинхронизаторНад(Новый ФейкСервисЗеркалСинк(), Источник, МаксРазмер);
КонецФункции

Функция НовыйСинхронизаторНад(Знач ФейкЗеркал, Знач Источник, Знач МаксРазмер = 26214400,
	Знач Лог_ = Неопределено)
	Возврат Новый СинхронизаторЗеркал(
		ФейкЗеркал, СервисПулов(), НовыйПеренос(МаксРазмер, Лог_), Прогон(), След(), Валидатор(),
		Новый Массив(), Массив(Источник), Числа(), ЧислаЗеркал(200),
		?(Лог_ = Неопределено, ЛогТестов(), Лог_));
КонецФункции

Функция След()
	Возврат Новый СледЦиклаЗеркала(ИменаАудита(), Массив(Издатель()));
КонецФункции

// Числа зеркалирования — из настроек хаба; набору важна только порция.
Функция ЧислаЗеркал(Знач РазмерПорции)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.mirror.max_packages_per_cycle", РазмерПорции);
	Настройки.Задать("oshub.mirror.max_cycles_per_run", 20);
	Настройки.Задать("oshub.mirror.default_interval_sec", 3600);
	Настройки.Задать("oshub.mirror.max_per_pool", 5);
	Настройки.Задать("oshub.mirror.min_interval_sec", 60);
	Настройки.Задать("oshub.mirror.run_stale_sec", 900);
	Настройки.Задать("oshub.mirror.sync_enabled", Истина);
	Настройки.Задать("oshub.mirror.queue_max", 100);
	Возврат Новый ЧислаЗеркалирования(Новый ПриведениеЧисел(), Настройки);
КонецФункции

// Уровень консоли хаба: то, чего тут нет, оператор в консоли не увидит.
Функция ЛогСЛовушкой(Знач Ловушка)
	Лог = Логирование.ПолучитьЛог("тест.oshub.синк-ловушка");
	Лог.УстановитьУровень(УровниЛога.Информация);
	Лог.ДобавитьСпособВывода(Ловушка);
	Возврат Лог;
КонецФункции

Функция НовыйПеренос(Знач МаксРазмер, Знач Лог_ = Неопределено)
	Возврат Новый ПереносЭлементаСинка(СервисПакетов(), СервисВерсий(), ПриёмВерсий(),
		Правила(), Хранилище(), Разбор(), Объёмы(), Валидатор(), ПределыПриёма(МаксРазмер),
		Массив(СервисПулов()), Массив(След()),
		?(Лог_ = Неопределено, ЛогТестов(), Лог_));
КонецФункции

// Предел приёма — общий на хаб: тот же oshub.publish.max_upload_bytes, что и у публикации.
Функция ПределыПриёма(Знач МаксРазмер)
	Настройки = Новый НастройкиЗаглушка();
	Настройки.Задать("oshub.publish.max_upload_bytes", МаксРазмер);
	Настройки.Задать("oshub.publish.max_unpacked_bytes", 67108864);
	Настройки.Задать("oshub.publish.max_files", 5000);
	Настройки.Задать("oshub.publish.max_manifest_bytes", 524288);
	Возврат Новый ПределыПриёмаПакета(Новый ПриведениеЧисел(), Настройки);
КонецФункции

Функция Прогон()
	Возврат Поделка.НайтиЖелудь("ПрогонЗеркала");
КонецФункции

// Служба и очередь боевого состава над хранилищем контейнера: права здесь не предмет,
// поэтому СервисПрав — фейк.
Функция СервисЗеркал()
	Возврат Новый СервисЗеркал(ХранилищеЗеркал(), Новый ФейкСервисПрав(), Валидатор(),
		Новый Массив(), Прогон(), ЧислаЗеркал(200), Новый РазборНастроекЗеркала(ЧислаЗеркал(200)));
КонецФункции

Функция Очередь()
	Возврат Новый ОчередьСинхронизацииЗеркал(Числа(), СервисЗеркал(), ЧислаЗеркал(200), ЛогТестов());
КонецФункции

Функция ПриёмВерсий()
	Возврат Поделка.НайтиЖелудь("ПриёмВерсии");
КонецФункции

Функция Разбор()
	Возврат Поделка.НайтиЖелудь("РазборПакетовЗеркала");
КонецФункции

Функция Числа()
	Возврат Поделка.НайтиЖелудь("ПриведениеЧисел");
КонецФункции

Функция ИменаАудита()
	Возврат Поделка.НайтиЖелудь("ИмяОбъектаАудита");
КонецФункции

// Записи журнала о синхронизации ИМЕННО этого пула: соседние тесты набора пишут
// в тот же журнал, и общий отбор по действию считал бы чужие обходы.
Функция ЗаписиСинкаПула(Знач Пул)

	Адрес = ИменаАудита().ПулПоИмени(Пул.Имя);
	Отбор = Новый Структура("Действие", "зеркало.синхронизировано");
	Найденные = Новый Массив();
	Для Каждого Запись Из Поделка.НайтиЖелудь("СлужбаАудита").ЗаписиСтраницей(Отбор, 1, 200).Записи Цикл
		Если Строка(Запись.Объект) = Адрес Тогда
			Найденные.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	Возврат Найденные;

КонецФункции

Функция ДеталиЗаписи(Знач Запись)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Строка(Запись.Детали));
	Возврат ПрочитатьJSON(Чтение, Истина);
КонецФункции

Функция Валидатор()
	Возврат Новый ВалидаторАдресаАпстрима(Новый ВалидаторАдресаВебхука(Разрешитель_, НастройкиПодписок()));
КонецФункции

Функция ИсточникСВерсиями(Знач Имя, Знач Сколько)
	Источник = Новый ФейкИсточникЗеркала();
	Для Сч = 1 По Сколько Цикл
		Версия = "1.0." + Формат(Сч, "ЧГ=0");
		Источник.ДобавитьВерсию(Имя, Версия, 200, Ospx(Имя, Версия));
	КонецЦикла;
	Возврат Источник;
КонецФункции

Функция Массив(Знач Элемент)
	Результат = Новый Массив();
	Результат.Добавить(Элемент);
	Возврат Результат;
КонецФункции

// Зеркало — НАСТОЯЩАЯ запись сущности, а не структура: состояние прогона движок читает
// и пишет через хранилище, и на заглушке курсор с защитой от двойного запуска не проверить.
Функция Зеркало(Знач ПулИд)
	Возврат ЗеркалоURL(ПулИд, "http://upstream.invalid/download/");
КонецФункции

Функция ЗеркалоURL(Знач ПулИд, Знач URL)

	Запись = ХранилищеЗеркал().СоздатьЭлемент();
	Запись.ПулНазначенияИдентификатор = Цел(ПулИд);
	Запись.АпстримURL = URL;
	Запись.Режим = "opm";
	Запись.ФильтрJSON = "";
	Запись.ИнтервалСинкаСек = 3600;
	Запись.Включено = Истина;
	Запись.РазрешитьПриватные = Ложь;
	Запись.ПоследнийСинк = '00010101000000';
	Запись.Статус = "создано, ещё не синхронизировано";
	Запись.СостояниеПрогона = "простаивает";
	Запись.ПрогонНачат = '00010101000000';
	Запись.ПрогонОбновлён = '00010101000000';
	Запись.ПрогонВсего = 0;
	Запись.ПрогонСкачано = 0;
	Запись.ПрогонПропущено = 0;
	Запись.ПрогонОшибок = 0;
	Запись.ПрогонНедоступно = 0;
	Запись.ПрогонКурсор = "";
	Запись.ПрогонЗапустил = "";
	Запись.СозданКем = 0;
	Запись.Создан = ТекущаяУниверсальнаяДата();
	Запись.Обновлён = Запись.Создан;
	Запись.Сохранить();
	Возврат Запись;

КонецФункции

Функция ХранилищеЗеркал()
	Возврат Поделка.НайтиЖелудь("ХранилищеЗеркалХабов");
КонецФункции

Функция Состояние(Знач Зеркало_)
	Возврат Прогон().Состояние(Зеркало_.Идентификатор);
КонецФункции

// Лог заданного уровня с ловушкой: уровень решает, видны ли отладочные строки.
Функция ЛогУровня(Знач Ловушка, Знач Уровень)
	Лог = Логирование.ПолучитьЛог("тест.oshub.синк-уровень." + Строка(Уровень));
	Лог.УстановитьУровень(Уровень);
	Лог.ДобавитьСпособВывода(Ловушка);
	Возврат Лог;
КонецФункции

// Пул со своей квотой места: приезжающее занимает его наравне с опубликованным.
Функция ПулСКвотойМб(Знач КвотаМб)
	Пул = НовыйLocalПул();
	Возврат СервисПулов().УстановитьКвоту(Пул.Идентификатор, КвотаМб);
КонецФункции

// Забивает пул под завязку, чтобы следующий артефакт в квоту уже не влез.
Процедура ЗанятьПулПодЗавязку(Знач Пул)
	Объёмы().Учесть(Пул, 1024 * 1024, "подготовка теста");
КонецПроцедуры

Функция НовыйLocalПул()
	НомерПула = НомерПула + 1;
	Возврат СервисПулов().СоздатьПул("mir-dest-" + Формат(НомерПула, "ЧГ=0"), "custom");
КонецФункции

Функция Ospx(Знач Имя, Знач Версия)
	Кат = ОбъединитьПути(КаталогOspx, Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Кат);
	Путь = Новый ФикстураПакета().ПостроитьOspx(Кат, Имя, Версия, "# " + Имя + " " + Версия);
	Возврат Новый ДвоичныеДанные(Путь);
КонецФункции

// .ospx с зависимостями: обычная с диапазоном «мин-макс» и dev-зависимость без максимума.
Функция OspxСЗависимостями(Знач Имя, Знач Версия)

	Манифест = ПакетыOspx.НовыйМанифест(Имя, Версия);
	Манифест.УстановитьАвтора("автор апстрима");
	Манифест.УстановитьВерсиюДвижка("1.9");
	Манифест.ДобавитьЗависимость("json", "1.0.0", "2.0.0");
	Манифест.ДобавитьЗависимость("asserts", "1.5.0", "", Истина);

	Кат = ОбъединитьПути(КаталогOspx, "deps-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Кат);
	Возврат Новый ДвоичныеДанные(
		Новый ФикстураПакета().ПостроитьOspxПоМанифесту(Кат, Манифест, "# " + Имя));

КонецФункции

// .ospx с заполненной карточкой: описание и адрес репозитория, как их отдаёт апстрим.
Функция OspxСКарточкой(Знач Имя, Знач Версия, Знач Описание, Знач АдресРепозитория)

	Манифест = ПакетыOspx.НовыйМанифест(Имя, Версия);
	Манифест.УстановитьОписание(Описание);
	Манифест.УстановитьАдресРепозитория(АдресРепозитория);

	Кат = ОбъединитьПути(КаталогOspx, "card-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Кат);
	Возврат Новый ДвоичныеДанные(
		Новый ФикстураПакета().ПостроитьOspxПоМанифесту(Кат, Манифест, "# " + Имя));

КонецФункции

// Описание версии на диске: килобайты рядом с артефактом, но в объёме пула они честные.
Функция РазмерОписания(Знач Пул, Знач ИмяПакета, Знач Версия)
	Возврат Хранилище().Размер(Новый КоординатыАртефакта(Пул.Имя, ИмяПакета, Версия,
		ИмяПакета + "-" + Версия + ".readme.md"));
КонецФункции

Функция Sha256Данных(Знач Данные)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));
КонецФункции

Функция СоставВерсии(Знач Пул, Знач ИмяПакета, Знач Версия)
	Запись = ВерсияЗаписью(Пул, ИмяПакета, Версия);
	Если Запись = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;
	Возврат Поделка.НайтиЖелудь("ХранилищеЗависимостей").ПоВерсии(Запись.Идентификатор);
КонецФункции

Функция ВерсияЗаписью(Знач Пул, Знач ИмяПакета, Знач Версия)
	Пакет = СервисПакетов().НайтиПакет(Пул.Идентификатор, ИмяПакета);
	Возврат ?(Пакет = Неопределено, Неопределено,
		СервисВерсий().НайтиВерсию(Пакет.Идентификатор, Версия));
КонецФункции

Функция КтоЗависитОт(Знач ИмяПакета)
	Возврат Поделка.НайтиЖелудь("ХранилищеЗависимостей").КтоЗависитОт(ИмяПакета);
КонецФункции

Функция НайтиЗависимость(Знач Состав, Знач ИмяПакета)
	Для Каждого Зависимость Из Состав Цикл
		Если Строка(Зависимость.ИмяПакета) = ИмяПакета Тогда
			Возврат Зависимость;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ЕстьВерсияВСоставе(Знач Состав, Знач ВерсияИдентификатор)
	Для Каждого Зависимость Из Состав Цикл
		Если Цел(Зависимость.ВерсияИдентификатор) = Цел(ВерсияИдентификатор) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Состав одной строкой в устойчивом порядке: ветки индексации сравниваются целиком,
// а не по одному полю.
Функция ОписаниеСостава(Знач Состав)

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Ключ");
	Для Каждого Зависимость Из Состав Цикл
		Таблица.Добавить().Ключ = СтрШаблон("%1|%2|%3|%4", Зависимость.ИмяПакета,
			Зависимость.ВерсияМин, Зависимость.ВерсияМакс, Зависимость.ДляРазработки = Истина);
	КонецЦикла;
	Таблица.Сортировать("Ключ Возр");

	Ключи = Новый Массив();
	Для Каждого Запись Из Таблица Цикл
		Ключи.Добавить(Запись.Ключ);
	КонецЦикла;
	Возврат СтрСоединить(Ключи, ";");

КонецФункции

Функция Ospx2(Знач Имя, Знач Версия)
	Кат = ОбъединитьПути(КаталогOspx, "alt-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Кат);
	Путь = Новый ФикстураПакета().ПостроитьOspx(Кат, Имя, Версия, "# другой контент");
	Возврат Новый ДвоичныеДанные(Путь);
КонецФункции

Функция ВерсийПакета(Знач Пул, Знач Имя)
	Пакет = СервисПакетов().НайтиПакет(Пул.Идентификатор, Имя);
	Если Пакет = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Возврат СервисВерсий().ВерсииПакета(Пакет.Идентификатор).Количество();
КонецФункции

