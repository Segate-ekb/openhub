// Тесты автоматической раздачи прав на пакеты основного пула по правам в GitHub:
// сама раздача — на контейнере ОСени с фейком каталога репозиториев, разбор ответа
// GitHub — на HTTP-реализации каталога поверх фейкового транспорта. В сеть не ходим.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать logos
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Счётчик;
Перем КаталогТестов_;
Перем КаталогМодулей_;
Перем Ловушка_;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	Счётчик = 0;
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов_ = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов_, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогМодулей_ = Модули;

	ПодключитьКаталог(ОбъединитьПути(Модули, "данные", "Классы"));
	ПодключитьКаталог(ОбъединитьПути(Модули, "реестр", "Классы"));
	ПодключитьКаталог(ОбъединитьПути(Модули, "события", "Классы"));

	// издатель событий строится только с телеметрией, телеметрия — с транспортом и буфером
	КаталогNet = ОбъединитьПути(Модули, "сеть", "Классы");
	КаталогТелеметрии = ОбъединитьПути(Модули, "наблюдаемость", "Классы", "телеметрия");
	ПодключитьФайл(ОбъединитьПути(КаталогNet, "КоннекторHTTPБиблиотеки.os"));
	ПодключитьФайл(ОбъединитьПути(КаталогNet, "КлиентHTTP.os"));
	ПоискКлассов.Подключить(КаталогТелеметрии, "БуферСпанов");
	ПоискКлассов.Подключить(КаталогТелеметрии, "СпанХаба");
	ПоискКлассов.Подключить(КаталогТелеметрии, "Телеметрия");

	// СервисПулов требует SSRF-гейт адреса апстрима обязательно
	РеестрФикстур.Подключить("ГейтАпстримов");
	Гейт = Новый ГейтАпстримов();
	Гейт.Подключить(Модули);

	ПодключитьФайл(ОбъединитьПути(Модули, "аудит", "Классы", "ИмяОбъектаАудита.os"));

	КаталогВхода = ОбъединитьПути(Модули, "вход", "Классы");
	ПоискКлассов.Подключить(Модули, "СервисПрав");
	ПоискКлассов.Подключить(Модули, "СервисГрупп");
	ПоискКлассов.Подключить(Модули, "СервисПравДоступа");

	КаталогSettings = ОбъединитьПути(Модули, "настройки", "Классы");
	ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВидыПроверок.os"));
	ПодключитьФайл(ОбъединитьПути(КаталогSettings, "НастройкиПодсистем.os"));
	ПодключитьФайл(ОбъединитьПути(КаталогSettings, "РеестрНастроек.os"));
	ПодключитьФайл(ОбъединитьПути(КаталогSettings, "ВалидаторНастроек.os"));
	ПодключитьФайл(ОбъединитьПути(КаталогSettings, "СервисНастроек.os"));

	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "публикация", "Классы"), "АвтовыдачаПравПоGitHub");
	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "публикация", "Классы"), "ЗаданиеРаздачиПравGitHub");

	// боевые реализации контрактов GitHub в контейнер НЕ едут: их прозвища занимают фейки,
	// и весь исходящий HTTP этого набора виден тестам
	ПодключитьФайл(ОбъединитьПути(КаталогТестов_, "фикстуры", "ФейкПроверяющийGitHub.os"));
	ПодключитьФайл(ОбъединитьПути(КаталогТестов_, "фикстуры", "ФейкКаталогаРепозиториевGitHub.os"));
	// исход раздачи проверяется синхронно: фон превратил бы каждый тест в гонку.
	// Асинхронность стережёт отдельная область — там боевой ЗапускВФонеЗаданием
	ПодключитьФайл(ОбъединитьПути(КаталогТестов_, "фикстуры", "ЗапускВФонеСинхронный.os"));

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "автовыдача-прав-github-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);
	// организация задана НЕ умолчанием: инсталляция вправе зеркалить свою, и значение,
	// совпадающее с дефолтом, не отличило бы «взято из настройки» от «зашито в код»
	Детальки.Вставить("oshub.publish.github.org", ОрганизацияЗеркала());

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

// Контейнер один на набор: опция и режим сбоя каталога — общее состояние, и соседний
// тест не должен наследовать их от предыдущего.
&ПослеКаждого
Процедура ВернутьОбщееСостояние() Экспорт
	ВключитьЛегаси(Ложь);
	Каталог().ЭмулироватьСбой(Ложь);
	ОтпуститьЛог();
КонецПроцедуры

#Область РаздачаПрав

// Основной сценарий миграции: у человека есть push в oscript-library/<пакет> — он получает
// мейнтейнера на одноимённом пакете основного пула.
&Тест
Процедура PushВGitHubДаётМейнтейнераНаПакетеОсновногоПула() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	Имя = УникальноеИмя("gha");
	Пакет = СоздатьПакет(Пул, Имя);
	Юзер = СоздатьПользователя();
	Токен = "gh-" + Имя;
	Каталог().Разрешить(Токен, Имя);
	ВключитьЛегаси(Истина);

	Раздать(Юзер, Токен);

	Ожидаем.Что(РольНаПакете(Юзер, Пакет),
		"push в репозиторий зеркала даёт роль мейнтейнера на пакете").Равно("мейнтейнер");

КонецПроцедуры

// Имена сравниваются нормализованно: у репозитория GitHub регистр свой, у пакета — свой.
&Тест
Процедура РегистрИмениРепозиторияИПакетаНеЗначим() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	Имя = УникальноеИмя("ghCase");
	Пакет = СоздатьПакет(Пул, НРег(Имя));
	Юзер = СоздатьПользователя();
	Токен = "gh-" + Имя;
	Каталог().Разрешить(Токен, ВРег(Имя));
	ВключитьЛегаси(Истина);

	Раздать(Юзер, Токен);

	Ожидаем.Что(РольНаПакете(Юзер, Пакет),
		"регистр имени репозитория совпадению не мешает").Равно("мейнтейнер");

КонецПроцедуры

// Репозиторий в GitHub есть, пакета с таким именем в хабе нет — раздавать нечего.
&Тест
Процедура РепозиторийБезПакетаВХабеПравНеДаёт() Экспорт

	ОбеспечитьОсновнойПул();
	Юзер = СоздатьПользователя();
	Токен = "gh-" + УникальноеИмя("ghost");
	Каталог().Разрешить(Токен, УникальноеИмя("нетТакогоПакета"));
	ВключитьЛегаси(Истина);

	Раздать(Юзер, Токен);

	Ожидаем.Что(ГрантовУ(Юзер), "пакета нет — гранта нет").Равно(0);

КонецПроцедуры

// Пакет в основном пуле есть, push в GitHub нет — прав не появляется.
&Тест
Процедура ПакетБезPushВGitHubПравНеДаёт() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	Пакет = СоздатьПакет(Пул, УникальноеИмя("ghnop"));
	Юзер = СоздатьПользователя();
	Токен = "gh-" + УникальноеИмя("t");
	// каталог про этот токен ничего не знает — пустой список
	ВключитьЛегаси(Истина);

	Раздать(Юзер, Токен);

	Ожидаем.Что(РольНаПакете(Юзер, Пакет), "без push прав нет").Равно("");
	Ожидаем.Что(ГрантовУ(Юзер), "и гранта нет").Равно(0);

КонецПроцедуры

// Механизм живёт только в основном пуле: одноимённый пакет чужого пула прав не получает.
&Тест
Процедура ОдноимённыйПакетЧужогоПулаПравНеПолучает() Экспорт

	Основной = ОбеспечитьОсновнойПул();
	Чужой = СоздатьПул();
	Имя = УникальноеИмя("ghtwin");
	ПакетОсновного = СоздатьПакет(Основной, Имя);
	ПакетЧужого = СоздатьПакет(Чужой, Имя);
	Юзер = СоздатьПользователя();
	Токен = "gh-" + Имя;
	Каталог().Разрешить(Токен, Имя);
	ВключитьЛегаси(Истина);

	Раздать(Юзер, Токен);

	Ожидаем.Что(РольНаПакете(Юзер, ПакетОсновного),
		"КОНТРОЛЬ: в основном пуле роль выдана").Равно("мейнтейнер");
	Ожидаем.Что(РольНаПакете(Юзер, ПакетЧужого),
		"одноимённый пакет чужого пула механизма не касается").Равно("");

КонецПроцедуры

// Выключенная опция хаба закрывает механизм целиком — и в сеть за списком не ходят вовсе.
&Тест
Процедура ВыключеннаяОпцияНеРаздаётПравИВСетьНеХодит() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	Имя = УникальноеИмя("ghoff");
	Пакет = СоздатьПакет(Пул, Имя);
	Юзер = СоздатьПользователя();
	Токен = "gh-" + Имя;
	Каталог().Разрешить(Токен, Имя);

	ВключитьЛегаси(Ложь);
	ДоВызовов = Каталог().КоличествоВызовов();
	Раздать(Юзер, Токен);

	Ожидаем.Что(Каталог().КоличествоВызовов() - ДоВызовов,
		"с выключенной опцией в GitHub не ходят вовсе").Равно(0);
	Ожидаем.Что(РольНаПакете(Юзер, Пакет), "и прав не появляется").Равно("");

	// КОНТРОЛЬ, отличающийся РОВНО опцией
	ВключитьЛегаси(Истина);
	Раздать(Юзер, Токен);
	Ожидаем.Что(Каталог().КоличествоВызовов() - ДоВызовов,
		"КОНТРОЛЬ: с включённой опцией за списком сходили").Равно(1);
	Ожидаем.Что(РольНаПакете(Юзер, Пакет), "КОНТРОЛЬ: и роль выдана").Равно("мейнтейнер");

КонецПроцедуры

// Хаб без основного пула: механизму не к чему привязаться — тихий выход, а не исключение.
&Тест
Процедура БезОсновногоПулаВыходТихий() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	Имя = УникальноеИмя("ghnodef");
	Пакет = СоздатьПакет(Пул, Имя);
	Юзер = СоздатьПользователя();
	Токен = "gh-" + Имя;
	Каталог().Разрешить(Токен, Имя);
	ВключитьЛегаси(Истина);

	УстановитьПризнакОсновного(Пул, Ложь);
	Попытка
		Раздать(Юзер, Токен);
	Исключение
		УстановитьПризнакОсновного(Пул, Истина);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПризнакОсновного(Пул, Истина);

	Ожидаем.Что(РольНаПакете(Юзер, Пакет), "без основного пула прав не выдано").Равно("");

	// КОНТРОЛЬ: признак вернули — тот же вызов раздаёт
	Раздать(Юзер, Токен);
	Ожидаем.Что(РольНаПакете(Юзер, Пакет), "КОНТРОЛЬ: с основным пулом роль выдана").Равно("мейнтейнер");

КонецПроцедуры

// Права, выданные человеком, автоматика не трогает: у владельца пакета своего гранта
// на пакет нет, и заводить его автовыдача не вправе — иначе переписывает чужую выдачу.
&Тест
Процедура ВладелецПакетаАвтовыдачейНеПереписывается() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	Имя = УникальноеИмя("ghown");
	Пакет = СоздатьПакет(Пул, Имя);
	Юзер = СоздатьПользователя();
	Админ = СоздатьПользователя("admin");
	Токен = "gh-" + Имя;
	Каталог().Разрешить(Токен, Имя);

	// человек выдал права на ПУЛ: на пакете это владелец (удаление самой сущности разрешено)
	Доступ().ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Права().ОбъектПул(Пул),
		Набор(Истина, Истина, Истина, Истина), Админ.Идентификатор, Строка(Админ.Логин));
	Ожидаем.Что(РольНаПакете(Юзер, Пакет), "КОНТРОЛЬ: до раздачи он владелец").Равно("владелец");

	ВключитьЛегаси(Истина);
	Раздать(Юзер, Токен);

	Ожидаем.Что(Доступ().НайтиГрант("пользователь", Юзер.Идентификатор, Права().ОбъектПакет(Пакет)),
		"тому, у кого прав и так достаточно, автоматика гранта не заводит").Равно(Неопределено);
	Ожидаем.Что(РольНаПакете(Юзер, Пакет),
		"роль владельца осталась владельцем, а не понизилась до мейнтейнера").Равно("владелец");

КонецПроцедуры

// Повторный вход не задваивает грант и не переписывает того, кто его выдал.
&Тест
Процедура ПовторнаяРаздачаИдемпотентна() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	Имя = УникальноеИмя("ghidem");
	Пакет = СоздатьПакет(Пул, Имя);
	Юзер = СоздатьПользователя();
	Токен = "gh-" + Имя;
	Каталог().Разрешить(Токен, Имя);
	ВключитьЛегаси(Истина);

	Раздать(Юзер, Токен);
	Ожидаем.Что(ГрантовУ(Юзер), "первая раздача завела ровно один грант").Равно(1);

	// право «переоформил» человек — второй заход не вправе переписать выдавшего
	Грант = Доступ().НайтиГрант("пользователь", Юзер.Идентификатор, Права().ОбъектПакет(Пакет));
	Грант.КемВыдано = 4242;
	Грант.Сохранить();

	Раздать(Юзер, Токен);

	Ожидаем.Что(ГрантовУ(Юзер), "второй заход гранта не задваивает").Равно(1);
	Ожидаем.Что(РольНаПакете(Юзер, Пакет), "роль та же").Равно("мейнтейнер");
	Ожидаем.Что(Цел(Доступ().НайтиГрант("пользователь", Юзер.Идентификатор,
		Права().ОбъектПакет(Пакет)).КемВыдано),
		"кем выдано право — автоматика не переписывает").Равно(4242);

КонецПроцедуры

// GitHub недоступен, ответил 500 или прислал мусор — наружу из раздачи не летит ничего.
&Тест
Процедура СбойКаталогаРаздачуНеРонит() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	Имя = УникальноеИмя("ghfail");
	Пакет = СоздатьПакет(Пул, Имя);
	Юзер = СоздатьПользователя();
	Токен = "gh-" + Имя;
	Каталог().Разрешить(Токен, Имя);
	ВключитьЛегаси(Истина);
	Каталог().ЭмулироватьСбой();

	Упало = Ложь;
	Попытка
		Раздать(Юзер, Токен);
	Исключение
		Упало = Истина;
	КонецПопытки;

	Ожидаем.Что(Упало, "сбой каталога наружу не летит").ЭтоЛожь();
	Ожидаем.Что(РольНаПакете(Юзер, Пакет), "и прав не выдано").Равно("");

КонецПроцедуры

// Пустой токен — не повод ходить в GitHub: вход не через GitHub выглядит именно так.
&Тест
Процедура ПустойТокенВGitHubНеВедёт() Экспорт

	ОбеспечитьОсновнойПул();
	Юзер = СоздатьПользователя();
	ВключитьЛегаси(Истина);

	ДоВызовов = Каталог().КоличествоВызовов();
	Раздать(Юзер, "");

	Ожидаем.Что(Каталог().КоличествоВызовов() - ДоВызовов, "без токена в GitHub не ходят").Равно(0);

КонецПроцедуры

// Организация приезжает из настройки хаба, а не из литерала в коде: инсталляция вправе
// зеркалить свою организацию, и раздача обязана идти по ней же, что и легаси-push.
&Тест
Процедура ОрганизацияБерётсяИзНастройкиХаба() Экспорт

	ОбеспечитьОсновнойПул();
	Юзер = СоздатьПользователя();
	Токен = "gh-" + УникальноеИмя("ghorg");
	ВключитьЛегаси(Истина);

	Раздать(Юзер, Токен);

	Ожидаем.Что(Каталог().ОрганизацияПоследняя(),
		"каталог спрашивают про организацию из детальки oshub.publish.github.org,"
		+ " а не про умолчание").Равно(ОрганизацияЗеркала());
	Ожидаем.Что(ОрганизацияЗеркала() = "oscript-library",
		"КОНТРОЛЬ: организация набора отличается от умолчания, иначе тест сверял бы"
		+ " две одинаковые константы").ЭтоЛожь();

КонецПроцедуры

// Админ заблокировал человека — тот жмёт «Войти через GitHub»: сессии не получает,
// и права набирать тоже не должен, иначе они оживут при разблокировке.
&Тест
Процедура ЗаблокированнаяУчёткаПравНеНабирает() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	Имя = УникальноеИмя("ghlock");
	Пакет = СоздатьПакет(Пул, Имя);
	Юзер = СоздатьПользователя();
	Юзер.Активен = Ложь;
	Юзер.Сохранить();
	Токен = "gh-" + Имя;
	Каталог().Разрешить(Токен, Имя);
	ВключитьЛегаси(Истина);

	Раздать(Юзер, Токен);

	Ожидаем.Что(РольНаПакете(Юзер, Пакет), "заблокированная учётка прав не получает").Равно("");
	Ожидаем.Что(ГрантовУ(Юзер), "и гранта у неё нет").Равно(0);

	// КОНТРОЛЬ, отличающийся РОВНО признаком блокировки
	Юзер.Активен = Истина;
	Юзер.Сохранить();
	Раздать(Юзер, Токен);
	Ожидаем.Что(РольНаПакете(Юзер, Пакет), "КОНТРОЛЬ: разблокированная получает роль").Равно("мейнтейнер");

КонецПроцедуры

// Выдача автовыдачи обязана быть отличима в журнале от TOFU-владения и роли создателю
// пула: у права, живущего вечно, это единственный ответ на вопрос «почему он мейнтейнер».
&Тест
Процедура ВыдачаПодписанаВЖурналеКакАвтовыдача() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	Имя = УникальноеИмя("ghaudit");
	Пакет = СоздатьПакет(Пул, Имя);
	Юзер = СоздатьПользователя();
	Токен = "gh-" + Имя;
	Каталог().Разрешить(Токен, Имя);
	ВключитьЛегаси(Истина);
	Подписчик = ПодписатьсяНаПрава();

	Раздать(Юзер, Токен);

	Событие = ПоследнееСобытиеПрав(Подписчик);
	Ожидаем.Что(Событие, "выдача опубликована в журнал").Существует();
	Ожидаем.Что(Строка(Событие.Данные.Кто),
		"принципал называет механизм и логин у провайдера").Равно("автовыдача github:octocat");
	Ожидаем.Что(Строка(Событие.Данные.Объект),
		"объект — тот самый пакет").Равно(Желудь("ИмяОбъектаАудита").Пакет(Пакет.Идентификатор));

КонецПроцедуры

// Сборка без модуля настройки: резолвера нет — раздачи нет и в сеть не ходят.
// Тот же ответ на нечитаемую настройку: внешний источник права не включается
// по недоразумению.
&Тест
Процедура БезЧитаемойНастройкиРаздачиНетИВСетьНеХодят() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	Имя = УникальноеИмя("ghopt");
	Пакет = СоздатьПакет(Пул, Имя);
	Юзер = СоздатьПользователя();
	Токен = "gh-" + Имя;
	Каталог().Разрешить(Токен, Имя);

	ДоВызовов = Каталог().КоличествоВызовов();
	БезРезолвера = НоваяАвтовыдача(Неопределено);
	БезРезолвера.Раздать(Юзер.Идентификатор, "octocat", Токен);
	Ожидаем.Что(Каталог().КоличествоВызовов() - ДоВызовов,
		"нет резолвера настроек → в GitHub не ходят").Равно(0);
	Ожидаем.Что(РольНаПакете(Юзер, Пакет), "нет резолвера настроек → прав нет").Равно("");

	// значение ключа не задано — заглушка бросает исключение при чтении
	Нечитаемая = НоваяАвтовыдача(НовыеНастройкиЗаглушки(Неопределено));
	Нечитаемая.Раздать(Юзер.Идентификатор, "octocat", Токен);
	Ожидаем.Что(Каталог().КоличествоВызовов() - ДоВызовов,
		"ошибка чтения настройки → в GitHub не ходят").Равно(0);
	Ожидаем.Что(РольНаПакете(Юзер, Пакет), "ошибка чтения настройки → прав нет").Равно("");

	// КОНТРОЛЬ: та же сборка с читаемой включённой настройкой раздаёт
	Включённая = НоваяАвтовыдача(НовыеНастройкиЗаглушки(Истина));
	Включённая.Раздать(Юзер.Идентификатор, "octocat", Токен);
	Ожидаем.Что(РольНаПакете(Юзер, Пакет),
		"КОНТРОЛЬ: с читаемой включённой настройкой роль выдана").Равно("мейнтейнер");

КонецПроцедуры

// Новые права меняют доступ человека — это видно на боевом уровне журнала. Раздача,
// ничего не изменившая, идёт на каждый вход и в журнал по умолчанию не лезет.
&Тест
Процедура ВыданныеПраваВидныНаБоевомУровне() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	Имя = УникальноеИмя("ghsum");
	СоздатьПакет(Пул, Имя);
	Юзер = СоздатьПользователя();
	Токен = "gh-" + Имя;
	// четыре репозитория с правом записи, пакет в хабе — только у одного
	Каталог().Разрешить(Токен, Имя + ",ghsum-x,ghsum-y,ghsum-z");

	Ловушка = ЛовитьЛог();
	НоваяАвтовыдача(НовыеНастройкиЗаглушки(Истина)).Раздать(Юзер.Идентификатор, "octosum", Токен);

	Ожидаем.Что(Ловушка.Количество(),
		"выдача новых прав оставляет ровно одну запись на боевом уровне").Равно(1);
	Запись = Ловушка.Сообщение(0);
	Ожидаем.Что(СтрНайти(Запись, "octosum") > 0,
		"запись называет, кому раздавали: " + Запись).ЭтоИстина();
	Ожидаем.Что(ЕстьЧисло(Запись, 4),
		"запись называет число найденных репозиториев: " + Запись).ЭтоИстина();
	Ожидаем.Что(ЕстьЧисло(Запись, 1),
		"и число выданных прав: " + Запись).ЭтоИстина();

	// КОНТРОЛЬ: повтор того же входа прав не добавляет — и журнал по умолчанию молчит,
	// иначе каждый вход каждого человека писал бы строку
	НоваяАвтовыдача(НовыеНастройкиЗаглушки(Истина)).Раздать(Юзер.Идентификатор, "octosum", Токен);

	Ожидаем.Что(Ловушка.Количество(),
		"раздача без новых прав в журнал по умолчанию не пишет: " + Ловушка.Всё()).Равно(1);

КонецПроцедуры

// Тот же путь под поднятой отладкой: разбор «сходили, ничего не изменилось» обязан
// оставаться возможным — числа называются и там.
&Тест
Процедура РаздачаБезНовыхПравЧитаетсяОтладкой() Экспорт

	ОбеспечитьОсновнойПул();
	Юзер = СоздатьПользователя();

	Ловушка = ЛовитьОтладку();

	// два репозитория, пакетов в хабе нет — прав не прибавилось
	ТокенБезПакетов = "gh-" + УникальноеИмя("ghsumctl");
	Каталог().Разрешить(ТокенБезПакетов, "ghsum-none-a,ghsum-none-b");
	НоваяАвтовыдача(НовыеНастройкиЗаглушки(Истина)).Раздать(Юзер.Идентификатор, "octosum", ТокенБезПакетов);

	Контроль = Ловушка.Сообщение(0);
	Ожидаем.Что(ЕстьЧисло(Контроль, 2),
		"два репозитория без пакетов названы двумя: " + Контроль).ЭтоИстина();
	Ожидаем.Что(ЕстьЧисло(Контроль, 0),
		"и нулём выданных прав: " + Контроль).ЭтоИстина();

	// штатный исход боевого хаба: токен есть, репозиториев с правом записи ноль.
	// Оба числа обязаны печататься нулями, а не пустотой
	ТокенБезРепозиториев = "gh-" + УникальноеИмя("ghsumzero");
	Каталог().Разрешить(ТокенБезРепозиториев, "");
	НоваяАвтовыдача(НовыеНастройкиЗаглушки(Истина)).Раздать(Юзер.Идентификатор, "octosum",
		ТокенБезРепозиториев);

	Нули = ЧислаИз(Ловушка.Сообщение(1));
	Ожидаем.Что(Нули.Количество(),
		"в записи названы оба числа, а не одно: " + Ловушка.Сообщение(1)).Равно(2);
	Ожидаем.Что(Нули[0] = 0 И Нули[1] = 0,
		"и оба — нули: " + Ловушка.Сообщение(1)).ЭтоИстина();

КонецПроцедуры

// Механизм с четырьмя тихими ранними выходами неотличим от сломанного: каждая причина
// незапуска обязана называться в журнале и отличаться от соседних. Уровень отладочный —
// раздача пробуется на каждом входе, и в журнале по умолчанию этих строк быть не должно.
&Тест
Процедура ПричинаНезапускаНазванаИРазличима() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	Имя = УникальноеИмя("ghskip");
	СоздатьПакет(Пул, Имя);
	Юзер = СоздатьПользователя();
	Токен = "gh-" + Имя;
	Каталог().Разрешить(Токен, Имя);

	// КОНТРОЛЬ: на боевом уровне причина незапуска журнал не засоряет
	Боевая = ЛовитьЛог();
	НоваяАвтовыдача(НовыеНастройкиЗаглушки(Ложь)).Раздать(Юзер.Идентификатор, "octoskip", Токен);
	Ожидаем.Что(Боевая.Количество(),
		"на уровне по умолчанию причина незапуска не пишется: " + Боевая.Всё()).Равно(0);

	Ловушка = ЛовитьОтладку();

	НоваяАвтовыдача(НовыеНастройкиЗаглушки(Ложь)).Раздать(Юзер.Идентификатор, "octoskip", Токен);
	Ожидаем.Что(Ловушка.Количество(), "выключенная опция объяснена").Равно(1);

	НоваяАвтовыдача(НовыеНастройкиЗаглушки(Истина)).Раздать(Юзер.Идентификатор, "octoskip", "");
	Ожидаем.Что(Ловушка.Количество(), "отсутствие токена объяснено").Равно(2);

	УстановитьПризнакОсновного(Пул, Ложь);
	Попытка
		НоваяАвтовыдача(НовыеНастройкиЗаглушки(Истина)).Раздать(Юзер.Идентификатор, "octoskip", Токен);
	Исключение
		УстановитьПризнакОсновного(Пул, Истина);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПризнакОсновного(Пул, Истина);
	Ожидаем.Что(Ловушка.Количество(), "хаб без основного пула объяснён").Равно(3);

	Юзер.Активен = Ложь;
	Юзер.Сохранить();
	НоваяАвтовыдача(НовыеНастройкиЗаглушки(Истина)).Раздать(Юзер.Идентификатор, "octoskip", Токен);
	Юзер.Активен = Истина;
	Юзер.Сохранить();
	Ожидаем.Что(Ловушка.Количество(), "заблокированная учётка объяснена").Равно(4);

	Ожидаем.Что(РазныхСообщений(Ловушка),
		"четыре разные причины — четыре разных объяснения, иначе журнал не отвечает"
		+ " на вопрос «почему»: " + Ловушка.Всё()).Равно(4);

КонецПроцедуры

#КонецОбласти

#Область РаботаУходитВФон

// Раздача идёт на каждом входе, поэтому вход не имеет права ждать GitHub. Проверяется
// значением, а не формой записи: каталог отвечает три секунды, а вызов обязан вернуться
// мгновенно — и права всё равно доехать.
&Тест
Процедура ВходНеЖдётМедленныйGitHub() Экспорт

	Пул = ОбеспечитьОсновнойПул();
	Имя = УникальноеИмя("ghfon");
	Пакет = СоздатьПакет(Пул, Имя);
	Юзер = СоздатьПользователя();
	Токен = "gh-" + Имя;

	Медленный = НовыйМедленныйКаталог(ЗадержкаКаталогаМС());
	Медленный.Разрешить(Токен, Имя);
	ВФоне = НоваяАвтовыдачаСФоном(НовыйБоевойФон(), НовыеНастройкиЗаглушки(Истина), Медленный);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ВФоне.Раздать(Юзер.Идентификатор, "octofon", Токен);
	Ожидание = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Ожидаем.Что(Ожидание < ЗадержкаКаталогаМС() / 3,
		СтрШаблон("вход вернулся за %1 мс при ответе GitHub в %2 мс — раздача его не держит",
			Формат(Ожидание, "ЧГ=0; ЧН=0"), Формат(ЗадержкаКаталогаМС(), "ЧГ=0; ЧН=0"))).ЭтоИстина();
	Ожидаем.Что(Медленный.КоличествоВызовов(),
		"на момент возврата в GitHub ещё даже не сходили").Равно(0);

	Ожидаем.Что(ДождатьсяРоли(Юзер, Пакет, "мейнтейнер"),
		"фоновая раздача всё-таки выдала роль — работа не потерялась, а сдвинулась").ЭтоИстина();

КонецПроцедуры

// Задание никто не ждёт и его исход не смотрит никто: сбой обязан дойти до оператора
// сам, иначе механизм снова становится немым.
&Тест
Процедура СбойФоновойРаздачиВиденВЖурнале() Экспорт

	ОбеспечитьОсновнойПул();
	Юзер = СоздатьПользователя();
	Токен = "gh-" + УникальноеИмя("ghfonfail");

	Падающий = НовыйМедленныйКаталог(0);
	Падающий.ЭмулироватьСбой();
	ВФоне = НоваяАвтовыдачаСФоном(НовыйБоевойФон(), НовыеНастройкиЗаглушки(Истина), Падающий);

	Ловушка = ЛовитьЛог();
	ВФоне.Раздать(Юзер.Идентификатор, "octofonfail", Токен);

	Ожидаем.Что(ДождатьсяЗаписи(Ловушка, "octofonfail"),
		"сбой фоновой раздачи виден на боевом уровне журнала: " + Ловушка.Всё()).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), Токен),
		"и токена в нём нет: " + Ловушка.Всё()).Равно(0);

КонецПроцедуры

// Отказ самой постановки в фон (заданий нет, очередь закрыта) — не повод ронять вход.
&Тест
Процедура ОтказЗапускаВФонВходНеРонит() Экспорт

	ОбеспечитьОсновнойПул();
	Юзер = СоздатьПользователя();
	ВФоне = НоваяАвтовыдачаСФоном(НовыйПадающийФон(), НовыеНастройкиЗаглушки(Истина), Каталог());

	Ловушка = ЛовитьЛог();
	Упало = Ложь;
	Попытка
		ВФоне.Раздать(Юзер.Идентификатор, "octofondead", "gh-" + УникальноеИмя("ghfondead"));
	Исключение
		Упало = Истина;
	КонецПопытки;

	Ожидаем.Что(Упало, "отказ постановки в фон наружу не летит").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Ловушка.Всё(), "octofondead") > 0,
		"но в журнале он назван: " + Ловушка.Всё()).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область HTTPРеализацияКаталога

&Тест
Процедура КаталогСпрашиваетGitHubПравильнымЗапросом() Экспорт

	Транспорт = НовыйФейкТранспорта();
	Транспорт.УстановитьОтвет(200, Двоичные(ВJSON(Новый Массив())));

	НовыйКаталогHTTP(Транспорт).РепозиторииСПравомЗаписи("t0ken", "octocat", "oscript-library");

	Ожидаем.Что(Транспорт.URLПоследний(), "адрес запроса репозиториев").Равно(
		"https://api.github.com/user/repos?affiliation=collaborator,organization_member"
		+ "&visibility=public&per_page=100");
	Ожидаем.Что(Транспорт.ЗаголовокПоследний("Authorization"), "токен едет заголовком").Равно("token t0ken");
	Ожидаем.Что(Транспорт.ЗаголовокПоследний("Accept")).Равно("application/vnd.github+json");
	Ожидаем.Что(Транспорт.ЗаголовокПоследний("User-Agent")).Равно("OpenHub");

КонецПроцедуры

&Тест
Процедура КаталогОтбираетПоВладельцуИПравуЗаписи() Экспорт

	Элементы = Новый Массив();
	Элементы.Добавить(Репозиторий("свой", "oscript-library", Истина));
	Элементы.Добавить(Репозиторий("чужой", "someone-else", Истина));
	Элементы.Добавить(Репозиторий("только-чтение", "oscript-library", Ложь));
	Элементы.Добавить(Репозиторий("другой-регистр", "OScript-Library", Истина));
	// имя владельца сверяется ЦЕЛИКОМ, а не вхождением: обе эти организации на GitHub
	// свободны, и по вхождению любая из них прошла бы за зеркало
	Элементы.Добавить(Репозиторий("хвост", "oscript-library-fake", Истина));
	Элементы.Добавить(Репозиторий("голова", "evil-oscript-library", Истина));

	Транспорт = НовыйФейкТранспорта();
	Транспорт.УстановитьОтвет(200, Двоичные(ВJSON(Элементы)));

	Имена = НовыйКаталогHTTP(Транспорт).РепозиторииСПравомЗаписи("t0ken", "octocat", "oscript-library");

	Ожидаем.Что(СтрСоединить(Имена, ","),
		"берём только репозитории организации, в которые есть push").Равно("свой,другой-регистр");

КонецПроцедуры

&Тест
Процедура КаталогИдётЗаСледующейСтраницей() Экспорт

	Первая = НовыйФейкПоАдресам();
	Первая.ПриАдресе(АдресСтраницы(1), 200, ВJSON(СтраницаИз(100, "п1-")));
	Первая.ПриАдресе(АдресСтраницы(2), 200, ВJSON(СтраницаИз(2, "п2-")));

	Имена = НовыйКаталогHTTP(Первая).РепозиторииСПравомЗаписи("t", "octocat", "oscript-library");

	Ожидаем.Что(Имена.Количество(), "полная страница означает следующую").Равно(102);
	Ожидаем.Что(Первая.Запросов(АдресСтраницы(2)), "за второй страницей сходили").Равно(1);
	Ожидаем.Что(Первая.Запросов(АдресСтраницы(3)), "неполная вторая страница обход останавливает").Равно(0);

КонецПроцедуры

&Тест
Процедура ОбходСтраницОграниченПотолком() Экспорт

	Транспорт = НовыйФейкТранспорта();
	// каждая страница полная — без потолка обход не кончился бы никогда
	Транспорт.УстановитьОтвет(200, Двоичные(ВJSON(СтраницаИз(100, "беск-"))));

	Имена = НовыйКаталогHTTP(Транспорт).РепозиторииСПравомЗаписи("t0ken", "octocat", "oscript-library");

	Ожидаем.Что(Транспорт.КоличествоВызовов(),
		"обход упирается в потолок в 3 страницы: 3 × 5 с — весь бюджет ожидания на входе").Равно(3);
	Ожидаем.Что(Имена.Количество()).Равно(300);

КонецПроцедуры

// Обещание «частичному списку доверия нет» проверяется на ВТОРОЙ странице: на первой
// частичный и пустой список неразличимы, и сторож там ничего не стережёт.
&Тест
Процедура СбойВторойСтраницыДаётПустойСписокАНеЧастичный() Экспорт

	Транспорт = НовыйФейкПоАдресам();
	Транспорт.ПриАдресе(АдресСтраницы(1), 200, ВJSON(СтраницаИз(100, "п1-")));
	Транспорт.ПриАдресе(АдресСтраницы(2), 500, "{""message"":""server error""}");

	Имена = НовыйКаталогHTTP(Транспорт).РепозиторииСПравомЗаписи("t0ken", "octocat", "oscript-library");

	Ожидаем.Что(Имена.Количество(),
		"недобранный хвост означает пустой список, а не первую страницу: список читают"
		+ " как полный").Равно(0);

КонецПроцедуры

&Тест
Процедура НедоступныйGitHubДаётПустойСписокБезИсключения() Экспорт

	Оффлайн = НовыйФейкТранспорта();
	Оффлайн.ЭмулироватьОффлайн();
	Ожидаем.Что(НовыйКаталогHTTP(Оффлайн).РепозиторииСПравомЗаписи("t", "octocat", "oscript-library").Количество(),
		"сетевой сбой — пустой список, а не исключение").Равно(0);

	Пятисотый = НовыйФейкТранспорта();
	Пятисотый.УстановитьОтвет(500, Двоичные("{""message"":""server error""}"));
	Ожидаем.Что(НовыйКаталогHTTP(Пятисотый).РепозиторииСПравомЗаписи("t", "octocat", "oscript-library").Количество(),
		"не-200 — пустой список").Равно(0);

	Мусор = НовыйФейкТранспорта();
	Мусор.УстановитьОтвет(200, Двоичные("не json вовсе"));
	Ожидаем.Что(НовыйКаталогHTTP(Мусор).РепозиторииСПравомЗаписи("t", "octocat", "oscript-library").Количество(),
		"мусор вместо JSON — пустой список").Равно(0);

	Объект = НовыйФейкТранспорта();
	Объект.УстановитьОтвет(200, Двоичные("{""message"":""Bad credentials""}"));
	Ожидаем.Что(НовыйКаталогHTTP(Объект).РепозиторииСПравомЗаписи("t", "octocat", "oscript-library").Количество(),
		"объект вместо массива — пустой список").Равно(0);

КонецПроцедуры

&Тест
Процедура ПустойТокенЗапросаНеДелает() Экспорт

	Транспорт = НовыйФейкТранспорта();
	Транспорт.УстановитьОтвет(200, Двоичные(ВJSON(Новый Массив())));

	Ожидаем.Что(НовыйКаталогHTTP(Транспорт).РепозиторииСПравомЗаписи("", "octocat", "oscript-library").Количество())
		.Равно(0);
	Ожидаем.Что(Транспорт.КоличествоВызовов(), "без токена запроса нет").Равно(0);

КонецПроцедуры

// Токен без областей repo/public_repo/read:org получает от GitHub штатный 200 с пустым
// массивом, и «прав действительно нет» выглядит ровно так же. Отличить одно от другого
// без журнала нельзя: X-OAuth-Scopes — единственный, кто называет реальные области.
&Тест
Процедура ПустойСписокПриИсправномОтветеОбъяснёнВЖурнале() Экспорт

	Токен = "ghu_tokenKotorogoVZhurnaleBytNeDolzhno";
	Транспорт = НовыйФейкТранспорта();
	Транспорт.УстановитьОтвет(200, Двоичные(ВJSON(Новый Массив())));
	// имя заголовка задаёт сервер, а HTTP/2 отдаёт его нижним регистром — здесь оно нижним
	// и лежит; в значении едет эхо токена: журнал обязан вычистить его из чужого значения
	Транспорт.УстановитьЗаголовокОтвета("x-oauth-scopes", "read:user, user:email, " + Токен);

	Ловушка = ЛовитьОтладку();
	Имена = НовыйКаталогHTTP(Транспорт).РепозиторииСПравомЗаписи(Токен, "octoscope", ОрганизацияЗеркала());

	Ожидаем.Что(Имена.Количество(), "КОНТРОЛЬ: список пуст — механизм отработал вхолостую").Равно(0);
	Ожидаем.Что(Ловушка.Количество(), "поход в GitHub оставляет след даже с пустым итогом").Равно(1);
	Успех = Ловушка.Сообщение(0);
	Ожидаем.Что(СтрНайти(Успех, ОрганизацияЗеркала()) > 0,
		"запись называет организацию: " + Успех).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Успех, "octoscope") > 0,
		"и логин у провайдера: " + Успех).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Успех, "read:user, user:email") > 0,
		"и области, реально выданные токену: " + Успех).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Успех, Токен),
		"токена в журнале нет ни в каком виде: " + Успех).Равно(0);

	// КОНТРОЛЬ: «не смогли спросить» — это ДРУГАЯ запись, и она называет код ответа
	Отказ = НовыйФейкТранспорта();
	Отказ.УстановитьОтвет(403, Двоичные("{""message"":""Forbidden""}"));
	НовыйКаталогHTTP(Отказ).РепозиторииСПравомЗаписи(Токен, "octoscope", ОрганизацияЗеркала());
	Ожидаем.Что(Ловушка.Сообщение(1) = Успех,
		"КОНТРОЛЬ: несостоявшийся запрос отличим от честного «прав нет»: "
		+ Ловушка.Сообщение(1)).ЭтоЛожь();
	Ожидаем.Что(ЕстьЧисло(Ловушка.Сообщение(1), 403),
		"КОНТРОЛЬ: и отличается он кодом ответа, а не оттенком формулировки: "
		+ Ловушка.Сообщение(1)).ЭтоИстина();

КонецПроцедуры

// Половина походов в GitHub кончается находкой, и она обязана быть в журнале так же, как
// пустой итог: иначе утечка токена в этой ветке некому заметить.
&Тест
Процедура НайденныеРепозиторииТожеПопадаютВЖурнал() Экспорт

	Токен = "ghu_vtorojTokenKotorogoVZhurnaleBytNeDolzhno";
	Элементы = Новый Массив();
	Элементы.Добавить(Репозиторий("ghfound-a", ОрганизацияЗеркала(), Истина));
	Элементы.Добавить(Репозиторий("ghfound-b", ОрганизацияЗеркала(), Истина));
	Транспорт = НовыйФейкТранспорта();
	Транспорт.УстановитьОтвет(200, Двоичные(ВJSON(Элементы)));
	Транспорт.УстановитьЗаголовокОтвета("X-OAuth-Scopes", "repo, read:org, " + Токен);

	Ловушка = ЛовитьОтладку();
	Имена = НовыйКаталогHTTP(Транспорт).РепозиторииСПравомЗаписи(Токен, "octofound", ОрганизацияЗеркала());

	Ожидаем.Что(Имена.Количество(), "КОНТРОЛЬ: репозитории нашлись").Равно(2);
	Ожидаем.Что(Ловушка.Количество(), "непустой итог тоже оставляет след").Равно(1);
	Запись = Ловушка.Сообщение(0);
	Ожидаем.Что(СтрНайти(Запись, ОрганизацияЗеркала()) > 0,
		"запись называет организацию: " + Запись).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Запись, "octofound") > 0,
		"и логин у провайдера: " + Запись).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Запись, "repo, read:org") > 0,
		"и области токена: " + Запись).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Запись, Токен),
		"токена нет и в этой ветке: " + Запись).Равно(0);

	// КОНТРОЛЬ, отличающийся РОВНО находкой: та же организация, тот же логин, те же области.
	// Если исходы схлопнутся, журнал скажет «репозиториев нет» рядом со строкой автовыдачи
	// с ненулевым числом — и читающий инцидент поверит первой
	Пустой = НовыйФейкТранспорта();
	Пустой.УстановитьОтвет(200, Двоичные(ВJSON(Новый Массив())));
	Пустой.УстановитьЗаголовокОтвета("X-OAuth-Scopes", "repo, read:org, " + Токен);
	НовыйКаталогHTTP(Пустой).РепозиторииСПравомЗаписи(Токен, "octofound", ОрганизацияЗеркала());

	Ожидаем.Что(Ловушка.Сообщение(1) = Запись,
		"КОНТРОЛЬ: находка и пустой итог — разные записи: " + Ловушка.Сообщение(1)).ЭтоЛожь();

КонецПроцедуры

// Три ответа GitHub про области — «вот они», «ни одной не выдано» и «заголовка не прислал» —
// обязаны читаться по-разному: второй и есть боевой случай, ради которого трек заведён.
&Тест
Процедура ОбластиТокенаРазличаютТриИсхода() Экспорт

	Ловушка = ЛовитьОтладку();

	Заданы = НовыйФейкТранспорта();
	Заданы.УстановитьОтвет(200, Двоичные(ВJSON(Новый Массив())));
	Заданы.УстановитьЗаголовокОтвета("X-OAuth-Scopes", "public_repo");
	НовыйКаталогHTTP(Заданы).РепозиторииСПравомЗаписи("t0ken", "octoscopes", ОрганизацияЗеркала());
	Ожидаем.Что(СтрНайти(Ловушка.Сообщение(0), "public_repo") > 0,
		"выданные области названы дословно: " + Ловушка.Сообщение(0)).ЭтоИстина();

	Пустые = НовыйФейкТранспорта();
	Пустые.УстановитьОтвет(200, Двоичные(ВJSON(Новый Массив())));
	Пустые.УстановитьЗаголовокОтвета("X-OAuth-Scopes", "");
	НовыйКаталогHTTP(Пустые).РепозиторииСПравомЗаписи("t0ken", "octoscopes", ОрганизацияЗеркала());

	БезЗаголовка = НовыйФейкТранспорта();
	БезЗаголовка.УстановитьОтвет(200, Двоичные(ВJSON(Новый Массив())));
	НовыйКаталогHTTP(БезЗаголовка).РепозиторииСПравомЗаписи("t0ken", "octoscopes", ОрганизацияЗеркала());

	Ожидаем.Что(Ловушка.Количество(), "каждый из трёх походов оставил запись").Равно(3);
	Ожидаем.Что(РазныхСообщений(Ловушка),
		"«области выданы», «областей не выдано» и «заголовка нет» — три разных ответа,"
		+ " иначе журнал не отвечает, почему прав нет: " + Ловушка.Всё()).Равно(3);

	// вырождение опаснее подмены: значение, схлопнувшееся в пустоту, обрывает запись
	// на двоеточии, и различность соседей это пропускает
	Для Номер = 0 По 2 Цикл
		Ожидаем.Что(ЗначениеЗаполнено(ХвостПослеМаркера(Ловушка.Сообщение(Номер), "X-OAuth-Scopes")),
			"после имени заголовка в записи стоит значение, а не пустота: "
			+ Ловушка.Сообщение(Номер)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Не-200 и мусор вместо списка молчали вовсе: пустой список доезжал до раздачи, и та так же
// тихо ничего не делала.
&Тест
Процедура НесостоявшийсяЗапросВGitHubНеМолчит() Экспорт

	Ловушка = ЛовитьЛог();

	Отказ = НовыйФейкТранспорта();
	Отказ.УстановитьОтвет(403, Двоичные("{""message"":""Forbidden""}"));
	НовыйКаталогHTTP(Отказ).РепозиторииСПравомЗаписи("t0ken", "octofail", ОрганизацияЗеркала());
	Ожидаем.Что(Ловушка.Количество(), "не-200 оставляет запись").Равно(1);
	Ожидаем.Что(ЕстьЧисло(Ловушка.Сообщение(0), 403),
		"и называет код ответа: " + Ловушка.Сообщение(0)).ЭтоИстина();

	НеСписок = НовыйФейкТранспорта();
	НеСписок.УстановитьОтвет(200, Двоичные("{""message"":""Bad credentials""}"));
	НовыйКаталогHTTP(НеСписок).РепозиторииСПравомЗаписи("t0ken", "octofail", ОрганизацияЗеркала());
	Ожидаем.Что(Ловушка.Количество(), "200 не списком оставляет запись").Равно(2);

	Оффлайн = НовыйФейкТранспорта();
	Оффлайн.ЭмулироватьОффлайн();
	НовыйКаталогHTTP(Оффлайн).РепозиторииСПравомЗаписи("t0ken", "octofail", ОрганизацияЗеркала());
	Ожидаем.Что(Ловушка.Количество(), "недоступный GitHub оставляет запись").Равно(3);

	Для Номер = 0 По 2 Цикл
		Ожидаем.Что(СтрНайти(Ловушка.Сообщение(Номер), "octofail") > 0,
			"каждая запись называет, кому не досталось прав: " + Ловушка.Сообщение(Номер)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Раздать(Знач Юзер, Знач Токен)
	Желудь("АвтовыдачаПравGitHub").Раздать(Юзер.Идентификатор, "octocat", Токен);
КонецПроцедуры

// Организация зеркала этого набора — намеренно НЕ умолчание детальки.
Функция ОрганизацияЗеркала()
	Возврат "mirror-org-test";
КонецФункции

// Своя сборка автовыдачи с подменённым резолвером настроек: контейнерный желудь один
// на набор, а проверяются именно запасные ветки чтения опции. Запуск синхронный —
// исход раздачи виден сразу после вызова.
Функция НоваяАвтовыдача(Знач Настройки)
	Возврат НоваяАвтовыдачаСФоном(Желудь("ЗапускВФоне"), Настройки, Каталог());
КонецФункции

// Сборка автовыдачи с ЛЮБЫМ запуском и каталогом: так проверяется боевой фон.
Функция НоваяАвтовыдачаСФоном(Знач Фон, Знач Настройки, Знач КаталогРепозиториев)
	Возврат Новый АвтовыдачаПравПоGitHub(Фон,
		Желудь("ХранилищеПользователей"), Желудь("СервисПулов"), Желудь("СервисПакетов"),
		Желудь("ПравилаИменования"), Желудь("СервисПрав"), Желудь("СервисПравДоступа"),
		КаталогРепозиториев, Настройки, ЛогТестов());
КонецФункции

// Боевой запуск в фон — тот самый, что собирает контейнер хаба. Класс подключается
// ПОСЛЕ сборки контейнера: его прозвище в наборе занимает синхронный фейк.
Функция НовыйБоевойФон()
	ПодключитьФайл(ОбъединитьПути(КаталогМодулей_, "фоновыеЗадания", "Классы", "ЗапускВФонеЗаданием.os"));
	Возврат Новый ЗапускВФонеЗаданием();
КонецФункции

Функция НовыйПадающийФон()
	ПодключитьФайл(ОбъединитьПути(КаталогТестов_, "фикстуры", "ЗапускВФонеПадающий.os"));
	Возврат Новый ЗапускВФонеПадающий();
КонецФункции

// Свой каталог-фейк на тест: контейнерный один на набор, а фоновые тесты живут дольше
// собственного вызова и перетирали бы соседям и режим сбоя, и счётчик.
Функция НовыйМедленныйКаталог(Знач ЗадержкаМС)
	Свой = Новый ФейкКаталогаРепозиториевGitHub();
	Свой.ОтвечатьДолго(ЗадержкаМС);
	Возврат Свой;
КонецФункции

// Сколько «отвечает GitHub» в тестах фона: заметно больше любого разумного возврата
// из Раздать и заметно меньше терпения прогона.
Функция ЗадержкаКаталогаМС()
	Возврат 3000;
КонецФункции

// Ждёт роль на пакете: фоновая работа завершается не мгновенно, но и не бесконечно.
Функция ДождатьсяРоли(Знач Юзер, Знач Пакет, Знач Роль)

	Рубеж = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТерпениеФонаМС();
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Рубеж Цикл
		Если РольНаПакете(Юзер, Пакет) = Роль Тогда
			Возврат Истина;
		КонецЕсли;
		Приостановить(100);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ДождатьсяЗаписи(Знач Ловушка, Знач Образец)

	Рубеж = ТекущаяУниверсальнаяДатаВМиллисекундах() + ТерпениеФонаМС();
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Рубеж Цикл
		Если СтрНайти(Ловушка.Всё(), Образец) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
		Приостановить(100);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ТерпениеФонаМС()
	Возврат 15000;
КонецФункции

// Заглушка настроек: Неопределено означает «ключ не задан» — чтение бросает исключение.
Функция НовыеНастройкиЗаглушки(Знач Значение)
	ПодключитьФайл(ОбъединитьПути(КаталогТестов_, "фикстуры", "НастройкиЗаглушка.os"));
	Заглушка = Новый НастройкиЗаглушка();
	Заглушка.Задать("oshub.publish.github.org", ОрганизацияЗеркала());
	Если Значение <> Неопределено Тогда
		Заглушка.Задать("oshub.publish.github_legacy", Значение);
	КонецЕсли;
	Возврат Заглушка;
КонецФункции

Функция ПодписатьсяНаПрава()
	ПодключитьФайл(ОбъединитьПути(КаталогТестов_, "фикстуры", "ЗаписывающийПодписчик.os"));
	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель = Желудь("ИздательСобытий");
	Издатель.Подписать(Издатель.ТипПраваИзменены(), Слушатель);
	Возврат Слушатель;
КонецФункции

Функция ПоследнееСобытиеПрав(Знач Слушатель)
	Возврат ?(Слушатель.События.Количество() = 0, Неопределено,
		Слушатель.События[Слушатель.События.ВГраница()]);
КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.автовыдача");
КонецФункции

// Накопитель записей журнала на время теста; снимается в ПослеКаждого, чтобы соседний
// набор не читал чужие сообщения. Уровень — боевой по умолчанию: запись, уехавшая
// на Отладку, в бою не пишется и здесь не ловится.
Функция ЛовитьЛог()
	Возврат ЛовитьЛогНаУровне(УровниЛога.Информация);
КонецФункции

// То же, но с поднятой отладкой — как разбирают инцидент в бою.
Функция ЛовитьОтладку()
	Возврат ЛовитьЛогНаУровне(УровниЛога.Отладка);
КонецФункции

Функция ЛовитьЛогНаУровне(Знач Уровень)

	ОтпуститьЛог();
	ПодключитьФайл(ОбъединитьПути(КаталогТестов_, "фикстуры", "ЛовушкаЛога.os"));
	Ловушка_ = Новый ЛовушкаЛога();
	Лог = ЛогТестов();
	Лог.УстановитьУровень(Уровень);
	Лог.ДобавитьСпособВывода(Ловушка_);

	Возврат Ловушка_;

КонецФункции

Процедура ОтпуститьЛог()

	Если Ловушка_ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЛогТестов().УдалитьСпособВывода(Ловушка_);
	Ловушка_ = Неопределено;

КонецПроцедуры

// Числа, названные записью, ищутся значением: сторож стережёт данные записи, а не слова
// вокруг них, и переформулировка сообщения его не ломает.
Функция ЕстьЧисло(Знач Текст, Знач Значение)

	Для Каждого Найденное Из ЧислаИз(Текст) Цикл
		Если Найденное = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЧислаИз(Знач Текст)

	Числа = Новый Массив();
	Текущее = "";

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Текущее = Текущее + Символ;
		ИначеЕсли ЗначениеЗаполнено(Текущее) Тогда
			Числа.Добавить(Число(Текущее));
			Текущее = "";
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Текущее) Тогда
		Числа.Добавить(Число(Текущее));
	КонецЕсли;

	Возврат Числа;

КонецФункции

// Значение, стоящее в записи за именем заголовка: пусто — значит запись оборвалась
// на разделителе. Скобки и двоеточия разделителями и остаются, значением их не считаем.
Функция ХвостПослеМаркера(Знач Запись, Знач Маркер)

	Позиция = СтрНайти(Запись, Маркер);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Запись, Позиция + СтрДлина(Маркер));
	Возврат СокрЛП(СтрЗаменить(СтрЗаменить(Хвост, ")", " "), ":", " "));

КонецФункции

Функция РазныхСообщений(Знач Ловушка)

	Разные = Новый Соответствие();
	Для Номер = 0 По Ловушка.Количество() - 1 Цикл
		Разные.Вставить(Ловушка.Сообщение(Номер), Истина);
	КонецЦикла;

	Возврат Разные.Количество();

КонецФункции

Функция Каталог()
	Возврат Желудь("КаталогРепозиториевGitHub");
КонецФункции

Функция Права()
	Возврат Желудь("СервисПрав");
КонецФункции

Функция Доступ()
	Возврат Желудь("СервисПравДоступа");
КонецФункции

Функция РольНаПакете(Знач Юзер, Знач Пакет)
	Возврат Права().РольНаОбъекте(Юзер, Права().ОбъектПакет(Пакет));
КонецФункции

Функция ГрантовУ(Знач Юзер)
	Возврат Доступ().ГрантыСубъекта("пользователь", Юзер.Идентификатор).Количество();
КонецФункции

Процедура ВключитьЛегаси(Знач Значение)
	Желудь("СервисНастроек").Установить("oshub.publish.github_legacy", Значение, Неопределено);
КонецПроцедуры

Функция Набор(Знач Создание, Знач Изменение, Знач Удаление, Знач Чтение)
	Возврат Новый Структура("создание, изменение, удаление, чтение", Создание, Изменение, Удаление, Чтение);
КонецФункции

Функция СоздатьПользователя(Знач РольХаба = "user")
	Польз = Желудь("ХранилищеПользователей").СоздатьЭлемент();
	Польз.Логин = УникальноеИмя("user");
	Польз.Email = Польз.Логин + "@example.com";
	Польз.Активен = Истина;
	Польз.РольХаба = РольХаба;
	Польз.Создан = ТекущаяУниверсальнаяДата();
	Польз.Сохранить();
	Возврат Польз;
КонецФункции

Функция СоздатьПул()
	Возврат Желудь("СервисПулов").СоздатьПул(УникальноеИмя("pool"), "custom", "public");
КонецФункции

Функция ОбеспечитьОсновнойПул()
	Пулы = Желудь("СервисПулов");
	Существующий = Пулы.ДефолтныйПул();
	Если Существующий <> Неопределено Тогда
		Возврат Существующий;
	КонецЕсли;
	Возврат Пулы.НазначитьПулПоУмолчанию(СоздатьПул().Идентификатор, "тест");
КонецФункции

// Признак основного пула снимается и возвращается напрямую: сервис умеет только
// переносить его на другой пул, а сценарию нужен хаб вовсе без основного пула.
Процедура УстановитьПризнакОсновного(Знач Пул, Знач Значение)
	Запись = Желудь("ХранилищеПулов").ПолучитьОдноПоИдентификаторРавно(Пул.Идентификатор);
	Запись.ПоУмолчанию = Значение;
	Запись.Сохранить();
КонецПроцедуры

Функция СоздатьПакет(Знач Пул, Знач Имя)
	Возврат Желудь("СервисПакетов").ЗарегистрироватьПакет(Пул.Идентификатор, Имя);
КонецФункции

Функция УникальноеИмя(Знач Префикс)
	Счётчик = Счётчик + 1;
	Возврат Префикс + "-" + Формат(Счётчик, "ЧГ=0; ЧН=0");
КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

// HTTP-реализация каталога создаётся напрямую: её прозвище в контейнере занял фейк,
// а разбор ответа GitHub проверяется именно на ней.
Функция НовыйКаталогHTTP(Знач Транспорт)
	ПоискКлассов.Подключить(КаталогМодулей_, "КаталогРепозиториевGitHubHTTP");
	Возврат Новый КаталогРепозиториевGitHubHTTP(Транспорт, "api.github.com", ЛогТестов());
КонецФункции

Функция НовыйФейкТранспорта()
	ПодключитьФайл(ОбъединитьПути(КаталогТестов_, "фикстуры", "ФейкТранспортHTTP.os"));
	Возврат Новый ФейкТранспортHTTP();
КонецФункции

Функция НовыйФейкПоАдресам()
	ПодключитьФайл(ОбъединитьПути(КаталогТестов_, "фикстуры", "ФейкТранспортHTTPПоАдресам.os"));
	Возврат Новый ФейкТранспортHTTPПоАдресам();
КонецФункции

Функция АдресСтраницы(Знач Номер)
	Адрес = "https://api.github.com/user/repos?affiliation=collaborator,organization_member"
		+ "&visibility=public&per_page=100";
	Возврат ?(Номер <= 1, Адрес, Адрес + "&page=" + Формат(Номер, "ЧГ=0"));
КонецФункции

Функция СтраницаИз(Знач Количество, Знач Префикс)
	Элементы = Новый Массив();
	Для Номер = 1 По Количество Цикл
		Элементы.Добавить(Репозиторий(Префикс + Формат(Номер, "ЧГ=0"), "oscript-library", Истина));
	КонецЦикла;
	Возврат Элементы;
КонецФункции

Функция Репозиторий(Знач Имя, Знач Владелец, Знач Push)
	Права_ = Новый Соответствие();
	Права_.Вставить("push", Push);
	Влад = Новый Соответствие();
	Влад.Вставить("login", Владелец);
	Элемент = Новый Соответствие();
	Элемент.Вставить("name", Имя);
	Элемент.Вставить("owner", Влад);
	Элемент.Вставить("permissions", Права_);
	Возврат Элемент;
КонецФункции

Функция ВJSON(Знач Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция Двоичные(Знач Текст)
	Возврат ПолучитьДвоичныеДанныеИзСтроки(Текст);
КонецФункции

Процедура ПодключитьКаталог(Знач КаталогКлассов)
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;
КонецПроцедуры

Процедура ПодключитьФайл(Знач Путь)
	Имя = Новый Файл(Путь).ИмяБезРасширения;
	Если НЕ ТипЗарегистрирован(Имя) Тогда
		ПодключитьСценарий(Путь, Имя);
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

#КонецОбласти
