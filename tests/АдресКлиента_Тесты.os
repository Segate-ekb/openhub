// Канон записи IP-адреса и ведро ограничителя по нему: любая запись одного адреса —
// один объект и один счёт, адреса одной сети /64 — тоже один.

#Использовать asserts
#Использовать "фикстуры"

Перем Канон;   // КанонIP (основа)
Перем Ведра;   // ВедроОграничителяПоАдресу (вход)

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	Поиск = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	Поиск.Подключить(ОбъединитьПути(Модули, "основа", "Классы"), "КанонIP");
	Поиск.Подключить(ОбъединитьПути(Модули, "вход", "Классы"), "ВедроОграничителяПоАдресу");

	Канон = Новый КанонIP();
	Ведра = Новый ВедроОграничителяПоАдресу(Канон);

КонецПроцедуры

#Область КанонЗаписи

&Тест
Процедура ЗаписиОдногоАдресаДаютОдинКанон() Экспорт

	// «::ffff:a.b.c.d» присылает сам веб-сервер на двойном стеке; регистр и развёрнутая
	// запись IPv6 приходят из чужих логов и из рук оператора
	Ожидаем.Что(Канон.Строкой("::ffff:192.0.2.1"), "отображённый IPv4 — это IPv4")
		.Равно("192.0.2.1");
	Ожидаем.Что(Канон.Строкой("192.0.2.1"), "IPv4 остаётся собой").Равно("192.0.2.1");
	Ожидаем.Что(Канон.Строкой("2001:DB8::1"), "верхний регистр").Равно("2001:db8::1");
	Ожидаем.Что(Канон.Строкой("2001:0db8:0000:0000:0000:0000:0000:0001"), "развёрнутая запись")
		.Равно("2001:db8::1");
	Ожидаем.Что(Канон.Строкой("  198.51.100.9  "), "обрамляющие пробелы").Равно("198.51.100.9");

КонецПроцедуры

&Тест
Процедура НеАдресКанонаНеПолучает() Экспорт

	Векторы = "вчера,999.1.1.1,1.2.3,localhost,192.0.2.1:80, ,";

	Непонятые = Новый Массив();
	Для Каждого Вектор Из СтрРазделить(Векторы, ",", Истина) Цикл
		Если ЗначениеЗаполнено(Канон.Строкой(Вектор)) Тогда
			Непонятые.Добавить("«" + Вектор + "»");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Непонятые, ", "), "не адрес принят за адрес").Равно("");
	Ожидаем.Что(Канон.Адрес(Неопределено), "адреса нет вовсе").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область Сети

&Тест
Процедура СетьПринимаетНеканоническуюБазуИОбнуляетЕё() Экспорт

	// оператор пишет сеть от знакомого ему адреса: строгий конструктор библиотеки
	// отверг бы «10.1.2.3/8», и настройка молча осталась бы пустой
	Ожидаем.Что(Канон.Сеть("10.1.2.3/8").ВСтроку(), "база обнулена").Равно("10.0.0.0/8");
	Ожидаем.Что(Канон.Сеть("2001:db8:0:1::42/64").ВСтроку(), "IPv6 /64").Равно("2001:db8:0:1::/64");
	Ожидаем.Что(Канон.Сеть("10.0.0.0/8").ВСтроку(), "каноническая запись").Равно("10.0.0.0/8");

КонецПроцедуры

&Тест
Процедура НегоднаяСетьНеРазбирается() Экспорт

	Векторы = "10.0.0.0/33,2001:db8::/129,10.0.0.0/,10.0.0.0/восемь,10.0.0.0,мусор/8";

	Принятые = Новый Массив();
	Для Каждого Вектор Из СтрРазделить(Векторы, ",", Истина) Цикл
		Если Канон.Сеть(Вектор) <> Неопределено Тогда
			Принятые.Добавить("«" + Вектор + "»");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Принятые, ", "), "негодная запись принята за сеть").Равно("");

КонецПроцедуры

&Тест
Процедура ВхождениеВСетьЧитаетОтображённыйIPv4() Экспорт

	Сеть = Канон.Сеть("10.0.0.0/8");

	Ожидаем.Что(Канон.ВСети(Сеть, "10.1.2.3"), "свой адрес").ЭтоИстина();
	// без разворота отображённого IPv4 семейства не совпадают, и вся сеть перестаёт
	// узнавать собственные адреса ровно на том веб-сервере, который их так и присылает
	Ожидаем.Что(Канон.ВСети(Сеть, "::ffff:10.1.2.3"), "тот же адрес отображённым").ЭтоИстина();
	Ожидаем.Что(Канон.ВСети(Сеть, "11.1.2.3"), "чужой адрес").ЭтоЛожь();
	Ожидаем.Что(Канон.ВСети(Сеть, "2001:db8::1"), "другое семейство").ЭтоЛожь();
	Ожидаем.Что(Канон.ВСети(Сеть, "мусор"), "не адрес").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура СписокСетейНазываетПервуюНегоднуюЗапись() Экспорт

	Годный = Канон.Список(" 10.0.0.0/8 , 2001:db8::/32 ");
	Ожидаем.Что(Годный.Сети.Количество(), "разобраны обе сети").Равно(2);
	Ожидаем.Что(Годный.Негодная, "негодных записей нет").Равно("");

	Пустой = Канон.Список("");
	Ожидаем.Что(Пустой.Сети.Количество(), "пустая настройка — пустой список").Равно(0);
	Ожидаем.Что(Пустой.Негодная, "и это не ошибка").Равно("");

	Битый = Канон.Список("10.0.0.0/8, 10.0.0/8, 192.168.0.0/16");
	Ожидаем.Что(Битый.Негодная, "названа именно негодная запись").Равно("10.0.0/8");

КонецПроцедуры

#КонецОбласти

#Область ВедроОграничителя

&Тест
Процедура РазныеЗаписиОдногоАдресаДаютОдноВедро() Экспорт

	Ожидаем.Что(Ведра.Ведро("::ffff:192.0.2.1"), "отображённый IPv4")
		.Равно(Ведра.Ведро("192.0.2.1"));
	Ожидаем.Что(Ведра.Ведро("2001:DB8::1"), "верхний регистр")
		.Равно(Ведра.Ведро("2001:db8::1"));
	Ожидаем.Что(Ведра.Ведро("2001:0db8:0000:0000:0000:0000:0000:0001"), "развёрнутая запись")
		.Равно(Ведра.Ведро("2001:db8::1"));

	Ожидаем.Что(Ведра.Ключ("ip", "::ffff:192.0.2.1"), "ключ собирается из назначения и ведра")
		.Равно("ip:192.0.2.1");

КонецПроцедуры

&Тест
Процедура АдресаОднойСети64ДелятВедроАСоседняяСетьНет() Экспорт

	// у клиента IPv6 внутри своей /64 адресов 2^64: счёт по адресу без сети
	// не стоит перебирающему ничего
	Первый = Ведра.Ведро("2001:db8:0:1::1");
	Второй = Ведра.Ведро("2001:db8:0:1:dead:beef:0:2");

	Ожидаем.Что(Первый, "ведро — сеть /64, а не адрес").Равно("2001:db8:0:1::/64");
	Ожидаем.Что(Второй, "сосед по /64 в том же ведре").Равно(Первый);
	Ожидаем.Что(Ведра.Ведро("2001:db8:0:2::1") = Первый, "соседняя /64 — своё ведро").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПереводNAT64ВедраIPv4НеЗанимает() Экспорт

	// «64:ff9b::c000:201» — это IPv4 192.0.2.1, доставленный через шлюз NAT64, но НЕ он сам:
	// разверни его канон — и клиент за шлюзом сел бы в ведро постороннего IPv4, а замок
	// одного запирал бы другого
	Перевод = Ведра.Ведро("64:ff9b::c000:201");

	Ожидаем.Что(Перевод, "ведро перевода — его собственная сеть /64").Равно("64:ff9b::/64");
	Ожидаем.Что(Перевод = Ведра.Ведро("192.0.2.1"),
		"и это не ведро того IPv4, который через шлюз доставлен").ЭтоЛожь();
	Ожидаем.Что(Канон.Строкой("64:ff9b::c000:201"), "канон перевод не разворачивает")
		.Равно("64:ff9b::c000:201");

КонецПроцедуры

&Тест
Процедура ОкрестностьНуляIPv4НеЗаворачивает() Экспорт

	// «::» и «::1» формально лежат в совместимом «::/96»: разверни их — и незаданный адрес
	// с петлёй превратились бы в 0.0.0.0 и 0.0.0.1
	Ожидаем.Что(Канон.ВложенныйIPv4(Канон.Разобрать("::")), "незаданный адрес")
		.Равно(Неопределено);
	Ожидаем.Что(Канон.ВложенныйIPv4(Канон.Разобрать("::1")), "петля").Равно(Неопределено);

	// КОНТРОЛЬ: соседи по тому же префиксу вложенный IPv4 отдают
	Ожидаем.Что(Канон.ВложенныйIPv4(Канон.Разобрать("::7f00:1")).ВСтроку(),
		"совместимая запись IPv4").Равно("127.0.0.1");
	Ожидаем.Что(Канон.ВложенныйIPv4(Канон.Разобрать("64:ff9b::c000:201")).ВСтроку(),
		"перевод NAT64").Равно("192.0.2.1");
	Ожидаем.Что(Канон.ВложенныйIPv4(Канон.Разобрать("::ffff:127.0.0.1")).ВСтроку(),
		"отображённый IPv4 остаётся отображённым IPv4").Равно("127.0.0.1");

КонецПроцедуры

&Тест
Процедура ВедроIPv4ЭтоСамАдрес() Экспорт

	Ожидаем.Что(Ведра.Ведро("192.0.2.1"), "IPv4 считается сам по себе").Равно("192.0.2.1");
	Ожидаем.Что(Ведра.Ведро("192.0.2.2") = Ведра.Ведро("192.0.2.1"),
		"соседний адрес — своё ведро").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура НеизвестныйАдресВедраНеПолучает() Экспорт

	// общее ведро «неизвестный» запирало бы всех разом: чужие запросы приписывать некому
	Ожидаем.Что(Ведра.Ведро(""), "пустой адрес").Равно("");
	Ожидаем.Что(Ведра.Ведро("не-адрес"), "неразобранный адрес").Равно("");
	Ожидаем.Что(Ведра.Ключ("ip", ""), "ключа тоже нет").Равно("");

КонецПроцедуры

#КонецОбласти
