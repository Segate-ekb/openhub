// Интеграционные тесты тегов: СервисТегов, СоставКаналов, ПравилоТега, ОтборВерсийПоПравилу, НаблюдательКаналов и
// ЛетописьТегов в контейнере ОСени. Тег — КАНАЛ ОБНОВЛЕНИЯ: «pkg@tag» отдаёт максимум среди версий канала, кроме
// отозванных. Состав тега-ПРАВИЛА нигде не хранится — он считается правилом при каждом обращении и потому меняется
// сам вслед за правилом и за публикацией; состав РУЧНОГО тега лежит в МеткиТегов, и его ведёт человек.
// Бэкенд — КоннекторInMemory, отдельный процесс.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем Поделка;          // общий контейнер на все тесты набора
Перем НомерПула;        // уникализация имён пулов между тестами
Перем КореньХранилища;  // временный корень файлового хранилища артефактов

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	НомерПула = 0;
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src"), "модули");

	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("данные", "Классы")));
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("настройки", "Классы")));
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("реестр", "Классы")));
	// storage: занятое пулом меряется по хранилищу (УчётОбъёмаПула), поэтому реестру
	// нужен бэкенд артефактов — файловый, во временном каталоге набора
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("хранилище", "Классы")));
	// НАСТОЯЩИЙ издатель событий: тест подписки обязан идти через него, а не через фейк
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("события", "Классы")));
	// служба аудита — проверяем, что переезд тега доезжает до журнала
	ПодключитьКлассыКаталога(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("аудит", "Классы")));
	// ГотовностьХаба — гейт стартовых задач: без желудя бины рогаток модуля не собираются
	Попытка
		ПодключитьСценарий(ОбъединитьПути(КаталогМодулей,
			ОбъединитьПути("наблюдаемость", ОбъединитьПути("Классы/пробы", "ГотовностьХаба.os"))),
			"ГотовностьХаба");
	Исключение
	КонецПопытки;
	// издателю нужен желудь «Телеметрия» (в этом контейнере выключенный, no-op)
	КаталогObs = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/телеметрия"));
	КаталогПроб = ОбъединитьПути(КаталогМодулей, ОбъединитьПути("наблюдаемость", "Классы/пробы"));
	ПодключитьОдинКласс(КаталогObs, "БуферСпанов");
	ПодключитьОдинКласс(КаталогObs, "СпанХаба");
	ПодключитьОдинКласс(КаталогObs, "Телеметрия");

	// SSRF-гейт апстримов: СервисПулов требует валидатор адреса обязательно (fail-closed)
	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();

	// фейк-подписчик: им проверяется МАРШРУТИЗАЦИЯ события по типу, а не только запись
	РеестрФикстур.Подключить("ФейкПодписчик");

	// сборщик карточки (api) и считающая обёртка сервиса тегов: ими закрыт N+1 на анонимном горячем пути карточки
	ПодключитьОдинКласс(ОбъединитьПути(КаталогМодулей, ОбъединитьПути("api", "Классы")),
		"СборщикКарточкиПакета");
	РеестрФикстур.Подключить("СчитающийСервисТегов");

	РеестрФикстур.Подключить("ЖурналАудитаФайлом");

	Детальки = Новый Соответствие();
	// свой корень хранилища: журнал аудита пишется в файл под ним, и соседние наборы
	// (в том числе параллельный прогон) не должны видеть чужих записей
	КореньХранилища = ОбъединитьПути(КаталогВременныхФайлов(),
		"oshub-теги-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(КореньХранилища);
	Детальки.Вставить("oshub.storage.root", КореньХранилища);

	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "теги-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

КонецПроцедуры

&ПослеВсех
Процедура УбратьХранилище() Экспорт
	Попытка
		Если ЗначениеЗаполнено(КореньХранилища) И Новый Файл(КореньХранилища).Существует() Тогда
			УдалитьФайлы(КореньХранилища);
		КонецЕсли;
	Исключение
	КонецПопытки;
КонецПроцедуры

&Тест
Процедура ЖелудиТеговРегистрируются() Экспорт
	Имена = "СервисТегов,СоставКаналов,ОтборВерсийПоПравилу,РежимТега,ТипПравилаТега,"
		+ "ЛетописьТегов,НаблюдательКаналов,ХранилищеТегов,ХранилищеМетокТегов";
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Ожидаем.Что(Поделка.НайтиЖелудь(Имя), СтрШаблон("желудь %1", Имя)).Существует();
	КонецЦикла;
КонецПроцедуры

// Тег-правило отбирает ВСЕ подходящие версии, а не одну, и «какие версии в канале» — вопрос с ответом. Ответ считается
// правилом при обращении: в базе состава тега-правила нет ни строки.
&Тест
Процедура ПравилоОтбираетВсеПодходящиеВерсии() Экспорт

	Пакет = НовыйПакетСВерсиями("one", "1.0.0,1.2.0,2.0.0");
	Теги = Теги();

	Тег = Теги.ОпределитьТегПравила(Пакет.Идентификатор, "lts", "semver", "^1.0");

	// в канале ОБЕ версии ветки 1.x — это и есть состав канала
	Ожидаем.Что(СтрокиСостава(Тег), "состав канала").Равно("1.0.0,1.2.0");
	Ожидаем.Что(Теги.ВерсияТега(Тег).Версия, "резолв — максимум в канале").Равно("1.2.0");
	Ожидаем.Что(МетокВХранилище(Тег), "состав НЕ материализован").Равно(0);

	// повторное определение того же имени НЕ создаёт вторую строку (коллизия имён)
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "LTS", "semver", "^2.0");
	Ожидаем.Что(ТеговСИменем(Пакет.Идентификатор, "lts"), "одно имя — одна строка тега").Равно(1);
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "lts").Версия, "правило переопределено").Равно("2.0.0");

КонецПроцедуры

// Смена правила меняет состав СРАЗУ: состав канала — функция ТЕКУЩЕГО правила, а не история и не набор строк в базе.
&Тест
Процедура СменаПравилаМеняетСоставСразу() Экспорт

	Пакет = НовыйПакетСВерсиями("swap", "1.0.0,1.2.0,2.0.0,2.1.0");
	Теги = Теги();

	Тег = Теги.ОпределитьТегПравила(Пакет.Идентификатор, "line", "semver", "^1.0");
	Ожидаем.Что(СтрокиСостава(Тег), "ветка 1.x в канале").Равно("1.0.0,1.2.0");

	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "line", "semver", "^2.0");

	Обновлённый = Теги.НайтиТег(Пакет.Идентификатор, "line");
	Ожидаем.Что(СтрокиСостава(Обновлённый),
		"старые версии выпали, новые вошли").Равно("2.0.0,2.1.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "line").Версия).Равно("2.1.0");
	Ожидаем.Что(МетокВХранилище(Обновлённый), "и ни одной строки состава в базе").Равно(0);

КонецПроцедуры

// Перевод РУЧНОГО тега в режим правила снимает его метки: они пережили бы смену режима и вернулись бы, если тег
// когда-нибудь переведут обратно, — состав канала стал бы историей, а не функцией правила.
&Тест
Процедура ПереводРучногоВПравилоСнимаетМетки() Экспорт

	Пакет = НовыйПакетСВерсиями("mode-clean", "1.0.0,2.0.0");
	Теги = Теги();

	Теги.ПометитьВерсию(Пакет.Идентификатор, "chan", "1.0.0", "alice");
	Ручной = Теги.НайтиТег(Пакет.Идентификатор, "chan");
	Ожидаем.Что(МетокВХранилище(Ручной), "у ручного канала метка есть").Равно(1);

	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "chan", "semver", "^2.0", "alice");

	Правило = Теги.НайтиТег(Пакет.Идентификатор, "chan");
	Ожидаем.Что(МетокВХранилище(Правило), "метки прежнего режима сняты").Равно(0);
	Ожидаем.Что(СтрокиСостава(Правило), "состав считается правилом").Равно("2.0.0");

	// и обратный перевод не воскрешает старый состав
	Теги.ПереместитьТег(Пакет.Идентификатор, "chan", "2.0.0", "alice");
	Ожидаем.Что(СтрокиСостава(Теги.НайтиТег(Пакет.Идентификатор, "chan")),
		"ручной канал начинается с того, что поставили").Равно("2.0.0");

КонецПроцедуры

// Ручной канал живёт на нескольких версиях: их помечают по одной, «pkg@lts» отдаёт максимум среди помеченных.
&Тест
Процедура РучнойКаналЖивётНаНесколькихВерсиях() Экспорт

	Пакет = НовыйПакетСВерсиями("multi", "1.0.0,1.4.7,2.0.0");
	Теги = Теги();

	Теги.ПометитьВерсию(Пакет.Идентификатор, "lts", "1.0.0", "alice");
	Теги.ПометитьВерсию(Пакет.Идентификатор, "lts", "1.4.7", "alice");

	Тег = Теги.НайтиТег(Пакет.Идентификатор, "lts");
	Ожидаем.Что(Строка(Тег.Режим), "канал создан ручным").Равно("ручной");
	Ожидаем.Что(СтрокиСостава(Тег), "обе версии в канале").Равно("1.0.0,1.4.7");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "lts").Версия,
		"резолв — максимум помеченных").Равно("1.4.7");

	// повторная пометка той же версии дубля не создаёт
	Теги.ПометитьВерсию(Пакет.Идентификатор, "lts", "1.4.7", "alice");
	Ожидаем.Что(СтрокиСостава(Теги.НайтиТег(Пакет.Идентификатор, "lts")),
		"повторная пометка идемпотентна").Равно("1.0.0,1.4.7");

	// набор канала ОБРАТИМ: метку можно снять, и резолв уезжает на оставшуюся
	Теги.СнятьМетку(Пакет.Идентификатор, "lts", "1.4.7", "alice");
	Ожидаем.Что(СтрокиСостава(Теги.НайтиТег(Пакет.Идентификатор, "lts"))).Равно("1.0.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "lts").Версия).Равно("1.0.0");

	// ручная метка на тег-ПРАВИЛО отклоняется: состав канала считает правило, и метка молча не работала бы
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "auto", "semver", "^1.0");
	Отказано = Ложь;
	Попытка
		Теги.ПометитьВерсию(Пакет.Идентификатор, "auto", "2.0.0", "alice");
	Исключение
		Отказано = Истина;
	КонецПопытки;
	Ожидаем.Что(Отказано, "ручная метка на тег-правило отклонена").ЭтоИстина();

КонецПроцедуры

// Перемещение ручного тега — ЗАМЕНА состава, а не пополнение: иначе откат тега на старую версию не сработал бы —
// резолв отдавал бы максимум, то есть ровно ту версию, от которой уходили.
&Тест
Процедура ПеремещениеРучногоТегаЗаменяетСостав() Экспорт

	Пакет = НовыйПакетСВерсиями("move", "1.0.0,2.0.0");
	Теги = Теги();

	Теги.ПереместитьТег(Пакет.Идентификатор, "beta", "2.0.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "beta").Версия).Равно("2.0.0");

	// откат на предыдущую версию обязан сработать
	Теги.ПереместитьТег(Пакет.Идентификатор, "beta", "1.0.0");
	Тег = Теги.НайтиТег(Пакет.Идентификатор, "beta");
	Ожидаем.Что(СтрокиСостава(Тег), "в канале осталась одна версия").Равно("1.0.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "beta").Версия, "откат состоялся").Равно("1.0.0");

КонецПроцедуры

&Тест
Процедура РучнойТегСтоитГдеПоставили() Экспорт

	Пакет = НовыйПакетСВерсиями("man", "1.0.0,1.1.0");
	Теги = Теги();

	Теги.ПереместитьТег(Пакет.Идентификатор, "beta", "1.0.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "beta").Версия).Равно("1.0.0");

	// публикация новой версии ручной тег НЕ двигает
	ОпубликоватьВерсию(Пакет, "2.0.0");
	ОпубликоватьСобытиеПубликации(Пакет, "2.0.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "beta").Версия, "ручной тег публикацией не двигается").Равно("1.0.0");

	// но переставить его руками можно
	Теги.ПереместитьТег(Пакет.Идентификатор, "beta", "2.0.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "beta").Версия).Равно("2.0.0");

КонецПроцедуры

// Пин упразднён и заменяется ручным тегом без потерь: ручной тег стоит там, где его поставили, — публикация его
// не двигает. Отдельного режима больше нет, значит нет и особых отказов, адреса открепления и особой раскраски в UI.
&Тест
Процедура РучнойТегНаОднойВерсииЗаменяетПин() Экспорт

	Пакет = НовыйПакетСВерсиями("pin", "1.0.0,1.1.0");
	Теги = Теги();
	ОпубликоватьВерсию(Пакет, "3.0.0");

	Теги.ПереместитьТег(Пакет.Идентификатор, "customer-a", "1.0.0");

	// состав ручного тега — не производная: он стоит там, где его поставили
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "customer-a").Версия,
		"ручной тег стоит на месте").Равно("1.0.0");

	// ...и публикация новой версии тоже (событие публикации проходит по всем каналам-правилам)
	ОпубликоватьСобытиеПубликации(Пакет, "3.0.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "customer-a").Версия,
		"публикация ручной тег не двигает").Равно("1.0.0");

	Тег = Теги.НайтиТег(Пакет.Идентификатор, "customer-a");
	Ожидаем.Что(Строка(Тег.Режим), "режим ручной").Равно("ручной");
	// «ровно одна метка» — прежний инвариант пина, теперь свойство ПереместитьТег
	Ожидаем.Что(СтрокиСостава(Тег), "у ручного тега ровно одна метка").Равно("1.0.0");

	// и он двигается ОБЫЧНЫМ перемещением, без всякого открепления
	Теги.ПереместитьТег(Пакет.Идентификатор, "customer-a", "3.0.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "customer-a").Версия, "переместился").Равно("3.0.0");
	Ожидаем.Что(Теги.УдалитьТег(Пакет.Идентификатор, "customer-a", "alice"), "удаляется").ЭтоИстина();

КонецПроцедуры

// Режим «пин» и тип правила «label» не принимаются ни одним путём, и отказ называет причину («упразднён»).
&Тест
Процедура УпразднённыеРежимИТипОтклоняютсяПоимённо() Экспорт

	Пакет = НовыйПакетСВерсиями("gone", "1.0.0,1.1.0");
	Режимы = Желудь("РежимТега");

	Ожидаем.Что(СтрСоединить(Режимы.Все(), ","), "словарь режимов").Равно("ручной,правило");

	Ошибка = "";
	Попытка
		Режимы.Нормализовать("пин");
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(СтрНайти(Ошибка, "упразднён") > 0,
		СтрШаблон("режим «пин» отклонён поимённо: %1", Ошибка)).ЭтоИстина();

	ОшибкаEn = "";
	Попытка
		Режимы.Нормализовать("pin");
	Исключение
		ОшибкаEn = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(СтрНайти(ОшибкаEn, "упразднён") > 0,
		СтрШаблон("английский синоним pin отклонён: %1", ОшибкаEn)).ЭтоИстина();

	// тип правила label
	ОшибкаТипа = "";
	Попытка
		Теги().ОпределитьТегПравила(Пакет.Идентификатор, "nightly", "label", "dev");
	Исключение
		ОшибкаТипа = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(СтрНайти(ОшибкаТипа, "упразднён") > 0,
		СтрШаблон("тип label отклонён поимённо: %1", ОшибкаТипа)).ЭтоИстина();

	// ...и префикс "label:" в ЛЮБОМ типе — прежде он молча переключал тип правила
	ОшибкаПрефикса = "";
	Попытка
		Теги().ОпределитьТегПравила(Пакет.Идентификатор, "nightly2", "semver", "label:dev");
	Исключение
		ОшибкаПрефикса = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(СтрНайти(ОшибкаПрефикса, "упразднена") > 0,
		СтрШаблон("префикс label: отклонён поимённо: %1", ОшибкаПрефикса)).ЭтоИстина();

	// ни одного тега после отказов не заведено (fail-closed, а не «создали и не настроили»)
	Ожидаем.Что(Теги().НайтиТег(Пакет.Идентификатор, "nightly"), "тега label нет").ЭтоНеопределено();
	Ожидаем.Что(Теги().НайтиТег(Пакет.Идентификатор, "nightly2"), "тега с префиксом нет").ЭтоНеопределено();

КонецПроцедуры

// Смена режима ручной ⇄ правило попадает в аудит отдельным действием: оператор обязан найти момент перевода.
&Тест
Процедура СменаРежимаПопадаетВЖурнал() Экспорт

	Пакет = НовыйПакетСВерсиями("mode", "1.0.0,2.0.0");
	Теги = Теги();

	Теги.ПереместитьТег(Пакет.Идентификатор, "customer-b", "1.0.0", "alice");
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "customer-b", "semver", "*", "alice");

	Тег = Теги.НайтиТег(Пакет.Идентификатор, "customer-b");
	Ожидаем.Что(Строка(Тег.Режим), "стал правилом").Равно("правило");
	Ожидаем.Что(Теги.ВерсияТега(Тег).Версия, "состав считает правило").Равно("2.0.0");

	Пул = Желудь("СервисПулов").ПулПоИдентификатору(Пакет.ПулИдентификатор);
	Объект = СтрШаблон("%1/%2:customer-b", Пул.Имя, Пакет.Имя);
	Смен = 0;
	Для Каждого Запись Из ЖурналАудита().Последние(100) Цикл
		Если Строка(Запись.Действие) = "тег.режим.изменён" И Строка(Запись.Объект) = Объект Тогда
			Смен = Смен + 1;
			Ожидаем.Что(Строка(Запись.Кто), "принципал смены режима").Равно("alice");
		КонецЕсли;
	КонецЦикла;
	// одна смена: ручной→правило (создание ручного тега режим не меняет — он ручной сразу)
	Ожидаем.Что(Смен, "смена режима в журнале").Равно(1);

КонецПроцедуры

&Тест
Процедура СменаПравилаМеняетВыдачуКанала() Экспорт

	Пакет = НовыйПакетСВерсиями("rule", "1.0.0,1.5.0,2.0.0");
	Теги = Теги();

	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "cur", "semver", "^1.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "cur").Версия).Равно("1.5.0");

	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "cur", "semver", "^2.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "cur").Версия, "смена правила сменила выдачу канала").Равно("2.0.0");

КонецПроцедуры

// Отзыв метку НЕ снимает: отозванная версия остаётся видна в составе канала, но резолв её обходит и берёт следующую.
&Тест
Процедура ОтозваннаяВерсияОстаётсяВКаналеНоНеОтдаётся() Экспорт

	Пакет = НовыйПакетСВерсиями("yank", "1.0.0,1.1.0");
	Теги = Теги();

	Правило = Теги.ОпределитьТегПравила(Пакет.Идентификатор, "cur", "semver", "*");
	Теги.ПереместитьТег(Пакет.Идентификатор, "fixed", "1.1.0");
	Ожидаем.Что(Теги.ВерсияТега(Правило).Версия).Равно("1.1.0");

	Желудь("СервисВерсий").ОтозватьВерсию(Пакет.Идентификатор, "1.1.0", Истина);

	// состав НЕ изменился: отзыв — не смена правила
	Ожидаем.Что(СтрокиСостава(Теги.НайтиТег(Пакет.Идентификатор, "cur")),
		"отозванная версия ОСТАЛАСЬ в составе канала").Равно("1.0.0,1.1.0");
	// а резолв её обходит
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "cur").Версия,
		"резолв обошёл отозванный максимум").Равно("1.0.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "fixed"),
		"канал из одной отозванной версии не резолвится").ЭтоНеопределено();

	// unyank возвращает всё на место сам: состав и не менялся
	Желудь("СервисВерсий").ОтозватьВерсию(Пакет.Идентификатор, "1.1.0", Ложь);
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "cur").Версия).Равно("1.1.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "fixed").Версия).Равно("1.1.0");

КонецПроцедуры

// Отозваны ВСЕ версии канала → тег не резолвится (вызывающий отвечает 404), а не отдаёт отозванную: «раз ничего не
// подошло, отдадим хоть что-нибудь» вернуло бы клиенту заведомо отозванный артефакт.
&Тест
Процедура КаналИзОднихОтозванныхНеРезолвится() Экспорт

	Пакет = НовыйПакетСВерсиями("allyank", "1.0.0,1.1.0");
	Теги = Теги();
	СервисВерсий = Желудь("СервисВерсий");

	Тег = Теги.ОпределитьТегПравила(Пакет.Идентификатор, "cur", "semver", "*");
	Ожидаем.Что(СтрокиСостава(Тег), "обе версии в канале").Равно("1.0.0,1.1.0");

	СервисВерсий.ОтозватьВерсию(Пакет.Идентификатор, "1.0.0", Истина);
	СервисВерсий.ОтозватьВерсию(Пакет.Идентификатор, "1.1.0", Истина);

	Ожидаем.Что(СтрокиСостава(Теги.НайтиТег(Пакет.Идентификатор, "cur")),
		"состав канала на месте — отзыв метки не снимает").Равно("1.0.0,1.1.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "cur"),
		"отозванная версия НЕ отдаётся — 404, а не выдача").ЭтоНеопределено();
	Ожидаем.Что(Теги.ТегИзвестен(Пакет, "cur"),
		"но сам тег известен (404 «нет подходящей версии», а не «нет тега»)").ЭтоИстина();

	// и повторное чтение этого не меняет: правило считается по ВСЕМ версиям пакета
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "cur"),
		"канал не «чинится» выдачей отозванного").ЭтоНеопределено();

КонецПроцедуры

// Публикация НЕ материализует состав: канал-правило отдаёт новую версию сам, потому что состав считается правилом.
// Событие публикуется НАСТОЯЩИМ издателем (тем же желудем, которым пользуется СервисПубликации), и проверяется, что
// подписчик не пишет ни строки состава.
&Тест
Процедура ПубликацияПополняетКаналБезЗаписиСостава() Экспорт

	Пакет = НовыйПакетСВерсиями("evt", "1.0.0");
	Теги = Теги();

	Тег = Теги.ОпределитьТегПравила(Пакет.Идентификатор, "cur", "semver", "*");
	Ожидаем.Что(СтрокиСостава(Тег), "в канале первая версия").Равно("1.0.0");
	Ожидаем.Что(МетокВХранилище(Тег), "состав тега-правила в базе не лежит").Равно(0);

	ОпубликоватьВерсию(Пакет, "2.0.0");

	// СОСТАВ ИЗМЕНИЛСЯ САМ — до всякого события: он есть функция правила от набора версий
	ИзХранилища = Теги.НайтиТег(Пакет.Идентификатор, "cur");
	Ожидаем.Что(СтрокиСостава(ИзХранилища),
		"новая версия в канале без единой записи").Равно("1.0.0,2.0.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "cur").Версия, "и отдаётся она же").Равно("2.0.0");

	ОпубликоватьСобытиеПубликации(Пакет, "2.0.0");

	Ожидаем.Что(СтрокиСостава(Теги.НайтиТег(Пакет.Идентификатор, "cur")),
		"событие состава не меняет").Равно("1.0.0,2.0.0");
	Ожидаем.Что(МетокВХранилище(Теги.НайтиТег(Пакет.Идентификатор, "cur")),
		"подписчик публикации не записал ни одной метки").Равно(0);

КонецПроцедуры

// Ручной канал — НЕ производная: публикация подходящей по любому мыслимому правилу версии его не трогает, а его состав
// как лежал в базе строками МеткиТегов, так и лежит.
&Тест
Процедура ПубликацияНеТрогаетРучнойКанал() Экспорт

	Пакет = НовыйПакетСВерсиями("manual-keep", "1.0.0,1.1.0");
	Теги = Теги();

	Теги.ПометитьВерсию(Пакет.Идентификатор, "lts", "1.0.0", "alice");
	Теги.ПометитьВерсию(Пакет.Идентификатор, "lts", "1.1.0", "alice");
	Ручной = Теги.НайтиТег(Пакет.Идентификатор, "lts");
	Ожидаем.Что(МетокВХранилище(Ручной), "состав ручного канала ХРАНИТСЯ").Равно(2);

	ОпубликоватьВерсию(Пакет, "2.0.0");
	ОпубликоватьСобытиеПубликации(Пакет, "2.0.0");

	Ожидаем.Что(СтрокиСостава(Теги.НайтиТег(Пакет.Идентификатор, "lts")),
		"состав ручного канала не изменился").Равно("1.0.0,1.1.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "lts").Версия,
		"и отдаёт он прежнюю версию").Равно("1.1.0");
	Ожидаем.Что(МетокВХранилище(Теги.НайтиТег(Пакет.Идентификатор, "lts")),
		"строк состава по-прежнему две").Равно(2);

	// а базовый тег-правило ту же публикацию подхватил
	Теги.ОбеспечитьБазовыеТеги(Пакет.Идентификатор);
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "stable").Версия,
		"канал-правило новую версию отдаёт").Равно("2.0.0");

КонецПроцедуры

// Попадание версии в каналы доезжает до аудита теми же событиями «тег.перемещён»: на них завязаны журнал и подписки,
// исчезнуть вместе с материализацией состава они не имели права. Массовых записей при этом нет.
&Тест
Процедура ПопаданиеВКаналыПопадаетВЖурнал() Экспорт

	Пакет = НовыйПакетСВерсиями("evt-audit", "1.0.0");
	Теги = Теги();

	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "cur", "semver", "*", "alice");
	Теги.ПереместитьТег(Пакет.Идентификатор, "fixed", "1.0.0", "alice");

	Пул = Желудь("СервисПулов").ПулПоИдентификатору(Пакет.ПулИдентификатор);
	ОбъектПравила = СтрШаблон("%1/%2:cur", Пул.Имя, Пакет.Имя);
	ОбъектРучного = СтрШаблон("%1/%2:fixed", Пул.Имя, Пакет.Имя);

	ОпубликоватьВерсию(Пакет, "2.0.0");
	ОпубликоватьСобытиеПубликации(Пакет, "2.0.0");

	Записей = 0;
	ЕстьБылоСтало = Ложь;
	РучныхЗаписей = 0;
	Для Каждого Запись Из ЖурналАудита().Последние(100) Цикл
		Если Строка(Запись.Действие) <> "тег.перемещён" Тогда
			Продолжить;
		КонецЕсли;
		Если Строка(Запись.Объект) = ОбъектРучного И СтрНайти(Строка(Запись.Детали), "2.0.0") > 0 Тогда
			РучныхЗаписей = РучныхЗаписей + 1;
		КонецЕсли;
		Если Строка(Запись.Объект) <> ОбъектПравила
			ИЛИ СтрНайти(Строка(Запись.Детали), "публикация") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Записей = Записей + 1;
		// «было 1.0.0 → стало 2.0.0»: журнал обязан назвать обе выдачи канала
		ЕстьБылоСтало = ЕстьБылоСтало
			ИЛИ (СтрНайти(Строка(Запись.Детали), "1.0.0") > 0
				И СтрНайти(Строка(Запись.Детали), "2.0.0") > 0);
	КонецЦикла;

	Ожидаем.Что(Записей, "канал-правило сообщил о попадании версии ровно один раз").Равно(1);
	Ожидаем.Что(ЕстьБылоСтало, "в деталях названы прежняя и новая выдача канала").ЭтоИстина();
	Ожидаем.Что(РучныхЗаписей, "о ручном канале публикация не пишет ничего").Равно(0);

КонецПроцедуры

// Перезапись существующей версии состав канала не меняет — строка версии та же. Прежняя, материализующая редакция
// на перезаписи ничего не писала (метка уже стояла), и журнал не должен получать «версия добавлена» на каждый push.
&Тест
Процедура ПерезаписьВерсииВЖурналКаналовНеПопадает() Экспорт

	Пакет = НовыйПакетСВерсиями("rewrite", "1.0.0");
	Теги = Теги();
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "cur", "semver", "*", "alice");

	Пул = Желудь("СервисПулов").ПулПоИдентификатору(Пакет.ПулИдентификатор);
	Объект = СтрШаблон("%1/%2:cur", Пул.Имя, Пакет.Имя);

	ОпубликоватьСобытиеПубликации(Пакет, "1.0.0", "перезапись.версии");

	Записей = 0;
	Для Каждого Запись Из ЖурналАудита().Последние(100) Цикл
		Если Строка(Запись.Действие) = "тег.перемещён" И Строка(Запись.Объект) = Объект
			И СтрНайти(Строка(Запись.Детали), "публикация") > 0 Тогда
			Записей = Записей + 1;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Записей, "перезапись о попадании в канал не объявляет").Равно(0);

	// а обычная публикация той же версии в тот же канал — объявляет
	ОпубликоватьСобытиеПубликации(Пакет, "1.0.0");
	Записей = 0;
	Для Каждого Запись Из ЖурналАудита().Последние(100) Цикл
		Если Строка(Запись.Действие) = "тег.перемещён" И Строка(Запись.Объект) = Объект
			И СтрНайти(Строка(Запись.Детали), "публикация") > 0 Тогда
			Записей = Записей + 1;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Записей, "проверка не вечнозелёная: публикация объявляет").Равно(1);

КонецПроцедуры

// Стоимость объявления о публикации не зависит ни от числа версий, ни от числа тегов: два запроса (версии пакета
// и его теги), дальше — сопоставление ОДНОЙ новой версии с правилами. Ручные каналы в счёт не идут.
&Тест
Процедура ОбъявлениеОПубликацииСтоитДвухЗапросов() Экспорт

	Пакет = НовыйПакетСВерсиями("announce", "1.0.0,1.1.0,1.2.0");
	Теги = Теги();

	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "all", "semver", "*");
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "line1", "semver", "^1.0");
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "line9", "semver", "^9.0");
	Теги.ПереместитьТег(Пакет.Идентификатор, "lts", "1.0.0");

	ОпубликоватьВерсию(Пакет, "1.3.0");
	Итог = Теги.ОбъявитьПопаданиеВКаналы(Пакет.Идентификатор, "1.3.0");

	Ожидаем.Что(Итог.Каналов, "версия попала в два канала-правила из трёх").Равно(2);
	Ожидаем.Что(Итог.Запросов,
		СтрШаблон("запросов ровно два: версии и теги (%1)", Формат(Итог.Запросов, "ЧГ=0"))).Равно(2);

	// про неизвестную версию объявлять нечего, и теги ради неё не читаются
	Пустое = Теги.ОбъявитьПопаданиеВКаналы(Пакет.Идентификатор, "9.9.9");
	Ожидаем.Что(Пустое.Каналов, "неизвестная версия ни в какой канал не попала").Равно(0);
	Ожидаем.Что(Пустое.Запросов, "и теги ради неё не читались").Равно(1);

КонецПроцедуры

// Отзыв состав не меняет, и подписки на yank/unyank у наблюдателя каналов нет: «какую версию отдать» решает резолв.
&Тест
Процедура ОтзывНеМеняетСоставКанала() Экспорт

	Пакет = НовыйПакетСВерсиями("evty", "1.0.0,2.0.0");
	Теги = Теги();

	Тег = Теги.ОпределитьТегПравила(Пакет.Идентификатор, "cur", "semver", "*");
	Ожидаем.Что(Теги.ВерсияТега(Тег).Версия).Равно("2.0.0");

	Желудь("СервисВерсий").ОтозватьВерсию(Пакет.Идентификатор, "2.0.0", Истина);
	ОпубликоватьСобытиеОтзыва(Пакет, "2.0.0", Истина);

	ИзХранилища = Теги.НайтиТег(Пакет.Идентификатор, "cur");
	Ожидаем.Что(СтрокиСостава(ИзХранилища),
		"отозванная версия осталась в канале").Равно("1.0.0,2.0.0");
	Ожидаем.Что(Теги.ВерсияТега(ИзХранилища).Версия,
		"а отдаётся действующая").Равно("1.0.0");

	Желудь("СервисВерсий").ОтозватьВерсию(Пакет.Идентификатор, "2.0.0", Ложь);
	ОпубликоватьСобытиеОтзыва(Пакет, "2.0.0", Ложь);
	Ожидаем.Что(Теги.ВерсияТега(Теги.НайтиТег(Пакет.Идентификатор, "cur")).Версия,
		"восстановление вернуло выдачу само").Равно("2.0.0");

КонецПроцедуры

// stable/prerelease создаются из коробки; stable — тег по умолчанию.
&Тест
Процедура БазовыеТегиИзКоробки() Экспорт

	Пакет = НовыйПакетСВерсиями("box", "1.0.0,1.1.0,2.0.0-rc.1");
	Теги = Теги();

	ОпубликоватьСобытиеПубликации(Пакет, "1.1.0"); // публикация создаёт базовые теги

	Ожидаем.Что(Теги.НайтиТег(Пакет.Идентификатор, "stable"), "тег stable").Существует();
	Ожидаем.Что(Теги.НайтиТег(Пакет.Идентификатор, "prerelease"), "тег prerelease").Существует();

	// stable — максимальный релиз БЕЗ пререлиза; prerelease — включая пререлизы
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "stable").Версия).Равно("1.1.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "prerelease").Версия).Равно("2.0.0-rc.1");

	// установка без тега = тег по умолчанию (stable)
	Ожидаем.Что(Теги.РазрешитьПоУмолчанию(Пакет).Версия, "умолчание = stable").Равно("1.1.0");

	// legacy-алиас dev → prerelease (контракт /dev-channel не меняется)
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "dev").Версия, "dev = prerelease").Равно("2.0.0-rc.1");

КонецПроцедуры

// latest пресетом не заводится и предопределённого правила не имеет: он был копией stable
// под другим именем. Имя при этом не зарезервировано — заведённый руками тег работает как
// любой другой. Инвариант стережётся на ЗНАЧЕНИЯХ (что создано, что резолвится, что известно),
// а не на составе списка базовых имён: список — форма записи.
&Тест
Процедура LatestНеЗаводитсяПресетомНоЗаводитсяРуками() Экспорт

	Пакет = НовыйПакетСВерсиями("no-latest", "1.0.0,1.1.0");
	Теги = Теги();

	ОпубликоватьСобытиеПубликации(Пакет, "1.1.0");

	Ожидаем.Что(Теги.НайтиТег(Пакет.Идентификатор, "latest"), "строки тега latest нет").Равно(Неопределено);
	Ожидаем.Что(Теги.ТегИзвестен(Пакет, "latest"),
		"latest не известен: обращение к нему — «нет такого», как к любому незаведённому имени").ЭтоЛожь();
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "latest"), "и версии он не отдаёт").Равно(Неопределено);
	Ожидаем.Что(Теги.БазовоеПравило("latest"),
		"предопределённого правила у latest нет").Равно(Неопределено);

	// имя не зарезервировано: мейнтейнер, которому latest нужен, заводит его сам
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "latest", "semver", "*", "alice");
	Ожидаем.Что(Теги.ТегИзвестен(Пакет, "latest"), "заведённый руками latest известен").ЭтоИстина();
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "latest").Версия,
		"и отдаёт максимальный релиз").Равно("1.1.0");

	// у соседа, которому его не заводили, он по-прежнему не существует
	Сосед = НовыйПакетСВерсиями("no-latest-2", "2.0.0");
	ОпубликоватьСобытиеПубликации(Сосед, "2.0.0");
	Ожидаем.Что(Теги.ТегИзвестен(Сосед, "latest"), "у соседа latest не появился").ЭтоЛожь();

КонецПроцедуры

// Пакет, приехавший из внешнего источника, попадает в реестр мимо публикации: события
// «версия опубликована» на него нет, и подписчик базовых тегов не срабатывает. Теги обязан
// завести сам приём внешней версии — иначе привезённый пакет ставится не так, как местный.
&Тест
Процедура ПривезённыйПакетПолучаетБазовыеТеги() Экспорт

	Пакет = НовыйПакетСВерсиями("upstream-tags", "");
	Пул = Желудь("СервисПулов").ПулПоИдентификатору(Пакет.ПулИдентификатор);
	Теги = Теги();

	Ожидаем.Что(Теги.ТегиПакета(Пакет.Идентификатор).Количество(),
		"до приёма тегов у пакета нет").Равно(0);

	Желудь("ПриёмВерсии").ПринятьВнешнюю(Пул, Пакет.Имя, "1.2.0", Неопределено, ПустойАртефакт());

	Ожидаем.Что(Теги.НайтиТег(Пакет.Идентификатор, "stable"),
		"привезённый пакет получил stable").Существует();
	Ожидаем.Что(Теги.НайтиТег(Пакет.Идентификатор, "prerelease"),
		"и prerelease").Существует();
	Ожидаем.Что(Теги.РазрешитьПоУмолчанию(Пакет).Версия,
		"установка без тега привозит привезённую версию").Равно("1.2.0");

	// вторая внешняя версия того же пакета тегов не задваивает
	Желудь("ПриёмВерсии").ПринятьВнешнюю(Пул, Пакет.Имя, "1.3.0", Неопределено, ПустойАртефакт());
	Ожидаем.Что(ТеговСИменем(Пакет.Идентификатор, "stable"),
		"повторный приём тег не задваивает").Равно(1);

КонецПроцедуры

// Инвариант владельца: SNAPSHOT по умолчанию никогда не «последняя». Проверяется не рассуждением
// «правило его не матчит», а прогоном КАЖДОГО базового правила по версии SNAPSHOT: и стейбл,
// и пререлиз обязаны её отвергнуть, иначе `opm install` молча привёз бы ночную сборку.
&Тест
Процедура SNAPSHOTНеПопадаетНиВОдноБазовоеПравило() Экспорт

	Пакет = НовыйПакетСВерсиями("snap-rules", "1.0.0,1.1.0-rc.1,SNAPSHOT");
	Теги = Теги();
	Отбор = Желудь("ОтборВерсийПоПравилу");
	Снапшот = Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, "SNAPSHOT");

	Для Каждого ИмяБазового Из Теги.БазовыеИмена() Цикл
		Правило = Теги.БазовоеПравило(ИмяБазового);
		Ожидаем.Что(Отбор.ПодходитВерсия(Снапшот, Правило),
			СтрШаблон("базовое правило ""%1"" (%2 %3) не берёт SNAPSHOT",
				ИмяБазового, Правило.Тип, Правило.Выражение)).ЭтоЛожь();
	КонецЦикла;

	ОпубликоватьСобытиеПубликации(Пакет, "1.0.0");

	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "stable").Версия, "stable — релиз").Равно("1.0.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "prerelease").Версия,
		"prerelease — пререлиз semver, а не снапшот").Равно("1.1.0-rc.1");
	Ожидаем.Что(Теги.РазрешитьПоУмолчанию(Пакет).Версия, "тег по умолчанию — релиз").Равно("1.0.0");

	// у пакета без единого релиза «последней» нет: 404 честнее тихо отданного снапшота
	Одинокий = НовыйПакетСВерсиями("snap-only", "SNAPSHOT");
	ОпубликоватьСобытиеПубликации(Одинокий, "SNAPSHOT");
	Ожидаем.Что(Теги.РазрешитьПоУмолчанию(Одинокий), "канал по умолчанию пуст").Равно(Неопределено);
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Одинокий, "stable")).Равно(Неопределено);
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Одинокий, "prerelease")).Равно(Неопределено);

	// regex смотрит на строку и снапшот в состав канала берёт, semver-правило — нет
	Ожидаем.Что(СовпаденияПравила(Пакет, "regex", "^SNAPSHOT$"),
		"regex-правило видит снапшот строкой").Равно("SNAPSHOT");
	Ожидаем.Что(СовпаденияПравила(Пакет, "semver", "*"),
		"semver-правило снапшот не берёт").Равно("1.0.0");

КонецПроцедуры

// ИСТ-КАТ-007: установка по тегу берёт максимальную по порядку версий среди его состава.
// Состав, в котором semver не разбирает НИ ОДНУ версию, — тоже состав: мейнтейнер видит там
// версии, и «нет такого ресурса» на установку по такому тегу ему ничем не объяснено.
&Тест
Процедура КаналИзОднихВерсийВнеПорядкаОтдаётСтаршуюИзНих() Экспорт

	// строки вне semver-порядка приезжают из внешнего источника: чем версионирует свои
	// артефакты апстрим — не наше решение
	Пакет = НовыйПакетСВерсиями("out-of-order", "1.0.0");
	Желудь("СервисВерсий").ИндексироватьВнешнюю(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "NIGHTLY"));
	Желудь("СервисВерсий").ИндексироватьВнешнюю(Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, "SNAPSHOT"));
	Теги = Теги();

	// ручной тег на двух версиях вне semver-порядка
	Теги.ПометитьВерсию(Пакет.Идентификатор, "nightly", "NIGHTLY", "alice");
	Теги.ПометитьВерсию(Пакет.Идентификатор, "nightly", "SNAPSHOT", "alice");
	Ожидаем.Что(СтрокиСостава(Теги.НайтиТег(Пакет.Идентификатор, "nightly")),
		"состав тега непуст и виден").Равно("NIGHTLY,SNAPSHOT");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "nightly").Версия,
		"тег с непустым составом обязан отдать версию").Равно("SNAPSHOT");

	// тег-ПРАВИЛО на тех же версиях: состав считает regex, отдаётся тот же максимум
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "raw", "regex", "^[A-Z]+$", "alice");
	Ожидаем.Что(СтрокиСостава(Теги.НайтиТег(Пакет.Идентификатор, "raw")),
		"состав правила — те же две версии").Равно("NIGHTLY,SNAPSHOT");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "raw").Версия,
		"и правило отдаёт ту же версию").Равно("SNAPSHOT");

	// живая плашка конструктора обещает ровно то, что поставится
	Ожидаем.Что(Теги.ПредпросмотрПравила(Пакет.Идентификатор, "regex", "^[A-Z]+$").Версия,
		"плашка обещает то же, что отдаст установка").Равно("SNAPSHOT");

	// и ИСТ-ВЫД-007 при этом цел: рядом с релизом версия вне порядка не побеждает
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "all", "regex", ".", "alice");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "all").Версия,
		"релиз старше любой строки вне порядка версий").Равно("1.0.0");
	Ожидаем.Что(Теги.РазрешитьПоУмолчанию(Пакет).Версия,
		"установка без тега по-прежнему релиз").Равно("1.0.0");

	// отзыв отдаваемой версии возвращает канал к соседке, а не к пустоте
	Желудь("СервисВерсий").ОтозватьВерсию(Пакет.Идентификатор, "SNAPSHOT", Истина);
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "nightly").Версия,
		"отозванная не отдаётся, отдаётся следующая по порядку").Равно("NIGHTLY");

КонецПроцедуры

// До первой публикации строк тегов ещё нет: базовые имена резолвятся предопределённым правилом (fail-safe).
&Тест
Процедура БазовыеИменаРезолвятсяДоСозданияСтрок() Экспорт

	Пакет = НовыйПакетСВерсиями("pre", "1.0.0,1.1.0-rc.1");
	Теги = Теги();

	Ожидаем.Что(Теги.ТегиПакета(Пакет.Идентификатор).Количество(), "строк тегов ещё нет").Равно(0);
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "stable").Версия).Равно("1.0.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "prerelease").Версия).Равно("1.1.0-rc.1");

КонецПроцедуры

// Решение владельца О-11: метка версии (legacy-заголовок CHANNEL) работает в правилах.
&Тест
Процедура МеткаВерсииОстаётсяАтрибутомНоПравиломНеОтбирается() Экспорт

	// граница У-5: упразднён ТИП ПРАВИЛА label, а не сущность МеткаВерсии — метка ставится при публикации из заголовка
	// CHANNEL и отдаётся наружу в API хаба, но правило тега её не видит
	Пакет = НовыйПакетСВерсиями("label", "1.0.0,1.1.0,2.0.0");
	СервисВерсий = Желудь("СервисВерсий");
	Метки = Желудь("СервисМетокВерсий");

	Ночная = СервисВерсий.НайтиВерсию(Пакет.Идентификатор, "1.1.0");
	Метки.ПрисвоитьМетку(Ночная.Идентификатор, "dev");

	Ожидаем.Что(Метки.ВерсияИмеетМетку(Ночная.Идентификатор, "dev"),
		"метка версии живёт и читается").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Метки.МеткиВерсии(Ночная.Идентификатор), ","),
		"метка отдаётся наружу").Равно("dev");

	// а вот правило тега по метке больше не отбирает — ни типом, ни префиксом
	ОжидатьИсключение("тип label", Пакет.Идентификатор, "nightly", "label", "dev");
	ОжидатьИсключение("префикс label:", Пакет.Идентификатор, "nightly", "semver", "label:dev");

КонецПроцедуры

// Уникальность пары «версия + метка» держит ТОЛЬКО сервисный слой: индексов проект не заводит ни на одном бэкенде,
// и вторая строка появилась бы, если бы СервисМетокВерсий.ПрисвоитьМетку перестал проверять существующую.
&Тест
Процедура ДубльМеткиВерсииНеСоздаётся() Экспорт

	Пакет = НовыйПакетСВерсиями("dupmark", "1.0.0");
	Версия = Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, "1.0.0");
	Метки = Желудь("СервисМетокВерсий");

	Ожидаем.Что(Метки.ПрисвоитьМетку(Версия.Идентификатор, "dev"), "первая метка создана").ЭтоИстина();
	Ожидаем.Что(Метки.ПрисвоитьМетку(Версия.Идентификатор, "dev"), "повторная — не создана").ЭтоЛожь();
	// регистр не создаёт второй строки: нормализация едина на записи и чтении
	Ожидаем.Что(Метки.ПрисвоитьМетку(Версия.Идентификатор, "DEV"), "другой регистр — не создана").ЭтоЛожь();

	Ожидаем.Что(СтрСоединить(Метки.МеткиВерсии(Версия.Идентификатор), ","),
		"на версии ровно одна строка метки").Равно("dev");

КонецПроцедуры

&Тест
Процедура НезаякоренныйRegexПредупреждает() Экспорт

	Пакет = НовыйПакетСВерсиями("rx", "1.2.0,11.2.0");
	Теги = Теги();

	Тег = Теги.ОпределитьТегПравила(Пакет.Идентификатор, "loose", "regex", "1\.2");
	Правило = Теги.ПравилоИзТега(Тег);
	Ожидаем.Что(Правило.НезаякоренноеПравило(), "правило опознано как незаякоренное").ЭтоИстина();
	Ожидаем.Что(ПустаяСтрока(Правило.Предупреждение()), "текст предупреждения непустой").ЭтоЛожь();
	// и footgun реально проявляется: под правило попала посторонняя 11.2.0
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "loose").Версия).Равно("11.2.0");

	// заякоренное правило не предупреждает и отбирает ровно то, что просили
	Строгий = Теги.ОпределитьТегПравила(Пакет.Идентификатор, "strict", "regex", "^1\.2\.0$");
	Ожидаем.Что(ПустаяСтрока(Теги.ПравилоИзТега(Строгий).Предупреждение()),
		"заякоренное правило без предупреждения").ЭтоИстина();
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "strict").Версия).Равно("1.2.0");

КонецПроцедуры

// Батч-раскладка каналов не растёт НИ ПО ВЕРСИЯМ, НИ ПО ТЕГАМ-ПРАВИЛАМ: версии пакета читаются один раз, теги — один
// раз, а правило каждого тега применяется к уже прочитанному списку. В хранилище состава ходят только РУЧНЫЕ теги,
// поэтому число запросов — «2 на пакет + по одному на ручной тег» и от числа версий не зависит вовсе. Проверка идёт на
// ДВУХ размерах: по одной точке постоянство от роста не отличить.
// Пререлизы отбираются РОВНО как прежде. Semver-правило сопоставляется по КОЛОНКАМ версии (SemverМажор/Минор/Патч
// и SemverПререлиз заполняются при публикации), а не разбором строки на каждом кандидате: расхождение колонок со
// строкой означало бы, что канал молча меняет состав. Проверяются и границы (пререлиз, метаданные сборки, legacy),
// и ПОЛНОЕ совпадение с разбором строки на каждой паре «правило × версия».
&Тест
Процедура ПререлизыОтбираютсяКакПоРазборуСтроки() Экспорт

	Пакет = НовыйПакетСВерсиями("pre-cols",
		"1.0.0,1.0.0-alpha,1.0.0-rc.1,1.0.0-rc.2,1.2.0,1.2.0-rc.1+build.7,2.0.0,2.0.0-0,1.2.3.4");

	// релизное правило пререлизы НЕ берёт — политика пререлизов не изменилась
	Ожидаем.Что(СовпаденияПравила(Пакет, "semver", "*"),
		"«*» отбирает только релизы").Равно("1.0.0,1.2.0,1.2.3.4,2.0.0");
	Ожидаем.Что(СовпаденияПравила(Пакет, "semver", "^1.0"),
		"^1.0 — ветка 1.x без пререлизов").Равно("1.0.0,1.2.0,1.2.3.4");

	// пререлиз в границе диапазона пререлизы включает
	Ожидаем.Что(СовпаденияПравила(Пакет, "semver", ">=1.0.0-0"),
		"пререлиз в границе включает пререлизные версии").Равно(
		"1.0.0,1.0.0-alpha,1.0.0-rc.1,1.0.0-rc.2,1.2.0,1.2.0-rc.1+build.7,1.2.3.4,2.0.0,2.0.0-0");

	// точное совпадение с пререлизом и метаданные сборки, которые на отбор не влияют
	Ожидаем.Что(СовпаденияПравила(Пакет, "semver", "=1.0.0-rc.1"),
		"точный пререлиз").Равно("1.0.0-rc.1");
	Ожидаем.Что(СовпаденияПравила(Пакет, "semver", "=1.2.0-rc.1"),
		"метаданные сборки на отбор не влияют").Равно("1.2.0-rc.1+build.7");

	// ГЛАВНОЕ: отбор по колонкам совпадает с отбором по строке на КАЖДОЙ паре
	Отбор = Желудь("ОтборВерсийПоПравилу");
	СписокВерсий = Желудь("СервисВерсий").ВерсииПакета(Пакет.Идентификатор);
	Расхождения = Новый Массив();
	Пар = 0;

	Для Каждого Выражение Из ПравилаДляСверки() Цикл
		Правило = Новый ПравилоТега(Выражение.Тип, Выражение.Значение);
		Для Каждого Версия Из СписокВерсий Цикл
			Пар = Пар + 1;
			ПоКолонкам = Отбор.ПодходитВерсия(Версия, Правило);
			ПоСтроке = Правило.ПодходитСтрока(Строка(Версия.Версия));
			Если ПоКолонкам <> ПоСтроке Тогда
				Расхождения.Добавить(СтрШаблон("%1 %2 / %3: колонки=%4, строка=%5",
					Выражение.Тип, Выражение.Значение, Строка(Версия.Версия),
					Строка(ПоКолонкам), Строка(ПоСтроке)));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Пар > 50, СтрШаблон("сверено пар «правило × версия»: %1", Формат(Пар, "ЧГ=0"))).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Расхождения, "; "),
		"отбор по колонкам совпадает с отбором по строке").Равно("");

КонецПроцедуры

// Колонки версии с её строкой разошлись (строка «своя», компоненты — чужие): отбор обязан пользоваться колонками,
// иначе оптимизация не проверена вовсе, а regex — строкой, потому что колонок он не видит.
&Тест
Процедура ОтборSemverИдётПоКолонкамАRegexПоСтроке() Экспорт

	Пакет = НовыйПакетСВерсиями("cols-proof", "1.0.0");
	Версия = Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, "1.0.0");
	Отбор = Желудь("ОтборВерсийПоПравилу");

	Версия.SemverМажор = 9; // подлог: строка осталась 1.0.0, компоненты говорят 9.0.0
	Версия.Сохранить();

	Ожидаем.Что(Отбор.ПодходитВерсия(Версия, Новый ПравилоТега("semver", "^9.0")),
		"semver отобрал по колонкам").ЭтоИстина();
	Ожидаем.Что(Отбор.ПодходитВерсия(Версия, Новый ПравилоТега("regex", "^1\.0\.0$")),
		"regex отобрал по строке").ЭтоИстина();

КонецПроцедуры

// Regex-правило сличает строку версии ровно как написано: пререлиз semver регистрозависим
// ("1.0.0-RC1" и "1.0.0-rc1" — разные версии), а "^" и "$" означают границы всей строки.
&Тест
Процедура RegexПравилоРегистрозависимоИЯкоритВсюСтроку() Экспорт

	Регистр = Новый ПравилоТега("regex", "^1\.0\.0-RC1$");
	Ожидаем.Что(Регистр.ПодходитСтрока("1.0.0-RC1"), "версия ровно как в правиле").ЭтоИстина();
	Ожидаем.Что(Регистр.ПодходитСтрока("1.0.0-rc1"), "чужой регистр — другая версия").ЭтоЛожь();

	Якоря = Новый ПравилоТега("regex", "^1\.0\.0$");
	Ожидаем.Что(Якоря.ПодходитСтрока("1.0.0"), "заякоренное правило ловит свою версию").ЭтоИстина();
	Ожидаем.Что(Якоря.ПодходитСтрока("1.0.0" + Символы.ПС + "evil"), "хвост за переводом строки").ЭтоЛожь();
	Ожидаем.Что(Якоря.ПодходитСтрока("evil" + Символы.ПС + "1.0.0"), "мусор перед переводом строки").ЭтоЛожь();

КонецПроцедуры

// Правила для сверки «колонки против строки»: обе ветки политики пререлизов, точные совпадения, тильда, каретка
// и regex, которому колонки безразличны.
Функция ПравилаДляСверки()

	Результат = Новый Массив();
	Для Каждого Выражение Из СтрРазделить("*,^1.0,~1.2.0,>=1.0.0 <2.0.0,>=1.0.0-0,>=2.0.0-0,"
		+ "=1.0.0-rc.1,=1.2.3.4,^2.0", ",") Цикл
		Результат.Добавить(Новый Структура("Тип, Значение", "semver", Выражение));
	КонецЦикла;
	Результат.Добавить(Новый Структура("Тип, Значение", "regex", "^1\.0\.0(-rc\.\d+)?$"));
	Возврат Результат;

КонецФункции

// Совпадения правила строкой «1.0.0,1.2.0» — считаются тем же путём, каким считается состав канала.
Функция СовпаденияПравила(Знач Пакет, Знач Тип, Знач Выражение)
	Возврат СтрСоединить(
		ПоАлфавиту(Теги().ПредпросмотрПравила(Пакет.Идентификатор, Тип, Выражение).Совпадения), ",");
КонецФункции

&Тест
Процедура РаскладкаКаналовНеРастётПоВерсиямИТегам() Экспорт

	МалыйЗамер = ЗамерРаскладки("batch-small", 25, 3);
	БольшойЗамер = ЗамерРаскладки("batch-big", 100, 8);

	ЗаписатьЗамер(СтрШаблон(
		"раскладка каналов: 25 версий и 3 тега-правила + ручной — запросов %1, %2 мс;"
		+ " 100 версий и 8 тегов-правил + ручной — запросов %3, %4 мс",
		Формат(МалыйЗамер.Запросов, "ЧГ=0"), Формат(МалыйЗамер.Миллисекунд, "ЧГ=0"),
		Формат(БольшойЗамер.Запросов, "ЧГ=0"), Формат(БольшойЗамер.Миллисекунд, "ЧГ=0")),
		"oshub-замер-раскладки.txt");

	Ожидаем.Что(МалыйЗамер.Запросов,
		"25 версий и 4 тега: 2 на пакет + 1 на ручной тег").Равно(3);
	Ожидаем.Что(БольшойЗамер.Запросов,
		СтрШаблон("100 версий и 9 тегов: столько же запросов (%1)",
			Формат(БольшойЗамер.Запросов, "ЧГ=0"))).Равно(3);

	// и время раскладки остаётся микроскопическим: правило по версиям — это сопоставление, а не запросы
	Ожидаем.Что(БольшойЗамер.Миллисекунд < 1000,
		СтрШаблон("раскладка на 100 версиях и 9 каналах дешёвая (%1 мс)",
			Формат(БольшойЗамер.Миллисекунд, "ЧГ=0"))).ЭтоИстина();

КонецПроцедуры

// Замер одной раскладки: пакет из ЧислоВерсий версий, ЧислоТегов тегов-правил на все версии и один ручной тег —
// единственный, кому нужен запрос к хранилищу состава.
Функция ЗамерРаскладки(Знач Префикс, Знач ЧислоВерсий, Знач ЧислоТегов)

	Пакет = НовыйПакетСВерсиями(Префикс, "1.0.0");
	Для Индекс = 1 По ЧислоВерсий - 1 Цикл
		ОпубликоватьВерсию(Пакет, СтрШаблон("2.%1.0", Формат(Индекс, "ЧГ=0")));
	КонецЦикла;

	Для Индекс = 1 По ЧислоТегов Цикл
		Теги().ОпределитьТегПравила(Пакет.Идентификатор, "t" + Формат(Индекс, "ЧГ=0"), "semver", ">=0.0.0-0");
	КонецЦикла;
	Теги().ПереместитьТег(Пакет.Идентификатор, "lts", "1.0.0");

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Раскладка = Теги().КаналыПакета(Пакет.Идентификатор);
	Миллисекунд = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	// замер обязан мерить РЕАЛЬНУЮ работу: каждый тег-правило собрал все версии, ручной — одну
	Ожидаем.Что(Раскладка.Каналы.Количество(), "каналов в раскладке").Равно(ЧислоТегов + 1);
	Ожидаем.Что(Раскладка.ПоВерсиям.Количество(), "версий в раскладке").Равно(ЧислоВерсий);
	Ожидаем.Что(Раскладка.ПоВерсиям.Получить(
		Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, "1.0.0").Идентификатор).Количество(),
		"первая версия видна во всех каналах, включая ручной").Равно(ЧислоТегов + 1);

	Результат = Новый Структура();
	Результат.Вставить("Запросов", Раскладка.Запросов);
	Результат.Вставить("Миллисекунд", Миллисекунд);
	Возврат Результат;

КонецФункции

// Вкладке версий нужна вся раскладка «версия → теги» сразу: перебор тегов на каждую строку дал бы N×M.
// Раскладка ПОЛНАЯ — версия видна вместе с КАЖДЫМ каналом, в который входит.
&Тест
Процедура ТегиПоВерсиямДаютРаскладкуОднимПроходом() Экспорт

	Пакет = НовыйПакетСВерсиями("map", "1.0.0,1.1.0,2.0.0");
	Теги = Теги();
	СервисВерсий = Желудь("СервисВерсий");

	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "stable", "semver", "*");      // все три
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "line1", "semver", "^1.0");   // 1.0.0, 1.1.0
	Теги.ПереместитьТег(Пакет.Идентификатор, "lts", "1.1.0");                     // 1.1.0
	Теги.ПереместитьТег(Пакет.Идентификатор, "customer-a", "1.0.0");              // 1.0.0
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "nowhere", "semver", "^9.0"); // пусто

	Раскладка = Теги.ТегиПоВерсиям(Пакет.Идентификатор);

	Первая = СервисВерсий.НайтиВерсию(Пакет.Идентификатор, "1.0.0");
	Вторая = СервисВерсий.НайтиВерсию(Пакет.Идентификатор, "1.1.0");
	Третья = СервисВерсий.НайтиВерсию(Пакет.Идентификатор, "2.0.0");

	// 1.0.0 — в stable, line1 и customer-a; 1.1.0 — в stable, line1 и lts; 2.0.0 — в stable
	Ожидаем.Что(Раскладка.Получить(Первая.Идентификатор).Количество(), "1.0.0: три канала").Равно(3);
	Ожидаем.Что(Раскладка.Получить(Вторая.Идентификатор).Количество(), "1.1.0: три канала").Равно(3);
	Ожидаем.Что(Раскладка.Получить(Третья.Идентификатор).Количество(), "2.0.0: один канал").Равно(1);

	// пустой канал в раскладку не попал — показывать рядом с версией нечего
	Всего = 0;
	Для Каждого КиЗ Из Раскладка Цикл
		Всего = Всего + КиЗ.Значение.Количество();
	КонецЦикла;
	Ожидаем.Что(Всего, "пустой канал в раскладку не попал").Равно(7);

	// отзыв версию из раскладки не убирает: вкладка обязана показать каналы отозванной версии — её не отдаёт резолв
	СервисВерсий.ОтозватьВерсию(Пакет.Идентификатор, "2.0.0", Истина);
	Ожидаем.Что(Теги.ТегиПоВерсиям(Пакет.Идентификатор).Получить(Третья.Идентификатор).Количество(),
		"отозванная версия осталась в раскладке со своим каналом").Равно(1);
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "stable").Версия,
		"а выдача обошла отозванную").Равно("1.1.0");

КонецПроцедуры

// Карточка пакета не ходит в домен на КАЖДЫЙ тег: это анонимный горячий путь, а перебор с ВерсияТега/ВерсииТега читал
// версии и метки заново на каждой итерации. Гарантия проверяется СЧЁТЧИКОМ ВЫЗОВОВ (фикстура СчитающийСервисТегов).
&Тест
Процедура КарточкаНеХодитВДоменНаКаждыйТег() Экспорт

	Пакет = НовыйПакетСВерсиями("card", "1.0.0,1.1.0,2.0.0");
	Теги = Теги();

	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "stable", "semver", "*");
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "line1", "semver", "^1.0");
	Теги.ПереместитьТег(Пакет.Идентификатор, "lts", "1.1.0");

	Считающий = Новый СчитающийСервисТегов(Теги);
	Сборщик = Новый СборщикКарточкиПакета(
		Желудь("СервисВерсий"), Желудь("СервисМетокВерсий"), Считающий,
		Неопределено, Неопределено, Неопределено, Неопределено, Неопределено);

	ТегиJSON = Сборщик.ТегиJSON(Пакет);

	// данные на месте: замер не должен мерить пустую работу
	Ожидаем.Что(ТегиJSON.Количество(), "в карточке три тега").Равно(3);
	Найдено = Ложь;
	Для Каждого ТегJSON Из ТегиJSON Цикл
		Если Строка(ТегJSON.name) = "line1" Тогда
			Найдено = Истина;
			Ожидаем.Что(Строка(ТегJSON.version), "отдаваемая версия канала").Равно("1.1.0");
			Ожидаем.Что(ТегJSON.versions.Количество(), "состав канала").Равно(2);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Найдено, "тег line1 в карточке").ЭтоИстина();

	// ГЛАВНОЕ: ровно ОДИН доменный вызов на всю карточку и НИ ОДНОГО перебора по тегу
	Вызовов = Считающий.Вызовов();
	Ожидаем.Что(Вызовов.КаналыПакета, "раскладка получена одним вызовом").Равно(1);
	Ожидаем.Что(Вызовов.ВерсияТега,
		СтрШаблон("ВерсияТега на каждый тег НЕ зовётся (%1)", Формат(Вызовов.ВерсияТега, "ЧГ=0"))).Равно(0);
	Ожидаем.Что(Вызовов.ВерсииТега,
		СтрШаблон("ВерсииТега на каждый тег НЕ зовётся (%1)", Формат(Вызовов.ВерсииТега, "ЧГ=0"))).Равно(0);

	// и сам доменный вызов не растёт ни по версиям, ни по тегам-правилам: 2 запроса на пакет
	// плюс по одному на РУЧНОЙ тег (у правил состав считается по уже прочитанным версиям)
	Раскладка = Теги.КаналыПакета(Пакет.Идентификатор);
	Ожидаем.Что(Раскладка.Запросов,
		СтрШаблон("запросов = 2 на пакет + 1 на единственный ручной тег (%1)",
			Формат(Раскладка.Запросов, "ЧГ=0"))).Равно(3);
КонецПроцедуры

// Защита в глубину: метка тега обязана вести на версию ТОГО ЖЕ пакета. Чужую метку подкладываем ПРЯМО в хранилище —
// путей записи через сервис нет. Координата артефакта строится из ИМЕНИ ПАКЕТА: чужая версия дала бы молчаливый 404.
&Тест
Процедура МеткаНаЧужойПакетНеОтдаётся() Экспорт

	Свой = НовыйПакетСВерсиями("own", "1.0.0");
	Чужой = НовыйПакетСВерсиями("alien", "9.9.9");
	Теги = Теги();

	ЧужаяВерсия = Желудь("СервисВерсий").НайтиВерсию(Чужой.Идентификатор, "9.9.9");

	Теги.ПереместитьТег(Свой.Идентификатор, "broken", "1.0.0");
	Тег = Теги.НайтиТег(Свой.Идентификатор, "broken");
	ПодложитьМетку(Тег, ЧужаяВерсия);

	// чужая версия старше своей — не будь защиты, резолв отдал бы именно её
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Свой, "broken").Версия,
		"чужая версия не отдаётся как своя").Равно("1.0.0");

	// и в раскладку «версия → теги» она тоже не попадает
	Раскладка = Теги.ТегиПоВерсиям(Свой.Идентификатор);
	Ожидаем.Что(Раскладка.Получить(ЧужаяВерсия.Идентификатор),
		"чужая версия не попала в раскладку своего пакета").ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ПредпросмотрПравилаНеПишетИПоказываетСовпадения() Экспорт

	Пакет = НовыйПакетСВерсиями("prev", "1.0.0,1.5.0,2.0.0");
	Теги = Теги();

	Результат = Теги.ПредпросмотрПравила(Пакет.Идентификатор, "semver", "^1.0");
	Ожидаем.Что(Результат.Версия, "версия-кандидат").Равно("1.5.0");
	Ожидаем.Что(Результат.Совпадения.Количество(), "все подходящие версии").Равно(2);
	Ожидаем.Что(Теги.ТегиПакета(Пакет.Идентификатор).Количество(), "предпросмотр НИЧЕГО не записал").Равно(0);

	// предупреждение о незаякоренном regex доезжает до предпросмотра
	СRegex = Теги.ПредпросмотрПравила(Пакет.Идентификатор, "regex", "1\.0");
	Ожидаем.Что(ПустаяСтрока(СRegex.Предупреждение), "предпросмотр предупреждает о regex").ЭтоЛожь();

КонецПроцедуры

// Предпросмотр считает по ТЕМ ЖЕ версиям, что и состав канала: прежняя редакция брала только действующие, и список
// «под правило попадут» был неполон ровно на отозванные — а правило их отбирает.
&Тест
Процедура ПредпросмотрВидитОтозванныеКакИКанал() Экспорт

	Пакет = НовыйПакетСВерсиями("prev", "1.0.0,1.1.0,1.2.0");
	Теги = Теги();
	СервисВерсий = Желудь("СервисВерсий");

	СервисВерсий.ОтозватьВерсию(Пакет.Идентификатор, "1.2.0", Истина);

	Предпросмотр = Теги.ПредпросмотрПравила(Пакет.Идентификатор, "semver", "*");

	Ожидаем.Что(СтрСоединить(ПоАлфавиту(Предпросмотр.Совпадения), ","),
		"в совпадения входит и отозванная — её правило пометит").Равно("1.0.0,1.1.0,1.2.0");
	Ожидаем.Что(СтрСоединить(Предпросмотр.Отозванные, ","),
		"отозванные названы отдельно, чтобы UI их пометил").Равно("1.2.0");
	// а отдаваемая версия считается среди ДЕЙСТВУЮЩИХ: резолв отозванную не отдаёт
	Ожидаем.Что(Предпросмотр.Версия, "тег будет отдавать максимум среди действующих").Равно("1.1.0");

	// и это ровно то, что даст настоящий канал
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "all", "semver", "*");
	Тег = Теги.НайтиТег(Пакет.Идентификатор, "all");
	Ожидаем.Что(СтрокиСостава(Тег), "состав канала совпал с предпросмотром").Равно("1.0.0,1.1.0,1.2.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "all").Версия,
		"и отдаваемая версия тоже").Равно("1.1.0");

КонецПроцедуры

&Тест
Процедура ПереездТегаПопадаетВЖурналАудита() Экспорт

	Пакет = НовыйПакетСВерсиями("aud", "1.0.0,1.1.0");
	Теги = Теги();

	Теги.ПереместитьТег(Пакет.Идентификатор, "beta", "1.0.0", "alice");
	Теги.ПереместитьТег(Пакет.Идентификатор, "beta", "1.1.0", "alice");

	Пул = Желудь("СервисПулов").ПулПоИдентификатору(Пакет.ПулИдентификатор);
	Объект = СтрШаблон("%1/%2:beta", Пул.Имя, Пакет.Имя);

	Записи = ЖурналАудита().Последние(50);
	Переездов = 0;
	ЕстьВтороййПереезд = Ложь;
	Для Каждого Запись Из Записи Цикл
		Если Строка(Запись.Действие) <> "тег.перемещён" ИЛИ Строка(Запись.Объект) <> Объект Тогда
			Продолжить;
		КонецЕсли;
		Переездов = Переездов + 1;
		Ожидаем.Что(Строка(Запись.Кто), "принципал переезда").Равно("alice");
		// второй переезд: было 1.0.0 → стало 1.1.0 (обе версии в деталях)
		Если СтрНайти(Строка(Запись.Детали), "1.1.0") > 0
			И СтрНайти(Строка(Запись.Детали), "1.0.0") > 0 Тогда
			ЕстьВтороййПереезд = Истина;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Переездов, "оба переезда тега записаны в журнал").Равно(2);
	Ожидаем.Что(ЕстьВтороййПереезд, "детали содержат было/стало").ЭтоИстина();

КонецПроцедуры

// Удаление тега — ОТДЕЛЬНОЕ действие журнала со своим типом события: фильтр по типу обязан находить удаление и не
// показывать смену режима, которой не было.
&Тест
Процедура УдалениеТегаПопадаетВЖурналСвоимТипом() Экспорт

	Пакет = НовыйПакетСВерсиями("del", "1.0.0");
	Теги = Теги();
	Издатель = Желудь("ИздательСобытий");

	Ожидаем.Что(Издатель.ТипТегУдалён() = Издатель.ТипРежимТегаИзменён(),
		"удаление и смена режима — РАЗНЫЕ типы событий").ЭтоЛожь();

	// МАРШРУТИЗАЦИЯ, а не только содержимое записи: подписчик СВОЕГО типа обязан получить событие — служба подписана
	// на оба типа, и запись аудита выглядела бы прежней
	СлушательУдалений = Новый ФейкПодписчик();
	СлушательСмен = Новый ФейкПодписчик();
	Издатель.Подписать(Издатель.ТипТегУдалён(), СлушательУдалений);
	Издатель.Подписать(Издатель.ТипРежимТегаИзменён(), СлушательСмен);

	Обречённый = Теги.ПереместитьТег(Пакет.Идентификатор, "doomed", "1.0.0", "alice");
	ИдентификаторТега = Обречённый.Идентификатор;
	Ожидаем.Что(СтрокиСостава(Обречённый), "канал наполнен до удаления").Равно("1.0.0");

	Ожидаем.Что(Теги.УдалитьТег(Пакет.Идентификатор, "doomed", "alice"), "тег удалён").ЭтоИстина();

	// состав не переживает координату: висячие метки читались бы как живой канал, а следующий тег унаследовал бы чужие версии
	Осиротевшие = Желудь("ХранилищеМетокТегов").ПолучитьПоТегИдентификаторРавно(ИдентификаторТега);
	Ожидаем.Что(?(Осиротевшие = Неопределено, 0, Осиротевшие.Количество()),
		"метки удалённого тега сняты").Равно(0);

	Пул = Желудь("СервисПулов").ПулПоИдентификатору(Пакет.ПулИдентификатор);
	Объект = СтрШаблон("%1/%2:doomed", Пул.Имя, Пакет.Имя);

	Удалений = 0;
	СменРежима = 0;
	Для Каждого Запись Из ЖурналАудита().Последние(100) Цикл
		Если Строка(Запись.Объект) <> Объект Тогда
			Продолжить;
		КонецЕсли;
		Если Строка(Запись.Действие) = "тег.удалён" Тогда
			Удалений = Удалений + 1;
			Ожидаем.Что(Строка(Запись.Кто), "принципал удаления").Равно("alice");
			Ожидаем.Что(СтрНайти(Строка(Запись.Детали), "1.0.0") > 0,
				"в деталях версия, на которую указывал тег").ЭтоИстина();
		ИначеЕсли Строка(Запись.Действие) = "тег.режим.изменён" Тогда
			СменРежима = СменРежима + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Удалений, "удаление записано в журнал").Равно(1);
	Ожидаем.Что(СменРежима, "смены режима не было — и в журнале её нет").Равно(0);

	Ожидаем.Что(СлушательУдалений.Количество(), "событие поехало типом «тег.удалён»").Равно(1);
	Ожидаем.Что(СлушательСмен.Количество(), "и НЕ поехало типом «тег.режим.изменён»").Равно(0);

КонецПроцедуры

&Тест
Процедура ПустоеПравилоОтклоняется() Экспорт
	Пакет = НовыйПакетСВерсиями("neg1", "1.0.0");
	ОжидатьИсключение("пустое правило", Пакет.Идентификатор, "t", "semver", "");
	ОжидатьИсключение("правило из пробелов", Пакет.Идентификатор, "t", "semver", "   ");
	ОжидатьИсключение("мусорный semver-диапазон", Пакет.Идентификатор, "t", "semver", ">>=не-версия");
	ОжидатьИсключение("некорректный regex", Пакет.Идентификатор, "t", "regex", "([a-");
	ОжидатьИсключение("неизвестный тип правила", Пакет.Идентификатор, "t", "выдумка", "1.0");
КонецПроцедуры

&Тест
Процедура ИмяТегаВалидируется() Экспорт

	Пакет = НовыйПакетСВерсиями("neg2", "1.0.0");
	ОжидатьИсключение("пустое имя", Пакет.Идентификатор, "", "semver", "*");
	ОжидатьИсключение("слеш в имени (ломает URL)", Пакет.Идентификатор, "a/b", "semver", "*");
	ОжидатьИсключение("собака в имени (ломает pkg@tag)", Пакет.Идентификатор, "a@b", "semver", "*");
	ОжидатьИсключение("пробел в имени", Пакет.Идентификатор, "a b", "semver", "*");

	// регистр имени не создаёт второго тега
	Теги = Теги();
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "Beta", "semver", "*");
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "BETA", "semver", "*");
	Ожидаем.Что(ТеговСИменем(Пакет.Идентификатор, "beta"), "имя тега регистронезависимо").Равно(1);

КонецПроцедуры

// Правило без совпадений — тег никуда не указывает (а не «указывает куда попало»).
&Тест
Процедура ПравилоБезСовпаденийНеУказываетНиНаЧто() Экспорт

	Пакет = НовыйПакетСВерсиями("neg3", "1.0.0,1.1.0");
	Теги = Теги();

	Тег = Теги.ОпределитьТегПравила(Пакет.Идентификатор, "nope", "semver", "^9.0");
	Ожидаем.Что(СтрокиСостава(Тег), "канал пуст").Равно("");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "nope"), "резолв даёт Неопределено").ЭтоНеопределено();
	Ожидаем.Что(Теги.ТегИзвестен(Пакет, "nope"), "но сам тег ИЗВЕСТЕН (404 разного смысла)").ЭтоИстина();

КонецПроцедуры

// Ручной тег нельзя поставить на несуществующую версию — иначе «тег указывает на версию» превращается в «в пустоту».
&Тест
Процедура ТегНаНесуществующуюВерсиюОтклоняется() Экспорт

	Пакет = НовыйПакетСВерсиями("neg4", "1.0.0");
	Теги = Теги();

	Было = Ложь;
	Попытка
		Теги.ПереместитьТег(Пакет.Идентификатор, "ghost", "9.9.9");
	Исключение
		Было = Истина;
	КонецПопытки;
	Ожидаем.Что(Было, "тег на несуществующую версию отклонён").ЭтоИстина();
	Ожидаем.Что(Теги.НайтиТег(Пакет.Идентификатор, "ghost"), "строка тега не создана").ЭтоНеопределено();

КонецПроцедуры

// ReDoS: рассуждение «строки версий короткие, бэктрекинг не развернётся» было ЛОЖНЫМ — замер давал 5 180 мс на одном
// правиле (у ревьюера 86 832 мс). Меры: отбраковка вложенных квантификаторов, предел длины версии, отсутствие N+1.
&Тест
Процедура ПравилоСВложеннымКвантификаторомОтклоняется() Экспорт

	Пакет = НовыйПакетСВерсиями("redos", "1.0.0");
	Теги = Теги();

	// школьные формы катастрофического бэктрекинга — все fail-closed
	ОжидатьИсключение("(a+)+", Пакет.Идентификатор, "e1", "regex", "^(a+)+$");
	ОжидатьИсключение("(a*)*", Пакет.Идентификатор, "e2", "regex", "(a*)*$");
	ОжидатьИсключение("(ab+)*", Пакет.Идентификатор, "e3", "regex", "(ab+)*$");
	ОжидатьИсключение("(a{2,}){3,}", Пакет.Идентификатор, "e4", "regex", "(a{2,}){3,}");
	ОжидатьИсключение("вложенность через две группы", Пакет.Идентификатор, "e5", "regex", "((a+))+");

	// правило длиннее предела отклоняется до всякого матчинга
	ОжидатьИсключение("правило длиннее предела", Пакет.Идентификатор, "long", "regex",
		"^" + РазмножитьСимвол("a", 300) + "$");

	// НИ ОДИН из отклонённых тегов не создан — отказ произошёл до записи
	Для Каждого Имя Из СтрРазделить("e1,e2,e3,e4,e5,long", ",") Цикл
		Ожидаем.Что(Теги.НайтиТег(Пакет.Идентификатор, Имя),
			СтрШаблон("тег %1 не создан", Имя)).ЭтоНеопределено();
	КонецЦикла;

	// легитимные выражения с квантификаторами работают: проверка бьёт по вложенности, а не по квантификаторам вообще
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "ok1", "regex", "^1\.0\.\d+$");
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "ok2", "regex", "^(1|2)\.0\.0$");
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "ok3", "regex", "^\d+\.\d+\.\d+(-rc\.\d+)?$");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "ok1").Версия, "обычный regex работает").Равно("1.0.0");
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "ok3").Версия, "опциональная группа работает").Равно("1.0.0");

КонецПроцедуры

// Предпросмотр на версии, ПОСТРОЕННОЙ ДЛЯ БЭКТРЕКИНГА, обязан уложиться в порог: злое правило до исполнения не доходит.
&Тест
Процедура ЗлоеПравилоНеЗанимаетПоток() Экспорт

	Пакет = НовыйПакетСВерсиями("redos-hot", "1.0.0");
	Теги = Теги();
	// ровно та форма входа, на которой замер показывал 5 180 мс
	ОпубликоватьВерсию(Пакет, "1.0.0-" + РазмножитьСимвол("a", 26) + ".1");

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Отклонено = Ложь;
	Попытка
		Теги.ПредпросмотрПравила(Пакет.Идентификатор, "regex", "(a+)+$");
	Исключение
		Отклонено = Истина;
	КонецПопытки;
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Ожидаем.Что(Отклонено, "злое правило отклонено, а не исполнено").ЭтоИстина();
	Ожидаем.Что(Длительность < 1000,
		СтрШаблон("отказ мгновенный, поток не занят (%1 мс)", Формат(Длительность, "ЧГ=0"))).ЭтоИстина();

	// безопасное правило на той же «злой» версии — тоже быстро и с корректным результатом
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Предпросмотр = Теги.ПредпросмотрПравила(Пакет.Идентификатор, "regex", "^1\.0\.0-a+\.1$");
	Быстро = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	Ожидаем.Что(Предпросмотр.Совпадения.Количество(), "безопасное правило нашло версию").Равно(1);
	Ожидаем.Что(Быстро < 1000,
		СтрШаблон("безопасное правило дешёвое (%1 мс)", Формат(Быстро, "ЧГ=0"))).ЭтоИстина();

КонецПроцедуры

// Длина строки версии ограничена ПРИ ПУБЛИКАЦИИ: ospx-tools проверяет алфавит пререлиза, но не длину, а строка версии —
// вход правил отбора; неограниченный вход был вторым множителем в блокере.
&Тест
Процедура СлишкомДлиннаяСтрокаВерсииНеПринимается() Экспорт

	Пакет = НовыйПакетСВерсиями("verlen", "1.0.0");

	Длинная = "1.0.0-" + РазмножитьСимвол("a", 200);
	Было = Ложь;
	Попытка
		ОпубликоватьВерсию(Пакет, Длинная);
	Исключение
		Было = Истина;
	КонецПопытки;
	Ожидаем.Что(Было, "версия длиннее предела отклонена").ЭтоИстина();
	Ожидаем.Что(Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, Длинная),
		"отклонённая версия не сохранена").ЭтоНеопределено();

	// осмысленная semver-строка с пререлизом и метаданными сборки проходит
	Нормальная = "1.2.3-rc.1+build.20260727";
	ОпубликоватьВерсию(Пакет, Нормальная);
	Ожидаем.Что(Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, Нормальная),
		"нормальная версия принимается").Существует();

КонецПроцедуры

// Тег по умолчанию — не более одного на пакет.
&Тест
Процедура ТегПоУмолчаниюТолькоОдин() Экспорт

	Пакет = НовыйПакетСВерсиями("def", "1.0.0");
	Теги = Теги();

	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "a", "semver", "*");
	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "b", "semver", "*");
	Теги.НазначитьПоУмолчанию(Пакет.Идентификатор, "a");
	Теги.НазначитьПоУмолчанию(Пакет.Идентификатор, "b");

	Умолчаний = 0;
	Для Каждого Тег Из Теги.ТегиПакета(Пакет.Идентификатор) Цикл
		Если Тег.ПоУмолчанию = Истина Тогда
			Умолчаний = Умолчаний + 1;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Умолчаний, "ровно один тег по умолчанию").Равно(1);
	Ожидаем.Что(Теги.РазрешитьПоУмолчанию(Пакет).Версия).Равно("1.0.0");

КонецПроцедуры

// Неизвестное имя — не тег и не базовое имя: резолв молчит, ТегИзвестен = Ложь.
&Тест
Процедура НеизвестноеИмяТегаНеРезолвится() Экспорт
	Пакет = НовыйПакетСВерсиями("unk", "1.0.0");
	Теги = Теги();
	Ожидаем.Что(Теги.ТегИзвестен(Пакет, "нетакого"), "имя неизвестно").ЭтоЛожь();
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, "нетакого")).ЭтоНеопределено();
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Пакет, ""), "пустое имя").ЭтоНеопределено();
	Ожидаем.Что(Теги.РазрешитьВерсиюТега(Неопределено, "stable"), "пакет не задан").ЭтоНеопределено();
КонецПроцедуры

// Ручной тег заводится ПУСТЫМ: версии в него набирает человек у самой версии. Оформление —
// свойство тега, а не режима, поэтому живёт в обоих и переживает переопределение.
&Тест
Процедура РучнойТегЗаводитсяПустымИНесётОформление() Экспорт

	Пакет = НовыйПакетСВерсиями("hand", "1.0.0,2.0.0");
	Теги = Теги();

	Тег = Теги.ОпределитьРучнойТег(Пакет.Идентификатор, "LTS", "оля",
		Новый Структура("Стиль, Значок", "special", "lock"));

	Ожидаем.Что(Строка(Тег.Режим), "режим ручной").Равно("ручной");
	Ожидаем.Что(СтрокиСостава(Тег), "новый ручной тег ПУСТ: версии набирает человек").Равно("");
	Ожидаем.Что(Теги.ВерсияТега(Тег), "пустому каналу нечего отдавать").ЭтоНеопределено();
	Ожидаем.Что(Строка(Тег.Имя), "имя нормализовано").Равно("lts");
	Ожидаем.Что(Строка(Тег.Стиль), "стиль сохранён ключом").Равно("special");
	Ожидаем.Что(Строка(Тег.Значок), "значок сохранён ключом").Равно("lock");

	// оформление живёт и у тега-правила
	Правило = Теги.ОпределитьТегПравила(Пакет.Идентификатор, "band", "semver", "^1.0", "оля",
		Новый Структура("Стиль, Значок", "stable", ""));
	Ожидаем.Что(Строка(Правило.Стиль), "стиль тега-правила").Равно("stable");
	Ожидаем.Что(Строка(Правило.Значок), "пустой значок — плашка без значка").Равно("");

	// НЕЗНАКОМЫЙ ключ не отказ, а умолчание: оформление не повод не сохранить тег
	Мусорный = Теги.ОпределитьТегПравила(Пакет.Идентификатор, "band", "semver", "^1.0", "оля",
		Новый Структура("Стиль, Значок", "'><script>", "не-такого-значка"));
	Ожидаем.Что(Строка(Мусорный.Стиль), "незнакомый стиль сведён к обычному").Равно("plain");
	Ожидаем.Что(Строка(Мусорный.Значок), "незнакомый значок сведён к пустому").Равно("");

	// оформление НЕ ТРОГАЕТСЯ, если его не передали
	Теги.ОпределитьРучнойТег(Пакет.Идентификатор, "lts");
	Ожидаем.Что(Строка(Теги.НайтиТег(Пакет.Идентификатор, "lts").Стиль),
		"вызов без оформления его не стирает").Равно("special");

КонецПроцедуры

// Правка существующего тега — это тот же вызов «определить»: имя остаётся адресом установки,
// меняются режим, правило и оформление. Отдельного метода правки нет и не нужно.
&Тест
Процедура ПравкаТегаМеняетРежимПравилоИОформлениеНеТрогаяИмя() Экспорт

	Пакет = НовыйПакетСВерсиями("edit", "1.0.0,1.2.0,2.0.0");
	Теги = Теги();

	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "lts", "semver", "^1.0", "оля",
		Новый Структура("Стиль, Значок", "stable", "check"));
	Ожидаем.Что(ТеговСИменем(Пакет.Идентификатор, "lts"), "тег один").Равно(1);

	// правка правила и оформления
	Правленый = Теги.ОпределитьТегПравила(Пакет.Идентификатор, "lts", "semver", "^2.0", "оля",
		Новый Структура("Стиль, Значок", "deprecated", "stop"));
	Ожидаем.Что(ТеговСИменем(Пакет.Идентификатор, "lts"), "второй строки не появилось").Равно(1);
	Ожидаем.Что(СтрокиСостава(Правленый), "состав пересчитан новым правилом").Равно("2.0.0");
	Ожидаем.Что(Строка(Правленый.Стиль), "стиль правится").Равно("deprecated");
	Ожидаем.Что(Строка(Правленый.Значок), "значок правится").Равно("stop");

	// правка режима: правило -> ручной, оформление при этом сохраняется
	Ручной = Теги.ОпределитьРучнойТег(Пакет.Идентификатор, "lts", "оля",
		Новый Структура("Стиль, Значок", "deprecated", "stop"));
	Ожидаем.Что(Строка(Ручной.Режим), "режим сменился").Равно("ручной");
	Ожидаем.Что(СтрокиСостава(Ручной), "канал опустел: версии набирают вручную").Равно("");
	Ожидаем.Что(Строка(Ручной.Стиль), "оформление пережило смену режима").Равно("deprecated");

КонецПроцедуры

// Перевод тега-правила в ручной режим ОПУСТОШАЕТ канал: состав правила нигде не хранился, а ручной состав ведёт
// человек — значит после перевода в канале не должно оказаться версий «по наследству».
&Тест
Процедура ПереводПравилаВРучнойОпустошаетКанал() Экспорт

	Пакет = НовыйПакетСВерсиями("conv", "1.0.0,1.2.0");
	Теги = Теги();

	Тег = Теги.ОпределитьТегПравила(Пакет.Идентификатор, "chan", "semver", "*");
	Ожидаем.Что(СтрокиСостава(Тег), "правило собрало канал").Равно("1.0.0,1.2.0");

	Ручной = Теги.ОпределитьРучнойТег(Пакет.Идентификатор, "chan", "оля");
	Ожидаем.Что(Строка(Ручной.Режим), "режим сменился").Равно("ручной");
	Ожидаем.Что(Строка(Ручной.Правило), "правило стёрто").Равно("");
	Ожидаем.Что(СтрокиСостава(Ручной), "канал пуст: версии наследоваться не могут").Равно("");
	Ожидаем.Что(МетокВХранилище(Ручной), "меток в базе не появилось").Равно(0);

КонецПроцедуры

// Список ручных тегов пакета — источник выбора «какой тег повесить на версию»: теги-правила в него не попадают,
// потому что ручная метка на них ни на что не влияет.
&Тест
Процедура РучныеТегиПакетаНеСодержатТеговПравил() Экспорт

	Пакет = НовыйПакетСВерсиями("pick", "1.0.0");
	Теги = Теги();

	Теги.ОпределитьТегПравила(Пакет.Идентификатор, "auto", "semver", "*");
	Теги.ОпределитьРучнойТег(Пакет.Идентификатор, "hand");

	Имена = Новый Массив();
	Для Каждого Тег Из Теги.РучныеТегиПакета(Пакет.Идентификатор) Цикл
		Имена.Добавить(Строка(Тег.Имя));
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(ПоАлфавиту(Имена), ","), "в списке только ручные").Равно("hand");

КонецПроцедуры

// Скан «работа с каналами не объявляет сети». Проверяется РОВНО следующее: восемь классов каналов не объявляют сетевых
// зависимостей (&Пластилин), не создают сетевых типов и не подключают посторонних библиотек, а их прямые сотрудники
// не подключают транспортных библиотек и не упоминают известных сетевых точек входа. Это НЕ гарантия «каналы не
// ходят в сеть»: множество способов ОТКРЫТО (внешний процесс, инъекция по прозвищу, имя желудя из кусков строки),
// и реальные рубежи — ревью кода и замер времени публикации.
&Тест
Процедура РаботаСКаналамиНеОбъявляетСетевыхЗависимостей() Экспорт

	Нарушения = Новый Массив();

	// кольцо 1: полные белые списки
	Для Каждого ИмяКласса Из КлассыКаналов() Цикл
		Текст = ПрочитатьКлассРеестра(ИмяКласса);
		Ожидаем.Что(ПустаяСтрока(Текст), СтрШаблон("исходник %1 прочитан", ИмяКласса)).ЭтоЛожь();
		Для Каждого Нарушение Из НарушенияВТексте(ИмяКласса, Текст) Цикл
			Нарушения.Добавить(Нарушение);
		КонецЦикла;
	КонецЦикла;

	// кольцо 2: прямые сотрудники — только выход в сеть
	ПровереноКольцо2 = 0;
	Для Каждого ИмяКласса Из РазрешённыеСотрудники() Цикл
		Текст = ПрочитатьЛюбойКласс(ИмяКласса);
		Если ПустаяСтрока(Текст) Тогда
			Продолжить; // класс не найден по имени файла — учтено проверкой охвата ниже
		КонецЕсли;
		ПровереноКольцо2 = ПровереноКольцо2 + 1;
		Для Каждого Нарушение Из СетевыеНарушенияВТексте(ИмяКласса, Текст) Цикл
			Нарушения.Добавить(Нарушение);
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(КлассыКаналов().Количество(), "кольцо 1: десять классов").Равно(10);
	// охват кольца 2 обязан быть полным: не найденный по имени сотрудник — дыра
	Ожидаем.Что(ПровереноКольцо2, "кольцо 2: просканированы все прямые сотрудники").Равно(
		РазрешённыеСотрудники().Количество());

	Ожидаем.Что(СтрСоединить(Нарушения, "; "),
		"объявленные зависимости работы с каналами и её поставщиков — в известном множестве").Равно("");

КонецПроцедуры

// Негативный самотест проверки выше: сканеру скармливают синтетические тексты, каждый из которых воспроизводит
// реальный способ обхода, и требуют, чтобы он ругнулся — первая версия проверки была ложной.
&Тест
Процедура СканОбходыЛовит() Экспорт

	// (1) обход, которым ревью пробило первую версию: живой исходящий вызов через 1connector внутри чтения канала
	ОбходРевью = "#Использовать 1connector" + Символы.ПС
		+ "Функция СоставКанала(Знач Тег)" + Символы.ПС
		+ "	Ответ = КоннекторHTTP.Get(""http://127.0.0.1:9/"");" + Символы.ПС
		+ "КонецФункции";
	ОжидатьНарушение("вызов через 1connector", ОбходРевью);

	// (2) тот же вызов БЕЗ #Использовать — остаточный рубеж по имени сетевой точки входа
	БезИмпорта = "Функция СоставКанала(Знач Тег)" + Символы.ПС
		+ "	Ответ = КоннекторHTTP.Get(""http://127.0.0.1:9/"");" + Символы.ПС
		+ "КонецФункции";
	ОжидатьНарушение("статический вызов без #Использовать", БезИмпорта);

	// (3) обход через промежуточный класс, которого нет ни в одном чёрном списке
	ЧерезПосредника = "Перем Зеркала;" + Символы.ПС
		+ "&Желудь" + Символы.ПС
		+ "Процедура ПриСозданииОбъекта(&Пластилин(Значение = ""СервисЗеркал"") _П)" + Символы.ПС
		+ "	Зеркала = _П;" + Символы.ПС
		+ "КонецПроцедуры";
	ОжидатьНарушение("зависимость на посторонний класс", ЧерезПосредника);

	// (4) создание сетевого объекта напрямую
	ПрямоеСоздание = "Функция СоставКанала(Знач Тег)" + Символы.ПС
		+ "	С = Новый HTTPСоединение(""example.org"");" + Символы.ПС
		+ "КонецФункции";
	ОжидатьНарушение("Новый сетевого типа", ПрямоеСоздание);

	// (5) создание НЕ сетевого, но и не разрешённого типа — белый список типов
	ЧужойТип = "Функция СоставКанала(Знач Тег)" + Символы.ПС
		+ "	Х = Новый КлиентАпстрима();" + Символы.ПС
		+ "КонецФункции";
	ОжидатьНарушение("Новый неразрешённого типа", ЧужойТип);

	// (6) ФОРМА &Пластилин БЕЗ ПРОБЕЛОВ вокруг «=» — буквальная подстрока её пропускала
	БезПробелов = "&Пластилин(Значение=""СервисЗеркал"") _П";
	ОжидатьНарушение("&Пластилин без пробелов", БезПробелов);

	// (7) КОЛЬЦО 2: сеть у прямого поставщика данных о версиях
	ВКольце2 = "#Использовать 1connector" + Символы.ПС
		+ "Функция ДействующиеВерсии(Знач ПакетИдентификатор)" + Символы.ПС
		+ "	Ответ = КоннекторHTTP.Get(""http://127.0.0.1:9/"");" + Символы.ПС
		+ "КонецФункции";
	Найденные = СетевыеНарушенияВТексте("Проба", ВКольце2);
	Ожидаем.Что(Найденные.Количество() > 0,
		СтрШаблон("сканер кольца 2 ловит сеть (нашёл: %1)", СтрСоединить(Найденные, "; "))).ЭтоИстина();

	// (8) КОНТРОЛЬ: безобидный текст нарушений не даёт — иначе тест «краснеет всегда» и ничего не доказывает
	Безобидный = "Перем Отбор;" + Символы.ПС
		+ "Функция СоставКанала(Знач Тег)" + Символы.ПС
		+ "	Данные = Новый Структура();" + Символы.ПС
		+ "	Строки = Новый Массив();" + Символы.ПС
		+ "	Возврат Отбор.ВыбратьВерсию(Строки, Тег);" + Символы.ПС
		+ "КонецФункции" + Символы.ПС
		+ "&Желудь" + Символы.ПС
		+ "Процедура ПриСозданииОбъекта(&Пластилин(Значение = ""ОтборВерсийПоПравилу"") _О)" + Символы.ПС
		+ "	Отбор = _О;" + Символы.ПС
		+ "КонецПроцедуры";
	Ожидаем.Что(СтрСоединить(НарушенияВТексте("Проба", Безобидный), "; "),
		"безобидный код нарушений не даёт").Равно("");

КонецПроцедуры

// Публикация на горячем пути ДЕШЁВАЯ: состав каналов не материализуется, поэтому подписчик применяет правило
// к ОДНОЙ новой версии и пишет только события журнала. Прежняя редакция ставила метку на каждую подходящую версию
// каждого тега: на преувеличенном пакете это давало 13 688 мс внутри запроса opm push. Меряем два размера и печатаем
// замеры в файл отчёта; пороги с запасом — ловится регресс класса «пошли в сеть или снова начали писать состав».
&Тест
Процедура ПубликацияНаГорячемПутиДешёвая() Экспорт

	// 1) ТИПИЧНЫЙ пакет: 20 версий, 3 базовых тега
	Типичный = НовыйПакетСВерсиями("hot-typ", "1.0.0");
	Для Индекс = 1 По 19 Цикл
		ОпубликоватьВерсию(Типичный, СтрШаблон("1.%1.0", Формат(Индекс, "ЧГ=0")));
	КонецЦикла;
	Теги().ОбеспечитьБазовыеТеги(Типичный.Идентификатор);
	ОпубликоватьВерсию(Типичный, "2.0.0");

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОпубликоватьСобытиеПубликации(Типичный, "2.0.0");
	ТипичныйЗамер = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	// 2) ПРЕУВЕЛИЧЕННЫЙ пакет: 101 версия, 13 тегов
	Большой = НовыйПакетСВерсиями("hot-big", "1.0.0");
	Для Индекс = 1 По 99 Цикл
		ОпубликоватьВерсию(Большой, СтрШаблон("1.%1.0", Формат(Индекс, "ЧГ=0")));
	КонецЦикла;
	Для Индекс = 1 По 10 Цикл
		Теги().ОпределитьТегПравила(Большой.Идентификатор, "t" + Формат(Индекс, "ЧГ=0"), "semver", "*");
	КонецЦикла;
	Теги().ОбеспечитьБазовыеТеги(Большой.Идентификатор);
	ОпубликоватьВерсию(Большой, "2.0.0");

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ОпубликоватьСобытиеПубликации(Большой, "2.0.0");
	БольшойЗамер = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	ЗаписатьЗамер(СтрШаблон(
		"публикация на горячем пути: типичный пакет (20 версий, 3 тега) = %1 мс;"
		+ " преувеличенный (101 версия, 13 тегов) = %2 мс",
		Формат(ТипичныйЗамер, "ЧГ=0"), Формат(БольшойЗамер, "ЧГ=0")));

	// каналы отдают новую версию (замер не мерит пустую работу)
	ТегБольшого = Теги().НайтиТег(Большой.Идентификатор, "t1");
	Ожидаем.Что(Теги().ВерсияТега(ТегБольшого).Версия,
		"новая версия попала в канал").Равно("2.0.0");
	// ...и НИ ОДНОЙ строки состава при этом не записано — иначе порог опять начнёт мерить вставку
	Ожидаем.Что(МетокВХранилище(ТегБольшого),
		"тег-правило не материализовал состав").Равно(0);

	// пороги сознательно с запасом: замер чувствителен к загрузке машины (85 и 478 мс на свободной против
	// 132 и 13 688 мс у прежней, материализующей редакции) — ловим регресс класса «сеть, полный перебор
	// реестра или возврат материализации», а не проценты
	Ожидаем.Что(ТипичныйЗамер < 1500,
		СтрШаблон("типичный пакет уложился в порог (%1 мс)", Формат(ТипичныйЗамер, "ЧГ=0"))).ЭтоИстина();
	Ожидаем.Что(БольшойЗамер < 2000,
		СтрШаблон("преувеличенный пакет уложился в порог (%1 мс)", Формат(БольшойЗамер, "ЧГ=0"))).ЭтоИстина();

КонецПроцедуры

// Каждое имя в списке сетевых точек входа обязано СУЩЕСТВОВАТЬ в проекте: дважды подряд список охранял пустоту
// («КлиентУпстрима» вместо «КлиентАпстрима», «СлужбаЗеркал» вместо «СервисЗеркал»).
&Тест
Процедура СетевыеИменаСуществуют() Экспорт

	Фантомы = Новый Массив();
	Для Каждого Имя Из СетевыеИмена() Цикл
		// платформенные типы файлами не представлены — их проверяем отдельно по списку
		Если Имя = "HTTPСоединение" ИЛИ Имя = "HTTPЗапрос" ИЛИ Имя = "КоннекторHTTP" Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ФайлКлассаСуществует(Имя) Тогда
			Фантомы.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Фантомы, ", "),
		"в списке сетевых точек входа нет несуществующих классов").Равно("");

КонецПроцедуры

// Каналы упразднены целиком: доменный слой удалён вместе с мёртвой схемой, и инвариант
// усилился до «каналов в продуктовом коде НЕТ ВООБЩЕ». Сканируются РЕКУРСИВНО src, tools и scripts — первую версию ревью обошло
// возвратом работы с каналами в сидеры. Чёрный список здесь уместен: множество ЗАКРЫТО, к таблице «Каналы» ведёт
// единственный репозиторий. tests/ не сканируется сознательно — этот файл содержит маркеры как данные.
&Тест
Процедура КаналовНетВПродуктовомКоде() Экспорт

	Нарушители = Новый Массив();
	Проверено = 0;

	// исключённых зон НЕТ: db и migrations сканируются наравне со всем остальным
	Для Каждого Файл_ Из ПродуктовыеФайлы() Цикл

		Проверено = Проверено + 1;
		Текст = ПрочитатьФайл(Файл_.ПолноеИмя);
		Для Каждого Маркер Из МаркерыКаналов() Цикл
			Если СтрНайти(Текст, Маркер) > 0 Тогда
				Нарушители.Добавить(СтрШаблон("%1 (%2)", Файл_.Имя, Маркер));
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	// охват должен быть реальным: и модули, и корень src, и tools
	Ожидаем.Что(Проверено > 100, СтрШаблон("скан прошёл по продуктовым файлам (%1)",
		Формат(Проверено, "ЧГ=0"))).ЭтоИстина();
	Ожидаем.Что(СканОхватилСкрипты(), "в охват попал scripts/ (там живут сидеры — там жил обход ревью)").ЭтоИстина();
	Ожидаем.Что(СканОхватилКореньSrc(), "в охват попали файлы из корня src").ЭтоИстина();

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"упразднённых каналов нет ни в одном продуктовом файле").Равно("");

КонецПроцедуры

// ЛЕСЕНКА РЕЗОЛВА СПЕЦИФИКАЦИИ — того, что пользователь пишет после «@». Ступени идут строго по порядку: точная
// версия, имя тега, выражение версии. Правило одно на все пути получения пакета, поэтому проверяется на домене,
// а не на каждом адресе отдельно.

// Точная первой: «версия достаётся всегда» — обещание сильнее любой другой трактовки строки. КОНТРОЛЬ — резолв
// тегом: одноимённый тег в хабе есть и указывает в другую сторону.
&Тест
Процедура ТочнаяВерсияВыигрываетУОдноимённогоТега() Экспорт

	Пакет = НовыйПакетСВерсиями("spec-exact", "1.0.0,2.0.0");
	Теги().ПереместитьТег(Пакет.Идентификатор, "1.0.0", "2.0.0");

	Ожидаем.Что(Спеки().РазрешитьТегом(Пакет, "1.0.0").Версия.Версия,
		"КОНТРОЛЬ: тег с именем «1.0.0» стоит на 2.0.0").Равно("2.0.0");
	Ожидаем.Что(Спеки().Разрешить(Пакет, "1.0.0").Версия.Версия,
		"а спецификация «1.0.0» — это точная версия").Равно("1.0.0");

КонецПроцедуры

// Тег вперёд выражения: «1.4» разобралось бы и как ветка версий, и как имя тега, а имя тега однозначно.
&Тест
Процедура ИмяТегаВыигрываетУОдноимённогоВыраженияВерсии() Экспорт

	Пакет = НовыйПакетСВерсиями("spec-tag", "1.4.0,1.4.5");
	Теги().ПереместитьТег(Пакет.Идентификатор, "1.4", "1.4.0");

	Ожидаем.Что(Спеки().Разрешить(Пакет, "1.4").Версия.Версия,
		"тег «1.4» стоит на 1.4.0, хотя веткой 1.4.x старше 1.4.5").Равно("1.4.0");

КонецПроцедуры

// Третья ступень: ни точной версии, ни тега — значит спецификация читается как выражение и отдаёт максимум.
&Тест
Процедура ВыражениеВерсииОтдаётМаксимумВнутриВетки() Экспорт

	Пакет = НовыйПакетСВерсиями("spec-range", "1.4.0,1.4.5,2.0.0");

	Ожидаем.Что(Спеки().Разрешить(Пакет, "1.4").Версия.Версия, "максимум внутри 1.4.x").Равно("1.4.5");
	Ожидаем.Что(Спеки().Разрешить(Пакет, "^1.0").Версия.Версия, "каретка работает так же").Равно("1.4.5");

КонецПроцедуры

// Спецификации нет вовсе — версию называет ПОМЕТКА основного тега, а не имя «stable».
&Тест
Процедура ПустаяСпецификацияИдётЗаПометкойОсновногоТега() Экспорт

	Пакет = НовыйПакетСВерсиями("spec-default", "1.0.0,2.0.0");

	Ожидаем.Что(Спеки().Разрешить(Пакет, "").Версия.Версия,
		"КОНТРОЛЬ: пометки нет ни на ком — умолчание падает на stable").Равно("2.0.0");

	Теги().ПереместитьТег(Пакет.Идентификатор, "oldline", "1.0.0");
	Теги().НазначитьПоУмолчанию(Пакет.Идентификатор, "oldline");

	Ожидаем.Что(Спеки().Разрешить(Пакет, "").Версия.Версия,
		"пометка переехала — переехала и пустая спецификация").Равно("1.0.0");

КонецПроцедуры

// Отзыв закрывает выбор версии хабом, но не точную координату: обе половины правила на одной версии.
&Тест
Процедура ОтозваннуюТегИВыражениеНеВыбираютАТочнаяНаходится() Экспорт

	Пакет = НовыйПакетСВерсиями("spec-yank", "1.0.0,1.1.0");
	Теги().ПереместитьТег(Пакет.Идентификатор, "broken", "1.1.0");

	Отзываемая = Желудь("СервисВерсий").НайтиВерсию(Пакет.Идентификатор, "1.1.0");
	Отзываемая.Отозвана = Истина;
	Отзываемая.Сохранить();

	Ожидаем.Что(Спеки().Разрешить(Пакет, "broken").Найдена,
		"тег стоит на единственной отозванной версии — отдавать нечего").ЭтоЛожь();
	Ожидаем.Что(Спеки().Разрешить(Пакет, "^1.0").Версия.Версия,
		"выражение обходит отозванную стороной").Равно("1.0.0");
	Ожидаем.Что(Спеки().Разрешить(Пакет, "1.1.0").Версия.Версия,
		"а по точной координате отозванная находится").Равно("1.1.0");

КонецПроцедуры

// Три отказа требуют от клиента разных действий, поэтому лесенка их различает: опечатка в имени тега, битое
// выражение версии и «условию не удовлетворяет ни одна версия».
&Тест
Процедура ТриОтказаЛесенкиРазличимы() Экспорт

	Пакет = НовыйПакетСВерсиями("spec-refuse", "1.0.0");

	НетТега = Спеки().Разрешить(Пакет, "nosuchtag");
	Ожидаем.Что(НетТега.ТегНеизвестен, "имя по алфавиту тегов, а тега нет").ЭтоИстина();
	Ожидаем.Что(НетТега.ВыражениеБитое, "и это не битое выражение").ЭтоЛожь();

	Битое = Спеки().Разрешить(Пакет, "^[bad");
	Ожидаем.Что(Битое.ВыражениеБитое, "на имя тега не похоже и как выражение не разбирается").ЭтоИстина();
	Ожидаем.Что(Битое.ТегНеизвестен, "и тегом это не назовёшь").ЭтоЛожь();

	Пусто = Спеки().Разрешить(Пакет, "^7.0");
	Ожидаем.Что(Пусто.Найдена, "выражение разобрано, но подходящих версий нет").ЭтоЛожь();
	Ожидаем.Что(Пусто.ТегНеизвестен ИЛИ Пусто.ВыражениеБитое,
		"это не отказ про тег и не отказ про разбор").ЭтоЛожь();

КонецПроцедуры

// Та же лесенка по ГОЛЫМ СТРОКАМ версий — так выбирают среди версий чужого источника,
// сущностей которого этот хаб не знает. Ступени и их порядок обязаны совпадать с реестром.
&Тест
Процедура ЛесенкаПоГолымСтрокамПовторяетСтупениРеестра() Экспорт

	Пакет = НовыйПакетСВерсиями("spec-strings", "1.0.0");
	Строки = СтрРазделить("1.4.0,1.4.5,2.0.0", ",");

	Ожидаем.Что(Спеки().РазрешитьСредиСтрок(Пакет, "1.4.5", Строки).СтрокаВерсии,
		"первая ступень: точная строка версии").Равно("1.4.5");
	Ожидаем.Что(Спеки().РазрешитьСредиСтрок(Пакет, "1.4", Строки).СтрокаВерсии,
		"третья ступень: выражение версии отдаёт максимум внутри ветки").Равно("1.4.5");
	Ожидаем.Что(Спеки().РазрешитьСредиСтрок(Пакет, "stable", Строки).СтрокаВерсии,
		"вторая ступень: базовый тег работает своим правилом").Равно("2.0.0");
	Ожидаем.Что(Спеки().РазрешитьСредиСтрок(Пакет, "^[bad", Строки).Найдена,
		"мусорное выражение среди чужих строк ничего не выбирает").ЭтоЛожь();
	Ожидаем.Что(Спеки().РазрешитьСредиСтрок(Пакет, "^7.0", Строки).Найдена,
		"и разобранное выражение без совпадений — тоже").ЭтоЛожь();

	Ожидаем.Что(Спеки().РазрешитьТегомСредиСтрок(Пакет, "", Строки).СтрокаВерсии,
		"пустое имя тега — основной тег пакета").Равно("2.0.0");
	Ожидаем.Что(Спеки().РазрешитьТегомСредиСтрок(Пакет, "nosuchtag", Строки).Найдена,
		"неизвестное имя тега среди чужих строк ничего не выбирает").ЭтоЛожь();

	// пакета в реестре ещё нет — работают предопределённые правила базовых имён
	Ожидаем.Что(Спеки().РазрешитьТегомСредиСтрок(Неопределено, "", Строки).СтрокаВерсии,
		"у незнакомого имени основной тег — предопределённый stable").Равно("2.0.0");

КонецПроцедуры

// Тег-ПРАВИЛО работает по чужим строкам своим правилом, включая regex-режим: правило —
// это функция от строки версии, и реестр ему для этого не нужен.
&Тест
Процедура ПравилоТегаОтбираетЧужиеСтрокиВключаяRegex() Экспорт

	Пакет = НовыйПакетСВерсиями("spec-rule-strings", "1.0.0");
	Строки = СтрРазделить("1.0.0,1.9.9,2.0.0,2.1.0-rc.1", ",");

	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "lts", "semver", "^1.0.0");
	Ожидаем.Что(Спеки().РазрешитьТегомСредиСтрок(Пакет, "lts", Строки).СтрокаВерсии,
		"semver-правило берёт максимум своей ветки среди чужих строк").Равно("1.9.9");

	Теги().ОпределитьТегПравила(Пакет.Идентификатор, "rc", "regex", "-rc\.");
	Ожидаем.Что(Спеки().РазрешитьТегомСредиСтрок(Пакет, "rc", Строки).СтрокаВерсии,
		"regex-правило отбирает по строке версии").Равно("2.1.0-rc.1");

КонецПроцедуры

// РУЧНОЙ канал среди чужих строк не выбирает ничего: его состав ведёт человек ЗДЕСЬ,
// и версии источника в нём взяться неоткуда. Имя тега выбрано так, что без этой ветки
// оно ушло бы на ступень выражения и версию всё-таки назвало бы.
&Тест
Процедура РучнойКаналСредиЧужихСтрокНичегоНеВыбирает() Экспорт

	Пакет = НовыйПакетСВерсиями("spec-manual-strings", "1.4.0");
	Теги().ПереместитьТег(Пакет.Идентификатор, "1.4", "1.4.0");
	Строки = СтрРазделить("1.4.7,1.4.9", ",");

	Ожидаем.Что(Спеки().РазрешитьСредиСтрок(Пакет, "1.4", Строки).Найдена,
		"ручной канал «1.4» чужих версий не отдаёт, хотя выражением «1.4» они подошли бы").ЭтоЛожь();

	// КОНТРОЛЬ: то же имя без ручного тега читается выражением и версию называет
	Чужой = НовыйПакетСВерсиями("spec-manual-free", "1.4.0");
	Ожидаем.Что(Спеки().РазрешитьСредиСтрок(Чужой, "1.4", Строки).СтрокаВерсии,
		"без ручного тега «1.4» — это выражение версии").Равно("1.4.9");

КонецПроцедуры

// Круг выбора хаба — одно правило на выдачу файла и на резолв версии: у имени
// с собственными публикациями хаб выбирает только среди своих версий.
&Тест
Процедура КругВыбораХабаСужаетсяТолькоУСвоегоИмени() Экспорт

	Свой = НовыйПакетСВерсиями("circle-own", "1.0.0");
	Пул = Желудь("СервисПулов").ПулПоИдентификатору(Свой.ПулИдентификатор);
	Желудь("ПриёмВерсии").ПринятьВнешнюю(Пул, Свой.Имя, "9.9.9", Неопределено, ПустойАртефакт());

	Круг = Спеки().КругВыбораХаба(Свой);
	Ожидаем.Что(Круг, "у своего имени круг сужен").Существует();
	Ожидаем.Что(Круг.Количество(), "и в нём только своя версия").Равно(1);
	Ожидаем.Что(Спеки().Разрешить(Свой, "", Круг).Версия.Версия,
		"хаб выбирает среди своих, хотя привезённая 9.9.9 старше").Равно("1.0.0");

	Привезённый = НовыйПакетСВерсиями("circle-foreign", "");
	ПулЧужого = Желудь("СервисПулов").ПулПоИдентификатору(Привезённый.ПулИдентификатор);
	Желудь("ПриёмВерсии").ПринятьВнешнюю(ПулЧужого, Привезённый.Имя, "3.0.0", Неопределено, ПустойАртефакт());
	Ожидаем.Что(Спеки().КругВыбораХаба(Привезённый) = Неопределено,
		"у имени без своих публикаций круг не сужается").ЭтоИстина();

КонецПроцедуры

// Кто выбрал версию, решает, изменится ли ответ по тому же адресу завтра: названная клиентом — нет, выбранная
// хабом — да, потому что тег переезжает.
&Тест
Процедура ВыбралХабВсёКромеТочнойВерсии() Экспорт

	Пакет = НовыйПакетСВерсиями("spec-choice", "1.0.0,1.1.0");
	Теги().ПереместитьТег(Пакет.Идентификатор, "lts", "1.0.0");

	Ожидаем.Что(Спеки().Разрешить(Пакет, "1.0.0").ВерсиюВыбралХаб, "точную версию назвал клиент").ЭтоЛожь();
	Ожидаем.Что(Спеки().Разрешить(Пакет, "lts").ВерсиюВыбралХаб, "версию тега выбрал хаб").ЭтоИстина();
	Ожидаем.Что(Спеки().Разрешить(Пакет, "^1.0").ВерсиюВыбралХаб, "версию выражения — тоже").ЭтоИстина();
	Ожидаем.Что(Спеки().Разрешить(Пакет, "").ВерсиюВыбралХаб, "и версию основного тега").ЭтоИстина();

КонецПроцедуры

// Чужой источник понимает только координату версии. Спроси его «версией stable» — и в хранилище ляжет артефакт
// с координатой-версией stable, который потом никто не отличит от настоящей версии.
&Тест
Процедура КоординатойВерсииСчитаетсяТолькоЗаписанноеКакВерсия() Экспорт

	Для Каждого Строка_ Из СтрРазделить("1.0.0,1.2.3.4,2.0.0-rc.1,SNAPSHOT", ",") Цикл
		Ожидаем.Что(Спеки().ЭтоСтрокаВерсии(Строка_),
			СтрШаблон("«%1» — координата версии", Строка_)).ЭтоИстина();
	КонецЦикла;

	Для Каждого Строка_ Из СтрРазделить("stable,prerelease,lts,^1.0,~1.2", ",") Цикл
		Ожидаем.Что(Спеки().ЭтоСтрокаВерсии(Строка_),
			СтрШаблон("«%1» координатой версии не является", Строка_)).ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

// Скан упразднённого: удалить домен мало — вызов может пережить его в контроллере, сиде или инструменте и упасть
// только в проде. Множество маркеров ЗАКРЫТО: каждый — имя, которое шаг убрал целиком.
&Тест
Процедура ПинаИТипаLabelНетВПродуктовомКоде() Экспорт

	Нарушители = Новый Массив();
	Проверено = 0;

	Для Каждого Файл_ Из ПродуктовыеФайлы() Цикл
		Проверено = Проверено + 1;
		Текст = ПрочитатьФайл(Файл_.ПолноеИмя);
		Для Каждого Маркер Из МаркерыУпразднённого() Цикл
			Если СтрНайти(Текст, Маркер) > 0 Тогда
				Нарушители.Добавить(СтрШаблон("%1 (%2)", Файл_.Имя, Маркер));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Проверено > 100, СтрШаблон("скан прошёл по продуктовым файлам (%1)",
		Формат(Проверено, "ЧГ=0"))).ЭтоИстина();
	Ожидаем.Что(СканОхватилСкрипты(), "в охват попал scripts/ (там живут сидеры — там жил обход ревью)").ЭтоИстина();

	Ожидаем.Что(СтрСоединить(Нарушители, ", "),
		"упразднённых пина и типа label нет ни в одном продуктовом файле").Равно("");

КонецПроцедуры

// Маркеры упразднённых понятий: режим «пин» (закрепление и открепление тега) и тип правила «label».
Функция МаркерыУпразднённого()
	Возврат СтрРазделить("ЗакрепитьТег,ОткрепитьТег,ТипLabel,Режимы.Пин(,ОтбираетПоСтроке", ",");
КонецФункции

// Маркеры упразднённых каналов: к таблице «Каналы» ведёт только её репозиторий, доменный слой удалён целиком.
Функция МаркерыКаналов()
	Возврат СтрРазделить("ХранилищеКаналов,СервисКаналов,ОписаниеКанала", ",");
КонецФункции

// Все продуктовые .os: src (рекурсивно, включая корень), tools и scripts; tests/ не входит сознательно.
Функция ПродуктовыеФайлы()

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;

	Результат = Новый Массив();
	Для Каждого Корень Из СтрРазделить("src,tools,scripts", ",") Цикл
		Каталог = ОбъединитьПути(КаталогПроекта, Корень);
		Если НЕ Новый Файл(Каталог).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Найденный Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
			Если НЕ Найденный.ЭтоКаталог() Тогда
				Результат.Добавить(Найденный);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Контроль охвата: scripts/ реально попал в перебор (там живут сидеры — ими ревью обошло первую версию).
Функция СканОхватилСкрипты()
	Для Каждого Файл_ Из ПродуктовыеФайлы() Цикл
		Если СтрНайти(Файл_.ПолноеИмя, ОбъединитьПути("scripts", "сидеры")) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Контроль охвата: файлы из КОРНЯ src (там живёт точка входа) реально попали в перебор. Проверяется структурное
// свойство «файл лежит непосредственно в src», а не конкретное имя точки входа.
Функция СканОхватилКореньSrc()

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	// Файл.Путь отдаёт каталог СО СЛЕШЕМ на конце, а ОбъединитьПути — без него, и нормализация слеш не убирает:
	// разделитель добавляем к эталону, иначе сравнение молча не срабатывает
	КореньИсходников = ОбъединитьПути(КаталогПроекта, "src") + ПолучитьРазделительПути();

	Для Каждого Файл_ Из ПродуктовыеФайлы() Цикл
		Если Файл_.Путь = КореньИсходников Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Классы, ИСПОЛНЯЮЩИЕСЯ на публикации и на чтении каналов (граница проверки, см. шапку теста).
Функция КлассыКаналов()
	Возврат СтрРазделить(
		"НаблюдательКаналов,СервисТегов,СоставКаналов,ОтборВерсийПоПравилу,ЛетописьТегов,"
		+ "ПравилоТега,РежимТега,СтильТега,ЗначокТега,СервисМетокВерсий", ",");
КонецФункции

// Сотрудники, которые классам каналов разрешено получать через &Пластилин.
// Список ЗАКРЫТЫЙ: любая новая зависимость роняет тест, пока её здесь не разрешат.
Функция РазрешённыеСотрудники()
	Возврат СтрРазделить(
		"ХранилищеТегов,ХранилищеМетокВерсий,ХранилищеМетокТегов,СервисВерсий,СервисПакетов,"
		+ "СервисПулов,ОтборВерсийПоПравилу,РежимТега,СтильТега,ЗначокТега,ЛетописьТегов,СервисМетокВерсий,"
		+ "РезолверВерсий,ИздательСобытий,СервисТегов,СоставКаналов,ИмяОбъектаАудита", ",");
КонецФункции

// Типы, которые классам каналов разрешено создавать через «Новый»: платформенные значения и собственные
// значения-объекты реестра (ТипПравилаТега — словарь без состояния, зависимостей и ввода-вывода).
Функция РазрешённыеТипы()
	Возврат СтрРазделить(
		"Массив,Структура,Соответствие,ЗаписьJSON,РегулярноеВыражение,ПравилоТега,"
		+ "ТипПравилаТега,РазобранныйДиапазон,РазобраннаяВерсия,"
		+ "УникальныйИдентификатор,ТаблицаЗначений,СписокЗначений", ",");
КонецФункции

// Библиотеки, которые классам каналов разрешено подключать.
Функция РазрешённыеБиблиотеки()
	Возврат СтрРазделить("logos,asserts", ",");
КонецФункции

// Остаточный рубеж: имена сетевых точек входа — для СТАТИЧЕСКОГО вызова типа, уже загруженного в процесс.
Функция СетевыеИмена()
	Возврат СтрРазделить(
		"КоннекторHTTP,КлиентHTTP,КлиентАпстрима,КоннекторHTTPБиблиотеки,HTTPСоединение,"
		+ "HTTPЗапрос,СервисПрокси,СессияИсходящегоHTTP,ТранспортOTLPХаба,ЭкспортёрТелеметрии,"
		+ "СервисЗеркал,СинхронизаторЗеркал,ИсточникАпстримаOpm,ТранспортHTTP", ",");
КонецФункции

// Самопроверка списка: дважды подряд в нём оказывалось имя, которого в проекте НЕТ, — такое имя охраняет пустоту.
// Проверяется тестом СетевыеИменаСуществуют.
Функция ФайлКлассаСуществует(Знач ИмяКласса)

	Прозвище = СтрШаблон("&Прозвище(""%1"")", ИмяКласса);

	Для Каждого Модуль Из МодулиИсходников() Цикл
		Каталог = ОбъединитьПути(Модуль.ПолноеИмя, "Классы");
		// РЕКУРСИВНО (6.B): классы модуля могут лежать по подкаталогам (web-ui).
		Если НайтиФайлы(Каталог, ИмяКласса + ".os", Истина).Количество() > 0 Тогда
			Возврат Истина;
		КонецЕсли;
		// имя желудя может быть ПРОЗВИЩЕМ: единая точка исходящего HTTP — &Прозвище("ТранспортHTTP") у КлиентHTTP
		Для Каждого ФайлКласса Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
			Если СтрНайти(ПрочитатьФайл(ФайлКласса.ПолноеИмя), Прозвище) > 0 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Нарушения инварианта «без сети» в тексте класса. Вынесено отдельной функцией ради негативного самотеста.
Функция НарушенияВТексте(Знач ИмяКласса, Знач Текст)

	Нарушения = Новый Массив();

	// 1) сотрудники через &Пластилин: ищем по «&Пластилин(» и снимаем пробелы, «Значение» и «=» сами — буквальная
	// подстрока пропускала форму без пробелов вокруг «=»
	Для Каждого Имя Из ИменаПластилина(Текст) Цикл
		Если НЕ ВСписке(РазрешённыеСотрудники(), Имя) Тогда
			Нарушения.Добавить(СтрШаблон("%1: запрещённая зависимость ""%2""", ИмяКласса, Имя));
		КонецЕсли;
	КонецЦикла;

	// 2) создаваемые типы
	Для Каждого Имя Из ЗначенияПоМаркеру(Текст, "Новый ") Цикл
		Если НЕ ВСписке(РазрешённыеТипы(), Имя) Тогда
			Нарушения.Добавить(СтрШаблон("%1: создание неразрешённого типа ""%2""", ИмяКласса, Имя));
		КонецЕсли;
	КонецЦикла;

	// 3) подключаемые библиотеки
	Для Каждого Имя Из ЗначенияПоМаркеру(Текст, "#Использовать ") Цикл
		Если НЕ ВСписке(РазрешённыеБиблиотеки(), Имя) Тогда
			Нарушения.Добавить(СтрШаблон("%1: запрещённая библиотека ""%2""", ИмяКласса, Имя));
		КонецЕсли;
	КонецЦикла;

	// 4) остаточный рубеж: статический вызов сетевой точки входа
	Для Каждого Сетевое Из СетевыеИмена() Цикл
		Если СтрНайти(Текст, Сетевое) > 0 Тогда
			Нарушения.Добавить(СтрШаблон("%1: упоминание сетевой точки входа ""%2""", ИмяКласса, Сетевое));
		КонецЕсли;
	КонецЦикла;

	Возврат Нарушения;

КонецФункции

// Имена желудей из всех «&Пластилин(...)» текста, независимо от пробелов вокруг «=».
Функция ИменаПластилина(Знач Текст)

	Результат = Новый Массив();
	Позиция = СтрНайти(Текст, "&Пластилин(");

	Пока Позиция > 0 Цикл

		Хвост = Сред(Текст, Позиция + СтрДлина("&Пластилин("));
		Кавычка = СтрНайти(Хвост, """");
		Закрывающая = СтрНайти(Хвост, ")");

		// имя берём только если кавычка встретилась ДО закрывающей скобки — иначе это &Пластилин без «Значение»
		Если Кавычка > 0 И (Закрывающая = 0 ИЛИ Кавычка < Закрывающая) Тогда
			Остаток = Сред(Хвост, Кавычка + 1);
			Конец = СтрНайти(Остаток, """");
			Если Конец > 1 Тогда
				Результат.Добавить(Лев(Остаток, Конец - 1));
			КонецЕсли;
		КонецЕсли;

		Смещение = СтрНайти(Хвост, "&Пластилин(");
		Позиция = ?(Смещение = 0, 0, Позиция + СтрДлина("&Пластилин(") + Смещение - 1);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Только СЕТЕВЫЕ нарушения (кольцо 2): белые списки сотрудников и типов к прямым сотрудникам не применяются.
Функция СетевыеНарушенияВТексте(Знач ИмяКласса, Знач Текст)

	Нарушения = Новый Массив();

	Для Каждого Имя Из ЗначенияПоМаркеру(Текст, "#Использовать ") Цикл
		Если НЕ ВСписке(РазрешённыеБиблиотекиКольца2(), Имя) Тогда
			Нарушения.Добавить(СтрШаблон("%1: сетевая библиотека ""%2""", ИмяКласса, Имя));
		КонецЕсли;
	КонецЦикла;

	Для Каждого Сетевое Из СетевыеИмена() Цикл
		Если СтрНайти(Текст, Сетевое) > 0 Тогда
			Нарушения.Добавить(СтрШаблон("%1: сетевая точка входа ""%2""", ИмяКласса, Сетевое));
		КонецЕсли;
	КонецЦикла;

	Возврат Нарушения;

КонецФункции

// Кольцу 2 разрешено больше библиотек: запрещены именно транспортные (1connector и прочее, чем ходят в сеть).
Функция РазрешённыеБиблиотекиКольца2()
	Возврат СтрРазделить("logos,asserts,autumn,autumn-data,entity,semver,json,jason,fs,configor", ",");
КонецФункции

// Исходник класса по имени в ЛЮБОМ модуле (кольцо 2 живёт не только в core-registry).
Функция ПрочитатьЛюбойКласс(Знач ИмяКласса)

	// РЕКУРСИВНО: классы модуля лежат по подкаталогам (web-ui, db) — плоский путь
	// молча не находил бы сотрудника, и охват кольца 2 проседал бы незаметно.
	Для Каждого Модуль Из МодулиИсходников() Цикл
		Найденные = НайтиФайлы(ОбъединитьПути(Модуль.ПолноеИмя, "Классы"), ИмяКласса + ".os", Истина);
		Если Найденные.Количество() > 0 Тогда
			Возврат ПрочитатьФайл(Найденные[0].ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Значения, идущие сразу за маркером, до первого разделителя: нужны имена после «Новый » и «#Использовать ».
Функция ЗначенияПоМаркеру(Знач Текст, Знач Маркер)

	Результат = Новый Массив();
	Позиция = СтрНайти(Текст, Маркер);

	Пока Позиция > 0 Цикл
		Хвост = Сред(Текст, Позиция + СтрДлина(Маркер));
		Имя = "";
		Для Индекс = 1 По СтрДлина(Хвост) Цикл
			Символ = Сред(Хвост, Индекс, 1);
			Если СтрНайти("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
				+ "абвгдеёжзийклмнопрстуфхцчшщъыьэюяАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ0123456789-_", Символ) = 0 Тогда
				Прервать;
			КонецЕсли;
			Имя = Имя + Символ;
		КонецЦикла;
		Если ЗначениеЗаполнено(Имя) Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
		СледующийХвост = Сред(Текст, Позиция + СтрДлина(Маркер));
		Смещение = СтрНайти(СледующийХвост, Маркер);
		Позиция = ?(Смещение = 0, 0, Позиция + СтрДлина(Маркер) + Смещение - 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ВСписке(Знач Список, Знач Значение)
	Для Каждого Элемент Из Список Цикл
		Если СокрЛП(Элемент) = СокрЛП(Значение) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура ОжидатьНарушение(Знач Пояснение, Знач Текст)
	Найденные = НарушенияВТексте("Проба", Текст);
	Ожидаем.Что(Найденные.Количество() > 0,
		СтрШаблон("сканер ловит: %1 (нашёл: %2)", Пояснение, СтрСоединить(Найденные, "; "))).ЭтоИстина();
КонецПроцедуры


// Каталоги модулей src/модули (для сканирующих инвариантов).
Функция МодулиИсходников()

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Корень = ОбъединитьПути(КаталогПроекта, "src", "модули");

	Результат = Новый Массив();
	Для Каждого Элемент Из НайтиФайлы(Корень, "*") Цикл
		Если Элемент.ЭтоКаталог() Тогда
			Результат.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПрочитатьФайл(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);
КонецФункции


// Печатает замер в файл (Сообщить OneUnit не показывает). Имя файла — параметр: замеров два, и общий файл они бы
// затирали друг у друга.
Процедура ЗаписатьЗамер(Знач Текст, Знач ИмяФайла = "oshub-замер-тегов.txt")
	Попытка
		Путь = ОбъединитьПути(КаталогВременныхФайлов(), ИмяФайла);
		Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
		Запись.ЗаписатьСтроку(Текст);
		Запись.Закрыть();
	Исключение
	КонецПопытки;
КонецПроцедуры

// Исходник класса core-registry (для структурного инварианта «без сети» выше).
Функция ПрочитатьКлассРеестра(Знач ИмяКласса)

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассов = ОбъединитьПути(КаталогПроекта, "src", "модули");
	КаталогКлассов = ОбъединитьПути(КаталогКлассов, "реестр", "Классы");
	Путь = ОбъединитьПути(КаталогКлассов, ИмяКласса + ".os");

	Если НЕ Новый Файл(Путь).Существует() Тогда
		Возврат "";
	КонецЕсли;

	Возврат ПрочитатьФайл(Путь);

КонецФункции


Функция Теги()
	Возврат Поделка.НайтиЖелудь("СервисТегов");
КонецФункции

Функция Спеки()
	Возврат Поделка.НайтиЖелудь("РезолверСпецификации");
КонецФункции

// СОСТАВ КАНАЛА строкой «1.0.0,1.2.0». У тега-ПРАВИЛА состава в базе нет вовсе, поэтому он спрашивается у домена;
// сверяется он с ЯВНО перечисленным ожиданием, а не с другим выводом того же домена. Что в базе для правила ПУСТО,
// проверяет отдельный тест через МетокВХранилище.
Функция СтрокиСостава(Знач Тег)

	Строки = Новый Массив();
	Для Каждого Версия Из Теги().ВерсииТега(Тег) Цикл
		Строки.Добавить(Строка(Версия.Версия));
	КонецЦикла;

	Возврат СтрСоединить(ПоАлфавиту(Строки), ",");

КонецФункции

// Сколько строк МеткиТегов лежит в базе на этом теге — материализация состава, а не её витрина.
Функция МетокВХранилище(Знач Тег)
	Найденные = Желудь("ХранилищеМетокТегов").ПолучитьПоТегИдентификаторРавно(Тег.Идентификатор);
	Возврат ?(Найденные = Неопределено, 0, Найденные.Количество());
КонецФункции

// Сортировка строк пузырьком: у Массива метода сортировки нет, а порядок строк из хранилища не гарантирован.
Функция ПоАлфавиту(Знач Исходные)

	Результат = Новый Массив();
	Для Каждого Значение Из Исходные Цикл
		Результат.Добавить(Значение);
	КонецЦикла;

	Для Внешний = 0 По Результат.Количество() - 2 Цикл
		Для Внутренний = 0 По Результат.Количество() - 2 - Внешний Цикл
			Если Результат[Внутренний] > Результат[Внутренний + 1] Тогда
				Буфер = Результат[Внутренний];
				Результат[Внутренний] = Результат[Внутренний + 1];
				Результат[Внутренний + 1] = Буфер;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Подкладывает метку МИМО сервисного слоя — так проверяется защита в глубину, а не надстройка над ней.
Процедура ПодложитьМетку(Знач Тег, Знач Версия)
	Метка = Желудь("ХранилищеМетокТегов").СоздатьЭлемент();
	Метка.ТегИдентификатор = Тег.Идентификатор;
	Метка.ВерсияИдентификатор = Версия.Идентификатор;
	Метка.Сохранить();
КонецПроцедуры

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Функция ТеговСИменем(Знач ПакетИдентификатор, Знач Имя)
	Счёт = 0;
	Для Каждого Тег Из Теги().ТегиПакета(ПакетИдентификатор) Цикл
		Если НРег(Строка(Тег.Имя)) = НРег(Имя) Тогда
			Счёт = Счёт + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Счёт;
КонецФункции

// Событие «версия опубликована» в той же форме, в какой его публикует СервисПубликации — через настоящий издатель.
// Действие различает публикацию новой версии и перезапись существующей.
Процедура ОпубликоватьСобытиеПубликации(Знач Пакет, Знач СтрокаВерсии, Знач Действие = "публикация.версии")

	Издатель = Желудь("ИздательСобытий");
	Пул = Желудь("СервисПулов").ПулПоИдентификатору(Пакет.ПулИдентификатор);

	Данные = Новый Структура();
	Данные.Вставить("Кто", "tests");
	Данные.Вставить("Действие", Действие);
	Данные.Вставить("Объект", СтрШаблон("%1/%2@%3", Пул.Имя, Пакет.Имя, СтрокаВерсии));
	Данные.Вставить("ДеталиJSON", "");
	Данные.Вставить("АдресIP", "");
	Данные.Вставить("ПулИдентификатор", Пул.Идентификатор);
	Данные.Вставить("ИмяПула", Пул.Имя);
	Данные.Вставить("ИмяПакета", Пакет.Имя);
	Данные.Вставить("Версия", СтрокаВерсии);

	Издатель.Опубликовать(Издатель.ТипВерсияОпубликована(), Данные);

КонецПроцедуры

// Событие yank/unyank в форме КонтроллераДомаПакета.
Процедура ОпубликоватьСобытиеОтзыва(Знач Пакет, Знач СтрокаВерсии, Знач Отзыв)

	Издатель = Желудь("ИздательСобытий");
	Пул = Желудь("СервисПулов").ПулПоИдентификатору(Пакет.ПулИдентификатор);

	Данные = Новый Структура();
	Данные.Вставить("ПулИдентификатор", Пул.Идентификатор);
	Данные.Вставить("ИмяПула", Пул.Имя);
	Данные.Вставить("ИмяПакета", Пакет.Имя);
	Данные.Вставить("Версия", СтрокаВерсии);
	Данные.Вставить("Отозвана", Отзыв = Истина);

	Издатель.Опубликовать(
		?(Отзыв, Издатель.ТипВерсияОтозвана(), Издатель.ТипВерсияВосстановлена()), Данные);

КонецПроцедуры

Функция НовыйПакетСВерсиями(Знач Префикс, Знач СписокВерсий)

	НомерПула = НомерПула + 1;
	Пул = Желудь("СервисПулов").СоздатьПул(Префикс + "-pool-" + Формат(НомерПула, "ЧГ=0"));
	Пакет = Желудь("СервисПакетов").ЗарегистрироватьПакет(Пул.Идентификатор, Префикс + "-pkg");

	Для Каждого Строка_ Из СтрРазделить(СписокВерсий, ",", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Строка_)) Тогда
			Желудь("СервисВерсий").Опубликовать(
				Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, СокрЛП(Строка_)));
		КонецЕсли;
	КонецЦикла;

	Возврат Пакет;

КонецФункции

// Приём версии без артефакта на диске: размер и сумма для тегов роли не играют.
Функция ПустойАртефакт()
	Возврат Новый Структура("Размер, Sha256", 0, "");
КонецФункции

Функция ОпубликоватьВерсию(Знач Пакет, Знач СтрокаВерсии)
	Возврат Желудь("СервисВерсий").Опубликовать(
		Новый ЗаявкаНаПубликацию(Пакет.Идентификатор, СтрокаВерсии));
КонецФункции

Процедура ОжидатьИсключение(Знач Пояснение, Знач ПакетИд, Знач Имя, Знач Тип, Знач Правило)

	БылоИсключение = Ложь;
	Попытка
		Теги().ОпределитьТегПравила(ПакетИд, Имя, Тип, Правило);
	Исключение
		БылоИсключение = Истина;
	КонецПопытки;
	Ожидаем.Что(БылоИсключение, Пояснение).ЭтоИстина();

КонецПроцедуры

Функция РазмножитьСимвол(Знач Символ, Знач Количество)
	Результат = "";
	Для Индекс = 1 По Количество Цикл
		Результат = Результат + Символ;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПодключитьОдинКласс(Знач Каталог, Знач ИмяКласса)
	Если НЕ ТипЗарегистрирован(ИмяКласса) Тогда
		ПодключитьСценарий(ОбъединитьПути(Каталог, ИмяКласса + ".os"), ИмяКласса);
	КонецЕсли;
КонецПроцедуры

Процедура ПодключитьКлассыКаталога(Знач КаталогКлассов)
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		Если НЕ ТипЗарегистрирован(ФайлКласса.ИмяБезРасширения) Тогда
			ПодключитьСценарий(ФайлКласса.ПолноеИмя, ФайлКласса.ИмяБезРасширения);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ЖурналАудита()
	Возврат Новый ЖурналАудитаФайлом(Поделка.НайтиЖелудь("ЧитательЖурналаАудита"));
КонецФункции
