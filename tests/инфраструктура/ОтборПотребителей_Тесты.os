// Отбор scripts/тесты.sh на стенде из двух модулей: кто попадает в прогон модуля с потребителями
// и почему, а кто — нет. По этому отбору разработчик решает, что прогнать перед коммитом.

#Использовать asserts
#Использовать "../фикстуры"

Перем Стенд;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьСтенд() Экспорт

	Стенд = УникальныеИмена.ВременныйКаталог("oshub-отбор-потребителей");

	СоздатьКаталог(ОбъединитьПути(Стенд, "scripts"));
	Для Каждого Скрипт Из СтрРазделить("тесты.sh,шапка-прогона.sh", ",") Цикл
		КопироватьФайл(ОбъединитьПути(КаталогиПроекта.Корень(), "scripts", Скрипт),
			ОбъединитьПути(Стенд, "scripts", Скрипт));
	КонецЦикла;

	ЗаписатьФайл("src/модули/склад/Классы/Полка.os", "");
	ЗаписатьФайл("src/модули/склад/Классы/Ящик.os", "");
	ЗаписатьФайл("src/модули/склад/Классы/КлючиНастроекСклада.os", "");
	ЗаписатьФайл("src/модули/касса/Классы/Чек.os", "");

	ЗаписатьФайл("tests/склад/Полка_Тесты.os", "");
	ЗаписатьФайл("tests/касса/ПоКлассу_Тесты.os", "Полка = Новый(""Полка"");");
	ЗаписатьФайл("tests/касса/ПоПеречню_Тесты.os", "Имена = СтрРазделить(""Чек, Ящик,"", "","");");
	ЗаписатьФайл("tests/касса/ПоКаталогу_Тесты.os", "Каталог = ОбъединитьПути(Модули, ""склад"", ""Классы"");");
	ЗаписатьФайл("tests/касса/ПоФикстуре_Тесты.os", "РеестрФикстур.Подключить(""ВитринаСклада"");");
	ЗаписатьФайл("tests/касса/фикстуры/ВитринаСклада.os", "Полка = Новый(""Полка"");");
	ЗаписатьФайл("tests/касса/АдресAPI_Тесты.os", "Ответ = Клиент.GET(""/api/v1/склад/полки"");");
	ЗаписатьФайл("tests/касса/Чужой_Тесты.os", "Чек = Новый(""Чек"");");
	ЗаписатьФайл("tests/касса/ВсеКлючи_Тесты.os", "РеестрНастроекХаба.ПодключитьКлючиВсехПредметов(Поиск, Модули);");
	ЗаписатьФайл("tests/касса/СвоиКлючи_Тесты.os", "РеестрНастроекХаба.ПодключитьКлассы(Поиск, Модули);");
	ЗаписатьФайл("tests/касса/ВызовВЛитерале_Тесты.os",
		"Образец = ""РеестрНастроекХаба.ПодключитьКлючиВсехПредметов(Поиск, Модули);"";");
	ЗаписатьФайл("tests/касса/ВызовВМногострочномЛитерале_Тесты.os", "Образец = ""первая" + Символы.ПС
		+ "|РеестрНастроекХаба.ПодключитьКлючиВсехПредметов(Поиск, Модули);"";");
	ЗаписатьФайл("tests/касса/ВызовВКомментарии_Тесты.os",
		"// РеестрНастроекХаба.ПодключитьКлючиВсехПредметов(Поиск, Модули);");
	ЗаписатьФайл("tests/касса/МеждуЛитералами_Тесты.os", "Ф(""а"", Полка, ""б"");");
	ЗаписатьФайл("tests/сквозные/Линт_Тесты.os", "");
	ЗаписатьФайл("tests/инфраструктура/Самотест_Тесты.os", "");
	ЗаписатьФайл("tests/e2e/склад/Живой_Тесты.os", "");

	ЗаписатьФайл("tests/внешние/Внешний_Тесты.os", "&Тег(""внешние"")" + Символы.ПС + "Процедура ПриСозданииОбъекта() Экспорт");
	ЗаписатьФайл("tests/внешние/ВнешнийИзолированный_Тесты.os", "&Изолированный(Уровень = ""Процесс"")"
		+ Символы.ПС + "&Тег(""внешние"")" + Символы.ПС + "Процедура ПриСозданииОбъекта() Экспорт");

КонецПроцедуры

&ПослеВсех
Процедура УбратьСтенд() Экспорт
	Если Стенд <> Неопределено Тогда
		УникальныеИмена.УбратьВременное(Стенд);
	КонецЕсли;
КонецПроцедуры

&Тест
Процедура ПотребительНаходитсяПоКлассуПеречнюКаталогуИФикстуре() Экспорт

	Отбор = Отбор("склад --с-потребителями");

	Ожидаем.Что(Отбор.Получить("tests/касса/ПоКлассу_Тесты.os"), "имя класса литералом")
		.Равно("класс Полка");
	Ожидаем.Что(Отбор.Получить("tests/касса/ПоПеречню_Тесты.os"), "класс в перечне через запятую")
		.Равно("класс Ящик в перечне");
	Ожидаем.Что(Отбор.Получить("tests/касса/ПоКаталогу_Тесты.os"), "каталог классов модуля")
		.Равно("каталог модуля");
	Ожидаем.Что(Отбор.Получить("tests/касса/ПоФикстуре_Тесты.os"), "через фикстуру, грузящую класс")
		.Равно("фикстура ВитринаСклада: класс Полка");

КонецПроцедуры

&Тест
Процедура АдресAPIИЧужойКлассПотребителяНеДелают() Экспорт

	Отбор = Отбор("склад --с-потребителями");

	Ожидаем.Что(Отбор.Получить("tests/касса/АдресAPI_Тесты.os"), "адрес /api/v1/<модуль>/ — не каталог модуля")
		.ЭтоНеопределено();
	Ожидаем.Что(Отбор.Получить("tests/касса/Чужой_Тесты.os"), "набор, грузящий только чужие классы")
		.ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура КлючиНастроекВсехПредметовДелаютПотребителемТолькоПоПросьбе() Экспорт

	Отбор = Отбор("склад --с-потребителями");

	Ожидаем.Что(Отбор.Получить("tests/касса/ВсеКлючи_Тесты.os"), "сторож полноты реестра настроек")
		.Равно("ключи настроек всех предметов");
	Ожидаем.Что(Отбор.Получить("tests/касса/СвоиКлючи_Тесты.os"),
		"реестр настроек без просьбы о ключах всех: ключи едут только за классами").ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ЛитералИКомментарийСТекстомВызоваПотребителемНеДелают() Экспорт

	Отбор = Отбор("склад --с-потребителями");

	Ожидаем.Что(Отбор.Получить("tests/касса/ВызовВЛитерале_Тесты.os"), "вызов внутри строкового литерала")
		.ЭтоНеопределено();
	Ожидаем.Что(Отбор.Получить("tests/касса/ВызовВМногострочномЛитерале_Тесты.os"),
		"вызов на строке продолжения многострочного литерала").ЭтоНеопределено();
	Ожидаем.Что(Отбор.Получить("tests/касса/ВызовВКомментарии_Тесты.os"), "вызов в комментарии")
		.ЭтоНеопределено();
	Ожидаем.Что(Отбор.Получить("tests/касса/МеждуЛитералами_Тесты.os"),
		"имя класса кодом между двумя литералами — не перечень").ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ПрогонМодуляБерётСвоиИСквозныеНаборыАЖивыеТолькоСE2E() Экспорт

	Отбор = Отбор("склад");

	Ожидаем.Что(Отбор.Получить("tests/склад/Полка_Тесты.os") <> Неопределено, "свой набор").ЭтоИстина();
	Ожидаем.Что(Отбор.Получить("tests/сквозные/Линт_Тесты.os") <> Неопределено, "сквозной набор").ЭтоИстина();
	Ожидаем.Что(Отбор.Получить("tests/касса/ПоКлассу_Тесты.os"), "потребителей без ключа нет").ЭтоНеопределено();
	Ожидаем.Что(Отбор.Получить("tests/e2e/склад/Живой_Тесты.os"), "живой набор — только с --e2e").ЭтоНеопределено();

	Ожидаем.Что(Отбор("склад --e2e").Получить("tests/e2e/склад/Живой_Тесты.os") <> Неопределено,
		"с --e2e живой набор модуля в прогоне").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РегрессияНеПоказываетНаборовКоторыеФильтрТегаСнимет() Экспорт

	Отбор = Отбор("--всё");

	Ожидаем.Что(Отбор.Получить("tests/внешние/Внешний_Тесты.os"),
		"неизолированный внешний набор -T внешние снимет сам").ЭтоНеопределено();
	Ожидаем.Что(Отбор.Получить("tests/внешние/ВнешнийИзолированный_Тесты.os") <> Неопределено,
		"изолированный внешний набор запускается и пропускает себя сам").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ИнфраструктураБерётТолькоСамотестыОбвязки() Экспорт

	Отбор = Отбор("--инфраструктура");

	Ожидаем.Что(Отбор.Получить("tests/инфраструктура/Самотест_Тесты.os") <> Неопределено, "самотест обвязки")
		.ЭтоИстина();
	Ожидаем.Что(Отбор.Количество(), "ни модульных, ни сквозных наборов").Равно(1);

КонецПроцедуры

#Область Стенд

// Отбор скрипта стенда: набор → причина; у своих и сквозных наборов причина пустая.
Функция Отбор(Знач Ключи)

	Процесс = СоздатьПроцесс("bash scripts/тесты.sh " + Ключи + " --список", Стенд, Истина, Истина);
	Процесс.Запустить();

	Куски = Новый Массив();
	Пока НЕ Процесс.Завершен Цикл
		ДочитатьВывод(Процесс, Куски);
		Приостановить(100);
	КонецЦикла;
	ДочитатьВывод(Процесс, Куски);
	Вывод = СтрСоединить(Куски, "");

	Ожидаем.Что(Процесс.КодВозврата, "скрипт отработал: " + Вывод).Равно(0);

	Результат = Новый Соответствие();
	Для Каждого Строка_ Из СтрРазделить(Вывод, Символы.ПС, Ложь) Цикл
		Если НЕ СтрНачинаетсяС(Строка_, "   tests/") Тогда
			Продолжить;
		КонецЕсли;
		Части = СтрРазделить(СокрЛП(Строка_), "←");
		Результат.Вставить(СокрЛП(Части[0]), ?(Части.Количество() > 1, СокрЛП(Части[1]), ""));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Поток процесса отдаёт данные один раз и пустым отвечает Неопределено.
Процедура ДочитатьВывод(Знач Процесс, Куски)
	ДобавитьПрочитанное(Куски, Процесс.ПотокВывода.Прочитать());
	ДобавитьПрочитанное(Куски, Процесс.ПотокОшибок.Прочитать());
КонецПроцедуры

Процедура ДобавитьПрочитанное(Куски, Знач Прочитанное)
	Если Прочитанное <> Неопределено Тогда
		Куски.Добавить(Строка(Прочитанное));
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьФайл(Знач Относительный, Знач Текст)

	Путь = ОбъединитьПути(Стенд, Относительный);
	СоздатьКаталог(Новый Файл(Путь).Путь);

	// байтами: запись текстом ставит переводы строк CRLF, и bash их не читает
	ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8").Записать(Путь);

КонецПроцедуры

#КонецОбласти
