// Корзины, сводка, время наборов и карантин scripts/тесты.sh на стенде с заглушкой oneunit: по сводке
// параллельного прогона ревьюер принимает работу так же, как по выводу одного oneunit.

#Использовать asserts
#Использовать "../фикстуры"

Перем Стенд;
Перем Корень;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьСтенд() Экспорт

	Стенд = УникальныеИмена.ВременныйКаталог("oshub-параллельный-прогон");
	Корень = ОбъединитьПути(Стенд, "дерево");

	// заглушка oneunit: печатает свой каталог, на каждый -f — «набор: <путь>» и складывает пометку
	// набора «// тестов N ошибок M»; набор с пометкой «// молчит» обрывает прогон без статистики,
	// с пометкой «// спит» — ждёт две секунды, с пометкой «// долго» — полминуты дочерним sleep, записав
	// в pids рядом с bin свой PID и PID sleep; без oscript_modules рядом отказывает, как настоящий
	ЗаписатьФайл(Стенд, "bin/oneunit", "#!/bin/sh
		|echo ""каталог: $(pwd -P)""
		|if [ ! -f oscript_modules/метка ]; then echo 'Библиотека не найдена'; exit 1; fi
		|suites=0; tests=0; failed=0; failed_suites=0
		|while [ $# -gt 0 ]; do
		|	if [ ""$1"" = -f ]; then
		|		shift
		|		echo ""набор: $1""
		|		if grep -q '^// молчит' ""$1""; then exit 0; fi
		|		if grep -q '^// спит' ""$1""; then sleep 2; fi
		|		if grep -q '^// долго' ""$1""; then
		|			sleep 30 & echo ""$$ $!"" >> ""$(dirname ""$0"")/../pids""; wait
		|		fi
		|		n=$(sed -n 's#^// тестов \([0-9]*\) ошибок [0-9]*$#\1#p' ""$1"")
		|		m=$(sed -n 's#^// тестов [0-9]* ошибок \([0-9]*\)$#\1#p' ""$1"")
		|		suites=$((suites + 1)); tests=$((tests + ${n:-0})); failed=$((failed + ${m:-0}))
		|		if [ ""${m:-0}"" -gt 0 ]; then failed_suites=$((failed_suites + 1)); fi
		|	fi
		|	shift
		|done
		|printf '[         %s Наборов обнаружено         ]\n' $suites
		|printf '[         0 Наборов пропущено          ]\n'
		|printf '[         0 Наборов прервано           ]\n'
		|printf '[         %s Наборов успешных           ]\n' $((suites - failed_suites))
		|printf '[         %s Наборов ошибочных          ]\n' $failed_suites
		|echo
		|printf '[         %s Тестов обнаружено          ]\n' $tests
		|printf '[         0 Тестов пропущено           ]\n'
		|printf '[         0 Тестов прервано            ]\n'
		|printf '[         %s Тестов успешных            ]\n' $((tests - failed))
		|printf '[         %s Тестов ошибочных           ]\n' $failed
		|if [ $failed -gt 0 ]; then echo 'Тестирование завершилось неудачно'; exit 1; fi
		|echo 'Тестирование завершилось удачно'
		|");
	ЗаписатьФайл(Стенд, "бег.sh", "stand=""$(cd ""$(dirname ""$0"")"" && pwd)""
		|export PATH=""$stand/bin:$PATH""
		|export GIT_CEILING_DIRECTORIES=""$stand""
		|exec env ""$@""
		|");
	ВыполнитьКоманду("chmod +x bin/oneunit", Стенд);

	СоздатьКаталог(ОбъединитьПути(Корень, "scripts"));
	Для Каждого Скрипт Из СтрРазделить("тесты.sh,шапка-прогона.sh", ",") Цикл
		КопироватьФайл(ОбъединитьПути(КаталогиПроекта.Корень(), "scripts", Скрипт),
			ОбъединитьПути(Корень, "scripts", Скрипт));
	КонецЦикла;
	ЗаписатьФайл(Корень, "src/модули/склад/Классы/Полка.os", "");

	// разные размеры файлов: корзины выравниваются по сумме размеров
	Для Номер = 1 По 6 Цикл
		Текст = Новый Массив();
		Текст.Добавить(СтрШаблон("// тестов %1 ошибок 0", Номер));
		Для Строка_ = 1 По Номер * 10 Цикл
			Текст.Добавить("//");
		КонецЦикла;
		ЗаписатьФайл(Корень, СтрШаблон("tests/склад/Набор%1_Тесты.os", Номер),
			СтрСоединить(Текст, Символы.ПС) + Символы.ПС);
	КонецЦикла;
	ЗаписатьФайл(Корень, "tests/сквозные/Линт_Тесты.os", "// тестов 10 ошибок 0" + Символы.ПС);
	ЗаписатьФайл(Корень, "tests/e2e/склад/Живой_Тесты.os", "// тестов 2 ошибок 0" + Символы.ПС);

	// карантин: попади он в обычный прогон — ошибка его пометки покраснит сводку
	ЗаписатьФайл(Корень, "tests/склад/Полка_Плавающие_Тесты.os", "// тестов 100 ошибок 1" + Символы.ПС);
	ЗаписатьФайл(Корень, "tests/e2e/склад/Живой_Плавающие_Тесты.os", "// тестов 200 ошибок 1" + Символы.ПС);

	// корзины стоят на снимке дерева в воркспейсах git: стенд — репозиторий, зависимости в нём
	// не версионируются
	ЗаписатьФайл(Корень, ".gitignore", "oscript_modules" + Символы.ПС);
	ЗаписатьФайл(Корень, "oscript_modules/метка", "");
	ВыполнитьКоманду("git init -q", Корень);
	Зафиксировать();

КонецПроцедуры

&ПослеВсех
Процедура УбратьСтенд() Экспорт
	Если Стенд <> Неопределено Тогда
		УникальныеИмена.УбратьВременное(Стенд);
	КонецЕсли;
КонецПроцедуры

&ПередКаждым
Процедура УбратьРазовыеНаборыИПравки() Экспорт
	ВыполнитьКоманду("git checkout -- .", Корень);
	УдалитьФайлы(ОбъединитьПути(Корень, "tests", "склад"), "Разовый*");
	Зафиксировать();
КонецПроцедуры

#Область Корзины

&Тест
Процедура КаждыйНаборПопадаетРовноВОднуКорзину() Экспорт

	Прогон = Прогон("scripts/тесты.sh склад --параллельно 3");

	Попадания = ПопаданияВКорзины(Прогон);
	Ожидаем.Что(Попадания.Количество(), "отобраны все наборы модуля").Равно(6);
	Корзины = Новый Соответствие();
	Для Каждого Попадание Из Попадания Цикл
		Ожидаем.Что(Попадание.Значение.Количество(), "набор в одной корзине: " + Попадание.Ключ).Равно(1);
		Корзины.Вставить(Попадание.Значение[0], Истина);
	КонецЦикла;
	Ожидаем.Что(Корзины.Количество(), "работают все три корзины").Равно(3);
	Ожидаем.Что(Прогон.Вывод, "состав корзин напечатан до запуска").Содержит("== корзина 3/3: tests/");
	Ожидаем.Что(Итог(Прогон), "итог прогона").Равно(СтрШаблон("код 0, коммит %1, дерево чистое и не менялось",
		СокрЛП(ВыполнитьКоманду("git rev-parse HEAD", Корень))));

КонецПроцедуры

&Тест
Процедура КорзинНеБольшеЧемНаборов() Экспорт

	Прогон = Прогон("scripts/тесты.sh склад --параллельно 20");

	Ожидаем.Что(Прогон.Вывод, "лишних корзин нет").Содержит("— 6 наборов, корзин 6");
	Для Каждого Попадание Из ПопаданияВКорзины(Прогон) Цикл
		Ожидаем.Что(Попадание.Значение.Количество(), "набор в одной корзине: " + Попадание.Ключ).Равно(1);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ОднаКорзинаЭтоПрежнийПрогон() Экспорт

	Для Каждого Ключи Из СтрРазделить("склад|склад --параллельно 1", "|") Цикл
		Прогон = Прогон("scripts/тесты.sh " + Ключи);
		Ожидаем.Что(Прогон.Вывод, "без корзин: " + Ключи).Не_().Содержит("корзина");
		Ожидаем.Что(СтрЧислоВхождений(Прогон.Вывод, "Тестирование завершилось удачно"),
			"один oneunit на все наборы: " + Ключи).Равно(1);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура НеЧислоКорзинОтбивается() Экспорт

	Для Каждого Значение Из СтрРазделить("0,03,два,-1", ",") Цикл
		Исполнение = Исполнить("bash ../бег.sh bash scripts/тесты.sh склад --параллельно " + Значение, Корень);
		Ожидаем.Что(Исполнение.Код, "отказ ключом: " + Значение).Равно(2);
		Ожидаем.Что(Исполнение.Вывод, "до oneunit не дошло: " + Значение).Не_().Содержит("набор:");
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Воркспейсы

&Тест
Процедура КаждаяКорзинаРаботаетВСвоёмВоркспейсе() Экспорт

	Прогон = Прогон("scripts/тесты.sh склад --параллельно 3");

	Каталоги = Новый Соответствие();
	Для Каждого Строка_ Из Прогон.Строки Цикл
		Если СтрНачинаетсяС(Строка_, "корзина ") И СтрНайти(Строка_, " │ каталог: ") > 0 Тогда
			Каталог = Сред(Строка_, СтрНайти(Строка_, " │ каталог: ") + СтрДлина(" │ каталог: "));
			Каталоги.Вставить(Каталог, Истина);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Каталоги.Количество(), "три корзины — три каталога: " + Прогон.Вывод).Равно(3);
	Корневой = СокрЛП(ВыполнитьКоманду("pwd -P", Корень));
	Для Каждого Каталог Из Каталоги Цикл
		Ожидаем.Что(СтрНачинаетсяС(Каталог.Ключ, Корневой), "корзина вне дерева: " + Каталог.Ключ).ЭтоЛожь();
	КонецЦикла;
	Ожидаем.Что(Прогон.Вывод, "каждой корзине — свои зависимости").Не_().Содержит("Библиотека не найдена");
	Ожидаем.Что(Предпоследняя(Прогон), "вердикт сводки").Равно("Тестирование завершилось удачно");

КонецПроцедуры

&Тест
Процедура ВременныеВоркспейсыСнимаютсяПослеПрогона() Экспорт

	До = Воркспейсы();

	Прогон("scripts/тесты.sh склад --параллельно 3");
	Ожидаем.Что(Воркспейсы(), "после зелёного прогона").Равно(До);

	ЗаписатьФайл(Корень, "tests/склад/Разовый_Тесты.os", "// тестов 4 ошибок 1" + Символы.ПС);
	Зафиксировать();
	Прогон("scripts/тесты.sh склад --параллельно 3");
	Ожидаем.Что(Воркспейсы(), "после красного прогона").Равно(До);

КонецПроцедуры

&Тест
Процедура КорзиныГоняютПравкиРабочегоДерева() Экспорт

	ЗаписатьФайл(Корень, "tests/склад/Разовый_Тесты.os", "// тестов 1 ошибок 0" + Символы.ПС);
	ЗаписатьФайл(Корень, "tests/сквозные/Линт_Тесты.os", "// тестов 11 ошибок 0" + Символы.ПС);

	Прогон = Прогон("scripts/тесты.sh склад --сквозные --параллельно 3");

	Ожидаем.Что(ПопаданияВКорзины(Прогон)["tests/склад/Разовый_Тесты.os"], "новый файл в корзине")
		.Не_().Равно(Неопределено);
	Ожидаем.Что(Статистика(Прогон, "Тестов обнаружено"), "1+…+6, 11 правленых сквозных и 1 нового").Равно(33);
	Ожидаем.Что(Итог(Прогон), "итог прогона").Равно(СтрШаблон("код 0, коммит %1, дерево с правками и не менялось",
		СокрЛП(ВыполнитьКоманду("git rev-parse HEAD", Корень))));
	Ожидаем.Что(Прогон.Вывод, "шапка честно называет правки").Содержит("== прогон.дерево: с правками, путей 2");

КонецПроцедуры

&Тест
Процедура СнимокДереваНеТрогаетИндексЧекаута() Экспорт

	ЗаписатьФайл(Корень, "tests/склад/Разовый_Тесты.os", "// тестов 1 ошибок 0" + Символы.ПС);
	До = ВыполнитьКоманду("git status --porcelain --untracked-files=all", Корень);
	ГоловаДо = ВыполнитьКоманду("git rev-parse HEAD", Корень);

	Прогон("scripts/тесты.sh склад --параллельно 3");

	Ожидаем.Что(ВыполнитьКоманду("git status --porcelain --untracked-files=all", Корень),
		"новый файл не попал в индекс").Равно(До);
	Ожидаем.Что(ВыполнитьКоманду("git rev-parse HEAD", Корень), "HEAD не сдвинут").Равно(ГоловаДо);

КонецПроцедуры

&Тест
Процедура КлючиОтчётовOneunitСКорзинамиОтбиваются() Экспорт

	Для Каждого Ключи Из СтрРазделить("--junit /tmp/отчёт.xml|--junit=отчёт.xml|--cobertura /tmp/покрытие.xml", "|") Цикл
		Исполнение = Исполнить("bash ../бег.sh bash scripts/тесты.sh склад --параллельно 2 -- " + Ключи, Корень);
		Ключ = СтрРазделить(СтрРазделить(Ключи, " ")[0], "=")[0];
		Ожидаем.Что(Исполнение.Код, "отказ ключом: " + Ключи).Равно(2);
		Ожидаем.Что(Исполнение.Ошибки, "причина отказа: " + Ключи)
			.Содержит("отчёты oneunit не поддерживаются: уберите " + Ключ + " или гоняйте в один поток");
		Ожидаем.Что(Исполнение.Вывод, "до oneunit не дошло: " + Ключи).Не_().Содержит("набор:");
	КонецЦикла;

	Прогон = Прогон("scripts/тесты.sh склад -- --junit /tmp/отчёт.xml");
	Ожидаем.Что(Прогон.Код, "в один поток отчёт принимается").Равно(0);

КонецПроцедуры

&Тест
Процедура ПрерванныйПрогонГаситКорзиныИСнимаетВоркспейсы() Экспорт

	ЗаписатьФайл(Корень, "tests/склад/Разовый_Тесты.os", "// долго" + Символы.ПС);
	Pids = ОбъединитьПути(Стенд, "pids");
	УдалитьФайлы(Pids);
	До = Воркспейсы();

	Исполнение = ИсполнитьИПрервать("bash ../бег.sh bash scripts/тесты.sh склад --параллельно 2", Корень);

	Ожидаем.Что(Исполнение.Код, "код сигнала TERM").Равно(143);
	Ожидаем.Что(Воркспейсы(), "воркспейсы корзин сняты").Равно(До);
	Ожидаем.Что(Новый Файл(Pids).Существует(), "долгий набор успел начаться").ЭтоИстина();
	Для Каждого Pid Из СтрРазделить(СокрЛП(ПрочитатьФайл(Pids)), " " + Символы.ПС, Ложь) Цикл
		Ожидаем.Что(Исполнить("kill -0 " + Pid, Стенд).Код, "процесс корзины погашен: " + Pid).Не_().Равно(0);
	КонецЦикла;
	// долгий набор — в корзине 2, корзина 1 успевает закончить: её хвоста как прерванной нет
	Ожидаем.Что(Исполнение.Вывод, "дождавшаяся корзина").Содержит("== корзина 1/2: код 0");
	Ожидаем.Что(Исполнение.Вывод, "хвост прерванной корзины").Содержит("== корзина 2/2: прервана, последние 30 строк журнала");
	Ожидаем.Что(СтрЧислоВхождений(Исполнение.Вывод, "прервана"), "хвосты — только прерванных корзин").Равно(1);
	Ожидаем.Что(Исполнение.Вывод, "в хвосте — строки корзины").Содержит("│ набор: tests/склад/Разовый_Тесты.os");
	Ожидаем.Что(СтрНачинаетсяС(Итог(Новый Структура("Строки", СтрРазделить(Исполнение.Вывод, Символы.ПС, Ложь))),
		"код 143,"), "итог последней строкой").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Сводка

&Тест
Процедура СводкаСкладываетСтатистикуКорзин() Экспорт

	Прогон = Прогон("scripts/тесты.sh склад --сквозные --параллельно 3");

	Ожидаем.Что(Статистика(Прогон, "Наборов обнаружено"), "наборы всех корзин со сквозным").Равно(7);
	Ожидаем.Что(Статистика(Прогон, "Наборов ошибочных")).Равно(0);
	Ожидаем.Что(Статистика(Прогон, "Тестов обнаружено"), "1+…+6 и 10 сквозных").Равно(31);
	Ожидаем.Что(Статистика(Прогон, "Тестов успешных")).Равно(31);
	Ожидаем.Что(Статистика(Прогон, "Тестов ошибочных")).Равно(0);
	Ожидаем.Что(Статистика(Прогон, "Тестов пропущено")).Равно(0);
	Ожидаем.Что(Предпоследняя(Прогон), "вердикт сводки").Равно("Тестирование завершилось удачно");

КонецПроцедуры

&Тест
Процедура ОднаКраснаяКорзинаКраснитПрогон() Экспорт

	ЗаписатьФайл(Корень, "tests/склад/Разовый_Тесты.os", "// тестов 4 ошибок 1" + Символы.ПС);
	Зафиксировать();

	Прогон = Прогон("scripts/тесты.sh склад --параллельно 3");

	Ожидаем.Что(Статистика(Прогон, "Наборов ошибочных")).Равно(1);
	Ожидаем.Что(Статистика(Прогон, "Тестов обнаружено"), "1+…+6 и 4 разового").Равно(25);
	Ожидаем.Что(Статистика(Прогон, "Тестов ошибочных")).Равно(1);
	Ожидаем.Что(Предпоследняя(Прогон), "вердикт сводки").Равно("Тестирование завершилось неудачно");
	Ожидаем.Что(Прогон.Строки.Найти("Тестирование завершилось удачно"),
		"«удачно» зелёных корзин не выдаётся за вердикт").Равно(Неопределено);
	Ожидаем.Что(Прогон.Код, "код выхода скрипта").Не_().Равно(0);
	Ожидаем.Что(СтрНачинаетсяС(Итог(Прогон), "код 0,"), "итог несёт код корзины").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура КорзинаБезИтогаOneunitНеСчитаетсяУдачной() Экспорт

	ЗаписатьФайл(Корень, "tests/склад/Разовый_Тесты.os", "// молчит" + Символы.ПС);
	Зафиксировать();

	Прогон = Прогон("scripts/тесты.sh склад --параллельно 3");

	Ожидаем.Что(Прогон.Вывод, "сводка называет корзину")
		.Содержит("oneunit не написал «Тестирование завершилось удачно»");
	Ожидаем.Что(Предпоследняя(Прогон), "вердикт сводки").Равно("Тестирование завершилось неудачно");
	Ожидаем.Что(Прогон.Код, "код выхода скрипта").Не_().Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Карантин

&Тест
Процедура ПлавающиеНаборыНеИдутВОбычныйОтбор() Экспорт

	Для Каждого Ключи Из СтрРазделить("склад|склад --сквозные|склад --e2e|склад --с-потребителями|--e2e|--всё", "|") Цикл
		Наборы = Отобранные(Прогон("scripts/тесты.sh " + Ключи + " --список"));
		Ожидаем.Что(Наборы.Количество() > 0, "отбор не пуст: " + Ключи).ЭтоИстина();
		Для Каждого Набор Из Наборы Цикл
			Ожидаем.Что(Набор, "карантин вне отбора «" + Ключи + "»").Не_().Содержит("_Плавающие_");
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура КарантинГоняетсяОтдельноОднимПрогоном() Экспорт

	Прогон = Прогон("scripts/тесты.sh --плавающие");

	Ожидаем.Что(СтрСоединить(Отобранные(Прогон), ","), "только карантин")
		.Равно("tests/e2e/склад/Живой_Плавающие_Тесты.os,tests/склад/Полка_Плавающие_Тесты.os");
	Ожидаем.Что(Прогон.Вывод, "без корзин").Не_().Содержит("корзина");
	Ожидаем.Что(Статистика(Прогон, "Наборов обнаружено"), "оба набора карантина").Равно(2);

	Исполнение = Исполнить("bash ../бег.sh bash scripts/тесты.sh --плавающие --параллельно 2", Корень);
	Ожидаем.Что(Исполнение.Код, "карантин корзин не делит").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область Время

&Тест
Процедура ВремяПечатаетНаборыПоУбываниюИСводку() Экспорт

	ЗаписатьФайл(Корень, "tests/склад/Разовый_Тесты.os", "// спит" + Символы.ПС + "// тестов 1 ошибок 0" + Символы.ПС);

	Прогон = Прогон("scripts/тесты.sh склад --время");

	Ожидаем.Что(Прогон.Вывод, "каждый набор — своим oneunit").Содержит("== СВОДКА: прогонов oneunit 7");
	Таблица = СтрокиПосле(Прогон, "== Время наборов по убыванию");
	Ожидаем.Что(Таблица.Количество(), "семь наборов и «всего»").Равно(8);
	Ожидаем.Что(Таблица[0], "дольше всех — спавший набор").Содержит("tests/склад/Разовый_Тесты.os");
	// секунды целые: набор короче секунды на стыке секунд насчитает 1, спавший две — не меньше 2
	Ожидаем.Что(Число(СокрЛП(Лев(Таблица[0], 7))) >= 2, "и он спал две секунды: " + Таблица[0]).ЭтоИстина();
	Ожидаем.Что(Таблица[7], "итог по времени").Содержит("всего");
	Ожидаем.Что(Статистика(Прогон, "Наборов обнаружено")).Равно(7);
	Ожидаем.Что(Предпоследняя(Прогон), "вердикт сводки").Равно("Тестирование завершилось удачно");

	Исполнение = Исполнить("bash ../бег.sh bash scripts/тесты.sh склад --время --параллельно 2", Корень);
	Ожидаем.Что(Исполнение.Код, "время корзин не делит").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Прогон скрипта bash в корне стенда: Код, Вывод (stdout) и его Строки.
Функция Прогон(Знач Команда)

	Исполнение = Исполнить("bash ../бег.sh bash " + Команда, Корень);

	Результат = Новый Структура("Код, Вывод, Строки", Исполнение.Код, Исполнение.Вывод,
		СтрРазделить(Исполнение.Вывод, Символы.ПС, Ложь));
	Ожидаем.Что(Результат.Строки.Количество() > 5, "прогон дошёл до вывода: " + Исполнение.Вывод + Исполнение.Ошибки)
		.ЭтоИстина();

	Возврат Результат;

КонецФункции

// Набор → массив номеров корзин, в выводе которых заглушка его назвала.
Функция ПопаданияВКорзины(Знач Прогон)

	Образец = Новый РегулярноеВыражение("^корзина (\d+) │ набор: (.+)$");
	Попадания = Новый Соответствие();
	Для Каждого Строка_ Из Прогон.Строки Цикл
		Совпадения = Образец.НайтиСовпадения(Строка_);
		Если Совпадения.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Набор = Совпадения[0].Группы[2].Значение;
		Если Попадания[Набор] = Неопределено Тогда
			Попадания.Вставить(Набор, Новый Массив());
		КонецЕсли;
		Попадания[Набор].Добавить(Совпадения[0].Группы[1].Значение);
	КонецЦикла;

	Возврат Попадания;

КонецФункции

// Число из строки статистики сводки; строки корзин несут префикс и в счёт не идут.
Функция Статистика(Знач Прогон, Знач Подпись)

	Образец = Новый РегулярноеВыражение("^\[ *(\d+) " + Подпись + " *\]$");
	Найдено = Новый Массив();
	Для Каждого Строка_ Из Прогон.Строки Цикл
		Совпадения = Образец.НайтиСовпадения(Строка_);
		Если Совпадения.Количество() > 0 Тогда
			Найдено.Добавить(Число(Совпадения[0].Группы[1].Значение));
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Найдено.Количество(), "строка «" + Подпись + "» одна: " + Прогон.Вывод).Равно(1);

	Возврат Найдено[0];

КонецФункции

// Наборы из перечня «   tests/…» под заголовком прогона.
Функция Отобранные(Знач Прогон)

	Наборы = Новый Массив();
	Для Каждого Строка_ Из Прогон.Строки Цикл
		Если СтрНачинаетсяС(Строка_, "   tests/") Тогда
			Наборы.Добавить(СокрЛП(Строка_));
		КонецЕсли;
	КонецЦикла;

	Возврат Наборы;

КонецФункции

// Непустые строки после строки-заголовка до первой пустой.
Функция СтрокиПосле(Знач Прогон, Знач Заголовок)

	Строки = Новый Массив();
	Внутри = Ложь;
	Для Каждого Строка_ Из СтрРазделить(Прогон.Вывод, Символы.ПС) Цикл
		Если Внутри И ПустаяСтрока(Строка_) Тогда
			Прервать;
		ИначеЕсли Внутри Тогда
			Строки.Добавить(Строка_);
		ИначеЕсли СтрНачинаетсяС(Строка_, Заголовок) Тогда
			Внутри = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Строки;

КонецФункции

// Строка перед итогом прогона — вердикт сводки.
Функция Предпоследняя(Знач Прогон)
	Возврат Прогон.Строки[Прогон.Строки.ВГраница() - 1];
КонецФункции

// Итог — последняя строка вывода — без префикса и времени конца.
Функция Итог(Знач Прогон)

	Последняя = Прогон.Строки[Прогон.Строки.ВГраница()];
	Образец = Новый РегулярноеВыражение("^== прогон\.итог: (.*), конец \d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ$");
	Ожидаем.Что(Образец.Совпадает(Последняя), "последняя строка — итог: " + Последняя).ЭтоИстина();

	Возврат Образец.НайтиСовпадения(Последняя)[0].Группы[1].Значение;

КонецФункции

// Каталоги воркспейсов репозитория стенда строками.
Функция Воркспейсы()

	Каталоги = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(ВыполнитьКоманду("git worktree list --porcelain", Корень), Символы.ПС, Ложь) Цикл
		Если СтрНачинаетсяС(Строка_, "worktree ") Тогда
			Каталоги.Добавить(Строка_);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Каталоги, Символы.ПС);

КонецФункции

// Всё дерево стенда — коммитом: наборы следующего теста стартуют с чистого дерева.
Процедура Зафиксировать()
	ВыполнитьКоманду("git add -A", Корень);
	ВыполнитьКоманду("git -c user.name=стенд -c user.email=stand@example.invalid -c commit.gpgsign=false "
		+ "-c core.hooksPath=/dev/null commit -q --allow-empty -m стенд", Корень);
КонецПроцедуры

Функция ВыполнитьКоманду(Знач Команда, Знач Каталог)

	Исполнение = Исполнить(Команда, Каталог);
	Ожидаем.Что(Исполнение.Код, Команда + ": " + Исполнение.Вывод + Исполнение.Ошибки).Равно(0);

	Возврат Исполнение.Вывод;

КонецФункции

Функция Исполнить(Знач Команда, Знач Каталог)

	Процесс = СоздатьПроцесс(Команда, Каталог, Истина, Истина);
	Процесс.Запустить();

	Вывод = Новый Массив();
	Ошибки = Новый Массив();
	Пока НЕ Процесс.Завершен Цикл
		ДобавитьПрочитанное(Вывод, Процесс.ПотокВывода.Прочитать());
		ДобавитьПрочитанное(Ошибки, Процесс.ПотокОшибок.Прочитать());
		Приостановить(50);
	КонецЦикла;
	ДобавитьПрочитанное(Вывод, Процесс.ПотокВывода.Прочитать());
	ДобавитьПрочитанное(Ошибки, Процесс.ПотокОшибок.Прочитать());

	Возврат Новый Структура("Код, Вывод, Ошибки", Процесс.КодВозврата,
		СтрСоединить(Вывод, ""), СтрСоединить(Ошибки, ""));

КонецФункции

// Запускает команду, через две секунды шлёт ей TERM и дочитывает вывод до её конца.
Функция ИсполнитьИПрервать(Знач Команда, Знач Каталог)

	Процесс = СоздатьПроцесс(Команда, Каталог, Истина, Истина);
	Процесс.Запустить();

	Вывод = Новый Массив();
	Ошибки = Новый Массив();
	СрокСигнала = ТекущаяУниверсальнаяДатаВМиллисекундах() + 2000;
	Послан = Ложь;
	Пока НЕ Процесс.Завершен Цикл
		ДобавитьПрочитанное(Вывод, Процесс.ПотокВывода.Прочитать());
		ДобавитьПрочитанное(Ошибки, Процесс.ПотокОшибок.Прочитать());
		Если НЕ Послан И ТекущаяУниверсальнаяДатаВМиллисекундах() >= СрокСигнала Тогда
			ВыполнитьКоманду("kill -TERM " + Формат(Процесс.Идентификатор, "ЧГ="), Каталог);
			Послан = Истина;
		КонецЕсли;
		Приостановить(50);
	КонецЦикла;
	ДобавитьПрочитанное(Вывод, Процесс.ПотокВывода.Прочитать());
	ДобавитьПрочитанное(Ошибки, Процесс.ПотокОшибок.Прочитать());

	Возврат Новый Структура("Код, Вывод, Ошибки", Процесс.КодВозврата,
		СтрСоединить(Вывод, ""), СтрСоединить(Ошибки, ""));

КонецФункции

Функция ПрочитатьФайл(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Текст;
КонецФункции

// Поток процесса отдаёт данные один раз и пустым отвечает Неопределено.
Процедура ДобавитьПрочитанное(Куски, Знач Прочитанное)
	Если Прочитанное <> Неопределено Тогда
		Куски.Добавить(Строка(Прочитанное));
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьФайл(Знач Каталог, Знач Относительный, Знач Текст)

	Путь = ОбъединитьПути(Каталог, Относительный);
	СоздатьКаталог(Новый Файл(Путь).Путь);

	// байтами: запись текстом ставит переводы строк CRLF, и bash их не читает
	ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8").Записать(Путь);

КонецПроцедуры

#КонецОбласти
