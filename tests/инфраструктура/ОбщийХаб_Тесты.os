// Общий хаб группы: подключение к внешнему хабу (без своего процесса, журнал с момента подключения),
// повтор старта, разметка групп и фаз в наборах.

#Использовать asserts
#Использовать "../фикстуры"

Перем СохранённаяСреда; // Соответствие: переменная → значение до набора
Перем Стенды;           // Массив стендов /health теста: гасятся и убираются после каждого

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ЗапомнитьСреду() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");

	Стенды = Новый Массив();
	СохранённаяСреда = Новый Соответствие();
	Для Каждого Имя Из ТрогаемыеПеременные() Цикл
		СохранённаяСреда.Вставить(Имя, ПолучитьПеременнуюСреды(Имя));
	КонецЦикла;

КонецПроцедуры

&ПослеКаждого
Процедура СнятьПробнуюГруппу() Экспорт
	УбратьСтенды();
	ГруппыХабов.Снять(Проба());
	ВернутьСреду();
КонецПроцедуры

&ПослеВсех
Процедура ВернутьСредуНабора() Экспорт
	ВернутьСреду();
КонецПроцедуры

&Тест
Процедура СПеременнойЭкземплярПодключёнКВнешнемуБезПроцесса() Экспорт

	Внешний = ПоднятьОтвечающийHealth();
	Попытка
		ОбъявитьПробу();
		УстановитьПеременнуюСреды(ГруппыХабов.ПеременнаяАдреса(Проба()), Внешний.Адрес);
		УстановитьПеременнуюСреды("OSHUB_PORT", "");
		УстановитьПеременнуюСреды("OSHUB_DB_CONNECTION", "");

		Хаб = ОбщийХаб.Экземпляр(Проба());

		Ожидаем.Что(Хаб.Внешний(), "экземпляр подключён к внешнему").ЭтоИстина();
		Ожидаем.Что(Хаб.Порт(), "порт — из адреса").Равно(Внешний.Порт);
		Ожидаем.Что(Хаб.ПоследнийИдентификаторПроцесса(), "процесса не запускал").Равно(0);
		Ожидаем.Что(ПолучитьПеременнуюСреды("OSHUB_PORT"), "окружение хаба не ставил").Не_().Заполнено();
		Ожидаем.Что(ПолучитьПеременнуюСреды("OSHUB_DB_CONNECTION"), "и базы не заводил").Не_().Заполнено();
	Исключение
		Внешний.Процесс.Завершить();
		ВызватьИсключение;
	КонецПопытки;
	Внешний.Процесс.Завершить();

КонецПроцедуры

&Тест
Процедура ОстановитьВнешнийНичегоНеГасит() Экспорт

	Внешний = ПоднятьОтвечающийHealth();
	Попытка
		ОбъявитьПробу();
		УстановитьПеременнуюСреды(ГруппыХабов.ПеременнаяАдреса(Проба()), Внешний.Адрес);
		Хаб = ОбщийХаб.Экземпляр(Проба());
		Хаб.Остановить();
		Хаб.Остановить();

		Ожидаем.Что(Внешний.Процесс.Завершен, "внешний хаб жив").ЭтоЛожь();
		Ожидаем.Что(Хаб.Работает(), "и отвечает /health").ЭтоИстина();
		Ожидаем.Что(ПолучитьПеременнуюСреды(ГруппыХабов.ПеременнаяАдреса(Проба())),
			"адрес группы остался соседним наборам").Равно(Внешний.Адрес);
	Исключение
		Внешний.Процесс.Завершить();
		ВызватьИсключение;
	КонецПопытки;
	Внешний.Процесс.Завершить();

КонецПроцедуры

&Тест
Процедура МолчащийОбщийХабОтказываетСИменемГруппыИАдресом() Экспорт

	ОбъявитьПробу();
	Адрес = "http://127.0.0.1:" + Формат(СвободныйПорт(), "ЧГ=0; ЧН=0");
	УстановитьПеременнуюСреды(ГруппыХабов.ПеременнаяАдреса(Проба()), Адрес);

	Отказ = Отказ(ОбщийХаб, "Экземпляр", Проба());

	Ожидаем.Что(Отказ, "группа названа").Содержит("«" + Проба() + "»");
	Ожидаем.Что(Отказ, "адрес назван").Содержит(Адрес);
	Ожидаем.Что(Отказ, "и что не так").Содержит("не отвечает");

КонецПроцедуры

&Тест
Процедура ВнешнийОтказываетМетодамОкруженияБазыИЗапуска() Экспорт

	Хаб = Новый ЭкземплярХаба(2);
	Хаб.ПодключитьсяКВнешнему("http://127.0.0.1:20997", "", "общий хаб группы «проба» (OSHUB_TEST_HUB_PROBE)");

	Вызовы = Новый Соответствие();
	Вызовы.Вставить("Среда", Массив("OSHUB_SHARED_HUB_PROBE_FLAG", "1"));
	Вызовы.Вставить("ВыключитьДоставкуВебхуков", Массив());
	Вызовы.Вставить("ВыключитьФон", Массив());
	Вызовы.Вставить("ФайловаяБаза", Массив("openhub-проба"));
	Вызовы.Вставить("ЗапуститьСидер", Массив("ЗасеятьХаб.os"));
	Вызовы.Вставить("Запустить", Массив());
	Вызовы.Вставить("ЗапуститьБезОжидания", Массив());
	Вызовы.Вставить("Поднять", Массив("openhub-проба"));

	Для Каждого Вызов Из Вызовы Цикл
		Отказ = Отказ(Хаб, Вызов.Ключ, Вызов.Значение);
		Ожидаем.Что(Отказ, Вызов.Ключ + ": отказ называет группу и переменную")
			.Содержит("общий хаб группы «проба» (OSHUB_TEST_HUB_PROBE)");
		Ожидаем.Что(Отказ, Вызов.Ключ + ": и сам метод").Содержит(Вызов.Ключ + "(");
	КонецЦикла;

	Ожидаем.Что(ПолучитьПеременнуюСреды("OSHUB_SHARED_HUB_PROBE_FLAG"), "среда процесса не тронута")
		.Не_().Заполнено();
	Ожидаем.Что(Хаб.Порт(), "порт внешнего").Равно(20997);
	Ожидаем.Что(Хаб.ПоследнийИдентификаторПроцесса(), "процесса не запускал").Равно(0);

КонецПроцедуры

// Параметр «Сидер» метода Поднять(): строка — один сидер, пусто — ни одного, массив любого вида —
// новый массив в том же порядке без пустых строк.
&Тест
Процедура СписокСидеровНормализуетПараметрПодъёма() Экспорт

	Хаб = Новый ЭкземплярХаба(2);

	Ожидаем.Что(СтрСоединить(Хаб.СписокСидеров("ЗасеятьХаб.os"), ","), "строка — один сидер")
		.Равно("ЗасеятьХаб.os");
	Ожидаем.Что(Хаб.СписокСидеров("").Количество(), "пустая строка — без засева").Равно(0);
	Ожидаем.Что(Хаб.СписокСидеров(Неопределено).Количество(), "Неопределено — без засева").Равно(0);

	Исходный = Массив("ЗасеятьКабинет.os", "", "ЗасеятьСводкуКабинета.os");
	Сидеры = Хаб.СписокСидеров(Исходный);
	Ожидаем.Что(СтрСоединить(Сидеры, ","), "массив — по порядку без пустых")
		.Равно("ЗасеятьКабинет.os,ЗасеятьСводкуКабинета.os");
	Сидеры.Добавить("ЗасеятьПакет.os");
	Ожидаем.Что(Исходный.Количество(), "массив вызывающего не тронут").Равно(3);

	Сидеры = Хаб.СписокСидеров(Новый ФиксированныйМассив(Массив("ЗасеятьСводкуКабинета.os", "ЗасеятьКабинет.os")));
	Ожидаем.Что(ТипЗнч(Сидеры), "фиксированный массив — обычным").Равно(Тип("Массив"));
	Ожидаем.Что(СтрСоединить(Сидеры, ","), "порядок фиксированного массива сохранён")
		.Равно("ЗасеятьСводкуКабинета.os,ЗасеятьКабинет.os");

КонецПроцедуры

&Тест
Процедура АдресВнешнегоРазбираетсяСПроверкойХостаИПорта() Экспорт

	Источник = "общий хаб группы «проба» (OSHUB_TEST_HUB_PROBE)";
	Отказы = Новый Соответствие();
	Отказы.Вставить("http://10.0.0.5:8080", "не локальный");
	Отказы.Вставить("http://127.0.0.1:", "порт");
	Отказы.Вставить("http://127.0.0.1:восемь", "порт");
	Отказы.Вставить("127.0.0.1", "не похож");

	Для Каждого Случай Из Отказы Цикл
		Отказ = Отказ(Новый ЭкземплярХаба(2), "ПодключитьсяКВнешнему", Массив(Случай.Ключ, "", Источник));
		Ожидаем.Что(Отказ, Случай.Ключ + ": источник назван").Содержит(Источник);
		Ожидаем.Что(Отказ, Случай.Ключ + ": значение названо").Содержит("«" + Случай.Ключ + "»");
		Ожидаем.Что(Отказ, Случай.Ключ + ": и что не так").Содержит(Случай.Значение);
	КонецЦикла;

	Хаб = Новый ЭкземплярХаба(2);
	Хаб.ПодключитьсяКВнешнему("http://localhost:20996/", "", Источник);
	Ожидаем.Что(Хаб.Порт(), "localhost с косой чертой").Равно(20996);

КонецПроцедуры

&Тест
Процедура ОнбордингВнешнегоЖдётHealthНеДольшеТаймаута() Экспорт

	Хаб = Новый ЭкземплярХаба(90);
	Хаб.ПодключитьсяКВнешнему("http://127.0.0.1:" + Формат(СвободныйПорт(), "ЧГ=0; ЧН=0"));

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Отказ = Отказ(Хаб, "ДождатьсяОнбординга", Массив(2));

	Ожидаем.Что(Отказ, "молчащий внешний хаб — отказ по /health").Содержит("/health");
	Ожидаем.Что(ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало < 15000,
		"ждал таймаут онбординга, а не таймаут экземпляра").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СтрокаЖурналаВнешнегоБезЖурналаОтказываетСразу() Экспорт

	Хаб = Новый ЭкземплярХаба(2);
	Хаб.ПодключитьсяКВнешнему("http://127.0.0.1:20995", "", "общий хаб группы «проба» (OSHUB_TEST_HUB_PROBE)");

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Отказ = Отказ(Хаб, "ДождатьсяСтрокиЖурнала", Массив("Стартовые задачи завершены", 30));

	Ожидаем.Что(Отказ, "отказ называет хаб").Содержит("OSHUB_TEST_HUB_PROBE");
	Ожидаем.Что(Отказ, "и причину").Содержит("журнала у экземпляра нет");
	Ожидаем.Что(ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало < 5000, "не ждал таймаут").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЖурналВнешнегоЧитаетсяСМоментаПодключенияПоЦелымСтрокам() Экспорт

	Каталог = УникальныеИмена.ВременныйКаталог("oshub-журнал-внешнего");
	Попытка
		Журнал = ОбъединитьПути(Каталог, "хаб.журнал");
		Дописать(Журнал, "строка инструмента: Стартовые задачи завершены" + Символы.ПС);

		Хаб = Новый ЭкземплярХаба(2);
		Хаб.ПодключитьсяКВнешнему("http://127.0.0.1:20998", Журнал);
		Отказ = Отказ(Хаб, "ДождатьсяСтрокиЖурнала", Массив("Стартовые задачи завершены", 1));
		Ожидаем.Что(Отказ, "строка до подключения не засчитана").Содержит("не появилось");
		Ожидаем.Что(Хаб.Дамп(), "пометка журнала").Содержит("журнал общего хаба с момента подключения");
		Ожидаем.Что(СтрНайти(Хаб.Дамп(), "строка инструмента"), "строк до подключения в журнале набора нет").Равно(0);

		Дописать(Журнал, "Стартовые задачи завершены" + Символы.ПС + "вторая строка" + Символы.ПС + "недопис");
		Хаб.ДождатьсяСтрокиЖурнала("вторая строка", 2);
		Дамп = Хаб.Дамп();
		Ожидаем.Что(СтрЧислоВхождений(Дамп, "Стартовые задачи завершены"), "прочитанное не перечитывается")
			.Равно(1);
		Ожидаем.Что(СтрНайти(Дамп, "недопис"), "недописанная строка ждёт перевода строки").Равно(0);

		Дописать(Журнал, "ано" + Символы.ПС);
		Ожидаем.Что(Хаб.Дамп(), "дописанная строка — целиком").Содержит("недописано");
	Исключение
		УникальныеИмена.УбратьВременное(Каталог);
		ВызватьИсключение;
	КонецПопытки;

	УникальныеИмена.УбратьВременное(Каталог);

КонецПроцедуры

&Тест
Процедура ДампЖурналаВФайлеОтдаётХвостСоСчётомСтрок() Экспорт

	Каталог = УникальныеИмена.ВременныйКаталог("oshub-журнал-внешнего");
	Попытка
		Журнал = ОбъединитьПути(Каталог, "хаб.журнал");
		Дописать(Журнал, "до подключения" + Символы.ПС);
		Хаб = Новый ЭкземплярХаба(2);
		Хаб.ПодключитьсяКВнешнему("http://127.0.0.1:20998", Журнал);

		Строки = Новый Массив();
		Для Номер = 1 По 250 Цикл
			Строки.Добавить("строка " + Формат(Номер, "ЧГ=0"));
		КонецЦикла;
		Дописать(Журнал, СтрСоединить(Строки, Символы.ПС) + Символы.ПС);
		Дамп = Хаб.Дамп();

		Ожидаем.Что(Дамп, "пометка хвоста").Содержит("последние 200 из 250 строк");
		Ожидаем.Что(Дамп, "последняя строка").Содержит("строка 250");
		Ожидаем.Что(СтрНайти(Дамп, Символы.ПС + "строка 51" + Символы.ПС) > 0, "первая строка хвоста").ЭтоИстина();
		Ожидаем.Что(СтрНайти(Дамп, "строка 50" + Символы.ПС), "голова журнала отрезана").Равно(0);
	Исключение
		УникальныеИмена.УбратьВременное(Каталог);
		ВызватьИсключение;
	КонецПопытки;

	УникальныеИмена.УбратьВременное(Каталог);

КонецПроцедуры

&Тест
Процедура ПовторСтартаНеЧитаетЖурналМёртвойПопытки() Экспорт

	// первая попытка пишет маркер старта и умирает, как хаб с перехваченным портом; вторая молчит
	Проект = УникальныеИмена.ВременныйКаталог("oshub-проект-повтора");
	Хаб = Новый ЭкземплярХаба(3, Проект);
	Попытка
		Дописать(Хаб.ТочкаВхода(), СтрШаблон(
			"Флаг = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, ""первая.попытка"");
			|Если Новый Файл(Флаг).Существует() Тогда
			|	Сообщить(""попытка 2 молчит"");
			|	Приостановить(60000);
			|Иначе
			|	Запись = Новый ЗаписьТекста(Флаг);
			|	Запись.Закрыть();
			|	Сообщить(""попытка 1: %1"");
			|КонецЕсли;
			|", Хаб.МаркерЗавершенияСтарта()));
		Хаб.ВестиЖурналВФайле();

		Отказ = Отказ(Хаб, "Запустить", Новый Массив());
		Хаб.Остановить();

		Ожидаем.Что(Отказ, "повтор был").Содержит("попытка 2 из");
		Ожидаем.Что(Отказ, "маркер мёртвой попытки не засчитан повтору").Содержит("не появилось");
		Ожидаем.Что(Отказ, "журнал повтора — его строки").Содержит("попытка 2 молчит");
		Ожидаем.Что(СтрНайти(Отказ, "попытка 1:"), "строк мёртвой попытки в журнале повтора нет").Равно(0);
	Исключение
		Хаб.Остановить();
		УникальныеИмена.УбратьВременное(Проект);
		ВызватьИсключение;
	КонецПопытки;

	УникальныеИмена.УбратьВременное(Проект);

КонецПроцедуры

&Тест
Процедура ПодключениеКВнешнемуОтказываетПоднявшемуСвойХаб() Экспорт

	Проект = УникальныеИмена.ВременныйКаталог("oshub-проект-внешнего");
	Хаб = Новый ЭкземплярХаба(10, Проект);
	Попытка
		Дописать(Хаб.ТочкаВхода(), "Приостановить(60000);" + Символы.ПС);
		Хаб.ЗапуститьБезОжидания();
		PID = Хаб.ИдентификаторПроцесса();
		Отказ = Отказ(Хаб, "ПодключитьсяКВнешнему", Массив("http://127.0.0.1:20998"));
		Ожидаем.Что(Отказ, "свой процесс").Содержит("уже поднял свой хаб");
		Ожидаем.Что(Хаб.Внешний(), "и не подключён").ЭтоЛожь();
		Хаб.Остановить();
		Ожидаем.Что(PID, "процесс был").Не_().Равно(0);
		Ожидаем.Что(Хаб.ИдентификаторПроцесса(), "свой процесс погашен своим Остановить()").Равно(0);

		Хаб.ФайловаяБаза("oshub-проба-внешнего");
		Корень = Новый Файл(Хаб.КаталогБазы()).Путь;
		Отказ = Отказ(Хаб, "ПодключитьсяКВнешнему", Массив("http://127.0.0.1:20998"));
		Ожидаем.Что(Отказ, "свой каталог").Содержит("уже поднял свой хаб");
		Хаб.Остановить();
		Ожидаем.Что(Новый Файл(Корень).Существует(), "каталог убран своим Остановить()").ЭтоЛожь();
	Исключение
		Хаб.Остановить();
		УникальныеИмена.УбратьВременное(Проект);
		ВызватьИсключение;
	КонецПопытки;

	УникальныеИмена.УбратьВременное(Проект);

КонецПроцедуры

&Тест
Процедура ОбщийХабПоднимающийсяНеСразуДожидаются() Экспорт

	Внешний = ПоднятьОтвечающийHealth(3);
	ОбъявитьПробу();
	УстановитьПеременнуюСреды(ГруппыХабов.ПеременнаяАдреса(Проба()), Внешний.Адрес);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Хаб = ОбщийХаб.Экземпляр(Проба());

	Ожидаем.Что(Хаб.Работает(), "дождались /health").ЭтоИстина();
	Ожидаем.Что(ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало, "ждали, а не отказали первой пробой")
		.Больше(1500);

КонецПроцедуры

&Тест
Процедура ОстановкаХабаСЖурналомВФайлеЧиститКаталогИОставляетВывод() Экспорт

	// «проект», чья точка входа пишет строку и ждёт: ЭкземплярХаба поднимает её как хаб
	Проект = УникальныеИмена.ВременныйКаталог("oshub-проект-журнала");
	Попытка
		Хаб = Новый ЭкземплярХаба(10, Проект);
		Дописать(Хаб.ТочкаВхода(),
			"Сообщить(""строка старта пробы"");" + Символы.ПС + "Приостановить(60000);" + Символы.ПС);
		Хаб.ВестиЖурналВФайле();
		Хаб.ЗапуститьБезОжидания();
		Хаб.ДождатьсяСтрокиЖурнала("строка старта пробы", 20);
		Журнал = Хаб.ФайлЖурнала();
		Хаб.Остановить();

		Ожидаем.Что(Новый Файл(Новый Файл(Журнал).Путь).Существует(), "каталог журнала удалён").ЭтоЛожь();
		Ожидаем.Что(Хаб.Дамп(), "вывод остался после остановки").Содержит("строка старта пробы");
	Исключение
		УникальныеИмена.УбратьВременное(Проект);
		ВызватьИсключение;
	КонецПопытки;

	УникальныеИмена.УбратьВременное(Проект);

КонецПроцедуры

&Тест
Процедура КаждаяГруппаСПрефиксомИЛатинскимИдентификатором() Экспорт

	Латиница = Новый РегулярноеВыражение("^[A-Z][A-Z0-9_]*$");

	Для Каждого Описание Из ГруппыХабов.Все() Цикл
		Ожидаем.Что(Описание.Имя, "имя группы").Заполнено();
		Ожидаем.Что(Описание.Префикс, "префикс группы " + Описание.Имя).Заполнено();
		Ожидаем.Что(Латиница.Совпадает(Описание.Идентификатор),
			"идентификатор группы " + Описание.Имя + " годится в имя переменной: " + Описание.Идентификатор)
			.ЭтоИстина();
		Ожидаем.Что(СтрНайти(Описание.Имя, " ") + СтрНайти(Описание.Имя, """"),
			"имя группы " + Описание.Имя + " годится в тег").Равно(0);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ИменаИИдентификаторыГруппНеПовторяются() Экспорт

	Имена = Новый Соответствие();
	Идентификаторы = Новый Соответствие();

	Для Каждого Описание Из ГруппыХабов.Все() Цикл
		Ожидаем.Что(Имена[Описание.Имя], "имя группы повторено: " + Описание.Имя).Равно(Неопределено);
		Ожидаем.Что(Идентификаторы[Описание.Идентификатор],
			"идентификатор повторён: " + Описание.Идентификатор).Равно(Неопределено);
		Имена.Вставить(Описание.Имя, Истина);
		Идентификаторы.Вставить(Описание.Идентификатор, Истина);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТегиНаборовНазываютОбъявленныеГруппы() Экспорт

	Для Каждого Набор Из НаборыГрупп() Цикл
