КонецПроцедуры

// oneunit гоняет наборы одного процесса по &Порядок набора и имени, а не по порядку файлов: фазу
// общего хаба держит &Порядок — чтение 1, создание 2, удаление 3.
&Тест
Процедура ПорядокНабораГруппыСовпадаетСФазой() Экспорт

	Наборы = НаборыГрупп();
	Ожидаем.Что(Наборы.Количество() > 0, "наборы групп найдены").ЭтоИстина();

	Для Каждого Набор Из Наборы Цикл
		Ожидаем.Что(РангФазы(Набор.Фаза), Набор.Имя + ": фаза «" + Набор.Фаза + "» — чтение, создание или удаление")
			.Заполнено();
		Ожидаем.Что(Набор.Порядки.Количество(), Набор.Имя + ": у набора группы один &Порядок").Равно(1);
		Ожидаем.Что(Набор.Порядки[0], Набор.Имя + ": &Порядок набора — фаза «" + Набор.Фаза + "»")
			.Равно(РангФазы(Набор.Фаза));
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТегиГруппыИФазыТолькоВБлокеАннотацийНабора() Экспорт

	Нарушения = Новый Массив();
	Для Каждого Файл Из НайтиФайлы(ОбъединитьПути(КаталогиПроекта.Корень(), "tests"), "*_Тесты.os", Истина) Цикл
		Текст = ТекстФайла(Файл.ПолноеИмя);
		Для Каждого Нарушение Из НарушенияТеговГруппы(Текст) Цикл
			Нарушения.Добавить(Файл.Имя + ", " + Нарушение);
		КонецЦикла;
		ПоСкрипту = ГруппаПоСкрипту(Текст);
		ПоСторожу = АннотацииНабора(Текст).Группа;
		Если ПоСкрипту <> ПоСторожу Тогда
			Нарушения.Добавить(СтрШаблон("%1: скрипт видит группу «%2», сторож — «%3»", Файл.Имя, ПоСкрипту, ПоСторожу));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушения, Символы.ПС), "теги групп и фаз — только над ПриСозданииОбъекта").Равно("");

КонецПроцедуры

&Тест
Процедура ТегГруппыСОтступомИУМетодаТестаЗамечен() Экспорт

	Текст = "&Тег(""хаб:витрина"")
	|&Тег(""фаза:чтение"")
	|// &Тег(""хаб:кабинет"") — в комментарии не в счёт
	|Процедура ПриСозданииОбъекта() Экспорт
	|	&Тег(""хаб:кабинет"")
	|КонецПроцедуры
	|
	|Текст = ""&Тег(""""хаб:литерал"""")"";
	|
	|&Тест
	|&Тег(""фаза:удаление"")
	|Процедура Тест() Экспорт
	|КонецПроцедуры
	|";

	Нарушения = НарушенияТеговГруппы(Текст);

	Ожидаем.Что(СтрСоединить(Нарушения, Символы.ПС), "отступ и тег у метода теста; комментарий и литерал — нет")
		.Равно("строка 5: тег не с начала строки" + Символы.ПС
			+ "строка 11: тег вне блока аннотаций над ПриСозданииОбъекта");
	Ожидаем.Что(ГруппаПоСкрипту(Текст), "скрипт берёт первую строку тега").Равно("витрина");
	Ожидаем.Что(АннотацииНабора(Текст).Группа, "сторож — блок над конструктором").Равно("витрина");

КонецПроцедуры

&Тест
Процедура РазборАннотацийНабораНеЗависитОтРаскладки() Экспорт

	Текст = "#Использовать asserts
	|
	|// &Порядок(3) — в комментарии не в счёт
	|&Тег(""хаб"")
	|&Тег(""хаб:витрина"")
	|
	|&Тег(""фаза:удаление"")   // хвостовой комментарий
	|&Порядок(3)
	|
	|// пустая строка и комментарий между аннотациями и конструктором
	|&ТестовыйНабор
	|Процедура ПриСозданииОбъекта() Экспорт
	|КонецПроцедуры
	|
	|&Тест
	|&Порядок(1)
	|Процедура Тест() Экспорт
	|КонецПроцедуры
	|";

	Набор = АннотацииНабора(Текст);

	Ожидаем.Что(Набор.Группа, "группа").Равно("витрина");
	Ожидаем.Что(Набор.Фаза, "фаза").Равно("удаление");
	Ожидаем.Что(СтрСоединить(Набор.Порядки, ","), "только &Порядок набора, без комментария и тестов").Равно("3");

	БезФазы = АннотацииНабора("&Тег(""хаб:кабинет"")
	|Процедура ПриСозданииОбъекта() Экспорт
	|КонецПроцедуры");
	Ожидаем.Что(БезФазы.Фаза, "без тега фазы — создание").Равно("создание");
	Ожидаем.Что(БезФазы.Порядки.Количество(), "&Порядок не объявлен").Равно(0);

КонецПроцедуры

#Область Служебное

Функция Проба()
	Возврат "проба-общего-хаба";
КонецФункции

Процедура ОбъявитьПробу()
	ГруппыХабов.ОбъявитьНаВремя(Проба(), "SHARED_HUB_PROBE", "openhub-проба-общего-хаба");
КонецПроцедуры

Функция ТрогаемыеПеременные()
	Возврат СтрРазделить("OSHUB_PORT,OSHUB_DB_CONNECTION,OSHUB_STORAGE_ROOT,OSHUB_TEST_RUN,"
		+ "OSHUB_UPSTREAM_PROBE_ENABLED,OSHUB_README_REPOSITORY_ENABLED,OSHUB_SHARED_HUB_PROBE_FLAG,"
		+ "OSHUB_TEST_HUB_SHARED_HUB_PROBE,OSHUB_TEST_HUB_SHARED_HUB_PROBE_LOG", ",");
КонецФункции

Процедура ВернутьСреду()
	Для Каждого Сохранённая Из СохранённаяСреда Цикл
		УстановитьПеременнуюСреды(Сохранённая.Ключ, ?(Сохранённая.Значение = Неопределено, "", Сохранённая.Значение));
	КонецЦикла;
КонецПроцедуры

// Наборы дерева с тегом группы: имя файла, группа, фаза и &Порядок из аннотаций над ПриСозданииОбъекта.
Функция НаборыГрупп()

	Наборы = Новый Массив();
	Для Каждого Файл Из НайтиФайлы(ОбъединитьПути(КаталогиПроекта.Корень(), "tests"), "*_Тесты.os", Истина) Цикл
		Набор = АннотацииНабора(ТекстФайла(Файл.ПолноеИмя));
		Если ЗначениеЗаполнено(Набор.Группа) Тогда
			Набор.Вставить("Имя", Файл.Имя);
			Наборы.Добавить(Набор);
		КонецЕсли;
	КонецЦикла;

	Возврат Наборы;

КонецФункции

// Блок аннотаций над «Процедура ПриСозданииОбъекта» без комментариев: пустые строки и комментарии
// между аннотациями не рвут блок.
Функция АннотацииНабора(Знач Текст)

	Набор = Новый Структура("Группа, Фаза, Порядки", "", "создание", Новый Массив());
	Строки = СтрРазделить(ИсходникБезКомментариев.БезКомментариев(Текст), Символы.ПС, Истина);

	Тег = Новый РегулярноеВыражение("^&Тег\(""(хаб|фаза):([^""]+)""\)$");
	Порядок = Новый РегулярноеВыражение("^&Порядок\((\d+)\)$");
	Для Каждого Номер Из БлокАннотацийНабора(Строки) Цикл
		Строка_ = СокрЛП(Строки[Номер]);
		Теги = Тег.НайтиСовпадения(Строка_);
		Если Теги.Количество() > 0 Тогда
			Набор.Вставить(?(Теги[0].Группы[1].Значение = "хаб", "Группа", "Фаза"), Теги[0].Группы[2].Значение);
		КонецЕсли;
		Порядки = Порядок.НайтиСовпадения(Строка_);
		Если Порядки.Количество() > 0 Тогда
			Набор.Порядки.Добавить(Порядки[0].Группы[1].Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Набор;

КонецФункции

// Номера строк аннотаций над конструктором набора — снизу вверх, до первой строки не-аннотации.
Функция БлокАннотацийНабора(Знач Строки)

	Блок = Новый Массив();
	Конструктор = -1;
	Для Номер = 0 По Строки.ВГраница() Цикл
		Если СтрНачинаетсяС(СокрЛП(Строки[Номер]), "Процедура ПриСозданииОбъекта") Тогда
			Конструктор = Номер;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Номер = Конструктор - 1;
	Пока Номер >= 0 Цикл
		Строка_ = СокрЛП(Строки[Номер]);
		Если Строка_ <> "" Тогда
			Если НЕ СтрНачинаетсяС(Строка_, "&") Тогда
				Прервать;
			КонецЕсли;
			Блок.Добавить(Номер);
		КонецЕсли;
		Номер = Номер - 1;
	КонецЦикла;

	Возврат Блок;

КонецФункции

// Теги «хаб:» и «фаза:», которые скрипт (строка с начала, во всём файле) и сторож (блок над
// конструктором) прочли бы по-разному: с отступом или вне блока аннотаций набора.
Функция НарушенияТеговГруппы(Знач Текст)

	Нарушения = Новый Массив();
	Строки = СтрРазделить(ИсходникБезКомментариев.БезКомментариев(Текст), Символы.ПС, Истина);
	Блок = БлокАннотацийНабора(Строки);
	Для Номер = 0 По Строки.ВГраница() Цикл
		Позиция = Макс(СтрНайти(Строки[Номер], "&Тег(""хаб:"), СтрНайти(Строки[Номер], "&Тег(""фаза:"));
		Если Позиция = 0 Тогда
			Продолжить;
		ИначеЕсли Позиция > 1 Тогда
			Нарушения.Добавить(СтрШаблон("строка %1: тег не с начала строки", Номер + 1));
		ИначеЕсли Блок.Найти(Номер) = Неопределено Тогда
			Нарушения.Добавить(СтрШаблон("строка %1: тег вне блока аннотаций над ПриСозданииОбъекта", Номер + 1));
		КонецЕсли;
	КонецЦикла;

	Возврат Нарушения;

КонецФункции

// Группа набора так, как её видит scripts/тесты.sh: первая строка «&Тег("хаб:<группа>")» с начала строки.
Функция ГруппаПоСкрипту(Знач Текст)

	Разбор = Новый РегулярноеВыражение("(?m)^&Тег\(""хаб:([^""]+)""\)");
	Совпадения = Разбор.НайтиСовпадения(Текст);
	Возврат ?(Совпадения.Количество() = 0, "", Совпадения[0].Группы[1].Значение);

КонецФункции

Функция РангФазы(Знач Фаза)
	Ранги = Новый Соответствие();
	Ранги.Вставить("чтение", "1");
	Ранги.Вставить("создание", "2");
	Ранги.Вставить("удаление", "3");
	Возврат Ранги[Фаза];
КонецФункции

// Текст исключения вызова метода; не упал — пусто.
Функция Отказ(Знач Объект, Знач Метод, Знач Параметры)
	Если ТипЗнч(Параметры) <> Тип("Массив") Тогда
		Параметры = Массив(Параметры);
	КонецЕсли;
	Рефлектор = Новый Рефлектор();
	Попытка
		Рефлектор.ВызватьМетод(Объект, Метод, Параметры);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";
КонецФункции

Функция Массив(Знач П1 = Неопределено, Знач П2 = Неопределено, Знач П3 = Неопределено)
	Результат = Новый Массив();
	Если П1 <> Неопределено Тогда Результат.Добавить(П1); КонецЕсли;
	Если П2 <> Неопределено Тогда Результат.Добавить(П2); КонецЕсли;
	Если П3 <> Неопределено Тогда Результат.Добавить(П3); КонецЕсли;
	Возврат Результат;
КонецФункции

// Внешний «хаб»: python3 http.server в каталоге с файлом health — /health отвечает 200. С задержкой
// стенд встаёт через столько секунд, ответа функция не ждёт. Гасится и убирается после каждого теста.
Функция ПоднятьОтвечающийHealth(Знач ЗадержкаСек = 0)

	Каталог = УникальныеИмена.ВременныйКаталог("oshub-внешний-health");
	Дописать(ОбъединитьПути(Каталог, "health"), "ok");
	Порт = СвободныйПорт();
	Процесс = СоздатьПроцесс(СтрШаблон("/bin/sh -c ""sleep %1; exec python3 -m http.server %2 --bind 127.0.0.1""",
		Формат(ЗадержкаСек, "ЧГ=0; ЧН=0"), Формат(Порт, "ЧГ=0; ЧН=0")), Каталог, Истина);
	Процесс.Запустить();

	Внешний = Новый Структура("Процесс, Порт, Адрес, Каталог", Процесс, Порт,
		"http://127.0.0.1:" + Формат(Порт, "ЧГ=0; ЧН=0"), Каталог);
	Стенды.Добавить(Внешний);
	Если ЗадержкаСек > 0 Тогда
		Возврат Внешний;
	КонецЕсли;

	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 15000;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Попытка
			Если Новый HTTPСоединение("127.0.0.1", Порт, , , , 2).Получить(Новый HTTPЗапрос("/health")).КодСостояния = 200 Тогда
				Возврат Внешний;
			КонецЕсли;
		Исключение
		КонецПопытки;
		Приостановить(100);
	КонецЦикла;

	ВызватьИсключение "Стенд внешнего хаба (python3 http.server) не ответил /health за 15 с";

КонецФункции

Процедура УбратьСтенды()

	Для Каждого Стенд Из Стенды Цикл
		Попытка
			Если НЕ Стенд.Процесс.Завершен Тогда
				Стенд.Процесс.Завершить();
			КонецЕсли;
		Исключение
		КонецПопытки;
		УникальныеИмена.УбратьВременное(Стенд.Каталог);
	КонецЦикла;
	Стенды.Очистить();

КонецПроцедуры

Процедура Дописать(Знач Путь, Знач Текст)
	СоздатьКаталог(Новый Файл(Путь).Путь);
	// файл переписывается целиком байтами: прежние байты на месте, новые — в хвосте
	Прежний = ?(Новый Файл(Путь).Существует(), ТекстФайла(Путь), "");
	ПолучитьДвоичныеДанныеИзСтроки(Прежний + Текст, "UTF-8").Записать(Путь);
КонецПроцедуры

Функция ТекстФайла(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);
КонецФункции

Функция СвободныйПорт()

	РеестрФикстур.Подключить("ВыдачаПортов");
	Выдача = Новый ВыдачаПортов();
	Порт = Выдача.Выдать();
	Выдача.Вернуть(Порт);

	Возврат Порт;

КонецФункции

#КонецОбласти
