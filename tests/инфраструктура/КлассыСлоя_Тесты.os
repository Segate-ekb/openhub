// Самотесты детекторов фикстуры КлассыСлоя: таблица и реализация контракта узнаются по коду,
// а не по литералу или комментарию.

#Использовать asserts
#Использовать "../фикстуры"

Перем ПоискКлассов;  // КлассыСлоя

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

КонецПроцедуры

// Таблица узнаётся по аннотации в коде, а не по слову в литерале или комментарии.
&Тест
Процедура ДетекторТаблицыЧитаетКодАНеЛитерал() Экспорт

	Ожидаем.Что(ПоискКлассов.ОбъявляетТаблицу("&ХранилищеСущностей(""Пул"")" + Символы.ПС + "Процедура ПриСозданииОбъекта()"),
		"хранилище сущности — таблица").ЭтоИстина();
	Ожидаем.Что(ПоискКлассов.ОбъявляетТаблицу("&Сущность(ИмяТаблицы = ""Пулы"")" + Символы.ПС + "Процедура ПриСозданииОбъекта()"),
		"сущность — таблица").ЭтоИстина();
	Ожидаем.Что(ПоискКлассов.ОбъявляетТаблицу("	&Сущность (ИмяТаблицы = ""Пулы"")" + Символы.ПС + "Процедура ПриСозданииОбъекта()"),
		"аннотация с отступом и пробелом перед скобкой — таблица").ЭтоИстина();
	Ожидаем.Что(ПоискКлассов.ОбъявляетТаблицу("Текст = ""&Сущность(ИмяТаблицы = Пулы)"";"),
		"аннотация внутри литерала — не таблица").ЭтоЛожь();
	Ожидаем.Что(ПоискКлассов.ОбъявляетТаблицу("Текст = ""первая" + Символы.ПС + "|&ХранилищеСущностей(Пул)"";"),
		"аннотация в продолжении многострочного литерала — не таблица").ЭтоЛожь();
	Ожидаем.Что(ПоискКлассов.ОбъявляетТаблицу("// &ХранилищеСущностей(""Пул"")"),
		"аннотация в комментарии — не таблица").ЭтоЛожь();
	Ожидаем.Что(ПоискКлассов.ОбъявляетТаблицу("&СущностьЧужая(""Пул"")"),
		"аннотация с похожим началом — не она").ЭтоЛожь();

КонецПроцедуры

// Реализация контракта узнаётся по прозвищу в строке аннотации, а не по его упоминанию.
&Тест
Процедура ДетекторРеализацииЧитаетКодАНеЛитерал() Экспорт

	Ожидаем.Что(ПоискКлассов.РеализуетКонтракт("&Прозвище(""ЗанятостьИмени"")" + Символы.ПС + "&Желудь", "ЗанятостьИмени"),
		"прозвище контракта — реализация").ЭтоИстина();
	Ожидаем.Что(ПоискКлассов.РеализуетКонтракт("	&Прозвище (""ЗанятостьИмени"")", "ЗанятостьИмени"),
		"прозвище с отступом и пробелом перед скобкой — реализация").ЭтоИстина();
	Ожидаем.Что(ПоискКлассов.РеализуетКонтракт("Текст = ""&Прозвище(""""ЗанятостьИмени"""")"";", "ЗанятостьИмени"),
		"прозвище внутри литерала — не реализация").ЭтоЛожь();
	Ожидаем.Что(ПоискКлассов.РеализуетКонтракт("Текст = ""первая" + Символы.ПС + "|&Прозвище(""""ЗанятостьИмени"""")"";",
		"ЗанятостьИмени"), "прозвище в продолжении многострочного литерала — не реализация").ЭтоЛожь();
	Ожидаем.Что(ПоискКлассов.РеализуетКонтракт("// &Прозвище(""ЗанятостьИмени"")", "ЗанятостьИмени"),
		"прозвище в комментарии — не реализация").ЭтоЛожь();
	Ожидаем.Что(ПоискКлассов.РеализуетКонтракт("&Прозвище(""ЗанятостьИмениДругая"")", "ЗанятостьИмени"),
		"прозвище с похожим началом — чужой контракт").ЭтоЛожь();

КонецПроцедуры
