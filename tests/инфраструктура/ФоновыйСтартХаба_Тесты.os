// Фоновый старт фикстуры ЭкземплярХаба на заглушке хаба: экземпляры стартуют разом, каждый дожидается
// своего старта на своём порту, перехваченный порт — повтор старта на другом.

#Использовать asserts
#Использовать "../фикстуры"

Перем Хабы;      // все экземпляры теста — останавливаются в &ПослеКаждого
Перем Сокеты;    // слушатели, занявшие порт за хаб, — закрываются в &ПослеКаждого
Перем Ворота;    // файл, без которого заглушка не открывает порт, — удаляется в &ПослеКаждого

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");

КонецПроцедуры

&ПередКаждым
Процедура ЗабытьПрошлыйТест() Экспорт

	Хабы = Новый Массив();
	Сокеты = Новый Массив();
	Ворота = ПолучитьИмяВременногоФайла("ворота");

КонецПроцедуры

&ПослеКаждого
Процедура ПрибратьЗаСобой() Экспорт

	Для Каждого Хаб Из Хабы Цикл
		Попытка
			Хаб.Остановить();
		Исключение
		КонецПопытки;
	КонецЦикла;

	Для Каждого Сокет Из Сокеты Цикл
		Попытка
			Сокет.Остановить();
		Исключение
		КонецПопытки;
	КонецЦикла;

	Попытка
		УдалитьФайлы(Ворота);
	Исключение
	КонецПопытки;

	Хабы = Новый Массив();
	Сокеты = Новый Массив();

КонецПроцедуры

&Тест
Процедура ДваХабаВФонеДожидаютсяКаждыйНаСвоёмПорту() Экспорт

	Первый = НоваяЗаглушкаХаба();
	Второй = НоваяЗаглушкаХаба();

	Первый.ЗапуститьВФоне();
	Второй.ЗапуститьВФоне();

	Ожидаем.Что(Первый.Порт(), "порт выдан до старта").Больше(0);
	Ожидаем.Что(Второй.Порт(), "порты экземпляров разные").Не_().Равно(Первый.Порт());

	Первый.Дождаться();
	Второй.Дождаться();

	Для Каждого Хаб Из Хабы Цикл
		Ответ = Хаб.Соединение(5).Получить(Новый HTTPЗапрос("/health"));
		Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("/health на порту %1", Хаб.Порт())).Равно(200);
		Ожидаем.Что(Хаб.ФайлЖурнала(), "журнал фонового хаба — в файле").Заполнено();
		Ожидаем.Что(Хаб.ЖурналЦеликом(), "строка конца старта в журнале").Содержит(Хаб.МаркерЗавершенияСтарта());
	КонецЦикла;

	Первый.Остановить();
	Ожидаем.Что(Второй.Работает(), "остановка одного не гасит соседа").ЭтоИстина();
	Второй.Дождаться(); // старт уже дождались — остаётся проба /health

КонецПроцедуры

&Тест
Процедура ПерехваченныйПортПовторяетСтартНаДругом() Экспорт

	Хаб = НоваяЗаглушкаХаба();
	Хаб.Среда("OSHUB_TEST_STUB_GATE", Ворота);
	Хаб.ЗапуститьВФоне();

	Занятый = Хаб.Порт();
	Сокет = Новый TCPСервер(Занятый);
	Сокет.Запустить();
	Сокеты.Добавить(Сокет);
	ПервыйPID = Хаб.ИдентификаторПроцесса();
	ОткрытьВорота();

	Хаб.Дождаться();

	Ожидаем.Что(Хаб.Порт(), "хаб поднялся на другом порту").Не_().Равно(Занятый);
	Ожидаем.Что(Хаб.ИдентификаторПроцесса(), "повтор — новый процесс").Не_().Равно(ПервыйPID);
	Ожидаем.Что(ПолучитьПеременнуюСреды("OSHUB_PORT"), "окружение — нового порта")
		.Равно(Формат(Хаб.Порт(), "ЧГ=0; ЧН=0"));
	Ожидаем.Что(Хаб.Соединение(5).Получить(Новый HTTPЗапрос("/health")).КодСостояния, "/health").Равно(200);

КонецПроцедуры

&Тест
Процедура ОтказФоновогоСтартаГаситХабИСнимаетОкружение() Экспорт

	// ворота не открываются: живая заглушка не пишет строку конца старта за таймаут 1 с
	Хаб = НоваяЗаглушкаХаба(1);
	Хаб.Среда("OSHUB_TEST_STUB_GATE", Ворота);
	Хаб.ЗапуститьВФоне();
	PID = Хаб.ИдентификаторПроцесса();

	Отказ = "";
	Попытка
		Хаб.Дождаться();
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Отказ, "отказ с первой попытки, без повтора").Содержит("попытка 1 из");
	Ожидаем.Что(Отказ, "причина — нет строки конца старта у живого процесса").Содержит("не появилось");
	Ожидаем.Что(Хаб.Работает(), "процесс погашен").ЭтоЛожь();
	Ожидаем.Что(Хаб.Порт(), "порт возвращён").Равно(0);
	Ожидаем.Что(PID, "процесс был").Больше(0);
	Ожидаем.Что(ЗначениеЗаполнено(ПолучитьПеременнуюСреды("OSHUB_PORT")), "окружение снято").ЭтоЛожь();

КонецПроцедуры

Процедура ОткрытьВорота()
	ПолучитьДвоичныеДанныеИзСтроки("открыто").Записать(Ворота);
КонецПроцедуры

// Экземпляр над заглушкой хаба (tests/фикстуры/заглушка-хаба); за ним приберёт &ПослеКаждого.
Функция НоваяЗаглушкаХаба(Знач ТаймаутГотовностиСек = 30)

	Хаб = Новый ЭкземплярХаба(ТаймаутГотовностиСек, ОбъединитьПути(КаталогиПроекта.Фикстуры(), "заглушка-хаба"));
	Хабы.Добавить(Хаб);

	Возврат Хаб;

КонецФункции
