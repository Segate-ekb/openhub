// Фоновый старт фикстуры ЭкземплярХаба на заглушке хаба: экземпляры стартуют разом, каждый дожидается
// своего старта на своём порту, перехваченный порт — повтор старта на другом.

#Использовать asserts
#Использовать "../фикстуры"

Перем Хабы;      // все экземпляры теста — останавливаются в &ПослеКаждого
Перем Сокеты;    // слушатели, занявшие порт за хаб, — закрываются в &ПослеКаждого
Перем Ворота;    // файл, без которого заглушка не открывает порт, — удаляется в &ПослеКаждого
Перем ЖурналСидера; // файл, куда сидер заглушки пишет видимую базу, — удаляется в &ПослеКаждого

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");

КонецПроцедуры

&ПередКаждым
Процедура ЗабытьПрошлыйТест() Экспорт

	Хабы = Новый Массив();
	Сокеты = Новый Массив();
	Ворота = ПолучитьИмяВременногоФайла("ворота");
	ЖурналСидера = ПолучитьИмяВременногоФайла("сидер");

КонецПроцедуры

&ПослеКаждого
Процедура ПрибратьЗаСобой() Экспорт

	Для Каждого Хаб Из Хабы Цикл
		Попытка
			Хаб.Остановить();
		Исключение
		КонецПопытки;
	КонецЦикла;

	Для Каждого Сокет Из Сокеты Цикл
		Попытка
			Сокет.Остановить();
		Исключение
		КонецПопытки;
	КонецЦикла;

	Для Каждого Файл Из СтрРазделить(Ворота + "|" + ЖурналСидера, "|") Цикл
		Попытка
			УдалитьФайлы(Файл);
		Исключение
		КонецПопытки;
	КонецЦикла;

	Хабы = Новый Массив();
	Сокеты = Новый Массив();

КонецПроцедуры

&Тест
Процедура ДваХабаВФонеДожидаютсяКаждыйНаСвоёмПорту() Экспорт

	Первый = НоваяЗаглушкаХаба();
	Второй = НоваяЗаглушкаХаба();

	Первый.ЗапуститьВФоне();
	Второй.ЗапуститьВФоне();

	Ожидаем.Что(Первый.Порт(), "порт выдан до старта").Больше(0);
	Ожидаем.Что(Второй.Порт(), "порты экземпляров разные").Не_().Равно(Первый.Порт());

	Первый.Дождаться();
	Второй.Дождаться();

	Для Каждого Хаб Из Хабы Цикл
		Ответ = Хаб.Соединение(5).Получить(Новый HTTPЗапрос("/health"));
		Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("/health на порту %1", Хаб.Порт())).Равно(200);
		Ожидаем.Что(Хаб.ФайлЖурнала(), "журнал фонового хаба — в файле").Заполнено();
		Ожидаем.Что(Хаб.ЖурналЦеликом(), "строка конца старта в журнале").Содержит(Хаб.МаркерЗавершенияСтарта());
	КонецЦикла;

	Первый.Остановить();
	Ожидаем.Что(Второй.Работает(), "остановка одного не гасит соседа").ЭтоИстина();
	Второй.Дождаться(); // старт уже дождались — остаётся проба /health

КонецПроцедуры

&Тест
Процедура ПерехваченныйПортПовторяетСтартНаДругом() Экспорт

	Хаб = НоваяЗаглушкаХаба();
	Хаб.Среда("OSHUB_TEST_STUB_GATE", Ворота);
	Хаб.ЗапуститьВФоне();

	Занятый = Хаб.Порт();
	Сокет = Новый TCPСервер(Занятый);
	Сокет.Запустить();
	Сокеты.Добавить(Сокет);
	ПервыйPID = Хаб.ИдентификаторПроцесса();
	ОткрытьВорота();

	Хаб.Дождаться();

	Ожидаем.Что(Хаб.Порт(), "хаб поднялся на другом порту").Не_().Равно(Занятый);
	Ожидаем.Что(Хаб.ИдентификаторПроцесса(), "повтор — новый процесс").Не_().Равно(ПервыйPID);
	Ожидаем.Что(ПолучитьПеременнуюСреды("OSHUB_PORT"), "окружение — нового порта")
		.Равно(Формат(Хаб.Порт(), "ЧГ=0; ЧН=0"));
	Ожидаем.Что(Хаб.Соединение(5).Получить(Новый HTTPЗапрос("/health")).КодСостояния, "/health").Равно(200);

КонецПроцедуры

&Тест
Процедура ОтказФоновогоСтартаГаситХабИСнимаетОкружение() Экспорт

	// ворота не открываются: живая заглушка не пишет строку конца старта за таймаут 1 с
	Хаб = НоваяЗаглушкаХаба(1);
	Хаб.Среда("OSHUB_TEST_STUB_GATE", Ворота);
	Хаб.ЗапуститьВФоне();
	PID = Хаб.ИдентификаторПроцесса();

	Отказ = "";
	Попытка
		Хаб.Дождаться();
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Отказ, "отказ с первой попытки, без повтора").Содержит("попытка 1 из");
	Ожидаем.Что(Отказ, "причина — нет строки конца старта у живого процесса").Содержит("не появилось");
	Ожидаем.Что(Хаб.Работает(), "процесс погашен").ЭтоЛожь();
	Ожидаем.Что(Хаб.Порт(), "порт возвращён").Равно(0);
	Ожидаем.Что(PID, "процесс был").Больше(0);
	Ожидаем.Что(ЗначениеЗаполнено(ПолучитьПеременнуюСреды("OSHUB_PORT")), "окружение снято").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ХабСтартовавшийВторымНеВидитПеременныхСоседа() Экспорт

	Первый = НоваяЗаглушкаХаба();
	Первый.Среда("OSHUB_TEST_STUB_ONLY_FIRST", "первый");
	Первый.Среда("OSHUB_DB_CONNECTION", "база-первого");
	Второй = НоваяЗаглушкаХаба();
	Второй.Среда("OSHUB_DB_CONNECTION", "база-второго");

	Первый.ЗапуститьВФоне();
	Второй.ЗапуститьВФоне();
	Первый.Дождаться();
	Второй.Дождаться();

	ЖурналВторого = Второй.ЖурналЦеликом();
	Ожидаем.Что(ЖурналВторого, "переменная, заданная только первому").Не_().Содержит("OSHUB_TEST_STUB_ONLY_FIRST");
	Ожидаем.Что(ЖурналВторого, "своя база второго").Содержит("окружение OSHUB_DB_CONNECTION=база-второго");
	Ожидаем.Что(ЖурналВторого, "свой порт второго")
		.Содержит("окружение OSHUB_PORT=" + Формат(Второй.Порт(), "ЧГ=0; ЧН=0"));
	Ожидаем.Что(Первый.ЖурналЦеликом(), "своя база первого").Содержит("окружение OSHUB_DB_CONNECTION=база-первого");

КонецПроцедуры

&Тест
Процедура СидерПервогоПослеСтартаВторогоВидитБазуПервого() Экспорт

	Первый = НоваяЗаглушкаХаба();
	Первый.Среда("OSHUB_DB_CONNECTION", "база-первого");
	Первый.Среда("OSHUB_TEST_STUB_SEED_LOG", ЖурналСидера);
	Второй = НоваяЗаглушкаХаба();
	Второй.Среда("OSHUB_DB_CONNECTION", "база-второго");

	Первый.ЗапуститьВФоне();
	Второй.ЗапуститьВФоне();
	Первый.ЗапуститьСидер(СидерЗаглушки(), 30);

	Ожидаем.Что(ВыводСидера(), "сидер первого").Равно("база база-первого");

КонецПроцедуры

&Тест
Процедура ОстановкаСоседаНеЛомаетСидерЖивого() Экспорт

	Первый = НоваяЗаглушкаХаба();
	Первый.Среда("OSHUB_DB_CONNECTION", "база-первого");
	Второй = НоваяЗаглушкаХаба();
	Второй.Среда("OSHUB_DB_CONNECTION", "база-второго");
	Второй.Среда("OSHUB_TEST_STUB_SEED_LOG", ЖурналСидера);

	Первый.ЗапуститьВФоне();
	Второй.ЗапуститьВФоне();
	Первый.Дождаться();
	Второй.Дождаться();
	Первый.Остановить();

	Второй.ЗапуститьСидер(СидерЗаглушки(), 30);
	Ожидаем.Что(ВыводСидера(), "сидер живого второго после остановки первого").Равно("база база-второго");

КонецПроцедуры

&Тест
Процедура ПовторСтартаИдётБезПеременныхЖивогоСоседа() Экспорт

	Первый = НоваяЗаглушкаХаба();
	Первый.Среда("OSHUB_TEST_STUB_ONLY_FIRST", "первый");
	Первый.Среда("OSHUB_DB_CONNECTION", "база-первого");
	Первый.ЗапуститьВФоне();
	Первый.Дождаться();

	Второй = НоваяЗаглушкаХаба();
	Второй.Среда("OSHUB_DB_CONNECTION", "база-второго");
	Второй.Среда("OSHUB_TEST_STUB_GATE", Ворота);
	Второй.ЗапуститьВФоне();
	Занятый = Второй.Порт();
	Сокет = Новый TCPСервер(Занятый);
	Сокет.Запустить();
	Сокеты.Добавить(Сокет);
	ОткрытьВорота();
	Второй.Дождаться();

	Ожидаем.Что(Второй.Порт(), "второй поднялся повтором на другом порту").Не_().Равно(Занятый);
	ЖурналВторого = Второй.ЖурналЦеликом();
	Ожидаем.Что(ЖурналВторого, "переменная живого первого в повторе").Не_().Содержит("OSHUB_TEST_STUB_ONLY_FIRST");
	Ожидаем.Что(ЖурналВторого, "своя база в повторе").Содержит("окружение OSHUB_DB_CONNECTION=база-второго");

КонецПроцедуры

&Тест
Процедура ОкружениеПрогонаДоФикстурДоходитДоХабаКоторыйЕгоНеЗадал() Экспорт

	// внешняя переменная задаётся процессу сценария до загрузки фикстур — иначе снимок её не увидит
	Внешнее = Новый Соответствие();
	Внешнее.Вставить("OSHUB_TEST_STUB_OUTER", "снаружи");
	Сценарий = ОбъединитьПути(КаталогиПроекта.Фикстуры(), "заглушка-хаба", "ОкружениеДоФикстур.os");
	Процесс_ = СоздатьПроцесс(СтрШаблон("oscript ""%1""", Сценарий), КаталогиПроекта.Корень(), Истина, , ,
		Внешнее);
	Процесс_.Запустить();
	Процесс_.ОжидатьЗавершения();
	Вывод = Строка(Процесс_.ПотокВывода.Прочитать()) + Строка(Процесс_.ПотокОшибок.Прочитать());

	Ожидаем.Что(Процесс_.КодВозврата, "сценарий отработал: " + Вывод).Равно(0);
	Ожидаем.Что(Вывод, "при живом соседе, переставившем переменную")
		.Содержит("при соседе: окружение OSHUB_TEST_STUB_OUTER=снаружи");
	Ожидаем.Что(Вывод, "после остановки соседа, стёршей переменную")
		.Содержит("после соседа: окружение OSHUB_TEST_STUB_OUTER=снаружи");

КонецПроцедуры

Функция СидерЗаглушки()
	Возврат ОбъединитьПути(КаталогиПроекта.Фикстуры(), "заглушка-хаба", "src", "СидерЗаглушки.os");
КонецФункции

Функция ВыводСидера()
	Чтение = Новый ЧтениеТекста(ЖурналСидера, "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат СокрЛП(Текст);
КонецФункции

Процедура ОткрытьВорота()
	ПолучитьДвоичныеДанныеИзСтроки("открыто").Записать(Ворота);
КонецПроцедуры

// Экземпляр над заглушкой хаба (tests/фикстуры/заглушка-хаба); за ним приберёт &ПослеКаждого.
Функция НоваяЗаглушкаХаба(Знач ТаймаутГотовностиСек = 30)

	Хаб = Новый ЭкземплярХаба(ТаймаутГотовностиСек, ОбъединитьПути(КаталогиПроекта.Фикстуры(), "заглушка-хаба"));
	Хабы.Добавить(Хаб);

	Возврат Хаб;

КонецФункции
