// Самотест СоветНабора: контейнер набора без файла настроек не видит autumn-properties.json проекта,
// детальки набора сильнее файла, и совет собирается без предупреждений ОСени об устаревших методах.

#Использовать asserts
#Использовать autumn
#Использовать logos
#Использовать "../фикстуры"

&ТестовыйНабор
&Изолированный(Уровень = "Процесс")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьЛовушку() Экспорт
	РеестрФикстур.Подключить("ЛовушкаЛога");
КонецПроцедуры

// Без файла настроек контейнер не берёт узлы autumn-properties.json проекта. Самоконтроль: тот же
// ключ контейнер с файлом видит — иначе проверка прошла бы и при файле, которого из каталога запуска не видно.
&Тест
Процедура БезФайлаНастроекКорневойФайлНеВиден() Экспорт

	Ожидаем.Что(ИзКорневогоФайла(), "самоконтроль: ключ задан в autumn-properties.json проекта").Заполнено();

	Поделка = Новый Поделка(СоветНабора.СДетальками(Новый Соответствие()));
	Ожидаем.Что(Поделка.НайтиДетальку(КлючКорневогоФайла()), "контейнер с файлом его видит")
		.Равно(ИзКорневогоФайла());

	Поделка = Новый Поделка(СоветНабора.БезФайлаНастроек(Новый Соответствие()));
	Ожидаем.Что(Поделка.НайтиДетальку(КлючКорневогоФайла()), "контейнер без файла настроек его не видит")
		.Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ДеталькиНабораСильнееФайлаНастроек() Экспорт

	Детальки = Новый Соответствие();
	Детальки.Вставить(КлючКорневогоФайла(), "из-набора");

	Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));

	Ожидаем.Что(Поделка.НайтиДетальку(КлючКорневогоФайла())).Равно("из-набора");

КонецПроцедуры

&Тест
Процедура СоветСобираетсяБезПредупрежденийОбУстаревшем() Экспорт

	Ловушка = Новый ЛовушкаЛога();
	Ловушка.Поставить(Логирование.ПолучитьЛог("oscript.lib.autumn.application.context"), УровниЛога.Предупреждение);
	Попытка
		Детальки = Новый Соответствие();
		Детальки.Вставить("oshub.probe", "проба");
		Поделка = Новый Поделка(СоветНабора.СДетальками(Детальки));
		Поделка = Новый Поделка(СоветНабора.БезФайлаНастроек(Детальки));
	Исключение
		Ловушка.Снять();
		ВызватьИсключение;
	КонецПопытки;
	Ловушка.Снять();

	Ожидаем.Что(СтрНайти(НРег(Ловушка.Всё()), "устарел"), "предупреждения ОСени: " + Ловушка.Всё()).Равно(0);

КонецПроцедуры

Функция КлючКорневогоФайла()
	Возврат "oshub.pools.default";
КонецФункции

Функция ИзКорневогоФайла()
	Чтение = Новый ЧтениеJSON();
	Чтение.ОткрытьФайл(ОбъединитьПути(КаталогиПроекта.Корень(), "autumn-properties.json"), "UTF-8");
	Корень = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Корень["oshub"]["pools"]["default"];
КонецФункции
