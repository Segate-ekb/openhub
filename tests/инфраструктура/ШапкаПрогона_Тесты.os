// Шапка и итог прогона scripts/тесты.sh и scripts/смоук.sh на стенде-репозитории с заглушкой
// oneunit: по ним ревьюер узнаёт, на каком коммите, в каком дереве и какой командой шёл прогон.

#Использовать asserts
#Использовать "../фикстуры"

Перем Стенд;
Перем Дерево;
Перем ВнеGit;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьСтенд() Экспорт

	Стенд = УникальныеИмена.ВременныйКаталог("oshub-шапка-прогона");
	Дерево = ОбъединитьПути(Стенд, "дерево");
	ВнеGit = ОбъединитьПути(Стенд, "вне-git");

	// заглушка oneunit: по ходу прогона исполняет по-ходу.sh стенда (процесс скрипта — в SCRIPT_PID)
	// и выходит с кодом из файла «код»
	ЗаписатьФайл(Стенд, "bin/oneunit", "#!/bin/sh
		|stand=""$(cd ""$(dirname ""$0"")/.."" && pwd)""
		|export SCRIPT_PID=$PPID
		|if [ -f ""$stand/по-ходу.sh"" ]; then sh ""$stand/по-ходу.sh""; fi
		|echo ""заглушка oneunit: $*""
		|exit ""$(cat ""$stand/код"" 2>/dev/null || echo 0)""
		|");
	// стенд — потолок поиска репозитория: каталог «вне-git» вне git, где бы ни лежали временные файлы
	ЗаписатьФайл(Стенд, "бег.sh", "stand=""$(cd ""$(dirname ""$0"")"" && pwd)""
		|export PATH=""$stand/bin:$PATH""
		|export GIT_CEILING_DIRECTORIES=""$stand""
		|exec bash ""$@""
		|");
	ВыполнитьКоманду("chmod +x bin/oneunit", Стенд);

	Для Каждого Корень Из СтрРазделить(Дерево + Символы.ПС + ВнеGit, Символы.ПС) Цикл
		СобратьКорень(Корень);
	КонецЦикла;

	ВыполнитьКоманду("git init -q", Дерево);
	ВыполнитьКоманду("git add -A", Дерево);
	Закоммитить("начало стенда");

КонецПроцедуры

&ПослеВсех
Процедура УбратьСтенд() Экспорт
	Если Стенд <> Неопределено Тогда
		УникальныеИмена.УбратьВременное(Стенд);
	КонецЕсли;
КонецПроцедуры

&ПередКаждым
Процедура ВернутьЧистоеДерево() Экспорт
	ВыполнитьКоманду("git reset -q --hard", Дерево);
	ВыполнитьКоманду("git clean -q -f -d", Дерево);
	УдалитьФайлы(Стенд, "по-ходу.sh");
	УдалитьФайлы(Стенд, "код");
КонецПроцедуры

&Тест
Процедура ШапкаОткрываетВыводКоммитомДеревомКомандойИНачалом() Экспорт

	Прогон = Прогон("scripts/тесты.sh склад -- --mode summary");

	Ожидаем.Что(Прогон.Строки[0], "первая строка вывода — коммит").Равно("== прогон.коммит: " + Голова());
	Ожидаем.Что(Прогон.Строки[1], "чистое дерево").Равно("== прогон.дерево: чисто");
	Ожидаем.Что(Прогон.Строки[2], "команда со всеми аргументами")
		.Равно("== прогон.команда: scripts/тесты.sh склад -- --mode summary");
	// путь — как его видит getcwd: временный каталог macOS приходит через ссылку /var → /private/var
	Ожидаем.Что(СтрНачинаетсяС(Прогон.Строки[3], "== прогон.каталог: /")
		И СтрЗаканчиваетсяНа(Прогон.Строки[3], "/дерево"), "корень дерева: " + Прогон.Строки[3]).ЭтоИстина();
	Ожидаем.Что(Новый РегулярноеВыражение("^== прогон\.начало: \d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ$")
		.Совпадает(Прогон.Строки[4]), "время начала в UTC: " + Прогон.Строки[4]).ЭтоИстина();
	Ожидаем.Что(Прогон.Вывод, "прогон дошёл до oneunit с аргументами после «--»")
		.Содержит("заглушка oneunit: execute -f tests/склад/Полка_Тесты.os --mode summary");

КонецПроцедуры

&Тест
Процедура ИтогЗакрываетВыводКодомВыходаИТемЖеКоммитом() Экспорт

	ЗаписатьФайл(Стенд, "код", "3");

	Прогон = Прогон("scripts/тесты.sh склад");

	Ожидаем.Что(Прогон.Код, "код выхода oneunit — код скрипта").Равно(3);
	Ожидаем.Что(Итог(Прогон), "последняя строка — итог")
		.Равно("код 3, коммит " + Голова() + ", дерево чистое и не менялось");

КонецПроцедуры

&Тест
Процедура ОтказПоКлючуТожеЗакрываетсяИтогом() Экспорт

	Прогон = Прогон("scripts/тесты.sh --нет-такого");

	Ожидаем.Что(Прогон.Код, "неизвестный ключ").Равно(2);
	Ожидаем.Что(Прогон.Строки[0], "шапка и до разбора ключей").Равно("== прогон.коммит: " + Голова());
	Ожидаем.Что(Итог(Прогон), "итог с кодом отказа")
		.Равно("код 2, коммит " + Голова() + ", дерево чистое и не менялось");

КонецПроцедуры

&Тест
Процедура ГрязноеДеревоПеречисляетсяВШапкеИНазываетсяВИтоге() Экспорт

	ЗаписатьФайл(Дерево, "tests/склад/Полка_Тесты.os", "// правка");
	ЗаписатьФайл(Дерево, "черновик.os", "");

	Прогон = Прогон("scripts/тесты.sh склад");

	Ожидаем.Что(Поле(Прогон, "дерево"), "число путей и сами пути, имена кириллицей как есть")
		.Равно("с правками, путей 2| M tests/склад/Полка_Тесты.os|?? черновик.os");
	Ожидаем.Что(Итог(Прогон), "итог помнит, что дерево было с правками")
		.Равно("код 0, коммит " + Голова() + ", дерево с правками и не менялось");

КонецПроцедуры

&Тест
Процедура ДлинныйПереченьПравокОбрезаетсяСоСчётчиком() Экспорт

	// перечень путей больше буфера канала: шапка не обрывает прогон на середине
	Для Номер = 1 По 2000 Цикл
		ЗаписатьФайл(Дерево, СтрШаблон("черновики/незакоммиченный-черновик-набора-%1.os",
			Формат(Номер, "ЧЦ=4; ЧВН=; ЧГ=0")), "");
	КонецЦикла;

	Прогон = Прогон("scripts/тесты.sh склад");
	Строки = СтрРазделить(Поле(Прогон, "дерево"), "|");

	Ожидаем.Что(Прогон.Код, "прогон дошёл до конца").Равно(0);
	Ожидаем.Что(Строки.Количество(), "счётчик, двадцать путей и остаток").Равно(22);
	Ожидаем.Что(Строки[0]).Равно("с правками, путей 2000");
	Ожидаем.Что(Строки[20]).Равно("?? черновики/незакоммиченный-черновик-набора-0020.os");
	Ожидаем.Что(Строки[21]).Равно("… и ещё 1980");
	Ожидаем.Что(Прогон.Вывод, "oneunit запущен").Содержит("заглушка oneunit: execute");
	Ожидаем.Что(Итог(Прогон)).Равно("код 0, коммит " + Голова() + ", дерево с правками и не менялось");

КонецПроцедуры

&Тест
Процедура НовыйФайлПоХодуПрогонаНазываетсяВИтоге() Экспорт

	ЗаписатьФайл(Стенд, "по-ходу.sh", "echo проба > появился-по-ходу.os");

	Ожидаем.Что(Итог(Прогон("scripts/тесты.sh склад")), "файл появился во время прогона")
		.Равно("код 0, коммит " + Голова() + ", дерево менялось по ходу прогона");

КонецПроцедуры

&Тест
Процедура ПравкаУжеГрязногоФайлаПоХодуПрогонаНазываетсяВИтоге() Экспорт

	ЗаписатьФайл(Дерево, "tests/склад/Полка_Тесты.os", "// правка до прогона");
	ЗаписатьФайл(Стенд, "по-ходу.sh", "echo ещё >> tests/склад/Полка_Тесты.os");

	Прогон = Прогон("scripts/тесты.sh склад");

	Ожидаем.Что(Поле(Прогон, "дерево"), "в шапке файл уже с правкой")
		.Равно("с правками, путей 1| M tests/склад/Полка_Тесты.os");
	Ожидаем.Что(Итог(Прогон), "состояние пути то же, содержимое другое")
		.Равно("код 0, коммит " + Голова() + ", дерево менялось по ходу прогона");

КонецПроцедуры

&Тест
Процедура ДописанныйПоХодуНеотслеживаемыйФайлНазываетсяВИтоге() Экспорт

	ЗаписатьФайл(Дерево, "черновик.os", "// до прогона");
	ЗаписатьФайл(Стенд, "по-ходу.sh", "echo по ходу >> черновик.os");

	Прогон = Прогон("scripts/тесты.sh склад");

	Ожидаем.Что(Поле(Прогон, "дерево"), "в шапке файл уже неотслеживаемый")
		.Равно("с правками, путей 1|?? черновик.os");
	Ожидаем.Что(Итог(Прогон), "состояние пути то же, содержимое неотслеживаемого файла другое")
		.Равно("код 0, коммит " + Голова() + ", дерево менялось по ходу прогона");

КонецПроцедуры

&Тест
Процедура ОстановкаСигналомНазываетКодСигналаВИтоге() Экспорт

	ЗаписатьФайл(Стенд, "по-ходу.sh", "kill -TERM $SCRIPT_PID");

	Прогон = Прогон("scripts/тесты.sh склад");

	Ожидаем.Что(Прогон.Код, "скрипт вышел с кодом SIGTERM").Равно(143);
	Ожидаем.Что(Итог(Прогон), "итог не выдаёт остановленный прогон за удачный")
		.Равно("код 143, коммит " + Голова() + ", дерево чистое и не менялось");

	ЗаписатьФайл(Стенд, "по-ходу.sh", "kill -HUP $SCRIPT_PID");

	Прогон = Прогон("scripts/смоук.sh");

	Ожидаем.Что(Прогон.Код, "смоук вышел с кодом SIGHUP").Равно(129);
	Ожидаем.Что(Итог(Прогон)).Равно("код 129, коммит " + Голова() + ", дерево чистое и не менялось");

КонецПроцедуры

&Тест
Процедура КоммитПоХодуПрогонаНазываетОбаХэша() Экспорт

	До = Голова();
	ЗаписатьФайл(Стенд, "по-ходу.sh", КомандаКоммита("по ходу прогона"));

	Итог = Итог(Прогон("scripts/тесты.sh склад"));

	Ожидаем.Что(Голова(), "коммит по ходу прогона состоялся").Не_().Равно(До);
	Ожидаем.Что(Итог, "итог называет коммит начала и конца")
		.Равно("код 0, коммит " + До + " → " + Голова() + ", дерево менялось по ходу прогона");

КонецПроцедуры

&Тест
Процедура СписокНаборовОткрываетсяШапкойИЗакрываетсяИтогом() Экспорт

	Прогон = Прогон("scripts/тесты.sh склад --список");

	Ожидаем.Что(Прогон.Строки[0]).Равно("== прогон.коммит: " + Голова());
	Ожидаем.Что(Прогон.Строки[2]).Равно("== прогон.команда: scripts/тесты.sh склад --список");
	Ожидаем.Что(Прогон.Вывод, "список oneunit не зовёт").Не_().Содержит("заглушка oneunit");
	Ожидаем.Что(Итог(Прогон)).Равно("код 0, коммит " + Голова() + ", дерево чистое и не менялось");

КонецПроцедуры

&Тест
Процедура СмоукОткрываетсяТойЖеШапкойИЗакрываетсяИтогом() Экспорт

	ЗаписатьФайл(Стенд, "код", "1");

	Прогон = Прогон("scripts/смоук.sh --mode summary");

	Ожидаем.Что(Прогон.Код).Равно(1);
	Ожидаем.Что(Прогон.Строки[0]).Равно("== прогон.коммит: " + Голова());
	Ожидаем.Что(Прогон.Строки[1]).Равно("== прогон.дерево: чисто");
	Ожидаем.Что(Прогон.Строки[2]).Равно("== прогон.команда: scripts/смоук.sh --mode summary");
	Ожидаем.Что(Прогон.Вывод).Содержит("заглушка oneunit: execute -t смоук -f tests/склад/Полка_Тесты.os --mode summary");
	Ожидаем.Что(Итог(Прогон)).Равно("код 1, коммит " + Голова() + ", дерево чистое и не менялось");

КонецПроцедуры

&Тест
Процедура ВнеGitШапкаГоворитЧтоКоммитаНетАПрогонИдёт() Экспорт

	Прогон = Прогон("scripts/тесты.sh склад", ВнеGit);

	Ожидаем.Что(Прогон.Код, "прогон без git не падает").Равно(0);
	Ожидаем.Что(Прогон.Строки[0]).Равно("== прогон.коммит: нет — каталог вне git");
	Ожидаем.Что(Прогон.Строки[1]).Равно("== прогон.дерево: неизвестно — каталог вне git");
	Ожидаем.Что(Прогон.Вывод).Содержит("заглушка oneunit: execute -f tests/склад/Полка_Тесты.os");
	Ожидаем.Что(Итог(Прогон)).Равно("код 0, коммита нет — каталог вне git");

КонецПроцедуры

#Область Стенд

Процедура СобратьКорень(Знач Корень)

	СоздатьКаталог(ОбъединитьПути(Корень, "scripts"));
	Для Каждого Скрипт Из СтрРазделить("тесты.sh,смоук.sh,шапка-прогона.sh", ",") Цикл
		КопироватьФайл(ОбъединитьПути(КаталогиПроекта.Корень(), "scripts", Скрипт),
			ОбъединитьПути(Корень, "scripts", Скрипт));
	КонецЦикла;

	ЗаписатьФайл(Корень, "src/модули/склад/Классы/Полка.os", "");
	ЗаписатьФайл(Корень, "tests/склад/Полка_Тесты.os", "&Тег(""смоук"")" + Символы.ПС);

КонецПроцедуры

// Прогон скрипта в корне стенда: Код, Вывод (stdout) и его Строки.
Функция Прогон(Знач Команда, Знач Корень = Неопределено)

	Исполнение = Исполнить("bash ../бег.sh " + Команда, ?(Корень = Неопределено, Дерево, Корень));

	Результат = Новый Структура("Код, Вывод, Строки", Исполнение.Код, Исполнение.Вывод,
		СтрРазделить(Исполнение.Вывод, Символы.ПС, Ложь));
	Ожидаем.Что(Результат.Строки.Количество() > 5, "шапка напечатана: " + Исполнение.Вывод + Исполнение.Ошибки)
		.ЭтоИстина();

	Возврат Результат;

КонецФункции

// Строки поля шапки через «|» без префикса «== прогон.<поле>: ».
Функция Поле(Знач Прогон, Знач Имя)

	Префикс = "== прогон." + Имя + ": ";
	Значения = Новый Массив();
	Для Каждого Строка_ Из Прогон.Строки Цикл
		Если СтрНачинаетсяС(Строка_, Префикс) Тогда
			Значения.Добавить(Сред(Строка_, СтрДлина(Префикс) + 1));
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Значения, "|");

КонецФункции

// Итог — последняя строка вывода — без префикса и времени конца.
Функция Итог(Знач Прогон)

	Последняя = Прогон.Строки[Прогон.Строки.ВГраница()];
	Образец = Новый РегулярноеВыражение("^== прогон\.итог: (.*), конец \d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ$");
	Ожидаем.Что(Образец.Совпадает(Последняя), "последняя строка — итог: " + Последняя).ЭтоИстина();

	Возврат Образец.НайтиСовпадения(Последняя)[0].Группы[1].Значение;

КонецФункции

Функция Голова()
	Возврат СокрЛП(ВыполнитьКоманду("git rev-parse HEAD", Дерево));
КонецФункции

Функция КомандаКоммита(Знач Сообщение)
	Возврат СтрШаблон("git -c user.name=стенд -c user.email=stand@example.org -c commit.gpgsign=false "
		+ "commit -q --no-verify --allow-empty -m ""%1""", Сообщение);
КонецФункции

Процедура Закоммитить(Знач Сообщение)
	ВыполнитьКоманду(КомандаКоммита(Сообщение), Дерево);
КонецПроцедуры

Функция ВыполнитьКоманду(Знач Команда, Знач Каталог)

	Исполнение = Исполнить(Команда, Каталог);
	Ожидаем.Что(Исполнение.Код, Команда + ": " + Исполнение.Вывод + Исполнение.Ошибки).Равно(0);

	Возврат Исполнение.Вывод;

КонецФункции

Функция Исполнить(Знач Команда, Знач Каталог)

	Процесс = СоздатьПроцесс(Команда, Каталог, Истина, Истина);
	Процесс.Запустить();

	Вывод = Новый Массив();
	Ошибки = Новый Массив();
	Пока НЕ Процесс.Завершен Цикл
		ДобавитьПрочитанное(Вывод, Процесс.ПотокВывода.Прочитать());
		ДобавитьПрочитанное(Ошибки, Процесс.ПотокОшибок.Прочитать());
		Приостановить(50);
	КонецЦикла;
	ДобавитьПрочитанное(Вывод, Процесс.ПотокВывода.Прочитать());
	ДобавитьПрочитанное(Ошибки, Процесс.ПотокОшибок.Прочитать());

	Возврат Новый Структура("Код, Вывод, Ошибки", Процесс.КодВозврата,
		СтрСоединить(Вывод, ""), СтрСоединить(Ошибки, ""));

КонецФункции

// Поток процесса отдаёт данные один раз и пустым отвечает Неопределено.
Процедура ДобавитьПрочитанное(Куски, Знач Прочитанное)
	Если Прочитанное <> Неопределено Тогда
		Куски.Добавить(Строка(Прочитанное));
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьФайл(Знач Корень, Знач Относительный, Знач Текст)

	Путь = ОбъединитьПути(Корень, Относительный);
	СоздатьКаталог(Новый Файл(Путь).Путь);

	// байтами: запись текстом ставит переводы строк CRLF, и bash их не читает
	ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8").Записать(Путь);

КонецПроцедуры

#КонецОбласти
