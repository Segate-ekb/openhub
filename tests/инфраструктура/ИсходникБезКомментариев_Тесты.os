// Самотест ИсходникБезКомментариев: на нём стоят все сканеры дерева.

#Использовать asserts
#Использовать "../фикстуры"

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&Тест
Процедура ХвостовойКомментарийСнимается() Экспорт

	Ожидаем.Что(ИсходникБезКомментариев.БезКомментариев("Код = 1; // пояснение"))
		.Равно("Код = 1; ");

КонецПроцедуры

&Тест
Процедура ЛитералНеДиректива() Экспорт

	// «//» внутри кавычек — данные: наивная обрезка по первому «//» рубила бы адрес пополам
	Исходник = "Адрес = ""http://localhost/x""; // сюда";

	Ожидаем.Что(ИсходникБезКомментариев.БезКомментариев(Исходник))
		.Равно("Адрес = ""http://localhost/x""; ");

КонецПроцедуры

&Тест
Процедура ЛитералСКомментарнымНачаломВыживаетЦеликом() Экспорт

	Ожидаем.Что(ИсходникБезКомментариев.БезКомментариев("Строка_ = ""// это не комментарий"";"))
		.Равно("Строка_ = ""// это не комментарий"";");

КонецПроцедуры

&Тест
Процедура КомментарнаяПараВнутриЛитералаНеРежетСтроку() Экспорт

	// литерал с удвоенными кавычками внутри — тот же литерал: «//» в нём остаётся данными
	Исходник = "Текст = ""он сказал """"да"""" // и ушёл""; // а вот это комментарий";

	Ожидаем.Что(ИсходникБезКомментариев.БезКомментариев(Исходник))
		.Равно("Текст = ""он сказал """"да"""" // и ушёл""; ");

КонецПроцедуры

&Тест
Процедура МногострочныйЛитералПереживаетПереводСтроки() Экспорт

	// литерал OneScript продолжается символом «|», кавычка заново не открывается:
	// построчный разбор считал бы вторую строку кодом и срезал бы её хвост
	Исходник = "Текст = ""первая
	||вторая // не комментарий"";";

	Ожидаем.Что(ИсходникБезКомментариев.БезКомментариев(Исходник)).Равно(Исходник);

КонецПроцедуры

&Тест
Процедура ЧислоСтрокНеМеняется() Экспорт

	Исходник = "первая // раз
	|// вся строка комментарий
	|третья";

	Ожидаем.Что(СтрЧислоСтрок(ИсходникБезКомментариев.БезКомментариев(Исходник)))
		.Равно(СтрЧислоСтрок(Исходник));

КонецПроцедуры

&Тест
Процедура КавычкаВКомментарииЛитералНеОткрывает() Экспорт

	// откройся здесь литерал — весь код до следующей кавычки пропал бы из скана
	Исходник = "Код = 1; // он сказал ""да" + Символы.ПС + "Б = Новый Нарушитель();";

	Ожидаем.Что(ИсходникБезКомментариев.БезКомментариев(Исходник))
		.Равно("Код = 1; " + Символы.ПС + "Б = Новый Нарушитель();");
	Ожидаем.Что(СтрНайти(ИсходникБезКомментариев.БезКомментариевИЛитералов(Исходник), "Нарушитель") > 0,
		"код после комментария с кавычкой виден сканеру").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СнятиеЛитераловСохраняетЧислоСтрок() Экспорт

	// на номерах строк стоят отчёты сканеров
	Исходник = "Текст = ""первая
	||вторая
	||третья""; // хвост
	|Код = 1;";

	Очищенный = ИсходникБезКомментариев.БезКомментариевИЛитералов(Исходник);

	Ожидаем.Что(СтрЧислоСтрок(Очищенный)).Равно(СтрЧислоСтрок(Исходник));
	Ожидаем.Что(СтрПолучитьСтроку(Очищенный, 4), "код за многострочным литералом на своей строке")
		.Равно("Код = 1;");

КонецПроцедуры

&Тест
Процедура УдвоенныеКавычкиСнимаютсяВместеСЛитералом() Экспорт

	Ожидаем.Что(ИсходникБезКомментариев.БезКомментариевИЛитералов("Т = ""а""""б""; Х = 1; // к"))
		.Равно("Т = ; Х = 1; ");

КонецПроцедуры

&Тест
Процедура НезакрытыйЛитералДлитсяДоКонцаТекста() Экспорт

	Исходник = "Т = ""первая" + Символы.ПС + "|вторая // не комментарий";

	Ожидаем.Что(ИсходникБезКомментариев.БезКомментариев(Исходник)).Равно(Исходник);
	Ожидаем.Что(ИсходникБезКомментариев.БезКомментариевИЛитералов(Исходник)).Равно("Т = " + Символы.ПС);

КонецПроцедуры

&Тест
Процедура ПереводыСтрокCRLFСтрокНеСливают() Экспорт

	Исходник = "А = 1; // к" + Символы.ВК + Символы.ПС + "Б = 2;" + Символы.ВК + Символы.ПС;

	Очищенный = ИсходникБезКомментариев.БезКомментариевИЛитералов(Исходник);

	Ожидаем.Что(СтрЧислоВхождений(Очищенный, Символы.ПС), "переводы строк на месте").Равно(2);
	Ожидаем.Что(СокрЛП(СтрПолучитьСтроку(Очищенный, 2)), "вторая строка кода цела").Равно("Б = 2;");
	Ожидаем.Что(СтрНайти(Очищенный, "к"), "комментарий снят до перевода строки").Равно(0);

КонецПроцедуры

&Тест
Процедура ПустойТекстОстаётсяПустым() Экспорт

	Ожидаем.Что(ИсходникБезКомментариев.БезКомментариев("")).Равно("");
	Ожидаем.Что(ИсходникБезКомментариев.БезКомментариевИЛитералов("")).Равно("");

КонецПроцедуры

&Тест
Процедура КавычкаПоследнимСимволомОткрываетЛитералДоКонца() Экспорт

	Ожидаем.Что(ИсходникБезКомментариев.БезХвостовогоКомментария("Текст = """))
		.Равно("Текст = """);
	Ожидаем.Что(ИсходникБезКомментариев.БезКомментариевИЛитералов("Текст = ""// не комментарий"))
		.Равно("Текст = ");

КонецПроцедуры

&Тест
Процедура ЛитералыСнимаютсяВместеСКавычками() Экспорт

	Ожидаем.Что(ИсходникБезКомментариев.БезКомментариевИЛитералов("Вызов(""начинка""); // хвост"))
		.Равно("Вызов(); ");

КонецПроцедуры

&Тест
Процедура СнятыйЛитералНеОставляетДирективуВКоде() Экспорт

	// ровно тот случай, ради которого сканеры смотрят код, а не текст: слово-нарушитель
	// внутри кавычек не должно попадать в корпус скана
	Очищенный = ИсходникБезКомментариев.БезКомментариевИЛитералов("Образец = ""Новый Нарушитель"";");

	Ожидаем.Что(СтрНайти(Очищенный, "Нарушитель"), "образец в литерале не читается как код")
		.Равно(0);

КонецПроцедуры

&Тест
Процедура СнятиеЛитераловНеТрогаетКод() Экспорт

	Очищенный = ИсходникБезКомментариев.БезКомментариевИЛитералов("Правило = Новый Нарушитель(""имя"");");

	Ожидаем.Что(СтрНайти(Очищенный, "Нарушитель") > 0, "код виден сканеру").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура МногострочныйЛитералНеОставляетНачинкиВКоде() Экспорт

	// хуже всего именно этот случай: построчный разбор закрывает литерал на переводе
	// строки и дальше читает начинку как код
	Исходник = "Текст = ""первая
	||вторая Нарушитель"";";

	Очищенный = ИсходникБезКомментариев.БезКомментариевИЛитералов(Исходник);

	Ожидаем.Что(СтрНайти(Очищенный, "Нарушитель"), "многострочная начинка тоже снята").Равно(0);

КонецПроцедуры

&Тест
Процедура ХвостоваяФункцияРаботаетНаОднойСтроке() Экспорт

	Ожидаем.Что(ИсходникБезКомментариев.БезХвостовогоКомментария("Если А = ""//"" Тогда // да"))
		.Равно("Если А = ""//"" Тогда ");

КонецПроцедуры

&Тест
Процедура СтрокаБезКомментарияНеМеняется() Экспорт

	Ожидаем.Что(ИсходникБезКомментариев.БезХвостовогоКомментария("Возврат Истина;"))
		.Равно("Возврат Истина;");

КонецПроцедуры
