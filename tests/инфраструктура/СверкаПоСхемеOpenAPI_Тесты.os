// Сверка ответа со схемой описания API: ловит лишнее и недостающее поле, чужой тип, null там, где его
// не обещали, значение не из перечня — иначе живой сторож схем позеленел бы вслепую.

#Использовать asserts
#Использовать "../фикстуры"

Перем Сверка;  // фикстура СверкаПоСхемеOpenAPI — со схемами образца

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	РеестрФикстур.Подключить("СверкаПоСхемеOpenAPI");
	Сверка = Новый СверкаПоСхемеOpenAPI(Компоненты());
КонецПроцедуры

&Тест
Процедура ПодходящееЗначениеРасхожденийНеДаёт() Экспорт
	Ожидаем.Что(Расхождения("{""id"":1,""name"":""a"",""tags"":[""x""],""owner"":null,""kind"":""public""}"),
		"значение по схеме").Равно("");
КонецПроцедуры

&Тест
Процедура ЛишнееПолеРасходится() Экспорт
	Ожидаем.Что(Расхождения("{""id"":1,""name"":""a"",""owner"":null,""extra"":true}"), "лишнее поле")
		.Содержит("$.extra: поля нет в схеме");
КонецПроцедуры

&Тест
Процедура НедостающееОбязательноеПолеРасходится() Экспорт
	Ожидаем.Что(Расхождения("{""id"":1,""owner"":null}"), "нет name").Содержит("нет обязательного поля name");
КонецПроцедуры

&Тест
Процедура ЧужойТипРасходится() Экспорт
	Ожидаем.Что(Расхождения("{""id"":""1"",""name"":""a"",""owner"":null}"), "строка вместо числа")
		.Содержит("$.id: ожидался тип number, пришло string");
	Ожидаем.Что(Расхождения("{""id"":1,""name"":""a"",""owner"":null,""tags"":[5]}"), "число в массиве строк")
		.Содержит("$.tags[0]: ожидался тип string");
КонецПроцедуры

&Тест
Процедура NullТолькоТамГдеОбещан() Экспорт
	Ожидаем.Что(Расхождения("{""id"":1,""name"":null,""owner"":null}"), "null в строке")
		.Содержит("$.name: ожидался тип string, пришло null");
	Ожидаем.Что(Расхождения("{""id"":1,""name"":""a"",""owner"":{""login"":""u""}}"), "объект по ссылке")
		.Равно("");
	Ожидаем.Что(Расхождения("{""id"":1,""name"":""a"",""owner"":{}}"), "ссылка сверяется")
		.Содержит("$.owner: не подходит ни один вариант anyOf");
КонецПроцедуры

&Тест
Процедура ЗначениеНеИзПеречняРасходится() Экспорт
	Ожидаем.Что(Расхождения("{""id"":1,""name"":""a"",""owner"":null,""kind"":""secret""}"), "kind")
		.Содержит("значение «secret» не из перечня");
КонецПроцедуры

&Тест
Процедура СловарьСверяетЗначения() Экспорт
	Ожидаем.Что(Расхождения("{""id"":1,""name"":""a"",""owner"":null,""params"":{""x"":1}}"), "число").Равно("");
	Ожидаем.Что(Расхождения("{""id"":1,""name"":""a"",""owner"":null,""params"":{""x"":""1""}}"), "строка")
		.Содержит("$.params.x: ожидался тип number");
КонецПроцедуры

// Сверка знает только слова, которые печатает winow: слово, для которого у неё нет проверки, — расхождение,
// а не молчаливый пропуск.
&Тест
Процедура НезнакомоеКлючевоеСловоНеПропускается() Экспорт
	Для Каждого Слово Из СтрРазделить("oneOf,pattern,format,minLength,maximum,const,propertyNames", ",") Цикл
		Схема = Новый Соответствие();
		Схема.Вставить(Слово, "x");
		Ожидаем.Что(СтрСоединить(Сверка.Расхождения(1, Схема), Символы.ПС), Слово + " сверка не понимает")
			.Содержит("не знает ключевого слова " + Слово);
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура ПустыеСвойстваЗакрываютОбъект() Экспорт
	Схема = Разобрать("{""type"":""object"",""properties"":{}}");
	Ожидаем.Что(СтрСоединить(Сверка.Расхождения(Разобрать("{""_csrf"":""x""}"), Схема), Символы.ПС), "поле в пустом")
		.Содержит("$._csrf: поля нет в схеме");
	Словарь = Разобрать("{""type"":""object""}");
	Ожидаем.Что(Сверка.Расхождения(Разобрать("{""a"":1}"), Словарь).Количество(), "объект без properties").Равно(0);
КонецПроцедуры

&Тест
Процедура СверкаЗапоминаетПройденныеСхемы() Экспорт
	Своя = Новый СверкаПоСхемеOpenAPI(Компоненты());
	Своя.Расхождения(Разобрать("{""id"":1,""name"":""a"",""owner"":null}"), Ссылка("Item"));
	Ожидаем.Что(Своя.Пройденные().Получить("Item"), "Item пройдена").ЭтоИстина();
	Ожидаем.Что(Своя.Пройденные().Получить("Owner"), "до Owner значение не дошло").Равно(Неопределено);
	Своя.Расхождения(Разобрать("{""id"":1,""name"":""a"",""owner"":{""login"":""u""}}"), Ссылка("Item"));
	Ожидаем.Что(Своя.Пройденные().Получить("Owner"), "Owner пройдена").ЭтоИстина();
КонецПроцедуры

Функция Расхождения(Знач ТекстJSON)

	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(ТекстJSON);
	Значение = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Возврат СтрСоединить(Сверка.Расхождения(Значение, Ссылка("Item")), Символы.ПС);

КонецФункции

// Схемы образца в той записи, в какой их печатает winow.
Функция Компоненты()
	Возврат Разобрать("{""Item"":{""type"":""object"",""properties"":{"
		+ """id"":{""type"":""number""},""name"":{""type"":""string""},"
		+ """tags"":{""type"":""array"",""items"":{""type"":""string""}},"
		+ """owner"":{""anyOf"":[{""$ref"":""#/components/schemas/Owner""},{""type"":""null""}]},"
		+ """kind"":{""type"":""string"",""enum"":[""public"",""private""]},"
		+ """params"":{""type"":""object"",""additionalProperties"":{""type"":""number""}}},"
		+ """required"":[""id"",""name"",""owner""],""description"":""Образец""},"
		+ """Owner"":{""type"":""object"",""properties"":{""login"":{""type"":""string""}},""required"":[""login""]}}");
КонецФункции

Функция Ссылка(Знач Имя)
	Схема = Новый Соответствие();
	Схема.Вставить("$ref", "#/components/schemas/" + Имя);
	Возврат Схема;
КонецФункции

Функция Разобрать(Знач Текст)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Текст);
	Значение = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Значение;
КонецФункции
