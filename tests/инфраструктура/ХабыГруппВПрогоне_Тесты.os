// Общие хабы групп в scripts/тесты.sh на стенде с заглушками oneunit и oscript: два вызова oneunit,
// подъём и остановка хабов между ними, хвост журнала, отказы инструмента, чужой PID.

#Использовать asserts
#Использовать "../фикстуры"

Перем Стенд;
Перем Корень;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьСтенд() Экспорт

	Стенд = УникальныеИмена.ВременныйКаталог("oshub-хабы-групп");
	Корень = ОбъединитьПути(Стенд, "дерево");

	// заглушка oneunit гоняет наборы, как ОбнаружительТестов: по &Порядок набора, затем по имени файла,
	// а не по порядку -f; печатает «вызов oneunit», «набор: <путь>», строку статистики и адреса общих
	// хабов, которые видит; вызовы считает в «счётчик-oneunit», код N-го — из «код-oneunit-N», если он есть
	ЗаписатьФайл(Стенд, "bin/oneunit", "#!/bin/sh
		|stand=""$(dirname ""$0"")/..""
		|call=$(( $(cat ""$stand/счётчик-oneunit"" 2> /dev/null || echo 0) + 1 ))
		|echo ""$call"" > ""$stand/счётчик-oneunit""
		|echo 'вызов oneunit'
		|count=$(printf '%s\n' ""$@"" | grep -c '^-f$')
		|while [ $# -gt 0 ]; do
		|	if [ ""$1"" = -f ]; then
		|		shift
		|		order=$(sed -n 's/^&Порядок(\([0-9]*\))$/\1/p' ""$1"" | head -1)
		|		printf '%s\t%s\t%s\n' ""${order:-0}"" ""$(basename ""$1"")"" ""$1""
		|	fi
		|	shift
		|done | LC_ALL=C sort -t ""$(printf '\t')"" -k1,1n -k2,2 | cut -f3 | sed 's/^/набор: /'
		|echo ""[ $count Наборов выполнено ]""
		|env | grep '^OSHUB_TEST_HUB_' | sort | sed 's/^/среда: /'
		|code=0
		|if [ -f ""$stand/код-oneunit-$call"" ]; then code=$(cat ""$stand/код-oneunit-$call""); fi
		|if [ ""$code"" -eq 0 ]; then echo 'Тестирование завершилось удачно'; fi
		|exit ""$code""
		|");
	// заглушка oscript вместо инструмента хаб-группы.os: печатает выдуманный хаб группы, вызовы
	// складывает в «вызовы» рядом с bin; STUB_NO_PORT, STUB_NO_DIR — не называет порт или каталог;
	// STUB_UP_FAIL — назвав PID, падает; STUB_PID — PID хаба; STUB_STOP_FAIL — «остановить» падает
	ЗаписатьФайл(Стенд, "bin/oscript", "#!/bin/sh
		|stand=""$(cd ""$(dirname ""$0"")/.."" && pwd)""
		|echo ""$*"" >> ""$stand/вызовы""
		|case ""$3"" in
		|	альфа) id=ALPHA; n=1 ;;
		|	бета) id=BETA; n=2 ;;
		|	*) id=UNKNOWN; n=9 ;;
		|esac
		|if [ ""$2"" = поднять ]; then
		|	echo ""переменная: OSHUB_TEST_HUB_$id""
		|	if [ -z ""${STUB_NO_PORT-}"" ]; then echo ""порт: 2000$n""; fi
		|	echo ""pid: ${STUB_PID:-4000$n}""
		|	if [ -n ""${STUB_UP_FAIL-}"" ]; then exit 1; fi
		|	if [ -z ""${STUB_NO_DIR-}"" ]; then echo ""каталог: /стенд/$3""; fi
		|	echo ""журнал: $stand/журналы/$3.журнал""
		|fi
		|if [ ""$2"" = остановить ] && [ -n ""${STUB_STOP_FAIL-}"" ]; then exit 1; fi
		|");
	ЗаписатьФайл(Стенд, "бег.sh", "stand=""$(cd ""$(dirname ""$0"")"" && pwd)""
		|export PATH=""$stand/bin:$PATH""
		|export GIT_CEILING_DIRECTORIES=""$stand""
		|exec env ""$@""
		|");
	ВыполнитьКоманду("chmod +x bin/oneunit bin/oscript", Стенд);
	ЗаписатьФайл(Стенд, "журналы/альфа.журнал", "строка журнала альфы" + Символы.ПС);
	ЗаписатьФайл(Стенд, "журналы/бета.журнал", "строка журнала беты" + Символы.ПС);

	СоздатьКаталог(ОбъединитьПути(Корень, "scripts"));
	Для Каждого Скрипт Из СтрРазделить("тесты.sh,шапка-прогона.sh", ",") Цикл
		КопироватьФайл(ОбъединитьПути(КаталогиПроекта.Корень(), "scripts", Скрипт),
			ОбъединитьПути(Корень, "scripts", Скрипт));
	КонецЦикла;
	ЗаписатьФайл(Корень, "src/модули/склад/Классы/Полка.os", "");
	ЗаписатьФайл(Корень, "tests/склад/Полка_Тесты.os", "");

	// имена наборов нарочно против порядка фаз: порядок задаёт &Порядок, а не алфавит и не -f
	ЗаписатьНабор("АУдаление", "альфа", "удаление");
	ЗаписатьНабор("БСоздание", "альфа", "");
	ЗаписатьНабор("ВЧтение", "альфа", "чтение");
	ЗаписатьНабор("ГЧтениеБеты", "бета", "чтение");
	ЗаписатьНабор("ДПустойХаб", "альфа", "пусто");
	ЗаписатьФайл(Корень, "tests/e2e/склад/ДСвойХаб_Тесты.os", "&Тег(""хаб"")" + Символы.ПС);

КонецПроцедуры

&ПослеВсех
Процедура УбратьСтенд() Экспорт
	Если Стенд <> Неопределено Тогда
		УникальныеИмена.УбратьВременное(Стенд);
	КонецЕсли;
КонецПроцедуры

&ПередКаждым
Процедура ЗабытьВызовы() Экспорт
	Для Каждого Имя Из СтрРазделить("вызовы,счётчик-oneunit,код-oneunit-1,код-oneunit-2", ",") Цикл
		Путь = ОбъединитьПути(Стенд, Имя);
		Если Новый Файл(Путь).Существует() Тогда
			УдалитьФайлы(Путь);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура НаборыГруппИдутВторымВызовомПоФазам() Экспорт

	Вызовы = ВызовыOneunit(Прогон("scripts/тесты.sh склад --e2e").Вывод);

	Ожидаем.Что(Вызовы.Количество(), "два вызова oneunit").Равно(2);
	Ожидаем.Что(СтрСоединить(Вызовы[0].Наборы, ","), "первый — наборы без группы").Равно("ДСвойХаб,Полка");
	Ожидаем.Что(Вызовы[0].Среда, "первый вызов общих хабов не видит").Не_().Содержит("OSHUB_TEST_HUB_");
	Ожидаем.Что(СтрСоединить(Вызовы[1].Наборы, ","), "второй — наборы групп: пусто, чтения, создания, удаления")
		.Равно("ДПустойХаб,ВЧтение,ГЧтениеБеты,БСоздание,АУдаление");

КонецПроцедуры

&Тест
Процедура СписокПечатаетОбаВызоваИГруппыИХабовНеПоднимает() Экспорт

	Прогон = Прогон("scripts/тесты.sh склад --e2e --список");

	Ожидаем.Что(Прогон.Вывод, "первый вызов").Содержит("== oneunit 1/2: наборы без общего хаба — 2");
	Ожидаем.Что(Прогон.Вывод, "второй вызов").Содержит("== oneunit 2/2: наборы общих хабов — 5");
	Ожидаем.Что(Прогон.Вывод, "группа альфа с фазами")
		.Содержит("== хаб.альфа: общий хаб, наборов 4, фазы: пусто 1 → чтение 1 → создание 1 → удаление 1");
	Ожидаем.Что(Прогон.Вывод, "группа бета").Содержит("== хаб.бета: общий хаб, наборов 1, фазы: пусто 0 → чтение 1");
	Ожидаем.Что(Новый Файл(ОбъединитьПути(Стенд, "вызовы")).Существует(), "список хабы не поднимает").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ХабГруппыПоднятМеждуВызовамиИПогашенПосле() Экспорт

	Вывод = Прогон("scripts/тесты.sh склад --e2e").Вывод;
	ВторойВызов = СтрНайти(Вывод, "вызов oneunit", , , 2);
	Подъём = СтрНайти(Вывод, "== хаб.альфа: порт");

	Ожидаем.Что(Вывод, "хаб группы в логе").Содержит("== хаб.альфа: порт 20001, pid 40001");
	Ожидаем.Что(Подъём > СтрНайти(Вывод, "набор: tests/склад/Полка"), "хаб поднят после первого вызова").ЭтоИстина();
	Ожидаем.Что(Подъём < ВторойВызов, "и до второго").ЭтоИстина();
	Ожидаем.Что(Вывод, "набор видит адрес хаба").Содержит("среда: OSHUB_TEST_HUB_ALPHA=http://127.0.0.1:20001");
	Ожидаем.Что(Вывод, "и его журнал").Содержит("среда: OSHUB_TEST_HUB_ALPHA_LOG=");
	Ожидаем.Что(СтрНайти(Вывод, "== хаб.альфа: остановлен, pid 40001") > ВторойВызов,
		"хаб погашен после второго вызова").ЭтоИстина();
	Ожидаем.Что(Вывод, "при удаче журнал хаба не печатается").Не_().Содержит("хаб.альфа │");
	Ожидаем.Что(Вывод, "сводка по обоим вызовам").Содержит("== СВОДКА: прогонов oneunit 2");
	Ожидаем.Что(Вывод, "строки статистики сложены").Содержит("7 Наборов выполнено");

	Вызовы = ПрочитатьФайл(ОбъединитьПути(Стенд, "вызовы"));
	Ожидаем.Что(Вызовы, "инструмент гасит хаб по PID и каталогу")
		.Содержит("tests/инструменты/хаб-группы.os остановить 40001 /стенд/альфа");
	Ожидаем.Что(Вызовы, "и хаб второй группы").Содержит("остановить 40002 /стенд/бета");

КонецПроцедуры

&Тест
Процедура УпавшийВторойВызовПечатаетХвостЖурналаХаба() Экспорт

	ЗаписатьФайл(Стенд, "код-oneunit-2", "1");
	Исполнение = Исполнить("bash ../бег.sh bash scripts/тесты.sh склад --e2e", Корень);
	Вывод = Исполнение.Вывод;

	Ожидаем.Что(Исполнение.Код, "код прогона — по обоим вызовам").Не_().Равно(0);
	Ожидаем.Что(СтрНайти(Вывод, "== oneunit 1/2: код"), "первый вызов в сводке не назван — прошёл").Равно(0);
	Ожидаем.Что(Вывод, "хвост журнала альфы").Содержит("хаб.альфа │ строка журнала альфы");
	Ожидаем.Что(Вывод, "и беты").Содержит("хаб.бета │ строка журнала беты");
	Ожидаем.Что(СтрНайти(Вывод, "хаб.альфа │") < СтрНайти(Вывод, "== хаб.альфа: остановлен"),
		"журнал — до остановки").ЭтоИстина();
	Ожидаем.Что(Вывод, "сводка называет вызов").Содержит("== oneunit 2/2: код 1");

КонецПроцедуры

&Тест
Процедура УпавшийПервыйВызовХвостаЖурналаНеПечатает() Экспорт

	ЗаписатьФайл(Стенд, "код-oneunit-1", "1");
	Исполнение = Исполнить("bash ../бег.sh bash scripts/тесты.sh склад --e2e", Корень);
	Вывод = Исполнение.Вывод;

	Ожидаем.Что(Исполнение.Код, "код прогона — по обоим вызовам").Не_().Равно(0);
	Ожидаем.Что(Вывод, "упал первый").Содержит("== oneunit 1/2: код 1");
	Ожидаем.Что(СтрНайти(Вывод, "== oneunit 2/2: код"), "второй в сводке не назван — прошёл").Равно(0);
	Ожидаем.Что(СтрНайти(Вывод, "хаб.альфа │"), "хаб группы ни при чём — его журнала нет").Равно(0);
	Ожидаем.Что(Вывод, "хаб погашен").Содержит("== хаб.альфа: остановлен, pid 40001");

КонецПроцедуры

&Тест
Процедура УнаследованныеПеременныеОбщихХабовСнимаются() Экспорт

	Вывод = Прогон("scripts/тесты.sh склад --e2e",
		"OSHUB_TEST_HUB_ALPHA=http://127.0.0.1:1 OSHUB_TEST_HUB_ZETA=http://127.0.0.1:2").Вывод;
	Вызовы = ВызовыOneunit(Вывод);

	Ожидаем.Что(Вывод, "снятие названо строкой шапки")
		.Содержит("== прогон.среда: сняты унаследованные OSHUB_TEST_HUB_ALPHA OSHUB_TEST_HUB_ZETA");
	Ожидаем.Что(СтрНайти(Вызовы[0].Среда, "OSHUB_TEST_HUB_"), "первый вызов чужих хабов не видит").Равно(0);
	Ожидаем.Что(СтрНайти(Вызовы[1].Среда, "ZETA"), "второй — тоже").Равно(0);
	Ожидаем.Что(Вызовы[1].Среда, "второй видит хаб, поднятый скриптом")
		.Содержит("OSHUB_TEST_HUB_ALPHA=http://127.0.0.1:20001");

КонецПроцедуры

&Тест
Процедура ИнструментБезКаталогаОстанавливаетХабПоPIDИПрогонПадает() Экспорт

	Исполнение = Исполнить("bash ../бег.sh STUB_NO_DIR=1 bash scripts/тесты.sh склад --e2e", Корень);

	Ожидаем.Что(Исполнение.Код, Исполнение.Вывод).Не_().Равно(0);
	Ожидаем.Что(Исполнение.Вывод, "отказ назван")
		.Содержит("== хаб.альфа: инструмент не назвал переменную, порт, pid или каталог");
	Ожидаем.Что(ВызовыOneunit(Исполнение.Вывод).Количество(), "второй вызов не шёл").Равно(1);
	Ожидаем.Что(ПрочитатьФайл(ОбъединитьПути(Стенд, "вызовы")), "хаб без каталога погашен по PID")
		.Содержит("остановить 40001");

КонецПроцедуры

&Тест
Процедура УпавшийИнструментСPIDОстанавливаетХаб() Экспорт

	Исполнение = Исполнить("bash ../бег.sh STUB_UP_FAIL=1 bash scripts/тесты.sh склад --e2e", Корень);

	Ожидаем.Что(Исполнение.Код, Исполнение.Вывод).Не_().Равно(0);
	Ожидаем.Что(Исполнение.Вывод, "отказ назван").Содержит("== хаб.альфа: не поднялся");
	Ожидаем.Что(ПрочитатьФайл(ОбъединитьПути(Стенд, "вызовы")), "хаб, о котором сказан PID, погашен")
		.Содержит("остановить 40001");

КонецПроцедуры

&Тест
Процедура ЧужойПроцессПоPIDХабаНеГасится() Экспорт

	// PID хаба достался чужому процессу: ни скрипт, ни инструмент сигнал ему не шлют
	Чужой = СоздатьПроцесс("sleep 60", , Истина);
	Чужой.Запустить();
	PID = Формат(Чужой.Идентификатор, "ЧГ=0; ЧН=0");
	Попытка
		Вывод = Исполнить(СтрШаблон("bash ../бег.sh STUB_PID=%1 STUB_STOP_FAIL=1 bash scripts/тесты.sh склад --e2e", PID),
			Корень).Вывод;
		Инструмент = Исполнить(СтрШаблон("oscript tests/инструменты/хаб-группы.os остановить %1", PID),
			КаталогиПроекта.Корень());

		Ожидаем.Что(Вывод, "скрипт не тронул").Содержит(СтрШаблон("pid %1 — не хаб этого репозитория, не тронут", PID));
		Ожидаем.Что(Инструмент.Вывод, "инструмент не тронул").Содержит(СтрШаблон("pid %1 — не хаб этого репозитория", PID));
		Ожидаем.Что(Инструмент.Код, "и сказал об этом кодом").Равно(1);
		Ожидаем.Что(Чужой.Завершен, "чужой процесс жив").ЭтоЛожь();
	Исключение
		Чужой.Завершить();
		ВызватьИсключение;
	КонецПопытки;
	Чужой.Завершить();

КонецПроцедуры

&Тест
Процедура ИнструментБезПортаОстанавливаетХабИПрогонПадает() Экспорт

	Исполнение = Исполнить("bash ../бег.sh STUB_NO_PORT=1 bash scripts/тесты.sh склад --e2e", Корень);

	Ожидаем.Что(Исполнение.Код, Исполнение.Вывод).Не_().Равно(0);
	Ожидаем.Что(Исполнение.Вывод, "отказ назван")
		.Содержит("== хаб.альфа: инструмент не назвал переменную, порт, pid или каталог");
	Ожидаем.Что(ВызовыOneunit(Исполнение.Вывод).Количество(), "второй вызов не шёл").Равно(1);
	Ожидаем.Что(ПрочитатьФайл(ОбъединитьПути(Стенд, "вызовы")), "поднятый хаб погашен")
		.Содержит("остановить 40001 /стенд/альфа");

КонецПроцедуры

&Тест
Процедура БезЖивыхНаборовХабыНеПоднимаются() Экспорт

	Прогон = Прогон("scripts/тесты.sh склад");

	Ожидаем.Что(Прогон.Вывод, "без --e2e общих хабов нет").Не_().Содержит("== хаб.");
	Ожидаем.Что(Новый Файл(ОбъединитьПути(Стенд, "вызовы")).Существует(), "инструмент не звали").ЭтоЛожь();

КонецПроцедуры

#Область Служебное

Процедура ЗаписатьНабор(Знач Имя, Знач Группа, Знач Фаза)

	Теги = СтрШаблон("&Тег(""хаб"")%1&Тег(""хаб:%2"")%1", Символы.ПС, Группа);
	Если ЗначениеЗаполнено(Фаза) Тогда
		Теги = Теги + СтрШаблон("&Тег(""фаза:%1"")%2", Фаза, Символы.ПС);
	КонецЕсли;
	Ранги = Новый Структура("пусто, чтение, создание, удаление", 0, 1, 2, 3);
	Теги = Теги + СтрШаблон("&Порядок(%1)%2", Ранги[?(ЗначениеЗаполнено(Фаза), Фаза, "создание")], Символы.ПС);

	ЗаписатьФайл(Корень, СтрШаблон("tests/e2e/склад/%1_Тесты.os", Имя), Теги);

КонецПроцедуры

Функция Прогон(Знач Команда, Знач Среда = "")

	Исполнение = Исполнить(СтрШаблон("bash ../бег.sh %1 bash %2", Среда, Команда), Корень);
	Ожидаем.Что(Исполнение.Код, Команда + ": " + Исполнение.Вывод + Исполнение.Ошибки).Равно(0);

	Возврат Исполнение;

КонецФункции

// Вызовы заглушки oneunit по порядку: короткие имена наборов в порядке прогона и видимая среда.
Функция ВызовыOneunit(Знач Вывод)

	Вызовы = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(Вывод, Символы.ПС) Цикл
		Если Строка_ = "вызов oneunit" Тогда
			Вызовы.Добавить(Новый Структура("Наборы, Среда", Новый Массив(), ""));
		ИначеЕсли СтрНачинаетсяС(Строка_, "набор: ") И Вызовы.Количество() > 0 Тогда
			Вызовы[Вызовы.ВГраница()].Наборы.Добавить(
				СтрЗаменить(Новый Файл(СокрЛП(Строка_)).ИмяБезРасширения, "_Тесты", ""));
		ИначеЕсли СтрНачинаетсяС(Строка_, "среда: ") И Вызовы.Количество() > 0 Тогда
			Вызовы[Вызовы.ВГраница()].Среда = Вызовы[Вызовы.ВГраница()].Среда + Строка_ + Символы.ПС;
		КонецЕсли;
	КонецЦикла;

	Возврат Вызовы;

КонецФункции

Функция ВыполнитьКоманду(Знач Команда, Знач Каталог)
	Исполнение = Исполнить(Команда, Каталог);
	Ожидаем.Что(Исполнение.Код, Команда + ": " + Исполнение.Вывод + Исполнение.Ошибки).Равно(0);
	Возврат Исполнение.Вывод;
КонецФункции

Функция Исполнить(Знач Команда, Знач Каталог)

	Процесс = СоздатьПроцесс(Команда, Каталог, Истина, Истина);
	Процесс.Запустить();
	Вывод = Новый Массив();
	Ошибки = Новый Массив();

	Пока НЕ Процесс.Завершен Цикл
		ДобавитьПрочитанное(Вывод, Процесс.ПотокВывода.Прочитать());
		ДобавитьПрочитанное(Ошибки, Процесс.ПотокОшибок.Прочитать());
		Приостановить(50);
	КонецЦикла;
	ДобавитьПрочитанное(Вывод, Процесс.ПотокВывода.Прочитать());
	ДобавитьПрочитанное(Ошибки, Процесс.ПотокОшибок.Прочитать());

	Возврат Новый Структура("Код, Вывод, Ошибки", Процесс.КодВозврата,
		СтрСоединить(Вывод, ""), СтрСоединить(Ошибки, ""));

КонецФункции

Функция ПрочитатьФайл(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Текст;
КонецФункции

// Поток процесса отдаёт данные один раз и пустым отвечает Неопределено.
Процедура ДобавитьПрочитанное(Куски, Знач Прочитанное)
	Если Прочитанное <> Неопределено Тогда
		Куски.Добавить(Строка(Прочитанное));
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьФайл(Знач Каталог, Знач Относительный, Знач Текст)
	Путь = ОбъединитьПути(Каталог, Относительный);
	СоздатьКаталог(Новый Файл(Путь).Путь);
	// байтами: запись текстом ставит переводы строк CRLF, и bash их не читает
	ПолучитьДвоичныеДанныеИзСтроки(Текст, "UTF-8").Записать(Путь);
КонецПроцедуры

#КонецОбласти
