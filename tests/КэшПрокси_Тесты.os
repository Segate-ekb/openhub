// Юнит-тесты кэш-политик прокси: TTL-ревалидация, негативный кэш 404, offline-фолбэк.
// Время управляется инъектируемыми часами (фикстура ЧасыРучные) — без реального Sleep.

#Использовать asserts
#Использовать "фикстуры"

Перем Кэш;
Перем Часы;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;

	КаталогProxy = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"), "прокси", "Классы");
	ПодключитьСценарий(ОбъединитьПути(КаталогProxy, "КэшИзменяемыхРесурсов.os"), "КэшИзменяемыхРесурсов");

	РеестрФикстур.Подключить("ЧасыРучные");

КонецПроцедуры

&ПередКаждым
Процедура ПересоздатьКэш() Экспорт
	Кэш = Новый КэшИзменяемыхРесурсов();
	Часы = Новый ЧасыРучные();
	Кэш.УстановитьЧасы(Часы);
КонецПроцедуры

&Тест
Процедура ПоложительнаяЗаписьУстареваетПоTTL() Экспорт

	Кэш.Сохранить("list|hub", СписокИмён("a,b,c"), """etag-1""");

	Ожидаем.Что(Кэш.СвежаяЗапись("list|hub", 100), "сразу после записи — свежая").Существует();

	Часы.Прибавить(50);
	Ожидаем.Что(Кэш.СвежаяЗапись("list|hub", 100), "возраст 50 < TTL 100 — свежая").Существует();

	Часы.Прибавить(60);
	Ожидаем.Что(Кэш.СвежаяЗапись("list|hub", 100), "возраст 110 >= TTL 100 — устарела").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура НулевойTTLВсегдаУстаревший() Экспорт
	Кэш.Сохранить("latest|hub|pkg", "1.0.0");
	Ожидаем.Что(Кэш.СвежаяЗапись("latest|hub|pkg", 0), "TTL 0 — всегда ревалидация").Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура УстаревшаяЗаписьХранитЗначениеИETagДляOffline() Экспорт

	Кэш.Сохранить("latest|hub|pkg", "2.0.0", """etag-v2""");
	Часы.Прибавить(10000); // сильно просрочили

	Ожидаем.Что(Кэш.СвежаяЗапись("latest|hub|pkg", 900), "устарела").Равно(Неопределено);

	Запись = Кэш.Запись("latest|hub|pkg");
	Ожидаем.Что(Запись, "запись сохраняется для offline").Существует();
	Ожидаем.Что(Запись.Значение, "значение доступно для offline-выдачи").Равно("2.0.0");
	Ожидаем.Что(Запись.ETag, "ETag доступен для условной ревалидации").Равно("""etag-v2""");
	Ожидаем.Что(Запись.Негатив).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура НегативныйКэшСоСвоимTTL() Экспорт

	Кэш.СохранитьНегатив("neg|hub|нет-1.0.0", 60);

	Ожидаем.Что(Кэш.НегативАктуален("neg|hub|нет-1.0.0"), "отсутствие свежо — не бьём в апстрим").ЭтоИстина();
	Ожидаем.Что(Кэш.СвежаяЗапись("neg|hub|нет-1.0.0", 60),
		"негатив не является положительной записью").Равно(Неопределено);

	Часы.Прибавить(70);
	Ожидаем.Что(Кэш.НегативАктуален("neg|hub|нет-1.0.0"),
		"срок вышел — повторная проверка апстрима").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ОтсутствующийКлюч() Экспорт
	Ожидаем.Что(Кэш.СвежаяЗапись("нет", 100)).Равно(Неопределено);
	Ожидаем.Что(Кэш.НегативАктуален("нет")).ЭтоЛожь();
	Ожидаем.Что(Кэш.Запись("нет")).Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура СбросУдаляетЗапись() Экспорт
	Кэш.Сохранить("list|hub", СписокИмён("a"));
	Кэш.Сбросить("list|hub");
	Ожидаем.Что(Кэш.Запись("list|hub")).Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура ПовторнаяЗаписьПродлеваетСвежесть() Экспорт

	Кэш.Сохранить("list|hub", СписокИмён("a"), """e""");
	Часы.Прибавить(80);
	// апстрим ответил 304 — переписываем то же значение, момент обновляется
	Кэш.Сохранить("list|hub", Кэш.Запись("list|hub").Значение, Кэш.Запись("list|hub").ETag);

	Ожидаем.Что(Кэш.СвежаяЗапись("list|hub", 100), "после продления возраст снова 0").Существует();
	Часы.Прибавить(80);
	Ожидаем.Что(Кэш.СвежаяЗапись("list|hub", 100), "с момента продления прошло 80 < 100").Существует();

КонецПроцедуры

&Тест
Процедура СистемныеЧасыПоУмолчанию() Экспорт
	БезЧасов = Новый КэшИзменяемыхРесурсов();
	БезЧасов.Сохранить("k", "v");
	Ожидаем.Что(БезЧасов.СвежаяЗапись("k", 60), "на системных часах свежая запись свежа").Существует();
КонецПроцедуры

// --- что снимается с карты, а что нет ---

// ИСТ-ВЫД-011 и ИСТ-АПСТ-005: последнее известное значение источника отдаётся, пока
// источник лежит, поэтому положительную запись не снимает ни возраст, ни соседи по карте.
&Тест
Процедура ПоложительнаяЗаписьНеСнимаетсяНикогда() Экспорт

	Кэш.Сохранить("latest|hub|pkg", "2.0.0", """etag-v2""");

	Часы.Прибавить(100000); // далеко за любой TTL источника
	Кэш.Сохранить("latest|hub|сосед", "1.0.0");
	Кэш.СохранитьНегатив("neg|hub|нет-1.0.0", 60);
	Часы.Прибавить(61);
	Кэш.СохранитьНегатив("neg|hub|нет-2.0.0", 60); // эта запись зовёт уборку

	Запись = Кэш.Запись("latest|hub|pkg");
	Ожидаем.Что(Запись, "последнее известное на месте после уборок и чужих записей").Существует();
	Ожидаем.Что(Запись.Значение, "им и отвечают, пока источник лежит").Равно("2.0.0");
	Ожидаем.Что(Запись.ETag, "ETag для условной ревалидации цел").Равно("""etag-v2""");

КонецПроцедуры

&Тест
Процедура ИстёкшийНегативСнимаетсяСКарты() Экспорт

	Кэш.СохранитьНегатив("neg|hub|нет-1.0.0", 60);

	Часы.Прибавить(61);
	Кэш.СохранитьНегатив("neg|hub|нет-2.0.0", 60);

	Ожидаем.Что(Кэш.Запись("neg|hub|нет-1.0.0"), "истёкший негатив снят, а не лежит вечно").Равно(Неопределено);
	Ожидаем.Что(Кэш.Запись("neg|hub|нет-2.0.0"), "свежий негатив на месте").Существует();

КонецПроцедуры

// Граница: в момент истечения негатив и перестаёт быть свежим, и снимается — одно правило.
&Тест
Процедура НегативСнимаетсяРовноВМоментИстечения() Экспорт

	Кэш.СохранитьНегатив("neg|hub|нет-1.0.0", 60);

	Часы.Прибавить(60);
	Ожидаем.Что(Кэш.НегативАктуален("neg|hub|нет-1.0.0"), "ровно в срок отсутствие уже не свежо").ЭтоЛожь();

	Кэш.СохранитьНегатив("neg|hub|нет-2.0.0", 60);
	Ожидаем.Что(Кэш.Запись("neg|hub|нет-1.0.0"), "ровно в срок он же и снят").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СоседСДлиннымСрокомНеПродлеваетЧужойНегатив() Экспорт

	Кэш.СохранитьНегатив("neg|быстрый|нет-1.0.0", 60);
	Кэш.СохранитьНегатив("neg|медленный|нет-1.0.0", 86400);

	Часы.Прибавить(61);
	Кэш.СохранитьНегатив("neg|быстрый|нет-2.0.0", 60);

	Ожидаем.Что(Кэш.Запись("neg|быстрый|нет-1.0.0"),
		"короткий негатив снят по своему сроку").Равно(Неопределено);
	Ожидаем.Что(Кэш.Запись("neg|медленный|нет-1.0.0"),
		"а длинный жив по своему").Существует();

КонецПроцедуры

&Тест
Процедура СвежийНегативУборкойНеТрогается() Экспорт

	Кэш.СохранитьНегатив("neg|hub|нет-1.0.0", 60);

	Часы.Прибавить(30);
	Кэш.СохранитьНегатив("neg|hub|нет-2.0.0", 1);
	Часы.Прибавить(2);
	Кэш.СохранитьНегатив("neg|hub|нет-3.0.0", 1); // уборка идёт, но первому негативу рано

	Ожидаем.Что(Кэш.НегативАктуален("neg|hub|нет-1.0.0"),
		"свежее отсутствие уборка не трогает").ЭтоИстина();
	Ожидаем.Что(Кэш.Запись("neg|hub|нет-2.0.0"),
		"и уборка при этом состоялась: истёкший сосед снят").Равно(Неопределено);

КонецПроцедуры

// Уборка идёт при любой записи в кэш: всплеск промахов обязан сойти сам, а не ждать,
// пока придёт следующий промах.
&Тест
Процедура ОбычнаяЗаписьТожеЗовётУборку() Экспорт

	Кэш.СохранитьНегатив("neg|hub|нет-1.0.0", 60);

	Часы.Прибавить(61);
	Кэш.Сохранить("list|hub", СписокИмён("a")); // не промах, а обычная положительная запись

	Ожидаем.Что(Кэш.Запись("neg|hub|нет-1.0.0"),
		"истёкший негатив снят обычной записью, а не следующим промахом").Равно(Неопределено);
	Ожидаем.Что(Кэш.Запись("list|hub"), "а сама запись на месте").Существует();

КонецПроцедуры

&Тест
Процедура НегативСНулевымСрокомНеОседает() Экспорт

	Кэш.СохранитьНегатив("neg|hub|нет-1.0.0", 0);

	Ожидаем.Что(Кэш.Запись("neg|hub|нет-1.0.0"),
		"нулевой срок негатива — хранить нечего").Равно(Неопределено);
	Ожидаем.Что(Кэш.НегативАктуален("neg|hub|нет-1.0.0"),
		"и в апстрим за ним идут как прежде").ЭтоЛожь();

КонецПроцедуры

// --- служебные ---

Функция СписокИмён(Знач ЧерезЗапятую)
	Возврат СтрРазделить(ЧерезЗапятую, ",", Ложь);
КонецФункции
