// Юнит-тесты кэш-политик прокси: TTL-ревалидация, негативный кэш 404, offline-фолбэк.
// Время управляется инъектируемыми часами (фикстура ЧасыРучные) — без реального Sleep.

#Использовать asserts
#Использовать "фикстуры"

Перем Кэш;
Перем Часы;

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;

	КаталогProxy = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"), "прокси", "Классы");
	ПодключитьСценарий(ОбъединитьПути(КаталогProxy, "КэшИзменяемыхРесурсов.os"), "КэшИзменяемыхРесурсов");

	РеестрФикстур.Подключить("ЧасыРучные");

КонецПроцедуры

&ПередКаждым
Процедура ПересоздатьКэш() Экспорт
	Кэш = Новый КэшИзменяемыхРесурсов();
	Часы = Новый ЧасыРучные();
	Кэш.УстановитьЧасы(Часы);
КонецПроцедуры

&Тест
Процедура ПоложительнаяЗаписьУстареваетПоTTL() Экспорт

	Кэш.Сохранить("list|hub", СписокИмён("a,b,c"), """etag-1""");

	Ожидаем.Что(Кэш.Актуально("list|hub", 100), "сразу после записи — актуальна").ЭтоИстина();

	Часы.Прибавить(50);
	Ожидаем.Что(Кэш.Актуально("list|hub", 100), "возраст 50 < TTL 100 — актуальна").ЭтоИстина();

	Часы.Прибавить(60);
	Ожидаем.Что(Кэш.Актуально("list|hub", 100), "возраст 110 >= TTL 100 — устарела").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура НулевойTTLВсегдаУстаревший() Экспорт
	Кэш.Сохранить("latest|hub|pkg", "1.0.0");
	Ожидаем.Что(Кэш.Актуально("latest|hub|pkg", 0), "TTL 0 — всегда ревалидация").ЭтоЛожь();
КонецПроцедуры

&Тест
Процедура УстаревшаяЗаписьХранитЗначениеИETagДляOffline() Экспорт

	Кэш.Сохранить("latest|hub|pkg", "2.0.0", """etag-v2""");
	Часы.Прибавить(10000); // сильно просрочили

	Ожидаем.Что(Кэш.Актуально("latest|hub|pkg", 900), "устарела").ЭтоЛожь();

	Запись = Кэш.Запись("latest|hub|pkg");
	Ожидаем.Что(Запись, "запись сохраняется для offline").Существует();
	Ожидаем.Что(Запись.Значение, "значение доступно для offline-выдачи").Равно("2.0.0");
	Ожидаем.Что(Запись.ETag, "ETag доступен для условной ревалидации").Равно("""etag-v2""");
	Ожидаем.Что(Запись.Негатив).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура НегативныйКэшСоСвоимTTL() Экспорт

	Кэш.СохранитьНегатив("neg|hub|нет-1.0.0");

	Ожидаем.Что(Кэш.НегативАктуален("neg|hub|нет-1.0.0", 60), "404 свеж — не бьём в апстрим").ЭтоИстина();
	Ожидаем.Что(Кэш.Актуально("neg|hub|нет-1.0.0", 60), "негатив не является положительной записью").ЭтоЛожь();

	Часы.Прибавить(70);
	Ожидаем.Что(Кэш.НегативАктуален("neg|hub|нет-1.0.0", 60), "негатив устарел — повторная проверка апстрима").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ОтсутствующийКлюч() Экспорт
	Ожидаем.Что(Кэш.Актуально("нет", 100)).ЭтоЛожь();
	Ожидаем.Что(Кэш.НегативАктуален("нет", 100)).ЭтоЛожь();
	Ожидаем.Что(Кэш.Запись("нет")).Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура СбросУдаляетЗапись() Экспорт
	Кэш.Сохранить("list|hub", СписокИмён("a"));
	Кэш.Сбросить("list|hub");
	Ожидаем.Что(Кэш.Запись("list|hub")).Равно(Неопределено);
КонецПроцедуры

&Тест
Процедура ПовторнаяЗаписьПродлеваетСвежесть() Экспорт

	Кэш.Сохранить("list|hub", СписокИмён("a"), """e""");
	Часы.Прибавить(80);
	// апстрим ответил 304 — переписываем то же значение, момент обновляется
	Кэш.Сохранить("list|hub", Кэш.Запись("list|hub").Значение, Кэш.Запись("list|hub").ETag);

	Ожидаем.Что(Кэш.Актуально("list|hub", 100), "после продления возраст снова 0").ЭтоИстина();
	Часы.Прибавить(80);
	Ожидаем.Что(Кэш.Актуально("list|hub", 100), "с момента продления прошло 80 < 100").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СистемныеЧасыПоУмолчанию() Экспорт
	БезЧасов = Новый КэшИзменяемыхРесурсов();
	БезЧасов.Сохранить("k", "v");
	Ожидаем.Что(БезЧасов.Актуально("k", 60), "на системных часах свежая запись актуальна").ЭтоИстина();
КонецПроцедуры

// --- служебные ---

Функция СписокИмён(Знач ЧерезЗапятую)
	Возврат СтрРазделить(ЧерезЗапятую, ",", Ложь);
КонецФункции
