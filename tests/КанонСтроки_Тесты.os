// Примитив основа/КанонСтроки: одна каноничная запись ключа на весь хаб. Проверяется
// значение — что записи, различающиеся регистром и обрамляющими пробелами, дают один
// ключ, а различающиеся по существу остаются разными.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем Канон;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.ПодключитьОснову(Модули);

КонецПроцедуры

&ПередКаждым
Процедура СобратьКанон() Экспорт
	Канон = Новый КанонСтроки();
КонецПроцедуры

&Тест
Процедура РегистрИОбрамляющиеПробелыКлючаНеМеняют() Экспорт

	Записи = Новый Массив();
	Записи.Добавить("latest");
	Записи.Добавить("Latest");
	Записи.Добавить("LATEST");
	Записи.Добавить("  latest  ");
	Записи.Добавить(Символы.Таб + "LaTeSt" + Символы.ПС);

	Для Каждого Запись Из Записи Цикл
		Ожидаем.Что(Канон.Канон(Запись), СтрШаблон("одна запись ключа: [%1]", Запись))
			.Равно("latest");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ВнутреннийПробелЗначимИКлючаНеСхлопывает() Экспорт

	Ожидаем.Что(Канон.Канон("два слова") = Канон.Канон("дваслова"),
		"пробел внутри — часть ключа, а не обрамление").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПустотаИНеопределеноЧитаютсяПустойСтрокой() Экспорт

	Ожидаем.Что(Канон.Канон(Неопределено), "Неопределено — пустой ключ, а не отказ").Равно("");
	Ожидаем.Что(Канон.Канон(""), "пустая строка остаётся пустой").Равно("");
	Ожидаем.Что(Канон.Канон("   "), "строка из пробелов — пустой ключ").Равно("");

КонецПроцедуры

&Тест
Процедура НестроковоеЗначениеЧитаетсяСвоейЗаписью() Экспорт

	Ожидаем.Что(Канон.Канон(42), "число называет себя записью").Равно("42");
	Ожидаем.Что(Канон.Канон(Истина), "булево называет себя записью").Равно(НРег(Строка(Истина)));

КонецПроцедуры

&Тест
Процедура КириллицаОпускаетсяВНижнийРегистр() Экспорт

	Ожидаем.Что(Канон.Канон(" Пул Разработки "), "регистр кириллицы тоже опускается")
		.Равно("пул разработки");

КонецПроцедуры
