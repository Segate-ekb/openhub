// Контракт деталек: переменные OSHUB_* превращаются провайдером ENV configor в oshub.*;
// плюс сверка ключей РеестраНастроек с параметрами &Деталька.

#Использовать asserts
#Использовать autumn

&ТестовыйНабор
&Изолированный(Уровень = "Процесс")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&Тест
Процедура ПеременнаяОкруженияПревращаетсяВДетальку() Экспорт

	УстановитьПеременнуюСреды("OSHUB_LOG_LEVEL", "Отладка");

	Поделка = Новый Поделка();

	Ожидаем.Что(Поделка.НайтиДетальку("oshub.log.level")).Равно("Отладка");

КонецПроцедуры

&Тест
Процедура ПрограммнаяДеталькаИзТочкиСборкиДоступна() Экспорт

	Детальки = Новый Соответствие();
	Детальки.Вставить("oshub.storage.root", "./данные");

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);

	Поделка = Новый Поделка(Совет);

	Ожидаем.Что(Поделка.НайтиДетальку("oshub.storage.root")).Равно("./данные");

КонецПроцедуры

&Тест
Процедура ДляНеизвестнойДеталькиВозвращаетсяУмолчание() Экспорт

	Поделка = Новый Поделка();

	Ожидаем.Что(Поделка.НайтиДетальку("oshub.нет.такой.детальки", 42)).Равно(42);

КонецПроцедуры

&Тест
Процедура РеестрНастроекНеРасходитсяСоСвоимиДетальками() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассов = ОбъединитьПути(ОбъединитьПути(КаталогПроекта, "src", "модули"),
		"настройки", "Классы");
	Путь = ОбъединитьПути(КаталогКлассов, "РеестрНастроек.os");

	Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	ИзПараметров = ИменаДеталекПараметров(Текст);
	ИзКарты = КлючиОбъявлений(Текст);

	Ожидаем.Что(ИзПараметров.Количество() > 0, "детальки в параметрах найдены").ЭтоИстина();

	Для Каждого Имя Из ИзПараметров Цикл
		Ожидаем.Что(ИзКарты.Найти(Имя) <> Неопределено,
			СтрШаблон("деталька ""%1"" объявлена параметром, но не объявлена в реестре", Имя)).ЭтоИстина();
	КонецЦикла;

	Для Каждого Имя Из ИзКарты Цикл
		Ожидаем.Что(ИзПараметров.Найти(Имя) <> Неопределено,
			СтрШаблон("ключ реестра ""%1"" не подкреплён параметром &Деталька", Имя)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

Функция ИменаДеталекПараметров(Знач Текст)

	Возврат ИменаПоМаркеру(Текст, "&Деталька(Значение = """);

КонецФункции

Функция КлючиОбъявлений(Знач Текст)

	Возврат ИменаПоМаркеру(Текст, "Объявить(""");

КонецФункции

Функция ИменаПоМаркеру(Знач Текст, Знач Маркер)

	Результат = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		Позиция = СтрНайти(Строка_, Маркер);
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Остаток = Сред(Строка_, Позиция + СтрДлина(Маркер));
		Конец = СтрНайти(Остаток, """");
		Если Конец > 1 Тогда
			Результат.Добавить(НРег(Лев(Остаток, Конец - 1)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции
