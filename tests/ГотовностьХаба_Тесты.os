// Юнит-тесты признака готовности: ГотовностьХаба, КонтроллерГотовности и линт конвенции
// гейтов готовности в продуктовых фоновых рогатках.

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем Исходники;   // фикстура ИсходникиПроекта — чтение файлов репозитория
Перем КаталогПроекта;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("ИсходникиПроекта");
	РеестрФикстур.Подключить("ФейкПулСоединений");
	РеестрФикстур.Подключить("ФейкИсточникДанных");
	РеестрФикстур.Подключить("ФейкМенеджерСущностей");
	Исходники = Новый ИсходникиПроекта();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;

	Подключить(ОбъединитьПути(КаталогПроекта, "src/модули/наблюдаемость/Классы/пробы/ГотовностьХаба.os"),
		"ГотовностьХаба");
	Подключить(ОбъединитьПути(КаталогПроекта, "src/модули/наблюдаемость/Классы/пробы/КонтроллерГотовности.os"),
		"КонтроллерГотовности");
	Подключить(ОбъединитьПути(КаталогТестов, "фикстуры/ОтветГотовности.os"), "ОтветГотовности");

	// тело пробы пишет тот же ОтветыAPI, что и остальные машинные двери
	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");
	ПоискКлассов.ПодключитьОснову(КаталогМодулей);

	// готовность к трафику складывается из гейтов старта И состояния базы
	КаталогДанных = ОбъединитьПути(КаталогМодулей, "данные", "Классы");
	ПоискКлассов.Подключить(КаталогДанных, "ПробаБазы");
	ПоискКлассов.Подключить(КаталогДанных, "ПрикладнаяНастройка");

КонецПроцедуры

&Тест
Процедура СвежийХабНеГотов() Экспорт

	Готовность = Новый ГотовностьХаба(ЛогТестов());

	Ожидаем.Что(Готовность.Готов(), "до старта хаб не готов").ЭтоЛожь();
	Ожидаем.Что(Готовность.МоментГотовности(), "момента готовности ещё нет").ЭтоНеопределено();
	Ожидаем.Что(Готовность.Состояние().СтартЗавершён,
		"реестр гейтов отдаёт факт, а не слово ответа").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура БезЗаявленныхЗадачГотовностьДаётСинхроннаяФаза() Экспорт

	Готовность = Новый ГотовностьХаба(ЛогТестов());
	Готовность.ОтметитьСтартЗавершённым();

	Ожидаем.Что(Готовность.Готов(), "нет обязательных задач — готов сразу").ЭтоИстина();
	Ожидаем.Что(Готовность.МоментГотовности(), "момент готовности зафиксирован").Существует();

КонецПроцедуры

&Тест
Процедура НезакрытыйГейтДержитХабНеГотовым() Экспорт

	Готовность = Новый ГотовностьХаба(ЛогТестов());
	Готовность.ЗаявитьЗадачу("webhooks.подписчик");
	Готовность.ЗаявитьЗадачу("audit.служба");

	Готовность.ОтметитьСтартЗавершённым();
	Ожидаем.Что(Готовность.Готов(), "синхронная фаза без задач готовности не даёт").ЭтоЛожь();

	Готовность.ОтметитьЗадачуВыполненной("audit.служба");
	Ожидаем.Что(Готовность.Готов(), "одна из двух задач — всё ещё не готов").ЭтоЛожь();
	Ожидаем.Что(СтрСоединить(Готовность.НезавершённыеЗадачи(), ","),
		"в списке ожидания остаётся именно незакрытая задача").Равно("webhooks.подписчик");

	Готовность.ОтметитьЗадачуВыполненной("webhooks.подписчик");
	Ожидаем.Что(Готовность.Готов(), "все задачи закрыты — готов").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЗакрытыеГейтыБезСинхроннойФазыГотовностиНеДают() Экспорт

	Готовность = Новый ГотовностьХаба(ЛогТестов());
	Готовность.ЗаявитьЗадачу("jobs.планировщик");
	Готовность.ОтметитьЗадачуВыполненной("jobs.планировщик");

	Ожидаем.Что(Готовность.Готов(), "порт ещё не открыт — не готов").ЭтоЛожь();

	Готовность.ОтметитьСтартЗавершённым();
	Ожидаем.Что(Готовность.Готов(), "после открытия порта — готов").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПовторнаяЗаявкаНеСбрасываетВыполненнуюЗадачу() Экспорт

	Готовность = Новый ГотовностьХаба(ЛогТестов());
	Готовность.ЗаявитьЗадачу("stats.скачивания");
	Готовность.ОтметитьЗадачуВыполненной("stats.скачивания");
	Готовность.ЗаявитьЗадачу("stats.скачивания"); // например, пересоздание желудя

	Готовность.ОтметитьСтартЗавершённым();

	Ожидаем.Что(Готовность.Готов(), "повторная заявка не должна открывать закрытый гейт").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура КонтроллерОтдаёт503ПокаХабНеГотов() Экспорт

	Готовность = Новый ГотовностьХаба(ЛогТестов());
	Готовность.ЗаявитьЗадачу("webhooks.доставщик");
	Готовность.ОтметитьСтартЗавершённым();

	Ответ = Новый ОтветГотовности();
	ДверьГотовности(ОтвечающаяБаза(), Готовность).СостояниеГотовности(Ответ);

	Ожидаем.Что(Ответ.Код, "не готов -> 503 Service Unavailable").Равно(503);
	Ожидаем.Что(СтрНачинаетсяС(НРег(Ответ.Заголовки["Content-Type"]), "application/json"),
		"тело — JSON").ЭтоИстина();

	Тело = РазобратьJSON(Ответ.ТелоТекст);
	Ожидаем.Что(Тело["status"]).Равно("starting");
	Ожидаем.Что(Тело["ready"]).ЭтоЛожь();
	Ожидаем.Что(СтрСоединить(Тело["pending"], ","),
		"оператор обязан видеть, ЧТО именно не доехало").Равно("webhooks.доставщик");

КонецПроцедуры

&Тест
Процедура КонтроллерОтдаёт200КогдаХабГотов() Экспорт

	Готовность = Новый ГотовностьХаба(ЛогТестов());
	Готовность.ЗаявитьЗадачу("audit.служба");
	Готовность.ОтметитьЗадачуВыполненной("audit.служба");
	Готовность.ОтметитьСтартЗавершённым();

	Ответ = Новый ОтветГотовности();
	ДверьГотовности(ОтвечающаяБаза(), Готовность).СостояниеГотовности(Ответ);

	Ожидаем.Что(Ответ.Код, "готов -> 200").Равно(200);

	Тело = РазобратьJSON(Ответ.ТелоТекст);
	Ожидаем.Что(Тело["status"]).Равно("ready");
	Ожидаем.Что(Тело["ready"]).ЭтоИстина();
	Ожидаем.Что(Тело["pending"].Количество(), "готовому хабу нечего ждать").Равно(0);
	Ожидаем.Что(Тело["database"]["status"], "готовность называет и состояние базы").Равно("ok");

КонецПроцедуры

#Область ГотовностьИБаза

// Балансировщик обязан вывести инстанс, у которого не отвечает база: его ответы неверны.
// Оркестратор перезапускать его не должен — перезапуск базу не лечит, а идущий обход
// зеркала убивает. Поэтому отказ по базе живёт в готовности, а не в живости.
&Тест
Процедура ГотовыйХабСМолчащейБазойОтдаёт503() Экспорт

	Готовность = Новый ГотовностьХаба(ЛогТестов());
	Готовность.ЗаявитьЗадачу("audit.служба");
	Готовность.ОтметитьЗадачуВыполненной("audit.служба");
	Готовность.ОтметитьСтартЗавершённым();

	Ответ = Новый ОтветГотовности();
	ДверьГотовности(МолчащаяБаза(), Готовность).СостояниеГотовности(Ответ);

	Ожидаем.Что(Ответ.Код, "база не отвечает -> 503").Равно(503);

	Тело = РазобратьJSON(Ответ.ТелоТекст);
	Ожидаем.Что(Тело["status"], "признак отличим от «стартую»: перезапуск тут не поможет")
		.Равно("database_unavailable");
	Ожидаем.Что(Тело["ready"], "трафик такому инстансу слать нельзя").ЭтоЛожь();
	Ожидаем.Что(Тело["database"]["status"]).Равно("unavailable");
	Ожидаем.Что(Тело["database"]["reason"], "чего именно не хватило")
		.Содержит("пул соединений исчерпан");
	Ожидаем.Что(Тело["pending"].Количество(), "стартовые гейты при этом закрыты").Равно(0);

КонецПроцедуры

// Стартующий хаб остаётся «стартую», даже если база ещё молчит: старт пройдёт сам,
// и подменять его поводом, который сам не пройдёт, значит врать оператору.
&Тест
Процедура СтартующийХабОстаётсяStartingДажеПриМолчащейБазе() Экспорт

	Готовность = Новый ГотовностьХаба(ЛогТестов());
	Готовность.ЗаявитьЗадачу("jobs.планировщик");
	Готовность.ОтметитьСтартЗавершённым();

	Ответ = Новый ОтветГотовности();
	ДверьГотовности(МолчащаяБаза(), Готовность).СостояниеГотовности(Ответ);

	Тело = РазобратьJSON(Ответ.ТелоТекст);
	Ожидаем.Что(Ответ.Код).Равно(503);
	Ожидаем.Что(Тело["status"], "незакрытый старт важнее молчащей базы").Равно("starting");
	Ожидаем.Что(СтрСоединить(Тело["pending"], ","), "и гейт по-прежнему назван")
		.Равно("jobs.планировщик");

КонецПроцедуры

#КонецОбласти

#Область ЛинтГейтовГотовности

&Тест
Процедура КаждаяФоноваяРогаткаЛибоГейтЛибоВСпискеИсключений() Экспорт

	Нарушители = Новый Массив();
	Просканировано = 0;

	Для Каждого Файл Из КлассыМодулей() Цикл

		Текст = Исходники.Текст(Файл.ПолноеИмя);
		Если НЕ ЭтоФоноваяРогатка(Текст) Тогда
			Продолжить;
		КонецЕсли;

		Просканировано = Просканировано + 1;

		Для Каждого Нарушение Из НарушенияГейта(Текст) Цикл
			Нарушители.Добавить(Файл.Имя + ": " + Нарушение);
		КонецЦикла;

	КонецЦикла;

	Ожидаем.Что(Просканировано >= 6,
		СтрШаблон("просканировано фоновых рогаток: %1", Просканировано)).ЭтоИстина();

	Ожидаем.Что(СтрСоединить(Нарушители, Символы.ПС),
		"фоновые рогатки нарушают конвенцию гейтов готовности").Равно("");

КонецПроцедуры

&Тест
Процедура ДетекторЛовитФоновуюРогаткуБезЗаявки() Экспорт

	Образец = СтрСоединить(МассивИз(
		"Процедура ПриЗапускеПриложения() Экспорт",
		"	Издатель.Подписать(Издатель.ТипВерсияОпубликована(), ЭтотОбъект);",
		"КонецПроцедуры",
		"&Рогатка",
		"Процедура ПриСозданииОбъекта(&Пластилин(Значение = ""ИздательСобытий"") _Издатель)",
		"	Издатель = _Издатель;",
		"КонецПроцедуры"), Символы.ПС);

	Ожидаем.Что(ЭтоФоноваяРогатка(Образец), "голая &Рогатка — фоновая").ЭтоИстина();
	Ожидаем.Что(ЕстьНарушениеГейта(НарушенияГейта(Образец), "не заявляет"),
		"незаявленный гейт ловится").ЭтоИстина();

	Синхронная = СтрЗаменить(Образец, "&Рогатка", "&Рогатка(ЗапускатьВФоне = Ложь)");
	Ожидаем.Что(ЭтоФоноваяРогатка(Синхронная), "синхронная рогатка — не фоновая").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ДетекторВидитДелегированиеЦиклаКаркасу() Экспорт

	Хвост = МассивИз(
		"&Рогатка",
		"Процедура ПриСозданииОбъекта(&Пластилин(Значение = ""ГотовностьХаба"") _Готовность)",
		"	Готовность = _Готовность;",
		"	Готовность.ЗаявитьЗадачу(""модуль.задача"");",
		"КонецПроцедуры");

	Отданный = СтрСоединить(Объединить(МассивИз(
		"Процедура ПриЗапускеПриложения() Экспорт",
		"	Сбой = Цикл_.Крутить(ЭтотОбъект, ""модуль.задача"");",
		"КонецПроцедуры"), Хвост), Символы.ПС);

	Ожидаем.Что(НарушенияГейта(Отданный).Количество(),
		"цикл, отданный каркасу, конвенцию не нарушает").Равно(0);

	Чужая = СтрЗаменить(Отданный, "ЭтотОбъект, ""модуль.задача""", "ЭтотОбъект, ""другой.гейт""");
	Ожидаем.Что(ЕстьНарушениеГейта(НарушенияГейта(Чужая), "не закрывается"),
		"каркас, которому назвали чужую задачу, гейт не закрывает").ЭтоИстина();

	Молчун = СтрСоединить(Объединить(МассивИз(
		"Процедура ПриЗапускеПриложения() Экспорт",
		"	Пока Истина Цикл",
		"	КонецЦикла;",
		"КонецПроцедуры"), Хвост), Символы.ПС);
	Ожидаем.Что(ЕстьНарушениеГейта(НарушенияГейта(Молчун), "не закрывается"),
		"цикл без каркаса и без закрытия гейта ловится").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДетекторЛовитЗакрытиеГейтаНеПоследнейСтрокой() Экспорт

	Хвост = МассивИз(
		"&Рогатка",
		"Процедура ПриСозданииОбъекта(&Пластилин(Значение = ""ГотовностьХаба"") _Готовность)",
		"	Готовность = _Готовность;",
		"	Готовность.ЗаявитьЗадачу(""модуль.задача"");",
		"КонецПроцедуры");

	Хороший = СтрСоединить(Объединить(МассивИз(
		"Процедура ПриЗапускеПриложения() Экспорт",
		"	Издатель.Подписать(Издатель.ТипВерсияОпубликована(), ЭтотОбъект);",
		"	Готовность.ОтметитьЗадачуВыполненной(""модуль.задача"");",
		"КонецПроцедуры"), Хвост), Символы.ПС);

	Плохой = СтрСоединить(Объединить(МассивИз(
		"Процедура ПриЗапускеПриложения() Экспорт",
		"	Готовность.ОтметитьЗадачуВыполненной(""модуль.задача"");",
		"	Издатель.Подписать(Издатель.ТипВерсияОпубликована(), ЭтотОбъект);",
		"КонецПроцедуры"), Хвост), Символы.ПС);

	СЦиклом = СтрСоединить(Объединить(МассивИз(
		"Процедура ПриЗапускеПриложения() Экспорт",
		"	Настроить();",
		"	Готовность.ОтметитьЗадачуВыполненной(""модуль.задача"");",
		"	Пока НЕ ОстановкаЗапрошена Цикл",
		"		ШагЦикла();",
		"	КонецЦикла;",
		"КонецПроцедуры"), Хвост), Символы.ПС);

	БезЗакрытия = СтрСоединить(Объединить(МассивИз(
		"Процедура ПриЗапускеПриложения() Экспорт",
		"	Издатель.Подписать(Издатель.ТипВерсияОпубликована(), ЭтотОбъект);",
		"КонецПроцедуры"), Хвост), Символы.ПС);

	Ожидаем.Что(НарушенияГейта(Хороший).Количество(),
		"закрытие последней строкой — норма").Равно(0);
	Ожидаем.Что(НарушенияГейта(СЦиклом).Количество(),
		"закрытие прямо перед вечным циклом — норма").Равно(0);
	Ожидаем.Что(ЕстьНарушениеГейта(НарушенияГейта(Плохой), "после закрытия гейта"),
		"закрытие не последней строкой ловится").ЭтоИстина();
	Ожидаем.Что(ЕстьНарушениеГейта(НарушенияГейта(БезЗакрытия), "не закрывает"),
		"заявка без закрытия ловится").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДетекторЛовитЗаявкуПослеКодаСпособногоБросить() Экспорт

	Тело = МассивИз(
		"Процедура ПриЗапускеПриложения() Экспорт",
		"	Готовность.ОтметитьЗадачуВыполненной(""модуль.задача"");",
		"КонецПроцедуры");

	Поздняя = СтрСоединить(Объединить(Тело, МассивИз(
		"&Рогатка",
		"Процедура ПриСозданииОбъекта(&Пластилин(Значение = ""ГотовностьХаба"") _Готовность)",
		"	Готовность = _Готовность;",
		"	Лог = Логирование.ПолучитьЛог(""oshub"");",
		"	Готовность.ЗаявитьЗадачу(""модуль.задача"");",
		"КонецПроцедуры")), Символы.ПС);

	Ожидаем.Что(ЕстьНарушениеГейта(НарушенияГейта(Поздняя), "до первого вызова"),
		"заявка после вызова, способного бросить, ловится").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура МногострочнаяСигнатураНеСчитаетсяВызовом() Экспорт

	Строки = МассивИз(
		"Процедура ПриЗапускеПриложения() Экспорт",
		"	Готовность.ОтметитьЗадачуВыполненной(""модуль.задача"");",
		"КонецПроцедуры",
		"&Рогатка",
		"Процедура ПриСозданииОбъекта(");
	Хвост = МассивИз(
		"	&Деталька(Значение = ""oshub.jobs.enabled"", ЗначениеПоУмолчанию = Истина) _Вкл = Неопределено,",
		"	&Пластилин(Значение = ""ГотовностьХаба"") _Готовность)",
		"	Готовность = _Готовность;",
		"	Готовность.ЗаявитьЗадачу(""модуль.задача"");",
		"КонецПроцедуры");

	Образец = СтрСоединить(Объединить(Строки, Хвост), Символы.ПС);

	Ожидаем.Что(НарушенияГейта(Образец).Количество(),
		"аннотации в многострочной сигнатуре — не вызовы").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ДетекторГейтов

// Объявлена ли в тексте класса ФОНОВАЯ рогатка (дефолт аннотации — ЗапускатьВФоне = Истина).
//
// Параметры:
//  Текст - Строка - исходный текст класса.
//
// Возвращаемое значение:
//  Булево - Истина, если рогатка объявлена и она фоновая.
//
Функция ЭтоФоноваяРогатка(Знач Текст) Экспорт

	Для Каждого Строка_ Из СтрРазделить(ИсходникБезКомментариев.БезКомментариев(Текст), Символы.ПС, Истина) Цикл
		Обрезанная = СокрЛП(Строка_);
		Если НЕ СтрНачинаетсяС(Обрезанная, "&Рогатка") Тогда
			Продолжить;
		КонецЕсли;
		Возврат СтрНайти(СтрЗаменить(НРег(Обрезанная), " ", ""), "запускатьвфоне=ложь") = 0;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Нарушения конвенции гейтов готовности в тексте класса-рогатки.
//
// Параметры:
//  Текст - Строка - исходный текст класса.
//
// Возвращаемое значение:
//  Массив из Строка - описания нарушений; пустой массив — конвенция соблюдена.
//
Функция НарушенияГейта(Знач Текст) Экспорт

	Результат = Новый Массив();

	Строки = СтрРазделить(ИсходникБезКомментариев.БезКомментариев(Текст), Символы.ПС, Истина);

	ИмяЗадачи = ИмяЗаявленнойЗадачи(Строки);
	Если НЕ ЗначениеЗаполнено(ИмяЗадачи) Тогда
		Результат.Добавить(
			"фоновая рогатка не заявляет гейт готовности (ГотовностьХаба.ЗаявитьЗадачу)"
			+ " и не перечислена в списке не-гейтов — её падение оставит хаб ""готовым""");
		Возврат Результат;
	КонецЕсли;

	Для Каждого Нарушение Из НарушенияЗаявки(Строки) Цикл
		Результат.Добавить(Нарушение);
	КонецЦикла;

	Для Каждого Нарушение Из НарушенияЗакрытия(Строки, ИмяЗадачи) Цикл
		Результат.Добавить(Нарушение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ИмяЗаявленнойЗадачи(Знач Строки)

	Для Каждого Строка_ Из Строки Цикл
		Позиция = СтрНайти(Строка_, "ЗаявитьЗадачу(""");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Хвост = Сред(Строка_, Позиция + СтрДлина("ЗаявитьЗадачу("""));
		Конец = СтрНайти(Хвост, """");
		Если Конец > 1 Тогда
			Возврат Лев(Хвост, Конец - 1);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция НарушенияЗаявки(Знач Строки)

	Результат = Новый Массив();
	ВКонструкторе = Ложь;
	ВСигнатуре = Ложь;
	Баланс = 0;
	БылВызов = Ложь;

	Для Каждого Строка_ Из Строки Цикл

		Обрезанная = СокрЛП(Строка_);

		Если СтрНачинаетсяС(Обрезанная, "Процедура ПриСозданииОбъекта") Тогда
			ВКонструкторе = Истина;
			Баланс = СкобочныйБаланс(Обрезанная);
			ВСигнатуре = Баланс > 0;
			Продолжить;
		КонецЕсли;

		Если НЕ ВКонструкторе Тогда
			Продолжить;
		КонецЕсли;

		Если ВСигнатуре Тогда
			Баланс = Баланс + СкобочныйБаланс(Обрезанная);
			ВСигнатуре = Баланс > 0;
			Продолжить;
		КонецЕсли;

		Если СтрНайти(Обрезанная, "ЗаявитьЗадачу(") > 0 Тогда
			Если БылВызов Тогда
				Результат.Добавить(
					"ЗаявитьЗадачу стоит ПОСЛЕ вызова, способного бросить: упавший"
					+ " конструктор оставит гейт незаявленным. Заявка должна идти"
					+ " до первого вызова");
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;

		Если СтрНачинаетсяС(Обрезанная, "КонецПроцедуры") Тогда
			Прервать;
		КонецЕсли;

		Если СтрНайти(Обрезанная, "(") > 0 И СтрНайти(Обрезанная, ".") > 0 Тогда
			БылВызов = Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НарушенияЗакрытия(Знач Строки, Знач ИмяЗадачи)

	Результат = Новый Массив();
	Тело = ТелоПроцедуры(Строки, "Процедура ПриЗапускеПриложения");

	Если Тело.Количество() = 0 Тогда
		Результат.Добавить("нет ПриЗапускеПриложения, а гейт заявлен");
		Возврат Результат;
	КонецЕсли;

	// Цикл, отданный каркасу ФоновыйЦикл, закрывает гейт внутри него: там же и стережётся
	// порядок «гейт — до первого шага» (ЖивучестьФоновыхРогаток_Тесты).
	Если ОтданКаркасу(Тело, ИмяЗадачи) Тогда
		Возврат Результат;
	КонецЕсли;

	ИндексЗакрытия = -1;
	Для Индекс = 0 По Тело.ВГраница() Цикл
		Если СтрНайти(Тело[Индекс], "ОтметитьЗадачуВыполненной(""" + ИмяЗадачи + """)") > 0 Тогда
			ИндексЗакрытия = Индекс;
		КонецЕсли;
	КонецЦикла;

	Если ИндексЗакрытия < 0 Тогда
		Результат.Добавить(СтрШаблон(
			"гейт ""%1"" заявлен, но не закрывается (ОтметитьЗадачуВыполненной)", ИмяЗадачи));
		Возврат Результат;
	КонецЕсли;

	Для Индекс = ИндексЗакрытия + 1 По Тело.ВГраница() Цикл

		Оператор = СокрЛП(Тело[Индекс]);

		Если СтрНачинаетсяС(Оператор, "Пока ") Тогда
			Возврат Результат;
		КонецЕсли;

		Если Оператор = "Возврат;" ИЛИ СтрНачинаетсяС(Оператор, "КонецЕсли")
			ИЛИ СтрНачинаетсяС(Оператор, "КонецПопытки") Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(СтрШаблон(
			"после закрытия гейта ""%1"" идёт оператор ""%2"": он может упасть уже"
			+ " после того, как хаб объявлен готовым", ИмяЗадачи, Оператор));
		Прервать;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Отдан ли цикл каркасу: тело просит ФоновыйЦикл крутить себя, называя ту же задачу.
Функция ОтданКаркасу(Знач Тело, Знач ИмяЗадачи)

	Для Каждого Оператор Из Тело Цикл
		Если СтрНайти(Оператор, ".Крутить(ЭтотОбъект, """ + ИмяЗадачи + """") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ТелоПроцедуры(Знач Строки, Знач Заголовок)

	Результат = Новый Массив();
	Внутри = Ложь;

	Для Каждого Строка_ Из Строки Цикл
		Обрезанная = СокрЛП(Строка_);
		Если СтрНачинаетсяС(Обрезанная, Заголовок) Тогда
			Внутри = Истина;
			Продолжить;
		КонецЕсли;
		Если НЕ Внутри Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(Обрезанная, "КонецПроцедуры") Тогда
			Прервать;
		КонецЕсли;
		Если ЗначениеЗаполнено(Обрезанная) Тогда
			Результат.Добавить(Обрезанная);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СкобочныйБаланс(Знач Строка_)

	Баланс = 0;
	Для Индекс = 1 По СтрДлина(Строка_) Цикл
		Символ = Сред(Строка_, Индекс, 1);
		Если Символ = "(" Тогда
			Баланс = Баланс + 1;
		ИначеЕсли Символ = ")" Тогда
			Баланс = Баланс - 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Баланс;

КонецФункции

// Есть ли среди нарушений хотя бы одно с заданным фрагментом текста (регистр не значим).
//
// Параметры:
//  Нарушения - Массив из Строка - описания нарушений.
//  Фрагмент - Строка - искомый фрагмент.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЕстьНарушениеГейта(Знач Нарушения, Знач Фрагмент) Экспорт
	Для Каждого Нарушение Из Нарушения Цикл
		Если СтрНайти(НРег(Нарушение), НРег(Фрагмент)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция КлассыМодулей()
	Возврат НайтиФайлы(ОбъединитьПути(КаталогПроекта, "src/модули"), "*.os", Истина);
КонецФункции

Функция МассивИз(Знач А1 = Неопределено, Знач А2 = Неопределено, Знач А3 = Неопределено,
	Знач А4 = Неопределено, Знач А5 = Неопределено, Знач А6 = Неопределено,
	Знач А7 = Неопределено)

	Результат = Новый Массив();
	Для Каждого Значение Из СписокЗначений(А1, А2, А3, А4, А5, А6, А7) Цикл
		Если Значение <> Неопределено Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СписокЗначений(Знач А1, Знач А2, Знач А3, Знач А4, Знач А5, Знач А6, Знач А7)
	Значения = Новый Массив();
	Значения.Добавить(А1);
	Значения.Добавить(А2);
	Значения.Добавить(А3);
	Значения.Добавить(А4);
	Значения.Добавить(А5);
	Значения.Добавить(А6);
	Значения.Добавить(А7);
	Возврат Значения;
КонецФункции

Функция Объединить(Знач Первый, Знач Второй)
	Результат = Новый Массив();
	Для Каждого Значение Из Первый Цикл
		Результат.Добавить(Значение);
	КонецЦикла;
	Для Каждого Значение Из Второй Цикл
		Результат.Добавить(Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

Процедура Подключить(Знач Путь, Знач Имя)
	Попытка
		ПодключитьСценарий(Путь, Имя);
	Исключение
	КонецПопытки;

КонецПроцедуры

Функция РазобратьJSON(Знач Текст)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Текст);
	Значение = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Значение;
КонецФункции

Функция ЛогТестов()
	Возврат Логирование.ПолучитьЛог("тест.oshub.старт");
КонецФункции

Функция ДверьГотовности(Знач База, Знач Готовность)

	Возврат Новый КонтроллерГотовности(Готовность, База, Новый ОтветыAPI(Новый ЗаголовкиHTTP()));

КонецФункции

// База со свободными соединениями: выборка у фейкового менеджера проходит.
Функция ОтвечающаяБаза()
	Возврат ПробаНаПуле(1, 9, 0, 10);
КонецФункции

// Пул исчерпан — ровно то, как «отвалившаяся база» выглядит на боевом хабе.
Функция МолчащаяБаза()
	Возврат ПробаНаПуле(10, 0, 5, 10);
КонецФункции

Функция ПробаНаПуле(Знач Занято, Знач Свободно, Знач Ожидают, Знач Предел)

	Пул = Новый ФейкПулСоединений(Занято, Свободно, Ожидают);
	Менеджер = Новый ФейкМенеджерСущностей(Новый ФейкИсточникДанных(Пул, Предел));

	Возврат Новый ПробаБазы(Менеджер, ЛогТестов());

КонецФункции
