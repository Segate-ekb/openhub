// Примитив основа/ФормаАдреса: общий каркас проверки формы внешнего адреса. Проверяется
// значение — какой именно вопрос назван первым. Порядок вопросов и есть то, что двери
// хаба обязаны задавать одинаково: иначе один и тот же адрес получал бы у них разные
// причины отказа.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем Форма;
Перем Коды;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.ПодключитьОснову(Модули);

КонецПроцедуры

&ПередКаждым
Процедура СобратьФорму() Экспорт
	Форма = Новый ФормаАдреса();
	Коды = Форма.Коды();
КонецПроцедуры

#Область ПорядокВопросов

&Тест
Процедура ГодныйАдресВопросовНеОставляет() Экспорт

	Разбор = Форма.Разобрать("https://хаб.example:8443/download/", "http,https");

	Ожидаем.Что(Разбор.Код, "вопросов нет").Равно(Коды.Ок);
	Ожидаем.Что(Разбор.Схема, "схема названа").Равно("https");
	Ожидаем.Что(Разбор.Хост, "хост назван").Равно("хаб.example");

КонецПроцедуры

&Тест
Процедура ПустоеЗначениеНазваноПервым() Экспорт

	Ожидаем.Что(Форма.Разобрать("", "https").Код, "пустая строка").Равно(Коды.Пусто);
	Ожидаем.Что(Форма.Разобрать("   ", "https").Код, "строка из пробелов").Равно(Коды.Пусто);
	Ожидаем.Что(Форма.Разобрать(Неопределено, "https").Код, "Неопределено").Равно(Коды.Пусто);

КонецПроцедуры

&Тест
Процедура УправляющийСимволНазванРаньшеСхемы() Экспорт

	// «ftp://a b» плох дважды; названо должно быть то, что нашли первым, — иначе
	// администратор чинит схему, а отвергает его пробел
	Разбор = Форма.Разобрать("ftp://хаб" + Символы.ВК + Символы.ПС + "X-Evil: 1", "https");

	Ожидаем.Что(Разбор.Код, "разрыв строки назван раньше чужой схемы").Равно(Коды.Управляющий);
	Ожидаем.Что(Разбор.Символ, "символ назван кодом, а не подставлен").Равно("код 13");

КонецПроцедуры

&Тест
Процедура ОтсутствиеСхемыНазваноРаньшеЕёНедопустимости() Экспорт

	Ожидаем.Что(Форма.Разобрать("хаб.example/путь", "https").Код,
		"схемы нет вовсе").Равно(Коды.СхемыНет);
	Ожидаем.Что(Форма.Разобрать("ftp://хаб.example", "https").Код,
		"схема есть, но чужая").Равно(Коды.ЧужаяСхема);

КонецПроцедуры

&Тест
Процедура ЧужаяСхемаНазванаРаньшеUserinfo() Экспорт

	Разбор = Форма.Разобрать("ftp://кто-то@хаб.example", "https");

	Ожидаем.Что(Разбор.Код, "схема судится раньше учётных данных").Равно(Коды.ЧужаяСхема);
	Ожидаем.Что(Разбор.Схема, "и названа").Равно("ftp");

КонецПроцедуры

&Тест
Процедура UserinfoНазваноРаньшеОтсутствияХоста() Экспорт

	Ожидаем.Что(Форма.Разобрать("https://кто-то@хаб.example", "https").Код,
		"user@host отвергнут").Равно(Коды.ДанныеПользователя);
	Ожидаем.Что(Форма.Разобрать("https://", "https").Код,
		"хоста нет").Равно(Коды.ХостаНет);

КонецПроцедуры

#КонецОбласти

#Область НаборСхемПринадлежитСпрашивающему

&Тест
Процедура ПустойНаборСхемСхемуНеСудит() Экспорт

	// адрес возврата судит схему сам и после хоста: у него правило другое —
	// https куда угодно либо http в петлю
	Разбор = Форма.Разобрать("ftp://хаб.example");

	Ожидаем.Что(Разбор.Код, "с пустым набором схема вопросов не вызывает").Равно(Коды.Ок);
	Ожидаем.Что(Разбор.Схема, "но названа спрашивающему").Равно("ftp");

КонецПроцедуры

&Тест
Процедура НаборСхемЧитаетсяБезУчётаРегистраИПробелов() Экспорт

	Ожидаем.Что(Форма.Разобрать("HTTP://хаб.example", " http , https ").Код,
		"схема адреса опускается в нижний регистр, набор — тоже").Равно(Коды.Ок);

КонецПроцедуры

#КонецОбласти
