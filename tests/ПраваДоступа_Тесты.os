	Доступ = Желудь("СервисПравДоступа");
	Приват = Засев.ПулСервисом(УникальныеИмена.Имя("priv"), "private");
	Публ = Засев.ПулСервисом(УникальныеИмена.Имя("pub"), "public");
	Юзер = Стенд.Учётка();

	Ожидаем.Что(Права.МожетЧитать(Неопределено, Публ), "публичный читает аноним").ЭтоИстина();
	Ожидаем.Что(Права.МожетЧитать(Неопределено, Приват), "приватный аноним не читает").ЭтоЛожь();
	Ожидаем.Что(Права.МожетЧитать(Юзер, Приват), "приватный без права не читает").ЭтоЛожь();

	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Права.ОбъектПул(Приват), Стенд.Действия(Ложь, Ложь, Ложь, Истина), 0);
	Ожидаем.Что(Права.МожетЧитать(Юзер, Приват), "право чтения открывает приватный").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура РольНаПулОтдаётИменаРолейВ1АЛегасиПресетыСвёрнуты() Экспорт

	Права = Желудь("СервисПрав");
	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("p"), "private");
	Админ = Стенд.Учётка("admin");
	Райтер = Стенд.Учётка(); Стенд.РольВПуле(Пул, Райтер.Идентификатор, "publisher");
	Читатель = Стенд.Учётка(); Стенд.РольВПуле(Пул, Читатель.Идентификатор, "reader");
	Мейнтейнер = Стенд.Учётка(); Стенд.РольВПуле(Пул, Мейнтейнер.Идентификатор, "owner");

	Ожидаем.Что(Права.РольНаПул(Админ, Пул.Идентификатор), "admin → админ хаба").Равно("админ");
	Ожидаем.Что(Права.РольНаПул(Райтер, Пул.Идентификатор), "publisher → райтер").Равно("райтер");
	Ожидаем.Что(Права.РольНаПул(Читатель, Пул.Идентификатор), "reader → читатель").Равно("читатель");
	Ожидаем.Что(Права.РольНаПул(Мейнтейнер, Пул.Идентификатор), "owner → мейнтейнер").Равно("мейнтейнер");
	Ожидаем.Что(Права.РольНаПул(Неопределено, Пул.Идентификатор), "аноним → пусто").Равно("");

КонецПроцедуры

&Тест
Процедура ПресетРолиИОбратныйРезолвВзаимноОбратны() Экспорт

	Права = Желудь("СервисПрав");

	Для Каждого ИмяРоли Из СтрРазделить("читатель,райтер,мейнтейнер", ",") Цикл
		Ожидаем.Что(Права.РольПоНабору(Права.НаборРоли(ИмяРоли)),
			СтрШаблон("пресет роли «%1» резолвится обратно в неё же", ИмяРоли)).Равно(ИмяРоли);
	КонецЦикла;

	Ожидаем.Что(Права.НаборРоли("читатель").чтение, "читатель читает").ЭтоИстина();
	Ожидаем.Что(Права.НаборРоли("читатель").изменение, "читатель не пишет").ЭтоЛожь();
	Ожидаем.Что(Права.НаборРоли("райтер").создание, "райтер создаёт вложенные").ЭтоИстина();
	Ожидаем.Что(Права.НаборРоли("райтер").удаление, "райтер не удаляет").ЭтоЛожь();
	Ожидаем.Что(Права.НаборРоли("мейнтейнер").удаление, "мейнтейнер удаляет вложенные").ЭтоИстина();

	Ожидаем.Что(Права.РольПоНабору(Стенд.Действия(Ложь, Истина, Ложь, Ложь)), "изменение без чтения — не роль").Равно("");
	Ожидаем.Что(Права.РольПоНабору(Стенд.Действия(Ложь, Ложь, Истина, Ложь)), "одно удаление — не роль").Равно("");
	Ожидаем.Что(Права.РольПоНабору(Стенд.Действия(Ложь, Ложь, Ложь, Ложь)), "пустой набор — не роль").Равно("");

	Ожидаем.Что(Права.РангРоли("владелец") > Права.РангРоли("мейнтейнер"), "владелец старше").ЭтоИстина();
	Ожидаем.Что(Права.РангРоли("мейнтейнер") > Права.РангРоли("райтер"), "мейнтейнер старше").ЭтоИстина();
	Ожидаем.Что(Права.РангРоли("райтер") > Права.РангРоли("читатель"), "райтер старше").ЭтоИстина();
	Ожидаем.Что(Права.РангРоли("owner"), "легаси owner = мейнтейнер").Равно(Права.РангРоли("мейнтейнер"));
	Ожидаем.Что(Права.РангРоли("кто-то"), "неизвестная роль — ранг 0").Равно(0);

КонецПроцедуры

&Тест
Процедура РольНаОбъектеРазличаетМейнтейнераИВладельца() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("own"), "private");
	Пакет = Засев.ПакетСервисом(Пул, УникальныеИмена.Имя("pkg"));
	Юзер = Стенд.Учётка();

	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Права.ОбъектПул(Пул),
		Права.НаборРоли("мейнтейнер"), 0);

	Ожидаем.Что(Права.РольНаОбъекте(Юзер, Права.ОбъектПул(Пул)), "полный набор на пуле → мейнтейнер").Равно("мейнтейнер");
	Ожидаем.Что(Права.РольНаОбъекте(Юзер, Права.ОбъектПакет(Пакет)), "и владелец пакета").Равно("владелец");

	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Права.ОбъектХаб(),
		Стенд.Действия(Ложь, Ложь, Истина, Ложь), 0);
	Ожидаем.Что(Права.РольНаОбъекте(Юзер, Права.ОбъектПул(Пул)), "удаление на хабе → владелец пула").Равно("владелец");

	Ожидаем.Что(Права.РольНаОбъекте(Неопределено, Права.ОбъектПул(Пул)), "аноним — роли нет").Равно("");
	Ожидаем.Что(Права.РольНаОбъекте(Стенд.Учётка("admin"), Права.ОбъектПул(Пул)), "админ хаба").Равно("админ");

КонецПроцедуры

&Тест
Процедура РайтерНеВыдаётПраваАМейнтейнерВыдаёт() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("thr"), "private");
	Райтер = Стенд.Учётка();
	Мейнтейнер = Стенд.Учётка();
	Цель = Стенд.Учётка();

	Доступ.ЗафиксироватьГрант("пользователь", Райтер.Идентификатор, Права.ОбъектПул(Пул), Права.НаборРоли("райтер"), 0);
	Доступ.ЗафиксироватьГрант("пользователь", Мейнтейнер.Идентификатор, Права.ОбъектПул(Пул), Права.НаборРоли("мейнтейнер"), 0);

	Ожидаем.Что(Доступ.МожетВыдаватьГрант(Райтер, Права.ОбъектПул(Пул)), "райтер не управляет правами").ЭтоЛожь();
	Ожидаем.Что(Доступ.МожетВыдаватьГрант(Мейнтейнер, Права.ОбъектПул(Пул)), "мейнтейнер управляет правами").ЭтоИстина();

	ОшибкаРайтера = "";
	Попытка
		Доступ.ВыдатьРоль(Райтер, "пользователь", Цель.Идентификатор, Права.ОбъектПул(Пул), "читатель");
	Исключение
		ОшибкаРайтера = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(ЗначениеЗаполнено(ОшибкаРайтера), "выдача райтером отвергнута исключением").ЭтоИстина();
	Ожидаем.Что(Права.РольНаОбъекте(Цель, Права.ОбъектПул(Пул)), "цели ничего не досталось").Равно("");

	Доступ.ВыдатьРоль(Мейнтейнер, "пользователь", Цель.Идентификатор, Права.ОбъектПул(Пул), "мейнтейнер");
	Ожидаем.Что(Права.РольНаОбъекте(Цель, Права.ОбъектПул(Пул)), "мейнтейнер выдал мейнтейнера").Равно("мейнтейнер");

	ОшибкаВладельца = "";
	Попытка
		Доступ.ВыдатьРоль(Мейнтейнер, "пользователь", Цель.Идентификатор, Права.ОбъектПул(Пул), "владелец");
	Исключение
		ОшибкаВладельца = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(ЗначениеЗаполнено(ОшибкаВладельца), "роль владельца на объекте не выдаётся").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПулОбъектаБерётсяИзСущностиАНеИзВвода() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");

	Свой = Засев.ПулСервисом(УникальныеИмена.Имя("idor-a"), "public");
	Чужой = Засев.ПулСервисом(УникальныеИмена.Имя("idor-b"), "private");
	ПакетЧужой = Засев.ПакетСервисом(Чужой, УникальныеИмена.Имя("secret"));

	Злодей = Стенд.Учётка();
	Жертва = Стенд.Учётка();
	Доступ.ЗафиксироватьГрант("пользователь", Злодей.Идентификатор, Права.ОбъектПул(Свой),
		Права.НаборРоли("мейнтейнер"), 0);

	Доступ.ВыдатьРоль(Злодей, "пользователь", Жертва.Идентификатор, Права.ОбъектПул(Свой), "читатель");
	Ожидаем.Что(Права.РольНаОбъекте(Жертва, Права.ОбъектПул(Свой)),
		"КОНТРОЛЬ: на своём пуле выдача работает").Равно("читатель");

	Подделка = Права.ОписаниеОбъекта("пакет", ПакетЧужой.Идентификатор, Свой.Идентификатор);
	Ошибка = "";
	Попытка
		Доступ.ВыдатьРоль(Злодей, "пользователь", Жертва.Идентификатор, Подделка, "мейнтейнер");
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Ошибка), "подделка объекта отвергнута исключением").ЭтоИстина();
	Ожидаем.Что(Права.РазрешеноДействие(Жертва, "изменение", Права.ОбъектПакет(ПакетЧужой)),
		"жертва не получила записи в чужой пакет").ЭтоЛожь();
	Ожидаем.Что(Доступ.НайтиГрант("пользователь", Жертва.Идентификатор, Права.ОбъектПакет(ПакетЧужой)),
		"строка права на чужой пакет не записана").Равно(Неопределено);

	Достоверный = Доступ.ДостоверныйОбъект(Подделка);
	Ожидаем.Что(Достоверный.ПулИдентификатор, "пул пакета взят из сущности").Равно(Чужой.Идентификатор);

КонецПроцедуры

