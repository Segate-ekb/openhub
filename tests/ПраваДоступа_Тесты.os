КонецПроцедуры

&Тест
Процедура ВыдачаИОтзывПравПишутСобытиеАудита() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");
	Издатель = Желудь("ИздательСобытий");

	Пул = СоздатьПул(УникальноеИмя("audit"), "private");
	Мейнтейнер = СоздатьПользователя();
	Цель = СоздатьПользователя();
	Доступ.ЗафиксироватьГрант("пользователь", Мейнтейнер.Идентификатор, Права.ОбъектПул(Пул), Права.НаборРоли("мейнтейнер"), 0);

	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель.Подписать(Издатель.ТипПраваИзменены(), Слушатель);

	Доступ.ВыдатьРоль(Мейнтейнер, "пользователь", Цель.Идентификатор, Права.ОбъектПул(Пул), "райтер");
	Выдача = Слушатель.Первое(Издатель.ТипПраваИзменены());

	Ожидаем.Что(Выдача, "событие выдачи прав опубликовано").Существует();
	Ожидаем.Что(Выдача.Данные.Действие, "действие журнала").Равно("права.выданы");
	Ожидаем.Что(Выдача.Данные.Кто, "принципал — логин выдавшего").Равно(Мейнтейнер.Логин);
	Ожидаем.Что(Выдача.Данные.Объект, "объект журнала — имя пула, а не его номер").Равно("пул/" + Пул.Имя);
	Ожидаем.Что(Выдача.Данные.Субъект, "кому выдано — отдельным полем записи").Равно("пользователь/" + Цель.Логин);
	Ожидаем.Что(СтрНайти(Выдача.Данные.ДеталиJSON, "райтер") > 0, "в деталях — роль").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Выдача.Данные.ДеталиJSON, Формат(Цель.Идентификатор, "ЧН=0; ЧГ=0")) > 0,
		"в деталях — субъект").ЭтоИстина();

	ДоОтзыва = Слушатель.Количество(Издатель.ТипПраваИзменены());
	Доступ.ОтозватьГрант(Мейнтейнер, "пользователь", Цель.Идентификатор, Права.ОбъектПул(Пул));
	Ожидаем.Что(Слушатель.Количество(Издатель.ТипПраваИзменены()) > ДоОтзыва, "отзыв тоже событие").ЭтоИстина();

	Последнее = Слушатель.События[Слушатель.События.ВГраница()];
	Ожидаем.Что(Последнее.Данные.Действие, "действие отзыва").Равно("права.отозваны");

	Доступ.ЗафиксироватьГрант("пользователь", Цель.Идентификатор, Права.ОбъектПул(Пул), Права.НаборРоли("читатель"), 0);
	Системное = Слушатель.События[Слушатель.События.ВГраница()];
	Ожидаем.Что(Системное.Данные.Кто, "системная выдача — сам хаб").Равно("система");

КонецПроцедуры

// Понижение роли записывается тем же действием «права.выданы», что и повышение: без
// прежнего состояния читатель журнала не отличит «дали мейнтейнера» от «отняли его».
&Тест
Процедура ПонижениеРолиОтличимоОтПовышенияПоПрежнемуСостоянию() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");
	Издатель = Желудь("ИздательСобытий");

	Пул = СоздатьПул(УникальноеИмя("downgrade"), "private");
	Цель = СоздатьПользователя();
	Объект = Права.ОбъектПул(Пул);

	Слушатель = Новый ЗаписывающийПодписчик();
	Издатель.Подписать(Издатель.ТипПраваИзменены(), Слушатель);

	Доступ.ЗафиксироватьГрант("пользователь", Цель.Идентификатор, Объект, Права.НаборРоли("мейнтейнер"), 0);
	Первая = Слушатель.События[Слушатель.События.ВГраница()];
	Ожидаем.Что(Детали(Первая, "роль_было"), "права не было — так и сказано").Равно("нет");
	Ожидаем.Что(Детали(Первая, "роль_стало"), "выданная роль").Равно("мейнтейнер");

	Доступ.ЗафиксироватьГрант("пользователь", Цель.Идентификатор, Объект, Права.НаборРоли("читатель"), 0);
	Вторая = Слушатель.События[Слушатель.События.ВГраница()];
	Ожидаем.Что(Вторая.Данные.Действие, "действие то же самое").Равно("права.выданы");
	Ожидаем.Что(Детали(Вторая, "роль_было"), "прежняя роль в записи — понижение видно").Равно("мейнтейнер");
	Ожидаем.Что(Детали(Вторая, "роль_стало"), "новая роль").Равно("читатель");

	Доступ.ЗафиксироватьГрант("пользователь", Цель.Идентификатор, Объект, Права.НаборРоли("мейнтейнер"), 0);
	Третья = Слушатель.События[Слушатель.События.ВГраница()];
	Ожидаем.Что(Детали(Третья, "роль_было") + "→" + Детали(Третья, "роль_стало"),
		"обратное движение читается тем же полем").Равно("читатель→мейнтейнер");

	Доступ.ЗафиксироватьГрант("пользователь", Цель.Идентификатор, Объект, Набор(Ложь, Ложь, Ложь, Ложь), 0);
	Отзыв = Слушатель.События[Слушатель.События.ВГраница()];
	Ожидаем.Что(Детали(Отзыв, "роль_было"), "снятая роль названа").Равно("мейнтейнер");
	Ожидаем.Что(Детали(Отзыв, "роль_стало"), "после отзыва роли нет").Равно("нет");

КонецПроцедуры

&Тест
Процедура ОбластиИзмененияСобираютТолькоПишущиеРоли() Экспорт

	Права = Желудь("СервисПрав");

	Читатель = СоздатьПользователя();
	Публикатор = СоздатьПользователя();
	Чужой = СоздатьПользователя();

	Пул = СоздатьПул(УникальноеИмя("scope"), "public");
	ВыдатьРоль(Пул, "пользователь", Читатель.Идентификатор, "reader");
	ВыдатьРоль(Пул, "пользователь", Публикатор.Идентификатор, "publisher");

	ОбластиЧитателя = Права.ОбластиИзменения(Читатель);
	Ожидаем.Что(ОбластиЧитателя.ВесьХаб, "reader — не админ").ЭтоЛожь();
	Ожидаем.Что(ОбластиЧитателя.Пулы.Найти(Пул.Идентификатор) = Неопределено,
		"роль reader НЕ даёт изменения — пула в областях нет").ЭтоИстина();

	ОбластиПубликатора = Права.ОбластиИзменения(Публикатор);
	Ожидаем.Что(ОбластиПубликатора.Пулы.Найти(Пул.Идентификатор) <> Неопределено,
		"роль publisher даёт изменение на весь пул").ЭтоИстина();

	Ожидаем.Что(Права.ОбластиИзменения(Чужой).Пулы.Найти(Пул.Идентификатор) = Неопределено,
		"посторонний этого пула не получает").ЭтоИстина();

	Пакет = СоздатьПакет(Пул, УникальноеИмя("scope-pkg"));
	Ожидаем.Что(Права.РазрешеноДействие(Читатель, "изменение", Права.ОбъектПакет(Пакет)),
		"reader не может изменять пакет пула").ЭтоЛожь();
	Ожидаем.Что(Права.РазрешеноДействие(Публикатор, "изменение", Права.ОбъектПакет(Пакет)),
		"publisher может").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОбластиИзмененияВидятГрантыНаХабПулИПакет() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");
	Изменение = Набор(Ложь, Истина, Ложь, Ложь);

	Хабовый = СоздатьПользователя();
	Пуловый = СоздатьПользователя();
	Пакетный = СоздатьПользователя();

	Пул = СоздатьПул(УникальноеИмя("grant"), "public");
	Пакет = СоздатьПакет(Пул, УникальноеИмя("grant-pkg"));

	Доступ.ЗафиксироватьГрант("пользователь", Хабовый.Идентификатор, Права.ОбъектХаб(), Изменение);
	Доступ.ЗафиксироватьГрант("пользователь", Пуловый.Идентификатор, Права.ОбъектПул(Пул), Изменение);
	Доступ.ЗафиксироватьГрант("пользователь", Пакетный.Идентификатор, Права.ОбъектПакет(Пакет), Изменение);

	Ожидаем.Что(Права.ОбластиИзменения(Хабовый).ВесьХаб, "грант на хаб накрывает всё").ЭтоИстина();

	ПоПулу = Права.ОбластиИзменения(Пуловый);
	Ожидаем.Что(ПоПулу.ВесьХаб, "грант на пул хабом не является").ЭтоЛожь();
	Ожидаем.Что(ПоПулу.Пулы.Найти(Пул.Идентификатор) <> Неопределено, "пул целиком").ЭтоИстина();

	ПоПакету = Права.ОбластиИзменения(Пакетный);
	Ожидаем.Что(ПоПакету.Пулы.Найти(Пул.Идентификатор) = Неопределено,
		"грант на пакет пула не открывает").ЭтоИстина();
	Ожидаем.Что(ПоПакету.Пакеты.Найти(Пакет.Идентификатор) <> Неопределено,
		"а сам пакет — открывает").ЭтоИстина();

	Пустые = Права.ОбластиИзменения(Неопределено);
	Ожидаем.Что(Пустые.ВесьХаб, "аноним не админ").ЭтоЛожь();
	Ожидаем.Что(Пустые.Пулы.Количество() + Пустые.Пакеты.Количество(),
		"и не имеет ни одной области").Равно(0);

КонецПроцедуры

&Тест
Процедура РолиСубъектаОтдаютТолькоЕгоРоли() Экспорт

	Хранилище = Желудь("ХранилищеУчастниковПула");

	Свой = СоздатьПользователя();
	Другой = СоздатьПользователя();

	ПулА = СоздатьПул(УникальноеИмя("role-a"), "public");
	ПулБ = СоздатьПул(УникальноеИмя("role-b"), "public");
	ПулВ = СоздатьПул(УникальноеИмя("role-c"), "public");

	ВыдатьРоль(ПулА, "пользователь", Свой.Идентификатор, "publisher");
	ВыдатьРоль(ПулБ, "пользователь", Свой.Идентификатор, "reader");
	ВыдатьРоль(ПулВ, "пользователь", Другой.Идентификатор, "owner");

	Найдено = Новый Соответствие();
	Для Каждого Запись Из Хранилище.РолиСубъекта("пользователь", Свой.Идентификатор) Цикл
		Найдено.Вставить(Запись.ПулИдентификатор, Запись.Роль);
	КонецЦикла;

	Ожидаем.Что(Найдено.Количество(), "ровно две записи субъекта").Равно(2);
	Ожидаем.Что(Найдено.Получить(ПулА.Идентификатор), "роль на пуле А").Равно("publisher");
	Ожидаем.Что(Найдено.Получить(ПулБ.Идентификатор), "роль на пуле Б").Равно("reader");
	Ожидаем.Что(Найдено.Получить(ПулВ.Идентификатор), "чужая роль не попала").Равно(Неопределено);

	Ожидаем.Что(Хранилище.РолиСубъекта("группа", Свой.Идентификатор).Количество(),
		"тип субъекта тоже отбирается").Равно(0);

КонецПроцедуры

// Значение поля из ДеталейJSON события прав.
Функция Детали(Знач Событие, Знач Поле)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(Событие.Данные.ДеталиJSON);
	Значение = ПрочитатьJSON(Чтение, Истина).Получить(Поле);
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

Функция Набор(Знач Создание, Знач Изменение, Знач Удаление, Знач Чтение)
	Возврат Новый Структура("создание, изменение, удаление, чтение", Создание, Изменение, Удаление, Чтение);
КонецФункции

Функция СоздатьПользователя(Знач РольХаба = "user")
	Хранилище = Желудь("ХранилищеПользователей");
	Польз = Хранилище.СоздатьЭлемент();
	Польз.Логин = УникальноеИмя("user");
	Польз.Email = Польз.Логин + "@example.com";
	Польз.Активен = Истина;
	Польз.РольХаба = РольХаба;
	Польз.Создан = ТекущаяУниверсальнаяДата();
	Польз.Сохранить();
	Возврат Польз;
КонецФункции

Функция СоздатьПул(Знач Имя, Знач Видимость)
	Возврат Желудь("СервисПулов").СоздатьПул(Имя, "custom", Видимость);
КонецФункции

Функция НайтиИлиСоздатьPublic()
	Пулы = Желудь("СервисПулов");
	Пул = Пулы.НайтиПул("public");
	Возврат ?(Пул = Неопределено, Пулы.СоздатьПул("public", "custom", "public"), Пул);
КонецФункции

Функция ОбеспечитьДефолтныйПул()
	Пулы = Желудь("СервисПулов");
	Существующий = Пулы.ДефолтныйПул();
	Если Существующий <> Неопределено Тогда
		Возврат Существующий;
	КонецЕсли;
	Возврат Пулы.НазначитьПулПоУмолчанию(
		Пулы.СоздатьПул(УникальноеИмя("hubdefault"), "custom", "public").Идентификатор, "тест");
КонецФункции

Функция СоздатьПакет(Знач Пул, Знач Имя)
	Возврат Желудь("СервисПакетов").ЗарегистрироватьПакет(Пул.Идентификатор, Имя);
КонецФункции

Процедура ВыдатьРоль(Знач Пул, Знач ТипСубъекта, Знач СубъектИд, Знач Роль)
	Хранилище = Желудь("ХранилищеУчастниковПула");
	Участник = Хранилище.СоздатьЭлемент();
	Участник.ПулИдентификатор = Пул.Идентификатор;
	Участник.ТипСубъекта = ТипСубъекта;
	Участник.СубъектИдентификатор = СубъектИд;
	Участник.Роль = Роль;
	Участник.Сохранить();
КонецПроцедуры

Функция УникальноеИмя(Знач Префикс)
	Счётчик = Счётчик + 1;
	Возврат Префикс + "-" + Формат(Счётчик, "ЧГ=0; ЧН=0");
КонецФункции

Функция Желудь(Знач Имя)
	Возврат Поделка.НайтиЖелудь(Имя);
КонецФункции

Процедура ПодключитьКаталог(Знач КаталогКлассов)
	Для Каждого ФайлКласса Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		ПодключитьФайл(ФайлКласса.ПолноеИмя);
	КонецЦикла;
КонецПроцедуры

Процедура ПодключитьФайл(Знач Путь)
	Имя = Новый Файл(Путь).ИмяБезРасширения;
	Если НЕ ТипЗарегистрирован(Имя) Тогда
		ПодключитьСценарий(Путь, Имя);
	КонецЕсли;
КонецПроцедуры

Функция ТипЗарегистрирован(Знач ИмяТипа)
	Попытка
		Проба = Тип(ИмяТипа);
		Проба = Проба;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции
