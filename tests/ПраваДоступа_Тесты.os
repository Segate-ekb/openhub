&Тест
Процедура ГрантНаПакетВыдаётсяИОтзываетсяЧерезСлужбу() Экспорт

	Права = Желудь("СервисПрав");
	Служба = Желудь("СлужбаДоступа");

	Пул = СоздатьПул(УникальноеИмя("p"), "private");
	Целевой = СоздатьПакет(Пул, УникальноеИмя("lib"));
	Соседний = СоздатьПакет(Пул, УникальноеИмя("other"));

	Owner = СоздатьПользователя(); ВыдатьРоль(Пул, "пользователь", Owner.Идентификатор, "owner");
	Мейнтейнер = СоздатьПользователя();

	Служба.ВыдатьГрант(Owner, "пользователь", Мейнтейнер.Идентификатор, "пакет", Целевой.Идентификатор,
		Набор(Ложь, Истина, Ложь, Истина));

	Ожидаем.Что(Права.РазрешеноДействие(Мейнтейнер, "изменение", Права.ОбъектПакет(Целевой)),
		"мейнтейнер правит свой пакет").ЭтоИстина();
	Ожидаем.Что(Права.РазрешеноДействие(Мейнтейнер, "чтение", Права.ОбъектПакет(Целевой)),
		"и читает его").ЭтоИстина();
	Ожидаем.Что(Права.РазрешеноДействие(Мейнтейнер, "удаление", Права.ОбъектПакет(Целевой)),
		"невыданное действие не появилось").ЭтоЛожь();
	Ожидаем.Что(Права.РазрешеноДействие(Мейнтейнер, "изменение", Права.ОбъектПакет(Соседний)),
		"соседний пакет того же пула прав не получил").ЭтоЛожь();
	Ожидаем.Что(Права.МожетАдминистрировать(Мейнтейнер, Пул),
		"пакетный грант не даёт администрирования пула").ЭтоЛожь();

	Ожидаем.Что(Служба.ОтозватьГрант(Owner, "пользователь", Мейнтейнер.Идентификатор,
		"пакет", Целевой.Идентификатор), "грант на пакет отозван").ЭтоИстина();
	Ожидаем.Что(Права.РазрешеноДействие(Мейнтейнер, "изменение", Права.ОбъектПакет(Целевой)),
		"после отзыва права нет").ЭтоЛожь();

