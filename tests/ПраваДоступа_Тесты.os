Процедура PublicИмяТребуетАдминГранта() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");
	Public = НайтиИлиСоздатьPublic();

	Юзер = СоздатьПользователя();
	ИмяПакета = УникальноеИмя("newname");

	Ожидаем.Что(Права.РазрешёнPush(Юзер, Public, ИмяПакета, "", Неопределено),
		"public: без гранта создать имя нельзя (О-4)").ЭтоЛожь();
	Ожидаем.Что(Права.РазрешёнPush(Неопределено, Public, ИмяПакета, "", Неопределено),
		"public: аноним имя не создаёт").ЭтоЛожь();

	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Права.ОбъектПул(Public), Набор(Истина, Ложь, Ложь, Ложь), 0);
	Ожидаем.Что(Права.РазрешёнPush(Юзер, Public, ИмяПакета, "", Неопределено),
		"public: с грантом создание имя можно").ЭтоИстина();

