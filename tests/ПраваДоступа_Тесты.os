// Юнит-тесты гранулярной модели прав: объединение личных и групповых грантов, пресеты ролей,
// наследование Хаб→Пул→Пакет, admin-суперправо, self-service пулов, защита от эскалации.

#Использовать asserts
#Использовать autumn
#Использовать autumn-data
#Использовать entity
#Использовать "фикстуры"

Перем ПоискКлассов;  // фикстура КлассыСлоя — файл класса ищется по имени
Перем Поделка;
Перем Засев;         // фикстура ЗасевРеестра — пул, пакет и версия: строкой либо службами хаба
Перем Стенд;         // фикстура СтендУчёток — учётка, роль на пуле, грант и ключ

&Изолированный(Уровень = "Процесс")
&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПостроитьКонтейнер() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	РеестрФикстур.Подключить("ЗасевРеестра");
	РеестрФикстур.Подключить("СтендУчёток");
	ПоискКлассов = Новый КлассыСлоя();

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "данные", "Классы"));
	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "реестр", "Классы"));

	ПоискКлассов.ПодключитьВсе(ОбъединитьПути(Модули, "события", "Классы"));

	КаталогNet = ОбъединитьПути(Модули, "сеть", "Классы");
	КаталогObs = ОбъединитьПути(Модули, "наблюдаемость", "Классы/телеметрия");
	КаталогПробХаба = ОбъединитьПути(Модули, "наблюдаемость", "Классы/пробы");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КоннекторHTTPБиблиотеки.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогNet, "КлиентHTTP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "СпанХаба.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КаталогObs, "Телеметрия.os"));

	РеестрФикстур.Подключить("ГейтАпстримов");
	ГейтАпстримовФикстура = Новый ГейтАпстримов();
	ГейтАпстримовФикстура.Подключить();

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(Модули, "аудит", "Классы"), "ИмяОбъектаАудита.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(Модули, "аудит", "Классы"), "СобытиеАудита.os"));
	// канон записи адреса: его спрашивают вёдра ограничителя входа и журнал аудита
	ПоискКлассов.ПодключитьОснову(Модули);

	КаталогВхода = ОбъединитьПути(Модули, "вход", "Классы");
	ПоискКлассов.Подключить(Модули, "СервисПрав");
	ПоискКлассов.Подключить(Модули, "УчёткаПринципала");
	ПоискКлассов.Подключить(Модули, "ВердиктГварда");
	ПоискКлассов.Подключить(Модули, "СервисГрупп");
	ПоискКлассов.Подключить(Модули, "СервисПравДоступа");
	ПоискКлассов.Подключить(Модули, "ПроверяющийGitHub");
	// СлужбаДоступа спрашивает у гварда право задать квоту при создании пула
	ПоискКлассов.Подключить(Модули, "ГвардКвотыПула");

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(Модули, "кабинет", "Классы", "СлужбаДоступа.os"));

	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогТестов, "фикстуры"), "ФейкПроверяющийGitHub.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогТестов, "фикстуры"), "ЗаписывающийПодписчик.os"));

	Детальки = Новый Соответствие();
	ИсточникДанных = Новый Соответствие();
	ИсточникДанных.Вставить("ТипКоннектора", "КоннекторInMemory");
	ИсточникДанных.Вставить("СтрокаСоединения", "права-доступа-тесты");
	Детальки.Вставить("data.ИсточникиДанных", ИсточникДанных);

	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Детальки);
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();

	Засев = Новый ЗасевРеестра(Поделка);
	Стенд = Новый СтендУчёток(Поделка);

КонецПроцедуры

&Тест
Процедура ЖелудиЗарегистрированы() Экспорт
	Для Каждого Имя Из СтрРазделить("СервисПрав,СервисПравДоступа,СлужбаДоступа,ХранилищеПравДоступа", ",") Цикл
		Ожидаем.Что(Поделка.НайтиЖелудь(Имя), СтрШаблон("желудь %1", Имя)).Существует();
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура АдминСуперправоНаВсёБезГрантов() Экспорт

	Права = Желудь("СервисПрав");
	Админ = Стенд.Учётка("admin");
	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("p"), "public");
	Пакет = Засев.ПакетСервисом(Пул, УникальныеИмена.Имя("pkg"));

	Ожидаем.Что(Права.РазрешеноДействие(Админ, "создание", Права.ОбъектХаб()), "admin создаёт пул").ЭтоИстина();
	Ожидаем.Что(Права.РазрешеноДействие(Админ, "удаление", Права.ОбъектПул(Пул)), "admin удаляет пул").ЭтоИстина();
	Ожидаем.Что(Права.РазрешеноДействие(Админ, "изменение", Права.ОбъектПакет(Пакет)), "admin меняет пакет").ЭтоИстина();
	Ожидаем.Что(Права.МожетАдминистрировать(Админ, Пул), "admin администрирует").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОбычныйЮзерБезГрантовНичегоНеМожет() Экспорт

	Права = Желудь("СервисПрав");
	Юзер = Стенд.Учётка();
	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("p"), "public");

	Ожидаем.Что(Права.РазрешеноДействие(Юзер, "создание", Права.ОбъектПул(Пул)), "нет создания").ЭтоЛожь();
	Ожидаем.Что(Права.МожетАдминистрировать(Юзер, Пул), "нет админ").ЭтоЛожь();
	Ожидаем.Что(Права.МожетСоздаватьПул(Юзер), "нет создания пула").ЭтоЛожь();
	Ожидаем.Что(Права.РазрешеноДействие(Неопределено, "создание", Права.ОбъектПул(Пул)), "аноним нет прав").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ЛичныйГрантРазграничиваетПисатьИАдминистрировать() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");
	Юзер = Стенд.Учётка();
	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("p"), "private");

	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Права.ОбъектПул(Пул),
		Стенд.Действия(Истина, Истина, Ложь, Истина), 0);
	Ожидаем.Что(Права.МожетПисать(Юзер, Пул), "создание/изменение → писать").ЭтоИстина();
	Ожидаем.Что(Права.МожетАдминистрировать(Юзер, Пул), "без удаления → не админ").ЭтоЛожь();
	Ожидаем.Что(Права.МожетЧитать(Юзер, Пул), "чтение приватного по гранту").ЭтоИстина();

	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Права.ОбъектПул(Пул),
		Стенд.Действия(Истина, Истина, Истина, Истина), 0);
	Ожидаем.Что(Права.МожетАдминистрировать(Юзер, Пул), "с удалением → админ").ЭтоИстина();

КонецПроцедуры

// Уникальность четвёрки «субъект + объект» держит ТОЛЬКО check-and-set в СервисПравДоступа: индексов проект
// не заводит, а один и тот же грант выдают и форма кабинета, и TOFU публикации, и одобрение заявки.
// Вторая строка не сломала бы чтение (НайтиГрант берёт одну), но пережила бы отзыв — доступ остался бы навсегда.
&Тест
Процедура ПовторнаяВыдачаГрантаНеСоздаётВторойСтроки() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");
	Хранилище = Желудь("ХранилищеПравДоступа");
	Юзер = Стенд.Учётка();
	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("dup"), "private");
	Объект = Права.ОбъектПул(Пул);

	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Объект, Стенд.Действия(Истина, Ложь, Ложь, Ложь), 0);
	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Объект, Стенд.Действия(Истина, Истина, Ложь, Ложь), 0);
	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Объект, Стенд.Действия(Истина, Истина, Истина, Истина), 0);

	Ожидаем.Что(Хранилище.ГрантыСубъекта("пользователь", Юзер.Идентификатор).Количество(),
		"три выдачи на один объект — одна строка гранта").Равно(1);
	Ожидаем.Что(Права.МожетАдминистрировать(Юзер, Пул), "в строке осталась ПОСЛЕДНЯЯ выдача").ЭтоИстина();

	// и отзыв обязан снимать доступ целиком: пережившая отзыв вторая строка вернула бы права
	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Объект, Стенд.Действия(Ложь, Ложь, Ложь, Ложь), 0);

	Ожидаем.Что(Хранилище.ГрантыСубъекта("пользователь", Юзер.Идентификатор).Количество(),
		"после отзыва строк гранта не осталось").Равно(0);
	Ожидаем.Что(Права.МожетЧитать(Юзер, Пул), "и доступ к приватному пулу снят").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПравоНаПулНаследуетсяПакетами() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");
	Юзер = Стенд.Учётка();
	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("p"), "private");
	Пакет = Засев.ПакетСервисом(Пул, УникальныеИмена.Имя("pkg"));

	ЧужойПул = Засев.ПулСервисом(УникальныеИмена.Имя("other"), "private");
	ЧужойПакет = Засев.ПакетСервисом(ЧужойПул, УникальныеИмена.Имя("pkg"));

	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Права.ОбъектПул(Пул),
		Стенд.Действия(Ложь, Истина, Ложь, Ложь), 0); // только изменение на пуле

	Ожидаем.Что(Права.РазрешеноДействие(Юзер, "изменение", Права.ОбъектПакет(Пакет)),
		"изменение пула наследуется пакетом").ЭтоИстина();
	Ожидаем.Что(Права.РазрешеноДействие(Юзер, "изменение", Права.ОбъектПакет(ЧужойПакет)),
		"на чужой пул права нет").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ГрантНаХабНаследуетсяВниз() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");
	Юзер = Стенд.Учётка();
	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("p"), "public");
	Пакет = Засев.ПакетСервисом(Пул, УникальныеИмена.Имя("pkg"));

	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Права.ОбъектХаб(),
		Стенд.Действия(Истина, Истина, Ложь, Ложь), 0);

	Ожидаем.Что(Права.МожетСоздаватьПул(Юзер), "хаб-создание → создаёт пулы").ЭтоИстина();

	Ожидаем.Что(Права.РазрешеноДействие(Юзер, "создание", Права.ОбъектПул(Пул)),
		"хаб-создание НЕ даёт создание имени в пуле").ЭтоЛожь();
	Ожидаем.Что(Права.РазрешеноДействие(Юзер, "создание", Права.ОбъектПакет(Пакет)),
		"хаб-создание НЕ даёт создание в пакете").ЭтоЛожь();

	Ожидаем.Что(Права.РазрешеноДействие(Юзер, "изменение", Права.ОбъектПул(Пул)),
		"хаб-изменение наследуется пулом").ЭтоИстина();
	Ожидаем.Что(Права.РазрешеноДействие(Юзер, "изменение", Права.ОбъектПакет(Пакет)),
		"хаб-изменение наследуется пакетом").ЭтоИстина();

КонецПроцедуры

// Тип объекта — часть адреса гранта, а не украшение: пул и пакет с одинаковым номером
// носят РАЗНЫЕ права, и хаб-грант не даёт на пакете того, чего не даёт по своему правилу.
// Без различения по типу сосед по номеру раздал бы свои действия чужому объекту.
&Тест
Процедура ГрантАдресуетсяТипомОбъектаАНеТолькоНомером() Экспорт

	Права = Желудь("СервисПрав");
	Юзер = Стенд.Учётка();
	Номер = 424242;

	Пул = Права.ОписаниеОбъекта("пул", Номер, Номер);
	Пакет = Права.ОписаниеОбъекта("пакет", Номер, Номер);

	// гранты кладутся СТРОКОЙ, мимо СервисаПравДоступа: он требует существующих пула
	// и пакета, а здесь нужен ровно тот случай, которого настоящими объектами не собрать
	Стенд.Грант(Юзер.Идентификатор, "пул", Номер, Стенд.Действия(Ложь, Ложь, Ложь, Истина));
	Стенд.Грант(Юзер.Идентификатор, "пакет", Номер, Стенд.Действия(Ложь, Истина, Ложь, Ложь));
	Стенд.Грант(Юзер.Идентификатор, "хаб", 0, Стенд.Действия(Истина, Ложь, Ложь, Ложь));

	Ожидаем.Что(Права.РазрешеноДействие(Юзер, "чтение", Пул),
		"на пуле действует грант пула").ЭтоИстина();
	Ожидаем.Что(Права.РазрешеноДействие(Юзер, "изменение", Пул),
		"изменение пакета на пул не распространяется").ЭтоЛожь();

	Ожидаем.Что(Права.РазрешеноДействие(Юзер, "изменение", Пакет),
		"на пакете действует грант пакета").ЭтоИстина();

	Ожидаем.Что(Права.РазрешеноДействие(Юзер, "создание", Пакет),
		"хаб-создание на пакет не попадает").ЭтоЛожь();
	Ожидаем.Что(Права.РазрешеноДействие(Юзер, "удаление", Пакет),
		"чего не выдано ни на одном уровне, того и нет").ЭтоЛожь();

КонецПроцедуры

// Снимок прав принадлежит одному человеку: вопрос о правах другого по чужому снимку —
// ошибка программиста, и отвечать на него чужими правами хуже, чем упасть.
&Тест
Процедура ЧужойСнимокПравНеОтвечаетЗаДругогоЧеловека() Экспорт

	Права = Желудь("СервисПрав");
	Свой = Стенд.Учётка();
	Чужой = Стенд.Учётка();
	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("p"), "private");

	Снимок = Права.СнимокПрав(Свой);

	Ожидаем.Что(Права.РольНаОбъекте(Свой, Права.ОбъектПул(Пул), Снимок),
		"КОНТРОЛЬ: свой снимок отвечает на вопрос о себе").Равно("");

	Отказ = "";
	Попытка
		Права.РольНаОбъекте(Чужой, Права.ОбъектПул(Пул), Снимок);
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(Отказ, "чужой снимок") > 0,
		"вопрос о другом человеке по чужому снимку падает: " + Отказ).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ХабСозданиеНеДаётИмениВPublic() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");
	Public = НайтиИлиСоздатьPublic();
	Юзер = Стенд.Учётка();

	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Права.ОбъектХаб(),
		Стенд.Действия(Истина, Ложь, Ложь, Ложь), 0);

	Ожидаем.Что(Права.МожетСоздаватьПул(Юзер), "может создавать пулы").ЭтоИстина();
	Ожидаем.Что(Права.РазрешёнPush(Юзер, Public, УникальныеИмена.Имя("hubname"), "", Неопределено),
		"но НЕ создаёт имя в public даже с хаб-созданием (О-4)").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ГрупповойГрантДаётПравоБезЛичного() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");
	Группы = Желудь("СервисГрупп");

	Юзер = Стенд.Учётка();
	Группа = Группы.СоздатьГруппу(УникальныеИмена.Имя("team"), "");
	Группы.ДобавитьУчастника(Группа.Идентификатор, Юзер.Идентификатор);

	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("p"), "private");

	Ожидаем.Что(Права.МожетПисать(Юзер, Пул), "до гранта группе — нет").ЭтоЛожь();
	Доступ.ЗафиксироватьГрант("группа", Группа.Идентификатор, Права.ОбъектПул(Пул),
		Стенд.Действия(Истина, Истина, Ложь, Ложь), 0);
	Ожидаем.Что(Права.МожетПисать(Юзер, Пул), "грант группе даёт право члену (union)").ЭтоИстина();

