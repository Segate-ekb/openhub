&Тест
Процедура НеOwnerНеВыдаётГрант() Экспорт

	Права = Желудь("СервисПрав");
	Служба = Желудь("СлужбаДоступа");
	Пул = СоздатьПул(УникальноеИмя("p"), "private");

	Publisher = СоздатьПользователя(); ВыдатьРоль(Пул, "пользователь", Publisher.Идентификатор, "publisher");
	Жертва = СоздатьПользователя();

	Поймано = Ложь;
	Попытка
		Служба.ВыдатьГрант(Publisher, "пользователь", Жертва.Идентификатор, "пул", Пул.Идентификатор,
			Набор(Истина, Истина, Истина, Ложь));
	Исключение
		Поймано = Истина;
	КонецПопытки;
	Ожидаем.Что(Поймано, "publisher не выдаёт гранты").ЭтоИстина();
	Ожидаем.Что(Права.МожетПисать(Жертва, Пул), "жертва прав не получила").ЭтоЛожь();

	Owner = СоздатьПользователя(); ВыдатьРоль(Пул, "пользователь", Owner.Идентификатор, "owner");
	Служба.ВыдатьГрант(Owner, "пользователь", Жертва.Идентификатор, "пул", Пул.Идентификатор,
		Набор(Истина, Истина, Ложь, Ложь));
	Ожидаем.Что(Права.МожетПисать(Жертва, Пул), "owner выдал — жертва пишет").ЭтоИстина();

	Служба.ОтозватьГрант(Owner, "пользователь", Жертва.Идентификатор, "пул", Пул.Идентификатор);
	Ожидаем.Что(Права.МожетПисать(Жертва, Пул), "после отзыва — нет").ЭтоЛожь();

