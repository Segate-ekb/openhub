&Тест
Процедура ЛегасиGitHubРаботаетТолькоВДефолтномПулеИПоОпцииХаба() Экспорт

	Права = Желудь("СервисПрав");
	Пулы = Желудь("СервисПулов");
	Фейк = Желудь("ПроверяющийGitHub");

	Дефолтный = ОбеспечитьДефолтныйПул();
	ИмяПакета = УникальноеИмя("ghlib");
	Токен = "gh-tok";
	Фейк.Разрешить(Токен, ИмяПакета);

	Ожидаем.Что(Права.РазрешёнPush(Неопределено, Дефолтный, ИмяПакета, Токен, Неопределено, Ложь),
		"опция хаба выключена → легаси-путь закрыт").ЭтоЛожь();

	Ожидаем.Что(Права.РазрешёнPush(Неопределено, Дефолтный, ИмяПакета, Токен, Неопределено, Истина),
		"опция включена + дефолтный пул + write-доступ → push").ЭтоИстина();

	Обычный = Пулы.СоздатьПул(УникальноеИмя("mirror"), "custom", "public");
	Пулы.УстановитьФлаг(Обычный.Идентификатор, "github_compat", Истина);
	Обычный = Пулы.ПулПоИдентификатору(Обычный.Идентификатор);
	Ожидаем.Что(Права.РазрешёнPush(Неопределено, Обычный, ИмяПакета, Токен, Неопределено, Истина),
		"легаси-путь не работает вне дефолтного пула, даже со старым флагом").ЭтоЛожь();

	Другое = УникальноеИмя("ghother");
	Ожидаем.Что(Права.РазрешёнPush(Неопределено, Дефолтный, Другое, Токен, Неопределено, Истина),
		"нет write-доступа к oscript-library/{имя} → отказ").ЭтоЛожь();

КонецПроцедуры

