&Тест
Процедура SelfServiceПулГейтитсяХабСозданием() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");
	Служба = Желудь("СлужбаДоступа");
	Юзер = СоздатьПользователя();

	Поймано = Ложь;
	Попытка
		Служба.СоздатьПул(Юзер, УникальноеИмя("deny"), "custom", "public", 0);
	Исключение
		Поймано = Истина;
	КонецПопытки;
	Ожидаем.Что(Поймано, "без хаб-создания пул не создать").ЭтоИстина();

	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Права.ОбъектХаб(), Набор(Истина, Ложь, Ложь, Ложь), 0);
	// квота не передаётся: её назначает админ хаба, а у юзера только право создания
	Пул = Служба.СоздатьПул(Юзер, УникальноеИмя("mine"), "custom", "public");
	Ожидаем.Что(Пул, "пул создан").Существует();
	Ожидаем.Что(Пул.ВладелецИдентификатор, "владелец — создатель").Равно(Юзер.Идентификатор);
	Ожидаем.Что(Права.МожетАдминистрировать(Юзер, Пул), "создатель — owner своего пула").ЭтоИстина();

