&Тест
Процедура КроссПуловыйГрантОтклонён() Экспорт

	Права = Желудь("СервисПрав");
	Служба = Желудь("СлужбаДоступа");

	ПулA = Засев.ПулСервисом(УникальныеИмена.Имя("attacker"), "private");
	Атакующий = Стенд.Учётка(); Стенд.РольВПуле(ПулA, Атакующий.Идентификатор, "owner");

	ПулB = Засев.ПулСервисом(УникальныеИмена.Имя("victim"), "private");
	ПакетB = Засев.ПакетСервисом(ПулB, УникальныеИмена.Имя("secret"));

	ПойманоПакет = Ложь;
	Попытка
		Служба.ВыдатьГрант(Атакующий, "пользователь", Атакующий.Идентификатор, "пакет", ПакетB.Идентификатор,
			Стенд.Действия(Истина, Истина, Истина, Ложь));
	Исключение
		ПойманоПакет = Истина;
	КонецПопытки;
	Ожидаем.Что(ПойманоПакет, "owner A не выдаёт грант на пакет пула B").ЭтоИстина();
	Ожидаем.Что(Права.РазрешеноДействие(Атакующий, "изменение", Права.ОбъектПакет(ПакетB)),
		"грант на чужой пакет НЕ создан").ЭтоЛожь();

	ПойманоЛегаси = Ложь;
	ПричинаЛегаси = "";
	Попытка
		Служба.ВыдатьГрант(Атакующий, "пользователь", Атакующий.Идентификатор, "группа_пакетов", ПакетB.Идентификатор,
			Стенд.Действия(Ложь, Истина, Ложь, Ложь));
	Исключение
		ПойманоЛегаси = Истина;
		ПричинаЛегаси = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(ПойманоЛегаси, "упразднённый тип объекта отвергнут").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПричинаЛегаси, "Неизвестный тип объекта") > 0,
		"отказ назван своим именем, а не «объект не найден»: " + ПричинаЛегаси).ЭтоИстина();
	Ожидаем.Что(Желудь("СервисПравДоступа").НайтиГрант("пользователь", Атакующий.Идентификатор,
			Права.ОписаниеОбъекта("группа_пакетов", ПакетB.Идентификатор, ПулB.Идентификатор)),
		"грант упразднённого типа НЕ создан").Равно(Неопределено);

	ПойманоНет = Ложь;
	ПричинаНет = "";
	Попытка
		Служба.ВыдатьГрант(Атакующий, "пользователь", Атакующий.Идентификатор, "пакет", 99999999,
			Стенд.Действия(Истина, Ложь, Ложь, Ложь));
	Исключение
		ПойманоНет = Истина;
		ПричинаНет = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(ПойманоНет, "несуществующий объект — исключение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ПричинаНет, "Объект права доступа не найден") > 0,
		"отказ по отсутствию объекта, а не по типу: " + ПричинаНет).ЭтоИстина();

