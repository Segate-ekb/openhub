&Тест
Процедура РольНаПулОтдаётИменаРолейВ1АЛегасиПресетыСвёрнуты() Экспорт

	Права = Желудь("СервисПрав");
	Пул = СоздатьПул(УникальноеИмя("p"), "private");
	Админ = СоздатьПользователя("admin");
	Райтер = СоздатьПользователя(); ВыдатьРоль(Пул, "пользователь", Райтер.Идентификатор, "publisher");
	Читатель = СоздатьПользователя(); ВыдатьРоль(Пул, "пользователь", Читатель.Идентификатор, "reader");
	Мейнтейнер = СоздатьПользователя(); ВыдатьРоль(Пул, "пользователь", Мейнтейнер.Идентификатор, "owner");

	Ожидаем.Что(Права.РольНаПул(Админ, Пул.Идентификатор), "admin → админ хаба").Равно("админ");
	Ожидаем.Что(Права.РольНаПул(Райтер, Пул.Идентификатор), "publisher → райтер").Равно("райтер");
	Ожидаем.Что(Права.РольНаПул(Читатель, Пул.Идентификатор), "reader → читатель").Равно("читатель");
	Ожидаем.Что(Права.РольНаПул(Мейнтейнер, Пул.Идентификатор), "owner → мейнтейнер").Равно("мейнтейнер");
	Ожидаем.Что(Права.РольНаПул(Неопределено, Пул.Идентификатор), "аноним → пусто").Равно("");

КонецПроцедуры

&Тест
Процедура ПресетРолиИОбратныйРезолвВзаимноОбратны() Экспорт

	Права = Желудь("СервисПрав");

	Для Каждого ИмяРоли Из СтрРазделить("читатель,райтер,мейнтейнер", ",") Цикл
		Ожидаем.Что(Права.РольПоНабору(Права.НаборРоли(ИмяРоли)),
			СтрШаблон("пресет роли «%1» резолвится обратно в неё же", ИмяРоли)).Равно(ИмяРоли);
	КонецЦикла;

	Ожидаем.Что(Права.НаборРоли("читатель").чтение, "читатель читает").ЭтоИстина();
	Ожидаем.Что(Права.НаборРоли("читатель").изменение, "читатель не пишет").ЭтоЛожь();
	Ожидаем.Что(Права.НаборРоли("райтер").создание, "райтер создаёт вложенные").ЭтоИстина();
	Ожидаем.Что(Права.НаборРоли("райтер").удаление, "райтер не удаляет").ЭтоЛожь();
	Ожидаем.Что(Права.НаборРоли("мейнтейнер").удаление, "мейнтейнер удаляет вложенные").ЭтоИстина();

	Ожидаем.Что(Права.РольПоНабору(Набор(Ложь, Истина, Ложь, Ложь)), "изменение без чтения — не роль").Равно("");
	Ожидаем.Что(Права.РольПоНабору(Набор(Ложь, Ложь, Истина, Ложь)), "одно удаление — не роль").Равно("");
	Ожидаем.Что(Права.РольПоНабору(Набор(Ложь, Ложь, Ложь, Ложь)), "пустой набор — не роль").Равно("");

	Ожидаем.Что(Права.РангРоли("владелец") > Права.РангРоли("мейнтейнер"), "владелец старше").ЭтоИстина();
	Ожидаем.Что(Права.РангРоли("мейнтейнер") > Права.РангРоли("райтер"), "мейнтейнер старше").ЭтоИстина();
	Ожидаем.Что(Права.РангРоли("райтер") > Права.РангРоли("читатель"), "райтер старше").ЭтоИстина();
	Ожидаем.Что(Права.РангРоли("owner"), "легаси owner = мейнтейнер").Равно(Права.РангРоли("мейнтейнер"));
	Ожидаем.Что(Права.РангРоли("кто-то"), "неизвестная роль — ранг 0").Равно(0);

