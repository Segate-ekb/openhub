&Тест
Процедура РольНаОбъектеРазличаетМейнтейнераИВладельца() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");

	Пул = СоздатьПул(УникальноеИмя("own"), "private");
	Пакет = СоздатьПакет(Пул, УникальноеИмя("pkg"));
	Юзер = СоздатьПользователя();

	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Права.ОбъектПул(Пул),
		Права.НаборРоли("мейнтейнер"), 0);

	Ожидаем.Что(Права.РольНаОбъекте(Юзер, Права.ОбъектПул(Пул)), "полный набор на пуле → мейнтейнер").Равно("мейнтейнер");
	Ожидаем.Что(Права.РольНаОбъекте(Юзер, Права.ОбъектПакет(Пакет)), "и владелец пакета").Равно("владелец");

	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Права.ОбъектХаб(),
		Набор(Ложь, Ложь, Истина, Ложь), 0);
	Ожидаем.Что(Права.РольНаОбъекте(Юзер, Права.ОбъектПул(Пул)), "удаление на хабе → владелец пула").Равно("владелец");

	Ожидаем.Что(Права.РольНаОбъекте(Неопределено, Права.ОбъектПул(Пул)), "аноним — роли нет").Равно("");
	Ожидаем.Что(Права.РольНаОбъекте(СоздатьПользователя("admin"), Права.ОбъектПул(Пул)), "админ хаба").Равно("админ");

КонецПроцедуры

&Тест
Процедура РайтерНеВыдаётПраваАМейнтейнерВыдаёт() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");

	Пул = СоздатьПул(УникальноеИмя("thr"), "private");
	Райтер = СоздатьПользователя();
	Мейнтейнер = СоздатьПользователя();
	Цель = СоздатьПользователя();

	Доступ.ЗафиксироватьГрант("пользователь", Райтер.Идентификатор, Права.ОбъектПул(Пул), Права.НаборРоли("райтер"), 0);
	Доступ.ЗафиксироватьГрант("пользователь", Мейнтейнер.Идентификатор, Права.ОбъектПул(Пул), Права.НаборРоли("мейнтейнер"), 0);

	Ожидаем.Что(Доступ.МожетВыдаватьГрант(Райтер, Права.ОбъектПул(Пул)), "райтер не управляет правами").ЭтоЛожь();
	Ожидаем.Что(Доступ.МожетВыдаватьГрант(Мейнтейнер, Права.ОбъектПул(Пул)), "мейнтейнер управляет правами").ЭтоИстина();

	ОшибкаРайтера = "";
	Попытка
		Доступ.ВыдатьРоль(Райтер, "пользователь", Цель.Идентификатор, Права.ОбъектПул(Пул), "читатель");
	Исключение
		ОшибкаРайтера = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(ЗначениеЗаполнено(ОшибкаРайтера), "выдача райтером отвергнута исключением").ЭтоИстина();
	Ожидаем.Что(Права.РольНаОбъекте(Цель, Права.ОбъектПул(Пул)), "цели ничего не досталось").Равно("");

	Доступ.ВыдатьРоль(Мейнтейнер, "пользователь", Цель.Идентификатор, Права.ОбъектПул(Пул), "мейнтейнер");
	Ожидаем.Что(Права.РольНаОбъекте(Цель, Права.ОбъектПул(Пул)), "мейнтейнер выдал мейнтейнера").Равно("мейнтейнер");

	ОшибкаВладельца = "";
	Попытка
		Доступ.ВыдатьРоль(Мейнтейнер, "пользователь", Цель.Идентификатор, Права.ОбъектПул(Пул), "владелец");
	Исключение
		ОшибкаВладельца = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(ЗначениеЗаполнено(ОшибкаВладельца), "роль владельца на объекте не выдаётся").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПулОбъектаБерётсяИзСущностиАНеИзВвода() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");

	Свой = СоздатьПул(УникальноеИмя("idor-a"), "public");
	Чужой = СоздатьПул(УникальноеИмя("idor-b"), "private");
	ПакетЧужой = СоздатьПакет(Чужой, УникальноеИмя("secret"));

	Злодей = СоздатьПользователя();
	Жертва = СоздатьПользователя();
	Доступ.ЗафиксироватьГрант("пользователь", Злодей.Идентификатор, Права.ОбъектПул(Свой),
		Права.НаборРоли("мейнтейнер"), 0);

	Доступ.ВыдатьРоль(Злодей, "пользователь", Жертва.Идентификатор, Права.ОбъектПул(Свой), "читатель");
	Ожидаем.Что(Права.РольНаОбъекте(Жертва, Права.ОбъектПул(Свой)),
		"КОНТРОЛЬ: на своём пуле выдача работает").Равно("читатель");

	Подделка = Права.ОписаниеОбъекта("пакет", ПакетЧужой.Идентификатор, Свой.Идентификатор);
	Ошибка = "";
	Попытка
		Доступ.ВыдатьРоль(Злодей, "пользователь", Жертва.Идентификатор, Подделка, "мейнтейнер");
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(ЗначениеЗаполнено(Ошибка), "подделка объекта отвергнута исключением").ЭтоИстина();
	Ожидаем.Что(Права.РазрешеноДействие(Жертва, "изменение", Права.ОбъектПакет(ПакетЧужой)),
		"жертва не получила записи в чужой пакет").ЭтоЛожь();
	Ожидаем.Что(Доступ.НайтиГрант("пользователь", Жертва.Идентификатор, Права.ОбъектПакет(ПакетЧужой)),
		"строка права на чужой пакет не записана").Равно(Неопределено);

	Достоверный = Доступ.ДостоверныйОбъект(Подделка);
	Ожидаем.Что(Достоверный.ПулИдентификатор, "пул пакета взят из сущности").Равно(Чужой.Идентификатор);

КонецПроцедуры

