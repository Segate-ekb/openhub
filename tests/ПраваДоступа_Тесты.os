	Ожидаем.Что(Пул.ВладелецИдентификатор, "владелец — создатель").Равно(Юзер.Идентификатор);
	Ожидаем.Что(Права.МожетАдминистрировать(Юзер, Пул), "создатель — owner своего пула").ЭтоИстина();

