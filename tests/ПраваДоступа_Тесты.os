Процедура ОбъектУпразднённогоТипаПравНеПолучает() Экспорт

	Права = Желудь("СервисПрав");
	Доступ = Желудь("СервисПравДоступа");

	Юзер = Стенд.Учётка();
	Пул = Засев.ПулСервисом(УникальныеИмена.Имя("p"), "private");
	Пакет = Засев.ПакетСервисом(Пул, УникальныеИмена.Имя("pkg"));

	Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Права.ОбъектХаб(),
		Стенд.Действия(Ложь, Истина, Истина, Истина), 0);
	Стенд.РольВПуле(Пул, Юзер.Идентификатор, "owner");

	Ожидаем.Что(Права.РазрешеноДействие(Юзер, "изменение", Права.ОбъектПакет(Пакет)),
		"пакет наследует изменение от хаба и пула").ЭтоИстина();

	Легаси = Права.ОписаниеОбъекта("группа_пакетов", Пакет.Идентификатор, Пул.Идентификатор);
	Ожидаем.Что(Права.РазрешеноДействие(Юзер, "изменение", Легаси),
		"упразднённый тип не наследует прав от хаба").ЭтоЛожь();
	Ожидаем.Что(Права.РазрешеноДействие(Юзер, "чтение", Легаси),
		"и от роли на пуле тоже не наследует").ЭтоЛожь();

	ОшибкаЗаписи = "";
	Попытка
		Доступ.ЗафиксироватьГрант("пользователь", Юзер.Идентификатор, Легаси,
			Стенд.Действия(Истина, Истина, Истина, Истина), 0);
	Исключение
		ОшибкаЗаписи = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(СтрНайти(ОшибкаЗаписи, "Неизвестный тип объекта") > 0,
		"запись права на упразднённый тип отвергнута именно как неизвестный тип").ЭтоИстина();
	Ожидаем.Что(Права.РазрешеноДействие(Юзер, "удаление", Легаси),
		"и прав такой объект не даёт").ЭтоЛожь();

