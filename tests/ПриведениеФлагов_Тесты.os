// Примитив основа/ПриведениеФлагов: пять правил чтения булева — терпимое для настроек,
// строгое по правилу OpenTelemetry, флажок HTML-формы со словом «on», трёхзначное
// (где «не сказано» отличается от «нет») и словарь окружения с английским «yes».
// Проверяется значение, и отдельно — что словарь одной двери не течёт в соседнюю:
// «on» настройкой в истину не читается, «yes» настройке незнакомо.

#Использовать asserts
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Модули;
Перем Флаги;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	Модули = ОбъединитьПути(КаталогПроекта, "src", "модули");
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьКлассы() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();

	ПоискКлассов.Подключить(ОбъединитьПути(Модули, "основа", "Классы"), "ПриведениеФлагов");

КонецПроцедуры

&ПередКаждым
Процедура СобратьФлаги() Экспорт
	Флаги = Новый ПриведениеФлагов();
КонецПроцедуры

&Тест
Процедура ФлагИстинаЗнаетЧетыреСловаИстины() Экспорт

	Для Каждого Слово Из СтрРазделить("истина,true,1,да,ИСТИНА,True,ДА", ",") Цикл
		Ожидаем.Что(Флаги.ФлагИстина(Слово, Ложь), СтрШаблон("«%1» — истина", Слово)).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(Флаги.ФлагИстина(Истина, Ложь), "настоящее Булево проходит как есть").ЭтоИстина();
	Ожидаем.Что(Флаги.ФлагИстина(Ложь, Истина), "Ложь дефолтом не перебивается").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ФлагИстинаНеЗнаетОнИСчитаетЕгоНепонятным() Экспорт

	// «on» шлёт флажок HTML-формы; в теле JSON-запроса это обычная строка, и превращать
	// её в Истину значило бы менять смысл публичного API и деталек окружения
	Ожидаем.Что(Флаги.ФлагИстина("on", Ложь), "«on» настройкой в истину не читается").ЭтоЛожь();
	Ожидаем.Что(Флаги.ФлагИстина("ON", Ложь), "и в верхнем регистре тоже").ЭтоЛожь();
	Ожидаем.Что(Флаги.ФлагИстина("on", Истина),
		"непустое непонятное — Ложь, а не дефолт: «мусор» не значит «как по умолчанию»")
		.ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ПустоеЗначениеОтдаётДефолт() Экспорт

	Ожидаем.Что(Флаги.ФлагИстина(Неопределено, Истина), "Неопределено — дефолт").ЭтоИстина();
	Ожидаем.Что(Флаги.ФлагИстина("", Истина), "пустая строка — дефолт").ЭтоИстина();
	Ожидаем.Что(Флаги.ФлагИстина("   ", Истина), "пробелы — дефолт").ЭтоИстина();
	Ожидаем.Что(Флаги.ФлагИстина("мусор", Истина), "непустое непонятное дефолта не берёт")
		.ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ФлагТолькоTrueЧитаетПоПравилуOpenTelemetry() Экспорт

	Ожидаем.Что(Флаги.ФлагТолькоTrue("true"), "«true» — истина").ЭтоИстина();
	Ожидаем.Что(Флаги.ФлагТолькоTrue("TRUE"), "регистр не значим").ЭтоИстина();
	Ожидаем.Что(Флаги.ФлагТолькоTrue("1"), "единица истиной для каркаса не является").ЭтоЛожь();
	Ожидаем.Что(Флаги.ФлагТолькоTrue("да"), "русское слово тоже нет").ЭтоЛожь();
	Ожидаем.Что(Флаги.ФлагТолькоTrue("on"), "и «on» тоже нет").ЭтоЛожь();

КонецПроцедуры

// Флажок HTML-формы: отмеченный флажок браузер присылает словом «on». Каталог пакетов
// читает его этим правилом — и продолжает понимать «1», которым помечает свои же ссылки.
&Тест
Процедура ФлажокФормыПонимаетСловоБраузера() Экспорт

	Ожидаем.Что(Флаги.ФлажокФормы("on"), "«on» — отмеченный флажок").ЭтоИстина();
	Ожидаем.Что(Флаги.ФлажокФормы("ON"), "регистр не значим").ЭтоИстина();
	Ожидаем.Что(Флаги.ФлажокФормы("1"), "«1» — тоже отметка").ЭтоИстина();
	Ожидаем.Что(Флаги.ФлажокФормы("true"), "«true» — тоже отметка").ЭтоИстина();
	Ожидаем.Что(Флаги.ФлажокФормы("да"), "«да» — тоже отметка").ЭтоИстина();

КонецПроцедуры

// Неотмеченный флажок браузер не присылает вовсе: отсутствие поля — это Ложь, а не дефолт.
&Тест
Процедура НеотмеченныйФлажокФормыЭтоЛожь() Экспорт

	Ожидаем.Что(Флаги.ФлажокФормы(Неопределено), "поля нет — не отмечен").ЭтоЛожь();
	Ожидаем.Что(Флаги.ФлажокФормы(""), "пустое — не отмечен").ЭтоЛожь();
	Ожидаем.Что(Флаги.ФлажокФормы("off"), "«off» — не отмечен").ЭтоЛожь();
	Ожидаем.Что(Флаги.ФлажокФормы("мусор"), "непонятное — не отмечен").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТрёхзначныйФлагОтличаетНеСказаноОтНет() Экспорт

	Для Каждого Слово Из СтрРазделить("истина,true,1,да,ИСТИНА,True", ",") Цикл
		Ожидаем.Что(Флаги.ФлагТрёхзначный(Слово), СтрШаблон("«%1» — да", Слово)).ЭтоИстина();
	КонецЦикла;

	Для Каждого Слово Из СтрРазделить("ложь,false,0,нет,ЛОЖЬ,False", ",") Цикл
		Ожидаем.Что(Флаги.ФлагТрёхзначный(Слово), СтрШаблон("«%1» — нет", Слово)).ЭтоЛожь();
	КонецЦикла;

	Ожидаем.Что(Флаги.ФлагТрёхзначный(Истина), "настоящее Булево проходит как есть").ЭтоИстина();
	Ожидаем.Что(Флаги.ФлагТрёхзначный(Ложь), "и Ложь тоже").ЭтоЛожь();

	Для Каждого Слово Из СтрРазделить("мусор|2|on|off|| ", "|") Цикл
		Ожидаем.Что(Флаги.ФлагТрёхзначный(Слово),
			СтрШаблон("«%1» — не сказано", Слово)).Равно(Неопределено);
	КонецЦикла;
	Ожидаем.Что(Флаги.ФлагТрёхзначный(Неопределено), "и Неопределено тоже").Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура ФлагОкруженияЗнаетYesАФлагНастройкиНет() Экспорт

	Ожидаем.Что(Флаги.ФлагОкружения("yes", Ложь), "«yes» в env — истина").ЭтоИстина();
	Ожидаем.Что(Флаги.ФлагОкружения("YES", Ложь), "регистр не значим").ЭтоИстина();
	Ожидаем.Что(Флаги.ФлагОкружения("true", Ложь), "слова настройки тоже работают").ЭтоИстина();
	Ожидаем.Что(Флаги.ФлагОкружения("", Истина), "пустое берёт дефолт").ЭтоИстина();
	Ожидаем.Что(Флаги.ФлагОкружения("мусор", Истина),
		"непустое непонятное — Ложь, а не дефолт").ЭтоЛожь();

	// разница вокабуляров объявлена: настройка про «yes» не знает и знать не должна,
	// иначе тело JSON-запроса начало бы читаться иначе, чем читалось
	Ожидаем.Что(Флаги.ФлагИстина("yes", Ложь), "у настройки «yes» истиной не является").ЭтоЛожь();

КонецПроцедуры
