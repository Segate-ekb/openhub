// Живые сторожа страницы пакета: она говорит о ТОЙ версии, которую человек получит
// по `opm install <имя>`. Публикация для этого не нужна — версию меняют смена канала
// по умолчанию и отзыв, и вместе с ней меняются README и состав зависимостей.

#Использовать asserts
#Использовать ospx-tools
#Использовать "фикстуры"

Перем Хаб;            // фикстура ЭкземплярХаба — порт, процесс, готовность, остановка
Перем Порт;
Перем КореньДанных;
Перем ТокенАдмина;
Перем ИмяПула;

&ТестовыйНабор(Характер = "Одиночка")
&Тег("хаб")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПоднятьХаб() Экспорт

	РеестрФикстур.Подключить("ЭкземплярХаба");
	// фикстура сборки .ospx (в контейнер не входит — регистрируем в процессе теста)
	РеестрФикстур.Подключить("ФикстураПакета");

	Хаб = Новый ЭкземплярХаба(90);
	КореньДанных = Хаб.ФайловаяБаза("openhub-канал");
	Хаб.Среда("OSHUB_ADMIN_LOGIN", "root");
	Хаб.Среда("OSHUB_ADMIN_PASSWORD", "RootPassw0rd");

	Хаб.Запустить();     // свободный порт + процесс + ожидание /health
	Порт = Хаб.Порт();

	ТокенАдмина = ВыпуститьТокен(ДождатьсяВхода("root", "RootPassw0rd"));

	ИмяПула = "channels";
	Ответ = POSTJsonТокеном("/api/v1/pools",
		СтрШаблон("{""имя"":""%1"",""тип"":""custom"",""видимость"":""public""}", ИмяПула),
		ТокенАдмина);
	Ожидаем.Что(Ответ.КодСостояния = 201 ИЛИ Ответ.КодСостояния = 409,
		"пул для сторожей создан: " + ТелоОтвета(Ответ)).ЭтоИстина();

КонецПроцедуры

&ПослеВсех
Процедура ОстановитьХаб() Экспорт
	Если Хаб <> Неопределено Тогда
		Хаб.Остановить();
	КонецЕсли;
КонецПроцедуры

// Канал по умолчанию переключают, ничего не публикуя, — и страница обязана переехать
// на README той версии, которую теперь отдаёт установка без версии.
&Тест
Процедура СменаКаналаПоУмолчаниюМеняетОписаниеБезПубликации() Экспорт

	Имя = "chreadme";
	Опубликовать(Имя, "1.0.0", "# МаркерСтарой");
	Опубликовать(Имя, "2.0.0", "# МаркерНовой");

	Ожидаем.Что(РезолвВерсии(Имя), "КОНТРОЛЬ: без спецификации установка берёт старшую").Равно("2.0.0");
	Описание = ВкладкаОписания(Имя);
	Ожидаем.Что(СтрНайти(Описание, "МаркерНовой") > 0,
		"КОНТРОЛЬ: и страница показывает её README").ЭтоИстина();

	НазначитьКаналомПоУмолчанию(Имя, "lts", "1.0.0");

	Ожидаем.Что(РезолвВерсии(Имя), "установка без версии уехала на канал по умолчанию").Равно("1.0.0");
	Описание = ВкладкаОписания(Имя);
	Ожидаем.Что(СтрНайти(Описание, "МаркерСтарой") > 0,
		"страница показывает README версии канала — публиковать для этого нечего").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Описание, "МаркерНовой"),
		"README прежней версии со страницы ушёл").Равно(0);

КонецПроцедуры

// Отзыв — второй способ сменить показанное описание без публикации: отозванную версию
// установка без версии не берёт, значит и страница о ней больше не говорит.
&Тест
Процедура ОтзывВерсииМеняетОписаниеНаСтранице() Экспорт

	Имя = "yankreadme";
	Опубликовать(Имя, "1.0.0", "# МаркерПервой");
	Опубликовать(Имя, "1.1.0", "# МаркерВторой");

	Ожидаем.Что(СтрНайти(ВкладкаОписания(Имя), "МаркерВторой") > 0,
		"КОНТРОЛЬ: до отзыва показан README старшей версии").ЭтоИстина();

	Отозвать(Имя, "1.1.0", Истина);

	Описание = ВкладкаОписания(Имя);
	Ожидаем.Что(СтрНайти(Описание, "МаркерПервой") > 0,
		"отзыв увёл страницу на версию, которая резолвится теперь").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Описание, "МаркерВторой"),
		"README отозванной версии со страницы ушёл").Равно(0);

	// возврат тем же путём всё возвращает: иначе сторож зеленел бы на застрявшей странице
	Отозвать(Имя, "1.1.0", Ложь);
	Ожидаем.Что(СтрНайти(ВкладкаОписания(Имя), "МаркерВторой") > 0,
		"снятый отзыв вернул страницу на старшую версию").ЭтоИстина();

КонецПроцедуры

// Состав «зависит от» — записи реестра той же версии, о которой говорит страница:
// распаковывать .ospx на показе не нужно, а вот версию брать надо ту самую.
&Тест
Процедура СменаКаналаМеняетСоставЗависимостейНаВкладке() Экспорт

	Имя = "chdeps";
	ОпубликоватьСЗависимостью(Имя, "1.0.0", "depalpha");
	ОпубликоватьСЗависимостью(Имя, "2.0.0", "depbeta");

	Зависимости = ВкладкаЗависимостей(Имя);
	Ожидаем.Что(СтрНайти(Зависимости, "depbeta") > 0,
		"КОНТРОЛЬ: показан состав старшей версии").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Зависимости, "depalpha"),
		"КОНТРОЛЬ: и только он").Равно(0);

	НазначитьКаналомПоУмолчанию(Имя, "lts", "1.0.0");

	Зависимости = ВкладкаЗависимостей(Имя);
	Ожидаем.Что(СтрНайти(Зависимости, "depalpha") > 0,
		"вкладка зависимостей переехала вместе с каналом по умолчанию").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Зависимости, "depbeta"),
		"состав прежней версии со вкладки ушёл").Равно(0);

КонецПроцедуры

// Машинный адрес описания отвечает о ТОЙ ЖЕ версии, что и страница: две двери к одному
// README, разошедшиеся на смене канала, — это два разных ответа на один вопрос.
&Тест
Процедура АдресREADMEИдётЗаКаналомПоУмолчанию() Экспорт

	Имя = "apireadme";
	Опубликовать(Имя, "1.0.0", "# МаркерAPIСтарой");
	Опубликовать(Имя, "2.0.0", "# МаркерAPIНовой");

	ДоСмены = READMEАдресом(Имя);
	Ожидаем.Что(ДоСмены.Получить("version"), "КОНТРОЛЬ: адрес называет старшую версию").Равно("2.0.0");
	Ожидаем.Что(СтрНайти(Строка(ДоСмены.Получить("html")), "МаркерAPIНовой") > 0,
		"КОНТРОЛЬ: и отдаёт её README").ЭтоИстина();

	НазначитьКаналомПоУмолчанию(Имя, "lts", "1.0.0");

	ПослеСмены = READMEАдресом(Имя);
	Ожидаем.Что(ПослеСмены.Получить("version"),
		"адрес README уехал на версию канала по умолчанию").Равно("1.0.0");
	Ожидаем.Что(СтрНайти(Строка(ПослеСмены.Получить("html")), "МаркерAPIСтарой") > 0,
		"и отдаёт её README").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка(ПослеСмены.Получить("html")), "МаркерAPIНовой"),
		"README прежней версии с адреса ушёл").Равно(0);

	Ожидаем.Что(СтрНайти(ВкладкаОписания(Имя), "МаркерAPIСтарой") > 0,
		"страница говорит о той же версии, что и адрес").ЭтоИстина();

КонецПроцедуры

// Канал по умолчанию можно опустошить отзывом — и тогда установка без версии не даёт
// ничего. Страница в этом случае честно говорит об отсутствии версии по умолчанию,
// а не выдаёт README какой-нибудь другой версии за «текущую».
&Тест
Процедура БезВерсииПоУмолчаниюСтраницаНазываетПричину() Экспорт

	Имя = "emptychannel";
	Опубликовать(Имя, "1.0.0", "# МаркерКанальной");
	Опубликовать(Имя, "2.0.0", "# МаркерСтаршей");
	НазначитьКаналомПоУмолчанию(Имя, "lts", "1.0.0");

	Отозвать(Имя, "1.0.0", Истина);

	Ожидаем.Что(GET(СтрШаблон("/api/v1/pools/%1/packages/%2/resolve", ИмяПула, Имя)).КодСостояния,
		"самотест: установка без версии теперь ничего не получает").Равно(404);

	Описание = ВкладкаОписания(Имя);
	Ожидаем.Что(СтрНайти(Описание, "нет версии по умолчанию") > 0,
		"страница называет причину пустоты: " + Описание).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Описание, "МаркерСтаршей"),
		"README чужой версии за текущую не выдаётся").Равно(0);
	Ожидаем.Что(СтрНайти(Описание, "МаркерКанальной"),
		"и README отозванной — тоже").Равно(0);

	Зависимости = ВкладкаЗависимостей(Имя);
	Ожидаем.Что(СтрНайти(Зависимости, "нет версии по умолчанию") > 0,
		"и вкладка зависимостей говорит то же, а не «ни от чего не зависит»").ЭтоИстина();

	// Машинный адрес отвечает на другой вопрос, чем резолв: «покажи описание» при пустом
	// канале — это пустой ответ, а не отказ. 200 с пустой версией и has_readme = false;
	// README чужой версии он не подставляет ровно так же, как страница.
	Пустой = READMEАдресом(Имя);
	Ожидаем.Что(Строка(Пустой.Получить("version")),
		"адрес README версии не называет — её нет").Равно("");
	Ожидаем.Что(Пустой.Получить("has_readme"),
		"и честно говорит, что описания нет").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Строка(Пустой.Получить("html")), "МаркерСтаршей"),
		"README чужой версии адрес не подставляет").Равно(0);

КонецПроцедуры

#Область Действия

// Публикует версию пакета с заданным README.
Процедура Опубликовать(Знач ИмяПакета, Знач Версия, Знач ТекстREADME)

	Ответ = ПушЗапрос(ДанныеПакета(ПакетыOspx.НовыйМанифест(ИмяПакета, Версия), ТекстREADME),
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия));
	Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("версия %1 пакета %2 опубликована: %3",
		Версия, ИмяПакета, ТелоОтвета(Ответ))).Равно(201);

КонецПроцедуры

// Публикует версию пакета, зависящую ровно от одного названного пакета.
Процедура ОпубликоватьСЗависимостью(Знач ИмяПакета, Знач Версия, Знач ИмяЗависимости)

	Манифест = ПакетыOspx.НовыйМанифест(ИмяПакета, Версия);
	Манифест.ДобавитьЗависимость(ИмяЗависимости, "1.0.0");

	Ответ = ПушЗапрос(ДанныеПакета(Манифест, "# " + ИмяПакета),
		СтрШаблон("%1-%2.ospx", ИмяПакета, Версия));
	Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("версия %1 с зависимостью %2 опубликована: %3",
		Версия, ИмяЗависимости, ТелоОтвета(Ответ))).Равно(201);

КонецПроцедуры

// Заводит ручной тег на названной версии и делает его каналом по умолчанию — тем же
// адресом, которым это делает мейнтейнер.
Процедура НазначитьКаналомПоУмолчанию(Знач ИмяПакета, Знач ИмяТега, Знач Версия)

	Ответ = PUTJsonТокеном(
		СтрШаблон("/api/v1/pools/%1/packages/%2/tags/%3", ИмяПула, ИмяПакета, ИмяТега),
		СтрШаблон("{""mode"":""ручной"",""version"":""%1"",""default"":true}", Версия),
		ТокенАдмина);
	Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("тег %1 стоит на %2 и назначен основным: %3",
		ИмяТега, Версия, ТелоОтвета(Ответ))).Равно(200);

КонецПроцедуры

// Отзывает версию или снимает отзыв.
Процедура Отозвать(Знач ИмяПакета, Знач Версия, Знач Отозвана)

	Ответ = ЗапросJSONТокеном("PATCH",
		СтрШаблон("/api/v1/pools/%1/packages/%2/versions/%3", ИмяПула, ИмяПакета, Версия),
		СтрШаблон("{""yanked"":%1}", ?(Отозвана, "true", "false")), ТокенАдмина);
	Ожидаем.Что(Ответ.КодСостояния, СтрШаблон("отзыв версии %1 (%2): %3",
		Версия, Отозвана, ТелоОтвета(Ответ))).Равно(200);

КонецПроцедуры

#КонецОбласти

#Область Наблюдения

// Разметка вкладки «Описание» страницы пакета.
Функция ВкладкаОписания(Знач ИмяПакета)
	Ответ = GET(СтрШаблон("/%1/%2", ИмяПула, ИмяПакета));
	Ожидаем.Что(Ответ.КодСостояния, "страница пакета отдана").Равно(200);
	Возврат ТелоОтвета(Ответ);
КонецФункции

// Разметка вкладки «Зависимости» страницы пакета.
Функция ВкладкаЗависимостей(Знач ИмяПакета)
	Ответ = GET(СтрШаблон("/%1/%2/deps", ИмяПула, ИмяПакета));
	Ожидаем.Что(Ответ.КодСостояния, "вкладка зависимостей отдана").Равно(200);
	Возврат ТелоОтвета(Ответ);
КонецФункции

// Ответ машинного адреса README без указания версии.
Функция READMEАдресом(Знач ИмяПакета)
	Ответ = GET(СтрШаблон("/api/v1/pools/%1/packages/%2/readme", ИмяПула, ИмяПакета));
	Ожидаем.Что(Ответ.КодСостояния, "адрес README ответил: " + ТелоОтвета(Ответ)).Равно(200);
	Возврат ТелоJSON(Ответ);
КонецФункции

// Версия, которую называет резолв без спецификации, — то, что получит `opm install <имя>`.
Функция РезолвВерсии(Знач ИмяПакета)
	Ответ = GET(СтрШаблон("/api/v1/pools/%1/packages/%2/resolve", ИмяПула, ИмяПакета));
	Ожидаем.Что(Ответ.КодСостояния, "резолв без спецификации ответил: " + ТелоОтвета(Ответ)).Равно(200);
	Возврат Строка(ТелоJSON(Ответ).Получить("version"));
КонецФункции

#КонецОбласти

#Область Обвязка

Функция ДанныеПакета(Знач Манифест, Знач ТекстREADME)
	Каталог = ОбъединитьПути(КореньДанных, "сборка-" + Строка(Новый УникальныйИдентификатор));
	СоздатьКаталог(Каталог);
	Возврат Новый ДвоичныеДанные(
		Новый ФикстураПакета().ПостроитьOspxПоМанифесту(Каталог, Манифест, ТекстREADME));
КонецФункции

Функция ПушЗапрос(Знач Данные, Знач ИмяФайла)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("FILE-NAME", ИмяФайла);
	Заголовки.Вставить("OAUTH-TOKEN", ТокенАдмина);
	Запрос = Новый HTTPЗапрос("/api/v1/pools/" + ИмяПула + "/push", Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Данные);
	Возврат Соединение().ОтправитьДляОбработки(Запрос);
КонецФункции

Функция ДождатьсяВхода(Знач Логин, Знач Пароль)

	Тело_ = СтрШаблон("{""логин"":""%1"",""пароль"":""%2""}", Логин, Пароль);
	Крайний = ТекущаяУниверсальнаяДатаВМиллисекундах() + 30 * 1000;

	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Крайний Цикл
		Ответ = ЗапросJSON("POST", "/api/v1/login", Тело_);
		Если Ответ.КодСостояния = 200 Тогда
			Возврат ИзвлечьКукуСессии(Ответ);
		КонецЕсли;
		Приостановить(500);
	КонецЦикла;

	// журнал хаба обязателен: рогатка безголового админа в журнал не пишет, и отказ был бы немым
	ВызватьИсключение "Админ не смог войти за отведённое время (онбординг из env не завершился)."
		+ Символы.ПС + Хаб.Дамп();

КонецФункции

Функция ВыпуститьТокен(Знач Кука)

	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Cookie", "oshub_session=" + Кука);
	Запрос = Новый HTTPЗапрос("/api/v1/tokens", Заголовки);
	Запрос.УстановитьТелоИзСтроки("{""права"":""read,write""}", КодировкаТекста.UTF8);
	Ответ = Соединение().ОтправитьДляОбработки(Запрос);

	Ожидаем.Что(Ответ.КодСостояния, "PAT администратора выпущен: " + ТелоОтвета(Ответ)).Равно(201);
	Возврат ТелоJSON(Ответ).Получить("token_info").Получить("token");

КонецФункции

Функция POSTJsonТокеном(Знач Путь, Знач Тело, Знач Токен)
	Возврат ЗапросJSONТокеном("POST", Путь, Тело, Токен);
КонецФункции

Функция PUTJsonТокеном(Знач Путь, Знач Тело, Знач Токен)
	Возврат ЗапросJSONТокеном("PUT", Путь, Тело, Токен);
КонецФункции

// JSON-мутация ключом: у PAT нет ambient cookie, поэтому CSRF ему не нужен.
Функция ЗапросJSONТокеном(Знач Метод, Знач Путь, Знач Тело, Знач Токен)
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Возврат ЗапросJSON(Метод, Путь, Тело, Заголовки);
КонецФункции

Функция ЗапросJSON(Знач Метод, Знач Путь, Знач Тело, Знач Заголовки = Неопределено)

	ЗаголовкиЗапроса = ?(Заголовки = Неопределено, Новый Соответствие(), Заголовки);
	ЗаголовкиЗапроса.Вставить("Content-Type", "application/json");

	Запрос = Новый HTTPЗапрос(Путь, ЗаголовкиЗапроса);
	Если ЗначениеЗаполнено(Тело) Тогда
		Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8);
	КонецЕсли;

	Соед = Соединение();
	Если ВРег(Метод) = "POST" Тогда
		Возврат Соед.ОтправитьДляОбработки(Запрос);
	ИначеЕсли ВРег(Метод) = "PUT" Тогда
		Возврат Соед.Записать(Запрос);
	КонецЕсли;

	Возврат Соед.ВызватьHTTPМетод(Метод, Запрос);

КонецФункции

Функция Соединение()
	Возврат Новый HTTPСоединение("localhost", Порт, , , , 30);
КонецФункции

Функция GET(Знач Путь)
	Возврат Соединение().Получить(Новый HTTPЗапрос(Путь));
КонецФункции

Функция ТелоОтвета(Знач Ответ)
	Возврат Ответ.ПолучитьТелоКакСтроку();
КонецФункции

Функция ТелоJSON(Знач Ответ)
	Чтение = Новый ЧтениеJSON();
	Чтение.УстановитьСтроку(ТелоОтвета(Ответ));
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция ИзвлечьКукуСессии(Знач Ответ)

	Для Каждого КиЗ Из Ответ.Заголовки Цикл
		Если ВРег(Строка(КиЗ.Ключ)) <> "SET-COOKIE" Тогда
			Продолжить;
		КонецЕсли;
		Значение = ИзвлечьЗначениеКуки(Строка(КиЗ.Значение), "oshub_session");
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ИзвлечьЗначениеКуки(Знач СтрокаКук, Знач ИмяКуки)

	Маркер = ИмяКуки + "=";
	Поз = СтрНайти(СтрокаКук, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = Сред(СтрокаКук, Поз + СтрДлина(Маркер));
	Конец = СтрДлина(Остаток) + 1;
	ТочкаЗпт = СтрНайти(Остаток, ";");
	Если ТочкаЗпт > 0 И ТочкаЗпт < Конец Тогда
		Конец = ТочкаЗпт;
	КонецЕсли;

	Возврат СокрЛП(Лев(Остаток, Конец - 1));

КонецФункции

#КонецОбласти
