// Домен журнала аудита: разбор отбора из адреса и страница службы поверх источника-файла
// (постранично, с признаком следующей — числа страниц у хвоста файла нет).

#Использовать asserts
#Использовать autumn-logos
#Использовать "фикстуры"

Перем ПоискКлассов;   // фикстура КлассыСлоя — файл класса ищется по имени
Перем Отборы;   // ОтборЖурналаАудита
Перем Адреса;   // ОтборПоАдресу

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	РеестрФикстур.Подключить("КлассыСлоя");
	ПоискКлассов = Новый КлассыСлоя();


	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КаталогПроекта = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогМодулей = ОбъединитьПути(КаталогПроекта, "src", "модули");

	КлассыАудита = ОбъединитьПути(КаталогМодулей, "аудит", "Классы");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогМодулей, "интерфейс", "Классы", "настройки"),
		"хаб", "журнал", "ОтборЖурналаАудита.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КлассыАудита, "СлужбаАудита.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КлассыАудита, "ИмяОбъектаАудита.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КлассыАудита, "СобытиеАудита.os"));
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ТекстJSON");
	ПоискКлассов.Подключить(ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "ТекстОшибки");
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(КлассыАудита, "ОтборПоАдресу.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(
		ОбъединитьПути(КаталогМодулей, "основа", "Классы"), "КанонIP.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогТестов, "фикстуры"), "ФейкИсточникЖурнала.os"));
	ПоискКлассов.ПодключитьФайл(ОбъединитьПути(ОбъединитьПути(КаталогМодулей, "наблюдаемость", "Классы"),
		ОбъединитьПути("пробы", "ГотовностьХаба.os")));

	Адреса = Новый ОтборПоАдресу(Новый КанонIP());
	Отборы = Новый ОтборЖурналаАудита(Адреса);

КонецПроцедуры

#Область РазборОтбора

&Тест
Процедура ОтборПонимаетПериодСутокЦеликом() Экспорт

	Отбор = Отборы.Разобрать("права.выданы", " root ", "2026-08-01", "2026-08-03");

	Ожидаем.Что(Отбор.Действие, "тип события").Равно("права.выданы");
	Ожидаем.Что(Отбор.Кто, "субъект без обрамляющих пробелов").Равно("root");
	Ожидаем.Что(Строка(Отбор.Начало), "начало периода — полночь").Равно(Строка(Дата(2026, 8, 1)));
	Ожидаем.Что(Строка(Отбор.Конец), "конец периода — последняя секунда суток «по»").Равно(
		Строка(Дата(2026, 8, 3, 23, 59, 59)));
	Ожидаем.Что(Отбор.Пустой, "отбор задан").ЭтоЛожь();

	Пустой = Отборы.Пустой();
	Ожидаем.Что(Пустой.Пустой, "пустой отбор").ЭтоИстина();
	Ожидаем.Что(Пустой.Начало, "без периода границы не задаются").Равно(Неопределено);
	Ожидаем.Что(Отборы.Параметры(Пустой).Количество(), "пустому отбору нечего переносить").Равно(0);

КонецПроцедуры

&Тест
Процедура НепонятаяДатаНеСтановитсяОтборомИНеВозвращаетсяВПоле() Экспорт

	// «мусор» в поле даты, ставший отбором «с 0001-01-01», отдал бы пустой журнал молча
	Векторы = "вчера,2026-13-40,01.08.2026,2026-8-1,,2026-08-01x";

	Для Каждого Вектор Из СтрРазделить(Векторы, ",", Истина) Цикл
		Отбор = Отборы.Разобрать("", "", Вектор, Вектор);
		Ожидаем.Что(Отбор.Начало, "непонятое начало «" + Вектор + "» не отбирает").Равно(Неопределено);
		Ожидаем.Что(Отбор.Конец, "непонятый конец «" + Вектор + "» не отбирает").Равно(Неопределено);
		Ожидаем.Что(Отбор.ТекстНачала, "и в поле формы не возвращается").Равно("");
		Ожидаем.Что(Отбор.Пустой, "и отбор остаётся пустым").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ПараметрыОтбораПереносятЗаполненноеИНомерСтраницыНеМеньшеЕдиницы() Экспорт

	Отбор = Отборы.Разобрать("настройка.изменена", "", "2026-08-01", "мусор");
	Имена = Новый Массив();
	Для Каждого Параметр Из Отборы.Параметры(Отбор) Цикл
		Имена.Добавить(Параметр.Имя + "=" + Параметр.Значение);
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Имена, "&"), "переносится ровно заполненное и понятое").Равно(
		Отборы.ИмяТипа() + "=настройка.изменена&" + Отборы.ИмяНачала() + "=2026-08-01");

	Ожидаем.Что(Отборы.НомерСтраницы("3"), "номер страницы").Равно(3);
	Ожидаем.Что(Отборы.НомерСтраницы("0"), "ноль прижимается к первой").Равно(1);
	Ожидаем.Что(Отборы.НомерСтраницы("-2"), "отрицательный прижимается к первой").Равно(1);
	Ожидаем.Что(Отборы.НомерСтраницы("чепуха"), "нечисло — первая").Равно(1);
	Ожидаем.Что(Отборы.НомерСтраницы(""), "пусто — первая").Равно(1);

КонецПроцедуры

&Тест
Процедура ОтборПоАдресуПонимаетЛюбуюЗаписьТогоЖеАдреса() Экспорт

	// журнал не мигрируется: записи прежней версии хаба несут адрес как пришёл,
	// и сравнение строк не нашло бы их по канонической записи из формы
	Условие = Отборы.Разобрать("", "", "", "", "::ffff:192.0.2.1").Адрес;

	Ожидаем.Что(Адреса.Подходит(Условие, "192.0.2.1"), "канон записи").ЭтоИстина();
	Ожидаем.Что(Адреса.Подходит(Условие, "::ffff:192.0.2.1"), "отображённый IPv4").ЭтоИстина();
	Ожидаем.Что(Адреса.Подходит(Условие, "192.0.2.2"), "соседний адрес").ЭтоЛожь();

	ПоIPv6 = Отборы.Разобрать("", "", "", "", "2001:DB8::1").Адрес;
	Ожидаем.Что(Адреса.Подходит(ПоIPv6, "2001:0db8:0000:0000:0000:0000:0000:0001"),
		"развёрнутая запись того же адреса").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОтборПоСетиНаходитВсеАдресаСети() Экспорт

	Условие = Отборы.Разобрать("", "", "", "", "10.0.0.0/8").Адрес;

	Ожидаем.Что(Адреса.Подходит(Условие, "10.1.2.3"), "адрес сети").ЭтоИстина();
	Ожидаем.Что(Адреса.Подходит(Условие, "::ffff:10.9.9.9"), "он же отображённым").ЭтоИстина();
	Ожидаем.Что(Адреса.Подходит(Условие, "11.1.2.3"), "адрес вне сети").ЭтоЛожь();

	// неканоническую базу оператор пишет от знакомого ему адреса
	ОтАдреса = Отборы.Разобрать("", "", "", "", "10.1.2.3/8").Адрес;
	Ожидаем.Что(Адреса.Подходит(ОтАдреса, "10.9.9.9"), "сеть от адреса внутри неё").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура НепрочитанныйАдресОтборомНеСтановитсяИЭкранОбЭтомГоворит() Экспорт

	// то же правило, что у непонятой даты: пустой журнал под непрочитанным адресом
	// читался бы как «таких операций не было», поэтому отбор просто не применяется
	Отбор = Отборы.Разобрать("", "", "", "", "не-адрес-вовсе");

	Ожидаем.Что(Отбор.АдресНеПрочитан, "экран обязан сказать, что адрес не прочитан").ЭтоИстина();
	Ожидаем.Что(Отбор.ТекстАдреса, "введённое возвращается в поле формы").Равно("не-адрес-вовсе");
	Ожидаем.Что(Отбор.Пустой, "отбором непрочитанный адрес не становится").ЭтоИстина();
	Ожидаем.Что(Адреса.Подходит(Отбор.Адрес, "192.0.2.1"),
		"и записи журнала он не отсекает").ЭтоИстина();

	Пустой = Отборы.Разобрать("", "", "", "", "");
	Ожидаем.Что(Пустой.АдресНеПрочитан, "пустое поле — не ошибка").ЭтоЛожь();
	Ожидаем.Что(Пустой.Пустой, "и отбор пуст").ЭтоИстина();
	Ожидаем.Что(Адреса.Подходит(Пустой.Адрес, "192.0.2.1"),
		"пустое условие пропускает всё").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура АдресЖивётВАдресеЭкрана() Экспорт

	Отбор = Отборы.Разобрать("", "", "", "", "10.0.0.0/8");

	Значения = Новый Соответствие();
	Для Каждого Параметр Из Отборы.Параметры(Отбор) Цикл
		Значения.Вставить(Параметр.Имя, Параметр.Значение);
	КонецЦикла;

	Ожидаем.Что(Отборы.ИмяАдреса(), "имя параметра адреса").Равно("ip");
	Ожидаем.Что(Значения.Получить("ip"), "адрес переносится ссылкой и пагинацией")
		.Равно("10.0.0.0/8");

КонецПроцедуры

#КонецОбласти

#Область СтраницаСлужбы

&Тест
Процедура СтраницаПереводитНомерВСмещениеИНесётПризнакСледующей() Экспорт

	Источник = Новый ФейкИсточникЖурнала();
	Источник.ЕстьСледующая = Истина;
	Источник.Добавить("root", "настройка.изменена", "oshub.ui.theme");
	Служба = НоваяСлужба(Источник);

	Выдача = Служба.ЗаписиСтраницей(Отборы.Пустой(), 3, 20);

	Ожидаем.Что(Источник.ПоследнееСмещение, "третья страница по двадцать — смещение 40").Равно(40);
	Ожидаем.Что(Источник.ПоследнийРазмер, "размер страницы передан как есть").Равно(20);
	Ожидаем.Что(Выдача.Страница, "номер страницы возвращён").Равно(3);
	Ожидаем.Что(Выдача.ЕстьСледующая, "признак следующей — от источника").ЭтоИстина();
	Ожидаем.Что(Выдача.Записи.Количество(), "записи отданы как есть").Равно(1);
	Ожидаем.Что(Выдача.ИсточникДоступен, "источник доступен").ЭтоИстина();

	Мусор = Служба.ЗаписиСтраницей(Отборы.Пустой(), "чепуха", 0);
	Ожидаем.Что(Мусор.Страница, "негодный номер страницы — первая").Равно(1);
	Ожидаем.Что(Источник.ПоследнееСмещение, "и смещение с первой страницы — ноль").Равно(0);

КонецПроцедуры

&Тест
Процедура ГраницыПериодаПриезжаютВИсточникПодЕгоИменами() Экспорт

	// контракт источника называет границы «С» и «По» — имена наших полей туда не доедут
	Источник = Новый ФейкИсточникЖурнала();
	Служба = НоваяСлужба(Источник);

	Отбор = Отборы.Разобрать("права.выданы", "root", "2026-08-01", "2026-08-03");
	Служба.ЗаписиСтраницей(Отбор, 1, 20);

	Принятый = Источник.ПоследнийОтбор;
	Ожидаем.Что(Принятый.Свойство("С"), "граница «с» названа по контракту источника").ЭтоИстина();
	Ожидаем.Что(Принятый.Свойство("По"), "и граница «по» тоже").ЭтоИстина();
	Ожидаем.Что(Строка(Принятый["С"]), "начало периода доехало").Равно(Строка(Дата(2026, 8, 1)));
	Ожидаем.Что(Строка(Принятый["По"]), "и конец периода тоже").Равно(
		Строка(Дата(2026, 8, 3, 23, 59, 59)));
	Ожидаем.Что(Принятый.Действие, "действие доехало").Равно("права.выданы");
	Ожидаем.Что(Принятый.Кто, "субъект доехал").Равно("root");

КонецПроцедуры

&Тест
Процедура УсловиеАдресаПриезжаетВИсточник() Экспорт

	// разобранное условие обязано доехать до источника: без него отбор по адресу
	// был бы только на экране, а журнал отдавал бы всё подряд
	Источник = Новый ФейкИсточникЖурнала();
	Служба = НоваяСлужба(Источник);

	Служба.ЗаписиСтраницей(Отборы.Разобрать("", "", "", "", "10.0.0.0/8"), 1, 20);

	Принятое = Источник.ПоследнийОтбор["Адрес"];
	Ожидаем.Что(Принятое <> Неопределено, "условие адреса доехало").ЭтоИстина();
	Ожидаем.Что(Принятое.Задано, "и оно задано").ЭтоИстина();
	Ожидаем.Что(Принятое.Понято, "и понято").ЭтоИстина();
	Ожидаем.Что(Принятое.Сеть.ВСтроку(), "сетью, а не адресом").Равно("10.0.0.0/8");

КонецПроцедуры

&Тест
Процедура УсечениеХвостаДоезжаетДоВыдачиОтдельноОтНедоступности() Экспорт

	// «прочитано не всё» и «читать нечем» — разные ответы: первый оставляет записи
	// в файле за пределами прочитанного, и молчание о нём превращает пустую страницу
	// по старому периоду в ложное «событий не было»
	Источник = Новый ФейкИсточникЖурнала();
	Источник.ХвостУсечён = Истина;
	Источник.Добавить("root", "настройка.изменена", "oshub.ui.theme");

	Выдача = НоваяСлужба(Источник).ЗаписиСтраницей(Отборы.Пустой(), 1, 20);

	Ожидаем.Что(Выдача.ХвостУсечён, "признак усечения от источника доехал").ЭтоИстина();
	Ожидаем.Что(Выдача.ИсточникДоступен, "и это не недоступность источника").ЭтоИстина();
	Ожидаем.Что(НоваяСлужба(Новый ФейкИсточникЖурнала()).ЗаписиСтраницей(Отборы.Пустой(), 1, 20).ХвостУсечён,
		"целиком прочитанный журнал усечённым не объявляется").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура НедоступностьИсточникаДоезжаетДоВыдачиАНеПодменяетсяПустотой() Экспорт

	// источник сказал «файл журнала не прочитан» — служба обязана донести это до экрана
	// слово в слово: экран отличает «нечем показать» от «пусто»
	Источник = Новый ФейкИсточникЖурнала();
	Источник.Доступен = Ложь;
	Служба = НоваяСлужба(Источник);

	Выдача = Служба.ЗаписиСтраницей(Отборы.Пустой(), 1, 20);

	Ожидаем.Что(Выдача.ИсточникДоступен, "источник недоступен").ЭтоЛожь();
	Ожидаем.Что(Выдача.Записи.Количество(), "записей нет").Равно(0);
	Ожидаем.Что(Выдача.ЕстьСледующая, "и следующей страницы тоже").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Издатель и летопись к выборке отношения не имеют: страницу отдаёт источник-файл.
// Гейт готовности создаётся напрямую, поэтому лог приезжает параметром: без него
// первая же отладочная запись роняет набор.
Функция НоваяСлужба(Знач Источник)
	Возврат Новый СлужбаАудита(Неопределено, Новый ГотовностьХаба(ЛогТеста()), Неопределено,
		Источник, Новый ИмяОбъектаАудита());
КонецФункции

Функция ЛогТеста()
	Возврат Логирование.ПолучитьЛог("тест.oshub.аудит.отбор");
КонецФункции

#КонецОбласти
